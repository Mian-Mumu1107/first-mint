    {
      "subId": "100915",
      "subQuestName": "寻找「留云借风真君」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10091501"
        ],
        "dialogs": {
          "10091501": {
            "id": "10091501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？这里怎么有张石桌，上面还摆着这么多餐具，还有酒壶…",
            "nextDialogs": [
              "10091502"
            ]
          },
          "10091502": {
            "id": "10091502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这旁边的椅子上还刻着字呢，「此处居留云」…",
            "nextDialogs": [
              "10091510"
            ]
          },
          "10091510": {
            "id": "10091510",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「此处坐归终」，还有「此处借帝君」。",
            "nextDialogs": [
              "10091503"
            ]
          },
          "10091503": {
            "id": "10091503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「帝君」难道说的是「岩王帝君」？「归终」…不知道是什么意思…",
            "nextDialogs": [
              "10091504"
            ]
          },
          "10091504": {
            "id": "10091504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「留云」…对了，那位削月筑阳真君提到的仙人里，有一位就叫「留云借风真君」来着！",
            "nextDialogs": [
              "10091505"
            ]
          },
          "10091505": {
            "id": "10091505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这么说来，这里说不定就是那位「留云借风真君」和其他仙人聚餐的地方了。",
            "nextDialogs": [
              "10091506"
            ]
          },
          "10091506": {
            "id": "10091506",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，假如真是这样，那我们做点仙人喜欢的美食，是不是就能引起这位「留云借风真君」的注意了？",
            "nextDialogs": [
              "10091507"
            ]
          },
          "10091507": {
            "id": "10091507",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，仙人到底会想要吃什么好吃的呢？完全没有头绪…",
            "nextDialogs": [
              "10091508"
            ]
          },
          "10091508": {
            "id": "10091508",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没办法了，我们去周围看看吧，希望之前来这里供奉的人，能留下一点痕迹，当作参考。",
            "nextDialogs": [
              "10091509"
            ]
          },
          "10091509": {
            "id": "10091509",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对了，你说…仙人会喜欢吃蜜酱胡萝卜煎肉吗？"
          }
        }
      }
    },
    {
      "subId": "100902",
      "subQuestName": "寻找供奉食物的痕迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10090201"
        ],
        "dialogs": {
          "10090201": {
            "id": "10090201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好像是有人在这里做过菜，是用来供奉仙人的吗？",
            "nextDialogs": [
              "10090202"
            ]
          },
          "10090202": {
            "id": "10090202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这旁边还有没用完的食材呢。金鱼草…莲蓬…还有豆腐，这道菜可真复杂…",
            "nextDialogs": [
              "10090203"
            ]
          },
          "10090203": {
            "id": "10090203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎，看那里，好像是…笔记。",
            "nextDialogs": [
              "10090204"
            ]
          },
          "10090204": {
            "id": "10090204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这么复杂的菜，也难怪要把做菜的方法用纸记下来…我们仔细看看吧。"
          }
        }
      }
    },
    {
      "subId": "100903",
      "subQuestName": "寻找供奉食物的痕迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10090301"
        ],
        "dialogs": {
          "10090301": {
            "id": "10090301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇，好多面粉都撒在地上了，在这里做菜的人真马虎…",
            "nextDialogs": [
              "10090302"
            ]
          },
          "10090302": {
            "id": "10090302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "锅里的东西好像是肉…但具体是什么肉就不知道了。",
            "nextDialogs": [
              "10090303"
            ]
          },
          "10090303": {
            "id": "10090303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这道菜，会不会是为了供奉仙人才做的？",
            "nextDialogs": [
              "10090304"
            ]
          },
          "10090304": {
            "id": "10090304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…要用到「肉类」和「面粉」的菜…",
            "nextDialogs": [
              "10090305"
            ]
          },
          "10090305": {
            "id": "10090305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？地上怎么丢着一页纸…呃，还有个占了半页的脚印…",
            "nextDialogs": [
              "10090306"
            ]
          },
          "10090306": {
            "id": "10090306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，说不定它和这道菜有关…？"
          }
        }
      }
    },
    {
      "subId": "100904",
      "subQuestName": "寻找供奉食物的痕迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10090401"
        ],
        "dialogs": {
          "10090401": {
            "id": "10090401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里好干净，应该是在这里做菜的人细心收拾过了…",
            "nextDialogs": [
              "10090402"
            ]
          },
          "10090402": {
            "id": "10090402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说不定，正是为了供奉仙人…",
            "nextDialogs": [
              "10090403"
            ]
          },
          "10090403": {
            "id": "10090403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这些材料是…「松茸」和「兽肉」。",
            "nextDialogs": [
              "10090404"
            ]
          },
          "10090404": {
            "id": "10090404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "菜谱就摊在旁边，在这里做菜的人，真的很有条理啊…"
          }
        }
      }
    },

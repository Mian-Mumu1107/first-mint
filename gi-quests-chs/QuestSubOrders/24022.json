    {
      "subId": "2402206",
      "subQuestName": "取回资料",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240220601"
        ],
        "dialogs": {
          "240220601": {
            "id": "240220601",
            "speakerId": 1000,
            "speakerName": "安里",
            "text": "居然真的找到了完好无损的资料…您真是我的福星！",
            "nextDialogs": [
              "240220602"
            ]
          },
          "240220602": {
            "id": "240220602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，你怎么一副意外的表情？",
            "nextDialogs": [
              "240220603"
            ]
          },
          "240220603": {
            "id": "240220603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你不会…其实对回收资料这件事压根没抱希望吧！",
            "nextDialogs": [
              "240220604"
            ]
          },
          "240220604": {
            "id": "240220604",
            "speakerId": 1000,
            "speakerName": "安里",
            "text": "怎么可能！我用枫达发誓，绝无此种想法！",
            "nextDialogs": [
              "240220607"
            ]
          },
          "240220607": {
            "id": "240220607",
            "speakerId": 1000,
            "speakerName": "安里",
            "text": "咳！总之，顺利回收到了资料绝对是一件好事，我先研究一下里面的内容…",
            "nextDialogs": [
              "240220608"
            ]
          },
          "240220608": {
            "id": "240220608",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "安里开始翻看起了资料…",
            "nextDialogs": [
              "240220609"
            ]
          },
          "240220609": {
            "id": "240220609",
            "speakerId": 1000,
            "speakerName": "安里",
            "text": "这里面记载的是调整枫达甜度的各种方法…",
            "nextDialogs": [
              "240220610"
            ]
          },
          "240220610": {
            "id": "240220610",
            "speakerId": 1000,
            "speakerName": "安里",
            "text": "居然能够想到在枫达里加盐以丰富饮品风味…不愧是过去的我！",
            "nextDialogs": [
              "240220611"
            ]
          },
          "240220611": {
            "id": "240220611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你先让现在的自己反思一下吧。",
            "nextDialogs": [
              "240220612"
            ]
          },
          "240220612": {
            "id": "240220612",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咸…咸味的枫达，总觉得…不太想喝呢…",
            "nextDialogs": [
              "240220613"
            ]
          },
          "240220613": {
            "id": "240220613",
            "speakerId": 1000,
            "speakerName": "安里",
            "text": "咦？你们是不喜欢这种味道吗？",
            "nextDialogs": [
              "240220614"
            ]
          },
          "240220614": {
            "id": "240220614",
            "speakerId": 1000,
            "speakerName": "安里",
            "text": "哈哈哈，放心吧，盐带来的咸味不会太强烈，整体的饮品风味还是偏甜的。",
            "nextDialogs": [
              "240220615"
            ]
          },
          "240220615": {
            "id": "240220615",
            "speakerId": 1000,
            "speakerName": "安里",
            "text": "唔…既然是你们帮我收回的资料，那这次我制作的新型枫达，也会参考你们的意见。",
            "nextDialogs": [
              "240220616"
            ]
          },
          "240220616": {
            "id": "240220616",
            "speakerId": 1000,
            "speakerName": "安里",
            "text": "你们觉得，我应该采用这篇设计稿的意见，在枫达里加入盐吗？"
          }
        }
      }
    },
    {
      "subId": "2402207",

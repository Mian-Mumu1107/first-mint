        ],
        "dialogs": {
          "766800101": {
            "id": "766800101",
            "speakerId": 1000,
            "speakerName": "青霆",
            "text": "#哦呦，{NICKNAME}和派蒙，你们好啊！",
            "nextDialogs": [
              "766800102"
            ]
          },
          "766800102": {
            "id": "766800102",
            "speakerId": 1000,
            "speakerName": "青霆",
            "text": "既然巧遇了，要不要来看看我青霆的鼬鼬？它叫洋葱尾巴，很可爱的！",
            "nextDialogs": [
              "766800103"
            ]
          },
          "766800103": {
            "id": "766800103",
            "speakerId": 1001,
            "speakerName": "洋葱尾巴",
            "text": "…喵？",
            "nextDialogs": [
              "766800104"
            ]
          },
          "766800104": {
            "id": "766800104",
            "speakerId": 1000,
            "speakerName": "青霆",
            "text": "喂喂，洋葱尾巴，你不是这样叫的！这两位应该不懂阿舍鲁老师的语言。",
            "nextDialogs": [
              "766800105"
            ]
          },
          "766800105": {
            "id": "766800105",
            "speakerId": 1001,
            "speakerName": "洋葱尾巴",
            "text": "…咕？",
            "nextDialogs": [
              "766800106"
            ]
          },
          "766800106": {
            "id": "766800106",
            "speakerId": 1000,
            "speakerName": "青霆",
            "text": "也不能用团雀语哦，拜希麦小姐已经回须弥去休养了。",
            "nextDialogs": [
              "766800107"
            ]
          },
          "766800107": {
            "id": "766800107",
            "speakerId": 1000,
            "speakerName": "青霆",
            "text": "对不起啊，我家洋葱尾巴和别的动物交流太多，一时错乱了，暂时找不回自己的频道，哈哈…",
            "nextDialogs": [
              "766800108"
            ]
          },
          "766800108": {
            "id": "766800108",
            "speakerId": 1000,
            "speakerName": "青霆",
            "text": "先让它休息一下好了。",
            "nextDialogs": [
              "766800111"
            ]
          },
          "766800111": {
            "id": "766800111",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔，怎么感觉你和我们很熟，说话很自然的样子…难道以前调查过我们吗？",
            "nextDialogs": [
              "766800112"
            ]
          },
          "766800112": {
            "id": "766800112",
            "speakerId": 1000,
            "speakerName": "青霆",
            "text": "放松，放松，我是你们的自己人——",
            "nextDialogs": [
              "766800113"
            ]
          },
          "766800113": {
            "id": "766800113",
            "speakerId": 1000,
            "speakerName": "青霆",
            "text": "我为夜兰老板工作，而你们是夜兰老板最最重要的宾客，咱们关系有多铁，不用多说了吧？"
          }
        }
      }
    }
  ]

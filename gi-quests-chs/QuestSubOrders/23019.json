    },
    {
      "subId": "2301904",
      "subQuestName": "回去向拉菲克说明情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230190401"
        ],
        "dialogs": {
          "230190401": {
            "id": "230190401",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "怎么样，你检查完那艘船了吗？",
            "nextDialogs": [
              "230190402"
            ]
          },
          "230190402": {
            "id": "230190402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经检查完了…",
            "nextDialogs": [
              "230190403"
            ]
          },
          "230190403": {
            "id": "230190403",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "在描述了船只情况之后…",
            "nextDialogs": [
              "230190404"
            ]
          },
          "230190404": {
            "id": "230190404",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "原来如此，那些为了省钱而用了取巧功夫的结构果然出问题了啊…",
            "nextDialogs": [
              "230190405"
            ]
          },
          "230190405": {
            "id": "230190405",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "但维修这种结构要花不少钱，那个船主人，我记得手头一直很拮据…",
            "nextDialogs": [
              "230190406"
            ]
          },
          "230190406": {
            "id": "230190406",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "唉，我还是去和他谈谈吧，和钱相比，肯定是命更重要啊…"
          }
        }
      }
    }
  ]
}
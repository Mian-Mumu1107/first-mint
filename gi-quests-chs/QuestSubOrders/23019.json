  "subQuests": [
    {
      "subId": "2301901",
      "subQuestName": "与拉菲克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230190101"
        ],
        "dialogs": {
          "230190101": {
            "id": "230190101",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "果然，这样做会更花钱啊…",
            "nextDialogs": [
              "230190102"
            ]
          },
          "230190102": {
            "id": "230190102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在说什么呢？",
            "nextDialogs": [
              "230190103"
            ]
          },
          "230190103": {
            "id": "230190103",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "啊，你好，我正在研究一艘船只的设计问题呢，现在…遇到了一些瓶颈。",
            "nextDialogs": [
              "230190104"
            ]
          },
          "230190104": {
            "id": "230190104",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "简单来说，就是我想在不提高造价的情况下，让船能装更多的东西。",
            "nextDialogs": [
              "230190105"
            ]
          },
          "230190105": {
            "id": "230190105",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "一旦重量大了，结构会变得更容易破损，重量不均匀的情况下平衡也会出现问题…",
            "nextDialogs": [
              "230190106"
            ]
          },
          "230190106": {
            "id": "230190106",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "解决这些问题的最好方法，就是用更好的材料，但这样…问题就又回到了造价问题上…",
            "nextDialogs": [
              "230190107"
            ]
          },
          "230190107": {
            "id": "230190107",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "唉，其实说白了就是我没钱，但又想要造出一艘好船。",
            "nextDialogs": [
              "230190108"
            ]
          },
          "230190108": {
            "id": "230190108",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "所以某些用钱就能砸通的问题，我只能想办法用一些技术性的手段绕过去。",
            "nextDialogs": [
              "230190109"
            ]
          },
          "230190109": {
            "id": "230190109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真的能这么做吗…",
            "nextDialogs": [
              "230190110"
            ]
          },
          "230190110": {
            "id": "230190110",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "哈哈哈，说出来你可能不信，但其实有很多人都这么做。",
            "nextDialogs": [
              "230190111"
            ]
          },
          "230190111": {
            "id": "230190111",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "毕竟我们造的船也都是不会遇见什么风浪的近海渔船。",
            "nextDialogs": [
              "230190112"
            ]
          },
          "230190112": {
            "id": "230190112",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "大家都秉承着能省则省，修修补补的原则造船…凑合凑合，能用就行。",
            "nextDialogs": [
              "230190113"
            ]
          },
          "230190113": {
            "id": "230190113",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "拜这原则所赐，我们修船的生意每天都好得不行。",
            "nextDialogs": [
              "230190114"
            ]
          },
          "230190114": {
            "id": "230190114",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "旅行者，如果你愿意的话，就帮我去那边检查一下那艘刚回港的船吧，它貌似因为经常运载重物出了点问题。",
            "nextDialogs": [
              "230190115"
            ]
          },
          "230190115": {
            "id": "230190115",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "我刚好就在研究这方面的问题，说不定能从它身上找到点灵感。",
            "nextDialogs": [
              "230190117",
              "230190119"
            ]
          },
          "230190117": {
            "id": "230190117",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "那就拜托你了！我得赶紧去修另外一艘船去了…"
          },
          "230190119": {
            "id": "230190119",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "我也想自己去，但我还被人拜托去维修另外一艘急着要再出海收网的船…",
            "nextDialogs": [
              "230190120"
            ]
          },
          "230190120": {
            "id": "230190120",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "所以就只能拜托你了，旅行者！"
          }
        }
      }
    },
    {
      "subId": "2301902",
      "subQuestName": "前往船只上调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230190201"

        "dialogs": {
          "50042001": {
            "id": "50042001",
            "speakerId": 14139,
            "speakerName": "维查玛",
            "text": "我听说你们从夜神之国回来了？",
            "nextDialogs": [
              "50042002"
            ]
          },
          "50042002": {
            "id": "50042002",
            "speakerId": 14139,
            "speakerName": "维查玛",
            "text": "真了不起。勇气、信念、实力…你们是我见过最出色的战士。如果我也能像你们一样…",
            "nextDialogs": [
              "50042003"
            ]
          },
          "50042003": {
            "id": "50042003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们在夜神之国见到了穆尔科。",
            "nextDialogs": [
              "50042004"
            ]
          },
          "50042004": {
            "id": "50042004",
            "speakerId": 14139,
            "speakerName": "维查玛",
            "text": "什么？！",
            "nextDialogs": [
              "50042005"
            ]
          },
          "50042005": {
            "id": "50042005",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "向维查玛讲述了我们在夜神之国的见闻。",
            "nextDialogs": [
              "50042006"
            ]
          },
          "50042006": {
            "id": "50042006",
            "speakerId": 14139,
            "speakerName": "维查玛",
            "text": "原来是这样啊…穆尔科他…",
            "nextDialogs": [
              "50042007"
            ]
          },
          "50042007": {
            "id": "50042007",
            "speakerId": 14139,
            "speakerName": "维查玛",
            "text": "抱歉，我不知道该怎么表达现在的心情。哪怕生死相隔，我们也共同做成了一件事情…就像再次并肩战斗过一样。",
            "nextDialogs": [
              "50042008"
            ]
          },
          "50042008": {
            "id": "50042008",
            "speakerId": 14139,
            "speakerName": "维查玛",
            "text": "我终于能睡个好觉了。穆尔科…我的朋友啊，再等我一些时间吧。终有一日，我会亲自去见你。"
          }
        }
      }
    }
  ]

  "subQuests": [
    {
      "subId": "7405801",
      "subQuestName": "与芙佳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740580101"
        ],
        "dialogs": {
          "740580101": {
            "id": "740580101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "芙佳，我们又来啦！",
            "nextDialogs": [
              "740580102"
            ]
          },
          "740580102": {
            "id": "740580102",
            "speakerId": 1001,
            "speakerName": "芙佳",
            "text": "#{NICKNAME}{M#哥哥}{F#姐姐}和派蒙！你们是来找芙佳玩的吗？",
            "nextDialogs": [
              "740580103"
            ]
          },
          "740580103": {
            "id": "740580103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "倒也不是啦，我记得你上次说过，关于附近矿脉和矿石的事情都可以来问你，对吧？",
            "nextDialogs": [
              "740580104"
            ]
          },
          "740580104": {
            "id": "740580104",
            "speakerId": 1001,
            "speakerName": "芙佳",
            "text": "嗯嗯，这附近好看的石头我都有收集过，不知道你们想要找什么样的石头呢？",
            "nextDialogs": [
              "740580105"
            ]
          },
          "740580105": {
            "id": "740580105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个嘛，其实就是上次捡到的那个啦…",
            "nextDialogs": [
              "740580106"
            ]
          },
          "740580106": {
            "id": "740580106",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "你们将之前在枫丹廷把奇异的矿石卖给宝石商人的事情告诉了芙佳…",
            "nextDialogs": [
              "740580107"
            ]
          },
          "740580107": {
            "id": "740580107",
            "speakerId": 1001,
            "speakerName": "芙佳",
            "text": "欸？原来在外面的人类看来，那是很珍贵的宝石吗？明明我之前都拿去给姐姐看过…外面人类的想法真是搞不懂…",
            "nextDialogs": [
              "740580108"
            ]
          },
          "740580108": {
            "id": "740580108",
            "speakerId": 1001,
            "speakerName": "芙佳",
            "text": "不过我还知道很多地方都有这样的石头，如果你们需要的话，我可以把位置告诉你们。",
            "nextDialogs": [
              "740580109"
            ]
          },
          "740580109": {
            "id": "740580109",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "芙佳将能找到奇异矿石的地点标记给了你们。",
            "nextDialogs": [
              "740580110"
            ]
          },
          "740580110": {
            "id": "740580110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那样的话就太好啦，谢谢你，芙佳！对啦，这是切瑟尔预付给我们的摩拉，嘿嘿，我想想…可以分一半给你哦！",
            "nextDialogs": [
              "740580111"
            ]
          },
          "740580111": {
            "id": "740580111",
            "speakerId": 1001,
            "speakerName": "芙佳",
            "text": "不用不用，不用啦，在村子里生活也不需要这种东西…而且你们帮了我好多，这不算什么啦！"
          }
        }
      }
    },
    {
      "subId": "7405804",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740580401"
        ],
        "dialogs": {
          "740580401": {
            "id": "740580401",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "欢迎光临…哦哦，是你们啊！",
            "nextDialogs": [
              "740580402"
            ]
          },
          "740580402": {
            "id": "740580402",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "之前约定好的矿石，不知道你们带来没有呢？",
            "nextDialogs": [
              "740580403"
            ]
          },
          "740580403": {
            "id": "740580403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有。",
            "nextDialogs": [
              "740580404"
            ]
          },
          "740580404": {
            "id": "740580404",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "虽然不是很着急…毕竟之前那个矿石样本，工匠们还在处理当中。",
            "nextDialogs": [
              "740580405"
            ]
          },
          "740580405": {
            "id": "740580405",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "不过要是能早点拿到更多的矿石的话，说不定工匠们也能有新的灵感呢。",
            "nextDialogs": [
              "740580406"
            ]
          },
          "740580406": {
            "id": "740580406",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "那么我就还是在此静候佳音了。"
          }
        }
      }
    },
    {
      "subId": "7405805",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740580501"
        ],
        "dialogs": {
          "740580501": {
            "id": "740580501",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "欢迎光临，又见面了。",
            "nextDialogs": [
              "740580502"
            ]
          },
          "740580502": {
            "id": "740580502",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "不过上次你们带来的矿石还在加工当中，暂时还不能给你们看成品…恐怕得等到下次了…"
          }
        }
      }
    },
    {
      "subId": "7405802",
      "subQuestName": "收集奇异的矿石",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740580201"
        ],
        "dialogs": {
          "740580201": {
            "id": "740580201",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "竟然…有这么多吗，真是帮大忙了！",
            "nextDialogs": [
              "740580202"
            ]
          },
          "740580202": {
            "id": "740580202",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "虽然好像因为工匠对这种宝石的品性不太了解的缘故，导致出了一些问题…上次送去加工的宝石，到现在也还没有拿到成品…",
            "nextDialogs": [
              "740580203"
            ]
          },
          "740580203": {
            "id": "740580203",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "不过没关系，我相信我的眼光。",
            "nextDialogs": [
              "740580204"
            ]
          },
          "740580204": {
            "id": "740580204",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "我打算把它们加工成最时兴的首饰款式，到时候一定会风靡整个枫丹的。",
            "nextDialogs": [
              "740580205"
            ]
          },
          "740580205": {
            "id": "740580205",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "等下次你们来的时候应该就能看到成品了！到时候，我也会赠送一些样品给你们作为报酬。",
            "nextDialogs": [
              "740580206"
            ]
          },
          "740580206": {
            "id": "740580206",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "不过，也说不定你们会在那些上流社会的贵人身上先看到呢，哈哈…",
            "nextDialogs": [
              "740580207"
            ]
          },
          "740580207": {
            "id": "740580207",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "那么，也欢迎你们再次光临。"
          }
        }
      }
    },
    {
      "subId": "7405803",
      "subQuestName": "将收集到的矿石带给切瑟尔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740580301"
        ],
        "dialogs": {
          "740580301": {
            "id": "740580301",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "欢迎光临…哦哦，是你们啊，答应带给我矿石的…",
            "nextDialogs": [
              "740580302"
            ]
          },
          "740580302": {
            "id": "740580302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯嗯，按照之前说的，我们又带来了很多那样的矿石哦。"
          }
        }
      }
    },

    {
      "subId": "7404113",
      "subQuestName": "与愚人众指挥官对峙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740411301"
        ],
        "dialogs": {
          "740411301": {
            "id": "740411301",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "不要再打了！我投降！投降！",
            "nextDialogs": [
              "740411302"
            ]
          },
          "740411302": {
            "id": "740411302",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "你…你们是为了这些纸带来的吧？全都给你们！不要再打啦！",
            "nextDialogs": [
              "740411303"
            ]
          },
          "740411303": {
            "id": "740411303",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "愚人众指挥官老老实实地交出了所有的研究数据…",
            "nextDialogs": [
              "740411304"
            ]
          },
          "740411304": {
            "id": "740411304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么样，布罗意，这些就是全部了吗？",
            "nextDialogs": [
              "740411305"
            ]
          },
          "740411305": {
            "id": "740411305",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "呃，这个…也许吧？嗯，没错，这应该就是全部了！",
            "nextDialogs": [
              "740411306"
            ]
          },
          "740411306": {
            "id": "740411306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "算了，就当我没问吧…",
            "nextDialogs": [
              "740411307"
            ]
          },
          "740411307": {
            "id": "740411307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们的目的是什么？",
            "nextDialogs": [
              "740411308"
            ]
          },
          "740411308": {
            "id": "740411308",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对啊，老实交代！你们占领这些观测站，到底是想要做什么？",
            "nextDialogs": [
              "740411309"
            ]
          },
          "740411309": {
            "id": "740411309",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "……",
            "nextDialogs": [
              "740411310"
            ]
          },
          "740411310": {
            "id": "740411310",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "是…为了偷懒…",
            "nextDialogs": [
              "740411311"
            ]
          },
          "740411311": {
            "id": "740411311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…？",
            "nextDialogs": [
              "740411312"
            ]
          },
          "740411312": {
            "id": "740411312",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "我的名字是马林诺夫斯基，第三十四独立侦察小队的队长。",
            "nextDialogs": [
              "740411313"
            ]
          },
          "740411313": {
            "id": "740411313",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "一开始，我们刚被调派到枫丹的时候，大家过得都很开心，也没有什么困难的任务…",
            "nextDialogs": [
              "740411315"
            ]
          },
          "740411315": {
            "id": "740411315",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃…所以这跟你占领观测站有什么关系？",
            "nextDialogs": [
              "740411316"
            ]
          },
          "740411316": {
            "id": "740411316",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "没想到，就在几个月前，由于人事关系变动，至冬那边给我分派了一个叫舒米洛夫的家伙，作为我的新副官！",
            "nextDialogs": [
              "740411317"
            ]
          },
          "740411317": {
            "id": "740411317",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "舒米洛夫？啊，是之前在桔桔薄饼站那边见到的那个小队长…",
            "nextDialogs": [
              "740411318"
            ]
          },
          "740411318": {
            "id": "740411318",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "是啊！我实在是受不了那家伙了！但是又没有办法解决掉他，只好找个借口，主动外出执行任务，以便从他身边逃开——",
            "nextDialogs": [
              "740411319"
            ]
          },
          "740411319": {
            "id": "740411319",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "等等，你把我说糊涂了…那个叫舒米洛夫的家伙，是你的副官？",
            "nextDialogs": [
              "740411320"
            ]
          },
          "740411320": {
            "id": "740411320",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "是啊。",
            "nextDialogs": [
              "740411321"
            ]
          },
          "740411321": {
            "id": "740411321",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那他不就是你的下属嘛，上司为什么得听下属的话！",
            "nextDialogs": [
              "740411322"
            ]
          },
          "740411322": {
            "id": "740411322",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "那个可恶的家伙，分明是我的下属，却总是摆出一副严肃的样子来，让其他人努力工作！",
            "nextDialogs": [
              "740411323"
            ]
          },
          "740411323": {
            "id": "740411323",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "他说的还都是无法反驳的正论——我总不能当着其他人的面，公开跟他说大家其实根本不想工作吧？！",
            "nextDialogs": [
              "740411324"
            ]
          },
          "740411324": {
            "id": "740411324",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "正好，我看到附近有一些奇怪的塔，干脆就说我们要来这边调查，然后伪造了复律庭的信件…",
            "nextDialogs": [
              "740411325"
            ]
          },
          "740411325": {
            "id": "740411325",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼，果然是你们伪造的！想想也是，复律庭怎么可能把水文监测站交给你们管理！",
            "nextDialogs": [
              "740411326"
            ]
          },
          "740411326": {
            "id": "740411326",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "布罗意，你还有什么想问他的吗？",
            "nextDialogs": [
              "740411327"
            ]
          },
          "740411327": {
            "id": "740411327",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "嗯…原来如此，您占据我们的观测站，只是想要偷懒…不，只是想要在这个喧嚣的世界中获得片刻的安宁。",
            "nextDialogs": [
              "740411328"
            ]
          },
          "740411328": {
            "id": "740411328",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "所以呢？您觉得在这里休息的感觉如何？",
            "nextDialogs": [
              "740411329"
            ]
          },
          "740411329": {
            "id": "740411329",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "？",
            "nextDialogs": [
              "740411330"
            ]
          },
          "740411330": {
            "id": "740411330",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "呃…非常舒服？附近的风景也很漂亮，稍微午睡一下，就觉得心情都变得舒畅起来了…",
            "nextDialogs": [
              "740411331"
            ]
          },
          "740411331": {
            "id": "740411331",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "对吧？尤其是一觉醒来，发现自己没有任何不得不做的紧急工作，也没有讨厌的人盯着您，只要安心享受午后的阳光与微风…",
            "nextDialogs": [
              "740411332"
            ]
          },
          "740411332": {
            "id": "740411332",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "就像是从一场梦醒来，就进入了另外一场不必为任何事忧虑的梦。",
            "nextDialogs": [
              "740411333"
            ]
          },
          "740411333": {
            "id": "740411333",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "呵，这才是生活，先生！真遗憾，您应该还没有品尝过瓦萨里回廊限量贩售的红茶吧？要是您有机会的话——",
            "nextDialogs": [
              "740411334"
            ]
          },
          "740411334": {
            "id": "740411334",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不不不，你们怎么突然开始聊这种莫名其妙的话题啦！",
            "nextDialogs": [
              "740411335"
            ]
          },
          "740411335": {
            "id": "740411335",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好了，你这家伙，还是老老实实跟我们走一趟吧！是时候向枫丹科学院细数你的罪恶了！",
            "nextDialogs": [
              "740411336"
            ]
          },
          "740411336": {
            "id": "740411336",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "噫呜——",
            "nextDialogs": [
              "740411337"
            ]
          },
          "740411337": {
            "id": "740411337",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "请、请等一下！",
            "nextDialogs": [
              "740411338"
            ]
          },
          "740411338": {
            "id": "740411338",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "#{M#两位恩人}{F#两位恩人小姐}！这位先生实际上并没有对我们的水文研究造成任何破坏，不是吗？",
            "nextDialogs": [
              "740411339"
            ]
          },
          "740411339": {
            "id": "740411339",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "从客观结果上来说，这位先生甚至还帮助我们收集了一部分数据…",
            "nextDialogs": [
              "740411340"
            ]
          },
          "740411340": {
            "id": "740411340",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "更何况，他也只是不想工作，想要过上美好幸福清闲的生活而已！",
            "nextDialogs": [
              "740411341"
            ]
          },
          "740411341": {
            "id": "740411341",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "是、是的！",
            "nextDialogs": [
              "740411342"
            ]
          },
          "740411342": {
            "id": "740411342",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不，就算你们两个说得这么理直气壮，这也不是什么值得骄傲的事情吧！",
            "nextDialogs": [
              "740411343"
            ]
          },
          "740411343": {
            "id": "740411343",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "#拜托了，好心的{M#先生}{F#小姐}！看在科学的份上，就请您宽宏大量，放过他这一次吧！",
            "nextDialogs": [
              "740411346"
            ]
          },
          "740411346": {
            "id": "740411346",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "谢…谢谢你，先生，还有两位！我发誓，我绝对绝对不会再做这种事了！从今往后，我一定会拼尽全力，只靠自己的能力偷懒！",
            "nextDialogs": [
              "740411347"
            ]
          },
          "740411347": {
            "id": "740411347",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "没错！最重要的就是那样的决心！",
            "nextDialogs": [
              "740411348"
            ]
          },
          "740411348": {
            "id": "740411348",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不要在这种地方燃起奇怪的斗志啊！",
            "nextDialogs": [
              "740411349"
            ]
          },
          "740411349": {
            "id": "740411349",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "愚人众的指挥官感恩戴德地离开了…",
            "nextDialogs": [
              "740411350"
            ]
          },
          "740411350": {
            "id": "740411350",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "好！既然问题已经圆满解决了，我也该回去整理一下这些数据了！",
            "nextDialogs": [
              "740411351"
            ]
          },
          "740411351": {
            "id": "740411351",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "非常感谢两位！拜托了，请务必收下这些！",
            "nextDialogs": [
              "740411352"
            ]
          },
          "740411352": {
            "id": "740411352",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真…真的圆满解决了吗？",
            "nextDialogs": [
              "740411353"
            ]
          },
          "740411353": {
            "id": "740411353",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，算了…观测站也恢复运作了，那些愚人众小队也撤退了，这件事也算是告一段落了吧…"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7404101",
      "subQuestName": "与布罗意对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740410101"
        ],
        "dialogs": {
          "740410101": {
            "id": "740410101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "布罗意，你说的那两座观测站的数据，我们已经拿到手啦！",
            "nextDialogs": [
              "740410102"
            ]
          },
          "740410102": {
            "id": "740410102",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "真的吗？！那可真是太好了！拜托了，快点让我看看——",
            "nextDialogs": [
              "740410107",
              "740410105"
            ]
          },
          "740410107": {
            "id": "740410107",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "将之前收集到的纸带交给了布罗意…",
            "nextDialogs": [
              "740410108"
            ]
          },
          "740410108": {
            "id": "740410108",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "啊啊啊，没错，就是这个，就是这个！两位简直就是上天派来救我脱离苦海，重新过上美好幸福清闲生活的天使——",
            "nextDialogs": [
              "740410109"
            ]
          },
          "740410109": {
            "id": "740410109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也不至于夸张到这个地步吧！",
            "nextDialogs": [
              "740410110"
            ]
          },
          "740410110": {
            "id": "740410110",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "#总之，事不宜迟，好心的{M#先生}{F#小姐}，我这就去找主管申请中枢处理站的钥匙，请您稍微等我一下！",
            "nextDialogs": [
              "740410111"
            ]
          },
          "740410111": {
            "id": "740410111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唉，真是的…记得快一点呀！",
            "nextDialogs": [
              "740410112"
            ]
          },
          "740410112": {
            "id": "740410112",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "没过多久，布罗意兴奋地回来了…",
            "nextDialogs": [
              "740410113"
            ]
          },
          "740410113": {
            "id": "740410113",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "#{M#先生}{F#小姐}，我已经拿到钥匙了！接下来只要前往中枢处理站，完成对这些数据的整理，水文观测事业就可以顺利恢复了！"
          },
          "740410105": {
            "id": "740410105",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "这个…请您不必担心，只要主管能批准恢复原本的水文研究，报酬一定不会少了您的！",
            "nextDialogs": [
              "740410106"
            ]
          },
          "740410106": {
            "id": "740410106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，那就好！"
          }
        }
      }
    },
    {
      "subId": "7404102",
      "subQuestName": "(跳过)等待到第二天",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740410201"
        ],
        "dialogs": {
          "740410201": {
            "id": "740410201",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "#{M#先生}{F#小姐}，您终于来了！",
            "nextDialogs": [
              "740410202"
            ]
          },
          "740410202": {
            "id": "740410202",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "我已经拿到钥匙了！接下来只要前往中枢处理站，完成对这些数据的整理，水文观测事业就可以顺利恢复了！",
            "nextDialogs": [
              "740410205"
            ]
          },
          "740410205": {
            "id": "740410205",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "考虑到「果果软糖站」和「桔桔薄饼站」的情况，中枢处理站说不定也有那些来自至冬的先生们…",
            "nextDialogs": [
              "740410206"
            ]
          },
          "740410206": {
            "id": "740410206",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "所以…拜托了，请两位陪伴我一起去吧！",
            "nextDialogs": [
              "740410207"
            ]
          },
          "740410207": {
            "id": "740410207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，你可别忘了给我们报酬呀！"
          }
        }
      }
    },
    {
      "subId": "7404103",

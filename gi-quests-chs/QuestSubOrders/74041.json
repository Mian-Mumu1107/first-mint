    {
      "subId": "7404114",
      "subQuestName": "与布罗意对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740411401"
        ],
        "dialogs": {
          "740411401": {
            "id": "740411401",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "#我们到了！请看，{M#先生}{F#小姐}，这里就是中枢处理站，用来读取水文研究数据的地方！",
            "nextDialogs": [
              "740411404"
            ]
          },
          "740411404": {
            "id": "740411404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是呀，既然没有愚人众，这里应该也就用不到我们了…",
            "nextDialogs": [
              "740411405"
            ]
          },
          "740411405": {
            "id": "740411405",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "这个…现在还不能肯定嘛，要是里面万一有那些至冬来的先生，我可能就再也见不到晶螺糕了…",
            "nextDialogs": [
              "740411406"
            ]
          },
          "740411406": {
            "id": "740411406",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "#咳，我是说，再也没办法进行水文研究了！就拜托两位好心{M#人}{F#的小姐}，陪我一起进去看看吧！",
            "nextDialogs": [
              "740411407"
            ]
          },
          "740411407": {
            "id": "740411407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唉，没办法，你开门吧…"
          }
        }
      }
    },
    {
      "subId": "7404105",
      "subQuestName": "进入中枢处理站",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740410501"
        ],
        "dialogs": {
          "740410501": {
            "id": "740410501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，看到那家伙了！在那边，不要逃！"
          }
        }
      }
    },
    {
      "subId": "7404106",
      "subQuestName": "调查中枢处理站",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740410601"
        ],
        "dialogs": {
          "740410601": {
            "id": "740410601",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "嗯，让我看看…",
            "nextDialogs": [
              "740410602"
            ]
          },
          "740410602": {
            "id": "740410602",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "如果能把先前收集到的数据汇总起来，应该能取得不错的成果…恢复水文监测的事情，指日可待，指日可待呀！",
            "nextDialogs": [
              "740410603"
            ]
          },
          "740410603": {
            "id": "740410603",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦哦，那真是太好啦！",
            "nextDialogs": [
              "740410604"
            ]
          },
          "740410604": {
            "id": "740410604",
            "speakerId": 1001,
            "speakerName": "布罗意",
            "text": "咦？总觉得好像缺了一部分数据…是错觉吗？",
            "nextDialogs": [
              "740410605"
            ]
          },
          "740410605": {
            "id": "740410605",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "为什么说得这么不确定啦！这不是你自己负责的数据吗！",
            "nextDialogs": [
              "740410606"
            ]
          },
          "740410606": {
            "id": "740410606",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "……",
            "nextDialogs": [
              "740410607"
            ]
          },
          "740410607": {
            "id": "740410607",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "740410608"
            ]
          },
          "740410608": {
            "id": "740410608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…？",
            "nextDialogs": [
              "740410609"
            ]
          },
          "740410609": {
            "id": "740410609",
            "speakerId": 1004,
            "speakerName": "马林诺夫斯基",
            "text": "…呃，抱歉，走错房间了…",
            "nextDialogs": [
              "740410610"
            ]
          },
          "740410610": {
            "id": "740410610",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "愚人众指挥官，以一种与体型完全不符的敏捷，飞也似的溜走了…",
            "nextDialogs": [
              "740410611"
            ]
          },
          "740410611": {
            "id": "740410611",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "等…等一下，刚才什么东西过去了？",
            "nextDialogs": [
              "740410614"
            ]
          },
          "740410614": {
            "id": "740410614",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不不不，现在好像不是关心那种事情的时候啦！那家伙是愚人众吧！为什么会出现在这里啊！",
            "nextDialogs": [
              "740410615"
            ]
          },
          "740410615": {
            "id": "740410615",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们快点追上去，好好问个清楚！"
          }
        }
      }
    },

    "阿贝多": 13
  },
  "subQuests": [
    {
      "subId": "7011401",
      "subQuestName": "前往阿贝多的雪山营地附近开启茶会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701140101"
        ],
        "dialogs": {
          "701140101": {
            "id": "701140101",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "桑多涅小姐居然能抽空到蒙德来，真是不容易。",
            "nextDialogs": [
              "701140102"
            ]
          },
          "701140102": {
            "id": "701140102",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "之前在我研究「数秘阵列」的时候，你帮了我很多忙。我想当面向你表示感谢。",
            "nextDialogs": [
              "701140103"
            ]
          },
          "701140103": {
            "id": "701140103",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "不必客气。这项课题本就是我专业之外的领域，它能完成更多还是桑多涅小姐你的功劳。",
            "nextDialogs": [
              "701140104"
            ]
          },
          "701140104": {
            "id": "701140104",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "这是大家的功劳。咦？这么说来怎么没见杜林？我还以为他不能离你太远，你算是他的监护人呢。",
            "nextDialogs": [
              "701140105"
            ]
          },
          "701140105": {
            "id": "701140105",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "你的看法也不能说有错。",
            "nextDialogs": [
              "701140106"
            ]
          },
          "701140106": {
            "id": "701140106",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "但最近他已经越来越能融入大家的谈话了，所以我在试着让他自己安排日常生活。",
            "nextDialogs": [
              "701140107"
            ]
          },
          "701140107": {
            "id": "701140107",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "你不会担心吗？",
            "nextDialogs": [
              "701140108"
            ]
          },
          "701140108": {
            "id": "701140108",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "会有一点。以前他独自行动，和一些性格较为强烈的人接触过后，就会…",
            "nextDialogs": [
              "701140109"
            ]
          },
          "701140109": {
            "id": "701140109",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "学到些奇奇怪怪的东西？模仿奇奇怪怪的口癖？",
            "nextDialogs": [
              "701140110"
            ]
          },
          "701140110": {
            "id": "701140110",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "嗯，很准确。桑多涅小姐也经历过类似的事吗？",
            "nextDialogs": [
              "701140111"
            ]
          },
          "701140111": {
            "id": "701140111",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "呵，还用说吗？我可太懂了…",
            "nextDialogs": [
              "701140112"
            ]
          },
          "701140112": {
            "id": "701140112",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "一般和法尔伽团长见面过后，我会时不时带杜林去砂糖那协助做些研究，让他静静心。",
            "nextDialogs": [
              "701140113"
            ]
          },
          "701140113": {
            "id": "701140113",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "但和琴团长待太久的话，我又会带他去见见可莉。让他重新学会放松。",
            "nextDialogs": [
              "701140114"
            ]
          },
          "701140114": {
            "id": "701140114",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "你也真是不容易…",
            "nextDialogs": [
              "701140115"
            ]
          },
          "701140115": {
            "id": "701140115",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "照顾家人而已。",
            "nextDialogs": [
              "701140116"
            ]
          },
          "701140116": {
            "id": "701140116",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "桑多涅小姐又是怎么处理此类事情的呢？",
            "nextDialogs": [
              "701140117"
            ]
          },
          "701140117": {
            "id": "701140117",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "啊？我才没心情去管这些乱七八糟的事…",
            "nextDialogs": [
              "701140118"
            ]
          },
          "701140118": {
            "id": "701140118",
            "speakerId": 1001,
            "speakerName": "「木偶」",
            "text": "但在我看来，只要一个人本性不坏，就算受到再多影响，最终也还是会回归到他最本真的样子。",
            "nextDialogs": [
              "701140119"
            ]
          },
          "701140119": {
            "id": "701140119",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "唔…不错的观点。或许我也该尝试采纳此种想法。"
          }
        }
      }
    },
    {
      "subId": "7011402",
      "subQuestName": "前往阿贝多的雪山营地附近开启茶会",
      "sceneId": null,
      "locations": [],
      "dialogue": {

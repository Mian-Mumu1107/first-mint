        ],
        "dialogs": {
          "701140201": {
            "id": "701140201",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "多谢桑多涅小姐的招待。",
            "nextDialogs": [
              "701140204"
            ]
          },
          "701140204": {
            "id": "701140204",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "好，我们后会有期。"
          }
        }
      }
    },

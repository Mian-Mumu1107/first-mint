    },
    {
      "subId": "2502002",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250200201"
        ],
        "dialogs": {
          "250200201": {
            "id": "250200201",
            "speakerId": 1000,
            "speakerName": "卡兹加",
            "text": "呃…先把这个系住。然后捆住这里…咦？是这么做的吗？"
          }
        }
      }
    },
    {
      "subId": "2502009",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250200901"
        ],
        "dialogs": {
          "250200901": {
            "id": "250200901",
            "speakerId": 1001,
            "speakerName": "霍莱",
            "text": "呜！呜呜！"
          }
        }
      }
    },
    {
      "subId": "2502011",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250201101"
        ],
        "dialogs": {
          "250201101": {
            "id": "250201101",
            "speakerId": 1000,
            "speakerName": "卡兹加",
            "text": "霍莱就在那。正巧，旁边有个水塘。如果能把它引进水塘去，那正好也能给它好好洗一顿…",
            "nextDialogs": [
              "250201102"
            ]
          },
          "250201102": {
            "id": "250201102",
            "speakerId": 1000,
            "speakerName": "卡兹加",
            "text": "我过去的话，肯定会被这小子发现。就拜托你去放「漂流球」了，只要放在水塘中央就好。",
            "nextDialogs": [
              "250201103"
            ]
          },
          "250201103": {
            "id": "250201103",
            "speakerId": 1000,
            "speakerName": "卡兹加",
            "text": "去把「漂流球」放在水塘中央吧…希望霍莱能喜欢。"
          }
        }
      }
    },
    {
      "subId": "2502099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250209901"
        ],
        "dialogs": {
          "250209901": {
            "id": "250209901",
            "speakerId": 1000,
            "speakerName": "卡兹加",
            "text": "呜？呜呜呜…？"
          }
        }
      }
    }
  ]

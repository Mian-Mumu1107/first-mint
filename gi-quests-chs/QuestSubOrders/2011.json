  "subQuests": [
    {
      "subId": "201101",
      "subQuestName": "向凯瑟琳打听前往稻妻的情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20110101"
        ],
        "dialogs": {
          "20110101": {
            "id": "20110101",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "旅行者，有什么可以帮你的吗？",
            "nextDialogs": [
              "20110104"
            ]
          },
          "20110104": {
            "id": "20110104",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "嗯，我听说了，你们和南十字船队的大姐头约好了，会带你们前往稻妻是吧？",
            "nextDialogs": [
              "20110105"
            ]
          },
          "20110105": {
            "id": "20110105",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "确实已经过去蛮久了，我这边倒也没有什么值得注意的情报…",
            "nextDialogs": [
              "20110106"
            ]
          },
          "20110106": {
            "id": "20110106",
            "speakerId": 1001,
            "speakerName": "海龙",
            "text": "可找到你了！你就是大姐头看好的那个旅行者吧？"
          }
        }
      }
    },
    {
      "subId": "201102",
      "subQuestName": "登上「死兆星」号，寻找北斗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "201103",
      "subQuestName": "与北斗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20110301"
        ],
        "dialogs": {
          "20110301": {
            "id": "20110301",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "哟，你们终于来了。",
            "nextDialogs": [
              "20110302"
            ]
          },
          "20110302": {
            "id": "20110302",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "过去连暴风雨都没法让「南十字船队」耽搁，这次我可是给足了你们面子啊。",
            "nextDialogs": [
              "20110305"
            ]
          },
          "20110305": {
            "id": "20110305",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "哈哈哈，玩笑话而已。你们来得正好，出海工作刚刚就绪。",
            "nextDialogs": [
              "20110306"
            ]
          },
          "20110306": {
            "id": "20110306",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "既然人都到齐了，也是时候——",
            "nextDialogs": [
              "20110307"
            ]
          },
          "20110307": {
            "id": "20110307",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "朝着雷霆骤雨所包围的「永恒」国度，起航！",
            "nextDialogs": [
              "20110308"
            ]
          },
          "20110308": {
            "id": "20110308",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "出发！"
          }
        }
      }
    },
    {

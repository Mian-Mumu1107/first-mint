      }
    },
    {
      "subId": "201107",
      "subQuestName": "与接洽人托马对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20110701"
        ],
        "dialogs": {
          "20110701": {
            "id": "20110701",
            "speakerId": 1004,
            "speakerName": "托马",
            "text": "终于来了，「璃月人的大姐头」，可让我好等。",
            "nextDialogs": [
              "20110702"
            ]
          },
          "20110702": {
            "id": "20110702",
            "speakerId": 1004,
            "speakerName": "托马",
            "text": "还有这两位偷渡客…哦不，贵客。",
            "nextDialogs": [
              "20110703"
            ]
          },
          "20110703": {
            "id": "20110703",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嘘！",
            "nextDialogs": [
              "20110704"
            ]
          },
          "20110704": {
            "id": "20110704",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "还不是因为你们的将军大人，最近稻妻外海的雷暴和风浪比之前还要强烈了…",
            "nextDialogs": [
              "20110705"
            ]
          },
          "20110705": {
            "id": "20110705",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "我的船队尽管大显身手了一番，但还是耽误了些时间。",
            "nextDialogs": [
              "20110706"
            ]
          },
          "20110706": {
            "id": "20110706",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "哦对了，给你们介绍一下，这位是托马，算是我最近才熟络的商业伙伴。",
            "nextDialogs": [
              "20110707"
            ]
          },
          "20110707": {
            "id": "20110707",
            "speakerId": 1004,
            "speakerName": "托马",
            "text": "哟，我一直很期待见到你们。",
            "nextDialogs": [
              "20110708"
            ]
          },
          "20110708": {
            "id": "20110708",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "托马，这两位是…",
            "nextDialogs": [
              "20110709"
            ]
          },
          "20110709": {
            "id": "20110709",
            "speakerId": 1004,
            "speakerName": "托马",
            "text": "不用介绍了，异乡旅人的名望，可是外海的暴风雨都拦不住的，早就如雷贯耳了。",
            "nextDialogs": [
              "20110712"
            ]
          },
          "20110712": {
            "id": "20110712",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "你说话真好听，嘿嘿。",
            "nextDialogs": [
              "20110713"
            ]
          },
          "20110713": {
            "id": "20110713",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "嗯，这样倒也方便了。",
            "nextDialogs": [
              "20110714"
            ]
          },
          "20110714": {
            "id": "20110714",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "#{NICKNAME}，托马在离岛混迹了很长一段时间了，说他是这里的地头蛇也不为过。",
            "nextDialogs": [
              "20110715"
            ]
          },
          "20110715": {
            "id": "20110715",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "如果有什么难处就找他吧，但如果他对你图谋不轨…等下次来稻妻，我会替你出头的。",
            "nextDialogs": [
              "20110716"
            ]
          },
          "20110716": {
            "id": "20110716",
            "speakerId": 1004,
            "speakerName": "托马",
            "text": "哈哈哈…放心放心，我预感我们会相处很愉快的。",
            "nextDialogs": [
              "20110717"
            ]
          },
          "20110717": {
            "id": "20110717",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "那时间差不多了，毕竟我的船上还藏了个「通缉犯」，不方便久留。",
            "nextDialogs": [
              "20110718"
            ]
          },
          "20110718": {
            "id": "20110718",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "是说万叶呀…",
            "nextDialogs": [
              "20110719"
            ]
          },
          "20110719": {
            "id": "20110719",
            "speakerId": 1002,
            "speakerName": "北斗",
            "text": "下次再见吧，旅行者，不管你在稻妻遇上什么「惊涛骇浪」，都要好好给我捱过去啊！"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "2050501",
      "subQuestName": "与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205050101"
        ],
        "dialogs": {
          "205050101": {
            "id": "205050101",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "不好意思，又把你叫过来。",
            "nextDialogs": [
              "205050103",
              "205050105"
            ]
          },
          "205050103": {
            "id": "205050103",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "你能这么说真是太好了，那我尽量长话短说。",
            "nextDialogs": [
              "205050106"
            ]
          },
          "205050106": {
            "id": "205050106",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "很感谢你之前能帮忙完成协会的委托，冒险家协会的风评也变得越来越好了。",
            "nextDialogs": [
              "205050107"
            ]
          },
          "205050107": {
            "id": "205050107",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "不过因为这个，愿意来委托协会的人越来越多，现在冒险家们已经有点忙不过来了。",
            "nextDialogs": [
              "205050108"
            ]
          },
          "205050108": {
            "id": "205050108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是要我们去当宣传员吗？",
            "nextDialogs": [
              "205050109"
            ]
          },
          "205050109": {
            "id": "205050109",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "啊，不是的，有这份心我很感激。我也希望能有更多新人加入协会…",
            "nextDialogs": [
              "205050110"
            ]
          },
          "205050110": {
            "id": "205050110",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "但现在再去找新人，有点远水救不了近火的感觉。",
            "nextDialogs": [
              "205050111"
            ]
          },
          "205050111": {
            "id": "205050111",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "我想问问看，不知道你的朋友有时间帮这个忙吗？"
          },
          "205050105": {
            "id": "205050105",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "哈哈…确实是这样，看来你很感兴趣的样子。"
          }
        }
      }
    },
    {
      "subId": "2050502",
      "subQuestName": "(test)与凯瑟琳对话（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205050201"
        ],
        "dialogs": {
          "205050201": {
            "id": "205050201",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "你可以随时承接「探索派遣」，而执行委托的伙伴在此期间仍然可以和你一起冒险。",
            "nextDialogs": [
              "205050202"
            ]
          },
          "205050202": {
            "id": "205050202",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "进行不同程度的探索会花费不同的时间，探索完成后，只需要来我这里确认一下成果就好了。",
            "nextDialogs": [
              "205050203"
            ]
          },
          "205050203": {
            "id": "205050203",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "随着「冒险等阶」的提高，还可以去更多更危险的地方探索。",
            "nextDialogs": [
              "205050204"
            ]
          },
          "205050204": {
            "id": "205050204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是能力越大，责任越大吧！",
            "nextDialogs": [
              "205050205"
            ]
          },
          "205050205": {
            "id": "205050205",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "是的，当然这也是为了各位的安全着想。",
            "nextDialogs": [
              "205050206"
            ]
          },
          "205050206": {
            "id": "205050206",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "再次感谢你的帮助，希望你和你的伙伴能多多承接「探索派遣」哦。"
          }
        }
      }
    }
  ]
}
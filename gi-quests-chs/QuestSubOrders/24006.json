  "subQuests": [
    {
      "subId": "2400601",
      "subQuestName": "与韦吕对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240060101"
        ],
        "dialogs": {
          "240060101": {
            "id": "240060101",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "这次轮到我来抓人了，我肯定能抓住洛薇。",
            "nextDialogs": [
              "240060102"
            ]
          },
          "240060102": {
            "id": "240060102",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "那可说不准。有些地方你都爬不上去呢。",
            "nextDialogs": [
              "240060103"
            ]
          },
          "240060103": {
            "id": "240060103",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "那是…那是因为我的鞋子不适合爬，要是换双鞋，肯定能抓住你！",
            "nextDialogs": [
              "240060104"
            ]
          },
          "240060104": {
            "id": "240060104",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "那我们干脆把鞋子都脱掉好了，这样才公平！",
            "nextDialogs": [
              "240060105"
            ]
          },
          "240060105": {
            "id": "240060105",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "好了！你们不许光脚到处跑，这里到处都是废弃的零件，要是划伤了怎么办？",
            "nextDialogs": [
              "240060106"
            ]
          },
          "240060106": {
            "id": "240060106",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "是…",
            "nextDialogs": [
              "240060107"
            ]
          },
          "240060107": {
            "id": "240060107",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "好…",
            "nextDialogs": [
              "240060108"
            ]
          },
          "240060108": {
            "id": "240060108",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "那个…哥，你刚才抓我的时候，怎么一副走神的样子啊？我从你面前跑过去都没反应。",
            "nextDialogs": [
              "240060109"
            ]
          },
          "240060109": {
            "id": "240060109",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "咦？是这样吗？我刚才完全没注意到…",
            "nextDialogs": [
              "240060110"
            ]
          },
          "240060110": {
            "id": "240060110",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "是啊，我刚才绕着跑一圈啦，但你就和没看见我一样。",
            "nextDialogs": [
              "240060111"
            ]
          },
          "240060111": {
            "id": "240060111",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "#但…欸？{M#大哥哥}{F#大姐姐}，您怎么来了？",
            "nextDialogs": [
              "240060113",
              "240060116"
            ]
          },
          "240060113": {
            "id": "240060113",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "爸爸说他最近要去出差，妈妈也要出去工作。",
            "nextDialogs": [
              "240060114"
            ]
          },
          "240060114": {
            "id": "240060114",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "正好奥雷勒哥哥来还书，爸爸就拜托奥雷勒哥哥来照顾我，所以我就来这里和他们一起玩啦。",
            "nextDialogs": [
              "240060118"
            ]
          },
          "240060118": {
            "id": "240060118",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "不说这些了，继续玩吧，这次谁来抓人？"
          },
          "240060116": {
            "id": "240060116",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "是的。因为德勒吕叔叔正巧要去出差，杜梅阿姨也要去工作，于是他们就拜托我来照顾洛薇。",
            "nextDialogs": [
              "240060117"
            ]
          },
          "240060117": {
            "id": "240060117",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "所以我就带着洛薇来这里和我们一起玩了，希望她的裙子不会被弄得太脏…"
          }
        }
      }
    },
    {
      "subId": "2400602",
      "subQuestName": "找到孩子们",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240060201"
        ],
        "dialogs": {
          "240060201": {
            "id": "240060201",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "#还是被找到啦，{M#大哥哥}{F#大姐姐}果然还是比我厉害。",
            "nextDialogs": [
              "240060202"
            ]
          },
          "240060202": {
            "id": "240060202",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "那我去集合点啦，希望哥哥能晚点被找到…",
            "nextDialogs": [
              "240060203"
            ]
          },
          "240060203": {
            "id": "240060203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你为什么这么希望？",
            "nextDialogs": [
              "240060204"
            ]
          },
          "240060204": {
            "id": "240060204",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "哥哥说过呀，每次玩捉迷藏了之后，他都会找到很多新思路。",
            "nextDialogs": [
              "240060205"
            ]
          },
          "240060205": {
            "id": "240060205",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "那些思路太多了，他每次都要蹲在地上记好久。",
            "nextDialogs": [
              "240060206"
            ]
          },
          "240060206": {
            "id": "240060206",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "洛薇和我说，那些思路可宝贵了，绝对不能打扰他。",
            "nextDialogs": [
              "240060207"
            ]
          },
          "240060207": {
            "id": "240060207",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "所以我和洛薇在和哥哥玩捉迷藏的时候。如果轮到他被抓，那我们就会故意拖长时间，等他记好了再去找他。",
            "nextDialogs": [
              "240060208"
            ]
          },
          "240060208": {
            "id": "240060208",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "就是…如果轮到哥哥抓人，那我们可就得等好长一段时间了…"
          }
        }
      }
    },
    {
      "subId": "2400603",
      "subQuestName": "找到孩子们",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240060301"
        ],
        "dialogs": {
          "240060301": {
            "id": "240060301",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "不行…这一段的逻辑不通顺，要从另外一个角度切入…",
            "nextDialogs": [
              "240060302"
            ]
          },
          "240060302": {
            "id": "240060302",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "这么…不对，还是不对…",
            "nextDialogs": [
              "240060303"
            ]
          },
          "240060303": {
            "id": "240060303",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "啊？我被找到了啊，我现在就去集合点。",
            "nextDialogs": [
              "240060304"
            ]
          },
          "240060304": {
            "id": "240060304",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "嗯…这个观点对吗？不对，呃…对不对呢…"
          }
        }
      }
    },
    {
      "subId": "2400604",
      "subQuestName": "找到孩子们",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240060401"
        ],
        "dialogs": {
          "240060401": {
            "id": "240060401",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "不知道奥雷勒哥哥能不能找到思路…",
            "nextDialogs": [
              "240060402"
            ]
          },
          "240060402": {
            "id": "240060402",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "#咦？！这个地方也能被找到吗？{M#大哥哥}{F#大姐姐}，你到底玩过多少次捉迷藏啊…",
            "nextDialogs": [
              "240060403"
            ]
          },
          "240060403": {
            "id": "240060403",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "那我回集合点啦，下次一定藏得再好点。"
          }
        }
      }
    },
    {
      "subId": "2400605",
      "subQuestName": "(test)（隐藏）抓三个小孩保底$HIDDEN",

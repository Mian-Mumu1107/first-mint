    {
      "subId": "2400606",
      "subQuestName": "与奥雷勒对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240060601"
        ],
        "dialogs": {
          "240060601": {
            "id": "240060601",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "不对，不对…这里的论证不严谨…",
            "nextDialogs": [
              "240060602"
            ]
          },
          "240060602": {
            "id": "240060602",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "#奥雷勒哥哥又不搭理人了…{M#大哥哥}{F#大姐姐}，谢谢你陪我们玩啦。",
            "nextDialogs": [
              "240060605"
            ]
          },
          "240060605": {
            "id": "240060605",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "只要他不像我爸爸一样，把咖啡当做水来喝，应该就不会有身体问题。",
            "nextDialogs": [
              "240060606"
            ]
          },
          "240060606": {
            "id": "240060606",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "这个问题嘛，就包在我身上，我不会让哥哥喝太多咖啡的，实在不行…我把他的咖啡都藏起来。",
            "nextDialogs": [
              "240060607"
            ]
          },
          "240060607": {
            "id": "240060607",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "唉，我还打算把我爸爸的咖啡，都拿过来藏在这里的…这下可藏不得啦。",
            "nextDialogs": [
              "240060608"
            ]
          },
          "240060608": {
            "id": "240060608",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "做评论家，可真是一件麻烦的事啊…"
          }
        }
      }
    },
    {
      "subId": "2400699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240069901"
        ],
        "dialogs": {
          "240069901": {
            "id": "240069901",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "找不到我…找不到我…",
            "nextDialogs": [
              "240069902"
            ]
          },
          "240069902": {
            "id": "240069902",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "奥雷勒真是的…",
            "nextDialogs": [
              "240069903"
            ]
          },
          "240069903": {
            "id": "240069903",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "这段还不错…",
            "nextDialogs": [
              "240069904"
            ]
          },
          "240069904": {
            "id": "240069904",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "抓不住我…抓不住我…",
            "nextDialogs": [
              "240069905"
            ]
          },
          "240069905": {
            "id": "240069905",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "奥雷勒这家伙…"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7450602",
      "subQuestName": "与乐平波琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745060201"
        ],
        "dialogs": {
          "745060201": {
            "id": "745060201",
            "speakerId": 1000,
            "speakerName": "乐平波琳",
            "text": "我拍拍拍拍拍…素材多多多多多…摩拉滚滚滚滚来！",
            "nextDialogs": [
              "745060202"
            ]
          },
          "745060202": {
            "id": "745060202",
            "speakerId": 1000,
            "speakerName": "乐平波琳",
            "text": "啊！不得了的大人物出现了！",
            "nextDialogs": [
              "745060203"
            ]
          },
          "745060203": {
            "id": "745060203",
            "speakerId": 1000,
            "speakerName": "乐平波琳",
            "text": "你们好啊，两位！我能给你们拍张照吗？",
            "nextDialogs": [
              "745060204"
            ]
          },
          "745060204": {
            "id": "745060204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦…那个人是在叫我们吗？她要给我们留影？",
            "nextDialogs": [
              "745060207"
            ]
          },
          "745060207": {
            "id": "745060207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#嘿嘿…看来我和{NICKNAME}也算是超级大名人了呢，居然有人主动给我们留影！",
            "nextDialogs": [
              "745060208"
            ]
          },
          "745060208": {
            "id": "745060208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，如果你要把我们的照片用在别的地方，按照枫丹的说法，你应该付我们…唔…出场费？出镜费？",
            "nextDialogs": [
              "745060209"
            ]
          },
          "745060209": {
            "id": "745060209",
            "speakerId": 1000,
            "speakerName": "乐平波琳",
            "text": "好！拍到你们两位是我乐平波琳的荣幸，这张照片算你们一百五十万摩拉怎么样？尊贵的皇牌冒险家搭档？",
            "nextDialogs": [
              "745060210"
            ]
          },
          "745060210": {
            "id": "745060210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯！这还差不多嘛…",
            "nextDialogs": [
              "745060211"
            ]
          },
          "745060211": {
            "id": "745060211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，等等，你说多少？一百五十万？我没听错吧！",
            "nextDialogs": [
              "745060212"
            ]
          },
          "745060212": {
            "id": "745060212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一张照片就给我们一百五十万…是不是有点夸张了？我们俩的形象有这么值钱吗？"
          }
        }
      }
    }
  ]

  },
  "subQuests": [
    {
      "subId": "2250001",
      "subQuestName": "与璐璐对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "225000101"
        ],
        "dialogs": {
          "225000101": {
            "id": "225000101",
            "speakerId": 1000,
            "speakerName": "璐璐",
            "text": "什么时候才能做好呢…",
            "nextDialogs": [
              "225000102"
            ]
          },
          "225000102": {
            "id": "225000102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "今天没玩游戏吗？",
            "nextDialogs": [
              "225000103"
            ]
          },
          "225000103": {
            "id": "225000103",
            "speakerId": 1000,
            "speakerName": "璐璐",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，是你呀，最近不适合玩游戏呢。",
            "nextDialogs": [
              "225000104"
            ]
          },
          "225000104": {
            "id": "225000104",
            "speakerId": 1000,
            "speakerName": "璐璐",
            "text": "小蒙好像有点不开心，老是一个人发呆，阿飞也时不时就找不到人了。",
            "nextDialogs": [
              "225000105"
            ]
          },
          "225000105": {
            "id": "225000105",
            "speakerId": 1000,
            "speakerName": "璐璐",
            "text": "我问小蒙怎么了，小蒙也不和我说…总觉得，大家最近都有点奇怪。",
            "nextDialogs": [
              "225000107",
              "225000111"
            ]
          },
          "225000107": {
            "id": "225000107",
            "speakerId": 1000,
            "speakerName": "璐璐",
            "text": "人长大了，就会不开心吗？但是小蒙和阿飞都很想长大…",
            "nextDialogs": [
              "225000108"
            ]
          },
          "225000108": {
            "id": "225000108",
            "speakerId": 1000,
            "speakerName": "璐璐",
            "text": "如果是这样的话，那我还是先不长大比较好。",
            "nextDialogs": [
              "225000109"
            ]
          },
          "225000109": {
            "id": "225000109",
            "speakerId": 1000,
            "speakerName": "璐璐",
            "text": "#先不说这个了，我有点小事，想请{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}帮忙。",
            "nextDialogs": [
              "225000112"
            ]
          },
          "225000112": {
            "id": "225000112",
            "speakerId": 1000,
            "speakerName": "璐璐",
            "text": "你能帮我去莺儿姐姐那里拿点东西吗？我和她已经说好了，那里应该已经把东西留给我了。"
          },
          "225000111": {
            "id": "225000111",
            "speakerId": 1000,
            "speakerName": "璐璐",
            "text": "#我？我还好喔，不过…还是有点小事想请{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}帮忙。"
          }
        }
      }
    },
    {
      "subId": "2250002",
      "subQuestName": "与莺儿对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "225000301"
        ],
        "dialogs": {
          "225000301": {
            "id": "225000301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "三千摩拉够了吗？",
            "nextDialogs": [
              "225000302"
            ]
          },
          "225000302": {
            "id": "225000302",
            "speakerId": 1001,
            "speakerName": "莺儿",
            "text": "你可真是个急性子…好吧，就当看在我们情谊的份儿上，我会先做璐璐的那份香膏的。",
            "nextDialogs": [
              "225000303"
            ]
          },
          "225000303": {
            "id": "225000303",
            "speakerId": 1001,
            "speakerName": "莺儿",
            "text": "不过，白天我还得看店，只有晚上才能做些私事。",
            "nextDialogs": [
              "225000304"
            ]
          },
          "225000304": {
            "id": "225000304",
            "speakerId": 1001,
            "speakerName": "莺儿",
            "text": "请你晚上再来找我吧，我会先把准备工作做好的。"
          }
        }
      }
    },
    {
      "subId": "2250003",
      "subQuestName": "等待夜晚降临",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

  "subQuests": [
    {
      "subId": "7153101",
      "subQuestName": "与文寻对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715310101"
        ],
        "dialogs": {
          "715310101": {
            "id": "715310101",
            "speakerId": 30458,
            "speakerName": "文寻",
            "text": "圆圆滚滚蓬蓬松松，软软弹弹蹦蹦跳跳…",
            "nextDialogs": [
              "715310102"
            ]
          },
          "715310102": {
            "id": "715310102",
            "speakerId": 30458,
            "speakerName": "文寻",
            "text": "呀！有客人来了，你们好你们好，我文寻先祝两位海灯节快乐！",
            "nextDialogs": [
              "715310103"
            ]
          },
          "715310103": {
            "id": "715310103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "海灯节快乐，文寻小姐！",
            "nextDialogs": [
              "715310104"
            ]
          },
          "715310104": {
            "id": "715310104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚才我们好像听见你念念有词，你在自言自语什么呢？",
            "nextDialogs": [
              "715310107"
            ]
          },
          "715310107": {
            "id": "715310107",
            "speakerId": 30458,
            "speakerName": "文寻",
            "text": "猜得八九不离十了，我在想的是锅巴和月桂要做的美食哦！",
            "nextDialogs": [
              "715310108"
            ]
          },
          "715310108": {
            "id": "715310108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？突然就听到了熟悉的名字…你也认识锅巴和月桂吗？",
            "nextDialogs": [
              "715310109"
            ]
          },
          "715310109": {
            "id": "715310109",
            "speakerId": 30458,
            "speakerName": "文寻",
            "text": "嘿嘿！那是当然了，我可是万民堂的常客！",
            "nextDialogs": [
              "715310110"
            ]
          },
          "715310110": {
            "id": "715310110",
            "speakerId": 30458,
            "speakerName": "文寻",
            "text": "只要不出门旅行，我一周至少去万民堂吃七顿！",
            "nextDialogs": [
              "715310111"
            ]
          },
          "715310111": {
            "id": "715310111",
            "speakerId": 30458,
            "speakerName": "文寻",
            "text": "搭配我家常吃的菜式，一餐清淡，一餐香辣，好不爽快！",
            "nextDialogs": [
              "715310112"
            ]
          },
          "715310112": {
            "id": "715310112",
            "speakerId": 30458,
            "speakerName": "文寻",
            "text": "就算上火了，抓几味清火的药材，好好调理两天，就能继续大吃特吃了。"
          }
        }
      }
    }
  ]
}
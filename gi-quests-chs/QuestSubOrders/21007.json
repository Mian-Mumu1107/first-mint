        ],
        "dialogs": {
          "210070701": {
            "id": "210070701",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "孤木孑立，无林可依…",
            "nextDialogs": [
              "210070702"
            ]
          },
          "210070702": {
            "id": "210070702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您好。",
            "nextDialogs": [
              "210070703"
            ]
          },
          "210070703": {
            "id": "210070703",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "红叶萋萋，无风自离…",
            "nextDialogs": [
              "210070704"
            ]
          },
          "210070704": {
            "id": "210070704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您好！！",
            "nextDialogs": [
              "210070705"
            ]
          },
          "210070705": {
            "id": "210070705",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "红叶簌簌，乘风散去…",
            "nextDialogs": [
              "210070706"
            ]
          },
          "210070706": {
            "id": "210070706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他怎么不回答我们呀…",
            "nextDialogs": [
              "210070707"
            ]
          },
          "210070707": {
            "id": "210070707",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "什么金银财帛…都是个笑话，都是个笑话…",
            "nextDialogs": [
              "210070708"
            ]
          },
          "210070708": {
            "id": "210070708",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "这镇子…离得越远越好…",
            "nextDialogs": [
              "210070709"
            ]
          },
          "210070709": {
            "id": "210070709",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "只要从头来过，只要从头来过…"
          }
        }
      }
    },

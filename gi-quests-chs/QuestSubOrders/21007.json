  "subQuests": [
    {
      "subId": "2100701",
      "subQuestName": "搜索明蕴镇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210070101"
        ],
        "dialogs": {
          "210070101": {
            "id": "210070101",
            "speakerId": 1000,
            "speakerName": "遗训",
            "text": "「…孤木孑立，无林可依…坚石存金，同心共取…富贵晓明，笃念祖训…」"
          }
        }
      }
    },
    {
      "subId": "2100702",
      "subQuestName": "搜寻「祖训」$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210070201"
        ],
        "dialogs": {
          "210070201": {
            "id": "210070201",
            "speakerId": 20070,
            "speakerName": "元青",
            "text": "可恶！可恶！我到底是造了什么孽…",
            "nextDialogs": [
              "210070202"
            ]
          },
          "210070202": {
            "id": "210070202",
            "speakerId": 20070,
            "speakerName": "元青",
            "text": "好不容易趁他们没反应过来，抢先跑过来矿洞里拿宝贝，怎么这么多怪物…",
            "nextDialogs": [
              "210070203"
            ]
          },
          "210070203": {
            "id": "210070203",
            "speakerId": 20070,
            "speakerName": "元青",
            "text": "可恶，可恶…"
          }
        }
      }
    },
    {
      "subId": "2100703",
      "subQuestName": "搜寻「祖训」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210070301"
        ],
        "dialogs": {
          "210070301": {
            "id": "210070301",
            "speakerId": 20072,
            "speakerName": "元成",
            "text": "什么兄弟，大哥们只会把好东西自己先拿到手！",
            "nextDialogs": [
              "210070302"
            ]
          },
          "210070302": {
            "id": "210070302",
            "speakerId": 20072,
            "speakerName": "元成",
            "text": "老头子也是一副老糊涂的样子，睁一只眼闭一只眼…",
            "nextDialogs": [
              "210070303"
            ]
          },
          "210070303": {
            "id": "210070303",
            "speakerId": 20072,
            "speakerName": "元成",
            "text": "他们应该还不知道，宝贝在矿洞里。",
            "nextDialogs": [
              "210070304"
            ]
          },
          "210070304": {
            "id": "210070304",
            "speakerId": 20072,
            "speakerName": "元成",
            "text": "必须要快点去拿宝贝，然后就走…走得远远的…"
          }
        }
      }
    },
    {
      "subId": "2100704",
      "subQuestName": "搜寻「祖训」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210070401"
        ],
        "dialogs": {
          "210070401": {
            "id": "210070401",
            "speakerId": 20071,
            "speakerName": "元良",
            "text": "嘿嘿…这下宝贝都是我的了…",
            "nextDialogs": [
              "210070402"
            ]
          },
          "210070402": {
            "id": "210070402",
            "speakerId": 20071,
            "speakerName": "元良",
            "text": "大哥和小弟可真是傻子，抓了两句就跑，嘿嘿嘿…",
            "nextDialogs": [
              "210070403"
            ]
          },
          "210070403": {
            "id": "210070403",
            "speakerId": 20071,
            "speakerName": "元良",
            "text": "什么祖训，有用的就一句，宝贝就在矿洞里，嘿嘿嘿，这下子宝贝全都是我的了…"
          }
        }
      }
    },
    {
      "subId": "2100705",
      "subQuestName": "搜寻「祖训」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210070501"
        ],
        "dialogs": {
          "210070501": {
            "id": "210070501",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "走啦…都走啦…",
            "nextDialogs": [
              "210070502"
            ]
          },
          "210070502": {
            "id": "210070502",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "元青，元良…还有元成，傻孩子们，你们再好好看看，再好好想想啊…"
          }
        }
      }
    },
    {
      "subId": "2100706",
      "subQuestName": "搜寻「祖训」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210070601"
        ],
        "dialogs": {
          "210070601": {
            "id": "210070601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…是，是之前的那些人…",
            "nextDialogs": [
              "210070602"
            ]
          },
          "210070602": {
            "id": "210070602",
            "speakerId": 20070,
            "speakerName": "元青",
            "text": "孤木孑立，无林可依…哈哈，一个人，果然是什么都做不到…",
            "nextDialogs": [
              "210070603"
            ]
          },
          "210070603": {
            "id": "210070603",
            "speakerId": 20072,
            "speakerName": "元成",
            "text": "红叶萋萋，无风自离…如果我能相信大哥和老头子的话…",
            "nextDialogs": [
              "210070604"
            ]
          },
          "210070604": {
            "id": "210070604",
            "speakerId": 20071,
            "speakerName": "元良",
            "text": "红叶簌簌，乘风散去…宝贝，宝贝…为了宝贝，什么都没了…",
            "nextDialogs": [
              "210070605"
            ]
          },
          "210070605": {
            "id": "210070605",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "盘木森森，荫蔽家庭…孩子们，我们都是一家人呐。",
            "nextDialogs": [
              "210070606"
            ]
          },
          "210070606": {
            "id": "210070606",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "你们都觉得，我把宝贝藏在了矿洞里…",
            "nextDialogs": [
              "210070607"
            ]
          },
          "210070607": {
            "id": "210070607",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "但是，我哪里有什么宝贝…你们还记得这棵树吗，这是你们小时候，我们全家一起栽的…",
            "nextDialogs": [
              "210070608"
            ]
          },
          "210070608": {
            "id": "210070608",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "我每年都会过来，在这里面埋点东西，希望你们长大之后，我们全家再一起去挖出来。",
            "nextDialogs": [
              "210070609"
            ]
          },
          "210070609": {
            "id": "210070609",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "到时候，我们就用这里面的东西去买点好吃的，买点小酒，全家在一起，聊聊过去的小事…",
            "nextDialogs": [
              "210070610"
            ]
          },
          "210070610": {
            "id": "210070610",
            "speakerId": 20069,
            "speakerName": "元鸿",
            "text": "孩子们哪，孩子们哪…"
          }
        }
      }
    },

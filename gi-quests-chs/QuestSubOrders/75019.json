        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7501903",
      "subQuestName": "与曼科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750190301"
        ],
        "dialogs": {
          "750190301": {
            "id": "750190301",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "…这件事没有商讨的余地吗？",
            "nextDialogs": [
              "750190302"
            ]
          },
          "750190302": {
            "id": "750190302",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "我说，曼科老兄啊，你没有听蒂图兄弟说过吗，这事情已经快五百多年没人干过啦。",
            "nextDialogs": [
              "750190303"
            ]
          },
          "750190303": {
            "id": "750190303",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "就算你说，找到了可能的入口…",
            "nextDialogs": [
              "750190304"
            ]
          },
          "750190304": {
            "id": "750190304",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "那又如何，历史中，踏上这条路的人和他们的伙伴，全都没有回来，听好了，是「一个」都没有。",
            "nextDialogs": [
              "750190305"
            ]
          },
          "750190305": {
            "id": "750190305",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "呃，恕我直言…",
            "nextDialogs": [
              "750190306"
            ]
          },
          "750190306": {
            "id": "750190306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个龙遗物研究协会的家伙在那里，旁边的那一位，好像是「回声之子」的首领？",
            "nextDialogs": [
              "750190307"
            ]
          },
          "750190307": {
            "id": "750190307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂…龙遗物研究协会的！",
            "nextDialogs": [
              "750190308"
            ]
          },
          "750190308": {
            "id": "750190308",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "#是{NICKNAME}…派蒙，还有{REALNAME[ID(2)|SHOWHOST(true)]}。",
            "nextDialogs": [
              "750190309"
            ]
          },
          "750190309": {
            "id": "750190309",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750190310"
            ]
          },
          "750190310": {
            "id": "750190310",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "喔哦，尾巴上绑红丝巾的小嵴锋龙！好有精神的小家伙，看上去就感觉不太一样呢，来，再来一下！",
            "nextDialogs": [
              "750190311"
            ]
          },
          "750190311": {
            "id": "750190311",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750190312"
            ]
          },
          "750190312": {
            "id": "750190312",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "#真不错，你就是{REALNAME[ID(2)|SHOWHOST(true)]}，那么，你们两个就是{REALNAME[ID(2)|SHOWHOST(true)]}选择的勇者了吧…",
            "nextDialogs": [
              "750190313"
            ]
          },
          "750190313": {
            "id": "750190313",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "#{NICKNAME}和派蒙，你们的名字最近出现的很频繁啊…不仅曼科老兄一直在念叨，蒂图那家伙回部族的时候也提到过。",
            "nextDialogs": [
              "750190314"
            ]
          },
          "750190314": {
            "id": "750190314",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "你们的最近的事迹，都已经可以算是「传说故事」啦，而且，回声之子的小家伙们也受到你很多的照顾。",
            "nextDialogs": [
              "750190317"
            ]
          },
          "750190317": {
            "id": "750190317",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "哈哈，了不起的年轻人。",
            "nextDialogs": [
              "750190318"
            ]
          },
          "750190318": {
            "id": "750190318",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "曼科老兄，为了验证你的想法，就要把他们推进火坑，这可不是回声之子的待客之道。",
            "nextDialogs": [
              "750190319"
            ]
          },
          "750190319": {
            "id": "750190319",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "至少这不是「我的」待客之道，我可干不出这样的事。",
            "nextDialogs": [
              "750190320"
            ]
          },
          "750190320": {
            "id": "750190320",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "唉…",
            "nextDialogs": [
              "750190321"
            ]
          },
          "750190321": {
            "id": "750190321",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们在说什么啊，什么危险啊，火坑的？",
            "nextDialogs": [
              "750190322"
            ]
          },
          "750190322": {
            "id": "750190322",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "抱歉，这就请让我来进行说明吧…",
            "nextDialogs": [
              "750190323"
            ]
          },
          "750190323": {
            "id": "750190323",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "还记得之前说的吗，为了解除「焰主之祝」的标记，需要带着必须的两种信物前往火山。",
            "nextDialogs": [
              "750190324"
            ]
          },
          "750190324": {
            "id": "750190324",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "其中一个信物就在回声之子外的遗迹…",
            "nextDialogs": [
              "750190325"
            ]
          },
          "750190325": {
            "id": "750190325",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "只不过想要进入那里也有条件。",
            "nextDialogs": [
              "750190326"
            ]
          },
          "750190326": {
            "id": "750190326",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "根据过往的惯例…当然了，这个惯例还是我刚刚翻织物找到的，毕竟很长时间没有人还想做这样的事。",
            "nextDialogs": [
              "750190327"
            ]
          },
          "750190327": {
            "id": "750190327",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "（test）弄得我头发上全是灰尘，走在路上的时候还被搭话，「老大，你今天怎么看上去还老了十岁…」，咳咳，这个不说了…（废弃）",
            "nextDialogs": [
              "750190328"
            ]
          },
          "750190328": {
            "id": "750190328",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "如果想要带自己的龙伙伴前往火山，进行洗礼，洗去「焰主之祝」，就得从各自部族首领那里取得认可…",
            "nextDialogs": [
              "750190329"
            ]
          },
          "750190329": {
            "id": "750190329",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "(test)方能踏上取得信物之一的朝圣之道。（废弃）",
            "nextDialogs": [
              "750190330"
            ]
          },
          "750190330": {
            "id": "750190330",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "(test)嗯？（废弃）",
            "nextDialogs": [
              "750190331"
            ]
          },
          "750190331": {
            "id": "750190331",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "(test)欸，什么叫从各自部族首领那里取得证明啊…（废弃）",
            "nextDialogs": [
              "750190332"
            ]
          },
          "750190332": {
            "id": "750190332",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}是只小嵴锋龙，所以就要取得「回声之子」首领的承认。",
            "nextDialogs": [
              "750190333"
            ]
          },
          "750190333": {
            "id": "750190333",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#(test)原来是这样，我们家的{REALNAME[ID(2)|SHOWHOST(true)]}是只小嵴锋龙，所以就要取得「回声之子」首领的认可…（废弃）",
            "nextDialogs": [
              "750190334"
            ]
          },
          "750190334": {
            "id": "750190334",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750190335"
            ]
          },
          "750190335": {
            "id": "750190335",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那不就是帕加尔先生的认可嘛。",
            "nextDialogs": [
              "750190336"
            ]
          },
          "750190336": {
            "id": "750190336",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "#是啊，不过说实话，这个规矩到底能不能对不是部族人的异邦人有效，我也不知道…但是，{NICKNAME}…",
            "nextDialogs": [
              "750190337"
            ]
          },
          "750190337": {
            "id": "750190337",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "这几百年内，为了让自己的龙伙伴从这个血脉中的…比起祝福更像是诅咒一样的东西逃脱的勇士有很多。",
            "nextDialogs": [
              "750190338"
            ]
          },
          "750190338": {
            "id": "750190338",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "但是没有一个人成功…这也是后来部族里逐渐荒弃了这一传统的缘由…",
            "nextDialogs": [
              "750190339"
            ]
          },
          "750190339": {
            "id": "750190339",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，居然没有一个人能成功吗？",
            "nextDialogs": [
              "750190340"
            ]
          },
          "750190340": {
            "id": "750190340",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "对，就是这么危险的事，而且，据说在取得信物前的试炼里，不仅是决定前往的勇士，就连龙伙伴本身都会受到考验…",
            "nextDialogs": [
              "750190341"
            ]
          },
          "750190341": {
            "id": "750190341",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "虽然你们并不是部族人，但我还是不希望你们白白送死。",
            "nextDialogs": [
              "750190342"
            ]
          },
          "750190342": {
            "id": "750190342",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "#所以，{NICKNAME}，我还是提议，把{REALNAME[ID(2)|SHOWHOST(true)]}留在回声之子吧。",
            "nextDialogs": [
              "750190343"
            ]
          },
          "750190343": {
            "id": "750190343",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "至少我可以保证，在它进入夜神的国度之前，我会好好照顾好它。",
            "nextDialogs": [
              "750190344"
            ]
          },
          "750190344": {
            "id": "750190344",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是，可是这样的话…",
            "nextDialogs": [
              "750190345"
            ]
          },
          "750190345": {
            "id": "750190345",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "#…就像我之前说的，{REALNAME[ID(2)|SHOWHOST(true)]}就没法长大了。",
            "nextDialogs": [
              "750190346"
            ]
          },
          "750190346": {
            "id": "750190346",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜…",
            "nextDialogs": [
              "750190347"
            ]
          },
          "750190347": {
            "id": "750190347",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来它不是很希望这样呢…",
            "nextDialogs": [
              "750190348"
            ]
          },
          "750190348": {
            "id": "750190348",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我想试试看。",
            "nextDialogs": [
              "750190349"
            ]
          },
          "750190349": {
            "id": "750190349",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "即使很危险，也想要试试看吗？",
            "nextDialogs": [
              "750190350"
            ]
          },
          "750190350": {
            "id": "750190350",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯。",
            "nextDialogs": [
              "750190351"
            ]
          },
          "750190351": {
            "id": "750190351",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "小家伙，你呢？",
            "nextDialogs": [
              "750190352"
            ]
          },
          "750190352": {
            "id": "750190352",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750190353"
            ]
          },
          "750190353": {
            "id": "750190353",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "哈哈哈，真好，无比坚定的眼神，坚硬，却能够感受到内心的火热，真是犹如燃素岩一般的好家伙们。",
            "nextDialogs": [
              "750190354"
            ]
          },
          "750190354": {
            "id": "750190354",
            "speakerId": 6092,
            "speakerName": "帕加尔",
            "text": "好啊，那我就承认你们有前往火山朝圣的资格吧！",
            "nextDialogs": [
              "750190355"
            ]
          },
          "750190355": {
            "id": "750190355",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750190356"
            ]
          },
          "750190356": {
            "id": "750190356",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶，现在我们是不是就可以去找第一个信物了。",
            "nextDialogs": [
              "750190357"
            ]
          },
          "750190357": {
            "id": "750190357",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "不，还不行。既然已经取得资格，就要进行见证人的试炼…",
            "nextDialogs": [
              "750190358"
            ]
          },
          "750190358": {
            "id": "750190358",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "按照古老的传统，勇者与龙，必须一起取得树林深处绿咬鹃的羽毛，献上一打兽皮…",
            "nextDialogs": [
              "750190359"
            ]
          },
          "750190359": {
            "id": "750190359",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "必须一同为部族赢得五十场对外战斗的胜利，献上九十六颗品质上等的宝石…"
          }
        }
      }
    },
    {
      "subId": "7501905",
      "subQuestName": "前往决斗场地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7501906",
      "subQuestName": "击败帕加尔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750190601"
        ],
        "dialogs": {
          "750190601": {
            "id": "750190601",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "#恕我直言…虽然我明白{NICKNAME}的实力，但是还请注意。",
            "nextDialogs": [
              "750190602"
            ]
          },
          "750190602": {
            "id": "750190602",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "虽然没能够获得「古名」，不过帕加尔的实力也是不容小觑的…如果他这几年没有荒废锻炼的话。",
            "nextDialogs": [
              "750190603"
            ]
          },
          "750190603": {
            "id": "750190603",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "如果准备好与他的战斗的话，那就开始吧。"
          }
        }
      }
    },
    {
      "subId": "7501908",
      "subQuestName": "挑战帕加尔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750190801"
        ],
        "dialogs": {
          "750190801": {
            "id": "750190801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准备好了！",
            "nextDialogs": [
              "750190802"
            ]
          },
          "750190802": {
            "id": "750190802",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "那么，请稍等，战斗即将开始。"
          }
        }
      }
    },
    {
      "subId": "7501907",
      "subQuestName": "与曼科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750190701"
        ],
        "dialogs": {
          "750190701": {
            "id": "750190701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "赢了，好耶！了不起！",
            "nextDialogs": [
              "750190702"
            ]
          },
          "750190702": {
            "id": "750190702",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750190703"
            ]
          },
          "750190703": {
            "id": "750190703",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "哈…即使是现在部族里最强的战士，恐怕也打不赢你吧…这次还真是输得心服口服。",
            "nextDialogs": [
              "750190704"
            ]
          },
          "750190704": {
            "id": "750190704",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "被一只小家伙打败的感觉怎么样，老兄，看来我们还要多多锻炼啊。",
            "nextDialogs": [
              "750190705"
            ]
          },
          "750190705": {
            "id": "750190705",
            "speakerId": 21620,
            "speakerName": "乌丘",
            "text": "呼呼…",
            "nextDialogs": [
              "750190706"
            ]
          },
          "750190706": {
            "id": "750190706",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "真是见证了一场精彩的决斗…",
            "nextDialogs": [
              "750190707"
            ]
          },
          "750190707": {
            "id": "750190707",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "曼科老兄啊，你这家伙总是在旁边说这种漂亮话，很没意思的。怎么样，要不要你也下来打一场。",
            "nextDialogs": [
              "750190708"
            ]
          },
          "750190708": {
            "id": "750190708",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "不，我就对此敬谢不敏了。",
            "nextDialogs": [
              "750190709"
            ]
          },
          "750190709": {
            "id": "750190709",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "#嗐。无聊的家伙。啊，真是一场爽快的战斗，你…{NICKNAME}，你的实力不是盖的。",
            "nextDialogs": [
              "750190711",
              "750190713"
            ]
          },
          "750190711": {
            "id": "750190711",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "哈哈哈，真是嚣张的家伙，不过，我很欣赏这种态度。强者就应该飞扬跋扈一点，不然变强又有什么意义。",
            "nextDialogs": [
              "750190714"
            ]
          },
          "750190714": {
            "id": "750190714",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750190715"
            ]
          },
          "750190715": {
            "id": "750190715",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "#哈哈，{REALNAME[ID(2)|SHOWHOST(true)]}，看得出来你有被他们好好照顾着呢…",
            "nextDialogs": [
              "750190716"
            ]
          },
          "750190716": {
            "id": "750190716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#那是当然了，{REALNAME[ID(2)|SHOWHOST(true)]}可是我们的了不起的伙伴！",
            "nextDialogs": [
              "750190717"
            ]
          },
          "750190717": {
            "id": "750190717",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "既然如此，我就放心了。",
            "nextDialogs": [
              "750190718"
            ]
          },
          "750190718": {
            "id": "750190718",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "好了，说好的，部族首领的证明你们就拿去吧，就是这个。",
            "nextDialogs": [
              "750190719"
            ]
          },
          "750190719": {
            "id": "750190719",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "学名叫什么来着，曼科老兄，这可是你该发言的时候了…",
            "nextDialogs": [
              "750190720"
            ]
          },
          "750190720": {
            "id": "750190720",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "瓦萨克拉胡巴肯的护符…「盗火贤者」的护符。",
            "nextDialogs": [
              "750190721"
            ]
          },
          "750190721": {
            "id": "750190721",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "嗯，这个名字我始终记不住，不过我记得，是在火龙王死去，而最初的火之神从烈焰中苏生之后…",
            "nextDialogs": [
              "750190722"
            ]
          },
          "750190722": {
            "id": "750190722",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "「盗火贤者」与最初的火神，各自从火山中带走了一枚信物。取得两枚信物之人，就能进入火山内的净火，除却一切诅咒与灾厄。",
            "nextDialogs": [
              "750190723"
            ]
          },
          "750190723": {
            "id": "750190723",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "不过，这个「盗火贤者」到底活了多久啊，曼科老兄，感觉从「部落」时代到奥奇卡纳塔那会儿…",
            "nextDialogs": [
              "750190724"
            ]
          },
          "750190724": {
            "id": "750190724",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "就连「缝影针」那里都有他的传说。",
            "nextDialogs": [
              "750190725"
            ]
          },
          "750190725": {
            "id": "750190725",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "毕竟是第一个会使用燃素的人类…出现在传说中的人物，不管变成什么样都有可能吧。",
            "nextDialogs": [
              "750190726"
            ]
          },
          "750190726": {
            "id": "750190726",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "有人说他已经把身体与灵魂都燃素化了，和纳塔的风、大地与花融为了一体，能够倾听部族人向他祈求帮助的声音。",
            "nextDialogs": [
              "750190727"
            ]
          },
          "750190727": {
            "id": "750190727",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "也有人说，其实每个时代都有不同的人继承「盗火贤者」之名，一代一代，甚至传言今日也依然有「盗火贤者」的传承者。",
            "nextDialogs": [
              "750190728"
            ]
          },
          "750190728": {
            "id": "750190728",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "不过，恕我直言…其中大部分都是叙事人的臆测罢了。",
            "nextDialogs": [
              "750190729"
            ]
          },
          "750190729": {
            "id": "750190729",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "哈哈，听到你这么说，蒂图兄弟又得生气了。",
            "nextDialogs": [
              "750190730"
            ]
          },
          "750190730": {
            "id": "750190730",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "好了，我该做的已经做完了…哦不对，按照传统和惯例还得有这样的一件事…",
            "nextDialogs": [
              "750190731"
            ]
          },
          "750190731": {
            "id": "750190731",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "那就是为踏上旅程的勇者，和他的伙伴献上祝福。",
            "nextDialogs": [
              "750190732"
            ]
          },
          "750190732": {
            "id": "750190732",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯？",
            "nextDialogs": [
              "750190733"
            ]
          },
          "750190733": {
            "id": "750190733",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦，居然还有这样的仪式吗？",
            "nextDialogs": [
              "750190734"
            ]
          },
          "750190734": {
            "id": "750190734",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "其实就是一些便宜讨彩头的话。",
            "nextDialogs": [
              "750190735"
            ]
          },
          "750190735": {
            "id": "750190735",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "#那么，{NICKNAME}和{REALNAME[ID(2)|SHOWHOST(true)]}…",
            "nextDialogs": [
              "750190736"
            ]
          },
          "750190736": {
            "id": "750190736",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，我在这里。",
            "nextDialogs": [
              "750190737"
            ]
          },
          "750190737": {
            "id": "750190737",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750190738"
            ]
          },
          "750190738": {
            "id": "750190738",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "祝你们能够像翎翅最硬的鸟儿那样飞过一切山巅；\\n祝你们能够像最坚强的顽石那样抵挡恶浪的奔流。",
            "nextDialogs": [
              "750190739"
            ]
          },
          "750190739": {
            "id": "750190739",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "祝你们不畏艰险，因为世上注定有诸多艰险。\\n祝你们不忘彼此，因为命运之中终有离别。",
            "nextDialogs": [
              "750190740"
            ]
          },
          "750190740": {
            "id": "750190740",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "祝你们能到达想要到达之处，能够得偿所愿…然后，最重要的一点，也是我最希望的一点，祝你们能够平安归来。",
            "nextDialogs": [
              "750190741"
            ]
          },
          "750190741": {
            "id": "750190741",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会的。",
            "nextDialogs": [
              "750190742"
            ]
          },
          "750190742": {
            "id": "750190742",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750190743"
            ]
          },
          "750190743": {
            "id": "750190743",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，那我呢，我就没有祝福吗？",
            "nextDialogs": [
              "750190744"
            ]
          },
          "750190744": {
            "id": "750190744",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "对哦，小派蒙…那就祝小派蒙吃好喝好，睡觉饱饱，健康长大吧！"
          },
          "750190713": {
            "id": "750190713",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "这种可怜人的夸奖就免了吧，不过要是我再年轻一点…谁胜谁负还不知道呢，真可惜，如果年轻时能和你打一场就好了。"
          }
        }
      }
    },
    {
      "subId": "7501901",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750190103"
        ],
        "dialogs": {
          "750190103": {
            "id": "750190103",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "嗯，既然已经得到了证明，那就可以去取得「盗火贤者」留下的信物了。",
            "nextDialogs": [
              "750190104"
            ]
          },
          "750190104": {
            "id": "750190104",
            "speakerId": 21481,
            "speakerName": "曼科",
            "text": "那座遗迹入口离这里不远，恕我冒昧，请前往回声之子外的遗迹…",
            "nextDialogs": [
              "750190105"
            ]
          },
          "750190105": {
            "id": "750190105",
            "speakerId": 14731,
            "speakerName": "帕加尔",
            "text": "这样的实力，就想前往火山，实在是有点勉强了啊。"
          }
        }
      }
    }
  ]
}
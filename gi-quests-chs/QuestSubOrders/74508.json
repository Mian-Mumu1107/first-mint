  "subQuests": [
    {
      "subId": "7450801",
      "subQuestName": "与摊位旁的两人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745080101"
        ],
        "dialogs": {
          "745080101": {
            "id": "745080101",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "一段时间后，你与派蒙来到了「小小灵蕈大幻戏」的摊位前…",
            "nextDialogs": [
              "745080102"
            ]
          },
          "745080102": {
            "id": "745080102",
            "speakerId": 1001,
            "speakerName": "昂吉安妮",
            "text": "哼哼！滑滑弹弹软软嫩嫩的蕈兽真是太棒了！我还要继续玩这个游戏！",
            "nextDialogs": [
              "745080103"
            ]
          },
          "745080103": {
            "id": "745080103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这位是？",
            "nextDialogs": [
              "745080104"
            ]
          },
          "745080104": {
            "id": "745080104",
            "speakerId": 1001,
            "speakerName": "昂吉安妮",
            "text": "本小姐是昂吉安妮，蒂蕾娜进入特巡队之前的教官！",
            "nextDialogs": [
              "745080105"
            ]
          },
          "745080105": {
            "id": "745080105",
            "speakerId": 1001,
            "speakerName": "昂吉安妮",
            "text": "我和蒂蕾娜不一样，不一样哦！不会因为你们是「超天顶领队级战力」就对你们畏畏缩缩！",
            "nextDialogs": [
              "745080106"
            ]
          },
          "745080106": {
            "id": "745080106",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这个很嚣张的美露莘…居然是蒂蕾娜以前的教官？",
            "nextDialogs": [
              "745080107"
            ]
          },
          "745080107": {
            "id": "745080107",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "别紧张，「黄金流星」和「白银伴星」。",
            "nextDialogs": [
              "745080108"
            ]
          },
          "745080108": {
            "id": "745080108",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "不久前，蒂蕾娜小姐接到了别的任务，回到特巡队的驻地去了。",
            "nextDialogs": [
              "745080109"
            ]
          },
          "745080109": {
            "id": "745080109",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "昂吉安妮小姐是蒂蕾娜小姐请来，代替她负责活动场地安保的专业人士。",
            "nextDialogs": [
              "745080110"
            ]
          },
          "745080110": {
            "id": "745080110",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "她也非常喜欢「小小灵蕈大幻戏」，和我玩得很开心。",
            "nextDialogs": [
              "745080111"
            ]
          },
          "745080111": {
            "id": "745080111",
            "speakerId": 1001,
            "speakerName": "昂吉安妮",
            "text": "没错，无论是桌上的游戏，还是现实里圆圆的蕈兽！",
            "nextDialogs": [
              "745080112"
            ]
          },
          "745080112": {
            "id": "745080112",
            "speakerId": 1001,
            "speakerName": "昂吉安妮",
            "text": "滑滑弹弹软软嫩嫩，就像汐藻一样…嘿嘿嘿…",
            "nextDialogs": [
              "745080115"
            ]
          },
          "745080115": {
            "id": "745080115",
            "speakerId": 1001,
            "speakerName": "昂吉安妮",
            "text": "才不会吃！抱着蹭一下也没关系吧！海妮耶都不介意我捏捏「欢腾之火」呢！",
            "nextDialogs": [
              "745080116"
            ]
          },
          "745080116": {
            "id": "745080116",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#那，那你也只能捏捏「欢腾之火」！「咚咚小圆帽」只有我和{NICKNAME}才能抱！",
            "nextDialogs": [
              "745080117"
            ]
          },
          "745080117": {
            "id": "745080117",
            "speakerId": 1001,
            "speakerName": "昂吉安妮",
            "text": "干嘛这么小气！我全都要！",
            "nextDialogs": [
              "745080118"
            ]
          },
          "745080118": {
            "id": "745080118",
            "speakerId": 1001,
            "speakerName": "昂吉安妮",
            "text": "海妮耶说过，你们是这个游戏的专家，那不如就和我比划比划？",
            "nextDialogs": [
              "745080119"
            ]
          },
          "745080119": {
            "id": "745080119",
            "speakerId": 1001,
            "speakerName": "昂吉安妮",
            "text": "如果我赢了，我也要揉捏「咚咚小圆帽」！",
            "nextDialogs": [
              "745080120"
            ]
          },
          "745080120": {
            "id": "745080120",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "可恶，被她瞧不起了！",
            "nextDialogs": [
              "745080121"
            ]
          },
          "745080121": {
            "id": "745080121",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们上吧，让她见识一下「小小灵蕈大幻戏」的第一代玩家的力量！"
          }
        }
      }
    },

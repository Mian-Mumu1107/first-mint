    {
      "subId": "7613106",
      "subQuestName": "激活终端",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761310601"
        ],
        "dialogs": {
          "761310601": {
            "id": "761310601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太好了！这里又有一个终端！",
            "nextDialogs": [
              "761310602"
            ]
          },
          "761310602": {
            "id": "761310602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "轮到你表现了，黑蛋！",
            "nextDialogs": [
              "761310603"
            ]
          },
          "761310603": {
            "id": "761310603",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "终端已激活，正在申请获得基地数据。",
            "nextDialogs": [
              "761310604"
            ]
          },
          "761310604": {
            "id": "761310604",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "基地数据已获得。",
            "nextDialogs": [
              "761310605"
            ]
          },
          "761310605": {
            "id": "761310605",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "开始检索「望月者计划」…无内容。",
            "nextDialogs": [
              "761310606"
            ]
          },
          "761310606": {
            "id": "761310606",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "开始检索「卢沙里姆」…有了！",
            "nextDialogs": [
              "761310607"
            ]
          },
          "761310607": {
            "id": "761310607",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "我在基地内部找到了一个卢沙里姆的研究室。",
            "nextDialogs": [
              "761310608"
            ]
          },
          "761310608": {
            "id": "761310608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦？果然有收获，我们快去那里看看！",
            "nextDialogs": [
              "761310609"
            ]
          },
          "761310609": {
            "id": "761310609",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "正在读取基地工程蓝图与路线，嗯…向前进就能抵达。",
            "nextDialogs": [
              "761310610"
            ]
          },
          "761310610": {
            "id": "761310610",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有什么其他情报吗？",
            "nextDialogs": [
              "761310611"
            ]
          },
          "761310611": {
            "id": "761310611",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "开始检索其他信息…嗯？「从星海间返回的漆黑之王」？",
            "nextDialogs": [
              "761310612"
            ]
          },
          "761310612": {
            "id": "761310612",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是什么？",
            "nextDialogs": [
              "761310613"
            ]
          },
          "761310613": {
            "id": "761310613",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "信息显示，这座基地的存在…源自那位「漆黑之王」的意志。",
            "nextDialogs": [
              "761310614"
            ]
          },
          "761310614": {
            "id": "761310614",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "它的建成时间，也比我们之前见过的设施要晚许多。它的底部通向月心，那里被挖出了一道罅缝。",
            "nextDialogs": [
              "761310615"
            ]
          },
          "761310615": {
            "id": "761310615",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "源源不断的古月之力从月心罅缝涌出，成为了基地的能源。",
            "nextDialogs": [
              "761310616"
            ]
          },
          "761310616": {
            "id": "761310616",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "它的目的，是将月球打造成…天基武器！",
            "nextDialogs": [
              "761310617"
            ]
          },
          "761310617": {
            "id": "761310617",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "天、天基武器？那难道那位「漆黑之王」是…",
            "nextDialogs": [
              "761310618"
            ]
          },
          "761310618": {
            "id": "761310618",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "大概就是归来的龙王尼伯龙根。",
            "nextDialogs": [
              "761310619"
            ]
          },
          "761310619": {
            "id": "761310619",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是龙王回来了？！我们也太厉害了吧，这是闯到什么地方来了？",
            "nextDialogs": [
              "761310620"
            ]
          },
          "761310620": {
            "id": "761310620",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "天理来完龙王来，龙王来完我们来！",
            "nextDialogs": [
              "761310621"
            ]
          },
          "761310621": {
            "id": "761310621",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "向着星辰与深渊。",
            "nextDialogs": [
              "761310622"
            ]
          },
          "761310622": {
            "id": "761310622",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样说的话…前面的路我们得打起十二分警惕了。",
            "nextDialogs": [
              "761310623"
            ]
          },
          "761310623": {
            "id": "761310623",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哥伦比娅，万一有不对劲的事，你要保护好我们呀…咦？哥伦比娅？哥伦比娅呢？",
            "nextDialogs": [
              "761310624"
            ]
          },
          "761310624": {
            "id": "761310624",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}！哥伦比娅不见了！",
            "nextDialogs": [
              "761310625"
            ]
          },
          "761310625": {
            "id": "761310625",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…是什么时候？",
            "nextDialogs": [
              "761310626"
            ]
          },
          "761310626": {
            "id": "761310626",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完全没有感觉到…黑蛋，你看见哥伦比娅了吗？",
            "nextDialogs": [
              "761310627"
            ]
          },
          "761310627": {
            "id": "761310627",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "没有，我一直在读取终端里的信息…",
            "nextDialogs": [
              "761310628"
            ]
          },
          "761310628": {
            "id": "761310628",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "糟、糟糕了啊…保护我们的人居然不见了！有鬼啊！",
            "nextDialogs": [
              "761310629"
            ]
          },
          "761310629": {
            "id": "761310629",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（哥伦比娅绝对不会不告而别，一定有其他原因。）",
            "nextDialogs": [
              "761310630"
            ]
          },
          "761310630": {
            "id": "761310630",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（会和黑蛋有关吗？不，她一直在读取终端的信息。）",
            "nextDialogs": [
              "761310631"
            ]
          },
          "761310631": {
            "id": "761310631",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（那难道是…？）",
            "nextDialogs": [
              "761310632"
            ]
          },
          "761310632": {
            "id": "761310632",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "而且站在这里，那种奇怪的熟悉感更深了…",
            "nextDialogs": [
              "761310633"
            ]
          },
          "761310633": {
            "id": "761310633",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（看来哥伦比娅消失的原因和她所说的熟悉感有关，这座基地里到底有什么？）",
            "nextDialogs": [
              "761310634"
            ]
          },
          "761310634": {
            "id": "761310634",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们现在可怎么办呀？！",
            "nextDialogs": [
              "761310636",
              "761310638"
            ]
          },
          "761310636": {
            "id": "761310636",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "嗯，那里一定有关于这座基地的秘密，或许也能找到关于哥伦比娅消失的线索。",
            "nextDialogs": [
              "761310641"
            ]
          },
          "761310641": {
            "id": "761310641",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "但我们的路线要经过前方的警戒设施，不能触发基地的全面警报。",
            "nextDialogs": [
              "761310642"
            ]
          },
          "761310642": {
            "id": "761310642",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有没有办法关闭这些警戒设施？让我看看…"
          },
          "761310638": {
            "id": "761310638",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我知道你是想开个玩笑让我别害怕…嗯…我要鼓起勇气！",
            "nextDialogs": [
              "761310639"
            ]
          },
          "761310639": {
            "id": "761310639",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们要去找哥伦比娅，我们不会把她丢在这里的！",
            "nextDialogs": [
              "761310640"
            ]
          },
          "761310640": {
            "id": "761310640",
            "speakerId": 22261,
            "speakerName": "黑蛋",
            "text": "我们应该去卢沙里姆的研究室。那里一定有关于这座基地的秘密，或许也能找到关于哥伦比娅消失的线索。"
          }
        }
      }
    },
    {

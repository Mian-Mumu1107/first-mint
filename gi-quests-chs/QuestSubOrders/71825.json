        "dialogs": {
          "718150901": {
            "id": "718150901",
            "speakerId": 1000,
            "speakerName": "灯谜",
            "text": "「竹骨石肌一身轻，不听菱歌听衡经。」",
            "nextDialogs": [
              "718150902"
            ]
          },
          "718150902": {
            "id": "718150902",
            "speakerId": 1000,
            "speakerName": "灯谜",
            "text": "「莫道此生沉黑海，身中自有大光明。」",
            "nextDialogs": [
              "718150903"
            ]
          },
          "718150903": {
            "id": "718150903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这、这就是灯谜吗？好难…你有什么头绪吗？",
            "nextDialogs": [
              "718150904"
            ]
          },
          "718150904": {
            "id": "718150904",
            "speakerId": 1000,
            "speakerName": "灯谜",
            "text": "「竹骨石肌一身轻，不听菱歌听衡经。」",
            "nextDialogs": [
              "718150905"
            ]
          },
          "718150905": {
            "id": "718150905",
            "speakerId": 1000,
            "speakerName": "灯谜",
            "text": "「莫道此生沉黑海，身中自有大光明。」",
            "nextDialogs": [
              "718150909",
              "718150910"
            ]
          },
          "718150909": {
            "id": "718150909",
            "speakerId": 1002,
            "speakerName": "清昼",
            "text": "唔…猜得不对，还是再想想吧。"
          },
          "718150910": {
            "id": "718150910",
            "speakerId": 1002,
            "speakerName": "清昼",
            "text": "不错，正确的谜底就是这个。",
            "nextDialogs": [
              "718150911"
            ]
          },
          "718150911": {
            "id": "718150911",
            "speakerId": 1002,
            "speakerName": "清昼",
            "text": "霄灯正是竹骨石肌所做，放飞后浮空而行，这衡经说的也正是「玑衡经」，正是「不听菱歌听衡经」。",
            "nextDialogs": [
              "718150913"
            ]
          },
          "718150913": {
            "id": "718150913",
            "speakerId": 1002,
            "speakerName": "清昼",
            "text": "霄灯放飞后，虽然浮生石不坏，但灯罩本身会坏，坏掉的灯罩坠入海中后，就是「此生沉黑海」了。",
            "nextDialogs": [
              "718150914"
            ]
          },
          "718150914": {
            "id": "718150914",
            "speakerId": 1002,
            "speakerName": "清昼",
            "text": "但即便如此，寄托在霄灯上的愿望也不会消逝…这就是「身中自有大光明」。",
            "nextDialogs": [
              "718150915"
            ]
          },
          "718150915": {
            "id": "718150915",
            "speakerId": 1003,
            "speakerName": "小六",
            "text": "欸…是这么解的吗？完全想不到…",
            "nextDialogs": [
              "718150916"
            ]
          },
          "718150916": {
            "id": "718150916",
            "speakerId": 1003,
            "speakerName": "小六",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你好厉害，那…这个礼物给你！",
            "nextDialogs": [
              "718150917"
            ]
          },
          "718150917": {
            "id": "718150917",
            "speakerId": 1003,
            "speakerName": "小六",
            "text": "我听人家说，猜对了灯谜都要给「彩头」的…这个给你，就当做是「彩头」吧。"
          }
        }
      }
    }
  ]

  "subQuests": [
    {
      "subId": "4021601",
      "subQuestName": "前往查看测试平台",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766530501"
        ],
        "dialogs": {
          "766530501": {
            "id": "766530501",
            "speakerId": 1000,
            "speakerName": "爱诺",
            "text": "嗯…这个研究还要不要继续推进啊？",
            "nextDialogs": [
              "766530502"
            ]
          },
          "766530502": {
            "id": "766530502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这是什么？",
            "nextDialogs": [
              "766530503"
            ]
          },
          "766530503": {
            "id": "766530503",
            "speakerId": 1000,
            "speakerName": "爱诺",
            "text": "咻咻咻间谍1号！",
            "nextDialogs": [
              "766530504"
            ]
          },
          "766530504": {
            "id": "766530504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还是不太懂…",
            "nextDialogs": [
              "766530505"
            ]
          },
          "766530505": {
            "id": "766530505",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "确切来说，这里是咻咻咻间谍1号的测试平台，而咻咻咻间谍1号是爱诺最新设计的一种潜行机器人。",
            "nextDialogs": [
              "766530506"
            ]
          },
          "766530506": {
            "id": "766530506",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "她不久前从黑市收购了一台废弃的清理单元，将其改造后，就得到了现在的咻咻咻间谍1号。",
            "nextDialogs": [
              "766530507"
            ]
          },
          "766530507": {
            "id": "766530507",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "这个平台模拟了很多种危险的敌对环境，可以用来测试咻咻咻间谍1号的潜行能力。",
            "nextDialogs": [
              "766530508"
            ]
          },
          "766530508": {
            "id": "766530508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "爱诺为什么要设计一种潜行机器人？",
            "nextDialogs": [
              "766530509"
            ]
          },
          "766530509": {
            "id": "766530509",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "发现铛铛七分甜被偷走后，爱诺就下定决心，「无论对方背后有多么强大的势力也要把伙伴救回来」。",
            "nextDialogs": [
              "766530510"
            ]
          },
          "766530510": {
            "id": "766530510",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "然后她迅速完成了咻咻咻间谍1号的设计草案，并开始了研发。",
            "nextDialogs": [
              "766530511"
            ]
          },
          "766530511": {
            "id": "766530511",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "按照预期，一旦研发完成，就算是戒备森严的月矩力试验设计局，它也能轻松潜入进去并把伙伴救出来。",
            "nextDialogs": [
              "766530512"
            ]
          },
          "766530512": {
            "id": "766530512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听上去好厉害啊！",
            "nextDialogs": [
              "766530513"
            ]
          },
          "766530513": {
            "id": "766530513",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "可是爱诺很快就意识到完善方案需要很长时间，于是就又放弃了这个想法，她觉得还是直接掀翻整个挪德卡莱更快一些。",
            "nextDialogs": [
              "766530514"
            ]
          },
          "766530514": {
            "id": "766530514",
            "speakerId": 1000,
            "speakerName": "爱诺",
            "text": "我决定了！既然要冷静下来慢慢处理，那就继续推进咻咻咻间谍1号的开发，它肯定能为拯救同伴出力的！",
            "nextDialogs": [
              "766530515"
            ]
          },
          "766530515": {
            "id": "766530515",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "#既然如此，能不能请{NICKNAME}和派蒙也帮忙测试一下？",
            "nextDialogs": [
              "766530516"
            ]
          },
          "766530516": {
            "id": "766530516",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "根据以往的统计结果，如果有其他测试者提供的数据作为参考，爱诺的开发速度至少可以提升30%。",
            "nextDialogs": [
              "766530517"
            ]
          },
          "766530517": {
            "id": "766530517",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听上去很有趣，算我一个！",
            "nextDialogs": [
              "766530518"
            ]
          },
          "766530518": {
            "id": "766530518",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也算我一个。",
            "nextDialogs": [
              "766530519"
            ]
          },
          "766530519": {
            "id": "766530519",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "那我就代爱诺先谢过两位了。我会把权限开放给你们，之后想要进行测试的话直接使用这个平台就可以。"
          }
        }
      }
    }
  ]
}
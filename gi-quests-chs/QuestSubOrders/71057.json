    {
      "subId": "7105706",
      "subQuestName": "与老何对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710570201"
        ],
        "dialogs": {
          "710570201": {
            "id": "710570201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一下子就全部解决了？",
            "nextDialogs": [
              "710570202"
            ]
          },
          "710570202": {
            "id": "710570202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "老何…好强！",
            "nextDialogs": [
              "710570203"
            ]
          },
          "710570203": {
            "id": "710570203",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "嘿嘿嘿…蘑菇肉，蘑菇肉…",
            "nextDialogs": [
              "710570204"
            ]
          },
          "710570204": {
            "id": "710570204",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "自从吃了蘑菇肉，我腰也不疼了，手上也有劲了，嘿嘿嘿，感觉自己年轻了好几岁啊！",
            "nextDialogs": [
              "710570205"
            ]
          },
          "710570205": {
            "id": "710570205",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "蘑菇肉怪比蘑菇肉好吃，蘑菇肉，越大越好吃…嘿嘿嘿…",
            "nextDialogs": [
              "710570206"
            ]
          },
          "710570206": {
            "id": "710570206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道，老何是吃了这些蘑菇肉之后才变得那么厉害的吗？",
            "nextDialogs": [
              "710570207"
            ]
          },
          "710570207": {
            "id": "710570207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，只要吃就能变强，我们也吃几个吧！",
            "nextDialogs": [
              "710570209",
              "710570211"
            ]
          },
          "710570209": {
            "id": "710570209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我只是好奇是什么味道的嘛。",
            "nextDialogs": [
              "710570212"
            ]
          },
          "710570212": {
            "id": "710570212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过这下老何应该愿意跟我们一起回去了吧！",
            "nextDialogs": [
              "710570213"
            ]
          },
          "710570213": {
            "id": "710570213",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "蘑菇肉…嘿嘿，好吃！",
            "nextDialogs": [
              "710570214"
            ]
          },
          "710570214": {
            "id": "710570214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "老何！我们一起回营地吧！",
            "nextDialogs": [
              "710570215"
            ]
          },
          "710570215": {
            "id": "710570215",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "啊？一起？好啊，你们也来一起吃啊，这些蘑菇肉，嘿嘿嘿，风干之后可以吃很久…很久…",
            "nextDialogs": [
              "710570216"
            ]
          },
          "710570216": {
            "id": "710570216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是一起回营地啦！",
            "nextDialogs": [
              "710570217"
            ]
          },
          "710570217": {
            "id": "710570217",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "回阴地？阴地是什么地方，不过好呀…嘿嘿嘿…吃了蘑菇肉，我哪都能去。",
            "nextDialogs": [
              "710570218"
            ]
          },
          "710570218": {
            "id": "710570218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉…",
            "nextDialogs": [
              "710570219"
            ]
          },
          "710570219": {
            "id": "710570219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们还是快点把老何带回去见瑾武姐吧。"
          },
          "710570211": {
            "id": "710570211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我、我知道啦。"
          }
        }
      }
    },

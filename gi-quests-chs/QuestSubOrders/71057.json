  "subQuests": [
    {
      "subId": "7105701",
      "subQuestName": "阅读「工作手册」$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710570701"
        ],
        "dialogs": {
          "710570701": {
            "id": "710570701",
            "speakerId": 2159,
            "speakerName": "工作手册",
            "text": "（一本工作手册，封面上写着「老何」，大概是手册主人的名字。）",
            "nextDialogs": [
              "710570706"
            ]
          },
          "710570706": {
            "id": "710570706",
            "speakerId": 2159,
            "speakerName": "工作手册",
            "text": "（手册的前几页上写着：）",
            "nextDialogs": [
              "710570702"
            ]
          },
          "710570702": {
            "id": "710570702",
            "speakerId": 2159,
            "speakerName": "工作手册",
            "text": "「…戚定找那个以前送闺女的玩具找了半天，哪都没有，明天只能到矿深处帮他找找了…」",
            "nextDialogs": [
              "710570703"
            ]
          },
          "710570703": {
            "id": "710570703",
            "speakerId": 2159,
            "speakerName": "工作手册",
            "text": "「…耳朵好痒…」",
            "nextDialogs": [
              "710570704"
            ]
          },
          "710570704": {
            "id": "710570704",
            "speakerId": 2159,
            "speakerName": "工作手册",
            "text": "「…耳朵好痒，痒死了，痒死了，耳朵…真是烦啊，快没东西吃了，那个声音说…但是，这个蘑菇到底能不能吃……」",
            "nextDialogs": [
              "710570705"
            ]
          },
          "710570705": {
            "id": "710570705",
            "speakerId": 2159,
            "speakerName": "工作手册",
            "text": "后几页里写着：「…能听见，能听见，嘿嘿，蘑菇肉…嘿嘿嘿…蘑菇肉，好吃…嘿嘿嘿，蘑菇肉…」"
          }
        }
      }
    },
    {
      "subId": "7105702",
      "subQuestName": "与出现的老何对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710570133"
        ],
        "dialogs": {
          "710570133": {
            "id": "710570133",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "背后突然传来话语声：\\n「嘿嘿嘿…蘑菇肉…嘿嘿嘿…」",
            "nextDialogs": [
              "710570101"
            ]
          },
          "710570101": {
            "id": "710570101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你们，嘿嘿嘿，怎么会出现在这里呀？",
            "nextDialogs": [
              "710570102"
            ]
          },
          "710570102": {
            "id": "710570102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！这人的脸色好奇怪啊！",
            "nextDialogs": [
              "710570103"
            ]
          },
          "710570103": {
            "id": "710570103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#而且，{NICKNAME}，这个人从背后靠近的时候没发出一点声音…",
            "nextDialogs": [
              "710570104"
            ]
          },
          "710570104": {
            "id": "710570104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不会是…",
            "nextDialogs": [
              "710570105"
            ]
          },
          "710570105": {
            "id": "710570105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应该不是吧。",
            "nextDialogs": [
              "710570106"
            ]
          },
          "710570106": {
            "id": "710570106",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "嘿嘿嘿…你们怎么…在这里。",
            "nextDialogs": [
              "710570107"
            ]
          },
          "710570107": {
            "id": "710570107",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你们的吃的，也吃光了吗？",
            "nextDialogs": [
              "710570108"
            ]
          },
          "710570108": {
            "id": "710570108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道你就是老何？",
            "nextDialogs": [
              "710570109"
            ]
          },
          "710570109": {
            "id": "710570109",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "啊…什么呀？年轻人，你们说的啥呀，听不清。",
            "nextDialogs": [
              "710570110"
            ]
          },
          "710570110": {
            "id": "710570110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们在问！你是老何吗！",
            "nextDialogs": [
              "710570111"
            ]
          },
          "710570111": {
            "id": "710570111",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "哦哦，是啊，嘿嘿嘿，我就是老何。",
            "nextDialogs": [
              "710570112"
            ]
          },
          "710570112": {
            "id": "710570112",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "你们…不会是和我一样被困在下面，把吃的吃光了吧…欸呀，你的运气也不太好啊…",
            "nextDialogs": [
              "710570113"
            ]
          },
          "710570113": {
            "id": "710570113",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "嘿嘿嘿，不过没关系，我这里有吃的…饿了很久了吧…嘿嘿嘿…",
            "nextDialogs": [
              "710570114"
            ]
          },
          "710570114": {
            "id": "710570114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说来确实有点饿了。",
            "nextDialogs": [
              "710570117"
            ]
          },
          "710570117": {
            "id": "710570117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对、对哦，他看上去精神恍惚，脸色还…那么奇怪，不会就是因为吃蘑菇肉导致的吧！",
            "nextDialogs": [
              "710570118"
            ]
          },
          "710570118": {
            "id": "710570118",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "蘑菇肉？嘿嘿嘿，蘑菇肉可好吃了。",
            "nextDialogs": [
              "710570119"
            ]
          },
          "710570119": {
            "id": "710570119",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "来，老何给你们一些蘑菇肉…",
            "nextDialogs": [
              "710570120"
            ]
          },
          "710570120": {
            "id": "710570120",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "嘿嘿嘿蘑菇肉…咦，怎么…",
            "nextDialogs": [
              "710570121"
            ]
          },
          "710570121": {
            "id": "710570121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么了？",
            "nextDialogs": [
              "710570122"
            ]
          },
          "710570122": {
            "id": "710570122",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "蘑菇肉，没了！",
            "nextDialogs": [
              "710570123"
            ]
          },
          "710570123": {
            "id": "710570123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那就不要管什么蘑菇肉了，我们先一起回营地吧！",
            "nextDialogs": [
              "710570124"
            ]
          },
          "710570124": {
            "id": "710570124",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "不行，没有蘑菇肉了！",
            "nextDialogs": [
              "710570125"
            ]
          },
          "710570125": {
            "id": "710570125",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "没有蘑菇肉，就没力气走路，我哪也不去…没了蘑菇肉…这里其他地方都没有吃的。",
            "nextDialogs": [
              "710570126"
            ]
          },
          "710570126": {
            "id": "710570126",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "有了蘑菇肉，哪都能去！",
            "nextDialogs": [
              "710570127"
            ]
          },
          "710570127": {
            "id": "710570127",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那…哪里有这种蘑菇肉呢？",
            "nextDialogs": [
              "710570128"
            ]
          },
          "710570128": {
            "id": "710570128",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "蘑菇肉…嘿嘿嘿…我知道哪里有蘑菇肉，我们来弄些蘑菇肉吃，这样就有力气做事了。",
            "nextDialogs": [
              "710570129"
            ]
          },
          "710570129": {
            "id": "710570129",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "就在这附近…",
            "nextDialogs": [
              "710570130"
            ]
          },
          "710570130": {
            "id": "710570130",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#没办法了，{NICKNAME}，我们先找些蘑菇肉给他吃吧！",
            "nextDialogs": [
              "710570131"
            ]
          },
          "710570131": {
            "id": "710570131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来只能如此了。",
            "nextDialogs": [
              "710570132"
            ]
          },
          "710570132": {
            "id": "710570132",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "蘑菇肉…嘿嘿嘿…大蘑菇肉…"
          }
        }
      }
    },
    {
      "subId": "7105703",
      "subQuestName": "与老何一起前往收集「蘑菇肉」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710570301"
        ],
        "dialogs": {
          "710570301": {
            "id": "710570301",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "蘑菇肉…嘿嘿…好好吃了一顿蘑菇肉，小蘑菇，蘑菇怪，大蘑菇…嘿嘿…",
            "nextDialogs": [
              "710570302"
            ]
          },
          "710570302": {
            "id": "710570302",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "老何？你脸色怎么这么怪啊！",
            "nextDialogs": [
              "710570303"
            ]
          },
          "710570303": {
            "id": "710570303",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "唉…我就知道你这家伙肯定还活着！你们家里人还请我吃席，我那个时候就说，没见到遗体，吃什么席！",
            "nextDialogs": [
              "710570304"
            ]
          },
          "710570304": {
            "id": "710570304",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "脸色看上去那么差，肯定在矿里吃了不少苦，不过、不过活着就好呀！",
            "nextDialogs": [
              "710570305"
            ]
          },
          "710570305": {
            "id": "710570305",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "活得好！活的蘑菇好吃…嘿嘿…",
            "nextDialogs": [
              "710570306"
            ]
          },
          "710570306": {
            "id": "710570306",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "老何？",
            "nextDialogs": [
              "710570307"
            ]
          },
          "710570307": {
            "id": "710570307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们发现他的时候就已经是这样了。",
            "nextDialogs": [
              "710570308"
            ]
          },
          "710570308": {
            "id": "710570308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有点疯疯癫癫的…总是嚷嚷着要吃蘑菇。",
            "nextDialogs": [
              "710570309"
            ]
          },
          "710570309": {
            "id": "710570309",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "蘑菇…",
            "nextDialogs": [
              "710570310"
            ]
          },
          "710570310": {
            "id": "710570310",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "层岩巨渊下面的环境对于普通人来说很是凶险，生长的菌类和植物说不定也对人有害，所以辉山厅是严禁矿工进食那些东西的。",
            "nextDialogs": [
              "710570311"
            ]
          },
          "710570311": {
            "id": "710570311",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "但这几年老何一直在矿里，这样也是迫于无奈。",
            "nextDialogs": [
              "710570312"
            ]
          },
          "710570312": {
            "id": "710570312",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "变成这种模样，我该怎么和他的家里人交待呀。",
            "nextDialogs": [
              "710570315"
            ]
          },
          "710570315": {
            "id": "710570315",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "这么说来，海迪夫说不定有什么办法，毕竟是须弥的学者，对蘑菇肯定有研究。",
            "nextDialogs": [
              "710570316"
            ]
          },
          "710570316": {
            "id": "710570316",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "你们在这稍等下，我去把海迪夫叫来看看老何的情况。",
            "nextDialogs": [
              "710570317"
            ]
          },
          "710570317": {
            "id": "710570317",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "蘑菇肉…蘑菇肉…",
            "nextDialogs": [
              "710570318"
            ]
          },
          "710570318": {
            "id": "710570318",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉，真不知道老何这样还能不能恢复。",
            "nextDialogs": [
              "710570319"
            ]
          },
          "710570319": {
            "id": "710570319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是一直这样，就算回去了，他家人也不会高兴吧。",
            "nextDialogs": [
              "710570320"
            ]
          },
          "710570320": {
            "id": "710570320",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "写报告写到一半就被强行拉过来，瑾武啊，就算你是勘探队的安全负责人，但是耽误我的研究进度…",
            "nextDialogs": [
              "710570321"
            ]
          },
          "710570321": {
            "id": "710570321",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "我会认真考虑减少你们部分报酬的提案的。",
            "nextDialogs": [
              "710570322"
            ]
          },
          "710570322": {
            "id": "710570322",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "报酬的问题怎么样都好。",
            "nextDialogs": [
              "710570323"
            ]
          },
          "710570323": {
            "id": "710570323",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "你先看下这个人的情况…",
            "nextDialogs": [
              "710570324"
            ]
          },
          "710570324": {
            "id": "710570324",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "耳朵好痒…嘿嘿…",
            "nextDialogs": [
              "710570325"
            ]
          },
          "710570325": {
            "id": "710570325",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "嗯？这是什么人！他脸色怎么那么奇怪啊！",
            "nextDialogs": [
              "710570326"
            ]
          },
          "710570326": {
            "id": "710570326",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "#{NICKNAME}，这人是你找回来的？你怎么总能碰到神奇的事啊…",
            "nextDialogs": [
              "710570327"
            ]
          },
          "710570327": {
            "id": "710570327",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "那么…发现他的时候是什么情况呢？",
            "nextDialogs": [
              "710570328"
            ]
          },
          "710570328": {
            "id": "710570328",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "向海迪夫说明了与老何有关的事…\\n海迪夫仔细检查了老何。",
            "nextDialogs": [
              "710570329"
            ]
          },
          "710570329": {
            "id": "710570329",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "还好还好，没什么大碍。",
            "nextDialogs": [
              "710570330"
            ]
          },
          "710570330": {
            "id": "710570330",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "你看，他不是一直说自己的耳朵痒吗，那是因为这种菌类的孢子进入了耳道导致的。",
            "nextDialogs": [
              "710570331"
            ]
          },
          "710570331": {
            "id": "710570331",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "而这种真菌…啊，也就是这种蘑菇虽然长期食用确实会让人精神失常，不过对于人体来说的损害没有那么大。",
            "nextDialogs": [
              "710570332"
            ]
          },
          "710570332": {
            "id": "710570332",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "也就是说，他能够恢复？",
            "nextDialogs": [
              "710570333"
            ]
          },
          "710570333": {
            "id": "710570333",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "我已经帮他清理了身上的真菌，也做了能让紊乱的神经恢复下来的药。",
            "nextDialogs": [
              "710570334"
            ]
          },
          "710570334": {
            "id": "710570334",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "只要好好休息，恢复的可能性还是很大的。",
            "nextDialogs": [
              "710570335"
            ]
          },
          "710570335": {
            "id": "710570335",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "那这样，做药的钱…",
            "nextDialogs": [
              "710570336"
            ]
          },
          "710570336": {
            "id": "710570336",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "药的原材料还是很便宜的，只够在新月轩连吃一个月，算不上什么大钱。",
            "nextDialogs": [
              "710570337"
            ]
          },
          "710570337": {
            "id": "710570337",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "呃…我会想办法筹给你的…",
            "nextDialogs": [
              "710570338"
            ]
          },
          "710570338": {
            "id": "710570338",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "这点钱就不用给了，倒是我的报告又可以添一笔了。",
            "nextDialogs": [
              "710570339"
            ]
          },
          "710570339": {
            "id": "710570339",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "来层岩巨渊发现特殊蘑菇的时候，就想研究长期食用这种蘑菇会有什么后果…但是找不到愿意协助我进行实验的助手。"
          }
        }
      }
    },
    {
      "subId": "7105704",
      "subQuestName": "击败蕈兽",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710570401"
        ],
        "dialogs": {
          "710570401": {
            "id": "710570401",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "蘑菇肉…嘿嘿…好好吃了一顿蘑菇肉，小蘑菇，蘑菇怪，大蘑菇…嘿嘿…",
            "nextDialogs": [
              "710570402"
            ]
          },
          "710570402": {
            "id": "710570402",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "老何？你脸色怎么这么怪啊！",
            "nextDialogs": [
              "710570403"
            ]
          },
          "710570403": {
            "id": "710570403",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "唉…我就知道你这家伙肯定还活着！你们家里人还请我吃席，我那个时候就说，没见到遗体，吃什么席！",
            "nextDialogs": [
              "710570404"
            ]
          },
          "710570404": {
            "id": "710570404",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "脸色看上去那么差，肯定在矿里吃了不少苦，不过、不过活着就好呀！",
            "nextDialogs": [
              "710570405"
            ]
          },
          "710570405": {
            "id": "710570405",
            "speakerId": 20534,
            "speakerName": "老何",
            "text": "活得好！活的蘑菇好吃…嘿嘿…",
            "nextDialogs": [
              "710570406"
            ]
          },
          "710570406": {
            "id": "710570406",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "老何？",
            "nextDialogs": [
              "710570407"
            ]
          },
          "710570407": {
            "id": "710570407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们发现他的时候就已经是这样了。",
            "nextDialogs": [
              "710570408"
            ]
          },
          "710570408": {
            "id": "710570408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有点疯疯癫癫的…总是嚷嚷着要吃蘑菇。",
            "nextDialogs": [
              "710570409"
            ]
          },
          "710570409": {
            "id": "710570409",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "蘑菇…",
            "nextDialogs": [
              "710570410"
            ]
          },
          "710570410": {
            "id": "710570410",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "层岩巨渊下面的环境对于普通人来说很是凶险，生长的菌类和植物说不定也对人有害，所以辉山厅是严禁矿工进食那些东西的。",
            "nextDialogs": [
              "710570411"
            ]
          },
          "710570411": {
            "id": "710570411",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "但这几年老何一直在矿里，这样也是迫于无奈。",
            "nextDialogs": [
              "710570412"
            ]
          },
          "710570412": {
            "id": "710570412",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "变成这种模样，我该怎么和他的家里人交待呀。",
            "nextDialogs": [
              "710570415"
            ]
          },
          "710570415": {
            "id": "710570415",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "这么说来，海迪夫说不定有什么办法，毕竟是须弥的学者，对蘑菇肯定有研究。",
            "nextDialogs": [
              "710570416"
            ]
          },
          "710570416": {
            "id": "710570416",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于海迪夫…",
            "nextDialogs": [
              "710570417"
            ]
          },
          "710570417": {
            "id": "710570417",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "这家伙还在上面的营地，说是要把一些研究资料整理好带下来…",
            "nextDialogs": [
              "710570418"
            ]
          },
          "710570418": {
            "id": "710570418",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "只能等他下来以后再问问情况了。",
            "nextDialogs": [
              "710570419"
            ]
          },
          "710570419": {
            "id": "710570419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "希望老何能够恢复。",
            "nextDialogs": [
              "710570420"
            ]
          },
          "710570420": {
            "id": "710570420",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "唉，老何可是老前辈了，身手敏捷，对新来的小伙子们都多有照顾。",
            "nextDialogs": [
              "710570421"
            ]
          },
          "710570421": {
            "id": "710570421",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "他当年失踪之后…大家都觉得岩王爷没开眼啊，怎么好人没好报呢。",
            "nextDialogs": [
              "710570422"
            ]
          },
          "710570422": {
            "id": "710570422",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "如果他能够恢复、平安回去，大伙肯定会很高兴吧。",
            "nextDialogs": [
              "710570423"
            ]
          },
          "710570423": {
            "id": "710570423",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "#多谢你了，{NICKNAME}，等海迪夫看完老何的情况，无论如何，我都会把他带到上面去。",
            "nextDialogs": [
              "710570424"
            ]
          },
          "710570424": {
            "id": "710570424",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "这次真是辛苦你了，我都不知道该怎么感谢你啊。"
          }
        }
      }
    },
    {
      "subId": "7105705",
      "subQuestName": "与老何对话黑屏特效",
      "sceneId": null,

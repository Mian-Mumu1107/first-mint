  "subQuests": [
    {
      "subId": "7667401",
      "subQuestName": "与尼可闲聊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766740101"
        ],
        "dialogs": {
          "766740101": {
            "id": "766740101",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "哇哦，没想到最后的成品这么出人意料。如果真的有人误入这里，应该会为魔女的力量赞叹不已。",
            "nextDialogs": [
              "766740104"
            ]
          },
          "766740104": {
            "id": "766740104",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "这个嘛，要看对方是怎样的人了。",
            "nextDialogs": [
              "766740105"
            ]
          },
          "766740105": {
            "id": "766740105",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "引导很容易催生贪婪和懒惰。如果是像你们一样自食其力的人，我很愿意提供一些帮助。",
            "nextDialogs": [
              "766740106"
            ]
          },
          "766740106": {
            "id": "766740106",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "但是，如果是那些把全部希望都寄托在魔女的力量上，想要不劳而获的人…呵呵。",
            "nextDialogs": [
              "766740107"
            ]
          },
          "766740107": {
            "id": "766740107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难、难道说要把他们变成雕塑吗？",
            "nextDialogs": [
              "766740108"
            ]
          },
          "766740108": {
            "id": "766740108",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "那倒不会，我会引导他们离开这里，去附近的秘闻馆，那个叫奈芙尔的女人应该比我更懂得如何跟他们打交道。",
            "nextDialogs": [
              "766740109"
            ]
          },
          "766740109": {
            "id": "766740109",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "想要不劳而获，不付出代价怎么行呢？"
          }
        }
      }
    }
  ]
}
    {
      "subId": "4001101",
      "subQuestName": "聊聊有关岛屿的事",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110101"
        ],
        "dialogs": {
          "400110101": {
            "id": "400110101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…天气真好，我都睡迷糊了…",
            "nextDialogs": [
              "400110102"
            ]
          },
          "400110102": {
            "id": "400110102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "早上好！哇，你们这身打扮是？！",
            "nextDialogs": [
              "400110103"
            ]
          },
          "400110103": {
            "id": "400110103",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "嘿嘿，好看吗？",
            "nextDialogs": [
              "400110104"
            ]
          },
          "400110104": {
            "id": "400110104",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "我们都换了夏装哦！虽然来这里并不是为了玩…无论如何都不想错过美丽的夏日海景呢。",
            "nextDialogs": [
              "400110105"
            ]
          },
          "400110105": {
            "id": "400110105",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "不、不会很奇怪吧？",
            "nextDialogs": [
              "400110106"
            ]
          },
          "400110106": {
            "id": "400110106",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "如此飘逸轻便的服装，肯定不适合我…咳！失礼了。",
            "nextDialogs": [
              "400110109"
            ]
          },
          "400110109": {
            "id": "400110109",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "是吗…谢谢你，旅行者。",
            "nextDialogs": [
              "400110110"
            ]
          },
          "400110110": {
            "id": "400110110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过琴团长会特意准备夏装，真叫人意外呀。",
            "nextDialogs": [
              "400110111"
            ]
          },
          "400110111": {
            "id": "400110111",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "不不，按照姐姐的性格才不会自己准备呢，是我和丽莎小姐为她选的哦。",
            "nextDialogs": [
              "400110112"
            ]
          },
          "400110112": {
            "id": "400110112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "直接脱口而出「姐姐」了…而且自己完全没有注意到，芭芭拉已经沉醉于夏日了！",
            "nextDialogs": [
              "400110113"
            ]
          },
          "400110113": {
            "id": "400110113",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "夏装…真是说来话长啊。",
            "nextDialogs": [
              "400110114"
            ]
          },
          "400110114": {
            "id": "400110114",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "本以为丽莎给的口袋里是应急妙计，没想到，里面居然是一套夏装…",
            "nextDialogs": [
              "400110115"
            ]
          },
          "400110115": {
            "id": "400110115",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "连配饰都带齐了，该说不愧是丽莎吗？",
            "nextDialogs": [
              "400110116"
            ]
          },
          "400110116": {
            "id": "400110116",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "骑士团的各位无时无刻不想着让我休假…看来是我平时真的把自己逼得太紧了吗…",
            "nextDialogs": [
              "400110117"
            ]
          },
          "400110117": {
            "id": "400110117",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "大家快来可莉这边！",
            "nextDialogs": [
              "400110118"
            ]
          },
          "400110118": {
            "id": "400110118",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "是可莉的声音！",
            "nextDialogs": [
              "400110119"
            ]
          },
          "400110119": {
            "id": "400110119",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "有奇怪的东西——！",
            "nextDialogs": [
              "400110120"
            ]
          },
          "400110120": {
            "id": "400110120",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么了？奇怪的东西是指什么？",
            "nextDialogs": [
              "400110121"
            ]
          },
          "400110121": {
            "id": "400110121",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "你们看海里！",
            "nextDialogs": [
              "400110122"
            ]
          },
          "400110122": {
            "id": "400110122",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "有个奇怪的东西漂在上面哦。",
            "nextDialogs": [
              "400110123"
            ]
          },
          "400110123": {
            "id": "400110123",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "细长的装置，应该是浮标。",
            "nextDialogs": [
              "400110124"
            ]
          },
          "400110124": {
            "id": "400110124",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "可是，昨天在海上航行的时候，我们好像没有看到这个装置…",
            "nextDialogs": [
              "400110125"
            ]
          },
          "400110125": {
            "id": "400110125",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "一定是嘟嘟大魔王放的！",
            "nextDialogs": [
              "400110126"
            ]
          },
          "400110126": {
            "id": "400110126",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "一夜之间冒出来的奇怪装置，不简单哦。",
            "nextDialogs": [
              "400110127"
            ]
          },
          "400110127": {
            "id": "400110127",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "他一直没来找我，是不承认我吗…还是说…",
            "nextDialogs": [
              "400110128"
            ]
          },
          "400110128": {
            "id": "400110128",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "他是不是在等我，要我去找他？",
            "nextDialogs": [
              "400110129"
            ]
          },
          "400110129": {
            "id": "400110129",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "突然出现在海上的浮标，会有什么用意吗？",
            "nextDialogs": [
              "400110130"
            ]
          },
          "400110130": {
            "id": "400110130",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "靠近看看就知道了。",
            "nextDialogs": [
              "400110131"
            ]
          },
          "400110131": {
            "id": "400110131",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是啊，光在岸上猜测也解决不了问题。",
            "nextDialogs": [
              "400110132"
            ]
          },
          "400110132": {
            "id": "400110132",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "可以吗？",
            "nextDialogs": [
              "400110133"
            ]
          },
          "400110133": {
            "id": "400110133",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "还是主动确认一下比较好。",
            "nextDialogs": [
              "400110134"
            ]
          },
          "400110134": {
            "id": "400110134",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "很难说海上究竟有什么在等着我们…以防万一，希望大家做好战斗的准备。",
            "nextDialogs": [
              "400110135"
            ]
          },
          "400110135": {
            "id": "400110135",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "各自收拾妥当后，请到我这里集合，我们一起坐船过去。"
          }
        }
      }
    },
    {
      "subId": "4001102",
      "subQuestName": "依次确认战备情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110201"
        ],
        "dialogs": {
          "400110201": {
            "id": "400110201",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "海面上的浮标到底意味着什么呢…",
            "nextDialogs": [
              "400110203",
              "400110207"
            ]
          },
          "400110203": {
            "id": "400110203",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "这片群岛与世隔绝，就像一处自然形成的秘境。",
            "nextDialogs": [
              "400110204"
            ]
          },
          "400110204": {
            "id": "400110204",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "我们来这里，既有信的指引，也有温迪和特瓦林的帮助…一切实在太过巧合，我有些担心。",
            "nextDialogs": [
              "400110205"
            ]
          },
          "400110205": {
            "id": "400110205",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "不过，我之所以会在这里，就是为了保护各位。所以请放心，不论发生什么事，我都会与你们一同面对。"
          },
          "400110207": {
            "id": "400110207",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "啊…夏、夏装啊，那个是…是丽莎给我准备的惊喜。我猜，应该还有芭芭拉的建议。",
            "nextDialogs": [
              "400110208"
            ]
          },
          "400110208": {
            "id": "400110208",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "刚才芭芭拉也说，难得来海岛，一定要换上夏装才有气氛。",
            "nextDialogs": [
              "400110209"
            ]
          },
          "400110209": {
            "id": "400110209",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "可是，我不太习惯这样的装扮…唉，但愿这身打扮不会太过奇怪。"
          }
        }
      }
    },

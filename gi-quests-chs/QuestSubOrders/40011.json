    {
      "subId": "4001103",
      "subQuestName": "(test)询问战备情况进度记录$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110301"
        ],
        "dialogs": {
          "400110301": {
            "id": "400110301",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "唔…有什么是我能做的呢…",
            "nextDialogs": [
              "400110303",
              "400110307"
            ]
          },
          "400110303": {
            "id": "400110303",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "我从刚才就想说了，这里的大海真美啊。",
            "nextDialogs": [
              "400110304"
            ]
          },
          "400110304": {
            "id": "400110304",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "大海与阳光…梦寐以求的夏天呢！",
            "nextDialogs": [
              "400110305"
            ]
          },
          "400110305": {
            "id": "400110305",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "真想面朝大海办一场演出啊，效果肯定不错。"
          },
          "400110307": {
            "id": "400110307",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "怎么样？这件衣服…还不错吧？",
            "nextDialogs": [
              "400110308"
            ]
          },
          "400110308": {
            "id": "400110308",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "我特地选了跟海岛气氛比较搭的装扮，想给大家一个惊喜。",
            "nextDialogs": [
              "400110309"
            ]
          },
          "400110309": {
            "id": "400110309",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "啊，请别担心！就算穿着夏装，芭芭拉也是非常可靠的伙伴哦！"
          }
        }
      }
    },
    {
      "subId": "4001120",
      "subQuestName": "(test)任务隔离，防止回滚$HIDDEN",

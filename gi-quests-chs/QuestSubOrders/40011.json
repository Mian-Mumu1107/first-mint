    {
      "subId": "4001104",
      "subQuestName": "与众人讨论岛屿的变化",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110501"
        ],
        "dialogs": {
          "400110501": {
            "id": "400110501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么会有这种事，这片海域实在太神秘了！",
            "nextDialogs": [
              "400110502"
            ]
          },
          "400110502": {
            "id": "400110502",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "整片陆地都升了上来！",
            "nextDialogs": [
              "400110503"
            ]
          },
          "400110503": {
            "id": "400110503",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "大魔王，大魔王，哇咿！我来抓你啦，嘎——！",
            "nextDialogs": [
              "400110504"
            ]
          },
          "400110504": {
            "id": "400110504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "小可莉，永远这么有精神啊。",
            "nextDialogs": [
              "400110505"
            ]
          },
          "400110505": {
            "id": "400110505",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "地面震动之前，我有听到类似机关的声音。依我看，这片海面下有着非常巨大的机关。",
            "nextDialogs": [
              "400110506"
            ]
          },
          "400110506": {
            "id": "400110506",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "整片海岛位于机关构架出的底盘上，机关启动，将各个岛屿一并托出水面。",
            "nextDialogs": [
              "400110507"
            ]
          },
          "400110507": {
            "id": "400110507",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "这样的事情，堪称奇迹…难道这是风神巴巴托斯的力量吗？",
            "nextDialogs": [
              "400110508"
            ]
          },
          "400110508": {
            "id": "400110508",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "应该不是吧？我总觉得这更像是某个人刻意的作为…",
            "nextDialogs": [
              "400110509"
            ]
          },
          "400110509": {
            "id": "400110509",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "怎么想都不可思议…用信件把我们引来这里，再以这样的机关挑战我们，所谓的嘟嘟大魔王绝非无能之辈。",
            "nextDialogs": [
              "400110510"
            ]
          },
          "400110510": {
            "id": "400110510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也这么觉得。",
            "nextDialogs": [
              "400110511"
            ]
          },
          "400110511": {
            "id": "400110511",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "唉，假日的气氛一下就消失了…",
            "nextDialogs": [
              "400110512"
            ]
          },
          "400110512": {
            "id": "400110512",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "……",
            "nextDialogs": [
              "400110513"
            ]
          },
          "400110513": {
            "id": "400110513",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "总之，我会打起精神做好最高级别的警戒。",
            "nextDialogs": [
              "400110514"
            ]
          },
          "400110514": {
            "id": "400110514",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "琴团长，雷厉风行的时候真帅气呀！",
            "nextDialogs": [
              "400110515"
            ]
          },
          "400110515": {
            "id": "400110515",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙和我也会多加留心。",
            "nextDialogs": [
              "400110516"
            ]
          },
          "400110516": {
            "id": "400110516",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "感谢你们的理解。",
            "nextDialogs": [
              "400110517"
            ]
          },
          "400110517": {
            "id": "400110517",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "找到了，大魔王！",
            "nextDialogs": [
              "400110518"
            ]
          },
          "400110518": {
            "id": "400110518",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "就在那边的岛上，嘿嘿，抓到你了哦！",
            "nextDialogs": [
              "400110519"
            ]
          },
          "400110519": {
            "id": "400110519",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "既然要可莉来找你，那可莉就来啦！蹦蹦炸弹，预备——！我们一起跑！",
            "nextDialogs": [
              "400110520"
            ]
          },
          "400110520": {
            "id": "400110520",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "那是…<color=#00E1FFFF>海中央的平台</color>？",
            "nextDialogs": [
              "400110521"
            ]
          },
          "400110521": {
            "id": "400110521",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "确实有东西出现了。各位，可以靠近查看，但请务必保持警戒。"
          }
        }
      }
    },
    {
      "subId": "4001105",
      "subQuestName": "前往中央平台",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4001106",
      "subQuestName": "探讨面前的「神秘人士」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110601"
        ],
        "dialogs": {
          "400110601": {
            "id": "400110601",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "各位，请小心！",
            "nextDialogs": [
              "400110602"
            ]
          },
          "400110602": {
            "id": "400110602",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那是…个子很高大的人吗？",
            "nextDialogs": [
              "400110603"
            ]
          },
          "400110603": {
            "id": "400110603",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "很像是人，又不太对劲？",
            "nextDialogs": [
              "400110604"
            ]
          },
          "400110604": {
            "id": "400110604",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "嘟嘟大魔王，可莉来见你啦！你可以…呃…判、判…嗯？",
            "nextDialogs": [
              "400110605"
            ]
          },
          "400110605": {
            "id": "400110605",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「审判」！",
            "nextDialogs": [
              "400110606"
            ]
          },
          "400110606": {
            "id": "400110606",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "你可以「审判」可莉了！",
            "nextDialogs": [
              "400110607"
            ]
          },
          "400110607": {
            "id": "400110607",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊——！这孩子在说什么呀！",
            "nextDialogs": [
              "400110608"
            ]
          },
          "400110608": {
            "id": "400110608",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "她根本不明白那句话的意思吧…",
            "nextDialogs": [
              "400110609"
            ]
          },
          "400110609": {
            "id": "400110609",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "喂，大魔王——！你怎么不理我呀？",
            "nextDialogs": [
              "400110610"
            ]
          },
          "400110610": {
            "id": "400110610",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "是不是可莉来得太慢，惹你生气了？那…对不起嘛！",
            "nextDialogs": [
              "400110611"
            ]
          },
          "400110611": {
            "id": "400110611",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "向对方道歉了？可莉这孩子，思维有点跳跃吧…",
            "nextDialogs": [
              "400110612"
            ]
          },
          "400110612": {
            "id": "400110612",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "大——魔——王——！",
            "nextDialogs": [
              "400110613"
            ]
          },
          "400110613": {
            "id": "400110613",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "看起来，对方没有要理睬可莉的意思呢。",
            "nextDialogs": [
              "400110614"
            ]
          },
          "400110614": {
            "id": "400110614",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "是人型的机械吧。没有反应，应该是已经损坏了。",
            "nextDialogs": [
              "400110615"
            ]
          },
          "400110615": {
            "id": "400110615",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "你认识那个吗？",
            "nextDialogs": [
              "400110616"
            ]
          },
          "400110616": {
            "id": "400110616",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "只是猜测。它跟海岛的整体气氛格格不入…看衣着，倒像是从稻妻漂流而来。",
            "nextDialogs": [
              "400110617"
            ]
          },
          "400110617": {
            "id": "400110617",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "稻妻？那不是很远的地方吗？",
            "nextDialogs": [
              "400110618"
            ]
          },
          "400110618": {
            "id": "400110618",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它也是异乡人吗？",
            "nextDialogs": [
              "400110619"
            ]
          },
          "400110619": {
            "id": "400110619",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "是的。这里是独立的海域，不跟任何国度接壤，对这片海洋而言，它也是异乡人。",
            "nextDialogs": [
              "400110620"
            ]
          },
          "400110620": {
            "id": "400110620",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "但以稻妻眼下的情况，又怎么会发生这种事…",
            "nextDialogs": [
              "400110621"
            ]
          },
          "400110621": {
            "id": "400110621",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没反应的异乡人…好神奇，是有人把它带来这里吗？",
            "nextDialogs": [
              "400110622"
            ]
          },
          "400110622": {
            "id": "400110622",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "呜哇——大魔王不动了！",
            "nextDialogs": [
              "400110623"
            ]
          },
          "400110623": {
            "id": "400110623",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "可莉…也许大魔王只是累了。",
            "nextDialogs": [
              "400110624"
            ]
          },
          "400110624": {
            "id": "400110624",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对对，大魔王应该是睡着了吧？等你等得不耐烦，就呼——地睡过去了！",
            "nextDialogs": [
              "400110625"
            ]
          },
          "400110625": {
            "id": "400110625",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "嗯，我们陪可莉去别处玩，等大魔王睡醒再来找他。",
            "nextDialogs": [
              "400110626"
            ]
          },
          "400110626": {
            "id": "400110626",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "…真的…？",
            "nextDialogs": [
              "400110627"
            ]
          },
          "400110627": {
            "id": "400110627",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "当然啦，你要相信我们。",
            "nextDialogs": [
              "400110628"
            ]
          },
          "400110628": {
            "id": "400110628",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "唔…不对，可莉想到了！",
            "nextDialogs": [
              "400110629"
            ]
          },
          "400110629": {
            "id": "400110629",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "这个不是大魔王，真正的大魔王还在别的地方。",
            "nextDialogs": [
              "400110630"
            ]
          },
          "400110630": {
            "id": "400110630",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "欸？是、是吗？",
            "nextDialogs": [
              "400110631"
            ]
          },
          "400110631": {
            "id": "400110631",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "可莉不会放弃，大魔王，等着吧，我们来找你！",
            "nextDialogs": [
              "400110632"
            ]
          },
          "400110632": {
            "id": "400110632",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "又跑掉了…小孩子的精神真好呢。",
            "nextDialogs": [
              "400110633"
            ]
          },
          "400110633": {
            "id": "400110633",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "可莉，等等我们！"
          }
        }
      }
    },
    {
      "subId": "4001107",
      "subQuestName": "探查周围环境",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110701"
        ],
        "dialogs": {
          "400110701": {
            "id": "400110701",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "荣誉骑士，请看这里！",
            "nextDialogs": [
              "400110702"
            ]
          },
          "400110702": {
            "id": "400110702",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…？这是什么…",
            "nextDialogs": [
              "400110703"
            ]
          },
          "400110703": {
            "id": "400110703",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "叠放的石块和小小的花朵…",
            "nextDialogs": [
              "400110704"
            ]
          },
          "400110704": {
            "id": "400110704",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "这种感觉，好像是在纪念某个人。",
            "nextDialogs": [
              "400110707"
            ]
          },
          "400110707": {
            "id": "400110707",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "说得我都不好意思了…",
            "nextDialogs": [
              "400110708"
            ]
          },
          "400110708": {
            "id": "400110708",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可这附近只有那个没反应的稻妻机械而已呀。",
            "nextDialogs": [
              "400110709"
            ]
          },
          "400110709": {
            "id": "400110709",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "难道是在纪念它？",
            "nextDialogs": [
              "400110710"
            ]
          },
          "400110710": {
            "id": "400110710",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "或许，它也曾做出过值得他人纪念的事。",
            "nextDialogs": [
              "400110711"
            ]
          },
          "400110711": {
            "id": "400110711",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "……",
            "nextDialogs": [
              "400110712"
            ]
          },
          "400110712": {
            "id": "400110712",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "我们所见到的这些布设，足以证明这片海域中有人类存在过。可光凭这些，无法推导究竟是怎样的人类文明。",
            "nextDialogs": [
              "400110713"
            ]
          },
          "400110713": {
            "id": "400110713",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "迄今为止我们也没有见到任何人类或是人类的墓冢…",
            "nextDialogs": [
              "400110714"
            ]
          },
          "400110714": {
            "id": "400110714",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "琴团长，可莉去那边看看可以吗？",
            "nextDialogs": [
              "400110715"
            ]
          },
          "400110715": {
            "id": "400110715",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "可以，务必注意安全。",
            "nextDialogs": [
              "400110716"
            ]
          },
          "400110716": {
            "id": "400110716",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "嗯！",
            "nextDialogs": [
              "400110717"
            ]
          },
          "400110717": {
            "id": "400110717",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这片海岛上究竟有多少秘密？",
            "nextDialogs": [
              "400110718"
            ]
          },
          "400110718": {
            "id": "400110718",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "可莉还小，比较缺乏危机感，但旅行者，我希望我们都能清醒地了解现状。",
            "nextDialogs": [
              "400110719"
            ]
          },
          "400110719": {
            "id": "400110719",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "坦白说，一开始我以为那封信只是恶作剧。",
            "nextDialogs": [
              "400110720"
            ]
          },
          "400110720": {
            "id": "400110720",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们也这么想。",
            "nextDialogs": [
              "400110721"
            ]
          },
          "400110721": {
            "id": "400110721",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "我也是，可会是谁给这样的小孩子寄恶作剧信件呢？",
            "nextDialogs": [
              "400110722"
            ]
          },
          "400110722": {
            "id": "400110722",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "知道这座岛屿的人本就是少数，引导我们解开机关更是布局巧妙…",
            "nextDialogs": [
              "400110723"
            ]
          },
          "400110723": {
            "id": "400110723",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "说不定，这些不是恶作剧而是谋划已久的陷阱。我们绝对不能掉以轻心。",
            "nextDialogs": [
              "400110724"
            ]
          },
          "400110724": {
            "id": "400110724",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "芭芭拉姐姐！",
            "nextDialogs": [
              "400110725"
            ]
          },
          "400110725": {
            "id": "400110725",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "可莉，怎么了？",
            "nextDialogs": [
              "400110726"
            ]
          },
          "400110726": {
            "id": "400110726",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "你说…大魔王会不会不想见可莉？",
            "nextDialogs": [
              "400110727"
            ]
          },
          "400110727": {
            "id": "400110727",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "为什么呢？",
            "nextDialogs": [
              "400110728"
            ]
          },
          "400110728": {
            "id": "400110728",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "因为嘟嘟可喜欢可莉，可莉也喜欢嘟嘟可，大魔王没法把我们分开，就只能不见我们…",
            "nextDialogs": [
              "400110729"
            ]
          },
          "400110729": {
            "id": "400110729",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "呜…可莉很怕他把我们分开。",
            "nextDialogs": [
              "400110730"
            ]
          },
          "400110730": {
            "id": "400110730",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "……",
            "nextDialogs": [
              "400110731"
            ]
          },
          "400110731": {
            "id": "400110731",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "可莉看，这是什么？",
            "nextDialogs": [
              "400110732"
            ]
          },
          "400110732": {
            "id": "400110732",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "是羽球！",
            "nextDialogs": [
              "400110733"
            ]
          },
          "400110733": {
            "id": "400110733",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "我听姐…咳！听琴团长说过，可莉一直想玩羽球对不对？",
            "nextDialogs": [
              "400110734"
            ]
          },
          "400110734": {
            "id": "400110734",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "对，可莉想过羽球节！",
            "nextDialogs": [
              "400110735"
            ]
          },
          "400110735": {
            "id": "400110735",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "这是我为可莉做的特制羽球，只要可莉想玩，天天都是羽球节，好不好？",
            "nextDialogs": [
              "400110736"
            ]
          },
          "400110736": {
            "id": "400110736",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "好——！",
            "nextDialogs": [
              "400110737"
            ]
          },
          "400110737": {
            "id": "400110737",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感受到祈礼牧师的温柔了…",
            "nextDialogs": [
              "400110738"
            ]
          },
          "400110738": {
            "id": "400110738",
            "speakerId": 1001,
            "speakerName": "芭芭拉",
            "text": "所以可莉，打起精神来。见到大魔王以后，我们大家都会帮你说服他，让他允许你和嘟嘟可在一起。",
            "nextDialogs": [
              "400110739"
            ]
          },
          "400110739": {
            "id": "400110739",
            "speakerId": 1004,
            "speakerName": "可莉",
            "text": "嗯！",
            "nextDialogs": [

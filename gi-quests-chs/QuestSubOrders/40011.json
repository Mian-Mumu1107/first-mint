    {
      "subId": "4001109",
      "subQuestName": "(test)询问战备情况进度记录$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400110901"
        ],
        "dialogs": {
          "400110901": {
            "id": "400110901",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "准备好了吗？",
            "nextDialogs": [
              "400110903",
              "400110905"
            ]
          },
          "400110903": {
            "id": "400110903",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "不用着急，慢慢收拾就好。我会在这里等着你们的。"
          },
          "400110905": {
            "id": "400110905",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "那么，各位就请随我一同到<color=#00E1FFFF>海上</color>去吧。"
          }
        }
      }
    },

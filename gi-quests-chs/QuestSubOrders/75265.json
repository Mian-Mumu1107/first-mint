    {
      "subId": "7526501",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752650101"
        ],
        "dialogs": {
          "752650101": {
            "id": "752650101",
            "speakerId": 22014,
            "speakerName": "玛纳奥",
            "text": "嘿！朋友，我这有好东西，价格也美丽，要看看吗？",
            "nextDialogs": [
              "752650102"
            ]
          },
          "752650102": {
            "id": "752650102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这不是那些鳍游龙玩偶吗？好像在悠悠集市见过。",
            "nextDialogs": [
              "752650103"
            ]
          },
          "752650103": {
            "id": "752650103",
            "speakerId": 22014,
            "speakerName": "玛纳奥",
            "text": "真有眼光，但我这货便宜，五折就卖。",
            "nextDialogs": [
              "752650104"
            ]
          },
          "752650104": {
            "id": "752650104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么这么便宜？",
            "nextDialogs": [
              "752650105"
            ]
          },
          "752650105": {
            "id": "752650105",
            "speakerId": 22014,
            "speakerName": "玛纳奥",
            "text": "嘿嘿，朋友，这你就别管了，我有我的渠道。",
            "nextDialogs": [
              "752650106"
            ]
          },
          "752650106": {
            "id": "752650106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然便宜了很多，但是感觉这些玩偶的颜色有点怪怪的，不会是假货吧？",
            "nextDialogs": [
              "752650107"
            ]
          },
          "752650107": {
            "id": "752650107",
            "speakerId": 22014,
            "speakerName": "玛纳奥",
            "text": "假货？你这个不识货的小东西…一边去！",
            "nextDialogs": [
              "752650108"
            ]
          },
          "752650108": {
            "id": "752650108",
            "speakerId": 22014,
            "speakerName": "玛纳奥",
            "text": "快走快走！我不卖给你们了。"
          }
        }
      }
    },

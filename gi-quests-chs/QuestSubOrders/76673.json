    {
      "subId": "7667301",
      "subQuestName": "聆听神秘的声音",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766730801"
        ],
        "dialogs": {
          "766730801": {
            "id": "766730801",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "#在很久很久以前，有一位离家出走的年轻人。{M#他}{F#她}用完了身上最后一枚摩拉，在寒冷的冬天穿着单薄的衣衫，瑟瑟发抖地走着…",
            "nextDialogs": [
              "766730802"
            ]
          },
          "766730802": {
            "id": "766730802",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "#就在这时，年轻人的脚下一空，随后坠入了一片奇特的地方。未等{M#他}{F#她}反应过来，一个声音便从远处传来——",
            "nextDialogs": [
              "766730803"
            ]
          },
          "766730803": {
            "id": "766730803",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "「此为永恒不灭之大魔女尼古拉·可可的秘密小屋。落魄的年轻人啊，为我讲述你内心的愿望，伟大的魔女会引导你实现它。」",
            "nextDialogs": [
              "766730804"
            ]
          },
          "766730804": {
            "id": "766730804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…总觉得听到了奇怪的声音。",
            "nextDialogs": [
              "766730805"
            ]
          },
          "766730805": {
            "id": "766730805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "尼古拉·可可…是谁来着？我们认识这个人吗？"
          }
        }
      }
    },
    {
      "subId": "7667302",
      "subQuestName": "追寻缥缈的光点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766730201"
        ],
        "dialogs": {
          "766730201": {
            "id": "766730201",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "#年轻人惊叹于魔女的高贵与美丽，许久的沉默过后，{M#他}{F#她}郑重地对魔女开口——",
            "nextDialogs": [
              "766730202"
            ]
          },
          "766730202": {
            "id": "766730202",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "「悠远的魔女、昳丽的魔女、富有智慧的魔女！一见到您，我就忍不住心旌摇荡。我愿以您的愿望为我的愿望。」",
            "nextDialogs": [
              "766730203"
            ]
          },
          "766730203": {
            "id": "766730203",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "魔女的脸上露出不易察觉的笑容：「既然这样，那就替我完成一些力所能及的事情吧。指引已至，奖赏在未来等候你的到来。」",
            "nextDialogs": [
              "766730204"
            ]
          },
          "766730204": {
            "id": "766730204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "指引…是说这个光球吗？"
          }
        }
      }
    },
    {
      "subId": "7667303",
      "subQuestName": "追寻缥缈的光点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766730301"
        ],
        "dialogs": {
          "766730301": {
            "id": "766730301",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "「秘密小屋啊」，年轻人的眼中流露出疑惑，「小屋在哪呢？」",
            "nextDialogs": [
              "766730302"
            ]
          },
          "766730302": {
            "id": "766730302",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "听到年轻人的问题，魔女的声音少见地出现了些许慌乱…",
            "nextDialogs": [
              "766730303"
            ]
          },
          "766730303": {
            "id": "766730303",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "（等下她是这种娇羞的角色吗？算了先这样设定好了，九老师会帮忙润色的。）",
            "nextDialogs": [
              "766730304"
            ]
          },
          "766730304": {
            "id": "766730304",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "「咳咳，年轻人，不要问这么失礼的问题。魔女小屋正在修建当中，很快你就会被它的华丽惊掉下巴。」",
            "nextDialogs": [
              "766730305"
            ]
          },
          "766730305": {
            "id": "766730305",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "「这是给你的考验，为建设大魔女的领土贡献你的力量吧。」"
          }
        }
      }
    },
    {
      "subId": "7667304",
      "subQuestName": "寻找合适的拍摄对象",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766730401"
        ],
        "dialogs": {
          "766730401": {
            "id": "766730401",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "「好了，年轻人。如今你已经知晓了魔女的烦恼，尼古拉·可可正在建设她神圣的领地，需要你的帮助。」",
            "nextDialogs": [
              "766730402"
            ]
          },
          "766730402": {
            "id": "766730402",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "魔女笑着为年轻人沏了一杯茶：「你的选择是什么？」",
            "nextDialogs": [
              "766730405"
            ]
          },
          "766730405": {
            "id": "766730405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下啦！像这样来路不明、自说自话的怪人，还是谨慎一些比较好吧？",
            "nextDialogs": [
              "766730406"
            ]
          },
          "766730406": {
            "id": "766730406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦…不过这个茶杯，总感觉看上去有点眼熟…"
          }
        }
      }
    },
    {
      "subId": "7667305",
      "subQuestName": "寻找合适的拍摄对象",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766730501"
        ],
        "dialogs": {
          "766730501": {
            "id": "766730501",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "来得正好。",
            "nextDialogs": [
              "766730502"
            ]
          },
          "766730502": {
            "id": "766730502",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "你们拍的画片我很满意，都是我感兴趣的题材。雕刻工具我也准备好了，一起来试试？",
            "nextDialogs": [
              "766730503"
            ]
          },
          "766730503": {
            "id": "766730503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "雕刻工具…你是说这些方块吗？",
            "nextDialogs": [
              "766730504"
            ]
          },
          "766730504": {
            "id": "766730504",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "没错，雕像就在这些石材中，我们只需要把多余的部分去掉。",
            "nextDialogs": [
              "766730505"
            ]
          },
          "766730505": {
            "id": "766730505",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "为了方便你们理解，我将雕刻的方法也做了「引导」。",
            "nextDialogs": [
              "766730506"
            ]
          },
          "766730506": {
            "id": "766730506",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "让我来做个示范吧，首先是大刀阔斧地勾勒出基本的造型——",
            "nextDialogs": [
              "766730507"
            ]
          },
          "766730507": {
            "id": "766730507",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "石块上的数字就是同一列要保留的数量。像这样…然后这样…",
            "nextDialogs": [
              "766730508"
            ]
          },
          "766730508": {
            "id": "766730508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！逐渐像那么回事了！",
            "nextDialogs": [
              "766730509"
            ]
          },
          "766730509": {
            "id": "766730509",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "明白了吧？雕刻成这样，就大概能看出来基本的形状了。",
            "nextDialogs": [
              "766730510"
            ]
          },
          "766730510": {
            "id": "766730510",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "之后只需要再加入一点修饰…嘿！",
            "nextDialogs": [
              "766730511"
            ]
          },
          "766730511": {
            "id": "766730511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等、等一下！我只是眨了一下眼，怎么就变成这样了？",
            "nextDialogs": [
              "766730512"
            ]
          },
          "766730512": {
            "id": "766730512",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "这部分看看就好，伟大的魔女可不会随便公布术法的秘密。",
            "nextDialogs": [
              "766730513"
            ]
          },
          "766730513": {
            "id": "766730513",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "修饰的环节交给我，雕刻的手法你们应该看明白了吧？就拜托你们了。",
            "nextDialogs": [
              "766730514"
            ]
          },
          "766730514": {
            "id": "766730514",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，我们试试看——",
            "nextDialogs": [
              "766730515"
            ]
          },
          "766730515": {
            "id": "766730515",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！这是什么，一上来就这么难吗？",
            "nextDialogs": [
              "766730516"
            ]
          },
          "766730516": {
            "id": "766730516",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "嗯？哦，抱歉抱歉，刚刚拿错了。",
            "nextDialogs": [
              "766730517"
            ]
          },
          "766730517": {
            "id": "766730517",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "这个是我要做的，你们的在这边。",
            "nextDialogs": [
              "766730518"
            ]
          },
          "766730518": {
            "id": "766730518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吓，吓我一跳…"
          }
        }
      }
    },
    {
      "subId": "7667306",
      "subQuestName": "寻找合适的拍摄对象",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766730601"
        ],
        "dialogs": {
          "766730601": {
            "id": "766730601",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "嗯，魔女的故事已经初具雏形，这段可以交给九老师去写。",
            "nextDialogs": [
              "766730602"
            ]
          },
          "766730602": {
            "id": "766730602",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "大魔女最重要的是美貌和气势，或许可以通过狂笑来增加她的感知度。",
            "nextDialogs": [
              "766730603"
            ]
          },
          "766730603": {
            "id": "766730603",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "「哦呵呵呵呵，被妾身折服了吗，我可是永生之大魔女——」，笑起来会不会太吵了？算了反正写成文字也没人听得见。",
            "nextDialogs": [
              "766730604"
            ]
          },
          "766730604": {
            "id": "766730604",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "装修的计划已经做好了。但是从哪里开始呢？众所周知房子不能凭空变出来，等下真的不能吗？",
            "nextDialogs": [
              "766730605"
            ]
          },
          "766730605": {
            "id": "766730605",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "用炼金术应该也可以，毕竟原材料也只有砖石土木…嗯就这样做吧，比自己建省事多了。",
            "nextDialogs": [
              "766730606"
            ]
          },
          "766730606": {
            "id": "766730606",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "魔女的小屋应该与普通的住宅不同，至于哪里不同我也没有想好。",
            "nextDialogs": [
              "766730607"
            ]
          },
          "766730607": {
            "id": "766730607",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "只有一点是确定的，那就是这里应当是不变的古老的神秘的世外之地，再过几百年几千年也会维持原样。",
            "nextDialogs": [
              "766730608"
            ]
          },
          "766730608": {
            "id": "766730608",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "这一点很好，符合大家对魔女的期待。但事实上，并非是我定格了这里的时间，而是时间定格了我，哈哈。",
            "nextDialogs": [
              "766730609"
            ]
          },
          "766730609": {
            "id": "766730609",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "还愣着干什么？快点去完成魔女的委托吧。",
            "nextDialogs": [
              "766730610"
            ]
          },
          "766730610": {
            "id": "766730610",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "记好，拍照的时候不要拍得死气沉沉，我需要的是富有生命力的画片，才能雕刻出模特的精、气、神。",
            "nextDialogs": [
              "766730611"
            ]
          },
          "766730611": {
            "id": "766730611",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "不要觉得雕塑只要形似就可以了，最重要的是定格雕塑对象那一瞬间所展露的旺盛生命力，记住了吗？"
          }
        }
      }
    },
    {
      "subId": "7667307",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766730701"
        ],
        "dialogs": {
          "766730701": {
            "id": "766730701",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "跟派蒙一起拍摄了许多画片…",
            "nextDialogs": [
              "766730702"
            ]
          },
          "766730702": {
            "id": "766730702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉有几张拍得很不错呢，不过好像没拍到正面，等它转过来…",
            "nextDialogs": [
              "766730703"
            ]
          },
          "766730703": {
            "id": "766730703",
            "speakerId": 16015,
            "speakerName": "曼陀草",
            "text": "吼——！",
            "nextDialogs": [
              "766730704"
            ]
          },
          "766730704": {
            "id": "766730704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没错，就是这个感觉，很有气势呢！",
            "nextDialogs": [
              "766730707"
            ]
          },
          "766730707": {
            "id": "766730707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇啊啊——救命呀！！"
          }
        }
      }
    },

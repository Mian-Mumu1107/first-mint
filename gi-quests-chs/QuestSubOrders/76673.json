            "text": "(test)台词文本"
          }
        }
      }
    },
    {
      "subId": "7667311",
      "subQuestName": "与尼可聊天",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766731132"
        ],
        "dialogs": {
          "766731132": {
            "id": "766731132",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "接下来，只要找尼可做一点修饰…",
            "nextDialogs": [
              "766731133"
            ]
          },
          "766731133": {
            "id": "766731133",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "敲掉多余的石块了？我看看。",
            "nextDialogs": [
              "766731134"
            ]
          },
          "766731134": {
            "id": "766731134",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，这样就完成啦！",
            "nextDialogs": [
              "766731101"
            ]
          },
          "766731101": {
            "id": "766731101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦——魔女的小屋！什么时候出现的？",
            "nextDialogs": [
              "766731102"
            ]
          },
          "766731102": {
            "id": "766731102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是魔女的力量吗？",
            "nextDialogs": [
              "766731103"
            ]
          },
          "766731103": {
            "id": "766731103",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "「这就是魔女的力量吗」，年轻人的表情充满了不可思议，「真是太了不起了。」",
            "nextDialogs": [
              "766731104"
            ]
          },
          "766731104": {
            "id": "766731104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "终于要讲之前的故事了吗？魔女和年轻人后来怎么样了呢？",
            "nextDialogs": [
              "766731105"
            ]
          },
          "766731105": {
            "id": "766731105",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "#{M#他们}{F#她们}开心地生活在了一起…",
            "nextDialogs": [
              "766731106"
            ]
          },
          "766731106": {
            "id": "766731106",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "…就是这样。",
            "nextDialogs": [
              "766731107"
            ]
          },
          "766731107": {
            "id": "766731107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？",
            "nextDialogs": [
              "766731110"
            ]
          },
          "766731110": {
            "id": "766731110",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "真拿你们没办法，既然你们这么想听，那我就从头开始讲好了。",
            "nextDialogs": [
              "766731111"
            ]
          },
          "766731111": {
            "id": "766731111",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "#自从年轻人许下「以你的愿望为我的愿望」后，{M#他}{F#她}就顺利地吸引了大魔女尼古拉·可可的注意。",
            "nextDialogs": [
              "766731112"
            ]
          },
          "766731112": {
            "id": "766731112",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "然而就在两个人关系升温时，却突然闯入了一群不速之客，强行抓走了魔女！",
            "nextDialogs": [
              "766731113"
            ]
          },
          "766731113": {
            "id": "766731113",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "年轻人大惊，这时候新的魔女艾莉娜丝出现，跟年轻人签订了契约，让年轻人也拥有了魔法。",
            "nextDialogs": [
              "766731114"
            ]
          },
          "766731114": {
            "id": "766731114",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "在经历了艰苦卓绝的特训后，却发现这背后其实是另一个阴谋！",
            "nextDialogs": [
              "766731115"
            ]
          },
          "766731115": {
            "id": "766731115",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "原来大魔女尼古拉·可可其实是外星生命，是猫星国王喵特拉斯三世的大女儿。",
            "nextDialogs": [
              "766731116"
            ]
          },
          "766731116": {
            "id": "766731116",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "她们伪装成魔女，真实目的是为了让全世界都在不知不觉中信仰猫猫星！",
            "nextDialogs": [
              "766731117"
            ]
          },
          "766731117": {
            "id": "766731117",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "「伟大的魔女啊，难道您一直在欺骗我吗？」年轻人只觉得自己心肝寸裂，声音不由得发颤。",
            "nextDialogs": [
              "766731118"
            ]
          },
          "766731118": {
            "id": "766731118",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "「回去吧，我们猫猫星和你们注定会有一场战争，我们从一开始其实就是敌人。」",
            "nextDialogs": [
              "766731119"
            ]
          },
          "766731119": {
            "id": "766731119",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "魔女背过身，不让人看到她眼中的泪花…",
            "nextDialogs": [
              "766731120"
            ]
          },
          "766731120": {
            "id": "766731120",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "年轻人却勇敢向前抓住了魔女的手腕，发誓要和她永不分开。魔女被年轻人的执着打动，决定要掀起反旗！",
            "nextDialogs": [
              "766731121"
            ]
          },
          "766731121": {
            "id": "766731121",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "就在这个时候，当初帮助年轻人的艾莉娜丝却站在了国王那边。",
            "nextDialogs": [
              "766731122"
            ]
          },
          "766731122": {
            "id": "766731122",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "原来她是喵特拉斯三世的二女儿，帮助年轻人是为了促成姐姐的实质性背叛，从而争夺王位继承权——",
            "nextDialogs": [
              "766731123"
            ]
          },
          "766731123": {
            "id": "766731123",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "尼可滔滔不绝地讲述了曲折的过程，其中充满了各种奇怪的情节，最后甚至连主角都脱离了人类的范畴…",
            "nextDialogs": [
              "766731124"
            ]
          },
          "766731124": {
            "id": "766731124",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "总之就是这样啦，最后变成猫的年轻人和魔女一同粉碎了阴谋，回到了魔女小屋，过上了与世隔绝的平静生活。全剧终。",
            "nextDialogs": [
              "766731125"
            ]
          },
          "766731125": {
            "id": "766731125",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜呜…真好啊，充满爱与反抗的旅程…",
            "nextDialogs": [
              "766731126"
            ]
          },
          "766731126": {
            "id": "766731126",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉和开头已经是两个故事了…",
            "nextDialogs": [
              "766731127"
            ]
          },
          "766731127": {
            "id": "766731127",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "没办法，任何事物一旦被创造出来，终有一天都会脱离创造者的掌控。",
            "nextDialogs": [
              "766731128"
            ]
          },
          "766731128": {
            "id": "766731128",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "就像我们「天使」，曾经被赋予引导人类的职责，却因为部分天使选择了「另一条路」，最终整个族群受到惩罚。",
            "nextDialogs": [
              "766731129"
            ]
          },
          "766731129": {
            "id": "766731129",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "就算是天理，也无法完全掌控它创造的东西…何况我呢？",
            "nextDialogs": [
              "766731130"
            ]
          },
          "766731130": {
            "id": "766731130",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "命运就是那么不可言说，不过嘛…我还是希望引导我所见到的人，获得一个美好的结局。哪怕是故事中的人也一样。",
            "nextDialogs": [
              "766731131"
            ]
          },
          "766731131": {
            "id": "766731131",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "好了，这个故事讲完，我的热情也燃尽了。下次有好的故事，再分享给你们吧。",
            "nextDialogs": [
              "766731135"
            ]
          },
          "766731135": {
            "id": "766731135",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "原来她是喵特拉斯三世的二女儿…",
            "nextDialogs": [
              "766731136"
            ]
          },
          "766731136": {
            "id": "766731136",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "帮助年轻人是为了促成姐姐的实质性背叛…",
            "nextDialogs": [
              "766731137"
            ]
          },
          "766731137": {
            "id": "766731137",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "从而争夺王位继承权——"
          }
        }
      }
    },
    {
      "subId": "7667301",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766730101"
        ],
        "dialogs": {
          "766730101": {
            "id": "766730101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "#年轻人继续走着，{M#他}{F#她}留意到魔女的领土上有许多巧夺天工的雕塑。「这是什么？」年轻人不解地询问。",
            "nextDialogs": [
              "766730102"
            ]
          },
          "766730102": {
            "id": "766730102",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "「这些都是魔女的反对者，它们觊觎魔女的力量，所以被变成了石头。」",
            "nextDialogs": [
              "766730103"
            ]
          },
          "766730103": {
            "id": "766730103",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "这个设定不错，虽然是我现想的。魔女就应该是既强大又危险的存在…危险带来神秘，没有神秘，世间的一切都会黯淡无光。",
            "nextDialogs": [
              "766730104"
            ]
          },
          "766730104": {
            "id": "766730104",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "（不过动辄把人变成石头会不会太过分了？没人愿意跟这样的怪人长期相处吧，还是把刚刚说的话当做警告好了。）",
            "nextDialogs": [
              "766730105"
            ]
          },
          "766730105": {
            "id": "766730105",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "听完之后，年轻人冷汗直流。就在这时，魔女的笑声再次响起：「呵呵，当真了吗？不过是以雕塑来定格时光而已。」",
            "nextDialogs": [
              "766730106"
            ]
          },
          "766730106": {
            "id": "766730106",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "「雕塑——这就是我需要你帮我完成的事情，魔女的小屋缺少更多可爱的小家伙。」"
          }
        }
      }
    },
    {
      "subId": "7667306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766730613"
        ],
        "dialogs": {
          "766730613": {
            "id": "766730613",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "「哦呵呵呵呵，被妾身折服了吗，我可是永生之大魔女——」",
            "nextDialogs": [
              "766730614"
            ]
          },
          "766730614": {
            "id": "766730614",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "笑起来会不会太吵了？",
            "nextDialogs": [
              "766730615"
            ]
          },
          "766730615": {
            "id": "766730615",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "算了反正写成文字也没人听得见。",
            "nextDialogs": [
              "766730616"
            ]
          },
          "766730616": {
            "id": "766730616",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "这一点很好，符合大家对魔女的期待。",
            "nextDialogs": [
              "766730617"
            ]
          },
          "766730617": {
            "id": "766730617",
            "speakerId": 15982,
            "speakerName": "观察",
            "text": "但事实上，并非是我定格了这里的时间，而是时间定格了我，哈哈。"
          }
        }
      }
    },
    {
      "subId": "7667313",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766731301"
        ],
        "dialogs": {
          "766731301": {
            "id": "766731301",
            "speakerId": 1006,
            "speakerName": "<UNKNOWN>",
            "text": "(test)台词文本"
          }
        }
      }
    },
    {
      "subId": "7667399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766739906"
        ],
        "dialogs": {
          "766739906": {
            "id": "766739906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，快看那边，是团雀吗？",
            "nextDialogs": [
              "766739907"
            ]
          },
          "766739907": {
            "id": "766739907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉它们很有活力呢。决定了，第一张画片就拍团雀吧！",
            "nextDialogs": [
              "766739908"
            ]
          },
          "766739908": {
            "id": "766739908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让我想想，第二张拍什么比较好呢？",
            "nextDialogs": [
              "766739909"
            ]
          },
          "766739909": {
            "id": "766739909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，刚刚好像看到了关于松鼠的雕塑。难道说尼可喜欢松鼠？",
            "nextDialogs": [
              "766739910"
            ]
          },
          "766739910": {
            "id": "766739910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "拍几张画片带回去吧！",
            "nextDialogs": [
              "766739911"
            ]
          },
          "766739911": {
            "id": "766739911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这家伙…是曼陀草吗？",
            "nextDialogs": [
              "766739912"
            ]
          },
          "766739912": {
            "id": "766739912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "把它做成雕塑，一定很有意思！",
            "nextDialogs": [
              "766739913"
            ]
          },
          "766739913": {
            "id": "766739913",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…吓我一跳，没想到它一下子就扑上来啦。",
            "nextDialogs": [
              "766739914"
            ]
          },
          "766739914": {
            "id": "766739914",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#靠你啦{NICKNAME}，加油！",
            "nextDialogs": [
              "766739915"
            ]
          },
          "766739915": {
            "id": "766739915",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼，这样就搞定啦。",
            "nextDialogs": [
              "766739916"
            ]
          },
          "766739916": {
            "id": "766739916",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "画片我都保护好啦，我们回去找尼可吧。"
          }
        }
      }
    }
  ]
}
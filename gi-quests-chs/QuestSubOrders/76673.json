    {
      "subId": "7667309",
      "subQuestName": "将画片带回洞窟",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766730901"
        ],
        "dialogs": {
          "766730901": {
            "id": "766730901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "尼可，我们回来啦！",
            "nextDialogs": [
              "766730902"
            ]
          },
          "766730902": {
            "id": "766730902",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "这么快！真不愧是你们。",
            "nextDialogs": [
              "766730903"
            ]
          },
          "766730903": {
            "id": "766730903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "过奖啦，不过画片要怎么给你呢？",
            "nextDialogs": [
              "766730904"
            ]
          },
          "766730904": {
            "id": "766730904",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "你们先带在身上吧。大概两天后我会到达那里，到时候我们可以一起聊聊有关雕塑的事情。",
            "nextDialogs": [
              "766730905"
            ]
          },
          "766730905": {
            "id": "766730905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好呀，那我们不见不散！"
          }
        }
      }
    },

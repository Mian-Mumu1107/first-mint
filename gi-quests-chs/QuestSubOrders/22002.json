            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "你找到莲蓬了吗？",
            "nextDialogs": [
              "220020502"
            ]
          },
          "220020502": {
            "id": "220020502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有。",
            "nextDialogs": [
              "220020503"
            ]
          },
          "220020503": {
            "id": "220020503",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "慢慢找，不要着急…不对，还是请快一点吧。",
            "nextDialogs": [
              "220020504"
            ]
          },
          "220020504": {
            "id": "220020504",

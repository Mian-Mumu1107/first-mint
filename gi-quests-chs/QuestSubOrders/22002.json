  "subQuests": [
    {
      "subId": "2200201",
      "subQuestName": "与璐璐、阿飞、小蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220020101"
        ],
        "dialogs": {
          "220020101": {
            "id": "220020101",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "璐璐，怎么又是我做船长啊。",
            "nextDialogs": [
              "220020102"
            ]
          },
          "220020102": {
            "id": "220020102",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "因为小蒙做船长的时候，我们才玩得最开心呀。",
            "nextDialogs": [
              "220020103"
            ]
          },
          "220020103": {
            "id": "220020103",
            "speakerId": 1002,
            "speakerName": "阿飞",
            "text": "璐璐觉得没问题，那我…那我也没问题…",
            "nextDialogs": [
              "220020104"
            ]
          },
          "220020104": {
            "id": "220020104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在做什么？",
            "nextDialogs": [
              "220020105"
            ]
          },
          "220020105": {
            "id": "220020105",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们正准备玩游戏呢。",
            "nextDialogs": [
              "220020106"
            ]
          },
          "220020106": {
            "id": "220020106",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "小蒙是船长，阿飞是服务员，我是个有钱的商人。",
            "nextDialogs": [
              "220020107"
            ]
          },
          "220020107": {
            "id": "220020107",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "只缺一个海盗来抢劫我们啦！",
            "nextDialogs": [
              "220020108"
            ]
          },
          "220020108": {
            "id": "220020108",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "你愿意扮海盗，来陪我们玩吗？",
            "nextDialogs": [
              "220020110",
              "220020112"
            ]
          },
          "220020110": {
            "id": "220020110",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
            "nextDialogs": [
              "220020113"
            ]
          },
          "220020113": {
            "id": "220020113",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "#好啦，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}准备好了，就来找我吧。"
          },
          "220020112": {
            "id": "220020112",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "#只是玩个游戏啦，我知道{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}一定是个好人。"
          }
        }
      }
    },
    {
      "subId": "2200202",
      "subQuestName": "与「富商」璐璐对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220020201"
        ],
        "dialogs": {
          "220020201": {
            "id": "220020201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准备好了。",
            "nextDialogs": [
              "220020202"
            ]
          },
          "220020202": {
            "id": "220020202",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "那我们就开始玩吧！",
            "nextDialogs": [
              "220020203"
            ]
          },
          "220020203": {
            "id": "220020203",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "#那么，就请{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}开始吧。",
            "nextDialogs": [
              "220020204"
            ]
          },
          "220020204": {
            "id": "220020204",
            "speakerId": 1003,
            "speakerName": "<UNKNOWN>",
            "text": "你好，抢劫。",
            "nextDialogs": [
              "220020205"
            ]
          },
          "220020205": {
            "id": "220020205",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "哼，大白天的就来抢劫，千岩军的叔叔们就在旁边！",
            "nextDialogs": [
              "220020206"
            ]
          },
          "220020206": {
            "id": "220020206",
            "speakerId": 1002,
            "speakerName": "阿飞",
            "text": "璐璐，快过来，我们快点跑…",
            "nextDialogs": [
              "220020207"
            ]
          },
          "220020207": {
            "id": "220020207",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "你好，你是来抢什么的？",
            "nextDialogs": [
              "220020208"
            ]
          },
          "220020208": {
            "id": "220020208",
            "speakerId": 1003,
            "speakerName": "<UNKNOWN>",
            "text": "呃，应该是钱…",
            "nextDialogs": [
              "220020212"
            ]
          },
          "220020212": {
            "id": "220020212",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "可是我没多少钱可以抢…",
            "nextDialogs": [
              "220020213"
            ]
          },
          "220020213": {
            "id": "220020213",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "爸爸说，在船上，最值钱的东西是商人们运的货。",
            "nextDialogs": [
              "220020214"
            ]
          },
          "220020214": {
            "id": "220020214",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "#唔，这样吧。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你帮我去找点值钱的东西回来吧。",
            "nextDialogs": [
              "220020215"
            ]
          },
          "220020215": {
            "id": "220020215",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "这样子，我就有能被抢走的东西啦！",
            "nextDialogs": [
              "220020216"
            ]
          },
          "220020216": {
            "id": "220020216",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "我想想…那么，你就找点莲蓬回来吧。",
            "nextDialogs": [
              "220020217"
            ]
          },
          "220020217": {
            "id": "220020217",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "#我们三个人都很喜欢吃莲蓬，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}作为一个大坏蛋海盗，抢莲蓬最合适不过啦。"
          }
        }
      }
    },
    {
      "subId": "2200203",
      "subQuestName": "找到莲蓬",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220020301"
        ],
        "dialogs": {
          "220020301": {
            "id": "220020301",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "你找到莲蓬了吗？",
            "nextDialogs": [
              "220020302"
            ]
          },
          "220020302": {
            "id": "220020302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "220020303"
            ]
          },
          "220020303": {
            "id": "220020303",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！",
            "nextDialogs": [
              "220020304"
            ]
          },
          "220020304": {
            "id": "220020304",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "小蒙，阿飞，快点过来吃莲蓬啦。",
            "nextDialogs": [
              "220020305"
            ]
          },
          "220020305": {
            "id": "220020305",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "喂…喂，我们还是在抢劫吧…",
            "nextDialogs": [
              "220020306"
            ]
          },
          "220020306": {
            "id": "220020306",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "喔，对啊。那这些钱和东西给你们。",
            "nextDialogs": [
              "220020307"
            ]
          },
          "220020307": {
            "id": "220020307",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}扮海盗真厉害，从一个小孩子手里抢走了这么多东西呢。",
            "nextDialogs": [
              "220020308"
            ]
          },
          "220020308": {
            "id": "220020308",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "总感觉这孩子…话里有话…",
            "nextDialogs": [
              "220020309"
            ]
          },
          "220020309": {
            "id": "220020309",
            "speakerId": 1001,
            "speakerName": "璐璐",
            "text": "#这次辛苦{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}啦，下次也要陪我们一起玩呀。"
          }
        }
      }
    },

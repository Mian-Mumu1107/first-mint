    {
      "subId": "4000502",
      "subQuestName": "前往约好的地点，与信主碰头$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400050201"
        ],
        "dialogs": {
          "400050201": {
            "id": "400050201",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "两位就是来自盗宝团的朋友么？我明明已经在密信中说自己会乔装，也请两位尽情乔装…",
            "nextDialogs": [
              "400050202"
            ]
          },
          "400050202": {
            "id": "400050202",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "而今这位朋友却以本来面目现身，实在坦荡，在下佩服。",
            "nextDialogs": [
              "400050203"
            ]
          },
          "400050203": {
            "id": "400050203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼哼。我们和你这种藏头露尾的人不一样，我们可没有做过不戴上面具就不敢出现的亏心事啊！",
            "nextDialogs": [
              "400050204"
            ]
          },
          "400050204": {
            "id": "400050204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂——！",
            "nextDialogs": [
              "400050207"
            ]
          },
          "400050207": {
            "id": "400050207",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "你们，不是盗宝团的人！你们是什么人？"
          }
        }
      }
    },
    {
      "subId": "4000503",
      "subQuestName": "击败可疑人士$UNRELEASED",
      "sceneId": null,

    {
      "subId": "4000504",
      "subQuestName": "(test)与可疑人对话（隐藏）$UNRELEASED$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400050401"
        ],
        "dialogs": {
          "400050401": {
            "id": "400050401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "快把你的阴谋诡计招了！$UNRELEASED",
            "nextDialogs": [
              "400050402"
            ]
          },
          "400050402": {
            "id": "400050402",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "我招我招！$UNRELEASED",
            "nextDialogs": [
              "400050403"
            ]
          },
          "400050403": {
            "id": "400050403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不招的话，就尝尝我…欸！招得这么快吗？$UNRELEASED",
            "nextDialogs": [
              "400050404"
            ]
          },
          "400050404": {
            "id": "400050404",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "其实我…是向往「盗宝团」威名的新手盗贼。$UNRELEASED",
            "nextDialogs": [
              "400050405"
            ]
          },
          "400050405": {
            "id": "400050405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "新手盗贼？！$UNRELEASED",
            "nextDialogs": [
              "400050406"
            ]
          },
          "400050406": {
            "id": "400050406",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "像我这样初出茅庐，又孤身一人的新手…盗宝团就是我心中的圣地…$UNRELEASED",
            "nextDialogs": [
              "400050407"
            ]
          },
          "400050407": {
            "id": "400050407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "等一下…$UNRELEASED",
            "nextDialogs": [
              "400050408"
            ]
          },
          "400050408": {
            "id": "400050408",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "所以我想要干出一桩大买卖，去纳投名状…$UNRELEASED",
            "nextDialogs": [
              "400050409"
            ]
          },
          "400050409": {
            "id": "400050409",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "等一下！完全搞不明白！ $UNRELEASED",
            "nextDialogs": [
              "400050410"
            ]
          },
          "400050410": {
            "id": "400050410",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这和我想象的，凶残又邪恶的纵火黑手，完全不一样！$UNRELEASED",
            "nextDialogs": [
              "400050411"
            ]
          },
          "400050411": {
            "id": "400050411",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "纵火，什么纵火？$UNRELEASED",
            "nextDialogs": [
              "400050412"
            ]
          },
          "400050412": {
            "id": "400050412",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你一直在易燃物堆放的地方晃荡，难道不是为了纵火吗？$UNRELEASED",
            "nextDialogs": [
              "400050413"
            ]
          },
          "400050413": {
            "id": "400050413",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "啊啊，你说那里啊。我只是在那里踩点。$UNRELEASED",
            "nextDialogs": [
              "400050414"
            ]
          },
          "400050414": {
            "id": "400050414",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "我的计划和那些建筑材料没有关系。$UNRELEASED",
            "nextDialogs": [
              "400050415"
            ]
          },
          "400050415": {
            "id": "400050415",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没有关系？！$UNRELEASED",
            "nextDialogs": [
              "400050416"
            ]
          },
          "400050416": {
            "id": "400050416",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "我是为了…偷走那块二十年一遇的巨大「浮生石」！$UNRELEASED",
            "nextDialogs": [
              "400050417"
            ]
          },
          "400050417": {
            "id": "400050417",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "我的计划是，趁着夜色砍断一半锁链，就这样让它往海的方向飘——$UNRELEASED",
            "nextDialogs": [
              "400050418"
            ]
          },
          "400050418": {
            "id": "400050418",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦哦。$UNRELEASED",
            "nextDialogs": [
              "400050419"
            ]
          },
          "400050419": {
            "id": "400050419",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "再想办法让它沉到云来海的浅水湾里，这样就是完美犯罪了！$UNRELEASED",
            "nextDialogs": [
              "400050420"
            ]
          },
          "400050420": {
            "id": "400050420",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不完美的地方太多了！比如你要怎么把浮空的浮生石沉到水里啊？$UNRELEASED",
            "nextDialogs": [
              "400050421"
            ]
          },
          "400050421": {
            "id": "400050421",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "我也在思考这个问题，所以一直没动手嘛。$UNRELEASED",
            "nextDialogs": [
              "400050422"
            ]
          },
          "400050422": {
            "id": "400050422",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这人真的脑子不清楚啊！$UNRELEASED",
            "nextDialogs": [
              "400050423"
            ]
          },
          "400050423": {
            "id": "400050423",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#好了，{NICKNAME}，给他一个教训吧。$UNRELEASED",
            "nextDialogs": [
              "400050424"
            ]
          },
          "400050424": {
            "id": "400050424",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那么，我们去和夜叉小哥复命吧。$UNRELEASED"
          }
        }
      }
    },
    {
      "subId": "4000505",
      "subQuestName": "前往约定地点，与魈对话$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400050501"
        ],
        "dialogs": {
          "400050501": {
            "id": "400050501",
            "speakerId": 1002,
            "speakerName": "魈",
            "text": "原来事情是这样。人类的行为总是愚蠢得如此随机…不过，我无所谓。$UNRELEASED",
            "nextDialogs": [
              "400050502"
            ]
          },
          "400050502": {
            "id": "400050502",
            "speakerId": 1002,
            "speakerName": "魈",
            "text": "好了。你们把我喊到能看见「明霄灯」的地方来，究竟是为了什么？$UNRELEASED",
            "nextDialogs": [
              "400050505"
            ]
          },
          "400050505": {
            "id": "400050505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "明明海灯节纪念的英雄里也包括你…为什么你却不想去看灯呢？$UNRELEASED",
            "nextDialogs": [
              "400050506"
            ]
          },
          "400050506": {
            "id": "400050506",
            "speakerId": 1002,
            "speakerName": "魈",
            "text": "我无法靠近人群。那些，无忧无虑的人。$UNRELEASED",
            "nextDialogs": [
              "400050507"
            ]
          },
          "400050507": {
            "id": "400050507",
            "speakerId": 1002,
            "speakerName": "魈",
            "text": "苦行与杀戮的日子，我已经过得太久…已经成为习惯…$UNRELEASED",
            "nextDialogs": [
              "400050508"
            ]
          },
          "400050508": {
            "id": "400050508",
            "speakerId": 1002,
            "speakerName": "魈",
            "text": "这个话题就到这里吧。$UNRELEASED",
            "nextDialogs": [
              "400050509"
            ]
          },
          "400050509": {
            "id": "400050509",
            "speakerId": 1002,
            "speakerName": "魈",
            "text": "再见了。$UNRELEASED",
            "nextDialogs": [
              "400050510"
            ]
          },
          "400050510": {
            "id": "400050510",
            "speakerId": 1002,
            "speakerName": "魈",
            "text": "……$UNRELEASED",
            "nextDialogs": [
              "400050511"
            ]
          },
          "400050511": {
            "id": "400050511",
            "speakerId": 1002,
            "speakerName": "魈",
            "text": "不过，如果你在璃月遇到了鬼神之难，就直呼我名吧。$UNRELEASED",
            "nextDialogs": [
              "400050512"
            ]
          },
          "400050512": {
            "id": "400050512",
            "speakerId": 1002,
            "speakerName": "魈",
            "text": "不论是你，还是璃月。所有的灯火，所有祈求平安的愿望，我都已经听到了。$UNRELEASED",
            "nextDialogs": [
              "400050513"
            ]
          },
          "400050513": {
            "id": "400050513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那么，新年快乐。$UNRELEASED",
            "nextDialogs": [
              "400050514"
            ]
          },
          "400050514": {
            "id": "400050514",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "新年快乐！$UNRELEASED"
          }
        }
      }
    },

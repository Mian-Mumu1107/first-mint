    {
      "subId": "302802",
      "subQuestName": "穿过通道，前往散兵所在地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "302805",
      "subQuestName": "与纳西妲对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30280501"
        ],
        "dialogs": {
          "30280501": {
            "id": "30280501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里是…是要穿过这个地方吗？",
            "nextDialogs": [
              "30280502"
            ]
          },
          "30280502": {
            "id": "30280502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "想不到就在城内，还会藏着这种地方…",
            "nextDialogs": [
              "30280503"
            ]
          },
          "30280503": {
            "id": "30280503",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "贤者们想要实现造神计划，又不想被发觉，最安全也最方便的办法的确是直接在教令院内部开工。",
            "nextDialogs": [
              "30280504"
            ]
          },
          "30280504": {
            "id": "30280504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…是呀，既然藏得住一个神，那应该也藏得住「两个神」吧？",
            "nextDialogs": [
              "30280505"
            ]
          },
          "30280505": {
            "id": "30280505",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "看这里的构造，的确是大工程呢，贤者们看来真的把造神计划视为了终极目标。",
            "nextDialogs": [
              "30280506"
            ]
          },
          "30280506": {
            "id": "30280506",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "但这里看上去并不是单单教令院就能完成的…",
            "nextDialogs": [
              "30280507"
            ]
          },
          "30280507": {
            "id": "30280507",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "「博士」为首的那些愚人众还真是毫不吝啬自己手上的技术，帮了很多忙呢。",
            "nextDialogs": [
              "30280508"
            ]
          },
          "30280508": {
            "id": "30280508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "毕竟是帮助自己的执行官「成神」。",
            "nextDialogs": [
              "30280509"
            ]
          },
          "30280509": {
            "id": "30280509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀，不然他们怎么可能会那么好心呢。",
            "nextDialogs": [
              "30280510"
            ]
          },
          "30280510": {
            "id": "30280510",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "只是这样吗，我总感觉那个「博士」和教令院的贤者们不同，不像是带着某种迫切的目的在做事…",
            "nextDialogs": [
              "30280511"
            ]
          },
          "30280511": {
            "id": "30280511",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "就好比他对实验的结果没什么兴趣，只是在享受过程一样。",
            "nextDialogs": [
              "30280512"
            ]
          },
          "30280512": {
            "id": "30280512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…愚人众的执行官净是些奇怪的家伙，不如说「博士」的这种「奇怪」，是完全「不奇怪」的。",
            "nextDialogs": [
              "30280513"
            ]
          },
          "30280513": {
            "id": "30280513",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "反倒是…那个「伪神」的本体，是叫「散兵」对吗？",
            "nextDialogs": [
              "30280514"
            ]
          },
          "30280514": {
            "id": "30280514",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "之前和你们一起接触过他的意识，他的身上很明显有着非常强烈的执念…",
            "nextDialogs": [
              "30280515"
            ]
          },
          "30280515": {
            "id": "30280515",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "一种是原本作为「神之心的容器」而诞生，对神之心本能的渴求…",
            "nextDialogs": [
              "30280516"
            ]
          },
          "30280516": {
            "id": "30280516",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "而另一种执念应该和他过往的经历有关，我也说不清楚。",
            "nextDialogs": [
              "30280517"
            ]
          },
          "30280517": {
            "id": "30280517",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我知道他在成为愚人众执行官之前，曾经是雷电将军的「原型机」…",
            "nextDialogs": [
              "30280518"
            ]
          },
          "30280518": {
            "id": "30280518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是他渴望神之心的根源吧。不然以那个家伙的脾气和自尊心，怎么会甘愿来当个「实验品」。",
            "nextDialogs": [
              "30280519"
            ]
          },
          "30280519": {
            "id": "30280519",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "听上去你们和散兵很熟吗？",
            "nextDialogs": [
              "30280522"
            ]
          },
          "30280522": {
            "id": "30280522",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "这样啊，那你们给我详细讲讲吧，他是一个怎么样的家伙…",
            "nextDialogs": [
              "30280523"
            ]
          },
          "30280523": {
            "id": "30280523",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "为了应对后面发生的各种情况，了解的情报越多，越能更加针对性地处理。",
            "nextDialogs": [
              "30280524"
            ]
          },
          "30280524": {
            "id": "30280524",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "和纳西妲讲述了关于散兵的事…",
            "nextDialogs": [
              "30280525"
            ]
          },
          "30280525": {
            "id": "30280525",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "唔…我了解了，真是令人感兴趣呢。",
            "nextDialogs": [
              "30280526"
            ]
          },
          "30280526": {
            "id": "30280526",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "那我们走吧？穿过这里，当面去见见他。"
          }
        }
      }
    },
    {
      "subId": "302803",
      "subQuestName": "穿过通道，前往散兵所在地",
      "sceneId": null,
      "locations": [],

      }
    },
    {
      "subId": "302804",
      "subQuestName": "与纳西妲对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30280401"
        ],
        "dialogs": {
          "30280401": {
            "id": "30280401",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "从这里运转的状况来看，要做好最坏的打算了，他们想造的神…很可能接近完成或者已经完成了。",
            "nextDialogs": [
              "30280404"
            ]
          },
          "30280404": {
            "id": "30280404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那可怎么办…一个拥有着神之心力量的愚人众执行官，难以想象有多难对付…",
            "nextDialogs": [
              "30280405"
            ]
          },
          "30280405": {
            "id": "30280405",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "紧张么，派蒙？",
            "nextDialogs": [
              "30280406"
            ]
          },
          "30280406": {
            "id": "30280406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你这么问的话…当然是紧张啦，难道纳西妲不紧张吗？",
            "nextDialogs": [
              "30280407"
            ]
          },
          "30280407": {
            "id": "30280407",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "我也很紧张，这应该是我作为神明降生以来第一次直面这种程度的灾难。",
            "nextDialogs": [
              "30280408"
            ]
          },
          "30280408": {
            "id": "30280408",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "但紧张之余，我也感到很好奇。",
            "nextDialogs": [
              "30280409"
            ]
          },
          "30280409": {
            "id": "30280409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好奇…？好奇什么？",
            "nextDialogs": [
              "30280410"
            ]
          },
          "30280410": {
            "id": "30280410",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "好奇我们的命运啊。",
            "nextDialogs": [
              "30280411"
            ]
          },
          "30280411": {
            "id": "30280411",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "在我看来，世上可以感受到的一切，可以认知的一切，在人们身上已经发生过的一切，都是知识。",
            "nextDialogs": [
              "30280412"
            ]
          },
          "30280412": {
            "id": "30280412",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "是知识，就一定可以被了解。",
            "nextDialogs": [
              "30280413"
            ]
          },
          "30280413": {
            "id": "30280413",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "但唯独命运，在人们身上还未发生的事，始终在牵动着我的好奇心。",
            "nextDialogs": [
              "30280414"
            ]
          },
          "30280414": {
            "id": "30280414",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "所以在我眼中，「命运」才是终极的知识。",
            "nextDialogs": [
              "30280415"
            ]
          },
          "30280415": {
            "id": "30280415",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "也正因为如此，我才那么喜欢观察人类，看着每一件事情在他们的身上发生，都会给我带来满足。",
            "nextDialogs": [
              "30280416"
            ]
          },
          "30280416": {
            "id": "30280416",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "而如今，我终于不再只是那个旁观者了。",
            "nextDialogs": [
              "30280417"
            ]
          },
          "30280417": {
            "id": "30280417",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "我会亲身去经历自己的命运…和你们一起。这是一件多么令人期待的事啊。",
            "nextDialogs": [
              "30280418"
            ]
          },
          "30280418": {
            "id": "30280418",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样，我好像能理解纳西妲的心情了。"
          }
        }
      }
    },
    {
      "subId": "302806",
      "subQuestName": "前往散兵所在地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "302807",
      "subQuestName": "与散兵对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30280701"
        ],
        "dialogs": {
          "30280701": {
            "id": "30280701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种威压的感觉，确实是神明级的…",
            "nextDialogs": [
              "30280702"
            ]
          },
          "30280702": {
            "id": "30280702",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "将散兵原本身为「机械人偶」的概念极致化的躯体，又有来自神之心源源不断的能量输送…",
            "nextDialogs": [
              "30280703"
            ]
          },
          "30280703": {
            "id": "30280703",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "不知教令院和贤者在其中贡献了多少力量…",
            "nextDialogs": [
              "30280704"
            ]
          },
          "30280704": {
            "id": "30280704",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "单单从技术的角度上讲，的确值得嘉奖，说是人类智慧的结晶也不为过。",
            "nextDialogs": [
              "30280705"
            ]
          },
          "30280705": {
            "id": "30280705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你还有心思说这个，纳西妲…",
            "nextDialogs": [
              "30280706"
            ]
          },
          "30280706": {
            "id": "30280706",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "不过，从精神的角度上，我不认为他达到了神明的高度。",
            "nextDialogs": [
              "30280709"
            ]
          },
          "30280709": {
            "id": "30280709",
            "speakerId": 1003,
            "speakerName": "七叶寂照秘密主",
            "text": "每个诞生于世的神明，每一颗神之心上，都应该镌刻着纷争二字吧。",
            "nextDialogs": [
              "30280710"
            ]
          },
          "30280710": {
            "id": "30280710",
            "speakerId": 1003,
            "speakerName": "七叶寂照秘密主",
            "text": "这种力量的鼓动，以及心底为此而产生的雀跃，你难道感受不到么？",
            "nextDialogs": [
              "30280711"
            ]
          },
          "30280711": {
            "id": "30280711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "纳西妲才不会跟你有什么同样的感受呢…",
            "nextDialogs": [
              "30280712"
            ]
          },
          "30280712": {
            "id": "30280712",
            "speakerId": 1003,
            "speakerName": "七叶寂照秘密主",
            "text": "你知道…你是在打断神明间的对话么？渺小之物，给我有点自知之明！",
            "nextDialogs": [
              "30280713"
            ]
          },
          "30280713": {
            "id": "30280713",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "！！",
            "nextDialogs": [
              "30280714"
            ]
          },
          "30280714": {
            "id": "30280714",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "果然还是那个散兵…",
            "nextDialogs": [
              "30280715"
            ]
          },
          "30280715": {
            "id": "30280715",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "神之心上镌刻的争斗，难道…你想说的是魔神战争么。",
            "nextDialogs": [
              "30280716"
            ]
          },
          "30280716": {
            "id": "30280716",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "如今提瓦特平稳的局面，得来并不容易。我没有亲身参与过魔神战争，但在我看来…",
            "nextDialogs": [
              "30280717"
            ]
          },
          "30280717": {
            "id": "30280717",
            "speakerId": 1056,
            "speakerName": "纳西妲",
            "text": "那不过是在「法则」驱使下，毫无价值的损耗，再度提起它又有什么意义。",
            "nextDialogs": [
              "30280718"
            ]
          },
          "30280718": {
            "id": "30280718",
            "speakerId": 1003,
            "speakerName": "七叶寂照秘密主",
            "text": "呵呵…是么，我可是因为自己无缘参加真正的魔神战争而深感遗憾呢。",
            "nextDialogs": [
              "30280719"
            ]
          },
          "30280719": {
            "id": "30280719",
            "speakerId": 1003,
            "speakerName": "七叶寂照秘密主",
            "text": "这世上原来真的有不渴求力量的神明，我还是第一次亲眼见到。",
            "nextDialogs": [
              "30280720"
            ]
          },
          "30280720": {
            "id": "30280720",
            "speakerId": 1003,
            "speakerName": "七叶寂照秘密主",
            "text": "司掌智慧的神，怪不得就连你的人民都会将你背弃。"
          }
        }
      }
    },

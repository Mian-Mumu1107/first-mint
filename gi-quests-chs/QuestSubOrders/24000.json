  },
  "subQuests": [
    {
      "subId": "2400001",
      "subQuestName": "与利弗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240000101"
        ],
        "dialogs": {
          "240000101": {
            "id": "240000101",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "我再重复一遍…",
            "nextDialogs": [
              "240000102"
            ]
          },
          "240000102": {
            "id": "240000102",
            "speakerId": 1001,
            "speakerName": "柯妮莉娅",
            "text": "利弗先生，我十分理解您的诉求，也非常愿意尽我所能向您提供帮助，但这件申请…您看这里…",
            "nextDialogs": [
              "240000103"
            ]
          },
          "240000103": {
            "id": "240000103",
            "speakerId": 1001,
            "speakerName": "柯妮莉娅",
            "text": "经办人是克拉佩尔先生，您所有曾经提供的材料都归他整理提交，除了经办人之外，我们都没有权力办理啊。",
            "nextDialogs": [
              "240000104"
            ]
          },
          "240000104": {
            "id": "240000104",
            "speakerId": 1001,
            "speakerName": "柯妮莉娅",
            "text": "现在他正在出外勤，不在办公室里，您的这份材料必须要盖上他的公章，才能进入我们的报销流程。",
            "nextDialogs": [
              "240000105"
            ]
          },
          "240000105": {
            "id": "240000105",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "行了吧！我都来了三次了，你们到底办不办事？！",
            "nextDialogs": [
              "240000106"
            ]
          },
          "240000106": {
            "id": "240000106",
            "speakerId": 1001,
            "speakerName": "柯妮莉娅",
            "text": "利弗先生，请冷静一下，克拉佩尔先生所在的办公室毕竟只有两个人，除了他之外，只有一位蒙图瓦先生…",
            "nextDialogs": [
              "240000107"
            ]
          },
          "240000107": {
            "id": "240000107",
            "speakerId": 1001,
            "speakerName": "柯妮莉娅",
            "text": "但蒙图瓦先生年事已高，已经在等待退休，很久不在办公室里坐班了，就连工资也不拿啊。",
            "nextDialogs": [
              "240000108"
            ]
          },
          "240000108": {
            "id": "240000108",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "好吧，那我去他的办公室总行了，让那位老先生过来把章拿出来，我来盖！",
            "nextDialogs": [
              "240000109"
            ]
          },
          "240000109": {
            "id": "240000109",
            "speakerId": 1001,
            "speakerName": "柯妮莉娅",
            "text": "真的非常抱歉，利弗先生，这可不行。一方面这样不合规定，另一方面，公章钥匙在克拉佩尔先生手上，除了他之外没人能拿到公章。",
            "nextDialogs": [
              "240000110"
            ]
          },
          "240000110": {
            "id": "240000110",
            "speakerId": 1001,
            "speakerName": "柯妮莉娅",
            "text": "而且…我也得办其他的事去了…相信我，今天克拉佩尔先生一定会回来，为您把这件事彻底办结的。",
            "nextDialogs": [
              "240000111"
            ]
          },
          "240000111": {
            "id": "240000111",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "好吧…祝你今天愉快，柯妮莉娅小姐。",
            "nextDialogs": [
              "240000112"
            ]
          },
          "240000112": {
            "id": "240000112",
            "speakerId": 1001,
            "speakerName": "柯妮莉娅",
            "text": "您也是，利弗先生，祝您愉快。",
            "nextDialogs": [
              "240000113"
            ]
          },
          "240000113": {
            "id": "240000113",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "柯妮莉娅匆匆离开了…",
            "nextDialogs": [
              "240000114"
            ]
          },
          "240000114": {
            "id": "240000114",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "今天又只能回去了…唉…",
            "nextDialogs": [
              "240000117"
            ]
          },
          "240000117": {
            "id": "240000117",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "没什么大事，我只不过是又白跑一趟，浪费了宝贵的半天时光罢了。",
            "nextDialogs": [
              "240000118"
            ]
          },
          "240000118": {
            "id": "240000118",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "我真是受够了这个叫克拉佩尔的家伙！沫芒宫在我们这订购了几件发条机械，但是到现在还没付款！",
            "nextDialogs": [
              "240000119"
            ]
          },
          "240000119": {
            "id": "240000119",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "我第一次来找他，他说现在是月底，办公室需要进行月度封账审计，要到下个月月头才能往外出款，暂时不接受申请。",
            "nextDialogs": [
              "240000120"
            ]
          },
          "240000120": {
            "id": "240000120",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "第二次来，他说盖章用的印油用光了，但印油的供应商仓库着了火，要去别的地方采购，暂时盖不了章。",
            "nextDialogs": [
              "240000121"
            ]
          },
          "240000121": {
            "id": "240000121",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "第三次，他说这份「外部援请人员信息登记表」又更新了，我还得重新填一次。但这张表已经用完了，新印的明天才能送来。",
            "nextDialogs": [
              "240000122"
            ]
          },
          "240000122": {
            "id": "240000122",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "我今天准备来取那张表，但他根本就不在办公室，天哪…",
            "nextDialogs": [
              "240000123"
            ]
          },
          "240000123": {
            "id": "240000123",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "欸？利弗先生，我有什么能帮您的吗？瞧您这一副发愁的样子…",
            "nextDialogs": [
              "240000124"
            ]
          },
          "240000124": {
            "id": "240000124",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "莱弥娅警官，见到您真好，事情是这样…",
            "nextDialogs": [
              "240000125"
            ]
          },
          "240000125": {
            "id": "240000125",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "利弗絮絮叨叨地讲述了事情的经过…",
            "nextDialogs": [
              "240000126"
            ]
          },
          "240000126": {
            "id": "240000126",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "克拉佩尔先生啊…这位先生确实挺难打交道。但他今天确实去了伊黎耶岛办事，不在沫芒宫内。",
            "nextDialogs": [
              "240000127"
            ]
          },
          "240000127": {
            "id": "240000127",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "不过，无论他在哪里，我们还是先去把那张表拿到吧。",
            "nextDialogs": [
              "240000128"
            ]
          },
          "240000128": {
            "id": "240000128",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "欸？但克拉佩尔先生说，那张表已经用完了…",
            "nextDialogs": [
              "240000129"
            ]
          },
          "240000129": {
            "id": "240000129",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "我有办法解决您的问题。我记得，某些长期和沫芒宫合作的店铺也遇见过你现在所面对的情况。",
            "nextDialogs": [
              "240000130"
            ]
          },
          "240000130": {
            "id": "240000130",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "他们的解决方法是，隔一段时间就来沫芒宫索取可能会用到的表格和文件。",
            "nextDialogs": [
              "240000131"
            ]
          },
          "240000131": {
            "id": "240000131",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "这样做一方面是方便以最快的速度填写和提交文件，另一方面，也可以在第一时间获知表格和文件是否有更改之处…这就是所谓的「有备无患」。",
            "nextDialogs": [
              "240000132"
            ]
          },
          "240000132": {
            "id": "240000132",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "难，难道表格就是这么被拿光…",
            "nextDialogs": [
              "240000133"
            ]
          },
          "240000133": {
            "id": "240000133",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "总得来说，这几家店里肯定有富余的最新表格，我们就去找他们拿一张吧。",
            "nextDialogs": [
              "240000134"
            ]
          },
          "240000134": {
            "id": "240000134",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "而且，我相信当他们听到你在沫芒宫白跑这么多趟之后，肯定很愿意帮你。",
            "nextDialogs": [
              "240000135"
            ]
          },
          "240000135": {
            "id": "240000135",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "对了，我们还得赶在沫芒宫的下班时间之前拿到表格，并且完全填写完毕，再拿到克拉佩尔先生的办公室里去。",
            "nextDialogs": [
              "240000136"
            ]
          },
          "240000136": {
            "id": "240000136",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "这位旅行者，请问您愿意帮助一下利弗先生吗？",
            "nextDialogs": [
              "240000137"
            ]
          },
          "240000137": {
            "id": "240000137",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "旅行者！拜托你帮帮忙吧，再不办完这件事，我今天晚上肯定又睡不着了。"
          }
        }
      }
    },
    {
      "subId": "2400002",
      "subQuestName": "与伊丝黛莱对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240000201"
        ],
        "dialogs": {
          "240000201": {
            "id": "240000201",
            "speakerId": 1004,
            "speakerName": "伊丝黛莱",
            "text": "真是麻烦…就这么一点钱…",
            "nextDialogs": [
              "240000202"
            ]
          },
          "240000202": {
            "id": "240000202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「外部援请人员信息登记表」…",
            "nextDialogs": [
              "240000203"
            ]
          },
          "240000203": {
            "id": "240000203",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "叙述了利弗的经历和想要借表格的请求…",
            "nextDialogs": [
              "240000204"
            ]
          },
          "240000204": {
            "id": "240000204",
            "speakerId": 1004,
            "speakerName": "伊丝黛莱",
            "text": "唉，利弗也真是倒霉。但是…我也没有多余的了。",
            "nextDialogs": [
              "240000205"
            ]
          },
          "240000205": {
            "id": "240000205",
            "speakerId": 1004,
            "speakerName": "伊丝黛莱",
            "text": "我在给沫芒宫维修路灯的时候，带上了一个店里的人做帮手。",
            "nextDialogs": [
              "240000206"
            ]
          },
          "240000206": {
            "id": "240000206",
            "speakerId": 1004,
            "speakerName": "伊丝黛莱",
            "text": "因为那个人基本没帮上忙，我就没有把他写进「外部援请人员信息登记表」里。",
            "nextDialogs": [
              "240000207"
            ]
          },
          "240000207": {
            "id": "240000207",
            "speakerId": 1004,
            "speakerName": "伊丝黛莱",
            "text": "但在提交表格的时候，克拉佩尔坚持要我把所有人员都写进去…",
            "nextDialogs": [
              "240000208"
            ]
          },
          "240000208": {
            "id": "240000208",
            "speakerId": 1004,
            "speakerName": "伊丝黛莱",
            "text": "还说什么，如果不如实填写就会造成「难以估量的严重后果」。",
            "nextDialogs": [
              "240000209"
            ]
          },
          "240000209": {
            "id": "240000209",
            "speakerId": 1004,
            "speakerName": "伊丝黛莱",
            "text": "只不过少了一个人而已，怎么可能造成什么严重后果，真是莫名其妙…"
          }
        }
      }
    },
    {
      "subId": "2400003",
      "subQuestName": "与卡隆对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240000301"
        ],
        "dialogs": {
          "240000301": {
            "id": "240000301",
            "speakerId": 1005,
            "speakerName": "卡隆",
            "text": "真是费劲…唉…",
            "nextDialogs": [
              "240000302"
            ]
          },
          "240000302": {
            "id": "240000302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「外部援请人员信息登记表」…",
            "nextDialogs": [
              "240000303"
            ]
          },
          "240000303": {
            "id": "240000303",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "叙述了利弗的经历和想要借表格的请求…",
            "nextDialogs": [
              "240000304"
            ]
          },
          "240000304": {
            "id": "240000304",
            "speakerId": 1005,
            "speakerName": "卡隆",
            "text": "和沫芒宫打交道，遇见这种事也正常。",
            "nextDialogs": [
              "240000305"
            ]
          },
          "240000305": {
            "id": "240000305",
            "speakerId": 1005,
            "speakerName": "卡隆",
            "text": "我正好有一张多余的表格，你就把它带去给利弗吧。",
            "nextDialogs": [
              "240000306"
            ]
          },
          "240000306": {
            "id": "240000306",
            "speakerId": 1005,
            "speakerName": "卡隆",
            "text": "不过，你让他别对沫芒宫的办事效率抱有不切实际的期待啊。",
            "nextDialogs": [
              "240000307"
            ]
          },
          "240000307": {
            "id": "240000307",
            "speakerId": 1005,
            "speakerName": "卡隆",
            "text": "就算是表格提交上去了，正式拨款也要等很久，就算去催也没用，唉…"
          }
        }
      }
    },
    {
      "subId": "2400004",
      "subQuestName": "与利弗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240000401"
        ],
        "dialogs": {
          "240000401": {
            "id": "240000401",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "每个人手上都没有富余的表格了，这下完蛋了…",
            "nextDialogs": [
              "240000402"
            ]
          },
          "240000402": {
            "id": "240000402",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "沫芒宫最近雇佣人工作的频率有这么高吗？真奇怪…",
            "nextDialogs": [
              "240000405"
            ]
          },
          "240000405": {
            "id": "240000405",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "哎哟！您真是我的大救星，谢天谢地，要是我今天又白跑一趟，我非得跳河不成！",
            "nextDialogs": [
              "240000406"
            ]
          },
          "240000406": {
            "id": "240000406",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "还是…请您最好不要做这种会影响自己人身安全和市容观瞻的事，利弗先生。",
            "nextDialogs": [
              "240000407"
            ]
          },
          "240000407": {
            "id": "240000407",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "总之，请您先把表格填写好吧。填好之后，我会让柯妮莉娅小姐把这张表格带给克拉佩尔先生。",
            "nextDialogs": [
              "240000408"
            ]
          },
          "240000408": {
            "id": "240000408",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "就算克拉佩尔先生再忙，总不可能对放在桌面上的表格视而不见了。"
          }
        }
      }
    },
    {
      "subId": "2400006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240000601"
        ],
        "dialogs": {
          "240000601": {
            "id": "240000601",
            "speakerId": 1000,
            "speakerName": "利弗",
            "text": "莱弥娅警官，我真的不知道怎么感谢您才好，我听说您还在休假…",
            "nextDialogs": [
              "240000602"
            ]
          },
          "240000602": {
            "id": "240000602",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "作为警官，帮助枫丹廷市民是我的责任。",
            "nextDialogs": [
              "240000603"
            ]
          },
          "240000603": {
            "id": "240000603",
            "speakerId": 1003,
            "speakerName": "莱弥娅",
            "text": "好了，我们等会就出发吧，不能再拖晚了，沫芒宫一向下班得很准时。"
          }
        }
      }
    },
    {
      "subId": "2400008",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240000801"
        ],
        "dialogs": {
          "240000801": {
            "id": "240000801",
            "speakerId": 1004,
            "speakerName": "伊丝黛莱",
            "text": "只不过少了一个人而已，怎么可能造成什么严重后果，真是莫名其妙…"
          }
        }
      }
    },
    {
      "subId": "2400010",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240001001"
        ],
        "dialogs": {
          "240001001": {
            "id": "240001001",
            "speakerId": 1005,
            "speakerName": "卡隆",
            "text": "到底什么时候才能拨下来，真是…"
          }
        }
      }
    }
  ]
}
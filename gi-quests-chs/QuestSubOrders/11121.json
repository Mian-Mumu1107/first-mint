{
  "lineCounts": {
    "Player": 6,
    "昆钧": 25,
    "派蒙": 32,
    "老戴": 20,
    "观察石块": 2,
    "钟离": 36,
    "阿虎": 6
  },
  "subQuests": [
    {
      "subId": "1112101",
      "subQuestName": "前往老戴所说的矿区",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210101"
        ],
        "dialogs": {
          "111210101": {
            "id": "111210101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，这片矿区可真不小。",
            "nextDialogs": [
              "111210102"
            ]
          },
          "111210102": {
            "id": "111210102",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "各位，这里就是事发地点。",
            "nextDialogs": [
              "111210103"
            ]
          },
          "111210103": {
            "id": "111210103",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "六天前我带几个伙计外出办事，一回来，就听说留守的四个兄弟不见了。",
            "nextDialogs": [
              "111210104"
            ]
          },
          "111210104": {
            "id": "111210104",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "我带人搜遍整个矿区，怎么也找不到他们。实在没有头绪，才请几位来帮忙。",
            "nextDialogs": [
              "111210105"
            ]
          },
          "111210105": {
            "id": "111210105",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "也就是说，有四位矿工不明所踪。",
            "nextDialogs": [
              "111210106"
            ]
          },
          "111210106": {
            "id": "111210106",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "对。原本我们有十个人，丢了阿龙、岑大、岑二、小茂，都是跟着我做活儿的矿工。",
            "nextDialogs": [
              "111210107"
            ]
          },
          "111210107": {
            "id": "111210107",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "这行工人大多是青壮年男性。四个矿工，会不会是去别处矿洞了？",
            "nextDialogs": [
              "111210108"
            ]
          },
          "111210108": {
            "id": "111210108",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "不像。这一带周围没什么落脚地，咱们一路过来也没看见有其他开采中的矿洞啊。",
            "nextDialogs": [
              "111210109"
            ]
          },
          "111210109": {
            "id": "111210109",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "唔…这么大的矿区，你们全都找遍了？",
            "nextDialogs": [
              "111210110"
            ]
          },
          "111210110": {
            "id": "111210110",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "一寸不落，井下也找过，就差掘地三尺了。可四个大活人，总不能一下钻进地底吧？",
            "nextDialogs": [
              "111210111"
            ]
          },
          "111210111": {
            "id": "111210111",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "看过现场才能作出结论。",
            "nextDialogs": [
              "111210112"
            ]
          },
          "111210112": {
            "id": "111210112",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "哎，好的好的。我在这里候着，你们随意搜查，要是有失踪兄弟的线索，务必告诉我！"
          }
        }
      }
    },
    {
      "subId": "1112104",
      "subQuestName": "寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210401"
        ],
        "dialogs": {
          "111210401": {
            "id": "111210401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们看，这是什么？",
            "nextDialogs": [
              "111210402"
            ]
          },
          "111210402": {
            "id": "111210402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "散乱的衣服、裤子…",
            "nextDialogs": [
              "111210403"
            ]
          },
          "111210403": {
            "id": "111210403",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "摆放在矿区内的生活物资，应当属于老戴他们。",
            "nextDialogs": [
              "111210404"
            ]
          },
          "111210404": {
            "id": "111210404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一、二、三、四…",
            "nextDialogs": [
              "111210405"
            ]
          },
          "111210405": {
            "id": "111210405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…没错没错，总共十件衣服，十条裤子。",
            "nextDialogs": [
              "111210406"
            ]
          },
          "111210406": {
            "id": "111210406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些是替换的衣服吧？你看，老戴身上也穿着一样的服装。",
            "nextDialogs": [
              "111210407"
            ]
          },
          "111210407": {
            "id": "111210407",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "那四个人出门六天至今未归，却没带替换衣物。",
            "nextDialogs": [
              "111210408"
            ]
          },
          "111210408": {
            "id": "111210408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "周围还有洗脸用的布帕和皂角…还有这些腰包，是随身的小工具包。",
            "nextDialogs": [
              "111210409"
            ]
          },
          "111210409": {
            "id": "111210409",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "晨起洗漱的用具，采矿的装备…",
            "nextDialogs": [
              "111210410"
            ]
          },
          "111210410": {
            "id": "111210410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也就是说，这些人没带行李？",
            "nextDialogs": [
              "111210411"
            ]
          },
          "111210411": {
            "id": "111210411",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "对。",
            "nextDialogs": [
              "111210414"
            ]
          },
          "111210414": {
            "id": "111210414",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "不像。",
            "nextDialogs": [
              "111210415"
            ]
          },
          "111210415": {
            "id": "111210415",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "开采用的矿镐少了四把，说明他们很可能带着工具。",
            "nextDialogs": [
              "111210416"
            ]
          },
          "111210416": {
            "id": "111210416",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "有时间带上工具，却没时间打包生活用品？不合常理。",
            "nextDialogs": [
              "111210417"
            ]
          },
          "111210417": {
            "id": "111210417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…人在什么情况下才会不带行李，只带工具出门？",
            "nextDialogs": [
              "111210418"
            ]
          },
          "111210418": {
            "id": "111210418",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "一，他们到附近工作，不需要行李，但这些人至今未归，这个说法不攻自破。",
            "nextDialogs": [
              "111210419"
            ]
          },
          "111210419": {
            "id": "111210419",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "二，如果他们不是出于自身意愿而离开，也就无暇思考行李的事了。",
            "nextDialogs": [
              "111210420"
            ]
          },
          "111210420": {
            "id": "111210420",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咿——！",
            "nextDialogs": [
              "111210421"
            ]
          },
          "111210421": {
            "id": "111210421",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是说，被人带走了？",
            "nextDialogs": [
              "111210422"
            ]
          },
          "111210422": {
            "id": "111210422",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "这种可能性不小。更进一步的推论，需要更多线索。",
            "nextDialogs": [
              "111210423"
            ]
          },
          "111210423": {
            "id": "111210423",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不是自发离开而是被人带走，把这种可能性记录下来转告给老戴吧。"
          }
        }
      }
    },
    {
      "subId": "1112102",
      "subQuestName": "寻找更多线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210201"
        ],
        "dialogs": {
          "111210201": {
            "id": "111210201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小昆，你在看什么？",
            "nextDialogs": [
              "111210202"
            ]
          },
          "111210202": {
            "id": "111210202",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "是你们啊，来得正好。",
            "nextDialogs": [
              "111210203"
            ]
          },
          "111210203": {
            "id": "111210203",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "有什么发现？",
            "nextDialogs": [
              "111210204"
            ]
          },
          "111210204": {
            "id": "111210204",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "这里有块矿石，我想，或许能从中获得一些线索。",
            "nextDialogs": [
              "111210205"
            ]
          },
          "111210205": {
            "id": "111210205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "矿石？这种矿石跟失踪案有关吗？",
            "nextDialogs": [
              "111210206"
            ]
          },
          "111210206": {
            "id": "111210206",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "这种事，试试就知道了。稍等。",
            "nextDialogs": [
              "111210207"
            ]
          },
          "111210207": {
            "id": "111210207",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "……",
            "nextDialogs": [
              "111210208"
            ]
          },
          "111210208": {
            "id": "111210208",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "……",
            "nextDialogs": [
              "111210209"
            ]
          },
          "111210209": {
            "id": "111210209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他好像很专注，是在做什么呢？",
            "nextDialogs": [
              "111210210"
            ]
          },
          "111210210": {
            "id": "111210210",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "看见了。四个大人…跟着一个像是小孩的身影走出了矿区。",
            "nextDialogs": [
              "111210211"
            ]
          },
          "111210211": {
            "id": "111210211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小孩？矿区里怎么会有小孩子？！",
            "nextDialogs": [
              "111210212"
            ]
          },
          "111210212": {
            "id": "111210212",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "我也不清楚…",
            "nextDialogs": [
              "111210213"
            ]
          },
          "111210213": {
            "id": "111210213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有，「看见」是什么意思？",
            "nextDialogs": [
              "111210214"
            ]
          },
          "111210214": {
            "id": "111210214",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "啊，就是字面意义的「看见」。你们听了，可别告诉别人！我觉得这事比较古怪，一直没敢和人说。",
            "nextDialogs": [
              "111210215"
            ]
          },
          "111210215": {
            "id": "111210215",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "其实，我能看见矿石的记忆。",
            "nextDialogs": [
              "111210216"
            ]
          },
          "111210216": {
            "id": "111210216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎——？！",
            "nextDialogs": [
              "111210217"
            ]
          },
          "111210217": {
            "id": "111210217",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "不是猜测，不是估算，而是「看见」？",
            "nextDialogs": [
              "111210218"
            ]
          },
          "111210218": {
            "id": "111210218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "像刚才那样把手放到石头上就行了吗？",
            "nextDialogs": [
              "111210219"
            ]
          },
          "111210219": {
            "id": "111210219",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "嗯，对我来说，矿石也有「记忆」。它们偶尔会记录下周遭发生的事，我只要触摸并用心感知，就能看见那些「记忆」。",
            "nextDialogs": [
              "111210220"
            ]
          },
          "111210220": {
            "id": "111210220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么厉害！那你岂不是什么都知道？",
            "nextDialogs": [
              "111210221"
            ]
          },
          "111210221": {
            "id": "111210221",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "还得看具体的石块。不同矿石记忆能力有所不同，铁矿、白铁块之类的常见矿石基本派不上用场，记忆很模糊。",
            "nextDialogs": [
              "111210222"
            ]
          },
          "111210222": {
            "id": "111210222",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "石珀、水晶的记忆能力更强，能记录的景象更多也更清晰。",
            "nextDialogs": [
              "111210223"
            ]
          },
          "111210223": {
            "id": "111210223",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "以石为目…有趣。这种能力实在罕见，老戴请昆兄出马，实在是明智之举。",
            "nextDialogs": [
              "111210224"
            ]
          },
          "111210224": {
            "id": "111210224",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "哈哈，能帮上大家的忙就好了。",
            "nextDialogs": [
              "111210225"
            ]
          },
          "111210225": {
            "id": "111210225",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "依我所见，他们应该是沿这条路向前去了。",
            "nextDialogs": [
              "111210226"
            ]
          },
          "111210226": {
            "id": "111210226",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "这条路指向北方，沿着它一直走就能离开矿区。",
            "nextDialogs": [
              "111210227"
            ]
          },
          "111210227": {
            "id": "111210227",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们往北走了，把这条线索记录下来，告诉老戴吧！"
          }
        }
      }
    },
    {
      "subId": "1112103",
      "subQuestName": "寻找更多线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210301"
        ],
        "dialogs": {
          "111210301": {
            "id": "111210301",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "你是这里的工人吗？",
            "nextDialogs": [
              "111210302"
            ]
          },
          "111210302": {
            "id": "111210302",
            "speakerId": 10378,
            "speakerName": "阿虎",
            "text": "啊对、对！你们是来调查失踪案的吧，求求你们，一定要救回大家！",
            "nextDialogs": [
              "111210303"
            ]
          },
          "111210303": {
            "id": "111210303",
            "speakerId": 10378,
            "speakerName": "阿虎",
            "text": "我不知道…不知道发生了什么，那天天色很阴暗，工头带着几个兄弟去外头办事。",
            "nextDialogs": [
              "111210304"
            ]
          },
          "111210304": {
            "id": "111210304",
            "speakerId": 10378,
            "speakerName": "阿虎",
            "text": "我和其他四个兄弟留在矿区工作，中间我偷了一小会儿懒…就一会儿！",
            "nextDialogs": [
              "111210305"
            ]
          },
          "111210305": {
            "id": "111210305",
            "speakerId": 10378,
            "speakerName": "阿虎",
            "text": "我在最里面的棚子睡觉，等我醒来，所有人都消失得无影无踪了！明明不久前才跟他们说过话，突然…人就没了…",
            "nextDialogs": [
              "111210306"
            ]
          },
          "111210306": {
            "id": "111210306",
            "speakerId": 10378,
            "speakerName": "阿虎",
            "text": "该不会、该不会什么时候就轮到我了吧…",
            "nextDialogs": [
              "111210307"
            ]
          },
          "111210307": {
            "id": "111210307",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "躲在棚子里的人没有失踪，在外劳作的人却没了踪影。",
            "nextDialogs": [
              "111210308"
            ]
          },
          "111210308": {
            "id": "111210308",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "莫非是工作区出了什么事？",
            "nextDialogs": [
              "111210309"
            ]
          },
          "111210309": {
            "id": "111210309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃啊！好可怕！",
            "nextDialogs": [
              "111210310"
            ]
          },
          "111210310": {
            "id": "111210310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "工作区或许有状况，把这条线索记录下来吧。"
          }
        }
      }
    },
    {
      "subId": "1112107",
      "subQuestName": "向老戴汇报调查结果",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210701"
        ],
        "dialogs": {
          "111210701": {
            "id": "111210701",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "你们回来了，调查得怎么样？",
            "nextDialogs": [
              "111210702"
            ]
          },
          "111210702": {
            "id": "111210702",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "我们在附近找到三条线索。",
            "nextDialogs": [
              "111210703"
            ]
          },
          "111210703": {
            "id": "111210703",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "第一，矿镐少了四把，生活用品却一件都没带走，说明那些工人很可能不是自发离开，而是被人带走。",
            "nextDialogs": [
              "111210704"
            ]
          },
          "111210704": {
            "id": "111210704",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "被人带走？！可是…谁会劫持工人呢？",
            "nextDialogs": [
              "111210705"
            ]
          },
          "111210705": {
            "id": "111210705",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "第二，矿区内原本有五名工人。其中一人为了偷懒，离开工作区打了个瞌睡。等他一觉醒来，同伴已经消失得无影无踪。",
            "nextDialogs": [
              "111210706"
            ]
          },
          "111210706": {
            "id": "111210706",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "留在工作区的人纷纷失踪，躲在休息区的人却安然无恙。可见，事情是发生在工作区。",
            "nextDialogs": [
              "111210707"
            ]
          },
          "111210707": {
            "id": "111210707",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "这么一说，阿虎确实提过他偷懒了…",
            "nextDialogs": [
              "111210708"
            ]
          },
          "111210708": {
            "id": "111210708",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "难道有人走进工作区带走了他们？！",
            "nextDialogs": [
              "111210709"
            ]
          },
          "111210709": {
            "id": "111210709",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "这正是我要说的第三点。昆兄用他特别的手段推算出来，那些人是被一个孩童带离了矿区。",
            "nextDialogs": [
              "111210710"
            ]
          },
          "111210710": {
            "id": "111210710",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "孩童？！这附近住户很少，不可能有孩子跑到矿区里来啊！",
            "nextDialogs": [
              "111210711"
            ]
          },
          "111210711": {
            "id": "111210711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但结果就是，四个工人跟着一个小孩子走了。",
            "nextDialogs": [
              "111210712"
            ]
          },
          "111210712": {
            "id": "111210712",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "他们去哪儿了？",
            "nextDialogs": [
              "111210713"
            ]
          },
          "111210713": {
            "id": "111210713",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "根据我们的推测，他们沿路向北行走，应该是出了矿区，往遗迹方向去了。",
            "nextDialogs": [
              "111210714"
            ]
          },
          "111210714": {
            "id": "111210714",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "北方！好，我这就带人去找。",
            "nextDialogs": [
              "111210715"
            ]
          },
          "111210715": {
            "id": "111210715",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "需要帮忙吗？",
            "nextDialogs": [
              "111210716"
            ]
          },
          "111210716": {
            "id": "111210716",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "都把调查的事交给你们了，跑腿就让我们弟兄几个来吧。先走一步，说不定快马加鞭还能追上他们。",
            "nextDialogs": [
              "111210717"
            ]
          },
          "111210717": {
            "id": "111210717",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "且慢。事情发生在六天前，哪怕只是步行，他们也走得很远了。",
            "nextDialogs": [
              "111210718"
            ]
          },
          "111210718": {
            "id": "111210718",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "唔…说得也是。这样吧，一会儿我带兄弟几个到远处的住户那儿打听打听。",
            "nextDialogs": [
              "111210719"
            ]
          },
          "111210719": {
            "id": "111210719",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "离开矿区，想投宿就只有那么几户人家。调查这些就交给我们吧。",
            "nextDialogs": [
              "111210720"
            ]
          },
          "111210720": {
            "id": "111210720",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "几位，我想麻烦你们继续追查线索。咱们兵分两路，要是途中没有碰面，就于明晚在望舒客栈汇合。",
            "nextDialogs": [
              "111210721"
            ]
          },
          "111210721": {
            "id": "111210721",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "也好。",
            "nextDialogs": [
              "111210722"
            ]
          },
          "111210722": {
            "id": "111210722",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "那我就和兄弟们先走一步了！",
            "nextDialogs": [
              "111210723"
            ]
          },
          "111210723": {
            "id": "111210723",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在的情况是，我们继续调查，他们去附近的住户那里打听消息，对吧？",
            "nextDialogs": [
              "111210724"
            ]
          },
          "111210724": {
            "id": "111210724",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "没错。",
            "nextDialogs": [
              "111210725"
            ]
          },
          "111210725": {
            "id": "111210725",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是，矿区内没有更多线索了…我们是不是应该往北方追？",
            "nextDialogs": [
              "111210726"
            ]
          },
          "111210726": {
            "id": "111210726",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "等等，少了一个人。",
            "nextDialogs": [
              "111210727"
            ]
          },
          "111210727": {
            "id": "111210727",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎？",
            "nextDialogs": [
              "111210728"
            ]
          },
          "111210728": {
            "id": "111210728",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，小昆这家伙，多半还在调查。去叫他吧！"
          }
        }
      }
    },
    {
      "subId": "1112108",
      "subQuestName": "寻找昆钧",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210801"
        ],
        "dialogs": {
          "111210801": {
            "id": "111210801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小昆，你还在这里找什么呀？线索都查得差不多，该出发啦！",
            "nextDialogs": [
              "111210802"
            ]
          },
          "111210802": {
            "id": "111210802",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "啊，抱歉，我这是私事，还在找一种名为「镇龙石」的玉石。",
            "nextDialogs": [
              "111210803"
            ]
          },
          "111210803": {
            "id": "111210803",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "「镇龙石」？",
            "nextDialogs": [
              "111210806"
            ]
          },
          "111210806": {
            "id": "111210806",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "镇龙石一般用于锻造业，你找这个有什么用？",
            "nextDialogs": [
              "111210807"
            ]
          },
          "111210807": {
            "id": "111210807",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "我…我不知道。",
            "nextDialogs": [
              "111210808"
            ]
          },
          "111210808": {
            "id": "111210808",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "抱歉，我说不清原因…这几天我一直浑浑噩噩，除了名字和家里住址之外，什么都想不起来。",
            "nextDialogs": [
              "111210809"
            ]
          },
          "111210809": {
            "id": "111210809",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "说实话，我一直觉得很焦虑，似乎有什么事还没做就被我忘记了。想不起来，好难受…",
            "nextDialogs": [
              "111210810"
            ]
          },
          "111210810": {
            "id": "111210810",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，我懂这种感觉呢！知道自己忘了一件事，却想不起具体是什么事。",
            "nextDialogs": [
              "111210811"
            ]
          },
          "111210811": {
            "id": "111210811",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "唉，我也不知道该去哪儿，只好到处乱逛。那天走过集市进去转了转，买东西时听见有人聊天，隐约提到「镇龙石」。",
            "nextDialogs": [
              "111210812"
            ]
          },
          "111210812": {
            "id": "111210812",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "这三个字特别耳熟，就好像我要做的事跟那种石头有关系似的…所以，我就想找一块来看看。",
            "nextDialogs": [
              "111210813"
            ]
          },
          "111210813": {
            "id": "111210813",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "或许把石头拿在手里，就能顺着想起自己要干什么了吧。",
            "nextDialogs": [
              "111210814"
            ]
          },
          "111210814": {
            "id": "111210814",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "原来如此…此行途中若有机会，我也会帮着寻找这种石头。",
            "nextDialogs": [
              "111210815"
            ]
          },
          "111210815": {
            "id": "111210815",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "真的吗？谢谢钟离先生，你真好！",
            "nextDialogs": [
              "111210816"
            ]
          },
          "111210816": {
            "id": "111210816",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "举手之劳，不足挂齿。",
            "nextDialogs": [
              "111210817"
            ]
          },
          "111210817": {
            "id": "111210817",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要出发了吗？",
            "nextDialogs": [
              "111210818"
            ]
          },
          "111210818": {
            "id": "111210818",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "从层岩巨渊往北，会抵达灵矩关。如果他们选择这条路线，沿途一定会留下痕迹。",
            "nextDialogs": [
              "111210819"
            ]
          },
          "111210819": {
            "id": "111210819",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好，快去看看吧！"
          }
        }
      }
    },
    {
      "subId": "1112109",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111210901"
        ],
        "dialogs": {
          "111210901": {
            "id": "111210901",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "我就在这里调查好了，分头行动效率也会高一些。",
            "nextDialogs": [
              "111210902"
            ]
          },
          "111210902": {
            "id": "111210902",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "唔…先从细致观察做起吧…看看附近的石头，嗯嗯…"
          }
        }
      }
    },
    {
      "subId": "1112110",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111211001"
        ],
        "dialogs": {
          "111211001": {
            "id": "111211001",
            "speakerId": 10424,
            "speakerName": "观察石块",
            "text": "（看起来…可能是石珀的一种？）",
            "nextDialogs": [
              "111211002"
            ]
          },
          "111211002": {
            "id": "111211002",
            "speakerId": 10424,
            "speakerName": "观察石块",
            "text": "（竟然能记录下我们需要的信息，真是神奇的石头啊。）"
          }
        }
      }
    },
    {
      "subId": "1112121",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111212101"
        ],
        "dialogs": {
          "111212101": {
            "id": "111212101",
            "speakerId": 10377,
            "speakerName": "老戴",
            "text": "调查的事就有劳各位了。"
          }
        }
      }
    },
    {
      "subId": "1112122",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111212201"
        ],
        "dialogs": {
          "111212201": {
            "id": "111212201",
            "speakerId": 10376,
            "speakerName": "昆钧",
            "text": "难道说，是那个孩子把他们带走了？唔…"
          }
        }
      }
    },
    {
      "subId": "1112123",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111212301"
        ],
        "dialogs": {
          "111212301": {
            "id": "111212301",
            "speakerId": 10378,
            "speakerName": "阿虎",
            "text": "兄弟们到底去哪儿了…唉，真吓人。"
          }
        }
      }
    },
    {
      "subId": "1112199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111219901"
        ],
        "dialogs": {
          "111219901": {
            "id": "111219901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "查了不少线索，该去找老戴汇报啦。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "4007213",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400721301"
        ],
        "dialogs": {
          "400721301": {
            "id": "400721301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又回来了。",
            "nextDialogs": [
              "400721302"
            ]
          },
          "400721302": {
            "id": "400721302",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "刚才，我们似乎不小心窥见了邪龙的真面目。",
            "nextDialogs": [
              "400721303"
            ]
          },
          "400721303": {
            "id": "400721303",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "唉，这种事我可太有体会了，总有人觉得我们的爱好是浪费时间。",
            "nextDialogs": [
              "400721304"
            ]
          },
          "400721304": {
            "id": "400721304",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "嗯？你…",
            "nextDialogs": [
              "400721305"
            ]
          },
          "400721305": {
            "id": "400721305",
            "speakerId": 12629,
            "speakerName": "阿诺德",
            "text": "我是「渴望被问路的阿诺德」。",
            "nextDialogs": [
              "400721306"
            ]
          },
          "400721306": {
            "id": "400721306",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我的意思是，你怎么又来了？",
            "nextDialogs": [
              "400721307"
            ]
          },
          "400721307": {
            "id": "400721307",
            "speakerId": 12629,
            "speakerName": "阿诺德",
            "text": "噢，噢，我猜，你们应该会找《圣国的咏唱》第三卷。",
            "nextDialogs": [
              "400721308"
            ]
          },
          "400721308": {
            "id": "400721308",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "还真是让你猜对了…",
            "nextDialogs": [
              "400721309"
            ]
          },
          "400721309": {
            "id": "400721309",
            "speakerId": 12629,
            "speakerName": "阿诺德",
            "text": "亲爱的女士，您不必为我做任何事。您的美丽，就是对我最大的褒奖。我将在此献上您所追寻的答案。",
            "nextDialogs": [
              "400721310"
            ]
          },
          "400721310": {
            "id": "400721310",
            "speakerId": 12629,
            "speakerName": "阿诺德",
            "text": "圣典第三卷，位于王城顶楼。",
            "nextDialogs": [
              "400721311"
            ]
          },
          "400721311": {
            "id": "400721311",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "有什么安保措施吗？",
            "nextDialogs": [
              "400721312"
            ]
          },
          "400721312": {
            "id": "400721312",
            "speakerId": 12629,
            "speakerName": "阿诺德",
            "text": "噢，噢当然了先生，您在说什么傻话？任何国家都不会将最重要的书暴露在荒野上。",
            "nextDialogs": [
              "400721313"
            ]
          },
          "400721313": {
            "id": "400721313",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "也就是说，那边依然会有夜鸦护卫。",
            "nextDialogs": [
              "400721314"
            ]
          },
          "400721314": {
            "id": "400721314",
            "speakerId": 12629,
            "speakerName": "阿诺德",
            "text": "看守圣典是臣民无上的荣耀。但没关系，相信这位女士只是想阅读圣典而已。",
            "nextDialogs": [
              "400721315"
            ]
          },
          "400721315": {
            "id": "400721315",
            "speakerId": 12629,
            "speakerName": "阿诺德",
            "text": "您的面容如此迷人，且富有智慧。您的同伴也像是英雄，如果是诸位，应该能读懂我们圣典中的故事。",
            "nextDialogs": [
              "400721316"
            ]
          },
          "400721316": {
            "id": "400721316",
            "speakerId": 12629,
            "speakerName": "阿诺德",

      }
    },
    {
      "subId": "4007204",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400720401"
        ],
        "dialogs": {
          "400720401": {
            "id": "400720401",
            "speakerId": 12674,
            "speakerName": "旁白",
            "text": "「然而，幽夜净土迎来连续如噩梦的阴霾。邪龙塔斯拉克潜入地下，越过海底，游走至王城之上。」",
            "nextDialogs": [
              "400720402"
            ]
          },
          "400720402": {
            "id": "400720402",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "欸？有龙吗？我觉得只有天气变阴了啊。",
            "nextDialogs": [
              "400720403"
            ]
          },
          "400720403": {
            "id": "400720403",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "龙…会不会是种比喻？",
            "nextDialogs": [
              "400720404"
            ]
          },
          "400720404": {
            "id": "400720404",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "是吗…不认可她、反驳她幻想的一切，共同构筑成了她的宿敌，「邪龙塔斯拉克」。"
          }
        }
      }
    },

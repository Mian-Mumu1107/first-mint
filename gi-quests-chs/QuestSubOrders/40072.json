  "subQuests": [
    {
      "subId": "4007202",
      "subQuestName": "寻找《圣国的咏唱》第二卷",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400720201"
        ],
        "dialogs": {
          "400720201": {
            "id": "400720201",
            "speakerId": 12630,
            "speakerName": "神情严肃的夜鸦",
            "text": "站住，什么人！",
            "nextDialogs": [
              "400720202"
            ]
          },
          "400720202": {
            "id": "400720202",
            "speakerId": 12631,
            "speakerName": "眼神凛冽的夜鸦",
            "text": "看你们的样子，不是幽夜净土臣民吧？说！来这里做什么！",
            "nextDialogs": [
              "400720203"
            ]
          },
          "400720203": {
            "id": "400720203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "竟然有守卫！",
            "nextDialogs": [
              "400720204"
            ]
          },
          "400720204": {
            "id": "400720204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不必慌张。",
            "nextDialogs": [
              "400720205"
            ]
          },
          "400720205": {
            "id": "400720205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你干什么？",
            "nextDialogs": [
              "400720206"
            ]
          },
          "400720206": {
            "id": "400720206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们是皇女殿下的家臣。",
            "nextDialogs": [
              "400720207"
            ]
          },
          "400720207": {
            "id": "400720207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "穿越星海而来之人。",
            "nextDialogs": [
              "400720208"
            ]
          },
          "400720208": {
            "id": "400720208",
            "speakerId": 12630,
            "speakerName": "神情严肃的夜鸦",
            "text": "你如何证明自己是殿下的家臣？",
            "nextDialogs": [
              "400720209"
            ]
          },
          "400720209": {
            "id": "400720209",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "哼，问出如此狂妄的问题，正说明你们眼光浅薄。",
            "nextDialogs": [
              "400720210"
            ]
          },
          "400720210": {
            "id": "400720210",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "「令我的子民自由，不囿于古老法则。」",
            "nextDialogs": [
              "400720211"
            ]
          },
          "400720211": {
            "id": "400720211",
            "speakerId": 12631,
            "speakerName": "眼神凛冽的夜鸦",
            "text": "是、是幽夜净土的口令！他们真的是殿下的臣子！",
            "nextDialogs": [
              "400720212"
            ]
          },
          "400720212": {
            "id": "400720212",
            "speakerId": 12630,
            "speakerName": "神情严肃的夜鸦",
            "text": "天哪，我、我僭越了！各位，请原谅我们…",
            "nextDialogs": [
              "400720213"
            ]
          },
          "400720213": {
            "id": "400720213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "知错了还不快退下？",
            "nextDialogs": [
              "400720214"
            ]
          },
          "400720214": {
            "id": "400720214",
            "speakerId": 12630,
            "speakerName": "神情严肃的夜鸦",
            "text": "是是，属下这就离开…",
            "nextDialogs": [
              "400720215"
            ]
          },
          "400720215": {
            "id": "400720215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们走啦。",
            "nextDialogs": [
              "400720216"
            ]
          },
          "400720216": {
            "id": "400720216",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "这就是《圣国的咏唱》第二卷。各位，准备好了吗？",
            "nextDialogs": [
              "400720217"
            ]
          },
          "400720217": {
            "id": "400720217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "出发！"
          }
        }
      }
    },

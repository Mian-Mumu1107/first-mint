    {
      "subId": "4007210",
      "subQuestName": "寻找声音的来源",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400721001"
        ],
        "dialogs": {
          "400721001": {
            "id": "400721001",
            "speakerId": 12626,
            "speakerName": "莱昂",
            "text": "太好了，有人…欸？又是你们几位？",
            "nextDialogs": [
              "400721002"
            ]
          },
          "400721002": {
            "id": "400721002",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "这话应该我们说吧，怎么又是你？"
          }
        }
      }
    },
    {
      "subId": "4007214",
      "subQuestName": "解救莱昂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4007218",
      "subQuestName": "与莱昂对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400721801"
        ],
        "dialogs": {
          "400721801": {
            "id": "400721801",
            "speakerId": 12626,
            "speakerName": "莱昂",
            "text": "让几位反复看见我狼狈的模样，实在抱歉。果然，以我现在的实力，要扮演合格的夜鸦骑士还太早了…",
            "nextDialogs": [
              "400721802"
            ]
          },
          "400721802": {
            "id": "400721802",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "扮演？",
            "nextDialogs": [
              "400721803"
            ]
          },
          "400721803": {
            "id": "400721803",
            "speakerId": 12626,
            "speakerName": "莱昂",
            "text": "说来惭愧，我并非真正的骑士，而是最近刚找到新工作，预备在戏团中扮演骑士一角的新人演员！",
            "nextDialogs": [
              "400721804"
            ]
          },
          "400721804": {
            "id": "400721804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种事有什么好骄傲的嘛。",
            "nextDialogs": [
              "400721805"
            ]
          },
          "400721805": {
            "id": "400721805",
            "speakerId": 12626,
            "speakerName": "莱昂",
            "text": "不不，各位有所不知。在幽夜净土，戏剧是非常重要的文化。好的演出，是对皇女殿下最大的报答。",
            "nextDialogs": [
              "400721806"
            ]
          },
          "400721806": {
            "id": "400721806",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "哦哦，就是说，这是你们的本土文化了？",
            "nextDialogs": [
              "400721807"
            ]
          },
          "400721807": {
            "id": "400721807",
            "speakerId": 12626,
            "speakerName": "莱昂",
            "text": "正是！因此，我很高兴自己能出演骑士。",
            "nextDialogs": [
              "400721808"
            ]
          },
          "400721808": {
            "id": "400721808",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "你们的皇女殿下为什么喜欢戏剧？",
            "nextDialogs": [
              "400721809"
            ]
          },
          "400721809": {
            "id": "400721809",
            "speakerId": 12626,
            "speakerName": "莱昂",
            "text": "皇女殿下曾说过，「为本皇女献上庆典，到旷野中演出戏剧。向我叩拜，向我献上纯净之幻梦以换取永夜荣光。」",
            "nextDialogs": [
              "400721810"
            ]
          },
          "400721810": {
            "id": "400721810",
            "speakerId": 12626,
            "speakerName": "莱昂",
            "text": "我想，一定是因为皇女殿下懂得真正的艺术，又能分辨人性最深处暗藏的喜怒哀乐吧。",
            "nextDialogs": [
              "400721811"
            ]
          },
          "400721811": {
            "id": "400721811",
            "speakerId": 12626,
            "speakerName": "莱昂",
            "text": "戏剧的灵魂，在于感情的凝聚与升华。读懂戏剧的人，都有一颗敏感又情绪丰富的美丽之心。",
            "nextDialogs": [
              "400721812"
            ]
          },
          "400721812": {
            "id": "400721812",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "…原来是这样。",
            "nextDialogs": [
              "400721813"
            ]
          },
          "400721813": {
            "id": "400721813",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "感谢你的回答，骑士先生。",
            "nextDialogs": [
              "400721814"
            ]
          },
          "400721814": {
            "id": "400721814",
            "speakerId": 12626,
            "speakerName": "莱昂",
            "text": "噢、噢噢！您…您竟然愿意称我为骑士，万分感谢！",
            "nextDialogs": [
              "400721815"
            ]
          },
          "400721815": {
            "id": "400721815",
            "speakerId": 12626,
            "speakerName": "莱昂",
            "text": "那么，带着这份荣光，我将奔赴我的战场了。各位，有缘再会！",
            "nextDialogs": [
              "400721816"
            ]
          },
          "400721816": {
            "id": "400721816",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别再会了，下次注意安全！",
            "nextDialogs": [
              "400721817"
            ]
          },
          "400721817": {
            "id": "400721817",
            "speakerId": 12626,
            "speakerName": "莱昂",
            "text": "啊对，请记住开门的口令：「听我命令，振翅起航」。"
          }
        }
      }
    },

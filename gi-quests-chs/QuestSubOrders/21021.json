    {
      "subId": "2102125",
      "subQuestName": "前往轻策庄，向村民们询问与碎片相关的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210212501"
        ],
        "dialogs": {
          "210212501": {
            "id": "210212501",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "你好，欢迎来到轻策庄，请问有什么事吗？",
            "nextDialogs": [
              "210212502"
            ]
          },
          "210212502": {
            "id": "210212502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您好。",
            "nextDialogs": [
              "210212503"
            ]
          },
          "210212503": {
            "id": "210212503",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "在一个瀑布的后面，找到了一个密室？",
            "nextDialogs": [
              "210212504"
            ]
          },
          "210212504": {
            "id": "210212504",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "你们在里面…发现什么了吗？",
            "nextDialogs": [
              "210212506",
              "210212508"
            ]
          },
          "210212506": {
            "id": "210212506",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "没什么特别的…好啊，好啊…没什么特别的最好…",
            "nextDialogs": [
              "210212511"
            ]
          },
          "210212511": {
            "id": "210212511",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "呵呵，我看你们这个孩子，灰头土脸的…也准是在里面好好折腾了一顿。",
            "nextDialogs": [
              "210212512"
            ]
          },
          "210212512": {
            "id": "210212512",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "来，这些拿着，去买点好吃的，休息休息。"
          },
          "210212508": {
            "id": "210212508",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "盗宝团？你们把他们全都赶走了？",
            "nextDialogs": [
              "210212509"
            ]
          },
          "210212509": {
            "id": "210212509",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "这群不成器的毛贼，成天偷鸡摸狗的，实在烦人，让他们吃点教训也好。",
            "nextDialogs": [
              "210212510"
            ]
          },
          "210212510": {
            "id": "210212510",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "里面…没什么特别的？好啊，好啊…没什么特别的最好…"
          }
        }
      }
    },
    {
      "subId": "2102120",
      "subQuestName": "前往「遗迹」寻找碎片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210212001"
        ],
        "dialogs": {
          "210212001": {
            "id": "210212001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…完全看不懂呢。",
            "nextDialogs": [
              "210212002"
            ]
          },
          "210212002": {
            "id": "210212002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是画吗？还是铭文，或者是其他东西…",
            "nextDialogs": [
              "210212003"
            ]
          },
          "210212003": {
            "id": "210212003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说不定，本地人会知道上面记录了什么。",
            "nextDialogs": [
              "210212004"
            ]
          },
          "210212004": {
            "id": "210212004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们去轻策庄里问问看吧。"
          }
        }
      }
    },
    {
      "subId": "2102121",
      "subQuestName": "前往轻策庄的「最高处」寻找碎片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210212101"
        ],
        "dialogs": {
          "210212101": {
            "id": "210212101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样子就有三枚碎片了，好像能拼起来…",
            "nextDialogs": [
              "210212102"
            ]
          },
          "210212102": {
            "id": "210212102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…拼起来之后，也看不懂上面是什么意思。",
            "nextDialogs": [
              "210212103"
            ]
          },
          "210212103": {
            "id": "210212103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "果然还是要去找本地人问问看吗…"
          }
        }
      }
    },
    {
      "subId": "2102122",
      "subQuestName": "沿着「岩尊像」寻找碎片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210212201"
        ],
        "dialogs": {
          "210212201": {
            "id": "210212201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼，这样就结束了吧…可是，可是「宝器」和「遗骸」都不见踪影。",
            "nextDialogs": [
              "210212202"
            ]
          },
          "210212202": {
            "id": "210212202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么大一片地方，总不可能真的什么都没有吧，而且我们还费了这么大的力气…",
            "nextDialogs": [
              "210212203"
            ]
          },
          "210212203": {
            "id": "210212203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…不然，我们再到处找找看吧？"
          }
        }
      }
    },

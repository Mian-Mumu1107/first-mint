    {
      "subId": "2102114",
      "subQuestName": "在「密藏」中搜索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210211401"
        ],
        "dialogs": {
          "210211401": {
            "id": "210211401",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "你们回来了，怎么样，有什么发现吗？",
            "nextDialogs": [
              "210211403",
              "210211407"
            ]
          },
          "210211403": {
            "id": "210211403",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "哈哈哈，好，好，没关系，没关系，年轻人多跑跑没坏处。",
            "nextDialogs": [
              "210211404"
            ]
          },
          "210211404": {
            "id": "210211404",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "来，这些给你们，跑了这么久，拿去买点好吃的，休息休息吧。",
            "nextDialogs": [
              "210211405"
            ]
          },
          "210211405": {
            "id": "210211405",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "什么都没有，什么都没有…好啊，好啊…"
          },
          "210211407": {
            "id": "210211407",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "",
            "nextDialogs": [
              "210211408"
            ]
          },
          "210211408": {
            "id": "210211408",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "这群不成器的毛贼，成天偷鸡摸狗的，实在烦人，让他们吃点教训也好。",
            "nextDialogs": [
              "210211409"
            ]
          },
          "210211409": {
            "id": "210211409",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "里面…什么也没有？哈哈哈，没关系，没关系，年轻人多跑跑没坏处。",
            "nextDialogs": [
              "210211410"
            ]
          },
          "210211410": {
            "id": "210211410",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "来，这些给你们，跑了这么久，拿去买点好吃的，休息休息吧。",
            "nextDialogs": [
              "210211411"
            ]
          },
          "210211411": {
            "id": "210211411",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "什么都没有，什么都没有…好啊，好啊…"
          }
        }
      }
    },
    {
      "subId": "2102126",
      "subQuestName": "搜索宝藏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210212601"
        ],
        "dialogs": {
          "210212601": {
            "id": "210212601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好难读的三段话…不过，里面说「镇之以螭木，其数为三」…",
            "nextDialogs": [
              "210212602"
            ]
          },
          "210212602": {
            "id": "210212602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "螭木…唔，难道是在说<color=#00E1FFFF>某种树</color>吗？",
            "nextDialogs": [
              "210212603"
            ]
          },
          "210212603": {
            "id": "210212603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们四处找找，留意一下周围的<color=#00E1FFFF>树</color>吧，说不定能找到什么线索。"
          }
        }
      }
    },

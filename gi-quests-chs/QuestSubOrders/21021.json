    {
      "subId": "2102104",
      "subQuestName": "在轻策地区寻找碎片$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210210401"
        ],
        "dialogs": {
          "210210401": {
            "id": "210210401",
            "speakerId": 20047,
            "speakerName": "残缺的文字",
            "text": "「…帝君伏螭，然其身不全死，故渐次镇之，束其神于<color=#00E1FFFF>正北</color>，钉其骨于<color=#00E1FFFF>东南</color>，锁其身于<color=#00E1FFFF>西北</color>，缚其魂于<color=#00E1FFFF>东北</color>，压其形于<color=#00E1FFFF>西南</color>…」"
          }
        }
      }
    },
    {
      "subId": "2102105",
      "subQuestName": "在轻策地区寻找碎片$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210210501"
        ],
        "dialogs": {
          "210210501": {
            "id": "210210501",
            "speakerId": 20047,
            "speakerName": "残缺的文字",
            "text": "「…其骨已销，其神已失，其形已灭，其魂已灭…其身仍存…」",
            "nextDialogs": [
              "210210502"
            ]
          },
          "210210502": {
            "id": "210210502",
            "speakerId": 20047,
            "speakerName": "残缺的文字",
            "text": "「…置此尊像，<color=#00E1FFFF>遥望四方</color>…<color=#00E1FFFF>狂风隔蔽之墟</color>、<color=#00E1FFFF>冰雪不化之峰</color>、<color=#00E1FFFF>绝云隐仙之地</color>、<color=#00E1FFFF>璃月众人之城</color>…」"
          }
        }
      }
    },

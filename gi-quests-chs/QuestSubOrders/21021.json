    {
      "subId": "2102199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210219901"
        ],
        "dialogs": {
          "210219901": {
            "id": "210219901",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "…没想到，还能看见这东西。",
            "nextDialogs": [
              "210219902"
            ]
          },
          "210219902": {
            "id": "210219902",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "罢了，罢了，也算是缘分到了吧…",
            "nextDialogs": [
              "210219904",
              "210219909"
            ]
          },
          "210219904": {
            "id": "210219904",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "你们是记不清了吗？也是啊，絮絮叨叨一大堆，太难记了。",
            "nextDialogs": [
              "210219905"
            ]
          },
          "210219905": {
            "id": "210219905",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "如果你们想要找到有关于那场战斗的碎片，可以先去<color=#00E1FFFF>「高处」</color>碰碰运气。",
            "nextDialogs": [
              "210219906"
            ]
          },
          "210219906": {
            "id": "210219906",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "然后，你们可以再去<color=#00E1FFFF>西边</color>，沿着<color=#00E1FFFF>「岩尊像」</color>仔细看看。",
            "nextDialogs": [
              "210219907"
            ]
          },
          "210219907": {
            "id": "210219907",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "最后，再留意一下周围的<color=#00E1FFFF>「遗迹」</color>吧。"
          },
          "210219909": {
            "id": "210219909",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "知道？哈哈哈，谈不上「知道」。",
            "nextDialogs": [
              "210219910"
            ]
          },
          "210219910": {
            "id": "210219910",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "只不过年纪大了点，见识多了点，记性好了点。勉强记得些老掉牙的东西",
            "nextDialogs": [
              "210219911"
            ]
          },
          "210219911": {
            "id": "210219911",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "在我那个年代啊，岩王爷镇压「螭」的故事，可是人尽皆知啊。",
            "nextDialogs": [
              "210219912"
            ]
          },
          "210219912": {
            "id": "210219912",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "不过，还有人说，连岩王爷都不能把「螭」彻底消灭，只能用「岩尊像」把它镇压在这里，慢慢把他磨灭。",
            "nextDialogs": [
              "210219913"
            ]
          },
          "210219913": {
            "id": "210219913",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "哈哈哈，不过啊，这也只是传说，假如「螭」真的还活着，那咱们这轻策庄，可就不得安稳喽。"
          }
        }
      }
    }
  ]

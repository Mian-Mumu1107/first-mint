    {
      "subId": "7620601",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762060101"
        ],
        "dialogs": {
          "762060101": {
            "id": "762060101",
            "speakerId": 1839,
            "speakerName": "卡斯蒂廖内",
            "text": "狩野啊，你屏风还没画完就别到处乱窜了，先想想你的瀑布怎么画吧。看在厄歌莉娅的份上，哪有人用散点透视画瀑布的…",
            "nextDialogs": [
              "762060102"
            ]
          },
          "762060102": {
            "id": "762060102",
            "speakerId": 1839,
            "speakerName": "卡斯蒂廖内",
            "text": "…嗯？啊，抱歉，原来是陌生的朋友啊。听脚步声我还以为是狩野呢。",
            "nextDialogs": [
              "762060103"
            ]
          },
          "762060103": {
            "id": "762060103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在这里做什么？",
            "nextDialogs": [
              "762060104"
            ]
          },
          "762060104": {
            "id": "762060104",
            "speakerId": 1839,
            "speakerName": "卡斯蒂廖内",
            "text": "如您所见，我在作画。",
            "nextDialogs": [
              "762060105"
            ]
          },
          "762060105": {
            "id": "762060105",
            "speakerId": 1839,
            "speakerName": "卡斯蒂廖内",
            "text": "为了避免您误会，请让我先和您说清楚。虽然我擅长画动物，但我画的动物不是用来吃的。",
            "nextDialogs": [
              "762060106"
            ]
          },
          "762060106": {
            "id": "762060106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，原来能吃吗？！",
            "nextDialogs": [
              "762060107"
            ]
          },
          "762060107": {
            "id": "762060107",
            "speakerId": 1839,
            "speakerName": "卡斯蒂廖内",
            "text": "画中人是眼前人，画中兽自然也能是盘中兽…唉，虽说如此，还是希望您不要像璃月的那位妌癸女士一样，只缠着我画鱼肉。",
            "nextDialogs": [
              "762060108"
            ]
          },
          "762060108": {
            "id": "762060108",
            "speakerId": 1839,
            "speakerName": "卡斯蒂廖内",
            "text": "艺术——可敬的艺术！无论时代，其主旨应当是人类灵魂的救赎、情操的陶冶，以真、善、美指引我等，通往更高的精神境界。",
            "nextDialogs": [
              "762060109"
            ]
          },
          "762060109": {
            "id": "762060109",
            "speakerId": 1839,
            "speakerName": "卡斯蒂廖内",
            "text": "举例来说，登临山峰的最高处，所见的风景自然真实无阻。我所追求的艺术也是如此。",
            "nextDialogs": [
              "762060110"
            ]
          },
          "762060110": {
            "id": "762060110",
            "speakerId": 1839,
            "speakerName": "卡斯蒂廖内",
            "text": "嗯…只是像这样说的话，您也许没有办法直观理解。这样吧，我给您画个浮台，您上去体验一番便是。"
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "7611001",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761100101"
        ],
        "dialogs": {
          "761100101": {
            "id": "761100101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "托尔芬！你怎么在这里？",
            "nextDialogs": [
              "761100102"
            ]
          },
          "761100102": {
            "id": "761100102",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "真巧啊，两位，我正等你们呢。",
            "nextDialogs": [
              "761100103"
            ]
          },
          "761100103": {
            "id": "761100103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你怎么知道我们要来？难、难道是自从蓝珀湖分别之后你就一直在跟踪我们…",
            "nextDialogs": [
              "761100104"
            ]
          },
          "761100104": {
            "id": "761100104",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "哈哈，说在等你们只是玩笑话。我是回来探亲，在皮拉米达城有些琐事要办，正巧看到两位就来打个招呼。",
            "nextDialogs": [
              "761100105"
            ]
          },
          "761100105": {
            "id": "761100105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来如此…欸？你有家人住在这里？",
            "nextDialogs": [
              "761100106"
            ]
          },
          "761100106": {
            "id": "761100106",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "我有家人是什么怪事吗？就像乌鸦自然是乌鸦的孩子，不会是凭空变出来的。",
            "nextDialogs": [
              "761100107"
            ]
          },
          "761100107": {
            "id": "761100107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我不是问这个啦！唔…仔细想想，我们也不是很熟，打听这种事确实有些失礼…",
            "nextDialogs": [
              "761100108"
            ]
          },
          "761100108": {
            "id": "761100108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就打听一下不失礼的事好了。",
            "nextDialogs": [
              "761100109"
            ]
          },
          "761100109": {
            "id": "761100109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦！托尔芬消息灵通，说不定手上有什么线索呢。",
            "nextDialogs": [
              "761100110"
            ]
          },
          "761100110": {
            "id": "761100110",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "讲述了此前在蓝珀湖之外，于各处寻得「识者之证」的经历…",
            "nextDialogs": [
              "761100111"
            ]
          },
          "761100111": {
            "id": "761100111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以托尔芬知道吗？最后一个「识者之证」的线索。",
            "nextDialogs": [
              "761100112"
            ]
          },
          "761100112": {
            "id": "761100112",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "我确实有些头绪，不过…",
            "nextDialogs": [
              "761100113"
            ]
          },
          "761100113": {
            "id": "761100113",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "#嗯，如果是{NICKNAME}的话应该没问题吧。你在各处活跃的消息我也听闻了不少，相信你能通过考验。",
            "nextDialogs": [
              "761100115",
              "761100117"
            ]
          },
          "761100115": {
            "id": "761100115",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "#怎么会呢，不管怎么说，我对{NICKNAME}的实力是很有信心的。",
            "nextDialogs": [
              "761100119"
            ]
          },
          "761100119": {
            "id": "761100119",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "说回正事，这最后一个「识者之证」其实就在我的祖母手上，正好我要去探望她，两位不妨与我同行，如何？",
            "nextDialogs": [
              "761100120"
            ]
          },
          "761100120": {
            "id": "761100120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#居然是这样，真的好巧喔！托尔芬的祖母…{NICKNAME}，你说她会是什么样的人呢？会不会是喜欢讲故事的老奶奶呀？",
            "nextDialogs": [
              "761100121"
            ]
          },
          "761100121": {
            "id": "761100121",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "她的确会讲故事，不过嘛…算了，待会儿见面就知道了，我们走吧。"
          },
          "761100117": {
            "id": "761100117",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "这个嘛，现在我们能在此地相遇想必也代表我们之间有着不同寻常的缘分，与其追计过去，不如放眼未来…",
            "nextDialogs": [
              "761100118"
            ]
          },
          "761100118": {
            "id": "761100118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你这转移话题的方式也太生硬了吧！"
          }
        }
      }
    },
    {
      "subId": "7611002",
      "subQuestName": "去皮拉米达城寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7611003",
      "subQuestName": "前往托尔芬指定的地方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761100201"
        ],
        "dialogs": {
          "761100201": {
            "id": "761100201",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "臭小子，你还知道回来。我交代的事呢，办好了么？",
            "nextDialogs": [
              "761100202"
            ]
          },
          "761100202": {
            "id": "761100202",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "自然是打点妥当了，不然我怎么敢回来。",
            "nextDialogs": [
              "761100203"
            ]
          },
          "761100203": {
            "id": "761100203",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "咳，这位就是我的祖母，不过我想比起「不成器的游商的祖母」这个身份，她还是更喜欢别人称呼她「黑枪太婆」海捷德。",
            "nextDialogs": [
              "761100205"
            ]
          },
          "761100205": {
            "id": "761100205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好严肃的样子，和托尔芬一点也不像啊…",
            "nextDialogs": [
              "761100207"
            ]
          },
          "761100207": {
            "id": "761100207",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "常有人这么说。不过到底血浓于水，其实我们在性格上有不少相似之处呢。",
            "nextDialogs": [
              "761100208"
            ]
          },
          "761100208": {
            "id": "761100208",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "#这两位是{NICKNAME}和派蒙，{M#他们}{F#她们}已经找到另外四个「识者之证」了…",
            "nextDialogs": [
              "761100209"
            ]
          },
          "761100209": {
            "id": "761100209",
            "speakerId": 22237,
            "speakerName": "海捷德",
            "text": "哦？已经找到了另外四个，那看来的确有些本领。不过这本领真不真，还得让我亲自领教一下。",
            "nextDialogs": [
              "761100210"
            ]
          },
          "761100210": {
            "id": "761100210",
            "speakerId": 22237,
            "speakerName": "海捷德",
            "text": "既然是这小子带来的客人，我也不会为难你们，就简单过几招吧。",
            "nextDialogs": [
              "761100211"
            ]
          },
          "761100211": {
            "id": "761100211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下！这、这不管怎么想都不合适吧…",
            "nextDialogs": [
              "761100212"
            ]
          },
          "761100212": {
            "id": "761100212",
            "speakerId": 22237,
            "speakerName": "海捷德",
            "text": "这有什么不合适的？你们想取「伟大财宝」，当然得先过我这关。",
            "nextDialogs": [
              "761100213"
            ]
          },
          "761100213": {
            "id": "761100213",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "#她老人家顽固得很，不过只要让她认可你的实力，万事好商量。{NICKNAME}，就看你的了。"
          }
        }
      }
    },
    {
      "subId": "7611005",
      "subQuestName": "与「黑枪太婆」切磋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761100501"
        ],
        "dialogs": {
          "761100501": {
            "id": "761100501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，这里提到了「布莱赫」，看起来是他留下的记录呢。",
            "nextDialogs": [
              "761100502"
            ]
          },
          "761100502": {
            "id": "761100502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，原来在以前，铁钱真的就是在这里通行的货币啊…那这堆铁钱堆成的小山，的确可以称得上是「伟大财宝」了。",
            "nextDialogs": [
              "761100503"
            ]
          },
          "761100503": {
            "id": "761100503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃啊，要是早几百年，我们就真的发财了！可是现在铁钱又不比摩拉…",
            "nextDialogs": [
              "761100504"
            ]
          },
          "761100504": {
            "id": "761100504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都说物以稀为贵…",
            "nextDialogs": [
              "761100505"
            ]
          },
          "761100505": {
            "id": "761100505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀，如果能找到这里写的那一枚…铁钱的原型？我猜那个肯定很有收藏价值！说不定能卖个好价钱呢。",
            "nextDialogs": [
              "761100506"
            ]
          },
          "761100506": {
            "id": "761100506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可惜不知道到底埋在哪里了，唉，难道要光靠我们俩，在这一带掘地三尺吗？",
            "nextDialogs": [
              "761100507"
            ]
          },
          "761100507": {
            "id": "761100507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "会被「黑枪太婆」狠狠教训吧。",
            "nextDialogs": [
              "761100508"
            ]
          },
          "761100508": {
            "id": "761100508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#是、是哦…还是不要惹她生气吧，{NICKNAME}能接住她的招式，我就只好能飞多远就飞多远了。",
            "nextDialogs": [
              "761100509"
            ]
          },
          "761100509": {
            "id": "761100509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说到「黑枪太婆」…看到布莱赫留下的手记，还有这一大堆铁钱，也难怪她会想要再现当年的情景。",
            "nextDialogs": [
              "761100510"
            ]
          },
          "761100510": {
            "id": "761100510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对她来说，那时的世界才是乐园吧。",
            "nextDialogs": [
              "761100511"
            ]
          },
          "761100511": {
            "id": "761100511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我是觉得现在这个时代也很好呀，我和{NICKNAME}，还有旅途中结识的那些朋友，大家都生活在这个时代！",
            "nextDialogs": [
              "761100512"
            ]
          },
          "761100512": {
            "id": "761100512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "托尔芬一定也是这么想的吧，所以才不给我们细讲盗宝团的历史，就是为了让我们不用背负这份期待…",
            "nextDialogs": [
              "761100513"
            ]
          },
          "761100513": {
            "id": "761100513",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来这次的冒险就到这里了。唉，集齐五个「识者之证」真的好不容易，虽然也不是完全没有收获，但总觉得差了点什么。",
            "nextDialogs": [
              "761100514"
            ]
          },
          "761100514": {
            "id": "761100514",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说回来，这艘船为什么会在这里呢？",
            "nextDialogs": [
              "761100516",
              "761100518"
            ]
          },
          "761100516": {
            "id": "761100516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要载这么多铁钱航行的确太勉强了…而且会被打劫吧？哦！这是盗宝团的船，要小心的应该是对方啊。",
            "nextDialogs": [
              "761100519"
            ]
          },
          "761100519": {
            "id": "761100519",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好可惜喔，虽然是几百年前的船了，但是看起来还挺新的，要是我们能有一艘这么大的船，旅行也会更轻松吧？",
            "nextDialogs": [
              "761100520"
            ]
          },
          "761100520": {
            "id": "761100520",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我是船长，派蒙就是大副了。",
            "nextDialogs": [
              "761100521"
            ]
          },
          "761100521": {
            "id": "761100521",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是的！船长！你在叫我吗！船长！",
            "nextDialogs": [
              "761100522"
            ]
          },
          "761100522": {
            "id": "761100522",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嘿嘿，我学得像吗？{NICKNAME}，你去把把舵，配合我一下！"
          },
          "761100518": {
            "id": "761100518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那这里就是盗宝团的秘密船坞了！可能是因为过了几百年，地形也变化了，它应该再也没有启航的机会了…"
          }
        }
      }
    },
    {
      "subId": "7611006",
      "subQuestName": "与海捷德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761100301"
        ],
        "dialogs": {
          "761100301": {
            "id": "761100301",
            "speakerId": 22237,
            "speakerName": "海捷德",
            "text": "不错！不错！是个好苗子。喏，这就是「识者之证」。要取到「伟大财宝」，还有最后一段路要走。",
            "nextDialogs": [
              "761100302"
            ]
          },
          "761100302": {
            "id": "761100302",
            "speakerId": 22237,
            "speakerName": "海捷德",
            "text": "#不过{M#小伙子}{F#小姑娘}看着机灵，肯定不成问题。让{M#他}{F#她}来继承盗宝团，总好过你这不出息的小子。",
            "nextDialogs": [
              "761100303"
            ]
          },
          "761100303": {
            "id": "761100303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "继承盗宝团？我吗？",
            "nextDialogs": [
              "761100304"
            ]
          },
          "761100304": {
            "id": "761100304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？原来老奶奶是盗宝团的人？托尔芬也是？",
            "nextDialogs": [
              "761100305"
            ]
          },
          "761100305": {
            "id": "761100305",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "嗯，姑且算是吧。",
            "nextDialogs": [
              "761100306"
            ]
          },
          "761100306": {
            "id": "761100306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#你的打扮一点也不像盗宝团，我都没想到。{NICKNAME}呢，该不会早就知道了吧？",
            "nextDialogs": [
              "761100309"
            ]
          },
          "761100309": {
            "id": "761100309",
            "speakerId": 22237,
            "speakerName": "海捷德",
            "text": "#…小子，莫非你什么都没和{M#他们}{F#她们}讲？你要把「伟大财宝」拱手让给对盗宝团一无所知的人？",
            "nextDialogs": [
              "761100310"
            ]
          },
          "761100310": {
            "id": "761100310",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "#您瞧，{M#他们}{F#她们}既有本事搜集齐「识者之证」，又有能耐接您的招，而且您刚才不也夸{M#他们}{F#她们}…",
            "nextDialogs": [
              "761100311"
            ]
          },
          "761100311": {
            "id": "761100311",
            "speakerId": 22237,
            "speakerName": "海捷德",
            "text": "臭小子…",
            "nextDialogs": [
              "761100312"
            ]
          },
          "761100312": {
            "id": "761100312",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "#好，好！您先别急，我现在就和{M#他们}{F#她们}讲清楚，保管您看中的{NICKNAME}愿意继承盗宝团！",
            "nextDialogs": [
              "761100313"
            ]
          },
          "761100313": {
            "id": "761100313",
            "speakerId": 22237,
            "speakerName": "海捷德",
            "text": "哼，就这么一会儿工夫，你能说清楚、道明白？",
            "nextDialogs": [
              "761100314"
            ]
          },
          "761100314": {
            "id": "761100314",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "这您有什么可担心的？您不是总说我像那不成器的布莱赫么，至少我继承了他口齿伶俐的部分，不是吗？",
            "nextDialogs": [
              "761100315"
            ]
          },
          "761100315": {
            "id": "761100315",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "被托尔芬带到了一旁方便说话的地方…",
            "nextDialogs": [
              "761100316"
            ]
          },
          "761100316": {
            "id": "761100316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以到底是怎么回事？我们只是听说集齐五个「识者之证」就可以找到被藏在月之东，日之西的「伟大财宝」…",
            "nextDialogs": [
              "761100317"
            ]
          },
          "761100317": {
            "id": "761100317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "该不会想要取走雷德·米勒的财宝，还得继承盗宝团才行吧？而且继承盗宝团的说法也很奇怪…",
            "nextDialogs": [
              "761100318"
            ]
          },
          "761100318": {
            "id": "761100318",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很难想象有人能当盗宝团的首领。",
            "nextDialogs": [
              "761100319"
            ]
          },
          "761100319": {
            "id": "761100319",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "毕竟自称盗宝团的人已经遍布提瓦特大陆了。你瞧，问题就在这里。",
            "nextDialogs": [
              "761100320"
            ]
          },
          "761100320": {
            "id": "761100320",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "我们能在这点上达成共识，但我那老顽固的祖母却不行，她还幻想着盗宝团能恢复雷德·米勒在世时的荣光呢。",
            "nextDialogs": [
              "761100321"
            ]
          },
          "761100321": {
            "id": "761100321",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "幻想着有那么一个人物，能够喊出「让死人埋葬死人吧，然后你们站起来，用高傲者的财富，筑起饥贫之人的乐园」的口号。",
            "nextDialogs": [
              "761100322"
            ]
          },
          "761100322": {
            "id": "761100322",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "大多数人只知道雷德·米勒劫富济贫，鲜少有人了解盗宝团也曾为守护乐园而抵御黑渊…",
            "nextDialogs": [
              "761100323"
            ]
          },
          "761100323": {
            "id": "761100323",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "那是属于盗宝团的时代，是最坏的时代，也是最好的时代。",
            "nextDialogs": [
              "761100324"
            ]
          },
          "761100324": {
            "id": "761100324",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "今天或许也一样吧，只是，属于盗宝团的时代已经过去了。总有一天她会接受的。",
            "nextDialogs": [
              "761100325"
            ]
          },
          "761100325": {
            "id": "761100325",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话是这么说…那我们现在该怎么办呢？",
            "nextDialogs": [
              "761100326"
            ]
          },
          "761100326": {
            "id": "761100326",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "#在这之前，我姑且还是问问，{NICKNAME}，你愿意继承盗宝团，继承雷德·米勒的梦想吗？"
          }
        }
      }
    },
    {
      "subId": "7611007",
      "subQuestName": "前往「月之东，日之西」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761100701"
        ],
        "dialogs": {
          "761100701": {
            "id": "761100701",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "哈！原来是这么个「金银岛」，还算名副其实。",
            "nextDialogs": [
              "761100702"
            ]
          },
          "761100702": {
            "id": "761100702",
            "speakerId": 22251,
            "speakerName": "西维",
            "text": "那这次的收获怎么办？还是按老样子么，不过，要带回至冬堡的话…",
            "nextDialogs": [
              "761100703"
            ]
          },
          "761100703": {
            "id": "761100703",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "不如就交给街上的孩子们吧，前几天巡逻的时候遇到的。我看那个带着海螺的孩子机灵得很。",
            "nextDialogs": [
              "761100704"
            ]
          },
          "761100704": {
            "id": "761100704",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "他们知道怎么安全地处理这些宝物，也知道该与谁分享。",
            "nextDialogs": [
              "761100705"
            ]
          },
          "761100705": {
            "id": "761100705",
            "speakerId": 22251,
            "speakerName": "西维",
            "text": "嗯，听你的，就这么办吧。",
            "nextDialogs": [
              "761100706"
            ]
          },
          "761100706": {
            "id": "761100706",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "不过，比起总督宫陈列室里的那些珍宝，这里的这么些零碎东西又算得了什么？",
            "nextDialogs": [
              "761100707"
            ]
          },
          "761100707": {
            "id": "761100707",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "哼…哪怕在这偏乡也不忘穷奢极侈，傲慢的家伙…外表的光鲜也掩盖不了内里早已腐败的事实。",
            "nextDialogs": [
              "761100708"
            ]
          },
          "761100708": {
            "id": "761100708",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "西维，你看到了吧，这里也和至冬堡没什么区别。",
            "nextDialogs": [
              "761100709"
            ]
          },
          "761100709": {
            "id": "761100709",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "我们难道要为了保护这样的人而战斗吗？为了保护他们，去对抗那些我们并不憎恨的人。那些不被看见的，受欺凌和侮辱的…",
            "nextDialogs": [
              "761100710"
            ]
          },
          "761100710": {
            "id": "761100710",
            "speakerId": 22251,
            "speakerName": "西维",
            "text": "我知道，但我们能做的不多。",
            "nextDialogs": [
              "761100711"
            ]
          },
          "761100711": {
            "id": "761100711",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "是「现在」还不多，我们应该改变这一切，从最根本的地方开始。我会向上爬的，无论用怎样的手段…",
            "nextDialogs": [
              "761100712"
            ]
          },
          "761100712": {
            "id": "761100712",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "我不过多了那么一点幸运，才得以与你并肩，西维，但我时常忍不住回望自己来时的路…",
            "nextDialogs": [
              "761100713"
            ]
          },
          "761100713": {
            "id": "761100713",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "那条路上还有我的兄弟，我的姊妹，他们在承受本不应由他们承受的苦难，那些无辜的魂灵，难道天生就该受罪吗？",
            "nextDialogs": [
              "761100714"
            ]
          },
          "761100714": {
            "id": "761100714",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "造成他们苦难的若是律法，那我便要重塑律法，若是腐败贵族，那我就要肃清这些贵族！",
            "nextDialogs": [
              "761100715"
            ]
          },
          "761100715": {
            "id": "761100715",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "总有一天，我要在这片从来就属于我们的土地上建起属于我们的乐园！",
            "nextDialogs": [
              "761100716"
            ]
          },
          "761100716": {
            "id": "761100716",
            "speakerId": 22251,
            "speakerName": "西维",
            "text": "我相信你，雷勒，我相信你能做到。",
            "nextDialogs": [
              "761100717"
            ]
          },
          "761100717": {
            "id": "761100717",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "…先不说这些了。盗亦有道，留下这个吧，也好让总督知道是谁取走了他的宝物。",
            "nextDialogs": [
              "761100718"
            ]
          },
          "761100718": {
            "id": "761100718",
            "speakerId": 22251,
            "speakerName": "西维",
            "text": "可惜不能亲眼看到那时的情景。",
            "nextDialogs": [
              "761100719"
            ]
          },
          "761100719": {
            "id": "761100719",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "是啊，一定是出好戏。"
          }
        }
      }
    },
    {
      "subId": "7611040",
      "subQuestName": "进入藏宝地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7611008",
      "subQuestName": "设法开门离开此间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761100801"
        ],
        "dialogs": {
          "761100801": {
            "id": "761100801",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "#怎么了，{NICKNAME}，还有什么在意的事么？",
            "nextDialogs": [
              "761100803",
              "761100854",
              "761100862",
              "761100865"
            ]
          },
          "761100803": {
            "id": "761100803",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "所谓「雷德·米勒」，说到底只是个用来隐藏真实身份的假名罢了。穷苦人仰慕它，王公们詈骂它，可它甚至不属于同一个人。",
            "nextDialogs": [
              "761100804"
            ]
          },
          "761100804": {
            "id": "761100804",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "仅仅只是与最初的盗宝团有直接关联的「雷德·米勒」，就总共有三位，更别说后世出于种种原因冒用这个名字的人。",
            "nextDialogs": [
              "761100805"
            ]
          },
          "761100805": {
            "id": "761100805",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "就在上个星期，我还遇到过两个自称雷德·米勒的小贼，打算偷走我的竖琴——不过那就是另外的故事了。",
            "nextDialogs": [
              "761100806"
            ]
          },
          "761100806": {
            "id": "761100806",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "#后世的盗名者暂且不论，最初三位的故事，我还是略知一二的。{NICKNAME}在意的，是哪一位雷德·米勒呢？"
          },
          "761100854": {
            "id": "761100854",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "「铁钱」是艾维雷勒安…也就是最初的大盗雷德·米勒发行的货币。",
            "nextDialogs": [
              "761100855"
            ]
          },
          "761100855": {
            "id": "761100855",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "他相信，在没有界限的世界里，在无人忍受饥寒的乐园里，神明所赐予、所掌控的金钱，不该成为人与人互助的基础。",
            "nextDialogs": [
              "761100856"
            ]
          },
          "761100856": {
            "id": "761100856",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "「人」应当是金钱之主，而非其仆役。即使无法成为黄金之心的主人，也该让所有人平等掌控本就属于所有人的财富。",
            "nextDialogs": [
              "761100857"
            ]
          },
          "761100857": {
            "id": "761100857",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "不过，如两位所见，由「人」赋予意义的铁钱，在他死后，很快也被他相信的「人」所遗忘，成为了无用的废铁。",
            "nextDialogs": [
              "761100858"
            ]
          },
          "761100858": {
            "id": "761100858",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "对了，还有一条我从风中听来的消息，未必准确，我也无从查考，两位听听就好。",
            "nextDialogs": [
              "761100859"
            ]
          },
          "761100859": {
            "id": "761100859",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "至冬有一位愚人众执行官，似乎也抱着某种奇怪的执念，希望建立更完美的经济秩序。",
            "nextDialogs": [
              "761100860"
            ]
          },
          "761100860": {
            "id": "761100860",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "只可惜他没有收藏铁钱的癖好，否则这些铁钱全卖给他，估计也是一大笔摩拉吧。"
          },
          "761100862": {
            "id": "761100862",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "第三位雷德·米勒，也就是名为布莱赫之人，留下了「伟大财宝」的传说。",
            "nextDialogs": [
              "761100863"
            ]
          },
          "761100863": {
            "id": "761100863",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "至于他这样做的目的…也许只是为了引诱后世的宝藏猎人，让「雷德·米勒」的名字永远不会被遗忘吧。"
          },
          "761100865": {
            "id": "761100865",
            "speakerId": 21836,
            "speakerName": "托尔芬",
            "text": "嗯，再见。愿两位的旅途如这曲调一般，顺畅而优美。"
          }
        }
      }
    },

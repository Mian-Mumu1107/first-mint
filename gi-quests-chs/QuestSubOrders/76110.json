      }
    },
    {
      "subId": "7611015",
      "subQuestName": "击败魔兽",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761101501"
        ],
        "dialogs": {
          "761101501": {
            "id": "761101501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？欸欸？刚才是怎么回事？",
            "nextDialogs": [
              "761101502"
            ]
          },
          "761101502": {
            "id": "761101502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我们在铁钱堆里发现了盗宝团的船，然后{NICKNAME}握了船舵…之后好像做梦一样，不知不觉就到了这里…",
            "nextDialogs": [
              "761101503"
            ]
          },
          "761101503": {
            "id": "761101503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那两个人…既然提到了「布莱赫」，如果不是同名的话，难道他们都是很久以前的人吗？",
            "nextDialogs": [
              "761101504"
            ]
          },
          "761101504": {
            "id": "761101504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "至少是和这个地方有关系的人。",
            "nextDialogs": [
              "761101505"
            ]
          },
          "761101505": {
            "id": "761101505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦！听他们的说法，这里原来埋了什么宝物，虽然已经被他们拿走了，但他们是不是还往回放了点什么？",
            "nextDialogs": [
              "761101506"
            ]
          },
          "761101506": {
            "id": "761101506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不知道过了这么久，有没有被人挖走…",
            "nextDialogs": [
              "761101507"
            ]
          },
          "761101507": {
            "id": "761101507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先找找看吧。",
            "nextDialogs": [
              "761101508"
            ]
          },
          "761101508": {
            "id": "761101508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，说得也是！如果没记错的话，应该就在那附近吧？",
            "nextDialogs": [
              "761101509"
            ]
          },
          "761101509": {
            "id": "761101509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然还在这里，那个什么总督没来取这里的东西吗？",
            "nextDialogs": [
              "761101510"
            ]
          },
          "761101510": {
            "id": "761101510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这个是他们放的东西？这不是…",
            "nextDialogs": [
              "761101511"
            ]
          },
          "761101511": {
            "id": "761101511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，搞不懂。待会儿问问托尔芬好了…我都快忘了，还有「伟大财宝」的事要告诉他呢。"
          }
        }
      }
    },

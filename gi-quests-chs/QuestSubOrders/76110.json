    {
      "subId": "7611014",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761100401"
        ],
        "dialogs": {
          "761100401": {
            "id": "761100401",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "前面就是「金银岛」了，这么看倒是没什么特别之处。",
            "nextDialogs": [
              "761100402"
            ]
          },
          "761100402": {
            "id": "761100402",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "雷勒，我还是有些担心，这里的宝物是总督已经标记上的，我们要是取了…",
            "nextDialogs": [
              "761100403"
            ]
          },
          "761100403": {
            "id": "761100403",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "别担心，预备演练再过几天就结束了，等总督发现，我们已经在至冬堡了，没人会想到找我们麻烦。",
            "nextDialogs": [
              "761100404"
            ]
          },
          "761100404": {
            "id": "761100404",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我不是担心这个，而是…万一他因为向我们透露了宝物的下落而受到惩罚怎么办？",
            "nextDialogs": [
              "761100405"
            ]
          },
          "761100405": {
            "id": "761100405",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "…他？哦，你说布莱赫那小子。你管他做什么，那「只为少数人而酿的蜜」，他可没少品尝吧。",
            "nextDialogs": [
              "761100406"
            ]
          },
          "761100406": {
            "id": "761100406",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "在这方面，我和他也没什么区别。",
            "nextDialogs": [
              "761100407"
            ]
          },
          "761100407": {
            "id": "761100407",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "说什么呢，西维，你和他不一样。你和他们不是一边的，要不是这样你也不会…",
            "nextDialogs": [
              "761100408"
            ]
          },
          "761100408": {
            "id": "761100408",
            "speakerId": 22252,
            "speakerName": "雷勒",
            "text": "哎！别担心他了，他会没事的。虽说是养子，但毕竟是总督的儿子，而且还那么小，没人会为难他的。",
            "nextDialogs": [
              "761100409"
            ]
          },
          "761100409": {
            "id": "761100409",
            "speakerId": 22251,
            "speakerName": "西维",
            "text": "但愿如此吧。"
          }
        }
      }
    },
    {
      "subId": "7611037",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7611021",
      "subQuestName": "与托尔芬对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761100601"
        ],
        "dialogs": {
          "761100601": {
            "id": "761100601",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "#这不是{NICKNAME}和派蒙么，两位已经取到「伟大财宝」了？",
            "nextDialogs": [
              "761100602"
            ]
          },
          "761100602": {
            "id": "761100602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "如果你是指那堆铁钱…",
            "nextDialogs": [
              "761100603"
            ]
          },
          "761100603": {
            "id": "761100603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "铁钱还在原地…哦，不对，现在在顶上了。",
            "nextDialogs": [
              "761100604"
            ]
          },
          "761100604": {
            "id": "761100604",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "讲述了在藏宝地的经历以及登船之后的奇遇…",
            "nextDialogs": [
              "761100605"
            ]
          },
          "761100605": {
            "id": "761100605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不知道为什么，他们留下了像是鸦印的东西。",
            "nextDialogs": [
              "761100606"
            ]
          },
          "761100606": {
            "id": "761100606",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "看来大地所能记忆的要远比我们想象的更多，作为讲故事的人，真有些汗颜…",
            "nextDialogs": [
              "761100607"
            ]
          },
          "761100607": {
            "id": "761100607",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "毕竟人寿有尽，所以口传的故事往往难免舛讹，有些则终至失落，但大地的记忆想必是忠实的吧。",
            "nextDialogs": [
              "761100608"
            ]
          },
          "761100608": {
            "id": "761100608",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "留下这枚特别的「鸦印」的，应该就是艾维雷勒安了，你们或许更熟悉他的另一个名字：雷德·米勒。",
            "nextDialogs": [
              "761100609"
            ]
          },
          "761100609": {
            "id": "761100609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！那就是传说中的大盗雷德·米勒吗？完全看不出来…",
            "nextDialogs": [
              "761100610"
            ]
          },
          "761100610": {
            "id": "761100610",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "听两位的描述，那多半是盗宝团成立之前的事，据说那时他就常和军事学院的同学扮作侠盗劫富济贫。",
            "nextDialogs": [
              "761100611"
            ]
          },
          "761100611": {
            "id": "761100611",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "说起来，鸦印也是由他那出身贵族的同学的家徽变形而来的。",
            "nextDialogs": [
              "761100612"
            ]
          },
          "761100612": {
            "id": "761100612",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "不过这都是过去的事了，说多了也怕你们嫌烦。只是，既然有特别的缘分，这枚特别的「鸦印」就请两位留下当作纪念吧。",
            "nextDialogs": [
              "761100613"
            ]
          },
          "761100613": {
            "id": "761100613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不会接下它就自动继承了盗宝团吧…",
            "nextDialogs": [
              "761100614"
            ]
          },
          "761100614": {
            "id": "761100614",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "哈哈，不会不会。就像我之前说的，属于盗宝团的时代已经过去了。要说唯一的难处么…",
            "nextDialogs": [
              "761100615"
            ]
          },
          "761100615": {
            "id": "761100615",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "我那顽固的祖母已经认定了你，如果她要同你切磋，还请你不要拒绝，也不要有所保留。",
            "nextDialogs": [
              "761100616"
            ]
          },
          "761100616": {
            "id": "761100616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊，她那么强，完全不像是普通的老人，我们哪敢保留啊。",
            "nextDialogs": [
              "761100617"
            ]
          },
          "761100617": {
            "id": "761100617",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "好啦，埋藏在月之东，日之西的「伟大财宝」被了不起的冒险家取走，这段演出到此也落下了帷幕。",
            "nextDialogs": [
              "761100618"
            ]
          },
          "761100618": {
            "id": "761100618",
            "speakerId": 22236,
            "speakerName": "托尔芬",
            "text": "就让我为两位演奏一曲，祝愿两位今后的旅途，每一段都充满未知，每一程都令人雀跃。"
          }
        }
      }
    },

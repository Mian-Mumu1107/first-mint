      "dialogue": {
        "startDialogs": [
          "731900102"
        ],
        "dialogs": {
          "731900102": {
            "id": "731900102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过时间过去了这么久…就算有藏身的地方，也早就废弃了吧…",
            "nextDialogs": [
              "731900103"
            ]
          },
          "731900103": {
            "id": "731900103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！附近还有图特摩斯在出没，我们小声点！",
            "nextDialogs": [
              "731900104"
            ]
          },
          "731900104": {
            "id": "731900104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，这也就意味着，这里真的很可能有一个秘密据点。而说到秘密据点，就少不了宝藏！",
            "nextDialogs": [
              "731900105"
            ]
          },
          "731900105": {
            "id": "731900105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，索赫尔的笔记里提到，这里的镀金旅团都是突然出现，又突然消失的，感觉有些危险。",
            "nextDialogs": [
              "731900106"
            ]
          },
          "731900106": {
            "id": "731900106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要不，我们先在附近悄悄观察一阵，搞明白这里到底有什么秘密再说！",
            "nextDialogs": [
              "731900108"
            ]
          },
          "731900108": {
            "id": "731900108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，这个箱子里是乱七八糟的杂物和…一块破破烂烂的石板？",
            "nextDialogs": [
              "731900109"
            ]
          },
          "731900109": {
            "id": "731900109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是教令院的学者们知道了这些佣兵把石板随便乱放，一定会气坏的吧。"
          }
        }
      }
    }
  ]

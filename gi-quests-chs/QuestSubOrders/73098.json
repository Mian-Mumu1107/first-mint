          "730980301": {
            "id": "730980301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我看看我看看…嗯？这是兰那罗的画吗…",
            "nextDialogs": [
              "730980302"
            ]
          },
          "730980302": {
            "id": "730980302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "随便翻别人的东西不好…",
            "nextDialogs": [
              "730980303"
            ]
          },
          "730980303": {
            "id": "730980303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是喔？明明，一路上冒险家的营地、遗迹的宝箱什么的，我们都清理过不知道多少回啦！",
            "nextDialogs": [
              "730980304"
            ]
          },
          "730980304": {
            "id": "730980304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…不如这么说吧！这个房子周围没见到兰那罗，我们很担心，所以想看看有没有什么线索。说不定，还能帮助受困的兰那罗呢！",
            "nextDialogs": [
              "730980307"
            ]
          },
          "730980307": {
            "id": "730980307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，那当然！不管怎么说，这幅画看上去…好像是附近的风景，对吧？不得了，说不定是藏宝图…",
            "nextDialogs": [
              "730980308"
            ]
          },
          "730980308": {
            "id": "730980308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们去画出来的地方看看吧！或许真的有兰那罗留下的宝藏呢！"
          }
        }
      }

          "3960001": {
            "id": "3960001",
            "speakerId": 1002,
            "speakerName": "芭芭拉",
            "text": "袭击你们的人…是「愚人众」？真过分…",
            "nextDialogs": [
              "3960002"
            ]
          },
          "3960002": {
            "id": "3960002",
            "speakerId": 1002,
            "speakerName": "芭芭拉",
            "text": "琴团长刚才回骑士团总部了，说是要想办法找出证据。",
            "nextDialogs": [
              "3960003"
            ]
          },
          "3960003": {
            "id": "3960003",
            "speakerId": 1002,
            "speakerName": "芭芭拉",
            "text": "但如果他们没有留下痕迹，骑士团可能也很难对他们提出指控吧…琴团长是这么说的。"
          }
        }

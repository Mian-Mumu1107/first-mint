  "subQuests": [
    {
      "subId": "7165001",
      "subQuestName": "与小雨对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716500101"
        ],
        "dialogs": {
          "716500101": {
            "id": "716500101",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "您好！有兴趣为「总务司」做点事吗？",
            "nextDialogs": [
              "716500102"
            ]
          },
          "716500102": {
            "id": "716500102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "总务司？",
            "nextDialogs": [
              "716500103"
            ]
          },
          "716500103": {
            "id": "716500103",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "哎呀，就是「璃月总务司」啦。",
            "nextDialogs": [
              "716500104"
            ]
          },
          "716500104": {
            "id": "716500104",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "我是「璃月总务司」指派的资源管理专员，我叫小雨。",
            "nextDialogs": [
              "716500105"
            ]
          },
          "716500105": {
            "id": "716500105",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "所谓的资源管理，指的不仅仅是物资资源，其实还有人力资源和情报资源…",
            "nextDialogs": [
              "716500106"
            ]
          },
          "716500106": {
            "id": "716500106",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "在这座崇尚贸易的城市璃月，你应该也知道资源流通的重要性吧？",
            "nextDialogs": [
              "716500107"
            ]
          },
          "716500107": {
            "id": "716500107",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "用物资资源来换取人力资源和情报资源…进而将一切问题解决，这就是我和我所在的「总务司」擅长的做法。",
            "nextDialogs": [
              "716500108"
            ]
          },
          "716500108": {
            "id": "716500108",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "哈哈哈，说白了，就是你帮忙解决问题，我付给你报酬啦。",
            "nextDialogs": [
              "716500109"
            ]
          },
          "716500109": {
            "id": "716500109",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "唔，但只是这么说的话，你也肯定不太了解…",
            "nextDialogs": [
              "716500110"
            ]
          },
          "716500110": {
            "id": "716500110",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "你还是自己来看一下，现在你可以承接的工作吧。"
          }
        }
      }
    },
    {
      "subId": "7165002",
      "subQuestName": "与小雨对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716500201"
        ],
        "dialogs": {
          "716500201": {
            "id": "716500201",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "怎么样，如果有兴趣的话，就来尝试一下吧。",
            "nextDialogs": [
              "716500202"
            ]
          },
          "716500202": {
            "id": "716500202",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "如果顺利解决了问题，不仅能提升你在大家心中的声望，报酬也少不了。",
            "nextDialogs": [
              "716500203"
            ]
          },
          "716500203": {
            "id": "716500203",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "不过，能够承接的工作种类，也要依据你的声望而定。",
            "nextDialogs": [
              "716500204"
            ]
          },
          "716500204": {
            "id": "716500204",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "最开始的话，你应该只能承接一些简单的工作。",
            "nextDialogs": [
              "716500205"
            ]
          },
          "716500205": {
            "id": "716500205",
            "speakerId": 2457,
            "speakerName": "小雨",
            "text": "如果你想要承接更重要的工作，获得更丰厚的奖励…就请多多承接工作，想办法赢得大家的信任吧。"
          }
        }
      }
    }
  ]
}
    "派蒙": 74
  },
  "subQuests": [
    {
      "subId": "7905701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790570101"
        ],
        "dialogs": {
          "790570101": {
            "id": "790570101",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "两位贵客，你们好啊！我是这个项目的「代理总导演」，有什么想问我的吗？",
            "nextDialogs": [
              "790570103",
              "790570112",
              "790570139",
              "790570169",
              "790570181"
            ]
          },
          "790570103": {
            "id": "790570103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜啊！「小水珠」又说话了！声线还有点不一样…",
            "nextDialogs": [
              "790570104"
            ]
          },
          "790570104": {
            "id": "790570104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，为什么我要说「又」？",
            "nextDialogs": [
              "790570105"
            ]
          },
          "790570105": {
            "id": "790570105",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "哈哈！你们果然是这个反应！",
            "nextDialogs": [
              "790570106"
            ]
          },
          "790570106": {
            "id": "790570106",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "不必这么惊讶哦，你们仔细听，声音的来源，是房间边沿的那个喇叭…",
            "nextDialogs": [
              "790570107"
            ]
          },
          "790570107": {
            "id": "790570107",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "我能和你们对话，靠的全是以前记录的声音…总之是伊迪…啊不，是黛依阿预先准备好的台词！",
            "nextDialogs": [
              "790570108"
            ]
          },
          "790570108": {
            "id": "790570108",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "具体的原理，你们可以去咨询「工程师」，他的解释肯定更详细，更易懂！",
            "nextDialogs": [
              "790570109"
            ]
          },
          "790570109": {
            "id": "790570109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原，原来是这样！",
            "nextDialogs": [
              "790570110"
            ]
          },
          "790570110": {
            "id": "790570110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不知道为什么，一想到这是在奇妙的「琉形蜃境」里，好像发生什么事情都有可能呢…"
          },
          "790570112": {
            "id": "790570112",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "这个问题选得好！因为我不觉得自己是这个职位的最佳人选…灵选！",
            "nextDialogs": [
              "790570113"
            ]
          },
          "790570113": {
            "id": "790570113",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "我和伙伴们或多或少受到了佐西摩斯导演的影响，论才能不相上下。",
            "nextDialogs": [
              "790570114"
            ]
          },
          "790570114": {
            "id": "790570114",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "大家正在一边摸索编排剧目的技巧，一边提升自己的实力。",
            "nextDialogs": [
              "790570115"
            ]
          },
          "790570115": {
            "id": "790570115",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "剧组的伙伴经常向我提意见，有的时候，「假编剧」他们也会越过我安排一些事。",
            "nextDialogs": [
              "790570116"
            ]
          },
          "790570116": {
            "id": "790570116",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "只要多数伙伴支持这件事，对剧目有好处，我也会特别开心！",
            "nextDialogs": [
              "790570117"
            ]
          },
          "790570117": {
            "id": "790570117",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "假如将来有其他伙伴的能力胜过我，还有意愿主导整个项目，我会第一时间让出这个职位！",
            "nextDialogs": [
              "790570118"
            ]
          },
          "790570118": {
            "id": "790570118",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你也太谦让了嘛，导演应该更有魄力一点？全都依着别人的想法来，有的时候会出问题的吧？"
          },
          "790570139": {
            "id": "790570139",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "技法？什么技法…",
            "nextDialogs": [
              "790570140"
            ]
          },
          "790570140": {
            "id": "790570140",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦哦哦…我想起来了！",
            "nextDialogs": [
              "790570141"
            ]
          },
          "790570141": {
            "id": "790570141",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "之前我就很好奇，你们会用旁白和角色的台词引导游客想象各种画面，这是从哪学到的技巧？",
            "nextDialogs": [
              "790570142"
            ]
          },
          "790570142": {
            "id": "790570142",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "这个问题…实话实说…不是什么高深的事…",
            "nextDialogs": [
              "790570143"
            ]
          },
          "790570143": {
            "id": "790570143",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "主要是没钱。",
            "nextDialogs": [
              "790570144"
            ]
          },
          "790570144": {
            "id": "790570144",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "？",
            "nextDialogs": [
              "790570145"
            ]
          },
          "790570145": {
            "id": "790570145",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "？",
            "nextDialogs": [
              "790570146"
            ]
          },
          "790570146": {
            "id": "790570146",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "其实，你们体验到的剧目都是妥协后的产物。",
            "nextDialogs": [
              "790570147"
            ]
          },
          "790570147": {
            "id": "790570147",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "我原本只看过佐西摩斯导演展示的几部「映影」，有一些朦胧的想法。可是在实现这些想法的过程中，我们遇到了很多困难。",
            "nextDialogs": [
              "790570148"
            ]
          },
          "790570148": {
            "id": "790570148",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "每一幕情景在规划时只不过是寥寥几行字，但涉及许多演员、道具和布景，无一不要花费大量成本。",
            "nextDialogs": [
              "790570149"
            ]
          },
          "790570149": {
            "id": "790570149",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "用佐西摩斯导演的话来说，在他的故乡，这些事都要花钱解决。而在「琉形蜃境」中，花费的就是我们水形幻灵的工作时间。",
            "nextDialogs": [
              "790570150"
            ]
          },
          "790570150": {
            "id": "790570150",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "就拿「黑水晶号与吞金海怪」举例，要是真的造出全副武装的海盗船和巨大的海怪机关，还挖出一大片水域用来演出…",
            "nextDialogs": [
              "790570151"
            ]
          },
          "790570151": {
            "id": "790570151",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "至少要花费几十个几千万摩拉！用水形幻灵的工时衡量，剧组找来所有朋友，都需要好几个月！",
            "nextDialogs": [
              "790570152"
            ]
          },
          "790570152": {
            "id": "790570152",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有，有这么贵吗！我的估算居然还少了？",
            "nextDialogs": [
              "790570153"
            ]
          },
          "790570153": {
            "id": "790570153",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "所以我们放弃了很多布景和道具，绝对不贪心，将主要的力量集中在「呼呼飞车」的相关玩法和最后的战斗上。",
            "nextDialogs": [
              "790570154"
            ]
          },
          "790570154": {
            "id": "790570154",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "起码这样能让观众有一些难忘的体验，而不是全程平平淡淡，最后什么都记不住。",
            "nextDialogs": [
              "790570155"
            ]
          },
          "790570155": {
            "id": "790570155",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有道理呢，「黑水晶号」那部剧的呼呼飞车确实很晃，起码模拟出了船上的感觉，最后的战斗也比较有特色。",
            "nextDialogs": [
              "790570156"
            ]
          },
          "790570156": {
            "id": "790570156",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这大概就是…以前在璃月听说过的…什么道理来着"
          },
          "790570169": {
            "id": "790570169",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "唔，我确实想和你们简单介绍一下整个剧组。但自从佐西摩斯启发了我和伙伴们，大家每天都在学习不同的知识。",
            "nextDialogs": [
              "790570170"
            ]
          },
          "790570170": {
            "id": "790570170",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "现在每位剧组的伙伴都形成了…很独特的性格，关于它们的信息，用这套播音系统聊起来实在太多太复杂了。",
            "nextDialogs": [
              "790570171"
            ]
          },
          "790570171": {
            "id": "790570171",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "「工程师」本来也还没处理好相应的语音。",
            "nextDialogs": [
              "790570172"
            ]
          },
          "790570172": {
            "id": "790570172",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "所以，我暂时没法用录音向你们说明，还是麻烦你们亲自去和他们交流啦。",
            "nextDialogs": [
              "790570173"
            ]
          },
          "790570173": {
            "id": "790570173",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，我没反应过来，好像提到了别的「小水珠」？",
            "nextDialogs": [
              "790570174"
            ]
          },
          "790570174": {
            "id": "790570174",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「处理语音」？",
            "nextDialogs": [
              "790570175"
            ]
          },
          "790570175": {
            "id": "790570175",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "……",
            "nextDialogs": [
              "790570176"
            ]
          },
          "790570176": {
            "id": "790570176",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "（看起来好像在尽力比划着什么，但是很难理解这些动作的意思…）",
            "nextDialogs": [
              "790570177"
            ]
          },
          "790570177": {
            "id": "790570177",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没办法了，谈到这个问题，「总导演小水珠」就说不出话来…",
            "nextDialogs": [
              "790570178"
            ]
          },
          "790570178": {
            "id": "790570178",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们还是按他的说法，去和每个剧组成员聊聊看吧。",
            "nextDialogs": [
              "790570179"
            ]
          },
          "790570179": {
            "id": "790570179",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "如果有机会的话，还要问问「工程师」，刚刚说到的「处理语音」是怎么回事…"
          },
          "790570181": {
            "id": "790570181",
            "speakerId": 1000,
            "speakerName": "「总导演」",
            "text": "两位太有礼貌了！要是想聊话剧相关的话题，不管什么时候都可以来找我哦！"
          }
        }
      }
    },
    {
      "subId": "7905702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790570201"
        ],
        "dialogs": {
          "790570201": {
            "id": "790570201",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "哟！两位观众老爷，我是「三日遐想」里的普通员工「假编剧」，需要我为你们做点什么吗？",
            "nextDialogs": [
              "790570203",
              "790570241",
              "790570266",
              "790570277"
            ]
          },
          "790570203": {
            "id": "790570203",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "这个问题很关键！我得和你们好好说道说道…",
            "nextDialogs": [
              "790570204"
            ]
          },
          "790570204": {
            "id": "790570204",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "简单来说，再不拿出分寸得当的作品，我就要被炒了！",
            "nextDialogs": [
              "790570205"
            ]
          },
          "790570205": {
            "id": "790570205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "噫！有这么严重吗！怎么说得像是…「小水珠」这里也有很严苛的规矩？"
          },
          "790570241": {
            "id": "790570241",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "都说了，我只是普通员工，用「大人」这种称呼，总有点讽刺的感觉…",
            "nextDialogs": [
              "790570242"
            ]
          },
          "790570242": {
            "id": "790570242",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#噫！你是不是太敏感了啦，{NICKNAME}肯定不是那个意思，{M#他}{F#她}只会真心对别人用尊称！",
            "nextDialogs": [
              "790570243"
            ]
          },
          "790570243": {
            "id": "790570243",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "那实在不好意思，我大概是犯了职业病…",
            "nextDialogs": [
              "790570244"
            ]
          },
          "790570244": {
            "id": "790570244",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "佐西摩斯老师说过，他的同行们有时会因为一句台词用词不够严谨，被过度解读，甚至遭到攻击。",
            "nextDialogs": [
              "790570245"
            ]
          },
          "790570245": {
            "id": "790570245",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "虽然「琉形蜃境」中大概率不会出现这样苛刻的观众…",
            "nextDialogs": [
              "790570246"
            ]
          },
          "790570246": {
            "id": "790570246",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "但佐西摩斯老师还说过，创作作品时，要有着面向更多受众的准备，更不能有侥幸心理！",
            "nextDialogs": [
              "790570247"
            ]
          },
          "790570247": {
            "id": "790570247",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "嗯，虽然有点跑题了，谈到了我的自我要求，但这也算是我给你们的建议吧。",
            "nextDialogs": [
              "790570248"
            ]
          },
          "790570248": {
            "id": "790570248",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好严格的自我要求！连一个词都要计较吗？",
            "nextDialogs": [
              "790570249"
            ]
          },
          "790570249": {
            "id": "790570249",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这么说来，如果我们以之前的经历创作话剧，比如风之神和特瓦林的故事…",
            "nextDialogs": [
              "790570250"
            ]
          },
          "790570250": {
            "id": "790570250",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "会不会有人跳出来指指点点…嗯…「大不敬！你这家伙竟敢把风之神写得如此散漫，何等僭越！」"
          },
          "790570266": {
            "id": "790570266",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦！之前黛依阿的声音说过，我们可以多和你聊聊，为你提供有意思的故事，对你写剧本有好处！",
            "nextDialogs": [
              "790570267"
            ]
          },
          "790570267": {
            "id": "790570267",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "唔…「总导演」从伊迪娅那里听说过你们的阅历，确实很有必要…",
            "nextDialogs": [
              "790570268"
            ]
          },
          "790570268": {
            "id": "790570268",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "但如你所见，创作剧本的过程很漫长了，我担心，你们口述的故事太丰富，我隔段时间就忘了。",
            "nextDialogs": [
              "790570269"
            ]
          },
          "790570269": {
            "id": "790570269",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "还是拜托你们，直接在我面前的这台装置里录音吧，这样我随时都能重温！",
            "nextDialogs": [
              "790570270"
            ]
          },
          "790570270": {
            "id": "790570270",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#这个我们熟，就拜托{NICKNAME}想想，要为「黛依阿的三日遐想」提供什么有意思的素材好了！",
            "nextDialogs": [
              "790570271"
            ]
          },
          "790570271": {
            "id": "790570271",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "和派蒙商量了一番，特意选出了旅途中最珍奇的见闻，还将一些书籍中的故事概括了一下，以简洁易懂的口吻录音，提供给「假编剧」…",
            "nextDialogs": [
              "790570272"
            ]
          },
          "790570272": {
            "id": "790570272",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "好家伙！录音的时间这么长，可用的素材有点超出我的想象了！",
            "nextDialogs": [
              "790570273"
            ]
          },
          "790570273": {
            "id": "790570273",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "我要专门挑出一段台词，来歌颂你们这种分享故事的伟业！",
            "nextDialogs": [
              "790570274"
            ]
          },
          "790570274": {
            "id": "790570274",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，有专门干这行的「小水珠」，不知道能用我们的素材改编出什么样的故事…",
            "nextDialogs": [
              "790570275"
            ]
          },
          "790570275": {
            "id": "790570275",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我开始期待了！"
          },
          "790570277": {
            "id": "790570277",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对对，我们只是来观摩一下，不打扰你们工作！",
            "nextDialogs": [
              "790570278"
            ]
          },
          "790570278": {
            "id": "790570278",
            "speakerId": 1002,
            "speakerName": "「假编剧」",
            "text": "两位真有礼貌，用词也很谨慎！那就祝你们参观愉快了！"
          }
        }
      }
    },
    {
      "subId": "7905703",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790570301"
        ],
        "dialogs": {
          "790570301": {
            "id": "790570301",
            "speakerId": 1004,
            "speakerName": "「工程师」",
            "text": "呼…呼…呃…两位还真是有精神啊，可惜我「工程师」没余力招待你们了…",
            "nextDialogs": [
              "790570303",
              "790570334"
            ]
          },
          "790570303": {
            "id": "790570303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好逼真的喘气声！还是第一次用声音感受到「小水珠」的疲劳，原来累到不行的「小水珠」会表现成这样啊…",
            "nextDialogs": [
              "790570335"
            ]
          },
          "790570335": {
            "id": "790570335",
            "speakerId": 1004,
            "speakerName": "「工程师」",
            "text": "没办法，干技术维护这行，有谁不累不崩溃的？",
            "nextDialogs": [
              "790570304"
            ]
          },
          "790570304": {
            "id": "790570304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "技术维护？突然冒出了好高深的词…"
          },
          "790570334": {
            "id": "790570334",
            "speakerId": 1004,
            "speakerName": "「工程师」",
            "text": "多谢关心，我干完这点活就暂时消停一下…不过，真的会有彻底干完工作的一天吗…"
          }
        }
      }
    },
    {
      "subId": "7905704",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790570401"
        ],
        "dialogs": {
          "790570401": {
            "id": "790570401",
            "speakerId": 1005,
            "speakerName": "「偷懒鬼」",
            "text": "哦豁！两位稀客，有什么可以为你们效劳的吗？我「偷懒鬼」争取给你们提供最省力的解决方案…",
            "nextDialogs": [
              "790570403",
              "790570428"
            ]
          },
          "790570403": {
            "id": "790570403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦，我也很好奇！",
            "nextDialogs": [
              "790570404"
            ]
          },
          "790570404": {
            "id": "790570404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是不是因为你总不干活，所以才被取了这个名啊？",
            "nextDialogs": [
              "790570405"
            ]
          },
          "790570405": {
            "id": "790570405",
            "speakerId": 1005,
            "speakerName": "「偷懒鬼」",
            "text": "嘿！话可不能这么说，无论控制剧目演出的进程，还是制作话剧需要的道具和场景物件，我可从没耽搁过！",
            "nextDialogs": [
              "790570406"
            ]
          },
          "790570406": {
            "id": "790570406",
            "speakerId": 1005,
            "speakerName": "「偷懒鬼」",
            "text": "「偷懒」其实是一种态度，讲究的是用最省时省力的手法来达成一些表现效果。",
            "nextDialogs": [
              "790570407"
            ]
          },
          "790570407": {
            "id": "790570407",
            "speakerId": 1005,
            "speakerName": "「偷懒鬼」",
            "text": "比如场景物件只造正面和反面，不是一个立体的模型，这样就…唔…用「总导演」的话来说，省下很多工时！",
            "nextDialogs": [
              "790570408"
            ]
          },
          "790570408": {
            "id": "790570408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "？",
            "nextDialogs": [
              "790570409"
            ]
          },
          "790570409": {
            "id": "790570409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "？",
            "nextDialogs": [
              "790570410"
            ]
          },
          "790570410": {
            "id": "790570410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那岂不是没有侧面了吗！",
            "nextDialogs": [
              "790570411"
            ]
          },
          "790570411": {
            "id": "790570411",
            "speakerId": 1005,
            "speakerName": "「偷懒鬼」",
            "text": "想想办法骗过观众的视线，不就万事大吉了？",
            "nextDialogs": [
              "790570412"
            ]
          },
          "790570412": {
            "id": "790570412",
            "speakerId": 1005,
            "speakerName": "「偷懒鬼」",
            "text": "比如让「呼呼飞车」在物件正面稍微减速，快要擦肩而过的时候，就加速通过。",
            "nextDialogs": [
              "790570413"
            ]
          },
          "790570413": {
            "id": "790570413",
            "speakerId": 1005,
            "speakerName": "「偷懒鬼」",
            "text": "这样一来，观众的注意力大多只会放在物件的正反面上！你想想，你在观察「海怪爪牙」的时候，不就是这样的吗？",
            "nextDialogs": [
              "790570414"
            ]
          },
          "790570414": {
            "id": "790570414",
            "speakerId": 1005,
            "speakerName": "「偷懒鬼」",
            "text": "不然，我们剧组可就腾不出工夫，来把更重要的场景给做完了。",
            "nextDialogs": [
              "790570415"
            ]
          },
          "790570415": {
            "id": "790570415",
            "speakerId": 1005,
            "speakerName": "「偷懒鬼」",
            "text": "相比没什么所谓的「海怪爪牙的侧面」，肯定是整部话剧的完成度更要紧。",
            "nextDialogs": [
              "790570416"
            ]
          },
          "790570416": {
            "id": "790570416",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好像确实是这么一回事…",
            "nextDialogs": [
              "790570417"
            ]
          },
          "790570417": {
            "id": "790570417",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "照你这么说，这个「偷懒」还是个褒义的说法了？"
          },
          "790570428": {
            "id": "790570428",
            "speakerId": 1005,
            "speakerName": "「偷懒鬼」",
            "text": "多谢多谢！一看就知道，你们两位的头脑很灵光，有空再来聊聊呀！"
          }
        }
      }
    },
    {
      "subId": "7905705",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790570501"
        ],
        "dialogs": {
          "790570501": {
            "id": "790570501",
            "speakerId": 1006,
            "speakerName": "「全勤王」",
            "text": "工作工作工作！冲刺冲刺冲刺！超额完成目标，提前赢得成功！",
            "nextDialogs": [
              "790570503",
              "790570528"
            ]
          },
          "790570503": {
            "id": "790570503",
            "speakerId": 1006,
            "speakerName": "「全勤王」",
            "text": "任务完成接任务！哪里需要去哪里！",
            "nextDialogs": [
              "790570504"
            ]
          },
          "790570504": {
            "id": "790570504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "明明是一个「小水珠」，怎么却发出了一股让人害怕的气势…",
            "nextDialogs": [
              "790570505"
            ]
          },
          "790570505": {
            "id": "790570505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "感觉它好像特别喜欢工作，光是靠近它，就会被拉着一起不停干活…",
            "nextDialogs": [
              "790570506"
            ]
          },
          "790570506": {
            "id": "790570506",
            "speakerId": 1006,
            "speakerName": "「全勤王」",
            "text": "嗯？我好像听见你们在议论我？",
            "nextDialogs": [
              "790570507"
            ]
          },
          "790570507": {
            "id": "790570507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没有的事！我们还有别的事要忙，就先走了…",
            "nextDialogs": [
              "790570508"
            ]
          },
          "790570508": {
            "id": "790570508",
            "speakerId": 1006,
            "speakerName": "「全勤王」",
            "text": "哦哦哦哦哦！你们很忙？要派点活儿给我吗？",
            "nextDialogs": [
              "790570509"
            ]
          },
          "790570509": {
            "id": "790570509",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "？",
            "nextDialogs": [
              "790570510"
            ]
          },
          "790570510": {
            "id": "790570510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "？",
            "nextDialogs": [
              "790570511"
            ]
          },
          "790570511": {
            "id": "790570511",
            "speakerId": 1006,
            "speakerName": "「全勤王」",
            "text": "无论让我干什么都可以！不会的我可以现学，我还挺喜欢挑战新工作的！",
            "nextDialogs": [
              "790570512"
            ]
          },
          "790570512": {
            "id": "790570512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "莫非我们错怪这个「小水珠」了？它是会替别人搞定麻烦，而不是抓着别人一起吃苦的类型？",
            "nextDialogs": [
              "790570513"
            ]
          },
          "790570513": {
            "id": "790570513",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那…这位「小水珠」，你平常的工作内容都有哪些？",
            "nextDialogs": [
              "790570514"
            ]
          },
          "790570514": {
            "id": "790570514",
            "speakerId": 1006,
            "speakerName": "「全勤王」",
            "text": "我想想看…好像没有固定的任务哦。",
            "nextDialogs": [
              "790570515"
            ]
          },
          "790570515": {
            "id": "790570515",
            "speakerId": 1006,
            "speakerName": "「全勤王」",
            "text": "「总导演」会让我帮忙控制话剧里的机关，「假编剧」拜托我给他跑过腿，搬运过剧本的参考书…",
            "nextDialogs": [
              "790570516"
            ]
          },
          "790570516": {
            "id": "790570516",
            "speakerId": 1006,
            "speakerName": "「全勤王」",
            "text": "「工程师」派我去打扫轨道，「偷懒鬼」也叫我帮他制作过道具。"
          },
          "790570528": {
            "id": "790570528",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好…虽然不知道这个小水珠在忙什么，但我们还是不要打扰它了吧…"
          }
        }
      }
    },
    {
      "subId": "7905706",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790570601"
        ],
        "dialogs": {
          "790570601": {
            "id": "790570601",
            "speakerId": 1007,
            "speakerName": "「大冒失」",
            "text": "（似乎是之前见过的水形幻灵，被「总导演」指挥着操作过一些机关。）",
            "nextDialogs": [
              "790570602"
            ]
          },
          "790570602": {
            "id": "790570602",
            "speakerId": 1007,
            "speakerName": "「大冒失」",
            "text": "（但是没有属于自己的操作台，所以没法发出声音，只是一直战战兢兢，似乎犯过什么错…）"
          }
        }
      }
    },
    {
      "subId": "7905707",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790570701"
        ],
        "dialogs": {
          "790570701": {
            "id": "790570701",
            "speakerId": 1008,
            "speakerName": "「管饭的」",
            "text": "（不知待在角落里干什么的水形幻灵，据「总导演」的说法，好像外号是「管饭的」。）",
            "nextDialogs": [
              "790570702"
            ]
          },
          "790570702": {
            "id": "790570702",
            "speakerId": 1008,
            "speakerName": "「管饭的」",
            "text": "（想来也奇怪，水形幻灵们会吃什么呢？还是说，它负责的…是那些幽魂机关的伙食？）"
          }
        }
      }
    }
  ]
}
    {
      "subId": "2201817",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220181701"
        ],
        "dialogs": {
          "220181701": {
            "id": "220181701",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "嗯？你们找我有什么事吗？",
            "nextDialogs": [
              "220181702"
            ]
          },
          "220181702": {
            "id": "220181702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于失窃的「志村屋」…",
            "nextDialogs": [
              "220181703"
            ]
          },
          "220181703": {
            "id": "220181703",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "这件事啊，我也听说了。",
            "nextDialogs": [
              "220181704"
            ]
          },
          "220181704": {
            "id": "220181704",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "如果你们是想问我有没有目击到什么的话，抱歉，我应该不知道什么有价值的线索。",
            "nextDialogs": [
              "220181705"
            ]
          },
          "220181705": {
            "id": "220181705",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "在「志村屋」失窃的时候，我正在冒险家协会里处理一些事务。",
            "nextDialogs": [
              "220181706"
            ]
          },
          "220181706": {
            "id": "220181706",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "如果你们需要我的不在场证明，可以去问问凯瑟琳。",
            "nextDialogs": [
              "220181707"
            ]
          },
          "220181707": {
            "id": "220181707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "周围有什么可疑的人吗？",
            "nextDialogs": [
              "220181708"
            ]
          },
          "220181708": {
            "id": "220181708",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "可疑的人？",
            "nextDialogs": [
              "220181709"
            ]
          },
          "220181709": {
            "id": "220181709",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "唔…就我来说的话，实在是无法分辨。",
            "nextDialogs": [
              "220181710"
            ]
          },
          "220181710": {
            "id": "220181710",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "毕竟，在「眼狩令」这种法令下…从行为上能够称得上「可疑」的人实在是太多了。"
          }
        }
      }
    },
    {
      "subId": "2201818",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220181801"
        ],
        "dialogs": {
          "220181801": {
            "id": "220181801",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "如果你们需要我的不在场证明，可以去问问凯瑟琳。"
          }
        }
      }
    },
    {
      "subId": "2201819",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220181901"
        ],
        "dialogs": {
          "220181901": {
            "id": "220181901",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "你们回来了，怎么样？调查到什么了吗？",
            "nextDialogs": [
              "220181902"
            ]
          },
          "220181902": {
            "id": "220181902",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "唔…我知道了，辛苦你们了。",
            "nextDialogs": [
              "220181903"
            ]
          },
          "220181903": {
            "id": "220181903",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "这个犯人的作案手法还真是准确。除了勘兵卫先生之外，「根付之源」的店主御舆源一郎先生也是受害者。",
            "nextDialogs": [
              "220181904"
            ]
          },
          "220181904": {
            "id": "220181904",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "犯人似乎也「恰好」知道，他有隔一段时间就去拜访好友的习惯。选在这个时间，偷走了店里不少值钱的东西。",
            "nextDialogs": [
              "220181905"
            ]
          },
          "220181905": {
            "id": "220181905",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "哦对了，还有弥生小姐的漆器店。在弥生小姐出门给客人送漆器的时候，店里的不少珍贵漆器也失窃了。",
            "nextDialogs": [
              "220181907"
            ]
          },
          "220181907": {
            "id": "220181907",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "唔，没错。但你也看见了，这条街上的商家和居民本就不多，如果是熟人作案的话，很快就会露出马脚。",
            "nextDialogs": [
              "220181908"
            ]
          },
          "220181908": {
            "id": "220181908",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "但如果不是熟人作案的话，又怎么能够这么精确地把握受害者出门的时间呢？",
            "nextDialogs": [
              "220181910"
            ]
          },
          "220181910": {
            "id": "220181910",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "这个问题我也稍微想了想。在拜托了天野和安藤查了一遍周围住户和商家的行踪记录后，基本上排除了熟人作案的可能。",
            "nextDialogs": [
              "220181911"
            ]
          },
          "220181911": {
            "id": "220181911",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "虽然犯罪的地点十分零散，粗看起来，很像是野外流窜的盗宝团一时兴起进城偷窃…",
            "nextDialogs": [
              "220181912"
            ]
          },
          "220181912": {
            "id": "220181912",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "但这个犯人作案的手法十分精确，犯罪现场收拾地也很利落，完全不像是那些盗宝团干一票就走的风格。",
            "nextDialogs": [
              "220181913"
            ]
          },
          "220181913": {
            "id": "220181913",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "我觉得…也许犯人真的是亲身在城内一一踩点，不断搜集着周围人的起居信息，给自己的犯罪做计划…",
            "nextDialogs": [
              "220181914"
            ]
          },
          "220181914": {
            "id": "220181914",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "但就如同我之前所说，这里的居民数量并不多，大家都彼此相熟，要是真有什么陌生人的话，大家也一定会马上发现。"
          }
        }
      }
    },
    {
      "subId": "2201820",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220182001"
        ],
        "dialogs": {
          "220182001": {
            "id": "220182001",
            "speakerId": 12108,
            "speakerName": "石川八郎",
            "text": "「眼狩令」结束了…我…这…",
            "nextDialogs": [
              "220182002"
            ]
          },
          "220182002": {
            "id": "220182002",
            "speakerId": 12108,
            "speakerName": "石川八郎",
            "text": "怎、怎么突然就结束了…",
            "nextDialogs": [
              "220182003"
            ]
          },
          "220182003": {
            "id": "220182003",
            "speakerId": 12108,
            "speakerName": "石川八郎",

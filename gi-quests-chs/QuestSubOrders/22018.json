    {
      "subId": "2201814",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220181401"
        ],
        "dialogs": {
          "220181401": {
            "id": "220181401",
            "speakerId": 3015,
            "speakerName": "志村勘兵卫",
            "text": "可恶…到底是谁做的这种事…",
            "nextDialogs": [
              "220181402"
            ]
          },
          "220181402": {
            "id": "220181402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您就是志村勘兵卫吗？",
            "nextDialogs": [
              "220181403"
            ]
          },
          "220181403": {
            "id": "220181403",
            "speakerId": 3015,
            "speakerName": "志村勘兵卫",
            "text": "啊，我就是，你是…哦！这不是龙二吗？",
            "nextDialogs": [
              "220181404"
            ]
          },
          "220181404": {
            "id": "220181404",
            "speakerId": 3015,
            "speakerName": "志村勘兵卫",
            "text": "怎么样，珊瑚小姐查到那个混账到底是谁了吗？我非要好好教训一下那家伙不可…",
            "nextDialogs": [
              "220181405"
            ]
          },
          "220181405": {
            "id": "220181405",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "社长暂时还没有查到犯人。",
            "nextDialogs": [
              "220181406"
            ]
          },
          "220181406": {
            "id": "220181406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于失窃的情况…",
            "nextDialogs": [
              "220181407"
            ]
          },
          "220181407": {
            "id": "220181407",
            "speakerId": 3015,
            "speakerName": "志村勘兵卫",
            "text": "我已经把我知道的都告诉珊瑚小姐了。当时我喝酒喝太多，直接就睡下了。",
            "nextDialogs": [
              "220181408"
            ]
          },
          "220181408": {
            "id": "220181408",
            "speakerId": 3015,
            "speakerName": "志村勘兵卫",
            "text": "再醒过来的时候，店里的钱就已经都不见了！",
            "nextDialogs": [
              "220181409"
            ]
          },
          "220181409": {
            "id": "220181409",
            "speakerId": 3015,
            "speakerName": "志村勘兵卫",
            "text": "可恶…到底是谁做出这种事来…"
          }
        }
      }
    },
    {
      "subId": "2201815",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220181501"
        ],
        "dialogs": {
          "220181501": {
            "id": "220181501",
            "speakerId": 12108,
            "speakerName": "石川八郎",
            "text": "你…看见我的「神之眼」了吗…",
            "nextDialogs": [
              "220181502"
            ]
          },
          "220181502": {
            "id": "220181502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你有「神之眼」？",
            "nextDialogs": [
              "220181503"
            ]
          },
          "220181503": {
            "id": "220181503",
            "speakerId": 12108,
            "speakerName": "石川八郎",
            "text": "我有…我有…就、就放在这的，怎么就弄丢了呢…嗝…",
            "nextDialogs": [
              "220181504"
            ]
          },
          "220181504": {
            "id": "220181504",
            "speakerId": 12108,
            "speakerName": "石川八郎",
            "text": "怎么就…弄丢了呢…呜呜呜…",
            "nextDialogs": [
              "220181505"
            ]
          },
          "220181505": {
            "id": "220181505",
            "speakerId": 12108,
            "speakerName": "石川八郎",
            "text": "大哥…对、对不起，我的「神之眼」也…呜呜…"
          }
        }
      }
    },
    {
      "subId": "2201816",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

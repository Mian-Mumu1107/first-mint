    "龙二": 4
  },
  "subQuests": [
    {
      "subId": "2201801",
      "subQuestName": "与珊瑚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220180101"
        ],
        "dialogs": {
          "220180101": {
            "id": "220180101",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "看来只有这一种可能了…",
            "nextDialogs": [
              "220180102"
            ]
          },
          "220180102": {
            "id": "220180102",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "唔…看来还得再找一点线索才行…",
            "nextDialogs": [
              "220180103"
            ]
          },
          "220180103": {
            "id": "220180103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "案子怎么样了？",
            "nextDialogs": [
              "220180104"
            ]
          },
          "220180104": {
            "id": "220180104",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "哦呀，这不是旅行者吗？你来得正好，案情的侦破工作刚好到了紧要关头。",
            "nextDialogs": [
              "220180105"
            ]
          },
          "220180105": {
            "id": "220180105",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "多亏了天野和安藤先生的行动，那位犯人似乎完全相信，同心们的侦察方向转向了野外的盗宝团。",
            "nextDialogs": [
              "220180106"
            ]
          },
          "220180106": {
            "id": "220180106",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "所以，那位犯人还在城里时不时地犯案，留下了不少痕迹。",
            "nextDialogs": [
              "220180107"
            ]
          },
          "220180107": {
            "id": "220180107",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "昨天那位犯人又犯案了，这回被偷的是「志村屋」的店主，勘兵卫先生。",
            "nextDialogs": [
              "220180108"
            ]
          },
          "220180108": {
            "id": "220180108",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "发现店里的钱被偷了之后，勘兵卫先生据说在店外怒吼了很长时间。",
            "nextDialogs": [
              "220180109"
            ]
          },
          "220180109": {
            "id": "220180109",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "要是再早几年，他说不定就会直接抄起家伙，亲自去城里搜捕犯人了吧。",
            "nextDialogs": [
              "220180110"
            ]
          },
          "220180110": {
            "id": "220180110",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "居然连勘兵卫先生的钱都敢偷，真是个胆大包天的人…",
            "nextDialogs": [
              "220180111"
            ]
          },
          "220180111": {
            "id": "220180111",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "不过，犯人选择的时机倒是也非常巧妙。",
            "nextDialogs": [
              "220180112"
            ]
          },
          "220180112": {
            "id": "220180112",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "他似乎早就打探到了，勘兵卫先生每隔几天都会闭店谢客，自己好好痛饮一番。",
            "nextDialogs": [
              "220180113"
            ]
          },
          "220180113": {
            "id": "220180113",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "而在勘兵卫先生痛饮大醉后，犯人悠悠然地取走了店里的钱，就这么轻松地走掉了…",
            "nextDialogs": [
              "220180114"
            ]
          },
          "220180114": {
            "id": "220180114",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "他已经连续几天过来拜托我找到犯人了，他那个嗓门，我可有点受不了了。",
            "nextDialogs": [
              "220180115"
            ]
          },
          "220180115": {
            "id": "220180115",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "所以，我想请你和龙二过去看看他的情况，听一听…嗯…他的抱怨。",
            "nextDialogs": [
              "220180116"
            ]
          },
          "220180116": {
            "id": "220180116",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "然后再顺便去调查，在「志村屋」失窃的那个时间段里，周围的人有没有看见…或者听见什么。",
            "nextDialogs": [
              "220180117"
            ]
          },
          "220180117": {
            "id": "220180117",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "调查完之后就回来告诉我吧，我会在这里等着你们的。"
          }
        }
      }
    },
    {
      "subId": "2201802",
      "subQuestName": "向弥生七月询问线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220180201"
        ],
        "dialogs": {
          "220180201": {
            "id": "220180201",
            "speakerId": 3001,
            "speakerName": "弥生七月",
            "text": "你好，请问你有什么事吗？",
            "nextDialogs": [
              "220180202"
            ]
          },
          "220180202": {
            "id": "220180202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于失窃的「志村屋」…",
            "nextDialogs": [
              "220180203"
            ]
          },
          "220180203": {
            "id": "220180203",
            "speakerId": 3001,
            "speakerName": "弥生七月",
            "text": "嗯，我听说过。勘兵卫先生怒吼的声音，我想不听见都难…",
            "nextDialogs": [
              "220180204"
            ]
          },
          "220180204": {
            "id": "220180204",
            "speakerId": 3001,
            "speakerName": "弥生七月",
            "text": "你们是想问我有没有看见什么吗？",
            "nextDialogs": [
              "220180205"
            ]
          },
          "220180205": {
            "id": "220180205",
            "speakerId": 3001,
            "speakerName": "弥生七月",
            "text": "抱歉，我什么也没看见…被勘兵卫先生怒吼的声音吵醒之后，我才知道这件事…",
            "nextDialogs": [
              "220180206"
            ]
          },
          "220180206": {
            "id": "220180206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "周围有什么可疑的人吗？",
            "nextDialogs": [
              "220180207"
            ]
          },
          "220180207": {
            "id": "220180207",
            "speakerId": 3001,
            "speakerName": "弥生七月",
            "text": "可疑的人？嗯…我也没发现什么可疑的人。",
            "nextDialogs": [
              "220180208"
            ]
          },
          "220180208": {
            "id": "220180208",
            "speakerId": 3001,
            "speakerName": "弥生七月",
            "text": "唉，勘兵卫先生怒吼的声音真是够大的，周围的人应该都被他吼醒了吧…"
          }
        }
      }
    },
    {
      "subId": "2201803",
      "subQuestName": "向志村勘兵卫询问线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220180301"
        ],
        "dialogs": {
          "220180301": {
            "id": "220180301",
            "speakerId": 3015,
            "speakerName": "志村勘兵卫",
            "text": "可恶…到底是谁做的这种事…",
            "nextDialogs": [
              "220180302"
            ]
          },
          "220180302": {
            "id": "220180302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您就是志村勘兵卫吗？",
            "nextDialogs": [
              "220180303"
            ]
          },
          "220180303": {
            "id": "220180303",
            "speakerId": 3015,
            "speakerName": "志村勘兵卫",
            "text": "啊，我就是，你是…哦！这不是龙二吗？",
            "nextDialogs": [
              "220180304"
            ]
          },
          "220180304": {
            "id": "220180304",
            "speakerId": 3015,
            "speakerName": "志村勘兵卫",
            "text": "怎么样，珊瑚小姐查到那个混账到底是谁了吗？我非要好好教训一下那家伙不可…",
            "nextDialogs": [
              "220180305"
            ]
          },
          "220180305": {
            "id": "220180305",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "社长暂时还没有查到犯人。",
            "nextDialogs": [
              "220180306"
            ]
          },
          "220180306": {
            "id": "220180306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于失窃的情况…",
            "nextDialogs": [
              "220180307"
            ]
          },
          "220180307": {
            "id": "220180307",
            "speakerId": 3015,
            "speakerName": "志村勘兵卫",
            "text": "我已经把我知道的都告诉珊瑚小姐了。当时我喝酒喝太多，直接就睡下了。",
            "nextDialogs": [
              "220180308"
            ]
          },
          "220180308": {
            "id": "220180308",
            "speakerId": 3015,
            "speakerName": "志村勘兵卫",
            "text": "再醒过来的时候，店里的钱就已经都不见了！",
            "nextDialogs": [
              "220180309"
            ]
          },
          "220180309": {
            "id": "220180309",
            "speakerId": 3015,
            "speakerName": "志村勘兵卫",
            "text": "可恶…到底是谁做出这种事来…"
          }
        }
      }
    },
    {
      "subId": "2201804",
      "subQuestName": "向古谷升询问线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220180401"
        ],
        "dialogs": {
          "220180401": {
            "id": "220180401",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "嗯？你找我有什么事吗？",
            "nextDialogs": [
              "220180402"
            ]
          },
          "220180402": {
            "id": "220180402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于失窃的「志村屋」…",
            "nextDialogs": [
              "220180403"
            ]
          },
          "220180403": {
            "id": "220180403",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "这件事啊，我也听说了。",
            "nextDialogs": [
              "220180404"
            ]
          },
          "220180404": {
            "id": "220180404",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "如果你是想问我有没有目击到什么的话，抱歉，我这里应该没什么有价值的线索。",
            "nextDialogs": [
              "220180405"
            ]
          },
          "220180405": {
            "id": "220180405",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "我之前一直在冒险家协会里处理事务，没有出去过。",
            "nextDialogs": [
              "220180406"
            ]
          },
          "220180406": {
            "id": "220180406",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "听见了勘兵卫先生的喊声之后，我出去看了看，然后才听说了这件事。",
            "nextDialogs": [
              "220180407"
            ]
          },
          "220180407": {
            "id": "220180407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "周围有什么可疑的人吗？",
            "nextDialogs": [
              "220180408"
            ]
          },
          "220180408": {
            "id": "220180408",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "可疑的人？",
            "nextDialogs": [
              "220180409"
            ]
          },
          "220180409": {
            "id": "220180409",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "唔…抱歉，我没注意过这方面的事。",
            "nextDialogs": [
              "220180410"
            ]
          },
          "220180410": {
            "id": "220180410",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "不然…你们再去问问别人吧。"
          }
        }
      }
    },
    {
      "subId": "2201805",
      "subQuestName": "与珊瑚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220180501"
        ],
        "dialogs": {
          "220180501": {
            "id": "220180501",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "你们回来了，怎么样？调查到什么了吗？",
            "nextDialogs": [
              "220180502"
            ]
          },
          "220180502": {
            "id": "220180502",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "唔…我知道了，辛苦你们了。",
            "nextDialogs": [
              "220180503"
            ]
          },
          "220180503": {
            "id": "220180503",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "这个犯人的作案手法还真是准确。除了勘兵卫先生之外，「根付之源」的店主御舆源一郎先生也是受害者。",
            "nextDialogs": [
              "220180504"
            ]
          },
          "220180504": {
            "id": "220180504",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "在他离开店里，去拜访好友的时候，犯人从店里偷走了不少值钱的东西。",
            "nextDialogs": [
              "220180505"
            ]
          },
          "220180505": {
            "id": "220180505",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "哦对了，还有弥生小姐的漆器店。在弥生小姐出门给客人送漆器的时候，店里不少值钱的漆器也失窃了。",
            "nextDialogs": [
              "220180507"
            ]
          },
          "220180507": {
            "id": "220180507",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "唔，没错。但你也看见了，这条街上的商家和居民本就不多，如果是熟人作案的话，很快就会露出马脚。",
            "nextDialogs": [
              "220180508"
            ]
          },
          "220180508": {
            "id": "220180508",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "但如果不是熟人作案的话，又怎么能够这么精确地把握受害者出门的时间呢？",
            "nextDialogs": [
              "220180510"
            ]
          },
          "220180510": {
            "id": "220180510",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "这个问题我也稍微想了想。在拜托了天野和安藤查了一遍周围住户和商家的行踪后，基本上排除了熟人作案的可能。",
            "nextDialogs": [
              "220180511"
            ]
          },
          "220180511": {
            "id": "220180511",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "虽然犯罪的地点十分零散，粗看起来，很像是野外流窜的盗宝团一时兴起进城偷窃…",
            "nextDialogs": [
              "220180512"
            ]
          },
          "220180512": {
            "id": "220180512",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "但这个犯人作案的手法这么精确，完全不像是那些盗宝团干一票就走的风格。",
            "nextDialogs": [
              "220180513"
            ]
          },
          "220180513": {
            "id": "220180513",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "我觉得…也许犯人真的是亲身在城内一一踩点，不断搜集着周围人的起居信息，给自己的犯罪做计划…",
            "nextDialogs": [
              "220180514"
            ]
          },
          "220180514": {
            "id": "220180514",
            "speakerId": 3041,
            "speakerName": "珊瑚",
            "text": "但就如同我之前所说，这里的居民数量并不多，大家都彼此相熟，要是真有什么陌生人的话，大家也一定会马上发现。"
          }
        }
      }
    },

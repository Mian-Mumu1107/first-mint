        "dialogs": {
          "766810401": {
            "id": "766810401",
            "speakerId": 1000,
            "speakerName": "古老的终端",
            "text": "识别到生命体征。调用身份识别序列：<color=#FF5E41FF>错误</color>。开始执行内核安全性检查…",
            "nextDialogs": [
              "766810402"
            ]
          },
          "766810402": {
            "id": "766810402",
            "speakerId": 1000,
            "speakerName": "古老的终端",
            "text": "内核安全性检查：<color=#FF5E41FF>失败</color>。中枢模块损坏或丢失，请联系宁希姬娅修理。备用安全模式启动中…",
            "nextDialogs": [
              "766810403"
            ]
          },
          "766810403": {
            "id": "766810403",
            "speakerId": 1000,
            "speakerName": "古老的终端",
            "text": "请原谅。身份识别序列暂时无法识别来访者，因此无法以正确的头衔称呼您。准备播放通用问候语。",
            "nextDialogs": [
              "766810404"
            ]
          },
          "766810404": {
            "id": "766810404",
            "speakerId": 1000,
            "speakerName": "古老的终端",
            "text": "欢迎访问亚·伊{RUBY#[S]第五十九号}里穆存储阵列。本阵列主要用于调控「碑铭」运作，并存储各类研究资源。",
            "nextDialogs": [
              "766810405"
            ]
          },
          "766810405": {
            "id": "766810405",
            "speakerId": 1000,
            "speakerName": "古老的终端",
            "text": "<color=#FF5E41FF>错误</color>：关键组件损坏导致服务依赖异常，当前无法正常调用。请使用自我检查命令，修复关键数据节点。",
            "nextDialogs": [
              "766810406"
            ]
          },
          "766810406": {
            "id": "766810406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦哦，虽然我没太听懂它在说什么，但好像是只要按照屏幕上的提示操作，就可以把这东西修好了吧？",
            "nextDialogs": [
              "766810407"
            ]
          },
          "766810407": {
            "id": "766810407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "既然说是「存储资源」的地方，那就是「仓库」吧？说不定附近会有什么超厉害的宝藏，我们快点试试看！"
          }
        }
      }

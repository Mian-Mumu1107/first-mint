    {
      "subId": "2100399",
      "subQuestName": "与桥西对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210039901"
        ],
        "dialogs": {
          "210039901": {
            "id": "210039901",
            "speakerId": 1000,
            "speakerName": "桥西",
            "text": "你把那些怪物清理掉了吗？",
            "nextDialogs": [
              "210039902"
            ]
          },
          "210039902": {
            "id": "210039902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经清理掉了。",
            "nextDialogs": [
              "210039903"
            ]
          },
          "210039903": {
            "id": "210039903",
            "speakerId": 1000,
            "speakerName": "桥西",
            "text": "辛苦你了，真是不好意思，这本来是我的工作，还让你跑了一趟…",
            "nextDialogs": [
              "210039904"
            ]
          },
          "210039904": {
            "id": "210039904",
            "speakerId": 1000,
            "speakerName": "桥西",
            "text": "…你也不用掩饰，看你一身尘土的，准是在那里和魔物打了一场吧。",
            "nextDialogs": [
              "210039905"
            ]
          },
          "210039905": {
            "id": "210039905",
            "speakerId": 1000,
            "speakerName": "桥西",
            "text": "唉，也不知道上面是怎么想的，一直没有再派人来这里。我一个人，又怎么能面面俱到呢…",
            "nextDialogs": [
              "210039906"
            ]
          },
          "210039906": {
            "id": "210039906",
            "speakerId": 1000,
            "speakerName": "桥西",
            "text": "就算只是两座桥，也是有不少日常行人的，这里要是出了问题，事情绝对只大不小…",
            "nextDialogs": [
              "210039907"
            ]
          },
          "210039907": {
            "id": "210039907",
            "speakerId": 1000,
            "speakerName": "桥西",
            "text": "我一定要找个机会，再和上面好好报告一下这件事。",
            "nextDialogs": [
              "210039908"
            ]
          },
          "210039908": {
            "id": "210039908",
            "speakerId": 1000,
            "speakerName": "桥西",
            "text": "谢谢你，这些给你，就算是答谢吧。"
          }
        }
      }

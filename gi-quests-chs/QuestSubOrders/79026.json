      "subId": "7902601",
      "subQuestName": "(test)和夜鸦团长对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790260101"
        ],
        "dialogs": {
          "790260101": {
            "id": "790260101",
            "speakerId": 1000,
            "speakerName": "暮夜剧团团长",
            "text": "欢迎！欢迎！",
            "nextDialogs": [
              "790260102"
            ]
          },
          "790260102": {
            "id": "790260102",
            "speakerId": 1000,
            "speakerName": "暮夜剧团团长",
            "text": "欢迎！",
            "nextDialogs": [
              "790260104"
            ]
          },
          "790260104": {
            "id": "790260104",
            "speakerId": 1000,
            "speakerName": "暮夜剧团团长",
            "text": "#您就是大名鼎鼎的{NICKNAME}！还有最好的伙伴——派蒙阁下！",
            "nextDialogs": [
              "790260105"
            ]
          },
          "790260105": {
            "id": "790260105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！你怎么知道我们的名字？",
            "nextDialogs": [
              "790260106"
            ]
          },
          "790260106": {
            "id": "790260106",
            "speakerId": 1000,
            "speakerName": "暮夜剧团团长",
            "text": "岛上的贵客，我当然知道，因为我！",
            "nextDialogs": [
              "790260107"
            ]
          },
          "790260107": {
            "id": "790260107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你？",
            "nextDialogs": [
              "790260108"
            ]
          },
          "790260108": {
            "id": "790260108",
            "speakerId": 1000,
            "speakerName": "暮夜剧团团长",
            "text": "我就是大名鼎鼎的暮夜剧团团长！",
            "nextDialogs": [
              "790260109"
            ]
          },
          "790260109": {
            "id": "790260109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来真的有人自称大名鼎鼎。",
            "nextDialogs": [
              "790260110"
            ]
          },
          "790260110": {
            "id": "790260110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然你说自己大名鼎鼎，可是我们没听说过你呀。",
            "nextDialogs": [
              "790260111"
            ]
          },
          "790260111": {
            "id": "790260111",
            "speakerId": 1000,
            "speakerName": "暮夜剧团团长",
            "text": "没关系！现在两位已经听说了！",
            "nextDialogs": [
              "790260112"
            ]
          },
          "790260112": {
            "id": "790260112",
            "speakerId": 1000,
            "speakerName": "暮夜剧团团长",
            "text": "经过紧锣密鼓的筹备，我们的舞台剧「王女执剑记」就要首演了！",
            "nextDialogs": [
              "790260113"
            ]
          },
          "790260113": {
            "id": "790260113",
            "speakerId": 1000,
            "speakerName": "暮夜剧团团长",
            "text": "演出一共五幕，每幕分为上下两场…",
            "nextDialogs": [
              "790260114"
            ]
          },
          "790260114": {
            "id": "790260114",
            "speakerId": 1000,
            "speakerName": "暮夜剧团团长",
            "text": "贵宾们来得正是时候！马上序幕就要开演！请您就坐！",
            "nextDialogs": [
              "790260115"
            ]
          },
          "790260115": {
            "id": "790260115",
            "speakerId": 1000,
            "speakerName": "暮夜剧团团长",
            "text": "后台还有些事情需要处理，且容我先行告退。",
            "nextDialogs": [
              "790260116"
            ]
          },
          "790260116": {
            "id": "790260116",
            "speakerId": 1000,
            "speakerName": "暮夜剧团团长",
            "text": "暮夜剧团，倾力打造的舞台剧，马上开幕，请您欣赏！"
          }
        }
      }
    },

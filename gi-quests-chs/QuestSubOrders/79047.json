    },
    {
      "subId": "7904707",
      "subQuestName": "击败奇怪的敌人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790470701"
        ],
        "dialogs": {
          "790470701": {
            "id": "790470701",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "哼！这下知道错了吧？",
            "nextDialogs": [
              "790470702"
            ]
          },
          "790470702": {
            "id": "790470702",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "记住了！以后不准再来搞破坏！",
            "nextDialogs": [
              "790470703"
            ]
          },
          "790470703": {
            "id": "790470703",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "不对劲啊！刚才的那三个家伙，有谁见过它们吗？是不是「超入戏」雇来的演员？",
            "nextDialogs": [
              "790470704"
            ]
          },
          "790470704": {
            "id": "790470704",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "「工程师」呢？「工程师」修完海怪爪牙的机关了吗？快带着应急小组去现场处理一下后续事宜…",
            "nextDialogs": [
              "790470705"
            ]
          },
          "790470705": {
            "id": "790470705",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "什么？我还在播音？啊啊对不起！我马上关掉！",
            "nextDialogs": [
              "790470706"
            ]
          },
          "790470706": {
            "id": "790470706",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "还好游客们自己搞定了这次的突发情况…下次绝对不能再犯这样的错了！",
            "nextDialogs": [
              "790470707"
            ]
          },
          "790470707": {
            "id": "790470707",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "克服重重困难后，「风之微粒」的收集工作总算几近完成。两位守望者太过专注，没有注意到时间已经过去了大半个月。",
            "nextDialogs": [
              "790470708"
            ]
          },
          "790470708": {
            "id": "790470708",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "奇迹建筑师也交上了完美的答卷，他用有限的时间迅速修复了小镇地基中的升力气球…",
            "nextDialogs": [
              "790470709"
            ]
          },
          "790470709": {
            "id": "790470709",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "喇叭那边的声音…为什么听起来有点慌张？",
            "nextDialogs": [
              "790470712"
            ]
          },
          "790470712": {
            "id": "790470712",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "呃，也不知道究竟发生了什么事，先不管了！我们继续话剧吧。",
            "nextDialogs": [
              "790470713"
            ]
          },
          "790470713": {
            "id": "790470713",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "旁白说，我们来到了设定上的「十几天后」，那就省去了等待建筑师修复气球的时间，我们现在就去和他们会合吧！"
          }
        }
      }
    },
    {
      "subId": "7904704",
      "subQuestName": "与长老和建筑师对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790470401"
        ],
        "dialogs": {
          "790470401": {
            "id": "790470401",
            "speakerId": 1004,
            "speakerName": "守望者的长老",
            "text": "欢迎回来！真是辛苦你们了，请先好好休息一下…",
            "nextDialogs": [
              "790470402"
            ]
          },
          "790470402": {
            "id": "790470402",
            "speakerId": 1005,
            "speakerName": "不太礼貌的学舌鸟",
            "text": "厉害！厉害！",
            "nextDialogs": [
              "790470403"
            ]
          },
          "790470403": {
            "id": "790470403",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "你们环顾四周，奇迹工程师已经修复了所有破损的升力气球。\\n只等「风之微粒」准备到位，就能彻底解决小镇坠落的危机。",
            "nextDialogs": [
              "790470404"
            ]
          },
          "790470404": {
            "id": "790470404",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "长老召来了其他守望者，为你们端来了热乎乎的饭菜和爽口的饮品。而奇迹建筑师掐表一算，对你们的效率啧啧称奇。",
            "nextDialogs": [
              "790470405"
            ]
          },
          "790470405": {
            "id": "790470405",
            "speakerId": 1006,
            "speakerName": "奇迹建筑师",
            "text": "你们完成收集任务的时间，比我的预期快上了整整五天？不愧是有名的高手！",
            "nextDialogs": [
              "790470406"
            ]
          },
          "790470406": {
            "id": "790470406",
            "speakerId": 1006,
            "speakerName": "奇迹建筑师",
            "text": "既然「风之微粒」收集好了，那我就一鼓作气，为气球补充升力吧！",
            "nextDialogs": [
              "790470407"
            ]
          },
          "790470407": {
            "id": "790470407",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "来自喇叭的旁白开始描述此后的情景——\\n\\n 奇迹建筑师取出了独特的设备，四处奔走，通过预先设置好的接口，将你们收集到的「风之微粒」分发至地基各处的装置。",
            "nextDialogs": [
              "790470408"
            ]
          },
          "790470408": {
            "id": "790470408",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "随着升力恢复正常，异常的震动也完全停息。\\n小镇不再下坠，反而慢慢向原本所在的高度攀升，强烈的气流排开了大片云层…",
            "nextDialogs": [
              "790470409"
            ]
          },
          "790470409": {
            "id": "790470409",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "阴翳的天色也重归晴朗，小镇重新沐浴在明媚的阳光之下，守望者们开始欢庆叫好…",
            "nextDialogs": [
              "790470410"
            ]
          },
          "790470410": {
            "id": "790470410",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "太好了，小镇总算停止下坠了，危机圆满解除，鼓掌鼓掌！",
            "nextDialogs": [
              "790470411"
            ]
          },
          "790470411": {
            "id": "790470411",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "可是，为什么我们两个要一直抬头看呢？ 明明是我们脑海里想象的情景，而且我们本来也站在小镇上吧…",
            "nextDialogs": [
              "790470412"
            ]
          },
          "790470412": {
            "id": "790470412",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "脖子都酸了！",
            "nextDialogs": [
              "790470413"
            ]
          },
          "790470413": {
            "id": "790470413",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "要不然，等到有机会了，我们找一找这方面的专家，把这个故事画出来，或者…做成映影！我有预感，一定可以大卖的！",
            "nextDialogs": [
              "790470416"
            ]
          },
          "790470416": {
            "id": "790470416",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "感受着脚下的地基归于平静，长老长舒了一口气，感动得有些鼻酸。",
            "nextDialogs": [
              "790470417"
            ]
          },
          "790470417": {
            "id": "790470417",
            "speakerId": 1005,
            "speakerName": "不太礼貌的学舌鸟",
            "text": "小镇安全了！小镇安全了！",
            "nextDialogs": [
              "790470418"
            ]
          },
          "790470418": {
            "id": "790470418",
            "speakerId": 1004,
            "speakerName": "守望者的长老",
            "text": "太好了，太好了…这样一来，我们守望者一族就可以继续恪守职责！",
            "nextDialogs": [
              "790470419"
            ]
          },
          "790470419": {
            "id": "790470419",
            "speakerId": 1006,
            "speakerName": "奇迹建筑师",
            "text": "大功告成…这次的修复工程非常顺利，是能写进论文…哦不，是足以登上教科书的完美案例！",
            "nextDialogs": [
              "790470420"
            ]
          },
          "790470420": {
            "id": "790470420",
            "speakerId": 1006,
            "speakerName": "奇迹建筑师",
            "text": "今后两个月都不用为饭钱发愁了，下次的大工程，做点什么厉害的东西好呢…",
            "nextDialogs": [
              "790470421"
            ]
          },
          "790470421": {
            "id": "790470421",
            "speakerId": 1004,
            "speakerName": "守望者的长老",
            "text": "可是，容我一问，小镇好像…还一直在上升，如果超过了本来的高度…什么时候才会停下来呢？",
            "nextDialogs": [
              "790470422"
            ]
          },
          "790470422": {
            "id": "790470422",
            "speakerId": 1006,
            "speakerName": "奇迹建筑师",
            "text": "糟糕！",
            "nextDialogs": [
              "790470423"
            ]
          },
          "790470423": {
            "id": "790470423",
            "speakerId": 1006,
            "speakerName": "奇迹建筑师",
            "text": "我好像光顾着修复气球，忘记把抵消升力的锚索固定好了…",
            "nextDialogs": [
              "790470424"
            ]
          },
          "790470424": {
            "id": "790470424",
            "speakerId": 1006,
            "speakerName": "奇迹建筑师",
            "text": "不要慌…小镇上升的速度很慢，还可以用小型货运气球来施工！这点补救措施，花不了多少功夫。",
            "nextDialogs": [
              "790470425"
            ]
          },
          "790470425": {
            "id": "790470425",
            "speakerId": 1004,
            "speakerName": "守望者的长老",
            "text": "原来如此，我还以为，您见识到两位新星的身姿后，觉得我们都能飞檐走壁，适应高空的生活…",
            "nextDialogs": [
              "790470426"
            ]
          },
          "790470426": {
            "id": "790470426",
            "speakerId": 1004,
            "speakerName": "守望者的长老",
            "text": "哈！我们守望者一族倒也没有那么神通广大…麻烦您尽快修复这个小小的瑕疵了。",
            "nextDialogs": [
              "790470427"
            ]
          },
          "790470427": {
            "id": "790470427",
            "speakerId": 1005,
            "speakerName": "不太礼貌的学舌鸟",
            "text": "要加钱吗？要加钱吗？",
            "nextDialogs": [
              "790470428"
            ]
          },
          "790470428": {
            "id": "790470428",
            "speakerId": 1005,
            "speakerName": "不太礼貌的学舌鸟",
            "text": "再赚一点？再赚一点？",
            "nextDialogs": [
              "790470429"
            ]
          },
          "790470429": {
            "id": "790470429",
            "speakerId": 1006,
            "speakerName": "奇迹建筑师",
            "text": "假如长老打算建一个豪华鸟笼，把你关在里边，好好学习说话的礼仪，还有「生财有道」的道德观…",
            "nextDialogs": [
              "790470430"
            ]
          },
          "790470430": {
            "id": "790470430",
            "speakerId": 1006,
            "speakerName": "奇迹建筑师",
            "text": "那不用加钱，倒贴钱我也干！",
            "nextDialogs": [
              "790470431"
            ]
          },
          "790470431": {
            "id": "790470431",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "虽说最后还有一点小插曲，但并不影响结局的完满。",
            "nextDialogs": [
              "790470432"
            ]
          },
          "790470432": {
            "id": "790470432",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "如此一来，守望者一族心心念念的问题，便被奇迹建筑师彻底解决了。",
            "nextDialogs": [
              "790470433"
            ]
          },
          "790470433": {
            "id": "790470433",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "这座天空中的小镇将继续支持着高崖守望者一族，为整个地区带来长久的安宁与繁荣…",
            "nextDialogs": [
              "790470434"
            ]
          },
          "790470434": {
            "id": "790470434",
            "speakerId": 1001,
            "speakerName": "来自喇叭的旁白",
            "text": "「天空高城救守记」全剧终，感谢您的观看！",
            "nextDialogs": [
              "790470435"
            ]
          },
          "790470435": {
            "id": "790470435",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "鼓掌鼓掌，这部话剧落幕啦！ 虽然还有一些遗憾，但故事本身还是很不错的！",
            "nextDialogs": [
              "790470436"
            ]
          },
          "790470436": {
            "id": "790470436",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "如果我是一个富商，就要给「黛依阿的三日遐思」投一大笔钱，把每件道具和每个场景都做到最好，来讲好这个故事！"
          }
        }
      }
    }
  ]
}
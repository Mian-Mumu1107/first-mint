    {
      "subId": "7904705",
      "subQuestName": "击败奇怪的敌人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790470501"
        ],
        "dialogs": {
          "790470501": {
            "id": "790470501",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "啊！原来是这三个家伙偷走了最后的风之微粒！",
            "nextDialogs": [
              "790470502"
            ]
          },
          "790470502": {
            "id": "790470502",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "难道说…空中小镇的气球也是被这些家伙破坏的吗？",
            "nextDialogs": [
              "790470503"
            ]
          },
          "790470503": {
            "id": "790470503",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "#可恶…{NICKNAME}，我们上！教训这些家伙，抢回「风之微粒」！"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "1200101",
      "subQuestName": "前往茂才公府，探听消息",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120010101"
        ],
        "dialogs": {
          "120010101": {
            "id": "120010101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里就是茂才公的家吧，果然是有钱人，真的好气派。",
            "nextDialogs": [
              "120010102"
            ]
          },
          "120010102": {
            "id": "120010102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "要想知道茂才公和「愚人众」是不是有勾结…先和守卫打听打听吧。"
          }
        }
      }
    },
    {
      "subId": "1200103",
      "subQuestName": "和守卫交谈，探听消息",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120010301"
        ],
        "dialogs": {
          "120010301": {
            "id": "120010301",
            "speakerId": 1001,
            "speakerName": "大武",
            "text": "什么人？",
            "nextDialogs": [
              "120010303",
              "120010305"
            ]
          },
          "120010303": {
            "id": "120010303",
            "speakerId": 1001,
            "speakerName": "大武",
            "text": "咦？应该已经提前告知过了啊。",
            "nextDialogs": [
              "120010306"
            ]
          },
          "120010306": {
            "id": "120010306",
            "speakerId": 1001,
            "speakerName": "大武",
            "text": "老爷今天临时有要事，所有会面都取消了。",
            "nextDialogs": [
              "120010307"
            ]
          },
          "120010307": {
            "id": "120010307",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「要事」…是？",
            "nextDialogs": [
              "120010308"
            ]
          },
          "120010308": {
            "id": "120010308",
            "speakerId": 1001,
            "speakerName": "大武",
            "text": "最近老爷在忙一笔重大的生意，早早就出门接待贵客了。",
            "nextDialogs": [
              "120010309"
            ]
          },
          "120010309": {
            "id": "120010309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那他现在在哪儿？",
            "nextDialogs": [
              "120010310"
            ]
          },
          "120010310": {
            "id": "120010310",
            "speakerId": 1001,
            "speakerName": "大武",
            "text": "抱歉，这个老爷特别叮嘱了，不能透露…",
            "nextDialogs": [
              "120010311"
            ]
          },
          "120010311": {
            "id": "120010311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "意思是我们就不是贵客了？",
            "nextDialogs": [
              "120010312"
            ]
          },
          "120010312": {
            "id": "120010312",
            "speakerId": 1001,
            "speakerName": "大武",
            "text": "不不不，我没有冒犯的意思，请不要介意！"
          },
          "120010305": {
            "id": "120010305",
            "speakerId": 1001,
            "speakerName": "大武",
            "text": "奇怪了，名册上没有这个名字…"
          }
        }
      }
    },
    {
      "subId": "1200106",
      "subQuestName": "前往新月轩窃听茂才公谈话",
      "sceneId": null,
      "locations": [],

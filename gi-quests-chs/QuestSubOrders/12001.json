      }
    },
    {
      "subId": "1200107",
      "subQuestName": "(test)前往新月轩，窃听茂才公的谈话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120010701"
        ],
        "dialogs": {
          "120010701": {
            "id": "120010701",
            "speakerId": 1002,
            "speakerName": "茂才公",
            "text": "我知道，我知道，放心，订单我一定会完成的。",
            "nextDialogs": [
              "120010702"
            ]
          },
          "120010702": {
            "id": "120010702",
            "speakerId": 1003,
            "speakerName": "债务处理人",
            "text": "但我之前派给你的手下回复我说，进度不太乐观啊…有人不愿配合，是么？",
            "nextDialogs": [
              "120010703"
            ]
          },
          "120010703": {
            "id": "120010703",
            "speakerId": 1002,
            "speakerName": "茂才公",
            "text": "呃…是，在原料上出了点小问题，石珀暂时还没收购到。",
            "nextDialogs": [
              "120010704"
            ]
          },
          "120010704": {
            "id": "120010704",
            "speakerId": 1002,
            "speakerName": "茂才公",
            "text": "不过这不需要您担心，就算那个常九爷不卖，我从其他人手上买就行了。",
            "nextDialogs": [
              "120010705"
            ]
          },
          "120010705": {
            "id": "120010705",
            "speakerId": 1003,
            "speakerName": "债务处理人",
            "text": "那是最好，之前我就说过，「愚人众」只重视结果。",
            "nextDialogs": [
              "120010706"
            ]
          },
          "120010706": {
            "id": "120010706",
            "speakerId": 1003,
            "speakerName": "债务处理人",
            "text": "为了完成订单，「愚人众」可以给你一定支持，但如果按时完不成…",
            "nextDialogs": [
              "120010707"
            ]
          },
          "120010707": {
            "id": "120010707",
            "speakerId": 1003,
            "speakerName": "债务处理人",
            "text": "我们的好意可不是免费的。",
            "nextDialogs": [
              "120010708"
            ]
          },
          "120010708": {
            "id": "120010708",
            "speakerId": 1002,
            "speakerName": "茂才公",
            "text": "明白明白，承蒙您关照，我又怎么敢辜负您的期望呢？",
            "nextDialogs": [
              "120010709"
            ]
          },
          "120010709": {
            "id": "120010709",
            "speakerId": 1003,
            "speakerName": "债务处理人",
            "text": "那就到时候看你的成果了。",
            "nextDialogs": [
              "120010710"
            ]
          },
          "120010710": {
            "id": "120010710",
            "speakerId": 1002,
            "speakerName": "茂才公",
            "text": "呼…该死的老常…"
          }
        }
      }
    },
    {
      "subId": "1200108",
      "subQuestName": "将茂才公的计划告知行秋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120010801"
        ],
        "dialogs": {
          "120010801": {
            "id": "120010801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说是有其他想了解的事，搞得神神秘秘的…",
            "nextDialogs": [
              "120010802"
            ]
          },
          "120010802": {
            "id": "120010802",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "结果你只是换了个地方看书吧！",
            "nextDialogs": [
              "120010803"
            ]
          },
          "120010803": {
            "id": "120010803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "茂才公的生意我们弄清楚了。",
            "nextDialogs": [
              "120010804"
            ]
          },
          "120010804": {
            "id": "120010804",
            "speakerId": 1004,
            "speakerName": "行秋",
            "text": "原来如此，和我猜得差不多。",
            "nextDialogs": [
              "120010805"
            ]
          },
          "120010805": {
            "id": "120010805",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你真的有猜过吗…",
            "nextDialogs": [
              "120010806"
            ]
          },
          "120010806": {
            "id": "120010806",
            "speakerId": 1004,
            "speakerName": "行秋",
            "text": "办法我已成竹在胸。我这里有封信，拜托你们带去给「飞云商会」的家丁，他知道该怎么做。",
            "nextDialogs": [
              "120010807"
            ]
          },
          "120010807": {
            "id": "120010807",
            "speakerId": 1004,
            "speakerName": "行秋",
            "text": "因为一些难以言述的苦衷，在下不能与二位一同前往。",
            "nextDialogs": [
              "120010808"
            ]
          },
          "120010808": {
            "id": "120010808",
            "speakerId": 1004,
            "speakerName": "行秋",
            "text": "至于信中内容你们不必查看，到时候…",
            "nextDialogs": [
              "120010809"
            ]
          },
          "120010809": {
            "id": "120010809",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，字好丑！这种字就算查看了也看不懂嘛。",
            "nextDialogs": [
              "120010812"
            ]
          },
          "120010812": {
            "id": "120010812",
            "speakerId": 1004,
            "speakerName": "行秋",
            "text": "唔…",
            "nextDialogs": [
              "120010813"
            ]
          },
          "120010813": {
            "id": "120010813",
            "speakerId": 1004,
            "speakerName": "行秋",
            "text": "所以说你们不必查看，不看…也不会有什么关系！",
            "nextDialogs": [
              "120010814"
            ]
          },
          "120010814": {
            "id": "120010814",
            "speakerId": 1004,
            "speakerName": "行秋",
            "text": "那个人是读得懂这封信的。",
            "nextDialogs": [
              "120010815"
            ]
          },
          "120010815": {
            "id": "120010815",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可是，是要找「飞云商会」帮忙吗？那可是璃月大名鼎鼎的商会之一，没理由帮我们吧？",
            "nextDialogs": [
              "120010816"
            ]
          },
          "120010816": {
            "id": "120010816",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「飞云商会」？",
            "nextDialogs": [
              "120010817"
            ]
          },
          "120010817": {
            "id": "120010817",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "来璃月之后，经常听到这个名字，好像有很多很多生意都是他们主导的。",
            "nextDialogs": [
              "120010818"
            ]
          },
          "120010818": {
            "id": "120010818",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "像这样的大商会如果愿意帮忙是很好，但他们真的会帮忙吗？",
            "nextDialogs": [
              "120010819"
            ]
          },
          "120010819": {
            "id": "120010819",
            "speakerId": 1004,
            "speakerName": "行秋",
            "text": "这个不用担心，据我了解，他们都跟我一样，有一颗侠义心肠。",
            "nextDialogs": [
              "120010820"
            ]
          },
          "120010820": {
            "id": "120010820",
            "speakerId": 1004,
            "speakerName": "行秋",
            "text": "读了我晓之以理、动之以情的这封信，一定会出手相助的。"
          }
        }
      }
    },
    {
      "subId": "1200043",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120004301"
        ],
        "dialogs": {
          "120004301": {
            "id": "120004301",
            "speakerId": 1001,
            "speakerName": "大武",
            "text": "对不起，是我眼拙，还望您大人有大量…"
          }
        }
      }
    },
    {
      "subId": "1200102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120010201"
        ],
        "dialogs": {
          "120010201": {
            "id": "120010201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，到底要怎么样才能知道茂才公和「愚人众」有勾结呢？",
            "nextDialogs": [
              "120010204"
            ]
          },
          "120010204": {
            "id": "120010204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那…直接去找他？能抓到现场最好，抓不到也能吓唬吓唬他，说不定就告诉我们了呢！",
            "nextDialogs": [
              "120010205"
            ]
          },
          "120010205": {
            "id": "120010205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先和守卫打听打听吧。",
            "nextDialogs": [
              "120010206"
            ]
          },
          "120010206": {
            "id": "120010206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那就交给你了！我会配合你的。"
          }
        }
      }
    },
    {
      "subId": "6100452",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "610045201"
        ],
        "dialogs": {
          "610045201": {
            "id": "610045201",
            "speakerId": 1004,
            "speakerName": "行秋",
            "text": "你们先出发吧，不必等我。",
            "nextDialogs": [
              "610045202"
            ]
          },
          "610045202": {
            "id": "610045202",
            "speakerId": 1004,
            "speakerName": "行秋",
            "text": "我再看一页就动身，就看一页。"
          }
        }
      }
    },
    {
      "subId": "6100457",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "610045701"
        ],
        "dialogs": {
          "610045701": {
            "id": "610045701",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个茂才公果然和「愚人众」有勾结！",
            "nextDialogs": [
              "610045702"
            ]
          },
          "610045702": {
            "id": "610045702",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不知道书呆子那边有没有什么进展，我们去告诉他吧。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "46520",
      "subQuestName": "击败深渊法师",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4652001"
        ],
        "dialogs": {
          "4652001": {
            "id": "4652001",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "既然情报到手，我就先去做些准备了。",
            "nextDialogs": [
              "4652002"
            ]
          },
          "4652002": {
            "id": "4652002",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "可以的话，希望你们能帮我留意一下骑士团对此事的动向。",
            "nextDialogs": [
              "4652003"
            ]
          },
          "4652003": {
            "id": "4652003",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好的！遵命！迪卢克老爷！",
            "nextDialogs": [
              "4652004"
            ]
          },
          "4652004": {
            "id": "4652004",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "…你这是突然怎么了？",
            "nextDialogs": [
              "4652005"
            ]
          },
          "4652005": {
            "id": "4652005",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "从，从刚才开始…",
            "nextDialogs": [
              "4652006"
            ]
          },
          "4652006": {
            "id": "4652006",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "迪卢克老爷已经在「派蒙最不能惹到的人」的榜单上排行第一了！",
            "nextDialogs": [
              "4652007"
            ]
          },
          "4652007": {
            "id": "4652007",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "……"
          }
        }
      }
    },

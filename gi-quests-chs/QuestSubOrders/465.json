      }
    },
    {
      "subId": "46513",
      "subQuestName": "向霍夫曼了解骑士团的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4650501"
        ],
        "dialogs": {
          "4650501": {
            "id": "4650501",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "再不找到「暗夜英雄」的话…",
            "nextDialogs": [
              "4650502"
            ]
          },
          "4650502": {
            "id": "4650502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「战书」的事骑士团准备如何处理？",
            "nextDialogs": [
              "4650503"
            ]
          },
          "4650503": {
            "id": "4650503",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "啊…是你们。不瞒你们说，还真是有点头疼。",
            "nextDialogs": [
              "4650504"
            ]
          },
          "4650504": {
            "id": "4650504",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "刚才的会议上刚刚确定了这次事件的行动方针，你猜怎样？",
            "nextDialogs": [
              "4650506",
              "4650509"
            ]
          },
          "4650506": {
            "id": "4650506",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "你这就是在开玩笑了，骑士团不会对任何危及蒙德安全的事袖手旁观。",
            "nextDialogs": [
              "4650507"
            ]
          },
          "4650507": {
            "id": "4650507",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "否则更多的人会去选择依靠「暗夜英雄」，而非骑士团了。",
            "nextDialogs": [
              "4650511"
            ]
          },
          "4650511": {
            "id": "4650511",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，那你们的计划是？",
            "nextDialogs": [
              "4650512"
            ]
          },
          "4650512": {
            "id": "4650512",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "查明「暗夜英雄」的真实身份，并将他「保护」起来。",
            "nextDialogs": [
              "4650513"
            ]
          },
          "4650513": {
            "id": "4650513",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「保护」？以他的实力还需要骑士团的保护吗？",
            "nextDialogs": [
              "4650514"
            ]
          },
          "4650514": {
            "id": "4650514",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "嘘——",
            "nextDialogs": [
              "4650515"
            ]
          },
          "4650515": {
            "id": "4650515",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "好吧，看在你们也帮助过骑士团的份儿上…我就明说吧。",
            "nextDialogs": [
              "4650516"
            ]
          },
          "4650516": {
            "id": "4650516",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "其实「保护」只是名义上如此，而其用意在于——骑士团准备完全接手这件事。",
            "nextDialogs": [
              "4650517"
            ]
          },
          "4650517": {
            "id": "4650517",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不让「暗夜英雄」出手吗？为什么要这样呢？",
            "nextDialogs": [
              "4650518"
            ]
          },
          "4650518": {
            "id": "4650518",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "首先是为了证明骑士团的实力，告诉民众没有「暗夜英雄」，骑士团也可以摆平一切。",
            "nextDialogs": [
              "4650519"
            ]
          },
          "4650519": {
            "id": "4650519",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "况且深渊教团此番来者不善，万一「暗夜英雄」有什么不测…",
            "nextDialogs": [
              "4650520"
            ]
          },
          "4650520": {
            "id": "4650520",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "…那就等于助长了敌人的气焰。",
            "nextDialogs": [
              "4650521"
            ]
          },
          "4650521": {
            "id": "4650521",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…骑士团也有自己的苦衷啊。",
            "nextDialogs": [
              "4650522"
            ]
          },
          "4650522": {
            "id": "4650522",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "可话虽这么说，如果不知道「暗夜英雄」的身份，一切也无从谈起。",
            "nextDialogs": [
              "4650523"
            ]
          },
          "4650523": {
            "id": "4650523",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "没必要这么苦恼，霍夫曼，按我说的做就好了。",
            "nextDialogs": [
              "4650524"
            ]
          },
          "4650524": {
            "id": "4650524",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "凯亚队长？",
            "nextDialogs": [
              "4650525"
            ]
          },
          "4650525": {
            "id": "4650525",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "最近每晚，迪卢克老爷都在「天使的馈赠」代班酒保…",
            "nextDialogs": [
              "4650526"
            ]
          },
          "4650526": {
            "id": "4650526",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "你只要负责看住他就行。如何，是不是一份美差？",
            "nextDialogs": [
              "4650527"
            ]
          },
          "4650527": {
            "id": "4650527",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "这当然没问题。不过…凯亚队长的意思是…",
            "nextDialogs": [
              "4650528"
            ]
          },
          "4650528": {
            "id": "4650528",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "「暗夜英雄」就是迪卢克先生？",
            "nextDialogs": [
              "4650529"
            ]
          },
          "4650529": {
            "id": "4650529",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "嗯~？谁知道呢，可能只是我的感觉吧。"
          },
          "4650509": {
            "id": "4650509",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "不对，他们说那样就等于支持了「暗夜英雄」的存在。",
            "nextDialogs": [
              "4650510"
            ]
          },
          "4650510": {
            "id": "4650510",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "鼓励这种个人英雄主义的做法，有失骑士团的权威。"
          }
        }
      }
    },

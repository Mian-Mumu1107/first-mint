  "subQuests": [
    {
      "subId": "46501",
      "subQuestName": "等到白天",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4650101"
        ],
        "dialogs": {
          "4650101": {
            "id": "4650101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "霍夫曼！",
            "nextDialogs": [
              "4650102"
            ]
          },
          "4650102": {
            "id": "4650102",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "哦，是你们。感谢你们二位的配合。",
            "nextDialogs": [
              "4650103"
            ]
          },
          "4650103": {
            "id": "4650103",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "上次我们聊到「暗夜英雄」的事…请问还有其他情报可以提供吗？",
            "nextDialogs": [
              "4650105",
              "4650107"
            ]
          },
          "4650105": {
            "id": "4650105",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "说的也是，提问之前自己要先提供必要的情报，是我疏忽了骑士的礼节。",
            "nextDialogs": [
              "4650108"
            ]
          },
          "4650108": {
            "id": "4650108",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "其实事情是这样的…你们先看看这个。",
            "nextDialogs": [
              "4650109"
            ]
          },
          "4650109": {
            "id": "4650109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇，好丑的字！",
            "nextDialogs": [
              "4650110"
            ]
          },
          "4650110": {
            "id": "4650110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，仔细看看…好像有很多地方看不太懂的样子。",
            "nextDialogs": [
              "4650111"
            ]
          },
          "4650111": {
            "id": "4650111",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "确实，虽然是「通用语」，但很多地方写成了「密文」的样子。",
            "nextDialogs": [
              "4650112"
            ]
          },
          "4650112": {
            "id": "4650112",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "只看可以读懂的部分倒是也能大致理解…",
            "nextDialogs": [
              "4650119"
            ]
          },
          "4650119": {
            "id": "4650119",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "这是，深渊教团对「暗夜英雄」下的战书。",
            "nextDialogs": [
              "4650113"
            ]
          },
          "4650113": {
            "id": "4650113",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也就是说「暗夜英雄」彻底被坏蛋盯上咯？",
            "nextDialogs": [
              "4650114"
            ]
          },
          "4650114": {
            "id": "4650114",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "这么说没错。所以可能的话，我们希望尽早与他一同商议对策。",
            "nextDialogs": [
              "4650115"
            ]
          },
          "4650115": {
            "id": "4650115",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "毕竟这不仅是「暗夜英雄」一个人的事，也是整个蒙德城的事。"
          },
          "4650107": {
            "id": "4650107",
            "speakerId": 1001,
            "speakerName": "霍夫曼",
            "text": "是吗…那可真是遗憾。"
          }
        }
      }
    },
    {
      "subId": "46502",
      "subQuestName": "到骑士团看看",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4650201"
        ],
        "dialogs": {
          "4650201": {
            "id": "4650201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "迪卢克老爷！快听我说，刚刚我们在骑士团…",
            "nextDialogs": [
              "4650202"
            ]
          },
          "4650202": {
            "id": "4650202",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "是深渊教团下的战书吧？",
            "nextDialogs": [
              "4650203"
            ]
          },
          "4650203": {
            "id": "4650203",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "我已经知道了，谢谢你们特地跑一趟。",
            "nextDialogs": [
              "4650204"
            ]
          },
          "4650204": {
            "id": "4650204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？",
            "nextDialogs": [
              "4650205"
            ]
          },
          "4650205": {
            "id": "4650205",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "晨曦酒庄的情报网可并不限于商业情报。",
            "nextDialogs": [
              "4650206"
            ]
          },
          "4650206": {
            "id": "4650206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那么迪卢克老爷打算怎么办呢？",
            "nextDialogs": [
              "4650207"
            ]
          },
          "4650207": {
            "id": "4650207",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "你们的意见呢？",
            "nextDialogs": [
              "4650209",
              "4650214"
            ]
          },
          "4650209": {
            "id": "4650209",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "那样就正中深渊教团的下怀了。",
            "nextDialogs": [
              "4650210"
            ]
          },
          "4650210": {
            "id": "4650210",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "他们看准我与骑士团合不来，想要逼我在他们面前现身。",
            "nextDialogs": [
              "4650211"
            ]
          },
          "4650211": {
            "id": "4650211",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "一旦我的身份暴露，以后的行动就难免会受到骑士团的干预。",
            "nextDialogs": [
              "4650212"
            ]
          },
          "4650212": {
            "id": "4650212",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "毕竟没有哪个掌控着权力的组织，甘愿由外人来「代行正义」。",
            "nextDialogs": [
              "4650217"
            ]
          },
          "4650217": {
            "id": "4650217",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…深渊教团这下可真是出了个大难题呀，好狡猾的家伙们。",
            "nextDialogs": [
              "4650218"
            ]
          },
          "4650218": {
            "id": "4650218",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "办法还是有的，只是需要先建立一些情报优势…",
            "nextDialogs": [
              "4650219"
            ]
          },
          "4650219": {
            "id": "4650219",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "…战书里的那些被刻意掩盖的情报。",
            "nextDialogs": [
              "4650220"
            ]
          },
          "4650220": {
            "id": "4650220",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "刻意掩盖？你指的是看不懂的那些部分吗？",
            "nextDialogs": [
              "4650221"
            ]
          },
          "4650221": {
            "id": "4650221",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "想必那是一种只有他们才懂的，在内部流传的「暗文」格式。"
          },
          "4650214": {
            "id": "4650214",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "那也就意味着要全部交由骑士团来处理。",
            "nextDialogs": [
              "4650215"
            ]
          },
          "4650215": {
            "id": "4650215",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "如果他们值得托付，事情也不会走到这一步。",
            "nextDialogs": [
              "4650216"
            ]
          },
          "4650216": {
            "id": "4650216",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "况且我迪卢克也还不至于沦落到自己躲起来，让骑士团为我善后的地步。"
          }
        }
      }
    },

    {
      "subId": "46504",
      "subQuestName": "前往晨曦酒庄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4650401"
        ],
        "dialogs": {
          "4650401": {
            "id": "4650401",
            "speakerId": 1003,
            "speakerName": "深渊法师",
            "text": "居然被你们找到这里来…可恶的骑士团…",
            "nextDialogs": [
              "4650402"
            ]
          },
          "4650402": {
            "id": "4650402",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "我可不是什么骑士。快老实交代吧，你们的详细计划！",
            "nextDialogs": [
              "4650403"
            ]
          },
          "4650403": {
            "id": "4650403",
            "speakerId": 1003,
            "speakerName": "深渊法师",
            "text": "原来你们也读过那「信」了吗…这种秘密就别妄想我会告诉你们了，哼哼…",
            "nextDialogs": [
              "4650404"
            ]
          },
          "4650404": {
            "id": "4650404",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "你恐怕是没搞清楚自己的处境吧…",
            "nextDialogs": [
              "4651001"
            ]
          },
          "4651001": {
            "id": "4651001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "使用<color=#00E1FFFF>「逆焰之手」</color>！",
            "nextDialogs": [
              "4651501"
            ]
          },
          "4651501": {
            "id": "4651501",
            "speakerId": 1003,
            "speakerName": "深渊法师",
            "text": "以手为媒介放出了神之眼的火焰？…好烫！！",
            "nextDialogs": [
              "4650601"
            ]
          },
          "4650601": {
            "id": "4650601",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "让我看看你可以嘴硬到什么时候…",
            "nextDialogs": [
              "4650405"
            ]
          },
          "4650405": {
            "id": "4650405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再次使用<color=#00E1FFFF>「逆焰之手」</color>！",
            "nextDialogs": [
              "4651502"
            ]
          },
          "4651502": {
            "id": "4651502",
            "speakerId": 1003,
            "speakerName": "深渊法师",
            "text": "住手啊！…求你快让这痛苦停下来啊！！！",
            "nextDialogs": [
              "4651402"
            ]
          },
          "4651402": {
            "id": "4651402",
            "speakerId": 1003,
            "speakerName": "深渊法师",
            "text": "咳咳……",
            "nextDialogs": [
              "4651403"
            ]
          },
          "4651403": {
            "id": "4651403",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "别想装死，这种程度的火焰还不会…嗯？好像是<color=#00E1FFFF>晕过去了</color>…",
            "nextDialogs": [
              "4651404"
            ]
          },
          "4651404": {
            "id": "4651404",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "…喂，还没到睡觉的时候！",
            "nextDialogs": [
              "4651405"
            ]
          },
          "4651405": {
            "id": "4651405",
            "speakerId": 1003,
            "speakerName": "深渊法师",
            "text": "啊啊——好烫！！",
            "nextDialogs": [
              "4650901"
            ]
          },
          "4650901": {
            "id": "4650901",
            "speakerId": 1003,
            "speakerName": "深渊法师",
            "text": "我说我说！咳咳咳…快停下来，我<color=#00E1FFFF>全都交待</color>！！",
            "nextDialogs": [
              "4650902"
            ]
          },
          "4650902": {
            "id": "4650902",
            "speakerId": 1003,
            "speakerName": "深渊法师",
            "text": "教团…教团集结了所有仇恨「暗夜英雄」的力量…",
            "nextDialogs": [
              "4650903"
            ]
          },
          "4650903": {
            "id": "4650903",
            "speakerId": 1003,
            "speakerName": "深渊法师",
            "text": "准备在明晚10点左右从<color=#00E1FFFF>正门</color>突袭蒙德城…",
            "nextDialogs": [
              "4650904"
            ]
          },
          "4650904": {
            "id": "4650904",
            "speakerId": 1003,
            "speakerName": "深渊法师",
            "text": "我知道的就是这些了…真的，那种火焰我…再也承受不了啦…",
            "nextDialogs": [
              "4650905"
            ]
          },
          "4650905": {
            "id": "4650905",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "就这些么？嗯…算了，谅你也不敢再隐瞒什么。"
          }
        }
      }
    },

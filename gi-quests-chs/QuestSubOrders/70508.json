    {
      "subId": "7050899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705089901"
        ],
        "dialogs": {
          "705089901": {
            "id": "705089901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像不是对方想要的饮品…再重做一杯吧，这杯我来解决！"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7050802",
      "subQuestName": "为凝光调制指定饮品",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705080201"
        ],
        "dialogs": {
          "705080201": {
            "id": "705080201",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "……",
            "nextDialogs": [
              "705080202"
            ]
          },
          "705080202": {
            "id": "705080202",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "……",
            "nextDialogs": [
              "705080203"
            ]
          },
          "705080203": {
            "id": "705080203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎、怎么样？你们别不说话呀，我好紧张！",
            "nextDialogs": [
              "705080204"
            ]
          },
          "705080204": {
            "id": "705080204",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "嗯…忆苦思甜的味道呢。",
            "nextDialogs": [
              "705080205"
            ]
          },
          "705080205": {
            "id": "705080205",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "白手起家的味道？得是什么味儿啊。",
            "nextDialogs": [
              "705080206"
            ]
          },
          "705080206": {
            "id": "705080206",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "呵呵…酸中带甜，余味很足。",
            "nextDialogs": [
              "705080207"
            ]
          },
          "705080207": {
            "id": "705080207",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "唔…做小本生意却发现卖水果赚不到钱的味道？",
            "nextDialogs": [
              "705080208"
            ]
          },
          "705080208": {
            "id": "705080208",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "何必说得那么明白呢。过去的事，就随它去吧。",
            "nextDialogs": [
              "705080209"
            ]
          },
          "705080209": {
            "id": "705080209",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "哈哈，谁能想到高高在上的天权星也有沿街兜售水果的岁月啊。",
            "nextDialogs": [
              "705080210"
            ]
          },
          "705080210": {
            "id": "705080210",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "就像我，看着也不像渔民出身对吧？",
            "nextDialogs": [
              "705080211"
            ]
          },
          "705080211": {
            "id": "705080211",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "怎么会呢。要我说的话…",
            "nextDialogs": [
              "705080212"
            ]
          },
          "705080212": {
            "id": "705080212",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "北斗船长这双一眼看透海水的眼睛，这副乘风破浪勇往直前的热心肠，向来是像极了依海而生的人。",
            "nextDialogs": [
              "705080213"
            ]
          },
          "705080213": {
            "id": "705080213",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "喂喂，这话可不是损我的吧？",
            "nextDialogs": [
              "705080214"
            ]
          },
          "705080214": {
            "id": "705080214",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "损你又没有什么好处。",
            "nextDialogs": [
              "705080215"
            ]
          },
          "705080215": {
            "id": "705080215",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "知道你嘴巴厉害了。今天我请客，你给我点到为止。",
            "nextDialogs": [
              "705080216"
            ]
          },
          "705080216": {
            "id": "705080216",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "嗯…那我想多喝几杯。",
            "nextDialogs": [
              "705080219"
            ]
          },
          "705080219": {
            "id": "705080219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "酒保，安排起来！",
            "nextDialogs": [
              "705080220"
            ]
          },
          "705080220": {
            "id": "705080220",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "气势不错嘛！那我也再来一杯！",
            "nextDialogs": [
              "705080221"
            ]
          },
          "705080221": {
            "id": "705080221",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "蒙德的果汁真不错，要是每天都能喝到该多好。",
            "nextDialogs": [
              "705080222"
            ]
          },
          "705080222": {
            "id": "705080222",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "嗯？开玩笑吗？别告诉我你想开通日落果贸易专线…",
            "nextDialogs": [
              "705080223"
            ]
          },
          "705080223": {
            "id": "705080223",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "听着有趣得很呢。",
            "nextDialogs": [
              "705080224"
            ]
          },
          "705080224": {
            "id": "705080224",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "当真？",
            "nextDialogs": [
              "705080225"
            ]
          },
          "705080225": {
            "id": "705080225",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "玩笑而已。相关贸易早就有一定规模了，不用我出手。",
            "nextDialogs": [
              "705080226"
            ]
          },
          "705080226": {
            "id": "705080226",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "#{NICKNAME}，今天多谢了。哪天你要是想找份闲差，不妨来我身边做专职酒保。",
            "nextDialogs": [
              "705080227"
            ]
          },
          "705080227": {
            "id": "705080227",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "也可以来「死兆星」号上。我们大伙都爱喝酒，你要是过来，就能一起喝酒吃肉了，保证过瘾。",
            "nextDialogs": [
              "705080228"
            ]
          },
          "705080228": {
            "id": "705080228",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "北斗船长这是在跟我竞争人才吗？你这又是何必，想喝旅行者亲自调制的饮品，来群玉阁上就行。",
            "nextDialogs": [
              "705080229"
            ]
          },
          "705080229": {
            "id": "705080229",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（我真受欢迎！）",
            "nextDialogs": [
              "705080230"
            ]
          },
          "705080230": {
            "id": "705080230",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她们好像偷偷把你卖了呢…"
          }
        }
      }
    },

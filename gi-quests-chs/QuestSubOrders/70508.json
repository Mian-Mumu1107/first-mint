  "subQuests": [
    {
      "subId": "7050801",
      "subQuestName": "与卢卡对话，进入酒馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705080101"
        ],
        "dialogs": {
          "705080101": {
            "id": "705080101",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "#哦！这不是{NICKNAME}嘛，来得正好，坐下喝两杯？",
            "nextDialogs": [
              "705080102"
            ]
          },
          "705080102": {
            "id": "705080102",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "能在这里见到你，真叫人高兴。",
            "nextDialogs": [
              "705080103"
            ]
          },
          "705080103": {
            "id": "705080103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "两位怎么会来这里？",
            "nextDialogs": [
              "705080104"
            ]
          },
          "705080104": {
            "id": "705080104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，你们俩该不会是结伴来的吧？",
            "nextDialogs": [
              "705080105"
            ]
          },
          "705080105": {
            "id": "705080105",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "这位大人心血来潮说要好好休个假，就决定来这一带旅游了。",
            "nextDialogs": [
              "705080106"
            ]
          },
          "705080106": {
            "id": "705080106",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "不过嘛，我俩对旅游的理解好像不太一样。山都没上几座，就到这里歇着了，真是富贵病啊。",
            "nextDialogs": [
              "705080107"
            ]
          },
          "705080107": {
            "id": "705080107",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "这话说的，真叫人难过。我可是投你所好，特意挑了能喝酒的地方。",
            "nextDialogs": [
              "705080108"
            ]
          },
          "705080108": {
            "id": "705080108",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "只可惜大船长见多识广，对这座小酒馆意见颇多呢。",
            "nextDialogs": [
              "705080109"
            ]
          },
          "705080109": {
            "id": "705080109",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "好吧，这顿我请，行了吧？",
            "nextDialogs": [
              "705080110"
            ]
          },
          "705080110": {
            "id": "705080110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "北斗要请客？那我们有份吗？",
            "nextDialogs": [
              "705080111"
            ]
          },
          "705080111": {
            "id": "705080111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，我们是酒保啦。",
            "nextDialogs": [
              "705080112"
            ]
          },
          "705080112": {
            "id": "705080112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，习惯性蹭上了…",
            "nextDialogs": [
              "705080113"
            ]
          },
          "705080113": {
            "id": "705080113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "两位贵客，喝点什么？",
            "nextDialogs": [
              "705080114"
            ]
          },
          "705080114": {
            "id": "705080114",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "给我来一小杯桦树吧。最好能酸一些。",
            "nextDialogs": [
              "705080115"
            ]
          },
          "705080115": {
            "id": "705080115",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "大杯的暮色，谢啦。",
            "nextDialogs": [
              "705080116"
            ]
          },
          "705080116": {
            "id": "705080116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明白了，请稍等片刻。"
          }
        }
      }
    },

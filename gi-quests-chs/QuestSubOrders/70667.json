        "dialogs": {
          "706660101": {
            "id": "706660101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "进行突破挑战！",
            "nextDialogs": [
              "706660102"
            ]
          },
          "706660102": {
            "id": "706660102",
            "speakerId": 1713,
            "speakerName": "「小王子」",
            "text": "#喵…「哎呀，要来进行牌手等级突破的试炼吗…嗯，{NICKNAME}确实已经拥有了挑战的资格，那我这就…」",
            "nextDialogs": [
              "706660103"
            ]
          },
          "706660103": {
            "id": "706660103",
            "speakerId": 1713,
            "speakerName": "「小王子」",
            "text": "「这就让恕筠准备突破试炼所用的牌局吧，可要小心应对呀…」"
          }
        }
      }
    },
    {
      "subId": "7066702",
      "subQuestName": "与「小王子」进行突破对局",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706670201"
        ],
        "dialogs": {
          "706670201": {
            "id": "706670201",
            "speakerId": 1713,
            "speakerName": "「小王子」",
            "text": "喵！「真是了不起，恭喜你突破了牌手等级的试炼，现在已经是专家牌手了！」",
            "nextDialogs": [
              "706670202"
            ]
          },
          "706670202": {
            "id": "706670202",
            "speakerId": 1713,
            "speakerName": "「小王子」",
            "text": "「这样就有资格挑战更多的牌手了…对了，虽然之前你就已经可以了，但我再提醒一下，你可以在邀请板悬挂战书…」",
            "nextDialogs": [
              "706670203"
            ]
          },
          "706670203": {
            "id": "706670203",
            "speakerId": 1713,
            "speakerName": "「小王子」",
            "text": "喵…「这样，想要挑战你的牌手都能撕下你的战书。哼，不知道对手是谁的对局，有的时候也是挺有趣的事…」",
            "nextDialogs": [
              "706670204"
            ]
          },
          "706670204": {
            "id": "706670204",
            "speakerId": 1713,
            "speakerName": "「小王子」",
            "text": "「毕竟，相约进行牌局，也是一种相遇的方式。」",
            "nextDialogs": [
              "706680204"
            ]
          },
          "706680204": {
            "id": "706680204",
            "speakerId": 1713,
            "speakerName": "「小王子」",
            "text": "#喵！「啊！扯远了，那么作为专家牌手的特权，现在的{NICKNAME}有资格购买一些牌面好看的不得了的卡…」",
            "nextDialogs": [
              "706670205"
            ]
          },
          "706670205": {
            "id": "706670205",
            "speakerId": 1713,
            "speakerName": "「小王子」",
            "text": "#「嗯嗯…{NICKNAME}，勿忘游乐之心，希望你能感受到『七圣召唤』的乐趣！」"
          }
        }
      }
    },

    {
      "subId": "2230109",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223010901"
        ],
        "dialogs": {
          "223010901": {
            "id": "223010901",
            "speakerId": 2010,
            "speakerName": "茶博士刘苏",
            "text": "说书啊，真是件好玩的事…"
          }
        }
      }
    },
    {
      "subId": "2230103",
      "subQuestName": "向刘苏回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2230104",
      "subQuestName": "听刘苏开新书",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223010701"
        ],
        "dialogs": {
          "223010701": {
            "id": "223010701",
            "speakerId": 2010,
            "speakerName": "茶博士刘苏",
            "text": "各位，欲知后事如何…",
            "nextDialogs": [
              "223010702"
            ]
          },
          "223010702": {
            "id": "223010702",
            "speakerId": 2010,
            "speakerName": "茶博士刘苏",
            "text": "且听，下回分解！"
          }
        }
      }
    },
    {
      "subId": "2230105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223010501"
        ],
        "dialogs": {
          "223010501": {
            "id": "223010501",
            "speakerId": 2010,
            "speakerName": "茶博士刘苏",
            "text": "您还在这呢，哈哈哈，我这书…您觉着怎么样？",
            "nextDialogs": [
              "223010503",
              "223010506"
            ]
          },
          "223010503": {
            "id": "223010503",
            "speakerId": 2010,
            "speakerName": "茶博士刘苏",
            "text": "您看您，《裁雨声》和《海山履云记》，那可都是大部头。",
            "nextDialogs": [
              "223010504"
            ]
          },
          "223010504": {
            "id": "223010504",
            "speakerId": 2010,
            "speakerName": "茶博士刘苏",
            "text": "简简单单三言两语可讲不完，您想听，之后您掐着时间来就成。",
            "nextDialogs": [
              "223010507"
            ]
          },
          "223010507": {
            "id": "223010507",
            "speakerId": 2010,
            "speakerName": "茶博士刘苏",
            "text": "这书还是多谢您帮忙，这些您拿好了，以后还请您来多多捧场。"
          },
          "223010506": {
            "id": "223010506",
            "speakerId": 2010,
            "speakerName": "茶博士刘苏",
            "text": "哈哈，您想听下回分解，那您得常来。"
          }
        }
      }
    },
    {
      "subId": "2230106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223010601"
        ],
        "dialogs": {

            "speakerName": "茶博士刘苏",
            "text": "您还在这呢，哈哈哈，我这书…您觉着怎么样？",
            "nextDialogs": [
              "223010603",
              "223010606"
            ]
          },
          "223010603": {
            "id": "223010603",
            "speakerId": 2010,
            "speakerName": "茶博士刘苏",
            "text": "您看您，《裁雨声》和《海山履云记》，那可都是大部头。",
            "nextDialogs": [
              "223010604"
            ]
          },
          "223010604": {
            "id": "223010604",
            "speakerId": 2010,
            "speakerName": "茶博士刘苏",
            "text": "简简单单三言两语可讲不完，您想听，之后您掐着时间来就成。",
            "nextDialogs": [
              "223010607"
            ]
          },
          "223010607": {
            "id": "223010607",
            "speakerId": 2010,
            "speakerName": "茶博士刘苏",
            "text": "这书还是多谢您帮忙，这些您拿好了，以后还请您来多多捧场。"
          },
          "223010606": {
            "id": "223010606",
            "speakerId": 2010,
            "speakerName": "茶博士刘苏",
            "text": "哈哈，您想听下回分解，那您得常来。"
          }
        }
      }

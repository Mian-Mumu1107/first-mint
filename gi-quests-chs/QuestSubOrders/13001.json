  "subQuests": [
    {
      "subId": "1300101",
      "subQuestName": "寻找机械螃蟹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130010101"
        ],
        "dialogs": {
          "130010101": {
            "id": "130010101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "到了！应该就是这里…咦，那只机械螃蟹呢？",
            "nextDialogs": [
              "130010102"
            ]
          },
          "130010102": {
            "id": "130010102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道是瞒着我们偷偷逃走了吗？",
            "nextDialogs": [
              "130010103"
            ]
          },
          "130010103": {
            "id": "130010103",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "陷阱并没有触发，它应该还在这里…",
            "nextDialogs": [
              "130010104"
            ]
          },
          "130010104": {
            "id": "130010104",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜…",
            "nextDialogs": [
              "130010105"
            ]
          },
          "130010105": {
            "id": "130010105",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜！",
            "nextDialogs": [
              "130010106"
            ]
          },
          "130010106": {
            "id": "130010106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来在这！",
            "nextDialogs": [
              "130010107"
            ]
          },
          "130010107": {
            "id": "130010107",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "看来你和约定的一样，一直在这里等我们回来。",
            "nextDialogs": [
              "130010108"
            ]
          },
          "130010108": {
            "id": "130010108",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "既然这样，我也遵守约定，再给你一枚机械零件。收好，掉了我可不管。",
            "nextDialogs": [
              "130010109"
            ]
          },
          "130010109": {
            "id": "130010109",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜！",
            "nextDialogs": [
              "130010110"
            ]
          },
          "130010110": {
            "id": "130010110",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "满意就行。想拿到更多机械零件，就带我们去污染区深处吧。",
            "nextDialogs": [
              "130010111"
            ]
          },
          "130010111": {
            "id": "130010111",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "我也想看看那里到底发生了什么事，让道成林变成这副样子。"
          }
        }
      }
    },
    {
      "subId": "1300102",
      "subQuestName": "向污染区深处进发",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130010501"
        ],
        "dialogs": {
          "130010501": {
            "id": "130010501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里就是大家说的「污染区」…看起来确实和平时不太一样！",
            "nextDialogs": [
              "130010502"
            ]
          },
          "130010502": {
            "id": "130010502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么说呢…有一种很诡异的感觉。很压抑…",
            "nextDialogs": [
              "130010503"
            ]
          },
          "130010503": {
            "id": "130010503",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "身体有什么不适吗？",
            "nextDialogs": [
              "130010504"
            ]
          },
          "130010504": {
            "id": "130010504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "似乎还好。",
            "nextDialogs": [
              "130010505"
            ]
          },
          "130010505": {
            "id": "130010505",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "那就好。看来和我预期的一样，元素力能够一定程度抵抗污染区的影响。",
            "nextDialogs": [
              "130010506"
            ]
          },
          "130010506": {
            "id": "130010506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "提纳里是怎么知道的？",
            "nextDialogs": [
              "130010507"
            ]
          },
          "130010507": {
            "id": "130010507",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "这段时间我虽然没有深入污染区调查，但也做了不少对照实验。",
            "nextDialogs": [
              "130010508"
            ]
          },
          "130010508": {
            "id": "130010508",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "而来到污染区观察了一段时间，差不多印证了我的猜想。你来看，这些花和平时相比有什么不同？",
            "nextDialogs": [
              "130010511"
            ]
          },
          "130010511": {
            "id": "130010511",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "这种花的学名叫做「须弥蔷薇」，它还有一个外号，叫做「地脉标识」。",
            "nextDialogs": [
              "130010512"
            ]
          },
          "130010512": {
            "id": "130010512",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "因为它很容易受地脉影响，从而发出不同亮度的光。一旦亮度过高，就说明周围的地脉能量进入了危险值。",
            "nextDialogs": [
              "130010513"
            ]
          },
          "130010513": {
            "id": "130010513",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "从现在的情况来看，附近的地脉恐怕已经陷入暴走了吧。",
            "nextDialogs": [
              "130010514"
            ]
          },
          "130010514": {
            "id": "130010514",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也就是说这里的污染，其实是来自于地脉？",
            "nextDialogs": [
              "130010515"
            ]
          },
          "130010515": {
            "id": "130010515",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "还不能确定，但我觉得这种可能性很大。",
            "nextDialogs": [
              "130010516"
            ]
          },
          "130010516": {
            "id": "130010516",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "我们再去附近看看，能不能找到更多线索。"
          }
        }
      }
    },
    {
      "subId": "1300103",
      "subQuestName": "继续前往污染区深处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130010301"
        ],
        "dialogs": {
          "130010301": {
            "id": "130010301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，我们一路走来，好像还没看见几只小动物呢！",
            "nextDialogs": [
              "130010302"
            ]
          },
          "130010302": {
            "id": "130010302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我记得以前林子里鸟叫声很响，而且还有很多小狐狸来着…",
            "nextDialogs": [
              "130010303"
            ]
          },
          "130010303": {
            "id": "130010303",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "目前来看，污染区确实有严重的地脉能量泄漏，这应该是导致病人意识紊乱的主要原因。",
            "nextDialogs": [
              "130010304"
            ]
          },
          "130010304": {
            "id": "130010304",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "有些动物感知很敏锐，在察觉到不对劲后，迅速迁出了这里。",
            "nextDialogs": [
              "130010305"
            ]
          },
          "130010305": {
            "id": "130010305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "地脉能量泄漏，原来会导致这么严重的后果吗？",
            "nextDialogs": [
              "130010306"
            ]
          },
          "130010306": {
            "id": "130010306",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "就像植物有适宜的生长条件，其实人也会逐渐习惯周围的环境。",
            "nextDialogs": [
              "130010307"
            ]
          },
          "130010307": {
            "id": "130010307",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "气候、温度、空气湿度、地脉能量强弱等等，在固定的环境生活，人与周围环境也会达成某种「平衡」。",
            "nextDialogs": [
              "130010308"
            ]
          },
          "130010308": {
            "id": "130010308",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "当周围环境突然变化时，这种平衡被打破，人的身体就会陷入异常。",
            "nextDialogs": [
              "130010309"
            ]
          },
          "130010309": {
            "id": "130010309",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "如果只是正常的气温变化，人体会通过自我调节来适应。但地脉能量骤变，一般人缺乏调节手段，就会生病。",
            "nextDialogs": [
              "130010310"
            ]
          },
          "130010310": {
            "id": "130010310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来是这样。",
            "nextDialogs": [
              "130010311"
            ]
          },
          "130010311": {
            "id": "130010311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那为什么我们没事呢？",
            "nextDialogs": [
              "130010312"
            ]
          },
          "130010312": {
            "id": "130010312",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "#我也不清楚你为什么没事，不过我和{NICKNAME}是因为可以使用元素力，能够更快地适应这种变化。",
            "nextDialogs": [
              "130010313"
            ]
          },
          "130010313": {
            "id": "130010313",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "当然，长时间呆在地脉能量很强的地区，也不是什么好事。能一直在这里自由行动的，可能只有身为机械的它了。",
            "nextDialogs": [
              "130010314"
            ]
          },
          "130010314": {
            "id": "130010314",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜噜？",
            "nextDialogs": [
              "130010315"
            ]
          },
          "130010315": {
            "id": "130010315",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "调查得差不多了。跟我一起找块空旷的地方吧，我想做一点实验。"
          }
        }
      }
    },
    {
      "subId": "1300104",
      "subQuestName": "安装净化装置",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130010401"
        ],
        "dialogs": {
          "130010401": {
            "id": "130010401",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "环境…无风…目标值…正常…",
            "nextDialogs": [
              "130010402"
            ]
          },
          "130010402": {
            "id": "130010402",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "设定完成。很好，感觉有在顺利运转。",
            "nextDialogs": [
              "130010403"
            ]
          },
          "130010403": {
            "id": "130010403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是什么呀？",
            "nextDialogs": [
              "130010404"
            ]
          },
          "130010404": {
            "id": "130010404",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "我做的净化装置。能够吸收多余的地脉能量，暂时稳定这片区域的平衡。",
            "nextDialogs": [
              "130010405"
            ]
          },
          "130010405": {
            "id": "130010405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有这种好东西！那我们多布几个，争取把整个污染区都布满！",
            "nextDialogs": [
              "130010406"
            ]
          },
          "130010406": {
            "id": "130010406",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "如果这样有用，我倒是不介意。可「污染」一旦产生，就不是几个装置能解决的了。",
            "nextDialogs": [
              "130010407"
            ]
          },
          "130010407": {
            "id": "130010407",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "净化装置也有极限，最多在一定时间内阻止污染区继续扩张。",
            "nextDialogs": [
              "130010408"
            ]
          },
          "130010408": {
            "id": "130010408",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "想要彻底解决地脉泄漏带来的污染，还是要从根源下手。",
            "nextDialogs": [
              "130010409"
            ]
          },
          "130010409": {
            "id": "130010409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就是我们要去的污染区深处？",
            "nextDialogs": [
              "130010410"
            ]
          },
          "130010410": {
            "id": "130010410",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "没错。",
            "nextDialogs": [
              "130010411"
            ]
          },
          "130010411": {
            "id": "130010411",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜噜？",
            "nextDialogs": [
              "130010412"
            ]
          },
          "130010412": {
            "id": "130010412",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜！",
            "nextDialogs": [
              "130010413"
            ]
          },
          "130010413": {
            "id": "130010413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，感觉机械螃蟹好像有点不太对劲。",
            "nextDialogs": [
              "130010414"
            ]
          },
          "130010414": {
            "id": "130010414",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "有东西正在接近…",
            "nextDialogs": [
              "130010415"
            ]
          },
          "130010415": {
            "id": "130010415",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "原来如此，地脉能量稳定下来后，暂时离开的怪物也重新聚集过来了。",
            "nextDialogs": [
              "130010416"
            ]
          },
          "130010416": {
            "id": "130010416",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "迅速清理掉，别让它们靠近净化装置！"
          }
        }
      }
    },

          "130010801"
        ],
        "dialogs": {
          "130010801": {
            "id": "130010801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…总算搞定了。",
            "nextDialogs": [
              "130010802"
            ]
          },
          "130010802": {
            "id": "130010802",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜！",
            "nextDialogs": [
              "130010803"
            ]
          },
          "130010803": {
            "id": "130010803",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜！",
            "nextDialogs": [
              "130010804"
            ]
          },
          "130010804": {
            "id": "130010804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，你要去哪——等等我们呀！",
            "nextDialogs": [

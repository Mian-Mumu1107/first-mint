    {
      "subId": "1300109",
      "subQuestName": "与受困之人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130010901"
        ],
        "dialogs": {
          "130010901": {
            "id": "130010901",
            "speakerId": 12612,
            "speakerName": "杰萨尔",
            "text": "啊啊…饶过我，饶我一命！",
            "nextDialogs": [
              "130010902"
            ]
          },
          "130010902": {
            "id": "130010902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，你没事吧？",
            "nextDialogs": [
              "130010903"
            ]
          },
          "130010903": {
            "id": "130010903",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "伤势不重。别动，我帮你包扎…",
            "nextDialogs": [
              "130010904"
            ]
          },
          "130010904": {
            "id": "130010904",
            "speakerId": 12612,
            "speakerName": "杰萨尔",
            "text": "你们是？那些机械怪物呢？",
            "nextDialogs": [
              "130010905"
            ]
          },
          "130010905": {
            "id": "130010905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "放心吧，已经被我们都打倒了！",
            "nextDialogs": [
              "130010906"
            ]
          },
          "130010906": {
            "id": "130010906",
            "speakerId": 12612,
            "speakerName": "杰萨尔",
            "text": "那就好。哈哈…那就好…",
            "nextDialogs": [
              "130010907"
            ]
          },
          "130010907": {
            "id": "130010907",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜！",
            "nextDialogs": [
              "130010908"
            ]
          },
          "130010908": {
            "id": "130010908",
            "speakerId": 12612,
            "speakerName": "杰萨尔",
            "text": "怪物啊——快，快打倒它！",
            "nextDialogs": [
              "130010909"
            ]
          },
          "130010909": {
            "id": "130010909",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜噜？",
            "nextDialogs": [
              "130010910"
            ]
          },
          "130010910": {
            "id": "130010910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么说呢？这家伙不是坏人啦。",
            "nextDialogs": [
              "130010911"
            ]
          },
          "130010911": {
            "id": "130010911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚刚就是它听到你的求救声，才带我们来救你的。",
            "nextDialogs": [
              "130010912"
            ]
          },
          "130010912": {
            "id": "130010912",
            "speakerId": 12612,
            "speakerName": "杰萨尔",
            "text": "装的，肯定是装的。说不定它是想加入那些机械怪物，一起来要我的命！",
            "nextDialogs": [
              "130010913"
            ]
          },
          "130010913": {
            "id": "130010913",
            "speakerId": 12612,
            "speakerName": "杰萨尔",
            "text": "你们知道森林深处是什么吗？到处都是、到处都是机械怪物啊——",
            "nextDialogs": [
              "130010914"
            ]
          },
          "130010914": {
            "id": "130010914",
            "speakerId": 12612,
            "speakerName": "杰萨尔",
            "text": "我本来只是想采药，不小心转到了污染区，差点连命都丢了。",
            "nextDialogs": [
              "130010915"
            ]
          },
          "130010915": {
            "id": "130010915",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "……",
            "nextDialogs": [
              "130010916"
            ]
          },
          "130010916": {
            "id": "130010916",
            "speakerId": 12612,
            "speakerName": "杰萨尔",
            "text": "我得跑。对，我得从这里逃出去…",
            "nextDialogs": [
              "130010917"
            ]
          },
          "130010917": {
            "id": "130010917",
            "speakerId": 12612,
            "speakerName": "杰萨尔",
            "text": "你们也小心点。这种机械生物都不是什么好东西，越早离开它越好！",
            "nextDialogs": [
              "130010918"
            ]
          },
          "130010918": {
            "id": "130010918",
            "speakerId": 12612,
            "speakerName": "杰萨尔",
            "text": "难怪前几年，教令院要彻底禁止机械生命存在。这些东西就应该被彻底销毁…",
            "nextDialogs": [
              "130010919"
            ]
          },
          "130010919": {
            "id": "130010919",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂——",
            "nextDialogs": [
              "130010920"
            ]
          },
          "130010920": {
            "id": "130010920",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "口齿不清、身体发抖，看来是在污染区呆的时间太久，有些意识紊乱。",
            "nextDialogs": [
              "130010921"
            ]
          },
          "130010921": {
            "id": "130010921",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "那边的地脉能量我们净化过了，顺着这条路跑出去，很快就能看到村子。",
            "nextDialogs": [
              "130010922"
            ]
          },
          "130010922": {
            "id": "130010922",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "到时候会有人带着他去找柯莱求救。我已经预先留好了药剂，服下就能恢复正常。",
            "nextDialogs": [
              "130010923"
            ]
          },
          "130010923": {
            "id": "130010923",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜！",
            "nextDialogs": [
              "130010926"
            ]
          },
          "130010926": {
            "id": "130010926",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "嗯…你觉得自己做了「正确的事」，想要零件作为奖励？",
            "nextDialogs": [
              "130010927"
            ]
          },
          "130010927": {
            "id": "130010927",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜！",
            "nextDialogs": [
              "130010928"
            ]
          },
          "130010928": {
            "id": "130010928",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好难理解啊…",
            "nextDialogs": [
              "130010929"
            ]
          },
          "130010929": {
            "id": "130010929",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "好吧，不管你怎么想的，这次你确实立了功。",
            "nextDialogs": [
              "130010930"
            ]
          },
          "130010930": {
            "id": "130010930",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "既然这样，我再给你一个机械零件。需要我帮你换上吗？",
            "nextDialogs": [
              "130010931"
            ]
          },
          "130010931": {
            "id": "130010931",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜咕噜。",
            "nextDialogs": [
              "130010932"
            ]
          },
          "130010932": {
            "id": "130010932",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "看来是不需要，那你自己好好收着吧。你的主人怎么把你造成这个样子？感觉你不像螃蟹，倒像是短尾仓鼠。",
            "nextDialogs": [
              "130010933"
            ]
          },
          "130010933": {
            "id": "130010933",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "还有，刚刚那个人说你和其他机械生命一样凶恶，你有什么感想吗？",
            "nextDialogs": [
              "130010934"
            ]
          },
          "130010934": {
            "id": "130010934",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜噜？",
            "nextDialogs": [
              "130010935"
            ]
          },
          "130010935": {
            "id": "130010935",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，它好像压根没听懂。",
            "nextDialogs": [
              "130010936"
            ]
          },
          "130010936": {
            "id": "130010936",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "现在看来，它大概只能略微理解一点和机械零件有关的事情。",
            "nextDialogs": [
              "130010937"
            ]
          },
          "130010937": {
            "id": "130010937",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "「帮助别人就能获得零件」，我猜它是这么想的。至于它…或者说它的主人收集那么多零件做什么，就不清楚了。",
            "nextDialogs": [
              "130010938"
            ]
          },
          "130010938": {
            "id": "130010938",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "天色不早，我们先在附近搭帐篷过夜吧。休息一晚，明天再往深处探索。"
          }
        }
      }
    },
    {
      "subId": "1300105",
      "subQuestName": "寻找适合搭帐篷的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1300112",
      "subQuestName": "准备露营",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130011201"
        ],
        "dialogs": {
          "130011201": {
            "id": "130011201",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "露营地点就选在这里吧。",
            "nextDialogs": [
              "130011202"
            ]
          },
          "130011202": {
            "id": "130011202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶！我也觉得这里很合适呢！",
            "nextDialogs": [
              "130011203"
            ]
          },
          "130011203": {
            "id": "130011203",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "哦？有什么理由吗？",
            "nextDialogs": [
              "130011204"
            ]
          },
          "130011204": {
            "id": "130011204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉这里很平整，而且很宽敞，可以搭一个大大的帐篷！",
            "nextDialogs": [
              "130011205"
            ]
          },
          "130011205": {
            "id": "130011205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还可以在这里支一口锅，做好多好多好吃的！",
            "nextDialogs": [
              "130011206"
            ]
          },
          "130011206": {
            "id": "130011206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是派蒙会给出的理由。",
            "nextDialogs": [
              "130011207"
            ]
          },
          "130011207": {
            "id": "130011207",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "倒也没错。不过选择这里最主要的原因，是这里的地势相对较高，可以隔开下面的水汽。",
            "nextDialogs": [
              "130011208"
            ]
          },
          "130011208": {
            "id": "130011208",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "雨林中很潮湿，在潮湿的地方过夜，总是要加倍小心。",
            "nextDialogs": [
              "130011209"
            ]
          },
          "130011209": {
            "id": "130011209",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "#接下来我们分头行动吧。我去把帐篷搭起来，{NICKNAME}负责生火，派蒙去附近找点吃的。",
            "nextDialogs": [
              "130011210"
            ]
          },
          "130011210": {
            "id": "130011210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "交给我吧！这我可最擅长了！",
            "nextDialogs": [
              "130011211"
            ]
          },
          "130011211": {
            "id": "130011211",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "我没抱太大期望，量力而行就好。",
            "nextDialogs": [
              "130011212"
            ]
          },
          "130011212": {
            "id": "130011212",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "在提纳里的指导下顺利生起了火…",
            "nextDialogs": [
              "130011213"
            ]
          },
          "130011213": {
            "id": "130011213",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "没错，野外生火的时候，可以用灯心草的芯。",
            "nextDialogs": [
              "130011214"
            ]
          },
          "130011214": {
            "id": "130011214",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "这种植物的茎髓相对干燥，可以直接点燃，虽然烟会有点大。",
            "nextDialogs": [
              "130011215"
            ]
          },
          "130011215": {
            "id": "130011215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呜呜…{NICKNAME}，提纳里，我没有找到吃的。",
            "nextDialogs": [
              "130011216"
            ]
          },
          "130011216": {
            "id": "130011216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的到雨林里，才发现这里奇怪的植物好多！各种长相古怪的蘑菇，我也不知道哪些能吃。",
            "nextDialogs": [
              "130011217"
            ]
          },
          "130011217": {
            "id": "130011217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我还在地上看到了野果，本来想飞过去捡起来，结果上面的枯叶突然动了，吓了我一大跳！",
            "nextDialogs": [
              "130011218"
            ]
          },
          "130011218": {
            "id": "130011218",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "应该是枯叶蝶之类的生物吧，伪装成树叶，以此来躲避天敌。",
            "nextDialogs": [
              "130011219"
            ]
          },
          "130011219": {
            "id": "130011219",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "估计是看你飞在天上，把你当成了某种鸟类，看你飞过来就想逃走，没想到你比它更胆小。",
            "nextDialogs": [
              "130011220"
            ]
          },
          "130011220": {
            "id": "130011220",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "算了，帐篷我搭好了，你们在这休息一下，我去找点吃的。",
            "nextDialogs": [
              "130011221"
            ]
          },
          "130011221": {
            "id": "130011221",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜！",
            "nextDialogs": [
              "130011222"
            ]
          },
          "130011222": {
            "id": "130011222",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "嗯？你已经找来了啊。",
            "nextDialogs": [
              "130011226",
              "130011225"
            ]
          },
          "130011226": {
            "id": "130011226",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜！",
            "nextDialogs": [
              "130011227"
            ]
          },
          "130011227": {
            "id": "130011227",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这回我听懂了，它又想要机械零件！",
            "nextDialogs": [
              "130011228"
            ]
          },
          "130011228": {
            "id": "130011228",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "抱歉，这次没有。",
            "nextDialogs": [
              "130011229"
            ]
          },
          "130011229": {
            "id": "130011229",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜噜？",
            "nextDialogs": [
              "130011230"
            ]
          },
          "130011230": {
            "id": "130011230",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "这次帮的忙不够重要。如果做什么事都提供奖励的话，或许会让它产生取巧的想法。",
            "nextDialogs": [
              "130011231"
            ]
          },
          "130011231": {
            "id": "130011231",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "所以像这样的小事，就暂时记下，等下次再一起给。",
            "nextDialogs": [
              "130011232"
            ]
          },
          "130011232": {
            "id": "130011232",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道是零件所剩不多…",
            "nextDialogs": [
              "130011233"
            ]
          },
          "130011233": {
            "id": "130011233",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "咳，这个也是原因之一。",
            "nextDialogs": [
              "130011234"
            ]
          },
          "130011234": {
            "id": "130011234",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜…",
            "nextDialogs": [
              "130011235"
            ]
          },
          "130011235": {
            "id": "130011235",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它好像很难过的样子…",
            "nextDialogs": [
              "130011236"
            ]
          },
          "130011236": {
            "id": "130011236",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "…仔细想想，如果不给的话，也可能会让它产生什么奇怪的误会。既然这样，那就再给你一个好了。",
            "nextDialogs": [
              "130011237"
            ]
          },
          "130011237": {
            "id": "130011237",
            "speakerId": 1002,
            "speakerName": "机械螃蟹",
            "text": "咕噜！",
            "nextDialogs": [
              "130011238"
            ]
          },
          "130011238": {
            "id": "130011238",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "我去准备晚餐。今晚轮流守夜，前半夜你们先休息吧，后半夜我会叫你们。",
            "nextDialogs": [
              "130011239"
            ]
          },
          "130011239": {
            "id": "130011239",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "需要守夜吗？",
            "nextDialogs": [
              "130011240"
            ]
          },
          "130011240": {
            "id": "130011240",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "需要。",
            "nextDialogs": [
              "130011241"
            ]
          },
          "130011241": {
            "id": "130011241",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "虽然受地脉影响，许多动物暂时逃了出去，但也不能完全放松警惕。",
            "nextDialogs": [
              "130011242"
            ]
          },
          "130011242": {
            "id": "130011242",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "就这样定了。之后我还会在周围布置一些驱虫装置，防备毒虫爬进帐篷。",
            "nextDialogs": [
              "130011243"
            ]
          },
          "130011243": {
            "id": "130011243",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "祝你们睡个好觉，不过也别睡过头了。"
          },
          "130011225": {
            "id": "130011225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！"
          }
        }
      }
    },
    {
      "subId": "1300110",
      "subQuestName": "进入帐篷休息",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130011301"
        ],
        "dialogs": {
          "130011301": {
            "id": "130011301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我还真有些困了…啊！会不会是受地脉的影响呢？",
            "nextDialogs": [
              "130011302"
            ]
          },
          "130011302": {
            "id": "130011302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过好久没有像这样，一起在野外露营啦！",
            "nextDialogs": [
              "130011303"
            ]
          },
          "130011303": {
            "id": "130011303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嘿嘿…感觉像是回到了刚刚开始冒险的时候！晚安，{NICKNAME}！",
            "nextDialogs": [
              "130011304"
            ]
          },
          "130011304": {
            "id": "130011304",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "在派蒙的念叨中逐渐睡去…"
          }
        }
      }
    },
    {
      "subId": "1300111",
      "subQuestName": "与提纳里对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130011101"
        ],
        "dialogs": {
          "130011101": {
            "id": "130011101",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "嗯？比我预想的交接时间要早。睡得还好吗？",
            "nextDialogs": [
              "130011103",
              "130011106"
            ]
          },
          "130011103": {
            "id": "130011103",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "那就好。担心你们睡不安稳，我特地用了两种自制的熏香。",
            "nextDialogs": [
              "130011104"
            ]
          },
          "130011104": {
            "id": "130011104",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "放心，都是用天然植物做的。香味虽然很淡，但对身体没什么损害。",
            "nextDialogs": [
              "130011110"
            ]
          },
          "130011110": {
            "id": "130011110",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "说起来，你看到那只机械螃蟹了吗？",
            "nextDialogs": [
              "130011111"
            ]
          },
          "130011111": {
            "id": "130011111",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "刚刚它还在那边跑来跑去，现在又不知道跑到哪里去了。",
            "nextDialogs": [
              "130011112"
            ]
          },
          "130011112": {
            "id": "130011112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "提纳里在戒备它吗？",
            "nextDialogs": [
              "130011113"
            ]
          },
          "130011113": {
            "id": "130011113",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "你看出来了啊。不过与其说是戒备它，不如说是戒备它那位没有露面的「主人」。",
            "nextDialogs": [
              "130011114"
            ]
          },
          "130011114": {
            "id": "130011114",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "这样大规模的地脉泄漏事件毫无征兆地出现，很有可能是有人破坏了地脉流动的「规则」。",
            "nextDialogs": [
              "130011115"
            ]
          },
          "130011115": {
            "id": "130011115",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "在没有调查清楚之前，还是小心点好。教令院废止机械生命研究已经好几年了，这些家伙的来历很可疑。"
          },
          "130011106": {
            "id": "130011106",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "在危险的地方需要时刻保持清醒，总是打哈欠可不行。",
            "nextDialogs": [
              "130011107"
            ]
          },
          "130011107": {
            "id": "130011107",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "如果坚持不住的话，可以回去再休息一会儿，我还不困。",
            "nextDialogs": [
              "130011108"
            ]
          },
          "130011108": {
            "id": "130011108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能坚持住。",
            "nextDialogs": [
              "130011109"
            ]
          },
          "130011109": {
            "id": "130011109",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "是吗？不用勉强，因为许多动植物只能在夜里观察，所以我也习惯熬夜了。"
          }
        }
      }
    },
    {
      "subId": "1300114",
      "subQuestName": "拿回驱虫装置",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130011401"
        ],
        "dialogs": {
          "130011401": {
            "id": "130011401",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "嗯？你们还不睡吗？"
          }
        }
      }
    },
    {
      "subId": "1300116",
      "subQuestName": "准备出发",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130011601"
        ],
        "dialogs": {
          "130011601": {
            "id": "130011601",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "回收了昨晚布置的驱虫装置…",
            "nextDialogs": [
              "130011602"
            ]
          },
          "130011602": {
            "id": "130011602",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "嗯，差不多该动身出发了。继续向深处走，可能会遇到更多失控的机械。",
            "nextDialogs": [
              "130011603"
            ]
          },
          "130011603": {
            "id": "130011603",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "地脉的影响也在不断加重。支撑不住的话，避开战斗也是合理的考虑。",
            "nextDialogs": [
              "130011604"
            ]
          },
          "130011604": {
            "id": "130011604",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "在抵达污染源头之前，尽可能保存体力吧。"
          }
        }
      }
    },
    {
      "subId": "1300117",
      "subQuestName": "前往污染区深处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130011701"
        ],
        "dialogs": {
          "130011701": {
            "id": "130011701",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "看来只能等回去再说了…",
            "nextDialogs": [
              "130011702"
            ]
          },
          "130011702": {
            "id": "130011702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么事了？",
            "nextDialogs": [
              "130011704"
            ]
          },
          "130011704": {
            "id": "130011704",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "刚刚才想起来睡前没有给尾巴涂植物精油。你也注意到了吧，与平时相比，少了些亮闪闪的感觉。",
            "nextDialogs": [
              "130011705"
            ]
          },
          "130011705": {
            "id": "130011705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没看出来…",
            "nextDialogs": [
              "130011706"
            ]
          },
          "130011706": {
            "id": "130011706",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "嗯…也是，一个晚上影响不会太大。",
            "nextDialogs": [
              "130011707"
            ]
          },
          "130011707": {
            "id": "130011707",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "等回去后调制一款新的植物精油，应该就能弥补。正好上个月买的药材应该还有剩…"
          }
        }
      }
    },
    {
      "subId": "1300118",
      "subQuestName": "击败拦路的魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {

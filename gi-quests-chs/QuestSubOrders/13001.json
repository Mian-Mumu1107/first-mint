        ],
        "dialogs": {
          "130012301": {
            "id": "130012301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "该怎么灭火呢…"
          }
        }
      }
    },
    {
      "subId": "1300124",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130012401"
        ],
        "dialogs": {
          "130012401": {
            "id": "130012401",
            "speakerId": 12597,
            "speakerName": "亚拉",
            "text": "谢谢你们，我感觉好多啦。"
          }
        }
      }
    },
    {
      "subId": "1300125",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130012501"
        ],
        "dialogs": {
          "130012501": {
            "id": "130012501",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "我一定能做好的。我一定能做好的…"
          }
        }
      }
    },
    {
      "subId": "1300126",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130012601"
        ],
        "dialogs": {
          "130012601": {
            "id": "130012601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶，火已经熄灭了，接下来是把锅收起来…"
          }
        }
      }
    },
    {
      "subId": "1300127",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130012701"
        ],
        "dialogs": {
          "130012701": {
            "id": "130012701",
            "speakerId": 12598,
            "speakerName": "阿莎",
            "text": "（阿莎口中念念有词，似乎在祈祷孩子早日康复。）"
          }
        }
      }
    },
    {
      "subId": "1300199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130019901"
        ],
        "dialogs": {
          "130019901": {
            "id": "130019901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "机械螃蟹往那边跑了，我们快跟上去吧！",
            "nextDialogs": [
              "130019903"
            ]
          },
          "130019903": {
            "id": "130019903",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "喂——这边——",
            "nextDialogs": [
              "130019904"
            ]
          },
          "130019904": {
            "id": "130019904",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "笨。抬头，往上看！",
            "nextDialogs": [
              "130019905"
            ]
          },
          "130019905": {
            "id": "130019905",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "果然，越靠近污染源头，机械怪物出现的频率越高…"
          }
        }
      }
    }

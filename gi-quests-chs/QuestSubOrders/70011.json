        ],
        "dialogs": {
          "700110101": {
            "id": "700110101",
            "speakerId": 1000,
            "speakerName": "警惕的丘丘人",
            "text": "Yaya dala! Kundala?",
            "nextDialogs": [
              "700110102"
            ]
          },
          "700110102": {
            "id": "700110102",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "Mimi nye odomu! Kundala nye!",
            "nextDialogs": [
              "700110103"
            ]
          },
          "700110103": {
            "id": "700110103",
            "speakerId": 1000,
            "speakerName": "警惕的丘丘人",
            "text": "Nye Odomu? Yoyo mani mi?",
            "nextDialogs": [
              "700110104"
            ]
          },
          "700110104": {
            "id": "700110104",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "Mimi tomo, mimi plata odomu! Mimi mani ye!",
            "nextDialogs": [
              "700110105"
            ]
          },
          "700110105": {
            "id": "700110105",
            "speakerId": 1000,
            "speakerName": "警惕的丘丘人",
            "text": "Mani…? Zido mi, mi dada. Nye kundala? Mi plata yeye!",
            "nextDialogs": [
              "700110106"
            ]
          },
          "700110106": {
            "id": "700110106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…这家伙脾气好差！",
            "nextDialogs": [
              "700110109"
            ]
          },
          "700110109": {
            "id": "700110109",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "请别冲动，没关系的。我完全理解了。",
            "nextDialogs": [
              "700110110"
            ]
          },
          "700110110": {
            "id": "700110110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…？",
            "nextDialogs": [
              "700110111"
            ]
          },
          "700110111": {
            "id": "700110111",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "它想要我们帮忙打败敌人而已，就在地图的…这个位置。",
            "nextDialogs": [
              "700110113"
            ]
          },
          "700110113": {
            "id": "700110113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来如此…",
            "nextDialogs": [
              "700110114"
            ]
          },
          "700110114": {
            "id": "700110114",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "那家伙的位置已经在地图上标好了，我就先回去啦！",
            "nextDialogs": [
              "700110115"
            ]
          },
          "700110115": {
            "id": "700110115",
            "speakerId": 1000,
            "speakerName": "警惕的丘丘人",
            "text": "Dada, Valo!"
          }
        }
      }
    },
    {
      "subId": "7001102",

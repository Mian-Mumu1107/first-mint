          "700110202": {
            "id": "700110202",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "Mimi muhe du, du ya Wei zido dala si.",
            "nextDialogs": [
              "700110203"
            ]
          },
          "700110203": {
            "id": "700110203",
            "speakerId": 1000,
            "speakerName": "警惕的丘丘人",
            "text": "Mi mito nye. Mi mito ya zido mito, beru ya!",
            "nextDialogs": [
              "700110204"
            ]
          },
          "700110204": {
            "id": "700110204",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "它也不知道，不过我们可以找它认识的人问一问。",
            "nextDialogs": [
              "700110205"
            ]
          },
          "700110205": {
            "id": "700110205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Valo!",
            "nextDialogs": [
              "700110206"
            ]
          },
          "700110206": {
            "id": "700110206",
            "speakerId": 1000,
            "speakerName": "警惕的丘丘人",
            "text": "Valo, mimi tomo!"
          }
        }
      }

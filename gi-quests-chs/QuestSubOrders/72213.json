      }
    },
    {
      "subId": "7221305",
      "subQuestName": "将三份铁矿石交给大岛纯平",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722130501"
        ],
        "dialogs": {
          "722130501": {
            "id": "722130501",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "太好了，有这些铁块就足够了。",
            "nextDialogs": [
              "722130502"
            ]
          },
          "722130502": {
            "id": "722130502",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "等会我就去外面找个合适的位置搭炉，然后制作工具。",
            "nextDialogs": [
              "722130503"
            ]
          },
          "722130503": {
            "id": "722130503",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "请你们代我去向代宫司大人说一声吧，我先在这里收拾收拾。"
          }
        }
      }
    },
    {
      "subId": "7221304",
      "subQuestName": "向寝子回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722130601"
        ],
        "dialogs": {
          "722130601": {
            "id": "722130601",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "喵喵喵，有什么事吗？奴家会准备充足的「抱愁」的。",
            "nextDialogs": [
              "722130605",
              "722130604"
            ]
          },
          "722130605": {
            "id": "722130605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总之，石头人…大岛先生的工具坏了。不过我们已经给他维修的材料了，应该没什么问题！",
            "nextDialogs": [
              "722130606"
            ]
          },
          "722130606": {
            "id": "722130606",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "问题？有什么问题吗？"
          },
          "722130604": {
            "id": "722130604",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "啊？多少是什么意思？"
          }
        }
      }
    },
    {
      "subId": "7221302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722130201"
        ],
        "dialogs": {
          "722130201": {
            "id": "722130201",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "「抱愁」对人类来说很重要，奴家记住了。"
          }
        }
      }
    },
    {
      "subId": "7221304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722130401"
        ],
        "dialogs": {
          "722130401": {
            "id": "722130401",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "怎么样，你们找到三份铁块了吗？"
          }
        }
      }
    }
  ]
}
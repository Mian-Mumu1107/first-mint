  },
  "subQuests": [
    {
      "subId": "7221301",
      "subQuestName": "test 与寝子对话 隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722130101"
        ],
        "dialogs": {
          "722130101": {
            "id": "722130101",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "「抱愁」…",
            "nextDialogs": [
              "722130102"
            ]
          },
          "722130102": {
            "id": "722130102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "雕像如何了？",
            "nextDialogs": [
              "722130103"
            ]
          },
          "722130103": {
            "id": "722130103",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "那个石头人类可真厉害啊，喵喵喵。",
            "nextDialogs": [
              "722130104"
            ]
          },
          "722130104": {
            "id": "722130104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经做好了吗？",
            "nextDialogs": [
              "722130105"
            ]
          },
          "722130105": {
            "id": "722130105",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "不是，只是转眼间就弄来了一块好大好大的石头。",
            "nextDialogs": [
              "722130106"
            ]
          },
          "722130106": {
            "id": "722130106",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "然后念叨着，「宫前」、「抱愁」之类的东西，然后一边对着石头咚咚咚。",
            "nextDialogs": [
              "722130107"
            ]
          },
          "722130107": {
            "id": "722130107",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "说起来，请汝回答奴家吧。「宫前」、「抱愁」到底是什么呢？",
            "nextDialogs": [
              "722130108"
            ]
          },
          "722130108": {
            "id": "722130108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是「工钱」、「报酬」吧。",
            "nextDialogs": [
              "722130109"
            ]
          },
          "722130109": {
            "id": "722130109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也就是为了报答他的劳动，给他的好东西。",
            "nextDialogs": [
              "722130110"
            ]
          },
          "722130110": {
            "id": "722130110",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "是这样吗？人类原来讲究这个啊…那好吧，奴家就恩准他摸奴家的耳朵好了。",
            "nextDialogs": [
              "722130111"
            ]
          },
          "722130111": {
            "id": "722130111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可、可能不太够…",
            "nextDialogs": [
              "722130112"
            ]
          },
          "722130112": {
            "id": "722130112",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "不够吗？那，汝给他…吃的东西好了。",
            "nextDialogs": [
              "722130113"
            ]
          },
          "722130113": {
            "id": "722130113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可能他想要的是钱…",
            "nextDialogs": [
              "722130114"
            ]
          },
          "722130114": {
            "id": "722130114",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "钱？这种东西不是用来放进「塞钱箱」的吗？真奇怪，人类竟然中意这个。",
            "nextDialogs": [
              "722130115"
            ]
          },
          "722130115": {
            "id": "722130115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "工钱是很重要的。",
            "nextDialogs": [
              "722130116"
            ]
          },
          "722130116": {
            "id": "722130116",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "哼，汝姑且也帮奴家做了不少事，奴家相信汝便是。回头，奴家再跟他谈谈。",
            "nextDialogs": [
              "722130117"
            ]
          },
          "722130117": {
            "id": "722130117",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "不过，石头人类现在没有咚咚咚了。看他拿着好短的木头棍子，不知道在做什么。",
            "nextDialogs": [
              "722130118"
            ]
          },
          "722130118": {
            "id": "722130118",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "木头棍子？雕塑不是要用锤子、凿子之类的东西吗？",
            "nextDialogs": [
              "722130119"
            ]
          },
          "722130119": {
            "id": "722130119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难不成工具坏了…",
            "nextDialogs": [
              "722130120"
            ]
          },
          "722130120": {
            "id": "722130120",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#那{NICKNAME}，我们去找大岛先生吧！说不定我们能帮上什么忙！"
          }
        }
      }
    },
    {
      "subId": "7221302",
      "subQuestName": "询问大岛纯平",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722130301"
        ],
        "dialogs": {
          "722130301": {
            "id": "722130301",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "唉，这没锤子，没凿子，怎么干活呢…",
            "nextDialogs": [
              "722130302"
            ]
          },
          "722130302": {
            "id": "722130302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "遇见什么难题了吗？",
            "nextDialogs": [
              "722130303"
            ]
          },
          "722130303": {
            "id": "722130303",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "喔，是你们啊。哎呀…真是大意了，来的时候没检查工具，结果工作的时候太入神，不小心把锤子和凿子都弄坏了…",
            "nextDialogs": [
              "722130304"
            ]
          },
          "722130304": {
            "id": "722130304",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "虽然我也想回去鸣神岛买点工具，但是…",
            "nextDialogs": [
              "722130305"
            ]
          },
          "722130305": {
            "id": "722130305",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "怎么说呢…雕刻雕像这种事情，我习惯一口气做好。",
            "nextDialogs": [
              "722130306"
            ]
          },
          "722130306": {
            "id": "722130306",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "虽然锤子和凿子坏了，但我还能稍微比划一下，想一想后面怎么雕刻。",
            "nextDialogs": [
              "722130307"
            ]
          },
          "722130307": {
            "id": "722130307",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "要是现在离开这座雕像，去鸣神岛买工具的话…回来之后，我又要从头回忆雕刻的手感了…",
            "nextDialogs": [
              "722130308"
            ]
          },
          "722130308": {
            "id": "722130308",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "而且，这块石头的质地也太硬了，用一般的工具雕刻的话，工具肯定还是会很快坏掉。",
            "nextDialogs": [
              "722130309"
            ]
          },
          "722130309": {
            "id": "722130309",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "唔…没办法了…",
            "nextDialogs": [
              "722130310"
            ]
          },
          "722130310": {
            "id": "722130310",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "旅行者，能请你们去帮我找三份铁块回来吗？",
            "nextDialogs": [
              "722130311"
            ]
          },
          "722130311": {
            "id": "722130311",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "我得想个办法，自己亲手造几份可靠的工具才行。",
            "nextDialogs": [
              "722130313",
              "722130315"
            ]
          },
          "722130313": {
            "id": "722130313",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "喔！那就拜托你们了！"
          },
          "722130315": {
            "id": "722130315",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "我好歹也是在踏鞴砂做工的，锻冶当然也会一些。",
            "nextDialogs": [
              "722130316"
            ]
          },
          "722130316": {
            "id": "722130316",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "不过，我可不能在神社开炉，不然代宫司大人准会生气…嘿嘿，毕竟它是猫嘛。",
            "nextDialogs": [
              "722130317"
            ]
          },
          "722130317": {
            "id": "722130317",
            "speakerId": 1002,
            "speakerName": "大岛纯平",
            "text": "总之，请你先找三份铁块给我吧。"
          }
        }
      }
    },
    {
      "subId": "7221303",
      "subQuestName": "将三份铁矿石交给大岛纯平",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

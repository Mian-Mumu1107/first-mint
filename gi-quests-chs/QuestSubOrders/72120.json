  },
  "subQuests": [
    {
      "subId": "7212001",
      "subQuestName": "（test）隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721200101"
        ],
        "dialogs": {
          "721200101": {
            "id": "721200101",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "很好！上次的试验很顺利，「鬼兜虫」上的「祟神」被干净利落地净化了。",
            "nextDialogs": [
              "721200102"
            ]
          },
          "721200102": {
            "id": "721200102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我们现在…",
            "nextDialogs": [
              "721200103"
            ]
          },
          "721200103": {
            "id": "721200103",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "我们现在只需要规划好前进路线，就可以正式开工了。但这条路线必须得绕开那些愚人众才行…看来得绕点远路了…",
            "nextDialogs": [
              "721200104"
            ]
          },
          "721200104": {
            "id": "721200104",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "毕竟这家伙…还挺大的，我们两个人想要把它搬进去的话，可先得保证运送道路的通畅才行。",
            "nextDialogs": [
              "721200105"
            ]
          },
          "721200105": {
            "id": "721200105",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "所以，我想拜托您再去「御影炉心」附近调查一下，如果遇见坏掉的道路，最好能稍微维修一下。",
            "nextDialogs": [
              "721200106"
            ]
          },
          "721200106": {
            "id": "721200106",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "虽然我还没规划好路线…但我们最好能保证大部分道路都是通畅的。",
            "nextDialogs": [
              "721200107"
            ]
          },
          "721200107": {
            "id": "721200107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我可不会修路。",
            "nextDialogs": [
              "721200108"
            ]
          },
          "721200108": {
            "id": "721200108",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "不用修得特别…可靠，只需要在上面铺一层木板，让我们能搬着这伙计过去就行。",
            "nextDialogs": [
              "721200109"
            ]
          },
          "721200109": {
            "id": "721200109",
            "speakerId": 20624,
            "speakerName": "泽维尔",
            "text": "啊，您可以先去旁边拿点木板。我在这里继续摆弄这家伙，尽量让它更可靠点。"
          }
        }
      }
    },
    {
      "subId": "7212002",
      "subQuestName": "与泽维尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7212003",
      "subQuestName": "取得木板",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721200301"
        ],
        "dialogs": {
          "721200301": {
            "id": "721200301",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "怎么样？您把道路都检查过了吗？",
            "nextDialogs": [
              "721200302"
            ]
          },
          "721200302": {
            "id": "721200302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "道路已经很通畅了。",
            "nextDialogs": [
              "721200303"
            ]
          },
          "721200303": {
            "id": "721200303",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "好。那、那我们过段时间就出发…",
            "nextDialogs": [
              "721200304"
            ]
          },
          "721200304": {
            "id": "721200304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是在…",
            "nextDialogs": [
              "721200305"
            ]
          },
          "721200305": {
            "id": "721200305",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我是在…思考！思考可能发生的各种情况，您明白吗？",
            "nextDialogs": [
              "721200306"
            ]
          },
          "721200306": {
            "id": "721200306",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "比如进去的时候，发现核心已经被那群疯子掏出来。",
            "nextDialogs": [
              "721200307"
            ]
          },
          "721200307": {
            "id": "721200307",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "然后那群疯子还把核心塞进了遗迹守卫里，然后这个遗迹守卫失去控制，把我们全都打飞。",
            "nextDialogs": [
              "721200308"
            ]
          },
          "721200308": {
            "id": "721200308",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "或者是我们在净化「御影炉心」的时候，突然蹦出来一个什么元素生物，一口气把核心吃下去。",
            "nextDialogs": [
              "721200309"
            ]
          },
          "721200309": {
            "id": "721200309",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "最、最糟糕的就是，要是那个传说中的大蛇借此复活，那我们可就彻底完蛋了！",
            "nextDialogs": [
              "721200312"
            ]
          },
          "721200312": {
            "id": "721200312",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "呃…唔，抱歉，我老毛病又犯了，每次都会不由自主地把事情往最坏的那方面想…",
            "nextDialogs": [
              "721200313"
            ]
          },
          "721200313": {
            "id": "721200313",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "我会好好做一份计划，等时候到了，我们就正式出发去搞定这件事。",
            "nextDialogs": [
              "721200314"
            ]
          },
          "721200314": {
            "id": "721200314",
            "speakerId": 3162,
            "speakerName": "泽维尔",
            "text": "希望一切顺利，希望一切顺利，希望一切顺利…"
          }
        }
      }
    },
    {

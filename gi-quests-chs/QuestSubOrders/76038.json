    {
      "subId": "7603811",
      "subQuestName": "发放糖人盒子-角色6$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380701"
        ],
        "dialogs": {
          "760380701": {
            "id": "760380701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（或许<color=#FFCC33FF>雅珂达</color>会对糖雕有兴趣…？）",
            "nextDialogs": [
              "760380702"
            ]
          },
          "760380702": {
            "id": "760380702",
            "speakerId": 1007,
            "speakerName": "雅珂达",
            "text": "老板，来一份大号的。",
            "nextDialogs": [
              "760380703"
            ]
          },
          "760380703": {
            "id": "760380703",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "雅珂达，你也不是第一次来买了，应该知道我的糖雕尺寸都是固定的。",
            "nextDialogs": [
              "760380704"
            ]
          },
          "760380704": {
            "id": "760380704",
            "speakerId": 1007,
            "speakerName": "雅珂达",
            "text": "哎呀，今天我遇见好事了嘛，快点快点，做得稍微大一点。",
            "nextDialogs": [
              "760380705"
            ]
          },
          "760380705": {
            "id": "760380705",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "好事？委托执行得很顺利么？",
            "nextDialogs": [
              "760380706"
            ]
          },
          "760380706": {
            "id": "760380706",
            "speakerId": 1007,
            "speakerName": "雅珂达",
            "text": "嘿嘿嘿，那是，一个简单的护送委托，轻轻松松，全部搞定。",
            "nextDialogs": [
              "760380707"
            ]
          },
          "760380707": {
            "id": "760380707",
            "speakerId": 1007,
            "speakerName": "雅珂达",
            "text": "货物，委托人，全都毫发无损。",
            "nextDialogs": [
              "760380708"
            ]
          },
          "760380708": {
            "id": "760380708",
            "speakerId": 1007,
            "speakerName": "雅珂达",
            "text": "不说了不说了，快点给我做个大点的，等会我带回去吃。",
            "nextDialogs": [
              "760380709"
            ]
          },
          "760380709": {
            "id": "760380709",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "没问题，稍等一下喔…"
          }
        }
      }
    },
    {
      "subId": "7603812",
      "subQuestName": "发放糖人盒子-月灵$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380801"
        ],
        "dialogs": {
          "760380801": {
            "id": "760380801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（领取祈月之夜的糖雕）",
            "nextDialogs": [
              "760380802"
            ]
          },
          "760380802": {
            "id": "760380802",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "这份糖雕您拿好，祈月之夜快乐！"
          }
        }
      }
    },
    {
      "subId": "7603813",
      "subQuestName": "发放糖人盒子-6.3少女$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380901"
        ],
        "dialogs": {
          "760380901": {
            "id": "760380901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（或许<color=#FFCC33FF>哥伦比娅</color>会对糖雕有兴趣…？）",
            "nextDialogs": [
              "760380902"
            ]
          },
          "760380902": {
            "id": "760380902",
            "speakerId": 1008,
            "speakerName": "哥伦比娅",
            "text": "糖雕…之前好像吃过，可以给我做一份么？",
            "nextDialogs": [
              "760380903"
            ]
          },
          "760380903": {
            "id": "760380903",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "没问题！请稍等喔~",
            "nextDialogs": [
              "760380904"
            ]
          },
          "760380904": {
            "id": "760380904",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "（咦？这个女孩，我之前是不是在镇上见过…）",
            "nextDialogs": [
              "760380905"
            ]
          },
          "760380905": {
            "id": "760380905",
            "speakerId": 1008,
            "speakerName": "哥伦比娅",
            "text": "……",
            "nextDialogs": [
              "760380906"
            ]
          },
          "760380906": {
            "id": "760380906",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "（呜哇！她这种满是期待的感觉，我我我我做个什么好呢…）",
            "nextDialogs": [
              "760380907"
            ]
          },
          "760380907": {
            "id": "760380907",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "（用直觉…跟着直觉走…）",
            "nextDialogs": [
              "760380908"
            ]
          },
          "760380908": {
            "id": "760380908",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "那个…我做好了，看看你喜欢吗…",
            "nextDialogs": [
              "760380909"
            ]
          },
          "760380909": {
            "id": "760380909",
            "speakerId": 1008,
            "speakerName": "哥伦比娅",
            "text": "很好看，谢谢你。",
            "nextDialogs": [
              "760380910"
            ]
          },
          "760380910": {
            "id": "760380910",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "嘿嘿，你喜欢就好。",
            "nextDialogs": [
              "760380911"
            ]
          },
          "760380911": {
            "id": "760380911",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "（没错，我的直觉告诉我，这种轻飘飘的造型，就适合这种轻飘飘的孩子！）",
            "nextDialogs": [
              "760380912"
            ]
          },
          "760380912": {
            "id": "760380912",
            "speakerId": 1008,
            "speakerName": "哥伦比娅",
            "text": "唔，也很好吃…",
            "nextDialogs": [
              "760380913"
            ]
          },
          "760380913": {
            "id": "760380913",
            "speakerId": 1008,
            "speakerName": "哥伦比娅",
            "text": "可以再帮我做两份吗？我想带回去，给月灵们也尝尝。",
            "nextDialogs": [
              "760380914"
            ]
          },
          "760380914": {
            "id": "760380914",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "给…给月灵们也尝尝？可以倒是可以，但我的食材不太够…",
            "nextDialogs": [
              "760380915"
            ]
          },
          "760380915": {
            "id": "760380915",
            "speakerId": 1008,
            "speakerName": "哥伦比娅",
            "text": "嗯，那我明天再来。带着月灵一起来。",
            "nextDialogs": [
              "760380916"
            ]
          },
          "760380916": {
            "id": "760380916",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "没问题，您慢走…"
          }
        }
      }
    },
    {
      "subId": "7603814",
      "subQuestName": "发放糖人盒子-6.3叶洛亚$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760381001"
        ],
        "dialogs": {
          "760381001": {
            "id": "760381001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（或许<color=#FFCC33FF>叶洛亚</color>会对糖雕有兴趣…？）",
            "nextDialogs": [
              "760381002"
            ]
          },
          "760381002": {
            "id": "760381002",
            "speakerId": 1009,
            "speakerName": "叶洛亚",
            "text": "来都来了…您好，也请给我拿一份糖雕吧。",
            "nextDialogs": [
              "760381003"
            ]
          },
          "760381003": {
            "id": "760381003",
            "speakerId": 1009,
            "speakerName": "叶洛亚",
            "text": "噢！请您做小一些，我担心会临时有事，没办法一下子吃完…",
            "nextDialogs": [
              "760381004"
            ]
          },
          "760381004": {
            "id": "760381004",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "没问题！放心吧，就算是小型糖雕，味道也一样好。",
            "nextDialogs": [
              "760381005"
            ]
          },
          "760381005": {
            "id": "760381005",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "不过，执灯士的任务还真是繁忙啊…就连糖雕都有可能吃不完…",
            "nextDialogs": [
              "760381006"
            ]
          },
          "760381006": {
            "id": "760381006",
            "speakerId": 1009,
            "speakerName": "叶洛亚",
            "text": "哈哈哈…也不完全是因为任务，有时候也是因为遇见了需要帮忙的人。",
            "nextDialogs": [
              "760381007"
            ]
          },
          "760381007": {
            "id": "760381007",
            "speakerId": 1009,
            "speakerName": "叶洛亚",
            "text": "您也知道，吃了一半的糖雕很难保存，我最多拿布包一包，再放在口袋里…",
            "nextDialogs": [
              "760381008"
            ]
          },
          "760381008": {
            "id": "760381008",
            "speakerId": 1009,
            "speakerName": "叶洛亚",
            "text": "但是等我忙完了事，把布拿出来的时候，里面的糖雕都已经完全化掉了…",
            "nextDialogs": [
              "760381009"
            ]
          },
          "760381009": {
            "id": "760381009",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "这样啊…我想想喔，小型的糖雕…",
            "nextDialogs": [
              "760381010"
            ]
          },
          "760381010": {
            "id": "760381010",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "有了，我可以在小型的糖雕里做出很多口味！",
            "nextDialogs": [
              "760381011"
            ]
          },
          "760381011": {
            "id": "760381011",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "把这个口味的垫在下方…把这个口味的放在上面…",
            "nextDialogs": [
              "760381012"
            ]
          },
          "760381012": {
            "id": "760381012",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "好了，瞧瞧这份「多口味复合小型糖雕」，符合您的要求吗？",
            "nextDialogs": [
              "760381013"
            ]
          },
          "760381013": {
            "id": "760381013",
            "speakerId": 1009,
            "speakerName": "叶洛亚",
            "text": "很符合！谢谢你，乌娜亚塔小姐。",
            "nextDialogs": [
              "760381014"
            ]
          },
          "760381014": {
            "id": "760381014",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "没事。虽然我没办法替你们执灯士分担任务…但是，如果你想吃糖雕的话，要多少就有多少！",
            "nextDialogs": [
              "760381015"
            ]
          },
          "760381015": {
            "id": "760381015",
            "speakerId": 1009,
            "speakerName": "叶洛亚",
            "text": "这是我们分内的事，您太客气了，乌娜亚塔小姐…那我先告辞了，还有任务要处理呢。",
            "nextDialogs": [
              "760381016"
            ]
          },
          "760381016": {
            "id": "760381016",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "好嘞，慢走，下次想吃糖雕的话，直接过来就好啦。"
          }
        }
      }
    },

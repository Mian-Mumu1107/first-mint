  "subQuests": [
    {
      "subId": "7603801",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380101"
        ],
        "dialogs": {
          "760380101": {
            "id": "760380101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（或许<color=#FFCC33FF>奈芙尔</color>会对糖雕有兴趣…？）",
            "nextDialogs": [
              "760380102"
            ]
          },
          "760380102": {
            "id": "760380102",
            "speakerId": 1000,
            "speakerName": "奈芙尔",
            "text": "给我来一份糖雕吧，乌娜亚塔。",
            "nextDialogs": [
              "760380103"
            ]
          },
          "760380103": {
            "id": "760380103",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "奈芙尔老板，你怎么有空过来买糖雕了？",
            "nextDialogs": [
              "760380104"
            ]
          },
          "760380104": {
            "id": "760380104",
            "speakerId": 1000,
            "speakerName": "奈芙尔",
            "text": "偶尔出来散散步，对我的身体和精神都有好处。",
            "nextDialogs": [
              "760380105"
            ]
          },
          "760380105": {
            "id": "760380105",
            "speakerId": 1000,
            "speakerName": "奈芙尔",
            "text": "吃点甜的，也有助于我进行思考。",
            "nextDialogs": [
              "760380106"
            ]
          },
          "760380106": {
            "id": "760380106",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "好嘞~稍等一下，我这就给您做一份。",
            "nextDialogs": [
              "760380107"
            ]
          },
          "760380107": {
            "id": "760380107",
            "speakerId": 1000,
            "speakerName": "奈芙尔",
            "text": "行。对了，这些钱给你，下次雅珂达来的时候…",
            "nextDialogs": [
              "760380108"
            ]
          },
          "760380108": {
            "id": "760380108",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "给她做得大一些？还是甜一些？",
            "nextDialogs": [
              "760380109"
            ]
          },
          "760380109": {
            "id": "760380109",
            "speakerId": 1000,
            "speakerName": "奈芙尔",
            "text": "把这些钱给她。",
            "nextDialogs": [
              "760380110"
            ]
          },
          "760380110": {
            "id": "760380110",
            "speakerId": 1000,
            "speakerName": "奈芙尔",
            "text": "就说：「奈芙尔出双倍的钱，请你在偷懒完毕后，帮她也带一份糖雕回去。」"
          }
        }
      }
    },
    {
      "subId": "7603815",
      "subQuestName": "发放糖人盒子-6.5莉奈娅$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760381109"
        ],
        "dialogs": {
          "760381109": {
            "id": "760381109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（或许<color=#FFCC33FF>莉奈娅</color>会对糖雕有兴趣…？）",
            "nextDialogs": [
              "760381101"
            ]
          },
          "760381101": {
            "id": "760381101",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "莉奈娅小姐，又来给露米买糖雕了？",
            "nextDialogs": [
              "760381102"
            ]
          },
          "760381102": {
            "id": "760381102",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "是呀，露米可喜欢你做的糖雕啦，每次都不舍得吃，只是舔舔就让我收好。",
            "nextDialogs": [
              "760381103"
            ]
          },
          "760381103": {
            "id": "760381103",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "不过，毕竟是糖雕嘛…舔多了也就化了。",
            "nextDialogs": [
              "760381104"
            ]
          },
          "760381104": {
            "id": "760381104",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "所以，拜托乌娜亚塔小姐，再帮露米做一份糖雕吧。",
            "nextDialogs": [
              "760381105"
            ]
          },
          "760381105": {
            "id": "760381105",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "没问题！稍等一下喔…",
            "nextDialogs": [
              "760381106"
            ]
          },
          "760381106": {
            "id": "760381106",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "（哎呀，露米太可爱了！好想摸一摸！但随便摸的话，算了算了，这样太失礼了…）",
            "nextDialogs": [
              "760381107"
            ]
          },
          "760381107": {
            "id": "760381107",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "做好了，请拿好，莉奈娅小姐。",
            "nextDialogs": [
              "760381108"
            ]
          },
          "760381108": {
            "id": "760381108",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "谢谢你！露米，糖雕好了，现在要吃么…咦，已经睡着了，那我等一会再把糖雕给它吧。"
          }
        }
      }
    },
    {
      "subId": "7603805",
      "subQuestName": "发放糖人盒子-通用对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380201"
        ],
        "dialogs": {
          "760380201": {
            "id": "760380201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "来一份糖雕。",
            "nextDialogs": [
              "760380202"
            ]
          },
          "760380202": {
            "id": "760380202",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "给~打开之后要尽快吃掉喔。"
          }
        }
      }
    },
    {
      "subId": "7603806",
      "subQuestName": "发放糖人盒子-角色1$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380310"
        ],
        "dialogs": {
          "760380310": {
            "id": "760380310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（或许<color=#FFCC33FF>菈乌玛</color>会对糖雕有兴趣…？）",
            "nextDialogs": [
              "760380301"
            ]
          },
          "760380301": {
            "id": "760380301",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "乌娜亚塔小姐，请为我做几份糖雕吧。",
            "nextDialogs": [
              "760380302"
            ]
          },
          "760380302": {
            "id": "760380302",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "没问题，菈乌玛小姐。上次你带回去的糖雕，孩子都喜欢么？",
            "nextDialogs": [
              "760380303"
            ]
          },
          "760380303": {
            "id": "760380303",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "呵呵，他们很喜欢，有的孩子拿着糖雕不舍得吃，一直到糖雕快融化了，才慢慢品尝。",
            "nextDialogs": [
              "760380304"
            ]
          },
          "760380304": {
            "id": "760380304",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "这样啊…嗯，下次我带上工具，直接到你那边去，给孩子们现场做。",
            "nextDialogs": [
              "760380305"
            ]
          },
          "760380305": {
            "id": "760380305",
            "speakerId": 1003,
            "speakerName": "菈乌玛",
            "text": "这样就太好了~孩子们一定会很高兴的~",
            "nextDialogs": [
              "760380306"
            ]
          },
          "760380306": {
            "id": "760380306",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "噢，聊远了…我稍后就去做糖雕。等做完了，就托人直接送到你们那边去。",
            "nextDialogs": [
              "760380307"
            ]
          },
          "760380307": {
            "id": "760380307",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "但在那之前…嘿嘿，我刚巧有一个灵感~",
            "nextDialogs": [
              "760380308"
            ]
          },
          "760380308": {
            "id": "760380308",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "稍等一下喔，菈乌玛小姐，我这就给你做一份特别的糖雕。"
          }
        }
      }
    },
    {
      "subId": "7603807",
      "subQuestName": "发放糖人盒子-角色2$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380409"
        ],
        "dialogs": {
          "760380409": {
            "id": "760380409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（或许<color=#FFCC33FF>菲林斯</color>会对糖雕有兴趣…？）",
            "nextDialogs": [
              "760380401"
            ]
          },
          "760380401": {
            "id": "760380401",
            "speakerId": 1004,
            "speakerName": "菲林斯",
            "text": "乌娜亚塔小姐。如果可以，请为我做一份糖雕吧。",
            "nextDialogs": [
              "760380402"
            ]
          },
          "760380402": {
            "id": "760380402",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "好嘞，你是…那位执灯士，菲林斯先生吧，我之前在商店里看见过你。",
            "nextDialogs": [
              "760380403"
            ]
          },
          "760380403": {
            "id": "760380403",
            "speakerId": 1004,
            "speakerName": "菲林斯",
            "text": "是的。我偶尔回来采购物资，您能记住我，是我的荣幸。",
            "nextDialogs": [
              "760380404"
            ]
          },
          "760380404": {
            "id": "760380404",
            "speakerId": 1004,
            "speakerName": "菲林斯",
            "text": "今天恰好路过此处，看见了您高超的糖雕技艺。",
            "nextDialogs": [
              "760380405"
            ]
          },
          "760380405": {
            "id": "760380405",
            "speakerId": 1004,
            "speakerName": "菲林斯",
            "text": "思虑再三后，我还是想要请您为我做一份糖雕。",
            "nextDialogs": [
              "760380406"
            ]
          },
          "760380406": {
            "id": "760380406",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "哎呀，别这么客气，我都要不好意思了~",
            "nextDialogs": [
              "760380407"
            ]
          },
          "760380407": {
            "id": "760380407",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "稍等一下，我这就给你做糖雕。",
            "nextDialogs": [
              "760380408"
            ]
          },
          "760380408": {
            "id": "760380408",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "唔…一位执灯士，糖雕应该特别一些吧…"
          }
        }
      }
    },
    {
      "subId": "7603808",
      "subQuestName": "发放糖人盒子-角色3$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380508"
        ],
        "dialogs": {
          "760380508": {
            "id": "760380508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（或许<color=#FFCC33FF>爱诺</color>会对糖雕有兴趣…？）",
            "nextDialogs": [
              "760380501"
            ]
          },
          "760380501": {
            "id": "760380501",
            "speakerId": 1005,
            "speakerName": "爱诺",
            "text": "老板！我要一份糖雕！",
            "nextDialogs": [
              "760380502"
            ]
          },
          "760380502": {
            "id": "760380502",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "爱诺小姐~好久不见~",
            "nextDialogs": [
              "760380503"
            ]
          },
          "760380503": {
            "id": "760380503",
            "speakerId": 1005,
            "speakerName": "爱诺",
            "text": "嘿嘿，今天来镇上帮人修东西，正好来你这边买糖吃。",
            "nextDialogs": [
              "760380504"
            ]
          },
          "760380504": {
            "id": "760380504",
            "speakerId": 1005,
            "speakerName": "爱诺",
            "text": "快快，趁着伊涅芙不在，帮我多做几块…或者做的甜一些也行。",
            "nextDialogs": [
              "760380505"
            ]
          },
          "760380505": {
            "id": "760380505",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "倒是没问题…但您吃完之后，可记得要刷牙啊。",
            "nextDialogs": [
              "760380506"
            ]
          },
          "760380506": {
            "id": "760380506",
            "speakerId": 1005,
            "speakerName": "爱诺",
            "text": "知道的知道的，我每次吃糖之后都刷牙，牙齿好着呢。",
            "nextDialogs": [
              "760380507"
            ]
          },
          "760380507": {
            "id": "760380507",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "哈哈…那您稍等一下…"
          }
        }
      }
    },
    {
      "subId": "7603809",
      "subQuestName": "发放糖人盒子-角色4$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380601"
        ],
        "dialogs": {
          "760380601": {
            "id": "760380601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（或许<color=#FFCC33FF>伊涅芙</color>会对糖雕有兴趣…？）",
            "nextDialogs": [
              "760380602"
            ]
          },
          "760380602": {
            "id": "760380602",
            "speakerId": 1006,
            "speakerName": "伊涅芙",
            "text": "请问，可以给我做一份糖雕么？",
            "nextDialogs": [
              "760380603"
            ]
          },
          "760380603": {
            "id": "760380603",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "好呀，这次还是带给爱诺小姐的么？",
            "nextDialogs": [
              "760380604"
            ]
          },
          "760380604": {
            "id": "760380604",
            "speakerId": 1006,
            "speakerName": "伊涅芙",
            "text": "不是。爱诺要我过来，买一份属于自己的漂亮糖雕。",
            "nextDialogs": [
              "760380605"
            ]
          },
          "760380605": {
            "id": "760380605",
            "speakerId": 1006,
            "speakerName": "伊涅芙",
            "text": "据她说，这是在训练我进行「社会性活动」，以后也能更方便地进行采购。",
            "nextDialogs": [
              "760380606"
            ]
          },
          "760380606": {
            "id": "760380606",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "这样啊~",
            "nextDialogs": [
              "760380607"
            ]
          },
          "760380607": {
            "id": "760380607",
            "speakerId": 1006,
            "speakerName": "伊涅芙",
            "text": "但我并不明白，因为我其实并不用摄入如此多的糖分。",
            "nextDialogs": [
              "760380608"
            ]
          },
          "760380608": {
            "id": "760380608",
            "speakerId": 1006,
            "speakerName": "伊涅芙",
            "text": "最后，说不定还是会被爱诺偷偷吃掉。",
            "nextDialogs": [
              "760380609"
            ]
          },
          "760380609": {
            "id": "760380609",
            "speakerId": 1006,
            "speakerName": "伊涅芙",
            "text": "……",
            "nextDialogs": [
              "760380610"
            ]
          },
          "760380610": {
            "id": "760380610",
            "speakerId": 1006,
            "speakerName": "伊涅芙",
            "text": "乌娜亚塔小姐，可以请您把糖雕的尺寸做得小一些么？",
            "nextDialogs": [
              "760380611"
            ]
          },
          "760380611": {
            "id": "760380611",
            "speakerId": 1006,
            "speakerName": "伊涅芙",
            "text": "爱诺很想吃糖，但我觉得，她还是应该吃得少一些。",
            "nextDialogs": [
              "760380612"
            ]
          },
          "760380612": {
            "id": "760380612",
            "speakerId": 1001,
            "speakerName": "乌娜亚塔",
            "text": "交给我吧，嗯…让我想想…"
          }
        }
      }
    },

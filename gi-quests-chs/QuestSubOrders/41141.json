        "dialogs": {
          "411410401": {
            "id": "411410401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事。",
            "nextDialogs": [
              "411410402"
            ]
          },
          "411410402": {
            "id": "411410402",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "啊？行吧，行吧，那我找别人…实在不行，我就自己跑一趟…"
          }
        }
      }
    },
    {
      "subId": "4114101",
      "subQuestName": "与言笑对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411410101"
        ],
        "dialogs": {
          "411410101": {
            "id": "411410101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我这就送过去了。",
            "nextDialogs": [
              "411410102"
            ]
          },
          "411410102": {
            "id": "411410102",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "行，那你可紧着点。",
            "nextDialogs": [
              "411410103"
            ]
          },
          "411410103": {
            "id": "411410103",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "送的时候<color=#00E1FFFF>千万绕着魔物走，沾了奇怪的元素或者挨了一下推搡，菜就不行了</color>。",
            "nextDialogs": [
              "411410104"
            ]
          },
          "411410104": {
            "id": "411410104",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "要是菜被弄坏了，客人可不会收。",
            "nextDialogs": [
              "411410105"
            ]
          },
          "411410105": {
            "id": "411410105",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "行了，反正你紧着点吧，别让客人等急了。"
          }
        }
      }
    },
    {
      "subId": "4114102",
      "subQuestName": "将餐品送给随缘的铃官",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411410201"
        ],
        "dialogs": {
          "411410201": {
            "id": "411410201",
            "speakerId": 30027,
            "speakerName": "随缘的铃官",
            "text": "都逛了这么久了，我订的餐怎么还没送来…"
          }
        }
      }
    },
    {
      "subId": "4114103",
      "subQuestName": "与随缘的铃官对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411410601"
        ],
        "dialogs": {
          "411410601": {
            "id": "411410601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是您订的餐。",
            "nextDialogs": [
              "411410602"
            ]
          },
          "411410602": {
            "id": "411410602",
            "speakerId": 30027,
            "speakerName": "随缘的铃官",
            "text": "总算送到啦，嗯…这道杏仁豆腐看起来真不错。",
            "nextDialogs": [
              "411410603"
            ]
          },
          "411410603": {
            "id": "411410603",
            "speakerId": 30027,
            "speakerName": "随缘的铃官",
            "text": "嘿嘿，谢谢你啦，哎呀…逛了这么久，总算可以吃点东西了。"
          }
        }
      }
    },
    {
      "subId": "4114103",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411410301"
        ],
        "dialogs": {
          "411410301": {
            "id": "411410301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听说有特别订单…",
            "nextDialogs": [
              "411410302"
            ]
          },
          "411410302": {
            "id": "411410302",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "哼，也好，一个叫铃官的客人本来在这投宿，早些时候在我这里订了份杏仁豆腐，钱也付好了，要我过一会送去荻花洲北边的一个地方。",
            "nextDialogs": [
              "411410303"
            ]
          },
          "411410303": {
            "id": "411410303",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "但客栈里的生意太忙了，我可抽不开身子去送，如果你能帮忙跑一趟那就最好了，报酬少不了你的。"
          }
        }
      }

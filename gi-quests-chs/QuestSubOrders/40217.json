    {
      "subId": "4021703",
      "subQuestName": "前往龙脊雪山",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402170301"
        ],
        "dialogs": {
          "402170301": {
            "id": "402170301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好呀，安柏。",
            "nextDialogs": [
              "402170302"
            ]
          },
          "402170302": {
            "id": "402170302",
            "speakerId": 1001,
            "speakerName": "安柏",
            "text": "啊，是荣誉骑士和派蒙，又见面啦！抱歉，刚才忙着说话，都没注意到你们来了。",
            "nextDialogs": [
              "402170305"
            ]
          },
          "402170305": {
            "id": "402170305",
            "speakerId": 1001,
            "speakerName": "安柏",
            "text": "我正和海因茨先生说比赛的事呢。对了，你们怎么到雪山来了，该不会还有委托要做吧？",
            "nextDialogs": [
              "402170306"
            ]
          },
          "402170306": {
            "id": "402170306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没有没有，我们收到了比赛的宣传单，有点好奇，就来看看啦。"
          }
        }
      }
    },
    {
      "subId": "4021707",
      "subQuestName": "与安柏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4021704",
      "subQuestName": "前去寻找熟人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402170401"
        ],
        "dialogs": {
          "402170401": {
            "id": "402170401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好，请问瓦雷莎和希诺宁在这里吗？",
            "nextDialogs": [
              "402170402"
            ]
          },
          "402170402": {
            "id": "402170402",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "哦，是找队长和副队长的。",
            "nextDialogs": [
              "402170403"
            ]
          },
          "402170403": {
            "id": "402170403",
            "speakerId": 1003,
            "speakerName": "爱拉尼",
            "text": "#…{NICKNAME}？我还差点以为自己认错了，真的是你。",
            "nextDialogs": [
              "402170405",
              "402170409"
            ]
          },
          "402170405": {
            "id": "402170405",
            "speakerId": 1003,
            "speakerName": "爱拉尼",
            "text": "拜托你不要一见面就说这么残忍的话，现在是难得的假期时间。",
            "nextDialogs": [
              "402170406"
            ]
          },
          "402170406": {
            "id": "402170406",
            "speakerId": 1003,
            "speakerName": "爱拉尼",
            "text": "再怎么为论文头疼，我也是血肉做的人，是会被反复折磨人的现实打倒的。",
            "nextDialogs": [
              "402170407"
            ]
          },
          "402170407": {
            "id": "402170407",
            "speakerId": 1003,
            "speakerName": "爱拉尼",
            "text": "我已经被论文打倒了，让我在地上躺一会儿再重新面对吧，在这里就不要提这事了，我求你。",
            "nextDialogs": [
              "402170412"
            ]
          },
          "402170412": {
            "id": "402170412",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎呀，到处都是熟人，提瓦特真小。",
            "nextDialogs": [
              "402170413"
            ]
          },
          "402170413": {
            "id": "402170413",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "既然大家都认识瓦雷莎和希诺宁，那就好解释了。",
            "nextDialogs": [
              "402170414"
            ]
          },
          "402170414": {
            "id": "402170414",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们听说她们来雪山这里比赛了，就来打招呼了，嘿嘿。",
            "nextDialogs": [
              "402170415"
            ]
          },
          "402170415": {
            "id": "402170415",
            "speakerId": 1003,
            "speakerName": "爱拉尼",
            "text": "瓦雷莎和希诺宁现在不在，不介意的话，可以先在营地里等等看。",
            "nextDialogs": [
              "402170416"
            ]
          },
          "402170416": {
            "id": "402170416",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好啊，你们的帐篷很有特色呢…喔，这里果然有好多漫画。"
          },
          "402170409": {
            "id": "402170409",
            "speakerId": 1003,
            "speakerName": "爱拉尼",
            "text": "不记得我吗…倒也正常，经历过那么多大事，人的记性早晚会麻木。",
            "nextDialogs": [
              "402170410"
            ]
          },
          "402170410": {
            "id": "402170410",
            "speakerId": 1003,
            "speakerName": "爱拉尼",
            "text": "我是爱拉尼，教令院诃般荼…下面一点点的帝利耶悉哈哈。",
            "nextDialogs": [
              "402170411"
            ]
          },
          "402170411": {
            "id": "402170411",
            "speakerId": 1003,
            "speakerName": "爱拉尼",
            "text": "不过只要我完成了毕业论文，早晚能成为诃般荼的！"
          }
        }
      }
    },
    {
      "subId": "4021705",
      "subQuestName": "前往训练场地寻找瓦雷莎",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402170501"
        ],
        "dialogs": {
          "402170501": {
            "id": "402170501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "瓦雷莎，我们来看你们训练啦。",
            "nextDialogs": [
              "402170502"
            ]
          },
          "402170502": {
            "id": "402170502",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "#欸，是派蒙的声音？派蒙——{NICKNAME}——好想你们呀！",
            "nextDialogs": [
              "402170503"
            ]
          },
          "402170503": {
            "id": "402170503",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "和希诺宁一起解释了与众人相遇的前后经过。",
            "nextDialogs": [
              "402170504"
            ]
          },
          "402170504": {
            "id": "402170504",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "啊哈哈！爱拉尼和义刚，怎么用了漫画里的台词来开场哇？",
            "nextDialogs": [
              "402170505"
            ]
          },
          "402170505": {
            "id": "402170505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "就是就是，连我都接不上话！",
            "nextDialogs": [
              "402170506"
            ]
          },
          "402170506": {
            "id": "402170506",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "如果是我，开头应该会说「力量啊，爆开吧！」",
            "nextDialogs": [
              "402170507"
            ]
          },
          "402170507": {
            "id": "402170507",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "你这话也挺不好接的。",
            "nextDialogs": [
              "402170508"
            ]
          },
          "402170508": {
            "id": "402170508",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "而且，其他人和你见面的时候，谁都还没来得及说话，就见到你把明妮举起来转了好几圈。",
            "nextDialogs": [
              "402170509"
            ]
          },
          "402170509": {
            "id": "402170509",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "呜啊，现在想想怪不好意思的。",
            "nextDialogs": [
              "402170510"
            ]
          },
          "402170510": {
            "id": "402170510",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "毕竟这是我们第一次见面，之前只停留在互相写信、寄插画的环节。",
            "nextDialogs": [
              "402170511"
            ]
          },
          "402170511": {
            "id": "402170511",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "这回认出明妮的时候，我一不小心就激动了，嘿嘿。",
            "nextDialogs": [
              "402170512"
            ]
          },
          "402170512": {
            "id": "402170512",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，既然你俩是一起来的，为什么刚才介绍大家的时候，希诺宁说的是「『炽魂斗士特战队』和我」？",
            "nextDialogs": [
              "402170513"
            ]
          },
          "402170513": {
            "id": "402170513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听着好像不是一队的。",
            "nextDialogs": [
              "402170514"
            ]
          },
          "402170514": {
            "id": "402170514",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "因为我本来就不是这个兴趣小组的成员，妮佩卡才是，这一趟我也算是替她来的。",
            "nextDialogs": [
              "402170517"
            ]
          },
          "402170517": {
            "id": "402170517",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "一切正常。能吃能睡，学习的进度也没落下，不仅迷上了看漫画书，甚至还认识了明妮这位笔友。",
            "nextDialogs": [
              "402170518"
            ]
          },
          "402170518": {
            "id": "402170518",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "妮佩卡时不时地就来我耳朵旁边念叨，说明妮既能画画又会做漫画道具，还挺擅长开导人，是个很好很好的人…",
            "nextDialogs": [
              "402170519"
            ]
          },
          "402170519": {
            "id": "402170519",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "听她的描述，我还一度怀疑过明妮的年龄。但这次过来一看，没想到明妮的年纪真的这么小。",
            "nextDialogs": [
              "402170520"
            ]
          },
          "402170520": {
            "id": "402170520",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "听说明妮提议大家参加「雪山越野赛」，妮佩卡也想来。",
            "nextDialogs": [
              "402170521"
            ]
          },
          "402170521": {
            "id": "402170521",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "但…她也知道自己的身体状况，所以就拜托我替她参加，也向明妮问好。",
            "nextDialogs": [
              "402170522"
            ]
          },
          "402170522": {
            "id": "402170522",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "欸嘿嘿，我之前就做好了旅行的准备，所以我和希诺宁就正好同行了。",
            "nextDialogs": [
              "402170523"
            ]
          },
          "402170523": {
            "id": "402170523",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "是啊，还莫名其妙给我冠了个副队长的名号…",
            "nextDialogs": [
              "402170524"
            ]
          },
          "402170524": {
            "id": "402170524",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "当，当然了！希诺宁的实力，绝对是队长级的！就是那种…队长级的副队长！",
            "nextDialogs": [
              "402170525"
            ]
          },
          "402170525": {
            "id": "402170525",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "既然是有队长的实力，到底为什么还要做副队长？算了算了，我差点被你绕进去了。",
            "nextDialogs": [
              "402170526"
            ]
          },
          "402170526": {
            "id": "402170526",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "反正这次过来，我也主要是为了给妮佩卡买点《炽魂斗士战记》的…呃…",
            "nextDialogs": [
              "402170527"
            ]
          },
          "402170527": {
            "id": "402170527",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "周边！",
            "nextDialogs": [
              "402170528"
            ]
          },
          "402170528": {
            "id": "402170528",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "好吧，周边。大概就是一些徽章、画着角色的纸、漫画的复制稿、画着漫画角色的硬木板…",
            "nextDialogs": [
              "402170529"
            ]
          },
          "402170529": {
            "id": "402170529",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "瓦雷莎，你为什么用这种疑惑的表情看我，哪里错了么？",
            "nextDialogs": [
              "402170530"
            ]
          },
          "402170530": {
            "id": "402170530",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "没错，完全没问题。只不过，听希诺宁这么一本正经地介绍周边，总感觉有点奇妙。",
            "nextDialogs": [
              "402170531"
            ]
          },
          "402170531": {
            "id": "402170531",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "全能大工匠希诺宁，抱着成箱成箱的周边回去的画面…哇啊，想不出来！",
            "nextDialogs": [
              "402170532"
            ]
          },
          "402170532": {
            "id": "402170532",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "这么多，都是妮佩卡要的吗？",
            "nextDialogs": [
              "402170533"
            ]
          },
          "402170533": {
            "id": "402170533",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "没有。以妮佩卡的性格，她并不会开口要什么礼物。",
            "nextDialogs": [
              "402170534"
            ]
          },
          "402170534": {
            "id": "402170534",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "但以我对妮佩卡的了解，她收到这些…周边的时候，会很高兴的。",
            "nextDialogs": [
              "402170535"
            ]
          },
          "402170535": {
            "id": "402170535",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "那是当然啦，能拿到这种礼物，妮佩卡肯定会特别开心的！嘿嘿，希诺宁这么懂妮佩卡，简直就是妮佩卡的姐姐呢。",
            "nextDialogs": [
              "402170536"
            ]
          },
          "402170536": {
            "id": "402170536",
            "speakerId": 1006,
            "speakerName": "希诺宁",
            "text": "这么说也没错，我们本来就是家人。至于了解…我和妮佩卡相处时间不长，算略微了解吧。",
            "nextDialogs": [
              "402170537"
            ]
          },
          "402170537": {
            "id": "402170537",
            "speakerId": 1007,
            "speakerName": "明妮",
            "text": "呼啊…俯卧撑…瓦雷莎…我做完俯卧撑了。",
            "nextDialogs": [
              "402170538"
            ]
          },
          "402170538": {
            "id": "402170538",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "好，那就是做完第四组了，嗯，稍微休息一下吧。",
            "nextDialogs": [
              "402170539"
            ]
          },
          "402170539": {
            "id": "402170539",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "#明妮，我来给你介绍，这两位是我和希诺宁在纳塔认识的朋友：{NICKNAME}和派蒙。",
            "nextDialogs": [
              "402170540"
            ]
          },
          "402170540": {
            "id": "402170540",
            "speakerId": 1007,
            "speakerName": "明妮",
            "text": "金色头发…飞着的白色…简直就像…蒙德的荣誉骑士？"
          }
        }
      }
    },
    {
      "subId": "4021706",
      "subQuestName": "返回营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402170601"
        ],
        "dialogs": {
          "402170601": {
            "id": "402170601",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "对了，马上就到营地了，刚才听希诺宁说的时候，我就想着一定不能忘了这件事。",
            "nextDialogs": [
              "402170602"
            ]
          },
          "402170602": {
            "id": "402170602",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "给！《炽魂斗士战记》的第二册。之前我感觉，大家说不定会想看，就多带了几本漫画来。",
            "nextDialogs": [
              "402170603"
            ]
          },
          "402170603": {
            "id": "402170603",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "可惜打包行李的时候没有带上第一册，给朋友介绍漫画的话，其实送第一册比较合适…",
            "nextDialogs": [
              "402170604"
            ]
          },
          "402170604": {
            "id": "402170604",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "闲下来的时候可以翻翻看，要是你也喜欢就太好了，我们就有了超超超厉害的同好！",
            "nextDialogs": [
              "402170607"
            ]
          },
          "402170607": {
            "id": "402170607",
            "speakerId": 1004,
            "speakerName": "瓦雷莎",
            "text": "那我们就去和大家会合了，有空的话，请来找我们玩哦。",
            "nextDialogs": [
              "402170608"
            ]
          },
          "402170608": {
            "id": "402170608",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么到这里就结束了，菲耶蒂娜她们的战斗好精彩，我想看接下来的情节！",
            "nextDialogs": [
              "402170609"
            ]
          },
          "402170609": {
            "id": "402170609",

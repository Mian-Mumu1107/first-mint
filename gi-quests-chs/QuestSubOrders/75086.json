    {
      "subId": "7508611",
      "subQuestName": "和龙伙伴一起寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7508603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750860301"
        ],
        "dialogs": {
          "750860301": {
            "id": "750860301",
            "speakerId": 1004,
            "speakerName": "莉瓦",
            "text": "你来了！塔卢加一直说你很厉害，让我在飞行竞赛时不要跟丢你了。",
            "nextDialogs": [
              "750860302"
            ]
          },
          "750860302": {
            "id": "750860302",
            "speakerId": 1004,
            "speakerName": "莉瓦",
            "text": "这孩子，话里话外没一点觉得我能赢的意思，让我做姐姐的面子往哪里摆？",
            "nextDialogs": [
              "750860303"
            ]
          },
          "750860303": {
            "id": "750860303",
            "speakerId": 1004,
            "speakerName": "莉瓦",
            "text": "所以待会儿的比试我是不会放水的，你也不要有所保留，让我们各自全力以赴，分个高下吧！",
            "nextDialogs": [
              "750860305",
              "750860307"
            ]
          },
          "750860305": {
            "id": "750860305",
            "speakerId": 1004,
            "speakerName": "莉瓦",
            "text": "就是这份气势！",
            "nextDialogs": [
              "750860308"
            ]
          },
          "750860308": {
            "id": "750860308",
            "speakerId": 1004,
            "speakerName": "莉瓦",
            "text": "话不多说，你准备好了的话，我们这就开始吧。"
          },
          "750860307": {
            "id": "750860307",
            "speakerId": 1004,
            "speakerName": "莉瓦",
            "text": "你这么说难道是想让我放松警惕？哼哼，我可不会上当！"
          }
        }
      }
    },
    {
      "subId": "7508617",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750861701"
        ],
        "dialogs": {
          "750861701": {
            "id": "750861701",
            "speakerId": 1004,
            "speakerName": "莉瓦",
            "text": "真期待啊，飞行竞赛…",
            "nextDialogs": [
              "750861702"
            ]
          },
          "750861702": {
            "id": "750861702",
            "speakerId": 1004,
            "speakerName": "莉瓦",
            "text": "可以明确地感知到自己和龙伙伴的进步，对训练来说也是件好事呢！"
          }
        }
      }
    },
    {
      "subId": "7508618",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750861801"
        ],
        "dialogs": {
          "750861801": {
            "id": "750861801",
            "speakerId": 1009,
            "speakerName": "拉密萨纳",
            "text": "筹备得怎么样了？",
            "nextDialogs": [
              "750861802"
            ]
          },
          "750861802": {
            "id": "750861802",
            "speakerId": 1010,
            "speakerName": "帕朗",
            "text": "还算顺利吧…不过真的要这么做吗？时间上会不会有点太苛刻了…",
            "nextDialogs": [
              "750861803"
            ]
          },
          "750861803": {
            "id": "750861803",
            "speakerId": 1009,
            "speakerName": "拉密萨纳",
            "text": "这样才显得真实嘛。而且可以掩盖很多问题…总之听我的准没错。",
            "nextDialogs": [
              "750861804"
            ]
          },
          "750861804": {
            "id": "750861804",
            "speakerId": 1010,
            "speakerName": "帕朗",
            "text": "既然你都这么说了…"
          }
        }
      }
    },
    {
      "subId": "7508621",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750862101"
        ],
        "dialogs": {
          "750862101": {
            "id": "750862101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "现在开始吧。"
          }
        }
      }
    },
    {
      "subId": "7508622",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750862201"
        ],
        "dialogs": {
          "750862201": {
            "id": "750862201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还要再准备一下。",
            "nextDialogs": [
              "750862202"
            ]
          },
          "750862202": {
            "id": "750862202",
            "speakerId": 1004,
            "speakerName": "莉瓦",
            "text": "嗯，我等你。"
          }
        }
      }
    },
    {
      "subId": "7508758",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750875801"
        ],
        "dialogs": {
          "750875801": {
            "id": "750875801",
            "speakerId": 1005,
            "speakerName": "特马乔",
            "text": "我们这儿还有几项飞行挑战，具体内容都写在告示牌上了，如果你感兴趣不妨试试，当然也会有对应的奖励。",
            "nextDialogs": [
              "750875803",
              "750875806",
              "750875810"
            ]
          },
          "750875803": {
            "id": "750875803",
            "speakerId": 1005,
            "speakerName": "特马乔",
            "text": "其实我也不知道为什么会叫这个名字，说起帕帕卡…你听过昆图尔和坏巫师茹米的故事吗？",
            "nextDialogs": [
              "750875804"
            ]
          },
          "750875804": {
            "id": "750875804",
            "speakerId": 1005,
            "speakerName": "特马乔",
            "text": "部族的战士输给了坏巫师茹米，被他变成了帕帕卡…听起来好像不是什么好事？可能帕帕卡真的飞得很快吧，谁知道呢。"
          },
          "750875806": {
            "id": "750875806",
            "speakerId": 1005,
            "speakerName": "特马乔",
            "text": "哈哈…他是个好手，但不擅长教人。当飞行竞赛的对手…还算说得过去？",
            "nextDialogs": [
              "750875807"
            ]
          },
          "750875807": {
            "id": "750875807",
            "speakerId": 1005,
            "speakerName": "特马乔",
            "text": "要不是飞得不好，谁会来这里呢？这时候如果太过严厉…唉，以前可不是没发生过这种事。",
            "nextDialogs": [
              "750875808"
            ]
          },
          "750875808": {
            "id": "750875808",
            "speakerId": 1005,
            "speakerName": "特马乔",
            "text": "所以现在的方针已经改成鼓励为主了，相信多夸夸也能有进步的。"
          },
          "750875810": {
            "id": "750875810",
            "speakerId": 1005,
            "speakerName": "特马乔",
            "text": "再见，也欢迎你随时回来。"
          }
        }
      }
    },
    {
      "subId": "7508762",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750876201"
        ],
        "dialogs": {
          "750876201": {
            "id": "750876201",
            "speakerId": 1012,
            "speakerName": "琪希可",
            "text": "欢迎来到帕帕卡飞行学校！",
            "nextDialogs": [
              "750876204",
              "750876207"
            ]
          },
          "750876204": {
            "id": "750876204",
            "speakerId": 1012,
            "speakerName": "琪希可",
            "text": "给学员必要的指引和帮助。现在和以前可真不一样了，要知道以前可是没有这些贴心的服务的。",
            "nextDialogs": [
              "750876205"
            ]
          },
          "750876205": {
            "id": "750876205",
            "speakerId": 1012,
            "speakerName": "琪希可",
            "text": "但是有一次因为教练在指导时言辞有些…严厉？偏偏那个学员也是个脾气火爆的人物…唉，当时的场面我都不愿再提。",
            "nextDialogs": [
              "750876206"
            ]
          },
          "750876206": {
            "id": "750876206",
            "speakerId": 1012,
            "speakerName": "琪希可",
            "text": "总之自那之后飞行学校就改变了指导的方针。伸手不打笑脸人，谁也不会讨厌被夸吧？"
          },
          "750876207": {
            "id": "750876207",
            "speakerId": 1012,
            "speakerName": "琪希可",
            "text": "祝你度过愉快的一天！"
          }
        }
      }
    }
  ]
}
            ]
          },
          "206001009": {
            "id": "206001009",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "如果你想要理解的话，就加入我们吧。加入了之后，自然而然地就会理解了，咱们的女皇陛下…",

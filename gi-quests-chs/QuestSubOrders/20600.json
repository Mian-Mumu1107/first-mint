            ]
          },
          "206001006": {
            "id": "206001006",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "这并不是什么抽象形容，而是具体的事实。女皇陛下就是当今「尘世七执政」中的「冰之神」。",
            "nextDialogs": [

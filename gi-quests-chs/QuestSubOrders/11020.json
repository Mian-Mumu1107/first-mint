      }
    },
    {
      "subId": "1102002",
      "subQuestName": "与桌边的钟离交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110200201"
        ],
        "dialogs": {
          "110200201": {
            "id": "110200201",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "哦？没想到会在这里遇见你们。",
            "nextDialogs": [
              "110200202"
            ]
          },
          "110200202": {
            "id": "110200202",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "这两位是你的朋友吗？",
            "nextDialogs": [
              "110200203"
            ]
          },
          "110200203": {
            "id": "110200203",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "#嗯，前段时间有幸识得，{NICKNAME}，见多识广，博学多才。与之相处，倍感投缘。",
            "nextDialogs": [
              "110200204"
            ]
          },
          "110200204": {
            "id": "110200204",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "刚刚我们聊到「历史上的岩王帝君」这个话题，你有兴趣听一听吗？",
            "nextDialogs": [
              "110200205"
            ]
          },
          "110200205": {
            "id": "110200205",
            "speakerId": 10309,
            "speakerName": "翰学",
            "text": "这位先生，好像轻看了岩王爷的神力。作为专业的考古学家，我想纠正他的一些观点。",
            "nextDialogs": [
              "110200208"
            ]
          },
          "110200208": {
            "id": "110200208",
            "speakerId": 10309,
            "speakerName": "翰学",
            "text": "我们正在讨论，「历史上第一枚摩拉」的下落。",
            "nextDialogs": [
              "110200209"
            ]
          },
          "110200209": {
            "id": "110200209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "历史上的第一枚摩拉？",
            "nextDialogs": [
              "110200210"
            ]
          },
          "110200210": {
            "id": "110200210",
            "speakerId": 10308,
            "speakerName": "逸轩",
            "text": "众所周知，在岩王爷的指引下，璃月先民冶炼矿石，用最初的货物与世间诸国展开贸易。",
            "nextDialogs": [
              "110200211"
            ]
          },
          "110200211": {
            "id": "110200211",
            "speakerId": 10308,
            "speakerName": "逸轩",
            "text": "如今的璃月，掌握了全大陆摩拉的唯一铸造之权。而世上第一枚摩拉，应该就是在数千年前，岩王爷亲手铸造的。",
            "nextDialogs": [
              "110200212"
            ]
          },
          "110200212": {
            "id": "110200212",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "根据我的考证…再加上一点猜测，我认为这枚具有历史意义的摩拉，可能是作为一种「信物」，秘密传承了下来。",
            "nextDialogs": [
              "110200213"
            ]
          },
          "110200213": {
            "id": "110200213",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "比如…掌管璃月的「七星」，会不会在每一代上任之前，都有什么不为外人所知的仪式…",
            "nextDialogs": [
              "110200214"
            ]
          },
          "110200214": {
            "id": "110200214",
            "speakerId": 10309,
            "speakerName": "翰学",
            "text": "不不不，按照我的研究，这「第一枚摩拉」的地位，可没这么简单。",
            "nextDialogs": [
              "110200215"
            ]
          },
          "110200215": {
            "id": "110200215",
            "speakerId": 10309,
            "speakerName": "翰学",
            "text": "众所周知，摩拉是一种触媒。直到今天，也流传着利用摩拉在神秘学中的功效，来强化武器的奇术。",
            "nextDialogs": [
              "110200216"
            ]
          },
          "110200216": {
            "id": "110200216",
            "speakerId": 10309,
            "speakerName": "翰学",
            "text": "世上第一枚摩拉，一定蕴含着最强的力量。所以我的下一本历史著作，就是要大胆论证我十年来潜心研究的最新成果！",
            "nextDialogs": [
              "110200217"
            ]
          },
          "110200217": {
            "id": "110200217",
            "speakerId": 10309,
            "speakerName": "翰学",
            "text": "那就是——岩王爷用这枚摩拉作为触媒，强化了一刀一剑。",
            "nextDialogs": [
              "110200218"
            ]
          },
          "110200218": {
            "id": "110200218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一刀一剑？",
            "nextDialogs": [
              "110200219"
            ]
          },
          "110200219": {
            "id": "110200219",
            "speakerId": 10309,
            "speakerName": "翰学",
            "text": "哼哼哼，到时就请购买著作阅读全文了。现在我只揭秘一小部分：得到刀就可以成为璃月至尊，拔出剑就可以加冕璃月之王——",
            "nextDialogs": [
              "110200220"
            ]
          },
          "110200220": {
            "id": "110200220",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "…不敢苟同。",
            "nextDialogs": [
              "110200221"
            ]
          },
          "110200221": {
            "id": "110200221",
            "speakerId": 10309,
            "speakerName": "翰学",
            "text": "嗯？",
            "nextDialogs": [
              "110200222"
            ]
          },
          "110200222": {
            "id": "110200222",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "且不提这刀剑考据的真实性…所谓摩拉，所谓金钱，诞生的初衷，只是一种方便「契约」签立的筹码而已。",
            "nextDialogs": [
              "110200223"
            ]
          },
          "110200223": {
            "id": "110200223",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "引导人类利用摩拉进行交易，才是帝君本意。",
            "nextDialogs": [
              "110200224"
            ]
          },
          "110200224": {
            "id": "110200224",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "想必「世上第一枚摩拉」，也只是被帝君当作普通的钱币，简简单单地花掉了吧…",
            "nextDialogs": [
              "110200225"
            ]
          },
          "110200225": {
            "id": "110200225",
            "speakerId": 10308,
            "speakerName": "逸轩",
            "text": "唔…我觉得翰学先生的假说很有道理，倒是这位钟离先生，无凭无据的，就这么看轻岩王爷的深远谋划？",
            "nextDialogs": [
              "110200226"
            ]
          },
          "110200226": {
            "id": "110200226",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "不…我的说法不含褒贬，只是在陈述一种事实。",
            "nextDialogs": [
              "110200227"
            ]
          },
          "110200227": {
            "id": "110200227",
            "speakerId": 10309,
            "speakerName": "翰学",
            "text": "得了吧，是你懂岩王爷还是我懂岩王爷？"
          }
        }
      }
    },
    {
      "subId": "1102003",
      "subQuestName": "去船尾了解宛烟的问题",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110200301"
        ],
        "dialogs": {
          "110200301": {
            "id": "110200301",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "接下来说的话，对岩神有些不敬，会招来很多白眼，所以…还是安静的地方比较好。",
            "nextDialogs": [
              "110200302"
            ]
          },
          "110200302": {
            "id": "110200302",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "方才见先生谈吐不凡，思维清晰，最关键的是不轻信吹嘘与演绎，非常客观。",
            "nextDialogs": [
              "110200303"
            ]
          },
          "110200303": {
            "id": "110200303",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "所以我想问先生一个问题，或许能得到与普通学者不同的答案…先生觉得，被岩神杀死的魔神，全都是邪恶的吗？",
            "nextDialogs": [
              "110200304"
            ]
          },
          "110200304": {
            "id": "110200304",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "…善与恶，暂且不论。岩王帝君尊重「契约」，所以死于他手的魔神，一定是打破了某种「契约」。",
            "nextDialogs": [
              "110200305"
            ]
          },
          "110200305": {
            "id": "110200305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，至少滥杀无辜这种事，岩王爷是不会做的吧。",
            "nextDialogs": [
              "110200306"
            ]
          },
          "110200306": {
            "id": "110200306",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "可是，我在考古的时候，了解到一些关于「盐之魔神」的传说。",
            "nextDialogs": [
              "110200307"
            ]
          },
          "110200307": {
            "id": "110200307",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "「盐之魔神」赫乌莉亚…她是一位善良的魔神，却还是在战争中被摩拉克斯…",
            "nextDialogs": [
              "110200308"
            ]
          },
          "110200308": {
            "id": "110200308",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "被摩拉克斯，用不光彩的手段…暗杀了。",
            "nextDialogs": [
              "110200309"
            ]
          },
          "110200309": {
            "id": "110200309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？不会吧！",
            "nextDialogs": [
              "110200310"
            ]
          },
          "110200310": {
            "id": "110200310",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "这…确实是说来话长的一段历史。但故事的真相，可能并不是你想知道的那种。",
            "nextDialogs": [
              "110200311"
            ]
          },
          "110200311": {
            "id": "110200311",
            "speakerId": 10303,
            "speakerName": "宛烟",
            "text": "没关系，请把你知道的历史都告诉我吧！这件事…这件事，我已经调查很久了！",
            "nextDialogs": [
              "110200313",
              "110200315"
            ]
          },
          "110200313": {
            "id": "110200313",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "不…只是，该从哪里说起呢。",
            "nextDialogs": [
              "110200316"
            ]
          },
          "110200316": {
            "id": "110200316",
            "speakerId": 10302,
            "speakerName": "克列门特",
            "text": "哦，在这在这！钟离先生！哎呀，找了好久，没想到你在这里。"
          },
          "110200315": {
            "id": "110200315",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "嗯，不知该从哪里说起。"
          }
        }
      }
    }
  ]
}
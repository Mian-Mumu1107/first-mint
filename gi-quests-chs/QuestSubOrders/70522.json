  },
  "subQuests": [
    {
      "subId": "7052201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705220101"
        ],
        "dialogs": {
          "705220101": {
            "id": "705220101",
            "speakerId": 1000,
            "speakerName": "曲清",
            "text": "欢迎光临，两位客人想喝点什么？",
            "nextDialogs": [
              "705220102"
            ]
          },
          "705220102": {
            "id": "705220102",
            "speakerId": 1000,
            "speakerName": "曲清",
            "text": "唔…看你们的装束，好像不是本地人？不知道我这里的茶饮合不合你们的口味…",
            "nextDialogs": [
              "705220103"
            ]
          },
          "705220103": {
            "id": "705220103",
            "speakerId": 1000,
            "speakerName": "曲清",
            "text": "我先给你们泡一壶云来白毫吧，如果你们不习惯，可以过段时间再来，到时我应该能托人在蒙德的佳酿节上采购一批特色饮品…",
            "nextDialogs": [
              "705220106"
            ]
          },
          "705220106": {
            "id": "705220106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦，我们是办事可靠的跑腿人！听说你在佳酿节上发布了委托，想请懂行的人帮你订购饮品，所以我们就找过来啦。",
            "nextDialogs": [
              "705220107"
            ]
          },
          "705220107": {
            "id": "705220107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你想订购什么饮品，就尽管和我们说吧，我们帮你去下单！",
            "nextDialogs": [
              "705220108"
            ]
          },
          "705220108": {
            "id": "705220108",
            "speakerId": 1000,
            "speakerName": "曲清",
            "text": "为了帮客人们下单…专门跑到璃月来了？你们真是热心肠！",
            "nextDialogs": [
              "705220109"
            ]
          },
          "705220109": {
            "id": "705220109",
            "speakerId": 1000,
            "speakerName": "曲清",
            "text": "我还担心没人会接受这么麻烦的委托呢…那就麻烦你们了！",
            "nextDialogs": [
              "705220110"
            ]
          },
          "705220110": {
            "id": "705220110",
            "speakerId": 1000,
            "speakerName": "曲清",
            "text": "我听去过蒙德的水手说，<color=#00E1FFFF>猫尾酒馆</color>的特色饮品「薄荷莓果」既解渴又安神。",
            "nextDialogs": [
              "705220111"
            ]
          },
          "705220111": {
            "id": "705220111",
            "speakerId": 1000,
            "speakerName": "曲清",
            "text": "所以我想订购<color=#00E1FFFF>65箱「薄荷莓果」</color>，和其他饮品交替着卖给水手们。如此一来，他们就能保持好心情和工作效率了。",
            "nextDialogs": [
              "705220112"
            ]
          },
          "705220112": {
            "id": "705220112",
            "speakerId": 1000,
            "speakerName": "曲清",
            "text": "以前蒙德的商人也会根据我的需要准备指定的等价物。这次我按佳酿节的规矩，提前筹集了一些「佳酿晶冻」，都交给你们了！",
            "nextDialogs": [
              "705220113"
            ]
          },
          "705220113": {
            "id": "705220113",
            "speakerId": 1000,
            "speakerName": "曲清",
            "text": "我准备的采购资金是从宽估计的，余下的部分就是两位的辛苦费了，虽然这还不足以完全表达我的谢意…"
          }
        }
      }
    },

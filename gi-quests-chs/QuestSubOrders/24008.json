    {
      "subId": "2400802",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240080201"
        ],
        "dialogs": {
          "240080201": {
            "id": "240080201",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "好天气，好渔点，没有膨膨兽，也没有记者…太棒了！",
            "nextDialogs": [
              "240080202"
            ]
          },
          "240080202": {
            "id": "240080202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "今天心情不错？",
            "nextDialogs": [
              "240080203"
            ]
          },
          "240080203": {
            "id": "240080203",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "从各方面来说，都很不错。遇见您之后，我的心情就更好了，哈哈哈！",
            "nextDialogs": [
              "240080204"
            ]
          },
          "240080204": {
            "id": "240080204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "发生了什么好事吗？还是发生了有趣的事情？",
            "nextDialogs": [
              "240080205"
            ]
          },
          "240080205": {
            "id": "240080205",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "都没有，什么也没有发生！每一天都很平静，毫无波澜。",
            "nextDialogs": [
              "240080206"
            ]
          },
          "240080206": {
            "id": "240080206",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "没有记者，没有通知，没有谁说漏了嘴，也没有人弄丢了账单和文件。",
            "nextDialogs": [
              "240080207"
            ]
          },
          "240080207": {
            "id": "240080207",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "每一件事都依据着秩序完美地运转，没有一丝错漏…",
            "nextDialogs": [
              "240080208"
            ]
          },
          "240080208": {
            "id": "240080208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那个…别动！你千万别动呀！",
            "nextDialogs": [
              "240080209"
            ]
          },
          "240080209": {
            "id": "240080209",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "怎么了？怎么突然…",
            "nextDialogs": [
              "240080210"
            ]
          },
          "240080210": {
            "id": "240080210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "千万别动…",
            "nextDialogs": [
              "240080211"
            ]
          },
          "240080211": {
            "id": "240080211",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "您到底怎么了，难道是那群膨膨兽又回来了？哈哈哈，我之前已经到处看过了，它们…",
            "nextDialogs": [
              "240080212"
            ]
          },
          "240080212": {
            "id": "240080212",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "啊！史莱姆！哪里来的这么多史莱姆！救命！救我！",
            "nextDialogs": [
              "240080213"
            ]
          },
          "240080213": {
            "id": "240080213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以说，都叫你不要动啦！",
            "nextDialogs": [
              "240080214"
            ]
          },
          "240080214": {
            "id": "240080214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "赶紧趴下！",
            "nextDialogs": [
              "240080215"
            ]
          },
          "240080215": {
            "id": "240080215",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "救命啊！"
          }
        }
      }
    },
    {
      "subId": "2400806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240080601"
        ],
        "dialogs": {
          "240080601": {
            "id": "240080601",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "我收回之前那句话，看来今天并不是所有事都完美地按照秩序运转…",
            "nextDialogs": [
              "240080602"
            ]
          },
          "240080602": {
            "id": "240080602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "史莱姆刚才的行为也是依照秩序喔。",
            "nextDialogs": [
              "240080603"
            ]
          },
          "240080603": {
            "id": "240080603",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "非常幽默，我真欣赏您…照您这么说，今天实际上是这群史莱姆的幸运日，我只是它们美好生活的一个注脚。",
            "nextDialogs": [
              "240080604"
            ]
          },
          "240080604": {
            "id": "240080604",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "看来每个人所期望的美好生活，不一定完全一样，也不一定互不相扰啊。",
            "nextDialogs": [
              "240080605"
            ]
          },
          "240080605": {
            "id": "240080605",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "见鬼…刚才一顿折腾，我的腰一定是伤了。我得快点回城里去看看…哎哟…",
            "nextDialogs": [
              "240080606"
            ]
          },
          "240080606": {
            "id": "240080606",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "这报酬是给您了，谢谢您旅行者，我…哎哟…真是受不了…"
          }
        }
      }
    },
    {
      "subId": "2400807",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240080701"
        ],
        "dialogs": {
          "240080701": {
            "id": "240080701",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "您把鱼饵拿回来了？太好了，这样我就可以继续钓鱼了…",
            "nextDialogs": [
              "240080702"
            ]
          },
          "240080702": {
            "id": "240080702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "布希柯要我告诉你…",
            "nextDialogs": [
              "240080703"
            ]
          },
          "240080703": {
            "id": "240080703",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向洛耶茨转达了布希柯的话…",
            "nextDialogs": [
              "240080704"
            ]
          },
          "240080704": {
            "id": "240080704",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "哈哈哈，这家伙怎么还担心起我来了。这种事情我自己心里有数。",
            "nextDialogs": [
              "240080705"
            ]
          },
          "240080705": {
            "id": "240080705",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "至于叫上几个人和我一起钓鱼…我的那些钓鱼伙伴啊，要么成了家，要么在外面奔忙，已经很久不联系喽。",
            "nextDialogs": [
              "240080706"
            ]
          },
          "240080706": {
            "id": "240080706",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "我又不是很喜欢和不认识的人一起钓鱼，所以，就只能自己一个人行动。",
            "nextDialogs": [
              "240080707"
            ]
          },
          "240080707": {
            "id": "240080707",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "等一下，我是不是…可以把艾尤恩叫上一起来钓鱼呢，他正好也需要放松身心。",
            "nextDialogs": [
              "240080708"
            ]
          },
          "240080708": {
            "id": "240080708",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "这些报酬是给您的，请收下吧。多谢您帮忙了。",
            "nextDialogs": [
              "240080709"
            ]
          },
          "240080709": {
            "id": "240080709",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "对…这样不错，明天上班的时候我就去问问艾尤恩的意见。",
            "nextDialogs": [
              "240080710"
            ]
          },
          "240080710": {
            "id": "240080710",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "要是他愿意来，我们俩就可以带上更多的渔具，也能走得更远，找到更好的渔窝了…"
          }
        }
      }
    },
    {
      "subId": "2400810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240081001"
        ],
        "dialogs": {
          "240081001": {
            "id": "240081001",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "唔…接下来该讲什么呢…"
          }
        }
      }
    },
    {
      "subId": "2400811",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240081101"
        ],
        "dialogs": {
          "240081101": {
            "id": "240081101",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "唉，这群赶不走的膨膨兽…"
          }
        }
      }
    },
    {
      "subId": "2400812",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240081201"
        ],
        "dialogs": {
          "240081201": {
            "id": "240081201",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "救命啊！哪里来的这么多史莱姆？！"
          }
        }
      }
    },
    {
      "subId": "2400899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240089901"
        ],
        "dialogs": {
          "240089901": {
            "id": "240089901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "快走啦，别打扰我们听故事！去！去！",
            "nextDialogs": [
              "240089902"
            ]
          },
          "240089902": {
            "id": "240089902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这下应该可以了，我们回去找洛耶茨吧，听他能讲出个什么故事来。",
            "nextDialogs": [
              "240089903"
            ]
          },
          "240089903": {
            "id": "240089903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这下应该可以了，我们回去找洛耶茨吧。",
            "nextDialogs": [
              "240089904"
            ]
          },
          "240089904": {
            "id": "240089904",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！这群水史莱姆是从哪里冒出来的，冲过来了，快打倒它们！"
          }
        }
      }
    }
  ]
}
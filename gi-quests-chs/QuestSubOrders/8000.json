    {
      "subId": "800009",
      "subQuestName": "与深渊使徒交涉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80000401"
        ],
        "dialogs": {
          "80000401": {
            "id": "80000401",
            "speakerId": 1005,
            "speakerName": "？？？",
            "text": "「深渊」的奥秘，不可窥探。",
            "nextDialogs": [
              "80000402"
            ]
          },
          "80000402": {
            "id": "80000402",
            "speakerId": 1005,
            "speakerName": "？？？",
            "text": "汝等来此，汝等直视。那么，就应当承担与之对等的代价。",
            "nextDialogs": [
              "80000403"
            ]
          },
          "80000403": {
            "id": "80000403",
            "speakerId": 1004,
            "speakerName": "深渊使徒",
            "text": "——谴罚，由「使徒」降下。",
            "nextDialogs": [
              "80000404"
            ]
          },
          "80000404": {
            "id": "80000404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「深渊」…「使徒」？",
            "nextDialogs": [
              "80000407"
            ]
          },
          "80000407": {
            "id": "80000407",
            "speakerId": 1004,
            "speakerName": "深渊使徒",
            "text": "戴因…戴因斯雷布？原来如此，本以为你们只是误闯的老鼠，却也与那纠缠不休之人有关…",
            "nextDialogs": [
              "80000408"
            ]
          },
          "80000408": {
            "id": "80000408",
            "speakerId": 1004,
            "speakerName": "深渊使徒",
            "text": "他派你们来送死？他对「深渊」的反抗早已陷入僵局，绝不会因为微不足道的波澜，产生新的变数…",
            "nextDialogs": [
              "80000409"
            ]
          },
          "80000409": {
            "id": "80000409",
            "speakerId": 1004,
            "speakerName": "深渊使徒",
            "text": "「深渊」…无可阻挡！"
          }
        }
      }
    },

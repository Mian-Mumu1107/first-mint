          "80000001": {
            "id": "80000001",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这是什么力量…从来没有见过…",
            "nextDialogs": [
              "80000002"
            ]
          },
          "80000002": {
            "id": "80000002",

        "startDialogs": [
          "1906203302"
        ],
        "dialogs": {
          "1906203302": {
            "id": "1906203302",
            "speakerId": 11001,
            "speakerName": "阿洛瓦",
            "text": "先！先不谈这个了！这喝完酒，才发现肚子空空呢…",
            "nextDialogs": [
              "1906203303"
            ]
          },
          "1906203303": {
            "id": "1906203303",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "原来先生您还饿着肚子。",
            "nextDialogs": [
              "1906203304"
            ]
          },
          "1906203304": {
            "id": "1906203304",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "这是我的失职。如果早知道这一点的话，在遇见您的时候。就应该分您一点松饼…",
            "nextDialogs": [
              "1906203305"
            ]
          },
          "1906203305": {
            "id": "1906203305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别太在意了，我们去「猎鹿人」餐馆吧。",
            "nextDialogs": [
              "1906203306"
            ]
          },
          "1906203306": {
            "id": "1906203306",
            "speakerId": 11001,
            "speakerName": "阿洛瓦",
            "text": "好，好！我们就去那儿了！"
          }
        }
      }
    },

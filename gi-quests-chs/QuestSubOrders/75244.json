    {
      "subId": "7524402",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752440201"
        ],
        "dialogs": {
          "752440201": {
            "id": "752440201",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "哦呀，你找到我的帽子了？",
            "nextDialogs": [
              "752440202"
            ]
          },
          "752440202": {
            "id": "752440202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是这个吗？"
          }
        }
      }
    },
    {
      "subId": "7524403",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752440302"
        ],
        "dialogs": {
          "752440302": {
            "id": "752440302",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "没错！真是太感谢你了，有了这顶帽子，我一下就放心很多了。",
            "nextDialogs": [
              "752440303"
            ]
          },
          "752440303": {
            "id": "752440303",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "这可是我找人特制的安全帽，连铳枪的子弹都能防出去。",
            "nextDialogs": [
              "752440307"
            ]
          },
          "752440307": {
            "id": "752440307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你多虑了，只是钓鱼而已。",
            "nextDialogs": [
              "752440304"
            ]
          },
          "752440304": {
            "id": "752440304",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "你不知道，之前就有个家伙在岸边钓鱼，被人在远处用箭还是铳枪之类的玩意，射瞎了一只眼，多危险啊。",
            "nextDialogs": [
              "752440305"
            ]
          },
          "752440305": {
            "id": "752440305",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "据说那是一伙挪德卡莱过来的土匪在内讧…但谁知道呢？既然有了这种先例，我们也还是小心为妙啊。"
          }
        }
      }
    },
    {
      "subId": "7524404",

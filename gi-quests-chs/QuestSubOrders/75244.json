    {
      "subId": "7524401",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752440101"
        ],
        "dialogs": {
          "752440101": {
            "id": "752440101",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "哦呀，你也是来钓鱼的吗？要知道钓鱼啊，要戴着足够坚固的帽子才行啊。",
            "nextDialogs": [
              "752440106"
            ]
          },
          "752440106": {
            "id": "752440106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么要戴帽子？",
            "nextDialogs": [
              "752440102"
            ]
          },
          "752440102": {
            "id": "752440102",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "因为戴帽子才安全。",
            "nextDialogs": [
              "752440107"
            ]
          },
          "752440107": {
            "id": "752440107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可你也没戴帽子。",
            "nextDialogs": [
              "752440103"
            ]
          },
          "752440103": {
            "id": "752440103",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "这就是我跟你搭话的原因…真不好意思，我的帽子被风吹跑了。",
            "nextDialogs": [
              "752440104"
            ]
          },
          "752440104": {
            "id": "752440104",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "不介意的话，能帮我找一找吗？",
            "nextDialogs": [
              "752440108"
            ]
          },
          "752440108": {
            "id": "752440108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么不自己去找？",
            "nextDialogs": [
              "752440105"
            ]
          },
          "752440105": {
            "id": "752440105",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "如果我去找帽子，就必须要放下鱼竿，如果我拿起鱼竿，就没法去找帽子…",
            "nextDialogs": [
              "752440109"
            ]
          },
          "752440109": {
            "id": "752440109",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "所以拜托你，请帮我一把吧。"
          }
        }
      }
    },
    {
      "subId": "7524404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752440402"
        ],
        "dialogs": {
          "752440402": {
            "id": "752440402",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "还在在乎那些土匪吗？别太担心啦，万一你真遇上了，报我的名字，你会没事的。",
            "nextDialogs": [
              "752440403"
            ]
          },
          "752440403": {
            "id": "752440403",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "别的就不要问了，你和我有缘，还帮我捡了帽子，就当是对你的感谢啦。"
          }
        }
      }
    },
    {
      "subId": "7524406",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752440601"
        ],
        "dialogs": {
          "752440601": {
            "id": "752440601",
            "speakerId": 6520,
            "speakerName": "瑞安提",
            "text": "不好意思，再见。"
          }
        }
      }
    }

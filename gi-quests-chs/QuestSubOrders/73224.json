          },
          "732750103": {
            "id": "732750103",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "这些…嘿哟，你这小娃娃是在哪里找到这些花种的？",
            "nextDialogs": [
              "732750104"
            ]
          },
          "732750104": {
            "id": "732750104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在很远的地方捡到的。",
            "nextDialogs": [

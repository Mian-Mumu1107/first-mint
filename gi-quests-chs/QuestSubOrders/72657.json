{
  "lineCounts": {
    "Player": 3,
    "斑目百兵卫": 18
  },
  "subQuests": [
    {
      "subId": "7265701",
      "subQuestName": "与斑目百兵卫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726570101"
        ],
        "dialogs": {
          "726570101": {
            "id": "726570101",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "贵客请留步，想必您就是神里大小姐提到的那位旅行者？",
            "nextDialogs": [
              "726570102"
            ]
          },
          "726570102": {
            "id": "726570102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "正是在下。",
            "nextDialogs": [
              "726570103"
            ]
          },
          "726570103": {
            "id": "726570103",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "失礼了，在下斑目百兵卫，是神里氏家臣。",
            "nextDialogs": [
              "726570104"
            ]
          },
          "726570104": {
            "id": "726570104",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "阁下的名讳与事迹，我有所耳闻，况且就连神里大小姐对您也是十二分的器重，可见阁下是一位值得信赖的义士。",
            "nextDialogs": [
              "726570105"
            ]
          },
          "726570105": {
            "id": "726570105",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "我早想拜会，可惜各项事务缠身…",
            "nextDialogs": [
              "726570107",
              "726570109"
            ]
          },
          "726570107": {
            "id": "726570107",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "阁下过谦了，社奉行神里绫人大人也曾和我提起您的事，连大人他也认为您值得信赖。",
            "nextDialogs": [
              "726570110"
            ]
          },
          "726570110": {
            "id": "726570110",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "我还是直说吧，由于神社供奉事宜恰好在社奉行管辖范围内，我们常常能听到各种来自人民的愿望。",
            "nextDialogs": [
              "726570111"
            ]
          },
          "726570111": {
            "id": "726570111",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "神里小姐仁慈亲和，说服了奉行大人拨款备物，帮助大家实现愿望。",
            "nextDialogs": [
              "726570112"
            ]
          },
          "726570112": {
            "id": "726570112",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "大人考量之后，决定以公开委托的方式帮助大家实现愿望，所以派我协调此事。",
            "nextDialogs": [
              "726570113"
            ]
          },
          "726570113": {
            "id": "726570113",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "不过尽管报酬充足，但大家的委托实在太多，我们的人手时有不足…如果阁下愿意协助那就太好了。",
            "nextDialogs": [
              "726570114"
            ]
          },
          "726570114": {
            "id": "726570114",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "暂时没有空闲也不妨事，日后您有了闲暇随时可以来找我询问。",
            "nextDialogs": [
              "726570115"
            ]
          },
          "726570115": {
            "id": "726570115",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "总而言之，我已经将收到的委托整理出来了，您可以具体看看。"
          },
          "726570109": {
            "id": "726570109",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "哈哈，您果真和传闻中的一样直率，如此拐弯抹角是我器量小了。"
          }
        }
      }
    },
    {
      "subId": "7265702",
      "subQuestName": "与斑目百兵卫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726570201"
        ],
        "dialogs": {
          "726570201": {
            "id": "726570201",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "如果您有意愿有空闲，不妨尝试一下，大家都会衷心感激的。",
            "nextDialogs": [
              "726570202"
            ]
          },
          "726570202": {
            "id": "726570202",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "顺利解决了问题的话，不仅能获得报酬，您在稻妻城中的声望也会提高。",
            "nextDialogs": [
              "726570203"
            ]
          },
          "726570203": {
            "id": "726570203",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "不过，在成为万众敬仰之人前，需要先从小事做起，这个道理在此也能适用。",
            "nextDialogs": [
              "726570204"
            ]
          },
          "726570204": {
            "id": "726570204",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "具体来说就是，您的声望越高，所能承接的委托就越复杂，这也是众人对您信任的体现。",
            "nextDialogs": [
              "726570205"
            ]
          },
          "726570205": {
            "id": "726570205",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "阁下不妨好好考虑，当然如果您愿意协助，在下自然感激不尽。",
            "nextDialogs": [
              "726570206"
            ]
          },
          "726570206": {
            "id": "726570206",
            "speakerId": 3098,
            "speakerName": "斑目百兵卫",
            "text": "您可以回去仔细想一想。"
          }
        }
      }
    }
  ]
}
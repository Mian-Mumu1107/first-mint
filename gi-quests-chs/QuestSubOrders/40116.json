    {
      "subId": "4011602",
      "subQuestName": "与伊迪娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401160201"
        ],
        "dialogs": {
          "401160201": {
            "id": "401160201",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "…真的吗？！这也太不好意思了吧。",
            "nextDialogs": [
              "401160202"
            ]
          },
          "401160202": {
            "id": "401160202",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "没关系的，我们也想为蜃境多出点力。",
            "nextDialogs": [
              "401160203"
            ]
          },
          "401160203": {
            "id": "401160203",
            "speakerId": 13253,
            "speakerName": "莱斯格",
            "text": "再怎么说，这也是我本人造成的…",
            "nextDialogs": [
              "401160204"
            ]
          },
          "401160204": {
            "id": "401160204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？发生什么事了？我们错过了什么？",
            "nextDialogs": [
              "401160205"
            ]
          },
          "401160205": {
            "id": "401160205",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "两位好，就在刚才，莱斯格终于向我们坦白了一件事。",
            "nextDialogs": [
              "401160206"
            ]
          },
          "401160206": {
            "id": "401160206",
            "speakerId": 13253,
            "speakerName": "莱斯格",
            "text": "还是让我自己来说吧。",
            "nextDialogs": [
              "401160207"
            ]
          },
          "401160207": {
            "id": "401160207",
            "speakerId": 13253,
            "speakerName": "莱斯格",
            "text": "——我就是导致蜃境一系列麻烦的罪魁祸首。",
            "nextDialogs": [
              "401160208"
            ]
          },
          "401160208": {
            "id": "401160208",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "…唉，莱斯格先生…",
            "nextDialogs": [
              "401160209"
            ]
          },
          "401160209": {
            "id": "401160209",
            "speakerId": 13253,
            "speakerName": "莱斯格",
            "text": "起因是，我在秘境入口处看到一个精致的水球，它跟七岁时祖父送我的星仪十分相像…",
            "nextDialogs": [
              "401160210"
            ]
          },
          "401160210": {
            "id": "401160210",
            "speakerId": 13253,
            "speakerName": "莱斯格",
            "text": "我好奇它能不能转动，就伸手碰了那么一下…",
            "nextDialogs": [
              "401160211"
            ]
          },
          "401160211": {
            "id": "401160211",
            "speakerId": 13253,
            "speakerName": "莱斯格",
            "text": "谁…谁知道那就是蜃境的核心。我是说…在天地旋转起来的时候，我已经发现大事不妙了…",
            "nextDialogs": [
              "401160212"
            ]
          },
          "401160212": {
            "id": "401160212",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "不能全怪你，我也有保管不当的责任…唉，早知道就该把核心好好锁起来的。",
            "nextDialogs": [
              "401160234"
            ]
          },
          "401160234": {
            "id": "401160234",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，秘境的入口？难道就是那个「大水球」？",
            "nextDialogs": [
              "401160213"
            ]
          },
          "401160213": {
            "id": "401160213",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "…就是这样。大家一番反思过后，莱斯格先生主动提议说，想为蜃境做些维修和保养加固的工作。",
            "nextDialogs": [
              "401160214"
            ]
          },
          "401160214": {
            "id": "401160214",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "但他一个人恐怕应付不来，我和优菈决定留下来搭把手。",
            "nextDialogs": [
              "401160215"
            ]
          },
          "401160215": {
            "id": "401160215",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "不不，我可没有柯莱那样的善心。我的工作内容仅限于监督并确保这家伙不帮倒忙。",
            "nextDialogs": [
              "401160216"
            ]
          },
          "401160216": {
            "id": "401160216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…嗯嗯…",
            "nextDialogs": [
              "401160217"
            ]
          },
          "401160217": {
            "id": "401160217",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "都这个时候了，优菈还以为大家会相信这一套吗…虽然安柏说过这种时候只要附和就行…",
            "nextDialogs": [
              "401160218"
            ]
          },
          "401160218": {
            "id": "401160218",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "咳咳！",
            "nextDialogs": [
              "401160219"
            ]
          },
          "401160219": {
            "id": "401160219",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "啊那个那个，莱斯格先生！你今天一定要好好努力工作哦！",
            "nextDialogs": [
              "401160220"
            ]
          },
          "401160220": {
            "id": "401160220",
            "speakerId": 13253,
            "speakerName": "莱斯格",
            "text": "呃，一定，一定！",
            "nextDialogs": [
              "401160221"
            ]
          },
          "401160221": {
            "id": "401160221",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "…哼，反正不管怎么说，今天的午饭必须由莱斯格来做。",
            "nextDialogs": [
              "401160223",
              "401160225"
            ]
          },
          "401160223": {
            "id": "401160223",
            "speakerId": 13253,
            "speakerName": "莱斯格",
            "text": "我会尽力的，请放心！",
            "nextDialogs": [
              "401160226"
            ]
          },
          "401160226": {
            "id": "401160226",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "嗯？",
            "nextDialogs": [
              "401160227"
            ]
          },
          "401160227": {
            "id": "401160227",
            "speakerId": 13253,
            "speakerName": "莱斯格",
            "text": "哦不不，感谢各位不计前嫌，我一定会将这份感动化作力量！也不对…化作…化作热量…？",
            "nextDialogs": [
              "401160228"
            ]
          },
          "401160228": {
            "id": "401160228",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "不错不错，但力气可要省着点用。蜃境内部很多地方都年久失修了，一定要逐项排查清楚…",
            "nextDialogs": [
              "401160229"
            ]
          },
          "401160229": {
            "id": "401160229",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一找到答应干活的人，伊迪娅的气势都跟平时不一样了…",
            "nextDialogs": [
              "401160230"
            ]
          },
          "401160230": {
            "id": "401160230",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "除了这边三位，剩下的人今天就一起行动吧！",
            "nextDialogs": [
              "401160231"
            ]
          },
          "401160231": {
            "id": "401160231",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "我去把其他人叫过来，我们准备一下，尽早出发。",
            "nextDialogs": [
              "401160232"
            ]
          },
          "401160232": {
            "id": "401160232",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她兴致勃勃地跑开了，看起来真的很高兴…",
            "nextDialogs": [
              "401160233"
            ]
          },
          "401160233": {
            "id": "401160233",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "第一次当上工头的人或许就是如此吧。",
            "nextDialogs": [
              "401160235"
            ]
          },
          "401160235": {
            "id": "401160235",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "稍作等待之后，和伊迪娅叫来的可莉、凯亚与珊瑚宫心海，一起出发前往最后的零件所在的地区…"
          },
          "401160225": {
            "id": "401160225",
            "speakerId": 13253,
            "speakerName": "莱斯格",
            "text": "欸？好的，但…以我的水平真的可以吗…"
          }
        }
      }
    },
    {
      "subId": "4011603",
      "subQuestName": "前往最后的区域",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4011604",
      "subQuestName": "与伊迪娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401160401"
        ],
        "dialogs": {
          "401160401": {
            "id": "401160401",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "这家伙平时不爱出门，一直待在树屋里。不是制作舞台上需要用到的道具，就是闷头写剧本…",
            "nextDialogs": [
              "401160402"
            ]
          },
          "401160402": {
            "id": "401160402",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "但这家伙的树屋，是在什么地方来着…",
            "nextDialogs": [
              "401160403"
            ]
          },
          "401160403": {
            "id": "401160403",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "伊迪娅姐姐不记得吗？",
            "nextDialogs": [
              "401160404"
            ]
          },
          "401160404": {
            "id": "401160404",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "呃，伊迪娅姐姐只是个「吉祥物」，啊哈哈…",
            "nextDialogs": [
              "401160405"
            ]
          },
          "401160405": {
            "id": "401160405",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "应该是在那个方向。",
            "nextDialogs": [
              "401160406"
            ]
          },
          "401160406": {
            "id": "401160406",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "咦？",
            "nextDialogs": [
              "401160407"
            ]
          },
          "401160407": {
            "id": "401160407",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "虽然也有人喜欢僻静，但既然这位「导演」需要搬运道具，住处就不能离剧场太远。",
            "nextDialogs": [
              "401160408"
            ]
          },
          "401160408": {
            "id": "401160408",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "如果能随时看到剧场全貌，对于模拟舞台流程也会有所帮助。",
            "nextDialogs": [
              "401160409"
            ]
          },
          "401160409": {
            "id": "401160409",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "是我的话，我会选那边的树屋。",
            "nextDialogs": [
              "401160410"
            ]
          },
          "401160410": {
            "id": "401160410",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "可你是怎么知道剧场方向的呢？",
            "nextDialogs": [
              "401160411"
            ]
          },
          "401160411": {
            "id": "401160411",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "啊，这个不难。越靠近那边，四周布置得越是热闹。",
            "nextDialogs": [
              "401160412"
            ]
          },
          "401160412": {
            "id": "401160412",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "好有道理！为什么我就想不到呢…"
          }
        }
      }
    },
    {
      "subId": "4011605",
      "subQuestName": "前往「导演」的树屋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4011606",
      "subQuestName": "与「导演」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401160601"
        ],
        "dialogs": {
          "401160601": {
            "id": "401160601",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "自动机关，掉到哪里去了？男演员的人形板倒是还有，可女演员的呢…",
            "nextDialogs": [
              "401160602"
            ]
          },
          "401160602": {
            "id": "401160602",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "嗯？这是谁，伊迪娅？",
            "nextDialogs": [
              "401160603"
            ]
          },
          "401160603": {
            "id": "401160603",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "对，是我本人，佐西摩斯。这就是戏剧性登场——",
            "nextDialogs": [
              "401160604"
            ]
          },
          "401160604": {
            "id": "401160604",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "真意外，我还以为…",
            "nextDialogs": [
              "401160605"
            ]
          },
          "401160605": {
            "id": "401160605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「你一定躲在谁都找不到的地方哭呢。」",
            "nextDialogs": [
              "401160606"
            ]
          },
          "401160606": {
            "id": "401160606",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "唔，神奇的小家伙，你能读我的心吗？",
            "nextDialogs": [
              "401160607"
            ]
          },
          "401160607": {
            "id": "401160607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我叫派蒙，我可没这种神奇的本领，单纯是听到过太多次了啦。",
            "nextDialogs": [
              "401160608"
            ]
          },
          "401160608": {
            "id": "401160608",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "哈哈，大家对你的评价都很一致嘛，伊迪娅。",
            "nextDialogs": [
              "401160609"
            ]
          },
          "401160609": {
            "id": "401160609",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "早知道我一开始就该当「吉祥物」的…这种情况是不是叫做：选错路线，人生受挫…唉…",
            "nextDialogs": [
              "401160610"
            ]
          },
          "401160610": {
            "id": "401160610",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "「吉祥物」？你的新角色？我没给你写过这种吧？",
            "nextDialogs": [
              "401160611"
            ]
          },
          "401160611": {
            "id": "401160611",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "好啦，别再谈论我的事了，我来给你介绍一下我的朋友们吧。",
            "nextDialogs": [
              "401160612"
            ]
          },
          "401160612": {
            "id": "401160612",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "伊迪娅向佐西摩斯逐一介绍了大家，并道明了事情的缘由…",
            "nextDialogs": [
              "401160613"
            ]
          },
          "401160613": {
            "id": "401160613",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "这下明白了吧！所以呢？「核心轮縠」的零件在你手上吗？",
            "nextDialogs": [
              "401160614"
            ]
          },
          "401160614": {
            "id": "401160614",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "在倒是在…",
            "nextDialogs": [
              "401160615"
            ]
          },
          "401160615": {
            "id": "401160615",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "但就因为那个事故，舞台上的机关都出了很多差错，没有办法支持原先的演出…",
            "nextDialogs": [
              "401160616"
            ]
          },
          "401160616": {
            "id": "401160616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我懂了！现在「零件」是人质，佐西摩斯希望我们帮你修机关。",
            "nextDialogs": [
              "401160617"
            ]
          },
          "401160617": {
            "id": "401160617",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "错啦，是修舞台吧？",
            "nextDialogs": [
              "401160618"
            ]
          },
          "401160618": {
            "id": "401160618",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "佐西摩斯先生找不到人形板，所以是…修道具吧？",
            "nextDialogs": [
              "401160619"
            ]
          },
          "401160619": {
            "id": "401160619",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "修零件！零件也坏啦——",
            "nextDialogs": [
              "401160620"
            ]
          },
          "401160620": {
            "id": "401160620",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "如果从他的日常工作入手呢？既然佐西摩斯先生需要写剧本…我猜是修剧本。",
            "nextDialogs": [
              "401160623"
            ]
          },
          "401160623": {
            "id": "401160623",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "…各位到底经历了什么，为什么要把我想得那么坏？零件完好无损，需要的话，我现在就可以给你们。",
            "nextDialogs": [
              "401160624"
            ]
          },
          "401160624": {
            "id": "401160624",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "我的本意是想先请大家帮我…「修复演出」。",
            "nextDialogs": [
              "401160625"
            ]
          },
          "401160625": {
            "id": "401160625",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "你们看，既然这里有那么多人，应该能填补演出需要的空缺。",
            "nextDialogs": [
              "401160626"
            ]
          },
          "401160626": {
            "id": "401160626",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "演出！听上去好好玩！",
            "nextDialogs": [
              "401160627"
            ]
          },
          "401160627": {
            "id": "401160627",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "可莉想帮忙！大家都来吧？",
            "nextDialogs": [
              "401160628"
            ]
          },
          "401160628": {
            "id": "401160628",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实还不错…",
            "nextDialogs": [
              "401160629"
            ]
          },
          "401160629": {
            "id": "401160629",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "而且，不瞒你们说，刚才我一直在想那个剧本要怎么继续下去…就在这时，各位出现在我眼前。",
            "nextDialogs": [
              "401160630"
            ]
          },
          "401160630": {
            "id": "401160630",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "如同一道灵感之光骤然降临！啊，真不知道怎么说好。看见你们的时候，我突然又能继续写下去了！",
            "nextDialogs": [
              "401160631"
            ]
          },
          "401160631": {
            "id": "401160631",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "咦？是说你那个卡了很久的故事…真的？真的能写下去吗？",
            "nextDialogs": [
              "401160632"
            ]
          },
          "401160632": {
            "id": "401160632",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "真的！！给我一点时间，我马上搞定剧本！伊迪娅，这里就先交给你了。",
            "nextDialogs": [
              "401160633"
            ]
          },
          "401160633": {
            "id": "401160633",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "伊迪娅大张着嘴巴，眼看着佐西摩斯如呼啸的风暴一般奔到角落，抽出笔写起了剧本…",
            "nextDialogs": [
              "401160634"
            ]
          },
          "401160634": {
            "id": "401160634",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他、他真的去写了…",
            "nextDialogs": [
              "401160635"
            ]
          },
          "401160635": {
            "id": "401160635",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "唉，佐西摩斯一直想写个有关大盗、魔女什么的故事，据说也是取材自传闻，不过只想了个开头，一直卡着…",
            "nextDialogs": [
              "401160636"
            ]
          },
          "401160636": {
            "id": "401160636",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "大家休息一会儿吧，我来看看这里有什么能准备的，等导演写完我们再讨论。",
            "nextDialogs": [
              "401160637"
            ]
          },
          "401160637": {
            "id": "401160637",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "不知过了多久，佐西摩斯飞一般冲了回来，举着一叠剧本分发给大家…",
            "nextDialogs": [
              "401160638"
            ]
          },
          "401160638": {
            "id": "401160638",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "不敢相信，这么短的时间里他真的完成了一份剧作。",
            "nextDialogs": [
              "401160639"
            ]
          },
          "401160639": {
            "id": "401160639",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "一个导演，一个作家！他最重要的，就是灵感！所以在看到「军师」珊瑚宫小姐的瞬间，我就想到了一个新角色。",
            "nextDialogs": [
              "401160640"
            ]
          },
          "401160640": {
            "id": "401160640",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "加入了女主角之后，故事变得完整又流畅。看看剧本吧，各位，接下来我们就要一起去完成它了！",
            "nextDialogs": [
              "401160641"
            ]
          },
          "401160641": {
            "id": "401160641",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "在佐西摩斯殷切的注视下，众人阅读剧本，并听他讲解了后续演出计划…",
            "nextDialogs": [
              "401160642"
            ]
          },
          "401160642": {
            "id": "401160642",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "还有什么不明白的吗？",
            "nextDialogs": [
              "401160643"
            ]
          },
          "401160643": {
            "id": "401160643",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "佐西摩斯哥哥，这个字要怎么念啊？什么身之所…",
            "nextDialogs": [
              "401160644"
            ]
          },
          "401160644": {
            "id": "401160644",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "我看看，是「栖」哦，是小鸟停留在树枝上的意思。念的时候神态要可爱一点哦。",
            "nextDialogs": [
              "401160645"
            ]
          },
          "401160645": {
            "id": "401160645",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "唔，这个字可莉也不会念…",
            "nextDialogs": [
              "401160646"
            ]
          },
          "401160646": {
            "id": "401160646",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "没关系，解散之后，我先陪可莉把台词多顺几遍。",
            "nextDialogs": [
              "401160647"
            ]
          },
          "401160647": {
            "id": "401160647",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "实在是有劳凯亚先生了。我刚才就感觉到，您看起来对「扮演」非常有心得，难道以前做过演员吗？",
            "nextDialogs": [
              "401160648"
            ]
          },
          "401160648": {
            "id": "401160648",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哈哈哈，您过奖了，只是台词念得顺一些而已。",
            "nextDialogs": [
              "401160649"
            ]
          },
          "401160649": {
            "id": "401160649",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "哎呀，居然是这样？那您真是太有天赋了，实不相瞒，我一直在找这样的人选。",
            "nextDialogs": [
              "401160650"
            ]
          },
          "401160650": {
            "id": "401160650",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "要是我以后能成为知名导演，真想请您与我长期合作啊！哎呀，我们必须保持长期联系…",
            "nextDialogs": [
              "401160651"
            ]
          },
          "401160651": {
            "id": "401160651",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "好说，好说。",
            "nextDialogs": [
              "401160652"
            ]
          },
          "401160652": {
            "id": "401160652",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "好，好。那么，劳烦各位再读读剧本，品味一下演出细节。我得去看看舞台，先走一步。",
            "nextDialogs": [
              "401160653"
            ]
          },
          "401160653": {
            "id": "401160653",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "有事找我的话，我就在区域中央，最大的剧场里面。"
          }
        }
      }
    },
    {
      "subId": "4011614",
      "subQuestName": "前往中央的剧场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4011607",
      "subQuestName": "前往中央的剧场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401160701"
        ],
        "dialogs": {
          "401160701": {
            "id": "401160701",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "…咦？不在，我记得之前明明放在这里的。",
            "nextDialogs": [
              "401160702"
            ]
          },
          "401160702": {
            "id": "401160702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "佐西摩斯！你还在忙呀？",
            "nextDialogs": [
              "401160703"
            ]
          },
          "401160703": {
            "id": "401160703",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "哦，原来是你们啊。",
            "nextDialogs": [
              "401160704"
            ]
          },
          "401160704": {
            "id": "401160704",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "来，两位都凑近点，仔细看看这个舞台吧！是由本人精心设计的。",
            "nextDialogs": [
              "401160707"
            ]
          },
          "401160707": {
            "id": "401160707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来「导演」的工作，还包括设计舞台吗？",
            "nextDialogs": [
              "401160708"
            ]
          },
          "401160708": {
            "id": "401160708",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "那你可得好好佩服我了。这里的导演，编剧，舞台…都只有我一个人。",
            "nextDialogs": [
              "401160709"
            ]
          },
          "401160709": {
            "id": "401160709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听上去好辛苦，换作伊迪娅一定受不了吧。",
            "nextDialogs": [
              "401160710"
            ]
          },
          "401160710": {
            "id": "401160710",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "伊迪娅小姐也不轻松，她是我唯一一位观众…只不过我经常被她指责。",
            "nextDialogs": [
              "401160711"
            ]
          },
          "401160711": {
            "id": "401160711",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她居然还会指责别人？",
            "nextDialogs": [
              "401160712"
            ]
          },
          "401160712": {
            "id": "401160712",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "都是些「不知道写了什么」、「莫名其妙」之类的感想，也可能是因为我使用「先成图」的方式违背了她的初衷。",
            "nextDialogs": [
              "401160713"
            ]
          },
          "401160713": {
            "id": "401160713",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "不过，伊迪娅固然批评了我，却也帮了我很多。她…有点像是剧场的经纪人吧？",
            "nextDialogs": [
              "401160714"
            ]
          },
          "401160714": {
            "id": "401160714",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "我很感激她。因为直到进入这里，我才有机会成为真正的「导演」。",
            "nextDialogs": [
              "401160715"
            ]
          },
          "401160715": {
            "id": "401160715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在那之前呢？",
            "nextDialogs": [
              "401160716"
            ]
          },
          "401160716": {
            "id": "401160716",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "梦想的话，倒是从小就有了。",
            "nextDialogs": [
              "401160717"
            ]
          },
          "401160717": {
            "id": "401160717",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "每次看完演出回到家，心中就会一遍一遍重复那个故事，久而久之，也萌生了自己的愿望。",
            "nextDialogs": [
              "401160718"
            ]
          },
          "401160718": {
            "id": "401160718",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "可惜我就只有动手能力比较强…所以，后来大多数时间都是在当道具师，外加从事舞台布景的工作。",
            "nextDialogs": [
              "401160719"
            ]
          },
          "401160719": {
            "id": "401160719",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "亲手做出舞台是很兴奋，但自己编排演出才最让人满足…",
            "nextDialogs": [
              "401160720"
            ]
          },
          "401160720": {
            "id": "401160720",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难怪你在告示牌上只留下了「导演」这个称呼呢。",
            "nextDialogs": [
              "401160721"
            ]
          },
          "401160721": {
            "id": "401160721",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "哈哈…你恐怕还是会读心的吧？",
            "nextDialogs": [
              "401160722"
            ]
          },
          "401160722": {
            "id": "401160722",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "对了，能再麻烦两位一件事吗？我找不到等下要用的总剧本了。",
            "nextDialogs": [
              "401160723"
            ]
          },
          "401160723": {
            "id": "401160723",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你不是刚写完吗？",
            "nextDialogs": [
              "401160724"
            ]
          },
          "401160724": {
            "id": "401160724",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "对，我刚刚把你们的部分发下去之后，带着我的总剧本到处检查…不知道丢在哪了。",
            "nextDialogs": [
              "401160728"
            ]
          },
          "401160728": {
            "id": "401160728",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "不过，呃，舞台还要再准备一下，实在有点抽不开身，能不能拜托两位…",
            "nextDialogs": [
              "401160725"
            ]
          },
          "401160725": {
            "id": "401160725",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "如果不在这里的话，可能就在阁楼里吧，写完台本后，我就去过这两个地方。",
            "nextDialogs": [
              "401160726"
            ]
          },
          "401160726": {
            "id": "401160726",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好吧。",
            "nextDialogs": [
              "401160727"
            ]
          },
          "401160727": {
            "id": "401160727",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们去去就来。"
          }
        }
      }
    },
    {
      "subId": "4011608",

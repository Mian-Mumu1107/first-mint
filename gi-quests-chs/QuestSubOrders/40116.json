    {
      "subId": "4011609",
      "subQuestName": "寻找总剧本",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401160901"
        ],
        "dialogs": {
          "401160901": {
            "id": "401160901",
            "speakerId": 13246,
            "speakerName": "水形幻灵",
            "text": "咕！",
            "nextDialogs": [
              "401160902"
            ]
          },
          "401160902": {
            "id": "401160902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，这里有好几份剧本。",
            "nextDialogs": [
              "401160903"
            ]
          },
          "401160903": {
            "id": "401160903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是「小水珠」一直在管理导演先生写的剧本呀…",
            "nextDialogs": [
              "401160904"
            ]
          },
          "401160904": {
            "id": "401160904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，感觉大多数都只写了一半呢…",
            "nextDialogs": [
              "401160905"
            ]
          },
          "401160905": {
            "id": "401160905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "既然是演出的「总剧本」…",
            "nextDialogs": [
              "401160906"
            ]
          },
          "401160906": {
            "id": "401160906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一定得是完整的一份吧！先来看看厚度，再来看看结尾…",
            "nextDialogs": [
              "401160907"
            ]
          },
          "401160907": {
            "id": "401160907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么多剧本里，符合要求的居然就只有一份。而且这本看起来比较新，应该是刚写完的。",
            "nextDialogs": [
              "401160908"
            ]
          },
          "401160908": {
            "id": "401160908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们把它带给佐西摩斯先生吧！"
          }
        }
      }
    },
    {
      "subId": "4011611",
      "subQuestName": "与佐西摩斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401160801"
        ],
        "dialogs": {
          "401160801": {
            "id": "401160801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "佐西摩斯先生，我们把剧本带回来啦！",
            "nextDialogs": [
              "401160802"
            ]
          },
          "401160802": {
            "id": "401160802",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "谢谢，真是帮了大忙了，唉…时间仓促，舞台也没办法修复到最完好的情况，只能走一步看一步了。",
            "nextDialogs": [
              "401160803"
            ]
          },
          "401160803": {
            "id": "401160803",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "重要的不是舞台，而是演出，就算舞台出现了错误，只要演出能够继续进行就好…",
            "nextDialogs": [
              "401160804"
            ]
          },
          "401160804": {
            "id": "401160804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么你的声音那么没有底气？",
            "nextDialogs": [
              "401160805"
            ]
          },
          "401160805": {
            "id": "401160805",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "我想通了，演出本身就是意外！",
            "nextDialogs": [
              "401160806"
            ]
          },
          "401160806": {
            "id": "401160806",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "就算是同一场戏，每一次演出都会有细微的区别，那些区别才是让它有别于其他演出的特色所在！",
            "nextDialogs": [
              "401160809"
            ]
          },
          "401160809": {
            "id": "401160809",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "#唉…我最后还有一个请求。{NICKNAME}，你能进入「先成图」对吧。",
            "nextDialogs": [
              "401160810"
            ]
          },
          "401160810": {
            "id": "401160810",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "实不相瞒，我的舞台，其实就是用「先成图」做的…先用素材做出物件，再把它们变成「先成图」的一部分。",
            "nextDialogs": [
              "401160811"
            ]
          },
          "401160811": {
            "id": "401160811",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "本来，「先成图」是为了构建蜃境而用，像我这样把各种东西变成「先成图」有点本末倒置。",
            "nextDialogs": [
              "401160812"
            ]
          },
          "401160812": {
            "id": "401160812",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "但伊迪娅小姐说，如果这就是我想做的事，她也勉强接受…",
            "nextDialogs": [
              "401160813"
            ]
          },
          "401160813": {
            "id": "401160813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来违背初衷是这个意思，那你需要我们做什么呢？",
            "nextDialogs": [
              "401160814"
            ]
          },
          "401160814": {
            "id": "401160814",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "#我想请{NICKNAME}进入「先成图」的舞台，在演出中操作道具…"
          }
        }
      }
    },
    {
      "subId": "4011610",
      "subQuestName": "进行演出",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4011613",
      "subQuestName": "与演出完的众人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401161301"
        ],
        "dialogs": {
          "401161301": {
            "id": "401161301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样一来，演出应该算是顺利完成了吧。",
            "nextDialogs": [
              "401161302"
            ]
          },
          "401161302": {
            "id": "401161302",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#荣誉骑士{M#哥哥}{F#姐姐}！",
            "nextDialogs": [
              "401161303"
            ]
          },
          "401161303": {
            "id": "401161303",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "可莉刚刚表演得还不错吧，有没有火红大魔女的感觉呀！",
            "nextDialogs": [
              "401161304"
            ]
          },
          "401161304": {
            "id": "401161304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，小可莉穿着「魔女」的衣服呢！",
            "nextDialogs": [
              "401161305"
            ]
          },
          "401161305": {
            "id": "401161305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚才看到影子的时候就觉得宽宽的帽檐很可爱！",
            "nextDialogs": [
              "401161308"
            ]
          },
          "401161308": {
            "id": "401161308",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "可莉很喜欢！谢谢佐西摩斯哥哥！",
            "nextDialogs": [
              "401161309"
            ]
          },
          "401161309": {
            "id": "401161309",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "啊不对不对，应该是谢谢导演哥哥！",
            "nextDialogs": [
              "401161310"
            ]
          },
          "401161310": {
            "id": "401161310",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "导演哥哥…？！",
            "nextDialogs": [
              "401161311"
            ]
          },
          "401161311": {
            "id": "401161311",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "啊！第一次有人这样称呼我！谢谢你…谢谢你，亲爱的小魔女，我很开心！",
            "nextDialogs": [
              "401161312"
            ]
          },
          "401161312": {
            "id": "401161312",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "伊迪娅姐姐说，是你画了设计图纸，还做了衣服，她帮着修改以后可莉就能穿了，所以你很厉害！",
            "nextDialogs": [
              "401161313"
            ]
          },
          "401161313": {
            "id": "401161313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那确实很厉害哦！伊迪娅也很了不得！",
            "nextDialogs": [
              "401161314"
            ]
          },
          "401161314": {
            "id": "401161314",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "也没什么了不起啦…只是在那种「完蛋了，我要参加王子的舞会，可是身上没有漂亮衣服啊」的情况下用的小手段罢了。",
            "nextDialogs": [
              "401161315"
            ]
          },
          "401161315": {
            "id": "401161315",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "缝纫也是一门手艺，伊迪娅小姐比自己想的能干哦。",
            "nextDialogs": [
              "401161316"
            ]
          },
          "401161316": {
            "id": "401161316",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "真的？哎呀…那个，我、我先走开一下，你们先聊…",
            "nextDialogs": [
              "401161317"
            ]
          },
          "401161317": {
            "id": "401161317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "伊迪娅紧张又害羞地跑掉了…脸皮好薄呢…",
            "nextDialogs": [
              "401161318"
            ]
          },
          "401161318": {
            "id": "401161318",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "伊迪娅是个缺乏自信又有点敏感的人…她应该不会激动到躲起来哭吧？唔…有点担心…",
            "nextDialogs": [
              "401161319"
            ]
          },
          "401161319": {
            "id": "401161319",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "别担心，我去陪陪她就好了。各位，容我先告辞一会儿。",
            "nextDialogs": [
              "401161320"
            ]
          },
          "401161320": {
            "id": "401161320",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "对了，这次的演出怎么样，各位有什么评价吗？",
            "nextDialogs": [
              "401161321"
            ]
          },
          "401161321": {
            "id": "401161321",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦？开始了开始了，这个人！喂，你是真的想知道我们的感想吗？",
            "nextDialogs": [
              "401161322"
            ]
          },
          "401161322": {
            "id": "401161322",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "当然了！我可是带着充分的信心来问的！直说，请尽管直说，什么样的批评我都可以接受！",
            "nextDialogs": [
              "401161323"
            ]
          },
          "401161323": {
            "id": "401161323",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "既然如此…",
            "nextDialogs": [
              "401161324"
            ]
          },
          "401161324": {
            "id": "401161324",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我真的说了哦！刚开始的台词都还不错，可越到后面越普通…总觉得写这个的人已经没有好点子了。",
            "nextDialogs": [
              "401161325"
            ]
          },
          "401161325": {
            "id": "401161325",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "出场人物也有点莫名其妙，没看懂为什么要这样编排，才看出一点内涵，突然这段就切掉了！",
            "nextDialogs": [
              "401161326"
            ]
          },
          "401161326": {
            "id": "401161326",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "哦对对，说得好呀派蒙。应该说，为了致敬《千夜故事集》的结构导致叙事紊乱，忘了处理道具也是扣分项。",
            "nextDialogs": [
              "401161327"
            ]
          },
          "401161327": {
            "id": "401161327",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "伊迪娅姐姐不是走开了吗？",
            "nextDialogs": [
              "401161328"
            ]
          },
          "401161328": {
            "id": "401161328",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "听到重要的话题，我如潮汐一般去而复返了！",
            "nextDialogs": [
              "401161329"
            ]
          },
          "401161329": {
            "id": "401161329",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "特意赶来批评我可真是辛苦你了！",
            "nextDialogs": [
              "401161330"
            ]
          },
          "401161330": {
            "id": "401161330",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "嗯！不过故事有个好结局，只有这点，只有这点我很喜欢。",
            "nextDialogs": [
              "401161331"
            ]
          },
          "401161331": {
            "id": "401161331",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "伊迪娅小姐比派蒙还严格。",
            "nextDialogs": [
              "401161332"
            ]
          },
          "401161332": {
            "id": "401161332",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "…是吗？我觉得我说得还不够狠呢。",
            "nextDialogs": [
              "401161333"
            ]
          },
          "401161333": {
            "id": "401161333",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "伊迪娅小姐，请过来一下。",
            "nextDialogs": [
              "401161334"
            ]
          },
          "401161334": {
            "id": "401161334",
            "speakerId": 13247,
            "speakerName": "伊迪娅",
            "text": "啊好的！抱歉，失陪一会儿。你们接着骂，交给你了派蒙！",
            "nextDialogs": [
              "401161335"
            ]
          },
          "401161335": {
            "id": "401161335",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢！那、那我再提一个意见可以吗？",
            "nextDialogs": [
              "401161336"
            ]
          },
          "401161336": {
            "id": "401161336",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "说吧！当导演的肯定要经历这一环。",
            "nextDialogs": [
              "401161337"
            ]
          },
          "401161337": {
            "id": "401161337",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结尾还是有点问题的！剧中那个女孩想法好简单，那种情况下根本不应该说「我也不知道」吧？",
            "nextDialogs": [
              "401161338"
            ]
          },
          "401161338": {
            "id": "401161338",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们想啊，她的族人还在漂泊…只追求自己一个人的幸福也太奇怪了啦。"
          }
        }
      }
    },
    {
      "subId": "4011611",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401161101"
        ],
        "dialogs": {
          "401161101": {
            "id": "401161101",
            "speakerId": 13252,
            "speakerName": "佐西摩斯",
            "text": "荆棘板的机关，应该没有问题…灯光，还有收音器…"
          }
        }
      }
    },
    {
      "subId": "4011699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401169910"
        ],
        "dialogs": {
          "401169910": {
            "id": "401169910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…蜃境的剧场，真令人好奇。",
            "nextDialogs": [
              "401169911"
            ]
          },
          "401169911": {
            "id": "401169911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然大家都在准备，我们就先去看看它长什么样吧！"
          }
        }
      }
    }
  ]
}
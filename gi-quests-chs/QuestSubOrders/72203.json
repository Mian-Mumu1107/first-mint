          "722030501": {
            "id": "722030501",
            "speakerId": 20425,
            "speakerName": "音乃",
            "text": "哈哈，又被你发现了！",
            "nextDialogs": [
              "722030502"
            ]
          },
          "722030502": {
            "id": "722030502",
            "speakerId": 20425,
            "speakerName": "音乃",
            "text": "那个，虽然有点舍不得，不过…这次我是来告别的。金色的叔叔说我们要走了…",
            "nextDialogs": [
              "722030503"
            ]
          },
          "722030503": {
            "id": "722030503",
            "speakerId": 20425,
            "speakerName": "音乃",
            "text": "不过请不要担心，我要去的地方会有好多人和我一起玩的！真希望你也能来呀…但是金色的叔叔说，还不到时候呢…",
            "nextDialogs": [
              "722030504"
            ]
          },
          "722030504": {
            "id": "722030504",
            "speakerId": 20425,
            "speakerName": "音乃",
            "text": "不过没关系的，没关系的！我会等着你的。要是等不及了，我就会变成点点的光，落进你的梦里找你！",
            "nextDialogs": [
              "722030505"
            ]
          },
          "722030505": {
            "id": "722030505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一路走好。",
            "nextDialogs": [
              "722030506"
            ]
          },
          "722030506": {
            "id": "722030506",
            "speakerId": 20425,
            "speakerName": "音乃",
            "text": "嗯，我会的。和你一起玩很开心，谢谢你。",
            "nextDialogs": [
              "722030507"
            ]
          },
          "722030507": {
            "id": "722030507",
            "speakerId": 20425,
            "speakerName": "音乃",
            "text": "再也不会孤单一个人了，真好呀…"
          }
        }

  "subQuests": [
    {
      "subId": "7333801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733380101"
        ],
        "dialogs": {
          "733380101": {
            "id": "733380101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你好！陌生的朋友！你是路过这里的旅人吗？",
            "nextDialogs": [
              "733380102"
            ]
          },
          "733380102": {
            "id": "733380102",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "抱歉半途拦下你…但…呃，这里发生过什么事…你能告诉我吗？",
            "nextDialogs": [
              "733380103"
            ]
          },
          "733380103": {
            "id": "733380103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我叫{NICKNAME}，幸会。",
            "nextDialogs": [
              "733380104"
            ]
          },
          "733380104": {
            "id": "733380104",
            "speakerId": 4437,
            "speakerName": "坦吉",
            "text": "因论派陀裟多，坦吉。我是来…嗯，对，塔尼特部族…支援教育工作的。",
            "nextDialogs": [
              "733380105"
            ]
          },
          "733380105": {
            "id": "733380105",
            "speakerId": 4437,
            "speakerName": "坦吉",
            "text": "真是奇怪，按说就是这里才对…但为什么会变成这样…",
            "nextDialogs": [
              "733380107",
              "733380109"
            ]
          },
          "733380107": {
            "id": "733380107",
            "speakerId": 4437,
            "speakerName": "坦吉",
            "text": "部落争斗或者内讧，嗯？有意思，沙漠里几百年没有发生过能毁灭一整个部落的冲突了…",
            "nextDialogs": [
              "733380110"
            ]
          },
          "733380110": {
            "id": "733380110",
            "speakerId": 4437,
            "speakerName": "坦吉",
            "text": "而且…我也发现了不祥的痕迹…咳咳，我建议你还是不要去看比较好。呃…对肠胃不太好。",
            "nextDialogs": [
              "733380111"
            ]
          },
          "733380111": {
            "id": "733380111",
            "speakerId": 4437,
            "speakerName": "坦吉",
            "text": "或许是他们中有的幸存者回来，归拢了大部分…遗留下来的东西。我不确定…太让人不安了。",
            "nextDialogs": [
              "733380112"
            ]
          },
          "733380112": {
            "id": "733380112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "733380113"
            ]
          },
          "733380113": {
            "id": "733380113",
            "speakerId": 4437,
            "speakerName": "坦吉",
            "text": "唉…怎么会撞上这种事。感觉就像…见证了一次历史事件。",
            "nextDialogs": [
              "733380114"
            ]
          },
          "733380114": {
            "id": "733380114",
            "speakerId": 4437,
            "speakerName": "坦吉",
            "text": "啊，对了，顺便…呃，你要打牌吗？",
            "nextDialogs": [
              "733380115"
            ]
          },
          "733380115": {
            "id": "733380115",
            "speakerId": 4437,
            "speakerName": "坦吉",
            "text": "我从那些帐篷里找到了几幅牌组，稍加清理还是挺干净的。如果你有兴趣的话，我们或许可以…？"
          },
          "733380109": {
            "id": "733380109",
            "speakerId": 4437,
            "speakerName": "坦吉",
            "text": "迁徙？不…你看，货物和帐篷都还在原处。柴灰和居所还有生活过的痕迹…哼，更像是一场突然的大灾难，中断了所有人的生活…"
          }
        }
      }
    },

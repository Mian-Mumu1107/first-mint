    {
      "subId": "200104",
      "subQuestName": "再次与珠函交谈并参赛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20010401"
        ],
        "dialogs": {
          "20010401": {
            "id": "20010401",
            "speakerId": 1003,
            "speakerName": "珠函",
            "text": "你的半决赛对手，名不见经传，却是一匹黑马。",
            "nextDialogs": [
              "20010402"
            ]
          },
          "20010402": {
            "id": "20010402",
            "speakerId": 1003,
            "speakerName": "珠函",
            "text": "我没有在质疑大英雄的实力，只是希望你能做好万全的准备。",
            "nextDialogs": [
              "20010403"
            ]
          },
          "20010403": {
            "id": "20010403",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#这种水平的对决，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}没可能输的啦。",
            "nextDialogs": [
              "20010405",
              "20010407"
            ]
          },
          "20010405": {
            "id": "20010405",
            "speakerId": 1003,
            "speakerName": "珠函",
            "text": "好的，那我们进场吧。"
          },
          "20010407": {
            "id": "20010407",
            "speakerId": 1003,
            "speakerName": "珠函",
            "text": "没关系，调整好心态吧。"
          }
        }
      }
    },
    {
      "subId": "200105",
      "subQuestName": "在半决赛中获胜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "200106",
      "subQuestName": "与戎世交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20010601"
        ],
        "dialogs": {
          "20010601": {
            "id": "20010601",
            "speakerId": 1004,
            "speakerName": "戎世",
            "text": "出了很多汗，很不错。",
            "nextDialogs": [
              "20010602"
            ]
          },
          "20010602": {
            "id": "20010602",
            "speakerId": 1004,
            "speakerName": "戎世",
            "text": "我承认，是你要更胜一筹，我还需要锻炼。",
            "nextDialogs": [
              "20010605"
            ]
          },
          "20010605": {
            "id": "20010605",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "是啊，刚刚真的好险…",
            "nextDialogs": [
              "20010606"
            ]
          },
          "20010606": {
            "id": "20010606",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "如果你拥有神之眼的话，一定会特别厉害吧。",
            "nextDialogs": [
              "20010607"
            ]
          },
          "20010607": {
            "id": "20010607",
            "speakerId": 1004,
            "speakerName": "戎世",
            "text": "小时候，我也想要神之眼，他们说只要够强，就有机会。",
            "nextDialogs": [
              "20010608"
            ]
          },
          "20010608": {
            "id": "20010608",
            "speakerId": 1004,
            "speakerName": "戎世",
            "text": "但是，拿不到。",
            "nextDialogs": [
              "20010609"
            ]
          },
          "20010609": {
            "id": "20010609",
            "speakerId": 1004,
            "speakerName": "戎世",
            "text": "后来，我就没兴趣了，神之眼没有肌肉来得实在。",
            "nextDialogs": [
              "20010610"
            ]
          },
          "20010610": {
            "id": "20010610",
            "speakerId": 1004,
            "speakerName": "戎世",
            "text": "我也打赢过拿神之眼的人。那种力量，是神给的，我不羡慕。",
            "nextDialogs": [
              "20010611"
            ]
          },
          "20010611": {
            "id": "20010611",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦？那你不是冲着那个没有主人的神之眼来的吗？",
            "nextDialogs": [
              "20010612"
            ]
          },
          "20010612": {
            "id": "20010612",
            "speakerId": 1004,
            "speakerName": "戎世",
            "text": "不，我只是想比武，比比看，是谁更强。",
            "nextDialogs": [
              "20010613"
            ]
          },
          "20010613": {
            "id": "20010613",
            "speakerId": 1004,
            "speakerName": "戎世",
            "text": "只有败北，才能感悟差距，才有机会成长。所以我很高兴，败北是很难得的事。",
            "nextDialogs": [
              "20010614"
            ]
          },
          "20010614": {
            "id": "20010614",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这才像真正有实力的人说出来的话。",
            "nextDialogs": [
              "20010615"
            ]
          },
          "20010615": {
            "id": "20010615",
            "speakerId": 1004,
            "speakerName": "戎世",
            "text": "以后有机会，再来比武吧，我会继续成长的。",
            "nextDialogs": [
              "20010616"
            ]
          },
          "20010616": {
            "id": "20010616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也一样。",
            "nextDialogs": [
              "20010617"
            ]
          },
          "20010617": {
            "id": "20010617",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对了，你知道谁会参加决赛吗？那个人是不是比你还厉害？",
            "nextDialogs": [
              "20010618"
            ]
          },
          "20010618": {
            "id": "20010618",
            "speakerId": 1004,
            "speakerName": "戎世",
            "text": "有没有我厉害，我不知道，但我听说，他很「快」。",
            "nextDialogs": [
              "20010619"
            ]
          },
          "20010619": {
            "id": "20010619",
            "speakerId": 1004,
            "speakerName": "戎世",
            "text": "不要掉以轻心。"
          }
        }
      }
    },
    {
      "subId": "200107",
      "subQuestName": "打听决赛对手的信息",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20010701"
        ],
        "dialogs": {
          "20010701": {
            "id": "20010701",
            "speakerId": 1005,
            "speakerName": "云叔",
            "text": "是你啊，哈哈哈，我看到你的比赛了，打得非常精彩啊！",
            "nextDialogs": [
              "20010702"
            ]
          },
          "20010702": {
            "id": "20010702",
            "speakerId": 1005,
            "speakerName": "云叔",
            "text": "我第三轮就被淘汰了，唉，可惜了，要是能再坚持一轮就好了…",
            "nextDialogs": [
              "20010703"
            ]
          },
          "20010703": {
            "id": "20010703",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你知道是谁最后进了决赛吗？",
            "nextDialogs": [
              "20010704"
            ]
          },
          "20010704": {
            "id": "20010704",
            "speakerId": 1005,
            "speakerName": "云叔",
            "text": "就是当时淘汰我的那个人啊，他挺厉害的，身手敏捷，知道怎么抓人破绽。",
            "nextDialogs": [
              "20010705"
            ]
          },
          "20010705": {
            "id": "20010705",
            "speakerId": 1005,
            "speakerName": "云叔",
            "text": "我只是失误了一下，就被放倒在地了。",
            "nextDialogs": [
              "20010706"
            ]
          },
          "20010706": {
            "id": "20010706",
            "speakerId": 1005,
            "speakerName": "云叔",
            "text": "我这个体格，要和我拼力气我不会怕，但要比灵敏，我可就没什么办法了…",
            "nextDialogs": [
              "20010707"
            ]
          },
          "20010707": {
            "id": "20010707",
            "speakerId": 1005,
            "speakerName": "云叔",
            "text": "但我觉得，他还是跟你差远了，哈哈哈！"
          }
        }
      }
    },
    {
      "subId": "200108",
      "subQuestName": "继续打听决赛对手的信息",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20010801"
        ],
        "dialogs": {
          "20010801": {
            "id": "20010801",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦，你的师兄呢？",
            "nextDialogs": [
              "20010802"
            ]
          },
          "20010802": {
            "id": "20010802",
            "speakerId": 1006,
            "speakerName": "良子",
            "text": "他想用化劲硬接拳头，结果被正中鼻梁，当场就出了很多血。",
            "nextDialogs": [
              "20010803"
            ]
          },
          "20010803": {
            "id": "20010803",
            "speakerId": 1006,
            "speakerName": "良子",
            "text": "对方也慌了，一直在问他为什么不闪，但他已经踉踉跄跄，话都说不出来了。",
            "nextDialogs": [
              "20010804"
            ]
          },
          "20010804": {
            "id": "20010804",
            "speakerId": 1006,
            "speakerName": "良子",
            "text": "为什么不闪…这就是「灵山派」的功夫啊，只是没练好罢了。",
            "nextDialogs": [
              "20010805"
            ]
          },
          "20010805": {
            "id": "20010805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的比试怎么样？",
            "nextDialogs": [
              "20010806"
            ]
          },
          "20010806": {
            "id": "20010806",
            "speakerId": 1006,
            "speakerName": "良子",
            "text": "别说了，师兄受伤之后我费了好大的力气扶他上了回港的船，回来的时候，我的轮次已经过了…",
            "nextDialogs": [
              "20010807"
            ]
          },
          "20010807": {
            "id": "20010807",
            "speakerId": 1006,
            "speakerName": "良子",
            "text": "这件事我也不敢告诉师父，不然肯定又是一顿臭骂。",
            "nextDialogs": [
              "20010808"
            ]
          },
          "20010808": {
            "id": "20010808",
            "speakerId": 1006,
            "speakerName": "良子",
            "text": "不好意思，不该在你们面前抱怨的。但因为我忙得晕头转向的，你们想问什么，我应该也帮不上忙。",
            "nextDialogs": [
              "20010809"
            ]
          },
          "20010809": {
            "id": "20010809",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那，好吧…希望你的师兄平安无事，你也要振作起来！",
            "nextDialogs": [
              "20010810"
            ]
          },
          "20010810": {
            "id": "20010810",
            "speakerId": 1006,
            "speakerName": "良子",
            "text": "嗯，谢谢…"
          }
        }
      }
    },
    {
      "subId": "200109",
      "subQuestName": "向北斗和万叶打听",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20010901"
        ],
        "dialogs": {
          "20010901": {
            "id": "20010901",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "精彩绝伦，实在值得盛赞。",
            "nextDialogs": [
              "20010902"
            ]
          },
          "20010902": {
            "id": "20010902",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "我能感觉到你有点不习惯，这也一度让战斗陷入困局。",
            "nextDialogs": [
              "20010903"
            ]
          },
          "20010903": {
            "id": "20010903",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "但你迅速调整了态势，取得了对决的胜利，这才是最难能可贵的实力。",
            "nextDialogs": [
              "20010906"
            ]
          },
          "20010906": {
            "id": "20010906",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "其实，是听出来的，有沙石和呼吸的声音。不过，不是什么值得一提的事，这种程度，大姐头也能看得出来。",
            "nextDialogs": [
              "20010907"
            ]
          },
          "20010907": {
            "id": "20010907",
            "speakerId": 1000,
            "speakerName": "北斗",
            "text": "哈哈哈，的确是这样，不过我就是单纯靠经验了。",
            "nextDialogs": [
              "20010908"
            ]
          },
          "20010908": {
            "id": "20010908",
            "speakerId": 1000,
            "speakerName": "北斗",
            "text": "对你来说，这也是非常新鲜的体验，对吧？"
          }
        }
      }
    },
    {
      "subId": "200110",
      "subQuestName": "随万叶前往静处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "200111",
      "subQuestName": "与万叶交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20011101"
        ],
        "dialogs": {
          "20011101": {
            "id": "20011101",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "此处四下无人，我就开门见山问了——",
            "nextDialogs": [
              "20011102"
            ]
          },
          "20011102": {
            "id": "20011102",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "其实你能够很熟练地运用元素力，而且，不止一种，对吧？",
            "nextDialogs": [
              "20011105"
            ]
          },
          "20011105": {
            "id": "20011105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔，从见面开始，你好像就话里有话，原来早就察觉到了啊。",
            "nextDialogs": [
              "20011106"
            ]
          },
          "20011106": {
            "id": "20011106",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "嗯，不在会场提及，是考虑到如果被其他参赛者知道了你会使用元素力，会招来不必要的误解。",
            "nextDialogs": [
              "20011107"
            ]
          },
          "20011107": {
            "id": "20011107",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "就算在比赛中战至险境，你也没有使用元素力，也是出于相同的考虑吧。",
            "nextDialogs": [
              "20011108"
            ]
          },
          "20011108": {
            "id": "20011108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但你是怎么知道的？",
            "nextDialogs": [
              "20011109"
            ]
          },
          "20011109": {
            "id": "20011109",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "呵呵，我所言之「见」与「闻」，并不只是出于诗性，而是确有其事。",
            "nextDialogs": [
              "20011110"
            ]
          },
          "20011110": {
            "id": "20011110",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "我很小的时候就能够理解大自然的信息，我能听到风的呼吸，树叶的低语…",
            "nextDialogs": [
              "20011111"
            ]
          },
          "20011111": {
            "id": "20011111",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "从你的身上听到了相似的东西，仅此而已。",
            "nextDialogs": [
              "20011112"
            ]
          },
          "20011112": {
            "id": "20011112",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "虽然难以置信，但感觉不像是在说谎呢。",
            "nextDialogs": [
              "20011113"
            ]
          },
          "20011113": {
            "id": "20011113",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "和你们的难以置信相比，我的这点能力简直微不足道。",
            "nextDialogs": [
              "20011114"
            ]
          },
          "20011114": {
            "id": "20011114",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "不依靠神之眼，就可以驱动多种元素力的人类…",
            "nextDialogs": [
              "20011115"
            ]
          },
          "20011115": {
            "id": "20011115",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "还有味道无比复杂，不知来自何方的神秘生物…",
            "nextDialogs": [
              "20011116"
            ]
          },
          "20011116": {
            "id": "20011116",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不要用「味道」来评价我啊！",
            "nextDialogs": [
              "20011117"
            ]
          },
          "20011117": {
            "id": "20011117",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "关于这种复合的元素力是如何获得的，可以讲给我听听吗？"
          }
        }
      }
    },
    {
      "subId": "200112",
      "subQuestName": "击败魔物，向万叶展示元素力",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "200113",
      "subQuestName": "与万叶交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20011301"
        ],
        "dialogs": {
          "20011301": {
            "id": "20011301",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "嗯，你的战斗能力着实无可挑剔，就算你的决赛对手灵动迅捷，应该也无法从你这里讨到便宜。",
            "nextDialogs": [
              "20011302"
            ]
          },
          "20011302": {
            "id": "20011302",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "闯入决赛的那位参赛者，他非常擅长调整呼吸，保持平衡，能做出常人难以完成的动作。",
            "nextDialogs": [
              "20011303"
            ]
          },
          "20011303": {
            "id": "20011303",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "他的胜利，几乎都是靠「奇袭」获取的。",
            "nextDialogs": [
              "20011304"
            ]
          },
          "20011304": {
            "id": "20011304",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "但换言之，只要格外留心他利用破绽的本领，他的攻击就不构成威胁了。",
            "nextDialogs": [
              "20011305"
            ]
          },
          "20011305": {
            "id": "20011305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢你，不会轻敌的。",
            "nextDialogs": [
              "20011306"
            ]
          },
          "20011306": {
            "id": "20011306",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "不必道谢，见识到了违背常理的元素力运用方式，应该道谢的是我才对。",
            "nextDialogs": [
              "20011307"
            ]
          },
          "20011307": {
            "id": "20011307",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "果然，这个世界是如此神秘，总会有完全未知的情况出现。",
            "nextDialogs": [
              "20011308"
            ]
          },
          "20011308": {
            "id": "20011308",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "感觉你对神之眼有某种执着…但你不是已经有了吗？感觉不需要深究元素力和神之眼的关系了吧。",
            "nextDialogs": [
              "20011309"
            ]
          },
          "20011309": {
            "id": "20011309",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "我想知道的是，神之眼对于神明来说，意味着什么。",
            "nextDialogs": [
              "20011310"
            ]
          },
          "20011310": {
            "id": "20011310",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "又是什么，让神明做出赐下神之眼的决定？",
            "nextDialogs": [
              "20011311"
            ]
          },
          "20011311": {
            "id": "20011311",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "抱歉，对你们来说应该是不知所谓的事。",
            "nextDialogs": [
              "20011312"
            ]
          },
          "20011312": {
            "id": "20011312",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "既然让我有幸见识到你们的神奇之处，作为报答，你们对稻妻有什么疑问，我会向你们解答。",
            "nextDialogs": [
              "20011313"
            ]
          },
          "20011313": {
            "id": "20011313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想知道「不知所谓」的事。",
            "nextDialogs": [
              "20011314"
            ]
          },
          "20011314": {
            "id": "20011314",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "居然是好奇这个吗？呵呵，那我再讲明白一点吧。",
            "nextDialogs": [
              "20011315"
            ]
          },
          "20011315": {
            "id": "20011315",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "你们也知道，稻妻正在施行「眼狩令」。",
            "nextDialogs": [
              "20011316"
            ]
          },
          "20011316": {
            "id": "20011316",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "神之眼本就是来自神明的馈赠。人们接受了这份礼物，现在却又要莫名其妙地被收缴，有时还会引来杀身之祸。",
            "nextDialogs": [
              "20011317"
            ]
          },
          "20011317": {
            "id": "20011317",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "如果当初七神心中各有标尺，将神之眼赐予众生，那如今的雷之神，是对这个行为产生了怀疑吗？",
            "nextDialogs": [
              "20011318"
            ]
          },
          "20011318": {
            "id": "20011318",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "许久都没有新的雷元素神之眼出现，或许也昭示了雷电将军的态度吧。",
            "nextDialogs": [
              "20011319"
            ]
          },
          "20011319": {
            "id": "20011319",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "她听起来是一位很…霸道的神？",
            "nextDialogs": [
              "20011320"
            ]
          },
          "20011320": {
            "id": "20011320",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "据我了解，她是执着于追求「永恒」的神，会将自己的想法冷酷无情地贯彻。",
            "nextDialogs": [
              "20011321"
            ]
          },
          "20011321": {
            "id": "20011321",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "但璃月的「契约」，是为了璃月众生，而稻妻如今的「永恒」，又给民众带来了什么呢？",
            "nextDialogs": [
              "20011322"
            ]
          },
          "20011322": {
            "id": "20011322",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "——至少，被困于重锁之中的稻妻人民，现在过得并不算好吧。",
            "nextDialogs": [
              "20011323"
            ]
          },
          "20011323": {
            "id": "20011323",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "听起来，很像是你们当初遇到的那个神会干出来的事。",
            "nextDialogs": [
              "20011324"
            ]
          },
          "20011324": {
            "id": "20011324",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "嗯？你们以前见过雷神？",
            "nextDialogs": [
              "20011327"
            ]
          },
          "20011327": {
            "id": "20011327",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "被时间改变的只有可能是我们，绝不会是将军大人。",
            "nextDialogs": [
              "20011328"
            ]
          },
          "20011328": {
            "id": "20011328",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "如果你要找她，那她便永远在那里。",
            "nextDialogs": [
              "20011329"
            ]
          },
          "20011329": {
            "id": "20011329",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "总有一天，我也要从她那里获得「永恒」的答案。",
            "nextDialogs": [
              "20011330"
            ]
          },
          "20011330": {
            "id": "20011330",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "好了，时间也差不多了，决赛应该要开始了。",
            "nextDialogs": [
              "20011331"
            ]
          },
          "20011331": {
            "id": "20011331",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对哦，聊了好多稻妻的事，都忘记还有比赛了。",
            "nextDialogs": [
              "20011332"
            ]
          },
          "20011332": {
            "id": "20011332",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "如果没有其他事要做，我们就一起回去吧。"
          }
        }
      }
    },
    {
      "subId": "200122",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20012201"
        ],
        "dialogs": {
          "20012201": {
            "id": "20012201",
            "speakerId": 1000,
            "speakerName": "北斗",
            "text": "从你到来开始，万叶就特别关注你。",
            "nextDialogs": [
              "20012202"
            ]
          },
          "20012202": {
            "id": "20012202",
            "speakerId": 1000,
            "speakerName": "北斗",
            "text": "有什么好奇的问题，你也可以趁机问清楚。"
          }
        }
      }
    },
    {
      "subId": "200123",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20012301"
        ],
        "dialogs": {
          "20012301": {
            "id": "20012301",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "不依靠神之眼也能使用元素力，那么…",
            "nextDialogs": [
              "20012302"
            ]
          },
          "20012302": {
            "id": "20012302",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "不用在意我，自言自语而已，你的挑战，我会认真旁观的。"
          }
        }
      }
    },
    {
      "subId": "200199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20019906"
        ],
        "dialogs": {
          "20019906": {
            "id": "20019906",
            "speakerId": 1000,
            "speakerName": "北斗",
            "text": "终于，我们迎来了万众期待的半决赛！",
            "nextDialogs": [
              "20019907"
            ]
          },
          "20019907": {
            "id": "20019907",
            "speakerId": 1000,
            "speakerName": "北斗",
            "text": "英雄和黑马，究竟谁能更胜一筹呢？",
            "nextDialogs": [
              "20019908"
            ]
          },
          "20019908": {
            "id": "20019908",
            "speakerId": 1000,
            "speakerName": "北斗",
            "text": "胜利者，距离优胜奖品，就只差一步了！",
            "nextDialogs": [
              "20019909"
            ]
          },
          "20019909": {
            "id": "20019909",
            "speakerId": 1004,
            "speakerName": "戎世",
            "text": "奖品，没兴趣…",
            "nextDialogs": [
              "20019910"
            ]
          },
          "20019910": {
            "id": "20019910",
            "speakerId": 1004,
            "speakerName": "戎世",
            "text": "不过，你很强，这就够了。"
          }
        }
      }
    },
    {
      "subId": "4111510",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411151001"
        ],
        "dialogs": {
          "411151001": {
            "id": "411151001",
            "speakerId": 1007,
            "speakerName": "乔伊斯",
            "text": "请务必注意安全，不要用手直接触碰陨石。"
          }
        }
      }
    },
    {
      "subId": "4111511",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411151101"
        ],
        "dialogs": {
          "411151101": {
            "id": "411151101",
            "speakerId": 1008,
            "speakerName": "阿德勒",
            "text": "注意距离，闲杂人等不要靠近陨石落点。"
          }

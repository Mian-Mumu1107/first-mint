  "subQuests": [
    {
      "subId": "7302201",
      "subQuestName": "寻找兰非拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730220101"
        ],
        "dialogs": {
          "730220101": {
            "id": "730220101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好呀！",
            "nextDialogs": [
              "730220102"
            ]
          },
          "730220102": {
            "id": "730220102",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "呼呼——呼呼——",
            "nextDialogs": [
              "730220103"
            ]
          },
          "730220103": {
            "id": "730220103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂！你好——！",
            "nextDialogs": [
              "730220104"
            ]
          },
          "730220104": {
            "id": "730220104",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "唔嗯。好果子。呼呼——",
            "nextDialogs": [
              "730220105"
            ]
          },
          "730220105": {
            "id": "730220105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可恶，睡得好沉。唔…对了，兰帕卡提说过，用<color=#00E1FFFF>草元素的力量</color>，应该可以让他恢复正常。",
            "nextDialogs": [
              "730220106"
            ]
          },
          "730220106": {
            "id": "730220106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，就交给你了。"
          }
        }
      }
    },
    {
      "subId": "7302202",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730220201"
        ],
        "dialogs": {
          "730220201": {
            "id": "730220201",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "嗯？是你啊。好久不见了。",
            "nextDialogs": [
              "730220202"
            ]
          },
          "730220202": {
            "id": "730220202",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "哎呀，这里是哪里，是什么山洞里吗…唔，感觉有点晕晕的。",
            "nextDialogs": [
              "730220203"
            ]
          },
          "730220203": {
            "id": "730220203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你是谁，你怎么睡在这里啊…",
            "nextDialogs": [
              "730220204"
            ]
          },
          "730220204": {
            "id": "730220204",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "我是谁…唔，头晕乎乎的，让我想想…我的名字…",
            "nextDialogs": [
              "730220205"
            ]
          },
          "730220205": {
            "id": "730220205",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "我的名字是兰非拉，嘿嘿，我想起来了…",
            "nextDialogs": [
              "730220206"
            ]
          },
          "730220206": {
            "id": "730220206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来你就是兰非拉呀！我们还说你跑到哪里去了，原来躲在这个山洞里睡觉呢。",
            "nextDialogs": [
              "730220207"
            ]
          },
          "730220207": {
            "id": "730220207",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "兰非拉…你们居然知道我的名字…",
            "nextDialogs": [
              "730220208"
            ]
          },
          "730220208": {
            "id": "730220208",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "咦，是那菈！？",
            "nextDialogs": [
              "730220209"
            ]
          },
          "730220209": {
            "id": "730220209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "完全醒过来了。",
            "nextDialogs": [
              "730220210"
            ]
          },
          "730220210": {
            "id": "730220210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "完全醒过来了呢。",
            "nextDialogs": [
              "730220211"
            ]
          },
          "730220211": {
            "id": "730220211",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "呜呜，我还没有准备好，不要把我煮成粥…",
            "nextDialogs": [
              "730220212"
            ]
          },
          "730220212": {
            "id": "730220212",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊？怎么会有人想要把你煮成粥？！",
            "nextDialogs": [
              "730220213"
            ]
          },
          "730220213": {
            "id": "730220213",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "妹、妹妹说过，如果我老是迷迷糊糊，就会被坏那菈抓走，煮成杂烩粥…",
            "nextDialogs": [
              "730220215"
            ]
          },
          "730220215": {
            "id": "730220215",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "呜哇啊啊啊！",
            "nextDialogs": [
              "730220216"
            ]
          },
          "730220216": {
            "id": "730220216",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#喂！{NICKNAME}，不要开这种玩笑！兰非拉，没有人会把你煮成粥的啦！",
            "nextDialogs": [
              "730220218"
            ]
          },
          "730220218": {
            "id": "730220218",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "…真的？",
            "nextDialogs": [
              "730220219"
            ]
          },
          "730220219": {
            "id": "730220219",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真的！",
            "nextDialogs": [
              "730220220"
            ]
          },
          "730220220": {
            "id": "730220220",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "真的是真的？",
            "nextDialogs": [
              "730220221"
            ]
          },
          "730220221": {
            "id": "730220221",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#不骗你啦。我叫派蒙，这位高高的那菈是{NICKNAME}。是兰帕卡提叫我们来找你的…",
            "nextDialogs": [
              "730220222"
            ]
          },
          "730220222": {
            "id": "730220222",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "兰帕卡提？她还好吗？我在这里呆了多久…",
            "nextDialogs": [
              "730220223"
            ]
          },
          "730220223": {
            "id": "730220223",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "多久来着？我记得好像是说…",
            "nextDialogs": [
              "730220224"
            ]
          },
          "730220224": {
            "id": "730220224",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我想想…很多很多个月亮以前，幼苗钻出土，长成了大树，有多少个兰帕卡提高来着…？"
          }
        }
      }
    },
    {
      "subId": "7302205",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730220501"
        ],
        "dialogs": {
          "730220501": {
            "id": "730220501",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "呼呼——呼呼——",
            "nextDialogs": [
              "730220502"
            ]
          },
          "730220502": {
            "id": "730220502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "兰非拉！",
            "nextDialogs": [
              "730220503"
            ]
          },
          "730220503": {
            "id": "730220503",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "嗯？原来是派蒙啊。",
            "nextDialogs": [
              "730220504"
            ]
          },
          "730220504": {
            "id": "730220504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#对啊，我们是来告诉你，外面的「大怪物」，{NICKNAME}已经处理掉啦！",
            "nextDialogs": [
              "730220505"
            ]
          },
          "730220505": {
            "id": "730220505",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "#哦哦。没想到，看上去没有大怪物大的那菈{NICKNAME}，居然有这样的力量。好强。",
            "nextDialogs": [
              "730220508"
            ]
          },
          "730220508": {
            "id": "730220508",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "嗯。那我们出发吧。好那菈，我们一起吃果实。"
          }
        }
      }
    },
    {
      "subId": "7302206",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730220601"
        ],
        "dialogs": {
          "730220601": {
            "id": "730220601",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "唔…这就开始用「鲜嫩无朋之果」来做料理吧。",
            "nextDialogs": [
              "730220602"
            ]
          },
          "730220602": {
            "id": "730220602",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个「鲜嫩无朋之果」，到底和普通的果子有什么区别呢…",
            "nextDialogs": [
              "730220603"
            ]
          },
          "730220603": {
            "id": "730220603",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "我知道的。在那菈看来，果实都一样。但其实，是不同的。",
            "nextDialogs": [
              "730220604"
            ]
          },
          "730220604": {
            "id": "730220604",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "「鲜嫩无朋之果」，是强壮的树才能结出来的。强壮的树，当风吹来的时候，会率先唱歌。",
            "nextDialogs": [
              "730220605"
            ]
          },
          "730220605": {
            "id": "730220605",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "强壮的树生出的孩子，就是给我们的恩惠。也就是「鲜嫩无朋之果」。那菈朋友说，这种果子在肚子里就像会唱歌一样好吃。",
            "nextDialogs": [
              "730220606"
            ]
          },
          "730220606": {
            "id": "730220606",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好期待啊，用这个果子，能做出什么样的美味！",
            "nextDialogs": [
              "730220607"
            ]
          },
          "730220607": {
            "id": "730220607",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "兰非拉立刻进行了烹饪…\\n他将手中的果子分成数份…\\n随后，兰非拉将其中的几份交给你们品尝。",
            "nextDialogs": [
              "730220608"
            ]
          },
          "730220608": {
            "id": "730220608",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "一起品尝了新鲜的果实。\\n应该说是符合预期吧，确实是新鲜水果的滋味。",
            "nextDialogs": [
              "730220609"
            ]
          },
          "730220609": {
            "id": "730220609",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "真好。谢谢你，强壮的树。",
            "nextDialogs": [
              "730220610"
            ]
          },
          "730220610": {
            "id": "730220610",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "等等，这也算是烹饪吗？",
            "nextDialogs": [
              "730220611"
            ]
          },
          "730220611": {
            "id": "730220611",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "「鲜嫩无朋之果」自身就是最高级的「至上珍馐」，不需要任何加工，就有最完美的味道…",
            "nextDialogs": [
              "730220612"
            ]
          },
          "730220612": {
            "id": "730220612",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "多说无益，只要进行品尝就能够清楚了！",
            "nextDialogs": [
              "730220613"
            ]
          },
          "730220613": {
            "id": "730220613",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "虽然确实好吃，就像、就像在吃水果一样…",
            "nextDialogs": [
              "730220614"
            ]
          },
          "730220614": {
            "id": "730220614",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这本来就是水果啊。",
            "nextDialogs": [
              "730220615"
            ]
          },
          "730220615": {
            "id": "730220615",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "倒也没错…",
            "nextDialogs": [
              "730220616"
            ]
          },
          "730220616": {
            "id": "730220616",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "你们那菈不也有那种，只把果子切开，摆在盘子里，就放在木头平台上的菜肴嘛。",
            "nextDialogs": [
              "730220617"
            ]
          },
          "730220617": {
            "id": "730220617",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，有吗…等等，你说的是果盘吧！",
            "nextDialogs": [
              "730220618"
            ]
          },
          "730220618": {
            "id": "730220618",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "果盘算是菜吗？",
            "nextDialogs": [
              "730220620",
              "730220622"
            ]
          },
          "730220620": {
            "id": "730220620",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "总觉得把果盘当做菜有点奇怪…",
            "nextDialogs": [
              "730220623"
            ]
          },
          "730220623": {
            "id": "730220623",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "唔…不要拘泥于这样的形式嘛，寻找更好的食材，本身也是一种烹饪。",
            "nextDialogs": [
              "730220624"
            ]
          },
          "730220624": {
            "id": "730220624",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "寻找食材的过程中，就可以到森林的各个地方去，亲近森林，这才是「烹饪修行」的真义嘛。",
            "nextDialogs": [
              "730220625"
            ]
          },
          "730220625": {
            "id": "730220625",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是这样吗？",
            "nextDialogs": [
              "730220626"
            ]
          },
          "730220626": {
            "id": "730220626",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "就是这样吧。",
            "nextDialogs": [
              "730220627"
            ]
          },
          "730220627": {
            "id": "730220627",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "这下摘到了「鲜嫩无朋之果」，我也做出了「至上珍馐」，这次「烹饪修行」也结束了。",
            "nextDialogs": [
              "730220628"
            ]
          },
          "730220628": {
            "id": "730220628",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "就能正大光明回桓那兰那了。",
            "nextDialogs": [
              "730220629"
            ]
          },
          "730220629": {
            "id": "730220629",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "#唔…被大怪物堵在山洞里，要是没有那菈{NICKNAME}和派蒙，肯定会错过这次无忧节。",
            "nextDialogs": [
              "730220630"
            ]
          },
          "730220630": {
            "id": "730220630",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好啦，你也快点回桓那兰那吧！",
            "nextDialogs": [
              "730220631"
            ]
          },
          "730220631": {
            "id": "730220631",
            "speakerId": 1002,
            "speakerName": "兰非拉",
            "text": "确实确实…错过无忧节，一定会被妹妹训斥…想想就害怕。"
          },
          "730220622": {
            "id": "730220622",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "就是说呀，感觉都没有经过什么…工序，被叫做菜很奇怪。"
          }
        }
      }
    },

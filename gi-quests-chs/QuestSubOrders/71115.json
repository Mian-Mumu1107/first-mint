    {
      "subId": "7111516",
      "subQuestName": "探索秘库",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "622420101"
        ],
        "dialogs": {
          "622420101": {
            "id": "622420101",
            "speakerId": 1003,
            "speakerName": "古老的文本·其一",
            "text": "「…都说鱼的记性差，我都开始怀疑她到底是不是鱼了。那个什么『肆龙』的事情，一天到晚不厌其烦地跑来找我讲…」",
            "nextDialogs": [
              "622420102"
            ]
          },
          "622420102": {
            "id": "622420102",
            "speakerId": 1003,
            "speakerName": "古老的文本·其一",
            "text": "「…虽说每次都想直接打断她，但看她那副开心的样子，果然还是算了…倒不如说，她不来唠叨的时候，效率反而更低…」",
            "nextDialogs": [
              "622420103"
            ]
          },
          "622420103": {
            "id": "622420103",
            "speakerId": 1003,
            "speakerName": "古老的文本·其一",
            "text": "「…这个之后一定要锁起来。绝对不能让任何人或鱼看到。否则那家伙的尾鳍要翘到天上去了…」"
          }
        }
      }
    },

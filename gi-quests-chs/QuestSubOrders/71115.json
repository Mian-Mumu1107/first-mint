    {
      "subId": "7111517",
      "subQuestName": "将彩蝶驱赶至药罐中$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711151701"
        ],
        "dialogs": {
          "711151701": {
            "id": "711151701",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "嗯…？尔等何人？扰我…啊，是你们，好心的人类…",
            "nextDialogs": [
              "711151702"
            ]
          },
          "711151702": {
            "id": "711151702",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "蝴蝶…找不到吗？嗯…说不定，去那边看一看就好…",
            "nextDialogs": [
              "711151703"
            ]
          },
          "711151703": {
            "id": "711151703",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "那么，就拜托你们啦，我现在好困，所以…哈啊，请先让我睡一会儿.…",
            "nextDialogs": [
              "711151704"
            ]
          },
          "711151704": {
            "id": "711151704",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "呼…呼…"
          }
        }
      }
    },
    {
      "subId": "7111511",
      "subQuestName": "与仙像交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711151101"
        ],
        "dialogs": {
          "711151101": {
            "id": "711151101",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喂！你这个坏家伙，我们已经把彩蝶全部赶回罐子里了，仙树的样子还是没变嘛！",
            "nextDialogs": [
              "711151102"
            ]
          },
          "711151102": {
            "id": "711151102",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "嗯…？尔等何人？扰我…啊，是你们，好心的人类…",
            "nextDialogs": [
              "711151103"
            ]
          },
          "711151103": {
            "id": "711151103",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "哦哦！没想到你们还真把彩蝶都找到了！我就那么随便一说…",
            "nextDialogs": [
              "711151104"
            ]
          },
          "711151104": {
            "id": "711151104",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "不、不！我的意思是…我也感受到仙力的悸动了！接下来只要念诵药君大人留下的口诀，就可以让仙树重现生机啦！",
            "nextDialogs": [
              "711151105"
            ]
          },
          "711151105": {
            "id": "711151105",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "等等，口诀是什么来着，我想想…",
            "nextDialogs": [
              "711151106"
            ]
          },
          "711151106": {
            "id": "711151106",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "「…木生于冬，岁聿枯荣。我思逢春，又复芳雍…」",
            "nextDialogs": [
              "711151107"
            ]
          },
          "711151107": {
            "id": "711151107",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "…蝶彩翩翻…翩翻…后面的我忘了，总之最后是万象回从！"
          }
        }
      }
    },
    {
      "subId": "7111512",
      "subQuestName": "与仙像交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711151201"
        ],
        "dialogs": {
          "711151201": {
            "id": "711151201",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇！突、突然完全变了一副样子…！",
            "nextDialogs": [
              "711151202"
            ]
          },
          "711151202": {
            "id": "711151202",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "哼哼，既然药君大人将这棵树托付给了我，我总不能眼睁睁看着它枯败下去！谢谢你们啦，好心的人类！",
            "nextDialogs": [
              "711151203"
            ]
          },
          "711151203": {
            "id": "711151203",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "明明连口诀都不记得了！",
            "nextDialogs": [
              "711151204"
            ]
          },
          "711151204": {
            "id": "711151204",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "这种细节就不要在意啦！",
            "nextDialogs": [
              "711151205"
            ]
          },
          "711151205": {
            "id": "711151205",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "对了，如果有兴趣的话，我还有一个小小的秘密告知你们！折下一根花枝，插在洞府门外的破药罐里，即可打开石门…"
          }
        }
      }
    },
    {
      "subId": "7111513",
      "subQuestName": "调查古树",

    {
      "subId": "7111501",
      "subQuestName": "了解药蝶谷的过去$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "622430101"
        ],
        "dialogs": {
          "622430101": {
            "id": "622430101",
            "speakerId": 1000,
            "speakerName": "古老的记事",
            "text": "（其上的内容模糊，只留下了几句残缺的话，字迹十分秀气…）",
            "nextDialogs": [
              "622430102"
            ]
          },
          "622430102": {
            "id": "622430102",
            "speakerId": 1000,
            "speakerName": "古老的记事",
            "text": "「…彩蝶汇坛中，仙力复枯木逢生之貌…」",
            "nextDialogs": [
              "622430103"
            ]
          },
          "622430103": {
            "id": "622430103",
            "speakerId": 1000,
            "speakerName": "古老的记事",
            "text": "「…向西而行，见<color=#00E1FFFF>灵枢庭</color>，即可…」"
          }
        }
      }
    },
    {
      "subId": "7111503",
      "subQuestName": "抵达灵枢庭$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711150301"
        ],
        "dialogs": {
          "711150301": {
            "id": "711150301",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "嗯？你刚才说什么来着…"
          }
        }
      }
    },
    {
      "subId": "7111502",
      "subQuestName": "抵达灵枢庭$HIDDEN",

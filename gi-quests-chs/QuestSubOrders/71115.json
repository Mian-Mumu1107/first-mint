    {
      "subId": "7111504",
      "subQuestName": "抓住彩蝶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711150401"
        ],
        "dialogs": {
          "711150401": {
            "id": "711150401",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "唔…嗯？尔等何人？扰我好梦…！",
            "nextDialogs": [
              "711150402"
            ]
          },
          "711150402": {
            "id": "711150402",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸？！什么东西在说话？好可怕！",
            "nextDialogs": [
              "711150403"
            ]
          },
          "711150403": {
            "id": "711150403",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "哇！",
            "nextDialogs": [
              "711150404"
            ]
          },
          "711150404": {
            "id": "711150404",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哇啊啊！！",
            "nextDialogs": [
              "711150405"
            ]
          },
          "711150405": {
            "id": "711150405",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "哈哈哈哈哈！害怕就对咯！若我未被山石所困，你们早就进我肚子里啦！",
            "nextDialogs": [
              "711150406"
            ]
          },
          "711150406": {
            "id": "711150406",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "什么…？啊！原来只是会说话的石像呀…我还以为是什么怪物！",
            "nextDialogs": [
              "711150407"
            ]
          },
          "711150407": {
            "id": "711150407",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "哼，什么叫「只是会说话的石像」！石像会说话难道不可怕吗！",
            "nextDialogs": [
              "711150408"
            ]
          },
          "711150408": {
            "id": "711150408",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呃，像这样的石像，我们在外面已经见过很多了…",
            "nextDialogs": [
              "711150409"
            ]
          },
          "711150409": {
            "id": "711150409",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "什、什么！唉，好吧，那看来是吓不到你们了…",
            "nextDialogs": [
              "711150410"
            ]
          },
          "711150410": {
            "id": "711150410",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "为什么非要吓到别人呀，真是的！明明只是个石像而已！",
            "nextDialogs": [
              "711150411"
            ]
          },
          "711150411": {
            "id": "711150411",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "哼！就算我「只是个石像而已」，此地可是药君大人的洞府！药君大人还在的时候，就不喜欢别人随意打扰她的安宁！",
            "nextDialogs": [
              "711150412"
            ]
          },
          "711150412": {
            "id": "711150412",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "所以呀，我就要把讨厌的家伙全部吓跑！就算药君大人离开了也是一样！",
            "nextDialogs": [
              "711150413"
            ]
          },
          "711150413": {
            "id": "711150413",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "不过，你们的气息和那些普通的凡人好像也有些不同，而且也没有被我吓到…",
            "nextDialogs": [
              "711150414"
            ]
          },
          "711150414": {
            "id": "711150414",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "可不可以拜托你们，帮我一个忙呢？",
            "nextDialogs": [
              "711150415"
            ]
          },
          "711150415": {
            "id": "711150415",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哦？那你要我们帮什么忙呀？",
            "nextDialogs": [
              "711150416"
            ]
          },
          "711150416": {
            "id": "711150416",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "咳咳，你们看这些彩色的蝴蝶！自从洞府的主人离开后，这些小家伙就散落得遍地都是，到处乱飞——",
            "nextDialogs": [
              "711150417"
            ]
          },
          "711150417": {
            "id": "711150417",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嘘…先等一下，你头上就有一只呢！稍等一下，让我们帮你拿下来…"
          }
        }
      }
    },
    {
      "subId": "7111518",
      "subQuestName": "抓住彩蝶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711150501"
        ],
        "dialogs": {
          "711150501": {
            "id": "711150501",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "呼…对啦，就是这个！",
            "nextDialogs": [
              "711150502"
            ]
          },
          "711150502": {
            "id": "711150502",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "先前洞府药君曾引彩蝶点缀门户，后来洞府机关破败，这些彩蝶与药罐…原是用于滋养那棵仙树的。",
            "nextDialogs": [
              "711150503"
            ]
          },
          "711150503": {
            "id": "711150503",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "仙树？",
            "nextDialogs": [
              "711150504"
            ]
          },
          "711150504": {
            "id": "711150504",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "哼哼，没错！想当初，这仙树乃是药君大人亲手栽下…",
            "nextDialogs": [
              "711150505"
            ]
          },
          "711150505": {
            "id": "711150505",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "虽说现在已经枯萎，但药君大人说过，只要彩蝶还没有散尽，那棵树便可以复生！",
            "nextDialogs": [
              "711150506"
            ]
          },
          "711150506": {
            "id": "711150506",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "唉…自从无力维持人形之后，她很快便离开了，不知如今过得如何…",
            "nextDialogs": [
              "711150507"
            ]
          },
          "711150507": {
            "id": "711150507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「彩蝶汇坛中，复枯木逢生之貌…」",
            "nextDialogs": [
              "711150508"
            ]
          },
          "711150508": {
            "id": "711150508",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "没错没错！只要…不对，你们是怎么知道的？",
            "nextDialogs": [
              "711150509"
            ]
          },
          "711150509": {
            "id": "711150509",
            "speakerId": 1001,
            "speakerName": "「慢悠悠仙像」",
            "text": "算了，总之就是这样！只要把那些彩蝶赶进罐子里，就能滋养那棵枯木啦！那就拜托你们了，好心的人类！"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7605801",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760580101"
        ],
        "dialogs": {
          "760580101": {
            "id": "760580101",
            "speakerId": 1000,
            "speakerName": "玫熙",
            "text": "我还从来没见过这么白的盗宝鼬呢，它不会是生病了吧…",
            "nextDialogs": [
              "760580102"
            ]
          },
          "760580102": {
            "id": "760580102",
            "speakerId": 1001,
            "speakerName": "米科",
            "text": "看它活蹦乱跳的，刚才还想从尤尔瓦哥哥那儿抢吃的，哪里像生病的样子呀。",
            "nextDialogs": [
              "760580103"
            ]
          },
          "760580103": {
            "id": "760580103",
            "speakerId": 1002,
            "speakerName": "尤尔瓦",
            "text": "可能是很稀罕的品种？莉奈娅说不定知道。",
            "nextDialogs": [
              "760580104"
            ]
          },
          "760580104": {
            "id": "760580104",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "哇！是把我的小金库洗劫一空的摩拉小偷！",
            "nextDialogs": [
              "760580105"
            ]
          },
          "760580105": {
            "id": "760580105",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "盗宝鼬试图逃跑，但被三个孩子眼疾手快按了下来，挣扎了一会儿就放弃了，趁这时间向孩子们讲述了此前的遭遇…",
            "nextDialogs": [
              "760580106"
            ]
          },
          "760580106": {
            "id": "760580106",
            "speakerId": 1001,
            "speakerName": "米科",
            "text": "原来是惯犯，那得让它吃点教训才行，犯了错就得受惩罚，这样才对吧。",
            "nextDialogs": [
              "760580107"
            ]
          },
          "760580107": {
            "id": "760580107",
            "speakerId": 1000,
            "speakerName": "玫熙",
            "text": "可是…可是它只是个小动物，它又不懂这些…",
            "nextDialogs": [
              "760580110"
            ]
          },
          "760580110": {
            "id": "760580110",
            "speakerId": 1002,
            "speakerName": "尤尔瓦",
            "text": "不管怎么说，先把它身上带的摩拉还给派蒙吧，它也没处花这些摩拉，所以全都在呢。",
            "nextDialogs": [
              "760580111"
            ]
          },
          "760580111": {
            "id": "760580111",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "太好啦！嘿嘿，这下我的小金库又充实起来了。",
            "nextDialogs": [
              "760580112"
            ]
          },
          "760580112": {
            "id": "760580112",
            "speakerId": 1000,
            "speakerName": "玫熙",
            "text": "如果能把它养起来就好了，那样的话，等赫卡回来了也可以让她看看稀罕的盗宝鼬。",
            "nextDialogs": [
              "760580113"
            ]
          },
          "760580113": {
            "id": "760580113",
            "speakerId": 1001,
            "speakerName": "米科",
            "text": "欸？可是它都不会工作…偷东西可不算工作，不工作，凭什么白吃白喝。",
            "nextDialogs": [
              "760580114"
            ]
          },
          "760580114": {
            "id": "760580114",
            "speakerId": 1002,
            "speakerName": "尤尔瓦",
            "text": "好啦好啦，该拿它怎么办…我们之后和卡嘉商量一下再定吧。"
          }
        }
      }
    },
    {
      "subId": "7605802",
      "subQuestName": "回那夏镇看看",

            "speakerId": 1002,
            "speakerName": "「吉法师」",
            "text": "呶！修行开心。",
            "nextDialogs": [
              "722640703",
              "722640713"
            ]
          },
          "722640703": {
            "id": "722640703",
            "speakerId": 1002,
            "speakerName": "「吉法师」",
            "text": "黄毛好强。砰砰，好大好圆就没了。",
            "nextDialogs": [
              "722640704"
            ]
          },
          "722640704": {
            "id": "722640704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为平时有在锻炼。",
            "nextDialogs": [
              "722640705"
            ]
          },
          "722640705": {
            "id": "722640705",
            "speakerId": 1002,
            "speakerName": "「吉法师」",
            "text": "呶！想和黄毛一样强。",
            "nextDialogs": [
              "722640706"
            ]
          },
          "722640706": {
            "id": "722640706",
            "speakerId": 1002,
            "speakerName": "「吉法师」",
            "text": "所以修行。修行修行，变强变强。",
            "nextDialogs": [
              "722640707"
            ]
          },
          "722640707": {
            "id": "722640707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "吉法师变强了以后，想干什么？",
            "nextDialogs": [
              "722640708"
            ]
          },
          "722640708": {
            "id": "722640708",
            "speakerId": 1002,
            "speakerName": "「吉法师」",
            "text": "报复刑部小判，呶哈哈。",
            "nextDialogs": [
              "722640709"
            ]
          },
          "722640709": {
            "id": "722640709",
            "speakerId": 1002,
            "speakerName": "「吉法师」",
            "text": "把五百藏变成不是石头。",
            "nextDialogs": [
              "722640710"
            ]
          },
          "722640710": {
            "id": "722640710",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "加油。修行的路线就交给我们吧。",
            "nextDialogs": [
              "722640711"
            ]
          },
          "722640711": {
            "id": "722640711",
            "speakerId": 1002,
            "speakerName": "「吉法师」",
            "text": "呶！"
          },
          "722640713": {
            "id": "722640713",
            "speakerId": 1002,
            "speakerName": "「吉法师」",
            "text": "耶！"
          }
        }

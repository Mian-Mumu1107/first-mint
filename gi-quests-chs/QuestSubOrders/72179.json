              "721790103"
            ]
          },
          "721790103": {
            "id": "721790103",
            "speakerId": 20292,
            "speakerName": "简朴的墓碑",
            "text": "「在此地与恋人作别，在此处与恋人重聚。」",
            "nextDialogs": [
              "721790104"
            ]
          },
          "721790104": {
            "id": "721790104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…似乎是战死者的墓碑呢。",
            "nextDialogs": [
              "721790105"
            ]
          },
          "721790105": {
            "id": "721790105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "孤零零地太可怜了…我们在墓前放些鲜花吧？",
            "nextDialogs": [
              "721790106"
            ]
          },
          "721790106": {
            "id": "721790106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（放置血斛）"

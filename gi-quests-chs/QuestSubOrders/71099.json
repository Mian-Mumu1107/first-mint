{
  "lineCounts": {
    "Black Screen": 2,
    "Player": 25,
    "云堇": 36,
    "大雨": 29,
    "若心": 8,
    "范二爷": 17,
    "茶博士刘苏": 32,
    "路爷": 13
  },
  "subQuests": [
    {
      "subId": "7109901",
      "subQuestName": "与刘苏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990101"
        ],
        "dialogs": {
          "710990101": {
            "id": "710990101",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "嘿呀，晦气！不讲了，我今天绝对不讲了。",
            "nextDialogs": [
              "710990102"
            ]
          },
          "710990102": {
            "id": "710990102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "710990103"
            ]
          },
          "710990103": {
            "id": "710990103",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "这个小戏台子太气人，几十年了都没修过，台上的人稍微一动弹，它就要嘎吱嘎吱响。",
            "nextDialogs": [
              "710990104"
            ]
          },
          "710990104": {
            "id": "710990104",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "老早就跟我们东家范二爷说了这戏台得换新的，他总找借口说没有好木匠，不乐意换。",
            "nextDialogs": [
              "710990105"
            ]
          },
          "710990105": {
            "id": "710990105",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "今天我正在台上讲《海山履云记》呢，我这摆个架势它就要嘎吱一声。",
            "nextDialogs": [
              "710990106"
            ]
          },
          "710990106": {
            "id": "710990106",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "别提多破坏气氛了，台下观众都乐了，还有几个坏东西给我喝倒彩。",
            "nextDialogs": [
              "710990107"
            ]
          },
          "710990107": {
            "id": "710990107",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "我今天不忍了，一定得找个好木匠，直接带到二爷跟前，看他还有什么理由不换。",
            "nextDialogs": [
              "710990108"
            ]
          },
          "710990108": {
            "id": "710990108",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "我记得你是冒险家协会的对吧，我直接委托你也是一样的，你帮我找个木匠行不行？",
            "nextDialogs": [
              "710990111"
            ]
          },
          "710990111": {
            "id": "710990111",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "也是，一看你就不是璃月人，你哪儿认识好木匠。",
            "nextDialogs": [
              "710990112"
            ]
          },
          "710990112": {
            "id": "710990112",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "这样吧，轻策庄「范木堂」路爷的手艺特别出名，请你代我问问他老人家愿不愿意来帮这个忙。",
            "nextDialogs": [
              "710990113"
            ]
          },
          "710990113": {
            "id": "710990113",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "要是他没有空，派个徒弟来也行。",
            "nextDialogs": [
              "710990114"
            ]
          },
          "710990114": {
            "id": "710990114",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "让范木堂的木匠给我们造戏台肯定是够了，要是造得好，以后云老板来登台我们也有面子。",
            "nextDialogs": [
              "710990115"
            ]
          },
          "710990115": {
            "id": "710990115",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "哎呀绝了，我这个理由想得可太好了，不由得二爷不答应哈哈。",
            "nextDialogs": [
              "710990116"
            ]
          },
          "710990116": {
            "id": "710990116",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "你放心，要是能把木匠带回来，酬金肯定不会拖欠你的。",
            "nextDialogs": [
              "710990117"
            ]
          },
          "710990117": {
            "id": "710990117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明白了。",
            "nextDialogs": [
              "710990118"
            ]
          },
          "710990118": {
            "id": "710990118",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "那就靠你了，我每天都在茶馆，有结果了回来找我就成。"
          }
        }
      }
    },
    {
      "subId": "7109902",
      "subQuestName": "前往轻策庄寻找路爷",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990201"
        ],
        "dialogs": {
          "710990201": {
            "id": "710990201",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "二爷哟，再不上点儿心，生意都要被三碗不过港全抢啦。"
          }
        }
      }
    },
    {
      "subId": "7109903",
      "subQuestName": "与路爷对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990301"
        ],
        "dialogs": {
          "710990301": {
            "id": "710990301",
            "speakerId": 1001,
            "speakerName": "路爷",
            "text": "这年轻人，风尘仆仆的，急什么，坐下来喝杯茶嘛。",
            "nextDialogs": [
              "710990304"
            ]
          },
          "710990304": {
            "id": "710990304",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向路爷解释了刘苏的委托…",
            "nextDialogs": [
              "710990305"
            ]
          },
          "710990305": {
            "id": "710990305",
            "speakerId": 1001,
            "speakerName": "路爷",
            "text": "哦哦，造新戏台不难，但找我是找错人喽。",
            "nextDialogs": [
              "710990306"
            ]
          },
          "710990306": {
            "id": "710990306",
            "speakerId": 1001,
            "speakerName": "路爷",
            "text": "轻策庄到璃月港那么远呢，我去璃月港了谁来照看「范木堂」呀？",
            "nextDialogs": [
              "710990307"
            ]
          },
          "710990307": {
            "id": "710990307",
            "speakerId": 1001,
            "speakerName": "路爷",
            "text": "更何况我这老胳膊老腿，哪儿走得动那么远的路，年纪大啦，经不起折腾。"
          }
        }
      }
    },
    {
      "subId": "7109904",
      "subQuestName": "收集家具材料",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990401"
        ],
        "dialogs": {
          "710990401": {
            "id": "710990401",
            "speakerId": 1003,
            "speakerName": "若心",
            "text": "范二哥真是的，怎么拖到今天才想起来造新戏台啊…",
            "nextDialogs": [
              "710990402"
            ]
          },
          "710990402": {
            "id": "710990402",
            "speakerId": 1003,
            "speakerName": "若心",
            "text": "他年轻时候就抠门，到老了这毛病是越来越严重了。",
            "nextDialogs": [
              "710990405"
            ]
          },
          "710990405": {
            "id": "710990405",
            "speakerId": 1003,
            "speakerName": "若心",
            "text": "哎呀我还不知道他啊，二哥都多大年纪了，还跟自己过不去…",
            "nextDialogs": [
              "710990406"
            ]
          },
          "710990406": {
            "id": "710990406",
            "speakerId": 1003,
            "speakerName": "若心",
            "text": "算了不提了，待会儿云家的小姑娘要来做客，我过会儿得回去收拾收拾。"
          }
        }
      }
    },
    {
      "subId": "7109905",
      "subQuestName": "与大雨对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990601"
        ],
        "dialogs": {
          "710990601": {
            "id": "710990601",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "您瞧好吧。",
            "nextDialogs": [
              "710990602"
            ]
          },
          "710990602": {
            "id": "710990602",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "大雨忙活了一阵。",
            "nextDialogs": [
              "710990603"
            ]
          },
          "710990603": {
            "id": "710990603",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "最后一把椅子也打好了，村长奶奶拿好，这下我该去和裕茶馆干活啦。",
            "nextDialogs": [
              "710990604"
            ]
          },
          "710990604": {
            "id": "710990604",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "师父您等着啊，我大概几天就回了。",
            "nextDialogs": [
              "710990605"
            ]
          },
          "710990605": {
            "id": "710990605",
            "speakerId": 1001,
            "speakerName": "路爷",
            "text": "嗯，去吧去吧。",
            "nextDialogs": [
              "710990606"
            ]
          },
          "710990606": {
            "id": "710990606",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "成，那我现在出发，差不多明天晚上就能赶到了。",
            "nextDialogs": [
              "710990607"
            ]
          },
          "710990607": {
            "id": "710990607",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "我们和裕茶馆见。"
          }
        }
      }
    },
    {
      "subId": "7109906",
      "subQuestName": "等到第二天（18:00~21:00）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7109907",
      "subQuestName": "前往和裕茶馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990701"
        ],
        "dialogs": {
          "710990701": {
            "id": "710990701",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "怎么意思？闹了半天，你们没商量好啊？",
            "nextDialogs": [
              "710990702"
            ]
          },
          "710990702": {
            "id": "710990702",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "哦我懂了，刘苏刘先生想造新戏台，但他说话不算数，得听范二爷的，范二爷又不想造，得。",
            "nextDialogs": [
              "710990703"
            ]
          },
          "710990703": {
            "id": "710990703",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "你俩商量好了再给我个准话吧，我也赶了老久的路，先到边上候着去了。",
            "nextDialogs": [
              "710990704"
            ]
          },
          "710990704": {
            "id": "710990704",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "唉，这叫什么事儿啊…",
            "nextDialogs": [
              "710990707"
            ]
          },
          "710990707": {
            "id": "710990707",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "别急别急，我再说说。",
            "nextDialogs": [
              "710990708"
            ]
          },
          "710990708": {
            "id": "710990708",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "二爷啊，我们今天要是心疼造戏台这点小钱，以后就要亏大钱了。",
            "nextDialogs": [
              "710990709"
            ]
          },
          "710990709": {
            "id": "710990709",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "你想啊，每次云老板在我们这儿登台，人家耍花枪那么一亮相，还没等观众叫好，戏台子先响起来了。",
            "nextDialogs": [
              "710990710"
            ]
          },
          "710990710": {
            "id": "710990710",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "你说尴尬不尴尬？本来云翰社就是挂靠在我们这儿，到时候人家一不高兴去了别处，我们就亏大了。",
            "nextDialogs": [
              "710990711"
            ]
          },
          "710990711": {
            "id": "710990711",
            "speakerId": 1005,
            "speakerName": "范二爷",
            "text": "凭云老板跟我的交情，她是不会这么干的。",
            "nextDialogs": [
              "710990712"
            ]
          },
          "710990712": {
            "id": "710990712",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "您还以为我们高枕无忧呢？我可听说最近大家都爱去三碗不过港，不爱上我们这儿来。",
            "nextDialogs": [
              "710990713"
            ]
          },
          "710990713": {
            "id": "710990713",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "那田铁嘴名头都比我大了，您倒是有点忧患意识啊。",
            "nextDialogs": [
              "710990714"
            ]
          },
          "710990714": {
            "id": "710990714",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "云老板给茶馆挣了这么多钱，我们造个戏台这点钱出不起？",
            "nextDialogs": [
              "710990715"
            ]
          },
          "710990715": {
            "id": "710990715",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "谁叫我呀？哦，是刘苏先生，今天是怎么了，生这么大气？",
            "nextDialogs": [
              "710990716"
            ]
          },
          "710990716": {
            "id": "710990716",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "没有没有，说不上生气。云老板今天过来，是安排了戏吗？",
            "nextDialogs": [
              "710990717"
            ]
          },
          "710990717": {
            "id": "710990717",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "倒不是，只是想来茶馆喝喝茶，顺便来看望看望二爷和刘苏先生。",
            "nextDialogs": [
              "710990718"
            ]
          },
          "710990718": {
            "id": "710990718",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "#啊，巧得很，原来{NICKNAME}也来了。"
          }
        }
      }
    },
    {
      "subId": "7109908",
      "subQuestName": "与云堇一同去「泡茶」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990801"
        ],
        "dialogs": {
          "710990801": {
            "id": "710990801",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "云先生，我还在想二爷怎么就不愿意造戏台呢，明明是百利无一害的事。",
            "nextDialogs": [
              "710990802"
            ]
          },
          "710990802": {
            "id": "710990802",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "你一试探我才明白，还是你聪慧。",
            "nextDialogs": [
              "710990803"
            ]
          },
          "710990803": {
            "id": "710990803",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "二爷念旧我是能明白，就是没想到，这都几十年了，他还惦记着以前的事。",
            "nextDialogs": [
              "710990804"
            ]
          },
          "710990804": {
            "id": "710990804",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "这下就都明白了。",
            "nextDialogs": [
              "710990805"
            ]
          },
          "710990805": {
            "id": "710990805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我没明白。",
            "nextDialogs": [
              "710990806"
            ]
          },
          "710990806": {
            "id": "710990806",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "这是以前的旧事，既然你也被卷进来了，那告诉你也无妨。",
            "nextDialogs": [
              "710990807"
            ]
          },
          "710990807": {
            "id": "710990807",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "范二爷年轻的时候也能唱，和若心前辈常年搭戏，他们两个总在台上扮一对，大概二爷心里当了真吧。",
            "nextDialogs": [
              "710990808"
            ]
          },
          "710990808": {
            "id": "710990808",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "不过，若心前辈其实另有心上人，后来她逐渐厌倦了舞台生活，就和她那位一道去了轻策庄。",
            "nextDialogs": [
              "710990809"
            ]
          },
          "710990809": {
            "id": "710990809",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "不知道中间出了什么变故，那位没能和若心前辈在轻策庄团聚，她就孤身留在了那里，直到现在。",
            "nextDialogs": [
              "710990810"
            ]
          },
          "710990810": {
            "id": "710990810",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "二爷知道我常去轻策庄看望若心前辈，总跟我打听她的近况。",
            "nextDialogs": [
              "710990811"
            ]
          },
          "710990811": {
            "id": "710990811",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "可见他还是念着若心前辈，不愿意造新戏台也是想给过去留个念想。",
            "nextDialogs": [
              "710990812"
            ]
          },
          "710990812": {
            "id": "710990812",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "唉，既然这个戏台对二爷这么重要，那新戏台肯定是修不了了，木匠也白请了…",
            "nextDialogs": [
              "710990813"
            ]
          },
          "710990813": {
            "id": "710990813",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "这也未必，我有办法，刘苏先生等着看吧。",
            "nextDialogs": [
              "710990814"
            ]
          },
          "710990814": {
            "id": "710990814",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "你当真有好办法？只要能修成，我事后一定好好谢谢云老板。",
            "nextDialogs": [
              "710990815"
            ]
          },
          "710990815": {
            "id": "710990815",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "#多了我也不需要，刘苏先生单给我讲一场《裁雨声》吧，这回我想听完，{NICKNAME}也可以一起。",
            "nextDialogs": [
              "710990816"
            ]
          },
          "710990816": {
            "id": "710990816",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉云堇和平时不太一样。",
            "nextDialogs": [
              "710990817"
            ]
          },
          "710990817": {
            "id": "710990817",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "我们茶馆和云翰社的交情多厚哪，云老板跟我们当然比跟别人亲近。",
            "nextDialogs": [
              "710990818"
            ]
          },
          "710990818": {
            "id": "710990818",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "您放心，以后一定单独给你们开一场。",
            "nextDialogs": [
              "710990819"
            ]
          },
          "710990819": {
            "id": "710990819",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "好了，我们「茶」也喝完了，该去跟二爷说道说道了。"
          }
        }
      }
    },
    {
      "subId": "7109909",
      "subQuestName": "与范二爷对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990901"
        ],
        "dialogs": {
          "710990901": {
            "id": "710990901",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "二爷，我们刚刚正喝着茶，我突然想起来若心前辈跟我说什么了。",
            "nextDialogs": [
              "710990902"
            ]
          },
          "710990902": {
            "id": "710990902",
            "speakerId": 1005,
            "speakerName": "范二爷",
            "text": "哦，她说什么呀？",
            "nextDialogs": [
              "710990903"
            ]
          },
          "710990903": {
            "id": "710990903",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "她说：「二哥总爱跟自己过不去，听着让人难过。」",
            "nextDialogs": [
              "710990904"
            ]
          },
          "710990904": {
            "id": "710990904",
            "speakerId": 1005,
            "speakerName": "范二爷",
            "text": "唉，还是她明白我。",
            "nextDialogs": [
              "710990905"
            ]
          },
          "710990905": {
            "id": "710990905",
            "speakerId": 1005,
            "speakerName": "范二爷",
            "text": "不过，她好像也不怎么怀念这个旧物件啊，只有我还在自己跟自己较劲。",
            "nextDialogs": [
              "710990906"
            ]
          },
          "710990906": {
            "id": "710990906",
            "speakerId": 1005,
            "speakerName": "范二爷",
            "text": "我坚持不让别人动这个戏台不是自讨没趣吗？算了算了，你们修吧。",
            "nextDialogs": [
              "710990907"
            ]
          },
          "710990907": {
            "id": "710990907",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "二爷这是有情有义，怎么能说是自讨没趣呢？您这么说我可不爱听。",
            "nextDialogs": [
              "710990908"
            ]
          },
          "710990908": {
            "id": "710990908",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "戏台还是要修的，但也不能破坏了二爷的念想。",
            "nextDialogs": [
              "710990909"
            ]
          },
          "710990909": {
            "id": "710990909",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "你们终于肯动工了啊？好，我这就安排。",
            "nextDialogs": [
              "710990910"
            ]
          },
          "710990910": {
            "id": "710990910",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "我准备的图纸你们可以看看，群玉阁上那座大戏台就是照着这份图纸打造的。",
            "nextDialogs": [
              "710990911"
            ]
          },
          "710990911": {
            "id": "710990911",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "按照这个设计，这两边的墙都要打掉哈，还有…",
            "nextDialogs": [
              "710990912"
            ]
          },
          "710990912": {
            "id": "710990912",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "不着急，这个戏台我想还是得修旧如旧，既然是木地板响动影响演出，那就先修修地板。",
            "nextDialogs": [
              "710990913"
            ]
          },
          "710990913": {
            "id": "710990913",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "其余的往后再说，刘苏先生，这样可以吗？",
            "nextDialogs": [
              "710990914"
            ]
          },
          "710990914": {
            "id": "710990914",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "只要这戏台修完了不再影响平时演出，具体怎么修都听云老板和二爷安排。",
            "nextDialogs": [
              "710990915"
            ]
          },
          "710990915": {
            "id": "710990915",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "啊，就这样？不造新戏台了？",
            "nextDialogs": [
              "710990916"
            ]
          },
          "710990916": {
            "id": "710990916",
            "speakerId": 1005,
            "speakerName": "范二爷",
            "text": "我看这样好，还是云老板的主意妙。",
            "nextDialogs": [
              "710990917"
            ]
          },
          "710990917": {
            "id": "710990917",
            "speakerId": 1005,
            "speakerName": "范二爷",
            "text": "正巧修戏台用的木板也不用额外采购，码头上就有现成的。",
            "nextDialogs": [
              "710990918"
            ]
          },
          "710990918": {
            "id": "710990918",
            "speakerId": 1005,
            "speakerName": "范二爷",
            "text": "#这位…{NICKNAME}还得麻烦你走一遭，这次跑腿的酬金稍后一起给你结算好了。",
            "nextDialogs": [
              "710990919"
            ]
          },
          "710990919": {
            "id": "710990919",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以。",
            "nextDialogs": [
              "710990920"
            ]
          },
          "710990920": {
            "id": "710990920",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "…好吧，一起交给我好了。"
          }
        }
      }
    },
    {
      "subId": "7109910",
      "subQuestName": "前往码头仓库获取木板",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7109911",
      "subQuestName": "将木板交给大雨",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710991101"
        ],
        "dialogs": {
          "710991101": {
            "id": "710991101",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "行吧，这几块木板应该够用了，我这就开工。"
          }
        }
      }
    },
    {
      "subId": "7109905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710990501"
        ],
        "dialogs": {
          "710990501": {
            "id": "710990501",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "您受累，三根松木和一份红染料有了没？"
          }
        }
      }
    },
    {
      "subId": "7109950",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995001"
        ],
        "dialogs": {
          "710995001": {
            "id": "710995001",
            "speakerId": 1001,
            "speakerName": "路爷",
            "text": "#{M#小兄弟}{F#小姑娘}，老头我今天有徒弟啦，哈哈今天晚上炖一锅林猪肉庆祝一下！"
          }
        }
      }
    },
    {
      "subId": "7109951",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995101"
        ],
        "dialogs": {
          "710995101": {
            "id": "710995101",
            "speakerId": 1005,
            "speakerName": "范二爷",
            "text": "好了好了，别念叨什么修戏台了，让我再想想。"
          }
        }
      }
    },
    {
      "subId": "7109952",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995201"
        ],
        "dialogs": {
          "710995201": {
            "id": "710995201",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "我还以为能接个大活呢，连当初群玉阁上的大戏台图纸都带了，结果雇主们自己没商量好，这不是拿人开心嘛。"
          }
        }
      }
    },
    {
      "subId": "7109953",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995301"
        ],
        "dialogs": {
          "710995301": {
            "id": "710995301",
            "speakerId": 1005,
            "speakerName": "范二爷",
            "text": "还是云老板懂我的心思。"
          }
        }
      }
    },
    {
      "subId": "7109954",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995401"
        ],
        "dialogs": {
          "710995401": {
            "id": "710995401",
            "speakerId": 1000,
            "speakerName": "茶博士刘苏",
            "text": "不就是单开一出《裁雨声》吗，没问题。"
          }
        }
      }
    },
    {
      "subId": "7109955",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995501"
        ],
        "dialogs": {
          "710995501": {
            "id": "710995501",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "这样就好解决了，皆大欢喜。",
            "nextDialogs": [
              "710995503",
              "710995509"
            ]
          },
          "710995503": {
            "id": "710995503",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "其实我的确是刚从轻策庄回来，也的确是去探望若心前辈了，前辈说的话也是真的，只是…",
            "nextDialogs": [
              "710995504"
            ]
          },
          "710995504": {
            "id": "710995504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只是？",
            "nextDialogs": [
              "710995505"
            ]
          },
          "710995505": {
            "id": "710995505",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "嘘！只是我啊，没说全。前辈那一整句话是：",
            "nextDialogs": [
              "710995506"
            ]
          },
          "710995506": {
            "id": "710995506",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "「二哥总爱跟自己过不去，抠抠搜搜的，周围人也跟着他受罪，听着让人难过。」",
            "nextDialogs": [
              "710995507"
            ]
          },
          "710995507": {
            "id": "710995507",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "虽然是大实话，但要是全说了，二爷该不开心了，我才只说了半截。"
          },
          "710995509": {
            "id": "710995509",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "好啊，我第二喜欢的就是等个好天气，来茶馆里坐着。",
            "nextDialogs": [
              "710995510"
            ]
          },
          "710995510": {
            "id": "710995510",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "刘苏先生不开讲的时候，就坐在这里听听市声，也很舒心。",
            "nextDialogs": [
              "710995511"
            ]
          },
          "710995511": {
            "id": "710995511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "第一喜欢的呢？",
            "nextDialogs": [
              "710995512"
            ]
          },
          "710995512": {
            "id": "710995512",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "当然是登台唱戏呀。",
            "nextDialogs": [
              "710995513"
            ]
          },
          "710995513": {
            "id": "710995513",
            "speakerId": 1006,
            "speakerName": "云堇",
            "text": "我确实还有很多话想跟你聊聊，但你看，刘苏先生还在一边等着你拿来木板修戏台呢。"
          }
        }
      }
    },
    {
      "subId": "7109956",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710995601"
        ],
        "dialogs": {
          "710995601": {
            "id": "710995601",
            "speakerId": 1004,
            "speakerName": "大雨",
            "text": "师父说得没错，城里老板不好伺候啊。"
          }
        }
      }
    }
  ]
}
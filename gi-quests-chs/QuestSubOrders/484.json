    {
      "subId": "48422",
      "subQuestName": "寻找怪鸟遗留的痕迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4842201"
        ],
        "dialogs": {
          "4842201": {
            "id": "4842201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然跑到这里来了…",
            "nextDialogs": [
              "4842202"
            ]
          },
          "4842202": {
            "id": "4842202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "前面已经没有元素痕迹了。",
            "nextDialogs": [
              "4842203"
            ]
          },
          "4842203": {
            "id": "4842203",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "文物上面的元素力要耗尽了。",
            "nextDialogs": [
              "4842204"
            ]
          },
          "4842204": {
            "id": "4842204",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "原来是这样，怪鸟一伙知道自己没法处理元素的痕迹，才让手下拖住我们。",
            "nextDialogs": [
              "4842205"
            ]
          },
          "4842205": {
            "id": "4842205",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "是想等元素的痕迹自然消失吧。",
            "nextDialogs": [
              "4842206"
            ]
          },
          "4842206": {
            "id": "4842206",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "他不会得逞的，我们赶紧追上去。"
          }
        }
      }
    },
    {
      "subId": "48423",

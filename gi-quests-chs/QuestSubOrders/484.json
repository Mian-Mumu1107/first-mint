    {
      "subId": "48431",
      "subQuestName": "上前查看前方异响",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4843101"
        ],
        "dialogs": {
          "4843101": {
            "id": "4843101",
            "speakerId": 1256,
            "speakerName": "法拉",
            "text": "太好了，是西风骑士团的人！丘丘人应该不敢追过来了…",
            "nextDialogs": [
              "4843102"
            ]
          },
          "4843102": {
            "id": "4843102",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "发生什么了？",
            "nextDialogs": [
              "4843103"
            ]
          },
          "4843103": {
            "id": "4843103",
            "speakerId": 1256,
            "speakerName": "法拉",
            "text": "真是倒霉…我们的车队被丘丘人袭击了，还好我们跑得比较快。",
            "nextDialogs": [
              "4843104"
            ]
          },
          "4843104": {
            "id": "4843104",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "丘丘人袭击？可周围的丘丘人营地，几乎都已经被骑士团清理干净了吧？",
            "nextDialogs": [
              "4843105"
            ]
          },
          "4843105": {
            "id": "4843105",
            "speakerId": 1256,
            "speakerName": "法拉",
            "text": "是一个很小的丘丘人营地，和镇里隔着不远，我平时进货摆摊的时候也会特意绕开。",
            "nextDialogs": [
              "4843106"
            ]
          },
          "4843106": {
            "id": "4843106",
            "speakerId": 1256,
            "speakerName": "法拉",
            "text": "但是今天，突然从天上飞下来一个人，正好落在那个丘丘人营地里面！",
            "nextDialogs": [
              "4843107"
            ]
          },
          "4843107": {
            "id": "4843107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…总感觉是某人经常做的事情呢。",
            "nextDialogs": [
              "4843108"
            ]
          },
          "4843108": {
            "id": "4843108",
            "speakerId": 1256,
            "speakerName": "法拉",
            "text": "丘丘人一下子就炸了锅了，跟着那个逃跑的怪人就追了出来！",
            "nextDialogs": [
              "4843109"
            ]
          },
          "4843109": {
            "id": "4843109",
            "speakerId": 1256,
            "speakerName": "法拉",
            "text": "我是跑了，可我运水果的车全都被砸了！明天商队来的时候，我可怎么开张啊——",
            "nextDialogs": [
              "4843110"
            ]
          },
          "4843110": {
            "id": "4843110",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "怪人？是什么样子的怪人？",
            "nextDialogs": [
              "4843111"
            ]
          },
          "4843111": {
            "id": "4843111",
            "speakerId": 1256,
            "speakerName": "法拉",
            "text": "抱着个什么东西，飞得歪歪扭扭的…嗯，一定是因为抱着这东西他才掉下来了。",
            "nextDialogs": [
              "4843112"
            ]
          },
          "4843112": {
            "id": "4843112",
            "speakerId": 1256,
            "speakerName": "法拉",
            "text": "真是的，没考过飞行执照吗？不许带重物懂不懂？！我一定要去举报，吊销他的飞行执照！",
            "nextDialogs": [
              "4843113"
            ]
          },
          "4843113": {
            "id": "4843113",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "抱着重物…说不定就是带着文物逃跑的怪鸟。",
            "nextDialogs": [
              "4843114"
            ]
          },
          "4843114": {
            "id": "4843114",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "你看见那个怪人往哪里跑了吗？",
            "nextDialogs": [
              "4843115"
            ]
          },
          "4843115": {
            "id": "4843115",
            "speakerId": 1256,
            "speakerName": "法拉",
            "text": "我跑的时候就来得及看了一眼，他们好像…是往前面跑了。",
            "nextDialogs": [
              "4843116"
            ]
          },
          "4843116": {
            "id": "4843116",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "#总算抓住线索了，{NICKNAME}，我们快点追上去吧。",
            "nextDialogs": [
              "4843117"
            ]
          },
          "4843117": {
            "id": "4843117",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "哦对了，别担心，我回去也会报告骑士团，把残留的丘丘人营地尽快处理掉的。"
          }
        }
      }
    },

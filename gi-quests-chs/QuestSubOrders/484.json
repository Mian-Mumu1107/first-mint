    {
      "subId": "48404",
      "subQuestName": "(test)可疑的痕迹（已改为开车）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4840401"
        ],
        "dialogs": {
          "4840401": {
            "id": "4840401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这痕迹，会是怪鸟还是风史莱姆呢…",
            "nextDialogs": [
              "4840402"
            ]
          },
          "4840402": {
            "id": "4840402",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "风史莱姆是漂浮的。除非有人在这里踩着它起飞，不然不可能啦。",
            "nextDialogs": [
              "4840403"
            ]
          },
          "4840403": {
            "id": "4840403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…有人用风史莱姆做过这种事吗？！",
            "nextDialogs": [
              "4840404"
            ]
          },
          "4840404": {
            "id": "4840404",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "总之，很清晰的痕迹，把这里先记下来吧。"
          }
        }
      }
    },
    {
      "subId": "48405",

    {
      "subId": "48411",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4841101"
        ],
        "dialogs": {
          "4841101": {
            "id": "4841101",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "元素的痕迹一直指向了前面。",
            "nextDialogs": [
              "4841102"
            ]
          },
          "4841102": {
            "id": "4841102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道怪鸟一直往前方逃走了？",
            "nextDialogs": [
              "4841103"
            ]
          },
          "4841103": {
            "id": "4841103",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "光是这么猜不会得出结论。",
            "nextDialogs": [
              "4841104"
            ]
          },
          "4841104": {
            "id": "4841104",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "#{NICKNAME}，我们顺着痕迹追下去吧。",
            "nextDialogs": [
              "4841105"
            ]
          },
          "4841105": {
            "id": "4841105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，前面好像有什么动静…",
            "nextDialogs": [
              "4841106"
            ]
          },
          "4841106": {
            "id": "4841106",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "好像是战斗的声音，难道是怪鸟？！",
            "nextDialogs": [
              "4841107"
            ]
          },
          "4841107": {
            "id": "4841107",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "快，我们赶紧过去吧。"
          }
        }
      }
    },
    {
      "subId": "48431",

    {
      "subId": "48402",
      "subQuestName": "与安柏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4840201"
        ],
        "dialogs": {
          "4840201": {
            "id": "4840201",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "前面就是清泉镇了，周围一定有关于「怪鸟」的线索。",
            "nextDialogs": [
              "4840202"
            ]
          },
          "4840202": {
            "id": "4840202",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "他带着的文物上，有修女们偷偷标记的风元素痕迹…",
            "nextDialogs": [
              "4840203"
            ]
          },
          "4840203": {
            "id": "4840203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那就<color=#00E1FFFF>开启元素视野</color>，仔细留意周围吧。"
          }
        }
      }
    },
    {
      "subId": "48403",
      "subQuestName": "搜集线索，追踪「怪鸟」",
      "sceneId": null,
      "locations": [],

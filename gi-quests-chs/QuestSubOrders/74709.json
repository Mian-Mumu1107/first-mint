        ],
        "dialogs": {
          "747090101": {
            "id": "747090101",
            "speakerId": 1079,
            "speakerName": "希格雯",
            "text": "#辛苦你们啦，{NICKNAME}和派蒙。",
            "nextDialogs": [
              "747090102"
            ]
          },
          "747090102": {
            "id": "747090102",
            "speakerId": 1079,
            "speakerName": "希格雯",
            "text": "我已经基本了解了病患鱼儿们的病情，还调制了一些美露莘的秘方草药…",
            "nextDialogs": [
              "747090103"
            ]
          },
          "747090103": {
            "id": "747090103",
            "speakerId": 1079,
            "speakerName": "希格雯",
            "text": "将这种特别的草药调和在水箱里，就能帮它们冷静下来~",
            "nextDialogs": [
              "747090104"
            ]
          },
          "747090104": {
            "id": "747090104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等于是把水箱整个改成了治疗场所？",
            "nextDialogs": [
              "747090105"
            ]
          },
          "747090105": {
            "id": "747090105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "仔细想想…可真是只有希格雯才能办到的事！",
            "nextDialogs": [
              "747090108"
            ]
          },
          "747090108": {
            "id": "747090108",
            "speakerId": 1079,
            "speakerName": "希格雯",
            "text": "没错，这需要请不同特性的鱼儿们来我这里做「体检」，才能准确归纳病因…",
            "nextDialogs": [
              "747090109"
            ]
          },
          "747090109": {
            "id": "747090109",
            "speakerId": 1079,
            "speakerName": "希格雯",
            "text": "接下来，我会根据鱼儿们的特性，更有针对性地列出一些病患。",
            "nextDialogs": [
              "747090110"
            ]
          },
          "747090110": {
            "id": "747090110",
            "speakerId": 1079,
            "speakerName": "希格雯",
            "text": "就麻烦你们多多留意这样的鱼儿了。"
          }
        }
      }
    }
  ]

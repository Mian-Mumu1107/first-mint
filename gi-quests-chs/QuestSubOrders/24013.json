  "subQuests": [
    {
      "subId": "2401301",
      "subQuestName": "与艾尤恩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240130101"
        ],
        "dialogs": {
          "240130101": {
            "id": "240130101",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "唉，我真是想不通，为什么会这样…",
            "nextDialogs": [
              "240130104"
            ]
          },
          "240130104": {
            "id": "240130104",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "旅行者，真高兴见到你。你是来喝咖啡的吗？让我来请你一杯吧。",
            "nextDialogs": [
              "240130105"
            ]
          },
          "240130105": {
            "id": "240130105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你怎么啦？看起来脸色好难看，是又被谁逼着熬夜了吗？",
            "nextDialogs": [
              "240130106"
            ]
          },
          "240130106": {
            "id": "240130106",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "谢谢关心。这次是我自己的问题。",
            "nextDialogs": [
              "240130107"
            ]
          },
          "240130107": {
            "id": "240130107",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "我最近正在思考…我工作的意义究竟是什么。",
            "nextDialogs": [
              "240130108"
            ]
          },
          "240130108": {
            "id": "240130108",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "我一直认为复律庭是一个公正，高效，人人都愿意互帮互助的强力机构。",
            "nextDialogs": [
              "240130109"
            ]
          },
          "240130109": {
            "id": "240130109",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "在复律庭的管理下，整个枫丹廷都会朝着更好的方向发展。",
            "nextDialogs": [
              "240130110"
            ]
          },
          "240130110": {
            "id": "240130110",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "但现在看来，它就像是一个破破烂烂的机关屋子。齿轮，杠杆，旋臂乱七八糟地耷拉着…只有外壳却一直保持光鲜亮丽。",
            "nextDialogs": [
              "240130111"
            ]
          },
          "240130111": {
            "id": "240130111",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "它之所以能运转起来，只是因为一系列的巧合与教训，而不是精密地思考和设计。",
            "nextDialogs": [
              "240130112"
            ]
          },
          "240130112": {
            "id": "240130112",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "我…我想做些什么，但根本无从下手。我怕只要做错了一件事，就会让这间机关屋子整个垮塌掉。",
            "nextDialogs": [
              "240130113"
            ]
          },
          "240130113": {
            "id": "240130113",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "虽然洛耶茨先生时常和我说，让我放宽心，就算我再怎么犯错，状况也不可能比现在更糟…",
            "nextDialogs": [
              "240130114"
            ]
          },
          "240130114": {
            "id": "240130114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这，这算是安慰吗…",
            "nextDialogs": [
              "240130115"
            ]
          },
          "240130115": {
            "id": "240130115",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "唉，抱歉，我不该和你抱怨这些。我今天之所以出来散心，主要原因也是想暂时逃避这些事…",
            "nextDialogs": [
              "240130116"
            ]
          },
          "240130116": {
            "id": "240130116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我来给你调杯咖啡吧。",
            "nextDialogs": [
              "240130117"
            ]
          },
          "240130117": {
            "id": "240130117",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "真的？你会调咖啡吗？真是太厉害了，我之前也想学，但总是没时间。",
            "nextDialogs": [
              "240130118"
            ]
          },
          "240130118": {
            "id": "240130118",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "那就拜托你了，我会在这里等着的…希望工作别在咖啡厅里追上我。"
          }
        }
      }
    },
    {
      "subId": "2401302",
      "subQuestName": "与阿鲁埃对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240130201"
        ],
        "dialogs": {
          "240130201": {
            "id": "240130201",
            "speakerId": 5053,
            "speakerName": "阿鲁埃",
            "text": "旅行者，你是来店里帮忙的吗？非常欢迎！",
            "nextDialogs": [
              "240130202"
            ]
          },
          "240130202": {
            "id": "240130202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不是啦，我们只是想给一个朋友调一杯咖啡，他现在好像…嗯…",
            "nextDialogs": [
              "240130205"
            ]
          },
          "240130205": {
            "id": "240130205",
            "speakerId": 5053,
            "speakerName": "阿鲁埃",
            "text": "你们说的那个朋友。是坐在那边的艾尤恩吗？",
            "nextDialogs": [
              "240130206"
            ]
          },
          "240130206": {
            "id": "240130206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你认识他？",
            "nextDialogs": [
              "240130207"
            ]
          },
          "240130207": {
            "id": "240130207",
            "speakerId": 5053,
            "speakerName": "阿鲁埃",
            "text": "我和洛耶茨是老朋友了。他和我提起过，说他们办公室里来了一位聪明又勤恳的小伙子，就是艾尤恩。",
            "nextDialogs": [
              "240130208"
            ]
          },
          "240130208": {
            "id": "240130208",
            "speakerId": 5053,
            "speakerName": "阿鲁埃",
            "text": "不用担心他。刚刚去复律庭里工作的年轻人，总是会沮丧一段时间的。",
            "nextDialogs": [
              "240130209"
            ]
          },
          "240130209": {
            "id": "240130209",
            "speakerId": 5053,
            "speakerName": "阿鲁埃",
            "text": "等他们找到一个只属于自己的位置后，心情就会放松下来了。",
            "nextDialogs": [
              "240130210"
            ]
          },
          "240130210": {
            "id": "240130210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "老板，你怎么这么有经验呀？",
            "nextDialogs": [
              "240130211"
            ]
          },
          "240130211": {
            "id": "240130211",
            "speakerId": 5053,
            "speakerName": "阿鲁埃",
            "text": "因为我也曾经是复律庭里占着坑的一个萝卜。",
            "nextDialogs": [
              "240130212"
            ]
          },
          "240130212": {
            "id": "240130212",
            "speakerId": 5053,
            "speakerName": "阿鲁埃",
            "text": "但我不满意自己只做个萝卜，就离开了我的坑，然后…来开了这家咖啡厅。"
          }
        }
      }
    },
    {
      "subId": "2401305",
      "subQuestName": "与阿鲁埃对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240135101"
        ],
        "dialogs": {
          "240135101": {
            "id": "240135101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准备好了。",
            "nextDialogs": [
              "240135102"
            ]
          },
          "240135102": {
            "id": "240135102",
            "speakerId": 5053,
            "speakerName": "阿鲁埃",
            "text": "需要用的材料我都帮你准备好了，就放在那边，快点开始调制吧。"
          }
        }
      }
    },
    {
      "subId": "2401303",
      "subQuestName": "为艾尤恩调制咖啡",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240130301"
        ],
        "dialogs": {
          "240130301": {
            "id": "240130301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…这次要用什么材料来调制咖啡呢？"
          }
        }
      }
    },
    {
      "subId": "2401306",
      "subQuestName": "为艾尤恩调制咖啡",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240133101"
        ],
        "dialogs": {
          "240133101": {
            "id": "240133101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来不错呢，那就开始调制吧。",
            "nextDialogs": [
              "240133102"
            ]
          },
          "240133102": {
            "id": "240133102",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "开始调制咖啡…",
            "nextDialogs": [
              "240133103"
            ]
          },
          "240133103": {
            "id": "240133103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…闻起来就很香！快把这杯咖啡端给艾尤恩，让他打起精神来吧！"
          }
        }
      }
    },
    {
      "subId": "2401304",
      "subQuestName": "将咖啡带给艾尤恩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240130401"
        ],
        "dialogs": {
          "240130401": {
            "id": "240130401",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "旅行者，你…你还真给我调了杯咖啡吗？这怎么好意思，太麻烦你了…",
            "nextDialogs": [
              "240130404"
            ]
          },
          "240130404": {
            "id": "240130404",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "…这咖啡！比复律庭里供应的那些咖啡好喝多了！不…不如说根本就不是一个层次的咖啡。",
            "nextDialogs": [
              "240130405"
            ]
          },
          "240130405": {
            "id": "240130405",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "要是能天天喝到这种咖啡，我也不会每天下午都昏昏欲睡了。",
            "nextDialogs": [
              "240130406"
            ]
          },
          "240130406": {
            "id": "240130406",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "谢谢你的咖啡，喝完这杯之后，我又得去工作了。"
          }
        }
      }
    },
    {
      "subId": "2401350",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240135001"
        ],
        "dialogs": {
          "240135001": {
            "id": "240135001",
            "speakerId": 5053,
            "speakerName": "阿鲁埃",
            "text": "怎么样，你准备好给艾尤恩调一杯咖啡了吗？"
          }
        }
      }
    },
    {
      "subId": "2401352",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240135201"
        ],
        "dialogs": {
          "240135201": {
            "id": "240135201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事…",
            "nextDialogs": [
              "240135202"
            ]
          },
          "240135202": {
            "id": "240135202",
            "speakerId": 5053,
            "speakerName": "阿鲁埃",
            "text": "你准备好了之后，来找我就行。"
          }
        }
      }
    },
    {
      "subId": "2401380",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240138001"
        ],
        "dialogs": {
          "240138001": {
            "id": "240138001",
            "speakerId": 5084,
            "speakerName": "艾尤恩",
            "text": "机关屋子…唉，我迟早也会成为一枚破破烂烂的齿轮吗…"
          }
        }
      }
    },
    {
      "subId": "2401399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240139901"
        ],
        "dialogs": {
          "240139901": {
            "id": "240139901",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "加入配料后，完成了旅行者特调。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7514911",
      "subQuestName": "启动机关",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751491101"
        ],
        "dialogs": {
          "751491101": {
            "id": "751491101",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯…唔…",
            "nextDialogs": [
              "751491102"
            ]
          },
          "751491102": {
            "id": "751491102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么了？看上去不是很舒服的样子。",
            "nextDialogs": [
              "751491103"
            ]
          },
          "751491103": {
            "id": "751491103",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呃呀！",
            "nextDialogs": [
              "751491104"
            ]
          },
          "751491104": {
            "id": "751491104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那个难道是…深渊？",
            "nextDialogs": [
              "751491105"
            ]
          },
          "751491105": {
            "id": "751491105",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「正是如此…深渊的魔物正如顽疾一般侵入圣城图兰。」",
            "nextDialogs": [
              "751491106"
            ]
          },
          "751491106": {
            "id": "751491106",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「到了这种程度，说不定已经无法将之一点点驱逐，得将整座图兰圣山一同毁掉才能遏制它们的步伐呢…」",
            "nextDialogs": [
              "751491107"
            ]
          },
          "751491107": {
            "id": "751491107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "当你发现一只深渊魔物的时候…",
            "nextDialogs": [
              "751491108"
            ]
          },
          "751491108": {
            "id": "751491108",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「说不定家里已经全都是这些漆黑又黏答答的敌人了…」",
            "nextDialogs": [
              "751491109"
            ]
          },
          "751491109": {
            "id": "751491109",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜…",
            "nextDialogs": [
              "751491110"
            ]
          },
          "751491110": {
            "id": "751491110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，你们在说什么恐怖的话呢。",
            "nextDialogs": [
              "751491111"
            ]
          },
          "751491111": {
            "id": "751491111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "砍掉腿就能遏制它们的步伐了！",
            "nextDialogs": [
              "751491112"
            ]
          },
          "751491112": {
            "id": "751491112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真是让人豁然开朗，剩下的工作就是找到它们的腿在哪了…你以为我会这样说吗！",
            "nextDialogs": [
              "751491113"
            ]
          },
          "751491113": {
            "id": "751491113",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔嗯？",
            "nextDialogs": [
              "751491114"
            ]
          },
          "751491114": {
            "id": "751491114",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「哈哈，真可惜，小家伙，也许大部分的深渊魔物都不靠腿移动呢。」",
            "nextDialogs": [
              "751491115"
            ]
          },
          "751491115": {
            "id": "751491115",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「…只有将这拦路的阴影之敌清除掉，你们才能通过此处，前往圣山之心。」",
            "nextDialogs": [
              "751491116"
            ]
          },
          "751491116": {
            "id": "751491116",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「尽管已无法令这破碎的城市恢复原样，但至少也不应让它的残躯被漆黑的魔物占有。」",
            "nextDialogs": [
              "751491117"
            ]
          },
          "751491117": {
            "id": "751491117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等等，不是有大火球吗…",
            "nextDialogs": [
              "751491118"
            ]
          },
          "751491118": {
            "id": "751491118",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是啊，大火球不就是用来对抗深渊的东西嘛…",
            "nextDialogs": [
              "751491119"
            ]
          },
          "751491119": {
            "id": "751491119",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「大火球…你是说『象拟聚星』吗，它只有在初步接触深渊时与对方一同湮灭才能起到作用，否则反而会被深渊蚀化包裹…」",
            "nextDialogs": [
              "751491120"
            ]
          },
          "751491120": {
            "id": "751491120",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「只可惜，这座城市被封绝太久…而为了维持稳定，『象拟聚星』不能被随意移动…」",
            "nextDialogs": [
              "751491121"
            ]
          },
          "751491121": {
            "id": "751491121",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「受龙所选者啊…」",
            "nextDialogs": [
              "751491122"
            ]
          },
          "751491122": {
            "id": "751491122",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀？",
            "nextDialogs": [
              "751491123"
            ]
          },
          "751491123": {
            "id": "751491123",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「圣山之心是图兰建立以后，才重新开掘的区域…由最初的一尊秘源龙像看守。」",
            "nextDialogs": [
              "751491124"
            ]
          },
          "751491124": {
            "id": "751491124",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「想要进入圣山之心，就必须获得许可…」",
            "nextDialogs": [
              "751491125"
            ]
          },
          "751491125": {
            "id": "751491125",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「只不过，那只秘源龙像的能源亦受到侵蚀，也得想办法让它重新启动起来…」",
            "nextDialogs": [
              "751491126"
            ]
          },
          "751491126": {
            "id": "751491126",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「它们…」警告，机能受损，即将关闭…「啊，看来这台机体…」",
            "nextDialogs": [
              "751491127"
            ]
          },
          "751491127": {
            "id": "751491127",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，阿玛鲁，那个什么许可，啊呀，你都什么都没说呢！",
            "nextDialogs": [
              "751491128"
            ]
          },
          "751491128": {
            "id": "751491128",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「呵呵…继续前行吧，在那里，会有新的秘源龙仆为你们指引方向…」",
            "nextDialogs": [
              "751491129"
            ]
          },
          "751491129": {
            "id": "751491129",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "喀喀…",
            "nextDialogs": [
              "751491130"
            ]
          },
          "751491130": {
            "id": "751491130",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「这是圣城核心的地图，我将在…恭候，你们的…」",
            "nextDialogs": [
              "751491131"
            ]
          },
          "751491131": {
            "id": "751491131",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，身上的光又消失了…",
            "nextDialogs": [
              "751491132"
            ]
          },
          "751491132": {
            "id": "751491132",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这下这个叫「阿玛鲁」的家伙应该也没有办法进行对话了吧。",
            "nextDialogs": [
              "751491133"
            ]
          },
          "751491133": {
            "id": "751491133",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "……",
            "nextDialogs": [
              "751491134"
            ]
          },
          "751491134": {
            "id": "751491134",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这家伙真是随心所欲，没办法，我们就往前找找看新的秘源龙仆吧…"
          }
        }
      }
    },
    {
      "subId": "7514912",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751490301"
        ],
        "dialogs": {
          "751490301": {
            "id": "751490301",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「我有向你们正式介绍它的名字吗？似乎没有…」",
            "nextDialogs": [
              "751490302"
            ]
          },
          "751490302": {
            "id": "751490302",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「但没关系，欢迎，欢迎来到初始圣城{RUBY#[D]源火之地}图兰。」",
            "nextDialogs": [
              "751490303"
            ]
          },
          "751490303": {
            "id": "751490303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，没想到火山里面，居然是这样的…",
            "nextDialogs": [
              "751490304"
            ]
          },
          "751490304": {
            "id": "751490304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这真的是火山里吗？不会是我们在穿过火山口的时候，被人偷偷送到了别的地方吧？",
            "nextDialogs": [
              "751490305"
            ]
          },
          "751490305": {
            "id": "751490305",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…呀！",
            "nextDialogs": [
              "751490306"
            ]
          },
          "751490306": {
            "id": "751490306",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「这里毫无疑问是圣山之内，不过即使是我…也不知道上一次看到如斯景象是什么时候了…」",
            "nextDialogs": [
              "751490307"
            ]
          },
          "751490307": {
            "id": "751490307",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「啊啊…在光芒重新照亮你时，我竟才发现你已这样朽败啊…」",
            "nextDialogs": [
              "751490308"
            ]
          },
          "751490308": {
            "id": "751490308",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "厄卡特尔？",
            "nextDialogs": [
              "751490309"
            ]
          },
          "751490309": {
            "id": "751490309",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "……",
            "nextDialogs": [
              "751490310"
            ]
          },
          "751490310": {
            "id": "751490310",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔嗯？",
            "nextDialogs": [
              "751490311"
            ]
          },
          "751490311": {
            "id": "751490311",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「哦，抱歉，只是陷入了一小会儿没有必要的感怀罢了…」",
            "nextDialogs": [
              "751490312"
            ]
          },
          "751490312": {
            "id": "751490312",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "介质储能低…即将休眠，请及时替换或连接…储能介质…",
            "nextDialogs": [
              "751490313"
            ]
          },
          "751490313": {
            "id": "751490313",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「哈哈，看来长期『流亡在外』的厄卡特尔并不能撑更久了…」",
            "nextDialogs": [
              "751490314"
            ]
          },
          "751490314": {
            "id": "751490314",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，难道，厄卡特尔要、要死掉了吗？",
            "nextDialogs": [
              "751490315"
            ]
          },
          "751490315": {
            "id": "751490315",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「厄卡特尔，拥有这个名字的家伙早就不在了…长话短说，重启图兰或许会消耗掉许多力量，不能白费，你们需要…」",
            "nextDialogs": [
              "751490316"
            ]
          },
          "751490316": {
            "id": "751490316",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「其他两个『象拟{RUBY#[D]兹兹米特尔}聚星』，破坏其中一个的封印…和另一个」…「才能真正，开启中央的天轴」…",
            "nextDialogs": [
              "751490317"
            ]
          },
          "751490317": {
            "id": "751490317",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「呃…」",
            "nextDialogs": [
              "751490318"
            ]
          },
          "751490318": {
            "id": "751490318",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还好吗？",
            "nextDialogs": [
              "751490319"
            ]
          },
          "751490319": {
            "id": "751490319",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "…「没事，我们还会…再见面的…」",
            "nextDialogs": [
              "751490320"
            ]
          },
          "751490320": {
            "id": "751490320",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「唉…向前吧，受龙所选者…啊，躯体失去生机的痛苦，即使许多年，我也…无法那样适应…」",
            "nextDialogs": [
              "751490321"
            ]
          },
          "751490321": {
            "id": "751490321",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀？",
            "nextDialogs": [
              "751490322"
            ]
          },
          "751490322": {
            "id": "751490322",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "……",
            "nextDialogs": [
              "751490323"
            ]
          },
          "751490323": {
            "id": "751490323",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "围绕在它身边的光消失了…唔，厄卡特尔也变得一动不动的。",
            "nextDialogs": [
              "751490324"
            ]
          },
          "751490324": {
            "id": "751490324",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我还是有点没弄明白，那个说话的人到底是厄卡特尔，还是其实是别的人…？",
            "nextDialogs": [
              "751490327"
            ]
          },
          "751490327": {
            "id": "751490327",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对哦，不过，刚才他说什么，「象拟聚星」，难道就是刚才的大火球？那天轴呢？不知道究竟是什么东西…",
            "nextDialogs": [
              "751490328"
            ]
          },
          "751490328": {
            "id": "751490328",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，我们就先到处看看，找找他说的那些奇怪的东西吧！",
            "nextDialogs": [
              "751490329"
            ]
          },
          "751490329": {
            "id": "751490329",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！"
          }
        }
      }
    },

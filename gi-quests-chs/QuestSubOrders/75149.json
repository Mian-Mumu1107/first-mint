    {
      "subId": "7514904",
      "subQuestName": "继续探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751490401"
        ],
        "dialogs": {
          "751490401": {
            "id": "751490401",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "检测…此处…天轴的道路已受封绝。核心「象拟聚星」已启动…",
            "nextDialogs": [
              "751490402"
            ]
          },
          "751490402": {
            "id": "751490402",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "仍需重新稳定其余「象拟聚星」，以获得重新启封的力量…",
            "nextDialogs": [
              "751490403"
            ]
          },
          "751490403": {
            "id": "751490403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，厄卡特尔？",
            "nextDialogs": [
              "751490404"
            ]
          },
          "751490404": {
            "id": "751490404",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "检测…此处…天轴的道路已受封绝。核心「象拟聚星」已启动…",
            "nextDialogs": [
              "751490405"
            ]
          },
          "751490405": {
            "id": "751490405",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "仍需重新稳定其余「象拟聚星」，以获得重新启封的力量…",
            "nextDialogs": [
              "751490406"
            ]
          },
          "751490406": {
            "id": "751490406",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…",
            "nextDialogs": [
              "751490407"
            ]
          },
          "751490407": {
            "id": "751490407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看上去虽然长得一样，但不是厄卡特尔呢…",

  "subQuests": [
    {
      "subId": "7514917",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751490902"
        ],
        "dialogs": {
          "751490902": {
            "id": "751490902",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "受龙所选者…啊，受龙所选者啊…",
            "nextDialogs": [
              "751490903"
            ]
          },
          "751490903": {
            "id": "751490903",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "穿越亘古之城，前往圣山之心吧。",
            "nextDialogs": [
              "751490904"
            ]
          },
          "751490904": {
            "id": "751490904",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "除却…阴影之大敌，点燃…将熄的冷灰…",
            "nextDialogs": [
              "751490905"
            ]
          },
          "751490905": {
            "id": "751490905",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咳咳…怎么、怎么样？你们有没有事。",
            "nextDialogs": [
              "751490906"
            ]
          },
          "751490906": {
            "id": "751490906",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜…",
            "nextDialogs": [
              "751490907"
            ]
          },
          "751490907": {
            "id": "751490907",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么了，是头有点晕吗？毕竟从那么高的地方掉下来…",
            "nextDialogs": [
              "751490908"
            ]
          },
          "751490908": {
            "id": "751490908",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没有受伤吧？",
            "nextDialogs": [
              "751490909"
            ]
          },
          "751490909": {
            "id": "751490909",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751490910"
            ]
          },
          "751490910": {
            "id": "751490910",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#唔，看来没有受伤，{NICKNAME}你呢…没出什么问题吧！",
            "nextDialogs": [
              "751490912",
              "751490914"
            ]
          },
          "751490912": {
            "id": "751490912",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真是的，什么叫「看上去还挺完整」啦！唉…没有受伤就好。",
            "nextDialogs": [
              "751490915"
            ]
          },
          "751490915": {
            "id": "751490915",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，没想到火山口下面真的有这么大的空间，不过周围怎么黑漆漆的…"
          },
          "751490914": {
            "id": "751490914",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好嘞！还有开玩笑的精神，看来很健康！"
          }
        }
      }
    },
    {
      "subId": "7514906",
      "subQuestName": "跟随亮起的道路",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751490601"
        ],
        "dialogs": {
          "751490601": {
            "id": "751490601",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔！",
            "nextDialogs": [
              "751490602"
            ]
          },
          "751490602": {
            "id": "751490602",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "喀喀…",
            "nextDialogs": [
              "751490603"
            ]
          },
          "751490603": {
            "id": "751490603",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「看来你们终于让两个『象拟聚星』恢复运转…很快，这里的燃素浓度应该会提升到能够启动交流机关的程度…」",
            "nextDialogs": [
              "751490604"
            ]
          },
          "751490604": {
            "id": "751490604",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「不过在那之前，还需等待一小会儿，作为人类，你们做得已经很不错了。」",
            "nextDialogs": [
              "751490607"
            ]
          },
          "751490607": {
            "id": "751490607",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「并不是，厄卡特尔的存在已经全部消亡了…就在不久之前。虽然名字在此地其实没什么意义，不过，这副身躯的名字…」",
            "nextDialogs": [
              "751490608"
            ]
          },
          "751490608": {
            "id": "751490608",
            "speakerId": 1002,
            "speakerName": "秘源龙仆",
            "text": "「『至高无上的阿玛鲁圣尊』，唉，这是留给这具身躯的名字，名字原本的主人是个愚蠢的家伙。」",
            "nextDialogs": [
              "751490609"
            ]
          },
          "751490609": {
            "id": "751490609",
            "speakerId": 1003,
            "speakerName": "「阿玛鲁」",
            "text": "「但你们可以直接叫『阿玛鲁』。」",
            "nextDialogs": [
              "751490610"
            ]
          },
          "751490610": {
            "id": "751490610",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "阿玛鲁？",
            "nextDialogs": [
              "751490611"
            ]
          },
          "751490611": {
            "id": "751490611",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔嗯？",
            "nextDialogs": [
              "751490612"
            ]
          },
          "751490612": {
            "id": "751490612",
            "speakerId": 1003,
            "speakerName": "「阿玛鲁」",
            "text": "「他自大，说话无遮无拦，没有脑子，惹人生厌…但是在那场战争中，他守在受封绝的天轴前鏖战至死…」",
            "nextDialogs": [
              "751490613"
            ]
          },
          "751490613": {
            "id": "751490613",
            "speakerId": 1003,
            "speakerName": "「阿玛鲁」",
            "text": "「就在这里，所以我把他驱使的秘源龙仆也放在了这里…或许它很乐意代替它的主人在这里，看守天轴。」",
            "nextDialogs": [
              "751490614"
            ]
          },
          "751490614": {
            "id": "751490614",
            "speakerId": 1003,
            "speakerName": "「阿玛鲁」",
            "text": "检测燃素浓度抬升…回路检查完毕…喀喀…",
            "nextDialogs": [
              "751490615"
            ]
          },
          "751490615": {
            "id": "751490615",
            "speakerId": 1003,
            "speakerName": "「阿玛鲁」",
            "text": "升降井——天轴，已重新启动。",
            "nextDialogs": [
              "751490616"
            ]
          },
          "751490616": {
            "id": "751490616",
            "speakerId": 1003,
            "speakerName": "「阿玛鲁」",
            "text": "「看来差不多了，请往更深处前进吧。」"
          }
        }
      }
    },
    {
      "subId": "7514901",
      "subQuestName": "与奇怪的机关对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751491001"
        ],
        "dialogs": {
          "751491001": {
            "id": "751491001",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#咦，{REALNAME[ID(2)|SHOWHOST(true)]}，怎么了，你发现什么东西了吗？",
            "nextDialogs": [
              "751491002"
            ]
          },
          "751491002": {
            "id": "751491002",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呼嗯！",
            "nextDialogs": [
              "751491003"
            ]
          },
          "751491003": {
            "id": "751491003",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，这个雕像，不就是之前被绒翼龙抓着的雕像嘛，居然也一起掉下来了…",
            "nextDialogs": [
              "751491004"
            ]
          },
          "751491004": {
            "id": "751491004",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#看上去就像是一个团起来的…大耳朵{REALNAME[ID(2)|SHOWHOST(true)]}。",
            "nextDialogs": [
              "751491005"
            ]
          },
          "751491005": {
            "id": "751491005",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔嗯！",
            "nextDialogs": [
              "751491006"
            ]
          },
          "751491006": {
            "id": "751491006",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是嘛，你觉得不像啊，我觉得还是挺像的呢…",
            "nextDialogs": [
              "751491007"
            ]
          },
          "751491007": {
            "id": "751491007",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊…它动起来了！",
            "nextDialogs": [
              "751491008"
            ]
          },
          "751491008": {
            "id": "751491008",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "喀…喀…",
            "nextDialogs": [
              "751491009"
            ]
          },
          "751491009": {
            "id": "751491009",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "自我检试运行中…关节处有些许积灰…存储介质激活，话语…远程提取…介入允许…喀喀…性格模块修正…",
            "nextDialogs": [
              "751491010"
            ]
          },
          "751491010": {
            "id": "751491010",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "751491011"
            ]
          },
          "751491011": {
            "id": "751491011",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀？",
            "nextDialogs": [
              "751491012"
            ]
          },
          "751491012": {
            "id": "751491012",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来不是雕像，而是什么机关吗…仔细一看，确实和秘源机关长得有点像，它身上飘着的奇怪的光，总觉得在哪看到过…",
            "nextDialogs": [
              "751491013"
            ]
          },
          "751491013": {
            "id": "751491013",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，怎么了，怎么不动了？",
            "nextDialogs": [
              "751491014"
            ]
          },
          "751491014": {
            "id": "751491014",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "「呜哇！」",
            "nextDialogs": [
              "751491015"
            ]
          },
          "751491015": {
            "id": "751491015",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇！",
            "nextDialogs": [
              "751491016"
            ]
          },
          "751491016": {
            "id": "751491016",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "「发声模块看来没有问题，好了，尊贵的客人们，我已经在此等候你们许久…怎么了？」",
            "nextDialogs": [
              "751491017"
            ]
          },
          "751491017": {
            "id": "751491017",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么突然发出这么大的声音，真是吓人一跳…",
            "nextDialogs": [
              "751491018"
            ]
          },
          "751491018": {
            "id": "751491018",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "「那真是太好了，这样的登场才能留下点印象，不然我还担心你们会觉得自己受了冷落呢…」",
            "nextDialogs": [
              "751491019"
            ]
          },
          "751491019": {
            "id": "751491019",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，你是？",
            "nextDialogs": [
              "751491020"
            ]
          },
          "751491020": {
            "id": "751491020",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "「你问我是谁？嗯，这副身躯的名字叫厄卡特尔，你可以这样称呼，不过，名字在此地没有太多意义…」",
            "nextDialogs": [
              "751491021"
            ]
          },
          "751491021": {
            "id": "751491021",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "个体识别的称呼，变更请求是…通过记录…在那场战争后的一百五十年…变更名为，战亡名录——厄卡特尔…",
            "nextDialogs": [
              "751491022"
            ]
          },
          "751491022": {
            "id": "751491022",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「没错，自那以后，就叫厄卡特尔…」",
            "nextDialogs": [
              "751491023"
            ]
          },
          "751491023": {
            "id": "751491023",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751491024"
            ]
          },
          "751491024": {
            "id": "751491024",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「对，是我，我是『呼唤』你到来者，来吧，到圣山之心…在一切还为时未晚之前。」",
            "nextDialogs": [
              "751491025"
            ]
          },
          "751491025": {
            "id": "751491025",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「不过还不用着急，先让厄卡特尔为你开辟眼前的一点点黑暗…我知道你们心中还有疑惑，但先随我来吧。」"
          }
        }
      }
    },
    {
      "subId": "7514902",
      "subQuestName": "向前探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751490201"
        ],
        "dialogs": {
          "751490201": {
            "id": "751490201",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「我得事先说明，这里原先没有那么暗…虽然，这里毫无疑问是火山的『内部』…」",
            "nextDialogs": [
              "751490202"
            ]
          },
          "751490202": {
            "id": "751490202",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「只不过在那场战争结束之后，整座城市被毁灭殆尽，那之后，作为巨大机构的所有功能都不得不停摆…」",
            "nextDialogs": [
              "751490203"
            ]
          },
          "751490203": {
            "id": "751490203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "战争？",
            "nextDialogs": [
              "751490204"
            ]
          },
          "751490204": {
            "id": "751490204",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「对，是残存的龙裔与人类的战争，也是令原初执掌火焰的主人死去的战争…」",
            "nextDialogs": [
              "751490205"
            ]
          },
          "751490205": {
            "id": "751490205",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「这座城的主人已经死了，唯留这座城市依然苟活…不过也说不定，也许这座城市其实也早就死了。」",
            "nextDialogs": [
              "751490206"
            ]
          },
          "751490206": {
            "id": "751490206",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「…又或者很多东西曾经存在，其实只不过是一种错觉。」",
            "nextDialogs": [
              "751490207"
            ]
          },
          "751490207": {
            "id": "751490207",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔嗯？",
            "nextDialogs": [
              "751490208"
            ]
          },
          "751490208": {
            "id": "751490208",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「我们各取所需，小家伙，你有来的需要，而我又希望依靠你的力量解决一些问题…」",
            "nextDialogs": [
              "751490209"
            ]
          },
          "751490209": {
            "id": "751490209",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「你们必须得到圣山之心去…但可惜因为之前的战争，整座圣山的力量也在战争中被封绝。」",
            "nextDialogs": [
              "751490210"
            ]
          },
          "751490210": {
            "id": "751490210",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「尽管那封绝之力在我看来犹如只困得住稚童的细索，但按照誓约，只有『人』才能够将它们开启…」",
            "nextDialogs": [
              "751490211"
            ]
          },
          "751490211": {
            "id": "751490211",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「有趣的事是，用了这样的方法侵入圣山的可怜的孩子，最后可以说是毁于他人几乎相同的手段。」",
            "nextDialogs": [
              "751490212"
            ]
          },
          "751490212": {
            "id": "751490212",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「呵呵，总是如此啊…就像暴君的追随者们被英雄驱逐，经历漫长的流浪，其后裔终结了另一个国度的暴君…」",
            "nextDialogs": [
              "751490213"
            ]
          },
          "751490213": {
            "id": "751490213",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「世事如同被人安排的戏码那般，因果流转，恩仇覆反，在支离破碎的历史中轮番上演…」",
            "nextDialogs": [
              "751490214"
            ]
          },
          "751490214": {
            "id": "751490214",
            "speakerId": 1005,
            "speakerName": "「厄卡特尔」",
            "text": "「说远了，来吧…启动它，让这座垂死的城再挣扎一番吧。现在，此世唯有你有这样的资格。」"
          }
        }
      }
    },

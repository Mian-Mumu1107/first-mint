      }
    },
    {
      "subId": "4121102",
      "subQuestName": "前往调查地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412110201"
        ],
        "dialogs": {
          "412110201": {
            "id": "412110201",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "居然是愚人众？而且还选在盗宝团的营地里袭击我们…莫非他们是跟着我们来的？",
            "nextDialogs": [
              "412110202"
            ]
          },
          "412110202": {
            "id": "412110202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是，为什么要跟着我们呢？",
            "nextDialogs": [
              "412110203"
            ]
          },
          "412110203": {
            "id": "412110203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！该不会是你背着我去犯了什么事吧！",
            "nextDialogs": [
              "412110204"
            ]
          },
          "412110204": {
            "id": "412110204",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "你犯事了吗？",
            "nextDialogs": [
              "412110207"
            ]
          },
          "412110207": {
            "id": "412110207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…那就不是我们的错了…",
            "nextDialogs": [
              "412110208"
            ]
          },
          "412110208": {
            "id": "412110208",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我猜愚人众也在找这把剑。",
            "nextDialogs": [
              "412110209"
            ]
          },
          "412110209": {
            "id": "412110209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎哎？可你不是把这把剑藏得很好吗，愚人众怎么会知道它的存在呢？",
            "nextDialogs": [
              "412110210"
            ]
          },
          "412110210": {
            "id": "412110210",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "或许是你在雪山战斗的样子被他们看到了。",
            "nextDialogs": [
              "412110211"
            ]
          },
          "412110211": {
            "id": "412110211",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "如果愚人众的人眼光够好，就会发现这把剑的与众不同之处。",
            "nextDialogs": [
              "412110212"
            ]
          },
          "412110212": {
            "id": "412110212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "愚人众怎么什么都要啊！",
            "nextDialogs": [
              "412110213"
            ]
          },
          "412110213": {
            "id": "412110213",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这可不是什么都要哦。",
            "nextDialogs": [
              "412110214"
            ]
          },
          "412110214": {
            "id": "412110214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我记得我有听说过相关信息。",
            "nextDialogs": [
              "412110215"
            ]
          },
          "412110215": {
            "id": "412110215",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "愚人众在搜集与神有关的东西，你们应该已经知道了。",
            "nextDialogs": [
              "412110216"
            ]
          },
          "412110216": {
            "id": "412110216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呀，这么一说，确实听迪卢克老爷提起过呢。",
            "nextDialogs": [
              "412110217"
            ]
          },
          "412110217": {
            "id": "412110217",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "杜林是风神的仇敌，具有相当的力量。",
            "nextDialogs": [
              "412110218"
            ]
          },
          "412110218": {
            "id": "412110218",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "说它是「能匹敌神的存在」也好，「与神有关的存在」也好，都不为过。",
            "nextDialogs": [
              "412110219"
            ]
          },
          "412110219": {
            "id": "412110219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难怪这把剑会被愚人众当成目标。",
            "nextDialogs": [
              "412110220"
            ]
          },
          "412110220": {
            "id": "412110220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样啊…",
            "nextDialogs": [
              "412110221"
            ]
          },
          "412110221": {
            "id": "412110221",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "不久前来附近写生，我有个新发现。",
            "nextDialogs": [
              "412110222"
            ]
          },
          "412110222": {
            "id": "412110222",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "从这里向前，有一处较为特殊的土地。它的地脉流向与别处都不一样。",
            "nextDialogs": [
              "412110223"
            ]
          },
          "412110223": {
            "id": "412110223",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "周边的怪物被它吸引，又受它影响，久而久之，身体素质会比同类更强。",
            "nextDialogs": [
              "412110224"
            ]
          },
          "412110224": {
            "id": "412110224",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有这种好事？",
            "nextDialogs": [
              "412110225"
            ]
          },
          "412110225": {
            "id": "412110225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们是要帮助这把剑成长对吧？来都来了，不如去试试手！",
            "nextDialogs": [
              "412110226"
            ]
          },
          "412110226": {
            "id": "412110226",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "没错。顺便还能观察不同敌人对这把剑造成的影响。"
          }
        }
      }
    },
    {
      "subId": "4121103",
      "subQuestName": "与阿贝多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412110401"
        ],
        "dialogs": {
          "412110401": {
            "id": "412110401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实有大量人类活动的痕迹。",
            "nextDialogs": [
              "412110402"
            ]
          },
          "412110402": {
            "id": "412110402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且，看起来还不止一个人。",
            "nextDialogs": [
              "412110403"
            ]
          },
          "412110403": {
            "id": "412110403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看这些线索，像是盗宝团。",
            "nextDialogs": [
              "412110404"
            ]
          },
          "412110404": {
            "id": "412110404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "盗宝团真的在雪山有营地呀…是来偷窃抢劫的吗？",
            "nextDialogs": [
              "412110405"
            ]
          },
          "412110405": {
            "id": "412110405",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "山上有落单的冒险家，打劫起来很方便。",
            "nextDialogs": [
              "412110406"
            ]
          },
          "412110406": {
            "id": "412110406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是弱肉强食的雪山呀。",
            "nextDialogs": [
              "412110407"
            ]
          },
          "412110407": {
            "id": "412110407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过他们偷了这么多东西，却还是一贫如洗，真够寒碜的…",
            "nextDialogs": [
              "412110410"
            ]
          },
          "412110410": {
            "id": "412110410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，叫我们小偷的人，我才不会同情呢！",
            "nextDialogs": [
              "412110411"
            ]
          },
          "412110411": {
            "id": "412110411",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "谁！竟敢在我们的营地里撒野！",
            "nextDialogs": [
              "412110412"
            ]
          },
          "412110412": {
            "id": "412110412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呀，被发现了！"
          }
        }
      }
    },

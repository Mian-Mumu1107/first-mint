  "subQuests": [
    {
      "subId": "4121101",
      "subQuestName": "与阿贝多会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412110101"
        ],
        "dialogs": {
          "412110101": {
            "id": "412110101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多——！",
            "nextDialogs": [
              "412110102"
            ]
          },
          "412110102": {
            "id": "412110102",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "回来啦。",
            "nextDialogs": [
              "412110103"
            ]
          },
          "412110103": {
            "id": "412110103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们可是努力了好久，快看看剑的进展如何！",
            "nextDialogs": [
              "412110104"
            ]
          },
          "412110104": {
            "id": "412110104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你看。",
            "nextDialogs": [
              "412110105"
            ]
          },
          "412110105": {
            "id": "412110105",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "唔…果然。",
            "nextDialogs": [
              "412110106"
            ]
          },
          "412110106": {
            "id": "412110106",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "和我想的一样，这把剑会随着战斗成长。",
            "nextDialogs": [
              "412110107"
            ]
          },
          "412110107": {
            "id": "412110107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它又不是人！",
            "nextDialogs": [
              "412110108"
            ]
          },
          "412110108": {
            "id": "412110108",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "所以这就是它的特殊之处了。",
            "nextDialogs": [
              "412110109"
            ]
          },
          "412110109": {
            "id": "412110109",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "对了，先说一件比较重要的事。",
            "nextDialogs": [
              "412110110"
            ]
          },
          "412110110": {
            "id": "412110110",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我调查了附近的雪地，发现有不同寻常的痕迹。",
            "nextDialogs": [
              "412110111"
            ]
          },
          "412110111": {
            "id": "412110111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呀，不会是小偷吧！",
            "nextDialogs": [
              "412110114"
            ]
          },
          "412110114": {
            "id": "412110114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也对哦。",
            "nextDialogs": [
              "412110115"
            ]
          },
          "412110115": {
            "id": "412110115",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我认为那些痕迹并不寻常，有调查的必要。",
            "nextDialogs": [
              "412110116"
            ]
          },
          "412110116": {
            "id": "412110116",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "是小偷，还是别的东西，调查完自然会有结论。"
          }
        }
      }
    },
    {

    {
      "subId": "4121112",
      "subQuestName": "与阿贝多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "412110301"
        ],
        "dialogs": {
          "412110301": {
            "id": "412110301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有什么感觉吗？",
            "nextDialogs": [
              "412110304"
            ]
          },
          "412110304": {
            "id": "412110304",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我有一个推测。",
            "nextDialogs": [
              "412110305"
            ]
          },
          "412110305": {
            "id": "412110305",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这把剑从敌人身上吸收力量后，会与这座雪山深处暗藏的杜林亡骸发生共鸣。",
            "nextDialogs": [
              "412110306"
            ]
          },
          "412110306": {
            "id": "412110306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…好像很厉害呀！",
            "nextDialogs": [
              "412110307"
            ]
          },
          "412110307": {
            "id": "412110307",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "如果这一猜想成立，那么这座雪山上的怪物也可能与杜林的亡骸共鸣。",
            "nextDialogs": [
              "412110308"
            ]
          },
          "412110308": {
            "id": "412110308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么会跟龙的亡骸共鸣呢？",
            "nextDialogs": [
              "412110309"
            ]
          },
          "412110309": {
            "id": "412110309",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "恐怕与这一带怪物的力量来源有关。",
            "nextDialogs": [
              "412110310"
            ]
          },
          "412110310": {
            "id": "412110310",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "杜林不是一般的怪物。哪怕在它已经死亡的现在，整座雪山也依然受到它亡骸的影响。",
            "nextDialogs": [
              "412110311"
            ]
          },
          "412110311": {
            "id": "412110311",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "神秘的龙之力…或许也是某种诅咒。",
            "nextDialogs": [
              "412110312"
            ]
          },
          "412110312": {
            "id": "412110312",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "信息还是不够。想了解更多，就需要更多数据。这也正是我找你的原因。",
            "nextDialogs": [
              "412110313"
            ]
          },
          "412110313": {
            "id": "412110313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没想到，听故事也成了体力活呢…",
            "nextDialogs": [
              "412110314"
            ]
          },
          "412110314": {
            "id": "412110314",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我有些研究工作要收尾，得和你们分开行动了。之后在断桥附近会合吧。"
          }
        }
      }
    },

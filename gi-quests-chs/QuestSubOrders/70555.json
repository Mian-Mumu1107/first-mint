        ],
        "dialogs": {
          "705550101": {
            "id": "705550101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，收工啦？",
            "nextDialogs": [
              "705550102"
            ]
          },
          "705550102": {
            "id": "705550102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听说，在我跟着格兰菲狄小姐捣鼓外送订单的时候，你把事情办得超漂亮嘛！",
            "nextDialogs": [
              "705550105"
            ]
          },
          "705550105": {
            "id": "705550105",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…总之，荣誉骑士是目前蒙德最有才华的调饮师之一。",
            "nextDialogs": [
              "705550106"
            ]
          },
          "705550106": {
            "id": "705550106",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "#考虑到从业时间，我觉得，{M#他}{F#她}甚至有潜力追上猫尾酒馆的那位小小传说。",
            "nextDialogs": [
              "705550107"
            ]
          },
          "705550107": {
            "id": "705550107",
            "speakerId": 30970,
            "speakerName": "格兰菲狄",
            "text": "我无条件支持这个决策，大团长，这段时间实在有劳荣誉骑士了。",
            "nextDialogs": [
              "705550108"
            ]
          },
          "705550108": {
            "id": "705550108",
            "speakerId": 30970,
            "speakerName": "格兰菲狄",
            "text": "饮品小站还会营业一段时间，确保做好迎接远征队员的万全准备。找到合适的店面后，还会试点常态开放…",
            "nextDialogs": [
              "705550109"
            ]
          },
          "705550109": {
            "id": "705550109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好欸！骑士团的大家都要有美味饮料喝了！",
            "nextDialogs": [
              "705550110"
            ]
          },
          "705550110": {
            "id": "705550110",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "不愧是赫塔的亲传弟子，格兰菲狄考虑得很周到！",
            "nextDialogs": [
              "705550111"
            ]
          },
          "705550111": {
            "id": "705550111",
            "speakerId": 30970,
            "speakerName": "格兰菲狄",
            "text": "还有，荣誉骑士开发的新品特调…如果您不介意，要留下配方，将它们作为正式饮品，加入小站的清单吗？"
          }
        }
      }
    }
  ]
}
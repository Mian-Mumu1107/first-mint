  },
  "subQuests": [
    {
      "subId": "4112001",
      "subQuestName": "与葛瑞丝修女对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411200101"
        ],
        "dialogs": {
          "411200101": {
            "id": "411200101",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "希望所有人都平安无事…",
            "nextDialogs": [
              "411200102"
            ]
          },
          "411200102": {
            "id": "411200102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您在担心什么吗？",
            "nextDialogs": [
              "411200103"
            ]
          },
          "411200103": {
            "id": "411200103",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "是旅行者啊。那些从天而降的陨石，您应该注意到了吧。",
            "nextDialogs": [
              "411200104"
            ]
          },
          "411200104": {
            "id": "411200104",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "虽然很幸运没有陨石砸到蒙德城里面来，但是野外已经乱成了一片。我很担心那些还逗留在野外的人…",
            "nextDialogs": [
              "411200105"
            ]
          },
          "411200105": {
            "id": "411200105",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "旅行者，能请你帮忙去警告一下那些还逗留在野外的人吗？",
            "nextDialogs": [
              "411200106"
            ]
          },
          "411200106": {
            "id": "411200106",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "如果他们愿意的话，就请他们到蒙德城里来避难吧。",
            "nextDialogs": [
              "411200108",
              "411200110"
            ]
          },
          "411200108": {
            "id": "411200108",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "那就拜托你了。",
            "nextDialogs": [
              "411200112"
            ]
          },
          "411200112": {
            "id": "411200112",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "您可以先去找琳小姐，问问她知不知道还有哪些人逗留在野外。",
            "nextDialogs": [
              "411200113"
            ]
          },
          "411200113": {
            "id": "411200113",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "然后，也请试着说服她进蒙德城避难。",
            "nextDialogs": [
              "411200114"
            ]
          },
          "411200114": {
            "id": "411200114",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "现在可不是她接着挑战「野外生存」的时候了。"
          },
          "411200110": {
            "id": "411200110",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "也许只是运气好吧。但不管怎么说，蒙德城是目前来看比较安全的地方了。",
            "nextDialogs": [
              "411200111"
            ]
          },
          "411200111": {
            "id": "411200111",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "至少…比呆在野外安全多了，您说对吗？"
          }
        }
      }
    },
    {
      "subId": "4112002",
      "subQuestName": "与琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411200201"
        ],
        "dialogs": {
          "411200201": {
            "id": "411200201",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "在这种情况下进行「野外生存」…好像还挺有挑战性的。",
            "nextDialogs": [
              "411200202"
            ]
          },
          "411200202": {
            "id": "411200202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请进蒙德城避难。",
            "nextDialogs": [
              "411200203"
            ]
          },
          "411200203": {
            "id": "411200203",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "避难？哎呀，不用担心我，我一直在留意着周围呢，不会有危险的。",
            "nextDialogs": [
              "411200204"
            ]
          },
          "411200204": {
            "id": "411200204",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "不过，你怎么还在外面逛来逛去，还是快回蒙德城吧，要是被陨石砸到可就不好了。",
            "nextDialogs": [
              "411200205"
            ]
          },
          "411200205": {
            "id": "411200205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于在野外逗留的人…",
            "nextDialogs": [
              "411200206"
            ]
          },
          "411200206": {
            "id": "411200206",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "在野外逗留的人？那可有很多啊，你问这个做什么？",
            "nextDialogs": [
              "411200208",
              "411200212"
            ]
          },
          "411200208": {
            "id": "411200208",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "是这样啊…这么一说，协会里好像也发布过相关的委托，我也去周围通知了不少人。",
            "nextDialogs": [
              "411200209"
            ]
          },
          "411200209": {
            "id": "411200209",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "离蒙德城比较近的人，应该都已经进城里避难了。",
            "nextDialogs": [
              "411200210"
            ]
          },
          "411200210": {
            "id": "411200210",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "但因为人手不足，临时也召集不到多少冒险家，野外应该还有很多人没被通知到吧，你肯帮忙再好不过了。",
            "nextDialogs": [
              "411200215"
            ]
          },
          "411200215": {
            "id": "411200215",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "我想想啊，还逗留在野外的人…",
            "nextDialogs": [
              "411200216"
            ]
          },
          "411200216": {
            "id": "411200216",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "啊！对了，帕琪小姐和杜兰先生一直呆在千风神殿那边，我和他们说过了，但他们还是坚持在那里研究。",
            "nextDialogs": [
              "411200217"
            ]
          },
          "411200217": {
            "id": "411200217",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "还有芬德修女，之前她一直呆在望风角附近，协会里也让我去找过她几次，但我去了好几次都没找到她…",
            "nextDialogs": [
              "411200218"
            ]
          },
          "411200218": {
            "id": "411200218",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "我只记得这些了，你就先去告诉他们进蒙德城避难的事情吧。",
            "nextDialogs": [
              "411200219"
            ]
          },
          "411200219": {
            "id": "411200219",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "至于我嘛，再准备一点食物和必需品之后，我也会去周围转一圈，尽量通知更多人进城避难的。",
            "nextDialogs": [
              "411200220"
            ]
          },
          "411200220": {
            "id": "411200220",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "希望他们别跑到太偏远的地方去，不然就算找到了，回来也得大费一番周折吧…"
          },
          "411200212": {
            "id": "411200212",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "葛瑞丝修女？是她啊…其实协会里也发布过相关的委托，我也去周围通知了不少人。",
            "nextDialogs": [
              "411200213"
            ]
          },
          "411200213": {
            "id": "411200213",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "离蒙德城比较近的人，应该都已经进城里避难了。",
            "nextDialogs": [
              "411200214"
            ]
          },
          "411200214": {
            "id": "411200214",
            "speakerId": 1001,
            "speakerName": "琳",
            "text": "但因为人手不足，临时也召集不到多少冒险家，野外应该还有很多人没被通知到吧，你肯帮忙再好不过了。"
          }
        }
      }
    },
    {
      "subId": "4112003",
      "subQuestName": "与杜兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411200301"
        ],
        "dialogs": {
          "411200301": {
            "id": "411200301",
            "speakerId": 1002,
            "speakerName": "杜兰",
            "text": "现在可不是研究的时候，我们得快点去避难才行。",
            "nextDialogs": [
              "411200302"
            ]
          },
          "411200302": {
            "id": "411200302",
            "speakerId": 1003,
            "speakerName": "好奇的帕琪",
            "text": "我说过好几次了，我绝不会放过这次机会。",
            "nextDialogs": [
              "411200303"
            ]
          },
          "411200303": {
            "id": "411200303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请进蒙德城去避难。",
            "nextDialogs": [
              "411200304"
            ]
          },
          "411200304": {
            "id": "411200304",
            "speakerId": 1003,
            "speakerName": "好奇的帕琪",
            "text": "怎么又来了？现在可不是避难的时候，这些天降的陨石，说不定正是我们深入千风神殿的好机会。",
            "nextDialogs": [
              "411200305"
            ]
          },
          "411200305": {
            "id": "411200305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "深入千风神殿？",
            "nextDialogs": [
              "411200306"
            ]
          },
          "411200306": {
            "id": "411200306",
            "speakerId": 1002,
            "speakerName": "杜兰",
            "text": "帕琪说，也许陨石会砸到千风神殿，如果底下有内殿…或者其他什么的话，我们就可以顺着陨石砸开的路深入了。",
            "nextDialogs": [
              "411200307"
            ]
          },
          "411200307": {
            "id": "411200307",
            "speakerId": 1002,
            "speakerName": "杜兰",
            "text": "但是这也太异想天开了，如果陨石砸过来的话，我们俩逃都逃不开。",
            "nextDialogs": [
              "411200308"
            ]
          },
          "411200308": {
            "id": "411200308",
            "speakerId": 1002,
            "speakerName": "杜兰",
            "text": "我们还是去避难吧，如果陨石真的砸进了千风神殿，还砸出了条路，那我们之后再来探索不也一样吗？",
            "nextDialogs": [
              "411200309"
            ]
          },
          "411200309": {
            "id": "411200309",
            "speakerId": 1003,
            "speakerName": "好奇的帕琪",
            "text": "要是被人捷足先登了怎么办？要回去你自己回去，我要在这里等着。",
            "nextDialogs": [
              "411200310"
            ]
          },
          "411200310": {
            "id": "411200310",
            "speakerId": 1002,
            "speakerName": "杜兰",
            "text": "这…好吧，旅行者，不好意思，我们俩还得在这呆一段时间。",
            "nextDialogs": [
              "411200311"
            ]
          },
          "411200311": {
            "id": "411200311",
            "speakerId": 1002,
            "speakerName": "杜兰",
            "text": "别担心，如果真的有危险…我，我会处理好的。",
            "nextDialogs": [
              "411200312"
            ]
          },
          "411200312": {
            "id": "411200312",
            "speakerId": 1002,
            "speakerName": "杜兰",
            "text": "对了，之前有个叫舒特的人路过了这里，一副很害怕的样子…",
            "nextDialogs": [
              "411200313"
            ]
          },
          "411200313": {
            "id": "411200313",
            "speakerId": 1002,
            "speakerName": "杜兰",
            "text": "他找我要了点水喝之后，就说自己要回蒙德城，飞快地跑掉了。",
            "nextDialogs": [
              "411200314"
            ]
          },
          "411200314": {
            "id": "411200314",
            "speakerId": 1002,
            "speakerName": "杜兰",
            "text": "但他跑的路却又不是往蒙德城，而是往望风角的…",
            "nextDialogs": [
              "411200315"
            ]
          },
          "411200315": {
            "id": "411200315",
            "speakerId": 1002,
            "speakerName": "杜兰",
            "text": "我想…那家伙不会是因为太害怕，连路都记错了吧。",
            "nextDialogs": [
              "411200316"
            ]
          },
          "411200316": {
            "id": "411200316",
            "speakerId": 1002,
            "speakerName": "杜兰",
            "text": "旅行者，你先去望风角附近找找他吧，如果他遇到魔物就糟糕了。",
            "nextDialogs": [
              "411200317"
            ]
          },
          "411200317": {
            "id": "411200317",
            "speakerId": 1002,
            "speakerName": "杜兰",
            "text": "我会在这里陪着帕琪，如果真有什么事发生…呃，我会处理好的。"
          }
        }
      }
    },
    {
      "subId": "4112008",
      "subQuestName": "找到害怕的舒特",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411200801"
        ],
        "dialogs": {
          "411200801": {
            "id": "411200801",
            "speakerId": 1004,
            "speakerName": "害怕的舒特",
            "text": "呜哇！你…啊…不是魔物啊…",
            "nextDialogs": [
              "411200802"
            ]
          },
          "411200802": {
            "id": "411200802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请进蒙德城去避难。",
            "nextDialogs": [
              "411200803"
            ]
          },
          "411200803": {
            "id": "411200803",
            "speakerId": 1004,
            "speakerName": "害怕的舒特",
            "text": "我…我知道！我也是来通知其他人去避难的，只不过多走了点路而已。",
            "nextDialogs": [
              "411200804"
            ]
          },
          "411200804": {
            "id": "411200804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你躲在这做什么…",
            "nextDialogs": [
              "411200805"
            ]
          },
          "411200805": {
            "id": "411200805",
            "speakerId": 1004,
            "speakerName": "害怕的舒特",
            "text": "我…我在这休息，不行吗？你别说我了，赶紧回蒙德城避难去吧。",
            "nextDialogs": [
              "411200806"
            ]
          },
          "411200806": {
            "id": "411200806",
            "speakerId": 1004,
            "speakerName": "害怕的舒特",
            "text": "又是陨石又是魔物…现在还呆在野外的人，肯定脑子不好使…",
            "nextDialogs": [
              "411200807"
            ]
          },
          "411200807": {
            "id": "411200807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有其他呆在野外的人吗？",
            "nextDialogs": [
              "411200808"
            ]
          },
          "411200808": {
            "id": "411200808",
            "speakerId": 1004,
            "speakerName": "害怕的舒特",
            "text": "我本来是要去找芬德修女，通知她进蒙德城避难的…就是一直呆在望风角附近的那位修女。",
            "nextDialogs": [
              "411200809"
            ]
          },
          "411200809": {
            "id": "411200809",
            "speakerId": 1004,
            "speakerName": "害怕的舒特",
            "text": "不过我找遍了望风角也没找到芬德修女，然后我就去别的地方跑了一圈，想要再找找…",
            "nextDialogs": [
              "411200810"
            ]
          },
          "411200810": {
            "id": "411200810",
            "speakerId": 1004,
            "speakerName": "害怕的舒特",
            "text": "结果运气不好，反而被一群发了疯的魔物发现了，我好不容易才甩掉了它们。",
            "nextDialogs": [
              "411200811"
            ]
          },
          "411200811": {
            "id": "411200811",
            "speakerId": 1004,
            "speakerName": "害怕的舒特",
            "text": "但我转来转去，又转回望风角了，而且还是没找到芬德修女。",
            "nextDialogs": [
              "411200812"
            ]
          },
          "411200812": {
            "id": "411200812",
            "speakerId": 1004,
            "speakerName": "害怕的舒特",
            "text": "唉，希望那位修女真的是已经回蒙德城了…",
            "nextDialogs": [
              "411200813"
            ]
          },
          "411200813": {
            "id": "411200813",
            "speakerId": 1004,
            "speakerName": "害怕的舒特",
            "text": "好了，我要先回蒙德城了，你也快点回去吧，现在可不是在野外乱逛的时候。"
          }
        }
      }
    },
    {
      "subId": "4112004",
      "subQuestName": "与芬德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411200401"
        ],
        "dialogs": {
          "411200401": {
            "id": "411200401",
            "speakerId": 1005,
            "speakerName": "芬德",
            "text": "咦？旅行者，您来这里做什么？",
            "nextDialogs": [
              "411200402"
            ]
          },
          "411200402": {
            "id": "411200402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您到底去哪了？",
            "nextDialogs": [
              "411200403"
            ]
          },
          "411200403": {
            "id": "411200403",
            "speakerId": 1005,
            "speakerName": "芬德",
            "text": "抱歉，我一直在四处走动观察海面，确实有些难找…您找我有什么事吗？",
            "nextDialogs": [
              "411200404"
            ]
          },
          "411200404": {
            "id": "411200404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请去蒙德城避难。",
            "nextDialogs": [
              "411200405"
            ]
          },
          "411200405": {
            "id": "411200405",
            "speakerId": 1005,
            "speakerName": "芬德",
            "text": "避难？哦，您说的是那些陨石啊，我知道，但是…",
            "nextDialogs": [
              "411200406"
            ]
          },
          "411200406": {
            "id": "411200406",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "小，小心！小心周围！有魔物围上来了！"
          }
        }
      }
    },
    {
      "subId": "4112005",

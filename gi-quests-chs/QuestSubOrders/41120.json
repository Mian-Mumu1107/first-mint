            "id": "411205301",
            "speakerId": 1002,
            "speakerName": "杜兰",
            "text": "不如我们还是先去避难吧，等安全一点再来研究。",
            "nextDialogs": [
              "411205302"
            ]
          },
          "411205302": {
            "id": "411205302",
            "speakerId": 1003,
            "speakerName": "好奇的帕琪",
            "text": "我都说了，要回去你自己回去，我可不会让人家捷足先登。"
          }
        }
      }

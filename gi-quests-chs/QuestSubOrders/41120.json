    {
      "subId": "4112006",
      "subQuestName": "与芬德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411200601"
        ],
        "dialogs": {
          "411200601": {
            "id": "411200601",
            "speakerId": 1005,
            "speakerName": "芬德",
            "text": "呼…谢谢您，刚才真是太危险了。",
            "nextDialogs": [
              "411200602"
            ]
          },
          "411200602": {
            "id": "411200602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以，请您进蒙德城去避难。",
            "nextDialogs": [
              "411200603"
            ]
          },
          "411200603": {
            "id": "411200603",
            "speakerId": 1005,
            "speakerName": "芬德",
            "text": "抱歉，我暂时还不能回去。现在天降陨石，已经可以说是十分奇怪的天象了…",
            "nextDialogs": [
              "411200604"
            ]
          },
          "411200604": {
            "id": "411200604",
            "speakerId": 1005,
            "speakerName": "芬德",
            "text": "在这种天象里，海上再产生风暴的话也不奇怪。",
            "nextDialogs": [
              "411200605"
            ]
          },
          "411200605": {
            "id": "411200605",
            "speakerId": 1005,
            "speakerName": "芬德",
            "text": "我必须要在这里守着，如果真有风暴出现，我必须第一时间通知城里。",
            "nextDialogs": [
              "411200606"
            ]
          },
          "411200606": {
            "id": "411200606",
            "speakerId": 1005,
            "speakerName": "芬德",
            "text": "谢谢您来通知我，辛苦您了，我会多加小心的。"
          }
        }
      }
    },
    {
      "subId": "4112007",
      "subQuestName": "向葛瑞丝修女回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411200701"
        ],
        "dialogs": {
          "411200701": {
            "id": "411200701",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "您回来了，都通知到了吗？",
            "nextDialogs": [
              "411200702"
            ]
          },
          "411200702": {
            "id": "411200702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都通知到了，但他们都暂时不肯回来…",
            "nextDialogs": [
              "411200703"
            ]
          },
          "411200703": {
            "id": "411200703",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "不肯回来？到底是有什么重要的事，让他们这个时候还要呆在野外。",
            "nextDialogs": [
              "411200704"
            ]
          },
          "411200704": {
            "id": "411200704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不愧是自由的蒙德人…",
            "nextDialogs": [
              "411200705"
            ]
          },
          "411200705": {
            "id": "411200705",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "哈哈…哈…是啊，他们确实是自由的蒙德人，再自由不过了。",
            "nextDialogs": [
              "411200706"
            ]
          },
          "411200706": {
            "id": "411200706",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "但是在这个时候，我更希望他们能把这份自由给收敛起来。",
            "nextDialogs": [
              "411200707"
            ]
          },
          "411200707": {
            "id": "411200707",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "唉…西风骑士团想必也没空处理这件事吧。算了，我再想想其他办法，辛苦您了。",
            "nextDialogs": [
              "411200708"
            ]
          },
          "411200708": {
            "id": "411200708",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "希望所有人都能平安无事…"
          }
        }
      }
    },

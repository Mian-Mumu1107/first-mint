    {
      "subId": "7418304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741830401"
        ],
        "dialogs": {
          "741830401": {
            "id": "741830401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…和我们之前见过的发光的怪鱼好像！",
            "nextDialogs": [
              "741830402"
            ]
          },
          "741830402": {
            "id": "741830402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "周围还有奇奇怪怪的东西缠在上面…到底怎么回事啦！搞不懂，我是越来越迷糊了…",
            "nextDialogs": [
              "741830405"
            ]
          },
          "741830405": {
            "id": "741830405",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "嗯，你应该在至尊的记忆里见到过他吧。",
            "nextDialogs": [
              "741830406"
            ]
          },
          "741830406": {
            "id": "741830406",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "「斯库拉」，曾经侍奉至尊的恶龙，他是被波爱修斯镇压并封印在这里的。",
            "nextDialogs": [
              "741830407"
            ]
          },
          "741830407": {
            "id": "741830407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸欸？镇压恶龙？没想到那个没礼貌的家伙还做过这么了不起的事…",
            "nextDialogs": [
              "741830408"
            ]
          },
          "741830408": {
            "id": "741830408",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "说是恶龙，其实不过是稍微厉害些的龙蜥罢了。毕竟在众水的主人还蛰居深海之时，是不会有新的水之龙诞生的。"
          }
        }
      }
    },
    {
      "subId": "7418306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741830601"
        ],
        "dialogs": {
          "741830601": {
            "id": "741830601",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "噢噢噢噢，何等温暖的洋流啊！老夫终于自由了！",
            "nextDialogs": [
              "741830602"
            ]
          },
          "741830602": {
            "id": "741830602",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "小东西，你们是从地上来的吗？虽然不知道你们因何缘由才来到这深水之中的囚笼…",
            "nextDialogs": [
              "741830603"
            ]
          },
          "741830603": {
            "id": "741830603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们才不是什么小东西啦，只是因为大家伙你太大了而已！",
            "nextDialogs": [
              "741830604"
            ]
          },
          "741830604": {
            "id": "741830604",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "哈哈，好！不管怎么说，既然你们解除了束缚我千年的枷锁，那就算是有恩于我。",
            "nextDialogs": [
              "741830605"
            ]
          },
          "741830605": {
            "id": "741830605",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "若有什么用得上老夫的地方就尽管说吧，就当是谢礼。",
            "nextDialogs": [
              "741830606"
            ]
          },
          "741830606": {
            "id": "741830606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嘿嘿，我就知道你会是个通情达理的好家伙！对了，我是派蒙，{M#他}{F#她}是{NICKNAME}，还有这边的…",
            "nextDialogs": [
              "741830607"
            ]
          },
          "741830607": {
            "id": "741830607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…我也不知道他的哪个名字你会比较熟悉啦，不过我们都叫他「呜斯先生」！",
            "nextDialogs": [
              "741830608"
            ]
          },
          "741830608": {
            "id": "741830608",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "啊，卡西奥多，是你，好久不见了。你竟然回来了，只可惜回来得太晚了一些…晚了千年！",
            "nextDialogs": [
              "741830609"
            ]
          },
          "741830609": {
            "id": "741830609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！看来大家伙也跟呜斯先生相熟呢。",
            "nextDialogs": [
              "741830610"
            ]
          },
          "741830610": {
            "id": "741830610",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "我跟可耻的叛徒无话可说。",
            "nextDialogs": [
              "741830611"
            ]
          },
          "741830611": {
            "id": "741830611",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "小心点说话，凡人！与你们这种自大的族裔不同，我们龙裔谨守承诺，绝无可能背叛。",
            "nextDialogs": [
              "741830612"
            ]
          },
          "741830612": {
            "id": "741830612",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "这套说辞比水中的蜉蝣更不值一提，你的背叛是不争的事实，也正是因为你的背叛，我们才输掉了那场战争！",
            "nextDialogs": [
              "741830613"
            ]
          },
          "741830613": {
            "id": "741830613",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "要不是我们输掉了那场战争…我们的国家…至尊也不会…",
            "nextDialogs": [
              "741830614"
            ]
          },
          "741830614": {
            "id": "741830614",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "你离开太久了，卡西奥多！真相并非你所想象的那样。不过也难怪，原本就是隐秘的计划，那些细节又怎会传入你的耳中？",
            "nextDialogs": [
              "741830615"
            ]
          },
          "741830615": {
            "id": "741830615",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "…隐秘的计划？",
            "nextDialogs": [
              "741830616"
            ]
          },
          "741830616": {
            "id": "741830616",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "让老夫率领龙蜥的大军进攻王城，这正是雷穆斯最后的隐秘计划的一部分。",
            "nextDialogs": [
              "741830617"
            ]
          },
          "741830617": {
            "id": "741830617",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "而这一切都是为了拯救他的国家和子民，他是个有着伟大气量的家伙啊。",
            "nextDialogs": [
              "741830620"
            ]
          },
          "741830620": {
            "id": "741830620",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这也太奇怪了吧？怎么会有一个国家的王拜托别人进攻自己的国家啊？",
            "nextDialogs": [
              "741830621"
            ]
          },
          "741830621": {
            "id": "741830621",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "小东西，雷穆斯的想法又岂是你我所能揣测的？无论如何，只要看到这个，卡西奥多，就算是你也能理解其中的含义吧。",
            "nextDialogs": [
              "741830623"
            ]
          },
          "741830623": {
            "id": "741830623",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "是金蜂…引导命途的金蜂只会听从「乐章」的召唤，为什么至尊会将「乐章」的力量交给野蛮的龙类？",
            "nextDialogs": [
              "741830624"
            ]
          },
          "741830624": {
            "id": "741830624",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为他们有过约定…",
            "nextDialogs": [
              "741830625"
            ]
          },
          "741830625": {
            "id": "741830625",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "哦？小家伙知道的不少嘛！你是从哪里知道这些的？",
            "nextDialogs": [
              "741830626"
            ]
          },
          "741830626": {
            "id": "741830626",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "从散落在水里的那些记忆中…",
            "nextDialogs": [
              "741830627"
            ]
          },
          "741830627": {
            "id": "741830627",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "你说的不错！我们之间确实有个约定，但老夫却辜负了他，辜负了他高贵的牺牲。",
            "nextDialogs": [
              "741830628"
            ]
          },
          "741830628": {
            "id": "741830628",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "老夫到底未能及时赶到金色的宫殿！于是肆虐的波涛吞噬了整座城市，而我的族裔也未能逃脱…",
            "nextDialogs": [
              "741830629"
            ]
          },
          "741830629": {
            "id": "741830629",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "…怎么会…",
            "nextDialogs": [
              "741830630"
            ]
          },
          "741830630": {
            "id": "741830630",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "哼，要说背叛，波爱修斯才是真正的叛徒！",
            "nextDialogs": [
              "741830631"
            ]
          },
          "741830631": {
            "id": "741830631",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "若非那说谎的妖鬼、欺人的鼠辈用花言巧语将我们诓骗，作为古龙之后统率龙裔的亲王，我又怎会轻易落败？",
            "nextDialogs": [
              "741830632"
            ]
          },
          "741830632": {
            "id": "741830632",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "那个妖鬼，先是谎称自己奉了雷穆斯的命令，已经命令军团放弃抵抗。等到我们抵达此地时，他却突然发难…",
            "nextDialogs": [
              "741830633"
            ]
          },
          "741830633": {
            "id": "741830633",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "如今想来，他恐怕不知从何处早就窃知了雷穆斯的计划，才能一步步引诱我，布下如此天罗地网吧。",
            "nextDialogs": [
              "741830634"
            ]
          },
          "741830634": {
            "id": "741830634",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "就这样，老夫的血肉化为了岩石，直到千年之后的今日，为你们所搭救。",
            "nextDialogs": [
              "741830635"
            ]
          },
          "741830635": {
            "id": "741830635",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "波爱修斯明知他的举动会导致巨大的灾难，可他还是…难道是为了夺取「福波斯」的控制权，他才犯下如此罪恶吗…",
            "nextDialogs": [
              "741830636"
            ]
          },
          "741830636": {
            "id": "741830636",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉还没有看到事情的全貌…",
            "nextDialogs": [
              "741830637"
            ]
          },
          "741830637": {
            "id": "741830637",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，说别人是叛徒的家伙，结果自己才是彻头彻尾的大叛徒吗？！",
            "nextDialogs": [
              "741830638"
            ]
          },
          "741830638": {
            "id": "741830638",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是他为什么要这样做呢…难道只能去找没礼貌的家伙问问清楚了吗？总觉得他不会老实交代。",
            "nextDialogs": [
              "741830639"
            ]
          },
          "741830639": {
            "id": "741830639",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "哦？那可耻又执迷不悟的妖鬼竟然还未消散吗？",
            "nextDialogs": [
              "741830640"
            ]
          },
          "741830640": {
            "id": "741830640",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀！而且他还夺走了好多枫丹人的灵魂！我们就是为了解救这些人才一路来到这里…",
            "nextDialogs": [
              "741830641"
            ]
          },
          "741830641": {
            "id": "741830641",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他说会在黄金的宫殿等我们…哦不对，他只说了要等呜斯先生，我们是不请自来的勇者！",
            "nextDialogs": [
              "741830699"
            ]
          },
          "741830699": {
            "id": "741830699",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过他连门都没留，到底是个没礼貌的家伙。",
            "nextDialogs": [
              "741830642"
            ]
          },
          "741830642": {
            "id": "741830642",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "雅努斯之门吗…哼，虽然施了些障眼法，不过到底就是个故弄玄虚的石头门而已。",
            "nextDialogs": [
              "741830643"
            ]
          },
          "741830643": {
            "id": "741830643",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "即便老夫已经失去了肉身，但要送小东西们过去还是轻而易举的。",
            "nextDialogs": [
              "741830648"
            ]
          },
          "741830648": {
            "id": "741830648",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "小东西们可看好了！",
            "nextDialogs": [
              "741830644"
            ]
          },
          "741830644": {
            "id": "741830644",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦哦！大家伙还真是可靠呢！",
            "nextDialogs": [
              "741830649"
            ]
          },
          "741830649": {
            "id": "741830649",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "接下来只要把这些显形的封印一一打碎就行了，准备好了我们就出发吧！",
            "nextDialogs": [
              "741830645"
            ]
          },
          "741830645": {
            "id": "741830645",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那呜斯先生，你准备好了吗？",
            "nextDialogs": [
              "741830646"
            ]
          },
          "741830646": {
            "id": "741830646",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "事到如今，也只有前进一途了。",
            "nextDialogs": [
              "741830647"
            ]
          },
          "741830647": {
            "id": "741830647",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#好喔，那{NICKNAME}呢？准备好了吗？"
          },
          "741830698": {
            "id": "741830698",
            "speakerId": 1004,
            "speakerName": "<UNKNOWN>",
            "text": "你们回到了「雅努斯之门」外…"
          }
        }
      }
    },

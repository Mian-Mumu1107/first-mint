    {
      "subId": "7418321",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741832101"
        ],
        "dialogs": {
          "741832101": {
            "id": "741832101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没想到龙蜥能长这么大。",
            "nextDialogs": [
              "741832102"
            ]
          },
          "741832102": {
            "id": "741832102",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "哼，毕竟是些缺乏教养，野蛮生长的族群，就算长成更加奇怪的样子也不意外吧。"
          }
        }
      }
    },
    {
      "subId": "7418322",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741832201"
        ],
        "dialogs": {
          "741832201": {
            "id": "741832201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说起来那维莱特不就是…",
            "nextDialogs": [
              "741832202"
            ]
          },
          "741832202": {
            "id": "741832202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊，那维莱特不就是水之龙吗？这样说来这家伙该不会比那维莱特的年纪还要大得多？",
            "nextDialogs": [
              "741832203"
            ]
          },
          "741832203": {
            "id": "741832203",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "已经有新的水之龙诞生了吗？也对，毕竟就连曾经的那位众水之主也早已逝去了…已经过去太久了…"
          }
        }
      }
    },
    {
      "subId": "7418323",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741832301"
        ],
        "dialogs": {
          "741832301": {
            "id": "741832301",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "总之，恶龙斯库拉曾是至尊的朋友。但他却在我们雷穆利亚人与…枫丹人决战的关键时刻发起了叛乱。",
            "nextDialogs": [
              "741832302"
            ]
          },
          "741832302": {
            "id": "741832302",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "彼时，恶龙率领暴虐的龙裔直抵「马其莫斯」，并试图攻入至尊所在的内城「卡皮托利姆」。",
            "nextDialogs": [
              "741832305"
            ]
          },
          "741832305": {
            "id": "741832305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，在镇上的时候那些居民也一直在说什么「马其莫斯」，还有钟楼之类的…",
            "nextDialogs": [
              "741832306"
            ]
          },
          "741832306": {
            "id": "741832306",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "没错，「马其莫斯」是王城的外城，但恶龙要想去往内城就必须穿过「雅努斯之门」。",
            "nextDialogs": [
              "741832307"
            ]
          },
          "741832307": {
            "id": "741832307",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "那是隔绝王城内外的屏障，曾经至尊与乐师们编织的乐章，也是通过横穿「雅努斯之门」的金色水道覆盖到雷穆利亚全域的。",
            "nextDialogs": [
              "741832308"
            ]
          },
          "741832308": {
            "id": "741832308",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "波爱修斯和他的军团正是利用了这一点，竭力关闭了「雅努斯之门」，才最终将恶龙封印。",
            "nextDialogs": [
              "741832309"
            ]
          },
          "741832309": {
            "id": "741832309",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "斯库拉或许是想去到至尊御前吧，但再没有这样的机会了。之后恶龙随雷穆利亚一道沉入深水，至尊也从此不知所踪，直至今日…"
          }
        }
      }
    },
    {
      "subId": "7418324",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741832401"
        ],
        "dialogs": {
          "741832401": {
            "id": "741832401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "比如风魔龙特瓦林…",
            "nextDialogs": [
              "741832402"
            ]
          },
          "741832402": {
            "id": "741832402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，因为特瓦林受到了诅咒的影响，在蒙德掀起了风灾，我们为此还大打了一架呢…"
          }
        }
      }
    },
    {
      "subId": "7418325",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741832501"
        ],
        "dialogs": {
          "741832501": {
            "id": "741832501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "比如若陀龙王…",
            "nextDialogs": [
              "741832502"
            ]
          },
          "741832502": {
            "id": "741832502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对，因为他想要突破封印，我们和大家一起击败了他，才将他重新封印了起来…"
          }
        }
      }
    },
    {
      "subId": "7418326",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741832601"
        ],
        "dialogs": {
          "741832601": {
            "id": "741832601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "比如沙漠里的阿佩普…",
            "nextDialogs": [
              "741832602"
            ]
          },
          "741832602": {
            "id": "741832602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没错，她还说什么要毁灭须弥…后来我们一起打败了她身体里面的变异生命体，才帮她恢复了健康…"
          }
        }
      }
    }
  ]

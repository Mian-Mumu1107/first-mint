          },
          "741832803": {
            "id": "741832803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就、就算你用这种怀疑的眼神看我们，现在也没有别的更好更快的办法了吧！",
            "nextDialogs": [
              "741832804"
            ]
          },
          "741832804": {
            "id": "741832804",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "唉，你说得对。那就姑且一试吧。",
            "nextDialogs": [
              "741832805"
            ]
          },
          "741832805": {
            "id": "741832805",
            "speakerId": 21430,
            "speakerName": "呜斯先生",
            "text": "束缚恶龙的封印看起来与三处相连，我们就从解开这三处的锁链开始吧。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2300801",
      "subQuestName": "与阿金对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230080101"
        ],
        "dialogs": {
          "230080101": {
            "id": "230080101",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "也许马上就要成功了…",
            "nextDialogs": [
              "230080102"
            ]
          },
          "230080102": {
            "id": "230080102",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "旅行者！请你留步，旅行者！",
            "nextDialogs": [
              "230080105"
            ]
          },
          "230080105": {
            "id": "230080105",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "我要找史莱姆凝液！",
            "nextDialogs": [
              "230080106"
            ]
          },
          "230080106": {
            "id": "230080106",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "事情是这样，我这几天一直在试验，把你之前帮我拿回来的泥土用各种比例混合。",
            "nextDialogs": [
              "230080107"
            ]
          },
          "230080107": {
            "id": "230080107",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "虽然失败了很多次…但我最终还是找到了一个可用的混合比例！",
            "nextDialogs": [
              "230080108"
            ]
          },
          "230080108": {
            "id": "230080108",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "用这种比例混合出来的「凝成泥土」虽然在凝固前没什么可塑性，但凝固后却坚固耐用。",
            "nextDialogs": [
              "230080109"
            ]
          },
          "230080109": {
            "id": "230080109",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "我猜，也许是那种混合了史莱姆凝液的泥土加入少了…",
            "nextDialogs": [
              "230080110"
            ]
          },
          "230080110": {
            "id": "230080110",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "旅行者，请你快去帮我再拿三份史莱姆凝液回来吧！",
            "nextDialogs": [
              "230080111"
            ]
          },
          "230080111": {
            "id": "230080111",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "有了这些史莱姆凝液，我一定能做出我想要的泥土！"
          }
        }
      }
    },
    {
      "subId": "2300802",
      "subQuestName": "将三份史莱姆凝液交给阿金",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230080201"
        ],
        "dialogs": {
          "230080201": {
            "id": "230080201",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "你拿到史莱姆凝液了吗？"
          }
        }
      }
    },
    {
      "subId": "2300803",
      "subQuestName": "继续与阿金对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230080301"
        ],
        "dialogs": {
          "230080301": {
            "id": "230080301",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "太好了！就是这些，请稍等我一下，马上就好！",
            "nextDialogs": [
              "230080302"
            ]
          },
          "230080302": {
            "id": "230080302",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "等待了一段时间之后。",
            "nextDialogs": [
              "230080303"
            ]
          },
          "230080303": {
            "id": "230080303",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "果然，我的猜想没错。",
            "nextDialogs": [
              "230080304"
            ]
          },
          "230080304": {
            "id": "230080304",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "潮湿的泥土粘合性好，凝固后却容易断裂，但和骗骗花的泥土样本混合之后，凝固后的泥土居然有了一些柔韧性。",
            "nextDialogs": [
              "230080305"
            ]
          },
          "230080305": {
            "id": "230080305",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "但这种泥土在凝固前的可塑性很差…",
            "nextDialogs": [
              "230080306"
            ]
          },
          "230080306": {
            "id": "230080306",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "但加上史莱姆栖息地的泥土之后，这种泥土在凝固前的可塑性突然好了起来。",
            "nextDialogs": [
              "230080307"
            ]
          },
          "230080307": {
            "id": "230080307",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "我也不知道为什么，硬要形容的话，就是这种泥土变成了史莱姆一样…",
            "nextDialogs": [
              "230080311",
              "230080310"
            ]
          },
          "230080311": {
            "id": "230080311",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "我猜是史莱姆的某种特质影响了泥土，所以就在想如果直接加入史莱姆凝液会不会更有效果。",
            "nextDialogs": [
              "230080312"
            ]
          },
          "230080312": {
            "id": "230080312",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "结果刚刚测试了一下，根据史莱姆凝液加入量的不同，泥土的可塑性与强度都会随之变化。",
            "nextDialogs": [
              "230080313"
            ]
          },
          "230080313": {
            "id": "230080313",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "换句话说，不只是建筑材料，它还能用来做陶器，还有许多其他东西！"
          },
          "230080310": {
            "id": "230080310",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "派蒙才不会去吃土嘞！"
          }
        }
      }
    }
  ]
}
{
  "lineCounts": {
    "Player": 5,
    "九条裟罗": 32,
    "元助": 3,
    "忠胜": 12,
    "派蒙": 6,
    "珊瑚宫心海": 55,
    "陶义隆": 4
  },
  "subQuests": [
    {
      "subId": "1202401",
      "subQuestName": "等待到第二天上午10点-12点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120240101"
        ],
        "dialogs": {
          "120240101": {
            "id": "120240101",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "好久不见，九条裟罗。上次见面，还是在战场上吧。",
            "nextDialogs": [
              "120240102"
            ]
          },
          "120240102": {
            "id": "120240102",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "是啊，当时我们在你手上吃了不小的亏…",
            "nextDialogs": [
              "120240103"
            ]
          },
          "120240103": {
            "id": "120240103",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "话说回来，你怎么也在这？",
            "nextDialogs": [
              "120240104"
            ]
          },
          "120240104": {
            "id": "120240104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "来见证这次和谈。",
            "nextDialogs": [
              "120240105"
            ]
          },
          "120240105": {
            "id": "120240105",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "#没错，{NICKNAME}是这次和谈的见证人。",
            "nextDialogs": [
              "120240106"
            ]
          },
          "120240106": {
            "id": "120240106",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}完整地经历了我们之间的战争，为现在的和平做出了巨大的贡献。我想，应该没有人比{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}更合适了。",
            "nextDialogs": [
              "120240107"
            ]
          },
          "120240107": {
            "id": "120240107",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "也是，那我们直接进入正题吧。",
            "nextDialogs": [
              "120240108"
            ]
          },
          "120240108": {
            "id": "120240108",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "首先是海域管辖权的问题。战争期间，我们限制了海祇岛的打渔人在鸣神岛海域活动…",
            "nextDialogs": [
              "120240109"
            ]
          },
          "120240109": {
            "id": "120240109",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "现在我们打算正式解除限制，但他们需要按照我们鸣神岛的税法进行纳税，才能将收获带回海祇岛。",
            "nextDialogs": [
              "120240110"
            ]
          },
          "120240110": {
            "id": "120240110",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "可以。不过在鸣神岛附近捕鱼的人，需要受到天领奉行的保护。",
            "nextDialogs": [
              "120240111"
            ]
          },
          "120240111": {
            "id": "120240111",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "如果他们因治安问题有任何损失，天领奉行必须要出面解决。",
            "nextDialogs": [
              "120240112"
            ]
          },
          "120240112": {
            "id": "120240112",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "这一点我答应了，写到协约中吧。有天领奉行在，他们不会有事。",
            "nextDialogs": [
              "120240113"
            ]
          },
          "120240113": {
            "id": "120240113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉她们之间的谈判还算顺利呢。",
            "nextDialogs": [
              "120240114"
            ]
          },
          "120240114": {
            "id": "120240114",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "接下来是人员往来和常驻军的所属问题。",
            "nextDialogs": [
              "120240115"
            ]
          },
          "120240115": {
            "id": "120240115",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "以前不管是我们的人去海祇岛，还是海祇岛的人过来，都会遭受到重重盘问。",
            "nextDialogs": [
              "120240116"
            ]
          },
          "120240116": {
            "id": "120240116",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "最终的结果，就是彼此交流越来越少，很少有商人愿意跨岛屿经商。",
            "nextDialogs": [
              "120240117"
            ]
          },
          "120240117": {
            "id": "120240117",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "战争既然结束，那我提议由社奉行选出一些商人，主管两边的商务贸易。",
            "nextDialogs": [
              "120240118"
            ]
          },
          "120240118": {
            "id": "120240118",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "商务贸易，需要有来有往。双方的商人都要参与进来，不能完全交给社奉行。",
            "nextDialogs": [
              "120240119"
            ]
          },
          "120240119": {
            "id": "120240119",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "但据我了解，海祇岛现在急需各种物资。交由社奉行统一调配，对你们也是一件好事。",
            "nextDialogs": [
              "120240120"
            ]
          },
          "120240120": {
            "id": "120240120",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "物资紧缺，我们自然有办法缓解。海祇岛物产丰富，也有许多外地的商人愿意过来。",
            "nextDialogs": [
              "120240121"
            ]
          },
          "120240121": {
            "id": "120240121",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "更何况这种事，应该由神里家与我们谈。天领奉行…应该没有这方面的权能吧。",
            "nextDialogs": [
              "120240122"
            ]
          },
          "120240122": {
            "id": "120240122",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "既然这样，那我们聊聊治安吧。我想让海祇岛的治安部队，回归到天领奉行的管辖之下。",
            "nextDialogs": [
              "120240123"
            ]
          },
          "120240123": {
            "id": "120240123",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "暂时来说，不可能。",
            "nextDialogs": [
              "120240124"
            ]
          },
          "120240124": {
            "id": "120240124",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "没有不可能的事情。天领奉行统管稻妻治安，不可能一直放任海祇岛处于例外…",
            "nextDialogs": [
              "120240125"
            ]
          },
          "120240125": {
            "id": "120240125",
            "speakerId": 12068,
            "speakerName": "忠胜",
            "text": "卑鄙的九条家，你们勾结愚人众，还想夺走我们海祇岛的一切！",
            "nextDialogs": [
              "120240127"
            ]
          },
          "120240127": {
            "id": "120240127",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "心海！这时候我们要用锦囊第几条呀！",
            "nextDialogs": [
              "120240128"
            ]
          },
          "120240128": {
            "id": "120240128",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "最后一条…不过暂时不需要你们出手了。",
            "nextDialogs": [
              "120240129"
            ]
          },
          "120240129": {
            "id": "120240129",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "忠胜，如今情况有变，你们先在一旁待命。",
            "nextDialogs": [
              "120240130"
            ]
          },
          "120240130": {
            "id": "120240130",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "放心，你们的诉求我已了解，接下来就交给我来处理吧。",
            "nextDialogs": [
              "120240131"
            ]
          },
          "120240131": {
            "id": "120240131",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "九条小姐，关于这件事，你是不是应该给我们海祇岛一个交代？",
            "nextDialogs": [
              "120240132"
            ]
          },
          "120240132": {
            "id": "120240132",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "…稍等。所有人不要动手，等我调查完再说！",
            "nextDialogs": [
              "120240133"
            ]
          },
          "120240133": {
            "id": "120240133",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "你们两个，过来。",
            "nextDialogs": [
              "120240134"
            ]
          },
          "120240134": {
            "id": "120240134",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "说吧，你们跟愚人众真的有什么勾结吗？",
            "nextDialogs": [
              "120240135"
            ]
          },
          "120240135": {
            "id": "120240135",
            "speakerId": 12099,
            "speakerName": "元助",
            "text": "这…",
            "nextDialogs": [
              "120240136"
            ]
          },
          "120240136": {
            "id": "120240136",
            "speakerId": 12100,
            "speakerName": "陶义隆",
            "text": "就，其实也算不上勾结…",
            "nextDialogs": [
              "120240137"
            ]
          },
          "120240137": {
            "id": "120240137",
            "speakerId": 12099,
            "speakerName": "元助",
            "text": "愚人众有些人找上我们，说可以跟我们合作，延续对海祇岛的战争。",
            "nextDialogs": [
              "120240138"
            ]
          },
          "120240138": {
            "id": "120240138",
            "speakerId": 12099,
            "speakerName": "元助",
            "text": "当时我寻思，反正试试也没什么坏处…",
            "nextDialogs": [
              "120240139"
            ]
          },
          "120240139": {
            "id": "120240139",
            "speakerId": 12100,
            "speakerName": "陶义隆",
            "text": "但其实我们很谨慎，没答应他们，只说让他们可以先去海祇岛搞破坏，我们看看情况再说。",
            "nextDialogs": [
              "120240140"
            ]
          },
          "120240140": {
            "id": "120240140",
            "speakerId": 12100,
            "speakerName": "陶义隆",
            "text": "九条大人，我们跟他们真的没什么勾结。只是不久之前谈过这么一次，谁知道海祇岛的人怎么知道的…",
            "nextDialogs": [
              "120240141"
            ]
          },
          "120240141": {
            "id": "120240141",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "够了…回去之后，自己领罚吧。",
            "nextDialogs": [
              "120240142"
            ]
          },
          "120240142": {
            "id": "120240142",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "那可是愚人众，他们对我们做了什么，你们都忘了吗？",
            "nextDialogs": [
              "120240143"
            ]
          },
          "120240143": {
            "id": "120240143",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "别说合作，你们根本就不该和他们有任何牵扯。",
            "nextDialogs": [
              "120240144"
            ]
          },
          "120240144": {
            "id": "120240144",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "他们的目的是什么？",
            "nextDialogs": [
              "120240145"
            ]
          },
          "120240145": {
            "id": "120240145",
            "speakerId": 12100,
            "speakerName": "陶义隆",
            "text": "愚人众的主力应该已经从稻妻撤出了，找上我们的那些人，似乎是想给他们的老大报仇。",
            "nextDialogs": [
              "120240146"
            ]
          },
          "120240146": {
            "id": "120240146",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "那个女人的部下吗…看来是准备报复，想让稻妻继续乱起来吧。",
            "nextDialogs": [
              "120240147"
            ]
          },
          "120240147": {
            "id": "120240147",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "早晚有一天，我会亲手把他们全部抓住。",
            "nextDialogs": [
              "120240148"
            ]
          },
          "120240148": {
            "id": "120240148",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "这件事，确实是我们的问题。",
            "nextDialogs": [
              "120240149"
            ]
          },
          "120240149": {
            "id": "120240149",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "非常抱歉，因为我的疏忽，才有这样的局面。请再给我们一个机会，让和谈继续下去。",
            "nextDialogs": [
              "120240150"
            ]
          },
          "120240150": {
            "id": "120240150",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "呵呵…我当然相信九条小姐能够处理好这件事。",
            "nextDialogs": [
              "120240151"
            ]
          },
          "120240151": {
            "id": "120240151",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "但既然天领奉行做不到上下齐心，我很难放心把海祇岛的治安交给你们。",
            "nextDialogs": [
              "120240152"
            ]
          },
          "120240152": {
            "id": "120240152",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "无法反驳…",
            "nextDialogs": [
              "120240153"
            ]
          },
          "120240153": {
            "id": "120240153",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "这个议题暂时搁置吧。等天领奉行整顿完毕之后，我们再好好讨论讨论。",
            "nextDialogs": [
              "120240154"
            ]
          },
          "120240154": {
            "id": "120240154",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "关于商人的问题，我也会和社奉行那边商量，让双方都能参与进来…",
            "nextDialogs": [
              "120240155"
            ]
          },
          "120240155": {
            "id": "120240155",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉裟罗的气势一下子弱了不少，这样和谈应该能够顺利进行了吧。",
            "nextDialogs": [
              "120240156"
            ]
          },
          "120240156": {
            "id": "120240156",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "没想到海祇岛的「军师」除了擅长作战，谈判也是一把好手。",
            "nextDialogs": [
              "120240157"
            ]
          },
          "120240157": {
            "id": "120240157",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "希望下次见面，我们还能像这样坐下来谈话。毕竟在战场上见到你，太过棘手了。",
            "nextDialogs": [
              "120240158"
            ]
          },
          "120240158": {
            "id": "120240158",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "今天就到这里吧，我也要回去彻查天领奉行内部的问题。",
            "nextDialogs": [
              "120240159"
            ]
          },
          "120240159": {
            "id": "120240159",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "愚人众的营地被我们击溃，再过不久，他们应该就会再和你们联络，想要从你们那里获得支持。",
            "nextDialogs": [
              "120240160"
            ]
          },
          "120240160": {
            "id": "120240160",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "我建议你先不要放出风声，以免打草惊蛇。等他们现身，就可以将他们一网打尽。",
            "nextDialogs": [
              "120240161"
            ]
          },
          "120240161": {
            "id": "120240161",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "我会考虑的，非常感谢。",
            "nextDialogs": [
              "120240162"
            ]
          },
          "120240162": {
            "id": "120240162",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "那我先回去了，下次再见吧。",
            "nextDialogs": [
              "120240163"
            ]
          },
          "120240163": {
            "id": "120240163",
            "speakerId": 12068,
            "speakerName": "忠胜",
            "text": "珊瑚宫大人，我们…",
            "nextDialogs": [
              "120240164"
            ]
          },
          "120240164": {
            "id": "120240164",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "回海祇岛再说吧。"
          }
        }
      }
    },
    {
      "subId": "1202407",
      "subQuestName": "在约定地点与心海会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1202404",
      "subQuestName": "与心海交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120240401"
        ],
        "dialogs": {
          "120240401": {
            "id": "120240401",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "#呵欠…今天就是和谈的日子了，怎么样{NICKNAME}，做好准备了吗？",
            "nextDialogs": [
              "120240402"
            ]
          },
          "120240402": {
            "id": "120240402",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "来，这个给你。",
            "nextDialogs": [
              "120240403"
            ]
          },
          "120240403": {
            "id": "120240403",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "这是我昨晚写下的锦囊。这次谈判虽然错综复杂，但我仔细思考了一下，不外乎一百八十七种情况。",
            "nextDialogs": [
              "120240404"
            ]
          },
          "120240404": {
            "id": "120240404",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "我将这些情况和对策全部写了下来，到时候你可以随机应变。",
            "nextDialogs": [
              "120240405"
            ]
          },
          "120240405": {
            "id": "120240405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！好厚一本！",
            "nextDialogs": [
              "120240406"
            ]
          },
          "120240406": {
            "id": "120240406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让我看看…「激烈争吵」、「出现械斗」、「放火作乱」、「分兵涌入」、「挟持人质」…",
            "nextDialogs": [
              "120240407"
            ]
          },
          "120240407": {
            "id": "120240407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好多！一想到每种情况都有办法解决，突然就放心了很多。",
            "nextDialogs": [
              "120240408"
            ]
          },
          "120240408": {
            "id": "120240408",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "那就好。此次和谈颇为特殊，对海祇岛与幕府都很重要。",
            "nextDialogs": [
              "120240409"
            ]
          },
          "120240409": {
            "id": "120240409",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "但因为海祇岛的士兵尚有不满之意，我们在和谈中天然处于劣势。想要争取和谈圆满完成，需要花费更多力气。",
            "nextDialogs": [
              "120240410"
            ]
          },
          "120240410": {
            "id": "120240410",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "我作为海祇岛的现人神巫女，该担当起这份责任。能请你助我一臂之力吗？",
            "nextDialogs": [
              "120240413"
            ]
          },
          "120240413": {
            "id": "120240413",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "那真是太好了。我们出发吧。"
          }
        }
      }
    },
    {
      "subId": "1202402",
      "subQuestName": "前往和谈现场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120240201"
        ],
        "dialogs": {
          "120240201": {
            "id": "120240201",
            "speakerId": 12068,
            "speakerName": "忠胜",
            "text": "珊瑚宫大人，您都知道了…？",
            "nextDialogs": [
              "120240202"
            ]
          },
          "120240202": {
            "id": "120240202",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "你们闹事的理由，我已经听说了。",
            "nextDialogs": [
              "120240203"
            ]
          },
          "120240203": {
            "id": "120240203",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "你们觉得天领奉行信不过，所以不想要和谈，想要继续打下去。",
            "nextDialogs": [
              "120240204"
            ]
          },
          "120240204": {
            "id": "120240204",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "虽然从结果来看，你们误打误撞地识破了他们的阴谋，但你们的做法我还是无法认可。",
            "nextDialogs": [
              "120240205"
            ]
          },
          "120240205": {
            "id": "120240205",
            "speakerId": 12068,
            "speakerName": "忠胜",
            "text": "可是珊瑚宫大人，我们牺牲了那么多同伴，如果就这样停下来，曾经的努力不是白费了？",
            "nextDialogs": [
              "120240206"
            ]
          },
          "120240206": {
            "id": "120240206",
            "speakerId": 12068,
            "speakerName": "忠胜",
            "text": "我希望战争继续打下去，就算我牺牲了也没有关系，我希望我们能彻底赢下来！",
            "nextDialogs": [
              "120240207"
            ]
          },
          "120240207": {
            "id": "120240207",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "我能够理解你们的想法…但你们不能强求别人为你们的想法买单。",
            "nextDialogs": [
              "120240208"
            ]
          },
          "120240208": {
            "id": "120240208",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "战争期间，我们有过低谷，也打过胜仗。对你们来说，这是一段热血澎湃的经历。",
            "nextDialogs": [
              "120240209"
            ]
          },
          "120240209": {
            "id": "120240209",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "但其实在战争期间，也有许多你们看不到的人，每天都活在煎熬之中。",
            "nextDialogs": [
              "120240210"
            ]
          },
          "120240210": {
            "id": "120240210",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "海祇岛的人向往和平，是因为每个人都为战争付出了太多。他们已经累了，不该被你们又一次拖下水。",
            "nextDialogs": [
              "120240211"
            ]
          },
          "120240211": {
            "id": "120240211",
            "speakerId": 12068,
            "speakerName": "忠胜",
            "text": "我…可是…",
            "nextDialogs": [
              "120240212"
            ]
          },
          "120240212": {
            "id": "120240212",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "我明白，这不完全是你们的错。",
            "nextDialogs": [
              "120240213"
            ]
          },
          "120240213": {
            "id": "120240213",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "是我考虑不周。我告诉你们要有战斗的意志，却没有告诉你们该如何放手。",
            "nextDialogs": [
              "120240214"
            ]
          },
          "120240214": {
            "id": "120240214",
            "speakerId": 12068,
            "speakerName": "忠胜",
            "text": "不是珊瑚宫大人的错！是我们…太过自私了。",
            "nextDialogs": [
              "120240215"
            ]
          },
          "120240215": {
            "id": "120240215",
            "speakerId": 12068,
            "speakerName": "忠胜",
            "text": "不论如何，我们愿意接受军法处置。",
            "nextDialogs": [
              "120240216"
            ]
          },
          "120240216": {
            "id": "120240216",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "好。那我现在宣布…",
            "nextDialogs": [
              "120240217"
            ]
          },
          "120240217": {
            "id": "120240217",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "从今天开始，成立一支秘密军队。负责保卫海祇岛的安全，清理一切危险之物。",
            "nextDialogs": [
              "120240218"
            ]
          },
          "120240218": {
            "id": "120240218",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "所有像你们一样的人，都可以加入其中，不过训练比较辛苦，希望你们可以咬牙坚持住。",
            "nextDialogs": [
              "120240219"
            ]
          },
          "120240219": {
            "id": "120240219",
            "speakerId": 12068,
            "speakerName": "忠胜",
            "text": "珊瑚宫大人的意思是…？",
            "nextDialogs": [
              "120240220"
            ]
          },
          "120240220": {
            "id": "120240220",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "从这次和谈来看，九条家短时间内不会太平。有人想要和平，就有人想要战争。",
            "nextDialogs": [
              "120240221"
            ]
          },
          "120240221": {
            "id": "120240221",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "海祇岛向往和平，但也要有自保的能力。既然你们还有战斗意志，就从今天开始魔鬼训练。",
            "nextDialogs": [
              "120240222"
            ]
          },
          "120240222": {
            "id": "120240222",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "直到每个人能在正面战场上，打赢两个幕府武士再说！",
            "nextDialogs": [
              "120240223"
            ]
          },
          "120240223": {
            "id": "120240223",
            "speakerId": 12068,
            "speakerName": "忠胜",
            "text": "…多谢珊瑚宫大人！",
            "nextDialogs": [
              "120240224"
            ]
          },
          "120240224": {
            "id": "120240224",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "好了，去找五郎报名吧。今后记着，无论发生什么事情，都不可以擅自行动。",
            "nextDialogs": [
              "120240225"
            ]
          },
          "120240225": {
            "id": "120240225",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "如果再有下次…不管是什么理由，都不会有商量的余地了。",
            "nextDialogs": [
              "120240226"
            ]
          },
          "120240226": {
            "id": "120240226",
            "speakerId": 12068,
            "speakerName": "忠胜",
            "text": "…明白。从今往后，我们一定好好训练。",
            "nextDialogs": [
              "120240227"
            ]
          },
          "120240227": {
            "id": "120240227",
            "speakerId": 12068,
            "speakerName": "忠胜",
            "text": "多谢珊瑚宫大人给我们这个机会，我们去找五郎大人报名了！",
            "nextDialogs": [
              "120240228"
            ]
          },
          "120240228": {
            "id": "120240228",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "呼…这样终于妥善解决了。",
            "nextDialogs": [
              "120240229"
            ]
          },
          "120240229": {
            "id": "120240229",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "总觉得「能量」又开始下降了…我们到「秘密基地」附近休息一下吧？"
          }
        }
      }
    },

    {
      "subId": "1202405",
      "subQuestName": "在秘密基地附近与心海交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120240301"
        ],
        "dialogs": {
          "120240301": {
            "id": "120240301",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "辛苦你了。多亏了你的帮忙，海祇岛又一次恢复了和平。",
            "nextDialogs": [
              "120240302"
            ]
          },
          "120240302": {
            "id": "120240302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「能量」还够用吗？",
            "nextDialogs": [
              "120240303"
            ]
          },
          "120240303": {
            "id": "120240303",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "正在慢慢回复…嗯，应该用不了多久就能完全复活了。",
            "nextDialogs": [
              "120240304"
            ]
          },
          "120240304": {
            "id": "120240304",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "我果然还是不擅长应对人多的场合。虽然比起之前有了不小的进步，但总感觉人一多心里就有些发慌。",
            "nextDialogs": [
              "120240305"
            ]
          },
          "120240305": {
            "id": "120240305",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "谈判之类的，下次还是交给五郎去吧…",
            "nextDialogs": [
              "120240306"
            ]
          },
          "120240306": {
            "id": "120240306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "心海已经做得很好了。",
            "nextDialogs": [
              "120240307"
            ]
          },
          "120240307": {
            "id": "120240307",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "是吗？",
            "nextDialogs": [
              "120240308"
            ]
          },
          "120240308": {
            "id": "120240308",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "其实，以「现人神巫女」的标准来看，还远远不够呢。",
            "nextDialogs": [
              "120240309"
            ]
          },
          "120240309": {
            "id": "120240309",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "以前我只想赢下来，保证海祇岛的安定，让每个人都可以快乐地活着。",
            "nextDialogs": [
              "120240310"
            ]
          },
          "120240310": {
            "id": "120240310",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "但现在我发现，仅仅这样是不够的。人的愿望千百种，幸福的标准也就不同。",
            "nextDialogs": [
              "120240311"
            ]
          },
          "120240311": {
            "id": "120240311",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "我要走的路还很长。不过没关系，一口气走不到的话，慢慢走过去就好…",
            "nextDialogs": [
              "120240312"
            ]
          },
          "120240312": {
            "id": "120240312",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "现在的我还不够成熟，可以请你留在海祇岛…再陪我一段时间吗？"
          }
        }
      }
    }
  ]
}
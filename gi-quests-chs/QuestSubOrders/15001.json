    },
    {
      "subId": "1500104",
      "subQuestName": "点燃传火盆(0/6)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150010401"
        ],
        "dialogs": {
          "150010401": {
            "id": "150010401",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "准备好了就开始吧。我再重复一遍，取来火种，清理污垢，然后点燃所有传火盆。"
          }
        }
      }
    },
    {
      "subId": "1500105",
      "subQuestName": "点燃传火盆(1/6)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1500106",
      "subQuestName": "点燃传火盆(2/6)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150010601"
        ],
        "dialogs": {
          "150010601": {
            "id": "150010601",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "胡妮，谁让你自己跑出去的？你知不知道有多危险？",
            "nextDialogs": [
              "150010602"
            ]
          },
          "150010602": {
            "id": "150010602",
            "speakerId": 14151,
            "speakerName": "胡妮",
            "text": "有多巴帮忙，还有路过的好心人也帮了忙…",
            "nextDialogs": [
              "150010603"
            ]
          },
          "150010603": {
            "id": "150010603",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "好心人？他们把心掏给你看了？上面写了几个「好」？",
            "nextDialogs": [
              "150010604"
            ]
          },
          "150010604": {
            "id": "150010604",
            "speakerId": 14151,
            "speakerName": "胡妮",
            "text": "一、一百个！",
            "nextDialogs": [
              "150010605"
            ]
          },
          "150010605": {
            "id": "150010605",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "还顶嘴！山王的问题没解决，你要是又出问题该怎么办？你今晚不许吃饭！",
            "nextDialogs": [
              "150010606"
            ]
          },
          "150010606": {
            "id": "150010606",
            "speakerId": 14151,
            "speakerName": "胡妮",
            "text": "不吃饭也是一百个…",
            "nextDialogs": [
              "150010607"
            ]
          },
          "150010607": {
            "id": "150010607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗨，胡妮，又见面了！",
            "nextDialogs": [
              "150010608"
            ]
          },
          "150010608": {
            "id": "150010608",
            "speakerId": 14151,
            "speakerName": "胡妮",
            "text": "#是派蒙姐姐！还有{NICKNAME}{M#哥哥}{F#姐姐}！爸爸！就是{M#他们}{F#她们}帮了忙…我说要招待{M#他们}{F#她们}的…",
            "nextDialogs": [
              "150010609"
            ]
          },
          "150010609": {
            "id": "150010609",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "哦？就是你们两位「好心人」是吧…",
            "nextDialogs": [
              "150010610"
            ]
          },
          "150010610": {
            "id": "150010610",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "你们的辛苦我知道了，有什么需要就开口吧，我是悬木人的长老特立尼达，在族里我的话还是能派上些用处的。",
            "nextDialogs": [
              "150010611"
            ]
          },
          "150010611": {
            "id": "150010611",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "相信你们也是聪明人，不可能提过分的要求，对吧？",
            "nextDialogs": [
              "150010613",
              "150010616"
            ]
          },
          "150010613": {
            "id": "150010613",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是，我们才不是那种施恩图报的人呢！",
            "nextDialogs": [
              "150010614"
            ]
          },
          "150010614": {
            "id": "150010614",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "哦？最好是这样…",
            "nextDialogs": [
              "150010617"
            ]
          },
          "150010617": {
            "id": "150010617",
            "speakerId": 14151,
            "speakerName": "胡妮",
            "text": "#爸爸，{M#他们}{F#她们}不是坏人！{M#他们}{F#她们}还和基尼奇哥哥一起吃过饭呢，你不要这个态度…",
            "nextDialogs": [
              "150010618"
            ]
          },
          "150010618": {
            "id": "150010618",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "基尼奇？等等…",
            "nextDialogs": [
              "150010619"
            ]
          },
          "150010619": {
            "id": "150010619",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "我听说有两位神秘的异邦旅者与火神大人一起解决了我们纳塔的大危机，难道是…？",
            "nextDialogs": [
              "150010620"
            ]
          },
          "150010620": {
            "id": "150010620",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没错，正是在下。",
            "nextDialogs": [
              "150010621"
            ]
          },
          "150010621": {
            "id": "150010621",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有在下！",
            "nextDialogs": [
              "150010622"
            ]
          },
          "150010622": {
            "id": "150010622",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "啊…咳咳…",
            "nextDialogs": [
              "150010623"
            ]
          },
          "150010623": {
            "id": "150010623",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "…真抱歉，最近族里的琐事叫我焦头烂额，呵呵…能否允许我收回之前的话，我为先前的冒犯感到羞愧…",
            "nextDialogs": [
              "150010624"
            ]
          },
          "150010624": {
            "id": "150010624",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，这还差不多，我们也不是小气的人，看见胡妮安全回家就放心啦。",
            "nextDialogs": [
              "150010625"
            ]
          },
          "150010625": {
            "id": "150010625",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "两位应该是才来不久吧？今晚就由我来为两位接风洗尘怎么样？",
            "nextDialogs": [
              "150010626"
            ]
          },
          "150010626": {
            "id": "150010626",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "大叔…变脸太快的话，脸皮会着火的。",
            "nextDialogs": [
              "150010627"
            ]
          },
          "150010627": {
            "id": "150010627",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "咳咳…",
            "nextDialogs": [
              "150010628"
            ]
          },
          "150010628": {
            "id": "150010628",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "吃饭不用了，有事请直说。",
            "nextDialogs": [
              "150010629"
            ]
          },
          "150010629": {
            "id": "150010629",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "强大的旅者，您那双明目中闪烁着智慧！",
            "nextDialogs": [
              "150010630"
            ]
          },
          "150010630": {
            "id": "150010630",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "胡妮，你先进去，爸爸有正事要谈。",
            "nextDialogs": [
              "150010631"
            ]
          },
          "150010631": {
            "id": "150010631",
            "speakerId": 14151,
            "speakerName": "胡妮",
            "text": "#好吧，那要好好招待派蒙姐姐和{NICKNAME}{M#哥哥}{F#姐姐}哦！",
            "nextDialogs": [
              "150010632"
            ]
          },
          "150010632": {
            "id": "150010632",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来大叔是有求于我们啊，我们可不能保证什么。",
            "nextDialogs": [
              "150010633"
            ]
          },
          "150010633": {
            "id": "150010633",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "咳咳…这件事事关重大，劳驾两位先听我说完…",
            "nextDialogs": [
              "150010634"
            ]
          },
          "150010634": {
            "id": "150010634",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "很久以来，悬木人有着一个传统仪式，名叫回火夜，为的是祭祀五百年前的先祖布基纳和他的伙伴——山王康加玛托。",
            "nextDialogs": [
              "150010635"
            ]
          },
          "150010635": {
            "id": "150010635",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "布基纳是持有古名「马力{RUBY#[D]回火}卜」的英雄，康加玛托则是一只强大的匿叶龙战士。他们曾并肩抗击深渊。",
            "nextDialogs": [
              "150010636"
            ]
          },
          "150010636": {
            "id": "150010636",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "最后虽然他们获得了胜利，但先祖却付出了生命的代价，而山王也被污染，一直沉睡至今。",
            "nextDialogs": [
              "150010637"
            ]
          },
          "150010637": {
            "id": "150010637",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "它的状态不正常，因为匿叶龙的寿命最多不过百年，或许是深渊的能量让它成了例外。",
            "nextDialogs": [
              "150010638"
            ]
          },
          "150010638": {
            "id": "150010638",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它活到了现在？",
            "nextDialogs": [
              "150010639"
            ]
          },
          "150010639": {
            "id": "150010639",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "没错，山王是我们活着的荣耀，但这荣耀也伴随代价。",
            "nextDialogs": [
              "150010640"
            ]
          },
          "150010640": {
            "id": "150010640",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "它体内的深渊能量极易受到刺激，而它一旦受刺激醒来，就会发狂地攻击周围所有活物…",
            "nextDialogs": [
              "150010641"
            ]
          },
          "150010641": {
            "id": "150010641",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "所以每年的回火夜除了祭祀外，还有重要的任务，就是清理山王体内的深渊力量，让它继续保持沉睡。",
            "nextDialogs": [
              "150010642"
            ]
          },
          "150010642": {
            "id": "150010642",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "虽然两位帮助我们解决了纳塔的深渊危机，但那灾害的余波，似乎让山王的沉睡不稳定起来。",
            "nextDialogs": [
              "150010643"
            ]
          },
          "150010643": {
            "id": "150010643",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "距离上一次回火夜才过去五个月，它又有了暴动的迹象。",
            "nextDialogs": [
              "150010644"
            ]
          },
          "150010644": {
            "id": "150010644",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它…醒来了吗？",
            "nextDialogs": [
              "150010645"
            ]
          },
          "150010645": {
            "id": "150010645",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "嗯，我们立刻进行了一次简易仪式，勉强控制了局面，但它随时会再醒来。",
            "nextDialogs": [
              "150010646"
            ]
          },
          "150010646": {
            "id": "150010646",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "我的伙伴南娜，就在这次简易仪式里被山王击伤，因此也遭受了溢出的污染…",
            "nextDialogs": [
              "150010647"
            ]
          },
          "150010647": {
            "id": "150010647",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "大叔…我们知道…很抱歉听到这个消息。",
            "nextDialogs": [
              "150010648"
            ]
          },
          "150010648": {
            "id": "150010648",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "唉…南娜已经不是第一个了…",
            "nextDialogs": [
              "150010649"
            ]
          },
          "150010649": {
            "id": "150010649",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "总之，现在我们需要一位合适的游火人，来主持一次额外的回火夜。我听闻了两位的冒险故事，你们是不二之选。",
            "nextDialogs": [
              "150010650"
            ]
          },
          "150010650": {
            "id": "150010650",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但你们应该有自己的游火人吧？",
            "nextDialogs": [
              "150010651"
            ]
          },
          "150010651": {
            "id": "150010651",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "当然，我们可是有着继承「马力{RUBY#[D]回火}卜」的英雄呢。",
            "nextDialogs": [
              "150010652"
            ]
          },
          "150010652": {
            "id": "150010652",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，是基尼奇！",
            "nextDialogs": [
              "150010653"
            ]
          },
          "150010653": {
            "id": "150010653",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "没错，就是他。他可是个真正的英雄，正在忙着他的摩拉大业。当我找到他时，猜猜他是怎么说的？",
            "nextDialogs": [
              "150010654"
            ]
          },
          "150010654": {
            "id": "150010654",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "「额外的仪式？那是额外的价格。」天知道他有多在乎价格！"
          },
          "150010616": {
            "id": "150010616",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "一百万摩拉？哈哈哈！年轻人，我倒是开始有点欣赏你了。"
          }
        }
      }
    },
    {
      "subId": "1500107",
      "subQuestName": "点燃传火盆(3/6)",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150010701"
        ],
        "dialogs": {
          "150010701": {
            "id": "150010701",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "啧，果然还有些残留的深渊污染，山王的暴动应该和它们有关系。",
            "nextDialogs": [
              "150010702"
            ]
          },
          "150010702": {
            "id": "150010702",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "看见那些火把了吗？那是从圣火竞技场请回的次级圣火，其中蕴含了火神大人的力量。",
            "nextDialogs": [
              "150010703"
            ]
          },
          "150010703": {
            "id": "150010703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以圣火就是传说中的回火吗？",
            "nextDialogs": [
              "150010704"
            ]
          },
          "150010704": {
            "id": "150010704",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "呵呵，没人能去夜神之国请来传说中的回火。但圣火足以焚净深渊污垢，在仪式里我们可以这么看。",
            "nextDialogs": [
              "150010705"
            ]
          },
          "150010705": {
            "id": "150010705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢…那就用圣火清理掉那些污垢就可以了吧？",
            "nextDialogs": [
              "150010706"
            ]
          },
          "150010706": {
            "id": "150010706",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "这只是其中的一部分，完整的仪式要更加复杂。",
            "nextDialogs": [
              "150010707"
            ]
          },
          "150010707": {
            "id": "150010707",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "首先，游火人要在起点取来圣火种，用钩爪飞上天空连续点燃所有的圣火柱。",
            "nextDialogs": [
              "150010708"
            ]
          },
          "150010708": {
            "id": "150010708",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "然后一路向下，穿过峡隙，抵达山王沉睡的洞穴，并点燃途中的传火盆和最后的圣火祭坛。",
            "nextDialogs": [
              "150010709"
            ]
          },
          "150010709": {
            "id": "150010709",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "优秀的游火人能做到全程一次也不落地。虽然不想承认，但基尼奇可以做到。",
            "nextDialogs": [
              "150010710"
            ]
          },
          "150010710": {
            "id": "150010710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，一直飞在天上不落地吗？",
            "nextDialogs": [
              "150010711"
            ]
          },
          "150010711": {
            "id": "150010711",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙也可以做到。",
            "nextDialogs": [
              "150010712"
            ]
          },
          "150010712": {
            "id": "150010712",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "和我肯定不一样啦！听起来要难很多。",
            "nextDialogs": [
              "150010713"
            ]
          },
          "150010713": {
            "id": "150010713",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "呵呵，请放心，这不是仪式的要求，即使落地了也没关系。仪式真正的要求只有一个，那就是不能回头。",
            "nextDialogs": [
              "150010714"
            ]
          },
          "150010714": {
            "id": "150010714",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "游火人必须保持始终向前的姿态，不能越过一座圣火柱去点燃下一座再回来。那被认为是一种对先祖的亵渎。",
            "nextDialogs": [
              "150010715"
            ]
          },
          "150010715": {
            "id": "150010715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那…如果真回来了会发生什么？火不会自己灭掉吧？",
            "nextDialogs": [
              "150010716"
            ]
          },
          "150010716": {
            "id": "150010716",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "唔…搞不好会烧到自己。",
            "nextDialogs": [
              "150010717"
            ]
          },
          "150010717": {
            "id": "150010717",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们今天也要按照这个标准吗？",
            "nextDialogs": [
              "150010718"
            ]
          },
          "150010718": {
            "id": "150010718",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "放心，今天只是简单的练习，顺序无所谓，只需要用圣火清理污垢，再点燃所有传火盆就可以了。",
            "nextDialogs": [
              "150010719"
            ]
          },
          "150010719": {
            "id": "150010719",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "#{NICKNAME}，准备好试试了吗？",
            "nextDialogs": [
              "150010720"
            ]
          },
          "150010720": {
            "id": "150010720",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "开始吧。",
            "nextDialogs": [
              "150010721"
            ]
          },
          "150010721": {
            "id": "150010721",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "我再重复一遍要点，取来火种，清理污垢，然后点燃所有传火盆。我会在终点等你们。"
          }
        }
      }
    },

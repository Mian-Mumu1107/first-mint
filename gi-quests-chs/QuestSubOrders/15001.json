    {
      "subId": "1500109",
      "subQuestName": "与特立尼达交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150010301"
        ],
        "dialogs": {
          "150010301": {
            "id": "150010301",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "我果然没有看错人，您的表现比先前的几个候选人都好得多。",
            "nextDialogs": [
              "150010302"
            ]
          },
          "150010302": {
            "id": "150010302",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "要是有「游火神」之类的古名，我想您是有力竞争者。",
            "nextDialogs": [
              "150010303"
            ]
          },
          "150010303": {
            "id": "150010303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙应该也不错。",
            "nextDialogs": [
              "150010304"
            ]
          },
          "150010304": {
            "id": "150010304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！如果不在意我游得慢不慢的话…",
            "nextDialogs": [
              "150010305"
            ]
          },
          "150010305": {
            "id": "150010305",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "呵呵，现在离回火夜还有几天时间，我要回去通知首领还有其它几位长老，已经顺利找到了合适的游火人。",
            "nextDialogs": [
              "150010306"
            ]
          },
          "150010306": {
            "id": "150010306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…是要经过他们同意的意思吗？",
            "nextDialogs": [
              "150010307"
            ]
          },
          "150010307": {
            "id": "150010307",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "有些人还是希望能够说动基尼奇。但这也是因为他们还没见过你。",
            "nextDialogs": [
              "150010308"
            ]
          },
          "150010308": {
            "id": "150010308",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "寻找游火人的职责在我身上，我会去提议由你来担任。",
            "nextDialogs": [
              "150010309"
            ]
          },
          "150010309": {
            "id": "150010309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…我再确认一下哦，我们这种外地人来负责这么重要的任务，真的没问题吗？",
            "nextDialogs": [
              "150010310"
            ]
          },
          "150010310": {
            "id": "150010310",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "看见那边了吗？在比布基纳和山王还要久远的年代，那是悬木人的家园。",
            "nextDialogs": [
              "150010311"
            ]
          },
          "150010311": {
            "id": "150010311",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "因为一些变故，祖先们不得不迁离，现在那成了年轻人锤炼勇气与冒险精神的地方。",
            "nextDialogs": [
              "150010312"
            ]
          },
          "150010312": {
            "id": "150010312",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "今天如果我们不能妥善解决山王的问题，或许要不了多久，同样的事就得再来一遍。",
            "nextDialogs": [
              "150010313"
            ]
          },
          "150010313": {
            "id": "150010313",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "所以，回到您的问题，我相信所有人都会同意的。",
            "nextDialogs": [
              "150010314"
            ]
          },
          "150010314": {
            "id": "150010314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，看来事态真的很紧急…",
            "nextDialogs": [
              "150010315"
            ]
          },
          "150010315": {
            "id": "150010315",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "能否请两位之后再来我家一叙，有些仪式的细节我还要和两位详聊。",
            "nextDialogs": [
              "150010316"
            ]
          },
          "150010316": {
            "id": "150010316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们之后见哦！",
            "nextDialogs": [
              "150010317"
            ]
          },
          "150010317": {
            "id": "150010317",
            "speakerId": 14145,
            "speakerName": "特立尼达",
            "text": "请多费心了。",
            "nextDialogs": [
              "150010318"
            ]
          },
          "150010318": {
            "id": "150010318",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然参加过不少节日，感觉这次的委托还挺不一样呢。我们休息休息再去长老家吧。"
          }
        }
      }
    },
    {
      "subId": "1500100",

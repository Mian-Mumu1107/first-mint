    {
      "subId": "35723",
      "subQuestName": "(test)与安柏对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3572301"
        ],
        "dialogs": {
          "3572301": {
            "id": "3572301",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "风魔龙…竟然开始直接袭击城市内部了！",
            "nextDialogs": [
              "3572302"
            ]
          },
          "3572302": {
            "id": "3572302",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "#凯亚、{NICKNAME}，你们来得正好，我们赶快…",
            "nextDialogs": [
              "3572303"
            ]
          },
          "3572303": {
            "id": "3572303",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "等等，安柏。这里还有人没来得及互相认识吧？",
            "nextDialogs": [
              "3572304"
            ]
          },
          "3572304": {
            "id": "3572304",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "啊…好的。这是凯亚，是我们的骑兵队长。",
            "nextDialogs": [
              "3572305"
            ]
          },
          "3572305": {
            "id": "3572305",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "#这两位是远方来的旅者，{NICKNAME}和派蒙。",
            "nextDialogs": [
              "3572306"
            ]
          },
          "3572306": {
            "id": "3572306",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "（只知道是「远方」吗…）",
            "nextDialogs": [
              "3572307"
            ]
          },
          "3572307": {
            "id": "3572307",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "事情是这样的…",
            "nextDialogs": [
              "3572308"
            ]
          },
          "3572308": {
            "id": "3572308",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "原来如此，欢迎来到蒙德。但很遗憾，是在这种糟糕的时机…",
            "nextDialogs": [
              "3572309"
            ]
          },
          "3572309": {
            "id": "3572309",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "我很理解血亲分离的痛苦心情，旅行者。",
            "nextDialogs": [
              "3572310"
            ]
          },
          "3572310": {
            "id": "3572310",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "另外，虽然不知道你们为什么要找风神…",
            "nextDialogs": [
              "3572311"
            ]
          },
          "3572311": {
            "id": "3572311",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "但每个人都有自己的秘密，对吧？",
            "nextDialogs": [
              "3572312"
            ]
          },
          "3572312": {
            "id": "3572312",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哈哈，我是不会追问的。",
            "nextDialogs": [
              "3572313"
            ]
          },
          "3572313": {
            "id": "3572313",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "总之，首先我要代骑士团向你们道谢。",
            "nextDialogs": [
              "3572318",
              "3572316"
            ]
          },
          "3572318": {
            "id": "3572318",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "刚才那场抵御魔龙的战斗，被守护的市民们都是亲眼目睹了的。",
            "nextDialogs": [
              "3572319"
            ]
          },
          "3572319": {
            "id": "3572319",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "代理团长大人对两位也很有兴趣，希望能在<color=#00E1FFFF>骑士团总部</color>一叙。"
          },
          "3572316": {
            "id": "3572316",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "嗯…蒙德特色的蜜酱胡萝卜煎肉？",
            "nextDialogs": [
              "3572317"
            ]
          },
          "3572317": {
            "id": "3572317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这句话我刚才已经听过了。"
          }
        }
      }
    },

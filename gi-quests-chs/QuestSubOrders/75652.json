        "dialogs": {
          "756520201": {
            "id": "756520201",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "#是{NICKNAME}啊，又在低语森林遇到你，真是太巧了。",
            "nextDialogs": [
              "756520202"
            ]
          },
          "756520202": {
            "id": "756520202",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "有阵子不见，最近在忙些什么？",
            "nextDialogs": [
              "756520205"
            ]
          },
          "756520205": {
            "id": "756520205",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "难怪要来低语森林，这里的风景美丽又清幽，的确是留影的好地方。",
            "nextDialogs": [
              "756520206"
            ]
          },
          "756520206": {
            "id": "756520206",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "每次执行侦察任务，我最喜欢的巡逻点就是这里。",
            "nextDialogs": [
              "756520207"
            ]
          },
          "756520207": {
            "id": "756520207",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "记得第一次和你见面也是在这里，当时我还以为你是什么可疑人物呢，哎呀，想起来还有点不好意思。",
            "nextDialogs": [
              "756520208"
            ]
          },
          "756520208": {
            "id": "756520208",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "后来多靠了你，风龙危机最终被解除了，蒙德城的大家又找回了过去的安宁生活。",
            "nextDialogs": [
              "756520209"
            ]
          },
          "756520209": {
            "id": "756520209",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "#不过你的{M#妹妹}{F#哥哥}…虽然我贴了不少寻人启事，但好像没帮上忙…"
          }
        }
      }

{
  "lineCounts": {
    "另一人的留言": 1,
    "店主回复": 18,
    "留言": 24
  },
  "subQuests": [
    {
      "subId": "52001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5200101"
        ],
        "dialogs": {
          "5200101": {
            "id": "5200101",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「冈崎老爷，『锁国令』已经结束了，现在总能喝到蒲公英酒了吧？」",
            "nextDialogs": [
              "5200102"
            ]
          },
          "5200102": {
            "id": "5200102",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "已经和那边谈好了，只要等货送过来就行。",
            "nextDialogs": [
              "5200103"
            ]
          },
          "5200103": {
            "id": "5200103",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "放心吧，都记着呢。"
          }
        }
      }
    },
    {
      "subId": "52002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5200201"
        ],
        "dialogs": {
          "5200201": {
            "id": "5200201",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「那些东西，还没交出去吧？」",
            "nextDialogs": [
              "5200202"
            ]
          },
          "5200202": {
            "id": "5200202",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「要不然，我还是拿走扔掉…想到她随时可能回来，我又觉得这些东西没那么合适了。」",
            "nextDialogs": [
              "5200203"
            ]
          },
          "5200203": {
            "id": "5200203",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "姑且还由老夫保管，想拿走也没关系。",
            "nextDialogs": [
              "5200204"
            ]
          },
          "5200204": {
            "id": "5200204",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "只要您不会觉得遗憾。",
            "nextDialogs": [
              "5200205"
            ]
          },
          "5200205": {
            "id": "5200205",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「我、我再想想吧，唉…」"
          }
        }
      }
    },
    {
      "subId": "50503",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050301"
        ],
        "dialogs": {
          "5050301": {
            "id": "5050301",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「感谢冈崎前辈的疏导与讲解，令在下茅塞顿开。今后一定多多照顾前辈的生意。」",
            "nextDialogs": [
              "5050302"
            ]
          },
          "5050302": {
            "id": "5050302",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "不敢、不敢。能得天领奉行大人的羽翼之将如此高评价，实在令属下小店蓬荜生辉。",
            "nextDialogs": [
              "5050303"
            ]
          },
          "5050303": {
            "id": "5050303",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "今后若有踌躇不定之事，心怀芥蒂之事，皆可与老夫商谈，聊以释怀。"
          }
        }
      }
    },
    {
      "subId": "50504",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050401"
        ],
        "dialogs": {
          "5050401": {
            "id": "5050401",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「前日因犬子醉酒造成的桌椅损坏已照价赔偿，神里家谱代，斑目清广在此致歉。」",
            "nextDialogs": [
              "5050402"
            ]
          },
          "5050402": {
            "id": "5050402",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "斑目大人请不必多礼，小事而已。"
          }
        }
      }
    },
    {
      "subId": "50505",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050501"
        ],
        "dialogs": {
          "5050501": {
            "id": "5050501",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「绯樱酒与樱饼很好，感谢招待。」",
            "nextDialogs": [
              "5050502"
            ]
          },
          "5050502": {
            "id": "5050502",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "感谢您的光临才是。",
            "nextDialogs": [
              "5050503"
            ]
          },
          "5050503": {
            "id": "5050503",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「只是今夜的酒，口感略有不同，是否店家有意为之？」",
            "nextDialogs": [
              "5050504"
            ]
          },
          "5050504": {
            "id": "5050504",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "感谢您的品鉴，今夜的酒确是老夫为您特意准备。"
          }
        }
      }
    },
    {
      "subId": "50507",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050701"
        ],
        "dialogs": {
          "5050701": {
            "id": "5050701",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「明天要去踏鞴砂驻防了，今日一别，实在不舍。」",
            "nextDialogs": [
              "5050702"
            ]
          },
          "5050702": {
            "id": "5050702",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「希望舍妹妥善经营家中产业，但近来大家都不景气，辛苦她了。」",
            "nextDialogs": [
              "5050703"
            ]
          },
          "5050703": {
            "id": "5050703",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「希望战事早日平息，我也能早早归来，与家人一同承担家中事务。」",
            "nextDialogs": [
              "5050704"
            ]
          },
          "5050704": {
            "id": "5050704",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "年轻人请尽力宽心，老夫相信您能顺利履行责任，早日归来。"
          }
        }
      }
    },
    {
      "subId": "50508",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5050801"
        ],
        "dialogs": {
          "5050801": {
            "id": "5050801",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「九条家的天狗给我听好了！夺眼之仇老子绝不会忘！你也别给老子忘了决斗之事！！」",
            "nextDialogs": [
              "5050802"
            ]
          },
          "5050802": {
            "id": "5050802",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「老子会一直等着的！我劝你每次进来之前，都好好想想你得罪了谁！」",
            "nextDialogs": [
              "5050803"
            ]
          },
          "5050803": {
            "id": "5050803",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "这位客人，虽然不知九条裟罗大人如何亏待了您，还请时常光顾消愁。",
            "nextDialogs": [
              "5050804"
            ]
          },
          "5050804": {
            "id": "5050804",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「哈哈，那是当然！毕竟是冈崎老爷的店嘛！」"
          }
        }
      }
    },
    {
      "subId": "50510",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5051001"
        ],
        "dialogs": {
          "5051001": {
            "id": "5051001",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「春花何日有，心事浩无涯。」",
            "nextDialogs": [
              "5051002"
            ]
          },
          "5051002": {
            "id": "5051002",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "枝头留残雪，望来亦似花。"
          }
        }
      }
    },
    {
      "subId": "50511",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5051101"
        ],
        "dialogs": {
          "5051101": {
            "id": "5051101",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「终于又来了一次『乌有亭』，冈崎老爷还是那么亲切，酒也是久违的爽快！」",
            "nextDialogs": [
              "5051102"
            ]
          },
          "5051102": {
            "id": "5051102",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "哈哈，客人您谬赞了。顺便，老夫也是好久没有再听到「海山」的故事咯。",
            "nextDialogs": [
              "5051103"
            ]
          },
          "5051103": {
            "id": "5051103",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「好汉不提当年勇，冈崎老爷您就不要听我那帮兄弟们胡说八道了！」",
            "nextDialogs": [
              "5051104"
            ]
          },
          "5051104": {
            "id": "5051104",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "那是当然，你自己可还从来没与老夫讲过那些故事呢。",
            "nextDialogs": [
              "5051105"
            ]
          },
          "5051105": {
            "id": "5051105",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「哈哈，不要戏弄我啦！」"
          }
        }
      }
    },
    {
      "subId": "50516",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5051601"
        ],
        "dialogs": {
          "5051601": {
            "id": "5051601",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「鸣神岛的料亭真是不错呀…如果家乡也能开办这么像样的酒馆就好了。」",
            "nextDialogs": [
              "5051602"
            ]
          },
          "5051602": {
            "id": "5051602",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「是呀，冈崎大人也是个亲切的好人，在鸣神人中间不常见呢。」",
            "nextDialogs": [
              "5051603"
            ]
          },
          "5051603": {
            "id": "5051603",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「也不要这样说啦，作为【后面的内容被胡乱擦掉了】的大将，我还是见识过不少亲切的好人的。」",
            "nextDialogs": [
              "5051604"
            ]
          },
          "5051604": {
            "id": "5051604",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「这种内容现在不用擦掉啦！！」",
            "nextDialogs": [
              "5051605"
            ]
          },
          "5051605": {
            "id": "5051605",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "自从前线停战以后，就来了许多奇奇怪怪的新客人啊…"
          }
        }
      }
    },
    {
      "subId": "50517",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5051701"
        ],
        "dialogs": {
          "5051701": {
            "id": "5051701",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「抱歉，冈崎老爷。我食言归来了。」",
            "nextDialogs": [
              "5051702"
            ]
          },
          "5051702": {
            "id": "5051702",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "瞧瞧，老夫之前说什么来着？比起离开那时，你又长个子了。",
            "nextDialogs": [
              "5051703"
            ]
          },
          "5051703": {
            "id": "5051703",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「此世缥缈无长久，仰见丘冢慰我情。」",
            "nextDialogs": [
              "5051704"
            ]
          },
          "5051704": {
            "id": "5051704",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "「竟是今日立春时，煦煦春光解残冰。」",
            "nextDialogs": [
              "5051705"
            ]
          },
          "5051705": {
            "id": "5051705",
            "speakerId": 1000,
            "speakerName": "留言",
            "text": "「对不上呀。」",
            "nextDialogs": [
              "5051706"
            ]
          },
          "5051706": {
            "id": "5051706",
            "speakerId": 1001,
            "speakerName": "店主回复",
            "text": "你这文化人，也太为难老夫了！"
          }
        }
      }
    }
  ]
}
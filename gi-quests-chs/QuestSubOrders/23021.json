  "subQuests": [
    {
      "subId": "2302101",
      "subQuestName": "与拉菲克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230210101"
        ],
        "dialogs": {
          "230210101": {
            "id": "230210101",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "旅行者！你来得正好，船刚刚下水，十分平稳。",
            "nextDialogs": [
              "230210102"
            ]
          },
          "230210102": {
            "id": "230210102",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "我的计算果然没有任何问题！",
            "nextDialogs": [
              "230210103"
            ]
          },
          "230210103": {
            "id": "230210103",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "所以，我们说好的负载试验什么时候开始？",
            "nextDialogs": [
              "230210104"
            ]
          },
          "230210104": {
            "id": "230210104",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "别着急嘛，旅行者都来了，我们马上开始。",
            "nextDialogs": [
              "230210105"
            ]
          },
          "230210105": {
            "id": "230210105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "负载试验是什么？",
            "nextDialogs": [
              "230210106"
            ]
          },
          "230210106": {
            "id": "230210106",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "简单来说，就是用重物来测试船的负载能力。",
            "nextDialogs": [
              "230210107"
            ]
          },
          "230210107": {
            "id": "230210107",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "嗯…也就是说，需要有人和我一起把重物都搬到船上去…",
            "nextDialogs": [
              "230210108"
            ]
          },
          "230210108": {
            "id": "230210108",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "旅行者，我上次就发现你身强体壮，力量充沛，非常擅长这种工作…",
            "nextDialogs": [
              "230210111"
            ]
          },
          "230210111": {
            "id": "230210111",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "没、没有啦，我是真的没法一个人搞定这件事，只能拜托你来帮忙了。",
            "nextDialogs": [
              "230210112"
            ]
          },
          "230210112": {
            "id": "230210112",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "而且报酬绝对不会少！放心吧，我前几天刚帮人去修好了一艘大船，拿了不少钱呢！",
            "nextDialogs": [
              "230210113"
            ]
          },
          "230210113": {
            "id": "230210113",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "哦…不少钱啊…",
            "nextDialogs": [
              "230210114"
            ]
          },
          "230210114": {
            "id": "230210114",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "欸？那个，我几乎把钱都投入造船里了…",
            "nextDialogs": [
              "230210115"
            ]
          },
          "230210115": {
            "id": "230210115",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "全部？",
            "nextDialogs": [
              "230210116"
            ]
          },
          "230210116": {
            "id": "230210116",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "还留着一点！哎呀，我会请你喝咖啡的啦…",
            "nextDialogs": [
              "230210117"
            ]
          },
          "230210117": {
            "id": "230210117",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "旅行者，我们赶紧开始吧，快快快！"
          }
        }
      }
    },

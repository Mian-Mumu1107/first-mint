    {
      "subId": "2302109",
      "subQuestName": "搬货刷suite辅助环$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230210901"
        ],
        "dialogs": {
          "230210901": {
            "id": "230210901",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "唉，这艘船真能载得动这么重的东西吗…"
          }
        }
      }
    },
    {
      "subId": "2302106",
      "subQuestName": "回去和拉菲克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230210614"
        ],
        "dialogs": {
          "230210614": {
            "id": "230210614",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "好…嘞！这样就可以了，让我们来看看会发生什…",
            "nextDialogs": [
              "230210601"
            ]
          },
          "230210601": {
            "id": "230210601",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇！那边漏水了！",
            "nextDialogs": [
              "230210615"
            ]
          },
          "230210615": {
            "id": "230210615",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "什么？！",
            "nextDialogs": [
              "230210602"
            ]
          },
          "230210602": {
            "id": "230210602",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "船，船都歪了！怎么回事呀！",
            "nextDialogs": [
              "230210603"
            ]
          },
          "230210603": {
            "id": "230210603",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "快，快把东西搬下去，肯定是出问题了！",
            "nextDialogs": [
              "230210604"
            ]
          },
          "230210604": {
            "id": "230210604",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "和拉菲克匆匆忙忙地把所有东西都搬下了船…",
            "nextDialogs": [
              "230210605"
            ]
          },
          "230210605": {
            "id": "230210605",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "呼…呼…还好东西不多…",
            "nextDialogs": [
              "230210606"
            ]
          },
          "230210606": {
            "id": "230210606",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "这到底…到底是哪里出问题了…",
            "nextDialogs": [
              "230210607"
            ]
          },
          "230210607": {
            "id": "230210607",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "我当初说什么来着？你计算的那些理论数据都太极限了，这样是不可靠的。",
            "nextDialogs": [
              "230210608"
            ]
          },
          "230210608": {
            "id": "230210608",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "呼…我…我…好吧…",
            "nextDialogs": [
              "230210609"
            ]
          },
          "230210609": {
            "id": "230210609",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "不应该啊，我都算得那么精确了…",
            "nextDialogs": [
              "230210610"
            ]
          },
          "230210610": {
            "id": "230210610",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "旅行者，谢谢你帮忙，这些是报酬，请你收下吧 。",
            "nextDialogs": [
              "230210611"
            ]
          },
          "230210611": {
            "id": "230210611",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "我要回去重新计算一遍…绮珊，能再帮我一下吗？",
            "nextDialogs": [
              "230210612"
            ]
          },
          "230210612": {
            "id": "230210612",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "…说得好像我都没帮忙似的。",
            "nextDialogs": [
              "230210613"
            ]
          },
          "230210613": {
            "id": "230210613",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "交给我吧，计算完了之后记得请我喝咖啡。"
          }
        }
      }
    },
    {
      "subId": "2302107",
      "subQuestName": "测试成功$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

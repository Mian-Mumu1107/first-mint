      }
    },
    {
      "subId": "2302108",
      "subQuestName": "回去和拉菲克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230210801"
        ],
        "dialogs": {
          "230210801": {
            "id": "230210801",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "太棒了，非常成功！",
            "nextDialogs": [
              "230210802"
            ]
          },
          "230210802": {
            "id": "230210802",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "船体的结构没有问题…吃水线也很稳定，也没有倾倒。",
            "nextDialogs": [
              "230210803"
            ]
          },
          "230210803": {
            "id": "230210803",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "绮珊，你看看，我的设计和计算完美无缺！",
            "nextDialogs": [
              "230210804"
            ]
          },
          "230210804": {
            "id": "230210804",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "这才是负载试验的第一阶段，别高兴太早了。",
            "nextDialogs": [
              "230210805"
            ]
          },
          "230210805": {
            "id": "230210805",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "而且你还没有考虑到天气因素和航行时货物挪移导致的船体重心问题…",
            "nextDialogs": [
              "230210806"
            ]
          },
          "230210806": {
            "id": "230210806",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "呃…呃，我会考虑的，你就先让我高兴一下嘛…",
            "nextDialogs": [
              "230210807"
            ]
          },
          "230210807": {
            "id": "230210807",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "对了旅行者，这是你的报酬，请先收下吧。",
            "nextDialogs": [
              "230210808"
            ]
          },
          "230210808": {
            "id": "230210808",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "绮珊啊，你就不能给我打打气吗？",
            "nextDialogs": [
              "230210809"
            ]
          },
          "230210809": {
            "id": "230210809",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "可是在造船这件事上，给人打气鼓劲没用啊。",
            "nextDialogs": [
              "230210810"
            ]
          },
          "230210810": {
            "id": "230210810",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "你还是好好想想，怎么给自己的钱包打气鼓劲吧。"
          }
        }
      }
    },
    {
      "subId": "2302110",
      "subQuestName": "回去和拉菲克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230211001"
        ],
        "dialogs": {
          "230211001": {
            "id": "230211001",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "这艘船的载重能力绝对不会有问题！放心吧！"
          }
        }
      }
    }
  ]
}
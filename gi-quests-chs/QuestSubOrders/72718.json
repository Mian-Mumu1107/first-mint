        "dialogs": {
          "727180101": {
            "id": "727180101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于提瓦特煎蛋…",
            "nextDialogs": [
              "727180102"
            ]
          },
          "727180102": {
            "id": "727180102",
            "speakerId": 3018,
            "speakerName": "松本",
            "text": "哦哦，你是看到了我的委托才来的吧。不管是乌有亭还是木南料亭，都太无趣了。",
            "nextDialogs": [
              "727180103"
            ]
          },
          "727180103": {
            "id": "727180103",
            "speakerId": 3018,
            "speakerName": "松本",
            "text": "说不定在意想不到的地方，反而存在着厨艺超凡的高人，所以我才发布了那个委托。",
            "nextDialogs": [
              "727180104"
            ]
          },
          "727180104": {
            "id": "727180104",
            "speakerId": 3018,
            "speakerName": "松本",
            "text": "好了，你既然过来了，那五份提瓦特煎蛋也一定准备好了吧？",
            "nextDialogs": [
              "727180106"
            ]
          },
          "727180106": {
            "id": "727180106",
            "speakerId": 3018,
            "speakerName": "松本",
            "text": "那你准备好了之后，再拿给我吧。"
          }
        }
      }
    },
    {

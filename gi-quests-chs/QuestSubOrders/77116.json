    {
      "subId": "7711605",
      "subQuestName": "准备跟随娜斯佳前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771160501"
        ],
        "dialogs": {
          "771160501": {
            "id": "771160501",
            "speakerId": 22517,
            "speakerName": "勒庇依婶婶",
            "text": "啊！嗬…滚…烧掉！",
            "nextDialogs": [
              "771160502"
            ]
          },
          "771160502": {
            "id": "771160502",
            "speakerId": 22517,
            "speakerName": "勒庇依婶婶",
            "text": "再…再一次…成为新的…",
            "nextDialogs": [
              "771160503"
            ]
          },
          "771160503": {
            "id": "771160503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（似乎还是没有办法沟通呢。）"
          }
        }
      }
    },
    {
      "subId": "7711606",
      "subQuestName": "跟随娜斯佳前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7711611",
      "subQuestName": "(test)与娜斯佳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771160201"
        ],
        "dialogs": {
          "771160201": {
            "id": "771160201",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "这里就是我们平时玩「抓坏虫」的地方，今天大家都不在…那就由我来陪你们玩吧。",
            "nextDialogs": [
              "771160202"
            ]
          },
          "771160202": {
            "id": "771160202",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "#不过…{NICKNAME}{M#大哥哥}{F#大姐姐}和小小派蒙帮了我，一定不会是「坏虫」。",
            "nextDialogs": [
              "771160203"
            ]
          },
          "771160203": {
            "id": "771160203",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "那就让我来扮演「坏虫」吧，你们当「小鸟医生」。两个对一个，我让让你们。",
            "nextDialogs": [
              "771160204"
            ]
          },
          "771160204": {
            "id": "771160204",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "规则很简单，只要你们抓到我，就算赢了。",
            "nextDialogs": [
              "771160205"
            ]
          },
          "771160205": {
            "id": "771160205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一定要现在玩游戏吗？",
            "nextDialogs": [
              "771160206"
            ]
          },
          "771160206": {
            "id": "771160206",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "嗯，医生说过，仪式的步骤是很重要的。",
            "nextDialogs": [
              "771160207"
            ]
          },
          "771160207": {
            "id": "771160207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不用让我也不会输的。",
            "nextDialogs": [
              "771160208"
            ]
          },
          "771160208": {
            "id": "771160208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那好吧…但是我能飞，当小鸟医生肯定很在行，毕竟，飞得高，看得远嘛。",
            "nextDialogs": [
              "771160209"
            ]
          },
          "771160209": {
            "id": "771160209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "万一找不到你怎么办？",
            "nextDialogs": [
              "771160210"
            ]
          },
          "771160210": {
            "id": "771160210",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "那就到<color=#00E1FFFF>镇门口</color>会合…所以，两位准备好了吗？我们还是快快开始吧！",
            "nextDialogs": [
              "771160211"
            ]
          },
          "771160211": {
            "id": "771160211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#小鸟医生{NICKNAME}已就位。",
            "nextDialogs": [
              "771160212"
            ]
          },
          "771160212": {
            "id": "771160212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小鸟医生派蒙已就位。",
            "nextDialogs": [
              "771160213"
            ]
          },
          "771160213": {
            "id": "771160213",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "放松，闭上眼睛，倒数六十下，小鸟医生就可以开始寻找「坏虫」咯…",
            "nextDialogs": [
              "771160214"
            ]
          },
          "771160214": {
            "id": "771160214",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "六十、五十九、五十八…你在心中默默倒数着，时刻准备着开始「抓坏虫」。",
            "nextDialogs": [
              "771160215"
            ]
          },
          "771160215": {
            "id": "771160215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}！快睁眼！马上要看不到她了！",
            "nextDialogs": [
              "771160216"
            ]
          },
          "771160216": {
            "id": "771160216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你竟然偷偷睁眼！",
            "nextDialogs": [
              "771160217"
            ]
          },
          "771160217": {
            "id": "771160217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "玩游戏还是要公平点哦。",
            "nextDialogs": [
              "771160218"
            ]
          },
          "771160218": {
            "id": "771160218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇呜…不对啦，现在不是计较这些事的时候，我刚刚战略性睁眼的时候，突然想到——",
            "nextDialogs": [
              "771160219"
            ]
          },
          "771160219": {
            "id": "771160219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她可以随便跑来跑去，但我们跑到哪里都要碰壁，现在不跟上，说不定等下我们就要被困在这里了…",
            "nextDialogs": [
              "771160220"
            ]
          },
          "771160220": {
            "id": "771160220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且、而且，我们也不认识去镇门口的路啊！",
            "nextDialogs": [
              "771160221"
            ]
          },
          "771160221": {
            "id": "771160221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还是趁着现在还能看见她赶紧追上她吧！"
          }
        }
      }
    },
    {
      "subId": "7711607",
      "subQuestName": "追上娜斯佳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7711609",
      "subQuestName": "追上娜斯佳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771160901"
        ],
        "dialogs": {
          "771160901": {
            "id": "771160901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "娜斯佳——嗨呀，总算追上你了…",
            "nextDialogs": [
              "771160902"
            ]
          },
          "771160902": {
            "id": "771160902",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "咦？好厉害的小鸟医生，我还没来得及躲起来呢，就被抓住了…",
            "nextDialogs": [
              "771160903"
            ]
          },
          "771160903": {
            "id": "771160903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不是啦，我们是一直跟着你跑过来的，「抓坏虫」的游戏已经暂停了哦。",
            "nextDialogs": [
              "771160904"
            ]
          },
          "771160904": {
            "id": "771160904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很可惜这次没玩上…",
            "nextDialogs": [
              "771160905"
            ]
          },
          "771160905": {
            "id": "771160905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#下次一定！因为娜斯佳可以自由地跑来跑去，我和{NICKNAME}可不行。",
            "nextDialogs": [
              "771160906"
            ]
          },
          "771160906": {
            "id": "771160906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发现重要规则漏洞…",
            "nextDialogs": [
              "771160907"
            ]
          },
          "771160907": {
            "id": "771160907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#没错…因为娜斯佳可以自由地跑来跑去，我和{NICKNAME}可不行。",
            "nextDialogs": [
              "771160908"
            ]
          },
          "771160908": {
            "id": "771160908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以如果刚刚等你躲好了再来找你，我们很可能直接被困在树林里了！",
            "nextDialogs": [
              "771160909"
            ]
          },
          "771160909": {
            "id": "771160909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，多亏了我的精妙推理，我们现在才能会面。",
            "nextDialogs": [
              "771160910"
            ]
          },
          "771160910": {
            "id": "771160910",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哇！神机妙算的小小派蒙？",
            "nextDialogs": [
              "771160911"
            ]
          },
          "771160911": {
            "id": "771160911",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "哇！神机妙算的小小派蒙！",
            "nextDialogs": [
              "771160912"
            ]
          },
          "771160912": {
            "id": "771160912",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "…好吧，等下一次！等我回了家，再叫上大家一起来玩「抓坏虫」，一定比这一次好玩…",
            "nextDialogs": [
              "771160913"
            ]
          },
          "771160913": {
            "id": "771160913",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "刚刚这些叔叔婶婶已经告诉我怎么去找到大家了。",
            "nextDialogs": [
              "771160914"
            ]
          },
          "771160914": {
            "id": "771160914",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，说到这，刚刚你在和它们说话？它们原、原来是能沟通的吗？！",
            "nextDialogs": [
              "771160915"
            ]
          },
          "771160915": {
            "id": "771160915",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "你在说什么？他们是家人，当然可以沟通啊…",
            "nextDialogs": [
              "771160916"
            ]
          },
          "771160916": {
            "id": "771160916",
            "speakerId": 22518,
            "speakerName": "高大的树妖",
            "text": "……",
            "nextDialogs": [
              "771160917"
            ]
          },
          "771160917": {
            "id": "771160917",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "#不要担心，勒庇依婶婶，这两位是送我回家的大好人，不是坏虫…嗯嗯，我会让{M#他们}{F#她们}也长出漂亮叶子的！",
            "nextDialogs": [
              "771160918"
            ]
          },
          "771160918": {
            "id": "771160918",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（不是吧，这些大树妖是娜斯佳的家人吗？也对，她的头上还有树枝呢。不过娜斯佳怎么看都还是正常小孩的外形…）",
            "nextDialogs": [
              "771160919"
            ]
          },
          "771160919": {
            "id": "771160919",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（她说的家人不会都是树妖吧？！那等下还要跟着她进去看看吗？怎么听起来还有些可怕呢…）",
            "nextDialogs": [
              "771160920"
            ]
          },
          "771160920": {
            "id": "771160920",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（还要进去找「灰眸」的身躯…）",
            "nextDialogs": [
              "771160921"
            ]
          },
          "771160921": {
            "id": "771160921",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（既然已经答应了送她回家…）",
            "nextDialogs": [
              "771160922"
            ]
          },
          "771160922": {
            "id": "771160922",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "#…{NICKNAME}{M#大哥哥}{F#大姐姐}和小小派蒙还要继续送我回家吗？大人们总是有很多事要忙…",
            "nextDialogs": [
              "771160923"
            ]
          },
          "771160923": {
            "id": "771160923",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让娜斯佳这样一个小孩自己回家，好像还是不大好呢。",
            "nextDialogs": [
              "771160924"
            ]
          },
          "771160924": {
            "id": "771160924",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而、而且我们现在都没有见到娜斯佳说的扎拉，如果现在转身走掉，不是很可惜吗？",
            "nextDialogs": [
              "771160925"
            ]
          },
          "771160925": {
            "id": "771160925",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就当为了娜斯佳的安全…",
            "nextDialogs": [
              "771160926"
            ]
          },
          "771160926": {
            "id": "771160926",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就当为了见到扎拉…",
            "nextDialogs": [
              "771160927"
            ]
          },
          "771160927": {
            "id": "771160927",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们会把你送到你的家人身边的，半途而废可不是我们的作风。",
            "nextDialogs": [
              "771160928"
            ]
          },
          "771160928": {
            "id": "771160928",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "你们真好…在我的心里，都快要比上我的偶像弗瑞奥萨姐姐了…",
            "nextDialogs": [
              "771160929"
            ]
          },
          "771160929": {
            "id": "771160929",
            "speakerId": 22517,
            "speakerName": "勒庇依婶婶",
            "text": "…走…忙…",
            "nextDialogs": [
              "771160930"
            ]
          },
          "771160930": {
            "id": "771160930",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "嗯嗯，勒庇依婶婶你忙吧，我先走了。",
            "nextDialogs": [
              "771160931"
            ]
          },
          "771160931": {
            "id": "771160931",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "#我不能再打扰大人们了…{NICKNAME}{M#大哥哥}{F#大姐姐}和小小派蒙，我们还是继续出发吧。",
            "nextDialogs": [
              "771160932"
            ]
          },
          "771160932": {
            "id": "771160932",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好的，继续出发！等等，他们在干什么？",
            "nextDialogs": [
              "771160933"
            ]
          },
          "771160933": {
            "id": "771160933",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "嗯？他们在烧坏虫呀！新朋友中的坏虫和一些变成了坏虫的老朋友，都是要被烧掉的呢。",
            "nextDialogs": [
              "771160934"
            ]
          },
          "771160934": {
            "id": "771160934",
            "speakerId": 22308,
            "speakerName": "娜斯佳",
            "text": "「坏虫被烧掉之后，就会变成灰，滋养土地，生长出新的家人」，这样，坏掉的也能重新变好啦！"
          }
        }
      }
    },

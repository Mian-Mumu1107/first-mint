    {
      "subId": "7902907",
      "subQuestName": "回报夜鸦船长",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "680028801"
        ],
        "dialogs": {
          "680028801": {
            "id": "680028801",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "清理掉里面的丘丘人了？真是感谢你们！",
            "nextDialogs": [
              "680028802"
            ]
          },
          "680028802": {
            "id": "680028802",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "来吧，我这就告诉你们穿越海上的迷雾，找到线索的办法…",
            "nextDialogs": [
              "680028803"
            ]
          },
          "680028803": {
            "id": "680028803",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "如果你们准备好，就去礁石的另一边找我吧！"
          }
        }
      }
    },
    {
      "subId": "7902903",
      "subQuestName": "与夜鸦船长对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "680028601"
        ],
        "dialogs": {
          "680028601": {
            "id": "680028601",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "怎么样，准备好了吗！",
            "nextDialogs": [
              "680028602"
            ]
          },
          "680028602": {
            "id": "680028602",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "待会儿我会先行一步，在途径的礁石上告诉你们如何进行正确的航行！",
            "nextDialogs": [
              "680028603"
            ]
          },
          "680028603": {
            "id": "680028603",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "好了，看到那边那块石头了没，首先，你们得先往那个方向去！"
          }
        }
      }
    },

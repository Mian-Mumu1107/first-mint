  "subQuests": [
    {
      "subId": "7902908",
      "subQuestName": "（test)隐藏刷夜鸦船长$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "680028501"
        ],
        "dialogs": {
          "680028501": {
            "id": "680028501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里有一座雕像？",
            "nextDialogs": [
              "680028502"
            ]
          },
          "680028502": {
            "id": "680028502",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "唉…",
            "nextDialogs": [
              "680028503"
            ]
          },
          "680028503": {
            "id": "680028503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好，为什么在这个山洞口唉声叹气的呀…",
            "nextDialogs": [
              "680028504"
            ]
          },
          "680028504": {
            "id": "680028504",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "我呀，最近住在这个山洞里…",
            "nextDialogs": [
              "680028505"
            ]
          },
          "680028505": {
            "id": "680028505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "居然住在这种山洞里！",
            "nextDialogs": [
              "680028506"
            ]
          },
          "680028506": {
            "id": "680028506",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "我也没办法！谁叫岛上突然来了群什么剧团演员，每天敲敲打打的，吵得人根本没法睡觉…所以才找到这里，稍微安静一点。",
            "nextDialogs": [
              "680028507"
            ]
          },
          "680028507": {
            "id": "680028507",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "但是不知道从哪里来了一群丘丘人占领了我的歇息之处，我只能在外面吹冷风啦！",
            "nextDialogs": [
              "680028508"
            ]
          },
          "680028508": {
            "id": "680028508",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "唉…我在心中暗自发誓，如果有人能帮我，我就告诉他…",
            "nextDialogs": [
              "680028509"
            ]
          },
          "680028509": {
            "id": "680028509",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "告诉他什么呀？",
            "nextDialogs": [
              "680028510"
            ]
          },
          "680028510": {
            "id": "680028510",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "告诉那个帮助我的人寻找到传说中海盗秘宝的线索！虽然我也只知道四分之一啦…",
            "nextDialogs": [
              "680028511"
            ]
          },
          "680028511": {
            "id": "680028511",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "四分之一的线索？",
            "nextDialogs": [
              "680028512"
            ]
          },
          "680028512": {
            "id": "680028512",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "看起来你们也是寻求秘宝之人，怎么样，帮我解决里面的丘丘人，我就把线索的位置告诉你。",
            "nextDialogs": [
              "680028513"
            ]
          },
          "680028513": {
            "id": "680028513",
            "speakerId": 1001,
            "speakerName": "夜鸦船长",
            "text": "据说得到四份线索，就能找到曾经流落在此的海盗留下的宝藏呢！",
            "nextDialogs": [
              "680028514"
            ]
          },
          "680028514": {
            "id": "680028514",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "一言为定！"
          }
        }
      }
    },

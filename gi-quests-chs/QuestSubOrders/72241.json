    {
      "subId": "7224113",
      "subQuestName": "到达「大日御舆」顶端",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7224114",
      "subQuestName": "与阿倍良久对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7224108",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722410801"
        ],
        "dialogs": {
          "722410801": {
            "id": "722410801",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "啊啊…异乡的旅者，是汝啊。",
            "nextDialogs": [
              "722410802"
            ]
          },
          "722410802": {
            "id": "722410802",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "托汝之福，吾现在魂魄完全，已回想起了一切，真是不可思议。",
            "nextDialogs": [
              "722410803"
            ]
          },
          "722410803": {
            "id": "722410803",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "可能汝已知晓，长久以前，白夜国仅有一片黑暗，生活在此处的诸民深受深海龙嗣侵扰之害。",
            "nextDialogs": [
              "722410804"
            ]
          },
          "722410804": {
            "id": "722410804",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "那时，由吾主持建造大日御舆，从此白夜国才有了昼夜之替，也有了「白夜」这一国名。",
            "nextDialogs": [
              "722410805"
            ]
          },
          "722410805": {
            "id": "722410805",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "寓示：「自大日御舆建成之后，虽此地只有常世之夜，亦可因分黑白。」",
            "nextDialogs": [
              "722410806"
            ]
          },
          "722410806": {
            "id": "722410806",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "真是令人汗颜，在离魂归位之前，竟连大日御舆建成之日，众人云集景从之时都已忘得一干二净。",
            "nextDialogs": [
              "722410807"
            ]
          },
          "722410807": {
            "id": "722410807",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "可悲啊，那本来应是吾铭记于心之景。",
            "nextDialogs": [
              "722410808"
            ]
          },
          "722410808": {
            "id": "722410808",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "只可惜…",
            "nextDialogs": [
              "722410809"
            ]
          },
          "722410809": {
            "id": "722410809",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可惜？",
            "nextDialogs": [
              "722410810"
            ]
          },
          "722410810": {
            "id": "722410810",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "大日御舆建成，不熟悉光亮的龙嗣立刻溃败，白夜之民终于得以安养生息。",
            "nextDialogs": [
              "722410811"
            ]
          },
          "722410811": {
            "id": "722410811",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "只是一旦安定下来…人心难测，鸭胗难剥，谁也不知他人会生出何等丑恶念头。",
            "nextDialogs": [
              "722410812"
            ]
          },
          "722410812": {
            "id": "722410812",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "异乡的旅者啊，贪婪小人一有可乘之机，就想攫取…比应得之物多上太多的，财富，权力！",
            "nextDialogs": [
              "722410813"
            ]
          },
          "722410813": {
            "id": "722410813",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "这些人利用民众，开始推行大日御舆崇拜。将人心寄托于虚妄死物已是愚昧至极。",
            "nextDialogs": [
              "722410814"
            ]
          },
          "722410814": {
            "id": "722410814",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "到了最后…甚至推举「太阳{RUBY#[D]法厄同}之子」以统治白夜之国。",
            "nextDialogs": [
              "722410815"
            ]
          },
          "722410815": {
            "id": "722410815",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "太阳之子？",
            "nextDialogs": [
              "722410816"
            ]
          },
          "722410816": {
            "id": "722410816",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "正是，每一任，都会有一位稚童被选作太阳之子。",
            "nextDialogs": [
              "722410817"
            ]
          },
          "722410817": {
            "id": "722410817",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "理所当然，这些孩子尚且懵懂，根本不可能担任一国之君，如何行事，不过是一具棚头傀儡，顺从其背后那些龌龊小人们的意见。",
            "nextDialogs": [
              "722410818"
            ]
          },
          "722410818": {
            "id": "722410818",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾想要反对，却被他们指使的太阳之子判下谋逆大罪，终生监禁于此…",
            "nextDialogs": [
              "722410819"
            ]
          },
          "722410819": {
            "id": "722410819",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，太阳之子…",
            "nextDialogs": [
              "722410820"
            ]
          },
          "722410820": {
            "id": "722410820",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那岂不是总有一天，他会知道自己被人摆布…",
            "nextDialogs": [
              "722410821"
            ]
          },
          "722410821": {
            "id": "722410821",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "故，凡太阳之子，无人能长大。一旦长大，就不再那么容易被龌龊小人们操纵了。",
            "nextDialogs": [
              "722410822"
            ]
          },
          "722410822": {
            "id": "722410822",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "「太阳之子，诞辰御祝，至天马之架席，共烈日之飨…」",
            "nextDialogs": [
              "722410825"
            ]
          },
          "722410825": {
            "id": "722410825",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "嗯，他们全都被送至了大日御舆内部，于诞生祭礼，盛装打扮，兴高采烈之时…",
            "nextDialogs": [
              "722410826"
            ]
          },
          "722410826": {
            "id": "722410826",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "…藏于此处的物件，就与他们有关。",
            "nextDialogs": [
              "722410827"
            ]
          },
          "722410827": {
            "id": "722410827",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "这是证明太阳之子正身的御辔，吾藏于此，想以后将之递出，可让世人警醒，只不过，时至今日已毫无意义了。",
            "nextDialogs": [
              "722410828"
            ]
          },
          "722410828": {
            "id": "722410828",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "异乡的旅者啊，那些孩子，这个国家，是吾无法保护完全的事物。",
            "nextDialogs": [
              "722410829"
            ]
          },
          "722410829": {
            "id": "722410829",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾乃…",
            "nextDialogs": [
              "722410830"
            ]
          },
          "722410830": {
            "id": "722410830",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
            "nextDialogs": [
              "722410831"
            ]
          },
          "722410831": {
            "id": "722410831",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾主持建造大日御舆，于常夜之中高悬明亮之镜，已自以为天纵之才。",
            "nextDialogs": [
              "722410832"
            ]
          },
          "722410832": {
            "id": "722410832",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾有如此才能，如此才能啊！",
            "nextDialogs": [
              "722410833"
            ]
          },
          "722410833": {
            "id": "722410833",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾本以为可用大日御舆涤荡黑暗，但谁曾想大日御舆之上，人心之欲壑难填贪婪无餍，才是足以覆过一切的阴晦永夜。",
            "nextDialogs": [
              "722410834"
            ]
          },
          "722410834": {
            "id": "722410834",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "异乡的旅客，吾现在将此御辔交至汝之手中。",
            "nextDialogs": [
              "722410835"
            ]
          },
          "722410835": {
            "id": "722410835",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "这枚「神舆之辔」就是这段可笑至极的荒唐历史的见证…",
            "nextDialogs": [
              "722410836"
            ]
          },
          "722410836": {
            "id": "722410836",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "请务必好好留存…不，就随汝喜好处置吧。",
            "nextDialogs": [
              "722410837"
            ]
          },
          "722410837": {
            "id": "722410837",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "过于贵重了…",
            "nextDialogs": [
              "722410838"
            ]
          },
          "722410838": {
            "id": "722410838",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "此物本就已无甚意义，今日能魂魄归一，将此物交到汝手上，时也命也，对此物来说，或也算是一类善终了。",
            "nextDialogs": [
              "722410839"
            ]
          },
          "722410839": {
            "id": "722410839",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "如此才能…如此才能啊…"
          }
        }
      }
    }
  ]
}
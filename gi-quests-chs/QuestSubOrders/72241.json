{
  "lineCounts": {
    "Player": 12,
    "派蒙": 20,
    "阿倍良久": 86
  },
  "subQuests": [
    {
      "subId": "7224102",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722410201"
        ],
        "dialogs": {
          "722410201": {
            "id": "722410201",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "啊啊…异乡的旅者，是汝啊。",
            "nextDialogs": [
              "722410202"
            ]
          },
          "722410202": {
            "id": "722410202",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "托汝之福，吾现在魂魄完全，已回想起了一切，真是不可思议。",
            "nextDialogs": [
              "722410203"
            ]
          },
          "722410203": {
            "id": "722410203",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "可能汝已知晓，长久以前，白夜国仅有一片黑暗，生活在此处的诸民深受深海龙嗣侵扰之害。",
            "nextDialogs": [
              "722410204"
            ]
          },
          "722410204": {
            "id": "722410204",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "那时，由吾主持建造大日御舆，从此白夜国才有了昼夜之替，也有了「白夜」这一国名。",
            "nextDialogs": [
              "722410205"
            ]
          },
          "722410205": {
            "id": "722410205",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "寓示：「自大日御舆建成之后，虽此地只有常世之夜，亦可因分黑白。」",
            "nextDialogs": [
              "722410206"
            ]
          },
          "722410206": {
            "id": "722410206",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "真是令人汗颜，在离魂归位之前，竟连大日御舆建成之日，众人云集景从之时都已忘得一干二净。",
            "nextDialogs": [
              "722410207"
            ]
          },
          "722410207": {
            "id": "722410207",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "可悲啊，那本来应是吾铭记于心之景。",
            "nextDialogs": [
              "722410208"
            ]
          },
          "722410208": {
            "id": "722410208",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "只可惜…",
            "nextDialogs": [
              "722410209"
            ]
          },
          "722410209": {
            "id": "722410209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可惜？",
            "nextDialogs": [
              "722410210"
            ]
          },
          "722410210": {
            "id": "722410210",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "大日御舆建成，不熟悉光亮的龙嗣立刻溃败，白夜之民终于得以安养生息。",
            "nextDialogs": [
              "722410211"
            ]
          },
          "722410211": {
            "id": "722410211",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "只是一旦安定下来…人心难测，鸭胗难剥，谁也不知他人会生出何等丑恶念头。",
            "nextDialogs": [
              "722410212"
            ]
          },
          "722410212": {
            "id": "722410212",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "异乡的旅者啊，贪婪小人一有可乘之机，就想攫取…比应得之物多上太多的，财富，权力！",
            "nextDialogs": [
              "722410213"
            ]
          },
          "722410213": {
            "id": "722410213",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "这些人利用民众，开始推行大日御舆崇拜。将人心寄托于虚妄死物已是愚昧至极。",
            "nextDialogs": [
              "722410214"
            ]
          },
          "722410214": {
            "id": "722410214",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "到了最后…甚至推举「太阳{RUBY#[D]法厄同}之子」以统治白夜之国。",
            "nextDialogs": [
              "722410215"
            ]
          },
          "722410215": {
            "id": "722410215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "太阳之子？",
            "nextDialogs": [
              "722410216"
            ]
          },
          "722410216": {
            "id": "722410216",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "正是，每一任，都会有一位稚童被选作太阳之子。",
            "nextDialogs": [
              "722410217"
            ]
          },
          "722410217": {
            "id": "722410217",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "理所当然，这些孩子尚且懵懂，根本不可能担任一国之君，如何行事，不过是一具棚头傀儡，顺从其背后那些龌龊小人们的意见。",
            "nextDialogs": [
              "722410218"
            ]
          },
          "722410218": {
            "id": "722410218",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾想要反对，却被他们指使的太阳之子判下谋逆大罪，终生监禁于此…",
            "nextDialogs": [
              "722410219"
            ]
          },
          "722410219": {
            "id": "722410219",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，太阳之子…",
            "nextDialogs": [
              "722410220"
            ]
          },
          "722410220": {
            "id": "722410220",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那岂不是总有一天，他会知道自己被人摆布…",
            "nextDialogs": [
              "722410221"
            ]
          },
          "722410221": {
            "id": "722410221",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "故，凡太阳之子，无人能长大。一旦长大，就不再那么容易被龌龊小人们操纵了。",
            "nextDialogs": [
              "722410222"
            ]
          },
          "722410222": {
            "id": "722410222",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "「太阳之子，诞辰御祝，至天马之架席，共烈日之飨…」",
            "nextDialogs": [
              "722410225"
            ]
          },
          "722410225": {
            "id": "722410225",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "嗯，他们全都被送至了大日御舆内部，于诞生祭礼，盛装打扮，兴高采烈之时…",
            "nextDialogs": [
              "722410226"
            ]
          },
          "722410226": {
            "id": "722410226",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "…藏于此处的物件，就与他们有关。",
            "nextDialogs": [
              "722410227"
            ]
          },
          "722410227": {
            "id": "722410227",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "这是证明太阳之子正身的御辔，吾藏于此，想以后将之递出，可让世人警醒，只不过，时至今日已毫无意义了。",
            "nextDialogs": [
              "722410228"
            ]
          },
          "722410228": {
            "id": "722410228",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "异乡的旅者啊，那些孩子，这个国家，是吾无法保护完全的事物。",
            "nextDialogs": [
              "722410229"
            ]
          },
          "722410229": {
            "id": "722410229",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾乃…",
            "nextDialogs": [
              "722410230"
            ]
          },
          "722410230": {
            "id": "722410230",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
            "nextDialogs": [
              "722410231"
            ]
          },
          "722410231": {
            "id": "722410231",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾主持建造大日御舆，于常夜之中高悬明亮之镜，已自以为天纵之才。",
            "nextDialogs": [
              "722410232"
            ]
          },
          "722410232": {
            "id": "722410232",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾有如此才能，如此才能啊！",
            "nextDialogs": [
              "722410233"
            ]
          },
          "722410233": {
            "id": "722410233",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾本以为可用大日御舆涤荡黑暗，但谁曾想大日御舆之上，人心之欲壑难填贪婪无餍，才是足以覆过一切的阴晦永夜。",
            "nextDialogs": [
              "722410234"
            ]
          },
          "722410234": {
            "id": "722410234",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "异乡的旅客，吾现在将此御辔交至汝之手中。",
            "nextDialogs": [
              "722410235"
            ]
          },
          "722410235": {
            "id": "722410235",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "这枚「神舆之辔」就是这段可笑至极的荒唐历史的见证…",
            "nextDialogs": [
              "722410236"
            ]
          },
          "722410236": {
            "id": "722410236",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "请务必好好留存…不，就随汝喜好处置吧。",
            "nextDialogs": [
              "722410237"
            ]
          },
          "722410237": {
            "id": "722410237",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "过于贵重了…",
            "nextDialogs": [
              "722410238"
            ]
          },
          "722410238": {
            "id": "722410238",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "此物本就已无甚意义，今日能魂魄归一，将此物交到汝手上，时也命也，对此物来说，或也算是一类善终了。",
            "nextDialogs": [
              "722410239"
            ]
          },
          "722410239": {
            "id": "722410239",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "如此才能…如此才能啊…"
          }
        }
      }
    },
    {
      "subId": "7224103",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722410301"
        ],
        "dialogs": {
          "722410301": {
            "id": "722410301",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "啊…烦请汝取回位于狭间之街，灵庙之前与蛇心之地三处的供奉。这样，吾魂魄归一，即可打开大日御舆之上的道路…"
          }
        }
      }
    },
    {
      "subId": "7224104",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722410401"
        ],
        "dialogs": {
          "722410401": {
            "id": "722410401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "供奉完成了…",
            "nextDialogs": [
              "722410402"
            ]
          },
          "722410402": {
            "id": "722410402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "之前听残魂先生的说法，献祭能够打开大日御舆之上的道路…",
            "nextDialogs": [
              "722410403"
            ]
          },
          "722410403": {
            "id": "722410403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，不如我们快上去看一下吧！"
          }
        }
      }
    },
    {
      "subId": "7224105",

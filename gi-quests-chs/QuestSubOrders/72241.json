    {
      "subId": "7224106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722410601"
        ],
        "dialogs": {
          "722410601": {
            "id": "722410601",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾乃…",
            "nextDialogs": [
              "722410602"
            ]
          },
          "722410602": {
            "id": "722410602",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
            "nextDialogs": [
              "722410603"
            ]
          },
          "722410603": {
            "id": "722410603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我、我是派蒙。",
            "nextDialogs": [
              "722410605",
              "722410610"
            ]
          },
          "722410605": {
            "id": "722410605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "在对方报上名字的时候，你也要报上名字……",
            "nextDialogs": [
              "722410606"
            ]
          },
          "722410606": {
            "id": "722410606",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "据说是有这样的礼节的。",
            "nextDialogs": [
              "722410607"
            ]
          },
          "722410607": {
            "id": "722410607",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "无妨。汝等远道而来，吾以此狼狈姿态，亦无法进行接待，也是失礼之至。",
            "nextDialogs": [
              "722410608"
            ]
          },
          "722410608": {
            "id": "722410608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#没有关系，{NICKNAME}和我也不会介意的。",
            "nextDialogs": [
              "722410613"
            ]
          },
          "722410613": {
            "id": "722410613",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，这位残魂先生为什么会留在这里呢？",
            "nextDialogs": [
              "722410614"
            ]
          },
          "722410614": {
            "id": "722410614",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾…吾乃赫利俄斯的建造者，此处为…吾殒命之处。",
            "nextDialogs": [
              "722410615"
            ]
          },
          "722410615": {
            "id": "722410615",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "在黑暗冰冷之所，昏昏睡去便再无法醒来…吾怎可这样死去，吾可是，赫利俄斯之建造者！",
            "nextDialogs": [
              "722410616"
            ]
          },
          "722410616": {
            "id": "722410616",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "赫利俄斯的建造者？",
            "nextDialogs": [
              "722410617"
            ]
          },
          "722410617": {
            "id": "722410617",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "赫利俄斯是什么呀？",
            "nextDialogs": [
              "722410618"
            ]
          },
          "722410618": {
            "id": "722410618",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "啊…是了，赫利俄斯只是建造时吾私下的称谓。",
            "nextDialogs": [
              "722410619"
            ]
          },
          "722410619": {
            "id": "722410619",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "虽然不知汝等是否知晓，不过，白夜国民所熟知的名字是…",
            "nextDialogs": [
              "722410620"
            ]
          },
          "722410620": {
            "id": "722410620",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "大日御舆。",
            "nextDialogs": [
              "722410621"
            ]
          },
          "722410621": {
            "id": "722410621",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "赫利俄斯即大日御舆，运载「许伯{RUBY#[D]白夜之光}利翁」的太阳之车。"
          },
          "722410610": {
            "id": "722410610",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "……是么，竟是来自异乡的旅客啊。",
            "nextDialogs": [
              "722410611"
            ]
          },
          "722410611": {
            "id": "722410611",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "汝远道而来，吾以此狼狈姿态，亦无法进行接待。",
            "nextDialogs": [
              "722410612"
            ]
          },
          "722410612": {
            "id": "722410612",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没关系的。"
          }
        }
      }
    },

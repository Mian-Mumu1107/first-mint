  "subQuests": [
    {
      "subId": "2303801",
      "subQuestName": "与扎卡里亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230380101"
        ],
        "dialogs": {
          "230380101": {
            "id": "230380101",
            "speakerId": 1000,
            "speakerName": "扎卡里亚",
            "text": "旅行者！旅行者，请快些过来，我有事情想请你帮忙。",
            "nextDialogs": [
              "230380102"
            ]
          },
          "230380102": {
            "id": "230380102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么了？",
            "nextDialogs": [
              "230380103"
            ]
          },
          "230380103": {
            "id": "230380103",
            "speakerId": 1000,
            "speakerName": "扎卡里亚",
            "text": "你还记得马鲁夫吗？就那位阿如村的医生，之前拜托你找我要过药方的那位。",
            "nextDialogs": [
              "230380104"
            ]
          },
          "230380104": {
            "id": "230380104",
            "speakerId": 1000,
            "speakerName": "扎卡里亚",
            "text": "这家伙自己试吃了一碗自己熬的药，结果整个人上吐下泻了好几天。",
            "nextDialogs": [
              "230380105"
            ]
          },
          "230380105": {
            "id": "230380105",
            "speakerId": 1000,
            "speakerName": "扎卡里亚",
            "text": "我一问才知道，因为病人喝了药汤之后没有效果，他就突发奇想，想要自己改造一下药方。",
            "nextDialogs": [
              "230380106"
            ]
          },
          "230380106": {
            "id": "230380106",
            "speakerId": 1000,
            "speakerName": "扎卡里亚",
            "text": "真不知道这家伙往药汤里加入了什么药材，能把自己搞成现在这样…",
            "nextDialogs": [
              "230380107"
            ]
          },
          "230380107": {
            "id": "230380107",
            "speakerId": 1000,
            "speakerName": "扎卡里亚",
            "text": "唉，如果他只是在原来药汤的基础上调整药材的比例和药汤做法，绝不会出现这种事。",
            "nextDialogs": [
              "230380108"
            ]
          },
          "230380108": {
            "id": "230380108",
            "speakerId": 1000,
            "speakerName": "扎卡里亚",
            "text": "他也不是第一次吃这种亏了，怎么还是…",
            "nextDialogs": [
              "230380109"
            ]
          },
          "230380109": {
            "id": "230380109",
            "speakerId": 1000,
            "speakerName": "扎卡里亚",
            "text": "算了，说不定他也有自己的苦衷吧。",
            "nextDialogs": [
              "230380110"
            ]
          },
          "230380110": {
            "id": "230380110",
            "speakerId": 1000,
            "speakerName": "扎卡里亚",
            "text": "旅行者，如果你愿意的话，能帮我去拿点药材回来吗？这回我亲自做一副药，请你直接带给马鲁夫吧。",
            "nextDialogs": [
              "230380114",
              "230380113"
            ]
          },
          "230380114": {
            "id": "230380114",
            "speakerId": 1000,
            "speakerName": "扎卡里亚",
            "text": "马鲁夫这次改的药方，是我上次开给他用来治疗头疼的药方。",
            "nextDialogs": [
              "230380115"
            ]
          },
          "230380115": {
            "id": "230380115",
            "speakerId": 1000,
            "speakerName": "扎卡里亚",
            "text": "我的药方里还差三枚赤念果，拜托你帮我去采三枚回来吧。"
          },
          "230380113": {
            "id": "230380113",
            "speakerId": 1000,
            "speakerName": "扎卡里亚",
            "text": "是啊，我都忘了这是多少次了。还好他不经手那种药性猛烈的药方，不然…"
          }
        }
      }
    },

        "dialogs": {
          "790080101": {
            "id": "790080101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "应该就是这个了吧！",
            "nextDialogs": [
              "790080102"
            ]
          },
          "790080102": {
            "id": "790080102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？旁边还有一封信…",
            "nextDialogs": [
              "790080103"
            ]
          },
          "790080103": {
            "id": "790080103",
            "speakerId": 1001,
            "speakerName": "芭芭拉的信",
            "text": "致有缘来到这里的朋友，",
            "nextDialogs": [
              "790080104"
            ]
          },
          "790080104": {
            "id": "790080104",
            "speakerId": 1001,
            "speakerName": "芭芭拉的信",
            "text": "你好呀，远方的人。如果你能看到这封信，应该是找到了我留下的羽球。",
            "nextDialogs": [
              "790080105"
            ]
          },
          "790080105": {
            "id": "790080105",
            "speakerId": 1001,
            "speakerName": "芭芭拉的信",
            "text": "金苹果群岛上有不少跟羽球有关的游戏，我和我的朋友们在这里度过了一个非常快乐的夏天。",
            "nextDialogs": [
              "790080106"
            ]
          },
          "790080106": {
            "id": "790080106",
            "speakerId": 1001,
            "speakerName": "芭芭拉的信",
            "text": "所以我在这里留下我制作的羽球，但愿偶然发现这个羽球的你也能体验到与我相同的快乐。",
            "nextDialogs": [
              "790080107"
            ]
          },
          "790080107": {
            "id": "790080107",
            "speakerId": 1001,
            "speakerName": "芭芭拉的信",
            "text": "请尽情享受阳光、海风与夏日游戏吧。",
            "nextDialogs": [
              "790080108"
            ]
          },
          "790080108": {
            "id": "790080108",
            "speakerId": 1001,
            "speakerName": "芭芭拉的信",
            "text": "——芭芭拉",
            "nextDialogs": [
              "790080109"
            ]
          },
          "790080109": {
            "id": "790080109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不愧是芭芭拉，托她的福，我们也有羽球啦！走吧，让我们玩个痛快！"
          }
        }
      }
    },

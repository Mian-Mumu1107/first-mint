    {
      "subId": "20059020",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005902001"
        ],
        "dialogs": {
          "2005902001": {
            "id": "2005902001",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "唔，不过只是单单一句「好卖的东西」，你肯定也不知道找什么。",
            "nextDialogs": [
              "2005902002"
            ]
          },
          "2005902002": {
            "id": "2005902002",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "我想想，不如你去找找<color=#00E1FFFF>「和丘丘人有关的战利品」</color>吧！",
            "nextDialogs": [
              "2005902003"
            ]
          },
          "2005902003": {
            "id": "2005902003",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "那些想要彰显自己实力的冒险家们，说不定会很感兴趣。"
          }
        }
      }
    },
    {
      "subId": "20059040",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005904001"
        ],
        "dialogs": {
          "2005904001": {
            "id": "2005904001",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "记好了，是<color=#00E1FFFF>「和丘丘人有关的战利品」</color>。",
            "nextDialogs": [
              "2005904002"
            ]
          },
          "2005904002": {
            "id": "2005904002",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "嘿嘿，看我怎么大赚一笔…"
          }
        }
      }
    },
    {
      "subId": "20059060",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005906001"
        ],
        "dialogs": {
          "2005906001": {
            "id": "2005906001",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "一定能卖个好价钱。",
            "nextDialogs": [
              "2005906002"
            ]
          },
          "2005906002": {
            "id": "2005906002",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "稍等一下，等我把这个卖出去，我再好好答谢你。",
            "nextDialogs": [
              "2005906003"
            ]
          },
          "2005906003": {
            "id": "2005906003",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "你看，有一个人已经看过来了…"
          }
        }
      }
    },
    {
      "subId": "20059100",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910001"
        ],
        "dialogs": {
          "2005910001": {
            "id": "2005910001",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "这个是…",
            "nextDialogs": [
              "2005910002"
            ]
          },
          "2005910002": {
            "id": "2005910002",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "客人！你眼光真不错，一眼就看中了我们店里最好的东西。",
            "nextDialogs": [
              "2005910003"
            ]
          },
          "2005910003": {
            "id": "2005910003",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "这是这位旅行者，刚从丘丘人首领手里夺下来的战利品。",
            "nextDialogs": [
              "2005910004"
            ]
          },
          "2005910004": {
            "id": "2005910004",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "那个可怕的丘丘人，不知道危害了蒙德多长时间。",
            "nextDialogs": [
              "2005910005"
            ]
          },
          "2005910005": {
            "id": "2005910005",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "就算是这位旅行者，也是经历了一场苦战呢。",
            "nextDialogs": [
              "2005910006"
            ]
          },
          "2005910006": {
            "id": "2005910006",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "是，是这么厉害的丘丘人吗？",
            "nextDialogs": [
              "2005910007"
            ]
          },
          "2005910007": {
            "id": "2005910007",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "…要是我拿着这个给塞琉斯先生，或者斯坦利先生看…",
            "nextDialogs": [
              "2005910008"
            ]
          },
          "2005910008": {
            "id": "2005910008",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "他们说不定就会对我另眼相看…",
            "nextDialogs": [
              "2005910009"
            ]
          },
          "2005910009": {
            "id": "2005910009",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "对啊客人，别担心，本店绝对为顾客保密。",
            "nextDialogs": [
              "2005910010"
            ]
          },
          "2005910010": {
            "id": "2005910010",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "别犹豫了客人，这个货物可是很抢手的哟——",
            "nextDialogs": [
              "2005910011"
            ]
          },
          "2005910011": {
            "id": "2005910011",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "我要再想想…旅行者，她说的是真的吗？"
          }
        }
      }
    },
    {
      "subId": "20059101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910101"
        ],
        "dialogs": {
          "2005910101": {
            "id": "2005910101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是真的。",
            "nextDialogs": [
              "2005910102"
            ]
          },
          "2005910102": {
            "id": "2005910102",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "那，那好吧，这个我要了。",
            "nextDialogs": [
              "2005910103"
            ]
          },
          "2005910103": {
            "id": "2005910103",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "客人好眼光，商品已经打包好了，祝您今天心情愉快！"
          }
        }
      }
    },
    {
      "subId": "20059102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910201"
        ],
        "dialogs": {
          "2005910201": {
            "id": "2005910201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是个普通的丘丘人物件…",
            "nextDialogs": [
              "2005910202"
            ]
          },
          "2005910202": {
            "id": "2005910202",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "什么？那我买了做什么？",
            "nextDialogs": [
              "2005910203"
            ]
          },
          "2005910203": {
            "id": "2005910203",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "呼…差点就付钱了，真是的，卖什么东西就如实地说啊！",
            "nextDialogs": [
              "2005910204"
            ]
          },
          "2005910204": {
            "id": "2005910204",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "我去别的地方看看了。"
          }
        }
      }
    },
    {
      "subId": "20059103",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910301"
        ],
        "dialogs": {
          "2005910301": {
            "id": "2005910301",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "(test)真的要买？",
            "nextDialogs": [
              "2005910302"
            ]
          },
          "2005910302": {
            "id": "2005910302",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "(test)成交！"
          }
        }
      }
    },
    {
      "subId": "20059104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910401"
        ],
        "dialogs": {
          "2005910401": {
            "id": "2005910401",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "刚才谢谢你，旅行者。",
            "nextDialogs": [
              "2005910402"
            ]
          },
          "2005910402": {
            "id": "2005910402",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "要不是你，我说不定就要花冤枉钱了。",
            "nextDialogs": [
              "2005910403"
            ]
          },
          "2005910403": {
            "id": "2005910403",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "这些给你吧，就当做是答谢了。"
          }
        }
      }
    },
    {
      "subId": "20059105",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910501"
        ],
        "dialogs": {
          "2005910501": {
            "id": "2005910501",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "喂！你会不会配合啊？就这么个普普通通的东西，怎么可能轻易卖出去啊！",
            "nextDialogs": [
              "2005910502"
            ]
          },
          "2005910502": {
            "id": "2005910502",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "好不容易来了个客人，真是受不了你…这个卖不出去，你也没得赚好吗？",
            "nextDialogs": [
              "2005910503"
            ]
          },
          "2005910503": {
            "id": "2005910503",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "算了算了，这些给你，赶紧走吧，别耽误我做生意。"
          }
        }
      }
    },
    {
      "subId": "20059106",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005910601"
        ],
        "dialogs": {
          "2005910601": {
            "id": "2005910601",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "嘿嘿，你还挺会配合的嘛。",
            "nextDialogs": [
              "2005910602"
            ]
          },
          "2005910602": {
            "id": "2005910602",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "喏，这是给你的酬谢，多出来的部分…就当是你的演出费了。",
            "nextDialogs": [
              "2005910603"
            ]
          },
          "2005910603": {
            "id": "2005910603",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "合作愉快，下次也拜托你了。"
          }
        }
      }
    }
  ]
}
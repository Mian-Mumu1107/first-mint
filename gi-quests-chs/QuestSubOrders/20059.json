  "subQuests": [
    {
      "subId": "2005901",
      "subQuestName": "与玛乔丽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200590101"
        ],
        "dialogs": {
          "200590101": {
            "id": "200590101",
            "speakerId": 1435,
            "speakerName": "玛乔丽",
            "text": "这下可糟糕了，怎么办呢…",
            "nextDialogs": [
              "200590102"
            ]
          },
          "200590102": {
            "id": "200590102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "200590103"
            ]
          },
          "200590103": {
            "id": "200590103",
            "speakerId": 1435,
            "speakerName": "玛乔丽",
            "text": "旅行者！你来得正好！你知道，这里是我家开的纪念品商店。",
            "nextDialogs": [
              "200590104"
            ]
          },
          "200590104": {
            "id": "200590104",
            "speakerId": 1435,
            "speakerName": "玛乔丽",
            "text": "之前，我老爹会收购其他的冒险家带回来的战利品，然后摆在店里卖。",
            "nextDialogs": [
              "200590105"
            ]
          },
          "200590105": {
            "id": "200590105",
            "speakerId": 1435,
            "speakerName": "玛乔丽",
            "text": "但是自从冒险家协会…不是那么热闹之后，我能收购的东西也越来越少。",
            "nextDialogs": [
              "200590106"
            ]
          },
          "200590106": {
            "id": "200590106",
            "speakerId": 1435,
            "speakerName": "玛乔丽",
            "text": "而且还尽是一些不怎么值钱的东西，根本没有客人愿意买。",
            "nextDialogs": [
              "200590107"
            ]
          },
          "200590107": {
            "id": "200590107",
            "speakerId": 1435,
            "speakerName": "玛乔丽",
            "text": "旅行者，你会四处冒险对吧？能不能帮帮我，去找点好卖的战利品回来？",
            "nextDialogs": [
              "200590109",
              "200590111"
            ]
          },
          "200590109": {
            "id": "200590109",
            "speakerId": 1435,
            "speakerName": "玛乔丽",
            "text": "那就拜托你了！找到之后，我一定把它卖个好价钱。"
          },
          "200590111": {
            "id": "200590111",
            "speakerId": 1435,
            "speakerName": "玛乔丽",
            "text": "抱歉，应该没人会买哦。",
            "nextDialogs": [
              "200590112"
            ]
          },
          "200590112": {
            "id": "200590112",
            "speakerId": 1435,
            "speakerName": "玛乔丽",
            "text": "因为…肯定会自己跑掉。"
          }
        }
      }
    },
    {
      "subId": "2005902",
      "subQuestName": "与玛乔丽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

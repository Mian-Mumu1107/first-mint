      }
    },
    {
      "subId": "7612204",
      "subQuestName": "同哥伦比娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761220401"
        ],
        "dialogs": {
          "761220401": {
            "id": "761220401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！这就是你们提到过的那个地方吧？上次我不在，都没能看到。",
            "nextDialogs": [
              "761220402"
            ]
          },
          "761220402": {
            "id": "761220402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真的很漂亮。",
            "nextDialogs": [
              "761220403"
            ]
          },
          "761220403": {
            "id": "761220403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我可以四处飞着看看吗？",
            "nextDialogs": [
              "761220404"
            ]
          },
          "761220404": {
            "id": "761220404",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "当然。",
            "nextDialogs": [
              "761220405"
            ]
          },
          "761220405": {
            "id": "761220405",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "喜欢的话，以后我也可以再带你们过来。",
            "nextDialogs": [
              "761220406"
            ]
          },
          "761220406": {
            "id": "761220406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是你想给我们的惊喜吗？",
            "nextDialogs": [
              "761220407"
            ]
          },
          "761220407": {
            "id": "761220407",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "原来这种程度就算派蒙心中的惊喜了吗？但还不是。",
            "nextDialogs": [
              "761220408"
            ]
          },
          "761220408": {
            "id": "761220408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有比这更厉害的？",
            "nextDialogs": [
              "761220409"
            ]
          },
          "761220409": {
            "id": "761220409",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "我们来作画吧。",
            "nextDialogs": [
              "761220410"
            ]
          },
          "761220410": {
            "id": "761220410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在这里画画吗？可是哪里有画布、画笔和颜料呀？",
            "nextDialogs": [
              "761220411"
            ]
          },
          "761220411": {
            "id": "761220411",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "很简单。",
            "nextDialogs": [
              "761220412"
            ]
          },
          "761220412": {
            "id": "761220412",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "将水面纺作画布，月光织作画笔，你我途经的轨迹就会构成画作的轮廓。",
            "nextDialogs": [
              "761220413"
            ]
          },
          "761220413": {
            "id": "761220413",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "顺着月之倒影的指引，将纯净的意念流转到脚下。"
          }
        }
      }
    },
    {
      "subId": "7612202",
      "subQuestName": "跟随月之指引，绘制图案",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761220201"
        ],
        "dialogs": {
          "761220201": {
            "id": "761220201",
            "speakerId": 15380,
            "speakerName": "努昂诺塔",
            "text": "……！",
            "nextDialogs": [
              "761220202"
            ]
          },
          "761220202": {
            "id": "761220202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "努昂诺塔！真的是水灵灵的努昂诺塔！我还以为再也见不到你了。",
            "nextDialogs": [
              "761220203"
            ]
          },
          "761220203": {
            "id": "761220203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "刚才的画作…",
            "nextDialogs": [
              "761220204"
            ]
          },
          "761220204": {
            "id": "761220204",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "我们用月光为这孩子勾勒出了形体，我在其中注入了新的力量与赐福，让它再度诞生。",
            "nextDialogs": [
              "761220205"
            ]
          },
          "761220205": {
            "id": "761220205",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "现在的它无须承载我的灵魂，它拥有独属于它自己的意志。",
            "nextDialogs": [
              "761220206"
            ]
          },
          "761220206": {
            "id": "761220206",
            "speakerId": 15380,
            "speakerName": "努昂诺塔",
            "text": "！！",
            "nextDialogs": [
              "761220207"
            ]
          },
          "761220207": {
            "id": "761220207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，它飞过来了！",
            "nextDialogs": [
              "761220208"
            ]
          },
          "761220208": {
            "id": "761220208",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "嗯，我唤醒了它与你们共度时光里的所有记忆。",
            "nextDialogs": [
              "761220210"
            ]
          },
          "761220210": {
            "id": "761220210",
            "speakerId": 15380,
            "speakerName": "努昂诺塔",
            "text": "……！……！",
            "nextDialogs": [
              "761220211"
            ]
          },
          "761220211": {
            "id": "761220211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜，太好了努昂诺塔，今后我一定会对你更加好一点。",
            "nextDialogs": [
              "761220212"
            ]
          },
          "761220212": {
            "id": "761220212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没想到是这个惊喜…我好喜欢。",
            "nextDialogs": [
              "761220213"
            ]
          },
          "761220213": {
            "id": "761220213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢你，哥伦比娅。",
            "nextDialogs": [
              "761220214"
            ]
          },
          "761220214": {
            "id": "761220214",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "没什么。能再次见到努昂诺塔，我也很高兴。",
            "nextDialogs": [
              "761220216"
            ]
          },
          "761220216": {
            "id": "761220216",
            "speakerId": 15380,
            "speakerName": "努昂诺塔",
            "text": "……！",
            "nextDialogs": [
              "761220217"
            ]
          },
          "761220217": {
            "id": "761220217",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "……",
            "nextDialogs": [
              "761220218"
            ]
          },
          "761220218": {
            "id": "761220218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（她还是那么中意努昂诺塔，但她的神情和从前相比又有不同。）",
            "nextDialogs": [
              "761220219"
            ]
          },
          "761220219": {
            "id": "761220219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（好像它之于她不仅是被创造的眷属，更是熟悉的朋友。）",
            "nextDialogs": [
              "761220220"
            ]
          },
          "761220220": {
            "id": "761220220",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "#去吧，你一定很想{M#他}{F#她}们了吧。",
            "nextDialogs": [
              "761220221"
            ]
          },
          "761220221": {
            "id": "761220221",
            "speakerId": 15380,
            "speakerName": "努昂诺塔",
            "text": "……！",
            "nextDialogs": [
              "761220222"
            ]
          },
          "761220222": {
            "id": "761220222",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "随时欢迎你们再来。"
          }
        }
      }
    },

    {
      "subId": "7612203",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761220301"
        ],
        "dialogs": {
          "761220301": {
            "id": "761220301",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "#我知道你很喜欢{NICKNAME}和派蒙，但不要给{M#他}{F#她}们添麻烦哦。",
            "nextDialogs": [
              "761220303"
            ]
          },
          "761220303": {
            "id": "761220303",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "#要是和{M#他}{F#她}们在外面玩累了的话，就回来这里休息吧。",
            "nextDialogs": [
              "761220302"
            ]
          },
          "761220302": {
            "id": "761220302",
            "speakerId": 15380,
            "speakerName": "努昂诺塔",
            "text": "……！"
          }
        }
      }

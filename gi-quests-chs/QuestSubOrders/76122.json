  },
  "subQuests": [
    {
      "subId": "7612201",
      "subQuestName": "同哥伦比娅见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761220101"
        ],
        "dialogs": {
          "761220101": {
            "id": "761220101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哥伦比娅？",
            "nextDialogs": [
              "761220102"
            ]
          },
          "761220102": {
            "id": "761220102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？奇怪，刚刚好像听到了哥伦比娅的声音…",
            "nextDialogs": [
              "761220103"
            ]
          },
          "761220103": {
            "id": "761220103",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "…嘿！",
            "nextDialogs": [
              "761220104"
            ]
          },
          "761220104": {
            "id": "761220104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫！",
            "nextDialogs": [
              "761220105"
            ]
          },
          "761220105": {
            "id": "761220105",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "你们好。",
            "nextDialogs": [
              "761220106"
            ]
          },
          "761220106": {
            "id": "761220106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不好不好，又被你吓了一大跳，你在的话怎么不早说嘛！",
            "nextDialogs": [
              "761220107"
            ]
          },
          "761220107": {
            "id": "761220107",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "我想你们已经熟悉这种游戏了，所以这次适当增加了一点难度…",
            "nextDialogs": [
              "761220108"
            ]
          },
          "761220108": {
            "id": "761220108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可恶，下次我也要找机会吓你一跳！",
            "nextDialogs": [
              "761220109"
            ]
          },
          "761220109": {
            "id": "761220109",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "好呀，那我期待着。",
            "nextDialogs": [
              "761220110"
            ]
          },
          "761220110": {
            "id": "761220110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哥伦比娅你的眼罩呢？",
            "nextDialogs": [
              "761220111"
            ]
          },
          "761220111": {
            "id": "761220111",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "哦，似乎是刚才和月灵们玩耍的时候，被它们蹭掉了。",
            "nextDialogs": [
              "761220112"
            ]
          },
          "761220112": {
            "id": "761220112",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "我平时也不用睁眼，这样没什么区别，它们喜欢的话，就让它们拿着玩玩吧。",
            "nextDialogs": [
              "761220113"
            ]
          },
          "761220113": {
            "id": "761220113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说回来，哥伦比娅不打算多去外面走走吗？",
            "nextDialogs": [
              "761220114"
            ]
          },
          "761220114": {
            "id": "761220114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不需要再躲着谁了吧。",
            "nextDialogs": [
              "761220115"
            ]
          },
          "761220115": {
            "id": "761220115",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "嗯…现在时间很多，想什么时候动身都行。",
            "nextDialogs": [
              "761220116"
            ]
          },
          "761220116": {
            "id": "761220116",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "但想到你们或许会来找我，不告而别的话，可能会让你们担心吧。",
            "nextDialogs": [
              "761220119"
            ]
          },
          "761220119": {
            "id": "761220119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀是呀，只要让我们知道你没事就好。",
            "nextDialogs": [
              "761220120"
            ]
          },
          "761220120": {
            "id": "761220120",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "好的，那我会考虑的。",
            "nextDialogs": [
              "761220121"
            ]
          },
          "761220121": {
            "id": "761220121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "只是考虑而已啊…",
            "nextDialogs": [
              "761220122"
            ]
          },
          "761220122": {
            "id": "761220122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说不定哥伦比娅就是喜欢这里。",
            "nextDialogs": [
              "761220123"
            ]
          },
          "761220123": {
            "id": "761220123",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "在这里发生的事，对我来说都是愉快的记忆。",
            "nextDialogs": [
              "761220124"
            ]
          },
          "761220124": {
            "id": "761220124",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "不过，我在这等你们还有另外一个原因。",
            "nextDialogs": [
              "761220125"
            ]
          },
          "761220125": {
            "id": "761220125",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？",
            "nextDialogs": [
              "761220126"
            ]
          },
          "761220126": {
            "id": "761220126",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "我想给你们一个惊喜。"
          }
        }
      }
    },
    {
      "subId": "7612205",
      "subQuestName": "前往惊喜地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

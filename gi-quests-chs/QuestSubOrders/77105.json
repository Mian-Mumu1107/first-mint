    {
      "subId": "7710599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771059901"
        ],
        "dialogs": {
          "771059901": {
            "id": "771059901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(派蒙在和守卫说话.….吸引了他的注意力,看看有没有别的路能够进这个花园..)",
            "nextDialogs": [
              "771059903"
            ]
          },
          "771059903": {
            "id": "771059903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，这里居然有花有草的！这还是在雪山上吗？",
            "nextDialogs": [
              "771059904"
            ]
          },
          "771059904": {
            "id": "771059904",
            "speakerId": 1000,
            "speakerName": "「灰眸」",
            "text": "感觉…越来越近了，我能感应到力量的碎片就在这里。"
          }
        }
      }
    }

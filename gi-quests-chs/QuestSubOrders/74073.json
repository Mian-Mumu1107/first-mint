  "subQuests": [
    {
      "subId": "7407301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740730101"
        ],
        "dialogs": {
          "740730101": {
            "id": "740730101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "地上的火堆还在燃烧。话说为什么这里要点火呢？明明是遗迹…",
            "nextDialogs": [
              "740730102"
            ]
          },
          "740730102": {
            "id": "740730102",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "让我来看看这个石碑上面写了什么。",
            "nextDialogs": [
              "740730103"
            ]
          },
          "740730103": {
            "id": "740730103",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "「此处乃记忆之象限，记忆之厅堂，记忆之间」。",
            "nextDialogs": [
              "740730104"
            ]
          },
          "740730104": {
            "id": "740730104",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "「生于一瞬」…「常与相违，伴你长眠，从不分离」…「烈火难及」…",
            "nextDialogs": [
              "740730105"
            ]
          },
          "740730105": {
            "id": "740730105",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "谜语啊。枫丹的古文明很喜欢，水仙十字结社也很喜欢。说不上来究竟是古制还是兴趣。",
            "nextDialogs": [
              "740730106"
            ]
          },
          "740730106": {
            "id": "740730106",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "已经尝试所有关键词检索，并没有答案。",
            "nextDialogs": [
              "740730107"
            ]
          },
          "740730107": {
            "id": "740730107",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "不过这是一个已经解开的谜题，或许答案就和火堆有关吧。",
            "nextDialogs": [
              "740730108"
            ]
          },
          "740730108": {
            "id": "740730108",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "去思考已经解开的谜真的有意义吗？",
            "nextDialogs": [
              "740730109"
            ]
          },
          "740730109": {
            "id": "740730109",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "意义还是有的。就像是你我变成了现在的样子，但是仍然有必要追寻过去发生了什么。",
            "nextDialogs": [
              "740730110"
            ]
          },
          "740730110": {
            "id": "740730110",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "确实呢。",
            "nextDialogs": [
              "740730111"
            ]
          },
          "740730111": {
            "id": "740730111",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "#那{NICKNAME}骑士，你觉得答案是什么呢？"
          }
        }
      }
    },
    {
      "subId": "7407302",
      "subQuestName": "寻找封印",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740730201"
        ],
        "dialogs": {
          "740730201": {
            "id": "740730201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "结石。",
            "nextDialogs": [
              "740730202"
            ]
          },
          "740730202": {
            "id": "740730202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然确实火烧不掉结石，而且一直会藏在人脏腑里。但是它不是一瞬诞生的吧。",
            "nextDialogs": [
              "740730203"
            ]
          },
          "740730203": {
            "id": "740730203",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "是长期的不健康饮食作息形成的，派蒙小姐。",
            "nextDialogs": [
              "740730204"
            ]
          },
          "740730204": {
            "id": "740730204",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "#那{NICKNAME}骑士，你觉得答案是什么呢？"
          }
        }
      }
    },
    {
      "subId": "7407307",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740730701"
        ],
        "dialogs": {
          "740730701": {
            "id": "740730701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "影子。",
            "nextDialogs": [
              "740730702"
            ]
          },
          "740730702": {
            "id": "740730702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦，确实是影子！烈火永远烧不掉又伴随人一生的东西。",
            "nextDialogs": [
              "740730703"
            ]
          },
          "740730703": {
            "id": "740730703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过知道这个被人解开的谜题的谜底又有什么用呢？"
          }
        }
      }
    },
    {
      "subId": "7407303",
      "subQuestName": "调查谜语石板",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740730401"
        ],
        "dialogs": {
          "740730401": {
            "id": "740730401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "影子。",
            "nextDialogs": [
              "740730402"
            ]
          },
          "740730402": {
            "id": "740730402",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "是的，影子。",
            "nextDialogs": [
              "740730403"
            ]
          },
          "740730403": {
            "id": "740730403",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "光出现的一瞬，影子也相应而生。",
            "nextDialogs": [
              "740730404"
            ]
          },
          "740730404": {
            "id": "740730404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然我们知道了答案，但门似乎已经被人打开了…接下来要怎么办？",
            "nextDialogs": [
              "740730405"
            ]
          },
          "740730405": {
            "id": "740730405",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "当然是争分夺秒地进去，看看能不能赶在前面这个解题人之前拿到我们需要的东西了。"
          }
        }
      }
    },

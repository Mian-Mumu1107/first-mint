            "speakerId": -1,
            "speakerName": "Player",
            "text": "纯水精灵泪。",
            "nextDialogs": [
              "740730302"
            ]
          },
          "740730302": {
            "id": "740730302",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "我就当你是想随便说一句很浪漫的话好了。",
            "nextDialogs": [
              "740730303"
            ]
          },
          "740730303": {
            "id": "740730303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么想都不对吧。",
            "nextDialogs": [
              "740730304"
            ]
          },
          "740730304": {
            "id": "740730304",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "#那{NICKNAME}骑士，你觉得答案是什么呢？"
          }
        }
      }
    },
    {
      "subId": "7407305",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740730501"
        ],
        "dialogs": {
          "740730501": {
            "id": "740730501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里好像不久前就有人来过欸。是不是已经打开了前面的奇妙小机关了？",
            "nextDialogs": [
              "740730502"
            ]
          },
          "740730502": {
            "id": "740730502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "地上还有火堆在燃烧。",
            "nextDialogs": [
              "740730503"
            ]
          },
          "740730503": {
            "id": "740730503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说为什么这里要点火呢？",
            "nextDialogs": [
              "740730504"
            ]
          },
          "740730504": {
            "id": "740730504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让我来看看这个石碑上面写了什么。",
            "nextDialogs": [
              "740730505"
            ]
          },
          "740730505": {
            "id": "740730505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「此处乃记忆之象…象…」",
            "nextDialogs": [
              "740730506"
            ]
          },
          "740730506": {
            "id": "740730506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "象限。",
            "nextDialogs": [
              "740730507"
            ]
          },
          "740730507": {
            "id": "740730507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「…象限。记忆之厅堂，记忆之间…」",
            "nextDialogs": [
              "740730508"
            ]
          },
          "740730508": {
            "id": "740730508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「生于一瞬」…「常与相违，伴你长眠，从不分离」…「烈火难及」…",
            "nextDialogs": [
              "740730509"
            ]
          },
          "740730509": {
            "id": "740730509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是一个谜语呢。",
            "nextDialogs": [
              "740730510"
            ]
          },
          "740730510": {
            "id": "740730510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "答案是，火！附近就有火堆！",
            "nextDialogs": [
              "740730511"
            ]
          },
          "740730511": {
            "id": "740730511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哪有谜底包含谜面的字的…",
            "nextDialogs": [
              "740730512"
            ]
          },
          "740730512": {
            "id": "740730512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，那你觉得答案是什么呢？"
          }
        }
      }
    },
    {
      "subId": "7407322",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740732201"
        ],
        "dialogs": {
          "740732201": {
            "id": "740732201",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "仔细检查了机关顶部的空间，什么都没有发现。",
            "nextDialogs": [
              "740732202"
            ]
          },
          "740732202": {
            "id": "740732202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里依旧什么都没有欸…",
            "nextDialogs": [
              "740732203"
            ]
          },
          "740732203": {
            "id": "740732203",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "所以卡特皮拉你能告诉我们，我们究竟要找什么吗？",
            "nextDialogs": [
              "740732204"
            ]
          },
          "740732204": {
            "id": "740732204",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "我们是在寻找锻铸水仙十字圣剑的材料。",
            "nextDialogs": [
              "740732205"
            ]
          },
          "740732205": {
            "id": "740732205",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "水仙十字结社依据地下之国与古枫丹的神秘哲学，在物质世界重现了必要的四种架空物质。",
            "nextDialogs": [
              "740732206"
            ]
          },
          "740732206": {
            "id": "740732206",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "无法理解。",
            "nextDialogs": [
              "740732207"
            ]
          },
          "740732207": {
            "id": "740732207",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "神秘的东西本身只作用于体验，可以说比元素力还要跳脱常理呢。",
            "nextDialogs": [
              "740732208"
            ]
          },
          "740732208": {
            "id": "740732208",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "几十年前我录入过教令院的素论派入门至中级教材，元素力也没有那么神奇。",
            "nextDialogs": [
              "740732209"
            ]
          },
          "740732209": {
            "id": "740732209",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "是吗。那反正结论上来说，这是枫丹古法与地下古国技术的交汇。",
            "nextDialogs": [
              "740732210"
            ]
          },
          "740732210": {
            "id": "740732210",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "世界上出现了「记忆」、「愿望」、「灵魂」与「人格」这四种物质。",
            "nextDialogs": [
              "740732211"
            ]
          },
          "740732211": {
            "id": "740732211",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "为了防止歧义，我们把它们叫做「记忆」之块、「愿望」之块、「灵魂」之块与「人格」之块好了。",
            "nextDialogs": [
              "740732212"
            ]
          },
          "740732212": {
            "id": "740732212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么这些东西会用来打造圣剑啊？",
            "nextDialogs": [
              "740732213"
            ]
          },
          "740732213": {
            "id": "740732213",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "水仙十字结社的神秘哲学里，神殿是宇宙的缩影，社员是众神的代行，圣油是锤炼的意志。",
            "nextDialogs": [
              "740732214"
            ]
          },
          "740732214": {
            "id": "740732214",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "圣剑，则是破开一切的「理性」。它需由完整的人之意志诞生而出。",
            "nextDialogs": [
              "740732215"
            ]
          },
          "740732215": {
            "id": "740732215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好玄乎。",
            "nextDialogs": [
              "740732216"
            ]
          },
          "740732216": {
            "id": "740732216",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "哎呀，神秘哲学是这样的。看着相似就可以攀附。当这种东西变成魔法了就假成真的了。",
            "nextDialogs": [
              "740732217"
            ]
          },
          "740732217": {
            "id": "740732217",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "总之我们赶紧去下一处地方吧。"
          }
        }
      }

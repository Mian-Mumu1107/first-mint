            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "仔细检查了机关顶部的空间，什么都没有发现。",
            "nextDialogs": [
              "740733202"
            ]
          },
          "740733202": {
            "id": "740733202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结果最后这里什么都没有吗？",
            "nextDialogs": [
              "740733203"
            ]
          },
          "740733203": {
            "id": "740733203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对，好像是东西已经被人拿走了。",
            "nextDialogs": [
              "740733204"
            ]
          },
          "740733204": {
            "id": "740733204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "究竟是谁呢？"
          }
        }
      }

          "740732302": {
            "id": "740732302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里的东西…也被人拿走了吗？",
            "nextDialogs": [
              "740732303"
            ]
          },
          "740732303": {
            "id": "740732303",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "看起来是这样。",
            "nextDialogs": [
              "740732304"
            ]
          },
          "740732304": {
            "id": "740732304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "究竟是谁会…",
            "nextDialogs": [
              "740732305"
            ]
          },
          "740732305": {
            "id": "740732305",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "是雅各布。",
            "nextDialogs": [
              "740732306"
            ]
          },
          "740732306": {
            "id": "740732306",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "我们之前在厄里那斯曾经与其发生冲突。补充订正，是最近一段时间的厄里那斯。",
            "nextDialogs": [
              "740732307"
            ]
          },
          "740732307": {
            "id": "740732307",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "之前看到大门口那个悲剧的受害者我就知道是他的手笔了。他果然还在活动啊。",
            "nextDialogs": [
              "740732308"
            ]
          },
          "740732308": {
            "id": "740732308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那他拿走这里的东西是想要干什么呢？",
            "nextDialogs": [
              "740732309"
            ]
          },
          "740732309": {
            "id": "740732309",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "很简单啊。他也想要重铸水仙十字的圣剑。因为水仙十字结社的事业还未竟呢。",
            "nextDialogs": [
              "740732310"
            ]
          },
          "740732310": {
            "id": "740732310",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "我们还是赶紧去最后一处地方吧。"
          }
        }
      }

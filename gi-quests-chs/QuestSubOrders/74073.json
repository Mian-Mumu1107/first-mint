    {
      "subId": "7407305",
      "subQuestName": "获取「记忆」之块",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740732101"
        ],
        "dialogs": {
          "740732101": {
            "id": "740732101",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "仔细检查了机关顶部的空间，什么都没有发现。",
            "nextDialogs": [
              "740732102"
            ]
          },
          "740732102": {
            "id": "740732102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "结果最后这里什么都没有吗？",
            "nextDialogs": [
              "740732103"
            ]
          },
          "740732103": {
            "id": "740732103",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "并不是，看起来是已经被人拿走了。",
            "nextDialogs": [
              "740732104"
            ]
          },
          "740732104": {
            "id": "740732104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那岂不是我们的计划已经失败了？",
            "nextDialogs": [
              "740732105"
            ]
          },
          "740732105": {
            "id": "740732105",
            "speakerId": 21048,
            "speakerName": "卡特皮拉",
            "text": "「理性」的诞生需要四个象限合一。只要我们能拿到剩下的几个，我们就还有机会。",
            "nextDialogs": [
              "740732106"
            ]
          },
          "740732106": {
            "id": "740732106",
            "speakerId": 16922,
            "speakerName": "安",
            "text": "既然如此，我们就快点去接下来的地方吧。"
          }
        }
      }
    },
    {
      "subId": "7407303",

{
  "lineCounts": {
    "Player": 4,
    "布蕾莘": 25,
    "诗黛": 15
  },
  "subQuests": [
    {
      "subId": "2400101",
      "subQuestName": "与诗黛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240010101"
        ],
        "dialogs": {
          "240010101": {
            "id": "240010101",
            "speakerId": 5019,
            "speakerName": "诗黛",
            "text": "请您帮帮忙吧，我刚才正在想着小说的情节，一个不留神，巴里亚就跑没影了…",
            "nextDialogs": [
              "240010102"
            ]
          },
          "240010102": {
            "id": "240010102",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "您确定巴里亚没有被您留在歌剧院的席位上，或者是拴在卫生间门口吗？",
            "nextDialogs": [
              "240010103"
            ]
          },
          "240010103": {
            "id": "240010103",
            "speakerId": 5019,
            "speakerName": "诗黛",
            "text": "这些地方我都找过了。就连座位底下我都找了个遍，可就是没见着巴里亚。",
            "nextDialogs": [
              "240010104"
            ]
          },
          "240010104": {
            "id": "240010104",
            "speakerId": 5019,
            "speakerName": "诗黛",
            "text": "我的小巴里亚，不会是被谁给拐走，或者是和谁一见钟情，懵懵懂懂地就跟着走了吧…",
            "nextDialogs": [
              "240010105"
            ]
          },
          "240010105": {
            "id": "240010105",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "诗黛小姐，我很确信巴里亚不会在这种事情上犯第二次错误。",
            "nextDialogs": [
              "240010106"
            ]
          },
          "240010106": {
            "id": "240010106",
            "speakerId": 5019,
            "speakerName": "诗黛",
            "text": "但巴里亚还那么小…年纪小就会不断地犯相同的错误，说不定巴里亚还会以此为乐啊。",
            "nextDialogs": [
              "240010107"
            ]
          },
          "240010107": {
            "id": "240010107",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "巴里亚的年纪一定没有您认知中的那么小。",
            "nextDialogs": [
              "240010110"
            ]
          },
          "240010110": {
            "id": "240010110",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "诗黛小姐的小狗…",
            "nextDialogs": [
              "240010111"
            ]
          },
          "240010111": {
            "id": "240010111",
            "speakerId": 5019,
            "speakerName": "诗黛",
            "text": "我的家人。",
            "nextDialogs": [
              "240010112"
            ]
          },
          "240010112": {
            "id": "240010112",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "她的家人，刚刚走失了，她正在寻求我的帮助。",
            "nextDialogs": [
              "240010113"
            ]
          },
          "240010113": {
            "id": "240010113",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "…诗黛小姐，这周围已经被咱们找了个遍，巴里亚大概已经跑去了野外。",
            "nextDialogs": [
              "240010114"
            ]
          },
          "240010114": {
            "id": "240010114",
            "speakerId": 5019,
            "speakerName": "诗黛",
            "text": "那咱们就去野外吧！",
            "nextDialogs": [
              "240010115"
            ]
          },
          "240010115": {
            "id": "240010115",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "我请求您待在城里，看看您的裙子，就算找到了巴里亚，您也是追不上它的。",
            "nextDialogs": [
              "240010116"
            ]
          },
          "240010116": {
            "id": "240010116",
            "speakerId": 5019,
            "speakerName": "诗黛",
            "text": "胡说，只要听见我说话，巴里亚准会马上跑过来！",
            "nextDialogs": [
              "240010117"
            ]
          },
          "240010117": {
            "id": "240010117",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "那咱们之前围着歌剧院嚷嚷了那么久，想必它是没听见了。",
            "nextDialogs": [
              "240010118"
            ]
          },
          "240010118": {
            "id": "240010118",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "让巴里亚乖乖回到诗黛小姐身边，不是我一个人能做到的事…",
            "nextDialogs": [
              "240010119"
            ]
          },
          "240010119": {
            "id": "240010119",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "考虑到我的工作职责，我不可能离开岗位太久，也不可能让另外一位同事和我一起暂时离岗。",
            "nextDialogs": [
              "240010120"
            ]
          },
          "240010120": {
            "id": "240010120",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "旅行者，如果您愿意的话，可以帮助一下我和诗黛小姐吗？"
          }
        }
      }
    },
    {
      "subId": "2400102",
      "subQuestName": "跟随布蕾莘",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2400103",
      "subQuestName": "跟随布蕾莘",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240010301"
        ],
        "dialogs": {
          "240010301": {
            "id": "240010301",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "果然在这里，看来它的情况还不错。",
            "nextDialogs": [
              "240010302"
            ]
          },
          "240010302": {
            "id": "240010302",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "诗黛小姐什么时候才能意识到，小狗不喜欢歌剧，也不喜欢听她的小说呢？",
            "nextDialogs": [
              "240010303"
            ]
          },
          "240010303": {
            "id": "240010303",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "我们回去吧，诗黛小姐肯定等急了。"
          }
        }
      }
    },
    {
      "subId": "2400104",
      "subQuestName": "向诗黛回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240010401"
        ],
        "dialogs": {
          "240010401": {
            "id": "240010401",
            "speakerId": 5019,
            "speakerName": "诗黛",
            "text": "巴里亚！我的宝贝，天哪，你去哪里了？",
            "nextDialogs": [
              "240010402"
            ]
          },
          "240010402": {
            "id": "240010402",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "它只是找了个清净的地方待了一会，给自己稍微放了个假。",
            "nextDialogs": [
              "240010403"
            ]
          },
          "240010403": {
            "id": "240010403",
            "speakerId": 5019,
            "speakerName": "诗黛",
            "text": "我真是担心得要命，谢谢你，布蕾莘警官，我的下一部小说一定会提到您！",
            "nextDialogs": [
              "240010404"
            ]
          },
          "240010404": {
            "id": "240010404",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "感谢您的好意，但还是请您省下这些笔墨吧，没人会对一名警官的日常生活感兴趣的。",
            "nextDialogs": [
              "240010405"
            ]
          },
          "240010405": {
            "id": "240010405",
            "speakerId": 5019,
            "speakerName": "诗黛",
            "text": "那我就将您的故事写得跌宕起伏…保证有趣！",
            "nextDialogs": [
              "240010406"
            ]
          },
          "240010406": {
            "id": "240010406",
            "speakerId": 5113,
            "speakerName": "布蕾莘",
            "text": "您这句有趣的承诺就足够让我的心情跌宕起伏了。",
            "nextDialogs": [
              "240010407"
            ]
          },
          "240010407": {
            "id": "240010407",
            "speakerId": 5019,
            "speakerName": "诗黛",
            "text": "结尾还得发人深省！让我想想，给您安排个什么队友好呢…"
          }
        }
      }
    },
    {
      "subId": "2400105",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240010501"
        ],
        "dialogs": {
          "240010501": {
            "id": "240010501",
            "speakerId": 5019,
            "speakerName": "诗黛",
            "text": "难道是巴里亚不喜欢我新写的小说？唉，明明其他人都评价不错…",
            "nextDialogs": [
              "240010502"
            ]
          },
          "240010502": {
            "id": "240010502",
            "speakerId": 5019,
            "speakerName": "诗黛",
            "text": "唉，下次我得挑一篇更好的念给它听了…"
          }
        }
      }
    },
    {
      "subId": "2400199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240019901"
        ],
        "dialogs": {
          "240019901": {
            "id": "240019901",
            "speakerId": 31028,
            "speakerName": "布蕾莘",
            "text": "巴里亚不喜欢太热闹的地方，歌剧肯定让它烦躁不安，所以才逃开了。",
            "nextDialogs": [
              "240019902"
            ]
          },
          "240019902": {
            "id": "240019902",
            "speakerId": 31028,
            "speakerName": "布蕾莘",
            "text": "它说不定会藏在草丛里…往前走走，去那片草丛里看看。",
            "nextDialogs": [
              "240019903"
            ]
          },
          "240019903": {
            "id": "240019903",
            "speakerId": 31028,
            "speakerName": "布蕾莘",
            "text": "没有…唔，去别处找找…"
          }
        }
      }
    }
  ]
}
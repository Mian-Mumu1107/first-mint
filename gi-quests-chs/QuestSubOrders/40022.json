    {
      "subId": "4002211",
      "subQuestName": "与「式大将」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400221101"
        ],
        "dialogs": {
          "400221101": {
            "id": "400221101",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "三位，你们回来了！",
            "nextDialogs": [
              "400221102"
            ]
          },
          "400221102": {
            "id": "400221102",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "人到齐，就该去找最后的答案了。",
            "nextDialogs": [
              "400221103"
            ]
          },
          "400221103": {
            "id": "400221103",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "你们好像恶战了一场啊。",
            "nextDialogs": [
              "400221104"
            ]
          },
          "400221104": {
            "id": "400221104",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "一场？哼…已经不知多少场了。",
            "nextDialogs": [
              "400221105"
            ]
          },
          "400221105": {
            "id": "400221105",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "我打得还不错吧，「式大将」！",
            "nextDialogs": [
              "400221106"
            ]
          },
          "400221106": {
            "id": "400221106",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "达达利亚先生对这类秘境很是熟悉，无论多强的魔物，他都能完美应对。",
            "nextDialogs": [
              "400221107"
            ]
          },
          "400221107": {
            "id": "400221107",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "我认为，我们有望突入秘境最深处。",
            "nextDialogs": [
              "400221108"
            ]
          },
          "400221108": {
            "id": "400221108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦？一起待了几天，关系亲近了不少嘛。",
            "nextDialogs": [
              "400221109"
            ]
          },
          "400221109": {
            "id": "400221109",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "哈哈，已经是战友了哦。",
            "nextDialogs": [
              "400221110"
            ]
          },
          "400221110": {
            "id": "400221110",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "重组期间，我听「式大将」说，它感到最关键的「拓本」出现了，就在那边。",
            "nextDialogs": [
              "400221111"
            ]
          },
          "400221111": {
            "id": "400221111",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "那枚「拓本」中蕴含的符法之力远超其他拓本。只要回收顺利，我应该就能回想起这座秘境的真相了。",
            "nextDialogs": [
              "400221112"
            ]
          },
          "400221112": {
            "id": "400221112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不是就在那里吗？你们怎么不过去？",
            "nextDialogs": [
              "400221113"
            ]
          },
          "400221113": {
            "id": "400221113",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "「式大将」…你是在等我们吗？",
            "nextDialogs": [
              "400221114"
            ]
          },
          "400221114": {
            "id": "400221114",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "多亏各位陪伴，我才能走到这里。",
            "nextDialogs": [
              "400221115"
            ]
          },
          "400221115": {
            "id": "400221115",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "我的记忆是靠着你们一点点找回的，至于这最后也最重要的时刻…我想请大家一起为我见证。"
          }
        }
      }
    },
    {
      "subId": "4002212",

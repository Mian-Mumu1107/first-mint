    {
      "subId": "4002205",
      "subQuestName": "回收「式大将」的「拓本」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4002203",
      "subQuestName": "与「式大将」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400220301"
        ],
        "dialogs": {
          "400220301": {
            "id": "400220301",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "一直以来零散破碎的记忆，总算汇聚成型了。",
            "nextDialogs": [
              "400220302"
            ]
          },
          "400220302": {
            "id": "400220302",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "我全都想起来了…这座「诀箓阴阳寮」的过去…它的本质。",
            "nextDialogs": [
              "400220303"
            ]
          },
          "400220303": {
            "id": "400220303",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "它不是用来试验「阴阳术」的场所，也不是滋生邪祟之物的巢穴。晴之介创造我和这座秘境的目的…是为了「守护」。",
            "nextDialogs": [
              "400220304"
            ]
          },
          "400220304": {
            "id": "400220304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「守护」？",
            "nextDialogs": [
              "400220305"
            ]
          },
          "400220305": {
            "id": "400220305",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "我们的国度曾遭到某种灾害的侵袭。那次变故夺去了晴之介最珍视的人…",
            "nextDialogs": [
              "400220306"
            ]
          },
          "400220306": {
            "id": "400220306",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "晴之介十分悔恨，因此，他开始渴求能够抵御邪祟的力量。",
            "nextDialogs": [
              "400220307"
            ]
          },
          "400220307": {
            "id": "400220307",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "他渡海前往璃月，寻访仙人，修习仙法，将这种奥妙之术与自身研习多年的「神通」相结合，缔造出了最早的「阴阳术」。",
            "nextDialogs": [
              "400220308"
            ]
          },
          "400220308": {
            "id": "400220308",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "随后，他召集有志报国的武士，又创造出我和这座阴阳寮，以我为原型制作众多「拓本」，将它们分发给武士。",
            "nextDialogs": [
              "400220309"
            ]
          },
          "400220309": {
            "id": "400220309",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "武士和「式神」组成搭档，用符法配合武艺，更为稳妥地对抗魔物。",
            "nextDialogs": [
              "400220310"
            ]
          },
          "400220310": {
            "id": "400220310",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "他们两两成组，外出与魔物战斗。战败魔物的信息会被「式神」拓写下来。",
            "nextDialogs": [
              "400220356"
            ]
          },
          "400220356": {
            "id": "400220356",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "返回秘境后，这些信息借由「镜返魔物」的姿态重现于世，充当武士训练的对手。",
            "nextDialogs": [
              "400220311"
            ]
          },
          "400220311": {
            "id": "400220311",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "我作为「式神」的统筹者，会不断吸收「拓本」们的见闻与经验，调整秘境的架构，为武士们提供更有效的训练。",
            "nextDialogs": [
              "400220312"
            ]
          },
          "400220312": {
            "id": "400220312",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "长此以往，这些志向高远的武士都能锻炼出傲人武艺。等他们离开，下一批新人又会到来。新的见闻、新的对手…循环不息。",
            "nextDialogs": [
              "400220313"
            ]
          },
          "400220313": {
            "id": "400220313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "演武的秘境？",
            "nextDialogs": [
              "400220314"
            ]
          },
          "400220314": {
            "id": "400220314",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "难怪能无止境地战斗下去…这里本就是一座训练场。",
            "nextDialogs": [
              "400220315"
            ]
          },
          "400220315": {
            "id": "400220315",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也就是说，惟神晴之介建立这座阴阳寮是为了训练武士，让他们更好地对抗魔物？",
            "nextDialogs": [
              "400220316"
            ]
          },
          "400220316": {
            "id": "400220316",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那他不就是个彻彻底底的大好人吗？",
            "nextDialogs": [
              "400220317"
            ]
          },
          "400220317": {
            "id": "400220317",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "如果是这样的话，他为什么要躲在秘境深处呢？",
            "nextDialogs": [
              "400220318"
            ]
          },
          "400220318": {
            "id": "400220318",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "不，晴之介早已不在寮内。",
            "nextDialogs": [
              "400220319"
            ]
          },
          "400220319": {
            "id": "400220319",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "不知为何，晴之介遣散了所有武士，废弃了整座秘境。",
            "nextDialogs": [
              "400220320"
            ]
          },
          "400220320": {
            "id": "400220320",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "这段记忆，这最后的碎片，还没能补全…我甚至想不起晴之介离去前对我说过什么。",
            "nextDialogs": [
              "400220321"
            ]
          },
          "400220321": {
            "id": "400220321",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "离开的意思是…他还活着？",
            "nextDialogs": [
              "400220322"
            ]
          },
          "400220322": {
            "id": "400220322",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "也许吧。至少…我希望是这样。",
            "nextDialogs": [
              "400220323"
            ]
          },
          "400220323": {
            "id": "400220323",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "我是被晴之介创造出来的一种「兵器」。我与阴阳寮的使命，是不断创造战斗，锤炼自己也锤炼他人。",
            "nextDialogs": [
              "400220324"
            ]
          },
          "400220324": {
            "id": "400220324",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "可如今这座秘境已经没用了。除了你们，没有人会来这里…被主人抛弃的兵器，还有什么价值可言呢…",
            "nextDialogs": [
              "400220325"
            ]
          },
          "400220325": {
            "id": "400220325",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "他好难过的样子…",
            "nextDialogs": [
              "400220326"
            ]
          },
          "400220326": {
            "id": "400220326",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "被主人抛弃的兵器…哈哈。",
            "nextDialogs": [
              "400220327"
            ]
          },
          "400220327": {
            "id": "400220327",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "做一把兵器也没啥不好的吧？每个在战斗中沉沦的人，都渴求着自身的意义与价值。",
            "nextDialogs": [
              "400220328"
            ]
          },
          "400220328": {
            "id": "400220328",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "是这样吗…",
            "nextDialogs": [
              "400220329"
            ]
          },
          "400220329": {
            "id": "400220329",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "你不是对我的秘密很好奇吗？为什么我能坚持抵抗秘境的排斥，为什么我能从容面对复杂无比的战局。",
            "nextDialogs": [
              "400220330"
            ]
          },
          "400220330": {
            "id": "400220330",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "我不过是在「树根」的缝隙中战斗过而已。无止境的险境、夺命的危险…只有得到这些养分，我才能更快地变强。",
            "nextDialogs": [
              "400220331"
            ]
          },
          "400220331": {
            "id": "400220331",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "我要的不是胜利，而是打磨。我想要的，就只是让自己变得锋利，变得让人畏惧。我和你一样，也是「兵器」啊。",
            "nextDialogs": [
              "400220332"
            ]
          },
          "400220332": {
            "id": "400220332",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "若是如此…你所追逐的战斗，它的终点在哪里？",
            "nextDialogs": [
              "400220333"
            ]
          },
          "400220333": {
            "id": "400220333",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "渴望结束的人才会寻找终点。我不一样，我根本不在乎这些虚无缥缈的事。",
            "nextDialogs": [
              "400220334"
            ]
          },
          "400220334": {
            "id": "400220334",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "我是为战斗而生的，只要我还活着，终点就不会出现…我选择的路，每一步都是极限。",
            "nextDialogs": [
              "400220335"
            ]
          },
          "400220335": {
            "id": "400220335",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "舍弃困惑吧。带着忧愁和犹豫，可没法成为无情的兵器啊。",
            "nextDialogs": [
              "400220336"
            ]
          },
          "400220336": {
            "id": "400220336",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "我要怎么做才能舍弃？",
            "nextDialogs": [
              "400220337"
            ]
          },
          "400220337": {
            "id": "400220337",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "我倒觉得，舍弃只是一种形容，不是真的要你丢弃什么。",
            "nextDialogs": [
              "400220338"
            ]
          },
          "400220338": {
            "id": "400220338",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "「式大将」，你不需要丢弃任何东西。",
            "nextDialogs": [
              "400220355"
            ]
          },
          "400220355": {
            "id": "400220355",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "你才刚找回记忆，现在正是捡起过去的大好机会，只要找回那件对你来说正确又重要的事就行。",
            "nextDialogs": [
              "400220339"
            ]
          },
          "400220339": {
            "id": "400220339",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "正确又重要…的事？",
            "nextDialogs": [
              "400220340"
            ]
          },
          "400220340": {
            "id": "400220340",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "我有哦。我喜欢摇滚乐。",
            "nextDialogs": [
              "400220341"
            ]
          },
          "400220341": {
            "id": "400220341",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "很少有人喜欢摇滚乐对吧？确实是冷门了些，但没关系，我高兴就好！",
            "nextDialogs": [
              "400220342"
            ]
          },
          "400220342": {
            "id": "400220342",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "别人喜不喜欢，与我何干？我只做自己想做的事！",
            "nextDialogs": [
              "400220343"
            ]
          },
          "400220343": {
            "id": "400220343",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "假如有谁爱给白眼，那就给吧！我的音乐，本来也不是给不懂行的人听的。",
            "nextDialogs": [
              "400220344"
            ]
          },
          "400220344": {
            "id": "400220344",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "曲子…我记得你弹给我的那个「测试」。",
            "nextDialogs": [
              "400220345"
            ]
          },
          "400220345": {
            "id": "400220345",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "你说你孤独地走在路上，偶尔与人在篝火旁相遇，大伙儿还会一起吃些烤鱼什么的。",
            "nextDialogs": [
              "400220346"
            ]
          },
          "400220346": {
            "id": "400220346",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "能理解这一点，说明你已经很了解人的情感了。",
            "nextDialogs": [
              "400220347"
            ]
          },
          "400220347": {
            "id": "400220347",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "我们每个人或多或少都走过这条孤独的路，你也在那里，自然是我们的同伴。所以我们会在篝火旁相遇，然后，成为朋友。",
            "nextDialogs": [
              "400220348"
            ]
          },
          "400220348": {
            "id": "400220348",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "路很难走，但我们并不孤单。「式大将」，这是我音乐中的语言，是我坚持正确之事的收获。你呢？",
            "nextDialogs": [
              "400220349"
            ]
          },
          "400220349": {
            "id": "400220349",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "一定也有必须去做的事吧？",
            "nextDialogs": [
              "400220350"
            ]
          },
          "400220350": {
            "id": "400220350",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "辛焱小姐…也许我现在还拿不出你那样的豁达。但我知道，我不能停留在此。",
            "nextDialogs": [
              "400220351"
            ]
          },
          "400220351": {
            "id": "400220351",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "前进吧，各位！我想…不，我要找回最后的「拓本」，重新掌控这座秘境。",
            "nextDialogs": [
              "400220352"
            ]
          },
          "400220352": {
            "id": "400220352",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "一定…一定还存在着只有我能做到的事。",
            "nextDialogs": [
              "400220353"
            ]
          },
          "400220353": {
            "id": "400220353",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错，振作起来，我们还要战斗呢！",
            "nextDialogs": [
              "400220354"
            ]
          },
          "400220354": {
            "id": "400220354",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "大家一起前进，就没问题啦！"
          }
        }
      }
    },

    {
      "subId": "4002206",
      "subQuestName": "与「式大将」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400220601"
        ],
        "dialogs": {
          "400220601": {
            "id": "400220601",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "并不是晴之介抛弃了我，而是我开导了他，让他放下背负了太久的重担。",
            "nextDialogs": [
              "400220602"
            ]
          },
          "400220602": {
            "id": "400220602",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "对于我和「诀箓阴阳寮」，晴之介有着美好的祝愿。非要说的话，可能是我们都有些生不逢时吧。",
            "nextDialogs": [
              "400220603"
            ]
          },
          "400220603": {
            "id": "400220603",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "武士们竭尽全力锻炼，这种锻炼也被证明是小有成效的，然而，凡人的力量终究有着极限，我们所创造的进步…太慢了。",
            "nextDialogs": [
              "400220604"
            ]
          },
          "400220604": {
            "id": "400220604",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "就在我们苦修时，那位掌握着「无想的一刀」的神明，带领着其他勤奋又强大的战士，拔除了埋藏在这片土地上的隐患。",
            "nextDialogs": [
              "400220605"
            ]
          },
          "400220605": {
            "id": "400220605",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "毕生的心血突然成了不被需要之物…想必，任何人都无法轻易接受这种结果。",
            "nextDialogs": [
              "400220606"
            ]
          },
          "400220606": {
            "id": "400220606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "神明的力量有时很残忍。",
            "nextDialogs": [
              "400220607"
            ]
          },
          "400220607": {
            "id": "400220607",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "根本没法想象那种事，但好像又听说过相似的例子…",
            "nextDialogs": [
              "400220608"
            ]
          },
          "400220608": {
            "id": "400220608",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "我迷茫过，消沉过，怀疑一切。",
            "nextDialogs": [
              "400220609"
            ]
          },
          "400220609": {
            "id": "400220609",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "可我们创造的结果，我们付出的代价，即使再怎么渺小，也是真实存在过的事物。",
            "nextDialogs": [
              "400220610"
            ]
          },
          "400220610": {
            "id": "400220610",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "不管怎么说，晴之介和武士们渴望的「目标」已经达成了，武士们不用再埋头苦练了…",
            "nextDialogs": [
              "400220611"
            ]
          },
          "400220611": {
            "id": "400220611",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "这本该是一件值得庆贺的事。晴之介是因为太有感情，太过在乎世间的一切，才会拘泥于自己失去的东西。",
            "nextDialogs": [
              "400220612"
            ]
          },
          "400220612": {
            "id": "400220612",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "「守护」是我们共同的心愿。晴之介想要「守护」大家…那么，我就「守护」晴之介吧。",
            "nextDialogs": [
              "400220613"
            ]
          },
          "400220613": {
            "id": "400220613",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "作为晴之介最得意的造物，也是他在这「诀箓阴阳寮」中唯一的挚友，我劝导了他。",
            "nextDialogs": [
              "400220614"
            ]
          },
          "400220614": {
            "id": "400220614",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "他告诉我，他要去寻找新的「意义」，也许需要一个月，一年，或是几百年。无论多久，我都期盼着有朝一日他能完成心愿回到这里。",
            "nextDialogs": [
              "400220615"
            ]
          },
          "400220615": {
            "id": "400220615",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "日复一日的等待中，我陷入了沉睡…",
            "nextDialogs": [
              "400220616"
            ]
          },
          "400220616": {
            "id": "400220616",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "晴之介啊…你应该是不会回来了吧。",
            "nextDialogs": [
              "400220617"
            ]
          },
          "400220617": {
            "id": "400220617",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "别太难过，「式大将」…",
            "nextDialogs": [
              "400220618"
            ]
          },
          "400220618": {
            "id": "400220618",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "惟神晴之介学到了那么强大的仙法，又会「神通」，也许他能长生不老吧？",
            "nextDialogs": [
              "400220619"
            ]
          },
          "400220619": {
            "id": "400220619",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "各位，我想明白了一件事。无论晴之介是否还在世上，我都不该只为他而活了。",
            "nextDialogs": [
              "400220620"
            ]
          },
          "400220620": {
            "id": "400220620",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "遇见你们之后，我学会了一件事，那就是相信。相信晴之介正走在他自己的路上…相信我也会拥有这样一条路。",
            "nextDialogs": [
              "400220621"
            ]
          },
          "400220621": {
            "id": "400220621",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "自从诞生于世，我们便开始向着孤独的尽头行走，但迷雾之中会有火光，夜空之下会有新的伙伴…",
            "nextDialogs": [
              "400220667"
            ]
          },
          "400220667": {
            "id": "400220667",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "我们的使命，从不因远行而告终。",
            "nextDialogs": [
              "400220622"
            ]
          },
          "400220622": {
            "id": "400220622",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "晴之介所做的一切都有价值。而我的「意义」，正是我的使命。这一点从未改变，更不会被剥夺。",
            "nextDialogs": [
              "400220623"
            ]
          },
          "400220623": {
            "id": "400220623",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "我是辅佐武人的「式神」之首「式大将」，这座「诀箓阴阳寮」不变的「寮司」。",
            "nextDialogs": [
              "400220624"
            ]
          },
          "400220624": {
            "id": "400220624",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "我的职责是辅佐武人，帮助他们锤炼极致的武艺。",
            "nextDialogs": [
              "400220625"
            ]
          },
          "400220625": {
            "id": "400220625",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "世间一定还有正在攀登高山的人，我很乐意成为山间的绳索，成为他们的兵器，陪伴他们走向山顶。",
            "nextDialogs": [
              "400220626"
            ]
          },
          "400220626": {
            "id": "400220626",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "好极了，就是这种态度！",
            "nextDialogs": [
              "400220629"
            ]
          },
          "400220629": {
            "id": "400220629",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "记忆完全恢复的「式大将」…给人一种坚定又可靠的印象呢！",
            "nextDialogs": [
              "400220630"
            ]
          },
          "400220630": {
            "id": "400220630",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "我已重新掌控「诀箓阴阳寮」，今后不会再有任何「镜返魔物」外逃。本次风波，就到此为止了。",
            "nextDialogs": [
              "400220631"
            ]
          },
          "400220631": {
            "id": "400220631",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "只需几日时间，我就能理清符法之力的脉络，将「诀箓阴阳寮」恢复成原貌。",
            "nextDialogs": [
              "400220632"
            ]
          },
          "400220632": {
            "id": "400220632",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "这里是变幻莫测却安全可靠的试炼之地。今后我会一直守在这里，为渴求极致武艺的人提供最为有效的试炼。",
            "nextDialogs": [
              "400220633"
            ]
          },
          "400220633": {
            "id": "400220633",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "天领奉行那边应该也准备好进入秘境了吧。等他们过来，我会和他们详细说明这次事件。交涉方面，几位大可放心交给我。",
            "nextDialogs": [
              "400220634"
            ]
          },
          "400220634": {
            "id": "400220634",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好好好，意思是我们都不用善后了对吧？嗯~我就喜欢这种一身轻的感觉。",
            "nextDialogs": [
              "400220635"
            ]
          },
          "400220635": {
            "id": "400220635",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "多亏你们，我才能找回真正的自己…",
            "nextDialogs": [
              "400220636"
            ]
          },
          "400220636": {
            "id": "400220636",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "我准备了一点薄礼。虽说无法与各位的恩情相比，应该也能派上些用场。",
            "nextDialogs": [
              "400220637"
            ]
          },
          "400220637": {
            "id": "400220637",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "「拓本」？",
            "nextDialogs": [
              "400220638"
            ]
          },
          "400220638": {
            "id": "400220638",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "你们可以称呼他为「式小将」。",
            "nextDialogs": [
              "400220639"
            ]
          },
          "400220639": {
            "id": "400220639",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "「式小将」与其他「拓本」不同，不管在大陆哪一处，它都能与我保持联系。",
            "nextDialogs": [
              "400220640"
            ]
          },
          "400220640": {
            "id": "400220640",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "离开「诀箓阴阳寮」后，他无法再运用「式札」和符法，不过，也还是能为你们带去加护。",
            "nextDialogs": [
              "400220641"
            ]
          },
          "400220641": {
            "id": "400220641",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "带着他游历各地，就相当于把我带在身边…",
            "nextDialogs": [
              "400220642"
            ]
          },
          "400220642": {
            "id": "400220642",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "（「式大将」的口吻有些悲伤…是担心我们不会再见面吗？）",
            "nextDialogs": [
              "400220643"
            ]
          },
          "400220643": {
            "id": "400220643",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "喂！别说丧气话，我们不是还在嘛。",
            "nextDialogs": [
              "400220644"
            ]
          },
          "400220644": {
            "id": "400220644",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "而且托旅行者、九条裟罗和北斗姐的福，我来稻妻也不是那么困难。说不定隔三差五就到这里来看你了。",
            "nextDialogs": [
              "400220645"
            ]
          },
          "400220645": {
            "id": "400220645",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "辛焱小姐…这样不会太耽搁你的时间吗？",
            "nextDialogs": [
              "400220646"
            ]
          },
          "400220646": {
            "id": "400220646",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "我问你，摇滚怎么样？",
            "nextDialogs": [
              "400220647"
            ]
          },
          "400220647": {
            "id": "400220647",
            "speakerId": 1002,
            "speakerName": "「式大将」",
            "text": "摇滚…对我来说，是非常好的音乐。",
            "nextDialogs": [
              "400220648"
            ]
          },
          "400220648": {
            "id": "400220648",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "那就够了。我从来只为懂得欣赏的人演奏音乐。",
            "nextDialogs": [
              "400220649"
            ]
          },
          "400220649": {
            "id": "400220649",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "大家，准备好耳朵，我要露一手！",
            "nextDialogs": [
              "400220650"
            ]
          },
          "400220650": {
            "id": "400220650",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦？！居然要弹曲子吗？！",
            "nextDialogs": [
              "400220651"
            ]
          },
          "400220651": {
            "id": "400220651",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来这首曲子还有这么振奋人心的部分啊…",
            "nextDialogs": [
              "400220652"
            ]
          },
          "400220652": {
            "id": "400220652",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "达达利亚不是会跳舞吗？让他跟着…哎？达达利亚人呢？",
            "nextDialogs": [
              "400220653"
            ]
          },
          "400220653": {
            "id": "400220653",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂——！达达利亚！你要去哪儿啊，不会是想偷偷溜走吧！",
            "nextDialogs": [
              "400220654"
            ]
          },
          "400220654": {
            "id": "400220654",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "溜走？我只是找个地方休息一下，想想问题而已。",
            "nextDialogs": [
              "400220655"
            ]
          },
          "400220655": {
            "id": "400220655",
            "speakerId": 1003,
            "speakerName": "「公子」",
            "text": "旅行者，是时候告诉你我在调查的事了。"
          }
        }
      }

    {
      "subId": "4002201",
      "subQuestName": "与辛焱碰面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400220101"
        ],
        "dialogs": {
          "400220101": {
            "id": "400220101",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "旅行者，这段时间我从驻兵们那里打听到一个好消息！",
            "nextDialogs": [
              "400220102"
            ]
          },
          "400220102": {
            "id": "400220102",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "听说九条裟罗被城中事务困住了，她的部下暂时没有动静。",
            "nextDialogs": [
              "400220103"
            ]
          },
          "400220103": {
            "id": "400220103",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "说到底，这个秘境已经很久没有放出魔物了，他们小心地把守着重要关口，没必要急着向秘境内进军。",
            "nextDialogs": [
              "400220104"
            ]
          },
          "400220104": {
            "id": "400220104",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "给我们争取了不少时间呢。",
            "nextDialogs": [
              "400220105"
            ]
          },
          "400220105": {
            "id": "400220105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我们赶快进去吧，那两个家伙一定等得不耐烦了！"
          }
        }
      }
    },
    {

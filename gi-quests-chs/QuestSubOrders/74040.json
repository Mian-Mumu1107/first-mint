    {
      "subId": "7404026",
      "subQuestName": "（test）喇叭不选（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740401701"
        ],
        "dialogs": {
          "740401701": {
            "id": "740401701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不知道，艾伊丝喜欢哪个呢？",
            "nextDialogs": [
              "740401702"
            ]
          },
          "740401702": {
            "id": "740401702",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "欸，我吗？嗯…我的话，是这个。",
            "nextDialogs": [
              "740401703"
            ]
          },
          "740401703": {
            "id": "740401703",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "艾伊丝用海螺发出了信号…"
          }
        }
      }
    },
    {
      "subId": "7404007",
      "subQuestName": "使用海螺发送信号",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400701"
        ],
        "dialogs": {
          "740400701": {
            "id": "740400701",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "这里…好混乱，都是不完整的船骸，大部分都是碎片。",
            "nextDialogs": [
              "740400702"
            ]
          },
          "740400702": {
            "id": "740400702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "从痕迹来看，她应该还在前进。",
            "nextDialogs": [
              "740400703"
            ]
          },
          "740400703": {
            "id": "740400703",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "但她一定遭受了不可修复的损伤，为什么在这种情况下还能继续前进呢？或许…我们很快就能发现原因了。",
            "nextDialogs": [
              "740400704"
            ]
          },
          "740400704": {
            "id": "740400704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么多碎片，也许是被大海怪「啊呜」一下咬成了两半呢！",
            "nextDialogs": [
              "740400705"
            ]
          },
          "740400705": {
            "id": "740400705",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "……"
          }
        }
      }
    },
    {
      "subId": "7404027",
      "subQuestName": "与艾伊丝对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740401801"
        ],
        "dialogs": {
          "740401801": {
            "id": "740401801",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "欸…你听到了吗？",
            "nextDialogs": [
              "740401802"
            ]
          },
          "740401802": {
            "id": "740401802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？什么呀…",
            "nextDialogs": [
              "740401803"
            ]
          },
          "740401803": {
            "id": "740401803",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "嘘，讯号…等等…她、她就在那边！在那边的远处！",
            "nextDialogs": [
              "740401804"
            ]
          },
          "740401804": {
            "id": "740401804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇？我、我什么都没看到呀！",
            "nextDialogs": [
              "740401805"
            ]
          },
          "740401805": {
            "id": "740401805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，我看到了。",
            "nextDialogs": [
              "740401806"
            ]
          },
          "740401806": {
            "id": "740401806",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "嗯！我就知道你也能看到！快，我们追上她！",
            "nextDialogs": [
              "740401807"
            ]
          },
          "740401807": {
            "id": "740401807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "追、追什么呀，追船吗？你们是也长了风帆或者螺旋桨吗！"
          }
        }
      }
    },
    {
      "subId": "7404029",
      "subQuestName": "追随出现的幻影",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7404008",
      "subQuestName": "追随出现的幻影",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400801"
        ],
        "dialogs": {
          "740400801": {
            "id": "740400801",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "也就是说，「斯彭西安号」受了重伤，她受伤的原因与深渊远征有关，以及…她还在继续前进。那么…",
            "nextDialogs": [
              "740400802"
            ]
          },
          "740400802": {
            "id": "740400802",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "我们再用海螺发送信号吧，也许前方还会有她的回响呢！",
            "nextDialogs": [
              "740400803"
            ]
          },
          "740400803": {
            "id": "740400803",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "对了、对了，你要发送的讯号分别是：「长低音，短低音，长低音」…",
            "nextDialogs": [
              "740400804"
            ]
          },
          "740400804": {
            "id": "740400804",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "「长低音，长低音，长低音，长低音，长低音」，还有…嗯…",
            "nextDialogs": [
              "740400805"
            ]
          },
          "740400805": {
            "id": "740400805",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "「短低音，长低音，短低音，长低音，短低音，长低音，短低音，长低音，短低音，长低音」…呼，好长！不过这三个讯号应该都可以收到回音！"
          }
        }
      }
    },
    {
      "subId": "7404004",
      "subQuestName": "与艾伊丝对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400301"
        ],
        "dialogs": {
          "740400301": {
            "id": "740400301",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "奇怪…为什么她不再出现了呢？",
            "nextDialogs": [
              "740400302"
            ]
          },
          "740400302": {
            "id": "740400302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…我跟着你们迷迷糊糊跑了这么远，虽然看不见你们说的「那艘船」…",
            "nextDialogs": [
              "740400303"
            ]
          },
          "740400303": {
            "id": "740400303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但既然在这里消失了，一定是想要提示我们要找什么东西吧？说不定是「遗失的秘宝」之类的好东西呢！",
            "nextDialogs": [
              "740400304"
            ]
          },
          "740400304": {
            "id": "740400304",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "嘿嘿，小水母派蒙很贪财呢。",
            "nextDialogs": [
              "740400305"
            ]
          },
          "740400305": {
            "id": "740400305",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "不过我们要去寻找的可不是宝藏哦…嗯，非要说的话，应该是「证物」吧？",
            "nextDialogs": [
              "740400307",
              "740400310"
            ]
          },
          "740400307": {
            "id": "740400307",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "就是「斯彭西安号」经过这里的证据。比如航海日志、船身碎片，或者航海工具什么的…总之，应该能够找到与她相关的线索！",
            "nextDialogs": [
              "740400308"
            ]
          },
          "740400308": {
            "id": "740400308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…这样啊…",
            "nextDialogs": [
              "740400313"
            ]
          },
          "740400313": {
            "id": "740400313",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "我们可以利用海螺发出声音，然后通过分辨传回的音波，就能够大致确定它们的位置了。"
          },
          "740400310": {
            "id": "740400310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我就是这样想的！",
            "nextDialogs": [
              "740400311"
            ]
          },
          "740400311": {
            "id": "740400311",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "也许吧…不过我们这次不是要去寻找宝藏的哦，我们要找的是「斯彭西安号」经过这里的证据。",
            "nextDialogs": [
              "740400312"
            ]
          },
          "740400312": {
            "id": "740400312",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "比如航海日志、船身碎片，或者航海工具什么的…总之，与她相关的线索。"
          }
        }
      }
    },
    {
      "subId": "7404005",
      "subQuestName": "调查线索地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400501"
        ],
        "dialogs": {
          "740400501": {
            "id": "740400501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…是箱子和…水桶？我们打开看看吧？说不定是…",
            "nextDialogs": [
              "740400502"
            ]
          },
          "740400502": {
            "id": "740400502",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "是石头哦。",
            "nextDialogs": [
              "740400503"
            ]
          },
          "740400503": {
            "id": "740400503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！是很值钱的石头呢！",
            "nextDialogs": [
              "740400504"
            ]
          },
          "740400504": {
            "id": "740400504",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "哈哈哈，笨派蒙！是压舱物啦！用来稳定战舰重量的压舱物！",
            "nextDialogs": [
              "740400505"
            ]
          },
          "740400505": {
            "id": "740400505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样啊…那…我猜应该没有值钱的压舱物就是了…",
            "nextDialogs": [
              "740400506"
            ]
          },
          "740400506": {
            "id": "740400506",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "不过既然我们能在单个地点找到这么多压舱物，也许说明这艘船经历了紧急上浮的操作…",
            "nextDialogs": [
              "740400507"
            ]
          },
          "740400507": {
            "id": "740400507",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "也就是说，当时她一定遭遇了突发的险情，即使作为铁甲舰队的旗舰，也不得不紧急避险。"
          }
        }
      }
    },
    {
      "subId": "7404009",
      "subQuestName": "调查线索地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400601"
        ],
        "dialogs": {
          "740400601": {
            "id": "740400601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…破木板、船桨，还有…小艇的残骸。这里没什么好看的啦…",
            "nextDialogs": [
              "740400602"
            ]
          },
          "740400602": {
            "id": "740400602",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "是救生艇…即使是救生艇也被破坏了…嗯？你看那边，木板缝隙间是什么？",
            "nextDialogs": [
              "740400603"
            ]
          },
          "740400603": {
            "id": "740400603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…好像是纸张的残片…是日志吗？我们取出来看看吧？",
            "nextDialogs": [
              "740400604"
            ]
          },
          "740400604": {
            "id": "740400604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们是来对抗深渊魔物的…",
            "nextDialogs": [
              "740400605"
            ]
          },
          "740400605": {
            "id": "740400605",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "嗯…艾伊丝也曾听说过关于它们的传说。但是…难道「斯彭西安号」真的已经…",
            "nextDialogs": [
              "740400606"
            ]
          },
          "740400606": {
            "id": "740400606",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "哼，证据还不充分。我们继续去下一个地点吧。"
          }
        }
      }
    },

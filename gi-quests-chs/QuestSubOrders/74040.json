  "subQuests": [
    {
      "subId": "7404001",
      "subQuestName": "（test）隐藏接取环$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400101"
        ],
        "dialogs": {
          "740400101": {
            "id": "740400101",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "你们好呀，艾伊丝是我的名字，很高兴遇见新朋友！",
            "nextDialogs": [
              "740400102"
            ]
          },
          "740400102": {
            "id": "740400102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好呀，艾伊丝！我是派蒙！",
            "nextDialogs": [
              "740400103"
            ]
          },
          "740400103": {
            "id": "740400103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#你好，我是{NICKNAME}。",
            "nextDialogs": [
              "740400104"
            ]
          },
          "740400104": {
            "id": "740400104",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "听薇蕾娜妲说，你们也发现了「那艘船」，是真的吗？是真的吗？",
            "nextDialogs": [
              "740400105"
            ]
          },
          "740400105": {
            "id": "740400105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…？虽然海里确实有好多船就是啦…",
            "nextDialogs": [
              "740400107",
              "740400110"
            ]
          },
          "740400107": {
            "id": "740400107",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "就是…就是…独一无二的「那艘船」！",
            "nextDialogs": [
              "740400108"
            ]
          },
          "740400108": {
            "id": "740400108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦…「那艘船」呀…",
            "nextDialogs": [
              "740400115"
            ]
          },
          "740400115": {
            "id": "740400115",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "哈哈！对不起，对不起！艾伊丝一定把你们搞迷糊啦！",
            "nextDialogs": [
              "740400116"
            ]
          },
          "740400116": {
            "id": "740400116",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "咳咳，「那艘船」就是「斯彭西安号」，穿梭幻梦的白色铁甲船，海渊与漩涡的探索者…海军司令贝瑟·埃尔顿的旗舰！",
            "nextDialogs": [
              "740400117"
            ]
          },
          "740400117": {
            "id": "740400117",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "贝瑟船长在这片水域留下了褪色的船骸，还有残破的航海日志…艾伊丝每天都会来这里，挑挑拣拣，读完了所有带文字的东西！",
            "nextDialogs": [
              "740400118"
            ]
          },
          "740400118": {
            "id": "740400118",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "嘿嘿，所以艾伊丝也算是「斯彭西安号」的考古学家了呢！她的一切我都了解！呃…也不对，至少是了解一半啦！",
            "nextDialogs": [
              "740400119"
            ]
          },
          "740400119": {
            "id": "740400119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，看起来艾伊丝真的很喜欢这艘船呢…一聊起来就滔滔不绝的。",
            "nextDialogs": [
              "740400120"
            ]
          },
          "740400120": {
            "id": "740400120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，既然艾伊丝也只了解一半…那一定是很大的一艘船吧？",
            "nextDialogs": [
              "740400121"
            ]
          },
          "740400121": {
            "id": "740400121",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "唔…也没有很大啦…是因为贝瑟船长只留下了一半船体…",
            "nextDialogs": [
              "740400122"
            ]
          },
          "740400122": {
            "id": "740400122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦…所以说…"
          },
          "740400110": {
            "id": "740400110",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "嗯，嗯！",
            "nextDialogs": [
              "740400111"
            ]
          },
          "740400111": {
            "id": "740400111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…是那艘船呀！我还以为是哪艘呢，哈哈…",
            "nextDialogs": [
              "740400112"
            ]
          },
          "740400112": {
            "id": "740400112",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "那…你们说的是哪艘船？"
          }
        }
      }
    },
    {
      "subId": "7404002",
      "subQuestName": "前往艾伊丝提及的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400201"
        ],
        "dialogs": {
          "740400201": {
            "id": "740400201",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "就是这里，我们到啦！",
            "nextDialogs": [
              "740400202"
            ]
          },
          "740400202": {
            "id": "740400202",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "唔，请你们稍等，让艾伊丝调试一下海螺。",
            "nextDialogs": [
              "740400203"
            ]
          },
          "740400203": {
            "id": "740400203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？「调试」…海螺？虽然烤海螺是很好吃啦…",
            "nextDialogs": [
              "740400204"
            ]
          },
          "740400204": {
            "id": "740400204",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "派蒙就知道吃呢，是沟通用的军用海螺！",
            "nextDialogs": [
              "740400205"
            ]
          },
          "740400205": {
            "id": "740400205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "军用…海螺？",
            "nextDialogs": [
              "740400206"
            ]
          },
          "740400206": {
            "id": "740400206",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "嗯，是老式的军用海螺，古代海员互相联络时用的工具…应该是海军还在的时候留下的遗物，我从沉船中找到的。",
            "nextDialogs": [
              "740400207"
            ]
          },
          "740400207": {
            "id": "740400207",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "上次就在这里，我调试海螺时听到了她的回应。既然你见到过她，那我觉得你一定也能听到她的回应的！",
            "nextDialogs": [
              "740400208"
            ]
          },
          "740400208": {
            "id": "740400208",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "不过需要等一等哦，艾伊丝要先调试一下海螺的状态，然后才能发出正确的讯号。",
            "nextDialogs": [
              "740400210",
              "740400212"
            ]
          },
          "740400210": {
            "id": "740400210",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "嗯，没错。但时刻与海况的不同也会影响海螺的发声状况，所以需要时时调试。嘿嘿…古董就是这点不好啦。",
            "nextDialogs": [
              "740400213"
            ]
          },
          "740400213": {
            "id": "740400213",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "唔，总之…等一下啦，等我把海螺与波浪的振动调谐好…你们不要乱走哦。",
            "nextDialogs": [
              "740400214"
            ]
          },
          "740400214": {
            "id": "740400214",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "艾伊丝灵活地摆弄了一会手中的海螺，不久后便完成了调试…",
            "nextDialogs": [
              "740400215"
            ]
          },
          "740400215": {
            "id": "740400215",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "这就好啦！哼哼，艾伊丝从那些老旧的海军手册里学到了不少技术呢！",
            "nextDialogs": [
              "740400216"
            ]
          },
          "740400216": {
            "id": "740400216",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "嗯，请让艾伊丝介绍一下吧。艾伊丝一般常用的短信号有这三种…",
            "nextDialogs": [
              "740400217"
            ]
          },
          "740400217": {
            "id": "740400217",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "「长低音，短低音，长低音」。嗯…这个的含义是…艾伊丝猜测，应该是「准备就绪」。",
            "nextDialogs": [
              "740400218"
            ]
          },
          "740400218": {
            "id": "740400218",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "「长低音，长低音，长低音，长低音，长低音」。这个的含义…唔，艾伊丝还不清楚呢，但上次收到的回音大致是这样，所以一定也是有用的！",
            "nextDialogs": [
              "740400219"
            ]
          },
          "740400219": {
            "id": "740400219",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "「短低音，长低音，短低音，长低音，短低音，长低音，短低音，长低音，短低音，长低音」…呼，好长！这是最有几率获得回音的讯号，至于含义…",
            "nextDialogs": [
              "740400220"
            ]
          },
          "740400220": {
            "id": "740400220",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "是「我有消息要发送」的意思…手册是这么写的。",
            "nextDialogs": [
              "740400221"
            ]
          },
          "740400221": {
            "id": "740400221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…所以，我们要怎么做才能试出能获得回应的讯号呢？"
          },
          "740400212": {
            "id": "740400212",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "嘿嘿，很神奇吧？就像鲸鱼一样，你唱歌，她也回应你的歌。我亲耳听到的，是真的哦。"
          }
        }
      }
    },

    {
      "subId": "7404012",
      "subQuestName": "再次使用海螺发送信号",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740401201"
        ],
        "dialogs": {
          "740401201": {
            "id": "740401201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你还好吗！",
            "nextDialogs": [
              "740401202"
            ]
          },
          "740401202": {
            "id": "740401202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！刚刚你让我躲起来，然后自顾自就去狂揍史莱姆…然后、然后还捞起一把沙子，又是发呆又是自言自语的！",
            "nextDialogs": [
              "740401203"
            ]
          },
          "740401203": {
            "id": "740401203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚刚到底发生什么了呀，好吓人！",
            "nextDialogs": [
              "740401205",
              "740401208"
            ]
          },
          "740401205": {
            "id": "740401205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？所以…你刚刚以为自己在和一群深渊怪物作战吗？难怪表情认真得吓人！",
            "nextDialogs": [
              "740401206"
            ]
          },
          "740401206": {
            "id": "740401206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，要我说，肯定是薇蕾娜妲那家伙的药有问题，才让你变成这样的！",
            "nextDialogs": [
              "740401210"
            ]
          },
          "740401210": {
            "id": "740401210",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "好吵，好吵！你们都在干什么呀！是想要趁艾伊丝不在，把这些残骸都弄走吗？",
            "nextDialogs": [
              "740401211"
            ]
          },
          "740401211": {
            "id": "740401211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…这种破船的木材很值钱吗？",
            "nextDialogs": [
              "740401212"
            ]
          },
          "740401212": {
            "id": "740401212",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "艾伊丝也不知道…喂，你这坏水母，还真的在这么盘算吗！",
            "nextDialogs": [
              "740401213"
            ]
          },
          "740401213": {
            "id": "740401213",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "唔…虽然已经破碎得不成样子了，唉，但收拢一下大概还是能作为纪念物带回去的…",
            "nextDialogs": [
              "740401214"
            ]
          },
          "740401214": {
            "id": "740401214",
            "speakerId": 21070,
            "speakerName": "艾伊丝",
            "text": "复原白色铁甲舰原来的模样，恐怕是没有可能了…但我还能继续探索她曾经历过什么，或许吧…"
          },
          "740401208": {
            "id": "740401208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吊坠？唔…你手里除了沙子没有别的东西啦…嗯？我还看到了好小的小海螺…",
            "nextDialogs": [
              "740401209"
            ]
          },
          "740401209": {
            "id": "740401209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以，刚刚你就是和「幻想吊坠」对话吗？唔…我觉得肯定是刚刚航海日志里的内容把你搞糊涂啦…"
          }
        }
      }
    },
    {
      "subId": "7404013",
      "subQuestName": "追随再度出现的幻影",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740401301"
        ],
        "dialogs": {
          "740401301": {
            "id": "740401301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这是…航海日志？保存得还很完整呢。我们读读看吧？"
          }
        }
      }
    },
    {
      "subId": "7404014",
      "subQuestName": "到达幻影停驻的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7404015",
      "subQuestName": "与艾伊丝对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740400901"
        ],
        "dialogs": {
          "740400901": {
            "id": "740400901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…你们看，这些残骸就是我们先前一直在追的那艘船吧！呃…我是说，那半艘…",
            "nextDialogs": [
              "740400902"
            ]
          },
          "740400902": {
            "id": "740400902",
            "speakerId": 5320,
            "speakerName": "艾伊丝",
            "text": "……！",
            "nextDialogs": [
              "740400903"
            ]
          },
          "740400903": {
            "id": "740400903",
            "speakerId": 5320,
            "speakerName": "艾伊丝",
            "text": "好、好碎…",
            "nextDialogs": [
              "740400904"
            ]
          },
          "740400904": {
            "id": "740400904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…艾伊丝你别伤心啦…这艘船变成这样，也不是我们能预料到的呀？",
            "nextDialogs": [
              "740400905"
            ]
          },
          "740400905": {
            "id": "740400905",
            "speakerId": 5320,
            "speakerName": "艾伊丝",
            "text": "话是这么说，可是…唔，算了…我去旁边看看有什么值得调查的东西吧…",
            "nextDialogs": [
              "740400906"
            ]
          },
          "740400906": {
            "id": "740400906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯，说不定还剩了些好东西呢…{NICKNAME}，我们也调查一下附近吧！"
          }
        }
      }
    },
    {
      "subId": "7404016",
      "subQuestName": "调查船骸附近的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7404028",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740401001"
        ],
        "dialogs": {
          "740401001": {
            "id": "740401001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也就是说，这艘船是在对抗海兽的过程中沉没的…",
            "nextDialogs": [
              "740401002"
            ]
          },
          "740401002": {
            "id": "740401002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "然后，这半部分船身被巨浪撕碎，又随着洋流飘荡，最终在这里搁浅了。",
            "nextDialogs": [
              "740401005"
            ]
          },
          "740401005": {
            "id": "740401005",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那不就是说，她真的是被海兽咬成两半的…欸？什么声音？",
            "nextDialogs": [
              "740401006"
            ]
          },
          "740401006": {
            "id": "740401006",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，是魔物！讨厌的家伙又来了！",
            "nextDialogs": [
              "740401007"
            ]
          },
          "740401007": {
            "id": "740401007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，躲起来！",
            "nextDialogs": [
              "740401008"
            ]
          },
          "740401008": {
            "id": "740401008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可、可是…嗯！"
          }
        }
      }
    },
    {
      "subId": "7404017",
      "subQuestName": "击败怪物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7404018",
      "subQuestName": "调查奇异的掉落物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740401101"
        ],
        "dialogs": {
          "740401101": {
            "id": "740401101",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "「…离开她吧，水手们，离开她吧…」\\n「…明天就是结薪日，是时候离开她了…」\\n「…离开她吧，水手们，离开她吧…」\\n「…旅途告终，风不再吹，是时候离开她了…」",
            "nextDialogs": [
              "740401102"
            ]
          },
          "740401102": {
            "id": "740401102",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "「…酒也喝不着，肉也发了臭，是时候离开她了…」\\n「…离开她吧，水手们，离开她吧…」\\n「…我们该散伙各奔生路了，是时候离开她了…」",
            "nextDialogs": [
              "740401103"
            ]
          },
          "740401103": {
            "id": "740401103",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "随着如梦的歌声溶入海波，奇异的吊坠中传出了忧伤的声音…",
            "nextDialogs": [
              "740401104"
            ]
          },
          "740401104": {
            "id": "740401104",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "「蓝色的、像个小海员一样的孩子…我看到了她…呵呵…」\\n「那孩子的身上，带着海兽的气息…」\\n「但她是个好孩子，或许不会弄脏我的旗舰…」",
            "nextDialogs": [
              "740401105"
            ]
          },
          "740401105": {
            "id": "740401105",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "「呵呵，只可惜我没有保护好她，真是艘好船…」"
          }
        }
      }
    },

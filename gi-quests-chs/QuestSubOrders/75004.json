    {
      "subId": "7500406",
      "subQuestName": "寻找铭印的碎片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750040601"
        ],
        "dialogs": {
          "750040601": {
            "id": "750040601",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "#哈…怎么样，{NICKNAME}，现在，可以解开「镌光铭印」的封印？",
            "nextDialogs": [
              "750040603",
              "750040605"
            ]
          },
          "750040603": {
            "id": "750040603",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "那我这就…打开封印，还请一切小心。"
          },
          "750040605": {
            "id": "750040605",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "好的，如果准备好了，还请随时和我说…"
          }
        }
      }
    },

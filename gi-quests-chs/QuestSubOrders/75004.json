    {
      "subId": "7500411",
      "subQuestName": "让战士们得到安宁",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750041101"
        ],
        "dialogs": {
          "750041101": {
            "id": "750041101",
            "speakerId": 1006,
            "speakerName": "「伊利萨」",
            "text": "「快走，快走吧…我可不想我狼狈的样子——被他知晓——」",
            "nextDialogs": [
              "750041102"
            ]
          },
          "750041102": {
            "id": "750041102",
            "speakerId": 1006,
            "speakerName": "「伊利萨」",
            "text": "（那声音仿佛来自岿然不动的造像深处，而话语中仍然遗留着对于某人的崇敬之意…）"
          }
        }
      }
    },
    {
      "subId": "7500412",
      "subQuestName": "让战士们得到安宁",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7500415",
      "subQuestName": "前往封印之柱",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750041501"
        ],
        "dialogs": {
          "750041501": {
            "id": "750041501",
            "speakerId": 1007,
            "speakerName": "尤考姆",
            "text": "唔，你们平安无事吗？真不知道刚才发生了什么。",
            "nextDialogs": [
              "750041502"
            ]
          },
          "750041502": {
            "id": "750041502",
            "speakerId": 1007,
            "speakerName": "尤考姆",
            "text": "突然发生了很大的地震，我还担心你们呢，看到你们安然无恙就好了。",
            "nextDialogs": [
              "750041503"
            ]
          },
          "750041503": {
            "id": "750041503",
            "speakerId": 1007,
            "speakerName": "尤考姆",
            "text": "至于蒂图？蒂图，这家伙怎么还不过来接我的岗，真是的，不如被刚才的地震震死算了！"
          }
        }
      }
    },
    {
      "subId": "7500413",
      "subQuestName": "聆听夜的低语",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7500414",
      "subQuestName": "与蒂图对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750040501"
        ],
        "dialogs": {
          "750040501": {
            "id": "750040501",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "#你们终于回来了，我和{REALNAME[ID(2)|SHOWHOST(true)]}都很担心。",
            "nextDialogs": [
              "750040502"
            ]
          },
          "750040502": {
            "id": "750040502",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "不过你看，我说了，小家伙，他们会平安无事地回来的。",
            "nextDialogs": [
              "750040503"
            ]
          },
          "750040503": {
            "id": "750040503",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜呜…",
            "nextDialogs": [
              "750040504"
            ]
          },
          "750040504": {
            "id": "750040504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎呀，我们也没法解释刚才到了哪里…",
            "nextDialogs": [
              "750040508",
              "750040507"
            ]
          },
          "750040508": {
            "id": "750040508",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "#多谢你，{NICKNAME}，没想到，此处的深渊真的得以净化。",
            "nextDialogs": [
              "750040509"
            ]
          },
          "750040509": {
            "id": "750040509",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "就像是…不用在此停留了一样，那些「镌光铭印」也消失不见了。那些痛苦的声音也得到平息。",
            "nextDialogs": [
              "750040510"
            ]
          },
          "750040510": {
            "id": "750040510",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "金色的光芒啊，金色的光芒如流水一般融散入地面。",
            "nextDialogs": [
              "750040511"
            ]
          },
          "750040511": {
            "id": "750040511",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "我甚至觉得那些光芒里好像有人在跟我们招手…",
            "nextDialogs": [
              "750040512"
            ]
          },
          "750040512": {
            "id": "750040512",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750040513"
            ]
          },
          "750040513": {
            "id": "750040513",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "小家伙你也看到啦？我看到那些光芒围绕着你们，然后你们就不见了。",
            "nextDialogs": [
              "750040514"
            ]
          },
          "750040514": {
            "id": "750040514",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是嘛…我们倒是什么都没看见。",
            "nextDialogs": [
              "750040515"
            ]
          },
          "750040515": {
            "id": "750040515",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "#唉，真是感谢你们，{NICKNAME}，派蒙，还有{REALNAME[ID(2)|SHOWHOST(true)]}。",
            "nextDialogs": [
              "750040516"
            ]
          },
          "750040516": {
            "id": "750040516",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "你们是真的了不起的英雄，我替那些终于得以安息的战士们感谢你，陶奥鲁的遗愿也被达成，还有…",
            "nextDialogs": [
              "750040517"
            ]
          },
          "750040517": {
            "id": "750040517",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "还有那两位坎瑞亚的士兵，不，那两位坎瑞亚的英雄，既然这里的深渊已经不在，也不需要他们背负骂名以作警示。",
            "nextDialogs": [
              "750040518"
            ]
          },
          "750040518": {
            "id": "750040518",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "我一定要写关于他们拯救了回声之子的故事…其实之前有一个瞬间，我感觉完全理解了他们的想法。",
            "nextDialogs": [
              "750040519"
            ]
          },
          "750040519": {
            "id": "750040519",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "这里有的可是深渊，这么危险，如果是我，我也一定要编造点恐怖故事，不让…不让后来的部族人靠近。",
            "nextDialogs": [
              "750040520"
            ]
          },
          "750040520": {
            "id": "750040520",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "唉…没想到今天之前还在为写什么故事而烦恼，现在倒是有很多想写的。比如，金发的异邦人，会飞的白色精灵，还有小嵴锋龙拯救了部族的故事。",
            "nextDialogs": [
              "750040521"
            ]
          },
          "750040521": {
            "id": "750040521",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，这个听上去就很了不起！",
            "nextDialogs": [
              "750040522"
            ]
          },
          "750040522": {
            "id": "750040522",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "嗯，故事会流转，也会变化，说不定等传到很久很久以后，派蒙也会变成山一样大的派蒙呢。",
            "nextDialogs": [
              "750040523"
            ]
          },
          "750040523": {
            "id": "750040523",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "吼吼，山一样大的勇士派蒙！",
            "nextDialogs": [
              "750040524"
            ]
          },
          "750040524": {
            "id": "750040524",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼，山一样大的勇士派蒙，一口一个驮兽那么大的甜甜花酿鸡！",
            "nextDialogs": [
              "750040525"
            ]
          },
          "750040525": {
            "id": "750040525",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀！",
            "nextDialogs": [
              "750040526"
            ]
          },
          "750040526": {
            "id": "750040526",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "哈哈，驮兽那么大的甜甜花酿鸡可没有那么多呀。",
            "nextDialogs": [
              "750040527"
            ]
          },
          "750040527": {
            "id": "750040527",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "然后那两位士兵…在故事的继续流传之后，也会逐渐成为英雄吧。他们或许对此没什么所谓，可我知道那是我应该做的。",
            "nextDialogs": [
              "750040528"
            ]
          },
          "750040528": {
            "id": "750040528",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "#哎呀，真是太感谢你了…{NICKNAME}，派蒙…对，还有知觉灵敏的{REALNAME[ID(2)|SHOWHOST(true)]}。",
            "nextDialogs": [
              "750040529"
            ]
          },
          "750040529": {
            "id": "750040529",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750040530"
            ]
          },
          "750040530": {
            "id": "750040530",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "…我以叙事人的身份起誓，一定会为你们写一个最精彩的故事。",
            "nextDialogs": [
              "750040531"
            ]
          },
          "750040531": {
            "id": "750040531",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "啊，不过说起来…我还得先回去接哨站里站岗的班。",
            "nextDialogs": [
              "750040532"
            ]
          },
          "750040532": {
            "id": "750040532",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "唔，经历了那么多事，都快忘了。",
            "nextDialogs": [
              "750040533"
            ]
          },
          "750040533": {
            "id": "750040533",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "这下完蛋了，这么久还没回去，尤考姆得活剥了我！",
            "nextDialogs": [
              "750040534"
            ]
          },
          "750040534": {
            "id": "750040534",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对哦！你还是先回去站岗吧！"
          },
          "750040507": {
            "id": "750040507",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "…是、是嘛。"
          }
        }
      }

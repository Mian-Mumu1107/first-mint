      }
    },
    {
      "subId": "7500402",
      "subQuestName": "调查下方的洞窟",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750040201"
        ],
        "dialogs": {
          "750040201": {
            "id": "750040201",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "咝——呃，啊啊啊啊——都说了——危险，离、离开——",
            "nextDialogs": [
              "750040202"
            ]
          },
          "750040202": {
            "id": "750040202",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "灾厄——将封印——撕碎——",
            "nextDialogs": [
              "750040203"
            ]
          },
          "750040203": {
            "id": "750040203",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜…呜…",
            "nextDialogs": [
              "750040204"
            ]
          },
          "750040204": {
            "id": "750040204",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "那个声音，更加完整，但是…不知道为什么，感觉并没有之前那么害怕。",
            "nextDialogs": [
              "750040205"
            ]
          },
          "750040205": {
            "id": "750040205",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "只不过头还是有点疼。",
            "nextDialogs": [
              "750040206"
            ]
          },
          "750040206": {
            "id": "750040206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}呢，有什么感觉吗？",
            "nextDialogs": [
              "750040208",
              "750040210"
            ]
          },
          "750040208": {
            "id": "750040208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那就好那就好。",
            "nextDialogs": [
              "750040211"
            ]
          },
          "750040211": {
            "id": "750040211",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#那，{REALNAME[ID(2)|SHOWHOST(true)]}，有没有觉得不舒服呀？",
            "nextDialogs": [
              "750040212"
            ]
          },
          "750040212": {
            "id": "750040212",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯？",
            "nextDialogs": [
              "750040213"
            ]
          },
          "750040213": {
            "id": "750040213",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看来好像暂时也没什么事…",
            "nextDialogs": [
              "750040214"
            ]
          },
          "750040214": {
            "id": "750040214",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "到了这里就能很明显感知到，声音是从石柱子上来的…那应该是…",
            "nextDialogs": [
              "750040215"
            ]
          },
          "750040215": {
            "id": "750040215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一起被封印的坎瑞亚士兵…",
            "nextDialogs": [
              "750040216"
            ]
          },
          "750040216": {
            "id": "750040216",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜…",
            "nextDialogs": [
              "750040217"
            ]
          },
          "750040217": {
            "id": "750040217",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也就是说，他们的意识也和深渊一起，被封印了那么多年…可是，这里到底出了什么问题呢？",
            "nextDialogs": [
              "750040218"
            ]
          },
          "750040218": {
            "id": "750040218",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "其实…这里的问题和在上面的「小缝影针」很像，深渊的涌动让「镌光铭印」的力量破碎并被挤压出了大的封印之柱中…",
            "nextDialogs": [
              "750040219"
            ]
          },
          "750040219": {
            "id": "750040219",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "所以我们需要找到在这里的大「镌光铭印」的碎片，然后想办法把「蛋壳」重新拼起来。",
            "nextDialogs": [
              "750040220"
            ]
          },
          "750040220": {
            "id": "750040220",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "对，这样，封印就能恢复完整，深渊也能持续被封印在此，然后…一切估计就能够恢复原样了。",
            "nextDialogs": [
              "750040221"
            ]
          },
          "750040221": {
            "id": "750040221",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "不过就和之前在「小缝影针」那里一样。固态燃素构建的地面和深渊会有剧烈的冲突反应，这也是地面起伏不定的原因…",
            "nextDialogs": [
              "750040222"
            ]
          },
          "750040222": {
            "id": "750040222",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "这点请一定要小心啊。",
            "nextDialogs": [
              "750040223"
            ]
          },
          "750040223": {
            "id": "750040223",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，大「镌光铭印」的碎片啊，到底应该怎么找呢…",
            "nextDialogs": [
              "750040224"
            ]
          },
          "750040224": {
            "id": "750040224",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀…呀！",
            "nextDialogs": [
              "750040225"
            ]
          },
          "750040225": {
            "id": "750040225",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#什么，有铭印的力量藏在那个里面吗，{REALNAME[ID(2)|SHOWHOST(true)]}的鼻子很灵哦…呃，你用的是鼻子吗？",
            "nextDialogs": [
              "750040226"
            ]
          },
          "750040226": {
            "id": "750040226",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过之前有这样一块石头吗？",
            "nextDialogs": [
              "750040227"
            ]
          },
          "750040227": {
            "id": "750040227",
            "speakerId": 1001,
            "speakerName": "蒂图",
            "text": "#刚才，{NICKNAME}靠近大「镌光铭印」的时候…好像是那时候出现的？",
            "nextDialogs": [
              "750040228"
            ]
          },
          "750040228": {
            "id": "750040228",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯？",
            "nextDialogs": [
              "750040229"
            ]
          },
          "750040229": {
            "id": "750040229",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好啦，总之，我们先到那块石块周围看看！"
          },
          "750040210": {
            "id": "750040210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "谁问你这个啦！"
          }
        }
      }
    },
    {
      "subId": "7500403",
      "subQuestName": "触碰铭印",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7500404",
      "subQuestName": "触碰铭印",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750040401"
        ],
        "dialogs": {
          "750040401": {
            "id": "750040401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "奇怪，刚才看见好多散落的光…然后我们就到这里来了？",
            "nextDialogs": [
              "750040402"
            ]
          },
          "750040402": {
            "id": "750040402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，那个是…",
            "nextDialogs": [
              "750040403"
            ]
          },
          "750040403": {
            "id": "750040403",
            "speakerId": 1004,
            "speakerName": "「毛发如夜的野兽」",
            "text": "过来…来这里…",
            "nextDialogs": [
              "750040404"
            ]
          },
          "750040404": {
            "id": "750040404",
            "speakerId": 1004,
            "speakerName": "「毛发如夜的野兽」",
            "text": "你带来了许多，许多应得安息的长眠者…",
            "nextDialogs": [
              "750040405"
            ]
          },
          "750040405": {
            "id": "750040405",
            "speakerId": 1004,
            "speakerName": "「毛发如夜的野兽」",
            "text": "或许他们向不应祈求的灵祈求了…",
            "nextDialogs": [
              "750040406"
            ]
          },
          "750040406": {
            "id": "750040406",
            "speakerId": 1004,
            "speakerName": "「毛发如夜的野兽」",
            "text": "但那是在不可伸手视物的无月之夜，所以夜晚早就原谅了他们。只是恨意与污秽永不能停息，他们也永远无法真正睡去。",
            "nextDialogs": [
              "750040407"
            ]
          },
          "750040407": {
            "id": "750040407",
            "speakerId": 1004,
            "speakerName": "「毛发如夜的野兽」",
            "text": "感谢你，受钟爱之人…你抚平他们暗中流涌的愤怒，将他们带入夜晚的倒影，而异邦的灵魂也得以回归他们所向之处…",
            "nextDialogs": [
              "750040408"
            ]
          },
          "750040408": {
            "id": "750040408",
            "speakerId": 1004,
            "speakerName": "「毛发如夜的野兽」",
            "text": "……",
            "nextDialogs": [
              "750040409"
            ]
          },
          "750040409": {
            "id": "750040409",
            "speakerId": 1004,
            "speakerName": "「毛发如夜的野兽」",
            "text": "去吧，但要小心危险的唆使，要小心阴险者谋划的结局。"
          }
        }
      }
    },

            ]
          },
          "716650106": {
            "id": "716650106",
            "speakerId": 1000,
            "speakerName": "兰吉特",
            "text": "事情是这样，我叫兰吉特，是个创意料理厨子，我想和爆炎树搞好关系，但是它好像不大乐意…",
            "nextDialogs": [
              "716650107"
            ]
          },
          "716650107": {
            "id": "716650107",
            "speakerId": 1000,
            "speakerName": "兰吉特",
            "text": "又是吐火球又是撞地，我真拿它没辙了，所以需要一个能当故事主角的冒险家来帮帮我。"
          }
        }
      }

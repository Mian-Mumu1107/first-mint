    {
      "subId": "2000902",
      "subQuestName": "和艾拉·马斯克一起前往丘丘人营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200090201"
        ],
        "dialogs": {
          "200090201": {
            "id": "200090201",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "这里刚好有个丘丘人醒着。",
            "nextDialogs": [
              "200090202"
            ]
          },
          "200090202": {
            "id": "200090202",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "就这位了，我们快点过去吧。",
            "nextDialogs": [
              "200090203"
            ]
          },
          "200090203": {
            "id": "200090203",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "小心点，过去的时候别吵醒其他丘丘人。",
            "nextDialogs": [
              "200090204"
            ]
          },
          "200090204": {
            "id": "200090204",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "不然他们肯定会误会，以为我们是准备来攻击他们。",
            "nextDialogs": [
              "200090205"
            ]
          },
          "200090205": {
            "id": "200090205",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "要是这样，肯定不能顺利地对话了。"
          }
        }
      }
    },

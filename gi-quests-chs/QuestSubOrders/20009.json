      }
    },
    {
      "subId": "2000901",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200090101"
        ],
        "dialogs": {
          "200090101": {
            "id": "200090101",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "旅行者，这里，过来这里！",
            "nextDialogs": [
              "200090102"
            ]
          },
          "200090102": {
            "id": "200090102",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "别惊动了那些丘丘人，你怎么总是直挺挺地往营地里面冲呀…",
            "nextDialogs": [
              "200090103"
            ]
          },
          "200090103": {
            "id": "200090103",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "算了，不管这些了，我一直在研究丘丘人的语言，但是比起记录，我更想要研究口语。",
            "nextDialogs": [
              "200090104"
            ]
          },
          "200090104": {
            "id": "200090104",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "好不容易在这里遇见了一个完整的丘丘人营地，我可不能放过这个机会。",
            "nextDialogs": [
              "200090105"
            ]
          },
          "200090105": {
            "id": "200090105",
            "speakerId": 1000,
            "speakerName": "艾拉·马斯克",
            "text": "所以，旅行者，你能和我一起去这营地里面，找个丘丘人来练习口语吗？"
          }
        }
      }
    }
  ]
}
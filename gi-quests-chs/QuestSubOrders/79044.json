    {
      "subId": "7904407",
      "subQuestName": "(test)完成海盗-计数用$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790440701"
        ],
        "dialogs": {
          "790440701": {
            "id": "790440701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…等等，之前还没有注意到，这里有一个隐藏的门？",
            "nextDialogs": [
              "790440702"
            ]
          },
          "790440702": {
            "id": "790440702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我好像明白了，念出报名时的那句暗号，就能打开新的道路！",
            "nextDialogs": [
              "790440703"
            ]
          },
          "790440703": {
            "id": "790440703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们一起来念暗号吧！",
            "nextDialogs": [
              "790440704"
            ]
          },
          "790440704": {
            "id": "790440704",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好啊！报名的时候，我们就是一起喊出口号的，这种时候当然也要注重仪式感！",
            "nextDialogs": [
              "790440705"
            ]
          },
          "790440705": {
            "id": "790440705",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "和派蒙一起念出关键的暗号：「带我们前往遐想的世界」。",
            "nextDialogs": [
              "790440706"
            ]
          },
          "790440706": {
            "id": "790440706",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "随着机件运作的声响，活动的门板开启，展现出了下方的通道。"
          }
        }
      }
    },
    {
      "subId": "7904408",
      "subQuestName": "(test)完成古堡-计数用$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790440801"
        ],
        "dialogs": {
          "790440801": {
            "id": "790440801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "果然没错！下面有一个暗室，肯定藏着什么秘密！",
            "nextDialogs": [
              "790440802"
            ]
          },
          "790440802": {
            "id": "790440802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，特别的礼物，还有神奇的黛依阿，我们来啦！"
          }
        }
      }
    },

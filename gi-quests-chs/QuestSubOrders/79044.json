    },
    {
      "subId": "7904405",
      "subQuestName": "见证剧目背后的真相",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790440601"
        ],
        "dialogs": {
          "790440601": {
            "id": "790440601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜啊！怎么有这么多的「小水珠」…它们围着一台超大的机器，在忙来忙去？",
            "nextDialogs": [
              "790440602"
            ]
          },
          "790440602": {
            "id": "790440602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "完全不明白，这台机器是干什么的？黛依阿又在哪里？",
            "nextDialogs": [
              "790440603"
            ]
          },
          "790440603": {
            "id": "790440603",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "欢迎探访「三日遐想」最真实的幕后！你们现在一定很疑惑吧——眼前的场景说明了什么？",
            "nextDialogs": [
              "790440604"
            ]
          },
          "790440604": {
            "id": "790440604",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "我们这就向你们详细展示！",
            "nextDialogs": [
              "790440605"
            ]
          },
          "790440605": {
            "id": "790440605",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "「偷懒鬼」，别打盹了，快去一号位置，进行二号操作！",
            "nextDialogs": [
              "790440606"
            ]
          },
          "790440606": {
            "id": "790440606",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "「由衷感谢命运的指引，四处徘徊的旅人们啊，你们总算来到了这里！」",
            "nextDialogs": [
              "790440607"
            ]
          },
          "790440607": {
            "id": "790440607",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那个「小水珠」在操纵喇叭，播放…录音？",
            "nextDialogs": [
              "790440608"
            ]
          },
          "790440608": {
            "id": "790440608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好耳熟…总觉得在哪里听过这句话？",
            "nextDialogs": [
              "790440611"
            ]
          },
          "790440611": {
            "id": "790440611",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "「全勤王」，在三号位置进行七号操作，拜托了！",
            "nextDialogs": [
              "790440612"
            ]
          },
          "790440612": {
            "id": "790440612",
            "speakerId": 1003,
            "speakerName": "来自喇叭的旁白",
            "text": "「出现在新人眼前的大副衣衫褴褛，全身上下打满绷带，显然，不久之前，他才经历过一场激烈的战斗…」",
            "nextDialogs": [
              "790440613"
            ]
          },
          "790440613": {
            "id": "790440613",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我想起来了！这一段是「黑水晶号与吞金海怪」的旁白，我们与大副刚刚见面的情景！",
            "nextDialogs": [
              "790440614"
            ]
          },
          "790440614": {
            "id": "790440614",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来当时听到的录音是这样播放出来的…时机也很准确呢！",
            "nextDialogs": [
              "790440615"
            ]
          },
          "790440615": {
            "id": "790440615",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "「大冒失」，「黑水晶」号快要抵达宝藏前的关隘了，赶快把所有布景和机关都升起来…千万别搞错了！",
            "nextDialogs": [
              "790440616"
            ]
          },
          "790440616": {
            "id": "790440616",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那个「小水珠」好像在用什么看不见的方法…操作面前的仪器？"
          }
        }
      }
    },

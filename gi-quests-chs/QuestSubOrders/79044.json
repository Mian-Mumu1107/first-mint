  "subQuests": [
    {
      "subId": "7904401",
      "subQuestName": "聆听特别的广播$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790440101"
        ],
        "dialogs": {
          "790440101": {
            "id": "790440101",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "由衷感谢命运的指引，四处徘徊的旅人们啊，你们总算来到了这里！",
            "nextDialogs": [
              "790440102"
            ]
          },
          "790440102": {
            "id": "790440102",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "你们必然也在寻找一场超越惊喜的邂逅，一次超乎想象的旅途？",
            "nextDialogs": [
              "790440103"
            ]
          },
          "790440103": {
            "id": "790440103",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "如今，我们互相成全的机会，正摆在你们面前！",
            "nextDialogs": [
              "790440104"
            ]
          },
          "790440104": {
            "id": "790440104",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "投身于全新的剧集「黛依阿的三日遐想」，置身于话剧的舞台之上，你们就能获得前所未有的新奇体验！",
            "nextDialogs": [
              "790440105"
            ]
          },
          "790440105": {
            "id": "790440105",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "畅游于摩拉的浴池之中…驱散古堡中的幽魂…挣脱重力的束缚…",
            "nextDialogs": [
              "790440106"
            ]
          },
          "790440106": {
            "id": "790440106",
            "speakerId": 1000,
            "speakerName": "乐园告示喇叭",
            "text": "轻轻念出暗号：「带我们前往遐想的世界」，昭示你们的好奇与热情，就此启程吧！",
            "nextDialogs": [
              "790440107"
            ]
          },
          "790440107": {
            "id": "790440107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，喇叭那一头的人真是激动啊，虽然不知道她具体在说什么…",
            "nextDialogs": [
              "790440108"
            ]
          },
          "790440108": {
            "id": "790440108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "旅途？剧集？舞台？还有什么…摩拉的浴池！",
            "nextDialogs": [
              "790440111"
            ]
          },
          "790440111": {
            "id": "790440111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喔！这么一说，我好像能理解了，以前听说过类似的活动呢。",
            "nextDialogs": [
              "790440112"
            ]
          },
          "790440112": {
            "id": "790440112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以喇叭后面正在说话的那个人，就是「黛依阿」吗？她是话剧的导演。",
            "nextDialogs": [
              "790440113"
            ]
          },
          "790440113": {
            "id": "790440113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "如果我们报名，就可以成为这些话剧中的角色？"
          }
        }
      }
    },
    {
      "subId": "7904402",
      "subQuestName": "完成三个剧目：",
      "sceneId": null,
      "locations": [],

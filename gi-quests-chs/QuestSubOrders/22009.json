    {
      "subId": "2200903",
      "subQuestName": "与索拉雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220090301"
        ],
        "dialogs": {
          "220090301": {
            "id": "220090301",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "怎么样？",
            "nextDialogs": [
              "220090302"
            ]
          },
          "220090302": {
            "id": "220090302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是文物。",
            "nextDialogs": [
              "220090303"
            ]
          },
          "220090303": {
            "id": "220090303",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "呼…没错，和我想的一样，他们果然是在循着我考察的路线挖掘。",
            "nextDialogs": [
              "220090304"
            ]
          },
          "220090304": {
            "id": "220090304",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "虽然没什么技术含量，但是这群乌合之众有着「人数」的优势，浩浩荡荡一拥而上，总能从边角里摸出点东西来。",
            "nextDialogs": [
              "220090305"
            ]
          },
          "220090305": {
            "id": "220090305",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "幸好有你，不然这些文物就要遭殃了，实在是太感谢了。"
          }
        }
      }
    }

  "subQuests": [
    {
      "subId": "7217401",
      "subQuestName": "与引渡人对话（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740101"
        ],
        "dialogs": {
          "721740101": {
            "id": "721740101",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "小河这边唉…银的柏树唉，银的艾草地哟，银的石头…",
            "nextDialogs": [
              "721740104"
            ]
          },
          "721740104": {
            "id": "721740104",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "哟…是客人来了？要登船吗？",
            "nextDialogs": [
              "721740105"
            ]
          },
          "721740105": {
            "id": "721740105",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "唉呀呀，仔细一看却是外人…可不行呢，可不行哟…"
          }
        }
      }
    },
    {
      "subId": "7217402",
      "subQuestName": "完成所有执念灵心愿（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740201"
        ],
        "dialogs": {
          "721740201": {
            "id": "721740201",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "呵呵…我看到了…一个老奶奶正惦记小孙孙呢，不放下心哟，上不了船唉…"
          }
        }
      }
    },
    {
      "subId": "7217403",
      "subQuestName": "与引渡人对话（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721741001"
        ],
        "dialogs": {
          "721741001": {
            "id": "721741001",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "都来了呀…大家都来了哟…",
            "nextDialogs": [
              "721741002"
            ]
          },
          "721741002": {
            "id": "721741002",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "谢谢你…岛外来的人哟…终于要起航了呀…",
            "nextDialogs": [
              "721741003"
            ]
          },
          "721741003": {
            "id": "721741003",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "河的那边哟…金的橡树哟…金的艾草地哟…金的石头…",
            "nextDialogs": [
              "721741004"
            ]
          },
          "721741004": {
            "id": "721741004",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "美好的风景哟…望不到头唉…"
          }
        }
      }
    },
    {
      "subId": "7217404",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740401"
        ],
        "dialogs": {
          "721740401": {
            "id": "721740401",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "哎哟哟…身体长得太快太快，却有个小孩子的魂灵儿…贪玩可笑哟，忘了登船…"
          }
        }
      }
    },
    {
      "subId": "7217403",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740301"
        ],
        "dialogs": {
          "721740301": {
            "id": "721740301",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "我看到…乖乖的小娃娃哟，还在牵挂着老奶奶…惹人怜惜唉，登不上船…"
          }
        }
      }
    },
    {
      "subId": "7217405",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740501"
        ],
        "dialogs": {
          "721740501": {
            "id": "721740501",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "银璨璨的月亮哟，银璨璨的心唉…看护迷雾之野的人呀，也该走出迷林了哟…该上船了，该上船了呀…"
          }
        }
      }
    },
    {
      "subId": "7217406",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740601"
        ],
        "dialogs": {
          "721740601": {
            "id": "721740601",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "依然执迷大地上新奇事物的老人哟，我们归去吧，我们归去哟…金色屋子唉，在月亮上哟…"
          }
        }
      }
    },
    {
      "subId": "7217407",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740701"
        ],
        "dialogs": {
          "721740701": {
            "id": "721740701",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "捡拾海螺的孩子哟…快来上船呀…兄长离弃了祖辈的灵，选择了海那边的归宿，快快忘记他呀…忘记分离的苦哟…"
          }
        }
      }
    },
    {
      "subId": "7217408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721740801"
        ],
        "dialogs": {
          "721740801": {
            "id": "721740801",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "逡巡岸边的孩子呀…你又遗失了什么呢…快快上船来吧，莫要留恋哟…"
          }
        }
      }
    },
    {
      "subId": "7217411",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721741101"
        ],
        "dialogs": {
          "721741101": {
            "id": "721741101",
            "speakerId": 1000,
            "speakerName": "「船工」",
            "text": "孤零零的孩子哟…你在与谁玩耍呢？快快来登船吧…去往不再孤单的家园…"
          }
        }
      }
    }
  ]
}
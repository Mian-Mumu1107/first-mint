  },
  "subQuests": [
    {
      "subId": "1503601",
      "subQuestName": "前往幕后真凶的藏身处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150360101"
        ],
        "dialogs": {
          "150360101": {
            "id": "150360101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里…我记得是层岩巨渊附近？",
            "nextDialogs": [
              "150360102"
            ]
          },
          "150360102": {
            "id": "150360102",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "从这里进去，就能抵达你梦里的那个空间。",
            "nextDialogs": [
              "150360103"
            ]
          },
          "150360103": {
            "id": "150360103",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "虽然同是深渊秘境，但那边是别人的地盘，还是要谨慎行事。",
            "nextDialogs": [
              "150360104"
            ]
          },
          "150360104": {
            "id": "150360104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#放心吧，我会躲到{NICKNAME}身后的！",
            "nextDialogs": [
              "150360105"
            ]
          },
          "150360105": {
            "id": "150360105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嘿嘿，{NICKNAME}，你也不要勉强哦。",
            "nextDialogs": [
              "150360108"
            ]
          },
          "150360108": {
            "id": "150360108",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "走吧。多想一想特训的内容，或许能用得上。"
          }
        }
      }
    },
    {
      "subId": "1503607",
      "subQuestName": "进入深渊裂隙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1503602",
      "subQuestName": "抵达深渊长廊尽头",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150360201"
        ],
        "dialogs": {
          "150360201": {
            "id": "150360201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "前面好像没有路了！这里就是那个坏蛋藏身的地方吗？",
            "nextDialogs": [
              "150360202"
            ]
          },
          "150360202": {
            "id": "150360202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好浓的雾，什么也看不清！",
            "nextDialogs": [
              "150360203"
            ]
          },
          "150360203": {
            "id": "150360203",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "之前，你就是在这里被袭击，失去了一部分灵魂碎片吧。",
            "nextDialogs": [
              "150360204"
            ]
          },
          "150360204": {
            "id": "150360204",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "你能感应到那部分灵魂碎片在哪吗？",
            "nextDialogs": [
              "150360205"
            ]
          },
          "150360205": {
            "id": "150360205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（闭上眼睛，努力想象当时从身体中逸散的光点…它似乎就在附近，但并不清楚它的具体方位。）",
            "nextDialogs": [
              "150360208"
            ]
          },
          "150360208": {
            "id": "150360208",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "看来对方也做好了准备，提前遮蔽了它的气息，否则灵魂之间应该存在更强烈的共鸣。",
            "nextDialogs": [
              "150360209"
            ]
          },
          "150360209": {
            "id": "150360209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下，快看！那些尖刺又出现了！",
            "nextDialogs": [
              "150360210"
            ]
          },
          "150360210": {
            "id": "150360210",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "「投鼠忌器」，说的就是这种情况。反击的时候收着点力，先观察对方的动作。",
            "nextDialogs": [
              "150360211"
            ]
          },
          "150360211": {
            "id": "150360211",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "对方既然夺走了你的灵魂碎片，就一定会用它做些什么。或许就藏在某个攻击招式里，想办法找出来。"
          }
        }
      }
    },
    {
      "subId": "1503608",
      "subQuestName": "躲避尖刺袭击",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1503603",
      "subQuestName": "躲避尖刺袭击",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150360301"
        ],
        "dialogs": {
          "150360301": {
            "id": "150360301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}、丝柯克！！",
            "nextDialogs": [
              "150360302"
            ]
          },
          "150360302": {
            "id": "150360302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚刚发生什么了？我看见丝柯克的肩膀好像被——",
            "nextDialogs": [
              "150360303"
            ]
          },
          "150360303": {
            "id": "150360303",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "……",
            "nextDialogs": [
              "150360304"
            ]
          },
          "150360304": {
            "id": "150360304",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "在归离原，你问我为什么那家伙盯上了你，将你视作重要的猎物。",
            "nextDialogs": [
              "150360305"
            ]
          },
          "150360305": {
            "id": "150360305",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "现在答案已经很明显了。除了你本身就具备着不俗的实力之外，也是因为你有着所谓「净化深渊」的能力。",
            "nextDialogs": [
              "150360306"
            ]
          },
          "150360306": {
            "id": "150360306",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "「净化」的本质暂且不论，借由这份力量，他就能做到许多原本做不到的事——",
            "nextDialogs": [
              "150360307"
            ]
          },
          "150360307": {
            "id": "150360307",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "就比如洞穿我的防御，吞噬我的力量。",
            "nextDialogs": [
              "150360310"
            ]
          },
          "150360310": {
            "id": "150360310",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "不，最初他应该并不清楚我会来。拿走你的灵魂碎片，只是认为你的力量很珍贵，没想到碰巧能在这时候派上用场。",
            "nextDialogs": [
              "150360311"
            ]
          },
          "150360311": {
            "id": "150360311",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "如果这世界上真有所谓的命运，指的应该就是这种无聊的巧合吧。",
            "nextDialogs": [
              "150360312"
            ]
          },
          "150360312": {
            "id": "150360312",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "不过，对我们来说也是好事。想明白它会将你的力量用在哪，就能反过来将你失去的东西拿回来。",
            "nextDialogs": [
              "150360313"
            ]
          },
          "150360313": {
            "id": "150360313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是你…",
            "nextDialogs": [
              "150360314"
            ]
          },
          "150360314": {
            "id": "150360314",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我心里有数。",
            "nextDialogs": [
              "150360315"
            ]
          },
          "150360315": {
            "id": "150360315",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "吃饱了吗？回答我的问题。",
            "nextDialogs": [
              "150360316"
            ]
          },
          "150360316": {
            "id": "150360316",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "为什么…你会有「吞星之鲸」的权能？",
            "nextDialogs": [
              "150360317"
            ]
          },
          "150360317": {
            "id": "150360317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吞星之鲸？！",
            "nextDialogs": [
              "150360318"
            ]
          },
          "150360318": {
            "id": "150360318",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…对哦！怪不得我看那个尖刺有点眼熟，那东西…长得很像吞星之鲸头上的角！",
            "nextDialogs": [
              "150360319"
            ]
          },
          "150360319": {
            "id": "150360319",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "这份权能不是你靠自己的力量得来的，对吧？",
            "nextDialogs": [
              "150360320"
            ]
          },
          "150360320": {
            "id": "150360320",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "如果你真有战胜吞星之鲸的实力，就无需四处收集魔神残渣这种不完整的力量。",
            "nextDialogs": [
              "150360321"
            ]
          },
          "150360321": {
            "id": "150360321",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我只能想到一种可能性。你认识我的师父，「极恶骑」苏尔特洛奇是吗？",
            "nextDialogs": [
              "150360322"
            ]
          },
          "150360322": {
            "id": "150360322",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "「极恶骑」…",
            "nextDialogs": [
              "150360323"
            ]
          },
          "150360323": {
            "id": "150360323",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "何人称其为「恶」？苏尔特洛奇…",
            "nextDialogs": [
              "150360324"
            ]
          },
          "150360324": {
            "id": "150360324",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "苏尔…特洛奇…！",
            "nextDialogs": [
              "150360325"
            ]
          },
          "150360325": {
            "id": "150360325",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "被力量冲昏了头脑，已经失去了基本的交流能力吗？",
            "nextDialogs": [
              "150360326"
            ]
          },
          "150360326": {
            "id": "150360326",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "再等等，我还没有…",
            "nextDialogs": [
              "150360327"
            ]
          },
          "150360327": {
            "id": "150360327",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快看！那东西又来了！",
            "nextDialogs": [
              "150360328"
            ]
          },
          "150360328": {
            "id": "150360328",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "痴迷力量的人，在被反噬前都不会回头。",
            "nextDialogs": [
              "150360329"
            ]
          },
          "150360329": {
            "id": "150360329",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "现在该怎么办？",
            "nextDialogs": [
              "150360330"
            ]
          },
          "150360330": {
            "id": "150360330",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "冷静。用你的「理性」思考，做你认为最合适的选择。",
            "nextDialogs": [
              "150360331"
            ]
          },
          "150360331": {
            "id": "150360331",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（为了拿回我的灵魂碎片，丝柯克被那家伙的尖刺刺伤，力量也被夺走了。）",
            "nextDialogs": [
              "150360332"
            ]
          },
          "150360332": {
            "id": "150360332",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（元凶就在迷雾之后。在刚刚的交手中，我已经逐渐摸清楚对方的攻击方式了。继续动手，胜算很高。）",
            "nextDialogs": [
              "150360333"
            ]
          },
          "150360333": {
            "id": "150360333",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（但是丝柯克的气息比平时弱了许多。贸然进攻的话，必然无法保证她和派蒙的安全。虽然很不情愿…）",
            "nextDialogs": [
              "150360334"
            ]
          },
          "150360334": {
            "id": "150360334",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先离开这里吧。",
            "nextDialogs": [
              "150360335"
            ]
          },
          "150360335": {
            "id": "150360335",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "胜负不在一时，你做了正确的判断。",
            "nextDialogs": [
              "150360336"
            ]
          },
          "150360336": {
            "id": "150360336",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "既然拿回了你的灵魂碎片，此行的目的也就达成了。至于他的命，再多寄存一段时间也无妨。",
            "nextDialogs": [
              "150360337"
            ]
          },
          "150360337": {
            "id": "150360337",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "走吧。这次，靠你带我们出去了。"
          }
        }
      }
    },
    {
      "subId": "1503604",
      "subQuestName": "撤离快要坍塌的深渊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1503605",
      "subQuestName": "与丝柯克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150360501"
        ],
        "dialogs": {
          "150360501": {
            "id": "150360501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…跑到这里，应该安全了吧？",
            "nextDialogs": [
              "150360502"
            ]
          },
          "150360502": {
            "id": "150360502",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "察觉不到他的气息，看来他仍停留在深渊秘境中。",
            "nextDialogs": [
              "150360503"
            ]
          },
          "150360503": {
            "id": "150360503",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我的力量不是弱者轻易能够掌控的。在他消化完之前，应该都不会从那里离开了。",
            "nextDialogs": [
              "150360506"
            ]
          },
          "150360506": {
            "id": "150360506",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "你看上去很惊讶。",
            "nextDialogs": [
              "150360507"
            ]
          },
          "150360507": {
            "id": "150360507",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "也对…你并未真正见过那头鲸鱼张开血盆大口，仿佛要将星球吞入腹中的场景。",
            "nextDialogs": [
              "150360508"
            ]
          },
          "150360508": {
            "id": "150360508",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "吞星之鲸有着「吞噬」的权能。无论是活人还是死物，只要能破开防御，直接接触到对方的本体，就能从中抽取力量。",
            "nextDialogs": [
              "150360509"
            ]
          },
          "150360509": {
            "id": "150360509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们和它交手的时候，那维莱特好像也说过，「吞噬」是它的本能…",
            "nextDialogs": [
              "150360510"
            ]
          },
          "150360510": {
            "id": "150360510",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "古龙的孑遗看出了它力量的实质，一直在用「水」的权能保护你们。那时候吞星之鲸也还处于饱腹的状态，没有彻底躁怒。",
            "nextDialogs": [
              "150360511"
            ]
          },
          "150360511": {
            "id": "150360511",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "在力量完全耗尽后，它才会逐渐展露出真正的本性，将星球上的一切化作储粮。所以我将它收存在特殊的虚无空间里…",
            "nextDialogs": [
              "150360512"
            ]
          },
          "150360512": {
            "id": "150360512",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "只是没想到，在这颗星球上，仍有人可以使用它的权能。这说明他在很久以前就见过吞星之鲸，应该是师父认识的人。",
            "nextDialogs": [
              "150360513"
            ]
          },
          "150360513": {
            "id": "150360513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他确实对「极恶骑」这个词有反应。",
            "nextDialogs": [
              "150360514"
            ]
          },
          "150360514": {
            "id": "150360514",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "所以我说，此行的目的已经完成了。",
            "nextDialogs": [
              "150360515"
            ]
          },
          "150360515": {
            "id": "150360515",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "这之后就是我的私事。如今的你已经重归完整，可以继续自己的旅程了。",
            "nextDialogs": [
              "150360516"
            ]
          },
          "150360516": {
            "id": "150360516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这怎么行！为了帮我们的忙，你的力量才被夺走了，我们怎么能放着你不管呢？",
            "nextDialogs": [
              "150360517"
            ]
          },
          "150360517": {
            "id": "150360517",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "承受失败、失去力量，我已经不是第一次经历这种事情了。若是坠入低谷，就重新向上攀爬，直至变得更强。",
            "nextDialogs": [
              "150360518"
            ]
          },
          "150360518": {
            "id": "150360518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就算这样…万一那个怪物在你恢复好之前就找到你怎么办？",
            "nextDialogs": [
              "150360519"
            ]
          },
          "150360519": {
            "id": "150360519",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且你失去了力量，应该也不能像以前那样「咻」地一下打开去深渊的门了吧？",
            "nextDialogs": [
              "150360520"
            ]
          },
          "150360520": {
            "id": "150360520",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "至少这段时间，跟我们一起行动也不是什么坏事，对吧？"
          }
        }
      }
    },
    {
      "subId": "1503609",
      "subQuestName": "前往不卜庐休整",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1503606",
      "subQuestName": "前往不卜庐休整",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150360601"
        ],
        "dialogs": {
          "150360601": {
            "id": "150360601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "仔细一看，丝柯克的包里居然装了这么多摩拉…",
            "nextDialogs": [
              "150360602"
            ]
          },
          "150360602": {
            "id": "150360602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道说她也在打工？不对不对，你还记得万民堂那时候发生的事吗？如果她去打工的话，绝对会变成这样子——",
            "nextDialogs": [
              "150360603"
            ]
          },
          "150360603": {
            "id": "150360603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「老板，结一下这个月的工钱。」",
            "nextDialogs": [
              "150360604"
            ]
          },
          "150360604": {
            "id": "150360604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「好的。等一下…你是谁？我们认识吗？」",
            "nextDialogs": [
              "150360605"
            ]
          },
          "150360605": {
            "id": "150360605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，毕竟见过她的人一眨眼就把她忘了嘛。这些摩拉是从哪来的呢？",
            "nextDialogs": [
              "150360606"
            ]
          },
          "150360606": {
            "id": "150360606",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "地下的无主宝藏，以及顺手解决一些寻衅的魔物。来路正当，放心用吧。",
            "nextDialogs": [
              "150360607"
            ]
          },
          "150360607": {
            "id": "150360607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！你能听到吗？",
            "nextDialogs": [
              "150360608"
            ]
          },
          "150360608": {
            "id": "150360608",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "这么响的说话声，站在门外的山顶上都能听到。",
            "nextDialogs": [
              "150360609"
            ]
          },
          "150360609": {
            "id": "150360609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？等下，该不会我之前在背后说的那些…",
            "nextDialogs": [
              "150360610"
            ]
          },
          "150360610": {
            "id": "150360610",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "你指什么？雪山冻堇瓜？",
            "nextDialogs": [
              "150360613"
            ]
          },
          "150360613": {
            "id": "150360613",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个…其实那句话不是我说的啦！是有一个长得和我很像的人，总喜欢背后冒充我，给别人起奇怪的绰号！",
            "nextDialogs": [
              "150360614"
            ]
          },
          "150360614": {
            "id": "150360614",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#…好吧，我错了。那时候我不太喜欢你，但现在我觉得你人还不错，毕竟帮了{NICKNAME}这么大忙。我们可以当朋友吗？",
            "nextDialogs": [
              "150360615"
            ]
          },
          "150360615": {
            "id": "150360615",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "……",
            "nextDialogs": [
              "150360616"
            ]
          },
          "150360616": {
            "id": "150360616",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我刚刚看过，这里只有一张床，你们去休息吧。",
            "nextDialogs": [
              "150360617"
            ]
          },
          "150360617": {
            "id": "150360617",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？那你呢？",
            "nextDialogs": [
              "150360618"
            ]
          },
          "150360618": {
            "id": "150360618",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "我不会感到疲惫，也不需要休息。我去外面挥剑，这样力量能快些恢复。",
            "nextDialogs": [
              "150360619"
            ]
          },
          "150360619": {
            "id": "150360619",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是你的身体——欸！等下，这就走啦！",
            "nextDialogs": [
              "150360620"
            ]
          },
          "150360620": {
            "id": "150360620",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "气死我了。哼！不管她，等她累了自然就回来休息了。",
            "nextDialogs": [
              "150360621"
            ]
          },
          "150360621": {
            "id": "150360621",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们睡觉！睡软软的床！",
            "nextDialogs": [
              "150360622"
            ]
          },
          "150360622": {
            "id": "150360622",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（丝柯克很有主见，现在劝她躺下休息，她应该也不会答应。）",
            "nextDialogs": [
              "150360623"
            ]
          },
          "150360623": {
            "id": "150360623",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（派蒙说的也有道理，如果丝柯克感到疲惫，她应该就会停止训练了。今晚先睡下吧。）",
            "nextDialogs": [
              "150360624"
            ]
          },
          "150360624": {
            "id": "150360624",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "呼…呼…",
            "nextDialogs": [
              "150360625"
            ]
          },
          "150360625": {
            "id": "150360625",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（丝柯克…？）",
            "nextDialogs": [
              "150360626"
            ]
          },
          "150360626": {
            "id": "150360626",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（不愧是她，这么快就恢复了一些力量。不过她看上去有些奇怪…）",
            "nextDialogs": [
              "150360627"
            ]
          },
          "150360627": {
            "id": "150360627",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "呼…",
            "nextDialogs": [
              "150360628"
            ]
          },
          "150360628": {
            "id": "150360628",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "…安静。",
            "nextDialogs": [
              "150360629"
            ]
          },
          "150360629": {
            "id": "150360629",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（安静？周围明明没有人说话。难道说…）",
            "nextDialogs": [
              "150360630"
            ]
          },
          "150360630": {
            "id": "150360630",
            "speakerId": 1003,
            "speakerName": "蛊惑人心的声音",
            "text": "想想我们吧，多少人葬身在那场大火当中，只有你一个人活了下来。",
            "nextDialogs": [
              "150360631"
            ]
          },
          "150360631": {
            "id": "150360631",
            "speakerId": 1003,
            "speakerName": "蛊惑人心的声音",
            "text": "不要将目光从剑上挪开，你还没有资格休息。",
            "nextDialogs": [
              "150360632"
            ]
          },
          "150360632": {
            "id": "150360632",
            "speakerId": 1003,
            "speakerName": "蛊惑人心的声音",
            "text": "跑起来，丝柯克。在死亡到来前，你都要不停地跑下去——",
            "nextDialogs": [
              "150360633"
            ]
          },
          "150360633": {
            "id": "150360633",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（对了。那次在梦里，丝柯克也是在经历了一场失败后孤独地练剑，身后有数不清的杂声。）",
            "nextDialogs": [
              "150360634"
            ]
          },
          "150360634": {
            "id": "150360634",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（大火…到底发生过什么事呢？要是她愿意和我们说说就好了…）",
            "nextDialogs": [
              "150360635"
            ]
          },
          "150360635": {
            "id": "150360635",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "早睡早起身体好！这床真舒服呀——",
            "nextDialogs": [
              "150360636"
            ]
          },
          "150360636": {
            "id": "150360636",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "丝柯克，你在这坐了一晚上吗？要不要休息一会儿？",
            "nextDialogs": [
              "150360637"
            ]
          },
          "150360637": {
            "id": "150360637",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "……",
            "nextDialogs": [
              "150360638"
            ]
          },
          "150360638": {
            "id": "150360638",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "力量恢复了吗？",
            "nextDialogs": [
              "150360639"
            ]
          },
          "150360639": {
            "id": "150360639",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "恢复了六七成。",
            "nextDialogs": [
              "150360640"
            ]
          },
          "150360640": {
            "id": "150360640",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么快！我还以为至少要几天呢！",
            "nextDialogs": [
              "150360641"
            ]
          },
          "150360641": {
            "id": "150360641",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "不…比我预想中要慢。",
            "nextDialogs": [
              "150360642"
            ]
          },
          "150360642": {
            "id": "150360642",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "如果是以前，力量还要多恢复两成。同样的方法、同样的感受，结果却变差了。",
            "nextDialogs": [
              "150360643"
            ]
          },
          "150360643": {
            "id": "150360643",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道是受那个尖刺的影响？",
            "nextDialogs": [
              "150360644"
            ]
          },
          "150360644": {
            "id": "150360644",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "应该是我自己出了问题。",
            "nextDialogs": [
              "150360645"
            ]
          },
          "150360645": {
            "id": "150360645",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "接下来的两天，我需要在这里冥想，让意识完全沉入内心，看看到底发生了什么。",
            "nextDialogs": [
              "150360646"
            ]
          },
          "150360646": {
            "id": "150360646",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "冥想！听起来好厉害，那我们就在旁边护法好啦。",
            "nextDialogs": [
              "150360647"
            ]
          },
          "150360647": {
            "id": "150360647",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "有劳。两天后见。"
          }
        }
      }
    },
    {
      "subId": "1503604",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150360411"
        ],
        "dialogs": {
          "150360411": {
            "id": "150360411",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "刚才开始，对方的进攻重点就放在我身上。",
            "nextDialogs": [
              "150360414"
            ]
          },
          "150360414": {
            "id": "150360414",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "自信能打穿我的防御？难道说…",
            "nextDialogs": [
              "150360424"
            ]
          },
          "150360424": {
            "id": "150360424",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还好吗？刚刚那是…",
            "nextDialogs": [
              "150360428"
            ]
          },
          "150360428": {
            "id": "150360428",
            "speakerId": 13790,
            "speakerName": "丝柯克",
            "text": "收好。我帮你拿回来了。"
          }
        }
      }
    },
    {
      "subId": "1503650",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150365001"
        ],
        "dialogs": {
          "150365001": {
            "id": "150365001",
            "speakerId": 1311,
            "speakerName": "丝柯克",
            "text": "他的身上一定有关于师父的线索。下次见面…",
            "nextDialogs": [
              "150365003",
              "150365006",
              "150365009"
            ]
          },
          "150365003": {
            "id": "150365003",
            "speakerId": 1311,
            "speakerName": "丝柯克",
            "text": "外伤而已，不必在意。",
            "nextDialogs": [
              "150365004"
            ]
          },
          "150365004": {
            "id": "150365004",
            "speakerId": 1311,
            "speakerName": "丝柯克",
            "text": "虽然恢复力量需要时间，但这种程度的困境我已经「适应」了。"
          },
          "150365006": {
            "id": "150365006",
            "speakerId": 1311,
            "speakerName": "丝柯克",
            "text": "你说这个？提瓦特的深渊能量非常稀薄，为了更加自由地使用力量，我制作了一种「星晶旅装」。",
            "nextDialogs": [
              "150365007"
            ]
          },
          "150365007": {
            "id": "150365007",
            "speakerId": 1311,
            "speakerName": "丝柯克",
            "text": "里面蕴藏着高规格的深渊能量，可以为我的行动提供便利。能量散尽的时候，就会变回它最初的样子。"
          },
          "150365009": {
            "id": "150365009",
            "speakerId": 1311,
            "speakerName": "丝柯克",
            "text": "找好休息的地方了吗？那就尽快离开这里吧。"
          }
        }
      }
    },
    {
      "subId": "1503651",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150365101"
        ],
        "dialogs": {
          "150365101": {
            "id": "150365101",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "你看上去比之前健康许多，烦扰消失了？",
            "nextDialogs": [
              "150365102"
            ]
          },
          "150365102": {
            "id": "150365102",
            "speakerId": 1005,
            "speakerName": "长生",
            "text": "嚯，真不简单。不过现在放松还太早了吧？",
            "nextDialogs": [
              "150365103"
            ]
          },
          "150365103": {
            "id": "150365103",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "没错。疾病初愈，还是再观察一段时间为好。",
            "nextDialogs": [
              "150365104"
            ]
          },
          "150365104": {
            "id": "150365104",
            "speakerId": 10234,
            "speakerName": "白术",
            "text": "正好近期病人不多，许多房间都空置着。如有需要，可以再暂住几天。",
            "nextDialogs": [
              "150365105"
            ]
          },
          "150365105": {
            "id": "150365105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太好啦，谢谢你们！"
          }
        }
      }
    },
    {
      "subId": "1503699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150369901"
        ],
        "dialogs": {
          "150369901": {
            "id": "150369901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼啊——终于要出发了吗？",
            "nextDialogs": [
              "150369902"
            ]
          },
          "150369902": {
            "id": "150369902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在我们要去哪？",
            "nextDialogs": [
              "150369903"
            ]
          },
          "150369903": {
            "id": "150369903",
            "speakerId": 1311,
            "speakerName": "丝柯克",
            "text": "跟我来。我会到离那家伙最近的地方打开深渊裂隙，带你们去他的藏身之处。",
            "nextDialogs": [
              "150369904"
            ]
          },
          "150369904": {
            "id": "150369904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们带丝柯克去休息吧！让我想想，去哪比较好呢？",
            "nextDialogs": [
              "150369905"
            ]
          },
          "150369905": {
            "id": "150369905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉丝柯克应该不喜欢人多的地方…对了。白术不是借了我们一间病房吗？我们带丝柯克去那里休息吧。"
          }
        }
      }
    }
  ]
}
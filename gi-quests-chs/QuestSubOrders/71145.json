  "subQuests": [
    {
      "subId": "7114501",
      "subQuestName": "与苏定对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711450101"
        ],
        "dialogs": {
          "711450101": {
            "id": "711450101",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "#有劳两位了，{NICKNAME}顾问和这位才智出众的帮手！",
            "nextDialogs": [
              "711450102"
            ]
          },
          "711450102": {
            "id": "711450102",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "经过这段时间的推演，我们获得了充足的对抗案例，足以拆解出各种复杂战况的分析样本。",
            "nextDialogs": [
              "711450103"
            ]
          },
          "711450103": {
            "id": "711450103",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "接下来，只需根据推演兵种的特性，建立更宽泛的模型，就能撰写多种想定脚本，将它们交给多个单位的各级将士钻研。",
            "nextDialogs": [
              "711450104"
            ]
          },
          "711450104": {
            "id": "711450104",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "如果两位有兴趣，下次见面时，我也会为你们提供对应的想定脚本，以供你们在闲暇之时锻炼才思。",
            "nextDialogs": [
              "711450106",
              "711450108"
            ]
          },
          "711450106": {
            "id": "711450106",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "我们深知两位事务繁忙，尽量排除了相似的推演，避免重复工作。当然，如果两位还没尽兴，再来多少次都没问题。",
            "nextDialogs": [
              "711450109"
            ]
          },
          "711450109": {
            "id": "711450109",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "总而言之，我代表千岩军的参谋部，以及其他参会单位的代表，向你们表示郑重的感谢！",
            "nextDialogs": [
              "711450110"
            ]
          },
          "711450110": {
            "id": "711450110",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "希望以后还有机会与两位合作，进一步加强各单位清除魔物，改善治安状况的能力。"
          },
          "711450108": {
            "id": "711450108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，虽然我还没完全搞明白各种规则，但玩得还挺开心的！看起来结果也不错嘛！"
          }
        }
      }
    }
  ]
}
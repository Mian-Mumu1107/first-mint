  "subQuests": [
    {
      "subId": "7612101",
      "subQuestName": "同哥伦比娅见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761210101"
        ],
        "dialogs": {
          "761210101": {
            "id": "761210101",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "♪~",
            "nextDialogs": [
              "761210102"
            ]
          },
          "761210102": {
            "id": "761210102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哥伦比娅，你好呀，你今天心情很好嘛！",
            "nextDialogs": [
              "761210103"
            ]
          },
          "761210103": {
            "id": "761210103",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "哈…上来吧。",
            "nextDialogs": [
              "761210104"
            ]
          },
          "761210104": {
            "id": "761210104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢！你是又想玩「月亮棋」了吗？",
            "nextDialogs": [
              "761210105"
            ]
          },
          "761210105": {
            "id": "761210105",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "嗯，很久没玩了，有点想念。",
            "nextDialogs": [
              "761210106"
            ]
          },
          "761210106": {
            "id": "761210106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "规则还和以前一样吗？",
            "nextDialogs": [
              "761210107"
            ]
          },
          "761210107": {
            "id": "761210107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不会因为你变成了三月女神，每次你都能多动几颗棋子吧？",
            "nextDialogs": [
              "761210108"
            ]
          },
          "761210108": {
            "id": "761210108",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "那就变成作弊了，我不会用这种方式赢的。",
            "nextDialogs": [
              "761210109"
            ]
          },
          "761210109": {
            "id": "761210109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，我知道的啦，开个小玩笑。",
            "nextDialogs": [
              "761210110"
            ]
          },
          "761210110": {
            "id": "761210110",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "那么，我们开始吧？"
          }
        }
      }
    },
    {
      "subId": "7612102",
      "subQuestName": "同哥伦比娅玩月亮棋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761210201"
        ],
        "dialogs": {
          "761210201": {
            "id": "761210201",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "与哥伦比娅在游戏中度过了一段愉快的时光…",
            "nextDialogs": [
              "761210202"
            ]
          },
          "761210202": {
            "id": "761210202",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "三个月亮连成一条线…",
            "nextDialogs": [
              "761210203"
            ]
          },
          "761210203": {
            "id": "761210203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么了？还在想刚刚那盘棋的输赢吗？",
            "nextDialogs": [
              "761210204"
            ]
          },
          "761210204": {
            "id": "761210204",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "哦，没有。只是…如今回看这游戏，会有些不可思议的感觉。",
            "nextDialogs": [
              "761210205"
            ]
          },
          "761210205": {
            "id": "761210205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，你获得了三个月亮的力量，那已经不只是能主宰夜空这种级别的东西了。",
            "nextDialogs": [
              "761210206"
            ]
          },
          "761210206": {
            "id": "761210206",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "嗯，我也会想，若是当初三位月之女神没有产生分歧的话，世界的命运说不定就变得不一样了。",
            "nextDialogs": [
              "761210207"
            ]
          },
          "761210207": {
            "id": "761210207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她们看起来如何？",
            "nextDialogs": [
              "761210208"
            ]
          },
          "761210208": {
            "id": "761210208",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "唔…我最先见到的是虹月女神，桑娜妲。她比我想象中活泼一些，像个贪玩的妹妹。",
            "nextDialogs": [
              "761210209"
            ]
          },
          "761210209": {
            "id": "761210209",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "恒月女神艾莉亚是三位女神中最稳重的一位，富有领导力，对他人也很温柔。啊，就像菈乌玛一样呢。",
            "nextDialogs": [
              "761210210"
            ]
          },
          "761210210": {
            "id": "761210210",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "霜月女神卡侬…看起来是位既智慧，又有远见的女神。也就是她，把自己的月亮让给了我。",
            "nextDialogs": [
              "761210211"
            ]
          },
          "761210211": {
            "id": "761210211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来都是善良的神明…",
            "nextDialogs": [
              "761210212"
            ]
          },
          "761210212": {
            "id": "761210212",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "没错，尽管有所分歧，但她们都爱着提瓦特这个世界，爱着这个家。",
            "nextDialogs": [
              "761210213"
            ]
          },
          "761210213": {
            "id": "761210213",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "当我说起未来的事情，她们看起来都很欣慰。一种为这个世界仍有如此丰富的未来感到高兴的样子。",
            "nextDialogs": [
              "761210214"
            ]
          },
          "761210214": {
            "id": "761210214",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "也正因如此，她们才给予我力量，帮我回到了这个「家」。",
            "nextDialogs": [
              "761210215"
            ]
          },
          "761210215": {
            "id": "761210215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…真想见她们一面，对她们好好道一声谢呢…",
            "nextDialogs": [
              "761210216"
            ]
          },
          "761210216": {
            "id": "761210216",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "我也这么想，不过…那大概是不可能的事了吧…",
            "nextDialogs": [
              "761210217"
            ]
          },
          "761210217": {
            "id": "761210217",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "好在这个世界仍在前行，她们所保护的人类也活了下来，传唱着她们的故事。",
            "nextDialogs": [
              "761210218"
            ]
          },
          "761210218": {
            "id": "761210218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没错！只要好好地过日子，不让坏蛋毁了这个世界，就是对三位女神最好的感谢！",
            "nextDialogs": [
              "761210221"
            ]
          },
          "761210221": {
            "id": "761210221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那当然！我绝对每天都会把日子过得开开心心的！",
            "nextDialogs": [
              "761210222"
            ]
          },
          "761210222": {
            "id": "761210222",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哥伦比娅也是哦！每天都应该吃饱睡好，想玩游戏了就来找我们吧！",
            "nextDialogs": [
              "761210223"
            ]
          },
          "761210223": {
            "id": "761210223",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "哈哈，好呀。",
            "nextDialogs": [
              "761210224"
            ]
          },
          "761210224": {
            "id": "761210224",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "以后玩「月亮棋」的时候，我或许都会想起那三位善良的女神吧…"
          }
        }
      }
    },
    {
      "subId": "7605403",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760540301"
        ],
        "dialogs": {
          "760540301": {
            "id": "760540301",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这样对吗…？",
            "nextDialogs": [
              "760540302"
            ]
          },
          "760540302": {
            "id": "760540302",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我想想…",
            "nextDialogs": [
              "760540303"
            ]
          },
          "760540303": {
            "id": "760540303",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "唔…",
            "nextDialogs": [
              "760540304"
            ]
          },
          "760540304": {
            "id": "760540304",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "月亮…月亮…",
            "nextDialogs": [
              "760540305"
            ]
          },
          "760540305": {
            "id": "760540305",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这里怎么样？",
            "nextDialogs": [
              "760540306"
            ]
          },
          "760540306": {
            "id": "760540306",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这次是我赢了。",
            "nextDialogs": [
              "760540307"
            ]
          },
          "760540307": {
            "id": "760540307",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我的三个月亮连起来了。",
            "nextDialogs": [
              "760540308"
            ]
          },
          "760540308": {
            "id": "760540308",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，这样就赢了。",
            "nextDialogs": [
              "760540309"
            ]
          },
          "760540309": {
            "id": "760540309",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯…月升月落，真是漫长。",
            "nextDialogs": [
              "760540310"
            ]
          },
          "760540310": {
            "id": "760540310",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我们的月亮谁都不让谁呢。",
            "nextDialogs": [
              "760540311"
            ]
          },
          "760540311": {
            "id": "760540311",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "是不是…快平手了？",
            "nextDialogs": [
              "760540312"
            ]
          },
          "760540312": {
            "id": "760540312",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "原来你喜欢深思熟虑后再做决定，嗯，没事，我们有很多时间。",
            "nextDialogs": [
              "760540313"
            ]
          },
          "760540313": {
            "id": "760540313",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "忘了怎么将「月亮」放上「夜空」吗？要不要我帮你？",
            "nextDialogs": [
              "760540314"
            ]
          },
          "760540314": {
            "id": "760540314",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "不喜欢这个游戏吗？我觉得还挺有意思。",
            "nextDialogs": [
              "760540315"
            ]
          },
          "760540315": {
            "id": "760540315",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯？你是在盯着我看吗？我感觉得到。",
            "nextDialogs": [
              "760540316"
            ]
          },
          "760540316": {
            "id": "760540316",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我的脸上…有关于「月亮」的答案吗？",
            "nextDialogs": [
              "760540317"
            ]
          },
          "760540317": {
            "id": "760540317",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "棋盘在那边哦。",
            "nextDialogs": [
              "760540318"
            ]
          },
          "760540318": {
            "id": "760540318",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，是你的「月亮」获胜了。",
            "nextDialogs": [
              "760540319"
            ]
          },
          "760540319": {
            "id": "760540319",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这片夜空属于你了。",
            "nextDialogs": [
              "760540320"
            ]
          },
          "760540320": {
            "id": "760540320",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "啊…一不小心就…",
            "nextDialogs": [
              "760540321"
            ]
          },
          "760540321": {
            "id": "760540321",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "与哥伦比娅在游戏中度过了一段愉快的时光…"
          }
        }
      }
    },
    {
      "subId": "7612103",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

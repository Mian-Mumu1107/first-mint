  "subQuests": [
    {
      "subId": "7108701",
      "subQuestName": "隐藏瑾武送汤$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710380601"
        ],
        "dialogs": {
          "710380601": {
            "id": "710380601",
            "speakerId": 1000,
            "speakerName": "瑾武",
            "text": "海迪夫给她开了些药…志琼恢复了一点意识，但她什么也不愿意跟我说。",
            "nextDialogs": [
              "710380602"
            ]
          },
          "710380602": {
            "id": "710380602",
            "speakerId": 1000,
            "speakerName": "瑾武",
            "text": "你们知道她是怎么回事吗？好好的一个人，怎么会变成这样？",
            "nextDialogs": [
              "710380603"
            ]
          },
          "710380603": {
            "id": "710380603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们发现她时，她被困在了黑泥里。",
            "nextDialogs": [
              "710380604"
            ]
          },
          "710380604": {
            "id": "710380604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对呀对呀，幸好我们及时把她救出来了！",
            "nextDialogs": [
              "710380605"
            ]
          },
          "710380605": {
            "id": "710380605",
            "speakerId": 1000,
            "speakerName": "瑾武",
            "text": "……",
            "nextDialogs": [
              "710380606"
            ]
          },
          "710380606": {
            "id": "710380606",
            "speakerId": 1000,
            "speakerName": "瑾武",
            "text": "算了，志琼现在最需要休息。请替我把这碗汤趁热递给她吧。",
            "nextDialogs": [
              "710380607"
            ]
          },
          "710380607": {
            "id": "710380607",
            "speakerId": 1000,
            "speakerName": "瑾武",
            "text": "虽然不太会做饭，照顾矿工的事情反正我也没少做过。还没人敢嫌弃我的手艺。",
            "nextDialogs": [
              "710380608"
            ]
          },
          "710380608": {
            "id": "710380608",
            "speakerId": 1000,
            "speakerName": "瑾武",
            "text": "好了，去吧，看看志琼好些了吗。",
            "nextDialogs": [
              "710380609"
            ]
          },
          "710380609": {
            "id": "710380609",
            "speakerId": 1000,
            "speakerName": "瑾武",
            "text": "我需要跟沐宁反映一下，志琼不能留在地下了。"
          }
        }
      }
    }
  ]
}
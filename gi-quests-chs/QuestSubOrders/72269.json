    {
      "subId": "7226901",
      "subQuestName": "和封印前的残魂对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722690101"
        ],
        "dialogs": {
          "722690101": {
            "id": "722690101",
            "speakerId": 1000,
            "speakerName": "江木",
            "text": "我乃末代地走官·江木。珊瑚宫之勇者，我认可你挑战的荣誉。",
            "nextDialogs": [
              "722690102"
            ]
          },
          "722690102": {
            "id": "722690102",
            "speakerId": 1000,
            "speakerName": "江木",
            "text": "我将主持「明察」之试炼。请你动身去解开所有的谜题，让「高门之火」归位。",
            "nextDialogs": [
              "722690103"
            ]
          },
          "722690103": {
            "id": "722690103",
            "speakerId": 1000,
            "speakerName": "江木",
            "text": "战场瞬息万变。唯有耳观八方、眼观六路才能把握情况，把握一切变数。"
          }
        }
      }
    },
    {
      "subId": "7226902",
      "subQuestName": "解放所有「高门之火」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722690201"
        ],
        "dialogs": {
          "722690201": {
            "id": "722690201",
            "speakerId": 1000,
            "speakerName": "江木",
            "text": "珊瑚宫之勇者，已经完成了挑战吗？",
            "nextDialogs": [
              "722690202"
            ]
          },
          "722690202": {
            "id": "722690202",
            "speakerId": 1000,
            "speakerName": "江木",
            "text": "发挥你的洞察力，找到所有的「高门之火」吧！"
          }
        }
      }
    },
    {
      "subId": "7226903",
      "subQuestName": "解放所有「高门之火」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722690301"
        ],
        "dialogs": {
          "722690301": {
            "id": "722690301",
            "speakerId": 1000,
            "speakerName": "江木",
            "text": "利落地完成了试炼。我，末代地走官·江木，于此认可你的勇武。",
            "nextDialogs": [
              "722690302"
            ]
          },
          "722690302": {
            "id": "722690302",
            "speakerId": 1000,
            "speakerName": "江木",
            "text": "你的明察，可称得上「微察冬鳗」了。",
            "nextDialogs": [
              "722690303"
            ]
          },
          "722690303": {
            "id": "722690303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这又是什么意思？",
            "nextDialogs": [
              "722690304"
            ]
          },
          "722690304": {
            "id": "722690304",
            "speakerId": 1000,
            "speakerName": "江木",
            "text": "繁殖时节的小陆鳗鳗鱼苗真的非常非常小哦。要集中注意力眯起眼睛才能看到。"
          }
        }
      }
    },
    {
      "subId": "7226904",
      "subQuestName": "解放所有「高门之火」",
      "sceneId": null,
      "locations": [],

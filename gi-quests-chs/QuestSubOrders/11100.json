    },
    {
      "subId": "1110008",
      "subQuestName": "与「掇星攫辰天君」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111000801"
        ],
        "dialogs": {
          "111000801": {
            "id": "111000801",
            "speakerId": 10202,
            "speakerName": "掇星攫辰天君",
            "text": "如何？信众们可能有些言过其实，但都是肺腑之言。",
            "nextDialogs": [
              "111000802"
            ]
          },
          "111000802": {
            "id": "111000802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉都是心理作用…",
            "nextDialogs": [
              "111000803"
            ]
          },
          "111000803": {
            "id": "111000803",
            "speakerId": 10202,
            "speakerName": "掇星攫辰天君",
            "text": "哈哈哈…阁下说笑了。有位仙家高人，薛无量，人称「量子」，他曾经说过——",
            "nextDialogs": [
              "111000804"
            ]
          },
          "111000804": {
            "id": "111000804",
            "speakerId": 10202,
            "speakerName": "掇星攫辰天君",
            "text": "「万物本是纠缠在一起，『心理作用』亦是一种『魂魄』与『事物结局』相连接的因缘…」",
            "nextDialogs": [
              "111000805"
            ]
          },
          "111000805": {
            "id": "111000805",
            "speakerId": 10202,
            "speakerName": "掇星攫辰天君",
            "text": "也就是说他们的愿望都已经走上了通往实现的正轨，这样讲明白了么？",
            "nextDialogs": [
              "111000806"
            ]
          },
          "111000806": {
            "id": "111000806",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完全听不明白…但总之他们的愿望都能实现是吧。",
            "nextDialogs": [
              "111000807"
            ]
          },
          "111000807": {
            "id": "111000807",
            "speakerId": 10202,
            "speakerName": "掇星攫辰天君",
            "text": "没错，这位小友悟性很高。",
            "nextDialogs": [
              "111000808"
            ]
          },
          "111000808": {
            "id": "111000808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来…还有一个问题…",
            "nextDialogs": [
              "111000809"
            ]
          },
          "111000809": {
            "id": "111000809",
            "speakerId": 10202,
            "speakerName": "掇星攫辰天君",
            "text": "嗯？但说无妨。",
            "nextDialogs": [
              "111000814",
              "111000812"
            ]
          },
          "111000814": {
            "id": "111000814",
            "speakerId": 10202,
            "speakerName": "掇星攫辰天君",
            "text": "本仙…游历民间，济世行善。不露真容，只为少生事端而已。",
            "nextDialogs": [
              "111000815"
            ]
          },
          "111000815": {
            "id": "111000815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来如此，原来如此。",
            "nextDialogs": [
              "111000816"
            ]
          },
          "111000816": {
            "id": "111000816",
            "speakerId": 10202,
            "speakerName": "掇星攫辰天君",
            "text": "那么二位的愿望是什么？"
          },
          "111000812": {
            "id": "111000812",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！是不是太不礼貌啦？",
            "nextDialogs": [
              "111000813"
            ]
          },
          "111000813": {
            "id": "111000813",
            "speakerId": 10202,
            "speakerName": "掇星攫辰天君",
            "text": "呵呵，确实有所不便。"
          }
        }
      }
    },
    {
      "subId": "1110023",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111002301"
        ],
        "dialogs": {
          "111002301": {
            "id": "111002301",
            "speakerId": 10202,
            "speakerName": "掇星攫辰天君",
            "text": "随意和他们聊聊吧，本仙从不自吹自擂，是非都留给他人评判。"
          }
        }
      }
    }
  ]
}
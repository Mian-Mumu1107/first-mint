    {
      "subId": "1110001",
      "subQuestName": "(test)在望舒客栈附近查看$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111000101"
        ],
        "dialogs": {
          "111000101": {
            "id": "111000101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#是我的幻觉吗，{NICKNAME}…那些丘丘人是不是看起来有些古怪？",
            "nextDialogs": [
              "111000103",
              "111000105"
            ]
          },
          "111000103": {
            "id": "111000103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀，以前见过的丘丘人，虽然是魔物，但从来没有这样的…",
            "nextDialogs": [
              "111000106"
            ]
          },
          "111000106": {
            "id": "111000106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！「望舒客栈」就在附近，会威胁到来往的客人吧？",
            "nextDialogs": [
              "111000107"
            ]
          },
          "111000107": {
            "id": "111000107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#见到了又不管的话，总觉得会良心不安…试试看对付它们吧，{NICKNAME}！"
          },
          "111000105": {
            "id": "111000105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀，难道和它们身上那种奇怪的黑气有关系？"
          }
        }
      }
    },
    {
      "subId": "1110002",
      "subQuestName": "消灭沾染「邪气」的丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1110003",
      "subQuestName": "(test)战斗后对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111000301"
        ],
        "dialogs": {
          "111000301": {
            "id": "111000301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些满身邪气的家伙，确实比一般的丘丘人要难对付一些呢。",
            "nextDialogs": [
              "111000302"
            ]
          },
          "111000302": {
            "id": "111000302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，你看那边，聚集了一些人的样子…",
            "nextDialogs": [
              "111000303"
            ]
          },
          "111000303": {
            "id": "111000303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…你看到那个戴着面具的人了吗？他那边的丘丘人都害怕得跑掉了…",
            "nextDialogs": [
              "111000306"
            ]
          },
          "111000306": {
            "id": "111000306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你是说像魈那样的仙人吗？这么说确实…魈也戴过差不多的面具。",
            "nextDialogs": [
              "111000307"
            ]
          },
          "111000307": {
            "id": "111000307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看他刚才「作法」，好像比魈更有仙人的样子呢。不如去跟他聊聊吧？"
          }
        }
      }
    },
    {
      "subId": "1110010",
      "subQuestName": "与戴着面具的男子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111001001"
        ],
        "dialogs": {
          "111001001": {
            "id": "111001001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好！我们是…",
            "nextDialogs": [
              "111001002"
            ]
          },
          "111001002": {
            "id": "111001002",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "欸。道谢的话就不必了，除魔济世是仙家本分，不足挂齿，不足挂齿…",
            "nextDialogs": [
              "111001003"
            ]
          },
          "111001003": {
            "id": "111001003",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "哦？你们好像是没见过的面孔，本仙还以为是「信众」呢。",
            "nextDialogs": [
              "111001005",
              "111001008"
            ]
          },
          "111001005": {
            "id": "111001005",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我叫派蒙！这位是我的旅伴{NICKNAME}。",
            "nextDialogs": [
              "111001006"
            ]
          },
          "111001006": {
            "id": "111001006",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "原来如此，那本仙也当介绍一下自己，才合礼数。",
            "nextDialogs": [
              "111001010"
            ]
          },
          "111001010": {
            "id": "111001010",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "咳咳…本仙乃是「掇星攫辰天君」，也即是信众们口中的「星辰天君」。",
            "nextDialogs": [
              "111001011"
            ]
          },
          "111001011": {
            "id": "111001011",
            "speakerId": 10202,
            "speakerName": "掇星攫辰天君",
            "text": "此番本仙下山济世，相逢有缘，若二位有什么心愿，无妨说与我听。",
            "nextDialogs": [
              "111001012"
            ]
          },
          "111001012": {
            "id": "111001012",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "心愿？天君你…还能帮人实现愿望的吗？我本来以为璃月的仙人都只是打架厉害…",
            "nextDialogs": [
              "111001013"
            ]
          },
          "111001013": {
            "id": "111001013",
            "speakerId": 10202,
            "speakerName": "掇星攫辰天君",
            "text": "呵呵，毕竟「天君」比「真君」在仙位上高一阶。",
            "nextDialogs": [
              "111001014"
            ]
          },
          "111001014": {
            "id": "111001014",
            "speakerId": 10202,
            "speakerName": "掇星攫辰天君",
            "text": "鼓吹自己的神通并非本仙作风，二位不如与几位信众聊聊，再做评判。"
          },
          "111001008": {
            "id": "111001008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我叫派蒙！这位是我的旅伴{NICKNAME}。",
            "nextDialogs": [
              "111001009"
            ]
          },
          "111001009": {
            "id": "111001009",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "原来是同道中人，那本仙也当介绍一下自己，才合礼数。"
          }
        }
      }
    },
    {
      "subId": "1110004",
      "subQuestName": "与「信众」们交谈，了解「掇星攫辰天君」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111000401"
        ],
        "dialogs": {
          "111000401": {
            "id": "111000401",
            "speakerId": 10217,
            "speakerName": "男性信众",
            "text": "看到「星辰天君」作法了吗？真是神通广大！",
            "nextDialogs": [
              "111000402"
            ]
          },
          "111000402": {
            "id": "111000402",
            "speakerId": 10217,
            "speakerName": "男性信众",
            "text": "家父的病想必也有指望了吧…",
            "nextDialogs": [
              "111000403"
            ]
          },
          "111000403": {
            "id": "111000403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「星辰天君」…",
            "nextDialogs": [
              "111000404"
            ]
          },
          "111000404": {
            "id": "111000404",
            "speakerId": 10217,
            "speakerName": "男性信众",
            "text": "见到那样的法术还有什么好怀疑的，当然是真真正正的仙人。",
            "nextDialogs": [
              "111000405"
            ]
          },
          "111000405": {
            "id": "111000405",
            "speakerId": 10217,
            "speakerName": "男性信众",
            "text": "我之前替卧床的老父求了个药方，跟「不卜庐」的方子天差地别。",
            "nextDialogs": [
              "111000406"
            ]
          },
          "111000406": {
            "id": "111000406",
            "speakerId": 10217,
            "speakerName": "男性信众",
            "text": "药熬出来还飘着一股淡淡的雾气，仙得很！虽然也可能是加了冰雾花的缘故…",
            "nextDialogs": [
              "111000407"
            ]
          },
          "111000407": {
            "id": "111000407",
            "speakerId": 10217,
            "speakerName": "男性信众",
            "text": "仙家药方实在了得，家父的病一定会好起来的…",
            "nextDialogs": [
              "111000408"
            ]
          },
          "111000408": {
            "id": "111000408",
            "speakerId": 10217,
            "speakerName": "男性信众",
            "text": "至于那些献给「星辰天君」作为贡品的古董，跟家父的性命比起来根本不值一提…对吧？"
          }
        }
      }
    },
    {
      "subId": "1110005",
      "subQuestName": "与「信众」们交谈，了解「掇星攫辰天君」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111000501"
        ],
        "dialogs": {
          "111000501": {
            "id": "111000501",
            "speakerId": 10219,
            "speakerName": "女性信众",
            "text": "总觉得现在每天过得充满了希望…",
            "nextDialogs": [
              "111000502"
            ]
          },
          "111000502": {
            "id": "111000502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「星辰天君」…",
            "nextDialogs": [
              "111000503"
            ]
          },
          "111000503": {
            "id": "111000503",
            "speakerId": 10219,
            "speakerName": "女性信众",
            "text": "你们也是「星辰天君」的「信众」吧？",
            "nextDialogs": [
              "111000504"
            ]
          },
          "111000504": {
            "id": "111000504",
            "speakerId": 10219,
            "speakerName": "女性信众",
            "text": "自从我的未婚夫不告而别，我每天以泪洗面…",
            "nextDialogs": [
              "111000505"
            ]
          },
          "111000505": {
            "id": "111000505",
            "speakerId": 10219,
            "speakerName": "女性信众",
            "text": "后来尝试了「星辰天君」的仙法——把他的画像烧掉，再把灰烬在日出时刻吹向大海…",
            "nextDialogs": [
              "111000506"
            ]
          },
          "111000506": {
            "id": "111000506",
            "speakerId": 10219,
            "speakerName": "女性信众",
            "text": "冥冥之中，我真的感觉到他要回来了，是真的！绝对不是什么心理作用…",
            "nextDialogs": [
              "111000507"
            ]
          },
          "111000507": {
            "id": "111000507",
            "speakerId": 10219,
            "speakerName": "女性信众",
            "text": "于是我开开心心地把嫁妆献给了「星辰天君」。毕竟若不是他帮我找回夫君，这嫁妆可能一辈子也用不到了…"
          }
        }
      }
    },
    {
      "subId": "1110006",
      "subQuestName": "与「信众」们交谈，了解「掇星攫辰天君」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111000601"
        ],
        "dialogs": {
          "111000601": {
            "id": "111000601",
            "speakerId": 10218,
            "speakerName": "商人信众",
            "text": "有「星辰天君」在，千岩军都可以下岗了吧？",
            "nextDialogs": [
              "111000602"
            ]
          },
          "111000602": {
            "id": "111000602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「星辰天君」…",
            "nextDialogs": [
              "111000603"
            ]
          },
          "111000603": {
            "id": "111000603",
            "speakerId": 10218,
            "speakerName": "商人信众",
            "text": "我是个商人，上一批货物实在太值钱了，便冒昧拜托「星辰天君」同行。",
            "nextDialogs": [
              "111000604"
            ]
          },
          "111000604": {
            "id": "111000604",
            "speakerId": 10218,
            "speakerName": "商人信众",
            "text": "只见天君祭出符咒，魔物全都退避三舍，一路上连个影儿都没见着。",
            "nextDialogs": [
              "111000605"
            ]
          },
          "111000605": {
            "id": "111000605",
            "speakerId": 10218,
            "speakerName": "商人信众",
            "text": "虽说费用方面确实贵了点…但毕竟「请仙」是件大事嘛，也不知道你们外国人能不能负担得起…"
          }
        }
      }
    },
    {
      "subId": "1110007",

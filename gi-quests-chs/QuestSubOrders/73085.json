            "id": "730850301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "现在没空。",
            "nextDialogs": [
              "730850302"
            ]
          },
          "730850302": {
            "id": "730850302",
            "speakerId": 4220,
            "speakerName": "兰陀尼什",
            "text": "那兰陀尼什等，等到那菈「有空」。"
          }
        }
      }
    },

    {
      "subId": "49011",
      "subQuestName": "追击深渊教团的敌人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "49013",
      "subQuestName": "(test)完成对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4901301"
        ],
        "dialogs": {
          "4901301": {
            "id": "4901301",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "呼…闹得这么厉害，好像已经忘记了要「好好放松」的初衷了吧…",
            "nextDialogs": [
              "4901302"
            ]
          },
          "4901302": {
            "id": "4901302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "累了的话，芭芭拉不喝点什么吗？",
            "nextDialogs": [
              "4901303"
            ]
          },
          "4901303": {
            "id": "4901303",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "欸，这里主要都是酒吧？我还不太习惯…",
            "nextDialogs": [
              "4901304"
            ]
          },
          "4901304": {
            "id": "4901304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那芭芭拉平时喜欢喝什么呢？",
            "nextDialogs": [
              "4901305"
            ]
          },
          "4901305": {
            "id": "4901305",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "我一般会自己调饮料喝的，那种，红红的…",
            "nextDialogs": [
              "4901306"
            ]
          },
          "4901306": {
            "id": "4901306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "红红的？是加了番茄还是西瓜？",
            "nextDialogs": [
              "4901307"
            ]
          },
          "4901307": {
            "id": "4901307",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "是加辣椒，辣辣的那种。",
            "nextDialogs": [
              "4901308"
            ]
          },
          "4901308": {
            "id": "4901308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "辣椒！？"
          }
        }
      }
    },
    {
      "subId": "49012",
      "subQuestName": "(test)完成对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4901201"
        ],
        "dialogs": {
          "4901201": {
            "id": "4901201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "当心啊！",
            "nextDialogs": [
              "4901202"
            ]
          },
          "4901202": {
            "id": "4901202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜…可恶的家伙，果然设下陷阱了吗？",
            "nextDialogs": [
              "4901203"
            ]
          },
          "4901203": {
            "id": "4901203",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "你的伤口怎么样？…伙伴因为我而受伤，这是我最不希望看到的事。",
            "nextDialogs": [
              "4901204"
            ]
          },
          "4901204": {
            "id": "4901204",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "…还是让我自己去吧。",
            "nextDialogs": [
              "4901205"
            ]
          },
          "4901205": {
            "id": "4901205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#没关系！况且以琴的身体状态，{NICKNAME}是不会放心丢下你一个人的。",
            "nextDialogs": [
              "4901206"
            ]
          },
          "4901206": {
            "id": "4901206",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "…嗯，好吧，但在一起前进之前，至少先让我用<color=#00E1FFFF>「蒲公英之风」</color>为大家治疗伤口。",
            "nextDialogs": [
              "4901207"
            ]
          },
          "4901207": {
            "id": "4901207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿，拜托啦！"
          }
        }
      }
    },
    {
      "subId": "49005",
      "subQuestName": "追击深渊教团的敌人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "49006",
      "subQuestName": "(test)完成对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4900601"
        ],
        "dialogs": {
          "4900601": {
            "id": "4900601",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "呼…状态没有预想的那么差，多亏了芭芭拉的照料。",
            "nextDialogs": [
              "4900602"
            ]
          },
          "4900602": {
            "id": "4900602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "平安无事就好，这下该<color=#00E1FFFF>回蒙德</color>休息了吧，代理团长大人？",
            "nextDialogs": [
              "4900603"
            ]
          },
          "4900603": {
            "id": "4900603",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "嗯，至少要去和芭芭拉再道个谢呢，希望她没在生我的气。"
          }
        }
      }
    },
    {
      "subId": "49007",
      "subQuestName": "回蒙德城与琴对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4900701"
        ],
        "dialogs": {
          "4900701": {
            "id": "4900701",
            "speakerId": 1437,
            "speakerName": "斯万",
            "text": "团长，你终于回来了，风神护佑你。",
            "nextDialogs": [
              "4900702"
            ]
          },
          "4900702": {
            "id": "4900702",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "斯万先生？你在等我吗，难道城里出了什么事？",
            "nextDialogs": [
              "4900703"
            ]
          },
          "4900703": {
            "id": "4900703",
            "speakerId": 1437,
            "speakerName": "斯万",
            "text": "嗯…<color=#00E1FFFF>「天使的馈赠」酒馆</color>那边…也不算什么大事…",
            "nextDialogs": [
              "4900704"
            ]
          },
          "4900704": {
            "id": "4900704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是醉汉打架斗殴吗？",
            "nextDialogs": [
              "4900705"
            ]
          },
          "4900705": {
            "id": "4900705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们去就好，让琴休息吧。",
            "nextDialogs": [
              "4900706"
            ]
          },
          "4900706": {
            "id": "4900706",
            "speakerId": 1437,
            "speakerName": "斯万",
            "text": "啊、啊…是大事，是大事！唉，怎么说呢…总之，还是要团长亲自去一下。",
            "nextDialogs": [
              "4900707"
            ]
          },
          "4900707": {
            "id": "4900707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…？",
            "nextDialogs": [
              "4900708"
            ]
          },
          "4900708": {
            "id": "4900708",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "既然斯万先生这么说，我就更不能让骑士同僚失望了。",
            "nextDialogs": [
              "4900709"
            ]
          },
          "4900709": {
            "id": "4900709",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "没关系，前面舒展过身体，感觉已经好了很多。",
            "nextDialogs": [
              "4900710"
            ]
          },
          "4900710": {
            "id": "4900710",
            "speakerId": 1437,
            "speakerName": "斯万",
            "text": "太好了，呼…多谢团长这么说，不然我可就为难了…",
            "nextDialogs": [
              "4900711"
            ]
          },
          "4900711": {
            "id": "4900711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜呜…完了！世道变了！居然连斯万先生这样的老实人，也把工作推给琴了！",
            "nextDialogs": [
              "4900712"
            ]
          },
          "4900712": {
            "id": "4900712",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "好了好了，听斯万先生很着急的样子，可能是紧急事态。还是先过去看看吧。"
          }
        }
      }
    },
    {
      "subId": "49008",

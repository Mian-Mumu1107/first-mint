  "subQuests": [
    {
      "subId": "49001",
      "subQuestName": "向芭芭拉询问琴的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4900101"
        ],
        "dialogs": {
          "4900101": {
            "id": "4900101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "芭芭拉小姐，我们回来了。",
            "nextDialogs": [
              "4900102"
            ]
          },
          "4900102": {
            "id": "4900102",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "欢迎回来，辛苦了。",
            "nextDialogs": [
              "4900103"
            ]
          },
          "4900103": {
            "id": "4900103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "琴好些了吗？",
            "nextDialogs": [
              "4900104"
            ]
          },
          "4900104": {
            "id": "4900104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "芭芭拉小姐也辛苦了。",
            "nextDialogs": [
              "4900105"
            ]
          },
          "4900105": {
            "id": "4900105",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "没关系，照看病患本来就是我的日常工作之一。",
            "nextDialogs": [
              "4900106"
            ]
          },
          "4900106": {
            "id": "4900106",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "琴已经恢复意识了哦，只是身体还稍微有些虚弱。",
            "nextDialogs": [
              "4900107"
            ]
          },
          "4900107": {
            "id": "4900107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗！那可真是好消息，让我们去看看她吧。",
            "nextDialogs": [
              "4900108"
            ]
          },
          "4900108": {
            "id": "4900108",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "不过她刚刚已经离开教堂了呢，明明都和她说了还要再休息一段时间…",
            "nextDialogs": [
              "4900109"
            ]
          },
          "4900109": {
            "id": "4900109",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "…可琴还是硬撑起一副没关系的样子，执意要出去走走。估计又去<color=#00E1FFFF>温妮莎大人那里</color>了吧。",
            "nextDialogs": [
              "4900110"
            ]
          },
          "4900110": {
            "id": "4900110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「温妮莎大人那里」？",
            "nextDialogs": [
              "4900111"
            ]
          },
          "4900111": {
            "id": "4900111",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "啊，我是说大英雄温妮莎的象征，<color=#00E1FFFF>风起地的那棵大树</color>…",
            "nextDialogs": [
              "4900112"
            ]
          },
          "4900112": {
            "id": "4900112",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "每当琴感觉迷茫的时候，都会去那里…",
            "nextDialogs": [
              "4900113"
            ]
          },
          "4900113": {
            "id": "4900113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "芭芭拉小姐对琴团长的事真是了解，连这样的事都能猜到？",
            "nextDialogs": [
              "4900114"
            ]
          },
          "4900114": {
            "id": "4900114",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "…只是、只是琴离开前自己说的而已啦。",
            "nextDialogs": [
              "4900115"
            ]
          },
          "4900115": {
            "id": "4900115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "琴的身体还很虚弱吧？",
            "nextDialogs": [
              "4900116"
            ]
          },
          "4900116": {
            "id": "4900116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她自己这样出城去没关系吗？",
            "nextDialogs": [
              "4900117"
            ]
          },
          "4900117": {
            "id": "4900117",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "我也很担心她。可我在这边还有工作要做…",
            "nextDialogs": [
              "4900118"
            ]
          },
          "4900118": {
            "id": "4900118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "明白啦，就由我们两个去护卫病患的安全吧！",
            "nextDialogs": [
              "4900119"
            ]
          },
          "4900119": {
            "id": "4900119",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "嗯！那样我也就能放心了，愿风神护佑你们…和琴。"
          }
        }
      }
    },
    {
      "subId": "49002",
      "subQuestName": "前往「象征温妮莎的大树」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "49003",
      "subQuestName": "(test)完成对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4900301"
        ],
        "dialogs": {
          "4900301": {
            "id": "4900301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "琴小姐，你的身体没关系吗？",
            "nextDialogs": [
              "4900302"
            ]
          },
          "4900302": {
            "id": "4900302",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "嗯，我已经没事了。真没想到你们会到这里来，谢谢你们的关心。",
            "nextDialogs": [
              "4900303"
            ]
          },
          "4900303": {
            "id": "4900303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？可是刚才看见琴的背影…感觉还是很疲惫的样子。",
            "nextDialogs": [
              "4900304"
            ]
          },
          "4900304": {
            "id": "4900304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是不是有些太过勉强自己了？",
            "nextDialogs": [
              "4900305"
            ]
          },
          "4900305": {
            "id": "4900305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以多依靠一下骑士团的大家。",
            "nextDialogs": [
              "4900306"
            ]
          },
          "4900306": {
            "id": "4900306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以多依靠一下我们。",
            "nextDialogs": [
              "4900307"
            ]
          },
          "4900307": {
            "id": "4900307",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "啊…你们的这份心意，就足够让我恢复精神了，非常感谢。",
            "nextDialogs": [
              "4900308"
            ]
          },
          "4900308": {
            "id": "4900308",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "可是如果连这点程度都无法独自应付的话，又怎么能像温妮莎大人那样守护整个蒙德呢。",
            "nextDialogs": [
              "4900309"
            ]
          },
          "4900309": {
            "id": "4900309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "琴真的很憧憬温妮莎呢。",
            "nextDialogs": [
              "4900310"
            ]
          },
          "4900310": {
            "id": "4900310",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "嗯，最初的骑士团长，温妮莎大人，是位温柔而又坚强的人，我一直在追寻着她的脚步。",
            "nextDialogs": [
              "4900311"
            ]
          },
          "4900311": {
            "id": "4900311",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "以「狮牙骑士」的勇武推翻旧贵族，又作为「蒲公英骑士」建立西风骑士团，将恩泽遍及蒙德。",
            "nextDialogs": [
              "4900312"
            ]
          },
          "4900312": {
            "id": "4900312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「蒲公英骑士」…那不是说琴的吗？",
            "nextDialogs": [
              "4900313"
            ]
          },
          "4900313": {
            "id": "4900313",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "不论「蒲公英骑士」还是「狮牙骑士」，都是历代骑士团长沿袭下来的称谓。",
            "nextDialogs": [
              "4900314"
            ]
          },
          "4900314": {
            "id": "4900314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样…",
            "nextDialogs": [
              "4900315"
            ]
          },
          "4900315": {
            "id": "4900315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么现在的琴既是听起来很温柔的「蒲公英骑士」，又是听起来很威风的「狮牙骑士」咯？",
            "nextDialogs": [
              "4900316"
            ]
          },
          "4900316": {
            "id": "4900316",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "是的，继承温妮莎大人的名号虽然十分荣幸…",
            "nextDialogs": [
              "4900317"
            ]
          },
          "4900317": {
            "id": "4900317",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "但对我来说，可能更多是意味着责任吧。",
            "nextDialogs": [
              "4900318"
            ]
          },
          "4900318": {
            "id": "4900318",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "毕竟，要有配得上它们的「坚强」才行呀。",
            "nextDialogs": [
              "4900319"
            ]
          },
          "4900319": {
            "id": "4900319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「狮牙骑士」也很适合琴呢。",
            "nextDialogs": [
              "4900320"
            ]
          },
          "4900320": {
            "id": "4900320",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是「蒲公英骑士」更适合琴一些。",
            "nextDialogs": [
              "4900321"
            ]
          },
          "4900321": {
            "id": "4900321",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说得没错！",
            "nextDialogs": [
              "4900322"
            ]
          },
          "4900322": {
            "id": "4900322",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "……",
            "nextDialogs": [
              "4900323"
            ]
          },
          "4900323": {
            "id": "4900323",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "琴？",
            "nextDialogs": [
              "4900324"
            ]
          },
          "4900324": {
            "id": "4900324",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "谁在那里！"
          }
        }
      }
    },

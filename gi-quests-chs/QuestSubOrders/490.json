    {
      "subId": "49009",
      "subQuestName": "(test)完成对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4900901"
        ],
        "dialogs": {
          "4900901": {
            "id": "4900901",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "啊，这是…？",
            "nextDialogs": [
              "4900902"
            ]
          },
          "4900902": {
            "id": "4900902",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "是大家给琴准备的「慰劳派对」哦！",
            "nextDialogs": [
              "4900903"
            ]
          },
          "4900903": {
            "id": "4900903",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "慰劳…派对？",
            "nextDialogs": [
              "4900904"
            ]
          },
          "4900904": {
            "id": "4900904",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "听说琴病倒的消息，大家很担心你呀。",
            "nextDialogs": [
              "4900905"
            ]
          },
          "4900905": {
            "id": "4900905",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "琴团长平时实在太辛苦了，独自一人承担了那么多工作。",
            "nextDialogs": [
              "4900906"
            ]
          },
          "4900906": {
            "id": "4900906",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "既然难得有一天休息时间，不如就来场派对，玩个尽兴吧。",
            "nextDialogs": [
              "4900907"
            ]
          },
          "4900907": {
            "id": "4900907",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "平日忙于工作的代理团长，可不会给我们这种机会啊，哈哈哈。",
            "nextDialogs": [
              "4900908"
            ]
          },
          "4900908": {
            "id": "4900908",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "唔…",
            "nextDialogs": [
              "4900909"
            ]
          },
          "4900909": {
            "id": "4900909",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "琴？",
            "nextDialogs": [
              "4900910"
            ]
          },
          "4900910": {
            "id": "4900910",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "大家…",
            "nextDialogs": [
              "4900911"
            ]
          },
          "4900911": {
            "id": "4900911",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "欸！琴…难道害羞了吗！我还是头一次见到呢！",
            "nextDialogs": [
              "4900912"
            ]
          },
          "4900912": {
            "id": "4900912",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "在工作以外的时候，琴毕竟也还是一位普通的少女呀。",
            "nextDialogs": [
              "4900913"
            ]
          },
          "4900913": {
            "id": "4900913",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "我、我只是很感动而已…",
            "nextDialogs": [
              "4900914"
            ]
          },
          "4900914": {
            "id": "4900914",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "…真的，谢谢大家的心意。",
            "nextDialogs": [
              "4900915"
            ]
          },
          "4900915": {
            "id": "4900915",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "欸嘿嘿，比起琴平时为大家做的，这算不了什么啦。",
            "nextDialogs": [
              "4900916"
            ]
          },
          "4900916": {
            "id": "4900916",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "可是…还有很多工作等着做…",
            "nextDialogs": [
              "4900917"
            ]
          },
          "4900917": {
            "id": "4900917",
            "speakerId": 10266,
            "speakerName": "众人",
            "text": "唉——",
            "nextDialogs": [
              "4900918"
            ]
          },
          "4900918": {
            "id": "4900918",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "放心，为了保证你可以安安心心放松自己…",
            "nextDialogs": [
              "4900919"
            ]
          },
          "4900919": {
            "id": "4900919",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "趁你不在的时候，那些委托已经被我们处理掉了，一个不漏。",
            "nextDialogs": [
              "4900920"
            ]
          },
          "4900920": {
            "id": "4900920",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "啊，真的吗？包括食材运输的事？",
            "nextDialogs": [
              "4900921"
            ]
          },
          "4900921": {
            "id": "4900921",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "和平时巡逻遇上的状况差不多啦，丘丘人而已，三下两下就搞定啦。",
            "nextDialogs": [
              "4900922"
            ]
          },
          "4900922": {
            "id": "4900922",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "也包括整理税单的事？",
            "nextDialogs": [
              "4900923"
            ]
          },
          "4900923": {
            "id": "4900923",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "每天泡在图书馆的我，对这类文书工作的处理还是很在行的。",
            "nextDialogs": [
              "4900924"
            ]
          },
          "4900924": {
            "id": "4900924",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "那…玛格丽特小姐的猫呢…",
            "nextDialogs": [
              "4900925"
            ]
          },
          "4900925": {
            "id": "4900925",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你还真惦记着找猫呀！",
            "nextDialogs": [
              "4900926"
            ]
          },
          "4900926": {
            "id": "4900926",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#「小王子」已经被{NICKNAME}缉拿了，顺便还带回了我的宝贝星铁弦。",
            "nextDialogs": [
              "4900927"
            ]
          },
          "4900927": {
            "id": "4900927",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "好啦，所以说今天就不要想工作的事了，机会难得，好好享受吧。",
            "nextDialogs": [
              "4900928"
            ]
          },
          "4900928": {
            "id": "4900928",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "嗯，能和大家一起共事是我最大的荣幸…感谢风神的指引。",
            "nextDialogs": [
              "4900929"
            ]
          },
          "4900929": {
            "id": "4900929",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "说起来…准备派对也很辛苦的吧，大家怎么有时间准备的呢…",
            "nextDialogs": [
              "4900930"
            ]
          },
          "4900930": {
            "id": "4900930",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "#哈哈，最主要的筹办人，其实是{NICKNAME}啊。",
            "nextDialogs": [
              "4900931"
            ]
          },
          "4900931": {
            "id": "4900931",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我？",
            "nextDialogs": [
              "4900932"
            ]
          },
          "4900932": {
            "id": "4900932",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "主要筹办人？",
            "nextDialogs": [
              "4900933"
            ]
          },
          "4900933": {
            "id": "4900933",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "#不论酒水还是食材，都是{NICKNAME}一手包办的哦。",
            "nextDialogs": [
              "4900934"
            ]
          },
          "4900934": {
            "id": "4900934",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "#桌上的这些美餐，更是由{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}亲自下厨。",
            "nextDialogs": [
              "4900935"
            ]
          },
          "4900935": {
            "id": "4900935",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "所以就不要摆出一副奇怪的表情，故作谦虚啦。",
            "nextDialogs": [
              "4900936"
            ]
          },
          "4900936": {
            "id": "4900936",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呃…嗯？原来如此。",
            "nextDialogs": [
              "4900937"
            ]
          },
          "4900937": {
            "id": "4900937",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那些紧急订单…是你们下的啊…",
            "nextDialogs": [
              "4900938"
            ]
          },
          "4900938": {
            "id": "4900938",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "当然，还有迪卢克老爷的功劳，不然包场的费用可就要我们大出血了。",
            "nextDialogs": [
              "4900939"
            ]
          },
          "4900939": {
            "id": "4900939",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "…虽然根本不想参与你们骑士团的活动。",
            "nextDialogs": [
              "4900940"
            ]
          },
          "4900940": {
            "id": "4900940",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "不过，作为蒙德城的一般民众，也还是需要感谢琴的辛劳…",
            "nextDialogs": [
              "4900941"
            ]
          },
          "4900941": {
            "id": "4900941",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "迪卢克前辈…",
            "nextDialogs": [
              "4900942"
            ]
          },
          "4900942": {
            "id": "4900942",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "好啦好啦，不是说要琴好好放松的吗，不要都这么围着琴讲话啦。",
            "nextDialogs": [
              "4900943"
            ]
          },
          "4900943": {
            "id": "4900943",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "是呀。那么——派对开始吧——！"
          }
        }
      }
    },
    {
      "subId": "49014",
      "subQuestName": "(test)和琴对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4901401"
        ],
        "dialogs": {
          "4901401": {
            "id": "4901401",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哟，玩得开心吗？",
            "nextDialogs": [
              "4901402"
            ]
          },
          "4901402": {
            "id": "4901402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "刚才为什么说我是筹办人？",
            "nextDialogs": [
              "4901403"
            ]
          },
          "4901403": {
            "id": "4901403",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "你说这个啊，毕竟我们已经和琴那么熟了…",
            "nextDialogs": [
              "4901404"
            ]
          },
          "4901404": {
            "id": "4901404",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "这种事，越是彼此熟悉的人，背地里准备惊喜派对什么的，越会觉得害羞吧？",
            "nextDialogs": [
              "4901405"
            ]
          },
          "4901405": {
            "id": "4901405",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "所以就把功劳全推给你了，毕竟你也很辛苦嘛。",
            "nextDialogs": [
              "4901406"
            ]
          },
          "4901406": {
            "id": "4901406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是凯亚会觉得害羞吧？",
            "nextDialogs": [
              "4901407"
            ]
          },
          "4901407": {
            "id": "4901407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀！这个派对一看就知道是凯亚的主意了，是你自己会觉得害羞吧？",
            "nextDialogs": [
              "4901408"
            ]
          },
          "4901408": {
            "id": "4901408",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哈哈哈…原来你们会这样想，好吧好吧。",
            "nextDialogs": [
              "4901409"
            ]
          },
          "4901409": {
            "id": "4901409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么你是承认咯！",
            "nextDialogs": [
              "4901410"
            ]
          },
          "4901410": {
            "id": "4901410",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "呵呵，难得今天这么好的日子，就让你们寻一次开心吧。"
          }
        }
      }
    },
    {
      "subId": "49010",
      "subQuestName": "去二楼露台寻找琴",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4901001"
        ],
        "dialogs": {
          "4901001": {
            "id": "4901001",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "啊，是你们。",
            "nextDialogs": [
              "4901004"
            ]
          },
          "4901004": {
            "id": "4901004",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "嗯，我只是…出来透透气。",
            "nextDialogs": [
              "4901005"
            ]
          },
          "4901005": {
            "id": "4901005",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "琴好像有什么心事？",
            "nextDialogs": [
              "4901006"
            ]
          },
          "4901006": {
            "id": "4901006",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "#{NICKNAME}，容我再次感谢…",
            "nextDialogs": [
              "4901007"
            ]
          },
          "4901007": {
            "id": "4901007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实我也一直被蒙在鼓里。",
            "nextDialogs": [
              "4901008"
            ]
          },
          "4901008": {
            "id": "4901008",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "但是，能这样和大家在一起，不知不觉就打起了精神呢。",
            "nextDialogs": [
              "4901011"
            ]
          },
          "4901011": {
            "id": "4901011",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "而且，我也认识到了一件事。",
            "nextDialogs": [
              "4901012"
            ]
          },
          "4901012": {
            "id": "4901012",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么事？",
            "nextDialogs": [
              "4901013"
            ]
          },
          "4901013": {
            "id": "4901013",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "比起「狮牙骑士」，果然还是「蒲公英骑士」更适合我。",
            "nextDialogs": [
              "4901014"
            ]
          },
          "4901014": {
            "id": "4901014",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "「狮牙骑士」，代表温妮莎为蒙德而斗争的过去…",
            "nextDialogs": [
              "4901015"
            ]
          },
          "4901015": {
            "id": "4901015",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "而建立西风骑士团之后的「蒲公英骑士」，代表她所期望的，骑士团的未来…",
            "nextDialogs": [
              "4901016"
            ]
          },
          "4901016": {
            "id": "4901016",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "温妮莎也一定会为现在的琴加油的！",
            "nextDialogs": [
              "4901017"
            ]
          },
          "4901017": {
            "id": "4901017",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "嗯，不论在高天之上，还是身旁的柔风里，温妮莎大人一定都还在注视着我们的。",
            "nextDialogs": [
              "4901018"
            ]
          },
          "4901018": {
            "id": "4901018",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听凭风引。",
            "nextDialogs": [
              "4901019"
            ]
          },
          "4901019": {
            "id": "4901019",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "#听凭风引。自由之风会指引前进的路，今后也请与我们同行吧，{NICKNAME}。"
          }
        }
      }
    },
    {
      "subId": "49000",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4900007"
        ],
        "dialogs": {
          "4900007": {
            "id": "4900007",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "琴其实没有看上去那么坚强…能有你们去陪陪她就太好了。"
          }
        }
      }
    },
    {
      "subId": "49015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4901501"
        ],
        "dialogs": {
          "4901501": {
            "id": "4901501",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "呼哈…晨曦酒庄的酒果然和传闻里的一样，值得夸奖。",
            "nextDialogs": [
              "4901502"
            ]
          },
          "4901502": {
            "id": "4901502",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这酒平日里我可一杯都买不起呀，赶紧趁这次机会…再来一杯，嗯，再来一杯。",
            "nextDialogs": [
              "4901503"
            ]
          },
          "4901503": {
            "id": "4901503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "温迪的酒量…真是太吓人了。",
            "nextDialogs": [
              "4901504"
            ]
          },
          "4901504": {
            "id": "4901504",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "欸，是你们呀，我刚才都没注意。",
            "nextDialogs": [
              "4901505"
            ]
          },
          "4901505": {
            "id": "4901505",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "都怪这酒太让人陶醉了，像我的诗歌一样，值得流传千年。",
            "nextDialogs": [
              "4901506"
            ]
          },
          "4901506": {
            "id": "4901506",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这种飘飘然的感觉…难道就是风之元素的真谛？",
            "nextDialogs": [
              "4901507"
            ]
          },
          "4901507": {
            "id": "4901507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "已经开始说胡话了…",
            "nextDialogs": [
              "4901508"
            ]
          },
          "4901508": {
            "id": "4901508",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯嗯…应该让每一个风的子民都好好尝尝这酒，为了美酒，干杯！"
          }
        }
      }
    },
    {
      "subId": "49016",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4901601"
        ],
        "dialogs": {
          "4901601": {
            "id": "4901601",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "第三十七杯了。",
            "nextDialogs": [
              "4901602"
            ]
          },
          "4901602": {
            "id": "4901602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "迪卢克老爷在做什么？",
            "nextDialogs": [
              "4901603"
            ]
          },
          "4901603": {
            "id": "4901603",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "我在数这个吟游诗人到底喝了多少杯。",
            "nextDialogs": [
              "4901604"
            ]
          },
          "4901604": {
            "id": "4901604",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "他应该还不知道，今晚酒水只对骑士团的人免费。",
            "nextDialogs": [
              "4901605"
            ]
          },
          "4901605": {
            "id": "4901605",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "等他清醒了，我会把账单给他的。",
            "nextDialogs": [
              "4901606"
            ]
          },
          "4901606": {
            "id": "4901606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "迪卢克老爷…太残酷了！",
            "nextDialogs": [
              "4901607"
            ]
          },
          "4901607": {
            "id": "4901607",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "…开玩笑的，反正那账单他也不可能还得起，还是算了。",
            "nextDialogs": [
              "4901608"
            ]
          },
          "4901608": {
            "id": "4901608",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "我只是觉得，这果然不是一个凡人会有的酒量…"
          }
        }
      }
    },
    {
      "subId": "49017",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4901701"
        ],
        "dialogs": {
          "4901701": {
            "id": "4901701",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "「将喧闹的宴会抛在身后，享受二人独处的静谧时光，世界仿佛仅剩两人」…",
            "nextDialogs": [
              "4901702"
            ]
          },
          "4901702": {
            "id": "4901702",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "是书本里常出现的浪漫桥段吧？",
            "nextDialogs": [
              "4901703"
            ]
          },
          "4901703": {
            "id": "4901703",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "我并不是在邀请你去陪我说什么悄悄话哦。",
            "nextDialogs": [
              "4901704"
            ]
          },
          "4901704": {
            "id": "4901704",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "我是说，刚才<color=#00E1FFFF>琴她单独去了楼上的阳台</color>…你会抓住机会的吧？呵呵…"
          }
        }
      }
    },
    {
      "subId": "49018",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4901801"
        ],
        "dialogs": {
          "4901801": {
            "id": "4901801",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "#{NICKNAME}…",
            "nextDialogs": [
              "4901802"
            ]
          },
          "4901802": {
            "id": "4901802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "安柏！你怎么一副要哭出来的样子！",
            "nextDialogs": [
              "4901803"
            ]
          },
          "4901803": {
            "id": "4901803",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "这个——甜甜花酿鸡！还有！蜜酱胡萝卜煎肉！",
            "nextDialogs": [
              "4901804"
            ]
          },
          "4901804": {
            "id": "4901804",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "都是你做的吗？",
            "nextDialogs": [
              "4901805"
            ]
          },
          "4901805": {
            "id": "4901805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是没错啦…",
            "nextDialogs": [
              "4901806"
            ]
          },
          "4901806": {
            "id": "4901806",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "呜哇哇哇…我好不服气呀，为什么你可以做出这么棒的料理…",
            "nextDialogs": [
              "4901807"
            ]
          },
          "4901807": {
            "id": "4901807",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "等我再吃完这一份！一定要你把全部手艺都教给我，可别想着逃走！",
            "nextDialogs": [
              "4901808"
            ]
          },
          "4901808": {
            "id": "4901808",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "嘎吱…嘎吱…",
            "nextDialogs": [
              "4901809"
            ]
          },
          "4901809": {
            "id": "4901809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "安柏…她刚才好像没有喝酒呀…"
          }
        }
      }
    }
  ]

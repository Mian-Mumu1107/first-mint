        "dialogs": {
          "737050101": {
            "id": "737050101",
            "speakerId": 1000,
            "speakerName": "柯莱",
            "text": "#{NICKNAME}和派蒙！这边这边！",
            "nextDialogs": [
              "737050102"
            ]
          },
          "737050102": {
            "id": "737050102",
            "speakerId": 1000,
            "speakerName": "柯莱",
            "text": "欢迎来到「稳健知行」机构的主场！",
            "nextDialogs": [
              "737050103"
            ]
          },
          "737050103": {
            "id": "737050103",
            "speakerId": 1000,
            "speakerName": "柯莱",
            "text": "请看，几个核心项目的设施已经搭建好了，大家随时都可以投入工作——",
            "nextDialogs": [
              "737050104"
            ]
          },
          "737050104": {
            "id": "737050104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喔！这种氛围，好像轻小说里提过的…「年轻冒险家们的第一个据点」？",
            "nextDialogs": [
              "737050105"
            ]
          },
          "737050105": {
            "id": "737050105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…又有点学园庆典的感觉，大家聚在一起，仔细研究课题后，组队出发历练自己…让人跃跃欲试！",
            "nextDialogs": [
              "737050108"
            ]
          },
          "737050108": {
            "id": "737050108",
            "speakerId": 1000,
            "speakerName": "柯莱",
            "text": "虽然这个场地不像学园庆典那样豪华，但按提纳里师父的说法，教令院会给我们调配「最有效能」的资源。",
            "nextDialogs": [
              "737050109"
            ]
          },
          "737050109": {
            "id": "737050109",
            "speakerId": 1000,
            "speakerName": "柯莱",
            "text": "学生和学者们前往危险地带之前，会来我们这里仔细咨询，甚至接受一番紧急训练…",
            "nextDialogs": [
              "737050110"
            ]
          },
          "737050110": {
            "id": "737050110",
            "speakerId": 1000,
            "speakerName": "柯莱",
            "text": "如果有必要的话，我们会派遣专人加入他们的队伍，充当可靠的向导和安全员。",
            "nextDialogs": [
              "737050111"
            ]
          },
          "737050111": {
            "id": "737050111",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "按照时下流行的叫法，这里是一半训练，一半实战的「前进基地」哦。",
            "nextDialogs": [
              "737050112"
            ]
          },
          "737050112": {
            "id": "737050112",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "让新兵们意识到自己即将面对的挑战，好好锻炼一下拳脚，再踏入未知的领域，才不会手忙脚乱！",
            "nextDialogs": [
              "737050113"
            ]
          },
          "737050113": {
            "id": "737050113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "安柏？居然是你！"
          }
        }
      }
    }
  ]

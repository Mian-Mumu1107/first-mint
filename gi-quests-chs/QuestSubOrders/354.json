      "subId": "35402",
      "subQuestName": "与轻盈的少女对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3540401"
        ],
        "dialogs": {
          "3540401": {
            "id": "3540401",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "愿风神护佑你，陌生人！",
            "nextDialogs": [
              "3540402"
            ]
          },
          "3540402": {
            "id": "3540402",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "我是西风骑士团侦察骑士，安柏。",
            "nextDialogs": [
              "3540403"
            ]
          },
          "3540403": {
            "id": "3540403",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "你不是蒙德市民吧？那么，请说明自己的身份！",
            "nextDialogs": [
              "3540404"
            ]
          },
          "3540404": {
            "id": "3540404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "冷静一下，我们不是可疑人员——",
            "nextDialogs": [
              "3540405"
            ]
          },
          "3540405": {
            "id": "3540405",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "可疑人员都会这么说。",
            "nextDialogs": [
              "3540406"
            ]
          },
          "3540406": {
            "id": "3540406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#你好，我是{NICKNAME}。",
            "nextDialogs": [
              "3540407"
            ]
          },
          "3540407": {
            "id": "3540407",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "…听着不像是本地人的名字。",
            "nextDialogs": [
              "3540408"
            ]
          },
          "3540408": {
            "id": "3540408",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "还有这只…吉祥物，又是怎么回事？",
            "nextDialogs": [
              "3540410",
              "3540413"
            ]
          },
          "3540410": {
            "id": "3540410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，虽然是认识才两个月的旅伴…",
            "nextDialogs": [
              "3540411"
            ]
          },
          "3540411": {
            "id": "3540411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但已经是最好的朋友了！",
            "nextDialogs": [
              "3540414"
            ]
          },
          "3540414": {
            "id": "3540414",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "总而言之，是旅行者对吧。",
            "nextDialogs": [
              "3540415"
            ]
          },
          "3540415": {
            "id": "3540415",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "最近蒙德周围有巨龙出没，你们还是尽快进城比较好。",
            "nextDialogs": [
              "3540416"
            ]
          },
          "3540416": {
            "id": "3540416",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "这里离蒙德不远，就由身为骑士的我来护送你们一程。",
            "nextDialogs": [
              "3540417"
            ]
          },
          "3540417": {
            "id": "3540417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你出城没有什么别的任务吗？",
            "nextDialogs": [
              "3540418"
            ]
          },
          "3540418": {
            "id": "3540418",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "当然有，不过放心，任务路上也会保证你们的安全。",
            "nextDialogs": [
              "3540419"
            ]
          },
          "3540419": {
            "id": "3540419",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "而且…我也不能放着可疑人士不管！"
          },
          "3540413": {
            "id": "3540413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完全不对！怎么还不如吉祥物啊！"
          }
        }
      }

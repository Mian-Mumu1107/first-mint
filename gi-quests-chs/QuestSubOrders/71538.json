        "dialogs": {
          "715380101": {
            "id": "715380101",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "#{NICKNAME}，你好。海灯节快乐。",
            "nextDialogs": [
              "715380104"
            ]
          },
          "715380104": {
            "id": "715380104",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "我正在被强制休假。",
            "nextDialogs": [
              "715380105"
            ]
          },
          "715380105": {
            "id": "715380105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "强制…休假？",
            "nextDialogs": [
              "715380106"
            ]
          },
          "715380106": {
            "id": "715380106",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "按照执律庭的规定，到每年年底，每一个人的公假都必须休完。",
            "nextDialogs": [
              "715380107"
            ]
          },
          "715380107": {
            "id": "715380107",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "但是，今年的年终核算结束之后，队里发现我没有休过一天公假。所以…"
          }
        }
      }
    },

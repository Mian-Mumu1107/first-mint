  "subQuests": [
    {
      "subId": "2005001",
      "subQuestName": "前往询问艾琳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200500101"
        ],
        "dialogs": {
          "200500101": {
            "id": "200500101",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "伤脑筋…这里要怎么解决啊…",
            "nextDialogs": [
              "200500102"
            ]
          },
          "200500102": {
            "id": "200500102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么呢？",
            "nextDialogs": [
              "200500103"
            ]
          },
          "200500103": {
            "id": "200500103",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "为了下一次的骑士选拔，我正在训练呢。",
            "nextDialogs": [
              "200500104"
            ]
          },
          "200500104": {
            "id": "200500104",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "唔…不过，我可没有琴大人那样的力量。",
            "nextDialogs": [
              "200500105"
            ]
          },
          "200500105": {
            "id": "200500105",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "比起锻炼「力量」，我觉得学习「技巧」更适合我。",
            "nextDialogs": [
              "200500106"
            ]
          },
          "200500106": {
            "id": "200500106",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "比如，一口气把这些木桩全部破坏掉的方法…",
            "nextDialogs": [
              "200500107"
            ]
          },
          "200500107": {
            "id": "200500107",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "你有空的话，也和我一起来想一想吧。",
            "nextDialogs": [
              "200500110",
              "200500112"
            ]
          },
          "200500110": {
            "id": "200500110",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "没关系，好好想喔，木桩不会自己跑掉。",
            "nextDialogs": [
              "200500111"
            ]
          },
          "200500111": {
            "id": "200500111",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "唯一会自己跑掉的只有被消耗的时间和生命，唔…",
            "nextDialogs": [
              "200500114"
            ]
          },
          "200500114": {
            "id": "200500114",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "我听别人说，元素是能互相作用的，如果能让这个火盆里的火稍稍爆炸一下的话…",
            "nextDialogs": [
              "200500115"
            ]
          },
          "200500115": {
            "id": "200500115",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "不过，这个火盆里，首先得有火才行啊…"
          },
          "200500112": {
            "id": "200500112",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "你习惯团体作战吗？真羡慕啊…随时都能叫到帮手的人。",
            "nextDialogs": [
              "200500113"
            ]
          },
          "200500113": {
            "id": "200500113",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "像我这样的，只能学习独自作战啦。"
          }
        }
      }
    },
    {
      "subId": "2005002",
      "subQuestName": "在2秒内摧毁所有木桩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200500201"
        ],
        "dialogs": {
          "200500201": {
            "id": "200500201",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "怎么样？想到好方法了吗？",
            "nextDialogs": [
              "200500202"
            ]
          },
          "200500202": {
            "id": "200500202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有想好…",
            "nextDialogs": [
              "200500203"
            ]
          },
          "200500203": {
            "id": "200500203",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "嗯…我之前遇见的冒险家，有些也偶尔会这样呢。",
            "nextDialogs": [
              "200500204"
            ]
          },
          "200500204": {
            "id": "200500204",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "面对怪物时能利落地战斗，打木桩的时候却手忙脚乱。",
            "nextDialogs": [
              "200500205"
            ]
          },
          "200500205": {
            "id": "200500205",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "而且还用各种手段加固木桩，就像生怕自己能轻松击碎一样…",
            "nextDialogs": [
              "200500206"
            ]
          },
          "200500206": {
            "id": "200500206",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "这么想寻求挑战的话，直接去野外找强大的魔物不就好了吗？"
          }
        }
      }
    },
    {
      "subId": "2005003",
      "subQuestName": "返回对话艾琳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200500301"
        ],
        "dialogs": {
          "200500301": {
            "id": "200500301",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "做到了！",
            "nextDialogs": [
              "200500302"
            ]
          },
          "200500302": {
            "id": "200500302",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "原来还能这么解决…这种方法我想都没想过。",
            "nextDialogs": [
              "200500303"
            ]
          },
          "200500303": {
            "id": "200500303",
            "speakerId": 1000,
            "speakerName": "艾琳",
            "text": "谢谢你，我自己去再试试看！"
          }
        }
      }
    }
  ]
}
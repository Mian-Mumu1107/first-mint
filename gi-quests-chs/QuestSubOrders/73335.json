    {
      "subId": "7333508",
      "subQuestName": "(test)看到花reminder-完成终章$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733350801"
        ],
        "dialogs": {
          "733350801": {
            "id": "733350801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，斯露莎还挺厉害的嘛，一下子就让周围焕发了生机！",
            "nextDialogs": [
              "733350802"
            ]
          },
          "733350802": {
            "id": "733350802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "花灵的力量真奇妙。",
            "nextDialogs": [
              "733350803"
            ]
          },
          "733350803": {
            "id": "733350803",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "那是当然，许多花灵都牢记着让「净觉花」焕发生机的方法。",
            "nextDialogs": [
              "733350804"
            ]
          },
          "733350804": {
            "id": "733350804",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "只不过，即使「焚真之天象」已消弥，这片「净觉花」受到的侵蚀也还没恢复，格外虚弱…",
            "nextDialogs": [
              "733350805"
            ]
          },
          "733350805": {
            "id": "733350805",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "其他花池想来也没法幸免于难，瑟法娜肯定很苦恼吧。",
            "nextDialogs": [
              "733350806"
            ]
          },
          "733350806": {
            "id": "733350806",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来，你说的瑟法娜，肯定是个勤勤恳恳照顾花儿们的好花灵！",
            "nextDialogs": [
              "733350807"
            ]
          },
          "733350807": {
            "id": "733350807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我们就帮帮那位花灵吧，{NICKNAME}？",
            "nextDialogs": [
              "733350808"
            ]
          },
          "733350808": {
            "id": "733350808",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "于我而言，这并不是什么难事，还能帮到瑟法娜。我的「谒颂主」，请你多多留意这样的「净觉花」吧。",
            "nextDialogs": [
              "733350809"
            ]
          },
          "733350809": {
            "id": "733350809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "下次看到了就通知你。",
            "nextDialogs": [
              "733350810"
            ]
          },
          "733350810": {
            "id": "733350810",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们一起拯救这些漂亮的花！"
          }
        }
      }
    },

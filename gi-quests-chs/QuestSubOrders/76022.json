  "subQuests": [
    {
      "subId": "7602201",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760220101"
        ],
        "dialogs": {
          "760220101": {
            "id": "760220101",
            "speakerId": 1000,
            "speakerName": "愤怒的武士",
            "text": "无用的挣扎只会流血…把你的摩拉留下！",
            "nextDialogs": [
              "760220102"
            ]
          },
          "760220102": {
            "id": "760220102",
            "speakerId": 1001,
            "speakerName": "佩科",
            "text": "救命！救命啊！",
            "nextDialogs": [
              "760220103"
            ]
          },
          "760220103": {
            "id": "760220103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇…我们得去救救他！"
          }
        }
      }
    },
    {
      "subId": "7602204",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760220201"
        ],
        "dialogs": {
          "760220201": {
            "id": "760220201",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喂！大块头！你在做什么！快停下！",
            "nextDialogs": [
              "760220202"
            ]
          },
          "760220202": {
            "id": "760220202",
            "speakerId": 1000,
            "speakerName": "愤怒的武士",
            "text": "摩拉…不对，不对！害死阿紫的家伙…受死吧！",
            "nextDialogs": [
              "760220203"
            ]
          },
          "760220203": {
            "id": "760220203",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#哇啊啊！{NICKNAME}，小心！"
          }
        }
      }
    },
    {
      "subId": "7602202",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],

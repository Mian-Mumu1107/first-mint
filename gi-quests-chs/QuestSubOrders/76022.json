    {
      "subId": "7602203",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760220301"
        ],
        "dialogs": {
          "760220301": {
            "id": "760220301",
            "speakerId": 1001,
            "speakerName": "佩科",
            "text": "哎呀呀，感谢两位的救命之恩，我是游商佩科，之后两位若有机会关照我的生意，一定给两位最实惠的折扣！",
            "nextDialogs": [
              "760220302"
            ]
          },
          "760220302": {
            "id": "760220302",
            "speakerId": 1001,
            "speakerName": "佩科",
            "text": "说起来今天真是倒霉，竟让我碰见这传说中的人物。",
            "nextDialogs": [
              "760220303"
            ]
          },
          "760220303": {
            "id": "760220303",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "传说中的人物？那家伙很有名吗？",
            "nextDialogs": [
              "760220304"
            ]
          },
          "760220304": {
            "id": "760220304",
            "speakerId": 1001,
            "speakerName": "佩科",
            "text": "恶名的话是有的。我也是听别的同行说的…当时他们也被吓得不行，说是再也不走这条路线了，我也是不信邪…",
            "nextDialogs": [
              "760220305"
            ]
          },
          "760220305": {
            "id": "760220305",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那你还真是胆大。",
            "nextDialogs": [
              "760220306"
            ]
          },
          "760220306": {
            "id": "760220306",
            "speakerId": 1001,
            "speakerName": "佩科",
            "text": "我们做游商的，什么没碰见过？而且，我们有时候坐在一起，讲讲自己的故事的时候，也总容易「夸大事实」…",
            "nextDialogs": [
              "760220307"
            ]
          },
          "760220307": {
            "id": "760220307",
            "speakerId": 1001,
            "speakerName": "佩科",
            "text": "说偏了…他叫「权八」，听说是在稻妻犯了什么事，逃亡来了偏乡，对了，还带着他的相好。",
            "nextDialogs": [
              "760220308"
            ]
          },
          "760220308": {
            "id": "760220308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以刚刚他提到的「阿紫」就是…？",
            "nextDialogs": [
              "760220309"
            ]
          },
          "760220309": {
            "id": "760220309",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#对哦！刚刚那个怪人和{NICKNAME}打架的时候就念叨着这个名字呢，奇奇怪怪的。",
            "nextDialogs": [
              "760220310"
            ]
          },
          "760220310": {
            "id": "760220310",
            "speakerId": 1001,
            "speakerName": "佩科",
            "text": "从前就不走正路的人，哪怕到了新的地方，想要金盆洗手也没那么容易吧。没个正经营生，最后只有重蹈覆辙。",
            "nextDialogs": [
              "760220311"
            ]
          },
          "760220311": {
            "id": "760220311",
            "speakerId": 1001,
            "speakerName": "佩科",
            "text": "如果他就自己一个人的话，这么个活法倒也无所谓，但刀口舔血，谁知道会得罪什么人。",
            "nextDialogs": [
              "760220312"
            ]
          },
          "760220312": {
            "id": "760220312",
            "speakerId": 1001,
            "speakerName": "佩科",
            "text": "听说他那相好也是因此才丧命…反正，自从那之后，他就疯疯癫癫的啦！",
            "nextDialogs": [
              "760220313"
            ]
          },
          "760220313": {
            "id": "760220313",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唉…大块头抢劫摩拉是可恶，但一想到他变成现在的样子，又觉得有那么一点点可怜啦…",
            "nextDialogs": [
              "760220315",
              "760220317"
            ]
          },
          "760220315": {
            "id": "760220315",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喂！重点根本不是这个啦！",
            "nextDialogs": [
              "760220318"
            ]
          },
          "760220318": {
            "id": "760220318",
            "speakerId": 1001,
            "speakerName": "佩科",
            "text": "好啦，我就不继续耽误两位的时间了，这份谢礼先请两位收下吧。"
          },
          "760220317": {
            "id": "760220317",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#哼哼，那我身边不是还有你嘛！我的摩拉，{NICKNAME}守护！"
          }
        }
      }
    },
    {

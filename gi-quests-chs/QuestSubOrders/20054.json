    {
      "subId": "2005412",
      "subQuestName": "将战利品和信交给特纳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005407101"
        ],
        "dialogs": {
          "2005407101": {
            "id": "2005407101",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "你好，客人，欢迎来到晨曦酒庄…",
            "nextDialogs": [
              "2005407102"
            ]
          },
          "2005407102": {
            "id": "2005407102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是盖伊的信。",
            "nextDialogs": [
              "2005407103"
            ]
          },
          "2005407103": {
            "id": "2005407103",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "他写信给我了吗？谢谢，还麻烦你给我带来…",
            "nextDialogs": [
              "2005407104"
            ]
          },
          "2005407104": {
            "id": "2005407104",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "和骑士团的骑士们一起在野外清除丘丘人？",
            "nextDialogs": [
              "2005407105"
            ]
          },
          "2005407105": {
            "id": "2005407105",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "他才刚进去没多久，就已经开始在外出任务了吗？",
            "nextDialogs": [
              "2005407106"
            ]
          },
          "2005407106": {
            "id": "2005407106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是他的战利品。",
            "nextDialogs": [
              "2005407107"
            ]
          },
          "2005407107": {
            "id": "2005407107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "盖伊先生很厉害哦，一口气把那些丘丘人都消灭掉了！",
            "nextDialogs": [
              "2005407108"
            ]
          },
          "2005407108": {
            "id": "2005407108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们都是在旁边亲眼看到的！",
            "nextDialogs": [
              "2005407109"
            ]
          },
          "2005407109": {
            "id": "2005407109",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "哦…哦，是这样吗…还真是丘丘人的战利品…",
            "nextDialogs": [
              "2005407110"
            ]
          },
          "2005407110": {
            "id": "2005407110",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "哼，这些普普通通的东西嘛，老头子我年轻时也能轻易拿到…",
            "nextDialogs": [
              "2005407111"
            ]
          },
          "2005407111": {
            "id": "2005407111",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "不过，那小子也算是在努力吧！",
            "nextDialogs": [
              "2005407112"
            ]
          },
          "2005407112": {
            "id": "2005407112",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "客人，实在是麻烦您了，您要不在这休息一下？",
            "nextDialogs": [
              "2005407115",
              "2005407116"
            ]
          },
          "2005407115": {
            "id": "2005407115",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "好，您急着回去对吧，就不耽误您了。",
            "nextDialogs": [
              "2005407117"
            ]
          },
          "2005407117": {
            "id": "2005407117",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "这些您拿着，留着路上用。还有那些战利品，老头子我也用不上，您也留着吧。",
            "nextDialogs": [
              "2005407118"
            ]
          },
          "2005407118": {
            "id": "2005407118",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "西风骑士…加油啊，臭小子。"
          },
          "2005407116": {
            "id": "2005407116",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "不用了，哼…他还要继续努力才行。"
          }
        }
      }
    },
    {
      "subId": "2005413",
      "subQuestName": "将战利品和信交给特纳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005408101"
        ],
        "dialogs": {
          "2005408101": {
            "id": "2005408101",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "你好，客人，欢迎来到晨曦酒庄…",
            "nextDialogs": [
              "2005408102"
            ]
          },
          "2005408102": {
            "id": "2005408102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是盖伊的信。",
            "nextDialogs": [
              "2005408103"
            ]
          },
          "2005408103": {
            "id": "2005408103",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "他写信给我了吗？谢谢，还麻烦你给我带来…",
            "nextDialogs": [
              "2005408104"
            ]
          },
          "2005408104": {
            "id": "2005408104",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "和骑士团的骑士们一起在野外经历了很多战斗…",
            "nextDialogs": [
              "2005408105"
            ]
          },
          "2005408105": {
            "id": "2005408105",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "唔…他才进去多久，怎么会有这种实力？",
            "nextDialogs": [
              "2005408106"
            ]
          },
          "2005408106": {
            "id": "2005408106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是他的战利品。",
            "nextDialogs": [
              "2005408107"
            ]
          },
          "2005408107": {
            "id": "2005408107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "盖伊先生的实力很强喔！虽然被很多丘丘人围着，但也很冷静地把它们一一消灭掉了！",
            "nextDialogs": [
              "2005408108"
            ]
          },
          "2005408108": {
            "id": "2005408108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们都是在旁边亲眼看到的！",
            "nextDialogs": [
              "2005408109"
            ]
          },
          "2005408109": {
            "id": "2005408109",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "哦…哦，他确实一直很努力…还真是丘丘人的战利品…",
            "nextDialogs": [
              "2005408110"
            ]
          },
          "2005408110": {
            "id": "2005408110",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "这些东西…看样子不是轻易能拿到的。",
            "nextDialogs": [
              "2005408111"
            ]
          },
          "2005408111": {
            "id": "2005408111",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "这小子也知道要努力奋斗了啊，总算是长大了…",
            "nextDialogs": [
              "2005408112"
            ]
          },
          "2005408112": {
            "id": "2005408112",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "客人，实在是麻烦您了。不然您在这等等，我去给您拿点喝的？",
            "nextDialogs": [
              "2005408115",
              "2005408116"
            ]
          },
          "2005408115": {
            "id": "2005408115",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "好吧…您还要回去吧，可不能误了事…",
            "nextDialogs": [
              "2005408117"
            ]
          },
          "2005408117": {
            "id": "2005408117",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "这些您拿着，留着路上用。还有那些战利品，老头子我也用不上，您也留着吧。",
            "nextDialogs": [
              "2005408118"
            ]
          },
          "2005408118": {
            "id": "2005408118",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "这样努力下去，他一定会有个好前程的…"
          },
          "2005408116": {
            "id": "2005408116",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "我…算了，那臭小子一定很忙吧。"
          }
        }
      }
    },
    {
      "subId": "2005414",
      "subQuestName": "将战利品和信交给特纳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005409101"
        ],
        "dialogs": {
          "2005409101": {
            "id": "2005409101",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "你好，客人，欢迎来到晨曦酒庄…",
            "nextDialogs": [
              "2005409102"
            ]
          },
          "2005409102": {
            "id": "2005409102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是盖伊的信。",
            "nextDialogs": [
              "2005409103"
            ]
          },
          "2005409103": {
            "id": "2005409103",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "他写信给我了吗？谢谢，还麻烦你给我带来…",
            "nextDialogs": [
              "2005409104"
            ]
          },
          "2005409104": {
            "id": "2005409104",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "消灭了许多史莱姆…希望晨曦酒庄不会再被史莱姆骚扰…",
            "nextDialogs": [
              "2005409105"
            ]
          },
          "2005409105": {
            "id": "2005409105",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "这小子，我就是随口一说，他居然还记在心上…",
            "nextDialogs": [
              "2005409106"
            ]
          },
          "2005409106": {
            "id": "2005409106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是他的战利品。",
            "nextDialogs": [
              "2005409107"
            ]
          },
          "2005409107": {
            "id": "2005409107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "盖伊先生很轻松就消灭了很多史莱姆喔！",
            "nextDialogs": [
              "2005409108"
            ]
          },
          "2005409108": {
            "id": "2005409108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "两下子就把它们全部都打倒了，唔…是很利落的战斗喔。",
            "nextDialogs": [
              "2005409109"
            ]
          },
          "2005409109": {
            "id": "2005409109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "战斗完了还和我们说，「这样子老爹就能轻松点了」。",
            "nextDialogs": [
              "2005409110"
            ]
          },
          "2005409110": {
            "id": "2005409110",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "哼，居然还开始担心我了，他的工作看来还挺轻松的嘛！",
            "nextDialogs": [
              "2005409111"
            ]
          },
          "2005409111": {
            "id": "2005409111",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "不过，他总算是长大了，有点骑士样了。",
            "nextDialogs": [
              "2005409112"
            ]
          },
          "2005409112": {
            "id": "2005409112",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "客人，实在是麻烦您了…您要在这休息一下吗？",
            "nextDialogs": [
              "2005409115",
              "2005409116"
            ]
          },
          "2005409115": {
            "id": "2005409115",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "您还急着回去吗？那确实不能耽误…",
            "nextDialogs": [
              "2005409117"
            ]
          },
          "2005409117": {
            "id": "2005409117",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "这些您拿着，留着路上用。还有那些战利品，老头子我也用不上，您也留着吧。",
            "nextDialogs": [
              "2005409118"
            ]
          },
          "2005409118": {
            "id": "2005409118",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "替我告诉他，让他继续努力！有时间也可以回家…",
            "nextDialogs": [
              "2005409119"
            ]
          },
          "2005409119": {
            "id": "2005409119",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "算了，让他好好努力吧！"
          },
          "2005409116": {
            "id": "2005409116",
            "speakerId": 1533,
            "speakerName": "特纳",
            "text": "我…不用了，过段时间我再写信给他吧。"
          }
        }
      }
    },
    {
      "subId": "2005415",
      "subQuestName": "将战利品和信交给特纳",
      "sceneId": null,

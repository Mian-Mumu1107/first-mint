  "subQuests": [
    {
      "subId": "2005401",
      "subQuestName": "与盖伊对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "2005401101"
        ],
        "dialogs": {
          "2005401101": {
            "id": "2005401101",
            "speakerId": 1441,
            "speakerName": "盖伊",
            "text": "唉，天天守门，哪里有什么工作细节能写…",
            "nextDialogs": [
              "2005401102"
            ]
          },
          "2005401102": {
            "id": "2005401102",
            "speakerId": 1441,
            "speakerName": "盖伊",
            "text": "不，不如说是连工作内容都没有啊…",
            "nextDialogs": [
              "2005401103"
            ]
          },
          "2005401103": {
            "id": "2005401103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么了？",
            "nextDialogs": [
              "2005401104"
            ]
          },
          "2005401104": {
            "id": "2005401104",
            "speakerId": 1441,
            "speakerName": "盖伊",
            "text": "哦，这个啊…是我老爹的事，他叫特纳，在晨曦酒庄工作。我当了西风骑士之后，他一直很高兴，来信也尽是问我工作情况啦什么的…",
            "nextDialogs": [
              "2005401105"
            ]
          },
          "2005401105": {
            "id": "2005401105",
            "speakerId": 1441,
            "speakerName": "盖伊",
            "text": "但我就在这守门啊！还守的是个压根没多少人走的侧门。",
            "nextDialogs": [
              "2005401106"
            ]
          },
          "2005401106": {
            "id": "2005401106",
            "speakerId": 1441,
            "speakerName": "盖伊",
            "text": "老爹还一直盼着我成就个什么伟业…守个门怎么能成就伟业嘛。",
            "nextDialogs": [
              "2005401107"
            ]
          },
          "2005401107": {
            "id": "2005401107",
            "speakerId": 1441,
            "speakerName": "盖伊",
            "text": "但是他身子一直不好，要是知道我在这守门，说不定就气出个好歹来，所以我在信里说，我一直随着骑士团的精锐在野外战斗…",
            "nextDialogs": [
              "2005401108"
            ]
          },
          "2005401108": {
            "id": "2005401108",
            "speakerId": 1441,
            "speakerName": "盖伊",
            "text": "但是一个劲地写信，一点证据没有，老爹肯定要疑心。",
            "nextDialogs": [
              "2005401109"
            ]
          },
          "2005401109": {
            "id": "2005401109",
            "speakerId": 1441,
            "speakerName": "盖伊",
            "text": "你是准备出去冒险吧，能帮我去找点战利品吗？给我的信增添一点可信度…",
            "nextDialogs": [
              "2005401112",
              "2005401113"
            ]
          },
          "2005401112": {
            "id": "2005401112",
            "speakerId": 1441,
            "speakerName": "盖伊",
            "text": "太感谢了。"
          },
          "2005401113": {
            "id": "2005401113",
            "speakerId": 1441,
            "speakerName": "盖伊",
            "text": "虽然守门没什么前途，但是这也是骑士团分配给我的工作。",
            "nextDialogs": [
              "2005401114"
            ]
          },
          "2005401114": {
            "id": "2005401114",
            "speakerId": 1441,
            "speakerName": "盖伊",
            "text": "我可不敢擅离职守…要是丢了这份工作，老爹非气昏过去不可…"
          }
        }
      }
    },
    {

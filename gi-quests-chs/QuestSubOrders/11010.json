    {
      "subId": "1101003",
      "subQuestName": "击败遗迹守卫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110100301"
        ],
        "dialogs": {
          "110100301": {
            "id": "110100301",
            "speakerId": 1003,
            "speakerName": "叶卡捷琳娜",
            "text": "这样不合适吧，执行官大人，您怎么能…",
            "nextDialogs": [
              "110100302"
            ]
          },
          "110100302": {
            "id": "110100302",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "偶尔一次嘛，没关系没关系！",
            "nextDialogs": [
              "110100303"
            ]
          },
          "110100303": {
            "id": "110100303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦？这个人怎么也在这…",
            "nextDialogs": [
              "110100304"
            ]
          },
          "110100304": {
            "id": "110100304",
            "speakerId": 1005,
            "speakerName": "托克",
            "text": "哥哥！哥哥、哥哥！",
            "nextDialogs": [
              "110100305"
            ]
          },
          "110100305": {
            "id": "110100305",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "啊这声音是…托克！天啊，是托克！",
            "nextDialogs": [
              "110100306"
            ]
          },
          "110100306": {
            "id": "110100306",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "哈哈哈…这是你给我准备的惊喜吗，托克？我还以为要等我回了至冬才能见到你…",
            "nextDialogs": [
              "110100307"
            ]
          },
          "110100307": {
            "id": "110100307",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "你的冬妮娅姐姐，还有安东哥哥…他们怎么样？过得好不好？",
            "nextDialogs": [
              "110100308"
            ]
          },
          "110100308": {
            "id": "110100308",
            "speakerId": 1005,
            "speakerName": "托克",
            "text": "他们都可想你了，冬妮娅姐姐每天晚饭前都在祷告，祈求哥哥的平安…",
            "nextDialogs": [
              "110100309"
            ]
          },
          "110100309": {
            "id": "110100309",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "…等等，不对，托克！你是怎么来璃月的，我怎么没接到任何消息…",
            "nextDialogs": [
              "110100310"
            ]
          },
          "110100310": {
            "id": "110100310",
            "speakerId": 1005,
            "speakerName": "托克",
            "text": "唔，这个…我见到一艘像是卖玩具的船，还以为哥哥在上面…",
            "nextDialogs": [
              "110100311"
            ]
          },
          "110100311": {
            "id": "110100311",
            "speakerId": 1005,
            "speakerName": "托克",
            "text": "下了船以后我走啊走，然后就见到了「独眼小宝」！",
            "nextDialogs": [
              "110100312"
            ]
          },
          "110100312": {
            "id": "110100312",
            "speakerId": 1005,
            "speakerName": "托克",
            "text": "#「独眼小宝」赶走了一个坏蛋，再然后，我就跟着好人{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}过来了…",
            "nextDialogs": [
              "110100314"
            ]
          },
          "110100314": {
            "id": "110100314",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且…托克居然是「公子」的弟弟吗！",
            "nextDialogs": [
              "110100316"
            ]
          },
          "110100316": {
            "id": "110100316",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那看来托克的钱，我们收得心安理得呢！",
            "nextDialogs": [
              "110100317"
            ]
          },
          "110100317": {
            "id": "110100317",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "这太危险了托克，见到你我的确很开心，但是答应哥哥，以后不许做这样冒险的事情了。",
            "nextDialogs": [
              "110100318"
            ]
          },
          "110100318": {
            "id": "110100318",
            "speakerId": 1005,
            "speakerName": "托克",
            "text": "唔…托克知道了，哥哥，请你不要生我的气…",
            "nextDialogs": [
              "110100319"
            ]
          },
          "110100319": {
            "id": "110100319",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "哥哥没有生气，我只是在担心你。",
            "nextDialogs": [
              "110100320"
            ]
          },
          "110100320": {
            "id": "110100320",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "如果不是遇上了这两位，托克的处境可能就危险了。有好好道谢过了吗？",
            "nextDialogs": [
              "110100321"
            ]
          },
          "110100321": {
            "id": "110100321",
            "speakerId": 1005,
            "speakerName": "托克",
            "text": "嗯！托克可懂礼貌了。",
            "nextDialogs": [
              "110100322"
            ]
          },
          "110100322": {
            "id": "110100322",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "终于注意到我们了吗，「公子」哥哥？",
            "nextDialogs": [
              "110100323"
            ]
          },
          "110100323": {
            "id": "110100323",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "哈哈哈哈，真是不好意思，与家人的交流无论何时都是该放在第一位的，还请你们谅解。",
            "nextDialogs": [
              "110100324"
            ]
          },
          "110100324": {
            "id": "110100324",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "还有，虽然之前我们有过一些对立的经历，不过抛开那些立场上的问题…我们不是相处得挺愉快的吗？"
          }
        }
      }
    },
    {
      "subId": "1101009",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {

            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呼…解决掉啦。",
            "nextDialogs": [
              "110100502"
            ]
          },
          "110100502": {
            "id": "110100502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们继续在附近转转吧，说不定还有其它遗迹守卫在。"
          }
        }

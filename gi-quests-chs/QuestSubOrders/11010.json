  "subQuests": [
    {
      "subId": "1101001",
      "subQuestName": "向千岩军了解附近的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110100101"
        ],
        "dialogs": {
          "110100101": {
            "id": "110100101",
            "speakerId": 1000,
            "speakerName": "戴派",
            "text": "当心，旅人。最近可不是观光的好时候。",
            "nextDialogs": [
              "110100102"
            ]
          },
          "110100102": {
            "id": "110100102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，最近出什么事了吗？",
            "nextDialogs": [
              "110100103"
            ]
          },
          "110100103": {
            "id": "110100103",
            "speakerId": 1000,
            "speakerName": "戴派",
            "text": "嗯。总部接到多起目击报告，有一些本不该出现的遗迹守卫，晃荡在本不该出现的地区。",
            "nextDialogs": [
              "110100104"
            ]
          },
          "110100104": {
            "id": "110100104",
            "speakerId": 1000,
            "speakerName": "戴派",
            "text": "教头派人追查这些古代机器的来源，发现似乎是从一处遗迹里突然冒出来的。",
            "nextDialogs": [
              "110100105"
            ]
          },
          "110100105": {
            "id": "110100105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是谁把它们吵醒了吗？",
            "nextDialogs": [
              "110100106"
            ]
          },
          "110100106": {
            "id": "110100106",
            "speakerId": 1000,
            "speakerName": "戴派",
            "text": "不清楚，我们获知的情报太少。",
            "nextDialogs": [
              "110100107"
            ]
          },
          "110100107": {
            "id": "110100107",
            "speakerId": 1000,
            "speakerName": "戴派",
            "text": "况且那遗迹阴森森的，里面不时还会传出「咔啦咔啦」的响声…",
            "nextDialogs": [
              "110100108"
            ]
          },
          "110100108": {
            "id": "110100108",
            "speakerId": 1000,
            "speakerName": "戴派",
            "text": "在总部的批准下达之前，我们是不被允许进入探索的。",
            "nextDialogs": [
              "110100113",
              "110100111"
            ]
          },
          "110100113": {
            "id": "110100113",
            "speakerId": 1000,
            "speakerName": "戴派",
            "text": "总之目前最好的策略，就只有加强巡逻，避免一般民众受到波及了。",
            "nextDialogs": [
              "110100114"
            ]
          },
          "110100114": {
            "id": "110100114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，普通人撞上遗迹守卫的话，可就危险了…",
            "nextDialogs": [
              "110100115"
            ]
          },
          "110100115": {
            "id": "110100115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我能帮忙吗？",
            "nextDialogs": [
              "110100116"
            ]
          },
          "110100116": {
            "id": "110100116",
            "speakerId": 1000,
            "speakerName": "戴派",
            "text": "呃，你的心意我十分感谢，可是…万一让你因此陷入危险，那可就得不偿失了…",
            "nextDialogs": [
              "110100117"
            ]
          },
          "110100117": {
            "id": "110100117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}可是很能打的，你放心啦。"
          },
          "110100111": {
            "id": "110100111",
            "speakerId": 1000,
            "speakerName": "戴派",
            "text": "嗯？你刚才说了什么吗？",
            "nextDialogs": [
              "110100112"
            ]
          },
          "110100112": {
            "id": "110100112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂，你的口吻怎么像迪卢克老爷评判骑士团一样？"
          }
        }
      }
    },
    {
      "subId": "1101002",
      "subQuestName": "调查遗迹守卫的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110100201"
        ],
        "dialogs": {
          "110100201": {
            "id": "110100201",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}快看！好大，好威风！",
            "nextDialogs": [
              "110100202"
            ]
          },
          "110100202": {
            "id": "110100202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，是个装扮奇怪的小朋友…",
            "nextDialogs": [
              "110100203"
            ]
          },
          "110100203": {
            "id": "110100203",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "我还是第一次这么近距离看呢，你们认识它嘛？",
            "nextDialogs": [
              "110100205",
              "110100207"
            ]
          },
          "110100205": {
            "id": "110100205",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "错啦错啦，什么「遗迹守卫」，它的名字是「独眼小宝」！",
            "nextDialogs": [
              "110100208"
            ]
          },
          "110100208": {
            "id": "110100208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「独眼小宝」？…原来还有这么可爱的叫法吗？",
            "nextDialogs": [
              "110100209"
            ]
          },
          "110100209": {
            "id": "110100209",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "嗯！是我哥哥告诉我的，我哥哥是最厉害的玩具销售员，专门卖这种玩具的！",
            "nextDialogs": [
              "110100210"
            ]
          },
          "110100210": {
            "id": "110100210",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "他现在在璃月的「玩具研究所」工作，「独眼小宝」就是在那里出生的。",
            "nextDialogs": [
              "110100211"
            ]
          },
          "110100211": {
            "id": "110100211",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}你应该也很喜欢玩具吧，你身边飘着的这只是最新款吗？居然还会说话！"
          },
          "110100207": {
            "id": "110100207",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "没错！「独眼小宝」超~~~厉害的，没有坏蛋能逃过它的手掌。"
          }
        }
      }
    },

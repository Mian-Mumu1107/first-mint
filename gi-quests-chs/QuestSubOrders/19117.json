    {
      "subId": "1911701",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191170106"
        ],
        "dialogs": {
          "191170106": {
            "id": "191170106",
            "speakerId": 12156,
            "speakerName": "忍犬",
            "text": "汪！汪呜！",
            "nextDialogs": [
              "191170107"
            ]
          },
          "191170107": {
            "id": "191170107",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "好凶！差点又被咬到了！",
            "nextDialogs": [
              "191170108"
            ]
          },
          "191170108": {
            "id": "191170108",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "我说你啊，肚子都饿瘪了，差不多也该吃点东西了吧？",
            "nextDialogs": [
              "191170109"
            ]
          },
          "191170109": {
            "id": "191170109",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "就算你没有和我回去的想法，也没必要一点东西都不吃吧。",
            "nextDialogs": [
              "191170110"
            ]
          },
          "191170110": {
            "id": "191170110",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "难道是担心食物中有毒吗？我亲自替你尝一下。",
            "nextDialogs": [
              "191170121"
            ]
          },
          "191170121": {
            "id": "191170121",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "看，完全没问题吧。",
            "nextDialogs": [
              "191170113"
            ]
          },
          "191170113": {
            "id": "191170113",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "来，稍微吃一点。少吃两口，我今天就不来打扰你了，怎么样？",
            "nextDialogs": [
              "191170114"
            ]
          },
          "191170114": {
            "id": "191170114",
            "speakerId": 12156,
            "speakerName": "忍犬",
            "text": "汪！汪汪！",
            "nextDialogs": [
              "191170115"
            ]
          },
          "191170115": {
            "id": "191170115",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "完全不打算吃我们的食物呢…总觉得它看上去很焦躁不安。",
            "nextDialogs": [
              "191170116"
            ]
          },
          "191170116": {
            "id": "191170116",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "海里有什么东西吗？还是周围有什么让它警惕的东西呢？",
            "nextDialogs": [
              "191170117"
            ]
          },
          "191170117": {
            "id": "191170117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "会不会是那些怪物？",
            "nextDialogs": [
              "191170118"
            ]
          },
          "191170118": {
            "id": "191170118",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "你是说它被周围的怪物攻击了吗…倒也有可能。",
            "nextDialogs": [
              "191170119"
            ]
          },
          "191170119": {
            "id": "191170119",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "人在危险的环境下也吃不下饭吧，我们帮它把周围清理一下好了。",
            "nextDialogs": [
              "191170120"
            ]
          },
          "191170120": {
            "id": "191170120",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "#辛苦你陪我一起了，{NICKNAME}。至少让这里清净一些吧。"
          }
        }
      }
    }
  ]

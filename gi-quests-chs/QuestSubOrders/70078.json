    {
      "subId": "7007816",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700781601"
        ],
        "dialogs": {
          "700781601": {
            "id": "700781601",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "刚才警戒机关闪得那么快，我还以为这里有什么危险呢…",
            "nextDialogs": [
              "700781602"
            ]
          },
          "700781602": {
            "id": "700781602",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "现在看来什么都没有嘛…没有深渊魔物，也没有什么幽灵。",
            "nextDialogs": [
              "700781603"
            ]
          },
          "700781603": {
            "id": "700781603",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "甚至感觉有点寂寞。",
            "nextDialogs": [
              "700781604"
            ]
          },
          "700781604": {
            "id": "700781604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…寂寞才是最可怕的魔鬼。",
            "nextDialogs": [
              "700781605"
            ]
          },
          "700781605": {
            "id": "700781605",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "哦，是嘛，完全听不懂！",
            "nextDialogs": [
              "700781606"
            ]
          },
          "700781606": {
            "id": "700781606",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "不过刚才还猛吹的风到底是哪里…咦，不对，是在上面！",
            "nextDialogs": [
              "700781607"
            ]
          },
          "700781607": {
            "id": "700781607",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "有什么从上面掉下来了，噫——"
          }
        }
      }
    },
    {
      "subId": "7007817",

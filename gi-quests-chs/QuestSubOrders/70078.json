    {
      "subId": "7007803",
      "subQuestName": "与奥多夫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700780301"
        ],
        "dialogs": {
          "700780301": {
            "id": "700780301",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "奥多夫！",
            "nextDialogs": [
              "700780302"
            ]
          },
          "700780302": {
            "id": "700780302",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "哦，是你们，你们到的比我想象中要快呢…",
            "nextDialogs": [
              "700780304",
              "700780307"
            ]
          },
          "700780304": {
            "id": "700780304",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "不，该做的准备已经做好了…啊呀，刚才那话不是在指责你们，而是一种夸奖。",
            "nextDialogs": [
              "700780305"
            ]
          },
          "700780305": {
            "id": "700780305",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "很少人准时，大多数人都只是让人等待…有的时候提前在场也是一种了不起的美德。",
            "nextDialogs": [
              "700780309"
            ]
          },
          "700780309": {
            "id": "700780309",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "嗯…你们看，发出警报的就是这样的警戒机关，它会发出警报是因为…",
            "nextDialogs": [
              "700780310"
            ]
          },
          "700780310": {
            "id": "700780310",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "现在就有幽灵在场！",
            "nextDialogs": [
              "700780311"
            ]
          },
          "700780311": {
            "id": "700780311",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "啊呀，那看来我们三个人里必有幽灵了，我可以保证我是活人，我刚才还在喝啤酒呢。",
            "nextDialogs": [
              "700780312"
            ]
          },
          "700780312": {
            "id": "700780312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也是活人。",
            "nextDialogs": [
              "700780313"
            ]
          },
          "700780313": {
            "id": "700780313",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "原来如此，原来幽灵是我呀…才不对吧！",
            "nextDialogs": [
              "700780314"
            ]
          },
          "700780314": {
            "id": "700780314",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "哈哈，看来我们三个都不是幽灵，如此看来，警报并不是幽灵导致的…",
            "nextDialogs": [
              "700780315"
            ]
          },
          "700780315": {
            "id": "700780315",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "我想，触发机关的应该是异常的气流…这种老式的机关总会变得更加敏感，一有风吹草动就会被触发。",
            "nextDialogs": [
              "700780316"
            ]
          },
          "700780316": {
            "id": "700780316",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "奥多夫居然对这个机关这么了解呢。",
            "nextDialogs": [
              "700780317"
            ]
          },
          "700780317": {
            "id": "700780317",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "啊呀…毕竟我是本地人，本地人知道一些外地人不知道的秘密也很正常嘛…"
          },
          "700780307": {
            "id": "700780307",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "哈哈，我不是这个意思，抱歉，是我言辞有误。",
            "nextDialogs": [
              "700780308"
            ]
          },
          "700780308": {
            "id": "700780308",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "你们能提前到场是好事，比如…现在我们就能更快开始这次的调查啦！"
          }
        }
      }
    },
    {
      "subId": "7007804",
      "subQuestName": "前往灯塔底遗迹的另一入口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700780401"
        ],
        "dialogs": {
          "700780401": {
            "id": "700780401",
            "speakerId": 1000,
            "speakerName": "马泰奥",
            "text": "真是奇怪，奥多夫这次这么热心…他之前不是还和温斯洛起过矛盾来着？",
            "nextDialogs": [
              "700780402"
            ]
          },
          "700780402": {
            "id": "700780402",
            "speakerId": 1000,
            "speakerName": "马泰奥",
            "text": "听到温斯洛的事，我还以为他会说点风凉话之类的呢…"
          }
        }
      }
    },
    {
      "subId": "7007806",
      "subQuestName": "进入灯塔底部的遗迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7007807",
      "subQuestName": "与温斯洛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700780701"
        ],
        "dialogs": {
          "700780701": {
            "id": "700780701",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "呜…别过来…别过来…别再闪了…",
            "nextDialogs": [
              "700780702"
            ]
          },
          "700780702": {
            "id": "700780702",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "啊呀，温斯洛。",
            "nextDialogs": [
              "700780703"
            ]
          },
          "700780703": {
            "id": "700780703",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "谁——谁啊！我把门都关上了，你们怎么进来的！",
            "nextDialogs": [
              "700780704"
            ]
          },
          "700780704": {
            "id": "700780704",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "幽、幽灵——别、我错了，你们别靠近我！",
            "nextDialogs": [
              "700780705"
            ]
          },
          "700780705": {
            "id": "700780705",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "哇，看上去好严重，都有点神志不清了。",
            "nextDialogs": [
              "700780706"
            ]
          },
          "700780706": {
            "id": "700780706",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "白色幽灵，白色幽灵出现了——",
            "nextDialogs": [
              "700780707"
            ]
          },
          "700780707": {
            "id": "700780707",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "如此大叫着，名为温斯洛的男人险些就这样背过气去…\\n在奥多夫的安抚下，才稍稍冷静了下来，恢复了一些理智。",
            "nextDialogs": [
              "700780708"
            ]
          },
          "700780708": {
            "id": "700780708",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "好点了吗，温斯洛？",
            "nextDialogs": [
              "700780709"
            ]
          },
          "700780709": {
            "id": "700780709",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "好？好什么好…奥多夫，你！你来干什么！",
            "nextDialogs": [
              "700780710"
            ]
          },
          "700780710": {
            "id": "700780710",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "你就是来看我的笑话的，对不对…你还带了这个白色的家伙来，就是为了吓我！",
            "nextDialogs": [
              "700780711"
            ]
          },
          "700780711": {
            "id": "700780711",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "你们这些本地人，你们一直在排斥我，嫉妒我住在这，你们这些、你们这些…",
            "nextDialogs": [
              "700780712"
            ]
          },
          "700780712": {
            "id": "700780712",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "冷静点，温斯洛，我们是来帮你的。我们一直都在帮你，温斯洛。",
            "nextDialogs": [
              "700780713"
            ]
          },
          "700780713": {
            "id": "700780713",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "在你叫嚷着要把底下那些「阴湿的，恐怖的，麻烦的玩意儿」迁到港外的野地里的时候，我们来帮你，劝你不要这么干。",
            "nextDialogs": [
              "700780714"
            ]
          },
          "700780714": {
            "id": "700780714",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "那时我跟你说，「会有报应的，温斯洛。」…你看，现在你变成了这样，我心里也很难受。",
            "nextDialogs": [
              "700780715"
            ]
          },
          "700780715": {
            "id": "700780715",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "你…",
            "nextDialogs": [
              "700780716"
            ]
          },
          "700780716": {
            "id": "700780716",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "#然后，这两天我刚从至冬回来，就听说你被这里的幽灵啊什么的折磨，立刻找来了能够解决麻烦的{NICKNAME}和派蒙。",
            "nextDialogs": [
              "700780717"
            ]
          },
          "700780717": {
            "id": "700780717",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "我们一直在帮你，温斯洛…",
            "nextDialogs": [
              "700780718"
            ]
          },
          "700780718": {
            "id": "700780718",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "谁知道…谁知道你们是不是故意的…",
            "nextDialogs": [
              "700780719"
            ]
          },
          "700780719": {
            "id": "700780719",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "#唉…你如果不相信我，也该相信相信{NICKNAME}，{M#他}{F#她}可是骑士团的荣誉骑士。",
            "nextDialogs": [
              "700780720"
            ]
          },
          "700780720": {
            "id": "700780720",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "我…",
            "nextDialogs": [
              "700780721"
            ]
          },
          "700780721": {
            "id": "700780721",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "行了，温斯洛，继续待在这儿对你的精神状况可不太好。",
            "nextDialogs": [
              "700780722"
            ]
          },
          "700780722": {
            "id": "700780722",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "#{NICKNAME}，派蒙，看看这可怜人吧，我先带他上去透透气，遗迹的事就交给你们了…",
            "nextDialogs": [
              "700780723"
            ]
          },
          "700780723": {
            "id": "700780723",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要是我们没能成功…",
            "nextDialogs": [
              "700780724"
            ]
          },
          "700780724": {
            "id": "700780724",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也将化作它们中的一员…",
            "nextDialogs": [
              "700780725"
            ]
          },
          "700780725": {
            "id": "700780725",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "噫、噫啊——",
            "nextDialogs": [
              "700780726"
            ]
          },
          "700780726": {
            "id": "700780726",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "真是的，又在说些奇怪的话！别在这里吓人啦！",
            "nextDialogs": [
              "700780727"
            ]
          },
          "700780727": {
            "id": "700780727",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "哈哈，我想下面的东西应该不会那么危险，好了，祝你们能顺利解决问题。",
            "nextDialogs": [
              "700780728"
            ]
          },
          "700780728": {
            "id": "700780728",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嗯嗯，我们一定会的！",
            "nextDialogs": [
              "700780729"
            ]
          },
          "700780729": {
            "id": "700780729",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "奥多夫扶着脚步蹒跚、神色难看的温斯洛离开了塔下的遗迹…"
          }
        }
      }
    },

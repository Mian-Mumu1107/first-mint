              "700780222"
            ]
          },
          "700780222": {
            "id": "700780222",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "那我们就得找比西风骑士团的骑士们更可靠的人了，比如曾经拯救过蒙德的大英雄之类的…",
            "nextDialogs": [
              "700780223"
            ]
          },
          "700780223": {
            "id": "700780223",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "哼哼，这样的大英雄去哪里找呢！",
            "nextDialogs": [
              "700780227",
              "700780226"
            ]
          },
          "700780227": {
            "id": "700780227",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "哈哈，两位英雄，恕我直言，能接受我的不情之请吗？",
            "nextDialogs": [
              "700780228"
            ]
          },
          "700780228": {
            "id": "700780228",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "吔，但是有讨人厌的作怪幽灵…",
            "nextDialogs": [
              "700780229"
            ]
          },
          "700780229": {
            "id": "700780229",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "啊呀，也有故事里的幽灵徘徊不去只为守护深藏山林之中的财宝…",
            "nextDialogs": [
              "700780230"
            ]
          },
          "700780230": {
            "id": "700780230",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "哦！财宝！"
          },
          "700780226": {
            "id": "700780226",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "只是两位正好在此…世上最美丽的莫过于诗歌与巧合嘛。实话说，如果没有两位，我也打算独自去看看情况。"
          }
        }
      }

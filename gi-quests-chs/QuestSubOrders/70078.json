    {
      "subId": "7007819",
      "subQuestName": "回到旧灯塔底部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7007820",
      "subQuestName": "与奥多夫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700782001"
        ],
        "dialogs": {
          "700782001": {
            "id": "700782001",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "奥多夫，我们回来了！怎么样，警戒机关还有问题吗？",
            "nextDialogs": [
              "700782002"
            ]
          },
          "700782002": {
            "id": "700782002",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "没有了，警戒机关已经停止闪烁了。",
            "nextDialogs": [
              "700782003"
            ]
          },
          "700782003": {
            "id": "700782003",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "啊呀，好快，两位居然这么迅速地解决了麻烦。",
            "nextDialogs": [
              "700782004"
            ]
          },
          "700782004": {
            "id": "700782004",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "是啊，原来那些风…",
            "nextDialogs": [
              "700782005"
            ]
          },
          "700782005": {
            "id": "700782005",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "那些风想必就是不愿意离开的骑士英魂发出的怒吼…警戒机关的闪烁只是一种警告。",
            "nextDialogs": [
              "700782006"
            ]
          },
          "700782006": {
            "id": "700782006",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "欸，等等，其实幽灵…",
            "nextDialogs": [
              "700782007"
            ]
          },
          "700782007": {
            "id": "700782007",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "其实幽灵们并不想真正伤害你，温斯洛，他们只是对你想要让他们离开的想法感到不满。",
            "nextDialogs": [
              "700782008"
            ]
          },
          "700782008": {
            "id": "700782008",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "真、真的吗…",
            "nextDialogs": [
              "700782009"
            ]
          },
          "700782009": {
            "id": "700782009",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "他们是对抗深渊牺牲在这里的英雄，怎么会真的做伤害你的事情呢？",
            "nextDialogs": [
              "700782010"
            ]
          },
          "700782010": {
            "id": "700782010",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "#咳咳…多谢这两位，{NICKNAME}和派蒙，{M#他们}{F#她们}是西风骑士团的荣誉骑士，也是顶级的…顶级的幽灵谈判专家。",
            "nextDialogs": [
              "700782011"
            ]
          },
          "700782011": {
            "id": "700782011",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "虽然…呃，不过，这个头衔还挺帅气的。",
            "nextDialogs": [
              "700782012"
            ]
          },
          "700782012": {
            "id": "700782012",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "刚刚的那声仿佛脚下石板开裂的巨响…两位应该没在那阵巨响里受伤吧…",
            "nextDialogs": [
              "700782013"
            ]
          },
          "700782013": {
            "id": "700782013",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "毫发无损。",
            "nextDialogs": [
              "700782014"
            ]
          },
          "700782014": {
            "id": "700782014",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "#那就好，我刚刚还有些担心来着，咳咳，刚才的那阵巨响其实就是…就是{NICKNAME}和派蒙与骑士团的幽灵们进行的…",
            "nextDialogs": [
              "700782015"
            ]
          },
          "700782015": {
            "id": "700782015",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "…嗯…超级通灵…掰手腕谈判！本地人都知道，啊呀，那是一种非常危险的平息幽灵愤怒的方式。",
            "nextDialogs": [
              "700782016"
            ]
          },
          "700782016": {
            "id": "700782016",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "超级通灵掰手腕谈判？真、真的吗？",
            "nextDialogs": [
              "700782018",
              "700782020"
            ]
          },
          "700782018": {
            "id": "700782018",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "#多么强大，与幽灵掰手腕比赛时因为发出的巨力使遗迹塌陷，对于谈判大师{NICKNAME}来说只是普通的日常！",
            "nextDialogs": [
              "700782021"
            ]
          },
          "700782021": {
            "id": "700782021",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "总之，经过谈判，这些幽灵的愤怒也应该平息了下来…",
            "nextDialogs": [
              "700782022"
            ]
          },
          "700782022": {
            "id": "700782022",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "那、那他们再也不会出来作祟…不不不，我的意思是，出来影响警戒机关了吧…",
            "nextDialogs": [
              "700782023"
            ]
          },
          "700782023": {
            "id": "700782023",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "那可说不准啊温斯洛，得看你表现。",
            "nextDialogs": [
              "700782024"
            ]
          },
          "700782024": {
            "id": "700782024",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "我…我这两天表现得可好了，我好好清理了英雄们墓边的野草，还仔细擦拭了墓碑…",
            "nextDialogs": [
              "700782025"
            ]
          },
          "700782025": {
            "id": "700782025",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "……",
            "nextDialogs": [
              "700782026"
            ]
          },
          "700782026": {
            "id": "700782026",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "#啊呀，干得好，温斯洛，{NICKNAME}谈判顺利，你做出的弥补一定也起到了很大的作用。",
            "nextDialogs": [
              "700782027"
            ]
          },
          "700782027": {
            "id": "700782027",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "如果你能一直这样，那些曾经的英魂们一定会舒舒服服躺在三尺之下。",
            "nextDialogs": [
              "700782028"
            ]
          },
          "700782028": {
            "id": "700782028",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "如果能安稳躺在那，谁愿意没事就出来折腾呢？",
            "nextDialogs": [
              "700782029"
            ]
          },
          "700782029": {
            "id": "700782029",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "#别紧张了，温斯洛，你看，事情都会解决的。如果警戒机关再出问题，我们也能找{NICKNAME}来帮你谈判。",
            "nextDialogs": [
              "700782030"
            ]
          },
          "700782030": {
            "id": "700782030",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "你说得对…唉，奥多夫…",
            "nextDialogs": [
              "700782031"
            ]
          },
          "700782031": {
            "id": "700782031",
            "speakerId": 1005,
            "speakerName": "温斯洛",
            "text": "也谢谢你们…",
            "nextDialogs": [
              "700782032"
            ]
          },
          "700782032": {
            "id": "700782032",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "#好了，至于{NICKNAME}和派蒙，感谢你为我们作出的贡献，这是给你们的报酬…",
            "nextDialogs": [
              "700782033"
            ]
          },
          "700782033": {
            "id": "700782033",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "之前说要准备的东西就是这个，我就知道你们能够解决这个事件的。",
            "nextDialogs": [
              "700782034"
            ]
          },
          "700782034": {
            "id": "700782034",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "原来是报酬，我还以为准备的是什么冒险用的道具呢。",
            "nextDialogs": [
              "700782035"
            ]
          },
          "700782035": {
            "id": "700782035",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "我有自知之明，做点生意还行，冒险可不是我的强项。",
            "nextDialogs": [
              "700782036"
            ]
          },
          "700782036": {
            "id": "700782036",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "好了，两位朋友，下次再来酒馆吧，我们就能聊点其他有趣的事了！"
          },
          "700782020": {
            "id": "700782020",
            "speakerId": 1001,
            "speakerName": "奥多夫",
            "text": "#这是只有{NICKNAME}才能办到的事…"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7080002",
      "subQuestName": "与布洛克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708000201"
        ],
        "dialogs": {
          "708000201": {
            "id": "708000201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "708000202"
            ]
          },
          "708000202": {
            "id": "708000202",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "其实我正打算配合风花节开发一道新菜，主推「风的味道」，现在正在准备食材呢。",
            "nextDialogs": [
              "708000203"
            ]
          },
          "708000203": {
            "id": "708000203",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "不过，我明明拜托了艾伦帮我去明冠峡猎最新鲜的肉，怎么这么久了他还没回来…",
            "nextDialogs": [
              "708000204"
            ]
          },
          "708000204": {
            "id": "708000204",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "再拖下去，说不定那些食材都要不新鲜了，旅行者，能拜托你去明冠峡那边看看吗？",
            "nextDialogs": [
              "708000205"
            ]
          },
          "708000205": {
            "id": "708000205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "708000206"
            ]
          },
          "708000206": {
            "id": "708000206",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "那就辛苦你了，回头请你尝尝我的最新菜品！"
          }
        }
      }
    },

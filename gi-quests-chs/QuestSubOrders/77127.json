        "dialogs": {
          "771270301": {
            "id": "771270301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，你怎么了？",
            "nextDialogs": [
              "771270302"
            ]
          },
          "771270302": {
            "id": "771270302",
            "speakerId": 22553,
            "speakerName": "失落的霜精",
            "text": "呜呜…呀吼…",
            "nextDialogs": [
              "771270303"
            ]
          },
          "771270303": {
            "id": "771270303",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "失落的霜精指了指自己的头…",
            "nextDialogs": [
              "771270304"
            ]
          },
          "771270304": {
            "id": "771270304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…我懂了，你不开心，是因为别人都有帽子，你没有！",
            "nextDialogs": [
              "771270305"
            ]
          },
          "771270305": {
            "id": "771270305",
            "speakerId": 22553,
            "speakerName": "失落的霜精",
            "text": "呀吼，呀吼…",
            "nextDialogs": [
              "771270307",
              "771270309"
            ]
          },
          "771270307": {
            "id": "771270307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呢…",
            "nextDialogs": [
              "771270310"
            ]
          },
          "771270310": {
            "id": "771270310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我想想…如果这家伙是因为没有帽子才不开心，那么我们给它找到一顶帽子不就行了！",
            "nextDialogs": [
              "771270311"
            ]
          },
          "771270311": {
            "id": "771270311",
            "speakerId": 22553,
            "speakerName": "失落的霜精",
            "text": "呀吼呀吼！",
            "nextDialogs": [
              "771270312"
            ]
          },
          "771270312": {
            "id": "771270312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是要去哪里呢…",
            "nextDialogs": [
              "771270313"
            ]
          },
          "771270313": {
            "id": "771270313",
            "speakerId": 22553,
            "speakerName": "失落的霜精",
            "text": "呀吼，呀吼！",
            "nextDialogs": [
              "771270314"
            ]
          },
          "771270314": {
            "id": "771270314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，你知道哪里有帽子…",
            "nextDialogs": [
              "771270315"
            ]
          },
          "771270315": {
            "id": "771270315",
            "speakerId": 22553,
            "speakerName": "失落的霜精",
            "text": "呀吼…",
            "nextDialogs": [
              "771270316"
            ]
          },
          "771270316": {
            "id": "771270316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…原来如此，<color=#00E1FFFF>那口井下面</color>有帽子…呃，不如说就是掉到井下面去的吧…",
            "nextDialogs": [
              "771270317"
            ]
          },
          "771270317": {
            "id": "771270317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们下去帮你拿哦！",
            "nextDialogs": [
              "771270318"
            ]
          },
          "771270318": {
            "id": "771270318",
            "speakerId": 22553,
            "speakerName": "失落的霜精",
            "text": "呀吼！呀吼！"
          },
          "771270309": {
            "id": "771270309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它最好能听懂你这些了不起的道理。"
          }
        }
      }

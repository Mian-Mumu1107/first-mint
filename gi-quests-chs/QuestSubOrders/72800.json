    {
      "subId": "7280099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728009901"
        ],
        "dialogs": {
          "728009901": {
            "id": "728009901",
            "speakerId": 20268,
            "speakerName": "旭东",
            "text": "喔！应该就是这里了，我听说这里有很多新鲜食材来着，仔细找找吧。",
            "nextDialogs": [
              "728009902"
            ]
          },
          "728009902": {
            "id": "728009902",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "为什么我们来稻妻了，却要在树林里找食材，稻妻的特产不都是水产吗…",
            "nextDialogs": [
              "728009903"
            ]
          },
          "728009903": {
            "id": "728009903",
            "speakerId": 20268,
            "speakerName": "旭东",
            "text": "我不是听说，稻妻人会用「绯樱绣球」来做食物吗？那样感觉还不错啊。",
            "nextDialogs": [
              "728009904"
            ]
          },
          "728009904": {
            "id": "728009904",
            "speakerId": 20270,
            "speakerName": "芭尔瓦涅",
            "text": "那我们不是应该直接去那种樱树那边吗…",
            "nextDialogs": [
              "728009905"
            ]
          },

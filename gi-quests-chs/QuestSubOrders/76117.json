  },
  "subQuests": [
    {
      "subId": "7611701",
      "subQuestName": "前往冒险家协会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761170101"
        ],
        "dialogs": {
          "761170101": {
            "id": "761170101",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "…嗯，这份委托完成得确实没有问题。感谢您的努力，雅珂达小姐，请您收下这份报酬吧。",
            "nextDialogs": [
              "761170102"
            ]
          },
          "761170102": {
            "id": "761170102",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "哎呀，我都说了不会有问题…嘿嘿，钱还不少呢。还有什么能赚的委托，再帮我找找呗。",
            "nextDialogs": [
              "761170103"
            ]
          },
          "761170103": {
            "id": "761170103",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "好的，请您稍等…",
            "nextDialogs": [
              "761170104"
            ]
          },
          "761170104": {
            "id": "761170104",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "…欸？这是…",
            "nextDialogs": [
              "761170105"
            ]
          },
          "761170105": {
            "id": "761170105",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "喂，凯瑟琳，那首饰是用来发布悬赏委托的么？",
            "nextDialogs": [
              "761170106"
            ]
          },
          "761170106": {
            "id": "761170106",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "您的直觉很准，没错，这的确是伊赫安提先生押在协会，用来发布悬赏委托的。",
            "nextDialogs": [
              "761170107"
            ]
          },
          "761170107": {
            "id": "761170107",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "这份委托我接了，情报什么的拿来吧。",
            "nextDialogs": [
              "761170108"
            ]
          },
          "761170108": {
            "id": "761170108",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "可是，这份委托的酬金并不算多，而且这枚首饰如今在市场上也不值多少钱，可能不符合雅珂达小姐您的需求。",
            "nextDialogs": [
              "761170109"
            ]
          },
          "761170109": {
            "id": "761170109",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "没事，拿来拿来，这份委托就算我好心做慈善了，偶尔也要积积德嘛。",
            "nextDialogs": [
              "761170110"
            ]
          },
          "761170110": {
            "id": "761170110",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "哈哈…哈…好的，请您稍等一下…",
            "nextDialogs": [
              "761170113"
            ]
          },
          "761170113": {
            "id": "761170113",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "反正我平时也没别的事，总不能老是呆在屋里摸阿舍鲁吧，那样的话奈姐…呃，老板不得把我赶出来？",
            "nextDialogs": [
              "761170114"
            ]
          },
          "761170114": {
            "id": "761170114",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "#{NICKNAME}，派蒙，既然你们身手这么好，不然帮我来做委托？到时候钱平分。",
            "nextDialogs": [
              "761170115"
            ]
          },
          "761170115": {
            "id": "761170115",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#委、委托啊…你问{NICKNAME}，{M#他}{F#她}对这个最在行了！"
          }
        }
      }
    },
    {
      "subId": "7611702",
      "subQuestName": "和雅珂达一起执行委托",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761170201"
        ],
        "dialogs": {
          "761170201": {
            "id": "761170201",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "…嘁，真是个穷光蛋，怎么什么东西都没有。",
            "nextDialogs": [
              "761170202"
            ]
          },
          "761170202": {
            "id": "761170202",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "喂，卡列瓦。",
            "nextDialogs": [
              "761170203"
            ]
          },
          "761170203": {
            "id": "761170203",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "谁…哦哟，雅珂达，真是稀客上门，有什么事？",
            "nextDialogs": [
              "761170204"
            ]
          },
          "761170204": {
            "id": "761170204",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "没事，你前几天抢了一个叫伊赫安提的人，从他那里拿了点东西。",
            "nextDialogs": [
              "761170205"
            ]
          },
          "761170205": {
            "id": "761170205",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "这些钱你拿着，东西拿出来。今天我发好心，这东西当我从你们手上买的。",
            "nextDialogs": [
              "761170206"
            ]
          },
          "761170206": {
            "id": "761170206",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "不愧是背靠奈芙尔的人，瞧瞧这做派…真文明。",
            "nextDialogs": [
              "761170207"
            ]
          },
          "761170207": {
            "id": "761170207",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "那我要是不给你，你又能怎么样？",
            "nextDialogs": [
              "761170208"
            ]
          },
          "761170208": {
            "id": "761170208",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "呼…卡列瓦，我拜托你，你和你的那群傻瓜兄弟，能不能做一次正常人。",
            "nextDialogs": [
              "761170209"
            ]
          },
          "761170209": {
            "id": "761170209",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "雅珂达，你大老远的跑过来，想要从一个贼的手上「买东西」…",
            "nextDialogs": [
              "761170210"
            ]
          },
          "761170210": {
            "id": "761170210",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "塞进怀里的肉，我还能丢出来给你？",
            "nextDialogs": [
              "761170211"
            ]
          },
          "761170211": {
            "id": "761170211",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怎么感觉，这场谈判已经破裂了…",
            "nextDialogs": [
              "761170212"
            ]
          },
          "761170212": {
            "id": "761170212",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "呼…",
            "nextDialogs": [
              "761170213"
            ]
          },
          "761170213": {
            "id": "761170213",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "我的错，卡列瓦。我就不该学着奈姐的做派，和你们打交道。",
            "nextDialogs": [
              "761170214"
            ]
          },
          "761170214": {
            "id": "761170214",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "你们这群白痴，唯一看得懂的谈判手段就是拳头。",
            "nextDialogs": [
              "761170215"
            ]
          },
          "761170215": {
            "id": "761170215",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "#{NICKNAME}，来，我们一起放倒他们。",
            "nextDialogs": [
              "761170216"
            ]
          },
          "761170216": {
            "id": "761170216",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "看不起谁呢，兄弟们一起上！新仇旧恨，今天我们一起报了！"
          }
        }
      }
    },
    {
      "subId": "7611703",
      "subQuestName": "击败盗宝团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761170301"
        ],
        "dialogs": {
          "761170301": {
            "id": "761170301",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "我认输，停手，停手。",
            "nextDialogs": [
              "761170303"
            ]
          },
          "761170303": {
            "id": "761170303",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "早这样，哪来的这么多事，钱拿着，找个靠谱医生吧。",
            "nextDialogs": [
              "761170304"
            ]
          },
          "761170304": {
            "id": "761170304",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "…你什么意思？可怜我？",
            "nextDialogs": [
              "761170305"
            ]
          },
          "761170305": {
            "id": "761170305",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "别废话，钱拿着。之后是把它丢水里，还是用这些钱雇人来揍我，都随你的便。",
            "nextDialogs": [
              "761170306"
            ]
          },
          "761170306": {
            "id": "761170306",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "挨饿和浑身痛的滋味都不好受，别给自己找不痛快，卡列瓦。",
            "nextDialogs": [
              "761170307"
            ]
          },
          "761170307": {
            "id": "761170307",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "……",
            "nextDialogs": [
              "761170308"
            ]
          },
          "761170308": {
            "id": "761170308",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "从那个病秧子手上拿的东西，我放在旁边了。",
            "nextDialogs": [
              "761170309"
            ]
          },
          "761170309": {
            "id": "761170309",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "里面除了零钱之外，就只有一张画，一个破娃娃。钱我花完了，其他东西还没来得及丢，都在那边了。",
            "nextDialogs": [
              "761170310"
            ]
          },
          "761170310": {
            "id": "761170310",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "好。最后一个问题，你刚才说伊赫安提是「病秧子」，什么意思？",
            "nextDialogs": [
              "761170311"
            ]
          },
          "761170311": {
            "id": "761170311",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "就是字面意思，他病得都快没人样了。",
            "nextDialogs": [
              "761170312"
            ]
          },
          "761170312": {
            "id": "761170312",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "我看见这家伙的时候，他趴在地上一动不动，我还以为他…",
            "nextDialogs": [
              "761170313"
            ]
          },
          "761170313": {
            "id": "761170313",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "…然后，我就把他身边的包捡走了。",
            "nextDialogs": [
              "761170314"
            ]
          },
          "761170314": {
            "id": "761170314",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "把你最后一次看见伊赫安提的位置标记给我。",
            "nextDialogs": [
              "761170315"
            ]
          },
          "761170315": {
            "id": "761170315",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "最后一次？我想想…应该就在这里…",
            "nextDialogs": [
              "761170316"
            ]
          },
          "761170316": {
            "id": "761170316",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "#我知道了。{NICKNAME}，派蒙，我们走吧。",
            "nextDialogs": [
              "761170317"
            ]
          },
          "761170317": {
            "id": "761170317",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "我得把拿回来的东西，当面还给委托人才行。"
          }
        }
      }
    },
    {
      "subId": "7611704",
      "subQuestName": "与卡列瓦对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7611705",
      "subQuestName": "与伊赫安提对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761170401"
        ],
        "dialogs": {
          "761170401": {
            "id": "761170401",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "…呼…呼…",
            "nextDialogs": [
              "761170402"
            ]
          },
          "761170402": {
            "id": "761170402",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "是谁来了？我没有钱…什么也没有，如果你们想要我的命，就拿去吧…",
            "nextDialogs": [
              "761170403"
            ]
          },
          "761170403": {
            "id": "761170403",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "伊赫安提，我帮你把东西拿回来了。",
            "nextDialogs": [
              "761170404"
            ]
          },
          "761170404": {
            "id": "761170404",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "…雅珂达？是你么，我听见了你的声音，但我的眼睛看不清了。",
            "nextDialogs": [
              "761170405"
            ]
          },
          "761170405": {
            "id": "761170405",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "是我，伊赫安提，是我在你面前。你病得这么重，为什么不去找我？",
            "nextDialogs": [
              "761170406"
            ]
          },
          "761170406": {
            "id": "761170406",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "落魄的野狗就算濒死，也不敢踏入富丽堂皇的城市…毕竟它之前挨过太多富人的鞭子了。",
            "nextDialogs": [
              "761170407"
            ]
          },
          "761170407": {
            "id": "761170407",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "我不是那样的人，奈…老板也不是。",
            "nextDialogs": [
              "761170408"
            ]
          },
          "761170408": {
            "id": "761170408",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "那我就更不能去了，如果有人知道你们会付出好心，那你们可能每天都要付出好心了。",
            "nextDialogs": [
              "761170409"
            ]
          },
          "761170409": {
            "id": "761170409",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "没人敢在老板面前这么不长眼。",
            "nextDialogs": [
              "761170410"
            ]
          },
          "761170410": {
            "id": "761170410",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "但你总是偷偷发好心，然后，再被那些受到你好心的人倒刺一剑。",
            "nextDialogs": [
              "761170411"
            ]
          },
          "761170411": {
            "id": "761170411",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "我向老板学了很多，没有人能刺伤我了，之后再也不会。",
            "nextDialogs": [
              "761170412"
            ]
          },
          "761170412": {
            "id": "761170412",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "你就是不愿意收起好心。",
            "nextDialogs": [
              "761170413"
            ]
          },
          "761170413": {
            "id": "761170413",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "这是我自己的事。",
            "nextDialogs": [
              "761170414"
            ]
          },
          "761170414": {
            "id": "761170414",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "呵呵，也许这就是老大看重你的原因。",
            "nextDialogs": [
              "761170415"
            ]
          },
          "761170415": {
            "id": "761170415",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "也许这就是我活到现在的原因。",
            "nextDialogs": [
              "761170416"
            ]
          },
          "761170416": {
            "id": "761170416",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "哈哈哈…咳…咳咳！你说得对，雅珂达，你说得对…",
            "nextDialogs": [
              "761170417"
            ]
          },
          "761170417": {
            "id": "761170417",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "…好了，伊赫安提，有什么我能为你做的，现在就说吧。",
            "nextDialogs": [
              "761170418"
            ]
          },
          "761170418": {
            "id": "761170418",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "你还是这样，就不怕我突然讹你一笔？或者给你挖个大坑？",
            "nextDialogs": [
              "761170419"
            ]
          },
          "761170419": {
            "id": "761170419",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "你不会这么做的，我们认识很久了…",
            "nextDialogs": [
              "761170420"
            ]
          },
          "761170420": {
            "id": "761170420",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "就因为这？",
            "nextDialogs": [
              "761170421"
            ]
          },
          "761170421": {
            "id": "761170421",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "而且，瞧你这副模样，还能怎么威胁我？",
            "nextDialogs": [
              "761170422"
            ]
          },
          "761170422": {
            "id": "761170422",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "哈！总算有点长进，救一条骨头已经被抖散架的毒蛇，相对来说还算安全。",
            "nextDialogs": [
              "761170423"
            ]
          },
          "761170423": {
            "id": "761170423",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "那就帮个忙，把那个袋子里的画卷起来，塞进我兜里吧，我没力气把它拿起来了。",
            "nextDialogs": [
              "761170424"
            ]
          },
          "761170424": {
            "id": "761170424",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "这幅画是我和妻子还有女儿一起画的，也是我如今在这个世界上唯一关心的事物了。",
            "nextDialogs": [
              "761170425"
            ]
          },
          "761170425": {
            "id": "761170425",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "其他的东西对我来说，都已经没有意义了。",
            "nextDialogs": [
              "761170426"
            ]
          },
          "761170426": {
            "id": "761170426",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "要是从前的你听见这句话，肯定会笑得打滚。",
            "nextDialogs": [
              "761170427"
            ]
          },
          "761170427": {
            "id": "761170427",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "可惜…这些我之前无比重视的东西，到头来，既无法挽救我的妻子，也救不了我的人生。",
            "nextDialogs": [
              "761170428"
            ]
          },
          "761170428": {
            "id": "761170428",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "或许这就是盗贼的宿命吧。我们掠夺而来的东西，到头来都会被再掠夺走，最后，重新变得一无所有。",
            "nextDialogs": [
              "761170429"
            ]
          },
          "761170429": {
            "id": "761170429",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "那枚我用来发布委托的吊坠，也是我最后的一点财产…哈哈…也不能说是「我的」最后一点财产。",
            "nextDialogs": [
              "761170430"
            ]
          },
          "761170430": {
            "id": "761170430",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "这是你偷到手的第一枚首饰，你和我说过很多次了，你还和我说过你用的手段，还有那个富翁发觉自己被盗后的表情。",
            "nextDialogs": [
              "761170431"
            ]
          },
          "761170431": {
            "id": "761170431",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "是啊，现在它是你的了。",
            "nextDialogs": [
              "761170432"
            ]
          },
          "761170432": {
            "id": "761170432",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "这枚首饰的主人是谁？",
            "nextDialogs": [
              "761170433"
            ]
          },
          "761170433": {
            "id": "761170433",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "是个至冬人，叫霍洛莫夫，曾经在挪德卡莱居住过，但现在应该已经回至冬了，你想…",
            "nextDialogs": [
              "761170434"
            ]
          },
          "761170434": {
            "id": "761170434",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "我已经不是盗贼了，也不会把偷来的东西据为己有，这枚首饰本来属于谁，就应该归还给谁。",
            "nextDialogs": [
              "761170435"
            ]
          },
          "761170435": {
            "id": "761170435",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "哈哈…哈哈哈哈…！你真是个…真是个傻瓜，雅珂达。",
            "nextDialogs": [
              "761170436"
            ]
          },
          "761170436": {
            "id": "761170436",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "老大说得对，你这样的人做贼，一辈子也…咳咳…也发不了财…咳咳！",
            "nextDialogs": [
              "761170437"
            ]
          },
          "761170437": {
            "id": "761170437",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "咳咳…咳…咳！",
            "nextDialogs": [
              "761170438"
            ]
          },
          "761170438": {
            "id": "761170438",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "好了，不要再说话了。我这就回去给你找医生。",
            "nextDialogs": [
              "761170439"
            ]
          },
          "761170439": {
            "id": "761170439",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "不用了，就让我去我应该去的地方吧。",
            "nextDialogs": [
              "761170440"
            ]
          },
          "761170440": {
            "id": "761170440",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "你…！",
            "nextDialogs": [
              "761170441"
            ]
          },
          "761170441": {
            "id": "761170441",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "雅珂达，你知道老大定下的「规矩」。",
            "nextDialogs": [
              "761170442"
            ]
          },
          "761170442": {
            "id": "761170442",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "…「企望安息者，应得安息。」",
            "nextDialogs": [
              "761170443"
            ]
          },
          "761170443": {
            "id": "761170443",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "履行它吧，你明白我的意思。",
            "nextDialogs": [
              "761170444"
            ]
          },
          "761170444": {
            "id": "761170444",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "……",
            "nextDialogs": [
              "761170445"
            ]
          },
          "761170445": {
            "id": "761170445",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "我知道了。",
            "nextDialogs": [
              "761170446"
            ]
          },
          "761170446": {
            "id": "761170446",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "我很高兴，来帮我忙的人是你，雅珂达。",
            "nextDialogs": [
              "761170447"
            ]
          },
          "761170447": {
            "id": "761170447",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "可惜，我没有什么宝物给你，如果你想要的话，就把这个布娃娃拿走吧。",
            "nextDialogs": [
              "761170448"
            ]
          },
          "761170448": {
            "id": "761170448",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "这是…可是那些娃娃，我不是让你…",
            "nextDialogs": [
              "761170449"
            ]
          },
          "761170449": {
            "id": "761170449",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "啊，别误会。这是我自己做的，你之前做的那些娃娃，我都按你说的，全部烧光了。",
            "nextDialogs": [
              "761170450"
            ]
          },
          "761170450": {
            "id": "761170450",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "怎么样，我在眼睛彻底瞎掉之前，手艺还挺厉害的吧？",
            "nextDialogs": [
              "761170451"
            ]
          },
          "761170451": {
            "id": "761170451",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "拿去吧，雅珂达。就当做是我最后的礼物。",
            "nextDialogs": [
              "761170452"
            ]
          },
          "761170452": {
            "id": "761170452",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "我会回来看你的。",
            "nextDialogs": [
              "761170453"
            ]
          },
          "761170453": {
            "id": "761170453",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "去吧，再见了，雅珂达。",
            "nextDialogs": [
              "761170454"
            ]
          },
          "761170454": {
            "id": "761170454",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "谢谢你。"
          }
        }
      }
    },
    {
      "subId": "7611706",
      "subQuestName": "回到冒险家协会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761170501"
        ],
        "dialogs": {
          "761170501": {
            "id": "761170501",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "嗯，委托已经完成了，稍等，我把协会的酬金拿来…",
            "nextDialogs": [
              "761170502"
            ]
          },
          "761170502": {
            "id": "761170502",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "雅珂达小姐，您的脸色不太好，是遇见什么麻烦了么？",
            "nextDialogs": [
              "761170503"
            ]
          },
          "761170503": {
            "id": "761170503",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "没事。",
            "nextDialogs": [
              "761170504"
            ]
          },
          "761170504": {
            "id": "761170504",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "那请您稍等，我这就去拿酬金过来。",
            "nextDialogs": [
              "761170505"
            ]
          },
          "761170505": {
            "id": "761170505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "雅珂达，你没事吧？",
            "nextDialogs": [
              "761170506"
            ]
          },
          "761170506": {
            "id": "761170506",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "虽然说是不给他找医生…但伊赫安提先生看起来很难受，不然…",
            "nextDialogs": [
              "761170507"
            ]
          },
          "761170507": {
            "id": "761170507",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "不用了。既然我说了会守规矩，就要守规矩。",
            "nextDialogs": [
              "761170508"
            ]
          },
          "761170508": {
            "id": "761170508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他是你之前的…",
            "nextDialogs": [
              "761170509"
            ]
          },
          "761170509": {
            "id": "761170509",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "他是我之前的「同事」。",
            "nextDialogs": [
              "761170510"
            ]
          },
          "761170510": {
            "id": "761170510",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "虽然伊赫安提很胆小，但他可是所有人里最会捞钱的。",
            "nextDialogs": [
              "761170511"
            ]
          },
          "761170511": {
            "id": "761170511",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "其他人都只是傻乎乎地去骗去抢，他却能用各种手段运作，让人们心甘情愿地把钱给他。",
            "nextDialogs": [
              "761170512"
            ]
          },
          "761170512": {
            "id": "761170512",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "我在和伊赫安提做「同事」的时候，他也经常会教我各种话术，还带着我到处吃好吃的。",
            "nextDialogs": [
              "761170513"
            ]
          },
          "761170513": {
            "id": "761170513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他是你的朋友么？",
            "nextDialogs": [
              "761170514"
            ]
          },
          "761170514": {
            "id": "761170514",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "朋友？哈，当然不是，在那个鬼地方，没有傻瓜会和其他人交朋友，我们顶多算是「认识的人」而已。",
            "nextDialogs": [
              "761170515"
            ]
          },
          "761170515": {
            "id": "761170515",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "他之所以会那么照顾我，也是为了在我面前炫耀一下自己的实力，带着我这个小跟班，还能顺便给自己长长威风。",
            "nextDialogs": [
              "761170516"
            ]
          },
          "761170516": {
            "id": "761170516",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "但他之前的确照顾过我，我现在帮他，也是单纯想还他那个人情债而已。",
            "nextDialogs": [
              "761170517"
            ]
          },
          "761170517": {
            "id": "761170517",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "好了，请您收好这些酬金，雅珂达小姐，感谢您对协会的帮助！",
            "nextDialogs": [
              "761170518"
            ]
          },
          "761170518": {
            "id": "761170518",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "#嗯，这一份是给你的，{NICKNAME}，刚才也谢谢你了。",
            "nextDialogs": [
              "761170519"
            ]
          },
          "761170519": {
            "id": "761170519",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "我也该回「秘闻馆」了，要是老板突然想办事又找不到我，肯定又要开始念叨了。",
            "nextDialogs": [
              "761170520"
            ]
          },
          "761170520": {
            "id": "761170520",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "（…虽然说了不给他找医生，但买点镇痛的药送过去总行吧。）",
            "nextDialogs": [
              "761170521"
            ]
          },
          "761170521": {
            "id": "761170521",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "（老板肯定有门路，让她帮帮忙，大不了我这个月工资不要了呗…呃，也不能全不要，不要一半吧…）",
            "nextDialogs": [
              "761170522"
            ]
          },
          "761170522": {
            "id": "761170522",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "（对，就这么做，最好明天就把药拿给伊赫安提…）"
          }
        }
      }
    },
    {
      "subId": "7611708",
      "subQuestName": "等待至第二天（10点-24点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761170801"
        ],
        "dialogs": {
          "761170801": {
            "id": "761170801",
            "speakerId": 1004,
            "speakerName": "卡列瓦",
            "text": "…雅珂达，你真是个怪人。有时候精明得叫人害怕，有时候又傻得出奇。"
          }
        }
      }
    },
    {
      "subId": "7611707",
      "subQuestName": "再次探望伊赫安提",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761170601"
        ],
        "dialogs": {
          "761170601": {
            "id": "761170601",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "伊赫安提！伊赫安提，伊——",
            "nextDialogs": [
              "761170602"
            ]
          },
          "761170602": {
            "id": "761170602",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "这是…",
            "nextDialogs": [
              "761170603"
            ]
          },
          "761170603": {
            "id": "761170603",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "……",
            "nextDialogs": [
              "761170604"
            ]
          },
          "761170604": {
            "id": "761170604",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "…愿你安息，伊赫安提。",
            "nextDialogs": [
              "761170605"
            ]
          },
          "761170605": {
            "id": "761170605",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "我是不会被你说的那个所谓「宿命」追上的。",
            "nextDialogs": [
              "761170606"
            ]
          },
          "761170606": {
            "id": "761170606",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "至少，不是此时此刻。"
          }
        }
      }
    },
    {
      "subId": "7611707",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761170701"
        ],
        "dialogs": {
          "761170701": {
            "id": "761170701",
            "speakerId": 1005,
            "speakerName": "伊赫安提",
            "text": "老大，看来咱们都逃不掉了…"
          }
        }
      }
    }
  ]
}
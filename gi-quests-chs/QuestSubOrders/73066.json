    {
      "subId": "7306603",
      "subQuestName": "和兰那罗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730660301"
        ],
        "dialogs": {
          "730660301": {
            "id": "730660301",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "#金色的那菈…嗯，没错，那菈{NICKNAME}，和飞飞，白色的。",
            "nextDialogs": [
              "730660302"
            ]
          },
          "730660302": {
            "id": "730660302",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "你好，兰纳迦，我是！在这里等了很久了！",
            "nextDialogs": [
              "730660303"
            ]
          },
          "730660303": {
            "id": "730660303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们也找了你好久呢，小毛豆！",
            "nextDialogs": [
              "730660304"
            ]
          },
          "730660304": {
            "id": "730660304",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "兰纳迦，我是。小毛豆，不是。软蓬蓬白蘑菇飞飞。",
            "nextDialogs": [
              "730660305"
            ]
          },
          "730660305": {
            "id": "730660305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "软蓬蓬…白蘑菇？什么呀…你在说我吗？",
            "nextDialogs": [
              "730660307",
              "730660309"
            ]
          },
          "730660307": {
            "id": "730660307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哪里像啦！",
            "nextDialogs": [
              "730660311"
            ]
          },
          "730660311": {
            "id": "730660311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我是{NICKNAME}。",
            "nextDialogs": [
              "730660312"
            ]
          },
          "730660312": {
            "id": "730660312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我是派蒙，你好呀！",
            "nextDialogs": [
              "730660313"
            ]
          },
          "730660313": {
            "id": "730660313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…兰辣加，你找我们有什么事呀？",
            "nextDialogs": [
              "730660314"
            ]
          },
          "730660314": {
            "id": "730660314",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "#是兰纳迦。我的伙伴，那菈{NICKNAME}一定见过了。引你们来这里的，是他们吧？",
            "nextDialogs": [
              "730660315"
            ]
          },
          "730660315": {
            "id": "730660315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，你的两位小伙伴我们都见过啦！他们说可以在这里遇到你的！",
            "nextDialogs": [
              "730660316"
            ]
          },
          "730660316": {
            "id": "730660316",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "欢迎来到无郁稠林，我的园地，这里是。许许多多草木朋友、蘑菇朋友在这里，喜欢这里，他们。",
            "nextDialogs": [
              "730660317"
            ]
          },
          "730660317": {
            "id": "730660317",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "因为在这里，「无郁夷摩」。保护了我们，保护了森林，「无郁夷摩」。所以可以与朋友们团聚，帮助朋友们茁壮生长，兰纳迦。",
            "nextDialogs": [
              "730660318"
            ]
          },
          "730660318": {
            "id": "730660318",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "#但是，需要帮助，我们。可以提供帮助，那菈{NICKNAME}。",
            "nextDialogs": [
              "730660319"
            ]
          },
          "730660319": {
            "id": "730660319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以…你想要我们帮忙做什么呀？"
          },
          "730660309": {
            "id": "730660309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你这样说就好怪！",
            "nextDialogs": [
              "730660310"
            ]
          },
          "730660310": {
            "id": "730660310",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "不是小毛豆，是兰纳迦。大黄倭瓜那菈，爱使坏。"
          }
        }
      }
    },
    {

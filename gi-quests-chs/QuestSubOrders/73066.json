    {
      "subId": "7306642",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730664201"
        ],
        "dialogs": {
          "730664201": {
            "id": "730664201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我准备好了。",
            "nextDialogs": [
              "730664202"
            ]
          },
          "730664202": {
            "id": "730664202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我也是！",
            "nextDialogs": [
              "730664203"
            ]
          },
          "730664203": {
            "id": "730664203",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "那么…兰纳真，兰迦鲁，我们开始仪式吧。",
            "nextDialogs": [
              "730664204"
            ]
          },
          "730664204": {
            "id": "730664204",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "「来呀，来呀，花园的梦，森林的记忆…」\\n「来呀，来呀，不返的风，不逆流的水…」\\n「来呀，来呀，甜美的梦与苦涩的回味。」",
            "nextDialogs": [
              "730664205"
            ]
          },
          "730664205": {
            "id": "730664205",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "「送别吧，让我们：」\\n「老去的绿叶，胀满的果实…」\\n「淡去的好梦，谢落的花朵。」",
            "nextDialogs": [
              "730664206"
            ]
          },
          "730664206": {
            "id": "730664206",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "「等待呀，让我们：」\\n「雨季归来，草木欢畅…」\\n「石榴歌唱，苹果鼓掌。」"
          }
        }
      }
    },

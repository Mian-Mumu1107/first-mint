          "730663901": {
            "id": "730663901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呜哇，这是怎么回事！{NICKNAME}小心呀！你没事吧？",
            "nextDialogs": [
              "730663905",
              "730663904"
            ]
          },
          "730663905": {
            "id": "730663905",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "好啦，接下来…唔…",
            "nextDialogs": [
              "730663906"
            ]
          },
          "730663906": {
            "id": "730663906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "进入「呜呜噫噫蘑」！对吧？"
          },
          "730663904": {
            "id": "730663904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是说呀…"

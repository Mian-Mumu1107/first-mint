    {
      "subId": "7306605",
      "subQuestName": "和兰纳迦对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730660501"
        ],
        "dialogs": {
          "730660501": {
            "id": "730660501",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "就在这里，「耶然草」！被保护着，「耶然草」！",
            "nextDialogs": [
              "730660502"
            ]
          },
          "730660502": {
            "id": "730660502",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "解开封印，就可以去和「耶然草」说话啦！"
          }
        }
      }
    },

    {
      "subId": "7306644",
      "subQuestName": "和兰那罗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730662401"
        ],
        "dialogs": {
          "730662401": {
            "id": "730662401",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "记忆的精华，「苦舍桓」的力量…「无留陀」，只有用它才能击败。",
            "nextDialogs": [
              "730662402"
            ]
          },

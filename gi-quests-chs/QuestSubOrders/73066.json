    {
      "subId": "7306643",
      "subQuestName": "前去清除最后的死域",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730664301"
        ],
        "dialogs": {
          "730664301": {
            "id": "730664301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我还有些事情要去做。",
            "nextDialogs": [
              "730664302"
            ]
          },
          "730664302": {
            "id": "730664302",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "嗯，但不会等待我们，月亮的升落。所以快去快回，请你们。但…不用太着急，在这里，我们会等待你们。"
          }
        }
      }

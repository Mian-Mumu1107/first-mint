    {
      "subId": "7306641",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730664101"
        ],
        "dialogs": {
          "730664101": {
            "id": "730664101",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "兰纳迦，他来啦，他们来啦！",
            "nextDialogs": [
              "730664102"
            ]
          },
          "730664102": {
            "id": "730664102",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "嗯嗯，来啦，来啦！",
            "nextDialogs": [
              "730664103"
            ]
          },
          "730664103": {
            "id": "730664103",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "#来啦，那菈{NICKNAME}，白色的飞飞。欢迎你们，我们三个。",
            "nextDialogs": [
              "730664104"
            ]
          },
          "730664104": {
            "id": "730664104",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "欢迎你们！",
            "nextDialogs": [
              "730664105"
            ]
          },
          "730664105": {
            "id": "730664105",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "「兰赫玛」的仪式就要开始了，我们还在等什么呀？",
            "nextDialogs": [
              "730664106"
            ]
          },
          "730664106": {
            "id": "730664106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀，你们不是很着急，要举行那个什么…仪式吗？",
            "nextDialogs": [
              "730664107"
            ]
          },
          "730664107": {
            "id": "730664107",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "还可以等待，一点点的等待。我们。感谢你们，我们。所以…按照人类的习惯，珍贵的礼物会赠送，我们。",
            "nextDialogs": [
              "730664108"
            ]
          },
          "730664108": {
            "id": "730664108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…礼物？珍贵的礼物？",
            "nextDialogs": [
              "730664109"
            ]
          },
          "730664109": {
            "id": "730664109",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "嗯，没错哦。礼物，珍贵的礼物！",
            "nextDialogs": [
              "730664110"
            ]
          },
          "730664110": {
            "id": "730664110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦……！",
            "nextDialogs": [
              "730664113"
            ]
          },
          "730664113": {
            "id": "730664113",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "我们的礼物，是最宝贵的，是有生命的。比起死去的东西，有生命的东西，更值得保护。",
            "nextDialogs": [
              "730664114"
            ]
          },
          "730664114": {
            "id": "730664114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你看，兰纳迦都说啦，最宝贵的礼物！",
            "nextDialogs": [
              "730664115"
            ]
          },
          "730664115": {
            "id": "730664115",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "#帮助了我们，拯救森林，那菈{NICKNAME}。我们很感谢，所以…给你，这个。",
            "nextDialogs": [
              "730664116"
            ]
          },
          "730664116": {
            "id": "730664116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦…这是什么呀…？",
            "nextDialogs": [
              "730664117"
            ]
          },
          "730664117": {
            "id": "730664117",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "是活的记忆，是「纪念」…那菈所说的。容易遗忘的生物，那菈是。所以需要记住，用有生命的东西。",
            "nextDialogs": [
              "730664118"
            ]
          },
          "730664118": {
            "id": "730664118",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "给，兰纳迦的纪念，是这朵花。吹不散他，遗忘的流风；摧不折他，夺走梦的机关。"
          }
        }
      }
    },
    {
      "subId": "7306631",
      "subQuestName": "与兰那罗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730663101"
        ],
        "dialogs": {
          "730663101": {
            "id": "730663101",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "谢谢你，那菈…金色的那菈。你们做的一切，谢谢。",
            "nextDialogs": [
              "730663102"
            ]
          },
          "730663102": {
            "id": "730663102",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "已经摆脱了「无留陀」的重负，「无郁夷摩」。她很开心，「无郁夷摩」。",
            "nextDialogs": [
              "730663103"
            ]
          },
          "730663103": {
            "id": "730663103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，我们只不过碰巧路过，帮一把而已啦！那个「呜呜噫噫蘑」应该先感谢你们才对！",
            "nextDialogs": [
              "730663104"
            ]
          },
          "730663104": {
            "id": "730663104",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "这样吗…",
            "nextDialogs": [
              "730663105"
            ]
          },
          "730663105": {
            "id": "730663105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…对呀，怎么了？",
            "nextDialogs": [
              "730663106"
            ]
          },
          "730663106": {
            "id": "730663106",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "没什么，没什么…只不过，来之前，我们一起经历过的事情…像雾一样，像云一样，看不清…需要回忆。",
            "nextDialogs": [
              "730663107"
            ]
          },
          "730663107": {
            "id": "730663107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…是因为太累了吧？",
            "nextDialogs": [
              "730663110"
            ]
          },
          "730663110": {
            "id": "730663110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，没错，我们一起出去，多晒晒太阳，一会头脑就清楚啦！",
            "nextDialogs": [
              "730663111"
            ]
          },
          "730663111": {
            "id": "730663111",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "谢谢，但是…还需要我们陪伴，「无郁夷摩」。",
            "nextDialogs": [
              "730663112"
            ]
          },
          "730663112": {
            "id": "730663112",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "嗯，因为「无郁夷摩」刚刚醒来，还有好多故事要和我们讲！",
            "nextDialogs": [
              "730663113"
            ]
          },
          "730663113": {
            "id": "730663113",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "「无郁夷摩」要和我们分享她的梦，所以我们还不能离开呢…",
            "nextDialogs": [
              "730663114"
            ]
          },
          "730663114": {
            "id": "730663114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样啊…好不容易才办完了要紧的正事，还没来得及好好认识你们呢…",
            "nextDialogs": [
              "730663115"
            ]
          },
          "730663115": {
            "id": "730663115",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "没关系的，以后我们也是好朋友呀，只要我们还能记得你们。",
            "nextDialogs": [
              "730663116"
            ]
          },
          "730663116": {
            "id": "730663116",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "只要…还能记得你们，我们。",
            "nextDialogs": [
              "730663117"
            ]
          },
          "730663117": {
            "id": "730663117",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "嗯，只要我们不忘记！",
            "nextDialogs": [
              "730663118"
            ]
          },
          "730663118": {
            "id": "730663118",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "为了你们不忘记我，我的歌唱给你听。请你一定要记住…一定呀。",
            "nextDialogs": [
              "730663119"
            ]
          },
          "730663119": {
            "id": "730663119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…我们记住了！",
            "nextDialogs": [
              "730663120"
            ]
          },
          "730663120": {
            "id": "730663120",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "那么…我如果忘记了你们，听到这首歌，一定就会记起来的。",
            "nextDialogs": [
              "730663121"
            ]
          },
          "730663121": {
            "id": "730663121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…？",
            "nextDialogs": [
              "730663122"
            ]
          },
          "730663122": {
            "id": "730663122",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "因为…滋养新的生命，记忆。死亡，只是一次「记忆」的失去。",
            "nextDialogs": [
              "730663123"
            ]
          },
          "730663123": {
            "id": "730663123",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "所以…我们的牺牲，请你见证，请你留在记忆与梦里。"
          }
        }
      }
    },

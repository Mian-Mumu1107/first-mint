    {
      "subId": "7306636",
      "subQuestName": "与兰那罗们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730663601"
        ],
        "dialogs": {
          "730663601": {
            "id": "730663601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊…你看，灵药调配好了呢…",
            "nextDialogs": [
              "730663604"
            ]
          },
          "730663604": {
            "id": "730663604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…！",
            "nextDialogs": [
              "730663605"
            ]
          },
          "730663605": {
            "id": "730663605",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "完成了，我们！在这里，「兰赫玛」！",
            "nextDialogs": [
              "730663606"
            ]
          },
          "730663606": {
            "id": "730663606",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "请你好好保管她，接下来，我们去献上灵药吧，向「阎迦由玛」。",
            "nextDialogs": [
              "730663607"
            ]
          },
          "730663607": {
            "id": "730663607",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "请你好好保管呀！一起拯救我们的梦园，「无郁夷摩」的梦。",
            "nextDialogs": [
              "730663608"
            ]
          },
          "730663608": {
            "id": "730663608",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "嗯，嗯！兰迦鲁想说的也是一样！"
          }
        }
      }
    },

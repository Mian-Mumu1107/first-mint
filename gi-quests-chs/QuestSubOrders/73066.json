    {
      "subId": "7306616",
      "subQuestName": "与兰纳迦对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730661601"
        ],
        "dialogs": {
          "730661601": {
            "id": "730661601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「耶然草」，就在这里啦！",
            "nextDialogs": [
              "730661602"
            ]
          },
          "730661602": {
            "id": "730661602",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "让一下呀，请你们。让我说几句话，同「耶然草」一起。",
            "nextDialogs": [
              "730661603"
            ]
          },
          "730661603": {
            "id": "730661603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然说是兰纳迦的园地，但这里只有一棵耶然草呢…",
            "nextDialogs": [
              "730661604"
            ]
          },
          "730661604": {
            "id": "730661604",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "有许多，曾经。每当月亮升与落，来与去的时候，都有一棵「耶然草」生长出来…",
            "nextDialogs": [
              "730661605"
            ]
          },
          "730661605": {
            "id": "730661605",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "但它来了，「无留陀」。随着「无留陀」徙来的是行走的蕈类，只知道吃啊吃。死去了，许多「耶然草」。留下的只有这一棵。",
            "nextDialogs": [
              "730661606"
            ]
          },
          "730661606": {
            "id": "730661606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那用「野人草」做了「兰赫玛」以后，你们该怎么办呢？",
            "nextDialogs": [
              "730661607"
            ]
          },
          "730661607": {
            "id": "730661607",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "是「耶然草」，白蘑菇笨笨。但笨笨不必担心。重要的种子，「阎迦由玛」保存着；「无郁夷摩」的大门，「阎迦由玛」看守着。",
            "nextDialogs": [
              "730661608"
            ]
          },
          "730661608": {
            "id": "730661608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样啊…",
            "nextDialogs": [
              "730661611"
            ]
          },
          "730661611": {
            "id": "730661611",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "兰纳迦同植物私语了一会…",
            "nextDialogs": [
              "730661612"
            ]
          },
          "730661612": {
            "id": "730661612",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "愿意成为「兰赫玛」，他说。",
            "nextDialogs": [
              "730661613"
            ]
          },
          "730661613": {
            "id": "730661613",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "还有…谢谢你们。",
            "nextDialogs": [
              "730661614"
            ]
          },
          "730661614": {
            "id": "730661614",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "接下来，去「阎迦由玛」吧，我们一起。",
            "nextDialogs": [
              "730661615"
            ]
          },
          "730661615": {
            "id": "730661615",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那带路吧，就请小毛豆！",
            "nextDialogs": [
              "730661616"
            ]
          },
          "730661616": {
            "id": "730661616",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "小毛豆，不是！兰纳迦！飞飞使坏！",
            "nextDialogs": [
              "730661617"
            ]
          },
          "730661617": {
            "id": "730661617",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗨呀，知道啦，没有使坏！"
          }
        }
      }
    },
    {
      "subId": "7306617",
      "subQuestName": "返回兰纳迦的小小园圃",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7306618",
      "subQuestName": "与兰纳迦对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730661801"
        ],
        "dialogs": {
          "730661801": {
            "id": "730661801",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "在这里啦，「阎迦由玛」！",
            "nextDialogs": [
              "730661802"
            ]
          },
          "730661802": {
            "id": "730661802",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "那菈法留纳的记忆之杯，生长在这里，所以名字是「阎迦由玛」。「阎迦由玛」看护着「无郁夷摩」，所以不能进去，那些使坏的家伙。",
            "nextDialogs": [
              "730661803"
            ]
          },
          "730661803": {
            "id": "730661803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是…在哪里呀，你说的「无留陀」？",
            "nextDialogs": [
              "730661805",
              "730661807"
            ]
          },
          "730661805": {
            "id": "730661805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么你说话也变成这样了…",
            "nextDialogs": [
              "730661808"
            ]
          },
          "730661808": {
            "id": "730661808",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "「无留陀」渗入了「无郁夷摩」。所以要将灵药「兰赫玛」注入「阎迦由玛」。",
            "nextDialogs": [
              "730661809"
            ]
          },
          "730661809": {
            "id": "730661809",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "他会为我们打开「道路」，等「阎迦由玛」记起了一切。然后我们进去，拯救「无郁夷摩」。",
            "nextDialogs": [
              "730661810"
            ]
          },
          "730661810": {
            "id": "730661810",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那是什么，「兰赫玛」？",
            "nextDialogs": [
              "730661811"
            ]
          },
          "730661811": {
            "id": "730661811",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "记忆的精华，驱除死亡的使者，灵药「兰赫玛」。承载了我们的记忆，承载了我们生命的气力，灵药「兰赫玛」。",
            "nextDialogs": [
              "730661812"
            ]
          },
          "730661812": {
            "id": "730661812",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "配制「兰赫玛」，需要三种草木：「耶然草」，以及他的伙伴「钵参花」与「须罗蕈」。",
            "nextDialogs": [
              "730661813"
            ]
          },
          "730661813": {
            "id": "730661813",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "在月光下，宝贵的「记忆」，让他们提炼出来，灵药才能完整。",
            "nextDialogs": [
              "730661814"
            ]
          },
          "730661814": {
            "id": "730661814",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "「兰赫玛」献上之后，「阎迦由玛」就会醒来，然后，我们的「记忆」流出来，流动在森林中。",
            "nextDialogs": [
              "730661815"
            ]
          },
          "730661815": {
            "id": "730661815",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "「无郁夷摩」，就可以拯救。",
            "nextDialogs": [
              "730661816"
            ]
          },
          "730661816": {
            "id": "730661816",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「记忆」…",
            "nextDialogs": [
              "730661817"
            ]
          },
          "730661817": {
            "id": "730661817",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "那菈的语言，我不会用。「记忆」，死的，凝固的，很多那菈以为。「记忆」会失去，很多那菈以为。",
            "nextDialogs": [
              "730661818"
            ]
          },
          "730661818": {
            "id": "730661818",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "但其实是活的，流动的，不会消失的…需要滋养才行。",
            "nextDialogs": [
              "730661819"
            ]
          },
          "730661819": {
            "id": "730661819",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "有「梦」，因为有「记忆」。「记忆」被滋养，所以有「生命」。",
            "nextDialogs": [
              "730661820"
            ]
          },
          "730661820": {
            "id": "730661820",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "所以，才能长出来，驱赶「无留陀」的东西…",
            "nextDialogs": [
              "730661821"
            ]
          },
          "730661821": {
            "id": "730661821",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "唔…是那菈的词语，卡住了，我不会说。"
          },
          "730661807": {
            "id": "730661807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要你管啦！"
          }
        }
      }
    },
    {
      "subId": "7306619",
      "subQuestName": "等到月上中天之时（23点到1点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

        "dialogs": {}
      }
    },
    {
      "subId": "2103304",
      "subQuestName": "与岚姐对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210330401"
        ],
        "dialogs": {
          "210330401": {
            "id": "210330401",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "怎么样，旅行者？这次你找到什么东西了吗？",
            "nextDialogs": [
              "210330402"
            ]
          },
          "210330402": {
            "id": "210330402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了这个剑柄…"
          }
        }
      }
    },
    {
      "subId": "2103306",
      "subQuestName": "与岚姐对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210330403"
        ],
        "dialogs": {
          "210330403": {
            "id": "210330403",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "这剑柄…倒是还算完整。",
            "nextDialogs": [
              "210330404"
            ]
          },
          "210330404": {
            "id": "210330404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它和「藏锋」有关吗？",
            "nextDialogs": [
              "210330405"
            ]
          },
          "210330405": {
            "id": "210330405",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "我还要仔细分辨后才知道…喔，忘了告诉你，我前段时间就开始四处搜集武器的碎片了。",
            "nextDialogs": [
              "210330406"
            ]
          },
          "210330406": {
            "id": "210330406",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "我从市场上，野外，还有冒险家的手里得到了不少碎片，想着也许能从这方面找到「藏锋」的线索…",
            "nextDialogs": [
              "210330407"
            ]
          },
          "210330407": {
            "id": "210330407",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "但直到现在，我也没能找到它的任何踪迹…",
            "nextDialogs": [
              "210330408"
            ]
          },
          "210330408": {
            "id": "210330408",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "没关系，我们璃月有句话叫「有志者，事竟成」，我还是会一直找下去…直到找到「藏锋」。",
            "nextDialogs": [
              "210330409"
            ]
          },
          "210330409": {
            "id": "210330409",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "啊，这些报酬给你，辛苦你了，旅行者。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2103301",
      "subQuestName": "与岚姐对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210330101"
        ],
        "dialogs": {
          "210330101": {
            "id": "210330101",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "不知道…这个思路能不能管用…",
            "nextDialogs": [
              "210330102"
            ]
          },
          "210330102": {
            "id": "210330102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还在找那把剑吗？",
            "nextDialogs": [
              "210330103"
            ]
          },
          "210330103": {
            "id": "210330103",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "旅行者？是你啊…是的，我还在找那把「藏锋」呢。",
            "nextDialogs": [
              "210330104"
            ]
          },
          "210330104": {
            "id": "210330104",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "但到现在，我也没有找到什么有价值的线索。",
            "nextDialogs": [
              "210330105"
            ]
          },
          "210330105": {
            "id": "210330105",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "不过这也是没办法的事，毕竟在整个璃月寻找一把剑…实在是太难了。",
            "nextDialogs": [
              "210330106"
            ]
          },
          "210330106": {
            "id": "210330106",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "有人和我说，那把剑也许早就被魔物毁了…但即使它碎了，我也要把所有碎片都找到。",
            "nextDialogs": [
              "210330107"
            ]
          },
          "210330107": {
            "id": "210330107",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "抱歉，自顾自地说了这么多。这次的委托地点我已经标在你的地图上了，拜托你了，旅行者。",
            "nextDialogs": [
              "210330108"
            ]
          },
          "210330108": {
            "id": "210330108",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "希望…那把剑不要真的碎了…"
          }
        }
      }
    },

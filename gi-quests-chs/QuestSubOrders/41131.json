    {
      "subId": "4113122",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411310101"
        ],
        "dialogs": {
          "411310101": {
            "id": "411310101",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "嗯…不错，这生意准能大赚一笔。但是还有个小问题…",
            "nextDialogs": [
              "411310102"
            ]
          },
          "411310102": {
            "id": "411310102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么问题？",
            "nextDialogs": [
              "411310103"
            ]
          },
          "411310103": {
            "id": "411310103",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "嗯？哦…旅行者，是你啊，你来得正好！你有兴趣参与一场…一场…",
            "nextDialogs": [
              "411310107"
            ]
          },
          "411310107": {
            "id": "411310107",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "一场…神奇的…伟大的…前所未有，必定能大赚特赚的生意吗？",
            "nextDialogs": [
              "411310108"
            ]
          },
          "411310108": {
            "id": "411310108",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "只需要你帮我一个小小的忙。我们俩必然都能赚得盆满钵满。",
            "nextDialogs": [
              "411310105",
              "411310110"
            ]
          },
          "411310105": {
            "id": "411310105",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "啊，那是当然，连守卫都是至冬国人，我…不！不，您在想什么？",
            "nextDialogs": [
              "411310106"
            ]
          },
          "411310106": {
            "id": "411310106",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "看来四处旅行确实让您的思维开阔了不少，您的想法实在是颇富想象力。",
            "nextDialogs": [
              "411310112"
            ]
          },
          "411310112": {
            "id": "411310112",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "但我这次的生意计划，绝对是脚踏实地的扎实计划。",
            "nextDialogs": [
              "411310113"
            ]
          },
          "411310113": {
            "id": "411310113",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "您知道最近从天而降的那些陨石吗？",
            "nextDialogs": [
              "411310114"
            ]
          },
          "411310114": {
            "id": "411310114",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "我想要去找到一块陨石，从上面敲下来几块带回来。",
            "nextDialogs": [
              "411310115"
            ]
          },
          "411310115": {
            "id": "411310115",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "然后，再找个能工巧匠，将它雕刻琢磨，制成首饰…",
            "nextDialogs": [
              "411310116"
            ]
          },
          "411310116": {
            "id": "411310116",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "一副由陨石制成的首饰…无论是戒指、项链、手环还是耳环，准能让那些有钱人们爽快掏钱。",
            "nextDialogs": [
              "411310117"
            ]
          },
          "411310117": {
            "id": "411310117",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "旅行者，你要做的事很简单，只要保证我不受怪物干扰就行了。",
            "nextDialogs": [
              "411310118"
            ]
          },
          "411310118": {
            "id": "411310118",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "怎么样，我们俩就此成交？",
            "nextDialogs": [
              "411310119"
            ]
          },
          "411310119": {
            "id": "411310119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "绝不能接近陨石。",
            "nextDialogs": [
              "411310120"
            ]
          },
          "411310120": {
            "id": "411310120",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "什么？为什么，这笔大生意我绝不会放过。"
          },
          "411310110": {
            "id": "411310110",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "唔，老实说，璃月的法典颇为严谨，几乎没有漏洞，但…",
            "nextDialogs": [
              "411310111"
            ]
          },
          "411310111": {
            "id": "411310111",
            "speakerId": 1000,
            "speakerName": "伊凡诺维奇",
            "text": "呃，不！不，我做的事，绝对是在法典允许的范围内。"
          }
        }
      }
    }
  ]
}
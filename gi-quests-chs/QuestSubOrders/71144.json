    {
      "subId": "7114403",
      "subQuestName": "询问情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711440301"
        ],
        "dialogs": {
          "711440301": {
            "id": "711440301",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "#这磐石雕琢般的面相，还有卓尔不群的气场…你想必就是传闻中的将才{NICKNAME}吧？",
            "nextDialogs": [
              "711440302"
            ]
          },
          "711440302": {
            "id": "711440302",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "久仰大名。我正想委托冒险家协会致信你，请你参会，没想到你有所察觉，直接来到了现场。",
            "nextDialogs": [
              "711440305"
            ]
          },
          "711440305": {
            "id": "711440305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#说得好正经！感觉像是把{NICKNAME}当成了…特别专业的战士？",
            "nextDialogs": [
              "711440306"
            ]
          },
          "711440306": {
            "id": "711440306",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "不止是战士，你们游历五国期间，曾与不可计数的魔物和强者交手，相关情报被各国部队重点记录，反复分析。",
            "nextDialogs": [
              "711440307"
            ]
          },
          "711440307": {
            "id": "711440307",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "无论西风骑士团，千岩军，幕府武士，三十人团和执律庭，每支作战部队都对你的战力和谋略给予了顶尖的评价——",
            "nextDialogs": [
              "711440308"
            ]
          },
          "711440308": {
            "id": "711440308",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "#「{NICKNAME}的才能足以胜任前线作战到后方指挥的一切事务，如有可能，定要与其积极合作。」",
            "nextDialogs": [
              "711440309"
            ]
          },
          "711440309": {
            "id": "711440309",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "因此，我苏定代表千岩军的参谋部门，正式邀请你参与我们的五方联合推演，出任高级顾问，不知你意下如何？",
            "nextDialogs": [
              "711440310"
            ]
          },
          "711440310": {
            "id": "711440310",
            "speakerId": 1000,
            "speakerName": "苏定",
            "text": "高级顾问的酬劳相当可观，参会期间的综合日薪将与千岩军教头平级。",
            "nextDialogs": [
              "711440311"
            ]
          },
          "711440311": {
            "id": "711440311",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不愧是千岩军，说话真是直截了当…教头级别的报酬，听起来也很诱人…"
          }
        }
      }
    }
  ]
}
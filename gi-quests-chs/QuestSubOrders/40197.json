  },
  "subQuests": [
    {
      "subId": "4019701",
      "subQuestName": "等待到第二天上午（8点-10点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401970101"
        ],
        "dialogs": {
          "401970101": {
            "id": "401970101",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "我认为，当事情发展到如此地步，我们应当加入——",
            "nextDialogs": [
              "401970102"
            ]
          },
          "401970102": {
            "id": "401970102",
            "speakerId": 1001,
            "speakerName": "爱可菲",
            "text": "盐？",
            "nextDialogs": [
              "401970103"
            ]
          },
          "401970103": {
            "id": "401970103",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "不。胡椒。",
            "nextDialogs": [
              "401970104"
            ]
          },
          "401970104": {
            "id": "401970104",
            "speakerId": 1001,
            "speakerName": "爱可菲",
            "text": "哦！精妙！",
            "nextDialogs": [
              "401970105"
            ]
          },
          "401970105": {
            "id": "401970105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯？",
            "nextDialogs": [
              "401970106"
            ]
          },
          "401970106": {
            "id": "401970106",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "二位这是在研究什么，新的甜品菜单吗？",
            "nextDialogs": [
              "401970107"
            ]
          },
          "401970107": {
            "id": "401970107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "甜品里不该有胡椒吧。",
            "nextDialogs": [
              "401970108"
            ]
          },
          "401970108": {
            "id": "401970108",
            "speakerId": 1001,
            "speakerName": "爱可菲",
            "text": "不是甜品哦。",
            "nextDialogs": [
              "401970109"
            ]
          },
          "401970109": {
            "id": "401970109",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "是剧本。",
            "nextDialogs": [
              "401970110"
            ]
          },
          "401970110": {
            "id": "401970110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "欸？",
            "nextDialogs": [
              "401970111"
            ]
          },
          "401970111": {
            "id": "401970111",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "我亲爱的伙伴，摄影师，新人导演！在映影爱好者们满溢的爱中，创作永远不会停止。",
            "nextDialogs": [
              "401970112"
            ]
          },
          "401970112": {
            "id": "401970112",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "我的舞台上，平淡的剧本禁止登场。转折应如漫天落下的胡椒粉，让观众们连连打上喷嚏才对。",
            "nextDialogs": [
              "401970113"
            ]
          },
          "401970113": {
            "id": "401970113",
            "speakerId": 1001,
            "speakerName": "爱可菲",
            "text": "不只是映影，餐盘亦是舞台！",
            "nextDialogs": [
              "401970114"
            ]
          },
          "401970114": {
            "id": "401970114",
            "speakerId": 1001,
            "speakerName": "爱可菲",
            "text": "之前听艾梅莉埃小姐说过，胡椒是可以应用在调香技艺中的…那么，或许甜品也可以…",
            "nextDialogs": [
              "401970115"
            ]
          },
          "401970115": {
            "id": "401970115",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "喔！胡椒的刺激，也许更能衬托奶油的甜美呢？",
            "nextDialogs": [
              "401970116"
            ]
          },
          "401970116": {
            "id": "401970116",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇，总觉得她们两个在创作上很合得来呢…",
            "nextDialogs": [
              "401970117"
            ]
          },
          "401970117": {
            "id": "401970117",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "虽然我是想象不出胡椒蛋糕会是什么味道啦！",
            "nextDialogs": [
              "401970118"
            ]
          },
          "401970118": {
            "id": "401970118",
            "speakerId": 1003,
            "speakerName": "娜维娅",
            "text": "什么什么？爱可菲要做新蛋糕了吗？",
            "nextDialogs": [
              "401970119"
            ]
          },
          "401970119": {
            "id": "401970119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "胡椒蛋糕，糊糊焦焦。",
            "nextDialogs": [
              "401970120"
            ]
          },
          "401970120": {
            "id": "401970120",
            "speakerId": 1003,
            "speakerName": "娜维娅",
            "text": "这么刺激！等做出来了，请务必给我尝尝！",
            "nextDialogs": [
              "401970121"
            ]
          },
          "401970121": {
            "id": "401970121",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "是我的错觉吗？总觉得工作完成之后，大家的热情反而更加高涨了？",
            "nextDialogs": [
              "401970122"
            ]
          },
          "401970122": {
            "id": "401970122",
            "speakerId": 1003,
            "speakerName": "娜维娅",
            "text": "为什么不呢？努力有了成果，才正是最应该开心的时刻呀。",
            "nextDialogs": [
              "401970123"
            ]
          },
          "401970123": {
            "id": "401970123",
            "speakerId": 1003,
            "speakerName": "娜维娅",
            "text": "就像新鲜出炉的马卡龙，不要因为畏惧甜度而不舍得加料。",
            "nextDialogs": [
              "401970124"
            ]
          },
          "401970124": {
            "id": "401970124",
            "speakerId": 1003,
            "speakerName": "娜维娅",
            "text": "马卡龙，就是要狠狠放糖！",
            "nextDialogs": [
              "401970125"
            ]
          },
          "401970125": {
            "id": "401970125",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "狠狠放糖！",
            "nextDialogs": [
              "401970126"
            ]
          },
          "401970126": {
            "id": "401970126",
            "speakerId": 1004,
            "speakerName": "乐平波琳",
            "text": "狠狠放糖！",
            "nextDialogs": [
              "401970127"
            ]
          },
          "401970127": {
            "id": "401970127",
            "speakerId": 1004,
            "speakerName": "乐平波琳",
            "text": "…呃，是要放什么糖？",
            "nextDialogs": [
              "401970128"
            ]
          },
          "401970128": {
            "id": "401970128",
            "speakerId": 1003,
            "speakerName": "娜维娅",
            "text": "乐平波琳，你来啦！东西完成了吗？",
            "nextDialogs": [
              "401970129"
            ]
          },
          "401970129": {
            "id": "401970129",
            "speakerId": 1004,
            "speakerName": "乐平波琳",
            "text": "当然当然，一切顺利！",
            "nextDialogs": [
              "401970130"
            ]
          },
          "401970130": {
            "id": "401970130",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸？乐平波琳是去做什么重要任务了吗？",
            "nextDialogs": [
              "401970131"
            ]
          },
          "401970131": {
            "id": "401970131",
            "speakerId": 1004,
            "speakerName": "乐平波琳",
            "text": "对的对的，这个给你，请务必收下！",
            "nextDialogs": [
              "401970132"
            ]
          },
          "401970132": {
            "id": "401970132",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是…",
            "nextDialogs": [
              "401970133"
            ]
          },
          "401970133": {
            "id": "401970133",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哇，好厉害！是展会的全景图，上面还有大家的图案呢！",
            "nextDialogs": [
              "401970134"
            ]
          },
          "401970134": {
            "id": "401970134",
            "speakerId": 1003,
            "speakerName": "娜维娅",
            "text": "嘿嘿，鉴于映影欢乐城大获成功，我们一起商量着，想要制作一份独特的纪念品。",
            "nextDialogs": [
              "401970135"
            ]
          },
          "401970135": {
            "id": "401970135",
            "speakerId": 1003,
            "speakerName": "娜维娅",
            "text": "这座欢乐城是由大家一砖一瓦搭建成功的，就像大家一笔一划画出的这份地图一样。",
            "nextDialogs": [
              "401970136"
            ]
          },
          "401970136": {
            "id": "401970136",
            "speakerId": 1001,
            "speakerName": "爱可菲",
            "text": "虽然主要都是由擅长绘图的乐平波琳小姐完成的啦，但我们每个人也都尽力在上面加了自己的笔墨哦。",
            "nextDialogs": [
              "401970137"
            ]
          },
          "401970137": {
            "id": "401970137",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "没错。",
            "nextDialogs": [
              "401970138"
            ]
          },
          "401970138": {
            "id": "401970138",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "#而且不仅如此，{NICKNAME}，我要给你一份特权。",
            "nextDialogs": [
              "401970139"
            ]
          },
          "401970139": {
            "id": "401970139",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "——你将拥有给我的头像上添加胡子的权利！"
          }
        }
      }
    },
    {
      "subId": "4019706",
      "subQuestName": "在映影欢乐城与大家会合",
      "sceneId": null,
      "locations": [],

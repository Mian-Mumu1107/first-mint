    },
    {
      "subId": "4019702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401970201"
        ],
        "dialogs": {
          "401970201": {
            "id": "401970201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真棒，我要画<color=#C4D6EAFF>白色的</color>。",
            "nextDialogs": [
              "401970202"
            ]
          },
          "401970202": {
            "id": "401970202",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "奶油味胡子吗…非常传统，但非常好吃。嗯，我准许了。",
            "nextDialogs": [
              "401970401"
            ]
          },
          "401970401": {
            "id": "401970401",
            "speakerId": 1003,
            "speakerName": "娜维娅",
            "text": "#好啦，既然这份纪念地图已经是{NICKNAME}的所有物，那你想画多少不同口味的胡子都可以。",
            "nextDialogs": [
              "401970402"
            ]
          },
          "401970402": {
            "id": "401970402",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嘿嘿，听起来是很好吃的地图，我们会好好收藏的！",
            "nextDialogs": [
              "401970403"
            ]
          },
          "401970403": {
            "id": "401970403",
            "speakerId": 1003,
            "speakerName": "娜维娅",
            "text": "你们喜欢就再好不过啦。",
            "nextDialogs": [
              "401970404"
            ]
          },
          "401970404": {
            "id": "401970404",
            "speakerId": 1003,
            "speakerName": "娜维娅",
            "text": "乐园各方面的情况都已经很完善了，接下来就请忘记工作的疲惫，尽情游玩吧！"
          }
        }
      }
    },
    {
      "subId": "4019703",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401970301"
        ],
        "dialogs": {
          "401970301": {
            "id": "401970301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真棒，我要画<color=#E77E70FF>红色的</color>。",
            "nextDialogs": [
              "401970302"
            ]
          },
          "401970302": {
            "id": "401970302",
            "speakerId": 1000,
            "speakerName": "芙宁娜",
            "text": "番茄肉酱味道的吗…意想不到的展开啊，这局你赢。"
          }
        }
      }
    }
  ]
}
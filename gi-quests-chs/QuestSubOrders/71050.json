    {
      "subId": "7105002",
      "subQuestName": "收集8只发光的蘑菇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710500201"
        ],
        "dialogs": {
          "710500201": {
            "id": "710500201",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "收集齐了吗？牛"
          }
        }
      }
    },
    {
      "subId": "7105003",
      "subQuestName": "将采摘到的发光蘑菇交给海迪夫进行鉴定",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710500701"
        ],
        "dialogs": {
          "710500701": {
            "id": "710500701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "蘑菇采回来了。",
            "nextDialogs": [
              "710500702"
            ]
          },
          "710500702": {
            "id": "710500702",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "嗯嗯，多谢多谢。",
            "nextDialogs": [
              "710500703"
            ]
          },
          "710500703": {
            "id": "710500703",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "有了你的帮助，我的调查就像是…有句璃月话是怎么说的来着，「就像猛虎插上了翅膀一样顺利」。",
            "nextDialogs": [
              "710500704"
            ]
          },
          "710500704": {
            "id": "710500704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "如虎添翼？",
            "nextDialogs": [
              "710500705"
            ]
          },
          "710500705": {
            "id": "710500705",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "对，简直就是如虎添翼。",
            "nextDialogs": [
              "710500706"
            ]
          },
          "710500706": {
            "id": "710500706",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "这些菌类，怎么会这样呢…",
            "nextDialogs": [
              "710500707"
            ]
          },
          "710500707": {
            "id": "710500707",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "这可奇怪了，这种菌类和须弥的一种菌类简直就是一模一样，但怎么会发光呢，在黑暗中生长所以长出了荧光素？",
            "nextDialogs": [
              "710500708"
            ]
          },
          "710500708": {
            "id": "710500708",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "但是既然已经进化出荧光素，为什么菌类的本体什么变化都没有？",
            "nextDialogs": [
              "710500711"
            ]
          },
          "710500711": {
            "id": "710500711",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "嗯…简单来说，菌类会适应环境进化，但是这种真菌的本体，显然是更适合生长在森林环境的品种。",
            "nextDialogs": [
              "710500712"
            ]
          },
          "710500712": {
            "id": "710500712",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "所以，这种真菌本来是生长在须弥的，这点毋庸置疑。",
            "nextDialogs": [
              "710500713"
            ]
          },
          "710500713": {
            "id": "710500713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那发光是…",
            "nextDialogs": [
              "710500714"
            ]
          },
          "710500714": {
            "id": "710500714",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "真菌不是层岩巨渊的原生种，就说明发光不是进化产物，而是非正常生态影响导致的…",
            "nextDialogs": [
              "710500715"
            ]
          },
          "710500715": {
            "id": "710500715",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "大概因为那个天上掉下来的碎块吧，吸收了它的能量…"
          }
        }
      }
    }
  ]
}
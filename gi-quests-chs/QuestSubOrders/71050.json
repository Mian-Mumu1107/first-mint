  "subQuests": [
    {
      "subId": "7105004",
      "subQuestName": "test隐藏判断玩家在地下$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710500401"
        ],
        "dialogs": {
          "710500401": {
            "id": "710500401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于这种蘑菇…",
            "nextDialogs": [
              "710500402"
            ]
          },
          "710500402": {
            "id": "710500402",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "该说真不愧是经验丰富的冒险家吗，这么快就有所发现了。",
            "nextDialogs": [
              "710500403"
            ]
          },
          "710500403": {
            "id": "710500403",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "嗯？这确定是在这里采摘的菌类吗，这可有点奇怪啊…",
            "nextDialogs": [
              "710500404"
            ]
          },
          "710500404": {
            "id": "710500404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "地下不能长蘑菇吗？",
            "nextDialogs": [
              "710500405"
            ]
          },
          "710500405": {
            "id": "710500405",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "也不是不能长的问题。",
            "nextDialogs": [
              "710500406"
            ]
          },
          "710500406": {
            "id": "710500406",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "只是因为这个菌和生长在须弥的一种菌很像…",
            "nextDialogs": [
              "710500407"
            ]
          },
          "710500407": {
            "id": "710500407",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "只有一种不太够啊…如果有足够多的样本，说不定就能看出些什么。",
            "nextDialogs": [
              "710500408"
            ]
          },
          "710500408": {
            "id": "710500408",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "足够多的样本啊…这个既然也是你拿回来的，肯定知道在哪里还有…不如你帮我采点吧！",
            "nextDialogs": [
              "710500409"
            ]
          },
          "710500409": {
            "id": "710500409",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "你帮我采足够多的蘑菇，我给你足够多的钱作为报酬。",
            "nextDialogs": [
              "710500410"
            ]
          },
          "710500410": {
            "id": "710500410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "足够多是多少蘑菇？",
            "nextDialogs": [
              "710500411"
            ]
          },
          "710500411": {
            "id": "710500411",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "嗯…我想想，那就先采8个吧。",
            "nextDialogs": [
              "710500412"
            ]
          },
          "710500412": {
            "id": "710500412",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "没关系，只要你带过来，钱不会少你的！"
          }
        }
      }
    },
    {

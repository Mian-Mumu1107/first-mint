    {
      "subId": "7302104",
      "subQuestName": "取得「活源水」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730210401"
        ],
        "dialogs": {
          "730210401": {
            "id": "730210401",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "…嗯，确实是河流源头的水，「活源水」凛冽又干净，和月光一样。",
            "nextDialogs": [
              "730210402"
            ]
          },
          "730210402": {
            "id": "730210402",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "如果兰茶荼、兰萨卡和兰非拉是吸着这样的水长大的，那肯定不会变成现在这样的笨蛋。只有兰帕卡提，我的妹妹…",
            "nextDialogs": [
              "730210403"
            ]
          },
          "730210403": {
            "id": "730210403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咳咳，接下来…",
            "nextDialogs": [
              "730210404"
            ]
          },
          "730210404": {
            "id": "730210404",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "嗯？对了，接下来，你们要做一锅汤赔给我…",
            "nextDialogs": [
              "730210405"
            ]
          },
          "730210405": {
            "id": "730210405",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "在兰阿帕斯的指导下，在水中加入了一些蔬果，开始烹饪。\\n锅中慢慢传出了不错的香味。",
            "nextDialogs": [
              "730210406"
            ]
          },
          "730210406": {
            "id": "730210406",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "完成后，一同品尝了刚刚做好的「汤」。\\n…应该说是符合预期吧，虽然确实有食材的香味…\\n但没有任何调味的汤果然还是太纯粹了。\\n一点味道也没有。",
            "nextDialogs": [
              "730210407"
            ]
          },
          "730210407": {
            "id": "730210407",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "嗯嗯，「至上珍馐」当然就是要有这样的香味才对！",
            "nextDialogs": [
              "730210408"
            ]
          },
          "730210408": {
            "id": "730210408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯…你觉得呢，{NICKNAME}？",
            "nextDialogs": [
              "730210411"
            ]
          },
          "730210411": {
            "id": "730210411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我觉得，如果加点盐和胡椒，应该会比较美味。",
            "nextDialogs": [
              "730210412"
            ]
          },
          "730210412": {
            "id": "730210412",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "任何东西加盐和胡椒都会变得美味。",
            "nextDialogs": [
              "730210413"
            ]
          },
          "730210413": {
            "id": "730210413",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "兰穆护昆达在上！竟然要加盐…盐是多么可怕的东西！",
            "nextDialogs": [
              "730210414"
            ]
          },
          "730210414": {
            "id": "730210414",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "有盐的土地上，就没有生命，兰那罗只能退缩成干种子…那菈竟然要放盐！",
            "nextDialogs": [
              "730210415"
            ]
          },
          "730210415": {
            "id": "730210415",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "汤没有味道，是理所应当的！你们这些那菈，竟然不懂这样的道理。",
            "nextDialogs": [
              "730210416"
            ]
          },
          "730210416": {
            "id": "730210416",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "以前那个那菈，喝了汤以后，就告诉过我们这样的道理：",
            "nextDialogs": [
              "730210417"
            ]
          },
          "730210417": {
            "id": "730210417",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "「我们那菈呀，到了孩子们要回家的时候，家里都会传来汤的香味。所以，汤只需要有香味。」",
            "nextDialogs": [
              "730210418"
            ]
          },
          "730210418": {
            "id": "730210418",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "#然后，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}夸我兰阿帕斯的汤做得很好，很香。我一直记得。所以，我才不信你说的！",
            "nextDialogs": [
              "730210419"
            ]
          },
          "730210419": {
            "id": "730210419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但只有香味也不行吧…",
            "nextDialogs": [
              "730210420"
            ]
          },
          "730210420": {
            "id": "730210420",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "……",
            "nextDialogs": [
              "730210421"
            ]
          },
          "730210421": {
            "id": "730210421",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "哼，不过既然你们是这次无忧节的那菈，那一定是兰拉迦、兰帕卡提他们认可的。没办法，就想办法做有味道的汤吧。",
            "nextDialogs": [
              "730210422"
            ]
          },
          "730210422": {
            "id": "730210422",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "那下次就找更好的水来做汤，一定能做出更好的汤！",
            "nextDialogs": [
              "730210423"
            ]
          },
          "730210423": {
            "id": "730210423",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…我倒觉得和水没关系。",
            "nextDialogs": [
              "730210424"
            ]
          },
          "730210424": {
            "id": "730210424",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "是嘛…不过这次的「烹饪修行」已经圆满结束了。好，一切都等到无忧节再说吧！",
            "nextDialogs": [
              "730210425"
            ]
          },
          "730210425": {
            "id": "730210425",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "做汤的办法也教给你们了。这可是伟大那菈认可的味道，你们多尝尝吧。但是，记住：一定要用好水！",
            "nextDialogs": [
              "730210426"
            ]
          },
          "730210426": {
            "id": "730210426",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#({NICKNAME}，下次我们加点调味料试试吧。味道应该会不错…）"
          }
        }
      }
    },
    {
      "subId": "7302105",
      "subQuestName": "将「活源水」带给兰阿帕斯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

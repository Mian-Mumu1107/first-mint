  "subQuests": [
    {
      "subId": "7302101",
      "subQuestName": "寻找兰阿帕斯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730210101"
        ],
        "dialogs": {
          "730210101": {
            "id": "730210101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，这个锅里炖的是什么呀，闻上去真香。只是闻着，口水就不停流下来了…",
            "nextDialogs": [
              "730210102"
            ]
          },
          "730210102": {
            "id": "730210102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像是什么汤的样子，嗯…也看不出来是用什么材料做的…",
            "nextDialogs": [
              "730210103"
            ]
          },
          "730210103": {
            "id": "730210103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哎呀，{NICKNAME}…",
            "nextDialogs": [
              "730210104"
            ]
          },
          "730210104": {
            "id": "730210104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "730210105"
            ]
          },
          "730210105": {
            "id": "730210105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你看现在，炖汤的人也不在，这个汤这么香，我们不如偷偷喝上一口尝一尝吧。",
            "nextDialogs": [
              "730210107",
              "730210109"
            ]
          },
          "730210107": {
            "id": "730210107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶！",
            "nextDialogs": [
              "730210112"
            ]
          },
          "730210112": {
            "id": "730210112",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "锅容量比看上去的要小。\\n里面的内容物就这样全部不见了。",
            "nextDialogs": [
              "730210113"
            ]
          },
          "730210113": {
            "id": "730210113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噗哈…嗯？这个汤，香倒是很香，但是怎么感觉尝不出什么味道呢…",
            "nextDialogs": [
              "730210114"
            ]
          },
          "730210114": {
            "id": "730210114",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "兰穆护昆达在上！你们这些那菈，怎么回事！",
            "nextDialogs": [
              "730210115"
            ]
          },
          "730210115": {
            "id": "730210115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰、兰那罗？到底是从哪里突然出现的！",
            "nextDialogs": [
              "730210116"
            ]
          },
          "730210116": {
            "id": "730210116",
            "speakerId": 16765,
            "speakerName": "兰阿帕斯",
            "text": "从地里啦！不说这个，你们怎么能偷喝我做的汤，那可是我兰阿帕斯辛辛苦苦做出来的汤耶！"
          },
          "730210109": {
            "id": "730210109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我是真的很好奇嘛，呜，我就偷偷喝一口，就一口！",
            "nextDialogs": [
              "730210110"
            ]
          },
          "730210110": {
            "id": "730210110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要是喝坏肚子就不好了…",
            "nextDialogs": [
              "730210111"
            ]
          },
          "730210111": {
            "id": "730210111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，可不要小看派蒙！"
          }
        }
      }
    },
    {
      "subId": "7302102",
      "subQuestName": "调查飘出香味的锅",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

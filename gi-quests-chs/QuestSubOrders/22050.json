    {
      "subId": "2205002",
      "subQuestName": "前往鸣神大社附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220500201"
        ],
        "dialogs": {
          "220500201": {
            "id": "220500201",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "「鸣神大社」…就是这里吗？",
            "nextDialogs": [
              "220500202"
            ]
          },
          "220500202": {
            "id": "220500202",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "红色的门有好多。人类很喜欢红色的门吗？",
            "nextDialogs": [
              "220500203"
            ]
          },
          "220500203": {
            "id": "220500203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这个叫「鸟居」。",
            "nextDialogs": [
              "220500204"
            ]
          },
          "220500204": {
            "id": "220500204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "浅濑神社也有呢。",
            "nextDialogs": [
              "220500205"
            ]
          },
          "220500205": {
            "id": "220500205",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "哦哦奴家明白了，原来那就是「鸟居」啊。也就是鸟居住的地方对吧。",
            "nextDialogs": [
              "220500206"
            ]
          },
          "220500206": {
            "id": "220500206",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "所以鸟居越多，鸟就越多吧。鸟，那可是好东西。人类也挺聪明的嘛。",
            "nextDialogs": [
              "220500207"
            ]
          },
          "220500207": {
            "id": "220500207",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "汝等，看见阿响在哪了吗？",
            "nextDialogs": [
              "220500208"
            ]
          },
          "220500208": {
            "id": "220500208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没发现人的踪迹…",
            "nextDialogs": [
              "220500209"
            ]
          },
          "220500209": {
            "id": "220500209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这周围，好像都没有人的样子…",
            "nextDialogs": [
              "220500210"
            ]
          },
          "220500210": {
            "id": "220500210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不如，我们上去「鸣神大社」，问问里面的那些巫女小姐吧。",
            "nextDialogs": [
              "220500211"
            ]
          },
          "220500211": {
            "id": "220500211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那位「阿响」应该也是巫女…说不定，她们会知道些什么呢。"
          }
        }
      }
    },
    {
      "subId": "2205003",
      "subQuestName": "前往鸣神大社",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220500301"
        ],
        "dialogs": {
          "220500301": {
            "id": "220500301",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "喵喵，这神社可真大，也有很多人类呢。",
            "nextDialogs": [
              "220500302"
            ]
          },
          "220500302": {
            "id": "220500302",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "喔！塞钱箱和架子也很气派，怪不得有这么多人来这里。",
            "nextDialogs": [
              "220500303"
            ]
          },
          "220500303": {
            "id": "220500303",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "汝等好好学。以后，浅濑神社也要变成这样。",
            "nextDialogs": [
              "220500306"
            ]
          },
          "220500306": {
            "id": "220500306",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "不过，还是没看到阿响哪。",
            "nextDialogs": [
              "220500307"
            ]
          },
          "220500307": {
            "id": "220500307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总、总之，我们找人问问关于「阿响」的事吧。"
          }
        }
      }
    },
    {
      "subId": "2205004",
      "subQuestName": "向稻城萤美询问信息",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220500401"
        ],
        "dialogs": {
          "220500401": {
            "id": "220500401",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "你好，远道而来的旅者，欢迎来到「鸣神大社」。",
            "nextDialogs": [
              "220500402"
            ]
          },
          "220500402": {
            "id": "220500402",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "如果有烦恼或者心愿，可以来这里求签，雷神会保佑你的。",
            "nextDialogs": [
              "220500403"
            ]
          },
          "220500403": {
            "id": "220500403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们不是来求签的，是有一件事想要请问你…",
            "nextDialogs": [
              "220500404"
            ]
          },
          "220500404": {
            "id": "220500404",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "问我？喔…那请说吧。",
            "nextDialogs": [
              "220500405"
            ]
          },
          "220500405": {
            "id": "220500405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是这样的…",
            "nextDialogs": [
              "220500406"
            ]
          },
          "220500406": {
            "id": "220500406",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "浅濑神社的…阿响？难道是「浅濑响」…",
            "nextDialogs": [
              "220500407"
            ]
          },
          "220500407": {
            "id": "220500407",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "对！阿响就是「浅濑响」，人类！汝认识阿响吗？知道她在哪里吗？",
            "nextDialogs": [
              "220500408"
            ]
          },
          "220500408": {
            "id": "220500408",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "嗯…咦？！这只猫怎么会说话，是我听错了吗…",
            "nextDialogs": [
              "220500409"
            ]
          },
          "220500409": {
            "id": "220500409",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "人类真是喜欢大惊小怪啊…奴家会说话是件很奇怪的事吗？",
            "nextDialogs": [
              "220500410"
            ]
          },
          "220500410": {
            "id": "220500410",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "汝，认识阿响吗？知道她在哪里吗？",
            "nextDialogs": [
              "220500411"
            ]
          },
          "220500411": {
            "id": "220500411",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "被一只猫这么追问，感觉还真是奇怪…",
            "nextDialogs": [
              "220500412"
            ]
          },
          "220500412": {
            "id": "220500412",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "不过，如果你们问的真的是那位「浅濑响」的话，那你们找错地方了…",
            "nextDialogs": [
              "220500413"
            ]
          },
          "220500413": {
            "id": "220500413",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "220500414"
            ]
          },
          "220500414": {
            "id": "220500414",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找错了…地方？",
            "nextDialogs": [
              "220500415"
            ]
          },
          "220500415": {
            "id": "220500415",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "我之前在神社少数保存完整的典籍里读到过她的名字。她是浅濑神社最后一代…",
            "nextDialogs": [
              "220500416"
            ]
          },
          "220500416": {
            "id": "220500416",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "大约四五百年前，曾经有「影向役者三人组」的说法。浅濑响、惟神晴之介、御舆长正曾经在影向山上，向影向天狗求学。",
            "nextDialogs": [
              "220500417"
            ]
          },
          "220500417": {
            "id": "220500417",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "期间浅濑在我们神社见习过，也与狐斋宫大人结交。不过，最后…",
            "nextDialogs": [
              "220500418"
            ]
          },
          "220500418": {
            "id": "220500418",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "三人最终似乎是在一场记事中语焉不详的「灾难」后分道扬镳了。据说，惟神渡海去了璃月，想要学习更强大的「仙家道法」。",
            "nextDialogs": [
              "220500419"
            ]
          },
          "220500419": {
            "id": "220500419",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "御舆回到了稻妻城，为幕府效力。浅濑则…",
            "nextDialogs": [
              "220500422"
            ]
          },
          "220500422": {
            "id": "220500422",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "嗯，没错。不过因为可考的史料太少，所以具体的情况也不太清楚。",
            "nextDialogs": [
              "220500423"
            ]
          },
          "220500423": {
            "id": "220500423",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等一下…",
            "nextDialogs": [
              "220500424"
            ]
          },
          "220500424": {
            "id": "220500424",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…她说四五百年前，也就是说，阿响是很久前的人。",
            "nextDialogs": [
              "220500425"
            ]
          },
          "220500425": {
            "id": "220500425",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那寝子也是有四五百岁的猫？！",
            "nextDialogs": [
              "220500426"
            ]
          },
          "220500426": {
            "id": "220500426",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "喵喵？奴家不清楚。「四五百岁」是什么意思？",
            "nextDialogs": [
              "220500427"
            ]
          },
          "220500427": {
            "id": "220500427",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "奴家又不是人。没有那么多要计较的事情，只知道太阳升起、月亮升起。如果心情不好，那睡一觉就好了。",
            "nextDialogs": [
              "220500428"
            ]
          },
          "220500428": {
            "id": "220500428",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好羡慕啊…"
          }
        }
      }
    },
    {
      "subId": "2205005",
      "subQuestName": "(test)帮寝子把信放在神像旁",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220500501"
        ],
        "dialogs": {
          "220500501": {
            "id": "220500501",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "就在这里歇歇吧，奴家也累了。",
            "nextDialogs": [
              "220500502"
            ]
          },
          "220500502": {
            "id": "220500502",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "不过，真的和阿响说的一样。",
            "nextDialogs": [
              "220500503"
            ]
          },
          "220500503": {
            "id": "220500503",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "不同的岛，真的完全不一样。而且，原来神社可以在这么高的山上。人类难道不怕高吗？",
            "nextDialogs": [
              "220500504"
            ]
          },
          "220500504": {
            "id": "220500504",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "还是奴家的浅濑神社好。",
            "nextDialogs": [
              "220500505"
            ]
          },
          "220500505": {
            "id": "220500505",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "不过，阿响到底在哪呢…",
            "nextDialogs": [
              "220500506"
            ]
          },
          "220500506": {
            "id": "220500506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还要继续找吗？",
            "nextDialogs": [
              "220500507"
            ]
          },
          "220500507": {
            "id": "220500507",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "奴家累了。以后再说吧。",
            "nextDialogs": [
              "220500508"
            ]
          },
          "220500508": {
            "id": "220500508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还有以后喔！",
            "nextDialogs": [
              "220500509"
            ]
          },
          "220500509": {
            "id": "220500509",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "那当然。阿响她对我说过好多好多故事。在海边的故事、在很多树的地方的故事、什么「狐狸大人」的故事。",
            "nextDialogs": [
              "220500510"
            ]
          },
          "220500510": {
            "id": "220500510",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "这些故事，奴家都记得很清楚。",
            "nextDialogs": [
              "220500511"
            ]
          },
          "220500511": {
            "id": "220500511",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "但现在最重要的，就是回家。毕竟，浅濑神社必须要有它的宫司才行。",
            "nextDialogs": [
              "220500512"
            ]
          },
          "220500512": {
            "id": "220500512",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "总之，汝等现在就和奴家一起回去吧。"
          }
        }
      }
    },
    {
      "subId": "2205006",
      "subQuestName": "陪寝子离开",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2205007",
      "subQuestName": "和寝子一同回到清籁岛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220500601"
        ],
        "dialogs": {
          "220500601": {
            "id": "220500601",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "呼…总算回来了，在那座神社旁边待久了，奴家的毛都要全部打卷了。",
            "nextDialogs": [
              "220500602"
            ]
          },
          "220500602": {
            "id": "220500602",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "这次多谢汝等了，汝等真是不可多得的可靠人类啊，喵喵。",
            "nextDialogs": [
              "220500603"
            ]
          },
          "220500603": {
            "id": "220500603",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "奴家就继续去打理神社了，等阿响回来之后，奴家就把汝等介绍给她。",
            "nextDialogs": [
              "220500604"
            ]
          },
          "220500604": {
            "id": "220500604",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "喵喵…",
            "nextDialogs": [
              "220500605"
            ]
          },
          "220500605": {
            "id": "220500605",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "阿响，到底什么时候才会回来呢…"
          }
        }
      }
    },
    {
      "subId": "2205007",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220500701"
        ],
        "dialogs": {
          "220500701": {
            "id": "220500701",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "您还有什么事吗？",
            "nextDialogs": [
              "220500703",
              "220500706",
              "220500711"
            ]
          },
          "220500703": {
            "id": "220500703",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "传说御舆长正一直在为幕府效力，据说，他的为人极为清白正直，甚至到了…近乎偏执的程度。",
            "nextDialogs": [
              "220500704"
            ]
          },
          "220500704": {
            "id": "220500704",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "他的血脉一直流传到了今天。城内如今还有姓御舆的人，多半是他的后人。"
          },
          "220500706": {
            "id": "220500706",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "关于他的记载不多。他在渡海去璃月学了仙术之后，又回了稻妻。",
            "nextDialogs": [
              "220500707"
            ]
          },
          "220500707": {
            "id": "220500707",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "然后，他就创立了自己的「阴阳术」和「式大将」。",
            "nextDialogs": [
              "220500708"
            ]
          },
          "220500708": {
            "id": "220500708",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "根据记载，为了给稻妻带来安宁，他曾经用这种术封印了四处大闹的妖狸五百藏。",
            "nextDialogs": [
              "220500709"
            ]
          },
          "220500709": {
            "id": "220500709",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "但后来，他也逐渐销声匿迹了。"
          },
          "220500711": {
            "id": "220500711",
            "speakerId": 1002,
            "speakerName": "稻城萤美",
            "text": "请慢走。如果需要我帮忙的话，就请尽管来找我吧。"
          }
        }
      }
    }
  ]
}
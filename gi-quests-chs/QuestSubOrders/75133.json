    {
      "subId": "7513307",
      "subQuestName": "与玻娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751330501"
        ],
        "dialogs": {
          "751330501": {
            "id": "751330501",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "真是吓了我一跳，幸好大家的反应都很快呢。",
            "nextDialogs": [
              "751330502"
            ]
          },
          "751330502": {
            "id": "751330502",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "哎，怎么样，你们有什么发现吗？",
            "nextDialogs": [
              "751330503"
            ]
          },
          "751330503": {
            "id": "751330503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个嘛，倒是有发现个像是机关的东西啦，但是有点麻烦的样子…",
            "nextDialogs": [
              "751330504"
            ]
          },
          "751330504": {
            "id": "751330504",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751330505"
            ]
          },
          "751330505": {
            "id": "751330505",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "#哦哦，虽然不知道是什么，不过{REALNAME[ID(2)|SHOWHOST(true)]}看起来有办法的样子嘛，我们过去看看吧！"
          }
        }
      }
    },

      }
    },
    {
      "subId": "7513303",
      "subQuestName": "在遗迹周围调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751330301"
        ],
        "dialogs": {
          "751330301": {
            "id": "751330301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#哇，打开了，这次多亏了{REALNAME[ID(2)|SHOWHOST(true)]}才找到了机关呢。",
            "nextDialogs": [
              "751330302"
            ]
          },
          "751330302": {
            "id": "751330302",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751330303"
            ]
          },
          "751330303": {
            "id": "751330303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#不愧是{REALNAME[ID(2)|SHOWHOST(true)]}。",
            "nextDialogs": [
              "751330304"
            ]
          },
          "751330304": {
            "id": "751330304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过也不要自满哦，接下来还有更多的挑战在等着我们呢！",
            "nextDialogs": [
              "751330305"
            ]
          },
          "751330305": {
            "id": "751330305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "既然入口已经打开了，不管怎么样我们都得下去探个究竟了吧。",
            "nextDialogs": [
              "751330306"
            ]
          },
          "751330306": {
            "id": "751330306",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "我也同意呢，小派蒙。",
            "nextDialogs": [
              "751330307"
            ]
          },
          "751330307": {
            "id": "751330307",
            "speakerId": 1002,
            "speakerName": "「绿松石」",
            "text": "叽…叽！",
            "nextDialogs": [
              "751330308"
            ]
          },
          "751330308": {
            "id": "751330308",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "嗯？绿宝你怎么这么抗拒的样子啦，不会是害怕了吧。可不能在这里退缩啊，我们的冒险之旅才刚走完一半呢！",
            "nextDialogs": [
              "751330309"
            ]
          },
          "751330309": {
            "id": "751330309",
            "speakerId": 1002,
            "speakerName": "「绿松石」",
            "text": "咕…",
            "nextDialogs": [
              "751330310"
            ]
          },
          "751330310": {
            "id": "751330310",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "玻娜你就不要强迫绿宝啦，它看起来真的很害怕的样子，难不成是下面有什么不得了的危险东西？",
            "nextDialogs": [
              "751330311"
            ]
          },
          "751330311": {
            "id": "751330311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好可怕！",
            "nextDialogs": [
              "751330312"
            ]
          },
          "751330312": {
            "id": "751330312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#喂，你怎么也开始害怕了，像{REALNAME[ID(2)|SHOWHOST(true)]}一样打起精神来啊！",
            "nextDialogs": [
              "751330313"
            ]
          },
          "751330313": {
            "id": "751330313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "开始跃跃欲试了。",
            "nextDialogs": [
              "751330314"
            ]
          },
          "751330314": {
            "id": "751330314",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，没想到你这么有精神，虽然我也觉得不管下面有什么都不会是你的对手啦。",
            "nextDialogs": [
              "751330315"
            ]
          },
          "751330315": {
            "id": "751330315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不用担心，我们有勇敢小龙。",
            "nextDialogs": [
              "751330316"
            ]
          },
          "751330316": {
            "id": "751330316",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀…呀！",
            "nextDialogs": [
              "751330317"
            ]
          },
          "751330317": {
            "id": "751330317",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，绿宝这么害怕的话，不如就先留在这里。啊，不过也不能把绿宝一个人抛下…",
            "nextDialogs": [
              "751330318"
            ]
          },
          "751330318": {
            "id": "751330318",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "嗯，看来没办法了呢，既然这样我就和绿宝一起留在上面吧。为表诚意，我把火磷石也一起交给你们。",
            "nextDialogs": [
              "751330319"
            ]
          },
          "751330319": {
            "id": "751330319",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "先说好哦，不管你们在下面发现了什么，都要回来这里找我会合！",
            "nextDialogs": [
              "751330320"
            ]
          },
          "751330320": {
            "id": "751330320",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们不会抛弃伙伴的。",
            "nextDialogs": [
              "751330321"
            ]
          },
          "751330321": {
            "id": "751330321",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "真的吗…那就好，我相信你们，我们会在这里等你们回来的。",
            "nextDialogs": [
              "751330322"
            ]
          },
          "751330322": {
            "id": "751330322",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们就安心在这里等我们回来。",
            "nextDialogs": [
              "751330323"
            ]
          },
          "751330323": {
            "id": "751330323",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！"
          }
        }
      }
    },
    {
      "subId": "7513305",
      "subQuestName": "前往玻娜所在的地方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751330401"
        ],
        "dialogs": {
          "751330401": {
            "id": "751330401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃，这是什么啦，看起来好恶心…",
            "nextDialogs": [
              "751330402"
            ]
          },
          "751330402": {
            "id": "751330402",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "这是还在形成中的深渊秽露，看起来是从上面渗下来的…唔，我还以为有壁画的地方会比较安全呢。",
            "nextDialogs": [
              "751330403"
            ]
          },
          "751330403": {
            "id": "751330403",
            "speakerId": 1003,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔，呀！",
            "nextDialogs": [
              "751330404"
            ]
          },
          "751330404": {
            "id": "751330404",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "欸？不好，好像有什么东西要掉下来了，大家小心！"
          }
        }
      }
    },
    {
      "subId": "7513306",
      "subQuestName": "击败突然袭击的魔物",

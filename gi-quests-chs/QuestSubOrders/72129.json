    {
      "subId": "7212911",
      "subQuestName": "返回与梶对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721290401"
        ],
        "dialogs": {
          "721290401": {
            "id": "721290401",
            "speakerId": 1000,
            "speakerName": "梶",
            "text": "有一手啊，外国人！云层明显消散了许多，看起来我的猜测没错。",
            "nextDialogs": [
              "721290402"
            ]
          },
          "721290402": {
            "id": "721290402",
            "speakerId": 1000,
            "speakerName": "梶",
            "text": "接下来在蛇神之首与蛇骨矿洞还有两处镇物需要修复。",
            "nextDialogs": [
              "721290403"
            ]
          },
          "721290403": {
            "id": "721290403",
            "speakerId": 1000,
            "speakerName": "梶",
            "text": "如果你不介意的话，这两座镇物也还麻烦你了。",
            "nextDialogs": [
              "721290404"
            ]
          },
          "721290404": {
            "id": "721290404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题。",
            "nextDialogs": [
              "721290405"
            ]
          },
          "721290405": {
            "id": "721290405",
            "speakerId": 1000,
            "speakerName": "梶",
            "text": "非常感谢你的帮助，虽然我也不是什么有钱人，但我保证不会亏待你的。",
            "nextDialogs": [
              "721290406"
            ]
          },
          "721290406": {
            "id": "721290406",
            "speakerId": 1000,
            "speakerName": "梶",
            "text": "虽然不知道什么时候才有希望，但亲友回家的日子又近了一天…",
            "nextDialogs": [
              "721290407"
            ]
          },
          "721290407": {
            "id": "721290407",
            "speakerId": 1000,
            "speakerName": "梶",
            "text": "顺便一提，等你那边差不多了就到岛西侧找我吧，无明砦那边也曾受到叛军的侵扰，或许与这场异变脱不开干系。"
          }
        }
      }
    },
    {
      "subId": "7212901",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721290101"
        ],
        "dialogs": {
          "721290101": {
            "id": "721290101",
            "speakerId": 1003,
            "speakerName": "观察",
            "text": "形状奇特的石灯，似乎放射着令人不安的能量。",
            "nextDialogs": [
              "721290102"
            ]
          },
          "721290102": {
            "id": "721290102",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这个石灯笼好奇怪…让人感觉怪不舒服的。",
            "nextDialogs": [
              "721290103"
            ]
          },
          "721290103": {
            "id": "721290103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸，好像灯柱上写着什么字？",
            "nextDialogs": [
              "721290104"
            ]
          },
          "721290104": {
            "id": "721290104",
            "speakerId": 1003,
            "speakerName": "观察",
            "text": "「路过的旅人，关于此镇物如有疑问，请至无想刃狭间，与梶先生商谈。」",
            "nextDialogs": [
              "721290105"
            ]
          },
          "721290105": {
            "id": "721290105",
            "speakerId": 1003,
            "speakerName": "观察",
            "text": "字看起来很新，似乎是不久前写下的。下面还有几列被雨水洗濯模糊的小字：",
            "nextDialogs": [
              "721290106"
            ]
          },
          "721290106": {
            "id": "721290106",
            "speakerId": 1003,
            "speakerName": "观察",
            "text": "「…请转告梶先生，我们试过…但可惜…或许在附近能找到…」",
            "nextDialogs": [
              "721290107"
            ]
          },
          "721290107": {
            "id": "721290107",
            "speakerId": 1003,
            "speakerName": "观察",
            "text": "「…请梶先生尽快一同来避难地点，他的家人很想他。」",
            "nextDialogs": [
              "721290108"
            ]
          },
          "721290108": {
            "id": "721290108",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这个梶先生似乎对石灯笼很在意的样子，我们不如去无想刃狭间问问他吧？"
          }
        }
      }
    },
    {
      "subId": "7212903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721290301"
        ],
        "dialogs": {
          "721290301": {
            "id": "721290301",
            "speakerId": 1001,
            "speakerName": "接触镇物",
            "text": "灯笼终于修好了，似乎周围的天气也发生了变化"
          }
        }
      }
    },
    {
      "subId": "7212905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721290501"
        ],
        "dialogs": {
          "721290501": {
            "id": "721290501",
            "speakerId": 1004,
            "speakerName": "放置",
            "text": "似乎镇物缺少了两个关键部件。",
            "nextDialogs": [
              "721290502"
            ]
          },
          "721290502": {
            "id": "721290502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（是这个吗？）"
          }
        }
      }
    }
  ]
}
        "dialogs": {
          "722359901": {
            "id": "722359901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜啊，发生了什么！",
            "nextDialogs": [
              "722359902"
            ]
          },
          "722359902": {
            "id": "722359902",
            "speakerId": 1001,
            "speakerName": "派蒙",

{
  "lineCounts": {
    "Player": 4,
    "派蒙": 3,
    "麦斯欧德": 8
  },
  "subQuests": [
    {
      "subId": "7335201",
      "subQuestName": "与麦斯欧德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733520101"
        ],
        "dialogs": {
          "733520101": {
            "id": "733520101",
            "speakerId": 30659,
            "speakerName": "麦斯欧德",
            "text": "异乡的旅者和小朋友，你们好啊，花神诞祭玩得还开心吗？",
            "nextDialogs": [
              "733520102"
            ]
          },
          "733520102": {
            "id": "733520102",
            "speakerId": 30659,
            "speakerName": "麦斯欧德",
            "text": "要是两位还有兴致，我「幻之玩具王」诚邀你们来玩玩新游戏——只在花神诞祭期间才开放的「花车摇曳」。",
            "nextDialogs": [
              "733520103"
            ]
          },
          "733520103": {
            "id": "733520103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "花车摇曳？",
            "nextDialogs": [
              "733520104"
            ]
          },
          "733520104": {
            "id": "733520104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一听这个名字，我好像能想象出…纳西妲坐在花车里开心摇摆的画面！",
            "nextDialogs": [
              "733520107"
            ]
          },
          "733520107": {
            "id": "733520107",
            "speakerId": 30659,
            "speakerName": "麦斯欧德",
            "text": "好呀，「草神大人每天都快快乐乐」是我们这些须弥人的愿望！",
            "nextDialogs": [
              "733520108"
            ]
          },
          "733520108": {
            "id": "733520108",
            "speakerId": 30659,
            "speakerName": "麦斯欧德",
            "text": "你们的联想…是何等美妙的画面，值得画成一幅华丽的绘卷。",
            "nextDialogs": [
              "733520109"
            ]
          },
          "733520109": {
            "id": "733520109",
            "speakerId": 30659,
            "speakerName": "麦斯欧德",
            "text": "不过，这个游戏的氛围更加活泼，比起欣喜的庆祝，更像是一场历险——",
            "nextDialogs": [
              "733520110"
            ]
          },
          "733520110": {
            "id": "733520110",
            "speakerId": 30659,
            "speakerName": "麦斯欧德",
            "text": "「无论聪明与否，不管乖巧还是顽皮，每个拥有美好心灵的孩子，都在花神诞祭的庆祝上得到了一辆自己的花车…」",
            "nextDialogs": [
              "733520111"
            ]
          },
          "733520111": {
            "id": "733520111",
            "speakerId": 30659,
            "speakerName": "麦斯欧德",
            "text": "「乘着这辆花车，孩子们开启了自己独一无二的旅程，遭遇了惊险，也成功化险为夷，寻得了千朵鲜花的至宝…」"
          }
        }
      }
    }
  ]
}
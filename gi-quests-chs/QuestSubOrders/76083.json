          },
          "760830404": {
            "id": "760830404",
            "speakerId": 1000,
            "speakerName": "月灵",
            "text": "！！",
            "nextDialogs": [
              "760830405"
            ]
          },
          "760830405": {
            "id": "760830405",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "哼哼，这次还是挺明显的嘛。",
            "nextDialogs": [
              "760830406"
            ]
          },
          "760830406": {
            "id": "760830406",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "对我们来说，这个谜底有些过于简单了。"
          },
          "760830408": {
            "id": "760830408",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "这次的这位是腰部出了问题？！",
            "nextDialogs": [
              "760830409"
            ]
          },
          "760830409": {
            "id": "760830409",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "你们的见闻真的非常丰富呢…",
            "nextDialogs": [
              "760830410"
            ]
          },
          "760830410": {
            "id": "760830410",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "正确答案是月亮。",
            "nextDialogs": [
              "760830411"
            ]
          },
          "760830411": {
            "id": "760830411",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "回来吧，做得很好哦。"
          },
          "760830413": {
            "id": "760830413",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "谁都看得出来是圆弧吧！那么简单的结论怎么可能是正确答案啦！",
            "nextDialogs": [
              "760830414"
            ]
          },
          "760830414": {
            "id": "760830414",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "的确不能说有错，可惜这并不是月灵们的本意。",
            "nextDialogs": [
              "760830415"
            ]
          },
          "760830415": {
            "id": "760830415",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "正确答案是月亮。",
            "nextDialogs": [

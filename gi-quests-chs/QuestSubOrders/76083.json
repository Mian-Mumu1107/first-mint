        "dialogs": {
          "760830401": {
            "id": "760830401",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "去吧，月灵们。",
            "nextDialogs": [
              "760830402"
            ]
          },
          "760830402": {
            "id": "760830402",
            "speakerId": 1001,
            "speakerName": "「少女」",
            "text": "猜猜看这是什么图案。",
            "nextDialogs": [

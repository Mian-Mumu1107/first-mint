{
  "lineCounts": {
    "Player": 21,
    "岚姐": 27,
    "沐宁": 17,
    "派蒙": 8
  },
  "subQuests": [
    {
      "subId": "7104801",
      "subQuestName": "test隐藏-跟岚姐对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710480101"
        ],
        "dialogs": {
          "710480101": {
            "id": "710480101",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "啊，是你呀。怎么，你是来应征探索层岩巨渊的吗？",
            "nextDialogs": [
              "710480102"
            ]
          },
          "710480102": {
            "id": "710480102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "层岩巨渊？",
            "nextDialogs": [
              "710480103"
            ]
          },
          "710480103": {
            "id": "710480103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没听说过有这种委托呢…",
            "nextDialogs": [
              "710480104"
            ]
          },
          "710480104": {
            "id": "710480104",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "嗯？哦，原来你还不知道冒险家协会的委托…抱歉，是我的失职。",
            "nextDialogs": [
              "710480105"
            ]
          },
          "710480105": {
            "id": "710480105",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "毕竟层岩巨渊已经关闭了嘛。若是没有璃月七星等级人士的许可，任何人都无权进入那里…冒险家协会也不例外。",
            "nextDialogs": [
              "710480108"
            ]
          },
          "710480108": {
            "id": "710480108",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "我们可不能用这种事干扰玉京台的工作…干涉已成定论的政策，结果只能适得其反。",
            "nextDialogs": [
              "710480109"
            ]
          },
          "710480109": {
            "id": "710480109",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "即使是那位看起来很好说话的甘雨小姐，恐怕也只会满面微笑地对你来一句「不好意思，请稍等片刻，先喝杯茶吧。」",
            "nextDialogs": [
              "710480110"
            ]
          },
          "710480110": {
            "id": "710480110",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "然后把你晾半天，让你怀疑她是不是直到快下班才会想起来处理你的请求…",
            "nextDialogs": [
              "710480111"
            ]
          },
          "710480111": {
            "id": "710480111",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "哼…你也知道，甘雨小姐从来不会下班。",
            "nextDialogs": [
              "710480112"
            ]
          },
          "710480112": {
            "id": "710480112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "噗…",
            "nextDialogs": [
              "710480113"
            ]
          },
          "710480113": {
            "id": "710480113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实是甘雨特有的拒绝方式…",
            "nextDialogs": [
              "710480114"
            ]
          },
          "710480114": {
            "id": "710480114",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "所以，探索层岩巨渊的委托自然不适合拜托凯瑟琳小姐公示出来。我们只能私下里寻找更方便的人选。",
            "nextDialogs": [
              "710480115"
            ]
          },
          "710480115": {
            "id": "710480115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "更方便的人选…？",
            "nextDialogs": [
              "710480116"
            ]
          },
          "710480116": {
            "id": "710480116",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "嗯，比如说辉山厅指定的矿工、千岩军人员、总务司职员之类，他们更容易拿到通行证，以及…",
            "nextDialogs": [
              "710480117"
            ]
          },
          "710480117": {
            "id": "710480117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "以及…什么呀？",
            "nextDialogs": [
              "710480118"
            ]
          },
          "710480118": {
            "id": "710480118",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "嗯…从海魔的触手之下拯救过璃月，却每天无所事事的大英雄，我想在千岩军面前应该也很好说话吧？",
            "nextDialogs": [
              "710480119"
            ]
          },
          "710480119": {
            "id": "710480119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谁呀…？",
            "nextDialogs": [
              "710480120"
            ]
          },
          "710480120": {
            "id": "710480120",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "你呀。",
            "nextDialogs": [
              "710480121"
            ]
          },
          "710480121": {
            "id": "710480121",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦，还能有谁呀！",
            "nextDialogs": [
              "710480122"
            ]
          },
          "710480122": {
            "id": "710480122",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "别装傻了，我说的还能是岩王爷他老人家不成？"
          }
        }
      }
    },
    {
      "subId": "7104802",
      "subQuestName": "找到总务司专员「沐宁」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710440501"
        ],
        "dialogs": {
          "710440501": {
            "id": "710440501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于层岩巨渊…",
            "nextDialogs": [
              "710440502"
            ]
          },
          "710440502": {
            "id": "710440502",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "对了，关于层岩巨渊…如果你们暂时不想离开的话，就请四处转转吧。但请一定遵守璃月的律法。",
            "nextDialogs": [
              "710440503"
            ]
          },
          "710440503": {
            "id": "710440503",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "顺便一提，有的地方，我强烈不建议你们接近。",
            "nextDialogs": [
              "710440504"
            ]
          },
          "710440504": {
            "id": "710440504",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "就比如说，层岩巨渊中央的大矿井被布下了「七星阵法」…呃，顾名思义，就是七星布下的阵法。",
            "nextDialogs": [
              "710440505"
            ]
          },
          "710440505": {
            "id": "710440505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这解释还挺…简单明确的。",
            "nextDialogs": [
              "710440506"
            ]
          },
          "710440506": {
            "id": "710440506",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "阵法的弱点…呃，节点，在于周围的「磐键」。它们由「七星」之手亲自布下，串联并固定了阵法中流动的能量。",
            "nextDialogs": [
              "710440507"
            ]
          },
          "710440507": {
            "id": "710440507",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "近来磐键周围的岩元素聚合物异常增生，就像下面的「东西」在渴望冒出头来一样…",
            "nextDialogs": [
              "710440508"
            ]
          },
          "710440508": {
            "id": "710440508",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "…算了，请不要在意我的自言自语。总之事情就是这样，请一定、一定不要靠近「七星阵法」，也不要想着下去探险什么的。",
            "nextDialogs": [
              "710440509"
            ]
          },
          "710440509": {
            "id": "710440509",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "「磐键」的结构也完全没有发生衰变，周围的岩元素聚合物自然不会产生奇奇怪怪的反应，所以请别想从中下功夫。",
            "nextDialogs": [
              "710440510"
            ]
          },
          "710440510": {
            "id": "710440510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是…",
            "nextDialogs": [
              "710440511"
            ]
          },
          "710440511": {
            "id": "710440511",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "哼，我知道你想问什么。",
            "nextDialogs": [
              "710440512"
            ]
          },
          "710440512": {
            "id": "710440512",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "下面可不会有什么珍奇异宝，也不会有什么史前化石，更不会有什么超级巨大古代遗迹的…请你们不要抱虚假的期待。",
            "nextDialogs": [
              "710440513"
            ]
          },
          "710440513": {
            "id": "710440513",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你这么说就好可疑！",
            "nextDialogs": [
              "710440514"
            ]
          },
          "710440514": {
            "id": "710440514",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "下面连蘑菇都不会长的！不会有实现人愿望的石头，更不会有只靠吃蘑菇就能增肌的水手！请你们不要抱有虚假的期待！",
            "nextDialogs": [
              "710440515"
            ]
          },
          "710440515": {
            "id": "710440515",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，知道啦！不要这么凶嘛！",
            "nextDialogs": [
              "710440520",
              "710440518"
            ]
          },
          "710440520": {
            "id": "710440520",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "我建议你们先去找志琼聊一聊，她是受雇于总务司的冒险家，曾经在这里做过矿工，对层岩巨渊的地形了如指掌…",
            "nextDialogs": [
              "710440521"
            ]
          },
          "710440521": {
            "id": "710440521",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "…稍等，我给你开一个凭条。她看见凭条，自然会明白你是可以信赖的。",
            "nextDialogs": [
              "710440522"
            ]
          },
          "710440522": {
            "id": "710440522",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "当然！我事先警告你们，志琼可不是那种一点也不安分，整天到处乱跑的人，也从来不会想解开阵法一头钻进地下！",
            "nextDialogs": [
              "710440523"
            ]
          },
          "710440523": {
            "id": "710440523",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "更不可能纠集一群无所事事的冒险者，旁若无人地深入险地！所以请不要指望她能帮你进入层岩巨渊矿坑。"
          },
          "710440518": {
            "id": "710440518",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！我们走吧！",
            "nextDialogs": [
              "710440519"
            ]
          },
          "710440519": {
            "id": "710440519",
            "speakerId": 1002,
            "speakerName": "沐宁",
            "text": "等等，我还没说完呢！"
          }
        }
      }
    },
    {
      "subId": "7104802",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710480201"
        ],
        "dialogs": {
          "710480201": {
            "id": "710480201",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "你回来了，冒险家协会欢迎你。",
            "nextDialogs": [
              "710480203",
              "710480207",
              "710480209",
              "710480212"
            ]
          },
          "710480203": {
            "id": "710480203",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "你是想问那里有什么吗？哈哈，谁知道呢。",
            "nextDialogs": [
              "710480204"
            ]
          },
          "710480204": {
            "id": "710480204",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "有人说矿工挖出了许愿石，许下愿望却收获了适得其反的报应；也有人说挖出了老龙王的尾巴…都是些好笑的谣言而已。",
            "nextDialogs": [
              "710480205"
            ]
          },
          "710480205": {
            "id": "710480205",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "好了，不必找我问层岩巨渊的事，我也不是很清楚那边发生过什么。去跟沐宁说就好。这是总务司的要求。"
          },
          "710480207": {
            "id": "710480207",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "咳咳…大街上到处都是靠层岩巨渊吃饭的商户，你不怕惹麻烦，但我可是要养活冒险家协会的。"
          },
          "710480209": {
            "id": "710480209",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "啊，他呀…哼，把他调到层岩巨渊，恐怕也是因为总务司想要磨炼一下他吧。",
            "nextDialogs": [
              "710480210"
            ]
          },
          "710480210": {
            "id": "710480210",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "像他这种出身优越的小子就是容易得意忘形，公务人员总这样飘飘的可不行…层岩巨渊会让他长大的吧。"
          },
          "710480212": {
            "id": "710480212",
            "speakerId": 1000,
            "speakerName": "岚姐",
            "text": "嗯，啊…向着星辰与深渊。"
          }
        }
      }
    }
  ]
}
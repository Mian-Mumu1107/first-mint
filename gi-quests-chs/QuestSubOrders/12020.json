            "speakerId": 12059,
            "speakerName": "传次郎",
            "text": "有什么需要我帮忙的吗？"
          }
        }
      }
    },
    {
      "subId": "1202012",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120201201"
        ],
        "dialogs": {
          "120201201": {
            "id": "120201201",
            "speakerId": 12060,
            "speakerName": "有泽",
            "text": "呵欠…还有什么事吗？别打扰我休息…"
          }
        }
      }
    },
    {
      "subId": "1202014",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120201401"
        ],
        "dialogs": {
          "120201401": {
            "id": "120201401",
            "speakerId": 12061,
            "speakerName": "嘉久",
            "text": "报告队长！一切安好！",
            "nextDialogs": [
              "120201402"
            ]
          },
          "120201402": {
            "id": "120201402",
            "speakerId": 12095,
            "speakerName": "恒雄",
            "text": "找珊瑚宫大人的话，她现在应该在村子里。"
          }
        }
      }
    },
    {
      "subId": "1202099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120209901"
        ],
        "dialogs": {
          "120209901": {
            "id": "120209901",
            "speakerId": 10324,
            "speakerName": "愚人众先遣队",
            "text": "不好了兄弟们！咱们的船被人烧了！",
            "nextDialogs": [
              "120209902"
            ]
          },
          "120209902": {
            "id": "120209902",
            "speakerId": 10324,
            "speakerName": "愚人众先遣队",
            "text": "还有这事？太卑鄙了！",
            "nextDialogs": [
              "120209903"
            ]
          },
          "120209903": {
            "id": "120209903",
            "speakerId": 10324,
            "speakerName": "愚人众先遣队",
            "text": "兄弟们上！没有退路了，给他们点颜色瞧瞧！",
            "nextDialogs": [
              "120209904"
            ]
          },
          "120209904": {
            "id": "120209904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果能在愚人众手里找到货物的话，应该就能证明那位商人的清白了吧。",
            "nextDialogs": [
              "120209905"
            ]
          },
          "120209905": {
            "id": "120209905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有那个愚人众勾结天领奉行的传闻…我们也必须要好好地调查一下才行！"
          }
        }
      }
    }
  ]
}
    {
      "subId": "1202004",
      "subQuestName": "向士兵们打听情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1202005",
      "subQuestName": "向士兵们打听情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120200301"
        ],
        "dialogs": {
          "120200301": {
            "id": "120200301",
            "speakerId": 12060,
            "speakerName": "有泽",
            "text": "呵欠…和平…最棒了…",
            "nextDialogs": [
              "120200302"
            ]
          },
          "120200302": {
            "id": "120200302",
            "speakerId": 12060,
            "speakerName": "有泽",
            "text": "嗯？你看上去有点眼熟…？",
            "nextDialogs": [
              "120200303"
            ]
          },
          "120200303": {
            "id": "120200303",
            "speakerId": 12060,
            "speakerName": "有泽",
            "text": "我好像在哪见过你来着…想不起来了。但你应该不是敌人，有什么事吗？",
            "nextDialogs": [
              "120200304"
            ]
          },
          "120200304": {
            "id": "120200304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于最近发生的事…",
            "nextDialogs": [
              "120200305"
            ]
          },
          "120200305": {
            "id": "120200305",
            "speakerId": 12060,
            "speakerName": "有泽",
            "text": "你说大家有些浮躁？有吗，我没感觉到啊。",
            "nextDialogs": [
              "120200306"
            ]
          },
          "120200306": {
            "id": "120200306",
            "speakerId": 12060,
            "speakerName": "有泽",
            "text": "可能是因为我平时不喜欢跟别人聊天吧，在我眼里他们一直都很闹腾。",
            "nextDialogs": [
              "120200307"
            ]
          },
          "120200307": {
            "id": "120200307",
            "speakerId": 12060,
            "speakerName": "有泽",
            "text": "来之不易的和平，必须要好好享受才行…在这里晒晒太阳，吹吹海风，就是我生命的全部了。",
            "nextDialogs": [
              "120200308"
            ]
          },
          "120200308": {
            "id": "120200308",
            "speakerId": 12060,
            "speakerName": "有泽",
            "text": "抱歉啊，我也没办法回答你的问题。不过你可以问珊瑚宫大人，珊瑚宫大人什么都懂的。",
            "nextDialogs": [
              "120200309"
            ]
          },
          "120200309": {
            "id": "120200309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…他快要睡着了。我们还是不要打扰他了，去问问下一个人吧！"
          }
        }
      }
    },
    {
      "subId": "1202006",
      "subQuestName": "向士兵们打听情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120200401"
        ],
        "dialogs": {
          "120200401": {
            "id": "120200401",
            "speakerId": 12061,
            "speakerName": "嘉久",
            "text": "唉，珊瑚宫大人到底是怎么想的，怎么能同意和谈呢？",
            "nextDialogs": [
              "120200402"
            ]
          },
          "120200402": {
            "id": "120200402",
            "speakerId": 12095,
            "speakerName": "恒雄",
            "text": "是啊…天领奉行那些家伙根本不值得相信，我还听说天领奉行的人秘密勾结愚人众，打算继续对我们开战呢。",
            "nextDialogs": [
              "120200403"
            ]
          },
          "120200403": {
            "id": "120200403",
            "speakerId": 12061,
            "speakerName": "嘉久",
            "text": "真的假的？消息可靠吗？",
            "nextDialogs": [
              "120200404"
            ]
          },
          "120200404": {
            "id": "120200404",
            "speakerId": 12095,
            "speakerName": "恒雄",
            "text": "当然是真的，我们的人与愚人众交手，正好撞见了他们正在密谋这件事。",
            "nextDialogs": [
              "120200405"
            ]
          },
          "120200405": {
            "id": "120200405",
            "speakerId": 12061,
            "speakerName": "嘉久",
            "text": "我就知道，天领奉行那帮家伙贼心不死…珊瑚宫大人还是有点天真，怎么能轻易相信他们呢？",
            "nextDialogs": [
              "120200406"
            ]
          },
          "120200406": {
            "id": "120200406",
            "speakerId": 12095,
            "speakerName": "恒雄",
            "text": "嘘，小点声，有人来了。",
            "nextDialogs": [
              "120200407"
            ]
          },
          "120200407": {
            "id": "120200407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们在聊什么呢？",
            "nextDialogs": [
              "120200408"
            ]
          },
          "120200408": {
            "id": "120200408",
            "speakerId": 12061,
            "speakerName": "嘉久",
            "text": "#{NICKNAME}队长？你回来了！",
            "nextDialogs": [
              "120200411"
            ]
          },
          "120200411": {
            "id": "120200411",
            "speakerId": 12061,
            "speakerName": "嘉久",
            "text": "我说，刚刚的事情，能跟队长说吗？",
            "nextDialogs": [
              "120200412"
            ]
          },
          "120200412": {
            "id": "120200412",
            "speakerId": 12095,
            "speakerName": "恒雄",
            "text": "#还是不要吧。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}也是珊瑚宫大人提拔起来的，说不定也主张和谈…",
            "nextDialogs": [
              "120200413"
            ]
          },
          "120200413": {
            "id": "120200413",
            "speakerId": 12061,
            "speakerName": "嘉久",
            "text": "队长应该理解我们吧？不过小心一点也有道理…",
            "nextDialogs": [
              "120200414"
            ]
          },
          "120200414": {
            "id": "120200414",
            "speakerId": 12061,
            "speakerName": "嘉久",
            "text": "那个，欢迎队长回海祇岛！我们这边没什么事，一切安好！",
            "nextDialogs": [
              "120200415"
            ]
          },
          "120200415": {
            "id": "120200415",
            "speakerId": 12095,
            "speakerName": "恒雄",
            "text": "珊瑚宫大人现在应该在村庄里，队长大人可以直接过去！",
            "nextDialogs": [
              "120200416"
            ]
          },
          "120200416": {
            "id": "120200416",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…总觉得他们好像在聊什么秘密的事情。不过既然他们不肯说，我们还是先去村子里看看吧。"
          }
        }
      }
    },
    {
      "subId": "1202007",
      "subQuestName": "前往望泷村",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1202008",
      "subQuestName": "调查士兵与商人的争执",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120200501"
        ],
        "dialogs": {
          "120200501": {
            "id": "120200501",
            "speakerId": 3140,
            "speakerName": "松田",
            "text": "说！你是不是偷偷把从海祇岛采购的货物，运送给天领奉行了？",
            "nextDialogs": [
              "120200502"
            ]
          },
          "120200502": {
            "id": "120200502",
            "speakerId": 3140,
            "speakerName": "松田",
            "text": "我早就觉得你一个天领奉行的商人，来海祇岛做生意不正常。这一次你总没话说了吧？",
            "nextDialogs": [
              "120200503"
            ]
          },
          "120200503": {
            "id": "120200503",
            "speakerId": 12062,
            "speakerName": "成濑",
            "text": "冤，冤枉啊…",
            "nextDialogs": [
              "120200504"
            ]
          },
          "120200504": {
            "id": "120200504",
            "speakerId": 12096,
            "speakerName": "内村",
            "text": "还说冤枉？当时我们就不应该同意你来海祇岛做生意。",
            "nextDialogs": [
              "120200505"
            ]
          },
          "120200505": {
            "id": "120200505",
            "speakerId": 12096,
            "speakerName": "内村",
            "text": "带走带走！",
            "nextDialogs": [
              "120200506"
            ]
          },
          "120200506": {
            "id": "120200506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等等…",
            "nextDialogs": [
              "120200507"
            ]
          },
          "120200507": {
            "id": "120200507",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "请等一下！",
            "nextDialogs": [
              "120200508"
            ]
          },
          "120200508": {
            "id": "120200508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "心海！你来啦！",
            "nextDialogs": [
              "120200509"
            ]
          },
          "120200509": {
            "id": "120200509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里好像发生了什么事情，你快来看看吧！",
            "nextDialogs": [
              "120200510"
            ]
          },
          "120200510": {
            "id": "120200510",
            "speakerId": 3140,
            "speakerName": "松田",
            "text": "报告珊瑚宫大人，这个商人形迹可疑，被我们抓到了。",
            "nextDialogs": [
              "120200511"
            ]
          },
          "120200511": {
            "id": "120200511",
            "speakerId": 3140,
            "speakerName": "松田",
            "text": "据我们观察，他长期只买不卖，身边却一点货物都没有，很可能是偷偷运到天领奉行去了！",
            "nextDialogs": [
              "120200512"
            ]
          },
          "120200512": {
            "id": "120200512",
            "speakerId": 12062,
            "speakerName": "成濑",
            "text": "我没有…我…",
            "nextDialogs": [
              "120200513"
            ]
          },
          "120200513": {
            "id": "120200513",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "好了。各位不要激动，放松放松。跟我一起做个深呼吸…呼…有好一些吗？",
            "nextDialogs": [
              "120200514"
            ]
          },
          "120200514": {
            "id": "120200514",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "松田、内村，我知道你们很担心海祇岛的安全。",
            "nextDialogs": [
              "120200515"
            ]
          },
          "120200515": {
            "id": "120200515",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "但是，先不管这位商人先生有没有犯错，我们至少要给他解释的权利。",
            "nextDialogs": [
              "120200516"
            ]
          },
          "120200516": {
            "id": "120200516",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "有错自然应该接受惩罚，无错也不应该被随意冤枉。海祇岛上，办事靠的是事实，而非主观判断。",
            "nextDialogs": [
              "120200517"
            ]
          },
          "120200517": {
            "id": "120200517",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "商人先生，既然我的部下提出了货物的问题，不妨请你解释一下，由我来做个评断如何？",
            "nextDialogs": [
              "120200518"
            ]
          },
          "120200518": {
            "id": "120200518",
            "speakerId": 12062,
            "speakerName": "成濑",
            "text": "可以，当然可以！",
            "nextDialogs": [
              "120200519"
            ]
          },
          "120200519": {
            "id": "120200519",
            "speakerId": 12062,
            "speakerName": "成濑",
            "text": "我在海祇岛经商，当然也积累下来了一批货物。本来想囤久一点，等下次涨价的时候卖出…咳。",
            "nextDialogs": [
              "120200520"
            ]
          },
          "120200520": {
            "id": "120200520",
            "speakerId": 12062,
            "speakerName": "成濑",
            "text": "却没想到，被愚人众给打劫了！我容易吗？风里来雨里去的，货被抢了还要被你们盘问…",
            "nextDialogs": [
              "120200521"
            ]
          },
          "120200521": {
            "id": "120200521",
            "speakerId": 12096,
            "speakerName": "内村",
            "text": "哼，谁知道你说的是不是真的？",
            "nextDialogs": [
              "120200524"
            ]
          },
          "120200524": {
            "id": "120200524",
            "speakerId": 12096,
            "speakerName": "内村",
            "text": "那也不能证明他的货就是被愚人众拿走的啊！",
            "nextDialogs": [
              "120200525"
            ]
          },
          "120200525": {
            "id": "120200525",
            "speakerId": 12096,
            "speakerName": "内村",
            "text": "再说了，天领奉行和愚人众还有勾结呢！你的货给愚人众，和给天领奉行有什么区别？",
            "nextDialogs": [
              "120200526"
            ]
          },
          "120200526": {
            "id": "120200526",
            "speakerId": 12062,
            "speakerName": "成濑",
            "text": "啊？天领奉行勾结愚人众？这是哪来的消息，我完全不知道！",
            "nextDialogs": [
              "120200527"
            ]
          },
          "120200527": {
            "id": "120200527",
            "speakerId": 12062,
            "speakerName": "成濑",
            "text": "再说，就算他们有勾结，也不关我的事吧…",
            "nextDialogs": [
              "120200528"
            ]
          },
          "120200528": {
            "id": "120200528",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "战争都已经结束了，天领奉行还会继续勾结愚人众吗？嗯…我觉得不像呀。",
            "nextDialogs": [
              "120200529"
            ]
          },
          "120200529": {
            "id": "120200529",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不久之前我们还见了九条家的名代，现在的他应该不会做这种事吧。",
            "nextDialogs": [
              "120200530"
            ]
          },
          "120200530": {
            "id": "120200530",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过刚刚来的路上，那些士兵好像也在讨论这件事…心海，你知道什么吗？",
            "nextDialogs": [
              "120200531"
            ]
          },
          "120200531": {
            "id": "120200531",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "确实听到了这样的汇报。",
            "nextDialogs": [
              "120200532"
            ]
          },
          "120200532": {
            "id": "120200532",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "再过不久，就是我们与天领奉行之间的和谈了。这次和谈是神里家组织的，选在一个中立地点举办。",
            "nextDialogs": [
              "120200533"
            ]
          },
          "120200533": {
            "id": "120200533",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "我和九条裟罗会各带一些侍卫，好好商讨一下关于未来的计划。",
            "nextDialogs": [
              "120200534"
            ]
          },
          "120200534": {
            "id": "120200534",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "但是在这样一个重要的时刻，我却听到一些传闻，九条家与愚人众很可能还存在勾结，他们想彻底覆灭海祇岛。",
            "nextDialogs": [
              "120200535"
            ]
          },
          "120200535": {
            "id": "120200535",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "如果是这样的话，和谈就可能是陷阱，甚至连神里家都可能参与其中…",
            "nextDialogs": [
              "120200536"
            ]
          },
          "120200536": {
            "id": "120200536",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "这位商人先生，你确定你的货物，是被愚人众劫走的吗？",
            "nextDialogs": [
              "120200537"
            ]
          },
          "120200537": {
            "id": "120200537",
            "speakerId": 12062,
            "speakerName": "成濑",
            "text": "是真的，我没有骗你们！愚人众抢了我的货物就往那边跑了，他们很可能在那边有秘密基地！",
            "nextDialogs": [
              "120200538"
            ]
          },
          "120200538": {
            "id": "120200538",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "那好，事关重大，不如我们帮你把货物找回来。如果一切顺利，自然可以还你清白。",
            "nextDialogs": [
              "120200539"
            ]
          },
          "120200539": {
            "id": "120200539",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "但如果真的有什么情况，证明愚人众和天领奉行有所勾结的话，还希望你配合我们调查，这样如何？",
            "nextDialogs": [
              "120200540"
            ]
          },
          "120200540": {
            "id": "120200540",
            "speakerId": 12062,
            "speakerName": "成濑",
            "text": "我没意见，多谢珊瑚宫大人出手相帮。",
            "nextDialogs": [
              "120200541"
            ]
          },
          "120200541": {
            "id": "120200541",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "松田、内村，你们呢？",
            "nextDialogs": [
              "120200542"
            ]
          },
          "120200542": {
            "id": "120200542",
            "speakerId": 3140,
            "speakerName": "松田",
            "text": "全听珊瑚宫大人吩咐。",
            "nextDialogs": [
              "120200543"
            ]
          },
          "120200543": {
            "id": "120200543",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "#那就好。{NICKNAME}…不，剑鱼小队二番队队长，能请你和我一起调查此事吗？"
          }
        }
      }
    },
    {
      "subId": "1202010",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120201001"
        ],
        "dialogs": {
          "120201001": {

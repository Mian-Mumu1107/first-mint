  },
  "subQuests": [
    {
      "subId": "1202001",
      "subQuestName": "前往海祇岛约定地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120200101"
        ],
        "dialogs": {
          "120200101": {
            "id": "120200101",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "幸亏你在这里，不然还真让他们给逃掉了。",
            "nextDialogs": [
              "120200102"
            ]
          },
          "120200102": {
            "id": "120200102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你手里的就是心海的锦囊吗？",
            "nextDialogs": [
              "120200103"
            ]
          },
          "120200103": {
            "id": "120200103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让我看看…哇！好厚！这么厚一本都是吗？",
            "nextDialogs": [
              "120200104"
            ]
          },
          "120200104": {
            "id": "120200104",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "其实…这只是一部分，我身上还有五本来着。",
            "nextDialogs": [
              "120200105"
            ]
          },
          "120200105": {
            "id": "120200105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么多！",
            "nextDialogs": [
              "120200106"
            ]
          },
          "120200106": {
            "id": "120200106",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "珊瑚宫大人向来算无遗策。这些又是「常备锦囊」，难免数量会多一些。",
            "nextDialogs": [
              "120200107"
            ]
          },
          "120200107": {
            "id": "120200107",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "不过也多亏了这些锦囊，我们才能够应对各种各样复杂的情况。",
            "nextDialogs": [
              "120200108"
            ]
          },
          "120200108": {
            "id": "120200108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么多锦囊，心海要写多久啊。每一种情况都要考虑，想想就让人头疼…",
            "nextDialogs": [
              "120200109"
            ]
          },
          "120200109": {
            "id": "120200109",
            "speakerId": 12098,
            "speakerName": "幸德",
            "text": "队长！你这次回海祇岛，会重新接手剑鱼二番队吗？我们大家都很想你！",
            "nextDialogs": [
              "120200112"
            ]
          },
          "120200112": {
            "id": "120200112",
            "speakerId": 12098,
            "speakerName": "幸德",
            "text": "珊瑚宫大人说，现在已经是和平时期，军队的数量需要适当减少，帮助民众恢复生产。",
            "nextDialogs": [
              "120200113"
            ]
          },
          "120200113": {
            "id": "120200113",
            "speakerId": 12098,
            "speakerName": "幸德",
            "text": "一半左右的士兵还维持着「别动队」的编制，支援各个小队。还有一半改为从事巡逻、建造、农耕之类的工作。",
            "nextDialogs": [
              "120200114"
            ]
          },
          "120200114": {
            "id": "120200114",
            "speakerId": 12098,
            "speakerName": "幸德",
            "text": "前两天还听以前的同伴抱怨说，自己不想被分去造房子，想留在前线继续战斗。",
            "nextDialogs": [
              "120200115"
            ]
          },
          "120200115": {
            "id": "120200115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "反抗军的大家还是老样子呢…",
            "nextDialogs": [
              "120200116"
            ]
          },
          "120200116": {
            "id": "120200116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了！说起来，是心海叫我们来参加庆功会的。五郎，你知道心海在哪里吗？",
            "nextDialogs": [
              "120200117"
            ]
          },
          "120200117": {
            "id": "120200117",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "珊瑚宫大人的话，现在应该是在望泷村。",
            "nextDialogs": [
              "120200118"
            ]
          },
          "120200118": {
            "id": "120200118",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "听说那边出了点事情，珊瑚宫大人应该会亲自过去处理。",
            "nextDialogs": [
              "120200119"
            ]
          },
          "120200119": {
            "id": "120200119",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "#我们也该离开了…另外，{NICKNAME}，你可以关注一下路上的士兵们。",
            "nextDialogs": [
              "120200120"
            ]
          },
          "120200120": {
            "id": "120200120",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "最近我感觉不少士兵都有些浮躁，不过我也不知道为什么，他们不想跟我说。",
            "nextDialogs": [
              "120200121"
            ]
          },
          "120200121": {
            "id": "120200121",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "以前大家有什么烦恼都会告诉我，现在却躲躲藏藏的…我很担心他们会不会是遇到了什么麻烦。"
          }
        }
      }
    },
    {
      "subId": "1202009",
      "subQuestName": "与五郎交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120200601"
        ],
        "dialogs": {
          "120200601": {
            "id": "120200601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里应该就是我们和心海相约见面的地方了。",
            "nextDialogs": [
              "120200602"
            ]
          },
          "120200602": {
            "id": "120200602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "旅行者，你还记得这里吗？",
            "nextDialogs": [
              "120200603"
            ]
          },
          "120200603": {
            "id": "120200603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "上次来海祇岛的时候，我们好像路过这里。",
            "nextDialogs": [
              "120200604"
            ]
          },
          "120200604": {
            "id": "120200604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "当时，你还当上了「剑鱼二番队」的队长。不知道过了这么久，反抗军的士兵们还记不记得你…",
            "nextDialogs": [
              "120200605"
            ]
          },
          "120200605": {
            "id": "120200605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "海祇岛上应该也有很多变化吧！不如我们先去附近转转如何？",
            "nextDialogs": [
              "120200627"
            ]
          },
          "120200627": {
            "id": "120200627",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，那不是五郎吗？我们过去看看吧！",
            "nextDialogs": [
              "120200606"
            ]
          },
          "120200606": {
            "id": "120200606",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "「敌众我寡，寻求突破；敌寡我众，务求全胜…」",
            "nextDialogs": [
              "120200607"
            ]
          },
          "120200607": {
            "id": "120200607",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "「临海之盗，必有运船；焚船而战，可得全功…」",
            "nextDialogs": [
              "120200608"
            ]
          },
          "120200608": {
            "id": "120200608",
            "speakerId": 12097,
            "speakerName": "利彦",
            "text": "五郎大人，有结论了吗？",
            "nextDialogs": [
              "120200609"
            ]
          },
          "120200609": {
            "id": "120200609",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "嗯。根据珊瑚宫大人留下的锦囊，可以推断出愚人众必定有船停泊在附近，所以才如此嚣张。",
            "nextDialogs": [
              "120200610"
            ]
          },
          "120200610": {
            "id": "120200610",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "我们可以分成两队，一队吸引他们的注意，另一队绕后烧掉他们的船，这样他们就逃不掉了！",
            "nextDialogs": [
              "120200611"
            ]
          },
          "120200611": {
            "id": "120200611",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "但珊瑚宫大人也说，兵力不足的情况下，尽量不要分兵。否则很容易被各个击破，导致全线崩溃…",
            "nextDialogs": [
              "120200612"
            ]
          },
          "120200612": {
            "id": "120200612",
            "speakerId": 12098,
            "speakerName": "幸德",
            "text": "要不我回去求援？",
            "nextDialogs": [
              "120200613"
            ]
          },
          "120200613": {
            "id": "120200613",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "恐怕来不及。看他们的动向，应该是准备离开了。",
            "nextDialogs": [
              "120200614"
            ]
          },
          "120200614": {
            "id": "120200614",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "珊瑚宫大人的锦囊里还写了，「设伏于野，不可妄动」。既然这次兵力不够，就只能暂时放弃了。",
            "nextDialogs": [
              "120200615"
            ]
          },
          "120200615": {
            "id": "120200615",
            "speakerId": 12097,
            "speakerName": "利彦",
            "text": "难道要眼睁睁地看着这些家伙离开吗？我不甘心！",
            "nextDialogs": [
              "120200616"
            ]
          },
          "120200616": {
            "id": "120200616",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "其实，珊瑚宫大人的锦囊里还有一句「山穷水尽，或有援军」。不过我没懂，援军指的是…",
            "nextDialogs": [
              "120200617"
            ]
          },
          "120200617": {
            "id": "120200617",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "五郎，你们怎么在这里呀？",
            "nextDialogs": [
              "120200618"
            ]
          },
          "120200618": {
            "id": "120200618",
            "speakerId": 12098,
            "speakerName": "幸德",
            "text": "队长！你回海祇岛了？",
            "nextDialogs": [
              "120200619"
            ]
          },
          "120200619": {
            "id": "120200619",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "来助你们一臂之力。",
            "nextDialogs": [
              "120200620"
            ]
          },
          "120200620": {
            "id": "120200620",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "#太好了！珊瑚宫大人的锦囊果然没错…{NICKNAME}，你来得正好。",
            "nextDialogs": [
              "120200621"
            ]
          },
          "120200621": {
            "id": "120200621",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "最近愚人众残党异常活跃，这次我们察觉到了他们的动向，提前埋伏在这里。",
            "nextDialogs": [
              "120200622"
            ]
          },
          "120200622": {
            "id": "120200622",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "可惜我们人数不够，无法做到兵分两路…能拜托你帮忙牵制一下吗？",
            "nextDialogs": [
              "120200623"
            ]
          },
          "120200623": {
            "id": "120200623",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧。说不定愚人众又要干什么坏事，我们也不能放任不管。",
            "nextDialogs": [
              "120200624"
            ]
          },
          "120200624": {
            "id": "120200624",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "好！事不宜迟，我带人绕后烧毁他们的船，之后回来与你会合。",
            "nextDialogs": [
              "120200625"
            ]
          },
          "120200625": {
            "id": "120200625",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "务必小心，我们很快就回来。",
            "nextDialogs": [
              "120200626"
            ]
          },
          "120200626": {
            "id": "120200626",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来反抗军的大家都还记得我们呢！我们也帮他们好好解决一下眼前的麻烦吧！"
          }
        }
      }
    },
    {
      "subId": "1202002",
      "subQuestName": "击败游荡的愚人众",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120200201"
        ],
        "dialogs": {
          "120200201": {
            "id": "120200201",
            "speakerId": 12059,
            "speakerName": "传次郎",
            "text": "你是…剑鱼二番队的队长？",
            "nextDialogs": [
              "120200202"
            ]
          },
          "120200202": {
            "id": "120200202",
            "speakerId": 12059,
            "speakerName": "传次郎",
            "text": "我认得你！多亏了你，海祇岛才有现在的和平。",
            "nextDialogs": [
              "120200203"
            ]
          },
          "120200203": {
            "id": "120200203",
            "speakerId": 12059,
            "speakerName": "传次郎",
            "text": "我虽然不是剑鱼二番队的成员，但当初在踏鞴砂的时候，我就见过你了。",
            "nextDialogs": [
              "120200204"
            ]
          },
          "120200204": {
            "id": "120200204",
            "speakerId": 12059,
            "speakerName": "传次郎",
            "text": "当时两军对垒，你在阵前比武中单挑好几个幕府武士，帅得不行！",
            "nextDialogs": [
              "120200205"
            ]
          },
          "120200205": {
            "id": "120200205",
            "speakerId": 12059,
            "speakerName": "传次郎",
            "text": "有什么需要我帮忙的吗？我在所不辞！",
            "nextDialogs": [
              "120200206"
            ]
          },
          "120200206": {
            "id": "120200206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于最近发生的事…",
            "nextDialogs": [
              "120200207"
            ]
          },
          "120200207": {
            "id": "120200207",
            "speakerId": 12059,
            "speakerName": "传次郎",
            "text": "大家很浮躁啊…确实，我也感觉到了。",
            "nextDialogs": [
              "120200208"
            ]
          },
          "120200208": {
            "id": "120200208",
            "speakerId": 12059,
            "speakerName": "传次郎",
            "text": "可能是大家还没有从战争中走出来吧。那时候在战场上，随时都可能牺牲，每个人都很紧张。",
            "nextDialogs": [
              "120200209"
            ]
          },
          "120200209": {
            "id": "120200209",
            "speakerId": 12059,
            "speakerName": "传次郎",
            "text": "突然战争结束了，才发现不知道要怎么回归正常的生活…哈哈，我觉得没关系，过段时间说不定就好啦。",
            "nextDialogs": [
              "120200210"
            ]
          },
          "120200210": {
            "id": "120200210",
            "speakerId": 12059,
            "speakerName": "传次郎",
            "text": "别的我也不知道了。不过，有珊瑚宫大人在，海祇岛就不会有事，我们都深信这一点。",
            "nextDialogs": [
              "120200211"
            ]
          },
          "120200211": {
            "id": "120200211",
            "speakerId": 12059,
            "speakerName": "传次郎",
            "text": "现在你也回来了，这里就更安全了！如果有什么需要，可以随时来找我！",
            "nextDialogs": [
              "120200212"
            ]
          },
          "120200212": {
            "id": "120200212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉他很热情呢…我们再去问问下一个人吧。"
          }
        }
      }
    },
    {
      "subId": "1202003",
      "subQuestName": "回复五郎",
      "sceneId": null,
      "locations": [],

{
  "lineCounts": {
    "Player": 14,
    "五郎": 22,
    "传次郎": 11,
    "内村": 5,
    "利彦": 2,
    "嘉久": 8,
    "幸德": 6,
    "恒雄": 6,
    "愚人众先遣队": 3,

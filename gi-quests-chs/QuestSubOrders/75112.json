    {
      "subId": "7511202",
      "subQuestName": "test钻地龙NPC挑战2$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751120201"
        ],
        "dialogs": {
          "751120201": {
            "id": "751120201",
            "speakerId": 1001,
            "speakerName": "森塔加",
            "text": "哼哼，异邦的勇士，我从很远的地方就感受到了你的气息，真是了不起啊。",
            "nextDialogs": [
              "751120204"
            ]
          },
          "751120204": {
            "id": "751120204",
            "speakerId": 1001,
            "speakerName": "森塔加",
            "text": "要不要来试试为部族战士准备的「勇士挑战」，不说大话，我准备的试炼一定会能让你受益匪浅哦。"
          }
        }
      }
    },
    {
      "subId": "7511203",
      "subQuestName": "test钻地龙NPC挑战3$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751120301"
        ],
        "dialogs": {
          "751120301": {
            "id": "751120301",
            "speakerId": 1002,
            "speakerName": "希乌休",
            "text": "唔…异邦的勇士，我有一事相求。",
            "nextDialogs": [
              "751120304"
            ]
          },
          "751120304": {
            "id": "751120304",
            "speakerId": 1002,
            "speakerName": "希乌休",
            "text": "我是部族里的「训练大师」，只不过，我的能力与这个头衔还并不相称，吃不准所安排的「勇士挑战」的难度…",
            "nextDialogs": [
              "751120305"
            ]
          },
          "751120305": {
            "id": "751120305",
            "speakerId": 1002,
            "speakerName": "希乌休",
            "text": "所以，能请您帮忙试试看吗？"
          }
        }
      }
    },
    {
      "subId": "7511204",
      "subQuestName": "test勾爪龙NPC挑战1$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751120401"
        ],
        "dialogs": {
          "751120401": {
            "id": "751120401",
            "speakerId": 1003,
            "speakerName": "莉莉尤",
            "text": "身为「悬木人」的人，轻捷而灵巧的移动是必须的素质，这也是我准备「勇士挑战」的原因。",
            "nextDialogs": [
              "751120404"
            ]
          },
          "751120404": {
            "id": "751120404",
            "speakerId": 1003,
            "speakerName": "莉莉尤",
            "text": "怎么样，异邦的勇士，有没有兴趣进行尝试呢？"
          }
        }
      }
    },
    {
      "subId": "7511205",
      "subQuestName": "test勾爪龙NPC挑战2$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751120501"
        ],
        "dialogs": {
          "751120501": {
            "id": "751120501",
            "speakerId": 1004,
            "speakerName": "奇玛",
            "text": "哦，是很少见的异邦的客人呢…怎么样，要试试「勇士挑战」吗？",
            "nextDialogs": [
              "751120504"
            ]
          },
          "751120504": {
            "id": "751120504",
            "speakerId": 1004,
            "speakerName": "奇玛",
            "text": "在纳塔，有很多这样的为部族勇士们准备的试炼和挑战，嗯，我呢，就是那些负责安排挑战的人的其中一员。",
            "nextDialogs": [
              "751120505"
            ]
          },
          "751120505": {
            "id": "751120505",
            "speakerId": 1004,
            "speakerName": "奇玛",
            "text": "异邦的客人看上去很强嘛，要来尝试进行我准备的挑战吗？"
          }
        }
      }
    },
    {
      "subId": "7511206",
      "subQuestName": "test勾爪龙NPC挑战3$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

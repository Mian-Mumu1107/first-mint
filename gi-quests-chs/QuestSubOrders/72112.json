    {
      "subId": "7211235",
      "subQuestName": "（test）抽签引导对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721123501"
        ],
        "dialogs": {
          "721123501": {
            "id": "721123501",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "你要求签？",
            "nextDialogs": [
              "721123502"
            ]
          },
          "721123502": {
            "id": "721123502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，好冷淡。",
            "nextDialogs": [
              "721123503"
            ]
          },
          "721123503": {
            "id": "721123503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我想求签…",
            "nextDialogs": [
              "721123504"
            ]
          },
          "721123504": {
            "id": "721123504",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "明白了。流程是这样的。首先请你用力摇晃这个什么东西。",
            "nextDialogs": [
              "721123505"
            ]
          },
          "721123505": {
            "id": "721123505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "记得是叫「御神签箱」…",
            "nextDialogs": [
              "721123506"
            ]
          },
          "721123506": {
            "id": "721123506",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "没错。从里面会掉出一根竹签。把这根竹签给我，我会给你对应的纸片儿。",
            "nextDialogs": [
              "721123507"
            ]
          },
          "721123507": {
            "id": "721123507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好像叫「御神签」来着…",
            "nextDialogs": [
              "721123508"
            ]
          },
          "721123508": {
            "id": "721123508",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "这种事情怎样都好吧。",
            "nextDialogs": [
              "721123509"
            ]
          },
          "721123509": {
            "id": "721123509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我有问题！如果说，如果说我们抽到了凶签，要怎么办呢？",
            "nextDialogs": [
              "721123510"
            ]
          },
          "721123510": {
            "id": "721123510",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "是命运让你抽到凶签，你还想怎样？啊？",
            "nextDialogs": [
              "721123511"
            ]
          },
          "721123511": {
            "id": "721123511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！",
            "nextDialogs": [
              "721123512"
            ]
          },
          "721123512": {
            "id": "721123512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "外头那个像架子的东西…",
            "nextDialogs": [
              "721123513"
            ]
          },
          "721123513": {
            "id": "721123513",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "啧。",
            "nextDialogs": [
              "721123514"
            ]
          },
          "721123514": {
            "id": "721123514",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她很露骨地「啧」了耶！",
            "nextDialogs": [
              "721123515"
            ]
          },
          "721123515": {
            "id": "721123515",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "我看看…是这样的。「把凶签捆到『御签挂』上，就可以逢凶化吉」。",
            "nextDialogs": [
              "721123516"
            ]
          },
          "721123516": {
            "id": "721123516",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "啊，对哦！如果你抽到凶签，把它捆到那个架子上就行了嘛。",
            "nextDialogs": [
              "721123517"
            ]
          },
          "721123517": {
            "id": "721123517",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "他们还真是…不对，我们「鸣神大社」很温柔的。所以就算抽到了凶签，也会给你们转运的机会。",
            "nextDialogs": [
              "721123518"
            ]
          },
          "721123518": {
            "id": "721123518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然感觉哪里好像怪怪的…",
            "nextDialogs": [
              "721123519"
            ]
          },
          "721123519": {
            "id": "721123519",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们求签吧！"
          }
        }
      }
    },
    {
      "subId": "7211236",
      "subQuestName": "（test）解签引导对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721123601"
        ],
        "dialogs": {
          "721123601": {
            "id": "721123601",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "把竹签交出来。",
            "nextDialogs": [
              "721123602"
            ]
          },
          "721123602": {
            "id": "721123602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好、好的。",
            "nextDialogs": [
              "721123603"
            ]
          },
          "721123603": {
            "id": "721123603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神社真是个不讲情面的地方…",
            "nextDialogs": [
              "721123604"
            ]
          },
          "721123604": {
            "id": "721123604",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "给你。",
            "nextDialogs": [
              "721123605"
            ]
          },
          "721123605": {
            "id": "721123605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔呣，看看运势吧。",
            "nextDialogs": [
              "721123606"
            ]
          },
          "721123606": {
            "id": "721123606",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "对了。每天只能求一次签，这点请你记住。",
            "nextDialogs": [
              "721123607"
            ]
          },
          "721123607": {
            "id": "721123607",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "不然我会很累…不对，不然御签挂会挂不下…也不是，应该怎么说来着？",
            "nextDialogs": [
              "721123608"
            ]
          },
          "721123608": {
            "id": "721123608",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "「御神签是神明意志的体现。所以要尊重神明的意志，并且尽人所能及之力。」",
            "nextDialogs": [
              "721123609"
            ]
          },
          "721123609": {
            "id": "721123609",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "你看，写得真好。所以每天只能求一次签，记好了。"
          }
        }
      }
    },
    {

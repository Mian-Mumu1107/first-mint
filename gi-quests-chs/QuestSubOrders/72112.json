    {
      "subId": "7211220",
      "subQuestName": "（test）检测焰刀对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130701"
        ],
        "dialogs": {
          "721130701": {
            "id": "721130701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "玄冬小姐的态度还是老样子…不管怎样，先看看签文吧。",
            "nextDialogs": [
              "721130702"
            ]
          },
          "721130702": {
            "id": "721130702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？这是…",
            "nextDialogs": [
              "721130703"
            ]
          },
          "721130703": {
            "id": "721130703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我明白了，这是需要对付的坏蛋吧！",
            "nextDialogs": [
              "721130704"
            ]
          },
          "721130704": {
            "id": "721130704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，原来如此。原来玄冬小姐是谍报人员，通过这种方式接头，扫除对稻妻不利的人。",
            "nextDialogs": [
              "721130705"
            ]
          },
          "721130705": {
            "id": "721130705",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "好吵。",
            "nextDialogs": [
              "721130706"
            ]
          },
          "721130706": {
            "id": "721130706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫！对、对不起！不要对我们降下「终末」！",
            "nextDialogs": [
              "721130707"
            ]
          },
          "721130707": {
            "id": "721130707",
            "speakerId": 15465,
            "speakerName": "玄冬林檎",
            "text": "赶紧走开。",
            "nextDialogs": [
              "721130708"
            ]
          },
          "721130708": {
            "id": "721130708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们这就走！到画里的地方看看，能不能找到目标！"
          }
        }
      }
    },

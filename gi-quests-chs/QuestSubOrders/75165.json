          }
        }
      }
    },
    {
      "subId": "7516506",
      "subQuestName": "与前面的二人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751650901"
        ],
        "dialogs": {
          "751650901": {
            "id": "751650901",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "伊伊马尼，你好像又胖了，恭喜！",
            "nextDialogs": [
              "751650902"
            ]
          },
          "751650902": {
            "id": "751650902",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "哈哈，谢谢你，苏里奎。",
            "nextDialogs": [
              "751650903"
            ]
          },
          "751650903": {
            "id": "751650903",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "好消息，我这些天又劝住了一个想减肥的瘦子。",
            "nextDialogs": [
              "751650904"
            ]
          },
          "751650904": {
            "id": "751650904",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "哦，很了不起啊，大好事！",
            "nextDialogs": [
              "751650905"
            ]
          },
          "751650905": {
            "id": "751650905",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "欸，是你，怎么样，这几天有好好吃饭吧？",
            "nextDialogs": [
              "751650907",
              "751650909"
            ]
          },
          "751650907": {
            "id": "751650907",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "很好，就应该多吃饭，吃得胖胖的才对。",
            "nextDialogs": [
              "751650910"
            ]
          },
          "751650910": {
            "id": "751650910",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "伊伊马尼，我跟你说，这人的击罐记录很厉害，离我的最好成绩就差一点点。",
            "nextDialogs": [
              "751650911"
            ]
          },
          "751650911": {
            "id": "751650911",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "#{M#他}{F#她}也在我这里接受过挑战，成绩也不错。",
            "nextDialogs": [
              "751650912"
            ]
          },
          "751650912": {
            "id": "751650912",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "可以啊，没想到你这么厉害，居然差一点就超过我们两个。",
            "nextDialogs": [
              "751650913"
            ]
          },
          "751650913": {
            "id": "751650913",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "#我觉得{M#他}{F#她}再长胖点，说不定真的能超过我们…",
            "nextDialogs": [
              "751650914"
            ]
          },
          "751650914": {
            "id": "751650914",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "嗯，很有可能。虽然从我的角度来看，你有点太苗条了，还有长胖的空间，不过嘛…",
            "nextDialogs": [
              "751650915"
            ]
          },
          "751650915": {
            "id": "751650915",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "我认可你了！",
            "nextDialogs": [
              "751650916"
            ]
          },
          "751650916": {
            "id": "751650916",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "我也认可你了！",
            "nextDialogs": [
              "751650917"
            ]
          },
          "751650917": {
            "id": "751650917",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "但我还是建议你每顿饭最好多吃点。",
            "nextDialogs": [
              "751650918"
            ]
          },
          "751650918": {
            "id": "751650918",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "不要节食，不要减肥，我们会失望的。"
          },
          "751650909": {
            "id": "751650909",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "这不好，没有什么事情比好好吃饭更重要。"
          }
        }
      }
    },
    {
      "subId": "7516509",

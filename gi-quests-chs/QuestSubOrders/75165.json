    },
    {
      "subId": "7516507",
      "subQuestName": "完成苏里奎的挑战",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751650701"
        ],
        "dialogs": {
          "751650701": {
            "id": "751650701",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "哼哼，你的成绩很不错，但比起我来，还差那么一点。",
            "nextDialogs": [
              "751650702"
            ]
          },
          "751650702": {
            "id": "751650702",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "长期保持微胖体型、但又从来没有疏于训练的我，论灵活性和冲击力，绝对不是那些愚蠢的健身狂能比的。",
            "nextDialogs": [
              "751650703"
            ]
          },
          "751650703": {
            "id": "751650703",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "放弃对肌肉的追求，和我一起赞美伟大的脂肪吧！"
          }
        }
      }
    },
    {
      "subId": "7516503",
      "subQuestName": "完成苏里奎的挑战",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751650301"
        ],
        "dialogs": {
          "751650301": {
            "id": "751650301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "需要准备一下。",
            "nextDialogs": [
              "751650302"
            ]
          },
          "751650302": {
            "id": "751650302",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "没问题，你准备好的话，随时可以再来。"
          }
        }
      }
    },
    {
      "subId": "7516511",
      "subQuestName": "晚些时候来看看",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751651101"
        ],
        "dialogs": {
          "751651101": {
            "id": "751651101",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "来试试吧，以你最快的速度通过这片训练场，但注意<color=#00E1FFFF>不要打破任何罐子</color>！",
            "nextDialogs": [
              "751651102"
            ]
          },
          "751651102": {
            "id": "751651102",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "看看你的成绩有多好，是否能超过我。"
          }
        }
      }
    },
    {
      "subId": "7516504",
      "subQuestName": "完成伊伊马尼的挑战",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751651201"
        ],
        "dialogs": {
          "751651201": {
            "id": "751651201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "让我试一试。"
          }
        }
      }
    },
    {
      "subId": "7516508",
      "subQuestName": "完成伊伊马尼的挑战",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751650801"
        ],
        "dialogs": {
          "751650801": {
            "id": "751650801",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "你的成绩很不错嘛，但是呢，说实话…这不是我夸口，我的最佳记录确实在你之上。",
            "nextDialogs": [
              "751650802"
            ]
          },
          "751650802": {
            "id": "751650802",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "人嘛，总会有这么一两项自己做得好的事。",
            "nextDialogs": [
              "751650803"
            ]
          },
          "751650803": {
            "id": "751650803",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "这下你相信了吧，我这种体型的战士未必不敏捷，所以饭一定要好好吃，不要胡乱减肥！"
          }
        }
      }
    },
    {
      "subId": "7516505",

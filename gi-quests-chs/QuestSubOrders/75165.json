    {
      "subId": "7516502",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751650201"
        ],
        "dialogs": {
          "751650201": {
            "id": "751650201",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "路过的勇士，既然会来到特特奥坎，你也是追寻力量的人吧。",
            "nextDialogs": [
              "751650202"
            ]
          },
          "751650202": {
            "id": "751650202",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "或许你已经见过「沃陆之邦」的大力士们了，哼，多数都是些满身肌肉的人。",
            "nextDialogs": [
              "751650203"
            ]
          },
          "751650203": {
            "id": "751650203",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "不过看你身材挺苗条的，应该还没有变成每天疯狂举重卧推的健身狂。",
            "nextDialogs": [
              "751650204"
            ]
          },
          "751650204": {
            "id": "751650204",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "我跟你说，那些都是骗局，不要上当。",
            "nextDialogs": [
              "751650207"
            ]
          },
          "751650207": {
            "id": "751650207",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "也不能这么说，但鼓吹肌肉，认为勇士的力量来自于肌肉，这肯定是胡说八道。",
            "nextDialogs": [
              "751650208"
            ]
          },
          "751650208": {
            "id": "751650208",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "让我告诉你，古代英雄们的身上绝对不可能除了骨头就是肌肉。",
            "nextDialogs": [
              "751650209"
            ]
          },
          "751650209": {
            "id": "751650209",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "他们的生存环境比今天恶劣得多，在实战中更追求生存与防御，一定会保存适量的脂肪。",
            "nextDialogs": [
              "751650210"
            ]
          },
          "751650210": {
            "id": "751650210",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "他们的体型，应该就像我这样。",
            "nextDialogs": [
              "751650211"
            ]
          },
          "751650211": {
            "id": "751650211",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "我这样微胖的体型才是过去英雄们的体型，兼具冲击力与灵活性的体型。",
            "nextDialogs": [
              "751650212"
            ]
          },
          "751650212": {
            "id": "751650212",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "但部族的大家都不能认识到这一点，唉，太愚蠢了。",
            "nextDialogs": [
              "751650213"
            ]
          },
          "751650213": {
            "id": "751650213",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "看你的表情，好像不太相信的样子…嗯，这样好了。",
            "nextDialogs": [
              "751650214"
            ]
          },
          "751650214": {
            "id": "751650214",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "来试试看我准备的击罐挑战吧！这片场地原本是我为了锻炼自己准备的，借你用用也没什么问题。",
            "nextDialogs": [
              "751650215"
            ]
          },
          "751650215": {
            "id": "751650215",
            "speakerId": 6458,
            "speakerName": "苏里奎",
            "text": "你试一试就知道，大体型在实战中是多么的有力了！"
          }
        }
      }
    },
    {
      "subId": "7516504",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751650401"
        ],
        "dialogs": {
          "751650401": {
            "id": "751650401",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "路过的勇士，对，没错，就是你。",
            "nextDialogs": [
              "751650402"
            ]
          },
          "751650402": {
            "id": "751650402",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "唉，太瘦了…你有好好吃饭吗？",
            "nextDialogs": [
              "751650403",
              "751650407"
            ]
          },
          "751650403": {
            "id": "751650403",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "不论你有什么理由或者苦衷，首先，饭必须好好吃！",
            "nextDialogs": [
              "751650408"
            ]
          },
          "751650408": {
            "id": "751650408",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "既然你已经进入了特特奥坎，大概已经见过「沃陆之邦」的大力士了吧。",
            "nextDialogs": [
              "751650409"
            ]
          },
          "751650409": {
            "id": "751650409",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "出于良心，我要给你一个忠告，绝对不要相信那些一个劲鼓吹肌肉的家伙。",
            "nextDialogs": [
              "751650410"
            ]
          },
          "751650410": {
            "id": "751650410",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "神赐予我们的脂肪是宝贵的礼物，为了好看的肌肉，就戒掉所有好吃的东西，抛弃脂肪…",
            "nextDialogs": [
              "751650411"
            ]
          },
          "751650411": {
            "id": "751650411",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "这么做就是笨到家了，林猪都会同情你。",
            "nextDialogs": [
              "751650412"
            ]
          },
          "751650412": {
            "id": "751650412",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "而且要说什么是好看，吹捧肌肉好像也就是这几十年的事吧。",
            "nextDialogs": [
              "751650413"
            ]
          },
          "751650413": {
            "id": "751650413",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "我爷爷说，他年轻的时候，大家还是比较喜欢微胖的身材。",
            "nextDialogs": [
              "751650414"
            ]
          },
          "751650414": {
            "id": "751650414",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "所以，千万不要听人蛊惑，走上减肥的错误道路！",
            "nextDialogs": [
              "751650415"
            ]
          },
          "751650415": {
            "id": "751650415",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "但如果有一天，你跟「沃陆之邦」里我那些亲戚们一样，为了追求力量而选择了减肥…",
            "nextDialogs": [
              "751650416"
            ]
          },
          "751650416": {
            "id": "751650416",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "那我还有一句话：论敏捷，体型微胖的战士也可以做到像鱼一样灵活，论力量，那些瘦家伙根本不是我们的对手。",
            "nextDialogs": [
              "751650417"
            ]
          },
          "751650417": {
            "id": "751650417",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "要问证据的话，这片训练场里的罐子就是证据。",
            "nextDialogs": [
              "751650418"
            ]
          },
          "751650418": {
            "id": "751650418",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "以我的体型，要做到<color=#00E1FFFF>疾速通过而不打破罐子</color>轻而易举，这种程度的敏捷，就算是瘦子也未必做得到吧？",
            "nextDialogs": [
              "751650419"
            ]
          },
          "751650419": {
            "id": "751650419",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "看你那要笑又不好意思笑的表情…没关系没关系，我就知道你不相信。",
            "nextDialogs": [
              "751650420"
            ]
          },
          "751650420": {
            "id": "751650420",
            "speakerId": 6462,
            "speakerName": "伊伊马尼",
            "text": "来试试吧，以你最快的速度通过这片训练场，但注意<color=#00E1FFFF>不要打破任何罐子</color>！",
            "nextDialogs": [

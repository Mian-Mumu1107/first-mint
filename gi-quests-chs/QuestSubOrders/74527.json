      "dialogue": {
        "startDialogs": [
          "745270401"
        ],
        "dialogs": {
          "745270401": {
            "id": "745270401",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "#是你啊，{NICKNAME}。",
            "nextDialogs": [
              "745270404"
            ]
          },
          "745270404": {
            "id": "745270404",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "今天的我不负责烹饪，只是单纯地在试吃而已。",
            "nextDialogs": [
              "745270405"
            ]
          },
          "745270405": {
            "id": "745270405",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "莎凡娜想推出一道新菜品，拜托我来帮她把把关。但这道菜…已经是第五次重做了。",
            "nextDialogs": [
              "745270406"
            ]
          },
          "745270406": {
            "id": "745270406",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "不是火候差了几秒，影响了食材的口感；就是调味的比例偏高，让香料的味道喧宾夺主。",
            "nextDialogs": [
              "745270407"
            ]
          },
          "745270407": {
            "id": "745270407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "爱可菲还是那么严格啊。",
            "nextDialogs": [
              "745270408"
            ]
          },
          "745270408": {
            "id": "745270408",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "那是当然！烹饪可是一门科学，不会因为她是我朋友就变了味。不如说就是因为要对她和顾客负责，我才更得严格吧！"
          }
        }
      }
    }
  ]

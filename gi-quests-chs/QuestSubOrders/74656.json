        "dialogs": {
          "746560101": {
            "id": "746560101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于泡泡桔…",
            "nextDialogs": [
              "746560102"
            ]
          },
          "746560102": {
            "id": "746560102",
            "speakerId": 5020,
            "speakerName": "伊斯梅诺",
            "text": "那么年轻的朋友，你带了泡泡桔来吧？请分我一些，我们边吃边聊。",
            "nextDialogs": [
              "746560103"
            ]
          },
          "746560103": {
            "id": "746560103",
            "speakerId": 5020,
            "speakerName": "伊斯梅诺",
            "text": "雕塑是无言的诗，不要在饿着肚子的时候欣赏它们。这是一位决斗者在他人生最后一次决斗中告诉我的。",
            "nextDialogs": [
              "746560105"
            ]
          },
          "746560105": {
            "id": "746560105",
            "speakerId": 5020,
            "speakerName": "伊斯梅诺",
            "text": "我按照从别人那里听说的，准备了答谢你的泡泡桔的钱。这样的话，我好像该等到你准备好了再给…"
          }
        }
      }
    },
    {
      "subId": "7465602",
      "subQuestName": "与伊斯梅诺对话",

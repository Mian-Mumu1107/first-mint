  },
  "subQuests": [
    {
      "subId": "7421701",
      "subQuestName": "与加尔恰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742170101"
        ],
        "dialogs": {
          "742170101": {
            "id": "742170101",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "…我们必须立刻出发！立刻出发！",
            "nextDialogs": [
              "742170102"
            ]
          },
          "742170102": {
            "id": "742170102",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "冷静点，加尔恰，梅莘警官不都说了，佩特莉可镇已经恢复了正常吗？",
            "nextDialogs": [
              "742170103"
            ]
          },
          "742170103": {
            "id": "742170103",
            "speakerId": 20658,
            "speakerName": "路通",
            "text": "先生，相信俱乐部里那几位好先生吧，他们是足智多谋的人，这么一点危机必然影响不了他们。",
            "nextDialogs": [
              "742170104"
            ]
          },
          "742170104": {
            "id": "742170104",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "是的，是的。巴比斯是聪明的，梅康顿也颇有些计策，但他们都不懂如何对付坏心思！",
            "nextDialogs": [
              "742170105"
            ]
          },
          "742170105": {
            "id": "742170105",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "虽然我已经给他们寄了信，告诫了他们，但那卑劣的商人太明白如何转动坏脑筋！",
            "nextDialogs": [
              "742170106"
            ]
          },
          "742170106": {
            "id": "742170106",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "好人们，唉！好人们总是会在坏蛋面前受挫！",
            "nextDialogs": [
              "742170107"
            ]
          },
          "742170107": {
            "id": "742170107",
            "speakerId": 20658,
            "speakerName": "路通",
            "text": "那咱们想必只能寄希望于博絮埃先生了，希望枫丹科学院的智慧能带着俱乐部里的人们度过难关。",
            "nextDialogs": [
              "742170108"
            ]
          },
          "742170108": {
            "id": "742170108",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "哦，得了吧！我可不想空想俱乐部飞上天…",
            "nextDialogs": [
              "742170111"
            ]
          },
          "742170111": {
            "id": "742170111",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "#亲爱的{NICKNAME}！太好了，您总算来了！咱们出发！快快快！",
            "nextDialogs": [
              "742170112"
            ]
          },
          "742170112": {
            "id": "742170112",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "#很高兴见到您，{NICKNAME}，还有派蒙，看见你们如此健康，真是太好了。",
            "nextDialogs": [
              "742170113"
            ]
          },
          "742170113": {
            "id": "742170113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好呀，迦雅小姐！嘿嘿，总觉得迦雅小姐越来越漂亮了，是我的错觉吗？",
            "nextDialogs": [
              "742170114"
            ]
          },
          "742170114": {
            "id": "742170114",
            "speakerId": 20658,
            "speakerName": "路通",
            "text": "唔，有一句璃月诗是怎么说的来着？好像是…",
            "nextDialogs": [
              "742170115"
            ]
          },
          "742170115": {
            "id": "742170115",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "我记得，好像是…什么花丛懒回顾…我上次在一本诗集里读到过。",
            "nextDialogs": [
              "742170116"
            ]
          },
          "742170116": {
            "id": "742170116",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "谢谢，路通，你们璃月的诗真是包罗万象啊！那看在璃月诗文的份上，咱们快些出发吧。",
            "nextDialogs": [
              "742170117"
            ]
          },
          "742170117": {
            "id": "742170117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你脸红了。",
            "nextDialogs": [
              "742170118"
            ]
          },
          "742170118": {
            "id": "742170118",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "没有！天哪，是我担心风浪，多穿了些衣服，这时候觉得太热了而已！",
            "nextDialogs": [
              "742170119"
            ]
          },
          "742170119": {
            "id": "742170119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是这样吗？嘻嘻…从外面完全看不出加尔恰先生穿了很厚的衣服呢。",
            "nextDialogs": [
              "742170120"
            ]
          },
          "742170120": {
            "id": "742170120",
            "speakerId": 5043,
            "speakerName": "梅莘",
            "text": "噗…几位，我们去那边吧，都已经准备好了。",
            "nextDialogs": [
              "742170121"
            ]
          },
          "742170121": {
            "id": "742170121",
            "speakerId": 5043,
            "speakerName": "梅莘",
            "text": "抱歉，如果一开始就知道加尔恰先生这么怕冷，我就会去帮你们多准备些衣服了。",
            "nextDialogs": [
              "742170122"
            ]
          },
          "742170122": {
            "id": "742170122",
            "speakerId": 5043,
            "speakerName": "梅莘",
            "text": "请您先去佩特莉可镇吧，我要在这里等几位同事，过一会我们也会过去。"
          }
        }
      }
    },
    {
      "subId": "7421711",
      "subQuestName": "前往佩特莉可镇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7421702",
      "subQuestName": "前往佩特莉可镇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742170201"
        ],
        "dialogs": {
          "742170201": {
            "id": "742170201",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "啊…佩特莉可镇！我的故乡，多么美丽，多么熟悉！多么…",
            "nextDialogs": [
              "742170202"
            ]
          },
          "742170202": {
            "id": "742170202",
            "speakerId": 14069,
            "speakerName": "路通",
            "text": "多么安静…先生，您的故乡是以寂静出名的吗？",
            "nextDialogs": [
              "742170203"
            ]
          },
          "742170203": {
            "id": "742170203",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "当然不是，先不论别人，巴比斯和梅康顿每天都会弄出轰隆隆的响声…",
            "nextDialogs": [
              "742170204"
            ]
          },
          "742170204": {
            "id": "742170204",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "梅康顿，巴比斯…我们得先去俱乐部，跟我来！快！",
            "nextDialogs": [
              "742170205"
            ]
          },
          "742170205": {
            "id": "742170205",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "…那是真的？抑或是虚幻，我、我看见了…",
            "nextDialogs": [
              "742170206"
            ]
          },
          "742170206": {
            "id": "742170206",
            "speakerId": 5345,
            "speakerName": "巴比斯",
            "text": "我也无法分辨，但…",
            "nextDialogs": [
              "742170207"
            ]
          },
          "742170207": {
            "id": "742170207",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我…我都做了什么…多么可怕…",
            "nextDialogs": [
              "742170208"
            ]
          },
          "742170208": {
            "id": "742170208",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "梅康顿！巴比斯！看在俱乐部的份上，我还以为你们出事了！埃斯特在哪？格里斯潘呢？",
            "nextDialogs": [
              "742170209"
            ]
          },
          "742170209": {
            "id": "742170209",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "加尔恰？我是做梦了，还是说一直在梦中？老兄，你怎么回来了？",
            "nextDialogs": [
              "742170210"
            ]
          },
          "742170210": {
            "id": "742170210",
            "speakerId": 5345,
            "speakerName": "巴比斯",
            "text": "你们是…雷穆利亚…见鬼，不是，不是。我现在满脑子都是这些东西…",
            "nextDialogs": [
              "742170211"
            ]
          },
          "742170211": {
            "id": "742170211",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你是…加尔恰？",
            "nextDialogs": [
              "742170212"
            ]
          },
          "742170212": {
            "id": "742170212",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "…戈伦德兰，你又在打什么主意，你又抓住了这次机会？嗯？要把我们的研究据为己有？",
            "nextDialogs": [
              "742170213"
            ]
          },
          "742170213": {
            "id": "742170213",
            "speakerId": 5346,
            "speakerName": "戈伦德兰",
            "text": "我…我曾经是这么想，但是…但是…",
            "nextDialogs": [
              "742170214"
            ]
          },
          "742170214": {
            "id": "742170214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他就是之前觊觎你研究的人？",
            "nextDialogs": [
              "742170215"
            ]
          },
          "742170215": {
            "id": "742170215",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "是的！就是他，他雇人跟踪我们，派人进我的房间翻找，要把推数机据为己有。",
            "nextDialogs": [
              "742170216"
            ]
          },
          "742170216": {
            "id": "742170216",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "我就知道，在你意识到无法从我这里讨到好之后，你一定会来佩特莉可镇等我。我早就写了信…",
            "nextDialogs": [
              "742170217"
            ]
          },
          "742170217": {
            "id": "742170217",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "加尔恰，稍等。他好像有点不太对。",
            "nextDialogs": [
              "742170218"
            ]
          },
          "742170218": {
            "id": "742170218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，这里的所有人，好像都不太对…难、难道…",
            "nextDialogs": [
              "742170221"
            ]
          },
          "742170221": {
            "id": "742170221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你是说，他们也做了那种梦，在梦里变成了…其他的雷穆利亚人？",
            "nextDialogs": [
              "742170222"
            ]
          },
          "742170222": {
            "id": "742170222",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就像埃斯特一样。",
            "nextDialogs": [
              "742170223"
            ]
          },
          "742170223": {
            "id": "742170223",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对…对喔！如果他们一直都待在岛上，应该也被「福波斯」给…",
            "nextDialogs": [
              "742170224"
            ]
          },
          "742170224": {
            "id": "742170224",
            "speakerId": 5346,
            "speakerName": "戈伦德兰",
            "text": "…我…我的确这么想，加尔恰，我向你忏悔，我之前是一个粗陋的坏人，我…",
            "nextDialogs": [
              "742170225"
            ]
          },
          "742170225": {
            "id": "742170225",
            "speakerId": 14069,
            "speakerName": "路通",
            "text": "呃，先生，您的计划就是将他诱导来佩特莉可镇，然后用您这几位好朋友的人性光辉感化他吗？"
          }
        }
      }
    },
    {
      "subId": "7421703",
      "subQuestName": "拿回留声机",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742170301"
        ],
        "dialogs": {
          "742170301": {
            "id": "742170301",
            "speakerId": 1009,
            "speakerName": "断断续续的声音",
            "text": "…这些研究…大价钱…愉快的合作，相信我。",
            "nextDialogs": [
              "742170302"
            ]
          },
          "742170302": {
            "id": "742170302",
            "speakerId": 1009,
            "speakerName": "断断续续的声音",
            "text": "俱乐部的初衷…无偿提供…研究属于所有人…",
            "nextDialogs": [
              "742170303"
            ]
          },
          "742170303": {
            "id": "742170303",
            "speakerId": 1009,
            "speakerName": "断断续续的声音",
            "text": "与我合作…提供给更多人…专业的商贸渠道…"
          }
        }
      }
    },
    {
      "subId": "7421704",
      "subQuestName": "拿回留声机",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742170401"
        ],
        "dialogs": {
          "742170401": {
            "id": "742170401",
            "speakerId": 1009,
            "speakerName": "断断续续的声音",
            "text": "我们无法说服所有人…研究成果很多…",
            "nextDialogs": [
              "742170402"
            ]
          },
          "742170402": {
            "id": "742170402",
            "speakerId": 1009,
            "speakerName": "断断续续的声音",
            "text": "…只要您合作…保证您…第一位…最多分红…",
            "nextDialogs": [
              "742170403"
            ]
          },
          "742170403": {
            "id": "742170403",
            "speakerId": 1009,
            "speakerName": "断断续续的声音",
            "text": "…成为最有钱的研究者…想研究什么就研究什么…",
            "nextDialogs": [
              "742170404"
            ]
          },
          "742170404": {
            "id": "742170404",
            "speakerId": 1009,
            "speakerName": "断断续续的声音",
            "text": "前提…您得让加尔恰…原始资料…"
          }
        }
      }
    },
    {
      "subId": "7421705",
      "subQuestName": "拿回留声机",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742170501"
        ],
        "dialogs": {
          "742170501": {
            "id": "742170501",
            "speakerId": 1009,
            "speakerName": "断断续续的声音",
            "text": "…蠢货研究者…他们不及您智慧的万分之一…",
            "nextDialogs": [
              "742170502"
            ]
          },
          "742170502": {
            "id": "742170502",
            "speakerId": 1009,
            "speakerName": "断断续续的声音",
            "text": "合作…摩拉…大生意…实在不行，我们就让他吃点苦头…",
            "nextDialogs": [
              "742170503"
            ]
          },
          "742170503": {
            "id": "742170503",
            "speakerId": 1009,
            "speakerName": "断断续续的声音",
            "text": "…合同在这…在这签字…",
            "nextDialogs": [
              "742170504"
            ]
          },
          "742170504": {
            "id": "742170504",
            "speakerId": 1009,
            "speakerName": "断断续续的声音",
            "text": "…呃！？发生了什…",
            "nextDialogs": [
              "742170505"
            ]
          },
          "742170505": {
            "id": "742170505",
            "speakerId": 1009,
            "speakerName": "断断续续的声音",
            "text": "（留声机中传来了几声沉闷的倒地声，此后就再无人说话了。）"
          }
        }
      }
    },

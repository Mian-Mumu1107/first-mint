{
  "lineCounts": {
    "Black Screen": 3,
    "Player": 38,
    "加尔恰": 44,
    "博絮埃": 1,
    "巴比斯": 33,
    "戈伦德兰": 20,
    "断断续续的声音": 12,
    "梅康顿": 35,
    "梅莘": 3,

    {
      "subId": "7421707",
      "subQuestName": "与戈伦德兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742170701"
        ],
        "dialogs": {
          "742170701": {
            "id": "742170701",
            "speakerId": 5346,
            "speakerName": "戈伦德兰",
            "text": "感谢您，好心的小姐…但我的脑袋还是晕乎乎的…",
            "nextDialogs": [
              "742170702"
            ]
          },
          "742170702": {
            "id": "742170702",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "瞧，我就说有用，他们的脸色好看了不少。",
            "nextDialogs": [
              "742170703"
            ]
          },
          "742170703": {
            "id": "742170703",
            "speakerId": 20658,
            "speakerName": "路通",
            "text": "那您可得抓紧时间恢复了。",
            "nextDialogs": [
              "742170704"
            ]
          },
          "742170704": {
            "id": "742170704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不然就得让警官帮你恢复了。",
            "nextDialogs": [
              "742170705"
            ]
          },
          "742170705": {
            "id": "742170705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是就是，我们可是已经拿到证据，证明你是坏蛋了！",
            "nextDialogs": [
              "742170706"
            ]
          },
          "742170706": {
            "id": "742170706",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "感谢佩特莉可镇，你们回来了，拿到那些留声机了吗？",
            "nextDialogs": [
              "742170707"
            ]
          },
          "742170707": {
            "id": "742170707",
            "speakerId": 20658,
            "speakerName": "路通",
            "text": "当然，先生。我们的计划奏效了，巴比斯兄弟把这位聪明人的话全套了出来，就录在这些留声机里。",
            "nextDialogs": [
              "742170708"
            ]
          },
          "742170708": {
            "id": "742170708",
            "speakerId": 5346,
            "speakerName": "戈伦德兰",
            "text": "你们…你们误会了，我不否认我之前做的那些坏事，我是个彻头彻尾的混球，现在我只想补偿！",
            "nextDialogs": [
              "742170709"
            ]
          },
          "742170709": {
            "id": "742170709",
            "speakerId": 20658,
            "speakerName": "路通",
            "text": "…迦雅小姐，您的汤里，是否放了某些须弥的特色蘑菇？能让人眨眼间就回心转意的那种？",
            "nextDialogs": [
              "742170710"
            ]
          },
          "742170710": {
            "id": "742170710",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "没有，我只是简单地煮了锅鱼汤呀，就连香料也没放，只放了些盐。",
            "nextDialogs": [
              "742170712",
              "742170714"
            ]
          },
          "742170712": {
            "id": "742170712",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "谢谢您的夸奖，如果我真的有如此魅力…唔，想必也只能对某一个人生效。",
            "nextDialogs": [
              "742170715"
            ]
          },
          "742170715": {
            "id": "742170715",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "戈伦德兰，你又在打什么鬼主意？我明着和您说了吧。",
            "nextDialogs": [
              "742170716"
            ]
          },
          "742170716": {
            "id": "742170716",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "空想俱乐部的研究，绝不会用于赚一分钱，我们是研究者，不是见钱眼开的守财奴！",
            "nextDialogs": [
              "742170717"
            ]
          },
          "742170717": {
            "id": "742170717",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "加尔恰，等等，我…我愿意相信戈伦德兰。愿意相信他想要变成好人。",
            "nextDialogs": [
              "742170718"
            ]
          },
          "742170718": {
            "id": "742170718",
            "speakerId": 5345,
            "speakerName": "巴比斯",
            "text": "是的，我也赞同。无论如何，我愿意给他个机会。",
            "nextDialogs": [
              "742170719"
            ]
          },
          "742170719": {
            "id": "742170719",
            "speakerId": 20658,
            "speakerName": "路通",
            "text": "好吧，现在情况更复杂了，我们得把你们一起送给医生看看。",
            "nextDialogs": [
              "742170720"
            ]
          },
          "742170720": {
            "id": "742170720",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "不，不，加尔恰，你听我说。我们…我们曾经一同经历了一场巨大的梦境。",
            "nextDialogs": [
              "742170721"
            ]
          },
          "742170721": {
            "id": "742170721",
            "speakerId": 5345,
            "speakerName": "巴比斯",
            "text": "在梦境里，我们变成了石头雕像，也不全是石头雕像，我们依然能思考，能看，能听。",
            "nextDialogs": [
              "742170722"
            ]
          },
          "742170722": {
            "id": "742170722",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "我能感觉到，那石头雕像里除了我之外，还有另外一个人。",
            "nextDialogs": [
              "742170723"
            ]
          },
          "742170723": {
            "id": "742170723",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "我通过他的眼睛在看，通过他的耳朵在听，通过他的灵魂跟着他思考…我是他，但又不是他！",
            "nextDialogs": [
              "742170724"
            ]
          },
          "742170724": {
            "id": "742170724",
            "speakerId": 5346,
            "speakerName": "戈伦德兰",
            "text": "我也是，我…我感受着那人，他是个富有理想和智慧的好人，一直在研究，在工作，但却不是为了自己。",
            "nextDialogs": [
              "742170725"
            ]
          },
          "742170725": {
            "id": "742170725",
            "speakerId": 5346,
            "speakerName": "戈伦德兰",
            "text": "他就像是跟随着某人的指挥棒转圈，自己却毫无察觉。他…他度过了多么可怕的一生，呜呜呜呜…",
            "nextDialogs": [
              "742170726"
            ]
          },
          "742170726": {
            "id": "742170726",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呜哇，{NICKNAME}，他说的这个「指挥棒」难道就是…"
          },
          "742170714": {
            "id": "742170714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这镇子确实很漂亮，但也没漂亮到那个程度啦…"
          }
        }
      }
    },
    {
      "subId": "7421708",
      "subQuestName": "前往雷穆利亚",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742170801"
        ],
        "dialogs": {
          "742170801": {
            "id": "742170801",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "没想到我们第一次潜水，居然是为了寻找一个梦里的城市，多么有趣。",
            "nextDialogs": [
              "742170802"
            ]
          },
          "742170802": {
            "id": "742170802",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "是啊…而且还是一座距离现在不知道多久，应该早已被埋没在时光里的城市…",
            "nextDialogs": [
              "742170803"
            ]
          },
          "742170803": {
            "id": "742170803",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "…虽然我们还没找到那座城市，但这座…钟，已经足够震撼了。",
            "nextDialogs": [
              "742170804"
            ]
          },
          "742170804": {
            "id": "742170804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "巴比斯先生，你们对周围的环境有什么熟悉感吗？",
            "nextDialogs": [
              "742170805"
            ]
          },
          "742170805": {
            "id": "742170805",
            "speakerId": 5345,
            "speakerName": "巴比斯",
            "text": "不，抱歉…我们当时似乎处于某个室内，一动也不能动。",
            "nextDialogs": [
              "742170806"
            ]
          },
          "742170806": {
            "id": "742170806",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "就像是一座石像。",
            "nextDialogs": [
              "742170807"
            ]
          },
          "742170807": {
            "id": "742170807",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "石像？但按你们的说法，那尊石像还有着不同于你们的意识？那你们简直就像…",
            "nextDialogs": [
              "742170808"
            ]
          },
          "742170808": {
            "id": "742170808",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "就像是一个跨越了时空与梦境，附着在「石像」身后的「影子」…真可惜，我没有做那场梦。",
            "nextDialogs": [
              "742170809"
            ]
          },
          "742170809": {
            "id": "742170809",
            "speakerId": 14069,
            "speakerName": "路通",
            "text": "小姐，要是您也变成了石像的影子，那我和先生就不得不去询问枫丹廷的每一块石头了。",
            "nextDialogs": [
              "742170810"
            ]
          },
          "742170810": {
            "id": "742170810",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "咳…咱们还是继续往前走走，找找梅康顿兄弟的「石像」吧。",
            "nextDialogs": [
              "742170811"
            ]
          },
          "742170811": {
            "id": "742170811",
            "speakerId": 5346,
            "speakerName": "戈伦德兰",
            "text": "…就在前面！我记起来了，我曾经从这里走过！",
            "nextDialogs": [
              "742170812"
            ]
          },
          "742170812": {
            "id": "742170812",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "喂！戈伦德兰！见鬼，站住！",
            "nextDialogs": [
              "742170813"
            ]
          },
          "742170813": {
            "id": "742170813",
            "speakerId": 20657,
            "speakerName": "加尔恰",
            "text": "#{NICKNAME}！拜托你和梅康顿他们一起走，我去抓住戈伦德兰！",
            "nextDialogs": [
              "742170814"
            ]
          },
          "742170814": {
            "id": "742170814",
            "speakerId": 14069,
            "speakerName": "路通",
            "text": "是的，先生，我会看好迦雅小姐的…虽然您还没来得及对我说这句话。",
            "nextDialogs": [
              "742170815"
            ]
          },
          "742170815": {
            "id": "742170815",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "#噗…他这么有精神真是太好了。{NICKNAME}，那咱们就继续往前走吧。",
            "nextDialogs": [
              "742170816"
            ]
          },
          "742170816": {
            "id": "742170816",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "希望梅康顿兄弟的「石像」不会太难找。"
          }
        }
      }
    },
    {
      "subId": "7421710",
      "subQuestName": "寻找众人的「影子」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742171001"
        ],
        "dialogs": {
          "742171001": {
            "id": "742171001",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "…是你，没错，我梦见过你。",
            "nextDialogs": [
              "742171002"
            ]
          },
          "742171002": {
            "id": "742171002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他就是…",
            "nextDialogs": [
              "742171003"
            ]
          },
          "742171003": {
            "id": "742171003",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "是的。在梦里，我就是他的「影子」。",
            "nextDialogs": [
              "742171004"
            ]
          },
          "742171004": {
            "id": "742171004",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "他似乎是在研究着「高空水道」，即使是在石像里，他也不断在脑子里思考着各种工程细节。",
            "nextDialogs": [
              "742171005"
            ]
          },
          "742171005": {
            "id": "742171005",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "如何在复杂地形上架设道路，建设轨道时要选用什么材料，水道的长度，宽度…",
            "nextDialogs": [
              "742171006"
            ]
          },
          "742171006": {
            "id": "742171006",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "这就是他整个人生中真正的幸福…除此之外，他别无所想。",
            "nextDialogs": [
              "742171007"
            ]
          },
          "742171007": {
            "id": "742171007",
            "speakerId": 5345,
            "speakerName": "巴比斯",
            "text": "而我在这里。思考着某种奇怪巡轨船的设计方案…这也是…真正的幸福。",
            "nextDialogs": [
              "742171008"
            ]
          },
          "742171008": {
            "id": "742171008",
            "speakerId": 5345,
            "speakerName": "巴比斯",
            "text": "他思索着巡轨船的规格，样式，制作所需的时间…",
            "nextDialogs": [
              "742171009"
            ]
          },
          "742171009": {
            "id": "742171009",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们就算是变成了石像也待在一起啊，这是什么不解的缘分…",
            "nextDialogs": [
              "742171012"
            ]
          },
          "742171012": {
            "id": "742171012",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "我尊敬他们对研究的热爱，但我同样…也为他们感到难过。",
            "nextDialogs": [
              "742171013"
            ]
          },
          "742171013": {
            "id": "742171013",
            "speakerId": 5345,
            "speakerName": "巴比斯",
            "text": "我也一样，我向他致敬，但也同样要为他默哀。"
          }
        }
      }
    },
    {
      "subId": "7421712",
      "subQuestName": "捞起石像",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7421713",
      "subQuestName": "返回岸上与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742171301"
        ],
        "dialogs": {
          "742171301": {
            "id": "742171301",
            "speakerId": 5346,
            "speakerName": "戈伦德兰",
            "text": "是你…是你，没错，我梦里的那个人就是你。",
            "nextDialogs": [
              "742171302"
            ]
          },
          "742171302": {
            "id": "742171302",
            "speakerId": 5346,
            "speakerName": "戈伦德兰",
            "text": "你…你是「雷穆利亚科学院」的院长，统管着所有研究项目，一切都井井有条，这就是真正的幸福…",
            "nextDialogs": [
              "742171303"
            ]
          },
          "742171303": {
            "id": "742171303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？等一下，你们怎么都在重复「这就是真正的幸福」呀？",
            "nextDialogs": [
              "742171304"
            ]
          },
          "742171304": {
            "id": "742171304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喜欢研究是很不错啦，但一般来说，不会总是强调这是真正的幸福…吧。总觉得有点可怕…",
            "nextDialogs": [
              "742171305"
            ]
          },
          "742171305": {
            "id": "742171305",
            "speakerId": 5345,
            "speakerName": "巴比斯",
            "text": "但是，这就是石像里的人不断向自己强调的念头。而且他们全身心地相信着这个念头。",
            "nextDialogs": [
              "742171308"
            ]
          },
          "742171308": {
            "id": "742171308",
            "speakerId": 5346,
            "speakerName": "戈伦德兰",
            "text": "他是个好人，即使变成了石像，也在担心着其他研究员，也担心着未完成的研究项目，还不断为此自责…",
            "nextDialogs": [
              "742171309"
            ]
          },
          "742171309": {
            "id": "742171309",
            "speakerId": 5346,
            "speakerName": "戈伦德兰",
            "text": "但这不对劲，但我就是说不出来！等到梦醒了之后，巴比斯先生才告诉了我究竟哪里不对劲。",
            "nextDialogs": [
              "742171310"
            ]
          },
          "742171310": {
            "id": "742171310",
            "speakerId": 5346,
            "speakerName": "戈伦德兰",
            "text": "他们满脑子研究事务，就是从来没有考虑过自己啊！",
            "nextDialogs": [
              "742171311"
            ]
          },
          "742171311": {
            "id": "742171311",
            "speakerId": 5345,
            "speakerName": "巴比斯",
            "text": "这个好人和石像里的所有人一样，都身不由己，只是跟随着那根无形的指挥棒绕来绕去。",
            "nextDialogs": [
              "742171312"
            ]
          },
          "742171312": {
            "id": "742171312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们怎么发现他们「身不由己」的？",
            "nextDialogs": [
              "742171313"
            ]
          },
          "742171313": {
            "id": "742171313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀，你们最开始也不知道「福波斯」的事吧？",
            "nextDialogs": [
              "742171314"
            ]
          },
          "742171314": {
            "id": "742171314",
            "speakerId": 5344,
            "speakerName": "梅康顿",
            "text": "因为我们发现了，他们所缺少的一件东西。",
            "nextDialogs": [
              "742171315"
            ]
          },
          "742171315": {
            "id": "742171315",
            "speakerId": 5345,
            "speakerName": "巴比斯",
            "text": "他们缺少的，正是「空想」的念头。这是每一位研究者绝无可能缺少的。"
          }
        }
      }
    },
    {
      "subId": "7421714",
      "subQuestName": "返回佩特莉可镇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7421715",
      "subQuestName": "与戈伦德兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742171501"
        ],
        "dialogs": {
          "742171501": {
            "id": "742171501",
            "speakerId": 5346,
            "speakerName": "戈伦德兰",
            "text": "我不是…我不会成为那种折磨你的人，绝不会，绝不会…呜呜呜…",
            "nextDialogs": [
              "742171502"
            ]
          },
          "742171502": {
            "id": "742171502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "情绪…真的完全崩溃了呢…",
            "nextDialogs": [
              "742171503"
            ]
          },
          "742171503": {
            "id": "742171503",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "在梦里经历了他人的人生…又回到现实里，明白了那人经历着怎样的痛苦…",
            "nextDialogs": [
              "742171504"
            ]
          },
          "742171504": {
            "id": "742171504",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "本以为是大梦一场，却又被告知，梦里的经历都是真实的，自己所知晓的那个人的人生也是真实的。",
            "nextDialogs": [
              "742171507"
            ]
          },
          "742171507": {
            "id": "742171507",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "唉，我再去煮点喝的，加尔恰，你能来帮我吗？",
            "nextDialogs": [
              "742171508"
            ]
          },
          "742171508": {
            "id": "742171508",
            "speakerId": 14068,
            "speakerName": "加尔恰",
            "text": "好的，这就来。路通，你就在这里看着戈伦德兰，如果他是在装疯卖傻…",
            "nextDialogs": [
              "742171509"
            ]
          },
          "742171509": {
            "id": "742171509",
            "speakerId": 14069,
            "speakerName": "路通",
            "text": "我就会让他真的变傻。",
            "nextDialogs": [
              "742171510"
            ]
          },
          "742171510": {
            "id": "742171510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，巴比斯先生和梅康顿先生却很正常呢，也不哭也不闹的。",
            "nextDialogs": [
              "742171511"
            ]
          },
          "742171511": {
            "id": "742171511",
            "speakerId": 14066,
            "speakerName": "巴比斯",
            "text": "因为这种在研究工作中身不由己的研究员，我们已经见过不少了。",
            "nextDialogs": [
              "742171512"
            ]
          },
          "742171512": {
            "id": "742171512",
            "speakerId": 14065,
            "speakerName": "梅康顿",
            "text": "当然，被如此直接地控制的研究员还是第一次见。",
            "nextDialogs": [
              "742171513"
            ]
          },
          "742171513": {
            "id": "742171513",
            "speakerId": 14066,
            "speakerName": "巴比斯",
            "text": "至于戈伦德兰为什么反应如此剧烈…从人情世故的角度出发，我们有一个猜想。",
            "nextDialogs": [
              "742171514"
            ]
          },
          "742171514": {
            "id": "742171514",
            "speakerId": 14065,
            "speakerName": "梅康顿",
            "text": "就像那句「卑劣者向来闭目」，即使戈伦德兰已经用各种方式控制过不计其数的人…",
            "nextDialogs": [
              "742171515"
            ]
          },
          "742171515": {
            "id": "742171515",
            "speakerId": 14066,
            "speakerName": "巴比斯",
            "text": "…但他也从未留意，也从未亲身体验过，被人控制是一种怎样的感觉。",
            "nextDialogs": [
              "742171516"
            ]
          },
          "742171516": {
            "id": "742171516",
            "speakerId": 14065,
            "speakerName": "梅康顿",
            "text": "这次他不得不亲身体验一番这种痛苦了。",
            "nextDialogs": [
              "742171517"
            ]
          },
          "742171517": {
            "id": "742171517",
            "speakerId": 14066,
            "speakerName": "巴比斯",
            "text": "看这位先生的表现，想必印象十分深刻啊。"
          }
        }
      }
    },
    {
      "subId": "7421751",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742175101"
        ],
        "dialogs": {
          "742175101": {
            "id": "742175101",
            "speakerId": 14068,
            "speakerName": "加尔恰",
            "text": "这镇子到底经历了什么？难道是格里斯潘那个白痴把所有人都催眠了？",
            "nextDialogs": [
              "742175102"
            ]
          },
          "742175102": {
            "id": "742175102",
            "speakerId": 14068,
            "speakerName": "加尔恰",
            "text": "但他去哪了？他连格罗贝尔都带走了…不会真是这家伙犯的事吧…",
            "nextDialogs": [
              "742175103"
            ]
          },
          "742175103": {
            "id": "742175103",
            "speakerId": 14068,
            "speakerName": "加尔恰",
            "text": "看在俱乐部的份上，梅康顿！巴比斯，你们清醒点！",
            "nextDialogs": [
              "742175104"
            ]
          },
          "742175104": {
            "id": "742175104",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "冷静点，加尔恰，我们先去煮点汤吧。喝一点暖和的东西有助于他们的精神健康。",
            "nextDialogs": [
              "742175105"
            ]
          },
          "742175105": {
            "id": "742175105",
            "speakerId": 14068,
            "speakerName": "加尔恰",
            "text": "好的…我真不知道如何是好了，一切都一团糟，迦雅。",
            "nextDialogs": [
              "742175106"
            ]
          },
          "742175106": {
            "id": "742175106",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "没关系，亲爱的，没关系。我陪着你呢，这件事绝对清清楚楚，无可置疑。"
          }
        }
      }
    },
    {
      "subId": "7421752",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742175201"
        ],
        "dialogs": {
          "742175201": {
            "id": "742175201",
            "speakerId": 14065,
            "speakerName": "梅康顿",
            "text": "是的，你们就是学不会空想…现实，现实谁都不缺，你们只缺空想…",
            "nextDialogs": [
              "742175202"
            ]
          },
          "742175202": {
            "id": "742175202",
            "speakerId": 14066,
            "speakerName": "巴比斯",
            "text": "你们得…我们得仰头看天，别总瞅着摩拉和高楼，空无一物的地方才是研究者的归宿…"
          }
        }
      }
    },
    {
      "subId": "7421753",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742175301"
        ],
        "dialogs": {
          "742175301": {
            "id": "742175301",
            "speakerId": 14067,
            "speakerName": "戈伦德兰",
            "text": "我真是无药可救…为什么我之前…天哪…我之前做出了那种事…",
            "nextDialogs": [
              "742175302"
            ]
          },
          "742175302": {
            "id": "742175302",
            "speakerId": 14067,
            "speakerName": "戈伦德兰",
            "text": "我就像那个人一样，想捏着别人的心弦，只让他们听自己号令，不…不不不…"
          }
        }
      }
    },
    {
      "subId": "7421754",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742175401"
        ],
        "dialogs": {
          "742175401": {
            "id": "742175401",
            "speakerId": 5354,
            "speakerName": "博絮埃",
            "text": "鱼…对。这是我发现的，最新的鱼…"
          }
        }
      }
    },
    {
      "subId": "7421755",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742175501"
        ],
        "dialogs": {
          "742175501": {
            "id": "742175501",
            "speakerId": 12700,
            "speakerName": "迦雅",
            "text": "但愿咱们不会遇见什么危险…",
            "nextDialogs": [
              "742175502"
            ]
          },
          "742175502": {
            "id": "742175502",
            "speakerId": 14069,
            "speakerName": "路通",
            "text": "我也如此期望，小姐。所以请您再往后面站站，离水边远点吧。"
          }
        }
      }
    },
    {
      "subId": "7421756",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742175601"
        ],
        "dialogs": {
          "742175601": {
            "id": "742175601",
            "speakerId": 14065,
            "speakerName": "梅康顿",
            "text": "高空水道…真是个好想法…这绝对是一个好想法。"
          }
        }
      }
    },
    {
      "subId": "7421757",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742175701"
        ],
        "dialogs": {
          "742175701": {
            "id": "742175701",
            "speakerId": 14066,
            "speakerName": "巴比斯",
            "text": "巡轨船…你的设计精妙无比，这一点无可置疑。"
          }
        }
      }
    },
    {
      "subId": "7421799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742179901"
        ],
        "dialogs": {
          "742179901": {
            "id": "742179901",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "一行人很快踏上了前往佩特莉可镇的路…",
            "nextDialogs": [
              "742179902"
            ]
          },
          "742179902": {
            "id": "742179902",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "和加尔恰合力将石像搬到了岸上…",
            "nextDialogs": [
              "742179903"
            ]
          },
          "742179903": {
            "id": "742179903",
            "speakerId": 14069,
            "speakerName": "路通",
            "text": "无偿提供…哼，真是让人尊敬的品德。",
            "nextDialogs": [
              "742179904"
            ]
          },
          "742179904": {
            "id": "742179904",
            "speakerId": 14069,
            "speakerName": "路通",
            "text": "看来这位老兄还没搞清楚，「空想俱乐部」到底是为什么而存在…真让人遗憾。",
            "nextDialogs": [
              "742179905"
            ]
          },
          "742179905": {
            "id": "742179905",
            "speakerId": 14069,
            "speakerName": "路通",
            "text": "看起来，他们谈到一半，佩特莉可镇就出现了意外。这件事可以称得上是好坏参半。"
          }
        }
      }
    }
  ]
}
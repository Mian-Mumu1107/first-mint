  "subQuests": [
    {
      "subId": "7215301",
      "subQuestName": "与爱拉尼对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721530101"
        ],
        "dialogs": {
          "721530101": {
            "id": "721530101",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "咦？旅行者，你怎么也在这里？",
            "nextDialogs": [
              "721530105",
              "721530104"
            ]
          },
          "721530105": {
            "id": "721530105",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "上次你帮我取材了之后，我本来准备写一篇论述「神之眼」与元素力的论文。",
            "nextDialogs": [
              "721530106"
            ]
          },
          "721530106": {
            "id": "721530106",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "大纲拟好了，材料找到了，还有你这位没有「神之眼」，却能使用元素力的人做特别参考。",
            "nextDialogs": [
              "721530107"
            ]
          },
          "721530107": {
            "id": "721530107",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "我写好了论文初稿，送回教令院给我的导师审核，结果，结果…",
            "nextDialogs": [
              "721530108"
            ]
          },
          "721530108": {
            "id": "721530108",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "「题目空洞，论据不详，内容冗长，不知所云」。",
            "nextDialogs": [
              "721530109"
            ]
          },
          "721530109": {
            "id": "721530109",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "然后，我的论文就又被退回了。",
            "nextDialogs": [
              "721530110"
            ]
          },
          "721530110": {
            "id": "721530110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "又要重写吗？",
            "nextDialogs": [
              "721530111"
            ]
          },
          "721530111": {
            "id": "721530111",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "是啊。哈哈哈…反正我已经重写了两次了…",
            "nextDialogs": [
              "721530112"
            ]
          },
          "721530112": {
            "id": "721530112",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "第一次，我想去蒙德取材，写一篇关于蒙德民俗生活与四风守护的论文。",
            "nextDialogs": [
              "721530113"
            ]
          },
          "721530113": {
            "id": "721530113",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "但我刚过石门，就听说蒙德的四风守护之一，东风之龙特瓦林突然开始袭击起了蒙德城。",
            "nextDialogs": [
              "721530114"
            ]
          },
          "721530114": {
            "id": "721530114",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "我还特意去蒙德城里请教了萨义德先生，但当时他也不知道原因，也没法帮我参考论文。",
            "nextDialogs": [
              "721530115"
            ]
          },
          "721530115": {
            "id": "721530115",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "没有核心论点，也没有论据，我只能换一个题目…",
            "nextDialogs": [
              "721530116"
            ]
          },
          "721530116": {
            "id": "721530116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以你去了璃月？",
            "nextDialogs": [
              "721530117"
            ]
          },
          "721530117": {
            "id": "721530117",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "对啊！我想璃月的岩之神那么勤勉，又是亲自守护璃月港，又是帮大家制订发展方案的…",
            "nextDialogs": [
              "721530118"
            ]
          },
          "721530118": {
            "id": "721530118",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "如果以岩之神和璃月港之间的关系为主题写论文，这篇论文肯定稳了。",
            "nextDialogs": [
              "721530119"
            ]
          },
          "721530119": {
            "id": "721530119",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "然后、然后摩拉克斯突然就…呜…"
          },
          "721530104": {
            "id": "721530104",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "呜…别提论文了…"
          }
        }
      }
    },
    {
      "subId": "7215302",
      "subQuestName": "跟随爱拉尼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721530201"
        ],
        "dialogs": {
          "721530201": {
            "id": "721530201",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "稻妻的特色商品，原来是这样的啊…嗯…",
            "nextDialogs": [
              "721530202"
            ]
          },
          "721530202": {
            "id": "721530202",
            "speakerId": 1001,
            "speakerName": "枫",
            "text": "喂，你们…这是在做什么？",
            "nextDialogs": [
              "721530203"
            ]
          },
          "721530203": {
            "id": "721530203",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "你好！我是爱拉尼，来自须弥的学者，为了进行学术研究正在调查稻妻呢。",
            "nextDialogs": [
              "721530204"
            ]
          },
          "721530204": {
            "id": "721530204",
            "speakerId": 1001,
            "speakerName": "枫",
            "text": "在这种时候「调查稻妻」？好可疑的家伙…",
            "nextDialogs": [
              "721530205"
            ]
          },
          "721530205": {
            "id": "721530205",
            "speakerId": 1001,
            "speakerName": "枫",
            "text": "我不管你们究竟有什么目的，请不要在我的店附近做这种让人不安的事情，快走吧。"
          }
        }
      }
    },
    {
      "subId": "7215303",
      "subQuestName": "给店铺「天顶屋」及其店主留影",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721530301"
        ],
        "dialogs": {
          "721530301": {
            "id": "721530301",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "喂，你们在做什么呢？",
            "nextDialogs": [
              "721530302"
            ]
          },
          "721530302": {
            "id": "721530302",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "你好！我是来自…",
            "nextDialogs": [
              "721530303"
            ]
          },
          "721530303": {
            "id": "721530303",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "来自教令院的学者，对吧？没想到在这里都能遇见…",
            "nextDialogs": [
              "721530304"
            ]
          },
          "721530304": {
            "id": "721530304",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "您怎么…",
            "nextDialogs": [
              "721530305"
            ]
          },
          "721530305": {
            "id": "721530305",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "看你的模样就知道是学者，在须弥的时候我可见多了。",
            "nextDialogs": [
              "721530306"
            ]
          },
          "721530306": {
            "id": "721530306",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "大老远从须弥跑到稻妻来，难道是在进行所谓的「社会调查」？",
            "nextDialogs": [
              "721530307"
            ]
          },
          "721530307": {
            "id": "721530307",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "是的，我正准备着呢。您也在教令院里…",
            "nextDialogs": [
              "721530308"
            ]
          },
          "721530308": {
            "id": "721530308",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "我可没有那种做学问的本事，只不过是普通的生意人而已。",
            "nextDialogs": [
              "721530309"
            ]
          },
          "721530309": {
            "id": "721530309",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "既然你是在写论文，那你想记录我这里的什么东西，就自己记录吧，但我要忠告你几句。",
            "nextDialogs": [
              "721530310"
            ]
          },
          "721530310": {
            "id": "721530310",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "远国监司对你我这种外国人可是很提防的，你去记录的时候，记得收敛一点。",
            "nextDialogs": [
              "721530311"
            ]
          },
          "721530311": {
            "id": "721530311",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "如果惹到了什么麻烦，对你这种刚来稻妻的外国人来说，说不定会很难收场。",
            "nextDialogs": [
              "721530312"
            ]
          },
          "721530312": {
            "id": "721530312",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "我、我知道了，谢谢您！",
            "nextDialogs": [
              "721530313"
            ]
          },
          "721530313": {
            "id": "721530313",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "嗯，你赶紧自己去做记录去吧。"
          }
        }
      }
    },

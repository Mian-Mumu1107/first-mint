    {
      "subId": "7215309",
      "subQuestName": "前往码头给渔夫留影",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721530901"
        ],
        "dialogs": {
          "721530901": {
            "id": "721530901",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "唉，不是提醒过你们了吗？不要做出格的事情。",
            "nextDialogs": [
              "721530902"
            ]
          },
          "721530902": {
            "id": "721530902",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "你还没办好许可，要真的闹到远国监司去，这事就真的没法收场了，还好我留意了一下你们那边。",
            "nextDialogs": [
              "721530904",
              "721530906"
            ]
          },
          "721530904": {
            "id": "721530904",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "就是这么严重，看见离岛这里的关卡了吗？想要进入稻妻，必须拿到许可才行。",
            "nextDialogs": [
              "721530908"
            ]
          },
          "721530908": {
            "id": "721530908",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "呜…这样的话，我是不是就不能去其他的岛取材了…",
            "nextDialogs": [
              "721530909"
            ]
          },
          "721530909": {
            "id": "721530909",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "放心吧。我已经去远国监司问过许可的事了，有我这个在稻妻做生意的人做保，办许可应该会容易不少。",
            "nextDialogs": [
              "721530910"
            ]
          },
          "721530910": {
            "id": "721530910",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "谢…谢谢您，但是，您为什么要帮我解围？"
          },
          "721530906": {
            "id": "721530906",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "我在这里，也不太清楚。但总不能连许可都没有啊。",
            "nextDialogs": [
              "721530907"
            ]
          },
          "721530907": {
            "id": "721530907",
            "speakerId": 1002,
            "speakerName": "瓦希德",
            "text": "看见离岛这里的关卡了吗？想要进入稻妻，必须拿到许可才行。"
          }
        }
      }
    },
    {

            ]
          },
          "200291002": {
            "id": "200291002",
            "speakerId": 1005,
            "speakerName": "莉莉",
            "text": "为森么呀？驴人众蜀黍，和我讲了粉多故事呢。"
          }
        }
      }
    },
    {
      "subId": "2002912",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200291201"
        ],
        "dialogs": {
          "200291201": {
            "id": "200291201",
            "speakerId": 1001,
            "speakerName": "玛乔丽",
            "text": "那就拜托你了，旅行者。",
            "nextDialogs": [
              "200291202"
            ]
          },
          "200291202": {
            "id": "200291202",
            "speakerId": 1001,
            "speakerName": "玛乔丽",
            "text": "舒特说，他要去<color=#00E1FFFF>奔狼领附近</color>采钩钩果，你可以去那边找找他。"
          }
        }
      }
    },
    {
      "subId": "2002914",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200291401"
        ],
        "dialogs": {
          "200291401": {
            "id": "200291401",
            "speakerId": 1002,
            "speakerName": "害怕的舒特",
            "text": "请你帮我把这些钩钩果带给玛乔丽小姐吧，我得先去休息一会，刚才我跑得累死了…"
          }
        }
      }
    },
    {
      "subId": "2002917",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200291701"
        ],
        "dialogs": {
          "200291701": {
            "id": "200291701",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "你帮我把这礼物转交给莉莉吧，她应该就在<color=#00E1FFFF>广场附近</color>。",
            "nextDialogs": [
              "200291702"
            ]
          },
          "200291702": {
            "id": "200291702",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "要是我直接去把礼物送给莉莉，鲁道夫估计又要瞪我了…"
          }
        }
      }
    },
    {
      "subId": "2002919",

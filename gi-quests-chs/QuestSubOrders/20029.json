    {
      "subId": "2002928",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200292801"
        ],
        "dialogs": {
          "200292801": {
            "id": "200292801",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "呼…总算能回去了…",
            "nextDialogs": [
              "200292802"
            ]
          },
          "200292802": {
            "id": "200292802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你要回国了吗？",
            "nextDialogs": [
              "200292803"
            ]
          },
          "200292803": {
            "id": "200292803",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "啊？是你啊…",
            "nextDialogs": [
              "200292804"
            ]
          },
          "200292804": {
            "id": "200292804",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "没错，我最近才刚接到上头的命令，让我回至冬去。",
            "nextDialogs": [
              "200292805"
            ]
          },
          "200292805": {
            "id": "200292805",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "说是什么…我被调去另外一个执行官大人手下，暂时不用在蒙德这边待命了。",
            "nextDialogs": [
              "200292806"
            ]
          },
          "200292806": {
            "id": "200292806",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "也不知道我到底被调去哪位执行官大人手下了…"
          }
        }
      }
    }

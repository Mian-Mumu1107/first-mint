  "subQuests": [
    {
      "subId": "7308418",
      "subQuestName": "test*隐藏*主动和冒险家对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730840101"
        ],
        "dialogs": {
          "730840101": {
            "id": "730840101",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "你们是受本人阿弗拉图委托而来的镀金旅团吗？如果不是的话，还是请在此留步吧。",
            "nextDialogs": [
              "730840102"
            ]
          },
          "730840102": {
            "id": "730840102",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "前面的区域很危险，我已经委托了聚砂厅让镀金旅团来处理了，普通人还是小心为好。",
            "nextDialogs": [
              "730840103"
            ]
          },
          "730840103": {
            "id": "730840103",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "作为教令官，你们要是出了什么意外的话，那就是我的失职了。",
            "nextDialogs": [
              "730840105",
              "730840107"
            ]
          },
          "730840105": {
            "id": "730840105",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "唔…那些初来乍到的冒险家们都这么说，在沙漠过于自信可是很危险的。",
            "nextDialogs": [
              "730840108"
            ]
          },
          "730840108": {
            "id": "730840108",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "注意到那边的巨大机械了吗，那是传说中荼诃人的遗物。",
            "nextDialogs": [
              "730840109"
            ]
          },
          "730840109": {
            "id": "730840109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "荼诃人？",
            "nextDialogs": [
              "730840110"
            ]
          },
          "730840110": {
            "id": "730840110",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "嗯，通常的说法应该是坎瑞亚？荼诃是我们因论派喜欢用的古称。",
            "nextDialogs": [
              "730840111"
            ]
          },
          "730840111": {
            "id": "730840111",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "传说五百年前，荼诃{RUBY#[D]坎瑞亚}古国的「白鹄骑士」曾驾驶着这些巨大的机械对抗黑渊涌出的魔群。",
            "nextDialogs": [
              "730840112"
            ]
          },
          "730840112": {
            "id": "730840112",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "在残酷的战争后，最终残留下来的三台遗迹巨像被贤者们所封印，这台遗迹巨像就是其中之一。",
            "nextDialogs": [
              "730840113"
            ]
          },
          "730840113": {
            "id": "730840113",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "按理来说这台机械已经在此静默了数百年了，但是不知道怎么最近突然活跃了起来，甚至还开始攻击附近的人类。",
            "nextDialogs": [
              "730840114"
            ]
          },
          "730840114": {
            "id": "730840114",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "无差别地用激光炮攻击附近的活物，这样危险的机能在这些被封印的遗迹巨像身上还是第一次见。没办法放任不管。",
            "nextDialogs": [
              "730840115"
            ]
          },
          "730840115": {
            "id": "730840115",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "明明为这些机械提供能源的混沌炉心早就进行过无害化处理了，没想到过了几百年竟然还能运行，真是奇怪。",
            "nextDialogs": [
              "730840116"
            ]
          },
          "730840116": {
            "id": "730840116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "混沌炉心？听上去和遗迹守卫一样嘛。",
            "nextDialogs": [
              "730840117"
            ]
          },
          "730840117": {
            "id": "730840117",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "哦哦，你们知道遗迹守卫吗，那解释起来就要方便多了。简单来说遗迹巨像就像是超级巨大版的遗迹守卫。",
            "nextDialogs": [
              "730840118"
            ]
          },
          "730840118": {
            "id": "730840118",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "不过和遗迹守卫不同，遗迹巨像虽然也装载了自律系统，但主要还是由人类操纵的。",
            "nextDialogs": [
              "730840119"
            ]
          },
          "730840119": {
            "id": "730840119",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "这也是最奇怪的地方，进入遗迹巨像的通路都被贤者利用「须陀流心」的力量封印起来了，应该没有人能够进去启动它才对。",
            "nextDialogs": [
              "730840120"
            ]
          },
          "730840120": {
            "id": "730840120",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "是有人通过其他的方法进去了吗？还是说触发了什么我们还不知道的自启动机制呢？",
            "nextDialogs": [
              "730840121"
            ]
          },
          "730840121": {
            "id": "730840121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要进去看看才知道吧。",
            "nextDialogs": [
              "730840122"
            ]
          },
          "730840122": {
            "id": "730840122",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "话是这么说，不过不知道是不是聚砂厅的业务太忙了，这么久也没有镀金旅团的人过来。",
            "nextDialogs": [
              "730840123"
            ]
          },
          "730840123": {
            "id": "730840123",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "教令院的封印还好说，问题是进入遗迹巨像的通路入口是被巨石堵住的，靠我自己可没办法挪开。",
            "nextDialogs": [
              "730840124"
            ]
          },
          "730840124": {
            "id": "730840124",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦哦，这个的话我们倒是可以帮忙。",
            "nextDialogs": [
              "730840125"
            ]
          },
          "730840125": {
            "id": "730840125",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#如果能把给镀金旅团的报酬给我们的话。对吧？{NICKNAME}。",
            "nextDialogs": [
              "730840126"
            ]
          },
          "730840126": {
            "id": "730840126",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "你们是冒险家吗？如果是一般民众的话，我可不能让你们冒这样的风险。",
            "nextDialogs": [
              "730840127"
            ]
          },
          "730840127": {
            "id": "730840127",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "毕竟这家伙的激光炮可不是闹着玩的，要是让你们白白送命的话，我可没法向教令院交待。"
          },
          "730840107": {
            "id": "730840107",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "发生了一些异变哪。"
          }
        }
      }
    },

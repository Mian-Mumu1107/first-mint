    {
      "subId": "7308403",
      "subQuestName": "探索进入机器人内部的方法",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730840301"
        ],
        "dialogs": {
          "730840301": {
            "id": "730840301",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "虽然作为教令官负责这里，但我其实是因为要去考察，结果正好在附近而被临时委派到这里来的。",
            "nextDialogs": [
              "730840302"
            ]
          },
          "730840302": {
            "id": "730840302",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "况且我来自伐护{RUBY#[D]因论派}末那学院，对遗迹巨像的了解也仅限于历史书上的只言片语。",
            "nextDialogs": [
              "730840303"
            ]
          },
          "730840303": {
            "id": "730840303",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "不过如果借此能对荼诃{RUBY#[D]坎瑞亚}古国的历史有更多了解的话，对我接下来的研究应该也会很有帮助。"
          }
        }
      }
    },

    {
      "subId": "7308417",
      "subQuestName": "向阿弗拉图回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730841701"
        ],
        "dialogs": {
          "730841701": {
            "id": "730841701",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "情况如何？我注意到遗迹巨像发生了一些异动，是你们进去把它的自律系统关闭了吗？",
            "nextDialogs": [
              "730841703",
              "730841705"
            ]
          },
          "730841703": {
            "id": "730841703",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "那真是太好了，这样委托也算是完成了。",
            "nextDialogs": [
              "730841706"
            ]
          },
          "730841706": {
            "id": "730841706",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "不过关于它到底为什么会突然启动，你们在遗迹巨像里面有发现什么线索吗？",
            "nextDialogs": [
              "730841707"
            ]
          },
          "730841707": {
            "id": "730841707",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向阿弗拉图回报了在遗迹巨像内部的发现。",
            "nextDialogs": [
              "730841708"
            ]
          },
          "730841708": {
            "id": "730841708",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "嗯…过度生长的藤蔓…不像是沙漠中会出现的生态啊。虽然我也不是很清楚，不过听上去像是和地脉之类的有关。",
            "nextDialogs": [
              "730841709"
            ]
          },
          "730841709": {
            "id": "730841709",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "之前也有接到过类似的，炉心被破坏的遗迹机关因为地脉的原因还能不断「复活」的报告。",
            "nextDialogs": [
              "730841710"
            ]
          },
          "730841710": {
            "id": "730841710",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "荼诃人制造的机关和地脉能源之间，应该还有很多我们尚不清楚的联系。",
            "nextDialogs": [
              "730841711"
            ]
          },
          "730841711": {
            "id": "730841711",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "而且古代贤者们使用的封印原本就是利用了地脉的力量构筑的，要是地脉发生了什么异变的话…",
            "nextDialogs": [
              "730841712"
            ]
          },
          "730841712": {
            "id": "730841712",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "如果我的推论没错，可能各地被封印的遗迹巨像都会开始出现问题了。",
            "nextDialogs": [
              "730841713"
            ]
          },
          "730841713": {
            "id": "730841713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听上去有点麻烦。",
            "nextDialogs": [
              "730841714"
            ]
          },
          "730841714": {
            "id": "730841714",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "只能先向教令院报告看看了，这种事情我也没办法处理啊。",
            "nextDialogs": [
              "730841715"
            ]
          },
          "730841715": {
            "id": "730841715",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "本来我此行是为了前往荼诃人的遗迹考察，好不容易才从教令院申请到了许可，还联系到了当地的教团来接我。",
            "nextDialogs": [
              "730841716"
            ]
          },
          "730841716": {
            "id": "730841716",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "结果刚一出城就碰到这种麻烦事，但是教令院派下来的任务也没办法拒绝…",
            "nextDialogs": [
              "730841717"
            ]
          },
          "730841717": {
            "id": "730841717",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "现在事情总算解决了，我也能继续我的游学之旅了，剩下的工作就等教令院派其他人来处理好了。",
            "nextDialogs": [
              "730841718"
            ]
          },
          "730841718": {
            "id": "730841718",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "那么请收下报酬。如果有缘的话，或许我们还会在沙漠的某处再见的。"
          },
          "730841705": {
            "id": "730841705",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "嗯，这样它应该就不会乱攻击附近的人了。"
          }
        }
      }
    },
    {
      "subId": "7308402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730840201"
        ],
        "dialogs": {
          "730840201": {
            "id": "730840201",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "你们是受本人阿弗拉图委托而来的镀金旅团吗？如果不是的话，还是请在此留步吧。",
            "nextDialogs": [
              "730840202"
            ]
          },
          "730840202": {
            "id": "730840202",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "前面的区域很危险，我已经委托了聚砂厅让镀金旅团来处理了，普通人还是小心为好。",
            "nextDialogs": [
              "730840203"
            ]
          },
          "730840203": {
            "id": "730840203",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "作为教令官，你们要是出了什么意外的话，那就是我的失职了。",
            "nextDialogs": [
              "730840205",
              "730840207"
            ]
          },
          "730840205": {
            "id": "730840205",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "唔…那些初来乍到的冒险家们都这么说，在沙漠过于自信可是很危险的。",
            "nextDialogs": [
              "730840208"
            ]
          },
          "730840208": {
            "id": "730840208",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "注意到那边的巨大机械了吗，那是传说中荼诃人的遗物。",
            "nextDialogs": [
              "730840209"
            ]
          },
          "730840209": {
            "id": "730840209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "荼诃人？",
            "nextDialogs": [
              "730840210"
            ]
          },
          "730840210": {
            "id": "730840210",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "嗯，通常的说法应该是坎瑞亚？荼诃是我们因论派喜欢用的古称。",
            "nextDialogs": [
              "730840211"
            ]
          },
          "730840211": {
            "id": "730840211",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "传说五百年前，荼诃{RUBY#[D]坎瑞亚}古国的「白鹄骑士」曾驾驶着这些巨大的机械对抗黑渊涌出的魔群。",
            "nextDialogs": [
              "730840212"
            ]
          },
          "730840212": {
            "id": "730840212",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "在残酷的战争后，最终残留下来的三台遗迹巨像被贤者们所封印，这台遗迹巨像就是其中之一。",
            "nextDialogs": [
              "730840213"
            ]
          },
          "730840213": {
            "id": "730840213",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "按理来说这台机械已经在此静默了数百年了，但是不知道怎么最近突然活跃了起来，甚至还开始攻击附近的人类。",
            "nextDialogs": [
              "730840214"
            ]
          },
          "730840214": {
            "id": "730840214",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "无差别地用激光炮攻击附近的活物，这样危险的机能在这些被封印的遗迹巨像身上还是第一次见。没办法放任不管。",
            "nextDialogs": [
              "730840215"
            ]
          },
          "730840215": {
            "id": "730840215",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "明明为这些机械提供能源的混沌炉心早就进行过无害化处理了，没想到过了几百年竟然还能运行，真是奇怪。",
            "nextDialogs": [
              "730840216"
            ]
          },
          "730840216": {
            "id": "730840216",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然一句话也没听懂，但是这个遗迹巨像，应该和我们之前在降诸魔山见过的一样吧。",
            "nextDialogs": [
              "730840217"
            ]
          },
          "730840217": {
            "id": "730840217",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过之前的那个大家伙可不会乱攻击人。",
            "nextDialogs": [
              "730840218"
            ]
          },
          "730840218": {
            "id": "730840218",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "哦哦，你们知道遗迹巨像吗，那就不用我再解释了。",
            "nextDialogs": [
              "730840219"
            ]
          },
          "730840219": {
            "id": "730840219",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "那么你们应该知道的，遗迹巨像虽然也装载了自律系统，但主要还是由人类操纵的。",
            "nextDialogs": [
              "730840220"
            ]
          },
          "730840220": {
            "id": "730840220",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "这也是最奇怪的地方，进入遗迹巨像的通路都被贤者利用「须陀流心」的力量封印起来了，应该没有人能够进去启动它才对。",
            "nextDialogs": [
              "730840221"
            ]
          },
          "730840221": {
            "id": "730840221",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "是有人通过其他的方法进去了吗？还是说触发了什么我们还不知道的自启动机制呢？"
          },
          "730840207": {
            "id": "730840207",
            "speakerId": 1000,
            "speakerName": "阿弗拉图",
            "text": "发生了一些异变哪。"
          }
        }
      }
    }
  ]
}
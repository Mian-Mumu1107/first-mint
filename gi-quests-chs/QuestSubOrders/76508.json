{
  "lineCounts": {
    "Player": 10,
    "努斯妲": 30,
    "塔拉内": 7,
    "派蒙": 13
  },
  "subQuests": [
    {
      "subId": "7650801",
      "subQuestName": "前往「流泉之众」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "765080101"
        ],
        "dialogs": {
          "765080101": {
            "id": "765080101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "最近「流泉之众」是在举办什么活动吗？好像多了一些游客？",
            "nextDialogs": [
              "765080102"
            ]
          },
          "765080102": {
            "id": "765080102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那边有一位须弥客人…在给大家表演舞蹈？",
            "nextDialogs": [
              "765080103"
            ]
          },
          "765080103": {
            "id": "765080103",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "啊呀呀，闪亮亮的大英雄和可爱的派蒙参谋也来了！",
            "nextDialogs": [
              "765080104"
            ]
          },
          "765080104": {
            "id": "765080104",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "向您致以最真挚的问候，我最敬重的战士、武力和舞力的双重勇者，以及生活享受家！",
            "nextDialogs": [
              "765080105"
            ]
          },
          "765080105": {
            "id": "765080105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，这位小姐有点眼熟欸…",
            "nextDialogs": [
              "765080106"
            ]
          },
          "765080106": {
            "id": "765080106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#而且，你怎么知道{NICKNAME}跳起舞来很开心？",
            "nextDialogs": [
              "765080107"
            ]
          },
          "765080107": {
            "id": "765080107",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "#当然是在圣火竞技场前看过{M#他}{F#她}欢快的舞姿啦！",
            "nextDialogs": [
              "765080108"
            ]
          },
          "765080108": {
            "id": "765080108",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "#合过影后，我找了个不那么显眼的地方，一边吃龙龙饼干，一边看完了{NICKNAME}的祝福舞蹈。",
            "nextDialogs": [
              "765080109"
            ]
          },
          "765080109": {
            "id": "765080109",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "#跳舞就是要轻轻松松，释放自我嘛！我都想上去为{NICKNAME}伴舞了！",
            "nextDialogs": [
              "765080111",
              "765080113"
            ]
          },
          "765080111": {
            "id": "765080111",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "我的荣幸！",
            "nextDialogs": [
              "765080114"
            ]
          },
          "765080114": {
            "id": "765080114",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "言归正传，如您所见，最近有些须弥朋友盛情来访。",
            "nextDialogs": [
              "765080115"
            ]
          },
          "765080115": {
            "id": "765080115",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "经过穆托塔、阿米娜、帕加尔和玛拉妮的商量，我们「花羽会」决定联合「回声之子」与「流泉之众」，好好招待他们。",
            "nextDialogs": [
              "765080116"
            ]
          },
          "765080116": {
            "id": "765080116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看起来，有不少「镀金旅团」的佣兵呢…",
            "nextDialogs": [
              "765080117"
            ]
          },
          "765080117": {
            "id": "765080117",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "让我猜猜，是不是在沙漠旅行时，不打不相识，打成了朋友？",
            "nextDialogs": [
              "765080118"
            ]
          },
          "765080118": {
            "id": "765080118",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "哎，八九不离十了！不过，不是我们之间互斗。",
            "nextDialogs": [
              "765080119"
            ]
          },
          "765080119": {
            "id": "765080119",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "我们在千壑沙地南边大办烤肉聚会时，引来了一群凶狠的赤鹫，它们专挑我们吃撑喝撑，跑不动道的时机下手…",
            "nextDialogs": [
              "765080120"
            ]
          },
          "765080120": {
            "id": "765080120",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "打法还十分狡猾，我们一番苦斗无果，被它们利用熟悉地形的优势打得疲惫不堪，只能先撤离。",
            "nextDialogs": [
              "765080121"
            ]
          },
          "765080121": {
            "id": "765080121",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "没想到，一队佣兵出现在我们后退的路上，对着赤鹫们跳起了神秘的战舞…",
            "nextDialogs": [
              "765080122"
            ]
          },
          "765080122": {
            "id": "765080122",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "结果那些赤鹫好像和他们达成了共识，退了回去！",
            "nextDialogs": [
              "765080123"
            ]
          },
          "765080123": {
            "id": "765080123",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "用，用战舞让赤鹫离开了？"
          },
          "765080113": {
            "id": "765080113",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "那说明我干活还不够卖力，没留下什么亮眼的成就，仍需努力！"
          }
        }
      }
    },
    {
      "subId": "7650802",
      "subQuestName": "和塔拉内对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "765080301"
        ],
        "dialogs": {
          "765080301": {
            "id": "765080301",
            "speakerId": 1002,
            "speakerName": "塔拉内",
            "text": "#啊呀，啊呀呀！这不是大名人{NICKNAME}嘛？",
            "nextDialogs": [
              "765080302"
            ]
          },
          "765080302": {
            "id": "765080302",
            "speakerId": 1002,
            "speakerName": "塔拉内",
            "text": "我以为请到妮露小姐已经是万幸中的万幸了，没想到，还有高手中的高手！",
            "nextDialogs": [
              "765080303"
            ]
          },
          "765080303": {
            "id": "765080303",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "#多夸夸{NICKNAME}，我爱听！",
            "nextDialogs": [
              "765080304"
            ]
          },
          "765080304": {
            "id": "765080304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？这不是我的台词吗？",
            "nextDialogs": [
              "765080305"
            ]
          },
          "765080305": {
            "id": "765080305",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "没错！同样的字词由派蒙参谋说出来，听感灵巧轻盈，好比悠可琴的音轨，软软弹弹可可爱爱。",
            "nextDialogs": [
              "765080306"
            ]
          },
          "765080306": {
            "id": "765080306",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "而由我来说，听感就像是…鼓手喝了半桶酒后打出来的段子，顿挫管够，劲道踏实。",
            "nextDialogs": [
              "765080307"
            ]
          },
          "765080307": {
            "id": "765080307",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "当然，按伊安珊大师的教诲，底鼓的双踩也多多益善，最好像自动枪一样连绵不停。",
            "nextDialogs": [
              "765080308"
            ]
          },
          "765080308": {
            "id": "765080308",
            "speakerId": 1001,
            "speakerName": "努斯妲",
            "text": "这样，就算我们说了一样的台词，也不嫌重复啰嗦，而是互相补全了多个声部，还能让你卡准节奏。",
            "nextDialogs": [
              "765080309"
            ]
          },
          "765080309": {
            "id": "765080309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "还，还有这种事？被你说晕了…",
            "nextDialogs": [
              "765080310"
            ]
          },
          "765080310": {
            "id": "765080310",
            "speakerId": 1002,
            "speakerName": "塔拉内",
            "text": "努斯妲大姐聊到点子上了——节奏。",
            "nextDialogs": [
              "765080311"
            ]
          },
          "765080311": {
            "id": "765080311",
            "speakerId": 1002,
            "speakerName": "塔拉内",
            "text": "我们的舞蹈自由而张扬，但也不能完全无拘无束，至少，最关键的动作需要精准卡点。",
            "nextDialogs": [
              "765080312"
            ]
          },
          "765080312": {
            "id": "765080312",
            "speakerId": 1002,
            "speakerName": "塔拉内",
            "text": "最近的新舞已经编排好动作了，但前来体验的新人和…新龙们，都不太擅长找准节奏。",
            "nextDialogs": [
              "765080313"
            ]
          },
          "765080313": {
            "id": "765080313",
            "speakerId": 1002,
            "speakerName": "塔拉内",
            "text": "#正好，就由{NICKNAME}来给出节奏的指导吧？",
            "nextDialogs": [
              "765080314"
            ]
          },
          "765080314": {
            "id": "765080314",
            "speakerId": 1002,
            "speakerName": "塔拉内",
            "text": "有你在场的话，新人和新龙们肯定都会全神贯注，不出几下就学个透彻！",
            "nextDialogs": [
              "765080317"
            ]
          },
          "765080317": {
            "id": "765080317",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那那那，我就在一边给你加油打气…",
            "nextDialogs": [
              "765080318"
            ]
          },
          "765080318": {
            "id": "765080318",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…还有，鼓励被你指挥的大家！"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "50701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070101"
        ],
        "dialogs": {
          "5070101": {
            "id": "5070101",
            "speakerId": 1000,
            "speakerName": "花见坂告示板",
            "text": "此乃幕府所设花见坂告示板，各种事务，尽皆公示。闲人请勿擅自张贴！"
          }
        }
      }
    },
    {
      "subId": "50702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070201"
        ],
        "dialogs": {
          "5070201": {
            "id": "5070201",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "近日有行踪可疑之外国人士进入稻妻城区，游荡不定，可见动机险恶。",
            "nextDialogs": [
              "5070202"
            ]
          },
          "5070202": {
            "id": "5070202",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "幕府特此通告：举报可疑人员可得重赏，包庇者必加严惩！",
            "nextDialogs": [
              "5070203"
            ]
          },
          "5070203": {
            "id": "5070203",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "常道恢弘，鸣神永恒。"
          }
        }
      }
    },
    {
      "subId": "50703",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070301"
        ],
        "dialogs": {
          "5070301": {
            "id": "5070301",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "「眼狩令」行动已近尾声，但仍有少数私藏「神之眼」者藏匿。",
            "nextDialogs": [
              "5070302"
            ]
          },
          "5070302": {
            "id": "5070302",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "谨遵九条天领奉行孝行大人命令，服从九条裟罗大人指挥，追捕行动将尽可能不使用暴力，不侵扰民众。",
            "nextDialogs": [
              "5070303"
            ]
          },
          "5070303": {
            "id": "5070303",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "请大家放下心来，天领奉行决不以执行公务为借口，侵扰各位正常生活。",
            "nextDialogs": [
              "5070304"
            ]
          },
          "5070304": {
            "id": "5070304",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "以个人与九条家之名誉，九条天领奉行孝行特此向市民保证。"
          }
        }
      }
    },
    {
      "subId": "50704",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070401"
        ],
        "dialogs": {
          "5070401": {
            "id": "5070401",
            "speakerId": 1002,
            "speakerName": "荒泷本大爷第一斗！",
            "text": "「九条天狗！本大爷又来了！你在哪里呢！！」",
            "nextDialogs": [
              "5070402"
            ]
          },
          "5070402": {
            "id": "5070402",
            "speakerId": 1002,
            "speakerName": "荒泷本大爷第一斗！",
            "text": "「老子不会忘记你夺我「神之眼」之恨的，只要还有一口气，就会再来找你！」",
            "nextDialogs": [
              "5070403"
            ]
          },
          "5070403": {
            "id": "5070403",
            "speakerId": 1002,
            "speakerName": "荒泷本大爷第一斗！",
            "text": "「你也给本大爷记着点！！」",
            "nextDialogs": [
              "5070404"
            ]
          },
          "5070404": {
            "id": "5070404",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "诸位市民不必惊慌，天领方将尽快处罚涂鸦者。",
            "nextDialogs": [
              "5070405"
            ]
          },
          "5070405": {
            "id": "5070405",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "九条裟罗大人保证与此人毫无关联，敬请宽心。"
          }
        }
      }
    },
    {
      "subId": "50705",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070501"
        ],
        "dialogs": {
          "5070501": {
            "id": "5070501",
            "speakerId": 1004,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但希望这件事能够周知。」",
            "nextDialogs": [
              "5070502"
            ]
          },
          "5070502": {
            "id": "5070502",
            "speakerId": 1004,
            "speakerName": "八重堂的平冢",
            "text": "「泷泽京传先生那本著名的《鹮巷物语》孤本最近被我不慎搞丢了。」",
            "nextDialogs": [
              "5070503"
            ]
          },
          "5070503": {
            "id": "5070503",
            "speakerId": 1004,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但八重大人非要让我到处刊出寻书启示，真是伤脑筋。」",
            "nextDialogs": [
              "5070504"
            ]
          },
          "5070504": {
            "id": "5070504",
            "speakerId": 1004,
            "speakerName": "八重堂的平冢",
            "text": "「想想那本书也真是可怜，也许飞散得到处都是了吧…想要找到不太可能了。」",
            "nextDialogs": [
              "5070505"
            ]
          },
          "5070505": {
            "id": "5070505",
            "speakerId": 1004,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但假如有人能够帮忙找全该书，八重堂将会十分感谢。」"
          }
        }
      }
    },
    {
      "subId": "50706",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070601"
        ],
        "dialogs": {
          "5070601": {
            "id": "5070601",
            "speakerId": 1005,
            "speakerName": "火消队通知",
            "text": "「诸位市民若发现宵宫小姐在城区内滥放管制烟火，请尽量加以制止！」",
            "nextDialogs": [
              "5070602"
            ]
          },
          "5070602": {
            "id": "5070602",
            "speakerId": 1005,
            "speakerName": "火消队通知",
            "text": "「或至少加以斥责，不要助纣为虐！」",
            "nextDialogs": [
              "5070603"
            ]
          },
          "5070603": {
            "id": "5070603",
            "speakerId": 1005,
            "speakerName": "火消队通知",
            "text": "「稻妻城火消队在此恭请诸位市民加以注意，深感谢意。」"
          }
        }
      }
    },
    {
      "subId": "50707",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070701"
        ],
        "dialogs": {
          "5070701": {
            "id": "5070701",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「稻妻城近来流行夜盗、海贼、假勘合」",
            "nextDialogs": [
              "5070702"
            ]
          },
          "5070702": {
            "id": "5070702",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「走私、快脚、无事生非」",
            "nextDialogs": [
              "5070703"
            ]
          },
          "5070703": {
            "id": "5070703",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「拘禁、受贿，自由出港」",
            "nextDialogs": [
              "5070704"
            ]
          },
          "5070704": {
            "id": "5070704",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「强征、止滞、欺下瞒上」",
            "nextDialogs": [
              "5070705"
            ]
          },
          "5070705": {
            "id": "5070705",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "以上皆是妄言，无一事为实！",
            "nextDialogs": [
              "5070706"
            ]
          },
          "5070706": {
            "id": "5070706",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "如有发现涂鸦者，九条天领奉行孝行大人必从重发落！"
          }
        }
      }
    },
    {
      "subId": "50708",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070801"
        ],
        "dialogs": {
          "5070801": {
            "id": "5070801",
            "speakerId": 1007,
            "speakerName": "天目锻冶屋告示",
            "text": "「近来由于战事影响，玉钢供应暂时停滞。」",
            "nextDialogs": [
              "5070802"
            ]
          },
          "5070802": {
            "id": "5070802",
            "speakerId": 1007,
            "speakerName": "天目锻冶屋告示",
            "text": "「还烦有修缮或定制玉钢兵器需求的贵客多多等待。」",
            "nextDialogs": [
              "5070803"
            ]
          },
          "5070803": {
            "id": "5070803",
            "speakerId": 1007,
            "speakerName": "天目锻冶屋告示",
            "text": "「老夫天目十五深表遗憾，万望新老客人见谅。」"
          }
        }
      }
    },
    {
      "subId": "50709",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5070901"
        ],
        "dialogs": {
          "5070901": {
            "id": "5070901",
            "speakerId": 1008,
            "speakerName": "「万端珊瑚」广告",
            "text": "「万端珊瑚，代行万端！」",
            "nextDialogs": [
              "5070902"
            ]
          },
          "5070902": {
            "id": "5070902",
            "speakerId": 1008,
            "speakerName": "「万端珊瑚」广告",
            "text": "「寻人、寻找宠物、婚姻调查、犯罪调查、商业委托、运送货品、代购代送…」",
            "nextDialogs": [
              "5070903"
            ]
          },
          "5070903": {
            "id": "5070903",
            "speakerId": 1008,
            "speakerName": "「万端珊瑚」广告",
            "text": "「只要您开价，钱形、百目鬼之流江洋大盗也捉给您看！」"
          }
        }
      }
    },
    {
      "subId": "50710",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071001"
        ],
        "dialogs": {
          "5071001": {
            "id": "5071001",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「听说因为海贼活动的原因，又有一批货物滞留在了离岛。」",
            "nextDialogs": [
              "5071002"
            ]
          },
          "5071002": {
            "id": "5071002",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「真是离谱，自从赤穗百目鬼之乱结束后已有数百年没有海贼活动了。」",
            "nextDialogs": [
              "5071003"
            ]
          },
          "5071003": {
            "id": "5071003",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「如今这『锁国令』的时代，反而又令走私与海上掠夺复苏…」",
            "nextDialogs": [
              "5071004"
            ]
          },
          "5071004": {
            "id": "5071004",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「假如这是大御所殿下的旨意…神的意思，凡人果真揣测不清。」",
            "nextDialogs": [
              "5071005"
            ]
          },
          "5071005": {
            "id": "5071005",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "还是请您不要揣测为好。"
          }
        }
      }
    },
    {
      "subId": "50711",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071101"
        ],
        "dialogs": {
          "5071101": {
            "id": "5071101",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「绯木广孝，男，35岁。退役武士，做过矿工，身强体壮，吃苦耐劳。」",
            "nextDialogs": [
              "5071102"
            ]
          },
          "5071102": {
            "id": "5071102",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「保证身体健康，未尝染病！急需一份诚实工作，养活四口之家。」",
            "nextDialogs": [
              "5071103"
            ]
          },
          "5071103": {
            "id": "5071103",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「每日上午六点至晚八点可与本人面谈！」",
            "nextDialogs": [
              "5071104"
            ]
          },
          "5071104": {
            "id": "5071104",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "离岛码头已招工，此条留言可撤下。"
          }
        }
      }
    },
    {
      "subId": "50712",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071201"
        ],
        "dialogs": {
          "5071201": {
            "id": "5071201",
            "speakerId": 1009,
            "speakerName": "「木南料亭」广告",
            "text": "「木南料亭，只提供最正宗，最鲜美的稻妻料理！」",
            "nextDialogs": [
              "5071202"
            ]
          },
          "5071202": {
            "id": "5071202",
            "speakerId": 1009,
            "speakerName": "「木南料亭」广告",
            "text": "「来店外带者，赠品为杏奈小姐的微笑！」",
            "nextDialogs": [
              "5071203"
            ]
          },
          "5071203": {
            "id": "5071203",
            "speakerId": 1009,
            "speakerName": "「木南料亭」广告",
            "text": "「让甜美的微笑，带给您美好的一天！」",
            "nextDialogs": [
              "5071204"
            ]
          },
          "5071204": {
            "id": "5071204",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「怎么想都只是为了促销而强颜欢笑吧…」"
          }
        }
      }
    },
    {
      "subId": "50713",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071301"
        ],
        "dialogs": {
          "5071301": {
            "id": "5071301",
            "speakerId": 1010,
            "speakerName": "通缉令",
            "text": "悬赏：吉野小平次、吉野小平太。",
            "nextDialogs": [
              "5071302"
            ]
          },
          "5071302": {
            "id": "5071302",
            "speakerId": 1010,
            "speakerName": "通缉令",
            "text": "罪名：逐电；劫盗；夜讨；谋害长官；向无辜村民散发财物，企图谋反。",
            "nextDialogs": [
              "5071303"
            ]
          },
          "5071303": {
            "id": "5071303",
            "speakerId": 1010,
            "speakerName": "通缉令",
            "text": "此二人活捉或正法，皆有重赏！"
          }
        }
      }
    },
    {
      "subId": "50714",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071401"
        ],
        "dialogs": {
          "5071401": {
            "id": "5071401",
            "speakerId": 1010,
            "speakerName": "通缉令",
            "text": "悬赏：绿川四郎",
            "nextDialogs": [
              "5071402"
            ]
          },
          "5071402": {
            "id": "5071402",
            "speakerId": 1010,
            "speakerName": "通缉令",
            "text": "罪名：逐电；啸聚；海贼；抢劫官员；伏狩武士；诱拐老母为质，妄图对抗官府。",
            "nextDialogs": [
              "5071403"
            ]
          },
          "5071403": {
            "id": "5071403",
            "speakerId": 1010,
            "speakerName": "通缉令",
            "text": "此人及其党羽，活捉或正法，皆有重赏！"
          }
        }
      }
    },
    {
      "subId": "50715",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071501"
        ],
        "dialogs": {
          "5071501": {
            "id": "5071501",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "同叛军的战争如今一路高歌猛进，只差最后一击便可平定乱党！",
            "nextDialogs": [
              "5071502"
            ]
          },
          "5071502": {
            "id": "5071502",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "还请诸位年轻武士勠力同心，共投讨伐大业！",
            "nextDialogs": [
              "5071503"
            ]
          },
          "5071503": {
            "id": "5071503",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "来参军吧！以免到安宁之时，为没能给国家出力而悔恨莫及！",
            "nextDialogs": [
              "5071504"
            ]
          },
          "5071504": {
            "id": "5071504",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "参军相关事宜请至町奉行所咨询。",
            "nextDialogs": [
              "5071505"
            ]
          },
          "5071505": {
            "id": "5071505",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "注意！已收到兵役证书的家庭，必须送出至少一位成年适龄人员！",
            "nextDialogs": [
              "5071506"
            ]
          },
          "5071506": {
            "id": "5071506",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「这『最后一击』已经持续了三个月了吧…可怎么还不见叛军被平定呢？」",
            "nextDialogs": [
              "5071507"
            ]
          },
          "5071507": {
            "id": "5071507",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "未曾参军者，有何资格评判在前线奋战的武士！正是他们的保护，你们才能在这里指指点点！",
            "nextDialogs": [
              "5071508"
            ]
          },
          "5071508": {
            "id": "5071508",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「老夫是没法上战场了，也很感谢小伙子们的奉献…只是老夫的三个儿子至今还没回来。」",
            "nextDialogs": [
              "5071509"
            ]
          },
          "5071509": {
            "id": "5071509",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「也请天领奉行大人能否给犬子休几天假回来看看，让老夫不至于为战争悔恨莫及。」",
            "nextDialogs": [
              "5071510"
            ]
          },
          "5071510": {
            "id": "5071510",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "请这位老父亲也多多体谅他人，既然大家都有在前线奋战的家人，都在忍耐着不安，也请您再多忍耐一下，胜利必将到来。",
            "nextDialogs": [
              "5071511"
            ]
          },
          "5071511": {
            "id": "5071511",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "希望如此，希望如此…",
            "nextDialogs": [
              "5071512"
            ]
          },
          "5071512": {
            "id": "5071512",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "征兵公告不容涂鸦！再有发现，从重罚款！"
          }
        }
      }
    },
    {
      "subId": "50716",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071601"
        ],
        "dialogs": {
          "5071601": {
            "id": "5071601",
            "speakerId": 1011,
            "speakerName": "鸣神大社公告",
            "text": "经宫司八重神子大人许可，鸣神大社将向受战争影响之贫困商户、困难家庭发放无息扶助贷款、慰问粮等补助福利。",
            "nextDialogs": [
              "5071602"
            ]
          },
          "5071602": {
            "id": "5071602",
            "speakerId": 1011,
            "speakerName": "鸣神大社公告",
            "text": "请有需要者携带齐全证件诣神里家府上办理相关手续。",
            "nextDialogs": [
              "5071603"
            ]
          },
          "5071603": {
            "id": "5071603",
            "speakerId": 1011,
            "speakerName": "鸣神大社公告",
            "text": "由于战事绵延，公帑稍紧，近日慰问粮补助限额降低至二分之一，敬请见谅。",
            "nextDialogs": [
              "5071604"
            ]
          },
          "5071604": {
            "id": "5071604",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「根本是骗人的！昨天排队排到我的时候，那个小妮子直接告诉我没有了！」",
            "nextDialogs": [
              "5071605"
            ]
          },
          "5071605": {
            "id": "5071605",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「社奉行的粮仓一定还有不少余粮吧？八重神子大人可不要被那群当官的蒙骗了！！」",
            "nextDialogs": [
              "5071606"
            ]
          },
          "5071606": {
            "id": "5071606",
            "speakerId": 1011,
            "speakerName": "鸣神大社公告",
            "text": "十分遗憾，不如一同祈祷战争早些结束吧，一切都会好起来的。",
            "nextDialogs": [
              "5071607"
            ]
          },
          "5071607": {
            "id": "5071607",
            "speakerId": 1006,
            "speakerName": "留言",
            "text": "「一点有用的话也不会说。」"
          }
        }
      }
    },
    {
      "subId": "50717",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5071701"
        ],
        "dialogs": {
          "5071701": {
            "id": "5071701",
            "speakerId": 1012,
            "speakerName": "中介广告",
            "text": "「多亏九条天领奉行孝行大人深谋远虑，『眼狩令』之施行迅疾如电，妄图大逆者皆弃家而逃。」",
            "nextDialogs": [
              "5071702"
            ]
          },
          "5071702": {
            "id": "5071702",
            "speakerId": 1012,
            "speakerName": "中介广告",
            "text": "「今特将逃亡者遗弃之房屋低价出租、出售，天领奉行担保责任，房源绝对安全！」"
          }
        }
      }
    }
  ]
}
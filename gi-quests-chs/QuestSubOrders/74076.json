          "740760201": {
            "id": "740760201",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "最后只剩下这里了。",
            "nextDialogs": [
              "740760202"
            ]
          },
          "740760202": {
            "id": "740760202",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "之前的探索都没有收获…",
            "nextDialogs": [
              "740760203"
            ]
          },
          "740760203": {
            "id": "740760203",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "嗯。但是，这里的入口还关着，说明我们还有机会。",
            "nextDialogs": [
              "740760204"
            ]
          },
          "740760204": {
            "id": "740760204",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "看来我们的竞争者没有解出这里的谜题。",
            "nextDialogs": [
              "740760205"
            ]
          },
          "740760205": {
            "id": "740760205",
            "speakerId": 1003,
            "speakerName": "西摩尔",
            "text": "此处的碑文写着：「从不分离」…「生于一瞬，常与相违，伴你长眠」…",
            "nextDialogs": [
              "740760206"
            ]
          },
          "740760206": {
            "id": "740760206",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "然后最后一句写的是——「原初一滴」。",
            "nextDialogs": [
              "740760207"
            ]
          },
          "740760207": {
            "id": "740760207",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "之前几处地方应该也有这种谜题吧。那些谜底，你们还记得吗？",
            "nextDialogs": [
              "740760208"
            ]
          },
          "740760208": {
            "id": "740760208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「影子」。",
            "nextDialogs": [
              "740760209"
            ]
          },
          "740760209": {
            "id": "740760209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「生命」。",
            "nextDialogs": [
              "740760210"
            ]
          },
          "740760210": {
            "id": "740760210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「爱」。",
            "nextDialogs": [
              "740760211"
            ]
          },
          "740760211": {
            "id": "740760211",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔，答案逐步抽象了起来。",
            "nextDialogs": [
              "740760212"
            ]
          },
          "740760212": {
            "id": "740760212",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "卡特皮拉、西摩尔，你们知不知道这个谜题的答案呀？"
          }
        }
      }

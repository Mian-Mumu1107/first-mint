    {
      "subId": "7407601",
      "subQuestName": "前往最后的封印",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740760101"
        ],
        "dialogs": {
          "740760101": {
            "id": "740760101",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "最后只剩下这里了。",
            "nextDialogs": [
              "740760102"
            ]
          },
          "740760102": {
            "id": "740760102",
            "speakerId": 1001,
            "speakerName": "安",
            "text": "好在入口还是封住的状态。",
            "nextDialogs": [
              "740760103"
            ]
          },
          "740760103": {
            "id": "740760103",
            "speakerId": 1001,
            "speakerName": "安",
            "text": "看来那个雅各布并没有解答这里的谜题。",
            "nextDialogs": [
              "740760104"
            ]
          },
          "740760104": {
            "id": "740760104",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "或者他解答出来了，却无法奉上谜底。",
            "nextDialogs": [
              "740760105"
            ]
          },
          "740760105": {
            "id": "740760105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我想想，之前的答案分别是「影子」、「生命」和「爱」。",
            "nextDialogs": [
              "740760106"
            ]
          },
          "740760106": {
            "id": "740760106",
            "speakerId": 1003,
            "speakerName": "西摩尔",
            "text": "然后根据之前的规律，我的逻辑模块推测碑文如下：",
            "nextDialogs": [
              "740760107"
            ]
          },
          "740760107": {
            "id": "740760107",
            "speakerId": 1003,
            "speakerName": "西摩尔",
            "text": "「从不分离」…「生于一瞬，常与相违，伴你长眠」…",
            "nextDialogs": [
              "740760108"
            ]
          },
          "740760108": {
            "id": "740760108",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "然后最后一句写的是——「原初一滴」。",
            "nextDialogs": [
              "740760109"
            ]
          },
          "740760109": {
            "id": "740760109",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "卡特皮拉、西摩尔，你们知不知道这个答案的谜底啊？"
          }
        }
      }
    },
    {
      "subId": "7407602",
      "subQuestName": "与大家对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740760401"
        ],
        "dialogs": {
          "740760401": {
            "id": "740760401",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "我对「原初一滴」这个词有些想法。",
            "nextDialogs": [
              "740760402"
            ]
          },
          "740760402": {
            "id": "740760402",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "听起来像是说世界创造之后的第一场雨。这种意象应该是古枫丹和水仙十字结社都很喜欢的。",
            "nextDialogs": [
              "740760403"
            ]
          },
          "740760403": {
            "id": "740760403",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那这怎么可能找得到嘛！",
            "nextDialogs": [
              "740760404"
            ]
          },
          "740760404": {
            "id": "740760404",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "所以这一滴水已经融在所有水之中了。每一滴水都是原初的一滴。",
            "nextDialogs": [
              "740760405"
            ]
          },
          "740760405": {
            "id": "740760405",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "就像是原初的神把伟大的潜力散布了开来。我们每个人身体里也都有神圣的成分。",
            "nextDialogs": [
              "740760406"
            ]
          },
          "740760406": {
            "id": "740760406",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "但是答案这么简单的话，前面那人应该可以很简单就供奉出答案啊。",
            "nextDialogs": [
              "740760407"
            ]
          },
          "740760407": {
            "id": "740760407",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "确实如此。应该是我错了。",
            "nextDialogs": [
              "740760408"
            ]
          },
          "740760408": {
            "id": "740760408",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "虽然它不是正确答案，但它仍然是个好答案。我只能觉得设置谜题的人不懂浪漫了。",
            "nextDialogs": [
              "740760409"
            ]
          },
          "740760409": {
            "id": "740760409",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "他还笑你不懂安保呢！",
            "nextDialogs": [
              "740760410"
            ]
          },
          "740760410": {
            "id": "740760410",
            "speakerId": 1003,
            "speakerName": "西摩尔",
            "text": "我无法作答。关于原初一滴的搜索结果有一千二百条。",
            "nextDialogs": [
              "740760411"
            ]
          },
          "740760411": {
            "id": "740760411",
            "speakerId": 1003,
            "speakerName": "西摩尔",
            "text": "「世界上第一滴酒传说是风神…」",
            "nextDialogs": [
              "740760413",
              "740760415"
            ]
          },
          "740760413": {
            "id": "740760413",
            "speakerId": 1003,
            "speakerName": "西摩尔",
            "text": "好的。",
            "nextDialogs": [
              "740760416"
            ]
          },
          "740760416": {
            "id": "740760416",
            "speakerId": 1001,
            "speakerName": "安",
            "text": "这个，我似乎有些东西可以分享。",
            "nextDialogs": [
              "740760417"
            ]
          },
          "740760417": {
            "id": "740760417",
            "speakerId": 1001,
            "speakerName": "安",
            "text": "有一个传说，纯水精灵是前代水神的第一滴泪。",
            "nextDialogs": [
              "740760418"
            ]
          },
          "740760418": {
            "id": "740760418",
            "speakerId": 1001,
            "speakerName": "安",
            "text": "而大地上的第一滴泪，正是最早纯水精灵理解了人类之后流下的。",
            "nextDialogs": [
              "740760419"
            ]
          },
          "740760419": {
            "id": "740760419",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "世界上最早的眼泪不应该是第一个人类的婴儿哭出来吗？",
            "nextDialogs": [
              "740760420"
            ]
          },
          "740760420": {
            "id": "740760420",
            "speakerId": 1001,
            "speakerName": "安",
            "text": "动物的流泪其实是排出盐分，而人类在那个平稳的年代，就连出生时都是欢笑着呼吸的。",
            "nextDialogs": [
              "740760421"
            ]
          },
          "740760421": {
            "id": "740760421",
            "speakerId": 1001,
            "speakerName": "安",
            "text": "——传说是这么说的啦。",
            "nextDialogs": [
              "740760422"
            ]
          },
          "740760422": {
            "id": "740760422",
            "speakerId": 1003,
            "speakerName": "西摩尔",
            "text": "其实我认为婴儿的哭泣和动物的排盐可以视作类似的非感性行为。",
            "nextDialogs": [
              "740760423"
            ]
          },
          "740760423": {
            "id": "740760423",
            "speakerId": 1003,
            "speakerName": "西摩尔",
            "text": "婴儿哭泣有外界刺激和为了尽快填充肺部的双重原因。须弥的生论派教材是这么写的。",
            "nextDialogs": [
              "740760424"
            ]
          },
          "740760424": {
            "id": "740760424",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "所以答案是，纯水精灵吗？",
            "nextDialogs": [
              "740760425"
            ]
          },
          "740760425": {
            "id": "740760425",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那确实前面那人可能供奉不出正确答案呢。"
          },
          "740760415": {
            "id": "740760415",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你要死马当活马医的话可以换个靠谱的方向吧！"
          }
        }
      }
    },
    {
      "subId": "7407603",
      "subQuestName": "解开象限内的谜题",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740760301"
        ],
        "dialogs": {
          "740760301": {
            "id": "740760301",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "最后只剩下这里了。",
            "nextDialogs": [
              "740760302"
            ]
          },
          "740760302": {
            "id": "740760302",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "之前的探索都没有收获…",
            "nextDialogs": [
              "740760303"
            ]
          },
          "740760303": {
            "id": "740760303",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "嗯。但是，这里的入口还关着，说明我们还有机会。",
            "nextDialogs": [
              "740760304"
            ]
          },
          "740760304": {
            "id": "740760304",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "看来我们的竞争者没有解出这里的谜题。",
            "nextDialogs": [
              "740760305"
            ]
          },
          "740760305": {
            "id": "740760305",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不过，说到底，到底是谁会跟我们抢这个呀？",
            "nextDialogs": [
              "740760306"
            ]
          },
          "740760306": {
            "id": "740760306",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "假定数百年的岁月里水仙十字结社没能再度兴起，而是陷入沉寂，我所具有的知识依旧具有意义，那结合此前的情况来看——",
            "nextDialogs": [
              "740760307"
            ]
          },
          "740760307": {
            "id": "740760307",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "恐怕是雅各布吧。",
            "nextDialogs": [
              "740760308"
            ]
          },
          "740760308": {
            "id": "740760308",
            "speakerId": 1001,
            "speakerName": "安",
            "text": "是那个欺负西摩尔的坏人？他要这些东西干什么…",
            "nextDialogs": [
              "740760309"
            ]
          },
          "740760309": {
            "id": "740760309",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "他的目的恐怕与我们的目的相同：寻找锻铸水仙十字圣剑的材料。",
            "nextDialogs": [
              "740760310"
            ]
          },
          "740760310": {
            "id": "740760310",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "水仙十字结社依据地下之国与古枫丹的神秘哲学，在物质世界重现了必要的四种架空物质。",
            "nextDialogs": [
              "740760311"
            ]
          },
          "740760311": {
            "id": "740760311",
            "speakerId": 1003,
            "speakerName": "西摩尔",
            "text": "无法理解。",
            "nextDialogs": [
              "740760312"
            ]
          },
          "740760312": {
            "id": "740760312",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "神秘的东西本身只作用于体验，可以说比元素力还要跳脱常理呢。",
            "nextDialogs": [
              "740760313"
            ]
          },
          "740760313": {
            "id": "740760313",
            "speakerId": 1003,
            "speakerName": "西摩尔",
            "text": "几十年前我录入过教令院的素论派入门至中级教材，元素力也没有那么神奇。",
            "nextDialogs": [
              "740760314"
            ]
          },
          "740760314": {
            "id": "740760314",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "是吗。那反正结论上来说，这是枫丹古法与地下古国技术的交汇。",
            "nextDialogs": [
              "740760315"
            ]
          },
          "740760315": {
            "id": "740760315",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "世界上出现了「记忆」、「愿望」、「灵魂」与「人格」这四种物质。",
            "nextDialogs": [
              "740760316"
            ]
          },
          "740760316": {
            "id": "740760316",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "为了防止歧义，我们把它们叫做「记忆」之块、「愿望」之块、「灵魂」之块与「人格」之块好了。",
            "nextDialogs": [
              "740760317"
            ]
          },
          "740760317": {
            "id": "740760317",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "为什么这些东西会用来打造圣剑啊？",
            "nextDialogs": [
              "740760318"
            ]
          },
          "740760318": {
            "id": "740760318",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "水仙十字结社的神秘哲学里，神殿是宇宙的缩影，社员是众神的代行，圣油是锤炼的意志。",
            "nextDialogs": [
              "740760319"
            ]
          },
          "740760319": {
            "id": "740760319",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "圣剑，则是破开一切的「理性」。它需由完整的人之意志诞生而出。",
            "nextDialogs": [
              "740760320"
            ]
          },
          "740760320": {
            "id": "740760320",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好玄乎。",
            "nextDialogs": [
              "740760321"
            ]
          },
          "740760321": {
            "id": "740760321",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "哎呀，神秘哲学是这样的。看着相似就可以攀附。当这种东西变成魔法了就假成真的了。",
            "nextDialogs": [
              "740760322"
            ]
          },
          "740760322": {
            "id": "740760322",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "无论如何，我们的对手没有解开谜题；抑或是他解答出来了，却无法奉上谜底。既然对手是雅各布，那看来情况是后者。",
            "nextDialogs": [
              "740760323"
            ]
          },
          "740760323": {
            "id": "740760323",
            "speakerId": 1003,
            "speakerName": "西摩尔",
            "text": "此处的碑文写着：「从不分离」…「生于一瞬，常与相违，伴你长眠」…",
            "nextDialogs": [
              "740760324"
            ]
          },
          "740760324": {
            "id": "740760324",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "然后最后一句写的是——「原初一滴」。",
            "nextDialogs": [
              "740760325"
            ]
          },
          "740760325": {
            "id": "740760325",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "之前几处地方应该也有这种谜题吧。那些谜底，你们还记得吗？",
            "nextDialogs": [
              "740760326"
            ]
          },
          "740760326": {
            "id": "740760326",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「影子」。",
            "nextDialogs": [
              "740760327"
            ]
          },
          "740760327": {
            "id": "740760327",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「生命」。",
            "nextDialogs": [
              "740760328"
            ]
          },
          "740760328": {
            "id": "740760328",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「爱」。",
            "nextDialogs": [
              "740760329"
            ]
          },
          "740760329": {
            "id": "740760329",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔，答案逐步抽象了起来。",
            "nextDialogs": [
              "740760330"
            ]
          },
          "740760330": {
            "id": "740760330",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "卡特皮拉、西摩尔，你们知不知道这个谜题的答案呀？"
          }
        }
      }
    },
    {
      "subId": "7407604",
      "subQuestName": "获取「人格」之块",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7407605",
      "subQuestName": "与大家对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740760501"
        ],
        "dialogs": {
          "740760501": {
            "id": "740760501",
            "speakerId": 1001,
            "speakerName": "安",
            "text": "前方就是「人格」之块吗？",
            "nextDialogs": [
              "740760502"
            ]
          },
          "740760502": {
            "id": "740760502",
            "speakerId": 1003,
            "speakerName": "西摩尔",
            "text": "无法从密度分析眼前的物质。似乎重量为…零。",
            "nextDialogs": [
              "740760503"
            ]
          },
          "740760503": {
            "id": "740760503",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "看来我们拿下了最后一分。这样至少就可以和对面斡旋一下了。",
            "nextDialogs": [
              "740760504"
            ]
          },
          "740760504": {
            "id": "740760504",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "往好处想的话，至少我们就可以阻止水仙十字结社最后锻造出圣剑了。",
            "nextDialogs": [
              "740760505"
            ]
          },
          "740760505": {
            "id": "740760505",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "并不是，派蒙。我们的最终目的是铸造出圣剑，并且用圣剑去阻止他们的计划。",
            "nextDialogs": [
              "740760506"
            ]
          },
          "740760506": {
            "id": "740760506",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "当然，安，我并没有忘记这柄剑对于你的意义。",
            "nextDialogs": [
              "740760507"
            ]
          },
          "740760507": {
            "id": "740760507",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "能够切割意志的圣剑，对于你是解开谜题的钥匙。其实它对我来说也一样重要。",
            "nextDialogs": [
              "740760508"
            ]
          },
          "740760508": {
            "id": "740760508",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "只不过我们有更重要、更紧迫的事情。我们之后再解答关于自身的谜，你可以接受吗？",
            "nextDialogs": [
              "740760509"
            ]
          },
          "740760509": {
            "id": "740760509",
            "speakerId": 1001,
            "speakerName": "安",
            "text": "我没有问题。",
            "nextDialogs": [
              "740760510"
            ]
          },
          "740760510": {
            "id": "740760510",
            "speakerId": 1000,
            "speakerName": "卡特皮拉",
            "text": "#那么{NICKNAME}，请你去收下「人格」吧。"
          }
        }
      }
    },

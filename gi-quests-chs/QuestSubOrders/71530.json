  "subQuests": [
    {
      "subId": "7153001",
      "subQuestName": "与遐庆对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715300101"
        ],
        "dialogs": {
          "715300101": {
            "id": "715300101",
            "speakerId": 1000,
            "speakerName": "遐庆",
            "text": "#海灯节快乐哟，{M#大哥}{F#大姐}和小妹…",
            "nextDialogs": [
              "715300102"
            ]
          },
          "715300102": {
            "id": "715300102",
            "speakerId": 1000,
            "speakerName": "遐庆",
            "text": "哎，你们不是之前来找嘉明的那两位大名人嘛？",
            "nextDialogs": [
              "715300103"
            ]
          },
          "715300103": {
            "id": "715300103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们之前见过你，你和嘉明在一起玩来着！",
            "nextDialogs": [
              "715300104"
            ]
          },
          "715300104": {
            "id": "715300104",
            "speakerId": 1000,
            "speakerName": "遐庆",
            "text": "确实，你们还记得我，我走大运了！",
            "nextDialogs": [
              "715300105"
            ]
          },
          "715300105": {
            "id": "715300105",
            "speakerId": 1000,
            "speakerName": "遐庆",
            "text": "听说你们是高手，做什么都很在行！我每天走几步路去吃虎岩买菜，路上都能听到好几个人夸你们。",
            "nextDialogs": [
              "715300108"
            ]
          },
          "715300108": {
            "id": "715300108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我我我，我也有吃饭之外的本领啦！",
            "nextDialogs": [
              "715300109"
            ]
          },
          "715300109": {
            "id": "715300109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，我想想，我还会什么来着…",
            "nextDialogs": [
              "715300110"
            ]
          },
          "715300110": {
            "id": "715300110",
            "speakerId": 1000,
            "speakerName": "遐庆",
            "text": "我懂！一般人哪里能飘起来，你又白又轻又蓬松，就像鸽子小仙！",
            "nextDialogs": [
              "715300111"
            ]
          },
          "715300111": {
            "id": "715300111",
            "speakerId": 1000,
            "speakerName": "遐庆",
            "text": "会飞就很厉害了，拿东西好方便，干活轻轻松松，你要多帮帮你的朋友。"
          }
        }
      }
    }
  ]
}
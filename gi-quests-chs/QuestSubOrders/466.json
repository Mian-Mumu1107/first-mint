    {
      "subId": "46618",
      "subQuestName": "与迪卢克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660701"
        ],
        "dialogs": {
          "4660701": {
            "id": "4660701",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "霍夫曼似乎还没回来。",
            "nextDialogs": [
              "4660702"
            ]
          },
          "4660702": {
            "id": "4660702",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "看样子我们没有迟到。",
            "nextDialogs": [
              "4660703"
            ]
          },
          "4660703": {
            "id": "4660703",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "呼…呼…总算是解决了，只是想不到深渊教团派出的，竟然只是些史莱姆而已。",
            "nextDialogs": [
              "4660704"
            ]
          },
          "4660704": {
            "id": "4660704",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "那还真是了不起。",
            "nextDialogs": [
              "4660705"
            ]
          },
          "4660705": {
            "id": "4660705",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "骑士团不如干脆改行，做些专门清理史莱姆的家政服务吧，没准比现在更有价值。",
            "nextDialogs": [
              "4660706"
            ]
          },
          "4660706": {
            "id": "4660706",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "迪卢克先生就别挖苦我们了…",
            "nextDialogs": [
              "4660707"
            ]
          },
          "4660707": {
            "id": "4660707",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "#嗯？{NICKNAME}，你脸上的汗水是怎么回事，难道刚才出去过了？",
            "nextDialogs": [
              "4660709",
              "4660711"
            ]
          },
          "4660709": {
            "id": "4660709",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "热吗？可为什么你好像还在大喘气…",
            "nextDialogs": [
              "4660712"
            ]
          },
          "4660712": {
            "id": "4660712",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂，怎么办，霍夫曼好像已经在怀疑了…",
            "nextDialogs": [
              "4660713"
            ]
          },
          "4660713": {
            "id": "4660713",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "嗯…",
            "nextDialogs": [
              "4660714"
            ]
          },
          "4660714": {
            "id": "4660714",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "…这位先生你好。冒昧问一下…",
            "nextDialogs": [
              "4660715"
            ]
          },
          "4660715": {
            "id": "4660715",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "…你有看到迪卢克先生…哦，就是今天的酒保先生，他刚才出过门吗？",
            "nextDialogs": [
              "4660716"
            ]
          },
          "4660716": {
            "id": "4660716",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，糟了！居然问其他客人…这下要露馅了！",
            "nextDialogs": [
              "4660717"
            ]
          },
          "4660717": {
            "id": "4660717",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "4660718"
            ]
          },
          "4660718": {
            "id": "4660718",
            "speakerId": 1007,
            "speakerName": "酒客众",
            "text": "哦，老爷他…啊，不不，迪卢克先生他一直在柜台，哪儿也没去过。",
            "nextDialogs": [
              "4660719"
            ]
          },
          "4660719": {
            "id": "4660719",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "这样啊…",
            "nextDialogs": [
              "4660720"
            ]
          },
          "4660720": {
            "id": "4660720",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "霍夫曼先生，这是你之前点的蒲公英酒。",
            "nextDialogs": [
              "4660721"
            ]
          },
          "4660721": {
            "id": "4660721",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "喝了它早点回去吧，代我向骑士团的各位问好。",
            "nextDialogs": [
              "4660722"
            ]
          },
          "4660722": {
            "id": "4660722",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "啊…不用了，我现在着急回骑士团复命，这杯就敬给您吧。",
            "nextDialogs": [
              "4660723"
            ]
          },
          "4660723": {
            "id": "4660723",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "…呼…真是奇怪。",
            "nextDialogs": [
              "4660724"
            ]
          },
          "4660724": {
            "id": "4660724",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呼哇…刚才真是吓死了，我还以为肯定露馅了…",
            "nextDialogs": [
              "4660725"
            ]
          },
          "4660725": {
            "id": "4660725",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "这点我早有预想，所以…",
            "nextDialogs": [
              "4660726"
            ]
          },
          "4660726": {
            "id": "4660726",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "…今天除了你们之外，所有客人都是晨曦酒庄过来的自己人。",
            "nextDialogs": [
              "4660727"
            ]
          },
          "4660727": {
            "id": "4660727",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "全都是托吗！",
            "nextDialogs": [
              "4660728"
            ]
          },
          "4660728": {
            "id": "4660728",
            "speakerId": 1008,
            "speakerName": "凯亚",
            "text": "不是所有哦…严格来说，是「除我以外」。",
            "nextDialogs": [
              "4660729"
            ]
          },
          "4660729": {
            "id": "4660729",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是凯亚！你怎么在这儿？",
            "nextDialogs": [
              "4660730"
            ]
          },
          "4660730": {
            "id": "4660730",
            "speakerId": 1008,
            "speakerName": "凯亚",
            "text": "只是挑了个可以安安静静看戏的好位置而已。",
            "nextDialogs": [
              "4660731"
            ]
          },
          "4660731": {
            "id": "4660731",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难道…从一开始你就在了吗？",
            "nextDialogs": [
              "4660732"
            ]
          },
          "4660732": {
            "id": "4660732",
            "speakerId": 1008,
            "speakerName": "凯亚",
            "text": "没错，这部「暗夜英雄的不在场证明」真是精彩，比美酒还要醉人。",
            "nextDialogs": [
              "4660733"
            ]
          },
          "4660733": {
            "id": "4660733",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "哼…",
            "nextDialogs": [
              "4660734"
            ]
          },
          "4660734": {
            "id": "4660734",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "然后呢？你准备把这些都报告给骑士团？",
            "nextDialogs": [
              "4660735"
            ]
          },
          "4660735": {
            "id": "4660735",
            "speakerId": 1008,
            "speakerName": "凯亚",
            "text": "哈哈哈…你应该了解我的，我对告密的事儿可没什么兴趣。",
            "nextDialogs": [
              "4660736"
            ]
          },
          "4660736": {
            "id": "4660736",
            "speakerId": 1008,
            "speakerName": "凯亚",
            "text": "只是单纯想要知道，蒙德的「暗夜英雄」可以做到什么程度…",
            "nextDialogs": [
              "4660737"
            ]
          },
          "4660737": {
            "id": "4660737",
            "speakerId": 1008,
            "speakerName": "凯亚",
            "text": "果然，永远不会让人失望。",
            "nextDialogs": [
              "4660738"
            ]
          },
          "4660738": {
            "id": "4660738",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "我还不需要向你证明什么。",
            "nextDialogs": [
              "4660739"
            ]
          },
          "4660739": {
            "id": "4660739",
            "speakerId": 1008,
            "speakerName": "凯亚",
            "text": "那是自然。",
            "nextDialogs": [
              "4660740"
            ]
          },
          "4660740": {
            "id": "4660740",
            "speakerId": 1008,
            "speakerName": "凯亚",
            "text": "但最让我意外的是，孤高的「暗夜英雄」居然也会接受别人的帮助…",
            "nextDialogs": [
              "4660741"
            ]
          },
          "4660741": {
            "id": "4660741",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "抱歉本店已经打烊了，客人你请回吧。",
            "nextDialogs": [
              "4660742"
            ]
          },
          "4660742": {
            "id": "4660742",
            "speakerId": 1008,
            "speakerName": "凯亚",
            "text": "好了好了，今晚我已经不需要酒来助兴了。",
            "nextDialogs": [
              "4660743"
            ]
          },
          "4660743": {
            "id": "4660743",
            "speakerId": 1008,
            "speakerName": "凯亚",
            "text": "不过在离开前，我还有句话想说。",
            "nextDialogs": [
              "4660744"
            ]
          },
          "4660744": {
            "id": "4660744",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "那就最后一句。",
            "nextDialogs": [
              "4660745"
            ]
          },
          "4660745": {
            "id": "4660745",
            "speakerId": 1008,
            "speakerName": "凯亚",
            "text": "迪卢克，你有了这个「助手」，我可是感到了一种奇妙的安心啊。",
            "nextDialogs": [
              "4660746"
            ]
          },
          "4660746": {
            "id": "4660746",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "……",
            "nextDialogs": [
              "4660747"
            ]
          },
          "4660747": {
            "id": "4660747",
            "speakerId": 1008,
            "speakerName": "凯亚",
            "text": "祝愿你们有一个美妙的夜晚，回见。",
            "nextDialogs": [
              "4660748"
            ]
          },
          "4660748": {
            "id": "4660748",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "凯亚的意思是…",
            "nextDialogs": [
              "4660749"
            ]
          },
          "4660749": {
            "id": "4660749",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "别管那家伙了。",
            "nextDialogs": [
              "4660750"
            ]
          },
          "4660750": {
            "id": "4660750",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "你们这次帮了我这么多，这是谢礼。",
            "nextDialogs": [
              "4660751"
            ]
          },
          "4660751": {
            "id": "4660751",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔哇！谢谢迪卢克老爷！",
            "nextDialogs": [
              "4660752"
            ]
          },
          "4660752": {
            "id": "4660752",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "虽说已经习惯一个人行动，但有你们帮忙的感觉也还不错。",
            "nextDialogs": [
              "4660753"
            ]
          },
          "4660753": {
            "id": "4660753",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "今后有什么需要，可以来找我。"
          },
          "4660711": {
            "id": "4660711",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "是吗，可是为什么偏偏选了这个时候…"
          }
        }
      }

        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "46622",
      "subQuestName": "把4个冰雾花花朵交给迪卢克",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660901"
        ],
        "dialogs": {
          "4660901": {
            "id": "4660901",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "哦，回来了吗。",
            "nextDialogs": [
              "4660902"
            ]
          },
          "4660902": {
            "id": "4660902",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "介绍一下，他是酒庄的酿造师…",
            "nextDialogs": [
              "4660903"
            ]
          },
          "4660903": {
            "id": "4660903",
            "speakerId": 1002,
            "speakerName": "康纳",
            "text": "这么多冰雾花！我已经开始期待「它」的效果了！",
            "nextDialogs": [
              "4660904"
            ]
          },
          "4660904": {
            "id": "4660904",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "提纯设备可以承受这样的纯度么，会不会出什么问题…",
            "nextDialogs": [
              "4660905"
            ]
          },
          "4660905": {
            "id": "4660905",
            "speakerId": 1002,
            "speakerName": "康纳",
            "text": "喔…喔喔喔——大老板亲自对我说话了！",
            "nextDialogs": [
              "4660906"
            ]
          },
          "4660906": {
            "id": "4660906",
            "speakerId": 1002,
            "speakerName": "康纳",
            "text": "放心好了，老爷！只要是您的意思，我就算搭上这条命都十分甘心！",
            "nextDialogs": [
              "4660907"
            ]
          },
          "4660907": {
            "id": "4660907",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这不是可以拼上性命的事吧…",
            "nextDialogs": [
              "4660908"
            ]
          },
          "4660908": {
            "id": "4660908",
            "speakerId": 1002,
            "speakerName": "康纳",
            "text": "你们先聊，我这就开工！",
            "nextDialogs": [
              "4660909"
            ]
          },
          "4660909": {
            "id": "4660909",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他拿那些冰雾花去干什么了？",
            "nextDialogs": [
              "4660910"
            ]
          },
          "4660910": {
            "id": "4660910",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "事情是这样的…",
            "nextDialogs": [
              "4660911"
            ]
          },
          "4660911": {
            "id": "4660911",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "前些日子酒庄在研发新口味的时候，试着加了些冰雾花来让口感清凉。",
            "nextDialogs": [
              "4660912"
            ]
          },
          "4660912": {
            "id": "4660912",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "经过提纯后的冰雾花确实有很强的吸引力…",
            "nextDialogs": [
              "4660913"
            ]
          },
          "4660913": {
            "id": "4660913",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "所以卖的很好嘛？",
            "nextDialogs": [
              "4660914"
            ]
          },
          "4660914": {
            "id": "4660914",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "不，我指的不是吸引酒客，而是…吸引史莱姆。",
            "nextDialogs": [
              "4660915"
            ]
          },
          "4660915": {
            "id": "4660915",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "这类依靠汲取元素力量维生的生物，完全抵抗不了它的诱惑。",
            "nextDialogs": [
              "4660916"
            ]
          },
          "4660916": {
            "id": "4660916",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "于是我想，干脆利用这一点做些文章…",
            "nextDialogs": [
              "4660917"
            ]
          },
          "4660917": {
            "id": "4660917",
            "speakerId": 1003,
            "speakerName": "提纯中",
            "text": "咚！咔啦咔啦…哐哐！",
            "nextDialogs": [
              "4660918"
            ]
          },
          "4660918": {
            "id": "4660918",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇！刚刚那是什么声音！",
            "nextDialogs": [
              "4660919"
            ]
          },
          "4660919": {
            "id": "4660919",
            "speakerId": 1002,
            "speakerName": "康纳",
            "text": "好冷…好冷！迪、迪卢克…老爷，提、提纯…已经…完成了，只是设、设备…",
            "nextDialogs": [
              "4660920"
            ]
          },
          "4660920": {
            "id": "4660920",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "辛苦你了，设备你不用在乎，我会让管家重新订购。",
            "nextDialogs": [
              "4660921"
            ]
          },
          "4660921": {
            "id": "4660921",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真是阔气的发言！",
            "nextDialogs": [
              "4660922"
            ]
          },
          "4660922": {
            "id": "4660922",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "刚才说的就是这东西了。",
            "nextDialogs": [
              "4660923"
            ]
          },
          "4660923": {
            "id": "4660923",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "提纯后的冰雾花——可以叫它「元素诱饵」吧。",
            "nextDialogs": [
              "4660924"
            ]
          },
          "4660924": {
            "id": "4660924",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好厉害，这扑面而来的元素气息！要怎么试效果呢？",
            "nextDialogs": [
              "4660925"
            ]
          },
          "4660925": {
            "id": "4660925",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "洒一点在那边的地上吧，当心…就一点点。"
          }
        }
      }
    },
    {
      "subId": "46604",
      "subQuestName": "布置「元素诱饵」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660401"
        ],
        "dialogs": {
          "4660401": {
            "id": "4660401",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "骑士团的霍夫曼先生，这个时间光临…是有何贵干？",
            "nextDialogs": [
              "4660402"
            ]
          },
          "4660402": {
            "id": "4660402",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "…啊，没事没事。忙里偷闲，只是想来小酌两杯…没有别的意思。",
            "nextDialogs": [
              "4660403"
            ]
          },
          "4660403": {
            "id": "4660403",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "哦？旅行者，这么巧你们也在。",
            "nextDialogs": [
              "4660404"
            ]
          },
          "4660404": {
            "id": "4660404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是呀~今晚心情不错，我们出来转转。",
            "nextDialogs": [
              "4660405"
            ]
          },
          "4660405": {
            "id": "4660405",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "几位想要来点什么？",
            "nextDialogs": [
              "4660406"
            ]
          },
          "4660406": {
            "id": "4660406",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "那就「蒲公英酒」吧。",
            "nextDialogs": [
              "4660407"
            ]
          },
          "4660407": {
            "id": "4660407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "派蒙要苹果汁！",
            "nextDialogs": [
              "4660409"
            ]
          },
          "4660409": {
            "id": "4660409",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#啊…我的钱袋好像忘记带出来…{NICKNAME}你有带钱吗？"
          }
        }
      }
    },
    {
      "subId": "46605",
      "subQuestName": "与迪卢克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660201"
        ],
        "dialogs": {
          "4660201": {
            "id": "4660201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这样就可以了吗？",
            "nextDialogs": [
              "4660202"
            ]
          },
          "4660202": {
            "id": "4660202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…要等多久才会有效果呢？",
            "nextDialogs": [
              "4660203"
            ]
          },
          "4660203": {
            "id": "4660203",
            "speakerId": 1005,
            "speakerName": "？？？",
            "text": "咔嚓…咔嚓…",
            "nextDialogs": [
              "4660204"
            ]
          },
          "4660204": {
            "id": "4660204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔哇，史莱姆真的出现了！…只是数量好像比想象中还多…",
            "nextDialogs": [
              "4660205"
            ]
          },
          "4660205": {
            "id": "4660205",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "效果似乎已经超过预期了…",
            "nextDialogs": [
              "4660206"
            ]
          },
          "4660206": {
            "id": "4660206",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "在庄园被这些史莱姆搞得一团糟之前，把它们处理掉吧。"
          }
        }
      }
    },
    {
      "subId": "46606",
      "subQuestName": "消灭史莱姆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660601"
        ],
        "dialogs": {
          "4660601": {
            "id": "4660601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不愧是迪卢克老爷，真是干净利落！",
            "nextDialogs": [
              "4660602"
            ]
          },
          "4660602": {
            "id": "4660602",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "不过是些杂碎而已。",
            "nextDialogs": [
              "4660603"
            ]
          },
          "4660603": {
            "id": "4660603",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "没有闲聊的时间了，不知侧门那边情况如何，赶快回<color=#00E1FFFF>酒馆</color>吧。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "46601",
      "subQuestName": "前往晨曦酒庄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660101"
        ],
        "dialogs": {
          "4660101": {
            "id": "4660101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "迪卢克老爷！听我说…",
            "nextDialogs": [
              "4660102"
            ]
          },
          "4660102": {
            "id": "4660102",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "哼，凯亚那家伙吗…",
            "nextDialogs": [
              "4660103"
            ]
          },
          "4660103": {
            "id": "4660103",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "我早该意识到了。对他来说，现在就是从我这里扳回一城的最好时机。",
            "nextDialogs": [
              "4660104"
            ]
          },
          "4660104": {
            "id": "4660104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你们好像有什么恩怨的样子…",
            "nextDialogs": [
              "4660105"
            ]
          },
          "4660105": {
            "id": "4660105",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "先不说这个，骑士团的想法倒是跟我预料的差不多。",
            "nextDialogs": [
              "4660106"
            ]
          },
          "4660106": {
            "id": "4660106",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "现在将计就计就好。",
            "nextDialogs": [
              "4660108"
            ]
          },
          "4660108": {
            "id": "4660108",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "不行。既然骑士团已经知道我代班的事，不去的话反而招致怀疑。",
            "nextDialogs": [
              "4660109"
            ]
          },
          "4660109": {
            "id": "4660109",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "这也是凯亚的算计。",
            "nextDialogs": [
              "4660110"
            ]
          },
          "4660110": {
            "id": "4660110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那该怎么办呢？",
            "nextDialogs": [
              "4660112"
            ]
          },
          "4660112": {
            "id": "4660112",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "安静一点，让我想想…",
            "nextDialogs": [
              "4660113"
            ]
          },
          "4660113": {
            "id": "4660113",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "……",
            "nextDialogs": [
              "4660114"
            ]
          },
          "4660114": {
            "id": "4660114",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "…既然要监视我，那就如他所愿。",
            "nextDialogs": [
              "4660115"
            ]
          },
          "4660115": {
            "id": "4660115",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "我们来创造一个完美的「不在场证明」吧。",
            "nextDialogs": [
              "4660116"
            ]
          },
          "4660116": {
            "id": "4660116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「不在场证明」？那是什么意思呢？",
            "nextDialogs": [
              "4660117"
            ]
          },
          "4660117": {
            "id": "4660117",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "想知道的话，就先帮我个小忙吧。",
            "nextDialogs": [
              "4660118"
            ]
          },
          "4660118": {
            "id": "4660118",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么还要卖关子呀…",
            "nextDialogs": [
              "4660119"
            ]
          },
          "4660119": {
            "id": "4660119",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "<color=#00E1FFFF>酒庄西北</color>方向，有蒙德最好的冰雾花产地。周边地方也零零散散长了一些。",
            "nextDialogs": [
              "4660120"
            ]
          },
          "4660120": {
            "id": "4660120",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "请你们帮我收集几株回来吧，我在这里做些其它准备。"
          }
        }
      }
    },
    {
      "subId": "46602",
      "subQuestName": "向迪卢克提供情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "46603",
      "subQuestName": "离开酒庄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660301"
        ],
        "dialogs": {
          "4660301": {
            "id": "4660301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呼…才一点点居然就有这么强的效果，好在没有白忙活。",
            "nextDialogs": [
              "4660302"
            ]
          },
          "4660302": {
            "id": "4660302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "于是现在可以说了吗？迪卢克老爷的计划到底是什么呀？",
            "nextDialogs": [
              "4660303"
            ]
          },
          "4660303": {
            "id": "4660303",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "嗯，计划其实是这样的…",
            "nextDialogs": [
              "4660304"
            ]
          },
          "4660304": {
            "id": "4660304",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "…就是这样。",
            "nextDialogs": [
              "4660305"
            ]
          },
          "4660305": {
            "id": "4660305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但是…这真的没关系吗？",
            "nextDialogs": [
              "4660306"
            ]
          },
          "4660306": {
            "id": "4660306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…只靠你一个人…",
            "nextDialogs": [
              "4660307"
            ]
          },
          "4660307": {
            "id": "4660307",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "从一开始就是我一个人的坚持…",
            "nextDialogs": [
              "4660308"
            ]
          },
          "4660308": {
            "id": "4660308",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "…事到如今，也该由我一个人去面对。",
            "nextDialogs": [
              "4660309"
            ]
          },
          "4660309": {
            "id": "4660309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好吧~既然你已经决定了。",
            "nextDialogs": [
              "4660310"
            ]
          },
          "4660310": {
            "id": "4660310",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#不过在那之前，我和{NICKNAME}还是会帮你的，对吧？",
            "nextDialogs": [
              "4660314",
              "4660313"
            ]
          },
          "4660314": {
            "id": "4660314",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "是我欠你们一个人情。那么就按照计划，<color=#00E1FFFF>酒馆</color>见了。"
          },
          "4660313": {
            "id": "4660313",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂！别说那么不合时宜的话啦！"
          }
        }
      }
    },
    {
      "subId": "46621",
      "subQuestName": "在水边采集冰雾花花朵",
      "sceneId": null,
      "locations": [],

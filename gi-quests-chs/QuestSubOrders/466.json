    {
      "subId": "46613",
      "subQuestName": "与迪卢克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4660501"
        ],
        "dialogs": {
          "4660501": {
            "id": "4660501",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "…是的，凯亚队长虽然厉害，但总是把我们折腾得够呛…",
            "nextDialogs": [
              "4660502"
            ]
          },
          "4660502": {
            "id": "4660502",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "唉，不对，不该这么说上司的坏话，万一被凯亚队长听到了就…",
            "nextDialogs": [
              "4660503"
            ]
          },
          "4660503": {
            "id": "4660503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们回来啦，我的苹果汁好了吗？",
            "nextDialogs": [
              "4660504"
            ]
          },
          "4660504": {
            "id": "4660504",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "嗯，稍等。",
            "nextDialogs": [
              "4660505"
            ]
          },
          "4660505": {
            "id": "4660505",
            "speakerId": 1006,
            "speakerName": "城门守卫",
            "text": "霍夫曼先生，霍夫曼先生！侧门那边出事了，叫大家去侧门集合！",
            "nextDialogs": [
              "4660506"
            ]
          },
          "4660506": {
            "id": "4660506",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "什么？那边发生什么事了？",
            "nextDialogs": [
              "4660507"
            ]
          },
          "4660507": {
            "id": "4660507",
            "speakerId": 1006,
            "speakerName": "城门守卫",
            "text": "是…是史莱姆。",
            "nextDialogs": [
              "4660508"
            ]
          },
          "4660508": {
            "id": "4660508",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "史莱姆？史莱姆有什么好慌张的，不是很常见吗？",
            "nextDialogs": [
              "4660509"
            ]
          },
          "4660509": {
            "id": "4660509",
            "speakerId": 1006,
            "speakerName": "城门守卫",
            "text": "我知道史莱姆很常见…但那里的史莱姆…比我这辈子见到的加起来还多…",
            "nextDialogs": [
              "4660510"
            ]
          },
          "4660510": {
            "id": "4660510",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "噗…",
            "nextDialogs": [
              "4660511"
            ]
          },
          "4660511": {
            "id": "4660511",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "难道这就是深渊教团的秘密武器？",
            "nextDialogs": [
              "4660512"
            ]
          },
          "4660512": {
            "id": "4660512",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "可是，我在这里还有别的任务…",
            "nextDialogs": [
              "4660513"
            ]
          },
          "4660513": {
            "id": "4660513",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "哦？别的任务，你不是说只是来喝酒的么。",
            "nextDialogs": [
              "4660514"
            ]
          },
          "4660514": {
            "id": "4660514",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "啊，不不…我的意思是…",
            "nextDialogs": [
              "4660515"
            ]
          },
          "4660515": {
            "id": "4660515",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "哼，这就是骑士团的作风吗？",
            "nextDialogs": [
              "4660516"
            ]
          },
          "4660516": {
            "id": "4660516",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "深渊教团已经到城门外了，居然还有闲情在这里喝酒。",
            "nextDialogs": [
              "4660517"
            ]
          },
          "4660517": {
            "id": "4660517",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "所以我总是说，西风骑士团不值得信任。",
            "nextDialogs": [
              "4660518"
            ]
          },
          "4660518": {
            "id": "4660518",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "这……",
            "nextDialogs": [
              "4660519"
            ]
          },
          "4660519": {
            "id": "4660519",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "唉，迪卢克先生说的对，我的表现让你失望了。",
            "nextDialogs": [
              "4660520"
            ]
          },
          "4660520": {
            "id": "4660520",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "我现在就出发，但在那之前…",
            "nextDialogs": [
              "4660521"
            ]
          },
          "4660521": {
            "id": "4660521",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "#{NICKNAME}，请过来一下，我有事拜托。",
            "nextDialogs": [
              "4660522"
            ]
          },
          "4660522": {
            "id": "4660522",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？",
            "nextDialogs": [
              "4660523"
            ]
          },
          "4660523": {
            "id": "4660523",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "嘘，小点声…你知道我的任务的吧，拜托你替我看住迪卢克先生一会儿，千万别让他出去。",
            "nextDialogs": [
              "4660524"
            ]
          },
          "4660524": {
            "id": "4660524",
            "speakerId": 1004,
            "speakerName": "霍夫曼",
            "text": "我现在去侧门看看，马上就回来，拜托了！",
            "nextDialogs": [
              "4660525"
            ]
          },
          "4660525": {
            "id": "4660525",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "碍事的人已经走了。",
            "nextDialogs": [
              "4660526"
            ]
          },
          "4660526": {
            "id": "4660526",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "一切都在按计划进行呢！",
            "nextDialogs": [
              "4660527"
            ]
          },
          "4660527": {
            "id": "4660527",
            "speakerId": 1001,
            "speakerName": "迪卢克",
            "text": "我也要出发了，要赶在霍夫曼回来之前，时间可并不宽裕。"
          }
        }
      }
    },

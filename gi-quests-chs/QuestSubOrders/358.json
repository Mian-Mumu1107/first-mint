    {
      "subId": "35801",
      "subQuestName": "进入骑士团总部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3580101"
        ],
        "dialogs": {
          "3580101": {
            "id": "3580101",
            "speakerId": 1000,
            "speakerName": "凯亚",
            "text": "…事情的经过，就是这样。",
            "nextDialogs": [
              "3580102"
            ]
          },
          "3580102": {
            "id": "3580102",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "蒙德欢迎你们，随风而来的旅行者。",
            "nextDialogs": [
              "3580103"
            ]
          },
          "3580103": {
            "id": "3580103",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "我是代理团长，琴。这位是丽莎，骑士团的图书管理员。",
            "nextDialogs": [
              "3580104"
            ]
          },
          "3580104": {
            "id": "3580104",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "呀，是因为人手不足，所以来帮忙的好心孩子吗？",
            "nextDialogs": [
              "3580105"
            ]
          },
          "3580105": {
            "id": "3580105",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "真可爱。",
            "nextDialogs": [
              "3580106"
            ]
          },
          "3580106": {
            "id": "3580106",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "只是，时机不怎么巧…",
            "nextDialogs": [
              "3580107"
            ]
          },
          "3580107": {
            "id": "3580107",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "风魔龙自从复苏以来，一直在城市周围活动，制造混乱。",
            "nextDialogs": [
              "3580108"
            ]
          },
          "3580108": {
            "id": "3580108",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "现在蒙德的元素流动、地脉循环，都已经变得好像被猫咪抓过的线团一样了。",
            "nextDialogs": [
              "3580109"
            ]
          },
          "3580109": {
            "id": "3580109",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "对魔法师来说这是最糟糕的情况喔…皮肤和心情都会变差…",
            "nextDialogs": [
              "3580110"
            ]
          },
          "3580110": {
            "id": "3580110",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "如果不受这些干扰，骑士团就有比寻人启事更好的办法来帮助你们了。",
            "nextDialogs": [
              "3580111"
            ]
          },
          "3580111": {
            "id": "3580111",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "现在就请在蒙德暂住一下，由我们西风骑士团来努力解决问题吧。",
            "nextDialogs": [
              "3580113",
              "3580115"
            ]
          },
          "3580113": {
            "id": "3580113",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "派蒙也会帮忙！",
            "nextDialogs": [
              "3580116"
            ]
          },
          "3580116": {
            "id": "3580116",
            "speakerId": 1000,
            "speakerName": "凯亚",
            "text": "那么，就来决定一下作战计划。",
            "nextDialogs": [
              "3580117"
            ]
          },
          "3580117": {
            "id": "3580117",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "风魔龙进攻蒙德，反而让我们见到了终结灾难源头的契机。",
            "nextDialogs": [
              "3580118"
            ]
          },
          "3580118": {
            "id": "3580118",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "在丽莎的魔法侦测之下，笼罩蒙德的飓风已经暴露了源流。",
            "nextDialogs": [
              "3580119"
            ]
          },
          "3580119": {
            "id": "3580119",
            "speakerId": 1000,
            "speakerName": "凯亚",
            "text": "哦？ 那么答案是…",
            "nextDialogs": [
              "3580120"
            ]
          },
          "3580120": {
            "id": "3580120",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "被废弃的<color=#00E1FFFF>「四风守护」庙宇</color>。",
            "nextDialogs": [
              "3580121"
            ]
          },
          "3580121": {
            "id": "3580121",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "风魔龙能够掀起这种程度的暴风，就是借助了那些残余的力量。",
            "nextDialogs": [
              "3580122"
            ]
          },
          "3580122": {
            "id": "3580122",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "而我们的目标，是这四座废弃庙宇中的<color=#00E1FFFF>三座</color>。",
            "nextDialogs": [
              "3580123"
            ]
          },
          "3580123": {
            "id": "3580123",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "只选三座的理由…大家应该都明白。",
            "nextDialogs": [
              "3580124"
            ]
          },
          "3580124": {
            "id": "3580124",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "我不明白。"
          },
          "3580115": {
            "id": "3580115",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "喂！不要偷懒，我们也该参与进来吧。"
          }
        }
      }
    },

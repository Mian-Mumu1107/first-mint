      }
    },
    {
      "subId": "7502305",
      "subQuestName": "与阿卡坦加对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750230501"
        ],
        "dialogs": {
          "750230501": {
            "id": "750230501",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "等演员就位，接下来按计划<color=#00E1FFFF>将敌对角色引导到木桶附近</color>，之后迅速离开，在安全位置<color=#00E1FFFF>击碎木桶</color>。"
          }
        }
      }
    },
    {

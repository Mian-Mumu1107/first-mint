      }
    },
    {
      "subId": "7502312",
      "subQuestName": "到指定位置就位",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750231201"
        ],
        "dialogs": {
          "750231201": {
            "id": "750231201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你这个敌对角色怎么是没事前商量过的临时演员啊！",
            "nextDialogs": [
              "750231202"
            ]
          },
          "750231202": {
            "id": "750231202",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "嘘！别吵，我们要开始拍摄了！",
            "nextDialogs": [
              "750231203"
            ]
          },
          "750231203": {
            "id": "750231203",
            "speakerId": 1004,
            "speakerName": "画外音",
            "text": "「不可原谅…安息吧，我的朋友们，哦哦…哦哦…看到倒下的部族{RUBY#[D]好兄弟们}民，真想流下泪水！」",
            "nextDialogs": [
              "750231204"
            ]
          },
          "750231204": {
            "id": "750231204",
            "speakerId": 1004,
            "speakerName": "画外音",
            "text": "「但是此时不是流泪的时刻，枯焦的{RUBY#[D]修洛特尔}使者近在眼前，今日我必将报仇血恨叽呀——」",
            "nextDialogs": [
              "750231205"
            ]
          },
          "750231205": {
            "id": "750231205",
            "speakerId": 16968,
            "speakerName": "雷史莱姆",
            "text": "？",
            "nextDialogs": [
              "750231206"
            ]
          },
          "750231206": {
            "id": "750231206",
            "speakerId": 1004,
            "speakerName": "画外音",
            "text": "无牙也无齿的猛兽，脸色就像遥远国度的名产堇瓜一般冷静沉着！",
            "nextDialogs": [
              "750231207"
            ]
          },
          "750231207": {
            "id": "750231207",
            "speakerId": 1004,
            "speakerName": "画外音",
            "text": "那是一张怎样的脸，是一张即使吞下「火山级辣度塔塔可」也不会有丝毫变化的残忍面孔，真是可怕至极——",
            "nextDialogs": [
              "750231208"
            ]
          },
          "750231208": {
            "id": "750231208",
            "speakerId": 1004,
            "speakerName": "画外音",
            "text": "「这一次，这一次，一定要让你后悔到死呀！」说着，尾巴上系着红丝巾的巨兽使用了锻炼千百遍的「大炖肉火焰」——",
            "nextDialogs": [
              "750231209"
            ]
          },
          "750231209": {
            "id": "750231209",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "好了，就是这个时候！把雷史莱姆引到木桶边，击碎那个木桶吧！",
            "nextDialogs": [
              "750231210"
            ]
          },
          "750231210": {
            "id": "750231210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在这个时候击碎木桶？木桶就是什么「大炖肉火焰」？",
            "nextDialogs": [
              "750231211"
            ]
          },
          "750231211": {
            "id": "750231211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总觉得有点奇怪，但是…好吧，我们试试。"
          }
        }
      }
    },

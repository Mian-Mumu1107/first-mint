    {
      "subId": "7502307",
      "subQuestName": "与阿卡坦加对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750230701"
        ],
        "dialogs": {
          "750230701": {
            "id": "750230701",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀呀呀！",
            "nextDialogs": [
              "750230702"
            ]
          },
          "750230702": {
            "id": "750230702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好啦好啦，别这么着急嘛。",
            "nextDialogs": [
              "750230703"
            ]
          },
          "750230703": {
            "id": "750230703",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "说实话刚才我也替小家伙捏了一把汗呢，为了追求真实感，炸药的量也准备得比较充分…",
            "nextDialogs": [
              "750230705",
              "750230707"
            ]
          },
          "750230705": {
            "id": "750230705",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔呀呀呀…",
            "nextDialogs": [
              "750230708"
            ]
          },
          "750230708": {
            "id": "750230708",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "总之，有了这次的经验，之后就知道如何改善了。谢谢几位的协助，我们这就来看看成片的效果吧？",
            "nextDialogs": [
              "750230709"
            ]
          },
          "750230709": {
            "id": "750230709",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "出人意料的是，画面中既没有尾巴系着红丝巾的救星，也没有发出滋滋声的邪恶敌人，更没有惊心动魄的爆炸场景，有的只是阿卡坦加不断变换的表情…",
            "nextDialogs": [
              "750230710"
            ]
          },
          "750230710": {
            "id": "750230710",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "我成主角了？"
          },
          "750230707": {
            "id": "750230707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀！万一伤到谁，或者引发火灾之类的就不好了！"
          }
        }
      }
    },
    {
      "subId": "7502308",
      "subQuestName": "与阿卡坦加对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750230801"
        ],
        "dialogs": {
          "750230801": {
            "id": "750230801",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "这样是不行的呀，没有达到预期的效果，我们重新开始吧。"
          }
        }
      }
    },
    {
      "subId": "7502320",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750232001"
        ],
        "dialogs": {
          "750232001": {
            "id": "750232001",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "说不定我那分道扬镳的朋友看过这部作品后也会回心转意呢，哈哈。"
          }
        }
      }
    }
  ]
}
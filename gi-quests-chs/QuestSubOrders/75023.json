  "subQuests": [
    {
      "subId": "7502301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750230201"
        ],
        "dialogs": {
          "750230201": {
            "id": "750230201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，快看快看！这里又有留影机又有布景，会不会是映影的拍摄场地？",
            "nextDialogs": [
              "750230202"
            ]
          },
          "750230202": {
            "id": "750230202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不过这里的布景…这些房子都好小喔！显得{NICKNAME}都像是巨人了。",
            "nextDialogs": [
              "750230203"
            ]
          },
          "750230203": {
            "id": "750230203",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…呀呀！",
            "nextDialogs": [
              "750230205",
              "750230208"
            ]
          },
          "750230205": {
            "id": "750230205",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀呀…",
            "nextDialogs": [
              "750230206"
            ]
          },
          "750230206": {
            "id": "750230206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，这下我们就是名副其实的「大人物」了呢。",
            "nextDialogs": [
              "750230239"
            ]
          },
          "750230239": {
            "id": "750230239",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "一个纳塔人十分自然地加入了对话…",
            "nextDialogs": [
              "750230209"
            ]
          },
          "750230209": {
            "id": "750230209",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "哦！几位也对映影感兴趣吗？那请务必助我阿卡坦加一臂之力，让全新的流行席卷纳塔的土地吧！",
            "nextDialogs": [
              "750230210"
            ]
          },
          "750230210": {
            "id": "750230210",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀呀！",
            "nextDialogs": [
              "750230211"
            ]
          },
          "750230211": {
            "id": "750230211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}怎么这么高兴，你附和他做什么呀？你也喜欢映影吗？",
            "nextDialogs": [
              "750230212"
            ]
          },
          "750230212": {
            "id": "750230212",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀呀呀！",
            "nextDialogs": [
              "750230213"
            ]
          },
          "750230213": {
            "id": "750230213",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "小家伙，眼光真不错！实话说，这里的一切都是为了让一只小嵴锋龙成为明日之星而准备的。",
            "nextDialogs": [
              "750230214"
            ]
          },
          "750230214": {
            "id": "750230214",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "可惜那只小嵴锋龙被我朋友带走了。我们因为创作理念不和大吵一架，之后她就带着我最重要的演员一去不回，唉…",
            "nextDialogs": [
              "750230215"
            ]
          },
          "750230215": {
            "id": "750230215",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "真不该和朋友合作。项目失败了，朋友也没了。我输两次。",
            "nextDialogs": [
              "750230216"
            ]
          },
          "750230216": {
            "id": "750230216",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "但是没关系，现在又有一只小嵴锋龙来到我的面前，看这跃跃欲试的样子，一准能成功、爆红！",
            "nextDialogs": [
              "750230217"
            ]
          },
          "750230217": {
            "id": "750230217",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "怎么样？几位要是能协助我完成这部跨时代的作品，我一定重重酬谢！"
          },
          "750230208": {
            "id": "750230208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么嘛，我才不要住那么小的房子，手脚都伸展不开。"
          }
        }
      }
    },
    {
      "subId": "7502303",
      "subQuestName": "在合适的位置放置木桶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750230301"
        ],
        "dialogs": {
          "750230301": {
            "id": "750230301",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "怎么了，需要我重复一遍步骤吗？",
            "nextDialogs": [
              "750230303",
              "750230306"
            ]
          },
          "750230303": {
            "id": "750230303",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "先是放置演出道具，木桶放在<color=#00E1FFFF>画面中心但不遮挡主角和布景的位置</color>，元素诱饵放在<color=#00E1FFFF>敌方角色入场的方向</color>。",
            "nextDialogs": [
              "750230304"
            ]
          },
          "750230304": {
            "id": "750230304",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "之后，等到需要的时候，<color=#00E1FFFF>引导敌对角色到木桶附近</color>，再退到安全位置<color=#00E1FFFF>击碎木桶</color>。"
          },
          "750230306": {
            "id": "750230306",
            "speakerId": 6175,
            "speakerName": "阿卡坦加",
            "text": "那就万事拜托了。"
          }
        }
      }
    },
    {
      "subId": "7502304",
      "subQuestName": "在合适的位置放置元素诱饵",
      "sceneId": null,
      "locations": [],

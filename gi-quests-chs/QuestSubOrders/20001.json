    {
      "subId": "2000104",
      "subQuestName": "与昆恩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200011001"
        ],
        "dialogs": {
          "200011001": {
            "id": "200011001",
            "speakerId": 1000,
            "speakerName": "昆恩",
            "text": "太感谢了，旅行者。",
            "nextDialogs": [
              "200011002"
            ]
          },
          "200011002": {
            "id": "200011002",
            "speakerId": 1000,
            "speakerName": "昆恩",
            "text": "我就是想来这摘点水果，带回城里卖。",
            "nextDialogs": [
              "200011003"
            ]
          },
          "200011003": {
            "id": "200011003",
            "speakerId": 1000,
            "speakerName": "昆恩",
            "text": "没想到却被这个路障拦住，然后那群家伙就跳出来。",
            "nextDialogs": [
              "200011004"
            ]
          },
          "200011004": {
            "id": "200011004",
            "speakerId": 1000,
            "speakerName": "昆恩",
            "text": "我这就回蒙德城去了，记得来城里光顾我的生意啊。",
            "nextDialogs": [
              "200011005"
            ]
          },
          "200011005": {
            "id": "200011005",
            "speakerId": 1000,
            "speakerName": "昆恩",
            "text": "这些就当做谢礼吧，我的水果都是这么新鲜的…所以贝雅特丽奇那家伙，才会一直过来缠着我买。"
          }
        }
      }
    },
    {
      "subId": "2000109",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200010901"
        ],
        "dialogs": {
          "200010901": {
            "id": "200010901",
            "speakerId": 1000,
            "speakerName": "昆恩",
            "text": "旅行者，谢谢你赶走了这些家伙。",
            "nextDialogs": [
              "200010902"
            ]
          },
          "200010902": {
            "id": "200010902",
            "speakerId": 1000,
            "speakerName": "昆恩",
            "text": "多亏你来了，呃…但路障竖在这，我还是走不了。",
            "nextDialogs": [
              "200010903"
            ]
          },
          "200010903": {
            "id": "200010903",
            "speakerId": 1000,
            "speakerName": "昆恩",
            "text": "这么下去，我辛辛苦苦摘下来的水果都要烂掉了…",
            "nextDialogs": [
              "200010904"
            ]
          },
          "200010904": {
            "id": "200010904",
            "speakerId": 1000,
            "speakerName": "昆恩",
            "text": "你能帮我把这个路障给处理掉吗？",
            "nextDialogs": [
              "200010907",
              "200010908"
            ]
          },
          "200010907": {
            "id": "200010907",
            "speakerId": 1000,
            "speakerName": "昆恩",
            "text": "哈哈，那就拜托你了。"
          },
          "200010908": {
            "id": "200010908",
            "speakerId": 1000,
            "speakerName": "昆恩",
            "text": "啊…啊？我说，帮人帮到底嘛，无论如何，我只能指望你了！"
          }
        }
      }
    }
  ]

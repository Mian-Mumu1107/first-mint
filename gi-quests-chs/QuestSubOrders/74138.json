  "subQuests": [
    {
      "subId": "7413801",
      "subQuestName": "与基肖恩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741380101"
        ],
        "dialogs": {
          "741380101": {
            "id": "741380101",
            "speakerId": 1000,
            "speakerName": "基肖恩",
            "text": "嘿，回来了吗？你们刚才可错过了一场好戏啊。",
            "nextDialogs": [
              "741380102"
            ]
          },
          "741380102": {
            "id": "741380102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好戏？发生什么事了？",
            "nextDialogs": [
              "741380103"
            ]
          },
          "741380103": {
            "id": "741380103",
            "speakerId": 1000,
            "speakerName": "基肖恩",
            "text": "刚刚我带着回收来的水母，在这里等奥格劳先生核查。结果奥格劳先生还没来，之前的买家倒是找上门了。",
            "nextDialogs": [
              "741380104"
            ]
          },
          "741380104": {
            "id": "741380104",
            "speakerId": 1000,
            "speakerName": "基肖恩",
            "text": "他们说自从放生了前几批水母，这人也精神了，生意也顺畅了，一定是做了好事，有神明眷顾！所以就想找我再买一批去放生。",
            "nextDialogs": [
              "741380107"
            ]
          },
          "741380107": {
            "id": "741380107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#唔唔…{NICKNAME}抓，基肖恩先生卖，买家再去放生…喂！你难道是在用这个方法赚钱吗？！",
            "nextDialogs": [
              "741380108"
            ]
          },
          "741380108": {
            "id": "741380108",
            "speakerId": 1000,
            "speakerName": "基肖恩",
            "text": "没有！没有！怎么可能！？我可不想再被警备队的人找麻烦了！",
            "nextDialogs": [
              "741380109"
            ]
          },
          "741380109": {
            "id": "741380109",
            "speakerId": 1000,
            "speakerName": "基肖恩",
            "text": "咳咳…我跟他们说明了好久，放生这些水母有害无益，可他们就是不听！",
            "nextDialogs": [
              "741380110"
            ]
          },
          "741380110": {
            "id": "741380110",
            "speakerId": 1000,
            "speakerName": "基肖恩",
            "text": "愣是觉得自己最近走了好运，就是因为做了这种…他们所认为的好事。",
            "nextDialogs": [
              "741380111"
            ]
          },
          "741380111": {
            "id": "741380111",
            "speakerId": 1000,
            "speakerName": "基肖恩",
            "text": "还觉得我接连倒霉，也是囚禁水母带给我的报应。唉…这帮人到底在想什么…",
            "nextDialogs": [
              "741380112"
            ]
          },
          "741380112": {
            "id": "741380112",
            "speakerId": 1000,
            "speakerName": "基肖恩",
            "text": "我们还在争辩着呢，奥格劳先生就来了，直接把这群人扣了回去。"
          }
        }
      }
    },
    {
      "subId": "7413899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741389901"
        ],
        "dialogs": {
          "741389901": {
            "id": "741389901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这段时间我们抓了不少水母呢，不知道基肖恩说的生态恢复得怎么样了…",
            "nextDialogs": [
              "741389902"
            ]
          },
          "741389902": {
            "id": "741389902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "现在就去找他看看吧，希望他还没被警备队抓走…"
          }
        }
      }
    }
  ]
}
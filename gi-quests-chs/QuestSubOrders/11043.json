  },
  "subQuests": [
    {
      "subId": "1104301",
      "subQuestName": "前往下一项实验的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110430101"
        ],
        "dialogs": {
          "110430101": {
            "id": "110430101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不会是要我们从这么高的地方跳下去吧？",
            "nextDialogs": [
              "110430102"
            ]
          },
          "110430102": {
            "id": "110430102",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "不一定，如果你们有更好的办法的话。",
            "nextDialogs": [
              "110430105"
            ]
          },
          "110430105": {
            "id": "110430105",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "无论用什么办法，只要能够抵达下面的湖的对岸，就算完成了实验。",
            "nextDialogs": [
              "110430106"
            ]
          },
          "110430106": {
            "id": "110430106",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "根据你完成的时间，以及达到的最快速度，我会进行分析与比较的。",
            "nextDialogs": [
              "110430107"
            ]
          },
          "110430107": {
            "id": "110430107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#在湖的对岸，也就是说，想让{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}在雪山游泳？！",
            "nextDialogs": [
              "110430108"
            ]
          },
          "110430108": {
            "id": "110430108",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "当不限制条件的时候，人就会本能地去选择自己认为最合理的方式完成目标。",
            "nextDialogs": [
              "110430109"
            ]
          },
          "110430109": {
            "id": "110430109",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "可能有人觉得冰雪中的湖水难以忍受，但可能另外的人就喜欢这种冰冷刺骨的方式。",
            "nextDialogs": [
              "110430110"
            ]
          },
          "110430110": {
            "id": "110430110",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "无论你们做出了什么选择，都是实验的一部分，对我来说，都具有十足的研究价值。"
          }
        }
      }
    },

    {
      "subId": "1104304",
      "subQuestName": "重新与阿贝多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1104303",
      "subQuestName": "与阿贝多交谈，获取结论",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110430301"
        ],
        "dialogs": {
          "110430301": {
            "id": "110430301",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "辛苦你了，你的表现令我刮目相看。",
            "nextDialogs": [
              "110430302"
            ]
          },
          "110430302": {
            "id": "110430302",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "不愧是传闻中的旅行者，各项数据都已经远超蒙德的平均水平。",
            "nextDialogs": [
              "110430303"
            ]
          },
          "110430303": {
            "id": "110430303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是看你一直跟着我们，好像也没有气喘吁吁嘛。",
            "nextDialogs": [
              "110430304"
            ]
          },
          "110430304": {
            "id": "110430304",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我吗？其实我用炼金术偷了一些懒，不过这些都不重要。",
            "nextDialogs": [
              "110430305"
            ]
          },
          "110430305": {
            "id": "110430305",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "如果提瓦特的法则没有影响你，那我可以获得几种对异世界文明的猜想。",
            "nextDialogs": [
              "110430306"
            ]
          },
          "110430306": {
            "id": "110430306",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "如果提瓦特的法则影响了你，那我也可以推测在没有影响的状况下，会发生怎样的演化。",
            "nextDialogs": [
              "110430307"
            ]
          },
          "110430307": {
            "id": "110430307",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "其中蕴含的无数可能性，实在太有趣了，值得反复品味。",
            "nextDialogs": [
              "110430308"
            ]
          },
          "110430308": {
            "id": "110430308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是…这对你的研究又有什么帮助呢？",
            "nextDialogs": [
              "110430309"
            ]
          },
          "110430309": {
            "id": "110430309",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "困扰我多时的问题已经解开，等回到营地之后，我应该能为你们呈现一些独特的东西。",
            "nextDialogs": [
              "110430310"
            ]
          },
          "110430310": {
            "id": "110430310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你有像这样研究过其他东西吗？",
            "nextDialogs": [
              "110430311"
            ]
          },
          "110430311": {
            "id": "110430311",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "那你可能马上要被和很多奇奇怪怪的东西一起类比了，你可能会不乐意吧。",
            "nextDialogs": [
              "110430312"
            ]
          },
          "110430312": {
            "id": "110430312",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "黄金，石化古树，八倍大的太阳——",
            "nextDialogs": [
              "110430313"
            ]
          },
          "110430313": {
            "id": "110430313",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "探究本质的过程令人着迷。可惜，这种着迷的时光，注定只是须臾。",
            "nextDialogs": [
              "110430314"
            ]
          },
          "110430314": {
            "id": "110430314",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我宁愿将我一切的精力都倾注其中，然而样本终究是有限的，当未知逐渐变为已知，那种趣味也就会逐渐消失。",
            "nextDialogs": [
              "110430315"
            ]
          },
          "110430315": {
            "id": "110430315",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "最终它们都会变为日落果，甜甜花这样平淡无奇的存在，不再值得花时间去关注了。",
            "nextDialogs": [
              "110430316"
            ]
          },
          "110430316": {
            "id": "110430316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，所以你画的那副丘丘人的画，不同的丘丘人之间才会有那么明显的区分啊。",
            "nextDialogs": [
              "110430317"
            ]
          },
          "110430317": {
            "id": "110430317",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "对，当时我也说了，「很无聊，不值得浪费时间」。因为对我来说，它们的趣味早就消失了。",
            "nextDialogs": [
              "110430318"
            ]
          },
          "110430318": {
            "id": "110430318",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那在实验之后，我们在你的眼里也会变成这样吗？变成…呃，草稿？",
            "nextDialogs": [
              "110430319"
            ]
          },
          "110430319": {
            "id": "110430319",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这个不必担心，你们是我的协助者，这份情谊我是不会忘记的。",
            "nextDialogs": [
              "110430320"
            ]
          },
          "110430320": {
            "id": "110430320",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "好了，在返回营地之前，让我们进行最后一项，也就是智能方面的实验吧。",
            "nextDialogs": [
              "110430321"
            ]
          },
          "110430321": {
            "id": "110430321",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "跟我来，现在我们去另一侧的遗迹。"
          }
        }
      }
    },
    {
      "subId": "1104302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110430211"
        ],
        "dialogs": {
          "110430211": {
            "id": "110430211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那如果我们游泳，你会跟着游吗？",
            "nextDialogs": [
              "110430212"
            ]
          },
          "110430212": {
            "id": "110430212",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "不会，除非你想和我比赛。",
            "nextDialogs": [
              "110430213"
            ]
          },
          "110430213": {
            "id": "110430213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我…呃，当我没说好了。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "37405",
      "subQuestName": "主动寻找修女$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "37406",
      "subQuestName": "与修女对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3740401"
        ],
        "dialogs": {
          "3740401": {
            "id": "3740401",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "风神祝福你。",
            "nextDialogs": [
              "3740403",
              "3740405"
            ]
          },
          "3740403": {
            "id": "3740403",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "啊，你是…骑士团的那位新成员吧？",
            "nextDialogs": [
              "3740406"
            ]
          },
          "3740406": {
            "id": "3740406",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "为什么来这里？是代理团长大人交待的公务吗？",
            "nextDialogs": [
              "3740411"
            ]
          },
          "3740411": {
            "id": "3740411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，骑士团，要借用天空之琴…",
            "nextDialogs": [
              "3740412"
            ]
          },
          "3740412": {
            "id": "3740412",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "真的吗…",
            "nextDialogs": [
              "3740413"
            ]
          },
          "3740413": {
            "id": "3740413",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "倒不是怀疑你。但早些时候有个可疑的诗人也来借琴。",
            "nextDialogs": [
              "3740414"
            ]
          },
          "3740414": {
            "id": "3740414",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "他满口胡言，竟敢自称巴巴托斯，一定没安好心。",
            "nextDialogs": [
              "3740415"
            ]
          },
          "3740415": {
            "id": "3740415",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "天空之琴的使用是有规定的。目前只有羽球节期间才会用到。",
            "nextDialogs": [
              "3740416"
            ]
          },
          "3740416": {
            "id": "3740416",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "出借时需要团长、主教，还有民众代表协商同意，签署文件。",
            "nextDialogs": [
              "3740417"
            ]
          },
          "3740417": {
            "id": "3740417",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "那么，骑士团的文件呢？"
          },
          "3740405": {
            "id": "3740405",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "嗯，我认识你。那天你跟安柏一起拯救了蒙德呢。"
          }
        }
      }
    },
    {
      "subId": "37309",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3730901"
        ],
        "dialogs": {
          "3730901": {
            "id": "3730901",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "最近教会的事务真是又多又乱，主教大人偏偏又不在…哎呀。"
          }
        }
      }
    },
    {
      "subId": "37502",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3750202"
        ],
        "dialogs": {
          "3750202": {
            "id": "3750202",
            "speakerId": 1162,
            "speakerName": "奥特",
            "text": "麻烦啊，这地下室入口真的需要在整个<color=#00E1FFFF>白天</color>一直守卫吗…\\n喂！你站住，这里禁止通行！",
            "nextDialogs": [
              "3750203"
            ]
          },
          "3750203": {
            "id": "3750203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来只能等到<color=#00E1FFFF>晚上</color>再悄悄溜进去了。"
          }
        }
      }
    }
  ]
}
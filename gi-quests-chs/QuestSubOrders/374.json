        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "37402",
      "subQuestName": "观看温迪的借琴之道",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3740201"
        ],
        "dialogs": {
          "3740201": {
            "id": "3740201",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "看我的吧——",
            "nextDialogs": [
              "3740202"
            ]
          },
          "3740202": {
            "id": "3740202",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "你好，修女姐姐。",
            "nextDialogs": [
              "3740203"
            ]
          },
          "3740203": {
            "id": "3740203",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "风神祝福你，年轻的诗人。有什么事吗？",
            "nextDialogs": [
              "3740204"
            ]
          },
          "3740204": {
            "id": "3740204",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "其实，我掌握了一个秘密，能够解救蒙德城遇到的危机。",
            "nextDialogs": [
              "3740205"
            ]
          },
          "3740205": {
            "id": "3740205",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "哦？那可真是风神保佑。",
            "nextDialogs": [
              "3740206"
            ]
          },
          "3740206": {
            "id": "3740206",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "但这件事你应该对骑士团报告。我这样一个无关的修女能帮到你什么呢？",
            "nextDialogs": [
              "3740207"
            ]
          },
          "3740207": {
            "id": "3740207",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "啊哈哈，姐姐你当然是有能帮忙的地方了。",
            "nextDialogs": [
              "3740208"
            ]
          },
          "3740208": {
            "id": "3740208",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "比如说…天空之琴。借助它的力量，我可以让风魔龙——",
            "nextDialogs": [
              "3740209"
            ]
          },
          "3740209": {
            "id": "3740209",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "请回吧。",
            "nextDialogs": [
              "3740210"
            ]
          },
          "3740210": {
            "id": "3740210",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "咦？",
            "nextDialogs": [
              "3740211"
            ]
          },
          "3740211": {
            "id": "3740211",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "虽然那条龙非常凶恶，但只要代理团长下定决心，就没有不能讨伐的道理。",
            "nextDialogs": [
              "3740212"
            ]
          },
          "3740212": {
            "id": "3740212",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "那可不行，那样的话风魔龙不就会死掉了吗？",
            "nextDialogs": [
              "3740213"
            ]
          },
          "3740213": {
            "id": "3740213",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "背离东风的愚兽，即便是风神本尊降临，也不会轻易原谅它！",
            "nextDialogs": [
              "3740214"
            ]
          },
          "3740214": {
            "id": "3740214",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "唔…",
            "nextDialogs": [
              "3740215"
            ]
          },
          "3740215": {
            "id": "3740215",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "呃…那个，大姐姐~~",
            "nextDialogs": [
              "3740216"
            ]
          },
          "3740216": {
            "id": "3740216",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "不行就是不行哟，小诗人。",
            "nextDialogs": [
              "3740217"
            ]
          },
          "3740217": {
            "id": "3740217",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "（嘶…被这孩子叫大姐姐，心里怎么会泛起一种不可思议的高兴…真荒谬…）",
            "nextDialogs": [
              "3740218"
            ]
          },
          "3740218": {
            "id": "3740218",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "呼…真没办法。",
            "nextDialogs": [
              "3740219"
            ]
          },
          "3740219": {
            "id": "3740219",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我已经不能再隐瞒了！",
            "nextDialogs": [
              "3740220"
            ]
          },
          "3740220": {
            "id": "3740220",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我虔诚的信徒啊，喜悦吧！在你面前的，正是<color=#00E1FFFF>风神巴巴托斯</color>本人——",
            "nextDialogs": [
              "3740221"
            ]
          },
          "3740221": {
            "id": "3740221",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "是不是很震惊？是不是震惊得想哭？终于见到了侍奉的神明，怎样？很感动吧？",
            "nextDialogs": [
              "3740222"
            ]
          },
          "3740222": {
            "id": "3740222",
            "speakerId": 1161,
            "speakerName": "歌特琳德",
            "text": "没别的事情的话，我回去继续处理教堂的文件了。",
            "nextDialogs": [
              "3740223"
            ]
          },
          "3740223": {
            "id": "3740223",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "呀——"
          }
        }
      }
    },
    {
      "subId": "37403",
      "subQuestName": "等待温迪的“借”琴之道$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3740301"
        ],
        "dialogs": {
          "3740301": {
            "id": "3740301",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "欸嘿，修女她头也不回地走了。",
            "nextDialogs": [
              "3740302"
            ]
          },
          "3740302": {
            "id": "3740302",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "不过呢，其实我也已经达到了预定的目的。",
            "nextDialogs": [
              "3740303"
            ]
          },
          "3740303": {
            "id": "3740303",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "至少她没有否认——大教堂里收藏着天空之琴。",
            "nextDialogs": [
              "3740304"
            ]
          },
          "3740304": {
            "id": "3740304",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#那么，{NICKNAME}。既然你是骑士团正当红的新人…",
            "nextDialogs": [
              "3740305"
            ]
          },
          "3740305": {
            "id": "3740305",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "要不然，你也来试试？"
          }
        }
      }
    },
    {

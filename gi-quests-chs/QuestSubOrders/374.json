    {
      "subId": "37407",
      "subQuestName": "跟随温迪前往大教堂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3740701"
        ],
        "dialogs": {
          "3740701": {
            "id": "3740701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以你说的「天空」，到底是…",
            "nextDialogs": [
              "3740702"
            ]
          },
          "3740702": {
            "id": "3740702",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "蒙德的至宝，风神巴巴托斯曾经弹奏的竖琴。",
            "nextDialogs": [
              "3740703"
            ]
          },
          "3740703": {
            "id": "3740703",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "只要有了天空之琴，我就能从噩梦中唤回特瓦林的本性。",
            "nextDialogs": [
              "3740704"
            ]
          },
          "3740704": {
            "id": "3740704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样…真的可以让风魔龙停止破坏吗？",
            "nextDialogs": [
              "3740705"
            ]
          },
          "3740705": {
            "id": "3740705",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "当然，因为我可是天下最好的诗人。",
            "nextDialogs": [
              "3740706"
            ]
          },
          "3740706": {
            "id": "3740706",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "过去、未来与现在，没有我不知道的歌谣。",
            "nextDialogs": [
              "3740707"
            ]
          },
          "3740707": {
            "id": "3740707",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "看着我的眼睛，你不觉得我很值得信任吗？",
            "nextDialogs": [
              "3740711"
            ]
          },
          "3740711": {
            "id": "3740711",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哈哈哈，这一招对吟游诗人是无效的。",
            "nextDialogs": [
              "3740712"
            ]
          },
          "3740712": {
            "id": "3740712",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么，该怎么拿到天空之琴呢？",
            "nextDialogs": [
              "3740713"
            ]
          },
          "3740713": {
            "id": "3740713",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "据说它被供奉在大教堂深处，某个安全的地方。",
            "nextDialogs": [
              "3740714"
            ]
          },
          "3740714": {
            "id": "3740714",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我会去探查一下情况，你有兴趣的话也可以跟来看看。"
          }
        }
      }
    },
    {
      "subId": "37401",
      "subQuestName": "到温迪附近",
      "sceneId": null,
      "locations": [],

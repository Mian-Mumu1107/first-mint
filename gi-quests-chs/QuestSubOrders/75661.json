  "subQuests": [
    {
      "subId": "7566101",
      "subQuestName": "(test)隐藏环对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "756610101"
        ],
        "dialogs": {
          "756610101": {
            "id": "756610101",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "难怪总有种预感让我过来看看…原来是能遇上你，了不起的「杜{RUBY#[D]希望}麦尼」。",
            "nextDialogs": [
              "756610102"
            ]
          },
          "756610102": {
            "id": "756610102",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "那么——你是为了「花羽会」的战士试炼而来的吧？",
            "nextDialogs": [
              "756610104",
              "756610107"
            ]
          },
          "756610104": {
            "id": "756610104",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "那你一定不会失望，我对绒翼龙骑士们的要求非常严格。",
            "nextDialogs": [
              "756610105"
            ]
          },
          "756610105": {
            "id": "756610105",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "因为我不擅长教导别人，在受邀设计这些关卡时，只能回忆「相当棘手」的难题，再把它们一个接一个加进去。",
            "nextDialogs": [
              "756610109"
            ]
          },
          "756610109": {
            "id": "756610109",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "结果九成九的「花羽会」战士都过不了第一关…没办法，只能接受伊拉德的建议，降低点难度了。",
            "nextDialogs": [
              "756610110"
            ]
          },
          "756610110": {
            "id": "756610110",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "但对你来说，简化前的试炼可能都不够让你尽兴，应当选用…连我都束手无策的难关。"
          },
          "756610107": {
            "id": "756610107",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "哦？原来如此…",
            "nextDialogs": [
              "756610108"
            ]
          },
          "756610108": {
            "id": "756610108",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "——你是想要「超越」我的记录吧？正合我意。这些关卡在设计之初，就塞满了我曾遇见过的「相当棘手」的难题。"
          }
        }
      }
    }
  ]
}
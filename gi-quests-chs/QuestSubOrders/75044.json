    {
      "subId": "7504407",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750440701"
        ],
        "dialogs": {
          "750440701": {
            "id": "750440701",
            "speakerId": 21736,
            "speakerName": "醒目的标语",
            "text": "上层召龙平台全天开放，有意加入马塔伽特训场的人与龙请至上层召龙起飞。谨记：",
            "nextDialogs": [
              "750440702"
            ]
          },
          "750440702": {
            "id": "750440702",
            "speakerId": 21736,
            "speakerName": "醒目的标语",
            "text": "以认真积极训练为荣，以怠惰消极偷懒为耻！！",
            "nextDialogs": [
              "750440703"
            ]
          },
          "750440703": {
            "id": "750440703",
            "speakerId": 21736,
            "speakerName": "醒目的标语",
            "text": "今天你我不努力，明天只能吃垃圾！！",
            "nextDialogs": [
              "750440704"
            ]
          },
          "750440704": {
            "id": "750440704",
            "speakerId": 21736,
            "speakerName": "醒目的标语",
            "text": "努力奋勇向前，拥抱卓越龙生！！"
          }
        }
      }
    },
    {
      "subId": "7504408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750440801"
        ],
        "dialogs": {
          "750440801": {
            "id": "750440801",
            "speakerId": 21737,
            "speakerName": "马塔伽！记得！！",
            "text": "口令是先吹左边的号角，然后是右边的，接着是左边的，最后是右边的，不要乱吹，后果自负！",
            "nextDialogs": [
              "750440802"
            ]
          },
          "750440802": {
            "id": "750440802",
            "speakerId": 21737,
            "speakerName": "马塔伽！记得！！",
            "text": "最好喂一点禽肉，防止龙心情不好导致自己被啄！",
            "nextDialogs": [
              "750440803"
            ]
          },
          "750440803": {
            "id": "750440803",
            "speakerId": 21737,
            "speakerName": "马塔伽！记得！！",
            "text": "（似乎是一个叫马塔伽的人写给自己看的备忘，即使透过文字也能感受到激烈的情绪。）",
            "nextDialogs": [
              "750440804"
            ]
          },
          "750440804": {
            "id": "750440804",
            "speakerId": 21737,
            "speakerName": "马塔伽！记得！！",
            "text": "（不过给备忘的每一条都加上感叹号，不就等于没有加？）"
          }
        }
      }
    },
    {
      "subId": "7504417",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750441701"
        ],
        "dialogs": {
          "750441701": {
            "id": "750441701",
            "speakerId": 21524,
            "speakerName": "依稀可以辨认的布告",
            "text": "「…奉圣火的{RUBY#[D]雅豪卡阿胡克}看护者、至仁至耀的圣{RUBY#[D]蒂沙库恩}王奥奇坎陛{RUBY#[D]卡洛穆特}下之命，为兴修水利设施，现于诸部族征募劳工…」",
            "nextDialogs": [
              "750441702"
            ]
          },
          "750441702": {
            "id": "750441702",
            "speakerId": 21524,
            "speakerName": "依稀可以辨认的布告",
            "text": "「…不计定额，全凭自觉自愿…建设联盟…望各部族积极响应为要…」"
          }
        }
      }
    },
    {
      "subId": "7504418",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750441801"
        ],
        "dialogs": {
          "750441801": {
            "id": "750441801",
            "speakerId": 21525,
            "speakerName": "古老的布告",
            "text": "「奉圣火的{RUBY#[D]雅豪卡阿胡克}看护者、至仁至耀的圣{RUBY#[D]蒂沙库恩}王奥奇坎陛{RUBY#[D]卡洛穆特}下之命，即日起封锁受诅之地，全联盟成员一律禁止入内。」",
            "nextDialogs": [
              "750441802"
            ]
          },
          "750441802": {
            "id": "750441802",
            "speakerId": 21525,
            "speakerName": "古老的布告",
            "text": "「擅自闯入者将被正式认定为联盟的敌人，这是（…）、纳茨卡延、梅兹特利、维茨特兰与特特奥坎共同的宣言。」"
          }
        }
      }
    },
    {
      "subId": "7504419",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750441901"
        ],
        "dialogs": {
          "750441901": {
            "id": "750441901",
            "speakerId": 21525,
            "speakerName": "古老的布告",
            "text": "「愿荣耀永远属于圣火的{RUBY#[D]雅豪卡阿胡克}看护者，伟大的和{RUBY#[D]卡塔兹杰}平缔造者，至仁的圣{RUBY#[D]蒂沙库恩}王奥奇坎。」",
            "nextDialogs": [
              "750441902"
            ]
          },
          "750441902": {
            "id": "750441902",
            "speakerId": 21525,
            "speakerName": "古老的布告",
            "text": "「鉴于本区域排水工程整体进展较为缓慢，为保障联盟不可阻挡的胜利，现对轮换制度做出合理微调。」",
            "nextDialogs": [
              "750441903"
            ]
          },
          "750441903": {
            "id": "750441903",
            "speakerId": 21525,
            "speakerName": "古老的布告",
            "text": "「将劳工划分为三队，每队工作十六小时，两日循环一次。表现卓越的小队将获得额外的谷物配给。」",
            "nextDialogs": [
              "750441904"
            ]
          },
          "750441904": {
            "id": "750441904",
            "speakerId": 21525,
            "speakerName": "古老的布告",
            "text": "「<color=#00E1FFFF>排空积水</color>的胜利曙光近在咫尺，待沟渠完工，<color=#00E1FFFF>抽水机</color>便可以正常运作。再加把劲！」"
          }
        }
      }
    },
    {
      "subId": "7504420",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750442001"
        ],
        "dialogs": {
          "750442001": {
            "id": "750442001",
            "speakerId": 21525,
            "speakerName": "古老的布告",
            "text": "「…同胞们，亲人们，为联盟不可阻挡的胜利而奉献的兄弟姐妹们…」",
            "nextDialogs": [
              "750442002"
            ]
          },
          "750442002": {
            "id": "750442002",
            "speakerId": 21525,
            "speakerName": "古老的布告",
            "text": "「…至仁的…自（…）调拨一批新式机关，以支援运输、（…）与<color=#00E1FFFF>水下打捞</color>…」",
            "nextDialogs": [
              "750442003"
            ]
          },
          "750442003": {
            "id": "750442003",
            "speakerId": 21525,
            "speakerName": "古老的布告",
            "text": "「…前进，再前进，不惜代价前进…为了联盟辉煌的未来，为了我们每个人的自由与荣耀，为了不再被恶龙凌压的家园…」",
            "nextDialogs": [
              "750442004"
            ]
          },
          "750442004": {
            "id": "750442004",
            "speakerId": 1007,
            "speakerName": "依稀可以辨认的手写文字",
            "text": "「…未经许可…禁止擅自触动<color=#00E1FFFF>操作杆</color>…跌落事故…已致使三名劳工…」"
          }
        }
      }
    },
    {
      "subId": "7504421",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750442101"
        ],
        "dialogs": {
          "750442101": {
            "id": "750442101",
            "speakerId": 21528,
            "speakerName": "工匠的笔记·其一",
            "text": "「…北边的石壁后，有一条通往瀑布上方的小径。似乎可以被用作<color=#00E1FFFF>储藏室</color>…」",
            "nextDialogs": [
              "750442102"
            ]
          },
          "750442102": {
            "id": "750442102",
            "speakerId": 21528,
            "speakerName": "工匠的笔记·其一",
            "text": "「…稍稍做了一些标记，以免自己之后也忘了怎么走…」",
            "nextDialogs": [
              "750442103"
            ]
          },
          "750442103": {
            "id": "750442103",
            "speakerId": 21528,
            "speakerName": "工匠的笔记·其一",
            "text": "「…萨雅妮的伤情又恶化了，环境过于潮湿…劝说她休息，笑着拒绝了…说是会拖慢小队进度，害大家拿不到额外配给…」",
            "nextDialogs": [
              "750442104"
            ]
          },
          "750442104": {
            "id": "750442104",
            "speakerId": 21528,
            "speakerName": "工匠的笔记·其一",
            "text": "「…夜里要趁着别人不注意，去上面给她带一支火炬，用来燎烧伤口，否则她的四肢也会一起腐烂…」"
          }
        }
      }
    },
    {
      "subId": "7504424",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750442401"
        ],
        "dialogs": {
          "750442401": {
            "id": "750442401",
            "speakerId": 21524,
            "speakerName": "依稀可以辨认的布告",
            "text": "「…愿荣耀永远…和平缔造者…至仁的…奥奇坎…」",
            "nextDialogs": [
              "750442402"
            ]
          },
          "750442402": {
            "id": "750442402",
            "speakerId": 21524,
            "speakerName": "依稀可以辨认的布告",
            "text": "「…工匠马胡钦特利、特拉南库，并…负责建设抽水…消极怠工，以致延误…仁慈…不施以刑罚…暂停配给三周…」",
            "nextDialogs": [
              "750442403"
            ]
          },
          "750442403": {
            "id": "750442403",
            "speakerId": 21524,
            "speakerName": "依稀可以辨认的布告",
            "text": "「…启动<color=#00E1FFFF>抽水机关</color>的<color=#00E1FFFF>石造钥匙</color>…置于…不得擅自…直至另行调配工匠…」"
          }
        }
      }
    },
    {
      "subId": "7504436",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750443601"
        ],
        "dialogs": {
          "750443601": {
            "id": "750443601",
            "speakerId": 21675,
            "speakerName": "《薰衣草之花》",
            "text": "（一本由多萝蒂·莉可森所写的浪漫小说，在褪色的封面中，围绕着鲜花的床上躺着一个女人。）",
            "nextDialogs": [
              "750443602"
            ]
          },
          "750443602": {
            "id": "750443602",
            "speakerId": 21675,
            "speakerName": "《薰衣草之花》",
            "text": "（草草阅读了这本书后，你感到温馨而满足，但并没有得到什么有用的启示。）",
            "nextDialogs": [
              "750443603"
            ]
          },
          "750443603": {
            "id": "750443603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以…那到底是她家的园丁还是她最好朋友的表弟的二姐夫呢…呜哇，我的头好痛！"
          }
        }
      }
    },
    {
      "subId": "7504437",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750443701"
        ],
        "dialogs": {
          "750443701": {
            "id": "750443701",
            "speakerId": 21698,
            "speakerName": "《白猫神探》",
            "text": "（枫丹逐影庭特别警队退休警督法兰克·德雷宾的传记，没错，警督先生是一只矫健的白猫。）",
            "nextDialogs": [
              "750443702"
            ]
          },
          "750443702": {
            "id": "750443702",
            "speakerId": 21698,
            "speakerName": "《白猫神探》",
            "text": "（在这本书的扉页上印着一个大大的猫爪印，或许是警督先生为下属留下的特殊纪念吧。）",
            "nextDialogs": [
              "750443703"
            ]
          },
          "750443703": {
            "id": "750443703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么嘛…还不如给我也写一本书，就叫…《白毛神探》！"
          }
        }
      }
    },
    {
      "subId": "7504438",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750443801"
        ],
        "dialogs": {
          "750443801": {
            "id": "750443801",
            "speakerId": 21699,
            "speakerName": "《提瓦特世界史·第一部分》",
            "text": "（枫丹剧作家吉恩·布鲁克林的著作，足够厚重的书本完全可以给身材矮小的人垫脚来用。）"
          }
        }
      }
    },
    {
      "subId": "7504439",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750443901"
        ],
        "dialogs": {
          "750443901": {
            "id": "750443901",
            "speakerId": 21700,
            "speakerName": "《枫丹香水广告集》",
            "text": "（看起来没什么人气的写真集，里面有很多漂亮女孩赏心悦目的画片。）",
            "nextDialogs": [
              "750443902"
            ]
          },
          "750443902": {
            "id": "750443902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼…只有女孩子的画片吗？没意思！"
          }
        }
      }
    },
    {
      "subId": "7504441",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

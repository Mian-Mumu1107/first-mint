    {
      "subId": "7504402",
      "subQuestName": "(test)涂鸦灵交付任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750444601"
        ],
        "dialogs": {
          "750444601": {
            "id": "750444601",
            "speakerId": 21743,
            "speakerName": "幻写灵",
            "text": "！",
            "nextDialogs": [
              "750444602"
            ]
          },
          "750444602": {
            "id": "750444602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，原来是这个，看来，得是带点红色的东西才行呢！",
            "nextDialogs": [
              "750444603"
            ]
          },
          "750444603": {
            "id": "750444603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，咦？我们之前扔进去的东西不见了…我们确实扔进去了才对吧，等等，总觉得有点奇怪…",
            "nextDialogs": [
              "750444604"
            ]
          },
          "750444604": {
            "id": "750444604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "罐子里是不是有什么别的东西？",
            "nextDialogs": [
              "750444605"
            ]
          },
          "750444605": {
            "id": "750444605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（敲一敲罐头）"
          }
        }
      }
    },

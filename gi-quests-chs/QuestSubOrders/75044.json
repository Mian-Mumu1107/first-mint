            "speakerId": 21739,
            "speakerName": "圣王的手记·其四",
            "text": "「…秘密…必要的牺牲…不惜一切…」",
            "nextDialogs": [
              "750444102"
            ]
          },
          "750444102": {
            "id": "750444102",
            "speakerId": 21739,
            "speakerName": "圣王的手记·其四",
            "text": "（除此之外的大部分内容都已经被烧毁，无法阅读。）"
          }
        }
      }
    },
    {

        "dialogs": {
          "750444701": {
            "id": "750444701",
            "speakerId": 21794,
            "speakerName": "小孩的笔记",
            "text": "（用幼稚而潦草的字写着：）",
            "nextDialogs": [
              "750444702"
            ]
          },
          "750444702": {
            "id": "750444702",
            "speakerId": 21794,
            "speakerName": "小孩的笔记",
            "text": "这个游戏叫做「咚咚冻冻龙咚咚」，规则是这样的：",
            "nextDialogs": [
              "750444703"
            ]
          },
          "750444703": {
            "id": "750444703",
            "speakerId": 21794,
            "speakerName": "小孩的笔记",
            "text": "1、咚咚幻写灵不咚咚的时候，骑在龙雕像的背上，龙雕像就会往前走。",
            "nextDialogs": [
              "750444704"
            ]
          },
          "750444704": {
            "id": "750444704",
            "speakerId": 21794,
            "speakerName": "小孩的笔记",
            "text": "2、咚咚幻写灵倒计时到「咚！」的时候，必须从龙雕像身上下来，不然就会输。",
            "nextDialogs": [
              "750444705"
            ]
          },
          "750444705": {
            "id": "750444705",
            "speakerId": 21794,
            "speakerName": "小孩的笔记",
            "text": "3、最先跑到咚咚幻写灵身边，就能赢！",
            "nextDialogs": [
              "750444706"
            ]
          },
          "750444706": {
            "id": "750444706",
            "speakerId": 21794,
            "speakerName": "小孩的笔记",
            "text": "不许说「写那么多，不就是三二一木头人嘛！」，规则是很重要的，而且，就是因为不尊重规则，大家才赢不了！"
          }
        }
      }

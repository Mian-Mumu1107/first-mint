    {
      "subId": "7180003",
      "subQuestName": "(test)壶外-进入壶中天$UNRELEASED$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718000301"
        ],
        "dialogs": {
          "718000301": {
            "id": "718000301",
            "speakerId": 2093,
            "speakerName": "萍姥姥",
            "text": "哎呀，还真的荡出来了…$UNRELEASED",
            "nextDialogs": [
              "718000303",
              "718000306"
            ]
          },
          "718000303": {
            "id": "718000303",
            "speakerId": 2093,
            "speakerName": "萍姥姥",
            "text": "对不住啊孩子们，是我考虑少了，唉，我还以为没蓄多少水呢。$UNRELEASED",
            "nextDialogs": [
              "718000304"
            ]
          },
          "718000304": {
            "id": "718000304",
            "speakerId": 2093,
            "speakerName": "萍姥姥",
            "text": "不过，这壶大体上应该也弄干净了，剩下的那些边边角角，就慢慢打扫吧。$UNRELEASED",
            "nextDialogs": [
              "718000307"
            ]
          },
          "718000307": {
            "id": "718000307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "婆婆，您是把整条碧水河的水都装进去了吗…$UNRELEASED",
            "nextDialogs": [
              "718000308"
            ]
          },
          "718000308": {
            "id": "718000308",
            "speakerId": 2093,
            "speakerName": "萍姥姥",
            "text": "你这孩子，怎么可能，这城里的人还得用水呢…我就只装了半条河的水而已。$UNRELEASED",
            "nextDialogs": [
              "718000309"
            ]
          },
          "718000309": {
            "id": "718000309",
            "speakerId": 2093,
            "speakerName": "萍姥姥",
            "text": "好了孩子们，这次让你们遭罪了。这些东西拿着，辛苦你们啦。$UNRELEASED",
            "nextDialogs": [
              "718000310"
            ]
          },
          "718000310": {
            "id": "718000310",
            "speakerId": 2093,
            "speakerName": "萍姥姥",
            "text": "对了，我还得找个时间，把这壶里的水倒回河里去…$UNRELEASED"
          },
          "718000306": {
            "id": "718000306",
            "speakerId": 2093,
            "speakerName": "萍姥姥",
            "text": "唔，但还有些边边角角，得进去细致打扫啊。$UNRELEASED"
          }
        }
      }
    },

    {
      "subId": "4141304",
      "subQuestName": "与温迪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414130401"
        ],
        "dialogs": {
          "414130401": {
            "id": "414130401",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "感谢你，风花节之星。我们已向风神巴巴托斯献上饱含敬爱的「风之花」，愿风护佑蒙德。",
            "nextDialogs": [
              "414130402"
            ]
          },
          "414130402": {
            "id": "414130402",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "不错的选择哦。",
            "nextDialogs": [
              "414130403"
            ]
          },
          "414130403": {
            "id": "414130403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你喜欢吗？",
            "nextDialogs": [
              "414130404"
            ]
          },
          "414130404": {
            "id": "414130404",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯——你猜？",
            "nextDialogs": [
              "414130405"
            ]
          },
          "414130405": {
            "id": "414130405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又让人猜，这个坏家伙！",
            "nextDialogs": [
              "414130406"
            ]
          },
          "414130406": {
            "id": "414130406",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "啊哈哈哈哈！会告诉你的啦，不过不是在这里。",
            "nextDialogs": [
              "414130407"
            ]
          },
          "414130407": {
            "id": "414130407",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "人来人往的广场不方便聊这些，换个地方吧。",
            "nextDialogs": [
              "414130408"
            ]
          },
          "414130408": {
            "id": "414130408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "去哪儿好呢？",
            "nextDialogs": [
              "414130409"
            ]
          },
          "414130409": {
            "id": "414130409",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我想邀请你和我一起到「风龙废墟」去。"
          }
        }
      }
    },

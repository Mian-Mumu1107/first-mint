    {
      "subId": "4112518",
      "subQuestName": "向杰克回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411251001"
        ],
        "dialogs": {
          "411251001": {
            "id": "411251001",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "我知道了，谢谢你帮我调查，这些请你收下吧。",
            "nextDialogs": [
              "411251002"
            ]
          },
          "411251002": {
            "id": "411251002",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "不肯避难的学者…异常的魔物，还有协会人手不足的现状…",
            "nextDialogs": [
              "411251003"
            ]
          },
          "411251003": {
            "id": "411251003",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "唔…好好想想，好好想想…一定有说服塞琉斯先生的方法…"
          }
        }
      }

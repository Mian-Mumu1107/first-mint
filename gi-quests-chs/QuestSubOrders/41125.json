    {
      "subId": "4112506",
      "subQuestName": "前往低语森林调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411250601"
        ],
        "dialogs": {
          "411250601": {
            "id": "411250601",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "唉，也不知道…我能不能说服塞琉斯先生…",
            "nextDialogs": [
              "411250602"
            ]
          },
          "411250602": {
            "id": "411250602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你为什么想加入野外的调查？",
            "nextDialogs": [
              "411250603"
            ]
          },
          "411250603": {
            "id": "411250603",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "这个啊，哎呀…参与重要的工作，才能展现自己的价值嘛，我是这么想的…",
            "nextDialogs": [
              "411250604"
            ]
          },
          "411250604": {
            "id": "411250604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但要是事办砸了…",
            "nextDialogs": [
              "411250605"
            ]
          },
          "411250605": {
            "id": "411250605",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "喂！我还什么都没做呢，别说这么不吉利的话啊！"
          }
        }
      }
    },
    {
      "subId": "4112509",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411250901"
        ],
        "dialogs": {
          "411250901": {
            "id": "411250901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "野外的魔物有些异常。",
            "nextDialogs": [
              "411250902"
            ]
          },
          "411250902": {
            "id": "411250902",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "异常？难道是被陨石影响了，不过这种事情，应该早就有人报告过了吧。",
            "nextDialogs": [
              "411250903"
            ]
          },
          "411250903": {
            "id": "411250903",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "而且以我的实力，连那些普通的魔物都有些对付不了，这些异常的魔物…就更别提了。"
          }
        }
      }
    },

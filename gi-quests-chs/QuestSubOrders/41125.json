  "subQuests": [
    {
      "subId": "4112501",
      "subQuestName": "与杰克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411250101"
        ],
        "dialogs": {
          "411250101": {
            "id": "411250101",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "唉…要是我也能去看看就好了…",
            "nextDialogs": [
              "411250102"
            ]
          },
          "411250102": {
            "id": "411250102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "411250103"
            ]
          },
          "411250103": {
            "id": "411250103",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "是你啊。倒也没发生什么特别的事…",
            "nextDialogs": [
              "411250104"
            ]
          },
          "411250104": {
            "id": "411250104",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "呃，其实也算挺特别的吧…",
            "nextDialogs": [
              "411250106",
              "411250109"
            ]
          },
          "411250106": {
            "id": "411250106",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "对，你也看见了吧，最近一段时间，不断有陨石从天而降。",
            "nextDialogs": [
              "411250107"
            ]
          },
          "411250107": {
            "id": "411250107",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "不过…该说是风神护佑，还是单纯运气好呢，陨石一直没有砸进城里来。",
            "nextDialogs": [
              "411250113"
            ]
          },
          "411250113": {
            "id": "411250113",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "但还有不少的陨石坠落在了野外，而且据说…只要摸到了陨石的人，都会陷入沉睡，怎么样都叫不醒的那种。",
            "nextDialogs": [
              "411250114"
            ]
          },
          "411250114": {
            "id": "411250114",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "塞琉斯先生已经发布委托召集了一些冒险家，一部分去通知那些还留在野外的人进城避难…",
            "nextDialogs": [
              "411250115"
            ]
          },
          "411250115": {
            "id": "411250115",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "另外一部分，则是帮助西风骑士团去确认各处陨石的落点。",
            "nextDialogs": [
              "411250116"
            ]
          },
          "411250116": {
            "id": "411250116",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "然后以落点为中心，向四周搜索援救。",
            "nextDialogs": [
              "411250117"
            ]
          },
          "411250117": {
            "id": "411250117",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "至于我嘛…塞琉斯先生说，我最好还是留在城里，帮助照顾那些陷入昏睡的人比较好。",
            "nextDialogs": [
              "411250118"
            ]
          },
          "411250118": {
            "id": "411250118",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "也许是因为我实力没达标吧…但总是负责这些小事，我也一点变强的机会都没有嘛…",
            "nextDialogs": [
              "411250119"
            ]
          },
          "411250119": {
            "id": "411250119",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "唉，但不管怎么说，我也得先把分内的事处理好才行…不过旅行者，能请你帮我个忙吗？",
            "nextDialogs": [
              "411250120"
            ]
          },
          "411250120": {
            "id": "411250120",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "我想请你帮我去野外看看，搜集一下和那些陨石相关的信息…"
          },
          "411250109": {
            "id": "411250109",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "什么？！我怎么不知道！「猎鹿人」今天还有活动吗？",
            "nextDialogs": [
              "411250110"
            ]
          },
          "411250110": {
            "id": "411250110",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "哎！不对不对…我要说的不是这个…",
            "nextDialogs": [
              "411250111"
            ]
          },
          "411250111": {
            "id": "411250111",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "你也看见了吧，最近一段时间，不断有陨石从天而降。",
            "nextDialogs": [
              "411250112"
            ]
          },
          "411250112": {
            "id": "411250112",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "不过…该说是风神护佑，还是单纯运气好呢，陨石一直没有砸进城里来。"
          }
        }
      }
    },

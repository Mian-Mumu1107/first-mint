      "dialogue": {
        "startDialogs": [
          "411250701"
        ],
        "dialogs": {
          "411250701": {
            "id": "411250701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "去野外调查的冒险家似乎不多…",
            "nextDialogs": [
              "411250702"
            ]
          },
          "411250702": {
            "id": "411250702",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "唔…这么一说，协会这次发布的委托，确实没召集到太多的冒险家…",
            "nextDialogs": [
              "411250703"
            ]
          },
          "411250703": {
            "id": "411250703",
            "speakerId": 1000,
            "speakerName": "杰克",
            "text": "来来回回就是那么几个人，塞琉斯先生也在为这事头疼呢。"
          }
        }
      }
    },

    {
      "subId": "1000309",
      "subQuestName": "前往挪德卡莱，随奥兹寻找九老师",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100030901"
        ],
        "dialogs": {
          "100030901": {
            "id": "100030901",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "应该就在前面不远的地方。",
            "nextDialogs": [
              "100030902"
            ]
          },
          "100030902": {
            "id": "100030902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里居然有个被袭击的仙灵？看起来很可疑啊。",
            "nextDialogs": [
              "100030903"
            ]
          },
          "100030903": {
            "id": "100030903",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "而且在这位仙灵身上也能感受到那种神秘的引力。",
            "nextDialogs": [
              "100030904"
            ]
          },
          "100030904": {
            "id": "100030904",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "既是如此，那命运已然指示了方向。"
          }
        }
      }
    },
    {
      "subId": "1000315",
      "subQuestName": "前往挪德卡莱，随奥兹寻找九老师",
      "sceneId": null,
      "locations": [],

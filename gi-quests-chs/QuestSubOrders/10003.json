      }
    },
    {
      "subId": "1000314",
      "subQuestName": "帮助眼前的仙灵",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100031101"
        ],
        "dialogs": {
          "100031101": {
            "id": "100031101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个仙灵，似乎是在给我们引路？",
            "nextDialogs": [
              "100031102"
            ]
          },
          "100031102": {
            "id": "100031102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "跟过去看看吧。"
          }
        }
      }
    },
    {
      "subId": "1000311",
      "subQuestName": "跟随仙灵",
      "sceneId": null,
      "locations": [],

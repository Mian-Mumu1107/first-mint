        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1000317",
      "subQuestName": "与幕后之人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1000312",
      "subQuestName": "与幕后之人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100031201"
        ],
        "dialogs": {
          "100031201": {
            "id": "100031201",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "怎么是你们？",
            "nextDialogs": [
              "100031202"
            ]
          },
          "100031202": {
            "id": "100031202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个声音，是尼可！",
            "nextDialogs": [
              "100031203"
            ]
          },
          "100031203": {
            "id": "100031203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们还想问呢。为了找九老师，我们从璃月找到这里，结果最后遇到了你。",
            "nextDialogs": [
              "100031204"
            ]
          },
          "100031204": {
            "id": "100031204",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "和尼可以及仙灵说了八重堂的委托和之前的调查…",
            "nextDialogs": [
              "100031205"
            ]
          },
          "100031205": {
            "id": "100031205",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "原来是这样。九老师，就是它啊。",
            "nextDialogs": [
              "100031206"
            ]
          },
          "100031206": {
            "id": "100031206",
            "speakerId": 15873,
            "speakerName": "九老师",
            "text": "你们好啊！",
            "nextDialogs": [
              "100031207"
            ]
          },
          "100031207": {
            "id": "100031207",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "这、这是何等异常之「黄昏」，亿万幽夜也未曾听说过这样的事情！",
            "nextDialogs": [
              "100031208"
            ]
          },
          "100031208": {
            "id": "100031208",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "就是那个嘛，我其实也挺想当小说家来着，但是能够直接沟通思想比说话都方便。",
            "nextDialogs": [
              "100031209"
            ]
          },
          "100031209": {
            "id": "100031209",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "所以写字对我来说就更麻烦了。这个你们可以理解的吧。",
            "nextDialogs": [
              "100031210"
            ]
          },
          "100031210": {
            "id": "100031210",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "找人把想写的设定和情节畅快地说一通，就相当于自己写了。但是真这么做了我又觉得可惜。",
            "nextDialogs": [
              "100031211"
            ]
          },
          "100031211": {
            "id": "100031211",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "所以我就找了一个仙灵故交，把我的设定和点子全给她说了。让她去找想成为小说家的人替我写书。",
            "nextDialogs": [
              "100031212"
            ]
          },
          "100031212": {
            "id": "100031212",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "为了真实性九老师还编了很多很有真实感的人设呢。比如脱发什么的。",
            "nextDialogs": [
              "100031213"
            ]
          },
          "100031213": {
            "id": "100031213",
            "speakerId": 15873,
            "speakerName": "九老师",
            "text": "我就是那个受害者。",
            "nextDialogs": [
              "100031214"
            ]
          },
          "100031214": {
            "id": "100031214",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "也不能这么说嘛。通过调动那些作家预备役的语言系统，你说话的知性不都锻炼到恢复了嘛。",
            "nextDialogs": [
              "100031215"
            ]
          },
          "100031215": {
            "id": "100031215",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "天使嘛，就是人脑子灵光乍现跑出来的灵感。也是重操旧业了。",
            "nextDialogs": [
              "100031216"
            ]
          },
          "100031216": {
            "id": "100031216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这真的没问题吗？",
            "nextDialogs": [
              "100031217"
            ]
          },
          "100031217": {
            "id": "100031217",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "没关系。稿子都是趁着人睡着了被九老师上身写的。",
            "nextDialogs": [
              "100031218"
            ]
          },
          "100031218": {
            "id": "100031218",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "只要是存在着创造世界的梦想，就会浮现的作家人格。自动式的哦。",
            "nextDialogs": [
              "100031219"
            ]
          },
          "100031219": {
            "id": "100031219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「自动式的哦。」",
            "nextDialogs": [
              "100031220"
            ]
          },
          "100031220": {
            "id": "100031220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，那求救信和奥兹的奇妙感觉是怎么回事？",
            "nextDialogs": [
              "100031221"
            ]
          },
          "100031221": {
            "id": "100031221",
            "speakerId": 15873,
            "speakerName": "九老师",
            "text": "我被尼可抓过来当挪德卡莱的监视员了。很危险好不好，我现在可没有天空的知识库和力量了。",
            "nextDialogs": [
              "100031222"
            ]
          },
          "100031222": {
            "id": "100031222",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "至于那边那位的诞生之缘，你看，小说为了真实感，会加入很多半真半假的细节嘛。",
            "nextDialogs": [
              "100031223"
            ]
          },
          "100031223": {
            "id": "100031223",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实，稻妻的轻小说就有过写真实咒语的先例…",
            "nextDialogs": [
              "100031224"
            ]
          },
          "100031224": {
            "id": "100031224",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "九老师故事的设定都是一些隐喻，里面创造生命的办法也不能说完全是假的吧…",
            "nextDialogs": [
              "100031225"
            ]
          },
          "100031225": {
            "id": "100031225",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "但是没想到真的有小姑娘能够成功。",
            "nextDialogs": [
              "100031226"
            ]
          },
          "100031226": {
            "id": "100031226",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "…",
            "nextDialogs": [
              "100031227"
            ]
          },
          "100031227": {
            "id": "100031227",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐已经完全呆住了。不过，容我僭越地理解一下：小姐通过小说里半真半假的方法，把我创造了出来？",
            "nextDialogs": [
              "100031228"
            ]
          },
          "100031228": {
            "id": "100031228",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "七成假三成真吧。",
            "nextDialogs": [
              "100031229"
            ]
          },
          "100031229": {
            "id": "100031229",
            "speakerId": 15873,
            "speakerName": "九老师",
            "text": "九成假一成真。太危险了，所以我自己改了。我写的书你果然没看过！",
            "nextDialogs": [
              "100031230"
            ]
          },
          "100031230": {
            "id": "100031230",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奥兹好像不怎么惊讶？",
            "nextDialogs": [
              "100031231"
            ]
          },
          "100031231": {
            "id": "100031231",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "怎么说呢？或许诞生之初就隐约察觉到了。能为小姐服务，我很荣幸。",
            "nextDialogs": [
              "100031232"
            ]
          },
          "100031232": {
            "id": "100031232",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "总之挪德卡莱的事情结束，九老师就可以光荣回归了。你们就这么回去说吧。",
            "nextDialogs": [
              "100031233"
            ]
          },
          "100031233": {
            "id": "100031233",
            "speakerId": 15873,
            "speakerName": "九老师",
            "text": "我不要在这里当你眼睛！太危险啦！",
            "nextDialogs": [
              "100031234"
            ]
          },
          "100031234": {
            "id": "100031234",
            "speakerId": 15873,
            "speakerName": "九老师",
            "text": "不过这么说来，要麻烦你和轻策庄那位大叔带个话。稿费版税我们九一开了，这么多年的都埋他院里了。",
            "nextDialogs": [
              "100031235"
            ]
          },
          "100031235": {
            "id": "100031235",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你要钱做什么啊？",
            "nextDialogs": [
              "100031236"
            ]
          },
          "100031236": {
            "id": "100031236",
            "speakerId": 15873,
            "speakerName": "九老师",
            "text": "我要把它藏起来当财宝，然后指引人跟着我去取啊。我们天性就喜欢引导人，就喜欢这一口。",
            "nextDialogs": [
              "100031237"
            ]
          },
          "100031237": {
            "id": "100031237",
            "speakerId": 15873,
            "speakerName": "九老师",
            "text": "以后有机会欢迎来找我的宝藏，我把它埋在幽夜净土的尽头了。",
            "nextDialogs": [
              "100031238"
            ]
          },
          "100031238": {
            "id": "100031238",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "我一定会去的！",
            "nextDialogs": [
              "100031239"
            ]
          },
          "100031239": {
            "id": "100031239",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐？",
            "nextDialogs": [
              "100031240"
            ]
          },
          "100031240": {
            "id": "100031240",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "那个，九老师，我很喜欢你的小说！",
            "nextDialogs": [
              "100031241"
            ]
          },
          "100031241": {
            "id": "100031241",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐的意思是：纵使宇宙的漆黑无边无际，万事万物终将投下发着光的影子。",
            "nextDialogs": [
              "100031242"
            ]
          },
          "100031242": {
            "id": "100031242",
            "speakerId": 15873,
            "speakerName": "九老师",
            "text": "我很高兴哦。看来你已经找到我最大的宝藏了。",
            "nextDialogs": [
              "100031243"
            ]
          },
          "100031243": {
            "id": "100031243",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "那么这件事就先这样吧。现在我要和九老师吵一架，来争夺第一作者究竟是谁了。",
            "nextDialogs": [
              "100031244"
            ]
          },
          "100031244": {
            "id": "100031244",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是常九爷吗？",
            "nextDialogs": [
              "100031245"
            ]
          },
          "100031245": {
            "id": "100031245",
            "speakerId": 1010,
            "speakerName": "尼可&菲谢尔&九老师",
            "text": "绝对不可能。",
            "nextDialogs": [
              "100031246"
            ]
          },
          "100031246": {
            "id": "100031246",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "告别之后，一行人走上了归途。"
          }
        }
      }
    }
  ]
}
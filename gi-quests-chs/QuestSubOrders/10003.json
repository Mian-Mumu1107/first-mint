  },
  "subQuests": [
    {
      "subId": "1000301",
      "subQuestName": "前往蒙德城的冒险家协会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100030101"
        ],
        "dialogs": {
          "100030101": {
            "id": "100030101",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "#向着星辰与深渊。你好，{NICKNAME}。",
            "nextDialogs": [
              "100030102"
            ]
          },
          "100030102": {
            "id": "100030102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好啊，凯瑟琳。奥兹、菲谢尔，你们也在，真巧啊。",
            "nextDialogs": [
              "100030103"
            ]
          },
          "100030103": {
            "id": "100030103",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "宇宙万物都会落入幽夜，追求光的人自会在黎明的境界上相聚。",
            "nextDialogs": [
              "100030104"
            ]
          },
          "100030104": {
            "id": "100030104",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "#小姐的意思是，确实是巧遇，你们好。而我个人想说的也是：你们好，派蒙和{NICKNAME}。",
            "nextDialogs": [
              "100030105"
            ]
          },
          "100030105": {
            "id": "100030105",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "#{NICKNAME}，最近正好有一个八重堂点名希望你接受的委托。他们派了一个编辑过来接洽委托的详细情况。",
            "nextDialogs": [
              "100030106"
            ]
          },
          "100030106": {
            "id": "100030106",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "好像因为涉及商业隐秘，所以委托的很多细节无法全权交待给协会。只说是关于《神霄折戟录》作者的…",
            "nextDialogs": [
              "100030107"
            ]
          },
          "100030107": {
            "id": "100030107",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "什么？那岂不是…",
            "nextDialogs": [
              "100030108"
            ]
          },
          "100030108": {
            "id": "100030108",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "咳咳。",
            "nextDialogs": [
              "100030109"
            ]
          },
          "100030109": {
            "id": "100030109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个作者这么重要吗？万一我们最近不在或者听了觉得任务很麻烦，编辑不就白来一趟了吗？",
            "nextDialogs": [
              "100030110"
            ]
          },
          "100030110": {
            "id": "100030110",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "把它当作只需要带一句话的公费采风的话，我觉得大家可能争这个机会能争得头破血流…",
            "nextDialogs": [
              "100030111"
            ]
          },
          "100030111": {
            "id": "100030111",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "如果你愿意接下这个委托的话，可以在猎鹿人找到那位编辑先生。稻妻人应该还挺显眼的。",
            "nextDialogs": [
              "100030112"
            ]
          },
          "100030112": {
            "id": "100030112",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "等…我是说，旅人哦，切勿焦急。命运把你推向世界的潮流，并非是为了让你孤身面对荒芜。",
            "nextDialogs": [
              "100030113"
            ]
          },
          "100030113": {
            "id": "100030113",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "而是为了把你推向幽夜净土的轨迹！",
            "nextDialogs": [
              "100030114"
            ]
          },
          "100030114": {
            "id": "100030114",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐的意思是：请让她也一起帮忙。",
            "nextDialogs": [
              "100030115"
            ]
          },
          "100030115": {
            "id": "100030115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "菲谢尔突然好积极！感觉有什么内情？",
            "nextDialogs": [
              "100030116"
            ]
          },
          "100030116": {
            "id": "100030116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不也挺好。",
            "nextDialogs": [
              "100030117"
            ]
          },
          "100030117": {
            "id": "100030117",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "那么就趁着大家都在，一起先去猎鹿人看看能不能找到那位编辑先生吧。"
          }
        }
      }
    },
    {
      "subId": "1000313",
      "subQuestName": "前往猎鹿人，寻找来接洽的编辑",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100030201"
        ],
        "dialogs": {
          "100030201": {
            "id": "100030201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个可以来蒙德公费旅游的幸运之人是——",
            "nextDialogs": [
              "100030202"
            ]
          },
          "100030202": {
            "id": "100030202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "行——不对，枕玉老师的负责编辑小野寺！",
            "nextDialogs": [
              "100030203"
            ]
          },
          "100030203": {
            "id": "100030203",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "#{NICKNAME}，之前承蒙照顾了。希望这次你听完八重大人的委托之后还能再照顾我一次…",
            "nextDialogs": [
              "100030204"
            ]
          },
          "100030204": {
            "id": "100030204",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "旁边这位菲谢尔皇女打扮的是？",
            "nextDialogs": [
              "100030205"
            ]
          },
          "100030205": {
            "id": "100030205",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "吾乃断罪之皇女菲谢尔。",
            "nextDialogs": [
              "100030206"
            ]
          },
          "100030206": {
            "id": "100030206",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐的意思是：她是菲谢尔，很高兴认识你。",
            "nextDialogs": [
              "100030207"
            ]
          },
          "100030207": {
            "id": "100030207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，她是菲谢尔小姐。是个来协助的朋友。她可是很可靠的冒险家哦。",
            "nextDialogs": [
              "100030208"
            ]
          },
          "100030208": {
            "id": "100030208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没错，她是菲谢尔。",
            "nextDialogs": [
              "100030209"
            ]
          },
          "100030209": {
            "id": "100030209",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "原、原来是菲谢尔啊。就算如此，也不用说四次吧。",
            "nextDialogs": [
              "100030210"
            ]
          },
          "100030210": {
            "id": "100030210",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "即已知晓吾之名讳，自然应该了解：称吾之名，即为赎罪。因故，称赞吾名，即是救祓。",
            "nextDialogs": [
              "100030211"
            ]
          },
          "100030211": {
            "id": "100030211",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐的意思是：她——",
            "nextDialogs": [
              "100030212"
            ]
          },
          "100030212": {
            "id": "100030212",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "原来是这样啊。记住名字确实是基本礼节。只要能解决问题，让我喊一万次也没问题。谢谢你来帮忙。",
            "nextDialogs": [
              "100030213"
            ]
          },
          "100030213": {
            "id": "100030213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居、居然比奥兹的翻译还要更早明白菲谢尔的意思！",
            "nextDialogs": [
              "100030214"
            ]
          },
          "100030214": {
            "id": "100030214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可不要小看编辑。",
            "nextDialogs": [
              "100030215"
            ]
          },
          "100030215": {
            "id": "100030215",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "那么事不宜迟，让我来详细说说这次的委托吧。",
            "nextDialogs": [
              "100030216"
            ]
          },
          "100030216": {
            "id": "100030216",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "你们应该知道，《神霄折戟录》的作者九老师吧？",
            "nextDialogs": [
              "100030217"
            ]
          },
          "100030217": {
            "id": "100030217",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "菲谢尔…",
            "nextDialogs": [
              "100030218"
            ]
          },
          "100030218": {
            "id": "100030218",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐，您说什么？",
            "nextDialogs": [
              "100030219"
            ]
          },
          "100030219": {
            "id": "100030219",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "九老师代表作明明是《菲谢尔皇女夜谭》！",
            "nextDialogs": [
              "100030220"
            ]
          },
          "100030220": {
            "id": "100030220",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "咳咳，小姐的意思是：倘若造物主的常态只有冷酷，那幽夜净土与皇女也应是足以让它垂泪的造物。",
            "nextDialogs": [
              "100030221"
            ]
          },
          "100030221": {
            "id": "100030221",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "那好的。《菲谢尔皇女夜谭》的作者九老师，最近从挪德卡莱发来一封求救信，看起来他状态很不好。",
            "nextDialogs": [
              "100030222"
            ]
          },
          "100030222": {
            "id": "100030222",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那这不是一个很简单的事情吗？委托那边的协会或者佣兵找到他就好了啊。",
            "nextDialogs": [
              "100030223"
            ]
          },
          "100030223": {
            "id": "100030223",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "所以最大的问题来了。我们其实也不知道九老师长什么样，年纪多大，是胖是瘦，是哪国人…",
            "nextDialogs": [
              "100030224"
            ]
          },
          "100030224": {
            "id": "100030224",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "他从来只写信和八重堂联系，发信地址遍布全大陆。作者年会和线下活动也请不来真人。",
            "nextDialogs": [
              "100030225"
            ]
          },
          "100030225": {
            "id": "100030225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种委托怎么做啊？",
            "nextDialogs": [
              "100030226"
            ]
          },
          "100030226": {
            "id": "100030226",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "所以调查九老师究竟是谁是委托的一个重要部分。",
            "nextDialogs": [
              "100030227"
            ]
          },
          "100030227": {
            "id": "100030227",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "我们也自己努力调查过。结果发现，九老师自从《神霄》完结之后，字迹都开始不一样了。",
            "nextDialogs": [
              "100030228"
            ]
          },
          "100030228": {
            "id": "100030228",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "最早给九老师负责的编辑也已经辞职，想要自己写小说来着。他对于九老师也没有额外信息可以补充。",
            "nextDialogs": [
              "100030229"
            ]
          },
          "100030229": {
            "id": "100030229",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "凡存在过的事物都会被断罪皇女记住，在幽夜净土中永存。原初神圣言语自会涌流出一切因果。",
            "nextDialogs": [
              "100030230"
            ]
          },
          "100030230": {
            "id": "100030230",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐的意思是：最——",
            "nextDialogs": [
              "100030231"
            ]
          },
          "100030231": {
            "id": "100030231",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "没错，我们想到一块去了。所以我们找出来了最早的《神霄折戟录》原稿！",
            "nextDialogs": [
              "100030232"
            ]
          },
          "100030232": {
            "id": "100030232",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊！这个行——枕玉老师看到会激动到晕过去的吧？",
            "nextDialogs": [
              "100030233"
            ]
          },
          "100030233": {
            "id": "100030233",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对！比起这个，小野寺居然又先于奥兹理解了菲谢尔的话！",
            "nextDialogs": [
              "100030234"
            ]
          },
          "100030234": {
            "id": "100030234",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "编辑，很神奇吧？",
            "nextDialogs": [
              "100030235"
            ]
          },
          "100030235": {
            "id": "100030235",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "这是…",
            "nextDialogs": [
              "100030236"
            ]
          },
          "100030236": {
            "id": "100030236",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "奥兹华尔多·亨利·赫芙那梵茵斯哟，你发现了什么吗？",
            "nextDialogs": [
              "100030251"
            ]
          },
          "100030251": {
            "id": "100030251",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "没有那个「亨利」，小姐。",
            "nextDialogs": [
              "100030237"
            ]
          },
          "100030237": {
            "id": "100030237",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "确实能感觉到一丝若有若无的感应。和小姐您身上的…磁场、引力、因果丝线，这样的东西近似。",
            "nextDialogs": [
              "100030238"
            ]
          },
          "100030238": {
            "id": "100030238",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "我们最后只确定了一件事。投稿的稿纸底纹和工艺来自璃月，大概就在轻策庄。",
            "nextDialogs": [
              "100030239"
            ]
          },
          "100030239": {
            "id": "100030239",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "九老师难道是个璃月人吗？",
            "nextDialogs": [
              "100030240"
            ]
          },
          "100030240": {
            "id": "100030240",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对，说到轻策庄写小说的…",
            "nextDialogs": [
              "100030241"
            ]
          },
          "100030241": {
            "id": "100030241",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "常…九爷？",
            "nextDialogs": [
              "100030242"
            ]
          },
          "100030242": {
            "id": "100030242",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这不太可能吧？",
            "nextDialogs": [
              "100030243"
            ]
          },
          "100030243": {
            "id": "100030243",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "常九爷是吗？《古华派的大师兄》也是新人奖获奖作品，我听说过。",
            "nextDialogs": [
              "100030244"
            ]
          },
          "100030244": {
            "id": "100030244",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "无妨。「垂泪的圣徒」与「赎罪的圣徒」纵使所行之道义不同，力量却是同源。",
            "nextDialogs": [
              "100030245"
            ]
          },
          "100030245": {
            "id": "100030245",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小野寺先生，您请。",
            "nextDialogs": [
              "100030246"
            ]
          },
          "100030246": {
            "id": "100030246",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奥兹我知道你信任小野寺，但是考虑一下我们啊！",
            "nextDialogs": [
              "100030247"
            ]
          },
          "100030247": {
            "id": "100030247",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "说的也没错。既然同为作家，就算不是一人，说不定总会有些交流吧？把他当切入点或许不错。",
            "nextDialogs": [
              "100030248"
            ]
          },
          "100030248": {
            "id": "100030248",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "编辑，很强大吧？",
            "nextDialogs": [
              "100030249"
            ]
          },
          "100030249": {
            "id": "100030249",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃。",
            "nextDialogs": [
              "100030250"
            ]
          },
          "100030250": {
            "id": "100030250",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "那就麻烦你们了！"
          }
        }
      }
    },
    {
      "subId": "1000302",
      "subQuestName": "前往轻策庄，向常九爷询问详情",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100030401"
        ],
        "dialogs": {
          "100030401": {
            "id": "100030401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "常九爷似乎不在啊。",
            "nextDialogs": [
              "100030402"
            ]
          },
          "100030402": {
            "id": "100030402",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "看来一下子是找不到人问话了。是要在这里等一等他吗？",
            "nextDialogs": [
              "100030403"
            ]
          },
          "100030403": {
            "id": "100030403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像只能这样了。",
            "nextDialogs": [
              "100030404"
            ]
          },
          "100030404": {
            "id": "100030404",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "不过，他不在的话，是不是说明…他确实有可能是被绑架到挪德卡莱的九老师呢？",
            "nextDialogs": [
              "100030405"
            ]
          },
          "100030405": {
            "id": "100030405",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "要不要搜查一下他的住处？",
            "nextDialogs": [
              "100030406"
            ]
          },
          "100030406": {
            "id": "100030406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总觉得私自搜别人的家有点不好。不过哦，万一常九爷真的是九老师的话…"
          }
        }
      }
    },
    {
      "subId": "1000303",
      "subQuestName": "调查周围线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100030301"
        ],
        "dialogs": {
          "100030301": {
            "id": "100030301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "九老师还有什么特征吗？",
            "nextDialogs": [
              "100030302"
            ]
          },
          "100030302": {
            "id": "100030302",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "根据读者来信问答和卷尾「作者的话」来看，他应该发际线后退、轻微啤酒肚、不喜欢吃甜的、心脏在右边。",
            "nextDialogs": [
              "100030303"
            ]
          },
          "100030303": {
            "id": "100030303",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "左边还是右边？嗯，右边。然后他左手有五个手指，失眠很严重、每只眼睛各有一个瞳孔…",
            "nextDialogs": [
              "100030304"
            ]
          },
          "100030304": {
            "id": "100030304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好没特色！"
          }
        }
      }
    },
    {
      "subId": "1000304",
      "subQuestName": "调查周围线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1000305",
      "subQuestName": "调查周围线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100030501"
        ],
        "dialogs": {
          "100030501": {
            "id": "100030501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看起来也是平平无奇的东西呢。",
            "nextDialogs": [
              "100030502"
            ]
          },
          "100030502": {
            "id": "100030502",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "并非如此。本皇女已然看破尘埃之中的宇宙奥秘。它所展现的，正是涌向真实的智慧泉流。",
            "nextDialogs": [
              "100030503"
            ]
          },
          "100030503": {
            "id": "100030503",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐的意思是：她觉得这个是线索。"
          }
        }
      }
    },
    {
      "subId": "1000306",
      "subQuestName": "与菲谢尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1000307",
      "subQuestName": "调查菲谢尔怀疑的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100030701"
        ],
        "dialogs": {
          "100030701": {
            "id": "100030701",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "幻想我自己是九老师是么？倒也不失为一种打开创作思路的办法。",
            "nextDialogs": [
              "100030702"
            ]
          },
          "100030702": {
            "id": "100030702",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "开始幻想了，幻想我是九老师。如果是九老师会怎么写。"
          }
        }
      }
    },
    {
      "subId": "1000308",
      "subQuestName": "与菲谢尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100030801"
        ],
        "dialogs": {
          "100030801": {
            "id": "100030801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里居然真的有翻土的痕迹！",
            "nextDialogs": [
              "100030802"
            ]
          },
          "100030802": {
            "id": "100030802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊，常九爷该不会被热情的粉丝埋在下面了吧！",
            "nextDialogs": [
              "100030803"
            ]
          },
          "100030803": {
            "id": "100030803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "旅行者，要不我们还是喊千岩军过来检查吧。",
            "nextDialogs": [
              "100030804"
            ]
          },
          "100030804": {
            "id": "100030804",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "诸位完全可以放心，最热情的粉丝就在眼前。",
            "nextDialogs": [
              "100030805"
            ]
          },
          "100030805": {
            "id": "100030805",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "既然小姐不会去伤害任何人，其他没这么热情的粉丝应该也不会。",
            "nextDialogs": [
              "100030806"
            ]
          },
          "100030806": {
            "id": "100030806",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那动手吧。",
            "nextDialogs": [
              "100030807"
            ]
          },
          "100030807": {
            "id": "100030807",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "挖开了松动的地面。\\n找到了一大袋摩拉和北国银行的支票…\\n\\n突然一声呵斥在背后响起，你下意识把东西塞进了兜里。",
            "nextDialogs": [
              "100030808"
            ]
          },
          "100030808": {
            "id": "100030808",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你们在干什么！我要喊千岩军了！",
            "nextDialogs": [
              "100030809"
            ]
          },
          "100030809": {
            "id": "100030809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！常九爷，你没死啊！也没被绑架！",
            "nextDialogs": [
              "100030810"
            ]
          },
          "100030810": {
            "id": "100030810",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "你能不能说几句好话。仔细一看，这不是上次跟着古华派小哥来这里的那谁吗？",
            "nextDialogs": [
              "100030811"
            ]
          },
          "100030811": {
            "id": "100030811",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "嗨，看来是个误会。你们来我家翻土是干什么？",
            "nextDialogs": [
              "100030812"
            ]
          },
          "100030812": {
            "id": "100030812",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实，我们想问你…该不会用过「九老师」这个笔名吧？",
            "nextDialogs": [
              "100030813"
            ]
          },
          "100030813": {
            "id": "100030813",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "就算吃蘑菇发幻觉了我也不可能是九老师啊。我要是九老师，我投稿这么多年小说大赛图什么啊？",
            "nextDialogs": [
              "100030814"
            ]
          },
          "100030814": {
            "id": "100030814",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "图个扮猪吃老虎吗？那我还真是自取其辱，投稿落选了这么多年。",
            "nextDialogs": [
              "100030815"
            ]
          },
          "100030815": {
            "id": "100030815",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "我可经常被批评说「古典的少年英雄主角已经落后时代了。甚至开篇反转、扮猪吃虎都快过时了。」",
            "nextDialogs": [
              "100030816"
            ]
          },
          "100030816": {
            "id": "100030816",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "「…现在的读者喜欢九老师那种天马行空、标新立异的世界观和设定。」",
            "nextDialogs": [
              "100030817"
            ]
          },
          "100030817": {
            "id": "100030817",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也是哦。",
            "nextDialogs": [
              "100030818"
            ]
          },
          "100030818": {
            "id": "100030818",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "我要真是九老师本人，《古华派的大师兄》获奖那一年，我就该立刻宣布其实我是九老师。",
            "nextDialogs": [
              "100030819"
            ]
          },
          "100030819": {
            "id": "100030819",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "「什么？居然是九老师。是不是弄错了，老常就是个落魄户啊。」啧啧，这么来一出，一定畅快。",
            "nextDialogs": [
              "100030820"
            ]
          },
          "100030820": {
            "id": "100030820",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你家还收藏着《神霄折戟录》来着。回想一下当初你在行秋和我们面前夸这个作品的样子。",
            "nextDialogs": [
              "100030821"
            ]
          },
          "100030821": {
            "id": "100030821",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你要真是九老师，岂不也是一种「琴团长在夸自己欸」。这么想想确实不对。",
            "nextDialogs": [
              "100030822"
            ]
          },
          "100030822": {
            "id": "100030822",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "各位，虽然常先生并不是九老师。但是对我来说，他身上也有奇特的感觉。",
            "nextDialogs": [
              "100030823"
            ]
          },
          "100030823": {
            "id": "100030823",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "那是一种奇特的感应，和小姐以及原稿一样的「缘」。我觉得我似乎有能力追踪和九老师有关的事物。",
            "nextDialogs": [
              "100030824"
            ]
          },
          "100030824": {
            "id": "100030824",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然这样就好办了！到了挪德卡莱，让奥兹领着我们寻找就可以了。",
            "nextDialogs": [
              "100030825"
            ]
          },
          "100030825": {
            "id": "100030825",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说来，常九爷你刚才是去干什么了啊？",
            "nextDialogs": [
              "100030826"
            ]
          },
          "100030826": {
            "id": "100030826",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "我稿纸用完了，去买稿纸了呗。我可是讲究人，当作事业的文学创作自然要用上档次的纸。",
            "nextDialogs": [
              "100030827"
            ]
          },
          "100030827": {
            "id": "100030827",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "确实和那份原稿的纸一样。",
            "nextDialogs": [
              "100030828"
            ]
          },
          "100030828": {
            "id": "100030828",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们没问题了！谢谢你啦，常九爷。事不宜迟，我们赶快出发吧！",
            "nextDialogs": [
              "100030829"
            ]
          },
          "100030829": {
            "id": "100030829",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "虽然我也不知道帮了什么忙，但是不客气。",
            "nextDialogs": [
              "100030830"
            ]
          },
          "100030830": {
            "id": "100030830",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "别了，他世界的造物者哟。虽然汝所安立之法则与叙事，自无法比拟幽夜净土下积淀的梦之尘泥。",
            "nextDialogs": [
              "100030831"
            ]
          },
          "100030831": {
            "id": "100030831",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐的意思是：您写得不如…算了，小姐的意思是：谢谢您，常九爷，再见。"
          }
        }
      }
    },
    {

    {
      "subId": "1204602",
      "subQuestName": "前往秋沙钱汤",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120460201"
        ],
        "dialogs": {
          "120460201": {
            "id": "120460201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "瑞希，我们来预约下次的心理诊疗服务了…",
            "nextDialogs": [
              "120460202"
            ]
          },
          "120460202": {
            "id": "120460202",
            "speakerId": 3210,
            "speakerName": "百日白白音",
            "text": "唔…",
            "nextDialogs": [
              "120460203"
            ]
          },
          "120460203": {
            "id": "120460203",
            "speakerId": 3211,
            "speakerName": "柴葉紫",
            "text": "真难熬…",
            "nextDialogs": [
              "120460204"
            ]
          },
          "120460204": {
            "id": "120460204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这是怎么了？",
            "nextDialogs": [
              "120460205"
            ]
          },
          "120460205": {
            "id": "120460205",
            "speakerId": 3038,
            "speakerName": "蓝川丞",
            "text": "一觉醒来，就变成了这个样子…",
            "nextDialogs": [
              "120460206"
            ]
          },
          "120460206": {
            "id": "120460206",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "…是很严重的消化不良。",
            "nextDialogs": [
              "120460207"
            ]
          },
          "120460207": {
            "id": "120460207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？难道白音和阿紫昨晚吃了很多噩梦？",
            "nextDialogs": [
              "120460208"
            ]
          },
          "120460208": {
            "id": "120460208",
            "speakerId": 3038,
            "speakerName": "蓝川丞",
            "text": "#不会吧？昨天登记的客人除了{NICKNAME}和派蒙，就只剩下两个。",
            "nextDialogs": [
              "120460209"
            ]
          },
          "120460209": {
            "id": "120460209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那两个人…",
            "nextDialogs": [
              "120460210"
            ]
          },
          "120460210": {
            "id": "120460210",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "那两个人的噩梦有问题，影响食梦貘消化的因素除了噩梦的数量，还有噩梦的强度。",
            "nextDialogs": [
              "120460211"
            ]
          },
          "120460211": {
            "id": "120460211",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "这种强度的噩梦，根本不是正常人应该有的。",
            "nextDialogs": [
              "120460212"
            ]
          },
          "120460212": {
            "id": "120460212",
            "speakerId": 3210,
            "speakerName": "百日白白音",
            "text": "呕…",
            "nextDialogs": [
              "120460213"
            ]
          },
          "120460213": {
            "id": "120460213",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "如果不能帮她们尽快消化噩梦的话…",
            "nextDialogs": [
              "120460214"
            ]
          },
          "120460214": {
            "id": "120460214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "接下来需要做什么？我们可以帮忙！",
            "nextDialogs": [
              "120460215"
            ]
          },
          "120460215": {
            "id": "120460215",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "必须先找到那两名客人，了解他们产生噩梦的原因，我才能帮助白音和阿紫消化噩梦。",
            "nextDialogs": [
              "120460216"
            ]
          },
          "120460216": {
            "id": "120460216",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "#{NICKNAME}，派蒙，你们昨天和他们交流过，有把握找到他们吗？",
            "nextDialogs": [
              "120460217"
            ]
          },
          "120460217": {
            "id": "120460217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…对了，他们说还要再找「江村一玄斋」接受一次指导，今天可能还会去那个地方！",
            "nextDialogs": [
              "120460218"
            ]
          },
          "120460218": {
            "id": "120460218",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "请带我去。"
          }
        }
      }
    },
    {
      "subId": "1204603",
      "subQuestName": "前往「江村一玄斋」的营业地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120460301"
        ],
        "dialogs": {
          "120460301": {
            "id": "120460301",
            "speakerId": 15038,
            "speakerName": "海彦",
            "text": "今天出海，撒网的时候没注意，把那么大一张网给搞丢了，不过也无所谓，哈哈…",
            "nextDialogs": [
              "120460302"
            ]
          },
          "120460302": {
            "id": "120460302",
            "speakerId": 15037,
            "speakerName": "薄田",
            "text": "我也搞砸了一件差事，但现在想想，放跑几个匪徒也没什么大不了的，哈哈…",
            "nextDialogs": [
              "120460303"
            ]
          },
          "120460303": {
            "id": "120460303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，你们两个！就是因为你们的噩梦，阿紫和白音才变成那样！",
            "nextDialogs": [
              "120460304"
            ]
          },
          "120460304": {
            "id": "120460304",
            "speakerId": 15037,
            "speakerName": "薄田",
            "text": "这个小家伙好生气啊，真有趣，哈哈…",
            "nextDialogs": [
              "120460305"
            ]
          },
          "120460305": {
            "id": "120460305",
            "speakerId": 15038,
            "speakerName": "海彦",
            "text": "真有趣，哈哈…",
            "nextDialogs": [
              "120460306"
            ]
          },
          "120460306": {
            "id": "120460306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这…",
            "nextDialogs": [
              "120460307"
            ]
          },
          "120460307": {
            "id": "120460307",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "怎么了？",
            "nextDialogs": [
              "120460308"
            ]
          },
          "120460308": {
            "id": "120460308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这两个人好奇怪啊，我都觉得自己刚刚的语气有些冲，结果他们一点也不生气。",
            "nextDialogs": [
              "120460309"
            ]
          },
          "120460309": {
            "id": "120460309",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "…让我来。两位还记得昨晚前往秋沙钱汤进行梦境调理的事吗？",
            "nextDialogs": [
              "120460310"
            ]
          },
          "120460310": {
            "id": "120460310",
            "speakerId": 15038,
            "speakerName": "海彦",
            "text": "有吗？",
            "nextDialogs": [
              "120460311"
            ]
          },
          "120460311": {
            "id": "120460311",
            "speakerId": 15037,
            "speakerName": "薄田",
            "text": "没有吧？",
            "nextDialogs": [
              "120460312"
            ]
          },
          "120460312": {
            "id": "120460312",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "这…两位最近有做噩梦吗？",
            "nextDialogs": [
              "120460313"
            ]
          },
          "120460313": {
            "id": "120460313",
            "speakerId": 15037,
            "speakerName": "薄田",
            "text": "怎么会？这世界上什么东西能让人做噩梦？",
            "nextDialogs": [
              "120460314"
            ]
          },
          "120460314": {
            "id": "120460314",
            "speakerId": 15038,
            "speakerName": "海彦",
            "text": "让我想想…完全没有啊，正常人怎么会做噩梦？看看海，赏赏花，人生就很美好了。",
            "nextDialogs": [
              "120460315"
            ]
          },
          "120460315": {
            "id": "120460315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么回事？这两个人好像完全不记得昨晚的事啊。",
            "nextDialogs": [
              "120460316"
            ]
          },
          "120460316": {
            "id": "120460316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，考虑到他们现在的状态，我真的很难想象他们会做噩梦…难道那个「江村一玄斋」真的没有骗人？",
            "nextDialogs": [
              "120460317"
            ]
          },
          "120460317": {
            "id": "120460317",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "#不，这种心理状态很奇怪…{NICKNAME}，派蒙，请不要分神，我可能要采取一些特殊的手段。",
            "nextDialogs": [
              "120460318"
            ]
          },
          "120460318": {
            "id": "120460318",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是…",
            "nextDialogs": [
              "120460319"
            ]
          },
          "120460319": {
            "id": "120460319",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "我发现他们的潜意识都是游离状态，这让我可以借助与入梦类似的手段来到他们的潜意识里。",
            "nextDialogs": [
              "120460320"
            ]
          },
          "120460320": {
            "id": "120460320",
            "speakerId": 15037,
            "speakerName": "薄田",
            "text": "可恶！可恶！绝不放过他们，绝不！",
            "nextDialogs": [
              "120460321"
            ]
          },
          "120460321": {
            "id": "120460321",
            "speakerId": 15038,
            "speakerName": "海彦",
            "text": "风浪太大了，让我留在岸上吧…",
            "nextDialogs": [
              "120460322"
            ]
          },
          "120460322": {
            "id": "120460322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！？",
            "nextDialogs": [
              "120460323"
            ]
          },
          "120460323": {
            "id": "120460323",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "如你们所见，他们的「烦恼」并没有被消除。",
            "nextDialogs": [
              "120460324"
            ]
          },
          "120460324": {
            "id": "120460324",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "这名薄田大概冲动易怒，这会让他在行动中做出很出格的举动，不免深受其扰。",
            "nextDialogs": [
              "120460325"
            ]
          },
          "120460325": {
            "id": "120460325",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "而这位海彦，可能是因为某次劫后余生的经历而害怕风浪，不愿意出海，恐怕他的生计也因此受到了很大影响。",
            "nextDialogs": [
              "120460326"
            ]
          },
          "120460326": {
            "id": "120460326",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "他们的负面情绪被强行从心智中隔离出来，游离在潜意识里，所以他们表现出来的只有「快乐」。",
            "nextDialogs": [
              "120460327"
            ]
          },
          "120460327": {
            "id": "120460327",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "但是，这些被压抑的情绪会在潜意识里持续发酵，最终变成了阿紫她们无法消化的噩梦。",
            "nextDialogs": [
              "120460328"
            ]
          },
          "120460328": {
            "id": "120460328",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么会这样？",
            "nextDialogs": [
              "120460329"
            ]
          },
          "120460329": {
            "id": "120460329",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "恐怕那个「江村一玄斋」没有我们想象的那么简单，或许他真的有能力影响到人类的情绪，所以那些人一直没有识破他…",
            "nextDialogs": [
              "120460330"
            ]
          },
          "120460330": {
            "id": "120460330",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "你们昨天来的时候，有注意到什么异样的事吗？",
            "nextDialogs": [
              "120460331"
            ]
          },
          "120460331": {
            "id": "120460331",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那时候这两个人还蛮正经的。",
            "nextDialogs": [
              "120460332"
            ]
          },
          "120460332": {
            "id": "120460332",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "非要说的话…",
            "nextDialogs": [
              "120460333"
            ]
          },
          "120460333": {
            "id": "120460333",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "你想起了昨天那个古怪的梦，将它描述给瑞希听。",
            "nextDialogs": [
              "120460334"
            ]
          },
          "120460334": {
            "id": "120460334",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还发生过这种事？",
            "nextDialogs": [
              "120460335"
            ]
          },
          "120460335": {
            "id": "120460335",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "当时不太在意。",
            "nextDialogs": [
              "120460336"
            ]
          },
          "120460336": {
            "id": "120460336",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "难道…我们必须尽快找到这个「江村一玄斋」！",
            "nextDialogs": [
              "120460337"
            ]
          },
          "120460337": {
            "id": "120460337",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "瑞希，怎么突然…",
            "nextDialogs": [
              "120460338"
            ]
          },
          "120460338": {
            "id": "120460338",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "我现在能确认那个「江村一玄斋」不是普通人类，那些接受过「指导」的人，都是他的受害者。",
            "nextDialogs": [
              "120460339"
            ]
          },
          "120460339": {
            "id": "120460339",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "如果不能及时解决作为源头的「江村一玄斋」，这些受害者的人格都会受到不可逆的损害。",
            "nextDialogs": [
              "120460340"
            ]
          },
          "120460340": {
            "id": "120460340",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "天呐…那也只能再问问这两个人了，请问你们知道「江村一玄斋」什么时候来这里吗？",
            "nextDialogs": [
              "120460341"
            ]
          },
          "120460341": {
            "id": "120460341",
            "speakerId": 15037,
            "speakerName": "薄田",
            "text": "怎么突然又这么急？什么时候来有关系吗？",
            "nextDialogs": [
              "120460342"
            ]
          },
          "120460342": {
            "id": "120460342",
            "speakerId": 15038,
            "speakerName": "海彦",
            "text": "什么时候来都行，哈哈…",
            "nextDialogs": [
              "120460343"
            ]
          },
          "120460343": {
            "id": "120460343",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "气死我了！",
            "nextDialogs": [
              "120460344"
            ]
          },
          "120460344": {
            "id": "120460344",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "其实你们记得昨晚发生的事吧？",
            "nextDialogs": [
              "120460345"
            ]
          },
          "120460345": {
            "id": "120460345",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "你们不愿提起，是因为昨晚困扰你们的噩梦与你们现在的「快乐」是如此格格不入。",
            "nextDialogs": [
              "120460346"
            ]
          },
          "120460346": {
            "id": "120460346",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "只要稍微回想一下，就有一种无法言明的割裂感，几乎要撕开你们的心智，对吗？",
            "nextDialogs": [
              "120460347"
            ]
          },
          "120460347": {
            "id": "120460347",
            "speakerId": 15038,
            "speakerName": "海彦",
            "text": "…请不要再说了。只要不去想，一切都还好…",
            "nextDialogs": [
              "120460348"
            ]
          },
          "120460348": {
            "id": "120460348",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "这就是「江村一玄斋」在你们身上留下的隐患，但我现在无意强行纠正你们的自我欺骗。",
            "nextDialogs": [
              "120460349"
            ]
          },
          "120460349": {
            "id": "120460349",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "只要你们能好好回答刚才的问题。",
            "nextDialogs": [
              "120460350"
            ]
          },
          "120460350": {
            "id": "120460350",
            "speakerId": 15037,
            "speakerName": "薄田",
            "text": "好吧…但是我们真的不知道，刚刚我们问过了，只知道他今天不会来。",
            "nextDialogs": [
              "120460351"
            ]
          },
          "120460351": {
            "id": "120460351",
            "speakerId": 15038,
            "speakerName": "海彦",
            "text": "对，好像是因为昨天太累了？",
            "nextDialogs": [
              "120460352"
            ]
          },
          "120460352": {
            "id": "120460352",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "又在故意避开我吗？",
            "nextDialogs": [
              "120460353"
            ]
          },
          "120460353": {
            "id": "120460353",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道最后还是问不出有用的东西吗？",
            "nextDialogs": [
              "120460354"
            ]
          },
          "120460354": {
            "id": "120460354",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "你们打听过那个「江村一玄斋」住在哪里吗？",
            "nextDialogs": [
              "120460355"
            ]
          },
          "120460355": {
            "id": "120460355",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "昨天专门问过，帮他把门的人也不知道。",
            "nextDialogs": [
              "120460356"
            ]
          },
          "120460356": {
            "id": "120460356",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "这样的话…",
            "nextDialogs": [
              "120460359"
            ]
          },
          "120460359": {
            "id": "120460359",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "现在的话，我了解了那两个人的噩梦，确实可以治好阿紫和白音。"
          }
        }
      }
    },
    {
      "subId": "1204604",
      "subQuestName": "前往鸣神大社寻找神子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120460401"
        ],
        "dialogs": {
          "120460401": {
            "id": "120460401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神子平时应该在这里吧？",
            "nextDialogs": [
              "120460402"
            ]
          },
          "120460402": {
            "id": "120460402",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "小家伙们，求签，还是访友？",
            "nextDialogs": [
              "120460403"
            ]
          },
          "120460403": {
            "id": "120460403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！什么时候…",
            "nextDialogs": [
              "120460404"
            ]
          },
          "120460404": {
            "id": "120460404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好久不见，宫司大人。",
            "nextDialogs": [
              "120460405"
            ]
          },
          "120460405": {
            "id": "120460405",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "这语气怎么有点像我那个老朋友…不要客套了，看你们的样子，有急事吧？",
            "nextDialogs": [
              "120460408"
            ]
          },
          "120460408": {
            "id": "120460408",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "我昨天的提示那么明显，你们还没找到人？",
            "nextDialogs": [
              "120460409"
            ]
          },
          "120460409": {
            "id": "120460409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你昨天果然是故意那么说的？",
            "nextDialogs": [
              "120460410"
            ]
          },
          "120460410": {
            "id": "120460410",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "…先别管这个，既然来求人帮忙，至少先向我说明下情况吧？",
            "nextDialogs": [
              "120460411"
            ]
          },
          "120460411": {
            "id": "120460411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，我们昨天去过那个地址，可惜没有抓住机会。",
            "nextDialogs": [
              "120460412"
            ]
          },
          "120460412": {
            "id": "120460412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在那个家伙已经不在那里露面了，据说是在避世清修，我们根本不知道去哪里找…",
            "nextDialogs": [
              "120460413"
            ]
          },
          "120460413": {
            "id": "120460413",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "唉…明明找到昨天那个地址就已经很不容易了。",
            "nextDialogs": [
              "120460414"
            ]
          },
          "120460414": {
            "id": "120460414",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果需要的话，我们这边也有些新的情报。那个「江村一玄斋」可能是瑞希接待过的一名客人，我记得是叫江村中弥来着…",
            "nextDialogs": [
              "120460415"
            ]
          },
          "120460415": {
            "id": "120460415",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "哈？那个家伙？",
            "nextDialogs": [
              "120460416"
            ]
          },
          "120460416": {
            "id": "120460416",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神子知道？",
            "nextDialogs": [
              "120460417"
            ]
          },
          "120460417": {
            "id": "120460417",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "我让八重堂举办那次读者来信活动，本来是想找同好聊一些有趣的事情，结果这个家伙蹦了出来…",
            "nextDialogs": [
              "120460418"
            ]
          },
          "120460418": {
            "id": "120460418",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "传播烦恼的家伙和消除烦恼的大师，也能是同一个人？",
            "nextDialogs": [
              "120460419"
            ]
          },
          "120460419": {
            "id": "120460419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "从我们之前的调查来看，确实有这种可能性。",
            "nextDialogs": [
              "120460420"
            ]
          },
          "120460420": {
            "id": "120460420",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "好吧，如果你们想找这个人，可以去这个地址试试。",
            "nextDialogs": [
              "120460421"
            ]
          },
          "120460421": {
            "id": "120460421",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个地址…这真是住人的地方吗？",
            "nextDialogs": [
              "120460422"
            ]
          },
          "120460422": {
            "id": "120460422",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "他曾经在八重堂一口气订购了几十本小说，然后留了这个收货地址，还要求到付。",
            "nextDialogs": [
              "120460423"
            ]
          },
          "120460423": {
            "id": "120460423",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "仓库那边以为是恶作剧，就拒绝了这个订单，结果这件事还被他在那封读者来信中专门骂了一遍。",
            "nextDialogs": [
              "120460424"
            ]
          },
          "120460424": {
            "id": "120460424",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "现在想想，这种性格的家伙，还真就只能住在那种地方。",
            "nextDialogs": [
              "120460425"
            ]
          },
          "120460425": {
            "id": "120460425",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实…来找神子果然没错！",
            "nextDialogs": [
              "120460426"
            ]
          },
          "120460426": {
            "id": "120460426",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "能帮上我那个老朋友就好。",
            "nextDialogs": [
              "120460427"
            ]
          },
          "120460427": {
            "id": "120460427",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以你还是想帮她的吧？",
            "nextDialogs": [
              "120460428"
            ]
          },
          "120460428": {
            "id": "120460428",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "我看得出来瑞希对秋沙钱汤这份产业的投入很大，现在秋沙钱汤遇到了困难，我作为朋友自然要关心一下。",
            "nextDialogs": [
              "120460429"
            ]
          },
          "120460429": {
            "id": "120460429",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看你昨天的样子，我还以为你是去吵架的…",
            "nextDialogs": [
              "120460430"
            ]
          },
          "120460430": {
            "id": "120460430",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "瑞希应该和你们说过，我和她之间存在竞争关系吧？",
            "nextDialogs": [
              "120460431"
            ]
          },
          "120460431": {
            "id": "120460431",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "从同窗时期开始，她就一直这么认为。现在我是鸣神大社的宫司，她肯定也想通过秋沙钱汤证明自己。",
            "nextDialogs": [
              "120460432"
            ]
          },
          "120460432": {
            "id": "120460432",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "要是这种生死攸关的经营问题都必须靠我帮忙解决…我总该考虑一下老朋友的心情。",
            "nextDialogs": [
              "120460433"
            ]
          },
          "120460433": {
            "id": "120460433",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难得见你这么体贴。",
            "nextDialogs": [
              "120460434"
            ]
          },
          "120460434": {
            "id": "120460434",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "就当你是在夸我吧。我这个老朋友习惯了体贴别人，也总该有人来体贴她一下。"
          }
        }
      }
    },
    {

    {
      "subId": "1905517",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190551701"
        ],
        "dialogs": {
          "190551701": {
            "id": "190551701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她去见了那位神子大人。",
            "nextDialogs": [
              "190551702"
            ]
          },
          "190551702": {
            "id": "190551702",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "没错。",
            "nextDialogs": [
              "190551802"
            ]
          },
          "190551802": {
            "id": "190551802",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "她去勘定奉行府见了那位神子大人，名义上是轻小说的鉴赏会，但会晤还有其他内容，虽然没有公开…",
            "nextDialogs": [
              "190551803"
            ]
          },
          "190551803": {
            "id": "190551803",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "在她回来以后，我们就开始了提振商贸的措施，而鸣神岛那边，很快也有了新商品法案的推动…",
            "nextDialogs": [
              "190551804"
            ]
          },
          "190551804": {
            "id": "190551804",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "所以，你们觉得珊瑚宫大人知道这件事吗？"
          }
        }
      }
    },

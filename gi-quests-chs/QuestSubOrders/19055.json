        "dialogs": {
          "190551401": {
            "id": "190551401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个箱子装得好紧，让我看看里面有什么…",
            "nextDialogs": [
              "190551402"
            ]
          },
          "190551402": {
            "id": "190551402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？这些花花草草是什么呀？不认识…哦，还有一张小纸条。",
            "nextDialogs": [
              "190551403"
            ]
          },
          "190551403": {
            "id": "190551403",
            "speakerId": 1006,
            "speakerName": "破损的账单",
            "text": "（一张破损的账单，字迹已经被水渍晕开，很难辨识，只能依稀看见落款处的「外行商会」几字。）"
          }
        }
      }
    },
    {

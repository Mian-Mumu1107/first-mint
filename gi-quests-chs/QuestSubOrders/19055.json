  "subQuests": [
    {
      "subId": "1905516",
      "subQuestName": "等到晚上（20点~24点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190551601"
        ],
        "dialogs": {
          "190551601": {
            "id": "190551601",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "#{NICKNAME}，再次向你道歉，我没有对你说实话，真的很过意不去，但我…不得不这么做。",
            "nextDialogs": [
              "190551602"
            ]
          },
          "190551602": {
            "id": "190551602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我理解。",
            "nextDialogs": [
              "190551603"
            ]
          },
          "190551603": {
            "id": "190551603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对了，心海知道这事吗？",
            "nextDialogs": [
              "190551604"
            ]
          },
          "190551604": {
            "id": "190551604",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "珊瑚宫大人么…只能说，战争带来了很多糟糕的东西，也让我们成长了很多。",
            "nextDialogs": [
              "190551605"
            ]
          },
          "190551605": {
            "id": "190551605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那到底是知道还是不知道啊？",
            "nextDialogs": [
              "190551606"
            ]
          },
          "190551606": {
            "id": "190551606",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "这…你们不好奇，是谁推动的新商品法案吗？不可能是勘定奉行，这对他们没有直接好处，我们也没有熟人在那边。",
            "nextDialogs": [
              "190551607"
            ]
          },
          "190551607": {
            "id": "190551607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦，这样说起来，就好像是神明的援手一样，突然帮了你们一把。",
            "nextDialogs": [
              "190551608"
            ]
          },
          "190551608": {
            "id": "190551608",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "哈哈，神明吗…",
            "nextDialogs": [
              "190551609"
            ]
          },
          "190551609": {
            "id": "190551609",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "前一阵子鸣神岛那边举办了容彩祭，我和珊瑚宫大人也应邀前去参加了。",
            "nextDialogs": [
              "190551610"
            ]
          },
          "190551610": {
            "id": "190551610",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "那时我在集市等待，而珊瑚宫大人去了…"
          }
        }
      }
    },
    {
      "subId": "1905501",
      "subQuestName": "前往望泷村",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190550901"
        ],
        "dialogs": {
          "190550901": {
            "id": "190550901",
            "speakerId": 12055,
            "speakerName": "德田",
            "text": "轰大叔，货已经到了，请来清点一下。",
            "nextDialogs": [
              "190550902"
            ]
          },
          "190550902": {
            "id": "190550902",
            "speakerId": 12551,
            "speakerName": "轰大叔",
            "text": "嗯，走吧。",
            "nextDialogs": [
              "190550903"
            ]
          },
          "190550903": {
            "id": "190550903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "轰…唔!",
            "nextDialogs": [
              "190550904"
            ]
          },
          "190550904": {
            "id": "190550904",
            "speakerId": 1057,
            "speakerName": "鹿野院平藏",
            "text": "嘘！别出声，我们偷偷跟上去。"
          }
        }
      }
    },
    {
      "subId": "1905503",
      "subQuestName": "跟踪轰大叔与德田",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1905504",
      "subQuestName": "偷听轰大叔与德田的谈话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190551001"
        ],
        "dialogs": {
          "190551001": {
            "id": "190551001",
            "speakerId": 12055,
            "speakerName": "德田",
            "text": "大叔的情报很准确啊，我们到的时候，那伙野伏众居然还在睡大觉，哈哈。",
            "nextDialogs": [
              "190551002"
            ]
          },
          "190551002": {
            "id": "190551002",
            "speakerId": 12055,
            "speakerName": "德田",
            "text": "被我们一网打尽，货物也全部收缴回来了，都在这了。",
            "nextDialogs": [
              "190551003"
            ]
          },
          "190551003": {
            "id": "190551003",
            "speakerId": 12551,
            "speakerName": "轰大叔",
            "text": "我来清点…嗯…都没问题，辛苦了。",
            "nextDialogs": [
              "190551004"
            ]
          },
          "190551004": {
            "id": "190551004",
            "speakerId": 12055,
            "speakerName": "德田",
            "text": "哪里的话，多亏了轰大叔的商队去努力贸易，村里粮食的价格才能降下来。",
            "nextDialogs": [
              "190551005"
            ]
          },
          "190551005": {
            "id": "190551005",
            "speakerId": 12056,
            "speakerName": "将司",
            "text": "就是就是，还有我们这些老伤号，谁会想到打仗留下的后遗症这么厉害啊，幸好有轰大叔带回来的救命药。",
            "nextDialogs": [
              "190551006"
            ]
          },
          "190551006": {
            "id": "190551006",
            "speakerId": 12551,
            "speakerName": "轰大叔",
            "text": "要多谢上面的支持，所以情况才会变好。村里的库存情况怎么样？",
            "nextDialogs": [
              "190551007"
            ]
          },
          "190551007": {
            "id": "190551007",
            "speakerId": 12551,
            "speakerName": "轰大叔",
            "text": "今晚就要确认，明天一早，我去珊瑚宫请示五郎大人后，就得出发了。",
            "nextDialogs": [
              "190551008"
            ]
          },
          "190551008": {
            "id": "190551008",
            "speakerId": 12056,
            "speakerName": "将司",
            "text": "放心，轰大叔，我们把清单都整理好了，跟我们来吧。"
          }
        }
      }
    },
    {
      "subId": "1905514",
      "subQuestName": "",
      "sceneId": null,

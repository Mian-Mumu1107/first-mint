            "speakerId": 2409,
            "speakerName": "梵米尔",
            "text": "下次要多带点画材过来了…",
            "nextDialogs": [
              "710060902"
            ]
          },
          "710060902": {
            "id": "710060902",
            "speakerId": 2409,
            "speakerName": "梵米尔",
            "text": "唔，或者说…我记个备忘录更好…"

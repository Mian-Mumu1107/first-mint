    },
    {
      "subId": "7100610",
      "subQuestName": "解开渌华池的秘密",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710061001"
        ],
        "dialogs": {
          "710061001": {
            "id": "710061001",
            "speakerId": 2409,
            "speakerName": "梵米尔",
            "text": "原来…原来是这样！这两颗石头真的是这两尊雕像的眼睛！只有把石头嵌进去，他们的眼睛才会发光…",
            "nextDialogs": [
              "710061002"
            ]
          },
          "710061002": {
            "id": "710061002",
            "speakerId": 2409,
            "speakerName": "梵米尔",
            "text": "我一定能画出一副好画，我要去找个好位置画画了！谢谢你！",
            "nextDialogs": [
              "710061003"
            ]
          },
          "710061003": {
            "id": "710061003",
            "speakerId": 2409,
            "speakerName": "梵米尔",
            "text": "太好了，太好了…"
          }
        }
      }
    },

    {
      "subId": "7100607",
      "subQuestName": "寻找另一块奇怪的石头",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710060701"
        ],
        "dialogs": {
          "710060701": {
            "id": "710060701",
            "speakerId": 2409,
            "speakerName": "梵米尔",
            "text": "唉，到底怎样才能取到那个景呢…",
            "nextDialogs": [
              "710060702"
            ]
          },
          "710060702": {
            "id": "710060702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于那个石头…",
            "nextDialogs": [
              "710060703"
            ]
          },
          "710060703": {
            "id": "710060703",
            "speakerId": 2409,
            "speakerName": "梵米尔",
            "text": "那个石头？你怎么突然对这个感兴趣…",
            "nextDialogs": [
              "710060704"
            ]
          },
          "710060704": {
            "id": "710060704",
            "speakerId": 2409,
            "speakerName": "梵米尔",
            "text": "我是在<color=#00E1FFFF>渌华池里</color>取景的时候捡到的。",
            "nextDialogs": [
              "710060705"
            ]
          },
          "710060705": {
            "id": "710060705",
            "speakerId": 2409,
            "speakerName": "梵米尔",
            "text": "怎么，你也要去<color=#00E1FFFF>渌华池里</color>找找吗？",
            "nextDialogs": [
              "710060706"
            ]
          },
          "710060706": {
            "id": "710060706",
            "speakerId": 2409,
            "speakerName": "梵米尔",
            "text": "那你可得找仔细一点了，那个池子里乱七八糟的东西可多了，也不知道是谁丢在里面的…"
          }
        }
      }
    },

    {
      "subId": "7001015",
      "subQuestName": "向塞琉斯回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700100601"
        ],
        "dialogs": {
          "700100601": {
            "id": "700100601",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "怎么样，你已经问过大家的意见了吗？",
            "nextDialogs": [
              "700100602"
            ]
          },
          "700100602": {
            "id": "700100602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "问到了。",
            "nextDialogs": [
              "700100603"
            ]
          },
          "700100603": {
            "id": "700100603",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "你看我说什么来着…总之情况就是这么个情况，我早就习惯了。",
            "nextDialogs": [
              "700100604"
            ]
          },
          "700100604": {
            "id": "700100604",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "唉，不管是什么方法，只要能够奏效我就谢天谢地了。",
            "nextDialogs": [
              "700100605"
            ]
          },
          "700100605": {
            "id": "700100605",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "你等会是要回去雪山那边，向玉霞回报委托的情况吧？",
            "nextDialogs": [
              "700100606"
            ]
          },
          "700100606": {
            "id": "700100606",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "那你顺便帮我把这封信带给她吧，她肯定也想知道协会最近的情况，拜托你了。",
            "nextDialogs": [
              "700100607"
            ]
          },
          "700100607": {
            "id": "700100607",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "唉，希望这次能招到新人…不过这样子招过来的新人，真的能成为靠谱的冒险家吗…"
          }
        }
      }
    },
    {
      "subId": "7001002",
      "subQuestName": "向玉霞回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700100701"
        ],
        "dialogs": {
          "700100701": {
            "id": "700100701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于委托…",
            "nextDialogs": [
              "700100702"
            ]
          },
          "700100702": {
            "id": "700100702",
            "speakerId": 1665,
            "speakerName": "玉霞",
            "text": "你回来了，怎么去了这么久，是不是那小子又让你去做什么多余的事了？",
            "nextDialogs": [
              "700100703"
            ]
          },
          "700100703": {
            "id": "700100703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "帮塞琉斯先生打听了一下消息…",
            "nextDialogs": [
              "700100704"
            ]
          },
          "700100704": {
            "id": "700100704",
            "speakerId": 1665,
            "speakerName": "玉霞",
            "text": "这小子又在搞什么…嗯？这封信是？",
            "nextDialogs": [
              "700100705"
            ]
          },
          "700100705": {
            "id": "700100705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这封信里写着协会的近况。",
            "nextDialogs": [
              "700100706"
            ]
          },
          "700100706": {
            "id": "700100706",
            "speakerId": 1665,
            "speakerName": "玉霞",
            "text": "我知道了。居然这么厚，看来…他确实做了很多事，居然风花节也没休息…",
            "nextDialogs": [
              "700100707"
            ]
          },
          "700100707": {
            "id": "700100707",
            "speakerId": 1665,
            "speakerName": "玉霞",
            "text": "不过，既然他都这么努力了，蒙德城冒险家协会肯定能招到很多新人吧。",
            "nextDialogs": [
              "700100708"
            ]
          },
          "700100708": {
            "id": "700100708",
            "speakerId": 1665,
            "speakerName": "玉霞",
            "text": "等有了足够的新人，那小子说不定也能从那些琐事里抽身，再次和我一起去探险了…嗯，这样也挺不错的。",
            "nextDialogs": [
              "700100709"
            ]
          },
          "700100709": {
            "id": "700100709",
            "speakerId": 1665,
            "speakerName": "玉霞",
            "text": "我会好好看这封信的。但你被那小子差使了多余的事，我也得给你多算点报酬才是。",
            "nextDialogs": [
              "700100710"
            ]
          },
          "700100710": {
            "id": "700100710",
            "speakerId": 1665,
            "speakerName": "玉霞",
            "text": "这是报酬，收下吧，这一趟辛苦你了。"
          }
        }
      }
    },

    {
      "subId": "7620204",
      "subQuestName": "探索房间内部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762020301"
        ],
        "dialogs": {
          "762020301": {
            "id": "762020301",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "一阵风扑面而来。\\n真奇怪，它尝起来有双果卷、夏槲蛋糕、脆脆烤肉和花果草糖的味道。",
            "nextDialogs": [
              "762020302"
            ]
          },
          "762020302": {
            "id": "762020302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃！突然有一股好甜的风钻进喉咙里了，咳咳咳…咦？我们这是在哪里？茶壶和杯子看着好大…",
            "nextDialogs": [
              "762020303"
            ]
          },
          "762020303": {
            "id": "762020303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还是说…是我们变小了？！",
            "nextDialogs": [
              "762020304"
            ]
          },
          "762020304": {
            "id": "762020304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看起来像是尼可的魔法。",
            "nextDialogs": [
              "762020305"
            ]
          },
          "762020305": {
            "id": "762020305",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "很抱歉，我没能邀请对应的动物演员，我平时都是和石头演员打交道的…",
            "nextDialogs": [
              "762020306"
            ]
          },
          "762020306": {
            "id": "762020306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？尼可你也是小小的样子嘛，我还以为你也会变大。",
            "nextDialogs": [
              "762020307"
            ]
          },
          "762020307": {
            "id": "762020307",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "蹲下身也能做到顶天立地的巨大魔女尼可？不了不了，我对我现在的形态已经足够满意了。",
            "nextDialogs": [
              "762020308"
            ]
          },
          "762020308": {
            "id": "762020308",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "总之，欢迎加入伟大魔女的茶会时光！现在，添茶吧！"
          }
        }
      }
    },
    {
      "subId": "7620205",

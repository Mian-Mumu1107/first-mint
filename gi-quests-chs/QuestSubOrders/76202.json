    {
      "subId": "7620299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762029904"
        ],
        "dialogs": {
          "762029904": {
            "id": "762029904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢！又是这个光球，我们跟上去。",
            "nextDialogs": [
              "762029905"
            ]
          },
          "762029905": {
            "id": "762029905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "光球消失在门后了！也就是说，这扇门已经可以打开了对吧？",
            "nextDialogs": [
              "762029906"
            ]
          },
          "762029906": {
            "id": "762029906",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "…茶还是温的呢。嗯，真美味。",
            "nextDialogs": [
              "762029907"
            ]
          },
          "762029907": {
            "id": "762029907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你该不会是为了这个时刻才安排的这一出…",
            "nextDialogs": [
              "762029908"
            ]
          },
          "762029908": {
            "id": "762029908",
            "speakerId": 1322,
            "speakerName": "尼可",

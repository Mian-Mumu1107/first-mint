    {
      "subId": "7620214",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762021401"
        ],
        "dialogs": {
          "762021401": {
            "id": "762021401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "尼可，你在说些什么啊？",
            "nextDialogs": [
              "762021402"
            ]
          },
          "762021402": {
            "id": "762021402",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "#嗯？这点攻击不是不痛不痒嘛？正是{NICKNAME}表现的时候。",
            "nextDialogs": [
              "762021403"
            ]
          },
          "762021403": {
            "id": "762021403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎，哎，尼可你也帮帮忙啦！",
            "nextDialogs": [
              "762021404"
            ]
          },
          "762021404": {
            "id": "762021404",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "好吧，那就…「吾以己心代天心」！"
          }
        }
      }
    },
    {
      "subId": "7620216",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762021601"
        ],
        "dialogs": {
          "762021601": {
            "id": "762021601",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "如果可以的话，过段时间再来看看吧。我也要多去检查一下其他房间的设计…"
          }
        }
      }
    },

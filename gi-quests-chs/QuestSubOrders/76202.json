      }
    },
    {
      "subId": "7620206",
      "subQuestName": "探索房间内部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762020601"
        ],
        "dialogs": {
          "762020601": {
            "id": "762020601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "突然往下滑了一段，吓我一跳。欸，是个巨大的…曼陀草雕塑？",
            "nextDialogs": [
              "762020602"
            ]
          },
          "762020602": {
            "id": "762020602",
            "speakerId": 16015,
            "speakerName": "曼陀草",
            "text": "咯咯。",
            "nextDialogs": [
              "762020603"
            ]
          },
          "762020603": {
            "id": "762020603",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "稍等，不好意思，好像哪里出了点小差错。不应该啊…",
            "nextDialogs": [
              "762020604"
            ]
          },
          "762020604": {
            "id": "762020604",
            "speakerId": 16015,
            "speakerName": "曼陀草",
            "text": "咯——咯——",
            "nextDialogs": [
              "762020605"
            ]
          },
          "762020605": {
            "id": "762020605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它动起来了，好像是想要攻击我们！",
            "nextDialogs": [
              "762020606"
            ]
          },
          "762020606": {
            "id": "762020606",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "呼，这下对了…"
          }
        }
      }
    },

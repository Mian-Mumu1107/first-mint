    {
      "subId": "7620202",
      "subQuestName": "进入小屋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762020201"
        ],
        "dialogs": {
          "762020201": {
            "id": "762020201",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "欢迎光临。",
            "nextDialogs": [
              "762020204"
            ]
          },
          "762020204": {
            "id": "762020204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，好华丽气派的屋子，你装潢得很漂亮嘛！",
            "nextDialogs": [
              "762020205"
            ]
          },
          "762020205": {
            "id": "762020205",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "哼哼，真有眼光，不枉费我这些日子里虽然是抽空但也很用心做的设计。",
            "nextDialogs": [
              "762020206"
            ]
          },
          "762020206": {
            "id": "762020206",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "——具体就要从这座秘密小屋建成之日说起了。",
            "nextDialogs": [
              "762020207"
            ]
          },
          "762020207": {
            "id": "762020207",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "我本来想趁手感不错，多去修建几座魔女小屋，但没人帮忙提供新的灵感，久了又觉得没劲。",
            "nextDialogs": [
              "762020208"
            ]
          },
          "762020208": {
            "id": "762020208",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "「就没有既有趣又好玩，还能得到成就感的做法吗？」我的脑海中咻地闪过了答案。",
            "nextDialogs": [
              "762020209"
            ]
          },
          "762020209": {
            "id": "762020209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等下，直接到答案了吗？",
            "nextDialogs": [
              "762020210"
            ]
          },
          "762020210": {
            "id": "762020210",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "话不等人啊。喏，它就在你们的眼前。",
            "nextDialogs": [
              "762020211"
            ]
          },
          "762020211": {
            "id": "762020211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这扇门后？",
            "nextDialogs": [
              "762020212"
            ]
          },
          "762020212": {
            "id": "762020212",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "其实不止这扇门，但也不算错，总要有个先后顺序，那就从它开始吧，准备好了吗？",
            "nextDialogs": [
              "762020213"
            ]
          },
          "762020213": {
            "id": "762020213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等…等一下，你语速太快了，我有点跟不上来…你要我们准备什么？",
            "nextDialogs": [
              "762020214"
            ]
          },
          "762020214": {
            "id": "762020214",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "噢，别紧张，什么都不用你们准备。我就象征性地问一声。",
            "nextDialogs": [
              "762020215"
            ]
          },
          "762020215": {
            "id": "762020215",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "凭我的观察和对你们的了解…比起复杂的事先说明和解释，你们更喜欢在探索过程中挖掘乐趣吧？"
          }
        }
      }
    },
    {

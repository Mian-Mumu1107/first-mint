{
  "lineCounts": {
    "Player": 10,
    "夏沃蕾": 14,
    "恰斯卡": 11,
    "派蒙": 9,
    "蒂蕾娜": 5,
    "赫得蔚格": 13
  },
  "subQuests": [
    {
      "subId": "7668301",
      "subQuestName": "与夏沃蕾对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766830101"
        ],
        "dialogs": {
          "766830101": {
            "id": "766830101",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "…弹道终点的毁伤效果无可挑剔，散布水平也接近理想模型。",
            "nextDialogs": [
              "766830102"
            ]
          },
          "766830102": {
            "id": "766830102",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "恰斯卡小姐，按照执律庭武器部门的评估模型，你的武器完全达到了「火炮级」水准。",
            "nextDialogs": [
              "766830103"
            ]
          },
          "766830103": {
            "id": "766830103",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "只可惜，至少需要两个班组的人力，才能勉强在战场上部署您的「铳枪」，操作门槛太高了…",
            "nextDialogs": [
              "766830104"
            ]
          },
          "766830104": {
            "id": "766830104",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "谢谢你的认可，夏沃蕾警官。其实操作门槛过高也不是坏事，找希诺宁定做「灵枪·仪式杖」前，我们就达成了共识——",
            "nextDialogs": [
              "766830105"
            ]
          },
          "766830105": {
            "id": "766830105",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "「越是强大的武器，越需要严苛的使用标准。」",
            "nextDialogs": [
              "766830106"
            ]
          },
          "766830106": {
            "id": "766830106",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "除了武器本身的操作难度，我甚至认为，这类武器需要加上「道德认知锁」之类的机制。",
            "nextDialogs": [
              "766830107"
            ]
          },
          "766830107": {
            "id": "766830107",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "如此一来，才能保证武力被正确的人掌握，防止某种强力武器被不法之徒窃取后，造成巨大的危害。",
            "nextDialogs": [
              "766830108"
            ]
          },
          "766830108": {
            "id": "766830108",
            "speakerId": 30422,
            "speakerName": "蒂蕾娜",
            "text": "单论枫丹，偷取武器再进行犯罪的案例的确屡见不鲜，恰斯卡长官的担忧非常有道理。",
            "nextDialogs": [
              "766830109"
            ]
          },
          "766830109": {
            "id": "766830109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，好多老朋友！",
            "nextDialogs": [
              "766830110"
            ]
          },
          "766830110": {
            "id": "766830110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "枫丹的执律庭，纳塔「花羽会」…还有蒙德的骑士？大家聚在一起，是在干什么呢？",
            "nextDialogs": [
              "766830111"
            ]
          },
          "766830111": {
            "id": "766830111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "重开多方交流会？",
            "nextDialogs": [
              "766830112"
            ]
          },
          "766830112": {
            "id": "766830112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "又一场联合演习？",
            "nextDialogs": [
              "766830113"
            ]
          },
          "766830113": {
            "id": "766830113",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "#是的，{NICKNAME}一眼就理解了状况。",
            "nextDialogs": [
              "766830114"
            ]
          },
          "766830114": {
            "id": "766830114",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "此前，特巡队曾派蒂蕾娜前往璃月参加联合推演。以这场推演为契机，各国部队之间的交流频率不断提升。",
            "nextDialogs": [
              "766830115"
            ]
          },
          "766830115": {
            "id": "766830115",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "这次便是枫丹和蒙德例行的一场「射击推理大会」，旨在提升三方战士的战场规划能力。",
            "nextDialogs": [
              "766830116"
            ]
          },
          "766830116": {
            "id": "766830116",
            "speakerId": 30422,
            "speakerName": "蒂蕾娜",
            "text": "另外，多亏西风骑士团的朋友牵线搭桥，纳塔「花羽会」的勇士们也加入了推演。",
            "nextDialogs": [
              "766830117"
            ]
          },
          "766830117": {
            "id": "766830117",
            "speakerId": 30422,
            "speakerName": "蒂蕾娜",
            "text": "「花羽会」的勇士们擅长在飞行中射击，简直给我们打开了新世界的大门！",
            "nextDialogs": [
              "766830118"
            ]
          },
          "766830118": {
            "id": "766830118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…骑士们应该是在远征的过程中和纳塔勇士认识的吧？我早应该想到！",
            "nextDialogs": [
              "766830119"
            ]
          },
          "766830119": {
            "id": "766830119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，「射击推理大会」是怎么回事？每个词都明白，连在一起就有点迷惑…",
            "nextDialogs": [
              "766830120"
            ]
          },
          "766830120": {
            "id": "766830120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "射击不是开枪就完了吗？",
            "nextDialogs": [
              "766830121"
            ]
          },
          "766830121": {
            "id": "766830121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "子弹也能参加推演的吗？",
            "nextDialogs": [
              "766830122"
            ]
          },
          "766830122": {
            "id": "766830122",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "啊哈，如果人人都有无限的弹药，只需要一直压住扳机，就能轻松搞定大部分敌人了。",
            "nextDialogs": [
              "766830123"
            ]
          },
          "766830123": {
            "id": "766830123",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "但战斗是个漫长的过程，射手能携带的弹药很有限，每一枪都需要尽可能打准，打得更有策略。",
            "nextDialogs": [
              "766830124"
            ]
          },
          "766830124": {
            "id": "766830124",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "所以，骑士团研发出了一款新式榴弹，帮助射手提升自己的理解能力，原理有些复杂…",
            "nextDialogs": [
              "766830125"
            ]
          },
          "766830125": {
            "id": "766830125",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "至于具体的原理，就让西风骑士团的朋友简单说说吧。",
            "nextDialogs": [
              "766830126"
            ]
          },
          "766830126": {
            "id": "766830126",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "来了来了，失礼了！刚刚整理报告太认真，都没发现荣誉骑士和白色小帮手…向你们致以问候！",
            "nextDialogs": [
              "766830127"
            ]
          },
          "766830127": {
            "id": "766830127",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "我是赫得蔚格，西风骑士团「综务小队」的成员，负责这次推演记录事务，协调枪匠们与其他友军的工作…",
            "nextDialogs": [
              "766830128"
            ]
          },
          "766830128": {
            "id": "766830128",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "说起来，这次的机关还和你们有关呢，你们还记得达达乌帕谷曾出现过的神秘丘丘萨满雕像吗？",
            "nextDialogs": [
              "766830129"
            ]
          },
          "766830129": {
            "id": "766830129",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有点印象，很久以前的事。",
            "nextDialogs": [
              "766830130"
            ]
          },
          "766830130": {
            "id": "766830130",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不记得了，不过没关系吧？",
            "nextDialogs": [
              "766830131"
            ]
          },
          "766830131": {
            "id": "766830131",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "连我都没什么印象了，还是请赫得蔚格简单说说吧？",
            "nextDialogs": [
              "766830132"
            ]
          },
          "766830132": {
            "id": "766830132",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "嗯。古老的故事和零散的情报，我就先省略了——",
            "nextDialogs": [
              "766830133"
            ]
          },
          "766830133": {
            "id": "766830133",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "根据「调查小队」的判断，那是一位古老的丘丘萨满的产物，「分汤者」丘尔德里克改造了一处无人秘境，用于练习军阵。",
            "nextDialogs": [
              "766830134"
            ]
          },
          "766830134": {
            "id": "766830134",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "荣誉骑士当时击败了丘尔德里克的一道残影，使得秘境崩解，监督军阵的「乌帕诺之眼」散落而出。",
            "nextDialogs": [
              "766830135"
            ]
          },
          "766830135": {
            "id": "766830135",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "「支援小队」获得样本后，对其仔细拆解分析，用了大半年时间吃透了其中的技术，结合了璃月「俯瞰机关」的设计…",
            "nextDialogs": [
              "766830136"
            ]
          },
          "766830136": {
            "id": "766830136",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "从而制作了一种可视化的「观测榴弹」，打算用于远程侦察，保证射手在安全的位置获得信息。",
            "nextDialogs": [
              "766830137"
            ]
          },
          "766830137": {
            "id": "766830137",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "过程未免太曲折了…没想到我们不怎么上心就搞定的家伙，留下了这种神秘宝物！",
            "nextDialogs": [
              "766830138"
            ]
          },
          "766830138": {
            "id": "766830138",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "就结果而言，在推演中，「观测榴弹」能让射手们看到弹头飞行过程中的景象，加深对弹道和障碍物的理解…",
            "nextDialogs": [
              "766830139"
            ]
          },
          "766830139": {
            "id": "766830139",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "结合射击训练后的复盘会，「推理」更好的射击角度，优化目标分配的次序，大大提升作战效率。",
            "nextDialogs": [
              "766830140"
            ]
          },
          "766830140": {
            "id": "766830140",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "对于「花羽会」这边，龙骑士们骑乘绒翼龙战斗的难题之一，就是确认命中的效果。毕竟飞在天上，目标太远…",
            "nextDialogs": [
              "766830141"
            ]
          },
          "766830141": {
            "id": "766830141",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "有了这种「观测榴弹」，也能更加高效地进行「毁伤评估」…这个词是从特巡队学到的，非常精确的概念。",
            "nextDialogs": [
              "766830144"
            ]
          },
          "766830144": {
            "id": "766830144",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "目前，参与推演的人员已经完成了夏沃蕾和恰斯卡两位队长的所有想定。",
            "nextDialogs": [
              "766830145"
            ]
          },
          "766830145": {
            "id": "766830145",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "距离完美完成「推理大会」，只差扩充战例样本了…",
            "nextDialogs": [
              "766830146"
            ]
          },
          "766830146": {
            "id": "766830146",
            "speakerId": 30977,
            "speakerName": "赫得蔚格",
            "text": "既然荣誉骑士也在，要不要来试试看？",
            "nextDialogs": [
              "766830147"
            ]
          },
          "766830147": {
            "id": "766830147",
            "speakerId": 30422,
            "speakerName": "蒂蕾娜",
            "text": "我举双手支持！",
            "nextDialogs": [
              "766830148"
            ]
          },
          "766830148": {
            "id": "766830148",
            "speakerId": 30422,
            "speakerName": "蒂蕾娜",
            "text": "#「千灵映影节」的时候，我就发现了，{NICKNAME}是准度和灵感双双满分的射手。",
            "nextDialogs": [
              "766830149"
            ]
          },
          "766830149": {
            "id": "766830149",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "嗯，确实非常合适。",
            "nextDialogs": [
              "766830150"
            ]
          },
          "766830150": {
            "id": "766830150",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "#从我个人的角度出发，我很好奇，这些年来，{NICKNAME}的射术进步到了什么等级。",
            "nextDialogs": [
              "766830151"
            ]
          },
          "766830151": {
            "id": "766830151",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "#从演练全局的角度，{NICKNAME}对「观测榴弹」的机制完全陌生，也正好为我们引入漂亮的对照组。",
            "nextDialogs": [
              "766830152"
            ]
          },
          "766830152": {
            "id": "766830152",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我怎么觉得，抛开别的不说，「观测榴弹」本身的诞生，还和我们…挺有缘的？",
            "nextDialogs": [
              "766830153"
            ]
          },
          "766830153": {
            "id": "766830153",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "体验一下它的神奇效果，好像也挺有意思的？"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7351201",
      "subQuestName": "与维纳亚克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735120101"
        ],
        "dialogs": {
          "735120101": {
            "id": "735120101",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "哦哦，感谢你！勇敢的冒险家啊！",
            "nextDialogs": [
              "735120102"
            ]
          },
          "735120102": {
            "id": "735120102",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "还好还好，没过多长时间，零件还没怎么被糟蹋…只要再修整一下…",
            "nextDialogs": [
              "735120103"
            ]
          },
          "735120103": {
            "id": "735120103",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "维纳亚克开始埋头鼓捣机械…",
            "nextDialogs": [
              "735120104"
            ]
          },
          "735120104": {
            "id": "735120104",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "…维纳亚克？",
            "nextDialogs": [
              "735120105"
            ]
          },
          "735120105": {
            "id": "735120105",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "嗯嗯，快了快了！马上就好！",
            "nextDialogs": [
              "735120106"
            ]
          },
          "735120106": {
            "id": "735120106",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "——维、纳、亚、克！",
            "nextDialogs": [
              "735120107"
            ]
          },
          "735120107": {
            "id": "735120107",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "呜哇！施芮娅？你是什么时候来的？",
            "nextDialogs": [
              "735120108"
            ]
          },
          "735120108": {
            "id": "735120108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就在你摆弄零件的时候…",
            "nextDialogs": [
              "735120109"
            ]
          },
          "735120109": {
            "id": "735120109",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "你不是说，这里有魔物，很危险吗？怎么连你自己也过来了？",
            "nextDialogs": [
              "735120110"
            ]
          },
          "735120110": {
            "id": "735120110",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "…我只是在担心我们的零件而已，免得到时候交不上差，连我都回不了教令院！",
            "nextDialogs": [
              "735120111"
            ]
          },
          "735120111": {
            "id": "735120111",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "哈，我就说嘛——你看，全都收集完了，等回去做完进一步的调试，就能开始组装了。",
            "nextDialogs": [
              "735120112"
            ]
          },
          "735120112": {
            "id": "735120112",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "话说，这些都是什么的零件呀？",
            "nextDialogs": [
              "735120113"
            ]
          },
          "735120113": {
            "id": "735120113",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "啊，忘了向你们介绍了——这是「对沙虫用杀虫炮」，我们当年的毕业设计项目！",
            "nextDialogs": [
              "735120114"
            ]
          },
          "735120114": {
            "id": "735120114",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "——为什么会有这么偏门的选题啊！",
            "nextDialogs": [
              "735120115"
            ]
          },
          "735120115": {
            "id": "735120115",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "你要是也为了毕业开过题，就知道为什么了…咳，总之这些不重要。",
            "nextDialogs": [
              "735120116"
            ]
          },
          "735120116": {
            "id": "735120116",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "正式自我介绍一下，我是从阿弥利多学院毕业的学者施芮娅，主修沙漠生物学与环境学。",
            "nextDialogs": [
              "735120117"
            ]
          },
          "735120117": {
            "id": "735120117",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "…这边这个机械笨蛋是刹诃伐罗学院的，主修的是应用机关术。",
            "nextDialogs": [
              "735120118"
            ]
          },
          "735120118": {
            "id": "735120118",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "——我叫维纳亚克，之前真是多谢啦。",
            "nextDialogs": [
              "735120119"
            ]
          },
          "735120119": {
            "id": "735120119",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "学的方向完全不同欸…这也能合作起来吗？",
            "nextDialogs": [
              "735120120"
            ]
          },
          "735120120": {
            "id": "735120120",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "别提了…当初为了成功开题跟这家伙合作做毕设，绝对是我在学生时代犯的最大错误…",
            "nextDialogs": [
              "735120121"
            ]
          },
          "735120121": {
            "id": "735120121",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "也不能这么说吧，你看我们俩不还是照样毕业了？",
            "nextDialogs": [
              "735120122"
            ]
          },
          "735120122": {
            "id": "735120122",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "是啊！你算算看比同届入学的人晚了多少年？",
            "nextDialogs": [
              "735120123"
            ]
          },
          "735120123": {
            "id": "735120123",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "那好歹也算毕业了吧？我听说有些人去年才过的开题呢。",
            "nextDialogs": [
              "735120124"
            ]
          },
          "735120124": {
            "id": "735120124",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "啊啊…够了！这种无意义的争论留在学生时代就够了！",
            "nextDialogs": [
              "735120125"
            ]
          },
          "735120125": {
            "id": "735120125",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "可每次不都是你先开始的吗…",
            "nextDialogs": [
              "735120126"
            ]
          },
          "735120126": {
            "id": "735120126",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "哪有？就说我们第一次造原型机的时候…",
            "nextDialogs": [
              "735120129"
            ]
          },
          "735120129": {
            "id": "735120129",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "唔…关系好差，教令院怎么会想到派你们俩来处理这件事啊…",
            "nextDialogs": [
              "735120130"
            ]
          },
          "735120130": {
            "id": "735120130",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "唉，倒也不能说是教令院让我们来的…其实这事本来是由我们院的库纳尔全权负责。",
            "nextDialogs": [
              "735120160"
            ]
          },
          "735120160": {
            "id": "735120160",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "他算是我导师的导师吧，当初我们毕业答辩的时候也有来旁听。",
            "nextDialogs": [
              "735120161"
            ]
          },
          "735120161": {
            "id": "735120161",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "大概就是那时候，给他留下了「院里的年轻人做过什么沙虫炮」的印象。",
            "nextDialogs": [
              "735120162"
            ]
          },
          "735120162": {
            "id": "735120162",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "所以这次，他说着什么「要多让年轻人发光发热！」然后硬是把我们抓到一起，派来解决这件事。",
            "nextDialogs": [
              "735120163"
            ]
          },
          "735120163": {
            "id": "735120163",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "明明我们毕业之后就没怎么来往了…",
            "nextDialogs": [
              "735120131"
            ]
          },
          "735120131": {
            "id": "735120131",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "就连我的导师也被他说动了…咳，不过借这机会，我才能让这门「对沙虫用杀虫炮」重见天日！",
            "nextDialogs": [
              "735120132"
            ]
          },
          "735120132": {
            "id": "735120132",
            "speakerId": 1000,
            "speakerName": "维纳亚克",
            "text": "——等到组装完成，就能让那些虫子见识一下它的厉害了！",
            "nextDialogs": [
              "735120133"
            ]
          },
          "735120133": {
            "id": "735120133",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "这个机械笨蛋又开始了…不过从我的角度来说，也想研究一下这些沙虫作乱的原因，维护沙漠的生态平衡。",
            "nextDialogs": [
              "735120134"
            ]
          },
          "735120134": {
            "id": "735120134",
            "speakerId": 1002,
            "speakerName": "施芮娅",
            "text": "#冒险家{M#先生}{F#小姐}，您的身手看起来很不错。请问在我们留居沙漠的这段时间里，能聘请您来保护我们的安全吗？"
          }
        }
      }
    }
  ]
}
    {
      "subId": "4014407",
      "subQuestName": "尝试培育药材",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440701"
        ],
        "dialogs": {
          "401440701": {
            "id": "401440701",
            "speakerId": 1002,
            "speakerName": "芙里达",
            "text": "#荣誉骑士{NICKNAME}，和{F#她}{M#他}的侍从派蒙，你们好呀！后勤小队骑士芙里达，向你们致以问候！",
            "nextDialogs": [
              "401440702"
            ]
          },
          "401440702": {
            "id": "401440702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哇，我的大名已经远近皆知了吗。不过侍从是什么啦，我是{F#她}{M#他}的伙伴才对！",
            "nextDialogs": [
              "401440703"
            ]
          },
          "401440703": {
            "id": "401440703",
            "speakerId": 1002,
            "speakerName": "芙里达",
            "text": "哦，抱歉，不小心就沿用了流行小说的用法。",
            "nextDialogs": [
              "401440704"
            ]
          },
          "401440704": {
            "id": "401440704",
            "speakerId": 1002,
            "speakerName": "芙里达",
            "text": "你们的事迹可以说是传说一般的存在，真是令人羡慕…",
            "nextDialogs": [
              "401440705"
            ]
          },
          "401440705": {
            "id": "401440705",
            "speakerId": 1002,
            "speakerName": "芙里达",
            "text": "我也想成为四处冒险的游侠骑士，这样的生活一定很有趣吧。",
            "nextDialogs": [
              "401440707",
              "401440709"
            ]
          },
          "401440707": {
            "id": "401440707",
            "speakerId": 1002,
            "speakerName": "芙里达",
            "text": "是啊，我也是这么期待着的！",
            "nextDialogs": [
              "401440710"
            ]
          },
          "401440710": {
            "id": "401440710",
            "speakerId": 1002,
            "speakerName": "芙里达",
            "text": "无论如何，现在还是好好完成眼前的工作吧。",
            "nextDialogs": [
              "401440711"
            ]
          },
          "401440711": {
            "id": "401440711",
            "speakerId": 1002,
            "speakerName": "芙里达",
            "text": "我收到代理团长的指示，要全力支持你们的经营事业。",
            "nextDialogs": [
              "401440712"
            ]
          },
          "401440712": {
            "id": "401440712",
            "speakerId": 1002,
            "speakerName": "芙里达",
            "text": "你们有什么需要，都可以向我提出哦。"
          },
          "401440709": {
            "id": "401440709",
            "speakerId": 1002,
            "speakerName": "芙里达",
            "text": "我想也是，小说里的游侠骑士都会经历很多危险…"
          }
        }
      }
    },
    {
      "subId": "4014408",
      "subQuestName": "与丽莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440601"
        ],
        "dialogs": {
          "401440601": {
            "id": "401440601",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "看来你对培育流程也熟悉起来了吧？",
            "nextDialogs": [
              "401440602"
            ]
          },
          "401440602": {
            "id": "401440602",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "啊，后勤小队的骑士已经到了呢，她会定期提供新的物资补给，你们待会去找她聊聊吧。",
            "nextDialogs": [
              "401440603"
            ]
          },
          "401440603": {
            "id": "401440603",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "再之后就是你自由发挥的时间啦。",
            "nextDialogs": [
              "401440604"
            ]
          },
          "401440604": {
            "id": "401440604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那丽莎负责什么呢？",
            "nextDialogs": [
              "401440605"
            ]
          },
          "401440605": {
            "id": "401440605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对啊，怎么变成了只有我们在忙里忙外…丽莎你的工作呢！",
            "nextDialogs": [
              "401440606"
            ]
          },
          "401440606": {
            "id": "401440606",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "我吗？当然是要确保小可爱能顺利掌握经营和炼金的技巧了。",
            "nextDialogs": [
              "401440607"
            ]
          },
          "401440607": {
            "id": "401440607",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "姐姐会一直支持你的，加油哦。",
            "nextDialogs": [
              "401440608"
            ]
          },
          "401440608": {
            "id": "401440608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我就知道会变成这样…"
          }
        }
      }
    },
    {
      "subId": "4014409",

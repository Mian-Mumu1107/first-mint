    {
      "subId": "4014410",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401441001"
        ],
        "dialogs": {
          "401441001": {
            "id": "401441001",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "试着将炼好的药剂放到那边的货架上吧。"
          }
        }
      }
    },
    {
      "subId": "4014411",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401441101"
        ],
        "dialogs": {
          "401441101": {
            "id": "401441101",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "哎呀，已经准备妥当了吗？该让骑士团的各位把开业公告张贴起来了。"
          }
        }
      }
    },
    {
      "subId": "4014499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401449901"
        ],
        "dialogs": {
          "401449901": {
            "id": "401449901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有段时间没回骑士团了，不知道琴团长和丽莎她们在忙些什么？不如回去看看吧！",
            "nextDialogs": [
              "401449902"
            ]
          },
          "401449902": {
            "id": "401449902",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "看起来药剂已经完成了呢，接下来就可以上架售卖了。",
            "nextDialogs": [
              "401449903"
            ]
          },
          "401449903": {
            "id": "401449903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这样开店的准备就算完成了吧！我们在那边休息一段时间，等待客人来吧。"
          }
        }
      }
    }
  ]
}
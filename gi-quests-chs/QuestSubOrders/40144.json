  },
  "subQuests": [
    {
      "subId": "4014401",
      "subQuestName": "与丽莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440101"
        ],
        "dialogs": {
          "401440101": {
            "id": "401440101",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "是你呀小可爱。今天怎么有空过来了。",
            "nextDialogs": [
              "401440102"
            ]
          },
          "401440102": {
            "id": "401440102",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "是想看看书，还是看看姐姐我呀？",
            "nextDialogs": [
              "401440104",
              "401440106"
            ]
          },
          "401440104": {
            "id": "401440104",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "呵呵，你还是这么贴心。",
            "nextDialogs": [
              "401440107"
            ]
          },
          "401440107": {
            "id": "401440107",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "不过今天有些不巧，我正好在处理一项工作，暂时没法招待你们喝下午茶了。",
            "nextDialogs": [
              "401440108"
            ]
          },
          "401440108": {
            "id": "401440108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，丽莎居然在认真工作，也太少见了吧？",
            "nextDialogs": [
              "401440109"
            ]
          },
          "401440109": {
            "id": "401440109",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "确实是呢，上次像这样埋头研究，好像还是在教令院的时候吧。",
            "nextDialogs": [
              "401440110"
            ]
          },
          "401440110": {
            "id": "401440110",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "久违地认真思考，还挺累人的呢。"
          },
          "401440106": {
            "id": "401440106",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "顺便来找我聊聊天吗？"
          }
        }
      }
    },
    {
      "subId": "4014402",
      "subQuestName": "前往店铺",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440201"
        ],
        "dialogs": {
          "401440201": {
            "id": "401440201",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "这里就是我们要开店的地方了。",
            "nextDialogs": [
              "401440202"
            ]
          },
          "401440202": {
            "id": "401440202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，这么多的准备，都是丽莎一个人做完的吗？",
            "nextDialogs": [
              "401440203"
            ]
          },
          "401440203": {
            "id": "401440203",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "这是骑士团的大家一起努力的成果哦。",
            "nextDialogs": [
              "401440204"
            ]
          },
          "401440204": {
            "id": "401440204",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "开店所需的启动资金，是琴特意筹备的。炼制药剂所需的药材和设备，得到了阿贝多和砂糖的支持。",
            "nextDialogs": [
              "401440205"
            ]
          },
          "401440205": {
            "id": "401440205",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "至于后续的物资补充，则是由后勤小队来负责。",
            "nextDialogs": [
              "401440206"
            ]
          },
          "401440206": {
            "id": "401440206",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "现在又有了你们的加入，姐姐身上的担子减轻了不少呢。",
            "nextDialogs": [
              "401440207"
            ]
          },
          "401440207": {
            "id": "401440207",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "这些天，骑士团已经对店铺做了一系列宣传。等我们准备好了，就可以正式开业啦。",
            "nextDialogs": [
              "401440208"
            ]
          },
          "401440208": {
            "id": "401440208",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "事不宜迟，接下来你就用这几种药材，试着炼制药剂吧。"
          }
        }
      }
    },
    {
      "subId": "4014403",
      "subQuestName": "尝试炼制药剂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440301"
        ],
        "dialogs": {
          "401440301": {
            "id": "401440301",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "只要把药材放进炼金釜，按照步骤操作，就能炼制出药剂了。"
          }
        }
      }
    },
    {
      "subId": "4014404",
      "subQuestName": "尝试上架售卖",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440401"
        ],
        "dialogs": {
          "401440401": {
            "id": "401440401",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "嗯，你已经顺利卖出第一批药剂了呢，这是个好的开始。",
            "nextDialogs": [
              "401440402"
            ]
          },
          "401440402": {
            "id": "401440402",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "至于之后要炼制什么样的药剂，就要参考市场消息了。",
            "nextDialogs": [
              "401440403"
            ]
          },
          "401440403": {
            "id": "401440403",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "根据近期发生的一些新闻，来推测人们需要什么样的药剂，这是经营的必备技巧哦。",
            "nextDialogs": [
              "401440404"
            ]
          },
          "401440404": {
            "id": "401440404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃，听起来有点难度呢…",
            "nextDialogs": [
              "401440405"
            ]
          },
          "401440405": {
            "id": "401440405",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "呵呵…别担心，姐姐已经贴心地帮你整理好了最近的市场消息。",
            "nextDialogs": [
              "401440406"
            ]
          },
          "401440406": {
            "id": "401440406",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "怎么样，对接下来要出售的药剂有什么想法了吗？",
            "nextDialogs": [
              "401440407"
            ]
          },
          "401440407": {
            "id": "401440407",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "那么就试试培育新的药材吧。这些药材经过了生物炼金技术的处理，带有不同的功效和特征。",
            "nextDialogs": [
              "401440408"
            ]
          },
          "401440408": {
            "id": "401440408",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "根据加入药材的种类不同，最终炼制出的药剂也会发生变化。可以多尝试不同的组合哦。",
            "nextDialogs": [
              "401440409"
            ]
          },
          "401440409": {
            "id": "401440409",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "好了，你去实际尝试一下吧。"
          }
        }
      }
    },
    {
      "subId": "4014405",
      "subQuestName": "结束当前经营周期",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401440501"
        ],
        "dialogs": {
          "401440501": {
            "id": "401440501",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "去试试培育新的药材吧。"
          }
        }
      }
    },

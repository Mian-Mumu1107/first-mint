  },
  "subQuests": [
    {
      "subId": "2302601",
      "subQuestName": "与齐里亚布交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230260101"
        ],
        "dialogs": {
          "230260101": {
            "id": "230260101",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "这些问题会不会太难了…",
            "nextDialogs": [
              "230260102"
            ]
          },
          "230260102": {
            "id": "230260102",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "欸？旅行者！还请留步。",
            "nextDialogs": [
              "230260103"
            ]
          },
          "230260103": {
            "id": "230260103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你叫我？",
            "nextDialogs": [
              "230260104"
            ]
          },
          "230260104": {
            "id": "230260104",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "正是！哈哈哈，我之所以冒昧地请您留步，是想要请您帮一点小忙。",
            "nextDialogs": [
              "230260108"
            ]
          },
          "230260108": {
            "id": "230260108",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "啊？您这是…听起来怎么这么熟练啊？哈哈哈！",
            "nextDialogs": [
              "230260109"
            ]
          },
          "230260109": {
            "id": "230260109",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "都不是，都不是，我既没有丢东西，也不缺研究的材料，至于取材嘛…我自己都取得够多了。",
            "nextDialogs": [
              "230260110"
            ]
          },
          "230260110": {
            "id": "230260110",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "咳咳，实际上，为了帮助一些新生迅速理解流传在须弥内的各种名词，我正在编纂一本「问答集」。",
            "nextDialogs": [
              "230260111"
            ]
          },
          "230260111": {
            "id": "230260111",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "简单来说，就是以一问一答的形式，将各种复杂的名词解释给人听。",
            "nextDialogs": [
              "230260112"
            ]
          },
          "230260112": {
            "id": "230260112",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "这样学习起来效率又高，学习的过程也不会很乏味。",
            "nextDialogs": [
              "230260113"
            ]
          },
          "230260113": {
            "id": "230260113",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "不过，我不太确定这些问题的难易程度…所以想要请您来帮我判断一下。"
          }
        }
      }
    },
    {
      "subId": "2302602",
      "subQuestName": "与齐里亚布交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230260801"
        ],
        "dialogs": {
          "230260801": {
            "id": "230260801",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "好了，今天我的问题就到这里，让我看看你一共答对了几题…",
            "nextDialogs": [
              "230260802"
            ]
          },
          "230260802": {
            "id": "230260802",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "很不错！三题全对，看来您是在须弥做足了功课啊。",
            "nextDialogs": [
              "230260803"
            ]
          },
          "230260803": {
            "id": "230260803",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "那么，这些小礼物还请您收下，这是对您之前做的那些功课的回报。"
          }
        }
      }
    },
    {
      "subId": "2302603",
      "subQuestName": "与齐里亚布交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230260901"
        ],
        "dialogs": {
          "230260901": {
            "id": "230260901",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "唔…您没能全答对啊。",
            "nextDialogs": [
              "230260902"
            ]
          },
          "230260902": {
            "id": "230260902",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "哈哈哈，没关系，您初到须弥，有些问题答不上来再正常不过了。",
            "nextDialogs": [
              "230260903"
            ]
          },
          "230260903": {
            "id": "230260903",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "那么，这些小礼物还请您收下，谢谢您愿意回答这些问题。"
          }
        }
      }
    },
    {
      "subId": "2302604",
      "subQuestName": "与齐里亚布交谈$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2302605",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230260501"
        ],
        "dialogs": {
          "230260501": {
            "id": "230260501",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "您去过须弥城外吗？在靠近沙漠的那些区域里，立着一些障壁。",
            "nextDialogs": [
              "230260502"
            ]
          },
          "230260502": {
            "id": "230260502",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "我的问题是，那些障壁的学名是？",
            "nextDialogs": [
              "230260504",
              "230260506",
              "230260508"
            ]
          },
          "230260504": {
            "id": "230260504",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "应该是「防沙壁」，毕竟是在沙漠旁边嘛，您下次可要记住了。"
          },
          "230260506": {
            "id": "230260506",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "是「防沙壁」才对，毕竟是在沙漠旁边嘛，您下次可要记住了。"
          },
          "230260508": {
            "id": "230260508",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "不错，不错，答对了，真是难得啊。"
          }
        }
      }
    },
    {
      "subId": "2302606",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230260601"
        ],
        "dialogs": {
          "230260601": {
            "id": "230260601",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "须弥的商队在长途商运的时候，经常会用一种兽类来帮忙运送货物。",
            "nextDialogs": [
              "230260602"
            ]
          },
          "230260602": {
            "id": "230260602",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "我的问题是，那种兽类的名字是？",
            "nextDialogs": [
              "230260604",
              "230260606",
              "230260608"
            ]
          },
          "230260604": {
            "id": "230260604",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "没错，就是驮兽，您的记忆力还真不错。"
          },
          "230260606": {
            "id": "230260606",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "是「驮兽」才对，您下次可要记住了。"
          },
          "230260608": {
            "id": "230260608",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "这种兽类的名字是「驮兽」才对，您下次可要记住了。"
          }
        }
      }
    },
    {
      "subId": "2302607",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230260701"
        ],
        "dialogs": {
          "230260701": {
            "id": "230260701",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "在须弥的野外，有一种…嗯…简单粗暴地形容，长得很像蘑菇的魔物。",
            "nextDialogs": [
              "230260702"
            ]
          },
          "230260702": {
            "id": "230260702",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "我的问题是，这种魔物的名字是？",
            "nextDialogs": [
              "230260704",
              "230260706",
              "230260708"
            ]
          },
          "230260704": {
            "id": "230260704",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "没错，就是蕈兽。毕竟长得很像蘑菇嘛。"
          },
          "230260706": {
            "id": "230260706",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "是「蕈兽」才对，您可以用蘑菇来帮助自己记忆这个词。"
          },
          "230260708": {
            "id": "230260708",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "这完全就不挨着…是「蕈兽」才对，您可以用蘑菇来帮助自己记忆这个词。"
          }
        }
      }
    },
    {
      "subId": "2302612",
      "subQuestName": "与齐里亚布交谈",
      "sceneId": null,

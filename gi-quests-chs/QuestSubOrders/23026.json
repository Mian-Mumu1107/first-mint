    {
      "subId": "2302602",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230260201"
        ],
        "dialogs": {
          "230260201": {
            "id": "230260201",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "咳咳…您可能已经知道，教令院中各学派的研究各有所长。",
            "nextDialogs": [
              "230260202"
            ]
          },
          "230260202": {
            "id": "230260202",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "那么请问，教令院中学者数量最多，也就是生论派学者为主的学院，它的名字是？",
            "nextDialogs": [
              "230260204",
              "230260206",
              "230260208"
            ]
          },
          "230260204": {
            "id": "230260204",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "很好，完全正确。"
          },
          "230260206": {
            "id": "230260206",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "唔，跟正确答案背道而驰。"
          },
          "230260208": {
            "id": "230260208",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "哈哈，很遗憾。不是这个答案。"
          }
        }
      }
    },
    {
      "subId": "2302603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230260301"
        ],
        "dialogs": {
          "230260301": {
            "id": "230260301",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "也许您在旅行的过程中，曾经遇见过不少自称「帝利耶悉」的「游学者」。",
            "nextDialogs": [
              "230260302"
            ]
          },
          "230260302": {
            "id": "230260302",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "实际上，教令院的某个学院中也有着大量的「帝利耶悉」。",
            "nextDialogs": [
              "230260303"
            ]
          },
          "230260303": {
            "id": "230260303",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "这个学院以元素为其理论核心，研究着各类与元素力密切相关的东西。",
            "nextDialogs": [
              "230260304"
            ]
          },
          "230260304": {
            "id": "230260304",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "我的问题是，这个学院的名字是？",
            "nextDialogs": [
              "230260306",
              "230260308",
              "230260310"
            ]
          },
          "230260306": {
            "id": "230260306",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "没错，就是聚集着「素论派」学者的悉般多摩学院，他们将七大元素视为一切物质与生命的本质。"
          },
          "230260308": {
            "id": "230260308",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "哈哈，答错了，「室罗婆耽学院」的「知论派」学者们研究着语言、符号以及逻辑学…相信我，真的非常复杂。"
          },
          "230260310": {
            "id": "230260310",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "唔，很遗憾，您答错了。「梨多梵谛学院」是「明论派」学者的大本营，他们研究的核心是我们头顶的星空…呵呵，听上去是不是很有趣？"
          }
        }
      }
    },
    {
      "subId": "2302604",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230260401"
        ],
        "dialogs": {
          "230260401": {
            "id": "230260401",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "您仰头看看，可以看到那棵托举着教令院的大树吗？",
            "nextDialogs": [
              "230260402"
            ]
          },
          "230260402": {
            "id": "230260402",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "我接下来的问题很简单，但不少人都会忽视。",
            "nextDialogs": [
              "230260403"
            ]
          },
          "230260403": {
            "id": "230260403",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "那么请听题，这棵托举着教令院的大树，它的名字是？",
            "nextDialogs": [
              "230260405",
              "230260407",
              "230260409"
            ]
          },
          "230260405": {
            "id": "230260405",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "哈哈哈，这名字很简洁，但很遗憾您答错了。"
          },
          "230260407": {
            "id": "230260407",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "哈哈哈，很不错！很不错！您答对了！"
          },
          "230260409": {
            "id": "230260409",
            "speakerId": 4083,
            "speakerName": "齐里亚布",
            "text": "唔，倒是很有气势，可惜您答错了。"
          }
        }
      }
    }
  ]
}
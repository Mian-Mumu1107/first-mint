  "subQuests": [
    {
      "subId": "7109601",
      "subQuestName": "test隐藏-将三枚老石交给沐宁$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710960101"
        ],
        "dialogs": {
          "710960101": {
            "id": "710960101",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "请问两位找到「老石」了吗？",
            "nextDialogs": [
              "710960102"
            ]
          },
          "710960102": {
            "id": "710960102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在这里了。"
          }
        }
      }
    },
    {
      "subId": "7109602",
      "subQuestName": "test隐藏-与沐宁对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710960201"
        ],
        "dialogs": {
          "710960201": {
            "id": "710960201",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "又是三枚「老石」。",
            "nextDialogs": [
              "710960202"
            ]
          },
          "710960202": {
            "id": "710960202",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "这两位「热心群众」上交的「老石」，我就好好收下了。",
            "nextDialogs": [
              "710960203"
            ]
          },
          "710960203": {
            "id": "710960203",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "没想到这么快就找到了三枚，而且品相比我之前见过的都好上不少。",
            "nextDialogs": [
              "710960204"
            ]
          },
          "710960204": {
            "id": "710960204",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "唉…这让我想起以前我有的那枚。",
            "nextDialogs": [
              "710960205"
            ]
          },
          "710960205": {
            "id": "710960205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你的那枚？",
            "nextDialogs": [
              "710960208"
            ]
          },
          "710960208": {
            "id": "710960208",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "是「以前」我有的那枚啦。",
            "nextDialogs": [
              "710960209"
            ]
          },
          "710960209": {
            "id": "710960209",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "我爸在盛露厅，那枚「老石」是一小块过他手的边角料，品相也不是很好，他就把那枚石头当玩具丢给了我。",
            "nextDialogs": [
              "710960210"
            ]
          },
          "710960210": {
            "id": "710960210",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "我那时天天和他吵架，游手好闲，还流连那个时候的岩上茶室，欠了一大笔钱，走投无路…",
            "nextDialogs": [
              "710960211"
            ]
          },
          "710960211": {
            "id": "710960211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊…",
            "nextDialogs": [
              "710960212"
            ]
          },
          "710960212": {
            "id": "710960212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有点差劲…",
            "nextDialogs": [
              "710960213"
            ]
          },
          "710960213": {
            "id": "710960213",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "这个，谁都有年轻的时候嘛，反正就是我走投无路之时…",
            "nextDialogs": [
              "710960214"
            ]
          },
          "710960214": {
            "id": "710960214",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "正好有认出「老石」的人愿意花钱买，一块石头罢了，卖就卖了，得了摩拉解了一时之忧。",
            "nextDialogs": [
              "710960215"
            ]
          },
          "710960215": {
            "id": "710960215",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "结果前几日我爸聊起这件事时，说，「沐宁啊，你以前玩的那块石头怎么不见了…」",
            "nextDialogs": [
              "710960216"
            ]
          },
          "710960216": {
            "id": "710960216",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "我只好说，「一块石头而已，还能留到现在？」",
            "nextDialogs": [
              "710960217"
            ]
          },
          "710960217": {
            "id": "710960217",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "嘴上那么说，心里却想着，要是当初没卖那石头，他聊起的时候掏出来给他看看…",
            "nextDialogs": [
              "710960218"
            ]
          },
          "710960218": {
            "id": "710960218",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "…算了算了，想这些也没用。",
            "nextDialogs": [
              "710960219"
            ]
          },
          "710960219": {
            "id": "710960219",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "现在改正了就好。",
            "nextDialogs": [
              "710960220"
            ]
          },
          "710960220": {
            "id": "710960220",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "你说的是…只不过以前欠的钱还是要慢慢偿还。",
            "nextDialogs": [
              "710960221"
            ]
          },
          "710960221": {
            "id": "710960221",
            "speakerId": 1000,
            "speakerName": "沐宁",
            "text": "不说了，如果还发现老石，记得带给我。"
          }
        }
      }
    }
  ]
}
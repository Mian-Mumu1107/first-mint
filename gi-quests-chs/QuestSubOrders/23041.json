    {
      "subId": "2304115",
      "subQuestName": "把内尔敏做好的饮料带给里夫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230411001"
        ],
        "dialogs": {
          "230411001": {
            "id": "230411001",
            "speakerId": 4404,
            "speakerName": "里夫",
            "text": "这「薄荷豆汤」…是内尔敏自己做的？",
            "nextDialogs": [
              "230411002"
            ]
          },
          "230411002": {
            "id": "230411002",
            "speakerId": 4404,
            "speakerName": "里夫",
            "text": "我说她最近怎么神神秘秘的，而且还找人买了几个花盆，不知道往里面种了什么…",
            "nextDialogs": [
              "230411003"
            ]
          },
          "230411003": {
            "id": "230411003",
            "speakerId": 4404,
            "speakerName": "里夫",
            "text": "不过这样也不错，至少…内尔敏不会每天都只想着自己的身体问题了。",
            "nextDialogs": [
              "230411004"
            ]
          },
          "230411004": {
            "id": "230411004",
            "speakerId": 4404,
            "speakerName": "里夫",
            "text": "等会还有一批货要送进来，等我把那批货接进村里之后，就把这碗汤给喝了。",
            "nextDialogs": [
              "230411005"
            ]
          },
          "230411005": {
            "id": "230411005",
            "speakerId": 4404,
            "speakerName": "里夫",
            "text": "对了，这些报酬给你，多谢你跑一趟啦，旅行者。"
          }
        }
      }
    },

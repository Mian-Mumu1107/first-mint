    {
      "subId": "2304107",
      "subQuestName": "向内尔敏回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410701"
        ],
        "dialogs": {
          "230410701": {
            "id": "230410701",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "旅行者，你找到那只小猫了吗？",
            "nextDialogs": [
              "230410704"
            ]
          },
          "230410704": {
            "id": "230410704",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "那就好，希望它别再来咬花了。无论怎么说，猫粮都要比花叶好吃啊。",
            "nextDialogs": [
              "230410705"
            ]
          },
          "230410705": {
            "id": "230410705",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "谢谢你帮忙旅行者，这是报酬，请你收下吧。",
            "nextDialogs": [
              "230410706"
            ]
          },
          "230410706": {
            "id": "230410706",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "唉，希望小猫不要饿得太快…"
          }
        }
      }
    },
    {
      "subId": "2304109",
      "subQuestName": "将「墩墩桃」带给内尔敏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410901"
        ],
        "dialogs": {
          "230410901": {
            "id": "230410901",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "谢谢你！我得先把它切块，然后再加入进「薄荷豆汤」里…",
            "nextDialogs": [
              "230410902"
            ]
          },
          "230410902": {
            "id": "230410902",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "内尔敏开始制作特别的「薄荷豆汤」…",
            "nextDialogs": [
              "230410903"
            ]
          },
          "230410903": {
            "id": "230410903",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "完成了！唔…看起来和普通的「薄荷豆汤」好像也没什么区别…",
            "nextDialogs": [
              "230410904"
            ]
          },
          "230410904": {
            "id": "230410904",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "不过，尝起来肯定会不一样的！",
            "nextDialogs": [
              "230410905"
            ]
          },
          "230410905": {
            "id": "230410905",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "旅行者，就麻烦你把这碗「薄荷豆汤」带去给里夫吧。",
            "nextDialogs": [
              "230410906"
            ]
          },
          "230410906": {
            "id": "230410906",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "我还得给库尔苏姆奶奶做几份，奥贝德和希尔米说他们也想喝…",
            "nextDialogs": [
              "230410908",
              "230410910"
            ]
          },
          "230410908": {
            "id": "230410908",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "我知道啦，只是几碗「薄荷豆汤」而已，不会有什么问题的。",
            "nextDialogs": [
              "230410911"
            ]
          },
          "230410911": {
            "id": "230410911",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "总之，请你把这份「薄荷豆汤」送给里夫吧。",
            "nextDialogs": [
              "230410912"
            ]
          },
          "230410912": {
            "id": "230410912",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "还得给纳瓦兹和拉米兹也准备几份…"
          },
          "230410910": {
            "id": "230410910",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "毕竟…我总算是可以做一些正事了，当然要好好把握住这个机会。"
          }
        }
      }
    },
    {
      "subId": "2304110",

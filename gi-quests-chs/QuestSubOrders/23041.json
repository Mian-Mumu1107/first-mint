  },
  "subQuests": [
    {
      "subId": "2304101",
      "subQuestName": "与内尔敏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410101"
        ],
        "dialogs": {
          "230410101": {
            "id": "230410101",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "呼…这样松土应该就可以了吧…",
            "nextDialogs": [
              "230410102"
            ]
          },
          "230410102": {
            "id": "230410102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还在照顾这盆花吗？",
            "nextDialogs": [
              "230410103"
            ]
          },
          "230410103": {
            "id": "230410103",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "嗯，库尔苏姆奶奶教了我很多照顾花的方法。",
            "nextDialogs": [
              "230410104"
            ]
          },
          "230410104": {
            "id": "230410104",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "比如要给它松土啦，定时修剪叶片啦，用各种方法除虫啦…",
            "nextDialogs": [
              "230410105"
            ]
          },
          "230410105": {
            "id": "230410105",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "还有浇水不能浇得太多，不然花的根部就会被水泡烂。",
            "nextDialogs": [
              "230410106"
            ]
          },
          "230410106": {
            "id": "230410106",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "哎呀，我还以为要每天浇花，时刻让土壤保持湿润呢…",
            "nextDialogs": [
              "230410107"
            ]
          },
          "230410107": {
            "id": "230410107",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "不过这样也好，我就不用每天都去打水了，取水的地方离这里可远了。",
            "nextDialogs": [
              "230410108"
            ]
          },
          "230410108": {
            "id": "230410108",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "我得接着修剪枝叶，旅行者，你能帮我去打一小壶水过来吗？",
            "nextDialogs": [
              "230410109"
            ]
          },
          "230410109": {
            "id": "230410109",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "我已经和卡桑说过了，他答应我可以去取水浇花。",
            "nextDialogs": [
              "230410114",
              "230410112"
            ]
          },
          "230410114": {
            "id": "230410114",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "水壶就在那边，你打水的时候可要注意喔，可不要打上来太多泥沙了。"
          },
          "230410112": {
            "id": "230410112",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "唔…差不多吧，库尔苏姆奶奶知道的事可多了，我经常去找她请教呢。",
            "nextDialogs": [
              "230410113"
            ]
          },
          "230410113": {
            "id": "230410113",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "那就拜托你了，旅行者，只要打一小壶水过来就好。"
          }
        }
      }
    },
    {
      "subId": "2304118",
      "subQuestName": "刷水壶辅助$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2304102",
      "subQuestName": "拿起水壶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410201"
        ],
        "dialogs": {
          "230410201": {
            "id": "230410201",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "呜…又有几片叶子被咬破了…",
            "nextDialogs": [
              "230410202"
            ]
          },
          "230410202": {
            "id": "230410202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "230410203"
            ]
          },
          "230410203": {
            "id": "230410203",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "旅行者，你看呀！又有小猫过来咬花了！",
            "nextDialogs": [
              "230410204"
            ]
          },
          "230410204": {
            "id": "230410204",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "你看这片叶子，这片…还有这片！都被咬下去了一大块！",
            "nextDialogs": [
              "230410206",
              "230410209"
            ]
          },
          "230410206": {
            "id": "230410206",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "里夫也这么说，他还专门带着吃的到处去喂猫…",
            "nextDialogs": [
              "230410207"
            ]
          },
          "230410207": {
            "id": "230410207",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "但是第二天，还是有小猫过来咬花。",
            "nextDialogs": [
              "230410210"
            ]
          },
          "230410210": {
            "id": "230410210",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "现在小猫只是咬叶子，但我就怕小猫有一天开始咬花茎…那可就糟了。",
            "nextDialogs": [
              "230410211"
            ]
          },
          "230410211": {
            "id": "230410211",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "不过，我也狠不下心去把它赶得很远，毕竟外面就是沙漠，它除了这个村子之外，也无处可去…",
            "nextDialogs": [
              "230410212"
            ]
          },
          "230410212": {
            "id": "230410212",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "旅行者，你能帮我再去喂喂它吗？希望小猫吃饱了之后，别再来咬花了，花叶也不是什么好吃的东西呀…"
          },
          "230410209": {
            "id": "230410209",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "我是弄不清小猫喜欢玩什么啦…"
          }
        }
      }
    },
    {
      "subId": "2304103",
      "subQuestName": "到达梯井下接水",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410301"
        ],
        "dialogs": {
          "230410301": {
            "id": "230410301",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "旅行者，你来得正好，快来尝尝我做的薄荷豆汤。",
            "nextDialogs": [
              "230410303"
            ]
          },
          "230410303": {
            "id": "230410303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这些材料是…",
            "nextDialogs": [
              "230410304"
            ]
          },
          "230410304": {
            "id": "230410304",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "有些是我托人买回来的，但是薄荷嘛…是我自己种的。",
            "nextDialogs": [
              "230410305"
            ]
          },
          "230410305": {
            "id": "230410305",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "里夫不是送了我一套园艺工具，还有一堆肥料吗？",
            "nextDialogs": [
              "230410306"
            ]
          },
          "230410306": {
            "id": "230410306",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "如果仅仅是种一盆花，我觉得实在是太浪费了…所以，我就拜托阿扎莱帮我买了一些薄荷种子。",
            "nextDialogs": [
              "230410307"
            ]
          },
          "230410307": {
            "id": "230410307",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "把薄荷种子种下去之后，我就和照顾那盆花一样照顾着它。",
            "nextDialogs": [
              "230410308"
            ]
          },
          "230410308": {
            "id": "230410308",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "照顾着照顾着，薄荷就顺利地成长…成熟…",
            "nextDialogs": [
              "230410309"
            ]
          },
          "230410309": {
            "id": "230410309",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "我就采了一些下来，做成了「薄荷豆汤」，怎么样，味道还不错吧。",
            "nextDialogs": [
              "230410310"
            ]
          },
          "230410310": {
            "id": "230410310",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "那…你既然喝了我做的「薄荷豆汤」，就得帮我个忙。",
            "nextDialogs": [
              "230410313"
            ]
          },
          "230410313": {
            "id": "230410313",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "别呀！我开玩笑的，会好好付给你报酬的啦！",
            "nextDialogs": [
              "230410314"
            ]
          },
          "230410314": {
            "id": "230410314",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "我就是想请你去帮我采三枚「墩墩桃」回来，里夫很喜欢吃这种水果…",
            "nextDialogs": [
              "230410315"
            ]
          },
          "230410315": {
            "id": "230410315",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "我想把它们加入「薄荷豆汤」里，然后送去给里夫。",
            "nextDialogs": [
              "230410316"
            ]
          },
          "230410316": {
            "id": "230410316",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "现在「薄荷豆汤」我已经会做了，就等人帮我去拿「墩墩桃」啦。"
          }
        }
      }
    },
    {
      "subId": "2304105",
      "subQuestName": "回去给绿植浇水",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410501"
        ],
        "dialogs": {
          "230410501": {
            "id": "230410501",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "旅行者，你取到水了吗？",
            "nextDialogs": [
              "230410502"
            ]
          },
          "230410502": {
            "id": "230410502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "算是取到了吧…",
            "nextDialogs": [
              "230410503"
            ]
          },
          "230410503": {
            "id": "230410503",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "太好了，我这就开始浇花，你稍等一下…",
            "nextDialogs": [
              "230410504"
            ]
          },
          "230410504": {
            "id": "230410504",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "内尔敏开始了浇花…",
            "nextDialogs": [
              "230410505"
            ]
          },
          "230410505": {
            "id": "230410505",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "呼…这样应该就可以了…",
            "nextDialogs": [
              "230410506"
            ]
          },
          "230410506": {
            "id": "230410506",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "库尔苏姆奶奶说，浇水的时候，只要浇到花盆底下有水透出来就可以停下了。",
            "nextDialogs": [
              "230410507"
            ]
          },
          "230410507": {
            "id": "230410507",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "这样就算是「浇透」了花土，之后就要每三天浇一次水…",
            "nextDialogs": [
              "230410508"
            ]
          },
          "230410508": {
            "id": "230410508",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "喔！对不起，我怎么自言自语起来了…这些是报酬，谢谢你帮忙，旅行者。",
            "nextDialogs": [
              "230410509"
            ]
          },
          "230410509": {
            "id": "230410509",
            "speakerId": 4405,
            "speakerName": "内尔敏",
            "text": "修剪叶片的时候，要用什么工具好呢…"
          }
        }
      }
    },

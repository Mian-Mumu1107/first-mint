        ],
        "dialogs": {
          "745160101": {
            "id": "745160101",
            "speakerId": 30773,
            "speakerName": "哲俩阿",
            "text": "荣誉骑士和白色小帮手，好消息来了！",
            "nextDialogs": [
              "745160102"
            ]
          },
          "745160102": {
            "id": "745160102",
            "speakerId": 30773,
            "speakerName": "哲俩阿",
            "text": "这位是执律庭的昂吉安妮警官，她已将放生徒背后的供货商逮捕归案。",
            "nextDialogs": [
              "745160103"
            ]
          },
          "745160103": {
            "id": "745160103",
            "speakerId": 30784,
            "speakerName": "昂吉安妮",
            "text": "哼！店门被我踹开的时候，那小子还在数钱…真是个重量级混蛋！",
            "nextDialogs": [
              "745160104"
            ]
          },
          "745160104": {
            "id": "745160104",
            "speakerId": 30773,
            "speakerName": "哲俩阿",
            "text": "你们的高强度捕捉也有了显著成效，这片水域的外来物种鱼明显减少了…",
            "nextDialogs": [
              "745160105"
            ]
          },
          "745160105": {
            "id": "745160105",
            "speakerId": 30773,
            "speakerName": "哲俩阿",
            "text": "按这个速度，理论上，再过不久，本次生物入侵的问题就会被彻底解决。",
            "nextDialogs": [
              "745160106"
            ]
          },
          "745160106": {
            "id": "745160106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶！不用再担心枫达…不对，是枫丹的水质被影响了！",
            "nextDialogs": [
              "745160107"
            ]
          },
          "745160107": {
            "id": "745160107",
            "speakerId": 30784,
            "speakerName": "昂吉安妮",
            "text": "#追猎者小姐也真是本事了得！居然能请动「超天顶级领队战力」{NICKNAME}来帮忙…",
            "nextDialogs": [
              "745160108"
            ]
          },
          "745160108": {
            "id": "745160108",
            "speakerId": 30784,
            "speakerName": "昂吉安妮",
            "text": "那句老话怎么说的来着…对，舰炮轰渔鸥！",
            "nextDialogs": [
              "745160111"
            ]
          },
          "745160111": {
            "id": "745160111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，这位昂吉安妮警官好像有点眼熟呢…",
            "nextDialogs": [
              "745160112"
            ]
          },
          "745160112": {
            "id": "745160112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是因为我们经常帮忙维护秩序，见过不少治安工作者吗？"
          }
        }
      }
    }
  ]

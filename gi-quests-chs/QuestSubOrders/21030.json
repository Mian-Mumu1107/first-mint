  "subQuests": [
    {
      "subId": "2103001",
      "subQuestName": "与小蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210300101"
        ],
        "dialogs": {
          "210300101": {
            "id": "210300101",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "欸？这个矿石，和这个矿石也不一样吗？",
            "nextDialogs": [
              "210300102"
            ]
          },
          "210300102": {
            "id": "210300102",
            "speakerId": 2048,
            "speakerName": "老章",
            "text": "那当然了，用这两种矿石打造出的东西，品质和价钱可是完全不一样的。",
            "nextDialogs": [
              "210300103"
            ]
          },
          "210300103": {
            "id": "210300103",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "喔…不过，这两种矿石怎么都只剩下这么一点了…",
            "nextDialogs": [
              "210300104"
            ]
          },
          "210300104": {
            "id": "210300104",
            "speakerId": 2048,
            "speakerName": "老章",
            "text": "唉…",
            "nextDialogs": [
              "210300105"
            ]
          },
          "210300105": {
            "id": "210300105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在做什么呢？",
            "nextDialogs": [
              "210300106"
            ]
          },
          "210300106": {
            "id": "210300106",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你好，我正在帮我爸爸检查他订的铁器呢。",
            "nextDialogs": [
              "210300107"
            ]
          },
          "210300107": {
            "id": "210300107",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "铁匠叔叔可好了，他还答应我，要帮我做一把小剑呢！",
            "nextDialogs": [
              "210300108"
            ]
          },
          "210300108": {
            "id": "210300108",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "不过，他说最近店里的原料不够用，爸爸订的那批铁器可能要延期…",
            "nextDialogs": [
              "210300109"
            ]
          },
          "210300109": {
            "id": "210300109",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "我的那把小剑也不知道什么时候才能做出来了…",
            "nextDialogs": [
              "210300110"
            ]
          },
          "210300110": {
            "id": "210300110",
            "speakerId": 2048,
            "speakerName": "老章",
            "text": "唉，这也是没办法的事，最近店里的客人很多，矿石都用得差不多了。",
            "nextDialogs": [
              "210300111"
            ]
          },
          "210300111": {
            "id": "210300111",
            "speakerId": 2048,
            "speakerName": "老章",
            "text": "那些矿物产量丰富的地方，也盘踞着许多魔物，我也不敢贸然过去采矿…",
            "nextDialogs": [
              "210300112"
            ]
          },
          "210300112": {
            "id": "210300112",
            "speakerId": 2048,
            "speakerName": "老章",
            "text": "只能等我把这段时间先忙过去，再请一位冒险家陪着我出去采矿了。",
            "nextDialogs": [
              "210300113"
            ]
          },
          "210300113": {
            "id": "210300113",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "可是，那得等到什么时候…",
            "nextDialogs": [
              "210300114"
            ]
          },
          "210300114": {
            "id": "210300114",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我听人家说，你是不是特别会对付那些魔物？",
            "nextDialogs": [
              "210300115"
            ]
          },
          "210300115": {
            "id": "210300115",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "你能不能帮帮忙？拜托拜托，求求你了…",
            "nextDialogs": [
              "210300118"
            ]
          },
          "210300118": {
            "id": "210300118",
            "speakerId": 2048,
            "speakerName": "老章",
            "text": "旅行者，你要去看看情况吗？那我先把我平时采矿的地点给你标上…",
            "nextDialogs": [
              "210300119"
            ]
          },
          "210300119": {
            "id": "210300119",
            "speakerId": 2048,
            "speakerName": "老章",
            "text": "唔，好了，就是这些地方了。你去的时候可要小心点，那边有很多魔物。",
            "nextDialogs": [
              "210300120"
            ]
          },
          "210300120": {
            "id": "210300120",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "#那就拜托你了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！"
          }
        }
      }
    },
    {
      "subId": "2103002",
      "subQuestName": "前往魔物聚集处，打倒所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210300201"
        ],
        "dialogs": {
          "210300201": {
            "id": "210300201",
            "speakerId": 2048,
            "speakerName": "老章",
            "text": "旅行者，那边的情况怎么样了？",
            "nextDialogs": [
              "210300202"
            ]
          },
          "210300202": {
            "id": "210300202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那边暂时安全了。",
            "nextDialogs": [
              "210300203"
            ]
          },
          "210300203": {
            "id": "210300203",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "#不愧是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，真厉害！",
            "nextDialogs": [
              "210300204"
            ]
          },
          "210300204": {
            "id": "210300204",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "爸爸说，旅行的时候，他们也会雇几个人来保护我们。",
            "nextDialogs": [
              "210300205"
            ]
          },
          "210300205": {
            "id": "210300205",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "#希望那些人的身手，能和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}一样厉害…",
            "nextDialogs": [
              "210300206"
            ]
          },
          "210300206": {
            "id": "210300206",
            "speakerId": 2031,
            "speakerName": "小蒙",
            "text": "铁匠叔叔，这样你是不是就可以继续去采矿，然后继续做那批铁器啦？",
            "nextDialogs": [
              "210300207"
            ]
          },
          "210300207": {
            "id": "210300207",
            "speakerId": 2048,
            "speakerName": "老章",
            "text": "哈哈哈，那是当然，我准备一下就去采矿，等会回来就可以继续开工了。",
            "nextDialogs": [
              "210300208"
            ]
          },
          "210300208": {
            "id": "210300208",
            "speakerId": 2048,
            "speakerName": "老章",
            "text": "但我一个人能带的矿石有限…希望那个地方，不要再出现魔物了。"
          }
        }
      }
    },

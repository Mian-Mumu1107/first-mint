  "subQuests": [
    {
      "subId": "7471101",
      "subQuestName": "与希格雯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747110101"
        ],
        "dialogs": {
          "747110101": {
            "id": "747110101",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "嗯！一切顺利…",
            "nextDialogs": [
              "747110102"
            ]
          },
          "747110102": {
            "id": "747110102",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "现在我可以确定了，救治狂暴鱼儿们的工作，已经进入了最后阶段。",
            "nextDialogs": [
              "747110103"
            ]
          },
          "747110103": {
            "id": "747110103",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "除了再找回一些病患鱼儿，查漏补缺，还有一个特别的任务——",
            "nextDialogs": [
              "747110104"
            ]
          },
          "747110104": {
            "id": "747110104",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "从受到影响的水域，找出关键的水下机关，回收它们的探测设备所记录的资料…",
            "nextDialogs": [
              "747110107"
            ]
          },
          "747110107": {
            "id": "747110107",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "没错哦。",
            "nextDialogs": [
              "747110108"
            ]
          },
          "747110108": {
            "id": "747110108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还要给船主和潜水员提个醒，总结一下这次的教训。",
            "nextDialogs": [
              "747110109"
            ]
          },
          "747110109": {
            "id": "747110109",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "嗯，还有渔民和游客，在水面上坐船，在水下潜水的人…",
            "nextDialogs": [
              "747110110"
            ]
          },
          "747110110": {
            "id": "747110110",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "所有和水域打交道的人都要留个心眼，可别随意乱丢东西，搞得水域环境一团糟。",
            "nextDialogs": [
              "747110111"
            ]
          },
          "747110111": {
            "id": "747110111",
            "speakerId": 1000,
            "speakerName": "希格雯",
            "text": "不然，可能会有暴躁的鱼儿来掀翻你的小船哦。"
          }
        }
      }
    }
  ]
}
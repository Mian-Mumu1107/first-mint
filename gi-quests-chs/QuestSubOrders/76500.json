      "dialogue": {
        "startDialogs": [
          "765000101"
        ],
        "dialogs": {
          "765000101": {
            "id": "765000101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}！快过来这边！给你看一个超级棒的东西！",
            "nextDialogs": [
              "765000102"
            ]
          },
          "765000102": {
            "id": "765000102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "当当——！你看，这是我费了好大劲，才从这个乱糟糟的市集里淘到的好宝贝！",
            "nextDialogs": [
              "765000106",
              "765000105"
            ]
          },
          "765000106": {
            "id": "765000106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听那个神神秘秘的卖家说，这可是几十年前，枫丹那位超级有名的摄影大师——皮埃尔·勒布朗先生用过的留影机哦！",
            "nextDialogs": [
              "765000107"
            ]
          },
          "765000107": {
            "id": "765000107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "据说啊，他当年用这台留影机拍摄的画片，每一张都很受欢迎，时不时就会登上《蒸汽鸟报》的头条呢！",
            "nextDialogs": [
              "765000108"
            ]
          },
          "765000108": {
            "id": "765000108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#如果{NICKNAME}也用上这么厉害的相机，说不定也能拍出传世名作呢！搞不好还能卖出天价！"
          },
          "765000105": {
            "id": "765000105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "才不是呢！这是我特意为你准备的惊喜礼物!"
          }
        }
      }
    }
  ]
}
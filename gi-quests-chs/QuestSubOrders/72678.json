    {
      "subId": "7267801",
      "subQuestName": "前往风龙废墟",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726780101"
        ],
        "dialogs": {
          "726780101": {
            "id": "726780101",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "好大的城市，但是…感觉，好荒凉。",
            "nextDialogs": [
              "726780102"
            ]
          },
          "726780102": {
            "id": "726780102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#以前，我和{NICKNAME}、还有很多同伴一起，曾经在这里和「风魔龙」战斗呢。",
            "nextDialogs": [
              "726780103"
            ]
          },
          "726780103": {
            "id": "726780103",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "是那种，身体大大，翅膀飞飞、牙齿尖尖，很可怕的龙吗？",
            "nextDialogs": [
              "726780106"
            ]
          },
          "726780106": {
            "id": "726780106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "吉法师还记得，之前我们在蒙德城看到的风神像吗？",
            "nextDialogs": [
              "726780107"
            ]
          },
          "726780107": {
            "id": "726780107",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "风神像…？",
            "nextDialogs": [
              "726780108"
            ]
          },
          "726780108": {
            "id": "726780108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就是那个，好高好高的石头像啦。",
            "nextDialogs": [
              "726780109"
            ]
          },
          "726780109": {
            "id": "726780109",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "呶！记得。风神的手好大。",
            "nextDialogs": [
              "726780110"
            ]
          },
          "726780110": {
            "id": "726780110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「风魔龙」是风神的好朋友呢！以前，风神也是从这个「城市」来的…",
            "nextDialogs": [
              "726780111"
            ]
          },
          "726780111": {
            "id": "726780111",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "喔！",
            "nextDialogs": [
              "726780112"
            ]
          },
          "726780112": {
            "id": "726780112",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "但是，如果风风龙很大，那要怎么进来呢？"
          }
        }
      }
    },
    {
      "subId": "7267802",
      "subQuestName": "为吉法师拍照",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7267803",
      "subQuestName": "与吉法师对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726780301"
        ],
        "dialogs": {
          "726780301": {
            "id": "726780301",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "呶…很好看…",
            "nextDialogs": [
              "726780302"
            ]
          },
          "726780302": {
            "id": "726780302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "吉法师，你怎么啦？",
            "nextDialogs": [
              "726780303"
            ]
          },
          "726780303": {
            "id": "726780303",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "这个城市很荒凉，感觉有点难过，不知道为什么。奇怪。",
            "nextDialogs": [
              "726780306"
            ]
          },
          "726780306": {
            "id": "726780306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "接下来，我们就向「城市」的中心前进吧。"
          }
        }
      }
    },
    {
      "subId": "7267804",
      "subQuestName": "向风龙废墟的高塔前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726780401"
        ],
        "dialogs": {
          "726780401": {
            "id": "726780401",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "呜呶呶…风好大…",
            "nextDialogs": [
              "726780402"
            ]
          },
          "726780402": {
            "id": "726780402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里的风墙，是过不去的喔！要绕路走才行。",
            "nextDialogs": [
              "726780403"
            ]
          },
          "726780403": {
            "id": "726780403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "吉法师，跟着我们慢慢从旁边绕上去吧。"
          }
        }
      }
    },
    {
      "subId": "7267809",
      "subQuestName": "沿着风龙废墟的高塔前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7267805",
      "subQuestName": "沿着风龙废墟的高塔前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726780501"
        ],
        "dialogs": {
          "726780501": {
            "id": "726780501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "终于上来了！",
            "nextDialogs": [
              "726780502"
            ]
          },
          "726780502": {
            "id": "726780502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里的视线，比下面好多了。你看，那边就是我们来的地方。",
            "nextDialogs": [
              "726780503"
            ]
          },
          "726780503": {
            "id": "726780503",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "派蒙很喜欢高的地方？",
            "nextDialogs": [
              "726780507",
              "726780506"
            ]
          },
          "726780507": {
            "id": "726780507",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "风风龙睡在这个塔里面吗？",
            "nextDialogs": [
              "726780508"
            ]
          },
          "726780508": {
            "id": "726780508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，在里面睡了好久好久。",
            "nextDialogs": [
              "726780509"
            ]
          },
          "726780509": {
            "id": "726780509",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#虽然{NICKNAME}和「风魔龙」战斗，但是它不是坏龙。",
            "nextDialogs": [
              "726780510"
            ]
          },
          "726780510": {
            "id": "726780510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "只是遇到了难过的事情，受了伤害，又被坏人骗了，所以以为，风神朋友不要它了。",
            "nextDialogs": [
              "726780511"
            ]
          },
          "726780511": {
            "id": "726780511",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "呶…后来呢？",
            "nextDialogs": [
              "726780512"
            ]
          },
          "726780512": {
            "id": "726780512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#后来呀…{NICKNAME}，你还记得吗？",
            "nextDialogs": [
              "726780513"
            ]
          },
          "726780513": {
            "id": "726780513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们在战斗中，净化了「毒血」。",
            "nextDialogs": [
              "726780514"
            ]
          },
          "726780514": {
            "id": "726780514",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但是，战斗的平台也坍塌了。本来，我们，还有风神都要掉到好深好深、好黑好黑的地方去…",
            "nextDialogs": [
              "726780515"
            ]
          },
          "726780515": {
            "id": "726780515",
            "speakerId": 1000,
            "speakerName": "「吉法师」",
            "text": "#呶！好可怕…那么，派蒙和{NICKNAME}怎么办？飞出来？"
          },
          "726780506": {
            "id": "726780506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！才不是这么回事啦。在高的地方，视野很好，而且空气也比较清新。"
          }
        }
      }
    },

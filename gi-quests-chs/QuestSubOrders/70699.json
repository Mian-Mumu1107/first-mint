  "subQuests": [
    {
      "subId": "7069901",
      "subQuestName": "与米卡对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706990101"
        ],
        "dialogs": {
          "706990101": {
            "id": "706990101",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "能请到荣誉骑士前辈试玩游艺项目，实在是太幸运了，感觉安心了不少！",
            "nextDialogs": [
              "706990102"
            ]
          },
          "706990102": {
            "id": "706990102",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "说实话，我还是第一次参与这种开发工作呢，有点紧张，感觉脑力常常不够用…",
            "nextDialogs": [
              "706990103"
            ]
          },
          "706990103": {
            "id": "706990103",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "明明只是给一个成熟的机关装上外壳，却要顾及方方面面的设计，调试许多参数…",
            "nextDialogs": [
              "706990104"
            ]
          },
          "706990104": {
            "id": "706990104",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "要是像阿贝多长官那样，从零开始制作专用装备，不知道会遇见多少难题！",
            "nextDialogs": [
              "706990107"
            ]
          },
          "706990107": {
            "id": "706990107",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "呜啊…谢谢…谢谢荣誉骑士前辈的肯定！",
            "nextDialogs": [
              "706990108"
            ]
          },
          "706990108": {
            "id": "706990108",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "我，我会加油的，争取以后能独自为游击小队开发出更多实用的东西…",
            "nextDialogs": [
              "706990109"
            ]
          },
          "706990109": {
            "id": "706990109",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "之前我赢来了几只玩偶，这一只送给你…",
            "nextDialogs": [
              "706990110"
            ]
          },
          "706990110": {
            "id": "706990110",
            "speakerId": 1000,
            "speakerName": "米卡",
            "text": "我有一只一样的，以后，只要看到这个玩偶，我就能想起你给我的鼓励！"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7620702",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762070201"
        ],
        "dialogs": {
          "762070201": {
            "id": "762070201",
            "speakerId": 1002,
            "speakerName": "托萨利斯",
            "text": "啊…我曾是语言，如今却沦为了错觉破碎的主体，再度回归这不完美的「象征」。",
            "nextDialogs": [
              "762070202"
            ]
          },
          "762070202": {
            "id": "762070202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！奇怪的家伙说着奇怪的话从奇怪的书里出现了！",
            "nextDialogs": [
              "762070203"
            ]
          },
          "762070203": {
            "id": "762070203",
            "speakerId": 1002,
            "speakerName": "托萨利斯",
            "text": "「奇怪」是一种不严谨的表达。它意味着无法被描述、无法被书写、无法被表征的特殊性主体，而我显然不符合这个定义。",
            "nextDialogs": [
              "762070204"
            ]
          },
          "762070204": {
            "id": "762070204",
            "speakerId": 1002,
            "speakerName": "托萨利斯",
            "text": "我不过是试图在书页中寻找通往「实在」的入口，却不慎滑入了无限延宕的隐喻中…",
            "nextDialogs": [
              "762070205"
            ]
          },
          "762070205": {
            "id": "762070205",
            "speakerId": 1002,
            "speakerName": "托萨利斯",
            "text": "我成为了无法被象征化的剩余，多亏你的介入，我才得以从语言的暴政中被剥离，可以重新开始误认我自己了。",
            "nextDialogs": [
              "762070206"
            ]
          },
          "762070206": {
            "id": "762070206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说人话。",
            "nextDialogs": [
              "762070207"
            ]
          },
          "762070207": {
            "id": "762070207",
            "speakerId": 1002,
            "speakerName": "托萨利斯",
            "text": "…我不小心掉进书页里出不来了，谢谢你把我拉出来。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7471601",
      "subQuestName": "与菲米尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747160101"
        ],
        "dialogs": {
          "747160101": {
            "id": "747160101",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "太好了…这下，最主要的水下废弃物基本被打捞完了。",
            "nextDialogs": [
              "747160102"
            ]
          },
          "747160102": {
            "id": "747160102",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "#让你们受累了，{NICKNAME}和派蒙。",
            "nextDialogs": [
              "747160103"
            ]
          },
          "747160103": {
            "id": "747160103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没有啦没有啦，比起受累这种说法，我更愿意说这次是收获满满哦。",
            "nextDialogs": [
              "747160106"
            ]
          },
          "747160106": {
            "id": "747160106",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "谢谢你们…托你们的福，我才度过了一段愉快而又充实的时光。",
            "nextDialogs": [
              "747160107"
            ]
          },
          "747160107": {
            "id": "747160107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不用客气，这是大家的共同努力！而且，我觉得菲米尼也很有进步呢，水下和水上的时候都可靠。",
            "nextDialogs": [
              "747160108"
            ]
          },
          "747160108": {
            "id": "747160108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别害羞。",
            "nextDialogs": [
              "747160109"
            ]
          },
          "747160109": {
            "id": "747160109",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "好…好的。",
            "nextDialogs": [
              "747160110"
            ]
          },
          "747160110": {
            "id": "747160110",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "……",
            "nextDialogs": [
              "747160111"
            ]
          },
          "747160111": {
            "id": "747160111",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "抱歉，除了感谢的话，我还是不知道这种时候应该说些什么。",
            "nextDialogs": [
              "747160112"
            ]
          },
          "747160112": {
            "id": "747160112",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "可能…我还需要再多练习一段时间？",
            "nextDialogs": [
              "747160113"
            ]
          },
          "747160113": {
            "id": "747160113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "慢慢来，不着急。即使是练习，也按照自己的节奏一点一点努力就行啦。"
          }
        }
      }
    },

    {
      "subId": "2006204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200620401"
        ],
        "dialogs": {
          "200620401": {
            "id": "200620401",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "你找到木桩了吗",
            "nextDialogs": [
              "200620402"
            ]
          },
          "200620402": {
            "id": "200620402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没找到。",
            "nextDialogs": [
              "200620403"
            ]
          },
          "200620403": {
            "id": "200620403",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "艾琳正在努力训练，我能为她做的也就这些了…",
            "nextDialogs": [
              "200620404"
            ]
          },
          "200620404": {
            "id": "200620404",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "如果我还是个冒险家，就能自己去拿了。",
            "nextDialogs": [
              "200620405"
            ]
          },
          "200620405": {
            "id": "200620405",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "而且就蒙德城冒险家协会的现状…我的那些前「同伴」们，大部分也都不干冒险家这行了。",
            "nextDialogs": [
              "200620406"
            ]
          },
          "200620406": {
            "id": "200620406",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "这也没办法，蒙德城里的西风骑士团这么强势，年轻人都想去做西风骑士，至于在野外摸爬滚打的冒险家…",
            "nextDialogs": [
              "200620407"
            ]
          },
          "200620407": {
            "id": "200620407",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "早就没多少人愿意做咯——"
          }
        }
      }
    },
    {
      "subId": "2006207",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200620701"
        ],
        "dialogs": {
          "200620701": {
            "id": "200620701",
            "speakerId": 1001,
            "speakerName": "艾琳",
            "text": "哈…老爸说给我找的「训练器材」就是这个吗？",
            "nextDialogs": [
              "200620702"
            ]
          },
          "200620702": {
            "id": "200620702",
            "speakerId": 1001,
            "speakerName": "艾琳",
            "text": "总感觉我稍微一动手，这个木桩就散架了。",
            "nextDialogs": [
              "200620703"
            ]
          },
          "200620703": {
            "id": "200620703",
            "speakerId": 1001,
            "speakerName": "艾琳",
            "text": "不过，有总比没有好，过一会就开始训练吧。"
          }
        }
      }
    }
  ]
}
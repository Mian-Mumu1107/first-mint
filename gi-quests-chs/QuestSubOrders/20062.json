  },
  "subQuests": [
    {
      "subId": "2006201",
      "subQuestName": "与赫尔曼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200620101"
        ],
        "dialogs": {
          "200620101": {
            "id": "200620101",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "到底怎么办呢…",
            "nextDialogs": [
              "200620102"
            ]
          },
          "200620102": {
            "id": "200620102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "200620103"
            ]
          },
          "200620103": {
            "id": "200620103",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "是这样的…我女儿艾琳想要进入西风骑士团，正在为骑士选拔做准备。",
            "nextDialogs": [
              "200620104"
            ]
          },
          "200620104": {
            "id": "200620104",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "唉…我本来想要自己指导她，但是她怎么样也不相信我之前是个冒险家，坚持自己训练。",
            "nextDialogs": [
              "200620105"
            ]
          },
          "200620105": {
            "id": "200620105",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "我也没办法证明给她看…有了老婆孩子之后，我已经没有到处肆意冒险的资本了。",
            "nextDialogs": [
              "200620106"
            ]
          },
          "200620106": {
            "id": "200620106",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "比起满足自己的冒险欲望和自尊心，好好照顾家庭才是我现在最重要的责任。",
            "nextDialogs": [
              "200620107"
            ]
          },
          "200620107": {
            "id": "200620107",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "哈哈，不过我这个「冒险家」，终归还是能做点事的。",
            "nextDialogs": [
              "200620108"
            ]
          },
          "200620108": {
            "id": "200620108",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "我之前到处冒险的时候，留意过那些丘丘人用来训练的木桩。",
            "nextDialogs": [
              "200620109"
            ]
          },
          "200620109": {
            "id": "200620109",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "那些木桩看着质量很不错，肯定很适合艾琳用来训练。",
            "nextDialogs": [
              "200620110"
            ]
          },
          "200620110": {
            "id": "200620110",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "帮我去找几个丘丘人训练木桩回来吧。按照冒险家的规矩，我也不会让你干白工的，你觉得怎么样？",
            "nextDialogs": [
              "200620113",
              "200620115"
            ]
          },
          "200620113": {
            "id": "200620113",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "哦，我就喜欢爽快的人，你很有我当年刚入行时的风采…",
            "nextDialogs": [
              "200620114"
            ]
          },
          "200620114": {
            "id": "200620114",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "开玩笑，开玩笑，好了，快点去吧。"
          },
          "200620115": {
            "id": "200620115",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "不，不行不行，冒险家的能力也是有极限的。一位冒险家，同时只能应付一场冒险。",
            "nextDialogs": [
              "200620116"
            ]
          },
          "200620116": {
            "id": "200620116",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "而「婚后生活」这场冒险…无论是多伟大的冒险家，都必须要全身心投入。",
            "nextDialogs": [
              "200620117"
            ]
          },
          "200620117": {
            "id": "200620117",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "所以，搜集木桩就拜托你了。"
          }
        }
      }
    },
    {
      "subId": "2006202",
      "subQuestName": "清剿魔物营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200620201"
        ],
        "dialogs": {
          "200620201": {
            "id": "200620201",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "你找到木桩了吗？",
            "nextDialogs": [
              "200620202"
            ]
          },
          "200620202": {
            "id": "200620202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "200620203"
            ]
          },
          "200620203": {
            "id": "200620203",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "唔…哈哈，你看，看着确实质量不错。",
            "nextDialogs": [
              "200620204"
            ]
          },
          "200620204": {
            "id": "200620204",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "这木桩能经得起丘丘人折腾，肯定也能经得起艾琳折腾。",
            "nextDialogs": [
              "200620205"
            ]
          },
          "200620205": {
            "id": "200620205",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "谢谢你，哦对了，按照冒险家的规矩，这是你的报酬。"
          }
        }
      }
    },
    {
      "subId": "2006205",
      "subQuestName": "(test)保证木桩存活$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200620501"
        ],
        "dialogs": {
          "200620501": {
            "id": "200620501",
            "speakerId": 1001,
            "speakerName": "艾琳",
            "text": "到底怎么训练才好呢…",
            "nextDialogs": [
              "200620502"
            ]
          },
          "200620502": {
            "id": "200620502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么？",
            "nextDialogs": [
              "200620503"
            ]
          },
          "200620503": {
            "id": "200620503",
            "speakerId": 1001,
            "speakerName": "艾琳",
            "text": "哦，我正在为了骑士选拔做训练呢。但是怎么样都不得要领，而且也没人指导我。",
            "nextDialogs": [
              "200620504"
            ]
          },
          "200620504": {
            "id": "200620504",
            "speakerId": 1001,
            "speakerName": "艾琳",
            "text": "我爸一个劲说他是冒险家，他可以指导我，但是我才不信呢…",
            "nextDialogs": [
              "200620505"
            ]
          },
          "200620505": {
            "id": "200620505",
            "speakerId": 1001,
            "speakerName": "艾琳",
            "text": "他那样子，怎么可能指导我通过骑士选拔啊。",
            "nextDialogs": [
              "200620506"
            ]
          },
          "200620506": {
            "id": "200620506",
            "speakerId": 1001,
            "speakerName": "艾琳",
            "text": "他还说要帮我准备训练用的东西，他到底会准备什么呢…"
          }
        }
      }
    },
    {
      "subId": "2006203",
      "subQuestName": "取得训练用木桩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200620301"
        ],
        "dialogs": {
          "200620301": {
            "id": "200620301",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "你找到木桩了吗？",
            "nextDialogs": [
              "200620302"
            ]
          },
          "200620302": {
            "id": "200620302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了，可是…",
            "nextDialogs": [
              "200620303"
            ]
          },
          "200620303": {
            "id": "200620303",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "哈…你下手也太狠了，这么结实的木桩都被打散架了。",
            "nextDialogs": [
              "200620304"
            ]
          },
          "200620304": {
            "id": "200620304",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "不过在战斗的时候，确实不会有人顾得上为了个木桩收手…",
            "nextDialogs": [
              "200620305"
            ]
          },
          "200620305": {
            "id": "200620305",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "虽然不能直接给艾琳…但材料已经有了，我来加工一下就好。",
            "nextDialogs": [
              "200620306"
            ]
          },
          "200620306": {
            "id": "200620306",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "勉强是组装起来了，你看，呃…还是有点模样的，对吧？",
            "nextDialogs": [
              "200620307"
            ]
          },
          "200620307": {
            "id": "200620307",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "总之谢谢你了。这是报酬，我说了不会让你打白工的。",
            "nextDialogs": [
              "200620308"
            ]
          },
          "200620308": {
            "id": "200620308",
            "speakerId": 1000,
            "speakerName": "赫尔曼",
            "text": "虽然我不是冒险家了，但是冒险家的规矩可不能坏啊。"
          }
        }
      }
    },

    {
      "subId": "2006206",
      "subQuestName": "捡起训练用木桩材料",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200620601"
        ],
        "dialogs": {
          "200620601": {
            "id": "200620601",
            "speakerId": 1001,
            "speakerName": "艾琳",
            "text": "这个木桩可真不错，这下子我训练起来可方便了不少。",
            "nextDialogs": [
              "200620602"
            ]
          },
          "200620602": {
            "id": "200620602",
            "speakerId": 1001,
            "speakerName": "艾琳",
            "text": "不过，这么结实的木桩，老爸到底是从哪弄来的呢？",
            "nextDialogs": [
              "200620603"
            ]
          },
          "200620603": {
            "id": "200620603",
            "speakerId": 1001,
            "speakerName": "艾琳",
            "text": "不，不会是买的吧！这得花多少钱啊…"
          }
        }
      }
    },
    {
      "subId": "2006207",
      "subQuestName": "与赫尔曼对话",
      "sceneId": null,
      "locations": [],

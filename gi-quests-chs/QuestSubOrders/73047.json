  "subQuests": [
    {
      "subId": "7304701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730470101"
        ],
        "dialogs": {
          "730470101": {
            "id": "730470101",
            "speakerId": 4184,
            "speakerName": "兰拉迦",
            "text": "#那菈{NICKNAME}、派蒙，又见面了。呵呵呵…",
            "nextDialogs": [
              "730470102"
            ]
          },
          "730470102": {
            "id": "730470102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰拉迦看起来很开心呢！",
            "nextDialogs": [
              "730470103"
            ]
          },
          "730470103": {
            "id": "730470103",
            "speakerId": 4184,
            "speakerName": "兰拉迦",
            "text": "呵呵呵…老身看到桓那兰那这么热闹，有这么多兰那罗回家了，真是太高兴了。哎呀，没想到能亲身参与无忧节…",
            "nextDialogs": [
              "730470107",
              "730470106"
            ]
          },
          "730470107": {
            "id": "730470107",
            "speakerId": 4184,
            "speakerName": "兰拉迦",
            "text": "老身在故事中，曾经参与过一次。那是很久很久以前的故事…",
            "nextDialogs": [
              "730470108"
            ]
          },
          "730470108": {
            "id": "730470108",
            "speakerId": 4184,
            "speakerName": "兰拉迦",
            "text": "老身、兰穆护昆达、兰拉娜、兰拉吉…我们许许多多的兰那罗，与那菈法留纳一同，庆祝无忧节。",
            "nextDialogs": [
              "730470109"
            ]
          },
          "730470109": {
            "id": "730470109",
            "speakerId": 4184,
            "speakerName": "兰拉迦",
            "text": "那是十分艰难的时期。但是，在无忧节中，我们还是一同欢笑、歌唱。老身非常喜欢这个故事。",
            "nextDialogs": [
              "730470110"
            ]
          },
          "730470110": {
            "id": "730470110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，兰拉迦这不是参加过吗…？",
            "nextDialogs": [
              "730470111"
            ]
          },
          "730470111": {
            "id": "730470111",
            "speakerId": 4184,
            "speakerName": "兰拉迦",
            "text": "喔，在故事中，确实参加过。但是，老身已经不记得了。那些故事，都是兰拉娜他们后来告诉老身的。",
            "nextDialogs": [
              "730470112"
            ]
          },
          "730470112": {
            "id": "730470112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…感觉兰拉迦说话像老爷爷似的，可能是因为年纪大了，记不清了吧！",
            "nextDialogs": [
              "730470113"
            ]
          },
          "730470113": {
            "id": "730470113",
            "speakerId": 4184,
            "speakerName": "兰拉迦",
            "text": "#或许是这样也不错…不管怎么说，那菈{NICKNAME}、派蒙，你们愿意收下这个吗？",
            "nextDialogs": [
              "730470114"
            ]
          },
          "730470114": {
            "id": "730470114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是小花…",
            "nextDialogs": [
              "730470115"
            ]
          },
          "730470115": {
            "id": "730470115",
            "speakerId": 4184,
            "speakerName": "兰拉迦",
            "text": "嗯。希望在未来的旅途中，这朵花能一直陪伴着你们。"
          },
          "730470106": {
            "id": "730470106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我也很开心！不过，兰拉迦以前没有参加过无忧节吗？"
          }
        }
      }
    }
  ]
}
    {
      "subId": "4008517",
      "subQuestName": "前往赛场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400851601"
        ],
        "dialogs": {
          "400851601": {
            "id": "400851601",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "#诸位观众与选手，经历多场激烈角逐后，「月莲杯」的决赛总算要开幕了。驯兽师海妮耶将与旅行者{NICKNAME}一较高下！",
            "nextDialogs": [
              "400851602"
            ]
          },
          "400851602": {
            "id": "400851602",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "他们之中的胜者若是能通过最终考验，就能获得我的全部财产，接过继续举办这场大赛的责任，向全提瓦特继续传播和平之道…",
            "nextDialogs": [
              "400851603"
            ]
          },
          "400851603": {
            "id": "400851603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "今天考特里亚没在场…是个好机会！决赛和最终考验之后，我们先去提醒埃尔欣根，然后再找考特里亚当面对质吧！",
            "nextDialogs": [
              "400851604"
            ]
          },
          "400851604": {
            "id": "400851604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神子、莱依拉，你们来了！",
            "nextDialogs": [
              "400851605"
            ]
          },
          "400851605": {
            "id": "400851605",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向神子和莱依拉讲述了和海妮耶的沟通过程，以及接下来的计划。",
            "nextDialogs": [
              "400851606"
            ]
          },
          "400851606": {
            "id": "400851606",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "不出所料，急躁的学术狂人终究在两位主角的面前露出了马脚…你们的推测或许接近真相了哦。",
            "nextDialogs": [
              "400851607"
            ]
          },
          "400851607": {
            "id": "400851607",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "暂时不向教令院上报的决定也相当谨慎，说不定考特里亚…或是其他什么人还留了一手呢？",
            "nextDialogs": [
              "400851608"
            ]
          },
          "400851608": {
            "id": "400851608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在的情况也容不得我们放松警惕吧，毕竟要和那个最强的海妮耶对战了，也不知道埃尔欣根的「最终考验」到底是什么情况。",
            "nextDialogs": [
              "400851609"
            ]
          },
          "400851609": {
            "id": "400851609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但我们还不知道怎么说服海妮耶…",
            "nextDialogs": [
              "400851610"
            ]
          },
          "400851610": {
            "id": "400851610",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "答案已经很明显了吧？",
            "nextDialogs": [
              "400851611"
            ]
          },
          "400851611": {
            "id": "400851611",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "带上我们的蕈兽，干净利落地打败海妮耶，让她放弃油盐不进的态度，老老实实听你们说明真相。",
            "nextDialogs": [
              "400851612"
            ]
          },
          "400851612": {
            "id": "400851612",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "我相信你们，呼…你们一定可以让海妮耶走出误区！",
            "nextDialogs": [
              "400851613"
            ]
          },
          "400851613": {
            "id": "400851613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感谢你们的支持！",
            "nextDialogs": [
              "400851614"
            ]
          },
          "400851614": {
            "id": "400851614",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好呀！「咚咚小圆帽」、「转转悠悠兽」和「百雷遮罗」，三个最熟悉的伙伴要并肩战斗了！",
            "nextDialogs": [
              "400851615"
            ]
          },
          "400851615": {
            "id": "400851615",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在我们集结了大家的力量，绝对不会输的！"
          }
        }
      }
    },

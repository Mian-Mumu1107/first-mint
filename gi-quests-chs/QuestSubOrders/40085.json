    {
      "subId": "4008502",
      "subQuestName": "击败海妮耶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400851501"
        ],
        "dialogs": {
          "400851501": {
            "id": "400851501",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "#终于等到这一天了，{NICKNAME}，派蒙。",
            "nextDialogs": [
              "400851502"
            ]
          },
          "400851502": {
            "id": "400851502",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "我早就告诫过你们，不要对蕈兽抱有多余的情感，要将它们当成棋子指挥…",
            "nextDialogs": [
              "400851503"
            ]
          },
          "400851503": {
            "id": "400851503",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "现在看来，你们并没有改观。所以，这场比赛会毫无悬念地结束。",
            "nextDialogs": [
              "400851506"
            ]
          },
          "400851506": {
            "id": "400851506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说得对！我们和「咚咚小圆帽」，还有其他伙伴的默契绝对不会输！",
            "nextDialogs": [
              "400851507"
            ]
          },
          "400851507": {
            "id": "400851507",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "唉…就让你们见识一下好了，你们那软弱的打法和真正的驯兽师之间的差距…「火一」！"
          }
        }
      }
    },
    {
      "subId": "4008515",

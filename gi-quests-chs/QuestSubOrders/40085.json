    {
      "subId": "4008505",
      "subQuestName": "与海妮耶对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400850501"
        ],
        "dialogs": {
          "400850501": {
            "id": "400850501",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "失败了…我还没能走出最重要的一步，居然就失败了…",
            "nextDialogs": [
              "400850502"
            ]
          },
          "400850502": {
            "id": "400850502",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "结果你们两个，还是成了最大的变数…但只凭那种幼稚的想法，为什么能赢过我？",
            "nextDialogs": [
              "400850505"
            ]
          },
          "400850505": {
            "id": "400850505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "海妮耶，按照约定，我们赢了你之后，你会好好听我们讲道理。",
            "nextDialogs": [
              "400850506"
            ]
          },
          "400850506": {
            "id": "400850506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "道理之后再说，先让「火一」跟着我们去接受最终考验，可以吗？",
            "nextDialogs": [
              "400850507"
            ]
          },
          "400850507": {
            "id": "400850507",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "「火一」？你们要带上它？",
            "nextDialogs": [
              "400850508"
            ]
          },
          "400850508": {
            "id": "400850508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！「咚咚小圆帽」、「转转悠悠兽」、「百雷遮罗」和你的「火一」，我们要用大家的蕈兽一起通过最终考验。"
          }
        }
      }
    },
    {
      "subId": "4008508",
      "subQuestName": "与埃尔欣根对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400850801"
        ],
        "dialogs": {
          "400850801": {
            "id": "400850801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么回事…怎么到处都是愚人众？",
            "nextDialogs": [
              "400850802"
            ]
          },
          "400850802": {
            "id": "400850802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "埃尔欣根！赛场被坏人入侵了！你快逃，我们来对付他们！",
            "nextDialogs": [
              "400850803"
            ]
          },
          "400850803": {
            "id": "400850803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，说起来，出口在哪？",
            "nextDialogs": [
              "400850806"
            ]
          },
          "400850806": {
            "id": "400850806",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "不愧是旅行者，看得很通透。对于这种绝境，你也准备了应对方案吗？",
            "nextDialogs": [
              "400850807"
            ]
          },
          "400850807": {
            "id": "400850807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我不明白…现在不是在最终考验吗？幕后黑手不应该是考特里亚吗！他想利用这场比赛取得成就，所以骗你给他出钱…",
            "nextDialogs": [
              "400850808"
            ]
          },
          "400850808": {
            "id": "400850808",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "只差一点就抵达真相了。考特里亚的动机确实如此，他发掘的失落技术，有着绝佳的潜力。",
            "nextDialogs": [
              "400850809"
            ]
          },
          "400850809": {
            "id": "400850809",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "所以我才买下了他，举办了这场比赛，扩大这项技术的影响力。当然，我没想到，你这样的高价值目标居然会主动咬钩。"
          }
        }
      }
    },

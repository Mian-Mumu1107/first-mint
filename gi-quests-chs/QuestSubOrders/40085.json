    {
      "subId": "4008509",
      "subQuestName": "与八重神子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400850901"
        ],
        "dialogs": {
          "400850901": {
            "id": "400850901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「咚咚小圆帽」！你不要紧吧！",
            "nextDialogs": [
              "400850902"
            ]
          },
          "400850902": {
            "id": "400850902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "以一敌三太勉强了…",
            "nextDialogs": [
              "400850903"
            ]
          },
          "400850903": {
            "id": "400850903",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "不对劲，明明对那只浮游水蕈兽发动了三次后门指令，为什么它还在听从旅行者的指挥？",
            "nextDialogs": [
              "400850904"
            ]
          },
          "400850904": {
            "id": "400850904",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "考特里亚的设备失灵了？",
            "nextDialogs": [
              "400850905"
            ]
          },
          "400850905": {
            "id": "400850905",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "啊呀，看来你还没有意识到呢。",
            "nextDialogs": [
              "400850906"
            ]
          },
          "400850906": {
            "id": "400850906",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "「意智宝珠」所用的技术确实可以让蕈兽听令于驯兽师，可不过是压制本能，增强蕈兽作为「生物」与驯兽师的沟通效果罢了。",
            "nextDialogs": [
              "400850907"
            ]
          },
          "400850907": {
            "id": "400850907",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "这四只蕈兽对驯兽师的认可，他们之间的情感和默契，已经凌驾于「意智宝珠」的影响之上了。",
            "nextDialogs": [
              "400850908"
            ]
          },
          "400850908": {
            "id": "400850908",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "八重神子…你能破除封锁秘境的术法？",
            "nextDialogs": [
              "400850909"
            ]
          },
          "400850909": {
            "id": "400850909",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "只凭那些拙劣的模仿品，就想把我拦在外边？我似乎被小看了呢…",
            "nextDialogs": [
              "400850910"
            ]
          },
          "400850910": {
            "id": "400850910",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "还有东拼西凑出来的「后门指令」，你们还真以为自己完全没露出过破绽？",
            "nextDialogs": [
              "400850911"
            ]
          },
          "400850911": {
            "id": "400850911",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "真麻烦…",
            "nextDialogs": [
              "400850912"
            ]
          },
          "400850912": {
            "id": "400850912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神子，莱依拉！海妮耶也来了！",
            "nextDialogs": [
              "400850913"
            ]
          },
          "400850913": {
            "id": "400850913",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "埃尔欣根…原来你才是主谋？",
            "nextDialogs": [
              "400850914"
            ]
          },
          "400850914": {
            "id": "400850914",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "相比蕈兽的威胁，你的野心更不可饶恕…",
            "nextDialogs": [
              "400850915"
            ]
          },
          "400850915": {
            "id": "400850915",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "八重小姐…我们赶快去帮忙吧！",
            "nextDialogs": [
              "400850916"
            ]
          },
          "400850916": {
            "id": "400850916",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "别心急嘛，小莱依拉。这种时候就要好好看着哦，伙伴之间的默契，绝不会被世俗的阴谋和技术破坏。",
            "nextDialogs": [
              "400850917"
            ]
          },
          "400850917": {
            "id": "400850917",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "「百雷遮罗」，你的任务还没完成，怎么能屈服呢？",
            "nextDialogs": [
              "400850918"
            ]
          },
          "400850918": {
            "id": "400850918",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？快看，「百雷遮罗」好像恢复神智了！",
            "nextDialogs": [
              "400850919"
            ]
          },
          "400850919": {
            "id": "400850919",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "莫非，八重小姐所说的时机已经来了？",
            "nextDialogs": [
              "400850920"
            ]
          },
          "400850920": {
            "id": "400850920",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "「转转悠悠兽」，我相信你！打败那个骗子吧…呃咳咳咳！",
            "nextDialogs": [
              "400850921"
            ]
          },
          "400850921": {
            "id": "400850921",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "后门指令对蕈兽伙伴们的影响…正在消退！",
            "nextDialogs": [
              "400850922"
            ]
          },
          "400850922": {
            "id": "400850922",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "还在犹豫吗，海妮耶？",
            "nextDialogs": [
              "400850923"
            ]
          },
          "400850923": {
            "id": "400850923",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "你害怕看到…你一直想要当成「棋子」的蕈兽，始终坚信着你，让你不得不正视自己逃避的情感？",
            "nextDialogs": [
              "400850924"
            ]
          },
          "400850924": {
            "id": "400850924",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "但你的蕈兽似乎等不及了。脱离了「意智宝珠」的控制后，它也在等待你的命令呢。",
            "nextDialogs": [
              "400850925"
            ]
          },
          "400850925": {
            "id": "400850925",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "「火一」…你真的在等我吗？",
            "nextDialogs": [
              "400850926"
            ]
          },
          "400850926": {
            "id": "400850926",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "对不起，我一直对你这么苛刻，你还相信着我…",
            "nextDialogs": [
              "400850927"
            ]
          },
          "400850927": {
            "id": "400850927",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "去做你该做的事吧。",
            "nextDialogs": [
              "400850928"
            ]
          },
          "400850928": {
            "id": "400850928",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然不知道是什么原理，但蕈兽们全都清醒过来了！太好了！",
            "nextDialogs": [
              "400850929"
            ]
          },
          "400850929": {
            "id": "400850929",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "埃尔欣根！你这个卑鄙的家伙，准备好迎接我们的怒火了吗！",
            "nextDialogs": [
              "400850930"
            ]
          },
          "400850930": {
            "id": "400850930",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "有序迎战，不要慌。对方只是蕈兽罢了，优势依然在我们这边。"
          }
        }
      }
    },
    {
      "subId": "4008511",
      "subQuestName": "击败愚人众",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008510",
      "subQuestName": "追击埃尔欣根",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400851001"
        ],
        "dialogs": {
          "400851001": {
            "id": "400851001",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "居然败给了一群蕈兽…实在太荒唐了！",
            "nextDialogs": [
              "400851002"
            ]
          },
          "400851002": {
            "id": "400851002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哪里逃！",
            "nextDialogs": [
              "400851003"
            ]
          },
          "400851003": {
            "id": "400851003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神子，你怎么不拦住他啊？",
            "nextDialogs": [
              "400851004"
            ]
          },
          "400851004": {
            "id": "400851004",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "嗯？作为游客，我似乎没有在须弥境内逮捕谁的权力。你们不也一样吗？",
            "nextDialogs": [
              "400851005"
            ]
          },
          "400851005": {
            "id": "400851005",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "不过，你们放心好了，他逃不掉的。回到赛场后，你们就明白了。",
            "nextDialogs": [
              "400851006"
            ]
          },
          "400851006": {
            "id": "400851006",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "来不及多想了，我们赶快追上去。"
          }
        }
      }
    },
    {
      "subId": "4008506",
      "subQuestName": "离开赛场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008512",
      "subQuestName": "与「三十人团」佣兵对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400851201"
        ],
        "dialogs": {
          "400851201": {
            "id": "400851201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们是…「三十人团」的佣兵？",
            "nextDialogs": [
              "400851202"
            ]
          },
          "400851202": {
            "id": "400851202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们总算出手了。",
            "nextDialogs": [
              "400851203"
            ]
          },
          "400851203": {
            "id": "400851203",
            "speakerId": 12862,
            "speakerName": "西达",
            "text": "受大风纪官赛诺所托，我们前来逮捕重犯埃尔欣根，和学术罪犯考特里亚。",
            "nextDialogs": [
              "400851204"
            ]
          },
          "400851204": {
            "id": "400851204",
            "speakerId": 12862,
            "speakerName": "西达",
            "text": "大风纪官盯上考特里亚很久了，只是他最近事务繁忙，暂时无法抽身应对这些宵小。多亏几位提供的证据，我们才能顺利收网。",
            "nextDialogs": [
              "400851205"
            ]
          },
          "400851205": {
            "id": "400851205",
            "speakerId": 12862,
            "speakerName": "西达",
            "text": "这里是大风纪官特意写给两位的信件，请过目。",
            "nextDialogs": [
              "400851206"
            ]
          },
          "400851206": {
            "id": "400851206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来赛诺一直在关注这场比赛，我们调查的时候，他也在暗中收集线索，正好给我们准备了一份保险！",
            "nextDialogs": [
              "400851209"
            ]
          },
          "400851209": {
            "id": "400851209",
            "speakerId": 12862,
            "speakerName": "西达",
            "text": "那么，我就将疑犯们带走了。有你们在这里，赛场秩序也无需我们操心。",
            "nextDialogs": [
              "400851210"
            ]
          },
          "400851210": {
            "id": "400851210",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "别急着庆祝，这事还没完…",
            "nextDialogs": [
              "400851211"
            ]
          },
          "400851211": {
            "id": "400851211",
            "speakerId": 12856,
            "speakerName": "埃尔欣根",
            "text": "我还会来找你们的，为了多托雷大人。",
            "nextDialogs": [
              "400851212"
            ]
          },
          "400851212": {
            "id": "400851212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还嘴硬什么！好好在监狱里忏悔吧，愚人众的大骗子！",
            "nextDialogs": [
              "400851213"
            ]
          },
          "400851213": {
            "id": "400851213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，赛诺的信里还提到了证据。这么说来，十六强赛以后，神子原来是去报案了？",
            "nextDialogs": [
              "400851214"
            ]
          },
          "400851214": {
            "id": "400851214",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "干嘛这样看着我？我也很苦恼嘛，明明是出来度假的，却总被各种各样的人找上…",
            "nextDialogs": [
              "400851215"
            ]
          },
          "400851215": {
            "id": "400851215",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "我只不过是带着编辑们在须弥城里转悠了几圈，和偶然遇见的大风纪官闲聊几句罢了，一切的关键还是你们搜集的线索。",
            "nextDialogs": [
              "400851216"
            ]
          },
          "400851216": {
            "id": "400851216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫…总觉得你越是轻描淡写，背后的过程就越复杂！",
            "nextDialogs": [
              "400851217"
            ]
          },
          "400851217": {
            "id": "400851217",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "话说回来，主办方和赞助商都被逮捕了，蕈兽们和这场比赛又该怎么办呢？",
            "nextDialogs": [
              "400851218"
            ]
          },
          "400851218": {
            "id": "400851218",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "规则就是规则，小家伙们夺得了冠军，也通过了最终考验，等于取代了埃尔欣根和考特里亚的地位。",
            "nextDialogs": [
              "400851219"
            ]
          },
          "400851219": {
            "id": "400851219",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "从今以后，大赛的一切都由小家伙们说了算哦。相信经历了这么多以后，他们肯定能作出最合理的决定。"
          }
        }
      }
    }
  ]
}
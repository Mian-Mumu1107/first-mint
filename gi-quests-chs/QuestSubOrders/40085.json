    {
      "subId": "4008504",
      "subQuestName": "与海妮耶对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400850401"
        ],
        "dialogs": {
          "400850401": {
            "id": "400850401",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "为什么会这样…「火一」？为什么不尽全力战斗？",
            "nextDialogs": [
              "400850404"
            ]
          },
          "400850404": {
            "id": "400850404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不要责怪「火一」，也不要勉强自己嘛，海妮耶。半决赛的时候，你明明因为「火一」受伤而犹豫过。",
            "nextDialogs": [
              "400850405"
            ]
          },
          "400850405": {
            "id": "400850405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "除了我们和神子，你大概没有碰到能和你较量的对手吧？也没有让「火一」和其他伙伴陷入过苦战。",
            "nextDialogs": [
              "400850406"
            ]
          },
          "400850406": {
            "id": "400850406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真正看到「火一」和其他同伴受伤的时候，你还是不忍心的。",
            "nextDialogs": [
              "400850407"
            ]
          },
          "400850407": {
            "id": "400850407",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "勉强自己？事到如今，你们还觉得我会因为蕈兽受伤而动情？"
          }
        }
      }
    },
    {
      "subId": "4008516",
      "subQuestName": "击败海妮耶",

      }
    },
    {
      "subId": "7003003",
      "subQuestName": "前往璃月港北侧一带寻找万叶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700300301"
        ],
        "dialogs": {
          "700300301": {
            "id": "700300301",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "风儿都还没有带回你的消息，你就已经出现了。真是让我大开眼界，你是怎么做到的？",
            "nextDialogs": [
              "700300302"
            ]
          },
          "700300302": {
            "id": "700300302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#嘿嘿，{NICKNAME}比你想象的还要厉害哦！",
            "nextDialogs": [
              "700300303"
            ]
          },
          "700300303": {
            "id": "700300303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "咳咳，这些够吗？",
            "nextDialogs": [
              "700300304"
            ]
          },
          "700300304": {
            "id": "700300304",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "给我看看。"
          }
        }
      }
    },
    {
      "subId": "7003004",
      "subQuestName": "前往璃月港北侧一带寻找万叶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700300201"
        ],
        "dialogs": {
          "700300201": {
            "id": "700300201",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "琴音嘒嘒，琴枕槁槁，独弦系世，独木终老…",
            "nextDialogs": [
              "700300202"
            ]
          },
          "700300202": {
            "id": "700300202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哟！万叶小兄弟！你在这里呀？我们来帮忙啦！",
            "nextDialogs": [
              "700300203"
            ]
          },
          "700300203": {
            "id": "700300203",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "哦？你们来了，好久不见。",
            "nextDialogs": [
              "700300204"
            ]
          },
          "700300204": {
            "id": "700300204",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "「万叶小兄弟」这个称呼，从派蒙嘴里说出来，倒确实别有一番风味。",
            "nextDialogs": [
              "700300205"
            ]
          },
          "700300205": {
            "id": "700300205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿嘿，我和重佐大副学的。",
            "nextDialogs": [
              "700300208"
            ]
          },
          "700300208": {
            "id": "700300208",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "哈哈，难道在你眼中，我是那种肩挑恶命、步履深沉之人吗？",
            "nextDialogs": [
              "700300209"
            ]
          },
          "700300209": {
            "id": "700300209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是重佐大副说你有事找我们啦，谁知道你这么悠哉，还在这看风景，还吟诗哦！",
            "nextDialogs": [
              "700300210"
            ]
          },
          "700300210": {
            "id": "700300210",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "稻妻事了，我已经心无他念。再访璃月，自然该广习此间诗赋，遍闻悬月妙音。",
            "nextDialogs": [
              "700300211"
            ]
          },
          "700300211": {
            "id": "700300211",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "至于请你们帮忙一事，原先是没有的，但可惜你们来迟了一步，所以现在有了。",
            "nextDialogs": [
              "700300212"
            ]
          },
          "700300212": {
            "id": "700300212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？好晕，「原先是没有的…所以现在又有了…」，什么嘛！",
            "nextDialogs": [
              "700300213"
            ]
          },
          "700300213": {
            "id": "700300213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你这家伙，是不是在山里吃了坏东西，怎么连话都说不明白了！",
            "nextDialogs": [
              "700300214"
            ]
          },
          "700300214": {
            "id": "700300214",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "嘘——二位请听。",
            "nextDialogs": [
              "700300215"
            ]
          },
          "700300215": {
            "id": "700300215",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "二位有什么感觉？",
            "nextDialogs": [
              "700300216"
            ]
          },
          "700300216": {
            "id": "700300216",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，这琴声…要我说的话，好像跟卖唱的弹的差不多嘛。",
            "nextDialogs": [
              "700300217"
            ]
          },
          "700300217": {
            "id": "700300217",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "哦，卖唱的？希望有日能结识一番。旅行者，你觉得呢？"
          }
        }
      }
    },
    {
      "subId": "7003006",
      "subQuestName": "寻找修复古琴所需的琉璃百合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7003007",
      "subQuestName": "将琉璃百合交给万叶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700300401"
        ],
        "dialogs": {
          "700300401": {
            "id": "700300401",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "嗯，品质很好，这些就足够了，将它们捣成汁液，浸入琴身，应该就能让古琴回春了。",
            "nextDialogs": [
              "700300402"
            ]
          },
          "700300402": {
            "id": "700300402",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "嗯——这熟悉的感觉。它醒了。",
            "nextDialogs": [
              "700300403"
            ]
          },
          "700300403": {
            "id": "700300403",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "#来，{NICKNAME}，试试吧，它就交给你了。",
            "nextDialogs": [
              "700300404"
            ]
          },
          "700300404": {
            "id": "700300404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我是什么意思？",
            "nextDialogs": [
              "700300405"
            ]
          },
          "700300405": {
            "id": "700300405",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "哈哈，难道诗人不可以直抒胸臆吗？「交给你」的意思就是：这把琴，送你了。",
            "nextDialogs": [
              "700300406"
            ]
          },
          "700300406": {
            "id": "700300406",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "再访璃月，我是来倾听这一方世界的。能在这片岩神守护的古老大地中，听见那些生生不息的低语，我很满足了。",
            "nextDialogs": [
              "700300407"
            ]
          },
          "700300407": {
            "id": "700300407",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "当然，要是哪天这琴你不要了，我会来拿的。但...希望永远不要有那一天。",
            "nextDialogs": [
              "700300408"
            ]
          },
          "700300408": {
            "id": "700300408",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "好了，我要继续上路了，这种时候璃月人会怎么说？啊，对了。",
            "nextDialogs": [
              "700300409"
            ]
          },
          "700300409": {
            "id": "700300409",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "#{NICKNAME}，「后会有期」！"
          }
        }
      }
    },

{
  "lineCounts": {
    "Player": 15,
    "枫原万叶": 39,
    "派蒙": 13,
    "重佐": 18
  },
  "subQuests": [
    {
      "subId": "7003001",
      "subQuestName": "前往璃月港口寻找大副重佐",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700300101"
        ],
        "dialogs": {
          "700300101": {
            "id": "700300101",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "哟！旅行者，好久不见，别来无恙啊！",
            "nextDialogs": [
              "700300102"
            ]
          },
          "700300102": {
            "id": "700300102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们见过吗？",
            "nextDialogs": [
              "700300103"
            ]
          },
          "700300103": {
            "id": "700300103",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "啊…你…居然就这样把我忘了吗？",
            "nextDialogs": [
              "700300104"
            ]
          },
          "700300104": {
            "id": "700300104",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "我是「死兆星」号的大副重佐啊，你之前还搭我们「死兆星」号去的稻妻呢。",
            "nextDialogs": [
              "700300105"
            ]
          },
          "700300105": {
            "id": "700300105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#没有没有，重佐大副，我们当然记得你啦，{NICKNAME}又在开玩笑了，哼哼。",
            "nextDialogs": [
              "700300106"
            ]
          },
          "700300106": {
            "id": "700300106",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "欸——我说呢！这才对嘛，毕竟我堂堂「死兆星」号的大副…",
            "nextDialogs": [
              "700300107"
            ]
          },
          "700300107": {
            "id": "700300107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "咳咳，有什么要帮忙吗？",
            "nextDialogs": [
              "700300108"
            ]
          },
          "700300108": {
            "id": "700300108",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "啊，其实不是我，是那位暂留在我们船队的万叶小兄弟。",
            "nextDialogs": [
              "700300109"
            ]
          },
          "700300109": {
            "id": "700300109",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "你应该有印象的吧？从稻妻返航的时候，他也跟着回来了。",
            "nextDialogs": [
              "700300110"
            ]
          },
          "700300110": {
            "id": "700300110",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "不知道怎么了，这一路上感觉他心情很不错，有事没事就拉着大家吟诗作歌。",
            "nextDialogs": [
              "700300111"
            ]
          },
          "700300111": {
            "id": "700300111",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "可惜我们船上，上到北斗大姐头、下到小月小丫头，哪找得出半个有这种…有这种…嗯…",
            "nextDialogs": [
              "700300113",
              "700300115"
            ]
          },
          "700300113": {
            "id": "700300113",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "对！雅兴！哪找得出半个有这种雅兴的。",
            "nextDialogs": [
              "700300116"
            ]
          },
          "700300116": {
            "id": "700300116",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "所以啊，刚到璃月，他就下船游山玩水去了，看来真是被我们这帮大老粗憋坏啰。",
            "nextDialogs": [
              "700300117"
            ]
          },
          "700300117": {
            "id": "700300117",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "可他才走没多久，就传来讯息，拜托我们留意一下你的行踪。",
            "nextDialogs": [
              "700300118"
            ]
          },
          "700300118": {
            "id": "700300118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他遇到麻烦了吗？",
            "nextDialogs": [
              "700300119"
            ]
          },
          "700300119": {
            "id": "700300119",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "具体什么情况倒没提，只说要是见到了你，就请你前去一叙。",
            "nextDialogs": [
              "700300120"
            ]
          },
          "700300120": {
            "id": "700300120",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "听口气没那么要紧，但如果是小事，我想也用不着旅行者你出马吧？",
            "nextDialogs": [
              "700300121"
            ]
          },
          "700300121": {
            "id": "700300121",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#其实我们也经常处理小事的，是吧，{NICKNAME}？"
          },
          "700300115": {
            "id": "700300115",
            "speakerId": 1000,
            "speakerName": "重佐",
            "text": "不不，应该叫雅兴！哪找得出半个有这种雅兴的。"
          }
        }
      }
    },
    {
      "subId": "7003002",
      "subQuestName": "与大副重佐对话",
      "sceneId": null,
      "locations": [],

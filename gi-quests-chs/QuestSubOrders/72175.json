      }
    },
    {
      "subId": "7217510",
      "subQuestName": "向罗尔德交付「幽灯蕈」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721750301"
        ],
        "dialogs": {
          "721750301": {
            "id": "721750301",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "嗯…有这些的话应该足够了，谢谢你们！",
            "nextDialogs": [
              "721750302"
            ]
          },
          "721750302": {
            "id": "721750302",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "顺便，如果你们在岛上的「祭场」附近有什么发现的话，还望告知我一下。",
            "nextDialogs": [
              "721750303"
            ]
          },
          "721750303": {
            "id": "721750303",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "啊…对了，你们随身带着「留影机」，枫丹货，对吧？那东西还挺贵的…如果经费有宽裕的话，我也得给自己采购一台。",
            "nextDialogs": [
              "721750304"
            ]
          },
          "721750304": {
            "id": "721750304",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "听本地的历史作家所言，传说鹤观的古代原住民会用颜料将无法追忆的古老历史涂画在山洞内的岩壁上，往往存续超过千年…",
            "nextDialogs": [
              "721750305"
            ]
          },
          "721750305": {
            "id": "721750305",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "此前的寻访中，我似乎也借着祭典的火光看到了些许图案…自此之后就难以忘怀，几天都没有睡好觉…",
            "nextDialogs": [
              "721750306"
            ]
          },
          "721750306": {
            "id": "721750306",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "这些壁画，据我所知从未有人目睹…假如能够借二位的口述得以证实的话，将会为「冒险家协会」在历史学术范畴带来又一大突破。",
            "nextDialogs": [
              "721750307"
            ]
          },
          "721750307": {
            "id": "721750307",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "所以我希望二位能寻到传说中的壁画，尽可能完整清晰地拍摄下来。我会买下你们的照片作为日志素材所需，并且为你们支付足够的辛苦费。",
            "nextDialogs": [
              "721750308"
            ]
          },
          "721750308": {
            "id": "721750308",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "不知两位意下如何？",
            "nextDialogs": [
              "721750310",
              "721750312"
            ]
          },
          "721750310": {
            "id": "721750310",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "非常感谢！"
          },
          "721750312": {
            "id": "721750312",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "我…我尽力而为。"
          }
        }
      }
    },
    {
      "subId": "7217504",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721750401"
        ],
        "dialogs": {
          "721750401": {
            "id": "721750401",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "两位好！最近有什么收获吗！",
            "nextDialogs": [
              "721750403",
              "721750406"
            ]
          },
          "721750403": {
            "id": "721750403",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "不用急躁，我一直在这里的。",
            "nextDialogs": [
              "721750404"
            ]
          },
          "721750404": {
            "id": "721750404",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "顺便，谢谢你送的「幽灯蕈」。很新鲜！",
            "nextDialogs": [
              "721750407"
            ]
          },
          "721750407": {
            "id": "721750407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说的倒是轻松，你吃的蘑菇不还是我们采的吗！",
            "nextDialogs": [
              "721750408"
            ]
          },
          "721750408": {
            "id": "721750408",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "哈哈，别在意那么多嘛，我一直在吃呢。",
            "nextDialogs": [
              "721750409"
            ]
          },
          "721750409": {
            "id": "721750409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇——这个健忘人！！"
          },
          "721750406": {
            "id": "721750406",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "累了的话也请休息一下，来点「幽灯蕈」吧！"
          }
        }
      }
    },
    {
      "subId": "7217505",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721750501"
        ],
        "dialogs": {
          "721750501": {
            "id": "721750501",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "（test）这些记录真的是太有价值了！",
            "nextDialogs": [
              "721750502"
            ]
          },
          "721750502": {
            "id": "721750502",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "（test）有了这些，日记就可以完成了！日志给你",
            "nextDialogs": [
              "721750503"
            ]
          },
          "721750503": {
            "id": "721750503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（test）好耶！"
          }
        }
      }
    },
    {
      "subId": "7217506",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721750601"
        ],
        "dialogs": {
          "721750601": {
            "id": "721750601",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "#你好啊，{NICKNAME}，还有多话的小精灵！",
            "nextDialogs": [
              "721750602"
            ]
          },
          "721750602": {
            "id": "721750602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好呀，健·忘·人！",
            "nextDialogs": [
              "721750603"
            ]
          },
          "721750603": {
            "id": "721750603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我·是·派·蒙！下次可不要忘记啦！",
            "nextDialogs": [
              "721750604"
            ]
          },
          "721750604": {
            "id": "721750604",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "我知道呀，小·派·蒙。",
            "nextDialogs": [
              "721750605"
            ]
          },
          "721750605": {
            "id": "721750605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！原来你在耍我！你这人的礼貌哪里去啦！",
            "nextDialogs": [
              "721750606"
            ]
          },
          "721750606": {
            "id": "721750606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哼，{NICKNAME}快把那些鬼里鬼气的蘑菇给他吧，我不要和他说话了！",
            "nextDialogs": [
              "721750607"
            ]
          },
          "721750607": {
            "id": "721750607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这些足够吗？"
          }
        }
      }
    },
    {
      "subId": "7217502",
      "subQuestName": "在遗迹里拍摄壁画",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721750201"
        ],
        "dialogs": {
          "721750201": {
            "id": "721750201",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "（test）太感谢了，这些壁画有很大的研究价值",
            "nextDialogs": [
              "721750202"
            ]
          },
          "721750202": {
            "id": "721750202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（test）好耶！参与写了冒险日志！",
            "nextDialogs": [
              "721750203"
            ]
          },
          "721750203": {
            "id": "721750203",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "（test）另外我听说这个岛上有会发光的奇怪蘑菇？整几个？",
            "nextDialogs": [
              "721750204"
            ]
          },
          "721750204": {
            "id": "721750204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（test）好嘞！使命必达！"
          }
        }
      }
    },
    {
      "subId": "7217518",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721751801"
        ],
        "dialogs": {
          "721751801": {
            "id": "721751801",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "#又见面了，{NICKNAME}！还有…那个…",
            "nextDialogs": [
              "721751802"
            ]
          },
          "721751802": {
            "id": "721751802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…？",
            "nextDialogs": [
              "721751803"
            ]
          },
          "721751803": {
            "id": "721751803",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "顺便一问，这个飞来飞去的小家伙怎么卖？看上去蛮有趣的。",
            "nextDialogs": [
              "721751804"
            ]
          },
          "721751804": {
            "id": "721751804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！",
            "nextDialogs": [
              "721751806",
              "721751808"
            ]
          },
          "721751806": {
            "id": "721751806",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "明显不太好吧！这家伙怎么突然失忆了！",
            "nextDialogs": [
              "721751809"
            ]
          },
          "721751809": {
            "id": "721751809",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "你们在说什…噗…",
            "nextDialogs": [
              "721751810"
            ]
          },
          "721751810": {
            "id": "721751810",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "噗…哈哈哈哈哈！",
            "nextDialogs": [
              "721751811"
            ]
          },
          "721751811": {
            "id": "721751811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "？？",
            "nextDialogs": [
              "721751812"
            ]
          },
          "721751812": {
            "id": "721751812",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "？？？",
            "nextDialogs": [
              "721751813"
            ]
          },
          "721751813": {
            "id": "721751813",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "哈哈哈哈…咳咳…哈哈哈哈哈！瞧瞧…瞧瞧你们那副表情！噗哈哈哈哈哈！",
            "nextDialogs": [
              "721751814"
            ]
          },
          "721751814": {
            "id": "721751814",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "完了…我笑岔气了…对不…对不起…这是…呵哈哈哈哈…这是我最喜欢的「健忘笑话」！",
            "nextDialogs": [
              "721751815"
            ]
          },
          "721751815": {
            "id": "721751815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一点也不好笑吧！！"
          },
          "721751808": {
            "id": "721751808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀，对呀！怎么还恶化了！"
          }
        }
      }
    },

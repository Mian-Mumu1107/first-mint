    "罗尔德": 70
  },
  "subQuests": [
    {
      "subId": "7217501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721750101"
        ],
        "dialogs": {
          "721750101": {
            "id": "721750101",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "没想到你们也还在这座岛上，真是太好了。",
            "nextDialogs": [
              "721750102"
            ]
          },
          "721750102": {
            "id": "721750102",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "你们近来如何？有没有什么惊人的发现？说来让我听听嘛。",
            "nextDialogs": [
              "721750104",
              "721750106"
            ]
          },
          "721750104": {
            "id": "721750104",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "难免的，难免的！这样一座岛屿上从来不缺少秘密，相信你一定能有所发现的。",
            "nextDialogs": [
              "721750107"
            ]
          },
          "721750107": {
            "id": "721750107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说回来，罗尔德先生在这里做什么呀？",
            "nextDialogs": [
              "721750108"
            ]
          },
          "721750108": {
            "id": "721750108",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "嗯？我刚收拾好营地行李，正准备离开呢。",
            "nextDialogs": [
              "721750109"
            ]
          },
          "721750109": {
            "id": "721750109",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "这座岛上的浓雾太邪门了…每次深入没多远就会迷失方向。然后不知不觉间就会回到起点。",
            "nextDialogs": [
              "721750110"
            ]
          },
          "721750110": {
            "id": "721750110",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "先前阿釜特意指引的道路让我给忘了个干净…结果想要再回去寻访那边的原住民，却再也找不到路了…",
            "nextDialogs": [
              "721750111"
            ]
          },
          "721750111": {
            "id": "721750111",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "身上的罗盘也好，地上的影子也好，都没法用来指明方向…甚至我连鞋子都试过了，可到最后也没能在雾中多前进半步。",
            "nextDialogs": [
              "721750112"
            ]
          },
          "721750112": {
            "id": "721750112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "鞋子…？",
            "nextDialogs": [
              "721750113"
            ]
          },
          "721750113": {
            "id": "721750113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他说的是丢鞋指路。",
            "nextDialogs": [
              "721750114"
            ]
          },
          "721750114": {
            "id": "721750114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸——！",
            "nextDialogs": [
              "721750115"
            ]
          },
          "721750115": {
            "id": "721750115",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "#哈！这种资深冒险家的小技巧果然难不住{NICKNAME}！小派蒙要多学学咯。",
            "nextDialogs": [
              "721750116"
            ]
          },
          "721750116": {
            "id": "721750116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙还需要学习哦。",
            "nextDialogs": [
              "721750117"
            ]
          },
          "721750117": {
            "id": "721750117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "根本是碰运气吧！这种东西有什么必要学啦！",
            "nextDialogs": [
              "721750118"
            ]
          },
          "721750118": {
            "id": "721750118",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "总之就是这样，我的探索裹足不前。",
            "nextDialogs": [
              "721750119"
            ]
          },
          "721750119": {
            "id": "721750119",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "唉…假如把绳索绑在附近的树上，紧握着另一端摸索前进的话，本来还可以再多试几次的。",
            "nextDialogs": [
              "721750120"
            ]
          },
          "721750120": {
            "id": "721750120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以为什么不再试试了？",
            "nextDialogs": [
              "721750121"
            ]
          },
          "721750121": {
            "id": "721750121",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "用来分辨方向的备用鞋子丢完了…"
          },
          "721750106": {
            "id": "721750106",
            "speakerId": 20333,
            "speakerName": "罗尔德",
            "text": "这样呀，哈哈，那就别让我耽误你们的路程了！"
          }
        }
      }
    },
    {
      "subId": "7217517",
      "subQuestName": "向罗尔德交付「幽灯蕈」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

    {
      "subId": "7318905",
      "subQuestName": "与索赫尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731100601"
        ],
        "dialogs": {
          "731100601": {
            "id": "731100601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "探索了「透明遗迹」。",
            "nextDialogs": [
              "731100602"
            ]
          },
          "731100602": {
            "id": "731100602",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "啊，原来二位去了「透明遗迹」，有什么收获吗？",
            "nextDialogs": [
              "731100603"
            ]
          },
          "731100603": {
            "id": "731100603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "当然有！并且，一定会让你大吃一惊！",
            "nextDialogs": [
              "731100604"
            ]
          },
          "731100604": {
            "id": "731100604",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向索赫尔讲述了探查透明遗迹的经历，并把三块石板交给了他。",
            "nextDialogs": [
              "731100605"
            ]
          },
          "731100605": {
            "id": "731100605",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "喔…！果然，那股神秘的力量后面有着赤王不可告人的秘密，且待我一探究竟。",
            "nextDialogs": [
              "731100606"
            ]
          },
          "731100606": {
            "id": "731100606",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "……",
            "nextDialogs": [
              "731100607"
            ]
          },
          "731100607": {
            "id": "731100607",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "这是…",
            "nextDialogs": [
              "731100608"
            ]
          },
          "731100608": {
            "id": "731100608",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "怎么会这样…？",
            "nextDialogs": [
              "731100609"
            ]
          },
          "731100609": {
            "id": "731100609",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，你的脸色变得好难看，是发现了什么可怕的事情吗？",
            "nextDialogs": [
              "731100610"
            ]
          },
          "731100610": {
            "id": "731100610",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "啊…抱歉，倒也不是说可怕，而是…石板上的内容，看起来很复杂，不过本质上都是…请假记录…",
            "nextDialogs": [
              "731100611"
            ]
          },
          "731100611": {
            "id": "731100611",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "并且，就连请假理由和现在的年轻学者们都没什么区别…",
            "nextDialogs": [
              "731100612"
            ]
          },
          "731100612": {
            "id": "731100612",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "呼，还好当年没能找到进入透明遗迹的方法，否则可能会被气疯的。",
            "nextDialogs": [
              "731100613"
            ]
          },
          "731100613": {
            "id": "731100613",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "不过，还是谢谢你们带回了这几块石板，我再去打听一下蒙德人的请假理由，应该也能够写上一篇论文——",
            "nextDialogs": [
              "731100614"
            ]
          },
          "731100614": {
            "id": "731100614",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "《忙里偷闲——浅论不同社会形态中休假观念的流变》。"
          }
        }
      }
    }
  ]
}
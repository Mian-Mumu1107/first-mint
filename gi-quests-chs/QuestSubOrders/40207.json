  },
  "subQuests": [
    {
      "subId": "4020701",
      "subQuestName": "等待到第二天",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4020702",
      "subQuestName": "去看望爱诺",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402070201"
        ],
        "dialogs": {
          "402070201": {
            "id": "402070201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好啊，伊涅芙——雅珂达这次又在这里？",
            "nextDialogs": [
              "402070202"
            ]
          },
          "402070202": {
            "id": "402070202",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "辛苦了这么多天，至少应该让我分一块蛋糕吃吧？",
            "nextDialogs": [
              "402070203"
            ]
          },
          "402070203": {
            "id": "402070203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "有蛋糕吃！",
            "nextDialogs": [
              "402070204"
            ]
          },
          "402070204": {
            "id": "402070204",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "#嗯，{NICKNAME}和派蒙来得刚好。",
            "nextDialogs": [
              "402070205"
            ]
          },
          "402070205": {
            "id": "402070205",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "爱诺一直想感谢大家，正好铛铛七分甜也被救回来了，所以就想让大家尝尝它的厨艺。",
            "nextDialogs": [
              "402070206"
            ]
          },
          "402070206": {
            "id": "402070206",
            "speakerId": 1003,
            "speakerName": "铛铛七分甜",
            "text": "嘎吱…嘎吱…",
            "nextDialogs": [
              "402070207"
            ]
          },
          "402070207": {
            "id": "402070207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇， 这就是铛铛七分甜原本的样子吗？",
            "nextDialogs": [
              "402070208"
            ]
          },
          "402070208": {
            "id": "402070208",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "好在核心相对完整，爱诺为它重新制作了一副身躯。",
            "nextDialogs": [
              "402070209"
            ]
          },
          "402070209": {
            "id": "402070209",
            "speakerId": 1003,
            "speakerName": "铛铛七分甜",
            "text": "哼哧…哼哧…",
            "nextDialogs": [
              "402070210"
            ]
          },
          "402070210": {
            "id": "402070210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "新鲜的甜品要出炉了吗？",
            "nextDialogs": [
              "402070211"
            ]
          },
          "402070211": {
            "id": "402070211",
            "speakerId": 1003,
            "speakerName": "铛铛七分甜",
            "text": "嘎吱…",
            "nextDialogs": [
              "402070212"
            ]
          },
          "402070212": {
            "id": "402070212",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "自己吃下去了…",
            "nextDialogs": [
              "402070213"
            ]
          },
          "402070213": {
            "id": "402070213",
            "speakerId": 1001,
            "speakerName": "雅珂达",
            "text": "厨子上菜之前总会偷吃两口的，不稀奇。",
            "nextDialogs": [
              "402070214"
            ]
          },
          "402070214": {
            "id": "402070214",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "不用担心，铛铛七分甜吃完后就可以为大家烤制甜品了，稍等片刻就好。",
            "nextDialogs": [
              "402070215"
            ]
          },
          "402070215": {
            "id": "402070215",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好吧…话说要吃甜品的时候，爱诺怎么不在？",
            "nextDialogs": [
              "402070216"
            ]
          },
          "402070216": {
            "id": "402070216",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "爱诺刚刚想到了一个制作机器人的新点子，就立刻钻进了工作室。从我来到工坊起，她就一直这样。",
            "nextDialogs": [
              "402070217"
            ]
          },
          "402070217": {
            "id": "402070217",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "爱诺为什么这么喜欢制作机器人啊？",
            "nextDialogs": [
              "402070218"
            ]
          },
          "402070218": {
            "id": "402070218",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "嗯…要回答这个问题的话，需要从数据库中检索许多历史记录。",
            "nextDialogs": [
              "402070219"
            ]
          },
          "402070219": {
            "id": "402070219",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "最初，爱诺可能只是惊讶于这世界上还存在一种比甜食更吸引她的事物。",
            "nextDialogs": [
              "402070220"
            ]
          },
          "402070220": {
            "id": "402070220",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "爱诺是幸运的，她对这种事物的爱好得到了同伴们的尊重，即便维持生计本身就快要耗光他们每天的活动时间。",
            "nextDialogs": [
              "402070221"
            ]
          },
          "402070221": {
            "id": "402070221",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "直到一位优秀的老师出现之后，爱诺的爱好才被定义成天赋。",
            "nextDialogs": [
              "402070222"
            ]
          },
          "402070222": {
            "id": "402070222",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "正如爱诺曾经的那些伙伴那样，她终于找到了自己最想做，也最擅长做的事。",
            "nextDialogs": [
              "402070223"
            ]
          },
          "402070223": {
            "id": "402070223",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "而当一位天才找到了自己真正想做的事，她就很难再停下自己的脚步了。",
            "nextDialogs": [
              "402070224"
            ]
          },
          "402070224": {
            "id": "402070224",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "所以爱诺最终还是离开了儿时的伙伴，创建了最初的叮铃哐啷蛋卷工坊，开始制作各种各样的机器人。",
            "nextDialogs": [
              "402070225"
            ]
          },
          "402070225": {
            "id": "402070225",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "这一切对于那时的爱诺来说，或许都是身为天才的「本能」，她渴望将自己的奇思妙想化为现实。",
            "nextDialogs": [
              "402070226"
            ]
          },
          "402070226": {
            "id": "402070226",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦…所以才那么喜欢制作机器人？",
            "nextDialogs": [
              "402070227"
            ]
          },
          "402070227": {
            "id": "402070227",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "不过，结合我自身的经历，我并不认为那就是答案的全部。",
            "nextDialogs": [
              "402070228"
            ]
          },
          "402070228": {
            "id": "402070228",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "早在收留我之前，爱诺就开始穷尽她的技术手段，尝试为每个被制作的机器人赋予独特的个性，把它们当成伙伴…",
            "nextDialogs": [
              "402070229"
            ]
          },
          "402070229": {
            "id": "402070229",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "我并没有因为自己的出身，而成为工坊中的特例。",
            "nextDialogs": [
              "402070230"
            ]
          },
          "402070230": {
            "id": "402070230",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "分析原因，或许是她在这条名为天才的道路上走出了太远，回望空无一人的身侧，不由得感受到了孤独。",
            "nextDialogs": [
              "402070231"
            ]
          },
          "402070231": {
            "id": "402070231",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "所以，我、铛铛七分甜、还有其他所有经爱诺之手得以加入工坊的机器人，都不单单是一种「天才的证明」。",
            "nextDialogs": [
              "402070232"
            ]
          },
          "402070232": {
            "id": "402070232",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "我们还是爱诺的家人，是她渴求的陪伴。",
            "nextDialogs": [
              "402070233"
            ]
          },
          "402070233": {
            "id": "402070233",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "这就是我所理解的，爱诺和机器人之间的关系。",
            "nextDialogs": [
              "402070234"
            ]
          },
          "402070234": {
            "id": "402070234",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来是这样啊…",
            "nextDialogs": [
              "402070235"
            ]
          },
          "402070235": {
            "id": "402070235",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "正因如此，爱诺并不关心铛铛七分甜是否拥有令各方势力忌惮的威能。",
            "nextDialogs": [
              "402070236"
            ]
          },
          "402070236": {
            "id": "402070236",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "它已经被确定为工坊的一员，这就足够让爱诺做出那一切了。",
            "nextDialogs": [
              "402070237"
            ]
          },
          "402070237": {
            "id": "402070237",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯嗯，我也这么觉得！所以我也很奇怪爱诺这样的人竟然会留在挪德卡莱…",
            "nextDialogs": [
              "402070238"
            ]
          },
          "402070238": {
            "id": "402070238",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "…派蒙的这句发言，我的逻辑单元无法理解呢。",
            "nextDialogs": [
              "402070239"
            ]
          },
          "402070239": {
            "id": "402070239",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我的意思是，在我看来，挪德卡莱这个地方，鱼龙混杂，到处都是算计，能在这里立足的肯定都是很不好惹的人。",
            "nextDialogs": [
              "402070240"
            ]
          },
          "402070240": {
            "id": "402070240",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "如果其他人得到了爱诺那样的技术，肯定会把机器人都改造成强大的兵器，驱使它们，用来威胁别人。",
            "nextDialogs": [
              "402070241"
            ]
          },
          "402070241": {
            "id": "402070241",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但爱诺…她是能把大杀器造成烤蛋糕机的人，把她放到挪德卡莱，完全格格不入啊…",
            "nextDialogs": [
              "402070242"
            ]
          },
          "402070242": {
            "id": "402070242",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "不，我的逻辑单元持完全相反的看法。",
            "nextDialogs": [
              "402070243"
            ]
          },
          "402070243": {
            "id": "402070243",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "我在挪德卡莱接触过很多人，但其中的绝大多数都不能被定义为「挪德卡莱人」。",
            "nextDialogs": [
              "402070244"
            ]
          },
          "402070244": {
            "id": "402070244",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "偏偏是让派蒙感到惊讶的爱诺，最符合我的逻辑单元对「挪德卡莱人」的定义呢。",
            "nextDialogs": [
              "402070245"
            ]
          },
          "402070245": {
            "id": "402070245",
            "speakerId": 1003,
            "speakerName": "铛铛七分甜",
            "text": "叮铃…叮铃…",
            "nextDialogs": [
              "402070246"
            ]
          },
          "402070246": {
            "id": "402070246",
            "speakerId": 1004,
            "speakerName": "爱诺",
            "text": "甜品烤好了吧？",
            "nextDialogs": [
              "402070247"
            ]
          },
          "402070247": {
            "id": "402070247",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "嗯，不要急，先让我来分一下。",
            "nextDialogs": [
              "402070248"
            ]
          },
          "402070248": {
            "id": "402070248",
            "speakerId": 1004,
            "speakerName": "爱诺",
            "text": "我要奶油最多的！",
            "nextDialogs": [
              "402070249"
            ]
          },
          "402070249": {
            "id": "402070249",
            "speakerId": 1002,
            "speakerName": "伊涅芙",
            "text": "好了，大家品尝一下吧。",
            "nextDialogs": [
              "402070250"
            ]
          },
          "402070250": {
            "id": "402070250",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…真好吃！"
          }
        }
      }
    }
  ]
}
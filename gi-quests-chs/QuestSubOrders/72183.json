  },
  "subQuests": [
    {
      "subId": "7218301",
      "subQuestName": "与斑目百兵卫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721830101"
        ],
        "dialogs": {
          "721830101": {
            "id": "721830101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个是…种子？",
            "nextDialogs": [
              "721830102"
            ]
          },
          "721830102": {
            "id": "721830102",
            "speakerId": 1001,
            "speakerName": "斑目百兵卫",
            "text": "这是「鸣草」的种子。",
            "nextDialogs": [
              "721830103"
            ]
          },
          "721830103": {
            "id": "721830103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你知道这种植物？",
            "nextDialogs": [
              "721830104"
            ]
          },
          "721830104": {
            "id": "721830104",
            "speakerId": 1001,
            "speakerName": "斑目百兵卫",
            "text": "唔，算是了解一些吧。我之前见过这种植物，也听人讲过它的奇异之处。",
            "nextDialogs": [
              "721830105"
            ]
          },
          "721830105": {
            "id": "721830105",
            "speakerId": 1001,
            "speakerName": "斑目百兵卫",
            "text": "我记得…即使是在无风的情况下，这种植物也会随着雷鸣之声微微振动来着…",
            "nextDialogs": [
              "721830106"
            ]
          },
          "721830106": {
            "id": "721830106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "种出来好看吗？",
            "nextDialogs": [
              "721830107"
            ]
          },
          "721830107": {
            "id": "721830107",
            "speakerId": 1001,
            "speakerName": "斑目百兵卫",
            "text": "如果光论外表的话…应该还是挺好看的吧。",
            "nextDialogs": [
              "721830108"
            ]
          },
          "721830108": {
            "id": "721830108",
            "speakerId": 1001,
            "speakerName": "斑目百兵卫",
            "text": "阁下是想试种一下「鸣草」吗？但这附近可没有什么合适的土地…",
            "nextDialogs": [
              "721830109"
            ]
          },
          "721830109": {
            "id": "721830109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我有自己的土地。",
            "nextDialogs": [
              "721830110"
            ]
          },
          "721830110": {
            "id": "721830110",
            "speakerId": 1001,
            "speakerName": "斑目百兵卫",
            "text": "是、是这样吗？不愧是阁下…连封地都已经拿到了吗？",
            "nextDialogs": [
              "721830111"
            ]
          },
          "721830111": {
            "id": "721830111",
            "speakerId": 1001,
            "speakerName": "斑目百兵卫",
            "text": "那敢问阁下，您的封地是在…",
            "nextDialogs": [
              "721830113",
              "721830116"
            ]
          },
          "721830113": {
            "id": "721830113",
            "speakerId": 1001,
            "speakerName": "斑目百兵卫",
            "text": "喔！我也听闻过阁下在蒙德和璃月的壮举。",
            "nextDialogs": [
              "721830114"
            ]
          },
          "721830114": {
            "id": "721830114",
            "speakerId": 1001,
            "speakerName": "斑目百兵卫",
            "text": "那样的壮举，获赐封地也是正常，真不愧是阁下！",
            "nextDialogs": [
              "721830120"
            ]
          },
          "721830120": {
            "id": "721830120",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂，你说的「土地」，不会是之前婆婆给我们的「尘歌壶」吧？",
            "nextDialogs": [
              "721830121"
            ]
          },
          "721830121": {
            "id": "721830121",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那里面，真的能种东西吗？婆婆之前也没有说过…"
          },
          "721830116": {
            "id": "721830116",
            "speakerId": 1001,
            "speakerName": "斑目百兵卫",
            "text": "一盏…壶里？阁下，您就别和我开玩笑了。",
            "nextDialogs": [
              "721830117"
            ]
          },
          "721830117": {
            "id": "721830117",
            "speakerId": 1001,
            "speakerName": "斑目百兵卫",
            "text": "我也听闻过阁下在蒙德和璃月的壮举。",
            "nextDialogs": [
              "721830118"
            ]
          },
          "721830118": {
            "id": "721830118",
            "speakerId": 1001,
            "speakerName": "斑目百兵卫",
            "text": "想必您的封地不是在璃月，就是在蒙德吧。",
            "nextDialogs": [
              "721830119"
            ]
          },
          "721830119": {
            "id": "721830119",
            "speakerId": 1001,
            "speakerName": "斑目百兵卫",
            "text": "唉，真不愧是阁下…"
          }
        }
      }
    },
    {
      "subId": "7218302",
      "subQuestName": "与萍姥姥对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721830201"
        ],
        "dialogs": {
          "721830201": {
            "id": "721830201",
            "speakerId": 1002,
            "speakerName": "萍姥姥",
            "text": "咦？孩子们，你们是来找我的吗？",
            "nextDialogs": [
              "721830202"
            ]
          },
          "721830202": {
            "id": "721830202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「鸣草」的种子…",
            "nextDialogs": [
              "721830203"
            ]
          },
          "721830203": {
            "id": "721830203",
            "speakerId": 1002,
            "speakerName": "萍姥姥",
            "text": "种子…喔，你是想要把这种子，种在「尘歌壶」里吗？",
            "nextDialogs": [
              "721830204"
            ]
          },
          "721830204": {
            "id": "721830204",
            "speakerId": 1002,
            "speakerName": "萍姥姥",
            "text": "这倒也不是不行，毕竟那大小也是一片天地。",
            "nextDialogs": [
              "721830205"
            ]
          },
          "721830205": {
            "id": "721830205",
            "speakerId": 1002,
            "speakerName": "萍姥姥",
            "text": "只不过，你们今天只拿了这一包种子来，难道，你们就只打算种这一包种子吗？",
            "nextDialogs": [
              "721830206"
            ]
          },
          "721830206": {
            "id": "721830206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对、对喔！我们都不知道怎么搜集种子…",
            "nextDialogs": [
              "721830207"
            ]
          },
          "721830207": {
            "id": "721830207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这一包种子种完了之后，我们去哪里找其他的种子呢…",
            "nextDialogs": [
              "721830208"
            ]
          },
          "721830208": {
            "id": "721830208",
            "speakerId": 1002,
            "speakerName": "萍姥姥",
            "text": "好了，好了，别着急。我这里正好有一个我很多年前用过的小匣子。",
            "nextDialogs": [
              "721830209"
            ]
          },
          "721830209": {
            "id": "721830209",
            "speakerId": 1002,
            "speakerName": "萍姥姥",
            "text": "我之前移栽花卉的时候，都是用这个小匣子装的，装在匣子里的花，能够保存很久。",
            "nextDialogs": [
              "721830210"
            ]
          },
          "721830210": {
            "id": "721830210",
            "speakerId": 1002,
            "speakerName": "萍姥姥",
            "text": "而且，把花装在匣子里之后，这匣子还能化出几枚花种…这样，想要种植也很方便。",
            "nextDialogs": [
              "721830211"
            ]
          },
          "721830211": {
            "id": "721830211",
            "speakerId": 1002,
            "speakerName": "萍姥姥",
            "text": "虽然这匣子现在有些不太好用了…但至少还留着一些「化种」之能。",
            "nextDialogs": [
              "721830212"
            ]
          },
          "721830212": {
            "id": "721830212",
            "speakerId": 1002,
            "speakerName": "萍姥姥",
            "text": "唔…反正我老婆子现在也没怎么用过这匣子了…就把它送给你们吧。",
            "nextDialogs": [
              "721830213"
            ]
          },
          "721830213": {
            "id": "721830213",
            "speakerId": 1002,
            "speakerName": "萍姥姥",
            "text": "你们无论是想种些花花草草，还是想种点作物，这匣子应该都能派上些用场。",
            "nextDialogs": [
              "721830214"
            ]
          },
          "721830214": {
            "id": "721830214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢婆婆！",
            "nextDialogs": [
              "721830215"
            ]
          },
          "721830215": {
            "id": "721830215",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "谢谢婆婆！",
            "nextDialogs": [
              "721830216"
            ]
          },
          "721830216": {
            "id": "721830216",
            "speakerId": 1002,
            "speakerName": "萍姥姥",
            "text": "呵呵，不用这么客气，快点去试试看吧，但侍弄花草可不是件简单的事，你们可要做好心理准备啊。",
            "nextDialogs": [
              "721830217"
            ]
          },
          "721830217": {
            "id": "721830217",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "婆婆果然很强啊…但是在试那个匣子之前，我们还是先回去壶里，试试种一下那个种子吧。",
            "nextDialogs": [
              "721830218"
            ]
          },
          "721830218": {
            "id": "721830218",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，真希望这种子能快点长大…"
          }
        }
      }
    }
  ]
}
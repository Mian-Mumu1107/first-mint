    {
      "subId": "2502607",
      "subQuestName": "(test)隐藏任务去打怪$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250260401"
        ],
        "dialogs": {
          "250260401": {
            "id": "250260401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们一起去教训盗宝团吧。",
            "nextDialogs": [
              "250260402"
            ]
          },
          "250260402": {
            "id": "250260402",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "你愿意和我一起去？那太好了，看你这副模样…想必也是位经验丰富的冒险家。",
            "nextDialogs": [
              "250260403"
            ]
          },
          "250260403": {
            "id": "250260403",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "我会按冒险家的规矩准备好报酬的。那我们立即出发吧，给那群恶棍一点颜色瞧瞧。"
          }
        }
      }
    },
    {
      "subId": "2502602",
      "subQuestName": "采两朵新鲜的烛伞蘑菇",
      "sceneId": null,
      "locations": [],

  "subQuests": [
    {
      "subId": "2502601",
      "subQuestName": "帮助烦恼的猎人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250260201"
        ],
        "dialogs": {
          "250260201": {
            "id": "250260201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是先去安慰小匿叶龙吧。",
            "nextDialogs": [
              "250260202"
            ]
          },
          "250260202": {
            "id": "250260202",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "唔…你说得也有道理，那孩子一定被吓得够呛。还是先去安慰一下它比较好啊…",
            "nextDialogs": [
              "250260203"
            ]
          },
          "250260203": {
            "id": "250260203",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "那就跟我来吧，看你的模样，想必也是位经验丰富的冒险家。",
            "nextDialogs": [
              "250260204"
            ]
          },
          "250260204": {
            "id": "250260204",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "我们两个一起过去，那群不怀好意的人肯定不敢再来。不用担心报酬，我会按照冒险家的规矩准备好的。",
            "nextDialogs": [
              "250260206"
            ]
          },
          "250260206": {
            "id": "250260206",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "我想想，那孩子很喜欢吃新鲜的烛伞蘑菇…我记得那边的树下长着很多,请你先去采一些吧。",
            "nextDialogs": [
              "250260205"
            ]
          },
          "250260205": {
            "id": "250260205",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "我去另一边采烛伞蘑菇，等你采好了，我们在竞技场那边的悬崖上集合。",
            "nextDialogs": [
              "250260207"
            ]
          },
          "250260207": {
            "id": "250260207",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "那孩子平时经常在那边休息。也许我们可以去那边找到它。"
          }
        }
      }
    },

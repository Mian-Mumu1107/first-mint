          "250261401": {
            "id": "250261401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们一起去教训盗宝团吧。",
            "nextDialogs": [
              "250261402"
            ]
          },
          "250261402": {
            "id": "250261402",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "没问题，那群盗宝团死性不改，又扎了新营。我已经确定好了位置。",
            "nextDialogs": [
              "250261403"
            ]
          },
          "250261403": {
            "id": "250261403",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "报酬还是按照冒险家的规矩来算。我们立刻出发吧。"
          }
        }
      }
    },

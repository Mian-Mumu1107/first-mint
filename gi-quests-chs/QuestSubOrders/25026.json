    {
      "subId": "2502603",
      "subQuestName": "前往悬崖边寻找特阿墨",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250260301"
        ],
        "dialogs": {
          "250260301": {
            "id": "250260301",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "平时那孩子经常呆在这里。但今天，怎么没见到它留下的痕迹…",
            "nextDialogs": [
              "250260302"
            ]
          },
          "250260302": {
            "id": "250260302",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "也许是被吓坏了，特意藏起来了吧。",
            "nextDialogs": [
              "250260303"
            ]
          },
          "250260303": {
            "id": "250260303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们要去找到它吗？",
            "nextDialogs": [
              "250260304"
            ]
          },
          "250260304": {
            "id": "250260304",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "…不必了。先让那孩子安静一会吧。咱们把烛伞蘑菇放在这里就好。",
            "nextDialogs": [
              "250260305"
            ]
          },
          "250260305": {
            "id": "250260305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还挺熟练的…",
            "nextDialogs": [
              "250260306"
            ]
          },
          "250260306": {
            "id": "250260306",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "我已经照顾这孩子一段时间了。它的性格很敏感，就算是遇见陌生人都会吓一跳。",
            "nextDialogs": [
              "250260307"
            ]
          },
          "250260307": {
            "id": "250260307",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "我喂了这只小匿叶龙很长时间，这孩子才愿意靠近我…唉，可是被那群恶棍一闹，它肯定又不愿意出来了。",
            "nextDialogs": [
              "250260308"
            ]
          },
          "250260308": {
            "id": "250260308",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "没办法，只能让它先自己安静一会了。",
            "nextDialogs": [
              "250260309"
            ]
          },
          "250260309": {
            "id": "250260309",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "多谢你陪我一起来。这是报酬，请收下吧。",
            "nextDialogs": [
              "250260312"
            ]
          },
          "250260312": {
            "id": "250260312",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "放心。那孩子会记住对它好的人。等到时机成熟，它一定会来见我们的。"
          }
        }
      }
    },
    {
      "subId": "2502604",

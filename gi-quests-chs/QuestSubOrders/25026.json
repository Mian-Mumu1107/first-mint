    {
      "subId": "2502605",
      "subQuestName": "与特阿墨交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250260501"
        ],
        "dialogs": {
          "250260501": {
            "id": "250260501",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "哼，这下他们应该不敢随便去伤害小匿叶龙了。",
            "nextDialogs": [
              "250260502"
            ]
          },
          "250260502": {
            "id": "250260502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "总感觉，有什么误会…",
            "nextDialogs": [
              "250260503"
            ]
          },
          "250260503": {
            "id": "250260503",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "别听他们的花言巧语。我可是亲眼看着，他们想要把绳子捆在小匿叶龙的尾巴上。",
            "nextDialogs": [
              "250260504"
            ]
          },
          "250260504": {
            "id": "250260504",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "要不是我过去的及时，真不知道会出什么事。",
            "nextDialogs": [
              "250260505"
            ]
          },
          "250260505": {
            "id": "250260505",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "再次感谢你帮忙，这些报酬给你，请收下吧。",
            "nextDialogs": [
              "250260506"
            ]
          },
          "250260506": {
            "id": "250260506",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "可惜，那群盗宝团跑得太快了。要是能抓住他们，我一定要把这群恶徒斩草除根！"
          }
        }
      }
    },
    {
      "subId": "2502601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250260101"
        ],
        "dialogs": {
          "250260101": {
            "id": "250260101",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "可怜的小匿叶龙…这帮恶棍，我一定得教训他们！",
            "nextDialogs": [
              "250260102"
            ]
          },
          "250260102": {
            "id": "250260102",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "恶棍们，你们可以逃，但绝对无处可藏…！",
            "nextDialogs": [
              "250260103"
            ]
          },
          "250260103": {
            "id": "250260103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么了？",
            "nextDialogs": [
              "250260104"
            ]
          },
          "250260104": {
            "id": "250260104",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "你是…外来的旅行者，对吧？向你致意，很抱歉，现在我没办法招待你。",
            "nextDialogs": [
              "250260105"
            ]
          },
          "250260105": {
            "id": "250260105",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "那群不识好歹的盗宝团恶棍，又想抓住那只小匿叶龙，还好我去的及时，把他们都赶跑了。",
            "nextDialogs": [
              "250260106"
            ]
          },
          "250260106": {
            "id": "250260106",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "那只小匿叶龙一定是吓坏了，无论我怎么招呼，它都不肯过来…",
            "nextDialogs": [
              "250260107"
            ]
          },
          "250260107": {
            "id": "250260107",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "但现在，我已经找到了那群盗宝团的所在地，等会就去教训这帮恶棍。再把他们捆在树上，拿树藤狠狠地抽一顿！",
            "nextDialogs": [
              "250260108"
            ]
          },
          "250260108": {
            "id": "250260108",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "而且，还要找点好吃的，去安慰一下那只小匿叶龙才行…"
          }
        }
      }
    },
    {
      "subId": "2502606",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250260601"
        ],
        "dialogs": {
          "250260601": {
            "id": "250260601",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "…嘘。看那边，那孩子在等我们。",
            "nextDialogs": [
              "250260602"
            ]
          },
          "250260602": {
            "id": "250260602",
            "speakerId": 1001,
            "speakerName": "怯生生的小匿叶龙",
            "text": "…呜？呜，呜…？",
            "nextDialogs": [
              "250260603"
            ]
          },
          "250260603": {
            "id": "250260603",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "好孩子，来这边。我们不会伤害你的。",
            "nextDialogs": [
              "250260604"
            ]
          },
          "250260604": {
            "id": "250260604",
            "speakerId": 1001,
            "speakerName": "怯生生的小匿叶龙",
            "text": "呜…？呜呜…",
            "nextDialogs": [
              "250260605"
            ]
          },
          "250260605": {
            "id": "250260605",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "我是特阿墨，记得吗？之前给你吃过好吃的。",
            "nextDialogs": [
              "250260608"
            ]
          },
          "250260608": {
            "id": "250260608",
            "speakerId": 1001,
            "speakerName": "怯生生的小匿叶龙",
            "text": "呜…呜呜！",
            "nextDialogs": [
              "250260609"
            ]
          },
          "250260609": {
            "id": "250260609",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "和开心的小匿叶龙玩了一段时间。看起来，它似乎心情好了不少…",
            "nextDialogs": [
              "250260610"
            ]
          },
          "250260610": {
            "id": "250260610",
            "speakerId": 1001,
            "speakerName": "怯生生的小匿叶龙",
            "text": "呜！呜呜，呜！",
            "nextDialogs": [
              "250260611"
            ]
          },
          "250260611": {
            "id": "250260611",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "#这是…{NICKNAME}，看来这孩子已经把你当朋友了，我们也都收到了礼物。",
            "nextDialogs": [
              "250260612"
            ]
          },
          "250260612": {
            "id": "250260612",
            "speakerId": 1001,
            "speakerName": "怯生生的小匿叶龙",
            "text": "呜！呜！",
            "nextDialogs": [
              "250260613"
            ]
          },
          "250260613": {
            "id": "250260613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢你喔。",
            "nextDialogs": [
              "250260614"
            ]
          },
          "250260614": {
            "id": "250260614",
            "speakerId": 1001,
            "speakerName": "怯生生的小匿叶龙",
            "text": "呜！呜呜！呜！",
            "nextDialogs": [
              "250260615"
            ]
          },
          "250260615": {
            "id": "250260615",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "小匿叶龙欢快地围着你们转了两圈，随后就转身，再次钻进了林子里。",
            "nextDialogs": [
              "250260616"
            ]
          },
          "250260616": {
            "id": "250260616",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "看来，这孩子是回家了。希望它之后别再遇见恶棍了。",
            "nextDialogs": [
              "250260617"
            ]
          },
          "250260617": {
            "id": "250260617",
            "speakerId": 1000,
            "speakerName": "特阿墨",
            "text": "我们也回去吧。这些报酬给你，请收下吧。"
          }
        }
      }
    },

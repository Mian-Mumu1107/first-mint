          "220280601": {
            "id": "220280601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "供奉金平糖吧。",
            "nextDialogs": [
              "220280801"
            ]
          },
          "220280801": {
            "id": "220280801",
            "speakerId": 3045,
            "speakerName": "翔太",
            "text": "好！那我们就这么做吧。",
            "nextDialogs": [
              "220280802"
            ]
          },
          "220280802": {
            "id": "220280802",
            "speakerId": 3045,
            "speakerName": "翔太",
            "text": "真希望这一次，神明也会回应我。",
            "nextDialogs": [
              "220280803"
            ]
          },
          "220280803": {
            "id": "220280803",
            "speakerId": 3045,
            "speakerName": "翔太",
            "text": "明天我就来看看，有没有什么特别的迹象！",
            "nextDialogs": [
              "220280804"
            ]
          },
          "220280804": {
            "id": "220280804",
            "speakerId": 3045,
            "speakerName": "翔太",
            "text": "对了，谢谢你陪我到现在，这些东西给你！",
            "nextDialogs": [
              "220280805"
            ]
          },
          "220280805": {
            "id": "220280805",
            "speakerId": 3045,
            "speakerName": "翔太",
            "text": "希望神明大人真的能回应我的愿望…"
          }
        }
      }

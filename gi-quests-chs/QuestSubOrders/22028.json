            ]
          },
          "220281201": {
            "id": "220281201",
            "speakerId": 3045,
            "speakerName": "翔太",
            "text": "好！那我们就这么做吧。",
            "nextDialogs": [
              "220281202"
            ]
          },
          "220281202": {
            "id": "220281202",
            "speakerId": 3045,
            "speakerName": "翔太",
            "text": "真希望这一次，神明也会回应我。",
            "nextDialogs": [
              "220281203"
            ]
          },
          "220281203": {
            "id": "220281203",
            "speakerId": 3045,
            "speakerName": "翔太",
            "text": "明天我就来看看，有没有什么特别的迹象！",
            "nextDialogs": [

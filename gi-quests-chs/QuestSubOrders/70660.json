  "subQuests": [
    {
      "subId": "7066001",
      "subQuestName": "与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706600101"
        ],
        "dialogs": {
          "706600101": {
            "id": "706600101",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "你好，冒险家，最近的冒险行动还顺利吗？",
            "nextDialogs": [
              "706600103",
              "706600106"
            ]
          },
          "706600103": {
            "id": "706600103",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "顺利就好，继续这么磨炼下去，你一定能成为一名伟大的冒险家。",
            "nextDialogs": [
              "706600104"
            ]
          },
          "706600104": {
            "id": "706600104",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "对了，如果你有兴趣的话，可以去吉盖克斯先生那边，试玩一下最新的「风行迷踪」。",
            "nextDialogs": [
              "706600108"
            ]
          },
          "706600108": {
            "id": "706600108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这…和冒险家协会有关系吗？",
            "nextDialogs": [
              "706600109"
            ]
          },
          "706600109": {
            "id": "706600109",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "这个啊…因为吉盖克斯先生在协会这边挂了一个委托，拜托我们帮他招募试玩「风行迷踪」的人…",
            "nextDialogs": [
              "706600110"
            ]
          },
          "706600110": {
            "id": "706600110",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "从这方面说…勉强算是有些关系吧。",
            "nextDialogs": [
              "706600111"
            ]
          },
          "706600111": {
            "id": "706600111",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "总之，如果你愿意的话，就过去试玩一下吧。据试玩过的冒险家们说，「风行迷踪」玩起来还挺有意思的…"
          },
          "706600106": {
            "id": "706600106",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "委托…倒是没有。",
            "nextDialogs": [
              "706600107"
            ]
          },
          "706600107": {
            "id": "706600107",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "但如果你有兴趣的话，可以去吉盖克斯先生那边，试玩一下最新的「风行迷踪」。"
          }
        }
      }
    },
    {
      "subId": "7066005",
      "subQuestName": "(test)与吉盖克斯对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706600201"
        ],
        "dialogs": {
          "706600201": {
            "id": "706600201",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "你好，想试试「风行迷踪」吗？",
            "nextDialogs": [
              "706600203",
              "706600218"
            ]
          },
          "706600203": {
            "id": "706600203",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "啊哈，问得好，「风行迷踪」是一款承载着蒙德城历史的游戏！",
            "nextDialogs": [
              "706600204"
            ]
          },
          "706600204": {
            "id": "706600204",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "你应该知道，在之前的蒙德城里有一群「贵族」吧？",
            "nextDialogs": [
              "706600205"
            ]
          },
          "706600205": {
            "id": "706600205",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "他们在蒙德城里暴行不断，让不少人都苦不堪言…",
            "nextDialogs": [
              "706600206"
            ]
          },
          "706600206": {
            "id": "706600206",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "为了反抗贵族们的种种暴行，有一群勇敢的蒙德人聚集了起来，形成了一个秘密的反抗组织。",
            "nextDialogs": [
              "706600207"
            ]
          },
          "706600207": {
            "id": "706600207",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "这群游侠们不断在蒙德各处展开行动，让贵族们颇吃了些苦头。",
            "nextDialogs": [
              "706600208"
            ]
          },
          "706600208": {
            "id": "706600208",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "但是，那些贵族们也很快训练出了一群用来镇压游侠们的爪牙。",
            "nextDialogs": [
              "706600209"
            ]
          },
          "706600209": {
            "id": "706600209",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "于是，游侠们和贵族们的爪牙们，就这样在蒙德各处展开了一场又一场的对决。",
            "nextDialogs": [
              "706600210"
            ]
          },
          "706600210": {
            "id": "706600210",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "「风行迷踪」，正是取材于这样史诗一般的真实历史事件！曾经也是很受欢迎的…",
            "nextDialogs": [
              "706600211"
            ]
          },
          "706600211": {
            "id": "706600211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "曾经？",
            "nextDialogs": [
              "706600212"
            ]
          },
          "706600212": {
            "id": "706600212",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "是啊，现在城里的年轻人们对于「风行迷踪」可没多少兴趣了…",
            "nextDialogs": [
              "706600213"
            ]
          },
          "706600213": {
            "id": "706600213",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "但我可不想让「风行迷踪」就此失传，所以，我对它原来的规则做了些调整，让游戏规则更容易被理解，也更有趣。",
            "nextDialogs": [
              "706600214"
            ]
          },
          "706600214": {
            "id": "706600214",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "除此之外，我还特意添加了好几张全新的游戏地图。我觉得，这样应该会有更多的人来玩吧…"
          },
          "706600218": {
            "id": "706600218",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "我之前就招募过一次试玩「风行迷踪」的人，那些人里有几个技术很出众，让我印象很深。",
            "nextDialogs": [
              "706600219"
            ]
          },
          "706600219": {
            "id": "706600219",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "但除了他们之外，还是有不少人和我说这个游戏很难，要么游侠很难跑掉，要么猎手找不到人。",
            "nextDialogs": [
              "706600220"
            ]
          },
          "706600220": {
            "id": "706600220",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "还有人向我抱怨，如果想要玩好这游戏，就必须熟悉每张图的每个细节，实在是太麻烦了，希望我简化游戏的玩法。",
            "nextDialogs": [
              "706600221"
            ]
          },
          "706600221": {
            "id": "706600221",
            "speakerId": 1001,
            "speakerName": "吉盖克斯",
            "text": "唉，我也不知道他们说的对不对，所以我就想再招募一批人来试玩，听听他们的意见。"
          }
        }
      }
    },

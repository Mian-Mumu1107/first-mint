    {
      "subId": "7403205",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740320501"
        ],
        "dialogs": {
          "740320501": {
            "id": "740320501",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "我感觉好虚弱…都怪那些黄绿黄绿的石头…"
          }
        }
      }
    },
    {
      "subId": "7403202",
      "subQuestName": "与勒克莱德对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740320201"
        ],
        "dialogs": {
          "740320201": {
            "id": "740320201",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "那些黄绿黄绿的石头…肯定大有问题，我要命丧于此了…",
            "nextDialogs": [
              "740320202"
            ]
          },
          "740320202": {
            "id": "740320202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…你没事吧？",
            "nextDialogs": [
              "740320203"
            ]
          },
          "740320203": {
            "id": "740320203",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "我…从长远来看，我们都会没事的。只是我要先各位一步没事了。",
            "nextDialogs": [
              "740320205",
              "740320207"
            ]
          },
          "740320205": {
            "id": "740320205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不不不，怎么听都不是真的没事的意思吧！",
            "nextDialogs": [
              "740320208"
            ]
          },
          "740320208": {
            "id": "740320208",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "不，我真的没事。如果有事，那一定也为时已晚了，呜…",
            "nextDialogs": [
              "740320209"
            ]
          },
          "740320209": {
            "id": "740320209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以到底是有事还是没事？",
            "nextDialogs": [
              "740320210"
            ]
          },
          "740320210": {
            "id": "740320210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我都被绕晕了，能不能说明白点…",
            "nextDialogs": [
              "740320211"
            ]
          },
          "740320211": {
            "id": "740320211",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "明白点说，我这阵子一来生产区就头痛欲裂，手脚发凉，还不时有心悸的症状…",
            "nextDialogs": [
              "740320212"
            ]
          },
          "740320212": {
            "id": "740320212",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "我肯定是要完蛋了！你们懂吗，要完蛋了！",
            "nextDialogs": [
              "740320213"
            ]
          },
          "740320213": {
            "id": "740320213",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "一定是那些黄绿色石头…那是很邪恶的石头！你们肯定知道吧，枫丹科学院的中央实验室…",
            "nextDialogs": [
              "740320214"
            ]
          },
          "740320214": {
            "id": "740320214",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "都怪那些黄绿色石头，把一切都毁了！"
          },
          "740320207": {
            "id": "740320207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听着一点也不像没事的样子…"
          }
        }
      }
    },
    {
      "subId": "7403203",
      "subQuestName": "询问阿德纳的意见",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740320301"
        ],
        "dialogs": {
          "740320301": {
            "id": "740320301",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "遇到麻烦了吗？还是其他人有麻烦？看你们俩都面色红润，应该是其他人有麻烦吧。",
            "nextDialogs": [
              "740320302"
            ]
          },
          "740320302": {
            "id": "740320302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实是…",
            "nextDialogs": [
              "740320303"
            ]
          },
          "740320303": {
            "id": "740320303",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "说明了勒克莱德的情况…",
            "nextDialogs": [
              "740320304"
            ]
          },
          "740320304": {
            "id": "740320304",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "又是他啊…老毛病了。",
            "nextDialogs": [
              "740320305"
            ]
          },
          "740320305": {
            "id": "740320305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那还有得治吗？",
            "nextDialogs": [
              "740320306"
            ]
          },
          "740320306": {
            "id": "740320306",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "你是指头痛，还是妄想症？",
            "nextDialogs": [
              "740320307"
            ]
          },
          "740320307": {
            "id": "740320307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？所以说，他是根本没什么大病？",
            "nextDialogs": [
              "740320308"
            ]
          },
          "740320308": {
            "id": "740320308",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "从之前检查的结果来看，多半是没有吧。",
            "nextDialogs": [
              "740320309"
            ]
          },
          "740320309": {
            "id": "740320309",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "听说他过去在外边的时候曾经误诊，忽略了早期征兆，导致患者…唉，总之，或许自那之后他就有些神经过敏。",
            "nextDialogs": [
              "740320310"
            ]
          },
          "740320310": {
            "id": "740320310",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "对别人是这样，对他自己更是。",
            "nextDialogs": [
              "740320311"
            ]
          },
          "740320311": {
            "id": "740320311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那黄绿色石头没问题吗？",
            "nextDialogs": [
              "740320312"
            ]
          },
          "740320312": {
            "id": "740320312",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "你看除了他之外，其他人不都活蹦乱跳的么。",
            "nextDialogs": [
              "740320313"
            ]
          },
          "740320313": {
            "id": "740320313",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "话虽如此，也不能放着不管。你们把这个带给他吧。",
            "nextDialogs": [
              "740320314"
            ]
          },
          "740320314": {
            "id": "740320314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个…这不是「纯洁之水」吗？真的没问题吗？",
            "nextDialogs": [
              "740320315"
            ]
          },
          "740320315": {
            "id": "740320315",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "哦，你们也知道这个啊。没关系的，至少对身体没害处，还能让他打起精神来。",
            "nextDialogs": [
              "740320317",
              "740320319"
            ]
          },
          "740320317": {
            "id": "740320317",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "据我所知，他对这些饮料都是敬而远之，之前也给他捎过…以对健康有益的药剂的名义，他喝完之后确实恢复了活力。",
            "nextDialogs": [
              "740320322"
            ]
          },
          "740320322": {
            "id": "740320322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，那我们就先把这个带给他。如果还是不行的话…",
            "nextDialogs": [
              "740320323"
            ]
          },
          "740320323": {
            "id": "740320323",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "那就让他去医务室躺下吧。就说是医嘱，他会听的。",
            "nextDialogs": [
              "740320324"
            ]
          },
          "740320324": {
            "id": "740320324",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#好哦，那我们回去找他吧，{NICKNAME}。"
          },
          "740320319": {
            "id": "740320319",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "这就是问题所在，这里没人不知道枫达的味道。",
            "nextDialogs": [
              "740320320"
            ]
          },
          "740320320": {
            "id": "740320320",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "但据我所知，他没试过「纯洁之水」，毕竟流通的范围相当有限…",
            "nextDialogs": [
              "740320321"
            ]
          },
          "740320321": {
            "id": "740320321",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "之前也给他捎过…以对健康有益的药剂的名义，他喝完之后确实恢复了活力。"
          }
        }
      }
    },
    {
      "subId": "7403204",
      "subQuestName": "向勒克莱德回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740320401"
        ],
        "dialogs": {
          "740320401": {
            "id": "740320401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们回来了，医生让我们把这个交给你…",
            "nextDialogs": [
              "740320402"
            ]
          },
          "740320402": {
            "id": "740320402",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "勒克莱德接过「纯洁之水」，一饮而尽。",
            "nextDialogs": [
              "740320403"
            ]
          },
          "740320403": {
            "id": "740320403",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "我感觉好多了！活力重新回到了我的身体！",
            "nextDialogs": [
              "740320405",
              "740320407"
            ]
          },
          "740320405": {
            "id": "740320405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "见效也太快了吧！",
            "nextDialogs": [
              "740320408"
            ]
          },
          "740320408": {
            "id": "740320408",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "阿德纳医生不愧是有资格的医生，药到病除。不像我…",
            "nextDialogs": [
              "740320409"
            ]
          },
          "740320409": {
            "id": "740320409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那黄绿色的石头…",
            "nextDialogs": [
              "740320410"
            ]
          },
          "740320410": {
            "id": "740320410",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "大有问题！",
            "nextDialogs": [
              "740320411"
            ]
          },
          "740320411": {
            "id": "740320411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…看来是头痛治好了，但是另一边的问题还是没解决呢。",
            "nextDialogs": [
              "740320412"
            ]
          },
          "740320412": {
            "id": "740320412",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "这下我可以继续工作了。谢谢你们，辛苦你们跑这么一趟，这些特许券你们就收下吧，一点小小心意。",
            "nextDialogs": [
              "740320413"
            ]
          },
          "740320413": {
            "id": "740320413",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "希望你们身体健康！"
          },
          "740320407": {
            "id": "740320407",
            "speakerId": 5238,
            "speakerName": "勒克莱德",
            "text": "病是真的病，药也是真的药！"
          }
        }
      }
    },
    {
      "subId": "7403206",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740320601"
        ],
        "dialogs": {
          "740320601": {
            "id": "740320601",
            "speakerId": 5250,
            "speakerName": "阿德纳",
            "text": "勒克莱德只是老毛病又犯了，你们也不用太过担心了。"
          }
        }
      }
    }
  ]
}
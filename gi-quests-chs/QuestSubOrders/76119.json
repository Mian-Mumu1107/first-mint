            "speakerId": 15380,
            "speakerName": "努昂诺塔",
            "text": "……！",
            "nextDialogs": [
              "761190202"
            ]
          },
          "761190202": {
            "id": "761190202",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "对你来说，是不是太简单了？",
            "nextDialogs": [
              "761190203"
            ]
          },
          "761190203": {
            "id": "761190203",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "如果下次再玩的话，我会试着让帽子们转得更快一点。",
            "nextDialogs": [
              "761190204"
            ]
          },
          "761190204": {
            "id": "761190204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我有一个疑问！所以哥伦比娅刚才是怎么跟它们玩的呢？",
            "nextDialogs": [
              "761190205"
            ]
          },
          "761190205": {
            "id": "761190205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不用月矩力的话就什么都看不见，用了的话未免又看得太清楚…",
            "nextDialogs": [
              "761190206"
            ]
          },
          "761190206": {
            "id": "761190206",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "我可以睁开眼睛呀。",
            "nextDialogs": [
              "761190207"
            ]
          },
          "761190207": {
            "id": "761190207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，这是我的盲点…"
          }
        }
      }
    },

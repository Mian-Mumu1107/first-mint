    {
      "subId": "7611901",
      "subQuestName": "同哥伦比娅见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761190101"
        ],
        "dialogs": {
          "761190101": {
            "id": "761190101",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "…这里吗？",
            "nextDialogs": [
              "761190102"
            ]
          },
          "761190102": {
            "id": "761190102",
            "speakerId": 15703,
            "speakerName": "月灵",
            "text": "~！",
            "nextDialogs": [
              "761190103"
            ]
          },
          "761190103": {
            "id": "761190103",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "…哈。",
            "nextDialogs": [
              "761190104"
            ]
          },
          "761190104": {
            "id": "761190104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她们好像玩得很开心。",
            "nextDialogs": [
              "761190105"
            ]
          },
          "761190105": {
            "id": "761190105",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "你们好。",
            "nextDialogs": [
              "761190106"
            ]
          },
          "761190106": {
            "id": "761190106",
            "speakerId": 15380,
            "speakerName": "努昂诺塔",
            "text": "！！",
            "nextDialogs": [
              "761190107"
            ]
          },
          "761190107": {
            "id": "761190107",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "你也好，努昂诺塔。",
            "nextDialogs": [
              "761190108"
            ]
          },
          "761190108": {
            "id": "761190108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是在玩新游戏吗？",
            "nextDialogs": [
              "761190109"
            ]
          },
          "761190109": {
            "id": "761190109",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "嗯，我在「旗舰」见到有人用杯子和朋友这样玩，就学来了。",
            "nextDialogs": [
              "761190110"
            ]
          },
          "761190110": {
            "id": "761190110",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "他们把宝石扣进杯子里，在桌面上快速转动杯子。",
            "nextDialogs": [
              "761190111"
            ]
          },
          "761190111": {
            "id": "761190111",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "等停下后，让对方猜测宝石究竟停留在哪个杯子里。",
            "nextDialogs": [
              "761190112"
            ]
          },
          "761190112": {
            "id": "761190112",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "月灵们喜欢钻在布里转来转去的感觉，所以我以魔女小姐的帽子为原型，做了些改良。",
            "nextDialogs": [
              "761190113"
            ]
          },
          "761190113": {
            "id": "761190113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很可爱。",
            "nextDialogs": [
              "761190114"
            ]
          },
          "761190114": {
            "id": "761190114",
            "speakerId": 15703,
            "speakerName": "月灵",
            "text": "~！",
            "nextDialogs": [
              "761190115"
            ]
          },
          "761190115": {
            "id": "761190115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但话说回来你都去过「旗舰」了呀，有被人认出来吗？",
            "nextDialogs": [
              "761190116"
            ]
          },
          "761190116": {
            "id": "761190116",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "有人问起。我就说「我在扮演月神大人，很像吧？」。",
            "nextDialogs": [
              "761190117"
            ]
          },
          "761190117": {
            "id": "761190117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "祈月之夜时的那招还真给你学会了…",
            "nextDialogs": [
              "761190118"
            ]
          },
          "761190118": {
            "id": "761190118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那些人会信吗？",
            "nextDialogs": [
              "761190119"
            ]
          },
          "761190119": {
            "id": "761190119",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "唔…好像半信半疑。但也没再多和我搭话了。",
            "nextDialogs": [
              "761190120"
            ]
          },
          "761190120": {
            "id": "761190120",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "是我表演得不自然吗？下次再去其他地方多试几次。",
            "nextDialogs": [
              "761190121"
            ]
          },
          "761190121": {
            "id": "761190121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么听着是学坏了…",
            "nextDialogs": [
              "761190122"
            ]
          },
          "761190122": {
            "id": "761190122",
            "speakerId": 15380,
            "speakerName": "努昂诺塔",
            "text": "！！",
            "nextDialogs": [
              "761190123"
            ]
          },
          "761190123": {
            "id": "761190123",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "努昂诺塔想邀请你来猜它躲在哪里，要和它玩一局吗？",
            "nextDialogs": [
              "761190124"
            ]
          },
          "761190124": {
            "id": "761190124",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好呀。",
            "nextDialogs": [
              "761190125"
            ]
          },
          "761190125": {
            "id": "761190125",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "请按「旗舰」的规矩，付十万摩拉作为押金。",
            "nextDialogs": [
              "761190126"
            ]
          },
          "761190126": {
            "id": "761190126",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这部分就不用学了吧！"
          }
        }
      }
    },

    {
      "subId": "2303601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230360101"
        ],
        "dialogs": {
          "230360101": {
            "id": "230360101",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "凯万先生，你就再用新型的鱼饵试试吧。",
            "nextDialogs": [
              "230360102"
            ]
          },
          "230360102": {
            "id": "230360102",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "我都试了多少次了，完全和之前一样嘛！",
            "nextDialogs": [
              "230360103"
            ]
          },
          "230360103": {
            "id": "230360103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？你们两个怎么又在一起钓鱼了？",
            "nextDialogs": [
              "230360104"
            ]
          },
          "230360104": {
            "id": "230360104",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "旅行者，又见面了。",
            "nextDialogs": [
              "230360105"
            ]
          },
          "230360105": {
            "id": "230360105",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "两位，你们好啊。",
            "nextDialogs": [
              "230360108"
            ]
          },
          "230360108": {
            "id": "230360108",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "哈哈，完全没有。我和那位学者先生尝试了改进鱼竿，改进鱼饵，改进手法各种方式。",
            "nextDialogs": [
              "230360109"
            ]
          },
          "230360109": {
            "id": "230360109",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "还换了不知道多少个水域，多少个角度…甚至还让我在一个全都是鱼的鱼池里下竿。",
            "nextDialogs": [
              "230360110"
            ]
          },
          "230360110": {
            "id": "230360110",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "但我无论如何，都只能钓起来那些不是鱼的东西。",
            "nextDialogs": [
              "230360111"
            ]
          },
          "230360111": {
            "id": "230360111",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "放心啦，凯万先生，那位学者不也承诺会继续研究下去吗？他一定会帮你找到原因的。",
            "nextDialogs": [
              "230360112"
            ]
          },
          "230360112": {
            "id": "230360112",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "你看，他都给你设计了新型鱼饵，还让我一直陪在你身边，记录你钓鱼的各种细节…",
            "nextDialogs": [
              "230360113"
            ]
          },
          "230360113": {
            "id": "230360113",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "希望他真的能找到吧…但在那之前，我还是按照自己的方法来钓鱼好了。",
            "nextDialogs": [
              "230360114"
            ]
          },
          "230360114": {
            "id": "230360114",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "旅行者，如果你有空的话，就再帮我去找点鱼饵材料吧。"
          }
        }
      }
    },

    {
      "subId": "2303603",
      "subQuestName": "与荷贝特和凯万对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230360601"
        ],
        "dialogs": {
          "230360601": {
            "id": "230360601",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "很不错，接下来我就要下竿了，这次一定能钓上大鱼！",
            "nextDialogs": [
              "230360602"
            ]
          },
          "230360602": {
            "id": "230360602",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "凯万制作了鱼饵，开始垂钓…",
            "nextDialogs": [
              "230360603"
            ]
          },
          "230360603": {
            "id": "230360603",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "不久后，凯万钓到了一个湿漉漉的盒子…",
            "nextDialogs": [
              "230360604"
            ]
          },
          "230360604": {
            "id": "230360604",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "这个…我来看看…",
            "nextDialogs": [
              "230360605"
            ]
          },
          "230360605": {
            "id": "230360605",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "咦？里面的东西…好像又是失物之类的东西呢…",
            "nextDialogs": [
              "230360608"
            ]
          },
          "230360608": {
            "id": "230360608",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "唔…自从上次陪着凯万先生去找那位学者改进鱼饵后，我们一直在外垂钓…",
            "nextDialogs": [
              "230360609"
            ]
          },
          "230360609": {
            "id": "230360609",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "但每次垂钓…凯万先生还是一直钓起奇奇怪怪的东西。",
            "nextDialogs": [
              "230360610"
            ]
          },
          "230360610": {
            "id": "230360610",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "其中包括人的失物，河底的矿石，掉下船的包裹…",
            "nextDialogs": [
              "230360611"
            ]
          },
          "230360611": {
            "id": "230360611",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "甚至还有一个不慎落水的冒险家抓着凯万先生的钓线爬上了岸…",
            "nextDialogs": [
              "230360612"
            ]
          },
          "230360612": {
            "id": "230360612",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "但是，我们就是没法钓起任何一条鱼…",
            "nextDialogs": [
              "230360613"
            ]
          },
          "230360613": {
            "id": "230360613",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "我的钓鱼生涯，已经彻底走到尽头了…",
            "nextDialogs": [
              "230360614"
            ]
          },
          "230360614": {
            "id": "230360614",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "凯，凯万先生！不要这么沮丧呀，你…你看，这东西的失主肯定很着急。",
            "nextDialogs": [
              "230360615"
            ]
          },
          "230360615": {
            "id": "230360615",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "你能把这失物钓上来，他一定会很高兴的。",
            "nextDialogs": [
              "230360616"
            ]
          },
          "230360616": {
            "id": "230360616",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "我们把这些失物拿回去给冒险家协会，说不定还能拿到点报酬呢！",
            "nextDialogs": [
              "230360617"
            ]
          },
          "230360617": {
            "id": "230360617",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "但是！我真的！只是想要——",
            "nextDialogs": [
              "230360618"
            ]
          },
          "230360618": {
            "id": "230360618",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "钓上一条鱼啊！"
          }
        }
      }
    },
    {
      "subId": "2303604",
      "subQuestName": "采集3份新鲜的香辛果",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230360401"
        ],
        "dialogs": {
          "230360401": {
            "id": "230360401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这次需要什么材料？",
            "nextDialogs": [
              "230360402"
            ]
          },
          "230360402": {
            "id": "230360402",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "我想想，这次的鱼饵需要用到…呃…特别的甜甜花。",
            "nextDialogs": [
              "230360403"
            ]
          },
          "230360403": {
            "id": "230360403",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "有个地方的甜甜花很不错，我给你们把地点标上…"
          }
        }
      }
    },
    {
      "subId": "2303605",
      "subQuestName": "将鱼饵的材料交给凯万",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230360501"
        ],
        "dialogs": {
          "230360501": {
            "id": "230360501",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "这次我所制作的鱼饵需要日落果，小麦和帕蒂沙兰，你找到这些材料了吗？"
          }
        }
      }
    },

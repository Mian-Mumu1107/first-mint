    {
      "subId": "2303601",
      "subQuestName": "与荷贝特和凯万对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230360201"
        ],
        "dialogs": {
          "230360201": {
            "id": "230360201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这次需要什么材料？",
            "nextDialogs": [
              "230360202"
            ]
          },
          "230360202": {
            "id": "230360202",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "我想想，这次的鱼饵就用帕蒂沙兰吧。",
            "nextDialogs": [
              "230360203"
            ]
          },
          "230360203": {
            "id": "230360203",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "普通的帕蒂沙兰就足够了。"
          }
        }
      }
    },

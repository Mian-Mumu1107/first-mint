  "subQuests": [
    {
      "subId": "7065301",
      "subQuestName": "与璃月港的凯瑟琳交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706530101"
        ],
        "dialogs": {
          "706530101": {
            "id": "706530101",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "向着星辰与深渊！欢迎你，冒险家，我一直在等待你的到来。",
            "nextDialogs": [
              "706530103",
              "706530105"
            ]
          },
          "706530103": {
            "id": "706530103",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "谢谢关心，我一切都好。不过协会这边，又遇到了紧急的突发事件…",
            "nextDialogs": [
              "706530106"
            ]
          },
          "706530106": {
            "id": "706530106",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "近些日子，冒险家协会收到了很多「岩龙蜥」的目击情报。",
            "nextDialogs": [
              "706530107"
            ]
          },
          "706530107": {
            "id": "706530107",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "「岩龙蜥」原本只出现在古书的记载中，不知为什么会突然出现。",
            "nextDialogs": [
              "706530108"
            ]
          },
          "706530108": {
            "id": "706530108",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "它们虽与幼岩龙蜥形态相似，但性情凶暴，破坏力也高了好几个档次。",
            "nextDialogs": [
              "706530109"
            ]
          },
          "706530109": {
            "id": "706530109",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "最近不少人喜欢去僻静的野外观景和放灯，如果正巧遇上了「岩龙蜥」，那后果不堪设想。",
            "nextDialogs": [
              "706530110"
            ]
          },
          "706530110": {
            "id": "706530110",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "然而不巧的是，有很多冒险家都去走亲访友了，璃月协会正处于人手严重不足的情况…"
          },
          "706530105": {
            "id": "706530105",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "嗯，是紧急的突发事件。"
          }
        }
      }
    }
  ]
}
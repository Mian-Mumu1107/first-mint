    {
      "subId": "7308302",
      "subQuestName": "根据石板的指引获取全部权能$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730830201"
        ],
        "dialogs": {
          "730830201": {
            "id": "730830201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "从刚刚开始我就很在意了，这里一定是什么不得了的地方…简直像是沙漠里的风龙废墟！",
            "nextDialogs": [
              "730830202"
            ]
          },
          "730830202": {
            "id": "730830202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不知道赤王统治的时候有没有吟游诗人对着这里唱些什么…我们靠近一些瞧瞧。"
          }
        }
      }
    },
    {
      "subId": "7308303",
      "subQuestName": "根据石板的指引获取全部权能",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730830301"
        ],
        "dialogs": {
          "730830301": {
            "id": "730830301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…这就是…「阿如」吗？",
            "nextDialogs": [
              "730830303",
              "730830310"
            ]
          },
          "730830303": {
            "id": "730830303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，按照石板的指引，我们应该是获得了赤王的允诺，到了「阿如」才是。",
            "nextDialogs": [
              "730830304"
            ]
          },
          "730830304": {
            "id": "730830304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是这里好像并没有什么很「阿如」的东西，只有一个大到吓人的装置。总感觉「阿如」应该更…更…"
          },
          "730830310": {
            "id": "730830310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，这里和刚刚的幽冥都没什么区别，面前还是一个大到吓人的装置。总感觉「阿如」应该更…更…"
          }
        }
      }
    },

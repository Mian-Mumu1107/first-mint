    {
      "subId": "7308322",
      "subQuestName": "(test)触发对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730830401"
        ],
        "dialogs": {
          "730830401": {
            "id": "730830401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又回到阿如村了，呜啊，还是好热，和第一次来的时候一样。",
            "nextDialogs": [
              "730830402"
            ]
          },
          "730830402": {
            "id": "730830402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也不知道婕德和提尔扎德现在怎么样了…有点在意。",
            "nextDialogs": [
              "730830404",
              "730830409"
            ]
          },
          "730830404": {
            "id": "730830404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…虽然没什么根据，但我也是这么觉得的。",
            "nextDialogs": [
              "730830405"
            ]
          },
          "730830405": {
            "id": "730830405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "毕竟经过了上次的考古，他们的性格应该会变沉稳一些，也就是所谓的长大吧。",
            "nextDialogs": [
              "730830406"
            ]
          },
          "730830406": {
            "id": "730830406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "提尔扎德不适合用「长大」…",
            "nextDialogs": [
              "730830407"
            ]
          },
          "730830407": {
            "id": "730830407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，可是婕德也说过，他有点像小孩子，又哭又闹的。",
            "nextDialogs": [
              "730830411"
            ]
          },
          "730830411": {
            "id": "730830411",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "提尔扎德…冒险…莫非这两位就是…",
            "nextDialogs": [
              "730830412"
            ]
          },
          "730830412": {
            "id": "730830412",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "不好意思，打扰一下，我叫做卡兰塔里，在教令院学习，寻觅过去之事在大地上留下的痕迹。",
            "nextDialogs": [
              "730830413"
            ]
          },
          "730830413": {
            "id": "730830413",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "请问，前段时间，你们是不是参加了提尔扎德·欣迪先生的沙漠考古？",
            "nextDialogs": [
              "730830414"
            ]
          },
          "730830414": {
            "id": "730830414",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你怎么知道？",
            "nextDialogs": [
              "730830415"
            ]
          },
          "730830415": {
            "id": "730830415",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "居然真的是你们！提尔扎德在他的那篇论文的致谢里，有提到过二位。",
            "nextDialogs": [
              "730830416"
            ]
          },
          "730830416": {
            "id": "730830416",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "论文？这么说来，提尔扎德是有说过，回去之后要埋头写论文，原来已经完成了。",
            "nextDialogs": [
              "730830417"
            ]
          },
          "730830417": {
            "id": "730830417",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "是啊，他从沙漠回来之后，就把自己关在房间里。研究员们都很担心他是不是因为没能获得什么成果，太过消沉。",
            "nextDialogs": [
              "730830418"
            ]
          },
          "730830418": {
            "id": "730830418",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "直到过了好几天，大家开始下注赌他出门之后是先喝水还是先吃饭的时候，他突然冲了出来，向教令院提交了一篇论文——",
            "nextDialogs": [
              "730830419"
            ]
          },
          "730830419": {
            "id": "730830419",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "《黄金梦乡——阿赫玛尔文明晚期统治模式及遗存分期的研究》。",
            "nextDialogs": [
              "730830420"
            ]
          },
          "730830420": {
            "id": "730830420",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "虽然这么说有些不礼貌，但是我从来都没想过那个提尔扎德能够写出这么富有开创性的论文。",
            "nextDialogs": [
              "730830421"
            ]
          },
          "730830421": {
            "id": "730830421",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「富有开创性」？听起来好像很厉害…"
          },
          "730830409": {
            "id": "730830409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，你说得没错，只要我们继续冒险，就一定会和婕德再见。",
            "nextDialogs": [
              "730830410"
            ]
          },
          "730830410": {
            "id": "730830410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "至于提尔扎德的话，去教令院就一定能找到他吧，毕竟他自称室内派学者。"
          }
        }
      }
    },
    {
      "subId": "7308320",
      "subQuestName": "和卡兰塔里一起进入阿如村",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7308323",
      "subQuestName": "(test)触发对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730830501"
        ],
        "dialogs": {
          "730830501": {
            "id": "730830501",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "卡——兰——塔——里——",
            "nextDialogs": [
              "730830502"
            ]
          },
          "730830502": {
            "id": "730830502",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "嗯？这个声音好熟悉…",
            "nextDialogs": [
              "730830503"
            ]
          },
          "730830503": {
            "id": "730830503",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "卡兰塔里，没想到你都已经溜到阿如村了，可累坏我这把老骨头了。",
            "nextDialogs": [
              "730830504"
            ]
          },
          "730830504": {
            "id": "730830504",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "啊呀，原来是索赫尔先生，您一大把年纪，不在教令院里翻阅典籍，到这种荒郊野外干什么？",
            "nextDialogs": [
              "730830505"
            ]
          },
          "730830505": {
            "id": "730830505",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "哼，干什么？还不是为了拦住你们这些小辈？",
            "nextDialogs": [
              "730830506"
            ]
          },
          "730830506": {
            "id": "730830506",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "一个个的，也是读过不少论文的人了，一点都沉不住气。看到提尔扎德做出些成果，就和蕈兽成灾似的往沙漠里冲，不像话。",
            "nextDialogs": [
              "730830507"
            ]
          },
          "730830507": {
            "id": "730830507",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "贤者大人害怕惊动了风纪官，也担心你们破坏遗迹，才委派我来把你们都劝回去。",
            "nextDialogs": [
              "730830508"
            ]
          },
          "730830508": {
            "id": "730830508",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "我们…？没有呀，我一个人来的，并且为了瞒着其他人，特意申请的带薪假期。",
            "nextDialogs": [
              "730830509"
            ]
          },
          "730830509": {
            "id": "730830509",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "你是一个人来的没错，但是动了歪心思的可不止一个。你知道昨天贤者大人收到了多少份假期申请吗？",
            "nextDialogs": [
              "730830510"
            ]
          },
          "730830510": {
            "id": "730830510",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "四十六份！整整四十六份假期申请，都是读了论文后想来碰碰运气的年轻人！",
            "nextDialogs": [
              "730830511"
            ]
          },
          "730830511": {
            "id": "730830511",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "理由也是各种各样，什么邻居家着火去帮忙、家里被蕈兽搞得一团乱、吃了变质的咖喱…怎么没见写论文的时候有这么多想法？",
            "nextDialogs": [
              "730830513",
              "730830515"
            ]
          },
          "730830513": {
            "id": "730830513",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "对对，有那么多人请假，可是我也没在阿如村见到他们呀。",
            "nextDialogs": [
              "730830517"
            ]
          },
          "730830517": {
            "id": "730830517",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "你当然见不到他们，因为我在来的路上，已经数着数统统把他们劝回去了，只剩下第四十六个，也就是你。",
            "nextDialogs": [
              "730830518"
            ]
          },
          "730830518": {
            "id": "730830518",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "听我一句劝，学术研究不是靠运气，提尔扎德那篇论文虽然写得不错，但是真是假还说不定呢。",
            "nextDialogs": [
              "730830519"
            ]
          },
          "730830519": {
            "id": "730830519",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "可是…我找到了向导…",
            "nextDialogs": [
              "730830520"
            ]
          },
          "730830520": {
            "id": "730830520",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "没什么可是！像你这样没进过沙漠的愣头青，多半会迷失道路。即便不迷路，也会毛手毛脚，破坏遗迹。",
            "nextDialogs": [
              "730830521"
            ]
          },
          "730830521": {
            "id": "730830521",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "为了你的安全和遗迹的安全起见，你得回去。要是你实在不愿意回去，我就让三十人团的哈尔瓦尼「送」你回去了。",
            "nextDialogs": [
              "730830522"
            ]
          },
          "730830522": {
            "id": "730830522",
            "speakerId": 20821,
            "speakerName": "哈尔瓦尼",
            "text": "请回去。",
            "nextDialogs": [
              "730830523"
            ]
          },
          "730830523": {
            "id": "730830523",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "那…好吧…",
            "nextDialogs": [
              "730830524"
            ]
          },
          "730830524": {
            "id": "730830524",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "这才有教令院学者的样子，那么，你回去吧。",
            "nextDialogs": [
              "730830525"
            ]
          },
          "730830525": {
            "id": "730830525",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "欸？索赫尔先生不一起回去吗？",
            "nextDialogs": [
              "730830526"
            ]
          },
          "730830526": {
            "id": "730830526",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "当然，接下来我要在这里待上一些时日，防止再有像你一样的急躁学者进入沙漠。",
            "nextDialogs": [
              "730830527"
            ]
          },
          "730830527": {
            "id": "730830527",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "我也不是急躁…就是…就是论文缺乏一点灵感而已。唉，本来还以为这是次难得的机会呢。",
            "nextDialogs": [
              "730830528"
            ]
          },
          "730830528": {
            "id": "730830528",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "那么旅行者，有机会再见吧，祝二位旅途顺利。"
          },
          "730830515": {
            "id": "730830515",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "说明可信度高呀，所谓历史的真相往往比学者们想象中更加荒诞。",
            "nextDialogs": [
              "730830516"
            ]
          },
          "730830516": {
            "id": "730830516",
            "speakerId": 20822,
            "speakerName": "卡兰塔里",
            "text": "再说了，我也没在阿如村见到其他学者，说不定他们说的都是真的呢。"
          }
        }
      }
    },
    {
      "subId": "7308321",
      "subQuestName": "与索赫尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730830601"
        ],
        "dialogs": {
          "730830601": {
            "id": "730830601",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "刚才光顾着卡兰塔里的事，没来得及向二位问好。我是来自乌赛比家的索赫尔，因论派的学者。",
            "nextDialogs": [
              "730830602"
            ]
          },
          "730830602": {
            "id": "730830602",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "卡兰塔里是想要请你们做向导吧？实在抱歉，搅了你们的生意。",
            "nextDialogs": [
              "730830603"
            ]
          },
          "730830603": {
            "id": "730830603",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "不过这不见得是坏事，因为那个提尔扎德的论文可信度不高，你们多半只会白跑一趟。",
            "nextDialogs": [
              "730830604"
            ]
          },
          "730830604": {
            "id": "730830604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不，我相信他。",
            "nextDialogs": [
              "730830605"
            ]
          },
          "730830605": {
            "id": "730830605",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "嗯？为什么能这么肯定？莫非…你们就是他在致谢里提到的…",
            "nextDialogs": [
              "730830609"
            ]
          },
          "730830609": {
            "id": "730830609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#没错，正是我们，大名鼎鼎的{NICKNAME}和派蒙！和提尔扎德一起完成了考古的旅行者。",
            "nextDialogs": [
              "730830610"
            ]
          },
          "730830610": {
            "id": "730830610",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "唔，愿意维护雇主是好事，说明你们和璃月人一样重视「契约」。但是你们骗不了我。",
            "nextDialogs": [
              "730830611"
            ]
          },
          "730830611": {
            "id": "730830611",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "我年轻的时候也曾经进过沙漠，但是并没见过论文里提到的什么「秘仪圣殿」、「圣显厅」之类的地方。",
            "nextDialogs": [
              "730830612"
            ]
          },
          "730830612": {
            "id": "730830612",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "并且，赤王陵顶端的沙瀑和我年轻时候相比，也没什么变化。所以我猜提尔扎德他根本没进赤王陵，而是杜撰了经历。",
            "nextDialogs": [
              "730830613"
            ]
          },
          "730830613": {
            "id": "730830613",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "而你们，一定是收了他的报酬，和他串通说辞，等有人来调查的时候提起，就可以增加论文可信度。",
            "nextDialogs": [
              "730830614"
            ]
          },
          "730830614": {
            "id": "730830614",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "计划倒是很好，可惜遇见了我。"
          }
        }
      }
    },
    {
      "subId": "7308301",
      "subQuestName": "抵达石板指引的位置",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730830101"
        ],
        "dialogs": {
          "730830101": {
            "id": "730830101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "按照石板的指引，我们到达目的地了！",
            "nextDialogs": [
              "730830102"
            ]
          },
          "730830102": {
            "id": "730830102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过…只是进到了赤王陵里面，面前并没有什么特殊的装置，难道我们走错路了？",
            "nextDialogs": [
              "730830103"
            ]
          },
          "730830103": {
            "id": "730830103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要不，再把石板拿出来看一看吧。",
            "nextDialogs": [
              "730830104"
            ]
          },
          "730830104": {
            "id": "730830104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，石板上出现了新的文字…还有三个光点…",
            "nextDialogs": [
              "730830105"
            ]
          },
          "730830105": {
            "id": "730830105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「尘世如河流横亘于幽冥与阿如之间…凡人不可逾越，不可试探，不可…唔…不可不会读…违背者永堕幽冥…」",
            "nextDialogs": [
              "730830106"
            ]
          },
          "730830106": {
            "id": "730830106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「欲升入阿如，须有如兀鸟的形体，盘旋幽冥…啄食三种脏器，方可获阿赫玛尔的允诺，以隼的形体飞过河流…」",
            "nextDialogs": [
              "730830107"
            ]
          },
          "730830107": {
            "id": "730830107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那个读觊觎。",
            "nextDialogs": [
              "730830108"
            ]
          },
          "730830108": {
            "id": "730830108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢…「不可觊觎」。不过这些话是什么意思呀？好像每一句都很重要，但是每一句都看不懂。",
            "nextDialogs": [
              "730830109"
            ]
          },
          "730830109": {
            "id": "730830109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你觉得哪一句比较重要？",
            "nextDialogs": [
              "730830111",
              "730830113",
              "730830115"
            ]
          },
          "730830111": {
            "id": "730830111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "升入阿如…难道指的是阿如村？不过那时候应该还没有阿如村吧…既然能够和幽冥相对，应该是很好的地方才是。",
            "nextDialogs": [
              "730830116"
            ]
          },
          "730830116": {
            "id": "730830116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…前后连起来看，就是对「脏器」做些什么，就可以打开新的通路，到达「阿如」。唔，感觉好神秘…",
            "nextDialogs": [
              "730830117"
            ]
          },
          "730830117": {
            "id": "730830117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，「脏器」，总觉得在哪里曾经听过这个词。"
          },
          "730830113": {
            "id": "730830113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啄食脏器…不会是真的让我们吃…吃内脏吧…有点吓人…"
          },
          "730830115": {
            "id": "730830115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "获得赤王的允诺，应该就是开启新的通路的意思吧。"
          }
        }
      }
    },

    {
      "subId": "7308310",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730831029"
        ],
        "dialogs": {
          "730831029": {
            "id": "730831029",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，石板上指示的三个光点，好像有我们之前去过的地方，石板上的符号也已经亮起来了。",
            "nextDialogs": [
              "730831030"
            ]
          },
          "730831030": {
            "id": "730831030",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太好了！一想到要去三个不同的地方，就感觉好累，没想到只需要再去找两个装置就可以了，真想谢谢之前的自己。",
            "nextDialogs": [
              "730831031"
            ]
          },
          "730831031": {
            "id": "730831031",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也要谢谢之前的我。",
            "nextDialogs": [
              "730831032"
            ]
          },
          "730831032": {
            "id": "730831032",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#对哦，谢谢你，{NICKNAME}！我们去找剩下的装置吧！"
          }
        }
      }

      "subId": "7308307",
      "subQuestName": "根据石板的指引前往「衡准大厅」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730830701"
        ],
        "dialogs": {
          "730830701": {
            "id": "730830701",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "嗯？你们怎么还在阿如村？难道是想从我这里捞到些什么？",
            "nextDialogs": [
              "730830702"
            ]
          },
          "730830702": {
            "id": "730830702",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "还是趁早打消这个念头吧，我和提尔扎德、卡兰塔里那些年轻人不一样，是不会动什么歪脑筋的。",
            "nextDialogs": [
              "730830703"
            ]
          },
          "730830703": {
            "id": "730830703",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "我为你指明一条正路：现在开始钻研知识，到我这个年纪的时候，说不定也能加入教令院。"
          }
        }
      }
    },

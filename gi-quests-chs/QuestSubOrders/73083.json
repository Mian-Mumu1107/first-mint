    {
      "subId": "7308314",
      "subQuestName": "点燃元能火炬",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730831401"
        ],
        "dialogs": {
          "730831401": {
            "id": "730831401",
            "speakerId": 20821,
            "speakerName": "哈尔瓦尼",
            "text": "不可以，我不会护送您进入沙漠的。",
            "nextDialogs": [
              "730831402"
            ]
          },
          "730831402": {
            "id": "730831402",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "可是，这么多年都没有任何变化的赤王陵，居然发生了闻所未闻的异变，你刚刚也看到了吧！我要想办法记录下来…所以…",
            "nextDialogs": [
              "730831403"
            ]
          },
          "730831403": {
            "id": "730831403",
            "speakerId": 20821,
            "speakerName": "哈尔瓦尼",
            "text": "我也是第一次见到这种变化…只是根据贤者大人的吩咐，没有他的许可，任何学者都不得进入沙漠。",
            "nextDialogs": [
              "730831404"
            ]
          },
          "730831404": {
            "id": "730831404",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "……",
            "nextDialogs": [
              "730831405"
            ]
          },
          "730831405": {
            "id": "730831405",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "我…我不是那些急躁的年轻学者，我在教令院研习了那么久，一直兢兢业业…",
            "nextDialogs": [
              "730831406"
            ]
          },
          "730831406": {
            "id": "730831406",
            "speakerId": 20821,
            "speakerName": "哈尔瓦尼",
            "text": "不行。",
            "nextDialogs": [
              "730831407"
            ]
          },
          "730831407": {
            "id": "730831407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们好呀，一段时间没见了，看起来你们在阿如村过得很愉快的样子。",
            "nextDialogs": [
              "730831408"
            ]
          },
          "730831408": {
            "id": "730831408",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "嗯？怎么是你们两个？我之前说过不追究你们，但是也不要一直在这里招摇撞骗。",
            "nextDialogs": [
              "730831409"
            ]
          },
          "730831409": {
            "id": "730831409",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "我年纪大了，时间可比你们宝贵，并且眼下有更重要的事情，恕不奉陪。",
            "nextDialogs": [
              "730831412"
            ]
          },
          "730831412": {
            "id": "730831412",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "不不不，我怎么会做出那种违背贤者大人禁令的事情，我只是想…",
            "nextDialogs": [
              "730831413"
            ]
          },
          "730831413": {
            "id": "730831413",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "等等，我看你们灰头土脸的，还拿着一块可疑的石板…莫非刚刚从沙漠里回来？",
            "nextDialogs": [
              "730831414"
            ]
          },
          "730831414": {
            "id": "730831414",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "莫非…赤王陵的变化…和你们有关？"
          }
        }
      }
    },

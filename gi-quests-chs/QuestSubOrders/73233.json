  },
  "subQuests": [
    {
      "subId": "7323301",
      "subQuestName": "与里夫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732330101"
        ],
        "dialogs": {
          "732330101": {
            "id": "732330101",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "真是一点时间都抽不出来…",
            "nextDialogs": [
              "732330102"
            ]
          },
          "732330102": {
            "id": "732330102",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "现在也找不到人和我换班，这可怎么办…",
            "nextDialogs": [
              "732330103"
            ]
          },
          "732330103": {
            "id": "732330103",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "咦？旅行者…欸！请留步，旅行者！",
            "nextDialogs": [
              "732330104"
            ]
          },
          "732330104": {
            "id": "732330104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "732330105"
            ]
          },
          "732330105": {
            "id": "732330105",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "不好意思，突然叫住了你。我就是想问问你有没有空，我想请你帮个忙…",
            "nextDialogs": [
              "732330107",
              "732330109"
            ]
          },
          "732330107": {
            "id": "732330107",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "你愿意帮忙吗？真是太谢谢你了！",
            "nextDialogs": [
              "732330111"
            ]
          },
          "732330111": {
            "id": "732330111",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "事情是这样的…我在阿扎莱那里订了一个花盆，还有一批花种。",
            "nextDialogs": [
              "732330112"
            ]
          },
          "732330112": {
            "id": "732330112",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "本来我拜托了一个朋友帮我去拿…",
            "nextDialogs": [
              "732330113"
            ]
          },
          "732330113": {
            "id": "732330113",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "但他突然说有任务要去执行，暂时没法帮我这个忙了。我一时半会也找不到另外一个人帮忙…",
            "nextDialogs": [
              "732330114"
            ]
          },
          "732330114": {
            "id": "732330114",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "旅行者，能请你帮我去阿扎莱那一趟，把花盆和花种带回来吗？我听人说…他现在好像在村口等着接货。",
            "nextDialogs": [
              "732330115"
            ]
          },
          "732330115": {
            "id": "732330115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你买这个做什么？",
            "nextDialogs": [
              "732330116"
            ]
          },
          "732330116": {
            "id": "732330116",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "这些花和种子都是送给我女朋友内尔敏的。",
            "nextDialogs": [
              "732330117"
            ]
          },
          "732330117": {
            "id": "732330117",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "她…身体不是很好，一直在家里养病。",
            "nextDialogs": [
              "732330118"
            ]
          },
          "732330118": {
            "id": "732330118",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "你也看得到，这阿如村周围都是沙漠，也看不见什么绿植，环境实在是有些不太好。",
            "nextDialogs": [
              "732330119"
            ]
          },
          "732330119": {
            "id": "732330119",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "我之前就买了一些绿植放在她家里，但她老是憋在屋子里养病，心情也不太好。",
            "nextDialogs": [
              "732330120"
            ]
          },
          "732330120": {
            "id": "732330120",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "我平时工作也很忙，白天基本上没空回家陪她，只有在晚上能和她说说话…",
            "nextDialogs": [
              "732330121"
            ]
          },
          "732330121": {
            "id": "732330121",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "我就想，不如让她自己也种点花，也算是能打发点时间，不至于让她老是想着自己生病了这件事。",
            "nextDialogs": [
              "732330122"
            ]
          },
          "732330122": {
            "id": "732330122",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "结果，没想到出了这么一茬事…"
          },
          "732330109": {
            "id": "732330109",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "欸？这…我倒是有点积蓄，报酬你不用担心…",
            "nextDialogs": [
              "732330110"
            ]
          },
          "732330110": {
            "id": "732330110",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "无论如何，你愿意帮忙就最好了。"
          }
        }
      }
    },
    {
      "subId": "7323302",
      "subQuestName": "与阿扎莱对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732330201"
        ],
        "dialogs": {
          "732330201": {
            "id": "732330201",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "唉，还有一批货物呢…",
            "nextDialogs": [
              "732330202"
            ]
          },
          "732330202": {
            "id": "732330202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于里夫的货物…",
            "nextDialogs": [
              "732330203"
            ]
          },
          "732330203": {
            "id": "732330203",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "你是说里夫找我订的货物吗？我刚接了一批货，里面正好有他要的东西。",
            "nextDialogs": [
              "732330204"
            ]
          },
          "732330204": {
            "id": "732330204",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "不过，他买的东西可不少啊…你是帮他来拿货的吗？",
            "nextDialogs": [
              "732330207"
            ]
          },
          "732330207": {
            "id": "732330207",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "除了那个花盆之外，还有各类种子，肥料和园艺用品…",
            "nextDialogs": [
              "732330208"
            ]
          },
          "732330208": {
            "id": "732330208",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "这些东西加起来可不轻啊，你…你一个人搬得过去吗？"
          }
        }
      }
    },
    {
      "subId": "7323303",
      "subQuestName": "将东西带回给里夫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732330301"
        ],
        "dialogs": {
          "732330301": {
            "id": "732330301",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "旅行者！你把东西拿回来了吗？"
          }
        }
      }
    },
    {
      "subId": "7323307",
      "subQuestName": "将东西带回给里夫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732330401"
        ],
        "dialogs": {
          "732330401": {
            "id": "732330401",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "就是这些，太谢谢你了，旅行者。",
            "nextDialogs": [
              "732330404"
            ]
          },
          "732330404": {
            "id": "732330404",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "哎呀，这不是…一次性买多点，免得总是出去嘛…",
            "nextDialogs": [
              "732330405"
            ]
          },
          "732330405": {
            "id": "732330405",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "你先在旁边休息一下吧！我得先把种子种下去，再施点肥料…",
            "nextDialogs": [
              "732330406"
            ]
          },
          "732330406": {
            "id": "732330406",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "里夫开始摆弄起了花盆…",
            "nextDialogs": [
              "732330407"
            ]
          },
          "732330407": {
            "id": "732330407",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "好了！这样就可以了，内尔敏只需要给这盆花浇浇水就行。",
            "nextDialogs": [
              "732330408"
            ]
          },
          "732330408": {
            "id": "732330408",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "旅行者，能不能…再请你帮我把这盆花送去给内尔敏…",
            "nextDialogs": [
              "732330409"
            ]
          },
          "732330409": {
            "id": "732330409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你自己怎么不去？",
            "nextDialogs": [
              "732330410"
            ]
          },
          "732330410": {
            "id": "732330410",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "我得盯着这个路口啊，要是有粮食或者物资运过来，我还得去叫村里的人过来接收物资。",
            "nextDialogs": [
              "732330411"
            ]
          },
          "732330411": {
            "id": "732330411",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "周围这温度…你应该已经感觉到了。要是接收速度太慢，物资说不定都会被晒坏。",
            "nextDialogs": [
              "732330412"
            ]
          },
          "732330412": {
            "id": "732330412",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "拜托你啦旅行者，内尔敏住得离这里不远，你就把这一盆花送去给她就好，其余的东西我会想办法运回去。"
          }
        }
      }
    },
    {
      "subId": "7323304",
      "subQuestName": "将花盆带给内尔敏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7323305",
      "subQuestName": "与内尔敏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732330501"
        ],
        "dialogs": {
          "732330501": {
            "id": "732330501",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "屋内的某人似乎听到了动静…",
            "nextDialogs": [
              "732330502"
            ]
          },
          "732330502": {
            "id": "732330502",
            "speakerId": 1003,
            "speakerName": "内尔敏",
            "text": "你好，请问有什么事吗？",
            "nextDialogs": [
              "732330503"
            ]
          },
          "732330503": {
            "id": "732330503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于这盆花…",
            "nextDialogs": [
              "732330504"
            ]
          },
          "732330504": {
            "id": "732330504",
            "speakerId": 1003,
            "speakerName": "内尔敏",
            "text": "这是…里夫送给我的？",
            "nextDialogs": [
              "732330505"
            ]
          },
          "732330505": {
            "id": "732330505",
            "speakerId": 1003,
            "speakerName": "内尔敏",
            "text": "这盆里种着花吗？真的？谢谢你帮他送来，我很喜欢…",
            "nextDialogs": [
              "732330506"
            ]
          },
          "732330506": {
            "id": "732330506",
            "speakerId": 1003,
            "speakerName": "内尔敏",
            "text": "不过…我真的能养好它吗…",
            "nextDialogs": [
              "732330507"
            ]
          },
          "732330507": {
            "id": "732330507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你之前没养过花吗？",
            "nextDialogs": [
              "732330508"
            ]
          },
          "732330508": {
            "id": "732330508",
            "speakerId": 1003,
            "speakerName": "内尔敏",
            "text": "我…我不擅长照顾植物，之前好多盆绿植都被我养得枯萎了…",
            "nextDialogs": [
              "732330509"
            ]
          },
          "732330509": {
            "id": "732330509",
            "speakerId": 1003,
            "speakerName": "内尔敏",
            "text": "这盆花一定更娇贵，要是我又把它给养枯的话…",
            "nextDialogs": [
              "732330510"
            ]
          },
          "732330510": {
            "id": "732330510",
            "speakerId": 1003,
            "speakerName": "内尔敏",
            "text": "唔，不行，既然花已经到我手上了，我就要好好照顾它才行！",
            "nextDialogs": [
              "732330511"
            ]
          },
          "732330511": {
            "id": "732330511",
            "speakerId": 1003,
            "speakerName": "内尔敏",
            "text": "库尔苏姆奶奶一定知道怎么解决这个问题…"
          }
        }
      }
    },
    {
      "subId": "7323306",
      "subQuestName": "向里夫回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732330601"
        ],
        "dialogs": {
          "732330601": {
            "id": "732330601",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "旅行者，你回来了，真是辛苦你了…内尔敏怎么说？",
            "nextDialogs": [
              "732330603",
              "732330606"
            ]
          },
          "732330603": {
            "id": "732330603",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "这个…我会陪着她研究这事的啦，实在不行就去找人问问…",
            "nextDialogs": [
              "732330604"
            ]
          },
          "732330604": {
            "id": "732330604",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "要是真不行，我…我就…我就去找点容易种，又容易成活的东西…",
            "nextDialogs": [
              "732330608"
            ]
          },
          "732330608": {
            "id": "732330608",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "咳，总之…谢谢你帮我的忙，旅行者，这些报酬请你收下。",
            "nextDialogs": [
              "732330609"
            ]
          },
          "732330609": {
            "id": "732330609",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "等会我就把其他的东西给内尔敏拿过去。",
            "nextDialogs": [
              "732330610"
            ]
          },
          "732330610": {
            "id": "732330610",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "等等，这些园艺工具没附带使用说明书吗？我完全不知道怎么用它们啊！"
          },
          "732330606": {
            "id": "732330606",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "也不能说没送过吧…只不过前几次我托人买的都是已经长成的花。等送到村里来的时候，那些花已经快被晒干了…",
            "nextDialogs": [
              "732330607"
            ]
          },
          "732330607": {
            "id": "732330607",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "所以这次，我决定直接送内尔敏一盆刚种下的花。"
          }
        }
      }
    },
    {
      "subId": "7323307",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732330701"
        ],
        "dialogs": {
          "732330701": {
            "id": "732330701",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "唉，真希望内尔敏能快点好起来…"
          }
        }
      }
    },
    {
      "subId": "7323308",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732330801"
        ],
        "dialogs": {
          "732330801": {
            "id": "732330801",
            "speakerId": 1001,
            "speakerName": "阿扎莱",
            "text": "奇怪了，还有一批货物呢…"
          }
        }
      }
    },
    {
      "subId": "7323309",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732330901"
        ],
        "dialogs": {
          "732330901": {
            "id": "732330901",
            "speakerId": 1000,
            "speakerName": "里夫",
            "text": "我…我是不是买太多了…"
          }
        }
      }
    },
    {
      "subId": "7323310",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732331001"
        ],
        "dialogs": {
          "732331001": {
            "id": "732331001",
            "speakerId": 1003,
            "speakerName": "内尔敏",
            "text": "如果真的每天都要给花浇水，那得用多少水呢…"
          }
        }
      }
    }
  ]
}
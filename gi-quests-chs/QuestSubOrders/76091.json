    {
      "subId": "7609107",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760910702"
        ],
        "dialogs": {
          "760910702": {
            "id": "760910702",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我看看…没错！就是这些，太感谢了。这里面可是记录了不少愚人众的罪证呢。",
            "nextDialogs": [
              "760910703"
            ]
          },
          "760910703": {
            "id": "760910703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…罪证？",
            "nextDialogs": [
              "760910704"
            ]
          },
          "760910704": {
            "id": "760910704",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你瞧他们在帕哈岛上建的那些设施，还有他们带来的机械装置…那里原本也是很多动物的家呀。",
            "nextDialogs": [
              "760910705"
            ]
          },
          "760910705": {
            "id": "760910705",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我刚从绯沙盐沼回来，一定是因为愚人众的机器，那边的水母都奄奄一息了…我得让大家都知道这件事才行。",
            "nextDialogs": [
              "760910706"
            ]
          },
          "760910706": {
            "id": "760910706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样…",
            "nextDialogs": [
              "760910709"
            ]
          },
          "760910709": {
            "id": "760910709",
            "speakerId": 1002,
            "speakerName": "谢苗",
            "text": "对了，如果你们要和别人说，一定要说是谢苗，也就是我告诉你们的。毕竟回去写成文章在报纸上刊登还需要时间…",
            "nextDialogs": [
              "760910710"
            ]
          },
          "760910710": {
            "id": "760910710",
            "speakerId": 1002,
            "speakerName": "谢苗",
            "text": "这份笔记就交给你们了。我得快点回去把其他的笔记的内容整理好，写成文章才行。",
            "nextDialogs": [
              "760910701"
            ]
          },
          "760910701": {
            "id": "760910701",
            "speakerId": 1002,
            "speakerName": "谢苗",
            "text": "总之多谢你们，再见！"
          }
        }
      }
    },

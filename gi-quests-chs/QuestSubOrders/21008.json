          "210081001"
        ],
        "dialogs": {
          "210081001": {
            "id": "210081001",
            "speakerId": 2428,
            "speakerName": "星火",
            "text": "呼…这下就没问题了，太感谢你了，$UNRELEASED",
            "nextDialogs": [
              "210081002"
            ]
          },
          "210081002": {
            "id": "210081002",
            "speakerId": 2428,
            "speakerName": "星火",
            "text": "这些谢礼，请你收下吧。$UNRELEASED"
          }
        }
      }
    },
    {
      "subId": "2100801",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210080101"
        ],
        "dialogs": {
          "210080101": {
            "id": "210080101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你为什么不自己去…$UNRELEASED",
            "nextDialogs": [
              "210080102"
            ]
          },
          "210080102": {
            "id": "210080102",
            "speakerId": 2428,
            "speakerName": "星火",
            "text": "呃，是这样，会有人来抽查火把的情况…我在这里还能拖一拖时间…$UNRELEASED",
            "nextDialogs": [
              "210080103"
            ]
          },
          "210080103": {
            "id": "210080103",
            "speakerId": 2428,
            "speakerName": "星火",
            "text": "要是你站在这，或者这里根本没人，那不就糟糕了吗？$UNRELEASED",
            "nextDialogs": [
              "210080104"
            ]
          },
          "210080104": {
            "id": "210080104",
            "speakerId": 2428,
            "speakerName": "星火",
            "text": "所以，拜托你了旅行者！去点燃火把吧！$UNRELEASED"
          }
        }
      }
    },
    {
      "subId": "2100890",

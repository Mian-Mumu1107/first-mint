    {
      "subId": "7502801",
      "subQuestName": "(test)击退埋伏的头套人$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750280101"
        ],
        "dialogs": {
          "750280101": {
            "id": "750280101",
            "speakerId": 21564,
            "speakerName": "老鼠",
            "text": "啧，敢情遇上硬茬子了。",
            "nextDialogs": [
              "750280102"
            ]
          },
          "750280102": {
            "id": "750280102",
            "speakerId": 21565,
            "speakerName": "夜猫子",
            "text": "哎哟，今儿个这是什么日子，我又招谁惹谁了，给我一顿好打…",
            "nextDialogs": [
              "750280103"
            ]
          },
          "750280103": {
            "id": "750280103",
            "speakerId": 21565,
            "speakerName": "夜猫子",
            "text": "#{M#大兄弟}{F#好姐姐}，您可得给我点拨一下，我这又是做了什么拂了您的心意，叫我知道知道，好今后不要再犯。",
            "nextDialogs": [
              "750280104"
            ]
          },
          "750280104": {
            "id": "750280104",
            "speakerId": 21564,
            "speakerName": "老鼠",
            "text": "喂！你小子，对这凶神恶煞的魔头低声下气的，有没有点出息？",
            "nextDialogs": [
              "750280105"
            ]
          },
          "750280105": {
            "id": "750280105",
            "speakerId": 21565,
            "speakerName": "夜猫子",
            "text": "出息？出息能当饭吃？我算是看清了，跟你混无非就是做些鸡鸣狗盗的营生，贩龙又有什么了不起的？",
            "nextDialogs": [
              "750280106"
            ]
          },
          "750280106": {
            "id": "750280106",
            "speakerId": 21565,
            "speakerName": "夜猫子",
            "text": "#横竖都要被更强的煞星打劫，那我为什么不跟这边的{M#大兄弟}{F#好姐姐}混？",
            "nextDialogs": [
              "750280107"
            ]
          },
          "750280107": {
            "id": "750280107",
            "speakerId": 21565,
            "speakerName": "夜猫子",
            "text": "#{M#大兄弟}{F#好姐姐}，不是我自夸，但我肯定比你带的这两个拖油瓶伶俐多了，有什么事您招呼我，保准给您安排得服服帖帖的。",
            "nextDialogs": [
              "750280108"
            ]
          },
          "750280108": {
            "id": "750280108",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯？",
            "nextDialogs": [
              "750280110"
            ]
          },
          "750280110": {
            "id": "750280110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你不会真想带着他吧？不行不行！我不同意！",
            "nextDialogs": [
              "750280112"
            ]
          },
          "750280112": {
            "id": "750280112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#而且你们根本就是坏蛋吧！我们可是正派人士，才不会跟龙贩子为伍，对吧，{NICKNAME}？"
          }
        }
      }
    },

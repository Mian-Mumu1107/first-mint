        "startDialogs": [
          "190940701"
        ],
        "dialogs": {
          "190940701": {
            "id": "190940701",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "…凯亚是个不好应付的人啊，不过免费的酒真好喝。",
            "nextDialogs": [
              "190940702"
            ]
          },
          "190940702": {
            "id": "190940702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "温迪可以拒绝的。",
            "nextDialogs": [
              "190940703"
            ]
          },
          "190940703": {
            "id": "190940703",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "虽然不是很明白西风教会在唱诗方面的条条框框，但没关系，只要真心喜欢音乐，我就一定能帮上忙。",
            "nextDialogs": [
              "190940706"
            ]
          },
          "190940706": {
            "id": "190940706",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哎呀，我开心，修女开心，听众也开心，这不是大好事嘛。"
          }
        }
      }
    },
    {
      "subId": "1909410",

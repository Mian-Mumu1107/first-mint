            "id": "190941401",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "想好了就可以写下来，然后我们再一起讨论。",
            "nextDialogs": [
              "190941402"
            ]
          },
          "190941402": {
            "id": "190941402",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "我想，歌里可以表达和亲人团聚的幸福。",
            "nextDialogs": [
              "190941403"
            ]
          },
          "190941403": {
            "id": "190941403",
            "speakerId": 1061,
            "speakerName": "迪奥娜",
            "text": "是写鱼头汤呢，还是璃月烤鱼呢…"
          }
        }
      }
    },
    {
      "subId": "1909415",
      "subQuestName": "Additional",

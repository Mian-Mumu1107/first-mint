        "dialogs": {
          "664930501": {
            "id": "664930501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "今天生意怎么样？",
            "nextDialogs": [
              "664930502"
            ]
          },
          "664930502": {
            "id": "664930502",
            "speakerId": 6493,
            "speakerName": "拉威亚",
            "text": "生意还不错，而且很奇怪，今天的渔获突然变新鲜了。",
            "nextDialogs": [
              "664930503"
            ]
          },
          "664930503": {
            "id": "664930503",
            "speakerId": 6493,
            "speakerName": "拉威亚",
            "text": "老板还特意跑来跟我说，最近工作做的不错，还给了我一笔奖金，真是头一回…",
            "nextDialogs": [
              "664930504"
            ]
          },
          "664930504": {
            "id": "664930504",
            "speakerId": 6493,
            "speakerName": "拉威亚",
            "text": "我都要怀疑了，不会是我的坏话传到他耳朵里了吧？",
            "nextDialogs": [
              "664930505"
            ]
          },
          "664930505": {
            "id": "664930505",
            "speakerId": 6493,
            "speakerName": "拉威亚",
            "text": "算了，不管怎么说，拿到奖金的好运气可不常有，来，分你一点吧，这样好运气也分你一点。"
          }
        }
      }

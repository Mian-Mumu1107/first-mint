  "subQuests": [
    {
      "subId": "7468601",
      "subQuestName": "与泽维尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746860101"
        ],
        "dialogs": {
          "746860101": {
            "id": "746860101",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "你好呀，大冒险家。",
            "nextDialogs": [
              "746860102"
            ]
          },
          "746860102": {
            "id": "746860102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请称呼我为大剪辑师。",
            "nextDialogs": [
              "746860103"
            ]
          },
          "746860103": {
            "id": "746860103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请称呼我为广告高手！",
            "nextDialogs": [
              "746860104"
            ]
          },
          "746860104": {
            "id": "746860104",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "哈哈，看起来广告片制作没让你觉得太无聊！还好，要不然我就该自我怀疑了，是不是拿宝贵的相聚时间，做了无趣的事。",
            "nextDialogs": [
              "746860105"
            ]
          },
          "746860105": {
            "id": "746860105",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "毕竟我们不总是有时间碰面，要找一位全世界旅行的冒险家，这难度不比把星星从天上扯下来低多少。",
            "nextDialogs": [
              "746860106"
            ]
          },
          "746860106": {
            "id": "746860106",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "有的时候，就像现在，在咖啡馆里都能碰上你，有的时候，就算到处和人打听你去哪儿了，也没人知道。",
            "nextDialogs": [
              "746860107"
            ]
          },
          "746860107": {
            "id": "746860107",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "好处是每次见到你，绝对能听到跌宕起伏的新故事，永远不会无聊。坏处是不知道哪一次和你见面就会变成最后一次。",
            "nextDialogs": [
              "746860110"
            ]
          },
          "746860110": {
            "id": "746860110",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "哈哈，好吧，我也觉得自己再抱怨下去，就要变成公益广告里的空巢老人了。",
            "nextDialogs": [
              "746860111"
            ]
          },
          "746860111": {
            "id": "746860111",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "手头的广告片都完成得差不多了，接下来我该为拍出下一部长篇，继续焦头烂额了。咱们不见面的时候，就各自为梦想努力吧！",
            "nextDialogs": [
              "746860112"
            ]
          },
          "746860112": {
            "id": "746860112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会的。",
            "nextDialogs": [
              "746860113"
            ]
          },
          "746860113": {
            "id": "746860113",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "啊，但我还是要说，有空记得找我吃饭！不在枫丹也行。",
            "nextDialogs": [
              "746860114"
            ]
          },
          "746860114": {
            "id": "746860114",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "猎鹿人、万民堂、兰巴德酒馆之类的…去野炊或者打猎也可以考虑…只要我还能跟得上…总而言之，保持联络！"
          }
        }
      }
    }
  ]
}
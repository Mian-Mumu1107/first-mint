    },
    {
      "subId": "42706",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4270601"
        ],
        "dialogs": {
          "4270601": {
            "id": "4270601",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "不要心急啊，起飞的诀窍在于勇气，降落的要点却是冷静呢。",
            "nextDialogs": [
              "4270604"
            ]
          },
          "4270604": {
            "id": "4270604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我再观察一下。",
            "nextDialogs": [
              "4270605"
            ]
          },
          "4270605": {
            "id": "4270605",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "要仔细观察喔，我就在这等你。"
          }
        }
      }
    }

    {
      "subId": "7419604",
      "subQuestName": "进入「黄金宫殿」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741960401"
        ],
        "dialogs": {
          "741960401": {
            "id": "741960401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼，终于进来了，真不容易啊！",
            "nextDialogs": [
              "741960402"
            ]
          },
          "741960402": {
            "id": "741960402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说是黄金的宫殿，不过看起来倒不像是宫殿，更像是某个巨大机器的内部呢！",
            "nextDialogs": [
              "741960403"
            ]
          },
          "741960403": {
            "id": "741960403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这个地方…很熟悉。",
            "nextDialogs": [
              "741960404"
            ]
          },
          "741960404": {
            "id": "741960404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，是你之前在雷穆斯的记忆里见到的地方吗？",
            "nextDialogs": [
              "741960405"
            ]
          },
          "741960405": {
            "id": "741960405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以那个没礼貌的坏蛋才想在这里…要是让他得逞的话可就糟糕了！",
            "nextDialogs": [
              "741960406"
            ]
          },
          "741960406": {
            "id": "741960406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且也不知道呜斯先生现在怎么样了…",
            "nextDialogs": [
              "741960407"
            ]
          },
          "741960407": {
            "id": "741960407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "无论如何，我们也只能继续前进了。"
          }
        }
      }
    },
    {
      "subId": "7419605",
      "subQuestName": "继续前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741960501"
        ],
        "dialogs": {
          "741960501": {
            "id": "741960501",
            "speakerId": 21447,
            "speakerName": "波爱修斯",
            "text": "真是纠缠不休的杂碎…",
            "nextDialogs": [
              "741960502"
            ]
          },
          "741960502": {
            "id": "741960502",
            "speakerId": 21447,
            "speakerName": "波爱修斯",
            "text": "修好破碎的水道，是想以此庆贺我作为旧日之神的诞生吗？",
            "nextDialogs": [
              "741960503"
            ]
          },
          "741960503": {
            "id": "741960503",
            "speakerId": 21447,
            "speakerName": "波爱修斯",
            "text": "不过在我的新世界，是不需要水道，也不需要航船的…",
            "nextDialogs": [
              "741960504"
            ]
          },
          "741960504": {
            "id": "741960504",
            "speakerId": 21447,
            "speakerName": "波爱修斯",
            "text": "因为所有人都会在我的「乐章」中得到永恒的幸福。",
            "nextDialogs": [
              "741960505"
            ]
          },
          "741960505": {
            "id": "741960505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们是来为你的乐章画上休止符的。",
            "nextDialogs": [
              "741960506"
            ]
          },
          "741960506": {
            "id": "741960506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没错，你最好老实认输，释放镇上大家的灵魂…还有，快把呜斯先生交出来！",
            "nextDialogs": [
              "741960507"
            ]
          },
          "741960507": {
            "id": "741960507",
            "speakerId": 21447,
            "speakerName": "波爱修斯",
            "text": "哼，卡西奥多他已经同意参与这伟大的仪式，重归雷穆利亚的怀抱了。",
            "nextDialogs": [
              "741960508"
            ]
          },
          "741960508": {
            "id": "741960508",
            "speakerId": 21447,
            "speakerName": "波爱修斯",
            "text": "属于雷穆利亚的全部意志都将融为一体，所谓友谊难道不是你们的自以为是吗？",
            "nextDialogs": [
              "741960509"
            ]
          },
          "741960509": {
            "id": "741960509",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "……",
            "nextDialogs": [
              "741960510"
            ]
          },
          "741960510": {
            "id": "741960510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜斯先生！",
            "nextDialogs": [
              "741960511"
            ]
          },
          "741960511": {
            "id": "741960511",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "（相信我…）"
          }
        }
      }
    },
    {
      "subId": "7419606",
      "subQuestName": "打倒「波爱修斯」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7419607",
      "subQuestName": "(test)波爱修斯对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741960701"
        ],
        "dialogs": {
          "741960701": {
            "id": "741960701",
            "speakerId": 21447,
            "speakerName": "波爱修斯",
            "text": "什么？！怎么会…",
            "nextDialogs": [
              "741960702"
            ]
          },
          "741960702": {
            "id": "741960702",
            "speakerId": 21447,
            "speakerName": "波爱修斯",
            "text": "为什么我会无法控制这具身体…卡西奥多，是你吗！",
            "nextDialogs": [
              "741960703"
            ]
          },
          "741960703": {
            "id": "741960703",
            "speakerId": 21355,
            "speakerName": "卡西奥多",
            "text": "终于抓住你了，波爱修斯！你所有的意志，「福波斯」都在这里，这次你跑不掉了。",
            "nextDialogs": [
              "741960704"
            ]
          },
          "741960704": {
            "id": "741960704",
            "speakerId": 21447,
            "speakerName": "波爱修斯",
            "text": "为什么？！我是调律师，「乐章」的指挥者是我，你怎么可能…",
            "nextDialogs": [
              "741960705"
            ]
          },
          "741960705": {
            "id": "741960705",
            "speakerId": 21355,
            "speakerName": "卡西奥多",
            "text": "你忘了，在至尊将我从大乐章中分离之前，我也曾是调律师！现在我回到了「乐章」之中，你不再是唯一的演奏者了。",
            "nextDialogs": [
              "741960706"
            ]
          },
          "741960706": {
            "id": "741960706",
            "speakerId": 21447,
            "speakerName": "波爱修斯",
            "text": "哈，原来你答应加入我的计划，只是为了使我放下戒备。最后，你再次背叛了我，背叛了雷穆利亚！",
            "nextDialogs": [
              "741960707"
            ]
          },
          "741960707": {
            "id": "741960707",
            "speakerId": 21447,
            "speakerName": "波爱修斯",
            "text": "想想那些被囚禁在深水之下的可悲的同族，想想他们遭受的数千年的折磨…",
            "nextDialogs": [
              "741960708"
            ]
          },
          "741960708": {
            "id": "741960708",
            "speakerId": 21447,
            "speakerName": "波爱修斯",
            "text": "你却要为了那些低贱的地上之人，毁了我们的事业，浇灭我们唯一的希望。",
            "nextDialogs": [
              "741960709"
            ]
          },
          "741960709": {
            "id": "741960709",
            "speakerId": 21355,
            "speakerName": "卡西奥多",
            "text": "背叛了雷穆利亚的是你，囚禁他们的也是你。正是你的背叛，才使我们的国家遭致灭亡的命运。",
            "nextDialogs": [
              "741960710"
            ]
          },
          "741960710": {
            "id": "741960710",
            "speakerId": 21355,
            "speakerName": "卡西奥多",
            "text": "至尊…王上所赐予我们的正义，那个金色的理想，乃是希望我们能够遵从内心的旋律，掌握命运的自由。",
            "nextDialogs": [
              "741960711"
            ]
          },
          "741960711": {
            "id": "741960711",
            "speakerId": 21355,
            "speakerName": "卡西奥多",
            "text": "我们不愿接受「法图纳」的审判，更不应成为你的奴仆。",
            "nextDialogs": [
              "741960712"
            ]
          },
          "741960712": {
            "id": "741960712",
            "speakerId": 21355,
            "speakerName": "卡西奥多",
            "text": "「福波斯」破碎后，人们原本应当获得自由的机会。如果不是因为你当初的欺骗，他们的噩梦早就该结束了。",
            "nextDialogs": [
              "741960713"
            ]
          },
          "741960713": {
            "id": "741960713",
            "speakerId": 21447,
            "speakerName": "波爱修斯",
            "text": "雷穆利亚没有灭亡！在「福波斯」的指引下，它还会再度崛起…",
            "nextDialogs": [
              "741960714"
            ]
          },
          "741960714": {
            "id": "741960714",
            "speakerId": 21355,
            "speakerName": "卡西奥多",
            "text": "「无论这顽石与金属的重击如何轰鸣，没有了水和土，人类就没办法生存。」",
            "nextDialogs": [
              "741960715"
            ]
          },
          "741960715": {
            "id": "741960715",
            "speakerId": 21355,
            "speakerName": "卡西奥多",
            "text": "不管拥有多么强大的力量，但倘若因此便肆意践踏生命的价值，那这种力量也就毫无意义可言。",
            "nextDialogs": [
              "741960716"
            ]
          },
          "741960716": {
            "id": "741960716",
            "speakerId": 21355,
            "speakerName": "卡西奥多",
            "text": "波爱修斯，你不也是人类吗？所有的雷穆利亚人曾经都是普通的枫丹人啊。",
            "nextDialogs": [
              "741960717"
            ]
          },
          "741960717": {
            "id": "741960717",
            "speakerId": 21355,
            "speakerName": "卡西奥多",
            "text": "即便我们抛弃了苦弱的肉身，拥有了不朽的躯体，但我们仍然有着凡人的灵魂，也有着凡人的感情与弱点。",
            "nextDialogs": [
              "741960718"
            ]
          },
          "741960718": {
            "id": "741960718",
            "speakerId": 21355,
            "speakerName": "卡西奥多",
            "text": "而我们却忘记了这一点，忘记了自己的出身，自以为高踞于其他人之上，雷穆利亚就是因此才会灭亡的。",
            "nextDialogs": [
              "741960719"
            ]
          },
          "741960719": {
            "id": "741960719",
            "speakerId": 21355,
            "speakerName": "卡西奥多",
            "text": "#{NICKNAME}，还记得我说过的话吗，就是现在了！"
          }
        }
      }
    },
    {
      "subId": "7419608",
      "subQuestName": "打倒「波爱修斯」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7419609",
      "subQuestName": "(test)卡西奥多波爱修斯对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741960901"
        ],
        "dialogs": {
          "741960901": {
            "id": "741960901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊，感觉晕乎乎的…",
            "nextDialogs": [
              "741960902"
            ]
          },
          "741960902": {
            "id": "741960902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "卡西奥多…",
            "nextDialogs": [
              "741960903"
            ]
          },
          "741960903": {
            "id": "741960903",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "#{NICKNAME}，还有派蒙，没想到我们还能像这个样子见面。",
            "nextDialogs": [
              "741960904"
            ]
          },
          "741960904": {
            "id": "741960904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你是…是呜斯先生！",
            "nextDialogs": [
              "741960905"
            ]
          },
          "741960905": {
            "id": "741960905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，还有波爱修斯也在…这家伙该不会又想耍什么花招吧！",
            "nextDialogs": [
              "741960906"
            ]
          },
          "741960906": {
            "id": "741960906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，不对！是我眼花了吗，飘在那里的是什么东西啦！",
            "nextDialogs": [
              "741960907"
            ]
          },
          "741960907": {
            "id": "741960907",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "你们也看到了吗？隐藏在「波爱修斯」的幻象之后的家伙。",
            "nextDialogs": [
              "741960908"
            ]
          },
          "741960908": {
            "id": "741960908",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "哎呀，你发现我了！",
            "nextDialogs": [
              "741960909"
            ]
          },
          "741960909": {
            "id": "741960909",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "可那并不是幻象，你们所见到的确实就是「波爱修斯」，因为，我就是「波爱修斯」啊！",
            "nextDialogs": [
              "741960910"
            ]
          },
          "741960910": {
            "id": "741960910",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "当然，我并不只是「波爱修斯」，我也是「你」…",
            "nextDialogs": [
              "741960911"
            ]
          },
          "741960911": {
            "id": "741960911",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我是一切旋律，一切乐章，一切思绪…我是一切灵魂的总和！",
            "nextDialogs": [
              "741960912"
            ]
          },
          "741960912": {
            "id": "741960912",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "我就是「福波斯」。",
            "nextDialogs": [
              "741960913"
            ]
          },
          "741960913": {
            "id": "741960913",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "不过不包括你们这些外面来的孩子呢，你们可不属于「我们」。",
            "nextDialogs": [
              "741960914"
            ]
          },
          "741960914": {
            "id": "741960914",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "「福波斯」…统辖一切的大乐章，竟然拥有人格？",
            "nextDialogs": [
              "741960915"
            ]
          },
          "741960915": {
            "id": "741960915",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "「福波斯」，或者说原来的那个「西比尔」，原本是上一次洪水吞没大地后的幸存者。",
            "nextDialogs": [
              "741960916"
            ]
          },
          "741960916": {
            "id": "741960916",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "「西比尔」的愿望是为世界上所有被称为人类的存在送去幸福，但她没有人格，也没有足够的力量。",
            "nextDialogs": [
              "741960917"
            ]
          },
          "741960917": {
            "id": "741960917",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "为此，她将自己的智慧交给了雷穆斯，加上雷穆斯所拥有的力量，便创造出了「乐{RUBY#[D]福波斯}章」，也就是我。",
            "nextDialogs": [
              "741960918"
            ]
          },
          "741960918": {
            "id": "741960918",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "怎么会…",
            "nextDialogs": [
              "741960919"
            ]
          },
          "741960919": {
            "id": "741960919",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "我们一直以来所演奏的乐章，所接受的命运，都是来自于你…",
            "nextDialogs": [
              "741960920"
            ]
          },
          "741960920": {
            "id": "741960920",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "是「我」，但也是「你们」呀！因为「我」就是「你们」，是你们所有人的愿望的集合啊。",
            "nextDialogs": [
              "741960921"
            ]
          },
          "741960921": {
            "id": "741960921",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "排除异己，肆意地消灭其他生命，毁灭城镇与乡村，这些难道也是我们的愿望吗？",
            "nextDialogs": [
              "741960922"
            ]
          },
          "741960922": {
            "id": "741960922",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "是呀！因为「你们」这样希望，「我」才会如此回应。掠夺、仇恨、杀戮…这些也是「你们」愿望的一部分。",
            "nextDialogs": [
              "741960923"
            ]
          },
          "741960923": {
            "id": "741960923",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "要为「所有人」送去幸福，难道不应该实现这些愿望吗？",
            "nextDialogs": [
              "741960924"
            ]
          },
          "741960924": {
            "id": "741960924",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不可理喻…",
            "nextDialogs": [
              "741960925"
            ]
          },
          "741960925": {
            "id": "741960925",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这根本就是强词夺理吧！",
            "nextDialogs": [
              "741960926"
            ]
          },
          "741960926": {
            "id": "741960926",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "…不，那并不是我们真正的愿望！我们之中滋生的傲慢与仇恨扭曲了你，把你变成了可怕的怪物…",
            "nextDialogs": [
              "741960927"
            ]
          },
          "741960927": {
            "id": "741960927",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "没有人会因此获得幸福，不管是我们，还是我们之外的其他生灵。",
            "nextDialogs": [
              "741960928"
            ]
          },
          "741960928": {
            "id": "741960928",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "怪不得你会把我们引向毁灭的结局。就是因为察觉到了这一点，王上才会…",
            "nextDialogs": [
              "741960929"
            ]
          },
          "741960929": {
            "id": "741960929",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "雷穆斯…他的确曾试图消灭我。可是为什么呢？如果没有了我，「你们」一定会再度陷入迷茫与痛苦之中…",
            "nextDialogs": [
              "741960930"
            ]
          },
          "741960930": {
            "id": "741960930",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "啊啊…为了大家的幸福，我只好将他…",
            "nextDialogs": [
              "741960931"
            ]
          },
          "741960931": {
            "id": "741960931",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "什么？！难道说那个时候，波爱修斯就已经…",
            "nextDialogs": [
              "741960932"
            ]
          },
          "741960932": {
            "id": "741960932",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "没错，一定是这样…我们是不可能违抗至尊的命令的，除非背叛他的是「乐章」本身…波爱修斯怎么了，你到底对他做了什么？",
            "nextDialogs": [
              "741960933"
            ]
          },
          "741960933": {
            "id": "741960933",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "唔，他当然已经变成「我们」了啊，用你们能理解的说法：他被我吃掉了！",
            "nextDialogs": [
              "741960934"
            ]
          },
          "741960934": {
            "id": "741960934",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吃掉…好可怕…",
            "nextDialogs": [
              "741960935"
            ]
          },
          "741960935": {
            "id": "741960935",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "嗯？但是这也是他的愿望哦，而只有我才能实现他的愿望…他一定也因此获得幸福了吧！",
            "nextDialogs": [
              "741960936"
            ]
          },
          "741960936": {
            "id": "741960936",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "所以从那之后，波爱修斯就变成你的傀儡了…所以他才会想尽办法，要让你重新降临于世。",
            "nextDialogs": [
              "741960937"
            ]
          },
          "741960937": {
            "id": "741960937",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "这都是为了「你们」的…为了「所有人」的幸福啊。",
            "nextDialogs": [
              "741960938"
            ]
          },
          "741960938": {
            "id": "741960938",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "哈哈…不！不！是时候该结束这一切了…",
            "nextDialogs": [
              "741960939"
            ]
          },
          "741960939": {
            "id": "741960939",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "你已经被我困在了这副躯体里无法逃脱，而我会将你彻底消灭。",
            "nextDialogs": [
              "741960940"
            ]
          },
          "741960940": {
            "id": "741960940",
            "speakerId": 21463,
            "speakerName": "「福波斯」",
            "text": "「你」的愿望是和「我」一同消失吗？这就是「你」的幸福吗？但是…我不能实现你的愿望。",
            "nextDialogs": [
              "741960941"
            ]
          },
          "741960941": {
            "id": "741960941",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "我既已不是雷穆利亚人，也做不了枫丹人。早在我答应要帮至尊实现他的愿望之时，便已经选择了自己的命运。",
            "nextDialogs": [
              "741960942"
            ]
          },
          "741960942": {
            "id": "741960942",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "所以，这就是我的愿望了，我之所以在世上徘徊了数千年，就是为了这一刻…",
            "nextDialogs": [
              "741960943"
            ]
          },
          "741960943": {
            "id": "741960943",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "为了终结这千年的噩梦！",
            "nextDialogs": [
              "741960944"
            ]
          },
          "741960944": {
            "id": "741960944",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "#{NICKNAME}，就是现在，把我和「福波斯」一同消灭掉吧！",
            "nextDialogs": [
              "741960945"
            ]
          },
          "741960945": {
            "id": "741960945",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但是…",
            "nextDialogs": [
              "741960946"
            ]
          },
          "741960946": {
            "id": "741960946",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "#{NICKNAME}，我很开心啊！至尊曾经的计划与愿望，就在刚才我也已经知道了…",
            "nextDialogs": [
              "741960947"
            ]
          },
          "741960947": {
            "id": "741960947",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "王上想要通过自己的牺牲，将所有人从乐章中，也从仇恨与隔阂中解放出来。",
            "nextDialogs": [
              "741960948"
            ]
          },
          "741960948": {
            "id": "741960948",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "他直到最后一刻都想要拯救他的臣民…如今我将完成他未竟的心愿。这是我们最后的机会了，而这只有你才能做到。",
            "nextDialogs": [
              "741960949"
            ]
          },
          "741960949": {
            "id": "741960949",
            "speakerId": 21461,
            "speakerName": "卡西奥多",
            "text": "也就是因此，我的朋友，王上…命运才会让你来到这里的！"
          }
        }
      }
    },

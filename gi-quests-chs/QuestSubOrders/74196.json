    {
      "subId": "7419621",
      "subQuestName": "与斯库拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741962101"
        ],
        "dialogs": {
          "741962101": {
            "id": "741962101",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "何等耀眼的灵露啊，就像是数千年前一样…那么，时机已至…",
            "nextDialogs": [
              "741962102"
            ]
          },
          "741962102": {
            "id": "741962102",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "就如当初那家伙的旋律从这里流淌到全地之时，当金色的水道奏响之时，黄金宫殿的大门便会打开。",
            "nextDialogs": [
              "741962103"
            ]
          },
          "741962103": {
            "id": "741962103",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "啊，我已经听到了，那美妙的旋律。",
            "nextDialogs": [
              "741962104"
            ]
          },
          "741962104": {
            "id": "741962104",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "#{NICKNAME}，派蒙，我们一起共奏吧！然后你们便能进入黄金宫殿了。"
          }
        }
      }
    },
    {
      "subId": "7419622",
      "subQuestName": "与斯库拉共奏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741962201"
        ],
        "dialogs": {
          "741962201": {
            "id": "741962201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是雷穆斯留给我们的乐章，终于结束了吗…",
            "nextDialogs": [
              "741962202"
            ]
          },
          "741962202": {
            "id": "741962202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们完成了「安魂曲」，被禁锢在海底的灵魂看起来也全都离开了。",
            "nextDialogs": [
              "741962203"
            ]
          },
          "741962203": {
            "id": "741962203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "镇上的大家应该也已经恢复正常了吧。",
            "nextDialogs": [
              "741962204"
            ]
          },
          "741962204": {
            "id": "741962204",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "谢谢你们，完成了这最后的乐章，这延续数千年的愿望。",
            "nextDialogs": [
              "741962205"
            ]
          },
          "741962205": {
            "id": "741962205",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "不论是老夫的，还是雷穆斯的，又或是所有守护现世安定之人的。",
            "nextDialogs": [
              "741962206"
            ]
          },
          "741962206": {
            "id": "741962206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说到这个就想起来呜斯先生…",
            "nextDialogs": [
              "741962207"
            ]
          },
          "741962207": {
            "id": "741962207",
            "speakerId": 21338,
            "speakerName": "小呜斯",
            "text": "喵呜！",
            "nextDialogs": [
              "741962208"
            ]
          },
          "741962208": {
            "id": "741962208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你也很喜欢这个名字吗？不过现在不是在说你哦。",
            "nextDialogs": [
              "741962209"
            ]
          },
          "741962209": {
            "id": "741962209",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "他的灵魂已经回归高海…终于得享宁静了，对他来说这也是一种解脱吧。",
            "nextDialogs": [
              "741962210"
            ]
          },
          "741962210": {
            "id": "741962210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么接下来大家伙要怎么办呢？",
            "nextDialogs": [
              "741962211"
            ]
          },
          "741962211": {
            "id": "741962211",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "这个嘛，好不容易重获自由，老夫可得在水里好好畅游一番呢！",
            "nextDialogs": [
              "741962212"
            ]
          },
          "741962212": {
            "id": "741962212",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "而且现在除了小东西们，也再没人能打扰老夫了吧！",
            "nextDialogs": [
              "741962213"
            ]
          },
          "741962213": {
            "id": "741962213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，什么叫打扰啦！",
            "nextDialogs": [
              "741962214"
            ]
          },
          "741962214": {
            "id": "741962214",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "哈哈，开玩笑的。不过你们也该回到属于你们的地方去了吧，我们也要就此别过了。",
            "nextDialogs": [
              "741962215"
            ]
          },
          "741962215": {
            "id": "741962215",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "虽然是这样说，但是你们可要多多回来看看老夫啊。毕竟大家都走了，老夫说不定会很寂寞呢！",
            "nextDialogs": [
              "741962216"
            ]
          },
          "741962216": {
            "id": "741962216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，说到底大家伙还是很挂念我们的嘛！",
            "nextDialogs": [
              "741962219"
            ]
          },
          "741962219": {
            "id": "741962219",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "哼，看到你们的样子，老夫也有些期待那些地上生灵的未来了！",
            "nextDialogs": [
              "741962220"
            ]
          },
          "741962220": {
            "id": "741962220",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "那么，就有缘再见了。",
            "nextDialogs": [
              "741962221"
            ]
          },
          "741962221": {
            "id": "741962221",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "伴随着海浪的翻腾，斯库拉离开了…",
            "nextDialogs": [
              "741962222"
            ]
          },
          "741962222": {
            "id": "741962222",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么，接下来我们要去哪呢？",
            "nextDialogs": [
              "741962223"
            ]
          },
          "741962223": {
            "id": "741962223",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦对了，我们还没去找埃斯特先生告诉他事情已经解决了吧，明明说好去去就来的！",
            "nextDialogs": [
              "741962224"
            ]
          },
          "741962224": {
            "id": "741962224",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有「小呜斯」…唔，现在要怎么称呼它才好呢，好复杂…",
            "nextDialogs": [
              "741962225"
            ]
          },
          "741962225": {
            "id": "741962225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总之，我们还是先回镇上吧。"
          }
        }
      }
    },
    {
      "subId": "7419603",

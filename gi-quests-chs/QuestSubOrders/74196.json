    {
      "subId": "7419615",
      "subQuestName": "前往「演说台」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741961501"
        ],
        "dialogs": {
          "741961501": {
            "id": "741961501",
            "speakerId": 21431,
            "speakerName": "小呜斯",
            "text": "呜喵？！喵！",
            "nextDialogs": [
              "741961502"
            ]
          },
          "741961502": {
            "id": "741961502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！大家伙！你吓到小呜斯了！",
            "nextDialogs": [
              "741961503"
            ]
          },
          "741961503": {
            "id": "741961503",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "卡西奥多？不…熟悉的气息消失了，卡西奥多去哪儿了？难道是又回到哪具石头躯体当中了吗…",
            "nextDialogs": [
              "741961506"
            ]
          },
          "741961506": {
            "id": "741961506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "卡西奥多…呜斯先生他，已经和波爱修斯，和「福波斯」一起消失了…",
            "nextDialogs": [
              "741961507"
            ]
          },
          "741961507": {
            "id": "741961507",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向斯库拉说明了事情的原委后，花了一段时间安抚小呜斯…",
            "nextDialogs": [
              "741961508"
            ]
          },
          "741961508": {
            "id": "741961508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是这样，现在只有「小呜斯」…它还和我们一起…",
            "nextDialogs": [
              "741961509"
            ]
          },
          "741961509": {
            "id": "741961509",
            "speakerId": 21431,
            "speakerName": "小呜斯",
            "text": "喵喵？",
            "nextDialogs": [
              "741961510"
            ]
          },
          "741961510": {
            "id": "741961510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太好了，看来刚才只是被突然出现的大家伙吓了一跳，小呜斯说不定原本就是很胆大的猫咪呢！",
            "nextDialogs": [
              "741961511"
            ]
          },
          "741961511": {
            "id": "741961511",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "不管怎么说，你们打败了那个妖鬼，而卡西奥多…至少他实现了自己的愿望。",
            "nextDialogs": [
              "741961512"
            ]
          },
          "741961512": {
            "id": "741961512",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "想必他的灵魂，也已经回到了深水之中，和他的同胞们在一起了吧！",
            "nextDialogs": [
              "741961513"
            ]
          },
          "741961513": {
            "id": "741961513",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "只要我们完成雷穆斯留下的最后的乐章，便能将他们的灵魂带去现世，带回高海之上…",
            "nextDialogs": [
              "741961514"
            ]
          },
          "741961514": {
            "id": "741961514",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "生命如水流般循环不息，他们也会化为激流，并且迟早有一天，再度作为凡人诞生吧。",
            "nextDialogs": [
              "741961515"
            ]
          },
          "741961515": {
            "id": "741961515",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "那么，我们开始吧。",
            "nextDialogs": [
              "741961516"
            ]
          },
          "741961516": {
            "id": "741961516",
            "speakerId": 21354,
            "speakerName": "斯库拉",
            "text": "奏响这最后的乐章，最后的「安魂曲」。"
          }
        }
      }
    },
    {
      "subId": "7419616",

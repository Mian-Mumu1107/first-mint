    {
      "subId": "7419699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741969954"
        ],
        "dialogs": {
          "741969954": {
            "id": "741969954",
            "speakerId": 1008,
            "speakerName": "<UNKNOWN>",
            "text": "顺着无数灵魂汇聚而成的洋流，你们离开了深水之下的国度。\\n与引导魂灵的金蜂一起，不断上升，上升…"
          }

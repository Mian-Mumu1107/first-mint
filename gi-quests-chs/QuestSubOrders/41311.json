    {
      "subId": "4131104",
      "subQuestName": "与畅畅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400010901"
        ],
        "dialogs": {
          "400010901": {
            "id": "400010901",
            "speakerId": 1002,
            "speakerName": "畅畅",
            "text": "畅畅呀，刚才把布娃娃捐了哦。",
            "nextDialogs": [
              "400010902"
            ]
          },
          "400010902": {
            "id": "400010902",
            "speakerId": 1002,
            "speakerName": "畅畅",
            "text": "昨晚我梦到她说想要飞到天上去看看。",
            "nextDialogs": [
              "400010903"
            ]
          },
          "400010903": {
            "id": "400010903",
            "speakerId": 1002,
            "speakerName": "畅畅",
            "text": "我就把她捐给大鹿灯那边的姐姐了，马上她就会实现愿望了吧？",
            "nextDialogs": [
              "400010904"
            ]
          },
          "400010904": {
            "id": "400010904",
            "speakerId": 1002,
            "speakerName": "畅畅",
            "text": "畅畅是做了件好事吗？海灯节是实现大家愿望的日子吧？"
          }
        }
      }
    },
    {
      "subId": "4131105",
      "subQuestName": "与萍姥姥对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400010601"
        ],
        "dialogs": {
          "400010601": {
            "id": "400010601",
            "speakerId": 1003,
            "speakerName": "萍姥姥",
            "text": "今年「明霄灯」的造型是纪念「移霄导天真君」啊，那个喜欢逞威风的家伙应该会高兴的吧…",
            "nextDialogs": [
              "400010603",
              "400010612"
            ]
          },
          "400010603": {
            "id": "400010603",
            "speakerId": 1003,
            "speakerName": "萍姥姥",
            "text": "今年海灯节在建造的「明霄灯」，就是「移霄导天真君」的形象。",
            "nextDialogs": [
              "400010604"
            ]
          },
          "400010604": {
            "id": "400010604",
            "speakerId": 1003,
            "speakerName": "萍姥姥",
            "text": "希望他们会把鹿角修得大一些，毕竟头上的角可是那位仙人最引以为傲的。",
            "nextDialogs": [
              "400010605"
            ]
          },
          "400010605": {
            "id": "400010605",
            "speakerId": 1003,
            "speakerName": "萍姥姥",
            "text": "据说，他的角吸收了岩王帝君岩之力的神髓，曾是整个璃月最坚硬的东西。",
            "nextDialogs": [
              "400010606"
            ]
          },
          "400010606": {
            "id": "400010606",
            "speakerId": 1003,
            "speakerName": "萍姥姥",
            "text": "可就在「那场决战」中，劲力迸出，山岳倾倒，他为了不波及到山脚的村庄，主动让朋友将他的鹿角砍下…",
            "nextDialogs": [
              "400010607"
            ]
          },
          "400010607": {
            "id": "400010607",
            "speakerId": 1003,
            "speakerName": "萍姥姥",
            "text": "他将那鲜血淋漓的鹿角作为支点，撑起了整个山岳。而他自己也坚持战斗到自己流尽最后一滴血…",
            "nextDialogs": [
              "400010608"
            ]
          },
          "400010608": {
            "id": "400010608",
            "speakerId": 1003,
            "speakerName": "萍姥姥",
            "text": "如今，曾被他撑起的「天衡山」依然巍然屹立，他死战之中流出的鲜血则汇聚而成「碧水河」。",
            "nextDialogs": [
              "400010609"
            ]
          },
          "400010609": {
            "id": "400010609",
            "speakerId": 1003,
            "speakerName": "萍姥姥",
            "text": "呵呵…不论你是否相信我讲的，能有人愿意听听这些陈年旧事，就已经是很大的安慰了。",
            "nextDialogs": [
              "400010610"
            ]
          },
          "400010610": {
            "id": "400010610",
            "speakerId": 1003,
            "speakerName": "萍姥姥",
            "text": "海灯节之所以存在，也是因为那些「老朋友们」不甘寂寞吧。"
          },
          "400010612": {
            "id": "400010612",
            "speakerId": 1003,
            "speakerName": "萍姥姥",
            "text": "再见。愿薪火相传，美德不灭。"
          }
        }
      }
    },
    {
      "subId": "4131106",
      "subQuestName": "与江舟对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413110601"
        ],
        "dialogs": {
          "413110601": {
            "id": "413110601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，快看！那块石头浮在空中欸，而且连链子都拉直了。",
            "nextDialogs": [
              "413110602"
            ]
          },
          "413110602": {
            "id": "413110602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "如果没有锁链拴住，不知道它会飞去哪里呢？",
            "nextDialogs": [
              "413110603"
            ]
          },
          "413110603": {
            "id": "413110603",
            "speakerId": 1004,
            "speakerName": "江舟",
            "text": "这就是用来制作「明霄灯」的浮生石。整个「霄市」就是围绕着它布设的。",
            "nextDialogs": [
              "413110604"
            ]
          },
          "413110604": {
            "id": "413110604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，请问你是…？",
            "nextDialogs": [
              "413110605"
            ]
          },
          "413110605": {
            "id": "413110605",
            "speakerId": 1004,
            "speakerName": "江舟",
            "text": "我是江舟，最近负责明霄灯的建设进度统计。",
            "nextDialogs": [
              "413110606"
            ]
          },
          "413110606": {
            "id": "413110606",
            "speakerId": 1004,
            "speakerName": "江舟",
            "text": "看样子你们是第一次来璃月见识海灯节吧？",
            "nextDialogs": [
              "413110607"
            ]
          },
          "413110607": {
            "id": "413110607",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错…你怎么知道的？",
            "nextDialogs": [
              "413110608"
            ]
          },
          "413110608": {
            "id": "413110608",
            "speakerId": 1004,
            "speakerName": "江舟",
            "text": "去年我可不记得有带着奇怪吉祥物的旅行者来过。",
            "nextDialogs": [
              "413110609"
            ]
          },
          "413110609": {
            "id": "413110609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以你说的「明霄灯」是…",
            "nextDialogs": [
              "413110610"
            ]
          },
          "413110610": {
            "id": "413110610",
            "speakerId": 1004,
            "speakerName": "江舟",
            "text": "节日里，人们手中放飞的小灯叫做「霄灯」。而全璃月人共同建造的巨灯，就是「明霄灯」了。",
            "nextDialogs": [
              "413110611"
            ]
          },
          "413110611": {
            "id": "413110611",
            "speakerId": 1004,
            "speakerName": "江舟",
            "text": "「霄市」上的摊位，是璃月各路商行一年一度、难得不为赚钱，只为筹集「明霄灯」的建设资材而开设的。",
            "nextDialogs": [
              "413110612"
            ]
          },
          "413110612": {
            "id": "413110612",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那「霄市」里面，会有好吃的吗？",
            "nextDialogs": [
              "413110613"
            ]
          },
          "413110613": {
            "id": "413110613",
            "speakerId": 1004,
            "speakerName": "江舟",
            "text": "那当然不少，而且要我说，海灯节正是最适合品尝璃月美食的节日。",
            "nextDialogs": [
              "413110614"
            ]
          },
          "413110614": {
            "id": "413110614",
            "speakerId": 1004,
            "speakerName": "江舟",
            "text": "这可是璃月一年里最盛大的节日，要是能在海灯节上向大家展现出自家的手艺，必然能博得不少的口碑。",
            "nextDialogs": [
              "413110615"
            ]
          },
          "413110615": {
            "id": "413110615",
            "speakerId": 1004,
            "speakerName": "江舟",
            "text": "所以，虽然不为赚钱，但各个商家暗地里都铆足了劲，在海灯节上一拼手艺的高低呢。",
            "nextDialogs": [
              "413110616"
            ]
          },
          "413110616": {
            "id": "413110616",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "从各个方面来说，璃月人都很厉害啊…",
            "nextDialogs": [
              "413110617"
            ]
          },
          "413110617": {
            "id": "413110617",
            "speakerId": 1004,
            "speakerName": "江舟",
            "text": "如果你们还有什么问题的话，可以去找海灯节的负责人<color=#00E1FFFF>望雅</color>小姐。",
            "nextDialogs": [
              "413110618"
            ]
          },
          "413110618": {
            "id": "413110618",
            "speakerId": 1004,
            "speakerName": "江舟",
            "text": "她一般会在「霄市」附近待着，你们有什么问题都可以去问她。",
            "nextDialogs": [
              "413110619"
            ]
          },
          "413110619": {
            "id": "413110619",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "她会知道什么店卖的东西最好吃吗？",
            "nextDialogs": [
              "413110620"
            ]
          },
          "413110620": {
            "id": "413110620",
            "speakerId": 1004,
            "speakerName": "江舟",
            "text": "那当然，海灯节的一切事情，望雅小姐都再清楚不过。",
            "nextDialogs": [
              "413110621"
            ]
          },
          "413110621": {
            "id": "413110621",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#知道啦，{NICKNAME}，我们赶紧去「霄市」上找那位<color=#00E1FFFF>望雅</color>小姐吧。",
            "nextDialogs": [
              "413110622"
            ]
          },
          "413110622": {
            "id": "413110622",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "然后…去东西最好吃的那个小摊上吃个饱！"
          }
        }
      }
    },
    {
      "subId": "4131107",
      "subQuestName": "与望雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413110701"
        ],
        "dialogs": {
          "413110701": {
            "id": "413110701",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "你好，有什么事吗？",
            "nextDialogs": [
              "413110702"
            ]
          },
          "413110702": {
            "id": "413110702",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "看你的样子…应该不是璃月人吧，是旅行者吗？欢迎你来「霄市」玩。",
            "nextDialogs": [
              "413110703"
            ]
          },
          "413110703": {
            "id": "413110703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问，你是海灯节的负责人吗？",
            "nextDialogs": [
              "413110704"
            ]
          },
          "413110704": {
            "id": "413110704",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "负责人…倒也谈不上，海灯节是全璃月的节日，不是哪个人能够负责的。",
            "nextDialogs": [
              "413110705"
            ]
          },
          "413110705": {
            "id": "413110705",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "我也只是负责管理一些琐事，努力让海灯节更热闹罢了。",
            "nextDialogs": [
              "413110706"
            ]
          },
          "413110706": {
            "id": "413110706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我有些事情想问…",
            "nextDialogs": [
              "413110707"
            ]
          },
          "413110707": {
            "id": "413110707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们想问问，「霄市」里哪个摊子上卖的东西最好吃！",
            "nextDialogs": [
              "413110708"
            ]
          },
          "413110708": {
            "id": "413110708",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "最好吃？各有各的特色吧，我也不能下结论。但是，我能告诉你们目前人气最高的小吃摊位，是<color=#00E1FFFF>宜年</color>的。",
            "nextDialogs": [
              "413110709"
            ]
          },
          "413110709": {
            "id": "413110709",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "如果那边的人再多点，我就要去申请千岩军维持秩序了。",
            "nextDialogs": [
              "413110710"
            ]
          },
          "413110710": {
            "id": "413110710",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "你们要去的话就赶紧去吧，趁现在人还没把路占满。",
            "nextDialogs": [
              "413110711"
            ]
          },
          "413110711": {
            "id": "413110711",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "对了，你们要去找宜年的话，就顺便帮我把这份文件带给他吧。",
            "nextDialogs": [
              "413110712"
            ]
          },
          "413110712": {
            "id": "413110712",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "这是我们总务司根据去年海灯节数据总览，给各位商家的营业建议。你们既然要去，就顺便帮我个忙吧。",
            "nextDialogs": [
              "413110713"
            ]
          },
          "413110713": {
            "id": "413110713",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "回来之后，我会送你们个小礼物，作为报酬的。"
          }
        }
      }
    },
    {
      "subId": "4131108",
      "subQuestName": "与宜年对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413110801"
        ],
        "dialogs": {
          "413110801": {
            "id": "413110801",
            "speakerId": 1006,
            "speakerName": "宜年",
            "text": "这人手真是不够了，早知道就再带点人出来了…",
            "nextDialogs": [
              "413110802"
            ]
          },
          "413110802": {
            "id": "413110802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里有什么好吃的呀！",
            "nextDialogs": [
              "413110803"
            ]
          },
          "413110803": {
            "id": "413110803",
            "speakerId": 1006,
            "speakerName": "宜年",
            "text": "是客人吗？这边看，菜单上写的能做，你们想吃什么直接说，我也能做！",
            "nextDialogs": [
              "413110804"
            ]
          },
          "413110804": {
            "id": "413110804",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！那我要吃…",
            "nextDialogs": [
              "413110805"
            ]
          },
          "413110805": {
            "id": "413110805",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，虽然说是小吃摊…但看起来什么都有啊…",
            "nextDialogs": [
              "413110806"
            ]
          },
          "413110806": {
            "id": "413110806",
            "speakerId": 1006,
            "speakerName": "宜年",
            "text": "那当然，什么菜我不会做，赶紧点菜吧。",
            "nextDialogs": [
              "413110807"
            ]
          },
          "413110807": {
            "id": "413110807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是望雅给你的文件。",
            "nextDialogs": [
              "413110808"
            ]
          },
          "413110808": {
            "id": "413110808",
            "speakerId": 1006,
            "speakerName": "宜年",
            "text": "又来了，年年都来，什么营业建议——除了菜品的味道之外，我不需要其它的什么手段！",
            "nextDialogs": [
              "413110809"
            ]
          },
          "413110809": {
            "id": "413110809",
            "speakerId": 1006,
            "speakerName": "宜年",
            "text": "算了，把这文件给我吧，我等会就把它给喂炉子去。",
            "nextDialogs": [
              "413110810"
            ]
          },
          "413110810": {
            "id": "413110810",
            "speakerId": 1006,
            "speakerName": "宜年",
            "text": "快点菜吧，你们不是来吃东西的吗？",
            "nextDialogs": [
              "413110811"
            ]
          },
          "413110811": {
            "id": "413110811",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这么多好吃的，这个看着不错，这个我也想吃…",
            "nextDialogs": [
              "413110812"
            ]
          },
          "413110812": {
            "id": "413110812",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，「烤吃虎鱼」？我记得，那好像是那位「铜雀」很喜欢吃的菜来着。",
            "nextDialogs": [
              "413110813"
            ]
          },
          "413110813": {
            "id": "413110813",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…既然海灯节是纪念英雄的节日，那我们就点这道菜吃，也用这种方式来纪念一下他吧。",
            "nextDialogs": [
              "413110816"
            ]
          },
          "413110816": {
            "id": "413110816",
            "speakerId": 1006,
            "speakerName": "宜年",
            "text": "你这小家伙还挺会吃的，一点就点到了我们最有特色的菜。",
            "nextDialogs": [
              "413110817"
            ]
          },
          "413110817": {
            "id": "413110817",
            "speakerId": 1006,
            "speakerName": "宜年",
            "text": "那你们在这等一会，菜一会就好。",
            "nextDialogs": [
              "413110819"
            ]
          },
          "413110819": {
            "id": "413110819",
            "speakerId": 1006,
            "speakerName": "宜年",
            "text": "好了，这是你们点的「烤吃虎鱼」，吃吃看味道怎么样？",
            "nextDialogs": [
              "413110820"
            ]
          },
          "413110820": {
            "id": "413110820",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好吃！",
            "nextDialogs": [
              "413110821"
            ]
          },
          "413110821": {
            "id": "413110821",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙对于吃真是很在行啊…",
            "nextDialogs": [
              "413110822"
            ]
          },
          "413110822": {
            "id": "413110822",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那当然，我可是你最好的向导。",
            "nextDialogs": [
              "413110823"
            ]
          },
          "413110823": {
            "id": "413110823",
            "speakerId": 1006,
            "speakerName": "宜年",
            "text": "哈哈哈，那你们慢慢吃吧，我要接着去招呼客人了。",
            "nextDialogs": [
              "413110824"
            ]
          },
          "413110824": {
            "id": "413110824",
            "speakerId": 1006,
            "speakerName": "宜年",
            "text": "如果还想再吃的话，过来点就是了，我随时欢迎。"
          }
        }
      }
    },
    {
      "subId": "4131111",
      "subQuestName": "向望雅回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413111101"
        ],
        "dialogs": {
          "413111101": {
            "id": "413111101",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "你们回来了，怎么样，宜年做的菜味道还不错吧？",
            "nextDialogs": [
              "413111102"
            ]
          },
          "413111102": {
            "id": "413111102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "很好吃！",
            "nextDialogs": [
              "413111103"
            ]
          },
          "413111103": {
            "id": "413111103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他说不会参考那份文件…",
            "nextDialogs": [
              "413111104"
            ]
          },
          "413111104": {
            "id": "413111104",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "是吗？他去年也是这么说的…要是他愿意根据我们的建议打广告的话，营收应该会更多才对。",
            "nextDialogs": [
              "413111105"
            ]
          },
          "413111105": {
            "id": "413111105",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "算了，不用在意这些。来，之前说好的礼物，这个「霄灯」给你们。",
            "nextDialogs": [
              "413111106"
            ]
          },
          "413111106": {
            "id": "413111106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，好漂亮的灯，这是怎么做的呀？",
            "nextDialogs": [
              "413111107"
            ]
          },
          "413111107": {
            "id": "413111107",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "唔…编制的方法我一时半会也讲不明白。",
            "nextDialogs": [
              "413111108"
            ]
          },
          "413111108": {
            "id": "413111108",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "如果你们对「霄灯」感兴趣的话，可以去旁边问问<color=#00E1FFFF>景明</color>，他是负责「霄灯」和「明霄灯」的人。",
            "nextDialogs": [
              "413111109"
            ]
          },
          "413111109": {
            "id": "413111109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那个好大好大的灯，也是他在负责吗？",
            "nextDialogs": [
              "413111110"
            ]
          },
          "413111110": {
            "id": "413111110",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "对，他应该就在旁边不远，应该很容易就能找到。",
            "nextDialogs": [
              "413111111"
            ]
          },
          "413111111": {
            "id": "413111111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "要是能亲手编个「霄灯」带给魈的话，他也许会变得开心一点…",
            "nextDialogs": [
              "413111112"
            ]
          },
          "413111112": {
            "id": "413111112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们快去找那位<color=#00E1FFFF>景明</color>问问看吧。"
          }
        }
      }
    },
    {
      "subId": "4131112",
      "subQuestName": "与景明对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413111201"
        ],
        "dialogs": {
          "413111201": {
            "id": "413111201",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "按这个速度…应该差不多够了…",
            "nextDialogs": [
              "413111202"
            ]
          },
          "413111202": {
            "id": "413111202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问，「霄灯」的编制方法…",
            "nextDialogs": [
              "413111203"
            ]
          },
          "413111203": {
            "id": "413111203",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "「霄灯」的编制方法？哦…看你们的样子，应该不是本地人吧，是想要亲手编个「霄灯」吗？",
            "nextDialogs": [
              "413111204"
            ]
          },
          "413111204": {
            "id": "413111204",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "倒也没问题，「霄灯」的式样有很多种，唔…我就先挑最简单的那种教你们吧。",
            "nextDialogs": [
              "413111205"
            ]
          },
          "413111205": {
            "id": "413111205",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "我这里正好还有一些制作材料…等等啊，这些材料还得先处理一下，你们就用这些来试试手吧。",
            "nextDialogs": [
              "413111401"
            ]
          },
          "413111401": {
            "id": "413111401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "头…头好晕，怎么这么复杂…你，你记住了吗？",
            "nextDialogs": [
              "413111402"
            ]
          },
          "413111402": {
            "id": "413111402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "勉强记住了…",
            "nextDialogs": [
              "413111403"
            ]
          },
          "413111403": {
            "id": "413111403",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "哈哈哈，最开始的时候是挺复杂，但只要做得多了就会很顺手了。",
            "nextDialogs": [
              "413111404"
            ]
          },
          "413111404": {
            "id": "413111404",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "像你们这样想要学习编「霄灯」的人，现在也是不多了…",
            "nextDialogs": [
              "413111405"
            ]
          },
          "413111405": {
            "id": "413111405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那个超大的「明霄灯」，也是这么编制出来的吗？",
            "nextDialogs": [
              "413111406"
            ]
          },
          "413111406": {
            "id": "413111406",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "那个？那个…也可以说是「编制」来的吧，但并不是某一个人编制，而是璃月的所有人一起编制的。",
            "nextDialogs": [
              "413111407"
            ]
          },
          "413111407": {
            "id": "413111407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "全璃月的人一起编制的？",
            "nextDialogs": [
              "413111408"
            ]
          },
          "413111408": {
            "id": "413111408",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "你应该也听说了，「霄市」里的各个商摊，就是为了筹建这个「明霄灯」而开设的。",
            "nextDialogs": [
              "413111409"
            ]
          },
          "413111409": {
            "id": "413111409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇…「明霄灯」原来都是这么造的啊…",
            "nextDialogs": [
              "413111410"
            ]
          },
          "413111410": {
            "id": "413111410",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "这也是海灯节的传统了，虽然资费的大头还是总务司的拨款，但材料和其他的东西，都还是来自于居民们的捐赠。",
            "nextDialogs": [
              "413111411"
            ]
          },
          "413111411": {
            "id": "413111411",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦…之前的那个小女孩，她好像是把自己的布娃娃也捐了呢。",
            "nextDialogs": [
              "413111412"
            ]
          },
          "413111412": {
            "id": "413111412",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "布娃娃也能用来建设「明霄灯」吗？",
            "nextDialogs": [
              "413111413"
            ]
          },
          "413111413": {
            "id": "413111413",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "这个…毕竟海灯节是个大节日，要是居民们想要参与一下「明霄灯」建设的话…",
            "nextDialogs": [
              "413111414"
            ]
          },
          "413111414": {
            "id": "413111414",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "不管捐的是什么，总归是一份心意，我们一般都会接受。",
            "nextDialogs": [
              "413111415"
            ]
          },
          "413111415": {
            "id": "413111415",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "毕竟这么隆重的节日，参与进来也有点「祈福」的意思吧。",
            "nextDialogs": [
              "413111416"
            ]
          },
          "413111416": {
            "id": "413111416",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "好了好了，你们是来海灯节玩的吧？我就不耽误你们时间了。",
            "nextDialogs": [
              "413111417"
            ]
          },
          "413111417": {
            "id": "413111417",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "如果以后还想要编「霄灯」的话，尽管来找我。",
            "nextDialogs": [
              "413111418"
            ]
          },
          "413111418": {
            "id": "413111418",
            "speakerId": 1007,
            "speakerName": "景明",
            "text": "祝你们在海灯节玩得开心。"
          }
        }
      }
    },
    {
      "subId": "4131115",
      "subQuestName": "向望雅回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413111501"
        ],
        "dialogs": {
          "413111501": {
            "id": "413111501",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "怎么样，找到景明了吗？",
            "nextDialogs": [
              "413111502"
            ]
          },
          "413111502": {
            "id": "413111502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "找到啦，他还教我们做了「霄灯」呢。",
            "nextDialogs": [
              "413111503"
            ]
          },
          "413111503": {
            "id": "413111503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然复杂得完全记不下来…",
            "nextDialogs": [
              "413111504"
            ]
          },
          "413111504": {
            "id": "413111504",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "没关系，如果你们记不住的话，可以再去那边问问景明编制「霄灯」的方法。",
            "nextDialogs": [
              "413111505"
            ]
          },
          "413111505": {
            "id": "413111505",
            "speakerId": 1005,
            "speakerName": "望雅",
            "text": "好了，我要继续工作去了，祝你们在海灯节里玩得开心。"
          }
        }
      }
    },
    {
      "subId": "4000102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400010202"
        ],
        "dialogs": {
          "400010202": {
            "id": "400010202",
            "speakerId": 1008,
            "speakerName": "博来",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYA|INFO_FEMALE_PRONOUN_GIRLA]}，冒昧问一下。你身边飘着的这个小东西，多少钱可以卖？",
            "nextDialogs": [
              "400010204",
              "400010206"
            ]
          },
          "400010204": {
            "id": "400010204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "多少钱也不卖！",
            "nextDialogs": [
              "400010209"
            ]
          },
          "400010209": {
            "id": "400010209",
            "speakerId": 1008,
            "speakerName": "博来",
            "text": "哈哈哈哈，最近手头周转不开，的确出不起价。",
            "nextDialogs": [
              "400010210"
            ]
          },
          "400010210": {
            "id": "400010210",
            "speakerId": 1008,
            "speakerName": "博来",
            "text": "毕竟我只是个普通商人，也不倒腾奇珍异宝。",
            "nextDialogs": [
              "400010211"
            ]
          },
          "400010211": {
            "id": "400010211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…听语气感觉很可疑啊。",
            "nextDialogs": [
              "400010212"
            ]
          },
          "400010212": {
            "id": "400010212",
            "speakerId": 1008,
            "speakerName": "博来",
            "text": "别这么说嘛。小家伙，你要吃糖吗？",
            "nextDialogs": [
              "400010213"
            ]
          },
          "400010213": {
            "id": "400010213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我认为这个人可以信任！",
            "nextDialogs": [
              "400010214"
            ]
          },
          "400010214": {
            "id": "400010214",
            "speakerId": 1008,
            "speakerName": "博来",
            "text": "对了，你们来璃月，也应该是冲着「海灯节」来的吧？",
            "nextDialogs": [
              "400010215"
            ]
          },
          "400010215": {
            "id": "400010215",
            "speakerId": 1008,
            "speakerName": "博来",
            "text": "今年的「明霄灯」壮景可期啊。用来让巨灯浮空的那块「浮生石」，是二十年来最大的一块。",
            "nextDialogs": [
              "400010216"
            ]
          },
          "400010216": {
            "id": "400010216",
            "speakerId": 1008,
            "speakerName": "博来",
            "text": "大到让人不禁要想，神话中云间的浮城要是真的存在的话…",
            "nextDialogs": [
              "400010217"
            ]
          },
          "400010217": {
            "id": "400010217",
            "speakerId": 1008,
            "speakerName": "博来",
            "text": "也只是下面装了一块差不多大的浮生石吧。",
            "nextDialogs": [
              "400010218"
            ]
          },
          "400010218": {
            "id": "400010218",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来好厉害啊！",
            "nextDialogs": [
              "400010219"
            ]
          },
          "400010219": {
            "id": "400010219",
            "speakerId": 1008,
            "speakerName": "博来",
            "text": "哈哈哈哈，有缘再见吧。欢迎你们来璃月——这话代表不了<color=#00E1FFFF>璃月港</color>，但我的小店永远欢迎你们。"
          },
          "400010206": {
            "id": "400010206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这话听着怪怪的！",
            "nextDialogs": [
              "400010207"
            ]
          },
          "400010207": {
            "id": "400010207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说实话还有点在意…究竟这个价位是多少…",
            "nextDialogs": [
              "400010208"
            ]
          },
          "400010208": {
            "id": "400010208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "算了，我就当你是在说「多少钱也不卖」好了。"
          },
          "400010220": {
            "id": "400010220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真不愧是派蒙啊…"
          }
        }
      }
    },
    {

  },
  "subQuests": [
    {
      "subId": "4131101",
      "subQuestName": "与菲尔戈黛特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413110101"
        ],
        "dialogs": {
          "413110101": {
            "id": "413110101",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "海灯节又快到了啊，今年要不要把客栈打扮一下呢…",
            "nextDialogs": [
              "413110102"
            ]
          },
          "413110102": {
            "id": "413110102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "海灯节？",
            "nextDialogs": [
              "413110103"
            ]
          },
          "413110103": {
            "id": "413110103",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "你不知道吗？ 每年的第一个月圆之夜，就是璃月的「海灯节」哦。",
            "nextDialogs": [
              "413110104"
            ]
          },
          "413110104": {
            "id": "413110104",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "这是一个纪念英雄的节日，在夜里，人们会放出「霄灯」和「明霄灯」，升上夜空。",
            "nextDialogs": [
              "413110105"
            ]
          },
          "413110105": {
            "id": "413110105",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "那些灯的寓意，是「愿薪火相传，美德不灭」。我们相信夜海的明灯会引导过往的英魂归乡。",
            "nextDialogs": [
              "413110106"
            ]
          },
          "413110106": {
            "id": "413110106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇…听起来像是个很盛大的节日呢。",
            "nextDialogs": [
              "413110107"
            ]
          },
          "413110107": {
            "id": "413110107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说不定…还会有很多好吃的！",
            "nextDialogs": [
              "413110108"
            ]
          },
          "413110108": {
            "id": "413110108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你能听懂我的意思吧！",
            "nextDialogs": [
              "413110109"
            ]
          },
          "413110109": {
            "id": "413110109",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "你们是想要去参加海灯节吗？那正好。「海灯节」当夜之前的一段时间，都可以算是节日。",
            "nextDialogs": [
              "413110110"
            ]
          },
          "413110110": {
            "id": "413110110",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "在这段时间里，可以祈祷平安、祛除厄运。用璃月人的话说就是「辞旧迎新」。",
            "nextDialogs": [
              "413110111"
            ]
          },
          "413110111": {
            "id": "413110111",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "如果你们想要参加的话，现在去也不迟。",
            "nextDialogs": [
              "413110112"
            ]
          },
          "413110112": {
            "id": "413110112",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "还有…",
            "nextDialogs": [
              "413110113"
            ]
          },
          "413110113": {
            "id": "413110113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有？",
            "nextDialogs": [
              "413110114"
            ]
          },
          "413110114": {
            "id": "413110114",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "如果可以的话…嗯…你们要试试邀请魈一起去吗？",
            "nextDialogs": [
              "413110115"
            ]
          },
          "413110115": {
            "id": "413110115",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "他和我们的关系不近，我也不太好去问他。但我看你们好像已经有点混熟了，不如…",
            "nextDialogs": [
              "413110116"
            ]
          },
          "413110116": {
            "id": "413110116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是，考虑到魈现在的心情…",
            "nextDialogs": [
              "413110117"
            ]
          },
          "413110117": {
            "id": "413110117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，这几天里去打扰他，确实有点不太好呢…",
            "nextDialogs": [
              "413110118"
            ]
          },
          "413110118": {
            "id": "413110118",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "是吗…没关系！这也只是我随口一说而已。你们还是快点去<color=#00E1FFFF>璃月港</color>吧。",
            "nextDialogs": [
              "413110119"
            ]
          },
          "413110119": {
            "id": "413110119",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "要是去太晚，城里就全都是人了，想要逛逛玩玩也就很费劲了。",
            "nextDialogs": [
              "413110120"
            ]
          },
          "413110120": {
            "id": "413110120",
            "speakerId": 1000,
            "speakerName": "菲尔戈黛特",
            "text": "快去吧，祝你们海灯节玩得开心！"
          }
        }
      }
    },

    {
      "subId": "1000705",
      "subQuestName": "与温迪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100070501"
        ],
        "dialogs": {
          "100070501": {
            "id": "100070501",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "看来，我们演奏的乐曲太过动听，有不少观众想要临时入场了。",
            "nextDialogs": [
              "100070502"
            ]
          },
          "100070502": {
            "id": "100070502",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这可不太符合规矩，我们一起将它们请出去吧。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "1000701",
      "subQuestName": "与温迪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100070101"
        ],
        "dialogs": {
          "100070101": {
            "id": "100070101",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "…那么我就当做您默认了。",
            "nextDialogs": [
              "100070102"
            ]
          },
          "100070102": {
            "id": "100070102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "温迪？",
            "nextDialogs": [
              "100070103"
            ]
          },
          "100070103": {
            "id": "100070103",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#哎呀，{NICKNAME}，你终于来了，是有人捎给我口信么？",
            "nextDialogs": [
              "100070106"
            ]
          },
          "100070106": {
            "id": "100070106",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "「并没有从那本辞典里看见任何有关于你的预言。」",
            "nextDialogs": [
              "100070107"
            ]
          },
          "100070107": {
            "id": "100070107",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "对么？"
          }
        }
      }
    },
    {
      "subId": "1000704",
      "subQuestName": "与温迪一同循风前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100070401"
        ],
        "dialogs": {
          "100070401": {
            "id": "100070401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这座岛…",
            "nextDialogs": [
              "100070402"
            ]
          },
          "100070402": {
            "id": "100070402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么特别的吗？",
            "nextDialogs": [
              "100070403"
            ]
          },
          "100070403": {
            "id": "100070403",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这座岛屿本身并无特殊之处，它和大部分岛屿一样，都只是普通砂石的聚合。",
            "nextDialogs": [
              "100070404"
            ]
          },
          "100070404": {
            "id": "100070404",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "直到，风带来了故事的种子，时间使它在这座岛上生根发芽。",
            "nextDialogs": [
              "100070405"
            ]
          },
          "100070405": {
            "id": "100070405",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "尔后，风带来了新的故事，时间使它在这座岛外成为神话。",
            "nextDialogs": [
              "100070406"
            ]
          },
          "100070406": {
            "id": "100070406",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#{NICKNAME}，欢迎你「真正」登上这座被「时间」所青睐的小岛。",
            "nextDialogs": [
              "100070407"
            ]
          },
          "100070407": {
            "id": "100070407",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "在久远的过去，时与风曾在此交汇。",
            "nextDialogs": [
              "100070408"
            ]
          },
          "100070408": {
            "id": "100070408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下等一下，卖唱的…你突然好严肃，说的话也好难懂喔…",
            "nextDialogs": [
              "100070409"
            ]
          },
          "100070409": {
            "id": "100070409",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哎呀，别急嘛小派蒙，一篇好故事的开头总是要起点高调，留点悬念。"
          }
        }
      }
    },
    {
      "subId": "1000702",
      "subQuestName": "与温迪一同循风前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100070201"
        ],
        "dialogs": {
          "100070201": {
            "id": "100070201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这座岛怎么看着有点眼熟…"
          }
        }
      }
    },
    {
      "subId": "1000703",
      "subQuestName": "与温迪合奏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100071201"
        ],
        "dialogs": {
          "100071201": {
            "id": "100071201",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "不过，猛烈的狂风只适合扫清屋子，却不适合吹拂万物生长。",
            "nextDialogs": [
              "100071202"
            ]
          },
          "100071202": {
            "id": "100071202",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "在为蒙德城处理了几场危机后，我就把风变得温和了一些，让它既足以为蒙德人鼓起勇气，又不至于让他们在风中踉跄。",
            "nextDialogs": [
              "100071205"
            ]
          },
          "100071205": {
            "id": "100071205",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "……",
            "nextDialogs": [
              "100071206"
            ]
          },
          "100071206": {
            "id": "100071206",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#阴影正在远方聚集。你应该也已经感受到了，{NICKNAME}。",
            "nextDialogs": [
              "100071207"
            ]
          },
          "100071207": {
            "id": "100071207",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "火之神与「死之执政」若娜瓦正面对峙…还有愚人众执行官「队长」的事，我都已经听见了风声。",
            "nextDialogs": [
              "100071208"
            ]
          },
          "100071208": {
            "id": "100071208",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "而且，深渊的活动范围已经逼近了蒙德。",
            "nextDialogs": [
              "100071209"
            ]
          },
          "100071209": {
            "id": "100071209",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "即将到来的这场危机，可能并非人力可以独挡…我也要提前做些准备了。",
            "nextDialogs": [
              "100071210"
            ]
          },
          "100071210": {
            "id": "100071210",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "在必要的时候，我作为蒙德城的风之神「巴巴托斯」，会为蒙德扬起足以吹散任何阴霾的风。",
            "nextDialogs": [
              "100071211"
            ]
          },
          "100071211": {
            "id": "100071211",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "不过，如果我贸然在蒙德城里扬起狂风，只怕会吹翻大家的衣服、帽子，还有放在阳台上的花。",
            "nextDialogs": [
              "100071212"
            ]
          },
          "100071212": {
            "id": "100071212",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "所以，我将这一次的「风起之地」选在了这座岛上。我曾经在这里，为「时间」献上过颂歌。",
            "nextDialogs": [
              "100071213"
            ]
          },
          "100071213": {
            "id": "100071213",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "也许是我弹的曲子太好听了吧，所以这座小岛似乎格外被「时间」所青睐。",
            "nextDialogs": [
              "100071214"
            ]
          },
          "100071214": {
            "id": "100071214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的？这座岛有这么特别吗…可是我们之前看它的时候，好像没发现什么特别之处啊…",
            "nextDialogs": [
              "100071215"
            ]
          },
          "100071215": {
            "id": "100071215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有时候被涨起来的潮水淹没，有时候落着很多鸟…怎么看都很普通啊。",
            "nextDialogs": [
              "100071216"
            ]
          },
          "100071216": {
            "id": "100071216",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "「时间」对事物的影响并不流于表面。嗯…就像是一枚熟透了的日落果。",
            "nextDialogs": [
              "100071217"
            ]
          },
          "100071217": {
            "id": "100071217",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "它的外皮毫无破损时，如果不是专业人士，几乎没办法发觉它内部的果肉已经熟透了。",
            "nextDialogs": [
              "100071218"
            ]
          },
          "100071218": {
            "id": "100071218",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "不过，如果你在它的表皮上扎一个孔，这枚本就熟透了的日落果就会顺着孔洞开始飞速朽烂…",
            "nextDialogs": [
              "100071219"
            ]
          },
          "100071219": {
            "id": "100071219",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "在「时间」的手下，这座岛屿的「外皮」没有任何孔洞，任何人都无法察觉到「时间」对于它本质的影响。",
            "nextDialogs": [
              "100071220"
            ]
          },
          "100071220": {
            "id": "100071220",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "但从本质上来说，任何不为「时间」所喜的痕迹，都会被磨洗殆尽。",
            "nextDialogs": [
              "100071221"
            ]
          },
          "100071221": {
            "id": "100071221",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "所以，我正好借助一下存留于此地的力量，以「时间」为「风」划定界限。",
            "nextDialogs": [
              "100071222"
            ]
          },
          "100071222": {
            "id": "100071222",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这样的话，即使我在这座岛上扬起再大的风声，外界也不会察觉到半点。",
            "nextDialogs": [
              "100071223"
            ]
          },
          "100071223": {
            "id": "100071223",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#当然啦，拜托人帮忙当然要准备好谢礼。{NICKNAME}，我们一起合奏一曲，为「时间」献上一首颂歌吧。",
            "nextDialogs": [
              "100071224"
            ]
          },
          "100071224": {
            "id": "100071224",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#{NICKNAME}，准备好合奏了就告诉我，没有乐器的话，我也可以借你一把。"
          }
        }
      }
    },
    {
      "subId": "1000710",
      "subQuestName": "与温迪合奏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100071001"
        ],
        "dialogs": {
          "100071001": {
            "id": "100071001",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "在之前，我曾为蒙德鼓起了最初的自由之风。在那股风的协力下，所有应得自由之人，都重获自由。"
          }
        }
      }
    },
    {

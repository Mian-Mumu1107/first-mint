  "subQuests": [
    {
      "subId": "2200501",
      "subQuestName": "与宝儿交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220050101"
        ],
        "dialogs": {
          "220050101": {
            "id": "220050101",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "到底在哪里…",
            "nextDialogs": [
              "220050102"
            ]
          },
          "220050102": {
            "id": "220050102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么？",
            "nextDialogs": [
              "220050103"
            ]
          },
          "220050103": {
            "id": "220050103",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "呜哇！你是从哪冒出来的？怎么无声无息的…",
            "nextDialogs": [
              "220050104"
            ]
          },
          "220050104": {
            "id": "220050104",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "我？我…是一个学者，正在研究归离原的古代建筑和遗物。你…就叫我宝儿吧。",
            "nextDialogs": [
              "220050105"
            ]
          },
          "220050105": {
            "id": "220050105",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "不过，我研究太入神，把一个随身的包裹给弄丢了。",
            "nextDialogs": [
              "220050106"
            ]
          },
          "220050106": {
            "id": "220050106",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "那里面是我好不容易找到的宝…文物，你愿意帮我找找吗？",
            "nextDialogs": [
              "220050110",
              "220050111",
              "220050114"
            ]
          },
          "220050110": {
            "id": "220050110",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "太好了，应该就掉在附近了…或者再远点，总之，请你仔细找找吧。"
          },
          "220050111": {
            "id": "220050111",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "就是…平常大家用的包裹啦，一个四四方方的盒子…",
            "nextDialogs": [
              "220050112"
            ]
          },
          "220050112": {
            "id": "220050112",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "为什么用这个装文物？呃，因为…这样的盒子方便啊！",
            "nextDialogs": [
              "220050113"
            ]
          },
          "220050113": {
            "id": "220050113",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "而且，我也在盒子里面垫了好几层衣服，绝对不会损坏文物的，请你快去帮我找找吧。"
          },
          "220050114": {
            "id": "220050114",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "是…总之是很贵重的文物，哎呀！说了你也不明白啦。",
            "nextDialogs": [
              "220050115"
            ]
          },
          "220050115": {
            "id": "220050115",
            "speakerId": 2421,
            "speakerName": "宝儿",
            "text": "只有我这种专业人士，才能判断出它的价值，拜托你了，快帮我找找吧。"
          }
        }
      }
    },

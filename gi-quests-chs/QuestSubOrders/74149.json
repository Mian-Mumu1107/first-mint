    {
      "subId": "7414907",
      "subQuestName": "(test)回滚隔离$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741490701"
        ],
        "dialogs": {
          "741490701": {
            "id": "741490701",
            "speakerId": 1002,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "忘了我请你们做什么事了吗？小孩子的记性啊，哈哈。",
            "nextDialogs": [
              "741490702"
            ]
          },
          "741490702": {
            "id": "741490702",
            "speakerId": 1002,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "一件是帮我清理家门口和屋后的污迹，一件是喂我的猫，娜娜，一点鱼肉。"
          }
        }
      }
    },
    {
      "subId": "7414905",
      "subQuestName": "向勒鲁瓦先生回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741490501"
        ],
        "dialogs": {
          "741490501": {
            "id": "741490501",
            "speakerId": 1002,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "你们忙完了啊？",
            "nextDialogs": [
              "741490502"
            ]
          },
          "741490502": {
            "id": "741490502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是的，勒鲁瓦先生。那个…",
            "nextDialogs": [
              "741490503"
            ]
          },
          "741490503": {
            "id": "741490503",
            "speakerId": 1002,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "想要糖果还是想要报酬当零花钱使啊？",
            "nextDialogs": [
              "741490504"
            ]
          },
          "741490504": {
            "id": "741490504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "都、都想要，嘿嘿。",
            "nextDialogs": [
              "741490505"
            ]
          },
          "741490505": {
            "id": "741490505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙…",
            "nextDialogs": [
              "741490506"
            ]
          },
          "741490506": {
            "id": "741490506",
            "speakerId": 1002,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "贪心的孩子，哈哈哈。没关系，小孩子嘛，就是这样的。",
            "nextDialogs": [
              "741490507"
            ]
          },
          "741490507": {
            "id": "741490507",
            "speakerId": 1002,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "尤其是像派蒙这样可爱的小姑娘，就应该吃着马卡龙，穿着漂亮的小裙子，住在漂亮的屋子里。",
            "nextDialogs": [
              "741490508"
            ]
          },
          "741490508": {
            "id": "741490508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#我也这么觉得！{NICKNAME}，{NICKNAME}，我可不可以买…",
            "nextDialogs": [
              "741490509"
            ]
          },
          "741490509": {
            "id": "741490509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不可以。",
            "nextDialogs": [
              "741490510"
            ]
          },
          "741490510": {
            "id": "741490510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#呜呜，讨厌，{NICKNAME}好吝啬。",
            "nextDialogs": [
              "741490513"
            ]
          },
          "741490513": {
            "id": "741490513",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但是这跟马卡龙、小裙子还有漂亮的大房子有什么矛盾嘛。",
            "nextDialogs": [
              "741490514"
            ]
          },
          "741490514": {
            "id": "741490514",
            "speakerId": 1002,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "看你们两个，怎么斗起嘴来了？真是孩子气。不过能像这样斗嘴也很好，证明你们还是孩子。"
          }
        }
      }
    },

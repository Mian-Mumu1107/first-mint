    {
      "subId": "7054001",
      "subQuestName": "前往「猫茸茸城堡」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705400101"
        ],
        "dialogs": {
          "705400101": {
            "id": "705400101",
            "speakerId": 1000,
            "speakerName": "凶凶的大猫",
            "text": "嘶！",
            "nextDialogs": [
              "705400102"
            ]
          },
          "705400102": {
            "id": "705400102",
            "speakerId": 1001,
            "speakerName": "瓦乐瑞娜",
            "text": "呜…罗莎莉亚小姐，它好凶好凶，我好怕！",
            "nextDialogs": [
              "705400103"
            ]
          },
          "705400103": {
            "id": "705400103",
            "speakerId": 1002,
            "speakerName": "罗莎莉亚",
            "text": "你还是退后吧，不然会被它抓成大花脸。",
            "nextDialogs": [
              "705400104"
            ]
          },
          "705400104": {
            "id": "705400104",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "怎么回事？瓦乐瑞娜小姐被猫猫欺负了？",
            "nextDialogs": [
              "705400107"
            ]
          },
          "705400107": {
            "id": "705400107",
            "speakerId": 1001,
            "speakerName": "瓦乐瑞娜",
            "text": "荣誉骑士！白猫魔法师！「雪糕」出去散步的时候，那只大猫盯上了它，跟着它闯了进来…",
            "nextDialogs": [
              "705400108"
            ]
          },
          "705400108": {
            "id": "705400108",
            "speakerId": 1002,
            "speakerName": "罗莎莉亚",
            "text": "不用这么紧张，这里不会有人伤害你的。",
            "nextDialogs": [
              "705400109"
            ]
          },
          "705400109": {
            "id": "705400109",
            "speakerId": 1002,
            "speakerName": "罗莎莉亚",
            "text": "凶恶的东西，会让你去做坏事的家伙们，都被城墙挡在外边了。",
            "nextDialogs": [
              "705400110"
            ]
          },
          "705400110": {
            "id": "705400110",
            "speakerId": 1002,
            "speakerName": "罗莎莉亚",
            "text": "有些老好人会围着你转，虽然偶尔有点烦，但他们都是为了你好。放松下来，习惯悠闲的生活，也还不错。",
            "nextDialogs": [
              "705400111"
            ]
          },
          "705400111": {
            "id": "705400111",
            "speakerId": 1000,
            "speakerName": "凶凶的大猫",
            "text": "嘶——呜——",
            "nextDialogs": [
              "705400112"
            ]
          },
          "705400112": {
            "id": "705400112",
            "speakerId": 1001,
            "speakerName": "瓦乐瑞娜",
            "text": "那，那只大猫居然听懂了吗？",
            "nextDialogs": [
              "705400113"
            ]
          },
          "705400113": {
            "id": "705400113",
            "speakerId": 1002,
            "speakerName": "罗莎莉亚",
            "text": "好像有效果了，看来这只猫还挺聪明的。",
            "nextDialogs": [
              "705400114"
            ]
          },
          "705400114": {
            "id": "705400114",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "比起其他的猫猫，它好大好大，颜色又像泡泡桔的果汁。仔细看，它还戴着一个围巾，围巾上还有骑士团的标志呢…",
            "nextDialogs": [
              "705400115"
            ]
          },
          "705400115": {
            "id": "705400115",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "不如，我们就叫它「大桔骑士」好了！",
            "nextDialogs": [
              "705400116"
            ]
          },
          "705400116": {
            "id": "705400116",
            "speakerId": 1004,
            "speakerName": "「大桔骑士」",
            "text": "喵！",
            "nextDialogs": [
              "705400117"
            ]
          },
          "705400117": {
            "id": "705400117",
            "speakerId": 1002,
            "speakerName": "罗莎莉亚",
            "text": "你的方法还真灵验，它彻底放下了戒心。",
            "nextDialogs": [
              "705400118"
            ]
          },
          "705400118": {
            "id": "705400118",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "但我觉得，「大桔骑士」和罗莎莉亚聊了两句以后，就没那么凶了，所以这回是罗莎莉亚立大功！"
          }
        }
      }
    }
  ]
}
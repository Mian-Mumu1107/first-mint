        ],
        "dialogs": {
          "760790101": {
            "id": "760790101",
            "speakerId": 1000,
            "speakerName": "菲林斯",
            "text": "魔物已经消失，但这里还留着一道裂隙，而且透过这道裂隙…",
            "nextDialogs": [
              "760790102"
            ]
          },
          "760790102": {
            "id": "760790102",
            "speakerId": 1000,
            "speakerName": "菲林斯",
            "text": "是深渊的臭味，非常浓烈，有什么东西躲在裂隙的背后。",
            "nextDialogs": [
              "760790103"
            ]
          },
          "760790103": {
            "id": "760790103",
            "speakerId": 1000,
            "speakerName": "菲林斯",
            "text": "出来吧，你还在等什么？",
            "nextDialogs": [
              "760790104"
            ]
          },
          "760790104": {
            "id": "760790104",
            "speakerId": 1000,
            "speakerName": "菲林斯",
            "text": "难道你以为等到四下无人之后再从裂隙里爬出来，就不会被执灯人发现了吗？"
          }
        }
      }
    },

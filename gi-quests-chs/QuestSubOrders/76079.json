        }
      }
    },
    {
      "subId": "7607904",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760790201"
        ],
        "dialogs": {
          "760790201": {
            "id": "760790201",
            "speakerId": 1000,
            "speakerName": "菲林斯",
            "text": "随狂猎而来的魔物并非完全没有心智，它们也知道利用策略。",
            "nextDialogs": [
              "760790202"
            ]
          },
          "760790202": {
            "id": "760790202",
            "speakerId": 1000,
            "speakerName": "菲林斯",
            "text": "每一次作战都不可轻敌，否则后果不堪设想。"
          }
        }
      }
    },
    {
      "subId": "7607904",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760790401"
        ],
        "dialogs": {
          "760790401": {
            "id": "760790401",
            "speakerId": 1002,
            "speakerName": "叶洛亚",
            "text": "这里的魔物已经被击退了，但却依旧残存着狂猎的裂隙，难道说…",
            "nextDialogs": [
              "760790402"
            ]
          },
          "760790402": {
            "id": "760790402",
            "speakerId": 1002,
            "speakerName": "叶洛亚",
            "text": "别再躲躲藏藏的了，该死的魔物，我知道你就躲在这裂隙之后。",
            "nextDialogs": [
              "760790403"
            ]
          },
          "760790403": {
            "id": "760790403",
            "speakerId": 1002,
            "speakerName": "叶洛亚",
            "text": "靠这种把戏可是骗不过我的，出来受死吧！"
          }
        }
      }
    },
    {
      "subId": "7607905",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760790501"
        ],
        "dialogs": {
          "760790501": {
            "id": "760790501",
            "speakerId": 1002,
            "speakerName": "叶洛亚",
            "text": "总算是把魔物消灭干净了…老爷子说最近的狂猎变得越来越狡猾了，果然没错。",
            "nextDialogs": [
              "760790502"
            ]
          },
          "760790502": {
            "id": "760790502",
            "speakerId": 1002,
            "speakerName": "叶洛亚",
            "text": "看来以后得更加谨慎才行。"
          }
        }
      }
    }

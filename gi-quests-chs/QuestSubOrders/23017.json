  "subQuests": [
    {
      "subId": "2301701",
      "subQuestName": "与加尔恰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230170101"
        ],
        "dialogs": {
          "230170101": {
            "id": "230170101",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "旅，旅行者！您来得正好，我正和迦雅喝完咖啡，准备回去继续工作呢。我为你介绍…",
            "nextDialogs": [
              "230170102"
            ]
          },
          "230170102": {
            "id": "230170102",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "这就是你之前提到的人吗？很荣幸见到您，我是迦雅，一个…嗯…跳舞的人。",
            "nextDialogs": [
              "230170104"
            ]
          },
          "230170104": {
            "id": "230170104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好，加尔恰之前提到过你。",
            "nextDialogs": [
              "230170105"
            ]
          },
          "230170105": {
            "id": "230170105",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "嘻嘻，是这样么？那样就最好了，我还以为他只会记得他的机器，还有路通呢。",
            "nextDialogs": [
              "230170106"
            ]
          },
          "230170106": {
            "id": "230170106",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "您大可把我排除在外，小姐，我相信加尔恰先生也乐见此事。",
            "nextDialogs": [
              "230170107"
            ]
          },
          "230170107": {
            "id": "230170107",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "那可不行，要是没了你，加尔恰一定会把最后一分钱也花光的。",
            "nextDialogs": [
              "230170108"
            ]
          },
          "230170108": {
            "id": "230170108",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "这话我不敢苟同，小姐，我相信加尔恰先生无论如何都会留出两杯咖啡钱的。",
            "nextDialogs": [
              "230170109"
            ]
          },
          "230170109": {
            "id": "230170109",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "三杯！",
            "nextDialogs": [
              "230170110"
            ]
          },
          "230170110": {
            "id": "230170110",
            "speakerId": 1002,
            "speakerName": "路通",
            "text": "我总会为您这灵活的同情心而惊叹，加尔恰先生。",
            "nextDialogs": [
              "230170111"
            ]
          },
          "230170111": {
            "id": "230170111",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "说，说正事！旅行者，我还是在收购盗宝团所携带的那种徽印，如果你找到的话，可以直接卖给我。",
            "nextDialogs": [
              "230170112"
            ]
          },
          "230170112": {
            "id": "230170112",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "我最近也…赚了点钱，你大可不用担心报酬的事。"
          }
        }
      }
    },
    {
      "subId": "2301702",
      "subQuestName": "拿到盗宝团所携带的徽印，并带给加尔恰",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230170201"
        ],
        "dialogs": {
          "230170201": {
            "id": "230170201",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "您拿到那种徽印了吗？"
          }
        }
      }
    },
    {
      "subId": "2301703",
      "subQuestName": "与加尔恰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230170301"
        ],
        "dialogs": {
          "230170301": {
            "id": "230170301",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "嗯…这些徽印应该足够我试验了。",
            "nextDialogs": [
              "230170302"
            ]
          },
          "230170302": {
            "id": "230170302",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "这是报酬，请您收好…",
            "nextDialogs": [
              "230170303"
            ]
          },
          "230170303": {
            "id": "230170303",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "旅行者，您这种眼神是什么意思？盯得我发慌…",
            "nextDialogs": [
              "230170304"
            ]
          },
          "230170304": {
            "id": "230170304",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "咳！我要去工作了，我现在就要去工作了…"
          }
        }
      }
    },
    {
      "subId": "2301704",
      "subQuestName": "与加尔恰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230170401"
        ],
        "dialogs": {
          "230170401": {
            "id": "230170401",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "啊，这几枚徽印的品质，看上去真不错…",
            "nextDialogs": [
              "230170402"
            ]
          },
          "230170402": {
            "id": "230170402",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "这是报酬，请您收好…",
            "nextDialogs": [
              "230170403"
            ]
          },
          "230170403": {
            "id": "230170403",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "旅行者，您这种眼神是什么意思？盯得我发慌…",
            "nextDialogs": [
              "230170404"
            ]
          },
          "230170404": {
            "id": "230170404",
            "speakerId": 1000,
            "speakerName": "加尔恰",
            "text": "咳！我要去工作了，我现在就要去工作了…"
          }
        }
      }
    },
    {
      "subId": "2301750",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230175001"
        ],
        "dialogs": {
          "230175001": {
            "id": "230175001",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "您好？唔…您想问什么？",
            "nextDialogs": [
              "230175002"
            ]
          },
          "230175002": {
            "id": "230175002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是怎么和加尔恰认识的？",
            "nextDialogs": [
              "230175003"
            ]
          },
          "230175003": {
            "id": "230175003",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "问得这么直接？真像是一位冒险家做事的风格。",
            "nextDialogs": [
              "230175004"
            ]
          },
          "230175004": {
            "id": "230175004",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "我和加尔恰认识的契机…是因为他被我所在剧团的团长雇来梳理账目。",
            "nextDialogs": [
              "230175005"
            ]
          },
          "230175005": {
            "id": "230175005",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "哈哈哈，说实话，我从来没见过这样一个完全和剧团的氛围合不来的人。",
            "nextDialogs": [
              "230175006"
            ]
          },
          "230175006": {
            "id": "230175006",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "我们在奏乐，跳舞，喝酒，唱歌，而他只是和路通在一边沉默地计算。",
            "nextDialogs": [
              "230175007"
            ]
          },
          "230175007": {
            "id": "230175007",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "有一次，我发现他穿了一件很奇怪的衣服，那件衣服上好像画着什么图案。",
            "nextDialogs": [
              "230175008"
            ]
          },
          "230175008": {
            "id": "230175008",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "我很好奇，就问他那些图案是什么，他说这些是一架机器的设计图。",
            "nextDialogs": [
              "230175009"
            ]
          },
          "230175009": {
            "id": "230175009",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "之所以会画在衣服上，是因为他有一次在外和人讨论那架机器的时候，突然找不到笔和纸。",
            "nextDialogs": [
              "230175010"
            ]
          },
          "230175010": {
            "id": "230175010",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "所以他就直接用炭在自己的衣服上画示意图来讲解。",
            "nextDialogs": [
              "230175011"
            ]
          },
          "230175011": {
            "id": "230175011",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "然后，我们就一直在讨论他这件没洗干净的衣服和那架机器…当然啦，大部分时间是他在说话，我在听。",
            "nextDialogs": [
              "230175012"
            ]
          },
          "230175012": {
            "id": "230175012",
            "speakerId": 1001,
            "speakerName": "迦雅",
            "text": "嘻嘻，他是个很奇怪的人，但同时嘛…也是一个别有魅力的人。"
          }
        }
      }
    },
    {
      "subId": "2301751",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],

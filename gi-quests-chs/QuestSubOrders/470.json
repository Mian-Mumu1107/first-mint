          "4700201"
        ],
        "dialogs": {
          "4700201": {
            "id": "4700201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇啊，美味美味。",
            "nextDialogs": [
              "4700202"
            ]
          },
          "4700202": {
            "id": "4700202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「猎鹿人」的渔人吐司真是太棒了。",
            "nextDialogs": [
              "4700203"
            ]
          },
          "4700203": {
            "id": "4700203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，其实这在蒙德城也算是一道配方公开的经典传统菜。",
            "nextDialogs": [
              "4700204"
            ]
          },
          "4700204": {
            "id": "4700204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "有足够食材的话，以后你也可以试着自己做做看。",
            "nextDialogs": [
              "4700205"
            ]
          },
          "4700205": {
            "id": "4700205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}的手艺，能不能超过「猎鹿人」的出品水准呢？",
            "nextDialogs": [
              "4700206"
            ]
          },
          "4700206": {
            "id": "4700206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我会很乐意当你的专属品鉴师！",
            "nextDialogs": [
              "4700207"
            ]
          },
          "4700207": {
            "id": "4700207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不要让我失望哦。"
          }
        }
      }
    }

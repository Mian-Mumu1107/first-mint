            "id": "4700101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊！",
            "nextDialogs": [
              "4700102"
            ]
          },
          "4700102": {
            "id": "4700102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是<color=#00E1FFFF>渔人吐司</color>的香气！",
            "nextDialogs": [
              "4700103"
            ]
          },
          "4700103": {
            "id": "4700103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…嗯。是从「猎鹿人」餐馆的方向飘来的…",
            "nextDialogs": [
              "4700104"
            ]
          },
          "4700104": {
            "id": "4700104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "松软的吐司面包切成厚片…",
            "nextDialogs": [
              "4700105"
            ]
          },
          "4700105": {
            "id": "4700105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "铺满洋葱，烤到微焦之后放进嘴里…",
            "nextDialogs": [
              "4700106"
            ]
          },
          "4700106": {
            "id": "4700106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好，我决定了！",
            "nextDialogs": [
              "4700107"
            ]
          },
          "4700107": {
            "id": "4700107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "事不宜迟，就去<color=#00E1FFFF>「猎鹿人」</color>买一份<color=#00E1FFFF>渔人吐司</color>吧！",
            "nextDialogs": [
              "4700108"
            ]
          },
          "4700108": {
            "id": "4700108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "当然，是你请客。"
          }
        }
      }
    },

      }
    },
    {
      "subId": "7009202",
      "subQuestName": "前往魔法拟造空间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700920201"
        ],
        "dialogs": {
          "700920201": {
            "id": "700920201",
            "speakerId": 1006,
            "speakerName": "艾莉丝",
            "text": "欢迎来到提瓦特最具戏剧张力的地方——欧庇克莱歌剧院…的魔法拟造空间！",
            "nextDialogs": [
              "700920202"
            ]
          },
          "700920202": {
            "id": "700920202",
            "speakerId": 1006,
            "speakerName": "艾莉丝",
            "text": "这次的课题是「辩论」，为此我专门打造了这样的魔法空间。还不错吧？诚意多多仪式感满满。",
            "nextDialogs": [
              "700920203"
            ]
          },
          "700920203": {
            "id": "700920203",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "辩论？上次你已经彻底输给我了吧，还想来自取其辱吗？",
            "nextDialogs": [
              "700920204"
            ]
          },
          "700920204": {
            "id": "700920204",
            "speakerId": 1006,
            "speakerName": "艾莉丝",
            "text": "呵呵…你在12岁的辩题里展现了高达16岁的智慧，不可思议！",
            "nextDialogs": [
              "700920205"
            ]
          },
          "700920205": {
            "id": "700920205",
            "speakerId": 1006,
            "speakerName": "艾莉丝",
            "text": "考虑到你是反驳型人格…所以这次我准备了一个你无法反驳的绝妙论题！",
            "nextDialogs": [
              "700920208"
            ]
          },
          "700920208": {
            "id": "700920208",
            "speakerId": 1006,
            "speakerName": "艾莉丝",
            "text": "一场精彩绝伦的辩论少不了一位公平公正的评委，我们几个中你是最佳的人选，我想没有人会反对。",
            "nextDialogs": [
              "700920209"
            ]
          },
          "700920209": {
            "id": "700920209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那…派蒙在那个位置合适吗？",
            "nextDialogs": [
              "700920210"
            ]
          },
          "700920210": {
            "id": "700920210",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "其实我早就想说了，派蒙那家伙已经在高处的贵宾席位上摆了很久的姿势了…"
          }
        }
      }
    },
    {
      "subId": "7009203",
      "subQuestName": "返回蒙德城",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700920301"
        ],
        "dialogs": {
          "700920301": {
            "id": "700920301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "一下子全消失了呢…还真是艾莉丝的一贯作风。",
            "nextDialogs": [
              "700920302"
            ]
          },
          "700920302": {
            "id": "700920302",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "可恶——我一定会找到你的！"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "7009201",
      "subQuestName": "前往蒙德广场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700920101"
        ],
        "dialogs": {
          "700920101": {
            "id": "700920101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "给布伦妮的…与其说是课题，不如说是一封战书…",
            "nextDialogs": [
              "700920102"
            ]
          },
          "700920102": {
            "id": "700920102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「哼哼，小小魔女猎人，想好打败我的方法了吗？大声喊出你酷酷的挑战宣言，准备好败给大魔王吧！」",
            "nextDialogs": [
              "700920103"
            ]
          },
          "700920103": {
            "id": "700920103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个口吻…是艾莉丝吧。要不是写了「魔女猎人」，我还以为这是给可莉写的呢。",
            "nextDialogs": [
              "700920104"
            ]
          },
          "700920104": {
            "id": "700920104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "布伦妮一直对艾莉丝敌意很大，收到这种挑衅会不会被激怒呀…",
            "nextDialogs": [
              "700920105"
            ]
          },
          "700920105": {
            "id": "700920105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很明显，艾莉丝是故意的。",
            "nextDialogs": [
              "700920106"
            ]
          },
          "700920106": {
            "id": "700920106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们要不要换个委婉点的方式告诉布伦妮？",
            "nextDialogs": [
              "700920107"
            ]
          },
          "700920107": {
            "id": "700920107",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "要告诉我什么？我看看。",
            "nextDialogs": [
              "700920108"
            ]
          },
          "700920108": {
            "id": "700920108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "吓我一跳！你先不要激动，听我说…",
            "nextDialogs": [
              "700920109"
            ]
          },
          "700920109": {
            "id": "700920109",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "…无聊。",
            "nextDialogs": [
              "700920110"
            ]
          },
          "700920110": {
            "id": "700920110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？意外地淡定！",
            "nextDialogs": [
              "700920111"
            ]
          },
          "700920111": {
            "id": "700920111",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "哈。她这种幼稚的把戏我见多了，故作神秘，本质上就是场耍小孩的恶作剧。",
            "nextDialogs": [
              "700920112"
            ]
          },
          "700920112": {
            "id": "700920112",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "谁会在路上「大声喊宣言」啊，不明真相的路人只会觉得莫名其妙吧，我才不上当。",
            "nextDialogs": [
              "700920113"
            ]
          },
          "700920113": {
            "id": "700920113",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "简直等于在街上喊：我就是大笨蛋！",
            "nextDialogs": [
              "700920114"
            ]
          },
          "700920114": {
            "id": "700920114",
            "speakerId": 1002,
            "speakerName": "留声机",
            "text": "我就是大笨蛋！我就是大笨蛋！我就是大笨蛋！",
            "nextDialogs": [
              "700920115"
            ]
          },
          "700920115": {
            "id": "700920115",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "什、什么啊？！为什么我的声音会从那里冒出来啊？",
            "nextDialogs": [
              "700920116"
            ]
          },
          "700920116": {
            "id": "700920116",
            "speakerId": 1003,
            "speakerName": "不明真相的路人",
            "text": "谁？谁在说话？哈哈，谁是大笨蛋？",
            "nextDialogs": [
              "700920117"
            ]
          },
          "700920117": {
            "id": "700920117",
            "speakerId": 1004,
            "speakerName": "爱凑热闹的路人",
            "text": "竟然会有人说自己是大笨蛋，哈哈哈，是不是玩游戏输了呀。",
            "nextDialogs": [
              "700920118"
            ]
          },
          "700920118": {
            "id": "700920118",
            "speakerId": 1005,
            "speakerName": "理智的路人",
            "text": "绝对是小孩的恶作剧，看来有个笨小孩上当受骗了。",
            "nextDialogs": [
              "700920119"
            ]
          },
          "700920119": {
            "id": "700920119",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "可恶…快停下，不准叫！",
            "nextDialogs": [
              "700920120"
            ]
          },
          "700920120": {
            "id": "700920120",
            "speakerId": 1002,
            "speakerName": "留声机",
            "text": "我就是大笨蛋！我就是大笨蛋！我就是大笨蛋！",
            "nextDialogs": [
              "700920121"
            ]
          },
          "700920121": {
            "id": "700920121",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "……",
            "nextDialogs": [
              "700920122"
            ]
          },
          "700920122": {
            "id": "700920122",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "冷静一下布伦妮！先不要砸了…",
            "nextDialogs": [
              "700920125"
            ]
          },
          "700920125": {
            "id": "700920125",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "啊…艾——莉——丝！",
            "nextDialogs": [
              "700920126"
            ]
          },
          "700920126": {
            "id": "700920126",
            "speakerId": 1006,
            "speakerName": "艾莉丝",
            "text": "嗨嗨各位。哎呀~没想到是这样的宣言呢，非常有意思。恭喜你成功开启魔女的课题挑战！",
            "nextDialogs": [
              "700920127"
            ]
          },
          "700920127": {
            "id": "700920127",
            "speakerId": 1006,
            "speakerName": "艾莉丝",
            "text": "我为这次的挑战准备了一个很有仪式感的魔法空间，但魔法加载需要点时间…",
            "nextDialogs": [
              "700920128"
            ]
          },
          "700920128": {
            "id": "700920128",
            "speakerId": 1006,
            "speakerName": "艾莉丝",
            "text": "所以我早早就想好了，把挑战宣言做成加载音效，循环播放给你鼓舞士气，怎么样，喜欢吗！",
            "nextDialogs": [
              "700920129"
            ]
          },
          "700920129": {
            "id": "700920129",
            "speakerId": 1002,
            "speakerName": "留声机",
            "text": "我就是大笨蛋！我就是大笨蛋！我就是大笨蛋！",
            "nextDialogs": [
              "700920130"
            ]
          },
          "700920130": {
            "id": "700920130",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "不，这不是什么宣言，快撤回这个破音效啊！",
            "nextDialogs": [
              "700920131"
            ]
          },
          "700920131": {
            "id": "700920131",
            "speakerId": 1006,
            "speakerName": "艾莉丝",
            "text": "看来闹乌龙了。可是音效跟挑战魔法是一个整体，撤回就等于放弃挑战哦？",
            "nextDialogs": [
              "700920132"
            ]
          },
          "700920132": {
            "id": "700920132",
            "speakerId": 1006,
            "speakerName": "艾莉丝",
            "text": "真的吗？确定吗？那只好有缘再见了…",
            "nextDialogs": [
              "700920133"
            ]
          },
          "700920133": {
            "id": "700920133",
            "speakerId": 1001,
            "speakerName": "布伦妮",
            "text": "不…不准走！好不容易才逮住你。啊啊啊…你那破魔法到底还要加载多久啊！",
            "nextDialogs": [
              "700920134"
            ]
          },
          "700920134": {
            "id": "700920134",
            "speakerId": 1006,
            "speakerName": "艾莉丝",
            "text": "早就好了。"
          }
        }
      }
    },
    {
      "subId": "7009204",
      "subQuestName": "前往魔法拟造空间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

  "subQuests": [
    {
      "subId": "1910101",
      "subQuestName": "与宁禄对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191010101"
        ],
        "dialogs": {
          "191010101": {
            "id": "191010101",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "真不错…这「猫尾酒馆」的酒真不错…",
            "nextDialogs": [
              "191010102"
            ]
          },
          "191010102": {
            "id": "191010102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么酒馆？",
            "nextDialogs": [
              "191010103"
            ]
          },
          "191010103": {
            "id": "191010103",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "咦？呃…是旅行者啊，你…你不知道「猫尾酒馆」吗？",
            "nextDialogs": [
              "191010104"
            ]
          },
          "191010104": {
            "id": "191010104",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "看你样子，肯定没怎么听说过，也没怎么光顾过…欸，你可是亏大了…",
            "nextDialogs": [
              "191010105"
            ]
          },
          "191010105": {
            "id": "191010105",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "「猫尾酒馆」里面可是有不少奇妙特调，这些特调的味道你绝对从未尝试过。",
            "nextDialogs": [
              "191010106"
            ]
          },
          "191010106": {
            "id": "191010106",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "而且，「猫尾酒馆」就和它的名字一样，里面还有很多，很多的可爱小猫。",
            "nextDialogs": [
              "191010107"
            ]
          },
          "191010107": {
            "id": "191010107",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "在那么多可爱小猫的围绕下，喝着美味的特调酒…总是会让人不由自主地忘记时间…",
            "nextDialogs": [
              "191010110"
            ]
          },
          "191010110": {
            "id": "191010110",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "呃…可你看上去，好像还没到可以喝酒的年纪…",
            "nextDialogs": [
              "191010111"
            ]
          },
          "191010111": {
            "id": "191010111",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "不过没关系，没关系！那位叫做迪奥娜的调酒师，可是蒙德城最棒的调酒师。",
            "nextDialogs": [
              "191010112"
            ]
          },
          "191010112": {
            "id": "191010112",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "给你调制一杯不含酒的饮品…对她来说应该也不在话下。",
            "nextDialogs": [
              "191010113"
            ]
          },
          "191010113": {
            "id": "191010113",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "而且，那位叫做迪奥娜的调酒师也很可爱，就像是只小猫一样…",
            "nextDialogs": [
              "191010114"
            ]
          },
          "191010114": {
            "id": "191010114",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "嗝…嗝！说出来了，不行不行，你、你可别告诉迪奥娜，我说过这个词啊…",
            "nextDialogs": [
              "191010115"
            ]
          },
          "191010115": {
            "id": "191010115",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "不啰嗦了，你要是想去「猫尾酒馆」的话，酒馆的门就在后面，你直接过去就行。",
            "nextDialogs": [
              "191010116"
            ]
          },
          "191010116": {
            "id": "191010116",
            "speakerId": 1000,
            "speakerName": "宁禄",
            "text": "我…呃！我去旁边醒醒酒，之前喝了太多，看来喝不动第五轮了…"
          }
        }
      }
    },

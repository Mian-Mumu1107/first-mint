    {
      "subId": "46801",
      "subQuestName": "(test)对话NPC$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4680201"
        ],
        "dialogs": {
          "4680201": {
            "id": "4680201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么可以帮忙的吗？",
            "nextDialogs": [
              "4680202"
            ]
          },
          "4680202": {
            "id": "4680202",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "你是…？",
            "nextDialogs": [
              "4680203"
            ]
          },
          "4680203": {
            "id": "4680203",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "…是旅行者啊，可真是个热心肠的好人！",
            "nextDialogs": [
              "4680204"
            ]
          },
          "4680204": {
            "id": "4680204",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "现在正是葡萄生长的关键时节，可不知道哪儿来的野猪，成群结队，盯上这块地盘啦。",
            "nextDialogs": [
              "4680205"
            ]
          },
          "4680205": {
            "id": "4680205",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "我一个人赶又赶不走，儿子现在又不在身边，只能眼睁睁看着它们在地里横冲直撞…",
            "nextDialogs": [
              "4680206"
            ]
          },
          "4680206": {
            "id": "4680206",
            "speakerId": 1000,
            "speakerName": "特纳",
            "text": "你要是能帮忙给这些野猪一点儿教训的话，我特纳一定会好好答谢你的！"
          }
        }
      }
    },
    {

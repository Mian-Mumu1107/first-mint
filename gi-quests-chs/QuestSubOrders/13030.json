  },
  "subQuests": [
    {
      "subId": "1303001",
      "subQuestName": "前往长野原烟花店",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130300101"
        ],
        "dialogs": {
          "130300101": {
            "id": "130300101",
            "speakerId": 1000,
            "speakerName": "长野原龙之介",
            "text": "东西都收拾好了吗？你老妈给你准备的饭团和年糕，都带上了吗？",
            "nextDialogs": [
              "130300102"
            ]
          },
          "130300102": {
            "id": "130300102",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "放心吧，都在包里，够我吃好多天了。",
            "nextDialogs": [
              "130300103"
            ]
          },
          "130300103": {
            "id": "130300103",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "我不在家你们也要保重身体，记得叮嘱老妈按时吃药。",
            "nextDialogs": [
              "130300104"
            ]
          },
          "130300104": {
            "id": "130300104",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "实在不行店里的生意就歇几天，等我回来了再说。",
            "nextDialogs": [
              "130300105"
            ]
          },
          "130300105": {
            "id": "130300105",
            "speakerId": 1000,
            "speakerName": "长野原龙之介",
            "text": "我和你老妈，听说你要出远门，都很担心你啊。",
            "nextDialogs": [
              "130300106"
            ]
          },
          "130300106": {
            "id": "130300106",
            "speakerId": 1000,
            "speakerName": "长野原龙之介",
            "text": "我们也从来没去过外面，不知道他们怎么看待稻妻人，愿不愿意和我们说话…",
            "nextDialogs": [
              "130300107"
            ]
          },
          "130300107": {
            "id": "130300107",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "哎呀，这个你放心，你看从外面来的人啊，大家都很亲切，很热情。",
            "nextDialogs": [
              "130300108"
            ]
          },
          "130300108": {
            "id": "130300108",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "比如社奉行的托马，以前就是从蒙德来的，大家对他的印象都不错。",
            "nextDialogs": [
              "130300109"
            ]
          },
          "130300109": {
            "id": "130300109",
            "speakerId": 1000,
            "speakerName": "长野原龙之介",
            "text": "拖把？哦，你是说家里坏掉的拖把，我早上刚刚把它修好。",
            "nextDialogs": [
              "130300110"
            ]
          },
          "130300110": {
            "id": "130300110",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "不是啦，是托马！前段时间，他不是还送了家乡的酒到我们家来嘛！",
            "nextDialogs": [
              "130300111"
            ]
          },
          "130300111": {
            "id": "130300111",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这样的聊天很久没见，感觉好亲切啊。",
            "nextDialogs": [
              "130300112"
            ]
          },
          "130300112": {
            "id": "130300112",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "啊，居然是你们！好久不见了，真的好久不见！",
            "nextDialogs": [
              "130300113"
            ]
          },
          "130300113": {
            "id": "130300113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还是这么精神。",
            "nextDialogs": [
              "130300114"
            ]
          },
          "130300114": {
            "id": "130300114",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "嘿嘿，因为马上就要出去旅行了，心情很激动。",
            "nextDialogs": [
              "130300115"
            ]
          },
          "130300115": {
            "id": "130300115",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "要说那之后最大的变化，就是这个了，好多外国人来了稻妻，也有很多人走了出去。",
            "nextDialogs": [
              "130300116"
            ]
          },
          "130300116": {
            "id": "130300116",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "你们在提瓦特到处冒险，可能比较难理解，但对我们来说，这是个千载难逢的圆梦机会。",
            "nextDialogs": [
              "130300117"
            ]
          },
          "130300117": {
            "id": "130300117",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对哦，漫长的「锁国令」终于结束了。",
            "nextDialogs": [
              "130300118"
            ]
          },
          "130300118": {
            "id": "130300118",
            "speakerId": 1000,
            "speakerName": "长野原龙之介",
            "text": "我记得你们，是宵宫的朋友对吧。",
            "nextDialogs": [
              "130300119"
            ]
          },
          "130300119": {
            "id": "130300119",
            "speakerId": 1000,
            "speakerName": "长野原龙之介",
            "text": "你们了不起的事迹传遍了整个稻妻，我女儿很佩服你们，说要是能像你们一样该多好。",
            "nextDialogs": [
              "130300120"
            ]
          },
          "130300120": {
            "id": "130300120",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "嘿嘿，有点不好意思。谁小时候还没有一个英雄梦呢。",
            "nextDialogs": [
              "130300121"
            ]
          },
          "130300121": {
            "id": "130300121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你做的事也很了不起。",
            "nextDialogs": [
              "130300122"
            ]
          },
          "130300122": {
            "id": "130300122",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "谢谢你能这么说，我只是个普通的手艺人，生活还是安定一点好。",
            "nextDialogs": [
              "130300123"
            ]
          },
          "130300123": {
            "id": "130300123",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "但如果有机会的话，还是希望能更帅气一些啦。",
            "nextDialogs": [
              "130300124"
            ]
          },
          "130300124": {
            "id": "130300124",
            "speakerId": 1000,
            "speakerName": "长野原龙之介",
            "text": "对了，今天你们是来订做烟花的吗？",
            "nextDialogs": [
              "130300125"
            ]
          },
          "130300125": {
            "id": "130300125",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "啊，糟了！抱歉，光顾着聊自己的事情了。",
            "nextDialogs": [
              "130300126"
            ]
          },
          "130300126": {
            "id": "130300126",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "这段时间我们家的烟花会让老爹来做，他的手艺你们也见识过，很厉害的，可以放心下单。",
            "nextDialogs": [
              "130300127"
            ]
          },
          "130300127": {
            "id": "130300127",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没有啦，我们只是正好路过，没什么事。",
            "nextDialogs": [
              "130300128"
            ]
          },
          "130300128": {
            "id": "130300128",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "原来如此，居然我们都有空闲，真是难得…",
            "nextDialogs": [
              "130300129"
            ]
          },
          "130300129": {
            "id": "130300129",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "既然这样，就多聊一会儿吧，哈哈，我也没那么着急出发。",
            "nextDialogs": [
              "130300130"
            ]
          },
          "130300130": {
            "id": "130300130",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对了，说到旅行，宵宫你想去什么地方啊？",
            "nextDialogs": [
              "130300131"
            ]
          },
          "130300131": {
            "id": "130300131",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "不知道！",
            "nextDialogs": [
              "130300132"
            ]
          },
          "130300132": {
            "id": "130300132",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "130300133"
            ]
          },
          "130300133": {
            "id": "130300133",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "哈哈哈，但是旅行的目的已经定下来了，我想去看提瓦特最宏大的流星雨。",
            "nextDialogs": [
              "130300134"
            ]
          },
          "130300134": {
            "id": "130300134",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "但我不知道它什么时候出现，会出现在哪里，所以打算边旅行边找。",
            "nextDialogs": [
              "130300135"
            ]
          },
          "130300135": {
            "id": "130300135",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "就、就这样？没有稍微再详细一点的情报吗？",
            "nextDialogs": [
              "130300136"
            ]
          },
          "130300136": {
            "id": "130300136",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "目前还没有，因为本来是个类似传说的家族故事。",
            "nextDialogs": [
              "130300137"
            ]
          },
          "130300137": {
            "id": "130300137",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "在很久很久以前，长野原家的先祖，就是看到了这样的流星雨，才产生了新的烟花灵感。",
            "nextDialogs": [
              "130300138"
            ]
          },
          "130300138": {
            "id": "130300138",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "我老爹说，灵感是所见与所知的融合，不同的人看到相同的景色，联想也会全然不同。",
            "nextDialogs": [
              "130300139"
            ]
          },
          "130300139": {
            "id": "130300139",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "现在的稻妻和过去已经完全不一样了，如果我能看到这场流星雨，一定能想出完全不同的烟花。",
            "nextDialogs": [
              "130300142"
            ]
          },
          "130300142": {
            "id": "130300142",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "是吧是吧，当然更多的理由是我想去外面转一转，看一看，嘿嘿。",
            "nextDialogs": [
              "130300143"
            ]
          },
          "130300143": {
            "id": "130300143",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不用不好意思，有机会又有时间的时候，就是该玩个痛快！",
            "nextDialogs": [
              "130300144"
            ]
          },
          "130300144": {
            "id": "130300144",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "你很懂嘛，派蒙，你比我们刚认识的时候还要机灵了。",
            "nextDialogs": [
              "130300145"
            ]
          },
          "130300145": {
            "id": "130300145",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嘿嘿，我就喜欢和宵宫当朋友，说话真好听！"
          }
        }
      }
    },
    {
      "subId": "1303002",
      "subQuestName": "前往离岛港口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130300201"
        ],
        "dialogs": {
          "130300201": {
            "id": "130300201",
            "speakerId": 1003,
            "speakerName": "行船途中",
            "text": "你们搭上了前往奥摩斯港的客船，纵览明媚的海上风光。",
            "nextDialogs": [
              "130300202"
            ]
          },
          "130300202": {
            "id": "130300202",
            "speakerId": 1003,
            "speakerName": "行船途中",
            "text": "宵宫听你讲述了「眼狩令」结束之后，以及在须弥的种种冒险，听得如痴如醉。",
            "nextDialogs": [
              "130300203"
            ]
          },
          "130300203": {
            "id": "130300203",
            "speakerId": 1003,
            "speakerName": "行船途中",
            "text": "漫长的海程很快过去…",
            "nextDialogs": [
              "130300204"
            ]
          },
          "130300204": {
            "id": "130300204",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "呜哇，这就是须弥吗？",
            "nextDialogs": [
              "130300205"
            ]
          },
          "130300205": {
            "id": "130300205",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "好大的…树？这座港口居然建在树上？",
            "nextDialogs": [
              "130300206"
            ]
          },
          "130300206": {
            "id": "130300206",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "而且这里也太气派了吧，比离岛的港口大好多，商铺也多了不少。",
            "nextDialogs": [
              "130300207"
            ]
          },
          "130300207": {
            "id": "130300207",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嘿嘿，更厉害的还在后面呢。",
            "nextDialogs": [
              "130300210"
            ]
          },
          "130300210": {
            "id": "130300210",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "好厉害，虽然我在别人的描述里听过，但所谓百闻不如一见…",
            "nextDialogs": [
              "130300211"
            ]
          },
          "130300211": {
            "id": "130300211",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "要不是亲眼看到，恐怕我一辈子也想象不出来。",
            "nextDialogs": [
              "130300212"
            ]
          },
          "130300212": {
            "id": "130300212",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "所以，你们说的那个学院…叫「教令院」对吧？就在这里吗？",
            "nextDialogs": [
              "130300213"
            ]
          },
          "130300213": {
            "id": "130300213",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不是，我们要从奥摩斯港出发向北走，顺着河流往上，才能抵达须弥城。",
            "nextDialogs": [
              "130300214"
            ]
          },
          "130300214": {
            "id": "130300214",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "哦，须弥城…那应该比这个地方还要厉害吧？"
          }
        }
      }
    },
    {
      "subId": "1303009",
      "subQuestName": "与宵宫交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1303003",
      "subQuestName": "在奥摩斯港逛逛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130300301"
        ],
        "dialogs": {
          "130300301": {
            "id": "130300301",
            "speakerId": 1004,
            "speakerName": "法伊兹",
            "text": "欢迎光临「阿折罗造像」直销商铺，请随意看看吧。",
            "nextDialogs": [
              "130300302"
            ]
          },
          "130300302": {
            "id": "130300302",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "哇，这是什么，都好可爱！",
            "nextDialogs": [
              "130300303"
            ]
          },
          "130300303": {
            "id": "130300303",
            "speakerId": 1004,
            "speakerName": "法伊兹",
            "text": "这是本店目前销量最好的玩具，名叫「兰那罗木刻」。",
            "nextDialogs": [
              "130300304"
            ]
          },
          "130300304": {
            "id": "130300304",
            "speakerId": 1004,
            "speakerName": "法伊兹",
            "text": "它们都是基于小朋友们口口相传的童话形象设计而来，也特别受到他们的欢迎。",
            "nextDialogs": [
              "130300305"
            ]
          },
          "130300305": {
            "id": "130300305",
            "speakerId": 1004,
            "speakerName": "法伊兹",
            "text": "这位女士是从稻妻来的吧，这种木刻作为礼物带回去，是很合适的哦。",
            "nextDialogs": [
              "130300306"
            ]
          },
          "130300306": {
            "id": "130300306",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "兰那罗，我知道！你们船上讲过他们的故事，没想到居然长得这么可爱，怪不得小孩子会喜欢。",
            "nextDialogs": [
              "130300307"
            ]
          },
          "130300307": {
            "id": "130300307",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "每一个都做得好漂亮，我要好好看看…",
            "nextDialogs": [
              "130300308"
            ]
          },
          "130300308": {
            "id": "130300308",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我就知道宵宫会喜欢这个。",
            "nextDialogs": [
              "130300309"
            ]
          },
          "130300309": {
            "id": "130300309",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不过就算是宵宫，恐怕也没办法看到真正的兰那罗吧…",
            "nextDialogs": [
              "130300312"
            ]
          },
          "130300312": {
            "id": "130300312",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯，虽然有点对不起宵宫，但我们也要维护和兰那罗的约定才行。",
            "nextDialogs": [
              "130300313"
            ]
          },
          "130300313": {
            "id": "130300313",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不过，宵宫应该也不会很在意这种事吧。",
            "nextDialogs": [
              "130300314"
            ]
          },
          "130300314": {
            "id": "130300314",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "她的世界里，早就有无数种幻想生物了。",
            "nextDialogs": [
              "130300315"
            ]
          },
          "130300315": {
            "id": "130300315",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "我决定了，我要这种，这种，还要刚刚你拿上来给我看过的那两种。",
            "nextDialogs": [
              "130300316"
            ]
          },
          "130300316": {
            "id": "130300316",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸？你要买这么多吗？",
            "nextDialogs": [
              "130300317"
            ]
          },
          "130300317": {
            "id": "130300317",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "对啊，彩香他们肯定会喜欢，拿回去分给孩子们。唔，和「荒泷派」比试的时候，当奖品也不错。",
            "nextDialogs": [
              "130300318"
            ]
          },
          "130300318": {
            "id": "130300318",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "而且你想想看，如果能把这个在窗边摆上一排，早上起来第一眼看到的就是这么可爱的东西。",
            "nextDialogs": [
              "130300319"
            ]
          },
          "130300319": {
            "id": "130300319",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "那一整天的心情都会很好。"
          }
        }
      }
    },
    {
      "subId": "1303004",
      "subQuestName": "前往须弥城",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130300401"
        ],
        "dialogs": {
          "130300401": {
            "id": "130300401",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "哇，这个地方感觉比奥摩斯港的市场更加繁华。",
            "nextDialogs": [
              "130300402"
            ]
          },
          "130300402": {
            "id": "130300402",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这里是宝商街，往上走就是教令院，如果往树干里面走，就是大巴扎，都是很有特点的地方。",
            "nextDialogs": [
              "130300403"
            ]
          },
          "130300403": {
            "id": "130300403",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "我刚刚就看见好多人穿一样的衣服从上面走下来，那个就是教令院统一的制服吗？",
            "nextDialogs": [
              "130300404"
            ]
          },
          "130300404": {
            "id": "130300404",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对哦，还会根据学院的不同，戴上不同图案的帽子。",
            "nextDialogs": [
              "130300405"
            ]
          },
          "130300405": {
            "id": "130300405",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "比如等会儿我们要找的就是明论派的人，关于星星的事问他们准没错。",
            "nextDialogs": [
              "130300406"
            ]
          },
          "130300406": {
            "id": "130300406",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "换句话说，一般如果要进出教令院的话，就得穿那样的衣服？",
            "nextDialogs": [
              "130300407"
            ]
          },
          "130300407": {
            "id": "130300407",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那好像也没有这样的说法…",
            "nextDialogs": [
              "130300408"
            ]
          },
          "130300408": {
            "id": "130300408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "宵宫你在担心什么吗？",
            "nextDialogs": [
              "130300409"
            ]
          },
          "130300409": {
            "id": "130300409",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "嗯，我觉得我这个样子和你们一起进去，会不会太招摇了点？",
            "nextDialogs": [
              "130300410"
            ]
          },
          "130300410": {
            "id": "130300410",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你居然害羞了，没想到啊。",
            "nextDialogs": [
              "130300411"
            ]
          },
          "130300411": {
            "id": "130300411",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "不不不，倒不是这个原因，你们设身处地想一想，假如你们是教令院的学生，正在努力学习。",
            "nextDialogs": [
              "130300412"
            ]
          },
          "130300412": {
            "id": "130300412",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "这时候突然闯进来一个穿着怪异的外国人，东张西望，四处乱走…",
            "nextDialogs": [
              "130300413"
            ]
          },
          "130300413": {
            "id": "130300413",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呃，我好像有点明白你的意思了…",
            "nextDialogs": [
              "130300416"
            ]
          },
          "130300416": {
            "id": "130300416",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "嗯，虽然说我们不用过分在意别人的目光，但我觉得这也要注意时宜。",
            "nextDialogs": [
              "130300417"
            ]
          },
          "130300417": {
            "id": "130300417",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "要不然我就先在这附近转转，正好我也想去看看你们说的「祖拜尔剧场」。",
            "nextDialogs": [
              "130300418"
            ]
          },
          "130300418": {
            "id": "130300418",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "教令院的话…等我准备一套须弥风格的衣服再去参观好了。",
            "nextDialogs": [
              "130300419"
            ]
          },
          "130300419": {
            "id": "130300419",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "也行吧，虽然我觉得不用考虑那么多。",
            "nextDialogs": [
              "130300420"
            ]
          },
          "130300420": {
            "id": "130300420",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "晚点帮你找个厉害的裁缝。",
            "nextDialogs": [
              "130300421"
            ]
          },
          "130300421": {
            "id": "130300421",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "做衣服的话，妮露说不定有很棒的推荐。",
            "nextDialogs": [
              "130300422"
            ]
          },
          "130300422": {
            "id": "130300422",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "嘿嘿，好啊，如果顺便能看到她的演出就更棒了。",
            "nextDialogs": [
              "130300423"
            ]
          },
          "130300423": {
            "id": "130300423",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "那我就在附近闲逛，流星雨的事就麻烦你们去打听一下了。",
            "nextDialogs": [
              "130300424"
            ]
          },
          "130300424": {
            "id": "130300424",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好，我们去去就回来。"
          }
        }
      }
    },
    {
      "subId": "1303005",
      "subQuestName": "前往教令院",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130300601"
        ],
        "dialogs": {
          "130300601": {
            "id": "130300601",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "所以我们现在要做的，就是让宵宫相信流星雨确实存在，然后付出一些努力吧？",
            "nextDialogs": [
              "130300602"
            ]
          },
          "130300602": {
            "id": "130300602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "完成挑战，让收获水到渠成。",
            "nextDialogs": [
              "130300603"
            ]
          },
          "130300603": {
            "id": "130300603",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "如果我要去看一场流星雨，我最关心的事情是…",
            "nextDialogs": [
              "130300606"
            ]
          },
          "130300606": {
            "id": "130300606",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没错，就是这两个！名义上是寻找这两个信息，其实是带宵宫在须弥看风景和吃好吃的！",
            "nextDialogs": [
              "130300607"
            ]
          },
          "130300607": {
            "id": "130300607",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "——话虽这么说，这个「名义」不需要很严谨，但也不能一下子就被识破了。",
            "nextDialogs": [
              "130300608"
            ]
          },
          "130300608": {
            "id": "130300608",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "最好还能有童话故事中的那种又浪漫，又别出心裁的感觉…唔，好难。"
          }
        }
      }
    },
    {
      "subId": "1303007",
      "subQuestName": "回到宝商街找宵宫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130300701"
        ],
        "dialogs": {
          "130300701": {
            "id": "130300701",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "谢谢你啊，要是没有你介绍，我早就迷路了。",
            "nextDialogs": [
              "130300702"
            ]
          },
          "130300702": {
            "id": "130300702",
            "speakerId": 1005,
            "speakerName": "艾文",
            "text": "嗯，没关系。那我就先回家了。",
            "nextDialogs": [
              "130300703"
            ]
          },
          "130300703": {
            "id": "130300703",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "等下等下，这个送给你。",
            "nextDialogs": [
              "130300704"
            ]
          },
          "130300704": {
            "id": "130300704",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "这是我在奥摩斯港买的兰那罗木刻，听说在小孩子里很有人气，送你一个吧。",
            "nextDialogs": [
              "130300705"
            ]
          },
          "130300705": {
            "id": "130300705",
            "speakerId": 1005,
            "speakerName": "艾文",
            "text": "不用了，我也没做什么…",
            "nextDialogs": [
              "130300706"
            ]
          },
          "130300706": {
            "id": "130300706",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "没事啦，拿着吧，你看它笑得多开心啊。",
            "nextDialogs": [
              "130300707"
            ]
          },
          "130300707": {
            "id": "130300707",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "摆在家里，或者挂在轮椅上，也能让你开心一点吧。",
            "nextDialogs": [
              "130300708"
            ]
          },
          "130300708": {
            "id": "130300708",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "可能你觉得这话听起来很蠢，「啊，为什么它开心我也要跟着开心啊！」",
            "nextDialogs": [
              "130300709"
            ]
          },
          "130300709": {
            "id": "130300709",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "但这就是笑容的魔力哦，不信你就试试看，每天多看它几眼，你会明白的。",
            "nextDialogs": [
              "130300710"
            ]
          },
          "130300710": {
            "id": "130300710",
            "speakerId": 1005,
            "speakerName": "艾文",
            "text": "…其实我已经有点感受到了，姐姐你好喜欢说话，也好喜欢笑。",
            "nextDialogs": [
              "130300711"
            ]
          },
          "130300711": {
            "id": "130300711",
            "speakerId": 1005,
            "speakerName": "艾文",
            "text": "但我不明白你为什么这么乐观…没见过你这样的人。",
            "nextDialogs": [
              "130300712"
            ]
          },
          "130300712": {
            "id": "130300712",
            "speakerId": 1005,
            "speakerName": "艾文",
            "text": "对不起，说话不太好听。既然你这么说，我就收下了。",
            "nextDialogs": [
              "130300713"
            ]
          },
          "130300713": {
            "id": "130300713",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "要不我送你回去吧？",
            "nextDialogs": [
              "130300714"
            ]
          },
          "130300714": {
            "id": "130300714",
            "speakerId": 1005,
            "speakerName": "艾文",
            "text": "不用了，我自己能行。",
            "nextDialogs": [
              "130300715"
            ]
          },
          "130300715": {
            "id": "130300715",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "乘坐轮椅的小孩子离开了。",
            "nextDialogs": [
              "130300716"
            ]
          },
          "130300716": {
            "id": "130300716",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "哟，你们回来的正是时候啊。",
            "nextDialogs": [
              "130300717"
            ]
          },
          "130300717": {
            "id": "130300717",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "刚刚的那个孩子是？",
            "nextDialogs": [
              "130300718"
            ]
          },
          "130300718": {
            "id": "130300718",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "她啊，她叫艾文，我看她闷闷不乐的样子，就去和她搭话了。",
            "nextDialogs": [
              "130300719"
            ]
          },
          "130300719": {
            "id": "130300719",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "她本来不太愿意理我，我就说我刚来须弥城，迷路了，想找个本地人带路，可是大家都很忙…",
            "nextDialogs": [
              "130300720"
            ]
          },
          "130300720": {
            "id": "130300720",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "如果她愿意帮我的话，我就帮她推椅子，她犹豫了一会儿，还是答应了。",
            "nextDialogs": [
              "130300721"
            ]
          },
          "130300721": {
            "id": "130300721",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "不过其实我真的有点迷路，哈哈，这里四通八达，一会儿上去一会儿又下来，真是分不清。",
            "nextDialogs": [
              "130300722"
            ]
          },
          "130300722": {
            "id": "130300722",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她把心事告诉你了吗？",
            "nextDialogs": [
              "130300723"
            ]
          },
          "130300723": {
            "id": "130300723",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "没有，她不愿意说，我也没问。问了只会让她再回忆一次不开心的事吧。",
            "nextDialogs": [
              "130300724"
            ]
          },
          "130300724": {
            "id": "130300724",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "不过我猜，估计还是和没办法站起来有关系…",
            "nextDialogs": [
              "130300725"
            ]
          },
          "130300725": {
            "id": "130300725",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "她只是说她生病了，不知道什么时候才能好。",
            "nextDialogs": [
              "130300726"
            ]
          },
          "130300726": {
            "id": "130300726",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "每当我们路过熙熙攘攘的人群，她就会左顾右看，我本来以为她是怕被撞到…",
            "nextDialogs": [
              "130300727"
            ]
          },
          "130300727": {
            "id": "130300727",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "结果她的眼神里，是一种向往，还有些悲伤。",
            "nextDialogs": [
              "130300728"
            ]
          },
          "130300728": {
            "id": "130300728",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔，有这么不幸的遭遇，心情失落也是难免的。",
            "nextDialogs": [
              "130300729"
            ]
          },
          "130300729": {
            "id": "130300729",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "她一开始一句话都不想和我讲，嘴里几乎只有是与否。",
            "nextDialogs": [
              "130300730"
            ]
          },
          "130300730": {
            "id": "130300730",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "我就一个人在说话，说地毯的事，香料的事，料理的事，又说这里跟我家有什么差别…",
            "nextDialogs": [
              "130300731"
            ]
          },
          "130300731": {
            "id": "130300731",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "后来她慢慢愿意开口了，嘿嘿，内向的孩子基本都这样。",
            "nextDialogs": [
              "130300732"
            ]
          },
          "130300732": {
            "id": "130300732",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "不过话虽这么说，她一路上说的话加起来，可能也只有你们回来的时候听到的这么多。",
            "nextDialogs": [
              "130300733"
            ]
          },
          "130300733": {
            "id": "130300733",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她已经放下戒备了。",
            "nextDialogs": [
              "130300734"
            ]
          },
          "130300734": {
            "id": "130300734",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "万事开头难嘛。对了对了，流星雨的事，你们打听到了吗？",
            "nextDialogs": [
              "130300735"
            ]
          },
          "130300735": {
            "id": "130300735",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "有哦，很大的收获！我们运气很好，流星雨在须弥就可以看到！",
            "nextDialogs": [
              "130300736"
            ]
          },
          "130300736": {
            "id": "130300736",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "真的吗？！哈哈，那太好了，要是我自己去找，肯定就错过了。",
            "nextDialogs": [
              "130300737"
            ]
          },
          "130300737": {
            "id": "130300737",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那也不一定。",
            "nextDialogs": [
              "130300738"
            ]
          },
          "130300738": {
            "id": "130300738",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "嗯，什么意思？",
            "nextDialogs": [
              "130300739"
            ]
          },
          "130300739": {
            "id": "130300739",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "流星雨是回应愿望而出现的。",
            "nextDialogs": [
              "130300740"
            ]
          },
          "130300740": {
            "id": "130300740",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "回应愿望？我还从来没听过这种说法…",
            "nextDialogs": [
              "130300741"
            ]
          },
          "130300741": {
            "id": "130300741",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "并不是向流星许愿，而是反过来，用愿望召唤流星吗？",
            "nextDialogs": [
              "130300742"
            ]
          },
          "130300742": {
            "id": "130300742",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "嘿嘿，那我早有准备，放心吧。",
            "nextDialogs": [
              "130300743"
            ]
          },
          "130300743": {
            "id": "130300743",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "是你之前说的那个，要用流星雨作为烟花灵感的事吗？",
            "nextDialogs": [
              "130300744"
            ]
          },
          "130300744": {
            "id": "130300744",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "那个是理由，应该还不能称之为愿望，仅仅是这样应该没办法让星空为我们降下流星雨吧？",
            "nextDialogs": [
              "130300745"
            ]
          },
          "130300745": {
            "id": "130300745",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊…啊，对，我觉得有道理。",
            "nextDialogs": [
              "130300746"
            ]
          },
          "130300746": {
            "id": "130300746",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "（她居然自己在加戏…）",
            "nextDialogs": [
              "130300747"
            ]
          },
          "130300747": {
            "id": "130300747",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "既然这样的话，应该在「许愿」这件事上做一点练习。",
            "nextDialogs": [
              "130300748"
            ]
          },
          "130300748": {
            "id": "130300748",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "你们可以陪我吗，我先组织一下语言，你们听听看是否能理解。",
            "nextDialogs": [
              "130300749"
            ]
          },
          "130300749": {
            "id": "130300749",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "至于愿望是什么…嘿嘿，容我先卖个关子吧。",
            "nextDialogs": [
              "130300752"
            ]
          },
          "130300752": {
            "id": "130300752",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯，顺便让你看看你以前绝对没有见过的景色。",
            "nextDialogs": [
              "130300753"
            ]
          },
          "130300753": {
            "id": "130300753",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "还有这种地方？好，那我们快走吧，现在就出发！"
          }
        }
      }
    },
    {
      "subId": "1303006",
      "subQuestName": "离开教令院，与派蒙商量",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1303005",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130300501"
        ],
        "dialogs": {
          "130300501": {
            "id": "130300501",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "虽然说了要找明论派，但仔细一想，好像没有合适的人选…",
            "nextDialogs": [
              "130300502"
            ]
          },
          "130300502": {
            "id": "130300502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "毕竟之前明论派贤者是阿扎尔。",
            "nextDialogs": [
              "130300503"
            ]
          },
          "130300503": {
            "id": "130300503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "莱依拉估计现在也自身难保…",
            "nextDialogs": [
              "130300504"
            ]
          },
          "130300504": {
            "id": "130300504",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我觉得这种事艾尔海森应该会知道，但…我不想找他。",
            "nextDialogs": [
              "130300505"
            ]
          },
          "130300505": {
            "id": "130300505",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "要不然我们先随便问问，说不定就有明论派的呢。",
            "nextDialogs": [
              "130300506"
            ]
          },
          "130300506": {
            "id": "130300506",
            "speakerId": 1007,
            "speakerName": "纳西妲",
            "text": "看来你们遇到了艰难的抉择，为什么不考虑一下对你们知无不言的人呢？",
            "nextDialogs": [
              "130300507"
            ]
          },
          "130300507": {
            "id": "130300507",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇？！纳西妲，你怎么在这里！",
            "nextDialogs": [
              "130300510"
            ]
          },
          "130300510": {
            "id": "130300510",
            "speakerId": 1007,
            "speakerName": "纳西妲",
            "text": "我本来是要和学者见面，正好看到你们走进来然后一脸犯愁的样子，我就跟上来了。",
            "nextDialogs": [
              "130300511"
            ]
          },
          "130300511": {
            "id": "130300511",
            "speakerId": 1007,
            "speakerName": "纳西妲",
            "text": "看来好像正是时候。",
            "nextDialogs": [
              "130300512"
            ]
          },
          "130300512": {
            "id": "130300512",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯，那我来说吧，我们有个朋友来了须弥…",
            "nextDialogs": [
              "130300513"
            ]
          },
          "130300513": {
            "id": "130300513",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "和纳西妲讲了宵宫和流星雨的事。",
            "nextDialogs": [
              "130300514"
            ]
          },
          "130300514": {
            "id": "130300514",
            "speakerId": 1007,
            "speakerName": "纳西妲",
            "text": "唔，原来是这样…",
            "nextDialogs": [
              "130300515"
            ]
          },
          "130300515": {
            "id": "130300515",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "看你的表情，难道说距离下次流星雨还要很久吗？",
            "nextDialogs": [
              "130300516"
            ]
          },
          "130300516": {
            "id": "130300516",
            "speakerId": 1007,
            "speakerName": "纳西妲",
            "text": "嗯…或许是一个更扫兴的答案。",
            "nextDialogs": [
              "130300517"
            ]
          },
          "130300517": {
            "id": "130300517",
            "speakerId": 1007,
            "speakerName": "纳西妲",
            "text": "你们可能听说过一个说法，提瓦特天空的星星与人的命运有关。",
            "nextDialogs": [
              "130300518"
            ]
          },
          "130300518": {
            "id": "130300518",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这个倒是听过好几次了。",
            "nextDialogs": [
              "130300519"
            ]
          },
          "130300519": {
            "id": "130300519",
            "speakerId": 1007,
            "speakerName": "纳西妲",
            "text": "既然星星昭示了命运，你们想想看，命运会是一成不变，永远遵循预测结果的东西吗？",
            "nextDialogs": [
              "130300520"
            ]
          },
          "130300520": {
            "id": "130300520",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "有道理哦…"
          }
        }
      }
    },
    {
      "subId": "1303009",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

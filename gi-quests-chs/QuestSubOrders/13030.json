            "speakerName": "长野原龙之介",
            "text": "路上小心，好好玩吧！"
          }
        }
      }
    },
    {
      "subId": "1303013",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130301301"
        ],
        "dialogs": {
          "130301301": {
            "id": "130301301",
            "speakerId": 1004,
            "speakerName": "法伊兹",
            "text": "谢谢惠顾，祝你们玩得开心。"
          }
        }
      }
    },
    {
      "subId": "1303015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130301501"
        ],
        "dialogs": {
          "130301501": {
            "id": "130301501",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "我不会走太远的，你们也不用担心我会无聊，我有一万种打发时间的办法。"
          }
        }
      }
    },
    {
      "subId": "1303099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130309901"
        ],
        "dialogs": {
          "130309901": {
            "id": "130309901",
            "speakerId": 1004,
            "speakerName": "法伊兹",
            "text": "（今天生意不错，待会儿看看账…）",
            "nextDialogs": [
              "130309902"
            ]
          },
          "130309902": {
            "id": "130309902",
            "speakerId": 1004,
            "speakerName": "法伊兹",
            "text": "（不知道其他的稻妻人看到了兰那罗木刻，会有什么样的评价…）",
            "nextDialogs": [
              "130309903"
            ]
          },
          "130309903": {
            "id": "130309903",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "奥摩斯港逛得差不多了，接下来就去须弥城吧。",
            "nextDialogs": [
              "130309904"
            ]
          },
          "130309904": {
            "id": "130309904",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "好啊，是时候做正事了。",
            "nextDialogs": [
              "130309905"
            ]
          },
          "130309905": {
            "id": "130309905",
            "speakerId": 1001,
            "speakerName": "宵宫",
            "text": "（先去做点什么呢…嗯，要不然先逛逛周围都在卖什么吧。）"
          }
        }
      }
    }
  ]
}
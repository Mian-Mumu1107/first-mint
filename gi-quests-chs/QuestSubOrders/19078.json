    {
      "subId": "1907804",
      "subQuestName": "在附近打听阿尔卡米",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190780401"
        ],
        "dialogs": {
          "190780401": {
            "id": "190780401",
            "speakerId": 13265,
            "speakerName": "阿丹",
            "text": "你好，找我有什么事吗？",
            "nextDialogs": [
              "190780404"
            ]
          },
          "190780404": {
            "id": "190780404",
            "speakerId": 13265,
            "speakerName": "阿丹",
            "text": "你说阿尔卡米？是最近很出名的那个有钱人吧？他之前找我定制家具，出手相当阔绰。",
            "nextDialogs": [
              "190780405"
            ]
          },
          "190780405": {
            "id": "190780405",
            "speakerId": 13265,
            "speakerName": "阿丹",
            "text": "听说他以前是知名建筑师，攒下了富裕的家产。现在开设了培训机构，向大家分享自己的致富之路。",
            "nextDialogs": [
              "190780406"
            ]
          },
          "190780406": {
            "id": "190780406",
            "speakerId": 13265,
            "speakerName": "阿丹",
            "text": "如果不是学费太贵，我也想给我的孩子报个名。做建筑师真赚钱啊…"
          }
        }
      }
    },
    {
      "subId": "1907808",
      "subQuestName": "在附近打听阿尔卡米",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190780801"
        ],
        "dialogs": {
          "190780801": {
            "id": "190780801",
            "speakerId": 13266,
            "speakerName": "阿比德",
            "text": "听说了吗？阿尔卡米找来了卡维当培训班的老师。",
            "nextDialogs": [
              "190780802"
            ]
          },
          "190780802": {
            "id": "190780802",
            "speakerId": 13270,
            "speakerName": "阿迪勒",
            "text": "嘿，这下他的生意肯定更好了吧？",
            "nextDialogs": [
              "190780803"
            ]
          },
          "190780803": {
            "id": "190780803",
            "speakerId": 13266,
            "speakerName": "阿比德",
            "text": "真让人眼红。阿尔卡米那小子，干建筑设计师的时候就得过且过，论能力他根本当不了老师。",
            "nextDialogs": [
              "190780804"
            ]
          },
          "190780804": {
            "id": "190780804",
            "speakerId": 13270,
            "speakerName": "阿迪勒",
            "text": "他宣传得好呗…再加上教令院有入学考试，能进教令院学建筑的人毕竟还是少数。",
            "nextDialogs": [
              "190780805"
            ]
          },
          "190780805": {
            "id": "190780805",
            "speakerId": 13270,
            "speakerName": "阿迪勒",
            "text": "上不了教令院的人，以及那些追求「速成」的人，自然会汇聚到他的培训机构里。",
            "nextDialogs": [
              "190780806"
            ]
          },
          "190780806": {
            "id": "190780806",
            "speakerId": 13266,
            "speakerName": "阿比德",
            "text": "真是生财有道啊…"
          }
        }
      }
    },

    {
      "subId": "1907850",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190785001"
        ],
        "dialogs": {
          "190785001": {
            "id": "190785001",
            "speakerId": 13242,
            "speakerName": "乌宰尔",
            "text": "卡维老师看起来很生气。",
            "nextDialogs": [
              "190785002"
            ]
          },
          "190785002": {
            "id": "190785002",
            "speakerId": 13267,
            "speakerName": "瓦伊兹",
            "text": "管他呢。说不定他是担心，我们将来会抢了他的饭碗！",
            "nextDialogs": [
              "190785003"
            ]
          },
          "190785003": {
            "id": "190785003",
            "speakerId": 13268,
            "speakerName": "塔尼莎",
            "text": "这…应该不至于吧？卡维老师那么有名…",
            "nextDialogs": [
              "190785004"
            ]
          },
          "190785004": {
            "id": "190785004",
            "speakerId": 13267,
            "speakerName": "瓦伊兹",
            "text": "谁知道呢？我爹说了，越有名的人越喜欢摆架子，像阿尔卡米老师那样的才是少数。"
          }
        }
      }
    },
    {
      "subId": "1907851",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190785101"
        ],
        "dialogs": {
          "190785101": {
            "id": "190785101",
            "speakerId": 12772,
            "speakerName": "纳比尔",
            "text": "你好，这里已经被查封，正在对相关人员调查中。",
            "nextDialogs": [
              "190785102"
            ]
          },
          "190785102": {
            "id": "190785102",
            "speakerId": 12772,
            "speakerName": "纳比尔",
            "text": "有什么事，请明天再来吧。"
          }
        }
      }
    },
    {
      "subId": "1907852",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "190785201"
        ],
        "dialogs": {
          "190785201": {
            "id": "190785201",
            "speakerId": 13271,
            "speakerName": "公告牌",
            "text": "经调查，培训机构负责人阿尔卡米教唆学生家长背负高利贷，以此谋取暴利。",
            "nextDialogs": [
              "190785202"
            ]
          },
          "190785202": {
            "id": "190785202",
            "speakerId": 13271,
            "speakerName": "公告牌",
            "text": "培训机构已封禁，相关赃款会在核实后予以退回。"
          }
        }
      }
    },

      }
    },
    {
      "subId": "7103806",
      "subQuestName": "去信标放置处寻找志琼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710380601"
        ],
        "dialogs": {
          "710380601": {
            "id": "710380601",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "海迪夫给她开了些药…志琼恢复了一点意识，但她什么也不愿意跟我说。",
            "nextDialogs": [
              "710380602"
            ]
          },
          "710380602": {
            "id": "710380602",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "你们知道她是怎么回事吗？好好的一个人，怎么会变成这样？",
            "nextDialogs": [
              "710380603"
            ]
          },
          "710380603": {
            "id": "710380603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们发现她时，她被困在了黑泥里。",
            "nextDialogs": [
              "710380604"
            ]
          },
          "710380604": {
            "id": "710380604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀对呀，幸好我们及时把她救出来了！",
            "nextDialogs": [
              "710380605"
            ]
          },
          "710380605": {
            "id": "710380605",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "……",
            "nextDialogs": [
              "710380606"
            ]
          },
          "710380606": {
            "id": "710380606",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "算了，志琼现在最需要休息。请替我把这碗汤趁热递给她吧。",
            "nextDialogs": [
              "710380607"
            ]
          },
          "710380607": {
            "id": "710380607",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "虽然不太会做饭，照顾矿工的事情反正我也没少做过。还没人敢嫌弃我的手艺。",
            "nextDialogs": [
              "710380608"
            ]
          },
          "710380608": {
            "id": "710380608",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "好了，去吧，看看志琼好些了吗。",
            "nextDialogs": [
              "710380609"
            ]
          },
          "710380609": {
            "id": "710380609",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "我需要跟沐宁反映一下，志琼不能留在地下了。"
          }
        }
      }
    },
    {
      "subId": "7103807",
      "subQuestName": "去信标放置处寻找志琼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710380701"
        ],
        "dialogs": {
          "710380701": {
            "id": "710380701",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "咳咳…！咳咳…抱歉…",
            "nextDialogs": [
              "710380702"
            ]
          },
          "710380702": {
            "id": "710380702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你也知道抱歉哇！到处乱跑的时候怎么就没想过要麻烦我们呢！",
            "nextDialogs": [
              "710380703"
            ]
          },
          "710380703": {
            "id": "710380703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好了，派蒙…",
            "nextDialogs": [
              "710380704"
            ]
          },
          "710380704": {
            "id": "710380704",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "咳咳…哈…是…失足，是不小心…失足了…有点好笑…哈哈…对吧？",
            "nextDialogs": [
              "710380705"
            ]
          },
          "710380705": {
            "id": "710380705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好笑什么啦！你就不拿自己的生命当回事吗！",
            "nextDialogs": [
              "710380706"
            ]
          },
          "710380706": {
            "id": "710380706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你需要休息，瑾武姐给你做了汤。"
          }
        }
      }
    },
    {
      "subId": "7103810",

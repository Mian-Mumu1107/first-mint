      }
    },
    {
      "subId": "7103804",
      "subQuestName": "去信标放置处寻找志琼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710380401"
        ],
        "dialogs": {
          "710380401": {
            "id": "710380401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还能走路吗？",
            "nextDialogs": [
              "710380403"
            ]
          },
          "710380403": {
            "id": "710380403",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "对不起…对不起…瑾武姐…还有…咳咳…",
            "nextDialogs": [
              "710380406"
            ]
          },
          "710380406": {
            "id": "710380406",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "请你们不要…咳咳…哈…不要这样看着我…请不要对我们失望…",
            "nextDialogs": [
              "710380407"
            ]
          },
          "710380407": {
            "id": "710380407",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "金色的城…黑色的高阙…咳咳…！天上下来的使者们离开了…",
            "nextDialogs": [
              "710380404"
            ]
          },
          "710380404": {
            "id": "710380404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不要说胡话啦！你这个人呀…"
          }
        }
      }
    },
    {
      "subId": "7103805",
      "subQuestName": "去信标放置处寻找志琼",
      "sceneId": null,
      "locations": [],
      "dialogue": {

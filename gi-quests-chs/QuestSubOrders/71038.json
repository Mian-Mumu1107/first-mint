    {
      "subId": "7103811",
      "subQuestName": "与志琼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710380408"
        ],
        "dialogs": {
          "710380408": {
            "id": "710380408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊！这家伙状态太不妙啦！我们快把她带回去吧！"
          }
        }
      }
    },
    {
      "subId": "7103817",
      "subQuestName": "2隐藏判断瑾武是否说过闲置$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710381601"
        ],
        "dialogs": {
          "710381601": {
            "id": "710381601",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "……",
            "nextDialogs": [
              "710381602"
            ]
          },
          "710381602": {
            "id": "710381602",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "…？啊，抱歉，我在想事情。抱歉…",
            "nextDialogs": [
              "710381603"
            ]
          },
          "710381603": {
            "id": "710381603",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "志琼那孩子，我要好好和她谈谈才行…",
            "nextDialogs": [
              "710381604"
            ]
          },
          "710381604": {
            "id": "710381604",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "我在矿上工作很久了，不是没有见过这样的孩子…",
            "nextDialogs": [
              "710381605"
            ]
          },
          "710381605": {
            "id": "710381605",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "有太多不成熟的孩子，把冒险当做了不得的目标去追逐，最终却落得愿望破碎离散的下场…为此追悔莫及。",
            "nextDialogs": [
              "710381606"
            ]
          },
          "710381606": {
            "id": "710381606",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "但我又能评判什么呢？唉…扎根在石缝里，长在岩间的琉璃袋，怎么去评价鸟儿的活法呢？",
            "nextDialogs": [
              "710381607"
            ]
          },
          "710381607": {
            "id": "710381607",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "但是，我怎么放心…咳咳，或许阻拦她终究是不对的…她已经是能照顾自己的大人了，是吧？",
            "nextDialogs": [
              "710381610"
            ]
          },
          "710381610": {
            "id": "710381610",
            "speakerId": 2616,
            "speakerName": "瑾武",
            "text": "是啊…希望如此，希望如此。"
          }
        }
      }
    },
    {
      "subId": "7103813",
      "subQuestName": "与瑾武对话",

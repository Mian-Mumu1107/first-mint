      }
    },
    {
      "subId": "7103815",
      "subQuestName": "与醒来的志琼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710380707"
        ],
        "dialogs": {
          "710380707": {
            "id": "710380707",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "是瑾武姐的手艺…？谢谢你们…请替我谢谢瑾武姐她们。",
            "nextDialogs": [
              "710380708"
            ]
          },
          "710380708": {
            "id": "710380708",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "没事的，我睡一觉就会好多了…",
            "nextDialogs": [
              "710380709"
            ]
          },
          "710380709": {
            "id": "710380709",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "实在对不起…咳咳…请你们过一阵子再回来吧…"
          }
        }
      }
    },
    {
      "subId": "7103604",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710360401"
        ],
        "dialogs": {
          "710360401": {
            "id": "710360401",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "你好，前辈！请找个地方坐坐吧。",
            "nextDialogs": [
              "710360402"
            ]
          },
          "710360402": {
            "id": "710360402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于冒险的事…",
            "nextDialogs": [
              "710360403"
            ]
          },
          "710360403": {
            "id": "710360403",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "你是想问，为什么我之前那么倔强，让大家如此费心吗？哈哈…我知道错啦，请不要再教训我了…",
            "nextDialogs": [
              "710360404"
            ]
          },
          "710360404": {
            "id": "710360404",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "不过话说回来，对「危险」的痴迷，或许是我们这些冒险家的本性吧。",
            "nextDialogs": [
              "710360405"
            ]
          },
          "710360405": {
            "id": "710360405",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "毕竟我们生来拥有坚韧的脊梁，轻捷的四肢…一想到身怀利器却安于无风无浪的一生，就总觉得不甘心呀。",
            "nextDialogs": [
              "710360406"
            ]
          },
          "710360406": {
            "id": "710360406",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "至于致命的风险，我也不是没有考虑过，但…嗯，我可以问你一个问题吗？",
            "nextDialogs": [
              "710360407"
            ]
          },
          "710360407": {
            "id": "710360407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请说吧。",
            "nextDialogs": [
              "710360408"
            ]
          },
          "710360408": {
            "id": "710360408",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "蒙德的大冒险家斯坦利因他横穿烬寂海的壮举而闻名…他在这场冒险中失去了自己的挚友。",
            "nextDialogs": [
              "710360409"
            ]
          },
          "710360409": {
            "id": "710360409",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "因为他的这场冒险，那位死去的挚友…尽管很少有人知道他的名字是什么，但关于他的记忆却在冒险家中间流传至今。",
            "nextDialogs": [
              "710360410"
            ]
          },
          "710360410": {
            "id": "710360410",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "我在想…哈哈，请前辈不要笑我幼稚。斯坦利那位再不归来的友人…会不会并未逝去，而是正在真正地「活着」呢？",
            "nextDialogs": [
              "710360412",
              "710360415",
              "710360419"
            ]
          },
          "710360412": {
            "id": "710360412",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "但为人所铭记这件事本身…即使事业令他早夭，不也是一种生命的延续吗？",
            "nextDialogs": [
              "710360413"
            ]
          },
          "710360413": {
            "id": "710360413",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "就这样借助他人的憧憬与纪念，评价与凝视…以另一种方式活在众人中间。",
            "nextDialogs": [
              "710360422"
            ]
          },
          "710360422": {
            "id": "710360422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请不要太过在意别人的看法。",
            "nextDialogs": [
              "710360423"
            ]
          },
          "710360423": {
            "id": "710360423",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "已经有很多人这样劝过我了，「做你自己就好」「管好自己的事情就行了」…表面上是开导人的话，终究只是劝人放弃。",
            "nextDialogs": [
              "710360424"
            ]
          },
          "710360424": {
            "id": "710360424",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "其实我之前就说过了，我的冒险，不是为了别人…甚至不是为了自己。",
            "nextDialogs": [
              "710360425"
            ]
          },
          "710360425": {
            "id": "710360425",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "嗯…你有这样想过吗，前辈…？",
            "nextDialogs": [
              "710360426"
            ]
          },
          "710360426": {
            "id": "710360426",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "这个世界是由众神摆布的…但我们作为凡人，即使没有神灵恩赐的「眼」，也同样拥有不甘于安宁与遗忘的执着。",
            "nextDialogs": [
              "710360427"
            ]
          },
          "710360427": {
            "id": "710360427",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "我相信这份不甘的心情并非毫无意义，所以才会不要命地跑去探索那些险地。毕竟呀…",
            "nextDialogs": [
              "710360428"
            ]
          },
          "710360428": {
            "id": "710360428",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "以弱小之身与纵使神灵也为之恐惧的永恒角力，这才是人之所以为「人」的理由…我是这样相信的。"
          },
          "710360415": {
            "id": "710360415",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "唔…我从没想过过一场「成功」的人生啦。相反，即使「失败」，只要能让众人都留下印象就好。",
            "nextDialogs": [
              "710360416"
            ]
          },
          "710360416": {
            "id": "710360416",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "至少有人会说：「志琼这个人，也是挑战过层岩巨渊的啊！」",
            "nextDialogs": [
              "710360417"
            ]
          },
          "710360417": {
            "id": "710360417",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "至少不会像那些牺牲在无人之地的前辈一样…至少不会像现在的我一样，被人遗忘。"
          },
          "710360419": {
            "id": "710360419",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "这样吗…？或许那是因为像前辈这样的外来人，无论在哪里出现都会自然而然地成为视线的焦点吧。",
            "nextDialogs": [
              "710360420"
            ]
          },
          "710360420": {
            "id": "710360420",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "就像含着金汤匙出生的孩子，也只会把贫穷当成一场并非必需的刺激冒险一样。",
            "nextDialogs": [
              "710360421"
            ]
          },
          "710360421": {
            "id": "710360421",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "啊，抱歉…我不是那个意思，我只是说…没什么。当我没有问吧。"
          }
        }
      }
    }
  ]
}
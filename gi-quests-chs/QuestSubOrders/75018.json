    {
      "subId": "7501806",
      "subQuestName": "追上「咕噜噜」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750180601"
        ],
        "dialogs": {
          "750180601": {
            "id": "750180601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "试试看吧。",
            "nextDialogs": [
              "750180602"
            ]
          },
          "750180602": {
            "id": "750180602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#那就拜托{REALNAME[ID(2)|SHOWHOST(true)]}再跑一趟了。",
            "nextDialogs": [
              "750180603"
            ]
          },
          "750180603": {
            "id": "750180603",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750180604"
            ]
          },
          "750180604": {
            "id": "750180604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它吃下去了！但是…",
            "nextDialogs": [
              "750180605"
            ]
          },
          "750180605": {
            "id": "750180605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不好！它怎么比之前更暴躁了？总之得让它先冷静下来…"
          }
        }
      }
    },
    {
      "subId": "7501807",
      "subQuestName": "喂「咕噜噜」吃药",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750180701"
        ],
        "dialogs": {
          "750180701": {
            "id": "750180701",
            "speakerId": 21685,
            "speakerName": "「咕噜噜」",
            "text": "嘎…",
            "nextDialogs": [
              "750180702"
            ]
          },
          "750180702": {
            "id": "750180702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，咕噜噜的伤势没痊愈，我有点担心…要不，我们也跟上去看一看吧。",
            "nextDialogs": [
              "750180706"
            ]
          },
          "750180706": {
            "id": "750180706",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "#赶到了{REALNAME[ID(2)|SHOWHOST(true)]}与咕噜噜的身边。",
            "nextDialogs": [
              "750180703"
            ]
          },
          "750180703": {
            "id": "750180703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它在这儿呢！呼…还好还好，看起来没有什么大碍——对了，我们现在就把药剂喂给它吧！",
            "nextDialogs": [
              "750180704"
            ]
          },
          "750180704": {
            "id": "750180704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "两种药剂，该给它哪种呢？"
          }
        }
      }
    },
    {
      "subId": "7501805",
      "subQuestName": "喂「咕噜噜」吃药",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750180403"
        ],
        "dialogs": {
          "750180403": {
            "id": "750180403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#要是它愿意吃的话，应该对恢复更有帮助吧？那就交给你啦，{REALNAME[ID(2)|SHOWHOST(true)]}！",
            "nextDialogs": [
              "750180405"
            ]
          },
          "750180405": {
            "id": "750180405",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750180406"
            ]
          },
          "750180406": {
            "id": "750180406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#看起来好像有希望？真不愧是{REALNAME[ID(2)|SHOWHOST(true)]}！欸？等一下…",
            "nextDialogs": [
              "750180407"
            ]
          },
          "750180407": {
            "id": "750180407",
            "speakerId": 21685,
            "speakerName": "「咕噜噜」",
            "text": "——嘎嘎嘎嘎嘎嘎！",
            "nextDialogs": [
              "750180408"
            ]
          },
          "750180408": {
            "id": "750180408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸欸？！难、难道是药效太好了吗？它怎么比之前还要暴躁？总之得让它先冷静下来…"
          }
        }
      }
    },
    {
      "subId": "7501813",
      "subQuestName": "喂「咕噜噜」吃药",
      "sceneId": null,
      "locations": [],

    {
      "subId": "7501801",
      "subQuestName": "(test)隐藏：靠近后流转到驱赶龙$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750180101"
        ],
        "dialogs": {
          "750180101": {
            "id": "750180101",
            "speakerId": 1000,
            "speakerName": "愤怒的绒翼龙",
            "text": "——嘎嘎嘎嘎嘎嘎！",
            "nextDialogs": [
              "750180102"
            ]
          },
          "750180102": {
            "id": "750180102",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "好孩子，别闹啦，不吃药的话身体怎么恢复…哎呀！",
            "nextDialogs": [
              "750180103"
            ]
          },
          "750180103": {
            "id": "750180103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#危险！{NICKNAME}，我们得去帮帮她！"
          }
        }
      }
    },
    {

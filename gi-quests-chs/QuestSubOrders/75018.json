      }
    },
    {
      "subId": "7501808",
      "subQuestName": "制服「咕噜噜」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7501809",
      "subQuestName": "制服「咕噜噜」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750180903"
        ],
        "dialogs": {
          "750180903": {
            "id": "750180903",
            "speakerId": 21685,
            "speakerName": "「咕噜噜」",
            "text": "呜…",
            "nextDialogs": [
              "750180901"
            ]
          },
          "750180901": {
            "id": "750180901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这真的是受伤还没痊愈的龙吗？",
            "nextDialogs": [
              "750180904"
            ]
          },
          "750180904": {
            "id": "750180904",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜…呀！呀呀！",
            "nextDialogs": [
              "750180902"
            ]
          },
          "750180902": {
            "id": "750180902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等它痊愈了，应该会是相当强劲的对手呢…不过现在还是趁它没那么闹腾了，赶紧带它回去找玛兹嘉小姐吧！"
          }
        }
      }
    },
    {
      "subId": "7501810",
      "subQuestName": "与玛兹嘉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750181001"
        ],
        "dialogs": {
          "750181001": {
            "id": "750181001",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀呀！",
            "nextDialogs": [
              "750181002"
            ]
          },
          "750181002": {
            "id": "750181002",
            "speakerId": 21634,
            "speakerName": "玛兹嘉",
            "text": "你们回来了！怎么样？咕噜噜愿意吃药了吗？",
            "nextDialogs": [
              "750181003"
            ]
          },
          "750181003": {
            "id": "750181003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吃是吃了，但是…",
            "nextDialogs": [
              "750181004"
            ]
          },
          "750181004": {
            "id": "750181004",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "简要说明了刚才的情况…",
            "nextDialogs": [
              "750181017"
            ]
          },
          "750181017": {
            "id": "750181017",
            "speakerId": 21634,
            "speakerName": "玛兹嘉",
            "text": "原来是这样…那我检查一下吧！唔——没事，应该没有什么大碍。",
            "nextDialogs": [
              "750181005"
            ]
          },
          "750181005": {
            "id": "750181005",
            "speakerId": 21634,
            "speakerName": "玛兹嘉",
            "text": "不管怎么说，它愿意吃药了就是好事！而且也知道了它的反应，之后可以更有针对性地调整配方了。",
            "nextDialogs": [
              "750181006"
            ]
          },
          "750181006": {
            "id": "750181006",
            "speakerId": 21634,
            "speakerName": "玛兹嘉",
            "text": "#嗯，肯定没问题的。真是多谢你们了，特别是{REALNAME[ID(2)|SHOWHOST(true)]}，真是了不起的小嵴锋龙！",
            "nextDialogs": [
              "750181007"
            ]
          },
          "750181007": {
            "id": "750181007",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀呀！",
            "nextDialogs": [
              "750181008"
            ]
          },
          "750181008": {
            "id": "750181008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嘿嘿，听别人夸{REALNAME[ID(2)|SHOWHOST(true)]}，感觉比自己被夸更高兴呢！",
            "nextDialogs": [
              "750181009"
            ]
          },
          "750181009": {
            "id": "750181009",
            "speakerId": 21634,
            "speakerName": "玛兹嘉",
            "text": "能和小嵴锋龙这样默契的两位也很了不起！我也得向你们学习才行呀。",
            "nextDialogs": [
              "750181012"
            ]
          },
          "750181012": {
            "id": "750181012",
            "speakerId": 21634,
            "speakerName": "玛兹嘉",
            "text": "虽然想说有什么我能帮到你们或者为你们做的…",
            "nextDialogs": [
              "750181013"
            ]
          },
          "750181013": {
            "id": "750181013",
            "speakerId": 21634,
            "speakerName": "玛兹嘉",
            "text": "但还是祝你们健健康康，最好永远也不需要找我帮忙吧！",
            "nextDialogs": [
              "750181014"
            ]
          },
          "750181014": {
            "id": "750181014",
            "speakerId": 21634,
            "speakerName": "玛兹嘉",
            "text": "啊，不过如果你们只是想来和我聊聊天，随时欢迎你们。",
            "nextDialogs": [
              "750181015"
            ]
          },
          "750181015": {
            "id": "750181015",

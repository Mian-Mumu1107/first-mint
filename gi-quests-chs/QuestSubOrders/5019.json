            "id": "50191901",
            "speakerId": 14184,
            "speakerName": "妮乌",
            "text": "那个古板怪阿姨呢？好像有段时间没见到她了。",
            "nextDialogs": [
              "50191902"
            ]
          },
          "50191902": {
            "id": "50191902",
            "speakerId": 14207,
            "speakerName": "阿纳",
            "text": "好耶！终于没人管我们了，去丢石子玩吧！",
            "nextDialogs": [
              "50191903"
            ]
          },
          "50191903": {
            "id": "50191903",
            "speakerId": 14184,
            "speakerName": "妮乌",
            "text": "……",
            "nextDialogs": [

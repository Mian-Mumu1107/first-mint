            ]
          },
          "50191905": {
            "id": "50191905",
            "speakerId": 14184,
            "speakerName": "妮乌",
            "text": "仔细想想，丢石子也没什么好玩的。阿伽娅阿姨什么时候回来啊？我有点想她了。",
            "nextDialogs": [
              "50191906"
            ]
          },
          "50191906": {
            "id": "50191906",
            "speakerId": 14207,
            "speakerName": "阿纳",
            "text": "大人们说她去了很远的地方，所以大概要很久才会回来吧？"
          }
        }

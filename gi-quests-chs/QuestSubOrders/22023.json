  "subQuests": [
    {
      "subId": "2202301",
      "subQuestName": "与汤雯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220230101"
        ],
        "dialogs": {
          "220230101": {
            "id": "220230101",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "唔…要是能吃到璃月菜就好了…",
            "nextDialogs": [
              "220230102"
            ]
          },
          "220230102": {
            "id": "220230102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么了？",
            "nextDialogs": [
              "220230103"
            ]
          },
          "220230103": {
            "id": "220230103",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "你是？这身打扮…你就是旅行者吧。抱歉，我就是有点想家了…",
            "nextDialogs": [
              "220230118",
              "220230106"
            ]
          },
          "220230118": {
            "id": "220230118",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "欸？莫非...你会做璃月菜吗？那太好了！",
            "nextDialogs": [
              "220230119"
            ]
          },
          "220230119": {
            "id": "220230119",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "那、那就请你快点帮帮我，做点正宗的璃月菜给我吧！",
            "nextDialogs": [
              "220230120"
            ]
          },
          "220230120": {
            "id": "220230120",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "让我想想...我现在的最想吃的就是…",
            "nextDialogs": [
              "220230121"
            ]
          },
          "220230121": {
            "id": "220230121",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "嗯！我想要吃肉！大口吃肉！",
            "nextDialogs": [
              "220230122"
            ]
          },
          "220230122": {
            "id": "220230122",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "那种细腻的质感，还有那肉脂与璃月特色佐料混合在一起，散发而出的绝顶香气…",
            "nextDialogs": [
              "220230123"
            ]
          },
          "220230123": {
            "id": "220230123",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "一想起这样的肉，我就情不自禁地颤抖起来…",
            "nextDialogs": [
              "220230124"
            ]
          },
          "220230124": {
            "id": "220230124",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "所以，我想吃肉！请帮我准备一份由肉烧制的璃月菜吧！"
          },
          "220230106": {
            "id": "220230106",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "先自我介绍一下，我叫汤雯，是来自璃月的历史学者，之前正在实地调研稻妻的特色风俗与民话。",
            "nextDialogs": [
              "220230107"
            ]
          },
          "220230107": {
            "id": "220230107",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "本来资料已经搜集的差不多了，正准备返回璃月。但是因为稻妻的锁国令结被迫滞留在这里，已经有一段时间了…",
            "nextDialogs": [
              "220230108"
            ]
          },
          "220230108": {
            "id": "220230108",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "其实，我觉得这对我来说也算是好事。因为我感觉，此刻的稻妻正处于一个历史性的时刻！",
            "nextDialogs": [
              "220230109"
            ]
          },
          "220230109": {
            "id": "220230109",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "我很确信，这段特殊的时期，必然会在提瓦特的史册上留下浓墨重彩的一笔。",
            "nextDialogs": [
              "220230110"
            ]
          },
          "220230110": {
            "id": "220230110",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "亲眼见证这样的历史，然后真实、完整、清晰地将这一切记录成册，留给后人，就是历史学者所要做的事情。",
            "nextDialogs": [
              "220230111"
            ]
          },
          "220230111": {
            "id": "220230111",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "不过…虽然这样的事业很让我振奋，但它可没法满足我的肚子…",
            "nextDialogs": [
              "220230112"
            ]
          },
          "220230112": {
            "id": "220230112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是饿了吗？",
            "nextDialogs": [
              "220230113"
            ]
          },
          "220230113": {
            "id": "220230113",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "也不能说…是饿啦…哈哈哈，稻妻的食物都还挺好吃的。",
            "nextDialogs": [
              "220230114"
            ]
          },
          "220230114": {
            "id": "220230114",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "我特别喜欢这边的「天妇罗」，虽然感觉…就是裹上面衣炸一切啦…",
            "nextDialogs": [
              "220230115"
            ]
          },
          "220230115": {
            "id": "220230115",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "但是吃久了稻妻菜，我还是想要再吃点璃月菜。不过，我一直都找不到能做出正宗璃月菜的餐馆。",
            "nextDialogs": [
              "220230116"
            ]
          },
          "220230116": {
            "id": "220230116",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "我前几天都狠下心来，去冒险家协会挂了一道「烹饪委托」，但到现在也没回音…",
            "nextDialogs": [
              "220230117"
            ]
          },
          "220230117": {
            "id": "220230117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我可以试试吗？"
          }
        }
      }
    },
    {
      "subId": "2202307",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220230801"
        ],
        "dialogs": {
          "220230801": {
            "id": "220230801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以说，要准备哪一道由肉烧制的菜呢？不如我们替她挑选一下。",
            "nextDialogs": [
              "220230802"
            ]
          },
          "220230802": {
            "id": "220230802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我想想...我最近喜欢的肉菜有...",
            "nextDialogs": [
              "220230803"
            ]
          },
          "220230803": {
            "id": "220230803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "璃月特色的摩拉肉！",
            "nextDialogs": [
              "220230804"
            ]
          },
          "220230804": {
            "id": "220230804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咸香微辣的干锅腊肉！",
            "nextDialogs": [
              "220230805"
            ]
          },
          "220230805": {
            "id": "220230805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有用独特的冷鲜肉做成的稠汁蔬菜炖肉！",
            "nextDialogs": [
              "220230806"
            ]
          },
          "220230806": {
            "id": "220230806",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这都是你爱吃的吧？",
            "nextDialogs": [
              "220230807"
            ]
          },
          "220230807": {
            "id": "220230807",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，没问题的，你就相信我的品味吧，快来选一样~",
            "nextDialogs": [
              "220230809",
              "220230811",
              "220230813",
              "220230815"
            ]
          },
          "220230809": {
            "id": "220230809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来很棒！我们就赶紧做一份摩拉肉给汤雯小姐吧！"
          },
          "220230811": {
            "id": "220230811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶！我们就赶紧做一份干锅腊肉给汤雯小姐吧！"
          },
          "220230813": {
            "id": "220230813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真不错！我们就赶紧做一份稠汁蔬菜炖肉给汤雯小姐吧！"
          },
          "220230815": {
            "id": "220230815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯~想好了就赶紧做给汤雯小姐吧！"
          }
        }
      }
    },
    {
      "subId": "2202302",
      "subQuestName": "将准备好的菜品带给汤雯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220230201"
        ],
        "dialogs": {
          "220230201": {
            "id": "220230201",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "这么快就回来了？你不会是个隐藏身份的大厨吧？",
            "nextDialogs": [
              "220230202"
            ]
          },
          "220230202": {
            "id": "220230202",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "嗯...我都快要等不及了，请让我尝一尝！",
            "nextDialogs": [
              "220230205"
            ]
          },
          "220230205": {
            "id": "220230205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…是摩拉肉，干锅腊肉，还有稠汁蔬菜炖肉！",
            "nextDialogs": [
              "220230206"
            ]
          },
          "220230206": {
            "id": "220230206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "决定好就交给汤雯小姐吧!"
          }
        }
      }
    },
    {
      "subId": "2202303",
      "subQuestName": "将准备好的菜品带给汤雯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220230301"
        ],
        "dialogs": {
          "220230301": {
            "id": "220230301",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "啊！没错！这、这就是我梦寐以求的家乡味道啊…真是…呜呜…真是令人感动…",
            "nextDialogs": [
              "220230302"
            ]
          },
          "220230302": {
            "id": "220230302",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "谢谢你！有了这些好吃的，我也能提起劲了。",
            "nextDialogs": [
              "220230303"
            ]
          },
          "220230303": {
            "id": "220230303",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "这些送给你，祝你往后的旅程顺遂无忧！"
          }
        }
      }
    },
    {
      "subId": "2202304",
      "subQuestName": "将准备好的菜品带给汤雯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220230501"
        ],
        "dialogs": {
          "220230501": {
            "id": "220230501",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "唔，这种味道…好、好像不是璃月的菜，也不是稻妻的菜，味道还真是新鲜…",
            "nextDialogs": [
              "220230502"
            ]
          },
          "220230502": {
            "id": "220230502",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "虽然不是我想要吃的那一道，但能够尝到这种新鲜的菜品，我也已经很满足了。",
            "nextDialogs": [
              "220230503"
            ]
          },
          "220230503": {
            "id": "220230503",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "谢谢啦，旅行者，这些东西给你，请收下吧。"
          }
        }
      }
    },
    {
      "subId": "2202305",
      "subQuestName": "将准备好的菜品带给汤雯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220230601"
        ],
        "dialogs": {
          "220230601": {
            "id": "220230601",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "欸？这、这应该还是稻妻的菜吧…",
            "nextDialogs": [
              "220230602"
            ]
          },
          "220230602": {
            "id": "220230602",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "我记得我要的好像不是这道菜来着…唔，算了，这道菜也能填饱肚子就是了…",
            "nextDialogs": [
              "220230603"
            ]
          },
          "220230603": {
            "id": "220230603",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "还是谢谢你了，旅行者，这些东西请收下吧。"
          }
        }
      }
    },
    {
      "subId": "2202306",
      "subQuestName": "将准备好的菜品带给汤雯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220230701"
        ],
        "dialogs": {
          "220230701": {
            "id": "220230701",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "咦？这、这道菜的味道怎么…这么…这么微妙。",
            "nextDialogs": [
              "220230702"
            ]
          },
          "220230702": {
            "id": "220230702",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "也不能说是微妙…应该是说…奇异，还是什么的…",
            "nextDialogs": [
              "220230703"
            ]
          },
          "220230703": {
            "id": "220230703",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "居然能做出这样的菜，你的厨艺还真是…另辟蹊径呢…",
            "nextDialogs": [
              "220230704"
            ]
          },
          "220230704": {
            "id": "220230704",
            "speakerId": 3022,
            "speakerName": "汤雯",
            "text": "辛苦你了！旅行者，这些东西请收下吧，这道菜我稍后…稍后再细细品尝…"
          }
        }
      }
    },

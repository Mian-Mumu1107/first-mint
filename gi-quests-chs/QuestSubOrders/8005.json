    {
      "subId": "800508",
      "subQuestName": "继续探索遗迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80050801"
        ],
        "dialogs": {
          "80050801": {
            "id": "80050801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这边也有黑蛇骑士！",
            "nextDialogs": [
              "80050802"
            ]
          },
          "80050802": {
            "id": "80050802",
            "speakerId": 12429,
            "speakerName": "往日的黑蛇骑士",
            "text": "「——————！！！」",
            "nextDialogs": [
              "80050803"
            ]
          },
          "80050803": {
            "id": "80050803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们没有直接冲过来，是在威胁我们吗？",
            "nextDialogs": [
              "80050804"
            ]
          },
          "80050804": {
            "id": "80050804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些黑蛇骑士似乎把什么围在了身后…",
            "nextDialogs": [
              "80050805"
            ]
          },
          "80050805": {
            "id": "80050805",
            "speakerId": 12429,
            "speakerName": "往日的黑蛇骑士",
            "text": "「——————！！！」",
            "nextDialogs": [
              "80050806"
            ]
          },
          "80050806": {
            "id": "80050806",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "等一下，他们好像…",
            "nextDialogs": [
              "80050807"
            ]
          },
          "80050807": {
            "id": "80050807",
            "speakerId": 12429,
            "speakerName": "往日的黑蛇骑士",
            "text": "「——————！！！」",
            "nextDialogs": [
              "80050808"
            ]
          },
          "80050808": {
            "id": "80050808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊，他们冲过来了，快应战！"
          }
        }
      }
    },
    {
      "subId": "800509",
      "subQuestName": "击败黑蛇骑士",

  "subQuests": [
    {
      "subId": "800501",
      "subQuestName": "前往调查遗迹，寻找路线",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80050101"
        ],
        "dialogs": {
          "80050101": {
            "id": "80050101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这边有一些丘丘人生活的痕迹，会是委托里涉及到的那些丘丘人吗？",
            "nextDialogs": [
              "80050102"
            ]
          },
          "80050102": {
            "id": "80050102",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "委托？说起来，你们还没告诉我…为何你们会出现在这里，一般的旅行者可没理由涉足层岩巨渊之下。",
            "nextDialogs": [
              "80050103"
            ]
          },
          "80050103": {
            "id": "80050103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们是接到冒险家协会的委托，来调查层岩巨渊内丘丘人反常聚集的事件的。",
            "nextDialogs": [
              "80050104"
            ]
          },
          "80050104": {
            "id": "80050104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一路下来，终于在这里发现了线索…",
            "nextDialogs": [
              "80050105"
            ]
          },
          "80050105": {
            "id": "80050105",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "你们想要答案？",
            "nextDialogs": [
              "80050106"
            ]
          },
          "80050106": {
            "id": "80050106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？戴因知道些什么吗？",
            "nextDialogs": [
              "80050107"
            ]
          },
          "80050107": {
            "id": "80050107",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "碰巧知道。",
            "nextDialogs": [
              "80050110"
            ]
          },
          "80050110": {
            "id": "80050110",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "你们无法察觉异样也情有可原。此地的怪异，其实在于…",
            "nextDialogs": [
              "80050111"
            ]
          },
          "80050111": {
            "id": "80050111",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "…这里的环境正在削弱「诅咒」的效果。",
            "nextDialogs": [
              "80050112"
            ]
          },
          "80050112": {
            "id": "80050112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "诅咒！我记得之前说过，戴因作为坎瑞亚的国民，身中不死诅咒什么的…",
            "nextDialogs": [
              "80050113"
            ]
          },
          "80050113": {
            "id": "80050113",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "几百年来，诅咒带来的苦痛依旧每天都在纠缠我。而来到此地，身体却感觉得到了片刻的喘息。",
            "nextDialogs": [
              "80050114"
            ]
          },
          "80050114": {
            "id": "80050114",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "此时此刻，我的身体也正在向我表达着强烈的意愿，那就是——「留下来」。",
            "nextDialogs": [
              "80050115"
            ]
          },
          "80050115": {
            "id": "80050115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "削弱诅咒…这里为什么会有这样神奇的效果呢？",
            "nextDialogs": [
              "80050116"
            ]
          },
          "80050116": {
            "id": "80050116",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "这也是我想要查明的，不过据我所知，深渊教团还尚未拥有实现类似效果的技术。"
          }
        }
      }
    },
    {
      "subId": "800502",
      "subQuestName": "击败黑蛇骑士",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "800503",
      "subQuestName": "与戴因斯雷布对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80050301"
        ],
        "dialogs": {
          "80050301": {
            "id": "80050301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚才那些是…为什么忽然袭击我们？",
            "nextDialogs": [
              "80050302"
            ]
          },
          "80050302": {
            "id": "80050302",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "「黑蛇骑士」，曾隶属于坎瑞亚宫廷卫队。",
            "nextDialogs": [
              "80050303"
            ]
          },
          "80050303": {
            "id": "80050303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等！宫廷卫队…他们曾经是你的下属吗！？",
            "nextDialogs": [
              "80050304"
            ]
          },
          "80050304": {
            "id": "80050304",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "曾经是。可如今他们身上那强烈的诅咒气息，还有舍弃了所有荣耀的战斗方式…",
            "nextDialogs": [
              "80050305"
            ]
          },
          "80050305": {
            "id": "80050305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…已经是深渊的爪牙了吗？",
            "nextDialogs": [
              "80050306"
            ]
          },
          "80050306": {
            "id": "80050306",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "…先前进吧。",
            "nextDialogs": [
              "80050307"
            ]
          },
          "80050307": {
            "id": "80050307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，戴因…",
            "nextDialogs": [
              "80050308"
            ]
          },
          "80050308": {
            "id": "80050308",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "嗯？",
            "nextDialogs": [
              "80050309"
            ]
          },
          "80050309": {
            "id": "80050309",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "80050310"
            ]
          },
          "80050310": {
            "id": "80050310",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "漏了一个么…",
            "nextDialogs": [
              "80050311"
            ]
          },
          "80050311": {
            "id": "80050311",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "80050312"
            ]
          },
          "80050312": {
            "id": "80050312",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "等等，你们先退后，他似乎有所不同…",
            "nextDialogs": [
              "80050313"
            ]
          },
          "80050313": {
            "id": "80050313",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "…消失了。",
            "nextDialogs": [
              "80050314"
            ]
          },
          "80050314": {
            "id": "80050314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么回事，那个黑蛇骑士！难道是有话想说吗？",
            "nextDialogs": [
              "80050315"
            ]
          },
          "80050315": {
            "id": "80050315",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "（怎么会…没有「那个东西」的话，如何能在五百年间保持自我意识…）",
            "nextDialogs": [
              "80050316"
            ]
          },
          "80050316": {
            "id": "80050316",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "（还有令人在意的，莫名熟悉的气息…）",
            "nextDialogs": [
              "80050317"
            ]
          },
          "80050317": {
            "id": "80050317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许他认出了你。",
            "nextDialogs": [
              "80050318"
            ]
          },
          "80050318": {
            "id": "80050318",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "如此绝望的灾变之中，本不应该诞生这种奇迹才对…就当是巧合吧。",
            "nextDialogs": [
              "80050319"
            ]
          },
          "80050319": {
            "id": "80050319",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "我们继续前进，往那座「城市」的方向。"
          }
        }
      }
    },
    {
      "subId": "800504",
      "subQuestName": "前往遗迹入口处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80050401"
        ],
        "dialogs": {
          "80050401": {
            "id": "80050401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像有股奇怪的力量包围着这座城市，没法继续前进了。",
            "nextDialogs": [
              "80050402"
            ]
          },
          "80050402": {
            "id": "80050402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "按理说，附近应该有什么机关之类的？旅行者，拿出我们以前探索遗迹的本领吧？",
            "nextDialogs": [
              "80050405"
            ]
          },
          "80050405": {
            "id": "80050405",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "不必浪费时间。",
            "nextDialogs": [
              "80050406"
            ]
          },
          "80050406": {
            "id": "80050406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！？",
            "nextDialogs": [
              "80050407"
            ]
          },
          "80050407": {
            "id": "80050407",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "坎瑞亚的技术，深渊力量的气息…再熟悉不过了。这些事物在我眼里，不过是虚幻的泡沫。",
            "nextDialogs": [
              "80050408"
            ]
          },
          "80050408": {
            "id": "80050408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我明白了！果然，深渊教团是想隐藏什么秘密吧？",
            "nextDialogs": [
              "80050409"
            ]
          },
          "80050409": {
            "id": "80050409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…戴因这家伙刚才表现得那么了解内情，难怪会被深渊教团针对呢。"
          }
        }
      }
    },
    {
      "subId": "800520",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80052001"
        ],
        "dialogs": {
          "80052001": {
            "id": "80052001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不是什么深渊教团的秘密，被守护着的…竟然只是一些快要迎来终结的丘丘人。",
            "nextDialogs": [
              "80052002"
            ]
          },
          "80052002": {
            "id": "80052002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还是不要打搅它们了吧。"
          }
        }
      }
    },
    {
      "subId": "800505",
      "subQuestName": "前往遗迹中有光亮的房间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80050501"
        ],
        "dialogs": {
          "80050501": {
            "id": "80050501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呀，黑蛇骑士！",
            "nextDialogs": [
              "80050502"
            ]
          },
          "80050502": {
            "id": "80050502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里是他们的老窝吗？还是说，他们在守护什么东西…",
            "nextDialogs": [
              "80050503"
            ]
          },
          "80050503": {
            "id": "80050503",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "或许，深渊教团想隐藏的秘密就在这附近。先击败他们吧。"
          }
        }
      }
    },
    {
      "subId": "800506",

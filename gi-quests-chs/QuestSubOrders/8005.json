        "dialogs": {
          "80051401": {
            "id": "80051401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，这个房间没有门阻挡，看来终于可以前往中间的那个房间了。",
            "nextDialogs": [
              "80051402"
            ]
          },
          "80051402": {
            "id": "80051402",
            "speakerId": 1005,

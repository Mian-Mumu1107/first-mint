    {
      "subId": "800510",
      "subQuestName": "调查黑蛇骑士守护的东西",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80051001"
        ],
        "dialogs": {
          "80051001": {
            "id": "80051001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！这、这是…",
            "nextDialogs": [
              "80051002"
            ]
          },
          "80051002": {
            "id": "80051002",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "…果然，这些黑蛇骑士与深渊教团的秘密无关。哼…我早该猜到的。",
            "nextDialogs": [
              "80051003"
            ]
          },
          "80051003": {
            "id": "80051003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些丘丘人究竟是怎么回事？",
            "nextDialogs": [
              "80051004"
            ]
          },
          "80051004": {
            "id": "80051004",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "如我先前所说，这就是丘丘人的「结局」。",
            "nextDialogs": [
              "80051007"
            ]
          },
          "80051007": {
            "id": "80051007",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "变得老化、畏光，甚至与黑暗逐渐融为一体。即便如此，诅咒依旧继续侵蚀着它们。",
            "nextDialogs": [
              "80051008"
            ]
          },
          "80051008": {
            "id": "80051008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是为什么，这些黑蛇骑士会那样守护着它们呢…",
            "nextDialogs": [
              "80051009"
            ]
          },
          "80051009": {
            "id": "80051009",
            "speakerId": 12429,
            "speakerName": "往日的黑蛇骑士",
            "text": "「——————！！！」",
            "nextDialogs": [
              "80051010"
            ]
          },
          "80051010": {
            "id": "80051010",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！黑蛇骑士们又围上来了！",
            "nextDialogs": [
              "80051011"
            ]
          },
          "80051011": {
            "id": "80051011",
            "speakerId": 12429,
            "speakerName": "往日的黑蛇骑士",
            "text": "「——————！！！」"
          }
        }
      }
    },

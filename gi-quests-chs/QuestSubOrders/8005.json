      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80051501"
        ],
        "dialogs": {
          "80051501": {
            "id": "80051501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快看头顶上，居然有个水池！",
            "nextDialogs": [
              "80051502"
            ]
          },
          "80051502": {
            "id": "80051502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "连池水都是倒置的，还真是奇景。",
            "nextDialogs": [
              "80051503"
            ]
          },
          "80051503": {
            "id": "80051503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你知道这个水池是怎么回事吗，戴因？",
            "nextDialogs": [
              "80051504"
            ]
          },
          "80051504": {
            "id": "80051504",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "水池似乎和整座城市是一体的，想必也是古文明的遗留物。",
            "nextDialogs": [
              "80051505"
            ]
          },
          "80051505": {
            "id": "80051505",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "关键在于…我认为，削弱诅咒的效果便是来自于它。",
            "nextDialogs": [
              "80051506"
            ]
          },
          "80051506": {
            "id": "80051506",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "身处此地，躯体便会感觉到前所未有的宁静。感觉比之前更强烈了，我想多半是因为那池水有着类似「净化」的效果。",
            "nextDialogs": [
              "80051507"
            ]
          },
          "80051507": {
            "id": "80051507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「净化」？那会不会…那个水池里的水可以彻底将诅咒净化掉呢？",
            "nextDialogs": [
              "80051508"
            ]
          },
          "80051508": {
            "id": "80051508",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "不可能。",
            "nextDialogs": [
              "80051509"
            ]
          },
          "80051509": {
            "id": "80051509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么肯定？",
            "nextDialogs": [
              "80051510"
            ]
          },
          "80051510": {
            "id": "80051510",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "我保持着清醒与诅咒共存至今，已有五百年。没人比我更清楚有关诅咒的事。",
            "nextDialogs": [
              "80051511"
            ]
          },
          "80051511": {
            "id": "80051511",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "它是这个世界的因果级别的烙印，神明的诅咒甚至从位格上高于人类本身。",
            "nextDialogs": [
              "80051512"
            ]
          },
          "80051512": {
            "id": "80051512",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "我能感觉到，诅咒正在不断渗透我的一切，成为我的一部分，甚至逐渐「取代」我。",
            "nextDialogs": [
              "80051513"
            ]
          },
          "80051513": {
            "id": "80051513",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "有限地抑制诅咒侵蚀或许还有可能，至于净化…",
            "nextDialogs": [
              "80051514"
            ]
          },
          "80051514": {
            "id": "80051514",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "你就想象成直接焚毁掉身体的某一部分好了。在那之前，你甚至无法保住性命。",
            "nextDialogs": [
              "80051515"
            ]
          },
          "80051515": {
            "id": "80051515",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？！那不就要一命呜呼了吗！怎么会这样…无法净化的诅咒…",
            "nextDialogs": [
              "80051516"
            ]
          },
          "80051516": {
            "id": "80051516",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "从这里感受到的池水，其净化效力还差得很远。只能勉强起到一些抑制诅咒的作用。",
            "nextDialogs": [
              "80051517"
            ]
          },
          "80051517": {
            "id": "80051517",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那下面这个装置又是什么呢？好像跟周围有些格格不入…",
            "nextDialogs": [
              "80051520"
            ]
          },
          "80051520": {
            "id": "80051520",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "坦白说，我也没见过这种构造的装置。你认为是深渊教团放置的，不无道理。莫非，他们是在做什么准备…",
            "nextDialogs": [
              "80051521"
            ]
          },
          "80051521": {
            "id": "80051521",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "（咔啦咔啦…）",
            "nextDialogs": [
              "80051522"
            ]
          },
          "80051522": {
            "id": "80051522",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！吓我一跳，周围那些大门都被打开了？",
            "nextDialogs": [
              "80051523"
            ]
          },
          "80051523": {
            "id": "80051523",
            "speakerId": 12424,
            "speakerName": "哈夫丹",
            "text": "……",
            "nextDialogs": [
              "80051524"
            ]
          },
          "80051524": {
            "id": "80051524",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呀，是那个叫哈夫丹的骑士…",
            "nextDialogs": [
              "80051525"
            ]
          },
          "80051525": {
            "id": "80051525",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "你有话要对我说吗？哈夫丹。",
            "nextDialogs": [
              "80051526"
            ]
          },
          "80051526": {
            "id": "80051526",
            "speakerId": 12424,
            "speakerName": "哈夫丹",
            "text": "……",
            "nextDialogs": [
              "80051527"
            ]
          },
          "80051527": {
            "id": "80051527",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他走了…可这次不是突然消失的！",
            "nextDialogs": [
              "80051528"
            ]
          },
          "80051528": {
            "id": "80051528",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "是在示意我们跟随他。如何，你们要来么？"
          }
        }
      }
    },
    {
      "subId": "800515",
      "subQuestName": "前往遗迹顶层中心的房间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "800521",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80052101"
        ],
        "dialogs": {
          "80052101": {
            "id": "80052101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又是这些丘丘人，似乎被保护得很好的样子。"
          }
        }
      }
    },
    {
      "subId": "800522",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80052201"
        ],
        "dialogs": {
          "80052201": {
            "id": "80052201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "默默等待着自己消失的丘丘人们…希望它们可以如愿。"
          }
        }
      }
    },
    {
      "subId": "800523",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80052301"
        ],
        "dialogs": {
          "80052301": {
            "id": "80052301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么一想，从没见过如此老实的丘丘人呢，是因为灵魂真的已经老去了吗？"
          }
        }
      }
    },
    {
      "subId": "800599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80059901"
        ],
        "dialogs": {
          "80059901": {
            "id": "80059901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总算击败他们了！快去看看那些黑蛇骑士在守护的到底是什么秘密吧！",
            "nextDialogs": [
              "80059903"
            ]
          },
          "80059903": {
            "id": "80059903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "戴因…怎么不说话？",
            "nextDialogs": [
              "80059904"
            ]
          },
          "80059904": {
            "id": "80059904",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "没什么，在想一些事而已。是想安慰我吗？那大可不必。",
            "nextDialogs": [
              "80059905"
            ]
          },
          "80059905": {
            "id": "80059905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼！好吧…",
            "nextDialogs": [
              "80059906"
            ]
          },
          "80059906": {
            "id": "80059906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "前面的藤蔓，好像可以爬上去的样子，试试看吧？",
            "nextDialogs": [
              "80059907"
            ]
          },
          "80059907": {
            "id": "80059907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈夫丹是从这边跳下去了吧，我们也下去看看？"
          }
        }
      }
    }
  ]
}
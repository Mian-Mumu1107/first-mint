  "subQuests": [
    {
      "subId": "802008",
      "subQuestName": "回到维摩庄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80200101"
        ],
        "dialogs": {
          "80200101": {
            "id": "80200101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "等等，那个身影是…戴因斯雷布！",
            "nextDialogs": [
              "80200102"
            ]
          },
          "80200102": {
            "id": "80200102",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "哦？是你们…",
            "nextDialogs": [
              "80200103"
            ]
          },
          "80200103": {
            "id": "80200103",
            "speakerId": 1002,
            "speakerName": "阿托莎",
            "text": "是你们的朋友吗？",
            "nextDialogs": [
              "80200104"
            ]
          },
          "80200104": {
            "id": "80200104",
            "speakerId": 1002,
            "speakerName": "阿托莎",
            "text": "那我先到村子里面确认一下村长爷爷他们的情况，回头见吧。",
            "nextDialogs": [
              "80200105"
            ]
          },
          "80200105": {
            "id": "80200105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "回头见，阿托莎。",
            "nextDialogs": [
              "80200106"
            ]
          },
          "80200106": {
            "id": "80200106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你这神出鬼没的家伙，每次都要像这样突然出现吓我们一跳才行嘛？",
            "nextDialogs": [
              "80200107"
            ]
          },
          "80200107": {
            "id": "80200107",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "只要你们也在追迹「深渊」，那我们的路线总会交汇，与我个人的意志无关。",
            "nextDialogs": [
              "80200108"
            ]
          },
          "80200108": {
            "id": "80200108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那这么说，你是追着深渊教团来到这里的吗？而且看你刚刚还解决掉了一批深渊魔物…",
            "nextDialogs": [
              "80200109"
            ]
          },
          "80200109": {
            "id": "80200109",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "当然。嗯？莫非你们不是？",
            "nextDialogs": [
              "80200112"
            ]
          },
          "80200112": {
            "id": "80200112",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "不管怎样，就算再怎么迟钝，现在你也应该发现这个地方有蹊跷了吧。",
            "nextDialogs": [
              "80200113"
            ]
          },
          "80200113": {
            "id": "80200113",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "深渊教团一定是在这附近筹备着些什么，或者更进一步…正在进行着什么计划。",
            "nextDialogs": [
              "80200114"
            ]
          },
          "80200114": {
            "id": "80200114",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "所以你觉得，附近丘丘人的躁动是深渊教团干的吗？",
            "nextDialogs": [
              "80200115"
            ]
          },
          "80200115": {
            "id": "80200115",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "事到如今，引发丘丘人骚动这种小事想必肯定不是他们的目的，最多应该是某些计划的「副产物」罢了。",
            "nextDialogs": [
              "80200116"
            ]
          },
          "80200116": {
            "id": "80200116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，这件事对维摩庄的影响还是存在的，我们最好先留下来保护这里一阵子比较好吧？",
            "nextDialogs": [
              "80200117"
            ]
          },
          "80200117": {
            "id": "80200117",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "保护之余，更重要的是弄清楚深渊教团准备在这里搞什么名堂，这才是防止进一步悲剧的关键。"
          }
        }
      }
    },
    {
      "subId": "802009",
      "subQuestName": "与戴因斯雷布对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80200122"
        ],
        "dialogs": {
          "80200122": {
            "id": "80200122",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你们针对现状，再次向维摩庄的村民们收集了线索，直到天色暗了下来…",
            "nextDialogs": [
              "80200123"
            ]
          },
          "80200123": {
            "id": "80200123",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "原来你们是接到了那样的委托，才来到这里的么…",
            "nextDialogs": [
              "80200124"
            ]
          },
          "80200124": {
            "id": "80200124",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "「似乎只存在于记忆中的人」…的确令人在意，我也并不认为这会是一起普通的失踪案，但还不能确定与深渊教团的联系。",
            "nextDialogs": [
              "80200125"
            ]
          },
          "80200125": {
            "id": "80200125",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "除此之外，就只有丘丘人的躁动这种浮于表面的线索了，还是没什么收获。",
            "nextDialogs": [
              "80200128"
            ]
          },
          "80200128": {
            "id": "80200128",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#就是{NICKNAME}血亲的记忆里，那个神秘的声音，好像是什么…「罪人」，他到底是谁？",
            "nextDialogs": [
              "80200129"
            ]
          },
          "80200129": {
            "id": "80200129",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "……",
            "nextDialogs": [
              "80200130"
            ]
          },
          "80200130": {
            "id": "80200130",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "#{NICKNAME}，你会认为…你的血亲「背叛」了你么？"
          }
        }
      }
    },
    {
      "subId": "802002",
      "subQuestName": "与戴因斯雷布对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80200201"
        ],
        "dialogs": {
          "80200201": {
            "id": "80200201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸，戴因？喂…戴因！你在这里发什么呆呀？",
            "nextDialogs": [
              "80200202"
            ]
          },
          "80200202": {
            "id": "80200202",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "……",
            "nextDialogs": [
              "80200203"
            ]
          },
          "80200203": {
            "id": "80200203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是遇到什么事了吗？",
            "nextDialogs": [
              "80200204"
            ]
          },
          "80200204": {
            "id": "80200204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了，戴因？",
            "nextDialogs": [
              "80200205"
            ]
          },
          "80200205": {
            "id": "80200205",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "#{NICKNAME}，你们说的那个失踪者…是个什么样的人？",
            "nextDialogs": [
              "80200206"
            ]
          },
          "80200206": {
            "id": "80200206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？",
            "nextDialogs": [
              "80200207"
            ]
          },
          "80200207": {
            "id": "80200207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "大概二十岁出头的男青年吧，到底怎么了呀，戴因…",
            "nextDialogs": [
              "80200208"
            ]
          },
          "80200208": {
            "id": "80200208",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "现在我的脑海里似乎凭空多了一些东西…",
            "nextDialogs": [
              "80200209"
            ]
          },
          "80200209": {
            "id": "80200209",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "…是一段有关他的「记忆」。",
            "nextDialogs": [
              "80200210"
            ]
          },
          "80200210": {
            "id": "80200210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "什么…？会不会…会不会是我们昨天聊了太多有关他的事，所以你昨晚做了一个这样的梦？",
            "nextDialogs": [
              "80200211"
            ]
          },
          "80200211": {
            "id": "80200211",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "不，那不是梦，是今早我醒来以后忽然出现在脑海中的一段记忆…",
            "nextDialogs": [
              "80200212"
            ]
          },
          "80200212": {
            "id": "80200212",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "而且我很确定，我从未见过这个人。",
            "nextDialogs": [
              "80200213"
            ]
          },
          "80200213": {
            "id": "80200213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那「记忆」的内容是什么呢？",
            "nextDialogs": [
              "80200214"
            ]
          },
          "80200214": {
            "id": "80200214",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "我记得，在那段回忆里…",
            "nextDialogs": [
              "80200215"
            ]
          },
          "80200215": {
            "id": "80200215",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "…我把「世界上第一颗耕地机的眼睛」送给了他。",
            "nextDialogs": [
              "80200216"
            ]
          },
          "80200216": {
            "id": "80200216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "！？",
            "nextDialogs": [
              "80200217"
            ]
          },
          "80200217": {
            "id": "80200217",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊！？",
            "nextDialogs": [
              "80200218"
            ]
          },
          "80200218": {
            "id": "80200218",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…所以现在可以确定，那个失踪者与深渊教团有关联了吧？",
            "nextDialogs": [
              "80200219"
            ]
          },
          "80200219": {
            "id": "80200219",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "嗯，而且那个家伙，应该拥有往人们的脑海中「投放」记忆的能力。",
            "nextDialogs": [
              "80200220"
            ]
          },
          "80200220": {
            "id": "80200220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "究竟是如何做到的…",
            "nextDialogs": [
              "80200221"
            ]
          },
          "80200221": {
            "id": "80200221",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那要是这么说的话，维摩庄的大家会不会也只是被投放了虚假的记忆？原本大家应该不认识他…",
            "nextDialogs": [
              "80200222"
            ]
          },
          "80200222": {
            "id": "80200222",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可这样做的目的又是什么呢…",
            "nextDialogs": [
              "80200223"
            ]
          },
          "80200223": {
            "id": "80200223",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "今早的这件事，对深渊教团来说，其实也暴露了一个事实。",
            "nextDialogs": [
              "80200224"
            ]
          },
          "80200224": {
            "id": "80200224",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "暴露了什么？",
            "nextDialogs": [
              "80200225"
            ]
          },
          "80200225": {
            "id": "80200225",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "他们的目标…依旧是「世界上第一颗耕地机的眼睛」，并没有把寻找它的事情抛在脑后。",
            "nextDialogs": [
              "80200226"
            ]
          },
          "80200226": {
            "id": "80200226",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "给我投放这样的一段记忆，想必是为了扰乱唯一知道「眼睛」下落的我的思维…",
            "nextDialogs": [
              "80200229"
            ]
          },
          "80200229": {
            "id": "80200229",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "你的担忧并不是没有道理，尽管我认为深渊教团应该还没有能力让那段记忆变成现实…",
            "nextDialogs": [
              "80200230"
            ]
          },
          "80200230": {
            "id": "80200230",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "但考虑到他们对「眼睛」的执着程度，我们也应该拿出对等程度的谨慎才稳妥。",
            "nextDialogs": [
              "80200231"
            ]
          },
          "80200231": {
            "id": "80200231",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "和我一起去确认一下吧，「眼睛」是否还在我们手中。",
            "nextDialogs": [
              "80200232"
            ]
          },
          "80200232": {
            "id": "80200232",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是要到你藏「眼睛」的地方去吗？",
            "nextDialogs": [
              "80200233"
            ]
          },
          "80200233": {
            "id": "80200233",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（…可是，如果我们就这样过去的话，万一被跟踪，岂不是反而暴露了隐藏位置？）",
            "nextDialogs": [
              "80200234"
            ]
          },
          "80200234": {
            "id": "80200234",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（也或许，这原本就是深渊教团投放那段记忆给戴因的目的？引起他的疑心，让他产生再次确认的想法…）",
            "nextDialogs": [
              "80200235"
            ]
          },
          "80200235": {
            "id": "80200235",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "……",
            "nextDialogs": [
              "80200236"
            ]
          },
          "80200236": {
            "id": "80200236",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（根据我对戴因的了解，他不可能没意识到这一点…看他的样子，应该是有别的想法…）"
          }
        }
      }
    },
    {
      "subId": "802003",
      "subQuestName": "前往藏匿「耕地机的眼睛」的地方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80200301"
        ],
        "dialogs": {
          "80200301": {
            "id": "80200301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来是在这里吗？荒郊野岭，的确不是容易被发现的地方。",
            "nextDialogs": [
              "80200302"
            ]
          },
          "80200302": {
            "id": "80200302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那我们赶快去确认一下吧！",
            "nextDialogs": [
              "80200303"
            ]
          },
          "80200303": {
            "id": "80200303",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "#等等，{NICKNAME}…",
            "nextDialogs": [
              "80200304"
            ]
          },
          "80200304": {
            "id": "80200304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯？",
            "nextDialogs": [
              "80200305"
            ]
          },
          "80200305": {
            "id": "80200305",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "……",
            "nextDialogs": [
              "80200306"
            ]
          },
          "80200306": {
            "id": "80200306",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "…事不宜迟，我们赶快进去。",
            "nextDialogs": [
              "80200307"
            ]
          },
          "80200307": {
            "id": "80200307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（刚刚戴因想要和我说什么…？）",
            "nextDialogs": [
              "80200308"
            ]
          },
          "80200308": {
            "id": "80200308",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂，等等我！"
          }
        }
      }
    },

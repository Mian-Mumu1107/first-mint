    {
      "subId": "802006",
      "subQuestName": "与戴因斯雷布对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80200601"
        ],
        "dialogs": {
          "80200601": {
            "id": "80200601",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "和我预想得一样，「虚假的记忆」果然是个陷阱，深渊教团真的跟着我们来到了这里…",
            "nextDialogs": [
              "80200602"
            ]
          },
          "80200602": {
            "id": "80200602",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "这样一来，也就有机会见到…",
            "nextDialogs": [
              "80200603"
            ]
          },
          "80200603": {
            "id": "80200603",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "唔…！",
            "nextDialogs": [
              "80200604"
            ]
          },
          "80200604": {
            "id": "80200604",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "戴因？你突然怎么了…",
            "nextDialogs": [
              "80200605"
            ]
          },
          "80200605": {
            "id": "80200605",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "感受到了么？是地脉的扰动，深渊教团又在捣什么鬼…",
            "nextDialogs": [
              "80200606"
            ]
          },
          "80200606": {
            "id": "80200606",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你的体质还真是敏感，我好像没什么感觉…",
            "nextDialogs": [
              "80200607"
            ]
          },
          "80200607": {
            "id": "80200607",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "#{NICKNAME}，你们先用那边的机关离开吧，按我说的做。",
            "nextDialogs": [
              "80200608"
            ]
          },
          "80200608": {
            "id": "80200608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "留你一个人在这里，真的没关系吗？",
            "nextDialogs": [
              "80200609"
            ]
          },
          "80200609": {
            "id": "80200609",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "深渊教团正在行动，现在回维摩庄的话，或许有机会抓到那个「失踪者」。",
            "nextDialogs": [
              "80200610"
            ]
          },
          "80200610": {
            "id": "80200610",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "…也可以当做是兵分两路。",
            "nextDialogs": [
              "80200611"
            ]
          },
          "80200611": {
            "id": "80200611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯。",
            "nextDialogs": [
              "80200612"
            ]
          },
          "80200612": {
            "id": "80200612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（道理应该是这样没错…）",
            "nextDialogs": [
              "80200613"
            ]
          },
          "80200613": {
            "id": "80200613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（但总觉得好像哪里有些「违和」…是我漏掉了什么事情吗？）",
            "nextDialogs": [
              "80200614"
            ]
          },
          "80200614": {
            "id": "80200614",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "哼…我就知道，除非主动踏入你们的陷阱，不然你是不可能来面见我的。",
            "nextDialogs": [
              "80200615"
            ]
          },
          "80200615": {
            "id": "80200615",
            "speakerId": 1005,
            "speakerName": "Sibling",
            "text": "你将自己与「耕地机的眼睛」都作为赌注…",
            "nextDialogs": [
              "80200616"
            ]
          },
          "80200616": {
            "id": "80200616",
            "speakerId": 1005,
            "speakerName": "Sibling",
            "text": "赌注如此之大，禁不住诱惑而踏入陷阱的，应该是我才对吧，「末光之剑」戴因斯雷布？",
            "nextDialogs": [
              "80200617"
            ]
          },
          "80200617": {
            "id": "80200617",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "你一个人来的？你的那些信徒们呢，怎么没带在身边？",
            "nextDialogs": [
              "80200618"
            ]
          },
          "80200618": {
            "id": "80200618",
            "speakerId": 1005,
            "speakerName": "Sibling",
            "text": "在有所防备的「末光之剑」面前，投入多少兵力都是一种无谓的浪费，还不如由我一人来直面你。",
            "nextDialogs": [
              "80200619"
            ]
          },
          "80200619": {
            "id": "80200619",
            "speakerId": 1005,
            "speakerName": "Sibling",
            "text": "我知道你有很多话想说…",
            "nextDialogs": [
              "80200620"
            ]
          },
          "80200620": {
            "id": "80200620",
            "speakerId": 1005,
            "speakerName": "Sibling",
            "text": "…但在那之前，先击败我，如何？"
          }
        }
      }
    },

    {
      "subId": "802010",
      "subQuestName": "进入遗迹深处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80200501"
        ],
        "dialogs": {
          "80200501": {
            "id": "80200501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "到这里就是尽头了吧…",
            "nextDialogs": [
              "80200502"
            ]
          },
          "80200502": {
            "id": "80200502",
            "speakerId": 1001,
            "speakerName": "戴因斯雷布",
            "text": "当心，是「深渊」的气息！",
            "nextDialogs": [
              "80200503"
            ]
          },
          "80200503": {
            "id": "80200503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "深渊教团的家伙，他们真的来了！"
          }
        }
      }
    },
    {
      "subId": "802005",

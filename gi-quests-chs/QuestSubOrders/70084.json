            "speakerId": 17062,
            "speakerName": "贵宾室的守卫",
            "text": "抱歉，这里是贵宾休息室…并非普通前来观礼的宾客可进入…",
            "nextDialogs": [
              "700840204"
            ]
          },
          "700840204": {
            "id": "700840204",
            "speakerId": 17062,
            "speakerName": "贵宾室的守卫",
            "text": "如果没有<color=#00E1FFFF>贵宾的凭证</color>的话，您是无法进入此处的。",
            "nextDialogs": [
              "700840202"
            ]
          },
          "700840202": {
            "id": "700840202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "出示「贵宾的凭证」…",
            "nextDialogs": [

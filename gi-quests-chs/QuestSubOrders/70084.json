          "700840203": {
            "id": "700840203",
            "speakerId": 17062,
            "speakerName": "贵宾室的守卫",
            "text": "啊…这确实是…奇怪，这凭证有发放过给人类吗？",
            "nextDialogs": [
              "700840205"
            ]
          },
          "700840205": {
            "id": "700840205",
            "speakerId": 17062,
            "speakerName": "贵宾室的守卫",
            "text": "#不过我的工作只是负责核实和守卫，请进吧，这位{M#先生}{F#小姐}。",
            "nextDialogs": [
              "700840206"
            ]
          },
          "700840206": {
            "id": "700840206",
            "speakerId": 17062,
            "speakerName": "贵宾室的守卫",
            "text": "如果有什么需要，还请咨询贵宾休息室内的侍者。"
          }
        }
      }

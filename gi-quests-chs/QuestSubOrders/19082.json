        "startDialogs": [
          "1908201410"
        ],
        "dialogs": {
          "1908201410": {
            "id": "1908201410",
            "speakerId": 1000,
            "speakerName": "<UNKNOWN>",
            "text": "怎么和璃月的同伴合作，说不定也会考到呢。",
            "nextDialogs": [

    {
      "subId": "1300303",
      "subQuestName": "到禅那园见提纳里",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130030301"
        ],
        "dialogs": {
          "130030301": {
            "id": "130030301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "提纳里——",
            "nextDialogs": [
              "130030302"
            ]
          },
          "130030302": {
            "id": "130030302",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "嘘，小声点。",
            "nextDialogs": [
              "130030303"
            ]
          },
          "130030303": {
            "id": "130030303",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "芫花，瑞香科瑞香属，有明显抗惊厥作用，可做麻醉粉使用…",
            "nextDialogs": [
              "130030304"
            ]
          },
          "130030304": {
            "id": "130030304",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "从两组实验数据来看，对鱼类的毒性尤其大…认真记录。",
            "nextDialogs": [
              "130030305"
            ]
          },
          "130030305": {
            "id": "130030305",
            "speakerId": 12603,
            "speakerName": "卡卡塔",
            "text": "咕噜！",
            "nextDialogs": [
              "130030306"
            ]
          },
          "130030306": {
            "id": "130030306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "卡卡塔？！",
            "nextDialogs": [
              "130030307"
            ]
          },
          "130030307": {
            "id": "130030307",
            "speakerId": 12603,
            "speakerName": "卡卡塔",
            "text": "咕噜！咕噜！",
            "nextDialogs": [
              "130030308"
            ]
          },
          "130030308": {
            "id": "130030308",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "不是说了要你们小声点，虽然植物不怕吵，但声音震得我耳朵嗡嗡响。",
            "nextDialogs": [
              "130030309"
            ]
          },
          "130030309": {
            "id": "130030309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你，你没有拆掉卡卡塔吗？",
            "nextDialogs": [
              "130030310"
            ]
          },
          "130030310": {
            "id": "130030310",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "我拆它干什么？",
            "nextDialogs": [
              "130030311"
            ]
          },
          "130030311": {
            "id": "130030311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是你不是说，「按照教令院的规矩」…",
            "nextDialogs": [
              "130030312"
            ]
          },
          "130030312": {
            "id": "130030312",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "原来你们一大早过来搅得我不得安生，是为了这个啊。好吧，也怪我昨天没说清楚。",
            "nextDialogs": [
              "130030313"
            ]
          },
          "130030313": {
            "id": "130030313",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "我的意思是，按照教令院的规矩，所有研究成果都要被销毁，所以不能让教令院发现那里。",
            "nextDialogs": [
              "130030314"
            ]
          },
          "130030314": {
            "id": "130030314",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "提纳里留在那里其实是…",
            "nextDialogs": [
              "130030315"
            ]
          },
          "130030315": {
            "id": "130030315",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "总之先把卡卡塔修好了。以前在教令院的时候选修过素论派的课，没想到有朝一日还能派上用场。",
            "nextDialogs": [
              "130030316"
            ]
          },
          "130030316": {
            "id": "130030316",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "然后我跟它一起安葬了阿巴图伊。至于那些实验资料我整理了一下，一部分带出来留作纪念，大部分焚烧后深埋，清理掉证据。",
            "nextDialogs": [
              "130030317"
            ]
          },
          "130030317": {
            "id": "130030317",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "我又不在教令院，那些规矩关我什么事？恰恰相反，现在我是道成林的巡林官，我有义务保护好林中的生命。",
            "nextDialogs": [
              "130030318"
            ]
          },
          "130030318": {
            "id": "130030318",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "任何生命诞生在世上都有意义，它也不例外。既然存在，就不该被随意抛弃或销毁。",
            "nextDialogs": [
              "130030319"
            ]
          },
          "130030319": {
            "id": "130030319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿！太好啦！",
            "nextDialogs": [
              "130030320"
            ]
          },
          "130030320": {
            "id": "130030320",
            "speakerId": 12603,
            "speakerName": "卡卡塔",
            "text": "咕噜噜？",
            "nextDialogs": [
              "130030321"
            ]
          },
          "130030321": {
            "id": "130030321",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，提纳里刚刚说「任何生命」，难道你已经认可卡卡塔是「真正的生命」了吗？",
            "nextDialogs": [
              "130030322"
            ]
          },
          "130030322": {
            "id": "130030322",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "只是有这个可能性而已，毕竟它尝试「修复」阿巴图伊的事很难解释。",
            "nextDialogs": [
              "130030323"
            ]
          },
          "130030323": {
            "id": "130030323",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "但阿巴图伊留下的实验记录也只是一小部分，谁也不知道他到底设置了多少指令。",
            "nextDialogs": [
              "130030324"
            ]
          },
          "130030324": {
            "id": "130030324",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "也许只是指令之间的冲突，导致卡卡塔做出了这样的举动。",
            "nextDialogs": [
              "130030325"
            ]
          },
          "130030325": {
            "id": "130030325",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "从严谨的角度，无法得出「卡卡塔是真正的生命」这个结论。但既然存在这样的可能性，我就愿意去相信。",
            "nextDialogs": [
              "130030326"
            ]
          },
          "130030326": {
            "id": "130030326",
            "speakerId": 12603,
            "speakerName": "卡卡塔",
            "text": "咕噜！",
            "nextDialogs": [
              "130030327"
            ]
          },
          "130030327": {
            "id": "130030327",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "顺带一提，我对继续研究这个课题没什么兴趣，让它呆在这里，只是因为这里比较隐蔽。",
            "nextDialogs": [
              "130030328"
            ]
          },
          "130030328": {
            "id": "130030328",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "不过目前来看，把它当做实验助手似乎也不错，至少实验记录可以让它来完成。",
            "nextDialogs": [
              "130030329"
            ]
          },
          "130030329": {
            "id": "130030329",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "你觉得呢？",
            "nextDialogs": [
              "130030330"
            ]
          },
          "130030330": {
            "id": "130030330",
            "speakerId": 12603,
            "speakerName": "卡卡塔",
            "text": "咕噜！咕噜！"
          }
        }
      }
    },

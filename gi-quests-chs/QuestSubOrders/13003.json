  "subQuests": [
    {
      "subId": "1300301",
      "subQuestName": "与须弥凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130030101"
        ],
        "dialogs": {
          "130030101": {
            "id": "130030101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…总之，污染区其实就是森林深处的地脉发生了泄漏，现在已经恢复正常了。",
            "nextDialogs": [
              "130030102"
            ]
          },
          "130030102": {
            "id": "130030102",
            "speakerId": 4019,
            "speakerName": "凯瑟琳",
            "text": "原来是这样，真是辛苦你们了。",
            "nextDialogs": [
              "130030103"
            ]
          },
          "130030103": {
            "id": "130030103",
            "speakerId": 4019,
            "speakerName": "凯瑟琳",
            "text": "等空气中残留的地脉能量散去，应该就可以对外张贴公告，让居民可以像以前一样自由出入了。",
            "nextDialogs": [
              "130030104"
            ]
          },
          "130030104": {
            "id": "130030104",
            "speakerId": 4019,
            "speakerName": "凯瑟琳",
            "text": "这是说好的奖励，两位请收好。",
            "nextDialogs": [
              "130030105"
            ]
          },
          "130030105": {
            "id": "130030105",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "从冒险家协会出来后，被派蒙带到了一个安静的地方…",
            "nextDialogs": [
              "130030106"
            ]
          },
          "130030106": {
            "id": "130030106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "卡卡塔…要被送回教令院了吗？",
            "nextDialogs": [
              "130030107"
            ]
          },
          "130030107": {
            "id": "130030107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然它已经损坏了，可一想到它要被拆掉，我还是觉得有点难过。",
            "nextDialogs": [
              "130030108"
            ]
          },
          "130030108": {
            "id": "130030108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也有一点。",
            "nextDialogs": [
              "130030109"
            ]
          },
          "130030109": {
            "id": "130030109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那！要不明天我们一起去找提纳里求求情？",
            "nextDialogs": [
              "130030110"
            ]
          },
          "130030110": {
            "id": "130030110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然很想现在就去，但提纳里说了「有什么事明天再说」，我们现在去找他反而会惹他生气吧？",
            "nextDialogs": [
              "130030111"
            ]
          },
          "130030111": {
            "id": "130030111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好像确实是这样。",
            "nextDialogs": [
              "130030112"
            ]
          },
          "130030112": {
            "id": "130030112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那就说好啦！明天我们一起去找提纳里，让他不要拆掉卡卡塔！"
          }
        }
      }
    },
    {
      "subId": "1300302",

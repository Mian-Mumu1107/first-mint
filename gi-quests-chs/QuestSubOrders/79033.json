    {
      "subId": "7903301",
      "subQuestName": "监听是否获取海螺1号$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790330101"
        ],
        "dialogs": {
          "790330101": {
            "id": "790330101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，影像居然正好放在舞台的中间…",
            "nextDialogs": [
              "790330102"
            ]
          },
          "790330102": {
            "id": "790330102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这两个人在干嘛呢…看上去就像是一个人在说什么，另一个人坐在地上…",
            "nextDialogs": [
              "790330103"
            ]
          },
          "790330103": {
            "id": "790330103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我知道了，这个一定是在讲故事的画面！他们一定是快要睡觉了，所以影像里她正在为坐在地上的人讲睡前故事…",
            "nextDialogs": [
              "790330104"
            ]
          },
          "790330104": {
            "id": "790330104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "愚人众也要听睡前故事吗…",
            "nextDialogs": [
              "790330105"
            ]
          },
          "790330105": {
            "id": "790330105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说不定愚人众里也有人有这种需要的嘛。",
            "nextDialogs": [
              "790330106"
            ]
          },
          "790330106": {
            "id": "790330106",
            "speakerId": 1001,
            "speakerName": "岩使游击兵的影像",
            "text": "阿加霞，佩尔西科夫大人让我们去做信号接收测试，是让我们四个一起去…叶夫卡要是听到这件事，又得生气不可…",
            "nextDialogs": [
              "790330107"
            ]
          },
          "790330107": {
            "id": "790330107",
            "speakerId": 1002,
            "speakerName": "藏镜仕女的影像",
            "text": "雅科夫，不会的，这是上面大人的命令，叶夫卡肯定也不会责怪你的…",
            "nextDialogs": [
              "790330108"
            ]
          },
          "790330108": {
            "id": "790330108",
            "speakerId": 1002,
            "speakerName": "藏镜仕女的影像",
            "text": "唉，你要是真这么害怕，我陪你去跟叶夫卡说。",
            "nextDialogs": [
              "790330109"
            ]
          },
          "790330109": {
            "id": "790330109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么嘛，原来不是在讲故事呀…",
            "nextDialogs": [
              "790330110"
            ]
          },
          "790330110": {
            "id": "790330110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过这段对话没头没尾的，根本什么都看不出来嘛…"
          }
        }
      }
    },
    {
      "subId": "7903302",
      "subQuestName": "监听是否获取海螺2号$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790330201"
        ],
        "dialogs": {
          "790330201": {
            "id": "790330201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "海螺居然能够从井中浮起来…",
            "nextDialogs": [
              "790330204"
            ]
          },
          "790330204": {
            "id": "790330204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯，真是奇妙…啊，影像显示出来了，{NICKNAME}，你快看，那里有个弯腰的…哇！",
            "nextDialogs": [
              "790330205"
            ]
          },
          "790330205": {
            "id": "790330205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你不要动，你的身后…"
          }
        }
      }
    },
    {
      "subId": "7903303",
      "subQuestName": "监听是否获取海螺2号$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790330301"
        ],
        "dialogs": {
          "790330301": {
            "id": "790330301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，看上去像是两个人躺在地上呢…是在看天上的星星？",
            "nextDialogs": [
              "790330302"
            ]
          },
          "790330302": {
            "id": "790330302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总觉得是有点奇怪的影像呢…",
            "nextDialogs": [
              "790330303"
            ]
          },
          "790330303": {
            "id": "790330303",
            "speakerId": 1003,
            "speakerName": "水铳重卫士的影像",
            "text": "雅科夫，长官说了你些什么，你这么垂头丧气的。",
            "nextDialogs": [
              "790330304"
            ]
          },
          "790330304": {
            "id": "790330304",
            "speakerId": 1001,
            "speakerName": "岩使游击兵的影像",
            "text": "因为海浪颠簸，搬运仪器的时候摔了一跤，幸好我手快，仪器没事…",
            "nextDialogs": [
              "790330305"
            ]
          },
          "790330305": {
            "id": "790330305",
            "speakerId": 1001,
            "speakerName": "岩使游击兵的影像",
            "text": "但是长官还是训话说，要让我们小队去各个岛上做装置的信号接收测试，那可是最辛苦的任务…",
            "nextDialogs": [
              "790330306"
            ]
          },
          "790330306": {
            "id": "790330306",
            "speakerId": 1003,
            "speakerName": "水铳重卫士的影像",
            "text": "没关系，不必这么伤心，咱们什么累活没干过啊。别伤心啦，先吃点东西吧！",
            "nextDialogs": [
              "790330307"
            ]
          },
          "790330307": {
            "id": "790330307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们指着那么高的地方，是想要吃什么啊…",
            "nextDialogs": [
              "790330308"
            ]
          },
          "790330308": {
            "id": "790330308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道这个海螺…放歪了？"
          }
        }
      }
    }
  ]
}
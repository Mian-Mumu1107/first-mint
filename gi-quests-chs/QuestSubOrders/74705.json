  "subQuests": [
    {
      "subId": "7470501",
      "subQuestName": "前往水族箱附近…",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747050101"
        ],
        "dialogs": {
          "747050101": {
            "id": "747050101",
            "speakerId": 1000,
            "speakerName": "夏沃蕾",
            "text": "…我觉得是这条。",
            "nextDialogs": [
              "747050102"
            ]
          },
          "747050102": {
            "id": "747050102",
            "speakerId": 1001,
            "speakerName": "芙宁娜",
            "text": "有道理。",
            "nextDialogs": [
              "747050103"
            ]
          },
          "747050103": {
            "id": "747050103",
            "speakerId": 1002,
            "speakerName": "千织",
            "text": "为什么？",
            "nextDialogs": [
              "747050104"
            ]
          },
          "747050104": {
            "id": "747050104",
            "speakerId": 1000,
            "speakerName": "夏沃蕾",
            "text": "看看这尾摆的颜色，整个水族箱里没有比它更时髦的了。",
            "nextDialogs": [
              "747050105"
            ]
          },
          "747050105": {
            "id": "747050105",
            "speakerId": 1002,
            "speakerName": "千织",
            "text": "虽然颜色艳了点，但好吧，就当你是在夸我。",
            "nextDialogs": [
              "747050106"
            ]
          },
          "747050106": {
            "id": "747050106",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "哇！好多人呀！大家都是来逛水族馆的吗？",
            "nextDialogs": [
              "747050107"
            ]
          },
          "747050107": {
            "id": "747050107",
            "speakerId": 1001,
            "speakerName": "芙宁娜",
            "text": "嗯，刚拍完一个镜头，趁休息时间来欣赏一下。",
            "nextDialogs": [
              "747050108"
            ]
          },
          "747050108": {
            "id": "747050108",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "你们刚刚在聊什么？",
            "nextDialogs": [
              "747050109"
            ]
          },
          "747050109": {
            "id": "747050109",
            "speakerId": 1000,
            "speakerName": "夏沃蕾",
            "text": "哪条鱼和千织比较像。",
            "nextDialogs": [
              "747050110"
            ]
          },
          "747050110": {
            "id": "747050110",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "怎么你们也…？！",
            "nextDialogs": [
              "747050111"
            ]
          },
          "747050111": {
            "id": "747050111",
            "speakerId": 1001,
            "speakerName": "芙宁娜",
            "text": "啊…哈哈，好像是聊天时听哥伦比娅小姐提到类似的话题，觉得很有趣，我们不知不觉就也这么玩上了。",
            "nextDialogs": [
              "747050112"
            ]
          },
          "747050112": {
            "id": "747050112",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "原来这东西还能传染的…",
            "nextDialogs": [
              "747050113"
            ]
          },
          "747050113": {
            "id": "747050113",
            "speakerId": 1002,
            "speakerName": "千织",
            "text": "哦！那条像你，夏沃蕾。",
            "nextDialogs": [
              "747050114"
            ]
          },
          "747050114": {
            "id": "747050114",
            "speakerId": 1000,
            "speakerName": "夏沃蕾",
            "text": "怎么说？",
            "nextDialogs": [
              "747050115"
            ]
          },
          "747050115": {
            "id": "747050115",
            "speakerId": 1002,
            "speakerName": "千织",
            "text": "一闲下来就绕着水缸游圈，在锻炼呢。",
            "nextDialogs": [
              "747050116"
            ]
          },
          "747050116": {
            "id": "747050116",
            "speakerId": 1000,
            "speakerName": "夏沃蕾",
            "text": "…我在你心里就这形象吗？"
          }
        }
      }
    }
  ]
}
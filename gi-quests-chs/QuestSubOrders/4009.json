  "subQuests": [
    {
      "subId": "400901",
      "subQuestName": "前往「公爵」办公室",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090101"
        ],
        "dialogs": {
          "40090101": {
            "id": "40090101",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "林尼…呃，对不起…",
            "nextDialogs": [
              "40090102"
            ]
          },
          "40090102": {
            "id": "40090102",
            "speakerId": 1001,
            "speakerName": "琳妮特",
            "text": "我也很抱歉，哥哥。我应该更谨慎一些。",
            "nextDialogs": [
              "40090103"
            ]
          },
          "40090103": {
            "id": "40090103",
            "speakerId": 1002,
            "speakerName": "林尼",
            "text": "别说这种话。都是我的错…该谨慎的人是我。你们差点就…",
            "nextDialogs": [
              "40090104"
            ]
          },
          "40090104": {
            "id": "40090104",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "如果我实力更强一点，也许现在已经找到「公子」大人了…",
            "nextDialogs": [
              "40090105"
            ]
          },
          "40090105": {
            "id": "40090105",
            "speakerId": 1002,
            "speakerName": "林尼",
            "text": "不对，你怎么能这么说？",
            "nextDialogs": [
              "40090106"
            ]
          },
          "40090106": {
            "id": "40090106",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "欸？",
            "nextDialogs": [
              "40090107"
            ]
          },
          "40090107": {
            "id": "40090107",
            "speakerId": 1002,
            "speakerName": "林尼",
            "text": "…抱歉…",
            "nextDialogs": [
              "40090108"
            ]
          },
          "40090108": {
            "id": "40090108",
            "speakerId": 1001,
            "speakerName": "琳妮特",
            "text": "也就是说，我们都不够谨慎，对吗？共同责任。",
            "nextDialogs": [
              "40090109"
            ]
          },
          "40090109": {
            "id": "40090109",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "啊，对！共同责任！",
            "nextDialogs": [
              "40090110"
            ]
          },
          "40090110": {
            "id": "40090110",
            "speakerId": 1002,
            "speakerName": "林尼",
            "text": "……",
            "nextDialogs": [
              "40090111"
            ]
          },
          "40090111": {
            "id": "40090111",
            "speakerId": 1001,
            "speakerName": "琳妮特",
            "text": "哥哥，你担心我们，我们也担心现在的你。不要露出这种表情…请你打起精神来。",
            "nextDialogs": [
              "40090112"
            ]
          },
          "40090112": {
            "id": "40090112",
            "speakerId": 1002,
            "speakerName": "林尼",
            "text": "…嗯。"
          }
        }
      }
    },
    {
      "subId": "400902",
      "subQuestName": "与莱欧斯利对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090201"
        ],
        "dialogs": {
          "40090201": {
            "id": "40090201",
            "speakerId": 1003,
            "speakerName": "希格雯",
            "text": "打扰了哟。",
            "nextDialogs": [
              "40090202"
            ]
          },
          "40090202": {
            "id": "40090202",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "看来菲米尼先生情况稳定下来了。",
            "nextDialogs": [
              "40090203"
            ]
          },
          "40090203": {
            "id": "40090203",
            "speakerId": 1003,
            "speakerName": "希格雯",
            "text": "当然，否则我不会离开医务室的。",
            "nextDialogs": [
              "40090204"
            ]
          },
          "40090204": {
            "id": "40090204",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "那两位过来很正常，但护士长是有何贵干？",
            "nextDialogs": [
              "40090205"
            ]
          },
          "40090205": {
            "id": "40090205",
            "speakerId": 1003,
            "speakerName": "希格雯",
            "text": "我来看看克洛琳德小姐。你感觉还好吗？",
            "nextDialogs": [
              "40090206"
            ]
          },
          "40090206": {
            "id": "40090206",
            "speakerId": 1005,
            "speakerName": "克洛琳德",
            "text": "嗯，没什么问题。",
            "nextDialogs": [
              "40090207"
            ]
          },
          "40090207": {
            "id": "40090207",
            "speakerId": 1003,
            "speakerName": "希格雯",
            "text": "可以的话，我想帮你再做个检查，很快的，请给我几分钟。",
            "nextDialogs": [
              "40090208"
            ]
          },
          "40090208": {
            "id": "40090208",
            "speakerId": 1005,
            "speakerName": "克洛琳德",
            "text": "好吧，谢谢。那我就先告辞了。",
            "nextDialogs": [
              "40090209"
            ]
          },
          "40090209": {
            "id": "40090209",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "该向我们解释了吧？",
            "nextDialogs": [
              "40090210"
            ]
          },
          "40090210": {
            "id": "40090210",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "哈哈，解释，我不太喜欢这个说法。「说明」如何？",
            "nextDialogs": [
              "40090211"
            ]
          },
          "40090211": {
            "id": "40090211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "愿闻其详。",
            "nextDialogs": [
              "40090212"
            ]
          },
          "40090212": {
            "id": "40090212",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "不过要从哪里说起呢？烦请你们提问吧，从最想知道答案的问题开始好了。",
            "nextDialogs": [
              "40090213"
            ]
          },
          "40090213": {
            "id": "40090213",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "唔…那我问了哦，你从一开始就知道林尼他们的目的吗？",
            "nextDialogs": [
              "40090214"
            ]
          },
          "40090214": {
            "id": "40090214",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "不，我只知道他们隶属愚人众，受「仆人」命令进入梅洛彼得堡，具体目的嘛，随着你们行动推进才查清。",
            "nextDialogs": [
              "40090215"
            ]
          },
          "40090215": {
            "id": "40090215",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "都不知道目的，却能仔细地防着他们？",
            "nextDialogs": [
              "40090216"
            ]
          },
          "40090216": {
            "id": "40090216",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "他们来意不善，我很擅长分辨这类信号。",
            "nextDialogs": [
              "40090217"
            ]
          },
          "40090217": {
            "id": "40090217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么不阻止他们的行动？",
            "nextDialogs": [
              "40090218"
            ]
          },
          "40090218": {
            "id": "40090218",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "一开始，我认为他们的目的是查清「公子」为什么失踪。",
            "nextDialogs": [
              "40090219"
            ]
          },
          "40090219": {
            "id": "40090219",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "林尼猜测是我故意放走他，实际上，我们并没有特意阻拦或是纵容他的行为。他只是就那样自然地找到帮手，自然地离开了。",
            "nextDialogs": [
              "40090220"
            ]
          },
          "40090220": {
            "id": "40090220",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "至冬执行官在枫丹境内失踪，这件事肯定会被「仆人」拿来大做文章。",
            "nextDialogs": [
              "40090221"
            ]
          },
          "40090221": {
            "id": "40090221",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "我也有点好奇这位执行官去了哪里，反正一样要查，就让愚人众自己的人来查吧。我只等结果。",
            "nextDialogs": [
              "40090222"
            ]
          },
          "40090222": {
            "id": "40090222",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "你想坐收渔翁之利啊…",
            "nextDialogs": [
              "40090223"
            ]
          },
          "40090223": {
            "id": "40090223",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "有什么不可以的呢？可惜，后来情况有变，菲米尼应该告诉你了，梅洛彼得堡周围的海水正在变化。",
            "nextDialogs": [
              "40090224"
            ]
          },
          "40090224": {
            "id": "40090224",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "「禁区」一直是林尼的调查目标，你来了之后也被牵扯其中。为了你们的安全，也为了不让梅洛彼得堡摊上更多麻烦事，我开始着手干涉你们。",
            "nextDialogs": [
              "40090225"
            ]
          },
          "40090225": {
            "id": "40090225",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "传闻是真的吗？你以前真的是罪犯？",
            "nextDialogs": [
              "40090226"
            ]
          },
          "40090226": {
            "id": "40090226",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "什么话？都当梅洛彼得堡的管理者了，天天待在这里，不就是变相坐牢吗？只是这里的人比较服我。",
            "nextDialogs": [
              "40090227"
            ]
          },
          "40090227": {
            "id": "40090227",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "对了，谁找克洛琳德来的？",
            "nextDialogs": [
              "40090228"
            ]
          },
          "40090228": {
            "id": "40090228",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "当然是我。我花钱请她来梅洛彼得堡出外勤。",
            "nextDialogs": [
              "40090229"
            ]
          },
          "40090229": {
            "id": "40090229",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "克洛琳德小姐是决斗代理人，相当于第三方势力。我需要请一个实力超群的帮手应对接下来的危机。",
            "nextDialogs": [
              "40090230"
            ]
          },
          "40090230": {
            "id": "40090230",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "比如救起菲米尼？",
            "nextDialogs": [
              "40090231"
            ]
          },
          "40090231": {
            "id": "40090231",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "你就这么理解好了。那位先生确实是个好手，要是条件不那么苛刻，他可能已经追上失踪的人了。",
            "nextDialogs": [
              "40090234"
            ]
          },
          "40090234": {
            "id": "40090234",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "这不是你该打听的事，那维莱特委托你的工作也只是探查「公子」的去向。",
            "nextDialogs": [
              "40090235"
            ]
          },
          "40090235": {
            "id": "40090235",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "我只需向你证明「禁区」与公子的失踪无关，这一点上菲米尼就是人证。",
            "nextDialogs": [
              "40090236"
            ]
          },
          "40090236": {
            "id": "40090236",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "可是，我们都查到医务室了，你刚才也问了一堆事…反而是我们问的最后一个问题你还没回答呢！",
            "nextDialogs": [
              "40090237"
            ]
          },
          "40090237": {
            "id": "40090237",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "噢，说得我都不好意思了。你们真那么想知道答案啊。",
            "nextDialogs": [
              "40090238"
            ]
          },
          "40090238": {
            "id": "40090238",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "对！",
            "nextDialogs": [
              "40090239"
            ]
          },
          "40090239": {
            "id": "40090239",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "哪怕说出真相也未必能让你高兴？",
            "nextDialogs": [
              "40090240"
            ]
          },
          "40090240": {
            "id": "40090240",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…是的。",
            "nextDialogs": [
              "40090241"
            ]
          },
          "40090241": {
            "id": "40090241",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "跟我来。"
          }
        }
      }
    },
    {
      "subId": "400903",
      "subQuestName": "跟随莱欧斯利",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090301"
        ],
        "dialogs": {
          "40090301": {
            "id": "40090301",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "这种地方居然有扇暗门？里面还有个地下室！你可真能藏。",
            "nextDialogs": [
              "40090302"
            ]
          },
          "40090302": {
            "id": "40090302",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "别忘了梅洛彼得堡是什么地方。"
          }
        }
      }
    },
    {
      "subId": "400904",
      "subQuestName": "跟随莱欧斯利",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090401"
        ],
        "dialogs": {
          "40090401": {
            "id": "40090401",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "站在中间的圆盘上。",
            "nextDialogs": [
              "40090402"
            ]
          },
          "40090402": {
            "id": "40090402",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "难道有什么秘密机关？…哇！",
            "nextDialogs": [
              "40090403"
            ]
          },
          "40090403": {
            "id": "40090403",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "众人站稳之后，圆盘开始缓缓向下移动…"
          }
        }
      }
    },
    {
      "subId": "400906",
      "subQuestName": "与莱欧斯利对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090601"
        ],
        "dialogs": {
          "40090601": {
            "id": "40090601",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "这里就是「禁区」？藏得那么隐蔽，进来一看倒没什么特别的嘛。",
            "nextDialogs": [
              "40090602"
            ]
          },
          "40090602": {
            "id": "40090602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那是…",
            "nextDialogs": [
              "40090603"
            ]
          },
          "40090603": {
            "id": "40090603",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "门好大啊！",
            "nextDialogs": [
              "40090604"
            ]
          },
          "40090604": {
            "id": "40090604",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "类似的隔离门总共有三道，一般来说没人能进入门内，除了我。顾名思义，「禁区」。",
            "nextDialogs": [
              "40090605"
            ]
          },
          "40090605": {
            "id": "40090605",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "不过你们肯定会把信息共享给愚人众那几位对吧。",
            "nextDialogs": [
              "40090606"
            ]
          },
          "40090606": {
            "id": "40090606",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "确实没想过要瞒着他们…",
            "nextDialogs": [
              "40090607"
            ]
          },
          "40090607": {
            "id": "40090607",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "哈哈，该不该这么做，还是等你们看完再决定吧。"
          }
        }
      }
    },
    {
      "subId": "400907",
      "subQuestName": "继续探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090701"
        ],
        "dialogs": {
          "40090701": {
            "id": "40090701",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "旁边还有开关呢。",
            "nextDialogs": [
              "40090702"
            ]
          },
          "40090702": {
            "id": "40090702",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "往后站。",
            "nextDialogs": [
              "40090703"
            ]
          },
          "40090703": {
            "id": "40090703",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "呜哇…一道接一道升上去了…",
            "nextDialogs": [
              "40090704"
            ]
          },
          "40090704": {
            "id": "40090704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "房间中央那是什么？",
            "nextDialogs": [
              "40090705"
            ]
          },
          "40090705": {
            "id": "40090705",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "走近点。"
          }
        }
      }
    },
    {
      "subId": "400908",
      "subQuestName": "跟随莱欧斯利向前探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090801"
        ],
        "dialogs": {
          "40090801": {
            "id": "40090801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这间房间十分空旷，什么都没放，本身就已经很奇怪了。房间正中还有一个装置，像一道巨大的闸门。）",
            "nextDialogs": [
              "40090802"
            ]
          },
          "40090802": {
            "id": "40090802",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "接管梅洛彼得堡后我一直很在意这道门后面是什么。贸然开启很不明智，但不探查它背后究竟有什么，也是在放任隐患。",
            "nextDialogs": [
              "40090803"
            ]
          },
          "40090803": {
            "id": "40090803",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "我接手梅洛彼得堡至今，闸门上那道仪表盘就没有变化过，但最近一年，它的指针悄然转动，恐怕是某个数据变化了一丁点。",
            "nextDialogs": [
              "40090804"
            ]
          },
          "40090804": {
            "id": "40090804",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "放在平时应该会被忽视，不过那段时间我比较闲，就花了点时间调查。你们觉得它会是什么？",
            "nextDialogs": [
              "40090807"
            ]
          },
          "40090807": {
            "id": "40090807",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "很合理的猜想，我也考虑过。它不是那么常规。",
            "nextDialogs": [
              "40090808"
            ]
          },
          "40090808": {
            "id": "40090808",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "温度会根据气候变化，相比温度，水压的可能性更高。我们从外部做了些测试，尝试增加压力，可它不受影响。",
            "nextDialogs": [
              "40090809"
            ]
          },
          "40090809": {
            "id": "40090809",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "后来，我想到另一些可能，与原始胎海有关。基于这种猜想，我开始做准备。",
            "nextDialogs": [
              "40090810"
            ]
          },
          "40090810": {
            "id": "40090810",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "这两天指针又转了，加上那位潜水员回来时的症状，如今我已经完全确定，这个指数代表的是原始胎海水浓度。",
            "nextDialogs": [
              "40090811"
            ]
          },
          "40090811": {
            "id": "40090811",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "浓度？！可这里是海底…",
            "nextDialogs": [
              "40090812"
            ]
          },
          "40090812": {
            "id": "40090812",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "问题就在这里。我们在海底，而海水悄悄变质了，胎海水混杂其中，浓度还在不断升高。",
            "nextDialogs": [
              "40090813"
            ]
          },
          "40090813": {
            "id": "40090813",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…胎海水在不断混入海水？",
            "nextDialogs": [
              "40090814"
            ]
          },
          "40090814": {
            "id": "40090814",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "嗯，可能性很大。",
            "nextDialogs": [
              "40090815"
            ]
          },
          "40090815": {
            "id": "40090815",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "可是，别说我们俩了，就连那维莱特他们都不知道原始胎海在哪，胎海水又是从哪里…",
            "nextDialogs": [
              "40090816"
            ]
          },
          "40090816": {
            "id": "40090816",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "啊！",
            "nextDialogs": [
              "40090817"
            ]
          },
          "40090817": {
            "id": "40090817",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "你们似乎明白了。",
            "nextDialogs": [
              "40090818"
            ]
          },
          "40090818": {
            "id": "40090818",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "没错，我认为，这道闸门下方就是原始胎海。出于某些原因，闸门后的胎海水开始大幅上涨，已经很接近我们了。",
            "nextDialogs": [
              "40090819"
            ]
          },
          "40090819": {
            "id": "40090819",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "仪表盘现在是红色。闸门虽然还在，胎海水已经透过部分海底泄漏出来，混入大海。",
            "nextDialogs": [
              "40090820"
            ]
          },
          "40090820": {
            "id": "40090820",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "…这样下去它很快就没法阻挡底下的水了。"
          }
        }
      }
    },
    {
      "subId": "400909",
      "subQuestName": "返回办公室",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090901"
        ],
        "dialogs": {
          "40090901": {
            "id": "40090901",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "到了。",
            "nextDialogs": [
              "40090902"
            ]
          },
          "40090902": {
            "id": "40090902",
            "speakerId": 1008,
            "speakerName": "朱里厄",
            "text": "公爵！您来得正好，最新一次试做的数据已经…",
            "nextDialogs": [
              "40090903"
            ]
          },
          "40090903": {
            "id": "40090903",
            "speakerId": 1009,
            "speakerName": "露尔薇",
            "text": "等等朱里厄，有别的人！",
            "nextDialogs": [
              "40090904"
            ]
          },
          "40090904": {
            "id": "40090904",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "咦？朱里厄和露尔薇？",
            "nextDialogs": [
              "40090905"
            ]
          },
          "40090905": {
            "id": "40090905",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "不用紧张，这两位已经知道我们的计划了。",
            "nextDialogs": [
              "40090906"
            ]
          },
          "40090906": {
            "id": "40090906",
            "speakerId": 1009,
            "speakerName": "露尔薇",
            "text": "什么？亏您还说不能向任何人透露我们的计划！",
            "nextDialogs": [
              "40090907"
            ]
          },
          "40090907": {
            "id": "40090907",
            "speakerId": 1008,
            "speakerName": "朱里厄",
            "text": "我也抱有同样的疑问。您确定他们可信吗？",
            "nextDialogs": [
              "40090908"
            ]
          },
          "40090908": {
            "id": "40090908",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "你已经看到结果了不是吗？这两位知道的事可能比你们想的还多。",
            "nextDialogs": [
              "40090909"
            ]
          },
          "40090909": {
            "id": "40090909",
            "speakerId": 1008,
            "speakerName": "朱里厄",
            "text": "…好吧，如果您坚持的话。",
            "nextDialogs": [
              "40090910"
            ]
          },
          "40090910": {
            "id": "40090910",
            "speakerId": 1009,
            "speakerName": "露尔薇",
            "text": "我从他们身上感觉不到恶意…应该是可信的吧。",
            "nextDialogs": [
              "40090911"
            ]
          },
          "40090911": {
            "id": "40090911",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "重新介绍一下，这位是朱里厄，枫丹科学院最高级研究人才之一，曾在艾德温手下工作。你们知道艾德温吧？",
            "nextDialogs": [
              "40090913",
              "40090915"
            ]
          },
          "40090913": {
            "id": "40090913",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "很好，省去了解释的功夫。",
            "nextDialogs": [
              "40090916"
            ]
          },
          "40090916": {
            "id": "40090916",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "艾德温主攻研究方向是始基矿和重力仪，朱里厄作为助手，也了解相关技术。我聘请他担任我的技术顾问。",
            "nextDialogs": [
              "40090917"
            ]
          },
          "40090917": {
            "id": "40090917",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "你…你要把梅洛彼得堡炸上天？",
            "nextDialogs": [
              "40090918"
            ]
          },
          "40090918": {
            "id": "40090918",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "啊，这句话很美妙。我开始想象了。",
            "nextDialogs": [
              "40090919"
            ]
          },
          "40090919": {
            "id": "40090919",
            "speakerId": 1008,
            "speakerName": "朱里厄",
            "text": "我也有些心动…",
            "nextDialogs": [
              "40090920"
            ]
          },
          "40090920": {
            "id": "40090920",
            "speakerId": 1009,
            "speakerName": "露尔薇",
            "text": "先生们，注意分寸！",
            "nextDialogs": [
              "40090921"
            ]
          },
          "40090921": {
            "id": "40090921",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "正直的露尔薇小姐同样是我请来的技术顾问，很巧，朱里厄以前是艾德温的助手，而她以前是朱里厄的助手。",
            "nextDialogs": [
              "40090922"
            ]
          },
          "40090922": {
            "id": "40090922",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "还能这样？",
            "nextDialogs": [
              "40090923"
            ]
          },
          "40090923": {
            "id": "40090923",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么必要？",
            "nextDialogs": [
              "40090924"
            ]
          },
          "40090924": {
            "id": "40090924",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "你看，大家都这么问。你们其实是借职务之便谈恋爱吧？",
            "nextDialogs": [
              "40090925"
            ]
          },
          "40090925": {
            "id": "40090925",
            "speakerId": 1009,
            "speakerName": "露尔薇",
            "text": "什…公爵，我们没在谈恋爱！",
            "nextDialogs": [
              "40090926"
            ]
          },
          "40090926": {
            "id": "40090926",
            "speakerId": 1008,
            "speakerName": "朱里厄",
            "text": "除非我疯了！",
            "nextDialogs": [
              "40090927"
            ]
          },
          "40090927": {
            "id": "40090927",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "噢，当我没说。",
            "nextDialogs": [
              "40090928"
            ]
          },
          "40090928": {
            "id": "40090928",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "跟我来。",
            "nextDialogs": [
              "40090929"
            ]
          },
          "40090929": {
            "id": "40090929",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "哇，又是一扇会升起来的门！",
            "nextDialogs": [
              "40090930"
            ]
          },
          "40090930": {
            "id": "40090930",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "你这样称赞会让我对梅洛彼得堡产生不必要的自信。",
            "nextDialogs": [
              "40090931"
            ]
          },
          "40090931": {
            "id": "40090931",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "嘿嘿…我是真的觉得很厉害嘛。",
            "nextDialogs": [
              "40090932"
            ]
          },
          "40090932": {
            "id": "40090932",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "普通的房间？",
            "nextDialogs": [
              "40090933"
            ]
          },
          "40090933": {
            "id": "40090933",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "再来一些小把戏。",
            "nextDialogs": [
              "40090934"
            ]
          },
          "40090934": {
            "id": "40090934",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "请看。",
            "nextDialogs": [
              "40090935"
            ]
          },
          "40090935": {
            "id": "40090935",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是…？！",
            "nextDialogs": [
              "40090936"
            ]
          },
          "40090936": {
            "id": "40090936",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "这么大的…船？",
            "nextDialogs": [
              "40090937"
            ]
          },
          "40090937": {
            "id": "40090937",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "而且这里是没见过的工厂区…这是怎么回事？",
            "nextDialogs": [
              "40090938"
            ]
          },
          "40090938": {
            "id": "40090938",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "不知道你们对枫丹历史了解多少？",
            "nextDialogs": [
              "40090939"
            ]
          },
          "40090939": {
            "id": "40090939",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "呃…了解得很少…",
            "nextDialogs": [
              "40090940"
            ]
          },
          "40090940": {
            "id": "40090940",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "那你们或许还不知道雷穆利亚的故事。简单来说，古代枫丹受雷穆利亚王朝统治。",
            "nextDialogs": [
              "40090941"
            ]
          },
          "40090941": {
            "id": "40090941",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "传说雷穆利亚的帝王雷穆斯受天启感召而来，寻到化身为金蜂的先知西比尔。带着金蜂与大船法图纳号，在海上建立自己的国家。",
            "nextDialogs": [
              "40090942"
            ]
          },
          "40090942": {
            "id": "40090942",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "他以雷穆利亚称呼这个国家，并靠法图纳号继续不断寻找新的岛屿和部落，号召他们归入帝国统治。",
            "nextDialogs": [
              "40090943"
            ]
          },
          "40090943": {
            "id": "40090943",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "这个故事里也有船…？",
            "nextDialogs": [
              "40090944"
            ]
          },
          "40090944": {
            "id": "40090944",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "与水有关的地方总会有船。人们相信船能带领大家找到希望。",
            "nextDialogs": [
              "40090945"
            ]
          },
          "40090945": {
            "id": "40090945",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "你也信吗？",
            "nextDialogs": [
              "40090946"
            ]
          },
          "40090946": {
            "id": "40090946",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "我的话，半信半疑。但你也看到了，我拥有一整座工厂的材料、技术和人力，试一试没什么不好。",
            "nextDialogs": [
              "40090947"
            ]
          },
          "40090947": {
            "id": "40090947",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "所以，第一次猜想那扇闸门下可能是胎海时，我就想到要做这件事了。",
            "nextDialogs": [
              "40090948"
            ]
          },
          "40090948": {
            "id": "40090948",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "是传说中的法图纳号启发了你吗？",
            "nextDialogs": [
              "40090949"
            ]
          },
          "40090949": {
            "id": "40090949",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "天灾在即，枫丹人需要这样的手段。"
          },
          "40090915": {
            "id": "40090915",
            "speakerId": 1008,
            "speakerName": "朱里厄",
            "text": "艾德温，就是炸飞了整个枫丹科学院的家伙。他是公认的脑袋有问题，不过你不是本地人，不知道也没什么奇怪的。"
          }
        }
      }
    },
    {
      "subId": "400912",
      "subQuestName": "与莱欧斯利对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40091201"
        ],
        "dialogs": {
          "40091201": {
            "id": "40091201",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "就送你们到这里。",
            "nextDialogs": [
              "40091202"
            ]
          },
          "40091202": {
            "id": "40091202",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "噢！呃…谢谢。",
            "nextDialogs": [
              "40091203"
            ]
          },
          "40091203": {
            "id": "40091203",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "别客气。不过记住了，要不要将信息分享出去取决于你。你的举动很可能影响那几个人。",
            "nextDialogs": [
              "40091204"
            ]
          },
          "40091204": {
            "id": "40091204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（他的意思是，我说不说出梅洛彼得堡的秘密，将直接决定林尼他们的下一步行动。）",
            "nextDialogs": [
              "40091205"
            ]
          },
          "40091205": {
            "id": "40091205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（…也就是说，如果我要将真相告诉林尼，就必须让他明白现在不能有太多纷争。）",
            "nextDialogs": [
              "40091206"
            ]
          },
          "40091206": {
            "id": "40091206",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "我们会认真考虑的，嗯！",
            "nextDialogs": [
              "40091207"
            ]
          },
          "40091207": {
            "id": "40091207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，会的。",
            "nextDialogs": [
              "40091208"
            ]
          },
          "40091208": {
            "id": "40091208",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "好，容我期待之后的事。"
          }
        }
      }
    },

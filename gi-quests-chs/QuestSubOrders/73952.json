          },
          "739520102": {
            "id": "739520102",
            "speakerId": 4332,
            "speakerName": "玥文",
            "text": "我也在思考这个问题。",
            "nextDialogs": [
              "739520103"
            ]
          },
          "739520103": {
            "id": "739520103",
            "speakerId": 4332,
            "speakerName": "玥文",
            "text": "似乎是因为以前忙惯了，我身上那股勤劳的血液正催促着我赶紧去干活…",
            "nextDialogs": [
              "739520104"
            ]
          },
          "739520104": {
            "id": "739520104",
            "speakerId": 4332,
            "speakerName": "玥文",
            "text": "但我听村民们讲，须弥有句古话：「巧思才能得真知。」",
            "nextDialogs": [
              "739520105"
            ]
          },
          "739520105": {
            "id": "739520105",
            "speakerId": 4332,
            "speakerName": "玥文",
            "text": "没准，换个想法、换种生活，才更适合我呢？"
          }
        }

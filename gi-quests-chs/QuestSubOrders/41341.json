            "speakerId": 1000,
            "speakerName": "蒙蒙",
            "text": "#谢谢你呀，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。"
          }
        }
      }
    },

      }
    },
    {
      "subId": "7513506",
      "subQuestName": "前往源火祭坛附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751350201"
        ],
        "dialogs": {
          "751350201": {
            "id": "751350201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，玻娜你飞得也太快了，我们差点就要跟不上了啦！",
            "nextDialogs": [
              "751350202"
            ]
          },
          "751350202": {
            "id": "751350202",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "嘿嘿，抱歉抱歉，看到源火祭坛在前面，不知不觉就…",
            "nextDialogs": [
              "751350203"
            ]
          },
          "751350203": {
            "id": "751350203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "只要用这个祭坛就能去到天蛇船了吗？不过就算一会出现了什么超级大的风场把我们吹起来，也不知道要飞多久…",
            "nextDialogs": [
              "751350204"
            ]
          },
          "751350204": {
            "id": "751350204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，想想就开始担心了。",
            "nextDialogs": [
              "751350206",
              "751350208"
            ]
          },
          "751350206": {
            "id": "751350206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好吧，既然你都这样说了，一会你可不要和我离得太远哦。",
            "nextDialogs": [
              "751350209"
            ]
          },
          "751350209": {
            "id": "751350209",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "总之现在是要把火磷石供奉到那个上面，不过我们手上有两枚火磷石，呃…保险起见就把它们一起放上去吧。"
          },
          "751350208": {
            "id": "751350208",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "对吧对吧，我也开始兴奋起来了呢，作为冒险家可不能错过这样的挑战！"
          }
        }
      }
    },

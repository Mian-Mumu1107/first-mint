  "subQuests": [
    {
      "subId": "7513501",
      "subQuestName": "跟随绿宝的指引寻找源火祭坛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751350101"
        ],
        "dialogs": {
          "751350101": {
            "id": "751350101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那就是源火祭坛了吗…呃，感觉想要过去的话还有点困难。",
            "nextDialogs": [
              "751350102"
            ]
          },
          "751350102": {
            "id": "751350102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#怎么办，我们是能用飞的啦，但是{REALNAME[ID(2)|SHOWHOST(true)]}和玻娜要怎么办啦。",
            "nextDialogs": [
              "751350103"
            ]
          },
          "751350103": {
            "id": "751350103",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "派蒙不会是在小看我吧，我可是花羽会的冒险家，飞行经验可是很丰富的。",
            "nextDialogs": [
              "751350104"
            ]
          },
          "751350104": {
            "id": "751350104",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "#就算是带上{REALNAME[ID(2)|SHOWHOST(true)]}，飞到那边也是轻轻松松。",
            "nextDialogs": [
              "751350105"
            ]
          },
          "751350105": {
            "id": "751350105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也有飞行执照。",
            "nextDialogs": [
              "751350106"
            ]
          },
          "751350106": {
            "id": "751350106",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "那就好，我会在前面给你们引路，你们只要跟上我就好了。",
            "nextDialogs": [
              "751350107"
            ]
          },
          "751350107": {
            "id": "751350107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "接下来是飞行竞速挑战吗？",
            "nextDialogs": [
              "751350108"
            ]
          },
          "751350108": {
            "id": "751350108",
            "speakerId": 1001,
            "speakerName": "玻娜",
            "text": "哇，这种时候就不要有这种好胜之心啦，我会在前面给你们引路，你们只要跟上我就好了。",
            "nextDialogs": [
              "751350109"
            ]
          },
          "751350109": {
            "id": "751350109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#总感觉很危险的样子，也不知道会发生什么，{REALNAME[ID(2)|SHOWHOST(true)]}你可要抓紧我们啦。",
            "nextDialogs": [
              "751350110"
            ]
          },
          "751350110": {
            "id": "751350110",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！"
          }
        }
      }
    },

        ],
        "dialogs": {
          "675720401": {
            "id": "675720401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么需要帮忙的吗？",
            "nextDialogs": [
              "675720402"
            ]
          },
          "675720402": {
            "id": "675720402",
            "speakerId": 1000,
            "speakerName": "索博列夫",
            "text": "巧了，还真有。我这儿等会有一批货物要装车发往至冬堡。结果负责押车的队伍里，有三个人到现在还没见着人影。",
            "nextDialogs": [
              "675720403"
            ]
          },
          "675720403": {
            "id": "675720403",
            "speakerId": 1000,
            "speakerName": "索博列夫",
            "text": "虽说少他们三个也能凑合发车，但路上万一出点什么岔子，临时缺人手，那可就是大麻烦了。",
            "nextDialogs": [
              "675720404"
            ]
          },
          "675720404": {
            "id": "675720404",
            "speakerId": 1000,
            "speakerName": "索博列夫",
            "text": "我估计这几个糊涂蛋是把日子记错了，这会儿多半还在底下闷头干活呢。就麻烦你跑一趟，去他们的工作区找找人吧…"
          }
        }
      }
    },
    {
      "subId": "7723302",
      "subQuestName": "找回负责押车的工人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772330101"
        ],
        "dialogs": {
          "772330101": {
            "id": "772330101",
            "speakerId": 1001,
            "speakerName": "兹亚布林",
            "text": "什么？今天轮到我跟车？完了完了，主管非骂死我不可！我、我立刻就过去！"
          }
        }
      }
    },
    {
      "subId": "7723304",
      "subQuestName": "找回负责押车的工人",
      "sceneId": null,

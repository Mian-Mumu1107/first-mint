    {
      "subId": "2300910",
      "subQuestName": "将样本带回给阿金",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230091001"
        ],
        "dialogs": {
          "230091001": {
            "id": "230091001",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "你们拿到那种泥土了吗？"
          }
        }
      }
    },
    {
      "subId": "2300919",
      "subQuestName": "继续与阿金对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230091901"
        ],
        "dialogs": {
          "230091901": {
            "id": "230091901",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "谢谢你，这些应该足够我再用一段时间了。",
            "nextDialogs": [
              "230091902"
            ]
          },
          "230091902": {
            "id": "230091902",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "我在想，这种「凝成泥土」，也许还有其他的改造方式…",
            "nextDialogs": [
              "230091903"
            ]
          },
          "230091903": {
            "id": "230091903",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "比如，能够持续吸纳水分，本身富含营养…",
            "nextDialogs": [
              "230091904"
            ]
          },
          "230091904": {
            "id": "230091904",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "唉，我这个脑瓜子真是不好使，如果是上层的那些聪明人，也许能想出更多的好办法吧…"
          }
        }
      }
    },
    {
      "subId": "2300911",
      "subQuestName": "与阿金对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230091101"
        ],
        "dialogs": {
          "230091101": {
            "id": "230091101",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "旅行者！你来得正好，我正在发愁没有人帮忙呢。",
            "nextDialogs": [
              "230091102"
            ]
          },
          "230091102": {
            "id": "230091102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的研究有进展了？",
            "nextDialogs": [
              "230091103"
            ]
          },
          "230091103": {
            "id": "230091103",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "呃…也谈不上「进展」，只不过是有一位顾客给我提出了意见。",
            "nextDialogs": [
              "230091104"
            ]
          },
          "230091104": {
            "id": "230091104",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "他说自己经常养花，最烦恼的事就是寻找合适的花土。",
            "nextDialogs": [
              "230091114"
            ]
          },
          "230091114": {
            "id": "230091114",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "既要有透气性，营养又要好，不能太吸水，也不能太容易排水…",
            "nextDialogs": [
              "230091105"
            ]
          },
          "230091105": {
            "id": "230091105",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "他看到了我的「凝成泥土」有这么多改进方案，就想要拜托我设计出一种专门养花用的「凝成花土」。",
            "nextDialogs": [
              "230091106"
            ]
          },
          "230091106": {
            "id": "230091106",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "我觉得这是一个很有意思的方向，所以我正在寻找别的材料，来改进我的「凝成泥土」。",
            "nextDialogs": [
              "230091107"
            ]
          },
          "230091107": {
            "id": "230091107",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "这一次，我想要拜托你帮我去挖一些肥沃的泥土回来。",
            "nextDialogs": [
              "230091108"
            ]
          },
          "230091108": {
            "id": "230091108",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "我把那种泥土的所在位置给你标在地图上。",
            "nextDialogs": [
              "230091111"
            ]
          },
          "230091111": {
            "id": "230091111",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "这地方是我找人打听来的，虽然有点远，但据说那边的泥土非常肥沃。",
            "nextDialogs": [
              "230091112"
            ]
          },
          "230091112": {
            "id": "230091112",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "不过…呃…那边好像也有很多魔物，我自己可不敢去…",
            "nextDialogs": [
              "230091113"
            ]
          },
          "230091113": {
            "id": "230091113",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "所以，我只能拜托你了！旅行者！"
          }
        }
      }
    },
    {
      "subId": "2300912",
      "subQuestName": "前往阿金推荐的地点",
      "sceneId": null,

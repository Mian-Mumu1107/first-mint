    {
      "subId": "2300902",
      "subQuestName": "与阿金对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230090201"
        ],
        "dialogs": {
          "230090201": {
            "id": "230090201",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "还得再去买些材料回来…",
            "nextDialogs": [
              "230090202"
            ]
          },
          "230090202": {
            "id": "230090202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的「凝成泥土」怎么样了？",
            "nextDialogs": [
              "230090203"
            ]
          },
          "230090203": {
            "id": "230090203",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "非常好！不如说，这种泥土的应用范围简直超乎我的想象。",
            "nextDialogs": [
              "230090204"
            ]
          },
          "230090204": {
            "id": "230090204",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "它可以用来做瓶瓶罐罐，也能修补房屋的漏洞。",
            "nextDialogs": [
              "230090205"
            ]
          },
          "230090205": {
            "id": "230090205",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "只要调整一下各种泥土的混合比例，直接用来搭建房屋也没有问题。",
            "nextDialogs": [
              "230090206"
            ]
          },
          "230090206": {
            "id": "230090206",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "不过…因为大家都来找我订购这种泥土，我的材料又不够用了。",
            "nextDialogs": [
              "230090207"
            ]
          },
          "230090207": {
            "id": "230090207",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "而且最关键的史莱姆凝液也用光了，旅行者，能请你再去帮我拿三份史莱姆凝液回来吗？",
            "nextDialogs": [
              "230090212",
              "230090210"
            ]
          },
          "230090212": {
            "id": "230090212",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "拜托你了，旅行者，请你帮我拿三份史莱姆凝液回来吧。"
          },
          "230090210": {
            "id": "230090210",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "其他的材料我都已经从各种渠道订购，或者托人去找了。",
            "nextDialogs": [
              "230090211"
            ]
          },
          "230090211": {
            "id": "230090211",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "但史莱姆凝液消耗得实在太快，出乎我的预料…"
          }
        }
      }
    },
    {
      "subId": "2300903",
      "subQuestName": "将三个史莱姆凝液交给阿金",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230090301"
        ],
        "dialogs": {
          "230090301": {
            "id": "230090301",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "旅行者，你拿到史莱姆凝液了吗？"
          }
        }
      }
    },
    {
      "subId": "2300917",
      "subQuestName": "继续与阿金对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230091701"
        ],
        "dialogs": {
          "230091701": {
            "id": "230091701",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "谢谢你，这样材料就暂时齐全了。",
            "nextDialogs": [
              "230091702"
            ]
          },
          "230091702": {
            "id": "230091702",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "请你稍等一下，我现在就调配一下凝成泥土…",
            "nextDialogs": [
              "230091703"
            ]
          },
          "230091703": {
            "id": "230091703",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "阿金开始调配泥土…",
            "nextDialogs": [
              "230091704"
            ]
          },
          "230091704": {
            "id": "230091704",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "这样就可以了，旅行者，请你帮我把这份泥土带给尼姆吧。",
            "nextDialogs": [
              "230091705"
            ]
          },
          "230091705": {
            "id": "230091705",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "他可是等着这泥土好久了，想必都等急了。",
            "nextDialogs": [
              "230091706"
            ]
          },
          "230091706": {
            "id": "230091706",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "这孩子可是有着…嗯…非比寻常的想象力。",
            "nextDialogs": [
              "230091707"
            ]
          },
          "230091707": {
            "id": "230091707",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "尼姆和我说，他想要做一群「泥罐战士」，这群战士们都是一个个会说话的泥罐，能够滚动着身子打倒敌人，还有各种神奇的能力。",
            "nextDialogs": [
              "230091708"
            ]
          },
          "230091708": {
            "id": "230091708",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "而这群「泥罐战士」的能力，则根据他们塞进自己「罐体」里的材料而各不相同。",
            "nextDialogs": [
              "230091709"
            ]
          },
          "230091709": {
            "id": "230091709",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "他还给「泥罐战士」取了名字呢，好像叫亚什么来着…",
            "nextDialogs": [
              "230091710"
            ]
          },
          "230091710": {
            "id": "230091710",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "哈哈哈，虽然实现不了，但他的想法真的很有趣。",
            "nextDialogs": [
              "230091711"
            ]
          },
          "230091711": {
            "id": "230091711",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "我就想，既然他有这么新奇的点子，不如就把这泥土当做玩具送给他。",
            "nextDialogs": [
              "230091712"
            ]
          },
          "230091712": {
            "id": "230091712",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "这样，他就可以亲手铸造出他的「泥罐战士」们，正式当上「泥罐将军」了。",
            "nextDialogs": [
              "230091713"
            ]
          },
          "230091713": {
            "id": "230091713",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "咳，先不说了，总之请你把这罐泥土送给尼姆吧。",
            "nextDialogs": [
              "230091714"
            ]
          },
          "230091714": {
            "id": "230091714",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "等到他的「泥罐战士」正式出炉，说不定他也会封你和我一个「泥罐大将」的称号呢。"
          }
        }
      }
    },
    {
      "subId": "2300904",
      "subQuestName": "将泥土交给尼姆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230090401"
        ],
        "dialogs": {
          "230090401": {
            "id": "230090401",
            "speakerId": 4103,
            "speakerName": "尼姆",
            "text": "#你好，{M#大哥哥}{F#大姐姐}，请问有什么事吗？"
          }
        }
      }
    },
    {
      "subId": "2300918",
      "subQuestName": "继续与尼姆对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230091801"
        ],
        "dialogs": {
          "230091801": {
            "id": "230091801",
            "speakerId": 4103,
            "speakerName": "尼姆",
            "text": "哇，这就是阿金叔叔说的，什么都能做的泥土吧！",
            "nextDialogs": [
              "230091802"
            ]
          },
          "230091802": {
            "id": "230091802",
            "speakerId": 4103,
            "speakerName": "尼姆",
            "text": "#太好了，谢谢你，{M#大哥哥}{F#大姐姐}！",
            "nextDialogs": [
              "230091803"
            ]
          },
          "230091803": {
            "id": "230091803",
            "speakerId": 4103,
            "speakerName": "尼姆",
            "text": "这下，我就可以把「亚德里」做出来了！",
            "nextDialogs": [
              "230091804"
            ]
          },
          "230091804": {
            "id": "230091804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「亚德里」是…",
            "nextDialogs": [
              "230091805"
            ]
          },
          "230091805": {
            "id": "230091805",
            "speakerId": 4103,
            "speakerName": "尼姆",
            "text": "#{M#大哥哥}{F#大姐姐}没听阿金叔叔说吗？",
            "nextDialogs": [
              "230091806"
            ]
          },
          "230091806": {
            "id": "230091806",
            "speakerId": 4103,
            "speakerName": "尼姆",
            "text": "我正在做「泥罐战士」呢。「亚德里」就是最初，也是最强的「泥罐战士」！",
            "nextDialogs": [
              "230091807"
            ]
          },
          "230091807": {
            "id": "230091807",
            "speakerId": 4103,
            "speakerName": "尼姆",
            "text": "他脾气很好，也很善良。作为「泥罐战士」苏醒的时候，第一件事就是向被他压在身子下面的草地道歉。",
            "nextDialogs": [
              "230091808"
            ]
          },
          "230091808": {
            "id": "230091808",
            "speakerId": 4103,
            "speakerName": "尼姆",
            "text": "他的能力是…能力是…",
            "nextDialogs": [
              "230091809"
            ]
          },
          "230091809": {
            "id": "230091809",
            "speakerId": 4103,
            "speakerName": "尼姆",
            "text": "我，我还没想好…等我想好了，第一个告诉你！",
            "nextDialogs": [
              "230091810"
            ]
          },
          "230091810": {
            "id": "230091810",
            "speakerId": 4103,
            "speakerName": "尼姆",
            "text": "做完了「亚德里」之后，我还要做他的副官「伊瓦尔」和徒弟「拉松」。",
            "nextDialogs": [
              "230091811"
            ]
          },
          "230091811": {
            "id": "230091811",
            "speakerId": 4103,
            "speakerName": "尼姆",
            "text": "他们三个人…不对，三个「泥罐战士」，会开始一场很长很长的旅行…"
          }
        }
      }
    },
    {
      "subId": "2300908",
      "subQuestName": "与阿金对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230090801"
        ],
        "dialogs": {
          "230090801": {
            "id": "230090801",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "还得再去买些材料回来…",
            "nextDialogs": [
              "230090802"
            ]
          },
          "230090802": {
            "id": "230090802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的「凝成泥土」怎么样了？",
            "nextDialogs": [
              "230090803"
            ]
          },
          "230090803": {
            "id": "230090803",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "非常好！不如说，这种泥土的应用范围简直超乎我的想象。",
            "nextDialogs": [
              "230090804"
            ]
          },
          "230090804": {
            "id": "230090804",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "它可以用来做瓶瓶罐罐，也能修补房屋的漏洞。",
            "nextDialogs": [
              "230090805"
            ]
          },
          "230090805": {
            "id": "230090805",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "只要调整一下各个泥土的混合比例，直接用来搭建房屋也没有问题。",
            "nextDialogs": [
              "230090806"
            ]
          },
          "230090806": {
            "id": "230090806",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "不过…因为大家都来找我订购这种泥土，我的材料又不够用了。",
            "nextDialogs": [
              "230090807"
            ]
          },
          "230090807": {
            "id": "230090807",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "就连骗骗花根系上的泥土也用光了…旅行者，能请你再去帮我拿一份回来吗？",
            "nextDialogs": [
              "230090812",
              "230090810"
            ]
          },
          "230090812": {
            "id": "230090812",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "那就拜托你了，请你帮我带回来一份骗骗花根系上的泥土吧。"
          },
          "230090810": {
            "id": "230090810",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "其他的材料我都已经从各种渠道订购，或者托人去找了。",
            "nextDialogs": [
              "230090811"
            ]
          },
          "230090811": {
            "id": "230090811",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "但这种泥土都消耗完了，我之前的备货还是太少了…"
          }
        }
      }
    },

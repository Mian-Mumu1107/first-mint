        ],
        "dialogs": {
          "230092101": {
            "id": "230092101",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "谢谢你，我会分析这一批泥土的情况。",
            "nextDialogs": [
              "230092102"
            ]
          },
          "230092102": {
            "id": "230092102",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "怎么会发生这种事…难道我还要接着调整比例吗…",
            "nextDialogs": [
              "230092103"
            ]
          },
          "230092103": {
            "id": "230092103",
            "speakerId": 4016,
            "speakerName": "阿金",
            "text": "唉，做泥土怎么这么难…"
          }
        }
      }
    },

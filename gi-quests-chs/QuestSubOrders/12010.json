  },
  "subQuests": [
    {
      "subId": "1201001",
      "subQuestName": "前往鸣神岛的海边",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120100101"
        ],
        "dialogs": {
          "120100101": {
            "id": "120100101",
            "speakerId": 12027,
            "speakerName": "松坂",
            "text": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，我们在找「大貉妖」！",
            "nextDialogs": [
              "120100102"
            ]
          },
          "120100102": {
            "id": "120100102",
            "speakerId": 12028,
            "speakerName": "彩香",
            "text": "你知道「大貉妖」住在哪里吗？",
            "nextDialogs": [
              "120100103"
            ]
          },
          "120100103": {
            "id": "120100103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「大貉妖」？",
            "nextDialogs": [
              "120100104"
            ]
          },
          "120100104": {
            "id": "120100104",
            "speakerId": 12027,
            "speakerName": "松坂",
            "text": "欸，你们没有听过吗？",
            "nextDialogs": [
              "120100105"
            ]
          },
          "120100105": {
            "id": "120100105",
            "speakerId": 12027,
            "speakerName": "松坂",
            "text": "就是一种很厉害又很狡猾的妖怪，能变成各种各样的东西，神出鬼没，喜欢骗人！",
            "nextDialogs": [
              "120100106"
            ]
          },
          "120100106": {
            "id": "120100106",
            "speakerId": 12029,
            "speakerName": "岩夫",
            "text": "我们家的稻米就被「大貉妖」偷吃过，有一次我爸爸还被「大貉妖」踹进了河里。",
            "nextDialogs": [
              "120100107"
            ]
          },
          "120100107": {
            "id": "120100107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好调皮的家伙啊…",
            "nextDialogs": [
              "120100108"
            ]
          },
          "120100108": {
            "id": "120100108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们为什么要找它呢？",
            "nextDialogs": [
              "120100109"
            ]
          },
          "120100109": {
            "id": "120100109",
            "speakerId": 12028,
            "speakerName": "彩香",
            "text": "因为我们终于有能打跑它的办法了！",
            "nextDialogs": [
              "120100110"
            ]
          },
          "120100110": {
            "id": "120100110",
            "speakerId": 12029,
            "speakerName": "岩夫",
            "text": "我爸爸说，「大貉妖」最喜欢捉弄那些老是不回家的人。",
            "nextDialogs": [
              "120100111"
            ]
          },
          "120100111": {
            "id": "120100111",
            "speakerId": 12029,
            "speakerName": "岩夫",
            "text": "只要打跑了「大貉妖」，我们就随时都可以出门玩啦！",
            "nextDialogs": [
              "120100112"
            ]
          },
          "120100112": {
            "id": "120100112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但如果是厉害的妖怪，你们不会害怕吗？",
            "nextDialogs": [
              "120100113"
            ]
          },
          "120100113": {
            "id": "120100113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们的爸爸妈妈也会担心你们的安全吧。",
            "nextDialogs": [
              "120100114"
            ]
          },
          "120100114": {
            "id": "120100114",
            "speakerId": 12029,
            "speakerName": "岩夫",
            "text": "不会啊？今天我告诉爸爸，说我们几个人要去找「大貉妖」，他什么都没说。",
            "nextDialogs": [
              "120100115"
            ]
          },
          "120100115": {
            "id": "120100115",
            "speakerId": 12027,
            "speakerName": "松坂",
            "text": "说不定是现在的「大貉妖」很弱，只能躲起来休息！",
            "nextDialogs": [
              "120100116"
            ]
          },
          "120100116": {
            "id": "120100116",
            "speakerId": 12028,
            "speakerName": "彩香",
            "text": "嗯！只要在「大貉妖」恢复妖力之前回家，就不会有危险。",
            "nextDialogs": [
              "120100117"
            ]
          },
          "120100117": {
            "id": "120100117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，怎么听起来怪怪的？但好像又说不清楚…",
            "nextDialogs": [
              "120100121"
            ]
          },
          "120100121": {
            "id": "120100121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我感觉「大貉妖」像故事里才有的妖怪，现实里并不存在。"
          }
        }
      }
    },
    {
      "subId": "1201002",
      "subQuestName": "追上离开的孩子们",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120100201"
        ],
        "dialogs": {
          "120100201": {
            "id": "120100201",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "#别伤心，别这么伤心啦，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_MALE_PRONOUN_SHE]}和你们开玩笑的，「大貉妖」怎么会不存在呢？",
            "nextDialogs": [
              "120100202"
            ]
          },
          "120100202": {
            "id": "120100202",
            "speakerId": 12027,
            "speakerName": "松坂",
            "text": "可、可是，我们确实没有见过「大貉妖」…",
            "nextDialogs": [
              "120100203"
            ]
          },
          "120100203": {
            "id": "120100203",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "那是因为「大貉妖」很厉害啊，就是因为它这么厉害，才需要你们出手对吧？",
            "nextDialogs": [
              "120100204"
            ]
          },
          "120100204": {
            "id": "120100204",
            "speakerId": 12027,
            "speakerName": "松坂",
            "text": "嗯…",
            "nextDialogs": [
              "120100205"
            ]
          },
          "120100205": {
            "id": "120100205",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "不用着急，也不用灰心，要成为很厉害的英雄，耐心和智慧也是不能少的。",
            "nextDialogs": [
              "120100206"
            ]
          },
          "120100206": {
            "id": "120100206",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "就算现在没找到它，烟花会开始之前，它一定会出现的。在那之前，记得来宵宫姐姐家领武器，知道了嘛？",
            "nextDialogs": [
              "120100207"
            ]
          },
          "120100207": {
            "id": "120100207",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "点燃我特制的烟花，无论「大貉妖」有多厉害，都能把它吓走。",
            "nextDialogs": [
              "120100208"
            ]
          },
          "120100208": {
            "id": "120100208",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "家里的东西，田里的庄稼，还有爸爸妈妈，都轮到你们来保护了！",
            "nextDialogs": [
              "120100209"
            ]
          },
          "120100209": {
            "id": "120100209",
            "speakerId": 12027,
            "speakerName": "松坂",
            "text": "知道了！既然宵宫姐姐都这么说了，我们就再耐心一点！",
            "nextDialogs": [
              "120100210"
            ]
          },
          "120100210": {
            "id": "120100210",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "对了对了，别着急走。我这里还有几张纸条，你们一人一张，记得带回去给爸爸妈妈，让他们好好保管。",
            "nextDialogs": [
              "120100211"
            ]
          },
          "120100211": {
            "id": "120100211",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "只要说是宵宫姐姐给的，他们就明白是什么意思啦。",
            "nextDialogs": [
              "120100212"
            ]
          },
          "120100212": {
            "id": "120100212",
            "speakerId": 12029,
            "speakerName": "岩夫",
            "text": "知道啦！谢谢宵宫姐姐！那我们就先回去了！",
            "nextDialogs": [
              "120100213"
            ]
          },
          "120100213": {
            "id": "120100213",
            "speakerId": 12028,
            "speakerName": "彩香",
            "text": "谢谢宵宫姐姐！你也要早点回来陪我们玩哦！",
            "nextDialogs": [
              "120100214"
            ]
          },
          "120100214": {
            "id": "120100214",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "好的好的，路上小心，待会儿我们再见啦！",
            "nextDialogs": [
              "120100215"
            ]
          },
          "120100215": {
            "id": "120100215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那、那个…",
            "nextDialogs": [
              "120100218"
            ]
          },
          "120100218": {
            "id": "120100218",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "果然是你们，听孩子们的描述我就猜到了。没关系，不怪你们。",
            "nextDialogs": [
              "120100219"
            ]
          },
          "120100219": {
            "id": "120100219",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "「大貉妖」在孩子中的人气很高，草率地否定它的存在，当然会让孩子伤心啦。",
            "nextDialogs": [
              "120100220"
            ]
          },
          "120100220": {
            "id": "120100220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么，「大貉妖」的确是不存在的吧？",
            "nextDialogs": [
              "120100221"
            ]
          },
          "120100221": {
            "id": "120100221",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "嗯，第一次听到它的故事，我就觉得，多半只是孩子们的父母编出来的妖怪，为了让孩子们不要乱跑。",
            "nextDialogs": [
              "120100222"
            ]
          },
          "120100222": {
            "id": "120100222",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "不过孩子们来问我的时候，我没有拆穿，而是说，「大貉妖」外貌可爱，喜欢恶作剧，但不喜欢伤人。",
            "nextDialogs": [
              "120100223"
            ]
          },
          "120100223": {
            "id": "120100223",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "他们现在相信的，大概都是我编出来的形象啦。",
            "nextDialogs": [
              "120100224"
            ]
          },
          "120100224": {
            "id": "120100224",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来都是你的创意啊…",
            "nextDialogs": [
              "120100225"
            ]
          },
          "120100225": {
            "id": "120100225",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "像这样延续谎言，是不对的吧？",
            "nextDialogs": [
              "120100226"
            ]
          },
          "120100226": {
            "id": "120100226",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "或许吧，但不管怎么样，也轮不到我去当这个拆穿谎言的人。",
            "nextDialogs": [
              "120100227"
            ]
          },
          "120100227": {
            "id": "120100227",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "他们的父母可能只是为了让孩子不要乱跑，但也可能有其他的考虑。",
            "nextDialogs": [
              "120100228"
            ]
          },
          "120100228": {
            "id": "120100228",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "在我不了解的情况下，我就草率地说「『大貉妖』什么的，不存在的哦？」很可能会害了他们。",
            "nextDialogs": [
              "120100229"
            ]
          },
          "120100229": {
            "id": "120100229",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "而且，对孩子来说，相信并且喜欢就好，真真假假什么的，不是那么重要的事啦。",
            "nextDialogs": [
              "120100230"
            ]
          },
          "120100230": {
            "id": "120100230",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "我心里也有很多很多憧憬啊，点燃之后会旋转喷出七彩虹光的「火钻」，隐居深山为仙境指路的「雾灵」…",
            "nextDialogs": [
              "120100231"
            ]
          },
          "120100231": {
            "id": "120100231",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "我知道都是不存在的，但是我还是愿意相信。别人要是在我面前说，「别傻了，不存在的」——",
            "nextDialogs": [
              "120100232"
            ]
          },
          "120100232": {
            "id": "120100232",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "我就会朝他做鬼脸，扔石头！因为很讨人厌！"
          }
        }
      }
    },
    {
      "subId": "1201003",
      "subQuestName": "前往「长野原烟花店」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120100301"
        ],
        "dialogs": {
          "120100301": {
            "id": "120100301",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "老爹，我回来啦！",
            "nextDialogs": [
              "120100302"
            ]
          },
          "120100302": {
            "id": "120100302",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "马上就到烟花会了吧，各家各户的烟花，都张罗得差不多了。",
            "nextDialogs": [
              "120100303"
            ]
          },
          "120100303": {
            "id": "120100303",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "这两个人，没见过呢。是新朋友？还是客人？",
            "nextDialogs": [
              "120100304"
            ]
          },
          "120100304": {
            "id": "120100304",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "#都算吧，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_MALE_PRONOUN_SHE]}们是前不久才到这里来的，既然来了稻妻，不看烟花怎么行呢？",
            "nextDialogs": [
              "120100305"
            ]
          },
          "120100305": {
            "id": "120100305",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "哈哈哈，不管怎么样，找个地方歇歇脚吧。我长野原龙之介，给你们讲讲长野原家的悠久历史。",
            "nextDialogs": [
              "120100306"
            ]
          },
          "120100306": {
            "id": "120100306",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "这个先等会儿，老爹，我有事情问你。",
            "nextDialogs": [
              "120100307"
            ]
          },
          "120100307": {
            "id": "120100307",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "很久很久以前…",
            "nextDialogs": [
              "120100308"
            ]
          },
          "120100308": {
            "id": "120100308",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "唉，老爹又自顾自地开始讲故事了。",
            "nextDialogs": [
              "120100309"
            ]
          },
          "120100309": {
            "id": "120100309",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "不好意思啊，老爹以前受了伤，那之后耳朵就不太好用了。",
            "nextDialogs": [
              "120100310"
            ]
          },
          "120100310": {
            "id": "120100310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但刚刚的对话，好像微妙地成立了呢…",
            "nextDialogs": [
              "120100311"
            ]
          },
          "120100311": {
            "id": "120100311",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "然后呢，人们又花了好长时间才明白，有一种矿石，它的粉末，能燃出很漂亮很漂亮的颜色。",
            "nextDialogs": [
              "120100312"
            ]
          },
          "120100312": {
            "id": "120100312",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "老爹，老爹，先等等！",
            "nextDialogs": [
              "120100313"
            ]
          },
          "120100313": {
            "id": "120100313",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "啊？怎么了？",
            "nextDialogs": [
              "120100314"
            ]
          },
          "120100314": {
            "id": "120100314",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "之前订购的那些做烟花的材料，已经送过来了吗？",
            "nextDialogs": [
              "120100315"
            ]
          },
          "120100315": {
            "id": "120100315",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "昨天的烟花都发出去啦，前天的也是，大前天的也是。",
            "nextDialogs": [
              "120100316"
            ]
          },
          "120100316": {
            "id": "120100316",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "不是，老爹，我是说材料，之前订购的材料。",
            "nextDialogs": [
              "120100317"
            ]
          },
          "120100317": {
            "id": "120100317",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "今天的也做得差不多啦，不用担心，你老爹的手艺还没退步呢。",
            "nextDialogs": [
              "120100318"
            ]
          },
          "120100318": {
            "id": "120100318",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "不是，是材料！做烟花需要用到的材料，矿石！",
            "nextDialogs": [
              "120100319"
            ]
          },
          "120100319": {
            "id": "120100319",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "什么？",
            "nextDialogs": [
              "120100320"
            ]
          },
          "120100320": {
            "id": "120100320",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "矿石材料！",
            "nextDialogs": [
              "120100321"
            ]
          },
          "120100321": {
            "id": "120100321",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "哦哦，矿石材料？",
            "nextDialogs": [
              "120100322"
            ]
          },
          "120100322": {
            "id": "120100322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对对对，矿石材料！",
            "nextDialogs": [
              "120100323"
            ]
          },
          "120100323": {
            "id": "120100323",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，对不起…终于传达到了，我有点激动，嘿嘿。",
            "nextDialogs": [
              "120100324"
            ]
          },
          "120100324": {
            "id": "120100324",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "材料的话，还没送过来呢，具体原因，好像过来说了一下，但我没听清…",
            "nextDialogs": [
              "120100325"
            ]
          },
          "120100325": {
            "id": "120100325",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "没关系，没关系，知道这个就行了，那就晚点再做。等他们送过来，老爹记得要收一下。",
            "nextDialogs": [
              "120100326"
            ]
          },
          "120100326": {
            "id": "120100326",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "嗯嗯，放心吧。",
            "nextDialogs": [
              "120100327"
            ]
          },
          "120100327": {
            "id": "120100327",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "不好意思，可能有点吵到你们了，如果有什么事要问老爹，就会像现在这样有点麻烦。",
            "nextDialogs": [
              "120100329",
              "120100331"
            ]
          },
          "120100329": {
            "id": "120100329",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "嘿嘿，对啊，老爹是很好的人，大家也都很尊重他。",
            "nextDialogs": [
              "120100332"
            ]
          },
          "120100332": {
            "id": "120100332",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "老爹因为听不清，所以从不和别人争论，也不否认别人的话，总是乐呵呵地听着。",
            "nextDialogs": [
              "120100333"
            ]
          },
          "120100333": {
            "id": "120100333",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "小的时候，我以为是老爹他特别理解我，觉得我说什么都是对的，所以我什么话都会和老爹说。",
            "nextDialogs": [
              "120100334"
            ]
          },
          "120100334": {
            "id": "120100334",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "后来我知道了，老爹乐呵呵的，只是因为他听不清楚，不过我还是每天都给他讲故事。",
            "nextDialogs": [
              "120100335"
            ]
          },
          "120100335": {
            "id": "120100335",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这又是为什么？",
            "nextDialogs": [
              "120100336"
            ]
          },
          "120100336": {
            "id": "120100336",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "光是看到老爹笑，我就很开心啊。这样他也不会寂寞吧。",
            "nextDialogs": [
              "120100337"
            ]
          },
          "120100337": {
            "id": "120100337",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "不过，话说回来，既然材料还没送到，烟花会又近在眼前了，我们得想想别的办法…",
            "nextDialogs": [
              "120100338"
            ]
          },
          "120100338": {
            "id": "120100338",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "那个，宵宫，是你回来了吗？",
            "nextDialogs": [
              "120100339"
            ]
          },
          "120100339": {
            "id": "120100339",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "呜哇？！你别吓唬人啊，不是让你别随便说话吗？",
            "nextDialogs": [
              "120100340"
            ]
          },
          "120100340": {
            "id": "120100340",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "对、对不起…",
            "nextDialogs": [
              "120100341"
            ]
          },
          "120100341": {
            "id": "120100341",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "你等我一下，我现在过来。"
          },
          "120100331": {
            "id": "120100331",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "嘿嘿，经常有人这么说。"
          }
        }
      }
    },
    {
      "subId": "1201004",
      "subQuestName": "确认声音的来源",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120100401"
        ],
        "dialogs": {
          "120100401": {
            "id": "120100401",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "没有人在看这边，出来吧，到侧面来。",
            "nextDialogs": [
              "120100402"
            ]
          },
          "120100402": {
            "id": "120100402",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "幸好刚刚没有惊动天领奉行的人，不然我们就都有危险了。",
            "nextDialogs": [
              "120100403"
            ]
          },
          "120100403": {
            "id": "120100403",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "是我太心急了，但我听到你回来了，我就…",
            "nextDialogs": [
              "120100404"
            ]
          },
          "120100404": {
            "id": "120100404",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "放心吧，朔次郎，至少目前一切都在计划之中。",
            "nextDialogs": [
              "120100405"
            ]
          },
          "120100405": {
            "id": "120100405",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "我们等下会去找做烟花的材料，顺便也会搞定船的事，就是之前答应过你的。",
            "nextDialogs": [
              "120100406"
            ]
          },
          "120100406": {
            "id": "120100406",
            "speakerId": 12025,
            "speakerName": "朔次郎",
            "text": "谢谢你，能帮我这么多。",
            "nextDialogs": [
              "120100409"
            ]
          },
          "120100409": {
            "id": "120100409",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "他是我们家以前的顾客，前段时间刚刚从外面逃回稻妻，结果在偷渡的时候被发现了，现在正在被天领奉行通缉…",
            "nextDialogs": [
              "120100410"
            ]
          },
          "120100410": {
            "id": "120100410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "通缉？！",
            "nextDialogs": [
              "120100411"
            ]
          },
          "120100411": {
            "id": "120100411",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "你也小点声啦，别引起不必要的注意。",
            "nextDialogs": [
              "120100412"
            ]
          },
          "120100412": {
            "id": "120100412",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "被抓到的话，朔次郎不知道会被判什么罪，为了让他避开这个风头，只能想办法找艘船，把他送出去。",
            "nextDialogs": [
              "120100413"
            ]
          },
          "120100413": {
            "id": "120100413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是外海不是有雷暴吗？",
            "nextDialogs": [
              "120100414"
            ]
          },
          "120100414": {
            "id": "120100414",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "是啊，这也是非常危险的办法，但现在没那么多选择可以挑了。",
            "nextDialogs": [
              "120100415"
            ]
          },
          "120100415": {
            "id": "120100415",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是一不小心翻了船，那就…唔唔！溺水很可怕的！",
            "nextDialogs": [
              "120100416"
            ]
          },
          "120100416": {
            "id": "120100416",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么危险的话，当初不回来不就好了吗？",
            "nextDialogs": [
              "120100417"
            ]
          },
          "120100417": {
            "id": "120100417",
            "speakerId": 12025,
            "speakerName": "朔次郎",
            "text": "因为，有不得不做的事…",
            "nextDialogs": [
              "120100418"
            ]
          },
          "120100418": {
            "id": "120100418",
            "speakerId": 12025,
            "speakerName": "朔次郎",
            "text": "可是我一回来，就听说了很多难以置信的变化。本来我下定了决心，但现在又不知道该怎么办了…",
            "nextDialogs": [
              "120100419"
            ]
          },
          "120100419": {
            "id": "120100419",
            "speakerId": 12025,
            "speakerName": "朔次郎",
            "text": "我也不想多给宵宫和龙之介先生添麻烦，他们能收留我，我就很感激了。",
            "nextDialogs": [
              "120100420"
            ]
          },
          "120100420": {
            "id": "120100420",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "没关系没关系，不用客气。还记得我说的话吧，「只要有我们家的纸条，就一直是长野原的客人。」",
            "nextDialogs": [
              "120100421"
            ]
          },
          "120100421": {
            "id": "120100421",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "纸条…？"
          }
        }
      }
    },
    {
      "subId": "1201005",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120100501"
        ],
        "dialogs": {
          "120100501": {
            "id": "120100501",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "你们有事就先忙，忙完再回来听故事也不迟。",
            "nextDialogs": [
              "120100502"
            ]
          },
          "120100502": {
            "id": "120100502",
            "speakerId": 3035,
            "speakerName": "长野原龙之介",
            "text": "我的时间很多，故事嘛，也有很多很多。"
          }
        }
      }
    },
    {
      "subId": "1201099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120109901"
        ],
        "dialogs": {
          "120109901": {
            "id": "120109901",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "稻妻有个「八重堂」，也有很多喜欢写故事的人。他们写的故事，有很多是用刚刚提到的传说改编的。",
            "nextDialogs": [
              "120109902"
            ]
          },
          "120109902": {
            "id": "120109902",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "但经常会有不好的结局——比如「火钻」被有钱人扔进了展览厅，再也没有被点燃的机会。",
            "nextDialogs": [
              "120109903"
            ]
          },
          "120109903": {
            "id": "120109903",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "「雾灵」被人盯上，虽然最后没被抓到，但它生气了，躲了起来，再也不出现。",
            "nextDialogs": [
              "120109904"
            ]
          },
          "120109904": {
            "id": "120109904",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "战胜恶龙的勇者变成了下一只恶龙，斩破黑暗的圣剑变成了毁灭世界的武器…",
            "nextDialogs": [
              "120109905"
            ]
          },
          "120109905": {
            "id": "120109905",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "虽然我知道这样的故事也会很流行，但…我不喜欢，真的喜欢不起来。",
            "nextDialogs": [
              "120109906"
            ]
          },
          "120109906": {
            "id": "120109906",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "那些浪漫的意象，保持浪漫就好了啊。",
            "nextDialogs": [
              "120109907"
            ]
          },
          "120109907": {
            "id": "120109907",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "对了，方便问一下，你们是怎么认识的吗？",
            "nextDialogs": [
              "120109908"
            ]
          },
          "120109908": {
            "id": "120109908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_MALE_PRONOUN_SHE]}把我从水里救了起来，然后我们就一起开始旅行了…怎么了嘛？",
            "nextDialogs": [
              "120109909"
            ]
          },
          "120109909": {
            "id": "120109909",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "没什么，只是很羡慕你们的关系。",
            "nextDialogs": [
              "120109910"
            ]
          },
          "120109910": {
            "id": "120109910",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "要是我老爹身边，也有一个像你这样的人能随时陪着他，他就不会因为耳朵听不清而耽误事了。",
            "nextDialogs": [
              "120109911"
            ]
          },
          "120109911": {
            "id": "120109911",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "咦？为什么你一脸激动的样子？",
            "nextDialogs": [
              "120109912"
            ]
          },
          "120109912": {
            "id": "120109912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "因为、因为——",
            "nextDialogs": [
              "120109913"
            ]
          },
          "120109913": {
            "id": "120109913",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你居然没有说我是「小家伙」或者「宠物」！"
          }
        }
      }
    }
  ]
}
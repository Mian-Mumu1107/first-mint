    {
      "subId": "7403508",
      "subQuestName": "返回复律庭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740350801"
        ],
        "dialogs": {
          "740350801": {
            "id": "740350801",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "太好了，这下我可以继续工作了，今天一定要把这篇倡议书写出来。",
            "nextDialogs": [
              "740350802"
            ]
          },
          "740350802": {
            "id": "740350802",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "太感谢你了，等我有空了，一定要请你吃一顿好的。",
            "nextDialogs": [
              "740350807"
            ]
          },
          "740350807": {
            "id": "740350807",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "明天您有空吗？如果有的话，就来这里找我吧。",
            "nextDialogs": [
              "740350808"
            ]
          },
          "740350808": {
            "id": "740350808",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "等我完成了工作，咱们就出去好好吃一顿！",
            "nextDialogs": [
              "740350805"
            ]
          },
          "740350805": {
            "id": "740350805",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "你说得对，我必须再加快点速度…",
            "nextDialogs": [
              "740350806"
            ]
          },
          "740350806": {
            "id": "740350806",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "等会，下一句是什么来着？我应该用笔记下来了…"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7403502",
      "subQuestName": "等到第二天早上（8点~12点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740350201"
        ],
        "dialogs": {
          "740350201": {
            "id": "740350201",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "旅行者，真高兴您又来这里参观，来杯咖啡？",
            "nextDialogs": [
              "740350204"
            ]
          },
          "740350204": {
            "id": "740350204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我之前也想问来着，但…但那些人说话好大声，完全不敢说别的话题…",
            "nextDialogs": [
              "740350243"
            ]
          },
          "740350243": {
            "id": "740350243",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我还以为会被直接赶出去。",
            "nextDialogs": [
              "740350205"
            ]
          },
          "740350205": {
            "id": "740350205",
            "speakerId": 1000,
            "speakerName": "洛耶茨",
            "text": "为什么？哈哈哈，不需要担心，门卫都让您进来了，我们又为什么非得自作主张，把您赶出去呢。",
            "nextDialogs": [
              "740350206"
            ]
          },
          "740350206": {
            "id": "740350206",
            "speakerId": 1002,
            "speakerName": "瑟米安",
            "text": "这是权责分明的一种形式。你好旅行者，我是瑟米安，真是幸会。"
          }
        }
      }
    },
    {
      "subId": "7403503",
      "subQuestName": "与艾尤恩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740350101"
        ],
        "dialogs": {
          "740350101": {
            "id": "740350101",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "啊…旅行者，很高兴见到你…",
            "nextDialogs": [
              "740350104"
            ]
          },
          "740350104": {
            "id": "740350104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你的黑眼圈好重，说话也没力气了，不然还是去休息一下吧。",
            "nextDialogs": [
              "740350105"
            ]
          },
          "740350105": {
            "id": "740350105",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "我…我不能休息，昨晚上熬了一夜，写了好几稿都不行。现在我又开始重写…",
            "nextDialogs": [
              "740350106"
            ]
          },
          "740350106": {
            "id": "740350106",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "如果您想找我办什么事的话，请再等等吧…您可以去洛耶茨先生那边搬把椅子坐下，说不定他那边还有咖啡…",
            "nextDialogs": [
              "740350107"
            ]
          },
          "740350107": {
            "id": "740350107",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "我…我得继续写了…",
            "nextDialogs": [
              "740350108"
            ]
          },
          "740350108": {
            "id": "740350108",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "不行，用「各位亲爱的同僚」总显得不够正式…"
          }
        }
      }
    },
    {
      "subId": "7403504",
      "subQuestName": "与洛耶茨对话",
      "sceneId": null,
      "locations": [],

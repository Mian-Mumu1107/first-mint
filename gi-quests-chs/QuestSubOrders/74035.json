        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7403505",
      "subQuestName": "与柯妮莉娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740350401"
        ],
        "dialogs": {
          "740350401": {
            "id": "740350401",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "您好，艾尤恩先生，有什么可以帮您的吗？",
            "nextDialogs": [
              "740350402"
            ]
          },
          "740350402": {
            "id": "740350402",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "柯妮莉娅小姐，您也好。请问咱们有备用的打字机键帽吗？",
            "nextDialogs": [
              "740350403"
            ]
          },
          "740350403": {
            "id": "740350403",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "什么？",
            "nextDialogs": [
              "740350404"
            ]
          },
          "740350404": {
            "id": "740350404",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "我的打字机少了一个键帽，我想申请一个备用键帽换上。要是没有的话…帮我报销一个也成。",
            "nextDialogs": [
              "740350405"
            ]
          },
          "740350405": {
            "id": "740350405",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "报销键帽…从原则上来说，倒是没有问题。",
            "nextDialogs": [
              "740350406"
            ]
          },
          "740350406": {
            "id": "740350406",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "您在这签个字吧。就写「因打字机故障，需报销键帽一枚」，然后签上您的名字，还有办公室名。",
            "nextDialogs": [
              "740350407"
            ]
          },
          "740350407": {
            "id": "740350407",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "好了，我今天应该能拿到这枚键帽吧，我还急着去工作。",
            "nextDialogs": [
              "740350408"
            ]
          },
          "740350408": {
            "id": "740350408",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "艾尤恩先生，您之前报销过公物吗？",
            "nextDialogs": [
              "740350409"
            ]
          },
          "740350409": {
            "id": "740350409",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "公物报销并不是您想象那样…来一件就报销一件，我们需要先以月为统计时间汇总报销单据，然后在月底统一交给枢律庭审批。",
            "nextDialogs": [
              "740350410"
            ]
          },
          "740350410": {
            "id": "740350410",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "这审批事关整个复律庭的工资发放，如果报销的数额过大，枢律庭甚至需要呈给那维莱特大人审阅。",
            "nextDialogs": [
              "740350427"
            ]
          },
          "740350427": {
            "id": "740350427",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "等他整体审阅完毕再签字后，才能正式开始拨款。",
            "nextDialogs": [
              "740350411"
            ]
          },
          "740350411": {
            "id": "740350411",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "如果那维莱特大人对某个报销条目有疑问，对应的人员还需要提交一份书面说明…我们正准备这几天就把第一批提交上去呢。",
            "nextDialogs": [
              "740350412"
            ]
          },
          "740350412": {
            "id": "740350412",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "你的意思是，如果我运气不好的话，想报销这枚键帽还得那维莱特大人点头？",
            "nextDialogs": [
              "740350413"
            ]
          },
          "740350413": {
            "id": "740350413",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "规定如此，艾尤恩先生。而且这个月要报销的数额不小，很可能确实需要那维莱特大人审阅。",
            "nextDialogs": [
              "740350414"
            ]
          },
          "740350414": {
            "id": "740350414",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那维莱特大人…不就是那位「最高审判官」？",
            "nextDialogs": [
              "740350415"
            ]
          },
          "740350415": {
            "id": "740350415",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "只不过是一个键帽，还要让他来签字…总感觉哪里不太对…",
            "nextDialogs": [
              "740350418"
            ]
          },
          "740350418": {
            "id": "740350418",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "我也这么想，只是一枚键帽而已，不用惊动那维莱特大人的大驾，真的不用了。",
            "nextDialogs": [
              "740350419"
            ]
          },
          "740350419": {
            "id": "740350419",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "倒是有别的方法。嗯…你可以先自己去买一枚键帽，然后我会在公账里给您打一个白条。",
            "nextDialogs": [
              "740350420"
            ]
          },
          "740350420": {
            "id": "740350420",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "在报销流程走完，款项拨下来之后，再将对应的费用从公账里拨付给您。",
            "nextDialogs": [
              "740350421"
            ]
          },
          "740350421": {
            "id": "740350421",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "好极了！就这样吧，一枚键帽也花不了多少钱，我付得起。",
            "nextDialogs": [
              "740350422"
            ]
          },
          "740350422": {
            "id": "740350422",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "那您在这里签个字，还是写「因打字机故障，需报销键帽一枚」…您是去伊丝黛莱小姐那买键帽吗？",
            "nextDialogs": [
              "740350423"
            ]
          },
          "740350423": {
            "id": "740350423",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "是的，怎么了？",
            "nextDialogs": [
              "740350424"
            ]
          },
          "740350424": {
            "id": "740350424",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "我稍后会拿着这张白条去找洛耶茨先生签字，然后再去找伊丝黛莱小姐核对账单。",
            "nextDialogs": [
              "740350425"
            ]
          },
          "740350425": {
            "id": "740350425",
            "speakerId": 1004,
            "speakerName": "柯妮莉娅",
            "text": "您就不用管这些事了，快点去买键帽吧，其他的事交给我处理就好。",
            "nextDialogs": [
              "740350426"
            ]
          },
          "740350426": {
            "id": "740350426",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "谢谢您。您真是太好了，柯妮莉娅小姐，我这就去买键帽…走吧旅行者，我们快出发。"
          }
        }
      }
    },
    {
      "subId": "7403506",
      "subQuestName": "找伊丝黛莱购买键帽",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740350601"
        ],
        "dialogs": {
          "740350601": {
            "id": "740350601",
            "speakerId": 1005,
            "speakerName": "伊丝黛莱",
            "text": "艾尤恩，有什么事吗？你怎么上气不接下气的…",
            "nextDialogs": [
              "740350602"
            ]
          },
          "740350602": {
            "id": "740350602",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "伊丝黛莱！快，快给我拿一个打字机的键帽！你这里应该有吧？",
            "nextDialogs": [
              "740350603"
            ]
          },
          "740350603": {
            "id": "740350603",
            "speakerId": 1005,
            "speakerName": "伊丝黛莱",
            "text": "有啊，但打字机有好多键帽呢，你自己来看看要哪一个吧。",
            "nextDialogs": [
              "740350604"
            ]
          },
          "740350604": {
            "id": "740350604",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "艾尤恩开始飞快地翻找起了自己要的键帽…",
            "nextDialogs": [
              "740350605"
            ]
          },
          "740350605": {
            "id": "740350605",
            "speakerId": 1003,
            "speakerName": "艾尤恩",
            "text": "就这个，我把钱放在这里了，谢谢了伊丝黛莱！",
            "nextDialogs": [
              "740350606"
            ]
          },
          "740350606": {
            "id": "740350606",
            "speakerId": 1005,
            "speakerName": "伊丝黛莱",
            "text": "你上次说要和我去划船…艾尤恩！喂！艾尤恩！"
          }
        }
      }
    },
    {
      "subId": "7403507",

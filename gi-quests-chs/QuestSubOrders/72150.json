  "subQuests": [
    {
      "subId": "7215001",
      "subQuestName": "(test)和NPC对话，获取特殊容器$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721500101"
        ],
        "dialogs": {
          "721500101": {
            "id": "721500101",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "你好，年轻人。看样子你是从岛外来的吧？",
            "nextDialogs": [
              "721500104"
            ]
          },
          "721500104": {
            "id": "721500104",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "想必你是游历四方的旅人吧？那么…不知是否有兴趣稍事停留，顺便占卜一下前路呢？",
            "nextDialogs": [
              "721500105"
            ]
          },
          "721500105": {
            "id": "721500105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，占卜前路…？"
          }
        }
      }
    },
    {
      "subId": "7215002",
      "subQuestName": "前往海祇岛的神社",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721500201"
        ],
        "dialogs": {
          "721500201": {
            "id": "721500201",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "你们回来了。",
            "nextDialogs": [
              "721500202"
            ]
          },
          "721500202": {
            "id": "721500202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你要的东西我们取回来了。",
            "nextDialogs": [
              "721500203"
            ]
          },
          "721500203": {
            "id": "721500203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是奉纳池的净水，还新鲜哦！",
            "nextDialogs": [
              "721500204"
            ]
          },
          "721500204": {
            "id": "721500204",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "真是太感谢你们了，我这就把水给「灵草」续上。",
            "nextDialogs": [
              "721500205"
            ]
          },
          "721500205": {
            "id": "721500205",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "之前说到哪里了来着…对，还需要一个步骤，「灵草」才能更加焕发光泽。",
            "nextDialogs": [
              "721500206"
            ]
          },
          "721500206": {
            "id": "721500206",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "只有在与深海水元素富集的环境中，「灵草」的茎叶才能足够舒展，其光彩才更能展现「愿望」的颜色。",
            "nextDialogs": [
              "721500207"
            ]
          },
          "721500207": {
            "id": "721500207",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "简而言之…在北方的一处洞窟里，存在着与其生存环境的水质最为近似的水元素。",
            "nextDialogs": [
              "721500208"
            ]
          },
          "721500208": {
            "id": "721500208",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "而在洞内不同的区域，其浓度也有所不同…其中呢，浓度最为理想的水元素是最为晶莹透明的。",
            "nextDialogs": [
              "721500209"
            ]
          },
          "721500209": {
            "id": "721500209",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "但假如变得浑浊了…比如被其他生物搅扰了，也是会很难办的…",
            "nextDialogs": [
              "721500210"
            ]
          },
          "721500210": {
            "id": "721500210",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "唉，我老了，不太好解释其中道理。",
            "nextDialogs": [
              "721500211"
            ]
          },
          "721500211": {
            "id": "721500211",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "到时候你们亲眼看到就会明白了，呵呵。",
            "nextDialogs": [
              "721500212"
            ]
          },
          "721500212": {
            "id": "721500212",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "那处洞窟同我们望泷村先祖的秘密息息相关…只可惜由于近来的战争，已罕有年轻人去那边取水滋养「灵草」了。",
            "nextDialogs": [
              "721500213"
            ]
          },
          "721500213": {
            "id": "721500213",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "唉…说起年轻人们，希望他们都能安全归来吧…",
            "nextDialogs": [
              "721500214"
            ]
          },
          "721500214": {
            "id": "721500214",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "话说回来，年轻人。如果你们要去那里取水的话，请一定注意安全。",
            "nextDialogs": [
              "721500215"
            ]
          },
          "721500215": {
            "id": "721500215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，小卷婆婆请放心啦！",
            "nextDialogs": [
              "721500218"
            ]
          },
          "721500218": {
            "id": "721500218",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "那就好，那就好…十分感谢你们。"
          }
        }
      }
    },

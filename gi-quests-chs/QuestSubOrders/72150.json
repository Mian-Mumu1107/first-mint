    {
      "subId": "7215003",
      "subQuestName": "获取「饱含心愿的水」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721500301"
        ],
        "dialogs": {
          "721500301": {
            "id": "721500301",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "哦哦，是你们呀，快来休息一下吧。",
            "nextDialogs": [
              "721500302"
            ]
          },
          "721500302": {
            "id": "721500302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小卷婆婆，我们把您说的水带回来啦！",
            "nextDialogs": [
              "721500303"
            ]
          },
          "721500303": {
            "id": "721500303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是您说的「最理想的水」吧。",
            "nextDialogs": [
              "721500304"
            ]
          },
          "721500304": {
            "id": "721500304",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "没错，这些就足够了。真是辛苦你们了…",
            "nextDialogs": [
              "721500305"
            ]
          },
          "721500305": {
            "id": "721500305",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "呵呵，精神了很多嘛…",
            "nextDialogs": [
              "721500306"
            ]
          },
          "721500306": {
            "id": "721500306",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "从「灵草」的光彩来看…来年一定是个和平富足的好年景。",
            "nextDialogs": [
              "721500307"
            ]
          },
          "721500307": {
            "id": "721500307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…这是怎么看出来的呀？",
            "nextDialogs": [
              "721500308"
            ]
          },
          "721500308": {
            "id": "721500308",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "「灵草」的光彩在于水的润泽，与众人「愿望」的滋养。",
            "nextDialogs": [
              "721500309"
            ]
          },
          "721500309": {
            "id": "721500309",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "这灵光正是大家愿望的宣示。愿望美好，光彩也就更鲜活，未来也就更有希望。",
            "nextDialogs": [
              "721500310"
            ]
          },
          "721500310": {
            "id": "721500310",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "毕竟…大家的愿望总是向着更好的明天吧。",
            "nextDialogs": [
              "721500311"
            ]
          },
          "721500311": {
            "id": "721500311",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "只要大家都有着为改善当前的生活而做点什么的愿望…",
            "nextDialogs": [
              "721500312"
            ]
          },
          "721500312": {
            "id": "721500312",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "或许相比而言，战争造成的种种困窘就算不得什么了。",
            "nextDialogs": [
              "721500313"
            ]
          },
          "721500313": {
            "id": "721500313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…所以这和它灵验与否有什么关系吗？",
            "nextDialogs": [
              "721500314"
            ]
          },
          "721500314": {
            "id": "721500314",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "当然…这就是我们老人的智慧。",
            "nextDialogs": [
              "721500315"
            ]
          },
          "721500315": {
            "id": "721500315",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "「愿望」驱使和鼓励人行动，而行动的成果反过来验证了人的「愿望」。",
            "nextDialogs": [
              "721500316"
            ]
          },
          "721500316": {
            "id": "721500316",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "只要我们又一次维护了生活的平和，只要从灰暗的日子里保护生活的希望…",
            "nextDialogs": [
              "721500317"
            ]
          },
          "721500317": {
            "id": "721500317",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "「灵草」的占卜就永远是灵验的。",
            "nextDialogs": [
              "721500320"
            ]
          },
          "721500320": {
            "id": "721500320",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "呵呵，年轻人总会理解的…",
            "nextDialogs": [
              "721500321"
            ]
          },
          "721500321": {
            "id": "721500321",
            "speakerId": 3194,
            "speakerName": "小卷",
            "text": "顺便一提，水中「愿望」的效力应该还能坚持些时日，两位愿意的话，可以随时来找我占卜哟。"
          }
        }
      }
    },

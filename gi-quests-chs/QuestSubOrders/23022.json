  "subQuests": [
    {
      "subId": "2302201",
      "subQuestName": "与拉菲克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230220101"
        ],
        "dialogs": {
          "230220101": {
            "id": "230220101",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "这里的强度要是再增加的话，就必须把这里…",
            "nextDialogs": [
              "230220102"
            ]
          },
          "230220102": {
            "id": "230220102",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "如果你采用这种设计，就和之前没什么本质区别了。",
            "nextDialogs": [
              "230220103"
            ]
          },
          "230220103": {
            "id": "230220103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们还在设计船吗？",
            "nextDialogs": [
              "230220104"
            ]
          },
          "230220104": {
            "id": "230220104",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "是你啊，旅行者。没错，在上次试航结束之后，我和绮珊又讨论了一些…嗯…关键节点上的设计。",
            "nextDialogs": [
              "230220105"
            ]
          },
          "230220105": {
            "id": "230220105",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "在我们…充分地交流后，正准备尝试一种新的设计方案。",
            "nextDialogs": [
              "230220106"
            ]
          },
          "230220106": {
            "id": "230220106",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "但是在材料使用上，我们又产生了一些分歧。",
            "nextDialogs": [
              "230220107"
            ]
          },
          "230220107": {
            "id": "230220107",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "不过这一次！我可是听了绮珊的意见，花大价钱买了一批好材料。",
            "nextDialogs": [
              "230220108"
            ]
          },
          "230220108": {
            "id": "230220108",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "旅行者，你看，我一个人搬不完，绮珊的力气也不大，你就…",
            "nextDialogs": [
              "230220111"
            ]
          },
          "230220111": {
            "id": "230220111",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "真是可靠，那我们赶紧出发吧。",
            "nextDialogs": [
              "230220112"
            ]
          },
          "230220112": {
            "id": "230220112",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "这次的材料可是绮珊亲自选的，应该不会出什么问题了…",
            "nextDialogs": [
              "230220113"
            ]
          },
          "230220113": {
            "id": "230220113",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "而且这次，我还给你准备了更多的报酬，真是谢谢你帮忙了…"
          }
        }
      }
    },
    {
      "subId": "2302202",
      "subQuestName": "前去拿取修船物资",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230220201"
        ],
        "dialogs": {
          "230220201": {
            "id": "230220201",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "…说服拉菲克多花点钱，比说服老板给我涨工资还困难。"
          }
        }
      }
    },
    {
      "subId": "2302203",
      "subQuestName": "前去拿取修船物资",
      "sceneId": null,
      "locations": [],

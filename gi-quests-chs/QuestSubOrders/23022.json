    },
    {
      "subId": "2302204",
      "subQuestName": "回去向拉菲克说明情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230220401"
        ],
        "dialogs": {
          "230220401": {
            "id": "230220401",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "怎么样，你把那些材料搬过来了吗？"
          }
        }
      }
    },
    {
      "subId": "2302205",
      "subQuestName": "回去向拉菲克说明情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230220501"
        ],
        "dialogs": {
          "230220501": {
            "id": "230220501",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "好…嘞！这些材料应该就够用了。这是你的报酬。",
            "nextDialogs": [
              "230220502"
            ]
          },
          "230220502": {
            "id": "230220502",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "不过，这些材料还真是轻啊…绮珊选的这些材料真的可靠吗…",
            "nextDialogs": [
              "230220503"
            ]
          },
          "230220503": {
            "id": "230220503",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "相信我，这些材料比你之前选的那些都好。",
            "nextDialogs": [
              "230220504"
            ]
          },
          "230220504": {
            "id": "230220504",
            "speakerId": 1000,
            "speakerName": "拉菲克",
            "text": "那这次，你要帮我准备好救生用具。",
            "nextDialogs": [
              "230220505"
            ]
          },
          "230220505": {
            "id": "230220505",
            "speakerId": 1001,
            "speakerName": "绮珊",
            "text": "…没问题的，你就相信我吧。"
          }
        }
      }
    },
    {

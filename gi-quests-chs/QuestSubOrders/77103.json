    {
      "subId": "7710307",
      "subQuestName": "调查下水道的控制室",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771580401"
        ],
        "dialogs": {
          "771580401": {
            "id": "771580401",
            "speakerId": 1003,
            "speakerName": "操作指南·其一",
            "text": "…须获得三重许可…取<color=#00E1FFFF>金、银、铁所制成【钥匙】</color>…分别置于三处…需插入凹槽内…",
            "nextDialogs": [
              "771580402"
            ]
          },
          "771580402": {
            "id": "771580402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "找到了！这个破破的封面上好像还写着名字…「莫罗医生」？呃啊，那个好心医生的手记？",
            "nextDialogs": [
              "771580403"
            ]
          },
          "771580403": {
            "id": "771580403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不管了，所以只要去三个地方找到<color=#00E1FFFF>金、银、铁三种【钥匙】</color>…",
            "nextDialogs": [
              "771580404"
            ]
          },
          "771580404": {
            "id": "771580404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…再插到这三个凹槽里，应该就可以出去了吧！"
          }
        }
      }
    },

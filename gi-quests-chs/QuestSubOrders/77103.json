        "dialogs": {
          "771030301": {
            "id": "771030301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼哼！还得看我！",
            "nextDialogs": [
              "771030302"
            ]
          },
          "771030302": {
            "id": "771030302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关键时候派蒙还是很有用的嘛！",
            "nextDialogs": [
              "771030303"
            ]
          },
          "771030303": {
            "id": "771030303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，难道建造这里的人也能飞来飞去？不然也太麻烦了吧！"
          }
        }
      }
    },

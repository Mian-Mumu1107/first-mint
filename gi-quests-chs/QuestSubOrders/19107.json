        ],
        "dialogs": {
          "191079701": {
            "id": "191079701",
            "speakerId": 10008,
            "speakerName": "康纳",
            "text": "埃泽先生，可这样真的…",
            "nextDialogs": [
              "191079702"
            ]
          },
          "191079702": {
            "id": "191079702",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "康纳，现在最重要的，是让小迪奥娜感受到我们的诚意，你明白吗？",
            "nextDialogs": [
              "191079703"
            ]
          },
          "191079703": {
            "id": "191079703",
            "speakerId": 10008,
            "speakerName": "康纳",
            "text": "明、明白了，埃泽先生！"
          }
        }
      }
    },
    {
      "subId": "1910798",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191079801"
        ],
        "dialogs": {
          "191079801": {
            "id": "191079801",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "康纳，你做得不错，继续保持这样，我们一定能把小迪奥娜请来晨曦酒庄做常驻调酒师！",
            "nextDialogs": [
              "191079802"
            ]
          },
          "191079802": {
            "id": "191079802",
            "speakerId": 10008,
            "speakerName": "康纳",
            "text": "希望能够真的成功，我连着好几周蹲守，才换来了这么一次巧遇…一定要把握住这次机会。",
            "nextDialogs": [
              "191079803"
            ]
          },
          "191079803": {
            "id": "191079803",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "真是辛苦你了，康纳。但只要能把小迪奥娜请来，我们付出的一切努力都是值得的，现在我们才迈出第一步。",
            "nextDialogs": [
              "191079804"
            ]
          },
          "191079804": {
            "id": "191079804",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "记住，一定要让小迪奥娜感受到我们的诚意，我们的热情！但记住，千万不要过于猛烈…",
            "nextDialogs": [
              "191079805"
            ]
          },
          "191079805": {
            "id": "191079805",
            "speakerId": 10008,
            "speakerName": "康纳",
            "text": "没问题，埃泽先生，这些我们俩都练过好多次了，这次一定…",
            "nextDialogs": [
              "191079806"
            ]
          },
          "191079806": {
            "id": "191079806",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在说什么呢…",
            "nextDialogs": [
              "191079807"
            ]
          },
          "191079807": {
            "id": "191079807",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "啊？！没、没什么，我们正…讨论一些和酒庄生意相关的事，哈哈哈…",
            "nextDialogs": [
              "191079808"
            ]
          },
          "191079808": {
            "id": "191079808",
            "speakerId": 10008,
            "speakerName": "康纳",
            "text": "是…对啊，我们正讨论酒庄生意的事呢，那个埃泽先生，我们再讨论一下最近酒庄的各项支出吧…"
          }
        }
      }
    },

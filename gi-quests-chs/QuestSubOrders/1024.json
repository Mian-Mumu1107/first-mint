    {
      "subId": "102408",
      "subQuestName": "寻找群玉阁引路人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10210301"
        ],
        "dialogs": {
          "10210301": {
            "id": "10210301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（按照刻晴教的，现在应该这样说…）",
            "nextDialogs": [
              "10210302"
            ]
          },
          "10210302": {
            "id": "10210302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好，这里卖月亮吗？",
            "nextDialogs": [
              "10210303"
            ]
          },
          "10210303": {
            "id": "10210303",
            "speakerId": 1001,
            "speakerName": "步云",
            "text": "是的，要几个？",
            "nextDialogs": [
              "10210304"
            ]
          },
          "10210304": {
            "id": "10210304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "数量不方便透露。",
            "nextDialogs": [
              "10210305"
            ]
          },
          "10210305": {
            "id": "10210305",
            "speakerId": 1001,
            "speakerName": "步云",
            "text": "答得好，二位请由此登阁。对了，二位就是凝光大人今天安排的客人吧？",
            "nextDialogs": [
              "10210306"
            ]
          },
          "10210306": {
            "id": "10210306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没错！",
            "nextDialogs": [
              "10210307"
            ]
          },
          "10210307": {
            "id": "10210307",
            "speakerId": 1001,
            "speakerName": "步云",
            "text": "（但这不是「客人」的暗号，而是「玉衡特许」的暗号。这又是怎么回事呢…）"
          }
        }
      }
    },
    {
      "subId": "102401",
      "subQuestName": "(test)传送到群玉阁（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "102402",
      "subQuestName": "(test)剧情对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10240201"
        ],
        "dialogs": {
          "10240201": {
            "id": "10240201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呼…呼…赶路赶得好累…",
            "nextDialogs": [
              "10240202"
            ]
          },
          "10240202": {
            "id": "10240202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "要不是出「黄金屋」的时候刚好看到「群玉阁」在天上飞，现在还根本不知道该往哪跑呢…",
            "nextDialogs": [
              "10240203"
            ]
          },
          "10240203": {
            "id": "10240203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们赶上了吗？「漩涡之魔神」还在海里、还没登陆璃月港吧？",
            "nextDialogs": [
              "10240204"
            ]
          },
          "10240204": {
            "id": "10240204",
            "speakerId": 1002,
            "speakerName": "魈",
            "text": "你们…怎么来了。",
            "nextDialogs": [
              "10240205"
            ]
          },
          "10240205": {
            "id": "10240205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？…啊！是仙人们！为什么你们会在「群玉阁」上？之前听说你们在和七星吵架…已经吵完了吗？",
            "nextDialogs": [
              "10240206"
            ]
          },
          "10240206": {
            "id": "10240206",
            "speakerId": 1003,
            "speakerName": "凝光",
            "text": "诸位仙家的意思是，当此危难之时，仙人与七星也该暂时放下不和，共同对敌。",
            "nextDialogs": [
              "10240207"
            ]
          },
          "10240207": {
            "id": "10240207",
            "speakerId": 1004,
            "speakerName": "削月筑阳真君",
            "text": "哼。",
            "nextDialogs": [
              "10240208"
            ]
          },
          "10240208": {
            "id": "10240208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来是这样。那么，现在大家的防御方案是什么？",
            "nextDialogs": [
              "10240209"
            ]
          },
          "10240209": {
            "id": "10240209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜…那个「漩涡之魔神」，只是从这么远的距离稍微看一眼，就觉得呼吸都有点不顺畅了。",
            "nextDialogs": [
              "10240210"
            ]
          },
          "10240210": {
            "id": "10240210",
            "speakerId": 1005,
            "speakerName": "刻晴",
            "text": "千岩军里有些新兵，已经连站都站不稳了。远古魔神的威压，看来对普通人的身体非常有害。",
            "nextDialogs": [
              "10240211"
            ]
          },
          "10240211": {
            "id": "10240211",
            "speakerId": 1005,
            "speakerName": "刻晴",
            "text": "——但正因如此，更不能让那怪物接近璃月港的平民！",
            "nextDialogs": [
              "10240212"
            ]
          },
          "10240212": {
            "id": "10240212",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好可怕…两千年前的魔神战争，就是在与这样的敌人战斗吗…",
            "nextDialogs": [
              "10240213"
            ]
          },
          "10240213": {
            "id": "10240213",
            "speakerId": 1002,
            "speakerName": "魈",
            "text": "……",
            "nextDialogs": [
              "10240214"
            ]
          },
          "10240214": {
            "id": "10240214",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "所以，靠现在在场的七星、千岩军，加上几位仙人的战力，能解决海里的那个魔神吗？",
            "nextDialogs": [
              "10240215"
            ]
          },
          "10240215": {
            "id": "10240215",
            "speakerId": 1003,
            "speakerName": "凝光",
            "text": "众仙家已经讨论过了，答案是…未必。",
            "nextDialogs": [
              "10240216"
            ]
          },
          "10240216": {
            "id": "10240216",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不会吧？！可…可你们是守护璃月的仙人，和守护璃月的七星啊！不能想想办法吗？",
            "nextDialogs": [
              "10240217"
            ]
          },
          "10240217": {
            "id": "10240217",
            "speakerId": 1006,
            "speakerName": "留云借风真君",
            "text": "那倒是可以的。",
            "nextDialogs": [
              "10240218"
            ]
          },
          "10240218": {
            "id": "10240218",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "10240219"
            ]
          },
          "10240219": {
            "id": "10240219",
            "speakerId": 1006,
            "speakerName": "留云借风真君",
            "text": "此前「归终机」一事，让七星动了心思、前去探究。",
            "nextDialogs": [
              "10240220"
            ]
          },
          "10240220": {
            "id": "10240220",
            "speakerId": 1006,
            "speakerName": "留云借风真君",
            "text": "而今身为「归终机」制造者的本仙，又恰好在此…",
            "nextDialogs": [
              "10240221"
            ]
          },
          "10240221": {
            "id": "10240221",
            "speakerId": 1006,
            "speakerName": "留云借风真君",
            "text": "仙家机关，你们凡人能研究出什么？但只要本仙对这老旧弩炮稍加改进，那就是你们难以想象的进化了。",
            "nextDialogs": [
              "10240222"
            ]
          },
          "10240222": {
            "id": "10240222",
            "speakerId": 1003,
            "speakerName": "凝光",
            "text": "呵呵…也算是一种「仙缘」吧。",
            "nextDialogs": [
              "10240223"
            ]
          },
          "10240223": {
            "id": "10240223",
            "speakerId": 1003,
            "speakerName": "凝光",
            "text": "如此一来，我们就能用「新归终机」对抗魔神。在场的诸位仙家，也都能够为它注入仙力。",
            "nextDialogs": [
              "10240224"
            ]
          },
          "10240224": {
            "id": "10240224",
            "speakerId": 1003,
            "speakerName": "凝光",
            "text": "事不宜迟，决战就在此时——开！"
          }
        }
      }
    },

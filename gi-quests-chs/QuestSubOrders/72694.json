  "subQuests": [
    {
      "subId": "7269401",
      "subQuestName": "前往稻妻的冒险家协会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726940101"
        ],
        "dialogs": {
          "726940101": {
            "id": "726940101",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "原来是旅行者和派蒙啊，真是正好！",
            "nextDialogs": [
              "726940102"
            ]
          },
          "726940102": {
            "id": "726940102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "正好什么呀？",
            "nextDialogs": [
              "726940103"
            ]
          },
          "726940103": {
            "id": "726940103",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "正好有一个很适合你们的任务，我正想联系你们呢。",
            "nextDialogs": [
              "726940104"
            ]
          },
          "726940104": {
            "id": "726940104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "很适合我们的任务…不会又是帮忙找东西，清理丘丘人之类的工作吧？",
            "nextDialogs": [
              "726940107"
            ]
          },
          "726940107": {
            "id": "726940107",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "不是不是，这次的任务确实十分适合你们，所谓「十分适合」的意思就是…",
            "nextDialogs": [
              "726940108"
            ]
          },
          "726940108": {
            "id": "726940108",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "这份工作不仅看上去十分有趣，而且还有丰厚的报酬。",
            "nextDialogs": [
              "726940109"
            ]
          },
          "726940109": {
            "id": "726940109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有丰厚的报酬！",
            "nextDialogs": [
              "726940110"
            ]
          },
          "726940110": {
            "id": "726940110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙自动忽略了有趣的部分呢。",
            "nextDialogs": [
              "726940111"
            ]
          },
          "726940111": {
            "id": "726940111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "当、当然，最主要是有趣啦，那到底是什么样的委托呢？",
            "nextDialogs": [
              "726940112"
            ]
          },
          "726940112": {
            "id": "726940112",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "嗯，这次的委托者是来稻妻做生意的枫丹制造商伯特兰，在寻找帮助他制造商品的助手。",
            "nextDialogs": [
              "726940113"
            ]
          },
          "726940113": {
            "id": "726940113",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "毕竟是生意人，在冒险者协会登记委托时填下的完成报酬一栏，数字可是相当可观。",
            "nextDialogs": [
              "726940114"
            ]
          },
          "726940114": {
            "id": "726940114",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "不过因为一些原因，他只能在「离岛」上活动。具体的详情就让他自己跟你们说吧。",
            "nextDialogs": [
              "726940115"
            ]
          },
          "726940115": {
            "id": "726940115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好，我们这就去「离岛」上找他！"
          }
        }
      }
    },
    {
      "subId": "7269402",
      "subQuestName": "前往离岛，寻找伯特兰",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726940201"
        ],
        "dialogs": {
          "726940201": {
            "id": "726940201",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "哼哼，一切都已经准备就绪，只要我一个玩具卖上个几千摩拉…卖上几万个！",
            "nextDialogs": [
              "726940202"
            ]
          },
          "726940202": {
            "id": "726940202",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "那不轻轻松松有几千万摩拉到手…嘿嘿嘿…",
            "nextDialogs": [
              "726940203"
            ]
          },
          "726940203": {
            "id": "726940203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！你就是伯特兰吗！",
            "nextDialogs": [
              "726940204"
            ]
          },
          "726940204": {
            "id": "726940204",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "啊？是啊，我就是。",
            "nextDialogs": [
              "726940205"
            ]
          },
          "726940205": {
            "id": "726940205",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "怎么了，两位，难道你们也是听闻我的消息，来购买我制造的玩具的吗？",
            "nextDialogs": [
              "726940206"
            ]
          },
          "726940206": {
            "id": "726940206",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "不过稍微有点可惜啊，不能立刻卖给你们，因为我们还没有开始大规模的生产。",
            "nextDialogs": [
              "726940207"
            ]
          },
          "726940207": {
            "id": "726940207",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "但是也不用急，现在生产线啊已经在筹备当中，如果有意向的话可以先进行登记并交付定金，等制造出来以后会通知您补足全款…",
            "nextDialogs": [
              "726940208"
            ]
          },
          "726940208": {
            "id": "726940208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等等等，我们不是来买玩具的。",
            "nextDialogs": [
              "726940209"
            ]
          },
          "726940209": {
            "id": "726940209",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "哦，这样…有什么事就快点说，别耽误我做生意。",
            "nextDialogs": [
              "726940210"
            ]
          },
          "726940210": {
            "id": "726940210",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "请长话短说，我的时间可是很宝贵的。",
            "nextDialogs": [
              "726940211"
            ]
          },
          "726940211": {
            "id": "726940211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，感觉这个人的态度一下就冷了下来。",
            "nextDialogs": [
              "726940214"
            ]
          },
          "726940214": {
            "id": "726940214",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "什么呀！哎呀，是来当助手的冒险家是吧，欢迎欢迎，嗨，原来是来帮忙的，你们早说嘛！",
            "nextDialogs": [
              "726940215"
            ]
          },
          "726940215": {
            "id": "726940215",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "对，在冒险家协会挂委托的就是我，请问你们怎么称呼啊。",
            "nextDialogs": [
              "726940216"
            ]
          },
          "726940216": {
            "id": "726940216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（感觉态度一下又变了…）",
            "nextDialogs": [
              "726940217"
            ]
          },
          "726940217": {
            "id": "726940217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我叫派蒙。",
            "nextDialogs": [
              "726940218"
            ]
          },
          "726940218": {
            "id": "726940218",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "那这位呢？",
            "nextDialogs": [
              "726940219"
            ]
          },
          "726940219": {
            "id": "726940219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#{NICKNAME}…",
            "nextDialogs": [
              "726940220"
            ]
          },
          "726940220": {
            "id": "726940220",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "#{NICKNAME}，总觉得是在哪里听过的名字，难道…你们也被通缉过？"
          }
        }
      }
    },
    {
      "subId": "7269403",
      "subQuestName": "在野外采集3个矿物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726940301"
        ],
        "dialogs": {
          "726940301": {
            "id": "726940301",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "用收集器完成「原材收集」了吗？原料对制作出来的玩具样式可是有很大影响的，可要想好了，哈哈哈。"
          }
        }
      }
    },
    {
      "subId": "7269405",
      "subQuestName": "在野外采集3朵花",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726940501"
        ],
        "dialogs": {
          "726940501": {
            "id": "726940501",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "如果卖出一个就能赚这些摩拉，那还上我欠的钱，只要卖出两万个就行了！",
            "nextDialogs": [
              "726940502"
            ]
          },
          "726940502": {
            "id": "726940502",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "还清欠款还不是轻轻松松的事…怎么了，你有什么事吗？",
            "nextDialogs": [
              "726940504",
              "726940506"
            ]
          },
          "726940504": {
            "id": "726940504",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "我准备卖玩具，不过…欸呀，真是不巧，商品还在筹备之中，等商品制作完成了，请务必要来这里看看…"
          },
          "726940506": {
            "id": "726940506",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "没事，那就不要打扰我，我正在进行很重要的商品筹备呢。"
          }
        }
      }
    },
    {
      "subId": "7269406",
      "subQuestName": "在野外采集6颗果实",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7269404",
      "subQuestName": "将收集器交给伯特兰",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726940401"
        ],
        "dialogs": {
          "726940401": {
            "id": "726940401",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "怎么样，材料收集得如何了？",
            "nextDialogs": [
              "726940402"
            ]
          },
          "726940402": {
            "id": "726940402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "全在收集器里了。",
            "nextDialogs": [
              "726940403"
            ]
          },
          "726940403": {
            "id": "726940403",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "好，现在我们把收集到的素材加入我的独一无二绝对稳定…",
            "nextDialogs": [
              "726940404"
            ]
          },
          "726940404": {
            "id": "726940404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「大工机」。",
            "nextDialogs": [
              "726940405"
            ]
          },
          "726940405": {
            "id": "726940405",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "好吧好吧，让我们把收集到的素材加入「大工机」…",
            "nextDialogs": [
              "726940406"
            ]
          },
          "726940406": {
            "id": "726940406",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "伯特兰将收集器插入「大工机」的槽口",
            "nextDialogs": [
              "726940407"
            ]
          },
          "726940407": {
            "id": "726940407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，然后呢？",
            "nextDialogs": [
              "726940408"
            ]
          },
          "726940408": {
            "id": "726940408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "待会儿这个机器就会咕嘟咕嘟运转起来，然后噼里啪啦地造出玩具来吗？",
            "nextDialogs": [
              "726940409"
            ]
          },
          "726940409": {
            "id": "726940409",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "哈哈哈，这当然是…",
            "nextDialogs": [
              "726940410"
            ]
          },
          "726940410": {
            "id": "726940410",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "不可能的。",
            "nextDialogs": [
              "726940411"
            ]
          },
          "726940411": {
            "id": "726940411",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "想什么呢，三个工序才完成了一个，离造出玩具还差得远呢。",
            "nextDialogs": [
              "726940412"
            ]
          },
          "726940412": {
            "id": "726940412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样啊，要工序全都完成才有玩具。",
            "nextDialogs": [
              "726940413"
            ]
          },
          "726940413": {
            "id": "726940413",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "对，要三个工序都依次完成一遍，才会产出玩具。",
            "nextDialogs": [
              "726940416"
            ]
          },
          "726940416": {
            "id": "726940416",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "你们啊，每天都想着速成。要对玩具制造的环节有耐心嘛，这中间的每一道制造工序，都要倾注制作者满满的…",
            "nextDialogs": [
              "726940417"
            ]
          },
          "726940417": {
            "id": "726940417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "满满的什么？我明白了，毕竟做的是「玩具」，所以要倾注制作者满满的热爱！",
            "nextDialogs": [
              "726940418"
            ]
          },
          "726940418": {
            "id": "726940418",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "对，要倾注我对摩拉满满的热爱。",
            "nextDialogs": [
              "726940419"
            ]
          },
          "726940419": {
            "id": "726940419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，虽然跟想象的不一样，但这样的热爱我也有。",
            "nextDialogs": [
              "726940420"
            ]
          },
          "726940420": {
            "id": "726940420",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "喂…",
            "nextDialogs": [
              "726940421"
            ]
          },
          "726940421": {
            "id": "726940421",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，就顺势一说嘛。",
            "nextDialogs": [
              "726940422"
            ]
          },
          "726940422": {
            "id": "726940422",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那伯特兰，我们接下来要去做什么，接着完成后面的工序吗？",
            "nextDialogs": [
              "726940423"
            ]
          },
          "726940423": {
            "id": "726940423",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "不着急不着急，因为是调整过后的机器，还没有按照这个工序跑过，我先看看机器处理这些素材时有没有问题。",
            "nextDialogs": [
              "726940424"
            ]
          },
          "726940424": {
            "id": "726940424",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "这得观察一会儿，你们过段时间再来找我吧。"
          }
        }
      }
    }
  ]
}
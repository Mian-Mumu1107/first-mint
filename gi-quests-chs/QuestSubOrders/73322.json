  },
  "subQuests": [
    {
      "subId": "7332207",
      "subQuestName": "(test)拯救花田$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733220701"
        ],
        "dialogs": {
          "733220701": {
            "id": "733220701",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "唉…这就是黯色侵蚀的余威吗？",
            "nextDialogs": [
              "733220702"
            ]
          },
          "733220702": {
            "id": "733220702",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "太顽固了，再怎么努力也无济于事…",
            "nextDialogs": [
              "733220703"
            ]
          },
          "733220703": {
            "id": "733220703",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "瑟法娜，好久不见啊。",
            "nextDialogs": [
              "733220704"
            ]
          },
          "733220704": {
            "id": "733220704",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "等等…我没看错吧，是斯露莎姐姐？你居然回来了！",
            "nextDialogs": [
              "733220705"
            ]
          },
          "733220705": {
            "id": "733220705",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "「净觉花」有救了…呜啊…我苦等这么久，总算看到希望了！",
            "nextDialogs": [
              "733220706"
            ]
          },
          "733220706": {
            "id": "733220706",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "你不会再突然离开吧？不会一去就是好久好久吧？不会的吧？",
            "nextDialogs": [
              "733220707"
            ]
          },
          "733220707": {
            "id": "733220707",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "别激动啊，瑟法娜！我肯定会帮你挽救「净觉花」，你就放心吧！",
            "nextDialogs": [
              "733220708"
            ]
          },
          "733220708": {
            "id": "733220708",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "#这位是我的「谒颂主」{NICKNAME}，和{M#他}{F#她}的伙伴派蒙。",
            "nextDialogs": [
              "733220709"
            ]
          },
          "733220709": {
            "id": "733220709",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "我们已经熄灭了「焚真之天象」，从黯色的侵蚀中解救过花池了。余下的花池，也都交给我们吧。",
            "nextDialogs": [
              "733220710"
            ]
          },
          "733220710": {
            "id": "733220710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好干脆的交流！瑟法娜还管斯露莎叫姐姐，看来你们以前的关系还挺亲密的嘛？",
            "nextDialogs": [
              "733220711"
            ]
          },
          "733220711": {
            "id": "733220711",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "亲密？那还不至于…只不过相处过一段时间，交流过不少心得…",
            "nextDialogs": [
              "733220712"
            ]
          },
          "733220712": {
            "id": "733220712",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "虽然不知道为什么，斯露莎姐姐说话的方式有点不一样了，但以前她可是很照顾我的！",
            "nextDialogs": [
              "733220713"
            ]
          },
          "733220713": {
            "id": "733220713",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "她在「净觉花」前，发出「目标是比肩西摩格」的宣言时…比什么心得都能鼓舞我。",
            "nextDialogs": [
              "733220714"
            ]
          },
          "733220714": {
            "id": "733220714",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "从那时起，我就觉得，斯露莎姐姐的意志真可敬。",
            "nextDialogs": [
              "733220715"
            ]
          },
          "733220715": {
            "id": "733220715",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "所以我才学着人类对同辈长者的称谓，如此称呼她，这代表着我的敬意！",
            "nextDialogs": [
              "733220716"
            ]
          },
          "733220716": {
            "id": "733220716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "瑟法娜这么一说，我的脑袋里不知怎么就浮现出画面了…",
            "nextDialogs": [
              "733220717"
            ]
          },
          "733220717": {
            "id": "733220717",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "别，别突然提起那么久远的事啊！",
            "nextDialogs": [
              "733220720"
            ]
          },
          "733220720": {
            "id": "733220720",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "对哦，斯露莎姐姐的「谒颂主」或许不怎么了解「净觉花」？那我就借前辈们的话介绍一下…",
            "nextDialogs": [
              "733220721"
            ]
          },
          "733220721": {
            "id": "733220721",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "曾有一位花灵如此诵唱——",
            "nextDialogs": [
              "733220722"
            ]
          },
          "733220722": {
            "id": "733220722",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "「这凝明的色彩，是生命之泉流转的灵迹」…",
            "nextDialogs": [
              "733220723"
            ]
          },
          "733220723": {
            "id": "733220723",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "「伴我长存，与我妙舞清歌，编织悠久的欢欣」…",
            "nextDialogs": [
              "733220724"
            ]
          },
          "733220724": {
            "id": "733220724",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "…后边忘了。",
            "nextDialogs": [
              "733220725"
            ]
          },
          "733220725": {
            "id": "733220725",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "这段时间一直在清除残余的黯色力量，太累了，意识有点模糊…",
            "nextDialogs": [
              "733220726"
            ]
          },
          "733220726": {
            "id": "733220726",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不用勉强自己哦，典故什么的记不起来也没关系，就用轻松一点的说法嘛！",
            "nextDialogs": [
              "733220727"
            ]
          },
          "733220727": {
            "id": "733220727",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "那我想想…「净觉花」虽不是「甘露花海」中最为珍贵之物，但确是我们花灵极为重视的「伴侣」。",
            "nextDialogs": [
              "733220728"
            ]
          },
          "733220728": {
            "id": "733220728",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "许多花灵在完成了每天应尽的职责后，就会与「净觉花」为伴。",
            "nextDialogs": [
              "733220729"
            ]
          },
          "733220729": {
            "id": "733220729",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "在人类眼中就像…自小就一直陪着他们成长的…歌声是「喵喵」和「汪汪」的生灵。",
            "nextDialogs": [
              "733220730"
            ]
          },
          "733220730": {
            "id": "733220730",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "猫猫和狗狗？",
            "nextDialogs": [
              "733220731"
            ]
          },
          "733220731": {
            "id": "733220731",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样，如果陪着我长大的猫猫狗狗生病了，我也会很难过吧。",
            "nextDialogs": [
              "733220732"
            ]
          },
          "733220732": {
            "id": "733220732",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "更别说，生活中只有猫猫狗狗当朋友了…",
            "nextDialogs": [
              "733220733"
            ]
          },
          "733220733": {
            "id": "733220733",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "瑟法娜这么一描述，我就能理解你的急切了，「净觉花」的健康确实超级重要！",
            "nextDialogs": [
              "733220734"
            ]
          },
          "733220734": {
            "id": "733220734",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "唔，其实重要性远在这之上，瑟法娜还是不太擅长打比方啊。",
            "nextDialogs": [
              "733220735"
            ]
          },
          "733220735": {
            "id": "733220735",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "意思已经传达到了，现在我明白了问题的严重性，斯露莎也这么主动，事不宜迟，我们赶快出发吧！"
          }
        }
      }
    },
    {
      "subId": "7332208",
      "subQuestName": "(test)恢复生机$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733220801"
        ],
        "dialogs": {
          "733220801": {
            "id": "733220801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们回来啦，瑟法娜！",
            "nextDialogs": [
              "733220802"
            ]
          },
          "733220802": {
            "id": "733220802",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "「净觉花」已悉数摆脱污秽的侵蚀，汝也不必惶恐了，瑟法娜。",
            "nextDialogs": [
              "733220803"
            ]
          },
          "733220803": {
            "id": "733220803",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "好厉害，不愧是斯露莎姐姐！这么多年来一直无比可靠！",
            "nextDialogs": [
              "733220804"
            ]
          },
          "733220804": {
            "id": "733220804",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "#「谒颂主」{NICKNAME}大人，也有劳你了！我给你准备了谢礼——",
            "nextDialogs": [
              "733220805"
            ]
          },
          "733220805": {
            "id": "733220805",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "我在照顾「净觉花」的路上，捡到了亮晶晶金闪闪的东西，听说每个人类和他们的喵喵汪汪都喜欢…",
            "nextDialogs": [
              "733220806"
            ]
          },
          "733220806": {
            "id": "733220806",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道是…摩拉？那我确实不讨厌！",
            "nextDialogs": [
              "733220807"
            ]
          },
          "733220807": {
            "id": "733220807",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "斯露莎姐姐想要什么谢礼呢？",
            "nextDialogs": [
              "733220808"
            ]
          },
          "733220808": {
            "id": "733220808",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "肤浅，瑟法娜！完成伟业才是吾心系之事，无需费心感谢吾，悉心照料汝的躯体与「净觉花」便好。",
            "nextDialogs": [
              "733220809"
            ]
          },
          "733220809": {
            "id": "733220809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "意思是，瑟法娜不用和斯露莎客气，照顾好自己就可以了？这句话倒还挺像个姐姐欸…",
            "nextDialogs": [
              "733220812"
            ]
          },
          "733220812": {
            "id": "733220812",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "胡乱猜测！吾只是在述说瑟法娜的职责，给她警示罢了！",
            "nextDialogs": [
              "733220813"
            ]
          },
          "733220813": {
            "id": "733220813",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "以尔等人类能理解的概念而言，「净觉花」与吾辈花灵皆诞生于万种母树的甘露，是同源的「家人」。",
            "nextDialogs": [
              "733220814"
            ]
          },
          "733220814": {
            "id": "733220814",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "守候「净觉花」的花灵终日面对污秽之物的侵袭，当然要时刻注意躯壳的劳损。",
            "nextDialogs": [
              "733220815"
            ]
          },
          "733220815": {
            "id": "733220815",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "瑟法娜虽有失职之处，但守候「净觉花」的时日不短，倒也不可否认她的苦劳。"
          }
        }
      }
    },
    {
      "subId": "7332210",
      "subQuestName": "(test)精灵花朵盛开$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733221001"
        ],
        "dialogs": {
          "733221001": {
            "id": "733221001",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "虽说黯色的力量还在肆虐…但所有花池都受到了净化，恢复了生机…",
            "nextDialogs": [
              "733221002"
            ]
          },
          "733221002": {
            "id": "733221002",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "怎么回事呢？有谁在帮我吗？",
            "nextDialogs": [
              "733221003"
            ]
          },
          "733221003": {
            "id": "733221003",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "如果真是这样，或许我和花池们也获得了万种母树的庇佑…真是太幸运了！",
            "nextDialogs": [
              "733221004"
            ]
          },
          "733221004": {
            "id": "733221004",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "瑟法娜，好久不见啊。",
            "nextDialogs": [
              "733221005"
            ]
          },
          "733221005": {
            "id": "733221005",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "等等，我没看错吧…是斯露莎姐姐？你居然回来了！",
            "nextDialogs": [
              "733221006"
            ]
          },
          "733221006": {
            "id": "733221006",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "你不会再突然离开吧？不会一去就是好久好久吧？不会的吧？",
            "nextDialogs": [
              "733221007"
            ]
          },
          "733221007": {
            "id": "733221007",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "#冷静，吾的去留不是重点！这次，吾与「谒颂主」{NICKNAME}来通知你，吾等弥补了汝的过失。",
            "nextDialogs": [
              "733221008"
            ]
          },
          "733221008": {
            "id": "733221008",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "吾正遂行熄灭「焚真之天象」的伟业，顺势祓除了黯色的侵蚀，解救了所有花池。但汝务必牢记，这是汝的失职！",
            "nextDialogs": [
              "733221009"
            ]
          },
          "733221009": {
            "id": "733221009",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "原，原来是斯露莎姐姐的功劳！",
            "nextDialogs": [
              "733221010"
            ]
          },
          "733221010": {
            "id": "733221010",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "我…我明白自己的过错了…",
            "nextDialogs": [
              "733221011"
            ]
          },
          "733221011": {
            "id": "733221011",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "实在感谢你们…我可以松口气了…一直以来的不安全都消散了！",
            "nextDialogs": [
              "733221012"
            ]
          },
          "733221012": {
            "id": "733221012",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "瑟法娜居然管斯露莎叫姐姐呢，这个姐姐未免也太严厉了，根本让人喜欢不起来嘛…",
            "nextDialogs": [
              "733221013"
            ]
          },
          "733221013": {
            "id": "733221013",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "何等幼稚！前辈对于后辈，自然是要多加提点的，怎么能看着她们犯错，还温声细语！",
            "nextDialogs": [
              "733221014"
            ]
          },
          "733221014": {
            "id": "733221014",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "没…没错！以前斯露莎姐姐可是很照顾我的！",
            "nextDialogs": [
              "733221015"
            ]
          },
          "733221015": {
            "id": "733221015",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "斯露莎姐姐在「净觉花」前，发出「目标是比肩西摩格」的宣言时…比什么心得都能鼓舞我。",
            "nextDialogs": [
              "733221016"
            ]
          },
          "733221016": {
            "id": "733221016",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "从那时起，我就觉得，斯露莎姐姐的意志真可敬。",
            "nextDialogs": [
              "733221017"
            ]
          },
          "733221017": {
            "id": "733221017",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "所以我才学着人类对同辈长者的称谓，如此称呼她，这代表着我的敬意！",
            "nextDialogs": [
              "733221018"
            ]
          },
          "733221018": {
            "id": "733221018",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是个性格和善的花灵啊…完全想象不出斯露莎被其他花灵严厉管教后，还亲切地叫对方「姐姐」的场景…",
            "nextDialogs": [
              "733221019"
            ]
          },
          "733221019": {
            "id": "733221019",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "多…多嘴！",
            "nextDialogs": [
              "733221022"
            ]
          },
          "733221022": {
            "id": "733221022",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "对哦，斯露莎姐姐的「谒颂主」或许不怎么了解「净觉花」？那我就借前辈们的话介绍一下…",
            "nextDialogs": [
              "733221023"
            ]
          },
          "733221023": {
            "id": "733221023",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "曾有一位花灵如此诵唱——",
            "nextDialogs": [
              "733221024"
            ]
          },
          "733221024": {
            "id": "733221024",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "「这凝明的色彩，是生命之泉流转的灵迹」…",
            "nextDialogs": [
              "733221025"
            ]
          },
          "733221025": {
            "id": "733221025",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "「伴我长存，与我妙舞清歌，编织悠久的欢欣」…",
            "nextDialogs": [
              "733221026"
            ]
          },
          "733221026": {
            "id": "733221026",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "…后边忘了。",
            "nextDialogs": [
              "733221027"
            ]
          },
          "733221027": {
            "id": "733221027",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "这段时间一直在抵抗污秽的侵袭，太累了，意识有点模糊。",
            "nextDialogs": [
              "733221028"
            ]
          },
          "733221028": {
            "id": "733221028",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不用勉强自己哦，典故什么的记不起来也没关系，就用轻松一点的说法嘛！",
            "nextDialogs": [
              "733221029"
            ]
          },
          "733221029": {
            "id": "733221029",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "那我想想…「净觉花」虽不是「甘露花海」中最为珍贵之物，但确是我们花灵极为重视的「伴侣」。",
            "nextDialogs": [
              "733221030"
            ]
          },
          "733221030": {
            "id": "733221030",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "许多花灵在完成了每天应尽的职责后，就会与「净觉花」为伴。",
            "nextDialogs": [
              "733221031"
            ]
          },
          "733221031": {
            "id": "733221031",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "在人类眼中就像…自小就一直陪着他们成长的…歌声是「喵喵」和「汪汪」的生灵。",
            "nextDialogs": [
              "733221032"
            ]
          },
          "733221032": {
            "id": "733221032",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "猫猫和狗狗？",
            "nextDialogs": [
              "733221033"
            ]
          },
          "733221033": {
            "id": "733221033",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样，如果陪着我长大的猫猫狗狗生病了，我也会很难过吧。",
            "nextDialogs": [
              "733221034"
            ]
          },
          "733221034": {
            "id": "733221034",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "更别说，生活中只有猫猫狗狗当朋友了…",
            "nextDialogs": [
              "733221035"
            ]
          },
          "733221035": {
            "id": "733221035",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "瑟法娜这么一描述，我就能理解了，「净觉花」的健康确实超级重要！我们之前的辛苦都没有白费！",
            "nextDialogs": [
              "733221036"
            ]
          },
          "733221036": {
            "id": "733221036",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "真是粗浅的比喻，其实「净觉花」的重要性远在这之上，瑟法娜还是需要修习言辞的门道啊。",
            "nextDialogs": [
              "733221037"
            ]
          },
          "733221037": {
            "id": "733221037",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "话说回来，这次不仅劳烦了斯露莎姐姐，还有第一次见面的「谒颂主」大人，我得好好准备给你们的谢礼…",
            "nextDialogs": [
              "733221038"
            ]
          },
          "733221038": {
            "id": "733221038",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "我在照顾「净觉花」的路上，捡到了亮晶晶金闪闪的东西，听说每个人类和他们的喵喵汪汪都喜欢…",
            "nextDialogs": [
              "733221039"
            ]
          },
          "733221039": {
            "id": "733221039",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道是…摩拉？那我确实不讨厌！",
            "nextDialogs": [
              "733221040"
            ]
          },
          "733221040": {
            "id": "733221040",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "斯露莎姐姐想要什么谢礼呢？",
            "nextDialogs": [
              "733221041"
            ]
          },
          "733221041": {
            "id": "733221041",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "肤浅，瑟法娜！完成伟业才是吾心系之事，无需费心感谢吾，悉心照料汝的躯体与「净觉花」便好。",
            "nextDialogs": [
              "733221042"
            ]
          },
          "733221042": {
            "id": "733221042",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "意思是，瑟法娜不用和斯露莎客气，照顾好自己就可以了？这句话倒还挺像个姐姐欸…"
          }
        }
      }
    },
    {
      "subId": "7332202",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733220202"
        ],
        "dialogs": {
          "733220202": {
            "id": "733220202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（test)你看那里出现了一朵花！司露莎好像能感觉到这里有一些不寻常的景象...",
            "nextDialogs": [
              "733220203"
            ]
          },
          "733220203": {
            "id": "733220203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（test）我们过去看看吧"
          }
        }
      }
    },
    {
      "subId": "7332205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733220501"
        ],
        "dialogs": {
          "733220501": {
            "id": "733220501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，斯露莎还挺厉害的嘛，一下子就让周围焕发了生机！",
            "nextDialogs": [
              "733220502"
            ]
          },
          "733220502": {
            "id": "733220502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "花灵的力量真奇妙。",
            "nextDialogs": [
              "733220503"
            ]
          },
          "733220503": {
            "id": "733220503",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "大惊小怪！以吾之威能，拯救「净觉花」不过是举手之劳！",
            "nextDialogs": [
              "733220504"
            ]
          },
          "733220504": {
            "id": "733220504",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "黯色的侵蚀还在扩张，这片「净觉花」只不过是诸多受害者之一…",
            "nextDialogs": [
              "733220505"
            ]
          },
          "733220505": {
            "id": "733220505",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "其他花池也没法幸免于难，瑟法娜想必正手忙脚乱，惊慌失措吧。",
            "nextDialogs": [
              "733220506"
            ]
          },
          "733220506": {
            "id": "733220506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来，你说的瑟法娜，应该是个勤勤恳恳照顾花儿们的好花灵？",
            "nextDialogs": [
              "733220507"
            ]
          },
          "733220507": {
            "id": "733220507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我们就帮帮那位花灵吧，{NICKNAME}？",
            "nextDialogs": [
              "733220508"
            ]
          },
          "733220508": {
            "id": "733220508",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "这点功绩，作为伟业正道旁的小小装点倒也无妨。吾之「谒颂主」，你就多多留意这样的「净觉花」吧。",
            "nextDialogs": [
              "733220509"
            ]
          },
          "733220509": {
            "id": "733220509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "下次看到了就通知你。",
            "nextDialogs": [
              "733220510"
            ]
          },
          "733220510": {
            "id": "733220510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们一起拯救这些漂亮的花！"
          }
        }
      }
    },
    {
      "subId": "7332206",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733220699"
        ],
        "dialogs": {
          "733220699": {
            "id": "733220699",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "唉…这就是黯色的力量吗？"
          }
        }
      }
    },
    {
      "subId": "7332209",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733220901"
        ],
        "dialogs": {
          "733220901": {
            "id": "733220901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们回来啦，瑟法娜！",
            "nextDialogs": [
              "733220902"
            ]
          },
          "733220902": {
            "id": "733220902",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "所有「净觉花」都重焕生机了，瑟法娜，你不用再害怕了。",
            "nextDialogs": [
              "733220903"
            ]
          },
          "733220903": {
            "id": "733220903",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "好厉害，不愧是斯露莎姐姐！这么多年来，一直无比可靠！",
            "nextDialogs": [
              "733220904"
            ]
          },
          "733220904": {
            "id": "733220904",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "#「谒颂主」{NICKNAME}大人，也有劳你了！我给你准备了谢礼——",
            "nextDialogs": [
              "733220905"
            ]
          },
          "733220905": {
            "id": "733220905",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "我在照顾「净觉花」的路上，捡到了亮晶晶金闪闪的东西，听说每个人类和他们的喵喵汪汪都喜欢…",
            "nextDialogs": [
              "733220906"
            ]
          },
          "733220906": {
            "id": "733220906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道是…摩拉？那我确实不讨厌！",
            "nextDialogs": [
              "733220907"
            ]
          },
          "733220907": {
            "id": "733220907",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "斯露莎姐姐想要什么谢礼呢？",
            "nextDialogs": [
              "733220908"
            ]
          },
          "733220908": {
            "id": "733220908",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "我就不用了，瑟法娜，照顾好你自己和「净觉花」就行。",
            "nextDialogs": [
              "733220909"
            ]
          },
          "733220909": {
            "id": "733220909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "斯露莎居然会有这么客气的时候，真的像个姐姐欸…你们俩的关系果然很好！",
            "nextDialogs": [
              "733220912"
            ]
          },
          "733220912": {
            "id": "733220912",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "没有那种事啦！我真心想让瑟法娜对自己再好一点！",
            "nextDialogs": [
              "733220913"
            ]
          },
          "733220913": {
            "id": "733220913",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "毕竟，用人类的话来说，「净觉花」与花灵都诞生于万种母树的甘露，是同源的「家人」。",
            "nextDialogs": [
              "733220914"
            ]
          },
          "733220914": {
            "id": "733220914",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "照顾它们的花灵每天都要抵抗污秽之物的侵袭，承担着巨大的压力。",
            "nextDialogs": [
              "733220915"
            ]
          },
          "733220915": {
            "id": "733220915",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "瑟法娜很坚强，独自面对了这一切。一直以来，她对我的敬意，也值得回以关切。"
          }
        }
      }
    },
    {
      "subId": "7332211",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733221101"
        ],
        "dialogs": {
          "733221101": {
            "id": "733221101",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "黯色的力量不知不觉就消失了…所有花池都恢复了生机…",
            "nextDialogs": [
              "733221102"
            ]
          },
          "733221102": {
            "id": "733221102",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "怎么回事呢？难道是那场雨的功效吗？",
            "nextDialogs": [
              "733221103"
            ]
          },
          "733221103": {
            "id": "733221103",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "如果真是这样，说明我和花池们也获得了万种母树的恩惠，真是太幸运了！",
            "nextDialogs": [
              "733221104"
            ]
          },
          "733221104": {
            "id": "733221104",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "瑟法娜，好久不见啊。",
            "nextDialogs": [
              "733221105"
            ]
          },
          "733221105": {
            "id": "733221105",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "等等…我没看错吧，是斯露莎姐姐？你居然回来了！",
            "nextDialogs": [
              "733221106"
            ]
          },
          "733221106": {
            "id": "733221106",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "你不会再突然离开吧？不会一去就是好久好久吧？不会的吧？",
            "nextDialogs": [
              "733221107"
            ]
          },
          "733221107": {
            "id": "733221107",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "别激动啊，瑟法娜！",
            "nextDialogs": [
              "733221108"
            ]
          },
          "733221108": {
            "id": "733221108",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "#这位是我的「谒颂主」{NICKNAME}，和{M#他}{F#她}的伙伴派蒙，这次我们专程来看望你，还给你带来了一个好消息。",
            "nextDialogs": [
              "733221109"
            ]
          },
          "733221109": {
            "id": "733221109",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "我们已经熄灭了「焚真之天象」，从黯色的侵蚀中解救了所有的「净觉花」，让它们重新焕发了生机，你就放心吧！",
            "nextDialogs": [
              "733221110"
            ]
          },
          "733221110": {
            "id": "733221110",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "原，原来是斯露莎姐姐的功劳！",
            "nextDialogs": [
              "733221111"
            ]
          },
          "733221111": {
            "id": "733221111",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "实在太感谢你们了…我好感动…一直以来的不安全都消散了！",
            "nextDialogs": [
              "733221112"
            ]
          },
          "733221112": {
            "id": "733221112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好干脆的交流！瑟法娜还管斯露莎叫姐姐，看来你们以前的关系还挺亲密的嘛？",
            "nextDialogs": [
              "733221113"
            ]
          },
          "733221113": {
            "id": "733221113",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "亲密？那还不至于…只不过相处过一段时间，交流过不少心得。",
            "nextDialogs": [
              "733221114"
            ]
          },
          "733221114": {
            "id": "733221114",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "虽然不知道为什么，斯露莎姐姐说话的方式有点不一样了，但以前她可是很照顾我的！",
            "nextDialogs": [
              "733221115"
            ]
          },
          "733221115": {
            "id": "733221115",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "她在「净觉花」前，发出「目标是比肩西摩格」的宣言时…比什么心得都能鼓舞我。",
            "nextDialogs": [
              "733221116"
            ]
          },
          "733221116": {
            "id": "733221116",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "从那时起，我就觉得，斯露莎姐姐的意志真可敬。",
            "nextDialogs": [
              "733221117"
            ]
          },
          "733221117": {
            "id": "733221117",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "所以我才学着人类对同辈长者的称谓，如此称呼她，这代表着我的敬意！",
            "nextDialogs": [
              "733221118"
            ]
          },
          "733221118": {
            "id": "733221118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "瑟法娜这么一说，我的脑袋里不知怎么就浮现出画面了…",
            "nextDialogs": [
              "733221119"
            ]
          },
          "733221119": {
            "id": "733221119",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "别，别突然提起那么久远的事啊！",
            "nextDialogs": [
              "733221122"
            ]
          },
          "733221122": {
            "id": "733221122",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "对哦，斯露莎姐姐的「谒颂主」大人或许不怎么了解「净觉花」？那我就借前辈们的话介绍一下…",
            "nextDialogs": [
              "733221123"
            ]
          },
          "733221123": {
            "id": "733221123",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "曾有一位花灵如此诵唱——",
            "nextDialogs": [
              "733221124"
            ]
          },
          "733221124": {
            "id": "733221124",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "「这凝明的色彩，是生命之泉流转的灵迹」…",
            "nextDialogs": [
              "733221125"
            ]
          },
          "733221125": {
            "id": "733221125",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "「伴我长存，与我妙舞清歌，编织悠久的欢欣」…",
            "nextDialogs": [
              "733221126"
            ]
          },
          "733221126": {
            "id": "733221126",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "…后边忘了。",
            "nextDialogs": [
              "733221127"
            ]
          },
          "733221127": {
            "id": "733221127",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "这段时间一直在清除残余的黯色力量，太累了，意识有点模糊…",
            "nextDialogs": [
              "733221128"
            ]
          },
          "733221128": {
            "id": "733221128",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不用勉强自己，典故什么的记不起来也没关系，就用轻松一点的说法嘛！",
            "nextDialogs": [
              "733221129"
            ]
          },
          "733221129": {
            "id": "733221129",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "那我想想…「净觉花」虽不是「甘露花海」中最为珍贵之物，但确是我们花灵极为重视的「伴侣」。",
            "nextDialogs": [
              "733221130"
            ]
          },
          "733221130": {
            "id": "733221130",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "许多花灵在完成了每天应尽的职责后，就会与「净觉花」为伴。",
            "nextDialogs": [
              "733221131"
            ]
          },
          "733221131": {
            "id": "733221131",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "在人类眼中就像…自小就一直陪着他们成长的…歌声是「喵喵」和「汪汪」的生灵。",
            "nextDialogs": [
              "733221132"
            ]
          },
          "733221132": {
            "id": "733221132",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "猫猫和狗狗？",
            "nextDialogs": [
              "733221133"
            ]
          },
          "733221133": {
            "id": "733221133",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样，如果陪着我长大的猫猫狗狗生病了，我也会很难过吧。",
            "nextDialogs": [
              "733221134"
            ]
          },
          "733221134": {
            "id": "733221134",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "更别说，生活中只有猫猫狗狗当朋友了…",
            "nextDialogs": [
              "733221135"
            ]
          },
          "733221135": {
            "id": "733221135",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "瑟法娜这么一描述，我就能理解了，「净觉花」的健康确实超级重要！我们之前的辛苦都没有白费！",
            "nextDialogs": [
              "733221136"
            ]
          },
          "733221136": {
            "id": "733221136",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "唔，其实远在这之上，瑟法娜还是不太擅长打比方啊…",
            "nextDialogs": [
              "733221137"
            ]
          },
          "733221137": {
            "id": "733221137",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "话说回来，这次不仅劳烦了斯露莎姐姐，还有第一次见面的「谒颂主」大人，我得好好准备给你们的谢礼…",
            "nextDialogs": [
              "733221138"
            ]
          },
          "733221138": {
            "id": "733221138",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "我在照顾「净觉花」的路上，捡到了亮晶晶金闪闪的东西，听说每个人类和他们的喵喵汪汪都喜欢…",
            "nextDialogs": [
              "733221139"
            ]
          },
          "733221139": {
            "id": "733221139",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道是…摩拉？那我确实不讨厌！",
            "nextDialogs": [
              "733221140"
            ]
          },
          "733221140": {
            "id": "733221140",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "斯露莎姐姐想要什么谢礼呢？",
            "nextDialogs": [
              "733221141"
            ]
          },
          "733221141": {
            "id": "733221141",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "我就不用了，瑟法娜，照顾好你自己和「净觉花」就行。",
            "nextDialogs": [
              "733221142"
            ]
          },
          "733221142": {
            "id": "733221142",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "斯露莎居然会有这么客气的时候，真的像个姐姐欸…你们俩的关系果然很好！"
          }
        }
      }
    },
    {
      "subId": "7332212",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733221201"
        ],
        "dialogs": {
          "733221201": {
            "id": "733221201",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "斯露莎姐姐肯定还记得让「净觉花」重焕生机的方法。",
            "nextDialogs": [
              "733221202"
            ]
          },
          "733221202": {
            "id": "733221202",
            "speakerId": 4441,
            "speakerName": "瑟法娜",
            "text": "全都拜托你们了！实在感激不尽！"
          }
        }
      }
    }
  ]
}
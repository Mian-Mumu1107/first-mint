      }
    },
    {
      "subId": "7301403",
      "subQuestName": "与兰那罗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730140301"
        ],
        "dialogs": {
          "730140301": {
            "id": "730140301",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "啊，是那菈，金色的那菈，勇敢的那菈…",
            "nextDialogs": [
              "730140302"
            ]
          },
          "730140302": {
            "id": "730140302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我叫派蒙，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是{NICKNAME}，桓那兰那的大家正在为无忧节做准备呢，你怎么独自到这里来？",
            "nextDialogs": [
              "730140303"
            ]
          },
          "730140303": {
            "id": "730140303",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "兰般度有重要的任务，为了无忧节，为了水天丛林，为了那菈法留纳。",
            "nextDialogs": [
              "730140304"
            ]
          },
          "730140304": {
            "id": "730140304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么你就是兰般度了，不过，那菈法留纳？好像是听过的名字呢。",
            "nextDialogs": [
              "730140305"
            ]
          },
          "730140305": {
            "id": "730140305",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "#那菈法留纳…{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}就像那菈{NICKNAME}一样，是金色的，勇敢的那菈。",
            "nextDialogs": [
              "730140306"
            ]
          },
          "730140306": {
            "id": "730140306",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "看不到月亮和太阳的时候，就连桓那的大树也被多牙的风啃落了叶子，被黑色的雨咬烂了枝干。",
            "nextDialogs": [
              "730140307"
            ]
          },
          "730140307": {
            "id": "730140307",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "桓那的痛啪嗒嗒，滴进了泥里，到处都是铁的味道，盐的味道…",
            "nextDialogs": [
              "730140308"
            ]
          },
          "730140308": {
            "id": "730140308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…",
            "nextDialogs": [
              "730140309"
            ]
          },
          "730140309": {
            "id": "730140309",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "不知道日落又日升了多少次，那菈法留纳来了，金色的那菈，说着金色的语言。",
            "nextDialogs": [
              "730140310"
            ]
          },
          "730140310": {
            "id": "730140310",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}和兰那罗一起，带回了月亮和太阳。法留纳神机洗掉了桓那的痛，再也没有黑色的雨，再也没有铁和盐的味道。",
            "nextDialogs": [
              "730140311"
            ]
          },
          "730140311": {
            "id": "730140311",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "桓那兰那的大家都感谢那菈法留纳，都喜欢那菈法留纳，就像太阳，泥土，雨露。",
            "nextDialogs": [
              "730140312"
            ]
          },
          "730140312": {
            "id": "730140312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哇，听起来好厉害！{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}一定是个好那菈吧！",
            "nextDialogs": [
              "730140313"
            ]
          },
          "730140313": {
            "id": "730140313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不过，嘿嘿，那菈{NICKNAME}也帮助了很多人，获得了很多感谢…",
            "nextDialogs": [
              "730140314"
            ]
          },
          "730140314": {
            "id": "730140314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#兰般度一定也会喜欢那菈{NICKNAME}的！",
            "nextDialogs": [
              "730140315"
            ]
          },
          "730140315": {
            "id": "730140315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "730140316"
            ]
          },
          "730140316": {
            "id": "730140316",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}离开桓那兰那之后，许多从泥中诞生，许多又回到泥里。",
            "nextDialogs": [
              "730140317"
            ]
          },
          "730140317": {
            "id": "730140317",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "法留纳神机的枝和叶也没有了气力，法留纳法宝像被吓到的团雀，胡乱扑腾翅膀，雨变得很多，很怪。",
            "nextDialogs": [
              "730140318"
            ]
          },
          "730140318": {
            "id": "730140318",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "会跑的蘑菇在桓那住了下来，四处都是没见过的种子…",
            "nextDialogs": [
              "730140319"
            ]
          },
          "730140319": {
            "id": "730140319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…难道是蕈兽和孢子？不过，法留纳神机和法留纳法宝到底说的是什么东西呢？",
            "nextDialogs": [
              "730140320"
            ]
          },
          "730140320": {
            "id": "730140320",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "会是什么很厉害的武器吗？",
            "nextDialogs": [
              "730140322",
              "730140324"
            ]
          },
          "730140322": {
            "id": "730140322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "再怎么说这也厉害过头了吧！",
            "nextDialogs": [
              "730140327"
            ]
          },
          "730140327": {
            "id": "730140327",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "#唔…不对，不对。那菈{NICKNAME}和派蒙都不对。",
            "nextDialogs": [
              "730140328"
            ]
          },
          "730140328": {
            "id": "730140328",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "我们去高处，兰般度告诉你们。"
          },
          "730140324": {
            "id": "730140324",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那会是什么呢？",
            "nextDialogs": [
              "730140325"
            ]
          },
          "730140325": {
            "id": "730140325",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可能是水造的长了翅膀的兰那罗…",
            "nextDialogs": [
              "730140326"
            ]
          },
          "730140326": {
            "id": "730140326",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那不是水之幻形吗！"
          }
        }
      }
    },
    {
      "subId": "7301416",
      "subQuestName": "和兰般度一起去高处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

    {
      "subId": "7301408",
      "subQuestName": "击败树上的蕈兽$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7301409",
      "subQuestName": "前往「歇脚处」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7301410",
      "subQuestName": "与兰般度对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730141001"
        ],
        "dialogs": {
          "730141001": {
            "id": "730141001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里就是「歇脚处」啊，看得出来有兰那罗待过的痕迹呢。",
            "nextDialogs": [
              "730141002"
            ]
          },
          "730141002": {
            "id": "730141002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "从这里看法留纳神机，感觉更加壮观了，唔…好强的压迫感…",
            "nextDialogs": [
              "730141003"
            ]
          },
          "730141003": {
            "id": "730141003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙要小心不要被卷进去了哦。",
            "nextDialogs": [
              "730141004"
            ]
          },
          "730141004": {
            "id": "730141004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "才不会啦！…应该…不会吧…",
            "nextDialogs": [
              "730141005"
            ]
          },
          "730141005": {
            "id": "730141005",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "我们约好，治好了法留纳神机的枝和叶，就来「歇脚处」汇合。",
            "nextDialogs": [
              "730141006"
            ]
          },
          "730141006": {
            "id": "730141006",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "然后一起赶走啃噬法留纳神机的根的坏虫，治好法留纳神机。",
            "nextDialogs": [
              "730141007"
            ]
          },
          "730141007": {
            "id": "730141007",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说回来，法留纳神机的「枝」和「叶」又是指什么呢？",
            "nextDialogs": [
              "730141008"
            ]
          },
          "730141008": {
            "id": "730141008",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "法留纳神机的枝和叶散在桓那各处，有了它们，法留纳神机才有力量，把黑色的雨变成好的雨，带来诞生的雨。",
            "nextDialogs": [
              "730141009"
            ]
          },
          "730141009": {
            "id": "730141009",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "就像雨水汇成溪水，溪水汇入湖泊，枝和叶把点点滴滴汇集到法留纳神机。",
            "nextDialogs": [
              "730141010"
            ]
          },
          "730141010": {
            "id": "730141010",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "现在法留纳神机和以前不一样，就像断掉的小枝挡住了雨水，雨水汇不成小溪。没有溪水，湖泊就干涸。",
            "nextDialogs": [
              "730141011"
            ]
          },
          "730141011": {
            "id": "730141011",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…还是没太听懂…",
            "nextDialogs": [
              "730141013",
              "730141018"
            ]
          },
          "730141013": {
            "id": "730141013",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，没有饭吃就会没有力气干活！所以现在法留纳神机也是因为饿肚子所以在闹脾气吗？"
          },
          "730141018": {
            "id": "730141018",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就一定要清除所有的路障才能继续前进呢！",
            "nextDialogs": [
              "730141019"
            ]
          },
          "730141019": {
            "id": "730141019",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "明明只要换一条路就好了！到底是谁规定的路线呢…",
            "nextDialogs": [
              "730141020"
            ]
          },
          "730141020": {
            "id": "730141020",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对啊，到底是谁规定的路线呢？"
          }
        }
      }
    },
    {
      "subId": "7301411",
      "subQuestName": "和兰般度一起找到「枝」与「叶」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7301412",
      "subQuestName": "与兰般度对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730141201"
        ],
        "dialogs": {
          "730141201": {
            "id": "730141201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…居然藏在这种地方！",
            "nextDialogs": [
              "730141202"
            ]
          },
          "730141202": {
            "id": "730141202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，欸？这就是「枝」和「叶」吗？看起来…",
            "nextDialogs": [
              "730141203"
            ]
          },
          "730141203": {
            "id": "730141203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "像是兰那罗摆的石头。",
            "nextDialogs": [
              "730141204"
            ]
          },
          "730141204": {
            "id": "730141204",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "石头的叶子，石头的枝条，是兰穆护昆达和草木之王一起创造的，能把桓那的力量汇集到法留纳神机。",
            "nextDialogs": [
              "730141205"
            ]
          },
          "730141205": {
            "id": "730141205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "法留纳神机就像大树一样。",
            "nextDialogs": [
              "730141206"
            ]
          },
          "730141206": {
            "id": "730141206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样！",
            "nextDialogs": [
              "730141207"
            ]
          },
          "730141207": {
            "id": "730141207",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "唔…要让三个叶都转向枝的方向，但是兰般度力气不够，糟了。",
            "nextDialogs": [
              "730141208"
            ]
          },
          "730141208": {
            "id": "730141208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#啊，毕竟兰那罗个头这么小呢，这点小事就交给那菈{NICKNAME}吧。",
            "nextDialogs": [
              "730141209"
            ]
          },
          "730141209": {
            "id": "730141209",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "兰百梨迦也许可以，但是兰那库拉和兰贡迪…",
            "nextDialogs": [
              "730141210"
            ]
          },
          "730141210": {
            "id": "730141210",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "#不过要先解决眼前的问题，那菈{NICKNAME}，拜托了。"
          }
        }
      }
    },
    {
      "subId": "7301413",
      "subQuestName": "让三个「叶」都朝向「枝」的方向",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730141301"
        ],
        "dialogs": {
          "730141301": {
            "id": "730141301",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "#只要让三个叶都转向枝的方向就好，那菈{NICKNAME}，拜托了。"
          }
        }
      }
    },
    {
      "subId": "7301415",
      "subQuestName": "与兰般度对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730141501"
        ],
        "dialogs": {
          "730141501": {
            "id": "730141501",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "#感谢那菈{NICKNAME}，接下来交给兰般度就好。",
            "nextDialogs": [
              "730141502"
            ]
          },
          "730141502": {
            "id": "730141502",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "不过，太久了，不知道这次能不能成功…",
            "nextDialogs": [
              "730141503"
            ]
          },
          "730141503": {
            "id": "730141503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！还有可能会失败吗？",
            "nextDialogs": [
              "730141504"
            ]
          },
          "730141504": {
            "id": "730141504",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "以前成功过，但这次也许成功也许不成功。就像上一次和上上一次太阳都升起来了，但下一次太阳还会不会升起，谁也不知道。",
            "nextDialogs": [
              "730141505"
            ]
          },
          "730141505": {
            "id": "730141505",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "只有下一次太阳升起来以后，派蒙才能说，「啊，太阳又升起来了」。",
            "nextDialogs": [
              "730141506"
            ]
          },
          "730141506": {
            "id": "730141506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜呜…好可怕…万一太阳真的不再升起了那可怎么办…",
            "nextDialogs": [
              "730141507"
            ]
          },
          "730141507": {
            "id": "730141507",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "#派蒙不要害怕，那菈{NICKNAME}就像那菈法留纳一样，是太阳一样金色，而且勇敢的那菈。",
            "nextDialogs": [
              "730141508"
            ]
          },
          "730141508": {
            "id": "730141508",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "#那菈法留纳为我们带回了月亮和太阳，那菈{NICKNAME}也一定可以。",
            "nextDialogs": [
              "730141509"
            ]
          },
          "730141509": {
            "id": "730141509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#…嗯！我也相信{NICKNAME}，无论有什么困难，一定都难不倒{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}！",
            "nextDialogs": [
              "730141510"
            ]
          },
          "730141510": {
            "id": "730141510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "放心交给我吧。",
            "nextDialogs": [
              "730141511"
            ]
          },
          "730141511": {
            "id": "730141511",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "但是现在，就交给兰般度吧。",
            "nextDialogs": [
              "730141512"
            ]
          },
          "730141512": {
            "id": "730141512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喔——好像…成功了？",
            "nextDialogs": [
              "730141513"
            ]
          },
          "730141513": {
            "id": "730141513",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "对，这里的枝和叶已经治好了。",
            "nextDialogs": [
              "730141514"
            ]
          },
          "730141514": {
            "id": "730141514",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太好啦！不过兰那罗的舞蹈，真的很有意思呢！",
            "nextDialogs": [
              "730141515"
            ]
          },
          "730141515": {
            "id": "730141515",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙或许应该向兰那罗学习一下。",
            "nextDialogs": [
              "730141516"
            ]
          },
          "730141516": {
            "id": "730141516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来不错呢！",
            "nextDialogs": [
              "730141517"
            ]
          },
          "730141517": {
            "id": "730141517",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "以派蒙的食量，的确应该多运动…",
            "nextDialogs": [
              "730141518"
            ]
          },
          "730141518": {
            "id": "730141518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔唔！我跟着{NICKNAME}东奔西跑就已经是在运动啦！",
            "nextDialogs": [
              "730141519"
            ]
          },
          "730141519": {
            "id": "730141519",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，光是这样，法留纳神机还没有完全治好吧？",
            "nextDialogs": [
              "730141520"
            ]
          },
          "730141520": {
            "id": "730141520",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "还有三处分散在桓那。兰百梨迦很强，或许可以…但是兰那库拉和兰贡迪，非常担心。因为不正常的雨，桓那更加危险了。",
            "nextDialogs": [
              "730141521"
            ]
          },
          "730141521": {
            "id": "730141521",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不如我和{NICKNAME}去看看他们的情况吧，毕竟不治好法留纳神机，也没法安心筹办无忧节嘛。",
            "nextDialogs": [
              "730141522"
            ]
          },
          "730141522": {
            "id": "730141522",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "#有派蒙和那菈{NICKNAME}的帮助，法留纳神机一定能很快治好，桓那一定能恢复生气，就像从前一样。",
            "nextDialogs": [
              "730141523"
            ]
          },
          "730141523": {
            "id": "730141523",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "兰那库拉去了<color=#00E1FFFF>谒颂幽境</color>，桓那深处有兰那罗对那菈法留纳的纪念，不过因为「蕈兽」和「孢子」，很久没有去过了。",
            "nextDialogs": [
              "730141524"
            ]
          },
          "730141524": {
            "id": "730141524",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "兰那库拉习惯和泥土、种子在一起，从泥土里诞生的是他熟悉的。",
            "nextDialogs": [
              "730141525"
            ]
          },
          "730141525": {
            "id": "730141525",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "找到他，告诉他兰般度的名字，他就不会害怕了。",
            "nextDialogs": [
              "730141526"
            ]
          },
          "730141526": {
            "id": "730141526",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，听起来是比较胆小的兰那罗呢。",
            "nextDialogs": [
              "730141527"
            ]
          },
          "730141527": {
            "id": "730141527",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "#兰百梨迦的兰迦拉梨很强！但是…但是还是请派蒙和那菈{NICKNAME}去看看他吧…",
            "nextDialogs": [
              "730141528"
            ]
          },
          "730141528": {
            "id": "730141528",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "#兰百梨迦在<color=#00E1FFFF>荼诃之座</color>，那里有很多铁的味道…派蒙和那菈{NICKNAME}要小心。",
            "nextDialogs": [
              "730141529"
            ]
          },
          "730141529": {
            "id": "730141529",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，我们会小心的。",
            "nextDialogs": [
              "730141530"
            ]
          },
          "730141530": {
            "id": "730141530",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "兰贡迪在<color=#00E1FFFF>梦景林莽</color>，那里有梦的入口。他和那菈更疏远，如果他藏起来了，演奏我们的音乐。",
            "nextDialogs": [
              "730141531"
            ]
          },
          "730141531": {
            "id": "730141531",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，我们之前拿到了兰那罗的乐谱呢。如果找不到兰贡迪，就试试演奏音乐吧！",
            "nextDialogs": [
              "730141532"
            ]
          },
          "730141532": {
            "id": "730141532",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "兰般度会先去「歇脚处」等待，观察桓那的状况。",
            "nextDialogs": [
              "730141533"
            ]
          },
          "730141533": {
            "id": "730141533",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "兰那库拉、兰百梨迦、兰贡迪都知道，治好枝与叶以后回「歇脚处」汇合。",
            "nextDialogs": [
              "730141534"
            ]
          },
          "730141534": {
            "id": "730141534",
            "speakerId": 4187,
            "speakerName": "兰般度",
            "text": "#金色的那菈，勇敢的那菈，兰穆护昆达看顾那菈{NICKNAME}。",
            "nextDialogs": [
              "730141535"
            ]
          },
          "730141535": {
            "id": "730141535",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！交给我们吧！"
          }
        }
      }
    }
  ]
}
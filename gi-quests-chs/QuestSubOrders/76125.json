          },
          "761250235": {
            "id": "761250235",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "演奏哥伦比娅常哼的歌…",
            "nextDialogs": [
              "761250236"
            ]
          },
          "761250236": {
            "id": "761250236",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…它们睡着了。",
            "nextDialogs": [
              "761250237"

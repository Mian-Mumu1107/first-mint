            ]
          },
          "761250246": {
            "id": "761250246",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "算了吧，今天心情不好，说出来的话不会好听。",
            "nextDialogs": [
              "761250247"
            ]
          },
          "761250247": {
            "id": "761250247",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "而且我看，这里最不需要的就是安慰。"
          }
        }

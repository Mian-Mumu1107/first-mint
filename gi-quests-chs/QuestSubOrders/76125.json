              "761250219"
            ]
          },
          "761250219": {
            "id": "761250219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（哥伦比娅不是为了看到这样的局面才做出的牺牲，更何况…）",
            "nextDialogs": [
              "761250220"
            ]
          },

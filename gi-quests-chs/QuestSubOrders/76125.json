            "text": "……",
            "nextDialogs": [
              "761250240"
            ]
          },
          "761250240": {
            "id": "761250240",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "桑多涅！你怎么会在这里？",
            "nextDialogs": [
              "761250241"
            ]
          },
          "761250241": {
            "id": "761250241",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "随便出门散散心不行吗？",
            "nextDialogs": [
              "761250242"
            ]
          },
          "761250242": {
            "id": "761250242",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她没有回来。",
            "nextDialogs": [
              "761250243"
            ]
          },
          "761250243": {
            "id": "761250243",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "我想也是。",
            "nextDialogs": [
              "761250244"
            ]
          },
          "761250244": {
            "id": "761250244",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "奇迹怎么可能没有代价呢。",
            "nextDialogs": [
              "761250245"

            ]
          },
          "761250228": {
            "id": "761250228",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "想要陪你们做点什么吗？",
            "nextDialogs": [
              "761250229"
            ]
          },
          "761250229": {
            "id": "761250229",
            "speakerId": 15903,
            "speakerName": "月灵",
            "text": "……",
            "nextDialogs": [
              "761250230"
            ]
          },
          "761250230": {

      "dialogue": {
        "startDialogs": [
          "722670201"
        ],
        "dialogs": {
          "722670201": {
            "id": "722670201",
            "speakerId": 1000,
            "speakerName": "碑文",
            "text": "（石碑上用能看懂的语言写着提示…）",
            "nextDialogs": [
              "722670202"
            ]
          },
          "722670202": {
            "id": "722670202",
            "speakerId": 1000,
            "speakerName": "碑文",
            "text": "我的父亲告诉我，任何行为都应有背后的道义和人前的优雅。",
            "nextDialogs": [
              "722670203"
            ]
          },
          "722670203": {
            "id": "722670203",
            "speakerId": 1000,
            "speakerName": "碑文",
            "text": "所以他说，要我用这样的语言记录我给出的迷宫提示。",
            "nextDialogs": [
              "722670204"
            ]
          },
          "722670204": {
            "id": "722670204",
            "speakerId": 1000,
            "speakerName": "碑文",
            "text": "只有在常夜里，迷宫的墙壁和打开通路的机关，才会出现。因为他们沐浴着看不见的月光。",
            "nextDialogs": [
              "722670205"
            ]
          },
          "722670205": {
            "id": "722670205",
            "speakerId": 1000,
            "speakerName": "碑文",
            "text": "而那被叫做谜底的机关，正藏在迷宫的四角。",
            "nextDialogs": [
              "722670206"
            ]
          },
          "722670206": {
            "id": "722670206",
            "speakerId": 1000,
            "speakerName": "碑文",
            "text": "因为我写到最后并不押韵也没有修辞…",
            "nextDialogs": [
              "722670207"
            ]
          },
          "722670207": {
            "id": "722670207",
            "speakerId": 1000,
            "speakerName": "碑文",
            "text": "我的父亲，欧律达特，用拐杖打我的屁股。"
          }
        }
      }
    },
    {
      "subId": "7226799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722679901"

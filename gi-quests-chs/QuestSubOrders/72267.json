        "dialogs": {
          "722679901": {
            "id": "722679901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦哦，迷宫只要在上顶上往下看，不就什么难度都没有了吗？嗯嗯，就这么办吧。"
          }
        }
      }
    }
  ]

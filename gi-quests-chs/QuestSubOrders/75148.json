    {
      "subId": "7514801",
      "subQuestName": "前往「天火之冠」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751480101"
        ],
        "dialogs": {
          "751480101": {
            "id": "751480101",
            "speakerId": 1000,
            "speakerName": "（test）神秘的声音",
            "text": "受龙所选者，啊，受龙所选者啊…",
            "nextDialogs": [
              "751480102"
            ]
          },
          "751480102": {
            "id": "751480102",
            "speakerId": 1000,
            "speakerName": "（test）神秘的声音",
            "text": "登上冠冕之顶，跃入圣山之火吧！",
            "nextDialogs": [
              "751480103"
            ]
          },
          "751480103": {
            "id": "751480103",
            "speakerId": 1000,
            "speakerName": "（test）神秘的声音",
            "text": "去揭开吧，去揭开金印，揭开亿万余火的焰光！",
            "nextDialogs": [
              "751480104"
            ]
          },
          "751480104": {
            "id": "751480104",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔嗯…",
            "nextDialogs": [
              "751480105"
            ]
          },
          "751480105": {
            "id": "751480105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怎么了，难道又看到什么奇怪的话？",
            "nextDialogs": [
              "751480108"
            ]
          },
          "751480108": {
            "id": "751480108",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦，是因为靠近了火山的关系吗？",
            "nextDialogs": [
              "751480109"
            ]
          },
          "751480109": {
            "id": "751480109",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751480110"
            ]
          },
          "751480110": {
            "id": "751480110",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "…看起来就像是，那个一直跟你们说话的人就在火山里一样呢。",
            "nextDialogs": [
              "751480111"
            ]
          },
          "751480111": {
            "id": "751480111",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不过既然靠近火山的时候又能看到那些东西，就说明我们没有走错路。",
            "nextDialogs": [
              "751480112"
            ]
          },
          "751480112": {
            "id": "751480112",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！"
          }
        }
      }
    },
    {
      "subId": "7514805",
      "subQuestName": "前往「天火之冠」$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751480501"
        ],
        "dialogs": {
          "751480501": {
            "id": "751480501",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦，刚才那是，绒、绒翼龙？",
            "nextDialogs": [
              "751480502"
            ]
          },
          "751480502": {
            "id": "751480502",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "它是不是直接抓着那个雕像跳下去了，跳进了，火山口里？",
            "nextDialogs": [
              "751480503"
            ]
          },
          "751480503": {
            "id": "751480503",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那里就是火山口…还挺壮观的呢。",
            "nextDialogs": [
              "751480504"
            ]
          },
          "751480504": {
            "id": "751480504",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔，之前问路的时候，不是说火山口聚集了海量的气态燃素…",
            "nextDialogs": [
              "751480505"
            ]
          },
          "751480505": {
            "id": "751480505",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对哦！<color=#00E1FFFF>穿越气态燃素的办法</color>，就像…刚才的绒翼龙那样！",
            "nextDialogs": [
              "751480506"
            ]
          },
          "751480506": {
            "id": "751480506",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不过，呜，这么高！",
            "nextDialogs": [
              "751480508",
              "751480511"
            ]
          },
          "751480508": {
            "id": "751480508",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751480509"
            ]
          },
          "751480509": {
            "id": "751480509",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦，你也愿意吗？真的吗…好、好吧，既然这样好像也没有那么害怕了。",
            "nextDialogs": [
              "751480514"
            ]
          },
          "751480514": {
            "id": "751480514",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "而且，不仅仅是高，别忘了那些气态燃素呢！",
            "nextDialogs": [
              "751480515"
            ]
          },
          "751480515": {
            "id": "751480515",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔，等、等准备好，我们就出发吧！"
          },
          "751480511": {
            "id": "751480511",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "拉不住啦，先不说我有没有那么大的力气，什么叫落地的瞬间嘛，这个时机的把握也太难了！",
            "nextDialogs": [
              "751480512"
            ]
          },
          "751480512": {
            "id": "751480512",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751480513"
            ]
          },
          "751480513": {
            "id": "751480513",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你也是，不许跟着瞎起哄。唉…被你们这么一闹，一点紧张感都没有了！"
          }
        }
      }
    },

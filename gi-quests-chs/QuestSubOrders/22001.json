    {
      "subId": "2200104",
      "subQuestName": "找到莲蓬",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220010401"
        ],
        "dialogs": {
          "220010401": {
            "id": "220010401",
            "speakerId": 1002,
            "speakerName": "璐璐",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你找到莲蓬了吗？",
            "nextDialogs": [
              "220010402"
            ]
          },
          "220010402": {
            "id": "220010402",
            "speakerId": 1004,
            "speakerName": "<UNKNOWN>",
            "text": "找到了。",
            "nextDialogs": [
              "220010403"
            ]
          },
          "220010403": {
            "id": "220010403",
            "speakerId": 1000,
            "speakerName": "阿飞",
            "text": "你…！",
            "nextDialogs": [
              "220010404"
            ]
          },
          "220010404": {
            "id": "220010404",
            "speakerId": 1001,
            "speakerName": "小蒙",
            "text": "你…！",
            "nextDialogs": [
              "220010405"
            ]
          },
          "220010405": {
            "id": "220010405",
            "speakerId": 1002,
            "speakerName": "璐璐",
            "text": "你们别吵了，吵了这么久不累吗？",
            "nextDialogs": [
              "220010406"
            ]
          },
          "220010406": {
            "id": "220010406",
            "speakerId": 1002,
            "speakerName": "璐璐",
            "text": "只是玩个游戏，别这么生气，大家都是朋友呀。",
            "nextDialogs": [
              "220010407"
            ]
          },
          "220010407": {
            "id": "220010407",
            "speakerId": 1002,
            "speakerName": "璐璐",
            "text": "喏，新摘的莲蓬，快点吃吧。",
            "nextDialogs": [
              "220010408"
            ]
          },
          "220010408": {
            "id": "220010408",
            "speakerId": 1002,
            "speakerName": "璐璐",
            "text": "吃完了之后，我们再好好商量一下。",
            "nextDialogs": [
              "220010409"
            ]
          },
          "220010409": {
            "id": "220010409",
            "speakerId": 1002,
            "speakerName": "璐璐",
            "text": "排好谁做船长，谁做服务员的顺序，不就好了吗？",
            "nextDialogs": [
              "220010410"
            ]
          },
          "220010410": {
            "id": "220010410",
            "speakerId": 1001,
            "speakerName": "小蒙",
            "text": "好吧…",
            "nextDialogs": [
              "220010411"
            ]
          },
          "220010411": {
            "id": "220010411",
            "speakerId": 1000,
            "speakerName": "阿飞",
            "text": "嗯…",
            "nextDialogs": [
              "220010412"
            ]
          },
          "220010412": {
            "id": "220010412",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "真的安静下来了…",
            "nextDialogs": [
              "220010413"
            ]
          },
          "220010413": {
            "id": "220010413",
            "speakerId": 1002,
            "speakerName": "璐璐",
            "text": "怎么样，我就说吧。",
            "nextDialogs": [
              "220010415",
              "220010417"
            ]
          },
          "220010415": {
            "id": "220010415",
            "speakerId": 1002,
            "speakerName": "璐璐",
            "text": "我们一起玩了很久，我当然知道啦。"
          },
          "220010417": {
            "id": "220010417",
            "speakerId": 1002,
            "speakerName": "璐璐",
            "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，北斗姐姐才厉害呢。",
            "nextDialogs": [
              "220010418"
            ]
          },
          "220010418": {
            "id": "220010418",
            "speakerId": 1002,
            "speakerName": "璐璐",
            "text": "我长大之后，也能成为她那样的人吗…"
          }
        }
      }
    },

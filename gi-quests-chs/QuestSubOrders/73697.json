    {
      "subId": "7369705",
      "subQuestName": "见证斯露莎回顾过往",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7369706",
      "subQuestName": "与斯露莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736970601"
        ],
        "dialogs": {
          "736970601": {
            "id": "736970601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "第一天的终点就是这里吗？这里我们已经很熟悉了，毕竟都来过好多次了嘛。",
            "nextDialogs": [
              "736970602"
            ]
          },
          "736970602": {
            "id": "736970602",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "哦？既然白飘飘这么有自信，那不如我们身份对调，我来扮演听众，由你来讲述。",
            "nextDialogs": [
              "736970603"
            ]
          },
          "736970603": {
            "id": "736970603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好啊，试试就试试，瞧我的。",
            "nextDialogs": [
              "736970604"
            ]
          },
          "736970604": {
            "id": "736970604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们眼前这片有花有水的地方就是甘露花海，这里没有…对了，没有「迪弗诸魔」的侵扰，是花灵的家乡。",
            "nextDialogs": [
              "736970605"
            ]
          },
          "736970605": {
            "id": "736970605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在这里有很多花灵，其中最了不起的那一个叫祖尔宛。",
            "nextDialogs": [
              "736970606"
            ]
          },
          "736970606": {
            "id": "736970606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "斯露莎也是在这里诞生的吧？不过斯露莎跟其他的花灵不一样…",
            "nextDialogs": [
              "736970607"
            ]
          },
          "736970607": {
            "id": "736970607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果说其他花灵说话只是有五分怪，那我们一开始见到的斯露莎说话有十分怪！唉，明明是一样的水，为什么只有斯露莎…",
            "nextDialogs": [
              "736970608"
            ]
          },
          "736970608": {
            "id": "736970608",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "喂！",
            "nextDialogs": [
              "736970609"
            ]
          },
          "736970609": {
            "id": "736970609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我可不是乱说的，一开始斯露莎跟矫论团的人说话的时候的确很怪嘛，唔，虽然矫论团的人说话也很怪。",
            "nextDialogs": [
              "736970610"
            ]
          },
          "736970610": {
            "id": "736970610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "本来还以为其他花灵也和斯露莎一样，到甘露花海来找祖尔宛之前还很担心呢。",
            "nextDialogs": [
              "736970611"
            ]
          },
          "736970611": {
            "id": "736970611",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "最后发现只有斯露莎是这样…应该说，斯露莎跟矫论团的人说话的时候才会这样，欸？",
            "nextDialogs": [
              "736970612"
            ]
          },
          "736970612": {
            "id": "736970612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来是受矫论团的人影响太深了。",
            "nextDialogs": [
              "736970613"
            ]
          },
          "736970613": {
            "id": "736970613",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "唔…这一点我不否认。",
            "nextDialogs": [
              "736970614"
            ]
          },
          "736970614": {
            "id": "736970614",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然斯露莎没问题，那我接着讲。甘露花海里的大树桩子…",
            "nextDialogs": [
              "736970615"
            ]
          },
          "736970615": {
            "id": "736970615",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "白飘飘，你这家伙…",
            "nextDialogs": [
              "736970616"
            ]
          },
          "736970616": {
            "id": "736970616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是甘露花海里的「万种母树」！花灵的词汇都好难记，而且，它本来就是大树桩子嘛…",
            "nextDialogs": [
              "736970617"
            ]
          },
          "736970617": {
            "id": "736970617",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我记得斯露莎说过，大树桩子其实是神明大人，而花灵一族也和这位神明大人有着不浅的关系。",
            "nextDialogs": [
              "736970618"
            ]
          },
          "736970618": {
            "id": "736970618",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "虽然事实是这样没错…但总觉得继续让白飘飘讲下去就太不敬了，还是由我来讲吧。",
            "nextDialogs": [
              "736970619"
            ]
          },
          "736970619": {
            "id": "736970619",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧…亏我还觉得自己讲得很简单易懂呢。",
            "nextDialogs": [
              "736970620"
            ]
          },
          "736970620": {
            "id": "736970620",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "哼…总之，五百年前，神明大人为了镇压此处的灾厄而牺牲了全部，此处的甘露活水便是神明大人最后的遗赠。",
            "nextDialogs": [
              "736970621"
            ]
          },
          "736970621": {
            "id": "736970621",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "受甘露活水的滋养，诞生了万种母树与吾辈花灵。而花灵之中的最古者，便是前辈…也就是祖尔宛。",
            "nextDialogs": [
              "736970622"
            ]
          },
          "736970622": {
            "id": "736970622",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "我的诞生要晚许多，因此未能亲历那些事件。过去听前辈说过一些，但是…",
            "nextDialogs": [
              "736970623"
            ]
          },
          "736970623": {
            "id": "736970623",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "明明矫论团建立之初，前辈也是有参与的，但是在我诞生之后，他们之间已经没什么往来了。",
            "nextDialogs": [
              "736970624"
            ]
          },
          "736970624": {
            "id": "736970624",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "虽然前辈也说花灵的传承是很重要的，但却不常对我说起过去的细节。反倒是矫论团的人类…",
            "nextDialogs": [
              "736970625"
            ]
          },
          "736970625": {
            "id": "736970625",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "不仅非常热心地同我分享他们对历史的研究，还认同我效法神鸟的愿望。",
            "nextDialogs": [
              "736970626"
            ]
          },
          "736970626": {
            "id": "736970626",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？所以之后斯露莎就渐渐疏远花灵同族，还跟矫论团的人学会了那些怪话吗？",
            "nextDialogs": [
              "736970627"
            ]
          },
          "736970627": {
            "id": "736970627",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "唔…从事实上来说，是这样没错。",
            "nextDialogs": [
              "736970628"
            ]
          },
          "736970628": {
            "id": "736970628",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来像叛逆期…",
            "nextDialogs": [
              "736970629"
            ]
          },
          "736970629": {
            "id": "736970629",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "「叛逆期」…以前听矫论团的人类说起过，森林里的学者有什么「林居狂语期」之类的阶段，「叛逆期」也是类似的阶段吗？",
            "nextDialogs": [
              "736970631",
              "736970633"
            ]
          },
          "736970631": {
            "id": "736970631",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对，根本不是一回事吧！",
            "nextDialogs": [
              "736970634"
            ]
          },
          "736970634": {
            "id": "736970634",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "简单说，叛逆期的人类小孩会反抗平日照顾自己的大人，并且提出一些自己的主张。我是这么听说的。",
            "nextDialogs": [
              "736970635"
            ]
          },
          "736970635": {
            "id": "736970635",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，就跟之前的斯露莎一样嘛。",
            "nextDialogs": [
              "736970636"
            ]
          },
          "736970636": {
            "id": "736970636",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "哼，过去的我和现在的我可不一样。不管怎么说，现在的我已经回归花海，并且得到了灵光的认可。",
            "nextDialogs": [
              "736970637"
            ]
          },
          "736970637": {
            "id": "736970637",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "斯露莎可真了不起！",
            "nextDialogs": [
              "736970638"
            ]
          },
          "736970638": {
            "id": "736970638",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "明明白飘飘也只是个小不点而已…罢了。",
            "nextDialogs": [
              "736970639"
            ]
          },
          "736970639": {
            "id": "736970639",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "今日要讲的就是这些了，「谒颂主」和白飘飘还有什么想问的吗？",
            "nextDialogs": [
              "736970640"
            ]
          },
          "736970640": {
            "id": "736970640",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，花灵和兰那罗有关系吗？",
            "nextDialogs": [
              "736970641"
            ]
          },
          "736970641": {
            "id": "736970641",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "…为什么会有这样的疑问？",
            "nextDialogs": [
              "736970642"
            ]
          },
          "736970642": {
            "id": "736970642",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为花灵和兰那罗都小小的…",
            "nextDialogs": [
              "736970643"
            ]
          },
          "736970643": {
            "id": "736970643",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是做的事情却很伟大呢。",
            "nextDialogs": [
              "736970644"
            ]
          },
          "736970644": {
            "id": "736970644",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "为斯露莎讲述了与兰罗摩等许多兰那罗一同冒险的经历…",
            "nextDialogs": [
              "736970645"
            ]
          },
          "736970645": {
            "id": "736970645",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "唔…无忧节居然是这么重要的节日。听前辈提起的时候，还以为只是兰那罗聚在一起玩闹而已。",
            "nextDialogs": [
              "736970646"
            ]
          },
          "736970646": {
            "id": "736970646",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "不过，既然兰那罗都有自己的节日，为什么我们花灵却没有呢？应该去跟前辈提一下这件事…",
            "nextDialogs": [
              "736970647"
            ]
          },
          "736970647": {
            "id": "736970647",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那斯露莎为什么想要花灵的节日呢？是因为节日可以吃好吃的吗？",
            "nextDialogs": [
              "736970648"
            ]
          },
          "736970648": {
            "id": "736970648",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "当然不是！花灵的节日…应该让人类来唱颂诗，由我来选出其中唱得最好的那一个。",
            "nextDialogs": [
              "736970649"
            ]
          },
          "736970649": {
            "id": "736970649",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这听起来一点都不像是节日…对来参加的人类来说，根本就是压力十足的竞赛吧？",
            "nextDialogs": [
              "736970650"
            ]
          },
          "736970650": {
            "id": "736970650",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "可是对我来说就是很快乐的节日呀？我想前辈一定也会喜欢这样的节日的。",
            "nextDialogs": [
              "736970651"
            ]
          },
          "736970651": {
            "id": "736970651",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…也许祖尔宛说得对，斯露莎要成为称职的花灵勇者还需要一些磨练…"
          },
          "736970633": {
            "id": "736970633",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "和学者才会有的林居狂语期不一样，的确，听说很多人类小孩都会有这个阶段呢…"
          }
        }
      }
    },
    {
      "subId": "7369707",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736970701"
        ],
        "dialogs": {
          "736970701": {
            "id": "736970701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "第一天的终点就是这里吗？这里我们已经很熟悉了，毕竟都来过好多次了嘛。",
            "nextDialogs": [
              "736970702"
            ]
          },
          "736970702": {
            "id": "736970702",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "哦？既然白飘飘这么有自信，那不如我们身份对调，我来扮演听众，由你来讲述。",
            "nextDialogs": [
              "736970703"
            ]
          },
          "736970703": {
            "id": "736970703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好啊，试试就试试，瞧我的。",
            "nextDialogs": [
              "736970704"
            ]
          },
          "736970704": {
            "id": "736970704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们眼前这片有花有水的地方就是甘露花海，这里没有…对了，没有「迪弗诸魔」的侵扰，是花灵的家乡。",
            "nextDialogs": [
              "736970705"
            ]
          },
          "736970705": {
            "id": "736970705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在这里有很多花灵，其中最了不起的那一个叫祖尔宛。",
            "nextDialogs": [
              "736970706"
            ]
          },
          "736970706": {
            "id": "736970706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "斯露莎也是在这里诞生的吧？不过斯露莎跟其他的花灵不一样…",
            "nextDialogs": [
              "736970707"
            ]
          },
          "736970707": {
            "id": "736970707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果说其他花灵说话只是有五分怪，那我们一开始见到的斯露莎说话有十分怪！唉，明明是一样的水，为什么只有斯露莎…",
            "nextDialogs": [
              "736970708"
            ]
          },
          "736970708": {
            "id": "736970708",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "喂！",
            "nextDialogs": [
              "736970709"
            ]
          },
          "736970709": {
            "id": "736970709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我可不是乱说的，一开始斯露莎跟矫论团的人说话的时候的确很怪嘛，唔，虽然矫论团的人说话也很怪。",
            "nextDialogs": [
              "736970710"
            ]
          },
          "736970710": {
            "id": "736970710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "本来还以为其他花灵也和斯露莎一样，到甘露花海来找祖尔宛之前还很担心呢。",
            "nextDialogs": [
              "736970711"
            ]
          },
          "736970711": {
            "id": "736970711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "最后发现只有斯露莎是这样…应该说，斯露莎跟矫论团的人说话的时候才会这样，欸？",
            "nextDialogs": [
              "736970712"
            ]
          },
          "736970712": {
            "id": "736970712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来是受矫论团的人影响太深了。",
            "nextDialogs": [
              "736970713"
            ]
          },
          "736970713": {
            "id": "736970713",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "唔…这一点我不否认。",
            "nextDialogs": [
              "736970714"
            ]
          },
          "736970714": {
            "id": "736970714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然斯露莎没问题，那我接着讲。甘露花海里的大树桩子…",
            "nextDialogs": [
              "736970715"
            ]
          },
          "736970715": {
            "id": "736970715",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "白飘飘，你这家伙…",
            "nextDialogs": [
              "736970716"
            ]
          },
          "736970716": {
            "id": "736970716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是甘露花海里的「万种母树」！花灵的词汇都好难记，而且，它本来就是大树桩子嘛…",
            "nextDialogs": [
              "736970717"
            ]
          },
          "736970717": {
            "id": "736970717",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我记得斯露莎说过，大树桩子其实是神明大人，而花灵一族也和这位神明大人有着不浅的关系。",
            "nextDialogs": [
              "736970718"
            ]
          },
          "736970718": {
            "id": "736970718",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "虽然事实是这样没错…但总觉得继续让白飘飘讲下去就太不敬了，还是由我来讲吧。",
            "nextDialogs": [
              "736970719"
            ]
          },
          "736970719": {
            "id": "736970719",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧…亏我还觉得自己讲得很简单易懂呢。",
            "nextDialogs": [
              "736970720"
            ]
          },
          "736970720": {
            "id": "736970720",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "哼…总之，五百年前，神明大人为了镇压此处的灾厄而牺牲了全部，此处的甘露活水便是神明大人最后的遗赠。",
            "nextDialogs": [
              "736970721"
            ]
          },
          "736970721": {
            "id": "736970721",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "受甘露活水的滋养，诞生了万种母树与吾辈花灵。而花灵之中的最古者，便是前辈…也就是祖尔宛。",
            "nextDialogs": [
              "736970722"
            ]
          },
          "736970722": {
            "id": "736970722",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "我的诞生要晚许多，因此未能亲历那些事件。过去听前辈说过一些，但是…",
            "nextDialogs": [
              "736970723"
            ]
          },
          "736970723": {
            "id": "736970723",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "明明矫论团建立之初，前辈也是有参与的，但是在我诞生之后，他们之间已经没什么往来了。",
            "nextDialogs": [
              "736970724"
            ]
          },
          "736970724": {
            "id": "736970724",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "虽然前辈也说花灵的传承是很重要的，但却不常对我说起过去的细节。反倒是矫论团的人类…",
            "nextDialogs": [
              "736970725"
            ]
          },
          "736970725": {
            "id": "736970725",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "不仅非常热心地同我分享他们对历史的研究，还认同我效法神鸟的愿望。",
            "nextDialogs": [
              "736970726"
            ]
          },
          "736970726": {
            "id": "736970726",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？所以之后斯露莎就渐渐疏远花灵同族，还跟矫论团的人学会了那些怪话吗？",
            "nextDialogs": [
              "736970727"
            ]
          },
          "736970727": {
            "id": "736970727",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "唔…从事实上来说，是这样没错。",
            "nextDialogs": [
              "736970728"
            ]
          },
          "736970728": {
            "id": "736970728",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来像叛逆期…",
            "nextDialogs": [
              "736970729"
            ]
          },
          "736970729": {
            "id": "736970729",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "「叛逆期」…以前听矫论团的人类说起过，森林里的学者有什么「林居狂语期」之类的阶段，「叛逆期」也是类似的阶段吗？",
            "nextDialogs": [
              "736970731",
              "736970733"
            ]
          },
          "736970731": {
            "id": "736970731",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对，根本不是一回事吧！",
            "nextDialogs": [
              "736970734"
            ]
          },
          "736970734": {
            "id": "736970734",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "简单说，叛逆期的人类小孩会反抗平日照顾自己的大人，并且提出一些自己的主张。我是这么听说的。",
            "nextDialogs": [
              "736970735"
            ]
          },
          "736970735": {
            "id": "736970735",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，就跟之前的斯露莎一样嘛。",
            "nextDialogs": [
              "736970736"
            ]
          },
          "736970736": {
            "id": "736970736",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "哼，过去的我和现在的我可不一样。不管怎么说，现在的我已经回归花海，并且得到了灵光的认可。",
            "nextDialogs": [
              "736970737"
            ]
          },
          "736970737": {
            "id": "736970737",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "斯露莎可真了不起！",
            "nextDialogs": [
              "736970738"
            ]
          },
          "736970738": {
            "id": "736970738",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "明明白飘飘也只是个小不点而已…罢了。",
            "nextDialogs": [
              "736970739"
            ]
          },
          "736970739": {
            "id": "736970739",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "对了，既然今日又谈到了花灵一族的诞生，你们见过森林中的草木的眷属了吗？",
            "nextDialogs": [
              "736970740"
            ]
          },
          "736970740": {
            "id": "736970740",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "草木的眷属？",
            "nextDialogs": [
              "736970741"
            ]
          },
          "736970741": {
            "id": "736970741",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "嗯，那是被称为「兰那罗」的一族。",
            "nextDialogs": [
              "736970742"
            ]
          },
          "736970742": {
            "id": "736970742",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "我也只是听前辈说起过，听说他们不像吾辈花灵能够自如飞行，但是由于同草木的亲缘，他们可以在泥土中自由来去。",
            "nextDialogs": [
              "736970743"
            ]
          },
          "736970743": {
            "id": "736970743",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "难以想象那是怎样的景象…难道是跟沙虫一样的族类吗？",
            "nextDialogs": [
              "736970744"
            ]
          },
          "736970744": {
            "id": "736970744",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "不过他们似乎有自己的节日，节日到来之际，兰那罗会齐聚梦土，欢度无忧时光。",
            "nextDialogs": [
              "736970745"
            ]
          },
          "736970745": {
            "id": "736970745",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "有时我想，既然兰那罗都有自己的节日，为什么花灵不能有自己的节日呢？同前辈提起这件事，她却不怎么感兴趣的样子…",
            "nextDialogs": [
              "736970746"
            ]
          },
          "736970746": {
            "id": "736970746",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那斯露莎为什么想要花灵的节日呢？是因为节日可以吃好吃的吗？",
            "nextDialogs": [
              "736970747"
            ]
          },
          "736970747": {
            "id": "736970747",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "当然不是！花灵的节日…应该让人类来唱颂诗，由我来选出其中唱得最好的那一个。",
            "nextDialogs": [
              "736970748"
            ]
          },
          "736970748": {
            "id": "736970748",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "这听起来一点都不像是节日…对来参加的人类来说，根本就是压力十足的竞赛吧？",
            "nextDialogs": [
              "736970749"
            ]
          },
          "736970749": {
            "id": "736970749",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "可是对我来说就是很快乐的节日呀？我想前辈一定也会喜欢这样的节日的。",
            "nextDialogs": [
              "736970750"
            ]
          },
          "736970750": {
            "id": "736970750",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…也许祖尔宛说得对，斯露莎要成为称职的花灵勇者还需要一些磨练…"
          },
          "736970733": {
            "id": "736970733",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "和学者才会有的林居狂语期不一样，的确，听说很多人类小孩都会有这个阶段呢…"
          }
        }
      }
    },
    {
      "subId": "7369799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736979901"
        ],
        "dialogs": {
          "736979901": {
            "id": "736979901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说回来，这些训练的内容祖尔宛早就准备好了吗？看来是一开始就打算让斯露莎来干这些事呢。",
            "nextDialogs": [
              "736979902"
            ]
          },
          "736979902": {
            "id": "736979902",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "哼哼，这说明其实前辈一开始就很看好我嘛。",
            "nextDialogs": [
              "736979903"
            ]
          },
          "736979903": {
            "id": "736979903",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "白飘飘，还有吾之「谒颂主」，可要将我的英姿好好记录下来啊。"
          }
        }
      }
    }
  ]
}
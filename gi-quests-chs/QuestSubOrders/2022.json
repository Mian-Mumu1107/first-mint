      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705322201"
        ],
        "dialogs": {
          "705322201": {
            "id": "705322201",
            "speakerId": 1020,
            "speakerName": "泽彦",
            "text": "这个题材不错，这个情节…嗯…能不能用呢…",
            "nextDialogs": [
              "705322202"
            ]
          },
          "705322202": {
            "id": "705322202",
            "speakerId": 1020,
            "speakerName": "泽彦",
            "text": "旅行者！不好意思，我刚才在想着轻小说的事，有点走神了…",
            "nextDialogs": [
              "705322203"
            ]
          },
          "705322203": {
            "id": "705322203",
            "speakerId": 1020,
            "speakerName": "泽彦",
            "text": "请问我有什么能帮您的吗？"
          }
        }
      }
    },
    {
      "subId": "7053223",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705322301"
        ],
        "dialogs": {
          "705322301": {
            "id": "705322301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「零时召唤」…",
            "nextDialogs": [
              "705322302"
            ]
          },
          "705322302": {
            "id": "705322302",
            "speakerId": 1020,
            "speakerName": "泽彦",
            "text": "喔，没错，我就是负责这件事的人，您是想要玩「零时召唤」吗？",
            "nextDialogs": [
              "705322303"
            ]
          },
          "705322303": {
            "id": "705322303",
            "speakerId": 1020,
            "speakerName": "泽彦",
            "text": "在这里可以组建牌组，如果您有其他的问题，也可以直接问我。",
            "nextDialogs": [
              "705322304"
            ]
          },
          "705322304": {
            "id": "705322304",
            "speakerId": 1020,
            "speakerName": "泽彦",
            "text": "您的对手「雪中刀」已经准备好了，等您也准备好之后，就可以直接开始对局了。"
          }
        }
      }
    },
    {
      "subId": "7053224",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705322401"
        ],
        "dialogs": {
          "705322401": {
            "id": "705322401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「械画」…",
            "nextDialogs": [
              "705322402"
            ]
          },
          "705322402": {
            "id": "705322402",
            "speakerId": 1020,
            "speakerName": "泽彦",
            "text": "菲利斯先生的「械画」就在这边！非常精美的工艺品…我自己都尝试着拼接了好几次呢。",
            "nextDialogs": [
              "705322403"
            ]
          },
          "705322403": {
            "id": "705322403",
            "speakerId": 1020,
            "speakerName": "泽彦",
            "text": "观赏这种精美的工艺品，简直是一种享受…",
            "nextDialogs": [
              "705322404"
            ]
          },
          "705322404": {
            "id": "705322404",
            "speakerId": 1020,
            "speakerName": "泽彦",
            "text": "不，不好意思…我们还是说正事。",
            "nextDialogs": [
              "705322405"
            ]
          },
          "705322405": {
            "id": "705322405",
            "speakerId": 1020,
            "speakerName": "泽彦",
            "text": "如果您也想要试着拼接「械画」的话，可以直接去那边研究一下。"
          }
        }
      }
    },
    {

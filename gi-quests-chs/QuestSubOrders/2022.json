        ],
        "dialogs": {
          "705324301": {
            "id": "705324301",
            "speakerId": 1007,
            "speakerName": "提纳里",
            "text": "别气馁，只不过是输了一局，下一局赢回来就是。"
          }
        }
      }
    },
    {
      "subId": "7053244",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705324401"
        ],
        "dialogs": {
          "705324401": {
            "id": "705324401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事…",
            "nextDialogs": [
              "705324402"
            ]
          },
          "705324402": {
            "id": "705324402",
            "speakerId": 1022,
            "speakerName": "冬雅",
            "text": "那您先忙去吧，在「召唤王大奖赛」期间，我会一直在这里。",
            "nextDialogs": [
              "705324403"
            ]
          },
          "705324403": {
            "id": "705324403",
            "speakerId": 1022,
            "speakerName": "冬雅",
            "text": "您想玩「零时召唤」的话，直接过来找我就好，我会帮忙准备好一切的。"
          }
        }
      }
    },
    {
      "subId": "7053302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705330201"
        ],
        "dialogs": {
          "705330201": {
            "id": "705330201",
            "speakerId": 1024,
            "speakerName": "菲利斯·尤格",
            "text": "旅行者，怎么样？你是想来尝试拼接一下这幅「械画」吗？",
            "nextDialogs": [
              "705330203",
              "705330206"
            ]
          },
          "705330203": {
            "id": "705330203",
            "speakerId": 1024,
            "speakerName": "菲利斯·尤格",
            "text": "哈哈哈，好，我相信以您的聪明才智，这幅「械画」绝对难不倒您。",
            "nextDialogs": [
              "705330204"
            ]
          },
          "705330204": {
            "id": "705330204",
            "speakerId": 1024,
            "speakerName": "菲利斯·尤格",
            "text": "「械画」就放在旁边，您可以直接去试试。"
          },
          "705330206": {
            "id": "705330206",
            "speakerId": 1024,
            "speakerName": "菲利斯·尤格",
            "text": "呃…没问题，等您有空了再来玩也行，反正我最近要一直呆在这…"
          }
        }
      }
    },
    {
      "subId": "7053402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705340201"
        ],
        "dialogs": {
          "705340201": {
            "id": "705340201",
            "speakerId": 1025,
            "speakerName": "费恩",
            "text": "旅行者，您想体验一下「妙骰战法」吗？",
            "nextDialogs": [
              "705340203",
              "705340206"
            ]
          },
          "705340203": {
            "id": "705340203",
            "speakerId": 1025,
            "speakerName": "费恩",
            "text": "没问题。呃…您看完那本规则书了吗？",
            "nextDialogs": [
              "705340204"
            ]
          },
          "705340204": {
            "id": "705340204",
            "speakerId": 1025,
            "speakerName": "费恩",
            "text": "没事没事，看不看完都能玩，玩着玩着就熟悉了…"
          },
          "705340206": {
            "id": "705340206",
            "speakerId": 1025,
            "speakerName": "费恩",
            "text": "没空啊？行吧，等您想玩的时候，过来这边找我就行。反正只要「召唤王大奖赛」还没结束，我就不能收摊…"
          }
        }
      }
    }
  ]

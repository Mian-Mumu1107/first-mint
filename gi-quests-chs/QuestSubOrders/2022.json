            ]
          },
          "705322504": {
            "id": "705322504",
            "speakerId": 1021,
            "speakerName": "神里绫华",
            "text": "嗯，我也要再去研究一下牌组了，毕竟是正式比赛，我不能露怯。"
          }
        }

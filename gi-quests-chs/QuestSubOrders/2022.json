          "705324101": {
            "id": "705324101",
            "speakerId": 1007,
            "speakerName": "提纳里",
            "text": "你还挺有兴致的，那就开局吧。",
            "nextDialogs": [
              "705324104"
            ]
          },
          "705324104": {
            "id": "705324104",
            "speakerId": 1007,
            "speakerName": "提纳里",
            "text": "来参加这比赛的人也太多了，吵得我耳朵痛，唉…"
          }
        }
      }
    },
    {
      "subId": "7053242",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705324201"
        ],
        "dialogs": {
          "705324201": {
            "id": "705324201",
            "speakerId": 1007,
            "speakerName": "提纳里",
            "text": "挺厉害的嘛，看得出来你事先做了不少功课。"
          }
        }
      }
    },
    {
      "subId": "7053243",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

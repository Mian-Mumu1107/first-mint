    {
      "subId": "4011141",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401114101"
        ],
        "dialogs": {
          "401114101": {
            "id": "401114101",
            "speakerId": 1002,
            "speakerName": "迪奥娜",
            "text": "臭老爹，要打牌吗？",
            "nextDialogs": [
              "401114102"
            ]
          },
          "401114102": {
            "id": "401114102",
            "speakerId": 1002,
            "speakerName": "迪奥娜",
            "text": "我可有言在先哦！要是你今天喝了酒，脑袋晕乎乎的，肯定在三回合内就输给我了。",
            "nextDialogs": [
              "401114103"
            ]
          },
          "401114103": {
            "id": "401114103",
            "speakerId": 1003,
            "speakerName": "杜拉夫",
            "text": "三回合？迪奥娜是不是有点小看爸爸了啊？",
            "nextDialogs": [
              "401114104"
            ]
          },
          "401114104": {
            "id": "401114104",
            "speakerId": 1003,
            "speakerName": "杜拉夫",
            "text": "再怎么说也能拖到五回合吧。",
            "nextDialogs": [
              "401114105"
            ]
          },
          "401114105": {
            "id": "401114105",
            "speakerId": 1002,
            "speakerName": "迪奥娜",
            "text": "一样是输！那有什么好骄傲的！",
            "nextDialogs": [
              "401114106"
            ]
          },
          "401114106": {
            "id": "401114106",
            "speakerId": 1002,
            "speakerName": "迪奥娜",
            "text": "上次，臭老爹你还指着水元素的骰子，对我说是冰元素！气死人了。",
            "nextDialogs": [
              "401114107"
            ]
          },
          "401114107": {
            "id": "401114107",
            "speakerId": 1003,
            "speakerName": "杜拉夫",
            "text": "哈哈哈，是我眼神不好…",
            "nextDialogs": [
              "401114108"
            ]
          },
          "401114108": {
            "id": "401114108",
            "speakerId": 1002,
            "speakerName": "迪奥娜",
            "text": "是「酒」不好！不许为它辩护。",
            "nextDialogs": [
              "401114109"
            ]
          },
          "401114109": {
            "id": "401114109",
            "speakerId": 1003,
            "speakerName": "杜拉夫",
            "text": "好好好，是酒不好。那今天就先不喝了，一滴也不碰，这下总行了吧？",
            "nextDialogs": [
              "401114110"
            ]
          },
          "401114110": {
            "id": "401114110",
            "speakerId": 1002,
            "speakerName": "迪奥娜",
            "text": "勉勉强强。",
            "nextDialogs": [
              "401114111"
            ]
          },
          "401114111": {
            "id": "401114111",
            "speakerId": 1003,
            "speakerName": "杜拉夫",
            "text": "那我要是赢了迪奥娜呢？有没有什么奖励？",
            "nextDialogs": [
              "401114112"
            ]
          },
          "401114112": {
            "id": "401114112",
            "speakerId": 1002,
            "speakerName": "迪奥娜",
            "text": "想我给你做一杯特调？门都没有！",
            "nextDialogs": [
              "401114113"
            ]
          },
          "401114113": {
            "id": "401114113",
            "speakerId": 1003,
            "speakerName": "杜拉夫",
            "text": "如果是在五回合之内赢的呢？…",
            "nextDialogs": [
              "401114114"
            ]
          },
          "401114114": {
            "id": "401114114",
            "speakerId": 1002,
            "speakerName": "迪奥娜",
            "text": "小看我！来就来…我才不会输呢！"
          }
        }
      }
    },
    {
      "subId": "4011142",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401114201"
        ],
        "dialogs": {
          "401114201": {
            "id": "401114201",
            "speakerId": 1004,
            "speakerName": "北斗",
            "text": "几日不见，小子，你的牌技怎么长进这么多？",
            "nextDialogs": [
              "401114202"
            ]
          },
          "401114202": {
            "id": "401114202",
            "speakerId": 1005,
            "speakerName": "枫原万叶",
            "text": "多亏和高人交过手。",
            "nextDialogs": [
              "401114203"
            ]
          },
          "401114203": {
            "id": "401114203",
            "speakerId": 1004,
            "speakerName": "北斗",
            "text": "哦？哪位高人？你先别急着说…让我猜猜。",
            "nextDialogs": [
              "401114204"
            ]
          },
          "401114204": {
            "id": "401114204",
            "speakerId": 1004,
            "speakerName": "北斗",
            "text": "凝光那家伙没这个闲心，香菱和辛焱也不是一直琢磨牌的人…",
            "nextDialogs": [
              "401114205"
            ]
          },
          "401114205": {
            "id": "401114205",
            "speakerId": 1004,
            "speakerName": "北斗",
            "text": "瑶瑶最近要是不忙，早耐不住往船上跑，和大家打招呼了。也不会是她。",
            "nextDialogs": [
              "401114206"
            ]
          },
          "401114206": {
            "id": "401114206",
            "speakerId": 1004,
            "speakerName": "北斗",
            "text": "#难道是{NICKNAME}？{M#他}{F#她}刚巧也来璃月港了？",
            "nextDialogs": [
              "401114207"
            ]
          },
          "401114207": {
            "id": "401114207",
            "speakerId": 1005,
            "speakerName": "枫原万叶",
            "text": "#可惜大姐头还是猜的不对。我的确和{NICKNAME}同行了一阵，期间也「以牌会友」…",
            "nextDialogs": [
              "401114208"
            ]
          },
          "401114208": {
            "id": "401114208",
            "speakerId": 1004,
            "speakerName": "北斗",
            "text": "新朋友？那我就猜不出了。",
            "nextDialogs": [
              "401114209"
            ]
          },
          "401114209": {
            "id": "401114209",
            "speakerId": 1005,
            "speakerName": "枫原万叶",
            "text": "往生堂堂主，胡桃小姐。大姐头可有耳闻？",
            "nextDialogs": [
              "401114210"
            ]
          },
          "401114210": {
            "id": "401114210",
            "speakerId": 1004,
            "speakerName": "北斗",
            "text": "听倒是听说过。这次拿了「召唤王大奖赛」冠军的也是她吧？",
            "nextDialogs": [
              "401114211"
            ]
          },
          "401114211": {
            "id": "401114211",
            "speakerId": 1005,
            "speakerName": "枫原万叶",
            "text": "正是。她还说对大姐头崇拜已久，一直想跟你交个朋友。",
            "nextDialogs": [
              "401114212"
            ]
          },
          "401114212": {
            "id": "401114212",
            "speakerId": 1004,
            "speakerName": "北斗",
            "text": "那好啊！这不是正好吗？",
            "nextDialogs": [
              "401114213"
            ]
          },
          "401114213": {
            "id": "401114213",
            "speakerId": 1004,
            "speakerName": "北斗",
            "text": "把她请来船上，切磋上几局，让我仰望仰望冠军的风采。",
            "nextDialogs": [
              "401114214"
            ]
          },
          "401114214": {
            "id": "401114214",
            "speakerId": 1004,
            "speakerName": "北斗",
            "text": "唔…这么说来，是不是还是我亲自去往生堂，显得比较有诚意？"
          }
        }
      }
    },
    {
      "subId": "4011143",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401114301"
        ],
        "dialogs": {
          "401114301": {
            "id": "401114301",
            "speakerId": 1006,
            "speakerName": "珊瑚宫心海",
            "text": "#咦？{NICKNAME}，你是专程回来见我的吗？",
            "nextDialogs": [
              "401114303"
            ]
          },
          "401114303": {
            "id": "401114303",
            "speakerId": 1006,
            "speakerName": "珊瑚宫心海",
            "text": "原来谜底是这样…让人不知该以怎样的表情面对呢。",
            "nextDialogs": [
              "401114304"
            ]
          },
          "401114304": {
            "id": "401114304",
            "speakerId": 1006,
            "speakerName": "珊瑚宫心海",
            "text": "谢谢你能告诉我这些。",
            "nextDialogs": [
              "401114305"
            ]
          },
          "401114305": {
            "id": "401114305",
            "speakerId": 1006,
            "speakerName": "珊瑚宫心海",
            "text": "就像读完了小说的结尾，这下可以安心了。"
          }
        }
      }
    },
    {
      "subId": "4011144",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401114401"
        ],
        "dialogs": {
          "401114401": {
            "id": "401114401",
            "speakerId": 1007,
            "speakerName": "提纳里",
            "text": "这么巧？赛诺先前和我讲了你们的经历。",
            "nextDialogs": [
              "401114403"
            ]
          },
          "401114403": {
            "id": "401114403",
            "speakerId": 1007,
            "speakerName": "提纳里",
            "text": "停！赛诺已经满脸得意地和我一一细数了他想出的冷笑话。我不想听第二遍了。",
            "nextDialogs": [
              "401114404"
            ]
          },
          "401114404": {
            "id": "401114404",
            "speakerId": 1007,
            "speakerName": "提纳里",
            "text": "这个话题到此为止吧。"
          }
        }
      }
    },
    {
      "subId": "4011161",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401116101"
        ],
        "dialogs": {
          "401116101": {
            "id": "401116101",
            "speakerId": 1008,
            "speakerName": "大赛公告",
            "text": "提米选手一路过关斩将，牌运如有风神相助！一跃成为蒙德赛区热门夺冠人选！",
            "nextDialogs": [
              "401116102"
            ]
          },
          "401116102": {
            "id": "401116102",
            "speakerId": 1009,
            "speakerName": "留言",
            "text": "提米小弟是真不一般，我看了他与一位金发姑娘的比赛，赢得真是精彩。",
            "nextDialogs": [
              "401116103"
            ]
          },
          "401116103": {
            "id": "401116103",
            "speakerId": 1010,
            "speakerName": "匿名回复",
            "text": "愚昧！汝可曾看到那位少年背后圣耀的翎羽？",
            "nextDialogs": [
              "401116104"
            ]
          },
          "401116104": {
            "id": "401116104",
            "speakerId": 1010,
            "speakerName": "匿名回复",
            "text": "定是其辉灼的光芒桎梏了那位皇女的断罪之眼，才使得命运的天平产生了偏谬！",
            "nextDialogs": [
              "401116105"
            ]
          },
          "401116105": {
            "id": "401116105",
            "speakerId": 1010,
            "speakerName": "匿名回复",
            "text": "下次本皇女一定会带上幽夜净土的扈从一报前仇！",
            "nextDialogs": [
              "401116106"
            ]
          },
          "401116106": {
            "id": "401116106",
            "speakerId": 1011,
            "speakerName": "被涂得模糊不清的留言",
            "text": "██咪，别在██待太晚了，看到这██的话就早点回██饭。"
          }
        }
      }
    },
    {
      "subId": "4011162",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401116201"
        ],
        "dialogs": {
          "401116201": {
            "id": "401116201",
            "speakerId": 1008,
            "speakerName": "大赛公告",
            "text": "欢迎大家在大赛期间光临会场周边各类特色小吃摊。「清心薄荷凉糕」限量热卖中。",
            "nextDialogs": [
              "401116202"
            ]
          },
          "401116202": {
            "id": "401116202",
            "speakerId": 1009,
            "speakerName": "留言",
            "text": "这个「清心薄荷凉糕」真的那么好吃吗？我来好几次了，一次都没见到…",
            "nextDialogs": [
              "401116203"
            ]
          },
          "401116203": {
            "id": "401116203",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "兄弟是这几天才来的吧？听说这是仙人喜欢吃的东西，开售第一天就被抢完了。",
            "nextDialogs": [
              "401116204"
            ]
          },
          "401116204": {
            "id": "401116204",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "吃起来挺清爽的，就是的确有点苦。",
            "nextDialogs": [
              "401116205"
            ]
          },
          "401116205": {
            "id": "401116205",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "好苦。",
            "nextDialogs": [
              "401116206"
            ]
          },
          "401116206": {
            "id": "401116206",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "好苦好苦。",
            "nextDialogs": [
              "401116207"
            ]
          },
          "401116207": {
            "id": "401116207",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "好吃。",
            "nextDialogs": [
              "401116208"
            ]
          },
          "401116208": {
            "id": "401116208",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "可恶啊，我更好奇了！这点心什么时候返场？店家赶紧安排起来啊！",
            "nextDialogs": [
              "401116209"
            ]
          },
          "401116209": {
            "id": "401116209",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "说起来…仙人也会玩「七圣召唤」吗？",
            "nextDialogs": [
              "401116210"
            ]
          },
          "401116210": {
            "id": "401116210",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "有趣的东西谁都喜欢吧？"
          }
        }
      }
    },
    {
      "subId": "4011163",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401116301"
        ],
        "dialogs": {
          "401116301": {
            "id": "401116301",
            "speakerId": 1008,
            "speakerName": "大赛公告",
            "text": "稻妻赛区的决赛，将由鸣神大社宫司八重神子，对阵海祇岛现人神巫女珊瑚宫心海！",
            "nextDialogs": [
              "401116302"
            ]
          },
          "401116302": {
            "id": "401116302",
            "speakerId": 1008,
            "speakerName": "大赛公告",
            "text": "这道倨傲的惊雷，是否能在那深不可测的海底鸣响？",
            "nextDialogs": [
              "401116303"
            ]
          },
          "401116303": {
            "id": "401116303",
            "speakerId": 1013,
            "speakerName": "八重堂广告",
            "text": "全新修订版精装《召唤王》正在各大会场售卖，现在购买的话还送书中同款「禁忌骰」周边一枚！",
            "nextDialogs": [
              "401116304"
            ]
          },
          "401116304": {
            "id": "401116304",
            "speakerId": 1009,
            "speakerName": "留言",
            "text": "我永远支持八重神子大人！",
            "nextDialogs": [
              "401116305"
            ]
          },
          "401116305": {
            "id": "401116305",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "别想了，最后胜利的肯定是我们海祇岛的珊瑚宫心海大人。",
            "nextDialogs": [
              "401116306"
            ]
          },
          "401116306": {
            "id": "401116306",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "痴心妄想！敢不敢来打赌？",
            "nextDialogs": [
              "401116307"
            ]
          },
          "401116307": {
            "id": "401116307",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "来就来！输了的晚上请客吃饭！",
            "nextDialogs": [
              "401116308"
            ]
          },
          "401116308": {
            "id": "401116308",
            "speakerId": 1014,
            "speakerName": "天领奉行回复",
            "text": "请各位遵守会场秩序，理性观赛。"
          }
        }
      }
    },
    {
      "subId": "4011164",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401116401"
        ],
        "dialogs": {
          "401116401": {
            "id": "401116401",
            "speakerId": 1008,
            "speakerName": "大赛公告",
            "text": "召唤王大奖赛热烈举办中！坊间比赛人才辈出，欢迎大家前来决斗！",
            "nextDialogs": [
              "401116402"
            ]
          },
          "401116402": {
            "id": "401116402",
            "speakerId": 1009,
            "speakerName": "留言",
            "text": "没想到你们这些搞建筑的玩牌这么厉害，我看大赛八强里有好几个都是妙论派的人。",
            "nextDialogs": [
              "401116403"
            ]
          },
          "401116403": {
            "id": "401116403",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "什么叫「搞建筑的」？我们平时研究的建筑几何还有机关术，比那些搞文字的知论派还要复杂得多。",
            "nextDialogs": [
              "401116404"
            ]
          },
          "401116404": {
            "id": "401116404",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "这话我可就不爱听了。什么叫「搞文字的」？语言学和符文学可是很深奥的学问。",
            "nextDialogs": [
              "401116405"
            ]
          },
          "401116405": {
            "id": "401116405",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "大家都各有所长。既然谁也不服谁的话，不如我们办一场「召唤王学院争霸赛」吧！",
            "nextDialogs": [
              "401116406"
            ]
          },
          "401116406": {
            "id": "401116406",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "好主意！",
            "nextDialogs": [
              "401116407"
            ]
          },
          "401116407": {
            "id": "401116407",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "好主意！",
            "nextDialogs": [
              "401116408"
            ]
          },
          "401116408": {
            "id": "401116408",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "咱们赛场上见！"
          }
        }
      }
    },
    {

          "705321301"
        ],
        "dialogs": {
          "705321301": {
            "id": "705321301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「零时召唤」…",
            "nextDialogs": [
              "705321302"
            ]
          },
          "705321302": {
            "id": "705321302",
            "speakerId": 1018,
            "speakerName": "络紫",
            "text": "喔？你是想要玩这个啊，没问题。要组建牌组的话请来这边。",
            "nextDialogs": [
              "705321303"
            ]
          },
          "705321303": {
            "id": "705321303",
            "speakerId": 1018,
            "speakerName": "络紫",
            "text": "对了，你的对手是「虹雨」，对局要加油喔。",
            "nextDialogs": [
              "705321304"
            ]
          },
          "705321304": {
            "id": "705321304",
            "speakerId": 1018,
            "speakerName": "络紫",
            "text": "这个「零时召唤」居然这么热门，嗯…总感觉这里面有一点点商机…",
            "nextDialogs": [
              "705321305"
            ]
          },
          "705321305": {
            "id": "705321305",
            "speakerId": 1018,
            "speakerName": "络紫",
            "text": "咳…请您在这边组建卡牌，需要我帮忙的话，招呼一声就好。"
          }
        }
      }
    },
    {
      "subId": "7053214",
      "subQuestName": "Additional",
      "sceneId": null,

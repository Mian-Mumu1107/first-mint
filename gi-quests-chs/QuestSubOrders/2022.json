    {
      "subId": "7053229",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705322901"
        ],
        "dialogs": {
          "705322901": {
            "id": "705322901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事…",
            "nextDialogs": [
              "705322902"
            ]
          },
          "705322902": {
            "id": "705322902",
            "speakerId": 1020,
            "speakerName": "泽彦",
            "text": "没关系，我会一直待在这里，毕竟工作在身嘛…",
            "nextDialogs": [
              "705322903"
            ]
          },
          "705322903": {
            "id": "705322903",
            "speakerId": 1020,
            "speakerName": "泽彦",
            "text": "如果您想体验「零时召唤」，欢迎随时来找我。"
          }
        }
      }
    },
    {
      "subId": "7053232",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705323201"
        ],
        "dialogs": {
          "705323201": {
            "id": "705323201",
            "speakerId": 1022,
            "speakerName": "冬雅",
            "text": "七圣召唤…械画…这两个东西挨得上边吗…"
          }
        }
      }
    },
    {
      "subId": "7053233",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705323301"
        ],
        "dialogs": {
          "705323301": {
            "id": "705323301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「零时召唤」…",
            "nextDialogs": [
              "705323302"
            ]
          },
          "705323302": {
            "id": "705323302",
            "speakerId": 1022,
            "speakerName": "冬雅",
            "text": "嗯？您想要试试「零时召唤」？",
            "nextDialogs": [
              "705323303"
            ]
          },
          "705323303": {
            "id": "705323303",
            "speakerId": 1022,
            "speakerName": "冬雅",
            "text": "没问题，请来这边组建卡组，有其他的问题也可以直接问我。",
            "nextDialogs": [
              "705323304"
            ]
          },
          "705323304": {
            "id": "705323304",
            "speakerId": 1022,
            "speakerName": "冬雅",
            "text": "现在正好有一位牌手在等着和人对局，这位牌手叫做「复活的薮猫」。",
            "nextDialogs": [
              "705323305"
            ]
          },
          "705323305": {
            "id": "705323305",
            "speakerId": 1022,
            "speakerName": "冬雅",
            "text": "等您准备好之后，就可以直接开始对局了。"
          }
        }
      }
    },
    {
      "subId": "7053234",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705323401"
        ],
        "dialogs": {
          "705323401": {
            "id": "705323401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「械画」…",
            "nextDialogs": [
              "705323402"
            ]
          },
          "705323402": {
            "id": "705323402",
            "speakerId": 1022,
            "speakerName": "冬雅",
            "text": "那个枫丹人做的机关装置？我放在那边了。",
            "nextDialogs": [
              "705323403"
            ]
          },
          "705323403": {
            "id": "705323403",
            "speakerId": 1022,
            "speakerName": "冬雅",
            "text": "我？我对机关一类的事物没什么兴趣，也没研究过那个装置。",
            "nextDialogs": [
              "705323404"
            ]
          },
          "705323404": {
            "id": "705323404",
            "speakerId": 1022,
            "speakerName": "冬雅",
            "text": "如果您想研究一下「械画」的话，去那边就好。"
          }
        }
      }
    },
    {
      "subId": "7053235",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705323501"
        ],
        "dialogs": {
          "705323501": {
            "id": "705323501",
            "speakerId": 1023,
            "speakerName": "柯莱",
            "text": "呜哇…好多人都在玩七圣召唤，好…好紧张…",
            "nextDialogs": [
              "705323504"
            ]
          },
          "705323504": {
            "id": "705323504",
            "speakerId": 1023,
            "speakerName": "柯莱",
            "text": "你要走了？我，我也要去找师父了，师父在哪等我来着…"
          }
        }
      }
    },
    {
      "subId": "7053236",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705323601"
        ],
        "dialogs": {
          "705323601": {
            "id": "705323601",
            "speakerId": 1023,
            "speakerName": "柯莱",
            "text": "刚才那种情况…我没应付过…"
          }
        }
      }
    },
    {
      "subId": "7053237",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

            "id": "705320301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想要玩玩看。",
            "nextDialogs": [
              "705320302"
            ]
          },
          "705320302": {
            "id": "705320302",
            "speakerId": 1016,
            "speakerName": "弗丽德",
            "text": "没问题，那就请你挑选想要使用的卡牌吧。",
            "nextDialogs": [
              "705320303"
            ]
          },
          "705320303": {
            "id": "705320303",
            "speakerId": 1016,
            "speakerName": "弗丽德",
            "text": "喔！还有你的决斗对手，我看看啊…不少牌手都用代名来参加比赛，这些代名都有些不好记…",
            "nextDialogs": [
              "705320304"
            ]
          },
          "705320304": {
            "id": "705320304",
            "speakerId": 1016,
            "speakerName": "弗丽德",
            "text": "有了，你的决斗对手是…「快乐小火把」，等你准备好了之后，就直接开始对局吧。"
          }
        }
      }
    },
    {
      "subId": "7053204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705320401"
        ],
        "dialogs": {

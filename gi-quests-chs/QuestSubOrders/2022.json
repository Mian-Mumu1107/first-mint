            "id": "705320401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事…",
            "nextDialogs": [
              "705320402"
            ]
          },
          "705320402": {
            "id": "705320402",
            "speakerId": 1016,
            "speakerName": "弗丽德",
            "text": "没关系，没关系。「零时召唤」又不是举办个一两天就结束了。",
            "nextDialogs": [
              "705320403"
            ]
          },
          "705320403": {
            "id": "705320403",
            "speakerId": 1016,
            "speakerName": "弗丽德",
            "text": "在「召唤王大奖赛」期间，你随时都可以过来体验「零时召唤」。"
          }
        }
      }
    },
    {

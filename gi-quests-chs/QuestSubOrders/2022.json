          "705323701"
        ],
        "dialogs": {
          "705323701": {
            "id": "705323701",
            "speakerId": 1023,
            "speakerName": "柯莱",
            "text": "终于赢了！总算没白参加这次比赛…"
          }
        }
      }
    },

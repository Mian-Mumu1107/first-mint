              "705321402"
            ]
          },
          "705321402": {
            "id": "705321402",
            "speakerId": 1018,
            "speakerName": "络紫",
            "text": "「械画」？您说的是那种可以拆解再拼接的机关画吧？",
            "nextDialogs": [
              "705321403"
            ]
          },
          "705321403": {
            "id": "705321403",
            "speakerId": 1018,
            "speakerName": "络紫",
            "text": "我身边的这幅就是，前几天协会刚刚送过来。",
            "nextDialogs": [
              "705321404"
            ]
          },
          "705321404": {
            "id": "705321404",
            "speakerId": 1018,
            "speakerName": "络紫",
            "text": "如果您有兴趣的话，可以直接去试试拼接。"
          }
        }
      }
    },
    {
      "subId": "7053215",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705321501"
        ],
        "dialogs": {
          "705321501": {
            "id": "705321501",
            "speakerId": 1019,
            "speakerName": "行秋",
            "text": "原来是你要和我对局吗？太好了，我正想找个强手切磋呢。",
            "nextDialogs": [
              "705321504"
            ]
          },
          "705321504": {
            "id": "705321504",
            "speakerId": 1019,
            "speakerName": "行秋",
            "text": "这「七圣召唤」比赛，要「过关斩将」可真不容易。"
          }
        }
      }
    },
    {
      "subId": "7053216",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705321601"
        ],
        "dialogs": {

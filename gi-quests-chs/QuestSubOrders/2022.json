            "speakerId": 1021,
            "speakerName": "神里绫华",
            "text": "呼…我输得心服口服。"
          }
        }
      }
    },
    {
      "subId": "7053227",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705322701"
        ],
        "dialogs": {

  "subQuests": [
    {
      "subId": "1101801",
      "subQuestName": "在璃月港逛逛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110180101"
        ],
        "dialogs": {
          "110180101": {
            "id": "110180101",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "#{NICKNAME}、派蒙，好久不见。",
            "nextDialogs": [
              "110180102"
            ]
          },
          "110180102": {
            "id": "110180102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？慧心，好久不见啦！",
            "nextDialogs": [
              "110180103"
            ]
          },
          "110180103": {
            "id": "110180103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没想到在这里遇见你，最近工作还顺利吗？",
            "nextDialogs": [
              "110180104"
            ]
          },
          "110180104": {
            "id": "110180104",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "多亏了你们和甘雨前辈的帮助，我已经越来越得心应手了。",
            "nextDialogs": [
              "110180105"
            ]
          },
          "110180105": {
            "id": "110180105",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "不过最近工作的时候总会分神，感觉静不下心来…",
            "nextDialogs": [
              "110180106"
            ]
          },
          "110180106": {
            "id": "110180106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么事了吗？",
            "nextDialogs": [
              "110180107"
            ]
          },
          "110180107": {
            "id": "110180107",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "唉，说来话长。父亲他…因为身体原因，想要卸任「天枢星」了。",
            "nextDialogs": [
              "110180108"
            ]
          },
          "110180108": {
            "id": "110180108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸——天叔出什么事了吗？",
            "nextDialogs": [
              "110180109"
            ]
          },
          "110180109": {
            "id": "110180109",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "按父亲的说法，倒是没什么身体上的不适，只是感觉精力越来越匮乏。",
            "nextDialogs": [
              "110180110"
            ]
          },
          "110180110": {
            "id": "110180110",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "「每个人都有老去的一天」…虽然父亲常常这么说，但看到他脸上的皱纹越来越深，我心里还是有一种说不出的滋味。",
            "nextDialogs": [
              "110180111"
            ]
          },
          "110180111": {
            "id": "110180111",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "对了，父亲他现在在岩上茶室二楼。要不要一起来探望一下？",
            "nextDialogs": [
              "110180112"
            ]
          },
          "110180112": {
            "id": "110180112",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "父亲似乎很喜欢你们，能和你们聊聊天的话，他应该也会很开心的。",
            "nextDialogs": [
              "110180113"
            ]
          },
          "110180113": {
            "id": "110180113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好呀！那我们过去看看吧！"
          }
        }
      }
    },
    {
      "subId": "1101802",
      "subQuestName": "前往岩上茶室二楼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1101803",
      "subQuestName": "与天叔交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110180301"
        ],
        "dialogs": {
          "110180301": {
            "id": "110180301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "天叔！我们来找你聊天啦！",
            "nextDialogs": [
              "110180302"
            ]
          },
          "110180302": {
            "id": "110180302",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "哦？这可真是稀客，欢迎。慧心，你去找楼下的掌柜，再加一壶新到的茶。",
            "nextDialogs": [
              "110180303"
            ]
          },
          "110180303": {
            "id": "110180303",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "听说你们最近又去了不少地方，我也想听听你们的冒险故事。",
            "nextDialogs": [
              "110180306"
            ]
          },
          "110180306": {
            "id": "110180306",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "看来你们已经听慧心说了…放心吧，我的身体没什么大碍，只是岁月不饶人罢了。",
            "nextDialogs": [
              "110180307"
            ]
          },
          "110180307": {
            "id": "110180307",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "随着年纪越来越大，我开始对许多事情感到力不从心。最近这段时间，更是感觉精力直线下滑。",
            "nextDialogs": [
              "110180308"
            ]
          },
          "110180308": {
            "id": "110180308",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "虽然大家都说我德高望重，但我也想趁自己还没老糊涂，把天枢星的位置交接出去。",
            "nextDialogs": [
              "110180309"
            ]
          },
          "110180309": {
            "id": "110180309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "天枢星交接…会很麻烦吗？",
            "nextDialogs": [
              "110180310"
            ]
          },
          "110180310": {
            "id": "110180310",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "在璃月七星中，天枢星的存在比较特殊。",
            "nextDialogs": [
              "110180311"
            ]
          },
          "110180311": {
            "id": "110180311",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "历代天枢星很少公开露面，大多是在背后出谋划策，所以不适合公开选拔。",
            "nextDialogs": [
              "110180312"
            ]
          },
          "110180312": {
            "id": "110180312",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "而且，我们希望天枢星的候选人尽量不要受各方势力影响，所以考核与委任也会相对隐秘。",
            "nextDialogs": [
              "110180313"
            ]
          },
          "110180313": {
            "id": "110180313",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "基于这些原因，天枢星的更替，通常是上代天枢星给出意见，其余七星成员共同确认。",
            "nextDialogs": [
              "110180314"
            ]
          },
          "110180314": {
            "id": "110180314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也就是说…是由天叔推荐候选人，然后由刻晴、凝光小姐还有其他七星一起任命？",
            "nextDialogs": [
              "110180315"
            ]
          },
          "110180315": {
            "id": "110180315",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "没错。只可惜以我现在的身体状况，来不及对候选人一一考校了。",
            "nextDialogs": [
              "110180316"
            ]
          },
          "110180316": {
            "id": "110180316",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "不过没关系，我特地找来了一位能力很强的考官。说起来，听说你们已经和她见过面了？",
            "nextDialogs": [
              "110180317"
            ]
          },
          "110180317": {
            "id": "110180317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？是谁呀？",
            "nextDialogs": [
              "110180318"
            ]
          },
          "110180318": {
            "id": "110180318",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "真让人难过…这才多久不见，你们就把我忘了？",
            "nextDialogs": [
              "110180319"
            ]
          },
          "110180319": {
            "id": "110180319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是夜兰！",
            "nextDialogs": [
              "110180320"
            ]
          },
          "110180320": {
            "id": "110180320",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "没错，受天叔邀请，由我来对三位候选人进行调查。",
            "nextDialogs": [
              "110180321"
            ]
          },
          "110180321": {
            "id": "110180321",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "#{NICKNAME}，你跟我一起来如何？这可是能提前认识下一代天枢星的好机会。",
            "nextDialogs": [
              "110180322"
            ]
          },
          "110180322": {
            "id": "110180322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔…{NICKNAME}，你觉得呢？"
          }
        }
      }
    },
    {
      "subId": "1101804",
      "subQuestName": "前往月海亭进行考察",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110180401"
        ],
        "dialogs": {
          "110180401": {
            "id": "110180401",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "站得我腿都麻了…真不知道那考察官在想些什么，这么重要的场合，连张椅子都没有。",
            "nextDialogs": [
              "110180402"
            ]
          },
          "110180402": {
            "id": "110180402",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我也曾和各种各样的人打交道，还是第一次站着等别人。",
            "nextDialogs": [
              "110180403"
            ]
          },
          "110180403": {
            "id": "110180403",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "啊，我倒是…觉得还好…",
            "nextDialogs": [
              "110180404"
            ]
          },
          "110180404": {
            "id": "110180404",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你那是习惯了。总是像这样接受现状的话，将来也什么都改变不了。",
            "nextDialogs": [
              "110180405"
            ]
          },
          "110180405": {
            "id": "110180405",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你这个人，怎么这么…不讲道理…",
            "nextDialogs": [
              "110180406"
            ]
          },
          "110180406": {
            "id": "110180406",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "好了两位，为这点小事争吵，实在有些不值。",
            "nextDialogs": [
              "110180407"
            ]
          },
          "110180407": {
            "id": "110180407",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "乾玮，你刚刚的话有些重了。明博，你也别太计较…站了许久，谁都有些焦躁。",
            "nextDialogs": [
              "110180408"
            ]
          },
          "110180408": {
            "id": "110180408",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我看不如这样：既然没规定我们一定要站着等，那我们不如去附近商会借几张椅子？",
            "nextDialogs": [
              "110180409"
            ]
          },
          "110180409": {
            "id": "110180409",
            "speakerId": 12500,
            "speakerName": "乾玮",
            "text": "也好。虽然那些椅子材质一般，但非常之时，能用就行。",
            "nextDialogs": [
              "110180410"
            ]
          },
          "110180410": {
            "id": "110180410",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "跟着夜兰进到了考察现场…",
            "nextDialogs": [
              "110180411"
            ]
          },
          "110180411": {
            "id": "110180411",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "看来三位候选人都已经到齐了呢。",
            "nextDialogs": [
              "110180412"
            ]
          },
          "110180412": {
            "id": "110180412",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以刚刚那三位就是…",
            "nextDialogs": [
              "110180413"
            ]
          },
          "110180413": {
            "id": "110180413",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "嗯，很快就会跟他们正式见面。在那之前，我先跟你讲解一下这次的考察流程。",
            "nextDialogs": [
              "110180414"
            ]
          },
          "110180414": {
            "id": "110180414",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "这次考察，我分成了两个环节，分别是「时事方略」与「现场问答」。",
            "nextDialogs": [
              "110180415"
            ]
          },
          "110180415": {
            "id": "110180415",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "第一个环节是让他们提交璃月发展规划，第二个环节则是由我们进行现场询问。",
            "nextDialogs": [
              "110180416"
            ]
          },
          "110180416": {
            "id": "110180416",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "因为书写璃月发展规划需要时间，所以我已经提前布置下去了，这些就是收上来的报告书。",
            "nextDialogs": [
              "110180417"
            ]
          },
          "110180417": {
            "id": "110180417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，总觉得有一摞特别的厚…",
            "nextDialogs": [
              "110180418"
            ]
          },
          "110180418": {
            "id": "110180418",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "顺带一提，我对他们讲了一个要求：不管谁成为天枢星，都要将自己规划的内容悉数落实。",
            "nextDialogs": [
              "110180419"
            ]
          },
          "110180419": {
            "id": "110180419",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "除非发生什么重大变故，否则不能更改规划书上的内容。所以眼前这三摞文件，其实代表着他们三个人的「立场」。",
            "nextDialogs": [
              "110180420"
            ]
          },
          "110180420": {
            "id": "110180420",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "还有点时间，你可以大致看一看，对他们有一个初步的印象。",
            "nextDialogs": [
              "110180421"
            ]
          },
          "110180421": {
            "id": "110180421",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "我在旁边等你，看完之后，就来找我吧。"
          }
        }
      }
    },
    {
      "subId": "1101807",
      "subQuestName": "查看候选人的规划书",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110180701"
        ],
        "dialogs": {
          "110180701": {
            "id": "110180701",
            "speakerId": 12537,
            "speakerName": "乾玮的规划书",
            "text": "（乾玮的规划书，上面谈及了许多商业上的问题，不少见解鞭辟入里。）",
            "nextDialogs": [
              "110180702"
            ]
          },
          "110180702": {
            "id": "110180702",
            "speakerId": 12537,
            "speakerName": "乾玮的规划书",
            "text": "（「规矩与利益缺一不可」，这似乎是乾玮的观点。）"
          }
        }
      }
    },
    {
      "subId": "1101808",
      "subQuestName": "查看候选人的规划书",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110180801"
        ],
        "dialogs": {
          "110180801": {
            "id": "110180801",
            "speakerId": 12538,
            "speakerName": "明博的规划书",
            "text": "（明博的规划书，涉及到了内政民生的方方面面。）",
            "nextDialogs": [
              "110180802"
            ]
          },
          "110180802": {
            "id": "110180802",
            "speakerId": 12538,
            "speakerName": "明博的规划书",
            "text": "（「大道之行，天下为公」，这似乎是明博的理念。）"
          }
        }
      }
    },
    {
      "subId": "1101809",
      "subQuestName": "查看候选人的规划书",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110180901"
        ],
        "dialogs": {
          "110180901": {
            "id": "110180901",
            "speakerId": 12403,
            "speakerName": "知易的规划书",
            "text": "（知易的规划书，涉及到内政、外交、监察等各方各面，非常详实。）",
            "nextDialogs": [
              "110180902"
            ]
          },
          "110180902": {
            "id": "110180902",
            "speakerId": 12403,
            "speakerName": "知易的规划书",
            "text": "（看上去以「解决问题」为核心，针对各种问题都给出了简洁明确的解决方案。）",
            "nextDialogs": [
              "110180903"
            ]
          },
          "110180903": {
            "id": "110180903",
            "speakerId": 12403,
            "speakerName": "知易的规划书",
            "text": "（因为实在太厚，只来得及粗略翻阅…）"
          }
        }
      }
    },
    {
      "subId": "1101810",
      "subQuestName": "与夜兰一同考察候选人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110181001"
        ],
        "dialogs": {
          "110181001": {
            "id": "110181001",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "这么快就看完了？有什么感受吗？",
            "nextDialogs": [
              "110181002"
            ]
          },
          "110181002": {
            "id": "110181002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉大家都好认真…",
            "nextDialogs": [
              "110181003"
            ]
          },
          "110181003": {
            "id": "110181003",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "那当然，毕竟涉及到天枢星的选拔，所有人都铆足了力气。",
            "nextDialogs": [
              "110181004"
            ]
          },
          "110181004": {
            "id": "110181004",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "更何况，一旦他们上台，就要遵照规划来处理事务了，谁都不想留下什么遗憾。",
            "nextDialogs": [
              "110181005"
            ]
          },
          "110181005": {
            "id": "110181005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "夜兰的感受呢？",
            "nextDialogs": [
              "110181006"
            ]
          },
          "110181006": {
            "id": "110181006",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "呵呵，暂时保密。等「现场问答」结束后，我们再好好聊聊吧。",
            "nextDialogs": [
              "110181007"
            ]
          },
          "110181007": {
            "id": "110181007",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "可以让候选人过来了。一个一个来吧，先从乾玮开始。",
            "nextDialogs": [
              "110181008"
            ]
          },
          "110181008": {
            "id": "110181008",
            "speakerId": 12534,
            "speakerName": "礼安",
            "text": "是。",
            "nextDialogs": [
              "110181009"
            ]
          },
          "110181009": {
            "id": "110181009",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "礼安将乾玮带了过来…",
            "nextDialogs": [
              "110181010"
            ]
          },
          "110181010": {
            "id": "110181010",
            "speakerId": 12500,
            "speakerName": "乾玮",
            "text": "哦？你们两位就是这次的考察官吗？",
            "nextDialogs": [
              "110181011"
            ]
          },
          "110181011": {
            "id": "110181011",
            "speakerId": 12500,
            "speakerName": "乾玮",
            "text": "本来以为像这么重要的事情，会是凝光大人亲自来考察，没想到居然来了我不认识的人。",
            "nextDialogs": [
              "110181012"
            ]
          },
          "110181012": {
            "id": "110181012",
            "speakerId": 12500,
            "speakerName": "乾玮",
            "text": "我的规划你们应该看过了吧。要是有理解不了的地方，可以找我讲解。",
            "nextDialogs": [
              "110181013"
            ]
          },
          "110181013": {
            "id": "110181013",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好、好大的口气！",
            "nextDialogs": [
              "110181014"
            ]
          },
          "110181014": {
            "id": "110181014",
            "speakerId": 12500,
            "speakerName": "乾玮",
            "text": "抱歉，我没有特别针对谁，只是在阐述一个事实而已。",
            "nextDialogs": [
              "110181017"
            ]
          },
          "110181017": {
            "id": "110181017",
            "speakerId": 12500,
            "speakerName": "乾玮",
            "text": "留云借风，你认识那位仙人吗？哦…我想起来了，你应该就是人们口口相传的那位旅行者。",
            "nextDialogs": [
              "110181018"
            ]
          },
          "110181018": {
            "id": "110181018",
            "speakerId": 12500,
            "speakerName": "乾玮",
            "text": "既然你声名在外，想必有些才学，说不定能理解我的构想…哼，虽然我也没抱太大希望。",
            "nextDialogs": [
              "110181019"
            ]
          },
          "110181019": {
            "id": "110181019",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "夜兰对乾玮进行一番询问后，让他去叫来了明博。",
            "nextDialogs": [
              "110181020"
            ]
          },
          "110181020": {
            "id": "110181020",
            "speakerId": 12499,
            "speakerName": "明博",
            "text": "啊…到我了吗？",
            "nextDialogs": [
              "110181021"
            ]
          },
          "110181021": {
            "id": "110181021",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "嗯，简单介绍一下你自己吧。",
            "nextDialogs": [
              "110181022"
            ]
          },
          "110181022": {
            "id": "110181022",
            "speakerId": 12499,
            "speakerName": "明博",
            "text": "我是明博…隶属于总务司。",
            "nextDialogs": [
              "110181023"
            ]
          },
          "110181023": {
            "id": "110181023",
            "speakerId": 12499,
            "speakerName": "明博",
            "text": "我在总务司工作了九年…五个月…零三天。先后处理过…两千三百四十七宗事件。",
            "nextDialogs": [
              "110181024"
            ]
          },
          "110181024": {
            "id": "110181024",
            "speakerId": 12499,
            "speakerName": "明博",
            "text": "还有十二起正在处理…预计大概…十六天后会全部解决。",
            "nextDialogs": [
              "110181025"
            ]
          },
          "110181025": {
            "id": "110181025",
            "speakerId": 12499,
            "speakerName": "明博",
            "text": "目前我的工作与城市规划相关，也在负责账目验收与核对。准确来说是三部分账目，分别是…",
            "nextDialogs": [
              "110181026"
            ]
          },
          "110181026": {
            "id": "110181026",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉他讲话有些磕磕绊绊的，是我的错觉吗？",
            "nextDialogs": [
              "110181027"
            ]
          },
          "110181027": {
            "id": "110181027",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "算了，先停下自我介绍吧，我直接问问题好了。",
            "nextDialogs": [
              "110181028"
            ]
          },
          "110181028": {
            "id": "110181028",
            "speakerId": 12499,
            "speakerName": "明博",
            "text": "啊…好。抱歉…",
            "nextDialogs": [
              "110181029"
            ]
          },
          "110181029": {
            "id": "110181029",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "夜兰勉强对明博进行一番询问后，让他去叫来了知易。",
            "nextDialogs": [
              "110181030"
            ]
          },
          "110181030": {
            "id": "110181030",
            "speakerId": 12498,
            "speakerName": "知易",
            "text": "你们好。呼…说实话，我还真有点紧张。",
            "nextDialogs": [
              "110181031"
            ]
          },
          "110181031": {
            "id": "110181031",
            "speakerId": 12498,
            "speakerName": "知易",
            "text": "不知两位想问些什么？既然是考察，我会在我能力范围内予以回答。",
            "nextDialogs": [
              "110181032"
            ]
          },
          "110181032": {
            "id": "110181032",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "我看你的规划涉及各个领域，但你好像并未从事许多职业，你能保证自己的规划切实可行吗？",
            "nextDialogs": [
              "110181033"
            ]
          },
          "110181033": {
            "id": "110181033",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "毫不留情的提问…",
            "nextDialogs": [
              "110181034"
            ]
          },
          "110181034": {
            "id": "110181034",
            "speakerId": 12498,
            "speakerName": "知易",
            "text": "两位有这样的疑问，我觉得很正常。",
            "nextDialogs": [
              "110181035"
            ]
          },
          "110181035": {
            "id": "110181035",
            "speakerId": 12498,
            "speakerName": "知易",
            "text": "不过对于规划，我很有信心。我曾外出考察许多地方，与当地更为专业的人进行交流，最终得出结论。",
            "nextDialogs": [
              "110181036"
            ]
          },
          "110181036": {
            "id": "110181036",
            "speakerId": 12498,
            "speakerName": "知易",
            "text": "当然，不同问题之间错综复杂，对应的结论也有冲突。所以我想要的是「平衡」，也就是在所有问题中找到一个「最优解」。",
            "nextDialogs": [
              "110181037"
            ]
          },
          "110181037": {
            "id": "110181037",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "那你怎么判断自己得出的「最优解」是真是假呢？",
            "nextDialogs": [
              "110181038"
            ]
          },
          "110181038": {
            "id": "110181038",
            "speakerId": 12498,
            "speakerName": "知易",
            "text": "规划施行前，有我的同僚以及月海亭的秘书们进行评估；规划施行后，一切以最终效果为主。",
            "nextDialogs": [
              "110181039"
            ]
          },
          "110181039": {
            "id": "110181039",
            "speakerId": 12498,
            "speakerName": "知易",
            "text": "如果真的是我判断失误，我会为此承担相应责任。",
            "nextDialogs": [
              "110181040"
            ]
          },
          "110181040": {
            "id": "110181040",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "回答得不错。那我们换下一个问题…",
            "nextDialogs": [
              "110181041"
            ]
          },
          "110181041": {
            "id": "110181041",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "夜兰对知易进行一番询问后，让他离开了。",
            "nextDialogs": [
              "110181042"
            ]
          },
          "110181042": {
            "id": "110181042",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉是一个很好相处的人呢！说话也很有条理，让人听着很舒服！"
          }
        }
      }
    },
    {
      "subId": "1101806",
      "subQuestName": "向天叔汇报考察结果",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110180601"
        ],
        "dialogs": {
          "110180601": {
            "id": "110180601",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "跟天叔讲述了整个考核流程…",
            "nextDialogs": [
              "110180602"
            ]
          },
          "110180602": {
            "id": "110180602",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "咳咳…嗯，和我预想中的差不多。",
            "nextDialogs": [
              "110180603"
            ]
          },
          "110180603": {
            "id": "110180603",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "那我就直接问了，天叔。知易的规划思路跟你很像，这里面有什么理由吗？",
            "nextDialogs": [
              "110180604"
            ]
          },
          "110180604": {
            "id": "110180604",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "给你们候选人名单的时候不方便说，担心干扰你们的判断，不过现在可以聊聊了。",
            "nextDialogs": [
              "110180605"
            ]
          },
          "110180605": {
            "id": "110180605",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "那三位候选人，都曾跟我学习过一段时间，难免与我有些相似。",
            "nextDialogs": [
              "110180606"
            ]
          },
          "110180606": {
            "id": "110180606",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "不过乾玮忙于经商，明博有总务司的工作要做。相比之下，知易待在我身边的时间更久。",
            "nextDialogs": [
              "110180607"
            ]
          },
          "110180607": {
            "id": "110180607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！天叔是怎么和他们认识的呢？",
            "nextDialogs": [
              "110180608"
            ]
          },
          "110180608": {
            "id": "110180608",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "乾玮是一位老友推荐给我的，明博则是我在工作中注意到的。至于知易…哈哈，倒像是一个意外。",
            "nextDialogs": [
              "110180609"
            ]
          },
          "110180609": {
            "id": "110180609",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "刚开始我们只是偶然认识的钓友，后来慢慢熟络，才开始聊各种话题。",
            "nextDialogs": [
              "110180610"
            ]
          },
          "110180610": {
            "id": "110180610",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "知易出身寒门，父母过世很早。但他天赋出众，学什么都很快。",
            "nextDialogs": [
              "110180611"
            ]
          },
          "110180611": {
            "id": "110180611",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "看到他，我就想到年轻时的自己。于是经常在钓鱼的时候指点他几句，他也会很快领悟。",
            "nextDialogs": [
              "110180614"
            ]
          },
          "110180614": {
            "id": "110180614",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "没错。不知不觉，他就成长到了这样的高度。现在想想，真是令人既欣慰又感慨。",
            "nextDialogs": [
              "110180615"
            ]
          },
          "110180615": {
            "id": "110180615",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "年轻人一个个成长起来，我也老了。时间过得可真快，生老病死果然是人人都绕不开的坎。",
            "nextDialogs": [
              "110180616"
            ]
          },
          "110180616": {
            "id": "110180616",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "我怎么觉得天叔的身体还很硬朗，能再为工作辛劳几年？",
            "nextDialogs": [
              "110180617"
            ]
          },
          "110180617": {
            "id": "110180617",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "你啊你，用不着安慰我。精力不够用也挺好的，卸下了担子，我终于能像个普通老头一样，自由自在地去钓鱼了。",
            "nextDialogs": [
              "110180618"
            ]
          },
          "110180618": {
            "id": "110180618",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "天叔很喜欢钓鱼呢！",
            "nextDialogs": [
              "110180619"
            ]
          },
          "110180619": {
            "id": "110180619",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "想要消磨时光，钓鱼绝对是不二之选。而且刚钓上的鱼非常新鲜，在水边处理一下，就能煮出一锅鲜美的鱼汤。",
            "nextDialogs": [
              "110180620"
            ]
          },
          "110180620": {
            "id": "110180620",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "新鲜的鱼汤！唔，听上去就非常好喝！",
            "nextDialogs": [
              "110180621"
            ]
          },
          "110180621": {
            "id": "110180621",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "是吧？而且前段时间，知易还从一位老渔夫手上买到了特别的食谱。",
            "nextDialogs": [
              "110180622"
            ]
          },
          "110180622": {
            "id": "110180622",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "最近每次钓鱼，知易都会带一些处理好的辅料。加了辅料之后，味道比以前还要鲜美。",
            "nextDialogs": [
              "110180623"
            ]
          },
          "110180623": {
            "id": "110180623",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "真令人回味无穷…可惜我这把老骨头，恐怕喝不了几次啦。",
            "nextDialogs": [
              "110180624"
            ]
          },
          "110180624": {
            "id": "110180624",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还能喝很多很多次的。",
            "nextDialogs": [
              "110180625"
            ]
          },
          "110180625": {
            "id": "110180625",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "下次能带上我吗？我也想尝尝看！",
            "nextDialogs": [
              "110180626"
            ]
          },
          "110180626": {
            "id": "110180626",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "言归正传，天叔。听完汇报之后，你有结论了吗？",
            "nextDialogs": [
              "110180627"
            ]
          },
          "110180627": {
            "id": "110180627",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "既然委托你来考察，那我相信你的判断。",
            "nextDialogs": [
              "110180628"
            ]
          },
          "110180628": {
            "id": "110180628",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "若非你们问我，知易为何许多思路与我相似，我本不打算提起我与他们三位的私交。",
            "nextDialogs": [
              "110180629"
            ]
          },
          "110180629": {
            "id": "110180629",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "举贤讲求公正，请你们务必刨除这些外因，将候选人的才华与能力调查清楚再下结论。",
            "nextDialogs": [
              "110180630"
            ]
          },
          "110180630": {
            "id": "110180630",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "记住…一定要「调查清楚」。",
            "nextDialogs": [
              "110180631"
            ]
          },
          "110180631": {
            "id": "110180631",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "我明白了。",
            "nextDialogs": [
              "110180632"
            ]
          },
          "110180632": {
            "id": "110180632",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "#走吧，{NICKNAME}，我们换个地方说话。",
            "nextDialogs": [
              "110180633"
            ]
          },
          "110180633": {
            "id": "110180633",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那天叔，我们先告辞啦，一定要注意身体呀！",
            "nextDialogs": [
              "110180634"
            ]
          },
          "110180634": {
            "id": "110180634",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "跟夜兰来到了茶室外…",
            "nextDialogs": [
              "110180635"
            ]
          },
          "110180635": {
            "id": "110180635",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…果然就决定是知易了吧？",
            "nextDialogs": [
              "110180636"
            ]
          },
          "110180636": {
            "id": "110180636",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你看，他规划写得好，说话又好听…",
            "nextDialogs": [
              "110180637"
            ]
          },
          "110180637": {
            "id": "110180637",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "不急，考察又没有时间限制。",
            "nextDialogs": [
              "110180638"
            ]
          },
          "110180638": {
            "id": "110180638",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，难道夜兰还准备了什么测试吗？",
            "nextDialogs": [
              "110180639"
            ]
          },
          "110180639": {
            "id": "110180639",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "那倒没有，对他们本人的考察已经结束了。不过给你们一个忠告：眼见未必为实。",
            "nextDialogs": [
              "110180640"
            ]
          },
          "110180640": {
            "id": "110180640",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "情报工作最忌讳的，就是只从当事人身上了解信息。真相外面总是蒙着层层迷雾，所以需要通过各种渠道去收集情报。",
            "nextDialogs": [
              "110180641"
            ]
          },
          "110180641": {
            "id": "110180641",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "文渊、商华。",
            "nextDialogs": [
              "110180642"
            ]
          },
          "110180642": {
            "id": "110180642",
            "speakerId": 12502,
            "speakerName": "文渊",
            "text": "在。",
            "nextDialogs": [
              "110180643"
            ]
          },
          "110180643": {
            "id": "110180643",
            "speakerId": 12501,
            "speakerName": "商华",
            "text": "夜兰大人有何吩咐？",
            "nextDialogs": [
              "110180644"
            ]
          },
          "110180644": {
            "id": "110180644",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "突然就出现了不认识的人！",
            "nextDialogs": [
              "110180645"
            ]
          },
          "110180645": {
            "id": "110180645",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "吓到你了吗？这两位是我的手下，文渊和商华。",
            "nextDialogs": [
              "110180646"
            ]
          },
          "110180646": {
            "id": "110180646",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "作为我的得力助手，他们平时在附近警戒，必要时也会去执行各种任务。",
            "nextDialogs": [
              "110180647"
            ]
          },
          "110180647": {
            "id": "110180647",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "商华精通商务，喜欢以交易换取情报；文渊则多靠游说来获知消息。除了他们之外，还有目前不在场的武沛…",
            "nextDialogs": [
              "110180648"
            ]
          },
          "110180648": {
            "id": "110180648",
            "speakerId": 12502,
            "speakerName": "文渊",
            "text": "那大块头在海上盯梢有一段时间了吧，没问题吗？印象里他可不会游泳。",
            "nextDialogs": [
              "110180649"
            ]
          },
          "110180649": {
            "id": "110180649",
            "speakerId": 12501,
            "speakerName": "商华",
            "text": "嘿，那家伙命大着呢，这点小风小浪还不算什么。",
            "nextDialogs": [
              "110180650"
            ]
          },
          "110180650": {
            "id": "110180650",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "商华，你去各个商会，调查乾玮的背景；文渊，你去璃月总务司，查一下明博的工作档案。",
            "nextDialogs": [
              "110180651"
            ]
          },
          "110180651": {
            "id": "110180651",
            "speakerId": 1015,
            "speakerName": "文渊&商华",
            "text": "是！",
            "nextDialogs": [
              "110180652"
            ]
          },
          "110180652": {
            "id": "110180652",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？那知易呢？",
            "nextDialogs": [
              "110180653"
            ]
          },
          "110180653": {
            "id": "110180653",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "知易？作为最有希望的候选人，知易当然是由我们亲自调查了。",
            "nextDialogs": [
              "110180654"
            ]
          },
          "110180654": {
            "id": "110180654",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "先去港口看看吧，那里人多嘴杂，是各种消息传播的地方。",
            "nextDialogs": [
              "110180655"
            ]
          },
          "110180655": {
            "id": "110180655",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说到打听消息，不如我们去问问「万有铺子」的老板博来？",
            "nextDialogs": [
              "110180656"
            ]
          },
          "110180656": {
            "id": "110180656",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他一直在北码头做生意，说不定听说过什么消息…",
            "nextDialogs": [
              "110180657"
            ]
          },
          "110180657": {
            "id": "110180657",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "嗯，这倒是个不错的选择。去问问看吧。"
          }
        }
      }
    },
    {
      "subId": "1101816",

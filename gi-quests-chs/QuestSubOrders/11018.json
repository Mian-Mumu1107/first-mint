            "id": "110181601",
            "speakerId": 1048,
            "speakerName": "夜兰",
            "text": "看完了吗？",
            "nextDialogs": [
              "110181602"
            ]
          },
          "110181602": {
            "id": "110181602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还差一点…"
          }
        }
      }
    },
    {
      "subId": "1101817",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110181701"
        ],
        "dialogs": {
          "110181701": {
            "id": "110181701",
            "speakerId": 12498,
            "speakerName": "知易",
            "text": "说起来，你们知道这次的考察官是谁吗？",
            "nextDialogs": [
              "110181702"
            ]
          },
          "110181702": {
            "id": "110181702",
            "speakerId": 12499,
            "speakerName": "明博",
            "text": "不太清楚…",
            "nextDialogs": [
              "110181703"
            ]
          },
          "110181703": {
            "id": "110181703",
            "speakerId": 12500,
            "speakerName": "乾玮",
            "text": "我也不知道。不过最好是来个懂行的人，我可不太想被外行考校。"
          }
        }
      }
    },
    {
      "subId": "1101818",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110181801"
        ],
        "dialogs": {
          "110181801": {
            "id": "110181801",
            "speakerId": 12534,
            "speakerName": "礼安",
            "text": "有什么需要帮忙的吗？",
            "nextDialogs": [
              "110181802"
            ]
          },
          "110181802": {
            "id": "110181802",
            "speakerId": 12534,
            "speakerName": "礼安",
            "text": "慧心前辈这段时间请假，由我在这里代班。有什么事，随时找我就好。"
          }
        }
      }
    },
    {
      "subId": "1101850",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110185001"
        ],
        "dialogs": {
          "110185001": {
            "id": "110185001",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "考察有什么结果了吗？",
            "nextDialogs": [
              "110185002"
            ]
          },
          "110185002": {
            "id": "110185002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "额…还没有…"
          }
        }
      }

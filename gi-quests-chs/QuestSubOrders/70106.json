    {
      "subId": "7010610",
      "subQuestName": "制作「稠汁蔬菜炖肉」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701061001"
        ],
        "dialogs": {
          "701061001": {
            "id": "701061001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「稠汁蔬菜炖肉」…",
            "nextDialogs": [
              "701061002"
            ]
          },
          "701061002": {
            "id": "701061002",
            "speakerId": 1664,
            "speakerName": "哈里斯",
            "text": "哦！你来了啊，菜都准备好了。给你，说好的「稠汁蔬菜炖肉」。",
            "nextDialogs": [
              "701061003"
            ]
          },
          "701061003": {
            "id": "701061003",
            "speakerId": 1664,
            "speakerName": "哈里斯",
            "text": "你就趁热吃了吧，先吃饱肚子，才有力气继续冒险嘛。"
          }
        }
      }
    },
    {
      "subId": "7010611",
      "subQuestName": "与哈里斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701060501"
        ],
        "dialogs": {
          "701060501": {
            "id": "701060501",
            "speakerId": 1664,
            "speakerName": "哈里斯",
            "text": "嗯，就是这种味道，你还挺有做菜天赋的嘛。",
            "nextDialogs": [
              "701060502"
            ]
          },
          "701060502": {
            "id": "701060502",
            "speakerId": 1664,
            "speakerName": "哈里斯",
            "text": "好了，这些东西请你收下，就当做是谢礼了。我得再去炖点菜给其他人吃了。",
            "nextDialogs": [
              "701060503"
            ]
          },
          "701060503": {
            "id": "701060503",
            "speakerId": 1664,
            "speakerName": "哈里斯",
            "text": "哦对了，你晚上再来找我吧，我再做几份这种菜给你。",
            "nextDialogs": [
              "701060504"
            ]
          },
          "701060504": {
            "id": "701060504",
            "speakerId": 1664,
            "speakerName": "哈里斯",
            "text": "多吃点好吃的，对你在雪山里的冒险也有帮助，对吧？"
          }
        }
      }
    },

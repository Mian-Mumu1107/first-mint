  "subQuests": [
    {
      "subId": "800901",
      "subQuestName": "与马斯鲁尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090101"
        ],
        "dialogs": {
          "80090101": {
            "id": "80090101",
            "speakerId": 1000,
            "speakerName": "马斯鲁尔",
            "text": "哦？你就是那位正在各个国家旅行的金发旅者吧？",
            "nextDialogs": [
              "80090102"
            ]
          },
          "80090102": {
            "id": "80090102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么啦？找我们有什么事？",
            "nextDialogs": [
              "80090103"
            ]
          },
          "80090103": {
            "id": "80090103",
            "speakerId": 1000,
            "speakerName": "马斯鲁尔",
            "text": "太好了，我正愁去哪里找你。正巧我手上有封你的信，是个外国人邮寄的…",
            "nextDialogs": [
              "80090104"
            ]
          },
          "80090104": {
            "id": "80090104",
            "speakerId": 1000,
            "speakerName": "马斯鲁尔",
            "text": "那家伙钻了我们邮寄系统的空子，拿到了「信必送达」的承诺后，填了个极度模糊的地址。",
            "nextDialogs": [
              "80090105"
            ]
          },
          "80090105": {
            "id": "80090105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "想给我们寄信还的确挺难的，毕竟我们一直四处晃荡，除非是我们自己去信箱里翻…",
            "nextDialogs": [
              "80090106"
            ]
          },
          "80090106": {
            "id": "80090106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以那个人填的地址究竟是哪里？",
            "nextDialogs": [
              "80090107"
            ]
          },
          "80090107": {
            "id": "80090107",
            "speakerId": 1000,
            "speakerName": "马斯鲁尔",
            "text": "呃…他写的是「一只白发会说话的小精灵旁边」。",
            "nextDialogs": [
              "80090108"
            ]
          },
          "80090108": {
            "id": "80090108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么！是我吗！？",
            "nextDialogs": [
              "80090109"
            ]
          },
          "80090109": {
            "id": "80090109",
            "speakerId": 1000,
            "speakerName": "马斯鲁尔",
            "text": "唉，就是说啊，而且我们如果送不到信的话，按照条例还要赔给他钱…",
            "nextDialogs": [
              "80090110"
            ]
          },
          "80090110": {
            "id": "80090110",
            "speakerId": 1000,
            "speakerName": "马斯鲁尔",
            "text": "可真是被那位先生给算计了，不过好在运气站在我这边，能跟你们这样偶遇。",
            "nextDialogs": [
              "80090113"
            ]
          },
          "80090113": {
            "id": "80090113",
            "speakerId": 1000,
            "speakerName": "马斯鲁尔",
            "text": "好好好，快请拿去吧。",
            "nextDialogs": [
              "80090114"
            ]
          },
          "80090114": {
            "id": "80090114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "让我也看看，到底是谁的来信呀？",
            "nextDialogs": [
              "80090115"
            ]
          },
          "80090115": {
            "id": "80090115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "凯亚！原来是他到须弥来了呀…唔，我就觉得「诡计多端的外国先生」很有可能是他呢。"
          }
        }
      }
    },
    {
      "subId": "800902",
      "subQuestName": "等到次日下午（16点~18点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090201"
        ],
        "dialogs": {
          "80090201": {
            "id": "80090201",
            "speakerId": 1000,
            "speakerName": "马斯鲁尔",
            "text": "碰上这种事我也是头一次，好在这回运气好…"
          }
        }
      }
    },
    {
      "subId": "800903",
      "subQuestName": "前往迪亚法饭店寻找凯亚",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090301"
        ],
        "dialogs": {
          "80090301": {
            "id": "80090301",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "…老板，再来杯我没喝过的。",
            "nextDialogs": [
              "80090302"
            ]
          },
          "80090302": {
            "id": "80090302",
            "speakerId": 1003,
            "speakerName": "艾依曼",
            "text": "呃…先生，我这店里的酒，您早就喝遍了…",
            "nextDialogs": [
              "80090303"
            ]
          },
          "80090303": {
            "id": "80090303",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "是么，好吧好吧，今天就先这样吧，正好我一会儿还有事…",
            "nextDialogs": [
              "80090304"
            ]
          },
          "80090304": {
            "id": "80090304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "凯亚！你果然在这儿，我还担心你会不会耍我们呢！",
            "nextDialogs": [
              "80090305"
            ]
          },
          "80090305": {
            "id": "80090305",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "#哟，派蒙，{NICKNAME}，看来神明还是眷顾我的嘛。我这么想见你们，怎么可能耍你们呢，哈哈哈…",
            "nextDialogs": [
              "80090308"
            ]
          },
          "80090308": {
            "id": "80090308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话说你不是出差吗，天天下午泡在酒馆里，不怕回去被琴团长教训吗？",
            "nextDialogs": [
              "80090309"
            ]
          },
          "80090309": {
            "id": "80090309",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "呵呵呵…我那么害怕琴团长，怎么敢做出令她不开心的事呢？"
          }
        }
      }
    },
    {
      "subId": "800904",
      "subQuestName": "前往戴因所说的地方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090501"
        ],
        "dialogs": {
          "80090501": {
            "id": "80090501",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "等等，这里…有些熟悉。",
            "nextDialogs": [
              "80090502"
            ]
          },
          "80090502": {
            "id": "80090502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里？看起来有些平平无奇，这里几百年前也是这样么？",
            "nextDialogs": [
              "80090503"
            ]
          },
          "80090503": {
            "id": "80090503",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "没错，这片森林里的一切与我印象里变化不大，毕竟这里的环境很少受到人类的染指。",
            "nextDialogs": [
              "80090504"
            ]
          },
          "80090504": {
            "id": "80090504",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "调查一下这附近吧，或许会有什么线索。",
            "nextDialogs": [
              "80090505"
            ]
          },
          "80090505": {
            "id": "80090505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里是一处田地吗？应该是那边房子里的住户开垦的吧？",
            "nextDialogs": [
              "80090506"
            ]
          },
          "80090506": {
            "id": "80090506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过好像也已经荒废很久了，完全看不出来在这里种过什么东西…或者说真的有种过东西吗？",
            "nextDialogs": [
              "80090507"
            ]
          },
          "80090507": {
            "id": "80090507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "熄灭的篝火，是巡林员留下的吗？",
            "nextDialogs": [
              "80090508"
            ]
          },
          "80090508": {
            "id": "80090508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "从痕迹上看，上次在这里点燃篝火已经是很久很久之前的事了，而且有注意好好把火熄灭预防森林火灾呢。",
            "nextDialogs": [
              "80090509"
            ]
          },
          "80090509": {
            "id": "80090509",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "这周围好像的确没什么值得注意的，剩下的就是那间屋子了。",
            "nextDialogs": [
              "80090510"
            ]
          },
          "80090510": {
            "id": "80090510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，会不会还住着人呀，我们要去打扰吗？",
            "nextDialogs": [
              "80090511"
            ]
          },
          "80090511": {
            "id": "80090511",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "不像，这周围完全没有生活的气息，应该可以放心进去调查。",
            "nextDialogs": [
              "80090512"
            ]
          },
          "80090512": {
            "id": "80090512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是吗…那、那你走前面，戴因。"
          }
        }
      }
    },
    {
      "subId": "800907",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090701"
        ],
        "dialogs": {
          "80090701": {
            "id": "80090701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一张普普通通的床，床下面好像也没什么东西。",
            "nextDialogs": [
              "80090702"
            ]
          },
          "80090702": {
            "id": "80090702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里阴暗潮湿，住得一定很不舒服吧？究竟住过什么样的人呢…"
          }
        }
      }
    },
    {
      "subId": "800910",
      "subQuestName": "进入屋内调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80091001"
        ],
        "dialogs": {
          "80091001": {
            "id": "80091001",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "刚才那些魔物的出现，应该也不是偶然。这附近的确有什么在吸引它们。",
            "nextDialogs": [
              "80091002"
            ]
          },
          "80091002": {
            "id": "80091002",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "是地脉的异常么…好像也不仅仅是如此。",
            "nextDialogs": [
              "80091003"
            ]
          },
          "80091003": {
            "id": "80091003",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "这样吧，我到稍远的地方去调查一下附近地脉的问题，可能需要很长时间，你们就在这里等我。",
            "nextDialogs": [
              "80091004"
            ]
          },
          "80091004": {
            "id": "80091004",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，你要自己去吗？难道有什么要瞒着我们的秘密！",
            "nextDialogs": [
              "80091005"
            ]
          },
          "80091005": {
            "id": "80091005",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "…无聊的猜忌，我只是觉得调查的重点毕竟还是这间屋子附近，最好有人留下观察。",
            "nextDialogs": [
              "80091006"
            ]
          },
          "80091006": {
            "id": "80091006",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "何况调查地脉这种巡林员都能完成的事情，我一个人绰绰有余。",
            "nextDialogs": [
              "80091007"
            ]
          },
          "80091007": {
            "id": "80091007",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#唔，好吧，说得也是，那{NICKNAME}我们两个就在这里野营吧？",
            "nextDialogs": [
              "80091008"
            ]
          },
          "80091008": {
            "id": "80091008",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "正好那边还有篝火，我们点起来做点吃的好了！今天跑来跑去，我早就饿啦。"
          }
        }
      }
    },
    {
      "subId": "800911",
      "subQuestName": "调查屋内",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090601"
        ],
        "dialogs": {
          "80090601": {
            "id": "80090601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是吃饭用的碗欸，在这里住的人是自己在家里烧饭吃的吗？",
            "nextDialogs": [
              "80090602"
            ]
          },
          "80090602": {
            "id": "80090602",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "你闻不到么，那么浓重的药味。",
            "nextDialogs": [
              "80090603"
            ]
          },
          "80090603": {
            "id": "80090603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，是吃药用的碗吗，味道…好像还真是，戴因你鼻子真灵。"
          }
        }
      }
    },
    {
      "subId": "800912",
      "subQuestName": "调查屋内",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "800913",
      "subQuestName": "调查屋内",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090801"
        ],
        "dialogs": {
          "80090801": {
            "id": "80090801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#这边有个盒子，打开看看吧？{NICKNAME}你来动手…我、我怕里面的东西会咬我的手指头…",
            "nextDialogs": [
              "80090804"
            ]
          },
          "80090804": {
            "id": "80090804",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，这是…一面镜子？",
            "nextDialogs": [
              "80090805"
            ]
          },
          "80090805": {
            "id": "80090805",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且还是碎掉的，这个盒子难道是个化妆盒吗？"
          }
        }
      }
    },
    {
      "subId": "800916",
      "subQuestName": "与戴因对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090901"
        ],
        "dialogs": {
          "80090901": {
            "id": "80090901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里感觉也没什么特别需要注意的地方呀，戴因你确定没记错？真的是这一带吗？",
            "nextDialogs": [
              "80090902"
            ]
          },
          "80090902": {
            "id": "80090902",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "尽管我的记忆的确有些模糊不清，但潜意识与本能一直在告诉我这里的确发生过什么。",
            "nextDialogs": [
              "80090903"
            ]
          },
          "80090903": {
            "id": "80090903",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "好吧，毫无目标的调查只会消磨心智。正巧我听到外面有些动静，还是先出去吧。",
            "nextDialogs": [
              "80090904"
            ]
          },
          "80090904": {
            "id": "80090904",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有些动静？难道是…",
            "nextDialogs": [
              "80090905"
            ]
          },
          "80090905": {
            "id": "80090905",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "没什么，应该是些杂鱼。"
          }
        }
      }
    },

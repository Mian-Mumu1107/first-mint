    {
      "subId": "800905",
      "subQuestName": "点燃篝火",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "800919",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80091101"
        ],
        "dialogs": {
          "80091101": {
            "id": "80091101",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "你与派蒙生起篝火，不知不觉已是晚上…",
            "nextDialogs": [
              "80091102"
            ]
          },
          "80091102": {
            "id": "80091102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}做的菜还是那么好吃，光凭厨艺这一点，就足够我跟定你啦！",
            "nextDialogs": [
              "80091105"
            ]
          },
          "80091105": {
            "id": "80091105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起来戴因也太慢了，天都黑了还没回来。他说附近的地脉出了问题，不会真出什么大事了吧？",
            "nextDialogs": [
              "80091106"
            ]
          },
          "80091106": {
            "id": "80091106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唉，明明都一起来的，现在又只剩下我们两个…不过这么一想，我们两个单独相处的时间也已经有好多好多了呢。",
            "nextDialogs": [
              "80091107"
            ]
          },
          "80091107": {
            "id": "80091107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔、那个…没有别的意思，就是、就是想稍微问一下…和我在一起不会很无聊吧？"
          }
        }
      }
    },
    {
      "subId": "800908",
      "subQuestName": "与戴因对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80091201"
        ],
        "dialogs": {
          "80091201": {
            "id": "80091201",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "喂，醒醒，天已经亮了，别睡了。",
            "nextDialogs": [
              "80091202"
            ]
          },
          "80091202": {
            "id": "80091202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（……）",
            "nextDialogs": [
              "80091203"
            ]
          },
          "80091203": {
            "id": "80091203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（…戴因？）",
            "nextDialogs": [
              "80091204"
            ]
          },
          "80091204": {
            "id": "80091204",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "怎么昏沉成这样，今天还要…",
            "nextDialogs": [
              "80091205"
            ]
          },
          "80091205": {
            "id": "80091205",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "嗯…？你眼角的泪痕…昨晚梦到你的血亲了么？",
            "nextDialogs": [
              "80091206"
            ]
          },
          "80091206": {
            "id": "80091206",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "…好吧，你就先在这里休息，我去森林深处看看。",
            "nextDialogs": [
              "80091207"
            ]
          },
          "80091207": {
            "id": "80091207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（嗯？怎么又去森林深处…）",
            "nextDialogs": [
              "80091208"
            ]
          },
          "80091208": {
            "id": "80091208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哈欠——",
            "nextDialogs": [
              "80091209"
            ]
          },
          "80091209": {
            "id": "80091209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（我怎么直接睡到了早上，派蒙没有叫醒我来换班么…等等，派蒙去哪儿了？）",
            "nextDialogs": [
              "80091210"
            ]
          },
          "80091210": {
            "id": "80091210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（啊，我好像隐隐约约记得戴因来过，派蒙难道是看我没醒，跟着戴因一起去森林那边了？）",
            "nextDialogs": [
              "80091211"
            ]
          },
          "80091211": {
            "id": "80091211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（总之好像只剩下我一个人了，先起来活动活动筋骨，调查下附近吧。）",
            "nextDialogs": [
              "80091212"
            ]
          },
          "80091212": {
            "id": "80091212",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "（咔嚓——咯噔——）",
            "nextDialogs": [
              "80091213"
            ]
          },
          "80091213": {
            "id": "80091213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（等等，刚才是不是…从屋里发出了什么响动？）",
            "nextDialogs": [
              "80091216"
            ]
          },
          "80091216": {
            "id": "80091216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（没有回话…还是进屋确认一下吧。）"
          }
        }
      }
    },
    {
      "subId": "800904",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80090401"
        ],
        "dialogs": {
          "80090401": {
            "id": "80090401",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "哦？这么巧，我刚刚跟那位须弥的老板谈完合作，没想到在这里又碰面了。",
            "nextDialogs": [
              "80090402"
            ]
          },
          "80090402": {
            "id": "80090402",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "要不再回去喝两杯？我还想跟你聊聊去年风花节时候的那件事，那可真是…",
            "nextDialogs": [
              "80090403"
            ]
          },
          "80090403": {
            "id": "80090403",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "…欸，你还有事啊，一如既往是个大忙人啊。好吧，回头记得去「天使的馈赠」找我，一路顺风。"
          }
        }
      }
    },
    {
      "subId": "800999",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80099901"
        ],
        "dialogs": {
          "80099901": {
            "id": "80099901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个时间凯亚应该在迪亚法饭店了，我们去找他吧！",
            "nextDialogs": [
              "80099902"
            ]
          },
          "80099902": {
            "id": "80099902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呀，果然没有人…咳咳，灰尘稍微有些重，的确很久没有住人了吧？",
            "nextDialogs": [
              "80099903"
            ]
          },
          "80099903": {
            "id": "80099903",
            "speakerId": 1004,
            "speakerName": "戴因斯雷布",
            "text": "认真调查看看，别漏掉什么细节。",
            "nextDialogs": [
              "80099904"
            ]
          },
          "80099904": {
            "id": "80099904",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "果然有魔物出现了，戴因不仅鼻子灵，耳朵也好灵啊，根本不像几百岁的人嘛。",
            "nextDialogs": [
              "80099905"
            ]
          },
          "80099905": {
            "id": "80099905",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃，不过戴因超出常识的地方也早就不止这点了…先把这些魔物收拾了吧！",
            "nextDialogs": [
              "80099906"
            ]
          },
          "80099906": {
            "id": "80099906",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "……"
          }
        }

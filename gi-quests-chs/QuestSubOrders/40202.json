    {
      "subId": "4020220",
      "subQuestName": "与夜兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4020207",
      "subQuestName": "与夜兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402020701"
        ],
        "dialogs": {
          "402020701": {
            "id": "402020701",
            "speakerId": 1003,
            "speakerName": "罗韦雷·佩里恰",
            "text": "不可思议的身手…我败得，不冤。",
            "nextDialogs": [
              "402020702"
            ]
          },
          "402020702": {
            "id": "402020702",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "「有什么遗言吗？」",
            "nextDialogs": [
              "402020703"
            ]
          },
          "402020703": {
            "id": "402020703",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "啊呀，这样问，似乎有些太戏剧化，反而会让你这样的罪犯认为，得到了一个颇具分量的收场吧。",
            "nextDialogs": [
              "402020704"
            ]
          },
          "402020704": {
            "id": "402020704",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "我应该说…",
            "nextDialogs": [
              "402020705"
            ]
          },
          "402020705": {
            "id": "402020705",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "忏悔也没用了，你会在牢狱里痛苦地度过余生，日复一日为你的贪婪买账。",
            "nextDialogs": [
              "402020706"
            ]
          },
          "402020706": {
            "id": "402020706",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "过去的荣华富贵，每一枚肮脏的钱币，都将在你的刑具上不断加码。",
            "nextDialogs": [
              "402020707"
            ]
          },
          "402020707": {
            "id": "402020707",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "像条濒死的野狗，在阴暗的角落里，日复一日地腐烂吧。",
            "nextDialogs": [
              "402020708"
            ]
          },
          "402020708": {
            "id": "402020708",
            "speakerId": 1003,
            "speakerName": "罗韦雷·佩里恰",
            "text": "你不像探员…你像个索命的幽魂！",
            "nextDialogs": [
              "402020709"
            ]
          },
          "402020709": {
            "id": "402020709",
            "speakerId": 1009,
            "speakerName": "埃德勒",
            "text": "现在知道逃了？不好意思，已经结束了！",
            "nextDialogs": [
              "402020710"
            ]
          },
          "402020710": {
            "id": "402020710",
            "speakerId": 1009,
            "speakerName": "埃德勒",
            "text": "呼…辛辛苦苦大半年的追缉行动，总算能在表格最后打上「大功告成」的钩了。",
            "nextDialogs": [
              "402020711"
            ]
          },
          "402020711": {
            "id": "402020711",
            "speakerId": 1009,
            "speakerName": "埃德勒",
            "text": "保持最高戒备，将这家伙直接运回枫丹廷，立刻押送到审判席上去。",
            "nextDialogs": [
              "402020712"
            ]
          },
          "402020712": {
            "id": "402020712",
            "speakerId": 1009,
            "speakerName": "埃德勒",
            "text": "我一刻都等不了了，我今晚就要看他坐牢！",
            "nextDialogs": [
              "402020713"
            ]
          },
          "402020713": {
            "id": "402020713",
            "speakerId": 1009,
            "speakerName": "埃德勒",
            "text": "#呃咳咳，夜兰小姐，还有{NICKNAME}和派蒙向导。",
            "nextDialogs": [
              "402020714"
            ]
          },
          "402020714": {
            "id": "402020714",
            "speakerId": 1009,
            "speakerName": "埃德勒",
            "text": "…出于个人的感谢，我的奖金必须分你们一半！还要申请，以整个执律庭的名义，向璃月合作方致以最高的感谢！",
            "nextDialogs": [
              "402020715"
            ]
          },
          "402020715": {
            "id": "402020715",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "多谢好意，客气得让我都有点意外了。",
            "nextDialogs": [
              "402020716"
            ]
          },
          "402020716": {
            "id": "402020716",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "一切都是公务，我可不能收你的钱，一摩拉都免谈，也容我谢绝晚宴、聚会、品茶之类的邀请。",
            "nextDialogs": [
              "402020717"
            ]
          },
          "402020717": {
            "id": "402020717",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "#要论苦劳，就由{NICKNAME}和派蒙来承接你个人的馈赠吧。",
            "nextDialogs": [
              "402020720"
            ]
          },
          "402020720": {
            "id": "402020720",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不可思议…",
            "nextDialogs": [
              "402020721"
            ]
          },
          "402020721": {
            "id": "402020721",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "忙活了好一阵子，感觉一直在分析各种线索，看破对方的阴谋…脑袋晕晕的，但好像，变得比以前聪明了！",
            "nextDialogs": [
              "402020722"
            ]
          },
          "402020722": {
            "id": "402020722",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我是不是真的有当职业侦探的潜力！",
            "nextDialogs": [
              "402020723"
            ]
          },
          "402020723": {
            "id": "402020723",
            "speakerId": 1009,
            "speakerName": "埃德勒",
            "text": "好呀，如果你对探案有兴趣，欢迎跟着我们回执律庭，审讯这些家伙，给他们录口供！",
            "nextDialogs": [
              "402020724"
            ]
          },
          "402020724": {
            "id": "402020724",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真，真的吗？我要参加！",
            "nextDialogs": [
              "402020725"
            ]
          },
          "402020725": {
            "id": "402020725",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#可以嘛，{NICKNAME}？我跟这位警官去审讯犯人，学学新本领了哦？以后说不定能派上用场！"
          }
        }
      }
    },
    {
      "subId": "4020211",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402021101"
        ],
        "dialogs": {
          "402021101": {
            "id": "402021101",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "准备好<color=#00E1FFFF>「综像勘录仪」</color>，记录下这桩案件的最后一环吧。"
          }
        }
      }
    },
    {
      "subId": "4020212",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402021201"
        ],
        "dialogs": {
          "402021201": {
            "id": "402021201",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "不出意外的话，这就是这起案件的最后一次调查了，说不定…你还会觉得有点不尽兴？"
          }
        }
      }
    },
    {
      "subId": "4020213",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402021301"
        ],
        "dialogs": {
          "402021301": {
            "id": "402021301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我再好好准备一下。"
          }
        }
      }
    },
    {
      "subId": "4020215",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402021501"
        ],
        "dialogs": {
          "402021501": {
            "id": "402021501",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "（还需准备好<color=#00E1FFFF>「综像勘录仪」</color>，记录所有关键证据…）"
          }
        }
      }
    },
    {
      "subId": "4020221",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402022101"
        ],
        "dialogs": {
          "402022101": {
            "id": "402022101",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "探员，您说…我这么配合探案了，能给我…减刑吗？",
            "nextDialogs": [
              "402022102"
            ]
          },
          "402022102": {
            "id": "402022102",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "这要看执律庭和审判官们的想法了…不过，你态度端正，应该不会被重罚。",
            "nextDialogs": [
              "402022103"
            ]
          },
          "402022103": {
            "id": "402022103",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "呼…还好我及时想通了，不然，一切都完了…"
          }
        }
      }
    },
    {
      "subId": "4020298",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402029801"
        ],
        "dialogs": {
          "402029801": {
            "id": "402029801",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "在侍者的引导下进入了拍卖会的现场…",
            "nextDialogs": [
              "402029802"
            ]
          },
          "402029802": {
            "id": "402029802",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "在替罪羊标明的碰面区域开始了调查…"
          }
        }
      }
    },
    {
      "subId": "4020299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402029901"
        ],
        "dialogs": {
          "402029901": {
            "id": "402029901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！约定的时间到了。目标——德波大饭店，最最重要的拍卖会！",

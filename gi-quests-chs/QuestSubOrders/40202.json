    {
      "subId": "4020211",
      "subQuestName": "返回拍卖会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402020801"
        ],
        "dialogs": {
          "402020801": {
            "id": "402020801",
            "speakerId": 1004,
            "speakerName": "侍者",
            "text": "两位客人晚上好，请随我去往拍卖会场。"
          }
        }
      }
    },
    {
      "subId": "4020215",
      "subQuestName": "总结情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402020601"
        ],
        "dialogs": {
          "402020601": {
            "id": "402020601",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "（嗯，行为举止和着装细节都有问题，不会错，就是他了。）",
            "nextDialogs": [
              "402020602"
            ]
          },
          "402020602": {
            "id": "402020602",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "（茶叶爱好者的胸针也采用了特殊的标识色…是为了让科德准确监视他的动向，控制局面吧。）",
            "nextDialogs": [
              "402020603"
            ]
          },
          "402020603": {
            "id": "402020603",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "（既然如此，那就能反过来利用他们互不熟悉的破绽…）",
            "nextDialogs": [
              "402020604"
            ]
          },
          "402020604": {
            "id": "402020604",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "待到拍卖会结束，夜兰与你们在德波大饭店前方会合，埃德勒警官也带人赶来…",
            "nextDialogs": [
              "402020605"
            ]
          },
          "402020605": {
            "id": "402020605",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "通过参加拍卖会的名单，你们确定了替罪羊的身份，他只是个普通的文员，最近陷入了经济困境，或许正是因此，才受到蛊惑，铤而走险。"
          }
        }
      }
    },
    {
      "subId": "4020204",
      "subQuestName": "与同伴会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }

  "subQuests": [
    {
      "subId": "4020201",
      "subQuestName": "等待到两天后18-20点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402020101"
        ],
        "dialogs": {
          "402020101": {
            "id": "402020101",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "嗯，机关激活了。",
            "nextDialogs": [
              "402020102"
            ]
          },
          "402020102": {
            "id": "402020102",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "稍作等待即可，最终的目标即将上钩…",
            "nextDialogs": [
              "402020103"
            ]
          },
          "402020103": {
            "id": "402020103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好神奇，现在我居然完全不紧张？",
            "nextDialogs": [
              "402020104"
            ]
          },
          "402020104": {
            "id": "402020104",
            "speakerId": 1002,
            "speakerName": "「黑钱领主」",
            "text": "想为这次拍卖会的失败做个总结，还是要加价呢？我亲爱的笛特先生？",
            "nextDialogs": [
              "402020105"
            ]
          },
          "402020105": {
            "id": "402020105",
            "speakerId": 1002,
            "speakerName": "「黑钱领主」",
            "text": "意外不是问题，问题在于，能否拿出对抗意外的韧性…",
            "nextDialogs": [
              "402020106"
            ]
          },
          "402020106": {
            "id": "402020106",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "由你这样的人，来说「对抗意外」，难免有点讽刺了。",
            "nextDialogs": [
              "402020107"
            ]
          },
          "402020107": {
            "id": "402020107",
            "speakerId": 1002,
            "speakerName": "「黑钱领主」",
            "text": "哦？",
            "nextDialogs": [
              "402020108"
            ]
          },
          "402020108": {
            "id": "402020108",
            "speakerId": 1002,
            "speakerName": "「黑钱领主」",
            "text": "看来，我一辈子设了这么多局，终于轮到我自己陷进别人的局了…",
            "nextDialogs": [
              "402020109"
            ]
          },
          "402020109": {
            "id": "402020109",
            "speakerId": 1002,
            "speakerName": "「黑钱领主」",
            "text": "倒也不意外，临时收买的家伙靠不住…也不是一次两次了。",
            "nextDialogs": [
              "402020110"
            ]
          },
          "402020110": {
            "id": "402020110",
            "speakerId": 1003,
            "speakerName": "罗韦雷·佩里恰",
            "text": "本人，「黑钱领主」罗韦雷·佩里恰，向三位锐不可当的探员致以敬意，恭贺你们的成功——",
            "nextDialogs": [
              "402020111"
            ]
          },
          "402020111": {
            "id": "402020111",
            "speakerId": 1003,
            "speakerName": "罗韦雷·佩里恰",
            "text": "执律庭联合璃月执法机关，筹备三个月，隐秘执行三个月的雷霆行动，堪称完美，成功摧毁了几十年来枫丹最大的摩拉除痕集团！",
            "nextDialogs": [
              "402020112"
            ]
          },
          "402020112": {
            "id": "402020112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "黑钱领主…明明说话还挺礼貌的，没想到是个坏透了的东西！",
            "nextDialogs": [
              "402020115"
            ]
          },
          "402020115": {
            "id": "402020115",
            "speakerId": 1003,
            "speakerName": "罗韦雷·佩里恰",
            "text": "请别说笑啊，您真觉得我会束手就擒？",
            "nextDialogs": [
              "402020116"
            ]
          },
          "402020116": {
            "id": "402020116",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "相当平静呢，你明白自己走投无路了。",
            "nextDialogs": [
              "402020117"
            ]
          },
          "402020117": {
            "id": "402020117",
            "speakerId": 1003,
            "speakerName": "罗韦雷·佩里恰",
            "text": "两个月以来，我眼睁睁看着你和埃德勒一步步瓦解我的组织。",
            "nextDialogs": [
              "402020118"
            ]
          },
          "402020118": {
            "id": "402020118",
            "speakerId": 1003,
            "speakerName": "罗韦雷·佩里恰",
            "text": "我被你们斩去了四肢，剜掉了双眼，刺穿了鼓膜…竭力挣扎都无济于事。",
            "nextDialogs": [
              "402020119"
            ]
          },
          "402020119": {
            "id": "402020119",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "所以，你想来个鱼死网破？太老套了。",
            "nextDialogs": [
              "402020120"
            ]
          },
          "402020120": {
            "id": "402020120",
            "speakerId": 1003,
            "speakerName": "罗韦雷·佩里恰",
            "text": "我那财富的高城已经彻底崩塌了，夜兰探员。和我发财的几百个部下也都没戏唱了，只剩科德一人还有点用处…",
            "nextDialogs": [
              "402020121"
            ]
          },
          "402020121": {
            "id": "402020121",
            "speakerId": 1003,
            "speakerName": "罗韦雷·佩里恰",
            "text": "我再也没法洗干净…哪怕一摩拉的黑钱。按你们追查的势头，直接锁定我，也只是时间问题。",
            "nextDialogs": [
              "402020122"
            ]
          },
          "402020122": {
            "id": "402020122",
            "speakerId": 1003,
            "speakerName": "罗韦雷·佩里恰",
            "text": "我不喜欢徒劳的挣扎，但一直被动挨打，我也积累了不少怨气。",
            "nextDialogs": [
              "402020123"
            ]
          },
          "402020123": {
            "id": "402020123",
            "speakerId": 1003,
            "speakerName": "罗韦雷·佩里恰",
            "text": "哪怕只让夜兰探员用您尊贵的性命为这一切买账，提供的情绪价值也能回本止损了！",
            "nextDialogs": [
              "402020124"
            ]
          },
          "402020124": {
            "id": "402020124",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "居然是发条机关！我我我，我收回礼貌的评价！",
            "nextDialogs": [
              "402020125"
            ]
          },
          "402020125": {
            "id": "402020125",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "花大价钱从黑市买来的旧代军用型吗…",
            "nextDialogs": [
              "402020126"
            ]
          },
          "402020126": {
            "id": "402020126",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "#不劳你出手，{NICKNAME}，这段时间，已经有劳你了。",
            "nextDialogs": [
              "402020127"
            ]
          },
          "402020127": {
            "id": "402020127",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "他想为自己的末路添加戏剧化的注脚，同我清算个人恩怨，那就让他如愿，输得彻底。"
          }
        }
      }
    },
    {
      "subId": "4020202",
      "subQuestName": "与拍卖会侍者对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402020201"
        ],
        "dialogs": {
          "402020201": {
            "id": "402020201",
            "speakerId": 1004,
            "speakerName": "侍者",
            "text": "两位客人晚上好，请随我去往拍卖会场。",
            "nextDialogs": [
              "402020202"
            ]
          },
          "402020202": {
            "id": "402020202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呼…我都有点紧张了，这次，一定要一鼓作气，把那帮坏家伙绳之以法！"
          }
        }
      }
    },
    {
      "subId": "4020219",
      "subQuestName": "与拍卖会侍者对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4020210",
      "subQuestName": "与夜兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402020401"
        ],
        "dialogs": {
          "402020401": {
            "id": "402020401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还，还挺热闹的…来了好多好多有钱人…",
            "nextDialogs": [
              "402020402"
            ]
          },
          "402020402": {
            "id": "402020402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一想到，这里面藏着坏家伙的爪牙，我就觉得，必须拿出最最认真的工作状态！",
            "nextDialogs": [
              "402020403"
            ]
          },
          "402020403": {
            "id": "402020403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙…",
            "nextDialogs": [
              "402020404"
            ]
          },
          "402020404": {
            "id": "402020404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么了嘛！不觉得，穷穷的我们，更应该扮演勤勤恳恳的正派角色——不被金钱蛊惑的好侦探吗？",
            "nextDialogs": [
              "402020407"
            ]
          },
          "402020407": {
            "id": "402020407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哈哈，不给。",
            "nextDialogs": [
              "402020408"
            ]
          },
          "402020408": {
            "id": "402020408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "因为现在只有这一副，以后我帮你做个更帅气的。",
            "nextDialogs": [
              "402020409"
            ]
          },
          "402020409": {
            "id": "402020409",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "哦？看来你们一点都不紧张，反而干劲十足啊。",
            "nextDialogs": [
              "402020410"
            ]
          },
          "402020410": {
            "id": "402020410",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "不过，会场内的主调，是松弛和悠然，你们也放慢呼吸的速度，适当抑制热情为妙，这样有助于隐入人群…",
            "nextDialogs": [
              "402020411"
            ]
          },
          "402020411": {
            "id": "402020411",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "夜夜夜夜夜…夜兰？",
            "nextDialogs": [
              "402020412"
            ]
          },
          "402020412": {
            "id": "402020412",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我没认错吧，你是夜兰没错吧！"
          }
        }
      }
    },
    {
      "subId": "4020212",
      "subQuestName": "装备道具并开始调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402021601"
        ],
        "dialogs": {
          "402021601": {
            "id": "402021601",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "（时机不错，开始调查吧。）"
          }
        }
      }
    },
    {
      "subId": "4020203",
      "subQuestName": "找到可疑人士",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402020301"
        ],
        "dialogs": {
          "402020301": {
            "id": "402020301",
            "speakerId": 1005,
            "speakerName": "得意的买家",
            "text": "真棒！这次我拍到了古法漆面的花瓶，家里又多了一件亮眼的摆设！",
            "nextDialogs": [
              "402020302"
            ]
          },
          "402020302": {
            "id": "402020302",
            "speakerId": 1006,
            "speakerName": "震惊的买家",
            "text": "你看到那几件沉玉谷的茶具了吗？没想到，它们居然那么叫座，竞价的数字让我完全没法思考！",
            "nextDialogs": [
              "402020303"
            ]
          },
          "402020303": {
            "id": "402020303",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "唉…怎么会搞砸呢？那两个小鬼是从哪冒出来的？",
            "nextDialogs": [
              "402020304"
            ]
          },
          "402020304": {
            "id": "402020304",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "雇主给你开价多少？执律庭可以给你两倍。",
            "nextDialogs": [
              "402020305"
            ]
          },
          "402020305": {
            "id": "402020305",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "你们！",
            "nextDialogs": [
              "402020306"
            ]
          },
          "402020306": {
            "id": "402020306",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "…我不知道你在说什么。",
            "nextDialogs": [
              "402020307"
            ]
          },
          "402020307": {
            "id": "402020307",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "这位杀手也不知道我在说什么。",
            "nextDialogs": [
              "402020308"
            ]
          },
          "402020308": {
            "id": "402020308",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "杀手先生只明白，「如果戴着蓝色胸针的人竞拍失败，就在僻静的地方将他处理掉」。",
            "nextDialogs": [
              "402020309"
            ]
          },
          "402020309": {
            "id": "402020309",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "处…处理掉？",
            "nextDialogs": [
              "402020310"
            ]
          },
          "402020310": {
            "id": "402020310",
            "speakerId": 1008,
            "speakerName": "？？？",
            "text": "你这小子也是走运！被执律庭盯上，反倒保了你一命！",
            "nextDialogs": [
              "402020311"
            ]
          },
          "402020311": {
            "id": "402020311",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "不不不不不，不对不对不对不对…",
            "nextDialogs": [
              "402020312"
            ]
          },
          "402020312": {
            "id": "402020312",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "老板明明说过，就算暴露了被抓了，只要守口如瓶，也会想办法把我从梅洛彼得堡捞出来…",
            "nextDialogs": [
              "402020313"
            ]
          },
          "402020313": {
            "id": "402020313",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "而且，他定金就付了我三百万啊！只是定金，就够我老婆一直用上最好最贵的药，再撑好几年…",
            "nextDialogs": [
              "402020314"
            ]
          },
          "402020314": {
            "id": "402020314",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "怎么…只是第一次竞拍失败，就怕我走漏消息…就要我永远闭嘴？",
            "nextDialogs": [
              "402020315"
            ]
          },
          "402020315": {
            "id": "402020315",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "比起用你的性命换来的黑色收益，给你的利益就像肉汤上的浮沫。",
            "nextDialogs": [
              "402020316"
            ]
          },
          "402020316": {
            "id": "402020316",
            "speakerId": 1009,
            "speakerName": "埃德勒",
            "text": "执律庭还关着七十多个你这样的人，想和他们谈谈吗？",
            "nextDialogs": [
              "402020317"
            ]
          },
          "402020317": {
            "id": "402020317",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "…唉。",
            "nextDialogs": [
              "402020318"
            ]
          },
          "402020318": {
            "id": "402020318",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "不必了。",
            "nextDialogs": [
              "402020319"
            ]
          },
          "402020319": {
            "id": "402020319",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "事已至此…你们应该是在给我回头的机会。需要我怎么做，警官？",
            "nextDialogs": [
              "402020320"
            ]
          },
          "402020320": {
            "id": "402020320",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "约那位雇主和你见个面，好好谈谈吧。",
            "nextDialogs": [
              "402020321"
            ]
          },
          "402020321": {
            "id": "402020321",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "雇主…他是个无比谨慎的家伙，只和我见过三次面，给了我定金、行动计划和资金。",
            "nextDialogs": [
              "402020322"
            ]
          },
          "402020322": {
            "id": "402020322",
            "speakerId": 1007,
            "speakerName": "笛特",
            "text": "但我可以领着你们去最后交货的地点，通过紧急方式联络他。",
            "nextDialogs": [
              "402020323"
            ]
          },
          "402020323": {
            "id": "402020323",
            "speakerId": 1009,
            "speakerName": "埃德勒",
            "text": "在此之前，我们还要去一趟你的住处，搜集所有与此案有关的证物。",
            "nextDialogs": [
              "402020324"
            ]
          },
          "402020324": {
            "id": "402020324",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呼…策反成功！",
            "nextDialogs": [
              "402020325"
            ]
          },
          "402020325": {
            "id": "402020325",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说实话，我怎么也想不到，夜兰只是这么几句话，就攻破了那家伙的心理防线。",
            "nextDialogs": [
              "402020326"
            ]
          },
          "402020326": {
            "id": "402020326",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "他本就无比紧张，惊疑不定，我们只是从切中利益的角度，和他来了场诚恳的商谈罢了。",
            "nextDialogs": [
              "402020327"
            ]
          },
          "402020327": {
            "id": "402020327",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "也应该感谢大家的演技，尤其是这位扮演杀手的警官。",
            "nextDialogs": [
              "402020328"
            ]
          },
          "402020328": {
            "id": "402020328",
            "speakerId": 1010,
            "speakerName": "丰克",
            "text": "好久没扮这种黑脸了，我还怕刚刚的语气不够凶呢。",
            "nextDialogs": [
              "402020329"
            ]
          },
          "402020329": {
            "id": "402020329",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哪里的事，你刚刚那股气焰，和我们以前碰见过的坏人完全一个劲！",
            "nextDialogs": [
              "402020332"
            ]
          },
          "402020332": {
            "id": "402020332",
            "speakerId": 1010,
            "speakerName": "丰克",
            "text": "那么，夜兰探员，我是先去控制科德呢，还是追踪多达马尼？",
            "nextDialogs": [
              "402020333"
            ]
          },
          "402020333": {
            "id": "402020333",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "须弥方面已有反馈，他们会在多达马尼返回拜达港后限制其行动，只等这边一个信号，就能实施抓捕。",
            "nextDialogs": [
              "402020334"
            ]
          },
          "402020334": {
            "id": "402020334",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "千岩军则会追击「诈狂」，剩下的就只有科德了，盯梢的时候，还请保持距离，避免提前引起警戒。",
            "nextDialogs": [
              "402020335"
            ]
          },
          "402020335": {
            "id": "402020335",
            "speakerId": 1010,
            "speakerName": "丰克",
            "text": "越接近收网的时刻，我越兴奋！",
            "nextDialogs": [
              "402020336"
            ]
          },
          "402020336": {
            "id": "402020336",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "那么，按照行动计划，十二小时后，我们就在替罪羊先生的指引下，去引蛇出洞…",
            "nextDialogs": [
              "402020337"
            ]
          },
          "402020337": {
            "id": "402020337",
            "speakerId": 1000,
            "speakerName": "夜兰",
            "text": "是时候让那位「黑钱领主」直面自己的罪责了。"
          }
        }
      }
    },

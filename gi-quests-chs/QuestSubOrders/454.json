    {
      "subId": "45401",
      "subQuestName": "与雷泽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4540101"
        ],
        "dialogs": {
          "4540101": {
            "id": "4540101",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "是谁？！",
            "nextDialogs": [
              "4540102"
            ]
          },
          "4540102": {
            "id": "4540102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别紧张，雷泽，是我们！",
            "nextDialogs": [
              "4540103"
            ]
          },
          "4540103": {
            "id": "4540103",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "你是…你也是骑士团的人？",
            "nextDialogs": [
              "4540104"
            ]
          },
          "4540104": {
            "id": "4540104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么，原来你们不认识吗？！",
            "nextDialogs": [
              "4540107"
            ]
          },
          "4540107": {
            "id": "4540107",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "不认识。 虽然也是红色，但是没有那个人那么烫。",
            "nextDialogs": [
              "4540108"
            ]
          },
          "4540108": {
            "id": "4540108",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "啊，我明白了。 你们之前说的狼少年就是他吗？",
            "nextDialogs": [
              "4540109"
            ]
          },
          "4540109": {
            "id": "4540109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "正是。 他叫做雷泽。",
            "nextDialogs": [
              "4540110"
            ]
          },
          "4540110": {
            "id": "4540110",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "帮我一个忙。",
            "nextDialogs": [
              "4540111"
            ]
          },
          "4540111": {
            "id": "4540111",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "嗯？",
            "nextDialogs": [
              "4540112"
            ]
          },
          "4540112": {
            "id": "4540112",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "来不及解释了。我让卢皮卡散开了。因为那群人来了。他们没有善意。",
            "nextDialogs": [
              "4540113"
            ]
          },
          "4540113": {
            "id": "4540113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是刚才那些家伙吧？",
            "nextDialogs": [
              "4540114"
            ]
          },
          "4540114": {
            "id": "4540114",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "明白了。不过在那之前，我有些事情想要问你——",
            "nextDialogs": [
              "4540115"
            ]
          },
          "4540115": {
            "id": "4540115",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "有血的气味。我们要快点。",
            "nextDialogs": [
              "4540116"
            ]
          },
          "4540116": {
            "id": "4540116",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "难道说是那群傻子被狼袭击了？！"
          }
        }
      }
    },
    {
      "subId": "45410",
      "subQuestName": "查看沿路的异样",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "45411",
      "subQuestName": "与安柏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4541101"
        ],
        "dialogs": {
          "4541101": {
            "id": "4541101",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "是血迹！",
            "nextDialogs": [
              "4541102"
            ]
          },
          "4541102": {
            "id": "4541102",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "不是人，是狼的。是卢皮卡的…",
            "nextDialogs": [
              "4541103"
            ]
          },
          "4541103": {
            "id": "4541103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以卢皮卡究竟是什么啊？",
            "nextDialogs": [
              "4541104"
            ]
          },
          "4541104": {
            "id": "4541104",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "卢皮卡——是命运的家族。如果狼接纳了人，或者人接纳了狼。他们就是卢皮卡。",
            "nextDialogs": [
              "4541105"
            ]
          },
          "4541105": {
            "id": "4541105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来不像是人的语言啊。",
            "nextDialogs": [
              "4541106"
            ]
          },
          "4541106": {
            "id": "4541106",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "这话就很奇怪了。难道狼的交流还会用语言的吗？",
            "nextDialogs": [
              "4541107"
            ]
          },
          "4541107": {
            "id": "4541107",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "是它定下的名字。",
            "nextDialogs": [
              "4541108"
            ]
          },
          "4541108": {
            "id": "4541108",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "…它，说的是谁？",
            "nextDialogs": [
              "4541109"
            ]
          },
          "4541109": {
            "id": "4541109",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "这片土地的领主。",
            "nextDialogs": [
              "4541110"
            ]
          },
          "4541110": {
            "id": "4541110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "蒙德的主人，不应该就是巴巴托斯吗？",
            "nextDialogs": [
              "4541111"
            ]
          },
          "4541111": {
            "id": "4541111",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "之后再说，我好像又找到线索了。跟我来。",
            "nextDialogs": [
              "4541112"
            ]
          },
          "4541112": {
            "id": "4541112",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "欸，你等等！我可是在给你机会解释自己的清白哦。",
            "nextDialogs": [
              "4541113"
            ]
          },
          "4541113": {
            "id": "4541113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，雷泽已经走了。"
          }
        }
      }
    },
    {
      "subId": "45412",
      "subQuestName": "跟上雷泽",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "45413",
      "subQuestName": "与雷泽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4541301"
        ],
        "dialogs": {
          "4541301": {
            "id": "4541301",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "是它。被那群人抓住了。",
            "nextDialogs": [
              "4541302"
            ]
          },
          "4541302": {
            "id": "4541302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是过分…",
            "nextDialogs": [
              "4541303"
            ]
          },
          "4541303": {
            "id": "4541303",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "虽然我也觉得很凄惨，但是我的立场…",
            "nextDialogs": [
              "4541304"
            ]
          },
          "4541304": {
            "id": "4541304",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "袭击村子的不是我们！",
            "nextDialogs": [
              "4541305"
            ]
          },
          "4541305": {
            "id": "4541305",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "是流浪而来的黑狼，还有它的狼群。它们想要领地。它们破坏了它定下的规矩。",
            "nextDialogs": [
              "4541306"
            ]
          },
          "4541306": {
            "id": "4541306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "<color=#00E1FFFF>它？</color>",
            "nextDialogs": [
              "4541307"
            ]
          },
          "4541307": {
            "id": "4541307",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "这片土地的领主。",
            "nextDialogs": [
              "4541308"
            ]
          },
          "4541308": {
            "id": "4541308",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "这句话刚才听过了。你还是解释一下吧。",
            "nextDialogs": [
              "4541309"
            ]
          },
          "4541309": {
            "id": "4541309",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "我要把卢皮卡抱到深处去。和我一起来吧。或许它会现身回答你。"
          }
        }
      }
    },

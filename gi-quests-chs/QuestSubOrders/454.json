        }
      }
    },
    {
      "subId": "45409",
      "subQuestName": "大号脚印开车$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4540901"
        ],
        "dialogs": {
          "4540901": {
            "id": "4540901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊，之前那个就有两米。"
          }
        }
      }
    },
    {
      "subId": "45415",
      "subQuestName": "向雷泽了解救治伤狼的办法",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4541501"
        ],
        "dialogs": {
          "4541501": {
            "id": "4541501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里是……",
            "nextDialogs": [
              "4541502"
            ]
          },
          "4541502": {
            "id": "4541502",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "#{NICKNAME}，请你帮我一个忙。帮我收集这个。",
            "nextDialogs": [
              "4541503"
            ]
          },
          "4541503": {
            "id": "4541503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个不是钩钩果的种子嘛？",
            "nextDialogs": [
              "4541504"
            ]
          },
          "4541504": {
            "id": "4541504",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "它碾碎了包扎，可以止血。",
            "nextDialogs": [
              "4541505"
            ]
          },
          "4541505": {
            "id": "4541505",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "的确。钩钩果的种子上面有层汁液，不仅能轻微麻醉痛觉，还能止血。",
            "nextDialogs": [
              "4541506"
            ]
          },
          "4541506": {
            "id": "4541506",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "书上这么说的。",
            "nextDialogs": [
              "4541507"
            ]
          },
          "4541507": {
            "id": "4541507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么会这样啊？",
            "nextDialogs": [
              "4541508"
            ]
          },
          "4541508": {
            "id": "4541508",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "这我就不知道了。",
            "nextDialogs": [
              "4541509"
            ]
          },
          "4541509": {
            "id": "4541509",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "钩子让种子散布。麻醉与止血，为了不痛。",
            "nextDialogs": [
              "4541510"
            ]
          },
          "4541510": {
            "id": "4541510",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "我们会更难察觉它，把它带得更远。",
            "nextDialogs": [
              "4541511"
            ]
          },
          "4541511": {
            "id": "4541511",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "…紫色的老师，是这么和我说的。",
            "nextDialogs": [
              "4541512"
            ]
          },
          "4541512": {
            "id": "4541512",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "我要留在这里照看它。还有，回答另一个红色女孩子的问题。",
            "nextDialogs": [
              "4541513"
            ]
          },
          "4541513": {
            "id": "4541513",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "嗯，如果人群回来了，骑士团的面子应该有点作用。",
            "nextDialogs": [
              "4541514"
            ]
          },
          "4541514": {
            "id": "4541514",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "#你的狼朋友们并没有洗脱嫌疑呢。不过，{NICKNAME}，草药还是麻烦你了。"
          }
        }
      }
    },
    {
      "subId": "45402",
      "subQuestName": "采集钩钩果",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4540201"
        ],
        "dialogs": {
          "4540201": {
            "id": "4540201",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "麻烦你去收集一下钩钩果了。我在这里有些事情要问他。"
          }
        }
      }
    },
    {
      "subId": "45403",
      "subQuestName": "将一枚钩钩果交给雷泽",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4540301"
        ],
        "dialogs": {
          "4540301": {
            "id": "4540301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们回来啦！你看看这些够吗？",
            "nextDialogs": [
              "4540302"
            ]
          },
          "4540302": {
            "id": "4540302",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "足够了。",
            "nextDialogs": [
              "4540303"
            ]
          },
          "4540303": {
            "id": "4540303",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "刚才和他谈了一下。狼群世界的规则，很不可思议啊。",
            "nextDialogs": [
              "4540304"
            ]
          },
          "4540304": {
            "id": "4540304",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "谢谢你们。",
            "nextDialogs": [
              "4540305"
            ]
          },
          "4540305": {
            "id": "4540305",
            "speakerId": 154301,
            "speakerName": "神奇的霍普金斯",
            "text": "绕了一圈都没有找到其他狼。",
            "nextDialogs": [
              "4540307"
            ]
          },
          "4540307": {
            "id": "4540307",
            "speakerId": 163201,
            "speakerName": "约顿",
            "text": "狼平常是这样的。刚才抓到那条明显是智力有点问题。",
            "nextDialogs": [
              "4540308"
            ]
          },
          "4540308": {
            "id": "4540308",
            "speakerId": 154301,
            "speakerName": "神奇的霍普金斯",
            "text": "干、干什么？",
            "nextDialogs": [
              "4540309"
            ]
          },
          "4540309": {
            "id": "4540309",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "找你算账。",
            "nextDialogs": [
              "4540310"
            ]
          },
          "4540310": {
            "id": "4540310",
            "speakerId": 163201,
            "speakerName": "约顿",
            "text": "就是他，传闻里被狼养大的人！",
            "nextDialogs": [
              "4540311"
            ]
          },
          "4540311": {
            "id": "4540311",
            "speakerId": 154301,
            "speakerName": "神奇的霍普金斯",
            "text": "嚯？",
            "nextDialogs": [
              "4540312"
            ]
          },
          "4540312": {
            "id": "4540312",
            "speakerId": 154301,
            "speakerName": "神奇的霍普金斯",
            "text": "原来就是你。我还在想狼怎么这么聪明了。",
            "nextDialogs": [
              "4540313"
            ]
          },
          "4540313": {
            "id": "4540313",
            "speakerId": 154301,
            "speakerName": "神奇的霍普金斯",
            "text": "是你在帮着畜生算计人啊？",
            "nextDialogs": [
              "4540314"
            ]
          },
          "4540314": {
            "id": "4540314",
            "speakerId": 154301,
            "speakerName": "神奇的霍普金斯",
            "text": "谁给吃谁就是父母吗，你忘了自己是个什么东西了？",
            "nextDialogs": [
              "4540315"
            ]
          },
          "4540315": {
            "id": "4540315",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "够了！",
            "nextDialogs": [
              "4540316"
            ]
          },
          "4540316": {
            "id": "4540316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们这是欺负雷泽不擅长说话！",
            "nextDialogs": [
              "4540317"
            ]
          },
          "4540317": {
            "id": "4540317",
            "speakerId": 163201,
            "speakerName": "约顿",
            "text": "嗯？！骑士团要袒护这个人吗！",
            "nextDialogs": [
              "4540318"
            ]
          },
          "4540318": {
            "id": "4540318",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "不是我们，袭击的村子——"
          }
        }
      }
    },

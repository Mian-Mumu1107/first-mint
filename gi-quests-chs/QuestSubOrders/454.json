    {
      "subId": "45405",
      "subQuestName": "挑战北风之狼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4540501"
        ],
        "dialogs": {
          "4540501": {
            "id": "4540501",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "「请你…息怒」"
          }
        }
      }
    },
    {
      "subId": "45406",
      "subQuestName": "与雷泽、北风狼对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4540601"
        ],
        "dialogs": {
          "4540601": {
            "id": "4540601",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "请你，息怒。",
            "nextDialogs": [
              "4540602"
            ]
          },
          "4540602": {
            "id": "4540602",
            "speakerId": 1176,
            "speakerName": "玻瑞亚斯",
            "text": "哼，罢了。",
            "nextDialogs": [
              "4540603"
            ]
          },
          "4540603": {
            "id": "4540603",
            "speakerId": 1176,
            "speakerName": "玻瑞亚斯",
            "text": "就像之前，这小子说的。外来的狼群破坏了这里的规矩。它们必然会被制裁。",
            "nextDialogs": [
              "4540604"
            ]
          },
          "4540604": {
            "id": "4540604",
            "speakerId": 1176,
            "speakerName": "玻瑞亚斯",
            "text": "但是你——雷泽，你不准参与讨伐。因为这是狼的问题。",
            "nextDialogs": [
              "4540605"
            ]
          },
          "4540605": {
            "id": "4540605",
            "speakerId": 1176,
            "speakerName": "玻瑞亚斯",
            "text": "你使用钢铁而不是爪牙，驾驭雷电而不是利齿…",
            "nextDialogs": [
              "4540606"
            ]
          },
          "4540606": {
            "id": "4540606",
            "speakerId": 1176,
            "speakerName": "玻瑞亚斯",
            "text": "你属于人类。",
            "nextDialogs": [
              "4540607"
            ]
          },
          "4540607": {
            "id": "4540607",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "我和他们，不一样！我才不属于他们！",
            "nextDialogs": [
              "4540608"
            ]
          },
          "4540608": {
            "id": "4540608",
            "speakerId": 1176,
            "speakerName": "玻瑞亚斯",
            "text": "你…不是狼。这是狼之间的事情。",
            "nextDialogs": [
              "4540609"
            ]
          },
          "4540609": {
            "id": "4540609",
            "speakerId": 1176,
            "speakerName": "玻瑞亚斯",
            "text": "倒是你，雷泽在人类中的卢皮卡。你倒是高尚又特殊之人。",
            "nextDialogs": [
              "4540610"
            ]
          },
          "4540610": {
            "id": "4540610",
            "speakerId": 1176,
            "speakerName": "玻瑞亚斯",
            "text": "如果有心，可以向我来寻求试炼。",
            "nextDialogs": [
              "4540611"
            ]
          },
          "4540611": {
            "id": "4540611",
            "speakerId": 1176,
            "speakerName": "玻瑞亚斯",
            "text": "我言尽于此，有缘再见吧，雷泽，和陌生的人类…",
            "nextDialogs": [
              "4540612"
            ]
          },
          "4540612": {
            "id": "4540612",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "唔…雷泽，别露出那种表情嘛。对了！要不要去城内住几天？",
            "nextDialogs": [
              "4540613"
            ]
          },
          "4540613": {
            "id": "4540613",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊，你在蒙德城也有一个朋友，不是吗？",
            "nextDialogs": [
              "4540614"
            ]
          },
          "4540614": {
            "id": "4540614",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个「红色的、很烫的，女孩子」…",
            "nextDialogs": [
              "4540615"
            ]
          },
          "4540615": {
            "id": "4540615",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "现在野外的行人对你也很危险。我知道你不想伤害他们。",
            "nextDialogs": [
              "4540616"
            ]
          },
          "4540616": {
            "id": "4540616",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "我没事，你们，放心。 但我不属于城市…",
            "nextDialogs": [
              "4540617"
            ]
          },
          "4540617": {
            "id": "4540617",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "我，也不属于这里…",
            "nextDialogs": [
              "4540621"
            ]
          },
          "4540621": {
            "id": "4540621",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "#谢谢你们。{NICKNAME}，派蒙，还有……另一个红色的女孩。",
            "nextDialogs": [
              "4540622"
            ]
          },
          "4540622": {
            "id": "4540622",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "我陪你聊了那么久，你居然不记得我叫安柏——？！",
            "nextDialogs": [
              "4540623"
            ]
          },
          "4540623": {
            "id": "4540623",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "那么，再见了。"
          }
        }
      }
    },
    {
      "subId": "45402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4540202"
        ],
        "dialogs": {
          "4540202": {
            "id": "4540202",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "钩钩果，就是这样的。它处理一下能止血。麻烦你了。"
          }
        }
      }
    }
  ]
}
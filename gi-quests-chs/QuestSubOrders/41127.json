    {
      "subId": "4112706",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411270401"
        ],
        "dialogs": {
          "411270401": {
            "id": "411270401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "盒子里装了什么？",
            "nextDialogs": [
              "411270402"
            ]
          },
          "411270402": {
            "id": "411270402",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "呃，你这就别管了，就是一点小玩意…",
            "nextDialogs": [
              "411270403"
            ]
          },
          "411270403": {
            "id": "411270403",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "喂！别用这种怀疑的眼神看着我啊！我又不是什么坏人！",
            "nextDialogs": [
              "411270404"
            ]
          },
          "411270404": {
            "id": "411270404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可你是愚人众啊。",
            "nextDialogs": [
              "411270405"
            ]
          },
          "411270405": {
            "id": "411270405",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "愚人众…愚人众就都是可疑的人吗？你这是哪里得来的结论！",
            "nextDialogs": [
              "411270406"
            ]
          },
          "411270406": {
            "id": "411270406",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "好了，你再去找找吧，<color=#00E1FFFF>真找不到的话，也可以回来找我</color>。",
            "nextDialogs": [
              "411270407"
            ]
          },
          "411270407": {
            "id": "411270407",
            "speakerId": 1000,
            "speakerName": "维克多",
            "text": "我再努力回忆回忆，看能不能想起什么…"
          }
        }
      }
    },

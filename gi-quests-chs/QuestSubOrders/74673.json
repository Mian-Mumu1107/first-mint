{
  "lineCounts": {
    "Player": 7,
    "乌尔曼": 18,
    "派蒙": 2
  },
  "subQuests": [
    {
      "subId": "7467301",
      "subQuestName": "与乌尔曼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746730101"
        ],
        "dialogs": {
          "746730101": {
            "id": "746730101",
            "speakerId": 30456,
            "speakerName": "乌尔曼",
            "text": "小家伙，我真的不会潜水，你瞧，我连潜水服都没有。",
            "nextDialogs": [
              "746730102"
            ]
          },
          "746730102": {
            "id": "746730102",
            "speakerId": 30456,
            "speakerName": "乌尔曼",
            "text": "哎哟…你就算是蹦来蹦去，我也没办法和你一起下去啊…",
            "nextDialogs": [
              "746730105"
            ]
          },
          "746730105": {
            "id": "746730105",
            "speakerId": 30456,
            "speakerName": "乌尔曼",
            "text": "#{NICKNAME}，还有派蒙，居然能在这遇见你们，真是巧了。",
            "nextDialogs": [
              "746730106"
            ]
          },
          "746730106": {
            "id": "746730106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你还是和之前一样，好受仙灵欢迎啊。而且…和仙灵交流得越来越熟练了呢。",
            "nextDialogs": [
              "746730107"
            ]
          },
          "746730107": {
            "id": "746730107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "帮我翻译一下仙灵在说什么。",
            "nextDialogs": [
              "746730108"
            ]
          },
          "746730108": {
            "id": "746730108",
            "speakerId": 30456,
            "speakerName": "乌尔曼",
            "text": "唉，你们就别笑我了。我哪明白它想说什么啊。",
            "nextDialogs": [
              "746730109"
            ]
          },
          "746730109": {
            "id": "746730109",
            "speakerId": 30456,
            "speakerName": "乌尔曼",
            "text": "我就是来枫丹做生意，来水边闲逛，突然又被一个小仙灵缠上了。",
            "nextDialogs": [
              "746730110"
            ]
          },
          "746730110": {
            "id": "746730110",
            "speakerId": 30456,
            "speakerName": "乌尔曼",
            "text": "我早就习惯这种事了，所以就跟着它走，翻过山，越过岭，还划了一会船。",
            "nextDialogs": [
              "746730111"
            ]
          },
          "746730111": {
            "id": "746730111",
            "speakerId": 30456,
            "speakerName": "乌尔曼",
            "text": "一般来说，它马上就会蹦来蹦去，告诉我这里埋着什么东西了。",
            "nextDialogs": [
              "746730112"
            ]
          },
          "746730112": {
            "id": "746730112",
            "speakerId": 30456,
            "speakerName": "乌尔曼",
            "text": "但是…它一头扎进了水里，越游越深…",
            "nextDialogs": [
              "746730113"
            ]
          },
          "746730113": {
            "id": "746730113",
            "speakerId": 30456,
            "speakerName": "乌尔曼",
            "text": "我可不会潜水啊！而且我听人家说，这水里不仅有洋流，还有各种危险的东西…我只能待在船上，等它回来。",
            "nextDialogs": [
              "746730114"
            ]
          },
          "746730114": {
            "id": "746730114",
            "speakerId": 30456,
            "speakerName": "乌尔曼",
            "text": "但是，那个小家伙还是锲而不舍地带我去各种地方…我真希望它能知道，我是真的不会潜水…"
          }
        }
      }
    }
  ]
}
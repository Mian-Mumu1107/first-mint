            ]
          },
          "700060104": {
            "id": "700060104",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "似乎是…某种肉类吧？不过我不太确定，查查我的手册看看吧？"
          }
        }
      }
    },

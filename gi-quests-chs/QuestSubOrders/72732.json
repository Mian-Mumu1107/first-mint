  "subQuests": [
    {
      "subId": "7273201",
      "subQuestName": "(test)任务npc对话block$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "727320101"
        ],
        "dialogs": {
          "727320101": {
            "id": "727320101",
            "speakerId": 13087,
            "speakerName": "「怪力三十三」",
            "text": "荒泷派，我来和你们决斗了！",
            "nextDialogs": [
              "727320102"
            ]
          },
          "727320102": {
            "id": "727320102",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "怎么回事？「花角玉将」那家伙又派了个小孩来出战？",
            "nextDialogs": [
              "727320103"
            ]
          },
          "727320103": {
            "id": "727320103",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "该不会是人手不够了，想要草草应付我们了事吧！",
            "nextDialogs": [
              "727320104"
            ]
          },
          "727320104": {
            "id": "727320104",
            "speakerId": 13087,
            "speakerName": "「怪力三十三」",
            "text": "…你不重要。",
            "nextDialogs": [
              "727320105"
            ]
          },
          "727320105": {
            "id": "727320105",
            "speakerId": 13087,
            "speakerName": "「怪力三十三」",
            "text": "吵吵闹闹的人，一般都是杂鱼。",
            "nextDialogs": [
              "727320106"
            ]
          },
          "727320106": {
            "id": "727320106",
            "speakerId": 13087,
            "speakerName": "「怪力三十三」",
            "text": "#这位金发的{M#大哥哥}{F#大姐姐}很沉稳，有一股强者的气势。{M#他}{F#她}才是你们荒泷派的老大吧？",
            "nextDialogs": [
              "727320107"
            ]
          },
          "727320107": {
            "id": "727320107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嘿嘿嘿，这位朋友的眼光很毒辣嘛！多夸{NICKNAME}几句！",
            "nextDialogs": [
              "727320108"
            ]
          },
          "727320108": {
            "id": "727320108",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "啊？你在胡说八道什么！",
            "nextDialogs": [
              "727320109"
            ]
          },
          "727320109": {
            "id": "727320109",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "#我的挚友确实强得没边，但这次，{M#他}{F#她}只是我们荒泷派的外援！帮派的名字写得清清楚楚，老大当然永远是我荒泷一斗了！",
            "nextDialogs": [
              "727320112"
            ]
          },
          "727320112": {
            "id": "727320112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，荒泷派的实力先放在一边，当老大究竟是什么感觉呢？我也有点好奇了！",
            "nextDialogs": [
              "727320113"
            ]
          },
          "727320113": {
            "id": "727320113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果你答应我们，我也可以是「荒泷（三天后到期）派蒙」，或者「荒泷派派蒙（临时老大）」！",
            "nextDialogs": [
              "727320114"
            ]
          },
          "727320114": {
            "id": "727320114",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "喂喂喂！你们两个！不要被对手带偏了啊！她明显是…想让我们起内讧！她在耍阴谋！",
            "nextDialogs": [
              "727320115"
            ]
          },
          "727320115": {
            "id": "727320115",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "等到本大爷战胜了她的老大，她就要为这番大话后悔，慌慌张张收回它了！",
            "nextDialogs": [
              "727320116"
            ]
          },
          "727320116": {
            "id": "727320116",
            "speakerId": 13087,
            "speakerName": "「怪力三十三」",
            "text": "拉倒吧…你们荒泷派内部的事，我可不关心，我只想和厉害的对手较量一番！",
            "nextDialogs": [
              "727320117"
            ]
          },
          "727320117": {
            "id": "727320117",
            "speakerId": 13087,
            "speakerName": "「怪力三十三」",
            "text": "#先让我领教一下这位{M#大哥哥}{F#大姐姐}的斗虫本领吧！"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7319701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731970101"
        ],
        "dialogs": {
          "731970101": {
            "id": "731970101",
            "speakerId": 1000,
            "speakerName": "健康之家箴言栏",
            "text": "此为收集教令院历代学者箴言的箴言栏，唯有沿着先贤开拓的道路，我们才能终见智慧之光。",
            "nextDialogs": [
              "731970102"
            ]
          },
          "731970102": {
            "id": "731970102",
            "speakerId": 1000,
            "speakerName": "健康之家箴言栏",
            "text": "正所谓「日光之下，并无新事。」"
          }
        }
      }
    },
    {
      "subId": "7319702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731970201"
        ],
        "dialogs": {
          "731970201": {
            "id": "731970201",
            "speakerId": 1001,
            "speakerName": "普尔希娜",
            "text": "「健康的身体造就健全的灵魂，灵魂的健全保证身体的健康。」"
          }
        }
      }
    },
    {
      "subId": "7319703",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731970301"
        ],
        "dialogs": {
          "731970301": {
            "id": "731970301",
            "speakerId": 1002,
            "speakerName": "苏诃瓦蒂",
            "text": "「学者是灵魂和身体的守护者。」"
          }
        }
      }
    },
    {
      "subId": "7319704",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731970401"
        ],
        "dialogs": {
          "731970401": {
            "id": "731970401",
            "speakerId": 1003,
            "speakerName": "阿尔比鲁尼",
            "text": "「亲近智慧，而非知识。」"
          }
        }
      }
    },
    {
      "subId": "7319705",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731970501"
        ],
        "dialogs": {
          "731970501": {
            "id": "731970501",
            "speakerId": 1004,
            "speakerName": "希般卡帝",
            "text": "「不懂占星的医师没资格称自己为医师。」"
          }
        }
      }
    },
    {
      "subId": "7319706",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731970601"
        ],
        "dialogs": {
          "731970601": {
            "id": "731970601",
            "speakerId": 1005,
            "speakerName": "阿尔瓦·尼古拉",
            "text": "「孤独是新知的前导。」"
          }
        }
      }
    },
    {
      "subId": "7319707",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731970701"
        ],
        "dialogs": {
          "731970701": {
            "id": "731970701",
            "speakerId": 1006,
            "speakerName": "麦苏迪",
            "text": "「从棋盘观世界之理，群星的艺术皆在纵横捭阖之间。」"
          }
        }
      }
    },
    {
      "subId": "7319708",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731970801"
        ],
        "dialogs": {
          "731970801": {
            "id": "731970801",
            "speakerId": 1007,
            "speakerName": "阿叶夏",
            "text": "「我们知道的，多于我们所能言说的。」"
          }
        }
      }
    },
    {
      "subId": "7319709",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731970901"
        ],
        "dialogs": {
          "731970901": {
            "id": "731970901",
            "speakerId": 1008,
            "speakerName": "法德兰",
            "text": "「似乎某些时刻，共同行走于凡世的七神也会彼此背道而驰。」"
          }
        }
      }
    },
    {
      "subId": "7319710",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731971001"
        ],
        "dialogs": {
          "731971001": {
            "id": "731971001",
            "speakerId": 1001,
            "speakerName": "普尔希娜",
            "text": "「即使是再幼小的龙蜥，也有成为『龙』的潜质。」"
          }
        }
      }
    },
    {
      "subId": "7319711",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731971101"
        ],
        "dialogs": {
          "731971101": {
            "id": "731971101",
            "speakerId": 1009,
            "speakerName": "伊斯坎德",
            "text": "「倚仗刀剑者，必将为刀剑所伤。」"
          }
        }
      }
    },
    {
      "subId": "7319712",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731971201"
        ],
        "dialogs": {
          "731971201": {
            "id": "731971201",
            "speakerId": 1010,
            "speakerName": "维斯塔姆",
            "text": "「事实比语言更加清楚。」"
          }
        }
      }
    },
    {
      "subId": "7319713",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731971301"
        ],
        "dialogs": {
          "731971301": {
            "id": "731971301",
            "speakerId": 1011,
            "speakerName": "娜迦师",
            "text": "「治愈爱情的良药是没有的…」"
          }
        }
      }
    },
    {
      "subId": "7319714",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731971401"
        ],
        "dialogs": {
          "731971401": {
            "id": "731971401",
            "speakerId": 1012,
            "speakerName": "迦毗鸠师",
            "text": "「事实证明，降诸魔山上连不上虚空。」"
          }
        }
      }
    },
    {
      "subId": "7319715",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731971501"
        ],
        "dialogs": {
          "731971501": {
            "id": "731971501",
            "speakerId": 1013,
            "speakerName": "玛塔布",
            "text": "「人要是唉声叹气，驮兽也会不叫。」"
          }
        }
      }
    },
    {
      "subId": "7319716",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731971601"
        ],
        "dialogs": {
          "731971601": {
            "id": "731971601",
            "speakerId": 13272,
            "speakerName": "居勒什",
            "text": "「世上没有什么是永恒不变的。」"
          }
        }
      }
    },
    {
      "subId": "7319717",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731971701"
        ],
        "dialogs": {
          "731971701": {
            "id": "731971701",
            "speakerId": 1015,
            "speakerName": "印和阗",
            "text": "「我死后想到猫去的地方…」"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7050008",
      "subQuestName": "向留云借风真君回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705000701"
        ],
        "dialogs": {
          "705000701": {
            "id": "705000701",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "嗯…味道真是不错，不愧是…",
            "nextDialogs": [
              "705000704"
            ]
          },
          "705000704": {
            "id": "705000704",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "正是。这三道菜做下来，本仙亲自制作的这台「机关烹饪神机」，其可靠性已完全得到验证。",
            "nextDialogs": [
              "705000705"
            ]
          },
          "705000705": {
            "id": "705000705",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "只要解决控制火候与自动取回食材这两大问题，这台机关便能「一键烹饪」了。",
            "nextDialogs": [
              "705000706"
            ]
          },
          "705000706": {
            "id": "705000706",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "对了，这份「红烩兽肉」的食谱你收好。食谱中所写的肉类，特指寻常兽肉。",
            "nextDialogs": [
              "705000707"
            ]
          },
          "705000707": {
            "id": "705000707",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "雪山天寒地冻，不能让你总来此地寻材觅食…",
            "nextDialogs": [
              "705000708"
            ]
          },
          "705000708": {
            "id": "705000708",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "平日里下厨做这道菜，用寻常兽肉便可。",
            "nextDialogs": [
              "705000709"
            ]
          },
          "705000709": {
            "id": "705000709",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "好了，多谢你帮本仙搜罗食材，旅行者。",
            "nextDialogs": [
              "705000710"
            ]
          },
          "705000710": {
            "id": "705000710",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "本仙也该带着「机关烹饪神机」回洞府去，再好好琢磨一番了。就此别过吧。",
            "nextDialogs": [
              "705000711"
            ]
          },
          "705000711": {
            "id": "705000711",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "噢，本仙若还有什么事需要帮忙的话…说不定还会再找你。",
            "nextDialogs": [
              "705000712"
            ]
          },
          "705000712": {
            "id": "705000712",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "到时候，你可千万不要推辞啊。毕竟本仙信得过你，最是认可你的实力。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7050011",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705001101"
        ],
        "dialogs": {
          "705001101": {
            "id": "705001101",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "照看火候的事，就交给你负责了，旅行者。"
          }
        }
      }
    },
    {
      "subId": "7050001",
      "subQuestName": "与留云借风真君对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705000101"
        ],
        "dialogs": {
          "705000101": {
            "id": "705000101",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "冰天雪地，玉树琼枝…寂寞又冷冽之地啊。本仙这第三道菜，倒是应景得很。",
            "nextDialogs": [
              "705000102"
            ]
          },
          "705000102": {
            "id": "705000102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这次又要做什么菜？",
            "nextDialogs": [
              "705000103"
            ]
          },
          "705000103": {
            "id": "705000103",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "唔…本仙问你，你有没有听说过一种名为「烩」的烹饪手法？这种手法也是本仙翻阅食谱时偶然发现的。",
            "nextDialogs": [
              "705000104"
            ]
          },
          "705000104": {
            "id": "705000104",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "本仙深感有趣，特意以这种烹饪手法为核心，写出了一份名为「红烩兽肉」的新食谱。",
            "nextDialogs": [
              "705000105"
            ]
          },
          "705000105": {
            "id": "705000105",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "虽然对本仙的「机关烹饪神机」来说，这道菜并不麻烦，但「红烩兽肉」这道菜重点在肉，所用的兽肉必须是优品…",
            "nextDialogs": [
              "705000106"
            ]
          },
          "705000106": {
            "id": "705000106",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "因此，本仙开启机关，一路追寻着食材的气息来到这里。",
            "nextDialogs": [
              "705000107"
            ]
          },
          "705000107": {
            "id": "705000107",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "此处风雪弥漫，实难办事。",
            "nextDialogs": [
              "705000108"
            ]
          },
          "705000108": {
            "id": "705000108",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "旅行者，本仙知道你见识广阔又精于冒险，区区雪山，对你而言，肯定不在话下。",
            "nextDialogs": [
              "705000109"
            ]
          },
          "705000109": {
            "id": "705000109",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "就请你再为本仙跑一趟，寻些食材回来吧。",
            "nextDialogs": [
              "705000111",
              "705000117"
            ]
          },
          "705000111": {
            "id": "705000111",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "自然忘不了你的。那这件事就交给你了，本仙就在这里等着你。",
            "nextDialogs": [
              "705000112"
            ]
          },
          "705000112": {
            "id": "705000112",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "呃，机关怎么突然停了，难不成是周遭太冷…",
            "nextDialogs": [
              "705000113"
            ]
          },
          "705000113": {
            "id": "705000113",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "待本仙重启一下…",
            "nextDialogs": [
              "705000114"
            ]
          },
          "705000114": {
            "id": "705000114",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "机关烹饪神机…启！",
            "nextDialogs": [
              "705000115"
            ]
          },
          "705000115": {
            "id": "705000115",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "这下应该好了…旅行者，你快循着气息的踪迹，去把本仙要的食材拿回来吧。"
          },
          "705000117": {
            "id": "705000117",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "笑话！本仙威能，岂容你小觑！本仙只是、只是…需要在此修缮机关罢了！",
            "nextDialogs": [
              "705000118"
            ]
          },
          "705000118": {
            "id": "705000118",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "你且快去快回吧，莫要让本仙等待太久。"
          }
        }
      }
    },
    {
      "subId": "7050002",
      "subQuestName": "跟随气息的踪迹，寻找食材",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705000201"
        ],
        "dialogs": {
          "705000201": {
            "id": "705000201",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "怎么样，你拿到本仙要的食材了吗？"
          }
        }
      }
    },
    {
      "subId": "7050003",
      "subQuestName": "向留云借风真君回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705000301"
        ],
        "dialogs": {
          "705000301": {
            "id": "705000301",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "怎么样？「红烩兽肉」已经做好了吗？"
          }
        }
      }
    },
    {
      "subId": "7050007",
      "subQuestName": "向留云借风真君回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705000501"
        ],
        "dialogs": {
          "705000501": {
            "id": "705000501",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "这是…什么肉？",
            "nextDialogs": [
              "705000502"
            ]
          },
          "705000502": {
            "id": "705000502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "冷鲜肉。",
            "nextDialogs": [
              "705000503"
            ]
          },
          "705000503": {
            "id": "705000503",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "冷鲜肉…名字倒是贴切。",
            "nextDialogs": [
              "705000504"
            ]
          },
          "705000504": {
            "id": "705000504",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "唔…品质不错。但看肉的状态，还需要稍加小火，化冻才行。",
            "nextDialogs": [
              "705000505"
            ]
          },
          "705000505": {
            "id": "705000505",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "幸好，本仙设计的「机关烹饪神机」兼有解冻之能…",
            "nextDialogs": [
              "705000507",
              "705000513"
            ]
          },
          "705000507": {
            "id": "705000507",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "怎么会呢？要说功能缺失，自然也有。例如，自动取回食材啊，自动控制火候…之类的。",
            "nextDialogs": [
              "705000508"
            ]
          },
          "705000508": {
            "id": "705000508",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "这机关，还是需要多多改进。",
            "nextDialogs": [
              "705000509"
            ]
          },
          "705000509": {
            "id": "705000509",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "好了，闲话不多说。既然食材备齐，本仙马上就去开启机关。",
            "nextDialogs": [
              "705000510"
            ]
          },
          "705000510": {
            "id": "705000510",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "照看火候的事，依然交给你负责，旅行者。",
            "nextDialogs": [
              "705000511"
            ]
          },
          "705000511": {
            "id": "705000511",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "你准备好之后，速来知会本仙。"
          },
          "705000513": {
            "id": "705000513",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "与其赞赏仙力，本仙更希望你赞赏「机关烹饪神机」的巧能。"
          }
        }
      }
    },

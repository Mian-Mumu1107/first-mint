        ],
        "dialogs": {
          "705001001": {
            "id": "705001001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没准备好。",
            "nextDialogs": [
              "705001002"
            ]
          },
          "705001002": {
            "id": "705001002",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "唔…那你准备好之后，再来告诉本仙吧。"
          }
        }
      }

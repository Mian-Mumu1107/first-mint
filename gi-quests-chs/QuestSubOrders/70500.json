            "text": "机关烹饪神机…启！"
          }
        }
      }
    },
    {
      "subId": "7050010",
      "subQuestName": "(test)准备！$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

    {
      "subId": "1102203",
      "subQuestName": "寻找能完整看到残骸上图案的位置",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1102207",
      "subQuestName": "前往第二处机关所在地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110220701"
        ],
        "dialogs": {
          "110220701": {
            "id": "110220701",
            "speakerId": 1002,
            "speakerName": "宛烟",
            "text": "这个地方…啊，我想起来了，好像是有几个奇怪的元素方碑。原来是有联系的…",
            "nextDialogs": [
              "110220702"
            ]
          },
          "110220702": {
            "id": "110220702",
            "speakerId": 1002,
            "speakerName": "宛烟",
            "text": "怪不得，以前为了调查这个封印，我还专门请来了持有「神之眼」的人。",
            "nextDialogs": [
              "110220703"
            ]
          },
          "110220703": {
            "id": "110220703",
            "speakerId": 1002,
            "speakerName": "宛烟",
            "text": "结果方碑被点亮之后什么都没发生，然后就熄灭了…",
            "nextDialogs": [
              "110220704"
            ]
          },
          "110220704": {
            "id": "110220704",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "实际上，不仅是需要同时启动，这里的石碑如果不按照正确的顺序点亮，依旧无法解开封印。",
            "nextDialogs": [
              "110220705"
            ]
          },
          "110220705": {
            "id": "110220705",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "此处的玄机，藏于一句讲述魔神战争的话中。",
            "nextDialogs": [
              "110220706"
            ]
          },
          "110220706": {
            "id": "110220706",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "「<color=#00E1FFFF>南</color>出天衡，<color=#00E1FFFF>东</color>入瑶光，<color=#00E1FFFF>西</color>登绝云，<color=#00E1FFFF>北</color>访轻策，诸地萧条，生灵涂炭。璃月广袤，竟难容一处安宁。」",
            "nextDialogs": [
              "110220707"
            ]
          },
          "110220707": {
            "id": "110220707",
            "speakerId": 1000,
            "speakerName": "克列门特",
            "text": "南出…东什么？璃月人说话怎么这么难懂！",
            "nextDialogs": [
              "110220708"
            ]
          },
          "110220708": {
            "id": "110220708",
            "speakerId": 1002,
            "speakerName": "宛烟",
            "text": "我、我好像对这句话有印象！",
            "nextDialogs": [
              "110220709"
            ]
          },
          "110220709": {
            "id": "110220709",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "没错，这句话讲述的内容，也和「盐之魔神」有关。",
            "nextDialogs": [
              "110220710"
            ]
          },
          "110220710": {
            "id": "110220710",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "这位善良仁慈的神，为了给饱受战乱之苦的人类，提供一个安全的去处，冒着危险走遍了璃月各地。",
            "nextDialogs": [
              "110220711"
            ]
          },
          "110220711": {
            "id": "110220711",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "那个年代，诸神交战，战火纷飞，哪怕只是片刻的和平，都是一种奢侈。",
            "nextDialogs": [
              "110220712"
            ]
          },
          "110220712": {
            "id": "110220712",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "而她最终寻到的——就是现在被我们称为「地中之盐」的这块土地。",
            "nextDialogs": [
              "110220713"
            ]
          },
          "110220713": {
            "id": "110220713",
            "speakerId": 1002,
            "speakerName": "宛烟",
            "text": "可惜…这份安宁，最后还是被摩拉克斯打破了。",
            "nextDialogs": [
              "110220714"
            ]
          },
          "110220714": {
            "id": "110220714",
            "speakerId": 1000,
            "speakerName": "克列门特",
            "text": "别再说这些古时候的故事了，既然有了线索，赶快打开封印吧，快点快点！只要能打开封印，怎么都行！",
            "nextDialogs": [
              "110220715"
            ]
          },
          "110220715": {
            "id": "110220715",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "#{NICKNAME}，<color=#00E1FFFF>天衡在南，瑶光在东，绝云在西，轻策在北。</color>",
            "nextDialogs": [
              "110220716"
            ]
          },
          "110220716": {
            "id": "110220716",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "有了这些提示，你一定有眉目了吧？"
          }
        }
      }
    },

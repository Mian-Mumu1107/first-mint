    {
      "subId": "1102206",
      "subQuestName": "前往封印解除的地方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110220601"
        ],
        "dialogs": {
          "110220601": {
            "id": "110220601",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "在进入遗迹之前，我有个提议，可以避免在孤云阁那样无谓的争吵。",
            "nextDialogs": [
              "110220602"
            ]
          },
          "110220602": {
            "id": "110220602",
            "speakerId": 1002,
            "speakerName": "宛烟",
            "text": "嗯，先生请讲。",
            "nextDialogs": [
              "110220603"
            ]
          },
          "110220603": {
            "id": "110220603",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "请你们二位签订契约。契约的内容是：「顺次取物，每次一件」。",
            "nextDialogs": [
              "110220604"
            ]
          },
          "110220604": {
            "id": "110220604",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "为示诚意，你们选取即可，不用把我列入序列。",
            "nextDialogs": [
              "110220605"
            ]
          },
          "110220605": {
            "id": "110220605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也不用了。",
            "nextDialogs": [
              "110220606"
            ]
          },
          "110220606": {
            "id": "110220606",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "喂喂喂，这么好的机会，不要放弃得这么快嘛！",
            "nextDialogs": [
              "110220607"
            ]
          },
          "110220607": {
            "id": "110220607",
            "speakerId": 1000,
            "speakerName": "克列门特",
            "text": "我不同意！这意思是…我要和这个半吊子考古学家，平分收获？不可能！绝对不可能！",
            "nextDialogs": [
              "110220608"
            ]
          },
          "110220608": {
            "id": "110220608",
            "speakerId": 1002,
            "speakerName": "宛烟",
            "text": "我不同意！哼！他就只会糟蹋「盐之魔神」留下的文物吧！我，我也不能接受。",
            "nextDialogs": [
              "110220609"
            ]
          },
          "110220609": {
            "id": "110220609",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "那么…若「契约」不能成立，我就不能继续担当顾问了。",
            "nextDialogs": [
              "110220610"
            ]
          },
          "110220610": {
            "id": "110220610",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "这遗迹中藏着什么宝物和陷阱，就全凭两位的阅历去鉴别。",
            "nextDialogs": [
              "110220611"
            ]
          },
          "110220611": {
            "id": "110220611",
            "speakerId": 1000,
            "speakerName": "克列门特",
            "text": "这、这…唉，这家伙我真的信不过。行吧，既然是被封印的「盐之魔神」的遗迹，就算只能拿一半，也够赚了。",
            "nextDialogs": [
              "110220612"
            ]
          },
          "110220612": {
            "id": "110220612",
            "speakerId": 1002,
            "speakerName": "宛烟",
            "text": "要我答应契约…也行。我只有一个要求，钟离先生。",
            "nextDialogs": [
              "110220613"
            ]
          },
          "110220613": {
            "id": "110220613",
            "speakerId": 1002,
            "speakerName": "宛烟",
            "text": "如果发现了「盐之魔神」的真相，请你一定要公正地判断，就算那真相是对摩拉克斯不利的。",
            "nextDialogs": [
              "110220614"
            ]
          },
          "110220614": {
            "id": "110220614",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "交换条件如此，我可以接受。",
            "nextDialogs": [
              "110220615"
            ]
          },
          "110220615": {
            "id": "110220615",
            "speakerId": 1001,
            "speakerName": "钟离",
            "text": "那么，我们走吧。"
          }
        }
      }
    },
    {
      "subId": "1102108",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110210801"
        ],
        "dialogs": {
          "110210801": {
            "id": "110210801",
            "speakerId": 1002,
            "speakerName": "宛烟",
            "text": "你啊！简直掉进钱眼里了！",
            "nextDialogs": [
              "110210802"
            ]
          },
          "110210802": {
            "id": "110210802",
            "speakerId": 1000,
            "speakerName": "克列门特",
            "text": "你才是，天天挖文物，脑子里进灰了吧！",
            "nextDialogs": [
              "110210803"
            ]
          },
          "110210803": {
            "id": "110210803",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "还、还在吵…我们别打扰了吧…"
          }
        }
      }
    }
  ]
}
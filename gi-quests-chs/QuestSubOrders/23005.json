    {
      "subId": "2300502",
      "subQuestName": "与哈特姆交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050201"
        ],
        "dialogs": {
          "230050201": {
            "id": "230050201",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "唔…还算不错…",
            "nextDialogs": [
              "230050202"
            ]
          },
          "230050202": {
            "id": "230050202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来你赚了不少啊…",
            "nextDialogs": [
              "230050203"
            ]
          },
          "230050203": {
            "id": "230050203",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "哎哟，旅行者！托你的福，我这次小赚了几笔，看来「吞金料理」果然有点效果。",
            "nextDialogs": [
              "230050204"
            ]
          },
          "230050204": {
            "id": "230050204",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "只不过，比起平时正常交易赚来的也没差多少…",
            "nextDialogs": [
              "230050205"
            ]
          },
          "230050205": {
            "id": "230050205",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "这不应该是「吞金料理」该有的表现，难道是我吃的菜不对吗…",
            "nextDialogs": [
              "230050206"
            ]
          },
          "230050206": {
            "id": "230050206",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "旅行者，那我们就再来一次，请你再帮我挑选一次「吞金料理」吧？",
            "nextDialogs": [
              "230050207"
            ]
          },
          "230050207": {
            "id": "230050207",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "还是老规矩，就在<color=#00E1FFFF>摩拉肉</color>，<color=#00E1FFFF>黄油鸡</color>和<color=#00E1FFFF>「堆高高」</color>中选一样就好。"
          }
        }
      }
    },
    {
      "subId": "2300503",
      "subQuestName": "帮哈特姆选择一份「吞金料理」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050301"
        ],
        "dialogs": {
          "230050301": {
            "id": "230050301",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "上次小赚，这次一定能大赚，<color=#00E1FFFF>摩拉肉</color>，<color=#00E1FFFF>黄油鸡</color>和<color=#00E1FFFF>「堆高高」</color>，怎么样？选好了吗？"
          }
        }
      }
    },
    {
      "subId": "2300507",
      "subQuestName": "帮哈特姆选择一份「吞金料理」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050701"
        ],
        "dialogs": {
          "230050701": {
            "id": "230050701",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "好！品相绝佳的料理！我相信这次我买的期货肯定能一飞冲天！"
          }
        }
      }
    },
    {
      "subId": "2300508",
      "subQuestName": "帮哈特姆选择一份「吞金料理」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050801"
        ],
        "dialogs": {
          "230050801": {
            "id": "230050801",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "看起来品质不错，这回会能不能赚它个盆满钵满呢？"
          }
        }
      }
    },
    {
      "subId": "2300509",
      "subQuestName": "帮哈特姆选择一份「吞金料理」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050901"
        ],
        "dialogs": {
          "230050901": {
            "id": "230050901",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "这份料理看起来有点奇怪啊…不管了，我要开工了。",
            "nextDialogs": [
              "230050902"
            ]
          },
          "230050902": {
            "id": "230050902",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "真是太感谢你了，旅行者，咱们回头见！"
          }
        }
      }
    },
    {
      "subId": "2300504",
      "subQuestName": "与哈特姆交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050401"
        ],
        "dialogs": {
          "230050401": {
            "id": "230050401",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "唔…",
            "nextDialogs": [
              "230050402"
            ]
          },
          "230050402": {
            "id": "230050402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗨！哈特姆，最近怎么样呀？",
            "nextDialogs": [
              "230050403"
            ]
          },
          "230050403": {
            "id": "230050403",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "嗯…是你们啊？",
            "nextDialogs": [
              "230050404"
            ]
          },
          "230050404": {
            "id": "230050404",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "唉，看见我这幅愁眉苦脸的样子，你们应该多少也猜到些了吧？",
            "nextDialogs": [
              "230050405"
            ]
          },
          "230050405": {
            "id": "230050405",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "我坦白了，到现在为止，我的荷包已经瘪了一半了。",
            "nextDialogs": [
              "230050406"
            ]
          },
          "230050406": {
            "id": "230050406",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "真奇怪…不应该这样的…",
            "nextDialogs": [
              "230050407"
            ]
          },
          "230050407": {
            "id": "230050407",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "不过话说回来…我有一个猜想，也许这正是市场要腾飞的征兆。",
            "nextDialogs": [
              "230050408"
            ]
          },
          "230050408": {
            "id": "230050408",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "就像人们必须要先弯曲腿部，然后才能高高跃起。",
            "nextDialogs": [
              "230050409"
            ]
          },
          "230050409": {
            "id": "230050409",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "换作期货交易市场也是一样，现在整个市场都来到了底部。接下来一定就是触底反弹的时刻了吧？",
            "nextDialogs": [
              "230050410"
            ]
          },
          "230050410": {
            "id": "230050410",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "也就是说，现在就是抄底的最好时机！",
            "nextDialogs": [
              "230050413"
            ]
          },
          "230050413": {
            "id": "230050413",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "不，我很肯定，这是一个难得的机会，我绝不会错过任何获取财富的机会。",
            "nextDialogs": [
              "230050414"
            ]
          },
          "230050414": {
            "id": "230050414",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "这样才能对得起我卡里米的不凡富翁哈特姆这个名头！",
            "nextDialogs": [
              "230050415"
            ]
          },
          "230050415": {
            "id": "230050415",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "再帮我一把吧？朋友，再帮我挑选一份「吞金料理」吧！",
            "nextDialogs": [
              "230050416"
            ]
          },
          "230050416": {
            "id": "230050416",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那还是在原来的三样里选嘛？",
            "nextDialogs": [
              "230050417"
            ]
          },
          "230050417": {
            "id": "230050417",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "唔…不！既然是要抄底，我需要一份更加特别的料理，它能为市场带来好的转变！",
            "nextDialogs": [
              "230050418"
            ]
          },
          "230050418": {
            "id": "230050418",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "我听说蒙德也有一位富翁，他的酒业生意兴隆无比…",
            "nextDialogs": [
              "230050419"
            ]
          },
          "230050419": {
            "id": "230050419",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是说…",
            "nextDialogs": [
              "230050420"
            ]
          },
          "230050420": {
            "id": "230050420",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "迪卢克老爷？",
            "nextDialogs": [
              "230050421"
            ]
          },
          "230050421": {
            "id": "230050421",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但你怎么知道…",
            "nextDialogs": [
              "230050422"
            ]
          },
          "230050422": {
            "id": "230050422",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "哈哈哈，我连「堆高高」都知道，又怎么可能不知道他呢？",
            "nextDialogs": [
              "230050423"
            ]
          },
          "230050423": {
            "id": "230050423",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "他的名下有一家酒馆，出售一种名叫「苹果酿」的好东西，如果能喝下它，也许我就能借来一丝那位富翁的好财运！",
            "nextDialogs": [
              "230050424"
            ]
          },
          "230050424": {
            "id": "230050424",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "拜托了，请为我准备一份苹果酿吧！"
          }
        }
      }
    },
    {
      "subId": "2300505",
      "subQuestName": "帮哈特姆准备一份苹果酿",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050501"
        ],
        "dialogs": {
          "230050501": {
            "id": "230050501",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "上次亏的，这次一定要连本带利赚回来！"
          }
        }
      }
    },
    {
      "subId": "2300506",
      "subQuestName": "与哈特姆交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230050601"
        ],
        "dialogs": {
          "230050601": {
            "id": "230050601",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "这就是那位富翁的苹果酿吗？嗯，里面有一股不凡的香气，令人头脑清醒。",
            "nextDialogs": [
              "230050602"
            ]
          },
          "230050602": {
            "id": "230050602",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "好啊！这一定是能给市场带来转变的好东西！",
            "nextDialogs": [
              "230050603"
            ]
          },
          "230050603": {
            "id": "230050603",
            "speakerId": 1000,
            "speakerName": "哈特姆",
            "text": "我不会忘记你们的帮助的！二位，咱们回头见！"
          }
        }
      }
    }
  ]
}
    {
      "subId": "4007707",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400770701"
        ],
        "dialogs": {
          "400770701": {
            "id": "400770701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "都放进去了，莫娜，这样就行了吗？",
            "nextDialogs": [
              "400770702"
            ]
          },
          "400770702": {
            "id": "400770702",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "应该是吧，反正手稿是这么写的。",
            "nextDialogs": [
              "400770703"
            ]
          },
          "400770703": {
            "id": "400770703",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "稍等片刻吧。希望它能恢复正常。",
            "nextDialogs": [
              "400770704"
            ]
          },
          "400770704": {
            "id": "400770704",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "大家席地而坐，就着火堆烤了些食物边吃边聊。",
            "nextDialogs": [
              "400770705"
            ]
          },
          "400770705": {
            "id": "400770705",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "装置修复后，情况果真有所好转。很快，远处传来了脚步声…",
            "nextDialogs": [
              "400770706"
            ]
          },
          "400770706": {
            "id": "400770706",
            "speakerId": 12644,
            "speakerName": "愚人众士官",
            "text": "啊！有人在我们的营地里！",
            "nextDialogs": [
              "400770707"
            ]
          },
          "400770707": {
            "id": "400770707",
            "speakerId": 12645,
            "speakerName": "愚人众新兵",
            "text": "喂，你们是什么人？！",
            "nextDialogs": [
              "400770708"
            ]
          },
          "400770708": {
            "id": "400770708",
            "speakerId": 12644,
            "speakerName": "愚人众士官",
            "text": "等等，你看那台装置，修、修好了？",
            "nextDialogs": [
              "400770709"
            ]
          },
          "400770709": {
            "id": "400770709",
            "speakerId": 12645,
            "speakerName": "愚人众新兵",
            "text": "欸？欸？可是佩尔西科夫先生还躺在那边的地上啊。",
            "nextDialogs": [
              "400770710"
            ]
          },
          "400770710": {
            "id": "400770710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这台装置是我们修好的哦，你们应该谢谢我们！",
            "nextDialogs": [
              "400770711"
            ]
          },
          "400770711": {
            "id": "400770711",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "要不是被这些事打扰，我们本来可以度过一个完美无缺的假期。",
            "nextDialogs": [
              "400770712"
            ]
          },
          "400770712": {
            "id": "400770712",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "哼！还不快过来向本皇女和诸位家臣致歉！",
            "nextDialogs": [
              "400770713"
            ]
          },
          "400770713": {
            "id": "400770713",
            "speakerId": 12644,
            "speakerName": "愚人众士官",
            "text": "啊？！不不不，我、我先走了…",
            "nextDialogs": [
              "400770714"
            ]
          },
          "400770714": {
            "id": "400770714",
            "speakerId": 12645,
            "speakerName": "愚人众新兵",
            "text": "喂，喂，别丢下我…佩尔西科夫先生还在那里，快回来救他啊！",
            "nextDialogs": [
              "400770715"
            ]
          },
          "400770715": {
            "id": "400770715",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "哈哈哈，那两个人看起来很清醒。",
            "nextDialogs": [
              "400770716"
            ]
          },
          "400770716": {
            "id": "400770716",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "看来，修复成功了。",
            "nextDialogs": [
              "400770717"
            ]
          },
          "400770717": {
            "id": "400770717",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太好啦！那我们别待在这里了，我想回自己的营地继续度假。",
            "nextDialogs": [
              "400770718"
            ]
          },
          "400770718": {
            "id": "400770718",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你说的，是可莉的营地吧。",
            "nextDialogs": [
              "400770719"
            ]
          },
          "400770719": {
            "id": "400770719",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！但我现在觉得，那里也是属于我们几个的营地了，就像临时的家一样，嘿嘿。",
            "nextDialogs": [
              "400770720"
            ]
          },
          "400770720": {
            "id": "400770720",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "那里或许该被称为幽夜净土暨嘟嘟王国大使馆。",
            "nextDialogs": [
              "400770721"
            ]
          },
          "400770721": {
            "id": "400770721",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？不要啦，好难念。我还是喜欢用记得住的名字。",
            "nextDialogs": [
              "400770722"
            ]
          },
          "400770722": {
            "id": "400770722",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "走吧走吧，我们快点回家去。"
          }
        }
      }
    },
    {
      "subId": "4007710",
      "subQuestName": "与众人一起返回营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400770801"
        ],
        "dialogs": {
          "400770801": {
            "id": "400770801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼啊——！回到家里大吃一顿，又在躺椅上躺了半天，总算是放松下来啦。",
            "nextDialogs": [
              "400770802"
            ]
          },
          "400770802": {
            "id": "400770802",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "哦呵呵，幽夜净土的招待，汝还满意吗？",
            "nextDialogs": [
              "400770803"
            ]
          },
          "400770803": {
            "id": "400770803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "很喜欢！",
            "nextDialogs": [
              "400770804"
            ]
          },
          "400770804": {
            "id": "400770804",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "喜欢就好。小姐请诸位家臣过来，不仅想让各位见证我等圣国的降临，更是想让各位放松身心，欢度夏日。",
            "nextDialogs": [
              "400770805"
            ]
          },
          "400770805": {
            "id": "400770805",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "真好啊，我好喜欢这里，这次真是来对了！",
            "nextDialogs": [
              "400770806"
            ]
          },
          "400770806": {
            "id": "400770806",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "这里应该成为永远的乐土。",
            "nextDialogs": [
              "400770807"
            ]
          },
          "400770807": {
            "id": "400770807",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐的意思是，希望以后还能与你们一同外出游玩。",
            "nextDialogs": [
              "400770808"
            ]
          },
          "400770808": {
            "id": "400770808",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "一定！等你们有时间，也可以来璃月找我，我带你们四处转转。",
            "nextDialogs": [
              "400770809"
            ]
          },
          "400770809": {
            "id": "400770809",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "哦对，璃月最好吃的饭店是我朋友家经营的，你们肯定喜欢。",
            "nextDialogs": [
              "400770810"
            ]
          },
          "400770810": {
            "id": "400770810",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "要是想听戏，也可以去找云堇，她人很好，又喜欢结交有趣的朋友，你们或许会在戏剧话题上很合得来。",
            "nextDialogs": [
              "400770811"
            ]
          },
          "400770811": {
            "id": "400770811",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "哦？辛焱卿极力推荐，我确实开始感兴趣了呢。",
            "nextDialogs": [
              "400770812"
            ]
          },
          "400770812": {
            "id": "400770812",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "#{NICKNAME}，我有个想法。",
            "nextDialogs": [
              "400770813"
            ]
          },
          "400770813": {
            "id": "400770813",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "稻妻有种小吃叫做烤堇瓜，配着鱼肉风味也不错。今晚不如我们也试着把水果和海鲜一起烤，如何？",
            "nextDialogs": [
              "400770815",
              "400770817"
            ]
          },
          "400770815": {
            "id": "400770815",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "那就说定了，我会尽量多找些水果，调味的话…嗯，就这么办。",
            "nextDialogs": [
              "400770823"
            ]
          },
          "400770823": {
            "id": "400770823",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "你们在这儿啊。",
            "nextDialogs": [
              "400770824"
            ]
          },
          "400770824": {
            "id": "400770824",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我发现一个问题。虽然我们已经修复装置，但你看，那些小岛上的幻境并未消失。",
            "nextDialogs": [
              "400770825"
            ]
          },
          "400770825": {
            "id": "400770825",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "我也察觉到了。考虑到幻境诞生需要时间，消失可能也需要。",
            "nextDialogs": [
              "400770826"
            ]
          },
          "400770826": {
            "id": "400770826",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "嗯，也是一种可能。",
            "nextDialogs": [
              "400770827"
            ]
          },
          "400770827": {
            "id": "400770827",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "说起来，我的水占盘倒是完全恢复正常，可以用了。刚才占卜的结果也没有太大异常，只是…",
            "nextDialogs": [
              "400770828"
            ]
          },
          "400770828": {
            "id": "400770828",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只是？",
            "nextDialogs": [
              "400770829"
            ]
          },
          "400770829": {
            "id": "400770829",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "只是，占卜结果中有些看不懂的东西…似乎有某种力量围绕在我们身侧，注视着我们。",
            "nextDialogs": [
              "400770830"
            ]
          },
          "400770830": {
            "id": "400770830",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "是装置造成的吗？还是佩尔西科夫？",
            "nextDialogs": [
              "400770831"
            ]
          },
          "400770831": {
            "id": "400770831",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "抱歉，我也不清楚。只能确定这股力量目前不具有攻击性，应该是对我们没什么恶意。",
            "nextDialogs": [
              "400770832"
            ]
          },
          "400770832": {
            "id": "400770832",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这么说来，岛上还有一个问题没有解决，只是大家都不知道那件事。）",
            "nextDialogs": [
              "400770833"
            ]
          },
          "400770833": {
            "id": "400770833",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会留意的。",
            "nextDialogs": [
              "400770834"
            ]
          },
          "400770834": {
            "id": "400770834",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "嗯。虽说接下来没有干扰，可以尽情享受假日了，但离开海岛之前，我们还是要多加小心。",
            "nextDialogs": [
              "400770835"
            ]
          },
          "400770835": {
            "id": "400770835",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我也会每日占卜的。",
            "nextDialogs": [
              "400770836"
            ]
          },
          "400770836": {
            "id": "400770836",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "我答应过菲谢尔会担任守卫一职，我也可以帮忙。",
            "nextDialogs": [
              "400770837"
            ]
          },
          "400770837": {
            "id": "400770837",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "好，拜托了。",
            "nextDialogs": [
              "400770838"
            ]
          },
          "400770838": {
            "id": "400770838",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "…唉，谁让她们那么无忧无虑呀。这次的事，我多操心就是了。",
            "nextDialogs": [
              "400770839"
            ]
          },
          "400770839": {
            "id": "400770839",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，跟我来！",
            "nextDialogs": [
              "400770840"
            ]
          },
          "400770840": {
            "id": "400770840",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢噢，来了！",
            "nextDialogs": [
              "400770841"
            ]
          },
          "400770841": {
            "id": "400770841",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "到边上去。",
            "nextDialogs": [
              "400770842"
            ]
          },
          "400770842": {
            "id": "400770842",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我明白了，是要联络卖唱的对吧？",
            "nextDialogs": [
              "400770843"
            ]
          },
          "400770843": {
            "id": "400770843",
            "speakerId": 12625,
            "speakerName": "嘟嘟通讯仪",
            "text": "嘟嘟可——嘟嘟可——",
            "nextDialogs": [
              "400770844"
            ]
          },
          "400770844": {
            "id": "400770844",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哎呀哎呀，你们终于联系我了？还以为你们玩得太高兴，把我彻底忘掉了呢。",
            "nextDialogs": [
              "400770845"
            ]
          },
          "400770845": {
            "id": "400770845",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不是啦，卖唱的，我们遇到了很奇怪的事哦！",
            "nextDialogs": [
              "400770846"
            ]
          },
          "400770846": {
            "id": "400770846",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "将这几天海岛上发生的所有事件详细告知温迪…",
            "nextDialogs": [
              "400770847"
            ]
          },
          "400770847": {
            "id": "400770847",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "奇怪的装置？甚至能模仿神的能力？啊哈哈，愚人众还有这种计划吗，真是异想天开啊。",
            "nextDialogs": [
              "400770848"
            ]
          },
          "400770848": {
            "id": "400770848",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听你的口气，是不知道这事咯？",
            "nextDialogs": [
              "400770849"
            ]
          },
          "400770849": {
            "id": "400770849",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我只是个酒馆卖唱的吟游诗人而已，怎么可能知道这些。",
            "nextDialogs": [
              "400770850"
            ]
          },
          "400770850": {
            "id": "400770850",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这家伙，又开始了…",
            "nextDialogs": [
              "400770851"
            ]
          },
          "400770851": {
            "id": "400770851",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#不过，撇开这些，{NICKNAME}，派蒙，这次你们玩得开心吗？",
            "nextDialogs": [
              "400770852"
            ]
          },
          "400770852": {
            "id": "400770852",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "开心！吃了好吃的东西，看了很多奇妙的景象，很不错哦！"
          },
          "400770817": {
            "id": "400770817",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "是在稻妻吃的吗？",
            "nextDialogs": [
              "400770818"
            ]
          },
          "400770818": {
            "id": "400770818",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "几位稻妻朋友亲手给我烤的。",
            "nextDialogs": [
              "400770819"
            ]
          },
          "400770819": {
            "id": "400770819",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "哈哈，那太好了。",
            "nextDialogs": [
              "400770820"
            ]
          },
          "400770820": {
            "id": "400770820",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "我也打算像你一样，四处游历，广交好友。",
            "nextDialogs": [
              "400770821"
            ]
          },
          "400770821": {
            "id": "400770821",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "万叶的话，一定没问题。",
            "nextDialogs": [
              "400770822"
            ]
          },
          "400770822": {
            "id": "400770822",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "#承你吉言，{NICKNAME}。"
          }
        }
      }

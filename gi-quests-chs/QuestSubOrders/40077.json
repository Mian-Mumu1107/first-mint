      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400770201"
        ],
        "dialogs": {
          "400770201": {
            "id": "400770201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这位研究员遭到万叶制裁后有过片刻清醒，可没多久又晕了过去…）",
            "nextDialogs": [
              "400770202"
            ]
          },
          "400770202": {
            "id": "400770202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（到底是他本就神志不清，还是被摔晕了呢？）"
          }
        }
      }
    },

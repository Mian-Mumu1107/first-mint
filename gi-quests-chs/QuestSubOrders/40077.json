  },
  "subQuests": [
    {
      "subId": "4007711",
      "subQuestName": "前往愚人众装置所在地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400771101"
        ],
        "dialogs": {
          "400771101": {
            "id": "400771101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！你们看那个人，是不是第一天我们见到的那个？",
            "nextDialogs": [
              "400771102"
            ]
          },
          "400771102": {
            "id": "400771102",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "啊哈哈…嗝！都疯了，都滚吧！",
            "nextDialogs": [
              "400771103"
            ]
          },
          "400771103": {
            "id": "400771103",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "我们…我们永远不会醒来…但我是对的，我的宝贝，无敌…",
            "nextDialogs": [
              "400771104"
            ]
          },
          "400771104": {
            "id": "400771104",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "宝贝？他的什么宝贝？",
            "nextDialogs": [
              "400771105"
            ]
          },
          "400771105": {
            "id": "400771105",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "创造奇迹的机械…绝非…不可能…嗝！",
            "nextDialogs": [
              "400771106"
            ]
          },
          "400771106": {
            "id": "400771106",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "看来，宝贝就是指那台装置了吧。",
            "nextDialogs": [
              "400771107"
            ]
          },
          "400771107": {
            "id": "400771107",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "烂醉如泥，哼。",
            "nextDialogs": [
              "400771108"
            ]
          },
          "400771108": {
            "id": "400771108",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "噢这扑面的酒气…小姐，请容我用翅膀为您扇风。",
            "nextDialogs": [
              "400771109"
            ]
          },
          "400771109": {
            "id": "400771109",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "太好了，也给我扇扇。",
            "nextDialogs": [
              "400771110"
            ]
          },
          "400771110": {
            "id": "400771110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我也要。",
            "nextDialogs": [
              "400771111"
            ]
          },
          "400771111": {
            "id": "400771111",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "当然。",
            "nextDialogs": [
              "400771112"
            ]
          },
          "400771112": {
            "id": "400771112",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "各位，我在附近看过了，没有其他人在。",
            "nextDialogs": [
              "400771113"
            ]
          },
          "400771113": {
            "id": "400771113",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "很奇怪不是吗？愚人众是一个组织，这里却只剩这位。而上一次来，我们甚至连这位也没找到。",
            "nextDialogs": [
              "400771114"
            ]
          },
          "400771114": {
            "id": "400771114",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "甚至就连上一次那位胖胖的先生也不见了。我猜…他们躲在其他地方。",
            "nextDialogs": [
              "400771115"
            ]
          },
          "400771115": {
            "id": "400771115",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "至于原因，恐怕就要问眼前这位了。",
            "nextDialogs": [
              "400771116"
            ]
          },
          "400771116": {
            "id": "400771116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是他醉得像头死猪一样，我们是不是还要等他？",
            "nextDialogs": [
              "400771117"
            ]
          },
          "400771117": {
            "id": "400771117",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "降下惩戒的圣泉！",
            "nextDialogs": [
              "400771118"
            ]
          },
          "400771118": {
            "id": "400771118",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "小姐的意思是拿水浇他。",
            "nextDialogs": [
              "400771119"
            ]
          },
          "400771119": {
            "id": "400771119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来不错，我们试试！",
            "nextDialogs": [
              "400771120"
            ]
          },
          "400771120": {
            "id": "400771120",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "众人找出背囊里的水，毫不客气地对准这位愚人众研究员倒下…",
            "nextDialogs": [
              "400771121"
            ]
          },
          "400771121": {
            "id": "400771121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呀，他睁眼了！",
            "nextDialogs": [
              "400771122"
            ]
          },
          "400771122": {
            "id": "400771122",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "唔…唔？",
            "nextDialogs": [
              "400771123"
            ]
          },
          "400771123": {
            "id": "400771123",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "喂，你是愚人众吧？能不能告诉我们这里到底发生了什么事，那台装置究竟有什么用？",
            "nextDialogs": [
              "400771124"
            ]
          },
          "400771124": {
            "id": "400771124",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "…愚人…众…",
            "nextDialogs": [
              "400771125"
            ]
          },
          "400771125": {
            "id": "400771125",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "…哈哈哈！愚人众！",
            "nextDialogs": [
              "400771126"
            ]
          },
          "400771126": {
            "id": "400771126",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "噢，噢…愚昧无知的高层，你后悔了吧！哈哈，否定我的研究，逼我…",
            "nextDialogs": [
              "400771127"
            ]
          },
          "400771127": {
            "id": "400771127",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "逼我…来到无人岛，做实验…宝贝！宝贝，呜呜呜…",
            "nextDialogs": [
              "400771128"
            ]
          },
          "400771128": {
            "id": "400771128",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么还哭了，感觉他也受过很多委屈…",
            "nextDialogs": [
              "400771129"
            ]
          },
          "400771129": {
            "id": "400771129",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "…蔑视我…和我的宝贝发明！你们、你们…不懂得未来的胜算。",
            "nextDialogs": [
              "400771130"
            ]
          },
          "400771130": {
            "id": "400771130",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "唯有我的发明…能让大家征服世界…哈哈，哈哈哈…",
            "nextDialogs": [
              "400771131"
            ]
          },
          "400771131": {
            "id": "400771131",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "傻子，傻子，哈哈哈哈哈…",
            "nextDialogs": [
              "400771132"
            ]
          },
          "400771132": {
            "id": "400771132",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "呃啊…！不要打我，我不炸实验室了…对不起！不是故意…",
            "nextDialogs": [
              "400771133"
            ]
          },
          "400771133": {
            "id": "400771133",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "不行啊，这个人疯疯癫癫的，根本没法交流。",
            "nextDialogs": [
              "400771134"
            ]
          },
          "400771134": {
            "id": "400771134",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "第一天我们见到他的时候，他还不是这样，看来是在后几天受到了进一步影响，最终也陷入疯狂。",
            "nextDialogs": [
              "400771135"
            ]
          },
          "400771135": {
            "id": "400771135",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "呜、呜…我的手稿，手稿！只有这个…能救…救…呜呜…",
            "nextDialogs": [
              "400771136"
            ]
          },
          "400771136": {
            "id": "400771136",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "手稿？在哪里？",
            "nextDialogs": [
              "400771137"
            ]
          },
          "400771137": {
            "id": "400771137",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "别凶我，别凶我呜呜呜…",
            "nextDialogs": [
              "400771138"
            ]
          },
          "400771138": {
            "id": "400771138",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "菲谢尔，你别凶他啊！",
            "nextDialogs": [
              "400771139"
            ]
          },
          "400771139": {
            "id": "400771139",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "哼！那…",
            "nextDialogs": [
              "400771140"
            ]
          },
          "400771140": {
            "id": "400771140",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "换我来。",
            "nextDialogs": [
              "400771141"
            ]
          },
          "400771141": {
            "id": "400771141",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "亲爱的先生，看着我。告诉我，你把手稿藏在哪里了？",
            "nextDialogs": [
              "400771142"
            ]
          },
          "400771142": {
            "id": "400771142",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "呜…呜…好可怕，不要逼我写报告…呜呜…走开…",
            "nextDialogs": [
              "400771143"
            ]
          },
          "400771143": {
            "id": "400771143",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不会吧，他完全沉浸在想象中…",
            "nextDialogs": [
              "400771144"
            ]
          },
          "400771144": {
            "id": "400771144",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "我来吧。",
            "nextDialogs": [
              "400771145"
            ]
          },
          "400771145": {
            "id": "400771145",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "……",
            "nextDialogs": [
              "400771146"
            ]
          },
          "400771146": {
            "id": "400771146",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "失礼了！",
            "nextDialogs": [
              "400771147"
            ]
          },
          "400771147": {
            "id": "400771147",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "谁也没想到，万叶静静地站了一会儿，随后一个过肩摔将研究员拎起又摔下。",
            "nextDialogs": [
              "400771148"
            ]
          },
          "400771148": {
            "id": "400771148",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "喝啊！",
            "nextDialogs": [
              "400771149"
            ]
          },
          "400771149": {
            "id": "400771149",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "呜呜！屁股痛痛，呜呜…脑子好像动起来了，不是浆糊了…",
            "nextDialogs": [
              "400771150"
            ]
          },
          "400771150": {
            "id": "400771150",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "能告诉我你把手稿放在哪里了吗？",
            "nextDialogs": [
              "400771151"
            ]
          },
          "400771151": {
            "id": "400771151",
            "speakerId": 16939,
            "speakerName": "研究员",
            "text": "手稿…手稿…在那边的石缝里…",
            "nextDialogs": [
              "400771152"
            ]
          },
          "400771152": {
            "id": "400771152",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "说了！太好啦，不然我就要对着他的耳朵来一曲摇滚了。",
            "nextDialogs": [
              "400771153"
            ]
          },
          "400771153": {
            "id": "400771153",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "万叶似乎犹豫了很久才对他加以制裁呢，真是心地善良。",
            "nextDialogs": [
              "400771154"
            ]
          },
          "400771154": {
            "id": "400771154",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯。这就是干大事的人吧。",
            "nextDialogs": [
              "400771155"
            ]
          },
          "400771155": {
            "id": "400771155",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "各位，先把手稿找出来吧，就在附近的石头缝里。"
          }
        }
      }
    },
    {
      "subId": "4007701",
      "subQuestName": "寻找佩尔西科夫的笔记",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400770101"
        ],
        "dialogs": {
          "400770101": {
            "id": "400770101",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "在这里！",
            "nextDialogs": [
              "400770102"
            ]
          },
          "400770102": {
            "id": "400770102",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "恭喜诸位，已寻得解决问题的关键！",
            "nextDialogs": [
              "400770103"
            ]
          },
          "400770103": {
            "id": "400770103",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我看看…唔…",
            "nextDialogs": [
              "400770104"
            ]
          },
          "400770104": {
            "id": "400770104",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "莫娜接过手稿，仔细研读…",
            "nextDialogs": [
              "400770105"
            ]
          },
          "400770105": {
            "id": "400770105",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "果然，这组名为「知感拟态」的装置能对人脑产生影响，制造者就是前面那个研究员，他名叫佩尔西科夫。",
            "nextDialogs": [
              "400770106"
            ]
          },
          "400770106": {
            "id": "400770106",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "从手稿来看，愚人众上层并不支持佩尔西科夫的研究，甚至认为他走了弯路。",
            "nextDialogs": [
              "400770107"
            ]
          },
          "400770107": {
            "id": "400770107",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "但佩尔西科夫非常坚持要将已成型的装置投入实战。为此，他托关系调用人手，将整组装置拆分为多个部件，运到无人岛上。",
            "nextDialogs": [
              "400770108"
            ]
          },
          "400770108": {
            "id": "400770108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真亏他们能找到这座岛啊！果然不能小看愚人众的情报网呢。",
            "nextDialogs": [
              "400770109"
            ]
          },
          "400770109": {
            "id": "400770109",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "佩尔西科夫一意孤行，在这里展开实验。参与实验的成员大都是愚人众下层士兵。他们签署过风险知情书。",
            "nextDialogs": [
              "400770110"
            ]
          },
          "400770110": {
            "id": "400770110",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "…看来，他们真的认为这组装置能为愚人众带去收益。",
            "nextDialogs": [
              "400770111"
            ]
          },
          "400770111": {
            "id": "400770111",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "装置的原理是什么？",
            "nextDialogs": [
              "400770112"
            ]
          },
          "400770112": {
            "id": "400770112",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "那恐怕就是顶级机密了，手稿中并未详写。但佩尔西科夫提到，这组装置是仿照某位神明的权能制作而成。",
            "nextDialogs": [
              "400770113"
            ]
          },
          "400770113": {
            "id": "400770113",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "意思是，有一位神明的权能和这些幻梦有关，而且愚人众还进行过了相关研究？",
            "nextDialogs": [
              "400770114"
            ]
          },
          "400770114": {
            "id": "400770114",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "对。否则，他们无法模仿神明的权能。",
            "nextDialogs": [
              "400770115"
            ]
          },
          "400770115": {
            "id": "400770115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（居然还有这样的神明吗？）",
            "nextDialogs": [
              "400770116"
            ]
          },
          "400770116": {
            "id": "400770116",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "总而言之，佩尔西科夫的实验过程并不顺利。装置启动后没几天就出现了故障，他们试图维修，没想到…",
            "nextDialogs": [
              "400770117"
            ]
          },
          "400770117": {
            "id": "400770117",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "毫无技术的愚人众士兵直接把装置搞得一团糟，连最最重要的晶核都被弹飞出去，不知掉到了哪个角落。",
            "nextDialogs": [
              "400770118"
            ]
          },
          "400770118": {
            "id": "400770118",
            "speakerId": 10012,
            "speakerName": "奥兹",
            "text": "可见维修是一项多么重要的工作，请各位量力而为。",
            "nextDialogs": [
              "400770119"
            ]
          },
          "400770119": {
            "id": "400770119",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "虽说佩尔西科夫是个科学疯子，却也不想看着自己的部下遭遇不测。再说，如果不解决问题，他自己也会发疯。",
            "nextDialogs": [
              "400770120"
            ]
          },
          "400770120": {
            "id": "400770120",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "情急之下，佩尔西科夫孤身一人外出寻找晶核，可他是个体弱多病的研究员，根本没那个本事，只得放弃。",
            "nextDialogs": [
              "400770121"
            ]
          },
          "400770121": {
            "id": "400770121",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "跟着，佩尔西科夫竭尽全力找回那些因疯狂而走散的士兵，把他们带到隐蔽的山洞里。",
            "nextDialogs": [
              "400770122"
            ]
          },
          "400770122": {
            "id": "400770122",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "登岛那天我们遇到的应该就是这个阶段的他们，佩尔西科夫带着一个身材健壮的愚人众士兵。",
            "nextDialogs": [
              "400770123"
            ]
          },
          "400770123": {
            "id": "400770123",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "对，佩尔西科夫花了很大力气，将士兵们都聚集到洞穴中，开始想办法唤醒他们。他使用音乐、诗歌…",
            "nextDialogs": [
              "400770124"
            ]
          },
          "400770124": {
            "id": "400770124",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "但都没什么用。",
            "nextDialogs": [
              "400770125"
            ]
          },
          "400770125": {
            "id": "400770125",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "我记得我们来过这里一次，那天谁都不在。这么看，佩尔西科夫就是在那天把所有人召集到了山洞里。",
            "nextDialogs": [
              "400770126"
            ]
          },
          "400770126": {
            "id": "400770126",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "嗯。最后几页有一个好消息和一个坏消息。",
            "nextDialogs": [
              "400770127"
            ]
          },
          "400770127": {
            "id": "400770127",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "好消息是，佩尔西科夫从疯狂的士兵口中问到零零散散的信息，拼凑出了晶核的所在地…",
            "nextDialogs": [
              "400770128"
            ]
          },
          "400770128": {
            "id": "400770128",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "而坏消息是，佩尔西科夫没能唤醒他们。随后他自己也受到影响，陷入了疯狂。手稿最后几页都是他发疯一样的乱涂乱画。",
            "nextDialogs": [
              "400770129"
            ]
          },
          "400770129": {
            "id": "400770129",
            "speakerId": 10011,
            "speakerName": "菲谢尔",
            "text": "如此看来，这份差事又落到了我与家臣们头上。",
            "nextDialogs": [
              "400770132"
            ]
          },
          "400770132": {
            "id": "400770132",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "手稿里有张地图，这上面标明的应该就是晶核所在地了。",
            "nextDialogs": [
              "400770133"
            ]
          },
          "400770133": {
            "id": "400770133",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没其他办法了，我们加油找回那些晶核吧！"
          }
        }
      }
    },
    {

    {
      "subId": "4131308",
      "subQuestName": "与魈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413130801"
        ],
        "dialogs": {
          "413130801": {
            "id": "413130801",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "还有何事？",
            "nextDialogs": [
              "413130802"
            ]
          },
          "413130802": {
            "id": "413130802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想请你一起去海灯节。",
            "nextDialogs": [
              "413130803"
            ]
          },
          "413130803": {
            "id": "413130803",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "…我不喜欢人来人往的地方，你自己去游玩就好。",
            "nextDialogs": [
              "413130804"
            ]
          },
          "413130804": {
            "id": "413130804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不用你去璃月港。",
            "nextDialogs": [
              "413130805"
            ]
          },
          "413130805": {
            "id": "413130805",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "…什么意思？",
            "nextDialogs": [
              "413130806"
            ]
          },
          "413130806": {
            "id": "413130806",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我把海灯节搬过来了。",
            "nextDialogs": [
              "413130807"
            ]
          },
          "413130807": {
            "id": "413130807",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "「搬过来」？",
            "nextDialogs": [
              "413130808"
            ]
          },
          "413130808": {
            "id": "413130808",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀，就是在客栈下面摆了好多好吃的，好多霄灯，周围也没有多少人。",
            "nextDialogs": [
              "413130809"
            ]
          },
          "413130809": {
            "id": "413130809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还准备了「杏仁豆腐」和「烤吃虎鱼」…",
            "nextDialogs": [
              "413130810"
            ]
          },
          "413130810": {
            "id": "413130810",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们快点下去吧，不然菜都要凉啦！"
          }
        }
      }
    },
    {
      "subId": "4131309",
      "subQuestName": "与魈一起用餐",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413130901"
        ],
        "dialogs": {
          "413130901": {
            "id": "413130901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么样，我们给你搬过来的海灯节看上去是不是很好吃？",
            "nextDialogs": [
              "413130902"
            ]
          },
          "413130902": {
            "id": "413130902",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "这就是你们搬来的海灯节？人类的行为，非要如此怪异吗？",
            "nextDialogs": [
              "413130903"
            ]
          },
          "413130903": {
            "id": "413130903",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "你们做这些事，意义何在？",
            "nextDialogs": [
              "413130906"
            ]
          },
          "413130906": {
            "id": "413130906",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "…是这样吗？人的心思真是难以揣测。",
            "nextDialogs": [
              "413130907"
            ]
          },
          "413130907": {
            "id": "413130907",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你们别光顾着说话了，快点吃东西吧，不然菜都要凉了。",
            "nextDialogs": [
              "413130908"
            ]
          },
          "413130908": {
            "id": "413130908",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，我先开始吃啦！",
            "nextDialogs": [
              "413130909"
            ]
          },
          "413130909": {
            "id": "413130909",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好啦，东西也吃好了，应该是去看「明霄灯」的时候啦。",
            "nextDialogs": [
              "413130910"
            ]
          },
          "413130910": {
            "id": "413130910",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "魈也一起去吧。",
            "nextDialogs": [
              "413130911"
            ]
          },
          "413130911": {
            "id": "413130911",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "你们去吧，我对那些东西不感兴趣。"
          }
        }
      }
    },
    {
      "subId": "4131320",
      "subQuestName": "(test)切桌子上的菜$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413132001"
        ],
        "dialogs": {
          "413132001": {
            "id": "413132001",
            "speakerId": 1003,
            "speakerName": "淮安",
            "text": "瞧瞧，这小摊有点模样了吧。",
            "nextDialogs": [
              "413132002"
            ]
          },
          "413132002": {
            "id": "413132002",
            "speakerId": 1003,
            "speakerName": "淮安",
            "text": "怎么样，吃的都准备好了吗？",
            "nextDialogs": [
              "413132003"
            ]
          },
          "413132003": {
            "id": "413132003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都准备好了。",
            "nextDialogs": [
              "413132004"
            ]
          },
          "413132004": {
            "id": "413132004",
            "speakerId": 1003,
            "speakerName": "淮安",
            "text": "行，我来摆一摆，你赶紧上去把那位给请下来吧，别把菜给晾凉了。"
          }
        }
      }
    },

    {
      "subId": "4131311",
      "subQuestName": "与魈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413131101"
        ],
        "dialogs": {
          "413131101": {
            "id": "413131101",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "到这里为止吧。我就不陪你们进城了。",
            "nextDialogs": [
              "413131103"
            ]
          },
          "413131103": {
            "id": "413131103",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "还有什么事？",
            "nextDialogs": [
              "413131105"
            ]
          },
          "413131105": {
            "id": "413131105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "明明海灯节纪念的英雄里也包括你…为什么你却不想去看灯呢？",
            "nextDialogs": [
              "413131106"
            ]
          },
          "413131106": {
            "id": "413131106",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "我…不喜欢人群。",
            "nextDialogs": [
              "413131107"
            ]
          },
          "413131107": {
            "id": "413131107",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "无忧无虑的，安详的人群…我和他们不一样。",
            "nextDialogs": [
              "413131108"
            ]
          },
          "413131108": {
            "id": "413131108",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "我和杀戮并存太久，已经习惯了那种苦行。和幸福的人一起，只会让我…",
            "nextDialogs": [
              "413131109"
            ]
          },
          "413131109": {
            "id": "413131109",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "…这个话题到此为止吧。",
            "nextDialogs": [
              "413131110"
            ]
          },
          "413131110": {
            "id": "413131110",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "再会。",
            "nextDialogs": [
              "413131111"
            ]
          },
          "413131111": {
            "id": "413131111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真的不和我一起看灯吗？",
            "nextDialogs": [
              "413131112"
            ]
          },
          "413131112": {
            "id": "413131112",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "你这么喜欢凑热闹？",
            "nextDialogs": [
              "413131113"
            ]
          },
          "413131113": {
            "id": "413131113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你猜猜看。",
            "nextDialogs": [
              "413131114"
            ]
          },
          "413131114": {
            "id": "413131114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！这都是正当娱乐活动，不要说是凑热闹呀！",
            "nextDialogs": [
              "413131115"
            ]
          },
          "413131115": {
            "id": "413131115",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "…正当的…",
            "nextDialogs": [
              "413131116"
            ]
          },
          "413131116": {
            "id": "413131116",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "罢了。去看你的灯吧。",
            "nextDialogs": [
              "413131117"
            ]
          },
          "413131117": {
            "id": "413131117",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "但注意安全。遇到任何危险，就直呼我名吧。",
            "nextDialogs": [
              "413131118"
            ]
          },
          "413131118": {
            "id": "413131118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你又不在城里，赶得过来吗？",
            "nextDialogs": [
              "413131119"
            ]
          },
          "413131119": {
            "id": "413131119",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "随时随地。",
            "nextDialogs": [
              "413131120"
            ]
          },
          "413131120": {
            "id": "413131120",
            "speakerId": 1000,
            "speakerName": "魈",
            "text": "不论是你，还是璃月。所有的灯火，所有祈求平安的愿望，我都已经听到了。"
          }
        }
      }

    {
      "subId": "7418702",
      "subQuestName": "(test)石像对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741870701"
        ],
        "dialogs": {
          "741870701": {
            "id": "741870701",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "好吧…您说的没错，我们的所作所为确实需要重新考虑。但我也不知道为什么会变成这样…",
            "nextDialogs": [
              "741870702"
            ]
          },
          "741870702": {
            "id": "741870702",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "自从战争爆发以来，我的心中总有一种奇怪的感觉。",
            "nextDialogs": [
              "741870703"
            ]
          },
          "741870703": {
            "id": "741870703",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "我们追求的本应是自由与幸福，但「福波斯」却一步一步将我们引向了这里…",
            "nextDialogs": [
              "741870704"
            ]
          },
          "741870704": {
            "id": "741870704",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "到底出了什么问题呢？",
            "nextDialogs": [
              "741870705"
            ]
          },
          "741870705": {
            "id": "741870705",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "如果你们回去的时候能面见至尊大人的话，也请将这里的情况，我们的疑惑禀报给他吧。",
            "nextDialogs": [
              "741870706"
            ]
          },
          "741870706": {
            "id": "741870706",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "拜托你们了。",
            "nextDialogs": [
              "741870707"
            ]
          },
          "741870707": {
            "id": "741870707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯，我们当然会的！"
          }
        }
      }
    },

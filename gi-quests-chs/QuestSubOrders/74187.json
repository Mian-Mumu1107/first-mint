    {
      "subId": "7418706",
      "subQuestName": "(test)与埃斯特对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741870901"
        ],
        "dialogs": {
          "741870901": {
            "id": "741870901",
            "speakerId": 1002,
            "speakerName": "埃斯特",
            "text": "看样子，刚才的问题您应该已经成功解决了。",
            "nextDialogs": [
              "741870902"
            ]
          },
          "741870902": {
            "id": "741870902",
            "speakerId": 1002,
            "speakerName": "埃斯特",
            "text": "那么，接下来您也要奔赴新的目标了吧。",
            "nextDialogs": [
              "741870903"
            ]
          },
          "741870903": {
            "id": "741870903",
            "speakerId": 1003,
            "speakerName": "小呜斯",
            "text": "嗯，埃斯特，这里的事情就拜托你了…",
            "nextDialogs": [
              "741870904"
            ]
          },
          "741870904": {
            "id": "741870904",
            "speakerId": 1003,
            "speakerName": "小呜斯",
            "text": "以及，比起将评判对错的准绳交给「福波斯」或是某位调律师，更重要的是相信自己内心的判断。",
            "nextDialogs": [
              "741870905"
            ]
          },
          "741870905": {
            "id": "741870905",
            "speakerId": 1003,
            "speakerName": "小呜斯",
            "text": "至尊创造「福波斯」是为了使我们摆脱命运的奴役，但公民们的盲从却会让我们陷入更可怕的奴役当中。",
            "nextDialogs": [
              "741870906"
            ]
          },
          "741870906": {
            "id": "741870906",
            "speakerId": 1003,
            "speakerName": "小呜斯",
            "text": "未来你或许还会遇到这样的选择，等到那个时候，希望你也能做出正确的决定。",
            "nextDialogs": [
              "741870907"
            ]
          },
          "741870907": {
            "id": "741870907",
            "speakerId": 1002,
            "speakerName": "埃斯特",
            "text": "卡西奥多大人，您怎么突然说起这些了…",
            "nextDialogs": [
              "741870908"
            ]
          },
          "741870908": {
            "id": "741870908",
            "speakerId": 1002,
            "speakerName": "埃斯特",
            "text": "不过，您的话我记住了，埃斯特当然会坚持自己内心中的正义。",
            "nextDialogs": [
              "741870909"
            ]
          },
          "741870909": {
            "id": "741870909",
            "speakerId": 1003,
            "speakerName": "小呜斯",
            "text": "这样就好，那么就暂别了，我想我们还会再见的。"
          }
        }
      }
    },
    {
      "subId": "7418707",
      "subQuestName": "(test)成功分支检测用$HIDDEN",
      "sceneId": null,

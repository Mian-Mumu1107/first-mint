    {
      "subId": "7418702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741870201"
        ],
        "dialogs": {
          "741870201": {
            "id": "741870201",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "喂，你这笨蛋！怎么还剩下这么多宝物在这里，磨磨蹭蹭地要搞到什么时候啊！",
            "nextDialogs": [
              "741870202"
            ]
          },
          "741870202": {
            "id": "741870202",
            "speakerId": 1004,
            "speakerName": "被称作「笨蛋」的家伙",
            "text": "不是啊，老大！这些宝藏实在是太重了啊，我们都已经搬了一整天了，结果还有这么多在这里…",
            "nextDialogs": [
              "741870203"
            ]
          },
          "741870203": {
            "id": "741870203",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "你长这么大块头干什么吃的啊！这些可是宝藏，重一点不是很正常吗！",
            "nextDialogs": [
              "741870204"
            ]
          },
          "741870204": {
            "id": "741870204",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "况且这些宝藏可都是我们从该死的蛮族手里「收缴」来的…",
            "nextDialogs": [
              "741870205"
            ]
          },
          "741870205": {
            "id": "741870205",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "哼，那些虫豸只配像猪狗一样生活，把宝藏留在他们手里，可就暴殄天物了啊！",
            "nextDialogs": [
              "741870206"
            ]
          },
          "741870206": {
            "id": "741870206",
            "speakerId": 1004,
            "speakerName": "被称作「笨蛋」的家伙",
            "text": "但是，要想把这些宝藏全都运回雷穆利亚的话，无论如何都得让上面再多派几艘船来啊。",
            "nextDialogs": [
              "741870207"
            ]
          },
          "741870207": {
            "id": "741870207",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "你是笨蛋吗！帝国的运输船怎么可能让我们拿来做这种事情！",
            "nextDialogs": [
              "741870208"
            ]
          },
          "741870208": {
            "id": "741870208",
            "speakerId": 1004,
            "speakerName": "被称作「笨蛋」的家伙",
            "text": "既然这样的话，就全部毁掉吧！不管怎样，一点都不能落到那些蛮族的手里！",
            "nextDialogs": [
              "741870209"
            ]
          },
          "741870209": {
            "id": "741870209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，这段对话总感觉似曾相识呢…",
            "nextDialogs": [
              "741870212"
            ]
          },
          "741870212": {
            "id": "741870212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对啊，之前被我们打跑的那群倒霉的冒险家，不是也说过类似的话吗？",
            "nextDialogs": [
              "741870213"
            ]
          },
          "741870213": {
            "id": "741870213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且感觉听起来比之前更过分了啊！",
            "nextDialogs": [
              "741870214"
            ]
          },
          "741870214": {
            "id": "741870214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难不成是那些家伙坐的船沉到了水里，然后他们也被变成了魔像？",
            "nextDialogs": [
              "741870215"
            ]
          },
          "741870215": {
            "id": "741870215",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不管怎么想也太邪门了！",
            "nextDialogs": [
              "741870216"
            ]
          },
          "741870216": {
            "id": "741870216",
            "speakerId": 1002,
            "speakerName": "埃斯特",
            "text": "你们是第九军团的人吗，在这里干什么？按照命令，第九军团应该已经撤回卡布狄斯堡了。",
            "nextDialogs": [
              "741870217"
            ]
          },
          "741870217": {
            "id": "741870217",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "喂，埃斯特，你可不要来坏我们的好事啊！",
            "nextDialogs": [
              "741870218"
            ]
          },
          "741870218": {
            "id": "741870218",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "反正对付这些蛮子比对付死鱼还要容易，让我们在这里多玩一会也没什么所谓吧。",
            "nextDialogs": [
              "741870219"
            ]
          },
          "741870219": {
            "id": "741870219",
            "speakerId": 1002,
            "speakerName": "埃斯特",
            "text": "这些财物…唉，我不知道统辖你们的调律师是如何命令你们的。",
            "nextDialogs": [
              "741870220"
            ]
          },
          "741870220": {
            "id": "741870220",
            "speakerId": 1002,
            "speakerName": "埃斯特",
            "text": "但至尊命我们征服这些无知的部族，是为了砸碎束缚他们的，命运的镣铐。而你们的所为…毫无疑问是犯罪行为。",
            "nextDialogs": [
              "741870221"
            ]
          },
          "741870221": {
            "id": "741870221",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "哈？我们的长官，伟大的波爱修斯大人可是命令我们要狠狠惩罚这些蛮族啊。",
            "nextDialogs": [
              "741870222"
            ]
          },
          "741870222": {
            "id": "741870222",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "况且我们没有受到任何惩罚，那就说明无论是「福波斯」还是至尊陛下都默认了我们的行动。",
            "nextDialogs": [
              "741870223"
            ]
          },
          "741870223": {
            "id": "741870223",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "你却在这胡说什么犯罪…是故意想找茬吗？",
            "nextDialogs": [
              "741870224"
            ]
          },
          "741870224": {
            "id": "741870224",
            "speakerId": 1002,
            "speakerName": "埃斯特",
            "text": "但是…",
            "nextDialogs": [
              "741870225"
            ]
          },
          "741870225": {
            "id": "741870225",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，看起来这里也有个埃斯特呢，事情变得越来越奇怪了！",
            "nextDialogs": [
              "741870226"
            ]
          },
          "741870226": {
            "id": "741870226",
            "speakerId": 1003,
            "speakerName": "小呜斯",
            "text": "看来现在就是解答之前那个问题的时机了。",
            "nextDialogs": [
              "741870227"
            ]
          },
          "741870227": {
            "id": "741870227",
            "speakerId": 1003,
            "speakerName": "小呜斯",
            "text": "你们在镇上遇见的那个埃斯特，就是我们雷穆利亚人的后裔。当初他的祖先跟随我加入了新的国家，成为了普通的枫丹人。",
            "nextDialogs": [
              "741870228"
            ]
          },
          "741870228": {
            "id": "741870228",
            "speakerId": 1003,
            "speakerName": "小呜斯",
            "text": "因此，夺走了枫丹人灵魂的「乐章」对他无效。相对的，记录了他祖先记忆的旋律，则因为无处可去而附着到了那具雕像之上。",
            "nextDialogs": [
              "741870229"
            ]
          },
          "741870229": {
            "id": "741870229",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "照这么说，这里的埃斯特其实是镇上那个埃斯特的祖先，真正的「机智的埃斯特」？那其他人呢？",
            "nextDialogs": [
              "741870230"
            ]
          },
          "741870230": {
            "id": "741870230",
            "speakerId": 1003,
            "speakerName": "小呜斯",
            "text": "都是因为迷失在过去的记忆里而徘徊于此的灵魂罢了，我们过去看看吧。",
            "nextDialogs": [
              "741870231"
            ]
          },
          "741870231": {
            "id": "741870231",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "你们和呜斯先生一起走上前去…",
            "nextDialogs": [
              "741870232"
            ]
          },
          "741870232": {
            "id": "741870232",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你好呀，埃斯特。",
            "nextDialogs": [
              "741870233"
            ]
          },
          "741870233": {
            "id": "741870233",
            "speakerId": 1002,
            "speakerName": "埃斯特",
            "text": "嗯，你们好，你们是什么人？",
            "nextDialogs": [
              "741870234"
            ]
          },
          "741870234": {
            "id": "741870234",
            "speakerId": 1002,
            "speakerName": "埃斯特",
            "text": "看起来不是雷穆利亚人啊，该不会是蛮族？"
          }
        }
      }
    },
    {
      "subId": "7418706",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741870601"
        ],
        "dialogs": {
          "741870601": {
            "id": "741870601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咳咳，第九军团的士兵们。",
            "nextDialogs": [
              "741870602"
            ]
          },
          "741870602": {
            "id": "741870602",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "嗯？你们又是什么人，该不会是那个埃斯特找来的帮手吧。",
            "nextDialogs": [
              "741870604",
              "741870606",
              "741870608"
            ]
          },
          "741870604": {
            "id": "741870604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不是普通的帮手，是很强的帮手！我们是跟着卡西奥多大人一起来的。",
            "nextDialogs": [
              "741870609"
            ]
          },
          "741870609": {
            "id": "741870609",
            "speakerId": 1003,
            "speakerName": "小呜斯",
            "text": "#（看来{NICKNAME}和派蒙也颇有演剧的天分呢。）",
            "nextDialogs": [
              "741870610"
            ]
          },
          "741870610": {
            "id": "741870610",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "嗯…卡西奥多大人吗，我听说伟大的至尊将他派往了埃雷莫利卡，难道这么快就回来了？",
            "nextDialogs": [
              "741870611"
            ]
          },
          "741870611": {
            "id": "741870611",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个嘛，其实我们旁边这只就是…",
            "nextDialogs": [
              "741870612"
            ]
          },
          "741870612": {
            "id": "741870612",
            "speakerId": 1003,
            "speakerName": "小呜斯",
            "text": "……",
            "nextDialogs": [
              "741870613"
            ]
          },
          "741870613": {
            "id": "741870613",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咳，总之，我们是过来视察前线军团的情况的！",
            "nextDialogs": [
              "741870614"
            ]
          },
          "741870614": {
            "id": "741870614",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "好吧，我猜也是这样。",
            "nextDialogs": [
              "741870615"
            ]
          },
          "741870615": {
            "id": "741870615",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "虽然我们没有跟随大部队一起前往卡布狄斯堡…",
            "nextDialogs": [
              "741870616"
            ]
          },
          "741870616": {
            "id": "741870616",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "但作为殿后，留在这里完成最后的「清理」工作，也算是合情合理吧！",
            "nextDialogs": [
              "741870617"
            ]
          },
          "741870617": {
            "id": "741870617",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这也是「福波斯」的命令吗？",
            "nextDialogs": [
              "741870618"
            ]
          },
          "741870618": {
            "id": "741870618",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "这个嘛…「福波斯」本应指引我们的一切行动，但自从来到这里之后，我们却常常无法接收到「福波斯」的旋律。",
            "nextDialogs": [
              "741870619"
            ]
          },
          "741870619": {
            "id": "741870619",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "因此，我们只能按照波爱修斯大人的指示来行动了。"
          },
          "741870606": {
            "id": "741870606",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "特遣官是什么…喔，也没错啦，我们是跟着卡西奥多大人一起来的。"
          },
          "741870608": {
            "id": "741870608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错，我们可是卡西奥多大人的侍从呢！"
          }
        }
      }
    },
    {
      "subId": "7418708",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

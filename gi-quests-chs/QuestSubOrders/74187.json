        ],
        "dialogs": {
          "741870801": {
            "id": "741870801",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "话说回来，你这家伙，该不会是狡猾的蛮族假扮的，在这里妖言惑众想要诓骗我等吧！",
            "nextDialogs": [
              "741870802"
            ]
          },
          "741870802": {
            "id": "741870802",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "该死的虫豸，给我受死吧！"
          }
        }
      }
    },
    {
      "subId": "7418710",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741871001"
        ],
        "dialogs": {
          "741871001": {
            "id": "741871001",
            "speakerId": 1002,
            "speakerName": "埃斯特",
            "text": "那些人无论如何也是我们军团的成员，请尽量用和平的方式解决吧。"
          }
        }
      }
    },
    {
      "subId": "7418711",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741871101"
        ],
        "dialogs": {
          "741871101": {
            "id": "741871101",
            "speakerId": 1002,
            "speakerName": "埃斯特",
            "text": "神王在上，多亏了卡西奥多大人。无论如何，总算是暂时解决了。"
          }
        }
      }
    },
    {
      "subId": "7418712",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741871201"
        ],
        "dialogs": {
          "741871201": {
            "id": "741871201",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "「福波斯」是绝对完美的造物，作为雷穆利亚人，我劝你还是不要质疑为好。",
            "nextDialogs": [
              "741871203",
              "741871205"
            ]
          },
          "741871203": {
            "id": "741871203",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "你是在和我讨论哲学吗，这话你应该去和王城里那些博学的乐师说。军人的天职是服从命令，太复杂的问题我可搞不懂…"
          },
          "741871205": {
            "id": "741871205",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "确实…确实有这样的可能，我竟然没有考虑到。难道是因为我们的肆意妄为才导致「福波斯」不再给予我们指引？",
            "nextDialogs": [
              "741871206"
            ]
          },
          "741871206": {
            "id": "741871206",
            "speakerId": 1000,
            "speakerName": "领头的家伙",
            "text": "要是这样的话可就糟了，唔…"
          }
        }
      }
    }
  ]

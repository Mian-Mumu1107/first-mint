  },
  "subQuests": [
    {
      "subId": "7327901",
      "subQuestName": "(test)隐藏：与马塞拉对话领取任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732790101"
        ],
        "dialogs": {
          "732790101": {
            "id": "732790101",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "#啊，{NICKNAME}，尊贵的「镇灵主人」，大驾光临，令我受宠若惊。",
            "nextDialogs": [
              "732790102"
            ]
          },
          "732790102": {
            "id": "732790102",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "好呀，又是一个沙漠奴才。我的大人…唉，算了，您有您自己的判断，我相信您就是了。",
            "nextDialogs": [
              "732790103"
            ]
          },
          "732790103": {
            "id": "732790103",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "不知您是否有闲暇赏光…我如同企盼明月和雨露一般，企望您的到来。",
            "nextDialogs": [
              "732790104"
            ]
          },
          "732790104": {
            "id": "732790104",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "无事献殷勤，必不怀好意，你不如说得明白些。",
            "nextDialogs": [
              "732790105"
            ]
          },
          "732790105": {
            "id": "732790105",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "很好，镇灵大人…我的确有事相求。",
            "nextDialogs": [
              "732790106"
            ]
          },
          "732790106": {
            "id": "732790106",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "哈哈，没什么大事…是我的猎鹰，塔德菈…她应该是遇险了。",
            "nextDialogs": [
              "732790107"
            ]
          },
          "732790107": {
            "id": "732790107",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "唉…如果不是因为我的腿脚不行，也就不用麻烦您了。",
            "nextDialogs": [
              "732790108"
            ]
          },
          "732790108": {
            "id": "732790108",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我明白了，所以我们要去救她，然后你会谢谢我们，给我们好多摩拉，我们再去大吃一顿庆祝胜利！对吧？",
            "nextDialogs": [
              "732790109"
            ]
          },
          "732790109": {
            "id": "732790109",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "呃…是的，是的。",
            "nextDialogs": [
              "732790110"
            ]
          },
          "732790110": {
            "id": "732790110",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "如果是这样的话，就交给我们好啦！",
            "nextDialogs": [
              "732790111"
            ]
          },
          "732790111": {
            "id": "732790111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "每到这种时候，逻辑就格外清晰呢…",
            "nextDialogs": [
              "732790112"
            ]
          },
          "732790112": {
            "id": "732790112",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "唉…那就这样吧，为了这贪婪的小家伙能大吃一顿。",
            "nextDialogs": [
              "732790113"
            ]
          },
          "732790113": {
            "id": "732790113",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "万分感谢…那么这件事就拜托给您了。",
            "nextDialogs": [
              "732790114"
            ]
          },
          "732790114": {
            "id": "732790114",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "啊…她最后出现的地点，在这里，请让我为您标出来…",
            "nextDialogs": [
              "732790115"
            ]
          },
          "732790115": {
            "id": "732790115",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "你们要找的人，塔德菈…她的个子很高，肤色黝黑，留着浅色的长发，手持长弓…嗯，这些信息应该够了。",
            "nextDialogs": [
              "732790116"
            ]
          },
          "732790116": {
            "id": "732790116",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "怎么样，你们记住了吗？",
            "nextDialogs": [
              "732790117"
            ]
          },
          "732790117": {
            "id": "732790117",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯…高个子，深色皮肤的女孩子，浅色长发，还拿着长弓！嘿嘿，我记性很好的！",
            "nextDialogs": [
              "732790118"
            ]
          },
          "732790118": {
            "id": "732790118",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "嗯…愿流风引导您穿越黄沙，避开重重险阻。",
            "nextDialogs": [
              "732790119"
            ]
          },
          "732790119": {
            "id": "732790119",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好，我们走啦！"
          }
        }
      }
    },
    {
      "subId": "7327902",
      "subQuestName": "前往塔德菈最后出现的地方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732790201"
        ],
        "dialogs": {
          "732790201": {
            "id": "732790201",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "怎么，你们找到她了？",
            "nextDialogs": [
              "732790202"
            ]
          },
          "732790202": {
            "id": "732790202",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "啊，还需要时间，是吧…",
            "nextDialogs": [
              "732790203"
            ]
          },
          "732790203": {
            "id": "732790203",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "那么还要劳烦你们尽快救出塔德菈…时间不等人呀。"
          }
        }
      }
    },
    {
      "subId": "7327903",
      "subQuestName": "深入探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7327904",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732790401"
        ],
        "dialogs": {
          "732790401": {
            "id": "732790401",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嘘…！你看…有人在那边…！",
            "nextDialogs": [
              "732790402"
            ]
          },
          "732790402": {
            "id": "732790402",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "哦…我的大人，这些人…就是此前你们曾反复提及的「蠢人众」吧？",
            "nextDialogs": [
              "732790403"
            ]
          },
          "732790403": {
            "id": "732790403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是「愚人众」…",
            "nextDialogs": [
              "732790404"
            ]
          },
          "732790404": {
            "id": "732790404",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "有区别吗？",
            "nextDialogs": [
              "732790405"
            ]
          },
          "732790405": {
            "id": "732790405",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你小声一点啦！万一被发现了…",
            "nextDialogs": [
              "732790406"
            ]
          },
          "732790406": {
            "id": "732790406",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "没关系的，他们听不到我说话。不信你们看…",
            "nextDialogs": [
              "732790407"
            ]
          },
          "732790407": {
            "id": "732790407",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "喂！大胖子！我在这边！开饭了，开饭了！",
            "nextDialogs": [
              "732790408"
            ]
          },
          "732790408": {
            "id": "732790408",
            "speakerId": 1003,
            "speakerName": "愚人众先遣队员甲",
            "text": "嗯…？你听到什么了吗？",
            "nextDialogs": [
              "732790409"
            ]
          },
          "732790409": {
            "id": "732790409",
            "speakerId": 1004,
            "speakerName": "愚人众先遣队员乙",
            "text": "没有，怎么了？",
            "nextDialogs": [
              "732790410"
            ]
          },
          "732790410": {
            "id": "732790410",
            "speakerId": 1003,
            "speakerName": "愚人众先遣队员甲",
            "text": "唔…我还以为开饭了呢。",
            "nextDialogs": [
              "732790411"
            ]
          },
          "732790411": {
            "id": "732790411",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "哼哼，看吧？",
            "nextDialogs": [
              "732790412"
            ]
          },
          "732790412": {
            "id": "732790412",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "利露帕尔也会玩这种小孩子把戏呀…嘿嘿，总觉得有点可爱呢！",
            "nextDialogs": [
              "732790413"
            ]
          },
          "732790413": {
            "id": "732790413",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你看…那边！他们关押的那个是不是塔德菈呀！",
            "nextDialogs": [
              "732790414"
            ]
          },
          "732790414": {
            "id": "732790414",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔我记得她…个子很高，肤色黝黑，留着浅色的长发…应该就是她了。",
            "nextDialogs": [
              "732790415"
            ]
          },
          "732790415": {
            "id": "732790415",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "记性不错嘛，小家伙。我们动手吧，我的大人。",
            "nextDialogs": [
              "732790416"
            ]
          },
          "732790416": {
            "id": "732790416",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#好，{NICKNAME}，我们动手吧！"
          }
        }
      }
    },
    {
      "subId": "7327905",
      "subQuestName": "击败愚人众",
      "sceneId": null,
      "locations": [],

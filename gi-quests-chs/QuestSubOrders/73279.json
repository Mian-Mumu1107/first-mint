    {
      "subId": "7327906",
      "subQuestName": "与塔德菈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732790601"
        ],
        "dialogs": {
          "732790601": {
            "id": "732790601",
            "speakerId": 1005,
            "speakerName": "塔德菈",
            "text": "……",
            "nextDialogs": [
              "732790602"
            ]
          },
          "732790602": {
            "id": "732790602",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那个…你就是塔德菈吗？我们是来救你的！",
            "nextDialogs": [
              "732790603"
            ]
          },
          "732790603": {
            "id": "732790603",
            "speakerId": 1005,
            "speakerName": "塔德菈",
            "text": "嗯…？嗯。",
            "nextDialogs": [
              "732790604"
            ]
          },
          "732790604": {
            "id": "732790604",
            "speakerId": 1005,
            "speakerName": "塔德菈",
            "text": "你把他们放走了。",
            "nextDialogs": [
              "732790607"
            ]
          },
          "732790607": {
            "id": "732790607",
            "speakerId": 1005,
            "speakerName": "塔德菈",
            "text": "…他们会回去，告诉其他人。这样他们都会知道我们在这里。",
            "nextDialogs": [
              "732790608"
            ]
          },
          "732790608": {
            "id": "732790608",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "你看，智者所见略同。我喜欢这女孩。",
            "nextDialogs": [
              "732790609"
            ]
          },
          "732790609": {
            "id": "732790609",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那些不要紧啦！他们再来，我们就再把他们打跑！不过你受伤了…需要我们帮忙吗？",
            "nextDialogs": [
              "732790610"
            ]
          },
          "732790610": {
            "id": "732790610",
            "speakerId": 1005,
            "speakerName": "塔德菈",
            "text": "我还好，还能走，还能找个地方自己死去。",
            "nextDialogs": [
              "732790611"
            ]
          },
          "732790611": {
            "id": "732790611",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哦…那还好啦，她还能找个地方——喂，一点也不好吧！",
            "nextDialogs": [
              "732790612"
            ]
          },
          "732790612": {
            "id": "732790612",
            "speakerId": 1005,
            "speakerName": "塔德菈",
            "text": "我开玩笑的。",
            "nextDialogs": [
              "732790613"
            ]
          },
          "732790613": {
            "id": "732790613",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "哈哈。",
            "nextDialogs": [
              "732790614"
            ]
          },
          "732790614": {
            "id": "732790614",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "我喜欢这女孩的幽默感…若有似无的。",
            "nextDialogs": [
              "732790615"
            ]
          },
          "732790615": {
            "id": "732790615",
            "speakerId": 1005,
            "speakerName": "塔德菈",
            "text": "谢谢你们，我们回去吧。"
          }
        }
      }
    },
    {
      "subId": "7327907",
      "subQuestName": "与马塞拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732790701"
        ],
        "dialogs": {
          "732790701": {
            "id": "732790701",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "啊，我的小猎鹰回来了！谢谢你们！",
            "nextDialogs": [
              "732790702"
            ]
          },
          "732790702": {
            "id": "732790702",
            "speakerId": 1005,
            "speakerName": "塔德菈",
            "text": "抱歉…我遭到了伏击，多亏他们相救，我才能回来见您。",
            "nextDialogs": [
              "732790703"
            ]
          },
          "732790703": {
            "id": "732790703",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "「他们」…？是我们尊贵的「镇灵主人」！",
            "nextDialogs": [
              "732790704"
            ]
          },
          "732790704": {
            "id": "732790704",
            "speakerId": 1005,
            "speakerName": "塔德菈",
            "text": "对不起…",
            "nextDialogs": [
              "732790705"
            ]
          },
          "732790705": {
            "id": "732790705",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没关系，没关系啦！塔德菈受伤了，你也对她好些嘛！",
            "nextDialogs": [
              "732790706"
            ]
          },
          "732790706": {
            "id": "732790706",
            "speakerId": 1005,
            "speakerName": "塔德菈",
            "text": "……",
            "nextDialogs": [
              "732790707"
            ]
          },
          "732790707": {
            "id": "732790707",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "…你受伤了？",
            "nextDialogs": [
              "732790708"
            ]
          },
          "732790708": {
            "id": "732790708",
            "speakerId": 1005,
            "speakerName": "塔德菈",
            "text": "…对不起。",
            "nextDialogs": [
              "732790709"
            ]
          },
          "732790709": {
            "id": "732790709",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "是什么动物把你搞成这样的？是人？",
            "nextDialogs": [
              "732790710"
            ]
          },
          "732790710": {
            "id": "732790710",
            "speakerId": 1005,
            "speakerName": "塔德菈",
            "text": "是北方人，我遭到了北方人的伏击…他们发现自己被跟踪了，就设下埋伏…",
            "nextDialogs": [
              "732790711"
            ]
          },
          "732790711": {
            "id": "732790711",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "设下埋伏的应该是你才对。",
            "nextDialogs": [
              "732790712"
            ]
          },
          "732790712": {
            "id": "732790712",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "被猎物反咬成这个样子，对猎鹰来说，像什么样子…",
            "nextDialogs": [
              "732790713"
            ]
          },
          "732790713": {
            "id": "732790713",
            "speakerId": 1005,
            "speakerName": "塔德菈",
            "text": "……",
            "nextDialogs": [
              "732790714"
            ]
          },
          "732790714": {
            "id": "732790714",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "…去休息吧，你需要休息。稍后我会为你疗伤。",
            "nextDialogs": [
              "732790715"
            ]
          },
          "732790715": {
            "id": "732790715",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "塔德菈只是默默点点头，忍着疼痛缓步离开了。",
            "nextDialogs": [
              "732790716"
            ]
          },
          "732790716": {
            "id": "732790716",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "马塞拉对塔德菈有点苛刻呢…",
            "nextDialogs": [
              "732790718",
              "732790721"
            ]
          },
          "732790718": {
            "id": "732790718",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "嗯？不，怎么会呢！她是我最爱的「猎鹰」…我爱她，但不溺爱她。猎鹰没有给你带回猎物的话，怎么能喂饱它呢？",
            "nextDialogs": [
              "732790719"
            ]
          },
          "732790719": {
            "id": "732790719",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "原来是这样…哼，那女孩不会有好结果的。",
            "nextDialogs": [
              "732790723"
            ]
          },
          "732790723": {
            "id": "732790723",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "这些报酬请您一定收下，感谢您，尊贵的「镇灵主人」。",
            "nextDialogs": [
              "732790724"
            ]
          },
          "732790724": {
            "id": "732790724",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "咳咳，你是不是忘了什么？这里还有两个人呢？",
            "nextDialogs": [
              "732790725"
            ]
          },
          "732790725": {
            "id": "732790725",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嘿嘿，其中一个也不算「人」吧…",
            "nextDialogs": [
              "732790726"
            ]
          },
          "732790726": {
            "id": "732790726",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "哦…我忘了，这个小精灵不是人。不过我们也应该得到感谢吧？",
            "nextDialogs": [
              "732790727"
            ]
          },
          "732790727": {
            "id": "732790727",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喂——！",
            "nextDialogs": [
              "732790728"
            ]
          },
          "732790728": {
            "id": "732790728",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "哈哈，抱歉、抱歉，请您收下额外的报酬。",
            "nextDialogs": [
              "732790729"
            ]
          },
          "732790729": {
            "id": "732790729",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "还有额外的报酬！",
            "nextDialogs": [
              "732790730"
            ]
          },
          "732790730": {
            "id": "732790730",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "…仍是不多，不过既然我的大人没什么意见，那就这样吧。",
            "nextDialogs": [
              "732790731"
            ]
          },
          "732790731": {
            "id": "732790731",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "很好，啊…希望有时间的话，您能再来一趟…我想，我的「猎鹰」仍然需要您的帮助。"
          },
          "732790721": {
            "id": "732790721",
            "speakerId": 1000,
            "speakerName": "马塞拉",
            "text": "苛待？不，我太纵容她了，她的本领退步了…我只是在教育她而已，她是个优秀的「猎鹰」，我怎会忍心伤害她呢。",
            "nextDialogs": [
              "732790722"
            ]
          },
          "732790722": {
            "id": "732790722",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "那么猎鹰的结局，往往是什么样呢…"
          }
        }
      }
    },

        "dialogs": {
          "732799901": {
            "id": "732799901",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "塔德菈不在这里呢…我们再往前找找吧？",
            "nextDialogs": [
              "732799902"
            ]
          },
          "732799902": {
            "id": "732799902",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "你看，这里有很多脚印，看来盘踞在这座洞里的家伙直到最近还很活跃…哼，这么不谨慎吗？",
            "nextDialogs": [
              "732799903"
            ]
          },
          "732799903": {
            "id": "732799903",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "有道理呢，我们也进去调查一下吧！",
            "nextDialogs": [
              "732799904"
            ]
          },
          "732799904": {
            "id": "732799904",
            "speakerId": 1003,
            "speakerName": "愚人众先遣队员甲",
            "text": "放弃据点，撤退！我们撤退！",
            "nextDialogs": [
              "732799905"
            ]
          },
          "732799905": {
            "id": "732799905",
            "speakerId": 1001,
            "speakerName": "利露帕尔",
            "text": "他们逃走了，唉…为何如此心慈手软呢，我的大人？"
          }
        }
      }
    }
  ]

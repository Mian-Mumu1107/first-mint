        "startDialogs": [
          "752390301"
        ],
        "dialogs": {
          "752390301": {
            "id": "752390301",
            "speakerId": 1000,
            "speakerName": "卡内",
            "text": "这位客人，你简直就是扎卡那小子的人生榜样，不仅找来了玩偶，还在这么短的时间里完成了上色。",
            "nextDialogs": [
              "752390302"
            ]
          },
          "752390302": {
            "id": "752390302",
            "speakerId": 1000,
            "speakerName": "卡内",
            "text": "等他回来，我一定要叫他向你好好学习。请别推辞，收下这些酬劳吧！"
          }
        }
      }
    },
    {
      "subId": "7523901",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752390101"
        ],
        "dialogs": {
          "752390101": {
            "id": "752390101",
            "speakerId": 1000,
            "speakerName": "卡内",
            "text": "扎卡那小子…活不干完就旷工了，那些玩偶也不知道放哪去了。我非得投诉他不可！",
            "nextDialogs": [
              "752390102"
            ]
          },
          "752390102": {
            "id": "752390102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么玩偶？",
            "nextDialogs": [
              "752390103"
            ]
          },
          "752390103": {
            "id": "752390103",
            "speakerId": 1000,
            "speakerName": "卡内",
            "text": "是一些以鳍游龙为原型的小玩偶，我在给它们上色。",
            "nextDialogs": [
              "752390104"
            ]
          },
          "752390104": {
            "id": "752390104",
            "speakerId": 1000,
            "speakerName": "卡内",
            "text": "但是我的徒弟扎卡最近没来上班，他手上还有三个没上色的半成品玩偶，也不知道被他放去哪里了。",
            "nextDialogs": [
              "752390105"
            ]
          },
          "752390105": {
            "id": "752390105",
            "speakerId": 1000,
            "speakerName": "卡内",
            "text": "这位客人，你能帮我找一找它们吗？我想应该就在附近。"
          }
        }
      }
    },
    {
      "subId": "7523904",

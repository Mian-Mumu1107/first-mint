  "subQuests": [
    {
      "subId": "4015401",
      "subQuestName": "返回店铺",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401540101"
        ],
        "dialogs": {
          "401540101": {
            "id": "401540101",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "经过这段时间的努力经营，炼金店铺的营业额达到了比预期中更高的数据…",
            "nextDialogs": [
              "401540102"
            ]
          },
          "401540102": {
            "id": "401540102",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "哎呀，想不到短短一段时间，小可爱居然能把营业额提升到这个程度…",
            "nextDialogs": [
              "401540103"
            ]
          },
          "401540103": {
            "id": "401540103",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "莫非你是商业天才吗？",
            "nextDialogs": [
              "401540105",
              "401540108"
            ]
          },
          "401540105": {
            "id": "401540105",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "呵呵，你还是那么谦虚。",
            "nextDialogs": [
              "401540106"
            ]
          },
          "401540106": {
            "id": "401540106",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "得到这么厉害的成果，可以再自豪一点的哦。",
            "nextDialogs": [
              "401540109"
            ]
          },
          "401540109": {
            "id": "401540109",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "要是能把你留在身边当助手，我的假期应该能再增加一倍吧。",
            "nextDialogs": [
              "401540110"
            ]
          },
          "401540110": {
            "id": "401540110",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "现阶段收集到的销售数据已经足够了。这段时间辛苦你们啦。",
            "nextDialogs": [
              "401540111"
            ]
          },
          "401540111": {
            "id": "401540111",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "当然，如果你愿意继续帮忙照看店铺，姐姐也会很高兴哦。",
            "nextDialogs": [
              "401540112"
            ]
          },
          "401540112": {
            "id": "401540112",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "这下，我也能跟琴交差了，呵呵…",
            "nextDialogs": [
              "401540113"
            ]
          },
          "401540113": {
            "id": "401540113",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "#{NICKNAME}，派蒙，好久不见。",
            "nextDialogs": [
              "401540114"
            ]
          },
          "401540114": {
            "id": "401540114",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "琴团长！",
            "nextDialogs": [
              "401540115"
            ]
          },
          "401540115": {
            "id": "401540115",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "你来了，我正想着跟小可爱交接完工作，就回骑士团找你呢。",
            "nextDialogs": [
              "401540116"
            ]
          },
          "401540116": {
            "id": "401540116",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "嗯，我已经从其他骑士那里了解了大致情况。",
            "nextDialogs": [
              "401540117"
            ]
          },
          "401540117": {
            "id": "401540117",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "#想不到，这次你也让{NICKNAME}来帮忙了。",
            "nextDialogs": [
              "401540118"
            ]
          },
          "401540118": {
            "id": "401540118",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "哎呀，这种重要的工作要想取得突破，精明能干的合作伙伴是不可或缺的。",
            "nextDialogs": [
              "401540119"
            ]
          },
          "401540119": {
            "id": "401540119",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "你看，只有我的话可达不到这样的效率呢。",
            "nextDialogs": [
              "401540120"
            ]
          },
          "401540120": {
            "id": "401540120",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "确实，你们的成绩非常惊人。",
            "nextDialogs": [
              "401540121"
            ]
          },
          "401540121": {
            "id": "401540121",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "本想将其他事务安排妥当之后就过来看看你们的情况，却一直抽不出时间…至少我想亲口表达对你们的感谢。"
          },
          "401540108": {
            "id": "401540108",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "嗯，你的学习能力果然非常强呢。"
          }
        }
      }
    },

        "dialogs": {
          "412140101": {
            "id": "412140101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "又来了哦！又是我们哦！",
            "nextDialogs": [
              "412140102"
            ]
          },
          "412140102": {
            "id": "412140102",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "旅行者，派蒙。你们来了。",
            "nextDialogs": [
              "412140103"
            ]
          },
          "412140103": {
            "id": "412140103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "已经习惯像这样和阿贝多见面了呢。",
            "nextDialogs": [
              "412140106"
            ]
          },
          "412140106": {
            "id": "412140106",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "非常感谢，找你果然是正确的选择。",
            "nextDialogs": [
              "412140107"
            ]
          },
          "412140107": {
            "id": "412140107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "帮上你的忙了吗？",
            "nextDialogs": [
              "412140108"
            ]
          },
          "412140108": {
            "id": "412140108",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "当然，你对我的研究工作给予了极大帮助。",
            "nextDialogs": [
              "412140109"
            ]
          },
          "412140109": {
            "id": "412140109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，你知道就好~",
            "nextDialogs": [
              "412140110"
            ]
          },
          "412140110": {
            "id": "412140110",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "这份恩情我会牢记在心。",
            "nextDialogs": [
              "412140111"
            ]
          },
          "412140111": {
            "id": "412140111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这把剑还给你。",
            "nextDialogs": [
              "412140112"
            ]
          },
          "412140112": {
            "id": "412140112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "应该足够强了吧？",
            "nextDialogs": [
              "412140113"
            ]
          },
          "412140113": {
            "id": "412140113",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "差不多了。你身体感觉如何？",
            "nextDialogs": [
              "412140114"
            ]
          },
          "412140114": {
            "id": "412140114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "和平时一样。",
            "nextDialogs": [
              "412140115"
            ]
          },
          "412140115": {
            "id": "412140115",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "那就行，没有副作用，也没有污染和毒。",
            "nextDialogs": [
              "412140116"
            ]
          },
          "412140116": {
            "id": "412140116",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "看来…我的认知是正确的。",
            "nextDialogs": [
              "412140117"
            ]
          },
          "412140117": {
            "id": "412140117",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "摆出了一副料事如神的表情呢，这家伙！",
            "nextDialogs": [
              "412140118"
            ]
          },
          "412140118": {
            "id": "412140118",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "剑好用吗？"
          }
        }
      }

    {
      "subId": "37501",
      "subQuestName": "与温迪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3750101"
        ],
        "dialogs": {
          "3750101": {
            "id": "3750101",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "唉，果然你也不行吗…",
            "nextDialogs": [
              "3750102"
            ]
          },
          "3750102": {
            "id": "3750102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "果、果然？",
            "nextDialogs": [
              "3750103"
            ]
          },
          "3750103": {
            "id": "3750103",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "#只是想看看{NICKNAME}作为骑士团超级新人，究竟够不够分量啦。",
            "nextDialogs": [
              "3750104"
            ]
          },
          "3750104": {
            "id": "3750104",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "你看，勇者顺手就取走了村子里名贵的宝剑——",
            "nextDialogs": [
              "3750105"
            ]
          },
          "3750105": {
            "id": "3750105",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "这不是非常适合传唱的故事吗？",
            "nextDialogs": [
              "3750106"
            ]
          },
          "3750106": {
            "id": "3750106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼，感觉你的比喻很失礼啊，吟游诗人。",
            "nextDialogs": [
              "3750107"
            ]
          },
          "3750107": {
            "id": "3750107",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "哎呀，你误会我了。这是对蒙德的失望，面对勇者却还要吝啬宝剑。",
            "nextDialogs": [
              "3750108"
            ]
          },
          "3750108": {
            "id": "3750108",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "那么，看来明借是行不通的，只能巧取了。",
            "nextDialogs": [
              "3750109"
            ]
          },
          "3750109": {
            "id": "3750109",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "今天我们充分尊重自由意志，你们说说喜欢怎样巧取？",
            "nextDialogs": [
              "3750110"
            ]
          },
          "3750110": {
            "id": "3750110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "3750111"
            ]
          },
          "3750111": {
            "id": "3750111",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "说吧，不要拘束，自由意志就是要畅所欲言。",
            "nextDialogs": [
              "3750112"
            ]
          },
          "3750112": {
            "id": "3750112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实我不想偷东西！",
            "nextDialogs": [
              "3750113"
            ]
          },
          "3750113": {
            "id": "3750113",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "啊哈哈，你看你，一开口就跑题了。",
            "nextDialogs": [
              "3750114"
            ]
          },
          "3750114": {
            "id": "3750114",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "认真地说，这件事你比我更适合去做。",
            "nextDialogs": [
              "3750115"
            ]
          },
          "3750115": {
            "id": "3750115",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "因为我除了唱歌，就没什么值得自信的长处了。",
            "nextDialogs": [
              "3750116"
            ]
          },
          "3750116": {
            "id": "3750116",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "而且我在蒙德无依无靠，被抓住了无人申冤，一定会从重处罚。",
            "nextDialogs": [
              "3750117"
            ]
          },
          "3750117": {
            "id": "3750117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "偷东西被抓住了也没什么冤枉吧。",
            "nextDialogs": [
              "3750118"
            ]
          },
          "3750118": {
            "id": "3750118",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "#但{NICKNAME}不同。你是为蒙德城作过贡献的，骑士团的明日之星。",
            "nextDialogs": [
              "3750119"
            ]
          },
          "3750119": {
            "id": "3750119",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "失手了以后好好解释一下，或许就能蒙混过去了。",
            "nextDialogs": [
              "3750120"
            ]
          },
          "3750120": {
            "id": "3750120",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不要一直以失手为前提啊！",
            "nextDialogs": [
              "3750121"
            ]
          },
          "3750121": {
            "id": "3750121",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "#{NICKNAME}…你觉得怎样？",
            "nextDialogs": [
              "3750122"
            ]
          },
          "3750122": {
            "id": "3750122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你刚才说自己是巴巴托斯。",
            "nextDialogs": [
              "3750123"
            ]
          },
          "3750123": {
            "id": "3750123",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "啊呀，好像是这么说过——",
            "nextDialogs": [
              "3750124"
            ]
          },
          "3750124": {
            "id": "3750124",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "所以呢？",
            "nextDialogs": [
              "3750125"
            ]
          },
          "3750125": {
            "id": "3750125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "如果你真是神，就不能放着不管。",
            "nextDialogs": [
              "3750126"
            ]
          },
          "3750126": {
            "id": "3750126",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "哦？这是为什么？",
            "nextDialogs": [
              "3750127"
            ]
          },
          "3750127": {
            "id": "3750127",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#有关{NICKNAME}的过去，以后再慢慢跟你说吧…",
            "nextDialogs": [
              "3750128"
            ]
          },
          "3750128": {
            "id": "3750128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "如果你不是神，我也会救特瓦林。",
            "nextDialogs": [
              "3750129"
            ]
          },
          "3750129": {
            "id": "3750129",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "…咦？"
          }
        }
      }
    },

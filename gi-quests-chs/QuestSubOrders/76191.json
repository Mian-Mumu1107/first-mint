    {
      "subId": "7619103",
      "subQuestName": "制止盗宝团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761910201"
        ],
        "dialogs": {
          "761910201": {
            "id": "761910201",
            "speakerId": 1001,
            "speakerName": "艾霍玛",
            "text": "三番五次提醒你，让你招子放亮点，这压箱底的尖货，可是至冬堡的熟客点名要的。",
            "nextDialogs": [
              "761910202"
            ]
          },
          "761910202": {
            "id": "761910202",
            "speakerId": 1001,
            "speakerName": "艾霍玛",
            "text": "得，你倒好，到我手下改吃素了还是怎么？突然就善心大发，给它放生了？",
            "nextDialogs": [
              "761910203"
            ]
          },
          "761910203": {
            "id": "761910203",
            "speakerId": 1002,
            "speakerName": "耶洛",
            "text": "大哥，你听我解释，这真怨不得我，是那丘丘人…",
            "nextDialogs": [
              "761910204"
            ]
          },
          "761910204": {
            "id": "761910204",
            "speakerId": 1001,
            "speakerName": "艾霍玛",
            "text": "丘丘人？亏你还好意思说呢！咱们盗宝团的招牌都要砸你手里了！",
            "nextDialogs": [
              "761910205"
            ]
          },
          "761910205": {
            "id": "761910205",
            "speakerId": 1002,
            "speakerName": "耶洛",
            "text": "打不过啊，大哥，真打不过！它们那一个蓝的一个绿的下手比债务处理人还狠…",
            "nextDialogs": [
              "761910206"
            ]
          },
          "761910206": {
            "id": "761910206",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "（这两个家伙看起来就是走私贩了…）",
            "nextDialogs": [
              "761910207"
            ]
          },
          "761910207": {
            "id": "761910207",
            "speakerId": 1001,
            "speakerName": "艾霍玛",
            "text": "…谁在那儿？！",
            "nextDialogs": [
              "761910208"
            ]
          },
          "761910208": {
            "id": "761910208",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "哎呀露米！还没到出场的时候呢！",
            "nextDialogs": [
              "761910209"
            ]
          },
          "761910209": {
            "id": "761910209",
            "speakerId": 1001,
            "speakerName": "艾霍玛",
            "text": "这是个什么玩意儿…看着挺稀罕。",
            "nextDialogs": [
              "761910210"
            ]
          },
          "761910210": {
            "id": "761910210",
            "speakerId": 1001,
            "speakerName": "艾霍玛",
            "text": "喂，小姑娘你总应付得来了吧？我看这货也够尖，就拿它替了吧。",
            "nextDialogs": [
              "761910211"
            ]
          },
          "761910211": {
            "id": "761910211",
            "speakerId": 1002,
            "speakerName": "耶洛",
            "text": "是。",
            "nextDialogs": [
              "761910212"
            ]
          },
          "761910212": {
            "id": "761910212",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "居然还想打露米的主意！盗宝团的名声就是被你们这种人败坏的…",
            "nextDialogs": [
              "761910213"
            ]
          },
          "761910213": {
            "id": "761910213",
            "speakerId": 1002,
            "speakerName": "耶洛",
            "text": "呃，盗宝团有什么名声？",
            "nextDialogs": [
              "761910214"
            ]
          },
          "761910214": {
            "id": "761910214",
            "speakerId": 1001,
            "speakerName": "艾霍玛",
            "text": "少跟她废话！"
          }
        }
      }
    },
    {
      "subId": "7619104",
      "subQuestName": "击败敌人",
      "sceneId": null,
      "locations": [],

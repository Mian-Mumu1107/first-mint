    {
      "subId": "7619108",
      "subQuestName": "调查豚兽",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761910301"
        ],
        "dialogs": {
          "761910301": {
            "id": "761910301",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "真的是银色的豚兽，不是染色的也不是看错，太少见了，不可思议…",
            "nextDialogs": [
              "761910302"
            ]
          },
          "761910302": {
            "id": "761910302",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "之前在纳塔费尽心思也没找到，原来是被走私贩给抓到了。",
            "nextDialogs": [
              "761910303"
            ]
          },
          "761910303": {
            "id": "761910303",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "不过看起来好像没受伤…嘿嘿，银色的豚兽，真没想到能亲眼见到，让我摸摸看，银色的和普通的有没有区别…",
            "nextDialogs": [
              "761910304"
            ]
          },
          "761910304": {
            "id": "761910304",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "…好烫！",
            "nextDialogs": [
              "761910305"
            ]
          },
          "761910305": {
            "id": "761910305",
            "speakerId": 1004,
            "speakerName": "豚兽",
            "text": "？",
            "nextDialogs": [
              "761910306"
            ]
          },
          "761910306": {
            "id": "761910306",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "差点忘了，你还在锅里呢！",
            "nextDialogs": [
              "761910307"
            ]
          },
          "761910307": {
            "id": "761910307",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "难道是已经习惯了纳塔的液态燃素，所以这点温度不算什么吗？",
            "nextDialogs": [
              "761910308"
            ]
          },
          "761910308": {
            "id": "761910308",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "不管怎么说，你先跟我回去吧！",
            "nextDialogs": [
              "761910309"
            ]
          },
          "761910309": {
            "id": "761910309",
            "speakerId": 1004,
            "speakerName": "豚兽",
            "text": "♪～"
          }
        }
      }
    },

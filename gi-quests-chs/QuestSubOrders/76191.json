      "dialogue": {
        "startDialogs": [
          "761919901"
        ],
        "dialogs": {
          "761919901": {
            "id": "761919901",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "你们应该庆幸遇上的是我而不是海捷德奶奶！",
            "nextDialogs": [
              "761919902"
            ]
          },
          "761919902": {
            "id": "761919902",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "居然真的有银色的豚兽！欸不对！怎么已经下锅了！",
            "nextDialogs": [
              "761919903"
            ]
          },
          "761919903": {
            "id": "761919903",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "哼哼，送它回去之前，让米科他们也见识一下好了！"
          }
        }
      }

            "id": "761910401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（附近似乎有些值得调查的，如果是对本地生态十分了解的<color=#FFCC33FF>莉奈娅</color>，或许会有所收获…）"
          }
        }
      }
    },
    {
      "subId": "7619105",
      "subQuestName": "调查笼子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761910501"
        ],
        "dialogs": {
          "761910501": {
            "id": "761910501",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "落荒而逃了…真没出息啊。",
            "nextDialogs": [
              "761910502"
            ]
          },
          "761910502": {
            "id": "761910502",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "（走私的豚兽看起来不在这里…和丘丘人有什么关系吗？）",
            "nextDialogs": [
              "761910503"
            ]
          },
          "761910503": {
            "id": "761910503",
            "speakerId": 1003,
            "speakerName": "莉奈娅",
            "text": "（在附近找找看有没有线索吧。）"
          }
        }
      }
    },

{
  "lineCounts": {
    "Black Screen": 1,
    "Player": 1,
    "勒拉": 28,
    "欧洛伦": 24,
    "派蒙": 23,
    "茜特菈莉": 48,
    "马塔拉": 1
  },
  "subQuests": [
    {
      "subId": "4017301",
      "subQuestName": "等待至两天后",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401730101"
        ],
        "dialogs": {
          "401730101": {
            "id": "401730101",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "各位好。",
            "nextDialogs": [
              "401730102"
            ]
          },
          "401730102": {
            "id": "401730102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "茜特菈莉，你来啦！",
            "nextDialogs": [
              "401730103"
            ]
          },
          "401730103": {
            "id": "401730103",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "嗯，我去首领那里请来了一柄仪式剑，借用它的力量可以完成一些事情。",
            "nextDialogs": [
              "401730104"
            ]
          },
          "401730104": {
            "id": "401730104",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "都没忘记我们今天要干什么吧？",
            "nextDialogs": [
              "401730105"
            ]
          },
          "401730105": {
            "id": "401730105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "当然啦，我们都等着勒拉醒来，好问问他到底是怎么回事呢。",
            "nextDialogs": [
              "401730106"
            ]
          },
          "401730106": {
            "id": "401730106",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "按照奶奶说的，我也准备好了备用的物品，今天万无一失。",
            "nextDialogs": [
              "401730107"
            ]
          },
          "401730107": {
            "id": "401730107",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "真不错，那我们就不多说了，现在就开始吧。",
            "nextDialogs": [
              "401730108"
            ]
          },
          "401730108": {
            "id": "401730108",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "茜特菈莉召出了一柄名为「厄水之祸」的仪式剑。",
            "nextDialogs": [
              "401730109"
            ]
          },
          "401730109": {
            "id": "401730109",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "自秘烟中献上供奉。星星献予无月之夜，梦的花环献予风。",
            "nextDialogs": [
              "401730110"
            ]
          },
          "401730110": {
            "id": "401730110",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "向死之主献上供奉。褪落。褪落。褪落。往复三重又三重。",
            "nextDialogs": [
              "401730111"
            ]
          },
          "401730111": {
            "id": "401730111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇——这是什么咒语吗？突然一下变得好凉！是不是有什么东西来了！",
            "nextDialogs": [
              "401730112"
            ]
          },
          "401730112": {
            "id": "401730112",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "小声一点，现在不能吵到她。",
            "nextDialogs": [
              "401730113"
            ]
          },
          "401730113": {
            "id": "401730113",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "我等，祭司王之嗣，要遵循亘古的盟约，撕裂夜域的织帷。",
            "nextDialogs": [
              "401730114"
            ]
          },
          "401730114": {
            "id": "401730114",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "茜特菈莉在此告谕。我为阿库乌波蒂尔，我为末地的养主。",
            "nextDialogs": [
              "401730115"
            ]
          },
          "401730115": {
            "id": "401730115",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "……",
            "nextDialogs": [
              "401730116"
            ]
          },
          "401730116": {
            "id": "401730116",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "看！勒拉的灵性回来了，正在往他的身上跑。",
            "nextDialogs": [
              "401730117"
            ]
          },
          "401730117": {
            "id": "401730117",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "我要用燧石刀刺入夜的斗篷，逐弃一切不属于亡者之国的魂灵。\\n",
            "nextDialogs": [
              "401730118"
            ]
          },
          "401730118": {
            "id": "401730118",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "勒拉！依从敕命，归来炎日下的地土，归来你应属的道途！",
            "nextDialogs": [
              "401730119"
            ]
          },
          "401730119": {
            "id": "401730119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "成…成功了吗？",
            "nextDialogs": [
              "401730120"
            ]
          },
          "401730120": {
            "id": "401730120",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "欸…欸？这里是…？你们…",
            "nextDialogs": [
              "401730121"
            ]
          },
          "401730121": {
            "id": "401730121",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "呜哇——黑曜石奶奶！不不…茜特菈莉大祭司！请手下留情！！",
            "nextDialogs": [
              "401730122"
            ]
          },
          "401730122": {
            "id": "401730122",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "你这小鬼，看来很清楚自己干了什么嘛？",
            "nextDialogs": [
              "401730123"
            ]
          },
          "401730123": {
            "id": "401730123",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "知道自己差点回不来吗？把自己变成一具空壳很有趣吗？",
            "nextDialogs": [
              "401730124"
            ]
          },
          "401730124": {
            "id": "401730124",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "对、对不起…请惩罚我吧。",
            "nextDialogs": [
              "401730125"
            ]
          },
          "401730125": {
            "id": "401730125",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "噢？你是真心的吗？那就快回家和父母告个别吧，就说：",
            "nextDialogs": [
              "401730126"
            ]
          },
          "401730126": {
            "id": "401730126",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "「再见了，爸爸妈妈，我喜欢空壳的人生，所以决定去黑曜石奶奶那里变成一块石像，替她看家一百年。」",
            "nextDialogs": [
              "401730127"
            ]
          },
          "401730127": {
            "id": "401730127",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "不要啊，我知道错了！十分感谢茜特菈莉大祭司把我救回来！",
            "nextDialogs": [
              "401730128"
            ]
          },
          "401730128": {
            "id": "401730128",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "哼哼，还是谢我孙子吧，要不是他察觉到异常，我是不想管这回事的。",
            "nextDialogs": [
              "401730129"
            ]
          },
          "401730129": {
            "id": "401730129",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "不用客气，勒拉，奶奶只是嘴巴不饶人，我们都不会怪你的。",
            "nextDialogs": [
              "401730130"
            ]
          },
          "401730130": {
            "id": "401730130",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "毕竟你受了别人的蛊惑吧？那个谷中才是罪魁祸首。",
            "nextDialogs": [
              "401730131"
            ]
          },
          "401730131": {
            "id": "401730131",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "不…跟谷中先生没关系，是我要这么干的。",
            "nextDialogs": [
              "401730132"
            ]
          },
          "401730132": {
            "id": "401730132",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "401730133"
            ]
          },
          "401730133": {
            "id": "401730133",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "虽然是他告诉了我用强大灵物来做媒介的方法，但决定要这么做的人是我，他并没有蛊惑我什么。",
            "nextDialogs": [
              "401730134"
            ]
          },
          "401730134": {
            "id": "401730134",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "对不起，要怪也只能怪我。",
            "nextDialogs": [
              "401730135"
            ]
          },
          "401730135": {
            "id": "401730135",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "呵呵，这小鬼被洗脑得不轻啊。",
            "nextDialogs": [
              "401730136"
            ]
          },
          "401730136": {
            "id": "401730136",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…那那个媒介碎片是他带来的吗？",
            "nextDialogs": [
              "401730137"
            ]
          },
          "401730137": {
            "id": "401730137",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "没错，据他说是跟烬寂海相关的宝物。",
            "nextDialogs": [
              "401730138"
            ]
          },
          "401730138": {
            "id": "401730138",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那这一看就是在利用你吧！利用你帮他暝视！",
            "nextDialogs": [
              "401730139"
            ]
          },
          "401730139": {
            "id": "401730139",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "可是，我只是一个灵性白痴，什么法术都学不会…我有什么利用价值呢？",
            "nextDialogs": [
              "401730140"
            ]
          },
          "401730140": {
            "id": "401730140",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "像我这样的家伙，如果只是打坐冥想，一辈子都没法感知到灵性的。",
            "nextDialogs": [
              "401730141"
            ]
          },
          "401730141": {
            "id": "401730141",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "谷中先生说，如果用别的办法让我强行施展法术，把自己浸泡在大量灵性中，反而有机会抓住它们的踪影。所以…",
            "nextDialogs": [
              "401730142"
            ]
          },
          "401730142": {
            "id": "401730142",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这简直就是破罐子破摔了啊！要不是茜特菈莉，你可真的就回不来了！",
            "nextDialogs": [
              "401730143"
            ]
          },
          "401730143": {
            "id": "401730143",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "对不起…对不起…族里的大家都是很有才华的人，可我却是个白痴…我只是不想再当异类…",
            "nextDialogs": [
              "401730144"
            ]
          },
          "401730144": {
            "id": "401730144",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "我很理解你…勒拉。",
            "nextDialogs": [
              "401730145"
            ]
          },
          "401730145": {
            "id": "401730145",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "有些种子可以毫不费劲地长成漂亮的卷心菜，但也有些种子，怎么努力都没法发芽。",
            "nextDialogs": [
              "401730146"
            ]
          },
          "401730146": {
            "id": "401730146",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "我也不知道为什么会是这样，可能这就是人生吧？总有很多没办法的事情。",
            "nextDialogs": [
              "401730147"
            ]
          },
          "401730147": {
            "id": "401730147",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "虽然我说这些也没有用，但希望你能调整好自己。",
            "nextDialogs": [
              "401730148"
            ]
          },
          "401730148": {
            "id": "401730148",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "总之，有什么事之后再说吧，现在先跟我去马塔拉那里检查身体。"
          }
        }
      }
    },
    {
      "subId": "4017302",
      "subQuestName": "前往勒拉的山洞",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4017303",
      "subQuestName": "前往巫医马塔拉处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401730201"
        ],
        "dialogs": {
          "401730201": {
            "id": "401730201",
            "speakerId": 6213,
            "speakerName": "马塔拉",
            "text": "嗯，挺好，小伙子身体没什么毛病，就是饥饿程度比较高，回去多吃点饭。",
            "nextDialogs": [
              "401730202"
            ]
          },
          "401730202": {
            "id": "401730202",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "那太好了，之前我还听说，有那种出神太久结果身体部位坏死的情况。",
            "nextDialogs": [
              "401730203"
            ]
          },
          "401730203": {
            "id": "401730203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这也太可怕了吧。",
            "nextDialogs": [
              "401730204"
            ]
          },
          "401730204": {
            "id": "401730204",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "嗯，总之勒拉，虽然我们之前不认识，但是现在你没事就好，我为你高兴。",
            "nextDialogs": [
              "401730205"
            ]
          },
          "401730205": {
            "id": "401730205",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "其实，欧洛伦，只是你不认识我而已…我早就听过你的事情了。",
            "nextDialogs": [
              "401730206"
            ]
          },
          "401730206": {
            "id": "401730206",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "#还有茜特菈莉大祭司，{NICKNAME}，派蒙，你们的事迹我都知道…",
            "nextDialogs": [
              "401730207"
            ]
          },
          "401730207": {
            "id": "401730207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#欸？居然连我和{NICKNAME}都…",
            "nextDialogs": [
              "401730208"
            ]
          },
          "401730208": {
            "id": "401730208",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "说起来还挺不好意思的，因为你们都是我梦寐以求想要成为的人，但事实证明，我只有仰望你们的份。",
            "nextDialogs": [
              "401730209"
            ]
          },
          "401730209": {
            "id": "401730209",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "谁让我生来就是个灵性白痴呢？哈哈，没关系，我已经习惯了被忽视的日子了。谢谢你们救了我。",
            "nextDialogs": [
              "401730210"
            ]
          },
          "401730210": {
            "id": "401730210",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "欧洛伦，你说的对，也许这就是人生。我之后不会再做这种危险的事、再给大家添麻烦了。",
            "nextDialogs": [
              "401730211"
            ]
          },
          "401730211": {
            "id": "401730211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "勒拉先生…",
            "nextDialogs": [
              "401730212"
            ]
          },
          "401730212": {
            "id": "401730212",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "不用安慰我啦，哈哈。",
            "nextDialogs": [
              "401730213"
            ]
          },
          "401730213": {
            "id": "401730213",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "喂，你这小鬼在说什么呢？你好好看看我。",
            "nextDialogs": [
              "401730214"
            ]
          },
          "401730214": {
            "id": "401730214",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "欸？茜特菈莉大祭司，怎么了吗？",
            "nextDialogs": [
              "401730215"
            ]
          },
          "401730215": {
            "id": "401730215",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "让你看就仔细看，感觉出来什么了吗？",
            "nextDialogs": [
              "401730216"
            ]
          },
          "401730216": {
            "id": "401730216",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "奶奶，你在说什么？",
            "nextDialogs": [
              "401730217"
            ]
          },
          "401730217": {
            "id": "401730217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呃…{NICKNAME}，你说茜特菈莉脸上是不是也写着「乐于助人」？",
            "nextDialogs": [
              "401730218"
            ]
          },
          "401730218": {
            "id": "401730218",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "…等一下，好像…",
            "nextDialogs": [
              "401730219"
            ]
          },
          "401730219": {
            "id": "401730219",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "不知道是不是我的错觉，我感觉茜特菈莉大祭司的身体是虚幻的…",
            "nextDialogs": [
              "401730220"
            ]
          },
          "401730220": {
            "id": "401730220",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "不…肯定是错觉，我怎么可能看出来。",
            "nextDialogs": [
              "401730221"
            ]
          },
          "401730221": {
            "id": "401730221",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "等等，这种套路…是我用过的那个法术，奶奶的真身已经离我们很远了。根本就是脚底抹油。",
            "nextDialogs": [
              "401730222"
            ]
          },
          "401730222": {
            "id": "401730222",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "看见了吗？你已经能察觉到一点灵性的异常了。恭喜你。",
            "nextDialogs": [
              "401730223"
            ]
          },
          "401730223": {
            "id": "401730223",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "真…真的吗？",
            "nextDialogs": [
              "401730224"
            ]
          },
          "401730224": {
            "id": "401730224",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "不过这是要去哪里？",
            "nextDialogs": [
              "401730225"
            ]
          },
          "401730225": {
            "id": "401730225",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "笨，当然是钓鱼了。",
            "nextDialogs": [
              "401730226"
            ]
          },
          "401730226": {
            "id": "401730226",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "我留在山洞里的陷阱被人踩中了，那个叫谷中的家伙上钩了。",
            "nextDialogs": [
              "401730227"
            ]
          },
          "401730227": {
            "id": "401730227",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么？",
            "nextDialogs": [
              "401730228"
            ]
          },
          "401730228": {
            "id": "401730228",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "闲话之后再聊，来山洞里找我。"
          }
        }
      }
    },
    {
      "subId": "4017304",
      "subQuestName": "返回勒拉的山洞",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401730301"
        ],
        "dialogs": {
          "401730301": {
            "id": "401730301",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "……",
            "nextDialogs": [
              "401730302"
            ]
          },
          "401730302": {
            "id": "401730302",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "（居然被那家伙跑了，这下糗大了…刚刚还一副自信满满的样子，哦天！我的形象…）",
            "nextDialogs": [
              "401730303"
            ]
          },
          "401730303": {
            "id": "401730303",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "（虽然那个谷中出人意料地擅长逃跑，但我也得想个恰当的说辞…）",
            "nextDialogs": [
              "401730304"
            ]
          },
          "401730304": {
            "id": "401730304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "茜特菈莉！你抓住那个谷中了吗？",
            "nextDialogs": [
              "401730305"
            ]
          },
          "401730305": {
            "id": "401730305",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "从山洞里只有奶奶一个人来看，应该是没有。",
            "nextDialogs": [
              "401730306"
            ]
          },
          "401730306": {
            "id": "401730306",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "…我…",
            "nextDialogs": [
              "401730307"
            ]
          },
          "401730307": {
            "id": "401730307",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "我暂时放了他一马。",
            "nextDialogs": [
              "401730308"
            ]
          },
          "401730308": {
            "id": "401730308",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "不过我在他身上留下了记号，如果他出现在附近，我就能追踪到他。",
            "nextDialogs": [
              "401730309"
            ]
          },
          "401730309": {
            "id": "401730309",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "原来奶奶刚才是假装离开山洞，实际偷偷躲了起来，准备来个瓮中捉鳖。",
            "nextDialogs": [
              "401730310"
            ]
          },
          "401730310": {
            "id": "401730310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢！就跟一开始抓欧洛伦那样。",
            "nextDialogs": [
              "401730311"
            ]
          },
          "401730311": {
            "id": "401730311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过茜特菈莉怎么知道那个家伙会过来呢？",
            "nextDialogs": [
              "401730312"
            ]
          },
          "401730312": {
            "id": "401730312",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "因为我放了诱饵啊，那张烬寂海的地图和弓的碎片，我刻意把它们留在桌子上，因为它们可能就是谷中的目的。",
            "nextDialogs": [
              "401730313"
            ]
          },
          "401730313": {
            "id": "401730313",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "果然我们离开没多久后，我留下的陷阱就被触发了。",
            "nextDialogs": [
              "401730314"
            ]
          },
          "401730314": {
            "id": "401730314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么？原来洞里真的有陷阱！",
            "nextDialogs": [
              "401730315"
            ]
          },
          "401730315": {
            "id": "401730315",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "当然，只是会自动忽略你们而已。",
            "nextDialogs": [
              "401730316"
            ]
          },
          "401730316": {
            "id": "401730316",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "看，我之前没瞎说吧？",
            "nextDialogs": [
              "401730317"
            ]
          },
          "401730317": {
            "id": "401730317",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "谷中先生，原来你真的在利用我…原来你的目的是烬寂海的情报…",
            "nextDialogs": [
              "401730318"
            ]
          },
          "401730318": {
            "id": "401730318",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "没错，我最初就在想，那家伙为什么会把碎片留在营地。",
            "nextDialogs": [
              "401730319"
            ]
          },
          "401730319": {
            "id": "401730319",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "在我得到烬寂海位置的时候，我明白了，那个碎片是诱饵。",
            "nextDialogs": [
              "401730320"
            ]
          },
          "401730320": {
            "id": "401730320",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "他知道勒拉一定会出问题，而部族又不会对勒拉视而不见，一定会有人来帮助勒拉…",
            "nextDialogs": [
              "401730321"
            ]
          },
          "401730321": {
            "id": "401730321",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢！他在钓鱼！钓出真正有能力的人来帮他暝视这块碎片！",
            "nextDialogs": [
              "401730322"
            ]
          },
          "401730322": {
            "id": "401730322",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "没错，而上钩的人…",
            "nextDialogs": [
              "401730323"
            ]
          },
          "401730323": {
            "id": "401730323",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "对不起，是我…",
            "nextDialogs": [
              "401730324"
            ]
          },
          "401730324": {
            "id": "401730324",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "但还有奶奶。",
            "nextDialogs": [
              "401730325"
            ]
          },
          "401730325": {
            "id": "401730325",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "臭小子！我是因为你！",
            "nextDialogs": [
              "401730326"
            ]
          },
          "401730326": {
            "id": "401730326",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "总之，这个谷中真狡猾，选择了风险最低的一种办法。",
            "nextDialogs": [
              "401730327"
            ]
          },
          "401730327": {
            "id": "401730327",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦，如果那家伙直接找到茜特菈莉，应该一分钟就会被识破！",
            "nextDialogs": [
              "401730328"
            ]
          },
          "401730328": {
            "id": "401730328",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那话说回来，茜特菈莉，你为什么要放他一马呀？",
            "nextDialogs": [
              "401730329"
            ]
          },
          "401730329": {
            "id": "401730329",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "咳…因为这里不方便施展出全力，那家伙又很擅长逃跑，强行留下他可能会出问题。",
            "nextDialogs": [
              "401730330"
            ]
          },
          "401730330": {
            "id": "401730330",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "难道是我选错了地方…抱歉。",
            "nextDialogs": [
              "401730331"
            ]
          },
          "401730331": {
            "id": "401730331",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "一开始为了救勒拉，我想找一个灵性比较充足的区域，所以就找到了疯贤者的地盘。",
            "nextDialogs": [
              "401730332"
            ]
          },
          "401730332": {
            "id": "401730332",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "疯贤者？",
            "nextDialogs": [
              "401730333"
            ]
          },
          "401730333": {
            "id": "401730333",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "没错，那家伙就在那堵墙后面，如果把他吵醒了也是个麻烦，所以我只能收着手。",
            "nextDialogs": [
              "401730334"
            ]
          },
          "401730334": {
            "id": "401730334",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "不过现在还有一个好消息：我把地图和碎片都抢了回来。奶奶我也不是吃素的。",
            "nextDialogs": [
              "401730335"
            ]
          },
          "401730335": {
            "id": "401730335",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太好了！那家伙能带走的就只有他自己！",
            "nextDialogs": [
              "401730336"
            ]
          },
          "401730336": {
            "id": "401730336",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "唔…可有一点坏的消息是：他大概已经看过了那地图，虽说烬寂海消失时的位置也不算什么秘辛吧…",
            "nextDialogs": [
              "401730337"
            ]
          },
          "401730337": {
            "id": "401730337",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？真令人担忧，那家伙不会要做什么坏事吧…",
            "nextDialogs": [
              "401730338"
            ]
          },
          "401730338": {
            "id": "401730338",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "不用太紧张，我会追踪那家伙的。",
            "nextDialogs": [
              "401730339"
            ]
          },
          "401730339": {
            "id": "401730339",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "#另外，勒拉，如果你没意见，我想把地图和这块碎片送给{NICKNAME}，这或许对{M#他}{F#她}未来的旅途有帮助。",
            "nextDialogs": [
              "401730340"
            ]
          },
          "401730340": {
            "id": "401730340",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "#当然！当然没意见！这是{NICKNAME}应得的。",
            "nextDialogs": [
              "401730341"
            ]
          },
          "401730341": {
            "id": "401730341",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有点太贵重了吧？",
            "nextDialogs": [
              "401730342"
            ]
          },
          "401730342": {
            "id": "401730342",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "反正我们都没兴趣。如果它真的指向了烬寂海，你这样的冒险者肯定不愿意错过那里。",
            "nextDialogs": [
              "401730343"
            ]
          },
          "401730343": {
            "id": "401730343",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "这是黑曜石奶奶的预感噢。",
            "nextDialogs": [
              "401730344"
            ]
          },
          "401730344": {
            "id": "401730344",
            "speakerId": 14603,
            "speakerName": "勒拉",
            "text": "那个，黑曜石奶奶，还有一件事，我现在还是灵性白痴吗？",
            "nextDialogs": [
              "401730345"
            ]
          },
          "401730345": {
            "id": "401730345",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "什么傻问题？你不是察觉了奶奶我的幻影术吗？虽说是故意露的破绽，但也不是灵性白痴能识破的。",
            "nextDialogs": [
              "401730346"
            ]
          },
          "401730346": {
            "id": "401730346",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "欧洛伦，之后你有空就好好教教这家伙。",
            "nextDialogs": [
              "401730347"
            ]
          },
          "401730347": {
            "id": "401730347",
            "speakerId": 1096,
            "speakerName": "茜特菈莉",
            "text": "能学多少，勒拉，就全看你自己的本事了。",
            "nextDialogs": [
              "401730348"
            ]
          },
          "401730348": {
            "id": "401730348",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "真好啊，人生真是奇妙，只要一直向前走，说不定就会碰到肥料。",
            "nextDialogs": [
              "401730349"
            ]
          },
          "401730349": {
            "id": "401730349",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "勒拉，我为你高兴。以后要一起加油啊，希望我们都能成为一颗漂亮的卷心菜。"
          }
        }
      }
    },
    {
      "subId": "4017307",

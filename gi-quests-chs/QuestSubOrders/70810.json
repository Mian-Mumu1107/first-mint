    {
      "subId": "7081002",
      "subQuestName": "与莎拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708100201"
        ],
        "dialogs": {
          "708100201": {
            "id": "708100201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于蒙德城的特产…",
            "nextDialogs": [
              "708100202"
            ]
          },
          "708100202": {
            "id": "708100202",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "蒙德城的特产？虽然我们的菜品都能说有蒙德特色…",
            "nextDialogs": [
              "708100203"
            ]
          },
          "708100203": {
            "id": "708100203",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "但是，我们店里一般的菜都不能放很久，也不方便长途携带。",
            "nextDialogs": [
              "708100204"
            ]
          },
          "708100204": {
            "id": "708100204",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "虽然我们也可以把一般的菜加工得方便携带和储存…但这样做的话，口感和味道都会差不少。",
            "nextDialogs": [
              "708100205"
            ]
          },
          "708100205": {
            "id": "708100205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没关系。",
            "nextDialogs": [
              "708100206"
            ]
          },
          "708100206": {
            "id": "708100206",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "好吧，如果您坚持的话。",
            "nextDialogs": [
              "708100207"
            ]
          },
          "708100207": {
            "id": "708100207",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "不过，店里的货放的时间都有些久了，如果您是用来送人的话，最好还是新做一份。",
            "nextDialogs": [
              "708100208"
            ]
          },
          "708100208": {
            "id": "708100208",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "请问，您的朋友是哪里人？我来想想送什么菜比较好。",
            "nextDialogs": [
              "708100210",
              "708100212"
            ]
          },
          "708100210": {
            "id": "708100210",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "至冬国？是很远的地方啊，那可要好好想想用什么菜最好了。",
            "nextDialogs": [
              "708100213"
            ]
          },
          "708100213": {
            "id": "708100213",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "唔，虽然不知道至冬国人口味如何，但是有一道菜肯定不会错啦。",
            "nextDialogs": [
              "708100214"
            ]
          },
          "708100214": {
            "id": "708100214",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "请您帮我做一份「满足沙拉」来吧，然后我来帮您处理一下。",
            "nextDialogs": [
              "708100215"
            ]
          },
          "708100215": {
            "id": "708100215",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "好久没有做过这种加工了，我得去找找工具…"
          },
          "708100212": {
            "id": "708100212",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "愚，愚人众？您是说来自至冬国的那些…您的交际可真广泛。"
          }
        }
      }
    },
    {
      "subId": "7081003",
      "subQuestName": "制作「满足沙拉」交给莎拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {

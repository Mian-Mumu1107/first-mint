    {
      "subId": "7081007",
      "subQuestName": "与芙萝拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708100401"
        ],
        "dialogs": {
          "708100401": {
            "id": "708100401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于蒙德城的特产…",
            "nextDialogs": [
              "708100402"
            ]
          },
          "708100402": {
            "id": "708100402",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "特产？是要送给人家的礼物吗？可是我这里只有花喔，花可不能放很久，会很快枯萎掉的。",
            "nextDialogs": [
              "708100403"
            ]
          },
          "708100403": {
            "id": "708100403",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "唔…我这里倒是有用花做成的「书签」，是我经常送给朋友们的礼物。",
            "nextDialogs": [
              "708100404"
            ]
          },
          "708100404": {
            "id": "708100404",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "虽然不太值钱，但也是我用心做的，你想要的话…也不是不行…",
            "nextDialogs": [
              "708100405"
            ]
          },
          "708100405": {
            "id": "708100405",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "不过，你要先回答我一个问题。如果答对了的话，我就送你一枚书签。",
            "nextDialogs": [
              "708100406"
            ]
          },
          "708100406": {
            "id": "708100406",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "问题很简单。请问…「蒲公英」是不是花呢？"
          }
        }
      }
    },
    {
      "subId": "7081008",
      "subQuestName": "(test)回答正确（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708100501"
        ],
        "dialogs": {
          "708100501": {
            "id": "708100501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是。",
            "nextDialogs": [
              "708100502"
            ]
          },
          "708100502": {
            "id": "708100502",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "咦？回答的这么快，呼呼，你对花还挺了解的嘛。",
            "nextDialogs": [
              "708100503"
            ]
          },
          "708100503": {
            "id": "708100503",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "那这枚书签就送给你啦，这可是我专门用晒干了的风车菊做的，绝对可以说得上是「蒙德城特产」啦。"
          }
        }
      }
    },
    {
      "subId": "7081009",
      "subQuestName": "(test)回答错误（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708100601"
        ],
        "dialogs": {
          "708100601": {
            "id": "708100601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是。",
            "nextDialogs": [
              "708100602"
            ]
          },
          "708100602": {
            "id": "708100602",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "…不是喔，蒲公英是花。你对花也太不了解了吧？",
            "nextDialogs": [
              "708100603"
            ]
          },
          "708100603": {
            "id": "708100603",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "哼，对花这么不了解，我这枚书签可不能随便送给你。",
            "nextDialogs": [
              "708100604"
            ]
          },
          "708100604": {
            "id": "708100604",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "这样吧，你去帮我采一些蒲公英籽回来，作为交换，我再把书签给你。",
            "nextDialogs": [
              "708100605"
            ]
          },
          "708100605": {
            "id": "708100605",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "还有，在采蒲公英的时候，记得默念「蒲公英是花」喔！"
          }
        }
      }
    },
    {
      "subId": "7081010",
      "subQuestName": "采集「蒲公英籽」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708101001"
        ],
        "dialogs": {
          "708101001": {
            "id": "708101001",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "用来调制饮料的材料，按理说应该早就到了才对…希望别出什么意外，你去帮我看看吧。",
            "nextDialogs": [
              "708101002"
            ]
          },
          "708101002": {
            "id": "708101002",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "不管怎么说，我都会尽量帮你做好特色饮料的，放心吧。"
          }
        }
      }
    },
    {
      "subId": "7081011",
      "subQuestName": "将「蒲公英籽」交给芙萝拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708100801"
        ],
        "dialogs": {
          "708100801": {
            "id": "708100801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「蒲公英」…",
            "nextDialogs": [
              "708100802"
            ]
          },
          "708100802": {
            "id": "708100802",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "你拿到蒲公英籽了吗？",
            "nextDialogs": [
              "708100803"
            ]
          },
          "708100803": {
            "id": "708100803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "拿到了。",
            "nextDialogs": [
              "708100804"
            ]
          },
          "708100804": {
            "id": "708100804",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "确实是蒲公英籽，好啦，这枚书签就送给你了。",
            "nextDialogs": [
              "708100805"
            ]
          },
          "708100805": {
            "id": "708100805",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "用花做的书签很容易坏，也很容易弄丢，我先给你包好了，可别随便打开了啊。",
            "nextDialogs": [
              "708100806"
            ]
          },
          "708100806": {
            "id": "708100806",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "可惜了，蒲公英籽不太合适用来做书签…"
          }
        }
      }
    },
    {
      "subId": "7081012",
      "subQuestName": "与查尔斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708100901"
        ],
        "dialogs": {
          "708100901": {
            "id": "708100901",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "嗯？有什么需要的吗？",
            "nextDialogs": [
              "708100902"
            ]
          },
          "708100902": {
            "id": "708100902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于蒙德城的特产…",
            "nextDialogs": [
              "708100903"
            ]
          },
          "708100903": {
            "id": "708100903",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "你是想要来买酒吗？你的年纪，好像还没有到可以喝酒的年纪。",
            "nextDialogs": [
              "708100904"
            ]
          },
          "708100904": {
            "id": "708100904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我是帮人来买…",
            "nextDialogs": [
              "708100905"
            ]
          },
          "708100905": {
            "id": "708100905",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "买回去之后，你是不是还要顺便和那位拜托你的人一起小酌一杯？",
            "nextDialogs": [
              "708100906"
            ]
          },
          "708100906": {
            "id": "708100906",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "酒就免了，但是有蒙德特色的饮料，应该也能满足你的要求了。",
            "nextDialogs": [
              "708100907"
            ]
          },
          "708100907": {
            "id": "708100907",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "但是…一些用来调制饮料的材料，到现在还没有送到。",
            "nextDialogs": [
              "708100908"
            ]
          },
          "708100908": {
            "id": "708100908",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "按理说应该早就到了才对…希望别出什么意外，你去帮我看看吧。",
            "nextDialogs": [
              "708100910",
              "708100912"
            ]
          },
          "708100910": {
            "id": "708100910",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "那就拜托你了。",
            "nextDialogs": [
              "708100913"
            ]
          },
          "708100913": {
            "id": "708100913",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "不管怎么说，我都会尽量帮你做好特色饮料的，放心吧。"
          },
          "708100912": {
            "id": "708100912",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "如果出了什么意外的话，就麻烦你把能带回来的东西带回来了。"
          }
        }
      }
    },
    {
      "subId": "7081013",
      "subQuestName": "取回调酒材料",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

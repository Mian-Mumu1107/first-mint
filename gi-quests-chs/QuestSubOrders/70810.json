    {
      "subId": "7081015",
      "subQuestName": "与查尔斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708101201"
        ],
        "dialogs": {
          "708101201": {
            "id": "708101201",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "情况怎么样？",
            "nextDialogs": [
              "708101202"
            ]
          },
          "708101202": {
            "id": "708101202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "货车已经被毁掉了。",
            "nextDialogs": [
              "708101203"
            ]
          },
          "708101203": {
            "id": "708101203",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "只剩下这些东西了吗…算了，等迪卢克老爷来，我再和他谈谈这件事吧。",
            "nextDialogs": [
              "708101204"
            ]
          },
          "708101204": {
            "id": "708101204",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "总是被魔物这么袭击，酒馆的生意早晚要受到影响。",
            "nextDialogs": [
              "708101205"
            ]
          },
          "708101205": {
            "id": "708101205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "从货车里拿到的东西…",
            "nextDialogs": [
              "708101206"
            ]
          },
          "708101206": {
            "id": "708101206",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "喔，那是我刚刚订购的新型调酒材料，我正打算开发几个新酒品。",
            "nextDialogs": [
              "708101207"
            ]
          },
          "708101207": {
            "id": "708101207",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "好了，我来调制答应你的特色饮料，我看看…这里面的材料应该够用了，稍等一下。"
          }
        }
      }
    },
    {
      "subId": "7081016",
      "subQuestName": "与维克多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708101811"
        ],
        "dialogs": {
          "708101811": {
            "id": "708101811",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有了。",
            "nextDialogs": [
              "708101812"
            ]
          },
          "708101812": {
            "id": "708101812",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "好了好了，我也就能说这么多，再说多了你我都要惹麻烦。",
            "nextDialogs": [
              "708101813"
            ]
          },
          "708101813": {
            "id": "708101813",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "没事的话就走吧，我接着在这呆着，免得突然有什么事要我去做…",
            "nextDialogs": [
              "708101814"
            ]
          },
          "708101814": {
            "id": "708101814",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "唉，什么时候我才能回去啊…"
          }
        }
      }
    },
    {
      "subId": "7081017",
      "subQuestName": "(test)交出猎鹿人特产$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708101501"
        ],
        "dialogs": {
          "708101501": {
            "id": "708101501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（拿出「猎鹿人的餐品」）",
            "nextDialogs": [
              "708101502"
            ]
          },
          "708101502": {
            "id": "708101502",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "这个是食物吧，还特意晒干了，确实是容易拿，但是味道估计不太好。",
            "nextDialogs": [
              "708101503"
            ]
          },
          "708101503": {
            "id": "708101503",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "哈哈哈，不过好歹是蒙德城的特产，这个我就带回去，送给别人吧。",
            "nextDialogs": [
              "708101504"
            ]
          },
          "708101504": {
            "id": "708101504",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "你办事还挺不错的，有什么想问的，赶紧问吧。",
            "nextDialogs": [
              "708101505"
            ]
          },
          "708101505": {
            "id": "708101505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「女士」。",
            "nextDialogs": [
              "708101506"
            ]
          },
          "708101506": {
            "id": "708101506",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "我就知道你要问这个，不过，这个我真不知道，我自己都还在奇怪…",
            "nextDialogs": [
              "708101507"
            ]
          },
          "708101507": {
            "id": "708101507",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "上头派我来蒙德城给「女士」大人办事，但是到今天「女士」大人都没让我干活。",
            "nextDialogs": [
              "708101508"
            ]
          },
          "708101508": {
            "id": "708101508",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "听人家说，「女士」大人就来了一趟，然后就离开蒙德城了，据说她心情还不错…",
            "nextDialogs": [
              "708101509"
            ]
          },
          "708101509": {
            "id": "708101509",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "唉，也不知道「女士」大人是不是把事情给办完了，如果事情办完了，我是不是也可以回去了？",
            "nextDialogs": [
              "708101510"
            ]
          },
          "708101510": {
            "id": "708101510",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "成天在这里莫名其妙地被修女和西风骑士瞪着，我自己也不自在…"
          }
        }
      }
    },
    {
      "subId": "7081018",
      "subQuestName": "(test)交出花语特产$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708101601"
        ],
        "dialogs": {
          "708101601": {
            "id": "708101601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（拿出「芙萝拉的书签」）",
            "nextDialogs": [
              "708101602"
            ]
          },
          "708101602": {
            "id": "708101602",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "这个是，书签…哼，也行吧，当个装饰也不错。",
            "nextDialogs": [
              "708101603"
            ]
          },
          "708101603": {
            "id": "708101603",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "果然让你帮忙没错，有什么想问的，赶紧问吧。",
            "nextDialogs": [
              "708101604"
            ]
          },
          "708101604": {
            "id": "708101604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你要回去了？",
            "nextDialogs": [
              "708101605"
            ]
          },
          "708101605": {
            "id": "708101605",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "我？我想啊，我早就想回去了，这蒙德城里太无聊了，也没人给我派活。",
            "nextDialogs": [
              "708101606"
            ]
          },
          "708101606": {
            "id": "708101606",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "我就只能整天坐在这里，被修女们成天瞪来瞪去的，好像我做了什么伤天害理的事一样。",
            "nextDialogs": [
              "708101607"
            ]
          },
          "708101607": {
            "id": "708101607",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "可是歌德大酒店里的那些先生们，最近又闭门不出，一点消息都没有。",
            "nextDialogs": [
              "708101608"
            ]
          },
          "708101608": {
            "id": "708101608",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "要我说，如果「女士」大人把事办完了，那就赶紧走呗。反正蒙德人也不喜欢我们，还留在这不是自己找罪受。",
            "nextDialogs": [
              "708101609"
            ]
          },
          "708101609": {
            "id": "708101609",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "但是，上面一直没命令回去，我也就只能想想…"
          }
        }
      }
    },
    {
      "subId": "7081019",
      "subQuestName": "(test)交出天使的馈赠特产$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708101701"
        ],
        "dialogs": {
          "708101701": {
            "id": "708101701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（拿出「特色饮料」）",
            "nextDialogs": [
              "708101702"
            ]
          },
          "708101702": {
            "id": "708101702",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "这个饮料不错…嗯，看着就不错，我尝尝…",
            "nextDialogs": [
              "708101703"
            ]
          },
          "708101703": {
            "id": "708101703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "最好先冰镇。",
            "nextDialogs": [
              "708101704"
            ]
          },
          "708101704": {
            "id": "708101704",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "啊？要冰镇的吗，那算了，我带回去吧，回去之后找冰块容易…",
            "nextDialogs": [
              "708101705"
            ]
          },
          "708101705": {
            "id": "708101705",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "还是那句话，咱们愚人众说到做到。给咱们办事，绝不会亏了你",
            "nextDialogs": [
              "708101706"
            ]
          },
          "708101706": {
            "id": "708101706",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "有什么想问的，赶紧问吧。",
            "nextDialogs": [
              "708101707"
            ]
          },
          "708101707": {
            "id": "708101707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于其他执行官。",
            "nextDialogs": [
              "708101708"
            ]
          },
          "708101708": {
            "id": "708101708",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "执行官大人们…我这种小角色，也顶多是听说一点传闻。",
            "nextDialogs": [
              "708101709"
            ]
          },
          "708101709": {
            "id": "708101709",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "我就随便说说啊，你就听听看就行了，别太当真，我也是听人家说的…",
            "nextDialogs": [
              "708101710"
            ]
          },
          "708101710": {
            "id": "708101710",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "执行官第六席「散兵」大人，据说很不好相处…挺多人都不太喜欢他。",
            "nextDialogs": [
              "708101711"
            ]
          },
          "708101711": {
            "id": "708101711",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "至于原因…怎么说呢，有人说，是因为「散兵」大人的性格不太好，有人说是他说话不分场合…",
            "nextDialogs": [
              "708101712"
            ]
          },
          "708101712": {
            "id": "708101712",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "我认识一个在执行官大人身边的人，他和我说，一些执行官大人也不太喜欢「散兵」大人。",
            "nextDialogs": [
              "708101713"
            ]
          },
          "708101713": {
            "id": "708101713",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "不过，「散兵」大人好歹也是执行官啊，比我这种小角色不知道好到哪里去了…"
          }
        }
      }
    },
    {
      "subId": "7081020",
      "subQuestName": "(test)交完了$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7081001",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708100121"
        ],
        "dialogs": {
          "708100121": {
            "id": "708100121",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "你还有什么事情？要问就快点问，别磨磨蹭蹭的。",
            "nextDialogs": [
              "708100123",
              "708100128"
            ]
          },
          "708100123": {
            "id": "708100123",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "哈，这个问题挺不错，我为什么找你…因为我这个愚人众，在蒙德城里就快要人人喊打了。",
            "nextDialogs": [
              "708100124"
            ]
          },
          "708100124": {
            "id": "708100124",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "之前就是修女看我的眼神怪怪的，现在，西风骑士看我的眼神，就像是想把我当街给逮捕了一样。",
            "nextDialogs": [
              "708100125"
            ]
          },
          "708100125": {
            "id": "708100125",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "除了能和你这位旅行者说上点话，我难道还真敢去拜托其他的蒙德人帮忙？",
            "nextDialogs": [
              "708100126"
            ]
          },
          "708100126": {
            "id": "708100126",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "我就奇了怪了，我到底做了什么事，这么招人厌…"
          },
          "708100128": {
            "id": "708100128",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "详细数量我不知道，不过歌德大酒店里的那些先生们是已经闭门不出了，也不知道发生了什么。",
            "nextDialogs": [
              "708100129"
            ]
          },
          "708100129": {
            "id": "708100129",
            "speakerId": 1003,
            "speakerName": "维克多",
            "text": "我想，说不定是那些大人物又在做什么事。不过嘛…哼，这些事和我这个小角色一点关系都没有了。"
          }
        }
      }
    },
    {
      "subId": "7081004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708100407"
        ],
        "dialogs": {
          "708100407": {
            "id": "708100407",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "（test）只需要回答我的一个问题就好啦，很简单吧~",
            "nextDialogs": [
              "708100408"
            ]
          },
          "708100408": {
            "id": "708100408",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "（test）懂花之人，首先必然懂得什么是花。那么蒲公英是不是花呢？"
          }
        }
      }
    },
    {
      "subId": "7081011",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708101101"
        ],
        "dialogs": {
          "708101101": {
            "id": "708101101",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "好了，用苹果酿做基底，辅以蒲公英、薄荷和树莓调味，能再冰镇一下最好。",
            "nextDialogs": [
              "708101102"
            ]
          },
          "708101102": {
            "id": "708101102",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "喝完这种清凉的饮料，呼吸的时候，喉咙和口腔应该都能清晰地感受到「风」了。",
            "nextDialogs": [
              "708101103"
            ]
          },
          "708101103": {
            "id": "708101103",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "我先用酒瓶给你装好，不然味道很快就会散掉了。",
            "nextDialogs": [
              "708101104"
            ]
          },
          "708101104": {
            "id": "708101104",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "记住了，要喝的时候，最好冰镇一会。"
          }
        }
      }
    },
    {
      "subId": "7081020",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708102001"
        ],
        "dialogs": {
          "708102001": {
            "id": "708102001",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "记住了，要喝的时候，最好冰镇一会。"
          }
        }
      }
    },

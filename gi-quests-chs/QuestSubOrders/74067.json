    {
      "subId": "7406704",
      "subQuestName": "与克兰茨对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740670401"
        ],
        "dialogs": {
          "740670401": {
            "id": "740670401",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "又见面了。我之前和自己打赌，赌来的会不会是你们。",
            "nextDialogs": [
              "740670403",
              "740670405"
            ]
          },
          "740670403": {
            "id": "740670403",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "哈哈，赢也是我，输也是我。",
            "nextDialogs": [
              "740670406"
            ]
          },
          "740670406": {
            "id": "740670406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你为什么要用扩音机做这种事呀，被嘉维娅抓到的话，不是很麻烦吗？你很怕她，对吧？",
            "nextDialogs": [
              "740670407"
            ]
          },
          "740670407": {
            "id": "740670407",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "怕她？怎么会，只是被她抓到的确很麻烦。但她大部分时间都在管理区，生产区的麻烦如果没有特别的原因，她是不想插手的。",
            "nextDialogs": [
              "740670408"
            ]
          },
          "740670408": {
            "id": "740670408",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "至于为什么要用扩音机做这种事，那当然是因为这里的生活太无聊了。",
            "nextDialogs": [
              "740670409"
            ]
          },
          "740670409": {
            "id": "740670409",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "我现在能理解蒂亚尔的想法了，他一定也是觉得生活太无聊了，所以总是在找乐子。说起来，我只是有样学样吧。",
            "nextDialogs": [
              "740670410"
            ]
          },
          "740670410": {
            "id": "740670410",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "你们应该也有这样的朋友吧？脑子里装满了奇思妙想，偶尔也会惹出些让人啼笑皆非的乱子来的朋友。"
          },
          "740670405": {
            "id": "740670405",
            "speakerId": 5252,
            "speakerName": "克兰茨",
            "text": "好问题。不过很容易回答，因为这里没人愿意和我打这种无聊的赌。"
          }
        }
      }
    }
  ]
}
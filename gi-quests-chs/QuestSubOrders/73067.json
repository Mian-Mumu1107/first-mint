            "speakerId": 20745,
            "speakerName": "兰沙恭",
            "text": "#呜呜，不知道那菈{NICKNAME}能不能将我的「勇气」还给我…"
          }
        }
      }
    },
    {
      "subId": "7306799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730679904"
        ],
        "dialogs": {
          "730679904": {
            "id": "730679904",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "…呜呜，救命，救命，谁能将兰沙恭从这可怕的山洞救出…",
            "nextDialogs": [
              "730679905"
            ]
          },
          "730679905": {
            "id": "730679905",
            "speakerId": 1005,
            "speakerName": "派蒙",

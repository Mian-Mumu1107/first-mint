        "dialogs": {
          "771861401": {
            "id": "771861401",
            "speakerId": 1000,
            "speakerName": "佩拉格娅",
            "text": "好幸运，猜对了！那这份大奖归你了！",
            "nextDialogs": [
              "771861402"
            ]
          },
          "771861402": {
            "id": "771861402",
            "speakerId": 1000,
            "speakerName": "佩拉格娅",
            "text": "还有我特别定制的「小胡子兵士」呢，也送你…之前我总对着它，练习怎么说话，希望它也能陪你…",
            "nextDialogs": [
              "771861403"
            ]
          },
          "771861403": {
            "id": "771861403",
            "speakerId": 1000,
            "speakerName": "佩拉格娅",
            "text": "不过…之后来玩的话，暂时没有奖励了…不好意思，别生气哦…",
            "nextDialogs": [
              "771861404"
            ]
          },
          "771861404": {
            "id": "771861404",
            "speakerId": 1000,
            "speakerName": "佩拉格娅",
            "text": "我已经送出去太多太多的大奖啦，大、大概已经花了几十万摩拉了…"
          }
        }
      }

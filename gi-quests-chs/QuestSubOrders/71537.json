        "dialogs": {
          "715370301": {
            "id": "715370301",
            "speakerId": 1000,
            "speakerName": "诺艾尔",
            "text": "原来是这样…不愧是前辈！果然什么都很懂啊！",
            "nextDialogs": [
              "715370302"
            ]
          },
          "715370302": {
            "id": "715370302",
            "speakerId": 1000,
            "speakerName": "诺艾尔",
            "text": "谢谢前辈的指导，这封「祝柬」我会好好珍藏的。",
            "nextDialogs": [
              "715370303"
            ]
          },
          "715370303": {
            "id": "715370303",
            "speakerId": 1000,
            "speakerName": "诺艾尔",
            "text": "等下次蒙德举办「风花节」，你可一定要来啊。",
            "nextDialogs": [
              "715370304"
            ]
          },
          "715370304": {
            "id": "715370304",
            "speakerId": 1000,
            "speakerName": "诺艾尔",
            "text": "到时候，我一定给你写一封和这份「祝柬」一样漂亮的贺卡。"
          }
        }
      }

        ],
        "dialogs": {
          "80020001": {
            "id": "80020001",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊！果然有深渊教团的魔物！",
            "nextDialogs": [
              "80020002"
            ]
          },
          "80020002": {
            "id": "80020002",
            "speakerId": 1003,
            "speakerName": "戴因斯雷布",
            "text": "不要轻敌，我们上。",
            "nextDialogs": [
              "80020003"
            ]
          },
          "80020003": {
            "id": "80020003",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "掌握了非常重要的情报，我们快去告诉戴因吧！",
            "nextDialogs": [
              "80020004"
            ]
          },
          "80020004": {
            "id": "80020004",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看、看那边！是雷泽！还有…「深渊使徒」！"
          }
        }
      }

    {
      "subId": "800207",
      "subQuestName": "打倒所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80020701"
        ],
        "dialogs": {
          "80020701": {
            "id": "80020701",
            "speakerId": 1005,
            "speakerName": "深渊使徒",
            "text": "哼…短暂的仪式被打断了，你们真是好运。",
            "nextDialogs": [
              "80020702"
            ]
          },
          "80020702": {
            "id": "80020702",
            "speakerId": 1005,
            "speakerName": "深渊使徒",
            "text": "没想到，仅仅是一缕残魂，也有这么坚强的意志…",
            "nextDialogs": [
              "80020703"
            ]
          },
          "80020703": {
            "id": "80020703",
            "speakerId": 1005,
            "speakerName": "深渊使徒",
            "text": "但这种微小的变数，不足以影响全局。",
            "nextDialogs": [
              "80020704"
            ]
          },
          "80020704": {
            "id": "80020704",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "又消失了…",
            "nextDialogs": [
              "80020707"
            ]
          },
          "80020707": {
            "id": "80020707",
            "speakerId": 1004,
            "speakerName": "雷泽",
            "text": "谢谢你们，来得，及时。",
            "nextDialogs": [
              "80020708"
            ]
          },
          "80020708": {
            "id": "80020708",
            "speakerId": 1006,
            "speakerName": "玻瑞亚斯",
            "text": "人类中的「卢皮卡」…让你们见到我如此姿态，见笑了。",
            "nextDialogs": [
              "80020709"
            ]
          },
          "80020709": {
            "id": "80020709",
            "speakerId": 1006,
            "speakerName": "玻瑞亚斯",
            "text": "但深渊的使徒，终究是太小看我了。",
            "nextDialogs": [
              "80020710"
            ]
          },
          "80020710": {
            "id": "80020710",
            "speakerId": 1004,
            "speakerName": "雷泽",
            "text": "王狼，不拒绝，试炼。但，阴森的外来者，不遵守，试炼的规矩。",
            "nextDialogs": [
              "80020711"
            ]
          },
          "80020711": {
            "id": "80020711",
            "speakerId": 1004,
            "speakerName": "雷泽",
            "text": "我也，注意不到，布下的陷阱…",
            "nextDialogs": [
              "80020712"
            ]
          },
          "80020712": {
            "id": "80020712",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也就是说，是深渊教团先做好了腐蚀的准备，再以试炼的名义，把「王狼」唤醒？"
          }
        }
      }
    },

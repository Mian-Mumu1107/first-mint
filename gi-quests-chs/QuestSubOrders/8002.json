      }
    },
    {
      "subId": "800205",
      "subQuestName": "与琴对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80020201"
        ],
        "dialogs": {
          "80020201": {
            "id": "80020201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呼——这一带敌人可真不少！",
            "nextDialogs": [
              "80020202"
            ]
          },
          "80020202": {
            "id": "80020202",
            "speakerId": 1003,
            "speakerName": "戴因斯雷布",
            "text": "越靠近目标，敌人就越多。哼，符合教团的作风。",
            "nextDialogs": [
              "80020203"
            ]
          },
          "80020203": {
            "id": "80020203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们得快点找到「王狼」。",
            "nextDialogs": [
              "80020204"
            ]
          },
          "80020204": {
            "id": "80020204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！走吧！",
            "nextDialogs": [
              "80020205"
            ]
          },
          "80020205": {
            "id": "80020205",
            "speakerId": 1003,
            "speakerName": "戴因斯雷布",
            "text": "我…就不去了。",
            "nextDialogs": [
              "80020206"
            ]
          },
          "80020206": {
            "id": "80020206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎？为什么呀？难道你害怕毛茸茸的生物？",
            "nextDialogs": [
              "80020209"
            ]
          },
          "80020209": {
            "id": "80020209",
            "speakerId": 1003,
            "speakerName": "戴因斯雷布",
            "text": "与「狼」无关。是因为它作为昔日的魔神，却效力于如今的七神。",
            "nextDialogs": [
              "80020210"
            ]
          },
          "80020210": {
            "id": "80020210",
            "speakerId": 1003,
            "speakerName": "戴因斯雷布",
            "text": "我无法认可它的行为，更不想和它打交道。",
            "nextDialogs": [
              "80020211"
            ]
          },
          "80020211": {
            "id": "80020211",
            "speakerId": 1003,
            "speakerName": "戴因斯雷布",
            "text": "再说，讨人喜欢是你的本事，我可做不到。"
          }
        }
      }
    },
    {
      "subId": "800206",
      "subQuestName": "寻找「北风的王狼」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80020601"
        ],
        "dialogs": {
          "80020601": {
            "id": "80020601",
            "speakerId": 1003,
            "speakerName": "戴因斯雷布",
            "text": "你们去教会里找人打听吧，我就在这里等着你们。"
          }
        }
      }
    },
    {
      "subId": "800211",
      "subQuestName": "与雷泽对话",
      "sceneId": null,
      "locations": [],

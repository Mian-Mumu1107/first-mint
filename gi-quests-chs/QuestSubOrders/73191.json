    {
      "subId": "7319102",
      "subQuestName": "与索赫尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731100801"
        ],
        "dialogs": {
          "731100801": {
            "id": "731100801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "探索了「饱饮之陵」。",
            "nextDialogs": [
              "731100802"
            ]
          },
          "731100802": {
            "id": "731100802",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "原来二位去了饱饮之陵，果然和我说得一样，就是缩小版的赤王陵吧？那么，有什么收获吗？",
            "nextDialogs": [
              "731100803"
            ]
          },
          "731100803": {
            "id": "731100803",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "向索赫尔讲述了探查饱饮之陵的经历，并把石板交给了他。",
            "nextDialogs": [
              "731100804"
            ]
          },
          "731100804": {
            "id": "731100804",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "唔…听起来并没有什么非常特殊的发现啊…看来饱饮之陵和赤王陵的差别，并不仅仅是大小而已。",
            "nextDialogs": [
              "731100805"
            ]
          },
          "731100805": {
            "id": "731100805",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "至于这块石板嘛…",
            "nextDialogs": [
              "731100806"
            ]
          },
          "731100806": {
            "id": "731100806",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "是什么？是什么？写了这么多字，一定很有研究价值吧！",
            "nextDialogs": [
              "731100807"
            ]
          },
          "731100807": {
            "id": "731100807",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "唔…在我看来，好像只是很普通的以动物为原型的寓言故事而已。",
            "nextDialogs": [
              "731100808"
            ]
          },
          "731100808": {
            "id": "731100808",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸…怎么会这样？",
            "nextDialogs": [
              "731100809"
            ]
          },
          "731100809": {
            "id": "731100809",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "不过没关系，论文还是写得出来的，虽然可能短一点就是了——",
            "nextDialogs": [
              "731100810"
            ]
          },
          "731100810": {
            "id": "731100810",
            "speakerId": 1000,
            "speakerName": "索赫尔",
            "text": "《羊群的退却：沙漠环境变迁的初步研究》。"
          }
        }
      }
    }
  ]

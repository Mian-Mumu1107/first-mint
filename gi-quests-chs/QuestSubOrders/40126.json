    {
      "subId": "4012606",
      "subQuestName": "与卡莉露对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401260601"
        ],
        "dialogs": {
          "401260601": {
            "id": "401260601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呼…卡莉露你没事吧？",
            "nextDialogs": [
              "401260602"
            ]
          },
          "401260602": {
            "id": "401260602",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃…！这这这，这是什么？",
            "nextDialogs": [
              "401260603"
            ]
          },
          "401260603": {
            "id": "401260603",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "好大一颗水珠！",
            "nextDialogs": [
              "401260604"
            ]
          },
          "401260604": {
            "id": "401260604",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "这，这不就是我那天看到的非人之物吗？",
            "nextDialogs": [
              "401260607"
            ]
          },
          "401260607": {
            "id": "401260607",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "…咦？大家为什么这样看着我？",
            "nextDialogs": [
              "401260608"
            ]
          },
          "401260608": {
            "id": "401260608",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "…！难道说，我的身形…",
            "nextDialogs": [
              "401260609"
            ]
          },
          "401260609": {
            "id": "401260609",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "这声音…的确是卡莉露小姐。",
            "nextDialogs": [
              "401260610"
            ]
          },
          "401260610": {
            "id": "401260610",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "怎么会这样…请稍等一下…",
            "nextDialogs": [
              "401260611"
            ]
          },
          "401260611": {
            "id": "401260611",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "在众人的注视下，水珠慢慢变回了卡莉露的模样…",
            "nextDialogs": [
              "401260612"
            ]
          },
          "401260612": {
            "id": "401260612",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "唔…是消耗得太快了吗…",
            "nextDialogs": [
              "401260613"
            ]
          },
          "401260613": {
            "id": "401260613",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "这…这是怎么回事？卡莉露小姐，莫非是仙物吗？",
            "nextDialogs": [
              "401260614"
            ]
          },
          "401260614": {
            "id": "401260614",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "不…抱歉瞒了大家这么久…我其实，是一只很久以前从枫丹流落至此的纯水精灵…",
            "nextDialogs": [
              "401260615"
            ]
          },
          "401260615": {
            "id": "401260615",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "纯水精灵？",
            "nextDialogs": [
              "401260616"
            ]
          },
          "401260616": {
            "id": "401260616",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "啊，我听大团长说起过。纯水精灵是枫丹前代水神的眷属，在前代水神死后离开枫丹，逃往各国…",
            "nextDialogs": [
              "401260617"
            ]
          },
          "401260617": {
            "id": "401260617",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "没错…但，说实话，我已经有些不记得自己是怎么逃到这里来的了…",
            "nextDialogs": [
              "401260618"
            ]
          },
          "401260618": {
            "id": "401260618",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "家乡的风景还有浅浅的印象，但沿途的风光实在记不真切…",
            "nextDialogs": [
              "401260619"
            ]
          },
          "401260619": {
            "id": "401260619",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "只知道我来到蒙德的时候，已经失去了大部分力量，甚至无法维持稳定的实体…",
            "nextDialogs": [
              "401260620"
            ]
          },
          "401260620": {
            "id": "401260620",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "最后，我在一处名叫「清泉镇」的地方定居了下来，慢慢恢复着自己的力量…",
            "nextDialogs": [
              "401260621"
            ]
          },
          "401260621": {
            "id": "401260621",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "清泉镇僻静幽美，水流清澈无瑕，就和住在那里人们的心灵一样。",
            "nextDialogs": [
              "401260622"
            ]
          },
          "401260622": {
            "id": "401260622",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "你就是清泉镇的「泉水精灵」？",
            "nextDialogs": [
              "401260623"
            ]
          },
          "401260623": {
            "id": "401260623",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "是啊，迪奥娜，我记得你哟。小时候，你经常在夜晚来到泉边和我说话。",
            "nextDialogs": [
              "401260624"
            ]
          },
          "401260624": {
            "id": "401260624",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "真的吗？你没在骗我哦？",
            "nextDialogs": [
              "401260625"
            ]
          },
          "401260625": {
            "id": "401260625",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "（我，我还一直以为那只是清泉镇的传说…）",
            "nextDialogs": [
              "401260626"
            ]
          },
          "401260626": {
            "id": "401260626",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "那个你很喜欢的小鱼抱枕，是叫「泡泡」对吧？",
            "nextDialogs": [
              "401260627"
            ]
          },
          "401260627": {
            "id": "401260627",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "…对！",
            "nextDialogs": [
              "401260628"
            ]
          },
          "401260628": {
            "id": "401260628",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "（小时候的那些，都不是梦！）",
            "nextDialogs": [
              "401260629"
            ]
          },
          "401260629": {
            "id": "401260629",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这么说来…落叶诗上写的事情…"
          }
        }
      }
    },
    {
      "subId": "4012607",
      "subQuestName": "前往清泉镇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401260701"
        ],
        "dialogs": {
          "401260701": {
            "id": "401260701",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "……！",
            "nextDialogs": [
              "401260702"
            ]
          },
          "401260702": {
            "id": "401260702",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "…没事吧？",
            "nextDialogs": [
              "401260703"
            ]
          },
          "401260703": {
            "id": "401260703",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…没什么…只是我恐怕…难以维持现在的形态了。",
            "nextDialogs": [
              "401260704"
            ]
          },
          "401260704": {
            "id": "401260704",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "那…那卡莉露在这里等一下，我这就叫芬奇爷爷过来！",
            "nextDialogs": [
              "401260705"
            ]
          },
          "401260705": {
            "id": "401260705",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…慢点，迪奥娜…芬奇老了，走路不能急…",
            "nextDialogs": [
              "401260706"
            ]
          },
          "401260706": {
            "id": "401260706",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "我还能…再撑一会儿…",
            "nextDialogs": [
              "401260707"
            ]
          },
          "401260707": {
            "id": "401260707",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "好，撑住撑住。"
          }
        }
      }
    },
    {
      "subId": "4012608",
      "subQuestName": "与老芬奇对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401260801"
        ],
        "dialogs": {
          "401260801": {
            "id": "401260801",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "芬奇爷爷！",
            "nextDialogs": [
              "401260802"
            ]
          },
          "401260802": {
            "id": "401260802",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "哟，这不是迪奥娜吗？今天回来得可真早。",
            "nextDialogs": [
              "401260803"
            ]
          },
          "401260803": {
            "id": "401260803",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "今天情况特殊。芬奇爷爷，能跟我来一下吗？",
            "nextDialogs": [
              "401260804"
            ]
          },
          "401260804": {
            "id": "401260804",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "哦？这是要去哪呀？",
            "nextDialogs": [
              "401260805"
            ]
          },
          "401260805": {
            "id": "401260805",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "就后面的小瀑布那里。",
            "nextDialogs": [
              "401260806"
            ]
          },
          "401260806": {
            "id": "401260806",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "哈哈，迪奥娜是猎到了什么好东西吗？",
            "nextDialogs": [
              "401260807"
            ]
          },
          "401260807": {
            "id": "401260807",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "哎呀！跟我来就行，是有特别特别重要的事情！",
            "nextDialogs": [
              "401260808"
            ]
          },
          "401260808": {
            "id": "401260808",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "可是，待会儿你爸爸还约了我去…",
            "nextDialogs": [
              "401260809"
            ]
          },
          "401260809": {
            "id": "401260809",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "芬奇爷爷！",
            "nextDialogs": [
              "401260810"
            ]
          },
          "401260810": {
            "id": "401260810",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "啊，好好好，别着急，我跟你走就是了…",
            "nextDialogs": [
              "401260811"
            ]
          },
          "401260811": {
            "id": "401260811",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "嗯，来，我扶着您。",
            "nextDialogs": [
              "401260812"
            ]
          },
          "401260812": {
            "id": "401260812",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "（哎哟哟，这杜拉夫家的闺女，急起来还真和她爸爸一个样…）"
          }
        }
      }
    },
    {
      "subId": "4012609",
      "subQuestName": "与卡莉露对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401260901"
        ],
        "dialogs": {
          "401260901": {
            "id": "401260901",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "……",
            "nextDialogs": [
              "401260902"
            ]
          },
          "401260902": {
            "id": "401260902",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "这边这边，芬奇爷爷，您慢点走。",
            "nextDialogs": [
              "401260903"
            ]
          },
          "401260903": {
            "id": "401260903",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "咦？这是怎么回事？怎么那么多朋友？",
            "nextDialogs": [
              "401260904"
            ]
          },
          "401260904": {
            "id": "401260904",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "连米卡也在？哈哈，最近工作还顺利吗？",
            "nextDialogs": [
              "401260905"
            ]
          },
          "401260905": {
            "id": "401260905",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "还有几位外国朋友？我没糊涂吧？今天不是我生日呀。",
            "nextDialogs": [
              "401260906"
            ]
          },
          "401260906": {
            "id": "401260906",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "芬奇爷爷，您好，我是重云，和大家在诗歌大会上认识的，这位是…",
            "nextDialogs": [
              "401260907"
            ]
          },
          "401260907": {
            "id": "401260907",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…芬奇。",
            "nextDialogs": [
              "401260908"
            ]
          },
          "401260908": {
            "id": "401260908",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "……！这声音…卡莉露？",
            "nextDialogs": [
              "401260909"
            ]
          },
          "401260909": {
            "id": "401260909",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…没想到，你还记得？",
            "nextDialogs": [
              "401260910"
            ]
          },
          "401260910": {
            "id": "401260910",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "…记得，哈哈哈，记得，怎么可能不记得？",
            "nextDialogs": [
              "401260911"
            ]
          },
          "401260911": {
            "id": "401260911",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "不过，你当初可不是这个样子哟…那时的你，更像是从童话里走出来的…",
            "nextDialogs": [
              "401260912"
            ]
          },
          "401260912": {
            "id": "401260912",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "哎呀，瞧我，童话里的精灵变成什么样都不奇怪吧…",
            "nextDialogs": [
              "401260913"
            ]
          },
          "401260913": {
            "id": "401260913",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "哈…都过了这么久，你还是能逗我开心。",
            "nextDialogs": [
              "401260914"
            ]
          },
          "401260914": {
            "id": "401260914",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "谁叫你总是在晚上出现嘛…我还真怀疑过那些是不是梦…",
            "nextDialogs": [
              "401260915"
            ]
          },
          "401260915": {
            "id": "401260915",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…让你久等了，芬奇。",
            "nextDialogs": [
              "401260916"
            ]
          },
          "401260916": {
            "id": "401260916",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "…不久，不久，一晃眼的事而已。",
            "nextDialogs": [
              "401260917"
            ]
          },
          "401260917": {
            "id": "401260917",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…芬奇，你愿意听我给你写的诗吗？",
            "nextDialogs": [
              "401260918"
            ]
          },
          "401260918": {
            "id": "401260918",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "诗？你还写诗啦？听，当然听…你的每句话我都听…",
            "nextDialogs": [
              "401260919"
            ]
          },
          "401260919": {
            "id": "401260919",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…那么，就让我给你念一段泉水精灵的故事吧——",
            "nextDialogs": [
              "401260920"
            ]
          },
          "401260920": {
            "id": "401260920",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "……",
            "nextDialogs": [
              "401260921"
            ]
          },
          "401260921": {
            "id": "401260921",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "对…这才是我第一次见到你时的样子嘛…",
            "nextDialogs": [
              "401260922"
            ]
          },
          "401260922": {
            "id": "401260922",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "好久…真的过去好久了…",
            "nextDialogs": [
              "401260923"
            ]
          },
          "401260923": {
            "id": "401260923",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…芬奇，我…",
            "nextDialogs": [
              "401260924"
            ]
          },
          "401260924": {
            "id": "401260924",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "好啦，都明白，从你的诗里，我全都明白了…",
            "nextDialogs": [
              "401260925"
            ]
          },
          "401260925": {
            "id": "401260925",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…谢谢你，芬奇，请你收下这个吧。",
            "nextDialogs": [
              "401260926"
            ]
          },
          "401260926": {
            "id": "401260926",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "好漂亮啊…",
            "nextDialogs": [
              "401260927"
            ]
          },
          "401260927": {
            "id": "401260927",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "是我的力量凝成的一粒水滴。",
            "nextDialogs": [
              "401260928"
            ]
          },
          "401260928": {
            "id": "401260928",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…芬奇，我无法拥有人类的实体，无法陪伴在你身边，下次幻化出人类的形体，不知要等多久…",
            "nextDialogs": [
              "401260929"
            ]
          },
          "401260929": {
            "id": "401260929",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "但只要你将这粒水珠带在身边，那么我们的心，不论相隔多远，都彼此相连。",
            "nextDialogs": [
              "401260930"
            ]
          },
          "401260930": {
            "id": "401260930",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "我永远与清泉同在，今后，你若呼唤我，我便会在梦里与你相见。",
            "nextDialogs": [
              "401260931"
            ]
          },
          "401260931": {
            "id": "401260931",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（就像一颗真正的「清泉之心」…）",
            "nextDialogs": [
              "401260932"
            ]
          },
          "401260932": {
            "id": "401260932",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这也太浪漫了吧！",
            "nextDialogs": [
              "401260933"
            ]
          },
          "401260933": {
            "id": "401260933",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嘘…！",
            "nextDialogs": [
              "401260934"
            ]
          },
          "401260934": {
            "id": "401260934",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "哈哈哈，你还真是学会了好多东西呢，也不怕孩子们在一旁看着…",
            "nextDialogs": [
              "401260935"
            ]
          },
          "401260935": {
            "id": "401260935",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…你不喜欢吗？",
            "nextDialogs": [
              "401260936"
            ]
          },
          "401260936": {
            "id": "401260936",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "怎么可能不喜欢？没有比这更幸福的事了…",
            "nextDialogs": [
              "401260937"
            ]
          },
          "401260937": {
            "id": "401260937",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "我都害怕，自己睡下去就再也不想醒过来…",
            "nextDialogs": [
              "401260938"
            ]
          },
          "401260938": {
            "id": "401260938",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "欸？这…这可不行…",
            "nextDialogs": [
              "401260939"
            ]
          },
          "401260939": {
            "id": "401260939",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "哈哈哈，刚才那句是玩笑，你啊，还有好多东西要学呢。",
            "nextDialogs": [
              "401260940"
            ]
          },
          "401260940": {
            "id": "401260940",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "这样吗…",
            "nextDialogs": [
              "401260941"
            ]
          },
          "401260941": {
            "id": "401260941",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "（嘿嘿，芬奇爷爷和卡莉露看起来都很开心，真好啊…）",
            "nextDialogs": [
              "401260942"
            ]
          },
          "401260942": {
            "id": "401260942",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "迪奥娜，谢谢你把芬奇带过来，我也不曾忘记你这位朋友。",
            "nextDialogs": [
              "401260943"
            ]
          },
          "401260943": {
            "id": "401260943",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "我当时找你聊天的时候，没有吵到你吧？",
            "nextDialogs": [
              "401260944"
            ]
          },
          "401260944": {
            "id": "401260944",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "当然没有，你是这片星空下我少有的朋友。",
            "nextDialogs": [
              "401260945"
            ]
          },
          "401260945": {
            "id": "401260945",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "我给予你的赠礼，同样会陪伴着你长大。",
            "nextDialogs": [
              "401260946"
            ]
          },
          "401260946": {
            "id": "401260946",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "…嗯？",
            "nextDialogs": [
              "401260947"
            ]
          },
          "401260947": {
            "id": "401260947",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "（难道说，迪奥娜调出美味饮料的体质，是这位精灵祝福的结果吗？）",
            "nextDialogs": [
              "401260948"
            ]
          },
          "401260948": {
            "id": "401260948",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "（我的纯阳之体…是否也是某人的「礼物」呢？）",
            "nextDialogs": [
              "401260949"
            ]
          },
          "401260949": {
            "id": "401260949",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "……",
            "nextDialogs": [
              "401260950"
            ]
          },
          "401260950": {
            "id": "401260950",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…这具形体，快要消散了。",
            "nextDialogs": [
              "401260951"
            ]
          },
          "401260951": {
            "id": "401260951",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "芬奇…",
            "nextDialogs": [
              "401260952"
            ]
          },
          "401260952": {
            "id": "401260952",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "嗯？",
            "nextDialogs": [
              "401260953"
            ]
          },
          "401260953": {
            "id": "401260953",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…我从没有后悔过遇见你，也从没后悔过那天夜里同你搭话。在这漫长的时光中，哪怕一刻也没有。",
            "nextDialogs": [
              "401260954"
            ]
          },
          "401260954": {
            "id": "401260954",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "…我又何尝不是呢？",
            "nextDialogs": [
              "401260955"
            ]
          },
          "401260955": {
            "id": "401260955",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "和人们传下的故事不同…那晚，我没有给予你那个吻…",
            "nextDialogs": [
              "401260956"
            ]
          },
          "401260956": {
            "id": "401260956",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "这代表誓约与爱的礼物，就现在赠予你吧…",
            "nextDialogs": [
              "401260958",
              "401260960"
            ]
          },
          "401260958": {
            "id": "401260958",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊？",
            "nextDialogs": [
              "401260961"
            ]
          },
          "401260961": {
            "id": "401260961",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "礼貌地闭上了眼…",
            "nextDialogs": [
              "401260962"
            ]
          },
          "401260962": {
            "id": "401260962",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "好啦，好啦…",
            "nextDialogs": [
              "401260963"
            ]
          },
          "401260963": {
            "id": "401260963",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "她已经走了…",
            "nextDialogs": [
              "401260964"
            ]
          },
          "401260964": {
            "id": "401260964",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？卡莉露…还没来得及道别。",
            "nextDialogs": [
              "401260965"
            ]
          },
          "401260965": {
            "id": "401260965",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "芬奇爷爷…",
            "nextDialogs": [
              "401260966"
            ]
          },
          "401260966": {
            "id": "401260966",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "放心吧，她一点都没走远…",
            "nextDialogs": [
              "401260967"
            ]
          },
          "401260967": {
            "id": "401260967",
            "speakerId": 1007,
            "speakerName": "老芬奇",
            "text": "就像她说的，她与清泉同在…就在我们周围，就在我们梦中…"
          },
          "401260960": {
            "id": "401260960",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "欸？"
          }
        }
      }
    },
    {
      "subId": "4012610",
      "subQuestName": "返回活动会场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401261001"
        ],
        "dialogs": {
          "401261001": {
            "id": "401261001",
            "speakerId": 1008,
            "speakerName": "温迪",
            "text": "哦？你们回来啦！看上去状态比之前更好呢。",
            "nextDialogs": [
              "401261002"
            ]
          },
          "401261002": {
            "id": "401261002",
            "speakerId": 1008,
            "speakerName": "温迪",
            "text": "胡堂主快人一步，这会儿已经在谈出诗集的事了。",
            "nextDialogs": [
              "401261003"
            ]
          },
          "401261003": {
            "id": "401261003",
            "speakerId": 1008,
            "speakerName": "温迪",
            "text": "就等着今天「自由撰诗」的稿件到手，用她的话说这叫「一条龙」服务。",
            "nextDialogs": [
              "401261004"
            ]
          },
          "401261004": {
            "id": "401261004",
            "speakerId": 1009,
            "speakerName": "行秋",
            "text": "你们去哪儿了？可让我好等！",
            "nextDialogs": [
              "401261005"
            ]
          },
          "401261005": {
            "id": "401261005",
            "speakerId": 1008,
            "speakerName": "温迪",
            "text": "一定是灵感不足，紧急采风去了吧？说不定还恰好在途中听到了不错的诗歌？",
            "nextDialogs": [
              "401261006"
            ]
          },
          "401261006": {
            "id": "401261006",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "卖唱的！难道你一开始就…",
            "nextDialogs": [
              "401261009"
            ]
          },
          "401261009": {
            "id": "401261009",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔！对…你，你一开始就想请我们吃顿好吃的！",
            "nextDialogs": [
              "401261010"
            ]
          },
          "401261010": {
            "id": "401261010",
            "speakerId": 1008,
            "speakerName": "温迪",
            "text": "咦？有那样的事吗？",
            "nextDialogs": [
              "401261011"
            ]
          },
          "401261011": {
            "id": "401261011",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我觉得这事值一顿。",
            "nextDialogs": [
              "401261012"
            ]
          },
          "401261012": {
            "id": "401261012",
            "speakerId": 1008,
            "speakerName": "温迪",
            "text": "#哈哈，好吧，既然{NICKNAME}都这么说了，看来这次请客我逃不掉喽。",
            "nextDialogs": [
              "401261013"
            ]
          },
          "401261013": {
            "id": "401261013",
            "speakerId": 1008,
            "speakerName": "温迪",
            "text": "那就麻烦迪奥娜为我们调两杯好喝的喽？",
            "nextDialogs": [
              "401261014"
            ]
          },
          "401261014": {
            "id": "401261014",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "哼！想得美。放平时我才不会答应呢，但看在我今天心情好的份上…",
            "nextDialogs": [
              "401261015"
            ]
          },
          "401261015": {
            "id": "401261015",
            "speakerId": 1009,
            "speakerName": "行秋",
            "text": "咦？所以你们到底干嘛去了？这种心照不宣的氛围是怎么回事？",
            "nextDialogs": [
              "401261016"
            ]
          },
          "401261016": {
            "id": "401261016",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "错觉错觉，一定是你的错觉啦。",
            "nextDialogs": [
              "401261017"
            ]
          },
          "401261017": {
            "id": "401261017",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "没…没错，我们只是…去远一些的地方采风了。",
            "nextDialogs": [
              "401261018"
            ]
          },
          "401261018": {
            "id": "401261018",
            "speakerId": 1009,
            "speakerName": "行秋",
            "text": "哦？连米卡都这么说…",
            "nextDialogs": [
              "401261019"
            ]
          },
          "401261019": {
            "id": "401261019",
            "speakerId": 1009,
            "speakerName": "行秋",
            "text": "重云，要不你偷偷告诉我发生了什么，我想起了一个你一定感兴趣的凶宅情报！",
            "nextDialogs": [
              "401261020"
            ]
          },
          "401261020": {
            "id": "401261020",
            "speakerId": 1009,
            "speakerName": "行秋",
            "text": "我敢说，这次恐怕连你的「纯阳之体」都起不了作用！",
            "nextDialogs": [
              "401261021"
            ]
          },
          "401261021": {
            "id": "401261021",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "多谢你的好心，但这次就不必了。",
            "nextDialogs": [
              "401261022"
            ]
          },
          "401261022": {
            "id": "401261022",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "我开始觉得…有这「纯阳之体」，或许也不是什么坏事…",
            "nextDialogs": [
              "401261023"
            ]
          },
          "401261023": {
            "id": "401261023",
            "speakerId": 1009,
            "speakerName": "行秋",
            "text": "咦？怎…怎么回事？",
            "nextDialogs": [
              "401261024"
            ]
          },
          "401261024": {
            "id": "401261024",
            "speakerId": 1009,
            "speakerName": "行秋",
            "text": "这当中果然还是发生了什么吧！"
          }
        }
      }
    },

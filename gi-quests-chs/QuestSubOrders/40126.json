    {
      "subId": "4012602",
      "subQuestName": "前往活动会场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401260201"
        ],
        "dialogs": {
          "401260201": {
            "id": "401260201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸，怎么感觉人变少了？",
            "nextDialogs": [
              "401260202"
            ]
          },
          "401260202": {
            "id": "401260202",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "两位早。行秋说他想认真写两首，晚点再来和大家会合。",
            "nextDialogs": [
              "401260203"
            ]
          },
          "401260203": {
            "id": "401260203",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "诺艾尔前辈今天也有其他任务在身，让我转告各位不用等她。",
            "nextDialogs": [
              "401260204"
            ]
          },
          "401260204": {
            "id": "401260204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好吧。还有卡莉露呢？卡莉露怎么也没有来？",
            "nextDialogs": [
              "401260205"
            ]
          },
          "401260205": {
            "id": "401260205",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "我很早就来了，没见到她呀。",
            "nextDialogs": [
              "401260206"
            ]
          },
          "401260206": {
            "id": "401260206",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "在说那位蓝色头发的小姐吗？我晨练的时候在荻花洲附近的桥头看到她了。",
            "nextDialogs": [
              "401260207"
            ]
          },
          "401260207": {
            "id": "401260207",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "她好像有些难过的样子。我没敢搭话…",
            "nextDialogs": [
              "401260208"
            ]
          },
          "401260208": {
            "id": "401260208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难过的样子？唔…怎么办，该不会是昨晚我们说错什么话了吧？我有些担心…",
            "nextDialogs": [
              "401260209"
            ]
          },
          "401260209": {
            "id": "401260209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一起去找找吧。",
            "nextDialogs": [
              "401260210"
            ]
          },
          "401260210": {
            "id": "401260210",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "我同意，如果卡莉露小姐遇到了什么困难，我想帮上她的忙。",
            "nextDialogs": [
              "401260211"
            ]
          },
          "401260211": {
            "id": "401260211",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "欸？都要去吗？那我也去。",
            "nextDialogs": [
              "401260212"
            ]
          },
          "401260212": {
            "id": "401260212",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "那就先从桥的附近找起吧？趁大家来得都早。",
            "nextDialogs": [
              "401260213"
            ]
          },
          "401260213": {
            "id": "401260213",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对，我们快去快回。"
          }
        }
      }
    },
    {
      "subId": "4012603",
      "subQuestName": "寻找卡莉露",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401260301"
        ],
        "dialogs": {
          "401260301": {
            "id": "401260301",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "欸？这里也是我们昨天遇到卡莉露小姐的地方！",
            "nextDialogs": [
              "401260302"
            ]
          },
          "401260302": {
            "id": "401260302",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "刚见面的时候，她也是一副心事重重的样子。",
            "nextDialogs": [
              "401260303"
            ]
          },
          "401260303": {
            "id": "401260303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "离我们放叶子的地方还挺近…",
            "nextDialogs": [
              "401260304"
            ]
          },
          "401260304": {
            "id": "401260304",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "叶子？",
            "nextDialogs": [
              "401260305"
            ]
          },
          "401260305": {
            "id": "401260305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对哦，昨天全在忙着对对子了…",
            "nextDialogs": [
              "401260306"
            ]
          },
          "401260306": {
            "id": "401260306",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "和众人讲述了昨天采风时发生的事…",
            "nextDialogs": [
              "401260307"
            ]
          },
          "401260307": {
            "id": "401260307",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "原来是这样…",
            "nextDialogs": [
              "401260308"
            ]
          },
          "401260308": {
            "id": "401260308",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "唔…我在想，卡莉露小姐会不会就是放下那片叶子的人呢？",
            "nextDialogs": [
              "401260309"
            ]
          },
          "401260309": {
            "id": "401260309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？为什么？",
            "nextDialogs": [
              "401260310"
            ]
          },
          "401260310": {
            "id": "401260310",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "啊，抱歉，我没什么根据，这仅仅是我的猜想罢了…",
            "nextDialogs": [
              "401260311"
            ]
          },
          "401260311": {
            "id": "401260311",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "卡莉露小姐当时的样子，和诗里那种悲伤的感觉很像…",
            "nextDialogs": [
              "401260312"
            ]
          },
          "401260312": {
            "id": "401260312",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "真要这么说的话…这里也的确是水流的上游…",
            "nextDialogs": [
              "401260313"
            ]
          },
          "401260313": {
            "id": "401260313",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "…嗯？",
            "nextDialogs": [
              "401260314"
            ]
          },
          "401260314": {
            "id": "401260314",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "欸！你们快看，那里那里！又一片树叶！",
            "nextDialogs": [
              "401260315"
            ]
          },
          "401260315": {
            "id": "401260315",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…真的！好像还写了字！",
            "nextDialogs": [
              "401260316"
            ]
          },
          "401260316": {
            "id": "401260316",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们快追上去吧！"
          }
        }
      }
    },
    {
      "subId": "4012611",
      "subQuestName": "追赶树叶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401261101"
        ],
        "dialogs": {
          "401261101": {
            "id": "401261101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可恶…它漂得好快…"
          }
        }
      }
    },
    {
      "subId": "4012612",
      "subQuestName": "追赶树叶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401261201"
        ],
        "dialogs": {
          "401261201": {
            "id": "401261201",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "派蒙不能飞过去捡吗？",
            "nextDialogs": [
              "401261202"
            ]
          },
          "401261202": {
            "id": "401261202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？可…可我不会游泳，万一飞太快掉到水里…"
          }
        }
      }
    },
    {
      "subId": "4012613",
      "subQuestName": "追赶树叶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401261301"
        ],
        "dialogs": {
          "401261301": {
            "id": "401261301",
            "speakerId": 1001,
            "speakerName": "重云",
            "text": "它停下来了！",
            "nextDialogs": [
              "401261302"
            ]
          },
          "401261302": {
            "id": "401261302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…趁现在！"
          }
        }
      }
    },
    {
      "subId": "4012614",
      "subQuestName": "捡起树叶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401261401"
        ],
        "dialogs": {
          "401261401": {
            "id": "401261401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呼…总算是追上了…",
            "nextDialogs": [
              "401261402"
            ]
          },
          "401261402": {
            "id": "401261402",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "上面的字还完整吗？没有被打湿吧？",
            "nextDialogs": [
              "401261403"
            ]
          },
          "401261403": {
            "id": "401261403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "能看清的，我看看上面写了什么…",
            "nextDialogs": [
              "401261404"
            ]
          },
          "401261404": {
            "id": "401261404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？这内容和我们昨天回的诗有关欸！她一定捡到了我们的叶子吧！",
            "nextDialogs": [
              "401261405"
            ]
          },
          "401261405": {
            "id": "401261405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「泉水」，「少年」…",
            "nextDialogs": [
              "401261406"
            ]
          },
          "401261406": {
            "id": "401261406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，这么一看，还真像卡莉露写的。",
            "nextDialogs": [
              "401261407"
            ]
          },
          "401261407": {
            "id": "401261407",
            "speakerId": 1003,
            "speakerName": "迪奥娜",
            "text": "她真的好在意那个故事呀。",
            "nextDialogs": [
              "401261408"
            ]
          },
          "401261408": {
            "id": "401261408",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，其实我一开始看到卡莉露就在猜…",
            "nextDialogs": [
              "401261409"
            ]
          },
          "401261409": {
            "id": "401261409",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你说她会不会是…",
            "nextDialogs": [
              "401261410"
            ]
          },
          "401261410": {
            "id": "401261410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是先找到她最重要。",
            "nextDialogs": [
              "401261411"
            ]
          },
          "401261411": {
            "id": "401261411",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "按照水域的流向和风力的影响…各位，请跟我来。"
          }
        }
      }
    },
    {
      "subId": "4012615",
      "subQuestName": "跟随米卡",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401261501"
        ],
        "dialogs": {
          "401261501": {
            "id": "401261501",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "…还行吗？要不要我扶着卡莉露小姐？",
            "nextDialogs": [
              "401261502"
            ]
          },
          "401261502": {
            "id": "401261502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我也可以让你靠一下…",
            "nextDialogs": [
              "401261503"
            ]
          },
          "401261503": {
            "id": "401261503",
            "speakerId": 1005,
            "speakerName": "卡莉露",
            "text": "…谢谢各位。"
          }
        }
      }
    },

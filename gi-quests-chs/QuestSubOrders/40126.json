        ],
        "dialogs": {
          "401269903": {
            "id": "401269903",
            "speakerId": 1002,
            "speakerName": "米卡",
            "text": "我们已经到比较上游的地方了，大家分散开，在附近找找吧。",
            "nextDialogs": [
              "401269904"
            ]
          },
          "401269904": {
            "id": "401269904",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "卡莉露——卡莉露——",
            "nextDialogs": [
              "401269905"
            ]
          },
          "401269905": {
            "id": "401269905",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呀！卡莉露被丘丘人围住了，我们快去帮帮她！"
          }
        }
      }
    }
  ]

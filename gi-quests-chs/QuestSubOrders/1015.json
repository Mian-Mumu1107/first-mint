    {
      "subId": "101513",
      "subQuestName": "(test)寻找声音来源$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10151301"
        ],
        "dialogs": {
          "10151301": {
            "id": "10151301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，柜台前没有人呢，气氛也有些诡异…",
            "nextDialogs": [
              "10151302"
            ]
          },
          "10151302": {
            "id": "10151302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "请问——老板在吗？",
            "nextDialogs": [
              "10151303"
            ]
          },
          "10151303": {
            "id": "10151303",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "欢迎光临。",
            "nextDialogs": [
              "10151304"
            ]
          },
          "10151304": {
            "id": "10151304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "10151305"
            ]
          },
          "10151305": {
            "id": "10151305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们刚才…有听见是从哪里传来的声音么…",
            "nextDialogs": [
              "10151306"
            ]
          },
          "10151306": {
            "id": "10151306",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "似乎是柜台那边。",
            "nextDialogs": [
              "10151307"
            ]
          },
          "10151307": {
            "id": "10151307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#这，这…要不，{NICKNAME}，你先过去看看？"
          }
        }
      }
    },
    {
      "subId": "101509",
      "subQuestName": "寻找声音来源",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10150901"
        ],
        "dialogs": {
          "10150901": {
            "id": "10150901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来在这儿！还没有柜台高！",
            "nextDialogs": [
              "10150903",
              "10150905"
            ]
          },
          "10150903": {
            "id": "10150903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…好像是真的！额头上还贴着符咒…",
            "nextDialogs": [
              "10150908"
            ]
          },
          "10150908": {
            "id": "10150908",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "欢迎光临「不卜庐」，我是七七。",
            "nextDialogs": [
              "10150909"
            ]
          },
          "10150909": {
            "id": "10150909",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "七七已经，死过一次。后来，被仙人救了。所以是，僵尸。"
          },
          "10150905": {
            "id": "10150905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！我是飞着的，所以身高不重要啦。",
            "nextDialogs": [
              "10150906"
            ]
          },
          "10150906": {
            "id": "10150906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说回来，她看上去是不是有些奇怪，额头上还贴着符咒…",
            "nextDialogs": [
              "10150907"
            ]
          },
          "10150907": {
            "id": "10150907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莫非是…「僵尸」吗！？"
          }
        }
      }
    },
    {
      "subId": "101502",

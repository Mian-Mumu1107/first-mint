      }
    },
    {
      "subId": "101503",
      "subQuestName": "(test)派蒙的提议$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10150301"
        ],
        "dialogs": {
          "10150301": {
            "id": "10150301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "想不到这么巨大，不愧是仙人留下的造物。",
            "nextDialogs": [
              "10150302"
            ]
          },
          "10150302": {
            "id": "10150302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是，这东西要怎么用呀，需要多大的力气才能操纵呢…",
            "nextDialogs": [
              "10150303"
            ]
          },
          "10150303": {
            "id": "10150303",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "现在是操纵不了的，因为坏了。",
            "nextDialogs": [
              "10150304"
            ]
          },
          "10150304": {
            "id": "10150304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然…坏了？",
            "nextDialogs": [
              "10150305"
            ]
          },
          "10150305": {
            "id": "10150305",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "毕竟历经了千年的风霜，再是仙家机关，也很难维持原样了。",
            "nextDialogs": [
              "10150306"
            ]
          },
          "10150306": {
            "id": "10150306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们可怎么办？钟离先生，快用你那无尽的「上流社会知识」想想办法呀！",
            "nextDialogs": [
              "10150307"
            ]
          },
          "10150307": {
            "id": "10150307",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "唔。怎么把我说得像是…除了听戏遛鸟，别的什么都不会的纨绔子弟一样？",
            "nextDialogs": [
              "10150308"
            ]
          },
          "10150308": {
            "id": "10150308",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "我想想…嗯，其实「归终机」建设之初，为了应对战损之类情况，是准备了备用材料的。",
            "nextDialogs": [
              "10150309"
            ]
          },
          "10150309": {
            "id": "10150309",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "若没猜错，在这「古城垣」之中，一定可以寻到当年的战备室。",
            "nextDialogs": [
              "10150310"
            ]
          },
          "10150310": {
            "id": "10150310",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "有了战备室里储存的材料，只要知道「归终机」的运作原理，想要修理也并非难事。",
            "nextDialogs": [
              "10150311"
            ]
          },
          "10150311": {
            "id": "10150311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说…钟离先生是知道原理的咯？",
            "nextDialogs": [
              "10150312"
            ]
          },
          "10150312": {
            "id": "10150312",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "略知一二。",
            "nextDialogs": [
              "10150313"
            ]
          },
          "10150313": {
            "id": "10150313",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "只要收集了<color=#00E1FFFF>足够的材料</color>，就可以稍稍尝试一下。"
          }
        }
      }
    },
    {
      "subId": "101504",
      "subQuestName": "从战备室获取材料",
      "sceneId": null,

        "dialogs": {
          "10151101": {
            "id": "10151101",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "好了，如此一来，帮工也雇了，「永生香」也已备齐。离典仪的准备完成也不远了。",
            "nextDialogs": [
              "10151102"

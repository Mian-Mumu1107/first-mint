            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…终于！",
            "nextDialogs": [
              "10151103"
            ]
          },
          "10151103": {
            "id": "10151103",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "如何？旅者。在这场向岩神辞行的旅途里，有什么收获吗？",
            "nextDialogs": [
              "10151104"
            ]
          },
          "10151104": {
            "id": "10151104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真是一趟奇奇怪怪的旅途。",
            "nextDialogs": [

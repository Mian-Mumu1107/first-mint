            ]
          },
          "10151105": {
            "id": "10151105",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "奇奇怪怪？",
            "nextDialogs": [
              "10151108"
            ]
          },
          "10151108": {
            "id": "10151108",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "哈哈哈，答案是哪一种呢？旅途中的疑问，总是如此复杂。",
            "nextDialogs": [
              "10151109"
            ]
          },
          "10151109": {
            "id": "10151109",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "旅者的体验就交给旅者自己慢慢咀嚼吧。对了，作为一起筹办「送仙典仪」的报酬，我决定——",
            "nextDialogs": [
              "10151110"
            ]
          },
          "10151110": {
            "id": "10151110",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "请客。"
          }
        }
      }

    {
      "subId": "101505",
      "subQuestName": "修理「归终机」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "101506",
      "subQuestName": "击败盗宝团成员$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10150601"
        ],
        "dialogs": {
          "10150601": {
            "id": "10150601",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "嗯，这些备用材料应该可以派上用场了。",
            "nextDialogs": [
              "10150602"
            ]
          },
          "10150602": {
            "id": "10150602",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "请二位稍等，我来尝试修理…",
            "nextDialogs": [
              "10150603"
            ]
          },
          "10150603": {
            "id": "10150603",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "完成了。「归终机」的结构，比我预想的还要精密一些。",
            "nextDialogs": [
              "10150604"
            ]
          },
          "10150604": {
            "id": "10150604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔哇，然后要怎么让它动起来呢？",
            "nextDialogs": [
              "10150605"
            ]
          },
          "10150605": {
            "id": "10150605",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "很简单，只要这样…看，仙家的机关，居然还自带「望远」之效。",
            "nextDialogs": [
              "10150617"
            ]
          },
          "10150617": {
            "id": "10150617",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里…没有…那里也没有…",
            "nextDialogs": [
              "10150606"
            ]
          },
          "10150606": {
            "id": "10150606",
            "speakerId": 10247,
            "speakerName": "黄麻子",
            "text": "喂！你们几个在折腾什么！",
            "nextDialogs": [
              "10150607"
            ]
          },
          "10150607": {
            "id": "10150607",
            "speakerId": 10247,
            "speakerName": "黄麻子",
            "text": "这是…这大弩枪，被你们给收拾好了？你们乱动这东西干什么？！",
            "nextDialogs": [
              "10150608"
            ]
          },
          "10150608": {
            "id": "10150608",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "不是什么弩枪，是「归终机」。还有——在提问前，先报上自家姓名。这是礼仪。",
            "nextDialogs": [
              "10150609"
            ]
          },
          "10150609": {
            "id": "10150609",
            "speakerId": 10247,
            "speakerName": "黄麻子",
            "text": "看不出来吗？哼，我们可是盗宝团的大佬。",
            "nextDialogs": [
              "10150610"
            ]
          },
          "10150610": {
            "id": "10150610",
            "speakerId": 10247,
            "speakerName": "黄麻子",
            "text": "传说这一带埋藏着各种宝贝，但这大弩枪虽然是个机器，却又好像是这一带的看守一样，非常难搞。",
            "nextDialogs": [
              "10150611"
            ]
          },
          "10150611": {
            "id": "10150611",
            "speakerId": 10247,
            "speakerName": "黄麻子",
            "text": "上次我们进山，有个兄弟差点被它穿成了串儿…",
            "nextDialogs": [
              "10150612"
            ]
          },
          "10150612": {
            "id": "10150612",
            "speakerId": 10247,
            "speakerName": "黄麻子",
            "text": "后来是我们几个冒着性命危险，才把这大家伙弄坏了的——可一转头，你们居然又把它修好了！？",
            "nextDialogs": [
              "10150613"
            ]
          },
          "10150613": {
            "id": "10150613",
            "speakerId": 10247,
            "speakerName": "黄麻子",
            "text": "我看今天，真得把你们好好修理修理！",
            "nextDialogs": [
              "10150614"
            ]
          },
          "10150614": {
            "id": "10150614",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "哼。为了一己私欲，玷污仙人智慧。",
            "nextDialogs": [
              "10150615"
            ]
          },
          "10150615": {
            "id": "10150615",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "你们，更应该得到些教训。",
            "nextDialogs": [
              "10150616"
            ]
          },
          "10150616": {
            "id": "10150616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#说得对！{NICKNAME}，我们上！"
          }
        }
      }
    },

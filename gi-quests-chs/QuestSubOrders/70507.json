    {
      "subId": "7050702",
      "subQuestName": "为钟离调制指定饮品",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705070201"
        ],
        "dialogs": {
          "705070201": {
            "id": "705070201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "久等啦！",
            "nextDialogs": [
              "705070202"
            ]
          },
          "705070202": {
            "id": "705070202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请慢用。",
            "nextDialogs": [
              "705070203"
            ]
          },
          "705070203": {
            "id": "705070203",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "茶汤透亮，色泽宜人，入口甘醇，更伴有花果香。嗯，相当难得。",
            "nextDialogs": [
              "705070204"
            ]
          },
          "705070204": {
            "id": "705070204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，钟离在喝茶方面也是行家呀。",
            "nextDialogs": [
              "705070205"
            ]
          },
          "705070205": {
            "id": "705070205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "像我「咕嘟」一口就喝下去了，只能说出好喝两个字。",
            "nextDialogs": [
              "705070206"
            ]
          },
          "705070206": {
            "id": "705070206",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "用心品尝，是对沏茶者的敬意。",
            "nextDialogs": [
              "705070207"
            ]
          },
          "705070207": {
            "id": "705070207",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "好茶十分难得，能将好茶泡得怡景怡情的沏茶者，更是难得。",
            "nextDialogs": [
              "705070210"
            ]
          },
          "705070210": {
            "id": "705070210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，我明白了。",
            "nextDialogs": [
              "705070211"
            ]
          },
          "705070211": {
            "id": "705070211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那…教教我你是怎么品茶的吧。我看是先闻再喝，对吗？",
            "nextDialogs": [
              "705070212"
            ]
          },
          "705070212": {
            "id": "705070212",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "不错。",
            "nextDialogs": [
              "705070213"
            ]
          },
          "705070213": {
            "id": "705070213",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "茶叶各有特征，喝得多了，自然有些心得。茶品好坏，闻香味便可略知一二了。",
            "nextDialogs": [
              "705070214"
            ]
          },
          "705070214": {
            "id": "705070214",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "有些茶闻起来湿腻，焦香过重，应是次品。另有一些，闻起来甘醇典雅，幽香扑面，这类茶多为上品。",
            "nextDialogs": [
              "705070215"
            ]
          },
          "705070215": {
            "id": "705070215",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "若想再讲究些，按璃月古时传统，还应备上「品香盏」。这件器皿能盛放茶汤，专用于品香。",
            "nextDialogs": [
              "705070216"
            ]
          },
          "705070216": {
            "id": "705070216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么办，感觉我之前都亏了…",
            "nextDialogs": [
              "705070217"
            ]
          },
          "705070217": {
            "id": "705070217",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "无妨。学问甚多，何时开始都不算迟。",
            "nextDialogs": [
              "705070218"
            ]
          },
          "705070218": {
            "id": "705070218",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "初学者可以试着这样品鉴：先观察水色，再轻嗅茶香，最后才是品茗。",
            "nextDialogs": [
              "705070219"
            ]
          },
          "705070219": {
            "id": "705070219",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "「由浅入深」，对万事万物的掌握皆是如此。"
          }
        }
      }
    },
    {

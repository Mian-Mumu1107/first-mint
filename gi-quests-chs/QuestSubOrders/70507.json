  "subQuests": [
    {
      "subId": "7050701",
      "subQuestName": "与卢卡对话，进入酒馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705070101"
        ],
        "dialogs": {
          "705070101": {
            "id": "705070101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "钟…钟离！",
            "nextDialogs": [
              "705070102"
            ]
          },
          "705070102": {
            "id": "705070102",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "许久不见，近来可好？",
            "nextDialogs": [
              "705070103"
            ]
          },
          "705070103": {
            "id": "705070103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不不不对…钟离，你怎么会在这里啊！",
            "nextDialogs": [
              "705070104"
            ]
          },
          "705070104": {
            "id": "705070104",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "既是闲游，就不该局限于眼前。风之国土自由丰饶，是一大好去处。",
            "nextDialogs": [
              "705070105"
            ]
          },
          "705070105": {
            "id": "705070105",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "能在这里遇见你们，实属意外之喜。",
            "nextDialogs": [
              "705070108"
            ]
          },
          "705070108": {
            "id": "705070108",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "一杯烟霞蔽芾。茶浓些更好，有劳你了。"
          }
        }
      }
    },

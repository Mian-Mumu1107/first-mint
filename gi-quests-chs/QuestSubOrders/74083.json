    {
      "subId": "7408207",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740820701"
        ],
        "dialogs": {
          "740820701": {
            "id": "740820701",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "一滴晶莹的水珠出现在了祭坛上。",
            "nextDialogs": [
              "740820780"
            ]
          },
          "740820780": {
            "id": "740820780",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "珀西芙似懂非懂地摸了摸头，又高兴地蹦跳了两下，然后略显匆忙地离开了。"
          }
        }
      }
    },
    {
      "subId": "7408301",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740830101"
        ],
        "dialogs": {
          "740830101": {
            "id": "740830101",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "一滴晶莹的水珠出现在了祭坛上。",
            "nextDialogs": [
              "740830102"
            ]
          },
          "740830102": {
            "id": "740830102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，这滴水珠…这滴水珠不会就是宝藏吧？",
            "nextDialogs": [
              "740830103"
            ]
          },
          "740830103": {
            "id": "740830103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "长得不太像宝藏。",
            "nextDialogs": [
              "740830104"
            ]
          },
          "740830104": {
            "id": "740830104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我也觉得…毕竟这么顺利就得到了…那它会是什么呢？",
            "nextDialogs": [
              "740830106",
              "740830111"
            ]
          },
          "740830106": {
            "id": "740830106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么？那我们岂不是闯大祸了，快！快把它放回去！希望还来得及！",
            "nextDialogs": [
              "740830107"
            ]
          },
          "740830107": {
            "id": "740830107",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "啊…",
            "nextDialogs": [
              "740830108"
            ]
          },
          "740830108": {
            "id": "740830108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "完蛋了！魔王出来了！",
            "nextDialogs": [
              "740830109"
            ]
          },
          "740830109": {
            "id": "740830109",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "魔王？美露莘。",
            "nextDialogs": [
              "740830115"
            ]
          },
          "740830115": {
            "id": "740830115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "吓死我了…原来是一位美露莘…你怎么在这里呀？",
            "nextDialogs": [
              "740830116"
            ]
          },
          "740830116": {
            "id": "740830116",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "钥匙。",
            "nextDialogs": [
              "740830117"
            ]
          },
          "740830117": {
            "id": "740830117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么…什么钥匙？这滴水珠是钥匙？",
            "nextDialogs": [
              "740830118"
            ]
          },
          "740830118": {
            "id": "740830118",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "珀西芙。",
            "nextDialogs": [
              "740830119"
            ]
          },
          "740830119": {
            "id": "740830119",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…这滴水珠是珀西芙？",
            "nextDialogs": [
              "740830120"
            ]
          },
          "740830120": {
            "id": "740830120",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "美露莘。",
            "nextDialogs": [
              "740830121"
            ]
          },
          "740830121": {
            "id": "740830121",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀！什么意思？这滴水珠是美露莘？我有点晕了，到底是什么啦，你不才是美露莘吗？",
            "nextDialogs": [
              "740830122"
            ]
          },
          "740830122": {
            "id": "740830122",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "珀西芙…",
            "nextDialogs": [
              "740830123"
            ]
          },
          "740830123": {
            "id": "740830123",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…你是珀西芙？还是你叫珀西芙？等等…我肯定会被你的答案弄得更晕…",
            "nextDialogs": [
              "740830124"
            ]
          },
          "740830124": {
            "id": "740830124",
            "speakerId": 1001,

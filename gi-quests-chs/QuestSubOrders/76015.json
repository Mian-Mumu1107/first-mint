  "subQuests": [
    {
      "subId": "7601501",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760150201"
        ],
        "dialogs": {
          "760150201": {
            "id": "760150201",
            "speakerId": 15550,
            "speakerName": "大嗓门的幽影",
            "text": "喂，你是谁？这是我的椅子，酒馆里谁不知道这是我███的位置。",
            "nextDialogs": [
              "760150202"
            ]
          },
          "760150202": {
            "id": "760150202",
            "speakerId": 15550,
            "speakerName": "大嗓门的幽影",
            "text": "你是刚来岛上报到还是怎么回事？别乱占别人位置啊。",
            "nextDialogs": [
              "760150203"
            ]
          },
          "760150203": {
            "id": "760150203",
            "speakerId": 15550,
            "speakerName": "大嗓门的幽影",
            "text": "我的啤酒怎么还没上，快点，我再坐会儿就得去巡夜了。",
            "nextDialogs": [
              "760150206"
            ]
          },
          "760150206": {
            "id": "760150206",
            "speakerId": 15550,
            "speakerName": "大嗓门的幽影",
            "text": "你非要坐也行，先来跟我们一起喝酒唱歌，熟了都是朋友，你要坐就坐吧。",
            "nextDialogs": [
              "760150207"
            ]
          },
          "760150207": {
            "id": "760150207",
            "speakerId": 15550,
            "speakerName": "大嗓门的幽影",
            "text": "会唱歌吧？哟吼，大伙唱一句你唱一句——",
            "nextDialogs": [
              "760150208"
            ]
          },
          "760150208": {
            "id": "760150208",
            "speakerId": 15550,
            "speakerName": "大嗓门的幽影",
            "text": "「邻家的舞曲让我忍不住踏脚！」",
            "nextDialogs": [
              "760150209"
            ]
          },
          "760150209": {
            "id": "760150209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「我在拉琴你们在微笑。」",
            "nextDialogs": [
              "760150210"
            ]
          },
          "760150210": {
            "id": "760150210",
            "speakerId": 15550,
            "speakerName": "大嗓门的幽影",
            "text": "「大家都在开心跳舞，嘿！嘿！」",
            "nextDialogs": [
              "760150211"
            ]
          },
          "760150211": {
            "id": "760150211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「我们聚起来，聚起来跳舞！」",
            "nextDialogs": [
              "760150212"
            ]
          },
          "760150212": {
            "id": "760150212",
            "speakerId": 15550,
            "speakerName": "大嗓门的幽影",
            "text": "啊哈，没错没错，就是这么唱，你习惯得很快嘛。",
            "nextDialogs": [
              "760150213"
            ]
          },
          "760150213": {
            "id": "760150213",
            "speakerId": 15550,
            "speakerName": "大嗓门的幽影",
            "text": "我的名字叫███，这下我们就算认识了。椅子你想坐就坐吧，我也不是小气的人。",
            "nextDialogs": [
              "760150214"
            ]
          },
          "760150214": {
            "id": "760150214",
            "speakerId": 15550,
            "speakerName": "大嗓门的幽影",
            "text": "你也是执灯士对吧，这杯啤酒算我请你的，说不定我们还能在训练的时候遇上。"
          }
        }
      }
    },
    {

    {
      "subId": "7526303",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752630301"
        ],
        "dialogs": {
          "752630301": {
            "id": "752630301",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "太不可思议了！真的有人击败了「疾风娜娜丝」！！",
            "nextDialogs": [
              "752630302"
            ]
          },
          "752630302": {
            "id": "752630302",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "#这位挑战者用来去如风的步伐夺得了今天的冠军，让我们恭喜{M#他}{F#她}！",
            "nextDialogs": [
              "752630303"
            ]
          },
          "752630303": {
            "id": "752630303",
            "speakerId": 6630,
            "speakerName": "「疾风娜娜丝」",
            "text": "我居然输了…这不可能！",
            "nextDialogs": [
              "752630304"
            ]
          },
          "752630304": {
            "id": "752630304",
            "speakerId": 1003,
            "speakerName": "兴奋的游客",
            "text": "#{M#他}{F#她}好厉害！",
            "nextDialogs": [
              "752630305"
            ]
          },
          "752630305": {
            "id": "752630305",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "但是——！老观众们应该都知道，「疾风娜娜丝」并不是悠悠极速赛场上出现过的最强选手！",
            "nextDialogs": [
              "752630306"
            ]
          },
          "752630306": {
            "id": "752630306",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "在「疾风娜娜丝」之前，还有两位堪称恐怖统治级的本土选手，它们今天也来到了赛场！",
            "nextDialogs": [
              "752630307"
            ]
          },
          "752630307": {
            "id": "752630307",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "让我们欢迎来无影——！",
            "nextDialogs": [
              "752630308"
            ]
          },
          "752630308": {
            "id": "752630308",
            "speakerId": 1004,
            "speakerName": "「来无影」",
            "text": "♪、♩~~",
            "nextDialogs": [
              "752630309"
            ]
          },
          "752630309": {
            "id": "752630309",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "去无踪——！",
            "nextDialogs": [
              "752630310"
            ]
          },
          "752630310": {
            "id": "752630310",
            "speakerId": 1005,
            "speakerName": "「去无踪」",
            "text": "♫ 、♩~~",
            "nextDialogs": [
              "752630311"
            ]
          },
          "752630311": {
            "id": "752630311",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "挑战者，这两位可是真正可怕的对手，以你刚才表现的实力，要战胜它们恐怕难于登天。",
            "nextDialogs": [
              "752630312"
            ]
          },
          "752630312": {
            "id": "752630312",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "你准备好了吗？",
            "nextDialogs": [
              "752630313"
            ]
          },
          "752630313": {
            "id": "752630313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准备好了！",
            "nextDialogs": [
              "752630314"
            ]
          },
          "752630314": {
            "id": "752630314",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "员工们布置好了赛场，观众也聚拢起来…你们站上了起跑线…"
          }
        }
      }
    },

    {
      "subId": "7526301",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752630101"
        ],
        "dialogs": {
          "752630101": {
            "id": "752630101",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "各位游客，悠悠极速大赛马上就要开始了！",
            "nextDialogs": [
              "752630102"
            ]
          },
          "752630102": {
            "id": "752630102",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "谁能击败昨天、前天和大前天的卫冕冠军「疾风娜娜丝」，谁就能得到我们今天的惊喜大奖！请还没有报名的游客抓紧最后的时间！",
            "nextDialogs": [
              "752630103"
            ]
          },
          "752630103": {
            "id": "752630103",
            "speakerId": 6630,
            "speakerName": "「疾风娜娜丝」",
            "text": "哼，面对我「疾风娜娜丝」，已经没有人敢再报名了吗？",
            "nextDialogs": [
              "752630104"
            ]
          },
          "752630104": {
            "id": "752630104",
            "speakerId": 1008,
            "speakerName": "沮丧的游客",
            "text": "唉，「疾风娜娜丝」太强了，已经连续三天拿走奖品了，没有人能赢的。",
            "nextDialogs": [
              "752630105"
            ]
          },
          "752630105": {
            "id": "752630105",
            "speakerId": 1009,
            "speakerName": "跃跃欲试的匿叶龙",
            "text": "嗷！！",
            "nextDialogs": [
              "752630106"
            ]
          },
          "752630106": {
            "id": "752630106",
            "speakerId": 1008,
            "speakerName": "沮丧的游客",
            "text": "欸？你想试试吗？",
            "nextDialogs": [
              "752630107"
            ]
          },
          "752630107": {
            "id": "752630107",
            "speakerId": 6630,
            "speakerName": "「疾风娜娜丝」",
            "text": "哼，已经沦落到只敢让龙出场了吗？胆小鬼们，把你们各自的龙都派上来吧，我「疾风娜娜丝」会告诉你们什么才是速度。",
            "nextDialogs": [
              "752630108"
            ]
          },
          "752630108": {
            "id": "752630108",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "真是一场别开生面的悠悠极速大赛！让我们看看强壮的龙伙伴们能否击败三连冠的「疾风娜娜丝」吧！"
          }
        }
      }
    },

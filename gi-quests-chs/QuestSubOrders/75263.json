    {
      "subId": "7526305",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752630501"
        ],
        "dialogs": {
          "752630501": {
            "id": "752630501",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "比赛结束！比赛结束！令人震惊的结果出现了！",
            "nextDialogs": [
              "752630502"
            ]
          },
          "752630502": {
            "id": "752630502",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "#我宣布，本场比赛最终的胜者是——{NICKNAME}！",
            "nextDialogs": [
              "752630503"
            ]
          },
          "752630503": {
            "id": "752630503",
            "speakerId": 1003,
            "speakerName": "兴奋的游客",
            "text": "#哇！{M#他}{F#她}也太强了吧！居然能打败「来无影」和「去无踪」！",
            "nextDialogs": [
              "752630504"
            ]
          },
          "752630504": {
            "id": "752630504",
            "speakerId": 1006,
            "speakerName": "激动的游客",
            "text": "#{M#他}{F#她}的身影就像一道金色闪电！",
            "nextDialogs": [
              "752630505"
            ]
          },
          "752630505": {
            "id": "752630505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂喂，没有银色闪电吗？你们都没看见银色闪电吗？",
            "nextDialogs": [
              "752630506"
            ]
          },
          "752630506": {
            "id": "752630506",
            "speakerId": 6630,
            "speakerName": "「疾风娜娜丝」",
            "text": "我输得好彻底…这大概是我永远抵达不了的速度吧…",
            "nextDialogs": [
              "752630507"
            ]
          },
          "752630507": {
            "id": "752630507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不要放弃。",
            "nextDialogs": [
              "752630508"
            ]
          },
          "752630508": {
            "id": "752630508",
            "speakerId": 6630,
            "speakerName": "「疾风娜娜丝」",
            "text": "我…我会以你为目标的…",
            "nextDialogs": [
              "752630509"
            ]
          },
          "752630509": {
            "id": "752630509",
            "speakerId": 1004,
            "speakerName": "「来无影」",
            "text": "♪、♩~~",
            "nextDialogs": [
              "752630510"
            ]
          },
          "752630510": {
            "id": "752630510",
            "speakerId": 1005,
            "speakerName": "「去无踪」",
            "text": "♫ 、♩~~",
            "nextDialogs": [
              "752630511"
            ]
          },
          "752630511": {
            "id": "752630511",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "请收下我们为本届冠军准备的奖品，这是你应得的！",
            "nextDialogs": [
              "752630512"
            ]
          },
          "752630512": {
            "id": "752630512",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "你的名字将会被悠悠极速大赛的赛史永远铭记！"
          }
        }
      }
    },

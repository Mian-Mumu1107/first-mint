  "subQuests": [
    {
      "subId": "7526301",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752630201"
        ],
        "dialogs": {
          "752630201": {
            "id": "752630201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也要报名。",
            "nextDialogs": [
              "752630202"
            ]
          },
          "752630202": {
            "id": "752630202",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "出人意料的转折，一位英勇的挑战者出现了！",
            "nextDialogs": [
              "752630203"
            ]
          },
          "752630203": {
            "id": "752630203",
            "speakerId": 6630,
            "speakerName": "「疾风娜娜丝」",
            "text": "哦？不自量力的小鬼。",
            "nextDialogs": [
              "752630204"
            ]
          },
          "752630204": {
            "id": "752630204",
            "speakerId": 6565,
            "speakerName": "基努",
            "text": "真是百转千回的进展…最后的赢家到底是谁？那就让我们拭目以待吧！",
            "nextDialogs": [
              "752630205"
            ]
          },
          "752630205": {
            "id": "752630205",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "员工们布置好了赛场，观众也聚拢起来…你们站上了起跑线…"
          }
        }
      }
    },

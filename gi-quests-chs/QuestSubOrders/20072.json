{
  "lineCounts": {
    "Player": 6,
    "芙萝拉": 23
  },
  "subQuests": [
    {
      "subId": "2007213",
      "subQuestName": "与芙萝拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200720401"
        ],
        "dialogs": {
          "200720401": {
            "id": "200720401",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "这边这边，来这边。",
            "nextDialogs": [
              "200720402"
            ]
          },
          "200720402": {
            "id": "200720402",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "你还记得上次我拜托你放进雪山的那些花吗？",
            "nextDialogs": [
              "200720403"
            ]
          },
          "200720403": {
            "id": "200720403",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "现在已经过了一天了，我想要看看冷藏的效果。",
            "nextDialogs": [
              "200720404"
            ]
          },
          "200720404": {
            "id": "200720404",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "你愿意帮我去雪山上，把那些花拿回来吗？",
            "nextDialogs": [
              "200720406",
              "200720408"
            ]
          },
          "200720406": {
            "id": "200720406",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "那就拜托你啦，我就在这里等你，请快去快回吧。"
          },
          "200720408": {
            "id": "200720408",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "你不记得了吗？是<color=#00E1FFFF>七天神像旁边</color>，<color=#00E1FFFF>山里的水边</color>，还有一个<color=#00E1FFFF>洞窟附近</color>哦。",
            "nextDialogs": [
              "200720409"
            ]
          },
          "200720409": {
            "id": "200720409",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "我再帮你在地图上标记一次吧。"
          }
        }
      }
    },
    {
      "subId": "2007201",
      "subQuestName": "前往雪山回收包裹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200720101"
        ],
        "dialogs": {
          "200720101": {
            "id": "200720101",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "之前存在雪山上的花怎么样啦？",
            "nextDialogs": [
              "200720102"
            ]
          },
          "200720102": {
            "id": "200720102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只拿到一份…",
            "nextDialogs": [
              "200720103"
            ]
          },
          "200720103": {
            "id": "200720103",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "其他的花是没能取回来吗？唔…好吧，毕竟雪山里的情况，确实很难预料呢。",
            "nextDialogs": [
              "200720104"
            ]
          },
          "200720104": {
            "id": "200720104",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "但只有这一份的话，就没法对比着看了，只能以后再找机会看看了…",
            "nextDialogs": [
              "200720105"
            ]
          },
          "200720105": {
            "id": "200720105",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "这次辛苦你帮忙，这是给你准备的报酬哦，以后说不定还要麻烦你。"
          }
        }
      }
    },
    {
      "subId": "2007202",
      "subQuestName": "回收雪山中七天神像附近的包裹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200720201"
        ],
        "dialogs": {
          "200720201": {
            "id": "200720201",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "花怎么样啦？",
            "nextDialogs": [
              "200720202"
            ]
          },
          "200720202": {
            "id": "200720202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对不起…",
            "nextDialogs": [
              "200720203"
            ]
          },
          "200720203": {
            "id": "200720203",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "嗯？怎么了？",
            "nextDialogs": [
              "200720204"
            ]
          },
          "200720204": {
            "id": "200720204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不小心把盒子和花弄坏了…",
            "nextDialogs": [
              "200720205"
            ]
          },
          "200720205": {
            "id": "200720205",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "弄、弄坏了？！",
            "nextDialogs": [
              "200720206"
            ]
          },
          "200720206": {
            "id": "200720206",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "呜…那可是我专门挑出来的花，那么好的花，可不是能轻易找到的…",
            "nextDialogs": [
              "200720207"
            ]
          },
          "200720207": {
            "id": "200720207",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "雪山真有这么危险吗？连你这样的冒险家都会失手，连一盒花都…",
            "nextDialogs": [
              "200720208"
            ]
          },
          "200720208": {
            "id": "200720208",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "不过，还是谢谢你帮我跑这一趟，这些东西给你，请收下吧，我要去打理店里的花了。",
            "nextDialogs": [
              "200720209"
            ]
          },
          "200720209": {
            "id": "200720209",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "唉，不然…我还是再用莎拉小姐的办法试试吧…"
          }
        }
      }
    },
    {
      "subId": "2007203",
      "subQuestName": "回收雪山中七天神像附近的包裹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200720301"
        ],
        "dialogs": {
          "200720301": {
            "id": "200720301",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "之前存在雪山上的花怎么样啦？",
            "nextDialogs": [
              "200720302"
            ]
          },
          "200720302": {
            "id": "200720302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "加上这次的都在这里了。",
            "nextDialogs": [
              "200720303"
            ]
          },
          "200720303": {
            "id": "200720303",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "都拿到了吗 ？太好了，快给我看看。",
            "nextDialogs": [
              "200720304"
            ]
          },
          "200720304": {
            "id": "200720304",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "呼呼，看起来不错呀，嗯…看来这个方法确实可行。",
            "nextDialogs": [
              "200720305"
            ]
          },
          "200720305": {
            "id": "200720305",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "不过，雪山距离蒙德城有些太远了，总不能每次都麻烦你，以后得想个方便的办法才行…",
            "nextDialogs": [
              "200720306"
            ]
          },
          "200720306": {
            "id": "200720306",
            "speakerId": 1425,
            "speakerName": "芙萝拉",
            "text": "总之，谢谢你来帮忙呀，这些是给你的谢礼，请拿着吧。"
          }
        }
      }
    },

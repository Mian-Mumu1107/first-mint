{
  "lineCounts": {
    "Player": 5,
    "兰利遮": 10,
    "加扎里": 2,
    "派蒙": 19
  },
  "subQuests": [
    {
      "subId": "7302701",
      "subQuestName": "离开「遗迹巨像」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730270101"
        ],
        "dialogs": {
          "730270101": {
            "id": "730270101",
            "speakerId": 20601,
            "speakerName": "加扎里",
            "text": "不管是谁，只要抱持着求索之心，学术的大门就会向他打开。",
            "nextDialogs": [
              "730270102"
            ]
          },
          "730270102": {
            "id": "730270102",
            "speakerId": 20601,
            "speakerName": "加扎里",
            "text": "秉持着这样的信念前进吧！"
          }
        }
      }
    },
    {
      "subId": "7302702",
      "subQuestName": "查看被砸中的地方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730270201"
        ],
        "dialogs": {
          "730270201": {
            "id": "730270201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，兰利遮，你怎么会在这里？",
            "nextDialogs": [
              "730270202"
            ]
          },
          "730270202": {
            "id": "730270202",
            "speakerId": 20600,
            "speakerName": "兰利遮",
            "text": "兰利遮种完花花之后就一直待在这边等你们啊。",
            "nextDialogs": [
              "730270203"
            ]
          },
          "730270203": {
            "id": "730270203",
            "speakerId": 20600,
            "speakerName": "兰利遮",
            "text": "结果不知道为什么刚才大铁山突然有东西掉下来，差点砸到兰利遮。",
            "nextDialogs": [
              "730270204"
            ]
          },
          "730270204": {
            "id": "730270204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊，兰利遮对不起！",
            "nextDialogs": [
              "730270205"
            ]
          },
          "730270205": {
            "id": "730270205",
            "speakerId": 20600,
            "speakerName": "兰利遮",
            "text": "派蒙为什么要道歉，兰利遮没关系的，兰利遮跑得快，所以不会被砸到。",
            "nextDialogs": [
              "730270206"
            ]
          },
          "730270206": {
            "id": "730270206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "总之你没事就好。",
            "nextDialogs": [
              "730270207"
            ]
          },
          "730270207": {
            "id": "730270207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来大机器人断掉的手臂真的把通往地下遗迹的入口砸开了。总算还是发挥了一点作用嘛。",
            "nextDialogs": [
              "730270208"
            ]
          },
          "730270208": {
            "id": "730270208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然这样我们就下去看看吧，不知道会有什么坏东西在等着我们呢！",
            "nextDialogs": [
              "730270209"
            ]
          },
          "730270209": {
            "id": "730270209",
            "speakerId": 20600,
            "speakerName": "兰利遮",
            "text": "兰利遮和你们一起去！"
          }
        }
      }
    },
    {
      "subId": "7302703",
      "subQuestName": "进入地下遗迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730270301"
        ],
        "dialogs": {
          "730270301": {
            "id": "730270301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那里面那个发光的东西应该就是加扎里先生说的上面那个大家伙的混沌炉心了吧。",
            "nextDialogs": [
              "730270302"
            ]
          },
          "730270302": {
            "id": "730270302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然看上去是被树枝和藤蔓封印住了，但好像有什么东西一直从里面流出来的样子。",
            "nextDialogs": [
              "730270303"
            ]
          },
          "730270303": {
            "id": "730270303",
            "speakerId": 20600,
            "speakerName": "兰利遮",
            "text": "呜呜，是脏东西，兰利遮能感觉到，就是这个让森林生病的。",
            "nextDialogs": [
              "730270304"
            ]
          },
          "730270304": {
            "id": "730270304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，有好多深渊法师在那几根大树枝旁边不知道在做些什么，总感觉没有什么好事。",
            "nextDialogs": [
              "730270305"
            ]
          },
          "730270305": {
            "id": "730270305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我记得加扎里先生说过，炉心的封印受到了破坏，该不会就是这些深渊法师搞的鬼吧。",
            "nextDialogs": [
              "730270306"
            ]
          },
          "730270306": {
            "id": "730270306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总之兰利遮先去外面找地方躲起来吧，我们去阻止他们！"
          }
        }
      }
    },
    {
      "subId": "7302704",
      "subQuestName": "调查地下遗迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730270401"
        ],
        "dialogs": {
          "730270401": {
            "id": "730270401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这下事情总算是告一段落了。",
            "nextDialogs": [
              "730270402"
            ]
          },
          "730270402": {
            "id": "730270402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，还真是一段漫长的冒险呀。",
            "nextDialogs": [
              "730270404",
              "730270407"
            ]
          },
          "730270404": {
            "id": "730270404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，他要是知道了炉心的事情，还可以帮我们申请经费什么的。",
            "nextDialogs": [
              "730270405"
            ]
          },
          "730270405": {
            "id": "730270405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不过，我可不想进入什么教令院。{NICKNAME}，你也不想的，对吧！",
            "nextDialogs": [
              "730270409"
            ]
          },
          "730270409": {
            "id": "730270409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总之，虽然不知道「无留陀的化身」到底和这些深渊教团有什么关系，不过治好了森林的「病」，也是件好事呀。",
            "nextDialogs": [
              "730270410"
            ]
          },
          "730270410": {
            "id": "730270410",
            "speakerId": 20600,
            "speakerName": "兰利遮",
            "text": "呜呜呜，兰利遮谢谢你们。",
            "nextDialogs": [
              "730270411"
            ]
          },
          "730270411": {
            "id": "730270411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不用谢，兰利遮。",
            "nextDialogs": [
              "730270412"
            ]
          },
          "730270412": {
            "id": "730270412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过接下来，兰利遮打算怎么办呢？",
            "nextDialogs": [
              "730270413"
            ]
          },
          "730270413": {
            "id": "730270413",
            "speakerId": 20600,
            "speakerName": "兰利遮",
            "text": "兰利遮要去参加无忧节，不过兰利遮很担心森林的「病」。",
            "nextDialogs": [
              "730270414"
            ]
          },
          "730270414": {
            "id": "730270414",
            "speakerId": 20600,
            "speakerName": "兰利遮",
            "text": "可能还会有希望森林生病的坏东西回来，兰利遮要保护森林。",
            "nextDialogs": [
              "730270415"
            ]
          },
          "730270415": {
            "id": "730270415",
            "speakerId": 20600,
            "speakerName": "兰利遮",
            "text": "所以无忧节之后，兰利遮还要回来这里。",
            "nextDialogs": [
              "730270416"
            ]
          },
          "730270416": {
            "id": "730270416",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "兰那罗也很辛苦啊。",
            "nextDialogs": [
              "730270417"
            ]
          },
          "730270417": {
            "id": "730270417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果兰利遮需要什么帮助的话，一定要过来找我们哦！",
            "nextDialogs": [
              "730270418"
            ]
          },
          "730270418": {
            "id": "730270418",
            "speakerId": 20600,
            "speakerName": "兰利遮",
            "text": "嗯嗯，兰利遮知道。",
            "nextDialogs": [
              "730270419"
            ]
          },
          "730270419": {
            "id": "730270419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，要照顾好自己，我们一定还会再见面的！"
          },
          "730270407": {
            "id": "730270407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，罗因贾爷爷一定会说「真是有趣的故事啊。」",
            "nextDialogs": [
              "730270408"
            ]
          },
          "730270408": {
            "id": "730270408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谁知道我们真的拯救了森林呢。"
          }
        }
      }
    },

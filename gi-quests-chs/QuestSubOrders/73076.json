  "subQuests": [
    {
      "subId": "7307602",
      "subQuestName": "（test）击杀鳄鱼王$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730760201"
        ],
        "dialogs": {
          "730760201": {
            "id": "730760201",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "哎呀…果然在须弥，才能感受到更多自然的气息啊，哈哈，相较而言，枫丹简直就是乌烟瘴气…",
            "nextDialogs": [
              "730760202"
            ]
          },
          "730760202": {
            "id": "730760202",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "嗯？怎么了，有什么事吗？",
            "nextDialogs": [
              "730760203"
            ]
          },
          "730760203": {
            "id": "730760203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只是有些好奇…",
            "nextDialogs": [
              "730760204"
            ]
          },
          "730760204": {
            "id": "730760204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是啊，你就住在这个帐篷里吗？",
            "nextDialogs": [
              "730760205"
            ]
          },
          "730760205": {
            "id": "730760205",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "对，最近一段时间我都住在这里…哈哈我懂了，看到一个枫丹人住在须弥野外的帐篷，觉得很不可思议对吧。",
            "nextDialogs": [
              "730760206"
            ]
          },
          "730760206": {
            "id": "730760206",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "至于为什么这样，就让我好好解释一番吧…啊，首先，两位的名字是？",
            "nextDialogs": [
              "730760207"
            ]
          },
          "730760207": {
            "id": "730760207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我叫派蒙。",
            "nextDialogs": [
              "730760208"
            ]
          },
          "730760208": {
            "id": "730760208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我叫{NICKNAME}。",
            "nextDialogs": [
              "730760209"
            ]
          },
          "730760209": {
            "id": "730760209",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "#原来如此，是{NICKNAME}和派蒙，我记住了。",
            "nextDialogs": [
              "730760210"
            ]
          },
          "730760210": {
            "id": "730760210",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "我是桑顿，如你们所见，我是一个枫丹人…之所以来须弥的理由嘛，当然是因为喜欢森林！",
            "nextDialogs": [
              "730760211"
            ]
          },
          "730760211": {
            "id": "730760211",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "总是生活在城市中，身体会因为缺少锻炼而衰弱，精神也会变得松懈和倦怠。",
            "nextDialogs": [
              "730760212"
            ]
          },
          "730760212": {
            "id": "730760212",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "只有在广袤的自然中，才能重新得到那种与自然万物共存的深刻体会，而森林正是贴近自然最好的选择。",
            "nextDialogs": [
              "730760213"
            ]
          },
          "730760213": {
            "id": "730760213",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "所以就来须弥了，毕竟这里的森林大概是全提瓦特最好的森林啦。",
            "nextDialogs": [
              "730760214"
            ]
          },
          "730760214": {
            "id": "730760214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像听懂了，但是又好像完全没有懂…",
            "nextDialogs": [
              "730760215"
            ]
          },
          "730760215": {
            "id": "730760215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过须弥的森林可是很危险的，有各种大大小小的魔物…",
            "nextDialogs": [
              "730760216"
            ]
          },
          "730760216": {
            "id": "730760216",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "当然要危险才行啊！",
            "nextDialogs": [
              "730760217"
            ]
          },
          "730760217": {
            "id": "730760217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？",
            "nextDialogs": [
              "730760218"
            ]
          },
          "730760218": {
            "id": "730760218",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "要是不危险的话，就没有那种求生的感觉了！不用担心，我其实在枫丹也是有名的猎人…",
            "nextDialogs": [
              "730760219"
            ]
          },
          "730760219": {
            "id": "730760219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么呀，原来你说喜欢森林，是喜欢在森林里狩猎！",
            "nextDialogs": [
              "730760220"
            ]
          },
          "730760220": {
            "id": "730760220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，根本就是个枫丹来的偷猎者！",
            "nextDialogs": [
              "730760223"
            ]
          },
          "730760223": {
            "id": "730760223",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "等等等等，你们弄错了，我可不是偷猎者…偷猎可是相当严重的违法行为。",
            "nextDialogs": [
              "730760224"
            ]
          },
          "730760224": {
            "id": "730760224",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "在枫丹如果被抓到偷猎，那一辈子就完了，我可不敢。我们枫丹猎人所做的，其实大多只是「凶猛动物的防治」而已。",
            "nextDialogs": [
              "730760225"
            ]
          },
          "730760225": {
            "id": "730760225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "凶猛动物的…防治？",
            "nextDialogs": [
              "730760226"
            ]
          },
          "730760226": {
            "id": "730760226",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "你想啊，太过靠近人类居住区的凶猛动物会导致双方都受到伤害吧…所以得把它们赶到居住区一定距离以外才行。",
            "nextDialogs": [
              "730760227"
            ]
          },
          "730760227": {
            "id": "730760227",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是、是这样啊…",
            "nextDialogs": [
              "730760228"
            ]
          },
          "730760228": {
            "id": "730760228",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "这样，附近的居民就不用面临凶猛动物的侵扰，而对于那些动物来说，居民的活动也不会对它们正常生活产生困扰。",
            "nextDialogs": [
              "730760229"
            ]
          },
          "730760229": {
            "id": "730760229",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "实不相瞒，我也是听说了附近有类似的凶猛动物，接受了驱逐它们的委托，才住在这里的，身为猎人，怎么能坐视不管呢！",
            "nextDialogs": [
              "730760230"
            ]
          },
          "730760230": {
            "id": "730760230",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "…当然了，我个人也对这些凶猛动物有点兴趣。",
            "nextDialogs": [
              "730760231"
            ]
          },
          "730760231": {
            "id": "730760231",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "你看，这个就很让人在意，「生长过度的大型鳄鱼」，被孩子们称为「鳄鱼大王」，总觉得是在什么下水道传说里出现的角色。",
            "nextDialogs": [
              "730760232"
            ]
          },
          "730760232": {
            "id": "730760232",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#啊，大型鳄鱼，{NICKNAME}，会不会说的就是我们遇到过的那条…",
            "nextDialogs": [
              "730760233"
            ]
          },
          "730760233": {
            "id": "730760233",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "什么，传说中的「鳄鱼大王」已经被你们驱逐掉了吗！",
            "nextDialogs": [
              "730760234"
            ]
          },
          "730760234": {
            "id": "730760234",
            "speakerId": 20743,
            "speakerName": "桑顿",
            "text": "据说「鳄鱼大王」在奔流之间浮出水面，就如突然升起、将河水阻断的巨大沙洲，怎么样，真的有那么夸张吗？"
          }
        }
      }
    },

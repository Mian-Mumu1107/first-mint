  },
  "subQuests": [
    {
      "subId": "4020505",
      "subQuestName": "等待到两天后",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402050501"
        ],
        "dialogs": {
          "402050501": {
            "id": "402050501",
            "speakerId": 15467,
            "speakerName": "尤斯塔奇",
            "text": "这位不就是那个叮铃哐啷蛋卷工坊的主人吗？久仰久仰！请问我有什么能帮到您的地方？",
            "nextDialogs": [
              "402050502"
            ]
          },
          "402050502": {
            "id": "402050502",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "让我来吧…长话短说，最近有没有人在这里交易来自叮铃哐啷蛋卷工坊的机械造物？",
            "nextDialogs": [
              "402050503"
            ]
          },
          "402050503": {
            "id": "402050503",
            "speakerId": 15467,
            "speakerName": "尤斯塔奇",
            "text": "…不瞒您说，我们只是个提供交易的平台，从来不会过问客户的交易内容——这也正是我们平台的一大优势。",
            "nextDialogs": [
              "402050504"
            ]
          },
          "402050504": {
            "id": "402050504",
            "speakerId": 15467,
            "speakerName": "尤斯塔奇",
            "text": "客户想买什么或者想卖什么，可以自行在告示牌上张贴告示，寻找合适的交易人选。",
            "nextDialogs": [
              "402050505"
            ]
          },
          "402050505": {
            "id": "402050505",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "这么随便？怪不得是非法黑市…",
            "nextDialogs": [
              "402050506"
            ]
          },
          "402050506": {
            "id": "402050506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，第一张告示的内容好像就是重金收购爱诺最新制作的机械造物！？",
            "nextDialogs": [
              "402050507"
            ]
          },
          "402050507": {
            "id": "402050507",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "铛铛七分甜是被偷走的，你竟然允许这种交易，你也是坏蛋？",
            "nextDialogs": [
              "402050508"
            ]
          },
          "402050508": {
            "id": "402050508",
            "speakerId": 15467,
            "speakerName": "尤斯塔奇",
            "text": "话可不能这么讲啊，就像我说的那样，我们从来不会过问客户的交易内容。",
            "nextDialogs": [
              "402050509"
            ]
          },
          "402050509": {
            "id": "402050509",
            "speakerId": 15467,
            "speakerName": "尤斯塔奇",
            "text": "在我们看来，对客户之间的争端保持中立才是专业的表现。",
            "nextDialogs": [
              "402050510"
            ]
          },
          "402050510": {
            "id": "402050510",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "…铛铛七分甜是我的伙伴，我才不要让它像一件商品那样被卖来卖去。",
            "nextDialogs": [
              "402050511"
            ]
          },
          "402050511": {
            "id": "402050511",
            "speakerId": 15467,
            "speakerName": "尤斯塔奇",
            "text": "喂喂，可不能撕啊！至少在今天闭市之前，我都得保证让这张告示留在告示牌上，还请见谅。",
            "nextDialogs": [
              "402050512"
            ]
          },
          "402050512": {
            "id": "402050512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你刚刚还说过要对客户之间的争端保持中立…",
            "nextDialogs": [
              "402050513"
            ]
          },
          "402050513": {
            "id": "402050513",
            "speakerId": 15467,
            "speakerName": "尤斯塔奇",
            "text": "哎呀，张贴这张告示的是付费客户…",
            "nextDialogs": [
              "402050514"
            ]
          },
          "402050514": {
            "id": "402050514",
            "speakerId": 15467,
            "speakerName": "尤斯塔奇",
            "text": "您看，平台还是要赚钱的，如果您愿意支付更多的摩拉，倒是可以新贴一张告示，把那张覆盖掉。",
            "nextDialogs": [
              "402050515"
            ]
          },
          "402050515": {
            "id": "402050515",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "唉…每个地方都有自己的规矩，这样闹也没有意义。我们不是找到线索了吗？先看看这张告示说了些什么。",
            "nextDialogs": [
              "402050516"
            ]
          },
          "402050516": {
            "id": "402050516",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "让我看看…重金求购一台机械造物，从风格来看是叮铃哐啷蛋卷工坊的作品，详情可面谈…",
            "nextDialogs": [
              "402050517"
            ]
          },
          "402050517": {
            "id": "402050517",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "根据线人提供的情报，目前这种机械造物仅发现一台，且已落入霜月之子手中…",
            "nextDialogs": [
              "402050518"
            ]
          },
          "402050518": {
            "id": "402050518",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "只要能提供一台这样的机械造物，必有重金酬谢…",
            "nextDialogs": [
              "402050519"
            ]
          },
          "402050519": {
            "id": "402050519",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在霜月之子手中？难道…",
            "nextDialogs": [
              "402050520"
            ]
          },
          "402050520": {
            "id": "402050520",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "工坊位于霜月之坊和那夏镇之间，如果有霜月之子的族民想去镇里办事，就要从工坊路过。",
            "nextDialogs": [
              "402050521"
            ]
          },
          "402050521": {
            "id": "402050521",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "时间久了，我和伊涅芙都不对他们设防…",
            "nextDialogs": [
              "402050522"
            ]
          },
          "402050522": {
            "id": "402050522",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样看来，还真有可能是霜月之子的人偷的？他们为什么要偷爱诺的机器人伙伴？",
            "nextDialogs": [
              "402050523"
            ]
          },
          "402050523": {
            "id": "402050523",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "…看来他们也馋上了铛铛七分甜烤制的甜品，所以才对它下手。",
            "nextDialogs": [
              "402050524"
            ]
          },
          "402050524": {
            "id": "402050524",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？",
            "nextDialogs": [
              "402050525"
            ]
          },
          "402050525": {
            "id": "402050525",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "伊涅芙总是严格控制我的甜食摄入量，所以我设计了铛铛七分甜。只要输入配方，提供原料，它就能自动烤制甜品！",
            "nextDialogs": [
              "402050526"
            ]
          },
          "402050526": {
            "id": "402050526",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "能烤制甜品的机器人？就为了这个？",
            "nextDialogs": [
              "402050527"
            ]
          },
          "402050527": {
            "id": "402050527",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "哈哈，你觉得这样的说法真的能瞒过挪德卡莱的各方势力吗？工坊的主人。",
            "nextDialogs": [
              "402050528"
            ]
          },
          "402050528": {
            "id": "402050528",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "你又是谁？",
            "nextDialogs": [
              "402050529"
            ]
          },
          "402050529": {
            "id": "402050529",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "这不是阿斯科吗？他在我老板那里也算是有头有脸的人物…不过话说回来，这样的人物为什么要来这里做生意？",
            "nextDialogs": [
              "402050530"
            ]
          },
          "402050530": {
            "id": "402050530",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "有的生意可以和伏尼契商会做，而有的生意就必须来这里做。",
            "nextDialogs": [
              "402050531"
            ]
          },
          "402050531": {
            "id": "402050531",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "但只要是能赚钱的生意，我都感兴趣——你们刚刚看到的告示就是我派人贴的。",
            "nextDialogs": [
              "402050532"
            ]
          },
          "402050532": {
            "id": "402050532",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "原来想买卖铛铛七分甜的人是你？那你也是坏蛋！",
            "nextDialogs": [
              "402050533"
            ]
          },
          "402050533": {
            "id": "402050533",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "不要这样，在商言商嘛。",
            "nextDialogs": [
              "402050534"
            ]
          },
          "402050534": {
            "id": "402050534",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "我确实对你那件作品很感兴趣，之前尝试过从那些霜月之子手中收购，可惜这些信徒都太死板了，不肯松口。",
            "nextDialogs": [
              "402050535"
            ]
          },
          "402050535": {
            "id": "402050535",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "看来还是得找正主谈，那种机械造物能不能再造一台？我愿意出高价收购，把那张告示上的价格再翻十倍也可以。",
            "nextDialogs": [
              "402050536"
            ]
          },
          "402050536": {
            "id": "402050536",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "我才不跟坏蛋谈…",
            "nextDialogs": [
              "402050537"
            ]
          },
          "402050537": {
            "id": "402050537",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "那个告示上没有限定手段，换言之，去偷去抢都可以…",
            "nextDialogs": [
              "402050538"
            ]
          },
          "402050538": {
            "id": "402050538",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "只是一台可以烤蛋糕的机器人而已，不至于让阁下做这么不体面的事吧？",
            "nextDialogs": [
              "402050539"
            ]
          },
          "402050539": {
            "id": "402050539",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "不如把线人提供的情报向我们透漏一些，也算是让叮铃哐啷蛋卷工坊欠阁下一个人情？",
            "nextDialogs": [
              "402050540"
            ]
          },
          "402050540": {
            "id": "402050540",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "可是根据我收到的情报，它成功移植了「轰隆隆月矩力能量炮」所使用的技术，一旦被改造成兵器，必定威力惊人。",
            "nextDialogs": [
              "402050541"
            ]
          },
          "402050541": {
            "id": "402050541",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "什么？",
            "nextDialogs": [
              "402050542"
            ]
          },
          "402050542": {
            "id": "402050542",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "看看那门大炮吧，它能将月矩力浓缩成极具破坏性的能量，然而它太巨大，太笨重，既无法量产，也无法运输。",
            "nextDialogs": [
              "402050543"
            ]
          },
          "402050543": {
            "id": "402050543",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "再加上每次发射都需要大量时间来筹备弹药…总而言之，根本无法成为一件商品。",
            "nextDialogs": [
              "402050544"
            ]
          },
          "402050544": {
            "id": "402050544",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "不过，如果能将其小型化，量产化，虽然无法复现那门大炮的威力，但可以得到一种完美的商品。",
            "nextDialogs": [
              "402050545"
            ]
          },
          "402050545": {
            "id": "402050545",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "另外，请你们仔细想想，这或许就是霜月之子盯上这个机械造物的原因。",
            "nextDialogs": [
              "402050546"
            ]
          },
          "402050546": {
            "id": "402050546",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "在他们的教义里，月矩力是一种圣洁的神力，不容亵渎。",
            "nextDialogs": [
              "402050547"
            ]
          },
          "402050547": {
            "id": "402050547",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "那夏镇的大炮将月矩力作为一种对抗「狂猎」，保护居民的手段，在他们看来倒也不是不能接受。",
            "nextDialogs": [
              "402050548"
            ]
          },
          "402050548": {
            "id": "402050548",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "但如果将那种大炮使用的技术变成一种商品，任由其流入黑市，无论是谁，只要花钱就可以掌控月矩力的威能…",
            "nextDialogs": [
              "402050549"
            ]
          },
          "402050549": {
            "id": "402050549",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "对于那些霜月之子而言，这完全是渎神之举。",
            "nextDialogs": [
              "402050550"
            ]
          },
          "402050550": {
            "id": "402050550",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "所以，不如把这种技术转卖给我吧，就当是把这些麻烦交给我来承担，很划算，不是吗？",
            "nextDialogs": [
              "402050551"
            ]
          },
          "402050551": {
            "id": "402050551",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "你这家伙该不会是又造出了什么危险的东西吧？",
            "nextDialogs": [
              "402050552"
            ]
          },
          "402050552": {
            "id": "402050552",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "我已经说过了，铛铛七分甜能烤制甜品，超好吃的甜品，它才不是什么战争兵器！",
            "nextDialogs": [
              "402050553"
            ]
          },
          "402050553": {
            "id": "402050553",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "铛铛七分甜是我的伙伴，我一定会把它救回来的，你死心吧！",
            "nextDialogs": [
              "402050554"
            ]
          },
          "402050554": {
            "id": "402050554",
            "speakerId": 15543,
            "speakerName": "阿斯科",
            "text": "跟正主也没得谈…真遗憾啊。",
            "nextDialogs": [
              "402050555"
            ]
          },
          "402050555": {
            "id": "402050555",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "接下来，我们该怎么办？",
            "nextDialogs": [
              "402050556"
            ]
          },
          "402050556": {
            "id": "402050556",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "至少我们知道小偷在霜月之子那里吧，只要我们过去，然后…唔…",
            "nextDialogs": [
              "402050557"
            ]
          },
          "402050557": {
            "id": "402050557",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许可以找菈乌玛帮忙。",
            "nextDialogs": [
              "402050558"
            ]
          },
          "402050558": {
            "id": "402050558",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦！",
            "nextDialogs": [
              "402050559"
            ]
          },
          "402050559": {
            "id": "402050559",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "稍等一下，我必须提醒你们，要是那个商人说的都是真的，事情就很难办了，可要有心理准备哦。"
          }
        }
      }
    },
    {
      "subId": "4020506",
      "subQuestName": "前往与雅珂达约定的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402050301"
        ],
        "dialogs": {
          "402050301": {
            "id": "402050301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好啊，雅珂达。哇，那里果然来了好多人！",
            "nextDialogs": [
              "402050302"
            ]
          },
          "402050302": {
            "id": "402050302",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "可不要小瞧了我的情报网。这样吧，我们先查一查这里的交易记录，那个小偷有可能在这里出手他偷到的东西…",
            "nextDialogs": [
              "402050303"
            ]
          },
          "402050303": {
            "id": "402050303",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "喂！是哪个坏蛋偷走了我的机器人伙伴？站出来，好好交代！",
            "nextDialogs": [
              "402050304"
            ]
          },
          "402050304": {
            "id": "402050304",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（不是这么查的…）",
            "nextDialogs": [
              "402050305"
            ]
          },
          "402050305": {
            "id": "402050305",
            "speakerId": 1006,
            "speakerName": "黑市商人们",
            "text": "……",
            "nextDialogs": [
              "402050306"
            ]
          },
          "402050306": {
            "id": "402050306",
            "speakerId": 15541,
            "speakerName": "好奇的商人",
            "text": "这位莫非就是那个工坊的主人？",
            "nextDialogs": [
              "402050307"
            ]
          },
          "402050307": {
            "id": "402050307",
            "speakerId": 15542,
            "speakerName": "急切的商人",
            "text": "来得正好，更方便谈生意嘛。",
            "nextDialogs": [
              "402050308"
            ]
          },
          "402050308": {
            "id": "402050308",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "你们…你们谁是那个小偷？",
            "nextDialogs": [
              "402050309"
            ]
          },
          "402050309": {
            "id": "402050309",
            "speakerId": 15541,
            "speakerName": "好奇的商人",
            "text": "什么小偷？这里只有生意人。我想订制一种机械，价钱都好说！",
            "nextDialogs": [
              "402050310"
            ]
          },
          "402050310": {
            "id": "402050310",
            "speakerId": 15542,
            "speakerName": "急切的商人",
            "text": "那个机器人女仆是你造出来的吧？这种技术卖不卖？我也想拥有一个机器人女仆！",
            "nextDialogs": [
              "402050311"
            ]
          },
          "402050311": {
            "id": "402050311",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "你们…都闪开！",
            "nextDialogs": [
              "402050312"
            ]
          },
          "402050312": {
            "id": "402050312",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "咳咳！连最基本的规矩都不懂，怪不得沦落到在这种非法黑市里做生意。",
            "nextDialogs": [
              "402050313"
            ]
          },
          "402050313": {
            "id": "402050313",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "就算工坊的主人愿意和你们做交易，也得通过这里的柜台来谈，明白吗？",
            "nextDialogs": [
              "402050314"
            ]
          },
          "402050314": {
            "id": "402050314",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "爱诺这家伙的机械造物放眼整个挪德卡莱都是抢手货，也不能怪这帮商人如此热情。",
            "nextDialogs": [
              "402050315"
            ]
          },
          "402050315": {
            "id": "402050315",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "无论是伊涅芙还是铛铛七分甜，都不是用来买卖的，这里的大人都让我很讨厌。",
            "nextDialogs": [
              "402050316"
            ]
          },
          "402050316": {
            "id": "402050316",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#不过，{NICKNAME}说得对，这里的大人就算做贼也不会心虚，我的方法行不通…",
            "nextDialogs": [
              "402050317"
            ]
          },
          "402050317": {
            "id": "402050317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你真的想用那种方法把小偷揪出来啊？",
            "nextDialogs": [
              "402050318"
            ]
          },
          "402050318": {
            "id": "402050318",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "没见过世面吧？这里的商人眼里只有钱，而道德在他们眼里不值钱。",
            "nextDialogs": [
              "402050319"
            ]
          },
          "402050319": {
            "id": "402050319",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "线索还是得从柜台那边找，跟我来。"
          }
        }
      }
    },
    {
      "subId": "4020507",
      "subQuestName": "前往柜台",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4020501",
      "subQuestName": "前往霜月之坊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402050101"
        ],
        "dialogs": {
          "402050101": {
            "id": "402050101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好啊，菈乌玛！",
            "nextDialogs": [
              "402050102"
            ]
          },
          "402050102": {
            "id": "402050102",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "#{NICKNAME}和派蒙？愿月光联系着你我，不论日夜。嗯…心中烦扰，不妨直言。",
            "nextDialogs": [
              "402050103"
            ]
          },
          "402050103": {
            "id": "402050103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你又看出来啦？",
            "nextDialogs": [
              "402050104"
            ]
          },
          "402050104": {
            "id": "402050104",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "沐浴着月光的愁容正如满月的暗斑，于阴晴之间流露心绪。",
            "nextDialogs": [
              "402050105"
            ]
          },
          "402050105": {
            "id": "402050105",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "让她先别说话，果然闹情绪了…咏月使大人，请先听我讲。",
            "nextDialogs": [
              "402050106"
            ]
          },
          "402050106": {
            "id": "402050106",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "雅珂达仔细讲述了你们来这里的原因，她的措辞很小心。",
            "nextDialogs": [
              "402050107"
            ]
          },
          "402050107": {
            "id": "402050107",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "…偷盗？此举卑劣，当为霜月之子所不齿。",
            "nextDialogs": [
              "402050108"
            ]
          },
          "402050108": {
            "id": "402050108",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "目前都还只是猜测…",
            "nextDialogs": [
              "402050109"
            ]
          },
          "402050109": {
            "id": "402050109",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "请稍等片刻。",
            "nextDialogs": [
              "402050110"
            ]
          },
          "402050110": {
            "id": "402050110",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "前几日，确实有一些族人带回了某种机械造物，请随我前去与他们当面对质，个中是非，自可辨明。"
          }
        }
      }
    },
    {
      "subId": "4020508",
      "subQuestName": "与族人对质",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402050701"
        ],
        "dialogs": {
          "402050701": {
            "id": "402050701",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "愿月光联系着你我，咏月使大人，请问您找我们有什么事？",
            "nextDialogs": [
              "402050702"
            ]
          },
          "402050702": {
            "id": "402050702",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "菈乌玛转述了你们来到这里的原因。",
            "nextDialogs": [
              "402050703"
            ]
          },
          "402050703": {
            "id": "402050703",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "偷盗？我们怎么会做这种事？这是凭空污蔑！",
            "nextDialogs": [
              "402050704"
            ]
          },
          "402050704": {
            "id": "402050704",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "我们确实带回了一种危险的机械造物，但它并非是我们偷来的，而是从一伙匪徒手里抢到的。",
            "nextDialogs": [
              "402050705"
            ]
          },
          "402050705": {
            "id": "402050705",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "若有误会，那就向客人们澄清。",
            "nextDialogs": [
              "402050706"
            ]
          },
          "402050706": {
            "id": "402050706",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "我记得那是几天前，在附近的野外…",
            "nextDialogs": [
              "402050707"
            ]
          },
          "402050707": {
            "id": "402050707",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "嗯？那些人在干什么？",
            "nextDialogs": [
              "402050708"
            ]
          },
          "402050708": {
            "id": "402050708",
            "speakerId": 15533,
            "speakerName": "急躁的盗宝团成员",
            "text": "还没好吗？我们得在被那帮原住民发现之前完成测试！",
            "nextDialogs": [
              "402050709"
            ]
          },
          "402050709": {
            "id": "402050709",
            "speakerId": 15534,
            "speakerName": "冒失的盗宝团成员",
            "text": "就不能去其他地方吗？这活儿干得提心吊胆…",
            "nextDialogs": [
              "402050710"
            ]
          },
          "402050710": {
            "id": "402050710",
            "speakerId": 15533,
            "speakerName": "急躁的盗宝团成员",
            "text": "蠢货，没听雇主说吗？这玩意儿对月矩力有特殊的需求，要不然也不用跑到这个地方来。闭上嘴，抓紧时间！",
            "nextDialogs": [
              "402050711"
            ]
          },
          "402050711": {
            "id": "402050711",
            "speakerId": 15534,
            "speakerName": "冒失的盗宝团成员",
            "text": "别喊，让我想想，应该是这里…",
            "nextDialogs": [
              "402050712"
            ]
          },
          "402050712": {
            "id": "402050712",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "什么！？",
            "nextDialogs": [
              "402050713"
            ]
          },
          "402050713": {
            "id": "402050713",
            "speakerId": 15533,
            "speakerName": "急躁的盗宝团成员",
            "text": "你干了什么？这动静不被人注意到才怪！",
            "nextDialogs": [
              "402050714"
            ]
          },
          "402050714": {
            "id": "402050714",
            "speakerId": 15534,
            "speakerName": "冒失的盗宝团成员",
            "text": "这…至少我们验证了这玩意儿的威力，不是吗？肯定可以回去交差了！",
            "nextDialogs": [
              "402050715"
            ]
          },
          "402050715": {
            "id": "402050715",
            "speakerId": 15533,
            "speakerName": "急躁的盗宝团成员",
            "text": "唉，算是吧，那就收拾东西赶紧撤！",
            "nextDialogs": [
              "402050716"
            ]
          },
          "402050716": {
            "id": "402050716",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "站住！放下你们持有的危险物品！",
            "nextDialogs": [
              "402050717"
            ]
          },
          "402050717": {
            "id": "402050717",
            "speakerId": 15533,
            "speakerName": "急躁的盗宝团成员",
            "text": "这么快？这玩意儿还能再启动一次吗？",
            "nextDialogs": [
              "402050718"
            ]
          },
          "402050718": {
            "id": "402050718",
            "speakerId": 15534,
            "speakerName": "冒失的盗宝团成员",
            "text": "刚刚的操作我也记不清了…这我可搬不动啊。",
            "nextDialogs": [
              "402050719"
            ]
          },
          "402050719": {
            "id": "402050719",
            "speakerId": 15533,
            "speakerName": "急躁的盗宝团成员",
            "text": "唉…赶紧跑吧，最重要的是我们不能被抓了现行！",
            "nextDialogs": [
              "402050720"
            ]
          },
          "402050720": {
            "id": "402050720",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "就是这样，我们没能抓到人，但是我们截获了他们手中的那种机械造物。",
            "nextDialogs": [
              "402050721"
            ]
          },
          "402050721": {
            "id": "402050721",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "爱诺，我再确认一下，你不会又造出了什么危险的东西吧？",
            "nextDialogs": [
              "402050722"
            ]
          },
          "402050722": {
            "id": "402050722",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "或许这是另一个误会？阿索看到的那种机械造物不一定就是铛铛七分甜吧？",
            "nextDialogs": [
              "402050723"
            ]
          },
          "402050723": {
            "id": "402050723",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "嗯…那种机械造物上面有没有这个标识？",
            "nextDialogs": [
              "402050724"
            ]
          },
          "402050724": {
            "id": "402050724",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "嗯，有的。",
            "nextDialogs": [
              "402050725"
            ]
          },
          "402050725": {
            "id": "402050725",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "这是我为伙伴特别设计的标识，每次加标识的时候都会特殊处理一下，就算拆卸改装也绝对抹不掉。",
            "nextDialogs": [
              "402050726"
            ]
          },
          "402050726": {
            "id": "402050726",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "所以，那确实是铛铛七分甜…",
            "nextDialogs": [
              "402050727"
            ]
          },
          "402050727": {
            "id": "402050727",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "既然误会已经澄清，就物归原主吧。",
            "nextDialogs": [
              "402050728"
            ]
          },
          "402050728": {
            "id": "402050728",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "恕我直言，咏月使大人，我认为不能如此草率。",
            "nextDialogs": [
              "402050729"
            ]
          },
          "402050729": {
            "id": "402050729",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "那种机械造物和那夏镇的大炮在原理上十分相似，但我们不能对它们一视同仁。",
            "nextDialogs": [
              "402050730"
            ]
          },
          "402050730": {
            "id": "402050730",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "那夏镇的大炮利用月矩力一次次地击退了「狂猎」，守护了这片土地，我一直将其视为一种月神赐予的庇佑。",
            "nextDialogs": [
              "402050731"
            ]
          },
          "402050731": {
            "id": "402050731",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "然而那种机械造物…它更像是一种商品，很容易就会被恶徒掌控，用于满足他们的私欲。",
            "nextDialogs": [
              "402050732"
            ]
          },
          "402050732": {
            "id": "402050732",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "据我所知，这位工坊的主人经常与挪德卡莱的各大势力进行交易。",
            "nextDialogs": [
              "402050733"
            ]
          },
          "402050733": {
            "id": "402050733",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "我怀疑她制作这种机械造物正是为了向他人出售，一旦让它流入黑市，继而被滥用…",
            "nextDialogs": [
              "402050734"
            ]
          },
          "402050734": {
            "id": "402050734",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "铛铛七分甜是我的伙伴，它不是用来买卖的！",
            "nextDialogs": [
              "402050735"
            ]
          },
          "402050735": {
            "id": "402050735",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "…这只是你的一面之词，我们可不能冒险。一旦让心怀不轨的人拿到了这种造物，圣洁的月光必将遭到亵渎！",
            "nextDialogs": [
              "402050736"
            ]
          },
          "402050736": {
            "id": "402050736",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（我就说过，事情会变得很难办，这次趟进浑水了…）",
            "nextDialogs": [
              "402050737"
            ]
          },
          "402050737": {
            "id": "402050737",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "在我看来，最好的处理方法还是销毁这种危险的造物，并防止类似的造物再次出现…",
            "nextDialogs": [
              "402050738"
            ]
          },
          "402050738": {
            "id": "402050738",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "你说什么？你们想销毁铛铛七分甜？",
            "nextDialogs": [
              "402050739"
            ]
          },
          "402050739": {
            "id": "402050739",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "还请理解我们的苦衷…",
            "nextDialogs": [
              "402050740"
            ]
          },
          "402050740": {
            "id": "402050740",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "你们都是坏蛋！给我让开！"
          }
        }
      }
    },
    {
      "subId": "4020502",
      "subQuestName": "深入霜月之子的营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402050201"
        ],
        "dialogs": {
          "402050201": {
            "id": "402050201",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "请…请冷静些！",
            "nextDialogs": [
              "402050202"
            ]
          },
          "402050202": {
            "id": "402050202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "爱诺！",
            "nextDialogs": [
              "402050204",
              "402050207"
            ]
          },
          "402050204": {
            "id": "402050204",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "可是，他们说要销毁铛铛七分甜…",
            "nextDialogs": [
              "402050205"
            ]
          },
          "402050205": {
            "id": "402050205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们当然不会让这件事发生，但胡来是解决不了问题的。",
            "nextDialogs": [
              "402050209"
            ]
          },
          "402050209": {
            "id": "402050209",
            "speakerId": 15539,
            "speakerName": "赫莉米",
            "text": "不好了，一大批飞行机械偷袭了我们存储物资的地方，那台机械造物被抢走了！",
            "nextDialogs": [
              "402050210"
            ]
          },
          "402050210": {
            "id": "402050210",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "这个时候？难道是盯准了我们和这个女孩儿起冲突的时机…",
            "nextDialogs": [
              "402050211"
            ]
          },
          "402050211": {
            "id": "402050211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，好多侦察单元！",
            "nextDialogs": [
              "402050212"
            ]
          },
          "402050212": {
            "id": "402050212",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "肯定是那些黑市商人安排的，我们果然还被盯着！",
            "nextDialogs": [
              "402050213"
            ]
          },
          "402050213": {
            "id": "402050213",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#{NICKNAME}，我可以直接在这里搭建一段临时的月灵旅路，麻烦你请月灵来帮忙！",
            "nextDialogs": [
              "402050214"
            ]
          },
          "402050214": {
            "id": "402050214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我明白了。",
            "nextDialogs": [
              "402050215"
            ]
          },
          "402050215": {
            "id": "402050215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊，把它们打下来！"
          },
          "402050207": {
            "id": "402050207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，还请相信我们，先冷静一下，这样胡来是绝对不行的！",
            "nextDialogs": [
              "402050208"
            ]
          },
          "402050208": {
            "id": "402050208",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "我…"
          }
        }
      }
    },
    {

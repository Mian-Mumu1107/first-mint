    },
    {
      "subId": "4020504",
      "subQuestName": "安慰爱诺",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402050401"
        ],
        "dialogs": {
          "402050401": {
            "id": "402050401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "最后一架，肯定就在上面了！啊，往那边逃了！",
            "nextDialogs": [
              "402050402"
            ]
          },
          "402050402": {
            "id": "402050402",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "看我的！不许跑！",
            "nextDialogs": [
              "402050403"
            ]
          },
          "402050403": {
            "id": "402050403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "爱诺，危险！",
            "nextDialogs": [
              "402050404"
            ]
          },
          "402050404": {
            "id": "402050404",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "可恶…",
            "nextDialogs": [
              "402050405"
            ]
          },
          "402050405": {
            "id": "402050405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "爱诺——",
            "nextDialogs": [
              "402050406"
            ]
          },
          "402050406": {
            "id": "402050406",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#唔…{NICKNAME}？对了，那架侦察单元…",
            "nextDialogs": [
              "402050407"
            ]
          },
          "402050407": {
            "id": "402050407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你没事才最重要。",
            "nextDialogs": [
              "402050408"
            ]
          },
          "402050408": {
            "id": "402050408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…真是太危险了，你这样也很乱来的！",
            "nextDialogs": [
              "402050409"
            ]
          },
          "402050409": {
            "id": "402050409",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "#没事就好…身手不错嘛，{NICKNAME}，我还以为必须要我出手呢。",
            "nextDialogs": [
              "402050410"
            ]
          },
          "402050410": {
            "id": "402050410",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（幸亏没出事，不然的话，我真的想不到该怎么跟伊涅芙交代啊…）",
            "nextDialogs": [
              "402050411"
            ]
          },
          "402050411": {
            "id": "402050411",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "根本不是没事！铛铛七分甜还是被抢走了…我是叮铃哐啷蛋卷工坊的老大，我不能在这时候哭…",
            "nextDialogs": [
              "402050412"
            ]
          },
          "402050412": {
            "id": "402050412",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "请容我代替族人向你致歉，如果没有他们的阻拦，或许你的伙伴就不会被劫走。",
            "nextDialogs": [
              "402050413"
            ]
          },
          "402050413": {
            "id": "402050413",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "咏月使大人…",
            "nextDialogs": [
              "402050414"
            ]
          },
          "402050414": {
            "id": "402050414",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "如果她真的将那种机械造物视为谋利的手段，大可以重新制作，又何必展示这种足以让你们羞愧的勇气呢？",
            "nextDialogs": [
              "402050415"
            ]
          },
          "402050415": {
            "id": "402050415",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "即便是满月的光华，也无法在她的心绪上映出瑕疵，而你们那颗苛求的心，却已经要没入月华所无法触及的阴影之中了。",
            "nextDialogs": [
              "402050416"
            ]
          },
          "402050416": {
            "id": "402050416",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "…请也接受我的道歉。",
            "nextDialogs": [
              "402050417"
            ]
          },
          "402050417": {
            "id": "402050417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "误会解开了就好。",
            "nextDialogs": [
              "402050418"
            ]
          },
          "402050418": {
            "id": "402050418",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "所以，请不要悲伤。「心绪无瑕之人，总能得到月光的指引。」",
            "nextDialogs": [
              "402050419"
            ]
          },
          "402050419": {
            "id": "402050419",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "你一定能找回同伴，有需要的话，我也愿意安排族人向你提供帮助。",
            "nextDialogs": [
              "402050420"
            ]
          },
          "402050420": {
            "id": "402050420",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "…嗯。",
            "nextDialogs": [
              "402050421"
            ]
          },
          "402050421": {
            "id": "402050421",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是话说回来，接下来该去哪里找？",
            "nextDialogs": [
              "402050422"
            ]
          },
          "402050422": {
            "id": "402050422",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "结论很明显，动手的是那个非法黑市的商人，恐怕对方早就料到爱诺和霜月之子之间会发生冲突，就钻了这个空子。",
            "nextDialogs": [
              "402050423"
            ]
          },
          "402050423": {
            "id": "402050423",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "更确切一点来说，最初把铛铛七分甜偷走的人可能也是他安排的，所以他早就知道铛铛七分甜在这里，能提前布局。",
            "nextDialogs": [
              "402050424"
            ]
          },
          "402050424": {
            "id": "402050424",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "目前来看，嫌疑最大的肯定是那个阿斯科，不过，好像也不能完全排除其他商人的嫌疑…",
            "nextDialogs": [
              "402050425"
            ]
          },
          "402050425": {
            "id": "402050425",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实如此…看来雅珂达肯定知道去哪里查。",
            "nextDialogs": [
              "402050426"
            ]
          },
          "402050426": {
            "id": "402050426",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（又要我来？刚刚说过了，那里的商人都有嫌疑，黑市一散，谁知道都能跑到什么地方去？唉…刚刚不该卖弄的。）",
            "nextDialogs": [
              "402050427"
            ]
          },
          "402050427": {
            "id": "402050427",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "雅珂达肯定也是见不得爱诺这么伤心，接下来也要仰仗你了呢。",
            "nextDialogs": [
              "402050428"
            ]
          },
          "402050428": {
            "id": "402050428",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "雅珂达，仰仗你了！",
            "nextDialogs": [
              "402050429"
            ]
          },
          "402050429": {
            "id": "402050429",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（…这让我怎么拒绝啊？）",
            "nextDialogs": [
              "402050430"
            ]
          },
          "402050430": {
            "id": "402050430",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "好吧，至少…至少先给我两天时间。",
            "nextDialogs": [
              "402050431"
            ]
          },
          "402050431": {
            "id": "402050431",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "再等两天，看来也是没办法的事呢。爱诺，现在有这么多人帮忙，不用担心的。",
            "nextDialogs": [
              "402050432"
            ]
          },
          "402050432": {
            "id": "402050432",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "我知道的…谢谢大家。"
          }
        }
      }
    },
    {
      "subId": "4020509",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

            "id": "402050901",
            "speakerId": 15467,
            "speakerName": "尤斯塔奇",
            "text": "真的不考虑一下这里的付费项目吗？"
          }
        }
      }
    },
    {
      "subId": "4020599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402059901"
        ],
        "dialogs": {
          "402059901": {
            "id": "402059901",
            "speakerId": 15538,
            "speakerName": "阿索",
            "text": "快住手，我们不会让你带走那个危险的机械造物！",
            "nextDialogs": [
              "402059902"
            ]
          },
          "402059902": {
            "id": "402059902",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "再说一遍，铛铛七分甜是伙伴！",
            "nextDialogs": [
              "402059903"
            ]
          },
          "402059903": {
            "id": "402059903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "爱诺，冷静一下！"
          }
        }
      }
    }
  ]
}
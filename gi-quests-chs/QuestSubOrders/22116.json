    {
      "subId": "2211605",
      "subQuestName": "(test)【隐藏】选缺心眼$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221160201"
        ],
        "dialogs": {
          "221160201": {
            "id": "221160201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "心眼。",
            "nextDialogs": [
              "221160202"
            ]
          },
          "221160202": {
            "id": "221160202",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "你，你别和我开玩笑啊，我认真的，你好好想想，认真想！"
          }
        }
      }

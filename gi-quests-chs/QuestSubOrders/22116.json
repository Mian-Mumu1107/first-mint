  "subQuests": [
    {
      "subId": "2211601",
      "subQuestName": "和常九爷对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221160301"
        ],
        "dialogs": {
          "221160301": {
            "id": "221160301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "富有张力的热血战斗。",
            "nextDialogs": [
              "221160302"
            ]
          },
          "221160302": {
            "id": "221160302",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "热血战斗…热血战斗，嗯…有点道理，这东西最能吸引眼球了。",
            "nextDialogs": [
              "221160303"
            ]
          },
          "221160303": {
            "id": "221160303",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "不过，别说「富有张力的热血战斗」了，这轻策庄里连「战斗」都没有…",
            "nextDialogs": [
              "221160304"
            ]
          },
          "221160304": {
            "id": "221160304",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "看来我得出去取点材。对了！我听说…在野外有很多冒险家。",
            "nextDialogs": [
              "221160305"
            ]
          },
          "221160305": {
            "id": "221160305",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "为了寻宝，他们会到处跑，还经常和野外的那些怪物打起来。",
            "nextDialogs": [
              "221160306"
            ]
          },
          "221160306": {
            "id": "221160306",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "我刚好知道一个地方有很多怪物，而且那地方看起来嘛…也像模像样的，咱们就去那里等着！等着那些冒险家过来，和那些怪物好好打上一场。",
            "nextDialogs": [
              "221160307"
            ]
          },
          "221160307": {
            "id": "221160307",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "然后嘛，嘿嘿，这材料不就到手了。好了，那地方还有点远…我先过去了啊，你赶紧过来！"
          }
        }
      }
    },

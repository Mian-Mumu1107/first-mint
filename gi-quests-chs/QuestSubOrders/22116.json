    {
      "subId": "2211609",
      "subQuestName": "聆听志华与绮命的对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221161001"
        ],
        "dialogs": {
          "221161001": {
            "id": "221161001",
            "speakerId": 1001,
            "speakerName": "志华",
            "text": "那个，绮命姐姐，今天我…",
            "nextDialogs": [
              "221161002"
            ]
          },
          "221161002": {
            "id": "221161002",
            "speakerId": 1002,
            "speakerName": "绮命",
            "text": "今天不太适合。",
            "nextDialogs": [
              "221161003"
            ]
          },
          "221161003": {
            "id": "221161003",
            "speakerId": 1001,
            "speakerName": "志华",
            "text": "咦？可是我还什么都没说呢。",
            "nextDialogs": [
              "221161004"
            ]
          },
          "221161004": {
            "id": "221161004",
            "speakerId": 1002,
            "speakerName": "绮命",
            "text": "不用说，我也知道你要说什么，今天不太合适。",
            "nextDialogs": [
              "221161005"
            ]
          },
          "221161005": {
            "id": "221161005",
            "speakerId": 1001,
            "speakerName": "志华",
            "text": "那什么时候才合适，绮命姐姐，不然你…",
            "nextDialogs": [
              "221161006"
            ]
          },
          "221161006": {
            "id": "221161006",
            "speakerId": 1002,
            "speakerName": "绮命",
            "text": "哦，到了合适的那天，当然就会合适了。",
            "nextDialogs": [
              "221161007"
            ]
          },
          "221161007": {
            "id": "221161007",
            "speakerId": 1001,
            "speakerName": "志华",
            "text": "这不和什么都没说一样嘛！绮命姐姐，你就详细听我说说吧…",
            "nextDialogs": [
              "221161008"
            ]
          },
          "221161008": {
            "id": "221161008",
            "speakerId": 1002,
            "speakerName": "绮命",
            "text": "好了，下一位请过来。",
            "nextDialogs": [
              "221161009"
            ]
          },
          "221161009": {
            "id": "221161009",
            "speakerId": 1001,
            "speakerName": "志华",
            "text": "我还什么都没说啊！还有，哪里有下一位啊？！"
          }
        }
      }
    },
    {
      "subId": "2211610",
      "subQuestName": "聆听思思与潮汐的对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221161101"
        ],
        "dialogs": {
          "221161101": {
            "id": "221161101",
            "speakerId": 1003,
            "speakerName": "思思",
            "text": "汐哥哥，你…你回来了，我刚学会了一道菜，回去做给你吃吧？",
            "nextDialogs": [
              "221161102"
            ]
          },
          "221161102": {
            "id": "221161102",
            "speakerId": 1004,
            "speakerName": "潮汐",
            "text": "思妹妹，我刚回来，已经身心俱疲了，只想好好休息一下…",
            "nextDialogs": [
              "221161103"
            ]
          },
          "221161103": {
            "id": "221161103",
            "speakerId": 1003,
            "speakerName": "思思",
            "text": "对，是啊，你这么辛苦，是应该休息。",
            "nextDialogs": [
              "221161104"
            ]
          },
          "221161104": {
            "id": "221161104",
            "speakerId": 1003,
            "speakerName": "思思",
            "text": "那…等你休息好了，我们再好好聊聊？也该定个日子…",
            "nextDialogs": [
              "221161105"
            ]
          },
          "221161105": {
            "id": "221161105",
            "speakerId": 1004,
            "speakerName": "潮汐",
            "text": "嗯，嗯，我记得的，但我暂时还没有想好。并不是我不想负责，而是我不想辜负你…",
            "nextDialogs": [
              "221161106"
            ]
          },
          "221161106": {
            "id": "221161106",
            "speakerId": 1004,
            "speakerName": "潮汐",
            "text": "唉，与大海为伍是水手的宿命，思妹妹，你值得更好的人…",
            "nextDialogs": [
              "221161107"
            ]
          },
          "221161107": {
            "id": "221161107",
            "speakerId": 1003,
            "speakerName": "思思",
            "text": "汐哥哥，你别这么说，我知道的…"
          }
        }
      }
    },
    {
      "subId": "2211611",
      "subQuestName": "聆听小蒙、阿飞与璐璐的对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221161201"
        ],
        "dialogs": {
          "221161201": {
            "id": "221161201",
            "speakerId": 1005,
            "speakerName": "小蒙",
            "text": "璐璐，这次真的应该归阿飞做船长了。",
            "nextDialogs": [
              "221161202"
            ]
          },
          "221161202": {
            "id": "221161202",
            "speakerId": 1006,
            "speakerName": "阿飞",
            "text": "对呀，都说了多少次了，老是我来做服务生…",
            "nextDialogs": [
              "221161203"
            ]
          },
          "221161203": {
            "id": "221161203",
            "speakerId": 1007,
            "speakerName": "璐璐",
            "text": "可我觉得小蒙扮船长的时候，我们玩得最开心呀。",
            "nextDialogs": [
              "221161204"
            ]
          },
          "221161204": {
            "id": "221161204",
            "speakerId": 1005,
            "speakerName": "小蒙",
            "text": "璐璐，你不能这么说，阿飞也演得不错…",
            "nextDialogs": [
              "221161205"
            ]
          },
          "221161205": {
            "id": "221161205",
            "speakerId": 1007,
            "speakerName": "璐璐",
            "text": "对呀，没错，你扮船长的时候，我扮富商，阿飞扮服务生。",
            "nextDialogs": [
              "221161206"
            ]
          },
          "221161206": {
            "id": "221161206",
            "speakerId": 1007,
            "speakerName": "璐璐",
            "text": "这个时候，我们玩得是最开心的呀，对吧阿飞？",
            "nextDialogs": [
              "221161207"
            ]
          },
          "221161207": {
            "id": "221161207",
            "speakerId": 1005,
            "speakerName": "小蒙",
            "text": "璐璐，你…",
            "nextDialogs": [
              "221161208"
            ]
          },
          "221161208": {
            "id": "221161208",
            "speakerId": 1006,
            "speakerName": "阿飞",
            "text": "璐璐都这么说了，那…那也行吧。",
            "nextDialogs": [
              "221161209"
            ]
          },
          "221161209": {
            "id": "221161209",
            "speakerId": 1005,
            "speakerName": "小蒙",
            "text": "阿飞，你这又是…",
            "nextDialogs": [
              "221161210"
            ]
          },
          "221161210": {
            "id": "221161210",
            "speakerId": 1006,
            "speakerName": "阿飞",
            "text": "没事啦！没事了，璐璐开心就好了，我们继续来玩吧。",
            "nextDialogs": [
              "221161211"
            ]
          },
          "221161211": {
            "id": "221161211",
            "speakerId": 1006,
            "speakerName": "阿飞",
            "text": "不就是个船长吗，我才不稀罕呢。",
            "nextDialogs": [
              "221161212"
            ]
          },
          "221161212": {
            "id": "221161212",
            "speakerId": 1005,
            "speakerName": "小蒙",
            "text": "…你们，唉…"
          }
        }
      }
    },
    {
      "subId": "2211613",
      "subQuestName": "(test)【玄幻分支】到绝云间找常九爷",
      "sceneId": null,
      "locations": [],

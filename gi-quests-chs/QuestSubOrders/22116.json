    {
      "subId": "2211607",
      "subQuestName": "击败所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221160701"
        ],
        "dialogs": {
          "221160701": {
            "id": "221160701",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "我上次去城里的时候，碰巧看见了一个人和一个似乎是在占卜的姑娘啰嗦个不停，但我那时候没有详细听下去…",
            "nextDialogs": [
              "221160702"
            ]
          },
          "221160702": {
            "id": "221160702",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "后来我打听到，这两个人一个叫志华，一个叫绮命，你去帮我再打听打听，如果有什么好故事，就快点拿回来给我吧。"
          }
        }
      }
    },
    {
      "subId": "2211612",
      "subQuestName": "向常九爷回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221161301"
        ],
        "dialogs": {
          "221161301": {
            "id": "221161301",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "怎么样，你有什么收获吗？",
            "nextDialogs": [
              "221161302"
            ]
          },
          "221161302": {
            "id": "221161302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "记下来了这个。",
            "nextDialogs": [
              "221161303"
            ]
          },
          "221161303": {
            "id": "221161303",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "还真有收获，给我看看…志华和绮命，果然没错…",
            "nextDialogs": [
              "221161304"
            ]
          },
          "221161304": {
            "id": "221161304",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "嗯…不错，不错啊，这个不错！",
            "nextDialogs": [
              "221161305"
            ]
          },
          "221161305": {
            "id": "221161305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哪里不错了…",
            "nextDialogs": [
              "221161306"
            ]
          },
          "221161306": {
            "id": "221161306",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "你，你没看出来？没感觉到吗？你仔细看，这股隐隐约约，不足为外人道的微妙默契感？",
            "nextDialogs": [
              "221161307"
            ]
          },
          "221161307": {
            "id": "221161307",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "这个不错，我觉得我抓到点思路了…",
            "nextDialogs": [
              "221161308"
            ]
          },
          "221161308": {
            "id": "221161308",
            "speakerId": 1000,
            "speakerName": "常九爷",
            "text": "对了，这是给你的谢礼，收下吧，我得好好想一想怎么动笔了。"
          }
        }
      }
    },
    {
      "subId": "2211614",
      "subQuestName": "(test)【玄幻分支】完成飞行挑战",
      "sceneId": null,
      "locations": [],

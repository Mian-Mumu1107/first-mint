  "subQuests": [
    {
      "subId": "2003301",
      "subQuestName": "与安娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200330101"
        ],
        "dialogs": {
          "200330101": {
            "id": "200330101",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "旅行者！快看快看，我这身衣服怎么样？好不好看？",
            "nextDialogs": [
              "200330102"
            ]
          },
          "200330102": {
            "id": "200330102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这身衣服…难道？！",
            "nextDialogs": [
              "200330103"
            ]
          },
          "200330103": {
            "id": "200330103",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "没错！我已经通过冒险家协会的考试了，正式成为一名冒险家啦！",
            "nextDialogs": [
              "200330106"
            ]
          },
          "200330106": {
            "id": "200330106",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "嘿嘿，谢谢你。我还想让哥哥也试试看呢，结果他怎么样都不肯去…",
            "nextDialogs": [
              "200330107"
            ]
          },
          "200330107": {
            "id": "200330107",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "我对冒险没什么兴趣…再说了，我们俩都做了冒险家，谁来照顾爸妈啊？",
            "nextDialogs": [
              "200330108"
            ]
          },
          "200330108": {
            "id": "200330108",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "那我们就把爸妈都带上，一起去世界各地旅行啊！",
            "nextDialogs": [
              "200330109"
            ]
          },
          "200330109": {
            "id": "200330109",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "你啊…行了，既然当上了冒险家，那就好好干，家里的事我来打理就好。",
            "nextDialogs": [
              "200330110"
            ]
          },
          "200330110": {
            "id": "200330110",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "但是！一定要注意安全，不要把自己弄伤了，也不要太累…",
            "nextDialogs": [
              "200330111"
            ]
          },
          "200330111": {
            "id": "200330111",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "知道啦知道啦！我要出去执行委托了！",
            "nextDialogs": [
              "200330112"
            ]
          },
          "200330112": {
            "id": "200330112",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "旅行者，你要和我一起去吗？我还想请教你许多有关冒险家的问题呢。"
          }
        }
      }
    },
    {
      "subId": "2003302",
      "subQuestName": "与安娜一同完成冒险家协会的委托",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200330201"
        ],
        "dialogs": {
          "200330201": {
            "id": "200330201",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "完成啦！谢谢你旅行者，这次的护送任务很顺利呢。",
            "nextDialogs": [
              "200330202"
            ]
          },
          "200330202": {
            "id": "200330202",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "不过，冒险家平时去执行的委托，都是这种事情吗？",
            "nextDialogs": [
              "200330204",
              "200330206"
            ]
          },
          "200330204": {
            "id": "200330204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你的语气也太无奈了…",
            "nextDialogs": [
              "200330207"
            ]
          },
          "200330207": {
            "id": "200330207",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "是这样吗…好嘞！那我要继续努力了！",
            "nextDialogs": [
              "200330208"
            ]
          },
          "200330208": {
            "id": "200330208",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "等我攒够了钱，就带着哥哥和爸爸妈妈一起出去旅行！",
            "nextDialogs": [
              "200330209"
            ]
          },
          "200330209": {
            "id": "200330209",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "哥哥他之前一直想出去旅行的，可是…因为我生病了，他必须留下来照顾我。",
            "nextDialogs": [
              "200330210"
            ]
          },
          "200330210": {
            "id": "200330210",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "现在我的病已经好了，也成为了冒险家。",
            "nextDialogs": [
              "200330211"
            ]
          },
          "200330211": {
            "id": "200330211",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "嘿嘿，是时候帮我哥哥完成一些梦想啦。"
          },
          "200330206": {
            "id": "200330206",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "喂，你的表情不要这么疲惫啊…"
          }
        }
      }
    },
    {
      "subId": "2003303",
      "subQuestName": "与安娜一同完成冒险家协会的委托",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200330301"
        ],
        "dialogs": {
          "200330301": {
            "id": "200330301",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "旅行者，还请你多照顾一下安娜，这孩子最近好像兴奋过头了…",
            "nextDialogs": [
              "200330302"
            ]
          },
          "200330302": {
            "id": "200330302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不希望她做冒险家吗？",
            "nextDialogs": [
              "200330303"
            ]
          },
          "200330303": {
            "id": "200330303",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "……",
            "nextDialogs": [
              "200330304"
            ]
          },
          "200330304": {
            "id": "200330304",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "我尊重我妹妹的梦想。",
            "nextDialogs": [
              "200330305"
            ]
          },
          "200330305": {
            "id": "200330305",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "她的病好不容易痊愈了，也得到了追逐自己梦想的机会。",
            "nextDialogs": [
              "200330306"
            ]
          },
          "200330306": {
            "id": "200330306",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "作为她的哥哥，我…会全力支持她。",
            "nextDialogs": [
              "200330307"
            ]
          },
          "200330307": {
            "id": "200330307",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "就这样。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7101201",
      "subQuestName": "test完成对话·日晷·分支1（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710120101"
        ],
        "dialogs": {
          "710120101": {
            "id": "710120101",
            "speakerId": 1000,
            "speakerName": "残破的刻字",
            "text": "「风带来了新的故事，时间使之成为神话。」",
            "nextDialogs": [
              "710120102"
            ]
          },
          "710120102": {
            "id": "710120102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这句话是什么意思啊…完全没有头绪。",
            "nextDialogs": [
              "710120103"
            ]
          },
          "710120103": {
            "id": "710120103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，不过，这个地方看起来似乎有什么秘密…",
            "nextDialogs": [
              "710120104"
            ]
          },
          "710120104": {
            "id": "710120104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们去周围看看吧，说不定会有什么线索呢。"
          }
        }
      }
    },
    {
      "subId": "7101202",
      "subQuestName": "驱散「风」的聚集点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710120201"
        ],
        "dialogs": {
          "710120201": {
            "id": "710120201",
            "speakerId": 1000,
            "speakerName": "残破的刻字",
            "text": "「风带来了新的故事，时间使之成为神话。」",
            "nextDialogs": [
              "710120202"
            ]
          },
          "710120202": {
            "id": "710120202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那本笔记里提到的日晷，应该就是这一座吧。",
            "nextDialogs": [
              "710120203"
            ]
          },
          "710120203": {
            "id": "710120203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，这座日晷到底有什么特别的地方呢…",
            "nextDialogs": [
              "710120204"
            ]
          },
          "710120204": {
            "id": "710120204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…我们再仔细看看那本笔记吧。"
          }
        }
      }
    },

    {
      "subId": "7101224",
      "subQuestName": "与亨利莫顿对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710122401"
        ],
        "dialogs": {
          "710122401": {
            "id": "710122401",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "那个家伙是从哪冒出来的！之前完全没有看见！",
            "nextDialogs": [
              "710122402"
            ]
          },
          "710122402": {
            "id": "710122402",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "你是怎么把那大家伙弄出来的？",
            "nextDialogs": [
              "710122403"
            ]
          },
          "710122403": {
            "id": "710122403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是这样…",
            "nextDialogs": [
              "710122404"
            ]
          },
          "710122404": {
            "id": "710122404",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "果然是「时与风」啊…",
            "nextDialogs": [
              "710122405"
            ]
          },
          "710122405": {
            "id": "710122405",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "在那座孤岛上，还有一座和这个一模一样的日晷，对吧？",
            "nextDialogs": [
              "710122406"
            ]
          },
          "710122406": {
            "id": "710122406",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "而且，连解谜的方式都一模一样。这两座日晷，还有这两个地方，一定有着某种联系…",
            "nextDialogs": [
              "710122407"
            ]
          },
          "710122407": {
            "id": "710122407",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "不行，我得找个办法，赶紧去那座岛上看看…",
            "nextDialogs": [
              "710122408"
            ]
          },
          "710122408": {
            "id": "710122408",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "谢谢你旅行者，等我做好准备之后就去找你，我们一起再去那座无人岛上一趟。"
          }
        }
      }
    },

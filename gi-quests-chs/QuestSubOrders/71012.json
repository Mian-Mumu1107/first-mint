    {
      "subId": "7101210",
      "subQuestName": "寻找狂风之核",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710121001"
        ],
        "dialogs": {
          "710121001": {
            "id": "710121001",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "嗯？旅行者，你来这里有事吗？",
            "nextDialogs": [
              "710121002"
            ]
          },
          "710121002": {
            "id": "710121002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于狂风之核…",
            "nextDialogs": [
              "710121003"
            ]
          },
          "710121003": {
            "id": "710121003",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "狂风之核？我一直在这附近呆着，没有见过类似的东西啊，就是刚才莫名其妙刮过来一阵大风…",
            "nextDialogs": [
              "710121004"
            ]
          },
          "710121004": {
            "id": "710121004",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "不过，这里肯定没有出现过狂风之核。如果有那种大家伙，我肯定忘不了。",
            "nextDialogs": [
              "710121006",
              "710121008"
            ]
          },
          "710121006": {
            "id": "710121006",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "你就相信我吧，要是有那种家伙来这里打乱我的研究，我肯定忘不了的。",
            "nextDialogs": [
              "710121009"
            ]
          },
          "710121009": {
            "id": "710121009",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "准确地说…应该是和我的一位朋友一起进行的研究。",
            "nextDialogs": [
              "710121010"
            ]
          },
          "710121010": {
            "id": "710121010",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "我的那位朋友也是一位学者，曾经和我一同在须弥教令院里学习。",
            "nextDialogs": [
              "710121011"
            ]
          },
          "710121011": {
            "id": "710121011",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "之后，他去做了考古学家，在世界上到处考察，我则继续在教令院里学习…",
            "nextDialogs": [
              "710121012"
            ]
          },
          "710121012": {
            "id": "710121012",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "当他来蒙德的时候，还很兴奋地告诉我他正在蒙德的千风神殿考察。",
            "nextDialogs": [
              "710121013"
            ]
          },
          "710121013": {
            "id": "710121013",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "还说什么「等我挖出了你家乡的秘密，绝对第一个就告诉你」。",
            "nextDialogs": [
              "710121014"
            ]
          },
          "710121014": {
            "id": "710121014",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "之后他就突然没了音信，我托人给塞琉斯先生带了封信，拜托冒险家协会搜索我朋友的下落。",
            "nextDialogs": [
              "710121015"
            ]
          },
          "710121015": {
            "id": "710121015",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "但一直没有任何消息传来，我就中断了在须弥的学习，自己赶了回来。",
            "nextDialogs": [
              "710121016"
            ]
          },
          "710121016": {
            "id": "710121016",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "不过，这里也只有一座日晷，没有其他的线索了…",
            "nextDialogs": [
              "710121017"
            ]
          },
          "710121017": {
            "id": "710121017",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于那座岛上的日晷…",
            "nextDialogs": [
              "710121018"
            ]
          },
          "710121018": {
            "id": "710121018",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "什么？居然还有一座一模一样的日晷，还是在一座海上的孤岛上？",
            "nextDialogs": [
              "710121019"
            ]
          },
          "710121019": {
            "id": "710121019",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "哦，我记起来了，天气好的时候，我还看见过那座岛。",
            "nextDialogs": [
              "710121020"
            ]
          },
          "710121020": {
            "id": "710121020",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "等等，你说…在那个岛上的日晷旁边，发现了一本笔记？难道说那家伙去过那里…",
            "nextDialogs": [
              "710121021"
            ]
          },
          "710121021": {
            "id": "710121021",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "谢谢你，我有机会的话，会去那座孤岛上看看，现在我还是想先把这里研究明白。",
            "nextDialogs": [
              "710121022"
            ]
          },
          "710121022": {
            "id": "710121022",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "我要继续研究了，如果你有兴趣，可以去翻翻我的研究笔记，我就放在那里了。",
            "nextDialogs": [
              "710121023"
            ]
          },
          "710121023": {
            "id": "710121023",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "说不定上面有什么东西，会对你有帮助。"
          },
          "710121008": {
            "id": "710121008",
            "speakerId": 1002,
            "speakerName": "亨利莫顿",
            "text": "我？我正在这里做一些研究。"
          }
        }
      }
    },

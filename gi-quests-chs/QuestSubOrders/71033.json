  "subQuests": [
    {
      "subId": "7103313",
      "subQuestName": "(test)领取任务用任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710331301"
        ],
        "dialogs": {
          "710331301": {
            "id": "710331301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他们俩好像比试得很起劲呢，不会影响到其他人吧…"
          }
        }
      }
    },
    {
      "subId": "7103301",
      "subQuestName": "与梵米尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330101"
        ],
        "dialogs": {
          "710330101": {
            "id": "710330101",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "旅行者，旅行者，这里！",
            "nextDialogs": [
              "710330102"
            ]
          },
          "710330102": {
            "id": "710330102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是上次和清昼定了约定的画家…",
            "nextDialogs": [
              "710330103"
            ]
          },
          "710330103": {
            "id": "710330103",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "就是我，我和那个诗人约定好，要各自创作一份艺术品概括海灯节。",
            "nextDialogs": [
              "710330104"
            ]
          },
          "710330104": {
            "id": "710330104",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "你上次还帮我去拿了材料呢，你应该还记得吧。",
            "nextDialogs": [
              "710330107"
            ]
          },
          "710330107": {
            "id": "710330107",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "我的画…咳，这个嘛…我其实已经画了很多了，场景、人物，甚至是动物…",
            "nextDialogs": [
              "710330108"
            ]
          },
          "710330108": {
            "id": "710330108",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "我自信这些画都精确表达了应该表达的内容，但是…这些画里没有一幅能称得上可以概括海灯节的…",
            "nextDialogs": [
              "710330109"
            ]
          },
          "710330109": {
            "id": "710330109",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "唉，我这几天吃不下睡不着，画材也都要用完了，还是没有画出那幅画。",
            "nextDialogs": [
              "710330110"
            ]
          },
          "710330110": {
            "id": "710330110",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "所以，我就想去找找那诗人，看看他的诗写得怎么样了…",
            "nextDialogs": [
              "710330111"
            ]
          },
          "710330111": {
            "id": "710330111",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "旅行者，你知道那个诗人去哪了吗？",
            "nextDialogs": [
              "710330112"
            ]
          },
          "710330112": {
            "id": "710330112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他去轻策庄了。",
            "nextDialogs": [
              "710330113"
            ]
          },
          "710330113": {
            "id": "710330113",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "轻策庄？他去那干嘛…难道，是他找到取材点了…",
            "nextDialogs": [
              "710330114"
            ]
          },
          "710330114": {
            "id": "710330114",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "快，旅行者，我们快去轻策庄找他去！要是那个地方合适，说不定我也能找到点灵感…",
            "nextDialogs": [
              "710330115"
            ]
          },
          "710330115": {
            "id": "710330115",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "咳！总之，我们快出发吧！"
          }
        }
      }
    },
    {
      "subId": "7103302",
      "subQuestName": "前往轻策庄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7103303",
      "subQuestName": "与梵米尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330301"
        ],
        "dialogs": {
          "710330301": {
            "id": "710330301",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "这就是轻策庄了吧…那个诗人呢？跑去哪取材了？",
            "nextDialogs": [
              "710330302"
            ]
          },
          "710330302": {
            "id": "710330302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "上次他正在和孩子们玩猜灯谜…",
            "nextDialogs": [
              "710330303"
            ]
          },
          "710330303": {
            "id": "710330303",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "猜、猜灯谜？这都什么…事情。",
            "nextDialogs": [
              "710330304"
            ]
          },
          "710330304": {
            "id": "710330304",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "他是不是因为找不到灵感，准备自己认输了？",
            "nextDialogs": [
              "710330305"
            ]
          },
          "710330305": {
            "id": "710330305",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "算了，不管他是在干什么，这海灯节眼看着没剩几天了，可不能再拖下去了。",
            "nextDialogs": [
              "710330306"
            ]
          },
          "710330306": {
            "id": "710330306",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "我们去找这里管事的问问吧，今天我非要和他分出个高下来。"
          }
        }
      }
    },
    {
      "subId": "7103304",
      "subQuestName": "与若心对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330401"
        ],
        "dialogs": {
          "710330401": {
            "id": "710330401",
            "speakerId": 1002,
            "speakerName": "若心",
            "text": "哎呀，你好啊旅行者，多谢你，现在这轻策庄里总算有了些过节的氛围啦…",
            "nextDialogs": [
              "710330402"
            ]
          },
          "710330402": {
            "id": "710330402",
            "speakerId": 1002,
            "speakerName": "若心",
            "text": "咦？你身边的这位看着面生，这位是…",
            "nextDialogs": [
              "710330403"
            ]
          },
          "710330403": {
            "id": "710330403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是位画家，来找清昼的。",
            "nextDialogs": [
              "710330404"
            ]
          },
          "710330404": {
            "id": "710330404",
            "speakerId": 1002,
            "speakerName": "若心",
            "text": "来找清昼先生的？唔，那正好…",
            "nextDialogs": [
              "710330405"
            ]
          },
          "710330405": {
            "id": "710330405",
            "speakerId": 1002,
            "speakerName": "若心",
            "text": "望雅小姐前几天离开的时候，清昼先生说还要在这里待一段时间。",
            "nextDialogs": [
              "710330406"
            ]
          },
          "710330406": {
            "id": "710330406",
            "speakerId": 1002,
            "speakerName": "若心",
            "text": "他现在应该还在和孩子们玩猜灯谜呢，我想想，他带着孩子们去外面了…",
            "nextDialogs": [
              "710330407"
            ]
          },
          "710330407": {
            "id": "710330407",
            "speakerId": 1002,
            "speakerName": "若心",
            "text": "要是想要找他的话，估计得去外面找找了。",
            "nextDialogs": [
              "710330408"
            ]
          },
          "710330408": {
            "id": "710330408",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "他还真的在玩灯谜…旅行者，那就麻烦你帮我跑一趟吧。",
            "nextDialogs": [
              "710330409"
            ]
          },
          "710330409": {
            "id": "710330409",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "你去告诉那个诗人我过来了，我在这里再准备准备。",
            "nextDialogs": [
              "710330410"
            ]
          },
          "710330410": {
            "id": "710330410",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "无论如何，今天一定要和他分出个胜负…"
          }
        }
      }
    },
    {
      "subId": "7103305",
      "subQuestName": "与清昼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330501"
        ],
        "dialogs": {
          "710330501": {
            "id": "710330501",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "哈哈哈，你们也逐渐摸到窍门了，猜得越来越快了。",
            "nextDialogs": [
              "710330504"
            ]
          },
          "710330504": {
            "id": "710330504",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "梵米尔…啊，那个画家，我算算日子，也确实该是履行约定的时候。",
            "nextDialogs": [
              "710330505"
            ]
          },
          "710330505": {
            "id": "710330505",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "可惜了，我的诗最后还是没有写好，这群孩子们的灯谜也还没玩尽兴…",
            "nextDialogs": [
              "710330506"
            ]
          },
          "710330506": {
            "id": "710330506",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "呵呵，也许真是我诗材有限吧…这样，你再陪我去找找灵感吧。",
            "nextDialogs": [
              "710330507"
            ]
          },
          "710330507": {
            "id": "710330507",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "嗯…也不能说是找灵感，再陪我去散散步吧。",
            "nextDialogs": [
              "710330508"
            ]
          },
          "710330508": {
            "id": "710330508",
            "speakerId": 1004,
            "speakerName": "阿佐",
            "text": "清昼叔叔！不猜灯谜了吗？？我还想猜猜看…",
            "nextDialogs": [
              "710330509"
            ]
          },
          "710330509": {
            "id": "710330509",
            "speakerId": 1005,
            "speakerName": "小六",
            "text": "我也想猜灯谜，清昼叔叔…",
            "nextDialogs": [
              "710330510"
            ]
          },
          "710330510": {
            "id": "710330510",
            "speakerId": 1006,
            "speakerName": "阿佑",
            "text": "唔，我也想再猜几个…",
            "nextDialogs": [
              "710330511"
            ]
          },
          "710330511": {
            "id": "710330511",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "#哈哈哈，莫急，等我和这位{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}去旁边转一圈，回来就有新灯谜了。",
            "nextDialogs": [
              "710330512"
            ]
          },
          "710330512": {
            "id": "710330512",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "你们先回轻策庄里去吧，到时候我再找你们，这样可好？",
            "nextDialogs": [
              "710330513"
            ]
          },
          "710330513": {
            "id": "710330513",
            "speakerId": 1004,
            "speakerName": "阿佐",
            "text": "好哎！清昼叔叔真厉害，能想出这么多灯谜！",
            "nextDialogs": [
              "710330514"
            ]
          },
          "710330514": {
            "id": "710330514",
            "speakerId": 1005,
            "speakerName": "小六",
            "text": "清昼叔叔肯定读了好多好多书吧…",
            "nextDialogs": [
              "710330515"
            ]
          },
          "710330515": {
            "id": "710330515",
            "speakerId": 1006,
            "speakerName": "阿佑",
            "text": "我要是以后也能像清昼叔叔这么厉害就好了…",
            "nextDialogs": [
              "710330516"
            ]
          },
          "710330516": {
            "id": "710330516",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "……",
            "nextDialogs": [
              "710330517"
            ]
          },
          "710330517": {
            "id": "710330517",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "旅行者，我们快出发吧，快把那些琐事解决了，别让这群孩子们等急了。"
          }
        }
      }
    },
    {
      "subId": "7103306",
      "subQuestName": "跟随清昼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330601"
        ],
        "dialogs": {
          "710330601": {
            "id": "710330601",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "如此景致，倒是…呵呵，倒是很适合做一句灯谜。"
          }
        }
      }
    },
    {
      "subId": "7103307",
      "subQuestName": "跟随清昼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330701"
        ],
        "dialogs": {
          "710330701": {
            "id": "710330701",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "不错，这里也够我写一句灯谜了。"
          }
        }
      }
    },
    {
      "subId": "7103308",
      "subQuestName": "跟随清昼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330801"
        ],
        "dialogs": {
          "710330801": {
            "id": "710330801",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "唔…好，我想出来了，灯谜有了一句"
          }
        }
      }
    },
    {
      "subId": "7103309",
      "subQuestName": "与清昼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710330901"
        ],
        "dialogs": {
          "710330901": {
            "id": "710330901",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "好了，这样灯谜就写好了，我们去轻策庄里去吧。",
            "nextDialogs": [
              "710330902"
            ]
          },
          "710330902": {
            "id": "710330902",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "去了那边，我再把灯谜告诉你。"
          }
        }
      }
    },
    {
      "subId": "7103310",
      "subQuestName": "与孩子们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710331001"
        ],
        "dialogs": {
          "710331001": {
            "id": "710331001",
            "speakerId": 1005,
            "speakerName": "小六",
            "text": "清昼叔叔回来啦！清昼叔叔，你已经写好新的灯谜了吗？",
            "nextDialogs": [
              "710331002"
            ]
          },
          "710331002": {
            "id": "710331002",
            "speakerId": 1004,
            "speakerName": "阿佐",
            "text": "这次我大概…肯定能猜对！",
            "nextDialogs": [
              "710331003"
            ]
          },
          "710331003": {
            "id": "710331003",
            "speakerId": 1006,
            "speakerName": "阿佑",
            "text": "我这次要好好想想…",
            "nextDialogs": [
              "710331004"
            ]
          },
          "710331004": {
            "id": "710331004",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "哈哈哈，我已经把这次的灯谜写好了。",
            "nextDialogs": [
              "710331005"
            ]
          },
          "710331005": {
            "id": "710331005",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "旅行者，请你帮我个忙吧，把这霄灯挂起来，挂高点。"
          }
        }
      }
    },
    {
      "subId": "7103315",
      "subQuestName": "把灯谜挂起来",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710331501"
        ],
        "dialogs": {
          "710331501": {
            "id": "710331501",
            "speakerId": 1007,
            "speakerName": "灯谜",
            "text": "「万千扁舟拂波去，烛映孤云峭岩间。身负流光浮沧海，终与龙宫彩鱼眠」"
          }
        }
      }
    },
    {
      "subId": "7103314",
      "subQuestName": "与清昼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710331401"
        ],
        "dialogs": {
          "710331401": {
            "id": "710331401",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "孩子们，看这霄灯，这是打一这海灯节里的「事物」，你们猜一猜吧。",
            "nextDialogs": [
              "710331402"
            ]
          },
          "710331402": {
            "id": "710331402",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "#我要和这位{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}去办件事，办完了再回来陪你们接着玩。",
            "nextDialogs": [
              "710331403"
            ]
          },
          "710331403": {
            "id": "710331403",
            "speakerId": 1005,
            "speakerName": "小六",
            "text": "咦，清昼叔叔，你要去办什么事呀？",
            "nextDialogs": [
              "710331404"
            ]
          },
          "710331404": {
            "id": "710331404",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "我和一位画家定下了个…比试，要写一首最好的诗，和他画的画做比试，看看谁最好。",
            "nextDialogs": [
              "710331405"
            ]
          },
          "710331405": {
            "id": "710331405",
            "speakerId": 1004,
            "speakerName": "阿佐",
            "text": "哎呀，那肯定是清昼叔叔赢啦，那么多灯谜，哪一首都是很好很好的！",
            "nextDialogs": [
              "710331406"
            ]
          },
          "710331406": {
            "id": "710331406",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "是吗，谢谢你们的夸奖。你们先拿着这盏霄灯回轻策庄去慢慢猜吧，野外可不太安全。",
            "nextDialogs": [
              "710331407"
            ]
          },
          "710331407": {
            "id": "710331407",
            "speakerId": 1004,
            "speakerName": "阿佐",
            "text": "放心吧叔叔，这里我们可熟了，我们自己就能回去，你快去把那个画家打败吧！",
            "nextDialogs": [
              "710331408"
            ]
          },
          "710331408": {
            "id": "710331408",
            "speakerId": 1006,
            "speakerName": "阿佑",
            "text": "那…叔叔，你和那个画家比试完了之后，要快点过来呀。",
            "nextDialogs": [
              "710331409"
            ]
          },
          "710331409": {
            "id": "710331409",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "那是当然，等事情结束了，我就去找你们。",
            "nextDialogs": [
              "710331411"
            ]
          },
          "710331411": {
            "id": "710331411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这首诗是可以胜的。",
            "nextDialogs": [
              "710331412"
            ]
          },
          "710331412": {
            "id": "710331412",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "呵呵，什么诗，这只是一首灯谜而已。",
            "nextDialogs": [
              "710331413"
            ]
          },
          "710331413": {
            "id": "710331413",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "好了，我们去找那个画家吧，他肯定等急了。"
          }
        }
      }
    },
    {
      "subId": "7103311",
      "subQuestName": "与梵米尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710331101"
        ],
        "dialogs": {
          "710331101": {
            "id": "710331101",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "你总算是来了，你做好诗了吗？",
            "nextDialogs": [
              "710331102"
            ]
          },
          "710331102": {
            "id": "710331102",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "我没有写出一首合适的诗。",
            "nextDialogs": [
              "710331103"
            ]
          },
          "710331103": {
            "id": "710331103",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "你、你也…咳，你怎么没写出来？",
            "nextDialogs": [
              "710331104"
            ]
          },
          "710331104": {
            "id": "710331104",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "璃月大地，万家霄灯，我想来想去，都没能用一首诗概括，你画好了画吗？",
            "nextDialogs": [
              "710331105"
            ]
          },
          "710331105": {
            "id": "710331105",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "我…我也没有…璃月那么大！怎么画得下，我要是想画下来，就得用天来做画纸…",
            "nextDialogs": [
              "710331106"
            ]
          },
          "710331106": {
            "id": "710331106",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "如此说来，我们两个倒是都没有创作出能概括璃月港和海灯节的诗和画。",
            "nextDialogs": [
              "710331107"
            ]
          },
          "710331107": {
            "id": "710331107",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "那么，就该算是「平局」了。",
            "nextDialogs": [
              "710331108"
            ]
          },
          "710331108": {
            "id": "710331108",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "嗯…好吧，那就…",
            "nextDialogs": [
              "710331109"
            ]
          },
          "710331109": {
            "id": "710331109",
            "speakerId": 1004,
            "speakerName": "阿佐",
            "text": "清昼叔叔！清昼叔叔！你给我们出的灯谜，我们猜出来啦！",
            "nextDialogs": [
              "710331110"
            ]
          },
          "710331110": {
            "id": "710331110",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "灯、灯谜？什么灯谜？",
            "nextDialogs": [
              "710331111"
            ]
          },
          "710331111": {
            "id": "710331111",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "不须在意，是我陪着这群孩子们玩，给他们出的灯谜。",
            "nextDialogs": [
              "710331112"
            ]
          },
          "710331112": {
            "id": "710331112",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "噢？是什么灯谜，能说给我听听吗？",
            "nextDialogs": [
              "710331113"
            ]
          },
          "710331113": {
            "id": "710331113",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "「万千扁舟拂波去，烛映孤云峭岩间。身负流光浮沧海，终与龙宫彩鱼眠。」",
            "nextDialogs": [
              "710331114"
            ]
          },
          "710331114": {
            "id": "710331114",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "这是你给这群孩子们写的灯谜？这…",
            "nextDialogs": [
              "710331115"
            ]
          },
          "710331115": {
            "id": "710331115",
            "speakerId": 1004,
            "speakerName": "阿佐",
            "text": "清昼叔叔，这个叔叔又是谁啊？",
            "nextDialogs": [
              "710331118"
            ]
          },
          "710331118": {
            "id": "710331118",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "你这诗人，要真不想与我比试，那和我约定个什么劲？",
            "nextDialogs": [
              "710331119"
            ]
          },
          "710331119": {
            "id": "710331119",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "你误会了，我最开始确实抱着和你…一决胜负的心思，四处取材，殚精竭力…想要写出一首好诗。",
            "nextDialogs": [
              "710331120"
            ]
          },
          "710331120": {
            "id": "710331120",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "但你应该也感到了吧，只凭只言片语，是无法概括璃月港和海灯节的。所以…",
            "nextDialogs": [
              "710331121"
            ]
          },
          "710331121": {
            "id": "710331121",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "所以，你就跑到这里来陪孩子们玩？给他们出灯谜？",
            "nextDialogs": [
              "710331122"
            ]
          },
          "710331122": {
            "id": "710331122",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "正是这样，所以我来这里陪孩子们，给他们出灯谜，想再找到写那首诗的灵感。",
            "nextDialogs": [
              "710331123"
            ]
          },
          "710331123": {
            "id": "710331123",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "呵呵，但是灵感没找到，灯谜倒是出了不少，孩子们也很开心。",
            "nextDialogs": [
              "710331124"
            ]
          },
          "710331124": {
            "id": "710331124",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "或许…这就是我在找的那首「诗」了。可惜，我没办法把它写下来，也无法和你分出胜负来。",
            "nextDialogs": [
              "710331125"
            ]
          },
          "710331125": {
            "id": "710331125",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "你…你们璃月人，真是怪得很！那你我之间的比试，到底怎么算？谁输谁赢？我可不接受平局。",
            "nextDialogs": [
              "710331126"
            ]
          },
          "710331126": {
            "id": "710331126",
            "speakerId": 1004,
            "speakerName": "阿佐",
            "text": "这个叔叔怎么这么啰嗦…肯定是清昼叔叔赢啦。",
            "nextDialogs": [
              "710331127"
            ]
          },
          "710331127": {
            "id": "710331127",
            "speakerId": 1004,
            "speakerName": "阿佐",
            "text": "他可厉害了，出了好多好多灯谜，你肯定都猜不到谜底！",
            "nextDialogs": [
              "710331128"
            ]
          },
          "710331128": {
            "id": "710331128",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "你这诗人…嗯？等等，我有个主意…",
            "nextDialogs": [
              "710331129"
            ]
          },
          "710331129": {
            "id": "710331129",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "那，这样！你我之间，重新比过！",
            "nextDialogs": [
              "710331130"
            ]
          },
          "710331130": {
            "id": "710331130",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "哦？那你想要怎么重新比过？",
            "nextDialogs": [
              "710331131"
            ]
          },
          "710331131": {
            "id": "710331131",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "你不是给这群孩子们出灯谜吗？我在取材的时候，也看到了许多霄灯的纹样。",
            "nextDialogs": [
              "710331132"
            ]
          },
          "710331132": {
            "id": "710331132",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "我们俩，一个出灯谜，一个画霄灯，让这群孩子们做评委，看他们更喜欢谁，你看怎么样？",
            "nextDialogs": [
              "710331133"
            ]
          },
          "710331133": {
            "id": "710331133",
            "speakerId": 1003,
            "speakerName": "清昼",
            "text": "好！正合我意，也合了这海灯节之意，如此再好不过了。",
            "nextDialogs": [
              "710331134"
            ]
          },
          "710331134": {
            "id": "710331134",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "那就这样，等我收拾收拾画具，我们就在这里，重新比过！"
          }
        }
      }
    },
    {
      "subId": "7103312",
      "subQuestName": "与若心对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710331201"
        ],
        "dialogs": {
          "710331201": {
            "id": "710331201",
            "speakerId": 1002,
            "speakerName": "若心",
            "text": "嗯？你们有什么事吗？",
            "nextDialogs": [
              "710331202"
            ]
          },
          "710331202": {
            "id": "710331202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于清昼和梵米尔的比试…",
            "nextDialogs": [
              "710331203"
            ]
          },
          "710331203": {
            "id": "710331203",
            "speakerId": 1002,
            "speakerName": "若心",
            "text": "你说那两位啊，没事，没事，他们愿意陪孩子们玩就最好了。",
            "nextDialogs": [
              "710331204"
            ]
          },
          "710331204": {
            "id": "710331204",
            "speakerId": 1002,
            "speakerName": "若心",
            "text": "这大过节的，还是要热热闹闹的才好。",
            "nextDialogs": [
              "710331205"
            ]
          },
          "710331205": {
            "id": "710331205",
            "speakerId": 1002,
            "speakerName": "若心",
            "text": "倒是你，孩子，一直为我们这轻策庄东奔西跑的，辛苦你了。",
            "nextDialogs": [
              "710331208"
            ]
          },
          "710331208": {
            "id": "710331208",
            "speakerId": 1002,
            "speakerName": "若心",
            "text": "你这孩子倒是热心…这些东西请你收下吧，谢谢你啦，你也要过个好节啊。",
            "nextDialogs": [
              "710331209"
            ]
          },
          "710331209": {
            "id": "710331209",
            "speakerId": 1002,
            "speakerName": "若心",
            "text": "希望之后的海灯节，这里也能这么热闹啊…"
          }
        }
      }
    },
    {
      "subId": "7103350",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710335001"
        ],
        "dialogs": {
          "710335001": {
            "id": "710335001",
            "speakerId": 1002,
            "speakerName": "若心",
            "text": "您找清昼先生，是有什么重要的事吗？",
            "nextDialogs": [
              "710335002"
            ]
          },
          "710335002": {
            "id": "710335002",
            "speakerId": 1001,
            "speakerName": "梵米尔",
            "text": "嗯…也不算什么重要的事吧，只是一幅画和一首诗而已…"
          }
        }
      }
    },
    {
      "subId": "7103351",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710335101"
        ],
        "dialogs": {
          "710335101": {
            "id": "710335101",
            "speakerId": 1005,
            "speakerName": "小六",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你猜到谜底了吗？"
          }
        }
      }
    },
    {
      "subId": "7103352",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710335201"
        ],
        "dialogs": {
          "710335201": {
            "id": "710335201",
            "speakerId": 1006,
            "speakerName": "阿佑",
            "text": "清昼叔叔可真厉害啊，到底读了多少书才能这么厉害…"
          }
        }
      }
    },
    {
      "subId": "7103353",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710335301"
        ],
        "dialogs": {
          "710335301": {
            "id": "710335301",
            "speakerId": 1004,
            "speakerName": "阿佐",
            "text": "谜底到底是什么，不然，我们一起想想？"
          }
        }
      }
    }
  ]
}
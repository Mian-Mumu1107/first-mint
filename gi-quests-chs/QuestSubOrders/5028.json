    {
      "subId": "502802",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50280202"
        ],
        "dialogs": {
          "50280202": {
            "id": "50280202",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "#{M#他}{F#她}的灵魂正直而纯净，「英雄」也只是{M#他}{F#她}的起点。",
            "nextDialogs": [
              "50280207"
            ]
          },
          "50280207": {
            "id": "50280207",
            "speakerId": 1092,
            "speakerName": "恰斯卡",
            "text": "#想随{M#他}{F#她}振翅高飞，去看天外世界。",
            "nextDialogs": [
              "50280208"
            ]
          },
          "50280208": {
            "id": "50280208",
            "speakerId": 1091,
            "speakerName": "伊安珊",
            "text": "#想了解{M#他}{F#她}的故乡，养育{M#他}{F#她}的土地一定很自由，很温暖。",
            "nextDialogs": [
              "50280211"
            ]
          },
          "50280211": {
            "id": "50280211",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "#我羡慕{M#他}{F#她}见多识广，却依然能享受当下。",
            "nextDialogs": [
              "50280212"
            ]
          },
          "50280212": {
            "id": "50280212",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "#能和{M#他}{F#她}做朋友真是太开心啦！"
          }
        }
      }
    },
    {

    {
      "subId": "502805",
      "subQuestName": "继续「你」的旅途",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50280501"
        ],
        "dialogs": {
          "50280501": {
            "id": "50280501",
            "speakerId": 1003,
            "speakerName": "虚空中的声音",
            "text": "降临者的生命比你想象中更有价值。",
            "nextDialogs": [
              "50280502"
            ]
          },
          "50280502": {
            "id": "50280502",
            "speakerId": 1003,
            "speakerName": "虚空中的声音",
            "text": "你亲手捏碎了世界的希望。",
            "nextDialogs": [
              "50280503"
            ]
          },
          "50280503": {
            "id": "50280503",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "若我注定失败，你又为何恐惧。",
            "nextDialogs": [
              "50280504"
            ]
          },
          "50280504": {
            "id": "50280504",
            "speakerId": 1003,
            "speakerName": "虚空中的声音",
            "text": "……",
            "nextDialogs": [
              "50280505"
            ]
          },
          "50280505": {
            "id": "50280505",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "（为了愿望，我们步上巡礼。）",
            "nextDialogs": [
              "50280506"
            ]
          },
          "50280506": {
            "id": "50280506",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "（为了最强之名，我们云聚斗争。）",
            "nextDialogs": [
              "50280507"
            ]
          },
          "50280507": {
            "id": "50280507",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "（为了梦，我们在劫火中燃尽。）",
            "nextDialogs": [
              "50280508"
            ]
          },
          "50280508": {
            "id": "50280508",
            "speakerId": 1089,
            "speakerName": "玛薇卡",
            "text": "（如此轮回，循环往复…）"
          }
        }
      }
    },

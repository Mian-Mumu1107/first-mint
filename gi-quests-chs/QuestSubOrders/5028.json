            "speakerId": 14945,
            "speakerName": "柯夏尼娜",
            "text": "此等火焰我已目睹过数十次，待薪柴燃尽，黑夜又会卷土重来。",
            "nextDialogs": [
              "50289902"
            ]
          },
          "50289902": {
            "id": "50289902",
            "speakerId": 14945,
            "speakerName": "柯夏尼娜",
            "text": "失败，失败，失败，失败，失败，失败，失败…"

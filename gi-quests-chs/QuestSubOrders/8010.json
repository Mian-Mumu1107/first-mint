    {
      "subId": "801008",
      "subQuestName": "将药喂给丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80101201"
        ],
        "dialogs": {
          "80101201": {
            "id": "80101201",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "卡利贝尔？",
            "nextDialogs": [
              "80101202"
            ]
          },
          "80101202": {
            "id": "80101202",
            "speakerId": 1003,
            "speakerName": "卡利贝尔",
            "text": "……",
            "nextDialogs": [
              "80101203"
            ]
          },
          "80101203": {
            "id": "80101203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（丘丘人没有任何生机一般，对一切事物的反应都很薄弱…）",
            "nextDialogs": [
              "80101204"
            ]
          },
          "80101204": {
            "id": "80101204",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "药既然已经做好了，就试试看吧。",
            "nextDialogs": [
              "80101205"
            ]
          },
          "80101205": {
            "id": "80101205",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "在你的帮助下，埃德让丘丘人服下了刚制好的药。",
            "nextDialogs": [
              "80101206"
            ]
          },
          "80101206": {
            "id": "80101206",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "卡利贝尔？是我，是爸爸…卡利贝尔？",
            "nextDialogs": [
              "80101207"
            ]
          },
          "80101207": {
            "id": "80101207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有反应了吗？",
            "nextDialogs": [
              "80101208"
            ]
          },
          "80101208": {
            "id": "80101208",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "卡利贝尔…拜托了，回话啊。",
            "nextDialogs": [
              "80101209"
            ]
          },
          "80101209": {
            "id": "80101209",
            "speakerId": 1003,
            "speakerName": "卡利贝尔",
            "text": "……",
            "nextDialogs": [
              "80101210"
            ]
          },
          "80101210": {
            "id": "80101210",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "你出生时我没能在你身边，你和妈妈蒙受苦难的时候，我也没来得及赶到…",
            "nextDialogs": [
              "80101211"
            ]
          },
          "80101211": {
            "id": "80101211",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "可现在爸爸在了，这些年爸爸一直都在你的身边，再也没有离开过你。",
            "nextDialogs": [
              "80101212"
            ]
          },
          "80101212": {
            "id": "80101212",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "你还在生我的气么，卡利贝尔？",
            "nextDialogs": [
              "80101213"
            ]
          },
          "80101213": {
            "id": "80101213",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "你应该已经清醒了吧，是不是只是不愿意跟我讲话？",
            "nextDialogs": [
              "80101214"
            ]
          },
          "80101214": {
            "id": "80101214",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "爸爸对不起你，卡利贝尔，原谅我，和我说句话吧！",
            "nextDialogs": [
              "80101215"
            ]
          },
          "80101215": {
            "id": "80101215",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "拜托了…",
            "nextDialogs": [
              "80101218"
            ]
          },
          "80101218": {
            "id": "80101218",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "可恶…",
            "nextDialogs": [
              "80101219"
            ]
          },
          "80101219": {
            "id": "80101219",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "神明，你们到底还要我怎么样？",
            "nextDialogs": [
              "80101220"
            ]
          },
          "80101220": {
            "id": "80101220",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "你们夺走我的一切，我还是在你们面前卑躬屈膝了！",
            "nextDialogs": [
              "80101221"
            ]
          },
          "80101221": {
            "id": "80101221",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "我也想把命给你们！可你们却不让我死！",
            "nextDialogs": [
              "80101222"
            ]
          },
          "80101222": {
            "id": "80101222",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "…我果然不该相信的，跟神明扯上一点关系的，都不该相信…不该抱有任何幻想…",
            "nextDialogs": [
              "80101223"
            ]
          },
          "80101223": {
            "id": "80101223",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "这世上的神明，从没有一瞬间站在过人类这边…"
          }
        }
      }

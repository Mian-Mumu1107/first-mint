  "subQuests": [
    {
      "subId": "801002",
      "subQuestName": "到屋内寻找派蒙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80100201"
        ],
        "dialogs": {
          "80100201": {
            "id": "80100201",
            "speakerId": 1000,
            "speakerName": "威严的男子",
            "text": "站住！你想干什么！",
            "nextDialogs": [
              "80100204"
            ]
          },
          "80100204": {
            "id": "80100204",
            "speakerId": 1000,
            "speakerName": "威严的男子",
            "text": "这里不是你想的那样…也别想在这里多管闲事！赶紧离开！"
          }
        }
      }
    },
    {
      "subId": "801003",
      "subQuestName": "进入屋内",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80100301"
        ],
        "dialogs": {
          "80100301": {
            "id": "80100301",
            "speakerId": 1001,
            "speakerName": "丘丘人",
            "text": "……",
            "nextDialogs": [
              "80100304"
            ]
          },
          "80100304": {
            "id": "80100304",
            "speakerId": 1000,
            "speakerName": "威严的男子",
            "text": "多余的事情少问，你可以放心，他没有任何攻击性…",
            "nextDialogs": [
              "80100305"
            ]
          },
          "80100305": {
            "id": "80100305",
            "speakerId": 1000,
            "speakerName": "威严的男子",
            "text": "…他的「前身」毕竟年纪还太小了。",
            "nextDialogs": [
              "80100306"
            ]
          },
          "80100306": {
            "id": "80100306",
            "speakerId": 1000,
            "speakerName": "威严的男子",
            "text": "总之你别想打他的主意，累了冷了的话就找个角落先休息吧。",
            "nextDialogs": [
              "80100307"
            ]
          },
          "80100307": {
            "id": "80100307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是…坎瑞亚人吧？",
            "nextDialogs": [
              "80100308"
            ]
          },
          "80100308": {
            "id": "80100308",
            "speakerId": 1000,
            "speakerName": "威严的男子",
            "text": "嗯？",
            "nextDialogs": [
              "80100309"
            ]
          },
          "80100309": {
            "id": "80100309",
            "speakerId": 1000,
            "speakerName": "威严的男子",
            "text": "你居然知道坎瑞亚…你到底是什么人？怎么看出我是坎瑞亚人的？"
          }
        }
      }
    },
    {
      "subId": "801018",
      "subQuestName": "进入屋内",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80101801"
        ],
        "dialogs": {
          "80101801": {
            "id": "80101801",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "到了，准备开始吧…",
            "nextDialogs": [
              "80101802"
            ]
          },
          "80101802": {
            "id": "80101802",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "等等…喂，刚才那边的是…？是卡利贝尔吗？",
            "nextDialogs": [
              "80101805"
            ]
          },
          "80101805": {
            "id": "80101805",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "糟了，难道是刚才我们做药的时候没留意，卡利贝尔跑出去了。",
            "nextDialogs": [
              "80101806"
            ]
          },
          "80101806": {
            "id": "80101806",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "走，我们快追上去！"
          }
        }
      }
    },
    {
      "subId": "801004",
      "subQuestName": "与埃德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80100801"
        ],
        "dialogs": {
          "80100801": {
            "id": "80100801",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "这是我记录下来的药品制作方法，拜托你按照上面的做吧。"
          }
        }
      }
    },
    {
      "subId": "801019",
      "subQuestName": "进入屋内",
      "sceneId": null,
      "locations": [],

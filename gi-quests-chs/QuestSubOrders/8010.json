      }
    },
    {
      "subId": "801006",
      "subQuestName": "与埃德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80101001"
        ],
        "dialogs": {
          "80101001": {
            "id": "80101001",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "做好了么，辛苦你了，让我看看…",
            "nextDialogs": [
              "80101002"
            ]
          },
          "80101002": {
            "id": "80101002",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "唔，老实说我也并不清楚这副药应该是什么样子的，毕竟那本禁书上面并没有附图。",
            "nextDialogs": [
              "80101003"
            ]
          },
          "80101003": {
            "id": "80101003",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "…好了，这一刻也终于来了…可恶。",
            "nextDialogs": [
              "80101006"
            ]
          },
          "80101006": {
            "id": "80101006",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "这副药还没完成，还有最后一步。",
            "nextDialogs": [
              "80101007"
            ]
          },
          "80101007": {
            "id": "80101007",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "我说过这种药物需要借助智慧之神的力量，才能做到将神智唤醒…",
            "nextDialogs": [
              "80101008"
            ]
          },
          "80101008": {
            "id": "80101008",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "所以…我们去祭拜七天神像。"
          }
        }
      }
    },
    {
      "subId": "801021",
      "subQuestName": "进入屋内",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "801007",
      "subQuestName": "前往附近的七天神像",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80101101"
        ],
        "dialogs": {
          "80101101": {
            "id": "80101101",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "神像…要我为这东西低头么…",
            "nextDialogs": [
              "80101102"
            ]
          },
          "80101102": {
            "id": "80101102",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "神明啊，看着我吧。",
            "nextDialogs": [
              "80101103"
            ]
          },
          "80101103": {
            "id": "80101103",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "我不会默念什么祷词，也不会发自内心去称颂什么。",
            "nextDialogs": [
              "80101104"
            ]
          },
          "80101104": {
            "id": "80101104",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "我的家园曾被你们毁灭，同僚饱受灾劫之苦，但我今日依然站在这里。",
            "nextDialogs": [
              "80101105"
            ]
          },
          "80101105": {
            "id": "80101105",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "有资格嘲弄我的，只有命运本身。",
            "nextDialogs": [
              "80101106"
            ]
          },
          "80101106": {
            "id": "80101106",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "神明啊，我已不再妄图证明我血脉中的罪孽与我无关，我只祈求你对幼小而不幸者的一点点垂怜。",
            "nextDialogs": [
              "80101107"
            ]
          },
          "80101107": {
            "id": "80101107",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "我的儿子，卡利贝尔…还未来得及见识世间的任何美好便成为怪物，这真的…真的不应是一个年幼生命的归宿。",
            "nextDialogs": [
              "80101108"
            ]
          },
          "80101108": {
            "id": "80101108",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "……",
            "nextDialogs": [
              "80101109"
            ]
          },
          "80101109": {
            "id": "80101109",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "如果神从一开始所做的一切，都是为了让桀骜的坎瑞亚人低头…",
            "nextDialogs": [
              "80101110"
            ]
          },
          "80101110": {
            "id": "80101110",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "那么，我便低头。",
            "nextDialogs": [
              "80101111"
            ]
          },
          "80101111": {
            "id": "80101111",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "我已摒弃此生所坚持的一切…",
            "nextDialogs": [
              "80101112"
            ]
          },
          "80101112": {
            "id": "80101112",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "只祈求一点点奇迹，让卡利贝尔…再重新看看这个世界。",
            "nextDialogs": [
              "80101113"
            ]
          },
          "80101113": {
            "id": "80101113",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "求你了…神明。",
            "nextDialogs": [
              "80101114"
            ]
          },
          "80101114": {
            "id": "80101114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "80101115"
            ]
          },
          "80101115": {
            "id": "80101115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（虽然还不清楚坎瑞亚灾变具体的真相，但坎瑞亚人真的蒙受了莫大的痛苦…）",
            "nextDialogs": [
              "80101116"
            ]
          },
          "80101116": {
            "id": "80101116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（坎瑞亚与神明…真的彻底无法共存么…）",
            "nextDialogs": [
              "80101117"
            ]
          },
          "80101117": {
            "id": "80101117",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "…让你看笑话了，我们走吧。",
            "nextDialogs": [
              "80101118"
            ]
          },
          "80101118": {
            "id": "80101118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "会好起来的。",
            "nextDialogs": [
              "80101119"
            ]
          },
          "80101119": {
            "id": "80101119",
            "speakerId": 1002,
            "speakerName": "埃德",
            "text": "…嗯。"
          }
        }
      }
    },
    {
      "subId": "801033",

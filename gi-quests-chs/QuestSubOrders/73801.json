    {
      "subId": "7380107",
      "subQuestName": "击败魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7380108",
      "subQuestName": "对话亚历山德拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738010801"
        ],
        "dialogs": {
          "738010801": {
            "id": "738010801",
            "speakerId": 1001,
            "speakerName": "亚历山德拉",
            "text": "抱歉…咳咳…普热瓦…",
            "nextDialogs": [
              "738010802"
            ]
          },
          "738010802": {
            "id": "738010802",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "少说废话。我先给你包扎。",
            "nextDialogs": [
              "738010803"
            ]
          },
          "738010803": {
            "id": "738010803",
            "speakerId": 1005,
            "speakerName": "尼卡",
            "text": "呜呜…呜…对不起…",
            "nextDialogs": [
              "738010804"
            ]
          },
          "738010804": {
            "id": "738010804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你来这里做什么？",
            "nextDialogs": [
              "738010805"
            ]
          },
          "738010805": {
            "id": "738010805",
            "speakerId": 1005,
            "speakerName": "尼卡",
            "text": "我…我是来这里摘蘑菇的…呜…",
            "nextDialogs": [
              "738010806"
            ]
          },
          "738010806": {
            "id": "738010806",
            "speakerId": 1005,
            "speakerName": "尼卡",
            "text": "因为亚历山德拉姐姐最近…最近好像很难过…",
            "nextDialogs": [
              "738010807"
            ]
          },
          "738010807": {
            "id": "738010807",
            "speakerId": 1005,
            "speakerName": "尼卡",
            "text": "所以我们就商量，要给亚历山德拉姐姐做好吃的，给她一个惊喜。",
            "nextDialogs": [
              "738010808"
            ]
          },
          "738010808": {
            "id": "738010808",
            "speakerId": 1005,
            "speakerName": "尼卡",
            "text": "之前亚历山德拉姐姐带我们来这里，摘了很多好吃的蘑菇，我就想要自己过来摘一点。",
            "nextDialogs": [
              "738010809"
            ]
          },
          "738010809": {
            "id": "738010809",
            "speakerId": 1005,
            "speakerName": "尼卡",
            "text": "但是，但是进了树林我就迷路了，然后就被好多蘑菇围住。",
            "nextDialogs": [
              "738010810"
            ]
          },
          "738010810": {
            "id": "738010810",
            "speakerId": 1005,
            "speakerName": "尼卡",
            "text": "亚历山德拉姐姐…亚历山德拉姐姐为了救我…呜…",
            "nextDialogs": [
              "738010811"
            ]
          },
          "738010811": {
            "id": "738010811",
            "speakerId": 1001,
            "speakerName": "亚历山德拉",
            "text": "咳…没…没事的，尼卡…姐姐没事…",
            "nextDialogs": [
              "738010812"
            ]
          },
          "738010812": {
            "id": "738010812",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "…旅行者，看来计划要变更了。",
            "nextDialogs": [
              "738010813"
            ]
          },
          "738010813": {
            "id": "738010813",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "亚历山德拉伤势太重，我们擅自离城应该已经被其他的愚人众发现了，现在我带着负伤的她回去，只怕会被抓着盘查。",
            "nextDialogs": [
              "738010816"
            ]
          },
          "738010816": {
            "id": "738010816",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "呵呵…只能将计就计了。",
            "nextDialogs": [
              "738010817"
            ]
          },
          "738010817": {
            "id": "738010817",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "我刚才在过来的时候，看见有一支镀金旅团的队伍正在往这边走。",
            "nextDialogs": [
              "738010818"
            ]
          },
          "738010818": {
            "id": "738010818",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "旅行者，你把这个小鬼先送出树林，交给镀金旅团的人，我会带着亚历山德拉离开。",
            "nextDialogs": [
              "738010819"
            ]
          },
          "738010819": {
            "id": "738010819",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "……",
            "nextDialogs": [
              "738010820"
            ]
          },
          "738010820": {
            "id": "738010820",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "还记得我们商量好的话术吗？看来这次我们得假戏真做了。",
            "nextDialogs": [
              "738010821"
            ]
          },
          "738010821": {
            "id": "738010821",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "镀金旅团的那个人一定会认为，我们这两个不怀好意的愚人众，是在这里进行某种不怀好意的计划，搭救尼卡只是一种掩饰。",
            "nextDialogs": [
              "738010822"
            ]
          },
          "738010822": {
            "id": "738010822",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "至于我们被魔物群起攻之…那就是我们罪有应得了。",
            "nextDialogs": [
              "738010823"
            ]
          },
          "738010823": {
            "id": "738010823",
            "speakerId": 1005,
            "speakerName": "尼卡",
            "text": "呜…亚历山德拉姐姐…我再也不淘气了…",
            "nextDialogs": [
              "738010824"
            ]
          },
          "738010824": {
            "id": "738010824",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "…好在这小鬼头现在应该也没有心思听我们说的话，不用担心他了。"
          }
        }
      }
    },
    {
      "subId": "7380109",
      "subQuestName": "将尼卡带去镀金旅团营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738010901"
        ],
        "dialogs": {
          "738010901": {
            "id": "738010901",
            "speakerId": 1006,
            "speakerName": "贝拉特",
            "text": "没想到这趟差事要绕这么远，真是累死个人…",
            "nextDialogs": [
              "738010902"
            ]
          },
          "738010902": {
            "id": "738010902",
            "speakerId": 1006,
            "speakerName": "贝拉特",
            "text": "那边的，什么人！",
            "nextDialogs": [
              "738010903"
            ]
          },
          "738010903": {
            "id": "738010903",
            "speakerId": 1006,
            "speakerName": "贝拉特",
            "text": "尼卡…还有旅行者，你们怎么跑到这里来了？",
            "nextDialogs": [
              "738010906"
            ]
          },
          "738010906": {
            "id": "738010906",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我，我们在赶时间！尼卡就拜托你啦！",
            "nextDialogs": [
              "738010907"
            ]
          },
          "738010907": {
            "id": "738010907",
            "speakerId": 1006,
            "speakerName": "贝拉特",
            "text": "哈？什么乱七八糟的，你给我等会！"
          }
        }
      }
    },
    {
      "subId": "7380110",
      "subQuestName": "回去原地查看亚历山德拉情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738011001"
        ],
        "dialogs": {
          "738011001": {
            "id": "738011001",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "亚历山德拉应该就在这附近啊，他们…他们去哪了？",
            "nextDialogs": [
              "738011004"
            ]
          },
          "738011004": {
            "id": "738011004",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你们在哪呀！",
            "nextDialogs": [
              "738011005"
            ]
          },
          "738011005": {
            "id": "738011005",
            "speakerId": 1006,
            "speakerName": "贝拉特",
            "text": "别叫了，再叫就把魔物引来了！",
            "nextDialogs": [
              "738011006"
            ]
          },
          "738011006": {
            "id": "738011006",
            "speakerId": 1006,
            "speakerName": "贝拉特",
            "text": "我都听尼卡说了，真没想到，亚历山德拉和普热瓦居然是愚人众。",
            "nextDialogs": [
              "738011007"
            ]
          },
          "738011007": {
            "id": "738011007",
            "speakerId": 1006,
            "speakerName": "贝拉特",
            "text": "平时我和他们打交道的时候，还觉得他们是好人呢…",
            "nextDialogs": [
              "738011008"
            ]
          },
          "738011008": {
            "id": "738011008",
            "speakerId": 1005,
            "speakerName": "尼卡",
            "text": "亚历山德拉姐姐就是好人！普热瓦哥哥很凶…但也是好人！",
            "nextDialogs": [
              "738011009"
            ]
          },
          "738011009": {
            "id": "738011009",
            "speakerId": 1006,
            "speakerName": "贝拉特",
            "text": "哎呀，但他们可是愚人众啊，谁知道是不是装成一副好人样，背地里打什么鬼主意。",
            "nextDialogs": [
              "738011010"
            ]
          },
          "738011010": {
            "id": "738011010",
            "speakerId": 1006,
            "speakerName": "贝拉特",
            "text": "愚人众的那些著名「事迹」，我可是听了不少啊。",
            "nextDialogs": [
              "738011011"
            ]
          },
          "738011011": {
            "id": "738011011",
            "speakerId": 1006,
            "speakerName": "贝拉特",
            "text": "说不定，他们就是在这里盘算着什么阴谋，搭救尼卡只不过是一种掩护呢？"
          }
        }
      }
    },
    {
      "subId": "7380111",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738011101"
        ],
        "dialogs": {
          "738011101": {
            "id": "738011101",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这个箱子里装着…一些旧衣服，还有一摞信纸。",
            "nextDialogs": [
              "738011102"
            ]
          },
          "738011102": {
            "id": "738011102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "信纸上写着什么？",
            "nextDialogs": [
              "738011103"
            ]
          },
          "738011103": {
            "id": "738011103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我看看喔…",
            "nextDialogs": [
              "738011104"
            ]
          },
          "738011104": {
            "id": "738011104",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "上面写着「降诸魔山南，旧船离港。」",
            "nextDialogs": [
              "738011105"
            ]
          },
          "738011105": {
            "id": "738011105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这都是什么呀？明明是在山里，怎么会有船呢…",
            "nextDialogs": [
              "738011108"
            ]
          },
          "738011108": {
            "id": "738011108",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "而且，也不知道是谁把箱子放在这里的。",
            "nextDialogs": [
              "738011109"
            ]
          },
          "738011109": {
            "id": "738011109",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不管了，先过去看看吧！"
          }
        }
      }
    },
    {
      "subId": "7380112",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738011201"
        ],
        "dialogs": {
          "738011201": {
            "id": "738011201",
            "speakerId": 1006,
            "speakerName": "贝拉特",
            "text": "别哭了尼卡，到底发生了什么事？",
            "nextDialogs": [
              "738011202"
            ]
          },
          "738011202": {
            "id": "738011202",
            "speakerId": 1005,
            "speakerName": "尼卡",
            "text": "呜…呜呜…亚历山德拉姐姐…",
            "nextDialogs": [
              "738011203"
            ]
          },
          "738011203": {
            "id": "738011203",
            "speakerId": 1006,
            "speakerName": "贝拉特",
            "text": "亚历山德拉？她怎么会来这里？",
            "nextDialogs": [
              "738011204"
            ]
          },
          "738011204": {
            "id": "738011204",
            "speakerId": 1006,
            "speakerName": "贝拉特",
            "text": "尼卡，你详细和我说说…"
          }
        }
      }
    },
    {
      "subId": "7380113",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738011301"
        ],
        "dialogs": {
          "738011301": {
            "id": "738011301",
            "speakerId": 1001,
            "speakerName": "亚历山德拉",
            "text": "咳…抱歉，普热瓦，我果然不太适合这份工作啊…",
            "nextDialogs": [
              "738011302"
            ]
          },
          "738011302": {
            "id": "738011302",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "少说几句话。"
          }
        }
      }
    }
  ]
}
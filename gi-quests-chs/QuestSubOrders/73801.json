  "subQuests": [
    {
      "subId": "7380101",
      "subQuestName": "获得道具block$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738010101"
        ],
        "dialogs": {
          "738010101": {
            "id": "738010101",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "…新生意谈好了吗？",
            "nextDialogs": [
              "738010102"
            ]
          },
          "738010102": {
            "id": "738010102",
            "speakerId": 1001,
            "speakerName": "亚历山德拉",
            "text": "旧货船刚刚卸好了货，放心吧。",
            "nextDialogs": [
              "738010103"
            ]
          },
          "738010103": {
            "id": "738010103",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "船没漏吧？<color=#00E1FFFF>上面的货…</color>都藏好了？",
            "nextDialogs": [
              "738010104"
            ]
          },
          "738010104": {
            "id": "738010104",
            "speakerId": 1001,
            "speakerName": "亚历山德拉",
            "text": "都藏好了，藏得严严实实的。",
            "nextDialogs": [
              "738010105"
            ]
          },
          "738010105": {
            "id": "738010105",
            "speakerId": 1001,
            "speakerName": "亚历山德拉",
            "text": "但是…换下来的老物件怎么办？",
            "nextDialogs": [
              "738010106"
            ]
          },
          "738010106": {
            "id": "738010106",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "今天就作废掉。新货到了手…老物件就可以丢了。",
            "nextDialogs": [
              "738010107"
            ]
          },
          "738010107": {
            "id": "738010107",
            "speakerId": 1001,
            "speakerName": "亚历山德拉",
            "text": "真，真的没问题吗…"
          }
        }
      }
    },
    {
      "subId": "7380102",
      "subQuestName": "获得神秘道具后与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738010201"
        ],
        "dialogs": {
          "738010201": {
            "id": "738010201",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喔！箱子打开了！意外地不算困难呢。",
            "nextDialogs": [
              "738010204"
            ]
          },
          "738010204": {
            "id": "738010204",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔唔唔，总之…先看看里面装着什么东西吧。",
            "nextDialogs": [
              "738010205"
            ]
          },
          "738010205": {
            "id": "738010205",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这里面…看起来都是一些旧衣服，还有一摞信纸。",
            "nextDialogs": [
              "738010206"
            ]
          },
          "738010206": {
            "id": "738010206",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "上面写着…",
            "nextDialogs": [
              "738010207"
            ]
          },
          "738010207": {
            "id": "738010207",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "「降诸魔山南，旧船离港。」",
            "nextDialogs": [
              "738010208"
            ]
          },
          "738010208": {
            "id": "738010208",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这都是什么呀？明明是在山里，怎么会有船呢…"
          }
        }
      }
    },
    {
      "subId": "7380103",
      "subQuestName": "去老地方探查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738010301"
        ],
        "dialogs": {
          "738010301": {
            "id": "738010301",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "降诸魔山的南方…这范围也太远了。",
            "nextDialogs": [
              "738010302"
            ]
          },
          "738010302": {
            "id": "738010302",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这里视野不错，我们就在这里先等等，看会不会有人过来吧。",
            "nextDialogs": [
              "738010303"
            ]
          },
          "738010303": {
            "id": "738010303",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "和派蒙在此等待…",
            "nextDialogs": [
              "738010304"
            ]
          },
          "738010304": {
            "id": "738010304",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "看，那边有人来了！",
            "nextDialogs": [
              "738010305"
            ]
          },
          "738010305": {
            "id": "738010305",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "怎么来得这么晚，是遇见什么麻烦了吗？",
            "nextDialogs": [
              "738010306"
            ]
          },
          "738010306": {
            "id": "738010306",
            "speakerId": 1001,
            "speakerName": "亚历山德拉",
            "text": "…抱歉，箱子好像被人翻过了，我们的事…",
            "nextDialogs": [
              "738010307"
            ]
          },
          "738010307": {
            "id": "738010307",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "啧，难道是被发现了？不对…最近上面也没来过人…",
            "nextDialogs": [
              "738010308"
            ]
          },
          "738010308": {
            "id": "738010308",
            "speakerId": 1001,
            "speakerName": "亚历山德拉",
            "text": "也许…也许是尼卡翻的呢？那群孩子最近总是过来央求我带他们出去玩…",
            "nextDialogs": [
              "738010309"
            ]
          },
          "738010309": {
            "id": "738010309",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "唉…所以我说，除了必要的交际之外，不要和那些居民走太近。",
            "nextDialogs": [
              "738010310"
            ]
          },
          "738010310": {
            "id": "738010310",
            "speakerId": 1001,
            "speakerName": "亚历山德拉",
            "text": "可是，他们的父母总是不在家，我实在是…",
            "nextDialogs": [
              "738010311"
            ]
          },
          "738010311": {
            "id": "738010311",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "算了，先不管这些，无论如何，今天我们都要离开这里。",
            "nextDialogs": [
              "738010312"
            ]
          },
          "738010312": {
            "id": "738010312",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "离开？他们的意思是…要离开须弥吗？",
            "nextDialogs": [
              "738010313"
            ]
          },
          "738010313": {
            "id": "738010313",
            "speakerId": 1001,
            "speakerName": "亚历山德拉",
            "text": "我们没有帮手，那个计划…真的会成功吗？要是被上面的人知道了的话…",
            "nextDialogs": [
              "738010314"
            ]
          },
          "738010314": {
            "id": "738010314",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "管不了那么多了…你是还没有受够吗？",
            "nextDialogs": [
              "738010315"
            ]
          },
          "738010315": {
            "id": "738010315",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "天天提心吊胆，时时刻刻都被人提防…",
            "nextDialogs": [
              "738010316"
            ]
          },
          "738010316": {
            "id": "738010316",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "想要从愚人众里脱身，今天就是最后的机会！",
            "nextDialogs": [
              "738010317"
            ]
          },
          "738010317": {
            "id": "738010317",
            "speakerId": 1001,
            "speakerName": "亚历山德拉",
            "text": "我，我知道，但是…",
            "nextDialogs": [
              "738010318"
            ]
          },
          "738010318": {
            "id": "738010318",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这两个人…想要脱离愚人众？",
            "nextDialogs": [
              "738010319"
            ]
          },
          "738010319": {
            "id": "738010319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "出去看看。",
            "nextDialogs": [
              "738010320"
            ]
          },
          "738010320": {
            "id": "738010320",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯，不过还是要小心，他们可是愚人众啊！"
          }
        }
      }
    },
    {
      "subId": "7380104",
      "subQuestName": "与愚人众对峙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738010401"
        ],
        "dialogs": {
          "738010401": {
            "id": "738010401",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "呵呵，终于还是有人来了。",
            "nextDialogs": [
              "738010402"
            ]
          },
          "738010402": {
            "id": "738010402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你发现我了？",
            "nextDialogs": [
              "738010403"
            ]
          },
          "738010403": {
            "id": "738010403",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "你听的时间太久，一直没有动过位置。",
            "nextDialogs": [
              "738010404"
            ]
          },
          "738010404": {
            "id": "738010404",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "刚才有一阵风吹过，你藏身的那丛灌木摆动的样子，明显和旁边的灌木不同。",
            "nextDialogs": [
              "738010405"
            ]
          },
          "738010405": {
            "id": "738010405",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不，不愧是愚人众…",
            "nextDialogs": [
              "738010406"
            ]
          },
          "738010406": {
            "id": "738010406",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "金发…还有旁边的奇异仙灵。看来你就是报告上提到的那位「旅行者」了。",
            "nextDialogs": [
              "738010410",
              "738010409"
            ]
          },
          "738010410": {
            "id": "738010410",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "你既然来了这里，那就证明你已经看过了箱子里的东西了吧。",
            "nextDialogs": [
              "738010411"
            ]
          },
          "738010411": {
            "id": "738010411",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "真没想到，亚历山德拉的小机灵居然真能派上用场。"
          },
          "738010409": {
            "id": "738010409",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "放心吧，我们可没有那个时间。"
          }
        }
      }
    },
    {
      "subId": "7380105",
      "subQuestName": "去埋伏点探查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "738010501"
        ],
        "dialogs": {
          "738010501": {
            "id": "738010501",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "就是这里了。旅行者，计划很简单。",
            "nextDialogs": [
              "738010502"
            ]
          },
          "738010502": {
            "id": "738010502",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "我们是两个…呵呵，不怀好意的愚人众，前来这片树林里做一些不怀好意的事。",
            "nextDialogs": [
              "738010503"
            ]
          },
          "738010503": {
            "id": "738010503",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "而你，无论是出于义愤，还是出于维护正义的态度，出手试图制止我们行恶。",
            "nextDialogs": [
              "738010504"
            ]
          },
          "738010504": {
            "id": "738010504",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "在交手的过程中，我和亚历山德拉准备逃跑，但突然有一群魔物闯入，而我们也被那群魔物给打倒。",
            "nextDialogs": [
              "738010505"
            ]
          },
          "738010505": {
            "id": "738010505",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "而你因为魔物的数量太多，也只好撤退，等带人过来的时候，我和亚历山德拉也已经不见了。",
            "nextDialogs": [
              "738010506"
            ]
          },
          "738010506": {
            "id": "738010506",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "故事就是这样，你觉得怎么样？",
            "nextDialogs": [
              "738010508",
              "738010510"
            ]
          },
          "738010508": {
            "id": "738010508",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "为了把这个故事讲圆，同时让我们被打倒得更自然一点，我可是花了很大的功夫。",
            "nextDialogs": [
              "738010512"
            ]
          },
          "738010512": {
            "id": "738010512",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "不过，亚历山德拉怎么还没回来，就是布设一点魔物诱饵，至于用这么长时间吗？",
            "nextDialogs": [
              "738010513"
            ]
          },
          "738010513": {
            "id": "738010513",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "亚历山德拉姐姐！亚历山德拉姐姐！呜…",
            "nextDialogs": [
              "738010514"
            ]
          },
          "738010514": {
            "id": "738010514",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那，那边有人的声音！",
            "nextDialogs": [
              "738010515"
            ]
          },
          "738010515": {
            "id": "738010515",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "糟了，亚历山德拉出事了！",
            "nextDialogs": [
              "738010516"
            ]
          },
          "738010516": {
            "id": "738010516",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喂！等等！你干什么去啊？！",
            "nextDialogs": [
              "738010517"
            ]
          },
          "738010517": {
            "id": "738010517",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "快追上去！",
            "nextDialogs": [
              "738010518"
            ]
          },
          "738010518": {
            "id": "738010518",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "到底发生了什么事…"
          },
          "738010510": {
            "id": "738010510",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "没错，愚人众里在外做情报的「钉子」，一般都会落到这种下场。",
            "nextDialogs": [
              "738010511"
            ]
          },
          "738010511": {
            "id": "738010511",
            "speakerId": 1000,
            "speakerName": "普热瓦",
            "text": "我们正是不想就这么消失，才做的这次计划。"
          }
        }
      }
    },
    {
      "subId": "7380106",
      "subQuestName": "前往呼救声来源处探查",
      "sceneId": null,
      "locations": [],

        "dialogs": {
          "745230401": {
            "id": "745230401",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "这风中…带来了海潮的咸味，远方商船的木香，还有…故人的气息。",
            "nextDialogs": [
              "745230402"
            ]
          },
          "745230402": {
            "id": "745230402",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "#{NICKNAME}，别来无恙。",
            "nextDialogs": [
              "745230405"
            ]
          },
          "745230405": {
            "id": "745230405",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "「南十字」船队在稻妻停靠补给。难得故地重游，便想四处走走，多看一眼故乡的景色，多听一听这里的风声。",
            "nextDialogs": [
              "745230406"
            ]
          },
          "745230406": {
            "id": "745230406",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "离岛的风，总是比别处更喧闹些，混杂着离别与重逢，希望与迷惘…是个能听到许多故事的地方。"
          }
        }
      }
    }

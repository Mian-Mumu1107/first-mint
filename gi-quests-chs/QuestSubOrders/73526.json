{
  "lineCounts": {
    "Black Screen": 2,
    "Player": 6,
    "「吼吼小狐」": 1,
    "派蒙": 18,
    "玛蒂哈": 20
  },
  "subQuests": [
    {
      "subId": "7352601",
      "subQuestName": "与奇怪的商人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735260101"
        ],
        "dialogs": {
          "735260101": {
            "id": "735260101",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "早知道就找人帮忙跑腿了…",
            "nextDialogs": [
              "735260102"
            ]
          },
          "735260102": {
            "id": "735260102",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "只不过是第一次测试，居然就要翻山越岭，这是什么人间疾苦！",
            "nextDialogs": [
              "735260103"
            ]
          },
          "735260103": {
            "id": "735260103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你不要紧吧？说话都有气无力的…",
            "nextDialogs": [
              "735260104"
            ]
          },
          "735260104": {
            "id": "735260104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，她看起来完全虚脱了，我们做点东西给她吃吧！",
            "nextDialogs": [
              "735260105"
            ]
          },
          "735260105": {
            "id": "735260105",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "在附近的炉灶做好了热气腾腾的炸萝卜丸子和烤肉排，让这位虚脱的陌生人补充了体能…",
            "nextDialogs": [
              "735260106"
            ]
          },
          "735260106": {
            "id": "735260106",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "哈哈哈哈！我又活过来了！",
            "nextDialogs": [
              "735260107"
            ]
          },
          "735260107": {
            "id": "735260107",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "手艺还不错，可惜食材和调料的品质不好，导致食物的口感干巴巴的。",
            "nextDialogs": [
              "735260108"
            ]
          },
          "735260108": {
            "id": "735260108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这种时候就不要挑三拣四了啦，吃饱肚子不就行了吗！",
            "nextDialogs": [
              "735260109"
            ]
          },
          "735260109": {
            "id": "735260109",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "错了错了！越是困苦的时候，越要想象奢侈的生活，这样才能给自己奋斗的动力！",
            "nextDialogs": [
              "735260110"
            ]
          },
          "735260110": {
            "id": "735260110",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "越是资金周转不开时，越要想办法高额借款，这样才能大开大合，抓住破局的机会！",
            "nextDialogs": [
              "735260111"
            ]
          },
          "735260111": {
            "id": "735260111",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "这就是我，「幻之玩具王·玛蒂哈」给你们的回报——逆转局势的商业秘诀。",
            "nextDialogs": [
              "735260112"
            ]
          },
          "735260112": {
            "id": "735260112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "幻…之玩具王？听起来倒是挺威风的，不过看你狼狈的样子，总感觉有蹊跷…",
            "nextDialogs": [
              "735260115"
            ]
          },
          "735260115": {
            "id": "735260115",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "你们！你们是怎么看穿的！",
            "nextDialogs": [
              "735260116"
            ]
          },
          "735260116": {
            "id": "735260116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "刚才你都饿得快昏倒了啦，神志不清的时候还在自言自语，说什么测试，找人跑腿…",
            "nextDialogs": [
              "735260117"
            ]
          },
          "735260117": {
            "id": "735260117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一看就知道，你还没做好你的招牌玩具吧？甚至连饭都顾不上吃了，未免也太惨了嘛！",
            "nextDialogs": [
              "735260118"
            ]
          },
          "735260118": {
            "id": "735260118",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "可…可恶，被你这么一说，我好不甘心！我的「吼吼小狐」已经进入生产前的最终阶段了！",
            "nextDialogs": [
              "735260119"
            ]
          },
          "735260119": {
            "id": "735260119",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "只要测出了「吼吼小狐」的飞行包线，就能完成蕈兽都能看懂的说明书。再借一大笔钱批量生产，就能盈利了！",
            "nextDialogs": [
              "735260120"
            ]
          },
          "735260120": {
            "id": "735260120",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么飞行包线？什么说明书？不要对我们讲这么多术语啦！",
            "nextDialogs": [
              "735260121"
            ]
          },
          "735260121": {
            "id": "735260121",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "空谈无益，就让你们见识一下吧！",
            "nextDialogs": [
              "735260122"
            ]
          },
          "735260122": {
            "id": "735260122",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "玛蒂哈从行囊中取出了一个蓝色的包裹，对它快速充气。\\n片刻过后，造型奇妙的玩具便在你们的面前成形了，稳稳地飘浮在半空中。",
            "nextDialogs": [
              "735260123"
            ]
          },
          "735260123": {
            "id": "735260123",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这就是你说的王牌玩具吗？明明一点都不像狐狸啦！还不如起个…「大耳朵日落果炸弹·青之星星限定版」之类的名字！",
            "nextDialogs": [
              "735260124"
            ]
          },
          "735260124": {
            "id": "735260124",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还有，「吼吼」是怎么回事？它的表情也不像在笑啊？",
            "nextDialogs": [
              "735260125"
            ]
          },
          "735260125": {
            "id": "735260125",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "不不不，是因为它的喷气装置工作时的动静听起来像是人在吼吼大笑！不信你们听听看！",
            "nextDialogs": [
              "735260126"
            ]
          },
          "735260126": {
            "id": "735260126",
            "speakerId": 1003,
            "speakerName": "「吼吼小狐」",
            "text": "（发出难以名状的低频啸叫，大概也许勉强可以用「吼吼」来打比方）",
            "nextDialogs": [
              "735260127"
            ]
          },
          "735260127": {
            "id": "735260127",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#她到底从哪听到的这种笑声…{NICKNAME}，我有点担心她的精神状态…",
            "nextDialogs": [
              "735260128"
            ]
          },
          "735260128": {
            "id": "735260128",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "总之，「吼吼小狐」由小型热气球提供升力，隐藏的小喷气口提供推力，有着不错的操作性。",
            "nextDialogs": [
              "735260129"
            ]
          },
          "735260129": {
            "id": "735260129",
            "speakerId": 1000,
            "speakerName": "玛蒂哈",
            "text": "想象一下，它可是能灵活飞行的玩具！别说一般的小孩了，就连大人也无法抵抗它的诱惑！"
          }
        }
      }
    },
    {
      "subId": "7352699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735269901"
        ],
        "dialogs": {
          "735269901": {
            "id": "735269901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#不好了，{NICKNAME}！那边有人倒在地上，看起来很不妙…我们去帮帮她吧！"
          }
        }
      }
    }
  ]
}
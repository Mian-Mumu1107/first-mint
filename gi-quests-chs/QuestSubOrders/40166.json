  },
  "subQuests": [
    {
      "subId": "4016602",
      "subQuestName": "前往奥摩斯港",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401660201"
        ],
        "dialogs": {
          "401660201": {
            "id": "401660201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？那边不是提纳里和柯莱吗？还有迪希雅和坎蒂丝！",
            "nextDialogs": [
              "401660202"
            ]
          },
          "401660202": {
            "id": "401660202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们过去和他们打个招呼吧！",
            "nextDialogs": [
              "401660203"
            ]
          },
          "401660203": {
            "id": "401660203",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "…分工都清楚了吧？接下来就是分头行动了。",
            "nextDialogs": [
              "401660204"
            ]
          },
          "401660204": {
            "id": "401660204",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "另外我还是再提醒一次，大家多留个心眼，千万别被她发现了。",
            "nextDialogs": [
              "401660205"
            ]
          },
          "401660205": {
            "id": "401660205",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "哎呀这你就放心吧，对我们佣兵来说，秘密可是比生命还重要的东西！",
            "nextDialogs": [
              "401660206"
            ]
          },
          "401660206": {
            "id": "401660206",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "我认为，应该还不至于发生这类情况。",
            "nextDialogs": [
              "401660207"
            ]
          },
          "401660207": {
            "id": "401660207",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "打比方啦打比方，你懂我的意思。",
            "nextDialogs": [
              "401660208"
            ]
          },
          "401660208": {
            "id": "401660208",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "唔…我还是有些担心。倒不是怕自己说漏嘴，是怕她如果冷不丁出现在身后，而我又没来得及发现…",
            "nextDialogs": [
              "401660209"
            ]
          },
          "401660209": {
            "id": "401660209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "大家好呀！你们在这里聊什么呢？",
            "nextDialogs": [
              "401660210"
            ]
          },
          "401660210": {
            "id": "401660210",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "唔啊啊！我不是我不知道什么都没聊，我绝对没藏什么秘密！",
            "nextDialogs": [
              "401660213"
            ]
          },
          "401660213": {
            "id": "401660213",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "…冷静点，柯莱，至少也先看清是谁来了吧。",
            "nextDialogs": [
              "401660214"
            ]
          },
          "401660214": {
            "id": "401660214",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "#{NICKNAME}和派蒙！没想到会在这里见到你们！",
            "nextDialogs": [
              "401660215"
            ]
          },
          "401660215": {
            "id": "401660215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也很高兴见到大家。",
            "nextDialogs": [
              "401660216"
            ]
          },
          "401660216": {
            "id": "401660216",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "欸？是你们？啊…吓死我了，简直比上课开小差发现提纳里师父站在我身后还吓人…",
            "nextDialogs": [
              "401660217"
            ]
          },
          "401660217": {
            "id": "401660217",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "二位是回须弥来参加花神诞祭的吗？",
            "nextDialogs": [
              "401660218"
            ]
          },
          "401660218": {
            "id": "401660218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！一想到节日期间会很热闹，就回来找朋友们一起玩玩啦！",
            "nextDialogs": [
              "401660219"
            ]
          },
          "401660219": {
            "id": "401660219",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "的确，听老师说，教令院今年也做了许多筹备，打算给草神大人过一个空前盛大的生日。",
            "nextDialogs": [
              "401660220"
            ]
          },
          "401660220": {
            "id": "401660220",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "也算是对曾经教令院种种过错的一个微不足道的补偿吧。",
            "nextDialogs": [
              "401660221"
            ]
          },
          "401660221": {
            "id": "401660221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，那我们算来对了呢，这下好玩好吃的肯定少不了！",
            "nextDialogs": [
              "401660222"
            ]
          },
          "401660222": {
            "id": "401660222",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过话说回来，你们刚才在偷偷摸摸说什么呀？什么秘密不秘密的？",
            "nextDialogs": [
              "401660223"
            ]
          },
          "401660223": {
            "id": "401660223",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "来，你俩过来，我悄悄跟你们说。",
            "nextDialogs": [
              "401660224"
            ]
          },
          "401660224": {
            "id": "401660224",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "我们打算为草神大人准备一个惊喜。",
            "nextDialogs": [
              "401660225"
            ]
          },
          "401660225": {
            "id": "401660225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！生日惊喜！",
            "nextDialogs": [
              "401660226"
            ]
          },
          "401660226": {
            "id": "401660226",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "这还是迪希雅提出来的呢。",
            "nextDialogs": [
              "401660227"
            ]
          },
          "401660227": {
            "id": "401660227",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "欸？我也是和迪娜泽黛聊天时偶然想到的。每一届花神诞祭的活动都比较类似，总觉得该来些不一样的东西。",
            "nextDialogs": [
              "401660228"
            ]
          },
          "401660228": {
            "id": "401660228",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "迪娜泽黛听完觉得这主意很棒，我就找上其他人，大家一拍即合，立刻组织起来了。",
            "nextDialogs": [
              "401660229"
            ]
          },
          "401660229": {
            "id": "401660229",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "既然是惊喜，知道的人自然越少越好。更何况对方是那位智慧之神，稍不注意，恐怕就会被她发现端倪。",
            "nextDialogs": [
              "401660230"
            ]
          },
          "401660230": {
            "id": "401660230",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！有道理。所以我们要一直这么小声地说话吗？",
            "nextDialogs": [
              "401660231"
            ]
          },
          "401660231": {
            "id": "401660231",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "噗…",
            "nextDialogs": [
              "401660232"
            ]
          },
          "401660232": {
            "id": "401660232",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "咳咳！总之，我们只通知了近期恰有空闲的几位朋友来准备这事。",
            "nextDialogs": [
              "401660233"
            ]
          },
          "401660233": {
            "id": "401660233",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "具体要做些什么呀？",
            "nextDialogs": [
              "401660234"
            ]
          },
          "401660234": {
            "id": "401660234",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "听说草神大人喜欢糖果，我们打算从这里入手。",
            "nextDialogs": [
              "401660235"
            ]
          },
          "401660235": {
            "id": "401660235",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "还准备在花车巡游之后请她吃顿生日晚宴呢！所以七鲜桌什么的肯定也少不了。",
            "nextDialogs": [
              "401660236"
            ]
          },
          "401660236": {
            "id": "401660236",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "具体的设计交给卡维了，现阶段我们只需要购置些食材和装饰就行。",
            "nextDialogs": [
              "401660237"
            ]
          },
          "401660237": {
            "id": "401660237",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么我们能帮忙的吗？",
            "nextDialogs": [
              "401660238"
            ]
          },
          "401660238": {
            "id": "401660238",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀对呀，听都听到了，我们也想为这份生日惊喜出一份力呢！",
            "nextDialogs": [
              "401660239"
            ]
          },
          "401660239": {
            "id": "401660239",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "咦？我记得坎蒂丝你刚才说想要个人帮忙一起采购，这不正好吗？",
            "nextDialogs": [
              "401660240"
            ]
          },
          "401660240": {
            "id": "401660240",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "嗯，我担心自己在沙漠待久了，对这边商品的价格和品相会有些生疏。",
            "nextDialogs": [
              "401660241"
            ]
          },
          "401660241": {
            "id": "401660241",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们可以和你一起。",
            "nextDialogs": [
              "401660242"
            ]
          },
          "401660242": {
            "id": "401660242",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "若是不麻烦你们的话…",
            "nextDialogs": [
              "401660243"
            ]
          },
          "401660243": {
            "id": "401660243",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不麻烦不麻烦！不如说恰好能帮上大家的忙，对我们来说才是惊喜呢。",
            "nextDialogs": [
              "401660244"
            ]
          },
          "401660244": {
            "id": "401660244",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "哟，派蒙真是越来越会说话了。",
            "nextDialogs": [
              "401660245"
            ]
          },
          "401660245": {
            "id": "401660245",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "那我就承蒙二位的好意了。",
            "nextDialogs": [
              "401660246"
            ]
          },
          "401660246": {
            "id": "401660246",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "那就这么定了！装饰交给我和迪娜泽黛就行，宴会场地拜托提纳里操办。",
            "nextDialogs": [
              "401660247"
            ]
          },
          "401660247": {
            "id": "401660247",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听得我都激动起来了，快开始吧！一起为纳西妲准备份了不得的生日惊…",
            "nextDialogs": [
              "401660248"
            ]
          },
          "401660248": {
            "id": "401660248",
            "speakerId": 10266,
            "speakerName": "众人",
            "text": "嘘…！",
            "nextDialogs": [
              "401660249"
            ]
          },
          "401660249": {
            "id": "401660249",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…对，兴奋得差点忘了…保密要紧，保密要紧…"
          }
        }
      }
    },
    {
      "subId": "4016603",
      "subQuestName": "与坎蒂丝一同采购商品",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401660301"
        ],
        "dialogs": {
          "401660301": {
            "id": "401660301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，今天的奥摩斯港闻上去香喷喷的，连海风的味道都要被压下去了呢！",
            "nextDialogs": [
              "401660302"
            ]
          },
          "401660302": {
            "id": "401660302",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "听说，这里是花车巡游的终点，很多商家提前布置摊位，自然会比平时更热闹些。",
            "nextDialogs": [
              "401660303"
            ]
          },
          "401660303": {
            "id": "401660303",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "阿如村最近也来了不少商人，大家都在准备过一个难忘的花神诞祭呢。",
            "nextDialogs": [
              "401660304"
            ]
          },
          "401660304": {
            "id": "401660304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，看来不愁买不到东西了！砍价这事就交给我们吧！",
            "nextDialogs": [
              "401660305"
            ]
          },
          "401660305": {
            "id": "401660305",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "好，那就…唔…！呃…",
            "nextDialogs": [
              "401660308"
            ]
          },
          "401660308": {
            "id": "401660308",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "我没事…",
            "nextDialogs": [
              "401660309"
            ]
          },
          "401660309": {
            "id": "401660309",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "……",
            "nextDialogs": [
              "401660310"
            ]
          },
          "401660310": {
            "id": "401660310",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "抱歉，让你们担心了。我们先去那家店订些东西吧。",
            "nextDialogs": [
              "401660311"
            ]
          },
          "401660311": {
            "id": "401660311",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "哟，欢迎光临，客人想吃些什么？",
            "nextDialogs": [
              "401660312"
            ]
          },
          "401660312": {
            "id": "401660312",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "想订一些花神诞祭当日的小吃，大概在花车巡游结束后来取，到时候能帮我提前做好吗？",
            "nextDialogs": [
              "401660313"
            ]
          },
          "401660313": {
            "id": "401660313",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "外带的预定单是吧？没问题，您到时候要吃些什么？",
            "nextDialogs": [
              "401660314"
            ]
          },
          "401660314": {
            "id": "401660314",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "马萨拉芝士球和土豆船各三份，绿汁脆球十人份，咖喱虾也要三份。",
            "nextDialogs": [
              "401660315"
            ]
          },
          "401660315": {
            "id": "401660315",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "稍等我记一下…土豆船…绿汁脆球…嗯，没问题，这些食材都管够，客人还真是大手笔。",
            "nextDialogs": [
              "401660316"
            ]
          },
          "401660316": {
            "id": "401660316",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "买这么多的话，请问能便宜一些吗？",
            "nextDialogs": [
              "401660317"
            ]
          },
          "401660317": {
            "id": "401660317",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "当然可以！我算算啊…一共两万九千摩拉，打个折算您两万六怎么样？",
            "nextDialogs": [
              "401660318"
            ]
          },
          "401660318": {
            "id": "401660318",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "两万摩拉可以吗？",
            "nextDialogs": [
              "401660319"
            ]
          },
          "401660319": {
            "id": "401660319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…？",
            "nextDialogs": [
              "401660320"
            ]
          },
          "401660320": {
            "id": "401660320",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（坎蒂丝…砍价好凶…）",
            "nextDialogs": [
              "401660321"
            ]
          },
          "401660321": {
            "id": "401660321",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "呃…这，这多少有点为难我了。花车巡游当天我这儿的客人也不少，食材也得专门为您留一留…",
            "nextDialogs": [
              "401660322"
            ]
          },
          "401660322": {
            "id": "401660322",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "这样吗…那我再加五份萨巴桑炸角怎么样？能再便宜一些吗？",
            "nextDialogs": [
              "401660323"
            ]
          },
          "401660323": {
            "id": "401660323",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "啊，这样的话…我最多给客人您打到八折…",
            "nextDialogs": [
              "401660324"
            ]
          },
          "401660324": {
            "id": "401660324",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "好吧，那就八折，辛苦您了。",
            "nextDialogs": [
              "401660325"
            ]
          },
          "401660325": {
            "id": "401660325",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "应该的应该的。",
            "nextDialogs": [
              "401660326"
            ]
          },
          "401660326": {
            "id": "401660326",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总感觉坎蒂丝比我们还会砍价呢…",
            "nextDialogs": [
              "401660327"
            ]
          },
          "401660327": {
            "id": "401660327",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "另外…",
            "nextDialogs": [
              "401660328"
            ]
          },
          "401660328": {
            "id": "401660328",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "客人还有什么想要的？",
            "nextDialogs": [
              "401660329"
            ]
          },
          "401660329": {
            "id": "401660329",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "没有了。只是想提醒您检查一下炉火，用得久了，可能会存有安全隐患。",
            "nextDialogs": [
              "401660330"
            ]
          },
          "401660330": {
            "id": "401660330",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "哦，谢谢客人关心。不过这是我今天刚换的一批炭料，绝对不会…",
            "nextDialogs": [
              "401660331"
            ]
          },
          "401660331": {
            "id": "401660331",
            "speakerId": 1007,
            "speakerName": "巨大的声响",
            "text": "（嘭——！）",
            "nextDialogs": [
              "401660332"
            ]
          },
          "401660332": {
            "id": "401660332",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊！咳咳…好大的烟！",
            "nextDialogs": [
              "401660333"
            ]
          },
          "401660333": {
            "id": "401660333",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "唔咳咳…",
            "nextDialogs": [
              "401660334"
            ]
          },
          "401660334": {
            "id": "401660334",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "您没事吧？",
            "nextDialogs": [
              "401660335"
            ]
          },
          "401660335": {
            "id": "401660335",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "没事…没事…谢谢您。咦？真是奇怪…",
            "nextDialogs": [
              "401660336"
            ]
          },
          "401660336": {
            "id": "401660336",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "是不是鼓风装置出了故障？",
            "nextDialogs": [
              "401660337"
            ]
          },
          "401660337": {
            "id": "401660337",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "咳咳…的确有可能，前阵子也出过类似的事，我才换的鼓风…",
            "nextDialogs": [
              "401660338"
            ]
          },
          "401660338": {
            "id": "401660338",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "炉子的问题可以晚些再排查，您人没事才是最重要的。要喝些水吗？我身上有带。",
            "nextDialogs": [
              "401660339"
            ]
          },
          "401660339": {
            "id": "401660339",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "不要紧不要紧，也是客人您眼睛好，要是您今天早些到我店里提醒我，说不定就不会这样了。",
            "nextDialogs": [
              "401660340"
            ]
          },
          "401660340": {
            "id": "401660340",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "总之，我今天就赶紧修修这炉子，不会耽搁您花神诞祭当天的订单。",
            "nextDialogs": [
              "401660341"
            ]
          },
          "401660341": {
            "id": "401660341",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "还是身体和安全要紧，您慢慢来。订金我就放这儿了。",
            "nextDialogs": [
              "401660342"
            ]
          },
          "401660342": {
            "id": "401660342",
            "speakerId": 4159,
            "speakerName": "贾汉吉尔",
            "text": "好，客人您慢走。",
            "nextDialogs": [
              "401660343"
            ]
          },
          "401660343": {
            "id": "401660343",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚才真是危险呢！还好坎蒂丝你反应快。",
            "nextDialogs": [
              "401660344"
            ]
          },
          "401660344": {
            "id": "401660344",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么知道炉火有问题？",
            "nextDialogs": [
              "401660345"
            ]
          },
          "401660345": {
            "id": "401660345",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "唔…或许是冥冥之中的感觉吧？我说不清…",
            "nextDialogs": [
              "401660346"
            ]
          },
          "401660346": {
            "id": "401660346",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…接下来去哪里？希望是个没有炉子的地方，我真被吓得不轻。",
            "nextDialogs": [
              "401660347"
            ]
          },
          "401660347": {
            "id": "401660347",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "去买些水果吧，在制作糖果时会用到。",
            "nextDialogs": [
              "401660348"
            ]
          },
          "401660348": {
            "id": "401660348",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好！我们也好久没逛奥摩斯港了呢，顺带买点其他东西吧！"
          }
        }
      }
    },
    {
      "subId": "4016604",
      "subQuestName": "继续购物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401660401"
        ],
        "dialogs": {
          "401660401": {
            "id": "401660401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我记得水果摊就在那边…",
            "nextDialogs": [
              "401660402"
            ]
          },
          "401660402": {
            "id": "401660402",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "呃…！",
            "nextDialogs": [
              "401660403"
            ]
          },
          "401660403": {
            "id": "401660403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？坎蒂丝你没事吧…？",
            "nextDialogs": [
              "401660404"
            ]
          },
          "401660404": {
            "id": "401660404",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "…！危险！",
            "nextDialogs": [
              "401660405"
            ]
          },
          "401660405": {
            "id": "401660405",
            "speakerId": 14462,
            "speakerName": "哈蒂丝",
            "text": "…欸？",
            "nextDialogs": [
              "401660406"
            ]
          },
          "401660406": {
            "id": "401660406",
            "speakerId": 1009,
            "speakerName": "Black Screen",
            "text": "坎蒂丝飞身一跃，救下了差点被箱子砸到的孩子…",
            "nextDialogs": [
              "401660407"
            ]
          },
          "401660407": {
            "id": "401660407",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "没受伤吧孩子？",
            "nextDialogs": [
              "401660408"
            ]
          },
          "401660408": {
            "id": "401660408",
            "speakerId": 14462,
            "speakerName": "哈蒂丝",
            "text": "没…没事…谢谢大姐姐…",
            "nextDialogs": [
              "401660409"
            ]
          },
          "401660409": {
            "id": "401660409",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "发生什么了？",
            "nextDialogs": [
              "401660410"
            ]
          },
          "401660410": {
            "id": "401660410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那边的箱子突然倒了下来，还好坎蒂丝护住了这孩子。",
            "nextDialogs": [
              "401660411"
            ]
          },
          "401660411": {
            "id": "401660411",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "你父母呢？",
            "nextDialogs": [
              "401660412"
            ]
          },
          "401660412": {
            "id": "401660412",
            "speakerId": 14462,
            "speakerName": "哈蒂丝",
            "text": "我…他们在港口的酒馆，我一个人无聊，才…",
            "nextDialogs": [
              "401660413"
            ]
          },
          "401660413": {
            "id": "401660413",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "已经没事了，亲爱的孩子，下次玩耍时注意安全就好。",
            "nextDialogs": [
              "401660414"
            ]
          },
          "401660414": {
            "id": "401660414",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "…快回去吧。",
            "nextDialogs": [
              "401660415"
            ]
          },
          "401660415": {
            "id": "401660415",
            "speakerId": 14462,
            "speakerName": "哈蒂丝",
            "text": "好的…",
            "nextDialogs": [
              "401660416"
            ]
          },
          "401660416": {
            "id": "401660416",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "这是谁家的箱子？",
            "nextDialogs": [
              "401660417"
            ]
          },
          "401660417": {
            "id": "401660417",
            "speakerId": 14463,
            "speakerName": "库特比",
            "text": "是…是我的…",
            "nextDialogs": [
              "401660418"
            ]
          },
          "401660418": {
            "id": "401660418",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "都说了不要在道路周围堆放重物！怎么还在犯这种错误？",
            "nextDialogs": [
              "401660419"
            ]
          },
          "401660419": {
            "id": "401660419",
            "speakerId": 14463,
            "speakerName": "库特比",
            "text": "抱歉！最近…最近货物稍微多了些，仓库不够放…",
            "nextDialogs": [
              "401660420"
            ]
          },
          "401660420": {
            "id": "401660420",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "嗯？！",
            "nextDialogs": [
              "401660421"
            ]
          },
          "401660421": {
            "id": "401660421",
            "speakerId": 14463,
            "speakerName": "库特比",
            "text": "我这就处理！下次再也不放了！",
            "nextDialogs": [
              "401660422"
            ]
          },
          "401660422": {
            "id": "401660422",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "哎…",
            "nextDialogs": [
              "401660423"
            ]
          },
          "401660423": {
            "id": "401660423",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "谢谢你们，都怪我监督不周。要不是坎蒂丝小姐，还真不知道事情会变成什么样。",
            "nextDialogs": [
              "401660424"
            ]
          },
          "401660424": {
            "id": "401660424",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "举手之劳罢了，夏姆先生也不必过于自责，我很能理解守护一片区域的不易。只是节日在即，各处还需要您多多留神。",
            "nextDialogs": [
              "401660425"
            ]
          },
          "401660425": {
            "id": "401660425",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "唉，这花神诞祭期间，还真是有几只眼睛都看不过来。哦，请别误会，坎蒂丝小姐的提醒我已经记下了，一定注意。",
            "nextDialogs": [
              "401660426"
            ]
          },
          "401660426": {
            "id": "401660426",
            "speakerId": 4169,
            "speakerName": "夏姆",
            "text": "几位是来采购的吗？那我也不再叨扰了。祝你们节日愉快。",
            "nextDialogs": [
              "401660427"
            ]
          },
          "401660427": {
            "id": "401660427",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "坎蒂丝你动作也太快了吧！总感觉那箱子还没掉下来的时候你就冲过去了呢！",
            "nextDialogs": [
              "401660428"
            ]
          },
          "401660428": {
            "id": "401660428",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "简直像知道箱子会掉一样…",
            "nextDialogs": [
              "401660429"
            ]
          },
          "401660429": {
            "id": "401660429",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "……",
            "nextDialogs": [
              "401660430"
            ]
          },
          "401660430": {
            "id": "401660430",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "其实…我当时的确看到了那箱子掉下的「未来」。",
            "nextDialogs": [
              "401660431"
            ]
          },
          "401660431": {
            "id": "401660431",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你的意思是，你预知了未来？！",
            "nextDialogs": [
              "401660432"
            ]
          },
          "401660432": {
            "id": "401660432",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "嗯…包括刚才炉火的意外也是，我看到了将要发生的事…",
            "nextDialogs": [
              "401660435"
            ]
          },
          "401660435": {
            "id": "401660435",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "我不觉得我的琥珀色左眼有何特殊之处，以前，它从未让我看到过什么奇怪的异象…",
            "nextDialogs": [
              "401660436"
            ]
          },
          "401660436": {
            "id": "401660436",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "但从今早开始，我时常看见某些画面，它们与现实不符，却在几秒后真真切切地发生了…",
            "nextDialogs": [
              "401660437"
            ]
          },
          "401660437": {
            "id": "401660437",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你有告诉其他人吗？",
            "nextDialogs": [
              "401660438"
            ]
          },
          "401660438": {
            "id": "401660438",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "还没有…我尚且无法确定这是否真是「预示」，也不想让大家担心。"
          }
        }
      }
    },
    {
      "subId": "4016605",
      "subQuestName": "寻找多莉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401660501"
        ],
        "dialogs": {
          "401660501": {
            "id": "401660501",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "…来，你要的货，放心吧，都是好东西，嘿嘿嘿，要不要再顺手带一份桑歌玛哈巴依老爷我新进的好货呀？",
            "nextDialogs": [
              "401660502"
            ]
          },
          "401660502": {
            "id": "401660502",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "啊？不要吗？慢走不送。",
            "nextDialogs": [
              "401660503"
            ]
          },
          "401660503": {
            "id": "401660503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "多莉！",
            "nextDialogs": [
              "401660504"
            ]
          },
          "401660504": {
            "id": "401660504",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "哎呀呀！瞧瞧谁来啦！是我的两位大客户！还有…噢？你是阿如村的守护者坎蒂丝小姐…唔唔唔，有趣！",
            "nextDialogs": [
              "401660505"
            ]
          },
          "401660505": {
            "id": "401660505",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "有何贵干呀？我可没在沙漠进行任何不合时宜的买卖呢。",
            "nextDialogs": [
              "401660506"
            ]
          },
          "401660506": {
            "id": "401660506",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "您误会了，亲爱的多莉大商人。我们此行是想来向您打听一个消息。",
            "nextDialogs": [
              "401660507"
            ]
          },
          "401660507": {
            "id": "401660507",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "哦！是要买情报啊！欢迎欢迎！我最喜欢做情报生意了，带在身上不累，卖给别人翻倍！啊不…是…免税，免税。",
            "nextDialogs": [
              "401660508"
            ]
          },
          "401660508": {
            "id": "401660508",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "我今早购入了一块有些奇特的宝石，商人的名字我写在纸上了。",
            "nextDialogs": [
              "401660509"
            ]
          },
          "401660509": {
            "id": "401660509",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "我想向那位商人打听一下，制作这块宝石的工匠，是从哪里得到的原石。",
            "nextDialogs": [
              "401660510"
            ]
          },
          "401660510": {
            "id": "401660510",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "是找人的工作呀？这可有些麻烦呢，总觉得要花掉不少摩拉。",
            "nextDialogs": [
              "401660511"
            ]
          },
          "401660511": {
            "id": "401660511",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "当然，也可以省去找人的环节，如果万能的多莉大商人能够直接打听到来源的话，我也愿意支付这笔情报费。",
            "nextDialogs": [
              "401660512"
            ]
          },
          "401660512": {
            "id": "401660512",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "（找人倒是一点不麻烦，就是赚得少些…刚巧我有几个熟人平时也加工宝石，随口问他们一句应该就能搞定。）",
            "nextDialogs": [
              "401660513"
            ]
          },
          "401660513": {
            "id": "401660513",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "嗨呀，瞧您说的，可不就是为难桑歌玛哈巴依老爷我吗？这类消息源都是商业机密，打听起来费劲得很呢！",
            "nextDialogs": [
              "401660514"
            ]
          },
          "401660514": {
            "id": "401660514",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "请您开个价。",
            "nextDialogs": [
              "401660515"
            ]
          },
          "401660515": {
            "id": "401660515",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "哟！痛快！那等我算算啊，跑路的车马费，加上给别人送礼的费用…",
            "nextDialogs": [
              "401660516"
            ]
          },
          "401660516": {
            "id": "401660516",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "二十万摩拉，怎么样？",
            "nextDialogs": [
              "401660517"
            ]
          },
          "401660517": {
            "id": "401660517",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…好贵！",
            "nextDialogs": [
              "401660518"
            ]
          },
          "401660518": {
            "id": "401660518",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "实在不好意思，这价格稍微有些超出我们的预算了，能便宜一些吗？",
            "nextDialogs": [
              "401660519"
            ]
          },
          "401660519": {
            "id": "401660519",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "…好吧！阿如村是个有人情味的地方，这个面子我可以卖。你开个价。",
            "nextDialogs": [
              "401660520"
            ]
          },
          "401660520": {
            "id": "401660520",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "五万摩拉吧。",
            "nextDialogs": [
              "401660521"
            ]
          },
          "401660521": {
            "id": "401660521",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "什么？！",
            "nextDialogs": [
              "401660522"
            ]
          },
          "401660522": {
            "id": "401660522",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这…比刚才砍的还狠…）",
            "nextDialogs": [
              "401660523"
            ]
          },
          "401660523": {
            "id": "401660523",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "怎么了？这类型的情报在沙漠一般就卖这个价。",
            "nextDialogs": [
              "401660524"
            ]
          },
          "401660524": {
            "id": "401660524",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "不卖不卖！这简直…简直亏得我身上的眼镜片都剩不下来啦！绝对不卖！",
            "nextDialogs": [
              "401660525"
            ]
          },
          "401660525": {
            "id": "401660525",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "这样吗…真是可惜。那三万摩拉怎么样？",
            "nextDialogs": [
              "401660526"
            ]
          },
          "401660526": {
            "id": "401660526",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "怎么还往下砍的呀！",
            "nextDialogs": [
              "401660527"
            ]
          },
          "401660527": {
            "id": "401660527",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "三万摩拉，外加您的商队到阿如村拜访时的食宿安全保障，还有一些杂税的减免，如何？",
            "nextDialogs": [
              "401660528"
            ]
          },
          "401660528": {
            "id": "401660528",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "什…！",
            "nextDialogs": [
              "401660529"
            ]
          },
          "401660529": {
            "id": "401660529",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "（等等…阿如村最近的确充满商机，如果借此得到守护者的庇护还能行些方便的话…倒是一笔不错的交易…）",
            "nextDialogs": [
              "401660530"
            ]
          },
          "401660530": {
            "id": "401660530",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "（嘁…坎蒂丝这家伙，该不会是想顺带为村里招揽些贸易吧…真是可怕的女人…）",
            "nextDialogs": [
              "401660531"
            ]
          },
          "401660531": {
            "id": "401660531",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "呃…嘿嘿…好吧！桑歌玛哈巴依老爷考虑了一下，这次的生意就不计成本了！三…啧…三万就三万！",
            "nextDialogs": [
              "401660532"
            ]
          },
          "401660532": {
            "id": "401660532",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "真的吗？不愧是须弥第一的大商人，您的眼界和气度非比常人。",
            "nextDialogs": [
              "401660533"
            ]
          },
          "401660533": {
            "id": "401660533",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "那…那是当然，谁叫客户是阿如村的守护者嘛，重在结交朋友，这买卖就是亏本我也得做！",
            "nextDialogs": [
              "401660534"
            ]
          },
          "401660534": {
            "id": "401660534",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "那不如…",
            "nextDialogs": [
              "401660535"
            ]
          },
          "401660535": {
            "id": "401660535",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "啊停停停！三万！说好三万了！",
            "nextDialogs": [
              "401660536"
            ]
          },
          "401660536": {
            "id": "401660536",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "（哎…到时候随便请那宝石商人吃点五百摩拉的路边摊吧…）",
            "nextDialogs": [
              "401660537"
            ]
          },
          "401660537": {
            "id": "401660537",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "收集情报也要些时间，你们…明天再来找我吧！跑这么一趟可不是什么轻松活。",
            "nextDialogs": [
              "401660538"
            ]
          },
          "401660538": {
            "id": "401660538",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "谢谢多莉大商人，真是帮大忙了。",
            "nextDialogs": [
              "401660539"
            ]
          },
          "401660539": {
            "id": "401660539",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "#{NICKNAME}，你们刚回须弥，接下来不妨就在奥摩斯港多逛逛吧，购置的物资交给我来安置就好。",
            "nextDialogs": [
              "401660540"
            ]
          },
          "401660540": {
            "id": "401660540",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？总觉得有些不好意思呢，我们也没帮上太多忙。",
            "nextDialogs": [
              "401660541"
            ]
          },
          "401660541": {
            "id": "401660541",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "请别这么说，倒是我还要麻烦你们随我一起调查，这才过意不去呢。",
            "nextDialogs": [
              "401660542"
            ]
          },
          "401660542": {
            "id": "401660542",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "小事小事。",
            "nextDialogs": [
              "401660543"
            ]
          },
          "401660543": {
            "id": "401660543",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "#哈哈，你还是一如既往的崇高。愿神明保佑你，亲爱的{NICKNAME}。",
            "nextDialogs": [
              "401660544"
            ]
          },
          "401660544": {
            "id": "401660544",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "多莉大商人也是，愿您此行顺利。我们明日再见。",
            "nextDialogs": [
              "401660545"
            ]
          },
          "401660545": {
            "id": "401660545",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "哎…再见再见，慢走不送了啊…"
          }
        }
      }
    }
  ]
}
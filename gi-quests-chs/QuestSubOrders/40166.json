{
  "lineCounts": {
    "Black Screen": 3,
    "Player": 20,
    "众人": 1,
    "哈蒂丝": 4,
    "坎蒂丝": 65,
    "夏姆": 10,
    "多莉": 23,
    "巨大的声响": 1,

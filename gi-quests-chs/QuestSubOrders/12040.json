    },
    {
      "subId": "1204006",
      "subQuestName": "追踪遗留的痕迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120400601"
        ],
        "dialogs": {
          "120400601": {
            "id": "120400601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，那位老先生呢？",
            "nextDialogs": [
              "120400602"
            ]
          },
          "120400602": {
            "id": "120400602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "他不会自己也去找茶具了吧。",
            "nextDialogs": [
              "120400603"
            ]
          },
          "120400603": {
            "id": "120400603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说不定…",
            "nextDialogs": [
              "120400604"
            ]
          },
          "120400604": {
            "id": "120400604",
            "speakerId": 1003,
            "speakerName": "影",
            "text": "说不定就像我们之前看到的记忆一样，地脉的力量并不能让他存在很长时间。",
            "nextDialogs": [
              "120400605"
            ]
          },
          "120400605": {
            "id": "120400605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那、那我们喝不到他泡的茶了吗？",
            "nextDialogs": [
              "120400606"
            ]
          },
          "120400606": {
            "id": "120400606",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且，甚至都没机会跟他说一句再见…呜…",
            "nextDialogs": [
              "120400607"
            ]
          },
          "120400607": {
            "id": "120400607",
            "speakerId": 1003,
            "speakerName": "影",
            "text": "地脉中的信息太过复杂无序。能像那样再次与他相遇，已经是极其难得的缘分了…",
            "nextDialogs": [
              "120400608"
            ]
          },
          "120400608": {
            "id": "120400608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…",
            "nextDialogs": [
              "120400611"
            ]
          },
          "120400611": {
            "id": "120400611",
            "speakerId": 1003,
            "speakerName": "影",
            "text": "机会难得，手边也有茶具。不如就由我来试着泡一壶茶吧。",
            "nextDialogs": [
              "120400612"
            ]
          },
          "120400612": {
            "id": "120400612",
            "speakerId": 1003,
            "speakerName": "影",
            "text": "我看过古山泡茶，很多次…亲手试试，应该不会有什么问题。",
            "nextDialogs": [
              "120400613"
            ]
          },
          "120400613": {
            "id": "120400613",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "影用茶具泡好了一壶热茶…",
            "nextDialogs": [
              "120400614"
            ]
          },
          "120400614": {
            "id": "120400614",
            "speakerId": 1003,
            "speakerName": "影",
            "text": "茶泡好了，尝尝看吧。",
            "nextDialogs": [
              "120400615"
            ]
          },
          "120400615": {
            "id": "120400615",
            "speakerId": 1003,
            "speakerName": "影",
            "text": "泡茶时我的思绪一直很复杂，不知该怎么表达…"
          }
        }
      }
    },
    {
      "subId": "1204007",
      "subQuestName": "追踪遗留的痕迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120400701"
        ],
        "dialogs": {
          "120400701": {
            "id": "120400701",
            "speakerId": 1006,
            "speakerName": "古山",
            "text": "眼疾之后，生活确有诸多不便，但我始终都想做好一位称职的茶人。",
            "nextDialogs": [
              "120400702"
            ]
          },
          "120400702": {
            "id": "120400702",
            "speakerId": 1006,
            "speakerName": "古山",
            "text": "唉，只能拜托给你们了。"
          }
        }
      }
    },

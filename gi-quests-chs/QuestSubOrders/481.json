    {
      "subId": "48106",
      "subQuestName": "(test)派蒙的疑问",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4810601"
        ],
        "dialogs": {
          "4810601": {
            "id": "4810601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是个很好的故事呢…但是骑士团的飞行指南…是这种风格的么？",
            "nextDialogs": [
              "4810604"
            ]
          },
          "4810604": {
            "id": "4810604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不管了，我们还是快去找安柏吧。"

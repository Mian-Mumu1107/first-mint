  "subQuests": [
    {
      "subId": "48101",
      "subQuestName": "与安柏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4810101"
        ],
        "dialogs": {
          "4810101": {
            "id": "4810101",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "#{NICKNAME}！找你好久了，上次给你的风之翼，用起来怎么样？",
            "nextDialogs": [
              "4810104"
            ]
          },
          "4810104": {
            "id": "4810104",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "看来你用风之翼玩得很开心的样子。",
            "nextDialogs": [
              "4810105"
            ]
          },
          "4810105": {
            "id": "4810105",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "不过话说回来，你现在肯定还没有飞行执照吧。",
            "nextDialogs": [
              "4810106"
            ]
          },
          "4810106": {
            "id": "4810106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "飞行执照？那是什么东西？",
            "nextDialogs": [
              "4810107"
            ]
          },
          "4810107": {
            "id": "4810107",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "从名字看也已经很明显了吧？只有拿到飞行执照，才能在蒙德城合法飞行。",
            "nextDialogs": [
              "4810108"
            ]
          },
          "4810108": {
            "id": "4810108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔…{NICKNAME}都飞了这么久了，之前都没有听说这种东西…",
            "nextDialogs": [
              "4810109"
            ]
          },
          "4810109": {
            "id": "4810109",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "就是因为你们成天在城里飞来飞去，弄得大家都注意到了！",
            "nextDialogs": [
              "4810110"
            ]
          },
          "4810110": {
            "id": "4810110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸嘿。",
            "nextDialogs": [
              "4810111"
            ]
          },
          "4810111": {
            "id": "4810111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以，你今天是特意来把飞行执照送来的吗？",
            "nextDialogs": [
              "4810112"
            ]
          },
          "4810112": {
            "id": "4810112",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "怎么可能！骑士是很有原则的。",
            "nextDialogs": [
              "4810113"
            ]
          },
          "4810113": {
            "id": "4810113",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "飞行执照先要考试合格，然后再由骑士团统一签发。",
            "nextDialogs": [
              "4810114"
            ]
          },
          "4810114": {
            "id": "4810114",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "#我今天是专门来做你的考官，监督{NICKNAME}进行飞行执照考试的！",
            "nextDialogs": [
              "4810115"
            ]
          },
          "4810115": {
            "id": "4810115",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "毕竟是我把风之翼给你的嘛，要负起责任来——琴团长一定会这么说吧。",
            "nextDialogs": [
              "4810116"
            ]
          },
          "4810116": {
            "id": "4810116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "考试…听起来就很麻烦。但既然是安柏监考，那么…"
          }
        }
      }
    },

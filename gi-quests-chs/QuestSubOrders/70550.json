    {
      "subId": "7055006",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705500201"
        ],
        "dialogs": {
          "705500201": {
            "id": "705500201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「好天气」来啦，可莉尝尝看！",
            "nextDialogs": [
              "705500202"
            ]
          },
          "705500202": {
            "id": "705500202",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "哇啊，原来「好天气」是这种颜色？紫色的天空…是亮亮的夜晚？",
            "nextDialogs": [
              "705500205"
            ]
          },
          "705500205": {
            "id": "705500205",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "可莉先喝一点，再认真地想想。",
            "nextDialogs": [
              "705500206"
            ]
          },
          "705500206": {
            "id": "705500206",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "啊，喝完了…",
            "nextDialogs": [
              "705500207"
            ]
          },
          "705500207": {
            "id": "705500207",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "好喝！酸酸甜甜！",
            "nextDialogs": [
              "705500208"
            ]
          },
          "705500208": {
            "id": "705500208",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "如果在吃烤鱼的时候喝这杯，可莉肯定能呼呼吃掉好几条，饭量加倍！",
            "nextDialogs": [
              "705500209"
            ]
          },
          "705500209": {
            "id": "705500209",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "一小杯不够喝，可莉还想要再来一杯…蛋糕一样的饮料！"
          }
        }
      }
    },

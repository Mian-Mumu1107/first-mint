  "subQuests": [
    {
      "subId": "7055001",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705500101"
        ],
        "dialogs": {
          "705500101": {
            "id": "705500101",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "#咦？咦咦？是荣誉骑士{M#哥哥}{F#姐姐}？好耶！",
            "nextDialogs": [
              "705500104"
            ]
          },
          "705500104": {
            "id": "705500104",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "哈哈，优菈姐姐告诉我，赫塔阿姨找来了厉害的帮手…",
            "nextDialogs": [
              "705500105"
            ]
          },
          "705500105": {
            "id": "705500105",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "#看到了荣誉骑士{M#哥哥}{F#姐姐}，我就知道，这里一定是全提瓦特最厉害的饮料店！"
          }
        }
      }
    },
    {
      "subId": "7055002",

    {
      "subId": "7055003",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705500301"
        ],
        "dialogs": {
          "705500301": {
            "id": "705500301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "噔噔！完成了——这杯新品，可莉肯定喜欢！",
            "nextDialogs": [
              "705500302"
            ]
          },
          "705500302": {
            "id": "705500302",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "哇啊！嘟嘟可的糖果也在饮料上！",
            "nextDialogs": [
              "705500303"
            ]
          },
          "705500303": {
            "id": "705500303",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "杯子里有好多好多橙红色，嘟嘟可好像趴在白色的云朵上…这是更厉害的好天气！",
            "nextDialogs": [
              "705500304"
            ]
          },
          "705500304": {
            "id": "705500304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可莉尝尝看？",
            "nextDialogs": [
              "705500305"
            ]
          },
          "705500305": {
            "id": "705500305",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "嗯嗯…好喝！",
            "nextDialogs": [
              "705500306"
            ]
          },
          "705500306": {
            "id": "705500306",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "可莉要慢慢喝，不能咕噜咕噜就错过了好味道…",
            "nextDialogs": [
              "705500307"
            ]
          },
          "705500307": {
            "id": "705500307",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "#真神奇…荣誉骑士{M#哥哥}{F#姐姐}，好像把阳光装进了果汁里？",
            "nextDialogs": [
              "705500308"
            ]
          },
          "705500308": {
            "id": "705500308",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "玩累了的感觉都消失了，好温暖，但是又很平静？",
            "nextDialogs": [
              "705500309"
            ]
          },
          "705500309": {
            "id": "705500309",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "#…呼啊~荣誉骑士{M#哥哥}{F#姐姐}最厉害了！",
            "nextDialogs": [
              "705500312"
            ]
          },
          "705500312": {
            "id": "705500312",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "真的吗？那我想想…",
            "nextDialogs": [
              "705500313"
            ]
          },
          "705500313": {
            "id": "705500313",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "天气好，心情好，嘟嘟可应该会唱歌？",
            "nextDialogs": [
              "705500314"
            ]
          },
          "705500314": {
            "id": "705500314",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "嘟嘟可唱歌，可莉也会跟着唱…所以就叫它…嘟嘟可晴天合唱！"
          }
        }
      }
    },

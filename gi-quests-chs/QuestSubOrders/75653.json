        "dialogs": {
          "756530201": {
            "id": "756530201",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "#是{NICKNAME}！好久不见，昨天我还和锅巴提到你呢，今天就在路上遇到了。",
            "nextDialogs": [
              "756530202"
            ]
          },
          "756530202": {
            "id": "756530202",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "哎呀，这就是冥冥之中的缘分吧。",
            "nextDialogs": [
              "756530203"
            ]
          },
          "756530203": {
            "id": "756530203",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "哦对了，你这是要去哪儿呀？",
            "nextDialogs": [
              "756530206"
            ]
          },
          "756530206": {
            "id": "756530206",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "留影吗？好巧好巧，我最近也在研究留影。",
            "nextDialogs": [
              "756530207"
            ]
          },
          "756530207": {
            "id": "756530207",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "万民堂门口的海报用了这么久，也该换张新的了。",
            "nextDialogs": [
              "756530208"
            ]
          },
          "756530208": {
            "id": "756530208",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "如果能给菜品拍出漂亮的画片，路过的食客们说不定也会多看上两眼。",
            "nextDialogs": [
              "756530209"
            ]
          },
          "756530209": {
            "id": "756530209",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "老话说：十分佳肴，菜色三分，香气三分，味道三分，还剩一分就靠广告。",
            "nextDialogs": [
              "756530210"
            ]
          },
          "756530210": {
            "id": "756530210",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "当然，最后半句是我自己加上的啦。",
            "nextDialogs": [
              "756530211"
            ]
          },
          "756530211": {
            "id": "756530211",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "前面那些我父亲常挂在嘴边，对所有厨师来说都是金玉良言。"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "101401",
      "subQuestName": "与萍姥姥对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10140101"
        ],
        "dialogs": {
          "10140101": {
            "id": "10140101",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "世事无常，世事无常…",
            "nextDialogs": [
              "10140103",
              "10140106"
            ]
          },
          "10140103": {
            "id": "10140103",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "咦？年轻人，你是来赏花的吗？",
            "nextDialogs": [
              "10140104"
            ]
          },
          "10140104": {
            "id": "10140104",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "可惜啊，你来得不是时候，这「琉璃百合」，都要谢完了…",
            "nextDialogs": [
              "10140107"
            ]
          },
          "10140107": {
            "id": "10140107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这些花…为什么都谢了呀？",
            "nextDialogs": [
              "10140108"
            ]
          },
          "10140108": {
            "id": "10140108",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "在我那个年头，人们说「琉璃百合」通人性。",
            "nextDialogs": [
              "10140109"
            ]
          },
          "10140109": {
            "id": "10140109",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "如果它们听见了好声音，比如笑声啦，歌声啦…它们就会很高兴，会长得很好。",
            "nextDialogs": [
              "10140110"
            ]
          },
          "10140110": {
            "id": "10140110",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "但如果反过来，听了太多不好的声音…比如乱七八糟的流言蜚语，它们就会枯萎得很快。",
            "nextDialogs": [
              "10140111"
            ]
          },
          "10140111": {
            "id": "10140111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…所以，现在璃月港里的状况，这些花也感觉到了呀。",
            "nextDialogs": [
              "10140112"
            ]
          },
          "10140112": {
            "id": "10140112",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "是啊，岩王帝君之死的传言，可不是小事。这大街小巷里，说什么的都有。",
            "nextDialogs": [
              "10140113"
            ]
          },
          "10140113": {
            "id": "10140113",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "有人说是愚人众的阴谋，有人说是「海里的东西」要镇不住了，还有人说，这些都是七星自导自演的…",
            "nextDialogs": [
              "10140114"
            ]
          },
          "10140114": {
            "id": "10140114",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "这座港口，就和柴火堆一样。只要一点火星，火就要止不住了。",
            "nextDialogs": [
              "10140115"
            ]
          },
          "10140115": {
            "id": "10140115",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "唉，话头就到这打住吧，我老婆子年纪大了，就喜欢唠叨…年轻人，你们找我有什么事吗？"
          },
          "10140106": {
            "id": "10140106",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "没事，没事，我只不过看见「琉璃百合」谢了太多，觉得太可惜了。"
          }
        }
      }
    },
    {

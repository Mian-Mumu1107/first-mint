    {
      "subId": "101403",
      "subQuestName": "与萍姥姥对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10140301"
        ],
        "dialogs": {
          "10140301": {
            "id": "10140301",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "年轻人手脚就是利索，这么一会，就拿到了…",
            "nextDialogs": [
              "10140303",
              "10140306",
              "10140309"
            ]
          },
          "10140303": {
            "id": "10140303",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "仙人…这两个字，我老婆子可很久没有听人正经提起了。",
            "nextDialogs": [
              "10140304"
            ]
          },
          "10140304": {
            "id": "10140304",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "至于我是不是仙人，孩子，你心里难道不明白吗？",
            "nextDialogs": [
              "10140312"
            ]
          },
          "10140312": {
            "id": "10140312",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…好像懂了，又好像没全懂。不过婆婆，您…就这么把铃铛给我们了？",
            "nextDialogs": [
              "10140313"
            ]
          },
          "10140313": {
            "id": "10140313",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "您不奇怪吗？岩王帝君刚出事，我们就急匆匆地找您来要铃铛…",
            "nextDialogs": [
              "10140314"
            ]
          },
          "10140314": {
            "id": "10140314",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "傻孩子，璃月港古往今来，不知道有多少仙人离开，也不知道折腾出了多少风浪。",
            "nextDialogs": [
              "10140315"
            ]
          },
          "10140315": {
            "id": "10140315",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "但无论是哪一次，都是按规矩先把「送仙典仪」办体面了，再去安排后面的事。",
            "nextDialogs": [
              "10140316"
            ]
          },
          "10140316": {
            "id": "10140316",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "一个劲地喊着「抓凶手」，却耽误了「送仙典仪」，在我看来，才是本末倒置。",
            "nextDialogs": [
              "10140317"
            ]
          },
          "10140317": {
            "id": "10140317",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "现在你们来借铃铛，我揣摩着，大概是哪位老朋友终于看不过眼，出来主持大局了吧。",
            "nextDialogs": [
              "10140318"
            ]
          },
          "10140318": {
            "id": "10140318",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "所以，我又怎么会不肯借铃铛给你们呢？"
          },
          "10140306": {
            "id": "10140306",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "「璃月七星」…那些孩子，很久之前就不愿意让我这老婆子…还有我的老伙计们…去帮工喽。",
            "nextDialogs": [
              "10140307"
            ]
          },
          "10140307": {
            "id": "10140307",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "不过，这些年他们做得也不错。我们这些老家伙，也乐得个清闲。"
          },
          "10140309": {
            "id": "10140309",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "愚人众？哈哈哈，你这孩子，心思倒是多得很，成天都在想些什么歪门故事？",
            "nextDialogs": [
              "10140310"
            ]
          },
          "10140310": {
            "id": "10140310",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "我老婆子一把年纪了，可懒得和这些外人折腾。",
            "nextDialogs": [
              "10140311"
            ]
          },
          "10140311": {
            "id": "10140311",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "不过，他们的手要是再伸长一点，该劳碌的，还是要劳碌的…"
          }
        }
      }
    },
    {
      "subId": "101404",
      "subQuestName": "放置香膏和涤尘铃",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10140401"
        ],
        "dialogs": {
          "10140401": {
            "id": "10140401",
            "speakerId": 1003,
            "speakerName": "钟离",
            "text": "不错，这正是「涤尘铃」…嗯，保管得还真不错。",
            "nextDialogs": [
              "10140402"
            ]
          },
          "10140402": {
            "id": "10140402",
            "speakerId": 1003,
            "speakerName": "钟离",
            "text": "我们顺便把之前做好的香膏也安放了吧。",
            "nextDialogs": [
              "10140404",
              "10140406"
            ]
          },
          "10140404": {
            "id": "10140404",
            "speakerId": 1003,
            "speakerName": "钟离",
            "text": "自然是认识的，不然我怎么会知道，这枚铃铛在她那？",
            "nextDialogs": [
              "10140407"
            ]
          },
          "10140407": {
            "id": "10140407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯…疑点重重！但你不想说的话，我们也就先不追问了吧。",
            "nextDialogs": [
              "10140408"
            ]
          },
          "10140408": {
            "id": "10140408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对了，那位婆婆让我们带句话给你。",
            "nextDialogs": [
              "10140409"
            ]
          },
          "10140409": {
            "id": "10140409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「有空的话，过来喝喝茶也是可以的。老婆子我没什么家当，但总归还是有盏茶壶的。」",
            "nextDialogs": [
              "10140410"
            ]
          },
          "10140410": {
            "id": "10140410",
            "speakerId": 1003,
            "speakerName": "钟离",
            "text": "哈哈哈，这语气可不太适合你。不过，她的茶壶确实很不错，用来泡茶再好不过了。",
            "nextDialogs": [
              "10140411"
            ]
          },
          "10140411": {
            "id": "10140411",
            "speakerId": 1003,
            "speakerName": "钟离",
            "text": "等到了合适的时候，我自然会带着好茶…去见她的。",
            "nextDialogs": [
              "10140412"
            ]
          },
          "10140412": {
            "id": "10140412",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那么，仪式下一项准备，该是什么了？",
            "nextDialogs": [
              "10140413"
            ]
          },
          "10140413": {
            "id": "10140413",
            "speakerId": 1003,
            "speakerName": "钟离",
            "text": "嗯，下一项…我们去买<color=#00E1FFFF>风筝</color>。",
            "nextDialogs": [
              "10140414"
            ]
          },
          "10140414": {
            "id": "10140414",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "风筝！钟离要带我们去玩风筝了吗？这算是…中场休息？",
            "nextDialogs": [
              "10140415"
            ]
          },
          "10140415": {
            "id": "10140415",
            "speakerId": 1003,
            "speakerName": "钟离",
            "text": "哈哈，不是那样。风筝虽说是孩子的玩具，但在璃月的种种仪式上，还有其它象征意义。",
            "nextDialogs": [
              "10140416"
            ]
          },
          "10140416": {
            "id": "10140416",
            "speakerId": 1003,
            "speakerName": "钟离",
            "text": "我会为你们解释的。但我们接下来的行动，还是先去把风筝买到手再说。",
            "nextDialogs": [
              "10140417"
            ]
          },
          "10140417": {
            "id": "10140417",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…好吧，一头雾水…"
          },
          "10140406": {
            "id": "10140406",
            "speakerId": 1003,
            "speakerName": "钟离",
            "text": "仙人…"
          }
        }
      }
    },

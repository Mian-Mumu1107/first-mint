    {
      "subId": "101402",
      "subQuestName": "寻找涤尘铃",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10140201"
        ],
        "dialogs": {
          "10140201": {
            "id": "10140201",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "孩子们，你们不是急着要铃铛吗？还不快去找？",
            "nextDialogs": [
              "10140202"
            ]
          },
          "10140202": {
            "id": "10140202",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "不过这壶我很久没打扫，你们可要当心了。",
            "nextDialogs": [
              "10140203"
            ]
          },
          "10140203": {
            "id": "10140203",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "穿着这么漂亮的衣服，弄脏的话，洗干净可要花功夫喽。"
          }
        }
      }
    },
    {
      "subId": "101405",

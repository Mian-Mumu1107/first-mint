        ],
        "dialogs": {
          "10141001": {
            "id": "10141001",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "那群老伙计们，终归还是按捺不住了。",
            "nextDialogs": [
              "10141002"
            ]
          },
          "10141002": {
            "id": "10141002",
            "speakerId": 1000,
            "speakerName": "萍姥姥",
            "text": "唉，只希望别再闹出什么乱子来…"
          }
        }
      }
    }

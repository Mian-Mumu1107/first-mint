    "霖铃": 46
  },
  "subQuests": [
    {
      "subId": "2211401",
      "subQuestName": "与霖铃对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221140101"
        ],
        "dialogs": {
          "221140101": {
            "id": "221140101",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "完了，这下全都完了…",
            "nextDialogs": [
              "221140102"
            ]
          },
          "221140102": {
            "id": "221140102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "221140103"
            ]
          },
          "221140103": {
            "id": "221140103",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "呜…小安说，我可能不太适合这份工作…",
            "nextDialogs": [
              "221140104"
            ]
          },
          "221140104": {
            "id": "221140104",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "这不就是要辞退我了吗？可怎么办啊，呜…我明明每天都在认真工作…",
            "nextDialogs": [
              "221140106",
              "221140112"
            ]
          },
          "221140106": {
            "id": "221140106",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "那个…我之前不是拜托过你…帮我去数船吗？",
            "nextDialogs": [
              "221140107"
            ]
          },
          "221140107": {
            "id": "221140107",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "因为我相信你的能力嘛，就没有多复核，直接把数据报上去了。",
            "nextDialogs": [
              "221140108"
            ]
          },
          "221140108": {
            "id": "221140108",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "结果，好多数据都错了…小安发了很大的火。",
            "nextDialogs": [
              "221140109"
            ]
          },
          "221140109": {
            "id": "221140109",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "你能帮我去和小安说说吗？我，我之后一定认真工作！也尽量不拜托你帮忙了！",
            "nextDialogs": [
              "221140110"
            ]
          },
          "221140110": {
            "id": "221140110",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "但我自己是不敢去问他了…"
          },
          "221140112": {
            "id": "221140112",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "对啊，之前我不是拜托你统计过船只数吗？",
            "nextDialogs": [
              "221140113"
            ]
          },
          "221140113": {
            "id": "221140113",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "因为我相信你的能力…就没复核数据，直接报上去了，好多数据都错了。",
            "nextDialogs": [
              "221140114"
            ]
          },
          "221140114": {
            "id": "221140114",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "但是我也只是偶尔拜托你，我自己也统计了很多数据…",
            "nextDialogs": [
              "221140115"
            ]
          },
          "221140115": {
            "id": "221140115",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "两边混在一起，我连哪里错了都不知道，小安发了很大的火…",
            "nextDialogs": [
              "221140116"
            ]
          },
          "221140116": {
            "id": "221140116",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "拜托你去和小安说说吧！我，我之后一定认真工作！也尽量不拜托你帮忙了！",
            "nextDialogs": [
              "221140117"
            ]
          },
          "221140117": {
            "id": "221140117",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "但我自己是不敢去问他了…"
          }
        }
      }
    },
    {
      "subId": "2211402",
      "subQuestName": "与小安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221140201"
        ],
        "dialogs": {
          "221140201": {
            "id": "221140201",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "唉，真是…",
            "nextDialogs": [
              "221140202"
            ]
          },
          "221140202": {
            "id": "221140202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于霖铃的事…",
            "nextDialogs": [
              "221140203"
            ]
          },
          "221140203": {
            "id": "221140203",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "嗯？你问霖铃的事啊，哦，她…怎么说呢，不太适合这份工作。",
            "nextDialogs": [
              "221140204"
            ]
          },
          "221140204": {
            "id": "221140204",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "具体地说，就是…她上报的数据错误得太过分了。",
            "nextDialogs": [
              "221140205"
            ]
          },
          "221140205": {
            "id": "221140205",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "这周内的数据，只有一到两天是正确的，就算是纯目测都比她算得准。",
            "nextDialogs": [
              "221140206"
            ]
          },
          "221140206": {
            "id": "221140206",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "这样子的工作态度，我怎么能把工作放心交给她呢？",
            "nextDialogs": [
              "221140207"
            ]
          },
          "221140207": {
            "id": "221140207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只是数船的话…",
            "nextDialogs": [
              "221140208"
            ]
          },
          "221140208": {
            "id": "221140208",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "在工作的时候，任何事前面都不能加上「只是」。",
            "nextDialogs": [
              "221140209"
            ]
          },
          "221140209": {
            "id": "221140209",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "只要木桶里的某一块木板略短，那么整个木桶的质量都会下降。",
            "nextDialogs": [
              "221140210"
            ]
          },
          "221140210": {
            "id": "221140210",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "工作也一样，对任何一件事掉以轻心，都只会让整项工作全部落入泥潭。",
            "nextDialogs": [
              "221140211"
            ]
          },
          "221140211": {
            "id": "221140211",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "就拿统计船只数目作比方。假如统计的船只数量不准确，那么针对码头的各项举措一定也不准确。",
            "nextDialogs": [
              "221140212"
            ]
          },
          "221140212": {
            "id": "221140212",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "不准确的举措，绝对会带来糟糕的后果。就算是有人来补救，但白白消耗的时间也已经回不来了。",
            "nextDialogs": [
              "221140213"
            ]
          },
          "221140213": {
            "id": "221140213",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "这么说，你们明白了吗？",
            "nextDialogs": [
              "221140215",
              "221140220"
            ]
          },
          "221140215": {
            "id": "221140215",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "…不过，现在码头上实在是太缺人了，辞退…应该不会。",
            "nextDialogs": [
              "221140216"
            ]
          },
          "221140216": {
            "id": "221140216",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "怎么说呢…「一块木板略短」总比「一块木板暂缺」好，对吧？",
            "nextDialogs": [
              "221140217"
            ]
          },
          "221140217": {
            "id": "221140217",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "负责复核货物的人临时有事来不了，你们回去告诉霖铃，让她去这里临时帮忙。",
            "nextDialogs": [
              "221140218"
            ]
          },
          "221140218": {
            "id": "221140218",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "如果这项工作她没出什么大问题的话，等负责那块的人回来了，她可以继续回去统计船只。",
            "nextDialogs": [
              "221140224"
            ]
          },
          "221140224": {
            "id": "221140224",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "嗯…这算是一个「测试」吧，也算是给她一个机会。",
            "nextDialogs": [
              "221140225"
            ]
          },
          "221140225": {
            "id": "221140225",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "把这份货物单给霖铃，让她按着这个来检查吧，检查一项之后，就在后面标记好。",
            "nextDialogs": [
              "221140226"
            ]
          },
          "221140226": {
            "id": "221140226",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "还有，你们告诉霖铃，让她打起精神来，如果这份工作再出错的话，就没有第二次机会了。"
          },
          "221140220": {
            "id": "221140220",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "你们回去说什么？辞退？不，辞退暂时不会。",
            "nextDialogs": [
              "221140221"
            ]
          },
          "221140221": {
            "id": "221140221",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "码头上实在是太缺人了，怎么说呢…「一块木板略短」总比「一块木板暂缺」好，对吧？",
            "nextDialogs": [
              "221140222"
            ]
          },
          "221140222": {
            "id": "221140222",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "负责复核货物的人临时有事来不了，你们回去告诉霖铃，让她去这里临时帮忙。",
            "nextDialogs": [
              "221140223"
            ]
          },
          "221140223": {
            "id": "221140223",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "如果这项工作她没出什么大问题的话，等负责那块的人回来了，她可以继续回去统计船只。"
          }
        }
      }
    },
    {
      "subId": "2211403",
      "subQuestName": "与霖铃对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221140301"
        ],
        "dialogs": {
          "221140301": {
            "id": "221140301",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "呜…工作可怎么办啊…",
            "nextDialogs": [
              "221140302"
            ]
          },
          "221140302": {
            "id": "221140302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "小安说给你个机会。",
            "nextDialogs": [
              "221140303"
            ]
          },
          "221140303": {
            "id": "221140303",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "真的吗？！太好了，太好了！",
            "nextDialogs": [
              "221140304"
            ]
          },
          "221140304": {
            "id": "221140304",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "咦？复核货物？糟了，我，我从来没做过…",
            "nextDialogs": [
              "221140305"
            ]
          },
          "221140305": {
            "id": "221140305",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "要是这次工作再出错，我肯定彻底完了，不行，我要准备准备…",
            "nextDialogs": [
              "221140306"
            ]
          },
          "221140306": {
            "id": "221140306",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "我要去找找之前的货物复核标准…还有之前写过的标准格式…",
            "nextDialogs": [
              "221140307"
            ]
          },
          "221140307": {
            "id": "221140307",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "能请你们帮我先去确认一下货物的数量吗？先对着单据，看看货物的数量是不是正确的就好，我之后会再去做更详细的核查。",
            "nextDialogs": [
              "221140309",
              "221140312"
            ]
          },
          "221140309": {
            "id": "221140309",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "那就拜托你们了！我在这里接着做复核的准备。",
            "nextDialogs": [
              "221140310"
            ]
          },
          "221140310": {
            "id": "221140310",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "这次不能再出错了…"
          },
          "221140312": {
            "id": "221140312",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "不，这次不行。复核货物比统计船只复杂多了，必须要我自己来。",
            "nextDialogs": [
              "221140313"
            ]
          },
          "221140313": {
            "id": "221140313",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "所以，请你们先去确定一下货物的数量吧，我会再去做具体复核。"
          }
        }
      }
    },
    {
      "subId": "2211404",
      "subQuestName": "复核船只上的货物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2211405",
      "subQuestName": "与霖铃对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221140501"
        ],
        "dialogs": {
          "221140501": {
            "id": "221140501",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "你们确认好了吗？",
            "nextDialogs": [
              "221140503",
              "221140505"
            ]
          },
          "221140503": {
            "id": "221140503",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "太好了，我也准备差不多了，等会我就去把那些货物全部复核一遍。",
            "nextDialogs": [
              "221140506"
            ]
          },
          "221140506": {
            "id": "221140506",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "对了！这个给你，就当做是答谢了，请收下吧。等一下我就去复核货物，这次绝对不能再出问题…"
          },
          "221140505": {
            "id": "221140505",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "当然没有！我也是分得清轻重缓急的人，现在可不是写诗的时候…"
          }
        }
      }
    },
    {
      "subId": "2211406",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221140601"
        ],
        "dialogs": {
          "221140601": {
            "id": "221140601",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "呜…以后不能写诗了，要更认真工作才行…",
            "nextDialogs": [
              "221140603",
              "221140608",
              "221140613"
            ]
          },
          "221140603": {
            "id": "221140603",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "我知道啦，但是，一天到晚都做一件事，年复一年的…总会无聊嘛。",
            "nextDialogs": [
              "221140604"
            ]
          },
          "221140604": {
            "id": "221140604",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "而且，还是这种边边角角的小工作，没什么价值，也没人会在意，不由自主就开始开小差…",
            "nextDialogs": [
              "221140605"
            ]
          },
          "221140605": {
            "id": "221140605",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "唉，虽然小安总是说「每项工作都有重要的价值」，「每项工作都是决定性的」之类的话…",
            "nextDialogs": [
              "221140606"
            ]
          },
          "221140606": {
            "id": "221140606",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "但是，如果真是这样，那为什么工作的时候，大家还是挑挑拣拣的呢？"
          },
          "221140608": {
            "id": "221140608",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "我也只是偶尔拜托你帮忙啦，大部分时候还是我自己来。",
            "nextDialogs": [
              "221140609"
            ]
          },
          "221140609": {
            "id": "221140609",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "工作负责…我当然也知道。但越是工作忙的时候，却越是想要再偷偷懒，所以才会找你来帮忙。",
            "nextDialogs": [
              "221140610"
            ]
          },
          "221140610": {
            "id": "221140610",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "如果真闲下来了，反而想要四处找点事情做…",
            "nextDialogs": [
              "221140611"
            ]
          },
          "221140611": {
            "id": "221140611",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "哎呀，你还没工作过吧，说了你应该也不明白…"
          },
          "221140613": {
            "id": "221140613",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "怎么突然问这个？我想想…你觉得，一个人工作是为了什么呢？",
            "nextDialogs": [
              "221140614"
            ]
          },
          "221140614": {
            "id": "221140614",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "在我看来，如果是「为了继续工作而工作」的话，未免有些太无聊了呢。",
            "nextDialogs": [
              "221140615"
            ]
          },
          "221140615": {
            "id": "221140615",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "怎么说呢，人总是要有点梦想的，对吧？和日常的冗杂工作完全不同的「梦想」。",
            "nextDialogs": [
              "221140616"
            ]
          },
          "221140616": {
            "id": "221140616",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "这样的话，在很累很疲惫，快要坚持不下去的时候，至少可以在「梦想」里放松一下。",
            "nextDialogs": [
              "221140617"
            ]
          },
          "221140617": {
            "id": "221140617",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "不过，这也只是我的想法，那些冒险家是怎么想这个问题的，我是不知道啦。",
            "nextDialogs": [
              "221140618"
            ]
          },
          "221140618": {
            "id": "221140618",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "毕竟他们那副纯为梦想而生的样子，我觉得反而需要一点日常工作来约束一下自己…",
            "nextDialogs": [
              "221140619"
            ]
          },
          "221140619": {
            "id": "221140619",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "不过，哈哈哈…你可要以我为鉴哪，「梦想」就只是「梦想」而已，工作的时候还是要脚踏实地呀。"
          }
        }
      }
    },
    {
      "subId": "2211407",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221140701"
        ],
        "dialogs": {
          "221140701": {
            "id": "221140701",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "我这个「箍桶匠」，真是既手艺不精，又无材可用。",
            "nextDialogs": [
              "221140703",
              "221140709"
            ]
          },
          "221140703": {
            "id": "221140703",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "哦，就是说，我就像一个箍木桶的人，现在还缺一块木板，就能把木桶做完了。",
            "nextDialogs": [
              "221140704"
            ]
          },
          "221140704": {
            "id": "221140704",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "但是，我手里唯一的那块木板质量不太好，略短了一些，如果用这块木板的话，木桶的质量怕是要打折扣。",
            "nextDialogs": [
              "221140705"
            ]
          },
          "221140705": {
            "id": "221140705",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "不过，如果想要新找一块木板的话，不知道什么时候才能把木桶给做好。",
            "nextDialogs": [
              "221140706"
            ]
          },
          "221140706": {
            "id": "221140706",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "离木桶交货的日子也越来越近，到了这份上，也只能两害取其轻。",
            "nextDialogs": [
              "221140707"
            ]
          },
          "221140707": {
            "id": "221140707",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "唉，也不知道这普天之下，还有多少个和我一样的「箍桶匠」，也一样在左右为难。"
          },
          "221140709": {
            "id": "221140709",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "她的工作？哦，她曾经拜托你们帮她统计船只数量，对吧？这些我都知道。",
            "nextDialogs": [
              "221140710"
            ]
          },
          "221140710": {
            "id": "221140710",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "别那么一副惊讶的表情，只要结果是好的，我也不太在意她工作的过程。",
            "nextDialogs": [
              "221140711"
            ]
          },
          "221140711": {
            "id": "221140711",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "再说了，她给你们的报酬，也是她自己出的。",
            "nextDialogs": [
              "221140712"
            ]
          },
          "221140712": {
            "id": "221140712",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "不过，对于得来的数据不加复核，直接就报上来。",
            "nextDialogs": [
              "221140713"
            ]
          },
          "221140713": {
            "id": "221140713",
            "speakerId": 1001,
            "speakerName": "小安",
            "text": "这种不负责任的态度，才是让我最生气的。"
          }
        }
      }
    },
    {
      "subId": "2211408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221140801"
        ],
        "dialogs": {
          "221140801": {
            "id": "221140801",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "复核货物比统计船只麻烦多了。",
            "nextDialogs": [
              "221140802"
            ]
          },
          "221140802": {
            "id": "221140802",
            "speakerId": 1000,
            "speakerName": "霖铃",
            "text": "这次必须要细心，一点问题都不能出…"
          }
        }
      }
    }
  ]
}
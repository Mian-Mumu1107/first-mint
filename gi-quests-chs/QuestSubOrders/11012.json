    {
      "subId": "1101204",
      "subQuestName": "清除遗迹守卫的威胁",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120401"
        ],
        "dialogs": {
          "110120401": {
            "id": "110120401",
            "speakerId": 1003,
            "speakerName": "安德烈",
            "text": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYC|INFO_FEMALE_PRONOUN_GIRLC]}，还有托克少爷，我一直在等你们。",
            "nextDialogs": [
              "110120402"
            ]
          },
          "110120402": {
            "id": "110120402",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "是「公子」安排的人吗？",
            "nextDialogs": [
              "110120403"
            ]
          },
          "110120403": {
            "id": "110120403",
            "speakerId": 1003,
            "speakerName": "安德烈",
            "text": "是的，「公子」大人命我安排托克少爷的归国事宜，请少爷随我一起…",
            "nextDialogs": [
              "110120404"
            ]
          },
          "110120404": {
            "id": "110120404",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "你是谁呀，我哥哥一直告诉我，不能和陌生人一起走！",
            "nextDialogs": [
              "110120405"
            ]
          },
          "110120405": {
            "id": "110120405",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "可是你明明一直跟着我们…",
            "nextDialogs": [
              "110120406"
            ]
          },
          "110120406": {
            "id": "110120406",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "#那是因为我早就认识好人{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}呀？",
            "nextDialogs": [
              "110120407"
            ]
          },
          "110120407": {
            "id": "110120407",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "110120408"
            ]
          },
          "110120408": {
            "id": "110120408",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "我哥哥寄回来的家书里，提到了有关你的事情，冬妮娅姐姐读给我听过！",
            "nextDialogs": [
              "110120409"
            ]
          },
          "110120409": {
            "id": "110120409",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "所以其实我一眼就认出来啦，只是…不记得叫什么名字了。",
            "nextDialogs": [
              "110120410"
            ]
          },
          "110120410": {
            "id": "110120410",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "看来还不是一般的缘分。",
            "nextDialogs": [
              "110120412",
              "110120414"
            ]
          },
          "110120412": {
            "id": "110120412",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "嘿嘿…",
            "nextDialogs": [
              "110120415"
            ]
          },
          "110120415": {
            "id": "110120415",
            "speakerId": 1003,
            "speakerName": "安德烈",
            "text": "托克少爷，回至冬的船差不多该靠岸了，还是尽快启程吧。",
            "nextDialogs": [
              "110120416"
            ]
          },
          "110120416": {
            "id": "110120416",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "咦，这么快吗…",
            "nextDialogs": [
              "110120417"
            ]
          },
          "110120417": {
            "id": "110120417",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "#那么，好人{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}再见！",
            "nextDialogs": [
              "110120418"
            ]
          },
          "110120418": {
            "id": "110120418",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "托克会在家等着你们，以后一定~一定~一定也要来至冬旅行哦！"
          },
          "110120414": {
            "id": "110120414",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "没有哦，哥哥他还说，有机会的话，想要偶尔放下工作，体验一下你们的旅行！"
          }
        }
      }
    },
    {
      "subId": "1101209",
      "subQuestName": "(test)(隐藏)与托克交谈IV$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120701"
        ],
        "dialogs": {
          "110120701": {
            "id": "110120701",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "这里，简直和我的梦里一模一样！是「独眼小宝」的世界！",
            "nextDialogs": [
              "110120704"
            ]
          },
          "110120704": {
            "id": "110120704",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哇…他真的做到了，把遗迹守卫当做玩具一样摆弄…",
            "nextDialogs": [
              "110120705"
            ]
          },
          "110120705": {
            "id": "110120705",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "可是那样强行发动「魔王武装」，「公子」的身体会不会…",
            "nextDialogs": [
              "110120706"
            ]
          },
          "110120706": {
            "id": "110120706",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "厉害厉害！嘿嘿！",
            "nextDialogs": [
              "110120707"
            ]
          },
          "110120707": {
            "id": "110120707",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "要不是这些「独眼小宝」长得太大了，好想把它们带回家呀！",
            "nextDialogs": [
              "110120708"
            ]
          },
          "110120708": {
            "id": "110120708",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "咦，话说我哥哥呢？哥哥到哪里去了？",
            "nextDialogs": [
              "110120709"
            ]
          },
          "110120709": {
            "id": "110120709",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你们刚才不是在捉迷藏吗？",
            "nextDialogs": [
              "110120710"
            ]
          },
          "110120710": {
            "id": "110120710",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "哦对呀！托克太高兴了，把捉迷藏的事都给忘了！",
            "nextDialogs": [
              "110120711"
            ]
          },
          "110120711": {
            "id": "110120711",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "#那{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，我们一起找吧？"
          }
        }
      }
    },
    {
      "subId": "1101205",
      "subQuestName": "找到「公子」并对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120201"
        ],
        "dialogs": {
          "110120201": {
            "id": "110120201",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "好在被你们先找到了…带伤发动「魔王武装」，原来比想象中更费劲些…",
            "nextDialogs": [
              "110120202"
            ]
          },
          "110120202": {
            "id": "110120202",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "不然让托克看到我这副提不起劲的样子，可就太难堪了…呵呵。",
            "nextDialogs": [
              "110120204"
            ]
          },
          "110120204": {
            "id": "110120204",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "哈哈，我记得你也有兄弟姐妹吧？",
            "nextDialogs": [
              "110120205"
            ]
          },
          "110120205": {
            "id": "110120205",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "我了解你，所以我知道，不论如何…你也不会在我弟弟面前对我出手的。",
            "nextDialogs": [
              "110120206"
            ]
          },
          "110120206": {
            "id": "110120206",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "可是，没想到你居然会做到这种程度…",
            "nextDialogs": [
              "110120208"
            ]
          },
          "110120208": {
            "id": "110120208",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "我只是…不会放弃任何一个锻炼自己的机会而已。",
            "nextDialogs": [
              "110120209"
            ]
          },
          "110120209": {
            "id": "110120209",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "这就是我达达利亚不断变强的理由啊，哈哈哈…",
            "nextDialogs": [
              "110120210"
            ]
          },
          "110120210": {
            "id": "110120210",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "而且，孩童时期的梦是最易碎的东西。哪怕放着不管，也总有一天会自己碎掉。",
            "nextDialogs": [
              "110120211"
            ]
          },
          "110120211": {
            "id": "110120211",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "所以，一定要有人来保护才行吧？",
            "nextDialogs": [
              "110120212"
            ]
          },
          "110120212": {
            "id": "110120212",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "许下的承诺就该好好遵守，做错了事就该好好道歉。",
            "nextDialogs": [
              "110120213"
            ]
          },
          "110120213": {
            "id": "110120213",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "给予他的梦，就该好好呵护到最后…",
            "nextDialogs": [
              "110120214"
            ]
          },
          "110120214": {
            "id": "110120214",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "这才是身为家人该有的样子，就是这样。",
            "nextDialogs": [
              "110120215"
            ]
          },
          "110120215": {
            "id": "110120215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "110120216"
            ]
          },
          "110120216": {
            "id": "110120216",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "莫非…引起你的什么回忆了吗？",
            "nextDialogs": [
              "110120217"
            ]
          },
          "110120217": {
            "id": "110120217",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "咳咳…唔…",
            "nextDialogs": [
              "110120218"
            ]
          },
          "110120218": {
            "id": "110120218",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你这副样子居然还要耍帅，赶紧去看医生吧！",
            "nextDialogs": [
              "110120219"
            ]
          },
          "110120219": {
            "id": "110120219",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "呵…不错的提议，不过在这之前…有件东西，要请你转交给托克。",
            "nextDialogs": [
              "110120220"
            ]
          },
          "110120220": {
            "id": "110120220",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸，这是…「独眼小宝」的玩偶吗？",
            "nextDialogs": [
              "110120221"
            ]
          },
          "110120221": {
            "id": "110120221",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "没错，是很久之前我专门找铁匠定制的。本想带回至冬国送给他，但现在看来，作为旅行的纪念品更好。",
            "nextDialogs": [
              "110120222"
            ]
          },
          "110120222": {
            "id": "110120222",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔哇…这样一看，当「公子」的家人，好像还挺幸福的？",
            "nextDialogs": [
              "110120223"
            ]
          },
          "110120223": {
            "id": "110120223",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "还有，我这样不告而别，对托克那边的说辞也交给你了。",
            "nextDialogs": [
              "110120224"
            ]
          },
          "110120224": {
            "id": "110120224",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "你会帮忙的吧？"
          }
        }
      }
    },
    {
      "subId": "1101220",
      "subQuestName": "(test)(隐藏)托克找公子$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120301"
        ],
        "dialogs": {
          "110120301": {
            "id": "110120301",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "哪里都找不到…我哥哥藏在哪儿了…",
            "nextDialogs": [
              "110120303",
              "110120305"
            ]
          },
          "110120303": {
            "id": "110120303",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "真的吗！哥哥在哪里？",
            "nextDialogs": [
              "110120306"
            ]
          },
          "110120306": {
            "id": "110120306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "忽然有好多人要买「独眼小宝」！",
            "nextDialogs": [
              "110120307"
            ]
          },
          "110120307": {
            "id": "110120307",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "所、所以他急急忙忙地先走啦，不是故意丢下托克的。",
            "nextDialogs": [
              "110120308"
            ]
          },
          "110120308": {
            "id": "110120308",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "欸…这样呀，那，那是好事！",
            "nextDialogs": [
              "110120309"
            ]
          },
          "110120309": {
            "id": "110120309",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "只可惜，我还想和我哥哥在这里多玩一会儿的…"
          },
          "110120305": {
            "id": "110120305",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "怎么会…哥哥为什么丢下托克？"
          }
        }
      }
    },

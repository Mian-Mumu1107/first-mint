    {
      "subId": "1101210",
      "subQuestName": "(test)(隐藏)与托克交谈II$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120601"
        ],
        "dialogs": {
          "110120601": {
            "id": "110120601",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "托克，看到面前的大方块了吗？我需要你的帮忙。",
            "nextDialogs": [
              "110120602"
            ]
          },
          "110120602": {
            "id": "110120602",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "欸~！托克能帮得上哥哥的忙了吗？",
            "nextDialogs": [
              "110120603"
            ]
          },
          "110120603": {
            "id": "110120603",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "当然，倒数三二一，我们一起碰它。三…二…一…"
          }
        }
      }
    },

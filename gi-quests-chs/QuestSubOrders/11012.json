  "subQuests": [
    {
      "subId": "1101201",
      "subQuestName": "前往璃月的「玩具研究所」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120101"
        ],
        "dialogs": {
          "110120101": {
            "id": "110120101",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "就是这里了，璃月的「玩具研究所」。",
            "nextDialogs": [
              "110120102"
            ]
          },
          "110120102": {
            "id": "110120102",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "到了到了！我已经听到里面机器的声音了，好酷！",
            "nextDialogs": [
              "110120103"
            ]
          },
          "110120103": {
            "id": "110120103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这里究竟是什么地方，你为什么会知道这里？",
            "nextDialogs": [
              "110120104"
            ]
          },
          "110120104": {
            "id": "110120104",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "我之前略有了解，这里应该算是「博士」的「玩具研究所」吧。",
            "nextDialogs": [
              "110120105"
            ]
          },
          "110120105": {
            "id": "110120105",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "「博士」是愚人众的另一位「执行官」，平时偶尔有些鼓捣旧东西的…癖好。这处遗迹是被他改造了，用来研究遗迹守卫。",
            "nextDialogs": [
              "110120106"
            ]
          },
          "110120106": {
            "id": "110120106",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸？遗迹守卫难道是你们愚人众制造的吗？",
            "nextDialogs": [
              "110120107"
            ]
          },
          "110120107": {
            "id": "110120107",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "不，那种怪物和「深渊」的关系更近些，严格来说也算我们的敌人…我们只是单纯地做研究而已。",
            "nextDialogs": [
              "110120108"
            ]
          },
          "110120108": {
            "id": "110120108",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "至于最近为什么会有遗迹守卫跑出来…大概只是因为他玩腻了，对这里失去兴趣了吧。",
            "nextDialogs": [
              "110120109"
            ]
          },
          "110120109": {
            "id": "110120109",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "又是一个性格恶劣的执行官呢！",
            "nextDialogs": [
              "110120110"
            ]
          },
          "110120110": {
            "id": "110120110",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这么说，怪不得你敢带托克来这里，原来是早就做过功课了呀。",
            "nextDialogs": [
              "110120111"
            ]
          },
          "110120111": {
            "id": "110120111",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "其实…也不算做过功课吧，这座「研究所」的内部究竟是什么样，我还完全不了解。",
            "nextDialogs": [
              "110120112"
            ]
          },
          "110120112": {
            "id": "110120112",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那、那你难道不在乎弟弟的安危吗？",
            "nextDialogs": [
              "110120113"
            ]
          },
          "110120113": {
            "id": "110120113",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "怎么会…不论有什么危险，我都会替他全部接下——「哥哥」不就是这样的角色么。",
            "nextDialogs": [
              "110120114"
            ]
          },
          "110120114": {
            "id": "110120114",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "而且连托克也能理解战斗的意义，再怎么说，这意义也在我心里沉淀了这么多年…",
            "nextDialogs": [
              "110120115"
            ]
          },
          "110120115": {
            "id": "110120115",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "哥哥，你们还在聊什么？快带路呀！",
            "nextDialogs": [
              "110120116"
            ]
          },
          "110120116": {
            "id": "110120116",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "哈哈，好，交给我吧。"
          }
        }
      }
    },
    {

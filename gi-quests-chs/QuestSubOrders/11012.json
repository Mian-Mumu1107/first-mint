    {
      "subId": "1101213",
      "subQuestName": "(test)(隐藏)与托克交谈I$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120901"
        ],
        "dialogs": {
          "110120901": {
            "id": "110120901",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "欸，门开了！是哥哥帮的忙吗？",
            "nextDialogs": [
              "110120902"
            ]
          },
          "110120902": {
            "id": "110120902",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "没错，但是托克你先等等，让我确认下前面是否安全…",
            "nextDialogs": [
              "110120903"
            ]
          },
          "110120903": {
            "id": "110120903",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "唉…要是以前没那么惯着他就好了。"
          }
        }
      }
    },
    {
      "subId": "1101217",
      "subQuestName": "(test)(隐藏)进入区域$HIDDEN",
      "sceneId": null,

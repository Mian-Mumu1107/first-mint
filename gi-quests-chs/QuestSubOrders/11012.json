    {
      "subId": "1101203",
      "subQuestName": "保护托克，想办法与托克汇合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110121001"
        ],
        "dialogs": {
          "110121001": {
            "id": "110121001",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "呼…终于汇合了，托克，你没有哪里受伤吧？",
            "nextDialogs": [
              "110121002"
            ]
          },
          "110121002": {
            "id": "110121002",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "受伤？没有呀，托克觉得可好玩了！",
            "nextDialogs": [
              "110121003"
            ]
          },
          "110121003": {
            "id": "110121003",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "只有你一个人觉得好玩，我们都快吓死了…",
            "nextDialogs": [
              "110121004"
            ]
          },
          "110121004": {
            "id": "110121004",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "前面是…好大的房间！是「独眼小宝」们的会客厅吗？",
            "nextDialogs": [
              "110121005"
            ]
          },
          "110121005": {
            "id": "110121005",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "是啊，很宽阔的场地，不如我们来玩捉迷藏吧？",
            "nextDialogs": [
              "110121006"
            ]
          },
          "110121006": {
            "id": "110121006",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "欸…现在吗？可是…",
            "nextDialogs": [
              "110121007"
            ]
          },
          "110121007": {
            "id": "110121007",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "哥哥要给你准备一些…嗯，惊喜。",
            "nextDialogs": [
              "110121008"
            ]
          },
          "110121008": {
            "id": "110121008",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "惊喜！什么惊喜？",
            "nextDialogs": [
              "110121009"
            ]
          },
          "110121009": {
            "id": "110121009",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "等会儿托克自己去找吧？不过在这之前，你要乖乖闭上眼睛，转过身去倒数六十个数。",
            "nextDialogs": [
              "110121010"
            ]
          },
          "110121010": {
            "id": "110121010",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "好吧…六十个数好长呀。"
          }
        }
      }
    },
    {
      "subId": "1101216",
      "subQuestName": "(test)(隐藏)刷隐形NPCI$HIDDEN",

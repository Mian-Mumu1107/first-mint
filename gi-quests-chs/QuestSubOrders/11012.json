    {
      "subId": "1101211",
      "subQuestName": "进入璃月「玩具研究所」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110121101"
        ],
        "dialogs": {
          "110121101": {
            "id": "110121101",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "哟。",
            "nextDialogs": [
              "110121102"
            ]
          },
          "110121102": {
            "id": "110121102",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "「公子」？原来你在啊。刚才为什么不出来呀，非要躲在那里。",
            "nextDialogs": [
              "110121103"
            ]
          },
          "110121103": {
            "id": "110121103",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "临别的场面，是很重要的。我现在的状态…这么虚弱的模样，要是留在了托克的记忆里，可就不好了。",
            "nextDialogs": [
              "110121104"
            ]
          },
          "110121104": {
            "id": "110121104",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "虽然，不能亲口跟弟弟道别，确实有些可惜…",
            "nextDialogs": [
              "110121105"
            ]
          },
          "110121105": {
            "id": "110121105",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "唉…本来应该由我亲自护送他到家里的。虽说有手下跟着，但还是有些惴惴不安啊。",
            "nextDialogs": [
              "110121106"
            ]
          },
          "110121106": {
            "id": "110121106",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你到底有多宠着他啊？",
            "nextDialogs": [
              "110121107"
            ]
          },
          "110121107": {
            "id": "110121107",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "哈哈…但不知为何，把托克交给你们的时候，我都感觉很放心，明明不久之前我们还…",
            "nextDialogs": [
              "110121108"
            ]
          },
          "110121108": {
            "id": "110121108",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "哦对了，谢礼谢礼，我差点忘了。这次的事真是多亏你们一直帮忙打圆场。",
            "nextDialogs": [
              "110121109"
            ]
          },
          "110121109": {
            "id": "110121109",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哇，你还算有点良心嘛！",
            "nextDialogs": [
              "110121110"
            ]
          },
          "110121110": {
            "id": "110121110",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "还有，别忘记我们的约定，有机会一定要再好好较量一次。",
            "nextDialogs": [
              "110121111"
            ]
          },
          "110121111": {
            "id": "110121111",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "——赌上执行官的荣誉。",
            "nextDialogs": [
              "110121114"
            ]
          },
          "110121114": {
            "id": "110121114",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你先养好自己的身体吧！到时候别说我们欺负你！",
            "nextDialogs": [
              "110121115"
            ]
          },
          "110121115": {
            "id": "110121115",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "哈哈哈…下次较量之后，不论输赢，都请你们来我家做客吧。",
            "nextDialogs": [
              "110121116"
            ]
          },
          "110121116": {
            "id": "110121116",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "我会把冬妮娅和安东也介绍给你们，都是我引以为豪的弟弟妹妹。",
            "nextDialogs": [
              "110121117"
            ]
          },
          "110121117": {
            "id": "110121117",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好吧，就当兑现和托克的约定！",
            "nextDialogs": [
              "110121118"
            ]
          },
          "110121118": {
            "id": "110121118",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "哈哈，托克也一定很期待再见到你们吧，那就这么定了。我很期待…",
            "nextDialogs": [
              "110121119"
            ]
          },
          "110121119": {
            "id": "110121119",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "期待与你们在至冬见面的那一天。"
          }
        }
      }
    },

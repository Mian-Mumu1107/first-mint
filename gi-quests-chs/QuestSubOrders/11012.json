    {
      "subId": "1101208",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110120801"
        ],
        "dialogs": {
          "110120801": {
            "id": "110120801",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "哥哥…好像有人说，「独眼小宝」是杀人用的机器…",
            "nextDialogs": [
              "110120802"
            ]
          },
          "110120802": {
            "id": "110120802",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "怎么会呢？唔…你还小，别把打打杀杀挂在嘴上。",
            "nextDialogs": [
              "110120803"
            ]
          },
          "110120803": {
            "id": "110120803",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "嗯，我早知道他们是骗子了，「独眼小宝」是用来打败坏人、保护世界的，是托克最喜欢的玩具！",
            "nextDialogs": [
              "110120804"
            ]
          },
          "110120804": {
            "id": "110120804",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "对，有它在，坏人就伤害不了托克。",
            "nextDialogs": [
              "110120805"
            ]
          },
          "110120805": {
            "id": "110120805",
            "speakerId": 1001,
            "speakerName": "托克",
            "text": "嘿嘿，果然没错，我现在就去找「独眼小宝」玩了！",
            "nextDialogs": [
              "110120806"
            ]
          },
          "110120806": {
            "id": "110120806",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "喂，托克，慢一点…",
            "nextDialogs": [
              "110120807"
            ]
          },
          "110120807": {
            "id": "110120807",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "门、门关上了！托克会不会遇上危险…",
            "nextDialogs": [
              "110120808"
            ]
          },
          "110120808": {
            "id": "110120808",
            "speakerId": 1000,
            "speakerName": "「公子」",
            "text": "那边有另一条路，我们快走！"
          }
        }
      }
    }

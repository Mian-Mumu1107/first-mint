    {
      "subId": "4000402",
      "subQuestName": "与凯亚对话$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400040201"
        ],
        "dialogs": {
          "400040201": {
            "id": "400040201",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "#{NICKNAME}，嚯，好久不见。",
            "nextDialogs": [
              "400040202"
            ]
          },
          "400040202": {
            "id": "400040202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "凯亚，我们去璃月海灯节了！",
            "nextDialogs": [
              "400040203"
            ]
          },
          "400040203": {
            "id": "400040203",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "怎么样，海灯节有趣吗？",
            "nextDialogs": [
              "400040204"
            ]
          },
          "400040204": {
            "id": "400040204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好吃！",
            "nextDialogs": [
              "400040205"
            ]
          },
          "400040205": {
            "id": "400040205",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "那你好好期待蒙德的羽球节吧。应该也不会让你失望的。",
            "nextDialogs": [
              "400040206"
            ]
          },
          "400040206": {
            "id": "400040206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说正事吧，派蒙。",
            "nextDialogs": [
              "400040207"
            ]
          },
          "400040207": {
            "id": "400040207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，对了。凯亚，事情是这样的。",
            "nextDialogs": [
              "400040208"
            ]
          },
          "400040208": {
            "id": "400040208",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "嗯…建灯用的木、纸、油这些材料…无论怎么想，都很容易滑向危险的方向…",
            "nextDialogs": [
              "400040209"
            ]
          },
          "400040209": {
            "id": "400040209",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "哼哼，很有意思，你们为什么觉得我会认识这个符号呢？",
            "nextDialogs": [
              "400040211",
              "400040216"
            ]
          },
          "400040211": {
            "id": "400040211",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是的！",
            "nextDialogs": [
              "400040212"
            ]
          },
          "400040212": {
            "id": "400040212",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "呵呵呵，不敢当，我哪有那种本事。",
            "nextDialogs": [
              "400040213"
            ]
          },
          "400040213": {
            "id": "400040213",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "出现了！骑士「谦虚」的品德。",
            "nextDialogs": [
              "400040214"
            ]
          },
          "400040214": {
            "id": "400040214",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "哼哼，在璃月呆了一阵子，变得牙尖嘴利了啊。",
            "nextDialogs": [
              "400040220"
            ]
          },
          "400040220": {
            "id": "400040220",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "回到正题吧。这是跨国犯罪组织「盗宝团」的符号。",
            "nextDialogs": [
              "400040221"
            ]
          },
          "400040221": {
            "id": "400040221",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "你如果有兴趣的话，我可以安排你和线人见一面哦。",
            "nextDialogs": [
              "400040222"
            ]
          },
          "400040222": {
            "id": "400040222",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "西风骑士团不是不和敌人做交易吗？",
            "nextDialogs": [
              "400040223"
            ]
          },
          "400040223": {
            "id": "400040223",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "——那是我凯亚的线人，不是西风骑士团的啊。",
            "nextDialogs": [
              "400040224"
            ]
          },
          "400040224": {
            "id": "400040224",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "晚些时候，去风起地吧。我会安排线人去赴会的。",
            "nextDialogs": [
              "400040225"
            ]
          },
          "400040225": {
            "id": "400040225",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "谢谢你，凯亚。",
            "nextDialogs": [
              "400040226"
            ]
          },
          "400040226": {
            "id": "400040226",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "记住了，「酒中出真知」。",
            "nextDialogs": [
              "400040227"
            ]
          },
          "400040227": {
            "id": "400040227",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？"
          },
          "400040216": {
            "id": "400040216",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没错！",
            "nextDialogs": [
              "400040217"
            ]
          },
          "400040217": {
            "id": "400040217",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "啧啧。作为荣誉骑士，要慎言啊。",
            "nextDialogs": [
              "400040218"
            ]
          },
          "400040218": {
            "id": "400040218",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "什么叫黑白通吃？我们西风骑士团是不和敌人做交易的。",
            "nextDialogs": [
              "400040219"
            ]
          },
          "400040219": {
            "id": "400040219",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "这就是骑士「诚实」的品德。"
          }
        }
      }
    },
    {
      "subId": "4000403",
      "subQuestName": "与凯亚的线人对话$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400040301"
        ],
        "dialogs": {
          "400040301": {
            "id": "400040301",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "……",
            "nextDialogs": [
              "400040302"
            ]
          },
          "400040302": {
            "id": "400040302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你就是凯亚先生推荐来的线人吗？",
            "nextDialogs": [
              "400040303"
            ]
          },
          "400040303": {
            "id": "400040303",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "什么线人？不是。",
            "nextDialogs": [
              "400040304"
            ]
          },
          "400040304": {
            "id": "400040304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可是，在这个约好的地方，只有你啊…",
            "nextDialogs": [
              "400040305"
            ]
          },
          "400040305": {
            "id": "400040305",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "什么约好的？不知道。",
            "nextDialogs": [
              "400040306"
            ]
          },
          "400040306": {
            "id": "400040306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，真是让人烦躁的态度！",
            "nextDialogs": [
              "400040308",
              "400040311"
            ]
          },
          "400040308": {
            "id": "400040308",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "嗯，是自己人。",
            "nextDialogs": [
              "400040309"
            ]
          },
          "400040309": {
            "id": "400040309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个形式上的流程有什么意义！？",
            "nextDialogs": [
              "400040316"
            ]
          },
          "400040316": {
            "id": "400040316",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "有什么想问的吗？",
            "nextDialogs": [
              "400040317"
            ]
          },
          "400040317": {
            "id": "400040317",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "事情是这样的…",
            "nextDialogs": [
              "400040318"
            ]
          },
          "400040318": {
            "id": "400040318",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "这样吗？",
            "nextDialogs": [
              "400040319"
            ]
          },
          "400040319": {
            "id": "400040319",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "有什么内部的消息吗？",
            "nextDialogs": [
              "400040320"
            ]
          },
          "400040320": {
            "id": "400040320",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "我觉得这应该不是盗宝团所为。",
            "nextDialogs": [
              "400040321"
            ]
          },
          "400040321": {
            "id": "400040321",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "盗宝团能够打下横跨多国的基业，是因为他们永远遵循一个最根本的原则。",
            "nextDialogs": [
              "400040322"
            ]
          },
          "400040322": {
            "id": "400040322",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "——「富贵险中求」都是骗人的鬼话，稳扎稳打才是人间正道。",
            "nextDialogs": [
              "400040323"
            ]
          },
          "400040323": {
            "id": "400040323",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "璃月港可是有仙人守护的，尤其是在海灯节期间…",
            "nextDialogs": [
              "400040325"
            ]
          },
          "400040325": {
            "id": "400040325",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "所以对海灯节出手，这事我们——对不起，角色没缓过来——这事盗宝团绝不会做。",
            "nextDialogs": [
              "400040326"
            ]
          },
          "400040326": {
            "id": "400040326",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "而且…璃月那里的盗宝团组织，最近收到了一封匿名信。",
            "nextDialogs": [
              "400040327"
            ]
          },
          "400040327": {
            "id": "400040327",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "匿名信？难道是有人准备栽赃盗宝团？",
            "nextDialogs": [
              "400040328"
            ]
          },
          "400040328": {
            "id": "400040328",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "这就不得而知了。但我可以告诉你们这封信在盗宝团的哪个分部手里。",
            "nextDialogs": [
              "400040329"
            ]
          },
          "400040329": {
            "id": "400040329",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "…好了，已经帮你们标在地图上了。",
            "nextDialogs": [
              "400040330"
            ]
          },
          "400040330": {
            "id": "400040330",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#嗯，很有收获！{NICKNAME}，我们要努力抓住这唯一的线索啊！",
            "nextDialogs": [
              "400040331"
            ]
          },
          "400040331": {
            "id": "400040331",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "那么，如果没什么别的事情，我就回去继续盗…我是说，回去监视盗宝团了。"
          },
          "400040311": {
            "id": "400040311",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "嗯…",
            "nextDialogs": [
              "400040312"
            ]
          },
          "400040312": {
            "id": "400040312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "400040313"
            ]
          },
          "400040313": {
            "id": "400040313",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "嗯，虽然暗号错了，但如果都在酒里，那真知也应该在酒里。",
            "nextDialogs": [
              "400040314"
            ]
          },
          "400040314": {
            "id": "400040314",
            "speakerId": 1002,
            "speakerName": "宁禄",
            "text": "没错。是自己人。",
            "nextDialogs": [
              "400040315"
            ]
          },
          "400040315": {
            "id": "400040315",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个形式上的流程有什么意义！？"
          }
        }
      }
    },

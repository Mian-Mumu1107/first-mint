            ]
          },
          "400040814": {
            "id": "400040814",
            "speakerId": 1006,
            "speakerName": "魈",
            "text": "怎么了？$UNRELEASED",
            "nextDialogs": [
              "400040815"
            ]
          },
          "400040815": {
            "id": "400040815",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们下一次见面的地方…$UNRELEASED",
            "nextDialogs": [
              "400040816"
            ]
          },
          "400040816": {
            "id": "400040816",
            "speakerId": 1006,
            "speakerName": "魈",
            "text": "嗯？$UNRELEASED",
            "nextDialogs": [
              "400040817"
            ]
          },
          "400040817": {
            "id": "400040817",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "希望是能看到明霄灯的地方。$UNRELEASED",
            "nextDialogs": [

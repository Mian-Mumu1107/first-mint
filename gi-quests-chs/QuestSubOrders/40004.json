      "subQuestName": "（test）与凯亚对话$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400040501"
        ],
        "dialogs": {
          "400040501": {
            "id": "400040501",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "小派蒙一脸失望呢，是线索断了吗？",
            "nextDialogs": [
              "400040502"
            ]
          },
          "400040502": {
            "id": "400040502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，看来很可能不是盗宝团干的。",
            "nextDialogs": [
              "400040503"
            ]
          },
          "400040503": {
            "id": "400040503",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "你们离开的空档里，我正好也听到了另一条消息。",
            "nextDialogs": [
              "400040504"
            ]
          },
          "400040504": {
            "id": "400040504",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "来自于璃月那边的…业务合作伙伴。或许对你们有所帮助。",
            "nextDialogs": [
              "400040505"
            ]
          },
          "400040505": {
            "id": "400040505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是什么是什么？",
            "nextDialogs": [
              "400040506"
            ]
          },
          "400040506": {
            "id": "400040506",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "璃月那里的盗宝团组织，收到了一封匿名信。",
            "nextDialogs": [
              "400040508"
            ]
          },
          "400040508": {
            "id": "400040508",
            "speakerId": 1001,
            "speakerName": "凯亚",
            "text": "我只能告诉你们那封信在哪里，内容就无从得知了。",
            "nextDialogs": [
              "400040509"
            ]
          },
          "400040509": {
            "id": "400040509",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#嗯！{NICKNAME}，我们要努力抓住这唯一的线索啊！"
          }
        }
      }
    },

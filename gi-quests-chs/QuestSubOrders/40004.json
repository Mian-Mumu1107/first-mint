            ]
          },
          "400040802": {
            "id": "400040802",
            "speakerId": 1004,
            "speakerName": "伶俐鬼",
            "text": "那匿名信一纸胡言乱语，不必这般兵戎相向的！拿去便是！$UNRELEASED",
            "nextDialogs": [
              "400040803"
            ]
          },
          "400040803": {
            "id": "400040803",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真巧，我早就这么觉得了。$UNRELEASED",
            "nextDialogs": [
              "400040804"
            ]
          },
          "400040804": {
            "id": "400040804",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，来看看匿名信的内容吧。$UNRELEASED",
            "nextDialogs": [

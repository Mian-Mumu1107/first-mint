      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400040901"
        ],
        "dialogs": {
          "400040901": {
            "id": "400040901",
            "speakerId": 1003,
            "speakerName": "贝儿",
            "text": "朋友，你走错地方了。无论您想去哪里，都往那边去吧。$UNRELEASED",
            "nextDialogs": [
              "400040902"
            ]
          },
          "400040902": {
            "id": "400040902",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那边不是璃月港吗？$UNRELEASED",
            "nextDialogs": [
              "400040903"
            ]
          },
          "400040903": {
            "id": "400040903",
            "speakerId": 1003,
            "speakerName": "贝儿",
            "text": "当然是去璃月港了，因为这里什么都没有啊。$UNRELEASED",
            "nextDialogs": [
              "400040904"
            ]
          },
          "400040904": {
            "id": "400040904",
            "speakerId": 1004,
            "speakerName": "伶俐鬼",
            "text": "要吃喝住宿？那可以去那边的望舒客栈。价格公道，态度一流，风景绝好。$UNRELEASED",
            "nextDialogs": [
              "400040905"
            ]
          },
          "400040905": {
            "id": "400040905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们想看「那封匿名信」。$UNRELEASED",
            "nextDialogs": [
              "400040906"
            ]
          },
          "400040906": {
            "id": "400040906",
            "speakerId": 1003,
            "speakerName": "贝儿",
            "text": "你为什么会知道这件事？$UNRELEASED",
            "nextDialogs": [
              "400040907"
            ]
          },
          "400040907": {
            "id": "400040907",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…是、是璃月的仙人告诉我们的！$UNRELEASED",
            "nextDialogs": [
              "400040908"
            ]
          },
          "400040908": {
            "id": "400040908",
            "speakerId": 1003,
            "speakerName": "贝儿",
            "text": "你这句话也编得也太假了吧。$UNRELEASED",
            "nextDialogs": [
              "400040909"
            ]
          },
          "400040909": {
            "id": "400040909",
            "speakerId": 1005,
            "speakerName": "？？？$UNRELEASED",
            "text": "不错。是我委托他们来调查的。$UNRELEASED",
            "nextDialogs": [
              "400040910"
            ]
          },
          "400040910": {
            "id": "400040910",
            "speakerId": 1006,
            "speakerName": "魈",
            "text": "现在，还有什么问题吗？$UNRELEASED",
            "nextDialogs": [
              "400040911"
            ]
          },
          "400040911": {
            "id": "400040911",
            "speakerId": 1003,
            "speakerName": "贝儿",
            "text": "你…你是「护法夜叉」？！$UNRELEASED",
            "nextDialogs": [
              "400040912"
            ]
          },
          "400040912": {
            "id": "400040912",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "见到仙人，为什么反而是这种想要开打的语气？$UNRELEASED",
            "nextDialogs": [
              "400040913"
            ]
          },
          "400040913": {
            "id": "400040913",
            "speakerId": 1004,
            "speakerName": "伶俐鬼",
            "text": "不是我们不信您是仙人…但大家想，开开眼界。$UNRELEASED",
            "nextDialogs": [
              "400040914"
            ]
          },
          "400040914": {
            "id": "400040914",
            "speakerId": 1003,
            "speakerName": "贝儿",
            "text": "您也知道，我们盗宝团不做什么大奸大恶之事。$UNRELEASED",
            "nextDialogs": [
              "400040915"
            ]
          },
          "400040915": {
            "id": "400040915",
            "speakerId": 1004,
            "speakerName": "伶俐鬼",
            "text": "您要真是仙人的话，劳烦手下留情。$UNRELEASED",
            "nextDialogs": [
              "400040916"
            ]
          },
          "400040916": {
            "id": "400040916",
            "speakerId": 1003,
            "speakerName": "贝儿",
            "text": "当然，如果不是真正仙人…$UNRELEASED",
            "nextDialogs": [
              "400040917"
            ]
          },
          "400040917": {
            "id": "400040917",
            "speakerId": 1004,
            "speakerName": "伶俐鬼",
            "text": "那就休怪我们兵器不长眼睛了。$UNRELEASED"
          }
        }
      }

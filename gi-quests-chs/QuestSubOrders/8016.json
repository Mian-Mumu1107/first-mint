    {
      "subId": "801606",
      "subQuestName": "对深渊教团进行反击",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "801607",
      "subQuestName": "与茜特菈莉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80160701"
        ],
        "dialogs": {
          "80160701": {
            "id": "80160701",
            "speakerId": 1000,
            "speakerName": "伊安珊",
            "text": "拔除掉据点了，各位辛苦了。",
            "nextDialogs": [
              "80160702"
            ]
          },
          "80160702": {
            "id": "80160702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过如此嘛，深渊教团的家伙们。",
            "nextDialogs": [
              "80160703"
            ]
          },
          "80160703": {
            "id": "80160703",
            "speakerId": 1003,
            "speakerName": "茜特菈莉",
            "text": "不算令人满意的结果，本来还想听他们亲口向我道歉，然后承认「烟谜主」的实力的…",
            "nextDialogs": [
              "80160704"
            ]
          },
          "80160704": {
            "id": "80160704",
            "speakerId": 1003,
            "speakerName": "茜特菈莉",
            "text": "算了，只能回去用庆功酒来补足这份情绪上的落差了。",
            "nextDialogs": [
              "80160705"
            ]
          },
          "80160705": {
            "id": "80160705",
            "speakerId": 1000,
            "speakerName": "伊安珊",
            "text": "尽管除掉了这个据点，附近的深渊教团应该会老实一阵子，但是…总觉得不能掉以轻心。",
            "nextDialogs": [
              "80160706"
            ]
          },
          "80160706": {
            "id": "80160706",
            "speakerId": 1000,
            "speakerName": "伊安珊",
            "text": "发现了吗，一般来说，据点的攻略越到后期，遭遇的反抗应该越顽强才对…",
            "nextDialogs": [
              "80160707"
            ]
          },
          "80160707": {
            "id": "80160707",
            "speakerId": 1000,
            "speakerName": "伊安珊",
            "text": "可刚刚总觉得除了一小部分殊死挣扎的家伙之外，他们好像感知到了什么一样，选择了撤离。",
            "nextDialogs": [
              "80160708"
            ]
          },
          "80160708": {
            "id": "80160708",
            "speakerId": 1003,
            "speakerName": "茜特菈莉",
            "text": "哦？这有什么，难道不是战略性放弃了据点吗？",
            "nextDialogs": [
              "80160709"
            ]
          },
          "80160709": {
            "id": "80160709",
            "speakerId": 1000,
            "speakerName": "伊安珊",
            "text": "不太像，要知道他们可是会选择贸然挑战一个国家的「深渊教团」，战略上一直很激进，刚刚不像是他们会做出的决策。",
            "nextDialogs": [
              "80160710"
            ]
          },
          "80160710": {
            "id": "80160710",
            "speakerId": 1003,
            "speakerName": "茜特菈莉",
            "text": "那就是说，你觉得他们是有什么猫腻咯？",
            "nextDialogs": [
              "80160711"
            ]
          },
          "80160711": {
            "id": "80160711",
            "speakerId": 1000,
            "speakerName": "伊安珊",
            "text": "反正目前我们掌握不到任何信息，保持怀疑，做好防御吧。",
            "nextDialogs": [
              "80160712"
            ]
          },
          "80160712": {
            "id": "80160712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（结果还是对深渊教团此次的目的一无所知，缺少情报来源…）",
            "nextDialogs": [
              "80160713"
            ]
          },
          "80160713": {
            "id": "80160713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#（但如果能见到{M#荧}{F#哥哥}的话，我的问题，纳塔的问题，就都能一并得到解决了吧。）",
            "nextDialogs": [
              "80160716"
            ]
          },
          "80160716": {
            "id": "80160716",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你果然还是在意钥匙的事呢…",
            "nextDialogs": [
              "80160717"
            ]
          },
          "80160717": {
            "id": "80160717",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也对，如果顺着这条线索可以直接找到你的血亲的话，战争说不定就能提前结束了，你们也能再次相见。",
            "nextDialogs": [
              "80160718"
            ]
          },
          "80160718": {
            "id": "80160718",
            "speakerId": 1003,
            "speakerName": "茜特菈莉",
            "text": "欸，这就要走了吗，就在我犹豫要不要发出「阶段性庆功酒」的邀请的时候？",
            "nextDialogs": [
              "80160719"
            ]
          },
          "80160719": {
            "id": "80160719",
            "speakerId": 1000,
            "speakerName": "伊安珊",
            "text": "嗯，你们去吧，这里有我和茜特菈莉在，敬请放心就是了。"
          }
        }
      }
    },
    {
      "subId": "801608",
      "subQuestName": "离开战场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "801610",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80161001"
        ],
        "dialogs": {
          "80161001": {
            "id": "80161001",
            "speakerId": 1002,
            "speakerName": "玛薇卡",
            "text": "放心，就算始作俑者是你的血亲，我也不可能把责任推在我们的英雄身上。",
            "nextDialogs": [
              "80161002"
            ]
          },
          "80161002": {
            "id": "80161002",
            "speakerId": 1002,
            "speakerName": "玛薇卡",
            "text": "#不过，假如真的抓到了你的{M#妹妹}{F#哥哥}，我会好好地给{M#她}{F#他}来上一拳作为教训，你应该没意见吧？"
          }
        }
      }
    },
    {
      "subId": "801699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80169901"
        ],
        "dialogs": {
          "80169901": {
            "id": "80169901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？之前好像没注意过，这里原来有个山洞。",
            "nextDialogs": [
              "80169902"
            ]
          },
          "80169902": {
            "id": "80169902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "过去瞧瞧吧，毕竟我们是来巡逻的。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7181715",
      "subQuestName": "向言笑回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718173201"
        ],
        "dialogs": {
          "718173201": {
            "id": "718173201",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "谢谢了啊，有你帮忙，真是轻松不少。",
            "nextDialogs": [
              "718173202"
            ]
          },
          "718173202": {
            "id": "718173202",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "这给我忙的，明明是海灯节，霄灯也没编一盏…",
            "nextDialogs": [
              "718173203"
            ]
          },
          "718173203": {
            "id": "718173203",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "对了旅行者，你会编霄灯吗？",
            "nextDialogs": [
              "718173204"
            ]
          },
          "718173204": {
            "id": "718173204",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "还让你帮忙真不大好意思，但我真没空去置办材料编霄灯了。",
            "nextDialogs": [
              "718173205"
            ]
          },
          "718173205": {
            "id": "718173205",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "你愿意帮忙的话，能不能帮我也编一盏…啊不，两盏，两盏霄灯。",
            "nextDialogs": [
              "718173206"
            ]
          },
          "718173206": {
            "id": "718173206",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "一盏我自己留着，一盏请你帮我送去给江雪，他一直在客栈旁边钓鱼来着。",
            "nextDialogs": [
              "718173207"
            ]
          },
          "718173207": {
            "id": "718173207",
            "speakerId": 1000,
            "speakerName": "言笑",
            "text": "那个吃白食的家伙…也不知道怎么了，平时来蹭吃蹭喝，今天倒是不来了…"
          }
        }
      }
    },

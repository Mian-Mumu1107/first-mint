    {
      "subId": "7551001",
      "subQuestName": "与维热对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "755100101"
        ],
        "dialogs": {
          "755100101": {
            "id": "755100101",
            "speakerId": 30837,
            "speakerName": "「小松果」",
            "text": "要我说，虽然「面具斗士」不能像「调停人」那样自由地飞来飞去，但只要找准机会，埋头冲刺，肯定能赢下对局！",
            "nextDialogs": [
              "755100102"
            ]
          },
          "755100102": {
            "id": "755100102",
            "speakerId": 30838,
            "speakerName": "「燃爆木头人」",
            "text": "呆子，不能太依赖直线行动的速度啊，转不过弯，撞不中，不就没有意义了嘛！",
            "nextDialogs": [
              "755100103"
            ]
          },
          "755100103": {
            "id": "755100103",
            "speakerId": 30836,
            "speakerName": "维热",
            "text": "好啦好啦，孩子们，可以认真讨论，但不能动气吵架哦。",
            "nextDialogs": [
              "755100104"
            ]
          },
          "755100104": {
            "id": "755100104",
            "speakerId": 30838,
            "speakerName": "「燃爆木头人」",
            "text": "没有啦，没有啦，我们只是…聊到强大的战士，都非常兴奋！",
            "nextDialogs": [
              "755100105"
            ]
          },
          "755100105": {
            "id": "755100105",
            "speakerId": 30837,
            "speakerName": "「小松果」",
            "text": "你可以放心的，维热姐姐！就算要比出个高低，我们也会讲道理，摆证据！",
            "nextDialogs": [
              "755100106"
            ]
          },
          "755100106": {
            "id": "755100106",
            "speakerId": 30838,
            "speakerName": "「燃爆木头人」",
            "text": "还有个方法，再来一局。",
            "nextDialogs": [
              "755100107"
            ]
          },
          "755100107": {
            "id": "755100107",
            "speakerId": 30837,
            "speakerName": "「小松果」",
            "text": "那就再来一局！",
            "nextDialogs": [
              "755100110"
            ]
          },
          "755100110": {
            "id": "755100110",
            "speakerId": 30836,
            "speakerName": "维热",
            "text": "新的客人，你好啊！",
            "nextDialogs": [
              "755100111"
            ]
          },
          "755100111": {
            "id": "755100111",
            "speakerId": 30836,
            "speakerName": "维热",
            "text": "看你的装束，应该是一位旅者吧？那我们是同行！",
            "nextDialogs": [
              "755100112"
            ]
          },
          "755100112": {
            "id": "755100112",
            "speakerId": 30836,
            "speakerName": "维热",
            "text": "要不要和孩子们一起，来试试我最近创作的这个「互动织卷」？"
          }
        }
      }
    },

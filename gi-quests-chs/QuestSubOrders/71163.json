    {
      "subId": "7116303",
      "subQuestName": "与兹白交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711630301"
        ],
        "dialogs": {
          "711630301": {
            "id": "711630301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么回事？我们怎么来了这里！",
            "nextDialogs": [
              "711630302"
            ]
          },
          "711630302": {
            "id": "711630302",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "怎么样？喜欢我给你们准备的小玩意吗？",
            "nextDialogs": [
              "711630303"
            ]
          },
          "711630303": {
            "id": "711630303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兹白，你在这里啊！这把伞是什么？「嗖」地一下就把我们搬到这里来了。",
            "nextDialogs": [
              "711630304"
            ]
          },
          "711630304": {
            "id": "711630304",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "看来你们的记性也欠佳呢，这就忘了先前与我一同乘过吗？",
            "nextDialogs": [
              "711630305"
            ]
          },
          "711630305": {
            "id": "711630305",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "现在想起来了吗？",
            "nextDialogs": [
              "711630306"
            ]
          },
          "711630306": {
            "id": "711630306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！是…是月宫的高车！难怪刚才就觉得眼熟…",
            "nextDialogs": [
              "711630307"
            ]
          },
          "711630307": {
            "id": "711630307",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "呵呵，只是我依照记忆仿制的而已。",
            "nextDialogs": [
              "711630308"
            ]
          },
          "711630308": {
            "id": "711630308",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "#这还要多亏{NICKNAME}拿来的那枚玉节。",
            "nextDialogs": [
              "711630309"
            ]
          },
          "711630309": {
            "id": "711630309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#噢~原来你之前说要做一个小玩意送给{NICKNAME}，就是这个呀。",
            "nextDialogs": [
              "711630310"
            ]
          },
          "711630310": {
            "id": "711630310",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "不错，这玉节所制的高车可载着你们快速抵达目的地，应当能为旅途提供些许便利。",
            "nextDialogs": [
              "711630311"
            ]
          },
          "711630311": {
            "id": "711630311",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "两位向导，请收好吧。",
            "nextDialogs": [
              "711630312"
            ]
          },
          "711630312": {
            "id": "711630312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好厉害…我还以为你只是说说而已呢，没想到这么快就做好了！",
            "nextDialogs": [
              "711630313"
            ]
          },
          "711630313": {
            "id": "711630313",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "我原以为是要花上一些工夫，毕竟这玉节受损严重，灵气早已散尽。",
            "nextDialogs": [
              "711630314"
            ]
          },
          "711630314": {
            "id": "711630314",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "但幸运的是，这里是沉玉谷。",
            "nextDialogs": [
              "711630315"
            ]
          },
          "711630315": {
            "id": "711630315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦？沉玉谷怎么了？",
            "nextDialogs": [
              "711630316"
            ]
          },
          "711630316": {
            "id": "711630316",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "你可知，我们现在所在沉玉谷何处？",
            "nextDialogs": [
              "711630317"
            ]
          },
          "711630317": {
            "id": "711630317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…遗珑埠？",
            "nextDialogs": [
              "711630318"
            ]
          },
          "711630318": {
            "id": "711630318",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "呵呵，你还不够了解这里。",
            "nextDialogs": [
              "711630319"
            ]
          },
          "711630319": {
            "id": "711630319",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "你我脚踏之地，其实是璃月地脉交汇的关键节点之一，如此节点，共有八处…",
            "nextDialogs": [
              "711630320"
            ]
          },
          "711630320": {
            "id": "711630320",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "生死休杜，开景惊伤。",
            "nextDialogs": [
              "711630321"
            ]
          },
          "711630321": {
            "id": "711630321",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "你倒是比我想象中要更加熟悉此地。",
            "nextDialogs": [
              "711630322"
            ]
          },
          "711630322": {
            "id": "711630322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！我也想起来了，是地脉中的八门！",
            "nextDialogs": [
              "711630323"
            ]
          },
          "711630323": {
            "id": "711630323",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "不错，这里就是其中的大吉门——生门的中央地带。",
            "nextDialogs": [
              "711630324"
            ]
          },
          "711630324": {
            "id": "711630324",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "生门主生长繁荣，万物复苏，因此，我才能在短时间内补足玉节灵气，制出这架高车。",
            "nextDialogs": [
              "711630325"
            ]
          },
          "711630325": {
            "id": "711630325",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，原来这么管用啊？看来沉玉谷真是个风水宝地啊…",
            "nextDialogs": [
              "711630326"
            ]
          },
          "711630326": {
            "id": "711630326",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "嗯…这才该是你们安居乐业的地方…",
            "nextDialogs": [
              "711630327"
            ]
          },
          "711630327": {
            "id": "711630327",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们…？",
            "nextDialogs": [
              "711630328"
            ]
          },
          "711630328": {
            "id": "711630328",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "没什么…",
            "nextDialogs": [
              "711630329"
            ]
          },
          "711630329": {
            "id": "711630329",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "好啦，我也没有别的事了，去忙你们的吧。",
            "nextDialogs": [
              "711630330"
            ]
          },
          "711630330": {
            "id": "711630330",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "我打算在这山上再走一走，就在这里别过吧。",
            "nextDialogs": [
              "711630331"
            ]
          },
          "711630331": {
            "id": "711630331",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢兹白。",
            "nextDialogs": [
              "711630332"
            ]
          },
          "711630332": {
            "id": "711630332",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "不必客气。你唤醒了我，是我欠你的。",
            "nextDialogs": [
              "711630333"
            ]
          },
          "711630333": {
            "id": "711630333",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "主要是钟离的功劳。",
            "nextDialogs": [
              "711630334"
            ]
          },
          "711630334": {
            "id": "711630334",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "同样的话，我也对他说过。",
            "nextDialogs": [
              "711630335"
            ]
          },
          "711630335": {
            "id": "711630335",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "从他那我还得知，你正行进在一条漫长的旅途中…",
            "nextDialogs": [
              "711630336"
            ]
          },
          "711630336": {
            "id": "711630336",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "你的下一站，是那遥远的雪国吗？",
            "nextDialogs": [
              "711630337"
            ]
          },
          "711630337": {
            "id": "711630337",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是的，那里是至冬。",
            "nextDialogs": [
              "711630338"
            ]
          },
          "711630338": {
            "id": "711630338",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "至冬…虽然我不清楚那是个什么样的国度，但冰天雪地的路途，想必不能畅通无阻。",
            "nextDialogs": [
              "711630339"
            ]
          },
          "711630339": {
            "id": "711630339",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "#{NICKNAME}，往后若是需要助力，你知道在哪里可以找到我。",
            "nextDialogs": [
              "711630340"
            ]
          },
          "711630340": {
            "id": "711630340",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会的。",
            "nextDialogs": [
              "711630341"
            ]
          },
          "711630341": {
            "id": "711630341",
            "speakerId": 1323,
            "speakerName": "兹白",
            "text": "嗯，保重。"
          }
        }
      }
    }
  ]
}
        ],
        "dialogs": {
          "205130201": {
            "id": "205130201",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你找到东西了吗？",
            "nextDialogs": [
              "205130202"
            ]
          },
          "205130202": {
            "id": "205130202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有。",
            "nextDialogs": [
              "205130203"
            ]
          },
          "205130203": {
            "id": "205130203",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "毕竟还是要战斗，请做好准备再去吧。"
          }
        }
      }
    },
    {
      "subId": "2051303",
      "subQuestName": "与安东尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205130301"
        ],
        "dialogs": {
          "205130301": {
            "id": "205130301",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你找到东西了吗？",
            "nextDialogs": [
              "205130302"
            ]
          },
          "205130302": {
            "id": "205130302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "205130303"
            ]
          },
          "205130303": {
            "id": "205130303",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "咦？这株风车菊，总感觉和普通的风车菊不一样…",
            "nextDialogs": [
              "205130304"
            ]
          },
          "205130304": {
            "id": "205130304",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "哈哈哈，不知道为什么，我有一种这副药吃下去，安娜的病就会好起来的感觉…",
            "nextDialogs": [
              "205130305"
            ]
          },
          "205130305": {
            "id": "205130305",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "也许是因为安娜的身体突然有了起色，我乐观过头了吧。",
            "nextDialogs": [
              "205130306"
            ]
          },
          "205130306": {
            "id": "205130306",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "总之，辛苦你了，这些是给你的。",
            "nextDialogs": [
              "205130307"
            ]
          },
          "205130307": {
            "id": "205130307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "希望安娜能好起来。",
            "nextDialogs": [
              "205130308"
            ]
          },
          "205130308": {
            "id": "205130308",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "谢谢你，她一定会好起来的。",
            "nextDialogs": [
              "205130309"
            ]
          },
          "205130309": {
            "id": "205130309",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "我一直这么相信。"
          }
        }
      }
    }
  ]

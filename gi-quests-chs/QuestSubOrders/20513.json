  "subQuests": [
    {
      "subId": "2051301",
      "subQuestName": "与安东尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205130101"
        ],
        "dialogs": {
          "205130101": {
            "id": "205130101",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "这次的还挺正常…",
            "nextDialogs": [
              "205130102"
            ]
          },
          "205130102": {
            "id": "205130102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你这不是挺好的吗？",
            "nextDialogs": [
              "205130103"
            ]
          },
          "205130103": {
            "id": "205130103",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "是啊，哎呀，果然是我自己吓自己…",
            "nextDialogs": [
              "205130104"
            ]
          },
          "205130104": {
            "id": "205130104",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "安娜的身子也逐渐有起色了，那位神医真是有本事啊。",
            "nextDialogs": [
              "205130105"
            ]
          },
          "205130105": {
            "id": "205130105",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你愿意的话，能接着帮我找药吗？这次是「被风史莱姆吹拂过的风车菊」。",
            "nextDialogs": [
              "205130107",
              "205130112",
              "205130116"
            ]
          },
          "205130107": {
            "id": "205130107",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "嗯…风车菊倒是偶尔会被做成药，不过都是治疗一些轻症…",
            "nextDialogs": [
              "205130108"
            ]
          },
          "205130108": {
            "id": "205130108",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "难道风史莱姆才是关键，但风车菊和风史莱姆可不会经常凑在一起。",
            "nextDialogs": [
              "205130109"
            ]
          },
          "205130109": {
            "id": "205130109",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "还好杰克说他见过几次这种情况，把大概位置也告诉了我。我把最近的一个地方标在你的地图上吧。",
            "nextDialogs": [
              "205130110"
            ]
          },
          "205130110": {
            "id": "205130110",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "我可不会对付风史莱姆，它们会飞的…所以，只能拜托你了！"
          },
          "205130112": {
            "id": "205130112",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "谁说不是呢。但风车菊和风史莱姆可不会经常凑在一起。",
            "nextDialogs": [
              "205130113"
            ]
          },
          "205130113": {
            "id": "205130113",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "还好杰克说他见过几次这种情况，把大概位置也告诉了我。我把最近的一个地方给你标上。",
            "nextDialogs": [
              "205130114"
            ]
          },
          "205130114": {
            "id": "205130114",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "我实在是不会对付风史莱姆，它们会飞的。所以，就拜托你了！"
          },
          "205130116": {
            "id": "205130116",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "我说啊，你纯粹就是想看热闹吧。",
            "nextDialogs": [
              "205130117"
            ]
          },
          "205130117": {
            "id": "205130117",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "不过，风车菊和风史莱姆确实不会经常凑在一起。",
            "nextDialogs": [
              "205130118"
            ]
          },
          "205130118": {
            "id": "205130118",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "还好杰克说他见过几次这种情况，把大概位置也告诉了我。我把最近的一个地方给你标上。",
            "nextDialogs": [
              "205130119"
            ]
          },
          "205130119": {
            "id": "205130119",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "如果实在找不到。那你就抓个风史莱姆回来吧！为了安娜，我什么都会做…"
          }
        }
      }
    },
    {
      "subId": "2051302",
      "subQuestName": "取得「被风史莱姆吹拂过的风车菊」",
      "sceneId": null,
      "locations": [],

    {
      "subId": "39807",
      "subQuestName": "前往猎鹿人餐馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3980701"
        ],
        "dialogs": {
          "3980701": {
            "id": "3980701",
            "speakerId": 1419,
            "speakerName": "莎拉",
            "text": "啊，客人今天要点些什么？",
            "nextDialogs": [
              "3980702"
            ]
          },
          "3980702": {
            "id": "3980702",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "唉…真是无情啊，就这样无视了我这个「挚友」吗？",
            "nextDialogs": [
              "3980704",
              "3980706"
            ]
          },
          "3980704": {
            "id": "3980704",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哈哈哈…看来大战之后，你不仅是实力成长了，还具备了骑士「幽默」的美德。",
            "nextDialogs": [
              "3980707"
            ]
          },
          "3980707": {
            "id": "3980707",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "蒙德的新晋英雄站在我的面前，身为骑士，感觉真是士气大振啊。",
            "nextDialogs": [
              "3980708"
            ]
          },
          "3980708": {
            "id": "3980708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "凯亚又在花言巧语了。",
            "nextDialogs": [
              "3980709"
            ]
          },
          "3980709": {
            "id": "3980709",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哈哈，我说的可都是真心话。"
          },
          "3980706": {
            "id": "3980706",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哦~我的热情得到回应了，这就是真诚的魅力吧。"
          }
        }
      }
    },

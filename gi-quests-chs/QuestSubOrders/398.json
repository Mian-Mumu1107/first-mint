    {
      "subId": "39809",
      "subQuestName": "与安柏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3980901"
        ],
        "dialogs": {
          "3980901": {
            "id": "3980901",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "既然龙灾已经告一段落，你们接下来有什么安排呢？",
            "nextDialogs": [
              "3980902"
            ]
          },
          "3980902": {
            "id": "3980902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#大概会离开蒙德，继续以走遍七国为目标，寻找{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}亲人的线索吧。",
            "nextDialogs": [
              "3980903"
            ]
          },
          "3980903": {
            "id": "3980903",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "这样啊…那也就是说要暂时分别了吗…",
            "nextDialogs": [
              "3980906"
            ]
          },
          "3980906": {
            "id": "3980906",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "没关系！不管去了哪里，只要是风能够吹到的地方，你永远都是西风骑士团的战友，是荣誉骑士！"
          }
        }
      }
    },
    {
      "subId": "39820",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3982001"
        ],
        "dialogs": {
          "3982001": {
            "id": "3982001",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "唉，真是的…丘丘人进攻的时候不仅琴团长不在，连身为骑兵队长的凯亚，也不知道去哪里了。",
            "nextDialogs": [
              "3982002"
            ]
          },
          "3982002": {
            "id": "3982002",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "好在参战的都是值得信赖的骑士，很好地履行了防御义务。",
            "nextDialogs": [
              "3982003"
            ]
          },
          "3982003": {
            "id": "3982003",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "不过，凯亚应该有他自己的行动理由吧。",
            "nextDialogs": [
              "3982004"
            ]
          },
          "3982004": {
            "id": "3982004",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "我是尽力不会去想「他其实躲在猫尾酒馆喝酒」的可能性啦…"
          }
        }
      }
    },
    {
      "subId": "39821",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3982101"
        ],
        "dialogs": {
          "3982101": {
            "id": "3982101",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "向你致敬，荣誉骑士。",
            "nextDialogs": [
              "3982102"
            ]
          },
          "3982102": {
            "id": "3982102",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "代理团长已经公开讲述了风魔龙事件的经过，真是振奋人心。",
            "nextDialogs": [
              "3982103"
            ]
          },
          "3982103": {
            "id": "3982103",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "想不到真相竟是如此，骑士团差点制定了歼灭计划…现在看来恐怕太武断了。",
            "nextDialogs": [
              "3982104"
            ]
          },
          "3982104": {
            "id": "3982104",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "不过，那些受灾民众，不知道会在什么时候原谅…又会原谅它到什么程度呢…？",
            "nextDialogs": [
              "3982105"
            ]
          },
          "3982105": {
            "id": "3982105",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "总而言之，还是听凭风引吧。"
          }
        }
      }
    },
    {
      "subId": "39822",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3982201"
        ],
        "dialogs": {
          "3982201": {
            "id": "3982201",
            "speakerId": 1441,
            "speakerName": "盖伊",

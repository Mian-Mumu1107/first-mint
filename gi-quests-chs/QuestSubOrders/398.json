    {
      "subId": "39811",
      "subQuestName": "与奥特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3981101"
        ],
        "dialogs": {
          "3981101": {
            "id": "3981101",
            "speakerId": 1162,
            "speakerName": "奥特",
            "text": "明明不是您需要承担的工作，居然还帮助我们打扫了战场…",
            "nextDialogs": [
              "3981102"
            ]
          },
          "3981102": {
            "id": "3981102",
            "speakerId": 1162,
            "speakerName": "奥特",
            "text": "您的这种奉献精神让我自惭形秽。",
            "nextDialogs": [
              "3981103"
            ]
          },
          "3981103": {
            "id": "3981103",
            "speakerId": 1162,
            "speakerName": "奥特",
            "text": "虽说比起您对骑士团的贡献，这点谢礼不值一提…但，还是希望您能收下。"
          }
        }
      }
    },
    {
      "subId": "39801",
      "subQuestName": "与安柏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3980101"
        ],
        "dialogs": {
          "3980101": {
            "id": "3980101",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "啊，是你们！荣誉骑士凯旋归来啦。",
            "nextDialogs": [
              "3980102"
            ]
          },
          "3980102": {
            "id": "3980102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嘿嘿，{NICKNAME}陪特瓦林好好折腾了一番呢。",
            "nextDialogs": [
              "3980103"
            ]
          },
          "3980103": {
            "id": "3980103",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "嗯，你们是昨天回来的吧？琴团长比你们先回蒙德，你们的事迹，她都已经告诉大家了。",
            "nextDialogs": [
              "3980104"
            ]
          },
          "3980104": {
            "id": "3980104",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "呼…我什么时候也能有这样的机会呀…",
            "nextDialogs": [
              "3980106",
              "3980109"
            ]
          },
          "3980106": {
            "id": "3980106",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "不对不对，事情能这样和平解决，是多亏了你们才对。",
            "nextDialogs": [
              "3980107"
            ]
          },
          "3980107": {
            "id": "3980107",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "那时我把你们带来蒙德，也只是普通地尽了侦察骑士的职责而已。",
            "nextDialogs": [
              "3980111"
            ]
          },
          "3980111": {
            "id": "3980111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，不用客气——对了，安柏是在这里等我们吗？",
            "nextDialogs": [
              "3980112"
            ]
          },
          "3980112": {
            "id": "3980112",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "呃，虽然我这次的任务不是出征，但也没那么闲啦…你看，正在忙着做善后工作呢。",
            "nextDialogs": [
              "3980113"
            ]
          },
          "3980113": {
            "id": "3980113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「善后工作」？蒙德城这边发生什么了吗？",
            "nextDialogs": [
              "3980114"
            ]
          },
          "3980114": {
            "id": "3980114",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "嗯…趁我们没有琴团长指挥的时候，附近的魔物向蒙德城发动了「总攻」。",
            "nextDialogs": [
              "3980115"
            ]
          },
          "3980115": {
            "id": "3980115",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "好在很早之前我就侦察到了动向，丘丘人的聚落不自然地向蒙德城附近迁移。",
            "nextDialogs": [
              "3980116"
            ]
          },
          "3980116": {
            "id": "3980116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，我还记得。我们第一次见面的时候，你正在清理其中一个营地…",
            "nextDialogs": [
              "3980117"
            ]
          },
          "3980117": {
            "id": "3980117",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "对，如果不是我们之前早有准备，蒙德城就会陷入危险。"
          },
          "3980109": {
            "id": "3980109",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "啊…说得也对，毕竟和平来之不易嘛。",
            "nextDialogs": [
              "3980110"
            ]
          },
          "3980110": {
            "id": "3980110",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "这次也是多亏了你们，事情才能这样和平解决。"
          }
        }
      }
    },
    {
      "subId": "39802",
      "subQuestName": "途中与市民交谈（塞琉斯）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3980401"
        ],
        "dialogs": {
          "3980401": {
            "id": "3980401",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "来了来了，热闹起来了！",
            "nextDialogs": [
              "3980402"
            ]
          },
          "3980402": {
            "id": "3980402",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "危机啊，灾难啊！冒险啊，热血啊！",
            "nextDialogs": [
              "3980403"
            ]
          },
          "3980403": {
            "id": "3980403",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "冒险家协会！终于！要脱离那些抓猫抓狗的琐碎委托了！新的冒险时代就要来临了！",
            "nextDialogs": [
              "3980404"
            ]
          },
          "3980404": {
            "id": "3980404",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "年轻人啊，快来加入冒险家协会吧！在这动荡的时期，共赴龙灾，拯救蒙德！",
            "nextDialogs": [
              "3980405"
            ]
          },
          "3980405": {
            "id": "3980405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这个嘛…",
            "nextDialogs": [
              "3980406"
            ]
          },
          "3980406": {
            "id": "3980406",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "…啊，你说什么？！",
            "nextDialogs": [
              "3980407"
            ]
          },
          "3980407": {
            "id": "3980407",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "龙灾的问题解决了？我错过了代理团长的演讲？",
            "nextDialogs": [
              "3980408"
            ]
          },
          "3980408": {
            "id": "3980408",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "……",
            "nextDialogs": [
              "3980409"
            ]
          },
          "3980409": {
            "id": "3980409",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "风魔龙为什么不能再坚持一下啊！我们还没出场呢！"
          }
        }
      }
    },
    {
      "subId": "39803",
      "subQuestName": "途中与市民交谈（宁禄）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3980301"
        ],
        "dialogs": {
          "3980301": {
            "id": "3980301",
            "speakerId": 1461,
            "speakerName": "宁禄",
            "text": "谢谢你们！这一切终于真正地结束了。",
            "nextDialogs": [
              "3980302"
            ]
          },
          "3980302": {
            "id": "3980302",
            "speakerId": 1461,
            "speakerName": "宁禄",
            "text": "受龙灾的影响，好多商路都不通了。粮食水果也就算了…酒要是断了货，那可真就要命咯！",
            "nextDialogs": [
              "3980303"
            ]
          },
          "3980303": {
            "id": "3980303",
            "speakerId": 1461,
            "speakerName": "宁禄",
            "text": "我没法想象没有酒喝的日子。",
            "nextDialogs": [
              "3980304"
            ]
          },
          "3980304": {
            "id": "3980304",
            "speakerId": 1461,
            "speakerName": "宁禄",
            "text": "唉，希望商道的修复可以快一些完成吧。"
          }
        }
      }
    },
    {
      "subId": "39804",
      "subQuestName": "途中与市民交谈（葛瑞丝）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3980201"
        ],
        "dialogs": {
          "3980201": {
            "id": "3980201",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "原来是「四风守护」之一的特瓦林大人啊…蒙德人不该忘记他旧日的自我牺牲。",
            "nextDialogs": [
              "3980202"
            ]
          },
          "3980202": {
            "id": "3980202",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "不幸中的万幸，我们与「东风之龙」特瓦林大人的关系，还没有走到不可挽回的地步…",
            "nextDialogs": [
              "3980203"
            ]
          },
          "3980203": {
            "id": "3980203",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "这多亏了你们，还有骑士团的琴团长，真是个虔诚的人呀。",
            "nextDialogs": [
              "3980204"
            ]
          },
          "3980204": {
            "id": "3980204",
            "speakerId": 1429,
            "speakerName": "葛瑞丝",
            "text": "有西风骑士团在的话，今后的蒙德也会一如既往地安宁自由下去吧。"
          }
        }
      }
    },

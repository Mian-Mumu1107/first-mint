            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉已经有一些变化了，接下来只要耐心等待。",
            "nextDialogs": [
              "722390702"
            ]
          },
          "722390702": {
            "id": "722390702",
            "speakerId": 1005,
            "speakerName": "派蒙",

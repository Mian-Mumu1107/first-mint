{
  "lineCounts": {
    "Player": 18,
    "一块古老的石碑": 4,
    "派蒙": 32,
    "阿多尼斯": 39,
    "须婆达之彦": 16,
    "？？？": 36
  },
  "subQuests": [
    {
      "subId": "7223901",
      "subQuestName": "(test)解除祭坛的封印$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722390101"
        ],
        "dialogs": {
          "722390101": {
            "id": "722390101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "孩子们，永远不要放弃，希望就在你们之中…",
            "nextDialogs": [
              "722390102"
            ]
          },
          "722390102": {
            "id": "722390102",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "是你们吗？孩子们，你们成功了吗？",
            "nextDialogs": [
              "722390103"
            ]
          },
          "722390103": {
            "id": "722390103",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "不，不是…我感觉到了，你们不是…",
            "nextDialogs": [
              "722390104"
            ]
          },
          "722390104": {
            "id": "722390104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，他好像个目盲之后被留影的人…",
            "nextDialogs": [
              "722390105"
            ]
          },
          "722390105": {
            "id": "722390105",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "不论你是什么人，请帮帮我！帮我找到孩子们，我有话要告诉他们。",
            "nextDialogs": [
              "722390106"
            ]
          },
          "722390106": {
            "id": "722390106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是，你是谁呢？",
            "nextDialogs": [
              "722390107"
            ]
          },
          "722390107": {
            "id": "722390107",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我…我的名字是…",
            "nextDialogs": [
              "722390108"
            ]
          },
          "722390108": {
            "id": "722390108",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我…忘记了我的名字…",
            "nextDialogs": [
              "722390109"
            ]
          },
          "722390109": {
            "id": "722390109",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我只记得…我曾为白夜国站了出来，为了希望战斗过。",
            "nextDialogs": [
              "722390110"
            ]
          },
          "722390110": {
            "id": "722390110",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我至今仍然是反抗军。",
            "nextDialogs": [
              "722390111"
            ]
          },
          "722390111": {
            "id": "722390111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是在白夜国这样的地底国家，你在反抗什么呢？",
            "nextDialogs": [
              "722390112"
            ]
          },
          "722390112": {
            "id": "722390112",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "当然是庙堂之上污秽的贵人们！",
            "nextDialogs": [
              "722390113"
            ]
          },
          "722390113": {
            "id": "722390113",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "他们号称接收着神明的旨意，嘴上打着神明的旗号，做的事却只为满足他们的低劣欲望。",
            "nextDialogs": [
              "722390114"
            ]
          },
          "722390114": {
            "id": "722390114",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "表面上是太阳之子们的监护者，实际上就是国家的统治者，本质上却是趴在人民身上吸食血肉的虫豸！",
            "nextDialogs": [
              "722390115"
            ]
          },
          "722390115": {
            "id": "722390115",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "他们必须要被消灭。",
            "nextDialogs": [
              "722390116"
            ]
          },
          "722390116": {
            "id": "722390116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些记得这么清楚，却连自己的名字都忘记了…",
            "nextDialogs": [
              "722390117"
            ]
          },
          "722390117": {
            "id": "722390117",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "那是因为他们的手段就是这么残忍！",
            "nextDialogs": [
              "722390118"
            ]
          },
          "722390118": {
            "id": "722390118",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "因为上次的失败，他们抓住了我，将我囚禁在这处祭坛里折磨。",
            "nextDialogs": [
              "722390119"
            ]
          },
          "722390119": {
            "id": "722390119",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "这是一个恶毒的囚牢，我能感觉到，我的灵魂被碾磨，有珍贵的东西在流失…",
            "nextDialogs": [
              "722390120"
            ]
          },
          "722390120": {
            "id": "722390120",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "善良的人啊，我恳求你，趁我还记得这些，请去帮我找到孩子们！",
            "nextDialogs": [
              "722390121"
            ]
          },
          "722390121": {
            "id": "722390121",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "告诉他们，永远不要放弃，希望就在他们之中…",
            "nextDialogs": [
              "722390122"
            ]
          },
          "722390122": {
            "id": "722390122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "孩子们？",
            "nextDialogs": [
              "722390123"
            ]
          },
          "722390123": {
            "id": "722390123",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "有一批愿意跟随我的青年人，他们很聪明。他们是我的学生，也是我们的后备军。我把他们看作是我的孩子。",
            "nextDialogs": [
              "722390124"
            ]
          },
          "722390124": {
            "id": "722390124",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "邪恶的大人们想尽各种办法要撬开我的嘴，让我交代孩子们的情报，我不可能开口。",
            "nextDialogs": [
              "722390125"
            ]
          },
          "722390125": {
            "id": "722390125",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "因为我知道，希望就在他们之中…",
            "nextDialogs": [
              "722390126"
            ]
          },
          "722390126": {
            "id": "722390126",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在这个时间点，他们应该都不在了吧…",
            "nextDialogs": [
              "722390127"
            ]
          },
          "722390127": {
            "id": "722390127",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "不，不会的！他们都是好孩子，一样怀揣着理想。",
            "nextDialogs": [
              "722390128"
            ]
          },
          "722390128": {
            "id": "722390128",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我都没有放弃…他们一定还在坚持。",
            "nextDialogs": [
              "722390129"
            ]
          },
          "722390129": {
            "id": "722390129",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应该如何找到他们？",
            "nextDialogs": [
              "722390130"
            ]
          },
          "722390130": {
            "id": "722390130",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我肯定记得，这种事我肯定记得…",
            "nextDialogs": [
              "722390131"
            ]
          },
          "722390131": {
            "id": "722390131",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我告诉你他们的藏身处。",
            "nextDialogs": [
              "722390132"
            ]
          },
          "722390132": {
            "id": "722390132",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是如果找到了他们，要怎样说明来意呢？",
            "nextDialogs": [
              "722390133"
            ]
          },
          "722390133": {
            "id": "722390133",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「我们是一位忘记名字的反抗军大叔派来的」？",
            "nextDialogs": [
              "722390134"
            ]
          },
          "722390134": {
            "id": "722390134",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "不，这还不够，我把他们教得很好。除非你们能够证明自己，否则他们绝对不会信任你们。",
            "nextDialogs": [
              "722390135"
            ]
          },
          "722390135": {
            "id": "722390135",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "但我现在却连名字都想不起来了，可恶啊…",
            "nextDialogs": [
              "722390136"
            ]
          },
          "722390136": {
            "id": "722390136",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，这位大叔看起来曾经是白夜国的重犯。怎么说也是个历史里能留名的级别了。",
            "nextDialogs": [
              "722390137"
            ]
          },
          "722390137": {
            "id": "722390137",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他的线索应该不难找到吧，说不定附近就有。我们可以先找找看。",
            "nextDialogs": [
              "722390138"
            ]
          },
          "722390138": {
            "id": "722390138",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "如果在历史里留下名字，我希望这名字让我们事业的后继者来书写。"
          }
        }
      }
    },
    {
      "subId": "7223902",
      "subQuestName": "和祭坛中出现的残影对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7223903",
      "subQuestName": "帮助残影寻找身份的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722392401"
        ],
        "dialogs": {
          "722392401": {
            "id": "722392401",
            "speakerId": 20489,
            "speakerName": "一块古老的石碑",
            "text": "（墓石上的字分为两排，其中，第一排以白夜国文写就，无法辨认。）",
            "nextDialogs": [
              "722392402"
            ]
          },
          "722392402": {
            "id": "722392402",
            "speakerId": 20489,
            "speakerName": "一块古老的石碑",
            "text": "（第二排为通用文字，上面写着：）",
            "nextDialogs": [
              "722392403"
            ]
          },
          "722392403": {
            "id": "722392403",
            "speakerId": 20489,
            "speakerName": "一块古老的石碑",
            "text": "「义士斯巴达克，今称『须婆达之彦』，之凭吊处。以下为其罪诏之翻译。望参观诸君谨记历史。」",
            "nextDialogs": [
              "722392404"
            ]
          },
          "722392404": {
            "id": "722392404",
            "speakerId": 20489,
            "speakerName": "一块古老的石碑",
            "text": "「贼子须婆达之彦，兴大罪之师，动国之根基。今奉常世大神谕，抉其目，菹其魂，羁幻之重狱，永生永世。」"
          }
        }
      }
    },
    {
      "subId": "7223920",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722391301"
        ],
        "dialogs": {
          "722391301": {
            "id": "722391301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…这上面提到了一些名字，贼子须、婆达之彦？",
            "nextDialogs": [
              "722391302"
            ]
          },
          "722391302": {
            "id": "722391302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦——应该是贼子…须婆达之彦！难道这就是大叔的名字？我们快回去问问看大叔！"
          }
        }
      }
    },
    {
      "subId": "7223904",
      "subQuestName": "向残影回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722390301"
        ],
        "dialogs": {
          "722390301": {
            "id": "722390301",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你们…你们是谁？你们的声音有熟悉的感觉…",
            "nextDialogs": [
              "722390302"
            ]
          },
          "722390302": {
            "id": "722390302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这么快把我们忘了...大叔的状况已经这么差了吗？好担心…",
            "nextDialogs": [
              "722390303"
            ]
          },
          "722390303": {
            "id": "722390303",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "谢谢，我们真的认识吗？",
            "nextDialogs": [
              "722390306"
            ]
          },
          "722390306": {
            "id": "722390306",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "啊，我想起来了…在这里灵魂会被磨损，我的记忆衰退太严重了。",
            "nextDialogs": [
              "722390307"
            ]
          },
          "722390307": {
            "id": "722390307",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "抱歉，我…唉！",
            "nextDialogs": [
              "722390308"
            ]
          },
          "722390308": {
            "id": "722390308",
            "speakerId": 20344,
            "speakerName": "须婆达之彦",
            "text": "你们找到了有用的信息吗？"
          }
        }
      }
    },
    {
      "subId": "7223905",
      "subQuestName": "前往「孩子们的藏身处」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722390501"
        ],
        "dialogs": {
          "722390501": {
            "id": "722390501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有空的话，我们去制作一些龙骨花凝珠看看吧？",
            "nextDialogs": [
              "722390502"
            ]
          },
          "722390502": {
            "id": "722390502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还没听说过这么神奇的东西呢。"
          }
        }
      }
    },
    {
      "subId": "7223906",
      "subQuestName": "和藏身处的残影对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722391901"
        ],
        "dialogs": {
          "722391901": {
            "id": "722391901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "黑暗来自太阳之后…",
            "nextDialogs": [
              "722391902"
            ]
          },
          "722391902": {
            "id": "722391902",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "光明藏于你我之中…",
            "nextDialogs": [
              "722391903"
            ]
          },
          "722391903": {
            "id": "722391903",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "呼——我快都忘了，有多久没有听到这句话了。",
            "nextDialogs": [
              "722391904"
            ]
          },
          "722391904": {
            "id": "722391904",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "告诉我，好同志，谁派你来的？",
            "nextDialogs": [
              "722391905"
            ]
          },
          "722391905": {
            "id": "722391905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "须婆达之彦。",
            "nextDialogs": [
              "722391906"
            ]
          },
          "722391906": {
            "id": "722391906",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "斯巴达克老师？！是老师吗？！",
            "nextDialogs": [
              "722391907"
            ]
          },
          "722391907": {
            "id": "722391907",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "他在哪里？我只知道他在动乱里被太阳之子的党羽抓住了。之后就再也没有他的消息了。",
            "nextDialogs": [
              "722391908"
            ]
          },
          "722391908": {
            "id": "722391908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他被关在蛇心之地的祭坛…以他的状态恐怕出不来了，所以拜托我们来寻找你们。",
            "nextDialogs": [
              "722391909"
            ]
          },
          "722391909": {
            "id": "722391909",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "该死的太阳之子…",
            "nextDialogs": [
              "722391910"
            ]
          },
          "722391910": {
            "id": "722391910",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "老师让你们来有什么吩咐吗？",
            "nextDialogs": [
              "722391911"
            ]
          },
          "722391911": {
            "id": "722391911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "大叔只让我们传句话啦，他说——",
            "nextDialogs": [
              "722391912"
            ]
          },
          "722391912": {
            "id": "722391912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "孩子们，永远不要放弃，白夜国的希望就在你们之中。",
            "nextDialogs": [
              "722391913"
            ]
          },
          "722391913": {
            "id": "722391913",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "……",
            "nextDialogs": [
              "722391914"
            ]
          },
          "722391914": {
            "id": "722391914",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "……",
            "nextDialogs": [
              "722391915"
            ]
          },
          "722391915": {
            "id": "722391915",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "对不起…对不起！老师，我们让您失望了！",
            "nextDialogs": [
              "722391916"
            ]
          },
          "722391916": {
            "id": "722391916",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "722391917"
            ]
          },
          "722391917": {
            "id": "722391917",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "反抗军已经不存在了…",
            "nextDialogs": [
              "722391918"
            ]
          },
          "722391918": {
            "id": "722391918",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸——",
            "nextDialogs": [
              "722391919"
            ]
          },
          "722391919": {
            "id": "722391919",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "老师被抓走之后，反抗军的骨干基本全军覆没。",
            "nextDialogs": [
              "722391920"
            ]
          },
          "722391920": {
            "id": "722391920",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "只剩我们这些平时跟随老师的学生，因为远离事件中央而逃过一劫。",
            "nextDialogs": [
              "722391921"
            ]
          },
          "722391921": {
            "id": "722391921",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "之后我们这些幸存者逃到了之前准备的藏身处里，希望能够重新聚集起力量。",
            "nextDialogs": [
              "722391922"
            ]
          },
          "722391922": {
            "id": "722391922",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "我们当中本来有杰出的谋士、有专业的学者、有优秀的术士，还有可靠的医生…",
            "nextDialogs": [
              "722391923"
            ]
          },
          "722391923": {
            "id": "722391923",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来很有希望的啊…",
            "nextDialogs": [
              "722391924"
            ]
          },
          "722391924": {
            "id": "722391924",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "我们也是这样想的，只要给我们时间，我们就能重新组织起有生力量。",
            "nextDialogs": [
              "722391925"
            ]
          },
          "722391925": {
            "id": "722391925",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "但这些需要资金…开展任何活动都要资金，我们什么都有，就是没有钱…",
            "nextDialogs": [
              "722391926"
            ]
          },
          "722391926": {
            "id": "722391926",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "最后有人提出了建议——贩卖龙骨花凝珠。",
            "nextDialogs": [
              "722391927"
            ]
          },
          "722391927": {
            "id": "722391927",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "龙骨花凝珠是什么？",
            "nextDialogs": [
              "722391928"
            ]
          },
          "722391928": {
            "id": "722391928",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "是龙骨花在特殊情况下结出的一种果实，十分罕见。",
            "nextDialogs": [
              "722391929"
            ]
          },
          "722391929": {
            "id": "722391929",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "它会产生一种让人神清气爽的香气，使焦虑归于平静，忧患一扫而空。所以在市场上价值很高。",
            "nextDialogs": [
              "722391930"
            ]
          },
          "722391930": {
            "id": "722391930",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的有这么神奇吗？不会是骗人的吧？",
            "nextDialogs": [
              "722391931"
            ]
          },
          "722391931": {
            "id": "722391931",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "如果只是神奇就好了…愚钝的我，最初没有看清这里面的危机。",
            "nextDialogs": [
              "722391932"
            ]
          },
          "722391932": {
            "id": "722391932",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "我已经不记得配方是从哪里得到的了，只知道，这东西确实给我们带来了很多资金。",
            "nextDialogs": [
              "722391933"
            ]
          },
          "722391933": {
            "id": "722391933",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "一切都在往好的方向发展…可慢慢地，我发现我的一些战友们，居然开始回避冲突，拒绝战斗…",
            "nextDialogs": [
              "722391934"
            ]
          },
          "722391934": {
            "id": "722391934",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "这些人越来越多，到了后面，甚至还向我请愿，要脱离我们的队伍，而我根本挽留不住…",
            "nextDialogs": [
              "722391935"
            ]
          },
          "722391935": {
            "id": "722391935",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么会这样？是不是因为卖凝珠赚到太多钱了，就不想打仗了…",
            "nextDialogs": [
              "722391948"
            ]
          },
          "722391948": {
            "id": "722391948",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "你说是金钱的腐蚀吗？不...我…我不知道。",
            "nextDialogs": [
              "722391949"
            ]
          },
          "722391949": {
            "id": "722391949",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "我只知道，当不甘压迫的人们变得满足，反抗就无法继续下去。",
            "nextDialogs": [
              "722391936"
            ]
          },
          "722391936": {
            "id": "722391936",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "崩塌从那时就开始了，而且无可挽回。",
            "nextDialogs": [
              "722391947"
            ]
          },
          "722391947": {
            "id": "722391947",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "我有时甚至在想，这东西的配方，会不会就是那些卑鄙的大人故意流传给我们的...",
            "nextDialogs": [
              "722391950"
            ]
          },
          "722391950": {
            "id": "722391950",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "这东西的畅销，会不会也是那些卑鄙的大人一手捏造的假象？",
            "nextDialogs": [
              "722391937"
            ]
          },
          "722391937": {
            "id": "722391937",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "唉，如果是老师，他会怎么处理这种局面呢，会不会在最开始就把一切扼杀？",
            "nextDialogs": [
              "722391938"
            ]
          },
          "722391938": {
            "id": "722391938",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "对不起老师，我们没能成为希望…",
            "nextDialogs": [
              "722391941"
            ]
          },
          "722391941": {
            "id": "722391941",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "我无颜面对我的老师…",
            "nextDialogs": [
              "722391942"
            ]
          },
          "722391942": {
            "id": "722391942",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "但无论如何，还是感谢你们带来了老师的消息。",
            "nextDialogs": [
              "722391943"
            ]
          },
          "722391943": {
            "id": "722391943",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "我没有别的东西能够感谢你，如果不介意的话，请让我把龙骨花凝珠的秘密告诉你。",
            "nextDialogs": [
              "722391944"
            ]
          },
          "722391944": {
            "id": "722391944",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "生产它的特殊条件就是必须用常夜灵川——也就是忘川的水来浇灌龙骨花。",
            "nextDialogs": [
              "722391945"
            ]
          },
          "722391945": {
            "id": "722391945",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "也许你们可以拿去换点金钱，或者自己留着。",
            "nextDialogs": [
              "722391946"
            ]
          },
          "722391946": {
            "id": "722391946",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "但不论如何，希望你们保护好自己向前的心。"
          }
        }
      }
    },

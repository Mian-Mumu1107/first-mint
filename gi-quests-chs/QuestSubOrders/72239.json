            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个就是忘川之水吗…",
            "nextDialogs": [
              "722390602"
            ]
          },
          "722390602": {
            "id": "722390602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看起来平平无奇，怎么也不像有那种魔力…",
            "nextDialogs": [
              "722390603"
            ]
          },
          "722390603": {
            "id": "722390603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总之先拿去试试吧。"
          }
        }
      }
    },

    {
      "subId": "7223918",
      "subQuestName": "获取龙骨花凝珠",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722391801"
        ],
        "dialogs": {
          "722391801": {
            "id": "722391801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "光明来自太阳之后…",
            "nextDialogs": [
              "722391802"
            ]
          },
          "722391802": {
            "id": "722391802",
            "speakerId": 20352,
            "speakerName": "阿多尼斯",
            "text": "什么和什么啊，赶紧走开！"
          }
        }
      }
    },
    {
      "subId": "7223919",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722391001"
        ],
        "dialogs": {
          "722391001": {
            "id": "722391001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "龙骨花凝珠就是这个吗，看起来就很一般般嘛…",
            "nextDialogs": [
              "722391002"
            ]
          },
          "722391002": {
            "id": "722391002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么也不像说的那么神奇，感觉没什么用的样子，真的能卖钱吗？",
            "nextDialogs": [
              "722391003"
            ]
          },
          "722391003": {
            "id": "722391003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们要不去各地的商店问问吧？他们比较有见识，像蒙德的荣光之风、璃月的希古居，还有稻妻的根付之源…",
            "nextDialogs": [
              "722391004"
            ]
          },
          "722391004": {
            "id": "722391004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "希望能换点钱来买好吃的…"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7151201",
      "subQuestName": "与诏勤对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715120101"
        ],
        "dialogs": {
          "715120101": {
            "id": "715120101",
            "speakerId": 1000,
            "speakerName": "诏勤",
            "text": "真是…这个地区清理过了吗？呃…应该清理过了…",
            "nextDialogs": [
              "715120102"
            ]
          },
          "715120102": {
            "id": "715120102",
            "speakerId": 1000,
            "speakerName": "诏勤",
            "text": "哎哟，真是头疼…",
            "nextDialogs": [
              "715120103"
            ]
          },
          "715120103": {
            "id": "715120103",
            "speakerId": 1000,
            "speakerName": "诏勤",
            "text": "呃…你是…旅行者！抱歉抱歉，我忙昏头了，没看见你来了。",
            "nextDialogs": [
              "715120104"
            ]
          },
          "715120104": {
            "id": "715120104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你这是在忙什么呢？",
            "nextDialogs": [
              "715120105"
            ]
          },
          "715120105": {
            "id": "715120105",
            "speakerId": 1000,
            "speakerName": "诏勤",
            "text": "咳，是这样，今年海灯节，我们璃月港冒险家协会将在总务司的调度下，做一些协助工作。",
            "nextDialogs": [
              "715120106"
            ]
          },
          "715120106": {
            "id": "715120106",
            "speakerId": 1000,
            "speakerName": "诏勤",
            "text": "千岩军主要负责城内和一些重点区域的巡逻，而咱们嘛，就负责去野外清扫一些流窜的魔物…还有驱赶那些没事找事的贼匪。",
            "nextDialogs": [
              "715120107"
            ]
          },
          "715120107": {
            "id": "715120107",
            "speakerId": 1000,
            "speakerName": "诏勤",
            "text": "对了…说起来，你也是在协会里注册过的冒险家啊，我可是听说过不少你的冒险事迹啊。",
            "nextDialogs": [
              "715120108"
            ]
          },
          "715120108": {
            "id": "715120108",
            "speakerId": 1000,
            "speakerName": "诏勤",
            "text": "如果愿意的话，你也来帮我们一把，怎么样？",
            "nextDialogs": [
              "715120111"
            ]
          },
          "715120111": {
            "id": "715120111",
            "speakerId": 1000,
            "speakerName": "诏勤",
            "text": "咳，这个…因为是在节日期间协助总务司勤务，所以总务司也拨给了我们一批特别款项。",
            "nextDialogs": [
              "715120112"
            ]
          },
          "715120112": {
            "id": "715120112",
            "speakerId": 1000,
            "speakerName": "诏勤",
            "text": "愿意接受此类委托的冒险家，在完成委托后可以拿到更多的报酬…"
          }
        }
      }
    }
  ]
}
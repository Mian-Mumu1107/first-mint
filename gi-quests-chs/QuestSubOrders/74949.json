        "dialogs": {
          "749490101": {
            "id": "749490101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "新的航路？",
            "nextDialogs": [
              "749490102"
            ]
          },
          "749490102": {
            "id": "749490102",
            "speakerId": 5353,
            "speakerName": "福斯卡里",
            "text": "总是有人说什么为大家的幸福着想，小镇的宁静不能被破坏。",
            "nextDialogs": [
              "749490103"
            ]
          },
          "749490103": {
            "id": "749490103",
            "speakerId": 5353,
            "speakerName": "福斯卡里",
            "text": "哼！这种自以为幸福的人才是这个世界上最愚蠢的人。",
            "nextDialogs": [
              "749490104"
            ]
          },
          "749490104": {
            "id": "749490104",
            "speakerId": 5353,
            "speakerName": "福斯卡里",
            "text": "他们以为自己是多么满足，那只是因为他们对外界一无所知，有识之士早就无法忍受这种愚昧的幸福了。",
            "nextDialogs": [
              "749490105"
            ]
          },
          "749490105": {
            "id": "749490105",
            "speakerId": 5353,
            "speakerName": "福斯卡里",
            "text": "每个人都应该有追求自己幸福的权利，佩特莉可镇不能仅仅是一个被人遗忘的古老小镇。",
            "nextDialogs": [
              "749490106"
            ]
          },
          "749490106": {
            "id": "749490106",
            "speakerId": 5353,
            "speakerName": "福斯卡里",
            "text": "我要和刺玫会打通关系，引进合作，让小镇成为船运航线上的重要贸易中转站，焕发新生机…"
          }
        }
      }
    }
  ]
}
    {
      "subId": "801211",
      "subQuestName": "与埃德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80120701"
        ],
        "dialogs": {
          "80120701": {
            "id": "80120701",
            "speakerId": 13174,
            "speakerName": "埃德",
            "text": "…哈哈，没错，就是这样…",
            "nextDialogs": [
              "80120702"
            ]
          },
          "80120702": {
            "id": "80120702",
            "speakerId": 13174,
            "speakerName": "埃德",
            "text": "我终于弄明白了…",
            "nextDialogs": [
              "80120703"
            ]
          },
          "80120703": {
            "id": "80120703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（我…刚刚昏过去了么，隐约记得卡利贝尔摘下了面具，然后…）",
            "nextDialogs": [
              "80120704"
            ]
          },
          "80120704": {
            "id": "80120704",
            "speakerId": 13174,
            "speakerName": "埃德",
            "text": "啊，你醒了，旅行者…我正想跟你分享这份喜悦呢！",
            "nextDialogs": [
              "80120705"
            ]
          },
          "80120705": {
            "id": "80120705",
            "speakerId": 13174,
            "speakerName": "埃德",
            "text": "哦，不对…没必要叫你什么「旅行者」了，我早就认出你了。",
            "nextDialogs": [
              "80120708"
            ]
          },
          "80120708": {
            "id": "80120708",
            "speakerId": 13174,
            "speakerName": "埃德",
            "text": "呵呵…我原本就认识你啊，只不过是在聊天的过程中逐渐确认是你罢了。",
            "nextDialogs": [
              "80120709"
            ]
          },
          "80120709": {
            "id": "80120709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可我之前并不认识你…",
            "nextDialogs": [
              "80120710"
            ]
          },
          "80120710": {
            "id": "80120710",
            "speakerId": 13174,
            "speakerName": "埃德",
            "text": "这很正常，你是那样高贵，怎么可能认识我们所有人。",
            "nextDialogs": [
              "80120711"
            ]
          },
          "80120711": {
            "id": "80120711",
            "speakerId": 13174,
            "speakerName": "埃德",
            "text": "而且…从一开始我就用了假名，埃德是我曾经的侍从的名字…",
            "nextDialogs": [
              "80120712"
            ]
          },
          "80120712": {
            "id": "80120712",
            "speakerId": 13174,
            "speakerName": "埃德",
            "text": "而我真正的名字是克洛达尔…",
            "nextDialogs": [
              "80120713"
            ]
          },
          "80120713": {
            "id": "80120713",
            "speakerId": 1005,
            "speakerName": "克洛达尔",
            "text": "…克洛达尔·亚尔伯里奇。"
          }
        }
      }
    },
    {
      "subId": "801213",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80120801"
        ],
        "dialogs": {
          "80120801": {
            "id": "80120801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#…醒了，太好了，{NICKNAME}醒了！",
            "nextDialogs": [
              "80120802"
            ]
          },
          "80120802": {
            "id": "80120802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#可担心死我了…{NICKNAME}？",
            "nextDialogs": [
              "80120803"
            ]
          },
          "80120803": {
            "id": "80120803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "80120804"
            ]
          },
          "80120804": {
            "id": "80120804",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "你昏迷的时候，发生了什么？",
            "nextDialogs": [
              "80120805"
            ]
          },
          "80120805": {
            "id": "80120805",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "我已经调查过附近的地脉了，似乎曾经受过深渊力量的影响，一直躁动不已…",
            "nextDialogs": [
              "80120806"
            ]
          },
          "80120806": {
            "id": "80120806",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "地脉里毕竟流动着世间的信息与记忆，莫非你看到了什么…",
            "nextDialogs": [
              "80120809"
            ]
          },
          "80120809": {
            "id": "80120809",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "你是说克洛达尔·亚尔伯里奇么…",
            "nextDialogs": [
              "80120810"
            ]
          },
          "80120810": {
            "id": "80120810",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "他创立深渊教团以后，为了自己对深渊的「信仰」而做了许多事。",
            "nextDialogs": [
              "80120811"
            ]
          },
          "80120811": {
            "id": "80120811",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "但最终不死诅咒同时折磨着他的肉体和精神，他信仰的深渊并没有拯救他。",
            "nextDialogs": [
              "80120812"
            ]
          },
          "80120812": {
            "id": "80120812",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "在百年后，他完全变得疯疯癫癫，然后再也不知所踪。",
            "nextDialogs": [
              "80120813"
            ]
          },
          "80120813": {
            "id": "80120813",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",

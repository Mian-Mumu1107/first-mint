    {
      "subId": "801204",
      "subQuestName": "返回埃德的小屋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80120202"
        ],
        "dialogs": {
          "80120202": {
            "id": "80120202",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "怎么回事，卡利贝尔呢！？",
            "nextDialogs": [
              "80120205"
            ]
          },
          "80120205": {
            "id": "80120205",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "不，卡利贝尔…难道有人来过了？",
            "nextDialogs": [
              "80120206"
            ]
          },
          "80120206": {
            "id": "80120206",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "不对，门没被破坏，周围好像也没有任何其他人留下的痕迹…"
          }
        }
      }
    },
    {
      "subId": "801215",

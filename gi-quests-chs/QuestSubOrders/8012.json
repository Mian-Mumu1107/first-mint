            "id": "80120301",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "是丝巾，我给他绑的丝巾掉在这里了。",
            "nextDialogs": [
              "80120302"
            ]
          },
          "80120302": {
            "id": "80120302",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "看样子是这个方向，继续追。"
          }
        }
      }
    },

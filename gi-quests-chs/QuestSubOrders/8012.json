    {
      "subId": "801207",
      "subQuestName": "与巡林员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80120401"
        ],
        "dialogs": {
          "80120401": {
            "id": "80120401",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "巡林员…不好…",
            "nextDialogs": [
              "80120402"
            ]
          },
          "80120402": {
            "id": "80120402",
            "speakerId": 13078,
            "speakerName": "巡林员",
            "text": "喂，你们是什么人，怎么好像没见过你们，在这里干什么？",
            "nextDialogs": [
              "80120403"
            ]
          },
          "80120403": {
            "id": "80120403",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "你们见到丘丘人了么？从这个方向过去的丘丘人？",
            "nextDialogs": [
              "80120404"
            ]
          },
          "80120404": {
            "id": "80120404",
            "speakerId": 13078,
            "speakerName": "巡林员",
            "text": "先回答我的问题…不要自找麻烦！",
            "nextDialogs": [
              "80120405"
            ]
          },
          "80120405": {
            "id": "80120405",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "我问你！有没有！见到丘丘人！",
            "nextDialogs": [
              "80120406"
            ]
          },
          "80120406": {
            "id": "80120406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "埃德…",
            "nextDialogs": [
              "80120407"
            ]
          },
          "80120407": {
            "id": "80120407",
            "speakerId": 13078,
            "speakerName": "巡林员",
            "text": "你…你干什么啊，有什么好激动的…",
            "nextDialogs": [
              "80120408"
            ]
          },
          "80120408": {
            "id": "80120408",
            "speakerId": 13078,
            "speakerName": "巡林员",
            "text": "丘丘人不是随处可见吗？当然见到过了…",
            "nextDialogs": [
              "80120409"
            ]
          },
          "80120409": {
            "id": "80120409",
            "speakerId": 13079,
            "speakerName": "巡林护卫",
            "text": "是啊，就刚才，我们还在那边解决掉了几个，愣头愣脑的…",
            "nextDialogs": [
              "80120410"
            ]
          },
          "80120410": {
            "id": "80120410",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "你们…你们…！",
            "nextDialogs": [
              "80120411"
            ]
          },
          "80120411": {
            "id": "80120411",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "该死的巡林员，该死的七神子民！给我为卡利贝尔偿命！",
            "nextDialogs": [
              "80120412"
            ]
          },
          "80120412": {
            "id": "80120412",
            "speakerId": 13078,
            "speakerName": "巡林员",
            "text": "你…！口出狂言的外国人，是在挑衅我们巡林员么！",
            "nextDialogs": [
              "80120501"
            ]
          },
          "80120501": {
            "id": "80120501",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "你们这些巡林员…",
            "nextDialogs": [
              "80120515"
            ]
          },
          "80120515": {
            "id": "80120515",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "在你的规劝下，双方暂时冷静了下来…",
            "nextDialogs": [
              "80120505"
            ]
          },
          "80120505": {
            "id": "80120505",
            "speakerId": 13079,
            "speakerName": "巡林护卫",
            "text": "真搞不明白，我们不过是干掉了几个丘丘人，怎么就发这么大的火…不可理喻…",
            "nextDialogs": [
              "80120506"
            ]
          },
          "80120506": {
            "id": "80120506",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "你们…",
            "nextDialogs": [
              "80120507"
            ]
          },
          "80120507": {
            "id": "80120507",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "他才刚刚恢复神智，怎么能就这样…",
            "nextDialogs": [
              "80120508"
            ]
          },
          "80120508": {
            "id": "80120508",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "巡林员…真的、真的都没留手么？对所有见到的丘丘人都下手了么…？",
            "nextDialogs": [
              "80120509"
            ]
          },
          "80120509": {
            "id": "80120509",
            "speakerId": 13079,
            "speakerName": "巡林护卫",
            "text": "好吧，莫名其妙的家伙，非要问的话，我之前自己离队去…去上厕所的时候，刚好撞见一个丘丘人。",
            "nextDialogs": [
              "80120510"
            ]
          },
          "80120510": {
            "id": "80120510",
            "speakerId": 13079,
            "speakerName": "巡林护卫",
            "text": "我一开始很紧张，但后来发现那个丘丘人没什么敌意，只是浑浑噩噩在往…往那个方向走了，我就没管它。",
            "nextDialogs": [
              "80120511"
            ]
          },
          "80120511": {
            "id": "80120511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有希望！",
            "nextDialogs": [
              "80120513"
            ]
          },
          "80120513": {
            "id": "80120513",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "是啊，太好了…太好了…走，我们快过去找他！",
            "nextDialogs": [
              "80120514"
            ]
          },
          "80120514": {
            "id": "80120514",
            "speakerId": 13078,
            "speakerName": "巡林员",
            "text": "喂，就这么走了？你们也太目中无人了吧…"
          }
        }
      }
    },

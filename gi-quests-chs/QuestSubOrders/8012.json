    {
      "subId": "801206",
      "subQuestName": "继续寻找卡利贝尔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80120601"
        ],
        "dialogs": {
          "80120601": {
            "id": "80120601",
            "speakerId": 13076,
            "speakerName": "卡利贝尔",
            "text": "……",
            "nextDialogs": [
              "80120602"
            ]
          },
          "80120602": {
            "id": "80120602",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "卡利贝尔！",
            "nextDialogs": [
              "80120603"
            ]
          },
          "80120603": {
            "id": "80120603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了！",
            "nextDialogs": [
              "80120604"
            ]
          },
          "80120604": {
            "id": "80120604",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "卡利贝尔，别往前走了，是我，是爸爸！",
            "nextDialogs": [
              "80120605"
            ]
          },
          "80120605": {
            "id": "80120605",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "不管你看到了什么，那些…那些都是幻觉，都是骗你的！",
            "nextDialogs": [
              "80120606"
            ]
          },
          "80120606": {
            "id": "80120606",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "爸爸说过了，这里是童话的世界，不是真的。来，快过来，跟我一起回去！",
            "nextDialogs": [
              "80120607"
            ]
          },
          "80120607": {
            "id": "80120607",
            "speakerId": 13076,
            "speakerName": "卡利贝尔",
            "text": "……",
            "nextDialogs": [
              "80120608"
            ]
          },
          "80120608": {
            "id": "80120608",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "卡利贝尔？",
            "nextDialogs": [
              "80120611"
            ]
          },
          "80120611": {
            "id": "80120611",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "怎么回事，他应该已经恢复神智了啊？应该听得懂我说话啊？",
            "nextDialogs": [
              "80120612"
            ]
          },
          "80120612": {
            "id": "80120612",
            "speakerId": 13072,
            "speakerName": "埃德",
            "text": "喂，卡利贝尔，我们回家吧，一起回家，好吗？"
          }
        }
      }
    },

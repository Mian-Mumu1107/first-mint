    {
      "subId": "7211306",
      "subQuestName": "（test）判定大凶成就$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130601"
        ],
        "dialogs": {
          "721130601": {
            "id": "721130601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？这是什么？好像是什么人的手记，我看看…",
            "nextDialogs": [
              "721130602"
            ]
          },
          "721130602": {
            "id": "721130602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「…终末…愚人众…暗算…」",
            "nextDialogs": [
              "721130603"
            ]
          },
          "721130603": {
            "id": "721130603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这是什么呀，乱七八糟的，都是污渍。根本看不清。",
            "nextDialogs": [
              "721130604"
            ]
          },
          "721130604": {
            "id": "721130604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可能是宝藏的线索。",
            "nextDialogs": [
              "721130605"
            ]
          },
          "721130605": {
            "id": "721130605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有道理！我再看看。",
            "nextDialogs": [
              "721130606"
            ]
          },
          "721130606": {
            "id": "721130606",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「…解签的时候，暗号…」",
            "nextDialogs": [
              "721130609"
            ]
          },
          "721130609": {
            "id": "721130609",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我看看…「…上半是『胧夜正中』…」",
            "nextDialogs": [
              "721130610"
            ]
          },
          "721130610": {
            "id": "721130610",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "到这里就断开了，不知道下半是什么。",
            "nextDialogs": [
              "721130611"
            ]
          },
          "721130611": {
            "id": "721130611",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过既然会用到暗号，背后一定隐藏着什么秘密吧？",
            "nextDialogs": [
              "721130612"
            ]
          },
          "721130612": {
            "id": "721130612",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好在意啊。下次去鸣神大社解签的时候，要不要试着对对暗号？"
          }
        }
      }
    },
    {
      "subId": "7211315",

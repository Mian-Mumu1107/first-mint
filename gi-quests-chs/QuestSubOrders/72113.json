  "subQuests": [
    {
      "subId": "7211301",
      "subQuestName": "（test）抽签引导（废弃）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130101"
        ],
        "dialogs": {
          "721130101": {
            "id": "721130101",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "你要求签？",
            "nextDialogs": [
              "721130102"
            ]
          },
          "721130102": {
            "id": "721130102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，好冷淡。",
            "nextDialogs": [
              "721130103"
            ]
          },
          "721130103": {
            "id": "721130103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我想求签…",
            "nextDialogs": [
              "721130104"
            ]
          },
          "721130104": {
            "id": "721130104",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "明白了。流程是这样的。首先请你用力摇晃这个什么东西。",
            "nextDialogs": [
              "721130105"
            ]
          },
          "721130105": {
            "id": "721130105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "记得是叫「御神签箱」…",
            "nextDialogs": [
              "721130106"
            ]
          },
          "721130106": {
            "id": "721130106",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "没错。从里面会掉出一根竹签。把这根竹签给我，我会给你对应的纸片儿。",
            "nextDialogs": [
              "721130107"
            ]
          },
          "721130107": {
            "id": "721130107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好像叫「御神签」来着…",
            "nextDialogs": [
              "721130108"
            ]
          },
          "721130108": {
            "id": "721130108",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "这种事情怎样都好吧。",
            "nextDialogs": [
              "721130109"
            ]
          },
          "721130109": {
            "id": "721130109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我有问题！如果说，如果说我们抽到了凶签，要怎么办呢？",
            "nextDialogs": [
              "721130110"
            ]
          },
          "721130110": {
            "id": "721130110",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "是命运让你抽到凶签，你还想怎样？啊？",
            "nextDialogs": [
              "721130111"
            ]
          },
          "721130111": {
            "id": "721130111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸！",
            "nextDialogs": [
              "721130112"
            ]
          },
          "721130112": {
            "id": "721130112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "外头那个像架子的东西…",
            "nextDialogs": [
              "721130113"
            ]
          },
          "721130113": {
            "id": "721130113",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "啧。",
            "nextDialogs": [
              "721130114"
            ]
          },
          "721130114": {
            "id": "721130114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "她很露骨地「啧」了耶！",
            "nextDialogs": [
              "721130115"
            ]
          },
          "721130115": {
            "id": "721130115",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "我看看…是这样的。「把凶签捆到『御签挂』上，就可以逢凶化吉」。",
            "nextDialogs": [
              "721130116"
            ]
          },
          "721130116": {
            "id": "721130116",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "啊，对哦！如果你抽到凶签，把它捆到那个架子上就行了嘛。",
            "nextDialogs": [
              "721130117"
            ]
          },
          "721130117": {
            "id": "721130117",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "他们还真是…不对，我们「鸣神大社」很温柔的。所以就算抽到了凶签，也会给你们转运的机会。",
            "nextDialogs": [
              "721130118"
            ]
          },
          "721130118": {
            "id": "721130118",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然感觉哪里好像怪怪的…",
            "nextDialogs": [
              "721130119"
            ]
          },
          "721130119": {
            "id": "721130119",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们求签吧！"
          }
        }
      }
    },
    {
      "subId": "7211302",
      "subQuestName": "（test）第一次抽到大吉$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130201"
        ],
        "dialogs": {
          "721130201": {
            "id": "721130201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我瞧瞧我瞧瞧…",
            "nextDialogs": [
              "721130202"
            ]
          },
          "721130202": {
            "id": "721130202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！写着「大吉」耶！",
            "nextDialogs": [
              "721130203"
            ]
          },
          "721130203": {
            "id": "721130203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来今天是派蒙的幸运日！",
            "nextDialogs": [
              "721130204"
            ]
          },
          "721130204": {
            "id": "721130204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的？",
            "nextDialogs": [
              "721130205"
            ]
          },
          "721130205": {
            "id": "721130205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错！你的幸福就是派蒙的幸福呀！所以反过来说，派蒙幸福，你也幸福。",
            "nextDialogs": [
              "721130206"
            ]
          },
          "721130206": {
            "id": "721130206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我吃到好吃的就会幸福。所以，为了你自己的幸福，请给我吃好吃的。"
          }
        }
      }
    },
    {
      "subId": "7211303",
      "subQuestName": "（test）第一次抽到大吉、凶以外的东西1$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130301"
        ],
        "dialogs": {
          "721130301": {
            "id": "721130301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我瞧瞧我瞧瞧…",
            "nextDialogs": [
              "721130302"
            ]
          },
          "721130302": {
            "id": "721130302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，还不错嘛。",
            "nextDialogs": [
              "721130303"
            ]
          },
          "721130303": {
            "id": "721130303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "和派蒙在一起，一定会幸运的！"
          }
        }
      }
    },
    {
      "subId": "7211304",
      "subQuestName": "（test）第一次抽到凶$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130401"
        ],
        "dialogs": {
          "721130401": {
            "id": "721130401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我瞧瞧我瞧瞧…",
            "nextDialogs": [
              "721130402"
            ]
          },
          "721130402": {
            "id": "721130402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，是「凶」！",
            "nextDialogs": [
              "721130403"
            ]
          },
          "721130403": {
            "id": "721130403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这种情况我记得！是说…「把凶签捆到『御签挂』上。」",
            "nextDialogs": [
              "721130404"
            ]
          },
          "721130404": {
            "id": "721130404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「然后请派蒙吃好吃的，就可以逢凶化吉。」",
            "nextDialogs": [
              "721130405"
            ]
          },
          "721130405": {
            "id": "721130405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是这样喔？",
            "nextDialogs": [
              "721130406"
            ]
          },
          "721130406": {
            "id": "721130406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "当然了！你要质疑古人的智慧吗？",
            "nextDialogs": [
              "721130407"
            ]
          },
          "721130407": {
            "id": "721130407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "古人的智慧真了不起哪！总之，先找找御签挂吧！"
          }
        }
      }
    },
    {
      "subId": "7211305",
      "subQuestName": "（test）第一次抽到大吉、凶以外的东西2$HIDDEN",
      "sceneId": null,

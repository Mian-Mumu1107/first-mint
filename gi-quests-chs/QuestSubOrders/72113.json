    {
      "subId": "7211311",
      "subQuestName": "（test）小黑屋Talk$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721131001"
        ],
        "dialogs": {
          "721131001": {
            "id": "721131001",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "你究竟是什么人？想要干什么？",
            "nextDialogs": [
              "721131002"
            ]
          },
          "721131002": {
            "id": "721131002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们才要问呢！玄冬小姐你想干什么，为什么突然袭击我们？",
            "nextDialogs": [
              "721131003"
            ]
          },
          "721131003": {
            "id": "721131003",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "无礼。回答我的问题。",
            "nextDialogs": [
              "721131004"
            ]
          },
          "721131004": {
            "id": "721131004",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我是{NICKNAME}。",
            "nextDialogs": [
              "721131005"
            ]
          },
          "721131005": {
            "id": "721131005",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "我知道你的名字，给我老实说，暗号是从哪听来的？",
            "nextDialogs": [
              "721131007",
              "721131009"
            ]
          },
          "721131007": {
            "id": "721131007",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！你要干什么呀？赶快把实情说出来呀，玄冬小姐已经在瞪我们了！",
            "nextDialogs": [
              "721131010"
            ]
          },
          "721131010": {
            "id": "721131010",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "…原来如此，手记只是你们两个偶然得到的。这样看来，百华她应该已经…",
            "nextDialogs": [
              "721131011"
            ]
          },
          "721131011": {
            "id": "721131011",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「百华」是谁？",
            "nextDialogs": [
              "721131012"
            ]
          },
          "721131012": {
            "id": "721131012",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "是手记的主人，也是我的同僚。不过她现在已经无法履行自己对稻妻的职责了，真是可悲。",
            "nextDialogs": [
              "721131013"
            ]
          },
          "721131013": {
            "id": "721131013",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "哼，我知道你们还有很多疑问，都告诉你们也无妨。",
            "nextDialogs": [
              "721131014"
            ]
          },
          "721131014": {
            "id": "721131014",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "我和百华都是「终末番」的忍者。我们「终末番」会为稻妻扫清有害的异物，而「纸片儿」是我们沟通任务的方式之一。",
            "nextDialogs": [
              "721131015"
            ]
          },
          "721131015": {
            "id": "721131015",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "因此，我们也承受了很多怨恨与危险。比如说，潜伏在稻妻境内那些奇怪又危险的…"
          },
          "721131009": {
            "id": "721131009",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们在一座山头上，找到了一个废弃营地…"
          }
        }
      }
    },
    {
      "subId": "7211305",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130501"
        ],
        "dialogs": {
          "721130501": {
            "id": "721130501",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "把竹签交出来。",
            "nextDialogs": [
              "721130502"
            ]
          },
          "721130502": {
            "id": "721130502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好、好的。",
            "nextDialogs": [
              "721130503"
            ]
          },
          "721130503": {
            "id": "721130503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "神社真是个不讲情面的地方…",
            "nextDialogs": [
              "721130504"
            ]
          },
          "721130504": {
            "id": "721130504",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "给你。",
            "nextDialogs": [
              "721130505"
            ]
          },
          "721130505": {
            "id": "721130505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔呣，看看运势吧。",
            "nextDialogs": [
              "721130506"
            ]
          },
          "721130506": {
            "id": "721130506",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "对了。每天只能求一次签，这点请你记住。",
            "nextDialogs": [
              "721130507"
            ]
          },
          "721130507": {
            "id": "721130507",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "不然我会很累…不对，不然御签挂会挂不下…也不是，应该怎么说来着？",
            "nextDialogs": [
              "721130508"
            ]
          },
          "721130508": {
            "id": "721130508",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "「御神签是神明意志的体现。所以要尊重神明的意志，并且尽人所能及之力。」",
            "nextDialogs": [
              "721130509"
            ]
          },
          "721130509": {
            "id": "721130509",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "你看，写得真好。所以每天只能求一次签，记好了。"
          }
        }
      }
    }
  ]

      }
    },
    {
      "subId": "7211312",
      "subQuestName": "（test）暗号获得回滚隔离$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721131101"
        ],
        "dialogs": {
          "721131101": {
            "id": "721131101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#（喂，{NICKNAME}！）",
            "nextDialogs": [
              "721131102"
            ]
          },
          "721131102": {
            "id": "721131102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（这个玄冬小姐，按照那个玄冬小姐说的…）",
            "nextDialogs": [
              "721131103"
            ]
          },
          "721131103": {
            "id": "721131103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（嗯，愚人众的冒牌货。）",
            "nextDialogs": [
              "721131104"
            ]
          },
          "721131104": {
            "id": "721131104",
            "speakerId": 1002,
            "speakerName": "「玄冬林檎」",
            "text": "啊呀，又见面了。今天也要来看看运势吗？还是说…",
            "nextDialogs": [
              "721131105"
            ]
          },
          "721131105": {
            "id": "721131105",
            "speakerId": 1002,
            "speakerName": "「玄冬林檎」",
            "text": "如果有什么想倾诉、想找人商量的事，我也能听您讲喔。",
            "nextDialogs": [
              "721131108"
            ]
          },
          "721131108": {
            "id": "721131108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "玄冬小姐好亲切喔！",
            "nextDialogs": [
              "721131109"
            ]
          },
          "721131109": {
            "id": "721131109",
            "speakerId": 1002,
            "speakerName": "「玄冬林檎」",
            "text": "是这样吗？呵呵，最近经常有人这么夸我呢。感觉好开心。",
            "nextDialogs": [
              "721131110"
            ]
          },
          "721131110": {
            "id": "721131110",
            "speakerId": 1002,
            "speakerName": "「玄冬林檎」",
            "text": "在这样漂亮的神社工作，一直是我的梦想。",
            "nextDialogs": [
              "721131111"
            ]
          },
          "721131111": {
            "id": "721131111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（她是愚人众假扮的。）",
            "nextDialogs": [
              "721131112"
            ]
          },
          "721131112": {
            "id": "721131112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（唔…但是，她比较亲切耶…）"
          }
        }
      }
    },
    {
      "subId": "7211308",
      "subQuestName": "（test）第一次对暗号获取后Talk第一环$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130801"
        ],
        "dialogs": {
          "721130801": {
            "id": "721130801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？玄冬小姐到哪去了？",
            "nextDialogs": [
              "721130802"
            ]
          },
          "721130802": {
            "id": "721130802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有点担心…",
            "nextDialogs": [
              "721130803"
            ]
          },
          "721130803": {
            "id": "721130803",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是啊，万一她不回来，我要怎么看今天的运势呢。",
            "nextDialogs": [
              "721130804"
            ]
          },
          "721130804": {
            "id": "721130804",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？这里有一张签条。我看看…",
            "nextDialogs": [
              "721130805"
            ]
          },
          "721130805": {
            "id": "721130805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不太好吧…",
            "nextDialogs": [
              "721130806"
            ]
          },
          "721130806": {
            "id": "721130806",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有什么关系嘛！说不定是线索呢！",
            "nextDialogs": [
              "721130807"
            ]
          },
          "721130807": {
            "id": "721130807",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？这是…",
            "nextDialogs": [
              "721130808"
            ]
          },
          "721130808": {
            "id": "721130808",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好像是要我们到这个地方，接受进一步指示的样子…？",
            "nextDialogs": [
              "721130809"
            ]
          },
          "721130809": {
            "id": "721130809",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们去看看吧！"
          }
        }
      }
    },
    {
      "subId": "7211314",
      "subQuestName": "（test）第一次对暗号获取后Talk第二环$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721130701"
        ],
        "dialogs": {
          "721130701": {
            "id": "721130701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "玄冬小姐的态度还是老样子…不管怎样，先看看签文吧。",
            "nextDialogs": [
              "721130702"
            ]
          },
          "721130702": {
            "id": "721130702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？这是…",
            "nextDialogs": [
              "721130703"
            ]
          },
          "721130703": {
            "id": "721130703",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我明白了，这是需要对付的坏蛋吧！",
            "nextDialogs": [
              "721130704"
            ]
          },
          "721130704": {
            "id": "721130704",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯，原来如此。原来玄冬小姐是谍报人员，通过这种方式接头，扫除对稻妻不利的人。",
            "nextDialogs": [
              "721130705"
            ]
          },
          "721130705": {
            "id": "721130705",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "好吵。",
            "nextDialogs": [
              "721130706"
            ]
          },
          "721130706": {
            "id": "721130706",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "噫！对、对不起！不要对我们降下「终末」！",
            "nextDialogs": [
              "721130707"
            ]
          },
          "721130707": {
            "id": "721130707",
            "speakerId": 1000,
            "speakerName": "玄冬林檎",
            "text": "赶紧走开。",
            "nextDialogs": [
              "721130708"
            ]
          },
          "721130708": {
            "id": "721130708",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们这就走！到画里的地方看看，能不能找到目标！"
          }
        }
      }
    },

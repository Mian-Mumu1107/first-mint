  "subQuests": [
    {
      "subId": "7051801",
      "subQuestName": "在佳酿节的会场逛一逛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705180101"
        ],
        "dialogs": {
          "705180101": {
            "id": "705180101",
            "speakerId": 30234,
            "speakerName": "伯恩哈德",
            "text": "请留步！大名鼎鼎的荣誉骑士，还有「提瓦特最好的向导」派蒙！",
            "nextDialogs": [
              "705180102"
            ]
          },
          "705180102": {
            "id": "705180102",
            "speakerId": 30234,
            "speakerName": "伯恩哈德",
            "text": "恳请你们帮我一把！",
            "nextDialogs": [
              "705180103"
            ]
          },
          "705180103": {
            "id": "705180103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫！居然有人会这样叫我？我的名号终于传开了吗？",
            "nextDialogs": [
              "705180140"
            ]
          },
          "705180140": {
            "id": "705180140",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等…我怎么感觉你有点眼熟？",
            "nextDialogs": [
              "705180104"
            ]
          },
          "705180104": {
            "id": "705180104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们在骑士团总部大厅见过。",
            "nextDialogs": [
              "705180105"
            ]
          },
          "705180105": {
            "id": "705180105",
            "speakerId": 30234,
            "speakerName": "伯恩哈德",
            "text": "没错，我是西风骑士伯恩哈德，隶属赫塔队长的后勤小队。",
            "nextDialogs": [
              "705180106"
            ]
          },
          "705180106": {
            "id": "705180106",
            "speakerId": 30234,
            "speakerName": "伯恩哈德",
            "text": "按照基本的礼仪，我应该先和你积累起足够的交情…但时间太紧张了，我只能厚着脸皮求你。",
            "nextDialogs": [
              "705180107"
            ]
          },
          "705180107": {
            "id": "705180107",
            "speakerId": 30234,
            "speakerName": "伯恩哈德",
            "text": "请你帮帮忙吧，拯救这次义卖活动！",
            "nextDialogs": [
              "705180108"
            ]
          },
          "705180108": {
            "id": "705180108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "拯救？",
            "nextDialogs": [
              "705180109"
            ]
          },
          "705180109": {
            "id": "705180109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "义卖活动…好像听琴团长提起过。你遇到什么麻烦了吗？",
            "nextDialogs": [
              "705180110"
            ]
          },
          "705180110": {
            "id": "705180110",
            "speakerId": 30234,
            "speakerName": "伯恩哈德",
            "text": "是这样的，西风骑士团打算在佳酿节期间经营一间店铺…",
            "nextDialogs": [
              "705180111"
            ]
          },
          "705180111": {
            "id": "705180111",
            "speakerId": 30234,
            "speakerName": "伯恩哈德",
            "text": "店铺赚到的钱会被用于慈善事业，提供给生活条件比较艰苦的孩子和老人。",
            "nextDialogs": [
              "705180112"
            ]
          },
          "705180112": {
            "id": "705180112",
            "speakerId": 30234,
            "speakerName": "伯恩哈德",
            "text": "而人选是由抽签决定的，恰巧…就抽到了我。为了不让这次义卖失败，我去请教了许多人，但…",
            "nextDialogs": [
              "705180113"
            ]
          },
          "705180113": {
            "id": "705180113",
            "speakerId": 30234,
            "speakerName": "伯恩哈德",
            "text": "但我平常大多负责仓储和运输工作，就连要卖什么都想了很久，更别提经营店铺了…",
            "nextDialogs": [
              "705180114"
            ]
          },
          "705180114": {
            "id": "705180114",
            "speakerId": 30234,
            "speakerName": "伯恩哈德",
            "text": "所以，我想恳请你们出手帮忙…",
            "nextDialogs": [
              "705180117"
            ]
          },
          "705180117": {
            "id": "705180117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦对哦，你说话不用这么客气啦。",
            "nextDialogs": [
              "705180118"
            ]
          },
          "705180118": {
            "id": "705180118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "按你的说法，义卖活动是为了蒙德的孩子和老人们好嘛，意义重大！",
            "nextDialogs": [
              "705180119"
            ]
          },
          "705180119": {
            "id": "705180119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}是荣誉骑士，我也是骑士团的老朋友了，分担一点责任也不算什么。"
          }
        }
      }
    },
    {
      "subId": "7051804",
      "subQuestName": "与伯恩哈德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7051802",
      "subQuestName": "前往「天使的馈赠」摊位",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705180201"
        ],
        "dialogs": {
          "705180201": {
            "id": "705180201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "格奥尔格先生，你好啊。我们是沙瓦玛先生的代理人，想代他订购50箱「假日果酿」！",
            "nextDialogs": [
              "705180202"
            ]
          },
          "705180202": {
            "id": "705180202",
            "speakerId": 30235,
            "speakerName": "格奥尔格",
            "text": "哦？沙瓦玛先生吗？他是我的熟客了，订货的数量很少有变化…",
            "nextDialogs": [
              "705180203"
            ]
          },
          "705180203": {
            "id": "705180203",
            "speakerId": 30235,
            "speakerName": "格奥尔格",
            "text": "言归正传，今年你们打算出多少价钱？"
          }
        }
      }
    },
    {
      "subId": "7051805",
      "subQuestName": "与格奥尔格交涉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705182601"
        ],
        "dialogs": {
          "705182601": {
            "id": "705182601",
            "speakerId": 30235,
            "speakerName": "格奥尔格",
            "text": "按照惯例，我会安排专人送货，直接把这些饮品送到沙瓦玛先生的店里去。",
            "nextDialogs": [
              "705182602"
            ]
          },
          "705182602": {
            "id": "705182602",
            "speakerId": 30235,
            "speakerName": "格奥尔格",
            "text": "请你们放心吧，记得保管好这份单据。",
            "nextDialogs": [
              "705182603"
            ]
          },
          "705182603": {
            "id": "705182603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好啦，接下来我们就继续筹备资金吧，目标是尽快收集足够的「佳酿晶冻」！",
            "nextDialogs": [
              "705182604"
            ]
          },
          "705182604": {
            "id": "705182604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "按伯恩哈德的说法，方法可以自己选，只要筹备到足够的资金就行了…",
            "nextDialogs": [
              "705182605"
            ]
          },
          "705182605": {
            "id": "705182605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "外地的客人下单后，我们能拿到一笔辛苦费，就不用向酒商们出售那么多酿酒原料了吧…",
            "nextDialogs": [
              "705182606"
            ]
          },
          "705182606": {
            "id": "705182606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，为了万无一失，还是先去其他酒商那边看看吧。"
          }
        }
      }
    },
    {
      "subId": "7051803",
      "subQuestName": "提前去其他店铺踩点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705180301"
        ],
        "dialogs": {
          "705180301": {
            "id": "705180301",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "#{NICKNAME}和派蒙，你们在这里啊！",
            "nextDialogs": [
              "705180302"
            ]
          },
          "705180302": {
            "id": "705180302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喔！是芭芭拉！",
            "nextDialogs": [
              "705180305"
            ]
          },
          "705180305": {
            "id": "705180305",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "嗯，佳酿节快乐！",
            "nextDialogs": [
              "705180306"
            ]
          },
          "705180306": {
            "id": "705180306",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "佳酿节是蒙德最热闹的节日之一，我很开心能在这个时候见到你们，希望你们也喜欢佳酿节！",
            "nextDialogs": [
              "705180307"
            ]
          },
          "705180307": {
            "id": "705180307",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "说起来，刚才我听格奥尔格先生说，你们在收集「佳酿晶冻」？",
            "nextDialogs": [
              "705180308"
            ]
          },
          "705180308": {
            "id": "705180308",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "我有点好奇，你们是在帮骑士团义卖吗？",
            "nextDialogs": [
              "705180309"
            ]
          },
          "705180309": {
            "id": "705180309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊，我们也是骑士团的一份子嘛！",
            "nextDialogs": [
              "705180310"
            ]
          },
          "705180310": {
            "id": "705180310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在店铺还没开张，我们要多跑几趟，筹集开店资金！",
            "nextDialogs": [
              "705180311"
            ]
          },
          "705180311": {
            "id": "705180311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然还不知道开店后会遇上什么问题，但我们肯定能搞定所有麻烦！",
            "nextDialogs": [
              "705180312"
            ]
          },
          "705180312": {
            "id": "705180312",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "太可靠了！嘿嘿…有你们帮忙，一定会取得前所未有的成功！",
            "nextDialogs": [
              "705180313"
            ]
          },
          "705180313": {
            "id": "705180313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "借你吉言。",
            "nextDialogs": [
              "705180314"
            ]
          },
          "705180314": {
            "id": "705180314",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "之前，骑士团举办小型义卖活动的时候，我也去帮过忙。",
            "nextDialogs": [
              "705180315"
            ]
          },
          "705180315": {
            "id": "705180315",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "虽然，我帮忙的方式是站在商铺前唱歌啦…",
            "nextDialogs": [
              "705180316"
            ]
          },
          "705180316": {
            "id": "705180316",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "对了！那次我还遇到了那位吟游诗人温迪哦！他还邀请我即兴合作了一曲。",
            "nextDialogs": [
              "705180317"
            ]
          },
          "705180317": {
            "id": "705180317",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "他演奏的音阶古朴又典雅，一开始，我只敢小声跟唱，生怕哪里不对破坏了气氛…",
            "nextDialogs": [
              "705180318"
            ]
          },
          "705180318": {
            "id": "705180318",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "好在他用和声引导着我，我们很快找到了感觉。",
            "nextDialogs": [
              "705180319"
            ]
          },
          "705180319": {
            "id": "705180319",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "最后，听众们都很享受，商品也卖得特别好。",
            "nextDialogs": [
              "705180320"
            ]
          },
          "705180320": {
            "id": "705180320",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来芭芭拉和卖唱的还合作过啊…",
            "nextDialogs": [
              "705180321"
            ]
          },
          "705180321": {
            "id": "705180321",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也有点想听了。",
            "nextDialogs": [
              "705180322"
            ]
          },
          "705180322": {
            "id": "705180322",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "嗯，只可惜这次时间冲突了。",
            "nextDialogs": [
              "705180323"
            ]
          },
          "705180323": {
            "id": "705180323",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "佳酿节期间，西风教会要在风景优美的地方安排特别的唱诗，我还得参加排练…"
          }
        }
      }
    },
    {
      "subId": "7051821",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705182101"
        ],
        "dialogs": {
          "705182101": {
            "id": "705182101",
            "speakerId": 30235,
            "speakerName": "格奥尔格",
            "text": "不不不，沙瓦玛先生有和你们通过气吗？这也太低了，请别和我开玩笑。"
          }
        }
      }
    },
    {
      "subId": "7051822",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705182201"
        ],
        "dialogs": {
          "705182201": {
            "id": "705182201",
            "speakerId": 30235,
            "speakerName": "格奥尔格",
            "text": "虽说今年遇上了大丰收，酿酒成本比往年低了不少，但这个价格还是有点难接受啊。"
          }
        }
      }
    },
    {
      "subId": "7051823",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705182301"
        ],
        "dialogs": {
          "705182301": {
            "id": "705182301",
            "speakerId": 30235,
            "speakerName": "格奥尔格",
            "text": "不错，和往年价格很接近，就这样成交吧！"
          }
        }
      }
    },
    {
      "subId": "7051824",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705182401"
        ],
        "dialogs": {
          "705182401": {
            "id": "705182401",
            "speakerId": 30235,
            "speakerName": "格奥尔格",
            "text": "这个价钱…虽然有点可惜，但看在是老熟人的份上，还是成交吧。"
          }
        }
      }
    },
    {
      "subId": "7051825",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705182501"
        ],
        "dialogs": {
          "705182501": {
            "id": "705182501",
            "speakerId": 30235,
            "speakerName": "格奥尔格",
            "text": "不好意思，我实在接受不了这么低的数字。如果你们还想订货，就接受我说的价钱吧。"
          }
        }
      }
    },
    {
      "subId": "7051899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705189901"
        ],
        "dialogs": {
          "705189901": {
            "id": "705189901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，佳酿节的会场有好多好多店铺，应该还有各种有意思的商品吧？",
            "nextDialogs": [
              "705189902"
            ]
          },
          "705189902": {
            "id": "705189902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "趁着这个机会，我们去仔细逛一逛吧！",
            "nextDialogs": [
              "705189903"
            ]
          },
          "705189903": {
            "id": "705189903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这位就是格奥尔格先生了吧，我们快去和他商量一下！"
          }
        }
      }
    }
  ]
}
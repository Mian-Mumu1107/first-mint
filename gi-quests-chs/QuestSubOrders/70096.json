  "subQuests": [
    {
      "subId": "7009601",
      "subQuestName": "前往荆夫港",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700960101"
        ],
        "dialogs": {
          "700960101": {
            "id": "700960101",
            "speakerId": 7080,
            "speakerName": "斯莱日涅夫",
            "text": "…要说最强的战士，那还得是我们的「队长」！只凭肉体的力量就能硬扛深渊！",
            "nextDialogs": [
              "700960102"
            ]
          },
          "700960102": {
            "id": "700960102",
            "speakerId": 7605,
            "speakerName": "莱夫赫姆",
            "text": "这就是典型的没见过强敌也不懂战斗的言论！你觉得所有强者都只会站着打木桩吗？况且只论力量，我们大团长也…",
            "nextDialogs": [
              "700960103"
            ]
          },
          "700960103": {
            "id": "700960103",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "——够了。我让你们两个过来，不是为了这种无聊的争论。",
            "nextDialogs": [
              "700960104"
            ]
          },
          "700960104": {
            "id": "700960104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "洛恩？还有你们两个？好罕见的组合…你们平时不都待在挪德卡莱吗？",
            "nextDialogs": [
              "700960105"
            ]
          },
          "700960105": {
            "id": "700960105",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "哈…我听说挪德卡莱有两位「战力学」专家，还想请过来编撰一份「强敌图鉴」。",
            "nextDialogs": [
              "700960106"
            ]
          },
          "700960106": {
            "id": "700960106",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "哪知道他们才聊了两句就讨论不下去了，看来…我得想点办法，让你们再认真点了啊。",
            "nextDialogs": [
              "700960107"
            ]
          },
          "700960107": {
            "id": "700960107",
            "speakerId": 7080,
            "speakerName": "斯莱日涅夫",
            "text": "唔…我…我这就开始编！呃…",
            "nextDialogs": [
              "700960108"
            ]
          },
          "700960108": {
            "id": "700960108",
            "speakerId": 7605,
            "speakerName": "莱夫赫姆",
            "text": "洛…洛恩队长！我也不想啊，但「强敌」的定义实在太模糊了。",
            "nextDialogs": [
              "700960109"
            ]
          },
          "700960109": {
            "id": "700960109",
            "speakerId": 7605,
            "speakerName": "莱夫赫姆",
            "text": "别说普通魔物，就连魔神之间也差得天高地远。要是不找个合适的标杆，恐怕还是讨论不出结果…",
            "nextDialogs": [
              "700960110"
            ]
          },
          "700960110": {
            "id": "700960110",
            "speakerId": 7080,
            "speakerName": "斯莱日涅夫",
            "text": "要、要说有什么大众认知里都觉得「强大」的标杆…那大概就是「龙」了吧？",
            "nextDialogs": [
              "700960111"
            ]
          },
          "700960111": {
            "id": "700960111",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "…「龙」？",
            "nextDialogs": [
              "700960112"
            ]
          },
          "700960112": {
            "id": "700960112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的假的，我怎么觉得龙与龙之间的差距，大概就跟魔神与魔神之间的差距一样大…",
            "nextDialogs": [
              "700960115"
            ]
          },
          "700960115": {
            "id": "700960115",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "这个么…经过前阵子的反思，我觉得继续变强的最好方法——还得是挑战诸国的强敌。",
            "nextDialogs": [
              "700960116"
            ]
          },
          "700960116": {
            "id": "700960116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（跟反思之前也没啥变化啊…）",
            "nextDialogs": [
              "700960117"
            ]
          },
          "700960117": {
            "id": "700960117",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "可就在我今早准备出门的时候…有一个长得怪模怪样的东西，跟我说了些没头没尾的话。",
            "nextDialogs": [
              "700960118"
            ]
          },
          "700960118": {
            "id": "700960118",
            "speakerId": 1004,
            "speakerName": "怪模怪样的某物",
            "text": "「迷途的人类啊，你将三次直面龙威，随后理解强大的意义。」",
            "nextDialogs": [
              "700960119"
            ]
          },
          "700960119": {
            "id": "700960119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这描述…怎么听都是芭比洛斯了吧！）",
            "nextDialogs": [
              "700960120"
            ]
          },
          "700960120": {
            "id": "700960120",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "我倒是没把什么预言放在心上，不过现在的走向…哼，处处被人掌握的感觉，真让人不爽。",
            "nextDialogs": [
              "700960121"
            ]
          },
          "700960121": {
            "id": "700960121",
            "speakerId": 7605,
            "speakerName": "莱夫赫姆",
            "text": "「龙」啊…在蒙德要提到龙，就是「东风守护」、「魔龙乌萨」，跟雪山上的传说了…其他还有什么？",
            "nextDialogs": [
              "700960122"
            ]
          },
          "700960122": {
            "id": "700960122",
            "speakerId": 7080,
            "speakerName": "斯莱日涅夫",
            "text": "哼哼，这你就不知道了吧！根据我在挪德卡莱掌握的绝密情报，一头强大的古龙，已经悄无声息地来到了荆夫港！",
            "nextDialogs": [
              "700960123"
            ]
          },
          "700960123": {
            "id": "700960123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有这种事？真的假的…",
            "nextDialogs": [
              "700960124"
            ]
          },
          "700960124": {
            "id": "700960124",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "呵，真的假的，去会一会不就知道了。"
          }
        }
      }
    },
    {
      "subId": "7009602",
      "subQuestName": "寻访谜之古龙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700960301"
        ],
        "dialogs": {
          "700960301": {
            "id": "700960301",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "伊涅芙伊涅芙！你看那个风车！快把它的结构记录下来！",
            "nextDialogs": [
              "700960302"
            ]
          },
          "700960302": {
            "id": "700960302",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "收到——正在准备为风车拍照。这次想要合影吗，爱诺？",
            "nextDialogs": [
              "700960303"
            ]
          },
          "700960303": {
            "id": "700960303",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#欸？{NICKNAME}？派蒙——还有洛恩！嗨！",
            "nextDialogs": [
              "700960304"
            ]
          },
          "700960304": {
            "id": "700960304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "来自挪德卡莱的「强大古龙」…我早该想到是谁的。",
            "nextDialogs": [
              "700960305"
            ]
          },
          "700960305": {
            "id": "700960305",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "情况总结中…所以，洛恩先生是想要找我进行战斗训练？",
            "nextDialogs": [
              "700960306"
            ]
          },
          "700960306": {
            "id": "700960306",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "跳过所有前因后果，确实是这么回事。在挪德卡莱远征的时候还真没想到，你居然有这么曲折的来历。",
            "nextDialogs": [
              "700960307"
            ]
          },
          "700960307": {
            "id": "700960307",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "不过这都无关紧要，从前我就想领教一下你的身手了，怎么样？",
            "nextDialogs": [
              "700960308"
            ]
          },
          "700960308": {
            "id": "700960308",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "哼哼！伊涅芙！给他点颜色看看！",
            "nextDialogs": [
              "700960309"
            ]
          },
          "700960309": {
            "id": "700960309",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "抱歉——根据今日日程安排，我们还要去收集蒙德的特殊零件。根据评估，与您交战，可能会影响后续的行动。",
            "nextDialogs": [
              "700960310"
            ]
          },
          "700960310": {
            "id": "700960310",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "对哦…差点忘了还有这回事。明明是听说了蒙德有特别的大机器人才过来的…一不小心就全在玩了。",
            "nextDialogs": [
              "700960311"
            ]
          },
          "700960311": {
            "id": "700960311",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "好吧…我明白了。",
            "nextDialogs": [
              "700960312"
            ]
          },
          "700960312": {
            "id": "700960312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "洛恩…居然这就放弃了！",
            "nextDialogs": [
              "700960313"
            ]
          },
          "700960313": {
            "id": "700960313",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "——只要帮你们干掉那些遗迹守卫，你就能腾出日程了吧。"
          }
        }
      }
    },
    {
      "subId": "7009603",
      "subQuestName": "协助伊涅芙收集素材",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700960801"
        ],
        "dialogs": {
          "700960801": {
            "id": "700960801",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "——就是这个家伙？",
            "nextDialogs": [
              "700960802"
            ]
          },
          "700960802": {
            "id": "700960802",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "伊涅芙！上去拆了它！"
          }
        }
      }
    },
    {
      "subId": "7009609",
      "subQuestName": "协助伊涅芙收集素材",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7009604",
      "subQuestName": "击败遗迹守卫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700960401"
        ],
        "dialogs": {
          "700960401": {
            "id": "700960401",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "很流畅的身法，完全看不出是机械。",
            "nextDialogs": [
              "700960402"
            ]
          },
          "700960402": {
            "id": "700960402",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "洛恩先生的攻击也很精准，就像机械一样。",
            "nextDialogs": [
              "700960403"
            ]
          },
          "700960403": {
            "id": "700960403",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "好耶！是新零件！可以拿回去做新的模块了！",
            "nextDialogs": [
              "700960404"
            ]
          },
          "700960404": {
            "id": "700960404",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "哦？那现在…",
            "nextDialogs": [
              "700960405"
            ]
          },
          "700960405": {
            "id": "700960405",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "伊涅芙！再去多找几个！样本越多越好！",
            "nextDialogs": [
              "700960406"
            ]
          },
          "700960406": {
            "id": "700960406",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "是…抱歉，我们回头再谈吧。",
            "nextDialogs": [
              "700960407"
            ]
          },
          "700960407": {
            "id": "700960407",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "一番探索之后…",
            "nextDialogs": [
              "700960408"
            ]
          },
          "700960408": {
            "id": "700960408",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "呼…呼…",
            "nextDialogs": [
              "700960409"
            ]
          },
          "700960409": {
            "id": "700960409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然睡着了…是因为之前在荆夫港玩得太累了吗？",
            "nextDialogs": [
              "700960410"
            ]
          },
          "700960410": {
            "id": "700960410",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "爱诺经常这样，精力来得快去得也快。抱歉，洛恩先生，我现在无法移动，需要等爱诺再睡熟一些…",
            "nextDialogs": [
              "700960411"
            ]
          },
          "700960411": {
            "id": "700960411",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "…算了，你的力量，我已经看过了。",
            "nextDialogs": [
              "700960412"
            ]
          },
          "700960412": {
            "id": "700960412",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "…希望我的战斗数据，对您有所帮助。",
            "nextDialogs": [
              "700960413"
            ]
          },
          "700960413": {
            "id": "700960413",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "对了，告诉我们特殊机关信息的人，还提到过「雪山」，也许各位可以再去那边看看？"
          }
        }
      }
    },

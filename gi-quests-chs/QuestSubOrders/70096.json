    {
      "subId": "7009605",
      "subQuestName": "寻访雪山之龙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700960501"
        ],
        "dialogs": {
          "700960501": {
            "id": "700960501",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "…追寻力量之人，依循命运的指引，终于来到了这里。",
            "nextDialogs": [
              "700960502"
            ]
          },
          "700960502": {
            "id": "700960502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "果然是杜林…我怎么一点都不意外呢。",
            "nextDialogs": [
              "700960503"
            ]
          },
          "700960503": {
            "id": "700960503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但语气有点不一样？",
            "nextDialogs": [
              "700960504"
            ]
          },
          "700960504": {
            "id": "700960504",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "至高领主、魔女造物、天使孑遗…行使着各不相同的力量，却都被冠以「龙」的名字。",
            "nextDialogs": [
              "700960505"
            ]
          },
          "700960505": {
            "id": "700960505",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "…只因「龙」，即是强大的象征。",
            "nextDialogs": [
              "700960506"
            ]
          },
          "700960506": {
            "id": "700960506",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "所以「与巨龙战斗」也就成了力量的证明？——我有点理解当初的大团长了。",
            "nextDialogs": [
              "700960507"
            ]
          },
          "700960507": {
            "id": "700960507",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "…欸？",
            "nextDialogs": [
              "700960508"
            ]
          },
          "700960508": {
            "id": "700960508",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "虽然你看起来还想说什么，不过接下来就用兵刃交流吧？这样更好懂一点。",
            "nextDialogs": [
              "700960509"
            ]
          },
          "700960509": {
            "id": "700960509",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "等等！年…年轻的人类啊，你想找的试炼不在这里，前往风龙废墟吧去直面最后一次预言！",
            "nextDialogs": [
              "700960512"
            ]
          },
          "700960512": {
            "id": "700960512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你没事吧？杜林？总感觉你今天说话怪怪的？",
            "nextDialogs": [
              "700960513"
            ]
          },
          "700960513": {
            "id": "700960513",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "（哈…该念的应该都念了吧…虽然跳过了很多！）",
            "nextDialogs": [
              "700960514"
            ]
          },
          "700960514": {
            "id": "700960514",
            "speakerId": 1320,
            "speakerName": "杜林",
            "text": "那个，阿贝多喊我去帮他做实验，我就先回去了。抱歉了，各位！",
            "nextDialogs": [
              "700960515"
            ]
          },
          "700960515": {
            "id": "700960515",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "这就飞走了？…真遗憾。",
            "nextDialogs": [
              "700960516"
            ]
          },
          "700960516": {
            "id": "700960516",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "嗯？这是…",
            "nextDialogs": [
              "700960517"
            ]
          },
          "700960517": {
            "id": "700960517",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…所以杜林究竟是来做什么的？除了最后那句「前往风龙废墟」好像没什么有效信息…"
          }
        }
      }
    },
    {
      "subId": "7009606",
      "subQuestName": "寻访东风之龙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700960601"
        ],
        "dialogs": {
          "700960601": {
            "id": "700960601",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "很好…按照芭比洛斯的预言，那个需要指引的人类再过一会就会来了。",
            "nextDialogs": [
              "700960602"
            ]
          },
          "700960602": {
            "id": "700960602",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "登场台词…记住了。出场效果…确认过了。嗯，这次绝对万无一失！",
            "nextDialogs": [
              "700960603"
            ]
          },
          "700960603": {
            "id": "700960603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们说…最后一则预言，为什么要洛恩来这儿啊？",
            "nextDialogs": [
              "700960604"
            ]
          },
          "700960604": {
            "id": "700960604",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "现在就来了？难道杜林没念完他的台词？不好…要小声…",
            "nextDialogs": [
              "700960605"
            ]
          },
          "700960605": {
            "id": "700960605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道最后一次「直面龙威」…说的是特瓦林？不过它今天是不是不在呀？",
            "nextDialogs": [
              "700960606"
            ]
          },
          "700960606": {
            "id": "700960606",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "严格来说，我之前已经见过「东风守护」了。在我刚从挪德卡莱返回的时候，就在你们旁边。",
            "nextDialogs": [
              "700960607"
            ]
          },
          "700960607": {
            "id": "700960607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，是在奔狼领替法尔伽送信的那次吧！这样算起来，你的「预言」其实已经结束了？",
            "nextDialogs": [
              "700960608"
            ]
          },
          "700960608": {
            "id": "700960608",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "至少「三次直面龙威」，满打满算的话大概可以结束了。",
            "nextDialogs": [
              "700960609"
            ]
          },
          "700960609": {
            "id": "700960609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还剩下「理解强大的意义」…",
            "nextDialogs": [
              "700960610"
            ]
          },
          "700960610": {
            "id": "700960610",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "嗯，估计这才是「预言」指引我来这的理由吧。",
            "nextDialogs": [
              "700960611"
            ]
          },
          "700960611": {
            "id": "700960611",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "这个地方在被称作「风龙废墟」之前，曾是龙卷之魔神的领域。",
            "nextDialogs": [
              "700960612"
            ]
          },
          "700960612": {
            "id": "700960612",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "能卷起飓风庇护一切的强大魔神，却拦不住风墙之内对于自由的向往。",
            "nextDialogs": [
              "700960613"
            ]
          },
          "700960613": {
            "id": "700960613",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "曾与它角逐神座的北风之魔神，却在放弃力量之后，找到了一直追寻的答案。",
            "nextDialogs": [
              "700960614"
            ]
          },
          "700960614": {
            "id": "700960614",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "咦？这孩子…好像也没有法尔伽说的那么偏执？",
            "nextDialogs": [
              "700960615"
            ]
          },
          "700960615": {
            "id": "700960615",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "「明晨之镜」、「魔龙杜林」…也都曾陷入过不解与迷茫，而令他们走向强大的，却从不只是力量。",
            "nextDialogs": [
              "700960616"
            ]
          },
          "700960616": {
            "id": "700960616",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "嗯嗯…悟性不错呀。",
            "nextDialogs": [
              "700960617"
            ]
          },
          "700960617": {
            "id": "700960617",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "还有曾经的天使——「乌萨」。",
            "nextDialogs": [
              "700960618"
            ]
          },
          "700960618": {
            "id": "700960618",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "…嗯？",
            "nextDialogs": [
              "700960619"
            ]
          },
          "700960619": {
            "id": "700960619",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然话说得很有道理…但这真是洛恩你会说出来的台词吗！",
            "nextDialogs": [
              "700960622"
            ]
          },
          "700960622": {
            "id": "700960622",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "「选择了力量的天使，依旧渴望靠近人类，竟至堕落为了可悲的魔物…」",
            "nextDialogs": [
              "700960623"
            ]
          },
          "700960623": {
            "id": "700960623",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "「见证过这一切的人类啊，依旧执着于力量吗？」",
            "nextDialogs": [
              "700960624"
            ]
          },
          "700960624": {
            "id": "700960624",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "——这全是我的词啊！",
            "nextDialogs": [
              "700960625"
            ]
          },
          "700960625": {
            "id": "700960625",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！",
            "nextDialogs": [
              "700960626"
            ]
          },
          "700960626": {
            "id": "700960626",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "啊…一不小心就…",
            "nextDialogs": [
              "700960627"
            ]
          },
          "700960627": {
            "id": "700960627",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "幸会，尼可女士。您写的剧本，我已经拜读过了。",
            "nextDialogs": [
              "700960628"
            ]
          },
          "700960628": {
            "id": "700960628",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "唉…是从杜林那里捡到的吧？",
            "nextDialogs": [
              "700960629"
            ]
          },
          "700960629": {
            "id": "700960629",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "哦？难不成这也是预言？",
            "nextDialogs": [
              "700960630"
            ]
          },
          "700960630": {
            "id": "700960630",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "只是我的猜测而已。要是这也能预言到，我刚才也不会…咳。",
            "nextDialogs": [
              "700960631"
            ]
          },
          "700960631": {
            "id": "700960631",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "总之，这剧本写得不错，当成童话来读读还挺解闷的。不过我不太喜欢被人说教…就算是「天使」也不行。",
            "nextDialogs": [
              "700960632"
            ]
          },
          "700960632": {
            "id": "700960632",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "…我就当你是在说我那位选择力量的前同事了。",
            "nextDialogs": [
              "700960633"
            ]
          },
          "700960633": {
            "id": "700960633",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "既然你捡到了剧本，那我想要说的话，你应该也全看到了？",
            "nextDialogs": [
              "700960634"
            ]
          },
          "700960634": {
            "id": "700960634",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "嗯，我会把这些台词，都当成宝贵的建议记下来。如果没什么事，我就回去继续编我的强敌图鉴了？"
          }
        }
      }
    },
    {
      "subId": "7009602",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700960201"
        ],
        "dialogs": {
          "700960201": {
            "id": "700960201",
            "speakerId": 7080,
            "speakerName": "斯莱日涅夫",
            "text": "「队长」不仅武力超群，还开发过对抗深渊的特效药！这你不知道了吧？还敢说我是啥都没见识过的假学者吗？",
            "nextDialogs": [
              "700960202"
            ]
          },
          "700960202": {
            "id": "700960202",
            "speakerId": 7605,
            "speakerName": "莱夫赫姆",
            "text": "那你知道我们团长的神速吗！他曾经只用一眨眼的功夫，就从挪德卡莱顺着地脉跑回了蒙德！"
          }
        }
      }
    },
    {
      "subId": "7009607",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700960701"
        ],
        "dialogs": {
          "700960701": {
            "id": "700960701",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "唉，第一次亲自上手，居然会变成这样…",
            "nextDialogs": [
              "700960703",
              "700960705"
            ]
          },
          "700960703": {
            "id": "700960703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且，结果也不算坏嘛！"
          },
          "700960705": {
            "id": "700960705",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "嗯…是「魔女的课业」，回头再向你解释吧。"
          }
        }
      }
    },
    {
      "subId": "7009609",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700960903"
        ],
        "dialogs": {
          "700960903": {
            "id": "700960903",
            "speakerId": 1010,
            "speakerName": "<UNKNOWN>",
            "text": "(test)台词文本"
          }
        }
      }
    },
    {
      "subId": "7009699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700969901"
        ],
        "dialogs": {
          "700969901": {
            "id": "700969901",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "——就是这个家伙？",
            "nextDialogs": [
              "700969902"
            ]
          },
          "700969902": {
            "id": "700969902",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "伊涅芙！上去拆了它！"
          }
        }
      }
    }
  ]
}
{
  "lineCounts": {
    "Player": 16,
    "「灰眸」": 1,
    "勒庇依婶婶": 1,
    "娜斯佳": 41,
    "欧维": 6,
    "派蒙": 24
  },
  "subQuests": [
    {
      "subId": "7711001",
      "subQuestName": "进入奥古洛夫镇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771100301"
        ],
        "dialogs": {
          "771100301": {
            "id": "771100301",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "…我只会把青蛙丢到他的房子里，然后他在家里就会看到满地——「呱呱」，那才热闹。",
            "nextDialogs": [
              "771100302"
            ]
          },
          "771100302": {
            "id": "771100302",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "他是「坏虫」…勒庇依婶婶，你帮帮忙吧，求求你帮我去拿钥匙…",
            "nextDialogs": [
              "771100303"
            ]
          },
          "771100303": {
            "id": "771100303",
            "speakerId": 1001,
            "speakerName": "勒庇依婶婶",
            "text": "…相信…家人…",
            "nextDialogs": [
              "771100304"
            ]
          },
          "771100304": {
            "id": "771100304",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喂！娜斯佳，我们在这儿！可算找到你了！",
            "nextDialogs": [
              "771100305"
            ]
          },
          "771100305": {
            "id": "771100305",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "#呜呜！{NICKNAME}{M#大哥哥}{F#大姐姐}和小小派蒙，太好了！你们来了！",
            "nextDialogs": [
              "771100306"
            ]
          },
          "771100306": {
            "id": "771100306",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "我等了好久…扎拉好生气，可能是把你们当成那些使坏的兽怪了。",
            "nextDialogs": [
              "771100307"
            ]
          },
          "771100307": {
            "id": "771100307",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "当时，你们一下子掉到了那个黑黑的大坑里…又深…又大…呜呜，我都不敢往里看。",
            "nextDialogs": [
              "771100308"
            ]
          },
          "771100308": {
            "id": "771100308",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "不过，我感觉你们很厉害，肯定有办法出来找到我的。",
            "nextDialogs": [
              "771100309"
            ]
          },
          "771100309": {
            "id": "771100309",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "虽然最后还是回到地面上了，但过程一点都不轻松…算了，我们还有一些问题想先问问你呢。",
            "nextDialogs": [
              "771100310"
            ]
          },
          "771100310": {
            "id": "771100310",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你在这里，有没有一个叫「卡谢伊」的家人？",
            "nextDialogs": [
              "771100311"
            ]
          },
          "771100311": {
            "id": "771100311",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "没有听说过哦…",
            "nextDialogs": [
              "771100312"
            ]
          },
          "771100312": {
            "id": "771100312",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦，竟然没有吗？",
            "nextDialogs": [
              "771100313"
            ]
          },
          "771100313": {
            "id": "771100313",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "不过娜斯佳也不知道所有人的名字，如果派蒙想知道的话，要去找莫罗医生…医生知道所有的事，知道所有人的姓名。",
            "nextDialogs": [
              "771100314"
            ]
          },
          "771100314": {
            "id": "771100314",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "即使是变成树，逐渐无法说话，也逐渐被忘记名字的那些人，莫罗医生也会记得…",
            "nextDialogs": [
              "771100315"
            ]
          },
          "771100315": {
            "id": "771100315",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "变成树…等等，所以这边的树妖其实原本「全都是人类」？",
            "nextDialogs": [
              "771100316"
            ]
          },
          "771100316": {
            "id": "771100316",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "树妖？树妖是什么？我们反正不是…如果你说的是我们的话，那勒庇依婶婶他们是差不多变完了的「完全树」…",
            "nextDialogs": [
              "771100317"
            ]
          },
          "771100317": {
            "id": "771100317",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "我现在是「一半树」…哦，都怪那群兽怪，不然我现在也跟他们有着一样的进度，现在慢慢的。",
            "nextDialogs": [
              "771100318"
            ]
          },
          "771100318": {
            "id": "771100318",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们是怎么交流的？",
            "nextDialogs": [
              "771100319"
            ]
          },
          "771100319": {
            "id": "771100319",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "变成「完全树」之后，只要树叶碰一碰，就能「说话」啦，我的根系也能和大家的连结在一起。",
            "nextDialogs": [
              "771100320"
            ]
          },
          "771100320": {
            "id": "771100320",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "莫罗医生说，「让我们成为家人吧，让我们供养一个温暖的，不再痛苦的世界，让我们联结一处，抵达——」",
            "nextDialogs": [
              "771100321"
            ]
          },
          "771100321": {
            "id": "771100321",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "「永恒的，因永恒而无忧的庭院。」",
            "nextDialogs": [
              "771100322"
            ]
          },
          "771100322": {
            "id": "771100322",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#（{NICKNAME}…这个莫罗医生该不会是…）",
            "nextDialogs": [
              "771100326",
              "771100325"
            ]
          },
          "771100326": {
            "id": "771100326",
            "speakerId": 1003,
            "speakerName": "「灰眸」",
            "text": "在我看来，这是非常合乎逻辑的推理。",
            "nextDialogs": [
              "771100327"
            ]
          },
          "771100327": {
            "id": "771100327",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "（哦！「眼镜」也这么认为吗？那我们现在该怎么办呢…）",
            "nextDialogs": [
              "771100328"
            ]
          },
          "771100328": {
            "id": "771100328",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（先跟着娜斯佳走吧。）",
            "nextDialogs": [
              "771100329"
            ]
          },
          "771100329": {
            "id": "771100329",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "（也有道理，只要跟着娜斯佳，肯定能见到莫罗医生——「不死魔」卡谢伊…）",
            "nextDialogs": [
              "771100330"
            ]
          },
          "771100330": {
            "id": "771100330",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "#{NICKNAME}{M#大哥哥}{F#大姐姐}和小小派蒙，你们在说什么悄悄话呀？",
            "nextDialogs": [
              "771100331"
            ]
          },
          "771100331": {
            "id": "771100331",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "…哇！没、没什么！我们只是…只是对莫罗医生很感兴趣！你能再给我们讲讲他的事吗？",
            "nextDialogs": [
              "771100332"
            ]
          },
          "771100332": {
            "id": "771100332",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "嘿嘿，当然可以啦！自从他来到镇子后，这里变得温暖，冰雪变成了哗啦啦流动的小溪，地上长出了好多长着漂亮羽叶的树。",
            "nextDialogs": [
              "771100333"
            ]
          },
          "771100333": {
            "id": "771100333",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "他还让大家的身体变得更好，妈妈的腿不痛了，她的眼睛也不会老是红红着流眼泪了…",
            "nextDialogs": [
              "771100334"
            ]
          },
          "771100334": {
            "id": "771100334",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "大家也不再互相争吵，即使是再互相仇视的两个人，最后都能平静下来，手拉着手，成为家人…",
            "nextDialogs": [
              "771100335"
            ]
          },
          "771100335": {
            "id": "771100335",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "…所以你们要成为我的家人吗？那时候，扎拉肯定也不会对你们生气了。"
          },
          "771100325": {
            "id": "771100325",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "（是这样没错，但是你也想到了吧，他有可能就是「不死魔」卡谢伊！）"
          }
        }
      }
    },
    {
      "subId": "7711012",
      "subQuestName": "前往欧维家附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7711003",
      "subQuestName": "(test)与娜斯佳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771100101"
        ],
        "dialogs": {
          "771100101": {
            "id": "771100101",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "嗯，就是这里…他还站在门口呢。",
            "nextDialogs": [
              "771100102"
            ]
          },
          "771100102": {
            "id": "771100102",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔，看起来确实是一副没法交流的样子…娜斯佳要不要试试直接和他要「控制轮」？",
            "nextDialogs": [
              "771100103"
            ]
          },
          "771100103": {
            "id": "771100103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "就算他再讨厌你，应该也不会拦着一个小孩回家吧！",
            "nextDialogs": [
              "771100104"
            ]
          },
          "771100104": {
            "id": "771100104",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "小小派蒙说错了哦，他一定不会把「控制轮」给我们。",
            "nextDialogs": [
              "771100105"
            ]
          },
          "771100105": {
            "id": "771100105",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "之前他就拦着我们去礼堂…每次家人们要相聚的时候，他就会把我们关进他的地下室，虽然有时候他也给我们准备一些好吃的…",
            "nextDialogs": [
              "771100106"
            ]
          },
          "771100106": {
            "id": "771100106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「我们」？",
            "nextDialogs": [
              "771100107"
            ]
          },
          "771100107": {
            "id": "771100107",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "还有我的朋友们啦，我们总是一起被抓住。",
            "nextDialogs": [
              "771100108"
            ]
          },
          "771100108": {
            "id": "771100108",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "什么？他抓这么多小孩，镇上没有别的人管管他吗！",
            "nextDialogs": [
              "771100109"
            ]
          },
          "771100109": {
            "id": "771100109",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "他只关我们一个晚上，让我们赶不上去礼堂而已…就算告状了，爸爸妈妈也只会觉得是我们玩过头了，才找了个借口。",
            "nextDialogs": [
              "771100110"
            ]
          },
          "771100110": {
            "id": "771100110",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "没有人知道他为什么这么做，但他总害我们白白挨一顿骂！",
            "nextDialogs": [
              "771100111"
            ]
          },
          "771100111": {
            "id": "771100111",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "我一直觉得他是那种奇怪的「坏虫」，得快快烧掉再重新变成健康的树才好…可惜医生和扎拉都没感觉到。",
            "nextDialogs": [
              "771100112"
            ]
          },
          "771100112": {
            "id": "771100112",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怪不得你给他起了这么难听的绰号呢…如果有人害得我白白挨骂，我也讨厌他！不过，直接要「控制轮」看来是行不通了…",
            "nextDialogs": [
              "771100113"
            ]
          },
          "771100113": {
            "id": "771100113",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "对了，我之前把青蛙丢进他的家里，所以爬上过他的房顶，那里应该有地方可以溜进去…",
            "nextDialogs": [
              "771100114"
            ]
          },
          "771100114": {
            "id": "771100114",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "等等，丢青蛙到别人的家里可不是好孩子该做的事情哦！",
            "nextDialogs": [
              "771100115"
            ]
          },
          "771100115": {
            "id": "771100115",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "我知道啦…但每次都是他先做坏事，我才做坏事的…每次他抓几个小孩，我们就丢几只青蛙，很公平。",
            "nextDialogs": [
              "771100116"
            ]
          },
          "771100116": {
            "id": "771100116",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "不过现在没有人帮我搭梯子了…唔，我上不去呢，你们有办法进去找「控制轮」吗？",
            "nextDialogs": [
              "771100118",
              "771100120"
            ]
          },
          "771100118": {
            "id": "771100118",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这种事情我们最擅长了！放心，就等我们的好消息吧。",
            "nextDialogs": [
              "771100121"
            ]
          },
          "771100121": {
            "id": "771100121",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "那我在外面等你们哦，你们也要小心！"
          },
          "771100120": {
            "id": "771100120",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喂喂！不要说丧气话啦！我们一定能找到「控制轮」的，才不会被抓！"
          }
        }
      }
    },
    {
      "subId": "7711004",
      "subQuestName": "设法进入欧维的家",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771100401"
        ],
        "dialogs": {
          "771100401": {
            "id": "771100401",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "怎么啦，遇到什么麻烦了吗？",
            "nextDialogs": [
              "771100403",
              "771100406"
            ]
          },
          "771100403": {
            "id": "771100403",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "说服…「烂鼻子」欧维吗？！听起来比打败「烂鼻子」欧维还要难！",
            "nextDialogs": [
              "771100404"
            ]
          },
          "771100404": {
            "id": "771100404",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "不过呢，他就站在那儿，如果你想要尝试说服他的话就试试吧…但如果他有动手的样子，记得抓紧逃跑！"
          },
          "771100406": {
            "id": "771100406",
            "speakerId": 1000,
            "speakerName": "娜斯佳",
            "text": "也是哦…耐心的观察和细致的准备是必要的，那你们加油哦！"
          }
        }
      }
    },
    {
      "subId": "7711005",
      "subQuestName": "调查房子内部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771100501"
        ],
        "dialogs": {
          "771100501": {
            "id": "771100501",
            "speakerId": 1004,
            "speakerName": "欧维",
            "text": "…嗬…不能去…关…",
            "nextDialogs": [
              "771100503",
              "771100505"
            ]
          },
          "771100503": {
            "id": "771100503",
            "speakerId": 1004,
            "speakerName": "欧维",
            "text": "……"
          },
          "771100505": {
            "id": "771100505",
            "speakerId": 1004,
            "speakerName": "欧维",
            "text": "守…不…不关你事…"
          }
        }
      }
    },
    {
      "subId": "7711006",
      "subQuestName": "进入地下室",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771100601"
        ],
        "dialogs": {
          "771100601": {
            "id": "771100601",
            "speakerId": 1004,
            "speakerName": "欧维",
            "text": "…准备…水…不，牛奶…干面包…加糖块…",
            "nextDialogs": [
              "771100604"
            ]
          },
          "771100604": {
            "id": "771100604",
            "speakerId": 1004,
            "speakerName": "欧维",
            "text": "…先…抓青蛙…",
            "nextDialogs": [
              "771100605"
            ]
          },
          "771100605": {
            "id": "771100605",
            "speakerId": 1004,
            "speakerName": "欧维",
            "text": "只…到明天…不去礼堂…"
          }
        }
      }
    },

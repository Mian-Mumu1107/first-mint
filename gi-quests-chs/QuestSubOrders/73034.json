    {
      "subId": "7303406",
      "subQuestName": "去四周看看$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730340601"
        ],
        "dialogs": {
          "730340601": {
            "id": "730340601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？这封信…看起来好像是柯莱留下的，我们去看看吧。",
            "nextDialogs": [
              "730340602"
            ]
          },
          "730340602": {
            "id": "730340602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但她人怎么还是不在…",
            "nextDialogs": [
              "730340603"
            ]
          },
          "730340603": {
            "id": "730340603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也许又是和提纳里一起出去工作了吧，他们一直都很忙的样子。",
            "nextDialogs": [
              "730340604"
            ]
          },
          "730340604": {
            "id": "730340604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还是快看看信吧。看这笔迹，柯莱下笔的时候可真用力呀…",
            "nextDialogs": [
              "730340605"
            ]
          },
          "730340605": {
            "id": "730340605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#「{NICKNAME}和派蒙，谢谢你们帮我照料这盆花。」",
            "nextDialogs": [
              "730340606"
            ]
          },
          "730340606": {
            "id": "730340606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「这段时间林子里有太多事要处理，我一忙起来就会忘记打理…」",
            "nextDialogs": [
              "730340607"
            ]
          },
          "730340607": {
            "id": "730340607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「再次谢谢你们帮忙，等我有空了，我们一起去贾汉吉尔先生的店里吃『土豆船』吧！」",
            "nextDialogs": [
              "730340608"
            ]
          },
          "730340608": {
            "id": "730340608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喔！你看，柯莱说要请我们吃好吃的！记下来记下来。",
            "nextDialogs": [
              "730340609"
            ]
          },
          "730340609": {
            "id": "730340609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是不知道柯莱到底在处理什么事，感觉她都要忙不过来了。",
            "nextDialogs": [
              "730340610"
            ]
          },
          "730340610": {
            "id": "730340610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "希望她能好好休息，别累坏了…"
          }
        }
      }
    },
    {
      "subId": "7303499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730349904"
        ],
        "dialogs": {
          "730349904": {
            "id": "730349904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样就好了，就让这盆花在这里好好地成长吧。",
            "nextDialogs": [
              "730349905"
            ]
          },
          "730349905": {
            "id": "730349905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…我们再给柯莱留封信，告诉她是我们把这盆花搬出来的吧。",
            "nextDialogs": [
              "730349906"
            ]
          },
          "730349906": {
            "id": "730349906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不然，说不定她会误会成有小偷闯空门了。"
          }
        }
      }
    }
  ]

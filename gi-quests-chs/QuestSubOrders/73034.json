    {
      "subId": "7303402",
      "subQuestName": "翻阅桌上的书$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730340201"
        ],
        "dialogs": {
          "730340201": {
            "id": "730340201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔？你在看什么呢？",
            "nextDialogs": [
              "730340202"
            ]
          },
          "730340202": {
            "id": "730340202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这笔记本里写着照顾花的方法。",
            "nextDialogs": [
              "730340203"
            ]
          },
          "730340203": {
            "id": "730340203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？我也看看…",
            "nextDialogs": [
              "730340204"
            ]
          },
          "730340204": {
            "id": "730340204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「…需要安置于开阔地带，多接受日照…」",
            "nextDialogs": [
              "730340205"
            ]
          },
          "730340205": {
            "id": "730340205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "柯莱应该是没来得及把它给搬出去吧…",
            "nextDialogs": [
              "730340206"
            ]
          },
          "730340206": {
            "id": "730340206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，那我们来帮柯莱照顾一下这盆花吧。",
            "nextDialogs": [
              "730340207"
            ]
          },
          "730340207": {
            "id": "730340207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…总之，先把这盆花搬出去，就放在屋子旁边吧。",
            "nextDialogs": [
              "730340208"
            ]
          },
          "730340208": {
            "id": "730340208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也别放太远了，不然柯莱回来找不到的话该着急了。"
          }
        }
      }
    },

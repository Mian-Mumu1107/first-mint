    {
      "subId": "4007409",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400740901"
        ],
        "dialogs": {
          "400740901": {
            "id": "400740901",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "周围变了。这里不是我们出发前的海滩。",
            "nextDialogs": [
              "400740902"
            ]
          },
          "400740902": {
            "id": "400740902",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "看起来，应该是蒙德的山地。难道说，我们被送到蒙德了？",
            "nextDialogs": [
              "400740903"
            ]
          },
          "400740903": {
            "id": "400740903",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "但周围还是无垠之海呢。",
            "nextDialogs": [
              "400740904"
            ]
          },
          "400740904": {
            "id": "400740904",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "周围应该有刚才那样可供进入的水池。",
            "nextDialogs": [
              "400740905"
            ]
          },
          "400740905": {
            "id": "400740905",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "在这边！",
            "nextDialogs": [
              "400740906"
            ]
          },
          "400740906": {
            "id": "400740906",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "…嗯？不能直接进入？",
            "nextDialogs": [
              "400740907"
            ]
          },
          "400740907": {
            "id": "400740907",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "水面上好像浮现出什么东西了…",
            "nextDialogs": [
              "400740908"
            ]
          },
          "400740908": {
            "id": "400740908",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "这是画吗？还是…",
            "nextDialogs": [
              "400740909"
            ]
          },
          "400740909": {
            "id": "400740909",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "似乎在提示某个地点。",
            "nextDialogs": [
              "400740910"
            ]
          },
          "400740910": {
            "id": "400740910",
            "speakerId": 1002,

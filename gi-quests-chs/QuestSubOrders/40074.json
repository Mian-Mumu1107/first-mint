    {
      "subId": "4007412",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400741201"
        ],
        "dialogs": {
          "400741201": {
            "id": "400741201",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "梅姬斯图斯卿…这太让人难过了。",
            "nextDialogs": [
              "400741202"
            ]
          },
          "400741202": {
            "id": "400741202",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "呃，别安慰我，我会很尴尬的…",
            "nextDialogs": [
              "400741203"
            ]
          },
          "400741203": {
            "id": "400741203",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "此时无声胜有声，你需要拥抱吗？",
            "nextDialogs": [
              "400741204"
            ]
          },
          "400741204": {
            "id": "400741204",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "不要啦！",
            "nextDialogs": [
              "400741205"
            ]
          },
          "400741205": {
            "id": "400741205",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "这些是我以前的感悟，那时我才刚接触占星术没多久。",
            "nextDialogs": [
              "400741206"
            ]
          },
          "400741206": {
            "id": "400741206",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "现在可是老手了，不会再被凡人的意见撼动。",
            "nextDialogs": [
              "400741207"
            ]
          },
          "400741207": {
            "id": "400741207",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "真令人意外，宫廷大法师梅姬斯图斯卿也有混得很差的阶段呢。",
            "nextDialogs": [
              "400741208"
            ]
          },
          "400741208": {
            "id": "400741208",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "被人误解的生活，一定很难熬…你能释怀真是太好了。",
            "nextDialogs": [
              "400741209"
            ]
          },
          "400741209": {
            "id": "400741209",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "其实，真有人因为受不了这些，忍痛放弃了占星术。",
            "nextDialogs": [
              "400741210"
            ]
          },
          "400741210": {
            "id": "400741210",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "但我是天才嘛，肯定能做到别人做不到的事。",
            "nextDialogs": [
              "400741211"
            ]
          },
          "400741211": {
            "id": "400741211",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "在这么宏伟漂亮的地方说这种话，格外有魄力哦！",
            "nextDialogs": [
              "400741214"
            ]
          },
          "400741214": {
            "id": "400741214",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "很好很好，再多夸一点。",
            "nextDialogs": [
              "400741215"
            ]
          },
          "400741215": {
            "id": "400741215",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "那个…无意叨扰各位的雅兴，不过，那边有扇门哦？",
            "nextDialogs": [
              "400741216"
            ]
          },
          "400741216": {
            "id": "400741216",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "好吧，等解决这一带的问题，再给你们机会使劲夸我。"
          }
        }
      }
    },
    {
      "subId": "4007414",
      "subQuestName": "进入幻境之门",
      "sceneId": null,
      "locations": [],

    {
      "subId": "4007411",
      "subQuestName": "与众人会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400741101"
        ],
        "dialogs": {
          "400741101": {
            "id": "400741101",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "各位，这边集合！",
            "nextDialogs": [
              "400741102"
            ]
          },
          "400741102": {
            "id": "400741102",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "大家都睡醒了吧？莫娜刚才说，有重要的事要宣布。",
            "nextDialogs": [
              "400741103"
            ]
          },
          "400741103": {
            "id": "400741103",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "君临幽夜净土后晨曦初绽之时，确实令本皇女心旷神怡。",
            "nextDialogs": [
              "400741104"
            ]
          },
          "400741104": {
            "id": "400741104",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "小姐的意思是，她已经准备好面对接下来的挑战了。",
            "nextDialogs": [
              "400741105"
            ]
          },
          "400741105": {
            "id": "400741105",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "我们也睡饱吃饱了哦。",
            "nextDialogs": [
              "400741106"
            ]
          },
          "400741106": {
            "id": "400741106",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "嗯。那我就直说了。",
            "nextDialogs": [
              "400741107"
            ]
          },
          "400741107": {
            "id": "400741107",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "刚才我用水占盘看过，有一处新的幻境，已经在那边的岛屿上汇聚成型。",
            "nextDialogs": [
              "400741108"
            ]
          },
          "400741108": {
            "id": "400741108",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "而且…如果直觉没错的话，应该与我有关。",
            "nextDialogs": [
              "400741109"
            ]
          },
          "400741109": {
            "id": "400741109",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "这次是莫娜啊。之前几个幻境，莫娜都陪着我们去了。这回轮到我们去你那里看看啦。",
            "nextDialogs": [
              "400741110"
            ]
          },
          "400741110": {
            "id": "400741110",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "呃…没什么好看的。",
            "nextDialogs": [
              "400741111"
            ]
          },
          "400741111": {
            "id": "400741111",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "梅姬斯图斯卿，您是在不好意思吗？",
            "nextDialogs": [
              "400741112"
            ]
          },
          "400741112": {
            "id": "400741112",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "不不，怎么会呢，啊哈哈，我才不担心大家看见过于寒碜的幻境从而对我这个人产生偏见呢…",
            "nextDialogs": [
              "400741113"
            ]
          },
          "400741113": {
            "id": "400741113",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "都说出来了…",
            "nextDialogs": [
              "400741114"
            ]
          },
          "400741114": {
            "id": "400741114",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "其实…大家一般都会觉得占星术士很超凡脱俗，对吧？我担心，万一我的幻境不是那样…",
            "nextDialogs": [
              "400741115"
            ]
          },
          "400741115": {
            "id": "400741115",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "本皇女可没有在期待那种愚昧无比的事。",
            "nextDialogs": [
              "400741116"
            ]
          },
          "400741116": {
            "id": "400741116",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "我也没有。倒不是不对你抱有期待啦，但我认为，莫娜你本来就是个亲切善良的人，不需要伪装。",
            "nextDialogs": [
              "400741117"
            ]
          },
          "400741117": {
            "id": "400741117",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "怀抱平常心的人，其幻境也会呈现出相应的亲切。这不是好事吗？",
            "nextDialogs": [
              "400741118"
            ]
          },
          "400741118": {
            "id": "400741118",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "对呀，再说，我们去莫娜的幻境也不只是观光旅游，还有别的目的吧？",
            "nextDialogs": [
              "400741121"
            ]
          },
          "400741121": {
            "id": "400741121",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "…这样啊，那就好。",
            "nextDialogs": [
              "400741122"
            ]
          },
          "400741122": {
            "id": "400741122",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "只要你们别太期待，我就不紧张了。好，那出发吧。"
          }
        }
      }
    },
    {
      "subId": "4007402",
      "subQuestName": "前往危危岛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400740201"
        ],
        "dialogs": {
          "400740201": {
            "id": "400740201",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "水占盘上显示，我们已经到幻境了。唔，先找入口…",
            "nextDialogs": [
              "400740202"
            ]
          },
          "400740202": {
            "id": "400740202",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "会不会是那边那个？",
            "nextDialogs": [
              "400740203"
            ]
          },
          "400740203": {
            "id": "400740203",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "这看起来…好像是个水池。",
            "nextDialogs": [
              "400740204"
            ]
          },
          "400740204": {
            "id": "400740204",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "不会是要游泳进去吧？",
            "nextDialogs": [
              "400740205"
            ]
          },
          "400740205": {
            "id": "400740205",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "……",
            "nextDialogs": [
              "400740206"
            ]
          },
          "400740206": {
            "id": "400740206",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "难道，我们之中有旱鸭子？",
            "nextDialogs": [
              "400740207"
            ]
          },
          "400740207": {
            "id": "400740207",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "我倒觉得问题可能不在这里…",
            "nextDialogs": [
              "400740208"
            ]
          },
          "400740208": {
            "id": "400740208",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "啊哈，有人害怕了是吗？那好吧，就由我来打头阵。",
            "nextDialogs": [
              "400740209"
            ]
          },
          "400740209": {
            "id": "400740209",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "开始了！她对游泳很自信，所以开始炫耀了！",
            "nextDialogs": [
              "400740210"
            ]
          },
          "400740210": {
            "id": "400740210",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "咳！小姐，注意措辞。",
            "nextDialogs": [
              "400740211"
            ]
          },
          "400740211": {
            "id": "400740211",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "啊、噢噢！",
            "nextDialogs": [
              "400740212"
            ]
          },
          "400740212": {
            "id": "400740212",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "先走一步！",
            "nextDialogs": [
              "400740213"
            ]
          },
          "400740213": {
            "id": "400740213",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "啊，莫娜跳进池子里消失了？！我们也快跟上去！"
          }
        }
      }
    },
    {
      "subId": "4007403",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400740301"
        ],
        "dialogs": {
          "400740301": {
            "id": "400740301",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "好宏伟的建筑…",
            "nextDialogs": [
              "400740302"
            ]
          },
          "400740302": {
            "id": "400740302",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "哇…我从来没见过这样的地方…",
            "nextDialogs": [
              "400740303"
            ]
          },
          "400740303": {
            "id": "400740303",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "喂莫娜，你的幻境太厉害了吧！",
            "nextDialogs": [
              "400740304"
            ]
          },
          "400740304": {
            "id": "400740304",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "虽然比起幽夜净土还是寒碜了一些，但也不错哦，梅姬斯图斯卿。",
            "nextDialogs": [
              "400740305"
            ]
          },
          "400740305": {
            "id": "400740305",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "（太好了，幸好不是什么被老太婆训话的课堂…面子算是保住了…）",
            "nextDialogs": [
              "400740306"
            ]
          },
          "400740306": {
            "id": "400740306",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "天才占星术士的幻境，当然得气派啦。",
            "nextDialogs": [
              "400740307"
            ]
          },
          "400740307": {
            "id": "400740307",
            "speakerId": 1005,
            "speakerName": "莫娜",
            "text": "接下来，开始搜索吧。"
          }
        }
      }
    },

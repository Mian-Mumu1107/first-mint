  "subQuests": [
    {
      "subId": "1502408",
      "subQuestName": "前往烟谜主部族驻地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150240801"
        ],
        "dialogs": {
          "150240801": {
            "id": "150240801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真的被传送到另一个空间了…",
            "nextDialogs": [
              "150240802"
            ]
          },
          "150240802": {
            "id": "150240802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "从哪里出去呢？",
            "nextDialogs": [
              "150240803"
            ]
          },
          "150240803": {
            "id": "150240803",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…我怎么觉得这个空间是完全封闭的？根本找不到像是出口的地方。",
            "nextDialogs": [
              "150240804"
            ]
          },
          "150240804": {
            "id": "150240804",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不如先在周围找找，看看能不能发现什么线索。"
          }
        }
      }
    },
    {
      "subId": "1502401",
      "subQuestName": "前往烟谜主部族驻地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150240101"
        ],
        "dialogs": {
          "150240101": {
            "id": "150240101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？好像有什么东西躲在神像后面！",
            "nextDialogs": [
              "150240102"
            ]
          },
          "150240102": {
            "id": "150240102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这是幼年的暝视龙？还蛮可爱的…不过，它为什么要这样盯着我们看？",
            "nextDialogs": [
              "150240103"
            ]
          },
          "150240103": {
            "id": "150240103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}！",
            "nextDialogs": [
              "150240104"
            ]
          },
          "150240104": {
            "id": "150240104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这里是…）",
            "nextDialogs": [
              "150240105"
            ]
          },
          "150240105": {
            "id": "150240105",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "150240106"
            ]
          },
          "150240106": {
            "id": "150240106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（你是…）",
            "nextDialogs": [
              "150240107"
            ]
          },
          "150240107": {
            "id": "150240107",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "！",
            "nextDialogs": [
              "150240108"
            ]
          },
          "150240108": {
            "id": "150240108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…到底过去了多久…",
            "nextDialogs": [
              "150240109"
            ]
          },
          "150240109": {
            "id": "150240109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，刚刚我和那只幼年暝视龙对视了一眼，就被拉进了一个奇怪的空间，还见到了好大的一只暝视龙！",
            "nextDialogs": [
              "150240110"
            ]
          },
          "150240110": {
            "id": "150240110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也是…",
            "nextDialogs": [
              "150240111"
            ]
          },
          "150240111": {
            "id": "150240111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么会发生这种事？",
            "nextDialogs": [
              "150240112"
            ]
          },
          "150240112": {
            "id": "150240112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，又怎么了？",
            "nextDialogs": [
              "150240115"
            ]
          },
          "150240115": {
            "id": "150240115",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看！是那只幼年的暝视龙，它好像也想带我们去那边。从冒险者的角度来说，必须一探究竟了呢！",
            "nextDialogs": [
              "150240116"
            ]
          },
          "150240116": {
            "id": "150240116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们走，派蒙！"
          }
        }
      }
    },
    {
      "subId": "1502402",
      "subQuestName": "前往烟谜主部族驻地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150240201"
        ],
        "dialogs": {
          "150240201": {
            "id": "150240201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不知道这里允不允许外人进去…门怎么自己打开了？",
            "nextDialogs": [
              "150240202"
            ]
          },
          "150240202": {
            "id": "150240202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，之前看到的那只暝视龙真的在这里！",
            "nextDialogs": [
              "150240203"
            ]
          },
          "150240203": {
            "id": "150240203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就是它在呼唤我…",
            "nextDialogs": [
              "150240204"
            ]
          },
          "150240204": {
            "id": "150240204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那我们过去打个招呼？"
          }
        }
      }
    },
    {
      "subId": "1502403",
      "subQuestName": "进入大厅",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150240301"
        ],
        "dialogs": {
          "150240301": {
            "id": "150240301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好，请问…",
            "nextDialogs": [
              "150240302"
            ]
          },
          "150240302": {
            "id": "150240302",
            "speakerId": 1002,
            "speakerName": "古怪的暝视龙",
            "text": "……",
            "nextDialogs": [
              "150240303"
            ]
          },
          "150240303": {
            "id": "150240303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "它听得懂我们讲话吗？看上去呆呆的…",
            "nextDialogs": [
              "150240304"
            ]
          },
          "150240304": {
            "id": "150240304",
            "speakerId": 1002,
            "speakerName": "古怪的暝视龙",
            "text": "！",
            "nextDialogs": [
              "150240305"
            ]
          },
          "150240305": {
            "id": "150240305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "如果说错了什么，对不起！",
            "nextDialogs": [
              "150240306"
            ]
          },
          "150240306": {
            "id": "150240306",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "是谁在那里？不得对长老无礼！",
            "nextDialogs": [
              "150240307"
            ]
          },
          "150240307": {
            "id": "150240307",
            "speakerId": 1003,
            "speakerName": "暝视龙长老",
            "text": "……",
            "nextDialogs": [
              "150240308"
            ]
          },
          "150240308": {
            "id": "150240308",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "您的意思是…我明白了。刚刚是我冒昧了，两位既然是受邀而来的客人，我本该热情接待。",
            "nextDialogs": [
              "150240309"
            ]
          },
          "150240309": {
            "id": "150240309",
            "speakerId": 1004,
            "speakerName": "卡胡鲁",
            "text": "正式介绍一下，在下名为卡胡鲁，烟谜主的祭司之一。",
            "nextDialogs": [
              "150240310"
            ]
          },
          "150240310": {
            "id": "150240310",
            "speakerId": 1004,
            "speakerName": "卡胡鲁",
            "text": "这位是现任的暝视龙大长老，伟大的特拉波波克提兹特利，我们烟谜主活着的图腾。",
            "nextDialogs": [
              "150240311"
            ]
          },
          "150240311": {
            "id": "150240311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好长的名字…",
            "nextDialogs": [
              "150240312"
            ]
          },
          "150240312": {
            "id": "150240312",
            "speakerId": 1004,
            "speakerName": "卡胡鲁",
            "text": "我们族人平时都称呼它为特拉波长老，两位客人也可以使用这个称呼。",
            "nextDialogs": [
              "150240313"
            ]
          },
          "150240313": {
            "id": "150240313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它邀请人的方式真特别。",
            "nextDialogs": [
              "150240314"
            ]
          },
          "150240314": {
            "id": "150240314",
            "speakerId": 1004,
            "speakerName": "卡胡鲁",
            "text": "哦，这位客人是指长老的能力吧。",
            "nextDialogs": [
              "150240315"
            ]
          },
          "150240315": {
            "id": "150240315",
            "speakerId": 1004,
            "speakerName": "卡胡鲁",
            "text": "特拉波长老已经活过数百年的岁月，它身上的秘密就连我这个祭司也难以说清楚，客人感到困惑自然是情有可原。",
            "nextDialogs": [
              "150240316"
            ]
          },
          "150240316": {
            "id": "150240316",
            "speakerId": 1004,
            "speakerName": "卡胡鲁",
            "text": "不过有一点我可以确认，特拉波长老对两位发出了重要的谕示，因此我希望能邀请两位接受一项测试。",
            "nextDialogs": [
              "150240317"
            ]
          },
          "150240317": {
            "id": "150240317",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "谕示？测试？",
            "nextDialogs": [
              "150240318"
            ]
          },
          "150240318": {
            "id": "150240318",
            "speakerId": 1004,
            "speakerName": "卡胡鲁",
            "text": "如果可以的话，请两位随我去见部族首领。比起我，他更有能力来解答两位的疑问。",
            "nextDialogs": [
              "150240319"
            ]
          },
          "150240319": {
            "id": "150240319",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…好吧。",
            "nextDialogs": [
              "150240320"
            ]
          },
          "150240320": {
            "id": "150240320",
            "speakerId": 1004,
            "speakerName": "卡胡鲁",
            "text": "如果两位准备好了，就请随我来吧。",
            "nextDialogs": [
              "150240401"
            ]
          },
          "150240401": {
            "id": "150240401",
            "speakerId": 1004,
            "speakerName": "卡胡鲁",
            "text": "使用这面织物，就可以直接抵达首领所在的「曜石祭场」。",
            "nextDialogs": [
              "150240402"
            ]
          },
          "150240402": {
            "id": "150240402",
            "speakerId": 1004,
            "speakerName": "卡胡鲁",
            "text": "无需惊讶，这是我们部族使用的诸多秘术之一。"
          }
        }
      }
    },
    {
      "subId": "1502404",
      "subQuestName": "前往曜石祭场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1502405",
      "subQuestName": "面见烟谜主首领",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150240501"
        ],
        "dialogs": {
          "150240501": {
            "id": "150240501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，刚刚那是什么？",
            "nextDialogs": [
              "150240502"
            ]
          },
          "150240502": {
            "id": "150240502",
            "speakerId": 1004,
            "speakerName": "卡胡鲁",
            "text": "那是我们祭司的日常工作之一，我们尝试与先祖的灵魂获得联系，并寻求启示。",
            "nextDialogs": [
              "150240503"
            ]
          },
          "150240503": {
            "id": "150240503",
            "speakerId": 1004,
            "speakerName": "卡胡鲁",
            "text": "首领就在那边，容我先禀报一下，请两位在此稍候。",
            "nextDialogs": [
              "150240504"
            ]
          },
          "150240504": {
            "id": "150240504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "该怎么说呢，烟谜主这个部族果然好神秘啊。",
            "nextDialogs": [
              "150240505"
            ]
          },
          "150240505": {
            "id": "150240505",
            "speakerId": 1004,
            "speakerName": "卡胡鲁",
            "text": "我已向首领禀明情况，两位请随我去面见首领吧。",
            "nextDialogs": [
              "150240506"
            ]
          },
          "150240506": {
            "id": "150240506",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "两位就是谕示所指向的人选吧？我是烟谜主的现任首领庇兰，有失远迎。",
            "nextDialogs": [
              "150240507"
            ]
          },
          "150240507": {
            "id": "150240507",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好高…",
            "nextDialogs": [
              "150240508"
            ]
          },
          "150240508": {
            "id": "150240508",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "我生来就拥有异于常人的体型，请勿见怪。",
            "nextDialogs": [
              "150240509"
            ]
          },
          "150240509": {
            "id": "150240509",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "当然不会！我刚刚只是有些惊讶，抱歉…",
            "nextDialogs": [
              "150240510"
            ]
          },
          "150240510": {
            "id": "150240510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问「谕示」是什么？",
            "nextDialogs": [
              "150240511"
            ]
          },
          "150240511": {
            "id": "150240511",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "具体情况卡胡鲁已经向我说明，我能理解两位的疑惑。两位是外来的客人，自然不了解这种「谕示」。",
            "nextDialogs": [
              "150240512"
            ]
          },
          "150240512": {
            "id": "150240512",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "在之前漫长的历史中，这项「谕示」所选中的都是烟谜主内部的族人。外族人被选中的情况，这还是第一次。",
            "nextDialogs": [
              "150240513"
            ]
          },
          "150240513": {
            "id": "150240513",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦？",
            "nextDialogs": [
              "150240514"
            ]
          },
          "150240514": {
            "id": "150240514",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "请容我说明一下，我们烟谜主有一个古老的传统，那就是制作织物来记载纳塔的历史。",
            "nextDialogs": [
              "150240515"
            ]
          },
          "150240515": {
            "id": "150240515",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "并且我们不只记录本族的历史，其他部族的传说故事和英雄事迹也会被纳入记录的范围。",
            "nextDialogs": [
              "150240516"
            ]
          },
          "150240516": {
            "id": "150240516",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "上千年来都是如此，我们将此视为自己的一项使命。",
            "nextDialogs": [
              "150240517"
            ]
          },
          "150240517": {
            "id": "150240517",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "不过，如果是那种影响了整个纳塔的大事件，就需要一种极为特殊的织物来记录。",
            "nextDialogs": [
              "150240518"
            ]
          },
          "150240518": {
            "id": "150240518",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "而这种织物只有暝视龙大长老指定的人才能完成。",
            "nextDialogs": [
              "150240519"
            ]
          },
          "150240519": {
            "id": "150240519",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "当暝视龙大长老观测到地脉的重大变化后，它就会发出一种谕示，指定制作这种织物的人选。",
            "nextDialogs": [
              "150240520"
            ]
          },
          "150240520": {
            "id": "150240520",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也就是说…",
            "nextDialogs": [
              "150240521"
            ]
          },
          "150240521": {
            "id": "150240521",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "现任的特拉波长老很早就察觉到了地脉的变化，但两位到来后，它才指定了制作织物的人选。",
            "nextDialogs": [
              "150240522"
            ]
          },
          "150240522": {
            "id": "150240522",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#原来是这样…但是，我和{NICKNAME}根本不知道如何制作这种织物啊…",
            "nextDialogs": [
              "150240523"
            ]
          },
          "150240523": {
            "id": "150240523",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "对于这一点，我并不惊讶。",
            "nextDialogs": [
              "150240524"
            ]
          },
          "150240524": {
            "id": "150240524",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "150240525"
            ]
          },
          "150240525": {
            "id": "150240525",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "特拉波长老在大约两百年前继任，同时也接过了这个确定人选的职责，而它选中的人都不了解如何制作这种织物。",
            "nextDialogs": [
              "150240526"
            ]
          },
          "150240526": {
            "id": "150240526",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那这两百年来的历史大事件都没有记录吗？",
            "nextDialogs": [
              "150240527"
            ]
          },
          "150240527": {
            "id": "150240527",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "不，那些人都按时交出了成果，只是他们大多声称那不是自己制作的，而是得到了「神灵的馈赠」。",
            "nextDialogs": [
              "150240528"
            ]
          },
          "150240528": {
            "id": "150240528",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这…烟谜主这个部族果然好神秘啊。",
            "nextDialogs": [
              "150240529"
            ]
          },
          "150240529": {
            "id": "150240529",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "不过，这正是让我困扰的地方。",
            "nextDialogs": [
              "150240530"
            ]
          },
          "150240530": {
            "id": "150240530",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "记录历史这么重要的事情，如果只能寄希望于「神灵的馈赠」这种谜一样的事物，实在无法令人安心。",
            "nextDialogs": [
              "150240531"
            ]
          },
          "150240531": {
            "id": "150240531",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃，听到烟谜主的首领这么说，真的有些意外啊…",
            "nextDialogs": [
              "150240532"
            ]
          },
          "150240532": {
            "id": "150240532",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "我理解两位的想法，想必在两位看来，烟谜主的人都充满了神秘感，他们推崇的肯定都是难以言明的事物。",
            "nextDialogs": [
              "150240533"
            ]
          },
          "150240533": {
            "id": "150240533",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "而我确实是个异类，虽然身为烟谜主的首领，但我主张针对这些传统做出变革。",
            "nextDialogs": [
              "150240534"
            ]
          },
          "150240534": {
            "id": "150240534",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "我致力于解析各种神秘的事物，因为这样就可以建立明确的规则，进而更长久地维护部族的传承。",
            "nextDialogs": [
              "150240535"
            ]
          },
          "150240535": {
            "id": "150240535",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，听上去好厉害…那你解析了「神灵的馈赠」？",
            "nextDialogs": [
              "150240536"
            ]
          },
          "150240536": {
            "id": "150240536",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "不…我调查了很久，也没有查清「神灵的馈赠」指的是什么。",
            "nextDialogs": [
              "150240537"
            ]
          },
          "150240537": {
            "id": "150240537",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "需要用那种织物来记录的大事件屈指可数，彼此之间的时间间隔都在几十年以上。",
            "nextDialogs": [
              "150240538"
            ]
          },
          "150240538": {
            "id": "150240538",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "等到下一个谕示被发出的时候，首领已经换了一代人，根本没机会针对此事进行深入的调查。",
            "nextDialogs": [
              "150240539"
            ]
          },
          "150240539": {
            "id": "150240539",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那…",
            "nextDialogs": [
              "150240540"
            ]
          },
          "150240540": {
            "id": "150240540",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "我虽然没有查清事情的全貌，但还是获得了一些进展。只是，我需要被选中的人配合我验证一些猜测。",
            "nextDialogs": [
              "150240541"
            ]
          },
          "150240541": {
            "id": "150240541",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以我们要接受测试…",
            "nextDialogs": [
              "150240542"
            ]
          },
          "150240542": {
            "id": "150240542",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "正是如此。不过两位无需担忧，这个测试只是为了验证我的猜测，既不会过多耗费两位的心力，也不会带来任何危险。",
            "nextDialogs": [
              "150240543"
            ]
          },
          "150240543": {
            "id": "150240543",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那具体是什么样的测试？",
            "nextDialogs": [
              "150240544"
            ]
          },
          "150240544": {
            "id": "150240544",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "我可以带领两位前往测试地点并进行说明，但请两位稍候，容我先脱下这件「覆魂之羽」。",
            "nextDialogs": [
              "150240545"
            ]
          },
          "150240545": {
            "id": "150240545",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "这是历代首领传承下来的圣物，只有在主持祭祀时才能穿着。",
            "nextDialogs": [
              "150240546"
            ]
          },
          "150240546": {
            "id": "150240546",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦…",
            "nextDialogs": [
              "150240547"
            ]
          },
          "150240547": {
            "id": "150240547",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "庇兰脱下了身上的羽织，小心地交予一名祭司收存。",
            "nextDialogs": [
              "150240548"
            ]
          },
          "150240548": {
            "id": "150240548",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "请随我来。",
            "nextDialogs": [
              "150240549"
            ]
          },
          "150240549": {
            "id": "150240549",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "两位看到这面织物了吗？接触它，两位就可以进入一个秘密的空间。",
            "nextDialogs": [
              "150240550"
            ]
          },
          "150240550": {
            "id": "150240550",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "而两位要接受的测试，就是想办法从那个空间中脱身。",
            "nextDialogs": [
              "150240551"
            ]
          },
          "150240551": {
            "id": "150240551",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这样就行？",
            "nextDialogs": [
              "150240552"
            ]
          },
          "150240552": {
            "id": "150240552",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "请不要小看这个测试，如果实在找不到脱身之法，我会亲自帮助两位回到这里。",
            "nextDialogs": [
              "150240553"
            ]
          },
          "150240553": {
            "id": "150240553",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "只是那样的话，这个谕示就仍旧是一道难解的谜题…",
            "nextDialogs": [
              "150240554"
            ]
          },
          "150240554": {
            "id": "150240554",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先让我们试试吧。",
            "nextDialogs": [
              "150240555"
            ]
          },
          "150240555": {
            "id": "150240555",
            "speakerId": 1005,
            "speakerName": "庇兰",
            "text": "好，两位可以主动接触那面织物来开始测试。"
          }
        }
      }
    },
    {
      "subId": "1502409",
      "subQuestName": "接受测试",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150240901"
        ],
        "dialogs": {
          "150240901": {
            "id": "150240901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里有好多织物啊，有一些我记得在其他部族见过，好像是用来记载历史事件的。",
            "nextDialogs": [
              "150240902"
            ]
          },
          "150240902": {
            "id": "150240902",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这面织物好特别，光是面幅就比其他织物大好多，不知道它又讲了什么样的故事…",
            "nextDialogs": [
              "150240903"
            ]
          },
          "150240903": {
            "id": "150240903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它的色彩也很特别…",
            "nextDialogs": [
              "150240904"
            ]
          },
          "150240904": {
            "id": "150240904",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "确实如此…",
            "nextDialogs": [
              "150240905"
            ]
          },
          "150240905": {
            "id": "150240905",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#刚刚那边有什么闪了一下！{NICKNAME}，你看到了吗？",
            "nextDialogs": [
              "150240906"
            ]
          },
          "150240906": {
            "id": "150240906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许出去的办法...",
            "nextDialogs": [
              "150240907"
            ]
          },
          "150240907": {
            "id": "150240907",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就是看到原本看不到的东西。",
            "nextDialogs": [
              "150240908"
            ]
          },
          "150240908": {
            "id": "150240908",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦，我懂了！"
          }
        }
      }
    },

    {
      "subId": "7301603",
      "subQuestName": "与兰百梨迦对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730160301"
        ],
        "dialogs": {
          "730160301": {
            "id": "730160301",
            "speakerId": 1000,
            "speakerName": "兰百梨迦",
            "text": "那菈…和会飞的？",
            "nextDialogs": [
              "730160302"
            ]
          },
          "730160302": {
            "id": "730160302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#对啦，我是会飞的派蒙，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是{NICKNAME}。",
            "nextDialogs": [
              "730160303"
            ]
          },
          "730160303": {
            "id": "730160303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你应该就是兰百梨迦了吧，话说回来，你一点也不怕我们呢。",
            "nextDialogs": [
              "730160304"
            ]
          },
          "730160304": {
            "id": "730160304",
            "speakerId": 1000,
            "speakerName": "兰百梨迦",
            "text": "金色的那菈，有兰般度的气息。",
            "nextDialogs": [
              "730160305"
            ]
          },
          "730160305": {
            "id": "730160305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，这个嘛，的确是兰般度让我们来的…",
            "nextDialogs": [
              "730160306"
            ]
          },
          "730160306": {
            "id": "730160306",
            "speakerId": 1000,
            "speakerName": "兰百梨迦",
            "text": "感受不到恶意。想对我下手，应该趁大铁块还能动的时候。",
            "nextDialogs": [
              "730160307"
            ]
          },
          "730160307": {
            "id": "730160307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "确实，这就叫「趁兰那罗之危」吗…不对不对，我们才不会做那种事啦。",
            "nextDialogs": [
              "730160308"
            ]
          },
          "730160308": {
            "id": "730160308",
            "speakerId": 1000,
            "speakerName": "兰百梨迦",
            "text": "为什么不做？如果我是敌人，包夹敌人是好的方法，连动物捕猎时都会用。",
            "nextDialogs": [
              "730160309"
            ]
          },
          "730160309": {
            "id": "730160309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…好有道理…",
            "nextDialogs": [
              "730160310"
            ]
          },
          "730160310": {
            "id": "730160310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙糊涂啦。",
            "nextDialogs": [
              "730160311"
            ]
          },
          "730160311": {
            "id": "730160311",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…总之，总之！我们肯定不会「趁兰那罗之危」就对了！",
            "nextDialogs": [
              "730160312"
            ]
          },
          "730160312": {
            "id": "730160312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为兰那罗是朋友。",
            "nextDialogs": [
              "730160313"
            ]
          },
          "730160313": {
            "id": "730160313",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#对对对，就是这个，因为兰那罗都是朋友！我和{NICKNAME}是不会做对不起朋友的事情的！",
            "nextDialogs": [
              "730160314"
            ]
          },
          "730160314": {
            "id": "730160314",
            "speakerId": 1000,
            "speakerName": "兰百梨迦",
            "text": "哼。",
            "nextDialogs": [
              "730160315"
            ]
          },
          "730160315": {
            "id": "730160315",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…怎么感觉他好像很不满意的样子…",
            "nextDialogs": [
              "730160317",
              "730160319"
            ]
          },
          "730160317": {
            "id": "730160317",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可是我也没觉得自己做错了什么呀…唔…兰那罗的脾气真难捉摸…",
            "nextDialogs": [
              "730160320"
            ]
          },
          "730160320": {
            "id": "730160320",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对了，兰般度说过，兰百梨迦的「兰迦拉梨」非常厉害。刚才他能够击败遗迹守卫，一定就是靠的「兰迦拉梨」吧！",
            "nextDialogs": [
              "730160321"
            ]
          },
          "730160321": {
            "id": "730160321",
            "speakerId": 1000,
            "speakerName": "兰百梨迦",
            "text": "派蒙知道兰迦拉梨？",
            "nextDialogs": [
              "730160322"
            ]
          },
          "730160322": {
            "id": "730160322",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…哦、哦！我当然知道啦！就是…就是那个嘛！很厉害很厉害的…什么能力！",
            "nextDialogs": [
              "730160323"
            ]
          },
          "730160323": {
            "id": "730160323",
            "speakerId": 1000,
            "speakerName": "兰百梨迦",
            "text": "哼。",
            "nextDialogs": [
              "730160324"
            ]
          },
          "730160324": {
            "id": "730160324",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！感觉又被瞧不起了…",
            "nextDialogs": [
              "730160325"
            ]
          },
          "730160325": {
            "id": "730160325",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是说正事吧。",
            "nextDialogs": [
              "730160326"
            ]
          },
          "730160326": {
            "id": "730160326",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯…我们是来帮忙治好法留纳神机的！这里应该也有法留纳神机的「枝」和「叶」吧，不过好像没看到呢。",
            "nextDialogs": [
              "730160327"
            ]
          },
          "730160327": {
            "id": "730160327",
            "speakerId": 1000,
            "speakerName": "兰百梨迦",
            "text": "什么「枝」和「叶」，更像是「根」才对。",
            "nextDialogs": [
              "730160328"
            ]
          },
          "730160328": {
            "id": "730160328",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "诶？是这样吗？可是兰般度说…",
            "nextDialogs": [
              "730160329"
            ]
          },
          "730160329": {
            "id": "730160329",
            "speakerId": 1000,
            "speakerName": "兰百梨迦",
            "text": "有了遍布桓那的「根系」，法留纳神机才能从桓那获得力量。",
            "nextDialogs": [
              "730160330"
            ]
          },
          "730160330": {
            "id": "730160330",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦…好像也有点道理…",
            "nextDialogs": [
              "730160331"
            ]
          },
          "730160331": {
            "id": "730160331",
            "speakerId": 1000,
            "speakerName": "兰百梨迦",
            "text": "而且，「根」在地下。",
            "nextDialogs": [
              "730160332"
            ]
          },
          "730160332": {
            "id": "730160332",
            "speakerId": 1000,
            "speakerName": "兰百梨迦",
            "text": "这里的石头和铁块，不属于兰那罗。要下去，得先打败铁块。铁块很强，但是金色的那菈也不弱。",
            "nextDialogs": [
              "730160333"
            ]
          },
          "730160333": {
            "id": "730160333",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#那是当然，{NICKNAME}已经不知道打败过多少大铁块啦。",
            "nextDialogs": [
              "730160334"
            ]
          },
          "730160334": {
            "id": "730160334",
            "speakerId": 1000,
            "speakerName": "兰百梨迦",
            "text": "哦？那就让兰百梨迦也见识一下那菈的本领！",
            "nextDialogs": [
              "730160335"
            ]
          },
          "730160335": {
            "id": "730160335",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "诶？！他怎么钻进土里了…啊！难道是已经去遗迹守卫那边了吗？",
            "nextDialogs": [
              "730160336"
            ]
          },
          "730160336": {
            "id": "730160336",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们快跟上他吧！"
          },
          "730160319": {
            "id": "730160319",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么会这样呢？明明外表这样可爱，脾气却这么坏…"
          }
        }
      }
    },
    {
      "subId": "7301604",

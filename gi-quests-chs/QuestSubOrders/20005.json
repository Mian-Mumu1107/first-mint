  "subQuests": [
    {
      "subId": "2000501",
      "subQuestName": "前往询问怀尔德",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200050101"
        ],
        "dialogs": {
          "200050101": {
            "id": "200050101",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "旅行者，你，你来的正好。",
            "nextDialogs": [
              "200050102"
            ]
          },
          "200050102": {
            "id": "200050102",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "我本来是要把这车货送去蒙德城。昨天晚上走到这里的时候，看见了几团亮亮的东西。",
            "nextDialogs": [
              "200050103"
            ]
          },
          "200050103": {
            "id": "200050103",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "因为喝的太多，我…我突然很想去看看那是什么，过去了之后，却发现是一大堆史莱姆，我还被狠狠撞了几下。",
            "nextDialogs": [
              "200050104"
            ]
          },
          "200050104": {
            "id": "200050104",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "我很害怕，但是又找不到方向，跑了半天才回到了车旁边。今天早上，我发现我的<color=#00E1FFFF>钥匙</color>不见了…",
            "nextDialogs": [
              "200050105"
            ]
          },
          "200050105": {
            "id": "200050105",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "你能帮我找找吗？肯定就在这周围，我觉得…肯定就在旁边。",
            "nextDialogs": [
              "200050107",
              "200050109"
            ]
          },
          "200050107": {
            "id": "200050107",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "太好了，这么大片地方，我都不知道从何下手了。"
          },
          "200050109": {
            "id": "200050109",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "这么大片地方，我可从哪下手啊，这件事只有你能办到，拜托了！"
          }
        }
      }
    },
    {
      "subId": "2000502",
      "subQuestName": "用元素视野寻找钥匙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200050201"
        ],
        "dialogs": {
          "200050201": {
            "id": "200050201",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "你找到钥匙了吗？",
            "nextDialogs": [
              "200050202"
            ]
          },
          "200050202": {
            "id": "200050202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "抱歉，还没有。",
            "nextDialogs": [
              "200050203"
            ]
          },
          "200050203": {
            "id": "200050203",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "这地方果然还是太大了啊…拜托你了！"
          }
        }
      }
    },
    {
      "subId": "2000504",
      "subQuestName": "把钥匙交给怀尔德",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200050401"
        ],
        "dialogs": {
          "200050401": {
            "id": "200050401",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "钥匙找到了吗？",
            "nextDialogs": [
              "200050402"
            ]
          },
          "200050402": {
            "id": "200050402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是你丢的钥匙吗？",
            "nextDialogs": [
              "200050403"
            ]
          },
          "200050403": {
            "id": "200050403",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "没错！就是这把，我以后可不能…嗯，以后要喝少点了。",
            "nextDialogs": [
              "200050404"
            ]
          },
          "200050404": {
            "id": "200050404",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "哦，还有，请收下这些吧，谢谢你们帮忙。"
          }
        }
      }
    }
  ]
}
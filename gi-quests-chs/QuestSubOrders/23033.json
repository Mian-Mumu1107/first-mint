{
  "lineCounts": {
    "Player": 36,
    "派蒙": 2,
    "福本": 140
  },
  "subQuests": [
    {
      "subId": "2303301",
      "subQuestName": "与福本对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230330101"
        ],
        "dialogs": {
          "230330101": {
            "id": "230330101",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "旅行者！又见面了，上次多亏你帮忙，朝雾小姐的插画创作得很顺利。",
            "nextDialogs": [
              "230330104"
            ]
          },
          "230330104": {
            "id": "230330104",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "是啊，教令院的那帮学者还在讨论一些制作细节呢。",
            "nextDialogs": [
              "230330105"
            ]
          },
          "230330105": {
            "id": "230330105",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "有的学者说，既然是新版，那玩法就要有创意，游戏的资源系统也要有创意。",
            "nextDialogs": [
              "230330106"
            ]
          },
          "230330106": {
            "id": "230330106",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "有的学者说，卡牌游戏一定要有精美的卡面，所以他要求把预算拨去雇更多的画家。",
            "nextDialogs": [
              "230330107"
            ]
          },
          "230330107": {
            "id": "230330107",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "还有一位就更离谱了…他希望在所有参与制作「七圣召唤」的学者之间举办一场对战比赛。",
            "nextDialogs": [
              "230330108"
            ]
          },
          "230330108": {
            "id": "230330108",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "谁能赢得冠军，谁的意见就更有份量。我看这个人就是单纯地想要玩「七圣召唤」而已。",
            "nextDialogs": [
              "230330109"
            ]
          },
          "230330109": {
            "id": "230330109",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "他们的讨论我几乎都听不懂，所以就借口取材跑了出来。",
            "nextDialogs": [
              "230330110"
            ]
          },
          "230330110": {
            "id": "230330110",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "旅行者，你能再给我当一回模特吗？",
            "nextDialogs": [
              "230330111"
            ]
          },
          "230330111": {
            "id": "230330111",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "这次我没什么特别的要求，只需要你为我展示一下你的战斗技巧就好。"
          }
        }
      }
    },
    {
      "subId": "2303302",
      "subQuestName": "前往取景地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2303303",
      "subQuestName": "与福本对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230330301"
        ],
        "dialogs": {
          "230330301": {
            "id": "230330301",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "就是这里了！你看前面，有几个零星的史莱姆。",
            "nextDialogs": [
              "230330302"
            ]
          },
          "230330302": {
            "id": "230330302",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "旅行者，请你用你认为最帅气的方式，一口气打倒它们吧！",
            "nextDialogs": [
              "230330303"
            ]
          },
          "230330303": {
            "id": "230330303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这真的能用在卡牌游戏小说里吗？",
            "nextDialogs": [
              "230330304"
            ]
          },
          "230330304": {
            "id": "230330304",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "哎呀，放心吧，虽然我写的小说里大部分事情都能靠打牌解决。",
            "nextDialogs": [
              "230330305"
            ]
          },
          "230330305": {
            "id": "230330305",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "但总有一些不能靠打牌解决的事，需要角色们运用一些「现实性」手段。",
            "nextDialogs": [
              "230330306"
            ]
          },
          "230330306": {
            "id": "230330306",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "那就拜托你了，旅行者。我会在这边看着的。"
          }
        }
      }
    },
    {
      "subId": "2303304",
      "subQuestName": "打倒所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2303305",
      "subQuestName": "与福本对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230330501"
        ],
        "dialogs": {
          "230330501": {
            "id": "230330501",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "太好了，非常好！这些画片肯定够朝雾再画好几张了。",
            "nextDialogs": [
              "230330504"
            ]
          },
          "230330504": {
            "id": "230330504",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "哈哈哈…我会把你的愿望转达给学者们的。",
            "nextDialogs": [
              "230330505"
            ]
          },
          "230330505": {
            "id": "230330505",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "不过，这群学者们的研究似乎进行得很顺利，现在他们讨论的时候都能打打趣了。",
            "nextDialogs": [
              "230330506"
            ]
          },
          "230330506": {
            "id": "230330506",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "不像最开始，咳…剑拔弩张的…"
          }
        }
      }
    },
    {
      "subId": "2303306",
      "subQuestName": "与福本对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230330601"
        ],
        "dialogs": {
          "230330601": {
            "id": "230330601",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "坏了，这下真的被这帮须弥人给骗惨了…",
            "nextDialogs": [
              "230330602"
            ]
          },
          "230330602": {
            "id": "230330602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你被骗钱了？",
            "nextDialogs": [
              "230330603"
            ]
          },
          "230330603": {
            "id": "230330603",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "哎哟！你…你吓我一跳！",
            "nextDialogs": [
              "230330604"
            ]
          },
          "230330604": {
            "id": "230330604",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "唉，我倒是没有被骗钱，就是被教令院里的那群人给骗来了须弥…",
            "nextDialogs": [
              "230330605"
            ]
          },
          "230330605": {
            "id": "230330605",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "还没自我介绍…我叫福本，是一个稻妻的小说家。",
            "nextDialogs": [
              "230330606"
            ]
          },
          "230330606": {
            "id": "230330606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你说你被骗了？",
            "nextDialogs": [
              "230330607"
            ]
          },
          "230330607": {
            "id": "230330607",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "这事情说来话长…你听说教令院研发出的卡牌游戏「七圣召唤」吗？",
            "nextDialogs": [
              "230330610"
            ]
          },
          "230330610": {
            "id": "230330610",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "你没听说过？不应该啊，你没看过我写的那本《召唤王》吗？在「八重堂」里可是卖得很好的。",
            "nextDialogs": [
              "230330611"
            ]
          },
          "230330611": {
            "id": "230330611",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "呃…《召唤王》也没看过？没，没问题，不用管这些！",
            "nextDialogs": [
              "230330612"
            ]
          },
          "230330612": {
            "id": "230330612",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "总之，就是须弥教令院里的人研发了一种名为「七圣召唤」的卡牌游戏。",
            "nextDialogs": [
              "230330613"
            ]
          },
          "230330613": {
            "id": "230330613",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "为了推广，他们就通过「八重堂」来拜托我，以「七圣召唤」这种卡牌游戏的规则为蓝本，写一本轻小说。",
            "nextDialogs": [
              "230330614"
            ]
          },
          "230330614": {
            "id": "230330614",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "因为那群学者自己都没把「七圣召唤」的规则梳理清楚，加上须弥和稻妻离得太远，我们难以沟通，所以写起来非常艰难…",
            "nextDialogs": [
              "230330615"
            ]
          },
          "230330615": {
            "id": "230330615",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "不过在「八重堂」内诸位老师的帮助下，我还是完成了《召唤王》，不仅销量不错，而且还和计划中一样带动了「七圣召唤」的销量。",
            "nextDialogs": [
              "230330616"
            ]
          },
          "230330616": {
            "id": "230330616",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "然后，重点来了…那群学者说，他们要重新梳理一遍「七圣召唤」的规则，再对外推出一版全新的「七圣召唤」。",
            "nextDialogs": [
              "230330617"
            ]
          },
          "230330617": {
            "id": "230330617",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "他们也再次拜托我以新版的「七圣召唤」为蓝本续写《召唤王》，并且邀请我来须弥教令院面对面沟通。",
            "nextDialogs": [
              "230330618"
            ]
          },
          "230330618": {
            "id": "230330618",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "我从稻妻长途跋涉来了须弥，但学者们说…新版「七圣召唤」的规则他们还没有确定下来，请我先在须弥暂住一段时间。",
            "nextDialogs": [
              "230330619"
            ]
          },
          "230330619": {
            "id": "230330619",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "他们说为了致歉，还会帮我介绍几个教令院里的名人作为我取材的对象，比如那位赛诺先生，还有提纳里先生…",
            "nextDialogs": [
              "230330620"
            ]
          },
          "230330620": {
            "id": "230330620",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "我本来有点生气，但是那群学者…每个人都是一副严重睡眠不足的样子，接待我的那位学者简直站都站不稳了…",
            "nextDialogs": [
              "230330621"
            ]
          },
          "230330621": {
            "id": "230330621",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "唉，我想了想，本来我的大纲就还没有确定，再等一段时间也没什么大问题，就答应了他们暂时住在须弥，等他们把新规则确定下来。",
            "nextDialogs": [
              "230330622"
            ]
          },
          "230330622": {
            "id": "230330622",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "这不，我今天就是出来取材的。",
            "nextDialogs": [
              "230330623"
            ]
          },
          "230330623": {
            "id": "230330623",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "旅行者，你愿意帮我一个忙吗？"
          }
        }
      }
    },
    {
      "subId": "2303307",
      "subQuestName": "前往取景地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2303308",
      "subQuestName": "与福本对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230330801"
        ],
        "dialogs": {
          "230330801": {
            "id": "230330801",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "就是这里了，让我看看…首先，我需要一个…",
            "nextDialogs": [
              "230330802"
            ]
          },
          "230330802": {
            "id": "230330802",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "角色陷入困境中的姿势…",
            "nextDialogs": [
              "230330803"
            ]
          },
          "230330803": {
            "id": "230330803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这描述也太模糊了，完全不知道要摆出什么样的姿势啊！",
            "nextDialogs": [
              "230330804"
            ]
          },
          "230330804": {
            "id": "230330804",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "这个…就按照你的第一反应来摆姿势就好。",
            "nextDialogs": [
              "230330805"
            ]
          },
          "230330805": {
            "id": "230330805",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "旅行者，当你遇见困境的时候，你会做出什么样的反应？",
            "nextDialogs": [
              "230330807",
              "230330813"
            ]
          },
          "230330807": {
            "id": "230330807",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "嚯，很有气势的回答，面对困境的第一反应是战斗…那就请你摆出一个有力的战斗姿态来吧！",
            "nextDialogs": [
              "230330808"
            ]
          },
          "230330808": {
            "id": "230330808",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "就是那种…你已经陷入困境，必须要开始挣扎了的感觉。",
            "nextDialogs": [
              "230330809"
            ]
          },
          "230330809": {
            "id": "230330809",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "这场战斗就是你为了活下去而做出的挣扎！为了活下去而不得不做出的选择！",
            "nextDialogs": [
              "230330810"
            ]
          },
          "230330810": {
            "id": "230330810",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "咳！这都是我为角色设计的台词…但总之，差不多就是这样的一种感觉。",
            "nextDialogs": [
              "230330811"
            ]
          },
          "230330811": {
            "id": "230330811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔唔…真有角色会说出这种话来吗…"
          },
          "230330813": {
            "id": "230330813",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "喔！你这个回答很有傲气啊，很不错，正好能和我小说里的一个人对上！",
            "nextDialogs": [
              "230330814"
            ]
          },
          "230330814": {
            "id": "230330814",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "那就拜托你摆出一个，很有傲气的姿势吧！"
          }
        }
      }
    },
    {
      "subId": "2303309",
      "subQuestName": "前往取景地，摆好姿势",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2303310",
      "subQuestName": "与福本对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230331001"
        ],
        "dialogs": {
          "230331001": {
            "id": "230331001",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "真不错！真不错，这些画片肯定足够朝雾小姐参考了。这样子也算是暂时解决插画问题了…",
            "nextDialogs": [
              "230331002"
            ]
          },
          "230331002": {
            "id": "230331002",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "谢谢你，旅行者，这些报酬就请你收下吧。",
            "nextDialogs": [
              "230331003"
            ]
          },
          "230331003": {
            "id": "230331003",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "我得再回教令院一趟，看看怎么把这些画片寄回去给朝雾小姐。",
            "nextDialogs": [
              "230331004"
            ]
          },
          "230331004": {
            "id": "230331004",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "听说朝雾小姐最近被很多人约稿，哈哈哈，我也得快点去抢她的排期了。",
            "nextDialogs": [
              "230331005"
            ]
          },
          "230331005": {
            "id": "230331005",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "唔，这张不错，这张也很好…"
          }
        }
      }
    },
    {
      "subId": "2303380",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230338001"
        ],
        "dialogs": {
          "230338001": {
            "id": "230338001",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "唉，这群学者的身体，真的没问题吗…",
            "nextDialogs": [
              "230338002"
            ]
          },
          "230338002": {
            "id": "230338002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "学者怎么了？",
            "nextDialogs": [
              "230338003"
            ]
          },
          "230338003": {
            "id": "230338003",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "咳，别提了。还不是「七圣召唤」的事，那群学者成天不眠不休的研究，我真担心「七圣召唤」的规则没出来，他们自己的身体先垮了。",
            "nextDialogs": [
              "230338004"
            ]
          },
          "230338004": {
            "id": "230338004",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "不过，他们似乎已经设计出了游戏规则的大框架，我总算是有能参考的东西了。",
            "nextDialogs": [
              "230338005"
            ]
          },
          "230338005": {
            "id": "230338005",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "我是不懂他们的工作…只能让学者们自己努力了。",
            "nextDialogs": [
              "230338006"
            ]
          },
          "230338006": {
            "id": "230338006",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "至于我嘛…还是得接着解决小说的插画问题。",
            "nextDialogs": [
              "230338007"
            ]
          },
          "230338007": {
            "id": "230338007",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "上次多亏了你帮忙，朝雾小姐已经画了几张不错的插画。",
            "nextDialogs": [
              "230338008"
            ]
          },
          "230338008": {
            "id": "230338008",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "旅行者，如果你愿意帮忙的话，能再来做一次模特吗？",
            "nextDialogs": [
              "230338010",
              "230338012"
            ]
          },
          "230338010": {
            "id": "230338010",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "多谢啦，我会准备好报酬的。",
            "nextDialogs": [
              "230338017"
            ]
          },
          "230338017": {
            "id": "230338017",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "我已经找到了一个不错的取景地，就在附近。",
            "nextDialogs": [
              "230338018"
            ]
          },
          "230338018": {
            "id": "230338018",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "等我收拾一下留影机，咱们就出发。"
          },
          "230338012": {
            "id": "230338012",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "那个啊…他们说已经在联系了，不过赛诺先生和提纳里先生似乎工作很忙，暂时没什么空过来做模特。",
            "nextDialogs": [
              "230338013"
            ]
          },
          "230338013": {
            "id": "230338013",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "不过我听说，赛诺先生可是玩「七圣召唤」的好手。",
            "nextDialogs": [
              "230338014"
            ]
          },
          "230338014": {
            "id": "230338014",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "要是能让他拿着卡牌，在牌桌前摆出一个帅气的姿势的话…",
            "nextDialogs": [
              "230338015"
            ]
          },
          "230338015": {
            "id": "230338015",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "算了，我们还是现实点吧。",
            "nextDialogs": [
              "230338016"
            ]
          },
          "230338016": {
            "id": "230338016",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "那做模特的事就拜托你了，旅行者。我会准备好报酬的。"
          }
        }
      }
    },
    {
      "subId": "2303381",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230338101"
        ],
        "dialogs": {
          "230338101": {
            "id": "230338101",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "唉，这群学者的身体，真的没问题吗…",
            "nextDialogs": [
              "230338102"
            ]
          },
          "230338102": {
            "id": "230338102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "学者怎么了？",
            "nextDialogs": [
              "230338103"
            ]
          },
          "230338103": {
            "id": "230338103",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "咳，别提了。还不是「七圣召唤」的事，那群学者成天不眠不休的研究，我真担心「七圣召唤」的规则没出来，他们自己的身体先垮了。",
            "nextDialogs": [
              "230338104"
            ]
          },
          "230338104": {
            "id": "230338104",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "不过，他们似乎已经设计出了游戏规则的大框架，我总算是有能参考的东西了。",
            "nextDialogs": [
              "230338105"
            ]
          },
          "230338105": {
            "id": "230338105",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "我是不懂他们的工作…只能让学者们自己努力了。",
            "nextDialogs": [
              "230338106"
            ]
          },
          "230338106": {
            "id": "230338106",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "至于我嘛…还是得接着解决小说的插画问题。",
            "nextDialogs": [
              "230338107"
            ]
          },
          "230338107": {
            "id": "230338107",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "上次多亏了你帮忙，朝雾小姐已经画了几张不错的插画。",
            "nextDialogs": [
              "230338108"
            ]
          },
          "230338108": {
            "id": "230338108",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "旅行者，如果你愿意帮忙的话，能再来做一次模特吗？",
            "nextDialogs": [
              "230338113",
              "230338111"
            ]
          },
          "230338113": {
            "id": "230338113",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "那做模特的事就拜托你了，旅行者。我会准备好报酬的。",
            "nextDialogs": [
              "230338114"
            ]
          },
          "230338114": {
            "id": "230338114",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "我已经找到了一个不错的取景地，就在附近。",
            "nextDialogs": [
              "230338115"
            ]
          },
          "230338115": {
            "id": "230338115",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "等我收拾一下留影机，咱们就出发。"
          },
          "230338111": {
            "id": "230338111",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "哎呀，好不容易来一趟须弥，我当然得多取一点材。",
            "nextDialogs": [
              "230338112"
            ]
          },
          "230338112": {
            "id": "230338112",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "顺便…还能躲一下我的编辑…咳！"
          }
        }
      }
    },
    {
      "subId": "2303382",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230338201"
        ],
        "dialogs": {
          "230338201": {
            "id": "230338201",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "真不错！真不错，这些画片肯定足够朝雾小姐参考了。这样子也算是暂时解决插画问题了…",
            "nextDialogs": [
              "230338202"
            ]
          },
          "230338202": {
            "id": "230338202",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "谢谢你，旅行者，这些报酬就请你收下吧。",
            "nextDialogs": [
              "230338203"
            ]
          },
          "230338203": {
            "id": "230338203",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "我得再回教令院一趟，看看怎么把这些画片寄回去给朝雾小姐。",
            "nextDialogs": [
              "230338204"
            ]
          },
          "230338204": {
            "id": "230338204",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "听说朝雾小姐最近被很多人约稿，哈哈哈，我也得快点去抢她的排期了。",
            "nextDialogs": [
              "230338205"
            ]
          },
          "230338205": {
            "id": "230338205",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "唔，这张不错，这张也很好…"
          }
        }
      }
    },
    {
      "subId": "2303383",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230338301"
        ],
        "dialogs": {
          "230338301": {
            "id": "230338301",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "坏了，这下真的被这帮须弥人给骗惨了…",
            "nextDialogs": [
              "230338302"
            ]
          },
          "230338302": {
            "id": "230338302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你被骗钱了？",
            "nextDialogs": [
              "230338303"
            ]
          },
          "230338303": {
            "id": "230338303",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "哎哟！你…你吓我一跳！",
            "nextDialogs": [
              "230338304"
            ]
          },
          "230338304": {
            "id": "230338304",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "唉，我倒是没有被骗钱，就是被教令院里的那群人给骗来了须弥…",
            "nextDialogs": [
              "230338305"
            ]
          },
          "230338305": {
            "id": "230338305",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "还没自我介绍…我叫福本，是一个稻妻的小说家。",
            "nextDialogs": [
              "230338306"
            ]
          },
          "230338306": {
            "id": "230338306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你说你被骗了？",
            "nextDialogs": [
              "230338307"
            ]
          },
          "230338307": {
            "id": "230338307",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "这事情说来话长…你听说过教令院研发出的卡牌游戏「七圣召唤」吧。",
            "nextDialogs": [
              "230338308"
            ]
          },
          "230338308": {
            "id": "230338308",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "我写的那本《召唤王》，你应该也看过…呃，至少听说过吧？",
            "nextDialogs": [
              "230338309"
            ]
          },
          "230338309": {
            "id": "230338309",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "咳…先不管这些了。总之，就是须弥教令院里的人研发了一种名为「七圣召唤」的卡牌游戏。",
            "nextDialogs": [
              "230338310"
            ]
          },
          "230338310": {
            "id": "230338310",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "为了推广，他们就通过「八重堂」来拜托我，以「七圣召唤」这种卡牌游戏的规则为蓝本，写一本轻小说。",
            "nextDialogs": [
              "230338311"
            ]
          },
          "230338311": {
            "id": "230338311",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "因为那群学者自己都没把「七圣召唤」的规则梳理清楚，加上须弥和稻妻离得太远，我们难以沟通，所以写起来非常艰难…",
            "nextDialogs": [
              "230338312"
            ]
          },
          "230338312": {
            "id": "230338312",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "不过在「八重堂」内诸位老师的帮助下，我还是完成了《召唤王》，不仅销量不错，而且还和计划中一样带动了「七圣召唤」的销量。",
            "nextDialogs": [
              "230338313"
            ]
          },
          "230338313": {
            "id": "230338313",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "然后，重点来了…那群学者说，他们要重新梳理一遍「七圣召唤」的规则，再对外推出一版全新的「七圣召唤」。",
            "nextDialogs": [
              "230338314"
            ]
          },
          "230338314": {
            "id": "230338314",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "他们也再次拜托我以新版的「七圣召唤」为蓝本续写《召唤王》，并且邀请我来须弥教令院面对面沟通。",
            "nextDialogs": [
              "230338315"
            ]
          },
          "230338315": {
            "id": "230338315",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "虽然在辛苦了很久之后，那群学者总算把「七圣召唤」的规则给确定下来了…",
            "nextDialogs": [
              "230338316"
            ]
          },
          "230338316": {
            "id": "230338316",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "但我的小说还没有完成，为了取材，我还得在须弥暂住一段时间。",
            "nextDialogs": [
              "230338317"
            ]
          },
          "230338317": {
            "id": "230338317",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "旅行者，你愿意帮我一个忙吗？",
            "nextDialogs": [
              "230338320"
            ]
          },
          "230338320": {
            "id": "230338320",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "是这样，为了让《召唤王》这本小说更有吸引力，我特意去拜托朝雾小姐来绘制插画。",
            "nextDialogs": [
              "230338321"
            ]
          },
          "230338321": {
            "id": "230338321",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "我已经想好了几个关键的情节，但除了文字描述外，我还要给朝雾小姐一点具体的姿势参考…",
            "nextDialogs": [
              "230338322"
            ]
          },
          "230338322": {
            "id": "230338322",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "但我可没什么战斗的经验，摆出来的几个姿势都软塌塌的，看起来一点精神都没有。",
            "nextDialogs": [
              "230338323"
            ]
          },
          "230338323": {
            "id": "230338323",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "旅行者，我看你肯定有丰富的战斗经验，能拜托你来做模特吗？你瞧，我还借了架「留影机」来…"
          }
        }
      }
    },
    {
      "subId": "2303384",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230338401"
        ],
        "dialogs": {

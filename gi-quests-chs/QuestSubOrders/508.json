  "subQuests": [
    {
      "subId": "50801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5080101"
        ],
        "dialogs": {
          "5080101": {
            "id": "5080101",
            "speakerId": 1000,
            "speakerName": "离岛告示板",
            "text": "此乃幕府所设离岛告示板，各种事务，尽皆公示。闲人请勿擅自张贴！"
          }
        }
      }
    },
    {
      "subId": "50802",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5080201"
        ],
        "dialogs": {
          "5080201": {
            "id": "5080201",
            "speakerId": 1001,
            "speakerName": "幕府公告",
            "text": "近日有行踪可疑之外国人士进入稻妻城区，游荡不定，可见动机险恶。",
            "nextDialogs": [
              "5080202"
            ]
          },
          "5080202": {
            "id": "5080202",
            "speakerId": 1001,
            "speakerName": "幕府公告",
            "text": "幕府特此通告：举报可疑人员可得重赏，包庇者必加严惩！",
            "nextDialogs": [
              "5080203"
            ]
          },
          "5080203": {
            "id": "5080203",
            "speakerId": 1001,
            "speakerName": "幕府公告",
            "text": "常道恢弘，鸣神永恒。"
          }
        }
      }
    },
    {
      "subId": "50803",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5080301"
        ],
        "dialogs": {
          "5080301": {
            "id": "5080301",
            "speakerId": 1002,
            "speakerName": "天领公告",
            "text": "「眼狩令」行动已近尾声，但仍有少数私藏「神之眼」者藏匿。",
            "nextDialogs": [
              "5080302"
            ]
          },
          "5080302": {
            "id": "5080302",
            "speakerId": 1002,
            "speakerName": "天领公告",
            "text": "谨遵九条天领奉行孝行大人命令，服从九条裟罗大人指挥，追捕行动将尽可能不使用暴力，不侵扰民众。",
            "nextDialogs": [
              "5080303"
            ]
          },
          "5080303": {
            "id": "5080303",
            "speakerId": 1002,
            "speakerName": "天领公告",
            "text": "请大家放下心来，天领奉行决不以执行公务为借口，侵扰各位正常生活。",
            "nextDialogs": [
              "5080304"
            ]
          },
          "5080304": {
            "id": "5080304",
            "speakerId": 1002,
            "speakerName": "天领公告",
            "text": "以个人与九条家之名誉，九条天领奉行孝行特此向市民保证。"
          }
        }
      }
    },
    {
      "subId": "50804",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5080401"
        ],
        "dialogs": {
          "5080401": {
            "id": "5080401",
            "speakerId": 1003,
            "speakerName": "荒泷天下独尊一斗！",
            "text": "「九条天狗！本大爷来到离岛了！你也别总是欺负外国人了！！」",
            "nextDialogs": [
              "5080402"
            ]
          },
          "5080402": {
            "id": "5080402",
            "speakerId": 1003,
            "speakerName": "荒泷天下独尊一斗！",
            "text": "「你揍的那一顿，给本大爷好好记着！」",
            "nextDialogs": [
              "5080403"
            ]
          },
          "5080403": {
            "id": "5080403",
            "speakerId": 1003,
            "speakerName": "荒泷天下独尊一斗！",
            "text": "「复仇决斗，你是躲不掉的！」",
            "nextDialogs": [
              "5080404"
            ]
          },
          "5080404": {
            "id": "5080404",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "烦死了！你这家伙不要满地乱涂乱画了！每次都翻来覆去地唠唠叨叨唠唠叨叨！",
            "nextDialogs": [
              "5080405"
            ]
          },
          "5080405": {
            "id": "5080405",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "如果想什么复仇决斗就尽管来吧！也不管什么有碍市容…等战争打完我就成全你！",
            "nextDialogs": [
              "5080406"
            ]
          },
          "5080406": {
            "id": "5080406",
            "speakerId": 1004,
            "speakerName": "回复",
            "text": "给我停手吧！如果我不是九条家的执事者，早就告你骚扰了！"
          }
        }
      }
    },
    {
      "subId": "50805",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5080501"
        ],
        "dialogs": {
          "5080501": {
            "id": "5080501",
            "speakerId": 1005,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但希望这件事能够周知。」",
            "nextDialogs": [
              "5080502"
            ]
          },
          "5080502": {
            "id": "5080502",
            "speakerId": 1005,
            "speakerName": "八重堂的平冢",
            "text": "「泷泽京传先生那本著名的《鹮巷物语》孤本最近被我不慎搞丢了。」",
            "nextDialogs": [
              "5080503"
            ]
          },
          "5080503": {
            "id": "5080503",
            "speakerId": 1005,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但八重大人非要让我到处刊出寻书启示，真是伤脑筋。」",
            "nextDialogs": [
              "5080504"
            ]
          },
          "5080504": {
            "id": "5080504",
            "speakerId": 1005,
            "speakerName": "八重堂的平冢",
            "text": "「想想那本书也真是可怜，也许飞散得到处都是了吧…想要找到不太可能了。」",
            "nextDialogs": [
              "5080505"
            ]
          },
          "5080505": {
            "id": "5080505",
            "speakerId": 1005,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但假如有人能够帮忙找全该书，八重堂将会十分感谢。」"
          }
        }
      }
    },
    {
      "subId": "50806",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5080601"
        ],
        "dialogs": {
          "5080601": {
            "id": "5080601",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "「锁国令」期间进入离岛的外国人请出示随身勘合证件，无法出示有效证件者禁止登岸。",
            "nextDialogs": [
              "5080602"
            ]
          },
          "5080602": {
            "id": "5080602",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "进入离岛请勿携带违禁物品，随身武器、露营工具、外国特产等请登记缴税。",
            "nextDialogs": [
              "5080603"
            ]
          },
          "5080603": {
            "id": "5080603",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "勘合证件及个人证件请妥善保存，遗失不补！",
            "nextDialogs": [
              "5080604"
            ]
          },
          "5080604": {
            "id": "5080604",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "一年内与珊瑚宫方面有交往者，须在离岛停留观察一年，不可擅自离开。"
          }
        }
      }
    },
    {
      "subId": "50807",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5080701"
        ],
        "dialogs": {
          "5080701": {
            "id": "5080701",
            "speakerId": 1007,
            "speakerName": "「万国商会」公告",
            "text": "「诸位外国行商游客人等，在离岛若是遭遇问题或困难」",
            "nextDialogs": [
              "5080702"
            ]
          },
          "5080702": {
            "id": "5080702",
            "speakerId": 1007,
            "speakerName": "「万国商会」公告",
            "text": "「还请来万国商会找久利须先生，必定尽力相助！」",
            "nextDialogs": [
              "5080703"
            ]
          },
          "5080703": {
            "id": "5080703",
            "speakerId": 1007,
            "speakerName": "「万国商会」公告",
            "text": "「若有什么不懂的事、烦恼的事，也可尽管来一叙。」",
            "nextDialogs": [
              "5080704"
            ]
          },
          "5080704": {
            "id": "5080704",
            "speakerId": 1007,
            "speakerName": "「万国商会」公告",
            "text": "「万国商会的大门永远为各国旅者敞开。」"
          }
        }
      }
    },
    {
      "subId": "50808",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5080801"
        ],
        "dialogs": {
          "5080801": {
            "id": "5080801",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「千叶华子，千叶龙一，前蛇骨矿洞工人，有技术证书，身体健康，吃苦耐劳。」",
            "nextDialogs": [
              "5080802"
            ]
          },
          "5080802": {
            "id": "5080802",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「切望获得一份诚实的工作，以贴补家庭日常衣食租费。希望能在同一场所工作。」",
            "nextDialogs": [
              "5080803"
            ]
          },
          "5080803": {
            "id": "5080803",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「薪水、福利可面谈！」"
          }
        }
      }
    },
    {
      "subId": "50809",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5080901"
        ],
        "dialogs": {
          "5080901": {
            "id": "5080901",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「绯木介，前踏鞴砂技术工人，有技术证书，有管理经验。身体健康。」",
            "nextDialogs": [
              "5080902"
            ]
          },
          "5080902": {
            "id": "5080902",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「希望获得一份诚实工作以供养家人，薪水、待遇可面谈。」"
          }
        }
      }
    },
    {
      "subId": "50810",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5081001"
        ],
        "dialogs": {
          "5081001": {
            "id": "5081001",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「野野村悠也，前踏鞴砂工人，身体健壮，吃苦耐劳，适合高危工作岗位！」",
            "nextDialogs": [
              "5081002"
            ]
          },
          "5081002": {
            "id": "5081002",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「切望拥有一份踏实的工作，做到战争结束为止。」",
            "nextDialogs": [
              "5081003"
            ]
          },
          "5081003": {
            "id": "5081003",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「薪酬、待遇可面谈，希望有稳定休息时间！」"
          }
        }
      }
    },
    {
      "subId": "50811",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5081101"
        ],
        "dialogs": {
          "5081101": {
            "id": "5081101",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "近日由于踏鞴砂一带停工影响，许多工人来到离岛暂住，寻找临时工作。",
            "nextDialogs": [
              "5081102"
            ]
          },
          "5081102": {
            "id": "5081102",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "勘定奉行大人将积极为诸位安排住处及工作岗位，请不要张贴广告，影响市容。",
            "nextDialogs": [
              "5081103"
            ]
          },
          "5081103": {
            "id": "5081103",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "近日将清理一切求职广告，望离岛诸位周知。"
          }
        }
      }
    },
    {
      "subId": "50812",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5081201"
        ],
        "dialogs": {
          "5081201": {
            "id": "5081201",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "近日已妥善处理停工问题，外来工人大多重新安置港口，从事相关工作。",
            "nextDialogs": [
              "5081202"
            ]
          },
          "5081202": {
            "id": "5081202",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "为防止发生治安问题，尚未服从工作安排者暂时集中安置，不得外出面见外人。"
          }
        }
      }
    },
    {
      "subId": "50813",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5081301"
        ],
        "dialogs": {
          "5081301": {
            "id": "5081301",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "近期可能增加一班自至冬国往离岛的运货商船，请港口诸位早做准备！",
            "nextDialogs": [
              "5081302"
            ]
          },
          "5081302": {
            "id": "5081302",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "作为配套措施，自至冬国来的商人可先行享受部分关税减免优惠。",
            "nextDialogs": [
              "5081303"
            ]
          },
          "5081303": {
            "id": "5081303",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "已留居离岛的至冬国商人也请尽快前往勘定奉行府更新勘合证件，",
            "nextDialogs": [
              "5081304"
            ]
          },
          "5081304": {
            "id": "5081304",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "以免造成居住生活、出行经商等方面的不便。"
          }
        }
      }
    },
    {
      "subId": "50814",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5081401"
        ],
        "dialogs": {
          "5081401": {
            "id": "5081401",
            "speakerId": 1009,
            "speakerName": "通缉令",
            "text": "悬赏：吉野小平次、吉野小平太。",
            "nextDialogs": [
              "5081402"
            ]
          },
          "5081402": {
            "id": "5081402",
            "speakerId": 1009,
            "speakerName": "通缉令",
            "text": "罪名：逐电；劫盗；夜讨；谋害长官；向无辜村民散发财物，企图谋反。",
            "nextDialogs": [
              "5081403"
            ]
          },
          "5081403": {
            "id": "5081403",
            "speakerId": 1009,
            "speakerName": "通缉令",
            "text": "此二人活捉或正法，皆有重赏！"
          }
        }
      }
    },
    {
      "subId": "50815",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5081501"
        ],
        "dialogs": {
          "5081501": {
            "id": "5081501",
            "speakerId": 1009,
            "speakerName": "通缉令",
            "text": "悬赏：绿川四郎",
            "nextDialogs": [
              "5081502"
            ]
          },
          "5081502": {
            "id": "5081502",
            "speakerId": 1009,
            "speakerName": "通缉令",
            "text": "罪名：逐电；啸聚；海贼；抢劫官员；伏狩武士；诱拐老母为质，妄图对抗官府。",
            "nextDialogs": [
              "5081503"
            ]
          },
          "5081503": {
            "id": "5081503",
            "speakerId": 1009,
            "speakerName": "通缉令",
            "text": "此人及其党羽，活捉或正法，皆有重赏！"
          }
        }
      }
    },
    {
      "subId": "50816",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5081601"
        ],
        "dialogs": {
          "5081601": {
            "id": "5081601",
            "speakerId": 1010,
            "speakerName": "鸣神大社公告",
            "text": "经宫司八重神子大人许可，鸣神大社将向受战争影响之贫困商户、困难家庭发放无息扶助贷款、慰问粮等补助福利。",
            "nextDialogs": [
              "5081602"
            ]
          },
          "5081602": {
            "id": "5081602",
            "speakerId": 1010,
            "speakerName": "鸣神大社公告",
            "text": "请有需要者携带齐全证件诣神里家府上办理相关手续。",
            "nextDialogs": [
              "5081603"
            ]
          },
          "5081603": {
            "id": "5081603",
            "speakerId": 1010,
            "speakerName": "鸣神大社公告",
            "text": "（外国人如能出示合法勘合证件，亦可领取限额补助。）",
            "nextDialogs": [
              "5081604"
            ]
          },
          "5081604": {
            "id": "5081604",
            "speakerId": 1010,
            "speakerName": "鸣神大社公告",
            "text": "由于战事绵延，公帑稍紧，近日慰问粮补助限额降低至二分之一，敬请见谅。",
            "nextDialogs": [
              "5081605"
            ]
          },
          "5081605": {
            "id": "5081605",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「感谢八重神子大人与社奉行大人的好意，只是证件审核流程太过漫长…」",
            "nextDialogs": [
              "5081606"
            ]
          },
          "5081606": {
            "id": "5081606",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「等到勘合审定，慰问粮也早就发完了…对我们外国人来说，太不方便了。」",
            "nextDialogs": [
              "5081607"
            ]
          },
          "5081607": {
            "id": "5081607",
            "speakerId": 1010,
            "speakerName": "鸣神大社公告",
            "text": "非常遗憾，您的意见我们会好好采纳的。"
          }
        }
      }
    },
    {
      "subId": "50817",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5081701"
        ],
        "dialogs": {
          "5081701": {
            "id": "5081701",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "近来由于战事绵延，公帑稍紧。还请诸外国商家慷慨解囊，接济官家。",
            "nextDialogs": [
              "5081702"
            ]
          },
          "5081702": {
            "id": "5081702",
            "speakerId": 1006,
            "speakerName": "勘定公告",
            "text": "由是勘定奉行大人擅自将店铺租金提高五倍，望诸位客商见谅。",
            "nextDialogs": [
              "5081703"
            ]
          },
          "5081703": {
            "id": "5081703",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「哼，我们倒是接济官府了，谁来接济我们呢？」"
          }
        }
      }
    },
    {
      "subId": "50818",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5081801"
        ],
        "dialogs": {
          "5081801": {
            "id": "5081801",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「虽然真心希望战争早点结束…」",
            "nextDialogs": [
              "5081802"
            ]
          },
          "5081802": {
            "id": "5081802",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「但同样多亏了这场战争，离岛的码头活跃了许多。」",
            "nextDialogs": [
              "5081803"
            ]
          },
          "5081803": {
            "id": "5081803",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「虽然我们的工作繁重了不少，但薪水也水涨船高。」",
            "nextDialogs": [
              "5081804"
            ]
          },
          "5081804": {
            "id": "5081804",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「看着妻子在码头挥汗如雨的样子，看着孩子们期待着又一顿好饭好菜的神情…」",
            "nextDialogs": [
              "5081805"
            ]
          },
          "5081805": {
            "id": "5081805",
            "speakerId": 1008,
            "speakerName": "留言",
            "text": "「果然，还是应该支持这场战争继续下去吧。」"
          }
        }
      }
    }
  ]
}
    {
      "subId": "4010302",
      "subQuestName": "向阿拉夫询问调查情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401030201"
        ],
        "dialogs": {
          "401030201": {
            "id": "401030201",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "你们来了。很抱歉我刚审完犯人，还没来得及派人去通知你们。",
            "nextDialogs": [
              "401030202"
            ]
          },
          "401030202": {
            "id": "401030202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "问出什么了吗？",
            "nextDialogs": [
              "401030203"
            ]
          },
          "401030203": {
            "id": "401030203",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "怎么说呢，很多让人意想不到的事情。",
            "nextDialogs": [
              "401030204"
            ]
          },
          "401030204": {
            "id": "401030204",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "干绑票的那些佣兵比想象中好抓，我让人假扮成萨齐因，没多久就把他们钓出来了。",
            "nextDialogs": [
              "401030205"
            ]
          },
          "401030205": {
            "id": "401030205",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "问题是审完之后才知道，雇他们来的人，好像就是萨齐因自己的孩子。",
            "nextDialogs": [
              "401030206"
            ]
          },
          "401030206": {
            "id": "401030206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "孩子找人绑架自己的父亲？为什么要这么做？",
            "nextDialogs": [
              "401030207"
            ]
          },
          "401030207": {
            "id": "401030207",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "谁知道呢…进城的佣兵只是一小部分，还有很多人留在城外接应。",
            "nextDialogs": [
              "401030208"
            ]
          },
          "401030208": {
            "id": "401030208",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "我们正准备抽调人手，去将他们一网打尽。你们要不要也一起来？",
            "nextDialogs": [
              "401030209"
            ]
          },
          "401030209": {
            "id": "401030209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，正好我们也去看看到底是怎么回事。"
          }
        }
      }
    },
    {
      "subId": "4010303",
      "subQuestName": "前往绑架犯的营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4010304",
      "subQuestName": "调查绑架案的真相",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401030401"
        ],
        "dialogs": {
          "401030401": {
            "id": "401030401",
            "speakerId": 13208,
            "speakerName": "利瓦尔",
            "text": "老大，好像又有人来了…",
            "nextDialogs": [
              "401030402"
            ]
          },
          "401030402": {
            "id": "401030402",
            "speakerId": 13209,
            "speakerName": "麦扎尔",
            "text": "我说，兄弟们只是拿钱办事，罪不至此吧。冤有头债有主，雇我们绑架萨齐因的是这位。",
            "nextDialogs": [
              "401030403"
            ]
          },
          "401030403": {
            "id": "401030403",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "401030404"
            ]
          },
          "401030404": {
            "id": "401030404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么回事？你们是被谁打成这个样子的？",
            "nextDialogs": [
              "401030405"
            ]
          },
          "401030405": {
            "id": "401030405",
            "speakerId": 13209,
            "speakerName": "麦扎尔",
            "text": "你和他们不是一伙儿的？",
            "nextDialogs": [
              "401030406"
            ]
          },
          "401030406": {
            "id": "401030406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们？你说的是谁呀？",
            "nextDialogs": [
              "401030407"
            ]
          },
          "401030407": {
            "id": "401030407",
            "speakerId": 13209,
            "speakerName": "麦扎尔",
            "text": "有个飞在天上的小鬼，不由分说把我们打了一顿。之后没多久，又来了一个穿绿衣服的男人，找我们问话。",
            "nextDialogs": [
              "401030408"
            ]
          },
          "401030408": {
            "id": "401030408",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "我已经问清楚了。幕后主使就是这位，萨齐因的儿子西瓦尼。",
            "nextDialogs": [
              "401030409"
            ]
          },
          "401030409": {
            "id": "401030409",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "你们有什么想问的，现在都可以问。之后我会把他们一起逮捕，带回教令院审问。",
            "nextDialogs": [
              "401030410"
            ]
          },
          "401030410": {
            "id": "401030410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你为什么要雇人绑架萨齐因呢？",
            "nextDialogs": [
              "401030411"
            ]
          },
          "401030411": {
            "id": "401030411",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "哼，这还用问吗？二十年了，他不知道躲在哪里逍遥快活，根本不顾我的死活。",
            "nextDialogs": [
              "401030412"
            ]
          },
          "401030412": {
            "id": "401030412",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "更可气的是，他把产业交托给教令院打理，还立下合同，说这些产业总有一天要留给他欣赏的天才。",
            "nextDialogs": [
              "401030413"
            ]
          },
          "401030413": {
            "id": "401030413",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "那本该是我的东西，凭什么要拱手让人？他不给我，我就从他的手里夺过来。",
            "nextDialogs": [
              "401030414"
            ]
          },
          "401030414": {
            "id": "401030414",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你该不会是想…",
            "nextDialogs": [
              "401030415"
            ]
          },
          "401030415": {
            "id": "401030415",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "不错！他不是说，他会躲在暗处观看比赛吗？",
            "nextDialogs": [
              "401030416"
            ]
          },
          "401030416": {
            "id": "401030416",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "那我就雇人抓住他，强迫他修改自己签下的合同。若是教令院不答应，我就强迫萨齐因承认，我就是那个他认可的天才！",
            "nextDialogs": [
              "401030417"
            ]
          },
          "401030417": {
            "id": "401030417",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们找到他了吗？",
            "nextDialogs": [
              "401030418"
            ]
          },
          "401030418": {
            "id": "401030418",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "没有。那老家伙太会藏了，不知道躲在哪里看笑话呢。",
            "nextDialogs": [
              "401030419"
            ]
          },
          "401030419": {
            "id": "401030419",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "二十年前我就觉得他疯了，一个疯子什么都能干得出来…",
            "nextDialogs": [
              "401030420"
            ]
          },
          "401030420": {
            "id": "401030420",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你了解「才识之冠」吗？",
            "nextDialogs": [
              "401030421"
            ]
          },
          "401030421": {
            "id": "401030421",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "才识之冠？你是说他捐给教令院的那个？",
            "nextDialogs": [
              "401030422"
            ]
          },
          "401030422": {
            "id": "401030422",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "我知道那破玩意儿很贵，当初为了买它，萨齐因变卖了好些产业。",
            "nextDialogs": [
              "401030423"
            ]
          },
          "401030423": {
            "id": "401030423",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "买回来之后，家里还闹过鬼，有时路过收藏室，能听见里面有人尖着嗓子说话。",
            "nextDialogs": [
              "401030424"
            ]
          },
          "401030424": {
            "id": "401030424",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "另外，萨齐因把它捐给教令院之前，曾经把自己关在收藏室里，一连好多天研究那个冠冕。",
            "nextDialogs": [
              "401030425"
            ]
          },
          "401030425": {
            "id": "401030425",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "不过那时候他已经精神不正常了，做什么我们都不觉得奇怪。",
            "nextDialogs": [
              "401030426"
            ]
          },
          "401030426": {
            "id": "401030426",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你说他精神不正常，是怎么回事？",
            "nextDialogs": [
              "401030427"
            ]
          },
          "401030427": {
            "id": "401030427",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "那时候我还小，也记不太清楚了。印象里他去沙漠考察，很多年都没有回来。",
            "nextDialogs": [
              "401030428"
            ]
          },
          "401030428": {
            "id": "401030428",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "有一天他终于回到家，却像是变了个人一样，念叨着旁人听不懂的话，没日没夜地写论文。",
            "nextDialogs": [
              "401030429"
            ]
          },
          "401030429": {
            "id": "401030429",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "我想去看看他写了什么，却被他赶出了房间。之后他带着写好的论文又出去了一趟，回来之后就和教令院签订了合同。",
            "nextDialogs": [
              "401030430"
            ]
          },
          "401030430": {
            "id": "401030430",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "现在想想，或许当时的他已经不是我的父亲了，而是披着萨齐因外皮的…从沙漠回来的魔鬼。",
            "nextDialogs": [
              "401030431"
            ]
          },
          "401030431": {
            "id": "401030431",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不要讲得这么吓人啦！我听着都觉得害怕！",
            "nextDialogs": [
              "401030432"
            ]
          },
          "401030432": {
            "id": "401030432",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "你们爱信不信，我知道的已经都说了。我只拜托你们一件事，如果你们碰巧遇见了萨齐因，帮我告诉他——",
            "nextDialogs": [
              "401030433"
            ]
          },
          "401030433": {
            "id": "401030433",
            "speakerId": 13155,
            "speakerName": "西瓦尼",
            "text": "不管他是在外面研究什么，在我眼里他都是个混蛋。",
            "nextDialogs": [
              "401030434"
            ]
          },
          "401030434": {
            "id": "401030434",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "说完了？那就跟我们走吧。",
            "nextDialogs": [
              "401030435"
            ]
          },
          "401030435": {
            "id": "401030435",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "这次闹事的主谋，我们已经抓捕完毕了。多谢你提供的情报。",
            "nextDialogs": [
              "401030436"
            ]
          },
          "401030436": {
            "id": "401030436",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "你还有什么担心的问题吗？",
            "nextDialogs": [
              "401030437"
            ]
          },
          "401030437": {
            "id": "401030437",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「才识之冠」…",
            "nextDialogs": [
              "401030438"
            ]
          },
          "401030438": {
            "id": "401030438",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "的确，艾尔海森留下的笔记中也提到了那个冠冕…",
            "nextDialogs": [
              "401030439"
            ]
          },
          "401030439": {
            "id": "401030439",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "艾尔海森大人也在关注这件事？",
            "nextDialogs": [
              "401030440"
            ]
          },
          "401030440": {
            "id": "401030440",
            "speakerId": 13091,
            "speakerName": "阿拉夫",
            "text": "我有一个想法。如果你们认为冠冕有问题，不妨联系主办方，暂时停止比赛，仔细调查一番。",
            "nextDialogs": [
              "401030441"
            ]
          },
          "401030441": {
            "id": "401030441",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有道理！那我们现在就回主会场，把这件事告诉卡莉娜吧！"
          }
        }
      }
    },
    {
      "subId": "4010305",
      "subQuestName": "前往主会场寻找工作人员",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401030501"
        ],
        "dialogs": {
          "401030501": {
            "id": "401030501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "卡莉娜！",
            "nextDialogs": [
              "401030502"
            ]
          },
          "401030502": {
            "id": "401030502",
            "speakerId": 13153,
            "speakerName": "卡莉娜",
            "text": "呼…你们终于回来了。",
            "nextDialogs": [
              "401030503"
            ]
          },
          "401030503": {
            "id": "401030503",
            "speakerId": 13153,
            "speakerName": "卡莉娜",
            "text": "真是让我一顿好找，你们刚刚去哪了？第三轮比赛已经开始了。",
            "nextDialogs": [
              "401030504"
            ]
          },
          "401030504": {
            "id": "401030504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们刚刚去抓了一些盯上萨齐因的坏人…",
            "nextDialogs": [
              "401030505"
            ]
          },
          "401030505": {
            "id": "401030505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对，这不是重点！才识之冠可能有问题，我们想好好调查一下它！",
            "nextDialogs": [
              "401030506"
            ]
          },
          "401030506": {
            "id": "401030506",
            "speakerId": 13153,
            "speakerName": "卡莉娜",
            "text": "才识之冠有问题？不应该吧。",
            "nextDialogs": [
              "401030507"
            ]
          },
          "401030507": {
            "id": "401030507",
            "speakerId": 13153,
            "speakerName": "卡莉娜",
            "text": "二十年来，每届比赛都会用到才识之冠，从来没出过什么问题啊？你们哪里来的消息？",
            "nextDialogs": [
              "401030508"
            ]
          },
          "401030508": {
            "id": "401030508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是我们的一些推测。",
            "nextDialogs": [
              "401030509"
            ]
          },
          "401030509": {
            "id": "401030509",
            "speakerId": 13153,
            "speakerName": "卡莉娜",
            "text": "这件事很重要，让我想想…",
            "nextDialogs": [
              "401030510"
            ]
          },
          "401030510": {
            "id": "401030510",
            "speakerId": 13153,
            "speakerName": "卡莉娜",
            "text": "实不相瞒，在第三轮比赛开始之前，我们已经将冠冕放在无郁稠林里了。",
            "nextDialogs": [
              "401030511"
            ]
          },
          "401030511": {
            "id": "401030511",
            "speakerId": 13153,
            "speakerName": "卡莉娜",
            "text": "第三轮比赛的内容，正是到无郁稠林中找出冠冕，然后将冠冕带出来，放到指定的台子上。最先将冠冕放好的人会得到4点积分。",
            "nextDialogs": [
              "401030512"
            ]
          },
          "401030512": {
            "id": "401030512",
            "speakerId": 13153,
            "speakerName": "卡莉娜",
            "text": "考虑到之前参赛者的分数没有拉开差距，第一个放好冠冕的人很可能就是最后的冠军。",
            "nextDialogs": [
              "401030513"
            ]
          },
          "401030513": {
            "id": "401030513",
            "speakerId": 13153,
            "speakerName": "卡莉娜",
            "text": "所以我猜这轮比赛应该很激烈。你们未必赶得上…",
            "nextDialogs": [
              "401030514"
            ]
          },
          "401030514": {
            "id": "401030514",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "总要试一试。",
            "nextDialogs": [
              "401030515"
            ]
          },
          "401030515": {
            "id": "401030515",
            "speakerId": 13153,
            "speakerName": "卡莉娜",
            "text": "我会将冠冕的位置标注出来，也请你们立刻前往现场查看情况，希望不要出什么事情…",
            "nextDialogs": [
              "401030516"
            ]
          },
          "401030516": {
            "id": "401030516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好！我们马上出发！"
          }
        }
      }
    },

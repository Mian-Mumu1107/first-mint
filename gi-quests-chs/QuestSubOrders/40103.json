    {
      "subId": "4010310",
      "subQuestName": "与卡维对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401031001"
        ],
        "dialogs": {
          "401031001": {
            "id": "401031001",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "终于等到了…能够继承我财产的人…能够继承我研究的人。",
            "nextDialogs": [
              "401031002"
            ]
          },
          "401031002": {
            "id": "401031002",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "来，卡维。好孩子，到我这来…",
            "nextDialogs": [
              "401031003"
            ]
          },
          "401031003": {
            "id": "401031003",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "…你怎么知道我的名字？你到底是谁？",
            "nextDialogs": [
              "401031004"
            ]
          },
          "401031004": {
            "id": "401031004",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "我名萨齐因。当然，准确来说，我只是萨齐因的一小块意识碎片而已。",
            "nextDialogs": [
              "401031005"
            ]
          },
          "401031005": {
            "id": "401031005",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "真是一种奇妙的缘分…看到你，我会想起曾经见过的一个人。但你比他更坚强，更明白世事的不易。你有资格继承我的一切。",
            "nextDialogs": [
              "401031006"
            ]
          },
          "401031006": {
            "id": "401031006",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "孩子们，这是我们第一次见面。但接下来我要说的话很重要，希望你们帮我做一个见证。",
            "nextDialogs": [
              "401031007"
            ]
          },
          "401031007": {
            "id": "401031007",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "在本次学院争霸赛中，每个人的表现都很出色。教令院总是有很多奇才，你们每个人都是特别的。",
            "nextDialogs": [
              "401031008"
            ]
          },
          "401031008": {
            "id": "401031008",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "但是，如果要我选出一位继任者，我会选择你，卡维。不仅是因为你夺得了冠军，而且因为你有着和我相似的性格。",
            "nextDialogs": [
              "401031009"
            ]
          },
          "401031009": {
            "id": "401031009",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "…我？和你？",
            "nextDialogs": [
              "401031010"
            ]
          },
          "401031010": {
            "id": "401031010",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "是啊，我们都是可怜的理想主义者，这是我们痛苦的根源。",
            "nextDialogs": [
              "401031011"
            ]
          },
          "401031011": {
            "id": "401031011",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "二十八年前，我来到沙漠，在那里定居了整整八年。你觉得我在那里看到了什么？争乱、厮杀，无穷无尽。",
            "nextDialogs": [
              "401031012"
            ]
          },
          "401031012": {
            "id": "401031012",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "围绕水源的争抢、对商队的劫掠、对民众的盘剥，一天都没有停过。防沙壁外的世界，与我认知中的完全是两个样子。",
            "nextDialogs": [
              "401031013"
            ]
          },
          "401031013": {
            "id": "401031013",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "我为我看到的一切深感痛苦，所以我迫切地想要找出一条路来拯救他们。",
            "nextDialogs": [
              "401031014"
            ]
          },
          "401031014": {
            "id": "401031014",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "所以…你找到答案了吗？",
            "nextDialogs": [
              "401031015"
            ]
          },
          "401031015": {
            "id": "401031015",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "我是因论派出身的学者，自然会用因论派的知识去寻找答案。",
            "nextDialogs": [
              "401031016"
            ]
          },
          "401031016": {
            "id": "401031016",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "我研究历史、分析社会，做了无数人性的实验，甚至与沙漠深处那些自称为「失落学派」的学者接触——",
            "nextDialogs": [
              "401031017"
            ]
          },
          "401031017": {
            "id": "401031017",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "然后，我发现答案其实根本就不存在。",
            "nextDialogs": [
              "401031018"
            ]
          },
          "401031018": {
            "id": "401031018",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "我无法将过错简单地推给任何一方势力，因为罪孽镌刻在人性之上。人性带来纷争，纷争导向毁灭，这是人力无法逆转的必然。",
            "nextDialogs": [
              "401031019"
            ]
          },
          "401031019": {
            "id": "401031019",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "我研究的是如何从历史中取得教训，可结论竟然是历史中没有任何教训，一切都只能朝着更糟的方向发展！",
            "nextDialogs": [
              "401031020"
            ]
          },
          "401031020": {
            "id": "401031020",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "我不知道我所学的一切到底有什么意义，沉重的虚无感让我无法再面对生活的一切，于是我决定结束自己的生命。",
            "nextDialogs": [
              "401031021"
            ]
          },
          "401031021": {
            "id": "401031021",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "但先前一个偶然的机会，让我得到了这枚可以存放部分意识的冠冕。我将自己的经历录入其中，又让教令院代为打理我的家产。",
            "nextDialogs": [
              "401031022"
            ]
          },
          "401031022": {
            "id": "401031022",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "果然，与教令院签订的「合同」，其实更像是你的「遗嘱」。",
            "nextDialogs": [
              "401031023"
            ]
          },
          "401031023": {
            "id": "401031023",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "可既然你已经对这个世界绝望，又为什么还要做这些事？",
            "nextDialogs": [
              "401031024"
            ]
          },
          "401031024": {
            "id": "401031024",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "先前已经说过，我做过许多关于人性的实验。你可以理解为，这是我众多实验的最后一个。",
            "nextDialogs": [
              "401031025"
            ]
          },
          "401031025": {
            "id": "401031025",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "教令院不缺天才，每代都有闪耀的明星。重赏之下必有勇夫，我盼望着有一天，有人能解开人性的死结，让世界走向正确的方向。",
            "nextDialogs": [
              "401031026"
            ]
          },
          "401031026": {
            "id": "401031026",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "也就是说，你想要的继承者，既要是天才，又要能体会普通人的痛苦。这样才能对人性、对社会、对这个世界有更清晰的认知。",
            "nextDialogs": [
              "401031027"
            ]
          },
          "401031027": {
            "id": "401031027",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "……",
            "nextDialogs": [
              "401031028"
            ]
          },
          "401031028": {
            "id": "401031028",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "你是否想过，财富会麻痹人心，令他们失去对外界痛苦的感知。继承你财富的理想主义者未必能走到最后。",
            "nextDialogs": [
              "401031029"
            ]
          },
          "401031029": {
            "id": "401031029",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "你很聪明。但我知道，你并非能够理解我想法的那类人——对我来说，这也是实验的一部分，是我对人性的考察。",
            "nextDialogs": [
              "401031030"
            ]
          },
          "401031030": {
            "id": "401031030",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "无论继承者因我的研究而痛苦，还是沉溺于虚假的快乐之中，我的研究都会更进一步。",
            "nextDialogs": [
              "401031031"
            ]
          },
          "401031031": {
            "id": "401031031",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "我为世界的本质感到痛苦，我为沉重的历史感到惋惜，我为未竟的研究感到遗憾。",
            "nextDialogs": [
              "401031032"
            ]
          },
          "401031032": {
            "id": "401031032",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "所以，卡维，亲爱的孩子…你将为我所用。",
            "nextDialogs": [
              "401031033"
            ]
          },
          "401031033": {
            "id": "401031033",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "你…确定要将所有的东西送给我，交由我来处置？",
            "nextDialogs": [
              "401031034"
            ]
          },
          "401031034": {
            "id": "401031034",
            "speakerId": 13151,
            "speakerName": "萨齐因",
            "text": "我相信我的眼光。戴上冠冕，替我走完这条路吧。"
          }
        }
      }
    },
    {
      "subId": "4010306",
      "subQuestName": "询问卡维身体情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401030601"
        ],
        "dialogs": {
          "401030601": {
            "id": "401030601",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "这样就结束了吧。",
            "nextDialogs": [
              "401030602"
            ]
          },
          "401030602": {
            "id": "401030602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "卡维…",
            "nextDialogs": [
              "401030603"
            ]
          },
          "401030603": {
            "id": "401030603",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "你没事吧？身体感觉怎么样？",
            "nextDialogs": [
              "401030604"
            ]
          },
          "401030604": {
            "id": "401030604",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "我…没事…唔…",
            "nextDialogs": [
              "401030605"
            ]
          },
          "401030605": {
            "id": "401030605",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "谢谢你提纳里，别担心。",
            "nextDialogs": [
              "401030606"
            ]
          },
          "401030606": {
            "id": "401030606",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "别太勉强自己。",
            "nextDialogs": [
              "401030607"
            ]
          },
          "401030607": {
            "id": "401030607",
            "speakerId": 1054,
            "speakerName": "妮露",
            "text": "卡维先生…",
            "nextDialogs": [
              "401030608"
            ]
          },
          "401030608": {
            "id": "401030608",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "虽然冠冕被卡维选手摔碎，但他在摔碎前就已完成比赛。",
            "nextDialogs": [
              "401030609"
            ]
          },
          "401030609": {
            "id": "401030609",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "按规则，他是第三轮比赛的胜者，从总积分来看，也是本届学院争霸赛的冠军。",
            "nextDialogs": [
              "401030610"
            ]
          },
          "401030610": {
            "id": "401030610",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "作为学院争霸赛的冠军，以及萨齐因亲自拟定的继承者，卡维选手享有对萨齐因所有财产的继承权。",
            "nextDialogs": [
              "401030611"
            ]
          },
          "401030611": {
            "id": "401030611",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "我再问一次，你确定要捐出萨齐因所有的财产吗？",
            "nextDialogs": [
              "401030612"
            ]
          },
          "401030612": {
            "id": "401030612",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "我刚刚说过了。他觉得这个世界不好，那就用他留下来的产业去做一些改变。",
            "nextDialogs": [
              "401030613"
            ]
          },
          "401030613": {
            "id": "401030613",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "单纯的否定不能促成任何结果。我和他…不一样。",
            "nextDialogs": [
              "401030614"
            ]
          },
          "401030614": {
            "id": "401030614",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "好。作为书记官，我会将这件事记入档案。",
            "nextDialogs": [
              "401030615"
            ]
          },
          "401030615": {
            "id": "401030615",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "至于这些财产具体的使用细节，赛后将由贤者亲自与你沟通。",
            "nextDialogs": [
              "401030616"
            ]
          },
          "401030616": {
            "id": "401030616",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "…就这样吧。",
            "nextDialogs": [
              "401030617"
            ]
          },
          "401030617": {
            "id": "401030617",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "我不知道那个人的研究是否正确，也不知道该怎么帮他去完成。",
            "nextDialogs": [
              "401030618"
            ]
          },
          "401030618": {
            "id": "401030618",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "我只知道，让一切停在这里，所有参赛者就不会感到痛苦。",
            "nextDialogs": [
              "401030619"
            ]
          },
          "401030619": {
            "id": "401030619",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "我们不会是最后一届，将来还会有人来到这个比赛…还会有未来的学者继续为这个赛事前赴后继。",
            "nextDialogs": [
              "401030620"
            ]
          },
          "401030620": {
            "id": "401030620",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "萨齐因的话会让人痛苦。所以…到此为止，不要再继续传播下去了。",
            "nextDialogs": [
              "401030621"
            ]
          },
          "401030621": {
            "id": "401030621",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "我们都是学者，贸然推翻他的观点也是独断傲慢。没关系，这份责任我来背负就好。",
            "nextDialogs": [
              "401030622"
            ]
          },
          "401030622": {
            "id": "401030622",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "对我来说这样就好。我也…只能做到这么多。",
            "nextDialogs": [
              "401030623"
            ]
          },
          "401030623": {
            "id": "401030623",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "……",
            "nextDialogs": [
              "401030624"
            ]
          },
          "401030624": {
            "id": "401030624",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "说得不错，陈述了大部分人渴望却未必敢去执行的正义和理想。",
            "nextDialogs": [
              "401030625"
            ]
          },
          "401030625": {
            "id": "401030625",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "虽然在我看来还是那么可笑。你早已察觉到自身的问题，仅仅是碍于自尊心不愿承认。",
            "nextDialogs": [
              "401030626"
            ]
          },
          "401030626": {
            "id": "401030626",
            "speakerId": 1053,
            "speakerName": "艾尔海森",
            "text": "不过你的这些观点很适合在领奖台上发表。我谨代表本次比赛组委会祝贺你获得冠军，卡维选手。",
            "nextDialogs": [
              "401030627"
            ]
          },
          "401030627": {
            "id": "401030627",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "哈？别搞错了，我不需要没有诚意的赞扬！",
            "nextDialogs": [
              "401030628"
            ]
          },
          "401030628": {
            "id": "401030628",
            "speakerId": 1064,
            "speakerName": "卡维",
            "text": "另外现在不是辩论的场合，请你专注评论比赛而不是我的观念。",
            "nextDialogs": [
              "401030629"
            ]
          },
          "401030629": {
            "id": "401030629",
            "speakerId": 1054,
            "speakerName": "妮露",
            "text": "恭喜你，卡维先生！也请您准备一下出席颁奖仪式…"
          }
        }
      }
    },
    {
      "subId": "4010350",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401035001"
        ],
        "dialogs": {
          "401035001": {
            "id": "401035001",
            "speakerId": 13153,
            "speakerName": "卡莉娜",
            "text": "为什么偏偏是这一届…"
          }
        }
      }

{
  "lineCounts": {
    "曾我隅田流左近重衡": 13,
    "派蒙": 5
  },
  "subQuests": [
    {
      "subId": "7011101",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701110101"
        ],
        "dialogs": {
          "701110101": {
            "id": "701110101",
            "speakerId": 1000,
            "speakerName": "曾我隅田流左近重衡",
            "text": "贵殿，暂请留步。",
            "nextDialogs": [
              "701110102"
            ]
          },
          "701110102": {
            "id": "701110102",
            "speakerId": 1000,
            "speakerName": "曾我隅田流左近重衡",
            "text": "省去委细之事，某有一事相求。先日，璃月的虞黄衣殿下曾向某寄送一件稀代的珍品，然至今未达…",
            "nextDialogs": [
              "701110103"
            ]
          },
          "701110103": {
            "id": "701110103",
            "speakerId": 1000,
            "speakerName": "曾我隅田流左近重衡",
            "text": "某怀疑其为此地守护者所掠取。若贵殿见到虞黄衣殿下所说的「珍品」，可否为某取回？届时，某必将奉上相应的报谢。"
          }
        }
      }
    },
    {
      "subId": "7011102",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701110201"
        ],
        "dialogs": {
          "701110201": {
            "id": "701110201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们回来啦！你看看，这个是不是你说的「珍品」？",
            "nextDialogs": [
              "701110202"
            ]
          },
          "701110202": {
            "id": "701110202",
            "speakerId": 1000,
            "speakerName": "曾我隅田流左近重衡",
            "text": "哦哦，感激不尽，感激不尽！多谢两位相助！",
            "nextDialogs": [
              "701110203"
            ]
          },
          "701110203": {
            "id": "701110203",
            "speakerId": 1000,
            "speakerName": "曾我隅田流左近重衡",
            "text": "那么，事不宜迟，某这便启封——",
            "nextDialogs": [
              "701110204"
            ]
          },
          "701110204": {
            "id": "701110204",
            "speakerId": 1000,
            "speakerName": "曾我隅田流左近重衡",
            "text": "这、这是…！",
            "nextDialogs": [
              "701110205"
            ]
          },
          "701110205": {
            "id": "701110205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！这东西是不是快要炸了？！",
            "nextDialogs": [
              "701110206"
            ]
          },
          "701110206": {
            "id": "701110206",
            "speakerId": 1000,
            "speakerName": "曾我隅田流左近重衡",
            "text": "虞黄衣殿下不会害某…莫非是被守护者所寻获，改造成了所谓的「爆弹」吗？！",
            "nextDialogs": [
              "701110207"
            ]
          },
          "701110207": {
            "id": "701110207",
            "speakerId": 1000,
            "speakerName": "曾我隅田流左近重衡",
            "text": "实是耻辱，但某对如何拆解「爆弹」一窍不通…无计可施，只好把它丢出去了！",
            "nextDialogs": [
              "701110208"
            ]
          },
          "701110208": {
            "id": "701110208",
            "speakerId": 1000,
            "speakerName": "曾我隅田流左近重衡",
            "text": "不必担心！某还记得，有位从「亥珀波瑞亚」来的殿下好像说过，应当如何丢出神圣的「爆弹」！",
            "nextDialogs": [
              "701110209"
            ]
          },
          "701110209": {
            "id": "701110209",
            "speakerId": 1000,
            "speakerName": "曾我隅田流左近重衡",
            "text": "「汝当数到三，不可多，也不可少；汝既不可数四，也不可数二，五是数多了。当汝数到的数是三——」",
            "nextDialogs": [
              "701110210"
            ]
          },
          "701110210": {
            "id": "701110210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "废话太多啦！再不扔就真的要炸啦！"
          }
        }
      }
    },
    {
      "subId": "7011104",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7011103",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701110301"
        ],
        "dialogs": {
          "701110301": {
            "id": "701110301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么嘛，虚惊一场，搞了半天原来就只是烟花而已…",
            "nextDialogs": [
              "701110302"
            ]
          },
          "701110302": {
            "id": "701110302",
            "speakerId": 1000,
            "speakerName": "曾我隅田流左近重衡",
            "text": "何、何等绚烂…某追随御建鸣神主尊大御所大人征战时，还从未见过这般夺目的火之花…",
            "nextDialogs": [
              "701110303"
            ]
          },
          "701110303": {
            "id": "701110303",
            "speakerId": 1000,
            "speakerName": "曾我隅田流左近重衡",
            "text": "原来如此，这便是虞黄衣殿下让某观赏的奇景么…恐悦至极，恐悦至极…",
            "nextDialogs": [
              "701110304"
            ]
          },
          "701110304": {
            "id": "701110304",
            "speakerId": 1000,
            "speakerName": "曾我隅田流左近重衡",
            "text": "「漆夜如乌玉，夜半云居绽明花，身似水间沫；须臾一刹终归寂，星离雨散落片空…」嗟乎，何等风雅…",
            "nextDialogs": [
              "701110305"
            ]
          },
          "701110305": {
            "id": "701110305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然不知道你到底在风雅些什么啦…总之没事就好！"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "7467801",
      "subQuestName": "与科斯唐坦对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746780101"
        ],
        "dialogs": {
          "746780101": {
            "id": "746780101",
            "speakerId": 30421,
            "speakerName": "昂吉安妮",
            "text": "私斗私斗！抓起来抓起来！",
            "nextDialogs": [
              "746780102"
            ]
          },
          "746780102": {
            "id": "746780102",
            "speakerId": 30421,
            "speakerName": "昂吉安妮",
            "text": "发现危险的秘境后，不赶紧报告给执律庭，而是擅自进行调查并使用武力…你这家伙好狂啊！",
            "nextDialogs": [
              "746780103"
            ]
          },
          "746780103": {
            "id": "746780103",
            "speakerId": 30483,
            "speakerName": "科斯唐坦",
            "text": "大大大大人！我一不在枫丹廷，二打的是魔物，这也要被抓吗？",
            "nextDialogs": [
              "746780104"
            ]
          },
          "746780104": {
            "id": "746780104",
            "speakerId": 30421,
            "speakerName": "昂吉安妮",
            "text": "那你是冒险家协会的注册成员吗？",
            "nextDialogs": [
              "746780105"
            ]
          },
          "746780105": {
            "id": "746780105",
            "speakerId": 30483,
            "speakerName": "科斯唐坦",
            "text": "不是…我体能不过关，没通过测试…",
            "nextDialogs": [
              "746780106"
            ]
          },
          "746780106": {
            "id": "746780106",
            "speakerId": 30421,
            "speakerName": "昂吉安妮",
            "text": "那你有提前向执律庭报备，需要在枫丹境内使用武器吗？",
            "nextDialogs": [
              "746780107"
            ]
          },
          "746780107": {
            "id": "746780107",
            "speakerId": 30483,
            "speakerName": "科斯唐坦",
            "text": "还有这事？原来使用武器还要报备的？",
            "nextDialogs": [
              "746780108"
            ]
          },
          "746780108": {
            "id": "746780108",
            "speakerId": 30421,
            "speakerName": "昂吉安妮",
            "text": "肯定啊！不然，随便什么人都能在枫丹打架的话，执律庭不就成了摆设吗？",
            "nextDialogs": [
              "746780109"
            ]
          },
          "746780109": {
            "id": "746780109",
            "speakerId": 30421,
            "speakerName": "昂吉安妮",
            "text": "没有报备信息，小心警卫机关把你这种喜欢拿着武器瞎比划的家伙当成入侵者！",
            "nextDialogs": [
              "746780110"
            ]
          },
          "746780110": {
            "id": "746780110",
            "speakerId": 30421,
            "speakerName": "昂吉安妮",
            "text": "你看看你，简直就像个假枫丹人，被抓不冤吧？",
            "nextDialogs": [
              "746780111"
            ]
          },
          "746780111": {
            "id": "746780111",
            "speakerId": 30483,
            "speakerName": "科斯唐坦",
            "text": "失算了失算了！身为作家，取材不到位，忽略了重要的基本设定…我真是失职！",
            "nextDialogs": [
              "746780114"
            ]
          },
          "746780114": {
            "id": "746780114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，我们两个早就成为冒险家了，应该没什么问题？",
            "nextDialogs": [
              "746780115"
            ]
          },
          "746780115": {
            "id": "746780115",
            "speakerId": 30421,
            "speakerName": "昂吉安妮",
            "text": "哦？你们两位来了啊，大名人！",
            "nextDialogs": [
              "746780116"
            ]
          },
          "746780116": {
            "id": "746780116",
            "speakerId": 30421,
            "speakerName": "昂吉安妮",
            "text": "咳咳，我是昂吉安妮，常年在野外值岗的老牌警备队员。不久前，我在附近巡逻的时候，发现了这个冒失的家伙…",
            "nextDialogs": [
              "746780117"
            ]
          },
          "746780117": {
            "id": "746780117",
            "speakerId": 30421,
            "speakerName": "昂吉安妮",
            "text": "他向我交待了他在这里鬼混的前因后果，介绍了这个奇怪的秘境，还说你们两位也参与了这场「剑舞」。",
            "nextDialogs": [
              "746780118"
            ]
          },
          "746780118": {
            "id": "746780118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫！"
          }
        }
      }
    }
  ]
}
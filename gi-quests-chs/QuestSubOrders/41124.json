    {
      "subId": "4112406",
      "subQuestName": "与薇尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411240601"
        ],
        "dialogs": {
          "411240601": {
            "id": "411240601",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "放好信件了吗？",
            "nextDialogs": [
              "411240602"
            ]
          },
          "411240602": {
            "id": "411240602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都放好了。",
            "nextDialogs": [
              "411240603"
            ]
          },
          "411240603": {
            "id": "411240603",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "这样就可以了，那群盗宝团一定会根据那三份情报制订入侵计划。",
            "nextDialogs": [
              "411240604"
            ]
          },
          "411240604": {
            "id": "411240604",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "而他们那份计划中的「最佳入侵时间」，一定是从入夜到凌晨之间。",
            "nextDialogs": [
              "411240605"
            ]
          },
          "411240605": {
            "id": "411240605",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "还有「最佳入侵地点」…当然也只有一个啦。唔，我来标注在你的地图上。",
            "nextDialogs": [
              "411240606"
            ]
          },
          "411240606": {
            "id": "411240606",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "这样就可以了，我们就等着那群盗宝团来自投罗网吧。",
            "nextDialogs": [
              "411240608",
              "411240611"
            ]
          },
          "411240608": {
            "id": "411240608",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "嗯…你的担心也有点道理。毕竟我们使用这种非常规的手段，要是被西风骑士们发现，免不了会带来一堆麻烦…",
            "nextDialogs": [
              "411240609"
            ]
          },
          "411240609": {
            "id": "411240609",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "不过，那位先生向我保证不会出现这样的问题，我们就…相信他吧。",
            "nextDialogs": [
              "411240612"
            ]
          },
          "411240612": {
            "id": "411240612",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "好了，等到入夜之后，你就去把那群自投罗网的盗宝团们全都打倒吧。"
          },
          "411240611": {
            "id": "411240611",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "一定会出现的，你就放心吧。这可是那位先生亲自制订的计划，不会出问题的。"
          }
        }
      }
    },

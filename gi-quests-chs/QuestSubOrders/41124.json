    {
      "subId": "4112402",
      "subQuestName": "与薇尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411240201"
        ],
        "dialogs": {
          "411240201": {
            "id": "411240201",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "哎呀，你总算来了，我都等你好久了。",
            "nextDialogs": [
              "411240202"
            ]
          },
          "411240202": {
            "id": "411240202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你等我做什么？",
            "nextDialogs": [
              "411240203"
            ]
          },
          "411240203": {
            "id": "411240203",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "不要这么冷冰冰的嘛，我可是有很重要的事情想要拜托你。",
            "nextDialogs": [
              "411240204"
            ]
          },
          "411240204": {
            "id": "411240204",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "那些陨石你也看到了，虽然没有陨石砸进蒙德城，但现在蒙德城内外为了处理和陨石相关的事，已经全都乱成一团了。",
            "nextDialogs": [
              "411240205"
            ]
          },
          "411240205": {
            "id": "411240205",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "既然蒙德城的这池子水已经被搅浑了，那么某些想要浑水摸鱼的家伙，一定也不会放过这次机会。",
            "nextDialogs": [
              "411240207",
              "411240209"
            ]
          },
          "411240207": {
            "id": "411240207",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "哦呀，果然是身经百战的冒险家，很敏锐嘛。",
            "nextDialogs": [
              "411240212"
            ]
          },
          "411240212": {
            "id": "411240212",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "虽然西风骑士们已经提高了警惕，但为了支援周围，蒙德城的城防多多少少还是有一些漏洞。",
            "nextDialogs": [
              "411240213"
            ]
          },
          "411240213": {
            "id": "411240213",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "那群为了钱什么都愿意做的盗宝团，一定已经开始做打算，准备钻空子进城来「大捞一笔」了吧。"
          },
          "411240209": {
            "id": "411240209",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "哈哈哈，你想到哪里去了，丘丘人可没机会浑水摸鱼。",
            "nextDialogs": [
              "411240210"
            ]
          },
          "411240210": {
            "id": "411240210",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "只要它们靠近城边，西风骑士们就会马上把它们击退啦。",
            "nextDialogs": [
              "411240211"
            ]
          },
          "411240211": {
            "id": "411240211",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "我说的那群想要浑水摸鱼的家伙，是盗宝团哦。"
          }
        }
      }
    },

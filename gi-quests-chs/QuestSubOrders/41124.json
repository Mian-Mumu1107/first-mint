    {
      "subId": "4112408",
      "subQuestName": "向薇尔回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411240801"
        ],
        "dialogs": {
          "411240801": {
            "id": "411240801",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "你打倒那些盗宝团了吗？",
            "nextDialogs": [
              "411240802"
            ]
          },
          "411240802": {
            "id": "411240802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "全部打倒了。",
            "nextDialogs": [
              "411240803"
            ]
          },
          "411240803": {
            "id": "411240803",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "不愧是那位先生特意点名的人，办事的效率可真高。",
            "nextDialogs": [
              "411240804"
            ]
          },
          "411240804": {
            "id": "411240804",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "这些是报酬，收下吧，合作…啊，这次的合作愉快。",
            "nextDialogs": [
              "411240805"
            ]
          },
          "411240805": {
            "id": "411240805",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "说不定，我们之后还会有不少合作的机会呢。"
          }
        }
      }
    },
    {
      "subId": "4112452",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411245201"
        ],
        "dialogs": {
          "411245201": {
            "id": "411245201",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "你还没出发吗？啊…是还有什么事想问吗？",
            "nextDialogs": [
              "411245203",
              "411245206"
            ]
          },
          "411245203": {
            "id": "411245203",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "唔，那位先生和你是老相识了哦，据他说，他还曾经和你并肩作战过一段时间呢。",
            "nextDialogs": [
              "411245204"
            ]
          },
          "411245204": {
            "id": "411245204",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "不过，我可不能把他的名字直接告诉你，不然那位先生肯定要怪罪我了。"
          },
          "411245206": {
            "id": "411245206",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "你想说…就算是打倒了那些被这三封信引来的盗宝团，剩余的得到了消息之后，也会马上逃掉，对吧？",
            "nextDialogs": [
              "411245207"
            ]
          },
          "411245207": {
            "id": "411245207",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "唔…没错，这就是那位先生的目的。并不是「一网打尽」，而是「稍作震慑」。",
            "nextDialogs": [
              "411245208"
            ]
          },
          "411245208": {
            "id": "411245208",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "在现在这种情况下，骑士团抽不出人手进行大规模的追捕。",
            "nextDialogs": [
              "411245209"
            ]
          },
          "411245209": {
            "id": "411245209",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "毕竟，现在最重要也最急需处理的事，是那些从天而降的陨石。",
            "nextDialogs": [
              "411245210"
            ]
          },
          "411245210": {
            "id": "411245210",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "至于盗宝团…只要让他们别在这段时间里捣乱就好了。"
          }
        }
      }
    },
    {
      "subId": "4112456",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411245601"
        ],
        "dialogs": {
          "411245601": {
            "id": "411245601",
            "speakerId": 1000,
            "speakerName": "薇尔",
            "text": "打倒了这批盗宝团之后，剩下的盗宝团应该也会安份一点了吧…"
          }
        }
      }
    }
  ]
}
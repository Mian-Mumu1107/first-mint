{
  "lineCounts": {
    "Player": 39,
    "朱老板": 11,
    "派蒙": 38,
    "莫娜": 65,
    "？？？": 4
  },
  "subQuests": [
    {
      "subId": "1050007",
      "subQuestName": "前往璃月港外",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000701"
        ],
        "dialogs": {
          "105000701": {
            "id": "105000701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "找到了！就是这个戒指吧！",
            "nextDialogs": [
              "105000702"
            ]
          },
          "105000702": {
            "id": "105000702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么漂亮，肯定值不少钱…",
            "nextDialogs": [
              "105000703"
            ]
          },
          "105000703": {
            "id": "105000703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，我可没想什么歪主意！我们快把它还给<color=#00E1FFFF>朱老板</color>吧！"
          }
        }
      }
    },
    {
      "subId": "1050001",
      "subQuestName": "询问拦路少女的来意",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000101"
        ],
        "dialogs": {
          "105000101": {
            "id": "105000101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为、为什么你会知道这件事！",
            "nextDialogs": [
              "105000102"
            ]
          },
          "105000102": {
            "id": "105000102",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "因为我所掌握的，是真正的「占星术」。",
            "nextDialogs": [
              "105000103"
            ]
          },
          "105000103": {
            "id": "105000103",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "没什么疑问的话，我们就出发吧。",
            "nextDialogs": [
              "105000106"
            ]
          },
          "105000106": {
            "id": "105000106",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "唉，真麻烦，那我耐心一点解释吧。",
            "nextDialogs": [
              "105000107"
            ]
          },
          "105000107": {
            "id": "105000107",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我的名字是阿斯托洛吉斯·莫娜·梅姬斯图斯，考虑到记错我的名字会非常失礼，通常我会允许别人叫我莫娜。",
            "nextDialogs": [
              "105000108"
            ]
          },
          "105000108": {
            "id": "105000108",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我是占星术士，现在正要替我的师父，去蒙德城拿一个箱子。",
            "nextDialogs": [
              "105000109"
            ]
          },
          "105000109": {
            "id": "105000109",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "这是她和一位朋友，在五十年前定下的约定。但现在她上了年纪，行动很不方便，只能靠我了。",
            "nextDialogs": [
              "105000110"
            ]
          },
          "105000110": {
            "id": "105000110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "拿回箱子…这件事听起来和我们没什么关系？为什么要拉我们一起走呢？",
            "nextDialogs": [
              "105000111"
            ]
          },
          "105000111": {
            "id": "105000111",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "这个嘛…因为我还想和那个保管箱子的家伙较量较量。",
            "nextDialogs": [
              "105000112"
            ]
          },
          "105000112": {
            "id": "105000112",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "师父和她的朋友在神秘学方面斗了一辈子，也没能分出胜负。要是我能赢，那我不就比师父还厉害了！"
          }
        }
      }
    },
    {
      "subId": "1050002",
      "subQuestName": "询问拦路少女的来意",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1050003",
      "subQuestName": "陪同莫娜，向朱老板道别",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000201"
        ],
        "dialogs": {
          "105000201": {
            "id": "105000201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（客栈开在这种地方，生意当然不会好了…）",
            "nextDialogs": [
              "105000202"
            ]
          },
          "105000202": {
            "id": "105000202",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "莫娜，你来得正好！你来的路上，看见了一个玉石戒指吗？",
            "nextDialogs": [
              "105000203"
            ]
          },
          "105000203": {
            "id": "105000203",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "玉石戒指？好像没什么印象。",
            "nextDialogs": [
              "105000204"
            ]
          },
          "105000204": {
            "id": "105000204",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "这可麻烦了…我的宝贝戒指一不留神就被史莱姆吞掉了，那可是我母亲留给我的。",
            "nextDialogs": [
              "105000205"
            ]
          },
          "105000205": {
            "id": "105000205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？这种事有莫娜在就不愁了吧。她的占星术那么厉害…",
            "nextDialogs": [
              "105000206"
            ]
          },
          "105000206": {
            "id": "105000206",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "那可不行，占星术是用来洞察真实、观测命运的严肃知识，可不是用来打杂的。",
            "nextDialogs": [
              "105000207"
            ]
          },
          "105000207": {
            "id": "105000207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但你之前不是说，老板很照顾你吗？",
            "nextDialogs": [
              "105000208"
            ]
          },
          "105000208": {
            "id": "105000208",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "这是尊严，也是心境的问题，占星术士如果认为占星术能解决一切，就会被星空放弃。",
            "nextDialogs": [
              "105000209"
            ]
          },
          "105000209": {
            "id": "105000209",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "占卜会失去指引的能力，再也看不透前方的迷雾，所以，原则就是原则。",
            "nextDialogs": [
              "105000210"
            ]
          },
          "105000210": {
            "id": "105000210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有这么厉害的能力居然不用来赚钱，太可惜了…",
            "nextDialogs": [
              "105000211"
            ]
          },
          "105000211": {
            "id": "105000211",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "唉，本来说如果你们愿意，我可以出两万摩拉作酬谢的。",
            "nextDialogs": [
              "105000212"
            ]
          },
          "105000212": {
            "id": "105000212",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "两万…！",
            "nextDialogs": [
              "105000215"
            ]
          },
          "105000215": {
            "id": "105000215",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "没、没有啊？只是，觉得…能捡到戒指的人，运气真好啊，这样就能赚两万摩拉。"
          }
        }
      }
    },
    {
      "subId": "1050004",
      "subQuestName": "引来史莱姆，找回朱老板的戒指",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000401"
        ],
        "dialogs": {
          "105000401": {
            "id": "105000401",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "在<color=#00E1FFFF>天衡山</color>外，有一家小客栈，不知道为什么生意不太好，明明饭菜都物美价廉。"
          }
        }
      }
    },
    {
      "subId": "1050005",
      "subQuestName": "消灭史莱姆，寻找戒指",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000501"
        ],
        "dialogs": {
          "105000501": {
            "id": "105000501",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "那就拜托你们了，那个戒指真的对我非常重要。"
          }
        }
      }
    },
    {
      "subId": "1050008",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1050006",
      "subQuestName": "将戒指还给朱老板",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000301"
        ],
        "dialogs": {
          "105000301": {
            "id": "105000301",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "就是这个，就是这个！我还以为永远都见不到它了！",
            "nextDialogs": [
              "105000302"
            ]
          },
          "105000302": {
            "id": "105000302",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "居然真的找到了，你们挺厉害的嘛。",
            "nextDialogs": [
              "105000303"
            ]
          },
          "105000303": {
            "id": "105000303",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "朱老板，像这种珍贵的东西，一定要好好保管，下次可能就没这么好运了。",
            "nextDialogs": [
              "105000304"
            ]
          },
          "105000304": {
            "id": "105000304",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "没错没错，要是弄丢了我母亲送我的这第二百五十三个戒指，我都不知道怎么回家交待。",
            "nextDialogs": [
              "105000308"
            ]
          },
          "105000308": {
            "id": "105000308",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "哦，可能有些小误会。我家里有三座玉石矿，家母为了让我讨个好媳妇，就准备了很多玉石首饰当传家宝。",
            "nextDialogs": [
              "105000309"
            ]
          },
          "105000309": {
            "id": "105000309",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "加起来大概有五百多件吧。",
            "nextDialogs": [
              "105000310"
            ]
          },
          "105000310": {
            "id": "105000310",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "那你为什么还要在这里开客栈啊！",
            "nextDialogs": [
              "105000311"
            ]
          },
          "105000311": {
            "id": "105000311",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "太早继承了家业，难免会觉得单调和枯燥嘛。",
            "nextDialogs": [
              "105000312"
            ]
          },
          "105000312": {
            "id": "105000312",
            "speakerId": 2430,
            "speakerName": "朱老板",
            "text": "总之非常感谢你们，这是答应要给你们的摩拉，请一定收下。",
            "nextDialogs": [
              "105000313"
            ]
          },
          "105000313": {
            "id": "105000313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我…",
            "nextDialogs": [
              "105000314"
            ]
          },
          "105000314": {
            "id": "105000314",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "那我就不客气了！"
          }
        }
      }
    },
    {
      "subId": "1050004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000402"
        ],
        "dialogs": {
          "105000402": {
            "id": "105000402",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "老板这段时间很照顾我，出发之前，我想和他道个别。",
            "nextDialogs": [
              "105000403"
            ]
          },
          "105000403": {
            "id": "105000403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「元素诱饵」的效果很强，能把周围的史莱姆全都引过来。",
            "nextDialogs": [
              "105000404"
            ]
          },
          "105000404": {
            "id": "105000404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哪怕是史莱姆，数量多起来也是很危险的，一定要做好准备啊。"
          }
        }
      }
    },
    {
      "subId": "1050006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000601"
        ],
        "dialogs": {
          "105000601": {
            "id": "105000601",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "这可是师父交给你的第一个任务，不要搞砸了。",
            "nextDialogs": [
              "105000602"
            ]
          },
          "105000602": {
            "id": "105000602",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "如果对你而言实在太难了的话，哼哼，那时候我再出手吧。"
          }
        }
      }
    },
    {
      "subId": "1050008",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000825"
        ],
        "dialogs": {
          "105000825": {
            "id": "105000825",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你知道吗？晨曦酒庄在酿酒的时候，意外提炼出一种东西。",
            "nextDialogs": [
              "105000826"
            ]
          },
          "105000826": {
            "id": "105000826",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然配方保密，但对史莱姆有很强的吸引效果。",
            "nextDialogs": [
              "105000827"
            ]
          },
          "105000827": {
            "id": "105000827",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实…嘿嘿，我悄悄带了一点在身上！",
            "nextDialogs": [
              "105000829",
              "105000831"
            ]
          },
          "105000829": {
            "id": "105000829",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "作为搭档，我很可靠吧？",
            "nextDialogs": [
              "105000832"
            ]
          },
          "105000832": {
            "id": "105000832",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "看起来，你们有好办法了？",
            "nextDialogs": [
              "105000833"
            ]
          },
          "105000833": {
            "id": "105000833",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们去去就来！"
          },
          "105000831": {
            "id": "105000831",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀，细节就不用在意啦。"
          }
        }
      }
    },
    {
      "subId": "1050009",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105000901"
        ],
        "dialogs": {
          "105000901": {
            "id": "105000901",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "能轻易看穿这种秘密，难道还不能唤起你的记忆吗？",
            "nextDialogs": [
              "105000904"
            ]
          },
          "105000904": {
            "id": "105000904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，我想起来了！是那个占星术士！",
            "nextDialogs": [
              "105000905"
            ]
          },
          "105000905": {
            "id": "105000905",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "没错，正是我，阿斯托洛吉斯·莫娜·梅姬斯图斯。",
            "nextDialogs": [
              "105000906"
            ]
          },
          "105000906": {
            "id": "105000906",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "这次前来，是想要你们跟我去一趟蒙德，拿回一个属于我师父的箱子。",
            "nextDialogs": [
              "105000907"
            ]
          },
          "105000907": {
            "id": "105000907",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "这是她和一位朋友，在五十年前定下的约定。但现在她上了年纪，行动很不方便，只能靠我了。",
            "nextDialogs": [
              "105000908"
            ]
          },
          "105000908": {
            "id": "105000908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "拿回箱子…这件事听起来和我们没什么关系？为什么要拉我们一起走呢？",
            "nextDialogs": [
              "105000909"
            ]
          },
          "105000909": {
            "id": "105000909",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "这个嘛…因为我还想和那个保管箱子的家伙较量较量。",
            "nextDialogs": [
              "105000910"
            ]
          },
          "105000910": {
            "id": "105000910",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "师父和她的朋友在神秘学方面斗了一辈子，也没能分出胜负。要是我能赢，那我不就比师父还厉害了！"
          }
        }
      }
    }
  ]
}
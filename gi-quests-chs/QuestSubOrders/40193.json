  "subQuests": [
    {
      "subId": "4019301",
      "subQuestName": "与一斗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930101"
        ],
        "dialogs": {
          "401930101": {
            "id": "401930101",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哦！挚友，听说你们昨晚去了「秋沙钱汤」对吧？",
            "nextDialogs": [
              "401930102"
            ]
          },
          "401930102": {
            "id": "401930102",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "我打算叫上所有人，再去「秋沙钱汤」好好地庆上一回功！怎么样？你也去吧！",
            "nextDialogs": [
              "401930103"
            ]
          },
          "401930103": {
            "id": "401930103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，可是昨晚不是已经去过一次了吗…",
            "nextDialogs": [
              "401930104"
            ]
          },
          "401930104": {
            "id": "401930104",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "呃…你看这不是还有昨晚没去成的吗？比如阿忍…五郎…还有绫人兄弟…",
            "nextDialogs": [
              "401930105"
            ]
          },
          "401930105": {
            "id": "401930105",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "简单来说，是老大听说过后，自己很想去。",
            "nextDialogs": [
              "401930106"
            ]
          },
          "401930106": {
            "id": "401930106",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "总…总之！你要是逛得差不多了，就来跟我说一声，大家一起去泡！温！泉！"
          }
        }
      }
    },
    {
      "subId": "4019304",
      "subQuestName": "随一斗离开会场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930501"
        ],
        "dialogs": {
          "401930501": {
            "id": "401930501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要出发了！",
            "nextDialogs": [
              "401930502"
            ]
          },
          "401930502": {
            "id": "401930502",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "好嘞！目标——「秋沙钱汤」！"
          }
        }
      }
    },
    {
      "subId": "4019302",
      "subQuestName": "前往「秋沙钱汤」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930201"
        ],
        "dialogs": {
          "401930201": {
            "id": "401930201",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "在一斗的连番催促下，众人再次前往秋沙钱汤…",
            "nextDialogs": [
              "401930202"
            ]
          },
          "401930202": {
            "id": "401930202",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哈哈哈！这里应该就是最热的了！今天我们就来比一比，谁能在温泉里坚持最久！",
            "nextDialogs": [
              "401930203"
            ]
          },
          "401930203": {
            "id": "401930203",
            "speakerId": 1033,
            "speakerName": "托马",
            "text": "呵呵，一斗兄如此盛情，我又怎么能不奉陪呢？",
            "nextDialogs": [
              "401930204"
            ]
          },
          "401930204": {
            "id": "401930204",
            "speakerId": 1049,
            "speakerName": "久岐忍",
            "text": "我说…这又不是在蒸桑拿…",
            "nextDialogs": [
              "401930205"
            ]
          },
          "401930205": {
            "id": "401930205",
            "speakerId": 1040,
            "speakerName": "早柚",
            "text": "温泉…好暖和…呼呼…",
            "nextDialogs": [
              "401930206"
            ]
          },
          "401930206": {
            "id": "401930206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不、不要在浴池里睡着啊！",
            "nextDialogs": [
              "401930207"
            ]
          },
          "401930207": {
            "id": "401930207",
            "speakerId": 1039,
            "speakerName": "五郎",
            "text": "唔…毛皮变得好重，感觉有点头晕…",
            "nextDialogs": [
              "401930208"
            ]
          },
          "401930208": {
            "id": "401930208",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "哈哈哈！五郎兄弟！可别说这就不行了啊！",
            "nextDialogs": [
              "401930209"
            ]
          },
          "401930209": {
            "id": "401930209",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "喂——浴场内禁止喧哗！",
            "nextDialogs": [
              "401930210"
            ]
          },
          "401930210": {
            "id": "401930210",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "与此同时，在另一边…",
            "nextDialogs": [
              "401930211"
            ]
          },
          "401930211": {
            "id": "401930211",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "呵呵，一斗兄弟还是那么有精神啊。",
            "nextDialogs": [
              "401930212"
            ]
          },
          "401930212": {
            "id": "401930212",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "兄长，对局中分神可不好哦。",
            "nextDialogs": [
              "401930213"
            ]
          },
          "401930213": {
            "id": "401930213",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "#嚯嚯——比赛已经来到了最焦灼的阶段！{NICKNAME}会怎么应对呢！两位大师！你们有什么看法？",
            "nextDialogs": [
              "401930214"
            ]
          },
          "401930214": {
            "id": "401930214",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "嗯…如果是我的话，会考虑步步为营，巩固优势。",
            "nextDialogs": [
              "401930215"
            ]
          },
          "401930215": {
            "id": "401930215",
            "speakerId": 1057,
            "speakerName": "鹿野院平藏",
            "text": "唔，积极进攻，险中求胜…也是一个好办法。",
            "nextDialogs": [
              "401930218"
            ]
          },
          "401930218": {
            "id": "401930218",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "哦？竟有如此妙手？看来我败局已定，不必继续了。那按照之前抽签的顺序，接下来就该轮到…",
            "nextDialogs": [
              "401930219"
            ]
          },
          "401930219": {
            "id": "401930219",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "绫华，要玩得开心哦。",
            "nextDialogs": [
              "401930220"
            ]
          },
          "401930220": {
            "id": "401930220",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "#啊…好！好的！{NICKNAME}，请多指教…",
            "nextDialogs": [
              "401930221"
            ]
          },
          "401930221": {
            "id": "401930221",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（绫人这家伙，怕不是想让绫华多玩一会儿故意输的吧…）"
          }
        }
      }
    },
    {
      "subId": "4019303",
      "subQuestName": "前往「秋沙钱汤」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930301"
        ],
        "dialogs": {
          "401930301": {
            "id": "401930301",
            "speakerId": 3038,
            "speakerName": "蓝川丞",
            "text": "老板！这「三川花祭」可真不错！这几天来我们这儿的游客数量，比平时翻了三倍啊！",
            "nextDialogs": [
              "401930302"
            ]
          },
          "401930302": {
            "id": "401930302",
            "speakerId": 3038,
            "speakerName": "蓝川丞",
            "text": "这个月的营业金额…恐怕能上这个数！",
            "nextDialogs": [
              "401930303"
            ]
          },
          "401930303": {
            "id": "401930303",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "很不错嘛，看来这个月，说不定能正面击败八重堂…",
            "nextDialogs": [
              "401930304"
            ]
          },
          "401930304": {
            "id": "401930304",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "什么事情这么高兴？怎么不叫上我？",
            "nextDialogs": [
              "401930305"
            ]
          },
          "401930305": {
            "id": "401930305",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "啊哈…也没什么…",
            "nextDialogs": [
              "401930306"
            ]
          },
          "401930306": {
            "id": "401930306",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "哦，我倒是有个好消息忘了跟你分享…",
            "nextDialogs": [
              "401930307"
            ]
          },
          "401930307": {
            "id": "401930307",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "「三川花祭」的三成收益，都会划到八重堂的账上哦。这个月应该能创纪录了吧？来恭喜我吧。",
            "nextDialogs": [
              "401930308"
            ]
          },
          "401930308": {
            "id": "401930308",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "什么——！",
            "nextDialogs": [
              "401930309"
            ]
          },
          "401930309": {
            "id": "401930309",
            "speakerId": 3038,
            "speakerName": "蓝川丞",
            "text": "那…那不如，恭喜老板在第三百三十三次挑战八重堂营收的尝试中，取得了亚军的好成绩！",
            "nextDialogs": [
              "401930310"
            ]
          },
          "401930310": {
            "id": "401930310",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "呵呵呵…",
            "nextDialogs": [
              "401930311"
            ]
          },
          "401930311": {
            "id": "401930311",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "…祝愿今夜，人人皆得「好梦」。"
          }
        }
      }
    },
    {
      "subId": "4019304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930401"
        ],
        "dialogs": {
          "401930401": {
            "id": "401930401",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "怎么样？要出发了吗？要出发了吗！"
          }
        }
      }
    },
    {
      "subId": "4019306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930601"
        ],
        "dialogs": {
          "401930601": {
            "id": "401930601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再等等…",
            "nextDialogs": [
              "401930602"
            ]
          },
          "401930602": {
            "id": "401930602",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "你不会也跟阿晃他们一样沉迷游艺了吧…虽然游艺是很好玩，但先泡完温泉也不迟嘛！"
          }
        }
      }
    },
    {
      "subId": "4019307",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401930701"
        ],
        "dialogs": {
          "401930701": {
            "id": "401930701",
            "speakerId": 12278,
            "speakerName": "阿守",
            "text": "欸？你没跟老大他们去泡温泉吗？",
            "nextDialogs": [
              "401930702"
            ]
          },
          "401930702": {
            "id": "401930702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们怎么不去？",
            "nextDialogs": [
              "401930703"
            ]
          },
          "401930703": {
            "id": "401930703",
            "speakerId": 12276,
            "speakerName": "阿晃",
            "text": "…我们以前跟老大去过一次。但老大当时突发奇想，突然就开始比赛…",
            "nextDialogs": [
              "401930704"
            ]
          },
          "401930704": {
            "id": "401930704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "比赛什么？",
            "nextDialogs": [
              "401930705"
            ]
          },
          "401930705": {
            "id": "401930705",
            "speakerId": 12277,
            "speakerName": "元太",
            "text": "…忘了，只记得当时差点就热晕过去了。"
          }
        }
      }
    }
  ]
}
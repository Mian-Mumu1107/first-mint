{
  "lineCounts": {
    "Black Screen": 1,
    "玛梅赫": 10,
    "莉奈娅": 13,
    "西摩尔": 5
  },
  "subQuests": [
    {
      "subId": "7619301",
      "subQuestName": "与美露莘对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761930101"
        ],
        "dialogs": {
          "761930101": {
            "id": "761930101",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "呜啊！真的是美露莘！可爱的美露莘，乖乖的美露莘，小小的美露莘…",
            "nextDialogs": [
              "761930102"
            ]
          },
          "761930102": {
            "id": "761930102",
            "speakerId": 5301,
            "speakerName": "玛梅赫",
            "text": "欸…？你是…",
            "nextDialogs": [
              "761930103"
            ]
          },
          "761930103": {
            "id": "761930103",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "那个…我可以摸摸你吗？我一直都很好奇，像美露莘这样又可爱又聪明的小家伙，摸起来到底是什么感觉…",
            "nextDialogs": [
              "761930104"
            ]
          },
          "761930104": {
            "id": "761930104",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "是滑滑的，还是软软的，还是毛茸茸的…嘿嘿，别害怕喔，真的只是摸摸而已…",
            "nextDialogs": [
              "761930105"
            ]
          },
          "761930105": {
            "id": "761930105",
            "speakerId": 5301,
            "speakerName": "玛梅赫",
            "text": "欸、欸…？！",
            "nextDialogs": [
              "761930106"
            ]
          },
          "761930106": {
            "id": "761930106",
            "speakerId": 5303,
            "speakerName": "西摩尔",
            "text": "请保持冷静，小姐，以免触犯法典。",
            "nextDialogs": [
              "761930107"
            ]
          },
          "761930107": {
            "id": "761930107",
            "speakerId": 5303,
            "speakerName": "西摩尔",
            "text": "玛梅赫小姐是枫丹廷的公民。未经允许的身体接触可能会招致误会，并导致包括三年以上监禁及永久禁止入境在内的严重后果。",
            "nextDialogs": [
              "761930108"
            ]
          },
          "761930108": {
            "id": "761930108",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "哇啊——！会、会动还会说话的机械——",
            "nextDialogs": [
              "761930109"
            ]
          },
          "761930109": {
            "id": "761930109",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "…咳！抱歉抱歉，因为美露莘实在是太可爱了，所以我情不自禁就…",
            "nextDialogs": [
              "761930110"
            ]
          },
          "761930110": {
            "id": "761930110",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "我叫莉奈娅，是冒险家协会的顾问！真的不是什么奇怪的人喔！",
            "nextDialogs": [
              "761930111"
            ]
          },
          "761930111": {
            "id": "761930111",
            "speakerId": 5303,
            "speakerName": "西摩尔",
            "text": "否定。任何奇怪的人都不会自称是「奇怪的人」。这是基本的逻辑推理，尊敬的莉奈娅小姐。",
            "nextDialogs": [
              "761930112"
            ]
          },
          "761930112": {
            "id": "761930112",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "呜…！",
            "nextDialogs": [
              "761930113"
            ]
          },
          "761930113": {
            "id": "761930113",
            "speakerId": 5301,
            "speakerName": "玛梅赫",
            "text": "不可以随便说别人是奇怪的人啦，西摩尔。",
            "nextDialogs": [
              "761930114"
            ]
          },
          "761930114": {
            "id": "761930114",
            "speakerId": 5301,
            "speakerName": "玛梅赫",
            "text": "个子不怎么高的妖精小姐，颜色很漂亮。虽然不像父亲{RUBY#[D]厄里那斯}大人，但是暖暖的，很好看。所以不是奇怪的人。",
            "nextDialogs": [
              "761930115"
            ]
          },
          "761930115": {
            "id": "761930115",
            "speakerId": 5303,
            "speakerName": "西摩尔",
            "text": "否定。除紫色外，颜色通常与立场无关。这是基本的逻辑推理，玛梅赫小姐。",
            "nextDialogs": [
              "761930116"
            ]
          },
          "761930116": {
            "id": "761930116",
            "speakerId": 5301,
            "speakerName": "玛梅赫",
            "text": "…不是说衣服的颜色啦。",
            "nextDialogs": [
              "761930117"
            ]
          },
          "761930117": {
            "id": "761930117",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "咦？为什么要排除紫色来着？",
            "nextDialogs": [
              "761930118"
            ]
          },
          "761930118": {
            "id": "761930118",
            "speakerId": 5301,
            "speakerName": "玛梅赫",
            "text": "总之…你好，莉奈娅。我叫玛梅赫，是从枫丹来的旅行画家。他是西摩尔，是我的好朋友。",
            "nextDialogs": [
              "761930119"
            ]
          },
          "761930119": {
            "id": "761930119",
            "speakerId": 5301,
            "speakerName": "玛梅赫",
            "text": "没想到会在这种地方遇到其他人。莉奈娅，也是来取材的吗？",
            "nextDialogs": [
              "761930120"
            ]
          },
          "761930120": {
            "id": "761930120",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "取材…嗯，让我想想，增补图鉴应该也能算是取材吧？",
            "nextDialogs": [
              "761930121"
            ]
          },
          "761930121": {
            "id": "761930121",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向玛梅赫说了那头粉色霜鳍鲸的事…",
            "nextDialogs": [
              "761930122"
            ]
          },
          "761930122": {
            "id": "761930122",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "不过…嘿嘿，说不定玫熙说得对，那头霜鳍鲸确实是会给人带来好运的动物呢！甚至还能让我见到可爱的美露莘——",
            "nextDialogs": [
              "761930123"
            ]
          },
          "761930123": {
            "id": "761930123",
            "speakerId": 5303,
            "speakerName": "西摩尔",
            "text": "请保持冷静，小姐，以免触犯法典。",
            "nextDialogs": [
              "761930124"
            ]
          },
          "761930124": {
            "id": "761930124",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "我、我知道啦！不会随便摸摸的！",
            "nextDialogs": [
              "761930125"
            ]
          },
          "761930125": {
            "id": "761930125",
            "speakerId": 5301,
            "speakerName": "玛梅赫",
            "text": "原来如此。莉奈娅，很喜欢动物？",
            "nextDialogs": [
              "761930126"
            ]
          },
          "761930126": {
            "id": "761930126",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "是的！呜呜，要是我也能像美露莘一样，在水里游得那么快就好了！那些霜鳍鲸玩得好开心，我也想和它们一起玩…",
            "nextDialogs": [
              "761930127"
            ]
          },
          "761930127": {
            "id": "761930127",
            "speakerId": 5301,
            "speakerName": "玛梅赫",
            "text": "嗯…那就把这幅画送给莉奈娅吧。",
            "nextDialogs": [
              "761930128"
            ]
          },
          "761930128": {
            "id": "761930128",
            "speakerId": 5301,
            "speakerName": "玛梅赫",
            "text": "虽然不能让你在水里游得很快。但是，挂在房间里，说不定也会有「和霜鳍鲸一起玩」的感觉。",
            "nextDialogs": [
              "761930129"
            ]
          },
          "761930129": {
            "id": "761930129",
            "speakerId": 1327,
            "speakerName": "莉奈娅",
            "text": "哇啊，谢谢你！好漂亮的画！等回去以后，我一定要给「斯佩兰扎」的大家都看看！"
          }
        }
      }
    },
    {
      "subId": "7619302",
      "subQuestName": "(test)废弃",

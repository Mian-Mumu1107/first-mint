    {
      "subId": "1201803",
      "subQuestName": "与影交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120180301"
        ],
        "dialogs": {
          "120180301": {
            "id": "120180301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，居然有这么隐蔽的地方！",
            "nextDialogs": [
              "120180302"
            ]
          },
          "120180302": {
            "id": "120180302",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "一般来说，没有理由在深山中修建这样的建筑。",
            "nextDialogs": [
              "120180305"
            ]
          },
          "120180305": {
            "id": "120180305",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "我感觉到了不属于此地的气息，危险的气息。",
            "nextDialogs": [
              "120180306"
            ]
          },
          "120180306": {
            "id": "120180306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "120180307"
            ]
          },
          "120180307": {
            "id": "120180307",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "小心点前进吧。那位九条家的后人，可能已经受困其中。"
          }
        }
      }
    },
    {
      "subId": "1201804",

  "subQuests": [
    {
      "subId": "4133711",
      "subQuestName": "(test)海灯节领取任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413371101"
        ],
        "dialogs": {
          "413371101": {
            "id": "413371101",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "师妹，你怎么突然头痛了，要不要先喝些药？",
            "nextDialogs": [
              "413371102"
            ]
          },
          "413371102": {
            "id": "413371102",
            "speakerId": 2418,
            "speakerName": "小雀儿",
            "text": "不、不用了，师兄你陪着我一会，我等会就好…"
          }
        }
      }
    },
    {
      "subId": "4133701",
      "subQuestName": "前往华光林",
      "sceneId": null,
      "locations": [],

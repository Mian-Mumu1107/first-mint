    {
      "subId": "4133710",
      "subQuestName": "向孙宇和小雀儿回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413371001"
        ],
        "dialogs": {
          "413371001": {
            "id": "413371001",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "咦，你回来了，霄灯已经放了吗？",
            "nextDialogs": [
              "413371002"
            ]
          },
          "413371002": {
            "id": "413371002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于放霄灯时的经历…",
            "nextDialogs": [
              "413371003"
            ]
          },
          "413371003": {
            "id": "413371003",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "原来如此，芷若…我还记得她，当年她还关照过我的。",
            "nextDialogs": [
              "413371004"
            ]
          },
          "413371004": {
            "id": "413371004",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "原来她还记得古华派啊，太好了，太好了…",
            "nextDialogs": [
              "413371005"
            ]
          },
          "413371005": {
            "id": "413371005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于小雀儿…",
            "nextDialogs": [
              "413371006"
            ]
          },
          "413371006": {
            "id": "413371006",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "啊，小雀儿的头痛好了些，刚才也许是真着凉了，我正准备给她…",
            "nextDialogs": [
              "413371007"
            ]
          },
          "413371007": {
            "id": "413371007",
            "speakerId": 2418,
            "speakerName": "小雀儿",
            "text": "师兄，刚刚你说的那个「芷若」…",
            "nextDialogs": [
              "413371008"
            ]
          },
          "413371008": {
            "id": "413371008",
            "speakerId": 2418,
            "speakerName": "小雀儿",
            "text": "是古华派的师姐吗？人好看吗？你和她很熟悉吗？",
            "nextDialogs": [
              "413371009"
            ]
          },
          "413371009": {
            "id": "413371009",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "唔…倒说不上熟悉，不过芷若很擅长做伤药，之前受了伤，大家都愿意去找她。",
            "nextDialogs": [
              "413371010"
            ]
          },
          "413371010": {
            "id": "413371010",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "哈哈哈，这么一说，古华派里的人，喜欢她的人应该也很多吧。",
            "nextDialogs": [
              "413371011"
            ]
          },
          "413371011": {
            "id": "413371011",
            "speakerId": 2418,
            "speakerName": "小雀儿",
            "text": "师兄，你呢？",
            "nextDialogs": [
              "413371012"
            ]
          },
          "413371012": {
            "id": "413371012",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "啊…啊？",
            "nextDialogs": [
              "413371013"
            ]
          },
          "413371013": {
            "id": "413371013",
            "speakerId": 2418,
            "speakerName": "小雀儿",
            "text": "师兄，你和这位芷若师姐之间的关系…",
            "nextDialogs": [
              "413371014"
            ]
          },
          "413371014": {
            "id": "413371014",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "这…我们也不太熟悉，嗯，可以说是同门之谊吧…",
            "nextDialogs": [
              "413371015"
            ]
          },
          "413371015": {
            "id": "413371015",
            "speakerId": 2418,
            "speakerName": "小雀儿",
            "text": "喔…那师兄，那你我之间的关系。",
            "nextDialogs": [
              "413371016"
            ]
          },
          "413371016": {
            "id": "413371016",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "哈哈哈，那自然是同门之谊了！",
            "nextDialogs": [
              "413371017"
            ]
          },
          "413371017": {
            "id": "413371017",
            "speakerId": 2418,
            "speakerName": "小雀儿",
            "text": "……",
            "nextDialogs": [
              "413371018"
            ]
          },
          "413371018": {
            "id": "413371018",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "师妹，师妹？你…你怎么了…"
          }
        }
      }
    }

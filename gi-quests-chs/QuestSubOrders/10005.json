    {
      "subId": "1000502",
      "subQuestName": "与阿贝多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100051301"
        ],
        "dialogs": {
          "100051301": {
            "id": "100051301",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "阿贝多，难得见到你这么闲。",
            "nextDialogs": [
              "100051302"
            ]
          },
          "100051302": {
            "id": "100051302",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "不过，既然完成了莱茵多特主人留下的「课题」，你确实也应该放松放松。",
            "nextDialogs": [
              "100051303"
            ]
          },
          "100051303": {
            "id": "100051303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你看！你话都没说完，麻烦就找上门了啊！",
            "nextDialogs": [
              "100051304"
            ]
          },
          "100051304": {
            "id": "100051304",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "赛巴斯，你怎么来了？",
            "nextDialogs": [
              "100051305"
            ]
          },
          "100051305": {
            "id": "100051305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿贝多认识它？",
            "nextDialogs": [
              "100051306"
            ]
          },
          "100051306": {
            "id": "100051306",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "是，它也是我老师莱茵多特的造物，勉强算是我的「家庭成员」吧。",
            "nextDialogs": [
              "100051307"
            ]
          },
          "100051307": {
            "id": "100051307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不愧是你的家庭关系。",
            "nextDialogs": [
              "100051308"
            ]
          },
          "100051308": {
            "id": "100051308",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "勉强？你这是什么口气，那么大一个屋子，就我一个管家。",
            "nextDialogs": [
              "100051309"
            ]
          },
          "100051309": {
            "id": "100051309",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "你和莱茵多特主人用过的瓶瓶罐罐，可都是我一只猫来清理的。",
            "nextDialogs": [
              "100051310"
            ]
          },
          "100051310": {
            "id": "100051310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你…不是一只猫吗？猫要怎么做管家啊，还要收拾瓶瓶罐罐…",
            "nextDialogs": [
              "100051311"
            ]
          },
          "100051311": {
            "id": "100051311",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "你怎么会飞在天上？",
            "nextDialogs": [
              "100051312"
            ]
          },
          "100051312": {
            "id": "100051312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？我一直都会啊。",
            "nextDialogs": [
              "100051313"
            ]
          },
          "100051313": {
            "id": "100051313",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "我也一直都会。请不要把事实当做问题，这种问题找不到答案。",
            "nextDialogs": [
              "100051314"
            ]
          },
          "100051314": {
            "id": "100051314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你，你你你…好生气！我要…",
            "nextDialogs": [
              "100051317"
            ]
          },
          "100051317": {
            "id": "100051317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我…我要拒绝听它讲话了！",
            "nextDialogs": [
              "100051318"
            ]
          },
          "100051318": {
            "id": "100051318",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "闲话就到此为止。阿贝多，我此次前来，是受莱茵多特主人所命，向你递送口信。",
            "nextDialogs": [
              "100051319"
            ]
          },
          "100051319": {
            "id": "100051319",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "咳咳…咳！",
            "nextDialogs": [
              "100051320"
            ]
          },
          "100051320": {
            "id": "100051320",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「亲爱的阿贝多，很高兴你为那个课题找到了『自己认可的解』。」",
            "nextDialogs": [
              "100051321"
            ]
          },
          "100051321": {
            "id": "100051321",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「不过，被解答后的问题，就失去了为之思考的意义。」",
            "nextDialogs": [
              "100051322"
            ]
          },
          "100051322": {
            "id": "100051322",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「你脑子里那枚闲不下来的钟摆，现在应该已经快要摆向『无聊』那一端了吧？」",
            "nextDialogs": [
              "100051323"
            ]
          },
          "100051323": {
            "id": "100051323",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「那么，你不如尝试一下，自己向自己提问吧。」",
            "nextDialogs": [
              "100051324"
            ]
          },
          "100051324": {
            "id": "100051324",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「丢开『已知的答案』，寻找『未知的问题』。」",
            "nextDialogs": [
              "100051325"
            ]
          },
          "100051325": {
            "id": "100051325",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「问题总是比答案更有趣的，也更能打发时间。」",
            "nextDialogs": [
              "100051326"
            ]
          },
          "100051326": {
            "id": "100051326",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「我很期待，下次见面时，你会给我带来什么样的『问题』。」",
            "nextDialogs": [
              "100051327"
            ]
          },
          "100051327": {
            "id": "100051327",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「如果你能找到连我都未曾设想过的问题，那就最好了。」",
            "nextDialogs": [
              "100051328"
            ]
          },
          "100051328": {
            "id": "100051328",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「虽然这种可能性不太大，但你还是先努努力吧，如果你运气够好，说不定真能吓我一跳。」",
            "nextDialogs": [
              "100051329"
            ]
          },
          "100051329": {
            "id": "100051329",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「对了，别想着造一个专门用来思考或者回答问题的『自己』。师父我已经试过了，压根没用。」",
            "nextDialogs": [
              "100051330"
            ]
          },
          "100051330": {
            "id": "100051330",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「最后说一句，我让赛巴斯顺便给你带了一份礼物，注意收起来，也别喂它吃东西，它根本不会饿。」",
            "nextDialogs": [
              "100051331"
            ]
          },
          "100051331": {
            "id": "100051331",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "谨遵老师教诲。",
            "nextDialogs": [
              "100051332"
            ]
          },
          "100051332": {
            "id": "100051332",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "咳，咳咳咳，莱茵多特主人就说了这么多…真是费劲，咳咳…咳…",
            "nextDialogs": [
              "100051333"
            ]
          },
          "100051333": {
            "id": "100051333",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "你已经听到口信了，我就不在这个冷得要命的地方陪你玩了。我接下来还得去蒙德城里送口信呢。",
            "nextDialogs": [
              "100051334"
            ]
          },
          "100051334": {
            "id": "100051334",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "蒙德城？",
            "nextDialogs": [
              "100051335"
            ]
          },
          "100051335": {
            "id": "100051335",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "蒙德城里还有和莱茵多特有关的人…啊！难道说…",
            "nextDialogs": [
              "100051336"
            ]
          },
          "100051336": {
            "id": "100051336",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "虽然他刚刚「诞生不久」，但莱茵多特主人早已预见了他所需要解决的「课题」。",
            "nextDialogs": [
              "100051337"
            ]
          },
          "100051337": {
            "id": "100051337",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "好了好了，我真的要走了，这地方太冷，冻得我尾巴痛。",
            "nextDialogs": [
              "100051338"
            ]
          },
          "100051338": {
            "id": "100051338",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "莱茵多特主人给你的「礼物」我放桌上了，记得收好。",
            "nextDialogs": [
              "100051339"
            ]
          },
          "100051339": {
            "id": "100051339",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多…你的家庭关系，好像越来越复杂了呢…",
            "nextDialogs": [
              "100051340"
            ]
          },
          "100051340": {
            "id": "100051340",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "又突然冒出来这么一只猫…",
            "nextDialogs": [
              "100051341"
            ]
          },
          "100051341": {
            "id": "100051341",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但话又说回来，这只猫真的能算成你的「家庭成员」吗？虽然它自称是管家什么的…",
            "nextDialogs": [
              "100051342"
            ]
          },
          "100051342": {
            "id": "100051342",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "赛巴斯确实很早就被老师创造出来了。如果按照一般人的理论，赛巴斯应该算是我的「长辈」。",
            "nextDialogs": [
              "100051343"
            ]
          },
          "100051343": {
            "id": "100051343",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "不过，鉴于我们并不是一般的「家庭」，所以这一层关系也没有意义。",
            "nextDialogs": [
              "100051344"
            ]
          },
          "100051344": {
            "id": "100051344",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "但我当时的确受了赛巴斯不少照顾，它除了帮我收拾瓶瓶罐罐外，有时候甚至会当我的素描模特。",
            "nextDialogs": [
              "100051345"
            ]
          },
          "100051345": {
            "id": "100051345",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下，你今天画的这只猫，难道就是赛巴斯？",
            "nextDialogs": [
              "100051346"
            ]
          },
          "100051346": {
            "id": "100051346",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "没错。这是我的一个习惯，在思考某些问题时，我会让我的手进行一些无意识的工作，以此来辅助思考。",
            "nextDialogs": [
              "100051347"
            ]
          },
          "100051347": {
            "id": "100051347",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "这个时候，我一般就会选择默画赛巴斯的画像…毕竟画了不知道多少遍，已经很熟练了，基本不用动脑。"
          }
        }
      }
    },
    {
      "subId": "1000502",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100050201"
        ],
        "dialogs": {
          "100050201": {
            "id": "100050201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多，你果然在这里呀。嗯…你是在画画么？",
            "nextDialogs": [
              "100050202"
            ]
          },
          "100050202": {
            "id": "100050202",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "嗯，之前太忙没空画画，最近正好闲下来，想着重新捡起画笔，练习一下。",
            "nextDialogs": [
              "100050203"
            ]
          },
          "100050203": {
            "id": "100050203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "之前确实经历好多事。",
            "nextDialogs": [
              "100050204"
            ]
          },
          "100050204": {
            "id": "100050204",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "是啊。但好在有你们和骑士团的大家协助，算是有惊无险地解决了那件事。",
            "nextDialogs": [
              "100050205"
            ]
          },
          "100050205": {
            "id": "100050205",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "而且，我还完成了老师留给我的最后一个课题。",
            "nextDialogs": [
              "100050206"
            ]
          },
          "100050206": {
            "id": "100050206",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "要论结果，可以说是再完美不过了。",
            "nextDialogs": [
              "100050207"
            ]
          },
          "100050207": {
            "id": "100050207",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "砂糖最近也学习得很快，已经能独立处理很多和炼金相关的事务了。",
            "nextDialogs": [
              "100050208"
            ]
          },
          "100050208": {
            "id": "100050208",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "骑士团暂时也没什么需要我出面解决的事…",
            "nextDialogs": [
              "100050209"
            ]
          },
          "100050209": {
            "id": "100050209",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "没有课题，没有事务，没有麻烦…",
            "nextDialogs": [
              "100050212"
            ]
          },
          "100050212": {
            "id": "100050212",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "没什么。我想，或许是习惯了每天都高频用脑的日子吧…",
            "nextDialogs": [
              "100050213"
            ]
          },
          "100050213": {
            "id": "100050213",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "就这样完全地闲下来，老实说，我还真的有点不适应。",
            "nextDialogs": [
              "100050214"
            ]
          },
          "100050214": {
            "id": "100050214",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "总是不由自主地思考，还有什么问题等待着我去解决。",
            "nextDialogs": [
              "100050215"
            ]
          },
          "100050215": {
            "id": "100050215",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "但是很遗憾，在目前的蒙德城，似乎所有问题都已经有了「完美的解」…",
            "nextDialogs": [
              "100050216"
            ]
          },
          "100050216": {
            "id": "100050216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "休息一下也没什么不好啊，要是每天都忙忙碌碌的，那身体不就累坏了？",
            "nextDialogs": [
              "100050217"
            ]
          },
          "100050217": {
            "id": "100050217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "实在不行，就和我们一起出去玩吧，我可是很懂怎么偷懒的喔！",
            "nextDialogs": [
              "100050218"
            ]
          },
          "100050218": {
            "id": "100050218",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "呵呵，那就要请派蒙好好教教我了。"
          }
        }
      }
    },
    {
      "subId": "1000512",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100051201"
        ],
        "dialogs": {
          "100051201": {
            "id": "100051201",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "…新的，问题…"
          }
        }
      }
    },
    {
      "subId": "1000514",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100051401"
        ],
        "dialogs": {
          "100051401": {
            "id": "100051401",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "阿贝多，难得见到你这么闲。",
            "nextDialogs": [
              "100051402"
            ]
          },
          "100051402": {
            "id": "100051402",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "不过，既然完成了莱茵多特主人留下的「课题」，你确实也应该放松放松。",
            "nextDialogs": [
              "100051403"
            ]
          },
          "100051403": {
            "id": "100051403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！赛、赛巴斯，你是从哪里冒出来的？一点动静也没有。",
            "nextDialogs": [
              "100051404"
            ]
          },
          "100051404": {
            "id": "100051404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "赛巴斯，又见面了。",
            "nextDialogs": [
              "100051405"
            ]
          },
          "100051405": {
            "id": "100051405",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "看来你之前见过赛巴斯了。不知道它有没有告诉你，我和它之间的关系。",
            "nextDialogs": [
              "100051406"
            ]
          },
          "100051406": {
            "id": "100051406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它说是你的「长辈」。",
            "nextDialogs": [
              "100051407"
            ]
          },
          "100051407": {
            "id": "100051407",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "…勉强算是吧。",
            "nextDialogs": [
              "100051408"
            ]
          },
          "100051408": {
            "id": "100051408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不愧是你的家庭关系。",
            "nextDialogs": [
              "100051409"
            ]
          },
          "100051409": {
            "id": "100051409",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "勉强？你这是什么口气，那么大一个屋子，就我一个管家。",
            "nextDialogs": [
              "100051410"
            ]
          },
          "100051410": {
            "id": "100051410",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "你和莱茵多特主人用过的瓶瓶罐罐，可都是我一只猫来清理的。",
            "nextDialogs": [
              "100051411"
            ]
          },
          "100051411": {
            "id": "100051411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你…不是一只猫吗？猫要怎么做管家啊，还要收拾瓶瓶罐罐…",
            "nextDialogs": [
              "100051412"
            ]
          },
          "100051412": {
            "id": "100051412",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "你怎么会飞在天上？",
            "nextDialogs": [
              "100051413"
            ]
          },
          "100051413": {
            "id": "100051413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？我一直都会啊。",
            "nextDialogs": [
              "100051414"
            ]
          },
          "100051414": {
            "id": "100051414",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "我也一直都会。请不要把事实当做问题，这种问题找不到答案。",
            "nextDialogs": [
              "100051415"
            ]
          },
          "100051415": {
            "id": "100051415",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你，你你你…好生气！我要…",
            "nextDialogs": [
              "100051418"
            ]
          },
          "100051418": {
            "id": "100051418",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我…我要拒绝听它讲话了！",
            "nextDialogs": [
              "100051419"
            ]
          },
          "100051419": {
            "id": "100051419",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "闲话就到此为止。阿贝多，我此次前来，是受莱茵多特主人所命，向你递送口信。",
            "nextDialogs": [
              "100051420"
            ]
          },
          "100051420": {
            "id": "100051420",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "咳咳…咳！",
            "nextDialogs": [
              "100051421"
            ]
          },
          "100051421": {
            "id": "100051421",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「亲爱的阿贝多，很高兴你为那个课题找到了『自己认可的解』。」",
            "nextDialogs": [
              "100051422"
            ]
          },
          "100051422": {
            "id": "100051422",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「不过，被解答后的问题，就失去了为之思考的意义。」",
            "nextDialogs": [
              "100051423"
            ]
          },
          "100051423": {
            "id": "100051423",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「你脑子里那枚闲不下来的钟摆，现在应该已经快要摆向『无聊』那一端了吧？」",
            "nextDialogs": [
              "100051424"
            ]
          },
          "100051424": {
            "id": "100051424",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「那么，你不如尝试一下，自己向自己提问吧。」",
            "nextDialogs": [
              "100051425"
            ]
          },
          "100051425": {
            "id": "100051425",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「丢开『已知的答案』，寻找『未知的问题』。」",
            "nextDialogs": [
              "100051426"
            ]
          },
          "100051426": {
            "id": "100051426",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「问题总是比答案更有趣的，也更能打发时间。」",
            "nextDialogs": [
              "100051427"
            ]
          },
          "100051427": {
            "id": "100051427",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「我很期待，下次见面时，你会给我带来什么样的『问题』。」",
            "nextDialogs": [
              "100051428"
            ]
          },
          "100051428": {
            "id": "100051428",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「如果你能找到连我都未曾设想过的问题，那就最好了。」",
            "nextDialogs": [
              "100051429"
            ]
          },
          "100051429": {
            "id": "100051429",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「虽然这种可能性不太大，但你还是先努努力吧，如果你运气够好，说不定真能吓我一跳。」",
            "nextDialogs": [
              "100051430"
            ]
          },
          "100051430": {
            "id": "100051430",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「对了，别想着造一个专门用来思考或者回答问题的『自己』。师父我已经试过了，压根没用。」",
            "nextDialogs": [
              "100051431"
            ]
          },
          "100051431": {
            "id": "100051431",
            "speakerId": 16025,
            "speakerName": "「莱茵多特」",
            "text": "「最后说一句，我让赛巴斯顺便给你带了一份礼物，注意收起来，也别喂它吃东西，它根本不会饿。」",
            "nextDialogs": [
              "100051432"
            ]
          },
          "100051432": {
            "id": "100051432",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "谨遵老师教诲。",
            "nextDialogs": [
              "100051433"
            ]
          },
          "100051433": {
            "id": "100051433",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "咳，咳咳咳，莱茵多特主人就说了这么多…真是费劲，咳咳…咳…",
            "nextDialogs": [
              "100051434"
            ]
          },
          "100051434": {
            "id": "100051434",
            "speakerId": 15861,
            "speakerName": "赛巴斯",
            "text": "总之，口信已经全部带到了。你为什么非得待在这个地方，和那位一样，待在蒙德城里不好吗…"
          }
        }
      }
    }
  ]
}
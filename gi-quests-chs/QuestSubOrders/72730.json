      }
    },
    {
      "subId": "7273005",
      "subQuestName": "与「电气鞘翅」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "727300501"
        ],
        "dialogs": {
          "727300501": {
            "id": "727300501",
            "speakerId": 1006,
            "speakerName": "「电气鞘翅」",
            "text": "真是平平无奇的对手，出战的鬼兜虫也花里胡哨…",
            "nextDialogs": [
              "727300502"
            ]
          },
          "727300502": {
            "id": "727300502",
            "speakerId": 1006,
            "speakerName": "「电气鞘翅」",
            "text": "肤浅！外观根本是无所谓的东西，鬼兜虫最重要的「性能」，是对雷之力的共鸣。",
            "nextDialogs": [
              "727300503"
            ]
          },
          "727300503": {
            "id": "727300503",
            "speakerId": 1006,
            "speakerName": "「电气鞘翅」",
            "text": "所以说，挑选鬼兜虫的眼光，就决定了斗虫生涯的一切！",
            "nextDialogs": [
              "727300504"
            ]
          },
          "727300504": {
            "id": "727300504",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "什么奇怪的理论…就连我都明白，最重要的应该是实战的表现吧？应该把主要的精力花费在训练斗虫的技巧上吧！",
            "nextDialogs": [
              "727300505"
            ]
          },
          "727300505": {
            "id": "727300505",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "就是啊！小堇瓜说得对！",
            "nextDialogs": [
              "727300506"
            ]
          },
          "727300506": {
            "id": "727300506",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "你斗都不会斗，还谈什么性能！",
            "nextDialogs": [
              "727300507"
            ]
          },
          "727300507": {
            "id": "727300507",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "听好了，白铁小堇瓜！你要观察对方鬼兜虫的动作，及时让我方鬼兜虫避开攻击，挑准对方出招后的破绽，发起猛攻！",
            "nextDialogs": [
              "727300508"
            ]
          },
          "727300508": {
            "id": "727300508",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "只要进入攻击范围，「赤红一杵」就会给对方狠狠一击！",
            "nextDialogs": [
              "727300509"
            ]
          },
          "727300509": {
            "id": "727300509",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "也就是说，对方准备攻击时，我就让鬼兜虫后退，对方露出破绽时，我就让鬼兜虫前进，打他个措手不及！",
            "nextDialogs": [
              "727300510"
            ]
          },
          "727300510": {
            "id": "727300510",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "#听起来很简单嘛，我试试看！{NICKNAME}听了一遍，应该也学会了！",
            "nextDialogs": [
              "727300511"
            ]
          },
          "727300511": {
            "id": "727300511",
            "speakerId": 1006,
            "speakerName": "「电气鞘翅」",
            "text": "居然临阵学习斗虫的技巧？可别把人看扁了啊！",
            "nextDialogs": [
              "727300512"
            ]
          },
          "727300512": {
            "id": "727300512",
            "speakerId": 1006,
            "speakerName": "「电气鞘翅」",
            "text": "那就别废话了，拿出你们的鬼兜虫，让我看看你们的斤两吧！"
          }
        }
      }
    },
    {
      "subId": "7273006",
      "subQuestName": "击败「电气鞘翅」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "727300601"
        ],
        "dialogs": {
          "727300601": {
            "id": "727300601",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嘿嘿，轻轻松松！是我「破空白铁小堇瓜」派蒙赢啦！",
            "nextDialogs": [
              "727300602"
            ]
          },
          "727300602": {
            "id": "727300602",
            "speakerId": 1007,
            "speakerName": "阿守&阿晃",
            "text": "小堇瓜威武！！！",
            "nextDialogs": [
              "727300603"
            ]
          },
          "727300603": {
            "id": "727300603",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "哦哟！哦哟哟！你还挺有天分嘛，白铁小堇瓜！狠狠地给了他们一个下马威！",
            "nextDialogs": [
              "727300604"
            ]
          },
          "727300604": {
            "id": "727300604",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "待会儿奖励你一碗鸟蛋烧！",
            "nextDialogs": [
              "727300607"
            ]
          },
          "727300607": {
            "id": "727300607",
            "speakerId": 1006,
            "speakerName": "「电气鞘翅」",
            "text": "「花角玉将」，我居然败给了一个新手…我愧对你！",
            "nextDialogs": [
              "727300608"
            ]
          },
          "727300608": {
            "id": "727300608",
            "speakerId": 1005,
            "speakerName": "「花角玉将」",
            "text": "放宽心，放宽心。看来对方找来的援军不是等闲之辈，我们也要让其他部将备甲上阵了。",
            "nextDialogs": [
              "727300609"
            ]
          },
          "727300609": {
            "id": "727300609",
            "speakerId": 1005,
            "speakerName": "「花角玉将」",
            "text": "「真剑斗虫大鬼王」，没想到你在如此之短的时间内就找来了可靠的将士，稳住了阵脚。",
            "nextDialogs": [
              "727300610"
            ]
          },
          "727300610": {
            "id": "727300610",
            "speakerId": 1005,
            "speakerName": "「花角玉将」",
            "text": "从今往后，我每天都会派遣一名部将，来到你们的主场掠阵。",
            "nextDialogs": [
              "727300611"
            ]
          },
          "727300611": {
            "id": "727300611",
            "speakerId": 1005,
            "speakerName": "「花角玉将」",
            "text": "你可要撑到最后啊，不然，你们荒泷派的战书就会成为斗虫界的笑柄哦…",
            "nextDialogs": [
              "727300612"
            ]
          },
          "727300612": {
            "id": "727300612",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "喂喂喂，走什么呀？难不成是怕了！",
            "nextDialogs": [
              "727300613"
            ]
          },
          "727300613": {
            "id": "727300613",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "突然出现又突然开溜，嘴上还嚣张得很，真让人恼火…",
            "nextDialogs": [
              "727300614"
            ]
          },
          "727300614": {
            "id": "727300614",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "听他的意思，「花角玉将」还会派出好几个部下来挑战我们，那岂不是再过不久就要开始对决了？",
            "nextDialogs": [
              "727300615"
            ]
          },
          "727300615": {
            "id": "727300615",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "没错，看来我们的时间不够了，来不及把「极意堂堂斗虫大试合」办成荒泷派最盛大的活动了…",
            "nextDialogs": [
              "727300616"
            ]
          },
          "727300616": {
            "id": "727300616",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "还好，相比热闹的气氛，现在本大爷更看重之后的对决！",
            "nextDialogs": [
              "727300617"
            ]
          },
          "727300617": {
            "id": "727300617",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "刚才飞行矮…呃咳！刚才「破空白铁小堇瓜」打败劲敌，一战成名，看得本大爷斗志昂扬！",
            "nextDialogs": [
              "727300618"
            ]
          },
          "727300618": {
            "id": "727300618",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "让本大爷想起了我还是个斗虫新手时，第一次向花见坂的强者发起挑战的情景…"
          }
        }
      }
    },

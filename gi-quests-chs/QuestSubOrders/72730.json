    {
      "subId": "7273002",
      "subQuestName": "旁听荒泷派的讨论",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "727300201"
        ],
        "dialogs": {
          "727300201": {
            "id": "727300201",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "老大，不能就这么算了啊！",
            "nextDialogs": [
              "727300202"
            ]
          },
          "727300202": {
            "id": "727300202",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "你好不容易打响了「真剑斗虫大鬼王」的名号，怎么能让那个小鬼得逞！",
            "nextDialogs": [
              "727300203"
            ]
          },
          "727300203": {
            "id": "727300203",
            "speakerId": 1001,
            "speakerName": "阿晃",
            "text": "对，那个小鬼一定使诈了，他暗算了老大！",
            "nextDialogs": [
              "727300204"
            ]
          },
          "727300204": {
            "id": "727300204",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "你们两个，慌什么！",
            "nextDialogs": [
              "727300205"
            ]
          },
          "727300205": {
            "id": "727300205",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "之前的那一仗，本大爷也有点轻敌。谁让那个小鬼看起来太普通了嘛！不算数，不算数！",
            "nextDialogs": [
              "727300206"
            ]
          },
          "727300206": {
            "id": "727300206",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "别管那小鬼耍了什么把戏，我们就按计划，摆开「荒泷极意堂堂斗虫大试合」的阵势，再拿出本大爷锤炼多年的「赤红一杵」！",
            "nextDialogs": [
              "727300207"
            ]
          },
          "727300207": {
            "id": "727300207",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "到时候，满场都是观众们为本大爷叫好的呼声，再加上「赤红一杵」碾压性的实力…",
            "nextDialogs": [
              "727300208"
            ]
          },
          "727300208": {
            "id": "727300208",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "那个小鬼绝对会吓得两腿发抖吧，什么伎俩都使不出来！本大爷轻轻松松就能把他拿下，啊哈哈哈哈哈哈哈哈哈！",
            "nextDialogs": [
              "727300209"
            ]
          },
          "727300209": {
            "id": "727300209",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "老大英明！！！",
            "nextDialogs": [
              "727300210"
            ]
          },
          "727300210": {
            "id": "727300210",
            "speakerId": 1001,
            "speakerName": "阿晃",
            "text": "可是，忍姐不知道什么时候才会回来，要举办这场「荒泷极意堂堂斗虫大试合」，从什么地方下手才好？",
            "nextDialogs": [
              "727300211"
            ]
          },
          "727300211": {
            "id": "727300211",
            "speakerId": 1001,
            "speakerName": "阿晃",
            "text": "根据「荒泷极上盛世豪鼓大祭典」的经验，我们需要提前向天领奉行报备，拿到活动举办许可…好像还有个场地租用凭证。",
            "nextDialogs": [
              "727300212"
            ]
          },
          "727300212": {
            "id": "727300212",
            "speakerId": 1001,
            "speakerName": "阿晃",
            "text": "这些好像都需要经费，考虑到要把「极意大试合」举办得比「豪鼓大祭典」更热闹，至少得花三倍的摩拉…",
            "nextDialogs": [
              "727300213"
            ]
          },
          "727300213": {
            "id": "727300213",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "停停停停停！一听到天领奉行这四个字，我就头疼得厉害！",
            "nextDialogs": [
              "727300214"
            ]
          },
          "727300214": {
            "id": "727300214",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "至于经费…大不了我们就别做一休三了！加把劲，做二休四！这样我们加起来多做了四天工，整整多赚四倍摩拉，肯定够了！",
            "nextDialogs": [
              "727300215"
            ]
          },
          "727300215": {
            "id": "727300215",
            "speakerId": 1001,
            "speakerName": "阿晃",
            "text": "不愧是老大！这样一来，我们只需要考虑参战的将士了！参战的将士也不用太强，能帮老大应付对方的杂兵就行！",
            "nextDialogs": [
              "727300216"
            ]
          },
          "727300216": {
            "id": "727300216",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "对哦！那小鬼说过，他还会带五个斗虫好手过来，和我们公正对决。问题是荒泷派里精通斗虫的，就只有老大你了…",
            "nextDialogs": [
              "727300217"
            ]
          },
          "727300217": {
            "id": "727300217",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "要是他们对老大发起车轮战，就算老大的实力再强，也会吃不消的！",
            "nextDialogs": [
              "727300218"
            ]
          },
          "727300218": {
            "id": "727300218",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "你们两个！明明还没开始准备，怎么就畏手畏脚了？",
            "nextDialogs": [
              "727300219"
            ]
          },
          "727300219": {
            "id": "727300219",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "拿出荒泷派的志气来！这点小问题，本大爷会想办法解决的！",
            "nextDialogs": [
              "727300220"
            ]
          },
          "727300220": {
            "id": "727300220",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "要不然，先去把以前斗虫的小友们找过来，商量一下？或者去长野原烟花店看看，问问她能不能参战…",
            "nextDialogs": [
              "727300221"
            ]
          },
          "727300221": {
            "id": "727300221",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "不成！那样的话，本大爷败给一个小鬼的事，很快就会传遍整个花见坂，谁丢得起那个脸！",
            "nextDialogs": [
              "727300222"
            ]
          },
          "727300222": {
            "id": "727300222",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嗯哼！放牛的，你又在搞什么名堂？",
            "nextDialogs": [
              "727300223"
            ]
          },
          "727300223": {
            "id": "727300223",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "喂！吓死本大爷了，你们什么时候来的！",
            "nextDialogs": [
              "727300224"
            ]
          },
          "727300224": {
            "id": "727300224",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "居然还好意思问我们，我们站在这里很久了哦。",
            "nextDialogs": [
              "727300225"
            ]
          },
          "727300225": {
            "id": "727300225",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "#我和{NICKNAME}本来想去冒险家协会，结果远远就看见你们在这里吵吵嚷嚷，说着一大堆不明所以的话…",
            "nextDialogs": [
              "727300228"
            ]
          },
          "727300228": {
            "id": "727300228",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "是「大」试合！少了一个大字，可就完全不够热血了！",
            "nextDialogs": [
              "727300229"
            ]
          },
          "727300229": {
            "id": "727300229",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "我的挚友啊，如果你也多多斗虫，一定能明白斗虫激动人心的地方！",
            "nextDialogs": [
              "727300230"
            ]
          },
          "727300230": {
            "id": "727300230",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "所以说，你是不是被什么人打败了，正琢磨着怎么挽回面子？",
            "nextDialogs": [
              "727300231"
            ]
          },
          "727300231": {
            "id": "727300231",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "话可不能这么说，那都是暗算，暗算！",
            "nextDialogs": [
              "727300232"
            ]
          },
          "727300232": {
            "id": "727300232",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "没错，有个叫「花角玉将」的小鬼，看准老大和其他小友切磋后的疲劳时期，突然加入对局，向老大发起了挑战。",
            "nextDialogs": [
              "727300233"
            ]
          },
          "727300233": {
            "id": "727300233",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "用一只大得夸张的鬼兜虫，哐哐两下就把老大的虫子挑翻了。",
            "nextDialogs": [
              "727300234"
            ]
          },
          "727300234": {
            "id": "727300234",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "还说什么，要让老大了解「斗虫强者的真实世界」…",
            "nextDialogs": [
              "727300235"
            ]
          },
          "727300235": {
            "id": "727300235",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "喂，阿守！不用把我战败的过程说得这么清楚！",
            "nextDialogs": [
              "727300236"
            ]
          },
          "727300236": {
            "id": "727300236",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好像明白了原委…",
            "nextDialogs": [
              "727300237"
            ]
          },
          "727300237": {
            "id": "727300237",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "言归正传，我好像听说过，我的挚友无论干什么都很有天赋，两三下就能学会一门新技艺，而且比大部分人还厉害…",
            "nextDialogs": [
              "727300238"
            ]
          },
          "727300238": {
            "id": "727300238",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "我已经猜到你要说什么了，放牛的！",
            "nextDialogs": [
              "727300239"
            ]
          },
          "727300239": {
            "id": "727300239",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "你是不是想拜托我们帮你报仇，打败那个什么「花角玉将」，让我们打白工了？",
            "nextDialogs": [
              "727300240"
            ]
          },
          "727300240": {
            "id": "727300240",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "打白工？飞行矮堇瓜，我荒泷一斗是那么不讲义气的人吗？",
            "nextDialogs": [
              "727300241"
            ]
          },
          "727300241": {
            "id": "727300241",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "要是我的挚友答应帮我，我就包下你们两个月的午饭，每天都请你们吃一碗招牌拉面，怎么样？",
            "nextDialogs": [
              "727300242"
            ]
          },
          "727300242": {
            "id": "727300242",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "每，每天一碗？那我们确实可以考虑考虑…"
          }
        }
      }
    },
    {
      "subId": "7273003",
      "subQuestName": "前往「斗虫大试合」的场地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7273004",
      "subQuestName": "与荒泷一斗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "727300401"
        ],
        "dialogs": {
          "727300401": {
            "id": "727300401",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "不错，阿守和阿晃准备的原材料都就位了，我们开始布置场地吧！",
            "nextDialogs": [
              "727300402"
            ]
          },
          "727300402": {
            "id": "727300402",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "根据以前的经验，试着搭建了「荒泷极意堂堂斗虫大试合」的擂台…",
            "nextDialogs": [
              "727300403"
            ]
          },
          "727300403": {
            "id": "727300403",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "哈哈哈哈哈哈哈！这擂台很有气势嘛，不错不错！",
            "nextDialogs": [
              "727300404"
            ]
          },
          "727300404": {
            "id": "727300404",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "我的挚友，没想到你在这方面也有才能！",
            "nextDialogs": [
              "727300405"
            ]
          },
          "727300405": {
            "id": "727300405",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "配合本大爷这精妙的宣传画，气氛不能更到位了，啊哈哈哈哈哈哈哈！",
            "nextDialogs": [
              "727300406"
            ]
          },
          "727300406": {
            "id": "727300406",
            "speakerId": 1001,
            "speakerName": "阿晃",
            "text": "#{NICKNAME}好木工！老大好画功！",
            "nextDialogs": [
              "727300407"
            ]
          },
          "727300407": {
            "id": "727300407",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "可是，这里好像离稻妻城太远了，真的会有人过来看吗？",
            "nextDialogs": [
              "727300408"
            ]
          },
          "727300408": {
            "id": "727300408",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "没问题没问题！以本大爷的名气，还怕没人来看吗？",
            "nextDialogs": [
              "727300409"
            ]
          },
          "727300409": {
            "id": "727300409",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "听说容彩祭的时候，这里就举办了一场剑术比试，当然也是鬼兜虫对决的不二之选！",
            "nextDialogs": [
              "727300410"
            ]
          },
          "727300410": {
            "id": "727300410",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "接下来，是时候给你们看看我天下无敌的鬼兜虫「赤红一杵」了。",
            "nextDialogs": [
              "727300411"
            ]
          },
          "727300411": {
            "id": "727300411",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "居然还真是红色的鬼兜虫，好威风！",
            "nextDialogs": [
              "727300414"
            ]
          },
          "727300414": {
            "id": "727300414",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "放牛的，没想到你还挺用功的，从哪找来了这么一只鬼兜虫啊？",
            "nextDialogs": [
              "727300415"
            ]
          },
          "727300415": {
            "id": "727300415",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "能让我凑近看看吗？",
            "nextDialogs": [
              "727300416"
            ]
          },
          "727300416": {
            "id": "727300416",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "哈！随便看随便看，仔细观瞻一番吧！不过，我可不会随随便便就把培养「赤红一杵」的秘密告诉你们！",
            "nextDialogs": [
              "727300417"
            ]
          },
          "727300417": {
            "id": "727300417",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嗯？怎么有股熟悉的香味，好像是落落莓的果酱？",
            "nextDialogs": [
              "727300418"
            ]
          },
          "727300418": {
            "id": "727300418",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "这！一定是你的错觉，你太饿了！",
            "nextDialogs": [
              "727300419"
            ]
          },
          "727300419": {
            "id": "727300419",
            "speakerId": 1000,
            "speakerName": "阿守",
            "text": "说起来，老大，你还没给「震慑涂装」加上保护涂层吧？要是下雨的话，我们花了九千摩拉才买到的那瓶舶来果酱，就都白费了…",
            "nextDialogs": [
              "727300420"
            ]
          },
          "727300420": {
            "id": "727300420",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "没问题！反正「荒泷极意堂堂斗虫大试合」还没开始，还有时间给「赤红一杵」涂上最后的保护层。",
            "nextDialogs": [
              "727300421"
            ]
          },
          "727300421": {
            "id": "727300421",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "你们先去准备传单，拉拢足够的观众。本大爷就在这里稍微指点一下挚友和飞行矮堇瓜，带他们上手。",
            "nextDialogs": [
              "727300422"
            ]
          },
          "727300422": {
            "id": "727300422",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "然后，我们就先一起吃个饭，庆祝一下吧。哎呀，做了这么多事，真是辛苦本大爷了，哈…",
            "nextDialogs": [
              "727300423"
            ]
          },
          "727300423": {
            "id": "727300423",
            "speakerId": 1005,
            "speakerName": "「花角玉将」",
            "text": "哦？没想到你们的阵仗还挺大？",
            "nextDialogs": [
              "727300424"
            ]
          },
          "727300424": {
            "id": "727300424",
            "speakerId": 1001,
            "speakerName": "阿晃",
            "text": "出现了！「花角玉将」！",
            "nextDialogs": [
              "727300425"
            ]
          },
          "727300425": {
            "id": "727300425",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "不应该啊！你是怎么知道这个地方的？",
            "nextDialogs": [
              "727300426"
            ]
          },
          "727300426": {
            "id": "727300426",
            "speakerId": 1005,
            "speakerName": "「花角玉将」",
            "text": "「真剑斗虫大鬼王」，你该不会忘了吧？斗虫的强者能够互相感应，上次不也是这样吗？",
            "nextDialogs": [
              "727300427"
            ]
          },
          "727300427": {
            "id": "727300427",
            "speakerId": 1005,
            "speakerName": "「花角玉将」",
            "text": "难道说，你还不知道该怎么面对我们，正在慌张地做准备？",
            "nextDialogs": [
              "727300428"
            ]
          },
          "727300428": {
            "id": "727300428",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "什，什么话！要知道…没有和鬼兜虫心意合一时，本大爷会隐藏强者的气息，尽量保持低调！",
            "nextDialogs": [
              "727300429"
            ]
          },
          "727300429": {
            "id": "727300429",
            "speakerId": 1002,
            "speakerName": "荒泷一斗",
            "text": "我只是小看了你的洞察力！",
            "nextDialogs": [
              "727300430"
            ]
          },
          "727300430": {
            "id": "727300430",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "哦？他就是打败过一斗的人吗？看起来的确只是个普通的小孩呢…",
            "nextDialogs": [
              "727300431"
            ]
          },
          "727300431": {
            "id": "727300431",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "但他说话的风格很特别，感觉…和放牛的天生就要对着干！"
          }
        }
      }
    },
    {
      "subId": "7273008",

  "subQuests": [
    {
      "subId": "1201901",
      "subQuestName": "(test)隐藏任务用于播放八重神子闲置对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120190101"
        ],
        "dialogs": {
          "120190101": {
            "id": "120190101",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "怎么了，还想聊点什么吗？",
            "nextDialogs": [
              "120190103",
              "120190106",
              "120190110"
            ]
          },
          "120190103": {
            "id": "120190103",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "她绝对特别喜欢那个饮料，心里估计都乐开花了。",
            "nextDialogs": [
              "120190104"
            ]
          },
          "120190104": {
            "id": "120190104",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "她的潜台词就是，「快，把这个铺子开到我的『一心净土』里去！」"
          },
          "120190106": {
            "id": "120190106",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "那个人偶是吧，修改人偶的规则很困难，这个我也听说过。",
            "nextDialogs": [
              "120190107"
            ]
          },
          "120190107": {
            "id": "120190107",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "这种困难可能是史无前例的，你们可以想象一下，能让神武英明的影也感到困难的事…",
            "nextDialogs": [
              "120190108"
            ]
          },
          "120190108": {
            "id": "120190108",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "「无想的一刀」也不能解决的事。"
          },
          "120190110": {
            "id": "120190110",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "转生成为雷电将军，不是很有趣的想法吗？轻小说只要有趣就够了。",
            "nextDialogs": [
              "120190111"
            ]
          },
          "120190111": {
            "id": "120190111",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "但对她来说，嗯，有点太前卫了吧。",
            "nextDialogs": [
              "120190112"
            ]
          },
          "120190112": {
            "id": "120190112",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "唔，下次要不要以「转生为八重宫司」为题材征稿呢？"
          }
        }
      }
    }
  ]
}
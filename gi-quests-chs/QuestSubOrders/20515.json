  "subQuests": [
    {
      "subId": "2051501",
      "subQuestName": "与安东尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205150101"
        ],
        "dialogs": {
          "205150101": {
            "id": "205150101",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "安娜又跑到哪去了…",
            "nextDialogs": [
              "205150102"
            ]
          },
          "205150102": {
            "id": "205150102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "又找不到安娜了？",
            "nextDialogs": [
              "205150103"
            ]
          },
          "205150103": {
            "id": "205150103",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "对啊，我都要把全城找遍了，就是找不到。",
            "nextDialogs": [
              "205150104"
            ]
          },
          "205150104": {
            "id": "205150104",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你也帮我找找吧，我已经累得走不动了…",
            "nextDialogs": [
              "205150106",
              "205150108"
            ]
          },
          "205150106": {
            "id": "205150106",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "那就拜托你了，这丫头，她的病是快好了，再这么折腾下去，我就要得病了…",
            "nextDialogs": [
              "205150111"
            ]
          },
          "205150111": {
            "id": "205150111",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "对了…之前安娜说，她一直想去教堂感谢修女们。",
            "nextDialogs": [
              "205150112"
            ]
          },
          "205150112": {
            "id": "205150112",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你不如先去教堂附近看看，还有，你可以去问问艾伯特先生…",
            "nextDialogs": [
              "205150113"
            ]
          },
          "205150113": {
            "id": "205150113",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "他是经常在教堂附近…呃，逗留的，说不定注意到了什么…"
          },
          "205150108": {
            "id": "205150108",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "不可能啦，不可能，怎么可能…",
            "nextDialogs": [
              "205150109"
            ]
          },
          "205150109": {
            "id": "205150109",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你，你怎么突然不说话了。"
          }
        }
      }
    },
    {
      "subId": "2051502",
      "subQuestName": "寻找安娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205150201"
        ],
        "dialogs": {
          "205150201": {
            "id": "205150201",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "哎呀，修女们可真警觉，差点就被发现了。",
            "nextDialogs": [
              "205150202"
            ]
          },
          "205150202": {
            "id": "205150202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的身手可真好…",
            "nextDialogs": [
              "205150203"
            ]
          },
          "205150203": {
            "id": "205150203",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "哇！你怎么知道我在这的，连修女们都没发现我。",
            "nextDialogs": [
              "205150204"
            ]
          },
          "205150204": {
            "id": "205150204",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "好啦，既然被你找到了，我马上就回去了。",
            "nextDialogs": [
              "205150205"
            ]
          },
          "205150205": {
            "id": "205150205",
            "speakerId": 1001,
            "speakerName": "安娜",
            "text": "我就是来这里看看风景而已啦，别担心我。"
          }
        }
      }
    },
    {
      "subId": "2051503",
      "subQuestName": "与安东尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205150301"
        ],
        "dialogs": {
          "205150301": {
            "id": "205150301",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你找到安娜了吗？",
            "nextDialogs": [
              "205150302"
            ]
          },
          "205150302": {
            "id": "205150302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她在教堂顶上。",
            "nextDialogs": [
              "205150303"
            ]
          },
          "205150303": {
            "id": "205150303",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "教堂顶上？那么多修女，全都没发现她吗？",
            "nextDialogs": [
              "205150304"
            ]
          },
          "205150304": {
            "id": "205150304",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "这孩子到底是怎么办到的，难道她还真有冒险家的天赋不成…",
            "nextDialogs": [
              "205150305"
            ]
          },
          "205150305": {
            "id": "205150305",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "我这就去把她叫下来，可不能打扰了修女们。",
            "nextDialogs": [
              "205150306"
            ]
          },
          "205150306": {
            "id": "205150306",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "辛苦你了，这些谢礼你就收下吧。"
          }
        }
      }
    },
    {
      "subId": "2051504",
      "subQuestName": "与艾伯特对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205150401"
        ],
        "dialogs": {
          "205150401": {
            "id": "205150401",
            "speakerId": 1002,
            "speakerName": "艾伯特",
            "text": "这孩子的身手可真好…",
            "nextDialogs": [
              "205150402"
            ]
          },
          "205150402": {
            "id": "205150402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问您见过一个女孩…",
            "nextDialogs": [
              "205150403"
            ]
          },
          "205150403": {
            "id": "205150403",
            "speakerId": 1002,
            "speakerName": "艾伯特",
            "text": "你是说安娜吧，见过，她刚从我面前跑过，转了个弯就不见了。",
            "nextDialogs": [
              "205150404"
            ]
          },
          "205150404": {
            "id": "205150404",
            "speakerId": 1002,
            "speakerName": "艾伯特",
            "text": "不过，我记得安娜不是一直在生病吗，偶尔还会到教堂来接受治疗。",
            "nextDialogs": [
              "205150405"
            ]
          },
          "205150405": {
            "id": "205150405",
            "speakerId": 1002,
            "speakerName": "艾伯特",
            "text": "但是她这幅样子，哪里像是生病的，简直比我还有活力。到底发生了什么…"
          }
        }
      }
    },

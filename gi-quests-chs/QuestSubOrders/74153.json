  "subQuests": [
    {
      "subId": "7415309",
      "subQuestName": "(test)时间经过$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530901"
        ],
        "dialogs": {
          "741530901": {
            "id": "741530901",
            "speakerId": 1000,
            "speakerName": "门",
            "text": "（已经决定自行调查勒鲁瓦家的奇怪状况了，现在敲门似乎会打草惊蛇。）",
            "nextDialogs": [
              "741530902"
            ]
          },
          "741530902": {
            "id": "741530902",
            "speakerId": 1000,
            "speakerName": "门",
            "text": "（等到掌握更多信息后再来敲门吧。）"
          }
        }
      }
    },
    {
      "subId": "7415301",
      "subQuestName": "前往伯努瓦家附近调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530101"
        ],
        "dialogs": {
          "741530101": {
            "id": "741530101",
            "speakerId": 21258,
            "speakerName": "皮普",
            "text": "有没有人啊，报纸不要了吗？喂，应下门啊。",
            "nextDialogs": [
              "741530102"
            ]
          },
          "741530102": {
            "id": "741530102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好。",
            "nextDialogs": [
              "741530103"
            ]
          },
          "741530103": {
            "id": "741530103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "伯努瓦不在家吗？",
            "nextDialogs": [
              "741530104"
            ]
          },
          "741530104": {
            "id": "741530104",
            "speakerId": 21258,
            "speakerName": "皮普",
            "text": "我哪儿知道，怪得很，自己订的报纸自己不来拿。",
            "nextDialogs": [
              "741530105"
            ]
          },
          "741530105": {
            "id": "741530105",
            "speakerId": 21258,
            "speakerName": "皮普",
            "text": "以前我送报到门口，勒鲁瓦先生至少会应一声，最近完全看不到他人。",
            "nextDialogs": [
              "741530106"
            ]
          },
          "741530106": {
            "id": "741530106",
            "speakerId": 21258,
            "speakerName": "皮普",
            "text": "我这儿已经堆了好几份他订的蒸汽鸟报了，你们认识他是吧？",
            "nextDialogs": [
              "741530107"
            ]
          },
          "741530107": {
            "id": "741530107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对，对，我们是伯努瓦的好朋友。",
            "nextDialogs": [
              "741530108"
            ]
          },
          "741530108": {
            "id": "741530108",
            "speakerId": 21258,
            "speakerName": "皮普",
            "text": "好朋友？…行吧，要不我把报纸交给你们，你们见到他的时候帮我转交？",
            "nextDialogs": [
              "741530111"
            ]
          },
          "741530111": {
            "id": "741530111",
            "speakerId": 21258,
            "speakerName": "皮普",
            "text": "我也算尽力了，别回头怪我没送报纸上门，我还有其他事要忙呢。",
            "nextDialogs": [
              "741530112"
            ]
          },
          "741530112": {
            "id": "741530112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但最近我们也几乎见不到他本人…",
            "nextDialogs": [
              "741530113"
            ]
          },
          "741530113": {
            "id": "741530113",
            "speakerId": 21258,
            "speakerName": "皮普",
            "text": "你们也找不到他？勒鲁瓦先生到底在忙些什么啊，难道回老房子住去了？没听说啊…",
            "nextDialogs": [
              "741530114"
            ]
          },
          "741530114": {
            "id": "741530114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "老房子？",
            "nextDialogs": [
              "741530115"
            ]
          },
          "741530115": {
            "id": "741530115",
            "speakerId": 21258,
            "speakerName": "皮普",
            "text": "对啊，他在灰河的老房子。",
            "nextDialogs": [
              "741530116"
            ]
          },
          "741530116": {
            "id": "741530116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "伯努瓦以前是住在灰河的啊！",
            "nextDialogs": [
              "741530117"
            ]
          },
          "741530117": {
            "id": "741530117",
            "speakerId": 21258,
            "speakerName": "皮普",
            "text": "他是从灰河搬上来的你们都不知道，你们真是他的朋友吗？",
            "nextDialogs": [
              "741530118"
            ]
          },
          "741530118": {
            "id": "741530118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…我们…",
            "nextDialogs": [
              "741530119"
            ]
          },
          "741530119": {
            "id": "741530119",
            "speakerId": 21258,
            "speakerName": "皮普",
            "text": "行了行了，不用解释，你们跟他怎么回事我一点都不关心。",
            "nextDialogs": [
              "741530120"
            ]
          },
          "741530120": {
            "id": "741530120",
            "speakerId": 21258,
            "speakerName": "皮普",
            "text": "只要把报纸送到我就谢谢你们了，好了，你们拿着吧，我走了。",
            "nextDialogs": [
              "741530121"
            ]
          },
          "741530121": {
            "id": "741530121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉伯努瓦身上还有很多我们完全不了解的事，你觉得这会和我们要调查的事情有关吗？"
          }
        }
      }
    },

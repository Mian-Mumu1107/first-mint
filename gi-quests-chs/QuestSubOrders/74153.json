    {
      "subId": "7415303",
      "subQuestName": "(test)脏箱子$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530301"
        ],
        "dialogs": {
          "741530301": {
            "id": "741530301",
            "speakerId": 21255,
            "speakerName": "奇怪的箱子",
            "text": "（曾在伯努瓦家附近见过的箱子，从箱子上灰尘的痕迹来看，它们最近似乎被开启过。）",
            "nextDialogs": [
              "741530302"
            ]
          },
          "741530302": {
            "id": "741530302",
            "speakerId": 21255,
            "speakerName": "奇怪的箱子",
            "text": "（走近后你能嗅到鱼腥味和水腥气，但这些天你路过时，箱子完全没有被挪动过。这气味是哪里来的？）",
            "nextDialogs": [
              "741530303"
            ]
          },
          "741530303": {
            "id": "741530303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这股臭水沟一样的味道…呕…前几天过来的时候，明明没有这股气味，伯努瓦不是说这里只装了旧家具吗？",
            "nextDialogs": [
              "741530304"
            ]
          },
          "741530304": {
            "id": "741530304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么会有这么难闻的气味，这里面又新装了些什么东西啊…欸，箱子开口露出来一张纸，让我看看。",
            "nextDialogs": [
              "741530305"
            ]
          },
          "741530305": {
            "id": "741530305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这张收据被撕坏了，只有一半。唔，布莱卡利杂货店…这名字好像在哪里看过，总觉得有点熟悉。"
          }
        }
      }
    },
    {
      "subId": "7415304",
      "subQuestName": "(test)奇怪的痕迹$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530401"
        ],
        "dialogs": {
          "741530401": {
            "id": "741530401",
            "speakerId": 21256,
            "speakerName": "奇怪的痕迹",
            "text": "（抚摸起来有种光滑油润的触感，你确定这是蜡烛留下的痕迹。）",
            "nextDialogs": [
              "741530402"
            ]
          },
          "741530402": {
            "id": "741530402",
            "speakerId": 21256,
            "speakerName": "奇怪的痕迹",
            "text": "（有谁持蜡烛在箱子附近逗留过，又是为了什么？）"
          }
        }
      }
    },
    {
      "subId": "7415312",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741531201"
        ],
        "dialogs": {
          "741531201": {
            "id": "741531201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于你们发现的收据…",
            "nextDialogs": [
              "741531202"
            ]
          },
          "741531202": {
            "id": "741531202",
            "speakerId": 5067,
            "speakerName": "布莱卡利",
            "text": "最近卖出去的钳子、锯子、还有蜡烛？哎哟，真是奇怪的问题。",
            "nextDialogs": [
              "741531203"
            ]
          },
          "741531203": {
            "id": "741531203",
            "speakerId": 5067,
            "speakerName": "布莱卡利",
            "text": "你要买点心调料我有的是，需要这种东西我可难办了，货不多。",
            "nextDialogs": [
              "741531204"
            ]
          },
          "741531204": {
            "id": "741531204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不是我们想要买这些，奶奶，我们是想问这几天有没有人来找你买过这些东西。",
            "nextDialogs": [
              "741531205"
            ]
          },
          "741531205": {
            "id": "741531205",
            "speakerId": 5067,
            "speakerName": "布莱卡利",
            "text": "我想想，嗯…还真有。",
            "nextDialogs": [
              "741531206"
            ]
          },
          "741531206": {
            "id": "741531206",
            "speakerId": 5067,
            "speakerName": "布莱卡利",
            "text": "前些天正好有两个年轻人，一男一女，到我这儿买了这些东西。",
            "nextDialogs": [
              "741531207"
            ]
          },
          "741531207": {
            "id": "741531207",
            "speakerId": 5067,
            "speakerName": "布莱卡利",
            "text": "说是家里要做木工活，缺点工具，怎么了吗？",
            "nextDialogs": [
              "741531208"
            ]
          },
          "741531208": {
            "id": "741531208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没事没事，我、我们在做社会经济情况调研。",
            "nextDialogs": [
              "741531209"
            ]
          },
          "741531209": {
            "id": "741531209",
            "speakerId": 5067,
            "speakerName": "布莱卡利",
            "text": "社会经济情况调研？呵呵，你们是来打听人的吧。",
            "nextDialogs": [
              "741531210"
            ]
          },
          "741531210": {
            "id": "741531210",
            "speakerId": 5067,
            "speakerName": "布莱卡利",
            "text": "这种事我见得多了，小家伙，你也不用费劲想借口了。",
            "nextDialogs": [
              "741531211"
            ]
          },
          "741531211": {
            "id": "741531211",
            "speakerId": 5067,
            "speakerName": "布莱卡利",
            "text": "他们两个去了伯努瓦的老房子，如果你们想知道的是这件事的话。",
            "nextDialogs": [
              "741531212"
            ]
          },
          "741531212": {
            "id": "741531212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于伯努瓦·勒鲁瓦…",
            "nextDialogs": [
              "741531213"
            ]
          },
          "741531213": {
            "id": "741531213",
            "speakerId": 5067,
            "speakerName": "布莱卡利",
            "text": "原来你们是冲着伯努瓦来的，不意外。",
            "nextDialogs": [
              "741531214"
            ]
          },
          "741531214": {
            "id": "741531214",
            "speakerId": 5067,
            "speakerName": "布莱卡利",
            "text": "人到了一定年纪，过去就会找上门来，不管搬到哪里都一样。",
            "nextDialogs": [
              "741531215"
            ]
          },
          "741531215": {
            "id": "741531215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奶奶你知道些什么吗？",
            "nextDialogs": [
              "741531216"
            ]
          },
          "741531216": {
            "id": "741531216",
            "speakerId": 5067,
            "speakerName": "布莱卡利",
            "text": "我？我和伯努瓦不熟，如果你们想打听伯努瓦家的事，应该找史诺德格拉斯问。",
            "nextDialogs": [
              "741531217"
            ]
          },
          "741531217": {
            "id": "741531217",
            "speakerId": 5067,
            "speakerName": "布莱卡利",
            "text": "去吧，史诺德格拉斯这家伙游手好闲的，这会儿应该就在这附近闲逛。"
          }
        }
      }
    },
    {
      "subId": "7415310",
      "subQuestName": "(test)回滚隔离$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741531001"
        ],
        "dialogs": {
          "741531001": {
            "id": "741531001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于伯努瓦·勒鲁瓦…",
            "nextDialogs": [
              "741531002"
            ]
          },
          "741531002": {
            "id": "741531002",
            "speakerId": 17172,
            "speakerName": "阿蕾妲",
            "text": "的确是听说过这个名字，不过他很久之前就搬走了，而且我们也很少打交道。",
            "nextDialogs": [
              "741531003"
            ]
          },
          "741531003": {
            "id": "741531003",
            "speakerId": 17172,
            "speakerName": "阿蕾妲",
            "text": "我不太熟悉这个人，你找别人问问看？"
          }
        }
      }
    },
    {
      "subId": "7415305",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530501"
        ],
        "dialogs": {
          "741530501": {
            "id": "741530501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个箱子怎么看都不像是该在这里出现的东西，而且好臭…",
            "nextDialogs": [
              "741530502"
            ]
          },
          "741530502": {
            "id": "741530502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "恐怕是灰河来的东西。",
            "nextDialogs": [
              "741530503"
            ]
          },
          "741530503": {
            "id": "741530503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也就是说，最近伯努瓦家有人去过灰河，而且伯努瓦又曾经住在灰河…",
            "nextDialogs": [
              "741530504"
            ]
          },
          "741530504": {
            "id": "741530504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#所有的线索都和灰河有关，{NICKNAME}，我们要不要去灰河看看，应该能了解更多有用的信息。",
            "nextDialogs": [
              "741530505"
            ]
          },
          "741530505": {
            "id": "741530505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "走吧。",
            "nextDialogs": [
              "741530506"
            ]
          },
          "741530506": {
            "id": "741530506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们去灰河！"
          }
        }
      }
    },

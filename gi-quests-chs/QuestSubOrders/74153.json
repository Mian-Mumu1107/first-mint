        ],
        "dialogs": {
          "741531101": {
            "id": "741531101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于伯努瓦·勒鲁瓦…",
            "nextDialogs": [
              "741531102"
            ]
          },
          "741531102": {
            "id": "741531102",
            "speakerId": 5065,
            "speakerName": "法斯捷",
            "text": "听说过，不熟。"
          }
        }
      }
    },
    {
      "subId": "7415307",
      "subQuestName": "询问路人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530701"
        ],
        "dialogs": {
          "741530701": {
            "id": "741530701",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "啊，好无聊啊…不想工作…我什么时候能暴富…",
            "nextDialogs": [
              "741530702"
            ]
          },
          "741530702": {
            "id": "741530702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于伯努瓦·勒鲁瓦…",
            "nextDialogs": [
              "741530703"
            ]
          },
          "741530703": {
            "id": "741530703",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "…勒鲁瓦？这名字似乎在哪儿听过，让我想想…",
            "nextDialogs": [
              "741530704"
            ]
          },
          "741530704": {
            "id": "741530704",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "哦，我想起来了，伯努瓦·勒鲁瓦，杂货摊的摊主大叔。",
            "nextDialogs": [
              "741530705"
            ]
          },
          "741530705": {
            "id": "741530705",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "怎么了？你们是谁？打听这个做什么？",
            "nextDialogs": [
              "741530706"
            ]
          },
          "741530706": {
            "id": "741530706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实我们只是…",
            "nextDialogs": [
              "741530709"
            ]
          },
          "741530709": {
            "id": "741530709",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "啊，这…难道…他是不是犯什么事了？",
            "nextDialogs": [
              "741530710"
            ]
          },
          "741530710": {
            "id": "741530710",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "741530711"
            ]
          },
          "741530711": {
            "id": "741530711",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "懂了懂了…但我还是忍不住想多问一句，你们是刺玫会来的还是执律庭来的？",
            "nextDialogs": [
              "741530712"
            ]
          },
          "741530712": {
            "id": "741530712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你有权保持沉默…",
            "nextDialogs": [
              "741530713"
            ]
          },
          "741530713": {
            "id": "741530713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的每句话将作为呈堂证供…",
            "nextDialogs": [
              "741530714"
            ]
          },
          "741530714": {
            "id": "741530714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#（{NICKNAME}也太会演了，不愧是你。）",
            "nextDialogs": [
              "741530715"
            ]
          },
          "741530715": {
            "id": "741530715",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "好好好，明白了，我不问了。他发财的手段又不光彩，枫丹法条那么多，他肯定违反其中某一条了！",
            "nextDialogs": [
              "741530716"
            ]
          },
          "741530716": {
            "id": "741530716",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "长官，你们找对了人。我告诉你们，这家人我再熟不过了，伯努瓦这个坏东西烂事没少干。",
            "nextDialogs": [
              "741530717"
            ]
          },
          "741530717": {
            "id": "741530717",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "哦，我都到了结婚成家的年纪，他应该已经老了吧。",
            "nextDialogs": [
              "741530718"
            ]
          },
          "741530718": {
            "id": "741530718",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "我记得他的女儿小秋很漂亮，嘿嘿，可惜他从来不让我们跟小秋说话。",
            "nextDialogs": [
              "741530719"
            ]
          },
          "741530719": {
            "id": "741530719",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "小秋？",
            "nextDialogs": [
              "741530720"
            ]
          },
          "741530720": {
            "id": "741530720",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "没错，秋·勒鲁瓦，伯努瓦·勒鲁瓦的养女。",
            "nextDialogs": [
              "741530721"
            ]
          },
          "741530721": {
            "id": "741530721",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "你仔细想一想，他本来只是一个卖杂货的，赚点小钱而已，怎么可能突然暴富，搬到上面住？",
            "nextDialogs": [
              "741530722"
            ]
          },
          "741530722": {
            "id": "741530722",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "还不是靠他的女儿小秋，那么漂亮的年轻女孩，他硬是让她嫁给了一个有钱的老头。",
            "nextDialogs": [
              "741530723"
            ]
          },
          "741530723": {
            "id": "741530723",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "才几年老头就死啦，老头的房子当然就归小秋了，小秋的就是他的，这下他不就一口气成为「上面人」了吗？",
            "nextDialogs": [
              "741530724"
            ]
          },
          "741530724": {
            "id": "741530724",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "啧啧，这种一夜暴富的好事怎么就落在他头上了，啊呸，我是说这个老东西吸自己女儿的血，太坏了！",
            "nextDialogs": [
              "741530725"
            ]
          },
          "741530725": {
            "id": "741530725",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（怎么还有这种事情？）",
            "nextDialogs": [
              "741530726"
            ]
          },
          "741530726": {
            "id": "741530726",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（我们继续问他。）",
            "nextDialogs": [
              "741530727"
            ]
          },
          "741530727": {
            "id": "741530727",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "长官，你们就是来打探这些事的吗？",
            "nextDialogs": [
              "741530728"
            ]
          },
          "741530728": {
            "id": "741530728",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "我是说，要是这些破事对你们有用的话，我是不是也为枫丹的社会安全做出了贡献？",
            "nextDialogs": [
              "741530729"
            ]
          },
          "741530729": {
            "id": "741530729",
            "speakerId": 21259,
            "speakerName": "史诺德格拉斯",
            "text": "作为一个对社会有贡献的市民，执律庭会不会有嘉奖我的打算？"
          }
        }
      }
    },
    {
      "subId": "7415308",
      "subQuestName": "离开灰河",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741530801"
        ],
        "dialogs": {
          "741530801": {
            "id": "741530801",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "灰河这一带的味道不太好闻，不像「上面」，连空气里都有一股香水味。",
            "nextDialogs": [
              "741530802"
            ]
          },
          "741530802": {
            "id": "741530802",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "怎么样？在灰河逛得开心吗？相信你们跟史诺德格拉斯聊得很愉快。",
            "nextDialogs": [
              "741530803"
            ]
          },
          "741530803": {
            "id": "741530803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你、你跟踪我们？",
            "nextDialogs": [
              "741530804"
            ]
          },
          "741530804": {
            "id": "741530804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么时候？",
            "nextDialogs": [
              "741530805"
            ]
          },
          "741530805": {
            "id": "741530805",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "我没有闲心思跟多管闲事的孩子斗嘴。唉，就算让你们回家找父母去，你们应该也不会听。",
            "nextDialogs": [
              "741530806"
            ]
          },
          "741530806": {
            "id": "741530806",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "听我说，有时候眼睛看到的和耳朵听到的未必就是真的、对的。",
            "nextDialogs": [
              "741530807"
            ]
          },
          "741530807": {
            "id": "741530807",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "别人家的事情，你还没弄明白之前不要总想着乱掺和。",
            "nextDialogs": [
              "741530808"
            ]
          },
          "741530808": {
            "id": "741530808",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "对了，皮普说这段时间我家里订的报纸都在你们手上，请还给我们吧。",
            "nextDialogs": [
              "741530809"
            ]
          },
          "741530809": {
            "id": "741530809",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "你不得不将报纸交还给了阿托斯。",
            "nextDialogs": [
              "741530810"
            ]
          },
          "741530810": {
            "id": "741530810",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "他冷冷地看了你们一眼，转身离去。",
            "nextDialogs": [
              "741530811"
            ]
          },
          "741530811": {
            "id": "741530811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个家伙给我的感觉好不舒服…",
            "nextDialogs": [
              "741530814"
            ]
          },
          "741530814": {
            "id": "741530814",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，好讨厌，虽然发现了点什么，但完全串不起来。",
            "nextDialogs": [
              "741530815"
            ]
          },
          "741530815": {
            "id": "741530815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且…而且我感觉有点混乱，伯努瓦是正受到威胁的好人，我们应该帮助他，是这样没错吧？"
          }
        }
      }
    },
    {
      "subId": "7415104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741510401"
        ],
        "dialogs": {
          "741510401": {
            "id": "741510401",
            "speakerId": 1000,
            "speakerName": "门",
            "text": "屋内静悄悄的没有声响，无人说话，也没有脚步声。",
            "nextDialogs": [
              "741510402"
            ]
          },
          "741510402": {
            "id": "741510402",
            "speakerId": 1000,
            "speakerName": "门",
            "text": "伯努瓦一家安静得有些异常，这几乎像是所空房子。"
          }
        }
      }
    },
    {
      "subId": "7415399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741539901"
        ],
        "dialogs": {
          "741539901": {
            "id": "741539901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们只知道伯努瓦曾经在灰河居住过，连他住在哪间屋子都不知道…",
            "nextDialogs": [
              "741539902"
            ]
          },
          "741539902": {
            "id": "741539902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是有什么线索能帮我们缩小范围就好了…"
          }
        }
      }
    }
  ]
}
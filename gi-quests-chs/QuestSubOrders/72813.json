      }
    },
    {
      "subId": "7281309",
      "subQuestName": "与考什克一起去向五郎回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728130801"
        ],
        "dialogs": {
          "728130801": {
            "id": "728130801",
            "speakerId": 1006,
            "speakerName": "考什克",
            "text": "爱拉尼，真的是你，你、你怎么来稻妻了？你不是应该在璃月吗？",
            "nextDialogs": [
              "728130802"
            ]
          },
          "728130802": {
            "id": "728130802",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "呜…这个说起来就没完了…",
            "nextDialogs": [
              "728130803"
            ]
          },
          "728130803": {
            "id": "728130803",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "考什克先生，你认识爱拉尼吗？",
            "nextDialogs": [
              "728130804"
            ]
          },
          "728130804": {
            "id": "728130804",
            "speakerId": 1006,
            "speakerName": "考什克",
            "text": "您是…噢，您是五郎大将吧。",
            "nextDialogs": [
              "728130805"
            ]
          },
          "728130805": {
            "id": "728130805",
            "speakerId": 1006,
            "speakerName": "考什克",
            "text": "您说得没错，爱拉尼和我一样，都是在教令院求学的学者。",
            "nextDialogs": [
              "728130806"
            ]
          },
          "728130806": {
            "id": "728130806",
            "speakerId": 1006,
            "speakerName": "考什克",
            "text": "我们各自为了不同的课题离开了教令院。没想到会在这里遇见她…",
            "nextDialogs": [
              "728130807"
            ]
          },
          "728130807": {
            "id": "728130807",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "但是…你们学者，都可以自由离开教令院吗？",
            "nextDialogs": [
              "728130808"
            ]
          },
          "728130808": {
            "id": "728130808",
            "speakerId": 1006,
            "speakerName": "考什克",
            "text": "也不能说都能「自由离开」。我和爱拉尼都属于「帝利耶悉」。",
            "nextDialogs": [
              "728130809"
            ]
          },
          "728130809": {
            "id": "728130809",
            "speakerId": 1006,
            "speakerName": "考什克",
            "text": "对我们来说，在外游学是研究的一部分，所以离开教令院是被允许的行为。",
            "nextDialogs": [
              "728130810"
            ]
          },
          "728130810": {
            "id": "728130810",
            "speakerId": 1006,
            "speakerName": "考什克",
            "text": "五郎大将，我可以为爱拉尼做担保，你看…",
            "nextDialogs": [
              "728130811"
            ]
          },
          "728130811": {
            "id": "728130811",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "有了您做担保，那就没问题了。",
            "nextDialogs": [
              "728130812"
            ]
          },
          "728130812": {
            "id": "728130812",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "呼…得救了…谢谢你们…",
            "nextDialogs": [
              "728130813"
            ]
          },
          "728130813": {
            "id": "728130813",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "博行，大久保，你们也去忙自己的吧，这里没事了。",
            "nextDialogs": [
              "728130814"
            ]
          },
          "728130814": {
            "id": "728130814",
            "speakerId": 1004,
            "speakerName": "博行",
            "text": "是，大将。",
            "nextDialogs": [
              "728130815"
            ]
          },
          "728130815": {
            "id": "728130815",
            "speakerId": 1003,
            "speakerName": "大久保大介",
            "text": "是，大将。",
            "nextDialogs": [
              "728130816"
            ]
          },
          "728130816": {
            "id": "728130816",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "抱歉了，爱拉尼小姐，之前把你当做可疑人士了。",
            "nextDialogs": [
              "728130817"
            ]
          },
          "728130817": {
            "id": "728130817",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "嗯…虽然你的嫌疑已经洗清了，但是你擅自闯入海祇岛，给我们也添了很多麻烦。",
            "nextDialogs": [
              "728130818"
            ]
          },
          "728130818": {
            "id": "728130818",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "欸？有、有什么惩罚吗？我可没有带多少摩拉，呜…",
            "nextDialogs": [
              "728130819"
            ]
          },
          "728130819": {
            "id": "728130819",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "既然你之前说，你是一个肥料推销员…而且，还是一个有学者身份的肥料推销员。",
            "nextDialogs": [
              "728130820"
            ]
          },
          "728130820": {
            "id": "728130820",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "那正好，我们这边有一个叫做岩田的人，正在研究肥料的事，爱拉尼小姐，请你去协助他一下吧。",
            "nextDialogs": [
              "728130821"
            ]
          },
          "728130821": {
            "id": "728130821",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "假如你能帮助他制作出不那么「扰民」的肥料，那你就可以像考什克先生一样，在这附近自由研究了。",
            "nextDialogs": [
              "728130822"
            ]
          },
          "728130822": {
            "id": "728130822",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "肥、肥料？不，那个，我只是…",
            "nextDialogs": [
              "728130825"
            ]
          },
          "728130825": {
            "id": "728130825",
            "speakerId": 1006,
            "speakerName": "考什克",
            "text": "爱拉尼，这可是个取材的好机会，你既然来了稻妻，那就证明，你的论文应该还…",
            "nextDialogs": [
              "728130826"
            ]
          },
          "728130826": {
            "id": "728130826",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "唔…唔…",
            "nextDialogs": [
              "728130827"
            ]
          },
          "728130827": {
            "id": "728130827",
            "speakerId": 1006,
            "speakerName": "考什克",
            "text": "教令院的毕业准则你也知道，要是连续几年都没法毕业的话…",
            "nextDialogs": [
              "728130828"
            ]
          },
          "728130828": {
            "id": "728130828",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "我、我做！我做就是了！",
            "nextDialogs": [
              "728130829"
            ]
          },
          "728130829": {
            "id": "728130829",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "我也在瓦希德先生那边了解过肥料了…看我一口气搞定它！"
          }
        }
      }
    },
    {
      "subId": "7281310",
      "subQuestName": "和爱拉尼一起去找岩田",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728130901"
        ],
        "dialogs": {
          "728130901": {
            "id": "728130901",
            "speakerId": 1000,
            "speakerName": "岩田",
            "text": "你回来了，旅行者，我已经把那个肥料堆处理掉了。",
            "nextDialogs": [
              "728130902"
            ]
          },
          "728130902": {
            "id": "728130902",
            "speakerId": 1000,
            "speakerName": "岩田",
            "text": "唉，我得再找个地方实验了…",
            "nextDialogs": [
              "728130903"
            ]
          },
          "728130903": {
            "id": "728130903",
            "speakerId": 1000,
            "speakerName": "岩田",
            "text": "咦？这位是…",
            "nextDialogs": [
              "728130905",
              "728130907"
            ]
          },
          "728130905": {
            "id": "728130905",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "你好，我叫爱拉尼…",
            "nextDialogs": [
              "728130909"
            ]
          },
          "728130909": {
            "id": "728130909",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "那个…总之，那位五郎「大将」让我来协助你进行肥料的研究工作…",
            "nextDialogs": [
              "728130910"
            ]
          },
          "728130910": {
            "id": "728130910",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "之后，我们就好好合作吧。",
            "nextDialogs": [
              "728130911"
            ]
          },
          "728130911": {
            "id": "728130911",
            "speakerId": 1000,
            "speakerName": "岩田",
            "text": "是吗…太好了！要是真能成功把肥料制作出来，那海祇岛上就能种更多的作物了！",
            "nextDialogs": [
              "728130912"
            ]
          },
          "728130912": {
            "id": "728130912",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "记得把肥料堆放远点。",
            "nextDialogs": [
              "728130913"
            ]
          },
          "728130913": {
            "id": "728130913",
            "speakerId": 1000,
            "speakerName": "岩田",
            "text": "啊？哦…哦，我知道了。",
            "nextDialogs": [
              "728130914"
            ]
          },
          "728130914": {
            "id": "728130914",
            "speakerId": 1000,
            "speakerName": "岩田",
            "text": "总之，我们就好好合作吧！请多多指教了，爱拉尼小姐！",
            "nextDialogs": [
              "728130915"
            ]
          },
          "728130915": {
            "id": "728130915",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "好的，我一定会努力的…",
            "nextDialogs": [
              "728130916"
            ]
          },
          "728130916": {
            "id": "728130916",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "为了我的论文，我一定会努力的，呜…"
          },
          "728130907": {
            "id": "728130907",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "你好，我叫爱拉尼…等一下，谁是肥料专家啊！",
            "nextDialogs": [
              "728130908"
            ]
          },
          "728130908": {
            "id": "728130908",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "我就是…略微了解一些。"
          }
        }
      }
    },
    {
      "subId": "7281306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728130601"
        ],
        "dialogs": {
          "728130601": {
            "id": "728130601",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "呜…我就是想写一篇论文，怎么又被关起来了…"
          }
        }
      }
    },
    {
      "subId": "7281310",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728131001"
        ],
        "dialogs": {
          "728131001": {
            "id": "728131001",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "快去把考什克带回来吧，请快去快回。"
          }
        }
      }
    },
    {
      "subId": "7281311",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728131101"
        ],
        "dialogs": {
          "728131101": {
            "id": "728131101",
            "speakerId": 1003,
            "speakerName": "大久保大介",
            "text": "这家伙，无论怎么看都不像个学者。"
          }
        }
      }
    },
    {
      "subId": "7281312",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

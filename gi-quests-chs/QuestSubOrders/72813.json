    {
      "subId": "7281306",
      "subQuestName": "与五郎一起去查看可疑人士",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728130501"
        ],
        "dialogs": {
          "728130501": {
            "id": "728130501",
            "speakerId": 1004,
            "speakerName": "博行",
            "text": "老实点！别乱动！",
            "nextDialogs": [
              "728130502"
            ]
          },
          "728130502": {
            "id": "728130502",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "我、我也没动啊！你们听我解释，我真的是教令院的学者！",
            "nextDialogs": [
              "728130503"
            ]
          },
          "728130503": {
            "id": "728130503",
            "speakerId": 1004,
            "speakerName": "博行",
            "text": "你刚才不是说，你只是来推销肥料的吗？",
            "nextDialogs": [
              "728130504"
            ]
          },
          "728130504": {
            "id": "728130504",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "我…教令院的学者也可以推销肥料啊！你们听我解释…",
            "nextDialogs": [
              "728130505"
            ]
          },
          "728130505": {
            "id": "728130505",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "就是这个人吗？",
            "nextDialogs": [
              "728130506"
            ]
          },
          "728130506": {
            "id": "728130506",
            "speakerId": 1003,
            "speakerName": "大久保大介",
            "text": "是，大将。",
            "nextDialogs": [
              "728130507"
            ]
          },
          "728130507": {
            "id": "728130507",
            "speakerId": 1003,
            "speakerName": "大久保大介",
            "text": "我们抓到她的时候，她正在外面鬼鬼祟祟地游荡，还不停地记着什么东西。",
            "nextDialogs": [
              "728130508"
            ]
          },
          "728130508": {
            "id": "728130508",
            "speakerId": 1003,
            "speakerName": "大久保大介",
            "text": "大将，她肯定是幕府那边派来刺探情报的人！",
            "nextDialogs": [
              "728130509"
            ]
          },
          "728130509": {
            "id": "728130509",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "我不是！我没有！都说了我是个学者，正在为论文取材啊！",
            "nextDialogs": [
              "728130510"
            ]
          },
          "728130510": {
            "id": "728130510",
            "speakerId": 1004,
            "speakerName": "博行",
            "text": "别开玩笑了！为了那个什么论文，你连战场都敢来吗？肯定是有什么其他的目的！",
            "nextDialogs": [
              "728130511"
            ]
          },
          "728130511": {
            "id": "728130511",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "呜…除了论文之外，我怎么敢还想着其他的目的…",
            "nextDialogs": [
              "728130514"
            ]
          },
          "728130514": {
            "id": "728130514",
            "speakerId": 1005,
            "speakerName": "爱拉尼",
            "text": "旅行者！太好了，你在这，你快和他们说说，我不是坏人，我只是来写论文的！",
            "nextDialogs": [
              "728130515"
            ]
          },
          "728130515": {
            "id": "728130515",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "你认识她？",
            "nextDialogs": [
              "728130516"
            ]
          },
          "728130516": {
            "id": "728130516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "算是吧…",
            "nextDialogs": [
              "728130517"
            ]
          },
          "728130517": {
            "id": "728130517",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "须弥的学者…居然能为了「毕业」这件事，做到那种地步吗…",
            "nextDialogs": [
              "728130518"
            ]
          },
          "728130518": {
            "id": "728130518",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "不过，听你的说法，你似乎也不知道她的底细。",
            "nextDialogs": [
              "728130519"
            ]
          },
          "728130519": {
            "id": "728130519",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "至于「从须弥来的学者」这件事，你也只是从她嘴里听说的，对吧？",
            "nextDialogs": [
              "728130520"
            ]
          },
          "728130520": {
            "id": "728130520",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是的。",
            "nextDialogs": [
              "728130521"
            ]
          },
          "728130521": {
            "id": "728130521",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "唔…这些证据，实在都是缺乏可信度。",
            "nextDialogs": [
              "728130522"
            ]
          },
          "728130522": {
            "id": "728130522",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "但有你担保，我也愿意相信，她应该不是个坏人…",
            "nextDialogs": [
              "728130523"
            ]
          },
          "728130523": {
            "id": "728130523",
            "speakerId": 1003,
            "speakerName": "大久保大介",
            "text": "大将，我倒是有一个想法。",
            "nextDialogs": [
              "728130524"
            ]
          },
          "728130524": {
            "id": "728130524",
            "speakerId": 1003,
            "speakerName": "大久保大介",
            "text": "您记得考什克吗？那位一直在研究我们岛上的文化和历史的学者。",
            "nextDialogs": [
              "728130525"
            ]
          },
          "728130525": {
            "id": "728130525",
            "speakerId": 1003,
            "speakerName": "大久保大介",
            "text": "他之前就一直待在这里，学者的身份也很可信…不然，让他来辨认一下，这位…肥料推销员，到底是不是学者吧。",
            "nextDialogs": [
              "728130526"
            ]
          },
          "728130526": {
            "id": "728130526",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "嗯，这样不错。旅行者，能麻烦你跑一趟，把考什克先生带过来吗？",
            "nextDialogs": [
              "728130527"
            ]
          },
          "728130527": {
            "id": "728130527",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "为了防止意外，我会在这里守着这位…肥料推销员。",
            "nextDialogs": [
              "728130528"
            ]
          },
          "728130528": {
            "id": "728130528",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道了。",
            "nextDialogs": [
              "728130529"
            ]
          },
          "728130529": {
            "id": "728130529",
            "speakerId": 1001,
            "speakerName": "五郎",
            "text": "那就拜托你了，请快去快回吧。"
          }
        }
      }
    },
    {
      "subId": "7281307",
      "subQuestName": "寻找考什克",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728130701"
        ],
        "dialogs": {
          "728130701": {
            "id": "728130701",
            "speakerId": 1006,
            "speakerName": "考什克",
            "text": "图腾的含义…嗯？旅行者，你找我有什么事吗？",
            "nextDialogs": [
              "728130702"
            ]
          },
          "728130702": {
            "id": "728130702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于爱拉尼的事…",
            "nextDialogs": [
              "728130703"
            ]
          },
          "728130703": {
            "id": "728130703",
            "speakerId": 1006,
            "speakerName": "考什克",
            "text": "你说爱拉尼来海祇岛了？奇怪，她怎么来这里了…她不是应该去璃月吗？",
            "nextDialogs": [
              "728130704"
            ]
          },
          "728130704": {
            "id": "728130704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她被士兵抓住了…",
            "nextDialogs": [
              "728130705"
            ]
          },
          "728130705": {
            "id": "728130705",
            "speakerId": 1006,
            "speakerName": "考什克",
            "text": "什么？唉…在这种情况下来海祇岛…她当然会被怀疑了…",
            "nextDialogs": [
              "728130706"
            ]
          },
          "728130706": {
            "id": "728130706",
            "speakerId": 1006,
            "speakerName": "考什克",
            "text": "先不说这个了，我们赶紧过去吧，这孩子太莽撞了…"
          }
        }
      }
    },
    {
      "subId": "7281308",
      "subQuestName": "与考什克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

  "subQuests": [
    {
      "subId": "7720301",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772030101"
        ],
        "dialogs": {
          "772030101": {
            "id": "772030101",
            "speakerId": 22653,
            "speakerName": "马尔托斯",
            "text": "呼呼…等到了雪精们的公馆，不管付出什么样的代价，我也一定要学会雕塑的技艺…",
            "nextDialogs": [
              "772030102"
            ]
          },
          "772030102": {
            "id": "772030102",
            "speakerId": 22653,
            "speakerName": "马尔托斯",
            "text": "啊，不过，还是休息一会儿再动身吧。恩人说得对，不能再贸然前进…"
          }
        }
      }
    },
    {
      "subId": "7720302",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772030201"
        ],
        "dialogs": {
          "772030201": {
            "id": "772030201",
            "speakerId": 22653,
            "speakerName": "马尔托斯",
            "text": "虽然有点可惜，不过…能看到这些作品也很不错…",
            "nextDialogs": [
              "772030203",
              "772030207",
              "772030210"
            ]
          },
          "772030203": {
            "id": "772030203",
            "speakerId": 22653,
            "speakerName": "马尔托斯",
            "text": "啊，是的，路上遇到了许多人的帮忙，最终还是抵达了这里。",
            "nextDialogs": [
              "772030204"
            ]
          },
          "772030204": {
            "id": "772030204",
            "speakerId": 22653,
            "speakerName": "马尔托斯",
            "text": "可惜…听说那位雪孃的王公不知为何去世，没法当面向她请教…",
            "nextDialogs": [
              "772030205"
            ]
          },
          "772030205": {
            "id": "772030205",
            "speakerId": 22653,
            "speakerName": "马尔托斯",
            "text": "不过，只是看她留下的作品，也让人觉得受益匪浅…"
          },
          "772030207": {
            "id": "772030207",
            "speakerId": 22653,
            "speakerName": "马尔托斯",
            "text": "过得很好，在这里…虽然雪精们不太用火，所以整个公馆有点冷冰冰的，但是总比在风雪里好多了…",
            "nextDialogs": [
              "772030208"
            ]
          },
          "772030208": {
            "id": "772030208",
            "speakerId": 22653,
            "speakerName": "马尔托斯",
            "text": "在这里，也有许多雪精对于艺术和雕塑有着十足的造诣，能够跟他们交流也是十分大的幸事了…"
          },
          "772030210": {
            "id": "772030210",
            "speakerId": 22653,
            "speakerName": "马尔托斯",
            "text": "你也一样，希望您的一切也顺利。"
          }
        }
      }
    },

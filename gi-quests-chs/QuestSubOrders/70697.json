    {
      "subId": "7069701",
      "subQuestName": "与宵宫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706970101"
        ],
        "dialogs": {
          "706970101": {
            "id": "706970101",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "#{NICKNAME}！没想到在蒙德碰上了你。",
            "nextDialogs": [
              "706970102"
            ]
          },
          "706970102": {
            "id": "706970102",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "这还是我第一次来这么冷的地方呢，所有的体验都很新奇。",
            "nextDialogs": [
              "706970103"
            ]
          },
          "706970103": {
            "id": "706970103",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "打雪仗啊，堆雪人啊，哦对了，还有漫画！",
            "nextDialogs": [
              "706970104"
            ]
          },
          "706970104": {
            "id": "706970104",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "没想到，在稻妻流行的作品《炽魂斗士战记》，在这里也有读者。",
            "nextDialogs": [
              "706970105"
            ]
          },
          "706970105": {
            "id": "706970105",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "我和几个纳塔来的朋友聊漫画聊得可开心了，一时手痒，还做了一块漫画角色立牌。",
            "nextDialogs": [
              "706970106"
            ]
          },
          "706970106": {
            "id": "706970106",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "对了，你听说过《炽魂斗士战记》吗？",
            "nextDialogs": [
              "706970107"
            ]
          },
          "706970107": {
            "id": "706970107",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "和宵宫聊了聊「炽魂斗士特攻队」的事…",
            "nextDialogs": [
              "706970108"
            ]
          },
          "706970108": {
            "id": "706970108",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "竟然这么巧，你的朋友也喜欢这部漫画，好奇妙的缘分。",
            "nextDialogs": [
              "706970109"
            ]
          },
          "706970109": {
            "id": "706970109",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "那这块立牌就送给你们吧，炽魂斗士菲耶蒂娜，正好配「炽魂斗士特战队」。"
          }
        }
      }
    }
  ]
}
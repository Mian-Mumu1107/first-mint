{
  "lineCounts": {
    "Player": 12,
    "塔莫蕾": 17,
    "娜赞": 9,
    "爱拉尼": 17
  },
  "subQuests": [
    {
      "subId": "2503101",
      "subQuestName": "与塔莫蕾对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250310101"
        ],
        "dialogs": {
          "250310101": {
            "id": "250310101",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "糟糕了…这下可糟糕了…",
            "nextDialogs": [
              "250310102"
            ]
          },
          "250310102": {
            "id": "250310102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿蕾梅的训练出问题了？",
            "nextDialogs": [
              "250310103"
            ]
          },
          "250310103": {
            "id": "250310103",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "#{NICKNAME}！你来得正好，谢天谢地…",
            "nextDialogs": [
              "250310104"
            ]
          },
          "250310104": {
            "id": "250310104",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "没时间解释了，请你快帮我去救救人！",
            "nextDialogs": [
              "250310107"
            ]
          },
          "250310107": {
            "id": "250310107",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "算…算是吧。我们俩都因为论文崩溃过好几轮，还在图书馆里抱头痛哭过…",
            "nextDialogs": [
              "250310108"
            ]
          },
          "250310108": {
            "id": "250310108",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "啊啊啊——现在不是说这些的时候！那家伙根本不听我的劝！",
            "nextDialogs": [
              "250310109"
            ]
          },
          "250310109": {
            "id": "250310109",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "说什么为了论文在所不惜，然后带着她的那个护卫，成天在野外乱逛！",
            "nextDialogs": [
              "250310110"
            ]
          },
          "250310110": {
            "id": "250310110",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "结果她到现在都没有回来！部族这边也抽不出人手去救人…",
            "nextDialogs": [
              "250310111"
            ]
          },
          "250310111": {
            "id": "250310111",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "#{NICKNAME}，请你快去救救她！"
          }
        }
      }
    },
    {
      "subId": "2503102",
      "subQuestName": "营救塔莫蕾的朋友",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2503103",
      "subQuestName": "营救塔莫蕾的朋友",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250310301"
        ],
        "dialogs": {
          "250310301": {
            "id": "250310301",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "实在不行，你就不能不写那个论文吗？啊啊啊——"
          }
        }
      }
    },
    {
      "subId": "2503104",
      "subQuestName": "与塔莫蕾的朋友对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250310401"
        ],
        "dialogs": {
          "250310401": {
            "id": "250310401",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "谢谢你，谢谢你帮忙…",
            "nextDialogs": [
              "250310402"
            ]
          },
          "250310402": {
            "id": "250310402",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "要是能把那个破包早点丢开，我一个人就能解决他们。",
            "nextDialogs": [
              "250310403"
            ]
          },
          "250310403": {
            "id": "250310403",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "那我们来纳塔就白来了！我才不要嘞！",
            "nextDialogs": [
              "250310404"
            ]
          },
          "250310404": {
            "id": "250310404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等等，你是…爱拉尼？",
            "nextDialogs": [
              "250310405"
            ]
          },
          "250310405": {
            "id": "250310405",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "#欸？你…你是{NICKNAME}！真的是你！",
            "nextDialogs": [
              "250310406"
            ]
          },
          "250310406": {
            "id": "250310406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "旁边这位小姐，难道是…",
            "nextDialogs": [
              "250310407"
            ]
          },
          "250310407": {
            "id": "250310407",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "娜赞。盗宝团。我们应该见过，你忘记了？",
            "nextDialogs": [
              "250310408"
            ]
          },
          "250310408": {
            "id": "250310408",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "呼啊…你真是我的大救星，救了我多少次了？一次，两次…",
            "nextDialogs": [
              "250310409"
            ]
          },
          "250310409": {
            "id": "250310409",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "别算我那次。那次是你自己不想走的。",
            "nextDialogs": [
              "250310410"
            ]
          },
          "250310410": {
            "id": "250310410",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "我才没算那次呢，而且什么叫我自己不想走，我都付过钱给你啦。",
            "nextDialogs": [
              "250310411"
            ]
          },
          "250310411": {
            "id": "250310411",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "你那么一点钱，随便吃吃喝喝就花光了。",
            "nextDialogs": [
              "250310412"
            ]
          },
          "250310412": {
            "id": "250310412",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不会又是为了论文来的吧？",
            "nextDialogs": [
              "250310413"
            ]
          },
          "250310413": {
            "id": "250310413",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "嘿嘿…我都努力那么久了，总不能白费吧…",
            "nextDialogs": [
              "250310414"
            ]
          },
          "250310414": {
            "id": "250310414",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "这次我可是从教令院里申请了专门的经费，课题也确认好了，没有人和我冲撞。",
            "nextDialogs": [
              "250310415"
            ]
          },
          "250310415": {
            "id": "250310415",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "而且，我还有娜赞给我做护卫，坏蛋全都给她打跑啦。",
            "nextDialogs": [
              "250310416"
            ]
          },
          "250310416": {
            "id": "250310416",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "是因为我们没油水可捞，他们也不愿意惹麻烦。",
            "nextDialogs": [
              "250310419"
            ]
          },
          "250310419": {
            "id": "250310419",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "…这家伙把自己装文献的包捂得死紧，从「回声之子」那边一直走到这里。",
            "nextDialogs": [
              "250310420"
            ]
          },
          "250310420": {
            "id": "250310420",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "说实话，就算是以我的眼光来看，她也像是一个怀里捂着宝贝的笨蛋。",
            "nextDialogs": [
              "250310421"
            ]
          },
          "250310421": {
            "id": "250310421",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "一个捂着宝贝的人，走在这种前后都无人的荒郊野外，旁边只有一个护卫…无论是谁都会想要搏一把。",
            "nextDialogs": [
              "250310422"
            ]
          },
          "250310422": {
            "id": "250310422",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "没错！我的包里就是宝贝。这些可都是我的实地采访记录，还有各类文献的抄本。",
            "nextDialogs": [
              "250310423"
            ]
          },
          "250310423": {
            "id": "250310423",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "有了它们，我的那篇论文一定能够写出来！",
            "nextDialogs": [
              "250310424"
            ]
          },
          "250310424": {
            "id": "250310424",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "哼，这篇论文的主题可是「归火圣夜巡礼」。绝对的重量级，肯定足够我毕业了。",
            "nextDialogs": [
              "250310425"
            ]
          },
          "250310425": {
            "id": "250310425",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "哎呀，也多亏了塔莫蕾给我出的主意。真不愧是我的好朋友，嘿嘿嘿。",
            "nextDialogs": [
              "250310426"
            ]
          },
          "250310426": {
            "id": "250310426",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "#再次谢谢你啦，{NICKNAME}，要是没有你，那些坏蛋不仅会弄坏我的书，还会抢走我的钱！",
            "nextDialogs": [
              "250310427"
            ]
          },
          "250310427": {
            "id": "250310427",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "前段时间我帮人家整理书籍和规整资料，好不容易才挣了一些钱，被抢走的话，就没钱买新的资料了。",
            "nextDialogs": [
              "250310428"
            ]
          },
          "250310428": {
            "id": "250310428",
            "speakerId": 20776,
            "speakerName": "娜赞",
            "text": "嗯，但你最终还是会把所有钱都用来买书。如果不是我把你的钱包拿走，我们就要饿肚子了。",
            "nextDialogs": [
              "250310429"
            ]
          },
          "250310429": {
            "id": "250310429",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "也，也没有买那么多啦…",
            "nextDialogs": [
              "250310430"
            ]
          },
          "250310430": {
            "id": "250310430",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "哎呀，先不聊了。我们还要去「流泉之众」那边取材呢。",
            "nextDialogs": [
              "250310431"
            ]
          },
          "250310431": {
            "id": "250310431",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "那就再见啦！等下次见面的时候我的论文肯定完成了！到时候我一定请你吃一顿好吃的！"
          }
        }
      }
    },
    {
      "subId": "2503105",
      "subQuestName": "向塔莫蕾回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250310501"
        ],
        "dialogs": {
          "250310501": {
            "id": "250310501",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "怎么样？情况怎么样？",
            "nextDialogs": [
              "250310504"
            ]
          },
          "250310504": {
            "id": "250310504",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "呼啊…吓死我了。你再不回来，我就要自己冲出去了。",
            "nextDialogs": [
              "250310505"
            ]
          },
          "250310505": {
            "id": "250310505",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "那个笨蛋就不能选个简单点的题目吗？以她的能力，肯定能蹭个及格分顺利毕业。",
            "nextDialogs": [
              "250310506"
            ]
          },
          "250310506": {
            "id": "250310506",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "每次都选这么大的题目…做半天准备，最后一场空。",
            "nextDialogs": [
              "250310507"
            ]
          },
          "250310507": {
            "id": "250310507",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "啊…抱歉，自顾自说了这么多。谢谢你帮忙，这些报酬请收下吧。",
            "nextDialogs": [
              "250310508"
            ]
          },
          "250310508": {
            "id": "250310508",
            "speakerId": 6087,
            "speakerName": "塔莫蕾",
            "text": "唉，那个笨蛋。为什么非得这么折腾自己呢…"
          }
        }
      }
    }
  ]
}
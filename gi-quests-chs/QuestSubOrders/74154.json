      }
    },
    {
      "subId": "7415402",
      "subQuestName": "和派蒙商量",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741540201"
        ],
        "dialogs": {
          "741540201": {
            "id": "741540201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太不对劲了，太不对劲了，连我都能看出来不对劲了。",
            "nextDialogs": [
              "741540202"
            ]
          },
          "741540202": {
            "id": "741540202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你脑子好，你说接下来怎么办？",
            "nextDialogs": [
              "741540207"
            ]
          },
          "741540207": {
            "id": "741540207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们再去伯努瓦家附近看看？他家后窗那里不是有一个奇怪的箱子吗？",
            "nextDialogs": [
              "741540208"
            ]
          },
          "741540208": {
            "id": "741540208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那里面一定藏了什么东西，说不定能证明你的推测。"
          }
        }
      }
    },

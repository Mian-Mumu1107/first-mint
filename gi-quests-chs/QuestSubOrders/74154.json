        ],
        "dialogs": {
          "741540501": {
            "id": "741540501",
            "speakerId": 21255,
            "speakerName": "奇怪的箱子",
            "text": "(test)昨天箱子的位置已经空掉了，但多了一张不知谁放在这里的的纸条（弹阅读物）"
          }
        }
      }
    },
    {
      "subId": "7415406",
      "subQuestName": "(test)猫食盆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741540601"
        ],
        "dialogs": {
          "741540601": {
            "id": "741540601",
            "speakerId": 21256,
            "speakerName": "奇怪的痕迹",
            "text": "(test)猫食盆装满了"
          }
        }
      }
    },
    {
      "subId": "7415407",
      "subQuestName": "前往调查奇怪的箱子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741540701"
        ],
        "dialogs": {
          "741540701": {
            "id": "741540701",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "我想按照你们的执着程度，应该不会就这么回去。",
            "nextDialogs": [
              "741540702"
            ]
          },
          "741540702": {
            "id": "741540702",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "我还以为你们会直接报告执律庭，结果没有，看来你们有些自己的想法啊。",
            "nextDialogs": [
              "741540705"
            ]
          },
          "741540705": {
            "id": "741540705",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "说实话，我已经有点佩服你们了。如果把这股劲头用对地方，你们可能会成为相当了不起的人。",
            "nextDialogs": [
              "741540706"
            ]
          },
          "741540706": {
            "id": "741540706",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "只可惜，这件事上不行。唉，你们真是不怕死啊。",
            "nextDialogs": [
              "741540707"
            ]
          },
          "741540707": {
            "id": "741540707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你吓错人了。",
            "nextDialogs": [
              "741540708"
            ]
          },
          "741540708": {
            "id": "741540708",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "哦？是因为完全没有弄清楚自己身处的状况，还是因为自以为在执行正义呢？",
            "nextDialogs": [
              "741540709"
            ]
          },
          "741540709": {
            "id": "741540709",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "说起来刚才那条新闻提到的溺死的商人，他叫布拉德特。嗯，是一个极其能说会道的家伙。",
            "nextDialogs": [
              "741540710"
            ]
          },
          "741540710": {
            "id": "741540710",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "你知道吗？新闻上说他其实不是溺死的，而是被人谋杀之后再沉湖的。",
            "nextDialogs": [
              "741540711"
            ]
          },
          "741540711": {
            "id": "741540711",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "逐影庭的人调查了半天，只查出来他是被人谋杀的，谋杀他的人罪该万死这样的结果。",
            "nextDialogs": [
              "741540712"
            ]
          },
          "741540712": {
            "id": "741540712",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "于是新闻报道就也这样写，实际情况到底怎么样，是杀人者更该死，还是他本人更该死呢？",
            "nextDialogs": [
              "741540713"
            ]
          },
          "741540713": {
            "id": "741540713",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "嗯…这是个复杂的问题，我暂时还没有想出答案。",
            "nextDialogs": [
              "741540714"
            ]
          },
          "741540714": {
            "id": "741540714",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "哦，扯远了，这跟我们要聊的事情没什么关系。",
            "nextDialogs": [
              "741540715"
            ]
          },
          "741540715": {

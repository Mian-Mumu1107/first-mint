  "subQuests": [
    {
      "subId": "7415408",
      "subQuestName": "(test)时间经过$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741540801"
        ],
        "dialogs": {
          "741540801": {
            "id": "741540801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你看，鱼肉是新鲜的，地上也很干净，一定有人刚打扫过。",
            "nextDialogs": [
              "741540802"
            ]
          },
          "741540802": {
            "id": "741540802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "伯努瓦家一定有人，我们过去听听看。",
            "nextDialogs": [
              "741540803"
            ]
          },
          "741540803": {
            "id": "741540803",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "…他说的也有道理，他不能一直消失，至少得偶尔出现一下，散个步什么的。",
            "nextDialogs": [
              "741540804"
            ]
          },
          "741540804": {
            "id": "741540804",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "至少能防止邻居报告执律庭，我可不想招来铳枪队。",
            "nextDialogs": [
              "741540805"
            ]
          },
          "741540805": {
            "id": "741540805",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "爸爸，你很想出去散步对吗？",
            "nextDialogs": [
              "741540806"
            ]
          },
          "741540806": {
            "id": "741540806",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "我…我能吗？",
            "nextDialogs": [
              "741540807"
            ]
          },
          "741540807": {
            "id": "741540807",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "当然能了，不仅能，我们还很乐意陪你出去散步呢。",
            "nextDialogs": [
              "741540808"
            ]
          },
          "741540808": {
            "id": "741540808",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "当心点，别反而给他机会出门求救，那两个怪人一直盯着这里…",
            "nextDialogs": [
              "741540809"
            ]
          },
          "741540809": {
            "id": "741540809",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "爸爸不会的，我知道。",
            "nextDialogs": [
              "741540810"
            ]
          },
          "741540810": {
            "id": "741540810",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "爸爸，你会愿意让执律庭知道…",
            "nextDialogs": [
              "741540811"
            ]
          },
          "741540811": {
            "id": "741540811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "知道什么啊…怎么说话这么小声，根本听不清。",
            "nextDialogs": [
              "741540812"
            ]
          },
          "741540812": {
            "id": "741540812",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们要出门了。",
            "nextDialogs": [
              "741540813"
            ]
          },
          "741540813": {
            "id": "741540813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们走远些吧。这次得想办法和伯努瓦说上话，对吧？",
            "nextDialogs": [
              "741540814"
            ]
          },
          "741540814": {
            "id": "741540814",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没错。",
            "nextDialogs": [
              "741540815"
            ]
          },
          "741540815": {
            "id": "741540815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好，我们快走开。",
            "nextDialogs": [
              "741540816"
            ]
          },
          "741540816": {
            "id": "741540816",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "怎么样，爸爸？心情是不是好些了呢？",
            "nextDialogs": [
              "741540817"
            ]
          },
          "741540817": {
            "id": "741540817",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "是你们！",
            "nextDialogs": [
              "741540818"
            ]
          },
          "741540818": {
            "id": "741540818",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "伯努瓦…",
            "nextDialogs": [
              "741540819"
            ]
          },
          "741540819": {
            "id": "741540819",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "…你们救救我，不，别救我…",
            "nextDialogs": [
              "741540820"
            ]
          },
          "741540820": {
            "id": "741540820",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "爸爸在说些什么呀，什么救不救的？呵呵。",
            "nextDialogs": [
              "741540821"
            ]
          },
          "741540821": {
            "id": "741540821",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "哦，是你们啊，难怪爸爸要特意跟你们打招呼，原来是熟人。",
            "nextDialogs": [
              "741540822"
            ]
          },
          "741540822": {
            "id": "741540822",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "…没有，不是的！我们不熟、不熟…",
            "nextDialogs": [
              "741540823"
            ]
          },
          "741540823": {
            "id": "741540823",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "不熟？怎么会呢，我看他们是特地在这里等着你的呀，爸爸。",
            "nextDialogs": [
              "741540824"
            ]
          },
          "741540824": {
            "id": "741540824",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "还好心帮我们拿了报纸，还去灰河找了我们以前的邻居史诺德格拉斯聊天。",
            "nextDialogs": [
              "741540825"
            ]
          },
          "741540825": {
            "id": "741540825",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "我想你们应该是很亲近的，爸爸一向很爱孩子，难怪。",
            "nextDialogs": [
              "741540826"
            ]
          },
          "741540826": {
            "id": "741540826",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "我也很爱孩子，不过我不像爸爸那么无私，我最爱自己的孩子，可惜她不见了。",
            "nextDialogs": [
              "741540828",
              "741540830"
            ]
          },
          "741540828": {
            "id": "741540828",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "我和阿托斯是爸爸的孩子，爸爸爱我们，所以我们也爱爸爸，这不是很明显吗？",
            "nextDialogs": [
              "741540831"
            ]
          },
          "741540831": {
            "id": "741540831",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "莫蒂西娅，你看今天天气多好啊，适合散步。",
            "nextDialogs": [
              "741540832"
            ]
          },
          "741540832": {
            "id": "741540832",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "是的，阿托斯。",
            "nextDialogs": [
              "741540833"
            ]
          },
          "741540833": {
            "id": "741540833",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "今天的蒸汽鸟报你看了吗？有很多非常有趣的新闻。",
            "nextDialogs": [
              "741540834"
            ]
          },
          "741540834": {
            "id": "741540834",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "还没有呢。",
            "nextDialogs": [
              "741540835"
            ]
          },
          "741540835": {
            "id": "741540835",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "有一条是关于不幸身亡的老年人的，据说他在无人监护的情况下遇到了强盗，因此不慎摔下山崖，跌死了。",
            "nextDialogs": [
              "741540836"
            ]
          },
          "741540836": {
            "id": "741540836",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "是吗？那太凄惨了。",
            "nextDialogs": [
              "741540837"
            ]
          },
          "741540837": {
            "id": "741540837",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "还有一条是关于一位不幸溺死的商人的，他好像是酒喝多了，晕晕乎乎地走到了湖里，就这么淹死了。",
            "nextDialogs": [
              "741540838"
            ]
          },
          "741540838": {
            "id": "741540838",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "啊，我的天，太不幸了。",
            "nextDialogs": [
              "741540839"
            ]
          },
          "741540839": {
            "id": "741540839",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "#最后一条最有趣，是一位爱多管闲事的老好人，唉，{M#他}{F#她}不小心吃错了药。",
            "nextDialogs": [
              "741540840"
            ]
          },
          "741540840": {
            "id": "741540840",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "把毒药当成了治病的药，就这么吃了下去，结果死得极其痛苦。",
            "nextDialogs": [
              "741540841"
            ]
          },
          "741540841": {
            "id": "741540841",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "我的天，人的死法可真多，再给我讲讲吧。",
            "nextDialogs": [
              "741540842"
            ]
          },
          "741540842": {
            "id": "741540842",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "…对不起，对不起，我不会再这么做了。",
            "nextDialogs": [
              "741540843"
            ]
          },
          "741540843": {
            "id": "741540843",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "爸爸在说什么呢？我们才没有怪你的意思，不过你跑了这一会儿，应该很累了。",
            "nextDialogs": [
              "741540844"
            ]
          },
          "741540844": {
            "id": "741540844",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "阿托斯，我们回去一起读报给爸爸听吧，爸爸不是订了很多报纸吗？",
            "nextDialogs": [
              "741540845"
            ]
          },
          "741540845": {
            "id": "741540845",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "是啊，聊得够多了，该回去了。",
            "nextDialogs": [
              "741540846"
            ]
          },
          "741540846": {
            "id": "741540846",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "我们回去吧，亲爱的爸爸。"
          },
          "741540830": {
            "id": "741540830",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "你是指陪爸爸出来散步吗？这是作为子女应尽的义务，否则我怎么对得起爸爸对我的关爱呢？"
          }
        }
      }
    },
    {
      "subId": "7415401",
      "subQuestName": "前往观察伯努瓦家附近情况",
      "sceneId": null,

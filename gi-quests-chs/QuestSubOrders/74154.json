            "speakerId": 20519,
            "speakerName": "敲一敲",
            "text": "(test)门那边静悄悄没有任何声音",
            "nextDialogs": [
              "741540402"
            ]
          },
          "741540402": {
            "id": "741540402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "(test)还是先不要敲门了吧"
          }
        }
      }

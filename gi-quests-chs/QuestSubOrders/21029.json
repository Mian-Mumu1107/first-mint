    {
      "subId": "2102901",
      "subQuestName": "与小蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210290101"
        ],
        "dialogs": {
          "210290101": {
            "id": "210290101",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "呜哇！怎么…怎么又失败了…",
            "nextDialogs": [
              "210290102"
            ]
          },
          "210290102": {
            "id": "210290102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么呢？",
            "nextDialogs": [
              "210290103"
            ]
          },
          "210290103": {
            "id": "210290103",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#欸？{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，是你呀。",
            "nextDialogs": [
              "210290104"
            ]
          },
          "210290104": {
            "id": "210290104",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "你上次不是教我烹饪了吗？我正在尝试做那道菜呢，不过…到现在还没成功过…",
            "nextDialogs": [
              "210290105"
            ]
          },
          "210290105": {
            "id": "210290105",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "我觉得，也许是因为我用的烹饪材料不对…",
            "nextDialogs": [
              "210290106"
            ]
          },
          "210290106": {
            "id": "210290106",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你能再指导我一下吗？",
            "nextDialogs": [
              "210290109"
            ]
          },
          "210290109": {
            "id": "210290109",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "这次…就做「野菇鸡肉串」好了！",
            "nextDialogs": [
              "210290110"
            ]
          },
          "210290110": {
            "id": "210290110",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们这次用什么特别的食材呢？"
          }
        }
      }
    },
    {
      "subId": "2102902",
      "subQuestName": "与小蒙对话",
      "sceneId": null,
      "locations": [],

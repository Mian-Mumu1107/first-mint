    {
      "subId": "2102907",
      "subQuestName": "将史莱姆凝液交给小蒙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210290701"
        ],
        "dialogs": {
          "210290701": {
            "id": "210290701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "甜甜花。",
            "nextDialogs": [
              "210290702"
            ]
          },
          "210290702": {
            "id": "210290702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "要让这道菜再甜一点吗？",
            "nextDialogs": [
              "210290703"
            ]
          },
          "210290703": {
            "id": "210290703",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "吃到甜甜的东西，确实能让人感觉很愉快。",
            "nextDialogs": [
              "210290704"
            ]
          },
          "210290704": {
            "id": "210290704",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我们就去找几朵甜甜花来吧。"
          }
        }
      }
    },
    {
      "subId": "2102908",
      "subQuestName": "指导小蒙进行烹饪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210291101"
        ],
        "dialogs": {
          "210291101": {
            "id": "210291101",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "太好了，那我们就快点开始做菜吧！",
            "nextDialogs": [
              "210291102"
            ]
          },
          "210291102": {
            "id": "210291102",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "呜哇！好辣！水、水在哪，我要喝点水…",
            "nextDialogs": [
              "210291103"
            ]
          },
          "210291103": {
            "id": "210291103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来，绝云椒椒是放太多了呢…",
            "nextDialogs": [
              "210291104"
            ]
          },
          "210291104": {
            "id": "210291104",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "呼…好了…",
            "nextDialogs": [
              "210291105"
            ]
          },
          "210291105": {
            "id": "210291105",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "除了有些辣之外，我觉得这道菜的味道还不错呢。",
            "nextDialogs": [
              "210291106"
            ]
          },
          "210291106": {
            "id": "210291106",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "而且，这么辣的味道，好像也有助于…提神？",
            "nextDialogs": [
              "210291109"
            ]
          },
          "210291109": {
            "id": "210291109",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#谢谢{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我会把这种做法记下来的。",
            "nextDialogs": [
              "210291110"
            ]
          },
          "210291110": {
            "id": "210291110",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "等我和爸爸去旅行的时候，再找机会做给他吃！",
            "nextDialogs": [
              "210291111"
            ]
          },
          "210291111": {
            "id": "210291111",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "嗯…爸爸能不能吃辣的来着？应该可以吧…"
          }
        }
      }
    },

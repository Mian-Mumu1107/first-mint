  "subQuests": [
    {
      "subId": "400301",
      "subQuestName": "(test)(hide)隐藏环修复PSActivity$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40030101"
        ],
        "dialogs": {
          "40030101": {
            "id": "40030101",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "哦，是你们啊，是娜维娅小姐邀请你们来扫墓的吗？",
            "nextDialogs": [
              "40030102"
            ]
          },
          "40030102": {
            "id": "40030102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，今天在街上偶遇了娜维娅，然后就跟着过来了。",
            "nextDialogs": [
              "40030103"
            ]
          },
          "40030103": {
            "id": "40030103",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "原来如此，那你们找我是有什么事么？",
            "nextDialogs": [
              "40030104"
            ]
          },
          "40030104": {
            "id": "40030104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊…就是…难得像这样遇到你嘛，你平时都挺忙的，看看可不可以回答我们几个问题…",
            "nextDialogs": [
              "40030105"
            ]
          },
          "40030105": {
            "id": "40030105",
            "speakerId": 1000,
            "speakerName": "那维莱特",
            "text": "但说无妨，毕竟你们作为外来人，协助枫丹解决了这么大的案件，我理应回报你们。"
          }
        }
      }
    },
    {
      "subId": "400302",
      "subQuestName": "(test)和那维莱特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4003199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400319901"
        ],
        "dialogs": {
          "400319901": {
            "id": "400319901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这一带的小动物们应该已经找齐了吧，好耶，我们去找龙二吧！",
            "nextDialogs": [
              "400319902"
            ]
          },
          "400319902": {
            "id": "400319902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，原来是他们把小动物给偷走了！",
            "nextDialogs": [
              "400319903"
            ]
          },
          "400319903": {
            "id": "400319903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#这几个坏东西！{NICKNAME}，你快去教训一下他们！"
          }
        }
      }
    },
    {
      "subId": "4003499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400349901"
        ],
        "dialogs": {
          "400349901": {
            "id": "400349901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？龙二居然不在？我们去问问珊瑚吧！",
            "nextDialogs": [
              "400349902"
            ]
          },
          "400349902": {
            "id": "400349902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "珊瑚说的，应该就是这附近了吧。我们找找龙二在哪里吧。",
            "nextDialogs": [
              "400349903"
            ]
          },
          "400349903": {
            "id": "400349903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "找到了！他在那里！我们快过去吧。",
            "nextDialogs": [
              "400349904"
            ]
          },
          "400349904": {
            "id": "400349904",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#啊，这群家伙回来了！没想到到头来还是要战斗了。{NICKNAME}，小心不要伤到小动物们。",
            "nextDialogs": [
              "400349905"
            ]
          },
          "400349905": {
            "id": "400349905",
            "speakerId": 1002,
            "speakerName": "龙二",
            "text": "没事，你们安心战斗，我来把小动物们转移到安全的地方。",
            "nextDialogs": [
              "400349906"
            ]
          },
          "400349906": {
            "id": "400349906",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#它、它怎么突然攻击过来了！{NICKNAME}，你快想想办法让它冷静下来！"
          }
        }
      }
    }
  ]

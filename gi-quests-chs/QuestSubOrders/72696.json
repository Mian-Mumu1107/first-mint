    {
      "subId": "7269605",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726960501"
        ],
        "dialogs": {
          "726960501": {
            "id": "726960501",
            "speakerId": 12522,
            "speakerName": "伯特兰",
            "text": "好了，快去「大工机」那儿试试看，你能造出什么样的玩具吧。"
          }
        }
      }
    }
  ]
}
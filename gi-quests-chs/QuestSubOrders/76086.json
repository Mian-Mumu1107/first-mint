    {
      "subId": "7608601",
      "subQuestName": "同「少女」见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760860101"
        ],
        "dialogs": {
          "760860101": {
            "id": "760860101",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "夜空…月亮…",
            "nextDialogs": [
              "760860102"
            ]
          },
          "760860102": {
            "id": "760860102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她似乎又想玩「月亮棋」了呢，我们去陪陪她吧！",
            "nextDialogs": [
              "760860103"
            ]
          },
          "760860103": {
            "id": "760860103",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "咦？是你们？",
            "nextDialogs": [
              "760860104"
            ]
          },
          "760860104": {
            "id": "760860104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要来下棋吗？",
            "nextDialogs": [
              "760860105"
            ]
          },
          "760860105": {
            "id": "760860105",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "好啊。我来为你准备「夜空」。"
          }
        }
      }
    },
    {
      "subId": "7608602",
      "subQuestName": "同「少女」玩月亮棋",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760540301"
        ],
        "dialogs": {
          "760540301": {
            "id": "760540301",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这样对吗…？",
            "nextDialogs": [
              "760540302"
            ]
          },
          "760540302": {
            "id": "760540302",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我想想…",
            "nextDialogs": [
              "760540303"
            ]
          },
          "760540303": {
            "id": "760540303",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "唔…",
            "nextDialogs": [
              "760540304"
            ]
          },
          "760540304": {
            "id": "760540304",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "月亮…月亮…",
            "nextDialogs": [
              "760540305"
            ]
          },
          "760540305": {
            "id": "760540305",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这里怎么样？",
            "nextDialogs": [
              "760540306"
            ]
          },
          "760540306": {
            "id": "760540306",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这次是我赢了。",
            "nextDialogs": [
              "760540307"
            ]
          },
          "760540307": {
            "id": "760540307",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我的三个月亮连起来了。",
            "nextDialogs": [
              "760540308"
            ]
          },
          "760540308": {
            "id": "760540308",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，这样就赢了。",
            "nextDialogs": [
              "760540309"
            ]
          },
          "760540309": {
            "id": "760540309",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯…月升月落，真是漫长。",
            "nextDialogs": [
              "760540310"
            ]
          },
          "760540310": {
            "id": "760540310",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我们的月亮谁都不让谁呢。",
            "nextDialogs": [
              "760540311"
            ]
          },
          "760540311": {
            "id": "760540311",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "是不是…快平手了？",
            "nextDialogs": [
              "760540312"
            ]
          },
          "760540312": {
            "id": "760540312",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "原来你喜欢深思熟虑后再做决定，嗯，没事，我们有很多时间。",
            "nextDialogs": [
              "760540313"
            ]
          },
          "760540313": {
            "id": "760540313",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "忘了怎么将「月亮」放上「夜空」吗？要不要我帮你？",
            "nextDialogs": [
              "760540314"
            ]
          },
          "760540314": {
            "id": "760540314",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "不喜欢这个游戏吗？我觉得还挺有意思。",
            "nextDialogs": [
              "760540315"
            ]
          },
          "760540315": {
            "id": "760540315",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯？你是在盯着我看吗？我感觉得到。",
            "nextDialogs": [
              "760540316"
            ]
          },
          "760540316": {
            "id": "760540316",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我的脸上…有关于「月亮」的答案吗？",
            "nextDialogs": [
              "760540317"
            ]
          },
          "760540317": {
            "id": "760540317",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "棋盘在那边哦。",
            "nextDialogs": [
              "760540318"
            ]
          },
          "760540318": {
            "id": "760540318",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，是你的「月亮」获胜了。",
            "nextDialogs": [
              "760540319"
            ]
          },
          "760540319": {
            "id": "760540319",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这片夜空属于你了。",
            "nextDialogs": [
              "760540320"
            ]
          },
          "760540320": {
            "id": "760540320",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "啊…一不小心就…",
            "nextDialogs": [
              "760540321"
            ]
          },
          "760540321": {
            "id": "760540321",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "与哥伦比娅在游戏中度过了一段愉快的时光…",
            "nextDialogs": [
              "760540322"
            ]
          },
          "760540322": {
            "id": "760540322",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "谢谢你，我玩得很开心。",
            "nextDialogs": [
              "760540323"
            ]
          },
          "760540323": {
            "id": "760540323",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "如果可以的话，下次也来陪我吧。",
            "nextDialogs": [
              "760540324"
            ]
          },
          "760540324": {
            "id": "760540324",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "把这个，当做「约定」的证明。"
          }
        }
      }
    },

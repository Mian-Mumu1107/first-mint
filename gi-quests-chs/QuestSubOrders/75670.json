  "subQuests": [
    {
      "subId": "7567001",
      "subQuestName": "与科米娜和克维库对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "756700101"
        ],
        "dialogs": {
          "756700101": {
            "id": "756700101",
            "speakerId": 14547,
            "speakerName": "科米娜",
            "text": "除去高空特训的部分，其他均已完备，总教官。",
            "nextDialogs": [
              "756700102"
            ]
          },
          "756700102": {
            "id": "756700102",
            "speakerId": 30883,
            "speakerName": "「耶耶副教官」",
            "text": "耶！",
            "nextDialogs": [
              "756700103"
            ]
          },
          "756700103": {
            "id": "756700103",
            "speakerId": 14435,
            "speakerName": "克维库",
            "text": "好，两位都很有精神！",
            "nextDialogs": [
              "756700104"
            ]
          },
          "756700104": {
            "id": "756700104",
            "speakerId": 14435,
            "speakerName": "克维库",
            "text": "「回声之子」将是我们伟大计划的第一据点，然后，我们将逐步渗透「流泉之众」、「悬木人」等多个部族…",
            "nextDialogs": [
              "756700105"
            ]
          },
          "756700105": {
            "id": "756700105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇哇！克维库，你在说些什么可怕的东西！",
            "nextDialogs": [
              "756700106"
            ]
          },
          "756700106": {
            "id": "756700106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来像神秘间谍组织。",
            "nextDialogs": [
              "756700107"
            ]
          },
          "756700107": {
            "id": "756700107",
            "speakerId": 14435,
            "speakerName": "克维库",
            "text": "#欸？是大英雄{NICKNAME}和{M#他}{F#她}的好伙伴派蒙来了呀！",
            "nextDialogs": [
              "756700108"
            ]
          },
          "756700108": {
            "id": "756700108",
            "speakerId": 14435,
            "speakerName": "克维库",
            "text": "什么间谍组织？啊哈哈哈哈，你们误会了，我们只是来传授一些能让你和龙伙伴愉快互动的技巧罢了。",
            "nextDialogs": [
              "756700109"
            ]
          },
          "756700109": {
            "id": "756700109",
            "speakerId": 14435,
            "speakerName": "克维库",
            "text": "科米娜是我们的随行医生，她会保障每一位参与者的安全。",
            "nextDialogs": [
              "756700110"
            ]
          },
          "756700110": {
            "id": "756700110",
            "speakerId": 14435,
            "speakerName": "克维库",
            "text": "「耶耶副教官」是我们特地找来的帮手，在设置关卡目标的时候，它帮了我不少忙呢！",
            "nextDialogs": [
              "756700111"
            ]
          },
          "756700111": {
            "id": "756700111",
            "speakerId": 14435,
            "speakerName": "克维库",
            "text": "至于我嘛，是总教官，简而言之，就是组织人，刚刚只是在给他们做动员大会…",
            "nextDialogs": [
              "756700114"
            ]
          },
          "756700114": {
            "id": "756700114",
            "speakerId": 14547,
            "speakerName": "科米娜",
            "text": "不好意思！当时我听说克维库先生要做这么有意义的事情，还提议在用词上要更「正规」一些，没想到有些用力过猛了…",
            "nextDialogs": [
              "756700115"
            ]
          },
          "756700115": {
            "id": "756700115",
            "speakerId": 14435,
            "speakerName": "克维库",
            "text": "哈，不用道歉科米娜小姐，我和「耶耶副教官」都很喜欢你取的称呼呢——对吧？「耶耶副教官」。",
            "nextDialogs": [
              "756700116"
            ]
          },
          "756700116": {
            "id": "756700116",
            "speakerId": 30883,
            "speakerName": "「耶耶副教官」",
            "text": "呜哇——耶！",
            "nextDialogs": [
              "756700117"
            ]
          },
          "756700117": {
            "id": "756700117",
            "speakerId": 14435,
            "speakerName": "克维库",
            "text": "#果然满意啊...对了，{NICKNAME}想来试试这些关卡吗？虽然这对你来说是小菜一碟，但也有些不一样的趣味。",
            "nextDialogs": [
              "756700118"
            ]
          },
          "756700118": {
            "id": "756700118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "具体内容是…",
            "nextDialogs": [
              "756700119"
            ]
          },
          "756700119": {
            "id": "756700119",
            "speakerId": 14435,
            "speakerName": "克维库",
            "text": "很简单，只要和各种各样的龙配合来完成我设定的目标就行了…最关键的点就是你与龙伙伴之间的信任与默契。",
            "nextDialogs": [
              "756700120"
            ]
          },
          "756700120": {
            "id": "756700120",
            "speakerId": 14435,
            "speakerName": "克维库",
            "text": "只想着一个人把所有目标完成的话，是完全——完全完成不了任何事情的，你必须时时关注你身边的伙伴。",
            "nextDialogs": [
              "756700121"
            ]
          },
          "756700121": {
            "id": "756700121",
            "speakerId": 14435,
            "speakerName": "克维库",
            "text": "哦，还有，这次暂时没有办法和绒翼龙同行，因为我们还没有准备好高空上的安全措施——再怎么样，安全第一嘛！",
            "nextDialogs": [
              "756700122"
            ]
          },
          "756700122": {
            "id": "756700122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呜哇哇，来试试吧！{NICKNAME}可最擅长合作了！"
          }
        }
      }
    }
  ]
}
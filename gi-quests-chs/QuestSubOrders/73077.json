              "730770911"
            ]
          },
          "730770911": {
            "id": "730770911",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#什么呀，原来破坏石头锁的是那菈{NICKNAME}…兰提沙还以为是「大大铁块」自己跑出来了呢…啊！",
            "nextDialogs": [
              "730770912"
            ]
          },
          "730770912": {
            "id": "730770912",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "石头锁没了！「大大铁块」要跑出来了！",
            "nextDialogs": [
              "730770913"
            ]
          },
          "730770913": {
            "id": "730770913",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#那菈{NICKNAME}和派蒙，你们快躲起来，「大大铁块」，又大又坚硬，有的眼睛还会冒火，危险危险！",
            "nextDialogs": [
              "730770914"
            ]
          },
          "730770914": {
            "id": "730770914",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰提沙你说的是被困在里面的怪物吗，已经被我们消灭啦…",
            "nextDialogs": [
              "730770915"
            ]
          },
          "730770915": {
            "id": "730770915",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "什么呀，原来「大大铁块」们被消灭了…欸嘿嘿，好呀好呀，想到「大大铁块」跑出来，兰提沙差点吓得叶子快要掉了…",
            "nextDialogs": [
              "730770916"
            ]
          },
          "730770916": {
            "id": "730770916",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#咦！是那菈{NICKNAME}和派蒙把这里的「大大铁块」们解决掉的吗！",
            "nextDialogs": [
              "730770917"
            ]
          },
          "730770917": {
            "id": "730770917",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们已经解决掉过很多这样的怪物啦！",
            "nextDialogs": [
              "730770921",
              "730770920"
            ]
          },
          "730770921": {
            "id": "730770921",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#没想到那菈{NICKNAME}居然有这样的力量…欸嘿嘿，兰提沙有件事想拜托那菈{NICKNAME}帮忙…",
            "nextDialogs": [
              "730770922"
            ]
          },
          "730770922": {
            "id": "730770922",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么事呀，不会是，和这些石头锁有关…",
            "nextDialogs": [
              "730770923"
            ]
          },
          "730770923": {
            "id": "730770923",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "派蒙，好聪明！兰提沙有点惊讶…",
            "nextDialogs": [
              "730770924"
            ]
          },
          "730770924": {
            "id": "730770924",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你惊讶什么呀！",
            "nextDialogs": [
              "730770925"
            ]
          },
          "730770925": {
            "id": "730770925",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "欸嘿嘿，确实和石头锁有关…",
            "nextDialogs": [
              "730770926"
            ]
          },
          "730770926": {
            "id": "730770926",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#石头锁，在森林里，有十六个石头锁，里面有「大大铁块」，{NICKNAME}能帮忙打倒那些「大大铁块」吗…",
            "nextDialogs": [
              "730770927"
            ]
          },
          "730770927": {
            "id": "730770927",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只有十六个？已经处理完了。",
            "nextDialogs": [
              "730770928"
            ]
          },
          "730770928": {
            "id": "730770928",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#欸！那菈{NICKNAME}和派蒙，真是太厉害了！难怪，兰提沙，感觉到森林里的大气和土都变得更加干净了。",
            "nextDialogs": [
              "730770929"
            ]
          },
          "730770929": {
            "id": "730770929",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "等一下兰提沙，兰提沙叫朋友来一起！"
          },
          "730770920": {
            "id": "730770920",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，我有好好躲起来，不让你担心嘛！"
          }
        }
      }
    },
    {
      "subId": "7307710",
      "subQuestName": "织梦之森机兵7完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730771001"
        ],
        "dialogs": {
          "730771001": {
            "id": "730771001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "叫朋友是指…",
            "nextDialogs": [
              "730771002"
            ]
          },
          "730771002": {
            "id": "730771002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！一下变出这么多个兰那罗…",
            "nextDialogs": [
              "730771003"
            ]
          },
          "730771003": {
            "id": "730771003",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#那菈{NICKNAME}和派蒙，在这里的是兰沙陀，兰沙诃和兰耶多…",
            "nextDialogs": [
              "730771004"
            ]
          },
          "730771004": {
            "id": "730771004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰那罗的名字又变多了，兰提沙，兰沙陀，兰沙诃和…",
            "nextDialogs": [
              "730771005"
            ]
          },
          "730771005": {
            "id": "730771005",
            "speakerId": 16768,
            "speakerName": "兰耶多",
            "text": "兰耶多，我的名字是兰耶多啦！",
            "nextDialogs": [
              "730771006"
            ]
          },
          "730771006": {
            "id": "730771006",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是，我记住啦！兰耶多！",
            "nextDialogs": [
              "730771007"
            ]
          },
          "730771007": {
            "id": "730771007",
            "speakerId": 16768,
            "speakerName": "兰耶多",
            "text": "我的名字被派蒙记住啦，真是开心。",
            "nextDialogs": [
              "730771008"
            ]
          },
          "730771008": {
            "id": "730771008",
            "speakerId": 16770,
            "speakerName": "兰沙陀",
            "text": "嗯…我是，兰沙陀…",
            "nextDialogs": [
              "730771009"
            ]
          },
          "730771009": {
            "id": "730771009",
            "speakerId": 17028,
            "speakerName": "兰沙诃",
            "text": "…兰沙诃。",
            "nextDialogs": [
              "730771010"
            ]
          },
          "730771010": {
            "id": "730771010",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们好。",
            "nextDialogs": [
              "730771011"
            ]
          },
          "730771011": {
            "id": "730771011",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过兰提沙，你说十六个石头锁里的「大大铁块」全打倒了，就来找你，是为了什么呀…",
            "nextDialogs": [
              "730771012"
            ]
          },
          "730771012": {
            "id": "730771012",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "啊呀…这件事要从很久很久以前说起…",
            "nextDialogs": [
              "730771013"
            ]
          },
          "730771013": {
            "id": "730771013",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "在树木枯荣了数百次，那么久的以前，地上突然出现了各种各样的铁怪物，有的是大铁块那菈，有的是没有脚的大铁块那菈…",
            "nextDialogs": [
              "730771014"
            ]
          },
          "730771014": {
            "id": "730771014",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "这些怪物有山那么高，喷出像火一样的光芒，那个时候，森林也发出哀叹，灌木在熊熊燃烧的烈焰中哭泣…",
            "nextDialogs": [
              "730771015"
            ]
          },
          "730771015": {
            "id": "730771015",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是那些「大大铁块」吗…",
            "nextDialogs": [
              "730771016"
            ]
          },
          "730771016": {
            "id": "730771016",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "是的…",
            "nextDialogs": [
              "730771017"
            ]
          },
          "730771017": {
            "id": "730771017",
            "speakerId": 16768,
            "speakerName": "兰耶多",
            "text": "后面的故事我来说，我最喜欢后面的故事。",
            "nextDialogs": [
              "730771018"
            ]
          },
          "730771018": {
            "id": "730771018",
            "speakerId": 16768,
            "speakerName": "兰耶多",
            "text": "就在很危险很危险的时候，了不起的兰帝裟出现了。",
            "nextDialogs": [
              "730771019"
            ]
          },
          "730771019": {
            "id": "730771019",
            "speakerId": 16768,
            "speakerName": "兰耶多",
            "text": "了不起的兰帝裟用他的「兰迦拉梨」打倒了许多许多的「大大铁块」，并将他们用石头锁锁了起来。",
            "nextDialogs": [
              "730771020"
            ]
          },
          "730771020": {
            "id": "730771020",
            "speakerId": 16768,
            "speakerName": "兰耶多",
            "text": "就这样，了不起的兰帝裟让诸多叶荫覆盖之处恢复往日的平静，让那菈和兰那罗都能在夜晚回到森林里休息。",
            "nextDialogs": [
              "730771021"
            ]
          },
          "730771021": {
            "id": "730771021",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，所以我们解开石头锁里，出现的那些遗迹重机，遗迹龙兽什么的，以前全是被兰帝裟打倒并封印的吗！",
            "nextDialogs": [
              "730771022"
            ]
          },
          "730771022": {
            "id": "730771022",
            "speakerId": 16768,
            "speakerName": "兰耶多",
            "text": "是呀，兰帝裟了不起，和那么多「大大铁块」周旋战斗！我最喜欢兰帝裟的故事…",
            "nextDialogs": [
              "730771023"
            ]
          },
          "730771023": {
            "id": "730771023",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#所以，兰帝裟锁住的那些「大大铁块」，全都被{NICKNAME}打倒了，为什么还要我们过来呢…",
            "nextDialogs": [
              "730771024"
            ]
          },
          "730771024": {
            "id": "730771024",
            "speakerId": 16770,
            "speakerName": "兰沙陀",
            "text": "唔…其实，兰帝裟将「大大铁块」用石头锁锁住，然而再牢固的山崖也会因狂风崩落土石，再雄伟的蚁穴也会因暴雨坍塌成泥…",
            "nextDialogs": [
              "730771025"
            ]
          },
          "730771025": {
            "id": "730771025",
            "speakerId": 16770,
            "speakerName": "兰沙陀",
            "text": "石头锁也是一样…产生裂隙，掉落碎块，直到最终，化为巴螺迦。",
            "nextDialogs": [
              "730771026"
            ]
          },
          "730771026": {
            "id": "730771026",
            "speakerId": 16770,
            "speakerName": "兰沙陀",
            "text": "到那时，「大大铁块」挣脱石头锁，森林里灾厄丛生…所以，要看管石头锁。",
            "nextDialogs": [
              "730771027"
            ]
          },
          "730771027": {
            "id": "730771027",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "啊呀，不过即使小心看管，要是一不小心没发现石头锁被挣开，那就不好了，所以兰提沙，兰沙陀，兰沙诃和兰耶多要变强。",
            "nextDialogs": [
              "730771028"
            ]
          },
          "730771028": {
            "id": "730771028",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "要是和守护法留纳神机的兰百梨迦一样，能够用兰迦拉梨打倒「大大铁块」，就不用害怕石头锁化为巴螺迦了…",
            "nextDialogs": [
              "730771029"
            ]
          },
          "730771029": {
            "id": "730771029",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以你们原本打算自己打倒那些「大大铁块」的嘛…",
            "nextDialogs": [
              "730771030"
            ]
          },
          "730771030": {
            "id": "730771030",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么就变成我们去解决那些「大大铁块」了！",
            "nextDialogs": [
              "730771031"
            ]
          },
          "730771031": {
            "id": "730771031",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "唔，「大大铁块」，传说中的怪物，要是修炼了，打不过，却打开了石头锁…",
            "nextDialogs": [
              "730771034"
            ]
          },
          "730771034": {
            "id": "730771034",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#但那菈{NICKNAME}很厉害，能打倒「大大铁块」…有那菈{NICKNAME}的帮助，就能打倒最厉害的「大方方铁块」！",
            "nextDialogs": [
              "730771035"
            ]
          },
          "730771035": {
            "id": "730771035",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，所以你叫我们过来，是为了「大方方铁块」？",
            "nextDialogs": [
              "730771036"
            ]
          },
          "730771036": {
            "id": "730771036",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "「大方方铁块」比「大大铁块」还厉害…我们的兰迦拉梨只能困住它…",
            "nextDialogs": [
              "730771037"
            ]
          },
          "730771037": {
            "id": "730771037",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#所以兰提沙看见能够打败「大大铁块」的那菈{NICKNAME}，就觉得那菈{NICKNAME}一定能打赢「大方方铁块」…",
            "nextDialogs": [
              "730771038"
            ]
          },
          "730771038": {
            "id": "730771038",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#兰提沙还想拜托那菈{NICKNAME}一次…"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7307701",
      "subQuestName": "隐藏任务上线就完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730770101"
        ],
        "dialogs": {
          "730770101": {
            "id": "730770101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "啊呀，石头锁！石头锁不见了！",
            "nextDialogs": [
              "730770102"
            ]
          },
          "730770102": {
            "id": "730770102",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "到底是谁呀，是谁破坏了石头锁呀…难道是「大大铁块」…",
            "nextDialogs": [
              "730770103"
            ]
          },
          "730770103": {
            "id": "730770103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是兰那罗…",
            "nextDialogs": [
              "730770104"
            ]
          },
          "730770104": {
            "id": "730770104",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "啊呀，能看见兰提沙，是金色的那菈和银色的鸟。",
            "nextDialogs": [
              "730770105"
            ]
          },
          "730770105": {
            "id": "730770105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我才不是什么银色的鸟呢！我是派蒙…金色的是{NICKNAME}。",
            "nextDialogs": [
              "730770106"
            ]
          },
          "730770106": {
            "id": "730770106",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#是那菈{NICKNAME}和派蒙，兰提沙记住了，兰提沙的名字是兰提沙…",
            "nextDialogs": [
              "730770107"
            ]
          },
          "730770107": {
            "id": "730770107",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "欸嘿嘿，是跟故事里那菈法留纳一样的金色的那菈，金色那菈，有着阳光晒过的树叶那样温暖的味道…",
            "nextDialogs": [
              "730770108"
            ]
          },
          "730770108": {
            "id": "730770108",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#啊呀，现在不是交朋友时间，石头锁！石头锁，那菈{NICKNAME}和派蒙在这儿…有没有看到破坏石头锁的坏家伙！",
            "nextDialogs": [
              "730770109"
            ]
          },
          "730770109": {
            "id": "730770109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "石头锁，应该说的就是刚才我们打开的…",
            "nextDialogs": [
              "730770110"
            ]
          },
          "730770110": {
            "id": "730770110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实是我们破坏的…",
            "nextDialogs": [
              "730770111"
            ]
          },
          "730770111": {
            "id": "730770111",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#什么呀，原来破坏石头锁的是那菈{NICKNAME}…兰提沙还以为是「大大铁块」自己跑出来了呢…啊！",
            "nextDialogs": [
              "730770112"
            ]
          },
          "730770112": {
            "id": "730770112",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "石头锁没了！「大大铁块」要跑出来了！",
            "nextDialogs": [
              "730770113"
            ]
          },
          "730770113": {
            "id": "730770113",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#那菈{NICKNAME}和派蒙，你们快躲起来，「大大铁块」，又大又坚硬，有的眼睛还会冒火，危险危险！",
            "nextDialogs": [
              "730770114"
            ]
          },
          "730770114": {
            "id": "730770114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰提沙你说的是被困在里面的怪物吗，已经被我们消灭啦…",
            "nextDialogs": [
              "730770115"
            ]
          },
          "730770115": {
            "id": "730770115",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "什么呀，原来「大大铁块」们被消灭了…欸嘿嘿，好呀好呀，想到「大大铁块」跑出来，兰提沙差点吓得叶子快要掉了…",
            "nextDialogs": [
              "730770116"
            ]
          },
          "730770116": {
            "id": "730770116",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#咦！是那菈{NICKNAME}和派蒙把这里的「大大铁块」们解决掉的吗！",
            "nextDialogs": [
              "730770117"
            ]
          },
          "730770117": {
            "id": "730770117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们已经解决掉过很多这样的怪物啦！",
            "nextDialogs": [
              "730770121",
              "730770120"
            ]
          },
          "730770121": {
            "id": "730770121",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#没想到那菈{NICKNAME}居然有这样的力量…欸嘿嘿，兰提沙有件事想拜托那菈{NICKNAME}帮忙…",
            "nextDialogs": [
              "730770122"
            ]
          },
          "730770122": {
            "id": "730770122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么事呀，不会是，和这些石头锁有关…",
            "nextDialogs": [
              "730770123"
            ]
          },
          "730770123": {
            "id": "730770123",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "派蒙，好聪明！兰提沙有点惊讶…",
            "nextDialogs": [
              "730770124"
            ]
          },
          "730770124": {
            "id": "730770124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你惊讶什么呀！",
            "nextDialogs": [
              "730770125"
            ]
          },
          "730770125": {
            "id": "730770125",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "欸嘿嘿，确实和石头锁有关…",
            "nextDialogs": [
              "730770126"
            ]
          },
          "730770126": {
            "id": "730770126",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#石头锁，在森林里，有十六个石头锁，里面有「大大铁块」，{NICKNAME}能帮忙打倒那些「大大铁块」吗…"
          },
          "730770120": {
            "id": "730770120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，我有好好躲起来，不让你担心嘛！"
          }
        }
      }
    },
    {
      "subId": "7307704",
      "subQuestName": "凋零之森机兵1完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730770401"
        ],
        "dialogs": {
          "730770401": {
            "id": "730770401",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#那菈{NICKNAME}，很厉害，有你在，我们一定能够打倒「大方方铁块」的！"
          }
        }
      }
    },
    {
      "subId": "7307705",
      "subQuestName": "凋零之森机兵2完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730770501"
        ],
        "dialogs": {
          "730770501": {
            "id": "730770501",
            "speakerId": 16768,
            "speakerName": "兰耶多",
            "text": "能不能打倒「大方方铁块」呢…这可是故事里出现的可怕怪物，有些紧张…"
          }
        }
      }
    },
    {
      "subId": "7307706",
      "subQuestName": "凋零之森机兵3完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730770601"
        ],
        "dialogs": {
          "730770601": {
            "id": "730770601",
            "speakerId": 16770,
            "speakerName": "兰沙陀",
            "text": "故事里，「大方方铁块」变化多端，还会如蘑菇一般，分裂成好几个「大大铁块」…",
            "nextDialogs": [
              "730770602"
            ]
          },
          "730770602": {
            "id": "730770602",
            "speakerId": 16770,
            "speakerName": "兰沙陀",
            "text": "#但只要打倒其中关键的一只，就能让「大方方铁块」露出破绽。要小心观察，那菈{NICKNAME}。"
          }
        }
      }
    },
    {
      "subId": "7307707",
      "subQuestName": "凋零之森机兵4完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730770701"
        ],
        "dialogs": {
          "730770701": {
            "id": "730770701",
            "speakerId": 17028,
            "speakerName": "兰沙诃",
            "text": "…很少和那菈说话。",
            "nextDialogs": [
              "730770702"
            ]
          },
          "730770702": {
            "id": "730770702",
            "speakerId": 17028,
            "speakerName": "兰沙诃",
            "text": "…谢谢你，好那菈。"
          }
        }
      }
    },
    {
      "subId": "7307708",
      "subQuestName": "织梦之森机兵5完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730770801"
        ],
        "dialogs": {
          "730770801": {
            "id": "730770801",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "…啊呀，没想到，就算使用「兰迦拉梨」，「大方方铁块」还有那么强的力量。",
            "nextDialogs": [
              "730770802"
            ]
          },
          "730770802": {
            "id": "730770802",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "就算我们的兰迦拉梨能够打倒「大大铁块」，但肯定打不倒「大方方铁块」…",
            "nextDialogs": [
              "730770803"
            ]
          },
          "730770803": {
            "id": "730770803",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#如果不是那菈{NICKNAME}在场…",
            "nextDialogs": [
              "730770804"
            ]
          },
          "730770804": {
            "id": "730770804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没有关系啦，反正现在恒常机关阵列…不对，反正「大方方铁块」已经被打倒了，现在已经不会再有铁怪物来破坏森林了！",
            "nextDialogs": [
              "730770805"
            ]
          },
          "730770805": {
            "id": "730770805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，你们可以放心了…",
            "nextDialogs": [
              "730770806"
            ]
          },
          "730770806": {
            "id": "730770806",
            "speakerId": 17028,
            "speakerName": "兰沙诃",
            "text": "…不行。",
            "nextDialogs": [
              "730770807"
            ]
          },
          "730770807": {
            "id": "730770807",
            "speakerId": 17028,
            "speakerName": "兰沙诃",
            "text": "…得靠自己。",
            "nextDialogs": [
              "730770808"
            ]
          },
          "730770808": {
            "id": "730770808",
            "speakerId": 16770,
            "speakerName": "兰沙陀",
            "text": "#兰沙诃说得对，看到那菈{NICKNAME}和「大方方铁块」对战，如同幼鸟见识到峰巅之高，砾石触及大地之广。",
            "nextDialogs": [
              "730770809"
            ]
          },
          "730770809": {
            "id": "730770809",
            "speakerId": 16768,
            "speakerName": "兰耶多",
            "text": "我们离了不起的兰帝裟，还有很远的距离…",
            "nextDialogs": [
              "730770810"
            ]
          },
          "730770810": {
            "id": "730770810",
            "speakerId": 16768,
            "speakerName": "兰耶多",
            "text": "一定要更加努力的修炼，下一次森林陷入危机时，才能成为兰帝裟那样的英雄！",
            "nextDialogs": [
              "730770811"
            ]
          },
          "730770811": {
            "id": "730770811",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "我们要在梦境里，和想象出来的「大方方铁块」进行战斗！",
            "nextDialogs": [
              "730770812"
            ]
          },
          "730770812": {
            "id": "730770812",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "加油啊！",
            "nextDialogs": [
              "730770813"
            ]
          },
          "730770813": {
            "id": "730770813",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们一定能成功的。",
            "nextDialogs": [
              "730770814"
            ]
          },
          "730770814": {
            "id": "730770814",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "#那菈{NICKNAME}，如果你想来的话，就跟进入桓那兰那时一样，在这里吹响「大梦的曲调」吧…",
            "nextDialogs": [
              "730770815"
            ]
          },
          "730770815": {
            "id": "730770815",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "那样就能进入我们的梦，与我们共享一个有「大方方铁块」的梦境了…",
            "nextDialogs": [
              "730770816"
            ]
          },
          "730770816": {
            "id": "730770816",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，听上去不像是个好梦…",
            "nextDialogs": [
              "730770818",
              "730770820"
            ]
          },
          "730770818": {
            "id": "730770818",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我才不要做呢，我要做有很多好吃的食物的那种梦。",
            "nextDialogs": [
              "730770821"
            ]
          },
          "730770821": {
            "id": "730770821",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "那兰提沙和兰沙陀，兰耶多，兰沙诃，就先去梦境中修炼了！",
            "nextDialogs": [
              "730770822"
            ]
          },
          "730770822": {
            "id": "730770822",
            "speakerId": 16770,
            "speakerName": "兰沙陀",
            "text": "#嗯，那菈{NICKNAME}，为表感谢，我将用清晨时的第一缕阳光铭记你。",
            "nextDialogs": [
              "730770823"
            ]
          },
          "730770823": {
            "id": "730770823",
            "speakerId": 16768,
            "speakerName": "兰耶多",
            "text": "#那菈{NICKNAME}，就跟那菈法留纳一样了不起！",
            "nextDialogs": [
              "730770824"
            ]
          },
          "730770824": {
            "id": "730770824",
            "speakerId": 17028,
            "speakerName": "兰沙诃",
            "text": "…不会忘记你。",
            "nextDialogs": [
              "730770825"
            ]
          },
          "730770825": {
            "id": "730770825",
            "speakerId": 16766,
            "speakerName": "兰提沙",
            "text": "啊呀，如果可以的话，在梦中再次相遇吧！"
          },
          "730770820": {
            "id": "730770820",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呢，毕竟是他们自己的梦…他们想象的恒常机关阵列也不会跑出来，就算在梦里打不过也不会受伤…"
          }
        }
      }
    },

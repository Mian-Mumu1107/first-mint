    {
      "subId": "7106408",
      "subQuestName": "在纪念石前献上供物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710640801"
        ],
        "dialogs": {
          "710640801": {
            "id": "710640801",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "听说「共饮之杯」即使为贼匪所得，委身做了卑贱筵席的下宾…最终也会夺回尊严，这句话是什么意思呢…？"
          }

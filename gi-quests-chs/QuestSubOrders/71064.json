    {
      "subId": "7106410",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710641002"
        ],
        "dialogs": {
          "710641002": {
            "id": "710641002",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "关于「同泽之枪」…",
            "nextDialogs": [
              "710641001"
            ]
          },
          "710641001": {
            "id": "710641001",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "听说「同泽之枪」茕然独立于孤崖之上，只待相匹的英雄前来，才会心满意足地融入永流的时光…真是夸张的传说…"
          }
        }
      }
    },
    {
      "subId": "7106415",

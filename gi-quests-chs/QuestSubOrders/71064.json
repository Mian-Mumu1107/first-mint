    {
      "subId": "7106402",
      "subQuestName": "寻找供奉在纪念石前的供物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710640201"
        ],
        "dialogs": {
          "710640201": {
            "id": "710640201",
            "speakerId": 15651,
            "speakerName": "石碑",
            "text": "（一块小石碑，其上刻文如下…）",
            "nextDialogs": [
              "710640202"
            ]
          },
          "710640202": {
            "id": "710640202",
            "speakerId": 15651,
            "speakerName": "石碑",
            "text": "…「层岩巨渊一战，我四肢皆痪，只得口述，托人记录并镌刻于此。」…",
            "nextDialogs": [
              "710640203"
            ]
          },
          "710640203": {
            "id": "710640203",
            "speakerId": 15651,
            "speakerName": "石碑",
            "text": "…「鏖战之中，虽讨得一命，每念及殉难同袍，便夙夜难眠。何况留此残躯，真恨不能随诸位同去。」…",
            "nextDialogs": [
              "710640204"
            ]
          },
          "710640204": {
            "id": "710640204",
            "speakerId": 15651,
            "speakerName": "石碑",
            "text": "…「自绝无果，帝君得闻，痛加斥詈，如是幡然醒悟。」",
            "nextDialogs": [
              "710640205"
            ]
          },
          "710640205": {
            "id": "710640205",
            "speakerId": 15651,
            "speakerName": "石碑",
            "text": "…「可叹帝君仁慈，赐还千岩军兜鍪甲胄，私念无能报效，留之亦为蒙尘，如是放置于此，待有缘人相取。」…",
            "nextDialogs": [
              "710640206"
            ]
          },
          "710640206": {
            "id": "710640206",
            "speakerId": 15651,
            "speakerName": "石碑",
            "text": "…「诸位，此生已无机会，便来世再做同袍，届时再共饮一杯盟誓之酒，共抵璃月之敌寇。」…"
          }
        }
      }
    },
    {
      "subId": "7106403",
      "subQuestName": "寻找供奉在纪念石前的供物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710640301"
        ],
        "dialogs": {
          "710640301": {
            "id": "710640301",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "没想到真的让你给找到了…这就是「千岩军的宝藏」吗…？",
            "nextDialogs": [
              "710640302"
            ]
          },
          "710640302": {
            "id": "710640302",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "虽然不知道里面有什么，不过…那份宝藏能够被你找到，当年留下那份宝藏的千岩军恐怕也很欣慰吧。",
            "nextDialogs": [
              "710640303"
            ]
          },
          "710640303": {
            "id": "710640303",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "离那场灾厄已经五百年了，一想到五百年前，这里是水深火热的战场，而无数先烈在此牺牲，就让人不禁疑问…",
            "nextDialogs": [
              "710640304"
            ]
          },
          "710640304": {
            "id": "710640304",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "在那个年代，随岩王爷征战的无数凡民，他们中的某一位，也会认为自己在参与一项被后人铭记千百年的事业吗？",
            "nextDialogs": [
              "710640305"
            ]
          },
          "710640305": {
            "id": "710640305",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "他们不会对自己的职责产生片刻的怀疑吗…？那些没能获得「神之眼」的凡人，如何忠诚于一个未曾注视他们的神，至死方休呢？",
            "nextDialogs": [
              "710640308"
            ]
          },
          "710640308": {
            "id": "710640308",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "……",
            "nextDialogs": [
              "710640309"
            ]
          },
          "710640309": {
            "id": "710640309",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "嗯，你说的没错。有「神之眼」也好，没有也好…人总还是要为了无穷可能的未来而努力的。这就是动力嘛。",
            "nextDialogs": [
              "710640310"
            ]
          },
          "710640310": {
            "id": "710640310",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "我们也是一样，不是为了过去的好日子，也不是为了当今的自我实现…而是为了彼此扶持，一同在时代中留下自己的痕迹与声音。",
            "nextDialogs": [
              "710640311"
            ]
          },
          "710640311": {
            "id": "710640311",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "或许很久以后，层岩巨渊也会成为我们的纪念碑吧。",
            "nextDialogs": [
              "710640314"
            ]
          },
          "710640314": {
            "id": "710640314",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "这满坑满谷刀削斧凿的痕迹，一代代矿工挥洒的汗水…同样见证着我们选择的艰辛之路。",
            "nextDialogs": [
              "710640312"
            ]
          },
          "710640312": {
            "id": "710640312",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "就像这块纪念石一样，将来百年，不，将来千年都会竖立在此，证明将士们的牺牲没有被记忆辜负。",
            "nextDialogs": [
              "710640313"
            ]
          },
          "710640313": {
            "id": "710640313",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "嘿嘿，虽然我肯定看不到了…但到那时候，希望也会有人来此为我们这些穷矿工酌上苦酒一杯，我也就心满意足了。"
          }
        }
      }
    },
    {
      "subId": "7106404",
      "subQuestName": "寻找供奉在纪念石前的供物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710640401"
        ],
        "dialogs": {
          "710640401": {
            "id": "710640401",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "需要找到的供物分别是「冠」、「羽」、「杯」、「晷」、「花」和「枪」。",
            "nextDialogs": [
              "710640402"
            ]
          },
          "710640402": {
            "id": "710640402",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "不过时至今日也没人全都找到过…"
          }
        }
      }
    },
    {
      "subId": "7106405",
      "subQuestName": "寻找供奉在纪念石前的供物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710640501"
        ],
        "dialogs": {
          "710640501": {
            "id": "710640501",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "听说「远眺之花」只会与那些看似疯狂的高远愿望作伴，所以才会为凡人所远…哼…会是什么样的花朵呢…？"
          }
        }
      }
    },
    {
      "subId": "7106406",
      "subQuestName": "寻找供奉在纪念石前的供物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710640601"
        ],
        "dialogs": {
          "710640601": {
            "id": "710640601",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "听说「高翔之翎」只会在某处山巅的飞鹰身上取得…但长这么大，我还没见过能从鹰隼身上拔取羽毛的侠客呢…"
          }
        }
      }
    },
    {
      "subId": "7106407",
      "subQuestName": "寻找供奉在纪念石前的供物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710640701"
        ],
        "dialogs": {
          "710640701": {
            "id": "710640701",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "听说「岁时之晷」将会为普罗之众铭记，即便暂时经历寂寞，也不会失却光泽…或许它从来没有被人遗失呢？"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7106401",
      "subQuestName": "test隐藏-预先接取的任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710640101"
        ],
        "dialogs": {
          "710640101": {
            "id": "710640101",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "千岩保佑，最近层岩巨渊可千万别再出什么问题。",
            "nextDialogs": [
              "710640102"
            ]
          },
          "710640102": {
            "id": "710640102",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "希望这次下矿也能平安无事，希望那些不再回来采矿的兄弟们也能各有好前程，千岩保佑，千岩保佑…",
            "nextDialogs": [
              "710640103"
            ]
          },
          "710640103": {
            "id": "710640103",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "嗯？怎么了，有什么事吗？",
            "nextDialogs": [
              "710640106"
            ]
          },
          "710640106": {
            "id": "710640106",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "哦，我是在拜这座纪念千岩军的纪念石，哈哈，看上去只是一堆不起眼的石块吧，但是从五百年前开始就竖立在这了。",
            "nextDialogs": [
              "710640107"
            ]
          },
          "710640107": {
            "id": "710640107",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "整个层岩啊，都受千岩军保护，所以每次我们有人下矿，都会来这里拜一拜，祈求千岩军的先烈英魂保佑。",
            "nextDialogs": [
              "710640108"
            ]
          },
          "710640108": {
            "id": "710640108",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "他们都化为元素，和我们的矿坑融为一体了…所以向他们的英魂祈求保佑，也是在向层岩巨渊致敬嘛。",
            "nextDialogs": [
              "710640109"
            ]
          },
          "710640109": {
            "id": "710640109",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "古话说，大地有神，元素有灵。那些为我们而牺牲的亡者，应该也会寄托我们的念想吧…",
            "nextDialogs": [
              "710640110"
            ]
          },
          "710640110": {
            "id": "710640110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "五百年前？",
            "nextDialogs": [
              "710640111"
            ]
          },
          "710640111": {
            "id": "710640111",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "对啊，五百年前。那时候漆黑的灾变吞没了层岩巨渊，岩王帝君号令千岩军守住层岩矿脉。",
            "nextDialogs": [
              "710640112"
            ]
          },
          "710640112": {
            "id": "710640112",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "那一战十分惨烈，在一名夜叉的带领下，千岩军前赴后继地阻拦敌人…",
            "nextDialogs": [
              "710640113"
            ]
          },
          "710640113": {
            "id": "710640113",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "最后，有一队千岩军将敌人引向层岩巨渊深处，才止息了混乱。",
            "nextDialogs": [
              "710640114"
            ]
          },
          "710640114": {
            "id": "710640114",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "据说这纪念石也是为此而立。",
            "nextDialogs": [
              "710640115"
            ]
          },
          "710640115": {
            "id": "710640115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…没想到这个丑丑的石头堆，还有这样的来头呢！",
            "nextDialogs": [
              "710640116"
            ]
          },
          "710640116": {
            "id": "710640116",
            "speakerId": 2000,
            "speakerName": "阿望",
            "text": "嘿嘿，小东西，可别对亡者不敬哟。"
          }
        }
      }
    },
    {
      "subId": "7106412",
      "subQuestName": "test隐藏-收集齐所有的供物$HIDDEN",
      "sceneId": null,

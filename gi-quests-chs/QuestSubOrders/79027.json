    {
      "subId": "7902708",
      "subQuestName": "前去取得「宝藏」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790271001"
        ],
        "dialogs": {
          "790271001": {
            "id": "790271001",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「越石丸」、「越石丸」！",
            "nextDialogs": [
              "790271002"
            ]
          },
          "790271002": {
            "id": "790271002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们找到宝藏啦，你看，是一艘海盗船的模型呢！这次你的直觉终于准了一次！",
            "nextDialogs": [
              "790271003"
            ]
          },
          "790271003": {
            "id": "790271003",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对了对了，你之前说，要告诉我们的第二件事到底是什么呀！",
            "nextDialogs": [
              "790271004"
            ]
          },
          "790271004": {
            "id": "790271004",
            "speakerId": 1002,
            "speakerName": "「越石丸」",
            "text": "……",
            "nextDialogs": [
              "790271005"
            ]
          },
          "790271005": {
            "id": "790271005",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「越石丸」。",
            "nextDialogs": [
              "790271006"
            ]
          },
          "790271006": {
            "id": "790271006",
            "speakerId": 1002,
            "speakerName": "「越石丸」",
            "text": "（其名为「越石丸」的船并没有作出任何反应…）",
            "nextDialogs": [
              "790271009"
            ]
          },
          "790271009": {
            "id": "790271009",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…哼，还说我们回来就告诉我们。",
            "nextDialogs": [
              "790271010"
            ]
          },
          "790271010": {
            "id": "790271010",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「越石丸」…真是个大骗子！"
          }
        }
      }
    },

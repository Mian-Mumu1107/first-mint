    {
      "subId": "1202113",
      "subQuestName": "和心海一起散步",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1202114",
      "subQuestName": "与心海交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120210804"
        ],
        "dialogs": {
          "120210804": {
            "id": "120210804",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "其实最早的时候，海祇岛的神社并非在珊瑚宫，而是在别的地方。",
            "nextDialogs": [
              "120210805"
            ]
          },
          "120210805": {
            "id": "120210805",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "那里靠近海祇岛的七天神像，当时的海祇岛虽不像幕府那般尊崇将军，但也认可她的存在。",
            "nextDialogs": [
              "120210806"
            ]
          },
          "120210806": {
            "id": "120210806",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "但随着那一刀落下，守护我们海祇岛的魔神被斩断之后，当初的神社便废弃了。",
            "nextDialogs": [
              "120210807"
            ]
          },
          "120210807": {
            "id": "120210807",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "也从那时起，海祇岛和幕府的关系就变得有些微妙，彼此之间的成见越来越深。",
            "nextDialogs": [
              "120210808"
            ]
          },
          "120210808": {
            "id": "120210808",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "这次和谈，我本来也想好好跟天领奉行讨论一下这个问题。有些恩怨，总有一天要放下的…",
            "nextDialogs": [
              "120210809"
            ]
          },
          "120210809": {
            "id": "120210809",
            "speakerId": 1005,
            "speakerName": "用高",
            "text": "珊瑚宫大人，今天怎么有空来这边看看了？",
            "nextDialogs": [
              "120210810"
            ]
          },
          "120210810": {
            "id": "120210810",
            "speakerId": 1005,
            "speakerName": "用高",
            "text": "总觉得你的气色比上次差了，平时要照顾好自己，你可是我们最大的依靠…",
            "nextDialogs": [
              "120210811"
            ]
          },
          "120210811": {
            "id": "120210811",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "嗯嗯，请放心，没事的。",
            "nextDialogs": [
              "120210812"
            ]
          },
          "120210812": {
            "id": "120210812",
            "speakerId": 1006,
            "speakerName": "结菜",
            "text": "珊瑚宫大人，听我一句劝。咱们跟幕府军打了那么久，可不能说谈就谈啊。",
            "nextDialogs": [
              "120210813"
            ]
          },
          "120210813": {
            "id": "120210813",
            "speakerId": 1006,
            "speakerName": "结菜",
            "text": "要是与他们和解的话，当初守护我们的魔神不就白死了…",
            "nextDialogs": [
              "120210814"
            ]
          },
          "120210814": {
            "id": "120210814",
            "speakerId": 1005,
            "speakerName": "用高",
            "text": "行了行了，都什么年代啦。这才刚打完仗呢，安安稳稳地过日子多好。",
            "nextDialogs": [
              "120210815"
            ]
          },
          "120210815": {
            "id": "120210815",
            "speakerId": 1006,
            "speakerName": "结菜",
            "text": "我当然知道，只是…唉。至少态度要强硬一些，不能随便妥协。",
            "nextDialogs": [
              "120210816"
            ]
          },
          "120210816": {
            "id": "120210816",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "我明白的，此事我会再考虑一下，一定会妥善处理。",
            "nextDialogs": [
              "120210817"
            ]
          },
          "120210817": {
            "id": "120210817",
            "speakerId": 1006,
            "speakerName": "结菜",
            "text": "太好了…那就麻烦珊瑚宫大人了。",
            "nextDialogs": [
              "120210818"
            ]
          },
          "120210818": {
            "id": "120210818",
            "speakerId": 1007,
            "speakerName": "志织",
            "text": "珊瑚宫大人？哎呀呀，没想到能在这里见到您。",
            "nextDialogs": [
              "120210819"
            ]
          },
          "120210819": {
            "id": "120210819",
            "speakerId": 1007,
            "speakerName": "志织",
            "text": "我的女儿，今年报名参加巫女选拔了。要是她能进珊瑚宫就好啦，珊瑚宫大人心善，一定不会亏待她。",
            "nextDialogs": [
              "120210820"
            ]
          },
          "120210820": {
            "id": "120210820",
            "speakerId": 1007,
            "speakerName": "志织",
            "text": "唉，我常和我家女儿说，让她有机会的话跟珊瑚宫大人好好学学。",
            "nextDialogs": [
              "120210821"
            ]
          },
          "120210821": {
            "id": "120210821",
            "speakerId": 1007,
            "speakerName": "志织",
            "text": "珊瑚宫大人这么年轻，就已经会待人处事，人又聪明伶俐…我家女儿，一直把珊瑚宫大人当做榜样。",
            "nextDialogs": [
              "120210822"
            ]
          },
          "120210822": {
            "id": "120210822",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "如果她能来珊瑚宫的话，我会关照一下…",
            "nextDialogs": [
              "120210823"
            ]
          },
          "120210823": {
            "id": "120210823",
            "speakerId": 1008,
            "speakerName": "岩田",
            "text": "珊瑚宫大人！总算见到您了。关于今年农业减产的问题，我想跟您汇报一下…",
            "nextDialogs": [
              "120210824"
            ]
          },
          "120210824": {
            "id": "120210824",
            "speakerId": 1009,
            "speakerName": "亮子",
            "text": "#珊瑚宫大人，这位不是剑鱼二番队的队长吗？{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}以后会留在海祇岛吗？",
            "nextDialogs": [
              "120210825"
            ]
          },
          "120210825": {
            "id": "120210825",
            "speakerId": 1010,
            "speakerName": "幸也",
            "text": "珊瑚宫大人…",
            "nextDialogs": [
              "120210826"
            ]
          },
          "120210826": {
            "id": "120210826",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "呼…大家稍微静一下，我都会听的。",
            "nextDialogs": [
              "120210827"
            ]
          },
          "120210827": {
            "id": "120210827",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "不过，比较长的问题还是建议写成报告，递到珊瑚宫。有时间我会慢慢批复。",
            "nextDialogs": [
              "120210828"
            ]
          },
          "120210828": {
            "id": "120210828",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "……",
            "nextDialogs": [
              "120210829"
            ]
          },
          "120210829": {
            "id": "120210829",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "#{NICKNAME}，你还好吗？",
            "nextDialogs": [
              "120210831",
              "120210833"
            ]
          },
          "120210831": {
            "id": "120210831",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "呵呵…看来你很擅长应对这样的场合。",
            "nextDialogs": [
              "120210834"
            ]
          },
          "120210834": {
            "id": "120210834",
            "speakerId": 1011,
            "speakerName": "和泉那希",
            "text": "珊瑚宫大人，原来您在这里。",
            "nextDialogs": [
              "120210835"
            ]
          },
          "120210835": {
            "id": "120210835",
            "speakerId": 1011,
            "speakerName": "和泉那希",
            "text": "有件事要向您汇报，我们有一批祭祀用具迟迟没有送到，我担心是被劫走了…",
            "nextDialogs": [
              "120210836"
            ]
          },
          "120210836": {
            "id": "120210836",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "那些东西我已经找回来了，不必担心。",
            "nextDialogs": [
              "120210837"
            ]
          },
          "120210837": {
            "id": "120210837",
            "speakerId": 1011,
            "speakerName": "和泉那希",
            "text": "真的吗？不愧是珊瑚宫大人，太厉害了！",
            "nextDialogs": [
              "120210838"
            ]
          },
          "120210838": {
            "id": "120210838",
            "speakerId": 1011,
            "speakerName": "和泉那希",
            "text": "最近的公文我简单地整理了一下，已经放在您的桌子上了。",
            "nextDialogs": [
              "120210839"
            ]
          },
          "120210839": {
            "id": "120210839",
            "speakerId": 1011,
            "speakerName": "和泉那希",
            "text": "另外，按排程来看，今天还有一场关于发展纺织业的会议…",
            "nextDialogs": [
              "120210840"
            ]
          },
          "120210840": {
            "id": "120210840",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "排程…现在？",
            "nextDialogs": [
              "120210841"
            ]
          },
          "120210841": {
            "id": "120210841",
            "speakerId": 1011,
            "speakerName": "和泉那希",
            "text": "是的，那两位远道而来的姑娘已经在等您了。",
            "nextDialogs": [
              "120210842"
            ]
          },
          "120210842": {
            "id": "120210842",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "#好吧…{NICKNAME}，本来想带你好好逛一逛海祇岛，看来要忙完再一起散散心了。",
            "nextDialogs": [
              "120210843"
            ]
          },
          "120210843": {
            "id": "120210843",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "明天我们在珊瑚宫门口碰面吧，然后一起去筹备庆功宴。",
            "nextDialogs": [
              "120210844"
            ]
          },
          "120210844": {
            "id": "120210844",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "庆功宴！会有很多好吃的吗？",
            "nextDialogs": [
              "120210845"
            ]
          },
          "120210845": {
            "id": "120210845",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "呵呵…当然有的。有些海祇岛的特色美食，也欢迎你们品尝一下。",
            "nextDialogs": [
              "120210846"
            ]
          },
          "120210846": {
            "id": "120210846",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好耶！那我们明天不见不散啦！",
            "nextDialogs": [
              "120210847"
            ]
          },
          "120210847": {
            "id": "120210847",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "嗯…"
          },
          "120210833": {
            "id": "120210833",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "是吧，我也感觉有些头疼…"
          }
        }
      }
    },
    {
      "subId": "1202102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120210201"
        ],
        "dialogs": {
          "120210201": {
            "id": "120210201",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "不过没想到，愚人众竟然借丘丘人的营地为掩护，悄悄在这里驻扎了这么久。",
            "nextDialogs": [
              "120210202"
            ]
          },
          "120210202": {
            "id": "120210202",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "他们的目的是什么呢？难道说，真的像士兵们所说的那样，他们已经勾结了天领奉行…",
            "nextDialogs": [
              "120210203"
            ]
          },
          "120210203": {
            "id": "120210203",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "我们好好调查一下这个营地吧，如果那位商人没有说谎的话，货物应该就在这里。",
            "nextDialogs": [
              "120210204"
            ]
          },
          "120210204": {
            "id": "120210204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好！那我们先四处看看吧！"
          }
        }
      }
    },
    {
      "subId": "1202118",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120211803"
        ],
        "dialogs": {
          "120211803": {
            "id": "120211803",
            "speakerId": 1003,
            "speakerName": "松田",
            "text": "老实点！",
            "nextDialogs": [
              "120211804"
            ]
          },
          "120211804": {
            "id": "120211804",
            "speakerId": 1004,
            "speakerName": "内村",
            "text": "别东张西望的！",
            "nextDialogs": [
              "120211805"
            ]
          },
          "120211805": {
            "id": "120211805",
            "speakerId": 1002,
            "speakerName": "成濑",
            "text": "哼，等珊瑚宫大人的调查结果出来了，我一定…"
          }
        }
      }
    },
    {
      "subId": "1202199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120219901"
        ],
        "dialogs": {
          "120219901": {
            "id": "120219901",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "顺利解决掉了对方首领，正是乘胜追击的好时候！",
            "nextDialogs": [
              "120219902"
            ]
          },
          "120219902": {
            "id": "120219902",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "爆炸规模和我预想中的差不多，愚人众应该也吓了一跳吧。",
            "nextDialogs": [
              "120219903"
            ]
          },
          "120219903": {
            "id": "120219903",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "它们的动作变得僵硬迟缓了，看来我们配合得很好呢！",
            "nextDialogs": [
              "120219904"
            ]
          },
          "120219904": {
            "id": "120219904",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "海祇岛的风土人情，与其他岛屿不太一样。不知道你是否习惯呢？",
            "nextDialogs": [
              "120219905"
            ]
          },
          "120219905": {
            "id": "120219905",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "这个村子，我也很长时间没有来了。最近要忙的事情越来越多…",
            "nextDialogs": [
              "120219906"
            ]
          },
          "120219906": {
            "id": "120219906",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "下次有机会，我带你去海祇岛曾经的神社看看吧。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "1202104",
      "subQuestName": "与心海交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120211001"
        ],
        "dialogs": {
          "120211001": {
            "id": "120211001",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "#干得漂亮，{NICKNAME}。",
            "nextDialogs": [
              "120211002"
            ]
          },
          "120211002": {
            "id": "120211002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，多亏了心海制定的战术啦！",
            "nextDialogs": [
              "120211003"
            ]
          },
          "120211003": {
            "id": "120211003",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "无论什么样的战术，最终都需要有人去执行。",
            "nextDialogs": [
              "120211004"
            ]
          },
          "120211004": {
            "id": "120211004",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "任何一场战斗能够赢下来，靠的都是大家共同的努力，不是我一个人的功劳。",
            "nextDialogs": [
              "120211005"
            ]
          },
          "120211005": {
            "id": "120211005",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错，我也做出了很大的贡献哦！",
            "nextDialogs": [
              "120211006"
            ]
          },
          "120211006": {
            "id": "120211006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "完全没感觉到。",
            "nextDialogs": [
              "120211007"
            ]
          },
          "120211007": {
            "id": "120211007",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！",
            "nextDialogs": [
              "120211008"
            ]
          },
          "120211008": {
            "id": "120211008",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "不过没想到，愚人众竟然借丘丘人的营地为掩护，悄悄在这里驻扎了这么久。",
            "nextDialogs": [
              "120211009"
            ]
          },
          "120211009": {
            "id": "120211009",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "他们的目的是什么呢？难道说，真的像士兵们所说的那样，他们已经勾结了天领奉行…",
            "nextDialogs": [
              "120211010"
            ]
          },
          "120211010": {
            "id": "120211010",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "我们好好调查一下这个营地吧，如果那位商人没有说谎的话，货物应该就在这里。",
            "nextDialogs": [
              "120211011"
            ]
          },
          "120211011": {
            "id": "120211011",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好！那我们先四处看看吧！"
          }
        }
      }
    },

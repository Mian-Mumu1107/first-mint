  },
  "subQuests": [
    {
      "subId": "1202101",
      "subQuestName": "前往愚人众临时营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120210101"
        ],
        "dialogs": {
          "120210101": {
            "id": "120210101",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "商人所说的愚人众营地，应该就是在这里了。",
            "nextDialogs": [
              "120210102"
            ]
          },
          "120210102": {
            "id": "120210102",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "从布设来看，这里应该曾经是一个丘丘人的营地，不知为何被愚人众占据了。",
            "nextDialogs": [
              "120210103"
            ]
          },
          "120210103": {
            "id": "120210103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇…感觉戒备很森严的样子。我们真的能进去吗？",
            "nextDialogs": [
              "120210104"
            ]
          },
          "120210104": {
            "id": "120210104",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "直接突破恐怕很难。不过没关系，此处地形对我们有利，而且我们的位置没有暴露。",
            "nextDialogs": [
              "120210105"
            ]
          },
          "120210105": {
            "id": "120210105",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "敌在明处，我们在暗处，正是使用计谋的好时机。",
            "nextDialogs": [
              "120210106"
            ]
          },
          "120210106": {
            "id": "120210106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "军师大人有何高见？",
            "nextDialogs": [
              "120210107"
            ]
          },
          "120210107": {
            "id": "120210107",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "以我之见，不外三种对策。",
            "nextDialogs": [
              "120210108"
            ]
          },
          "120210108": {
            "id": "120210108",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "第一种，擒贼擒王。愚人众在稻妻的势力暂时不成气候，剩下来的无非是残兵败将。",
            "nextDialogs": [
              "120210109"
            ]
          },
          "120210109": {
            "id": "120210109",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "若是能够自高处飞下，率先击溃其中的首领，那么杂兵便不攻自破。",
            "nextDialogs": [
              "120210110"
            ]
          },
          "120210110": {
            "id": "120210110",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "#第二种，借势而为。{NICKNAME}你看，那边堆积了一些火药桶。",
            "nextDialogs": [
              "120210111"
            ]
          },
          "120210111": {
            "id": "120210111",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "若是在他们没有发觉的情况下引爆火药，会给他们带来极大的冲击。",
            "nextDialogs": [
              "120210112"
            ]
          },
          "120210112": {
            "id": "120210112",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "猝不及防之下，对方必定会军心动摇，战斗力也大大下降。",
            "nextDialogs": [
              "120210113"
            ]
          },
          "120210113": {
            "id": "120210113",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "最后一种，则是善用地利。此处近海，水汽氤氲。我可以牵引周遭水汽，配合你的雷电将其麻痹。",
            "nextDialogs": [
              "120210114"
            ]
          },
          "120210114": {
            "id": "120210114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不愧是心海，这么快就有办法了。可是我们要采取哪个方案呢？",
            "nextDialogs": [
              "120210115"
            ]
          },
          "120210115": {
            "id": "120210115",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "这三种方案的主要差别，在于实施者对自己能力的判断。",
            "nextDialogs": [
              "120210116"
            ]
          },
          "120210116": {
            "id": "120210116",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "从上方空降，奇袭大营，是最快的方法。但是对于武力有很高的要求。",
            "nextDialogs": [
              "120210117"
            ]
          },
          "120210117": {
            "id": "120210117",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "利用爆炸使对方瞬间减员，则不需要正面苦战。但是要隐匿声息，不能暴露位置。",
            "nextDialogs": [
              "120210118"
            ]
          },
          "120210118": {
            "id": "120210118",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "#而利用地利，则必须要稳扎稳打，可能会演变为持久战。{NICKNAME}，你比较喜欢哪一种战术？",
            "nextDialogs": [
              "120210120",
              "120210124",
              "120210128"
            ]
          },
          "120210120": {
            "id": "120210120",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "呵呵…不愧是剑鱼二番队的队长，对自己的实力很有信心嘛。",
            "nextDialogs": [
              "120210121"
            ]
          },
          "120210121": {
            "id": "120210121",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "既然选定了这个战术，那我们就并肩作战吧。我虽不是武斗派，但也能提供一些支援，不会让你孤军奋战。",
            "nextDialogs": [
              "120210122"
            ]
          },
          "120210122": {
            "id": "120210122",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "尽快打倒他们，然后将商人的货物找回来吧。"
          },
          "120210124": {
            "id": "120210124",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "呵呵…看来你跟我一样，也对奇谋感兴趣呢。",
            "nextDialogs": [
              "120210125"
            ]
          },
          "120210125": {
            "id": "120210125",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "我也比较喜欢这个战术，毕竟这样的危险性是最低的。",
            "nextDialogs": [
              "120210126"
            ]
          },
          "120210126": {
            "id": "120210126",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "就让我们好好配合，给他们一个「惊喜」吧。"
          },
          "120210128": {
            "id": "120210128",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "嗯，将他们从营地中引出来，可以最大程度地保证营地的完整。",
            "nextDialogs": [
              "120210129"
            ]
          },
          "120210129": {
            "id": "120210129",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "不过，以前我们没有太多并肩作战的机会，不知道我能不能跟上你的节奏…",
            "nextDialogs": [
              "120210130"
            ]
          },
          "120210130": {
            "id": "120210130",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "放心，虽然我不敢自称武斗派，但长期与军队为伴，这样的场面应该也能够应付。",
            "nextDialogs": [
              "120210131"
            ]
          },
          "120210131": {
            "id": "120210131",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "是时候把这个愚人众营地清理掉，到里面一探究竟了。"
          }
        }
      }
    },
    {
      "subId": "1202118",
      "subQuestName": "商人和士兵闲置对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120210301"
        ],
        "dialogs": {
          "120210301": {
            "id": "120210301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "心海——",
            "nextDialogs": [
              "120210302"
            ]
          },
          "120210302": {
            "id": "120210302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "心海，我们找到商人的货物啦。你看！",
            "nextDialogs": [
              "120210303"
            ]
          },
          "120210303": {
            "id": "120210303",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "唔…哦哦。",
            "nextDialogs": [
              "120210306"
            ]
          },
          "120210306": {
            "id": "120210306",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "没事，只是稍稍有些走神而已。",
            "nextDialogs": [
              "120210307"
            ]
          },
          "120210307": {
            "id": "120210307",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "让我看看…确实，这些应该就是商人先生丢的东西了。",
            "nextDialogs": [
              "120210308"
            ]
          },
          "120210308": {
            "id": "120210308",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "粮食、药材、农耕用具…都是战后急需的东西。他囤着这些，估计是想卖个好价钱。",
            "nextDialogs": [
              "120210309"
            ]
          },
          "120210309": {
            "id": "120210309",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "不过，天领奉行应该不缺这些东西，他倒确实不至于把这些运回天领奉行。",
            "nextDialogs": [
              "120210310"
            ]
          },
          "120210310": {
            "id": "120210310",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "多半只是个投机的商人而已，没有松田和内村说的那么夸张。",
            "nextDialogs": [
              "120210311"
            ]
          },
          "120210311": {
            "id": "120210311",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…但是，故意囤积这些必需品，明显也是个坏家伙。",
            "nextDialogs": [
              "120210312"
            ]
          },
          "120210312": {
            "id": "120210312",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们就这样把货物还回去吗？总觉得有点不舒服…",
            "nextDialogs": [
              "120210313"
            ]
          },
          "120210313": {
            "id": "120210313",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "放心吧，这种情况我已经考量过了。",
            "nextDialogs": [
              "120210314"
            ]
          },
          "120210314": {
            "id": "120210314",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "在最新的「战后临时法令」中，我限制了必需品的价格上限。这些东西，最终还是会以合理的价格流入民众手里。",
            "nextDialogs": [
              "120210315"
            ]
          },
          "120210315": {
            "id": "120210315",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "如果他能早一点读读法令，应该也不会遭此无妄之灾了。",
            "nextDialogs": [
              "120210316"
            ]
          },
          "120210316": {
            "id": "120210316",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，总觉得心海什么事都能算到呢！",
            "nextDialogs": [
              "120210317"
            ]
          },
          "120210317": {
            "id": "120210317",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "太夸张啦。就拿眼下来说，关于天领奉行勾结愚人众的传闻，我就没什么头绪。",
            "nextDialogs": [
              "120210318"
            ]
          },
          "120210318": {
            "id": "120210318",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "正好还是在「能量」快不够的时候…",
            "nextDialogs": [
              "120210319"
            ]
          },
          "120210319": {
            "id": "120210319",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？心海，你刚刚说什么？",
            "nextDialogs": [
              "120210320"
            ]
          },
          "120210320": {
            "id": "120210320",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "没什么，我们快点将这堆货物还回去吧。",
            "nextDialogs": [
              "120210321"
            ]
          },
          "120210321": {
            "id": "120210321",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "庆功宴就快到了，这些麻烦事，必须早点做个了结。",
            "nextDialogs": [
              "120210322"
            ]
          },
          "120210322": {
            "id": "120210322",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好欸！我们也想在一个和平的海祇岛上开庆功宴呢！"
          }
        }
      }
    },

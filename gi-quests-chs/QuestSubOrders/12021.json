    {
      "subId": "1202111",
      "subQuestName": "和派蒙对话（废弃）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120211101"
        ],
        "dialogs": {
          "120211101": {
            "id": "120211101",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "感觉和我们刚刚制定的战术有些不一样呢…",
            "nextDialogs": [
              "120211102"
            ]
          },
          "120211102": {
            "id": "120211102",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "无妨，战场局势复杂多变，也不必拘泥于已经制定好的计划。",
            "nextDialogs": [
              "120211103"
            ]
          },
          "120211103": {
            "id": "120211103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿…打起来之后乱糟糟的，不小心把战术给忘掉了…",
            "nextDialogs": [
              "120211104"
            ]
          },
          "120211104": {
            "id": "120211104",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "从结果来看也不错，说明你们能够真正做到「随机应变」。",
            "nextDialogs": [
              "120211105"
            ]
          },
          "120211105": {
            "id": "120211105",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "不过没想到，愚人众竟然借丘丘人的营地为掩护，悄悄在这里驻扎了这么久。",
            "nextDialogs": [
              "120211106"
            ]
          },
          "120211106": {
            "id": "120211106",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "他们的目的是什么呢？难道说，真的像士兵们所说的那样，他们已经勾结了天领奉行…",
            "nextDialogs": [
              "120211107"
            ]
          },
          "120211107": {
            "id": "120211107",
            "speakerId": 1000,
            "speakerName": "珊瑚宫心海",
            "text": "我们好好调查一下这个营地吧，如果那位商人没有说谎的话，货物应该就在这里。",
            "nextDialogs": [
              "120211108"
            ]
          },
          "120211108": {
            "id": "120211108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好！那我们先四处看看吧！"
          }
        }
      }
    },

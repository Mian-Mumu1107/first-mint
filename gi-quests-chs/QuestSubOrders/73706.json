  "subQuests": [
    {
      "subId": "7370601",
      "subQuestName": "与柯莱对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737060101"
        ],
        "dialogs": {
          "737060101": {
            "id": "737060101",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "各位，好消息来了！",
            "nextDialogs": [
              "737060102"
            ]
          },
          "737060102": {
            "id": "737060102",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "我们为「稳健知行」机构打下的基础，已经得到了各学院权威学者们的高度认可…",
            "nextDialogs": [
              "737060103"
            ]
          },
          "737060103": {
            "id": "737060103",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "接下来，教令院派出的专门职工会正式入场，按照我们制定的标准和规则，继续将这个机构运转下去。",
            "nextDialogs": [
              "737060104"
            ]
          },
          "737060104": {
            "id": "737060104",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "这段时间实在有劳各位了，万分感谢各位的支持！",
            "nextDialogs": [
              "737060105"
            ]
          },
          "737060105": {
            "id": "737060105",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "好耶！努力工作的成果得到了认可，柯莱大成功！",
            "nextDialogs": [
              "737060106"
            ]
          },
          "737060106": {
            "id": "737060106",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "这次的交接工作也都让柯莱包圆了，真不错啊真不错…",
            "nextDialogs": [
              "737060107"
            ]
          },
          "737060107": {
            "id": "737060107",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "希望新入学的年轻人们都能学学你的作风，踏踏实实，把每件小事都干得无可挑剔…",
            "nextDialogs": [
              "737060108"
            ]
          },
          "737060108": {
            "id": "737060108",
            "speakerId": 1067,
            "speakerName": "珐露珊",
            "text": "而不能只想着论文里的宏大目标，离开了书面推论就两眼一黑，两手一摊！",
            "nextDialogs": [
              "737060109"
            ]
          },
          "737060109": {
            "id": "737060109",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "我，我还是非常紧张的！在各个学院的代表之间跑来跑去，沟通协调，也有点晕头转向…",
            "nextDialogs": [
              "737060110"
            ]
          },
          "737060110": {
            "id": "737060110",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "#当然，特别需要感谢{NICKNAME}和派蒙，{M#他们}{F#她们}帮我们完善了最关键的规则，提供了最宝贵的指导意见…",
            "nextDialogs": [
              "737060113"
            ]
          },
          "737060113": {
            "id": "737060113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们对这些工作都已经习以为常了，就像是…和大家一起来了场特别的野营！",
            "nextDialogs": [
              "737060114"
            ]
          },
          "737060114": {
            "id": "737060114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "期间偶尔穿插一些解谜锻炼和健身活动，还挺有意思的！又有趣味又消食…",
            "nextDialogs": [
              "737060115"
            ]
          },
          "737060115": {
            "id": "737060115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "消食…欸…饿了…",
            "nextDialogs": [
              "737060116"
            ]
          },
          "737060116": {
            "id": "737060116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然工作万事大吉了，要不要一起吃顿饭，就当是庆祝了？",
            "nextDialogs": [
              "737060117"
            ]
          },
          "737060117": {
            "id": "737060117",
            "speakerId": 1052,
            "speakerName": "迪希雅",
            "text": "派蒙还真说到了点子上了——犒劳大家的大餐，我和坎蒂丝已经准备好了！",
            "nextDialogs": [
              "737060118"
            ]
          },
          "737060118": {
            "id": "737060118",
            "speakerId": 1059,
            "speakerName": "坎蒂丝",
            "text": "几位，这边请。",
            "nextDialogs": [
              "737060119"
            ]
          },
          "737060119": {
            "id": "737060119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是大餐！庆功宴！",
            "nextDialogs": [
              "737060120"
            ]
          },
          "737060120": {
            "id": "737060120",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "来得正好！",
            "nextDialogs": [
              "737060121"
            ]
          },
          "737060121": {
            "id": "737060121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜，好久没吃这么丰盛的须弥菜了，怎么感觉我…口味一换，肚量翻倍？"
          }
        }
      }
    }
  ]
}
    {
      "subId": "2211506",
      "subQuestName": "搜集书页",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221150601"
        ],
        "dialogs": {
          "221150601": {
            "id": "221150601",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "唉，这个小常啊…",
            "nextDialogs": [
              "221150602"
            ]
          },
          "221150602": {
            "id": "221150602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "常九爷已经回来了。",
            "nextDialogs": [
              "221150603"
            ]
          },
          "221150603": {
            "id": "221150603",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "哦，我已经看见他了，真是辛苦你们了。",
            "nextDialogs": [
              "221150604"
            ]
          },
          "221150604": {
            "id": "221150604",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "他和小时候一样，就爱到处闯祸，总是说自己长大了，其实就是长不大…",
            "nextDialogs": [
              "221150605"
            ]
          },
          "221150605": {
            "id": "221150605",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "好啦，你们也别太操心了，这是小常他自己的事情。",
            "nextDialogs": [
              "221150606"
            ]
          },
          "221150606": {
            "id": "221150606",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "谢谢你们帮我跑了一趟。这是给你们的，收下吧。",
            "nextDialogs": [
              "221150607"
            ]
          },
          "221150607": {
            "id": "221150607",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "你们还有自己的事吧，赶紧去忙吧。别和小常似的，为了所谓的「出人头地」、「刮目相看」，耽误了正视自己的机会…",
            "nextDialogs": [
              "221150608"
            ]
          },
          "221150608": {
            "id": "221150608",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "唉…凡人不是仙，人生在世…何苦来哉，何苦来哉…"
          }
        }
      }
    },

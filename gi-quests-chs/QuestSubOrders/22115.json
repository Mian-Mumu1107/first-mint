{
  "lineCounts": {
    "Player": 9,
    "常九爷": 20,
    "派蒙": 3,
    "若心": 19
  },
  "subQuests": [
    {
      "subId": "2211501",
      "subQuestName": "与若心对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221150101"
        ],
        "dialogs": {
          "221150101": {
            "id": "221150101",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "唉，这小常…怎么还不回来。",
            "nextDialogs": [
              "221150102"
            ]
          },
          "221150102": {
            "id": "221150102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "小常是…",
            "nextDialogs": [
              "221150103"
            ]
          },
          "221150103": {
            "id": "221150103",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "小常啊，就是你们喊的「常九爷」。",
            "nextDialogs": [
              "221150104"
            ]
          },
          "221150104": {
            "id": "221150104",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "唉，我叫他小常叫习惯了，一直就这么叫了…",
            "nextDialogs": [
              "221150105"
            ]
          },
          "221150105": {
            "id": "221150105",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "昨天晚上，他说要出去给自己的小说取材，我也没在意，就随口叮嘱了他两句早点回来。",
            "nextDialogs": [
              "221150106"
            ]
          },
          "221150106": {
            "id": "221150106",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "结果，到现在他也没回来。我真担心他是出了什么事。",
            "nextDialogs": [
              "221150107"
            ]
          },
          "221150107": {
            "id": "221150107",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "但我这老身子骨，也不好出去找他，能拜托你们，帮我去找找小常吗？",
            "nextDialogs": [
              "221150109",
              "221150111"
            ]
          },
          "221150109": {
            "id": "221150109",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "那就太好了，就拜托你们了。"
          },
          "221150111": {
            "id": "221150111",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "唉，他还能去哪，还不是北边的「无妄坡」。",
            "nextDialogs": [
              "221150112"
            ]
          },
          "221150112": {
            "id": "221150112",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "请你们帮我去看看他吧，这么长时间了，可别出了什么意外。"
          }
        }
      }
    },
    {
      "subId": "2211502",
      "subQuestName": "寻找常九爷",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221150201"
        ],
        "dialogs": {
          "221150201": {
            "id": "221150201",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "嘿…这群怪物，真是讨人嫌…",
            "nextDialogs": [
              "221150202"
            ]
          },
          "221150202": {
            "id": "221150202",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "我就是来给我的新小说取个材，材没取到，倒是撞上了这群怪物。",
            "nextDialogs": [
              "221150203"
            ]
          },
          "221150203": {
            "id": "221150203",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "谢谢你们了啊，要不是你们，我还真不知道怎么脱身呢。",
            "nextDialogs": [
              "221150204"
            ]
          },
          "221150204": {
            "id": "221150204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "若心奶奶很担心你。",
            "nextDialogs": [
              "221150205"
            ]
          },
          "221150205": {
            "id": "221150205",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "担心我？我有什么可担心的，我都这么大人了，知道怎么照顾自己。呃…这么点意外，其实我自己也能处理，就是有点费劲…",
            "nextDialogs": [
              "221150206"
            ]
          },
          "221150206": {
            "id": "221150206",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "不过，还是谢谢你们了…我就快点回去吧，免得她老人家又唠叨个不停。"
          }
        }
      }
    },
    {
      "subId": "2211503",
      "subQuestName": "消灭所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221150301"
        ],
        "dialogs": {
          "221150301": {
            "id": "221150301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就这么走掉了啊…我们也回去吧。",
            "nextDialogs": [
              "221150302"
            ]
          },
          "221150302": {
            "id": "221150302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？地上好像有什么东西…是常九爷掉的吗？",
            "nextDialogs": [
              "221150303"
            ]
          },
          "221150303": {
            "id": "221150303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…先过去捡起来看看吧。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7152701",
      "subQuestName": "(test)斗虫二期-烟绯关卡$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716664001"
        ],
        "dialogs": {
          "716664001": {
            "id": "716664001",
            "speakerId": 30467,
            "speakerName": "「装备碾压型选手」",
            "text": "嘿呀！我来啦！让我看看，「荒泷甲光烈烈斗虫大修行」进行到什么程度了…",
            "nextDialogs": [
              "716664002"
            ]
          },
          "716664002": {
            "id": "716664002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你来得正好，烟绯！",
            "nextDialogs": [
              "716664003"
            ]
          },
          "716664003": {
            "id": "716664003",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "大恩人！感谢你帮忙搞定申办活动的事，还有那幅超帅的宣传画！",
            "nextDialogs": [
              "716664004"
            ]
          },
          "716664004": {
            "id": "716664004",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "不过，看你这架势…难不成，是要亲自来斗上两局？",
            "nextDialogs": [
              "716664005"
            ]
          },
          "716664005": {
            "id": "716664005",
            "speakerId": 30467,
            "speakerName": "「装备碾压型选手」",
            "text": "咦？不可以吗？",
            "nextDialogs": [
              "716664006"
            ]
          },
          "716664006": {
            "id": "716664006",
            "speakerId": 30467,
            "speakerName": "「装备碾压型选手」",
            "text": "我有个经常跑海外贸易的大客户，有次我帮她打赢了一场大官司，她送了我好多好多礼物，其中就有特别的鬼兜虫。",
            "nextDialogs": [
              "716664007"
            ]
          },
          "716664007": {
            "id": "716664007",
            "speakerId": 30467,
            "speakerName": "「装备碾压型选手」",
            "text": "当时我不知道怎么饲养这种动物，就拜托姥姥帮我照看了一段时间，现在看来，这只鬼兜虫还挺健壮的…",
            "nextDialogs": [
              "716664008"
            ]
          },
          "716664008": {
            "id": "716664008",
            "speakerId": 30467,
            "speakerName": "「装备碾压型选手」",
            "text": "参加斗虫比赛的话，应该不会让大家扫兴吧？",
            "nextDialogs": [
              "716664009"
            ]
          },
          "716664009": {
            "id": "716664009",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "切勿轻视了恩人姐姐，鬼王，她没有斗虫的经验，但她将派出最令人惊异、最健壮的鬼兜虫。",
            "nextDialogs": [
              "716664010"
            ]
          },
          "716664010": {
            "id": "716664010",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "居然是这样！",
            "nextDialogs": [
              "716664011"
            ]
          },
          "716664011": {
            "id": "716664011",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "那还是让「鬼王的左膀右臂」指挥「赤红一杵」上阵好了，我的挚友无论遇上什么对手，都无比镇定！",
            "nextDialogs": [
              "716664014"
            ]
          },
          "716664014": {
            "id": "716664014",
            "speakerId": 30467,
            "speakerName": "「装备碾压型选手」",
            "text": "#要由{NICKNAME}来和我玩一局吗？好呀！",
            "nextDialogs": [
              "716664015"
            ]
          },
          "716664015": {
            "id": "716664015",
            "speakerId": 30467,
            "speakerName": "「装备碾压型选手」",
            "text": "我还没有找到这种游戏的诀窍，如果我指挥得不好，还请见谅啦~"
          }
        }
      }
    },
    {
      "subId": "7152702",

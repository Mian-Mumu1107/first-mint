    {
      "subId": "7152703",
      "subQuestName": "(test)成功挑战一次烟绯$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716664101"
        ],
        "dialogs": {
          "716664101": {
            "id": "716664101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "烟绯的鬼兜虫好强！该说不愧是萍姥姥照料过的特别鬼兜虫吗…",
            "nextDialogs": [
              "716664102"
            ]
          },
          "716664102": {
            "id": "716664102",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "你看，恩人姐姐的鬼兜虫不好惹吧？",
            "nextDialogs": [
              "716664103"
            ]
          },
          "716664103": {
            "id": "716664103",
            "speakerId": 13019,
            "speakerName": "「花角玉将」",
            "text": "就像之前，我的一些部将也给你造成了不少困扰，有时「装备」和「伙伴」的性能差距，很难用指挥弥补。",
            "nextDialogs": [
              "716664104"
            ]
          },
          "716664104": {
            "id": "716664104",
            "speakerId": 1044,
            "speakerName": "荒泷一斗",
            "text": "确确确确…确实…嗯呃咳…还好我的挚友顶住了！",
            "nextDialogs": [
              "716664105"
            ]
          },
          "716664105": {
            "id": "716664105",
            "speakerId": 30467,
            "speakerName": "「装备碾压型选手」",
            "text": "原来如此，原来如此！我好像找到斗虫的乐趣了…",
            "nextDialogs": [
              "716664106"
            ]
          },
          "716664106": {
            "id": "716664106",
            "speakerId": 30467,
            "speakerName": "「装备碾压型选手」",
            "text": "#我很开心！{NICKNAME}，一斗先生，还有「花角玉将」！接下来，我还想在这里继续玩玩这个游戏！"
          }
        }
      }
    }
  ]

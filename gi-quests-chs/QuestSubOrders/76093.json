  },
  "subQuests": [
    {
      "subId": "7609301",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760930101"
        ],
        "dialogs": {
          "760930101": {
            "id": "760930101",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "为边地照亮黑夜的铸灯者啊，吾等执灯人在此宣誓…",
            "nextDialogs": [
              "760930102"
            ]
          },
          "760930102": {
            "id": "760930102",
            "speakerId": 1001,
            "speakerName": "执灯士众人",
            "text": "「如是我预见：海浪翻起白沫，死寂毁灭了星月夜。」",
            "nextDialogs": [
              "760930103"
            ]
          },
          "760930103": {
            "id": "760930103",
            "speakerId": 1001,
            "speakerName": "执灯士众人",
            "text": "「如是我宣告：谁掌中灯火不灭，就不必陷入如此黑暗…」",
            "nextDialogs": [
              "760930104"
            ]
          },
          "760930104": {
            "id": "760930104",
            "speakerId": 1001,
            "speakerName": "执灯士众人",
            "text": "「我们是执灯人，无尽雪原中执灯守护永燃的希望。」",
            "nextDialogs": [
              "760930105"
            ]
          },
          "760930105": {
            "id": "760930105",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "那么诸位，此次作战的目标是击退盘踞在苦壑崖的魔物…以及调查引发此次狂猎的罪魁祸首。",
            "nextDialogs": [
              "760930106"
            ]
          },
          "760930106": {
            "id": "760930106",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "时隔三年，如今我们将再度踏足崖上，进行决胜之战。",
            "nextDialogs": [
              "760930107"
            ]
          },
          "760930107": {
            "id": "760930107",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "我知道你们当中许多人和我一样，有着不得不加入这次作战的理由。",
            "nextDialogs": [
              "760930108"
            ]
          },
          "760930108": {
            "id": "760930108",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "要记住，我们的身后就是皮拉米达城，为了生者，为了未来，我们绝不能后退！",
            "nextDialogs": [
              "760930109"
            ]
          },
          "760930109": {
            "id": "760930109",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "正如誓言所说，「我们将使骨血做燃料，我们将使生大于死」…完成我们作为执灯士的职责吧！",
            "nextDialogs": [
              "760930110"
            ]
          },
          "760930110": {
            "id": "760930110",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "出发！",
            "nextDialogs": [
              "760930111"
            ]
          },
          "760930111": {
            "id": "760930111",
            "speakerId": 1001,
            "speakerName": "执灯士众人",
            "text": "是！队长！"
          }
        }
      }
    },
    {
      "subId": "7609302",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760930201"
        ],
        "dialogs": {
          "760930201": {
            "id": "760930201",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这么多执灯士集结出发的场景，我还是第一次见。看来事情真的很严重…",
            "nextDialogs": [
              "760930202"
            ]
          },
          "760930202": {
            "id": "760930202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们的队长看起来很可靠。",
            "nextDialogs": [
              "760930203"
            ]
          },
          "760930203": {
            "id": "760930203",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#是哦，看起来和{NICKNAME}差不多大，但是很有气势呢！",
            "nextDialogs": [
              "760930204"
            ]
          },
          "760930204": {
            "id": "760930204",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不过，我还是有点担心，他们要对付的是很特别的狂猎吧？就算有这么多人，真的没问题吗…",
            "nextDialogs": [
              "760930205"
            ]
          },
          "760930205": {
            "id": "760930205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们也想办法帮忙吧。",
            "nextDialogs": [
              "760930206"
            ]
          },
          "760930206": {
            "id": "760930206",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯！既然是狂猎的威胁，那就不只是执灯人的责任，我们也不能放任不管。",
            "nextDialogs": [
              "760930207"
            ]
          },
          "760930207": {
            "id": "760930207",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "恕我冒昧，打扰一下二位…",
            "nextDialogs": [
              "760930208"
            ]
          },
          "760930208": {
            "id": "760930208",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "老爷爷，怎么啦？",
            "nextDialogs": [
              "760930209"
            ]
          },
          "760930209": {
            "id": "760930209",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "虽然是第一次见，不过看两位的面相，想必不是无名之辈。",
            "nextDialogs": [
              "760930210"
            ]
          },
          "760930210": {
            "id": "760930210",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "#正巧我听闻，有位游历诸国，留下诸多传奇的金发冒险家{NICKNAME}与{M#他}{F#她}的伙伴，最近也来到了挪德卡莱…",
            "nextDialogs": [
              "760930211"
            ]
          },
          "760930211": {
            "id": "760930211",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "莫非就是二位？",
            "nextDialogs": [
              "760930214"
            ]
          },
          "760930214": {
            "id": "760930214",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没想到在这里也会被人认出来…这样下去，迟早有一天我们不管去哪都要乔装打扮才行了。"
          }
        }
      }
    },
    {
      "subId": "7609303",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760930301"
        ],
        "dialogs": {
          "760930301": {
            "id": "760930301",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "真够见鬼的，这破车怎么又停着不动了！",
            "nextDialogs": [
              "760930302"
            ]
          },
          "760930302": {
            "id": "760930302",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "我说月厢车大哥，你就不能再多撑一会吗？",
            "nextDialogs": [
              "760930303"
            ]
          },
          "760930303": {
            "id": "760930303",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "就差那么几步路，咱们就能回到皮拉米达了，到时候你是熄火还是趴窝都没人管你。",
            "nextDialogs": [
              "760930304"
            ]
          },
          "760930304": {
            "id": "760930304",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "结果你呢，偏偏要停在这里。怎么着，难道是要我们把你给抬回城里去？",
            "nextDialogs": [
              "760930305"
            ]
          },
          "760930305": {
            "id": "760930305",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "哎，真是多事之秋，不管干什么都触霉头。我可没工夫跟你耗，罗洛老弟，看来我们得多找几个帮手来了。",
            "nextDialogs": [
              "760930306"
            ]
          },
          "760930306": {
            "id": "760930306",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "哎哟，我这还没叫人呢，怎么就有两位朋友来了？",
            "nextDialogs": [
              "760930307"
            ]
          },
          "760930307": {
            "id": "760930307",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "看起来不是很眼熟啊，难不成是新入行的宝藏猎人？",
            "nextDialogs": [
              "760930308"
            ]
          },
          "760930308": {
            "id": "760930308",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#你们好，我是派蒙，{M#他}{F#她}是{NICKNAME}，我们是路过这里的冒险家。",
            "nextDialogs": [
              "760930309"
            ]
          },
          "760930309": {
            "id": "760930309",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "看你们的样子，是遇到什么困难了吗？",
            "nextDialogs": [
              "760930310"
            ]
          },
          "760930310": {
            "id": "760930310",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "喔！你们好，我叫安莱夫，是一名执灯士。原来两位是冒险家啊…那你们恐怕来错地方了。",
            "nextDialogs": [
              "760930313"
            ]
          },
          "760930313": {
            "id": "760930313",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "倒也不是这个意思，你们刚来或许不知道，最近北边的苦壑崖一带爆发了大规模的狂猎。",
            "nextDialogs": [
              "760930314"
            ]
          },
          "760930314": {
            "id": "760930314",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "那里有一座开拓时代遗留下来的古老遗迹，几年前就出过事故，但没想到会突然变得这么严重…",
            "nextDialogs": [
              "760930315"
            ]
          },
          "760930315": {
            "id": "760930315",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "你们往北边看，瞧见了吗？这阵子不少魔物从那儿冒出来，很不太平，你们要是没什么要紧事，最好也别在这一带游荡了。",
            "nextDialogs": [
              "760930316"
            ]
          },
          "760930316": {
            "id": "760930316",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "这次我们就是受到了老爷子的召唤，为了参加讨伐狂猎的行动才赶回皮拉米达城的。",
            "nextDialogs": [
              "760930317"
            ]
          },
          "760930317": {
            "id": "760930317",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "你说对吧，罗洛老弟？",
            "nextDialogs": [
              "760930318"
            ]
          },
          "760930318": {
            "id": "760930318",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "喂，你这是怎么了，从刚才开始就一言不发的…",
            "nextDialogs": [
              "760930319"
            ]
          },
          "760930319": {
            "id": "760930319",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "！！！"
          }
        }
      }
    },
    {
      "subId": "7609304",
      "subQuestName": "帮助执灯人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760930401"
        ],
        "dialogs": {
          "760930401": {
            "id": "760930401",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "可惜现在没时间带你们参观总部了，接下来等待我们的将会是一场苦战。你们要是需要做些准备，可以尽快安排。",
            "nextDialogs": [
              "760930402"
            ]
          },
          "760930402": {
            "id": "760930402",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "我就带着大部队先行前往「望崖营壁」进行必要的战备工作了，在那儿等你们会合。",
            "nextDialogs": [
              "760930403"
            ]
          },
          "760930403": {
            "id": "760930403",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯！我们也会尽快赶到的！",
            "nextDialogs": [
              "760930404"
            ]
          },
          "760930404": {
            "id": "760930404",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好啦，想想我们有什么需要赶紧准备的…",
            "nextDialogs": [
              "760930405"
            ]
          },
          "760930405": {
            "id": "760930405",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "恕我冒昧，打扰一下二位…",
            "nextDialogs": [
              "760930406"
            ]
          },
          "760930406": {
            "id": "760930406",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "老爷爷，怎么啦？",
            "nextDialogs": [
              "760930407"
            ]
          },
          "760930407": {
            "id": "760930407",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "我叫尼基塔，是长年驻守在这边鄙之地的一名普通的执灯士。虽然是第一次见，不过看两位的面相，想必不是无名之辈。",
            "nextDialogs": [
              "760930408"
            ]
          },
          "760930408": {
            "id": "760930408",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "#正巧我听闻，有位游历诸国，留下诸多传奇的金发冒险家{NICKNAME}与{M#他}{F#她}的伙伴，最近也来到了挪德卡莱…",
            "nextDialogs": [
              "760930409"
            ]
          },
          "760930409": {
            "id": "760930409",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "莫非就是二位？",
            "nextDialogs": [
              "760930412"
            ]
          },
          "760930412": {
            "id": "760930412",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没想到在这里也会被人认出来…这样下去，迟早有一天我们不管去哪儿都要乔装打扮才行了。",
            "nextDialogs": [
              "760930413"
            ]
          },
          "760930413": {
            "id": "760930413",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "我看两位也参加了誓师，你们也要去讨伐苦壑崖的魔物吗？",
            "nextDialogs": [
              "760930414"
            ]
          },
          "760930414": {
            "id": "760930414",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "是呀，我们可是调查分队的临时成员呢！",
            "nextDialogs": [
              "760930415"
            ]
          },
          "760930415": {
            "id": "760930415",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "告诉了尼基塔你们是如何结识了叶洛亚，并加入调查分队的…",
            "nextDialogs": [
              "760930416"
            ]
          },
          "760930416": {
            "id": "760930416",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "原来是这样，能够结识两位，是那孩子的福分啊。这次作战有你们的助力，我也能放心不少了。",
            "nextDialogs": [
              "760930417"
            ]
          },
          "760930417": {
            "id": "760930417",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "这话虽然有些多余，但那孩子作为队长，承担这样艰巨的任务也还是第一次。",
            "nextDialogs": [
              "760930418"
            ]
          },
          "760930418": {
            "id": "760930418",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "叶洛亚的实力在新一代的执灯士里当属魁首，战斗方面的事情我是不担心的，就怕那孩子…",
            "nextDialogs": [
              "760930419"
            ]
          },
          "760930419": {
            "id": "760930419",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "就当是老头子的杞人忧天吧，我听说过不少你们的事迹，对于调查这种危险之地时的进退一定很有经验。",
            "nextDialogs": [
              "760930420"
            ]
          },
          "760930420": {
            "id": "760930420",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "无论如何，请你们多多用冒险家的智慧帮助他吧。",
            "nextDialogs": [
              "760930421"
            ]
          },
          "760930421": {
            "id": "760930421",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "作为队员当然义不容辞。",
            "nextDialogs": [
              "760930422"
            ]
          },
          "760930422": {
            "id": "760930422",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对啊，就算你不说，我们也会全力帮忙的！",
            "nextDialogs": [
              "760930423"
            ]
          },
          "760930423": {
            "id": "760930423",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "那就太好了。可惜我的腿脚没有当年那么灵便了，不然也要亲自去苦壑崖会会那个怪物。",
            "nextDialogs": [
              "760930424"
            ]
          },
          "760930424": {
            "id": "760930424",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "呵呵，终究还是得把担子交给年轻人啊…"
          }
        }
      }
    },
    {
      "subId": "7609305",
      "subQuestName": "与执灯人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760930501"
        ],
        "dialogs": {
          "760930501": {
            "id": "760930501",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "罗洛老弟，你真的没事吧？",
            "nextDialogs": [
              "760930502"
            ]
          },
          "760930502": {
            "id": "760930502",
            "speakerId": 1007,
            "speakerName": "罗洛",
            "text": "我没事。抱歉…想到马上能回到皮拉米达城，精神稍微松懈了…",
            "nextDialogs": [
              "760930503"
            ]
          },
          "760930503": {
            "id": "760930503",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "你没事就好。刚才你中了狂猎的招，多亏这位小英雄出手相助…总之谢谢你们了。",
            "nextDialogs": [
              "760930504"
            ]
          },
          "760930504": {
            "id": "760930504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "举手之劳。",
            "nextDialogs": [
              "760930505"
            ]
          },
          "760930505": {
            "id": "760930505",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#对{NICKNAME}来说就是小菜一碟啦。",
            "nextDialogs": [
              "760930506"
            ]
          },
          "760930506": {
            "id": "760930506",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "说来小英雄的身手不错啊。怎么样，要不要加入我们执灯人军团呢？",
            "nextDialogs": [
              "760930507"
            ]
          },
          "760930507": {
            "id": "760930507",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "不过说起来，在这个节骨眼上邀请你们，在外人看来可能有点恩将仇报的意思…还是算了，你们就当我没说。",
            "nextDialogs": [
              "760930508"
            ]
          },
          "760930508": {
            "id": "760930508",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "刚才我们对付的就是来自苦壑崖的狂猎，这些狂猎怪得很，不仅会成群结队地袭击遇上的活物，据说还有摄人心智的能力…",
            "nextDialogs": [
              "760930509"
            ]
          },
          "760930509": {
            "id": "760930509",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "不知道它们使的什么邪术，会在人意志松懈的瞬间趁虚而入，把人裹挟进狂猎的队伍…",
            "nextDialogs": [
              "760930510"
            ]
          },
          "760930510": {
            "id": "760930510",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "这次的作战就是要对付它们，要是不顺利，从今往后还有没有「执灯人」都难说了…",
            "nextDialogs": [
              "760930511"
            ]
          },
          "760930511": {
            "id": "760930511",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这、这么严重吗？",
            "nextDialogs": [
              "760930512"
            ]
          },
          "760930512": {
            "id": "760930512",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "是啊，不过这不是你们冒险家…而且还是小孩子该担心的事，就交给我们吧。",
            "nextDialogs": [
              "760930513"
            ]
          },
          "760930513": {
            "id": "760930513",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "若是还能再见的话，我一定请你们喝「皮拉米达的夜莺」，再来点肉馅黑麦包表达感谢，这才是我们执灯人的待客之道。",
            "nextDialogs": [
              "760930514"
            ]
          },
          "760930514": {
            "id": "760930514",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一定会再见的。",
            "nextDialogs": [
              "760930515"
            ]
          },
          "760930515": {
            "id": "760930515",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "加油啊，一定要平安回来！",
            "nextDialogs": [
              "760930516"
            ]
          },
          "760930516": {
            "id": "760930516",
            "speakerId": 1004,
            "speakerName": "安莱夫",
            "text": "那借两位的吉言，我们就先回皮拉米达城了。有缘再会吧！"
          }
        }
      }
    },
    {
      "subId": "7609306",
      "subQuestName": "调查「高塔」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760930601"
        ],
        "dialogs": {
          "760930601": {
            "id": "760930601",
            "speakerId": 1008,
            "speakerName": "菲林斯",
            "text": "放平时我恐怕不会主动请缨，但这次的麻烦真的不需要我出手吗？",
            "nextDialogs": [
              "760930602"
            ]
          },
          "760930602": {
            "id": "760930602",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "哦，你来了啊，菲林斯。我还以为你不会来。",
            "nextDialogs": [
              "760930603"
            ]
          },
          "760930603": {
            "id": "760930603",
            "speakerId": 1008,
            "speakerName": "菲林斯",
            "text": "如果您真那么想，为何不直接减少给我寄信的频次呢？",
            "nextDialogs": [
              "760930604"
            ]
          },
          "760930604": {
            "id": "760930604",
            "speakerId": 1008,
            "speakerName": "菲林斯",
            "text": "没记错的话，您一个星期前就把通知送到我的灯塔来了，我要是都不来看看，也太不尊重您这位执灯长了。",
            "nextDialogs": [
              "760930605"
            ]
          },
          "760930605": {
            "id": "760930605",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "总部的通知从来也没落下你，说到底还是因为那孩子吧。在执灯人里他跟你走得最近，总向我打听你的近况。",
            "nextDialogs": [
              "760930606"
            ]
          },
          "760930606": {
            "id": "760930606",
            "speakerId": 1008,
            "speakerName": "菲林斯",
            "text": "他的近况如何？",
            "nextDialogs": [
              "760930607"
            ]
          },
          "760930607": {
            "id": "760930607",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "……",
            "nextDialogs": [
              "760930608"
            ]
          },
          "760930608": {
            "id": "760930608",
            "speakerId": 1008,
            "speakerName": "菲林斯",
            "text": "你还是选择了将重任放在他的肩上。",
            "nextDialogs": [
              "760930609"
            ]
          },
          "760930609": {
            "id": "760930609",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "是啊。我需要他，而我也深切地信任着他…",
            "nextDialogs": [
              "760930610"
            ]
          },
          "760930610": {
            "id": "760930610",
            "speakerId": 1008,
            "speakerName": "菲林斯",
            "text": "我已经给出了忠告，那并非寻常的狂猎。那些魔物是被吸引过来的，被某个过去被封印在苦壑崖的古老存在。",
            "nextDialogs": [
              "760930611"
            ]
          },
          "760930611": {
            "id": "760930611",
            "speakerId": 1008,
            "speakerName": "菲林斯",
            "text": "关于「他」，我也略知一二，我曾在白沙皇的宫廷中与他有过一面之缘，那条毒蛇绝非等闲之辈。",
            "nextDialogs": [
              "760930612"
            ]
          },
          "760930612": {
            "id": "760930612",
            "speakerId": 1008,
            "speakerName": "菲林斯",
            "text": "我记得他的眼睛，就和现在正盯着我们的那只一模一样。",
            "nextDialogs": [
              "760930613"
            ]
          },
          "760930613": {
            "id": "760930613",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "我说，菲林斯啊，你还记得我们是怎么成为执灯人的吗？",
            "nextDialogs": [
              "760930614"
            ]
          },
          "760930614": {
            "id": "760930614",
            "speakerId": 1008,
            "speakerName": "菲林斯",
            "text": "你是说「你们」？",
            "nextDialogs": [
              "760930615"
            ]
          },
          "760930615": {
            "id": "760930615",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "「我们」，菲林斯，我们。最近我总梦到过去的事情，梦见你我一起经历过的那些战场。",
            "nextDialogs": [
              "760930616"
            ]
          },
          "760930616": {
            "id": "760930616",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "灾难总是突然到来的…无论是枕戈待旦、坦然面对之人，还是提心吊胆、心怀侥幸之辈，大限来时，无人能够幸免。",
            "nextDialogs": [
              "760930617"
            ]
          },
          "760930617": {
            "id": "760930617",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "但你我都知道，在永恒的宁静到来前，人的抗争是有意义的。而我们执灯人正是这样，用五百年的抗争，铸成了这座堡垒的根基。",
            "nextDialogs": [
              "760930618"
            ]
          },
          "760930618": {
            "id": "760930618",
            "speakerId": 1008,
            "speakerName": "菲林斯",
            "text": "我看叶洛亚没到需要补上这一课的程度吧？你比我更清楚他曾经失去过一切。",
            "nextDialogs": [
              "760930619"
            ]
          },
          "760930619": {
            "id": "760930619",
            "speakerId": 1008,
            "speakerName": "菲林斯",
            "text": "这道理他想必早已知道，只是眼下，少年的心气让他还不愿意承认罢了。",
            "nextDialogs": [
              "760930620"
            ]
          },
          "760930620": {
            "id": "760930620",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "但我的时间也不多了…比起他即将肩负的责任，我本该为他争取的岁月，现在也所剩无几了。",
            "nextDialogs": [
              "760930621"
            ]
          },
          "760930621": {
            "id": "760930621",
            "speakerId": 1008,
            "speakerName": "菲林斯",
            "text": "看来你决心已定了。那我就不再白费口舌了，毕竟你才是执灯长。",
            "nextDialogs": [
              "760930622"
            ]
          },
          "760930622": {
            "id": "760930622",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "话说回来，上次托你寻的物件，你还记得吧？",
            "nextDialogs": [
              "760930623"
            ]
          },
          "760930623": {
            "id": "760930623",
            "speakerId": 1008,
            "speakerName": "菲林斯",
            "text": "执灯长先生的委托我怎么会忘？五百年前的古物，且与最初的咏月使有着千丝万缕的联系。即使是我也费了不少周折…",
            "nextDialogs": [
              "760930624"
            ]
          },
          "760930624": {
            "id": "760930624",
            "speakerId": 1005,
            "speakerName": "尼基塔",
            "text": "呵呵，既然如此，我们也该开始准备了。铸灯者留下的「弓矢」，就让我们见识一下它的威力吧…"
          }
        }
      }
    },

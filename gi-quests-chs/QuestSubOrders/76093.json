      "dialogue": {
        "startDialogs": [
          "760930801"
        ],
        "dialogs": {
          "760930801": {
            "id": "760930801",
            "speakerId": 1009,
            "speakerName": "像是队长的人",
            "text": "为边地照亮黑夜的铸灯者啊，吾等执灯人在此宣誓…",
            "nextDialogs": [
              "760930802"
            ]
          },
          "760930802": {
            "id": "760930802",
            "speakerId": 1001,
            "speakerName": "执灯士众人",
            "text": "「如是我预见：海浪翻起白沫，死寂毁灭了星月夜。」",
            "nextDialogs": [
              "760930803"
            ]
          },
          "760930803": {
            "id": "760930803",
            "speakerId": 1001,
            "speakerName": "执灯士众人",
            "text": "「如是我宣告：谁掌中灯火不灭，就不必陷入如此黑暗…」",
            "nextDialogs": [
              "760930804"
            ]
          },
          "760930804": {
            "id": "760930804",
            "speakerId": 1001,
            "speakerName": "执灯士众人",
            "text": "「我们是执灯人，无尽雪原中执灯守护永燃的希望。」",
            "nextDialogs": [
              "760930805"
            ]
          },
          "760930805": {
            "id": "760930805",
            "speakerId": 1009,
            "speakerName": "像是队长的人",
            "text": "那么诸位，此次作战的目标是击退盘踞在苦壑崖的魔物…以及调查引发此次狂猎的罪魁祸首。",
            "nextDialogs": [
              "760930806"
            ]
          },
          "760930806": {
            "id": "760930806",
            "speakerId": 1009,
            "speakerName": "像是队长的人",
            "text": "时隔三年，如今我们将再度踏足崖上，进行决胜之战。",
            "nextDialogs": [
              "760930807"
            ]
          },
          "760930807": {
            "id": "760930807",
            "speakerId": 1009,
            "speakerName": "像是队长的人",
            "text": "我知道你们当中许多人和我一样，有着不得不加入这次作战的理由。",
            "nextDialogs": [
              "760930808"
            ]
          },
          "760930808": {
            "id": "760930808",
            "speakerId": 1009,
            "speakerName": "像是队长的人",
            "text": "要记住，我们的身后就是皮拉米达城，为了生者，为了未来，我们绝不能后退！",
            "nextDialogs": [
              "760930809"
            ]
          },
          "760930809": {
            "id": "760930809",
            "speakerId": 1009,
            "speakerName": "像是队长的人",
            "text": "正如誓言所说，「我们将使骨血做燃料，我们将使生大于死」…完成我们作为执灯士的职责吧！",
            "nextDialogs": [
              "760930810"
            ]
          },
          "760930810": {
            "id": "760930810",
            "speakerId": 1009,
            "speakerName": "像是队长的人",
            "text": "出发！",
            "nextDialogs": [
              "760930811"
            ]
          },
          "760930811": {
            "id": "760930811",
            "speakerId": 1001,
            "speakerName": "执灯士众人",
            "text": "是！队长！"
          }
        }
      }
    }
  ]
}
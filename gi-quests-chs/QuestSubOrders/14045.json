    {
      "subId": "1404599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140459901"
        ],
        "dialogs": {
          "140459901": {
            "id": "140459901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "终于到对决的时候了——现在就去德波大饭店吧！",
            "nextDialogs": [
              "140459902"
            ]
          },
          "140459902": {
            "id": "140459902",
            "speakerId": 15310,
            "speakerName": "议论纷纷的客人",
            "text": "听说了吗！爱可菲要回来参加料理对决啦！",
            "nextDialogs": [
              "140459903"
            ]
          },
          "140459903": {
            "id": "140459903",
            "speakerId": 15310,
            "speakerName": "议论纷纷的客人",
            "text": "爱可菲的料理对决！这可不能错过！",
            "nextDialogs": [
              "140459904"
            ]
          },
          "140459904": {
            "id": "140459904",
            "speakerId": 15310,
            "speakerName": "议论纷纷的客人",
            "text": "不过…对手居然敢挑战爱可菲…",
            "nextDialogs": [
              "140459905"
            ]
          },
          "140459905": {
            "id": "140459905",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "#莫妮卡、{NICKNAME}，打起精神，一起上吧！",
            "nextDialogs": [
              "140459906"
            ]
          },
          "140459906": {
            "id": "140459906",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "阿尔方斯、加斯帕德，手脚利落点，别给我丢脸！",
            "nextDialogs": [
              "140459907"
            ]
          },
          "140459907": {
            "id": "140459907",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "嚯嚯——双方主厨一上来就剑拔弩张呢！现场的氛围已经比烤炉还要炙热！",
            "nextDialogs": [
              "140459909"
            ]
          },
          "140459909": {
            "id": "140459909",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "阿尔方斯！你在干什么！这一步是你这么做的吗！还不快给我重做！",
            "nextDialogs": [
              "140459910"
            ]
          },
          "140459910": {
            "id": "140459910",
            "speakerId": 15199,
            "speakerName": "阿尔方斯",
            "text": "是！是…",
            "nextDialogs": [
              "140459911"
            ]
          },
          "140459911": {
            "id": "140459911",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "咦？莎凡娜队伍里似乎出现了一点状况…这会影响他们的进度吗？",
            "nextDialogs": [
              "140459912"
            ]
          },
          "140459912": {
            "id": "140459912",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "（莎凡娜…你到底在干什么？呼…算了…要把注意力集中在眼前的料理上…）",
            "nextDialogs": [
              "140459913"
            ]
          },
          "140459913": {
            "id": "140459913",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "爱可菲选手，已经开始了最后的环节！莎凡娜这边呢！",
            "nextDialogs": [
              "140459914"
            ]
          },
          "140459914": {
            "id": "140459914",
            "speakerId": 15200,
            "speakerName": "加斯帕德",
            "text": "这个调味…好像还是差了一点点啊！",
            "nextDialogs": [
              "140459915"
            ]
          },
          "140459915": {
            "id": "140459915",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "够了！你们这些庸才…全都放下！让我来！",
            "nextDialogs": [
              "140459916"
            ]
          },
          "140459916": {
            "id": "140459916",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "什么！莎凡娜选手竟然…打算靠自己一个人追赶进度？",
            "nextDialogs": [
              "140459917"
            ]
          },
          "140459917": {
            "id": "140459917",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "…再好的厨子，也没法在没有调料的时候去调味吧？"
          }
        }
      }
    }

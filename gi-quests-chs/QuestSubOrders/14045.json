    {
      "subId": "1404506",
      "subQuestName": "前去「审问」蛋糕",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140450601"
        ],
        "dialogs": {
          "140450601": {
            "id": "140450601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…怎么样？有尝出什么问题吗？",
            "nextDialogs": [
              "140450602"
            ]
          },
          "140450602": {
            "id": "140450602",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "…这蛋糕还不如直接拿炉渣水泥来糊！那起码还尝不出什么味道。",
            "nextDialogs": [
              "140450603"
            ]
          },
          "140450603": {
            "id": "140450603",
            "speakerId": 15199,
            "speakerName": "阿尔方斯",
            "text": "不、不至于吧…我在装盘之前明明还尝过…",
            "nextDialogs": [
              "140450604"
            ]
          },
          "140450604": {
            "id": "140450604",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "因为这就不是你们的作品——莎凡娜从头到尾都没有调换过我们的餐盘。",
            "nextDialogs": [
              "140450605"
            ]
          },
          "140450605": {
            "id": "140450605",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "不协调的味道来自蛋糕胚和奶油层之间…所以它是在料理中途被人动了手脚。",
            "nextDialogs": [
              "140450606"
            ]
          },
          "140450606": {
            "id": "140450606",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "也就是说…问题出在我们内部。",
            "nextDialogs": [
              "140450607"
            ]
          },
          "140450607": {
            "id": "140450607",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "…对不起！我…我是被迫的！",
            "nextDialogs": [
              "140450608"
            ]
          },
          "140450608": {
            "id": "140450608",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "莎凡娜主厨说，要是我不配合的话…不配合的话…",
            "nextDialogs": [
              "140450609"
            ]
          },
          "140450609": {
            "id": "140450609",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "冷静点，莫妮卡！我一早就说过吧，输赢又不重要，要是真想追究你什么，对决结束的时候就提出来了。",
            "nextDialogs": [
              "140450610"
            ]
          },
          "140450610": {
            "id": "140450610",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "有什么难处，都尽管说出来，不用遮遮掩掩的。",
            "nextDialogs": [
              "140450611"
            ]
          },
          "140450611": {
            "id": "140450611",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "我…",
            "nextDialogs": [
              "140450612"
            ]
          },
          "140450612": {
            "id": "140450612",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "…其实，当初不小心弄出安全事故的人…也许就是我…",
            "nextDialogs": [
              "140450613"
            ]
          },
          "140450613": {
            "id": "140450613",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "安全事故…等等，你是说幽光素！？那天采买了问题食材的人…就是你？",
            "nextDialogs": [
              "140450614"
            ]
          },
          "140450614": {
            "id": "140450614",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "我猜是的…那天负责采买的人，就是我跟莎凡娜主厨…我没有注意检查，让有问题的食材混了进来…",
            "nextDialogs": [
              "140450615"
            ]
          },
          "140450615": {
            "id": "140450615",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "…但我真是不小心的！我没想到它们会出问题，也没想过最后会害得爱可菲主厨获罪！",
            "nextDialogs": [
              "140450616"
            ]
          },
          "140450616": {
            "id": "140450616",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "…更没想过，还会被莎凡娜主厨威胁…",
            "nextDialogs": [
              "140450617"
            ]
          },
          "140450617": {
            "id": "140450617",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然是这样！所以莎凡娜是发现了你的把柄，才要挟你在对决里搞破坏的吗？",
            "nextDialogs": [
              "140450618"
            ]
          },
          "140450618": {
            "id": "140450618",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "对不起…对不起！我…我真的很害怕！一想到，要是爱可菲主厨知道了是我害的她…大脑就一片空白！",
            "nextDialogs": [
              "140450619"
            ]
          },
          "140450619": {
            "id": "140450619",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "我真的…很害怕被爱可菲主厨记恨…结果却做出了更对不起您的事！我…我…呜…",
            "nextDialogs": [
              "140450620"
            ]
          },
          "140450620": {
            "id": "140450620",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "哈…就因为这点事？",
            "nextDialogs": [
              "140450621"
            ]
          },
          "140450621": {
            "id": "140450621",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "…欸？",
            "nextDialogs": [
              "140450622"
            ]
          },
          "140450622": {
            "id": "140450622",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "我又没在梅洛彼得堡待多久。离开德波大饭店也不只是因为这件事，还有我自己的考量。",
            "nextDialogs": [
              "140450623"
            ]
          },
          "140450623": {
            "id": "140450623",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "为了这点事情觉得有多对不起我，简直就像煎鹅肝的时候放一大勺油一样多此一举。",
            "nextDialogs": [
              "140450624"
            ]
          },
          "140450624": {
            "id": "140450624",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "您…愿意原谅我？",
            "nextDialogs": [
              "140450625"
            ]
          },
          "140450625": {
            "id": "140450625",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "啊——倒也不是说就不用为自己的失误负责了。",
            "nextDialogs": [
              "140450626"
            ]
          },
          "140450626": {
            "id": "140450626",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "回头记得让瓦纳格姆扣你几个月的绩效、好好查清楚问题食材是从哪流入的…该改过的一个也别落下，懂吗？",
            "nextDialogs": [
              "140450627"
            ]
          },
          "140450627": {
            "id": "140450627",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "懂、懂了…",
            "nextDialogs": [
              "140450628"
            ]
          },
          "140450628": {
            "id": "140450628",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "至于现在，先回答别的问题吧。莎凡娜为什么不惜胁迫你也要拿到秘典原本…你知道些什么吗？",
            "nextDialogs": [
              "140450629"
            ]
          },
          "140450629": {
            "id": "140450629",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "这个…我也没有什么证据，都是自己瞎猜的…",
            "nextDialogs": [
              "140450630"
            ]
          },
          "140450630": {
            "id": "140450630",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "唔…我这是…",
            "nextDialogs": [
              "140450631"
            ]
          },
          "140450631": {
            "id": "140450631",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "…我听客人们私下里都在说，自从爱可菲离开后，德波大饭店的味道都变了…尤其是店里的招牌。",
            "nextDialogs": [
              "140450632"
            ]
          },
          "140450632": {
            "id": "140450632",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…德波大蛋糕？",
            "nextDialogs": [
              "140450633"
            ]
          },
          "140450633": {
            "id": "140450633",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "这么一说…刚才对决的时候也是啊，跟以前的味道比，确实是有哪里不一样？",
            "nextDialogs": [
              "140450634"
            ]
          },
          "140450634": {
            "id": "140450634",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "…不过如果不是专业的美食家或是吃习惯了的常客，恐怕很难吃出其中的区别。",
            "nextDialogs": [
              "140450635"
            ]
          },
          "140450635": {
            "id": "140450635",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "在莎凡娜主厨的心里，大概连这一点区别都不想容忍吧？",
            "nextDialogs": [
              "140450636"
            ]
          },
          "140450636": {
            "id": "140450636",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "我看到过好几次，她在夜里一遍又一遍地重做蛋糕胚，想要还原出爱可菲的作品，但永远都差了那么一点…",
            "nextDialogs": [
              "140450637"
            ]
          },
          "140450637": {
            "id": "140450637",
            "speakerId": 15199,
            "speakerName": "阿尔方斯",
            "text": "确实，我也有见到过…不过当时没有往深了想。",
            "nextDialogs": [
              "140450638"
            ]
          },
          "140450638": {
            "id": "140450638",
            "speakerId": 15200,
            "speakerName": "加斯帕德",
            "text": "现在回想起来…就是在爱可菲主厨离开之后？莎凡娜的精神状态就越来越差了。",
            "nextDialogs": [
              "140450639"
            ]
          },
          "140450639": {
            "id": "140450639",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "「证明自己可以胜任爱可菲的工作」…她应该是这么想的吧？",
            "nextDialogs": [
              "140450640"
            ]
          },
          "140450640": {
            "id": "140450640",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "但一次次重做都没能成功…让她变得越来越极端。",
            "nextDialogs": [
              "140450641"
            ]
          },
          "140450641": {
            "id": "140450641",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "不知道是从哪一天开始，她怀疑的对象，也开始从自己…变成了爱可菲。",
            "nextDialogs": [
              "140450642"
            ]
          },
          "140450642": {
            "id": "140450642",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怀疑爱可菲？这有什么好怀疑的？",
            "nextDialogs": [
              "140450643"
            ]
          },
          "140450643": {
            "id": "140450643",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…她在怀疑秘典抄本。",
            "nextDialogs": [
              "140450644"
            ]
          },
          "140450644": {
            "id": "140450644",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "嗯，她这么执着地想要拿到原本，应该就是以为，爱可菲在给她的抄本里，隐瞒了什么重要的细节吧？",
            "nextDialogs": [
              "140450645"
            ]
          },
          "140450645": {
            "id": "140450645",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "为了不被抢走第一主厨的名号…故意偷藏了真正的秘方。",
            "nextDialogs": [
              "140450646"
            ]
          },
          "140450646": {
            "id": "140450646",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "笨蛋…真是笨蛋！",
            "nextDialogs": [
              "140450647"
            ]
          },
          "140450647": {
            "id": "140450647",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "结果在看到原本之后，她才发现上面，真的没有什么了不起的秘密…",
            "nextDialogs": [
              "140450648"
            ]
          },
          "140450648": {
            "id": "140450648",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "一直坚信的答案，突然成了空谈，藏在心里的压力一下子全部爆发…所以她才会晕倒吧。",
            "nextDialogs": [
              "140450649"
            ]
          },
          "140450649": {
            "id": "140450649",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "……",
            "nextDialogs": [
              "140450650"
            ]
          },
          "140450650": {
            "id": "140450650",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是我还是不太明白…明明秘方都是一样的，为什么会做不出相同的味道呢？",
            "nextDialogs": [
              "140450651"
            ]
          },
          "140450651": {
            "id": "140450651",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就算厨艺不好手艺不精，做上四五十次，也总得押对一次吧？",
            "nextDialogs": [
              "140450652"
            ]
          },
          "140450652": {
            "id": "140450652",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "这大概…就是天才跟凡人的差距了吧。",
            "nextDialogs": [
              "140450653"
            ]
          },
          "140450653": {
            "id": "140450653",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "……",
            "nextDialogs": [
              "140450654"
            ]
          },
          "140450654": {
            "id": "140450654",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "……",
            "nextDialogs": [
              "140450655"
            ]
          },
          "140450655": {
            "id": "140450655",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "…可恶…",
            "nextDialogs": [
              "140450656"
            ]
          },
          "140450656": {
            "id": "140450656",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "「…是她隐瞒了真正的秘方…」",
            "nextDialogs": [
              "140450657"
            ]
          },
          "140450657": {
            "id": "140450657",
            "speakerId": 15310,
            "speakerName": "议论纷纷的客人",
            "text": "…新任的主厨？是叫什么名字？没听说过啊…",
            "nextDialogs": [
              "140450658"
            ]
          },
          "140450658": {
            "id": "140450658",
            "speakerId": 15310,
            "speakerName": "议论纷纷的客人",
            "text": "…没了爱可菲的德波大饭店，还能继续辉煌吗？",
            "nextDialogs": [
              "140450659"
            ]
          },
          "140450659": {
            "id": "140450659",
            "speakerId": 15310,
            "speakerName": "议论纷纷的客人",
            "text": "…这味道好像有点变了啊？怎么说呢…还是差了点火候…",
            "nextDialogs": [
              "140450660"
            ]
          },
          "140450660": {
            "id": "140450660",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "…可恶！",
            "nextDialogs": [
              "140450661"
            ]
          },
          "140450661": {
            "id": "140450661",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "「…不择手段，去拿回真正的秘典！」",
            "nextDialogs": [
              "140450662"
            ]
          },
          "140450662": {
            "id": "140450662",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "拿去，这是《德波大秘典》的抄本，从今往后，就由你来保管它了。",
            "nextDialogs": [
              "140450663"
            ]
          },
          "140450663": {
            "id": "140450663",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "别管别人怎么说，我说你可以你就可以！你不相信自己，难道还不相信我吗？",
            "nextDialogs": [
              "140450664"
            ]
          },
          "140450664": {
            "id": "140450664",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "嘿！听见了吗？…我走之后，德波大饭店可就交给你啦。",
            "nextDialogs": [
              "140450665"
            ]
          },
          "140450665": {
            "id": "140450665",
            "speakerId": 1011,
            "speakerName": "Black Screen",
            "text": "「…就是你让『幽光素』混进来的吧？」",
            "nextDialogs": [
              "140450666"
            ]
          },
          "140450666": {
            "id": "140450666",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "…结果可恶的人…就只有我自己吗？",
            "nextDialogs": [
              "140450667"
            ]
          },
          "140450667": {
            "id": "140450667",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "…这次给各位添了这么多麻烦，实在抱歉。莎凡娜已经醒过来了，只是…还不太能面对各位。",
            "nextDialogs": [
              "140450668"
            ]
          },
          "140450668": {
            "id": "140450668",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "等明天她再冷静一点，应该就能好好跟大家说话了吧。",
            "nextDialogs": [
              "140450669"
            ]
          },
          "140450669": {
            "id": "140450669",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "既然这样，我就去告诉菲尔曼他们了，不知道这个结果…菲尔曼听了会怎么想。",
            "nextDialogs": [
              "140450670"
            ]
          },
          "140450670": {
            "id": "140450670",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，那我们也明天再来？",
            "nextDialogs": [
              "140450671"
            ]
          },
          "140450671": {
            "id": "140450671",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好的，走吧。",
            "nextDialogs": [
              "140450672"
            ]
          },
          "140450672": {
            "id": "140450672",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "呼…折腾了一天呢，回去得好好补充一下糖分了…",
            "nextDialogs": [
              "140450673"
            ]
          },
          "140450673": {
            "id": "140450673",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还是马卡龙吗？要不要换个口味…",
            "nextDialogs": [
              "140450674"
            ]
          },
          "140450674": {
            "id": "140450674",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "……",
            "nextDialogs": [
              "140450677"
            ]
          },
          "140450677": {
            "id": "140450677",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "#…{NICKNAME}，你知道雪翅雁吗？"
          }
        }
      }
    },
    {

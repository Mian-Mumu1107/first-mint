    {
      "subId": "1404504",
      "subQuestName": "制作第一层蛋糕",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140450401"
        ],
        "dialogs": {
          "140450401": {
            "id": "140450401",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "——时间到！两方选手，请将料理送入后厨。",
            "nextDialogs": [
              "140450402"
            ]
          },
          "140450402": {
            "id": "140450402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…光从外表上看，还真看不出是谁做的呢…",
            "nextDialogs": [
              "140450403"
            ]
          },
          "140450403": {
            "id": "140450403",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "毕竟我们做的都是同一道料理，莎凡娜再怎么说也曾是被我看好的厨师，总不会在外表方面失了水准。",
            "nextDialogs": [
              "140450404"
            ]
          },
          "140450404": {
            "id": "140450404",
            "speakerId": 5092,
            "speakerName": "雷诺德",
            "text": "哦…这份料理相当不错呢！",
            "nextDialogs": [
              "140450405"
            ]
          },
          "140450405": {
            "id": "140450405",
            "speakerId": 5091,
            "speakerName": "爱洛依丝",
            "text": "松软的口感，适宜的甜度…确实是能编进教材的模范！",
            "nextDialogs": [
              "140450406"
            ]
          },
          "140450406": {
            "id": "140450406",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "…哼。",
            "nextDialogs": [
              "140450407"
            ]
          },
          "140450407": {
            "id": "140450407",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "嗯…如果用十分制来打分…那至少得有九点九分吧！",
            "nextDialogs": [
              "140450408"
            ]
          },
          "140450408": {
            "id": "140450408",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "…就是蛋糕胚的味道，跟从前比起来总感觉变了一点点…",
            "nextDialogs": [
              "140450409"
            ]
          },
          "140450409": {
            "id": "140450409",
            "speakerId": 5092,
            "speakerName": "雷诺德",
            "text": "欸？是吗？我都没尝出来！",
            "nextDialogs": [
              "140450410"
            ]
          },
          "140450410": {
            "id": "140450410",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "…啧！",
            "nextDialogs": [
              "140450411"
            ]
          },
          "140450411": {
            "id": "140450411",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "哈哈，来试试第二份吧！嗯…还没入口就能闻到完美的清香呢！",
            "nextDialogs": [
              "140450412"
            ]
          },
          "140450412": {
            "id": "140450412",
            "speakerId": 5091,
            "speakerName": "爱洛依丝",
            "text": "我有预感，这绝对是一份能送进博物馆的作品！",
            "nextDialogs": [
              "140450413"
            ]
          },
          "140450413": {
            "id": "140450413",
            "speakerId": 5092,
            "speakerName": "雷诺德",
            "text": "这么厉害？——那我就开动啦！",
            "nextDialogs": [
              "140450414"
            ]
          },
          "140450414": {
            "id": "140450414",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "欸…",
            "nextDialogs": [
              "140450415"
            ]
          },
          "140450415": {
            "id": "140450415",
            "speakerId": 5091,
            "speakerName": "爱洛依丝",
            "text": "咦…",
            "nextDialogs": [
              "140450416"
            ]
          },
          "140450416": {
            "id": "140450416",
            "speakerId": 5092,
            "speakerName": "雷诺德",
            "text": "唔…这糖霜…是不是放得太多了？",
            "nextDialogs": [
              "140450417"
            ]
          },
          "140450417": {
            "id": "140450417",
            "speakerId": 5091,
            "speakerName": "爱洛依丝",
            "text": "调味也完全失衡了…到底是谁端上来的！",
            "nextDialogs": [
              "140450418"
            ]
          },
          "140450418": {
            "id": "140450418",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "唉…看起来各位评委都已经做出了选择。我们一致认为，这份作品，实在是有失水准。",
            "nextDialogs": [
              "140450419"
            ]
          },
          "140450419": {
            "id": "140450419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…我还以为她有多厉害呢，原来就只有这点水平！",
            "nextDialogs": [
              "140450422"
            ]
          },
          "140450422": {
            "id": "140450422",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "…不太对劲，她再怎么失误，也不至于这样…",
            "nextDialogs": [
              "140450423"
            ]
          },
          "140450423": {
            "id": "140450423",
            "speakerId": 5089,
            "speakerName": "瓦纳格姆",
            "text": "那么获胜的一方，就是第一份作品了。现在就来揭晓，这份餐盘底下…",
            "nextDialogs": [
              "140450424"
            ]
          },
          "140450424": {
            "id": "140450424",
            "speakerId": 5092,
            "speakerName": "雷诺德",
            "text": "——是、是莎凡娜的标记？！",
            "nextDialogs": [
              "140450425"
            ]
          },
          "140450425": {
            "id": "140450425",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "怎么可能——！？",
            "nextDialogs": [
              "140450426"
            ]
          },
          "140450426": {
            "id": "140450426",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "哼。",
            "nextDialogs": [
              "140450427"
            ]
          },
          "140450427": {
            "id": "140450427",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂——莎凡娜！你这家伙，是作弊了吧！",
            "nextDialogs": [
              "140450428"
            ]
          },
          "140450428": {
            "id": "140450428",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一定是你动的手脚！是…是不是你偷偷调换了盘子！",
            "nextDialogs": [
              "140450429"
            ]
          },
          "140450429": {
            "id": "140450429",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "哼，输不起就想耍赖吗？在场所有人可都看见了，从蛋糕出炉到上桌，我可连碰都没碰。",
            "nextDialogs": [
              "140450430"
            ]
          },
          "140450430": {
            "id": "140450430",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "在后厨做标记的人也都是瓦纳格姆安排的，要怎么怀疑也怀疑不到我头上吧？",
            "nextDialogs": [
              "140450431"
            ]
          },
          "140450431": {
            "id": "140450431",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "说不定，是爱可菲手生了？又或者是你们拖后腿了？",
            "nextDialogs": [
              "140450432"
            ]
          },
          "140450432": {
            "id": "140450432",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你…！",
            "nextDialogs": [
              "140450433"
            ]
          },
          "140450433": {
            "id": "140450433",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "裁判！我们要求重赛！",
            "nextDialogs": [
              "140450434"
            ]
          },
          "140450434": {
            "id": "140450434",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "……",
            "nextDialogs": [
              "140450435"
            ]
          },
          "140450435": {
            "id": "140450435",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "够了…不用再说了。",
            "nextDialogs": [
              "140450436"
            ]
          },
          "140450436": {
            "id": "140450436",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "不管是哪个环节出了问题，身为主厨…不，身为领队的我都有失察的责任。",
            "nextDialogs": [
              "140450437"
            ]
          },
          "140450437": {
            "id": "140450437",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "莎凡娜…没想到，为了赢过我，你居然不惜做到这个地步…连厨师的自尊都忘了吗？",
            "nextDialogs": [
              "140450438"
            ]
          },
          "140450438": {
            "id": "140450438",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "…我可不知道你在说什么！",
            "nextDialogs": [
              "140450439"
            ]
          },
          "140450439": {
            "id": "140450439",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "既然你那么想要《德波大秘典》，那我可以给你。",
            "nextDialogs": [
              "140450440"
            ]
          },
          "140450440": {
            "id": "140450440",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "…爱可菲！",
            "nextDialogs": [
              "140450441"
            ]
          },
          "140450441": {
            "id": "140450441",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "——但你必须答应我，去向菲尔曼赔偿道歉！",
            "nextDialogs": [
              "140450442"
            ]
          },
          "140450442": {
            "id": "140450442",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "你怎么还是这副口气…这场对决是我赢了吧？秘典原本也已经是我的了，凭什么要答应你！",
            "nextDialogs": [
              "140450443"
            ]
          },
          "140450443": {
            "id": "140450443",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "莎凡娜，一场胜负骗得了别人，难道还能骗得了你自己吗？我可以不追究你都干了什么…",
            "nextDialogs": [
              "140450444"
            ]
          },
          "140450444": {
            "id": "140450444",
            "speakerId": 15196,
            "speakerName": "莫妮卡",
            "text": "……！",
            "nextDialogs": [
              "140450445"
            ]
          },
          "140450445": {
            "id": "140450445",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "…但你必须答应我，以后别再给他们这么大的压力了。",
            "nextDialogs": [
              "140450446"
            ]
          },
          "140450446": {
            "id": "140450446",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "…哼，行吧，就当这是前主厨，交接下来的工作了。",
            "nextDialogs": [
              "140450447"
            ]
          },
          "140450447": {
            "id": "140450447",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "你要交代的事就只有这些了吗？前主厨？",
            "nextDialogs": [
              "140450448"
            ]
          },
          "140450448": {
            "id": "140450448",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "这不是我作为前主厨的批评，只是作为一个厨师兼一个朋友的建议。",
            "nextDialogs": [
              "140450449"
            ]
          },
          "140450449": {
            "id": "140450449",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "虽然不知道现在的你，还能不能听得进去。",
            "nextDialogs": [
              "140450450"
            ]
          },
          "140450450": {
            "id": "140450450",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "我知道自己在做什么…不需要你来关心！",
            "nextDialogs": [
              "140450451"
            ]
          },
          "140450451": {
            "id": "140450451",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "是吗？那最好。",
            "nextDialogs": [
              "140450452"
            ]
          },
          "140450452": {
            "id": "140450452",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…爱可菲！",
            "nextDialogs": [
              "140450453"
            ]
          },
          "140450453": {
            "id": "140450453",
            "speakerId": 15195,
            "speakerName": "莎凡娜",
            "text": "《德波大秘典》！这一次…一定能成功！",
            "nextDialogs": [
              "140450454"
            ]
          },
          "140450454": {
            "id": "140450454",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "爱可菲！怎么能让她就这么得逞？",
            "nextDialogs": [
              "140450455"
            ]
          },
          "140450455": {
            "id": "140450455",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是啊！那本秘典…明明是珍贵的纪念品吧？",
            "nextDialogs": [
              "140450456"
            ]
          },
          "140450456": {
            "id": "140450456",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "…没事的，一场胜负而已，我又不在乎。",
            "nextDialogs": [
              "140450457"
            ]
          },
          "140450457": {
            "id": "140450457",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "况且结果又不坏，她不是答应要补偿菲尔曼了吗？那刺玫会的委托也算解决了吧。",
            "nextDialogs": [
              "140450458"
            ]
          },
          "140450458": {
            "id": "140450458",
            "speakerId": 1308,
            "speakerName": "爱可菲",
            "text": "倒不如说，早知道简简单单把原本送出去就能解决问题，还搞什么料理对决？真是小题大做！"
          }
        }
      }
    },

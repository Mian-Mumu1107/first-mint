    {
      "subId": "7620103",
      "subQuestName": "采集宿影花",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762010301"
        ],
        "dialogs": {
          "762010301": {
            "id": "762010301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（附近似乎有些值得调查的，如果是对本地生态十分了解的<color=#FFCC33FF>莉奈娅</color>，或许会有所收获…）"
          }
        }
      }
    },
    {
      "subId": "7620104",
      "subQuestName": "与维萨对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762010201"
        ],
        "dialogs": {
          "762010201": {
            "id": "762010201",
            "speakerId": 1001,
            "speakerName": "维萨",
            "text": "…梅妲姐姐坏心眼，我只是想让你在冒险途中玩得开心，干嘛要说这种扫兴的话，呜…",
            "nextDialogs": [
              "762010202"
            ]
          },
          "762010202": {
            "id": "762010202",
            "speakerId": 1002,
            "speakerName": "梅妲",
            "text": "你要是不改改你那想起一出是一出的毛病，其他人也会受不了你的。",
            "nextDialogs": [
              "762010203"
            ]
          },
          "762010203": {
            "id": "762010203",
            "speakerId": 1001,
            "speakerName": "维萨",
            "text": "那才不是想起一出是一出，我、我也是有自己的打算的…",
            "nextDialogs": [
              "762010204"
            ]
          },
          "762010204": {
            "id": "762010204",
            "speakerId": 1002,
            "speakerName": "梅妲",
            "text": "打算啊…嗯。",
            "nextDialogs": [
              "762010205"
            ]
          },
          "762010205": {
            "id": "762010205",
            "speakerId": 1001,
            "speakerName": "维萨",
            "text": "又这么敷衍我…我再也不和你说话了，到时就算你后悔也没用！",
            "nextDialogs": [
              "762010206"
            ]
          },
          "762010206": {
            "id": "762010206",
            "speakerId": 1001,
            "speakerName": "维萨",
            "text": "…啊，莉奈娅姐姐！你听我说，梅妲姐姐她——",
            "nextDialogs": [
              "762010207"
            ]
          },
          "762010207": {
            "id": "762010207",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "听维萨磕磕绊绊地讲述了此前发生的事，似乎只是孩子间常见的小矛盾…",
            "nextDialogs": [
              "762010208"
            ]
          },
          "762010208": {
            "id": "762010208",
            "speakerId": 1002,
            "speakerName": "梅妲",
            "text": "不管怎么想错的都不是我吧。",
            "nextDialogs": [
              "762010209"
            ]
          },
          "762010209": {
            "id": "762010209",
            "speakerId": 1001,
            "speakerName": "维萨",
            "text": "那我、我也没错啊！莉奈娅姐姐…",
            "nextDialogs": [
              "762010210"
            ]
          },
          "762010210": {
            "id": "762010210",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "唔——有时候的确会发生这样的事呢，明明大家都没错，但结果却不尽如人意。",
            "nextDialogs": [
              "762010211"
            ]
          },
          "762010211": {
            "id": "762010211",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "对了，就像宿影花代表的霜月之子姐妹的故事。",
            "nextDialogs": [
              "762010212"
            ]
          },
          "762010212": {
            "id": "762010212",
            "speakerId": 1001,
            "speakerName": "维萨",
            "text": "姐妹的故事？",
            "nextDialogs": [
              "762010213"
            ]
          },
          "762010213": {
            "id": "762010213",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "嗯，据说曾经有一对霜月之子的姐妹，她们性格迥异，就像宿影花一红一蓝。",
            "nextDialogs": [
              "762010214"
            ]
          },
          "762010214": {
            "id": "762010214",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "姐妹二人都做了自己认为正确的事，但也正因为这样而分道扬镳。",
            "nextDialogs": [
              "762010215"
            ]
          },
          "762010215": {
            "id": "762010215",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "据说妹妹一直都没有原谅弃自己而去的姐姐，尽管姐姐在那之后拯救了许多人的生命…但最终，两人到死也未能再见上一面。",
            "nextDialogs": [
              "762010216"
            ]
          },
          "762010216": {
            "id": "762010216",
            "speakerId": 1002,
            "speakerName": "梅妲",
            "text": "霜月之子还有这样的故事…从来没听过。",
            "nextDialogs": [
              "762010217"
            ]
          },
          "762010217": {
            "id": "762010217",
            "speakerId": 1001,
            "speakerName": "维萨",
            "text": "我也没有。",
            "nextDialogs": [
              "762010218"
            ]
          },
          "762010218": {
            "id": "762010218",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "我也是听吟游诗人讲的，或许有演绎的成分…",
            "nextDialogs": [
              "762010219"
            ]
          },
          "762010219": {
            "id": "762010219",
            "speakerId": 1002,
            "speakerName": "梅妲",
            "text": "哦，原来是编造的故事。",
            "nextDialogs": [
              "762010220"
            ]
          },
          "762010220": {
            "id": "762010220",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "哎呀，就算故事可能是假的，但道理总归是没错的吧？",
            "nextDialogs": [
              "762010221"
            ]
          },
          "762010221": {
            "id": "762010221",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "她们谁也不认为自己有错，都坚信自己的选择才是正确的，但她们的选择也让她们永远失去了彼此。",
            "nextDialogs": [
              "762010222"
            ]
          },
          "762010222": {
            "id": "762010222",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "如果为了证明自己是对的，必须以失去朋友为代价…你们会怎么选呢？",
            "nextDialogs": [
              "762010223"
            ]
          },
          "762010223": {
            "id": "762010223",
            "speakerId": 1001,
            "speakerName": "维萨",
            "text": "……",
            "nextDialogs": [
              "762010224"
            ]
          },
          "762010224": {
            "id": "762010224",
            "speakerId": 1002,
            "speakerName": "梅妲",
            "text": "……",
            "nextDialogs": [
              "762010225"
            ]
          },
          "762010225": {
            "id": "762010225",
            "speakerId": 1002,
            "speakerName": "梅妲",
            "text": "唉，其实冒险途中偶尔有些临时起意的小插曲也不赖。",
            "nextDialogs": [
              "762010226"
            ]
          },
          "762010226": {
            "id": "762010226",
            "speakerId": 1001,
            "speakerName": "维萨",
            "text": "…嗯！仔细想想，梅妲姐姐能陪我冒险的时间也很宝贵，要是想法变来变去，可能最后什么都没玩到…",
            "nextDialogs": [
              "762010227"
            ]
          },
          "762010227": {
            "id": "762010227",
            "speakerId": 1001,
            "speakerName": "维萨",
            "text": "下次…下次我会计划得更好的！",
            "nextDialogs": [
              "762010228"
            ]
          },
          "762010228": {
            "id": "762010228",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "嘿嘿，你们能和好就最好不过了。",
            "nextDialogs": [
              "762010229"
            ]
          },
          "762010229": {
            "id": "762010229",
            "speakerId": 1002,
            "speakerName": "梅妲",
            "text": "之后和维萨去冒险的时候如果捡到什么不常见的石头，我们会送去「斯佩兰扎」的。",
            "nextDialogs": [
              "762010230"
            ]
          },
          "762010230": {
            "id": "762010230",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "好呀！那就先谢谢你们啦。"
          }
        }
      }
    },
    {
      "subId": "7620199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762019901"
        ],
        "dialogs": {
          "762019901": {
            "id": "762019901",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "这里也生长着宿影花啊，采集一些好了。"
          }
        }
      }
    }
  ]
}
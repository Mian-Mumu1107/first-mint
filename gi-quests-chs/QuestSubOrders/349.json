        ],
        "dialogs": {
          "3490101": {
            "id": "3490101",
            "speakerId": 1000,
            "speakerName": "订货板",
            "text": "请将希望进货的商品名写在便条上，贴在订货板上，等待店员留言回应。蒙德百货，尽力满足您的一切需要！",
            "nextDialogs": [
              "3490103"
            ]
          },
          "3490103": {
            "id": "3490103",
            "speakerId": 1001,
            "speakerName": "订货留言",
            "text": "「早些年冒险的时候，经常吃野菇鸡肉串。最近有些怀念那种朴素的味道，能进一些野菇鸡肉串吗？」",
            "nextDialogs": [
              "3490104"
            ]
          },
          "3490104": {
            "id": "3490104",
            "speakerId": 1002,
            "speakerName": "回应",
            "text": "您好，这个没有呢。请去敝店对面的「猎鹿人」看看吧。不好意思。"
          }
        }
      }
    },
    {

            ]
          },
          "3490303": {
            "id": "3490303",
            "speakerId": 1001,
            "speakerName": "订货留言",
            "text": "「看见骑士团有个小姑娘带着很可爱的兔子布偶，想买一个送给女朋友。」",
            "nextDialogs": [
              "3490304"
            ]
          },
          "3490304": {
            "id": "3490304",
            "speakerId": 1002,
            "speakerName": "回应",
            "text": "您好，这个没有呢。送给重要的人的礼物要亲手制作，如果想要简单买到的话，只能说明您还不够爱她。不好意思。"
          }
        }
      }
    },

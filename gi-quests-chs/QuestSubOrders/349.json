    {
      "subId": "34912",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3491201"
        ],
        "dialogs": {
          "3491201": {
            "id": "3491201",
            "speakerId": 1000,
            "speakerName": "订货板",
            "text": "请将希望进货的商品名写在便条上，贴在订货板上，等待店员留言回应。蒙德百货，尽力满足您的一切需要！",
            "nextDialogs": [
              "3491203"
            ]
          },
          "3491203": {
            "id": "3491203",
            "speakerId": 1001,
            "speakerName": "订货留言",
            "text": "「之前看了一本叫《碎梦奇珍》的小说，还挺有趣的。里面提到了一家奇妙的杂货店，请问书里的店和贵店有关系吗？这么一想，布兰琪小姐似乎变得神通广大了呢！」",
            "nextDialogs": [
              "3491204"
            ]
          },
          "3491204": {
            "id": "3491204",
            "speakerId": 1002,
            "speakerName": "回应",
            "text": "您好，请不要混淆虚构与现实。谢谢。",
            "nextDialogs": [
              "3491205"
            ]
          },
          "3491205": {
            "id": "3491205",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "唔，好严厉呀…"
          }

  "subQuests": [
    {
      "subId": "7516601",
      "subQuestName": "进入火山底的巨大空间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751660101"
        ],
        "dialogs": {
          "751660101": {
            "id": "751660101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…没想到火山底下还有这么大的空间！",
            "nextDialogs": [
              "751660102"
            ]
          },
          "751660102": {
            "id": "751660102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且，根本全都是深渊嘛…仔细一想，上面原本遮住入口的深渊说不定就是从这里爬出来的…",
            "nextDialogs": [
              "751660103"
            ]
          },
          "751660103": {
            "id": "751660103",
            "speakerId": 1001,
            "speakerName": "（test）龙铭刻",
            "text": "受龙所选者啊，流炎的力量已加诸你身——",
            "nextDialogs": [
              "751660104"
            ]
          },
          "751660104": {
            "id": "751660104",
            "speakerId": 1001,
            "speakerName": "（test）龙铭刻",
            "text": "去清除，阴影之大敌吧！",
            "nextDialogs": [
              "751660105"
            ]
          },
          "751660105": {
            "id": "751660105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢噢，虽然不知道为什么，全身上下有暖洋洋的力量…",
            "nextDialogs": [
              "751660106"
            ]
          },
          "751660106": {
            "id": "751660106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过是个好机会，就在这里把入侵的深渊一网打尽吧！",
            "nextDialogs": [
              "751660107"
            ]
          },
          "751660107": {
            "id": "751660107",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！"
          }
        }
      }
    },

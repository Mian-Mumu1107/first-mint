  },
  "subQuests": [
    {
      "subId": "7002501",
      "subQuestName": "向冒险家协会回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700250101"
        ],
        "dialogs": {
          "700250101": {
            "id": "700250101",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "您好，冒险家！关于委托的完成情况我都已经了解了，感谢您为冒险家协会的付出！这里是您应得的报酬。",
            "nextDialogs": [
              "700250102"
            ]
          },
          "700250102": {
            "id": "700250102",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "虽然没能捕获那个奇怪的丘丘人，也没能找到这次骚乱的原因…但野外的安全至少得到了保障，辛苦您了。",
            "nextDialogs": [
              "700250103"
            ]
          },
          "700250103": {
            "id": "700250103",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "顺便一提，艾拉·马斯克小姐在图书馆等您。"
          }
        }
      }
    },
    {
      "subId": "7002502",
      "subQuestName": "与艾拉·马斯克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700250201"
        ],
        "dialogs": {
          "700250201": {
            "id": "700250201",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "Homu…mimi tomo…唔…",
            "nextDialogs": [
              "700250202"
            ]
          },
          "700250202": {
            "id": "700250202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你好？",
            "nextDialogs": [
              "700250203"
            ]
          },
          "700250203": {
            "id": "700250203",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "Ya ika！！啊…是你们啊…吓我一跳…请不要打扰我。",
            "nextDialogs": [
              "700250204"
            ]
          },
          "700250204": {
            "id": "700250204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，不是你叫我们来的吗？",
            "nextDialogs": [
              "700250212"
            ]
          },
          "700250212": {
            "id": "700250212",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "嗯？哦哦…是你们啊！多谢你们的帮助。",
            "nextDialogs": [
              "700250205"
            ]
          },
          "700250205": {
            "id": "700250205",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "不过手册中的内容准确吗？能够用来与丘丘人和平交流吗？",
            "nextDialogs": [
              "700250208"
            ]
          },
          "700250208": {
            "id": "700250208",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "哼哼，我的词典工作又前进了一大步！人类能与丘丘人和平共存的论据又增加了！",
            "nextDialogs": [
              "700250209"
            ]
          },
          "700250209": {
            "id": "700250209",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "只可惜没能和那个奇怪的丘丘人搭上话…",
            "nextDialogs": [
              "700250210"
            ]
          },
          "700250210": {
            "id": "700250210",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "从我收集的语料来看，或许它也只是很想在这片陌生的大地上结交新朋友吧。",
            "nextDialogs": [
              "700250213"
            ]
          },
          "700250213": {
            "id": "700250213",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "没能好好交流，真是遗憾。",
            "nextDialogs": [
              "700250214"
            ]
          },
          "700250214": {
            "id": "700250214",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "啊，顺便，这里是给你的谢礼。",
            "nextDialogs": [
              "700250215"
            ]
          },
          "700250215": {
            "id": "700250215",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "先前麻烦了你们那么多，实在不好意思。有机会还希望能够一起合作。",
            "nextDialogs": [
              "700250211"
            ]
          },
          "700250211": {
            "id": "700250211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么嘛，原来这家伙还是会好好说话的…"
          }
        }
      }
    }
  ]
}
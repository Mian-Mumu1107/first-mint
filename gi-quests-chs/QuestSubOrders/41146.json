    },
    {
      "subId": "4114601",
      "subQuestName": "与莎拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411460101"
        ],
        "dialogs": {
          "411460101": {
            "id": "411460101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我这就送过去。",
            "nextDialogs": [
              "411460102"
            ]
          },
          "411460102": {
            "id": "411460102",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "那就拜托你啦，那地方太远了，我们实在是分不出人手来了。",
            "nextDialogs": [
              "411460103"
            ]
          },
          "411460103": {
            "id": "411460103",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "对了，送的时候千万小心，<color=#00E1FFFF>不要跑得太快，也不要用风之翼，更不要去爬山什么的…</color>",
            "nextDialogs": [
              "411460104"
            ]
          },
          "411460104": {
            "id": "411460104",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "要是路上被撞了一下，肉酱和面说不定就会完全分开了…那样的话，客人肯定不会收下这份餐的。"
          }
        }
      }
    },
    {
      "subId": "4114602",
      "subQuestName": "将餐品送给偷懒的安杰洛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411460201"
        ],
        "dialogs": {
          "411460201": {
            "id": "411460201",
            "speakerId": 1001,
            "speakerName": "偷懒的安杰洛",
            "text": "好不容易找到了这么个舒服的地方…我订的餐怎么还没送来…"
          }
        }
      }
    },
    {
      "subId": "4114603",
      "subQuestName": "与偷懒的安杰洛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411460601"
        ],
        "dialogs": {
          "411460601": {
            "id": "411460601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是您订的餐。",
            "nextDialogs": [
              "411460602"
            ]
          },
          "411460602": {
            "id": "411460602",
            "speakerId": 1001,
            "speakerName": "偷懒的安杰洛",
            "text": "总算送到了，再等一会我就要睡着了。",
            "nextDialogs": [
              "411460603"
            ]
          },
          "411460603": {
            "id": "411460603",
            "speakerId": 1001,
            "speakerName": "偷懒的安杰洛",
            "text": "谢谢你啊，这道菜我就收下了。"
          }
        }
      }
    },
    {
      "subId": "4114603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411460301"
        ],
        "dialogs": {
          "411460301": {
            "id": "411460301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听说有特别订单…",
            "nextDialogs": [
              "411460302"
            ]
          },
          "411460302": {
            "id": "411460302",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "对，那个…安杰洛先生在我们这订了一份火火肉酱面，钱已经付好了。",
            "nextDialogs": [
              "411460303"
            ]
          },
          "411460303": {
            "id": "411460303",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "然后他让我们晚些时候送去明冠峡附近的一个地方，那个地方还挺远的，我正愁没人有空能送过去…",
            "nextDialogs": [
              "411460304"
            ]
          },
          "411460304": {
            "id": "411460304",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "如果你愿意帮忙的话，就把这份餐给送过去吧。"
          }
        }
      }
    },

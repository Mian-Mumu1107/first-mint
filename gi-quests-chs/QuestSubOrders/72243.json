  "subQuests": [
    {
      "subId": "7224301",
      "subQuestName": "(test)找玛乔丽对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722430101"
        ],
        "dialogs": {
          "722430101": {
            "id": "722430101",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "欢迎光临，旅行者。需要些什么吗？",
            "nextDialogs": [
              "722430102"
            ]
          },
          "722430102": {
            "id": "722430102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我有宝物想要出售。",
            "nextDialogs": [
              "722430103"
            ]
          },
          "722430103": {
            "id": "722430103",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "出售宝物？真是令人意外。",
            "nextDialogs": [
              "722430104"
            ]
          },
          "722430104": {
            "id": "722430104",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "像您这样强大的冒险家，想要出售的东西一定很罕见吧？",
            "nextDialogs": [
              "722430105"
            ]
          },
          "722430105": {
            "id": "722430105",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "快请让我看看。",
            "nextDialogs": [
              "722430106"
            ]
          },
          "722430106": {
            "id": "722430106",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "将龙骨花凝珠的故事告诉了玛乔丽。",
            "nextDialogs": [
              "722430107"
            ]
          },
          "722430107": {
            "id": "722430107",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "啊，这不是就像是吟游诗人的故事里说的忘忧果吗？",
            "nextDialogs": [
              "722430108"
            ]
          },
          "722430108": {
            "id": "722430108",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "居然真的有这种东西存在吗…原来它叫龙骨花凝珠。",
            "nextDialogs": [
              "722430109"
            ]
          },
          "722430109": {
            "id": "722430109",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "如果它的效果真的和您所说的一样，我愿意花80000摩拉加一些特色料理买下它。",
            "nextDialogs": [
              "722430110"
            ]
          },
          "722430110": {
            "id": "722430110",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "嗯…80000摩拉加上5个月亮派，您觉得怎么样？",
            "nextDialogs": [
              "722430112",
              "722430115",
              "722430121"
            ]
          },
          "722430112": {
            "id": "722430112",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "嘻嘻，多么独特的宝物呀。",
            "nextDialogs": [
              "722430113"
            ]
          },
          "722430113": {
            "id": "722430113",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "童话一般的神奇功效，我相信那些炼金术士们不会吝惜自己的钱包。"
          },
          "722430115": {
            "id": "722430115",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "那我就收下这件宝物了，多谢惠顾。",
            "nextDialogs": [
              "722430116"
            ]
          },
          "722430116": {
            "id": "722430116",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "对了，通常来说，这种凝珠类的物品会在风中缓慢挥发。",
            "nextDialogs": [
              "722430117"
            ]
          },
          "722430117": {
            "id": "722430117",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "所以，最好将它覆上隔膜或者放进容器密封起来，这样成色会更好。",
            "nextDialogs": [
              "722430118"
            ]
          },
          "722430118": {
            "id": "722430118",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "这是一点附送您的小技巧，希望对您的冒险有帮助。",
            "nextDialogs": [
              "722430119"
            ]
          },
          "722430119": {
            "id": "722430119",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "如果今后您又找到了类似的宝物，别忘了，这儿有您忠实的买家。"
          },
          "722430121": {
            "id": "722430121",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "哈哈，没问题，但是我相信我的价格是最合适的。",
            "nextDialogs": [
              "722430122"
            ]
          },
          "722430122": {
            "id": "722430122",
            "speakerId": 10005,
            "speakerName": "玛乔丽",
            "text": "如果您考虑好了，可以再来找我。"
          }
        }
      }
    },

      }
    },
    {
      "subId": "7721306",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772130701"
        ],
        "dialogs": {
          "772130701": {
            "id": "772130701",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "了不起，看来你天赋异禀，继续修炼下去，总有一天一定能够成为「烈泉道」大师的。",
            "nextDialogs": [
              "772130702"
            ]
          },
          "772130702": {
            "id": "772130702",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "嗯嗯…对了，赢得了比赛就得有奖励，好，这些给你们吧！",
            "nextDialogs": [
              "772130703"
            ]
          },
          "772130703": {
            "id": "772130703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，那我们就收下啦。",
            "nextDialogs": [
              "772130704"
            ]
          },
          "772130704": {
            "id": "772130704",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "你们如今越过了「温水不冷」和「凉水不冷」的境界…说不定马上就能到「冰水不冷」的位阶了。",
            "nextDialogs": [
              "772130705"
            ]
          },
          "772130705": {
            "id": "772130705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个「冰水不冷」听上去也没什么了不起的嘛…",
            "nextDialogs": [
              "772130706"
            ]
          },
          "772130706": {
            "id": "772130706",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "怎么能这样说，这可是故事的主角修炼到轻小说第八卷才达到的境界，很了不起呢。",
            "nextDialogs": [
              "772130707"
            ]
          },
          "772130707": {
            "id": "772130707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是轻小说啊！"
          }
        }
      }
    },
    {

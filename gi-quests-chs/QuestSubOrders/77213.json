        "dialogs": {
          "772130901": {
            "id": "772130901",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "呼呼…刚从冰水里上岸还是有点冷…",
            "nextDialogs": [
              "772130902"
            ]
          },
          "772130902": {
            "id": "772130902",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "呃，甜菜汤，再煮点甜菜汤喝好了！"
          }
        }
      }
    }

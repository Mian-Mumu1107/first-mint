  "subQuests": [
    {
      "subId": "7721301",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772130101"
        ],
        "dialogs": {
          "772130101": {
            "id": "772130101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "热身准备已经做好了！看看今天能够坚持多久…",
            "nextDialogs": [
              "772130102"
            ]
          },
          "772130102": {
            "id": "772130102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，纳塔人，你在这里做什么？",
            "nextDialogs": [
              "772130103"
            ]
          },
          "772130103": {
            "id": "772130103",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "嗯？我叫赛路吉，是在…锤炼自己的身躯，通过将身躯浸透入极寒的水中。",
            "nextDialogs": [
              "772130104"
            ]
          },
          "772130104": {
            "id": "772130104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这、这样不会被冻伤吗？",
            "nextDialogs": [
              "772130105"
            ]
          },
          "772130105": {
            "id": "772130105",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "嘿嘿，像小家伙你这样瘦胳膊瘦腿当然还是会被冻伤的。",
            "nextDialogs": [
              "772130106"
            ]
          },
          "772130106": {
            "id": "772130106",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "不过经过修炼的战士，即便是如此冰冷的水，也可用体内的热血将之变成温泉，甚至是灼烫之河！",
            "nextDialogs": [
              "772130109"
            ]
          },
          "772130109": {
            "id": "772130109",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "呵呵，此等修炼方法所带来的功效，只要一试便知。有天赋的人只要如此锻炼过一次，很快就能掌握「烈泉之道」！",
            "nextDialogs": [
              "772130110"
            ]
          },
          "772130110": {
            "id": "772130110",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "据说「烈泉之道」上甚至还有「熔岩之道」，到了那时，对手甚至在靠近出手之前，就会因体内血液的蒸发而倒下…",
            "nextDialogs": [
              "772130111"
            ]
          },
          "772130111": {
            "id": "772130111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喔，听上去确实好厉害！",
            "nextDialogs": [
              "772130112"
            ]
          },
          "772130112": {
            "id": "772130112",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "不过修炼毕竟枯燥…我们不如，让我想想…",
            "nextDialogs": [
              "772130113"
            ]
          },
          "772130113": {
            "id": "772130113",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "不如这样，我们就比较一下谁能在冰河之中忍耐更久的时间吧！这就是所谓的「耐寒比赛」！",
            "nextDialogs": [
              "772130114"
            ]
          },
          "772130114": {
            "id": "772130114",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "规则很简单，你我都坐在河中的椅子上，谁先忍受不住起身，谁就输了。",
            "nextDialogs": [
              "772130115"
            ]
          },
          "772130115": {
            "id": "772130115",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "一想到能在此处与人比试，内心的一角也不禁沸腾了起来啊。"
          }
        }
      }
    },
    {
      "subId": "7721308",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772130801"
        ],
        "dialogs": {
          "772130801": {
            "id": "772130801",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "如果要开始的话…就在冰河中的椅子上坐下吧！"
          }
        }
      }
    },
    {
      "subId": "7721302",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7721303",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772130301"
        ],
        "dialogs": {
          "772130301": {
            "id": "772130301",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "唔啊…真是了不起，我冻得感觉脚趾都被水流冲走了，你居然还如浴春风，面不改色。",
            "nextDialogs": [
              "772130302"
            ]
          },
          "772130302": {
            "id": "772130302",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "真是可怕，难道你们有什么特殊的御寒秘籍吗…",
            "nextDialogs": [
              "772130303"
            ]
          },
          "772130303": {
            "id": "772130303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这倒是没有啦…不过我们有「眼镜」，呃…就是能够保持体表温度的道具。",
            "nextDialogs": [
              "772130304"
            ]
          },
          "772130304": {
            "id": "772130304",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "…什、什么呀，居然是靠道具。",
            "nextDialogs": [
              "772130305"
            ]
          },
          "772130305": {
            "id": "772130305",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "倒也没有说靠道具不好的意思啦，我有的时候也会在下水前喝热的甜菜汤，暖呼呼的也能稍微御寒。",
            "nextDialogs": [
              "772130306"
            ]
          },
          "772130306": {
            "id": "772130306",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "但是用那种特别厉害的道具总觉得不是自己真实实力…呜，我承认自己有不甘心的成分啦…",
            "nextDialogs": [
              "772130307"
            ]
          },
          "772130307": {
            "id": "772130307",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "待会儿卸掉那个什么「眼镜」，再来和我比试一场吧…"
          }
        }
      }
    },
    {
      "subId": "7721304",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772130401"
        ],
        "dialogs": {
          "772130401": {
            "id": "772130401",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "再来和我比试一场吧，只要坐在椅子上，比赛就开始！不要用那什么「眼镜」！"
          }
        }
      }
    },
    {
      "subId": "7721305",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772130501"
        ],
        "dialogs": {
          "772130501": {
            "id": "772130501",
            "speakerId": 22504,
            "speakerName": "赛路吉",
            "text": "想要再比试一场吗？只要坐在椅子上，比赛就开始…不许用那什么「眼镜」哦！"
          }
        }
      }
    },
    {
      "subId": "7721309",
      "subQuestName": "(test)第二轮失败后对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772131001"
        ],
        "dialogs": {
          "772131001": {
            "id": "772131001",

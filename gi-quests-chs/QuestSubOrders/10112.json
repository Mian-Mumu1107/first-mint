    {
      "subId": "1011205",
      "subQuestName": "寻找光耀意志之盾",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1011206",
      "subQuestName": "与丘丘人交涉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101120601"
        ],
        "dialogs": {
          "101120601": {
            "id": "101120601",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "看，<color=#00E1FFFF>「光耀意志之盾」</color>！",
            "nextDialogs": [
              "101120602"
            ]
          },
          "101120602": {
            "id": "101120602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "骗人！那根本就是块普通木板吧！",
            "nextDialogs": [
              "101120603"
            ]
          },
          "101120603": {
            "id": "101120603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "破破烂烂的，还带着桶箍！谁会把这种东西当成盾牌啊？",
            "nextDialogs": [
              "101120604"
            ]
          },
          "101120604": {
            "id": "101120604",
            "speakerId": 1413,
            "speakerName": "杰克",
            "text": "而且上面还有酒渍…像是从酒桶上随便拆下来的…",
            "nextDialogs": [
              "101120605"
            ]
          },
          "101120605": {
            "id": "101120605",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "可按我吟游诗人的直觉，这就是「光耀意志之盾」。",
            "nextDialogs": [
              "101120606"
            ]
          },
          "101120606": {
            "id": "101120606",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "战士以身上的疤痕为荣，盾牌也是一样。",
            "nextDialogs": [
              "101120607"
            ]
          },
          "101120607": {
            "id": "101120607",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "一面盾牌越是完整，越说明它远离战场。盾牌的破旧，不正是它身经百战的证明吗？",
            "nextDialogs": [
              "101120608"
            ]
          },
          "101120608": {
            "id": "101120608",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "即使身躯残破，也要在战场上拼杀到最后一刻，要战斗到流干最后一滴血为止。这样的意志，难道不珍贵吗？",
            "nextDialogs": [
              "101120612"
            ]
          },
          "101120612": {
            "id": "101120612",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说得也是…哪有干干净净的盾牌啊…",
            "nextDialogs": [
              "101120613"
            ]
          },
          "101120613": {
            "id": "101120613",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们…想办法问问它，能不能把「光耀意志之盾」转让给我们？",
            "nextDialogs": [
              "101120614"
            ]
          },
          "101120614": {
            "id": "101120614",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好，丘丘人先生？",
            "nextDialogs": [
              "101120615"
            ]
          },
          "101120615": {
            "id": "101120615",
            "speakerId": 10222,
            "speakerName": "丘丘人",
            "text": "Dala？",
            "nextDialogs": [
              "101120616"
            ]
          },
          "101120616": {
            "id": "101120616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哇，{NICKNAME}还是你来吧。试试平时听过的那些丘丘语音节？或者用肢体语言交流吧…"
          }
        }
      }
    },
    {
      "subId": "1011207",
      "subQuestName": "(test)谈判成功$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101120701"
        ],
        "dialogs": {
          "101120701": {
            "id": "101120701",
            "speakerId": 10222,
            "speakerName": "丘丘人",
            "text": "Muhe vin plata? Mani ye! Mani dada!",
            "nextDialogs": [
              "101120702"
            ]
          },
          "101120702": {
            "id": "101120702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶！它把「光耀意志之盾」递过来了！"
          }
        }
      }
    },
    {
      "subId": "1011208",
      "subQuestName": "(test)谈判失败$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101120801"
        ],
        "dialogs": {
          "101120801": {
            "id": "101120801",
            "speakerId": 10222,
            "speakerName": "丘丘人",
            "text": "Yaya ika! Kundala ye plata!",
            "nextDialogs": [
              "101120802"
            ]
          },
          "101120802": {
            "id": "101120802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不好！我们彻底惹恼它了！"
          }
        }
      }
    },
    {
      "subId": "1011213",
      "subQuestName": "(test)谈判失败后的对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

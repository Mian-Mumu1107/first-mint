    {
      "subId": "1011204",
      "subQuestName": "与温迪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101120401"
        ],
        "dialogs": {
          "101120401": {
            "id": "101120401",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "看，<color=#00E1FFFF>「辉煌勇气之剑」</color>！",
            "nextDialogs": [
              "101120402"
            ]
          },
          "101120402": {
            "id": "101120402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不会吧？就是一把超普通的旧剑而已啊！",
            "nextDialogs": [
              "101120403"
            ]
          },
          "101120403": {
            "id": "101120403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "丘丘人为什么要围着这种东西膜拜呢？",
            "nextDialogs": [
              "101120404"
            ]
          },
          "101120404": {
            "id": "101120404",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "（恐怕只是，有人把剑扔进了丘丘人本来就在膜拜的战利品堆里吧…）",
            "nextDialogs": [
              "101120405"
            ]
          },
          "101120405": {
            "id": "101120405",
            "speakerId": 1413,
            "speakerName": "杰克",
            "text": "这、这也太旧了！而且…该怎么说呢，普通到让人说不出话…",
            "nextDialogs": [
              "101120406"
            ]
          },
          "101120406": {
            "id": "101120406",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "不，杰克，你有没有见过蒙德城外飞舞的风晶蝶？",
            "nextDialogs": [
              "101120407"
            ]
          },
          "101120407": {
            "id": "101120407",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这种蝴蝶在白天毫不起眼，到了漆黑的夜晚却会光彩夺目，简直就像是会飞的宝石。",
            "nextDialogs": [
              "101120408"
            ]
          },
          "101120408": {
            "id": "101120408",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "勇气不也是这样吗？一帆风顺的人不会明白它的可贵，可当你身处绝境，勇气就是令你奋起抗争、走出绝境的唯一之光。",
            "nextDialogs": [
              "101120412"
            ]
          },
          "101120412": {
            "id": "101120412",
            "speakerId": 1413,
            "speakerName": "杰克",
            "text": "你、你说得太对了！没错就是这样，这一定就是「辉煌勇气之剑」啊！",
            "nextDialogs": [
              "101120413"
            ]
          },
          "101120413": {
            "id": "101120413",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯，那么，剑已经找到，只差盾了。",
            "nextDialogs": [
              "101120414"
            ]
          },
          "101120414": {
            "id": "101120414",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "在附近转转吧！东西一定就在<color=#00E1FFFF>达达乌帕谷</color>里——嗯？",
            "nextDialogs": [
              "101120415"
            ]
          },
          "101120415": {
            "id": "101120415",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎呀？那边好像有个人！",
            "nextDialogs": [
              "101120416"
            ]
          },
          "101120416": {
            "id": "101120416",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "斯坦利？他怎么在这儿？",
            "nextDialogs": [
              "101120417"
            ]
          },
          "101120417": {
            "id": "101120417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他的样子有点奇怪…",
            "nextDialogs": [
              "101120418"
            ]
          },
          "101120418": {
            "id": "101120418",
            "speakerId": 1413,
            "speakerName": "杰克",
            "text": "出什么事了吗？为什么突然停下？",
            "nextDialogs": [
              "101120419"
            ]
          },
          "101120419": {
            "id": "101120419",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "没什么，刚才有只会撒金币的「盗宝鼬」跑过去了。",
            "nextDialogs": [
              "101120420"
            ]
          },
          "101120420": {
            "id": "101120420",
            "speakerId": 1413,
            "speakerName": "杰克",
            "text": "什么？在哪儿！我也要看！",
            "nextDialogs": [
              "101120421"
            ]
          },
          "101120421": {
            "id": "101120421",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "你不是来找神器的吗？就别看啦。"
          }
        }
      }
    },

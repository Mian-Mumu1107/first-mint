      }
    },
    {
      "subId": "1011209",
      "subQuestName": "击败来袭的丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1011210",
      "subQuestName": "与丘丘人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101121101"
        ],
        "dialogs": {
          "101121101": {
            "id": "101121101",
            "speakerId": 10222,
            "speakerName": "丘丘人",
            "text": "Biadam！",
            "nextDialogs": [
              "101121102"
            ]
          },
          "101121102": {
            "id": "101121102",
            "speakerId": 10222,
            "speakerName": "丘丘人",
            "text": "Yaya ika! Mani ye!",
            "nextDialogs": [
              "101121103"
            ]
          },
          "101121103": {
            "id": "101121103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，它丢下<color=#00E1FFFF>「光耀意志之盾」</color>跑了。"
          }
        }
      }
    },
    {
      "subId": "1011211",
      "subQuestName": "与温迪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101121001"
        ],
        "dialogs": {
          "101121001": {
            "id": "101121001",
            "speakerId": 1413,
            "speakerName": "杰克",
            "text": "谢谢你们，谢谢你们！我找到我要的东西了！",
            "nextDialogs": [
              "101121002"
            ]
          },
          "101121002": {
            "id": "101121002",
            "speakerId": 1413,
            "speakerName": "杰克",
            "text": "爸爸妈妈！看看我找到的神器吧！",
            "nextDialogs": [
              "101121003"
            ]
          },
          "101121003": {
            "id": "101121003",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哎？等等！",
            "nextDialogs": [
              "101121004"
            ]
          },
          "101121004": {
            "id": "101121004",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "说好的酒呢！我帮这么多忙也是很累的吧——",
            "nextDialogs": [
              "101121005"
            ]
          },
          "101121005": {
            "id": "101121005",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯？这不是斯坦利么，你到这里来散步吗。",
            "nextDialogs": [
              "101121006"
            ]
          },
          "101121006": {
            "id": "101121006",
            "speakerId": 1411,
            "speakerName": "斯坦利",
            "text": "啊、啊哈哈哈哈，这不是吟游诗人吗！真巧，你也来这里散步？",
            "nextDialogs": [
              "101121007"
            ]
          },
          "101121007": {
            "id": "101121007",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "是啊，吃完饭出来走走，陪朋友找点东西。",
            "nextDialogs": [
              "101121008"
            ]
          },
          "101121008": {
            "id": "101121008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（我越来越觉得，斯坦利先生可能是骗子了…）",
            "nextDialogs": [
              "101121011"
            ]
          },
          "101121011": {
            "id": "101121011",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（所以斯坦利是为了不伤害杰克的感情，才故意提前一步，到这里布置剑和盾吗？）",
            "nextDialogs": [
              "101121012"
            ]
          },
          "101121012": {
            "id": "101121012",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "大冒险家一定很熟悉达达乌帕谷吧？毕竟，这里是你战斗过的地方。",
            "nextDialogs": [
              "101121013"
            ]
          },
          "101121013": {
            "id": "101121013",
            "speakerId": 1411,
            "speakerName": "斯坦利",
            "text": "当然，当然，我闭着眼睛都能把这里走遍！",
            "nextDialogs": [
              "101121014"
            ]
          },
          "101121014": {
            "id": "101121014",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "原来如此，真佩服你的记性和毅力。",
            "nextDialogs": [
              "101121015"
            ]
          },
          "101121015": {
            "id": "101121015",
            "speakerId": 1411,
            "speakerName": "斯坦利",
            "text": "我是大冒险家嘛，应该的！倒是你们，这里有很多丘丘人，可别掉以轻心啊！",
            "nextDialogs": [
              "101121016"
            ]
          },
          "101121016": {
            "id": "101121016",
            "speakerId": 1411,
            "speakerName": "斯坦利",
            "text": "那、那就再见了，年轻人们。",
            "nextDialogs": [
              "101121017"
            ]
          },
          "101121017": {
            "id": "101121017",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他果然非常心虚啊。",
            "nextDialogs": [
              "101121018"
            ]
          },
          "101121018": {
            "id": "101121018",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "没办法，谁让他对杰克夸下海口了呢。",
            "nextDialogs": [
              "101121019"
            ]
          },
          "101121019": {
            "id": "101121019",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "不过…再看一次，果然有意思。",
            "nextDialogs": [
              "101121020"
            ]
          },
          "101121020": {
            "id": "101121020",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "不愿遗忘「过去」，而抛弃「现在」的人…",
            "nextDialogs": [
              "101121021"
            ]
          },
          "101121021": {
            "id": "101121021",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "如果他被迫迈出「向未来」的第一步，又会踏在什么方向呢？",
            "nextDialogs": [
              "101121022"
            ]
          },
          "101121022": {
            "id": "101121022",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？什么意思？",
            "nextDialogs": [
              "101121023"
            ]
          },
          "101121023": {
            "id": "101121023",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哈哈，自言自语而已。",
            "nextDialogs": [
              "101121024"
            ]
          },
          "101121024": {
            "id": "101121024",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#对了，{NICKNAME}。今晚，我们去<color=#00E1FFFF>「天使的馈赠」</color>看看吧。"
          }
        }
      }
    }
  ]
}
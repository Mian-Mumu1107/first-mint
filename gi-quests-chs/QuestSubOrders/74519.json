        "startDialogs": [
          "745190401"
        ],
        "dialogs": {
          "745190401": {
            "id": "745190401",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "啊…前辈好！是来找琴团长的吗？还是说…有什么需要我帮忙的地方？",
            "nextDialogs": [
              "745190404"
            ]
          },
          "745190404": {
            "id": "745190404",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "我正在对骑士团的办公区域进行例行大扫除。目前灰尘已经基本清理完成，接下来就是整理旧档案了。",
            "nextDialogs": [
              "745190405"
            ]
          },
          "745190405": {
            "id": "745190405",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "那些文件堆积了很久，我想如果能把它们分门别类地归档，大家以后查阅起来就会方便很多。",
            "nextDialogs": [
              "745190406"
            ]
          },
          "745190406": {
            "id": "745190406",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "而且，整理前人的记录，也能学到很多东西。对我来说，这也是一种修行！",
            "nextDialogs": [
              "745190407"
            ]
          },
          "745190407": {
            "id": "745190407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "诺艾尔还是这么认真可靠啊。",
            "nextDialogs": [
              "745190408"
            ]
          },
          "745190408": {
            "id": "745190408",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "这是我应尽的职责。而且，前辈和骑士团的大家都在不断前进，我也想尽快追上你们的步伐。"
          }
        }
      }
    }

    "派蒙": 6,
    "？？？": 16
  },
  "subQuests": [
    {
      "subId": "7223601",
      "subQuestName": "与禁区的残影对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722360101"
        ],
        "dialogs": {
          "722360101": {
            "id": "722360101",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哼，渊下宫最后一天，你们都来了三波人了。",
            "nextDialogs": [
              "722360102"
            ]
          },
          "722360102": {
            "id": "722360102",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "你要是想回收实验记录，那我无可奉告。你让厄伯斯派和珊瑚宫派先吵完架再说这事吧。",
            "nextDialogs": [
              "722360103"
            ]
          },
          "722360103": {
            "id": "722360103",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "我反正站珊瑚宫派。这些实验记录永远埋葬在黑暗里比较好。",
            "nextDialogs": [
              "722360104"
            ]
          },
          "722360104": {
            "id": "722360104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "实验记录…",
            "nextDialogs": [
              "722360105"
            ]
          },
          "722360105": {
            "id": "722360105",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哦？你们不是来回收实验记录的啊。那快点离开吧。",
            "nextDialogs": [
              "722360106"
            ]
          },
          "722360106": {
            "id": "722360106",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "不过一般人哪有本事闲逛到这个地方。你们难道是地走官吗，是珊瑚宫想要灭我们的口来保密了吗？",
            "nextDialogs": [
              "722360107"
            ]
          },
          "722360107": {
            "id": "722360107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不是啦不是！我们只是…",
            "nextDialogs": [
              "722360108"
            ]
          },
          "722360108": {
            "id": "722360108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你，觉悟不错啊。",
            "nextDialogs": [
              "722360109"
            ]
          },
          "722360109": {
            "id": "722360109",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "什么意思？",
            "nextDialogs": [
              "722360110"
            ]
          },
          "722360110": {
            "id": "722360110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们是来检视你工作的。",
            "nextDialogs": [
              "722360111"
            ]
          },
          "722360111": {
            "id": "722360111",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哼…",
            "nextDialogs": [
              "722360112"
            ]
          },
          "722360112": {
            "id": "722360112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们前来检查记录的密保措施。",
            "nextDialogs": [
              "722360113"
            ]
          },
          "722360113": {
            "id": "722360113",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "…反正你们能来到此地，料想也不是泛泛之辈。但我不管你究竟是哪边的人，还是离这里远点比较好。",
            "nextDialogs": [
              "722360114"
            ]
          },
          "722360114": {
            "id": "722360114",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "记录被我放在了所内深处，打开通路需要激活元素方碑。换句话说，需要释放强大的元素力。",
            "nextDialogs": [
              "722360115"
            ]
          },
          "722360115": {
            "id": "722360115",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "所有人离开白夜国后，这里的深海龙蜥就会被放出来。而它们被培养成了对特定元素起反应的体质。",
            "nextDialogs": [
              "722360116"
            ]
          },
          "722360116": {
            "id": "722360116",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "这里的深海龙蜥可都是强化品种，而且特征遗传给子代的概率很高。数载之后，这里将常年盘踞强大的深海龙蜥族群。",
            "nextDialogs": [
              "722360117"
            ]
          },
          "722360117": {
            "id": "722360117",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "因此，实验记录安全得很。",
            "nextDialogs": [
              "722360118"
            ]
          },
          "722360118": {
            "id": "722360118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "把它烧了不是更加安全？",
            "nextDialogs": [
              "722360119"
            ]
          },
          "722360119": {
            "id": "722360119",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "我是赞成这么做的，但是研究人员里面也分派系。我也不是不能理解另一派人的想法。",
            "nextDialogs": [
              "722360120"
            ]
          },
          "722360120": {
            "id": "722360120",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "「我们是拯救海祇的英雄了！」、「我们这下变成混蛋了…」——确实都有道理。",
            "nextDialogs": [
              "722360121"
            ]
          },
          "722360121": {
            "id": "722360121",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "把真相留到一个可以原谅我们的时代，也是一个我可以接受的方案。",
            "nextDialogs": [
              "722360122"
            ]
          },
          "722360122": {
            "id": "722360122",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "看你也不是一般人，就算不是地走官也是什么珊瑚宫近臣了。",
            "nextDialogs": [
              "722360123"
            ]
          },
          "722360123": {
            "id": "722360123",
            "speakerId": 1002,
            "speakerName": "宫地",
            "text": "帮我给大人物们带个话吧：宫地他会在禁区里待到离开的前一刻，确保再也没有人出现在附近。",
            "nextDialogs": [
              "722360124"
            ]
          },
          "722360124": {
            "id": "722360124",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以你就是宫地对吧？",
            "nextDialogs": [
              "722360125"
            ]
          },
          "722360125": {
            "id": "722360125",
            "speakerId": 1002,
            "speakerName": "宫地",
            "text": "嗯哼，不过到海面之上就要换个名字开始新生活了。不过，罪孽是没办法和老名字一样轻易抛弃的。"
          }
        }
      }
    },
    {
      "subId": "7223602",
      "subQuestName": "在实验区域寻找实验记录",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7223699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722369901"
        ],
        "dialogs": {
          "722369901": {
            "id": "722369901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你套话的本事又进步了啊。",
            "nextDialogs": [
              "722369902"
            ]
          },
          "722369902": {
            "id": "722369902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "他刚才说了什么来着？想要拿到记录需要激活方碑。",
            "nextDialogs": [
              "722369903"
            ]
          },
          "722369903": {
            "id": "722369903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但是方碑会引来危险的深海龙蜥。要事先做好准备才行。"
          }
        }
      }
    }
  ]
}
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "我要说的故事开始于「旧蒙德」，"
          }
        }
      }
    },
    {
      "subId": "1011302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101130211"
        ],
        "dialogs": {
          "101130211": {
            "id": "101130211",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "斯坦利…",
            "nextDialogs": [
              "101130212"
            ]
          },
          "101130212": {
            "id": "101130212",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "这么多年过去，束缚他的甚至已经不再是「朋友」本人。",
            "nextDialogs": [
              "101130213"
            ]
          },
          "101130213": {
            "id": "101130213",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "但那位朋友的故事，想必不会在蒙德被人忘却吧。"
          }
        }
      }
    }
  ]
}
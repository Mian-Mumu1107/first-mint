    {
      "subId": "1011302",
      "subQuestName": "坐到斯坦利身后",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101130201"
        ],
        "dialogs": {
          "101130201": {
            "id": "101130201",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "今天，难得来一次「天使的馈赠」。",
            "nextDialogs": [
              "101130202"
            ]
          },
          "101130202": {
            "id": "101130202",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "酒馆里人也不太多，我也乐得清静。"
          }
        }
      }
    },
    {
      "subId": "1011303",
      "subQuestName": "(test)自动对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101130301"
        ],
        "dialogs": {
          "101130301": {
            "id": "101130301",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "斯坦利…告诉我，我该怎么办…",
            "nextDialogs": [
              "101130302"
            ]
          },
          "101130302": {
            "id": "101130302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？他怎么在喊自己的名字啊？",
            "nextDialogs": [
              "101130304",
              "101130306"
            ]
          },
          "101130304": {
            "id": "101130304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "该不会，还有其他叫斯坦利的人？",
            "nextDialogs": [
              "101130307"
            ]
          },
          "101130307": {
            "id": "101130307",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "呜呜！呜呃…斯坦利…",
            "nextDialogs": [
              "101130308"
            ]
          },
          "101130308": {
            "id": "101130308",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "当年在烬寂海死的…为什么不是我啊！为什么我冒用你的名字，你的灵魂都不来阻止我？斯坦利！",
            "nextDialogs": [
              "101130309"
            ]
          },
          "101130309": {
            "id": "101130309",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "要不是为了保护我这个新人，你也不会死在那个无风的地方！",
            "nextDialogs": [
              "101130310"
            ]
          },
          "101130310": {
            "id": "101130310",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "你已经有了大冒险家的名号，可，可就为了我这种废物，你再也不能变成传奇了…",
            "nextDialogs": [
              "101130311"
            ]
          },
          "101130311": {
            "id": "101130311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这…究竟是怎么回事？",
            "nextDialogs": [
              "101130312"
            ]
          },
          "101130312": {
            "id": "101130312",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "…我想，当年他确实找到了烬寂海。在那里遇到的危机，也是真的吧。",
            "nextDialogs": [
              "101130313"
            ]
          },
          "101130313": {
            "id": "101130313",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "只不过，那个和他一起探险的同伴，才是真正的「大冒险家斯坦利」。",
            "nextDialogs": [
              "101130314"
            ]
          },
          "101130314": {
            "id": "101130314",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "真正的斯坦利，是为了救我们认识的这个「斯坦利」而死的吧。",
            "nextDialogs": [
              "101130315"
            ]
          },
          "101130315": {
            "id": "101130315",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊…那这个「斯坦利」之所以叫斯坦利，是因为他「偷」了别人的名字咯？",
            "nextDialogs": [
              "101130316"
            ]
          },
          "101130316": {
            "id": "101130316",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "恐怕就是这么回事。",
            "nextDialogs": [
              "101130317"
            ]
          },
          "101130317": {
            "id": "101130317",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "斯坦利…我害怕了这么多年，我怕蒙德城里的人把你忘得一干二净，所以到处说你的冒险故事…",
            "nextDialogs": [
              "101130318"
            ]
          },
          "101130318": {
            "id": "101130318",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "我要让蒙德人都记住，斯坦利抵达过烬寂海的中心…他是最伟大的冒险家，他还活着！",
            "nextDialogs": [
              "101130319"
            ]
          },
          "101130319": {
            "id": "101130319",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "斯坦利不会死，因为我就是！…因为我就是…斯坦利…",
            "nextDialogs": [
              "101130320"
            ]
          },
          "101130320": {
            "id": "101130320",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "对不起，斯坦利…连我也老了，我也老了啊…",
            "nextDialogs": [
              "101130321"
            ]
          },
          "101130321": {
            "id": "101130321",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "唉…",
            "nextDialogs": [
              "101130322"
            ]
          },
          "101130322": {
            "id": "101130322",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "你们几个，还想偷听到什么时候？",
            "nextDialogs": [
              "101130323"
            ]
          },
          "101130323": {
            "id": "101130323",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "糟了！他发现了…！"
          },
          "101130306": {
            "id": "101130306",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "不会吧，连我都没听说过第二个斯坦利。"
          }
        }
      }
    },
    {
      "subId": "1011304",
      "subQuestName": "试着与斯坦利交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101130401"
        ],
        "dialogs": {
          "101130401": {
            "id": "101130401",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "走吧，什么都别问，让我一个人安静一会儿…",
            "nextDialogs": [
              "101130402"
            ]
          },
          "101130402": {
            "id": "101130402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可是…",
            "nextDialogs": [
              "101130403"
            ]
          },
          "101130403": {
            "id": "101130403",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "走！别让我说第二次！",
            "nextDialogs": [
              "101130404"
            ]
          },
          "101130404": {
            "id": "101130404",
            "speakerId": 1004,
            "speakerName": "杰克",
            "text": "荣誉骑士、温迪，还有派蒙！太好了，你们都在这儿！",
            "nextDialogs": [
              "101130405"
            ]
          },
          "101130405": {
            "id": "101130405",
            "speakerId": 1004,
            "speakerName": "杰克",
            "text": "我到处找你们！我是来道谢的，多亏你帮我找的剑和盾，我父母同意了！",
            "nextDialogs": [
              "101130406"
            ]
          },
          "101130406": {
            "id": "101130406",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "哦？真的吗？",
            "nextDialogs": [
              "101130407"
            ]
          },
          "101130407": {
            "id": "101130407",
            "speakerId": 1004,
            "speakerName": "杰克",
            "text": "真的！他们还说要出钱找人把「辉煌勇气之剑」和「光耀意志之盾」修好，让我带着上路。",
            "nextDialogs": [
              "101130408"
            ]
          },
          "101130408": {
            "id": "101130408",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "那真好。杰克，你要离开蒙德、启程巡游提瓦特大陆了吗？",
            "nextDialogs": [
              "101130409"
            ]
          },
          "101130409": {
            "id": "101130409",
            "speakerId": 1004,
            "speakerName": "杰克",
            "text": "不，暂时还不走。以我现在的能力，恐怕走不了太远的路。",
            "nextDialogs": [
              "101130410"
            ]
          },
          "101130410": {
            "id": "101130410",
            "speakerId": 1004,
            "speakerName": "杰克",
            "text": "而且，我还想再听听斯坦利先生的故事。嘿嘿…毕竟，他是我梦想的起点。",
            "nextDialogs": [
              "101130411"
            ]
          },
          "101130411": {
            "id": "101130411",
            "speakerId": 1004,
            "speakerName": "杰克",
            "text": "斯坦利先…啊，他又喝醉了…",
            "nextDialogs": [
              "101130412"
            ]
          },
          "101130412": {
            "id": "101130412",
            "speakerId": 1004,
            "speakerName": "杰克",
            "text": "明天见，先生。等你酒醒了，再给我讲点故事好吗？",
            "nextDialogs": [
              "101130413"
            ]
          },
          "101130413": {
            "id": "101130413",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "我认为斯坦利挺喜欢这孩子，你觉得呢？",
            "nextDialogs": [
              "101130414"
            ]
          },
          "101130414": {
            "id": "101130414",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "杰克？杰克！",
            "nextDialogs": [
              "101130415"
            ]
          },
          "101130415": {
            "id": "101130415",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "杰克已经回去了。",
            "nextDialogs": [
              "101130416"
            ]
          },
          "101130416": {
            "id": "101130416",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "是吗…那，谢谢你们没把我的秘密说出去。",
            "nextDialogs": [
              "101130417"
            ]
          },
          "101130417": {
            "id": "101130417",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "欸？突然直视现实了吗？这可不像之前的你哦。",
            "nextDialogs": [
              "101130418"
            ]
          },
          "101130418": {
            "id": "101130418",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "我…刚才我都不敢看他一眼。他对冒险的真心不带一点杂质…",
            "nextDialogs": [
              "101130419"
            ]
          },
          "101130419": {
            "id": "101130419",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "我是个疲惫没用的骗子，但那孩子还是个闪闪发亮的新人，可不能毁灭了他的梦想啊。",
            "nextDialogs": [
              "101130421"
            ]
          },
          "101130421": {
            "id": "101130421",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "故事…经历…呵，算了吧。",
            "nextDialogs": [
              "101130423"
            ]
          },
          "101130423": {
            "id": "101130423",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "这才是我最大的秘密、最大的恐惧…",
            "nextDialogs": [
              "101130425"
            ]
          },
          "101130425": {
            "id": "101130425",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "我唯一不能忘记的，是他死在了无风的烬寂海，风带不走他的灵魂！",
            "nextDialogs": [
              "101130428"
            ]
          },
          "101130428": {
            "id": "101130428",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "嗯，没错…真正的斯坦利，在他的记忆里，甚至已经不再是那个鲜活的友人。",
            "nextDialogs": [
              "101130429"
            ]
          },
          "101130429": {
            "id": "101130429",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "而是永远定格在伤痕累累的战士模样，束缚着他所有的人生。",
            "nextDialogs": [
              "101130430"
            ]
          },
          "101130430": {
            "id": "101130430",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "我老了…再怎么不愿放下，也留不住多少东西…",
            "nextDialogs": [
              "101130431"
            ]
          },
          "101130431": {
            "id": "101130431",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "我真没用！没用…",
            "nextDialogs": [
              "101130432"
            ]
          },
          "101130432": {
            "id": "101130432",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "但冒险家不能以那种方式死去…不能…",
            "nextDialogs": [
              "101130433"
            ]
          },
          "101130433": {
            "id": "101130433",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "真…真是不可思议…",
            "nextDialogs": [
              "101130434"
            ]
          },
          "101130434": {
            "id": "101130434",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "谢谢你们…谢谢你，巴巴托斯大人…",
            "nextDialogs": [
              "101130435"
            ]
          },
          "101130435": {
            "id": "101130435",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "对不起，我还需要一些时间，调整心情…",
            "nextDialogs": [
              "101130436"
            ]
          },
          "101130436": {
            "id": "101130436",
            "speakerId": 1001,
            "speakerName": "斯坦利",
            "text": "但我想，我会没事的…",
            "nextDialogs": [
              "101130437"
            ]
          },
          "101130437": {
            "id": "101130437",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "嗯，真不错！斯坦利找到了真正的自己，杰克也成功自立了。",
            "nextDialogs": [
              "101130438"
            ]
          },
          "101130438": {
            "id": "101130438",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "这么多好事加在一起，值得喝一杯庆祝庆祝！",
            "nextDialogs": [
              "101130439"
            ]
          },
          "101130439": {
            "id": "101130439",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你要在这个酒馆就地不醉不归吗？",
            "nextDialogs": [
              "101130440"
            ]
          },
          "101130440": {
            "id": "101130440",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "哈哈，这里的酒太贵了。杰克欠我的报酬还没给，他许诺我的报酬是珍贵名酒，还记得吗？",
            "nextDialogs": [
              "101130441"
            ]
          },
          "101130441": {
            "id": "101130441",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "我先去找他要那瓶酒，一会儿就在<color=#00E1FFFF>「老地方」</color>集合吧！",
            "nextDialogs": [
              "101130442"
            ]
          },
          "101130442": {
            "id": "101130442",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎？什么老地方，我怎么不知道？喂！喂，卖唱的！"
          }
        }
      }
    },
    {
      "subId": "1011305",
      "subQuestName": "寻找「老地方」…？",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101130501"
        ],
        "dialogs": {
          "101130501": {
            "id": "101130501",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "可算来了。",
            "nextDialogs": [
              "101130502"
            ]
          },
          "101130502": {
            "id": "101130502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真难找！下次别打这种哑谜了！",
            "nextDialogs": [
              "101130503"
            ]
          },
          "101130503": {
            "id": "101130503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对了，卖唱的，你拿到酒了吗？",
            "nextDialogs": [
              "101130504"
            ]
          },
          "101130504": {
            "id": "101130504",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "拿到了。杰克这家伙，说是什么「珍藏又珍贵的好酒」…",
            "nextDialogs": [
              "101130505"
            ]
          },
          "101130505": {
            "id": "101130505",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "结果只不过是半瓶苹果酿而已嘛。",
            "nextDialogs": [
              "101130506"
            ]
          },
          "101130506": {
            "id": "101130506",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "真怀念啊。",
            "nextDialogs": [
              "101130507"
            ]
          },
          "101130507": {
            "id": "101130507",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "第一次在这儿看风景的时候，我还不是「这副模样」。",
            "nextDialogs": [
              "101130508"
            ]
          },
          "101130508": {
            "id": "101130508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是…这副模样？",
            "nextDialogs": [
              "101130509"
            ]
          },
          "101130509": {
            "id": "101130509",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "大约两千六百年前，尘世尚未划归七神所有。",
            "nextDialogs": [
              "101130510"
            ]
          },
          "101130510": {
            "id": "101130510",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "那时，「旧蒙德」被暴君吹起的飓风包围，连飞鸟也不得通行。",
            "nextDialogs": [
              "101130511"
            ]
          },
          "101130511": {
            "id": "101130511",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「旧蒙德」？啊，我想起来了，就是现在的风龙废墟吧？你以前提过！",
            "nextDialogs": [
              "101130512"
            ]
          },
          "101130512": {
            "id": "101130512",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "是的。曾经统治那座高塔的风之暴君，是「龙卷的魔神」迭卡拉庇安。",
            "nextDialogs": [
              "101130513"
            ]
          },
          "101130513": {
            "id": "101130513",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "而那时的我，只是千风中的一缕。并无神灵之格，也不成人形…",
            "nextDialogs": [
              "101130514"
            ]
          },
          "101130514": {
            "id": "101130514",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "只是风中细微的元素精灵，是一缕「能够带来细小的转机与希望之风」。",
            "nextDialogs": [
              "101130515"
            ]
          },
          "101130515": {
            "id": "101130515",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "只是元素精灵？不是人形？咦？温迪，你以前不长现在这样吗？",
            "nextDialogs": [
              "101130516"
            ]
          },
          "101130516": {
            "id": "101130516",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "嗯。我现在的样子，其实也和那位假斯坦利先生一样，是借用「朋友」的喔。",
            "nextDialogs": [
              "101130517"
            ]
          },
          "101130517": {
            "id": "101130517",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "后来呢？",
            "nextDialogs": [
              "101130518"
            ]
          },
          "101130518": {
            "id": "101130518",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你说的那个朋友，他后来怎么样了？",
            "nextDialogs": [
              "101130519"
            ]
          },
          "101130519": {
            "id": "101130519",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（温迪的朋友，和斯坦利一样…）",
            "nextDialogs": [
              "101130520"
            ]
          },
          "101130520": {
            "id": "101130520",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "派蒙，你想知道后面的故事吗？",
            "nextDialogs": [
              "101130521"
            ]
          },
          "101130521": {
            "id": "101130521",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "当然当然！别吊我胃口，快说吧！",
            "nextDialogs": [
              "101130523",
              "101130525"
            ]
          },
          "101130523": {
            "id": "101130523",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "为什么现在突然想吃这个啊！",
            "nextDialogs": [
              "101130526"
            ]
          },
          "101130526": {
            "id": "101130526",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "哈哈哈，你肚子饿了吗？",
            "nextDialogs": [
              "101130527"
            ]
          },
          "101130527": {
            "id": "101130527",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是啊。",
            "nextDialogs": [
              "101130528"
            ]
          },
          "101130528": {
            "id": "101130528",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜…真是拿你没办法！",
            "nextDialogs": [
              "101130529"
            ]
          },
          "101130529": {
            "id": "101130529",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "啊——有时我会觉得，你有些过于聪明了。",
            "nextDialogs": [
              "101130530"
            ]
          },
          "101130530": {
            "id": "101130530",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "不过，朋友之间，也许就是要心知肚明才好。",
            "nextDialogs": [
              "101130531"
            ]
          },
          "101130531": {
            "id": "101130531",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "美酒，微风…这样的时刻，总会让我忍不住想起…",
            "nextDialogs": [
              "101130532"
            ]
          },
          "101130532": {
            "id": "101130532",
            "speakerId": 1003,
            "speakerName": "温迪",
            "text": "想起那首，从他那里听来的歌…",
            "nextDialogs": [
              "101130533"
            ]
          },
          "101130533": {
            "id": "101130533",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会好好听着的。"
          },
          "101130525": {
            "id": "101130525",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？不是在听故事吗？怎么突然要吃这种东西！"
          }
        }
      }
    },
    {

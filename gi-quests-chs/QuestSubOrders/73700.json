  "subQuests": [
    {
      "subId": "7370001",
      "subQuestName": "与祖尔宛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "737000101"
        ],
        "dialogs": {
          "737000101": {
            "id": "737000101",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "不知不觉训练也进行到后半了。进展还顺利吗？",
            "nextDialogs": [
              "737000104"
            ]
          },
          "737000104": {
            "id": "737000104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过斯露莎在给我们讲故事的时候，的确有反思的意思？",
            "nextDialogs": [
              "737000105"
            ]
          },
          "737000105": {
            "id": "737000105",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "对话对于斯露莎来说是很好的学习方法。特别是当对话的对象不是矫论团那帮无趣的家伙的时候。",
            "nextDialogs": [
              "737000106"
            ]
          },
          "737000106": {
            "id": "737000106",
            "speakerId": 1002,
            "speakerName": "斯露莎",
            "text": "#前辈这话未免有些太武断了…{NICKNAME}作为「谒颂主」是很出众，但矫论团的人也并不全是…",
            "nextDialogs": [
              "737000107"
            ]
          },
          "737000107": {
            "id": "737000107",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "或许在吹捧与欺瞒之外也有零星被遗漏的美德吧。",
            "nextDialogs": [
              "737000108"
            ]
          },
          "737000108": {
            "id": "737000108",
            "speakerId": 1002,
            "speakerName": "斯露莎",
            "text": "唔…",
            "nextDialogs": [
              "737000109"
            ]
          },
          "737000109": {
            "id": "737000109",
            "speakerId": 1000,
            "speakerName": "祖尔宛",
            "text": "#看你不服气的样子，稍后正好让{NICKNAME}和派蒙两位见证者来评价一下。当然，在你的讲述之后。"
          }
        }
      }
    },

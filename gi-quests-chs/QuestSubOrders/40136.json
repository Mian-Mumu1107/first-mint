    {
      "subId": "4013601",
      "subQuestName": "前往千灵映影节会场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401360103"
        ],
        "dialogs": {
          "401360103": {
            "id": "401360103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "泽维尔！有一段时间没见到你了！",
            "nextDialogs": [
              "401360104"
            ]
          },
          "401360104": {
            "id": "401360104",
            "speakerId": 1001,
            "speakerName": "泽维尔",
            "text": "两位好，这不是，剪辑完成之后，我又开始着手于宣传与放映的工作了，实在忙不过来。",
            "nextDialogs": [
              "401360105"
            ]
          },
          "401360105": {
            "id": "401360105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "今天就是颁奖的日子了吧？也不知道我们的映影能不能夺得「芙宁娜奖」。",
            "nextDialogs": [
              "401360106"
            ]
          },
          "401360106": {
            "id": "401360106",
            "speakerId": 1002,
            "speakerName": "芙宁娜",
            "text": "我倒是有九成的把握。",
            "nextDialogs": [
              "401360107"
            ]
          },
          "401360107": {
            "id": "401360107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "芙宁娜！原来你已经到现场了呀，来得比其他人都早呢！",
            "nextDialogs": [
              "401360108"
            ]
          },
          "401360108": {
            "id": "401360108",
            "speakerId": 1002,
            "speakerName": "芙宁娜",
            "text": "其他人应该也很快就到。对了，泽维尔，说到领奖，你是不是该为我们的团队起个名字呀？",
            "nextDialogs": [
              "401360109"
            ]
          },
          "401360109": {
            "id": "401360109",
            "speakerId": 1001,
            "speakerName": "泽维尔",
            "text": "啊？可我还不知道能不能得奖…我、我可不敢做这种提前打开美酒的事啊…",
            "nextDialogs": [
              "401360110"
            ]
          },
          "401360110": {
            "id": "401360110",
            "speakerId": 1002,
            "speakerName": "芙宁娜",
            "text": "睁大眼睛，看看人们离开剧场的反应吧！没有一个不叫好的。",
            "nextDialogs": [
              "401360111"
            ]
          },
          "401360111": {
            "id": "401360111",
            "speakerId": 1002,
            "speakerName": "芙宁娜",
            "text": "你自己也知道吧？剧场的工作人员一定找过你，说要增加这部映影的放映次数。",
            "nextDialogs": [
              "401360112"
            ]
          },
          "401360112": {
            "id": "401360112",
            "speakerId": 1002,
            "speakerName": "芙宁娜",
            "text": "这次的票房回报，都够你开一家正经的映影公司了吧？",
            "nextDialogs": [
              "401360113"
            ]
          },
          "401360113": {
            "id": "401360113",
            "speakerId": 1001,
            "speakerName": "泽维尔",
            "text": "但这不是我一个人的功劳！是诸位好先生与好女士们共同的心血，绝不能由我一个人来取这个名字！",
            "nextDialogs": [
              "401360114"
            ]
          },
          "401360114": {
            "id": "401360114",
            "speakerId": 1002,
            "speakerName": "芙宁娜",
            "text": "总之你就好好想想吧，我相信大家会同意的。",
            "nextDialogs": [
              "401360115"
            ]
          },
          "401360115": {
            "id": "401360115",
            "speakerId": 1001,
            "speakerName": "泽维尔",
            "text": "#好吧…但在那之前，{NICKNAME}和派蒙，可以麻烦您二位去一趟梅洛彼得堡吗？",
            "nextDialogs": [
              "401360116"
            ]
          },
          "401360116": {
            "id": "401360116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？可不是还有颁奖典礼吗？",
            "nextDialogs": [
              "401360117"
            ]
          },
          "401360117": {
            "id": "401360117",
            "speakerId": 1001,
            "speakerName": "泽维尔",
            "text": "我想请二位去找我们的女主角之一，夏沃蕾小姐来这边。",
            "nextDialogs": [
              "401360118"
            ]
          },
          "401360118": {
            "id": "401360118",
            "speakerId": 1001,
            "speakerName": "泽维尔",
            "text": "我最近都见不到她，也没机会通知她来参加今天的颁奖典礼。",
            "nextDialogs": [
              "401360119"
            ]
          },
          "401360119": {
            "id": "401360119",
            "speakerId": 1001,
            "speakerName": "泽维尔",
            "text": "但报纸上说，铳枪杀人案的犯人今天会由特巡队队长亲自押送至梅洛彼得堡…",
            "nextDialogs": [
              "401360120"
            ]
          },
          "401360120": {
            "id": "401360120",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦，原来是这样。",
            "nextDialogs": [
              "401360121"
            ]
          },
          "401360121": {
            "id": "401360121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "举手之劳。",
            "nextDialogs": [
              "401360122"
            ]
          },
          "401360122": {
            "id": "401360122",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯！泽维尔在这里等着就好，争取想出个好听的名字！",
            "nextDialogs": [
              "401360123"
            ]
          },
          "401360123": {
            "id": "401360123",
            "speakerId": 1001,
            "speakerName": "泽维尔",
            "text": "好，拜托二位了。"
          }
        }
      }
    },
    {
      "subId": "4013602",
      "subQuestName": "前往梅洛彼得堡找夏沃蕾",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401360201"
        ],
        "dialogs": {
          "401360201": {
            "id": "401360201",
            "speakerId": 1003,
            "speakerName": "夏沃蕾",
            "text": "…押送程序结束。他们三个，接下来就交给你了。",
            "nextDialogs": [
              "401360202"
            ]
          },
          "401360202": {
            "id": "401360202",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "看样子后边还有别的事？",
            "nextDialogs": [
              "401360203"
            ]
          },
          "401360203": {
            "id": "401360203",
            "speakerId": 1003,
            "speakerName": "夏沃蕾",
            "text": "嗯，得去赶一场派对。",
            "nextDialogs": [
              "401360204"
            ]
          },
          "401360204": {
            "id": "401360204",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "真少见，在培养新爱好吗？",
            "nextDialogs": [
              "401360205"
            ]
          },
          "401360205": {
            "id": "401360205",
            "speakerId": 1003,
            "speakerName": "夏沃蕾",
            "text": "只是这场比较特殊。",
            "nextDialogs": [
              "401360206"
            ]
          },
          "401360206": {
            "id": "401360206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "夏沃蕾，公爵！",
            "nextDialogs": [
              "401360207"
            ]
          },
          "401360207": {
            "id": "401360207",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "过节就是好，连我这都变热闹了。",
            "nextDialogs": [
              "401360208"
            ]
          },
          "401360208": {
            "id": "401360208",
            "speakerId": 1003,
            "speakerName": "夏沃蕾",
            "text": "这就是千灵节。",
            "nextDialogs": [
              "401360209"
            ]
          },
          "401360209": {
            "id": "401360209",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "是啊，护士长甚至准备了豪华版营养奶昔…健康程度也是豪华版的。",
            "nextDialogs": [
              "401360210"
            ]
          },
          "401360210": {
            "id": "401360210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你们刚才在聊工作吗？",
            "nextDialogs": [
              "401360211"
            ]
          },
          "401360211": {
            "id": "401360211",
            "speakerId": 1003,
            "speakerName": "夏沃蕾",
            "text": "已经聊完了。我也向莱欧斯利先生打了「招呼」，对吗？",
            "nextDialogs": [
              "401360212"
            ]
          },
          "401360212": {
            "id": "401360212",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "我没有明确回应哦。",
            "nextDialogs": [
              "401360213"
            ]
          },
          "401360213": {
            "id": "401360213",
            "speakerId": 1003,
            "speakerName": "夏沃蕾",
            "text": "但你也没拒绝。",
            "nextDialogs": [
              "401360214"
            ]
          },
          "401360214": {
            "id": "401360214",
            "speakerId": 1003,
            "speakerName": "夏沃蕾",
            "text": "我有个好主意，给他们每人发一份报纸吧，比如，一份头版印着一段二十年前往事的报纸。",
            "nextDialogs": [
              "401360215"
            ]
          },
          "401360215": {
            "id": "401360215",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "那我猜有一个人要倒霉了。",
            "nextDialogs": [
              "401360216"
            ]
          },
          "401360216": {
            "id": "401360216",
            "speakerId": 1003,
            "speakerName": "夏沃蕾",
            "text": "我猜有两个人要被当成英雄了。",
            "nextDialogs": [
              "401360217"
            ]
          },
          "401360217": {
            "id": "401360217",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "说到英雄，你们两位是有什么事要找我吗？",
            "nextDialogs": [
              "401360218"
            ]
          },
          "401360218": {
            "id": "401360218",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦，我们是来…",
            "nextDialogs": [
              "401360219"
            ]
          },
          "401360219": {
            "id": "401360219",
            "speakerId": 1003,
            "speakerName": "夏沃蕾",
            "text": "来邀请我去派对的，对吧？我可没忘记今天是什么日子。",
            "nextDialogs": [
              "401360220"
            ]
          },
          "401360220": {
            "id": "401360220",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，那我们赶快回去吧！",
            "nextDialogs": [
              "401360221"
            ]
          },
          "401360221": {
            "id": "401360221",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "公爵再见！千灵节快乐！",
            "nextDialogs": [
              "401360222"
            ]
          },
          "401360222": {
            "id": "401360222",
            "speakerId": 1004,
            "speakerName": "莱欧斯利",
            "text": "嗯，节日快乐。"
          }
        }
      }
    },
    {
      "subId": "4013603",
      "subQuestName": "返回千灵映影节会场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401360301"
        ],
        "dialogs": {
          "401360301": {
            "id": "401360301",
            "speakerId": 1005,
            "speakerName": "会场主持人",
            "text": "我宣布，获得首届千灵映影节「芙宁娜」奖的影片是——",
            "nextDialogs": [
              "401360302"
            ]
          },
          "401360302": {
            "id": "401360302",
            "speakerId": 1005,
            "speakerName": "会场主持人",
            "text": "《两个铳枪手》！",
            "nextDialogs": [
              "401360303"
            ]
          },
          "401360303": {
            "id": "401360303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是我们耶！真的是我们耶！",
            "nextDialogs": [
              "401360304"
            ]
          },
          "401360304": {
            "id": "401360304",
            "speakerId": 1006,
            "speakerName": "神里绫华",
            "text": "恭喜你，泽维尔先生。",
            "nextDialogs": [
              "401360305"
            ]
          },
          "401360305": {
            "id": "401360305",
            "speakerId": 1001,
            "speakerName": "泽维尔",
            "text": "天哪，我…我…真是太谢谢各位了！",
            "nextDialogs": [
              "401360306"
            ]
          },
          "401360306": {
            "id": "401360306",
            "speakerId": 1002,
            "speakerName": "芙宁娜",
            "text": "我对枫丹娱乐界的判断从不出错。",
            "nextDialogs": [
              "401360307"
            ]
          },
          "401360307": {
            "id": "401360307",
            "speakerId": 1005,
            "speakerName": "会场主持人",
            "text": "现在有请《两个铳枪手》的制片人，泽维尔先生，上台领奖！",
            "nextDialogs": [
              "401360308"
            ]
          },
          "401360308": {
            "id": "401360308",
            "speakerId": 1001,
            "speakerName": "泽维尔",
            "text": "谢谢…非常感谢大家对我们影片的认可。我在此，要特别感谢——",
            "nextDialogs": [
              "401360309"
            ]
          },
          "401360309": {
            "id": "401360309",
            "speakerId": 1003,
            "speakerName": "夏沃蕾",
            "text": "时间过得真快。",
            "nextDialogs": [
              "401360310"
            ]
          },
          "401360310": {
            "id": "401360310",
            "speakerId": 1006,
            "speakerName": "神里绫华",
            "text": "嗯，就好像夏沃蕾你教我握枪只是几天前的事一样。",
            "nextDialogs": [
              "401360311"
            ]
          },
          "401360311": {
            "id": "401360311",
            "speakerId": 1003,
            "speakerName": "夏沃蕾",
            "text": "还会来枫丹吗？",
            "nextDialogs": [
              "401360312"
            ]
          },
          "401360312": {
            "id": "401360312",
            "speakerId": 1006,
            "speakerName": "神里绫华",
            "text": "当然！我喜欢这个城市，新奇的东西看都看不过来。",
            "nextDialogs": [
              "401360313"
            ]
          },
          "401360313": {
            "id": "401360313",
            "speakerId": 1006,
            "speakerName": "神里绫华",
            "text": "夏沃蕾会来稻妻吗？",
            "nextDialogs": [
              "401360314"
            ]
          },
          "401360314": {
            "id": "401360314",
            "speakerId": 1003,
            "speakerName": "夏沃蕾",
            "text": "…以前从没有过这个打算。不过，现在可以考虑一下。",
            "nextDialogs": [
              "401360315"
            ]
          },
          "401360315": {
            "id": "401360315",
            "speakerId": 1006,
            "speakerName": "神里绫华",
            "text": "我期待你的到来。到时候，还想邀请你来家里做客，给你尝尝我们家的茶点。",
            "nextDialogs": [
              "401360316"
            ]
          },
          "401360316": {
            "id": "401360316",
            "speakerId": 1003,
            "speakerName": "夏沃蕾",
            "text": "嗯，保持联系。",
            "nextDialogs": [
              "401360317"
            ]
          },
          "401360317": {
            "id": "401360317",
            "speakerId": 1007,
            "speakerName": "千织",
            "text": "如你所愿？",
            "nextDialogs": [
              "401360318"
            ]
          },
          "401360318": {
            "id": "401360318",
            "speakerId": 1008,
            "speakerName": "神里绫人",
            "text": "你也该回稻妻看看了。",
            "nextDialogs": [
              "401360319"
            ]
          },
          "401360319": {
            "id": "401360319",
            "speakerId": 1007,
            "speakerName": "千织",
            "text": "「小仓屋」怎么样？",
            "nextDialogs": [
              "401360320"
            ]
          },
          "401360320": {
            "id": "401360320",
            "speakerId": 1008,
            "speakerName": "神里绫人",
            "text": "一切都好。",
            "nextDialogs": [
              "401360321"
            ]
          },
          "401360321": {
            "id": "401360321",
            "speakerId": 1007,
            "speakerName": "千织",
            "text": "代我向她问好。",
            "nextDialogs": [
              "401360322"
            ]
          },
          "401360322": {
            "id": "401360322",
            "speakerId": 1008,
            "speakerName": "神里绫人",
            "text": "我会的。",
            "nextDialogs": [
              "401360323"
            ]
          },
          "401360323": {
            "id": "401360323",
            "speakerId": 1007,
            "speakerName": "千织",
            "text": "听说岛上不下雷暴了。",
            "nextDialogs": [
              "401360324"
            ]
          },
          "401360324": {
            "id": "401360324",
            "speakerId": 1008,
            "speakerName": "神里绫人",
            "text": "也不打仗了。和平安治。",
            "nextDialogs": [
              "401360325"
            ]
          },
          "401360325": {
            "id": "401360325",
            "speakerId": 1007,
            "speakerName": "千织",
            "text": "听起来真好，是适合晒布料的天气。",
            "nextDialogs": [
              "401360326"
            ]
          },
          "401360326": {
            "id": "401360326",
            "speakerId": 1001,
            "speakerName": "泽维尔",
            "text": "——再次感谢我提到的所有人。是你们带我走上了领奖台，是你们铸就了这部映影。",
            "nextDialogs": [
              "401360327"
            ]
          },
          "401360327": {
            "id": "401360327",
            "speakerId": 1001,
            "speakerName": "泽维尔",
            "text": "另外，经过团队成员的一致认可，我正式将泽维尔剧组，命名为「铳枪影业」！",
            "nextDialogs": [
              "401360328"
            ]
          },
          "401360328": {
            "id": "401360328",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，这么喊出来还真帅气！",
            "nextDialogs": [
              "401360329"
            ]
          },
          "401360329": {
            "id": "401360329",
            "speakerId": 1005,
            "speakerName": "会场主持人",

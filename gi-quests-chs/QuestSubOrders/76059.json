  "subQuests": [
    {
      "subId": "7605901",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760590101"
        ],
        "dialogs": {
          "760590101": {
            "id": "760590101",
            "speakerId": 1000,
            "speakerName": "执着于食物的幽影",
            "text": "啊，就是这个味道！",
            "nextDialogs": [
              "760590102"
            ]
          },
          "760590102": {
            "id": "760590102",
            "speakerId": 1000,
            "speakerName": "执着于食物的幽影",
            "text": "我十几岁的时候开始学做菜，奶奶做给我吃的烟熏鱼排就是这个味道。",
            "nextDialogs": [
              "760590103"
            ]
          },
          "760590103": {
            "id": "760590103",
            "speakerId": 1000,
            "speakerName": "执着于食物的幽影",
            "text": "也只有老一辈人才会做这种味道的烟熏鱼了，真怀念啊。",
            "nextDialogs": [
              "760590104"
            ]
          },
          "760590104": {
            "id": "760590104",
            "speakerId": 1000,
            "speakerName": "执着于食物的幽影",
            "text": "奶奶会叫着我的名字，喊我去吃饭：「雅科皮，来吃鱼，奶奶刚做的。」",
            "nextDialogs": [
              "760590105"
            ]
          },
          "760590105": {
            "id": "760590105",
            "speakerId": 1000,
            "speakerName": "执着于食物的幽影",
            "text": "好久没见到奶奶了…下个月休假的时候去看她吧…下个月…已经多久了…"
          }
        }
      }
    },

    {
      "subId": "7404311",
      "subQuestName": "与恩里对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740430301"
        ],
        "dialogs": {
          "740430301": {
            "id": "740430301",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "嗯，确实收到了，七个神秘的核心。",
            "nextDialogs": [
              "740430302"
            ]
          },
          "740430302": {
            "id": "740430302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以核心到底是干什么用的？",
            "nextDialogs": [
              "740430303"
            ]
          },
          "740430303": {
            "id": "740430303",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "我怎么知道？老板只是说，需要七个这些神奇机器里的神奇核心。能弄到核心，就能赚大钱。",
            "nextDialogs": [
              "740430304"
            ]
          },
          "740430304": {
            "id": "740430304",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "这样好了！我跟老板约好了今天在这里见面，汇报工作进度。你们当面问他吧？反正也要等他结帐，我才能跟你分钱。",
            "nextDialogs": [
              "740430305"
            ]
          },
          "740430305": {
            "id": "740430305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真拿你没办法。既然恩里这么说了，就等一会吧！",
            "nextDialogs": [
              "740430306"
            ]
          },
          "740430306": {
            "id": "740430306",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "等了一会…",
            "nextDialogs": [
              "740430307"
            ]
          },
          "740430307": {
            "id": "740430307",
            "speakerId": 1003,
            "speakerName": "「老板」",
            "text": "亲爱的恩里，情况如何啊？",
            "nextDialogs": [
              "740430308"
            ]
          },
          "740430308": {
            "id": "740430308",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "好得很，老板！您要的七个神秘核心都收集齐全了。来来，让我介绍一下，这是我的合伙人…叫啥来着？",
            "nextDialogs": [
              "740430309"
            ]
          },
          "740430309": {
            "id": "740430309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "740430310"
            ]
          },
          "740430310": {
            "id": "740430310",
            "speakerId": 1003,
            "speakerName": "「老板」",
            "text": "呃…",
            "nextDialogs": [
              "740430311"
            ]
          },
          "740430311": {
            "id": "740430311",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃呃…",
            "nextDialogs": [
              "740430312"
            ]
          },
          "740430312": {
            "id": "740430312",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "哎？你们认识啊？那就好说了！事情是这样的，老板…",
            "nextDialogs": [
              "740430315"
            ]
          },
          "740430315": {
            "id": "740430315",
            "speakerId": 1003,
            "speakerName": "「老板」",
            "text": "哎吔！饶命啊！",
            "nextDialogs": [
              "740430316"
            ]
          },
          "740430316": {
            "id": "740430316",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，这两个人好熟练…",
            "nextDialogs": [
              "740430317"
            ]
          },
          "740430317": {
            "id": "740430317",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "老板别担心，没有生命危险的！",
            "nextDialogs": [
              "740430318"
            ]
          },
          "740430318": {
            "id": "740430318",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "当然，当然。当然不会有生命危险。",
            "nextDialogs": [
              "740430319"
            ]
          },
          "740430319": {
            "id": "740430319",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "就目前而言呢。",
            "nextDialogs": [
              "740430320"
            ]
          },
          "740430320": {
            "id": "740430320",
            "speakerId": 1003,
            "speakerName": "「老板」",
            "text": "就、就目前而言…？！",
            "nextDialogs": [
              "740430321"
            ]
          },
          "740430321": {
            "id": "740430321",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "接下来呢…",
            "nextDialogs": [
              "740430322"
            ]
          },
          "740430322": {
            "id": "740430322",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "是烤鸡，抑或是…烤鸡以外的东西，就取决于老板您的态度了。",
            "nextDialogs": [
              "740430323"
            ]
          },
          "740430323": {
            "id": "740430323",
            "speakerId": 1003,
            "speakerName": "「老板」",
            "text": "噫噫——",
            "nextDialogs": [
              "740430324"
            ]
          },
          "740430324": {
            "id": "740430324",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你们怎么会在这里？",
            "nextDialogs": [
              "740430325"
            ]
          },
          "740430325": {
            "id": "740430325",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "上次，我们…有幸相遇以后，我们决定监视恩里。",
            "nextDialogs": [
              "740430326"
            ]
          },
          "740430326": {
            "id": "740430326",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "等等，为什么要监视我？",
            "nextDialogs": [
              "740430327"
            ]
          },
          "740430327": {
            "id": "740430327",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "不对，归根到底，你们为什么要针对我！明明我只是在努力工作而已！",
            "nextDialogs": [
              "740430328"
            ]
          },
          "740430328": {
            "id": "740430328",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "你拆掉的机器是枫丹科学院的人用来监测、优化水质的装置。",
            "nextDialogs": [
              "740430329"
            ]
          },
          "740430329": {
            "id": "740430329",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "哎？不是用来制造污染的机器吗？",
            "nextDialogs": [
              "740430330"
            ]
          },
          "740430330": {
            "id": "740430330",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "拆出来的核心包含着最先进的机芯和枫丹的水文数据。我们希望能…认识您的交易对象。",
            "nextDialogs": [
              "740430331"
            ]
          },
          "740430331": {
            "id": "740430331",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "哎？哎？什么？为什么？",
            "nextDialogs": [
              "740430333"
            ]
          },
          "740430333": {
            "id": "740430333",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "不对不对，你是我的大恩人，我怎么可能骗你啊！",
            "nextDialogs": [
              "740430335"
            ]
          },
          "740430335": {
            "id": "740430335",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "老板，你骗我！你竟然骗我把这么重要的东西弄坏了！",
            "nextDialogs": [
              "740430336"
            ]
          },
          "740430336": {
            "id": "740430336",
            "speakerId": 1003,
            "speakerName": "「老板」",
            "text": "我、我不是故意…我只是最下面的…",
            "nextDialogs": [
              "740430337"
            ]
          },
          "740430337": {
            "id": "740430337",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "啊啊？老板，说的什么胡话我没听清，我还以为您说自己「不是故意」…您再说一遍？",
            "nextDialogs": [
              "740430338"
            ]
          },
          "740430338": {
            "id": "740430338",
            "speakerId": 1003,
            "speakerName": "「老板」",
            "text": "噫噫——",
            "nextDialogs": [
              "740430339"
            ]
          },
          "740430339": {
            "id": "740430339",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "这位老板看来是累了。睁着眼晕过去了。",
            "nextDialogs": [
              "740430340"
            ]
          },
          "740430340": {
            "id": "740430340",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃呃，我、我们也不是故意的…",
            "nextDialogs": [
              "740430341"
            ]
          },
          "740430341": {
            "id": "740430341",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "关于这个嘛。我们决定，不追究了。",
            "nextDialogs": [
              "740430342"
            ]
          },
          "740430342": {
            "id": "740430342",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？没关系吗？",
            "nextDialogs": [
              "740430343"
            ]
          },
          "740430343": {
            "id": "740430343",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "反正只要核心完好，其中的数据完好，机器根本没所谓。",
            "nextDialogs": [
              "740430344"
            ]
          },
          "740430344": {
            "id": "740430344",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "上面说了没所谓。反正不能跟你们过不去。",
            "nextDialogs": [
              "740430345"
            ]
          },
          "740430345": {
            "id": "740430345",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么跟我过不去的？",
            "nextDialogs": [
              "740430346"
            ]
          },
          "740430346": {
            "id": "740430346",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "没什么，没什么。您瞧…",
            "nextDialogs": [
              "740430347"
            ]
          },
          "740430347": {
            "id": "740430347",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "我们只是在散步而已。",
            "nextDialogs": [
              "740430348"
            ]
          },
          "740430348": {
            "id": "740430348",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "真是偶遇，不是吗？美好的天气，美好的邂逅。",
            "nextDialogs": [
              "740430349"
            ]
          },
          "740430349": {
            "id": "740430349",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "但是美好的邂逅总会结束。我们该…告别了。",
            "nextDialogs": [
              "740430350"
            ]
          },
          "740430350": {
            "id": "740430350",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "就让美好的邂逅留在心中，或者…",
            "nextDialogs": [
              "740430351"
            ]
          },
          "740430351": {
            "id": "740430351",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "忘了更好。忘了更好。",
            "nextDialogs": [
              "740430352"
            ]
          },
          "740430352": {
            "id": "740430352",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "欸…所以我们没事了？",
            "nextDialogs": [
              "740430353"
            ]
          },
          "740430353": {
            "id": "740430353",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "怎么，你想有什么事？",
            "nextDialogs": [
              "740430354"
            ]
          },
          "740430354": {
            "id": "740430354",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "没事没事！哈哈，当然没事了！",
            "nextDialogs": [
              "740430355"
            ]
          },
          "740430355": {
            "id": "740430355",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "唉，本来我还以为遇上了好心人，总算能通过劳动改变命运了。到头来，这世上还是坏人多！",
            "nextDialogs": [
              "740430356"
            ]
          },
          "740430356": {
            "id": "740430356",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "…喂，恩里。来搭把手。",
            "nextDialogs": [
              "740430357"
            ]
          },
          "740430357": {
            "id": "740430357",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "啊？",
            "nextDialogs": [
              "740430358"
            ]
          },
          "740430358": {
            "id": "740430358",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "真是不幸啊，这位好心的老板神志不清了。",
            "nextDialogs": [
              "740430359"
            ]
          },
          "740430359": {
            "id": "740430359",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "我们需要一位…",
            "nextDialogs": [
              "740430360"
            ]
          },
          "740430360": {
            "id": "740430360",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "干活认真。",
            "nextDialogs": [
              "740430361"
            ]
          },
          "740430361": {
            "id": "740430361",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "忠实可靠。",
            "nextDialogs": [
              "740430362"
            ]
          },
          "740430362": {
            "id": "740430362",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "希望用劳动改变命运的…好朋友。",
            "nextDialogs": [
              "740430363"
            ]
          },
          "740430363": {
            "id": "740430363",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "没错，一位好朋友。来帮忙把这位好老板带到我们的安全屋去。",
            "nextDialogs": [
              "740430364"
            ]
          },
          "740430364": {
            "id": "740430364",
            "speakerId": 1004,
            "speakerName": "亨特",
            "text": "我们才方便…好好跟这位好心的老板聊聊。",
            "nextDialogs": [
              "740430365"
            ]
          },
          "740430365": {
            "id": "740430365",
            "speakerId": 1005,
            "speakerName": "特纳",
            "text": "当然了，我们会充分地…表达我们的谢意。通过摩拉。",
            "nextDialogs": [
              "740430366"
            ]
          },
          "740430366": {
            "id": "740430366",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "嗯？嗯！算我一个！",
            "nextDialogs": [
              "740430367"
            ]
          },
          "740430367": {
            "id": "740430367",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "太好了！谢谢你们！也很感谢你们，那个…",
            "nextDialogs": [
              "740430368"
            ]
          },
          "740430368": {
            "id": "740430368",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我是{NICKNAME}，她是派蒙。",
            "nextDialogs": [
              "740430369"
            ]
          },
          "740430369": {
            "id": "740430369",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "#谢谢你们，{NICKNAME}、派蒙！遇到你们以后，我的命运都改变啦！",
            "nextDialogs": [
              "740430370"
            ]
          },
          "740430370": {
            "id": "740430370",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不用谢！要加油哦，恩里！不要再被骗了！",
            "nextDialogs": [
              "740430371"
            ]
          },
          "740430371": {
            "id": "740430371",
            "speakerId": 1000,
            "speakerName": "恩里",
            "text": "嗯！不会的！我要努力工作，成为大富翁！以后雇佣别人给我干活！",
            "nextDialogs": [
              "740430372"
            ]
          },
          "740430372": {
            "id": "740430372",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "亨特、特纳和恩里将不省人事的愚人众挖了出来，带走了。",
            "nextDialogs": [
              "740430373"
            ]
          },
          "740430373": {
            "id": "740430373",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "希望恩里能获得幸福呢…",
            "nextDialogs": [
              "740430374"
            ]
          },
          "740430374": {
            "id": "740430374",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等！恩里说好的，给我们的报酬呢？！"
          }
        }
      }
    },

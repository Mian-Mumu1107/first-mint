          },
          "205030203": {
            "id": "205030203",
            "speakerId": 1417,
            "speakerName": "瓦格纳",
            "text": "都在那边，自己挑吧。想要更称手的，我也能定做。",
            "nextDialogs": [
              "205030207"
            ]
          },
          "205030207": {
            "id": "205030207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来还能定做…",
            "nextDialogs": [
              "205030208"
            ]
          },
          "205030208": {
            "id": "205030208",
            "speakerId": 1417,
            "speakerName": "瓦格纳",
            "text": "当然。贩卖，定做，精炼，都是铁匠铺的生意。",
            "nextDialogs": [
              "205030209"
            ]
          },
          "205030209": {
            "id": "205030209",
            "speakerId": 1417,
            "speakerName": "瓦格纳",
            "text": "只要你有矿石就行。"
          },
          "205030205": {
            "id": "205030205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没听说这回事啊！要让我打头阵吗？",
            "nextDialogs": [
              "205030206"
            ]
          },
          "205030206": {
            "id": "205030206",
            "speakerId": 1417,
            "speakerName": "瓦格纳",
            "text": "这么小一只，嗯，那要定做了。"
          }
        }
      }
    },

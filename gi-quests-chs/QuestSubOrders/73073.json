      }
    },
    {
      "subId": "7307307",
      "subQuestName": "挖掘「阿麦塔机关」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730701"
        ],
        "dialogs": {
          "730730701": {
            "id": "730730701",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "唔…没错，这个的确是阿麦塔机关…",
            "nextDialogs": [
              "730730702"
            ]
          },
          "730730702": {
            "id": "730730702",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "怎么样我没骗你们吧！",
            "nextDialogs": [
              "730730703"
            ]
          },
          "730730703": {
            "id": "730730703",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好耶，这样就能去打开那个大机器人了吧，已经开始期待了呢。",
            "nextDialogs": [
              "730730704"
            ]
          },
          "730730704": {
            "id": "730730704",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "呃，但是这个只是一块碎片，没有完整的阿麦塔机关，还是没办法打开遗迹巨像的。",
            "nextDialogs": [
              "730730705"
            ]
          },
          "730730705": {
            "id": "730730705",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "虽然只要没有被彻底毁坏的话我肯定是能修好的啦，不过得想办法找到剩下的碎片才行。",
            "nextDialogs": [
              "730730706"
            ]
          },
          "730730706": {
            "id": "730730706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以剩下的碎片…",
            "nextDialogs": [
              "730730707"
            ]
          },
          "730730707": {
            "id": "730730707",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "哎呀你们别着急嘛，这个机关是被分成了三个部分来着。",
            "nextDialogs": [
              "730730708"
            ]
          },
          "730730708": {
            "id": "730730708",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "不过祖父当初是怎么把它们丢在了三个不同的地方的…可惜，应该会是个很精彩的故事的，可是我一点也想不起来了。",
            "nextDialogs": [
              "730730709"
            ]
          },
          "730730709": {
            "id": "730730709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "三个不同的地方…就是说这里面记录了碎片所在的位置咯？",
            "nextDialogs": [
              "730730710"
            ]
          },
          "730730710": {
            "id": "730730710",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "嗯，没错，机关碎片埋藏的地点都记录在这本手册里了。埋在这里的这块碎片应该也是我们当时从不知道什么地方找到的吧。",
            "nextDialogs": [
              "730730711"
            ]
          },
          "730730711": {
            "id": "730730711",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#这样的话，我们就根据这个去找齐剩下的两块碎片吧，我们最擅长找东西了。对吧，{NICKNAME}？",
            "nextDialogs": [
              "730730713"
            ]
          },
          "730730713": {
            "id": "730730713",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#嗯，我知道你的意思，没关系我们一定会找到{F#他}{M#她}的。",
            "nextDialogs": [
              "730730715"
            ]
          },
          "730730715": {
            "id": "730730715",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "话是这样说哪，不过…",
            "nextDialogs": [
              "730730716"
            ]
          },
          "730730716": {
            "id": "730730716",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过？",
            "nextDialogs": [
              "730730717"
            ]
          },
          "730730717": {
            "id": "730730717",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "不过我看不懂哪…",
            "nextDialogs": [
              "730730718"
            ]
          },
          "730730718": {
            "id": "730730718",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，这个难道不是你自己写的吗？",
            "nextDialogs": [
              "730730719"
            ]
          },
          "730730719": {
            "id": "730730719",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "唔…怎么说呢，这个其实是我们两个…唉，或许是三个人共同的冒险笔记。",
            "nextDialogs": [
              "730730720"
            ]
          },
          "730730720": {
            "id": "730730720",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "虽然第三个人我已经想不起来了，不过那个老头子我可忘不了。如果你们想要知道剩下机关碎片的位置，就去找他吧。",
            "nextDialogs": [
              "730730721"
            ]
          },
          "730730721": {
            "id": "730730721",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "那个老头子应该还活着吧，如果还活着的话肯定就还在维摩庄了。毕竟是说要一辈子待在这个地方的家伙。",
            "nextDialogs": [
              "730730722"
            ]
          },
          "730730722": {
            "id": "730730722",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你说的老头子该不会是…",
            "nextDialogs": [
              "730730723"
            ]
          },
          "730730723": {
            "id": "730730723",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "阿玛兹亚爷爷吧。",
            "nextDialogs": [
              "730730724"
            ]
          },
          "730730724": {
            "id": "730730724",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "哦？你们认识那个老头子吗，这样就好办了。你们把这本手册拿去给他看看吧，他应该会明白的。",
            "nextDialogs": [
              "730730725"
            ]
          },
          "730730725": {
            "id": "730730725",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？你不和我们一起去吗？",
            "nextDialogs": [
              "730730726"
            ]
          },
          "730730726": {
            "id": "730730726",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "哼，我可不想见到那个老家伙。",
            "nextDialogs": [
              "730730727"
            ]
          },
          "730730727": {
            "id": "730730727",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "你们如果搞清楚了碎片埋藏的地点，就自己去找吧，虽然我也很想跟你们一起去啦，不过我这副老骨头已经折腾不动了。",
            "nextDialogs": [
              "730730728"
            ]
          },
          "730730728": {
            "id": "730730728",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "年轻的时候我也想要成为一个像祖父一样伟大的冒险家，如果不是因为那个家伙的话…",
            "nextDialogs": [
              "730730729"
            ]
          },
          "730730729": {
            "id": "730730729",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "不过比起冒险，对我来说更重要的果然还是故事。如果你们收集到了什么故事的话，记得带回来给我。",
            "nextDialogs": [
              "730730730"
            ]
          },
          "730730730": {
            "id": "730730730",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "作为报酬，这个机关碎片就交给你们了，怎么样，很划算吧。"
          }
        }
      }
    },
    {
      "subId": "7307308",
      "subQuestName": "与阿玛兹亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730731001"
        ],
        "dialogs": {
          "730731001": {
            "id": "730731001",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "又是你们，拉娜带来的小客人。拉娜没和你们一起吗？怎么这次巡林这么久…",
            "nextDialogs": [
              "730731002"
            ]
          },
          "730731002": {
            "id": "730731002",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "不过你们特意过来找我，应该是遇到什么事了吧。",
            "nextDialogs": [
              "730731003"
            ]
          },
          "730731003": {
            "id": "730731003",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个嘛，其实是因为…",
            "nextDialogs": [
              "730731004"
            ]
          },
          "730731004": {
            "id": "730731004",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "和阿玛兹亚爷爷说了罗因贾、秘密基地和冒险手册的事情。\\n实在是很曲折。",
            "nextDialogs": [
              "730731005"
            ]
          },
          "730731005": {
            "id": "730731005",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "原来是这样，你们去过那个秘密基地了啊，怎么样，是不是很厉害。",
            "nextDialogs": [
              "730731006"
            ]
          },
          "730731006": {
            "id": "730731006",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "罗因贾这个家伙，都已经跑到维摩庄来了还是不愿意见我一面，真是越老越顽固了啊。",
            "nextDialogs": [
              "730731007"
            ]
          },
          "730731007": {
            "id": "730731007",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "不过确实也是他的性格，离上次见到他已经快有十年了吧。",
            "nextDialogs": [
              "730731008"
            ]
          },
          "730731008": {
            "id": "730731008",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "那次还是因为要去奥摩斯港处理一些事情才碰到的。听到他还是老样子我就放心了。",
            "nextDialogs": [
              "730731009"
            ]
          },
          "730731009": {
            "id": "730731009",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们的关系还真是奇怪。",
            "nextDialogs": [
              "730731010"
            ]
          },
          "730731010": {
            "id": "730731010",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以罗因贾爷爷为什么不愿意见你呀？",
            "nextDialogs": [
              "730731011"
            ]
          },
          "730731011": {
            "id": "730731011",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "哎呀，说来话长，你们想听我这个老头子叨叨吗？",
            "nextDialogs": [
              "730731013",
              "730731015"
            ]
          },
          "730731013": {
            "id": "730731013",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！派蒙也很好奇。",
            "nextDialogs": [
              "730731016"
            ]
          },
          "730731016": {
            "id": "730731016",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "小的时候，因为祖父的原因，罗因贾那个家伙在维摩庄住过很长一段时间。",
            "nextDialogs": [
              "730731017"
            ]
          },
          "730731017": {
            "id": "730731017",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "因为是从繁华的奥摩斯港来的孩子，还有一个传奇的冒险家祖父，所以理所当然的，他很快就成了孩子们的焦点。",
            "nextDialogs": [
              "730731018"
            ]
          },
          "730731018": {
            "id": "730731018",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "维摩庄的孩子们都被他从祖父那里听来的故事吸引了，我也是那些孩子中的一个。",
            "nextDialogs": [
              "730731019"
            ]
          },
          "730731019": {
            "id": "730731019",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "我们一起在那边的山洞里建造了秘密基地，用树枝和花朵把自己装扮成武士与英雄。",
            "nextDialogs": [
              "730731020"
            ]
          },
          "730731020": {
            "id": "730731020",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "对还是孩子的我们而言，那个秘密基地就像是幻想的异世界。光是在这个山洞里面我们就能完成无数的传奇与冒险了。",
            "nextDialogs": [
              "730731021"
            ]
          },
          "730731021": {
            "id": "730731021",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "现在想起来那些时光都仿佛是在梦里一样。",
            "nextDialogs": [
              "730731022"
            ]
          },
          "730731022": {
            "id": "730731022",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好像罗因贾爷爷也提过，这个秘密基地以前有好多好多人。不过后来为什么会变成这样呢？"
          },
          "730731015": {
            "id": "730731015",
            "speakerId": 1004,
            "speakerName": "阿玛兹亚",
            "text": "哈哈，我会长话短说的。"
          }
        }
      }
    },
    {

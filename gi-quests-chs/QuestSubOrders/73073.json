    {
      "subId": "7307305",
      "subQuestName": "挖掘埋藏之物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730601"
        ],
        "dialogs": {
          "730730601": {
            "id": "730730601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "让我来看看挖出了什么宝物…咦，是一本小册子呀。",
            "nextDialogs": [
              "730730602"
            ]
          },
          "730730602": {
            "id": "730730602",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "哦哦，这个可是好东西呢，是我们当初的「冒险手册」。",
            "nextDialogs": [
              "730730603"
            ]
          },
          "730730603": {
            "id": "730730603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「冒险手册」？",
            "nextDialogs": [
              "730730604"
            ]
          },
          "730730604": {
            "id": "730730604",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "你们不知道冒险手册这种东西吗？看你们的样子，又是来找宝物什么的，我还以为你们是从外国来的冒险家呢。",
            "nextDialogs": [
              "730730607"
            ]
          },
          "730730607": {
            "id": "730730607",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "对吧，很多冒险家都会写的。像是冒险日志什么的，把自己的冒险经历、冒险计划甚至宝藏的线索记录下来。",
            "nextDialogs": [
              "730730608"
            ]
          },
          "730730608": {
            "id": "730730608",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "就像你们知道的，我的祖父是伟大的冒险家，虽然他的冒险日志我是看不懂啦。",
            "nextDialogs": [
              "730730609"
            ]
          },
          "730730609": {
            "id": "730730609",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "不过因为从小就憧憬着成为冒险家，所以我也装模作样地搞了这本冒险手册呢，可以说是我梦想的起点一样的东西。",
            "nextDialogs": [
              "730730610"
            ]
          },
          "730730610": {
            "id": "730730610",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "虽然知道这个东西对你很重要啦，不过好像对我们要找的机关没有什么帮助哪。",
            "nextDialogs": [
              "730730611"
            ]
          },
          "730730611": {
            "id": "730730611",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "话可不能这么说，我不是说过我还计划过去找你们说的那个阿麦塔机关吗？不管最后怎么样，都记录在这个冒险手册里了。",
            "nextDialogs": [
              "730730612"
            ]
          },
          "730730612": {
            "id": "730730612",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "让我看看…我记得当初我们两个人…咦？这里面为什么画的会是三个人，我的记性已经这么差了吗？还是我的眼睛花了？",
            "nextDialogs": [
              "730730613"
            ]
          },
          "730730613": {
            "id": "730730613",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "需要我把眼镜借给你吗？我这可是教令院配发的最新款式。",
            "nextDialogs": [
              "730730614"
            ]
          },
          "730730614": {
            "id": "730730614",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "大学者你真的…算了，先让我仔细看看…现在我非常确定，阿麦塔机关应该就被我埋在这里了。",
            "nextDialogs": [
              "730730615"
            ]
          },
          "730730615": {
            "id": "730730615",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "太好了，接下来只要在这个山洞里搜寻就好了，虽然这里还…挺大的。",
            "nextDialogs": [
              "730730616"
            ]
          },
          "730730616": {
            "id": "730730616",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "用不着这么麻烦，这里面记录了机关埋藏的位置，应该就在…"
          }
        }
      }
    },
    {
      "subId": "7307306",
      "subQuestName": "挖掘「阿麦塔机关」",
      "sceneId": null,
      "locations": [],

  "subQuests": [
    {
      "subId": "7307301",
      "subQuestName": "寻找「秘密基地」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730101"
        ],
        "dialogs": {
          "730730101": {
            "id": "730730101",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "哎呀，应该就在这附近的某个山洞里，难不成是我记错了吗？",
            "nextDialogs": [
              "730730102"
            ]
          },
          "730730102": {
            "id": "730730102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "要不去问问维摩庄的村民呢？如果这里有山洞的话，他们应该会知道吧。",
            "nextDialogs": [
              "730730103"
            ]
          },
          "730730103": {
            "id": "730730103",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "村民…还是算了吧，这可是秘密基地，他们怎么会知道。如果我没记错的话，洞口应该就在这些藤蔓的后面，我们分头找吧。",
            "nextDialogs": [
              "730730104"
            ]
          },
          "730730104": {
            "id": "730730104",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "我和这位大学者去那边看看，这里就交给二位了。",
            "nextDialogs": [
              "730730105"
            ]
          },
          "730730105": {
            "id": "730730105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我们就从这边的藤蔓开始调查吧。不过这里的藤蔓也太多了一点吧。",
            "nextDialogs": [
              "730730106"
            ]
          },
          "730730106": {
            "id": "730730106",
            "speakerId": 1002,
            "speakerName": "兰利遮",
            "text": "这些不是藤蔓，是「桓摩达」哦。",
            "nextDialogs": [
              "730730107"
            ]
          },
          "730730107": {
            "id": "730730107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？兰利遮知道些什么吗？",
            "nextDialogs": [
              "730730108"
            ]
          },
          "730730108": {
            "id": "730730108",
            "speakerId": 1002,
            "speakerName": "兰利遮",
            "text": "嗯，这些是桓摩达，桓摩达是兰那罗做的。",
            "nextDialogs": [
              "730730109"
            ]
          },
          "730730109": {
            "id": "730730109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么兰那罗要做这个？",
            "nextDialogs": [
              "730730110"
            ]
          },
          "730730110": {
            "id": "730730110",
            "speakerId": 1002,
            "speakerName": "兰利遮",
            "text": "不想让那菈进去的地方，兰那罗就会做桓摩达，有了桓摩达，只有兰那罗才能进去。",
            "nextDialogs": [
              "730730111"
            ]
          },
          "730730111": {
            "id": "730730111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，虽然兰那罗是很小只啦，不过这里看上去已经完全被堵上了，就算是兰那罗也进不去吧！",
            "nextDialogs": [
              "730730112"
            ]
          },
          "730730112": {
            "id": "730730112",
            "speakerId": 1002,
            "speakerName": "兰利遮",
            "text": "那菈进不去，但是兰那罗可以唱歌，桓摩达听见歌声，就会转起来。桓摩达转起来就能进去了。",
            "nextDialogs": [
              "730730115"
            ]
          },
          "730730115": {
            "id": "730730115",
            "speakerId": 1002,
            "speakerName": "兰利遮",
            "text": "#嗯！那菈{NICKNAME}是森林的朋友。那菈{NICKNAME}唱歌，桓摩达也能听见，兰利遮教你！"
          }
        }
      }
    },
    {
      "subId": "7307302",
      "subQuestName": "转动「桓摩达」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730201"
        ],
        "dialogs": {
          "730730201": {
            "id": "730730201",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "我记得应该就在这附近…",
            "nextDialogs": [
              "730730202"
            ]
          },
          "730730202": {
            "id": "730730202",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "怎么会找不到呢…"
          }
        }
      }
    },
    {
      "subId": "7307309",
      "subQuestName": "转动「桓摩达」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730401"
        ],
        "dialogs": {
          "730730401": {
            "id": "730730401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！真的像球一样转起来了欸。",
            "nextDialogs": [
              "730730402"
            ]
          },
          "730730402": {
            "id": "730730402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "神秘的洞口出现了。",
            "nextDialogs": [
              "730730403"
            ]
          },
          "730730403": {
            "id": "730730403",
            "speakerId": 1002,
            "speakerName": "兰利遮",
            "text": "这个洞口，兰利遮记得。",
            "nextDialogs": [
              "730730404"
            ]
          },
          "730730404": {
            "id": "730730404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？这个桓摩达该不会是兰利遮做的吧？",
            "nextDialogs": [
              "730730405"
            ]
          },
          "730730405": {
            "id": "730730405",
            "speakerId": 1002,
            "speakerName": "兰利遮",
            "text": "兰利遮也不记得了，但是兰利遮知道，要保护小那菈。",
            "nextDialogs": [
              "730730406"
            ]
          },
          "730730406": {
            "id": "730730406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然不知道为什么这里会被兰那罗封印起来，不过这个应该就是通往秘密基地的入口了吧，去把他们两个也叫过来吧。",
            "nextDialogs": [
              "730730407"
            ]
          },
          "730730407": {
            "id": "730730407",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "哈哈，果然我没记错就在这边。从这里进去就是我们当初的秘密基地了，你们是怎么找到的？",
            "nextDialogs": [
              "730730408"
            ]
          },
          "730730408": {
            "id": "730730408",
            "speakerId": 1002,
            "speakerName": "兰利遮",
            "text": "兰利遮，厉害。",
            "nextDialogs": [
              "730730409"
            ]
          },
          "730730409": {
            "id": "730730409",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "既然找到了洞口我们就赶紧进去吧，接下来只要找到「阿麦塔机关」…",
            "nextDialogs": [
              "730730410"
            ]
          },
          "730730410": {
            "id": "730730410",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "里面还蛮大的哦，你们可不要被吓到了。"
          }
        }
      }
    },
    {
      "subId": "7307303",
      "subQuestName": "调查「秘密基地」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730501"
        ],
        "dialogs": {
          "730730501": {
            "id": "730730501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！这个地方真的好大，小时候的罗因贾爷爷好厉害！",
            "nextDialogs": [
              "730730502"
            ]
          },
          "730730502": {
            "id": "730730502",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "怎么样，不错吧！不过比起我印象中小了许多呢。",
            "nextDialogs": [
              "730730504",
              "730730506"
            ]
          },
          "730730504": {
            "id": "730730504",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "哈哈，何止是长大了，都是老头子啦。",
            "nextDialogs": [
              "730730507"
            ]
          },
          "730730507": {
            "id": "730730507",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "不过这里真的一点都没变，就像是时间静止了一样。",
            "nextDialogs": [
              "730730508"
            ]
          },
          "730730508": {
            "id": "730730508",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "连空气都还是那个时候的味道，光是闻到这个味道我就想起了好多好多事情…",
            "nextDialogs": [
              "730730509"
            ]
          },
          "730730509": {
            "id": "730730509",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "事不宜迟，你想起「阿麦塔机关」在哪了吗？",
            "nextDialogs": [
              "730730510"
            ]
          },
          "730730510": {
            "id": "730730510",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "别着急嘛，年轻人。我们先四处看看吧。",
            "nextDialogs": [
              "730730511"
            ]
          },
          "730730511": {
            "id": "730730511",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "刚才进来的时候就很在意了，这个巨大的机器零件是怎么回事呀？",
            "nextDialogs": [
              "730730512"
            ]
          },
          "730730512": {
            "id": "730730512",
            "speakerId": 1002,
            "speakerName": "兰利遮",
            "text": "喔，兰利遮知道，这个是从大铁山那里搬过来的。",
            "nextDialogs": [
              "730730513"
            ]
          },
          "730730513": {
            "id": "730730513",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "大铁山…就是说是从之前那个遗迹巨像那里拆下来的咯？",
            "nextDialogs": [
              "730730514"
            ]
          },
          "730730514": {
            "id": "730730514",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "你也发现了吗？根据上面的纹案判断，虽然不知道为什么会被摆成这个样子，不过这些零件应该是属于那架遗迹巨像的。",
            "nextDialogs": [
              "730730515"
            ]
          },
          "730730515": {
            "id": "730730515",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "说不定你真的很有搞学术的天赋欸。等这个项目告一段落，要不要我帮忙推荐你去教令院学习呢？",
            "nextDialogs": [
              "730730516"
            ]
          },
          "730730516": {
            "id": "730730516",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "在那里你肯定能交到很多朋友的。",
            "nextDialogs": [
              "730730517"
            ]
          },
          "730730517": {
            "id": "730730517",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然不是这么回事啦…不过还是谢谢你了。",
            "nextDialogs": [
              "730730518"
            ]
          },
          "730730518": {
            "id": "730730518",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过这么大的零件怎么看都不是小孩子能搬动的，到底是什么人把它堆成这个样子的呢？",
            "nextDialogs": [
              "730730519"
            ]
          },
          "730730519": {
            "id": "730730519",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "说不定是什么森林里的精灵干的呢…我开玩笑的，我也记不清了。",
            "nextDialogs": [
              "730730520"
            ]
          },
          "730730520": {
            "id": "730730520",
            "speakerId": 1002,
            "speakerName": "兰利遮",
            "text": "知道了，是兰利遮搬的。",
            "nextDialogs": [
              "730730521"
            ]
          },
          "730730521": {
            "id": "730730521",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这么大兰利遮怎么搬得动啦！",
            "nextDialogs": [
              "730730522"
            ]
          },
          "730730522": {
            "id": "730730522",
            "speakerId": 1002,
            "speakerName": "兰利遮",
            "text": "兰利遮，厉害，所以搬得动。",
            "nextDialogs": [
              "730730523"
            ]
          },
          "730730523": {
            "id": "730730523",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "哈哈，我记得那个时候我们两群孩子还围着这个大家伙玩打仗游戏呢。"
          },
          "730730506": {
            "id": "730730506",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "那个时候我也是小孩子啊，现在都是老头子啦。"
          }
        }
      }
    },
    {
      "subId": "7307304",
      "subQuestName": "挖掘埋藏之物",
      "sceneId": null,
      "locations": [],

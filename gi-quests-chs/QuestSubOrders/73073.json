    {
      "subId": "7307314",
      "subQuestName": "回到「秘密基地」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730731401"
        ],
        "dialogs": {
          "730731401": {
            "id": "730731401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "罗因贾爷爷，我们回来了！",
            "nextDialogs": [
              "730731402"
            ]
          },
          "730731402": {
            "id": "730731402",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "哦哦，你们终于回来了，看你们的样子，应该见过那个老头子，也找到你们想要的机关碎片了吧。",
            "nextDialogs": [
              "730731403"
            ]
          },
          "730731403": {
            "id": "730731403",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "别的先不提，虽然我也不是很关心啦，不过那个老头子还是像以前一样无趣吗？",
            "nextDialogs": [
              "730731406"
            ]
          },
          "730731406": {
            "id": "730731406",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "嗯？是那个老家伙跟你们说了些什么吗，你们可别相信他的话，如果不是他在出海冒险的前一天晚上偷偷溜回了这个村子…",
            "nextDialogs": [
              "730731407"
            ]
          },
          "730731407": {
            "id": "730731407",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "我们现在说不定已经是历史上最伟大的冒险家之一了。"
          }
        }
      }
    },
    {
      "subId": "7307312",
      "subQuestName": "在「秘密基地」和罗因贾对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7307313",
      "subQuestName": "和加扎里对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730731501"
        ],
        "dialogs": {
          "730731501": {
            "id": "730731501",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "谢天谢地，你们终于回来了。",
            "nextDialogs": [
              "730731502"
            ]
          },
          "730731502": {
            "id": "730731502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "剩下的两块碎片…",
            "nextDialogs": [
              "730731503"
            ]
          },
          "730731503": {
            "id": "730731503",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "啊啊，没错，就是这个，真是辛苦你们了，剩下的事情就交给我吧。",
            "nextDialogs": [
              "730731504"
            ]
          },
          "730731504": {
            "id": "730731504",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "加扎里修好了「阿麦塔机关」。",
            "nextDialogs": [
              "730731505"
            ]
          },
          "730731505": {
            "id": "730731505",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "嗯，这样应该就能用了，不愧是我啊。就算是教令院的诃般荼，也做不到不查阅任何资料就修好这个东西吧。",
            "nextDialogs": [
              "730731506"
            ]
          },
          "730731506": {
            "id": "730731506",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "多亏你们碰到了我，这下我们终于能进到那台遗迹巨像里面了！",
            "nextDialogs": [
              "730731507"
            ]
          },
          "730731507": {
            "id": "730731507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这话应该我们来说才对吧。",
            "nextDialogs": [
              "730731508"
            ]
          },
          "730731508": {
            "id": "730731508",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "啊，不知道都有几百年没有人进去过了，这下我肯定会在学术史上留名的！哎呀，不好意思，我太激动了。",
            "nextDialogs": [
              "730731509"
            ]
          },
          "730731509": {
            "id": "730731509",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "派蒙也开始激动了呢！不管是经费还是宝藏，我们可要来了！"
          }
        }
      }
    },
    {
      "subId": "7307303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730301"
        ],
        "dialogs": {
          "730730301": {
            "id": "730730301",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "为什么我会在这里找什么秘密基地…唉，没办法都是为了学术研究…",
            "nextDialogs": [
              "730730302"
            ]
          },
          "730730302": {
            "id": "730730302",
            "speakerId": 1003,
            "speakerName": "加扎里",
            "text": "再不赶紧找到「阿麦塔机关」的话，研究进度就要跟不上了…"
          }
        }
      }
    },
    {
      "subId": "7307308",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730730801"
        ],
        "dialogs": {
          "730730801": {
            "id": "730730801",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "真是令人怀念的地方，好像这里的泥土和空气都想告诉我什么…不过我却什么也想不起来了。",
            "nextDialogs": [
              "730730802"
            ]
          },
          "730730802": {
            "id": "730730802",
            "speakerId": 1000,
            "speakerName": "罗因贾",
            "text": "你们找到你们要找的机关碎片了吗，记得把收集到的故事带回来给我。"
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "1501801",
      "subQuestName": "和路边的少女交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150180201"
        ],
        "dialogs": {
          "150180201": {
            "id": "150180201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来你就是瓦雷莎，我们听过这个名字！",
            "nextDialogs": [
              "150180202"
            ]
          },
          "150180202": {
            "id": "150180202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我是派蒙，{M#他}{F#她}叫{NICKNAME}，我们是最好的伙伴。",
            "nextDialogs": [
              "150180203"
            ]
          },
          "150180203": {
            "id": "150180203",
            "speakerId": 1098,
            "speakerName": "瓦雷莎",
            "text": "#好的，派蒙和{NICKNAME}，真是不错的名字，我记住了。",
            "nextDialogs": [
              "150180204"
            ]
          },
          "150180204": {
            "id": "150180204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们这就出发吧！"
          }
        }
      }
    },
    {

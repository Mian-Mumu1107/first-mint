  "subQuests": [
    {
      "subId": "7083301",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "618010301"
        ],
        "dialogs": {
          "618010301": {
            "id": "618010301",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "呵…这下就天衣无缝了…",
            "nextDialogs": [
              "618010302"
            ]
          },
          "618010302": {
            "id": "618010302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "洛恩你这是在…写报告？",
            "nextDialogs": [
              "618010303"
            ]
          },
          "618010303": {
            "id": "618010303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真意外，我还以为你会比法尔伽更讨厌这些文书工作…",
            "nextDialogs": [
              "618010304"
            ]
          },
          "618010304": {
            "id": "618010304",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "怎么会呢，这也是一队之长应尽的责任啊，虽然我还只是副队长。",
            "nextDialogs": [
              "618010305"
            ]
          },
          "618010305": {
            "id": "618010305",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "这份报告关系到远征军回归后的人事安排，还需要远征时主管行政的西蒙枢机卿过目。",
            "nextDialogs": [
              "618010306"
            ]
          },
          "618010306": {
            "id": "618010306",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "对了，你要是刚好有空回蒙德城一趟，干脆顺手帮我捎过去？",
            "nextDialogs": [
              "618010309"
            ]
          },
          "618010309": {
            "id": "618010309",
            "speakerId": 1326,
            "speakerName": "洛恩",
            "text": "哈哈，就是因为很重要，所以才想托付给你嘛，「荣誉骑士」。"
          }
        }
      }
    },
    {
      "subId": "7083302",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "618010401"
        ],
        "dialogs": {
          "618010401": {
            "id": "618010401",
            "speakerId": 1789,
            "speakerName": "西蒙·佩奇",
            "text": "你好，荣誉骑士。今日造访，是为了什么事呢？",
            "nextDialogs": [
              "618010402"
            ]
          },
          "618010402": {
            "id": "618010402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "洛恩请我来送一份报告…",
            "nextDialogs": [
              "618010403"
            ]
          },
          "618010403": {
            "id": "618010403",
            "speakerId": 1789,
            "speakerName": "西蒙·佩奇",
            "text": "洛恩？他居然会按时交报告？真是不可思议…我看一看…",
            "nextDialogs": [
              "618010404"
            ]
          },
          "618010404": {
            "id": "618010404",
            "speakerId": 1789,
            "speakerName": "西蒙·佩奇",
            "text": "嗯…字迹很工整，措辞也很严谨…",
            "nextDialogs": [
              "618010405"
            ]
          },
          "618010405": {
            "id": "618010405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那还有什么问题吗？",
            "nextDialogs": [
              "618010406"
            ]
          },
          "618010406": {
            "id": "618010406",
            "speakerId": 1789,
            "speakerName": "西蒙·佩奇",
            "text": "没什么问题——除了一眼就知道不是洛恩自己写的。八成是找君特或者乌苏拉代笔的吧。",
            "nextDialogs": [
              "618010407"
            ]
          },
          "618010407": {
            "id": "618010407",
            "speakerId": 1789,
            "speakerName": "西蒙·佩奇",
            "text": "不过这一次他好歹按时交了，看起来自己也检查过了…我就不多说什么了。",
            "nextDialogs": [
              "618010408"
            ]
          },
          "618010408": {
            "id": "618010408",
            "speakerId": 1789,
            "speakerName": "西蒙·佩奇",
            "text": "希望法尔伽团长跟风神大人也都能宽恕他吧。",
            "nextDialogs": [
              "618010409"
            ]
          },
          "618010409": {
            "id": "618010409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "法尔伽跟风神啊…",
            "nextDialogs": [
              "618010410"
            ]
          },
          "618010410": {
            "id": "618010410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…那多半是会宽恕的。"
          }
        }
      }
    }
  ]
}
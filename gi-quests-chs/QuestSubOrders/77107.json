    {
      "subId": "7710703",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771070301"
        ],
        "dialogs": {
          "771070301": {
            "id": "771070301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这、这是雷电被冻住了？！",
            "nextDialogs": [
              "771070302"
            ]
          },
          "771070302": {
            "id": "771070302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你还记得吗，阿格拉娅说过，拉莉莎死去的那一天，她愤怒卷起的风雪就连落雷也能冻住，该不会指的就是这个…",
            "nextDialogs": [
              "771070303"
            ]
          },
          "771070303": {
            "id": "771070303",
            "speakerId": 22280,
            "speakerName": "「灰眸」",
            "text": "看来「仪式」的最终地点就在顶部的…云端之上。",
            "nextDialogs": [
              "771070304"
            ]
          },
          "771070304": {
            "id": "771070304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呜哇…{NICKNAME}，攀登的时候可要小心呀，你要是忍不住往下看，我会帮你把眼睛遮起来的！"
          }
        }
      }
    },

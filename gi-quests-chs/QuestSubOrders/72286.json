  },
  "subQuests": [
    {
      "subId": "7228601",
      "subQuestName": "和古田聊聊$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722860101"
        ],
        "dialogs": {
          "722860101": {
            "id": "722860101",
            "speakerId": 1000,
            "speakerName": "古田",
            "text": "客人您来了？有好一阵子没见了吧。",
            "nextDialogs": [
              "722860103",
              "722860105"
            ]
          },
          "722860103": {
            "id": "722860103",
            "speakerId": 1000,
            "speakerName": "古田",
            "text": "您看我这记性，人年纪大了，记性是越来越差了。",
            "nextDialogs": [
              "722860106"
            ]
          },
          "722860106": {
            "id": "722860106",
            "speakerId": 1000,
            "speakerName": "古田",
            "text": "唉老婆子我不仅记性不行了，年轻人的那些喜好我也越来越琢磨不透了。",
            "nextDialogs": [
              "722860107"
            ]
          },
          "722860107": {
            "id": "722860107",
            "speakerId": 1000,
            "speakerName": "古田",
            "text": "之前有一个枫丹来的小伙子，说是要搞什么「映影」，叽叽咕咕和我们家主大人说了半天。",
            "nextDialogs": [
              "722860108"
            ]
          },
          "722860108": {
            "id": "722860108",
            "speakerId": 1000,
            "speakerName": "古田",
            "text": "啊呀，这人动不动就讲那个那个…「亲爱的」，真是不害臊，这话能随便乱说吗？"
          },
          "722860105": {
            "id": "722860105",
            "speakerId": 1000,
            "speakerName": "古田",
            "text": "我就说呢，虽然我年纪大了记性也越来越差，好歹这件事没记混。"
          }
        }
      }
    },
    {
      "subId": "7228602",
      "subQuestName": "寻找泽维尔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7228603",
      "subQuestName": "了解泽维尔的映影拍摄进展",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722860301"
        ],
        "dialogs": {
          "722860301": {
            "id": "722860301",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "这是第十一遍了，我真是搞不懂。",
            "nextDialogs": [
              "722860302"
            ]
          },
          "722860302": {
            "id": "722860302",
            "speakerId": 1002,
            "speakerName": "小春",
            "text": "呼…你直说吧，这次到底是哪里出了问题。",
            "nextDialogs": [
              "722860303"
            ]
          },
          "722860303": {
            "id": "722860303",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "这遍的问题在于，小春女士，您刚才的那段表演毫无激情。",
            "nextDialogs": [
              "722860304"
            ]
          },
          "722860304": {
            "id": "722860304",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "当时我写下那句台词的时候，心中充满了一股…一股空无而又热切的激情，对，空无而又热切。",
            "nextDialogs": [
              "722860305"
            ]
          },
          "722860305": {
            "id": "722860305",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "我需要您再耐心一些，用您的嗓音表现出这股丰满的情绪。",
            "nextDialogs": [
              "722860306"
            ]
          },
          "722860306": {
            "id": "722860306",
            "speakerId": 1002,
            "speakerName": "小春",
            "text": "哈？「空无又热切」的…「激情」，这是什么奇怪的形容？",
            "nextDialogs": [
              "722860307"
            ]
          },
          "722860307": {
            "id": "722860307",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "等一下，招募演员的告示上不是说，剧本是一位名作家写的吗？",
            "nextDialogs": [
              "722860308"
            ]
          },
          "722860308": {
            "id": "722860308",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "这样说当然没有错，这个故事原本是由名作家茅葺一庆的小说改编的，至于改编者嘛，正是鄙人。",
            "nextDialogs": [
              "722860309"
            ]
          },
          "722860309": {
            "id": "722860309",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "小春女士，笹野先生，让两位来回辛苦了这么多次我也很抱歉。",
            "nextDialogs": [
              "722860310"
            ]
          },
          "722860310": {
            "id": "722860310",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "但为了完美的艺术，这一切都是值得的，所以我希望…",
            "nextDialogs": [
              "722860311"
            ]
          },
          "722860311": {
            "id": "722860311",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "等等？叫茅葺一庆的我只知道一个，那可是个每次给八重堂投稿都会被退回的家伙。",
            "nextDialogs": [
              "722860312"
            ]
          },
          "722860312": {
            "id": "722860312",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "后来他不服气，还自费把自己的小说印了出来，结果一本都没卖出去。",
            "nextDialogs": [
              "722860313"
            ]
          },
          "722860313": {
            "id": "722860313",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "不是吧，折腾了我们十一遍的就是这人写出来的东西吗？",
            "nextDialogs": [
              "722860314"
            ]
          },
          "722860314": {
            "id": "722860314",
            "speakerId": 1002,
            "speakerName": "小春",
            "text": "啊！都是什么乱七八糟的，我受够了！",
            "nextDialogs": [
              "722860315"
            ]
          },
          "722860315": {
            "id": "722860315",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "呃，情况好像有点糟糕，总觉得小春很快就要忍不住揍人了。",
            "nextDialogs": [
              "722860316"
            ]
          },
          "722860316": {
            "id": "722860316",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们去打个招呼吧。",
            "nextDialogs": [
              "722860317"
            ]
          },
          "722860317": {
            "id": "722860317",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "那个…泽维尔，你们这是在拍摄映影吗？",
            "nextDialogs": [
              "722860318"
            ]
          },
          "722860318": {
            "id": "722860318",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好久不见。",
            "nextDialogs": [
              "722860319"
            ]
          },
          "722860319": {
            "id": "722860319",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "#哦，{NICKNAME}还有派蒙，两位亲爱的好朋友，能在这时候看到熟悉的面孔真是太好了。",
            "nextDialogs": [
              "722860320"
            ]
          },
          "722860320": {
            "id": "722860320",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "如您所见，继《第七个武士》之后，我终于想办法筹措到了一部新映影所需的资源。",
            "nextDialogs": [
              "722860321"
            ]
          },
          "722860321": {
            "id": "722860321",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "除了主角人选还没着落之外，感谢神里大人的慷慨大度，资金、道具，几乎一切前期问题都已经解决了。",
            "nextDialogs": [
              "722860322"
            ]
          },
          "722860322": {
            "id": "722860322",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "您不介意的话，我是想说您或许、可能、大概还记得我们以前的约定？",
            "nextDialogs": [
              "722860327",
              "722860325"
            ]
          },
          "722860327": {
            "id": "722860327",
            "speakerId": 1002,
            "speakerName": "小春",
            "text": "#欸，这位{NICKNAME}大人是我们社奉行大人的朋友，原来几位认识？",
            "nextDialogs": [
              "722860328"
            ]
          },
          "722860328": {
            "id": "722860328",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "#没错，{NICKNAME}是我在稻妻认识的第一位朋友，那些给我找活干的愚人众和部分难以沟通的武士大人不算。",
            "nextDialogs": [
              "722860329"
            ]
          },
          "722860329": {
            "id": "722860329",
            "speakerId": 1002,
            "speakerName": "小春",
            "text": "#能成为{NICKNAME}大人的朋友，那多少还是有点过人之处吧。",
            "nextDialogs": [
              "722860330"
            ]
          },
          "722860330": {
            "id": "722860330",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "看起来，泽维尔还是个厉害人物…",
            "nextDialogs": [
              "722860331"
            ]
          },
          "722860331": {
            "id": "722860331",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们是很好的朋友。",
            "nextDialogs": [
              "722860332"
            ]
          },
          "722860332": {
            "id": "722860332",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "您果真这么想吗？虽然我从来没有正式跟您说过，但在我心里，您早就是一位真正的朋友了。",
            "nextDialogs": [
              "722860333"
            ]
          },
          "722860333": {
            "id": "722860333",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "不是那些「亲爱的朋友」，而是可敬的、可信赖的真正的朋友。"
          },
          "722860325": {
            "id": "722860325",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "啊当然当然，毕竟过去的时间已经相当久了，您也有其他重要事务要处理，对此毫无印象也是非常合理的。",
            "nextDialogs": [
              "722860326"
            ]
          },
          "722860326": {
            "id": "722860326",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "您不用担心，我并不会感到意外或者失落，真的。"
          }
        }
      }
    },
    {
      "subId": "7228604",
      "subQuestName": "与泽维尔对话以开始拍摄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722860501"
        ],
        "dialogs": {
          "722860501": {
            "id": "722860501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准备好了。",
            "nextDialogs": [
              "722860502"
            ]
          },
          "722860502": {
            "id": "722860502",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "很好，那我们就开始吧。"
          }
        }
      }

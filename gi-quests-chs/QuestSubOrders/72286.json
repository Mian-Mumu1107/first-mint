    },
    {
      "subId": "7228606",
      "subQuestName": "完成「第一幕第二场」的拍摄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722860601"
        ],
        "dialogs": {
          "722860601": {
            "id": "722860601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没准备好。",
            "nextDialogs": [
              "722860602"
            ]
          },
          "722860602": {
            "id": "722860602",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "没关系，我们还有时间，等你准备好再开始吧。"
          }
        }
      }
    },
    {
      "subId": "7228610",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722861001"
        ],
        "dialogs": {
          "722861001": {
            "id": "722861001",
            "speakerId": 1002,
            "speakerName": "小春",
            "text": "请问，是大人授意您前来督察映影制作情况的吗？",
            "nextDialogs": [
              "722861002"
            ]
          },
          "722861002": {
            "id": "722861002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是古田有些担心你。",
            "nextDialogs": [
              "722861003"
            ]
          },
          "722861003": {
            "id": "722861003",
            "speakerId": 1002,
            "speakerName": "小春",
            "text": "是师父她？我，唉，我还是不够成熟，还不能让师父完全放心吧。"
          }
        }
      }
    },
    {
      "subId": "7228611",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722861101"
        ],
        "dialogs": {
          "722861101": {
            "id": "722861101",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "不行啊，这样下去根、根本没办法对…对抗他们。",
            "nextDialogs": [
              "722861102"
            ]
          },
          "722861102": {
            "id": "722861102",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "笹野先生，流畅！流畅点！",
            "nextDialogs": [
              "722861103"
            ]
          },
          "722861103": {
            "id": "722861103",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "（但是这些台词也太尴尬了吧。）",
            "nextDialogs": [
              "722861104"
            ]
          },
          "722861104": {
            "id": "722861104",
            "speakerId": 1002,
            "speakerName": "小春",
            "text": "只能由我们牺牲自己了。",
            "nextDialogs": [
              "722861105"
            ]
          },
          "722861105": {
            "id": "722861105",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "小春女士，感情！要有感情！",
            "nextDialogs": [
              "722861106"
            ]
          },
          "722861106": {
            "id": "722861106",
            "speakerId": 1002,
            "speakerName": "小春",
            "text": "（……）",
            "nextDialogs": [
              "722861110"
            ]
          },
          "722861110": {
            "id": "722861110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但我不会被这样打倒。"
          }
        }
      }
    },
    {
      "subId": "7228607",
      "subQuestName": "与泽维尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722860701"
        ],
        "dialogs": {
          "722860701": {
            "id": "722860701",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "…笹野先生，小春女士，你们太让我失望了。",
            "nextDialogs": [
              "722860702"
            ]
          },
          "722860702": {
            "id": "722860702",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "这些粗劣的片段和真正的映影之间的差距简直…简直就像蒙德的蒲公英酒和苹果酿，一个是酒一个不是，根本不是一回事。",
            "nextDialogs": [
              "722860703"
            ]
          },
          "722860703": {
            "id": "722860703",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "啊天，我也不知道该怎么形容了。",
            "nextDialogs": [
              "722860704"
            ]
          },
          "722860704": {
            "id": "722860704",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "你们一会儿记不住台词，一会儿乱念，一丁点情绪都没有，这样怎么能行？",
            "nextDialogs": [
              "722860705"
            ]
          },
          "722860705": {
            "id": "722860705",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "这是犯罪，对艺术的犯罪，朋友们我们不能这样。",
            "nextDialogs": [
              "722860706"
            ]
          },
          "722860706": {
            "id": "722860706",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "……",
            "nextDialogs": [
              "722860707"
            ]
          },
          "722860707": {
            "id": "722860707",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "让你这么失望还真是抱歉，但我不打算继续掺和了。",
            "nextDialogs": [
              "722860708"
            ]
          },
          "722860708": {
            "id": "722860708",
            "speakerId": 1002,
            "speakerName": "小春",
            "text": "受到大人责备也好，处罚也好，我也不会再继续合作了。",
            "nextDialogs": [
              "722860709"
            ]
          },
          "722860709": {
            "id": "722860709",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "笹野先生？",
            "nextDialogs": [
              "722860710"
            ]
          },
          "722860710": {
            "id": "722860710",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "虽然这几场表演有点问题，但是我们还可以反复多练习几次啊。",
            "nextDialogs": [
              "722860711"
            ]
          },
          "722860711": {
            "id": "722860711",
            "speakerId": 1002,
            "speakerName": "小春",
            "text": "没必要了，再练习多少次我也搞不明白你的剧本到底是怎么写的。",
            "nextDialogs": [
              "722860712"
            ]
          },
          "722860712": {
            "id": "722860712",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "我也有同感，这两个角色为什么就突然牺牲了自己，跑到敌人那里去了？",
            "nextDialogs": [
              "722860713"
            ]
          },
          "722860713": {
            "id": "722860713",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "怎么想怎么觉得奇怪，这种做法根本就是拖累主角。",
            "nextDialogs": [
              "722860714"
            ]
          },
          "722860714": {
            "id": "722860714",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "还有后面的台词，尴尬得我都不好意思念出来。",
            "nextDialogs": [
              "722860715"
            ]
          },
          "722860715": {
            "id": "722860715",
            "speakerId": 1001,
            "speakerName": "笹野",
            "text": "总之我决定不再继续参与了。再见。",
            "nextDialogs": [
              "722860716"
            ]
          },
          "722860716": {
            "id": "722860716",
            "speakerId": 1002,
            "speakerName": "小春",
            "text": "嗯，就此别过。",
            "nextDialogs": [
              "722860717"
            ]
          },
          "722860717": {
            "id": "722860717",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "欸？你们…",
            "nextDialogs": [
              "722860718"
            ]
          },
          "722860718": {
            "id": "722860718",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "笹野和小春都走了，没有演员可怎么继续拍映影，这下糟了。",
            "nextDialogs": [
              "722860719"
            ]
          },
          "722860719": {
            "id": "722860719",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "我…",
            "nextDialogs": [
              "722860720"
            ]
          },
          "722860720": {
            "id": "722860720",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别难过。",
            "nextDialogs": [
              "722860721"
            ]
          },
          "722860721": {
            "id": "722860721",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "对不起，中途出现这种事情，你的努力也白费了。",
            "nextDialogs": [
              "722860724"
            ]
          },
          "722860724": {
            "id": "722860724",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "我现在脑子里乱糟糟的，只想去<color=#00E1FFFF>乌有亭</color>一个人静一静，对不起。",
            "nextDialogs": [
              "722860725"
            ]
          },
          "722860725": {
            "id": "722860725",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "下次我们见面的时候再聊吧。",
            "nextDialogs": [
              "722860726"
            ]
          },
          "722860726": {
            "id": "722860726",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "泽维尔也走了啊，感觉他的状态很差。",
            "nextDialogs": [
              "722860727"
            ]
          },
          "722860727": {
            "id": "722860727",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "吵了这么一架，他心里一定很不好受，你觉得我们要不要去安慰安慰他？",
            "nextDialogs": [
              "722860728"
            ]
          },
          "722860728": {
            "id": "722860728",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "唔…他刚才好像是说了<color=#00E1FFFF>乌有亭</color>，你觉得应该去的话，我们就一起去那里找他吧。"
          }
        }
      }
    },
    {
      "subId": "7228608",
      "subQuestName": "前往乌有亭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722860801"
        ],
        "dialogs": {
          "722860801": {
            "id": "722860801",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "嘿嘿，还是被你找到了，嗝。",
            "nextDialogs": [
              "722860802"
            ]
          },
          "722860802": {
            "id": "722860802",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "噫，好重的酒味，泽维尔这是喝醉了吧。",
            "nextDialogs": [
              "722860804",
              "722860808"
            ]
          },
          "722860804": {
            "id": "722860804",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "这么说就没意思了，你好像我妈，嗝，一起喝嘛。",
            "nextDialogs": [
              "722860805"
            ]
          },
          "722860805": {
            "id": "722860805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是不了。",
            "nextDialogs": [
              "722860806"
            ]
          },
          "722860806": {
            "id": "722860806",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "欸？你不够朋友，好没劲。",
            "nextDialogs": [
              "722860811"
            ]
          },
          "722860811": {
            "id": "722860811",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "刚才不是那个，对，我们拍映影的时候，我啊，被疯狂质疑来着。",
            "nextDialogs": [
              "722860812"
            ]
          },
          "722860812": {
            "id": "722860812",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "其实不怪小春女士，嗝，还有笹野先生，他们刚开始都很合作。",
            "nextDialogs": [
              "722860813"
            ]
          },
          "722860813": {
            "id": "722860813",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "所以说，我觉得就是说，应该是因为我那个，没有那个才能。"
          },
          "722860808": {
            "id": "722860808",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "哦哦不不，我记得你说过要戒酒的吧，戒了之后就不能再喝了。",
            "nextDialogs": [
              "722860809"
            ]
          },
          "722860809": {
            "id": "722860809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我什么时候说过…",
            "nextDialogs": [
              "722860810"
            ]
          },
          "722860810": {
            "id": "722860810",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "大概是在我梦里说的吧。"
          }
        }
      }
    },
    {
      "subId": "7228609",
      "subQuestName": "与泽维尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7228615",
      "subQuestName": "与泽维尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722861701"
        ],
        "dialogs": {
          "722861701": {
            "id": "722861701",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "嗝。",
            "nextDialogs": [
              "722861704"
            ]
          },
          "722861704": {
            "id": "722861704",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "哦，泽维尔是好人！是我最好的朋友！唔…之一！",
            "nextDialogs": [
              "722861705"
            ]
          },
          "722861705": {
            "id": "722861705",
            "speakerId": 1005,
            "speakerName": "冈崎陆斗",
            "text": "几位觉得味道如何？",
            "nextDialogs": [
              "722861706"
            ]
          },
          "722861706": {
            "id": "722861706",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "非常非常美味，您烹饪的稻米和鱼肉中有湖泊的味道，那甜美又细腻的气息，和我的家乡佩特莉可镇一样温柔。",
            "nextDialogs": [
              "722861707"
            ]
          },
          "722861707": {
            "id": "722861707",
            "speakerId": 1005,
            "speakerName": "冈崎陆斗",
            "text": "哈哈是吗，你们喜欢就好。",
            "nextDialogs": [
              "722861708"
            ]
          },
          "722861708": {
            "id": "722861708",
            "speakerId": 1005,
            "speakerName": "冈崎陆斗",
            "text": "不是我有意偷听几位谈天，只是你们提到的映影听起来实在有趣，不介意的话，能跟我说说吗？",
            "nextDialogs": [
              "722861709"
            ]
          },
          "722861709": {
            "id": "722861709",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "和泽维尔一起向冈崎陆斗解释了映影的事情，并将剧本也一并拿给他看了。",
            "nextDialogs": [
              "722861710"
            ]
          },
          "722861710": {
            "id": "722861710",
            "speakerId": 1005,
            "speakerName": "冈崎陆斗",
            "text": "哦哦，这个异邦人在遇到苦难的时候，还能有挺身而出的觉悟，很厉害啊。",
            "nextDialogs": [
              "722861711"
            ]
          },
          "722861711": {
            "id": "722861711",
            "speakerId": 1005,
            "speakerName": "冈崎陆斗",
            "text": "厉害到都不像个普通人了，连一丝一毫的思考或者犹豫都没有。",
            "nextDialogs": [
              "722861712"
            ]
          },
          "722861712": {
            "id": "722861712",
            "speakerId": 1005,
            "speakerName": "冈崎陆斗",
            "text": "遇到了原本无法对抗的强敌，鼓起勇气冲了上去，居然就击倒了对方，这个气魄真是相当恐怖啊。",
            "nextDialogs": [
              "722861713"
            ]
          },
          "722861713": {
            "id": "722861713",
            "speakerId": 1005,
            "speakerName": "冈崎陆斗",
            "text": "泽维尔先生还年轻，这样以命相搏的事情并没有经历过吧。",
            "nextDialogs": [
              "722861714"
            ]
          },
          "722861714": {
            "id": "722861714",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "「以命相搏」确实谈不上，但这就是我的剧本被批评的原因吗？嗯…",
            "nextDialogs": [
              "722861715"
            ]
          },
          "722861715": {
            "id": "722861715",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "这样说吧，您认为要创作出有趣的故事，就必须经历一模一样的事吗？",
            "nextDialogs": [
              "722861716"
            ]
          },
          "722861716": {
            "id": "722861716",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "据我所知，有相当多的伟大作家都是不爱出门的人。",
            "nextDialogs": [
              "722861717"
            ]
          },
          "722861717": {
            "id": "722861717",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "况且，这种直截了当、用刀与剑来说话的方式，我觉得很有稻妻风味。",
            "nextDialogs": [
              "722861718"
            ]
          },
          "722861718": {
            "id": "722861718",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "冈崎先生，我是这样想的，既然来到了稻妻，就应该拍些有稻妻特色的映影。",
            "nextDialogs": [
              "722861719"
            ]
          },
          "722861719": {
            "id": "722861719",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "茅葺先生的原作也是这样的风格，为了保持那种独特的风味，我才选择了尊重原著。",
            "nextDialogs": [
              "722861720"
            ]
          },
          "722861720": {
            "id": "722861720",
            "speakerId": 1005,
            "speakerName": "冈崎陆斗",
            "text": "啊，那位茅葺一庆先生吗？的确是个很有趣的年轻人啊。",
            "nextDialogs": [
              "722861721"
            ]
          },
          "722861721": {
            "id": "722861721",
            "speakerId": 1005,
            "speakerName": "冈崎陆斗",
            "text": "泽维尔先生对映影的执着很让我感动，我不由得想起以前听来的一个故事…",
            "nextDialogs": [
              "722861722"
            ]
          },
          "722861722": {
            "id": "722861722",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "像这样坐在店里，边吃边听故事也是很有稻妻风味的事，我很喜欢。"
          }
        }
      }
    },
    {
      "subId": "7228616",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722861601"
        ],
        "dialogs": {
          "722861601": {
            "id": "722861601",
            "speakerId": 1005,
            "speakerName": "冈崎陆斗",
            "text": "两位这么欣赏绘里香的手艺，是我们夫妻的荣幸，所以为了两位而延长营业时间是应该的。",
            "nextDialogs": [
              "722861602"
            ]
          },
          "722861602": {
            "id": "722861602",
            "speakerId": 1005,
            "speakerName": "冈崎陆斗",
            "text": "等您离店之后，我们再收拾一会儿就该让绘里香去休息了。"
          }
        }
      }
    },
    {
      "subId": "7228614",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722861401"
        ],
        "dialogs": {
          "722861401": {
            "id": "722861401",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "故事的确很完备了，但还缺少一些情感波折，嗯…",
            "nextDialogs": [
              "722861404"
            ]
          },
          "722861404": {
            "id": "722861404",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "天，请原谅我，刚才的我就是个刚醒的醉鬼，居然把自己的朋友忘在了餐馆里。",
            "nextDialogs": [
              "722861405"
            ]
          },
          "722861405": {
            "id": "722861405",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "我想，现在我可以改写出一个全新的、像样的剧本，然后再试一次，这次一定能行。",
            "nextDialogs": [
              "722861406"
            ]
          },
          "722861406": {
            "id": "722861406",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "请给我一点时间，只要一天就够了，我有这个能力做好。",
            "nextDialogs": [
              "722861407"
            ]
          },
          "722861407": {
            "id": "722861407",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "唉，就是演员那里有些头疼，小春女士和笹野先生看样子是不会再参与了。",
            "nextDialogs": [
              "722861408"
            ]
          },
          "722861408": {
            "id": "722861408",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "这也怪不了他们，到时候再想办法吧。",
            "nextDialogs": [
              "722861409"
            ]
          },
          "722861409": {
            "id": "722861409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "需要帮忙吗？",
            "nextDialogs": [
              "722861410"
            ]
          },
          "722861410": {
            "id": "722861410",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "不不不，你能像这样听我倾诉，比什么都要让我宽慰。",
            "nextDialogs": [
              "722861411"
            ]
          },
          "722861411": {
            "id": "722861411",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "#亲爱的{NICKNAME}，你是一个很好的倾听者。",
            "nextDialogs": [
              "722861412"
            ]
          },
          "722861412": {
            "id": "722861412",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "派蒙女士，如果我刚才有什么冒犯的行为，可以请你原谅我吗？我绝对没有不尊敬你的意思。",
            "nextDialogs": [
              "722861413"
            ]
          },
          "722861413": {
            "id": "722861413",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "哦？「派蒙女士」…这个称呼我喜欢，好了，宽宏大量的派蒙决定原谅你。",
            "nextDialogs": [
              "722861414"
            ]
          },
          "722861414": {
            "id": "722861414",
            "speakerId": 1003,
            "speakerName": "泽维尔",
            "text": "太好了朋友们，这样我就放心了。明天我们在<color=#00E1FFFF>木漏茶室</color>碰面吧，我会带来一个更好的剧本。",
            "nextDialogs": [
              "722861415"
            ]
          },
          "722861415": {
            "id": "722861415",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "他很有干劲的确是好事啦，不过就像冈崎老爷说的那样，他一个人没关系吗？",
            "nextDialogs": [
              "722861416"
            ]
          },
          "722861416": {
            "id": "722861416",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "他可是要在一天之内，写一个新剧本欸，这种事太恐怖了吧。",
            "nextDialogs": [
              "722861417"
            ]
          },
          "722861417": {
            "id": "722861417",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我想帮忙。",
            "nextDialogs": [
              "722861418"
            ]
          },
          "722861418": {
            "id": "722861418",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "嗯，剧本的事就让泽维尔自己解决吧，我们应该可以帮他解决演员们的事。",
            "nextDialogs": [
              "722861419"
            ]
          },
          "722861419": {
            "id": "722861419",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会去和演员们谈谈。",
            "nextDialogs": [
              "722861420"
            ]
          },
          "722861420": {
            "id": "722861420",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "这样的话，也能为他减轻不少压力。"
          }
        }
      }
    },

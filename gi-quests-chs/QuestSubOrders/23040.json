    {
      "subId": "2304002",
      "subQuestName": "与纳杰特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230400201"
        ],
        "dialogs": {
          "230400201": {
            "id": "230400201",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "唉…这些赤鹫，真是没完没了…",
            "nextDialogs": [
              "230400202"
            ]
          },
          "230400202": {
            "id": "230400202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么了？",
            "nextDialogs": [
              "230400203"
            ]
          },
          "230400203": {
            "id": "230400203",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "你是…旅行者，对吧？我听奥贝德那孩子提起过你。",
            "nextDialogs": [
              "230400204"
            ]
          },
          "230400204": {
            "id": "230400204",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "呵呵，居然会有旅行者造访我们这村子，我倒是真没想到。",
            "nextDialogs": [
              "230400205"
            ]
          },
          "230400205": {
            "id": "230400205",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "喔，你见过哈巴奇了吗？他一直都很严肃…要是他和你说话时态度有些冲，还请你理解。",
            "nextDialogs": [
              "230400206"
            ]
          },
          "230400206": {
            "id": "230400206",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "毕竟…我们村的许多物资都放在这个仓库里，不仅是粮食，还有衣物，武器，甚至一些财货…",
            "nextDialogs": [
              "230400207"
            ]
          },
          "230400207": {
            "id": "230400207",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "村子里就那么些年轻人，既要守卫村子，又要帮村里人处理各种事…一直都只有哈巴奇一个人守着仓库。",
            "nextDialogs": [
              "230400208"
            ]
          },
          "230400208": {
            "id": "230400208",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "我这除了记账和清点之外，也帮不上什么忙…",
            "nextDialogs": [
              "230400209"
            ]
          },
          "230400209": {
            "id": "230400209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你刚才说赤鹫…",
            "nextDialogs": [
              "230400210"
            ]
          },
          "230400210": {
            "id": "230400210",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "唉，别提了，前段时间刚有一批干肉运进了仓库…",
            "nextDialogs": [
              "230400211"
            ]
          },
          "230400211": {
            "id": "230400211",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "不知道是哪里漏出了气味，隔三差五就有几只赤鹫飞过来，停在仓库旁边的山上。",
            "nextDialogs": [
              "230400212"
            ]
          },
          "230400212": {
            "id": "230400212",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "它们没法啄走仓库里的干肉，但只要有人在它们面前吃饭，这群赤鹫就会突然飞下来发动袭击。",
            "nextDialogs": [
              "230400213"
            ]
          },
          "230400213": {
            "id": "230400213",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "村子里的守卫没空去解决掉它们，哈巴奇先生也抽不出身…",
            "nextDialogs": [
              "230400214"
            ]
          },
          "230400214": {
            "id": "230400214",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "旅行者，如果你有空的话，能帮我们去解决掉那些赤鹫吗？",
            "nextDialogs": [
              "230400216",
              "230400218"
            ]
          },
          "230400216": {
            "id": "230400216",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "那就拜托你了，那些赤鹫很凶猛，最好不要靠近…如果你会用弓箭的话，应该能安全地解决掉它们。"
          },
          "230400218": {
            "id": "230400218",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "路过的货物，晾晒的干肉，还有哈巴奇先生的饭盒…",
            "nextDialogs": [
              "230400219"
            ]
          },
          "230400219": {
            "id": "230400219",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "哈巴奇先生在站岗中吃饭时，习惯把菜放在一旁，那群赤鹫经常瞅准这个机会，飞下去把肉全都叼走。",
            "nextDialogs": [
              "230400220"
            ]
          },
          "230400220": {
            "id": "230400220",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "因为还要站岗，他也不能去教训赤鹫，只能看着它们飞走，然后就着剩下的菜赶紧把饭吃完…",
            "nextDialogs": [
              "230400221"
            ]
          },
          "230400221": {
            "id": "230400221",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "拜托你了，旅行者，快去把那些赤鹫都解决掉吧。"
          }
        }
      }
    },
    {
      "subId": "2304003",
      "subQuestName": "打倒所有赤鹫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230400301"
        ],
        "dialogs": {
          "230400301": {
            "id": "230400301",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "拜托你了，旅行者，快去把那些赤鹫都解决掉吧。"
          }
        }
      }
    },
    {
      "subId": "2304004",
      "subQuestName": "向纳杰特回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230400401"
        ],
        "dialogs": {
          "230400401": {
            "id": "230400401",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "怎么样，你把那些赤鹫都解决掉了吗？",
            "nextDialogs": [
              "230400404"
            ]
          },
          "230400404": {
            "id": "230400404",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "太感谢你了，这样哈巴奇先生总算能正常吃一顿饭了。",
            "nextDialogs": [
              "230400405"
            ]
          },
          "230400405": {
            "id": "230400405",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "对了，这些报酬给你，请收下。",
            "nextDialogs": [
              "230400406"
            ]
          },
          "230400406": {
            "id": "230400406",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "唔，今天还要入库什么货物来着…"
          }
        }
      }
    },
    {
      "subId": "2304005",
      "subQuestName": "与纳杰特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230400501"
        ],
        "dialogs": {
          "230400501": {
            "id": "230400501",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "唉，哈巴奇先生什么时候才能稍微休息一下呢…",
            "nextDialogs": [
              "230400502"
            ]
          },
          "230400502": {
            "id": "230400502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "230400503"
            ]
          },
          "230400503": {
            "id": "230400503",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "旅行者，你来得正好，请你帮我们一个忙吧。",
            "nextDialogs": [
              "230400504"
            ]
          },
          "230400504": {
            "id": "230400504",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "刚才有一批风干的食物从外面送进村里，哈巴奇先生准备去把它们接入仓库里。",
            "nextDialogs": [
              "230400505"
            ]
          },
          "230400505": {
            "id": "230400505",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "但一群赤鹫闻到了食物的气味，突然成群结队地冲了下来。",
            "nextDialogs": [
              "230400506"
            ]
          },
          "230400506": {
            "id": "230400506",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "虽然其他守卫很快赶过来打跑了这些赤鹫，但那批风干的食物也被赤鹫们啄得到处都是。",
            "nextDialogs": [
              "230400507"
            ]
          },
          "230400507": {
            "id": "230400507",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "其他人已经去警告其他运货的队伍了，哈巴奇先生也忙着去回收还完好的食物…旅行者，你能帮帮我们吗？",
            "nextDialogs": [
              "230400509",
              "230400511"
            ]
          },
          "230400509": {
            "id": "230400509",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "那就拜托你了，真是不好意思，我等会还要去帮忙接收货物，实在是忙不过来了。"
          },
          "230400511": {
            "id": "230400511",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "唉，我让他休息一下他也不肯，说搜集完食物之后，还要再清点一遍仓库，这样下去，他的身体怎么撑得住啊…",
            "nextDialogs": [
              "230400512"
            ]
          },
          "230400512": {
            "id": "230400512",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "那些货物应该就在白之梯附近。旅行者，请你帮我们回收一下那些货物吧。"
          }
        }
      }
    },
    {
      "subId": "2304006",
      "subQuestName": "回收货物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230400601"
        ],
        "dialogs": {
          "230400601": {
            "id": "230400601",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "那些货物应该就在白之梯附近。旅行者，请你帮我们回收一下那些货物吧。"
          }
        }
      }
    },
    {
      "subId": "2304007",
      "subQuestName": "向纳杰特回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230400701"
        ],
        "dialogs": {
          "230400701": {
            "id": "230400701",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "旅行者，你拿到那些货物了吗？",
            "nextDialogs": [
              "230400702"
            ]
          },
          "230400702": {
            "id": "230400702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "拿到了。",
            "nextDialogs": [
              "230400703"
            ]
          },
          "230400703": {
            "id": "230400703",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "太好了，就把货物放在那里吧，多谢你帮忙了。",
            "nextDialogs": [
              "230400704"
            ]
          },
          "230400704": {
            "id": "230400704",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "哈巴奇先生已经去仓库里面清点其他货物了，这些食物就由我先看着吧。",
            "nextDialogs": [
              "230400705"
            ]
          },
          "230400705": {
            "id": "230400705",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "唉，希望这批食物没有损失太多啊…"
          }
        }
      }
    },
    {
      "subId": "2304008",
      "subQuestName": "与纳杰特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230400801"
        ],
        "dialogs": {
          "230400801": {
            "id": "230400801",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "旅行者！你来得正好，请你快去帮帮哈巴奇先生吧！",
            "nextDialogs": [
              "230400804"
            ]
          },
          "230400804": {
            "id": "230400804",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "唉，有一批货物在村外被盗宝团截住，能出动的守卫都已经出去支援了。",
            "nextDialogs": [
              "230400805"
            ]
          },
          "230400805": {
            "id": "230400805",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "哈巴奇说人手还是太少，所以他自己也抓着武器出了村子。",
            "nextDialogs": [
              "230400806"
            ]
          },
          "230400806": {
            "id": "230400806",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "但据说那群盗宝团人数很多，哈巴奇先生一个人说不定对付不来。",
            "nextDialogs": [
              "230400807"
            ]
          },
          "230400807": {
            "id": "230400807",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "旅行者，我把他要去的地方标在你的地图上，请你快去帮帮他吧。"
          }
        }
      }
    },
    {
      "subId": "2304009",
      "subQuestName": "前往帮助哈巴奇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230400901"
        ],
        "dialogs": {
          "230400901": {
            "id": "230400901",
            "speakerId": 4421,
            "speakerName": "纳杰特",
            "text": "旅行者，请你快去帮帮哈巴奇先生吧！我…我也得去找其他人帮忙…"
          }
        }
      }
    },
    {
      "subId": "2304010",
      "subQuestName": "与哈巴奇对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230401002"
        ],
        "dialogs": {
          "230401002": {
            "id": "230401002",
            "speakerId": 4420,
            "speakerName": "哈巴奇",
            "text": "…呼…呼…多谢你了，旅行者。要不是你出手，这些货物肯定保不住。",
            "nextDialogs": [
              "230401004",
              "230401006"
            ]
          },
          "230401004": {
            "id": "230401004",
            "speakerId": 4420,
            "speakerName": "哈巴奇",
            "text": "呵呵，多谢夸奖。但我一个人对付这么多盗宝团，多少还是有些吃力的。",
            "nextDialogs": [
              "230401007"
            ]
          },
          "230401007": {
            "id": "230401007",
            "speakerId": 4420,
            "speakerName": "哈巴奇",
            "text": "唉，我还是武艺不精。要是坎蒂丝小姐来的话，这群盗宝团应该已经全部趴在地上了…",
            "nextDialogs": [
              "230401008"
            ]
          },
          "230401008": {
            "id": "230401008",
            "speakerId": 4420,
            "speakerName": "哈巴奇",
            "text": "抱歉，现在不是说这个的时候，我得先把这些货物送回村里。",
            "nextDialogs": [
              "230401009"
            ]
          },
          "230401009": {
            "id": "230401009",
            "speakerId": 4420,
            "speakerName": "哈巴奇",
            "text": "旅行者，这里不太安全，你也快点回去吧。",
            "nextDialogs": [
              "230401010"
            ]
          },
          "230401010": {
            "id": "230401010",
            "speakerId": 4420,
            "speakerName": "哈巴奇",
            "text": "不过这群盗宝团的消息，怎么这么灵通…"
          },
          "230401006": {
            "id": "230401006",
            "speakerId": 4420,
            "speakerName": "哈巴奇",
            "text": "还有其他守卫和我一起出村，但他们去了另外的地方寻找货物。"
          }
        }
      }
    }
  ]
}
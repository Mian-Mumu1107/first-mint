    {
      "subId": "4000104",
      "subQuestName": "与霄市上的人们交谈$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "720290101"
        ],
        "dialogs": {
          "720290101": {
            "id": "720290101",
            "speakerId": 1003,
            "speakerName": "慧心",
            "text": "你好，我是月海亭的干事慧心，服务璃月是我的使命。"
          }
        }
      }
    },
    {
      "subId": "4000105",
      "subQuestName": "（test）与大家聊聊天$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400010501"
        ],
        "dialogs": {
          "400010501": {
            "id": "400010501",
            "speakerId": 1004,
            "speakerName": "枭总管",
            "text": "怎么说？你也是来做「霄灯」的吗？",
            "nextDialogs": [
              "400010502"
            ]
          },
          "400010502": {
            "id": "400010502",
            "speakerId": 1004,
            "speakerName": "枭总管",
            "text": "不错不错，年轻人自己动动手，是好事！",
            "nextDialogs": [
              "400010503"
            ]
          },
          "400010503": {
            "id": "400010503",
            "speakerId": 1004,
            "speakerName": "枭总管",
            "text": "来，这些材料送你…你应该会用<color=#00E1FFFF>「合成台」</color>吧？"
          }
        }
      }
    },
    {
      "subId": "4000106",
      "subQuestName": "（test）与大家聊聊天$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400010601"
        ],
        "dialogs": {
          "400010601": {
            "id": "400010601",
            "speakerId": 1005,
            "speakerName": "萍姥姥",
            "text": "今年「明霄灯」的造型是纪念「移霄导天真君」啊，那个喜欢逞威风的家伙应该会高兴的吧…",
            "nextDialogs": [
              "400010603",
              "400010612"
            ]
          },
          "400010603": {
            "id": "400010603",
            "speakerId": 1005,
            "speakerName": "萍姥姥",
            "text": "今年海灯节在建造的「明霄灯」，就是「移霄导天真君」的形象。",
            "nextDialogs": [
              "400010604"
            ]
          },
          "400010604": {
            "id": "400010604",
            "speakerId": 1005,
            "speakerName": "萍姥姥",
            "text": "希望他们会把鹿角修得大一些，毕竟头上的角可是那位仙人最引以为傲的。",
            "nextDialogs": [
              "400010605"
            ]
          },
          "400010605": {
            "id": "400010605",
            "speakerId": 1005,
            "speakerName": "萍姥姥",
            "text": "据说，他的角吸收了岩王帝君岩之力的神髓，曾是整个璃月最坚硬的东西。",
            "nextDialogs": [
              "400010606"
            ]
          },
          "400010606": {
            "id": "400010606",
            "speakerId": 1005,
            "speakerName": "萍姥姥",
            "text": "可就在「那场决战」中，劲力迸出，山岳倾倒，他为了不波及到山脚的村庄，主动让朋友将他的鹿角砍下…",
            "nextDialogs": [
              "400010607"
            ]
          },
          "400010607": {
            "id": "400010607",
            "speakerId": 1005,
            "speakerName": "萍姥姥",
            "text": "他将那鲜血淋漓的鹿角作为支点，撑起了整个山岳。而他自己也坚持战斗到自己流尽最后一滴血…",
            "nextDialogs": [
              "400010608"
            ]
          },
          "400010608": {
            "id": "400010608",
            "speakerId": 1005,
            "speakerName": "萍姥姥",
            "text": "如今，曾被他撑起的「天衡山」依然巍然屹立，他死战之中流出的鲜血则汇聚而成「碧水河」。",
            "nextDialogs": [
              "400010609"
            ]
          },
          "400010609": {
            "id": "400010609",
            "speakerId": 1005,
            "speakerName": "萍姥姥",
            "text": "呵呵…不论你是否相信我讲的，能有人愿意听听这些陈年旧事，就已经是很大的安慰了。",
            "nextDialogs": [
              "400010610"
            ]
          },
          "400010610": {
            "id": "400010610",
            "speakerId": 1005,
            "speakerName": "萍姥姥",
            "text": "海灯节之所以存在，也是因为那些「老朋友们」不甘寂寞吧。"
          },
          "400010612": {
            "id": "400010612",
            "speakerId": 1005,
            "speakerName": "萍姥姥",
            "text": "再见。愿薪火相传，美德不灭。"
          }
        }
      }
    },
    {
      "subId": "4000109",
      "subQuestName": "（test）学习做霄灯$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400010901"
        ],
        "dialogs": {
          "400010901": {
            "id": "400010901",
            "speakerId": 1006,
            "speakerName": "畅畅",
            "text": "畅畅呀，刚才把布娃娃捐了哦。",
            "nextDialogs": [
              "400010902"
            ]
          },
          "400010902": {
            "id": "400010902",
            "speakerId": 1006,
            "speakerName": "畅畅",
            "text": "昨晚我梦到她说想要飞到天上去看看。",
            "nextDialogs": [
              "400010903"
            ]
          },
          "400010903": {
            "id": "400010903",
            "speakerId": 1006,
            "speakerName": "畅畅",
            "text": "我就把她捐给大鹿灯那边的姐姐了，马上她就会实现愿望了吧？",
            "nextDialogs": [
              "400010904"
            ]
          },
          "400010904": {
            "id": "400010904",
            "speakerId": 1006,
            "speakerName": "畅畅",
            "text": "畅畅是做了件好事吗？海灯节是实现大家愿望的日子吧？"
          }
        }
      }
    },

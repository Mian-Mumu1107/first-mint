  "subQuests": [
    {
      "subId": "7403602",
      "subQuestName": "等到第二天早上（8点~12点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740360201"
        ],
        "dialogs": {
          "740360201": {
            "id": "740360201",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "塞勒，现在能盖章吗？",
            "nextDialogs": [
              "740360202"
            ]
          },
          "740360202": {
            "id": "740360202",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "能！当然能，你带钥匙来了吧？先在这里签个字吧。",
            "nextDialogs": [
              "740360203"
            ]
          },
          "740360203": {
            "id": "740360203",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "我还以为你们有了这件机器之后，就不用签字了呢。",
            "nextDialogs": [
              "740360204"
            ]
          },
          "740360204": {
            "id": "740360204",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "这个嘛…这个机器最终还是得人来操作，那可不就得签字作保吗？",
            "nextDialogs": [
              "740360205"
            ]
          },
          "740360205": {
            "id": "740360205",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "但是这机器的保密性可是一流的，没有钥匙的话，就算是我也没法让它动起来。",
            "nextDialogs": [
              "740360206"
            ]
          },
          "740360206": {
            "id": "740360206",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "把文件放下面吧，一定要对准。再把钥匙插进这个孔里。",
            "nextDialogs": [
              "740360207"
            ]
          },
          "740360207": {
            "id": "740360207",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这就是那个「自动盖章机」吗？看起来还真…普通呢…",
            "nextDialogs": [
              "740360208"
            ]
          },
          "740360208": {
            "id": "740360208",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "这样是吧，然后我就扭一下…",
            "nextDialogs": [
              "740360209"
            ]
          },
          "740360209": {
            "id": "740360209",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "等会，保持这个姿势先别动，我还得给你留个影。",
            "nextDialogs": [
              "740360212"
            ]
          },
          "740360212": {
            "id": "740360212",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "这是引进这台机器的时候，卡尔西先生给我们定下的规定，必须要用留影机给来盖章的人进行留档…",
            "nextDialogs": [
              "740360253"
            ]
          },
          "740360253": {
            "id": "740360253",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "我得挪个位置…别拍到这份文件了。",
            "nextDialogs": [
              "740360213"
            ]
          },
          "740360213": {
            "id": "740360213",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "最近复律庭里有人说马上就要下来一份文件，专门规制留影机泄密这件事。我可不想当那个被打的出头鸟…",
            "nextDialogs": [
              "740360214"
            ]
          },
          "740360214": {
            "id": "740360214",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们也往外面站站吧，要是被拍进去的话，说不定我们也会卷入什么「秘密事件」里呢。",
            "nextDialogs": [
              "740360255"
            ]
          },
          "740360255": {
            "id": "740360255",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "塞勒小心翼翼地留好了影…",
            "nextDialogs": [
              "740360215"
            ]
          },
          "740360215": {
            "id": "740360215",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "…拍好了，你开机器吧。",
            "nextDialogs": [
              "740360216"
            ]
          },
          "740360216": {
            "id": "740360216",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "我扭了啊，这机器怎么没动静？",
            "nextDialogs": [
              "740360217"
            ]
          },
          "740360217": {
            "id": "740360217",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "不可能，我刚修过这台机器，总不能又坏了吧？让我检查一下，别担心，很快就好。",
            "nextDialogs": [
              "740360218"
            ]
          },
          "740360218": {
            "id": "740360218",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "塞勒低头检查起了机器…",
            "nextDialogs": [
              "740360219"
            ]
          },
          "740360219": {
            "id": "740360219",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "怪了，什么毛病也没有啊…",
            "nextDialogs": [
              "740360220"
            ]
          },
          "740360220": {
            "id": "740360220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "重新插拔钥匙看看？",
            "nextDialogs": [
              "740360221"
            ]
          },
          "740360221": {
            "id": "740360221",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "好吧，我来试试看。",
            "nextDialogs": [
              "740360222"
            ]
          },
          "740360222": {
            "id": "740360222",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "艾尤恩拔出钥匙，又重新插了回去。机器依旧没有动静…",
            "nextDialogs": [
              "740360223"
            ]
          },
          "740360223": {
            "id": "740360223",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "没有动静啊，塞勒，想想办法！",
            "nextDialogs": [
              "740360224"
            ]
          },
          "740360224": {
            "id": "740360224",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "也许是你没有把文件的位置对准？你得把文件卡在这些卡扣上才行，里面都有隐藏的触发机括呢。",
            "nextDialogs": [
              "740360225"
            ]
          },
          "740360225": {
            "id": "740360225",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "文件和机器有关系吗？",
            "nextDialogs": [
              "740360226"
            ]
          },
          "740360226": {
            "id": "740360226",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "当然，不然这台机器怎么知道有文件在下面等着盖章呢，这可是一台自动盖章机，又不是由我手动操作的。",
            "nextDialogs": [
              "740360227"
            ]
          },
          "740360227": {
            "id": "740360227",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "天哪…好吧，好吧！我这就把文件重新放一遍，对准所有卡扣。",
            "nextDialogs": [
              "740360228"
            ]
          },
          "740360228": {
            "id": "740360228",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "艾尤恩拿出文件，重新摆放进去。机器依旧没有动静…",
            "nextDialogs": [
              "740360229"
            ]
          },
          "740360229": {
            "id": "740360229",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "没作用，它还是一动不动。",
            "nextDialogs": [
              "740360230"
            ]
          },
          "740360230": {
            "id": "740360230",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "不对啊，上次我只是拍了一下，这机器就继续工作了。",
            "nextDialogs": [
              "740360231"
            ]
          },
          "740360231": {
            "id": "740360231",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我去拍拍它。",
            "nextDialogs": [
              "740360232"
            ]
          },
          "740360232": {
            "id": "740360232",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "我们已经不得不诉诸如此…接近于祈祷的行为来维修机器了吗？",
            "nextDialogs": [
              "740360233"
            ]
          },
          "740360233": {
            "id": "740360233",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "至少我们还有祈祷的机会不是？",
            "nextDialogs": [
              "740360234"
            ]
          },
          "740360234": {
            "id": "740360234",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（轻轻拍打这台机器。）",
            "nextDialogs": [
              "740360235"
            ]
          },
          "740360235": {
            "id": "740360235",
            "speakerId": 1004,
            "speakerName": "自动盖章机",
            "text": "（这台机器用沉默给了你回答…）",
            "nextDialogs": [
              "740360236"
            ]
          },
          "740360236": {
            "id": "740360236",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（略微用力地拍打这台机器。）",
            "nextDialogs": [
              "740360237"
            ]
          },
          "740360237": {
            "id": "740360237",
            "speakerId": 1004,
            "speakerName": "自动盖章机",
            "text": "（这台机器就连抗议也懒得做出…）",
            "nextDialogs": [
              "740360238"
            ]
          },
          "740360238": {
            "id": "740360238",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（狠狠地拍打这台机器！）",
            "nextDialogs": [
              "740360239"
            ]
          },
          "740360239": {
            "id": "740360239",
            "speakerId": 1004,
            "speakerName": "自动盖章机",
            "text": "（这台机器沉默少许，烦躁地发出了一阵稀里哗啦的声音，就像是刚睡醒的人跌跌撞撞地摔下了床…）",
            "nextDialogs": [
              "740360240"
            ]
          },
          "740360240": {
            "id": "740360240",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇！什么声音，这台机器里面是不是全部坏掉了啊！",
            "nextDialogs": [
              "740360241"
            ]
          },
          "740360241": {
            "id": "740360241",
            "speakerId": 1004,
            "speakerName": "自动盖章机",
            "text": "（…然后，这台机器踉跄着找到了它的拖鞋，摸索一阵，终于打开灯，嗡嗡地运转了起来。）",
            "nextDialogs": [
              "740360242"
            ]
          },
          "740360242": {
            "id": "740360242",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "居，居然运转了…",
            "nextDialogs": [
              "740360243"
            ]
          },
          "740360243": {
            "id": "740360243",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "自动盖章机疲惫，坚定却又极富耐心地工作了起来。 在几人近乎绝望的注视下，机器以仿佛玳龟爬行一般的速度降下了印章。印章迈着步子，在文件上疑惑地蹒跚，转悠了一会后，只能无奈地坐下休憩。 最后，机器颤抖着将印章收了回去…",
            "nextDialogs": [
              "740360244"
            ]
          },
          "740360244": {
            "id": "740360244",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "我就说它能正常工作！",
            "nextDialogs": [
              "740360245"
            ]
          },
          "740360245": {
            "id": "740360245",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "我真不知道这机器究竟哪里好了，说是自动，但它盖章的速度比手动还慢啊。",
            "nextDialogs": [
              "740360246"
            ]
          },
          "740360246": {
            "id": "740360246",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "但它的保密性十分优秀。你瞧，我们三个人就算是这样，也没能把印章拿出来私自盖戳。",
            "nextDialogs": [
              "740360247"
            ]
          },
          "740360247": {
            "id": "740360247",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "别在这种地方自鸣得意，要是有一天这台机器彻底坏了，卡尔西先生也不在，那又该怎么办？",
            "nextDialogs": [
              "740360248"
            ]
          },
          "740360248": {
            "id": "740360248",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "嗯…那也没关系，我还有一枚备用钥匙。",
            "nextDialogs": [
              "740360249"
            ]
          },
          "740360249": {
            "id": "740360249",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "那是用来打开这台机器的吗？",
            "nextDialogs": [
              "740360250"
            ]
          },
          "740360250": {
            "id": "740360250",
            "speakerId": 1001,
            "speakerName": "塞勒",
            "text": "不，那是用来打开卡尔西先生办公室里的一个箱子，里面放着一枚备用公章。",
            "nextDialogs": [
              "740360251"
            ]
          },
          "740360251": {
            "id": "740360251",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "…旅行者，我们赶紧回去把这份文件给装订好，交给迪福尔先生吧。",
            "nextDialogs": [
              "740360252"
            ]
          },
          "740360252": {
            "id": "740360252",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "我真是等不及从这场噩梦中解脱了。"
          }
        }
      }
    },
    {
      "subId": "7403603",
      "subQuestName": "与艾尤恩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740360101"
        ],
        "dialogs": {
          "740360101": {
            "id": "740360101",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "……",
            "nextDialogs": [
              "740360104"
            ]
          },
          "740360104": {
            "id": "740360104",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "……",
            "nextDialogs": [
              "740360105"
            ]
          },
          "740360105": {
            "id": "740360105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "艾尤恩！",
            "nextDialogs": [
              "740360106"
            ]
          },
          "740360106": {
            "id": "740360106",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "啊！？怎么了！我写完了，我已经写完了啊！",
            "nextDialogs": [
              "740360107"
            ]
          },
          "740360107": {
            "id": "740360107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是我啦，你写完了吗？",
            "nextDialogs": [
              "740360108"
            ]
          },
          "740360108": {
            "id": "740360108",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "是您啊，我刚才…我刚才肯定是睡着了，抱歉。",
            "nextDialogs": [
              "740360109"
            ]
          },
          "740360109": {
            "id": "740360109",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "洛耶茨先生和瑟米安先生陪了我半宿，在他们的指导下，我总算是把那篇倡议书赶出来了。",
            "nextDialogs": [
              "740360110"
            ]
          },
          "740360110": {
            "id": "740360110",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "但我太累了，所以闭眼休息了一会，没想到一下子睡到现在…",
            "nextDialogs": [
              "740360111"
            ]
          },
          "740360111": {
            "id": "740360111",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "我得先去找塞勒，把这份倡议书盖上复律庭的公章，再把倡议书拿去给迪福尔先生盖章，最后再正式印发…这件事就结了！"
          }
        }
      }
    },
    {
      "subId": "7403604",
      "subQuestName": "前去盖章",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7403605",
      "subQuestName": "回去处理文件",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740360301"
        ],
        "dialogs": {
          "740360301": {
            "id": "740360301",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "好了，公章齐全，装订完成，接下来只要交给迪福尔先生，就万事大吉了。",
            "nextDialogs": [
              "740360302"
            ]
          },
          "740360302": {
            "id": "740360302",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "我今天晚上一定要好好睡一觉，把这些事全都忘在脑后，明天再请个假，去找伊丝黛莱…",
            "nextDialogs": [
              "740360303"
            ]
          },
          "740360303": {
            "id": "740360303",
            "speakerId": 1005,
            "speakerName": "柯妮莉娅",
            "text": "艾尤恩先生，您现在有空吗？",
            "nextDialogs": [
              "740360304"
            ]
          },
          "740360304": {
            "id": "740360304",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "我有，您有什么事吗？难道报销的单据这么快就下来了？",
            "nextDialogs": [
              "740360305"
            ]
          },
          "740360305": {
            "id": "740360305",
            "speakerId": 1005,
            "speakerName": "柯妮莉娅",
            "text": "那倒不是，但…那维莱特大人让人来告诉我，让我问问您，为什么要单独报销一个键帽，而不是一整台打字机。",
            "nextDialogs": [
              "740360306"
            ]
          },
          "740360306": {
            "id": "740360306",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "因为…因为我只掉了一个键帽啊，为什么非得报销一整台打字机呢？",
            "nextDialogs": [
              "740360307"
            ]
          },
          "740360307": {
            "id": "740360307",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔，道理确实是这样啦…",
            "nextDialogs": [
              "740360308"
            ]
          },
          "740360308": {
            "id": "740360308",
            "speakerId": 1005,
            "speakerName": "柯妮莉娅",
            "text": "但我们的报销清单上有打字机，却没有键帽，所以键帽是一个全新的报销条目。",
            "nextDialogs": [
              "740360309"
            ]
          },
          "740360309": {
            "id": "740360309",
            "speakerId": 1005,
            "speakerName": "柯妮莉娅",
            "text": "您必须得写一份书面文件递交给那维莱特大人，详细说明您为什么只报销一枚键帽…",
            "nextDialogs": [
              "740360310"
            ]
          },
          "740360310": {
            "id": "740360310",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "总感觉我们现在不是在讨论一件正经事，而是在讲什么冷笑话…",
            "nextDialogs": [
              "740360313"
            ]
          },
          "740360313": {
            "id": "740360313",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "所以，你要我给…你要我给那维莱特大人单独写一份报告，解释我弄丢了一枚键帽？",
            "nextDialogs": [
              "740360314"
            ]
          },
          "740360314": {
            "id": "740360314",
            "speakerId": 1005,
            "speakerName": "柯妮莉娅",
            "text": "枢律庭说，是那维莱特大人亲自下的要求。",
            "nextDialogs": [
              "740360315"
            ]
          },
          "740360315": {
            "id": "740360315",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "才怪！枢律庭无论做什么都会说「这是那维莱特大人亲自下的要求」！",
            "nextDialogs": [
              "740360316"
            ]
          },
          "740360316": {
            "id": "740360316",
            "speakerId": 1006,
            "speakerName": "洛耶茨",
            "text": "但没人敢赌这说法到底是不是真的。好了艾尤恩，冷静下来听我说。",
            "nextDialogs": [
              "740360317"
            ]
          },
          "740360317": {
            "id": "740360317",
            "speakerId": 1006,
            "speakerName": "洛耶茨",
            "text": "你作为复律官，最高审判官的命令对你来说具有行政意义上的强制性。简单来说就是，你不得不写。",
            "nextDialogs": [
              "740360318"
            ]
          },
          "740360318": {
            "id": "740360318",
            "speakerId": 1006,
            "speakerName": "洛耶茨",
            "text": "这不是一件坏事，你正好借此机会让那维莱特大人瞧瞧你的文笔。可不是每一个人都有机会向他做单独书面报告的啊。",
            "nextDialogs": [
              "740360320"
            ]
          },
          "740360320": {
            "id": "740360320",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "但是，我…",
            "nextDialogs": [
              "740360319"
            ]
          },
          "740360319": {
            "id": "740360319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "喔…糟糕…",
            "nextDialogs": [
              "740360321"
            ]
          },
          "740360321": {
            "id": "740360321",
            "speakerId": 1007,
            "speakerName": "加特尼奥",
            "text": "嗨！朋友们，好消息，我们抓到一个用留影机泄密的现行犯！完全可以作为反面典型写进倡议书里。",
            "nextDialogs": [
              "740360322"
            ]
          },
          "740360322": {
            "id": "740360322",
            "speakerId": 1007,
            "speakerName": "加特尼奥",
            "text": "这位知法犯法的现行犯，就是让我们提醒所有人不要用留影机泄密的卡尔西先生。",
            "nextDialogs": [
              "740360323"
            ]
          },
          "740360323": {
            "id": "740360323",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这个人…就是因为他，艾尤恩才会每天熬夜写稿子！他怎么自己先犯错了呀！",
            "nextDialogs": [
              "740360324"
            ]
          },
          "740360324": {
            "id": "740360324",
            "speakerId": 1007,
            "speakerName": "加特尼奥",
            "text": "他用留影机拍摄了好几张自己办公室的画片，又把这些画片送给了记者。",
            "nextDialogs": [
              "740360325"
            ]
          },
          "740360325": {
            "id": "740360325",
            "speakerId": 1007,
            "speakerName": "加特尼奥",
            "text": "在其中的一张画片里，他把自己的会议记录给拍了进去。现在民众发现，会议记录的内容和他之前做的演讲根本挨不上边。",
            "nextDialogs": [
              "740360326"
            ]
          },
          "740360326": {
            "id": "740360326",
            "speakerId": 1007,
            "speakerName": "加特尼奥",
            "text": "现在外面已经传得沸沸扬扬，卡尔西的办公室马上又要成为枫丹最大的笑料了。",
            "nextDialogs": [
              "740360327"
            ]
          },
          "740360327": {
            "id": "740360327",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "等一下啦！会议记录和演讲有什么关系？",
            "nextDialogs": [
              "740360328"
            ]
          },
          "740360328": {
            "id": "740360328",
            "speakerId": 1007,
            "speakerName": "加特尼奥",
            "text": "几乎所有演讲稿的内容都是从会议记录中整理出来的，当然有关系。",
            "nextDialogs": [
              "740360329"
            ]
          },
          "740360329": {
            "id": "740360329",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那怎么会挨不上边？",
            "nextDialogs": [
              "740360330"
            ]
          },
          "740360330": {
            "id": "740360330",
            "speakerId": 1007,
            "speakerName": "加特尼奥",
            "text": "喔，这很正常。会议记录最大的作用，是告诉我们哪些东西不能出现在演讲稿里。",
            "nextDialogs": [
              "740360331"
            ]
          },
          "740360331": {
            "id": "740360331",
            "speakerId": 1007,
            "speakerName": "加特尼奥",
            "text": "卡尔西才不知道自己要讲什么，他连自己的想法都没有，全都靠他手下的那几位小伙子提醒他。",
            "nextDialogs": [
              "740360332"
            ]
          },
          "740360332": {
            "id": "740360332",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "等等，卡尔西先生目前在哪？",
            "nextDialogs": [
              "740360333"
            ]
          },
          "740360333": {
            "id": "740360333",
            "speakerId": 1007,
            "speakerName": "加特尼奥",
            "text": "在我们的办公室等待调查，毕竟是泄露了带有密级的文件，还闹得满城风雨…想必他得在里面待段时间了。",
            "nextDialogs": [
              "740360334"
            ]
          },
          "740360334": {
            "id": "740360334",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "那我写的文件怎么办！我什么都写好了，连章都盖好了，我…咳咳咳…咳咳！",
            "nextDialogs": [
              "740360335"
            ]
          },
          "740360335": {
            "id": "740360335",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没，没关系呀，写都写好了，总是能发出来的。"
          }
        }
      }
    },
    {
      "subId": "7403604",

            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "「桌上剧团」真有趣。",
            "nextDialogs": [
              "742480202"
            ]
          },
          "742480202": {
            "id": "742480202",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "（再这么坐一会儿吧。）",
            "nextDialogs": [
              "742480204"
            ]
          },
          "742480204": {
            "id": "742480204",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，坏坏的吸血鬼也要回家了。"
          }
        }
      }

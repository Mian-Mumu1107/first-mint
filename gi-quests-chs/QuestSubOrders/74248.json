{
  "lineCounts": {
    "「主持人」": 3,
    "「少女」": 14,
    "「木偶」": 12,
    "克洛琳德": 5,
    "娜维娅": 9
  },
  "subQuests": [
    {
      "subId": "7424801",
      "subQuestName": "前往千织屋附近开启茶会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "742480101"
        ],
        "dialogs": {
          "742480101": {
            "id": "742480101",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "哥伦比娅小姐，桑多涅小姐！感谢你们抽空来参加我们的桌上剧团！",
            "nextDialogs": [
              "742480102"
            ]
          },
          "742480102": {
            "id": "742480102",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "没什么，我们之前没怎么玩过，倒是要麻烦二位多多关照了。",
            "nextDialogs": [
              "742480103"
            ]
          },
          "742480103": {
            "id": "742480103",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "不必有压力，大家享受故事的乐趣就好。",
            "nextDialogs": [
              "742480104"
            ]
          },
          "742480104": {
            "id": "742480104",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯。我很期待。",
            "nextDialogs": [
              "742480105"
            ]
          },
          "742480105": {
            "id": "742480105",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "那么，就由我来简单说明一下此次故事的背景——",
            "nextDialogs": [
              "742480106"
            ]
          },
          "742480106": {
            "id": "742480106",
            "speakerId": 1004,
            "speakerName": "「主持人」",
            "text": "「这是一个吸血鬼与人类共生的时代，故事就发生在两个种族共同生活的城市中…」",
            "nextDialogs": [
              "742480107"
            ]
          },
          "742480107": {
            "id": "742480107",
            "speakerId": 1004,
            "speakerName": "「主持人」",
            "text": "「人类与吸血鬼的关系说不上敌对，但也不能称之为和谐。而一起夜晚的凶案，彻底打破了这个微妙的平衡…」",
            "nextDialogs": [
              "742480108"
            ]
          },
          "742480108": {
            "id": "742480108",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "吸血鬼？",
            "nextDialogs": [
              "742480109"
            ]
          },
          "742480109": {
            "id": "742480109",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "就是靠吸食人类血液才能活下去的种族啦，算是小说中的常见设定。哥伦比娅小姐看过类似的故事吗？",
            "nextDialogs": [
              "742480110"
            ]
          },
          "742480110": {
            "id": "742480110",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "唔，好像听说过。那我们需要在故事中做什么呢？",
            "nextDialogs": [
              "742480111"
            ]
          },
          "742480111": {
            "id": "742480111",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "各位先决定自己想要在这个世界中扮演的角色吧，贴合背景设定就行，身份和职业不做限制。",
            "nextDialogs": [
              "742480112"
            ]
          },
          "742480112": {
            "id": "742480112",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "想要扮演的角色…",
            "nextDialogs": [
              "742480113"
            ]
          },
          "742480113": {
            "id": "742480113",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "如果自己不好决定的话，也可以和他人交换，让对方来决定你在这个世界的形象。",
            "nextDialogs": [
              "742480114"
            ]
          },
          "742480114": {
            "id": "742480114",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "欸？意思是…让别人来写你的背景设定？",
            "nextDialogs": [
              "742480115"
            ]
          },
          "742480115": {
            "id": "742480115",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "哦！听起来很有趣呢！不如就这么办吧！我的角色卡就交给克洛琳德你来写吧！",
            "nextDialogs": [
              "742480116"
            ]
          },
          "742480116": {
            "id": "742480116",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "那我的角色，就交给桑多涅来决定吧。我也会为桑多涅设计一个符合你的角色。",
            "nextDialogs": [
              "742480117"
            ]
          },
          "742480117": {
            "id": "742480117",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "哈…行吧。我刚好也对自己故事中的职业没有太多头绪。",
            "nextDialogs": [
              "742480118"
            ]
          },
          "742480118": {
            "id": "742480118",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "各位都写好了吗！嘿嘿，那我先看看自己的——",
            "nextDialogs": [
              "742480119"
            ]
          },
          "742480119": {
            "id": "742480119",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "「我是一位商人，平时奔走于吸血鬼与人类所居住的城市…」",
            "nextDialogs": [
              "742480120"
            ]
          },
          "742480120": {
            "id": "742480120",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "…等等。主持人，这不是和我以前的角色卡差不多嘛！连数值都一样！你这是偷懒了吧！",
            "nextDialogs": [
              "742480121"
            ]
          },
          "742480121": {
            "id": "742480121",
            "speakerId": 1077,
            "speakerName": "克洛琳德",
            "text": "反正你到最后都会用奇奇怪怪的方式给我出难题，而且我觉得这种精明闹腾的角色很适合你。",
            "nextDialogs": [
              "742480122"
            ]
          },
          "742480122": {
            "id": "742480122",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "…喂！",
            "nextDialogs": [
              "742480123"
            ]
          },
          "742480123": {
            "id": "742480123",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "哈哈。那我来看看我的——",
            "nextDialogs": [
              "742480124"
            ]
          },
          "742480124": {
            "id": "742480124",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "「我是一位很坏很坏的吸血鬼。白天喜欢躺在家里睡觉，只在夜晚月亮出来的时候才会到花园中散步。」",
            "nextDialogs": [
              "742480125"
            ]
          },
          "742480125": {
            "id": "742480125",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "「我喜欢唱歌，会用歌声诱惑自己的猎物。而见过我睁眼的人，更是没有一位能看到第二天的太阳。」",
            "nextDialogs": [
              "742480126"
            ]
          },
          "742480126": {
            "id": "742480126",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "唔…在桑多涅看来，我是这么一个形象吗？",
            "nextDialogs": [
              "742480127"
            ]
          },
          "742480127": {
            "id": "742480127",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "哼哼，这不是挺适合你的吗？而且很有趣。",
            "nextDialogs": [
              "742480128"
            ]
          },
          "742480128": {
            "id": "742480128",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "好吧，但我还是想尽量做一个好的吸血鬼。",
            "nextDialogs": [
              "742480129"
            ]
          },
          "742480129": {
            "id": "742480129",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "随你便，让我看看你写的——",
            "nextDialogs": [
              "742480130"
            ]
          },
          "742480130": {
            "id": "742480130",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "「我是一位优雅的贵族大小姐。平时喜欢在房间里搞一些发明创造，睡觉睡得很晚，作息很不规律…」",
            "nextDialogs": [
              "742480131"
            ]
          },
          "742480131": {
            "id": "742480131",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "喂！谁的自我介绍会写这种东西呀！",
            "nextDialogs": [
              "742480132"
            ]
          },
          "742480132": {
            "id": "742480132",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "啧…「但我同时也是一位吸血鬼猎人，只要城市里有人陷入了危险，我就会带着自己的发明挺身而出，拯救大家…」",
            "nextDialogs": [
              "742480133"
            ]
          },
          "742480133": {
            "id": "742480133",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "…哈？这和我根本一点也不像吧！",
            "nextDialogs": [
              "742480134"
            ]
          },
          "742480134": {
            "id": "742480134",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "是吗？我明明觉得很像。",
            "nextDialogs": [
              "742480135"
            ]
          },
          "742480135": {
            "id": "742480135",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "但这么看来，哥伦比娅小姐的角色和桑多涅小姐就是对立关系了欸！",
            "nextDialogs": [
              "742480136"
            ]
          },
          "742480136": {
            "id": "742480136",
            "speakerId": 1004,
            "speakerName": "「主持人」",
            "text": "嗯，看起来这故事会有很多奇妙的发展。",
            "nextDialogs": [
              "742480137"
            ]
          },
          "742480137": {
            "id": "742480137",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "哦！我已经等不及了！",
            "nextDialogs": [
              "742480138"
            ]
          },
          "742480138": {
            "id": "742480138",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "哈…总感觉会有很多麻烦的发展…",
            "nextDialogs": [
              "742480139"
            ]
          },
          "742480139": {
            "id": "742480139",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "你怕了吗？桑多涅。因为我是很坏很坏的吸血鬼吗？",
            "nextDialogs": [
              "742480140"
            ]
          },
          "742480140": {
            "id": "742480140",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "嚯嚯？应该说我反倒等不及要把你揍一顿了才对。"
          }
        }
      }
    },
    {

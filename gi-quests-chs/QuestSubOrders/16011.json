    {
      "subId": "1601102",
      "subQuestName": "观察四周",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160110201"
        ],
        "dialogs": {
          "160110201": {
            "id": "160110201",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "唔…",
            "nextDialogs": [
              "160110202"
            ]
          },
          "160110202": {
            "id": "160110202",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…剑还完好无损？但感知不到上面的狼灵…",
            "nextDialogs": [
              "160110203"
            ]
          },
          "160110203": {
            "id": "160110203",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "（…看来这里已经不是「现实」了，而是「北风」混杂「罗兰」的意识，构筑出的空间吧。）",
            "nextDialogs": [
              "160110204"
            ]
          },
          "160110204": {
            "id": "160110204",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "后面没有退路，前面又是「狼口」…嗯…",
            "nextDialogs": [
              "160110205"
            ]
          },
          "160110205": {
            "id": "160110205",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "——哈，就往里头走一遭吧。"
          }
        }
      }
    },

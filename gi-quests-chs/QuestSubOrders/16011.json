    {
      "subId": "1601109",
      "subQuestName": "与「染血骑士」对峙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160110901"
        ],
        "dialogs": {
          "160110901": {
            "id": "160110901",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "…如你所愿，「北风骑士」。",
            "nextDialogs": [
              "160110902"
            ]
          },
          "160110902": {
            "id": "160110902",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "哈，跟我想象的不太一样，你看起来好像没有「碎片」里记忆得那么疯狂。",
            "nextDialogs": [
              "160110903"
            ]
          },
          "160110903": {
            "id": "160110903",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "我从未偏离过正确的道路。而你，现在的你不像是能屠龙的英雄，倒像个落魄骑士…流浪了太久。",
            "nextDialogs": [
              "160110904"
            ]
          },
          "160110904": {
            "id": "160110904",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "彼此彼此。看来咱们都不在自己最强的时刻。",
            "nextDialogs": [
              "160110905"
            ]
          },
          "160110905": {
            "id": "160110905",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "「猎月人」的军势已经被击败，由深渊拟造出的「我」，自然也只是不完整的倒影。",
            "nextDialogs": [
              "160110906"
            ]
          },
          "160110906": {
            "id": "160110906",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "力量已臻「罗兰」的极致，心境却依然停滞于染血的时刻。",
            "nextDialogs": [
              "160110907"
            ]
          },
          "160110907": {
            "id": "160110907",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "因此，「我」也同样不正确…而骑士不能容忍自身止步不前。",
            "nextDialogs": [
              "160110908"
            ]
          },
          "160110908": {
            "id": "160110908",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "将你从不公中救赎、引领你投效深渊后，我便会将自身匡正，继续践行骑士之道。",
            "nextDialogs": [
              "160110909"
            ]
          },
          "160110909": {
            "id": "160110909",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "哈，这外头可经不起你继续折腾了…你的这份偏执倒是跟我想象的一样，看来我是没机会说服你了？",
            "nextDialogs": [
              "160110910"
            ]
          },
          "160110910": {
            "id": "160110910",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "骑士信奉的美德不会为言语玷染，无论那言语多么高贵。你我都无法说服彼此，你也早已知晓这一点。",
            "nextDialogs": [
              "160110911"
            ]
          },
          "160110911": {
            "id": "160110911",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "否则，你们又何必将一切希望，都系在玻瑞亚斯的「一念」之间？",
            "nextDialogs": [
              "160110912"
            ]
          },
          "160110912": {
            "id": "160110912",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "但如今你用以承载狼灵的剑刃早已崩毁，手中所执的不过是徒具其形的幻影。",
            "nextDialogs": [
              "160110913"
            ]
          },
          "160110913": {
            "id": "160110913",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "你已没有手段改变一切，也再无援军可以期待…此地即是你的「末路」，孤独的远征者。",
            "nextDialogs": [
              "160110914"
            ]
          },
          "160110914": {
            "id": "160110914",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "呵，手段姑且不论，援军的话…这里不是还有一位吗？",
            "nextDialogs": [
              "160110915"
            ]
          },
          "160110915": {
            "id": "160110915",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "…什么？",
            "nextDialogs": [
              "160110916"
            ]
          },
          "160110916": {
            "id": "160110916",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "——我要说服的对象，从始至终就只有那一位。",
            "nextDialogs": [
              "160110917"
            ]
          },
          "160110917": {
            "id": "160110917",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "这里是北风之魔神——安德留斯的「心」中，对吧？",
            "nextDialogs": [
              "160110918"
            ]
          },
          "160110918": {
            "id": "160110918",
            "speakerId": 16286,
            "speakerName": "安德留斯",
            "text": "……",
            "nextDialogs": [
              "160110919"
            ]
          },
          "160110919": {
            "id": "160110919",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "——喂！听见了吗！安德留斯！",
            "nextDialogs": [
              "160110920"
            ]
          },
          "160110920": {
            "id": "160110920",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "快醒醒吧！堂堂北风之魔神，还要被深渊控制多久！",
            "nextDialogs": [
              "160110921"
            ]
          },
          "160110921": {
            "id": "160110921",
            "speakerId": 16286,
            "speakerName": "安德留斯",
            "text": "……",
            "nextDialogs": [
              "160110922"
            ]
          },
          "160110922": {
            "id": "160110922",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "如果这就是你最后的挣扎，那我很失望，「北风骑士」。",
            "nextDialogs": [
              "160110923"
            ]
          },
          "160110923": {
            "id": "160110923",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "气势和愿望唤不来奇迹，这世界从不会那样仁慈。",
            "nextDialogs": [
              "160110924"
            ]
          },
          "160110924": {
            "id": "160110924",
            "speakerId": 16286,
            "speakerName": "安德留斯",
            "text": "…归去…",
            "nextDialogs": [
              "160110925"
            ]
          },
          "160110925": {
            "id": "160110925",
            "speakerId": 16286,
            "speakerName": "安德留斯",
            "text": "…归于…地脉…",
            "nextDialogs": [
              "160110926"
            ]
          },
          "160110926": {
            "id": "160110926",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "……！",
            "nextDialogs": [
              "160110927"
            ]
          },
          "160110927": {
            "id": "160110927",
            "speakerId": 16286,
            "speakerName": "安德留斯",
            "text": "…这就是「我」的选择…「我」的记忆…",
            "nextDialogs": [
              "160110928"
            ]
          },
          "160110928": {
            "id": "160110928",
            "speakerId": 16286,
            "speakerName": "安德留斯",
            "text": "…是「我」在旅途终点…找到的答案吗？",
            "nextDialogs": [
              "160110929"
            ]
          },
          "160110929": {
            "id": "160110929",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "「安德{RUBY#[D]玻瑞亚斯}留斯」…你的信，我可好好送回到「你」心里了。",
            "nextDialogs": [
              "160110930"
            ]
          },
          "160110930": {
            "id": "160110930",
            "speakerId": 16286,
            "speakerName": "安德留斯",
            "text": "呵…「北风骑士」吗，看着吧…",
            "nextDialogs": [
              "160110931"
            ]
          },
          "160110931": {
            "id": "160110931",
            "speakerId": 16286,
            "speakerName": "安德留斯",
            "text": "…这就是「狼{RUBY#[S]我}」…唯一能为「人{RUBY#[S]你们}」做的事了…",
            "nextDialogs": [
              "160110932"
            ]
          },
          "160110932": {
            "id": "160110932",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…代表地上的人类，向您致谢，群狼的领主。",
            "nextDialogs": [
              "160110933"
            ]
          },
          "160110933": {
            "id": "160110933",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "玻瑞亚斯…正在回归地脉。为什么？你的剑已经破碎，你明明已经没有任何承载灵魂的手段了。不，莫非…",
            "nextDialogs": [
              "160110934"
            ]
          },
          "160110934": {
            "id": "160110934",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "气势和愿望唤不来奇迹…这种事情我当然知道。",
            "nextDialogs": [
              "160110935"
            ]
          },
          "160110935": {
            "id": "160110935",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…但从一开始，寄托灵魂的手段——就不止有「剑」！",
            "nextDialogs": [
              "160110936"
            ]
          },
          "160110936": {
            "id": "160110936",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "…奔狼的领主，曾将灵魂的力量赋予麾下的群狼，强壮它们的心脏，锋利它们的爪牙。",
            "nextDialogs": [
              "160110937"
            ]
          },
          "160110937": {
            "id": "160110937",
            "speakerId": 1176,
            "speakerName": "玻瑞亚斯",
            "text": "…即便「我」无意于此，凡人的「心」，也将会被王狼的灵魂撕咬、吞噬、同化…一如强行混合的人群与狼群。",
            "nextDialogs": [
              "160110938"
            ]
          },
          "160110938": {
            "id": "160110938",
            "speakerId": 14235,
            "speakerName": "「队长」",
            "text": "…以凡人的心脏，承载魔神的灵魂…这将会是一条无法回还的道路，但我不会劝阻一名骑士，踏上自己的征途。",
            "nextDialogs": [
              "160110939"
            ]
          },
          "160110939": {
            "id": "160110939",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "你的心脏、你的灵魂…也在一同崩解？…原来如此。",
            "nextDialogs": [
              "160110940"
            ]
          },
          "160110940": {
            "id": "160110940",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "「羔羊怎么将铃铛系到狼的心口」…你曾经这么问过对吧？",
            "nextDialogs": [
              "160110941"
            ]
          },
          "160110941": {
            "id": "160110941",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "这就是我的答案——让狼自行吞下这颗「心脏」。",
            "nextDialogs": [
              "160110942"
            ]
          },
          "160110942": {
            "id": "160110942",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "托付于剑上那部分狼灵不过是佯攻，真正的念想与记忆，是由你的心脏承载…",
            "nextDialogs": [
              "160110943"
            ]
          },
          "160110943": {
            "id": "160110943",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "为了不被我察觉，故意让王狼的灵魂与你同化，再被我吞噬…迄今为止，你都是承受着这样的重荷在战斗的吗？",
            "nextDialogs": [
              "160110944"
            ]
          },
          "160110944": {
            "id": "160110944",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "比起王狼的决意…这点付出可算不了什么啊。",
            "nextDialogs": [
              "160110945"
            ]
          },
          "160110945": {
            "id": "160110945",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "顽强的意志，优秀的策略…但这不是骑士应有的战斗方式。正因如此，你的选择是错误的。",
            "nextDialogs": [
              "160110946"
            ]
          },
          "160110946": {
            "id": "160110946",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "你的灵魂已同安德留斯融为一体。待它彻底将自身汇入地脉，你也会与它一同坠入其中。",
            "nextDialogs": [
              "160110947"
            ]
          },
          "160110947": {
            "id": "160110947",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "届时，无论是巴巴托斯，还是你身边那位旅人，都已无法从地脉中锚定你的灵魂，更遑论将你救出。",
            "nextDialogs": [
              "160110948"
            ]
          },
          "160110948": {
            "id": "160110948",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "你输了，我也是。很遗憾，现在我已经无法拯救你。",
            "nextDialogs": [
              "160110949"
            ]
          },
          "160110949": {
            "id": "160110949",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "…愿你的灵魂随北风安息，孤独的远征者。",
            "nextDialogs": [
              "160110950"
            ]
          },
          "160110950": {
            "id": "160110950",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…哈哈，孤独吗…",
            "nextDialogs": [
              "160110951"
            ]
          },
          "160110951": {
            "id": "160110951",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "抱歉啊——虽然我也曾经想过，和你同归于地脉的结局，是不是已经挺圆满了。",
            "nextDialogs": [
              "160110952"
            ]
          },
          "160110952": {
            "id": "160110952",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "但可惜呀，跟当年的罗兰不一样，外面可还有美酒跟朋友，在盼着我凯旋呢，所以…",
            "nextDialogs": [
              "160110953"
            ]
          },
          "160110953": {
            "id": "160110953",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "——我还没打算认命！",
            "nextDialogs": [
              "160110954"
            ]
          },
          "160110954": {
            "id": "160110954",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "叮铃——有你的来信~"
          }
        }
      }
    },
    {

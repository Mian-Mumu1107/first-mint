    {
      "subId": "1601111",
      "subQuestName": "凯旋而归",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160111101"
        ],
        "dialogs": {
          "160111101": {
            "id": "160111101",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "……",
            "nextDialogs": [
              "160111102"
            ]
          },
          "160111102": {
            "id": "160111102",
            "speakerId": 16286,
            "speakerName": "安德留斯",
            "text": "…向前走，不必回头。",
            "nextDialogs": [
              "160111103"
            ]
          },
          "160111103": {
            "id": "160111103",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "「法尔伽，我，名字的意义…已经知道了。」",
            "nextDialogs": [
              "160111104"
            ]
          },
          "160111104": {
            "id": "160111104",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "「…给大家添了这么多麻烦，等回来，要好好道谢啊。」",
            "nextDialogs": [
              "160111105"
            ]
          },
          "160111105": {
            "id": "160111105",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "「哟，虽然有很多事想报告，不过嘛…回来了就好。」",
            "nextDialogs": [
              "160111106"
            ]
          },
          "160111106": {
            "id": "160111106",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "「我不打算回骑士团，所以…还是请您自己撑着吧。」",
            "nextDialogs": [
              "160111107"
            ]
          },
          "160111107": {
            "id": "160111107",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "「…大团长，我们都在等您。」",
            "nextDialogs": [
              "160111108"
            ]
          },
          "160111108": {
            "id": "160111108",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "……",
            "nextDialogs": [
              "160111109"
            ]
          },
          "160111109": {
            "id": "160111109",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "嗯？…呵。",
            "nextDialogs": [
              "160111110"
            ]
          },
          "160111110": {
            "id": "160111110",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "我这大团长，当得应该还不赖吧？…各位。",
            "nextDialogs": [
              "160111111"
            ]
          },
          "160111111": {
            "id": "160111111",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…那我就当你们是默认咯。",
            "nextDialogs": [
              "160111112"
            ]
          },
          "160111112": {
            "id": "160111112",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "你们那时誓死拯救下来的事物…现在也都好好在那呢。",
            "nextDialogs": [
              "160111113"
            ]
          },
          "160111113": {
            "id": "160111113",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "嗯，骑士团、蒙德…还有骑士的誓言，我都会守护好。",
            "nextDialogs": [
              "160111114"
            ]
          },
          "160111114": {
            "id": "160111114",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "所以…那封信，我会替你们送到。",
            "nextDialogs": [
              "160111115"
            ]
          },
          "160111115": {
            "id": "160111115",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…虽然只是「他」的倒影，但还有空的话，就替「他」读一读吧？",
            "nextDialogs": [
              "160111116"
            ]
          },
          "160111116": {
            "id": "160111116",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "——鲁斯坦和艾伦德林，都没忘记过你。",
            "nextDialogs": [
              "160111117"
            ]
          },
          "160111117": {
            "id": "160111117",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "哈…这一趟走得还真远啊。",
            "nextDialogs": [
              "160111118"
            ]
          },
          "160111118": {
            "id": "160111118",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "剩下的就…",
            "nextDialogs": [
              "160111119"
            ]
          },
          "160111119": {
            "id": "160111119",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…「听凭风引」吧。",
            "nextDialogs": [
              "160111122"
            ]
          },
          "160111122": {
            "id": "160111122",
            "speakerId": 1011,
            "speakerName": "众骑士",
            "text": "……！",
            "nextDialogs": [
              "160111130"
            ]
          },
          "160111130": {
            "id": "160111130",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…哟，好久不见，诸位。",
            "nextDialogs": [
              "160111131"
            ]
          },
          "160111131": {
            "id": "160111131",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…能再见到你们，真是太好了。",
            "nextDialogs": [
              "160111132"
            ]
          },
          "160111132": {
            "id": "160111132",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "欢迎凯旋——大团长。",
            "nextDialogs": [
              "160111133"
            ]
          },
          "160111133": {
            "id": "160111133",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…嗯，我回来了。",
            "nextDialogs": [
              "160111123"
            ]
          },
          "160111123": {
            "id": "160111123",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "……",
            "nextDialogs": [
              "160111124"
            ]
          },
          "160111124": {
            "id": "160111124",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "……",
            "nextDialogs": [
              "160111125"
            ]
          },
          "160111125": {
            "id": "160111125",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "……",
            "nextDialogs": [
              "160111126"
            ]
          },
          "160111126": {
            "id": "160111126",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "……"
          }
        }
      }
    },
    {
      "subId": "1601112",
      "subQuestName": "与法尔伽聊聊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160111201"
        ],
        "dialogs": {
          "160111201": {
            "id": "160111201",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "呼——好久没吹过这儿的风了，还是老样子啊。有什么事想聊吗？趁着我还没被抓回办公室。",
            "nextDialogs": [
              "160111203",
              "160111216",
              "160111220",
              "160111232"
            ]
          },
          "160111203": {
            "id": "160111203",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "以剑刃作为佯攻，以心脏承载灵魂…是我当初认为最可行的计划。",
            "nextDialogs": [
              "160111204"
            ]
          },
          "160111204": {
            "id": "160111204",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "不过计划的后半部分…靠思念的牵引杀出地脉…我倒也确实没几成把握，哈哈。",
            "nextDialogs": [
              "160111205"
            ]
          },
          "160111205": {
            "id": "160111205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#说真的，要是那时候{NICKNAME}分离罗兰杂质的实验没成功，你打算怎么办啊？",
            "nextDialogs": [
              "160111206"
            ]
          },
          "160111206": {
            "id": "160111206",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "嗯…这一步最初是准备交给巴巴托斯执行的，但他听完之后，马上向我举荐了更合适的人选…「捕风的异乡人」。",
            "nextDialogs": [
              "160111207"
            ]
          },
          "160111207": {
            "id": "160111207",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "#事实证明，我们的信任没有错。多谢你了，{NICKNAME}。",
            "nextDialogs": [
              "160111208"
            ]
          },
          "160111208": {
            "id": "160111208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那万一我也没成功呢？",
            "nextDialogs": [
              "160111209"
            ]
          },
          "160111209": {
            "id": "160111209",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "——那可能就得辛苦巴巴托斯，把我从狼的那一头，吹回人的这一头了？",
            "nextDialogs": [
              "160111210"
            ]
          },
          "160111210": {
            "id": "160111210",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "…但无论如何，代价都不会小，成功的概率也未必会高…而我更不希望他去耗用这种力量。"
          },
          "160111216": {
            "id": "160111216",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "嗯，这次击败罗兰倒影之后，狂猎在短时间内应该无力再组织反扑了。",
            "nextDialogs": [
              "160111217"
            ]
          },
          "160111217": {
            "id": "160111217",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "除了一部分留在挪德卡莱的据点里轮值的人，剩下的都会分波次陆续返回。",
            "nextDialogs": [
              "160111218"
            ]
          },
          "160111218": {
            "id": "160111218",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "阿贝多跟杜林也会跟第一波远征军一起回来，你们应该过不久就能再见到他们了。"
          },
          "160111220": {
            "id": "160111220",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "我的未来吗…没准你也已经从巴巴托斯或者魔女会之类的地方了解过了，我曾在水占盘里窥见一些未来的倒影。",
            "nextDialogs": [
              "160111221"
            ]
          },
          "160111221": {
            "id": "160111221",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「来自北方的深渊灾厄」？",
            "nextDialogs": [
              "160111222"
            ]
          },
          "160111222": {
            "id": "160111222",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "对，如今看来…这个未来，大概算是已经改变了吧，托你的福。",
            "nextDialogs": [
              "160111223"
            ]
          },
          "160111223": {
            "id": "160111223",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "但等我办完骑士团里的琐事，还是得回北边一趟…挪德卡莱的新据点里还有很多工作要处理。",
            "nextDialogs": [
              "160111224"
            ]
          },
          "160111224": {
            "id": "160111224",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "第一批自愿留守的骑士们都还没换班回来，我又怎么能放下他们不管呢？",
            "nextDialogs": [
              "160111225"
            ]
          },
          "160111225": {
            "id": "160111225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说得这么好听，该不会就是为了把蒙德的工作继续丢给琴吧！",
            "nextDialogs": [
              "160111226"
            ]
          },
          "160111226": {
            "id": "160111226",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "……",
            "nextDialogs": [
              "160111227"
            ]
          },
          "160111227": {
            "id": "160111227",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…不会吧！"
          },
          "160111232": {
            "id": "160111232",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "嗯，那我就自己再吹上一会儿吧——最醉人的酒，还得是老家的风啊。"
          }
        }
      }
    },
    {
      "subId": "1601199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160119906"
        ],
        "dialogs": {
          "160119906": {
            "id": "160119906",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "…无论什么时代，世间总是充斥着污浊与不公。",
            "nextDialogs": [
              "160119907"
            ]
          },
          "160119907": {
            "id": "160119907",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "纵是最无畏的勇士，也战胜不了被注定的命{RUBY#[S]死}运。",
            "nextDialogs": [
              "160119908"
            ]
          },
          "160119908": {
            "id": "160119908",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "纵是最圣洁的神明，也摆脱不了被强加的枷{RUBY#[S]爱}锁。",
            "nextDialogs": [
              "160119909"
            ]
          },
          "160119909": {
            "id": "160119909",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "王狼啊，若你依然心怀对人的爱，那你应当心知肚明…",
            "nextDialogs": [
              "160119910"
            ]
          },
          "160119910": {
            "id": "160119910",
            "speakerId": 16276,
            "speakerName": "「罗兰」",
            "text": "将他们从不公中拯救的方法，从始至终，只有一种。",
            "nextDialogs": [
              "160119911"
            ]
          },
          "160119911": {
            "id": "160119911",
            "speakerId": 16286,
            "speakerName": "安德留斯",
            "text": "…投入…深渊…？"
          }
        }
      }
    }
  ]
}
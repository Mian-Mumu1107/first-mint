    {
      "subId": "7180802",
      "subQuestName": "到南天门调查异常",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718080201"
        ],
        "dialogs": {
          "718080201": {
            "id": "718080201",
            "speakerId": 10406,
            "speakerName": "阿鸠",
            "text": "待苏醒之时…",
            "nextDialogs": [
              "718080202"
            ]
          },
          "718080202": {
            "id": "718080202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还好吗？",
            "nextDialogs": [
              "718080203"
            ]
          },
          "718080203": {
            "id": "718080203",
            "speakerId": 10406,
            "speakerName": "阿鸠",
            "text": "你是想要来见证「那位」的复苏吗？",
            "nextDialogs": [
              "718080204"
            ]
          },
          "718080204": {
            "id": "718080204",
            "speakerId": 10406,
            "speakerName": "阿鸠",
            "text": "你来得稍微早了些…不过，也不算太晚。",
            "nextDialogs": [
              "718080205"
            ]
          },
          "718080205": {
            "id": "718080205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她在说什么呀，完全听不懂…",
            "nextDialogs": [
              "718080206"
            ]
          },
          "718080206": {
            "id": "718080206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呃，你在说什么？",
            "nextDialogs": [
              "718080207"
            ]
          },
          "718080207": {
            "id": "718080207",
            "speakerId": 10406,
            "speakerName": "阿鸠",
            "text": "呵呵，你还没有意识到么…",
            "nextDialogs": [
              "718080208"
            ]
          },
          "718080208": {
            "id": "718080208",
            "speakerId": 10406,
            "speakerName": "阿鸠",
            "text": "对你来说，这样也不错。",
            "nextDialogs": [
              "718080209"
            ]
          },
          "718080209": {
            "id": "718080209",
            "speakerId": 10406,
            "speakerName": "阿鸠",
            "text": "回去吧，等到「那位」复苏的时候，你会明白一切的。"
          }
        }
      }
    },
    {
      "subId": "7180803",
      "subQuestName": "到南天门调查异常",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718080301"
        ],
        "dialogs": {
          "718080301": {
            "id": "718080301",
            "speakerId": 2056,
            "speakerName": "嘉义",
            "text": "你回来了，情况怎么样？",
            "nextDialogs": [
              "718080302"
            ]
          },
          "718080302": {
            "id": "718080302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于南天门的情况…",
            "nextDialogs": [
              "718080303"
            ]
          },
          "718080303": {
            "id": "718080303",
            "speakerId": 2056,
            "speakerName": "嘉义",
            "text": "地震、魔物，还有个小女孩…是谁家孩子走失了吗？",
            "nextDialogs": [
              "718080304"
            ]
          },
          "718080304": {
            "id": "718080304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于小女孩说的话…",
            "nextDialogs": [
              "718080305"
            ]
          },
          "718080305": {
            "id": "718080305",
            "speakerId": 2056,
            "speakerName": "嘉义",
            "text": "那个孩子说什么了？「那位」的复苏？见证？这都什么乱七八糟的…",
            "nextDialogs": [
              "718080306"
            ]
          },
          "718080306": {
            "id": "718080306",
            "speakerId": 2056,
            "speakerName": "嘉义",
            "text": "准是又看了什么奇奇怪怪的书…算了，我马上去安排人，把那孩子带回城里来。",
            "nextDialogs": [
              "718080307"
            ]
          },
          "718080307": {
            "id": "718080307",
            "speakerId": 2056,
            "speakerName": "嘉义",
            "text": "又是地震又是魔物，那孩子可别被伤着了。",
            "nextDialogs": [
              "718080308"
            ]
          },
          "718080308": {
            "id": "718080308",
            "speakerId": 2056,
            "speakerName": "嘉义",
            "text": "谢谢你，这些东西请你收下吧，辛苦你帮我跑这一趟了。",
            "nextDialogs": [
              "718080309"
            ]
          },
          "718080309": {
            "id": "718080309",
            "speakerId": 2056,
            "speakerName": "嘉义",
            "text": "唉，事情真是只多不少…"
          }
        }
      }
    },

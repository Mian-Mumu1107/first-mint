  "subQuests": [
    {
      "subId": "7069301",
      "subQuestName": "与正在讨论的两人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706930101"
        ],
        "dialogs": {
          "706930101": {
            "id": "706930101",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "所以说呀，我们都看出来了！",
            "nextDialogs": [
              "706930102"
            ]
          },
          "706930102": {
            "id": "706930102",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "优菈最讨厌的应该是那种…死板和迂腐写在眉毛之间，一股劲儿钻牛角尖，只知道在流程和细节上卡人的家伙！",
            "nextDialogs": [
              "706930103"
            ]
          },
          "706930103": {
            "id": "706930103",
            "speakerId": 1001,
            "speakerName": "烟绯",
            "text": "说不定，脸上还戴着单片眼镜，手里时常拿着一本书，但自己并没有完全读透，只是把它当成了装饰品。",
            "nextDialogs": [
              "706930104"
            ]
          },
          "706930104": {
            "id": "706930104",
            "speakerId": 1001,
            "speakerName": "烟绯",
            "text": "如此一来，就显得自己有股「老学派」的气质，好像对话刚开始，就能在气势上压人一头！",
            "nextDialogs": [
              "706930105"
            ]
          },
          "706930105": {
            "id": "706930105",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "啊，实在太精准了，我的脑袋里都有画面了！",
            "nextDialogs": [
              "706930106"
            ]
          },
          "706930106": {
            "id": "706930106",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "烟绯和…安柏？是之前完全没见过的组合！",
            "nextDialogs": [
              "706930109"
            ]
          },
          "706930109": {
            "id": "706930109",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "啊呀，荣誉骑士和派蒙，你们来啦！",
            "nextDialogs": [
              "706930110"
            ]
          },
          "706930110": {
            "id": "706930110",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "我正和烟绯商量方案呢，要不要给我们的游艺加几个「坏家伙雪人」，当成彩蛋。",
            "nextDialogs": [
              "706930111"
            ]
          },
          "706930111": {
            "id": "706930111",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "就像是魔物的靶子吗？",
            "nextDialogs": [
              "706930112"
            ]
          },
          "706930112": {
            "id": "706930112",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "除了反派专业户魔物，也可以有些不那么传统的形象。",
            "nextDialogs": [
              "706930113"
            ]
          },
          "706930113": {
            "id": "706930113",
            "speakerId": 1000,
            "speakerName": "安柏",
            "text": "在选角的方向上，我和烟绯不谋而合的点子太多了！"
          }
        }
      }
    }
  ]
}
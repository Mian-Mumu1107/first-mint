    {
      "subId": "7216312",
      "subQuestName": "询问冒险家",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721630201"
        ],
        "dialogs": {
          "721630201": {
            "id": "721630201",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "真是头疼啊…",
            "nextDialogs": [
              "721630202"
            ]
          },
          "721630202": {
            "id": "721630202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于这张图…",
            "nextDialogs": [
              "721630203"
            ]
          },
          "721630203": {
            "id": "721630203",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "这张图上的地形，看起来像是清籁岛的某处呢…",
            "nextDialogs": [
              "721630204"
            ]
          },
          "721630204": {
            "id": "721630204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是怎么看出来的？",
            "nextDialogs": [
              "721630205"
            ]
          },
          "721630205": {
            "id": "721630205",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "毕竟协会也发布过一些和清籁岛有关的探索委托。",
            "nextDialogs": [
              "721630206"
            ]
          },
          "721630206": {
            "id": "721630206",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "那些接下了委托的冒险家，回来协会报告的时候，也带回来了一些和清籁岛有关的情报。",
            "nextDialogs": [
              "721630207"
            ]
          },
          "721630207": {
            "id": "721630207",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "但因为人手问题，我们暂时也没办法组织大规模的探索，只能每隔一段时间派遣几位冒险家过去探索。",
            "nextDialogs": [
              "721630208"
            ]
          },
          "721630208": {
            "id": "721630208",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "所以，我手里关于清籁岛的情报也有限，没办法再帮你继续解读这张图了。",
            "nextDialogs": [
              "721630209"
            ]
          },
          "721630209": {
            "id": "721630209",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "不过，我倒是知道城里有一位和清籁岛有关的人。",
            "nextDialogs": [
              "721630210"
            ]
          },
          "721630210": {
            "id": "721630210",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "他叫太田太郎，据他说…他的祖先曾经居住在清籁岛，后来因为各种原因才移居到了这里。",
            "nextDialogs": [
              "721630211"
            ]
          },
          "721630211": {
            "id": "721630211",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "前段时间，他还来过协会，说是想雇佣几位冒险家，陪他回去清籁岛看看…",
            "nextDialogs": [
              "721630212"
            ]
          },
          "721630212": {
            "id": "721630212",
            "speakerId": 3005,
            "speakerName": "古谷升",
            "text": "你可以拿着这张图去找太田太郎先生问问，说不定他会知道些什么。"
          }
        }
      }
    },
    {
      "subId": "7216302",
      "subQuestName": "询问太田太郎",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721630301"
        ],
        "dialogs": {
          "721630301": {
            "id": "721630301",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "唉，什么时候才能找到人陪我回去看看呢…",
            "nextDialogs": [
              "721630302"
            ]
          },
          "721630302": {
            "id": "721630302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于这张图…",
            "nextDialogs": [
              "721630303"
            ]
          },
          "721630303": {
            "id": "721630303",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "你是…冒险家协会的冒险家吗？他们终于抽出人手了？",
            "nextDialogs": [
              "721630304"
            ]
          },
          "721630304": {
            "id": "721630304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我只是个路过的旅行者啦。",
            "nextDialogs": [
              "721630305"
            ]
          },
          "721630305": {
            "id": "721630305",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "好吧…你想给我看什么图？",
            "nextDialogs": [
              "721630306"
            ]
          },
          "721630306": {
            "id": "721630306",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "我看看…",
            "nextDialogs": [
              "721630307"
            ]
          },
          "721630307": {
            "id": "721630307",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "这、这！难道这是…",
            "nextDialogs": [
              "721630310"
            ]
          },
          "721630310": {
            "id": "721630310",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "这不是清籁岛吗！？"
          }
        }
      }
    },

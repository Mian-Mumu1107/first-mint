    {
      "subId": "7216310",
      "subQuestName": "*废弃test",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721630401"
        ],
        "dialogs": {
          "721630401": {
            "id": "721630401",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "你回来了，怎么样？你记录到画片了吗？",
            "nextDialogs": [
              "721630402"
            ]
          },
          "721630402": {
            "id": "721630402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经记录到了。",
            "nextDialogs": [
              "721630403"
            ]
          },
          "721630403": {
            "id": "721630403",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "太好了，我来看看…",
            "nextDialogs": [
              "721630404"
            ]
          },
          "721630404": {
            "id": "721630404",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "呃…",
            "nextDialogs": [
              "721630405"
            ]
          },
          "721630405": {
            "id": "721630405",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "哈哈哈，完全看不出来是什么地方…",
            "nextDialogs": [
              "721630406"
            ]
          },
          "721630406": {
            "id": "721630406",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "不过，那三张画上的景致，还真是变了不少啊。",
            "nextDialogs": [
              "721630407"
            ]
          },
          "721630407": {
            "id": "721630407",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "不知道那位藤原俊子小姐…能不能认出这些地方。",
            "nextDialogs": [
              "721630408"
            ]
          },
          "721630408": {
            "id": "721630408",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "不过…哈哈，我想她应该也很难能认出来…",
            "nextDialogs": [
              "721630409"
            ]
          },
          "721630409": {
            "id": "721630409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她也是从清籁岛来的？",
            "nextDialogs": [
              "721630410"
            ]
          },
          "721630410": {
            "id": "721630410",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "准确地说，是和我一样，祖上曾经在清籁岛上居住过。",
            "nextDialogs": [
              "721630411"
            ]
          },
          "721630411": {
            "id": "721630411",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "哎呀，其实稻妻城里还有很多祖上曾经住在清籁岛上的人。",
            "nextDialogs": [
              "721630412"
            ]
          },
          "721630412": {
            "id": "721630412",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们为什么从清籁岛搬走？",
            "nextDialogs": [
              "721630413"
            ]
          },
          "721630413": {
            "id": "721630413",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "我记不太清楚了…毕竟是好久之前的事了。",
            "nextDialogs": [
              "721630414"
            ]
          },
          "721630414": {
            "id": "721630414",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "好像是因为雷暴太猛了，还是为了预防偷渡和走私什么的…",
            "nextDialogs": [
              "721630415"
            ]
          },
          "721630415": {
            "id": "721630415",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "总之，在幕府的统一安排下，清籁岛上的人基本上都迁到了鸣神岛上。",
            "nextDialogs": [
              "721630416"
            ]
          },
          "721630416": {
            "id": "721630416",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "哦，先不说闲话了，这些东西给你，收下吧，谢谢你帮我跑这一趟。",
            "nextDialogs": [
              "721630417"
            ]
          },
          "721630417": {
            "id": "721630417",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "唉，我到底什么时候才能亲自去一趟清籁岛呢？",
            "nextDialogs": [
              "721630418"
            ]
          },
          "721630418": {
            "id": "721630418",
            "speakerId": 3062,
            "speakerName": "太田太郎",
            "text": "还是先忙完手上这一单生意吧…"
          }
        }
      }
    },

    {
      "subId": "4008002",
      "subQuestName": "前往西风骑士团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400800201"
        ],
        "dialogs": {
          "400800201": {
            "id": "400800201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也不知道雷泽那边，「补课」的进展是不是顺利…",
            "nextDialogs": [
              "400800202"
            ]
          },
          "400800202": {
            "id": "400800202",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "砂糖小姐，请等一下！",
            "nextDialogs": [
              "400800203"
            ]
          },
          "400800203": {
            "id": "400800203",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "#{NICKNAME}前辈，派蒙，请帮我拦住她！",
            "nextDialogs": [
              "400800204"
            ]
          },
          "400800204": {
            "id": "400800204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，吓我一跳！",
            "nextDialogs": [
              "400800205"
            ]
          },
          "400800205": {
            "id": "400800205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们两个，怎么慌慌张张的？",
            "nextDialogs": [
              "400800206"
            ]
          },
          "400800206": {
            "id": "400800206",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "是这样的，我和砂糖小姐说好要一起把酿酒材料交给你们，可她一听说雷泽也要来，说什么都不肯留在这里。",
            "nextDialogs": [
              "400800207"
            ]
          },
          "400800207": {
            "id": "400800207",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "我…我不擅长和陌生人打交道，只要材料能平安送到就可以了…",
            "nextDialogs": [
              "400800208"
            ]
          },
          "400800208": {
            "id": "400800208",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "这怎么行呢！既然是我们两人合作完成的，就应该一起出面。我不能抢了砂糖小姐的功劳。",
            "nextDialogs": [
              "400800209"
            ]
          },
          "400800209": {
            "id": "400800209",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "不是…功劳什么的…",
            "nextDialogs": [
              "400800210"
            ]
          },
          "400800210": {
            "id": "400800210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么看来，骑士团准备的材料是「生物炼金」的产物咯？",
            "nextDialogs": [
              "400800211"
            ]
          },
          "400800211": {
            "id": "400800211",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "对，是「四倍甜日落果」。",
            "nextDialogs": [
              "400800212"
            ]
          },
          "400800212": {
            "id": "400800212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "四倍甜？普通的甜度还不够吗？",
            "nextDialogs": [
              "400800213"
            ]
          },
          "400800213": {
            "id": "400800213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且…为什么是日落果？",
            "nextDialogs": [
              "400800214"
            ]
          },
          "400800214": {
            "id": "400800214",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "嗯，这就要从头说起了。",
            "nextDialogs": [
              "400800215"
            ]
          },
          "400800215": {
            "id": "400800215",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "我很喜欢闻酒的味道，对酿酒这件事情，也学习和总结过一些经验。",
            "nextDialogs": [
              "400800216"
            ]
          },
          "400800216": {
            "id": "400800216",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "从结论来说，原材料的甜味是必不可少的！",
            "nextDialogs": [
              "400800217"
            ]
          },
          "400800217": {
            "id": "400800217",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "为了选出最合适的那一种，我找来了蒙德周边所有含有甜味的植物和果实，逐一试吃并记录了一份完整的清单。",
            "nextDialogs": [
              "400800218"
            ]
          },
          "400800218": {
            "id": "400800218",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "不同地点的同种素材也纳入了考量，比如清泉镇附近的甜甜花会比誓言岬的更甜一些。",
            "nextDialogs": [
              "400800219"
            ]
          },
          "400800219": {
            "id": "400800219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，听上去工作量好大…",
            "nextDialogs": [
              "400800220"
            ]
          },
          "400800220": {
            "id": "400800220",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "没关系，这就是我身为「骑士团女仆」应该做的！",
            "nextDialogs": [
              "400800221"
            ]
          },
          "400800221": {
            "id": "400800221",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "能够代表骑士团，找到「守护的执着」，对我来说也是无上的荣幸！",
            "nextDialogs": [
              "400800222"
            ]
          },
          "400800222": {
            "id": "400800222",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "诺艾尔的眼睛，在发光…",
            "nextDialogs": [
              "400800223"
            ]
          },
          "400800223": {
            "id": "400800223",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但我觉得，她是被丽莎小姐给…",
            "nextDialogs": [
              "400800224"
            ]
          },
          "400800224": {
            "id": "400800224",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，嘘。",
            "nextDialogs": [
              "400800225"
            ]
          },
          "400800225": {
            "id": "400800225",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "啊，说回正题。只有我独自进行评测的话，我会担心陷入主观。那天正好遇到了从实验室里出来的砂糖小姐，就问了问她…",
            "nextDialogs": [
              "400800226"
            ]
          },
          "400800226": {
            "id": "400800226",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "啊！",
            "nextDialogs": [
              "400800227"
            ]
          },
          "400800227": {
            "id": "400800227",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "怎么了，砂糖？",
            "nextDialogs": [
              "400800228"
            ]
          },
          "400800228": {
            "id": "400800228",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "我突然想起来…我出门是为了去领最近进口的一批实验器材…",
            "nextDialogs": [
              "400800229"
            ]
          },
          "400800229": {
            "id": "400800229",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "……",
            "nextDialogs": [
              "400800230"
            ]
          },
          "400800230": {
            "id": "400800230",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看你们的脸色…该不会是把这事情忘记了，一直在实验室里待到今天吧…",
            "nextDialogs": [
              "400800231"
            ]
          },
          "400800231": {
            "id": "400800231",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "嗯，是的…对不起…",
            "nextDialogs": [
              "400800232"
            ]
          },
          "400800232": {
            "id": "400800232",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "唉，别在意，我也有责任。器材我晚些再去找玛乔丽小姐吧。诺艾尔，你先继续说吧。",
            "nextDialogs": [
              "400800233"
            ]
          },
          "400800233": {
            "id": "400800233",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "是，是！",
            "nextDialogs": [
              "400800234"
            ]
          },
          "400800234": {
            "id": "400800234",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "砂糖小姐不愧是专业的研究员！对我的清单提出了宝贵的建议…",
            "nextDialogs": [
              "400800235"
            ]
          },
          "400800235": {
            "id": "400800235",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "就不用特意夸我了啦…",
            "nextDialogs": [
              "400800236"
            ]
          },
          "400800236": {
            "id": "400800236",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "在那之后，诺艾尔也告诉了我事情的经过。",
            "nextDialogs": [
              "400800237"
            ]
          },
          "400800237": {
            "id": "400800237",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "她明明不认识那位名叫雷泽的少年，却做得那么认真…让我很感动。但在我看来，现有材料都不足以达到「完美」这一要求。",
            "nextDialogs": [
              "400800238"
            ]
          },
          "400800238": {
            "id": "400800238",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "我们需要的是一种含糖量高又便于发酵的水果，最后，我从清单里选择了果酒湖周围采集的日落果样本作为基础，将它改良。",
            "nextDialogs": [
              "400800239"
            ]
          },
          "400800239": {
            "id": "400800239",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "通过「生物炼金」放大甜味的特征，再加以实验对照…",
            "nextDialogs": [
              "400800240"
            ]
          },
          "400800240": {
            "id": "400800240",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "一旦开始做实验，砂糖小姐的毅力就令我自愧不如！",
            "nextDialogs": [
              "400800241"
            ]
          },
          "400800241": {
            "id": "400800241",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "啊，都说了请不要夸奖我…",
            "nextDialogs": [
              "400800242"
            ]
          },
          "400800242": {
            "id": "400800242",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "总之…「伍式日落果改陆叁号四倍甜度版」，终于研发成功了，甜度经过严格测量，色泽和饱满度也是一流的。",
            "nextDialogs": [
              "400800243"
            ]
          },
          "400800243": {
            "id": "400800243",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "诺艾尔把它简称为「四倍甜日落果」。",
            "nextDialogs": [
              "400800244"
            ]
          },
          "400800244": {
            "id": "400800244",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "可惜现在的条件还不支持大规模量产…这次能帮上雷泽就好了。",
            "nextDialogs": [
              "400800248",
              "400800247"
            ]
          },
          "400800248": {
            "id": "400800248",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "#{NICKNAME}，我还有一些话想说。",
            "nextDialogs": [
              "400800249"
            ]
          },
          "400800249": {
            "id": "400800249",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "从小到大…我都生活得很幸福。虽然一直不太擅长跟人打交道，但父母从没对我提过要求。",
            "nextDialogs": [
              "400800250"
            ]
          },
          "400800250": {
            "id": "400800250",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "他们从没对我说过「你应该表现得更开朗一点」，只是告诉我「做自己喜欢的事就好。」",
            "nextDialogs": [
              "400800251"
            ]
          },
          "400800251": {
            "id": "400800251",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "我知道…我是幸运的。",
            "nextDialogs": [
              "400800252"
            ]
          },
          "400800252": {
            "id": "400800252",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "雷泽的生活，我从未经历过，也无从想象。贸然说这些话只会是冒犯。但我真心希望他能过得快乐，能去做自己想做的事。",
            "nextDialogs": [
              "400800253"
            ]
          },
          "400800253": {
            "id": "400800253",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "砂糖小姐…",
            "nextDialogs": [
              "400800254"
            ]
          },
          "400800254": {
            "id": "400800254",
            "speakerId": 1003,
            "speakerName": "图书馆的门",
            "text": "「咔嗒——」",
            "nextDialogs": [
              "400800255"
            ]
          },
          "400800255": {
            "id": "400800255",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "对不起，我又来晚了。",
            "nextDialogs": [
              "400800256"
            ]
          },
          "400800256": {
            "id": "400800256",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "师父，忘记看时间，一直，在说话。",
            "nextDialogs": [
              "400800257"
            ]
          },
          "400800257": {
            "id": "400800257",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没事哦，我们刚好也在聊天呢。欸，总感觉这两天说过一模一样的话…",
            "nextDialogs": [
              "400800258"
            ]
          },
          "400800258": {
            "id": "400800258",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（咦，等等，砂糖怎么不见了？）",
            "nextDialogs": [
              "400800259"
            ]
          },
          "400800259": {
            "id": "400800259",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "（竟然趁他推门出来的时机跑掉了？！）",
            "nextDialogs": [
              "400800260"
            ]
          },
          "400800260": {
            "id": "400800260",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "你好！我是西风骑士团的女仆诺艾尔。",
            "nextDialogs": [
              "400800261"
            ]
          },
          "400800261": {
            "id": "400800261",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "你好。",
            "nextDialogs": [
              "400800262"
            ]
          },
          "400800262": {
            "id": "400800262",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "这份材料请你收下。这并不是我一个人准备的！另一位炼金术士，她现在…那个…",
            "nextDialogs": [
              "400800263"
            ]
          },
          "400800263": {
            "id": "400800263",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她工作有点忙。",
            "nextDialogs": [
              "400800264"
            ]
          },
          "400800264": {
            "id": "400800264",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "啊，对…很遗憾，不能亲手交给你。",
            "nextDialogs": [
              "400800265"
            ]
          },
          "400800265": {
            "id": "400800265",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "药剂，花蜜，还有风晶蝶一样的味道…对吗？",
            "nextDialogs": [
              "400800266"
            ]
          },
          "400800266": {
            "id": "400800266",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，果然瞒不过雷泽的嗅觉呀。",
            "nextDialogs": [
              "400800267"
            ]
          },
          "400800267": {
            "id": "400800267",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "日落果，比之前闻到过的，都甜。可莉说过，炼金术，超级厉害，能让东西变好。",
            "nextDialogs": [
              "400800268"
            ]
          },
          "400800268": {
            "id": "400800268",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "嗯！希望这种甜蜜的果子，能为你们酿出最甜最好的酒。"
          },
          "400800247": {
            "id": "400800247",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！你怎么回事啊？"
          }
        }
      }
    },
    {
      "subId": "4008003",
      "subQuestName": "前往佳酿节会场进行酒浆调制",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400800301"
        ],
        "dialogs": {
          "400800301": {
            "id": "400800301",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#荣誉骑士{M#哥哥}{F#姐姐}，雷泽，这里这里！你们看看谁来啦！",
            "nextDialogs": [
              "400800302"
            ]
          },
          "400800302": {
            "id": "400800302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，这不是迪奥娜吗？我还以为你会来猫尾酒馆的摊位，结果好几天都没看见你！",
            "nextDialogs": [
              "400800303"
            ]
          },
          "400800303": {
            "id": "400800303",
            "speakerId": 502,
            "speakerName": "迪奥娜",
            "text": "呜…不可原谅…",
            "nextDialogs": [
              "400800304"
            ]
          },
          "400800304": {
            "id": "400800304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？欸——你怎么了？",
            "nextDialogs": [
              "400800305"
            ]
          },
          "400800305": {
            "id": "400800305",
            "speakerId": 502,
            "speakerName": "迪奥娜",
            "text": "唔呃呃呃呃呃——气死我啦！",
            "nextDialogs": [
              "400800306"
            ]
          },
          "400800306": {
            "id": "400800306",
            "speakerId": 502,
            "speakerName": "迪奥娜",
            "text": "可莉都告诉我了，都是你们两个干的好事，竟然让雷泽…让爸爸的朋友，可靠的好人！也对酒产生了兴趣！",
            "nextDialogs": [
              "400800307"
            ]
          },
          "400800307": {
            "id": "400800307",
            "speakerId": 502,
            "speakerName": "迪奥娜",
            "text": "雷泽，你绝对不可以变成趴在酒桌上哇哇大哭的臭大叔！",
            "nextDialogs": [
              "400800308"
            ]
          },
          "400800308": {
            "id": "400800308",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "我，呃…不明白。",
            "nextDialogs": [
              "400800309"
            ]
          },
          "400800309": {
            "id": "400800309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来像是有什么误会…",
            "nextDialogs": [
              "400800310"
            ]
          },
          "400800310": {
            "id": "400800310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小可莉，你到底是怎么说的呀？",
            "nextDialogs": [
              "400800311"
            ]
          },
          "400800311": {
            "id": "400800311",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#唔…我和迪奥娜姐姐说，雷泽要找妈妈，荣誉骑士{M#哥哥}{F#姐姐}在帮他，他们很难过，他们需要酒，所以想要你帮忙…",
            "nextDialogs": [
              "400800312"
            ]
          },
          "400800312": {
            "id": "400800312",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "还没说完，迪奥娜姐姐就回答：「可莉，你不用再说了，这件事我一定要管。」然后，我们就一起过来了…",
            "nextDialogs": [
              "400800313"
            ]
          },
          "400800313": {
            "id": "400800313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "400800314"
            ]
          },
          "400800314": {
            "id": "400800314",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "呃…",
            "nextDialogs": [
              "400800315"
            ]
          },
          "400800315": {
            "id": "400800315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好…好吧，我都不知道该怎么接话了。迪奥娜，关于这件事，传达环节出现了一点问题…",
            "nextDialogs": [
              "400800316"
            ]
          },
          "400800316": {
            "id": "400800316",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "向迪奥娜讲述了来龙去脉…",
            "nextDialogs": [
              "400800317"
            ]
          },
          "400800317": {
            "id": "400800317",
            "speakerId": 502,
            "speakerName": "迪奥娜",
            "text": "你们的意思是说，雷泽是想通过制作父母从前酿造的酒，来了解他们的过去…不是刚编了一个说辞在骗我吧？",
            "nextDialogs": [
              "400800320"
            ]
          },
          "400800320": {
            "id": "400800320",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "迪奥娜姐姐对不起，是可莉不好，没有说清楚。",
            "nextDialogs": [
              "400800321"
            ]
          },
          "400800321": {
            "id": "400800321",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "你可不可以不要生气，帮帮雷泽做酒？",
            "nextDialogs": [
              "400800322"
            ]
          },
          "400800322": {
            "id": "400800322",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "我抓好多鱼跟你一起吃，喏，嘟嘟可也给你摸摸。",
            "nextDialogs": [
              "400800323"
            ]
          },
          "400800323": {
            "id": "400800323",
            "speakerId": 502,
            "speakerName": "迪奥娜",
            "text": "我…我才没有多生气呢。",
            "nextDialogs": [
              "400800324"
            ]
          },
          "400800324": {
            "id": "400800324",
            "speakerId": 502,
            "speakerName": "迪奥娜",
            "text": "可莉是想帮忙做好事，我明白。",
            "nextDialogs": [
              "400800325"
            ]
          },
          "400800325": {
            "id": "400800325",
            "speakerId": 502,
            "speakerName": "迪奥娜",
            "text": "我刚才是因为不想雷泽被带坏，才不小心把声音抬高了一点点…既然不是要自己喝，那就勉为其难地帮你们一下好了。",
            "nextDialogs": [
              "400800326"
            ]
          },
          "400800326": {
            "id": "400800326",
            "speakerId": 502,
            "speakerName": "迪奥娜",
            "text": "但有些事先说好，我平时调制的都是酿好的酒。现在突然要从混合原料开始制作，我也不知道会变成怎么样哦…",
            "nextDialogs": [
              "400800327"
            ]
          },
          "400800327": {
            "id": "400800327",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "太好啦！迪奥娜姐姐是大好人！",
            "nextDialogs": [
              "400800328"
            ]
          },
          "400800328": {
            "id": "400800328",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "嗯。"
          }
        }
      }
    },
    {
      "subId": "4008004",
      "subQuestName": "前往风起地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400800401"
        ],
        "dialogs": {
          "400800401": {
            "id": "400800401",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "好巧好巧，你们也来啦。",
            "nextDialogs": [
              "400800402"
            ]
          },
          "400800402": {
            "id": "400800402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "卖唱的，你怎么会在这里？",
            "nextDialogs": [
              "400800403"
            ]
          },
          "400800403": {
            "id": "400800403",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我一觉醒来，空中飘来一阵特别好闻的味道。顺着果子的甜味一路走，就到这里了哦。",
            "nextDialogs": [
              "400800404"
            ]
          },
          "400800404": {
            "id": "400800404",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "对的，果子好甜，可莉也闻得到！",
            "nextDialogs": [
              "400800405"
            ]
          },
          "400800405": {
            "id": "400800405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的原因吧？",
            "nextDialogs": [
              "400800406"
            ]
          },
          "400800406": {
            "id": "400800406",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯，因为我想起了一件重要的事。在你们封上木桶、把酒埋进泥土之前，还需要再做一件事。",
            "nextDialogs": [
              "400800407"
            ]
          },
          "400800407": {
            "id": "400800407",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "欸！还缺什么东西吗？",
            "nextDialogs": [
              "400800408"
            ]
          },
          "400800408": {
            "id": "400800408",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "雷泽，还记得那半瓶「千风佳酿」的味道吧？里面是不是有一点苦味？",
            "nextDialogs": [
              "400800409"
            ]
          },
          "400800409": {
            "id": "400800409",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "嗯，有。",
            "nextDialogs": [
              "400800410"
            ]
          },
          "400800410": {
            "id": "400800410",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "啊哈哈，那种苦味大有来头，就是…这个。",
            "nextDialogs": [
              "400800411"
            ]
          },
          "400800411": {
            "id": "400800411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "蒲公英籽？",
            "nextDialogs": [
              "400800412"
            ]
          },
          "400800412": {
            "id": "400800412",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "你们知道蒲公英酒吧。在蒙德人心中，风能够带回灵魂，也可以保存记忆。",
            "nextDialogs": [
              "400800413"
            ]
          },
          "400800413": {
            "id": "400800413",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "蒲公英籽就像自然的宝石，汇聚着每年第一缕风。人们把它放进酒桶，就是把当下的风放了进去。",
            "nextDialogs": [
              "400800414"
            ]
          },
          "400800414": {
            "id": "400800414",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "美酒因而保留下此刻的记忆，直到永远。",
            "nextDialogs": [
              "400800415"
            ]
          },
          "400800415": {
            "id": "400800415",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "所以，「千风佳酿」就是最初的「蒲公英酒」。",
            "nextDialogs": [
              "400800416"
            ]
          },
          "400800416": {
            "id": "400800416",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喔——！",
            "nextDialogs": [
              "400800417"
            ]
          },
          "400800417": {
            "id": "400800417",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "好厉害——我们的事情被酒记下来啦！",
            "nextDialogs": [
              "400800418"
            ]
          },
          "400800418": {
            "id": "400800418",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "至于为什么没有固定的味道嘛，因为放进去的材料完全自由，欸嘿。",
            "nextDialogs": [
              "400800419"
            ]
          },
          "400800419": {
            "id": "400800419",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "唔…",
            "nextDialogs": [
              "400800420"
            ]
          },
          "400800420": {
            "id": "400800420",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "怎么了，雷泽，你在想什么？",
            "nextDialogs": [
              "400800421"
            ]
          },
          "400800421": {
            "id": "400800421",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "爸爸妈妈的酒里，蒲公英籽以外，不知道。",
            "nextDialogs": [
              "400800422"
            ]
          },
          "400800422": {
            "id": "400800422",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "我的酒里，有很多，朋友的情感。",
            "nextDialogs": [
              "400800423"
            ]
          },
          "400800423": {
            "id": "400800423",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "爸爸妈妈，还是不明白。但…有大家。",
            "nextDialogs": [
              "400800424"
            ]
          },
          "400800424": {
            "id": "400800424",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "大家，很努力。",
            "nextDialogs": [
              "400800425"
            ]
          },
          "400800425": {
            "id": "400800425",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "法尔伽，师父，可莉，班尼特，棕色猫叔叔，冷冷的姐姐，装笑的大人…",
            "nextDialogs": [
              "400800426"
            ]
          },
          "400800426": {
            "id": "400800426",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "灰灰硬硬的女孩子，风晶蝶味道的人，猫叔叔的女儿…",
            "nextDialogs": [
              "400800427"
            ]
          },
          "400800427": {
            "id": "400800427",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "#绿诗人，派蒙，{NICKNAME}。",
            "nextDialogs": [
              "400800428"
            ]
          },
          "400800428": {
            "id": "400800428",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "每个人，都记着。",
            "nextDialogs": [
              "400800429"
            ]
          },
          "400800429": {
            "id": "400800429",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "酒，做起来，很难。",
            "nextDialogs": [
              "400800430"
            ]
          },
          "400800430": {
            "id": "400800430",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "没有大家…不会有，今天的酒。",
            "nextDialogs": [
              "400800431"
            ]
          },
          "400800431": {
            "id": "400800431",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "和朋友一起，困难，不是困难。",
            "nextDialogs": [
              "400800432"
            ]
          },
          "400800432": {
            "id": "400800432",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "我…很开心。",
            "nextDialogs": [
              "400800435"
            ]
          },
          "400800435": {
            "id": "400800435",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "嗯，谢谢。",
            "nextDialogs": [
              "400800436"
            ]
          },
          "400800436": {
            "id": "400800436",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "朋友…也是「卢皮卡」。",
            "nextDialogs": [
              "400800437"
            ]
          },
          "400800437": {
            "id": "400800437",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "未来，大家一起。我是人，我是狼…都没有关系。",
            "nextDialogs": [
              "400800438"
            ]
          },
          "400800438": {
            "id": "400800438",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "长大…再一起来开，这桶酒。",
            "nextDialogs": [
              "400800439"
            ]
          },
          "400800439": {
            "id": "400800439",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "精彩的发言。我这个吟游诗人，已经没有什么想补充的呢。",
            "nextDialogs": [
              "400800440"
            ]
          },
          "400800440": {
            "id": "400800440",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "接下来就把酒埋好，慢慢等待它变得甘醇吧。",
            "nextDialogs": [
              "400800441"
            ]
          },
          "400800441": {
            "id": "400800441",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "大家一起把酒桶埋进了土里…",
            "nextDialogs": [
              "400800442"
            ]
          },
          "400800442": {
            "id": "400800442",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "终于完工啦，我也想好好庆祝一下了！",
            "nextDialogs": [
              "400800443"
            ]
          },
          "400800443": {
            "id": "400800443",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没记错的话，明天就是「归风日」对吧？",
            "nextDialogs": [
              "400800444"
            ]
          },
          "400800444": {
            "id": "400800444",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "哇！风神大人要回来啦——",
            "nextDialogs": [
              "400800445"
            ]
          },
          "400800445": {
            "id": "400800445",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "啊哈哈，提醒我了。歌谣还没有背完，我得回去准备举杯仪式。各位朋友，明天再见喽。",
            "nextDialogs": [
              "400800446"
            ]
          },
          "400800446": {
            "id": "400800446",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "今晚好好睡一觉，明天早晨记得迎着清风叫醒你们的耳朵，然后，来听最好的吟游诗人演出。"
          }
        }
      }
    },
    {
      "subId": "4008005",
      "subQuestName": "等到第二天（10-14点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008006",
      "subQuestName": "前往会场参加举杯仪式",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400800601"
        ],
        "dialogs": {
          "400800601": {
            "id": "400800601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好多人啊，大家都来迎接风神了呢。咦，怎么都围在「天使的馈赠」摊位前？",
            "nextDialogs": [
              "400800602"
            ]
          },
          "400800602": {
            "id": "400800602",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "按照惯例，佳酿节上品质最好的酒，要等到举杯仪式献给风神大人品尝过之后才能开售，大家都在排队等着呢。",
            "nextDialogs": [
              "400800603"
            ]
          },
          "400800603": {
            "id": "400800603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，对这些家伙来说，迎接风神只是个过场吧。丽莎小姐，你是来看雷泽的吗？",
            "nextDialogs": [
              "400800604"
            ]
          },
          "400800604": {
            "id": "400800604",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "嗯，之前还有些不放心，刚才和雷泽聊过几句，听说你们的酿酒之旅还算顺利。今天我也能安心喝一杯了。",
            "nextDialogs": [
              "400800605"
            ]
          },
          "400800605": {
            "id": "400800605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…你也…",
            "nextDialogs": [
              "400800606"
            ]
          },
          "400800606": {
            "id": "400800606",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "呵呵，雷泽他们已经在那边了，赶快过去吧。",
            "nextDialogs": [
              "400800607"
            ]
          },
          "400800607": {
            "id": "400800607",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "呦，你们来啦！",
            "nextDialogs": [
              "400800608"
            ]
          },
          "400800608": {
            "id": "400800608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，这么多酒瓶是怎么回事？如果不知道，还以为你们也摆了个卖酒的摊位呢。",
            "nextDialogs": [
              "400800609"
            ]
          },
          "400800609": {
            "id": "400800609",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "哈哈哈，这些都是我们帮雷泽准备的！",
            "nextDialogs": [
              "400800610"
            ]
          },
          "400800610": {
            "id": "400800610",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "妈妈说过，今天大家要迎接风神大人，要请他喝酒。如果风神大人高兴，就会变成风来祝福大家。",
            "nextDialogs": [
              "400800611"
            ]
          },
          "400800611": {
            "id": "400800611",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "#我们想让风神大人高兴，让他帮帮雷泽。荣誉骑士{M#哥哥}{F#姐姐}你看，这是阿贝多哥哥借给我的。",
            "nextDialogs": [
              "400800612"
            ]
          },
          "400800612": {
            "id": "400800612",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "这瓶是我的老爹们给的，还好没在路上摔了…也就装装样子，用完得给他们带回去。",
            "nextDialogs": [
              "400800613"
            ]
          },
          "400800613": {
            "id": "400800613",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "妈妈说，风神大人的酒量特别大，只要他想，一口气能把果酒湖喝干！",
            "nextDialogs": [
              "400800614"
            ]
          },
          "400800614": {
            "id": "400800614",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "这些，再加上雷泽爸爸妈妈留下的酒…够不够呀？",
            "nextDialogs": [
              "400800615"
            ]
          },
          "400800615": {
            "id": "400800615",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "啊，绿诗人。",
            "nextDialogs": [
              "400800616"
            ]
          },
          "400800616": {
            "id": "400800616",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "咳咳，各位，非常荣幸来到这里。今天我受西风骑士团代理团长琴小姐邀请，为大家弹奏一曲——「千风佳酿」。",
            "nextDialogs": [
              "400800617"
            ]
          },
          "400800617": {
            "id": "400800617",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我会把最好的歌谣献给风，也献给在场的你们——",
            "nextDialogs": [
              "400800618"
            ]
          },
          "400800618": {
            "id": "400800618",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "「我们把这些东西封进桶，\\n等啊，等啊，等着风起涌。\\n把佳酿的瓶口先蜡上，\\n南风和煦，北风猛。」",
            "nextDialogs": [
              "400800619"
            ]
          },
          "400800619": {
            "id": "400800619",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "「佳酿味道像什么？\\n蒙德的名字，自由的梦。\\n究竟是什么发酵成佳酿？\\n探索的勇气，慈爱的温柔。」",
            "nextDialogs": [
              "400800620"
            ]
          },
          "400800620": {
            "id": "400800620",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "「守护的执着一如初，\\n伴着千风起祝颂，\\n酸汁变甜，糙桶润透，\\n等啊，等啊，等着风起涌。」",
            "nextDialogs": [
              "400800621"
            ]
          },
          "400800621": {
            "id": "400800621",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "「酒桶里面放了啥？\\n小麦的金黄，潜荟葱茏。\\n佳酿出桶，飘来了什么？\\n风铃的声音，万古的长空。」",
            "nextDialogs": [
              "400800622"
            ]
          },
          "400800622": {
            "id": "400800622",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "「我们伴着这些美酒唱起歌，\\n等啊，等啊，等着风起咏。\\n千风带走了什么下酒？\\n琴弦上的故事，今夜的美梦。」",
            "nextDialogs": [
              "400800623"
            ]
          },
          "400800623": {
            "id": "400800623",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "朋友们，让我们共同开启美酒——",
            "nextDialogs": [
              "400800624"
            ]
          },
          "400800624": {
            "id": "400800624",
            "speakerId": 10266,
            "speakerName": "众人",
            "text": "敬献风神！",
            "nextDialogs": [
              "400800628"
            ]
          },
          "400800628": {
            "id": "400800628",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "敬献风神…",
            "nextDialogs": [
              "400800629"
            ]
          },
          "400800629": {
            "id": "400800629",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "敬献风神。",
            "nextDialogs": [
              "400800630"
            ]
          },
          "400800630": {
            "id": "400800630",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "欸…没有风…",
            "nextDialogs": [
              "400800631"
            ]
          },
          "400800631": {
            "id": "400800631",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "可莉，别难过。",
            "nextDialogs": [
              "400800632"
            ]
          },
          "400800632": {
            "id": "400800632",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "怎么会这样，雷泽，风神大人没有回来，是不是他不喜欢我们准备的酒？",
            "nextDialogs": [
              "400800633"
            ]
          },
          "400800633": {
            "id": "400800633",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应该不是…",
            "nextDialogs": [
              "400800634"
            ]
          },
          "400800634": {
            "id": "400800634",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "才不会呢！小可莉知道吗？风神大人不仅会变成风，也会变成其他样子，所以今年他一定是变成其他样子回来了！",
            "nextDialogs": [
              "400800635"
            ]
          },
          "400800635": {
            "id": "400800635",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "唔？是吗？变成…变成蹦蹦？",
            "nextDialogs": [
              "400800636"
            ]
          },
          "400800636": {
            "id": "400800636",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好，就变成蹦蹦！听见了吗风神！",
            "nextDialogs": [
              "400800637"
            ]
          },
          "400800637": {
            "id": "400800637",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嘿嘿…雷泽，风神大人给你带来祝福了吗？",
            "nextDialogs": [
              "400800638"
            ]
          },
          "400800638": {
            "id": "400800638",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "嗯。",
            "nextDialogs": [
              "400800639"
            ]
          },
          "400800639": {
            "id": "400800639",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "跟你们一起，说很多，学会了很多。",
            "nextDialogs": [
              "400800640"
            ]
          },
          "400800640": {
            "id": "400800640",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "现在，不会害怕。",
            "nextDialogs": [
              "400800641"
            ]
          },
          "400800641": {
            "id": "400800641",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "这个…就是祝福。",
            "nextDialogs": [
              "400800642"
            ]
          },
          "400800642": {
            "id": "400800642",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "别忘了，将来等你的酒酿成之后，我也要来喝一口哦！",
            "nextDialogs": [
              "400800645"
            ]
          },
          "400800645": {
            "id": "400800645",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "嗯，一起分享，一起，回忆。",
            "nextDialogs": [
              "400800646"
            ]
          },
          "400800646": {
            "id": "400800646",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嗯嗯！不过…可莉口渴了…",
            "nextDialogs": [
              "400800647"
            ]
          },
          "400800647": {
            "id": "400800647",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "光顾着说话了，我们去喝饮料吧？",
            "nextDialogs": [
              "400800648"
            ]
          },
          "400800648": {
            "id": "400800648",
            "speakerId": 1024,
            "speakerName": "班尼特",
            "text": "我听说「天使的馈赠」摊位上新开卖的「假日果酿」，可好喝了！",
            "nextDialogs": [
              "400800649"
            ]
          },
          "400800649": {
            "id": "400800649",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "我要喝我要喝！",
            "nextDialogs": [
              "400800650"
            ]
          },
          "400800650": {
            "id": "400800650",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "嗯，大家，我们走吧。"
          }
        }
      }
    },
    {
      "subId": "4008009",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400800901"
        ],
        "dialogs": {
          "400800901": {
            "id": "400800901",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "雷泽刚刚很帅哦！",
            "nextDialogs": [
              "400800902"
            ]
          },
          "400800902": {
            "id": "400800902",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "帅…是什么意思？",
            "nextDialogs": [
              "400800903"
            ]
          },
          "400800903": {
            "id": "400800903",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "就是厉害！",
            "nextDialogs": [
              "400800904"
            ]
          },
          "400800904": {
            "id": "400800904",
            "speakerId": 1011,
            "speakerName": "雷泽",
            "text": "唔…没有。可莉才帅。"
          }
        }
      }
    },
    {
      "subId": "4008050",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400805001"
        ],
        "dialogs": {
          "400805001": {
            "id": "400805001",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "这次的任务，也算顺利完成了吧…",
            "nextDialogs": [
              "400805002"
            ]
          },
          "400805002": {
            "id": "400805002",
            "speakerId": 1027,
            "speakerName": "诺艾尔",
            "text": "啊！砂糖小姐的实验器材！我得去帮忙搬运才行！"
          }
        }
      }
    },
    {
      "subId": "4008099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400809903"
        ],
        "dialogs": {
          "400809903": {
            "id": "400809903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总算等到「归风日」了，我们快出发，不要错过举杯仪式！"
          }
        }
      }
    }
  ]
}
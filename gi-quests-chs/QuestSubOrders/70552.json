    {
      "subId": "7055206",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705520201"
        ],
        "dialogs": {
          "705520201": {
            "id": "705520201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "优菈队长的特调「星月闪亮饮」完成了，请享用！",
            "nextDialogs": [
              "705520202"
            ]
          },
          "705520202": {
            "id": "705520202",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "嗯哼，这个语气，很有自信嘛？那我可要好好品味一番了…",
            "nextDialogs": [
              "705520203"
            ]
          },
          "705520203": {
            "id": "705520203",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "唔？真不错！",
            "nextDialogs": [
              "705520204"
            ]
          },
          "705520204": {
            "id": "705520204",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "又甜又酥麻，空气感很棒，气泡水是点睛之笔…",
            "nextDialogs": [
              "705520205"
            ]
          },
          "705520205": {
            "id": "705520205",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "身体里的活力都被唤醒了，一杯不过瘾…再给我来杯更有力道的，怎么样？",
            "nextDialogs": [
              "705520208"
            ]
          },
          "705520208": {
            "id": "705520208",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "啊哈，可别束手束脚！我的酒量也不至于差到两杯就倒吧？"
          }
        }
      }
    },

    {
      "subId": "7055203",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705520301"
        ],
        "dialogs": {
          "705520301": {
            "id": "705520301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "根据优菈的喜好，全新配方的「浪花剑锋曲」，完成啦！",
            "nextDialogs": [
              "705520302"
            ]
          },
          "705520302": {
            "id": "705520302",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "呀，颜色很漂亮嘛！还加入了刚刚提到的海露花果实汁？",
            "nextDialogs": [
              "705520303"
            ]
          },
          "705520303": {
            "id": "705520303",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "香气也非常到位，既有烈性，又不缺果香…容我品一品。",
            "nextDialogs": [
              "705520304"
            ]
          },
          "705520304": {
            "id": "705520304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等你仔细分析！",
            "nextDialogs": [
              "705520305"
            ]
          },
          "705520305": {
            "id": "705520305",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "呼…哇啊…等我想想夸赞的词，我得好好想想。",
            "nextDialogs": [
              "705520306"
            ]
          },
          "705520306": {
            "id": "705520306",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "虽然淑女不该这样，作为合格的品酒人，也该慢慢喝才对…",
            "nextDialogs": [
              "705520307"
            ]
          },
          "705520307": {
            "id": "705520307",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "但…口感实在太棒了，失礼了！",
            "nextDialogs": [
              "705520308"
            ]
          },
          "705520308": {
            "id": "705520308",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "能再来一杯吗？",
            "nextDialogs": [
              "705520311"
            ]
          },
          "705520311": {
            "id": "705520311",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "于是优菈开始尽情享用你的全新特调「浪花剑锋曲」，闲聊之余，不知不觉就喝掉了三杯…",
            "nextDialogs": [
              "705520312"
            ]
          },
          "705520312": {
            "id": "705520312",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "完了，刚刚要怎么夸来着…忘词了…",
            "nextDialogs": [
              "705520313"
            ]
          },
          "705520313": {
            "id": "705520313",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "#总之，我现在状态大好！{NICKNAME}的特调…是最棒的佳酿！",
            "nextDialogs": [
              "705520314"
            ]
          },
          "705520314": {
            "id": "705520314",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "现在我就回家，美美地睡一觉！"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7055201",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705520101"
        ],
        "dialogs": {
          "705520101": {
            "id": "705520101",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "#嗯？现在居然是{NICKNAME}在管理饮品小站…早知如此，我上午就过来了！",
            "nextDialogs": [
              "705520104"
            ]
          },
          "705520104": {
            "id": "705520104",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "#说实话，我已经开始好奇了——早就听说{NICKNAME}有着顶级的调饮才华。",
            "nextDialogs": [
              "705520105"
            ]
          },
          "705520105": {
            "id": "705520105",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "你能用格兰菲狄准备的材料，调出什么样的饮品？"
          }
        }
      }
    },
    {
      "subId": "7055202",

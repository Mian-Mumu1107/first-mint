    {
      "subId": "1001007",
      "subQuestName": "守护嘟嘟可的宝藏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1001008",
      "subQuestName": "与可莉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100100801"
        ],
        "dialogs": {
          "100100801": {
            "id": "100100801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "终于把那些家伙赶跑了…",
            "nextDialogs": [
              "100100802"
            ]
          },
          "100100802": {
            "id": "100100802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "仔细一想，之前的纸条上写的「事情不会如此简单」…其实就是指会有魔物跑过来吧。",
            "nextDialogs": [
              "100100803"
            ]
          },
          "100100803": {
            "id": "100100803",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "嗯！嘟嘟可试炼大成功！",
            "nextDialogs": [
              "100100804"
            ]
          },
          "100100804": {
            "id": "100100804",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，那现在试炼结束了，我们看看箱子里的是什么…",
            "nextDialogs": [
              "100100805"
            ]
          },
          "100100805": {
            "id": "100100805",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "啊，这个是…",
            "nextDialogs": [
              "100100806"
            ]
          },
          "100100806": {
            "id": "100100806",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是一顶小小的帽子？",
            "nextDialogs": [
              "100100807"
            ]
          },
          "100100807": {
            "id": "100100807",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "是给嘟嘟可的帽子！",
            "nextDialogs": [
              "100100808"
            ]
          },
          "100100808": {
            "id": "100100808",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "在嘟嘟一族之中，只有更加特别，更加了不起的嘟嘟可，才能被「嘟嘟大魔王」承认！",
            "nextDialogs": [
              "100100809"
            ]
          },
          "100100809": {
            "id": "100100809",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "这些了不起的嘟嘟可肩负着帮助和保护别的嘟嘟可的职责，所以「嘟嘟大魔王」赐予他们特殊的帽子。",
            "nextDialogs": [
              "100100810"
            ]
          },
          "100100810": {
            "id": "100100810",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "这样，别的嘟嘟可就能认出他们，然后遇到没办法解决的困难，就找到他们寻求帮助。",
            "nextDialogs": [
              "100100811"
            ]
          },
          "100100811": {
            "id": "100100811",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦，那嘟嘟可就会变成戴帽子的嘟嘟可啦！",
            "nextDialogs": [
              "100100812"
            ]
          },
          "100100812": {
            "id": "100100812",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "嗯！成为戴帽子的嘟嘟可就是「嘟嘟大魔法师」…就能用大魔法师的火花力量帮助更多的人了！",
            "nextDialogs": [
              "100100813"
            ]
          },
          "100100813": {
            "id": "100100813",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "可莉——",
            "nextDialogs": [
              "100100814"
            ]
          },
          "100100814": {
            "id": "100100814",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "骑士团的人说，城外的森林里又传来了特别大的爆炸声…",
            "nextDialogs": [
              "100100815"
            ]
          },
          "100100815": {
            "id": "100100815",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "#荣誉骑士{M#哥哥}{F#姐姐}，小派蒙，现在是可莉需要帮助…",
            "nextDialogs": [
              "100100816"
            ]
          },
          "100100816": {
            "id": "100100816",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，我可以作证，我们和可莉一起清除了聚集的丘丘人，还有史莱姆，而且我们是为了完成「课题」才来的。",
            "nextDialogs": [
              "100100817"
            ]
          },
          "100100817": {
            "id": "100100817",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "小派蒙说得一点没错。",
            "nextDialogs": [
              "100100818"
            ]
          },
          "100100818": {
            "id": "100100818",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "那这里的鱼…",
            "nextDialogs": [
              "100100819"
            ]
          },
          "100100819": {
            "id": "100100819",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "那是刚才对付湖上的坏家伙的时候，可莉不小心炸到的…跟以前可不一样…",
            "nextDialogs": [
              "100100820"
            ]
          },
          "100100820": {
            "id": "100100820",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "也就是说，以前都是故意炸的？",
            "nextDialogs": [
              "100100821"
            ]
          },
          "100100821": {
            "id": "100100821",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "可莉因为以前炸的鱼无话可说。",
            "nextDialogs": [
              "100100822"
            ]
          },
          "100100822": {
            "id": "100100822",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "…唉，我来的路上已经看到了，被摧毁的魔物营地，以及刚才从星落湖边上跑走的魔物。",
            "nextDialogs": [
              "100100823"
            ]
          },
          "100100823": {
            "id": "100100823",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "#没有造成其他的破坏吧，{NICKNAME}？",
            "nextDialogs": [
              "100100825"
            ]
          },
          "100100825": {
            "id": "100100825",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…对对，都是我一口气吹出来的，我了不起。",
            "nextDialogs": [
              "100100827"
            ]
          },
          "100100827": {
            "id": "100100827",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "可莉。",
            "nextDialogs": [
              "100100828"
            ]
          },
          "100100828": {
            "id": "100100828",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "走吧，我们回去。",
            "nextDialogs": [
              "100100829"
            ]
          },
          "100100829": {
            "id": "100100829",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "呜，又要进禁闭室了嘛？",
            "nextDialogs": [
              "100100830"
            ]
          },
          "100100830": {
            "id": "100100830",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "#这次因为有{NICKNAME}为你作担保，所以就罚你…跟我去猎鹿人好好吃一顿吧！",
            "nextDialogs": [
              "100100831"
            ]
          },
          "100100831": {
            "id": "100100831",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "跑出来折腾那么久，应该也饿了吧。",
            "nextDialogs": [
              "100100832"
            ]
          },
          "100100832": {
            "id": "100100832",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "今天是好人琴团长！",
            "nextDialogs": [
              "100100833"
            ]
          },
          "100100833": {
            "id": "100100833",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "#{NICKNAME}和派蒙也一起来吧。",
            "nextDialogs": [
              "100100834"
            ]
          },
          "100100834": {
            "id": "100100834",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，那我要吃甜甜花酿鸡。",
            "nextDialogs": [
              "100100835"
            ]
          },
          "100100835": {
            "id": "100100835",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "今天琴请客，你、派蒙和可莉在猎鹿人餐厅好好吃了一顿…\\n啊，对了，还有成为了「嘟嘟大魔法师」的嘟嘟可。\\n这就是嘟嘟可试炼的最后结局了。"
          }
        }
      }
    }
  ]
}
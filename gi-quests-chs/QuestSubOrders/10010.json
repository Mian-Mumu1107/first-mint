  },
  "subQuests": [
    {
      "subId": "1001001",
      "subQuestName": "前往西风骑士团总部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100100101"
        ],
        "dialogs": {
          "100100101": {
            "id": "100100101",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "嗯…嘟嘟可…",
            "nextDialogs": [
              "100100102"
            ]
          },
          "100100102": {
            "id": "100100102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀，可莉！",
            "nextDialogs": [
              "100100103"
            ]
          },
          "100100103": {
            "id": "100100103",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "#荣誉骑士{M#哥哥}{F#姐姐}！小派蒙！",
            "nextDialogs": [
              "100100104"
            ]
          },
          "100100104": {
            "id": "100100104",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "#妈妈说，荣誉骑士{M#哥哥}{F#姐姐}和小派蒙，会和可莉一起帮助嘟嘟可，没想到这么快就来了！",
            "nextDialogs": [
              "100100105"
            ]
          },
          "100100105": {
            "id": "100100105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "帮助嘟嘟可？",
            "nextDialogs": [
              "100100106"
            ]
          },
          "100100106": {
            "id": "100100106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…咦，「课题」，是这个吗？",
            "nextDialogs": [
              "100100107"
            ]
          },
          "100100107": {
            "id": "100100107",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "可莉不知道…但是可莉是可莉，不是可提？",
            "nextDialogs": [
              "100100108"
            ]
          },
          "100100108": {
            "id": "100100108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，我没有念错可莉的名字啦，可莉是可莉，课题是…",
            "nextDialogs": [
              "100100110",
              "100100114"
            ]
          },
          "100100110": {
            "id": "100100110",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "？",
            "nextDialogs": [
              "100100111"
            ]
          },
          "100100111": {
            "id": "100100111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…唉，谢谢你没什么用的说明啦。",
            "nextDialogs": [
              "100100112"
            ]
          },
          "100100112": {
            "id": "100100112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯…课题就是，唔，好难直接解释哦。总之，课题就是，可莉想要做的，要帮助嘟嘟可完成的事！",
            "nextDialogs": [
              "100100119"
            ]
          },
          "100100119": {
            "id": "100100119",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "哦！谢谢小派蒙，可莉虽然不明白，但好像又有点明白了。",
            "nextDialogs": [
              "100100120"
            ]
          },
          "100100120": {
            "id": "100100120",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "那么我们这就出发吧，去帮助嘟嘟可…",
            "nextDialogs": [
              "100100121"
            ]
          },
          "100100121": {
            "id": "100100121",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，所以可莉呀，你说要帮助嘟嘟可，具体是要做什么？",
            "nextDialogs": [
              "100100122"
            ]
          },
          "100100122": {
            "id": "100100122",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "嗯，每一个嘟嘟可都要找到红色的四叶草，这样才能变成与众不同的嘟嘟可。",
            "nextDialogs": [
              "100100123"
            ]
          },
          "100100123": {
            "id": "100100123",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "然后，然后嘟嘟可要与很多人成为朋友，经历「嘟嘟大魔王」的试炼，才能成为了不起的——",
            "nextDialogs": [
              "100100124"
            ]
          },
          "100100124": {
            "id": "100100124",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "「嘟嘟大魔法师」！",
            "nextDialogs": [
              "100100125"
            ]
          },
          "100100125": {
            "id": "100100125",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "…至少妈妈是这样说的。",
            "nextDialogs": [
              "100100126"
            ]
          },
          "100100126": {
            "id": "100100126",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，「大魔王」管着「大魔法师」…听上去还挺合理的。",
            "nextDialogs": [
              "100100127"
            ]
          },
          "100100127": {
            "id": "100100127",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那么我们具体要做什么呢？",
            "nextDialogs": [
              "100100128"
            ]
          },
          "100100128": {
            "id": "100100128",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "可莉不知道。",
            "nextDialogs": [
              "100100129"
            ]
          },
          "100100129": {
            "id": "100100129",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "#但是妈妈说，荣誉骑士{M#哥哥}{F#姐姐}和小派蒙会告诉可莉。",
            "nextDialogs": [
              "100100130"
            ]
          },
          "100100130": {
            "id": "100100130",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对、对哦，可莉，看看这本书…",
            "nextDialogs": [
              "100100131"
            ]
          },
          "100100131": {
            "id": "100100131",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "啊，里面夹着一张纸条。",
            "nextDialogs": [
              "100100132"
            ]
          },
          "100100132": {
            "id": "100100132",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那就让我们一起来看看吧…",
            "nextDialogs": [
              "100100133"
            ]
          },
          "100100133": {
            "id": "100100133",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「…试炼的第一站，嘟嘟可来到了树叶呢喃的森林，在那里，要找到埋藏的秘密，在重重的障碍之下…」",
            "nextDialogs": [
              "100100134"
            ]
          },
          "100100134": {
            "id": "100100134",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听上去像是什么嘟嘟可故事的一部分呢…",
            "nextDialogs": [
              "100100135"
            ]
          },
          "100100135": {
            "id": "100100135",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "啊，可莉知道在哪里了，一定是在可莉经常炸…经常与嘟嘟可玩耍的森林里！",
            "nextDialogs": [
              "100100136"
            ]
          },
          "100100136": {
            "id": "100100136",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "#可莉，嘟嘟可，荣誉骑士{M#哥哥}{F#姐姐}，小派蒙，出发！",
            "nextDialogs": [
              "100100137"
            ]
          },
          "100100137": {
            "id": "100100137",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好哦！出发！"
          },
          "100100114": {
            "id": "100100114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对，就是要完成的事。",
            "nextDialogs": [
              "100100115"
            ]
          },
          "100100115": {
            "id": "100100115",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "哦，那…可莉用蹦蹦炸弹炸鱼也是「课题」？",
            "nextDialogs": [
              "100100116"
            ]
          },
          "100100116": {
            "id": "100100116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不，那应该不是吧，也不是所有的事都能被称之为「课题」啦！",
            "nextDialogs": [
              "100100117"
            ]
          },
          "100100117": {
            "id": "100100117",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "可莉有点弄不明白了…",
            "nextDialogs": [
              "100100118"
            ]
          },
          "100100118": {
            "id": "100100118",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，总之就是艾莉丝说的，要让可莉完成的事，就是「课题」！"
          }
        }
      }
    },
    {
      "subId": "1001003",
      "subQuestName": "前往低语森林",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100100301"
        ],
        "dialogs": {
          "100100301": {
            "id": "100100301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里、怎么，怎么有这么多奇怪的东西…还有好多丘丘人…",
            "nextDialogs": [
              "100100302"
            ]
          },
          "100100302": {
            "id": "100100302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不如说，感觉就是丘丘人把这些奇怪的东西搬到这儿来的。",
            "nextDialogs": [
              "100100303"
            ]
          },
          "100100303": {
            "id": "100100303",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "唔，原来这就是试炼里的「丛丛障碍」！",
            "nextDialogs": [
              "100100304"
            ]
          },
          "100100304": {
            "id": "100100304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然读得很相近，但其实是「重重障碍」啦。",
            "nextDialogs": [
              "100100305"
            ]
          },
          "100100305": {
            "id": "100100305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，按照纸条的提示，我们要找的东西应该在这些「重重障碍」下面…有什么别的提示吗…",
            "nextDialogs": [
              "100100306"
            ]
          },
          "100100306": {
            "id": "100100306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个时候难道没有什么「嘟嘟可的指引」之类的东西？",
            "nextDialogs": [
              "100100307"
            ]
          },
          "100100307": {
            "id": "100100307",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "没有哦？",
            "nextDialogs": [
              "100100308"
            ]
          },
          "100100308": {
            "id": "100100308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊…那要怎么办？",
            "nextDialogs": [
              "100100309"
            ]
          },
          "100100309": {
            "id": "100100309",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "嗯…妈妈曾经说过，遇到困难就要解决困难！",
            "nextDialogs": [
              "100100310"
            ]
          },
          "100100310": {
            "id": "100100310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就让「重重障碍」消失吧。",
            "nextDialogs": [
              "100100311"
            ]
          },
          "100100311": {
            "id": "100100311",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "嗯！"
          }
        }
      }
    },
    {
      "subId": "1001002",

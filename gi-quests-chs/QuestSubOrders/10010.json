    {
      "subId": "1001004",
      "subQuestName": "清理掉「丛丛障碍」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1001005",
      "subQuestName": "与可莉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100100501"
        ],
        "dialogs": {
          "100100501": {
            "id": "100100501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好耶，全都清理掉了，不管是障碍还是丘丘人…",
            "nextDialogs": [
              "100100502"
            ]
          },
          "100100502": {
            "id": "100100502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且也没有引发大火什么的。",
            "nextDialogs": [
              "100100503"
            ]
          },
          "100100503": {
            "id": "100100503",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "可莉有好好控制蹦蹦炸弹！",
            "nextDialogs": [
              "100100504"
            ]
          },
          "100100504": {
            "id": "100100504",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "现在可莉进禁闭室的次数，已经越来越少啦！",
            "nextDialogs": [
              "100100505"
            ]
          },
          "100100505": {
            "id": "100100505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可莉，了不起。",
            "nextDialogs": [
              "100100506"
            ]
          },
          "100100506": {
            "id": "100100506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但是什么时候可莉能够不进禁闭室呢…",
            "nextDialogs": [
              "100100507"
            ]
          },
          "100100507": {
            "id": "100100507",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "要是琴团长同意可莉炸掉禁闭室的话…",
            "nextDialogs": [
              "100100508"
            ]
          },
          "100100508": {
            "id": "100100508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不是在说用这种方法实现啦！啊对了，嘟嘟可的试炼呢？",
            "nextDialogs": [
              "100100509"
            ]
          },
          "100100509": {
            "id": "100100509",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "啊，可莉拿到了，就在刚才蹦蹦炸弹炸出的土坑里…",
            "nextDialogs": [
              "100100510"
            ]
          },
          "100100510": {
            "id": "100100510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是新的纸条呢。",
            "nextDialogs": [
              "100100511"
            ]
          },
          "100100511": {
            "id": "100100511",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "嗯，上面的是妈妈写的字…",
            "nextDialogs": [
              "100100512"
            ]
          },
          "100100512": {
            "id": "100100512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「嘟嘟可有没有把所有的障碍炸飞呢，有的时候直接才是最具有美学的做法呢。然后，嘟嘟可到了试炼的第二站…」",
            "nextDialogs": [
              "100100513"
            ]
          },
          "100100513": {
            "id": "100100513",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「其实也就是最后一站，即使是再有活力的孩子，也要好好控制每日活动的时间，那么…」",
            "nextDialogs": [
              "100100514"
            ]
          },
          "100100514": {
            "id": "100100514",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「在星星坠入的湖水之畔，嘟嘟可经过了试炼，得到了最终的褒奖，但是事情真的会如此简单吗…」",
            "nextDialogs": [
              "100100515"
            ]
          },
          "100100515": {
            "id": "100100515",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起星星和湖的话，那就是星落湖了吧。",
            "nextDialogs": [
              "100100516"
            ]
          },
          "100100516": {
            "id": "100100516",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我们就去湖边看看吧…",
            "nextDialogs": [
              "100100517"
            ]
          },
          "100100517": {
            "id": "100100517",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "好！",
            "nextDialogs": [
              "100100518"
            ]
          },
          "100100518": {
            "id": "100100518",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真好奇这个最终的褒奖是什么，说不定是了不起的宝藏呢！"
          }
        }
      }
    },
    {
      "subId": "1001006",
      "subQuestName": "前往星落湖",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100100601"
        ],
        "dialogs": {
          "100100601": {
            "id": "100100601",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "啊，是一个了不起的箱子。",
            "nextDialogs": [
              "100100602"
            ]
          },
          "100100602": {
            "id": "100100602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来最终的宝藏就藏在这个了不起的箱子里…",
            "nextDialogs": [
              "100100603"
            ]
          },
          "100100603": {
            "id": "100100603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可莉，打开箱子吧…",
            "nextDialogs": [
              "100100604"
            ]
          },
          "100100604": {
            "id": "100100604",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "嗯嗯，可莉就和嘟嘟可一起…",
            "nextDialogs": [
              "100100605"
            ]
          },
          "100100605": {
            "id": "100100605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，等等，周围怎么突然聚集了一堆怪物。",
            "nextDialogs": [
              "100100606"
            ]
          },
          "100100606": {
            "id": "100100606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来并没有那么简单呢…",
            "nextDialogs": [
              "100100607"
            ]
          },
          "100100607": {
            "id": "100100607",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "哼哼，肯定是看到嘟嘟可找到了通过试炼得到的宝藏，那些坏家伙要来抢！",
            "nextDialogs": [
              "100100608"
            ]
          },
          "100100608": {
            "id": "100100608",
            "speakerId": 1000,
            "speakerName": "可莉",
            "text": "那我们就先把那些坏家伙赶跑，再打开箱子吧！"
          }
        }
      }
    },
    {
      "subId": "1001009",
      "subQuestName": "前往星落湖",
      "sceneId": null,
      "locations": [],
      "dialogue": {

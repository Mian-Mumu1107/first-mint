  "subQuests": [
    {
      "subId": "1050101",
      "subQuestName": "向蒙德进发，前往望舒客栈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105010101"
        ],
        "dialogs": {
          "105010101": {
            "id": "105010101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "既然是莫娜请客，我们想点什么都可以吧？",
            "nextDialogs": [
              "105010102"
            ]
          },
          "105010102": {
            "id": "105010102",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "当然，师父是很大方的。不过前提是你们吃得完，浪费食物可不好。"
          }
        }
      }
    },
    {
      "subId": "1050113",
      "subQuestName": "在桌边坐下，接受莫娜的宴请",
      "sceneId": null,
      "locations": [],

        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1050102",
      "subQuestName": "与莫娜交谈，享用美食",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105011201"
        ],
        "dialogs": {
          "105011201": {
            "id": "105011201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就都点吧。",
            "nextDialogs": [
              "105011202"
            ]
          },
          "105011202": {
            "id": "105011202",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "都、都点？！我们只有三…不对，两个半人？太多了吧！",
            "nextDialogs": [
              "105011203"
            ]
          },
          "105011203": {
            "id": "105011203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "派蒙不是这样计数的！而且我想吃的都还没点呢！",
            "nextDialogs": [
              "105011204"
            ]
          },
          "105011204": {
            "id": "105011204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「松鼠鱼」，「香嫩椒椒鸡」，还有「珍珠翡翠白玉汤」！",
            "nextDialogs": [
              "105011205"
            ]
          },
          "105011205": {
            "id": "105011205",
            "speakerId": 1002,
            "speakerName": "毓华",
            "text": "好的，那这边这位客人还需要点什么呢？",
            "nextDialogs": [
              "105011206"
            ]
          },
          "105011206": {
            "id": "105011206",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "我，我想随便问一下，现在点的菜，一共大概多少摩拉？",
            "nextDialogs": [
              "105011207"
            ]
          },
          "105011207": {
            "id": "105011207",
            "speakerId": 1002,
            "speakerName": "毓华",
            "text": "唔，两万摩拉的样子吧。",
            "nextDialogs": [
              "105011208"
            ]
          },
          "105011208": {
            "id": "105011208",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "那不就…呃——我、我只要一碗素面就好了。",
            "nextDialogs": [
              "105011209"
            ]
          },
          "105011209": {
            "id": "105011209",
            "speakerId": 1002,
            "speakerName": "毓华",
            "text": "好的，一碗素面是吧。请你们稍坐片刻，马上为你们上菜。",
            "nextDialogs": [
              "105011210"
            ]
          },
          "105011210": {
            "id": "105011210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "其实我吃饭的时候就很奇怪…",
            "nextDialogs": [
              "105011211"
            ]
          },
          "105011211": {
            "id": "105011211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她为什么只点了一份素面啊？",
            "nextDialogs": [
              "105011212"
            ]
          },
          "105011212": {
            "id": "105011212",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是因为…她其实很缺钱吗？",
            "nextDialogs": [
              "105011213"
            ]
          },
          "105011213": {
            "id": "105011213",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "我都听到了！说了是我请客，怎么可能是因为摩拉这么俗气的理由！",
            "nextDialogs": [
              "105011214"
            ]
          },
          "105011214": {
            "id": "105011214",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "占星术士要专注于研究星空，若是被世间凡庸之物扰了心神，就会影响判断。",
            "nextDialogs": [
              "105011215"
            ]
          },
          "105011215": {
            "id": "105011215",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "尤其是用摩拉去过度满足生理欲望，是低俗…",
            "nextDialogs": [
              "105011216"
            ]
          },
          "105011216": {
            "id": "105011216",
            "speakerId": 1003,
            "speakerName": "？？？",
            "text": "咕咕咕——",
            "nextDialogs": [
              "105011217"
            ]
          },
          "105011217": {
            "id": "105011217",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "…又危险的。",
            "nextDialogs": [
              "105011218"
            ]
          },
          "105011218": {
            "id": "105011218",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "所以不吃我们点的菜，这也是占星术士的尊严吗？真的好难懂。",
            "nextDialogs": [
              "105011219"
            ]
          },
          "105011219": {
            "id": "105011219",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但只有我们大吃大喝了一顿，会不会不太好？",
            "nextDialogs": [
              "105011220"
            ]
          },
          "105011220": {
            "id": "105011220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我来露一手吧。",
            "nextDialogs": [
              "105011221"
            ]
          },
          "105011221": {
            "id": "105011221",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦，对啊，还可以这样！你等我们一下！"
          }
        }
      }
    },
    {
      "subId": "1050114",
      "subQuestName": "(test)上菜$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105011401"
        ],
        "dialogs": {
          "105011401": {
            "id": "105011401",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "不用为我费工夫，我一点都不馋…",
            "nextDialogs": [
              "105011402"
            ]
          },
          "105011402": {
            "id": "105011402",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "虽然还是有点饿，但…也没什么大不了的。"
          }
        }
      }
    },
    {
      "subId": "1050103",
      "subQuestName": "找掌柜借用厨房，为莫娜加菜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105010201"
        ],
        "dialogs": {
          "105010201": {
            "id": "105010201",
            "speakerId": 1004,
            "speakerName": "淮安",
            "text": "您好，请问有什么事吗？",
            "nextDialogs": [
              "105010202"
            ]
          },
          "105010202": {
            "id": "105010202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们想借这里的厨房用一下。",
            "nextDialogs": [
              "105010205"
            ]
          },
          "105010205": {
            "id": "105010205",
            "speakerId": 1004,
            "speakerName": "淮安",
            "text": "原来如此，那当然可以。只要自备食材，厨房就请尽管借用吧。",
            "nextDialogs": [
              "105010206"
            ]
          },
          "105010206": {
            "id": "105010206",
            "speakerId": 1004,
            "speakerName": "淮安",
            "text": "不过我想多一句嘴，这位客人，想必烹饪技术很精湛吧？"
          }
        }
      }
    },
    {
      "subId": "1050104",
      "subQuestName": "烹制「黄金蟹」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105010401"
        ],
        "dialogs": {
          "105010401": {
            "id": "105010401",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "终于到蒙德了，唉，好累啊。",
            "nextDialogs": [
              "105010402"
            ]
          },
          "105010402": {
            "id": "105010402",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "想得到伟大而深奥的知识，果然不容易…",
            "nextDialogs": [
              "105010403"
            ]
          },
          "105010403": {
            "id": "105010403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我倒是没那么累。",
            "nextDialogs": [
              "105010404"
            ]
          },
          "105010404": {
            "id": "105010404",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "因为你是飘在天上的啊。",
            "nextDialogs": [
              "105010405"
            ]
          },
          "105010405": {
            "id": "105010405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唉，看来占星术士也没那么厉害。",
            "nextDialogs": [
              "105010406"
            ]
          },
          "105010406": {
            "id": "105010406",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "那是因为你对占星术有太多不切实际的幻想了吧。",
            "nextDialogs": [
              "105010407"
            ]
          },
          "105010407": {
            "id": "105010407",
            "speakerId": 1005,
            "speakerName": "泰勒",
            "text": "你们几位，也是在这里歇脚么？",
            "nextDialogs": [
              "105010408"
            ]
          },
          "105010408": {
            "id": "105010408",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "请问你是？",
            "nextDialogs": [
              "105010409"
            ]
          },
          "105010409": {
            "id": "105010409",
            "speakerId": 1005,
            "speakerName": "泰勒",
            "text": "哦，我们几兄弟都是商人，刚在璃月港做完生意，准备回蒙德。",
            "nextDialogs": [
              "105010410"
            ]
          },
          "105010410": {
            "id": "105010410",
            "speakerId": 1005,
            "speakerName": "泰勒",
            "text": "看你们好像挺累的样子，我们订的马车一会儿就来了，要不要一起走？",
            "nextDialogs": [
              "105010412",
              "105010414"
            ]
          },
          "105010412": {
            "id": "105010412",
            "speakerId": 1005,
            "speakerName": "泰勒",
            "text": "哈哈，那就一起走吧，路上多几个伴聊聊天。",
            "nextDialogs": [
              "105010415"
            ]
          },
          "105010415": {
            "id": "105010415",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "没这个需要，快闪开快闪开。",
            "nextDialogs": [
              "105010416"
            ]
          },
          "105010416": {
            "id": "105010416",
            "speakerId": 1005,
            "speakerName": "泰勒",
            "text": "欸？这位小姐…有什么不方便吗？",
            "nextDialogs": [
              "105010417"
            ]
          },
          "105010417": {
            "id": "105010417",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "别装模作样了，强盗先生。",
            "nextDialogs": [
              "105010418"
            ]
          },
          "105010418": {
            "id": "105010418",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "挑路上看起来好欺负的人下手，只要对方上了车，就会把车拉到荒郊野岭，洗劫一通，对吧。",
            "nextDialogs": [
              "105010419"
            ]
          },
          "105010419": {
            "id": "105010419",
            "speakerId": 1005,
            "speakerName": "泰勒",
            "text": "你、你在说什么？！咱们好心来搭话，却被当驴肝肺，还血口喷人！",
            "nextDialogs": [
              "105010420"
            ]
          },
          "105010420": {
            "id": "105010420",
            "speakerId": 1005,
            "speakerName": "泰勒",
            "text": "不坐车就不坐，神经病。",
            "nextDialogs": [
              "105010421"
            ]
          },
          "105010421": {
            "id": "105010421",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "那，要不要我现在说说你们身上，有哪些东西是抢来的？",
            "nextDialogs": [
              "105010422"
            ]
          },
          "105010422": {
            "id": "105010422",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "不服气的话，我说完之后，找人来对质一番，就什么都明白了。",
            "nextDialogs": [
              "105010423"
            ]
          },
          "105010423": {
            "id": "105010423",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "如果我输了，我愿意赔你两万摩拉。如果我赢了，那你们就得去璃月港吃牢饭。",
            "nextDialogs": [
              "105010424"
            ]
          },
          "105010424": {
            "id": "105010424",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "怎么样，要真是正经做生意的人，没什么不敢的吧？",
            "nextDialogs": [
              "105010425"
            ]
          },
          "105010425": {
            "id": "105010425",
            "speakerId": 1005,
            "speakerName": "泰勒",
            "text": "你、你…！",
            "nextDialogs": [
              "105010426"
            ]
          },
          "105010426": {
            "id": "105010426",
            "speakerId": 1005,
            "speakerName": "泰勒",
            "text": "你真是把我惹毛了！小丫头！",
            "nextDialogs": [
              "105010427"
            ]
          },
          "105010427": {
            "id": "105010427",
            "speakerId": 1005,
            "speakerName": "泰勒",
            "text": "我不知道你是怎么知道的，但只要灭了你的口，就不会有人知道了！"
          },
          "105010414": {
            "id": "105010414",
            "speakerId": 1005,
            "speakerName": "泰勒",
            "text": "不用啦不用啦，反正是顺路的。"
          }
        }
      }
    },
    {
      "subId": "1050110",
      "subQuestName": "(test)交付黄金蟹$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105011001"
        ],
        "dialogs": {
          "105011001": {
            "id": "105011001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这个「蟹黄豆腐」…",
            "nextDialogs": [
              "105011002"
            ]
          },
          "105011002": {
            "id": "105011002",
            "speakerId": 1002,
            "speakerName": "毓华",
            "text": "虽然豆腐这种食材普普通通，但和蟹黄简直是天造地设的一对，是我们的招牌菜之一呢。"
          }
        }
      }
    },
    {
      "subId": "1050111",
      "subQuestName": "(test)交付之后对话A$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105011501"
        ],
        "dialogs": {
          "105011501": {
            "id": "105011501",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "这、这个香味是…",
            "nextDialogs": [
              "105011503",
              "105011505"
            ]
          },
          "105011503": {
            "id": "105011503",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "没想到会这么豪华…",
            "nextDialogs": [
              "105011506"
            ]
          },
          "105011506": {
            "id": "105011506",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "好吧。看在弟子这么辛苦，也花了心思的份上，我就勉为其难地接受吧。",
            "nextDialogs": [
              "105011507"
            ]
          },
          "105011507": {
            "id": "105011507",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "…唔唔！好棒的味道！这是我最近吃过最好吃的菜了！",
            "nextDialogs": [
              "105011508"
            ]
          },
          "105011508": {
            "id": "105011508",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "啊，那个，我是说…咳咳，没想到徒弟如此擅长烹饪，为师很是欣慰。"
          },
          "105011505": {
            "id": "105011505",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "就，就算你这么说…！"
          }
        }
      }
    },

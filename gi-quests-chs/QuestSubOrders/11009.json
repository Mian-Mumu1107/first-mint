  "subQuests": [
    {
      "subId": "1100901",
      "subQuestName": "前往玉京台听凝光演讲",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110090101"
        ],
        "dialogs": {
          "110090101": {
            "id": "110090101",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "今天召集诸位，是想宣布一件重要的事情。",
            "nextDialogs": [
              "110090102"
            ]
          },
          "110090102": {
            "id": "110090102",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "或许有人已听到过风声，最近我确实打算重修群玉阁。",
            "nextDialogs": [
              "110090103"
            ]
          },
          "110090103": {
            "id": "110090103",
            "speakerId": 12341,
            "speakerName": "宏飞",
            "text": "重修群玉阁？这可是个大工程…",
            "nextDialogs": [
              "110090104"
            ]
          },
          "110090104": {
            "id": "110090104",
            "speakerId": 12342,
            "speakerName": "昌贵",
            "text": "坊间传闻确有其事啊，难怪前段时间建材价格飞涨…",
            "nextDialogs": [
              "110090105"
            ]
          },
          "110090105": {
            "id": "110090105",
            "speakerId": 12343,
            "speakerName": "志成",
            "text": "群玉阁对凝光大人意义非凡，如果能搭上这条线…",
            "nextDialogs": [
              "110090106"
            ]
          },
          "110090106": {
            "id": "110090106",
            "speakerId": 12341,
            "speakerName": "宏飞",
            "text": "凝光大人，有什么需要我们帮忙的吗？",
            "nextDialogs": [
              "110090107"
            ]
          },
          "110090107": {
            "id": "110090107",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "不必心急。前些日子消息传开后，有不少人通过各种渠道联系我，想要加入到这个工程中。",
            "nextDialogs": [
              "110090108"
            ]
          },
          "110090108": {
            "id": "110090108",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "眼下我手里确实有几件事，想委托给诸位。",
            "nextDialogs": [
              "110090109"
            ]
          },
          "110090109": {
            "id": "110090109",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "如今工程已经完成选址，各式建材准备妥当，但尚有三件至关重要的物品没有着落。",
            "nextDialogs": [
              "110090110"
            ]
          },
          "110090110": {
            "id": "110090110",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "这三件物品，分别是「鸣霞浮生石」、「千奇核心」以及「仙家符箓」。",
            "nextDialogs": [
              "110090111"
            ]
          },
          "110090111": {
            "id": "110090111",
            "speakerId": 12342,
            "speakerName": "昌贵",
            "text": "这…恕我冒昧，除了浮生石外，后面两样我从未听说过…",
            "nextDialogs": [
              "110090112"
            ]
          },
          "110090112": {
            "id": "110090112",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "规格够大的浮生石，才能冠以「鸣霞」之称，这是保证群玉阁能够升空的基础。千奇核心，则是群玉阁内机械结构的核心。",
            "nextDialogs": [
              "110090113"
            ]
          },
          "110090113": {
            "id": "110090113",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "至于仙家符箓，它的效用是将机械装置与仙家术法有效结合，同样不可或缺。",
            "nextDialogs": [
              "110090114"
            ]
          },
          "110090114": {
            "id": "110090114",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "虽是三样罕见之物，但以诸位的人脉和能力，找齐它们应该只是时间问题。",
            "nextDialogs": [
              "110090115"
            ]
          },
          "110090115": {
            "id": "110090115",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "兵贵神速，一切全看效率。我会以好价收购你们找来的材料。此外，前三位找齐材料的人，将得到一次向我提问的机会。",
            "nextDialogs": [
              "110090116"
            ]
          },
          "110090116": {
            "id": "110090116",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "无论是什么问题，我都会回答。我相信，以此为报酬，必不会令各位失望。",
            "nextDialogs": [
              "110090117"
            ]
          },
          "110090117": {
            "id": "110090117",
            "speakerId": 12342,
            "speakerName": "昌贵",
            "text": "这东西虽然难找，但如果能问到璃月港明年的规划…",
            "nextDialogs": [
              "110090118"
            ]
          },
          "110090118": {
            "id": "110090118",
            "speakerId": 12343,
            "speakerName": "志成",
            "text": "那就是天价的生意了。谁从凝光大人那里问到消息，谁就掌握了先机…",
            "nextDialogs": [
              "110090119"
            ]
          },
          "110090119": {
            "id": "110090119",
            "speakerId": 12341,
            "speakerName": "宏飞",
            "text": "哈哈，真是巧了！不久前我刚听说过有关浮生石的传闻。各位，恕不奉陪了，我先行一步！",
            "nextDialogs": [
              "110090120"
            ]
          },
          "110090120": {
            "id": "110090120",
            "speakerId": 12342,
            "speakerName": "昌贵",
            "text": "可恶…我们也赶紧出发，不能被别人抢先了！",
            "nextDialogs": [
              "110090121"
            ]
          },
          "110090121": {
            "id": "110090121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "重修群玉阁…这么重要的事情，我们也去看看吧！",
            "nextDialogs": [
              "110090122"
            ]
          },
          "110090122": {
            "id": "110090122",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "方才我说的话，你们都听到了吧。如何？可有兴趣参与此事？",
            "nextDialogs": [
              "110090123"
            ]
          },
          "110090123": {
            "id": "110090123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真的什么都可以问吗？",
            "nextDialogs": [
              "110090124"
            ]
          },
          "110090124": {
            "id": "110090124",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "只要是我知道的事，均可如实相告。",
            "nextDialogs": [
              "110090125"
            ]
          },
          "110090125": {
            "id": "110090125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#（说不定可以问到关于{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}的事…）",
            "nextDialogs": [
              "110090126"
            ]
          },
          "110090126": {
            "id": "110090126",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？那我要问，凝光小姐是怎么经商的！",
            "nextDialogs": [
              "110090127"
            ]
          },
          "110090127": {
            "id": "110090127",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样以后旅行，我们就再也不缺摩拉用啦！",
            "nextDialogs": [
              "110090128"
            ]
          },
          "110090128": {
            "id": "110090128",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "呵呵，当然可以。不过，传授多少心得，全看二位的表现了。",
            "nextDialogs": [
              "110090129"
            ]
          },
          "110090129": {
            "id": "110090129",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "群玉阁重建一事占地较大，我将地址安排在黄金屋外的废弃矿场。收集到的材料，都送去那边吧。",
            "nextDialogs": [
              "110090130"
            ]
          },
          "110090130": {
            "id": "110090130",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "我另有要事，不能陪你们前往现场。你们到了那里，联系我的秘书就好。",
            "nextDialogs": [
              "110090131"
            ]
          },
          "110090131": {
            "id": "110090131",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "千万注意时间。难得的机会，可别被别人抢先了。",
            "nextDialogs": [
              "110090132"
            ]
          },
          "110090132": {
            "id": "110090132",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "凝光小姐真是个大忙人呢…我们也快点出发吧。",
            "nextDialogs": [
              "110090133"
            ]
          },
          "110090133": {
            "id": "110090133",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#首先得先从玉京台离开…咦？{NICKNAME}你看，那边气氛好像有些微妙？",
            "nextDialogs": [
              "110090134"
            ]
          },
          "110090134": {
            "id": "110090134",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "小姐，我看你风度翩翩、气质不凡，一看就是在这次重修群玉阁中独占鳌头的料。",
            "nextDialogs": [
              "110090135"
            ]
          },
          "110090135": {
            "id": "110090135",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "我们这里有关于那些材料的情报，来，咱们找个安静的地方说话…",
            "nextDialogs": [
              "110090136"
            ]
          },
          "110090136": {
            "id": "110090136",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "不需要。",
            "nextDialogs": [
              "110090137"
            ]
          },
          "110090137": {
            "id": "110090137",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "别这么说嘛。哎，别走啊！",
            "nextDialogs": [
              "110090138"
            ]
          },
          "110090138": {
            "id": "110090138",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "愣着干什么，还不快跟上！",
            "nextDialogs": [
              "110090139"
            ]
          },
          "110090139": {
            "id": "110090139",
            "speakerId": 12331,
            "speakerName": "阿强",
            "text": "是…是！"
          }
        }
      }
    },
    {
      "subId": "1100905",
      "subQuestName": "跟随「情报商」打听消息",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110090501"
        ],
        "dialogs": {
          "110090501": {
            "id": "110090501",
            "speakerId": 12344,
            "speakerName": "常丰",
            "text": "重修群玉阁，这么重要的工作交给我们，我们也得上心才行。"
          }
        }
      }
    },
    {
      "subId": "1100902",
      "subQuestName": "暗中观察情报商与陌生女子的争吵",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110090201"
        ],
        "dialogs": {
          "110090201": {
            "id": "110090201",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "嘿嘿，小姐，这次你终于没地方跑了吧。",
            "nextDialogs": [
              "110090202"
            ]
          },
          "110090202": {
            "id": "110090202",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "放心，我们也不是什么坏人。出点钱就能换到宝贵的情报，大家谁都不亏嘛。",
            "nextDialogs": [
              "110090203"
            ]
          },
          "110090203": {
            "id": "110090203",
            "speakerId": 12331,
            "speakerName": "阿强",
            "text": "老大，我总有种不好的感觉。你看她身上的气质明显和别人不同，头发也是白的，不像是普通人…",
            "nextDialogs": [
              "110090204"
            ]
          },
          "110090204": {
            "id": "110090204",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "那又如何？好不容易遇见一只肥羊，不宰她一刀，咱们的赌债怎么还？",
            "nextDialogs": [
              "110090205"
            ]
          },
          "110090205": {
            "id": "110090205",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我说了，我不需要你们的情报。",
            "nextDialogs": [
              "110090206"
            ]
          },
          "110090206": {
            "id": "110090206",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "如果你们刚刚没有听到，那我再重复最后一次。",
            "nextDialogs": [
              "110090207"
            ]
          },
          "110090207": {
            "id": "110090207",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "唉…小姐，你说你这么大一个人，怎么一点常识也没有啊。",
            "nextDialogs": [
              "110090208"
            ]
          },
          "110090208": {
            "id": "110090208",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "这不是你需不需要的问题，你只要乖乖地把钱拿出来，交给我们就好。",
            "nextDialogs": [
              "110090209"
            ]
          },
          "110090209": {
            "id": "110090209",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我…",
            "nextDialogs": [
              "110090210"
            ]
          },
          "110090210": {
            "id": "110090210",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "别狡辩！你有钱，我看到了。",
            "nextDialogs": [
              "110090211"
            ]
          },
          "110090211": {
            "id": "110090211",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "你先去琉璃亭，点了满满一桌子菜，却只是稍微尝了尝。",
            "nextDialogs": [
              "110090212"
            ]
          },
          "110090212": {
            "id": "110090212",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "然后又去新月轩、万民堂，把招牌菜全点了一遍，又是每样只吃一口。",
            "nextDialogs": [
              "110090213"
            ]
          },
          "110090213": {
            "id": "110090213",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "如果不是富家千金小姐，哪来如此奢侈的习惯？既然你这么有钱，分我们一点怎么了？",
            "nextDialogs": [
              "110090214"
            ]
          },
          "110090214": {
            "id": "110090214",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "虽然师父叮嘱过，不要在璃月港里动手…",
            "nextDialogs": [
              "110090215"
            ]
          },
          "110090215": {
            "id": "110090215",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "算了。或许…这也是命吧。",
            "nextDialogs": [
              "110090216"
            ]
          },
          "110090216": {
            "id": "110090216",
            "speakerId": 12331,
            "speakerName": "阿强",
            "text": "老大，好像有点不太对劲…",
            "nextDialogs": [
              "110090217"
            ]
          },
          "110090217": {
            "id": "110090217",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "怕什么，咱们卖情报又不犯法，她要是敢动手，咱们告她个倾家荡产！",
            "nextDialogs": [
              "110090220"
            ]
          },
          "110090220": {
            "id": "110090220",
            "speakerId": 12347,
            "speakerName": "老郑",
            "text": "哦？又是你们几个。",
            "nextDialogs": [
              "110090221"
            ]
          },
          "110090221": {
            "id": "110090221",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "千岩军？千岩军怎么来了…是你干的？哼，多管闲事，信不信我…",
            "nextDialogs": [
              "110090222"
            ]
          },
          "110090222": {
            "id": "110090222",
            "speakerId": 12347,
            "speakerName": "老郑",
            "text": "住口！还敢威胁别人是吧，跟我们走一趟！",
            "nextDialogs": [
              "110090223"
            ]
          },
          "110090223": {
            "id": "110090223",
            "speakerId": 12330,
            "speakerName": "刀疤刘",
            "text": "呵呵…大人别生气，您听我慢慢跟您解释…",
            "nextDialogs": [
              "110090224"
            ]
          },
          "110090224": {
            "id": "110090224",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "围住白发女子的流氓被千岩军带走了。",
            "nextDialogs": [
              "110090225"
            ]
          },
          "110090225": {
            "id": "110090225",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "……"
          }
        }
      }
    },
    {
      "subId": "1100903",
      "subQuestName": "带申鹤前往不卜庐购买药材",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110090301"
        ],
        "dialogs": {
          "110090301": {
            "id": "110090301",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "两位是来抓药的吗？可还记得药方？",
            "nextDialogs": [
              "110090302"
            ]
          },
          "110090302": {
            "id": "110090302",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "清心、琉璃百合、琉璃袋，各要半斤。",
            "nextDialogs": [
              "110090303"
            ]
          },
          "110090303": {
            "id": "110090303",
            "speakerId": 2103,
            "speakerName": "阿桂",
            "text": "这是什么药方？简直是拿药当饭吃…给，这就是本店全部的存货了。",
            "nextDialogs": [
              "110090304"
            ]
          },
          "110090304": {
            "id": "110090304",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "多谢。",
            "nextDialogs": [
              "110090305"
            ]
          },
          "110090305": {
            "id": "110090305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真，真的在吃欸…",
            "nextDialogs": [
              "110090306"
            ]
          },
          "110090306": {
            "id": "110090306",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "在众人震惊的目光中，申鹤将眼前的药材扫荡一空。",
            "nextDialogs": [
              "110090307"
            ]
          },
          "110090307": {
            "id": "110090307",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "不饿了，多谢款待。",
            "nextDialogs": [
              "110090310"
            ]
          },
          "110090310": {
            "id": "110090310",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "不好吃。",
            "nextDialogs": [
              "110090311"
            ]
          },
          "110090311": {
            "id": "110090311",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "其味虽略带清香，但吃多了就只剩下苦、酸、涩。",
            "nextDialogs": [
              "110090312"
            ]
          },
          "110090312": {
            "id": "110090312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那申鹤为什么宁愿吃这些，也不吃饭馆里的菜呢？",
            "nextDialogs": [
              "110090313"
            ]
          },
          "110090313": {
            "id": "110090313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是我有很多摩拉的话，我肯定要去最高档的餐馆，点好多好多好吃的，一口气全部吃掉！",
            "nextDialogs": [
              "110090314"
            ]
          },
          "110090314": {
            "id": "110090314",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "因为我也不确定，以后自己会不会留在这里。",
            "nextDialogs": [
              "110090315"
            ]
          },
          "110090315": {
            "id": "110090315",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "人间的饭菜固然美味，但若是我将来回归山野，对美食的回味反而会成为修炼的阻碍。",
            "nextDialogs": [
              "110090316"
            ]
          },
          "110090316": {
            "id": "110090316",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "所以浅尝辄止，明白个中滋味便好。",
            "nextDialogs": [
              "110090317"
            ]
          },
          "110090317": {
            "id": "110090317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#回归山野…{NICKNAME}，不会错，这个人绝对是仙人！",
            "nextDialogs": [
              "110090318"
            ]
          },
          "110090318": {
            "id": "110090318",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "我的事暂且不提，两位接下来有什么打算？",
            "nextDialogs": [
              "110090319"
            ]
          },
          "110090319": {
            "id": "110090319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦！差点忘了，我们可是来参加重修群玉阁比赛的！",
            "nextDialogs": [
              "110090320"
            ]
          },
          "110090320": {
            "id": "110090320",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "耽、耽误太多时间，事情可就做不完了…",
            "nextDialogs": [
              "110090321"
            ]
          },
          "110090321": {
            "id": "110090321",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "原来如此。那个比赛，我刚刚路过的时候也有所耳闻。",
            "nextDialogs": [
              "110090322"
            ]
          },
          "110090322": {
            "id": "110090322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿…毕竟赢了的话，不管什么事情都可以问呢！",
            "nextDialogs": [
              "110090323"
            ]
          },
          "110090323": {
            "id": "110090323",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "申鹤也是来参赛的吗？",
            "nextDialogs": [
              "110090324"
            ]
          },
          "110090324": {
            "id": "110090324",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "我确实是为重修群玉阁而来，不过此前并没有参赛的想法。",
            "nextDialogs": [
              "110090325"
            ]
          },
          "110090325": {
            "id": "110090325",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "如今承蒙你们照顾，我也想助你们一臂之力。放心，并不需要什么回报。",
            "nextDialogs": [
              "110090326"
            ]
          },
          "110090326": {
            "id": "110090326",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…这怎么好意思…",
            "nextDialogs": [
              "110090327"
            ]
          },
          "110090327": {
            "id": "110090327",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过有仙人帮忙的话，事情应该会好办许多…"
          }
        }
      }
    },
    {

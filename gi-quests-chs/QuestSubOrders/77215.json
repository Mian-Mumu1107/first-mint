            "id": "772150315",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "…婚礼已经…结束了吗？",
            "nextDialogs": [
              "772150316"
            ]
          },
          "772150316": {
            "id": "772150316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是啊…",
            "nextDialogs": [
              "772150317"
            ]
          },
          "772150317": {
            "id": "772150317",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向谢斯卡娅说了在雪山上公馆发生的事…",
            "nextDialogs": [
              "772150318"
            ]
          },
          "772150318": {
            "id": "772150318",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "啊…帕芙琳娜大人，最终一切都没有发生任何改变。",
            "nextDialogs": [
              "772150319"
            ]
          },
          "772150319": {
            "id": "772150319",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "不过她的痛苦，她的执念，令她的精神备受折磨的一切也都烟消云散了…",
            "nextDialogs": [
              "772150320"
            ]
          },
          "772150320": {
            "id": "772150320",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "唉…至少，在最后，她获得了解脱…不是吗？"
          }
        }

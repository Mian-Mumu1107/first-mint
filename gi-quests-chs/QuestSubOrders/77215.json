  "subQuests": [
    {
      "subId": "7721502",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772150201"
        ],
        "dialogs": {
          "772150201": {
            "id": "772150201",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "嗯…那边的那一位，以及身边的小随从…能留步，听我说几句话吗？",
            "nextDialogs": [
              "772150202"
            ]
          },
          "772150202": {
            "id": "772150202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是在说我？",
            "nextDialogs": [
              "772150203"
            ]
          },
          "772150203": {
            "id": "772150203",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "是的，就是您。",
            "nextDialogs": [
              "772150204"
            ]
          },
          "772150204": {
            "id": "772150204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那小随从是说谁，啊，是在说我？",
            "nextDialogs": [
              "772150205"
            ]
          },
          "772150205": {
            "id": "772150205",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "是的，二位。",
            "nextDialogs": [
              "772150206"
            ]
          },
          "772150206": {
            "id": "772150206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我不是随从啦，我们是一起旅行的伙伴…呃，怎么了，有什么事吗？",
            "nextDialogs": [
              "772150207"
            ]
          },
          "772150207": {
            "id": "772150207",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "…其实我在物色宾客。",
            "nextDialogs": [
              "772150208"
            ]
          },
          "772150208": {
            "id": "772150208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "宾客？",
            "nextDialogs": [
              "772150209"
            ]
          },
          "772150209": {
            "id": "772150209",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "对，我来自山上的赫斯珀利德斯之馆，那是现今雪精们的王公帕芙琳娜大人与一众雪精们的居所…",
            "nextDialogs": [
              "772150210"
            ]
          },
          "772150210": {
            "id": "772150210",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "而现在，帕芙琳娜大人的婚礼…需要尊贵的客人，所以派我寻找足以配得上那仪式的见证者们…",
            "nextDialogs": [
              "772150211"
            ]
          },
          "772150211": {
            "id": "772150211",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "我看二位气质不凡，衣着独特，想必并非俗人，不知能否有这个荣幸邀请二位前往山上之馆。",
            "nextDialogs": [
              "772150212"
            ]
          },
          "772150212": {
            "id": "772150212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…前往雪山上什么馆的雪孃王公的婚礼…",
            "nextDialogs": [
              "772150213"
            ]
          },
          "772150213": {
            "id": "772150213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "之前我们拿到的…对，已经拿到过那个婚礼的请柬啦。",
            "nextDialogs": [
              "772150214"
            ]
          },
          "772150214": {
            "id": "772150214",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "咦，是这样吗？",
            "nextDialogs": [
              "772150215"
            ]
          },
          "772150215": {
            "id": "772150215",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "…啊，看来，这也是命运的安排，无论二位是否从我的手中拿到请柬，都在更早的时候，已然成为赫斯珀利德斯之馆的客人了。",
            "nextDialogs": [
              "772150216"
            ]
          },
          "772150216": {
            "id": "772150216",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "那么，就请拿着这份请柬，到了赫斯珀利德斯之馆前，将请柬递上，即可参加帕芙琳娜大人的婚礼了…",
            "nextDialogs": [
              "772150217"
            ]
          },
          "772150217": {
            "id": "772150217",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "虽然很想与你们一同前往，不过，帕芙琳娜大人的命令我尚未完成…",
            "nextDialogs": [
              "772150218"
            ]
          },
          "772150218": {
            "id": "772150218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "知道啦，我们会自己找到去那个…呃，名字好长馆的路的！",
            "nextDialogs": [
              "772150219"
            ]
          },
          "772150219": {
            "id": "772150219",
            "speakerId": 7842,
            "speakerName": "梅谢斯卡娅",
            "text": "哈哈，那就祝二位能够在馆内度过愉快的时光吧…"
          }
        }
      }
    },

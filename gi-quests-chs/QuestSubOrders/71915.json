            "id": "719150101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "祝他平安。",
            "nextDialogs": [
              "719150102"
            ]
          },
          "719150102": {
            "id": "719150102",
            "speakerId": 2097,
            "speakerName": "春水",
            "text": "谢谢你，也祝你能一切顺利…如果不嫌弃的话，就请收下这个吧。",
            "nextDialogs": [
              "719150103"
            ]
          },
          "719150103": {
            "id": "719150103",
            "speakerId": 2097,
            "speakerName": "春水",
            "text": "这种植物叫做风车菊，是我托人从蒙德带过来的。",
            "nextDialogs": [
              "719150104"
            ]
          },
          "719150104": {
            "id": "719150104",
            "speakerId": 2097,
            "speakerName": "春水",
            "text": "据说风车菊在当地有「看得见的风」的寓意，所以我想借此保佑我出海的丈夫。",
            "nextDialogs": [
              "719150105"
            ]
          },
          "719150105": {
            "id": "719150105",
            "speakerId": 2097,
            "speakerName": "春水",
            "text": "好心人，也祝愿你能得到风神的庇佑。"
          }
        }

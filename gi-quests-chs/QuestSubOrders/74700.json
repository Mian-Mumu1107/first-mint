  },
  "subQuests": [
    {
      "subId": "7470001",
      "subQuestName": "前往下层水族馆附近…",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747000101"
        ],
        "dialogs": {
          "747000101": {
            "id": "747000101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，我觉得装点水族箱明明还是很有趣的嘛！",
            "nextDialogs": [
              "747000102"
            ]
          },
          "747000102": {
            "id": "747000102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然桑多涅不介意，我们以后不如也多下去捞点，让这里变得漂漂亮亮的！",
            "nextDialogs": [
              "747000103"
            ]
          },
          "747000103": {
            "id": "747000103",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "喂，你们两个，过来一下。",
            "nextDialogs": [
              "747000104"
            ]
          },
          "747000104": {
            "id": "747000104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？怎么了吗？",
            "nextDialogs": [
              "747000105"
            ]
          },
          "747000105": {
            "id": "747000105",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "喏，这个给你们。",
            "nextDialogs": [
              "747000106"
            ]
          },
          "747000106": {
            "id": "747000106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是…？",
            "nextDialogs": [
              "747000107"
            ]
          },
          "747000107": {
            "id": "747000107",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "我帮你们改良的水下行动装置。",
            "nextDialogs": [
              "747000108"
            ]
          },
          "747000108": {
            "id": "747000108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！真的吗？谢谢你桑多涅！你人真好！",
            "nextDialogs": [
              "747000109"
            ]
          },
          "747000109": {
            "id": "747000109",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "小机械装置而已，举手之劳。主要还是你们上次捕鱼，怎么说呢…很…原始…真让人有些看不下去…",
            "nextDialogs": [
              "747000110"
            ]
          },
          "747000110": {
            "id": "747000110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有…有这么不堪吗…",
            "nextDialogs": [
              "747000111"
            ]
          },
          "747000111": {
            "id": "747000111",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "效率低下，毫无技巧可言，而且一点都不优雅。",
            "nextDialogs": [
              "747000112"
            ]
          },
          "747000112": {
            "id": "747000112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "让你见笑了…",
            "nextDialogs": [
              "747000113"
            ]
          },
          "747000113": {
            "id": "747000113",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "算了，你们有你们的习惯，我不多说什么。但既然你们想继续装饰这水族馆，最好带上我给的东西。",
            "nextDialogs": [
              "747000114"
            ]
          },
          "747000114": {
            "id": "747000114",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "枫丹水下不只有温和好看的小鱼，还有很多具有攻击性的危险大鱼。这既是为你们的成功率着想，也是为了安全着想。",
            "nextDialogs": [
              "747000117"
            ]
          },
          "747000117": {
            "id": "747000117",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "哼，行了，要下水就快去吧。回来后记得告诉我装置的使用感受，我可以根据你们的反馈进行调试。"
          }
        }
      }
    }
  ]
}
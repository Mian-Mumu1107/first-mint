    {
      "subId": "7302503",
      "subQuestName": "前往「桓那兰那」所在之处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730250301"
        ],
        "dialogs": {
          "730250301": {
            "id": "730250301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个地方…就像村子一样…",
            "nextDialogs": [
              "730250302"
            ]
          },
          "730250302": {
            "id": "730250302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，还记得我们和拉娜露营的时候，看到的石头小屋吗？",
            "nextDialogs": [
              "730250304"
            ]
          },
          "730250304": {
            "id": "730250304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是那些圆滚滚的小房子啦。",
            "nextDialogs": [
              "730250306"
            ]
          },
          "730250306": {
            "id": "730250306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里到处都是，简直就像小人族的国家一样…",
            "nextDialogs": [
              "730250307"
            ]
          },
          "730250307": {
            "id": "730250307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里就是兰拉娜说的「桓那兰那」的话，那看来就是兰那罗的家园了吧…",
            "nextDialogs": [
              "730250308"
            ]
          },
          "730250308": {
            "id": "730250308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但是一个人也没有。",
            "nextDialogs": [
              "730250309"
            ]
          },
          "730250309": {
            "id": "730250309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…该不会是看到我们，就躲起来了吧？"
          }
        }
      }
    },
    {
      "subId": "7302522",
      "subQuestName": "前往「桓那兰那」所在之处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730252201"
        ],
        "dialogs": {
          "730252201": {
            "id": "730252201",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "#哦哦。是那菈法留纳留下的东西吗…交给同样是金色的{NICKNAME}，也是一种缘分吧。",
            "nextDialogs": [
              "730252202"
            ]
          },
          "730252202": {
            "id": "730252202",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "#{M#她}{F#他}称之为「森林书」。因为是与我等兰那罗一同在林中冒险时，记下的故事。但那些故事已经失落了。",
            "nextDialogs": [
              "730252203"
            ]
          },
          "730252203": {
            "id": "730252203",
            "speakerId": 20648,
            "speakerName": "兰拉迦",
            "text": "#那菈{NICKNAME}，但愿它能为你提供帮助。老身很期待无忧节哪。"
          }
        }
      }
    },
    {
      "subId": "7302523",

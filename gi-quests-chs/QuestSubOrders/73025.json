    {
      "subId": "7302517",
      "subQuestName": "完成幻梦之种的试炼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730251701"
        ],
        "dialogs": {
          "730251701": {
            "id": "730251701",
            "speakerId": 20716,
            "speakerName": "兰犍多",
            "text": "兰犍多一定是脚程最快的兰那罗，跟长鬓虎比赛也不会输。",
            "nextDialogs": [
              "730251702"
            ]
          },
          "730251702": {
            "id": "730251702",
            "speakerId": 20716,
            "speakerName": "兰犍多",
            "text": "如果能在跑起来的长鬓虎背上跑…"
          }
        }
      }
    },
    {
      "subId": "7302525",
      "subQuestName": "跟随奇异的痕迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7302506",
      "subQuestName": "在奇异的石碑前，弹奏「大梦的曲调」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730250601"
        ],
        "dialogs": {
          "730250601": {
            "id": "730250601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好了，忙也帮了！兰罗摩，说好的宝藏呢？",
            "nextDialogs": [
              "730250602"
            ]
          },
          "730250602": {
            "id": "730250602",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "「宝藏」不是让那菈帮忙的咒语吗？",
            "nextDialogs": [
              "730250603"
            ]
          },
          "730250603": {
            "id": "730250603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么我一点也不惊讶…",
            "nextDialogs": [
              "730250605"
            ]
          },
          "730250605": {
            "id": "730250605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你还真的以为兰罗摩有准备宝藏喔！",
            "nextDialogs": [
              "730250607"
            ]
          },
          "730250607": {
            "id": "730250607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，兰罗摩，你是怎么学到「宝藏」这个词的呀？",
            "nextDialogs": [
              "730250608"
            ]
          },
          "730250608": {
            "id": "730250608",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "我观察过那菈。我发现，那菈只要听说「宝藏」，就会变得很好，很愿意帮助其他的那菈。"
          }
        }
      }
    },
    {
      "subId": "7302513",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730251301"
        ],
        "dialogs": {
          "730251301": {
            "id": "730251301",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "耶然草…必须取回。"
          }
        }
      }

  "subQuests": [
    {
      "subId": "7302520",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730250101"
        ],
        "dialogs": {
          "730250101": {
            "id": "730250101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是…真的要唱歌吗？万一引来了骗骗花…",
            "nextDialogs": [
              "730250102"
            ]
          },
          "730250102": {
            "id": "730250102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "虽然说唱歌，但借助乐器也可以吧。",
            "nextDialogs": [
              "730250103"
            ]
          },
          "730250103": {
            "id": "730250103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，值得试试。我们去维摩庄问问，看阿玛兹亚爷爷有没有什么乐器吧！"
          }
        }
      }
    },
    {
      "subId": "7302521",
      "subQuestName": "返回维摩庄，与阿玛兹亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730250201"
        ],
        "dialogs": {
          "730250201": {
            "id": "730250201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿玛兹亚爷爷…",
            "nextDialogs": [
              "730250202"
            ]
          },
          "730250202": {
            "id": "730250202",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "哦哦，是拉娜的朋友啊…很遗憾，拉娜那孩子，今天应该去巡林喽。",
            "nextDialogs": [
              "730250204"
            ]
          },
          "730250204": {
            "id": "730250204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（那我们就别跟爷爷说吧…）",
            "nextDialogs": [
              "730250206"
            ]
          },
          "730250206": {
            "id": "730250206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们知道啦！我们是想问问阿玛兹亚爷爷，有没有什么「乐器」，能借给我们用一用？",
            "nextDialogs": [
              "730250207"
            ]
          },
          "730250207": {
            "id": "730250207",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "乐器吗…你们等一下，爷爷这就拿来。",
            "nextDialogs": [
              "730250208"
            ]
          },
          "730250208": {
            "id": "730250208",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "阿玛兹亚从屋里取来了一副老旧的乐器。",
            "nextDialogs": [
              "730250209"
            ]
          },
          "730250209": {
            "id": "730250209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看起来…像是蒙德风格的乐器呢！阿玛兹亚爷爷，能借给我们吗？",
            "nextDialogs": [
              "730250210"
            ]
          },
          "730250210": {
            "id": "730250210",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "好久好久以前…我当年在林子里遇到了一个吟游诗人。作为信物，她把琴留给了我。",
            "nextDialogs": [
              "730250211"
            ]
          },
          "730250211": {
            "id": "730250211",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "「花园的梦，森林的记忆…石榴歌唱，苹果鼓掌…」",
            "nextDialogs": [
              "730250212"
            ]
          },
          "730250212": {
            "id": "730250212",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "多好的曲子啊…",
            "nextDialogs": [
              "730250213"
            ]
          },
          "730250213": {
            "id": "730250213",
            "speakerId": 20644,
            "speakerName": "阿玛兹亚",
            "text": "就借给你们吧，用琴声点亮林子里黑漆漆的地方，看看她能不能听到…"
          }
        }
      }
    },
    {

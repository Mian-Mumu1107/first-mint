    {
      "subId": "7302505",
      "subQuestName": "在指定地点，弹奏「大梦的曲调」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730250501"
        ],
        "dialogs": {
          "730250501": {
            "id": "730250501",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "你看，「桓那吉」，一定要小心…就算和他们说话，他们也只会生气，然后噗噗冒火。",
            "nextDialogs": [
              "730250502"
            ]
          },
          "730250502": {
            "id": "730250502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…什么嘛，只是骗骗花而已啊！",
            "nextDialogs": [
              "730250503"
            ]
          },
          "730250503": {
            "id": "730250503",
            "speakerId": 20646,
            "speakerName": "兰罗摩",
            "text": "很危险的！很危险的！我们快走吧！趁桓那吉还没发现我们！",
            "nextDialogs": [
              "730250505"
            ]
          },
          "730250505": {
            "id": "730250505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…你不会真的害怕骗骗花吧？",
            "nextDialogs": [
              "730250507"
            ]
          },
          "730250507": {
            "id": "730250507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#总之，兰罗摩别担心，我们会帮忙的！对吧，{NICKNAME}？"
          }
        }
      }
    },
    {
      "subId": "7302532",

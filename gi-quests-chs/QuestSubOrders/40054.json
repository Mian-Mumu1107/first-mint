{
  "lineCounts": {
    "Player": 10,
    "八重神子": 37,
    "凯瑟琳": 4,
    "小野寺": 3,
    "村田": 1,
    "派蒙": 19,
    "神里绫人": 12,
    "荒谷": 1
  },
  "subQuests": [
    {
      "subId": "4005401",
      "subQuestName": "与稻妻的凯瑟琳谈谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400540101"
        ],
        "dialogs": {
          "400540101": {
            "id": "400540101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "凯瑟琳，听说有新委托需要我们出马啦？",
            "nextDialogs": [
              "400540102"
            ]
          },
          "400540102": {
            "id": "400540102",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "没错，这里现在有一项委托人「指名」的工作要交给你们。",
            "nextDialogs": [
              "400540103"
            ]
          },
          "400540103": {
            "id": "400540103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「指名」？听起来还有点紧张，是和什么有关的工作呀？",
            "nextDialogs": [
              "400540104"
            ]
          },
          "400540104": {
            "id": "400540104",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "呵呵，请放心吧，这次的工作并不危险。二位或许已经有所耳闻，近期，稻妻将举办一场名为「光华容彩祭」的盛大祭典。",
            "nextDialogs": [
              "400540105"
            ]
          },
          "400540105": {
            "id": "400540105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶，是祭典！说起来，我们之前还没在稻妻参加过节日呢。",
            "nextDialogs": [
              "400540106"
            ]
          },
          "400540106": {
            "id": "400540106",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "此次祭典由社奉行与八重神子大人筹备，请求二位进行协助的，正是八重大人。",
            "nextDialogs": [
              "400540107"
            ]
          },
          "400540107": {
            "id": "400540107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来是神子。",
            "nextDialogs": [
              "400540108"
            ]
          },
          "400540108": {
            "id": "400540108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘻嘻，神子的脑袋里有许多稀奇古怪的主意，办祭典一定会很有意思的。",
            "nextDialogs": [
              "400540109"
            ]
          },
          "400540109": {
            "id": "400540109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们不如这就去鸣神大社找她，看看她到底想给我们什么任务吧。",
            "nextDialogs": [
              "400540110"
            ]
          },
          "400540110": {
            "id": "400540110",
            "speakerId": 3004,
            "speakerName": "凯瑟琳",
            "text": "二位不必跑那么远，八重大人现在就在花见坂的八重堂。她之前交代过，让我请你们到那里与她会合。",
            "nextDialogs": [
              "400540111"
            ]
          },
          "400540111": {
            "id": "400540111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来她就在附近，那我们走吧。"
          }
        }
      }
    },
    {
      "subId": "4005402",
      "subQuestName": "前往八重堂找八重神子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400540201"
        ],
        "dialogs": {
          "400540201": {
            "id": "400540201",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "荒谷，黑田，你们那边情况如何？",
            "nextDialogs": [
              "400540202"
            ]
          },
          "400540202": {
            "id": "400540202",
            "speakerId": 3030,
            "speakerName": "荒谷",
            "text": "报告八重大人，八重堂的书籍与个人委托印刷物，昨天下午已经全部装订完毕发出了。",
            "nextDialogs": [
              "400540203"
            ]
          },
          "400540203": {
            "id": "400540203",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "嗯，不错。村田呢？",
            "nextDialogs": [
              "400540204"
            ]
          },
          "400540204": {
            "id": "400540204",
            "speakerId": 3190,
            "speakerName": "村田",
            "text": "天顶屋与远航之风发来了联络，《转生成为雷电将军，然后天下无敌》与《拜托了我的狐仙宫司》的相关物料都已经就位！",
            "nextDialogs": [
              "400540205"
            ]
          },
          "400540205": {
            "id": "400540205",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "很好。小野寺？",
            "nextDialogs": [
              "400540206"
            ]
          },
          "400540206": {
            "id": "400540206",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "……",
            "nextDialogs": [
              "400540207"
            ]
          },
          "400540207": {
            "id": "400540207",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "小、野、寺？",
            "nextDialogs": [
              "400540208"
            ]
          },
          "400540208": {
            "id": "400540208",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "啊，在…我在！报告八重大人，新刊发售会的准备一切正常！",
            "nextDialogs": [
              "400540209"
            ]
          },
          "400540209": {
            "id": "400540209",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "小野寺，这次发售会的企划是你提出的，换言之你就是我们的「大将」，你可要拿出点自信来啊。",
            "nextDialogs": [
              "400540210"
            ]
          },
          "400540210": {
            "id": "400540210",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "放心吧，这个企划一定能大获成功，我可是非常看好它的。",
            "nextDialogs": [
              "400540211"
            ]
          },
          "400540211": {
            "id": "400540211",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "这两天我特批你假期，你就抓紧时间好好休息一下吧，毕竟发售会当天可有你忙的。",
            "nextDialogs": [
              "400540212"
            ]
          },
          "400540212": {
            "id": "400540212",
            "speakerId": 30139,
            "speakerName": "小野寺",
            "text": "八重大人，非常感谢…",
            "nextDialogs": [
              "400540213"
            ]
          },
          "400540213": {
            "id": "400540213",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "好了，大家都清楚自己的任务了吧。时间紧急，立刻行动起来，解散！",
            "nextDialogs": [
              "400540215"
            ]
          },
          "400540215": {
            "id": "400540215",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "你们好啊，小家伙们，看样子是已经接到我的委托咯？",
            "nextDialogs": [
              "400540216"
            ]
          },
          "400540216": {
            "id": "400540216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好你个神子，都要举办祭典了你也不回鸣神大社，竟然还有功夫在这儿折腾你的轻小说事业。",
            "nextDialogs": [
              "400540217"
            ]
          },
          "400540217": {
            "id": "400540217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你找我们来，该不会是想把筹备祭典的事扔给我们代劳吧？哼，这种委托我是不会接的！",
            "nextDialogs": [
              "400540218"
            ]
          },
          "400540218": {
            "id": "400540218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对，不会接的！",
            "nextDialogs": [
              "400540219"
            ]
          },
          "400540219": {
            "id": "400540219",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "哎呀呀，我真是好伤心啊，明明人家就正在为祭典的事操劳，却被你们当成了不务正业。",
            "nextDialogs": [
              "400540220"
            ]
          },
          "400540220": {
            "id": "400540220",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "小家伙们，是谁告诉你们，祭典就一定会和鸣神大社有关呢？",
            "nextDialogs": [
              "400540221"
            ]
          },
          "400540221": {
            "id": "400540221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，难道不是这样吗？毕竟这里可是稻妻呀。",
            "nextDialogs": [
              "400540222"
            ]
          },
          "400540222": {
            "id": "400540222",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "虽说这话是没错，不过现在，解除锁国令的稻妻，已经不是从前那个渴望一成不变的国度了。",
            "nextDialogs": [
              "400540223"
            ]
          },
          "400540223": {
            "id": "400540223",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "所以，比起循规蹈矩的传统祭典，这次我与社奉行决定另辟蹊径，打造一场既有稻妻风格，又与众不同的国际化文化盛会。",
            "nextDialogs": [
              "400540226"
            ]
          },
          "400540226": {
            "id": "400540226",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "呵呵，这件事就要从容彩祭的来历说起了。",
            "nextDialogs": [
              "400540227"
            ]
          },
          "400540227": {
            "id": "400540227",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "传说在古代稻妻，曾经活跃着五位能歌善赋的诗人，世人称他们为「五歌仙」。",
            "nextDialogs": [
              "400540228"
            ]
          },
          "400540228": {
            "id": "400540228",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "每年，五歌仙都会派出其中一位，将五人所作的诗集呈给将军品鉴，此事一时传为雅谈。",
            "nextDialogs": [
              "400540229"
            ]
          },
          "400540229": {
            "id": "400540229",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "托他们的福，稻妻的文化也在当时极为繁荣。",
            "nextDialogs": [
              "400540230"
            ]
          },
          "400540230": {
            "id": "400540230",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "后来人们以他们为原型，创作了许多风格各异的五歌仙故事，还发展出了「容彩祭」，感谢创作为我们的生活增添乐趣。",
            "nextDialogs": [
              "400540231"
            ]
          },
          "400540231": {
            "id": "400540231",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "果然是个文化气息浓郁的节日呢。",
            "nextDialogs": [
              "400540232"
            ]
          },
          "400540232": {
            "id": "400540232",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "嗯，用古话讲就是「风雅」吧。只可惜随着时间流逝，五歌仙与这一祭典已经逐渐被人们淡忘了。",
            "nextDialogs": [
              "400540233"
            ]
          },
          "400540233": {
            "id": "400540233",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "所以这次，我决心重振容彩祭——",
            "nextDialogs": [
              "400540234"
            ]
          },
          "400540234": {
            "id": "400540234",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "举办一场以轻小说创作为核心的文化交流展！",
            "nextDialogs": [
              "400540235"
            ]
          },
          "400540235": {
            "id": "400540235",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，等一下…轻小说？！",
            "nextDialogs": [
              "400540236"
            ]
          },
          "400540236": {
            "id": "400540236",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说好的「风雅」呢？",
            "nextDialogs": [
              "400540237"
            ]
          },
          "400540237": {
            "id": "400540237",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "不要露出这种难以置信的表情。在古代，诗歌也是一种流行的载体，只不过在今天，这种流行变成了「轻小说」而已。",
            "nextDialogs": [
              "400540238"
            ]
          },
          "400540238": {
            "id": "400540238",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "重要的不是形式，而是「创作」本身。如果一味盯着过去，拘泥于固定的形式或内容，可是写不出好作品的。",
            "nextDialogs": [
              "400540239"
            ]
          },
          "400540239": {
            "id": "400540239",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "说起来，你不觉得「关注当下」这个内核也很符合现在的稻妻吗？",
            "nextDialogs": [
              "400540240"
            ]
          },
          "400540240": {
            "id": "400540240",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "而且还能借此机会，让提瓦特通过轻小说重新认识稻妻，可谓一举两得。"
          }
        }
      }
    },
    {
      "subId": "4005403",
      "subQuestName": "前往离岛的容彩祭会场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400540301"
        ],
        "dialogs": {
          "400540301": {
            "id": "400540301",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "…在容彩祭期间，远国监司周围将会承担轻小说的主展区功能。",
            "nextDialogs": [
              "400540302"
            ]
          },
          "400540302": {
            "id": "400540302",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "届时不仅有大量官方与同人作品参展，还有限定赠品、抽奖、新刊发售会等丰富的活动。",
            "nextDialogs": [
              "400540303"
            ]
          },
          "400540303": {
            "id": "400540303",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "万国商会前的这个小广场，祭典期间会被称作「五歌仙广场」，附近的店铺将贩售与轻小说联动的特别商品，请一定不要错过。",
            "nextDialogs": [
              "400540304"
            ]
          },
          "400540304": {
            "id": "400540304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，该怎么说呢，虽然和普通的祭典感觉不太一样，但感到了另一种层面的厉害…",
            "nextDialogs": [
              "400540305"
            ]
          },
          "400540305": {
            "id": "400540305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，「轻小说浓度过高」。",
            "nextDialogs": [
              "400540306"
            ]
          },
          "400540306": {
            "id": "400540306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，神子，广场中心这些空白的板子是什么呀？",
            "nextDialogs": [
              "400540307"
            ]
          },
          "400540307": {
            "id": "400540307",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "嗯，这些呀…",
            "nextDialogs": [
              "400540308"
            ]
          },
          "400540308": {
            "id": "400540308",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "八重大人此前说会有可靠的帮手前来协助，果然是指你们。",
            "nextDialogs": [
              "400540309"
            ]
          },
          "400540309": {
            "id": "400540309",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "旅行者，派蒙，有段时间没见了，你们最近可好？",
            "nextDialogs": [
              "400540310"
            ]
          },
          "400540310": {
            "id": "400540310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是绫人！这次的容彩祭，连你这个大忙人也亲自出马了呀。",
            "nextDialogs": [
              "400540311"
            ]
          },
          "400540311": {
            "id": "400540311",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "筹备祭典是社奉行分内之事，容彩祭又倾注了八重大人的心血，我也自当亲力亲为。",
            "nextDialogs": [
              "400540312"
            ]
          },
          "400540312": {
            "id": "400540312",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "呵呵，绫人，大家都是熟人了，干嘛这么客气呀。",
            "nextDialogs": [
              "400540313"
            ]
          },
          "400540313": {
            "id": "400540313",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "我们刚好说到这里的展板，它们跟小家伙们的任务也有些关系，你就来仔细讲讲吧。",
            "nextDialogs": [
              "400540314"
            ]
          },
          "400540314": {
            "id": "400540314",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "你们两个应该已经知道容彩祭来源于五歌仙，这五块展板，正是为了绘制他们的画像设置的。",
            "nextDialogs": [
              "400540315"
            ]
          },
          "400540315": {
            "id": "400540315",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "此次容彩祭，不仅是稻妻解除锁国令后的第一次大型祭典，并且还与文化艺术相关。",
            "nextDialogs": [
              "400540316"
            ]
          },
          "400540316": {
            "id": "400540316",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "因此社奉行出面，邀请了数位他国的文化名人前来。",
            "nextDialogs": [
              "400540317"
            ]
          },
          "400540317": {
            "id": "400540317",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "比如应邀绘制这几幅画像的，就是一位从蒙德远道而来的画家。",
            "nextDialogs": [
              "400540318"
            ]
          },
          "400540318": {
            "id": "400540318",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "各位嘉宾在稻妻的食宿社奉行会帮忙安排，但客人远到异乡，难免会不习惯。",
            "nextDialogs": [
              "400540319"
            ]
          },
          "400540319": {
            "id": "400540319",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "这时候如果能有一位既熟悉稻妻，又了解提瓦特其他国家的人作为接引向导，就再好不过了。",
            "nextDialogs": [
              "400540322"
            ]
          },
          "400540322": {
            "id": "400540322",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "正是。我们希望二位能从港口接引嘉宾们到万国商会下榻，并提供适当的帮助。",
            "nextDialogs": [
              "400540323"
            ]
          },
          "400540323": {
            "id": "400540323",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "这份「到港时刻表」上，写明了嘉宾们乘坐船只的详细信息，只要按照上面的时间到港口便可。",
            "nextDialogs": [
              "400540324"
            ]
          },
          "400540324": {
            "id": "400540324",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "好啦，时候不早了，我还要和编辑们开会，就先走一步咯。",
            "nextDialogs": [
              "400540325"
            ]
          },
          "400540325": {
            "id": "400540325",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "祭典期间，八重堂的编辑大多都会待在远国监司附近，你们如果有事就过去找他们吧。",
            "nextDialogs": [
              "400540326"
            ]
          },
          "400540326": {
            "id": "400540326",
            "speakerId": 1047,
            "speakerName": "神里绫人",
            "text": "二位，这次祭典需三奉行通力合作，有许多琐事需要处理，我也先失陪了。接引嘉宾一事，就拜托你们了。"
          }
        }
      }

      }
    },
    {
      "subId": "1200510",
      "subQuestName": "击败浪人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120051001"
        ],
        "dialogs": {
          "120051001": {
            "id": "120051001",
            "speakerId": 1002,
            "speakerName": "小仓澪",
            "text": "太好了！唔，除了丝绸，其他辅料本店应该都有…",
            "nextDialogs": [
              "120051002"
            ]
          },
          "120051002": {
            "id": "120051002",
            "speakerId": 1002,
            "speakerName": "小仓澪",
            "text": "我去清点材料，很快就好，各位，请先在这里稍等片刻哦。",
            "nextDialogs": [
              "120051003"
            ]
          },
          "120051003": {
            "id": "120051003",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一定要有哦！",
            "nextDialogs": [
              "120051004"
            ]
          },
          "120051004": {
            "id": "120051004",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "希望这次不缺什么了。",
            "nextDialogs": [
              "120051005"
            ]
          },
          "120051005": {
            "id": "120051005",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "说起来，旅行者，其实我一直想给你也添置一套新衣服。",
            "nextDialogs": [
              "120051006"
            ]
          },
          "120051006": {
            "id": "120051006",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "只是…不知道你习不习惯稻妻的特色服饰…",
            "nextDialogs": [
              "120051007"
            ]
          },
          "120051007": {
            "id": "120051007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢你，我这样就好了。",
            "nextDialogs": [
              "120051008"
            ]
          },
          "120051008": {
            "id": "120051008",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "哎？真的吗？",
            "nextDialogs": [
              "120051011"
            ]
          },
          "120051011": {
            "id": "120051011",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "这样啊…",
            "nextDialogs": [
              "120051012"
            ]
          },
          "120051012": {
            "id": "120051012",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "果然，优秀的旅行者都有一套自己的行事准则与着装风格呢。",
            "nextDialogs": [
              "120051013"
            ]
          },
          "120051013": {
            "id": "120051013",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "出门在外，很多事也是不得已呀。",
            "nextDialogs": [
              "120051014"
            ]
          },
          "120051014": {
            "id": "120051014",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，我倒是很想试试看稻妻的特色服装哦！",
            "nextDialogs": [
              "120051015"
            ]
          },
          "120051015": {
            "id": "120051015",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有这么小的尺寸吧。",
            "nextDialogs": [
              "120051016"
            ]
          },
          "120051016": {
            "id": "120051016",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么嘛，想做的话还是可以做的吧！",
            "nextDialogs": [
              "120051017"
            ]
          },
          "120051017": {
            "id": "120051017",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "哈哈哈，你们的交流真可爱…咳！不、不是，我是说，如果派蒙想要，我可以找人帮你定做衣服。"
          }
        }
      }
    },

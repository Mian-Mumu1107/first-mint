      }
    },
    {
      "subId": "1200503",
      "subQuestName": "前往位于离岛的万国商会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120050301"
        ],
        "dialogs": {
          "120050301": {
            "id": "120050301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "小偷，站住！",
            "nextDialogs": [
              "120050302"
            ]
          },
          "120050302": {
            "id": "120050302",
            "speakerId": 1003,
            "speakerName": "浪人",
            "text": "哈？就带这么几个人来，还想把东西拿回去吗？别做梦了。",
            "nextDialogs": [
              "120050303"
            ]
          },
          "120050303": {
            "id": "120050303",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "竟然理直气壮地说出这种话…你…",
            "nextDialogs": [
              "120050304"
            ]
          },
          "120050304": {
            "id": "120050304",
            "speakerId": 1003,
            "speakerName": "浪人",
            "text": "有什么不敢？喂你，我问你，你是别国来的商人吧？",
            "nextDialogs": [
              "120050305"
            ]
          },
          "120050305": {
            "id": "120050305",
            "speakerId": 1003,
            "speakerName": "浪人",
            "text": "万国商会，不就是在稻妻地盘上腆着脸皮苟且偷生的蛀虫而已嘛！有人保护你吗？谁来为你出头？",
            "nextDialogs": [
              "120050306"
            ]
          },
          "120050306": {
            "id": "120050306",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "……",
            "nextDialogs": [
              "120050307"
            ]
          },
          "120050307": {
            "id": "120050307",
            "speakerId": 1003,
            "speakerName": "浪人",
            "text": "哈哈哈哈！连自己的立场都不知道！",
            "nextDialogs": [
              "120050308"
            ]
          },
          "120050308": {
            "id": "120050308",
            "speakerId": 1003,
            "speakerName": "浪人",
            "text": "在这个稻妻，你们这些无依无靠的商贩任人宰割才是常态吧？",
            "nextDialogs": [
              "120050309"
            ]
          },
          "120050309": {
            "id": "120050309",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "…可恶…",
            "nextDialogs": [
              "120050310"
            ]
          },
          "120050310": {
            "id": "120050310",
            "speakerId": 1003,
            "speakerName": "浪人",
            "text": "喂！外国佬，你想做笔交易吗？",
            "nextDialogs": [
              "120050311"
            ]
          },
          "120050311": {
            "id": "120050311",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "交易？",
            "nextDialogs": [
              "120050312"
            ]
          },
          "120050312": {
            "id": "120050312",
            "speakerId": 1003,
            "speakerName": "浪人",
            "text": "用钱把这些布料买回去，怎么样？总比头破血流地离开这里好吧。",
            "nextDialogs": [
              "120050313"
            ]
          },
          "120050313": {
            "id": "120050313",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欺人太甚！",
            "nextDialogs": [
              "120050314"
            ]
          },
          "120050314": {
            "id": "120050314",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "我…唉！算我倒霉…",
            "nextDialogs": [
              "120050315"
            ]
          },
          "120050315": {
            "id": "120050315",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "稍等一下。",
            "nextDialogs": [
              "120050316"
            ]
          },
          "120050316": {
            "id": "120050316",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "久利须先生，请不要付钱给他。",
            "nextDialogs": [
              "120050317"
            ]
          },
          "120050317": {
            "id": "120050317",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "可、可是…",
            "nextDialogs": [
              "120050318"
            ]
          },
          "120050318": {
            "id": "120050318",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "还记得我们的协议吗？您守口如瓶，我也会完成答应您的事。",
            "nextDialogs": [
              "120050319"
            ]
          },
          "120050319": {
            "id": "120050319",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "啊对，对！",
            "nextDialogs": [
              "120050320"
            ]
          },
          "120050320": {
            "id": "120050320",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "那么请您退到安全的地方，并保护好自身安全。接下来…是我实现承诺的时候了。"
          }
        }
      }
    },
    {
      "subId": "1200504",
      "subQuestName": "到附近查看情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120050401"
        ],
        "dialogs": {
          "120050401": {
            "id": "120050401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "解决了！",
            "nextDialogs": [
              "120050402"
            ]
          },
          "120050402": {
            "id": "120050402",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "…呼。",
            "nextDialogs": [
              "120050405"
            ]
          },
          "120050405": {
            "id": "120050405",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "不不…你过奖了，我只是完成应尽之事。",
            "nextDialogs": [
              "120050406"
            ]
          },
          "120050406": {
            "id": "120050406",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "神里小姐，旅行者，你们没有受伤吧？！",
            "nextDialogs": [
              "120050407"
            ]
          },
          "120050407": {
            "id": "120050407",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "不用担心，我们没事。",
            "nextDialogs": [
              "120050408"
            ]
          },
          "120050408": {
            "id": "120050408",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "那些浪人匆忙地逃走了，看起来什么都来不及带走。所以我想，您丢失的货物都在这里了哦。",
            "nextDialogs": [
              "120050409"
            ]
          },
          "120050409": {
            "id": "120050409",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "谢谢您、谢谢您…",
            "nextDialogs": [
              "120050410"
            ]
          },
          "120050410": {
            "id": "120050410",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "清点一下吧。",
            "nextDialogs": [
              "120050411"
            ]
          },
          "120050411": {
            "id": "120050411",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "六、八、十…没错，确实都在这里了。",
            "nextDialogs": [
              "120050412"
            ]
          },
          "120050412": {
            "id": "120050412",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "太好啦，我们快点购买丝绸吧！",
            "nextDialogs": [
              "120050413"
            ]
          },
          "120050413": {
            "id": "120050413",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "购买丝绸？莫非，几位需要用到我这里的货物吗？",
            "nextDialogs": [
              "120050414"
            ]
          },
          "120050414": {
            "id": "120050414",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "实不相瞒，是这样没错。",
            "nextDialogs": [
              "120050415"
            ]
          },
          "120050415": {
            "id": "120050415",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "别误会，帮你忙只是顺带的！就算你丢的是胡萝卜呀卷心菜之类的东西，我们多半还是会出手相助的吧。",
            "nextDialogs": [
              "120050416"
            ]
          },
          "120050416": {
            "id": "120050416",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我都觉得我们运气不错了呢，要是晚一步，或许真就无法买到丝绸了…",
            "nextDialogs": [
              "120050417"
            ]
          },
          "120050417": {
            "id": "120050417",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "几位…实在是感激不尽。",
            "nextDialogs": [
              "120050418"
            ]
          },
          "120050418": {
            "id": "120050418",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "不说那么多了，几位是需要丝绸对吧？我这就挑一匹！",
            "nextDialogs": [
              "120050419"
            ]
          },
          "120050419": {
            "id": "120050419",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "麻烦您了，一共多少钱？",
            "nextDialogs": [
              "120050420"
            ]
          },
          "120050420": {
            "id": "120050420",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "您是我的恩人，怎么能收恩人的钱啊！我送给您。",
            "nextDialogs": [
              "120050421"
            ]
          },
          "120050421": {
            "id": "120050421",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "不不，该是多少钱就是多少钱。",
            "nextDialogs": [
              "120050422"
            ]
          },
          "120050422": {
            "id": "120050422",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "商人行商也有难处，如派蒙所说，我帮您绝非是要占您的便宜。这些货物，请您按正常的价格出售给我。",
            "nextDialogs": [
              "120050423"
            ]
          },
          "120050423": {
            "id": "120050423",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "也不必觉得为难，今天这片树林里什么事都没有发生，不是吗？",
            "nextDialogs": [
              "120050424"
            ]
          },
          "120050424": {
            "id": "120050424",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是啊，我们只是来散步。",
            "nextDialogs": [
              "120050425"
            ]
          },
          "120050425": {
            "id": "120050425",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "各位…我、我无以为报，这次真是太感谢了！你们的恩情，我会一直牢牢记在心中。",
            "nextDialogs": [
              "120050426"
            ]
          },
          "120050426": {
            "id": "120050426",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "东西还得送回商会里，几位，我先失陪了。之后要是有什么需要，尽管来万国商会找我久利须就好！",
            "nextDialogs": [
              "120050427"
            ]
          },
          "120050427": {
            "id": "120050427",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "嗯，也谢谢您的丝绸，久利须先生。",
            "nextDialogs": [
              "120050428"
            ]
          },
          "120050428": {
            "id": "120050428",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "再见——！路上小心，别再被人抢了啊！",
            "nextDialogs": [
              "120050429"
            ]
          },
          "120050429": {
            "id": "120050429",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "旅行者，刚才谢谢你出手帮忙。"
          }
        }
      }
    },
    {
      "subId": "1200505",
      "subQuestName": "(test)提前找到久利须$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1200506",
      "subQuestName": "与久利须对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120050201"
        ],
        "dialogs": {
          "120050201": {
            "id": "120050201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂你们看！久利须会长在那里！",
            "nextDialogs": [
              "120050202"
            ]
          },
          "120050202": {
            "id": "120050202",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "应该就是那位了。",
            "nextDialogs": [
              "120050203"
            ]
          },
          "120050203": {
            "id": "120050203",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "呜呜，这下可怎么办…",
            "nextDialogs": [
              "120050204"
            ]
          },
          "120050204": {
            "id": "120050204",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "久利须先生，您没事吧？",
            "nextDialogs": [
              "120050205"
            ]
          },
          "120050205": {
            "id": "120050205",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "噢、噢噢！您是神里家的…绫华小姐！",
            "nextDialogs": [
              "120050206"
            ]
          },
          "120050206": {
            "id": "120050206",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "您好。",
            "nextDialogs": [
              "120050207"
            ]
          },
          "120050207": {
            "id": "120050207",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "旅行者也在啊。好久不见，我猜你最近是离开离岛了吧？",
            "nextDialogs": [
              "120050208"
            ]
          },
          "120050208": {
            "id": "120050208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是啊，好久不见。",
            "nextDialogs": [
              "120050209"
            ]
          },
          "120050209": {
            "id": "120050209",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "上次的事真是多谢你啦，多亏了你，我们商会的生意才又能周转起来。",
            "nextDialogs": [
              "120050210"
            ]
          },
          "120050210": {
            "id": "120050210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，话说…你怎么站在这里发呆呀，是遇到麻烦事了吗？",
            "nextDialogs": [
              "120050211"
            ]
          },
          "120050211": {
            "id": "120050211",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "我…我…唉！",
            "nextDialogs": [
              "120050212"
            ]
          },
          "120050212": {
            "id": "120050212",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "说来丢人，我们万国商会的货物被浪人抢了。",
            "nextDialogs": [
              "120050213"
            ]
          },
          "120050213": {
            "id": "120050213",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "货物的具体内容是什么？",
            "nextDialogs": [
              "120050214"
            ]
          },
          "120050214": {
            "id": "120050214",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "是一批高档丝绸。",
            "nextDialogs": [
              "120050215"
            ]
          },
          "120050215": {
            "id": "120050215",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "……！",
            "nextDialogs": [
              "120050216"
            ]
          },
          "120050216": {
            "id": "120050216",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "前些年我们从璃月进了一大批丝绸，一直堆在仓库里。",
            "nextDialogs": [
              "120050217"
            ]
          },
          "120050217": {
            "id": "120050217",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "最近听说，稻妻城内各个服装店积压的丝绸都卖得差不多了，我们正想着把这批货提出来卖个好价钱，谁知…",
            "nextDialogs": [
              "120050218"
            ]
          },
          "120050218": {
            "id": "120050218",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "唉！那些浪人一截下我们的货，就立刻带着东西逃到树林里去了。我想报案，可是…",
            "nextDialogs": [
              "120050219"
            ]
          },
          "120050219": {
            "id": "120050219",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "您也知道，我们这种外国商贩本就不受待见。「勘定奉行」的人一点儿都不想搭理我们，甚至巴不得我们倒霉呢…",
            "nextDialogs": [
              "120050220"
            ]
          },
          "120050220": {
            "id": "120050220",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "虽然我个人也不怎么认可「勘定奉行」的行事作风，但久利须先生，这里毕竟是稻妻，请注意您的发言。",
            "nextDialogs": [
              "120050221"
            ]
          },
          "120050221": {
            "id": "120050221",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "噢，抱歉，忍不住就抱怨了起来…",
            "nextDialogs": [
              "120050222"
            ]
          },
          "120050222": {
            "id": "120050222",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "现在也没有更好的办法，单凭我们商会，怕是没法追回货物。",
            "nextDialogs": [
              "120050223"
            ]
          },
          "120050223": {
            "id": "120050223",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "唉，或许这就是注定的破财之灾吧…",
            "nextDialogs": [
              "120050224"
            ]
          },
          "120050224": {
            "id": "120050224",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "虽然不能走公务流程，但我可以帮您找回丢失的货物。",
            "nextDialogs": [
              "120050225"
            ]
          },
          "120050225": {
            "id": "120050225",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "当然当然，您…哎？！",
            "nextDialogs": [
              "120050226"
            ]
          },
          "120050226": {
            "id": "120050226",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎？！",
            "nextDialogs": [
              "120050227"
            ]
          },
          "120050227": {
            "id": "120050227",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这样真的没关系吗？",
            "nextDialogs": [
              "120050228"
            ]
          },
          "120050228": {
            "id": "120050228",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "嗯。不过，虽然是以个人身份出面处理这次的事，但我的一言一行，多少都会关系到社奉行与神里家的形象。",
            "nextDialogs": [
              "120050229"
            ]
          },
          "120050229": {
            "id": "120050229",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "我有一些顾虑，所以…希望您能为我保密。",
            "nextDialogs": [
              "120050230"
            ]
          },
          "120050230": {
            "id": "120050230",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "另外，人生在世，谁都不能保证遇到困难时会有人对自己出手相助。",
            "nextDialogs": [
              "120050231"
            ]
          },
          "120050231": {
            "id": "120050231",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "以您和万国商会的立场，我建议…平日还是多加小心，以免蒙受不必要的损失。",
            "nextDialogs": [
              "120050232"
            ]
          },
          "120050232": {
            "id": "120050232",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "一定、一定！",
            "nextDialogs": [
              "120050233"
            ]
          },
          "120050233": {
            "id": "120050233",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "可是，这样会不会给您个人带去麻烦？",
            "nextDialogs": [
              "120050234"
            ]
          },
          "120050234": {
            "id": "120050234",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "万一勘定奉行的大人们对您有什么意见…您在民间声望很高，犯不着为了我们这种小人物蒙受损失啊！",
            "nextDialogs": [
              "120050235"
            ]
          },
          "120050235": {
            "id": "120050235",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "您说笑了。",
            "nextDialogs": [
              "120050236"
            ]
          },
          "120050236": {
            "id": "120050236",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "怎么说我也是神里家的大小姐。单凭勘定奉行的各位，应该还没有资格追究我的行为。",
            "nextDialogs": [
              "120050237"
            ]
          },
          "120050237": {
            "id": "120050237",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，好有气势的发言！这就是贵族大小姐吗？",
            "nextDialogs": [
              "120050238"
            ]
          },
          "120050238": {
            "id": "120050238",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "久利须先生，请您将货物被劫的时间、地点以及抢劫者的特征告诉我。",
            "nextDialogs": [
              "120050239"
            ]
          },
          "120050239": {
            "id": "120050239",
            "speakerId": 1004,
            "speakerName": "久利须",
            "text": "太感谢了，太感谢了！时间是两个小时之前，事发地点是…",
            "nextDialogs": [
              "120050240"
            ]
          },
          "120050240": {
            "id": "120050240",
            "speakerId": 1000,
            "speakerName": "神里绫华",
            "text": "各位，请随我到事发地点进行调查。",
            "nextDialogs": [
              "120050241"
            ]
          },
          "120050241": {
            "id": "120050241",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好，出发！"
          }
        }
      }
    },

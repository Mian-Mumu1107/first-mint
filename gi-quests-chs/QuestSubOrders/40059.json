    {
      "subId": "4005910",
      "subQuestName": "与主编对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400591001"
        ],
        "dialogs": {
          "400591001": {
            "id": "400591001",
            "speakerId": 1008,
            "speakerName": "平山",
            "text": "诸位，欢迎大家参加「光华容彩祭」！",
            "nextDialogs": [
              "400591002"
            ]
          },
          "400591002": {
            "id": "400591002",
            "speakerId": 1008,
            "speakerName": "平山",
            "text": "今天，我们的祭典顺利迎来了最后一个阶段。",
            "nextDialogs": [
              "400591003"
            ]
          },
          "400591003": {
            "id": "400591003",
            "speakerId": 1008,
            "speakerName": "平山",
            "text": "接下来，我们就将为大家揭晓由蒙德画家白垩老师绘制的五歌仙画像最后一幅——黑主。",
            "nextDialogs": [
              "400591004"
            ]
          },
          "400591004": {
            "id": "400591004",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好紧张啊，不知道阿贝多画了什么…",
            "nextDialogs": [
              "400591005"
            ]
          },
          "400591005": {
            "id": "400591005",
            "speakerId": 1008,
            "speakerName": "平山",
            "text": "让我们一起倒计时，三、二、一！",
            "nextDialogs": [
              "400591006"
            ]
          },
          "400591006": {
            "id": "400591006",
            "speakerId": 1009,
            "speakerName": "游客",
            "text": "这是怎么回事，这幅画上面怎么只有背景？",
            "nextDialogs": [
              "400591007"
            ]
          },
          "400591007": {
            "id": "400591007",
            "speakerId": 1009,
            "speakerName": "游客",
            "text": "白垩老师肯定不会是忘了画角色啊…",
            "nextDialogs": [
              "400591008"
            ]
          },
          "400591008": {
            "id": "400591008",
            "speakerId": 1008,
            "speakerName": "平山",
            "text": "关于这幅画像的创作理念，就让我们来采访一下白垩老师吧。",
            "nextDialogs": [
              "400591009"
            ]
          },
          "400591009": {
            "id": "400591009",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "大家好，很高兴这次能够受到邀请，绘制五歌仙的画像。",
            "nextDialogs": [
              "400591010"
            ]
          },
          "400591010": {
            "id": "400591010",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "五歌仙是稻妻古代的传说人物，他们曾经以诗歌闻名，同样也被写进诗篇，成为了许多故事的主角。",
            "nextDialogs": [
              "400591011"
            ]
          },
          "400591011": {
            "id": "400591011",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "我从现存的资料中得知，在这些故事中，「黑主」的身份是最为丰富多样的。",
            "nextDialogs": [
              "400591012"
            ]
          },
          "400591012": {
            "id": "400591012",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "而且，没有个人篇章的他，似乎却是五歌仙故事的「幕后主角」。",
            "nextDialogs": [
              "400591013"
            ]
          },
          "400591013": {
            "id": "400591013",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "或许我们可以认为，每个创作者对黑主的理解都各不相同，所以，我也想把这份想象留给大家。",
            "nextDialogs": [
              "400591014"
            ]
          },
          "400591014": {
            "id": "400591014",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "毕竟容彩祭，就是一个让大家通过创作，抒发心中所想的地方。",
            "nextDialogs": [
              "400591015"
            ]
          },
          "400591015": {
            "id": "400591015",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真不愧是阿贝多，他这样一解释，立刻就让游客们信服了。",
            "nextDialogs": [
              "400591016"
            ]
          },
          "400591016": {
            "id": "400591016",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘻嘻，这样一来，我们在这次容彩祭上的冒险，也算是圆满结束了吧。",
            "nextDialogs": [
              "400591019"
            ]
          },
          "400591019": {
            "id": "400591019",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，忘了什么？",
            "nextDialogs": [
              "400591020"
            ]
          },
          "400591020": {
            "id": "400591020",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊…啊啊啊！对啊，那个留下五歌仙故事的人，我们到现在都还没找到呢！",
            "nextDialogs": [
              "400591021"
            ]
          },
          "400591021": {
            "id": "400591021",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不过我已经有头绪了。",
            "nextDialogs": [
              "400591022"
            ]
          },
          "400591022": {
            "id": "400591022",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真的吗，快说给我听听！",
            "nextDialogs": [
              "400591023"
            ]
          },
          "400591023": {
            "id": "400591023",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "首先，对方认识我们每个人。",
            "nextDialogs": [
              "400591024"
            ]
          },
          "400591024": {
            "id": "400591024",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，你说得有道理，否则就没办法每次都能把信交给合适的人。",
            "nextDialogs": [
              "400591025"
            ]
          },
          "400591025": {
            "id": "400591025",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "而且，对方与万叶家有关联。",
            "nextDialogs": [
              "400591026"
            ]
          },
          "400591026": {
            "id": "400591026",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是哦，虽然对方一直在用故事提示我们行秋的事，可根本目的，却是为了引导我们解开万叶家的秘密…",
            "nextDialogs": [
              "400591027"
            ]
          },
          "400591027": {
            "id": "400591027",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我明白啦！留下故事的，应该就是「那个家伙」了！",
            "nextDialogs": [
              "400591028"
            ]
          },
          "400591028": {
            "id": "400591028",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "走，我们现在就去揭开真相！"
          }
        }
      }
    },
    {
      "subId": "4005911",
      "subQuestName": "找到「那个人」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400591101"
        ],
        "dialogs": {
          "400591101": {
            "id": "400591101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "绫人，留下五歌仙故事的人果然就是你了。",
            "nextDialogs": [
              "400591102"
            ]
          },
          "400591102": {
            "id": "400591102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真是太过分了，明明你跟大家都认识，却故意把我们耍得团团转！",
            "nextDialogs": [
              "400591103"
            ]
          },
          "400591103": {
            "id": "400591103",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "呵呵，其实我今天来这里的一个目的，就是想跟你们解释清这件事的来龙去脉。",
            "nextDialogs": [
              "400591104"
            ]
          },
          "400591104": {
            "id": "400591104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼，我倒要看看你怎么解释。",
            "nextDialogs": [
              "400591105"
            ]
          },
          "400591105": {
            "id": "400591105",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "首先，这件事的起因十分偶然，是八重大人在某天晚上，偶然看见行秋和编辑将书运走，觉得有趣，就提出要作弄一下他们。",
            "nextDialogs": [
              "400591106"
            ]
          },
          "400591106": {
            "id": "400591106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么，原来是神子？",
            "nextDialogs": [
              "400591107"
            ]
          },
          "400591107": {
            "id": "400591107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，不过这确实像是神子干得出来的事情…",
            "nextDialogs": [
              "400591108"
            ]
          },
          "400591108": {
            "id": "400591108",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "正是，不过后来以五歌仙故事的形式传递信息，诱导你们发现枫原家的秘密，就是我的顺水推舟了。",
            "nextDialogs": [
              "400591109"
            ]
          },
          "400591109": {
            "id": "400591109",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "而我采取这种迂回的办法，确实也有不得已之处。",
            "nextDialogs": [
              "400591110"
            ]
          },
          "400591110": {
            "id": "400591110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不得已之处？",
            "nextDialogs": [
              "400591111"
            ]
          },
          "400591111": {
            "id": "400591111",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "此前因为「某件事」，我留意到了枫原义庆留下的盆栽，和里面所藏匿的无字纸张。",
            "nextDialogs": [
              "400591112"
            ]
          },
          "400591112": {
            "id": "400591112",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "我知道这些纸肯定不简单，但还是花了一段时间，才解开上面的秘密——就是那种遇水才能显现的墨水。",
            "nextDialogs": [
              "400591113"
            ]
          },
          "400591113": {
            "id": "400591113",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "枫原义庆在信中提及之事，无论对于神里家，还是枫原家的后人都十分重要，尤其是枫原万叶。",
            "nextDialogs": [
              "400591114"
            ]
          },
          "400591114": {
            "id": "400591114",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "枫原一族曾是神里家的下属，当年我的先祖未能保护好他们，到我这里，仍有义务照拂他。",
            "nextDialogs": [
              "400591115"
            ]
          },
          "400591115": {
            "id": "400591115",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "虽说他有权知道真相，但接触秘密同样意味着接近危险。我必须确认，万叶是否有了解真相的「意愿」与「能力」。",
            "nextDialogs": [
              "400591116"
            ]
          },
          "400591116": {
            "id": "400591116",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "我当然可以将发现的事实直接告诉他，但或许他并无这种「意愿」，那这个真相对于他只会成为负担。",
            "nextDialogs": [
              "400591117"
            ]
          },
          "400591117": {
            "id": "400591117",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "同时他如果缺少相应的「能力」，就无法找到真相，如果是那样的话，还是让他远离危险比较好。",
            "nextDialogs": [
              "400591118"
            ]
          },
          "400591118": {
            "id": "400591118",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "枫原义庆，也正是考虑到这一点，才一样使用了迂回的办法留下了信息。",
            "nextDialogs": [
              "400591119"
            ]
          },
          "400591119": {
            "id": "400591119",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "很长一段时间，我都苦于没有合适的契机传达此事，直到《沉秋拾剑录》被偷偷运走的那天晚上。",
            "nextDialogs": [
              "400591120"
            ]
          },
          "400591120": {
            "id": "400591120",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来如此…",
            "nextDialogs": [
              "400591121"
            ]
          },
          "400591121": {
            "id": "400591121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那其他人被拉进来的意义呢？",
            "nextDialogs": [
              "400591122"
            ]
          },
          "400591122": {
            "id": "400591122",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦，不仅是万叶，你把我们都拉进了你的计划里。",
            "nextDialogs": [
              "400591123"
            ]
          },
          "400591123": {
            "id": "400591123",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "呵呵呵，看来果然瞒不过你的眼睛。",
            "nextDialogs": [
              "400591124"
            ]
          },
          "400591124": {
            "id": "400591124",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "我判断知道这件事对你们也有不小的价值。",
            "nextDialogs": [
              "400591125"
            ]
          },
          "400591125": {
            "id": "400591125",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "当然更重要的是，我希望万叶与绫华在找到真相的时候，身边能有一群可靠的朋友。",
            "nextDialogs": [
              "400591126"
            ]
          },
          "400591126": {
            "id": "400591126",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "这些人愿意守护他们做出冷静的决定，同样，也会在他们遇到困难时不遗余力地伸出援手。",
            "nextDialogs": [
              "400591127"
            ]
          },
          "400591127": {
            "id": "400591127",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "因为你们很有可能，将来会面对相同的敌人。",
            "nextDialogs": [
              "400591128"
            ]
          },
          "400591128": {
            "id": "400591128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「国崩」究竟是谁？",
            "nextDialogs": [
              "400591129"
            ]
          },
          "400591129": {
            "id": "400591129",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "其实你心里已经有答案了，不是吗？",
            "nextDialogs": [
              "400591130"
            ]
          },
          "400591130": {
            "id": "400591130",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "而且这个答案，就埋藏在那幅「黑主」的画像中。",
            "nextDialogs": [
              "400591131"
            ]
          },
          "400591131": {
            "id": "400591131",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "等到画像附近没人的时候，你可以用自己的眼睛去确认。",
            "nextDialogs": [
              "400591132"
            ]
          },
          "400591132": {
            "id": "400591132",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "至于让那个真相显露的办法…你们之前，也已经用过很多次了。"
          }
        }
      }
    },

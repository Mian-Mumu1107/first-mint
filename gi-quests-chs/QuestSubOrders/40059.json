  },
  "subQuests": [
    {
      "subId": "4005901",
      "subQuestName": "返回五歌仙广场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400590101"
        ],
        "dialogs": {
          "400590101": {
            "id": "400590101",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "#{NICKNAME}，派蒙，你们好啊。",
            "nextDialogs": [
              "400590102"
            ]
          },
          "400590102": {
            "id": "400590102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "阿贝多，说起来最后一幅黑主的画像怎么被盖住了呀，我还想看看你画的黑主究竟长什么样子呢。",
            "nextDialogs": [
              "400590103"
            ]
          },
          "400590103": {
            "id": "400590103",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "别着急，再过一会儿会举行画像的揭幕式，到时候你们就能知道了。",
            "nextDialogs": [
              "400590104"
            ]
          },
          "400590104": {
            "id": "400590104",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "这幅画可是我的得意之作，为了完成它，我还专程拜访了一个人。对方给我提供了非常宝贵的建议。",
            "nextDialogs": [
              "400590107"
            ]
          },
          "400590107": {
            "id": "400590107",
            "speakerId": 1000,
            "speakerName": "阿贝多",
            "text": "呵呵，有吗？总之距离揭幕还有段时间，你们先在会场上逛逛吧。"
          }
        }
      }
    },
    {
      "subId": "4005902",

      }
    },
    {
      "subId": "4005914",
      "subQuestName": "调查黑主的画像",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400591501"
        ],
        "dialogs": {
          "400591501": {
            "id": "400591501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "夜深了，现在周围已经没有人了。",
            "nextDialogs": [
              "400591502"
            ]
          },
          "400591502": {
            "id": "400591502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "绫人说的那个用过很多次的办法，一定就是指把水洒在这幅画上吧？",
            "nextDialogs": [
              "400591503"
            ]
          },
          "400591503": {
            "id": "400591503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "画面上的人…是散兵！",
            "nextDialogs": [
              "400591504"
            ]
          },
          "400591504": {
            "id": "400591504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "果然他就是当年的幕后黑手！",
            "nextDialogs": [
              "400591530"
            ]
          },
          "400591530": {
            "id": "400591530",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "…等到画像附近没人的时候，你可以用自己的眼睛去确认。",
            "nextDialogs": [
              "400591531"
            ]
          },
          "400591531": {
            "id": "400591531",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "至于让那个真相显露的办法…你们之前，也已经用过很多次了。",
            "nextDialogs": [
              "400591505"
            ]
          },
          "400591505": {
            "id": "400591505",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "…最后，我们还有一件事需要谈谈。",
            "nextDialogs": [
              "400591506"
            ]
          },
          "400591506": {
            "id": "400591506",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "我之前提到，「某件事」的发生让我留意到盆栽的存在，现在要讲的就是那件事。",
            "nextDialogs": [
              "400591507"
            ]
          },
          "400591507": {
            "id": "400591507",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "那是将军刚刚宣布废除锁国令之后，我听说天领奉行那里发生了一起案件。",
            "nextDialogs": [
              "400591508"
            ]
          },
          "400591508": {
            "id": "400591508",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "保管证物与查抄得来赃物的仓库有窃贼进入的痕迹，不过却什么东西都没有丢失。",
            "nextDialogs": [
              "400591509"
            ]
          },
          "400591509": {
            "id": "400591509",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "我觉得这起案件并不寻常，于是告诉天领奉行的九条裟罗，暂时当做无事发生，不要加强戒备或将仓库换地方。",
            "nextDialogs": [
              "400591510"
            ]
          },
          "400591510": {
            "id": "400591510",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "而我则派终末番的人在旁边盯梢，果然发现有个人潜入到仓库中，翻找枫原家的东西。",
            "nextDialogs": [
              "400591511"
            ]
          },
          "400591511": {
            "id": "400591511",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难道说，他也是在找…",
            "nextDialogs": [
              "400591512"
            ]
          },
          "400591512": {
            "id": "400591512",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "我放任他翻找了一段时间，最后他一无所获，只得乘船离开了稻妻。",
            "nextDialogs": [
              "400591513"
            ]
          },
          "400591513": {
            "id": "400591513",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你为什么不派人抓住他呀？",
            "nextDialogs": [
              "400591514"
            ]
          },
          "400591514": {
            "id": "400591514",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "呵呵，保护一个秘密的最好办法，就是当做这个秘密并不存在，不是吗？而且这个人的身份也并不难猜测。",
            "nextDialogs": [
              "400591515"
            ]
          },
          "400591515": {
            "id": "400591515",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "在他离开稻妻后，我就认真逐件检查了枫原家的物品，终于在那个花盆的夹层里，看到了那几张纸。",
            "nextDialogs": [
              "400591516"
            ]
          },
          "400591516": {
            "id": "400591516",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "我确信这些纸，就是潜入者想要寻找的「秘密」，虽然他或许也并不能确定这个「秘密」真的存在。",
            "nextDialogs": [
              "400591517"
            ]
          },
          "400591517": {
            "id": "400591517",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "那么接下来，就是我的最后一个问题了——",
            "nextDialogs": [
              "400591518"
            ]
          },
          "400591518": {
            "id": "400591518",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "枫原义庆所写的那段经历中，究竟哪一部分才是真正需要被保守的秘密呢？",
            "nextDialogs": [
              "400591522"
            ]
          },
          "400591522": {
            "id": "400591522",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "呵呵呵，这个问题，我现在也没有答案，就把它留给未来的你好了。",
            "nextDialogs": [
              "400591523"
            ]
          },
          "400591523": {
            "id": "400591523",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "至于现在，就好好享受容彩祭吧。"
          }
        }
      }
    },

      }
    },
    {
      "subId": "4005903",
      "subQuestName": "在会场附近寻找朋友们",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400595101"
        ],
        "dialogs": {
          "400595101": {
            "id": "400595101",
            "speakerId": 1002,
            "speakerName": "行秋",
            "text": "#{NICKNAME}，派蒙，你们来了。",
            "nextDialogs": [
              "400595102"
            ]
          },
          "400595102": {
            "id": "400595102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "今天的签售顺利吗？",
            "nextDialogs": [
              "400595103"
            ]
          },
          "400595103": {
            "id": "400595103",
            "speakerId": 1002,
            "speakerName": "行秋",
            "text": "嗯，多亏了你们，签售会进行得非常顺利，读者们也都很满意。",
            "nextDialogs": [
              "400595104"
            ]
          },
          "400595104": {
            "id": "400595104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "行秋，是我的错觉吗，我怎么觉得你一直在东张西望啊。",
            "nextDialogs": [
              "400595105"
            ]
          },
          "400595105": {
            "id": "400595105",
            "speakerId": 1002,
            "speakerName": "行秋",
            "text": "并不是错觉，说来惭愧，其实我一直在提防着有璃月游客靠近。",
            "nextDialogs": [
              "400595106"
            ]
          },
          "400595106": {
            "id": "400595106",
            "speakerId": 1002,
            "speakerName": "行秋",
            "text": "我毕竟是以考察商品的名头来了稻妻，若是被认得我的人看见我坐在这里，我爹那边可就瞒不住了。",
            "nextDialogs": [
              "400595107"
            ]
          },
          "400595107": {
            "id": "400595107",
            "speakerId": 1002,
            "speakerName": "行秋",
            "text": "幸好今天来排队买书的读者众多，一般游客不会靠近这边。",
            "nextDialogs": [
              "400595108"
            ]
          },
          "400595108": {
            "id": "400595108",
            "speakerId": 1002,
            "speakerName": "行秋",
            "text": "对了，其实阿旭也不知道我此行的真正目的。你们若是见了他，可要记得替我保密。",
            "nextDialogs": [
              "400595109"
            ]
          },
          "400595109": {
            "id": "400595109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好，放心吧。",
            "nextDialogs": [
              "400595110"
            ]
          },
          "400595110": {
            "id": "400595110",
            "speakerId": 1002,
            "speakerName": "行秋",
            "text": "那我先谢过你们啦。抱歉，现在不能陪你们聊太久，后面还有读者在等。",
            "nextDialogs": [
              "400595111"
            ]
          },
          "400595111": {
            "id": "400595111",
            "speakerId": 1002,
            "speakerName": "行秋",
            "text": "待会儿就在黑主画像的揭幕仪式上再见吧。"
          }
        }
      }
    },
    {
      "subId": "4005904",
      "subQuestName": "在会场附近寻找朋友们",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400595201"
        ],
        "dialogs": {
          "400595201": {
            "id": "400595201",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "旅行者，派蒙，你们好。",
            "nextDialogs": [
              "400595202"
            ]
          },
          "400595202": {
            "id": "400595202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，绫人，今天总算又见到你这个大忙人了。",
            "nextDialogs": [
              "400595203"
            ]
          },
          "400595203": {
            "id": "400595203",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "这些天事情太多，实在是脱不开身。",
            "nextDialogs": [
              "400595204"
            ]
          },
          "400595204": {
            "id": "400595204",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "不过所幸容彩祭一切顺利，三奉行在此次祭典上也合作顺畅，今天总算能稍作休息了。",
            "nextDialogs": [
              "400595205"
            ]
          },
          "400595205": {
            "id": "400595205",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "二位，我和兄长都很感谢你们的帮助。",
            "nextDialogs": [
              "400595206"
            ]
          },
          "400595206": {
            "id": "400595206",
            "speakerId": 1003,
            "speakerName": "神里绫人",
            "text": "嗯，托马还真是慢啊…",
            "nextDialogs": [
              "400595207"
            ]
          },
          "400595207": {
            "id": "400595207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在等托马？",
            "nextDialogs": [
              "400595208"
            ]
          },
          "400595208": {
            "id": "400595208",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "对。难得兄长说今天不忙，要带我去买书，但他却把钱包忘在了家里，于是就只好让托马回去取了。",
            "nextDialogs": [
              "400595209"
            ]
          },
          "400595209": {
            "id": "400595209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没想到绫人也会有粗心大意的时候。",
            "nextDialogs": [
              "400595210"
            ]
          },
          "400595210": {
            "id": "400595210",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "呵呵，兄长平日里总是殚精竭虑，难得能离开公务放松下来。",
            "nextDialogs": [
              "400595211"
            ]
          },
          "400595211": {
            "id": "400595211",
            "speakerId": 1004,
            "speakerName": "神里绫华",
            "text": "所以，这种偶尔的粗心大意，对于我和托马来说，反而很可贵呢。"
          }
        }
      }
    },
    {
      "subId": "4005905",
      "subQuestName": "在会场附近寻找朋友们",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400595301"
        ],
        "dialogs": {
          "400595301": {
            "id": "400595301",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "小家伙们，你们好呀。",
            "nextDialogs": [
              "400595302"
            ]
          },
          "400595302": {
            "id": "400595302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你们两个怎么会凑在一起！而且刚才明明聊得热火朝天，看到我们靠近，就突然不说话了。",
            "nextDialogs": [
              "400595303"
            ]
          },
          "400595303": {
            "id": "400595303",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "哎呀，那只是你们的错觉啦。",
            "nextDialogs": [
              "400595304"
            ]
          },
          "400595304": {
            "id": "400595304",
            "speakerId": 1006,
            "speakerName": "温迪",
            "text": "我们只是在说下酒菜的话题，你们也不感兴趣嘛。",
            "nextDialogs": [
              "400595305"
            ]
          },
          "400595305": {
            "id": "400595305",
            "speakerId": 1005,
            "speakerName": "八重神子",
            "text": "嗯，说到下酒菜啊，油豆腐我觉得就不错呢…",
            "nextDialogs": [
              "400595306"
            ]
          },
          "400595306": {
            "id": "400595306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "算了算了，就算这两个人凑在一起密谋什么，也不会让我们知道的。"
          }
        }
      }
    },
    {
      "subId": "4005906",
      "subQuestName": "在会场附近寻找朋友们",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400595401"
        ],
        "dialogs": {
          "400595401": {
            "id": "400595401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "万叶，你没有去会场，怎么在这里呀？",
            "nextDialogs": [
              "400595402"
            ]
          },
          "400595402": {
            "id": "400595402",
            "speakerId": 1007,
            "speakerName": "枫原万叶",
            "text": "我来这里吹吹海风。会场上那种热闹的气氛，果然还是不太适合我。",
            "nextDialogs": [
              "400595403"
            ]
          },
          "400595403": {
            "id": "400595403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "万叶，你真的不要紧吗？",
            "nextDialogs": [
              "400595404"
            ]
          },
          "400595404": {
            "id": "400595404",
            "speakerId": 1007,
            "speakerName": "枫原万叶",
            "text": "呵，果然你们还是在担心我。",
            "nextDialogs": [
              "400595405"
            ]
          },
          "400595405": {
            "id": "400595405",
            "speakerId": 1007,
            "speakerName": "枫原万叶",
            "text": "谢谢你们。放心吧，我之前在大家面前说的那些话并不是托词。",
            "nextDialogs": [
              "400595406"
            ]
          },
          "400595406": {
            "id": "400595406",
            "speakerId": 1007,
            "speakerName": "枫原万叶",
            "text": "你们看，眼前这座熟悉的港口，它曾经终日不见船舶靠岸，只有勘定奉行的役人戒备着不速之客。",
            "nextDialogs": [
              "400595407"
            ]
          },
          "400595407": {
            "id": "400595407",
            "speakerId": 1007,
            "speakerName": "枫原万叶",
            "text": "但现在，这里却热闹了许多。",
            "nextDialogs": [
              "400595408"
            ]
          },
          "400595408": {
            "id": "400595408",
            "speakerId": 1007,
            "speakerName": "枫原万叶",
            "text": "不仅有从其他国家来稻妻的外国人，海祇岛和这里的往来也频繁了起来。",
            "nextDialogs": [
              "400595409"
            ]
          },
          "400595409": {
            "id": "400595409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是呀，现在的稻妻，已经和过去不同了呢。",
            "nextDialogs": [
              "400595410"
            ]
          },
          "400595410": {
            "id": "400595410",
            "speakerId": 1007,
            "speakerName": "枫原万叶",
            "text": "我想，或许我们每个人，也都像这个国度一样。",
            "nextDialogs": [
              "400595411"
            ]
          },
          "400595411": {
            "id": "400595411",
            "speakerId": 1007,
            "speakerName": "枫原万叶",
            "text": "即使需要花费的时间不同，但身上的那副重担总有能够放下的一天。",
            "nextDialogs": [
              "400595412"
            ]
          },
          "400595412": {
            "id": "400595412",
            "speakerId": 1007,
            "speakerName": "枫原万叶",
            "text": "而你真正放下之时，就能随风而行。"
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "2003401",
      "subQuestName": "与安娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200340101"
        ],
        "dialogs": {
          "200340101": {
            "id": "200340101",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "好…今天也要努力完成委托！",
            "nextDialogs": [
              "200340103",
              "200340107"
            ]
          },
          "200340103": {
            "id": "200340103",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "那是当然了，做冒险家可是很有趣的。",
            "nextDialogs": [
              "200340104"
            ]
          },
          "200340104": {
            "id": "200340104",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "不过…嘿嘿，我执行委托的时候，还是有很多事不熟悉。",
            "nextDialogs": [
              "200340105"
            ]
          },
          "200340105": {
            "id": "200340105",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "旅行者，能请你再陪我去执行一下委托吗？我还有事想要请教你。",
            "nextDialogs": [
              "200340108"
            ]
          },
          "200340108": {
            "id": "200340108",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "那我们就快出发吧，今天的委托是…",
            "nextDialogs": [
              "200340109"
            ]
          },
          "200340109": {
            "id": "200340109",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "嗯…又是护送货运热气球…"
          },
          "200340107": {
            "id": "200340107",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "可以吗？嘿嘿，我正好有很多事想要请教你呢。"
          }
        }
      }
    },
    {
      "subId": "2003402",
      "subQuestName": "与安娜一同完成冒险家协会的委托",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200340201"
        ],
        "dialogs": {
          "200340201": {
            "id": "200340201",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "菲谢尔，你刚才跑得太快了，很危险的…",
            "nextDialogs": [
              "200340202"
            ]
          },
          "200340202": {
            "id": "200340202",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "本皇女的圣裁之雷，绝不会放任邪孽滋长…",
            "nextDialogs": [
              "200340203"
            ]
          },
          "200340203": {
            "id": "200340203",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "是菲谢尔前辈，还有班尼特前辈，你们好！",
            "nextDialogs": [
              "200340204"
            ]
          },
          "200340204": {
            "id": "200340204",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "是安娜啊，还有旅行者，你们是在这里执行协会的委托吗？",
            "nextDialogs": [
              "200340205"
            ]
          },
          "200340205": {
            "id": "200340205",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "喔！本皇女的祝圣之人啊，想来是命运的丝线，将你引至此地。",
            "nextDialogs": [
              "200340206"
            ]
          },
          "200340206": {
            "id": "200340206",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "小姐很意外会在这种地方见到你，她很高兴。",
            "nextDialogs": [
              "200340207"
            ]
          },
          "200340207": {
            "id": "200340207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我是陪着安娜出来执行委托的。",
            "nextDialogs": [
              "200340208"
            ]
          },
          "200340208": {
            "id": "200340208",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "是的，我和旅行者正在这里护送货运热气球呢。",
            "nextDialogs": [
              "200340209"
            ]
          },
          "200340209": {
            "id": "200340209",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "可是，突然看见有一群盗宝团朝我们冲了过来…",
            "nextDialogs": [
              "200340210"
            ]
          },
          "200340210": {
            "id": "200340210",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "抱歉抱歉，这都要怪我…",
            "nextDialogs": [
              "200340211"
            ]
          },
          "200340211": {
            "id": "200340211",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "原本我和菲谢尔接了委托，要追查一群盗宝团的下落…",
            "nextDialogs": [
              "200340212"
            ]
          },
          "200340212": {
            "id": "200340212",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "奥兹好不容易捕捉了对方的去向，我们正准备去捉拿的时候…我被路上的树枝绊倒，一下子就摔了出去…",
            "nextDialogs": [
              "200340213"
            ]
          },
          "200340213": {
            "id": "200340213",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "这伙盗宝团发现动静，掉头就跑，我们只能在后面一直追、一直追…",
            "nextDialogs": [
              "200340214"
            ]
          },
          "200340214": {
            "id": "200340214",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "无须烦忧。苍紫的罚罪之光，注定裁断恶徒的命运。",
            "nextDialogs": [
              "200340215"
            ]
          },
          "200340215": {
            "id": "200340215",
            "speakerId": 1003,
            "speakerName": "奥兹",
            "text": "但小姐，真正出手抓住恶徒的，是旅行者…",
            "nextDialogs": [
              "200340216"
            ]
          },
          "200340216": {
            "id": "200340216",
            "speakerId": 1002,
            "speakerName": "菲谢尔",
            "text": "奥，奥兹！",
            "nextDialogs": [
              "200340217"
            ]
          },
          "200340217": {
            "id": "200340217",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "话，话说回来，这次真要好好谢谢你们了，多亏有你们在前面拦着！",
            "nextDialogs": [
              "200340218"
            ]
          },
          "200340218": {
            "id": "200340218",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "看来，我今天的运气还是挺好的嘛。",
            "nextDialogs": [
              "200340219"
            ]
          },
          "200340219": {
            "id": "200340219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能帮上忙就好。",
            "nextDialogs": [
              "200340220"
            ]
          },
          "200340220": {
            "id": "200340220",
            "speakerId": 1001,
            "speakerName": "班尼特",
            "text": "嘿嘿，那我们先带着这群盗宝团回协会去了，你们执行委托路上也要小心啊，尤其是注意脚下！"
          }
        }
      }
    },
    {
      "subId": "2003403",
      "subQuestName": "与安娜一同完成冒险家协会的委托",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200340301"
        ],
        "dialogs": {
          "200340301": {
            "id": "200340301",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "班尼特前辈，还是一如既往地可靠呢。",
            "nextDialogs": [
              "200340302"
            ]
          },
          "200340302": {
            "id": "200340302",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "菲谢尔前辈…她说的话也一如既往地很有气势！",
            "nextDialogs": [
              "200340304",
              "200340309"
            ]
          },
          "200340304": {
            "id": "200340304",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "你说班尼特前辈？",
            "nextDialogs": [
              "200340305"
            ]
          },
          "200340305": {
            "id": "200340305",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "我刚进入协会的时候，班尼特前辈给我解答了很多问题，也帮了我不少忙。",
            "nextDialogs": [
              "200340306"
            ]
          },
          "200340306": {
            "id": "200340306",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "但我听说，班尼特前辈的运气一直很差。",
            "nextDialogs": [
              "200340307"
            ]
          },
          "200340307": {
            "id": "200340307",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "真是不公平啊，明明是那么好的人…",
            "nextDialogs": [
              "200340313"
            ]
          },
          "200340313": {
            "id": "200340313",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "呼…这样子委托也完成了，谢谢你旅行者，我这就回去协会报告啦。",
            "nextDialogs": [
              "200340314"
            ]
          },
          "200340314": {
            "id": "200340314",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "不过，为什么我连续几天都是在护送热气球…协会里没有别的委托了吗…"
          },
          "200340309": {
            "id": "200340309",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "菲谢尔前辈…嗯…",
            "nextDialogs": [
              "200340310"
            ]
          },
          "200340310": {
            "id": "200340310",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "她、她也很可靠喔！箭法很好，也执行过很多委托。",
            "nextDialogs": [
              "200340311"
            ]
          },
          "200340311": {
            "id": "200340311",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "虽然她说的那些话…我不太能听懂…",
            "nextDialogs": [
              "200340312"
            ]
          },
          "200340312": {
            "id": "200340312",
            "speakerId": 1000,
            "speakerName": "安娜",
            "text": "但她也是一位…一位很有经验的冒险家！不、不对，调查员！"
          }
        }
      }
    },
    {
      "subId": "2003404",
      "subQuestName": "击退盗宝团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200340401"
        ],
        "dialogs": {
          "200340401": {
            "id": "200340401",
            "speakerId": 1004,
            "speakerName": "安东尼",
            "text": "旅行者，还请你多照顾一下安娜，这孩子最近好像兴奋过头了…",
            "nextDialogs": [
              "200340402"
            ]
          },
          "200340402": {
            "id": "200340402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不希望她做冒险家吗？",
            "nextDialogs": [
              "200340403"
            ]
          },
          "200340403": {
            "id": "200340403",
            "speakerId": 1004,
            "speakerName": "安东尼",
            "text": "……",
            "nextDialogs": [
              "200340404"
            ]
          },
          "200340404": {
            "id": "200340404",
            "speakerId": 1004,
            "speakerName": "安东尼",
            "text": "我尊重我妹妹的梦想。",
            "nextDialogs": [
              "200340405"
            ]
          },
          "200340405": {
            "id": "200340405",
            "speakerId": 1004,
            "speakerName": "安东尼",
            "text": "她的病好不容易痊愈了，也得到了追逐自己梦想的机会。",
            "nextDialogs": [
              "200340406"
            ]
          },
          "200340406": {
            "id": "200340406",
            "speakerId": 1004,
            "speakerName": "安东尼",
            "text": "作为她的哥哥，我…会全力支持她。",
            "nextDialogs": [
              "200340407"
            ]
          },
          "200340407": {
            "id": "200340407",
            "speakerId": 1004,
            "speakerName": "安东尼",
            "text": "就这样。"
          }
        }
      }
    },

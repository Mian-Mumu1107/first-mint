      }
    },
    {
      "subId": "7304203",
      "subQuestName": "与兰犍多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730420501"
        ],
        "dialogs": {
          "730420501": {
            "id": "730420501",
            "speakerId": 4197,
            "speakerName": "兰犍多",
            "text": "那菈没有「赢」…不过没关系，兰犍多愿意再和那菈玩！"
          }
        }
      }
    },
    {
      "subId": "7304204",
      "subQuestName": "与兰犍多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730420601"
        ],
        "dialogs": {
          "730420601": {
            "id": "730420601",
            "speakerId": 4197,
            "speakerName": "兰犍多",
            "text": "玩得真开心！和金色的那菈玩游戏，兰犍多太高兴了！而且，那菈好快、好厉害，就和真正的长鬓虎一样！",
            "nextDialogs": [
              "730420602"
            ]
          },
          "730420602": {
            "id": "730420602",
            "speakerId": 4197,
            "speakerName": "兰犍多",
            "text": "和其他兰那罗、真正的长鬓虎一起玩也开心，但是和新朋友，那菈朋友一起玩，有更多开心！",
            "nextDialogs": [
              "730420603"
            ]
          },
          "730420603": {
            "id": "730420603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么长鬓虎要追兰那罗？",
            "nextDialogs": [
              "730420604"
            ]
          },
          "730420604": {
            "id": "730420604",
            "speakerId": 4197,
            "speakerName": "兰犍多",
            "text": "长鬓虎和兰那罗都是朋友，朋友就会一起玩。不过，兰犍多发现，那菈会害怕长鬓虎。所以，为了无忧节，想了新的游戏！",
            "nextDialogs": [
              "730420605"
            ]
          },
          "730420605": {
            "id": "730420605",
            "speakerId": 4197,
            "speakerName": "兰犍多",
            "text": "谢谢你，那菈。兰那罗的花花，送给金色的那菈！"
          }
        }
      }
    },
    {
      "subId": "7304201",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730420101"
        ],
        "dialogs": {
          "730420101": {
            "id": "730420101",
            "speakerId": 4197,
            "speakerName": "兰犍多",
            "text": "金色的那菈，兰犍多听说了好多好多你的事情。你是个好那菈，愿意和兰犍多玩游戏吗？",
            "nextDialogs": [
              "730420102"
            ]
          },
          "730420102": {
            "id": "730420102",
            "speakerId": 4197,
            "speakerName": "兰犍多",
            "text": "兰犍多的游戏简单，好玩！给那菈讲讲「规则」…",
            "nextDialogs": [
              "730420103"
            ]
          },
          "730420103": {
            "id": "730420103",
            "speakerId": 4197,
            "speakerName": "兰犍多",
            "text": "兰犍多会变出好多好多的草微粒，是「兰那罗」，藏在圈里。那菈是又大又厉害的「长鬓虎」，来追「兰那罗」！",
            "nextDialogs": [
              "730420104"
            ]
          },
          "730420104": {
            "id": "730420104",
            "speakerId": 4197,
            "speakerName": "兰犍多",
            "text": "在「一小会儿」里，如果「长鬓虎」追上所有「兰那罗」，就算那菈「赢」！",
            "nextDialogs": [
              "730420105"
            ]
          },
          "730420105": {
            "id": "730420105",
            "speakerId": 4197,
            "speakerName": "兰犍多",
            "text": "怎么样？那菈愿意现在和兰犍多玩游戏吗？"
          }
        }
      }
    },

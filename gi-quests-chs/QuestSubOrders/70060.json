      "dialogue": {
        "startDialogs": [
          "700600101"
        ],
        "dialogs": {
          "700600101": {
            "id": "700600101",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哟，荣誉骑士，有阵子不见，你也来度假村了。在忙什么呢？",
            "nextDialogs": [
              "700600104"
            ]
          },
          "700600104": {
            "id": "700600104",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哦，留影吗？的确是度假必备的环节。",
            "nextDialogs": [
              "700600105"
            ]
          },
          "700600105": {
            "id": "700600105",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "好不容易来纳塔一趟，我还没来得及好好逛，喝完这杯我也去找些合适的景点留影好了。",
            "nextDialogs": [
              "700600106"
            ]
          },
          "700600106": {
            "id": "700600106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一起吧。",
            "nextDialogs": [
              "700600107"
            ]
          },
          "700600107": {
            "id": "700600107",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "当然可以。仔细一想，这个露天酒吧的装潢品味倒是不错，待会儿可以直接在这里留影。",
            "nextDialogs": [
              "700600108"
            ]
          },
          "700600108": {
            "id": "700600108",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "吧台既宽敞又舒适，适合一边品酒一边眺望远处的风景，顺带吹吹风。",
            "nextDialogs": [
              "700600109"
            ]
          },
          "700600109": {
            "id": "700600109",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "这样一说，「天使的馈赠」露天位的装修风格有些简约，我们该给那位酒庄老板提提建议。",
            "nextDialogs": [
              "700600110"
            ]
          },
          "700600110": {
            "id": "700600110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就用画片说话吧。",
            "nextDialogs": [
              "700600111"
            ]
          },
          "700600111": {
            "id": "700600111",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "好主意，那可得选个好角度。",
            "nextDialogs": [
              "700600112"
            ]
          },
          "700600112": {
            "id": "700600112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "放心，我很专业。",
            "nextDialogs": [
              "700600113"
            ]
          },
          "700600113": {
            "id": "700600113",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哈哈，我相信你的意见，那就来吧。",
            "nextDialogs": [
              "700600114"
            ]
          },
          "700600114": {
            "id": "700600114",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "对了，既然我也得入镜，你觉得什么姿势比较好。"
          }
        }
      }
    }
  ]

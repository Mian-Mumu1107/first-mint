  },
  "subQuests": [
    {
      "subId": "7310416",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731041601"
        ],
        "dialogs": {
          "731041601": {
            "id": "731041601",
            "speakerId": 21162,
            "speakerName": "凯万",
            "text": "唉，请你们快去解决掉那些史莱姆吧…"
          }
        }
      }
    },
    {
      "subId": "7310417",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731041701"
        ],
        "dialogs": {
          "731041701": {
            "id": "731041701",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "这是最后一件文物了。辛苦你们找找材料，帮凯万先生完成这一钓吧。"
          }
        }
      }
    },
    {
      "subId": "7310401",
      "subQuestName": "与荷贝特和凯万对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731040101"
        ],
        "dialogs": {
          "731040101": {
            "id": "731040101",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "你就通融一下嘛，我是真心来求你办事的！",
            "nextDialogs": [
              "731040102"
            ]
          },
          "731040102": {
            "id": "731040102",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "没什么好说的，我不能让步，请回吧。",
            "nextDialogs": [
              "731040103"
            ]
          },
          "731040103": {
            "id": "731040103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊，这两人怎么吵起来了？",
            "nextDialogs": [
              "731040104"
            ]
          },
          "731040104": {
            "id": "731040104",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "哟，异乡人，能帮我说服这位小姐吗？",
            "nextDialogs": [
              "731040105"
            ]
          },
          "731040105": {
            "id": "731040105",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "今天她突然找过来，一直缠着我，说是想让我帮忙钓一批古董。",
            "nextDialogs": [
              "731040106"
            ]
          },
          "731040106": {
            "id": "731040106",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "吓跑了我的鱼不说，还想占用我接下来的时间。",
            "nextDialogs": [
              "731040107"
            ]
          },
          "731040107": {
            "id": "731040107",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "我说啊小姐，你这么心急，难道是想借这批古董发财？",
            "nextDialogs": [
              "731040108"
            ]
          },
          "731040108": {
            "id": "731040108",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "不是的，凯万先生，我是教令院合作方的雇员荷贝特。",
            "nextDialogs": [
              "731040109"
            ]
          },
          "731040109": {
            "id": "731040109",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "那些古董都是教令院搜集来用做研究的，我负责管理它们。",
            "nextDialogs": [
              "731040110"
            ]
          },
          "731040110": {
            "id": "731040110",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "但就在昨天，运输文物的小船出了点意外，有几件文物掉进了河里，被水流冲到了下游来。",
            "nextDialogs": [
              "731040111"
            ]
          },
          "731040111": {
            "id": "731040111",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "那你去找专业的捕捞队啊！你找我一个钓鱼的人干嘛？",
            "nextDialogs": [
              "731040112"
            ]
          },
          "731040112": {
            "id": "731040112",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "找捕捞队就太慢了，我之前听人介绍说，「鱼钩上的绝景」凯万先生几乎每天都能钓到失物…",
            "nextDialogs": [
              "731040113"
            ]
          },
          "731040113": {
            "id": "731040113",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "而且你也经常在这片流域钓鱼，所以我想要请你下杆，看看能不能把文物给…",
            "nextDialogs": [
              "731040117",
              "731040116"
            ]
          },
          "731040117": {
            "id": "731040117",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "咳咳，荷贝特小姐，我对你的遭遇表示同情，但我只是一个钓鱼的人。",
            "nextDialogs": [
              "731040118"
            ]
          },
          "731040118": {
            "id": "731040118",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "我下杆只为了钓鱼，也只可能钓上来鱼…",
            "nextDialogs": [
              "731040119"
            ]
          },
          "731040119": {
            "id": "731040119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "明明一条鱼都没钓上来过…",
            "nextDialogs": [
              "731040120"
            ]
          },
          "731040120": {
            "id": "731040120",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "咳！我一直抱着这样的想法练习钓鱼的技巧，从没想过用这门本领干别的事。",
            "nextDialogs": [
              "731040121"
            ]
          },
          "731040121": {
            "id": "731040121",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "所以你还是去请其他人比较好。",
            "nextDialogs": [
              "731040122"
            ]
          },
          "731040122": {
            "id": "731040122",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "欸…欸？",
            "nextDialogs": [
              "731040123"
            ]
          },
          "731040123": {
            "id": "731040123",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "那不然…这样好了，我不求你帮我钓到失物，只需要你换个地方钓鱼，可以吗？",
            "nextDialogs": [
              "731040124"
            ]
          },
          "731040124": {
            "id": "731040124",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "你就当…就当是我付钱请你钓鱼啦！拜托你了，拜托你了！",
            "nextDialogs": [
              "731040125"
            ]
          },
          "731040125": {
            "id": "731040125",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "我说你们啊，我可是一个渔夫啊！渔夫！"
          },
          "731040116": {
            "id": "731040116",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "我下杆只是为了钓到大鱼好吗！？"
          }
        }
      }
    },
    {
      "subId": "7310402",

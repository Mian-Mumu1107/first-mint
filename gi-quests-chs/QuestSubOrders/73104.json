    {
      "subId": "7310406",
      "subQuestName": "将鱼饵的材料交给凯万",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731040601"
        ],
        "dialogs": {
          "731040601": {
            "id": "731040601",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "你们回来了。找到特别材料了吗？"
          }
        }
      }
    },
    {
      "subId": "7310407",
      "subQuestName": "与荷贝特和凯万对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731040701"
        ],
        "dialogs": {
          "731040701": {
            "id": "731040701",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "好了，今天的第二钓开始了。",
            "nextDialogs": [
              "731040702"
            ]
          },
          "731040702": {
            "id": "731040702",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "我要集中精力，请你们别发出声音…",
            "nextDialogs": [
              "731040703"
            ]
          },
          "731040703": {
            "id": "731040703",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "凯万凝神开始了垂钓…",
            "nextDialogs": [
              "731040704"
            ]
          },
          "731040704": {
            "id": "731040704",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "呜啊！看，看那边！好多史莱姆！",
            "nextDialogs": [
              "731040705"
            ]
          },
          "731040705": {
            "id": "731040705",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "哈？！我之前可没遇见过这种情况啊！",
            "nextDialogs": [
              "731040708"
            ]
          },
          "731040708": {
            "id": "731040708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么凯万先生的钓鱼历程，会遇见这么多麻烦啊…"
          }
        }
      }
    },
    {
      "subId": "7310408",
      "subQuestName": "击退突然出现的魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7310409",
      "subQuestName": "与荷贝特和凯万对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731040901"
        ],
        "dialogs": {
          "731040901": {
            "id": "731040901",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "你们可真厉害，幸亏有你们！",
            "nextDialogs": [
              "731040902"
            ]
          },
          "731040902": {
            "id": "731040902",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "等到找回了所有的文物，我会再申请一笔酬金，用来感谢你们。",
            "nextDialogs": [
              "731040903"
            ]
          },
          "731040903": {
            "id": "731040903",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "你真以为我钓不上真正的大鱼…",
            "nextDialogs": [
              "731040904"
            ]
          },
          "731040904": {
            "id": "731040904",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "等等，有大鱼上钩了！",
            "nextDialogs": [
              "731040905"
            ]
          },
          "731040905": {
            "id": "731040905",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "凯万用力提起了钓竿…",
            "nextDialogs": [
              "731040906"
            ]
          },
          "731040906": {
            "id": "731040906",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "这又是…什么东西…",
            "nextDialogs": [
              "731040907"
            ]
          },
          "731040907": {
            "id": "731040907",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "啊，这是另外一个文物的包裹！太好了！",
            "nextDialogs": [
              "731040908"
            ]
          },
          "731040908": {
            "id": "731040908",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "没想到会这么顺利，一下子就找回了两件文物！不愧是你呀，凯万先生！",
            "nextDialogs": [
              "731040909"
            ]
          },
          "731040909": {
            "id": "731040909",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "…我就不该说那句话。",
            "nextDialogs": [
              "731040910"
            ]
          },
          "731040910": {
            "id": "731040910",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "鱼常有而文物不常有。",
            "nextDialogs": [
              "731040911"
            ]
          },
          "731040911": {
            "id": "731040911",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "但是我也没钓上过几条大鱼啊！",
            "nextDialogs": [
              "731040912"
            ]
          },
          "731040912": {
            "id": "731040912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别垂头丧气啦，我们都成功捞起文物了，这都是好事呀。",
            "nextDialogs": [
              "731040913"
            ]
          },
          "731040913": {
            "id": "731040913",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "最后一个…垂钓点就在维摩庄附近，那边比较安全，我们赶紧过去吧。",
            "nextDialogs": [
              "731040914"
            ]
          },
          "731040914": {
            "id": "731040914",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "好好好，服了你了…",
            "nextDialogs": [
              "731040915"
            ]
          },
          "731040915": {
            "id": "731040915",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "真是奇了怪了，是我钓鱼的方法有问题，还是我的鱼饵有问题…",
            "nextDialogs": [
              "731040916"
            ]
          },
          "731040916": {
            "id": "731040916",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "算了，不想这些了…旅行者，这次请你去摘一些新鲜的墩墩桃吧。",
            "nextDialogs": [
              "731040917"
            ]
          },
          "731040917": {
            "id": "731040917",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "既然是最后一个地点，那我就要用出我的特制鱼饵了。",
            "nextDialogs": [
              "731040918"
            ]
          },
          "731040918": {
            "id": "731040918",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "旅行者，就麻烦你跑这一趟了。"
          }
        }
      }
    },
    {
      "subId": "7310410",

    {
      "subId": "7310403",
      "subQuestName": "将鱼饵的材料交给凯万",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731040301"
        ],
        "dialogs": {
          "731040301": {
            "id": "731040301",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "找到特别材料了吗？"
          }
        }
      }
    },
    {
      "subId": "7310404",
      "subQuestName": "与荷贝特和凯万对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731040401"
        ],
        "dialogs": {
          "731040401": {
            "id": "731040401",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "动作挺麻利嘛，辛苦了！",
            "nextDialogs": [
              "731040402"
            ]
          },
          "731040402": {
            "id": "731040402",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "请赶快开始吧，不然那些文物…呃…那些鱼都…",
            "nextDialogs": [
              "731040403"
            ]
          },
          "731040403": {
            "id": "731040403",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "别心急，要感受水流的韵律，下杆时的心态要平和。",
            "nextDialogs": [
              "731040404"
            ]
          },
          "731040404": {
            "id": "731040404",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "让我试试看吧，在这里能钓上什么大鱼…",
            "nextDialogs": [
              "731040405"
            ]
          },
          "731040405": {
            "id": "731040405",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "凯万制作了鱼饵，开始了垂钓",
            "nextDialogs": [
              "731040406"
            ]
          },
          "731040406": {
            "id": "731040406",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "漫长的等待后，凯万钓到了一个湿漉漉的包裹",
            "nextDialogs": [
              "731040407"
            ]
          },
          "731040407": {
            "id": "731040407",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "这是什么东西…",
            "nextDialogs": [
              "731040408"
            ]
          },
          "731040408": {
            "id": "731040408",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "这是…我，我来看看！",
            "nextDialogs": [
              "731040409"
            ]
          },
          "731040409": {
            "id": "731040409",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "就是这个！这是落水的文物之一！结构完好，也没有水生生物钻进去…",
            "nextDialogs": [
              "731040410"
            ]
          },
          "731040410": {
            "id": "731040410",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "居然能钓上来文物！您真不愧是「鱼钩上的绝景」！",
            "nextDialogs": [
              "731040411"
            ]
          },
          "731040411": {
            "id": "731040411",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "你这是夸我吗？我可是一点都高兴不起来…",
            "nextDialogs": [
              "731040412"
            ]
          },
          "731040412": {
            "id": "731040412",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "好，第一个地点的文物打捞完成了，接下来的…钓鱼点，就在西边不远。",
            "nextDialogs": [
              "731040413"
            ]
          },
          "731040413": {
            "id": "731040413",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "唉，快点出发吧，我还想快点回去清清静静地钓鱼呢。",
            "nextDialogs": [
              "731040414"
            ]
          },
          "731040414": {
            "id": "731040414",
            "speakerId": 12710,
            "speakerName": "荷贝特",
            "text": "没问题，请跟我来吧！",
            "nextDialogs": [
              "731040415"
            ]
          },
          "731040415": {
            "id": "731040415",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "旅行者，这次的特别材料就改成香辛果吧，我的直觉告诉我，这种材料最合适。",
            "nextDialogs": [
              "731040416"
            ]
          },
          "731040416": {
            "id": "731040416",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "有个地方的香辛果特别好，我给你标注一下位置…",
            "nextDialogs": [
              "731040417"
            ]
          },
          "731040417": {
            "id": "731040417",
            "speakerId": 4163,
            "speakerName": "凯万",
            "text": "我们就先动身了，在下一个钓鱼点会合吧。"
          }
        }
      }
    },
    {
      "subId": "7310405",

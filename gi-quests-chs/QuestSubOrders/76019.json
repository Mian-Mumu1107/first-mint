    {
      "subId": "7601903",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760190301"
        ],
        "dialogs": {
          "760190301": {
            "id": "760190301",
            "speakerId": 1002,
            "speakerName": "希丁芭",
            "text": "…要杀要剐，悉听尊便了。",
            "nextDialogs": [
              "760190302"
            ]
          },
          "760190302": {
            "id": "760190302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#呜啊，我跟{NICKNAME}才不会做这么可怕的事！只要你之后不要再骗人就好啦。",
            "nextDialogs": [
              "760190303"
            ]
          },
          "760190303": {
            "id": "760190303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "就算是维里这样的笨蛋…欸？那家伙什么时候溜了？总、总之就算是他那样的笨蛋也不能骗。",
            "nextDialogs": [
              "760190304"
            ]
          },
          "760190304": {
            "id": "760190304",
            "speakerId": 1002,
            "speakerName": "希丁芭",
            "text": "你们真善良，唉，如果我在须弥的时候也遇到像你们这样善良的人，也许就不会落到今天的下场了吧。",
            "nextDialogs": [
              "760190305"
            ]
          },
          "760190305": {
            "id": "760190305",
            "speakerId": 1002,
            "speakerName": "希丁芭",
            "text": "……",
            "nextDialogs": [
              "760190306"
            ]
          },
          "760190306": {
            "id": "760190306",
            "speakerId": 1002,
            "speakerName": "希丁芭",
            "text": "你们不问我遭遇了什么吗？",
            "nextDialogs": [
              "760190309"
            ]
          },
          "760190309": {
            "id": "760190309",
            "speakerId": 1002,
            "speakerName": "希丁芭",
            "text": "真是敏锐的小鬼…唉，最近一段时间都没开过张，也许是时候改行了，我也不想被伏尼契商会盯上。",
            "nextDialogs": [
              "760190310"
            ]
          },
          "760190310": {
            "id": "760190310",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "如果你能早点这么想，刚才就不用白白挨打啦！",
            "nextDialogs": [
              "760190311"
            ]
          },
          "760190311": {
            "id": "760190311",
            "speakerId": 1002,
            "speakerName": "希丁芭",
            "text": "做出人生抉择时总归需要一个契机嘛，不管是好是坏。",
            "nextDialogs": [
              "760190312"
            ]
          },
          "760190312": {
            "id": "760190312",
            "speakerId": 1002,
            "speakerName": "希丁芭",
            "text": "#{M#小弟}{F#小妹}，还有会飞的小东西，如果你们需要这个契机，可以随时来找我…",
            "nextDialogs": [
              "760190313"
            ]
          },
          "760190313": {
            "id": "760190313",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "还、还是算了吧！",
            "nextDialogs": [
              "760190314"
            ]
          },
          "760190314": {
            "id": "760190314",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "希丁芭留下红绸，摆摆手离开了…"
          }
        }
      }
    }
  ]

    {
      "subId": "7601901",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760190101"
        ],
        "dialogs": {
          "760190101": {
            "id": "760190101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「识者之证」？难道是…",
            "nextDialogs": [
              "760190102"
            ]
          },
          "760190102": {
            "id": "760190102",
            "speakerId": 1001,
            "speakerName": "维里",
            "text": "你、你们凑过来干什么，我们在谈很秘密的话题，关于雷德·米勒「伟大财宝」的线索…",
            "nextDialogs": [
              "760190105"
            ]
          },
          "760190105": {
            "id": "760190105",
            "speakerId": 1001,
            "speakerName": "维里",
            "text": "唔…对了，既然这样，那我们组队好了，我正愁凑不齐启动资金呢。",
            "nextDialogs": [
              "760190106"
            ]
          },
          "760190106": {
            "id": "760190106",
            "speakerId": 1001,
            "speakerName": "维里",
            "text": "我一个，你一个，还有会飞的一个，一共三份，我们三个正好，一人五十万摩拉。",
            "nextDialogs": [
              "760190107"
            ]
          },
          "760190107": {
            "id": "760190107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "五十万摩拉？！",
            "nextDialogs": [
              "760190108"
            ]
          },
          "760190108": {
            "id": "760190108",
            "speakerId": 1002,
            "speakerName": "希丁芭",
            "text": "唉，维里小弟，不是说好了这是我们两个之间的秘密吗？我是信任你，才会告诉你的。",
            "nextDialogs": [
              "760190109"
            ]
          },
          "760190109": {
            "id": "760190109",
            "speakerId": 1001,
            "speakerName": "维里",
            "text": "可是一百五十万摩拉，对我来说实在不是启动资金级别的数目呀，五十万还勉强能够凑齐…",
            "nextDialogs": [
              "760190110"
            ]
          },
          "760190110": {
            "id": "760190110",
            "speakerId": 1001,
            "speakerName": "维里",
            "text": "他们两个看起来也像是有经验的冒险者，我们组队的话，成功概率不是更高吗？",
            "nextDialogs": [
              "760190111"
            ]
          },
          "760190111": {
            "id": "760190111",
            "speakerId": 1002,
            "speakerName": "希丁芭",
            "text": "#唉，我是很看好维里小弟的，既然{M#他们}{F#她们}是你看好的人选，那我也愿意交往。",
            "nextDialogs": [
              "760190112"
            ]
          },
          "760190112": {
            "id": "760190112",
            "speakerId": 1002,
            "speakerName": "希丁芭",
            "text": "不过呢，这位会飞的朋友，体型和咱们不一样，自然要特别关照。",
            "nextDialogs": [
              "760190113"
            ]
          },
          "760190113": {
            "id": "760190113",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，是有什么礼物要送给我吗？",
            "nextDialogs": [
              "760190114"
            ]
          },
          "760190114": {
            "id": "760190114",
            "speakerId": 1002,
            "speakerName": "希丁芭",
            "text": "嗯，因为是特别定制的，相比纳塔原版的「强水」，能够适应的人群也更广，会飞的朋友当然也能放心使用。",
            "nextDialogs": [
              "760190115"
            ]
          },
          "760190115": {
            "id": "760190115",
            "speakerId": 1002,
            "speakerName": "希丁芭",
            "text": "至于价格嘛，要是别人，按理是得收两百万摩拉的，但看在你们是维里小弟的朋友的份上，就只要一百万摩拉好了。",
            "nextDialogs": [
              "760190116"
            ]
          },
          "760190116": {
            "id": "760190116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "一百万摩拉？！"
          }
        }
      }
    },

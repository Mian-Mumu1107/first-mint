      }
    },
    {
      "subId": "7080203",
      "subQuestName": "前往冒险家协会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708020201"
        ],
        "dialogs": {
          "708020201": {
            "id": "708020201",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "居然在这个区域…帕拉德，你确定吗？",
            "nextDialogs": [
              "708020202"
            ]
          },
          "708020202": {
            "id": "708020202",
            "speakerId": 1577,
            "speakerName": "冒失的帕拉德",
            "text": "我很确定，塞琉斯先生。",
            "nextDialogs": [
              "708020203"
            ]
          },
          "708020203": {
            "id": "708020203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在讨论乔尔父亲的事吗？",
            "nextDialogs": [
              "708020204"
            ]
          },
          "708020204": {
            "id": "708020204",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "这不是旅行者吗？看来你是从乔尔那边过来的啊。",
            "nextDialogs": [
              "708020205"
            ]
          },
          "708020205": {
            "id": "708020205",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "那孩子，每天都要拜托人从我这里打听消息…",
            "nextDialogs": [
              "708020206"
            ]
          },
          "708020206": {
            "id": "708020206",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "不过，这次我可是要带给他一个大大的好消息。",
            "nextDialogs": [
              "708020207"
            ]
          },
          "708020207": {
            "id": "708020207",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "前段时间，我们冒险家协会刚刚组织了一场「雪山特训」…",
            "nextDialogs": [
              "708020208"
            ]
          },
          "708020208": {
            "id": "708020208",
            "speakerId": 1577,
            "speakerName": "冒失的帕拉德",
            "text": "接下来的就由我说吧，塞琉斯先生。",
            "nextDialogs": [
              "708020209"
            ]
          },
          "708020209": {
            "id": "708020209",
            "speakerId": 1577,
            "speakerName": "冒失的帕拉德",
            "text": "在参加那场特训的途中，我因为风雪太大而偏离了预定的路线。",
            "nextDialogs": [
              "708020210"
            ]
          },
          "708020210": {
            "id": "708020210",
            "speakerId": 1577,
            "speakerName": "冒失的帕拉德",
            "text": "当我摸索着准备回到路线上时，突然在一处山崖上，看见了一个模糊的人影。",
            "nextDialogs": [
              "708020211"
            ]
          },
          "708020211": {
            "id": "708020211",
            "speakerId": 1577,
            "speakerName": "冒失的帕拉德",
            "text": "我最开始还以为是一个和我一样迷路的冒险家，就大声喊他。",
            "nextDialogs": [
              "708020212"
            ]
          },
          "708020212": {
            "id": "708020212",
            "speakerId": 1577,
            "speakerName": "冒失的帕拉德",
            "text": "但是，在吸引到那个人的注意力之前…我的喊声先引来了魔物。",
            "nextDialogs": [
              "708020213"
            ]
          },
          "708020213": {
            "id": "708020213",
            "speakerId": 1577,
            "speakerName": "冒失的帕拉德",
            "text": "在雪山的那种环境里，我没有打倒那些魔物的自信，只能先撤退了。",
            "nextDialogs": [
              "708020214"
            ]
          },
          "708020214": {
            "id": "708020214",
            "speakerId": 1577,
            "speakerName": "冒失的帕拉德",
            "text": "回来之后，我就把这件事和塞琉斯先生说了。",
            "nextDialogs": [
              "708020216"
            ]
          },
          "708020216": {
            "id": "708020216",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "我们也不能确定。",
            "nextDialogs": [
              "708020218"
            ]
          },
          "708020218": {
            "id": "708020218",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "无论如何，至少我们知道了有人被困在雪山里，必须要组织营救行动。",
            "nextDialogs": [
              "708020219"
            ]
          },
          "708020219": {
            "id": "708020219",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "至于那个人到底是不是乔尔的父亲乔瑟夫先生…就只能看运气了。",
            "nextDialogs": [
              "708020220"
            ]
          },
          "708020220": {
            "id": "708020220",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "总之，我已经让协会里有能力进入雪山的人都去展开搜救了。",
            "nextDialogs": [
              "708020221"
            ]
          },
          "708020221": {
            "id": "708020221",
            "speakerId": 1577,
            "speakerName": "冒失的帕拉德",
            "text": "我也准备一下，等会就去雪山里参加搜救。"
          }
        }
      }
    },
    {
      "subId": "7080204",
      "subQuestName": "前往雪山，搜寻线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708020401"
        ],
        "dialogs": {
          "708020401": {
            "id": "708020401",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "旅行者，你回来了。",
            "nextDialogs": [
              "708020403",
              "708020405"
            ]
          },
          "708020403": {
            "id": "708020403",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "嗯，那家伙偶尔还是能干点正事的嘛…",
            "nextDialogs": [
              "708020406"
            ]
          },
          "708020406": {
            "id": "708020406",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "等我整理一下手上的情报之后，也会去雪山那边见见乔尔那孩子，把事情详细地讲给他听。",
            "nextDialogs": [
              "708020407"
            ]
          },
          "708020407": {
            "id": "708020407",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "旅行者，请你先去告诉乔尔，我等一下就会过去。",
            "nextDialogs": [
              "708020408"
            ]
          },
          "708020408": {
            "id": "708020408",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "我整理情报还要些时间，可别让那孩子等急了。"
          },
          "708020405": {
            "id": "708020405",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "这我…不能保证。只能说，我们会尽最大的努力。"
          }
        }
      }
    },
    {
      "subId": "7080205",
      "subQuestName": "打倒所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708020501"
        ],
        "dialogs": {
          "708020501": {
            "id": "708020501",
            "speakerId": 1668,
            "speakerName": "乔尔",
            "text": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，你帮我打听到什么消息了吗？",
            "nextDialogs": [
              "708020502"
            ]
          },
          "708020502": {
            "id": "708020502",
            "speakerId": 1668,
            "speakerName": "乔尔",
            "text": "也就是说…塞琉斯叔叔还没有找到我爸爸…",
            "nextDialogs": [
              "708020505"
            ]
          },
          "708020505": {
            "id": "708020505",
            "speakerId": 1668,
            "speakerName": "乔尔",
            "text": "#嗯，我知道。等塞琉斯叔叔来了，我会再详细问他的，谢谢你，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}。",
            "nextDialogs": [
              "708020506"
            ]
          },
          "708020506": {
            "id": "708020506",
            "speakerId": 1668,
            "speakerName": "乔尔",
            "text": "爸爸…你到底在哪啊…"
          }
        }
      }
    },
    {
      "subId": "7080206",
      "subQuestName": "和帕拉德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708020301"
        ],
        "dialogs": {
          "708020301": {
            "id": "708020301",
            "speakerId": 1577,
            "speakerName": "冒失的帕拉德",
            "text": "这周围总算安全点了，多谢啦。",
            "nextDialogs": [
              "708020302"
            ]
          },
          "708020302": {
            "id": "708020302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于乔瑟夫先生…",
            "nextDialogs": [
              "708020303"
            ]
          },
          "708020303": {
            "id": "708020303",
            "speakerId": 1577,
            "speakerName": "冒失的帕拉德",
            "text": "唉，我刚才也没发现什么新线索。",
            "nextDialogs": [
              "708020304"
            ]
          },
          "708020304": {
            "id": "708020304",
            "speakerId": 1577,
            "speakerName": "冒失的帕拉德",
            "text": "不过，既然这周围都安全了，那我也会继续搜索的。",
            "nextDialogs": [
              "708020305"
            ]
          },
          "708020305": {
            "id": "708020305",
            "speakerId": 1577,
            "speakerName": "冒失的帕拉德",
            "text": "请你先回协会一趟，告诉塞琉斯先生我已经开始搜索工作了吧。"
          }
        }
      }
    },

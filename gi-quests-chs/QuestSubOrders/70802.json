  "subQuests": [
    {
      "subId": "7080201",
      "subQuestName": "(test)隐藏等待一日$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708020101"
        ],
        "dialogs": {
          "708020101": {
            "id": "708020101",
            "speakerId": 1668,
            "speakerName": "乔尔",
            "text": "这次，真的能找到爸爸吗…",
            "nextDialogs": [
              "708020102"
            ]
          },
          "708020102": {
            "id": "708020102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你爸爸有消息了吗？",
            "nextDialogs": [
              "708020103"
            ]
          },
          "708020103": {
            "id": "708020103",
            "speakerId": 1668,
            "speakerName": "乔尔",
            "text": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，是你呀。",
            "nextDialogs": [
              "708020104"
            ]
          },
          "708020104": {
            "id": "708020104",
            "speakerId": 1668,
            "speakerName": "乔尔",
            "text": "帕拉德哥哥和我说，塞琉斯叔叔好像找到了和我爸爸有关的消息。",
            "nextDialogs": [
              "708020105"
            ]
          },
          "708020105": {
            "id": "708020105",
            "speakerId": 1668,
            "speakerName": "乔尔",
            "text": "虽然他还不能确定…但帕拉德哥哥说，这次他们找到的线索很有力，说不定真能找到我爸爸。",
            "nextDialogs": [
              "708020106"
            ]
          },
          "708020106": {
            "id": "708020106",
            "speakerId": 1668,
            "speakerName": "乔尔",
            "text": "我想要和他们一起进雪山去，但塞琉斯叔叔要我留在营地里，有了消息他们自然会告诉我…",
            "nextDialogs": [
              "708020107"
            ]
          },
          "708020107": {
            "id": "708020107",
            "speakerId": 1668,
            "speakerName": "乔尔",
            "text": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，如果可以的话，你能帮我去向塞琉斯叔叔打听一下消息吗？",
            "nextDialogs": [
              "708020110"
            ]
          },
          "708020110": {
            "id": "708020110",
            "speakerId": 1668,
            "speakerName": "乔尔",
            "text": "我、我害怕听到…不好的消息…",
            "nextDialogs": [
              "708020111"
            ]
          },
          "708020111": {
            "id": "708020111",
            "speakerId": 1668,
            "speakerName": "乔尔",
            "text": "#总之，拜托你了！大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！"
          }
        }
      }
    },
    {
      "subId": "7080202",

    {
      "subId": "7620307",
      "subQuestName": "(test)废弃",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7620305",
      "subQuestName": "与尼可对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762030501"
        ],
        "dialogs": {
          "762030501": {
            "id": "762030501",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "这些画作纪念着我心中的意义非凡之地，这样一来，画室就全部复原了。",
            "nextDialogs": [
              "762030502"
            ]
          },
          "762030502": {
            "id": "762030502",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "领取我们的报酬吧，怎么？看我干什么？当然是「我们」的。",
            "nextDialogs": [
              "762030503"
            ]
          },
          "762030503": {
            "id": "762030503",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "你不会放着宝箱不开吧？那我可不能让你出去了。再说，我说了那么多故事，总该奖励我一下吧？"
          }
        }
      }
    },
    {
      "subId": "7620306",
      "subQuestName": "开启宝箱",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762030601"
        ],
        "dialogs": {
          "762030601": {
            "id": "762030601",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "喔噢，还有东西没拿哦！"
          }
        }
      }
    },
    {
      "subId": "7620314",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762031401"
        ],
        "dialogs": {
          "762031401": {
            "id": "762031401",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "仔细想想…这座魔女小屋对我来说也很有特殊意义。屋中画，画中屋…嵌套结构？有点意思…"
          }
        }
      }
    },
    {
      "subId": "7620399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762039901"
        ],
        "dialogs": {
          "762039901": {
            "id": "762039901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是尼可的画室吗？但怎么四周只有白墙和画框？我们走近点多观察一下吧。",
            "nextDialogs": [
              "762039902"
            ]
          },
          "762039902": {
            "id": "762039902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们去看看别的画框吧，让我也缓缓…",

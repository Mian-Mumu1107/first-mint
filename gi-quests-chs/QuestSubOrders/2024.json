{
  "lineCounts": {
    "Player": 37,
    "八重神子": 41,
    "利弗": 4,
    "派蒙": 14,
    "阿尔芒": 3,
    "阿尔贝": 11,
    "阿尔邦": 12
  },
  "subQuests": [
    {
      "subId": "202401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20240101"
        ],
        "dialogs": {
          "20240101": {
            "id": "20240101",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "刚才的话题是不是有些太过严肃了，你还是更喜欢被我捉弄吗？呵呵…",
            "nextDialogs": [
              "20210302"
            ]
          },
          "20210302": {
            "id": "20210302",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "「人偶」将军的技术源自于某些现今已然失落的知识，或许只有身为神明的她才能知会其中源头…",
            "nextDialogs": [
              "20210303"
            ]
          },
          "20210303": {
            "id": "20210303",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "不过…倒是有件事你们应该会感兴趣。",
            "nextDialogs": [
              "20210304"
            ]
          },
          "20210304": {
            "id": "20210304",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "在影开始对自己的神明之躯进行自我改造之前，还凭空创造过一个「原型人偶」…",
            "nextDialogs": [
              "20210305"
            ]
          },
          "20210305": {
            "id": "20210305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那、那难道有三个雷电将军！？",
            "nextDialogs": [
              "20210306"
            ]
          },
          "20210306": {
            "id": "20210306",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "不，那个原型只是为了验证可行性，外貌和智能都没有依托影的自身去设计，可以说算是试做品。",
            "nextDialogs": [
              "20210307"
            ]
          },
          "20210307": {
            "id": "20210307",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "按照最初设想，影应当将他直接废弃，但也许影认为这样做过于残酷，便选择只将他体内的力量封印。",
            "nextDialogs": [
              "20210308"
            ]
          },
          "20210308": {
            "id": "20210308",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "后来，他便像个普通人一样，凭借自我意识流浪在稻妻的土地上，直到…愚人众看中了他。",
            "nextDialogs": [
              "20210309"
            ]
          },
          "20210309": {
            "id": "20210309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "愚人众！",
            "nextDialogs": [
              "20210310"
            ]
          },
          "20210310": {
            "id": "20210310",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "而那个原型人偶经过愚人众里某些奇人异士的调整，解除了力量的封印，甚至比封印之前更强大也说不定。",
            "nextDialogs": [
              "20210311"
            ]
          },
          "20210311": {
            "id": "20210311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "莫非…",
            "nextDialogs": [
              "20210312"
            ]
          },
          "20210312": {
            "id": "20210312",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "嗯，神之造物亲手夺去了神之心…那个原型人偶便是如今的「散兵」。",
            "nextDialogs": [
              "20210313"
            ]
          },
          "20210313": {
            "id": "20210313",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "居、居然还有这样的事！",
            "nextDialogs": [
              "20210314"
            ]
          },
          "20210314": {
            "id": "20210314",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "是啊，究竟是机缘巧合，还是天命注定呢。"
          }
        }
      }
    },
    {
      "subId": "7450402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745040201"
        ],
        "dialogs": {
          "745040201": {
            "id": "745040201",
            "speakerId": 1002,
            "speakerName": "阿尔邦",
            "text": "你听说了吗？阿尔芒最近状态好像好多了，虽然人多的时候还会紧张，不过至少能表达意思了。",
            "nextDialogs": [
              "745040202"
            ]
          },
          "745040202": {
            "id": "745040202",
            "speakerId": 1003,
            "speakerName": "阿尔贝",
            "text": "那还不错。要是话都说不完整，想当喜剧演员是肯定没戏的。",
            "nextDialogs": [
              "745040203"
            ]
          },
          "745040203": {
            "id": "745040203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿尔芒？",
            "nextDialogs": [
              "745040204"
            ]
          },
          "745040204": {
            "id": "745040204",
            "speakerId": 1002,
            "speakerName": "阿尔邦",
            "text": "就是勒波特钟表店门口的那个店员。老爷您没见过他吗？",
            "nextDialogs": [
              "745040205"
            ]
          },
          "745040205": {
            "id": "745040205",
            "speakerId": 1003,
            "speakerName": "阿尔贝",
            "text": "他跟我们是同一个村庄的，也是个想当喜剧演员的好小伙子，可惜，他有严重的口吃。",
            "nextDialogs": [
              "745040206"
            ]
          },
          "745040206": {
            "id": "745040206",
            "speakerId": 1002,
            "speakerName": "阿尔邦",
            "text": "据说是小时候观看一场喜剧的时候，意外从看台摔了下来，脑袋落下了后遗症。",
            "nextDialogs": [
              "745040207"
            ]
          },
          "745040207": {
            "id": "745040207",
            "speakerId": 1003,
            "speakerName": "阿尔贝",
            "text": "那场喜剧我本来很喜欢，名字叫「审判」。但现在总觉得有点爱不起来了。",
            "nextDialogs": [
              "745040208"
            ]
          },
          "745040208": {
            "id": "745040208",
            "speakerId": 1002,
            "speakerName": "阿尔邦",
            "text": "志向成为喜剧演员的孩子在名为「审判」的喜剧中被审判了，惩罚是他再也当不了喜剧演员。",
            "nextDialogs": [
              "745040209"
            ]
          },
          "745040209": {
            "id": "745040209",
            "speakerId": 1003,
            "speakerName": "阿尔贝",
            "text": "可怜的阿尔芒，他犯了什么罪？谁是审判官？",
            "nextDialogs": [
              "745040210"
            ]
          },
          "745040210": {
            "id": "745040210",
            "speakerId": 1002,
            "speakerName": "阿尔邦",
            "text": "谁知道呢？"
          }
        }
      }
    },
    {
      "subId": "7450403",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745040301"
        ],
        "dialogs": {
          "745040301": {
            "id": "745040301",
            "speakerId": 1002,
            "speakerName": "阿尔邦",
            "text": "你看见留言板了吗？好像有人看上了那个发条企鹅。",
            "nextDialogs": [
              "745040302"
            ]
          },
          "745040302": {
            "id": "745040302",
            "speakerId": 1003,
            "speakerName": "阿尔贝",
            "text": "看到了，是想要认识下菲米尼的那条吧？听口气，感觉还有点想进一步合作的意思。",
            "nextDialogs": [
              "745040305"
            ]
          },
          "745040305": {
            "id": "745040305",
            "speakerId": 1002,
            "speakerName": "阿尔邦",
            "text": "哦，就是摆在那边桌子上的发条玩具企鹅，是一个叫做菲米尼的潜水员做的。他放在我们店寄售。",
            "nextDialogs": [
              "745040306"
            ]
          },
          "745040306": {
            "id": "745040306",
            "speakerId": 1003,
            "speakerName": "阿尔贝",
            "text": "他是个好小伙子，有一张漂亮的脸蛋，说话轻声细语，做玩具的手艺还很棒。",
            "nextDialogs": [
              "745040307"
            ]
          },
          "745040307": {
            "id": "745040307",
            "speakerId": 1002,
            "speakerName": "阿尔邦",
            "text": "唯一就是，他看起来有点忧伤，就好像缺少了什么本该属于他的东西…",
            "nextDialogs": [
              "745040308"
            ]
          },
          "745040308": {
            "id": "745040308",
            "speakerId": 1003,
            "speakerName": "阿尔贝",
            "text": "那眼神我太清楚啦，和阿尔邦看他那空荡荡的钱包的眼神一模一样，他绝对是缺钱。",
            "nextDialogs": [
              "745040309"
            ]
          },
          "745040309": {
            "id": "745040309",
            "speakerId": 1002,
            "speakerName": "阿尔邦",
            "text": "别胡说，你忘了他来谈寄售的那天，都没说分成的事。这一看就不是冲着摩拉来的。",
            "nextDialogs": [
              "745040310"
            ]
          },
          "745040310": {
            "id": "745040310",
            "speakerId": 1003,
            "speakerName": "阿尔贝",
            "text": "这倒也是，但这种年纪的小伙子还能烦恼什么呢？",
            "nextDialogs": [
              "745040311"
            ]
          },
          "745040311": {
            "id": "745040311",
            "speakerId": 1002,
            "speakerName": "阿尔邦",
            "text": "话说回来，他确实挺讨人喜欢的，老板这还是头一回答应了寄售。",
            "nextDialogs": [
              "745040312"
            ]
          },
          "745040312": {
            "id": "745040312",
            "speakerId": 1002,
            "speakerName": "阿尔邦",
            "text": "不仅给安排了户外的摊位，也没占人便宜，主动提出了五五分成。",
            "nextDialogs": [
              "745040313"
            ]
          },
          "745040313": {
            "id": "745040313",
            "speakerId": 1003,
            "speakerName": "阿尔贝",
            "text": "可惜啊，最后卖的情况，只能说一般般吧。看的人不少，买的人不多。",
            "nextDialogs": [
              "745040314"
            ]
          },
          "745040314": {
            "id": "745040314",
            "speakerId": 1003,
            "speakerName": "阿尔贝",
            "text": "那个玩具的设计确实精巧，但可能正因为这样，上手的门槛也变高了，维修起来也不容易。",
            "nextDialogs": [
              "745040315"
            ]
          },
          "745040315": {
            "id": "745040315",
            "speakerId": 1002,
            "speakerName": "阿尔邦",
            "text": "没想到这次居然有人特地在留言板上留言。搞不好碰上大客户了呢。",
            "nextDialogs": [
              "745040316"
            ]
          },
          "745040316": {
            "id": "745040316",
            "speakerId": 1003,
            "speakerName": "阿尔贝",
            "text": "总之，回头记得提醒一下老板，好买卖可别弄丢了。"
          }
        }
      }
    },
    {
      "subId": "7450404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745040401"
        ],
        "dialogs": {
          "745040401": {
            "id": "745040401",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "北国银行那边有进展的话，我不会忘记通知两位贵客的。",
            "nextDialogs": [
              "745040402"
            ]
          },
          "745040402": {
            "id": "745040402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿尔邦和阿尔贝今天不在吗？",
            "nextDialogs": [
              "745040403"
            ]
          },
          "745040403": {
            "id": "745040403",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "他们两个请假了，说是有什么玩具的新点子。真是奇事。",
            "nextDialogs": [
              "745040404"
            ]
          },
          "745040404": {
            "id": "745040404",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "这两个家伙，平时满脑子都是他们的喜剧，对玩具可从没这么上心过。",
            "nextDialogs": [
              "745040405"
            ]
          },
          "745040405": {
            "id": "745040405",
            "speakerId": 1004,
            "speakerName": "利弗",
            "text": "这回居然变性了，真不知道他们在想什么。"
          }
        }
      }
    },
    {
      "subId": "7450502",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745050201"
        ],
        "dialogs": {
          "745050201": {
            "id": "745050201",
            "speakerId": 1005,
            "speakerName": "阿尔芒",
            "text": "这个又…又简单…又…又好玩，试…试…试试吧？",
            "nextDialogs": [
              "745050203",
              "745050205"
            ]
          },
          "745050203": {
            "id": "745050203",
            "speakerId": 1005,
            "speakerName": "阿尔芒",
            "text": "祝…祝…祝两位…玩开心。"
          },
          "745050205": {
            "id": "745050205",
            "speakerId": 1005,
            "speakerName": "阿尔芒",
            "text": "好…好！什…什么时候来，我…我都在这。"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7665801",
      "subQuestName": "与茜涅特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766580101"
        ],
        "dialogs": {
          "766580101": {
            "id": "766580101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你好啊，茜涅特，上次找回来的机器人也都调试好了吧？",
            "nextDialogs": [
              "766580102"
            ]
          },
          "766580102": {
            "id": "766580102",
            "speakerId": 1001,
            "speakerName": "茜涅特",
            "text": "嗯，多亏了你们。",
            "nextDialogs": [
              "766580103"
            ]
          },
          "766580103": {
            "id": "766580103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说起来，我们确实有些新的发现呢。",
            "nextDialogs": [
              "766580104"
            ]
          },
          "766580104": {
            "id": "766580104",
            "speakerId": 1001,
            "speakerName": "茜涅特",
            "text": "真的？请讲给我听！",
            "nextDialogs": [
              "766580105"
            ]
          },
          "766580105": {
            "id": "766580105",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "你和派蒙向茜涅特讲述了不久前的见闻。",
            "nextDialogs": [
              "766580106"
            ]
          },
          "766580106": {
            "id": "766580106",
            "speakerId": 1001,
            "speakerName": "茜涅特",
            "text": "你们描述的那种表现…这些机器人似乎很喜欢你们，并向你们发出了「一起玩耍」的邀请。",
            "nextDialogs": [
              "766580107"
            ]
          },
          "766580107": {
            "id": "766580107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真的？好有趣！",
            "nextDialogs": [
              "766580108"
            ]
          },
          "766580108": {
            "id": "766580108",
            "speakerId": 1001,
            "speakerName": "茜涅特",
            "text": "嗯…果然是这样！",
            "nextDialogs": [
              "766580109"
            ]
          },
          "766580109": {
            "id": "766580109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "茜涅特，又发现什么了吗？",
            "nextDialogs": [
              "766580110"
            ]
          },
          "766580110": {
            "id": "766580110",
            "speakerId": 1001,
            "speakerName": "茜涅特",
            "text": "我现在能确定了，我的创意要通过机器人之间的交互来实现，找回的机器人越多，就越接近最初的设想。",
            "nextDialogs": [
              "766580111"
            ]
          },
          "766580111": {
            "id": "766580111",
            "speakerId": 1001,
            "speakerName": "茜涅特",
            "text": "现在它们已经拥有了和他人交流的能力，只要把剩下的机器人也找齐…我的创意还是行得通的！",
            "nextDialogs": [
              "766580112"
            ]
          },
          "766580112": {
            "id": "766580112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，兴奋起来了。",
            "nextDialogs": [
              "766580113"
            ]
          },
          "766580113": {
            "id": "766580113",
            "speakerId": 1001,
            "speakerName": "茜涅特",
            "text": "啊，不好意思，说起来还是要仰仗你们，下一片区域也在地图上标好了。",
            "nextDialogs": [
              "766580114"
            ]
          },
          "766580114": {
            "id": "766580114",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那我们尽快出发吧，我开始好奇这些机器人最终会变成什么样子了。"
          }
        }
      }
    }
  ]
}
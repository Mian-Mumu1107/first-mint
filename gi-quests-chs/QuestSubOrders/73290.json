{
  "lineCounts": {
    "赛芭": 11
  },
  "subQuests": [
    {
      "subId": "7329002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732900201"
        ],
        "dialogs": {
          "732900201": {
            "id": "732900201",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "多让人怀念的花，给你的礼物我也准备好了，你拿着吧。",
            "nextDialogs": [
              "732900202"
            ]
          },
          "732900202": {
            "id": "732900202",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "都是无法在这里生长发芽的植物种子，如果你在别处有宅院的话，就能看它们长大了。",
            "nextDialogs": [
              "732900203"
            ]
          },
          "732900203": {
            "id": "732900203",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "你看我，一下说了好多话，好畅快。",
            "nextDialogs": [
              "732900204"
            ]
          },
          "732900204": {
            "id": "732900204",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "你来之前，我在这里没什么朋友，其实有些寂寞。",
            "nextDialogs": [
              "732900207"
            ]
          },
          "732900207": {
            "id": "732900207",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "整个村子里，有闲心种花的人很少。",
            "nextDialogs": [
              "732900208"
            ]
          },
          "732900208": {
            "id": "732900208",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "嗯…这样说不准确，村子北面，也有位老爷爷开垦出了一片苗圃，拿来种花。",
            "nextDialogs": [
              "732900209"
            ]
          },
          "732900209": {
            "id": "732900209",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "我去看望过他，是个有点奇怪的老人。",
            "nextDialogs": [
              "732900210"
            ]
          },
          "732900210": {
            "id": "732900210",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "种下的明明是「石头」，却非说自己在种花，还把我赶走了。",
            "nextDialogs": [
              "732900211"
            ]
          },
          "732900211": {
            "id": "732900211",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "一个人生活也有点寂寞吧，我能理解那种心情。",
            "nextDialogs": [
              "732900212"
            ]
          },
          "732900212": {
            "id": "732900212",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "你能帮我的须弥蔷薇开花，说不定也能帮帮他。",
            "nextDialogs": [
              "732900213"
            ]
          },
          "732900213": {
            "id": "732900213",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "如果有机会的话，你和派蒙也可以去看看他。"
          }
        }
      }
    }
  ]
}
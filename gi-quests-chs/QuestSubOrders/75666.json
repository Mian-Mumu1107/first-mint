  "subQuests": [
    {
      "subId": "7566601",
      "subQuestName": "与普萨科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "756660101"
        ],
        "dialogs": {
          "756660101": {
            "id": "756660101",
            "speakerId": 30873,
            "speakerName": "普萨科",
            "text": "好嘞！这样就准备好了。不过…总感觉差点什么…",
            "nextDialogs": [
              "756660102"
            ]
          },
          "756660102": {
            "id": "756660102",
            "speakerId": 30873,
            "speakerName": "普萨科",
            "text": "#{NICKNAME}！你来得正好，想不想痛痛快快地玩一场喷涂游戏？",
            "nextDialogs": [
              "756660105"
            ]
          },
          "756660105": {
            "id": "756660105",
            "speakerId": 30873,
            "speakerName": "普萨科",
            "text": "哈哈哈哈哈，别这么紧张嘛。真的就只是一场游戏而已。",
            "nextDialogs": [
              "756660106"
            ]
          },
          "756660106": {
            "id": "756660106",
            "speakerId": 30873,
            "speakerName": "普萨科",
            "text": "我保证，一点危险性都没有。最大的风险，也就是会把你衣服弄脏。",
            "nextDialogs": [
              "756660107"
            ]
          },
          "756660107": {
            "id": "756660107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不是很擅长喷涂…",
            "nextDialogs": [
              "756660108"
            ]
          },
          "756660108": {
            "id": "756660108",
            "speakerId": 30873,
            "speakerName": "普萨科",
            "text": "放心放心，这场喷涂游戏由我亲自设计，不需要任何喷涂基础也能玩个开心。",
            "nextDialogs": [
              "756660109"
            ]
          },
          "756660109": {
            "id": "756660109",
            "speakerId": 30873,
            "speakerName": "普萨科",
            "text": "虽然我被拉过来的时候，是被要求做一个够大，够酷，够有气势的喷涂对象…",
            "nextDialogs": [
              "756660110"
            ]
          },
          "756660110": {
            "id": "756660110",
            "speakerId": 30873,
            "speakerName": "普萨科",
            "text": "不过嘛，从事实上来看，虽然我把那个够酷的喷涂对象造出来了，但并不是每一个人都能够把它喷好。",
            "nextDialogs": [
              "756660111"
            ]
          },
          "756660111": {
            "id": "756660111",
            "speakerId": 30873,
            "speakerName": "普萨科",
            "text": "所以，我就把它给简化了一下，把有趣的重点放在了喷涂的「过程」上。",
            "nextDialogs": [
              "756660112"
            ]
          },
          "756660112": {
            "id": "756660112",
            "speakerId": 30873,
            "speakerName": "普萨科",
            "text": "简单来说就是…呃，我也不知道怎么简单来说，但总之你玩玩就知道了。",
            "nextDialogs": [
              "756660113"
            ]
          },
          "756660113": {
            "id": "756660113",
            "speakerId": 30873,
            "speakerName": "普萨科",
            "text": "好了，说再多也不如自己亲手试试，上场上场！"
          }
        }
      }
    }
  ]
}
{
  "lineCounts": {
    "Player": 2,
    "弗丽德": 14,
    "络紫": 1
  },
  "subQuests": [
    {
      "subId": "7053201",
      "subQuestName": "与弗丽德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705320101"
        ],
        "dialogs": {
          "705320101": {
            "id": "705320101",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "嗯…还要加入这张牌…咦？还有几张牌呢…",
            "nextDialogs": [
              "705320102"
            ]
          },
          "705320102": {
            "id": "705320102",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "咦？旅行者！抱歉抱歉，我刚才在想牌组的事，没注意到你过来了…",
            "nextDialogs": [
              "705320103"
            ]
          },
          "705320103": {
            "id": "705320103",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "我是由冒险家协会委派来协办「召唤王大奖赛」的冒险家，我这边负责的是…嗯…一种有着特殊规则的卡牌对决！",
            "nextDialogs": [
              "705320104"
            ]
          },
          "705320104": {
            "id": "705320104",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "我们把它取名为「零时召唤」。",
            "nextDialogs": [
              "705320107"
            ]
          },
          "705320107": {
            "id": "705320107",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "不不不，我们「零时召唤」属于坊间比赛，有一套特别的规则。",
            "nextDialogs": [
              "705320108"
            ]
          },
          "705320108": {
            "id": "705320108",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "简单来说就是，参赛者不能使用自己收藏的卡牌，而是要从我们已经准备好的八套不完整卡牌组中挑选三套，组成一套完整的牌组。",
            "nextDialogs": [
              "705320109"
            ]
          },
          "705320109": {
            "id": "705320109",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "在这三组套牌中，还有一些刚刚推出的全新卡牌，至于如何使用它们…就看你打牌的本事了。",
            "nextDialogs": [
              "705320110"
            ]
          },
          "705320110": {
            "id": "705320110",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "除了这些之外，其他的规则就和正常的对局没什么区别啦。",
            "nextDialogs": [
              "705320111"
            ]
          },
          "705320111": {
            "id": "705320111",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "要是你觉得自己没有什么靠谱的组牌思路，我们也可以帮你组建牌组…",
            "nextDialogs": [
              "705320112"
            ]
          },
          "705320112": {
            "id": "705320112",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "但是组出来的牌组究竟好不好用嘛…嘿嘿，那就不知道了。",
            "nextDialogs": [
              "705320113"
            ]
          },
          "705320113": {
            "id": "705320113",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "总之，我的建议还是由你自己来挑选并组建牌组啦，毕竟你可是要拿着这套牌去和人对决的。",
            "nextDialogs": [
              "705320114"
            ]
          },
          "705320114": {
            "id": "705320114",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "如果您对自己的实力有信心，甚至可以去其他的「召唤王大奖赛」举办区域，继续玩「零时召唤」。",
            "nextDialogs": [
              "705320115"
            ]
          },
          "705320115": {
            "id": "705320115",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "啊，当然啦，你也不用有什么心理负担，只要参加「零时召唤」，无论对局的结果是胜是负，我们都有好礼相赠。",
            "nextDialogs": [
              "705320116"
            ]
          },
          "705320116": {
            "id": "705320116",
            "speakerId": 30381,
            "speakerName": "弗丽德",
            "text": "旅行者，要是你有兴趣的话，就来体验一下吧。"
          }
        }
      }
    },
    {
      "subId": "7053212",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705321203"
        ],
        "dialogs": {
          "705321203": {
            "id": "705321203",
            "speakerId": 30382,
            "speakerName": "络紫",
            "text": "请问我有什么能帮您的吗？"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7227101",
      "subQuestName": "（test）跟琳琅对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722710101"
        ],
        "dialogs": {
          "722710101": {
            "id": "722710101",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "欢迎光临敝店，请来看看新上架的古董吧。",
            "nextDialogs": [
              "722710102"
            ]
          },
          "722710102": {
            "id": "722710102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我有宝物想要出售。",
            "nextDialogs": [
              "722710103"
            ]
          },
          "722710103": {
            "id": "722710103",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "您又找到了什么稀奇东西？请让我看看。",
            "nextDialogs": [
              "722710104"
            ]
          },
          "722710104": {
            "id": "722710104",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "将龙骨花凝珠的故事告诉了琳琅。",
            "nextDialogs": [
              "722710105"
            ]
          },
          "722710105": {
            "id": "722710105",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "听您所说，这可是一件了不得的古物啊。",
            "nextDialogs": [
              "722710106"
            ]
          },
          "722710106": {
            "id": "722710106",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "只是我入手察看一番，并没有感觉到特别明显的异样，或许需要长期使用才行…",
            "nextDialogs": [
              "722710107"
            ]
          },
          "722710107": {
            "id": "722710107",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "依我之见，您所听来的神妙效用，可能有些夸大了，又或者...说不定只是失败者的托辞呢…",
            "nextDialogs": [
              "722710108"
            ]
          },
          "722710108": {
            "id": "722710108",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "哈哈，您不用在意，我只是随口一说，您听听便好。",
            "nextDialogs": [
              "722710122"
            ]
          },
          "722710122": {
            "id": "722710122",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "在我们古董行当里，这种事情倒十分常见。",
            "nextDialogs": [
              "722710109"
            ]
          },
          "722710109": {
            "id": "722710109",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "另外，您似乎没有对它密封保存，粗粗看去，它的表面似乎已经有了一些耗损。",
            "nextDialogs": [
              "722710110"
            ]
          },
          "722710110": {
            "id": "722710110",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "这样一来，价格又要小打一点折扣。",
            "nextDialogs": [
              "722710123"
            ]
          },
          "722710123": {
            "id": "722710123",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "您看，80000摩拉如何？除此之外，再加5份特色料理丰年有余。",
            "nextDialogs": [
              "722710111"
            ]
          },
          "722710111": {
            "id": "722710111",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "我相信这是一个不错的价格。",
            "nextDialogs": [
              "722710113",
              "722710117",
              "722710120"
            ]
          },
          "722710113": {
            "id": "722710113",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "其实跟它的功效相比，我倒觉得它背后的那段故事更有价值。",
            "nextDialogs": [
              "722710114"
            ]
          },
          "722710114": {
            "id": "722710114",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "我猜港里的说书人、戏班子，或者玉京台上的贵人们都会对它有兴趣。",
            "nextDialogs": [
              "722710115"
            ]
          },
          "722710115": {
            "id": "722710115",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "就算只摆在本店的柜台上展示，也能算上一件珍稀的古董了。"
          },
          "722710117": {
            "id": "722710117",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "您可真爽快，这些摩拉请收好。",
            "nextDialogs": [
              "722710118"
            ]
          },
          "722710118": {
            "id": "722710118",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "往后要是还有类似的宝贝，敝店随时恭候您的光临。"
          },
          "722710120": {
            "id": "722710120",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "嗯，对于这种珍奇宝物，货比三家…啊不是，价比三家也是应该的。",
            "nextDialogs": [
              "722710121"
            ]
          },
          "722710121": {
            "id": "722710121",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "如果您考虑好了，可以再来找我。"
          }
        }
      }
    },
    {
      "subId": "7227102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],

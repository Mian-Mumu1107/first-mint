            "id": "722710201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于龙骨花凝珠。",
            "nextDialogs": [
              "722710202"
            ]
          },
          "722710202": {
            "id": "722710202",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "那么，您考虑的如何了？",
            "nextDialogs": [
              "722710203"
            ]
          },
          "722710203": {
            "id": "722710203",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "敝店愿意以80000摩拉加5份丰年有余来收购。",
            "nextDialogs": [
              "722710205",
              "722710208"
            ]
          },
          "722710205": {
            "id": "722710205",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "谢您惠顾，这些摩拉请收好。",
            "nextDialogs": [
              "722710206"
            ]
          },
          "722710206": {
            "id": "722710206",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "往后要是还有类似的宝贝，敝店随时恭候您的光临。"
          },
          "722710208": {
            "id": "722710208",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "嗯，对于这种珍奇宝物，价比三家也是应该的。",
            "nextDialogs": [
              "722710209"
            ]
          },
          "722710209": {
            "id": "722710209",
            "speakerId": 2023,
            "speakerName": "琳琅",
            "text": "如果您考虑好了，可以再来找我。"
          }
        }
      }
    }
  ]

    {
      "subId": "4002101",
      "subQuestName": "与辛焱碰面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400210101"
        ],
        "dialogs": {
          "400210101": {
            "id": "400210101",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "旅行者，派蒙！",
            "nextDialogs": [
              "400210102"
            ]
          },
          "400210102": {
            "id": "400210102",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "刚才九条裟罗来了，就在那边。",
            "nextDialogs": [
              "400210103"
            ]
          },
          "400210103": {
            "id": "400210103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "她这去而复返的样子，是真对我们放心不下吧…警惕心很重呢。",
            "nextDialogs": [
              "400210104"
            ]
          },
          "400210104": {
            "id": "400210104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是认真负责的表现啦。",
            "nextDialogs": [
              "400210105"
            ]
          },
          "400210105": {
            "id": "400210105",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "情况有些复杂，我们先去跟她沟通吧。"
          }
        }
      }
    },
    {
      "subId": "4002102",
      "subQuestName": "与九条裟罗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400210201"
        ],
        "dialogs": {
          "400210201": {
            "id": "400210201",
            "speakerId": 1002,
            "speakerName": "九条裟罗",
            "text": "三位，这段时间有劳你们了。",
            "nextDialogs": [
              "400210202"
            ]
          },
          "400210202": {
            "id": "400210202",
            "speakerId": 1002,
            "speakerName": "九条裟罗",
            "text": "我带人手过来了，可以说，最危急的时刻已然过去。之后，我们只需扼守这条要道就能有效防备魔物，如有逃窜者，也可将它们封堵在荒海一带。",
            "nextDialogs": [
              "400210203"
            ]
          },
          "400210203": {
            "id": "400210203",
            "speakerId": 1002,
            "speakerName": "九条裟罗",
            "text": "先前我听见秘境内有巨大的响声，恐怕这里面有大量机关…我们正在筹备，打算等一个合适的时机举兵攻入。",
            "nextDialogs": [
              "400210204"
            ]
          },
          "400210204": {
            "id": "400210204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你们不打算驻扎在离秘境更近的地方吗？",
            "nextDialogs": [
              "400210205"
            ]
          },
          "400210205": {
            "id": "400210205",
            "speakerId": 1002,
            "speakerName": "九条裟罗",
            "text": "上次行动时，武士们没想到要跟秘境保持足够的距离。魔物突袭，他们只能仓皇后撤。",
            "nextDialogs": [
              "400210206"
            ]
          },
          "400210206": {
            "id": "400210206",
            "speakerId": 1002,
            "speakerName": "九条裟罗",
            "text": "一次是意外，两次是失误。我不会允许这种事再次发生。",
            "nextDialogs": [
              "400210207"
            ]
          },
          "400210207": {
            "id": "400210207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来是这样…",
            "nextDialogs": [
              "400210208"
            ]
          },
          "400210208": {
            "id": "400210208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（正好，给了我们机会。）",
            "nextDialogs": [
              "400210209"
            ]
          },
          "400210209": {
            "id": "400210209",
            "speakerId": 1002,
            "speakerName": "九条裟罗",
            "text": "稍后我将返回九条阵屋，统筹其他地区的防务。",
            "nextDialogs": [
              "400210210"
            ]
          },
          "400210210": {
            "id": "400210210",
            "speakerId": 1002,
            "speakerName": "九条裟罗",
            "text": "虽然来得晚了些，但天领奉行已接手这里，感谢三位鼎力相助。承诺的报酬，我也记着。",
            "nextDialogs": [
              "400210211"
            ]
          },
          "400210211": {
            "id": "400210211",
            "speakerId": 1002,
            "speakerName": "九条裟罗",
            "text": "辛焱小姐，请拿着这封信，里面有我亲自为你开具的「通行凭证」。",
            "nextDialogs": [
              "400210223"
            ]
          },
          "400210223": {
            "id": "400210223",
            "speakerId": 1002,
            "speakerName": "九条裟罗",
            "text": "我为你申请了最长的停留时限，希望你能利用这段时间在稻妻好好游览一番。",
            "nextDialogs": [
              "400210212"
            ]
          },
          "400210212": {
            "id": "400210212",
            "speakerId": 1002,
            "speakerName": "九条裟罗",
            "text": "此外我还为你安排了食宿，等回到城里，你直接照信中指示前往下榻处即可。",
            "nextDialogs": [
              "400210213"
            ]
          },
          "400210213": {
            "id": "400210213",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "天哪！这得算天降横财了吧？食宿全免，畅游稻妻！",
            "nextDialogs": [
              "400210214"
            ]
          },
          "400210214": {
            "id": "400210214",
            "speakerId": 1002,
            "speakerName": "九条裟罗",
            "text": "不必客气，理应如此。",
            "nextDialogs": [
              "400210215"
            ]
          },
          "400210215": {
            "id": "400210215",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "谢谢你啦。看你最近这么忙，也不知道什么时候才能闲下来…要是你休假时我还在稻妻，请来看看我的街演吧！",
            "nextDialogs": [
              "400210216"
            ]
          },
          "400210216": {
            "id": "400210216",
            "speakerId": 1002,
            "speakerName": "九条裟罗",
            "text": "实不相瞒，我对诗歌音律兴趣不大。但你帮了天领奉行许多，我想…有机会的话，我会去的。",
            "nextDialogs": [
              "400210217"
            ]
          },
          "400210217": {
            "id": "400210217",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这么一来，辛焱最操心的事就解决啦！",
            "nextDialogs": [
              "400210218"
            ]
          },
          "400210218": {
            "id": "400210218",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "不不，最让人操心的是「式大将」才对吧！接下来就无关我的个人利益了…作为朋友，我还得回去帮它。",
            "nextDialogs": [
              "400210219"
            ]
          },
          "400210219": {
            "id": "400210219",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "还有那位小哥，旅行者，我们肯定得去救他吧？",
            "nextDialogs": [
              "400210222"
            ]
          },
          "400210222": {
            "id": "400210222",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "那走吧，我们偷偷去找「式大将」会合！"
          }
        }
      }
    },
    {
      "subId": "4002103",
      "subQuestName": "前往「诀箓阴阳寮」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400210301"
        ],
        "dialogs": {
          "400210301": {
            "id": "400210301",
            "speakerId": 1003,
            "speakerName": "「式大将」",
            "text": "辛焱，旅行者，派蒙！",
            "nextDialogs": [
              "400210302"
            ]
          },
          "400210302": {
            "id": "400210302",
            "speakerId": 1003,
            "speakerName": "「式大将」",
            "text": "刚才有位女将领带着一些人手到这附近侦察。",
            "nextDialogs": [
              "400210303"
            ]
          },
          "400210303": {
            "id": "400210303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "她是天领奉行的人，九条裟罗。",
            "nextDialogs": [
              "400210304"
            ]
          },
          "400210304": {
            "id": "400210304",
            "speakerId": 1003,
            "speakerName": "「式大将」",
            "text": "九条裟罗…天领奉行有这么一号人吗？",
            "nextDialogs": [
              "400210305"
            ]
          },
          "400210305": {
            "id": "400210305",
            "speakerId": 1003,
            "speakerName": "「式大将」",
            "text": "我似乎听说过天领奉行主将的名字，是一位男性，叫九条…呃，什么来着？",
            "nextDialogs": [
              "400210306"
            ]
          },
          "400210306": {
            "id": "400210306",
            "speakerId": 1003,
            "speakerName": "「式大将」",
            "text": "有些记不清了，但我想起了一些琐事。我记得，晴之介和那位天领奉行的主将下过棋。",
            "nextDialogs": [
              "400210307"
            ]
          },
          "400210307": {
            "id": "400210307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个晴之介，莫非还是个有头有脸的人物？",
            "nextDialogs": [
              "400210308"
            ]
          },
          "400210308": {
            "id": "400210308",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "闲话稍后再说吧，趁没人发现，我们赶紧溜到阴阳寮里去。",
            "nextDialogs": [
              "400210309"
            ]
          },
          "400210309": {
            "id": "400210309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦，还要找那个丢了的家伙呢！快走快走！",
            "nextDialogs": [
              "400210310"
            ]
          },
          "400210310": {
            "id": "400210310",
            "speakerId": 1003,
            "speakerName": "「式大将」",
            "text": "好，各位，请随我来。"
          }
        }
      }
    },

      }
    },
    {
      "subId": "4002105",
      "subQuestName": "与公子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400210501"
        ],
        "dialogs": {
          "400210501": {
            "id": "400210501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！你在这里啊！",
            "nextDialogs": [
              "400210502"
            ]
          },
          "400210502": {
            "id": "400210502",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "哟，都来了吗。让我等了好久啊。",
            "nextDialogs": [
              "400210503"
            ]
          },
          "400210503": {
            "id": "400210503",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "你们错过了一场好戏，实在可惜。",
            "nextDialogs": [
              "400210504"
            ]
          },
          "400210504": {
            "id": "400210504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这家伙，状态看起来还不错嘛，看来没受伤。",
            "nextDialogs": [
              "400210505"
            ]
          },
          "400210505": {
            "id": "400210505",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "嗯？你们担心我了吗？",
            "nextDialogs": [
              "400210507",
              "400210509"
            ]
          },
          "400210507": {
            "id": "400210507",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "看来你很信得过我的实力啊。",
            "nextDialogs": [
              "400210510"
            ]
          },
          "400210510": {
            "id": "400210510",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "作为伙伴兼老对手，你一定知道的，这种出其不意的战斗场合最合我胃口。",
            "nextDialogs": [
              "400210511"
            ]
          },
          "400210511": {
            "id": "400210511",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "秘境重组期间，房间会上下移动，魔物也被带着四处乱窜。嗯！这几天，我打得很尽兴。",
            "nextDialogs": [
              "400210512"
            ]
          },
          "400210512": {
            "id": "400210512",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "还找到一些「拓本」，就是「式大将」需要的那种。里面应该藏有它的记忆和力量。",
            "nextDialogs": [
              "400210513"
            ]
          },
          "400210513": {
            "id": "400210513",
            "speakerId": 1000,
            "speakerName": "辛焱",
            "text": "正所谓来得早不如来得巧，赶快回收它们吧，「式大将」！"
          },
          "400210509": {
            "id": "400210509",
            "speakerId": 1004,
            "speakerName": "「公子」",
            "text": "真的？能让你操一点心，我还是挺有面子的嘛。"
          }
        }
      }
    },
    {
      "subId": "4002115",

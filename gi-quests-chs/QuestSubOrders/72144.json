    {
      "subId": "7214412",
      "subQuestName": "与胭儿对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441201"
        ],
        "dialogs": {
          "721441201": {
            "id": "721441201",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "#{NICKNAME}阁下，请问有消息了吗？",
            "nextDialogs": [
              "721441204"
            ]
          },
          "721441204": {
            "id": "721441204",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "这样啊…",
            "nextDialogs": [
              "721441205"
            ]
          },
          "721441205": {
            "id": "721441205",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "没关系。如果找到了她，请尽快告诉我。"
          }
        }
      }
    },
    {
      "subId": "7214414",
      "subQuestName": "与胭儿对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721442101"
        ],
        "dialogs": {
          "721442101": {
            "id": "721442101",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "哦哦，是礼物吗？谢谢！",
            "nextDialogs": [
              "721442102"
            ]
          },
          "721442102": {
            "id": "721442102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是广海的心意。",
            "nextDialogs": [
              "721442103"
            ]
          },
          "721442103": {
            "id": "721442103",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "广海…那是谁啊？",
            "nextDialogs": [
              "721442106"
            ]
          },
          "721442106": {
            "id": "721442106",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "抱歉，我可不能认识抓贼的差人。",
            "nextDialogs": [
              "721442107"
            ]
          },
          "721442107": {
            "id": "721442107",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "尤其是笨蛋，尤其不行。",
            "nextDialogs": [
              "721442108"
            ]
          },
          "721442108": {
            "id": "721442108",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "不过…请替我谢谢他归还我的徽章。",
            "nextDialogs": [
              "721442109"
            ]
          },
          "721442109": {
            "id": "721442109",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "还有，「乌有亭」，不错的名字。有时间的话我会去喝几杯的。",
            "nextDialogs": [
              "721442110"
            ]
          },
          "721442110": {
            "id": "721442110",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "喝几杯，顺便认识认识那个笨蛋好了。"
          }
        }
      }
    },
    {
      "subId": "7214409",
      "subQuestName": "回去找广海",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440601"
        ],
        "dialogs": {
          "721440601": {
            "id": "721440601",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "怎么样，有「大姐」的消息了吗？",
            "nextDialogs": [
              "721440602"
            ]
          },
          "721440602": {
            "id": "721440602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们说过话了。",
            "nextDialogs": [
              "721440603"
            ]
          },
          "721440603": {
            "id": "721440603",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "她怎么说？会不会已经忘记我了？",
            "nextDialogs": [
              "721440604"
            ]
          },
          "721440604": {
            "id": "721440604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她不认识广海。",
            "nextDialogs": [
              "721440605"
            ]
          },
          "721440605": {
            "id": "721440605",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "可是…！",
            "nextDialogs": [
              "721440606"
            ]
          },
          "721440606": {
            "id": "721440606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为她不能认识差人。",
            "nextDialogs": [
              "721440607"
            ]
          },
          "721440607": {
            "id": "721440607",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "……",
            "nextDialogs": [
              "721440608"
            ]
          },
          "721440608": {
            "id": "721440608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "笨蛋尤其不行。",
            "nextDialogs": [
              "721440609"
            ]
          },
          "721440609": {
            "id": "721440609",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "唔…",
            "nextDialogs": [
              "721440610"
            ]
          },
          "721440610": {
            "id": "721440610",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不过她觉得…",
            "nextDialogs": [
              "721440611"
            ]
          },
          "721440611": {
            "id": "721440611",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "她觉得？",
            "nextDialogs": [
              "721440612"
            ]
          },
          "721440612": {
            "id": "721440612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以试着认识一下。",
            "nextDialogs": [
              "721440613"
            ]
          },
          "721440613": {
            "id": "721440613",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "欸…？",
            "nextDialogs": [
              "721440614"
            ]
          },
          "721440614": {
            "id": "721440614",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "像是约会邀请呢。",
            "nextDialogs": [
              "721440615"
            ]
          },
          "721440615": {
            "id": "721440615",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "欸！欸？！你是这么理解的吗！",
            "nextDialogs": [
              "721440616"
            ]
          },
          "721440616": {
            "id": "721440616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很奇怪吗…？",
            "nextDialogs": [
              "721440617"
            ]
          },
          "721440617": {
            "id": "721440617",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "没、没有…我只是…这样的回复…我还没准备好如何接受。",
            "nextDialogs": [
              "721440618"
            ]
          },
          "721440618": {
            "id": "721440618",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我替你赴约也可以。",
            "nextDialogs": [
              "721440619"
            ]
          },
          "721440619": {
            "id": "721440619",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "唔…！这个就不用了！我自己会好好把握的！",
            "nextDialogs": [
              "721440620"
            ]
          },
          "721440620": {
            "id": "721440620",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "只是…她没有提到何时去「认识一下」吗？",
            "nextDialogs": [
              "721440623"
            ]
          },
          "721440623": {
            "id": "721440623",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "#你说的也对…不管怎样，谢谢你了，{NICKNAME}阁下。",
            "nextDialogs": [
              "721440624"
            ]
          },
          "721440624": {
            "id": "721440624",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "或许我还需要时间消化她说的话，但幸好，得到的并不是令我失望的结果。",
            "nextDialogs": [
              "721440625"
            ]
          },
          "721440625": {
            "id": "721440625",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "这段时间辛苦你了，实在是不好意思。这里是你的报酬。",
            "nextDialogs": [
              "721440626"
            ]
          },
          "721440626": {
            "id": "721440626",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别忘了，「乌有亭」。",
            "nextDialogs": [
              "721440627"
            ]
          },
          "721440627": {
            "id": "721440627",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "嗯嗯，谢谢！",
            "nextDialogs": [
              "721440628"
            ]
          },
          "721440628": {
            "id": "721440628",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "#顺便，{NICKNAME}阁下，祝你在稻妻一切顺利。"
          }
        }
      }
    },
    {
      "subId": "7214401",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440101"
        ],
        "dialogs": {
          "721440101": {
            "id": "721440101",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "喂，可疑的外国人！在这里鬼鬼祟祟的做什么呢？",
            "nextDialogs": [
              "721440104"
            ]
          },
          "721440104": {
            "id": "721440104",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "外国人，如果没有要事请不要打扰我，不然就请随我到远国监司待问。",
            "nextDialogs": [
              "721440105"
            ]
          },
          "721440105": {
            "id": "721440105",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "虽然我不知道你是怎么来到这里的，但妨碍武士公务可是重罪。",
            "nextDialogs": [
              "721440106"
            ]
          },
          "721440106": {
            "id": "721440106",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "勘定奉行大人若是得知，定会从严发落。",
            "nextDialogs": [
              "721440107"
            ]
          },
          "721440107": {
            "id": "721440107",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "为了你自身的安全，我劝你离我远点。",
            "nextDialogs": [
              "721440108"
            ]
          },
          "721440108": {
            "id": "721440108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "勘定奉行？",
            "nextDialogs": [
              "721440109"
            ]
          },
          "721440109": {
            "id": "721440109",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "怎么？如今的外国人，连奉行大人都不怕了吗？"
          }
        }
      }
    },
    {
      "subId": "7214408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440801"
        ],
        "dialogs": {
          "721440801": {
            "id": "721440801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是在等谁吗？",
            "nextDialogs": [
              "721440802"
            ]
          },
          "721440802": {
            "id": "721440802",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "…是又如何。"
          }
        }
      }
    },
    {
      "subId": "7214409",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440901"
        ],
        "dialogs": {
          "721440901": {
            "id": "721440901",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "有话快说，盗宝团可浪费不起时间。"
          }
        }
      }
    },
    {
      "subId": "7214410",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441001"
        ],
        "dialogs": {
          "721441001": {
            "id": "721441001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于广海…",
            "nextDialogs": [
              "721441002"
            ]
          },
          "721441002": {
            "id": "721441002",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "他呀，是个好人…只可惜还是个大男孩，还需要时间慢慢长大。",
            "nextDialogs": [
              "721441003"
            ]
          },
          "721441003": {
            "id": "721441003",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "不过要我看，不成熟也比长坏了强。",
            "nextDialogs": [
              "721441004"
            ]
          },
          "721441004": {
            "id": "721441004",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "他有他的生计，有他的职责…",
            "nextDialogs": [
              "721441005"
            ]
          },
          "721441005": {
            "id": "721441005",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "不敢做出抉择，也不全是他的错吧。",
            "nextDialogs": [
              "721441006"
            ]
          },
          "721441006": {
            "id": "721441006",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "不过至少，他还有得选。"
          }
        }
      }
    },
    {
      "subId": "7214413",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441301"
        ],
        "dialogs": {
          "721441301": {
            "id": "721441301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别紧张，问问而已。",
            "nextDialogs": [
              "721441302"
            ]
          },
          "721441302": {
            "id": "721441302",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "请不要在我执勤时问无聊的问题。",
            "nextDialogs": [
              "721441303"
            ]
          },
          "721441303": {
            "id": "721441303",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "好了，请不要再打扰我了，请自觉离开吧。"
          }
        }
      }
    },
    {
      "subId": "7214415",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441501"
        ],
        "dialogs": {
          "721441501": {
            "id": "721441501",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "请快去追捕贼人吧，莫要让我拖累了足下的脚步。",
            "nextDialogs": [
              "721441502"
            ]
          },
          "721441502": {
            "id": "721441502",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "哦，原来如此！想必足下是专程回来帮我采摘——",
            "nextDialogs": [
              "721441503"
            ]
          },
          "721441503": {
            "id": "721441503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "告辞！"
          }
        }
      }
    },
    {
      "subId": "7214416",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441601"
        ],
        "dialogs": {
          "721441601": {
            "id": "721441601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在这里做什么呢？",
            "nextDialogs": [
              "721441602"
            ]
          },
          "721441602": {
            "id": "721441602",

  },
  "subQuests": [
    {
      "subId": "7214401",
      "subQuestName": "(test)(隐藏)古云有螭和漂流瓶任务检测$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440701"
        ],
        "dialogs": {
          "721440701": {
            "id": "721440701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么？",
            "nextDialogs": [
              "721440702"
            ]
          },
          "721440702": {
            "id": "721440702",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "与你无关。",
            "nextDialogs": [
              "721440703"
            ]
          },
          "721440703": {
            "id": "721440703",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "好了，这次就…放你一马，请不要打扰我了。"
          }
        }
      }
    },
    {
      "subId": "7214410",
      "subQuestName": "(test)(隐藏)第二次跟广海对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441401"
        ],
        "dialogs": {
          "721441401": {
            "id": "721441401",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "…你怎么又来了？有话请快说！",
            "nextDialogs": [
              "721441402"
            ]
          },
          "721441402": {
            "id": "721441402",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "请不要妨碍我等人！",
            "nextDialogs": [
              "721441403"
            ]
          },
          "721441403": {
            "id": "721441403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在远离辖区的地方等人？",
            "nextDialogs": [
              "721441404"
            ]
          },
          "721441404": {
            "id": "721441404",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "你想说什么？",
            "nextDialogs": [
              "721441405"
            ]
          },
          "721441405": {
            "id": "721441405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "等的不是正经人吧？",
            "nextDialogs": [
              "721441406"
            ]
          },
          "721441406": {
            "id": "721441406",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "当、当然不…你在质疑奉行方的公务人员吗！",
            "nextDialogs": [
              "721441407"
            ]
          },
          "721441407": {
            "id": "721441407",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "我是在执行公务，在这里等待…专业线人…接头…",
            "nextDialogs": [
              "721441408"
            ]
          },
          "721441408": {
            "id": "721441408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "声音越来越小了呢。",
            "nextDialogs": [
              "721441409"
            ]
          },
          "721441409": {
            "id": "721441409",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "够了！离开，不然就以妨碍公务的罪名，请你跟我到远国监司走一趟！",
            "nextDialogs": [
              "721441412"
            ]
          },
          "721441412": {
            "id": "721441412",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "？！",
            "nextDialogs": [
              "721441413"
            ]
          },
          "721441413": {
            "id": "721441413",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "你就不怕被奉行大人治罪，被驱逐出境吗？"
          }
        }
      }
    },
    {
      "subId": "7214411",
      "subQuestName": "(test)(隐藏)与广海交付漂流瓶$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721441101"
        ],
        "dialogs": {
          "721441101": {
            "id": "721441101",
            "speakerId": 2418,
            "speakerName": "小雀儿",
            "text": "有什么话请找我师兄说吧，反正你也不爱听我说话。",
            "nextDialogs": [
              "721441102"
            ]
          },
          "721441102": {
            "id": "721441102",
            "speakerId": 2418,
            "speakerName": "小雀儿",
            "text": "哼…就没人爱听我说话…"
          }
        }
      }
    },
    {
      "subId": "7214413",
      "subQuestName": "(test)(隐藏)与广海交付漂流瓶后的对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721442001"
        ],
        "dialogs": {
          "721442001": {
            "id": "721442001",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "是这个没错！里面还有她的徽章。",
            "nextDialogs": [
              "721442002"
            ]
          },
          "721442002": {
            "id": "721442002",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "真不知该如何感谢你…",
            "nextDialogs": [
              "721442003"
            ]
          },
          "721442003": {
            "id": "721442003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不介意我拆开读一读吧？",
            "nextDialogs": [
              "721442004"
            ]
          },
          "721442004": {
            "id": "721442004",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "欸？什么？请不要…",
            "nextDialogs": [
              "721442005"
            ]
          },
          "721442005": {
            "id": "721442005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「还记得『乌有亭』吗？」",
            "nextDialogs": [
              "721442006"
            ]
          },
          "721442006": {
            "id": "721442006",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "唔…？",
            "nextDialogs": [
              "721442007"
            ]
          },
          "721442007": {
            "id": "721442007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「我们会在那里相聚…」",
            "nextDialogs": [
              "721442008"
            ]
          },
          "721442008": {
            "id": "721442008",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "等等——",
            "nextDialogs": [
              "721442009"
            ]
          },
          "721442009": {
            "id": "721442009",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「酒钱也随信寄来了。」",
            "nextDialogs": [
              "721442010"
            ]
          },
          "721442010": {
            "id": "721442010",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "好了，我说…",
            "nextDialogs": [
              "721442011"
            ]
          },
          "721442011": {
            "id": "721442011",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「如果收到这封信的您…」",
            "nextDialogs": [
              "721442012"
            ]
          },
          "721442012": {
            "id": "721442012",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "#请不要再念了！{NICKNAME}阁下，这样太没教养了！",
            "nextDialogs": [
              "721442015"
            ]
          },
          "721442015": {
            "id": "721442015",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "请不要再戏弄我了！如果想要帮忙就请直说吧！"
          }
        }
      }
    },
    {
      "subId": "7214403",
      "subQuestName": "前往鸣神岛北端寻找阿顺的踪迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440201"
        ],
        "dialogs": {
          "721440201": {
            "id": "721440201",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "欸，你怎么来了？而且还带着人？",
            "nextDialogs": [
              "721440202"
            ]
          },
          "721440202": {
            "id": "721440202",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "这和上次说的可不一样，我们不是说好单独见面了吗？",
            "nextDialogs": [
              "721440203"
            ]
          },
          "721440203": {
            "id": "721440203",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "哦，我明白了…如果是「那件」案子的话，告诉你的同事，现在还不是时候。",
            "nextDialogs": [
              "721440204"
            ]
          },
          "721440204": {
            "id": "721440204",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "不是那件案子…是上个星期，你答应我的那件事…",
            "nextDialogs": [
              "721440205"
            ]
          },
          "721440205": {
            "id": "721440205",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "不是那件？那是哪件…这阵子我可是守法得很，一件案子都没犯过！",
            "nextDialogs": [
              "721440206"
            ]
          },
          "721440206": {
            "id": "721440206",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "我们约好的不是这个时候啊，距离上次抓我坐牢也才半个月…",
            "nextDialogs": [
              "721440207"
            ]
          },
          "721440207": {
            "id": "721440207",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "哦，我明白了…你是想提前抓了我领功吧！",
            "nextDialogs": [
              "721440208"
            ]
          },
          "721440208": {
            "id": "721440208",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "你什么都没明白…你这种人抓了能领到什么功！",
            "nextDialogs": [
              "721440209"
            ]
          },
          "721440209": {
            "id": "721440209",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "你这么说可就太伤人了，我多少算是盗宝团的干部…在道上也是有名声的。",
            "nextDialogs": [
              "721440210"
            ]
          },
          "721440210": {
            "id": "721440210",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "哦，我明白了…你一定是——",
            "nextDialogs": [
              "721440213"
            ]
          },
          "721440213": {
            "id": "721440213",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "唉…",
            "nextDialogs": [
              "721440214"
            ]
          },
          "721440214": {
            "id": "721440214",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "盗宝团都不知道，你同事是新来的？",
            "nextDialogs": [
              "721440215"
            ]
          },
          "721440215": {
            "id": "721440215",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "你闭嘴。",
            "nextDialogs": [
              "721440216"
            ]
          },
          "721440216": {
            "id": "721440216",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "#是这样的，{NICKNAME}阁下…这位阿顺，是我的线人。恳请阁下千万不要对此多加议论…",
            "nextDialogs": [
              "721440217"
            ]
          },
          "721440217": {
            "id": "721440217",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "今天我与这位外国…朋友来，正是想拜托你告知「大姐」的下落，我…很想和她再次联络。",
            "nextDialogs": [
              "721440218"
            ]
          },
          "721440218": {
            "id": "721440218",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "哦——哈哈哈哈哈！",
            "nextDialogs": [
              "721440219"
            ]
          },
          "721440219": {
            "id": "721440219",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "笑什么，你有什么毛病吗！",
            "nextDialogs": [
              "721440220"
            ]
          },
          "721440220": {
            "id": "721440220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你有什么毛病吗！",
            "nextDialogs": [
              "721440221"
            ]
          },
          "721440221": {
            "id": "721440221",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "哈哈哈哈哈，你可真有意思！",
            "nextDialogs": [
              "721440222"
            ]
          },
          "721440222": {
            "id": "721440222",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "不瞒你说，旅行者。我们三个人从尿裤子的年纪就认识了。",
            "nextDialogs": [
              "721440223"
            ]
          },
          "721440223": {
            "id": "721440223",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "那时候没有「锁国令」。广海这家伙，也不像现在这样死板。",
            "nextDialogs": [
              "721440224"
            ]
          },
          "721440224": {
            "id": "721440224",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "唉，瞧瞧奉行府的规训，把一个好孩子变成了什么样子。",
            "nextDialogs": [
              "721440225"
            ]
          },
          "721440225": {
            "id": "721440225",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "把一个好孩子变成了保护民众的奉公者，把一个坏孩子变成了盗宝团的贼。",
            "nextDialogs": [
              "721440226"
            ]
          },
          "721440226": {
            "id": "721440226",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "行了行了，「锁国令」推行之前，你不就早知道我们的身份了？",
            "nextDialogs": [
              "721440227"
            ]
          },
          "721440227": {
            "id": "721440227",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "她也是因为顾虑这点才离开稻妻的。",
            "nextDialogs": [
              "721440228"
            ]
          },
          "721440228": {
            "id": "721440228",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "我猜你又在信里写了「乌有亭」吧？我也挺怀念的。",
            "nextDialogs": [
              "721440229"
            ]
          },
          "721440229": {
            "id": "721440229",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "「锁国令」下达的前一天，我们还在那里喝了饯别酒。",
            "nextDialogs": [
              "721440230"
            ]
          },
          "721440230": {
            "id": "721440230",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "你的小心思，谁都看得出来。",
            "nextDialogs": [
              "721440231"
            ]
          },
          "721440231": {
            "id": "721440231",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "就是可惜了，你们的将军并不喜欢外国来的漂流客。",
            "nextDialogs": [
              "721440232"
            ]
          },
          "721440232": {
            "id": "721440232",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "…请直接谈正事。",
            "nextDialogs": [
              "721440233"
            ]
          },
          "721440233": {
            "id": "721440233",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "这也算不得正事吧？",
            "nextDialogs": [
              "721440234"
            ]
          },
          "721440234": {
            "id": "721440234",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "好啦，不逗你了。这个忙我真心想帮，但可惜…帮不上。",
            "nextDialogs": [
              "721440235"
            ]
          },
          "721440235": {
            "id": "721440235",
            "speakerId": 3088,
            "speakerName": "广海",
            "text": "什么意思？",
            "nextDialogs": [
              "721440236"
            ]
          },
          "721440236": {
            "id": "721440236",
            "speakerId": 20260,
            "speakerName": "阿顺",
            "text": "…说来话长。"
          }
        }
      }
    },
    {
      "subId": "7214404",
      "subQuestName": "前往绝云间，寻找孙宇与小雀儿",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440301"
        ],
        "dialogs": {
          "721440301": {
            "id": "721440301",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "啊，是旅行者啊。足下的高义大名，璃月港无人不知，无人不晓。请问此次前来是…",
            "nextDialogs": [
              "721440302"
            ]
          },
          "721440302": {
            "id": "721440302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你说话怪怪的。",
            "nextDialogs": [
              "721440303"
            ]
          },
          "721440303": {
            "id": "721440303",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "想必那是因为，敝人正在教师妹学习待人接物的礼仪，正所谓「人无信不立，人无礼…",
            "nextDialogs": [
              "721440306"
            ]
          },
          "721440306": {
            "id": "721440306",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "请问有什么事吗？",
            "nextDialogs": [
              "721440307"
            ]
          },
          "721440307": {
            "id": "721440307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我在找一个女贼。",
            "nextDialogs": [
              "721440308"
            ]
          },
          "721440308": {
            "id": "721440308",
            "speakerId": 2400,
            "speakerName": "孙宇",
            "text": "哦，原来是追捕贼人的侠义之举，古华派定然支持！那么需要我们帮助吗？"
          }
        }
      }
    },
    {
      "subId": "7214405",
      "subQuestName": "前往琥牢山，寻找「大姐」的踪迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440501"
        ],
        "dialogs": {
          "721440501": {
            "id": "721440501",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "所以，你一定是有事相求才来找我吧？",
            "nextDialogs": [
              "721440504"
            ]
          },
          "721440504": {
            "id": "721440504",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "你骗不过我。",
            "nextDialogs": [
              "721440505"
            ]
          },
          "721440505": {
            "id": "721440505",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "外来旅者的呆脸，再努力也是存不住秘密的。"
          }
        }
      }
    },
    {
      "subId": "7214406",
      "subQuestName": "与「大姐」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721440401"
        ],
        "dialogs": {
          "721440401": {
            "id": "721440401",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "咳咳…咳…！哈…哈…呼，终于出来了…",
            "nextDialogs": [
              "721440402"
            ]
          },
          "721440402": {
            "id": "721440402",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "多谢救我一命…陌生…人…？",
            "nextDialogs": [
              "721440403"
            ]
          },
          "721440403": {
            "id": "721440403",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "欸？！是你！",
            "nextDialogs": [
              "721440404"
            ]
          },
          "721440404": {
            "id": "721440404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是…",
            "nextDialogs": [
              "721440405"
            ]
          },
          "721440405": {
            "id": "721440405",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "你不是那个…那个…！",
            "nextDialogs": [
              "721440406"
            ]
          },
          "721440406": {
            "id": "721440406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "啊，「那个」啊…",
            "nextDialogs": [
              "721440407"
            ]
          },
          "721440407": {
            "id": "721440407",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "对！还有轻策庄那个…那个…！",
            "nextDialogs": [
              "721440408"
            ]
          },
          "721440408": {
            "id": "721440408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯嗯！就是「那个」！",
            "nextDialogs": [
              "721440409"
            ]
          },
          "721440409": {
            "id": "721440409",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "对对对！啊，所以…螭的遗骸，真的有用吗…？",
            "nextDialogs": [
              "721440412"
            ]
          },
          "721440412": {
            "id": "721440412",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "啊——哈哈哈哈！",
            "nextDialogs": [
              "721440413"
            ]
          },
          "721440413": {
            "id": "721440413",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "原来在轻策庄就是你把我的小兄弟们都打趴下了，可真有你的。",
            "nextDialogs": [
              "721440414"
            ]
          },
          "721440414": {
            "id": "721440414",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "不管怎么说，这次多谢你救我脱险了。",
            "nextDialogs": [
              "721440415"
            ]
          },
          "721440415": {
            "id": "721440415",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "不然不知这破琥珀要把我封多久…里面可是难受死了…",
            "nextDialogs": [
              "721440416"
            ]
          },
          "721440416": {
            "id": "721440416",
            "speakerId": 20082,
            "speakerName": "胭儿",
            "text": "绝云间的仙人呀，个个小心眼！"
          }
        }
      }
    },

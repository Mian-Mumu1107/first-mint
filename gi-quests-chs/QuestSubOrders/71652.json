      }
    },
    {
      "subId": "7165205",
      "subQuestName": "向胡塞尼回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716520501"
        ],
        "dialogs": {
          "716520501": {
            "id": "716520501",
            "speakerId": 30049,
            "speakerName": "胡塞尼",
            "text": "我已经通过数据接收装置记录下所有数据了，你的战斗非常精彩。",
            "nextDialogs": [
              "716520503",
              "716520505"
            ]
          },
          "716520503": {
            "id": "716520503",
            "speakerId": 30049,
            "speakerName": "胡塞尼",
            "text": "真是谦逊的回答啊，但我仍要感谢你为追求智慧付出的努力。",
            "nextDialogs": [
              "716520506"
            ]
          },
          "716520506": {
            "id": "716520506",
            "speakerId": 30050,
            "speakerName": "盈珠",
            "text": "如果没有你的话，那处秘境我们根本没办法进去，毕竟实在太危险了。",
            "nextDialogs": [
              "716520507"
            ]
          },
          "716520507": {
            "id": "716520507",
            "speakerId": 30050,
            "speakerName": "盈珠",
            "text": "你也挽救了协会的声誉，感谢你，旅行者。",
            "nextDialogs": [
              "716520508"
            ]
          },
          "716520508": {
            "id": "716520508",
            "speakerId": 30049,
            "speakerName": "胡塞尼",
            "text": "可惜「地脉之果」已经碎成那么多片，关于「地脉之果」的研究没办法继续了。",
            "nextDialogs": [
              "716520509"
            ]
          },
          "716520509": {
            "id": "716520509",
            "speakerId": 30049,
            "speakerName": "胡塞尼",
            "text": "现在起，将研究方向改成「导能原盘」的话，或许还来得及…",
            "nextDialogs": [
              "716520510"
            ]
          },
          "716520510": {
            "id": "716520510",
            "speakerId": 30050,
            "speakerName": "盈珠",
            "text": "非常抱歉，胡塞尼先生，冒险家协会会负责到底。",
            "nextDialogs": [
              "716520511"
            ]
          },
          "716520511": {
            "id": "716520511",
            "speakerId": 30050,
            "speakerName": "盈珠",
            "text": "旅行者，如果你在旅途过程中发现了更多的「地脉之果」碎片，能拜托你收集起来吗？",
            "nextDialogs": [
              "716520512"
            ]
          },
          "716520512": {
            "id": "716520512",
            "speakerId": 30050,
            "speakerName": "盈珠",
            "text": "借助原盘的力量，挑战那些连我也不敢进入的秘境，这样一定能收集到更多数据，也能帮上胡塞尼先生的忙吧。",
            "nextDialogs": [
              "716520513"
            ]
          },
          "716520513": {
            "id": "716520513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明白了。",
            "nextDialogs": [
              "716520514"
            ]
          },
          "716520514": {
            "id": "716520514",
            "speakerId": 30050,
            "speakerName": "盈珠",
            "text": "感谢你的协助，旅行者，祝你旅途顺利。向着星辰与深渊。"
          },
          "716520505": {
            "id": "716520505",
            "speakerId": 30049,
            "speakerName": "胡塞尼",
            "text": "哈哈，你确实是一位战斗大师。"
          }
        }
      }
    }
  ]
}
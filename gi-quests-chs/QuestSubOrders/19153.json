    {
      "subId": "1915303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191530308"
        ],
        "dialogs": {
          "191530308": {
            "id": "191530308",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "在闲聊中度过了很长的时间。",
            "nextDialogs": [
              "191530397"
            ]
          },
          "191530397": {
            "id": "191530397",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有关你潜入智慧宫，还有各种超能力的传说，都是怎么回事？",
            "nextDialogs": [
              "191530398"
            ]
          },
          "191530398": {
            "id": "191530398",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "仙灵会捉弄人是怎么回事？",
            "nextDialogs": [
              "191530399"
            ]
          },
          "191530399": {
            "id": "191530399",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你就是仙灵吧。"
          }
        }
      }
    },
    {
      "subId": "1915308",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191530801"
        ],
        "dialogs": {
          "191530801": {
            "id": "191530801",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "大家提供了很多有价值的消息，我们来整理一下吧。",
            "nextDialogs": [
              "191530802"
            ]
          },
          "191530802": {
            "id": "191530802",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "虽然有些听上去很容易理解，另外的就很匪夷所思了…",
            "nextDialogs": [
              "191530803"
            ]
          },
          "191530803": {
            "id": "191530803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应该能掌握它的身份和行踪吧。",
            "nextDialogs": [
              "191530804"
            ]
          },
          "191530804": {
            "id": "191530804",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "嗯，我试试看，让我想想。",
            "nextDialogs": [
              "191530805"
            ]
          },
          "191530805": {
            "id": "191530805",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "（莱依拉啊莱依拉，冷静下来，虽然线索很乱，但你一定没问题。）",
            "nextDialogs": [
              "191530806"
            ]
          },
          "191530806": {
            "id": "191530806",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "（首先根据已有的线索联想出仙灵的身份。）",
            "nextDialogs": [
              "191530807"
            ]
          },
          "191530807": {
            "id": "191530807",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "（接下来再分析它的行动轨迹和行为动机，最后结合之前的推论…）",
            "nextDialogs": [
              "191530808"
            ]
          },
          "191530808": {
            "id": "191530808",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "（这样大概就能得到行动策略了吧，嗯，按这种想法试试看。）"
          }
        }
      }
    },
    {
      "subId": "1915309",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191530901"
        ],
        "dialogs": {
          "191530901": {
            "id": "191530901",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "原来是这样…",
            "nextDialogs": [
              "191530902"
            ]
          },
          "191530902": {
            "id": "191530902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "分析给我听听吧。",
            "nextDialogs": [
              "191530903"
            ]
          },
          "191530903": {
            "id": "191530903",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "嗯，首先根据卡塔扬提供的信息，基本可以推断出仙灵的真实身份是梨多梵谛学院的学生。",
            "nextDialogs": [
              "191530904"
            ]
          },
          "191530904": {
            "id": "191530904",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "毕竟所有外来者的可能性已经被排除，也没办法绕过管理员拿走那两本书。",
            "nextDialogs": [
              "191530905"
            ]
          },
          "191530905": {
            "id": "191530905",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "接下来，排除匪夷所思的超能力本身不提，所有目击地点皆为我们学院官方推荐的星相观测地。",
            "nextDialogs": [
              "191530906"
            ]
          },
          "191530906": {
            "id": "191530906",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "换句话说…它可能只是在做研究，而且研究内容与我很相似。",
            "nextDialogs": [
              "191530907"
            ]
          },
          "191530907": {
            "id": "191530907",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "我向它提出的问题并不简单，但它可以在一天时间里给我答复，说明它掌握了相似的背景知识。",
            "nextDialogs": [
              "191530908"
            ]
          },
          "191530908": {
            "id": "191530908",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "那么，只需要根据这个推测，去下一个星相观测地等待它就行了。",
            "nextDialogs": [
              "191530911"
            ]
          },
          "191530911": {
            "id": "191530911",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "过、过奖啦…其实还有些别的理由，是一直以来的猜想。",
            "nextDialogs": [
              "191530912"
            ]
          },
          "191530912": {
            "id": "191530912",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "不过这不重要，我们先去吧，就算有了线索，能不能有结论还很难说…",
            "nextDialogs": [
              "191530913"
            ]
          },
          "191530913": {
            "id": "191530913",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "至于为什么我会这样想…如果它真的没有来的话，我就和你讲一讲吧。"
          }
        }
      }
    },
    {
      "subId": "1915399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191539901"
        ],
        "dialogs": {
          "191539901": {
            "id": "191539901",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "（我想想，好像是这样的…）",
            "nextDialogs": [
              "191539909"
            ]
          },
          "191539909": {
            "id": "191539909",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "上面的视野好像会更好一点，但是要怎么上去呢？",
            "nextDialogs": [
              "191539910"
            ]
          },
          "191539910": {
            "id": "191539910",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "试试看这附近的元素方碑吧。"
          }
        }
      }
    }
  ]
}
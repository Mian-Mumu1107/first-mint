    "艾琪诺": 1,
    "阿黛尔": 8
  },
  "subQuests": [
    {
      "subId": "1401701",
      "subQuestName": "前往白淞镇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140170101"
        ],
        "dialogs": {
          "140170101": {
            "id": "140170101",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "阿黛尔，我们回来了，给你从枫丹廷带了礼物。",
            "nextDialogs": [
              "140170102"
            ]
          },
          "140170102": {
            "id": "140170102",
            "speakerId": 13399,
            "speakerName": "阿黛尔",
            "text": "呜哇，谢谢老板！",
            "nextDialogs": [
              "140170103"
            ]
          },
          "140170103": {
            "id": "140170103",
            "speakerId": 13321,
            "speakerName": "科拉莉",
            "text": "不要这么叫，你应该叫娜维娅姐姐，知道吗？",
            "nextDialogs": [
              "140170104"
            ]
          },
          "140170104": {
            "id": "140170104",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "哈哈哈，没关系啦。不只是有礼物，你们看是谁来了？",
            "nextDialogs": [
              "140170105"
            ]
          },
          "140170105": {
            "id": "140170105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好久不见啊。",
            "nextDialogs": [
              "140170106"
            ]
          },
          "140170106": {
            "id": "140170106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们好。",
            "nextDialogs": [
              "140170107"
            ]
          },
          "140170107": {
            "id": "140170107",
            "speakerId": 13321,
            "speakerName": "科拉莉",
            "text": "是你们啊，好久不见，之前的事情，非常谢谢你们的帮助。",
            "nextDialogs": [
              "140170108"
            ]
          },
          "140170108": {
            "id": "140170108",
            "speakerId": 13321,
            "speakerName": "科拉莉",
            "text": "听说你们还拯救了整个枫丹，真是了不起的大英雄。",
            "nextDialogs": [
              "140170109"
            ]
          },
          "140170109": {
            "id": "140170109",
            "speakerId": 13399,
            "speakerName": "阿黛尔",
            "text": "你们很厉害，能和厉害的人做朋友的娜维娅姐姐，也很厉害！",
            "nextDialogs": [
              "140170110"
            ]
          },
          "140170110": {
            "id": "140170110",
            "speakerId": 13399,
            "speakerName": "阿黛尔",
            "text": "这个里面是什么啊，我能看看吗？",
            "nextDialogs": [
              "140170111"
            ]
          },
          "140170111": {
            "id": "140170111",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "当然可以。",
            "nextDialogs": [
              "140170112"
            ]
          },
          "140170112": {
            "id": "140170112",
            "speakerId": 13399,
            "speakerName": "阿黛尔",
            "text": "哦，是…是刺玫会的制服！是送给我的吗？但是…好大啊，我穿不了。",
            "nextDialogs": [
              "140170113"
            ]
          },
          "140170113": {
            "id": "140170113",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "是送给未来的你的制服。之前你说想要加入刺玫会，能听到你这么说，我心里非常开心。",
            "nextDialogs": [
              "140170114"
            ]
          },
          "140170114": {
            "id": "140170114",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "但刺玫会需要保护大家的安全，所以会遭遇各种各样的危险，现在你还很小，我们不想让你的母亲担心。",
            "nextDialogs": [
              "140170115"
            ]
          },
          "140170115": {
            "id": "140170115",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "所以那时候拒绝了你，说需要你再长大一点。这件衣服，就是我们的约定啦。",
            "nextDialogs": [
              "140170116"
            ]
          },
          "140170116": {
            "id": "140170116",
            "speakerId": 13399,
            "speakerName": "阿黛尔",
            "text": "原来是这样，好的，谢谢娜维娅姐姐！我会努力长大的！",
            "nextDialogs": [
              "140170117"
            ]
          },
          "140170117": {
            "id": "140170117",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "呵呵，长大不是努力来的哦，要保持耐心。",
            "nextDialogs": [
              "140170118"
            ]
          },
          "140170118": {
            "id": "140170118",
            "speakerId": 13321,
            "speakerName": "科拉莉",
            "text": "你们能把我女儿的事情放在心上，我非常感激。",
            "nextDialogs": [
              "140170119"
            ]
          },
          "140170119": {
            "id": "140170119",
            "speakerId": 13321,
            "speakerName": "科拉莉",
            "text": "有刺玫会的照顾，就算她的父亲已经不在我们的身边，我们依然能感受到温暖与安全感。",
            "nextDialogs": [
              "140170120"
            ]
          },
          "140170120": {
            "id": "140170120",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "不用这么客气，不管是不是刺玫会的成员，只要住在白淞镇，我们就是一家人。",
            "nextDialogs": [
              "140170121"
            ]
          },
          "140170121": {
            "id": "140170121",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "老、老板！",
            "nextDialogs": [
              "140170122"
            ]
          },
          "140170122": {
            "id": "140170122",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "欸，弗洛朗，怎么了？",
            "nextDialogs": [
              "140170123"
            ]
          },
          "140170123": {
            "id": "140170123",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "大事不好了！罗默夫那帮人聚集在了白淞镇外面，还运了一堆炸药过来！",
            "nextDialogs": [
              "140170124"
            ]
          },
          "140170124": {
            "id": "140170124",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "啊？炸药？他们想干什么？",
            "nextDialogs": [
              "140170125"
            ]
          },
          "140170125": {
            "id": "140170125",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "应该是蓄谋已久的行动，在昨天收到了你寄来的信之后，我就和刺玫会成员一同去调查。",
            "nextDialogs": [
              "140170126"
            ]
          },
          "140170126": {
            "id": "140170126",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "但罗默夫他们好像也听到了风声，所有人都从之前的据点撤离了。",
            "nextDialogs": [
              "140170127"
            ]
          },
          "140170127": {
            "id": "140170127",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "我们追查他们的踪迹，没想到目的地竟然就是白淞镇！",
            "nextDialogs": [
              "140170128"
            ]
          },
          "140170128": {
            "id": "140170128",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "该不会是因为昨天在城里的冲突，让他们警觉起来了吧？",
            "nextDialogs": [
              "140170129"
            ]
          },
          "140170129": {
            "id": "140170129",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "看来他们连一点想要坐下来谈的想法都没有啊，早知道就该把他们全部扔给执律庭。",
            "nextDialogs": [
              "140170130"
            ]
          },
          "140170130": {
            "id": "140170130",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "抱歉，是我太天真了。现在说这些也没用，弗洛朗，他们的炸药放在什么地方？",
            "nextDialogs": [
              "140170131"
            ]
          },
          "140170131": {
            "id": "140170131",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "在白淞镇东边的山坡上，克莱门汀线的附近…",
            "nextDialogs": [
              "140170132"
            ]
          },
          "140170132": {
            "id": "140170132",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道说…",
            "nextDialogs": [
              "140170133"
            ]
          },
          "140170133": {
            "id": "140170133",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "难道说，他们想炸掉克莱门汀线？！",
            "nextDialogs": [
              "140170134"
            ]
          },
          "140170134": {
            "id": "140170134",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "很有可能…",
            "nextDialogs": [
              "140170135"
            ]
          },
          "140170135": {
            "id": "140170135",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "罗默夫他们憎恨刺玫会和卡雷斯，而双方关系产生裂痕的原因就是巡轨船。",
            "nextDialogs": [
              "140170136"
            ]
          },
          "140170136": {
            "id": "140170136",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "如果炸掉克莱门汀线，无数碎石就会顺着山坡滚下来，砸进白淞镇。",
            "nextDialogs": [
              "140170137"
            ]
          },
          "140170137": {
            "id": "140170137",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们是疯了吗？这里还有很多无辜的人啊！",
            "nextDialogs": [
              "140170138"
            ]
          },
          "140170138": {
            "id": "140170138",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "必须阻止他们。",
            "nextDialogs": [
              "140170139"
            ]
          },
          "140170139": {
            "id": "140170139",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "嗯，如果是酝酿已久的报复，他们绝对不会放过眼前的机会。",
            "nextDialogs": [
              "140170140"
            ]
          },
          "140170140": {
            "id": "140170140",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "现在必须尽快让白淞镇的人去避难，远离入口，不要被滚落的巨石砸到。",
            "nextDialogs": [
              "140170141"
            ]
          },
          "140170141": {
            "id": "140170141",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "把所有人集中到大船上去吧，那里最安全。",
            "nextDialogs": [
              "140170142"
            ]
          },
          "140170142": {
            "id": "140170142",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "搭档，克莱门汀线那边能交给你吗？",
            "nextDialogs": [
              "140170143"
            ]
          },
          "140170143": {
            "id": "140170143",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "如果炸药爆炸，不只是白淞镇的人会遇到危险，正行驶在上面的巡轨船也会掉下来。",
            "nextDialogs": [
              "140170144"
            ]
          },
          "140170144": {
            "id": "140170144",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "先阻止他们的疯狂行为，再和他们算总账！",
            "nextDialogs": [
              "140170145"
            ]
          },
          "140170145": {
            "id": "140170145",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好。",
            "nextDialogs": [
              "140170146"
            ]
          },
          "140170146": {
            "id": "140170146",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "交给我们吧，娜维娅你们也要小心啊！"
          }
        }
      }
    },
    {
      "subId": "1401713",
      "subQuestName": "前往白淞镇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140170147"
        ],
        "dialogs": {
          "140170147": {
            "id": "140170147",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "走吧，弗洛朗，科尔特，我们也赶紧行动起来。科拉莉女士，赶快带阿黛尔去我们的大船…",
            "nextDialogs": [
              "140170148"
            ]
          },
          "140170148": {
            "id": "140170148",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "小心，老板！",
            "nextDialogs": [
              "140170149"
            ]
          },
          "140170149": {
            "id": "140170149",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "…！",
            "nextDialogs": [
              "140170150"
            ]
          },
          "140170150": {
            "id": "140170150",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "你要干什么，科尔特！",
            "nextDialogs": [
              "140170151"
            ]
          },
          "140170151": {
            "id": "140170151",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "嘁，我还说碍事的家伙终于走了，结果还有你。",
            "nextDialogs": [
              "140170152"
            ]
          },
          "140170152": {
            "id": "140170152",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "难道说是调虎离山？科尔特，你也是罗默夫的人？",
            "nextDialogs": [
              "140170153"
            ]
          },
          "140170153": {
            "id": "140170153",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "原来如此，你早就知道他们在做准备，才说他们的近况不好，让我们放松警惕…",
            "nextDialogs": [
              "140170154"
            ]
          },
          "140170154": {
            "id": "140170154",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "这不全对，或许我和他的立场相似，但我并不赞成他那种激进的做法。",
            "nextDialogs": [
              "140170155"
            ]
          },
          "140170155": {
            "id": "140170155",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "因为我恨的只有你，只有你一个，娜维娅！",
            "nextDialogs": [
              "140170156"
            ]
          },
          "140170156": {
            "id": "140170156",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "到我身边来，小心。",
            "nextDialogs": [
              "140170157"
            ]
          },
          "140170157": {
            "id": "140170157",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "罗默夫答应我，如果我能杀了你，他就不会对白淞镇动手。",
            "nextDialogs": [
              "140170158"
            ]
          },
          "140170158": {
            "id": "140170158",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "可是从头到尾，你都和那个碍事的家伙待在一起，我没有下手的机会。",
            "nextDialogs": [
              "140170159"
            ]
          },
          "140170159": {
            "id": "140170159",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "罗默夫失去耐心了，我本来没必要出现在这里，但就算是和你们一起埋在这鬼地方，我也要亲手杀了你。",
            "nextDialogs": [
              "140170160"
            ]
          },
          "140170160": {
            "id": "140170160",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "为什么？",
            "nextDialogs": [
              "140170161"
            ]
          },
          "140170161": {
            "id": "140170161",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "因为你一无所知，你才会问出这么愚蠢的问题。",
            "nextDialogs": [
              "140170162"
            ]
          },
          "140170162": {
            "id": "140170162",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "你没有见过刺玫会当年有多辉煌，没有经历过白淞镇最繁荣的时期，而我不一样…",
            "nextDialogs": [
              "140170163"
            ]
          },
          "140170163": {
            "id": "140170163",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "我亲眼见证过！再一点一点地看它们全部消失！",
            "nextDialogs": [
              "140170164"
            ]
          },
          "140170164": {
            "id": "140170164",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "都是因为你的出现，娜维娅。",
            "nextDialogs": [
              "140170165"
            ]
          },
          "140170165": {
            "id": "140170165",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "克莱门汀因为你死了，卡雷斯也因为你死了，迈勒斯和西尔弗因为你死了，还有那么多人，都因为你死了！",
            "nextDialogs": [
              "140170166"
            ]
          },
          "140170166": {
            "id": "140170166",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "第一次见面那副无知的样子，也是在骗我们。",
            "nextDialogs": [
              "140170167"
            ]
          },
          "140170167": {
            "id": "140170167",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "对啊，我刚出来的时候就知道迈勒斯死了。",
            "nextDialogs": [
              "140170168"
            ]
          },
          "140170168": {
            "id": "140170168",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "你们知道吗？在那个该死的水下，我很认真地在考虑，等我出来以后，就去和迈勒斯道歉。",
            "nextDialogs": [
              "140170169"
            ]
          },
          "140170169": {
            "id": "140170169",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "当年因为巡轨船，我和他大吵了一架，我认为他脑子里只有忠心，没有思考能力。",
            "nextDialogs": [
              "140170170"
            ]
          },
          "140170170": {
            "id": "140170170",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "转眼就过去了那么多年，我本来以为我差点就能理解他了，以为他能让我回忆起刺玫会美好的那段时光…",
            "nextDialogs": [
              "140170171"
            ]
          },
          "140170171": {
            "id": "140170171",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "结果他死了！因为你，又是你，娜维娅！",
            "nextDialogs": [
              "140170172"
            ]
          },
          "140170172": {
            "id": "140170172",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "……",
            "nextDialogs": [
              "140170173"
            ]
          },
          "140170173": {
            "id": "140170173",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "我曾经比谁都要爱刺玫会和白淞镇，但现在我的眼中只有凄凉，美好的一切被你毁得一干二净。",
            "nextDialogs": [
              "140170174"
            ]
          },
          "140170174": {
            "id": "140170174",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "老板，别听他的，尽是胡言乱语。",
            "nextDialogs": [
              "140170175"
            ]
          },
          "140170175": {
            "id": "140170175",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "你有没有想过，其实你身边的人都没有那么喜欢你。",
            "nextDialogs": [
              "140170176"
            ]
          },
          "140170176": {
            "id": "140170176",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "你有没有想过，你受到尊重只因为你是卡雷斯和克莱门汀的孩子，你根本什么都不是。",
            "nextDialogs": [
              "140170177"
            ]
          },
          "140170177": {
            "id": "140170177",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "你有没有想过，这里的人还留在白淞镇，不是因为你，只是因为舍不得曾经的回忆！",
            "nextDialogs": [
              "140170178"
            ]
          },
          "140170178": {
            "id": "140170178",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "（因为当错误的惩罚降临时，那些人真的会不顾一切地为你挺身而出，为你付出代价…）",
            "nextDialogs": [
              "140170179"
            ]
          },
          "140170179": {
            "id": "140170179",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "（是啊，现在想想，他们真的都是一群很温柔的人。）",
            "nextDialogs": [
              "140170180"
            ]
          },
          "140170180": {
            "id": "140170180",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "（真的吗？真的是因为…温柔吗？）",
            "nextDialogs": [
              "140170181"
            ]
          },
          "140170181": {
            "id": "140170181",
            "speakerId": 13399,
            "speakerName": "阿黛尔",
            "text": "你胡说！我就很喜欢娜维娅姐姐！我妈妈也喜欢！",
            "nextDialogs": [
              "140170182"
            ]
          },
          "140170182": {
            "id": "140170182",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "！！！",
            "nextDialogs": [
              "140170183"
            ]
          },
          "140170183": {
            "id": "140170183",
            "speakerId": 13399,
            "speakerName": "阿黛尔",
            "text": "道理，我不会讲，但喜欢就是喜欢！",
            "nextDialogs": [
              "140170184"
            ]
          },
          "140170184": {
            "id": "140170184",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "迈勒斯先生一定会对你非常失望。",
            "nextDialogs": [
              "140170185"
            ]
          },
          "140170185": {
            "id": "140170185",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "你居然把刺玫会历史上的诸多不幸，都归结在老板个人的身上。",
            "nextDialogs": [
              "140170186"
            ]
          },
          "140170186": {
            "id": "140170186",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "让开，弗洛朗，我不想对你动手。",
            "nextDialogs": [
              "140170187"
            ]
          },
          "140170187": {
            "id": "140170187",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "那还是动手吧。",
            "nextDialogs": [
              "140170188"
            ]
          },
          "140170188": {
            "id": "140170188",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "老板，危难在前，没有时间犹豫了。",
            "nextDialogs": [
              "140170189"
            ]
          },
          "140170189": {
            "id": "140170189",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "或许在你眼中，你说的这些就是「现实」。",
            "nextDialogs": [
              "140170190"
            ]
          },
          "140170190": {
            "id": "140170190",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "但我所接受过的来自每个人的爱，也都是真实的，这些爱都切实地帮助了我。",
            "nextDialogs": [
              "140170191"
            ]
          },
          "140170191": {
            "id": "140170191",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "即便是现在，我也会相信这个事实，让你知道刺玫会在我心中的分量！"
          }
        }
      }
    },
    {
      "subId": "1401702",
      "subQuestName": "击败科尔特等人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1401703",
      "subQuestName": "与弗洛朗交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140170301"
        ],
        "dialogs": {
          "140170301": {
            "id": "140170301",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "弗洛朗，这边交给你，赶紧召集其他刺玫会的成员，转移镇上的居民。",
            "nextDialogs": [
              "140170302"
            ]
          },
          "140170302": {
            "id": "140170302",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "如果还有偷偷混进来的科尔特的同伴，迅速制服，不要给他们伤害普通人的机会。",
            "nextDialogs": [
              "140170303"
            ]
          },
          "140170303": {
            "id": "140170303",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我不能扔下我的搭档一个人面对危险。",
            "nextDialogs": [
              "140170304"
            ]
          },
          "140170304": {
            "id": "140170304",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "好的，老板，我马上去做。",
            "nextDialogs": [
              "140170305"
            ]
          },
          "140170305": {
            "id": "140170305",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "…娜维娅，你没问题吧？",
            "nextDialogs": [
              "140170306"
            ]
          },
          "140170306": {
            "id": "140170306",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我不知道，但我必须要去。",
            "nextDialogs": [
              "140170307"
            ]
          },
          "140170307": {
            "id": "140170307",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "稍早之前，你和派蒙急匆匆地来到白淞镇的出口。"
          }
        }
      }
    },
    {
      "subId": "1401704",
      "subQuestName": "和派蒙商议对策",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140170401"
        ],
        "dialogs": {
          "140170401": {
            "id": "140170401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "必须要保护克莱门汀线，我们赶紧上去吧。",
            "nextDialogs": [
              "140170402"
            ]
          },
          "140170402": {
            "id": "140170402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们想要炸掉水道的话，炸药应该在支撑柱的附近！"
          }
        }
      }
    },
    {
      "subId": "1401705",
      "subQuestName": "迅速前往水道的下方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1401711",
      "subQuestName": "与派蒙交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140171101"
        ],
        "dialogs": {
          "140171101": {
            "id": "140171101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个就是炸药吧，然后这里是控制台，怎么才能让它停下来？",
            "nextDialogs": [
              "140171102"
            ]
          },
          "140171102": {
            "id": "140171102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这上面的按钮，似乎都不应该随便碰。",
            "nextDialogs": [
              "140171103"
            ]
          },
          "140171103": {
            "id": "140171103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这里…",
            "nextDialogs": [
              "140171104"
            ]
          },
          "140171104": {
            "id": "140171104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有个形状奇怪的洞，唔，为什么会有这个东西？",
            "nextDialogs": [
              "140171107"
            ]
          },
          "140171107": {
            "id": "140171107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有可能，那钥匙应该就在我们刚刚打倒的人身上吧？",
            "nextDialogs": [
              "140171108"
            ]
          },
          "140171108": {
            "id": "140171108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然这样，我们分头行动，到处找找！"
          }
        }
      }
    },
    {
      "subId": "1401712",
      "subQuestName": "寻找钥匙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1401706",
      "subQuestName": "停止即将起爆的炸药",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1401707",
      "subQuestName": "与派蒙交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140170701"
        ],
        "dialogs": {
          "140170701": {
            "id": "140170701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样应该就行了吧。",
            "nextDialogs": [
              "140170702"
            ]
          },
          "140170702": {
            "id": "140170702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼，这下娜维娅他们也能松口气了。",
            "nextDialogs": [
              "140170703"
            ]
          },
          "140170703": {
            "id": "140170703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "最好再去周围看看。",
            "nextDialogs": [
              "140170704"
            ]
          },
          "140170704": {
            "id": "140170704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦，万一还有其他炸药呢…我们快走吧！"
          }
        }
      }
    },
    {
      "subId": "1401714",
      "subQuestName": "(test)(hide)解除炸弹表现逻辑$HIDDEN",
      "sceneId": null,
      "locations": [],

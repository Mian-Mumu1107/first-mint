      }
    },
    {
      "subId": "1401708",
      "subQuestName": "与埃斯蒙德交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140170801"
        ],
        "dialogs": {
          "140170801": {
            "id": "140170801",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "一段时间后，接到通知的执律庭成员抵达，将罗默夫一伙人悉数抓获。",
            "nextDialogs": [
              "140170802"
            ]
          },
          "140170802": {
            "id": "140170802",
            "speakerId": 13365,
            "speakerName": "埃斯蒙德",
            "text": "听蒂埃里说，你们是仇人，但他们总归还是在刺玫会待过一段时间，你打算出面解决吗？",
            "nextDialogs": [
              "140170803"
            ]
          },
          "140170803": {
            "id": "140170803",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我没有什么想和他们说的。",
            "nextDialogs": [
              "140170804"
            ]
          },
          "140170804": {
            "id": "140170804",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "仇恨也好，愤怒也罢，把普通人的安危置之不顾，我不认为这种人还有正常沟通的理智。",
            "nextDialogs": [
              "140170805"
            ]
          },
          "140170805": {
            "id": "140170805",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "请依照律法对他们进行处置吧，刺玫会方面没有任何意见。",
            "nextDialogs": [
              "140170806"
            ]
          },
          "140170806": {
            "id": "140170806",
            "speakerId": 13365,
            "speakerName": "埃斯蒙德",
            "text": "好的，感谢你们能出手相助，没有引发更大的灾难。",
            "nextDialogs": [
              "140170807"
            ]
          },
          "140170807": {
            "id": "140170807",
            "speakerId": 13365,
            "speakerName": "埃斯蒙德",
            "text": "该收队了，把这帮人都带走！",
            "nextDialogs": [
              "140170808"
            ]
          },
          "140170808": {
            "id": "140170808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "太好了，娜维娅，我们成功了！你好厉害啊！",
            "nextDialogs": [
              "140170809"
            ]
          },
          "140170809": {
            "id": "140170809",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "嗯，幸好赶上了…",
            "nextDialogs": [
              "140170812"
            ]
          },
          "140170812": {
            "id": "140170812",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "可能是使用了太多元素力吧，呵呵，没关系的，不用在意我。",
            "nextDialogs": [
              "140170813"
            ]
          },
          "140170813": {
            "id": "140170813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "平时这么夸奖你的时候，你总会吹嘘几句。这样的你我还有点不习惯呢。",
            "nextDialogs": [
              "140170814"
            ]
          },
          "140170814": {
            "id": "140170814",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "老板，白淞镇里潜伏的家伙也全都抓住了。他们也会被执律庭的人送回去。",
            "nextDialogs": [
              "140170815"
            ]
          },
          "140170815": {
            "id": "140170815",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "这次罗默夫他们可谓是倾巢出动，也因此被一网打尽，之后应该也不需要担心了。",
            "nextDialogs": [
              "140170816"
            ]
          },
          "140170816": {
            "id": "140170816",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我知道了，是个好结果。",
            "nextDialogs": [
              "140170817"
            ]
          },
          "140170817": {
            "id": "140170817",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "……",
            "nextDialogs": [
              "140170818"
            ]
          },
          "140170818": {
            "id": "140170818",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "科尔特。",
            "nextDialogs": [
              "140170819"
            ]
          },
          "140170819": {
            "id": "140170819",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我并非不能理解你的想法，失去的东西正因为无法挽回，才会显得更加珍贵。",
            "nextDialogs": [
              "140170820"
            ]
          },
          "140170820": {
            "id": "140170820",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我不是卡雷斯，也永远不会成为卡雷斯，你爱的刺玫会和白淞镇，再也不会回来了。",
            "nextDialogs": [
              "140170821"
            ]
          },
          "140170821": {
            "id": "140170821",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "但我的想法没有改变，这是个重新开始的契机。",
            "nextDialogs": [
              "140170822"
            ]
          },
          "140170822": {
            "id": "140170822",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "以后刺玫会赚到的钱会更多地投入到白淞镇的建设，我也会想办法改造巡轨船的线路…",
            "nextDialogs": [
              "140170823"
            ]
          },
          "140170823": {
            "id": "140170823",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "将来的某一天，巡轨船也能为白淞镇的每一个人提供便利。",
            "nextDialogs": [
              "140170824"
            ]
          },
          "140170824": {
            "id": "140170824",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "我明白你的意思，如果是卡雷斯先生，他一定不会说出这种话。",
            "nextDialogs": [
              "140170825"
            ]
          },
          "140170825": {
            "id": "140170825",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "有太多的事情无能为力了，你我都是一样。",
            "nextDialogs": [
              "140170826"
            ]
          },
          "140170826": {
            "id": "140170826",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "你不再是刺玫会的一员了。",
            "nextDialogs": [
              "140170827"
            ]
          },
          "140170827": {
            "id": "140170827",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "但等你再度获得自由的那天，如果想回白淞镇看看，我们依然欢迎。",
            "nextDialogs": [
              "140170828"
            ]
          },
          "140170828": {
            "id": "140170828",
            "speakerId": 13709,
            "speakerName": "科尔特",
            "text": "谢谢你，娜维娅。",
            "nextDialogs": [
              "140170829"
            ]
          },
          "140170829": {
            "id": "140170829",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "老板果然是个温柔的人。",
            "nextDialogs": [
              "140170830"
            ]
          },
          "140170830": {
            "id": "140170830",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "…也是个不走运的人。",
            "nextDialogs": [
              "140170831"
            ]
          },
          "140170831": {
            "id": "140170831",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "谢谢你，能够保护克莱门汀线。",
            "nextDialogs": [
              "140170832"
            ]
          },
          "140170832": {
            "id": "140170832",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "#其实我很害怕，{NICKNAME}。短期之内，卡雷斯线都无法重建…",
            "nextDialogs": [
              "140170833"
            ]
          },
          "140170833": {
            "id": "140170833",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "如果连克莱门汀线也被人破坏，我不知道该怎么面对。",
            "nextDialogs": [
              "140170834"
            ]
          },
          "140170834": {
            "id": "140170834",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "名字是一种「铭刻」，失去了每天都能看见的克莱门汀线，我就觉得像再一次失去了母亲一样…",
            "nextDialogs": [
              "140170835"
            ]
          },
          "140170835": {
            "id": "140170835",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "但它还好好地站在那里，真是太好了。",
            "nextDialogs": [
              "140170836"
            ]
          },
          "140170836": {
            "id": "140170836",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "到底发生了什么啊？比起累，你更像是沮丧…",
            "nextDialogs": [
              "140170837"
            ]
          },
          "140170837": {
            "id": "140170837",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "给老板一些时间吧。"
          }
        }
      }
    },
    {
      "subId": "1401715",
      "subQuestName": "(test)(hide)隐藏控制船只消失$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1401709",
      "subQuestName": "扶娜维娅回到白淞镇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140170901"
        ],
        "dialogs": {
          "140170901": {
            "id": "140170901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么样，休息了一会儿，你好点了吗？",
            "nextDialogs": [
              "140170902"
            ]
          },
          "140170902": {
            "id": "140170902",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "嗯，好些了，不过应该还要休养一两天。",
            "nextDialogs": [
              "140170903"
            ]
          },
          "140170903": {
            "id": "140170903",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "抱歉，搭档，我刚刚说了点奇怪的话，你别往心里去。",
            "nextDialogs": [
              "140170906"
            ]
          },
          "140170906": {
            "id": "140170906",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "曾经我也这么以为，只不过我没有我想象中那么坚强。",
            "nextDialogs": [
              "140170907"
            ]
          },
          "140170907": {
            "id": "140170907",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "科尔特提到了我的父母，还有迈勒斯和西尔弗，因为他们，我才能活到现在。",
            "nextDialogs": [
              "140170908"
            ]
          },
          "140170908": {
            "id": "140170908",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "他们…不会后悔吗？我活着，又让谁感到了幸福呢？",
            "nextDialogs": [
              "140170909"
            ]
          },
          "140170909": {
            "id": "140170909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不要这样想，娜维娅，你已经做得够好了。",
            "nextDialogs": [
              "140170910"
            ]
          },
          "140170910": {
            "id": "140170910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#无论别人如何，我和{M#他}{F#她}，永远永远都会支持你！",
            "nextDialogs": [
              "140170911"
            ]
          },
          "140170911": {
            "id": "140170911",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "事到如今，看来不得不坦白了。",
            "nextDialogs": [
              "140170912"
            ]
          },
          "140170912": {
            "id": "140170912",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "老板，我也有件事瞒着你，请你们都跟我来吧，已经准备好了。",
            "nextDialogs": [
              "140170913"
            ]
          },
          "140170913": {
            "id": "140170913",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "现在的我，可承受不住什么「真相」了。",
            "nextDialogs": [
              "140170914"
            ]
          },
          "140170914": {
            "id": "140170914",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "放心吧，一定会是惊喜。"
          }
        }
      }
    },
    {
      "subId": "1401710",
      "subQuestName": "和娜维娅去看「惊喜」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140171001"
        ],
        "dialogs": {
          "140171001": {
            "id": "140171001",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "为什么大家都聚在这里？这是什么？",
            "nextDialogs": [
              "140171002"
            ]
          },
          "140171002": {
            "id": "140171002",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "本来这是我们全镇人为老板准备的礼物，打算在做好之后再向你揭晓。",
            "nextDialogs": [
              "140171003"
            ]
          },
          "140171003": {
            "id": "140171003",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "但现在情况特殊，我还从来没见过你如此沮丧的样子，所以就先把这个礼物的设计图拿出来了。",
            "nextDialogs": [
              "140171004"
            ]
          },
          "140171004": {
            "id": "140171004",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我…我的样子居然有这么难看吗？",
            "nextDialogs": [
              "140171005"
            ]
          },
          "140171005": {
            "id": "140171005",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "准备好了的话，就把布揭开了。",
            "nextDialogs": [
              "140171006"
            ]
          },
          "140171006": {
            "id": "140171006",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "嗯…",
            "nextDialogs": [
              "140171007"
            ]
          },
          "140171007": {
            "id": "140171007",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "这、这是…",
            "nextDialogs": [
              "140171008"
            ]
          },
          "140171008": {
            "id": "140171008",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "老爹，母亲，还有，我…",
            "nextDialogs": [
              "140171009"
            ]
          },
          "140171009": {
            "id": "140171009",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "克莱门汀女士的样子，是我们参考以前的留影和众人的印象绘制的。",
            "nextDialogs": [
              "140171010"
            ]
          },
          "140171010": {
            "id": "140171010",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这不会是，之前提到的那个雕像吧？！",
            "nextDialogs": [
              "140171011"
            ]
          },
          "140171011": {
            "id": "140171011",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "是的，其实我们早就定好了雕像的设计，已经在委托人制作了。",
            "nextDialogs": [
              "140171012"
            ]
          },
          "140171012": {
            "id": "140171012",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "为了不让老板察觉，才故意说需要老板来决定造型。",
            "nextDialogs": [
              "140171013"
            ]
          },
          "140171013": {
            "id": "140171013",
            "speakerId": 5123,
            "speakerName": "伊薇特",
            "text": "只有卡雷斯先生和克莱门汀女士怎么行呢？",
            "nextDialogs": [
              "140171014"
            ]
          },
          "140171014": {
            "id": "140171014",
            "speakerId": 5128,
            "speakerName": "桑迪诺",
            "text": "虽然我们的老板很年轻，「乐斯」的事也好，重建白淞镇也好，她做过的事我们都看在眼里。",
            "nextDialogs": [
              "140171015"
            ]
          },
          "140171015": {
            "id": "140171015",
            "speakerId": 5130,
            "speakerName": "艾琪诺",
            "text": "值得我们用雕像的形式去纪念。",
            "nextDialogs": [
              "140171016"
            ]
          },
          "140171016": {
            "id": "140171016",
            "speakerId": 13399,
            "speakerName": "阿黛尔",
            "text": "我不知道以前的刺玫会是什么样，但我知道，现在很好！",
            "nextDialogs": [
              "140171017"
            ]
          },
          "140171017": {
            "id": "140171017",
            "speakerId": 13321,
            "speakerName": "科拉莉",
            "text": "有娜维娅在，我们很放心。",
            "nextDialogs": [
              "140171018"
            ]
          },
          "140171018": {
            "id": "140171018",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "我们聚于此地，是想要告诉老板——",
            "nextDialogs": [
              "140171019"
            ]
          },
          "140171019": {
            "id": "140171019",
            "speakerId": 13323,
            "speakerName": "弗洛朗",
            "text": "我们是相信你，而不是沉溺于过去的辉煌才决定留在这里的。",
            "nextDialogs": [
              "140171020"
            ]
          },
          "140171020": {
            "id": "140171020",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我和{M#他}{F#她}也是！",
            "nextDialogs": [
              "140171021"
            ]
          },
          "140171021": {
            "id": "140171021",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也永远相信我们的默契。",
            "nextDialogs": [
              "140171022"
            ]
          },
          "140171022": {
            "id": "140171022",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "谢谢你们，那我就厚着脸皮接受大家的好意了…",
            "nextDialogs": [
              "140171023"
            ]
          },
          "140171023": {
            "id": "140171023",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "真是了不起的惊喜啊。",
            "nextDialogs": [
              "140171024"
            ]
          },
          "140171024": {
            "id": "140171024",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我连做梦都没想过，居然有机会和母亲站在一起。"
          }
        }
      }
    },
    {
      "subId": "1401750",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140175001"
        ],
        "dialogs": {
          "140175001": {
            "id": "140175001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看我把他翻过来。这个人好重啊，该减肥了…"
          }
        }
      }
    },
    {
      "subId": "1401751",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140175101"
        ],
        "dialogs": {
          "140175101": {
            "id": "140175101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快把它停下来吧，时间紧迫。"
          }
        }
      }
    },
    {
      "subId": "1401799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140179901"
        ],
        "dialogs": {
          "140179901": {
            "id": "140179901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么？你找到了？真厉害！"
          }
        }
      }
    }
  ]
}
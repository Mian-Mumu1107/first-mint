    {
      "subId": "7215403",
      "subQuestName": "和泽维尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540301"
        ],
        "dialogs": {
          "721540301": {
            "id": "721540301",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "#完美！不愧是我心中永远的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HERO|INFO_FEMALE_PRONOUN_HEROINE]}！完美的示范！",
            "nextDialogs": [
              "721540303",
              "721540305"
            ]
          },
          "721540303": {
            "id": "721540303",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "一号演员，就是「映影」里最重要的演员。",
            "nextDialogs": [
              "721540306"
            ]
          },
          "721540306": {
            "id": "721540306",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "士兵先生，您看清楚刚才旅行者的示范了吗？",
            "nextDialogs": [
              "721540307"
            ]
          },
          "721540307": {
            "id": "721540307",
            "speakerId": 1001,
            "speakerName": "虎之助",
            "text": "大致了解了。在挥剑的时候，我需要强调的其实并不是挥剑的「动作」，而是挥剑的「架势」，对吧？",
            "nextDialogs": [
              "721540308"
            ]
          },
          "721540308": {
            "id": "721540308",
            "speakerId": 1001,
            "speakerName": "虎之助",
            "text": "如果只是「架势」的话…我倒是有些主意。",
            "nextDialogs": [
              "721540309"
            ]
          },
          "721540309": {
            "id": "721540309",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "哦？那太好了，请您去和其余的士兵先生们讲讲，稍后我们再来一次。",
            "nextDialogs": [
              "721540310"
            ]
          },
          "721540310": {
            "id": "721540310",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "旅行者，太谢谢你了，这些东西请你收下吧。",
            "nextDialogs": [
              "721540311"
            ]
          },
          "721540311": {
            "id": "721540311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "下一部「映影」的题材是？",
            "nextDialogs": [
              "721540312"
            ]
          },
          "721540312": {
            "id": "721540312",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "下一部「映影」的题材啊…唔…其实我也非常犹豫，有很多题材我都想要试一试。",
            "nextDialogs": [
              "721540313"
            ]
          },
          "721540313": {
            "id": "721540313",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "比如鸣神大社里的各种传统啦，稻妻所流传的狸猫和狐狸的传说啦。",
            "nextDialogs": [
              "721540314"
            ]
          },
          "721540314": {
            "id": "721540314",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "稻妻有这么多岛屿，可以制作的故事实在是太多了。",
            "nextDialogs": [
              "721540315"
            ]
          },
          "721540315": {
            "id": "721540315",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "但无论如何，我都得先把这部《第七个武士》制作好。",
            "nextDialogs": [
              "721540316"
            ]
          },
          "721540316": {
            "id": "721540316",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "如果能让大人们满意的话，我之后在稻妻制作「映影」的时候，想必也会方便很多吧…"
          },
          "721540305": {
            "id": "721540305",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "没问题！等拍完了这一部「映影」之后，我就该筹划下一部全新「映影」了。"
          }
        }
      }
    },
    {
      "subId": "7215404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540401"
        ],
        "dialogs": {
          "721540401": {
            "id": "721540401",
            "speakerId": 1001,
            "speakerName": "虎之助",
            "text": "「剑阵映影」…泽维尔先生起的名字真是独特。",
            "nextDialogs": [
              "721540403",
              "721540408"
            ]
          },
          "721540403": {
            "id": "721540403",
            "speakerId": 1001,
            "speakerName": "虎之助",
            "text": "大人们认为，这「映影」有助于传扬幕府武士的威名。",
            "nextDialogs": [
              "721540404"
            ]
          },
          "721540404": {
            "id": "721540404",
            "speakerId": 1001,
            "speakerName": "虎之助",
            "text": "也许是我在这方面有些愚钝吧…我真的没有这方面的感觉。",
            "nextDialogs": [
              "721540405"
            ]
          },
          "721540405": {
            "id": "721540405",
            "speakerId": 1001,
            "speakerName": "虎之助",
            "text": "而且，这台本里的武士们尽说些丧气话，全然没有武士的威严。",
            "nextDialogs": [
              "721540406"
            ]
          },
          "721540406": {
            "id": "721540406",
            "speakerId": 1001,
            "speakerName": "虎之助",
            "text": "不知道上面的大人们为什么会答应下来…"
          },
          "721540408": {
            "id": "721540408",
            "speakerId": 1001,
            "speakerName": "虎之助",
            "text": "自从范兵卫大人「升迁」后，现在那边的负责人已经换成了阳介。",
            "nextDialogs": [
              "721540409"
            ]
          },
          "721540409": {
            "id": "721540409",
            "speakerId": 1001,
            "speakerName": "虎之助",
            "text": "他是工匠出身，十分踏实可靠，也很会处理实务。",
            "nextDialogs": [
              "721540410"
            ]
          },
          "721540410": {
            "id": "721540410",
            "speakerId": 1001,
            "speakerName": "虎之助",
            "text": "「御影炉心」由他负责，应该不会再出什么问题了。"
          }
        }
      }
    },
    {
      "subId": "7215405",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540501"
        ],
        "dialogs": {

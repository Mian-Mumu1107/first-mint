  },
  "subQuests": [
    {
      "subId": "7215401",
      "subQuestName": "（test）和泽维尔对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540101"
        ],
        "dialogs": {
          "721540101": {
            "id": "721540101",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "等等！士兵先生，您刚才念的词情绪不太对。",
            "nextDialogs": [
              "721540102"
            ]
          },
          "721540102": {
            "id": "721540102",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "「武士，如同席卷大地的清风。」",
            "nextDialogs": [
              "721540103"
            ]
          },
          "721540103": {
            "id": "721540103",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "你还记得我之前和你讲的戏吧，要有一种洒脱感，沧桑感，洒脱，洒脱明白吗？",
            "nextDialogs": [
              "721540104"
            ]
          },
          "721540104": {
            "id": "721540104",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "这句话是整部戏的关键，您一定要完整地，饱满地，完美地把情绪表达出来！",
            "nextDialogs": [
              "721540105"
            ]
          },
          "721540105": {
            "id": "721540105",
            "speakerId": 1001,
            "speakerName": "虎之助",
            "text": "唔…",
            "nextDialogs": [
              "721540106"
            ]
          },
          "721540106": {
            "id": "721540106",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "而且挥剑的时候，不要那么快，一定要保证自己在镜头里面，不然「映影机」都要拍不到了。",
            "nextDialogs": [
              "721540107"
            ]
          },
          "721540107": {
            "id": "721540107",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "先摆出架势，然后停顿，明白吗？停顿一下，然后猛地斩下去。",
            "nextDialogs": [
              "721540108"
            ]
          },
          "721540108": {
            "id": "721540108",
            "speakerId": 1001,
            "speakerName": "虎之助",
            "text": "但与人对决的时候，可不能这么挥剑…",
            "nextDialogs": [
              "721540109"
            ]
          },
          "721540109": {
            "id": "721540109",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "这不是剧情和制作需要嘛…",
            "nextDialogs": [
              "721540110"
            ]
          },
          "721540110": {
            "id": "721540110",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "再准备准备，我们再来一次…",
            "nextDialogs": [
              "721540114",
              "721540113"
            ]
          },
          "721540114": {
            "id": "721540114",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "#哎哟，是您呐！我亲爱的好{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYC|INFO_FEMALE_PRONOUN_GIRLC]}，准是一阵好风送您过来的。",
            "nextDialogs": [
              "721540115"
            ]
          },
          "721540115": {
            "id": "721540115",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "如您所见，我正在和这位士兵先生拍摄一部「剑阵映影」，名字叫做《第七个武士》。",
            "nextDialogs": [
              "721540116"
            ]
          },
          "721540116": {
            "id": "721540116",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "哦，「剑阵映影」是我为这一类的「映影」取的总称。",
            "nextDialogs": [
              "721540117"
            ]
          },
          "721540117": {
            "id": "721540117",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "记录着刀剑搏击的画面，让观看者感觉自己如同在剑阵之中穿梭一般的「映影」…差不多就是这个意思。"
          },
          "721540113": {
            "id": "721540113",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "您这句话的情绪太激昂了，应该是…"
          }
        }
      }
    },
    {
      "subId": "7215405",
      "subQuestName": "和泽维尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540601"
        ],
        "dialogs": {
          "721540601": {
            "id": "721540601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我准备好了。",
            "nextDialogs": [
              "721540602"
            ]
          },
          "721540602": {
            "id": "721540602",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "太好了，非常好，那就准备开始吧！",
            "nextDialogs": [
              "721540603"
            ]
          },
          "721540603": {
            "id": "721540603",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "我这就去调整「映影机」，还有…把其他去热身的士兵先生们都叫回来…"
          }
        }
      }
    },
    {
      "subId": "7215402",
      "subQuestName": "帮助泽维尔制作「映影」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721540201"
        ],
        "dialogs": {
          "721540201": {
            "id": "721540201",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "哎呀，这样拍出来的「映影」可不太对。",
            "nextDialogs": [
              "721540202"
            ]
          },
          "721540202": {
            "id": "721540202",
            "speakerId": 1000,
            "speakerName": "泽维尔",
            "text": "您再准备准备，我们再来一次吧。"
          }
        }
      }
    },
    {
      "subId": "7215404",
      "subQuestName": "和泽维尔对话",
      "sceneId": null,

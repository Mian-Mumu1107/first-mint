{
  "lineCounts": {
    "Player": 12,
    "龟井宗久": 50
  },
  "subQuests": [
    {
      "subId": "2203001",
      "subQuestName": "与龟井宗久对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220300101"
        ],
        "dialogs": {
          "220300101": {
            "id": "220300101",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "阁下，又见面了。",
            "nextDialogs": [
              "220300102"
            ]
          },
          "220300102": {
            "id": "220300102",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "恕在下唐突，今天有一事想请阁下帮助。",
            "nextDialogs": [
              "220300106",
              "220300105"
            ]
          },
          "220300106": {
            "id": "220300106",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "在受旭东阁下雇佣后，我一直与他们同行。",
            "nextDialogs": [
              "220300107"
            ]
          },
          "220300107": {
            "id": "220300107",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "为了报答旭东阁下收留我之恩，我想做些谢礼赠予他。",
            "nextDialogs": [
              "220300108"
            ]
          },
          "220300108": {
            "id": "220300108",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "但旭东阁下比起武艺，更喜欢美食，所以我想要亲手制作些食品。",
            "nextDialogs": [
              "220300109"
            ]
          },
          "220300109": {
            "id": "220300109",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "在下本来已经看好了两处食材的所在地，打算等这些食材成熟后再去取用。",
            "nextDialogs": [
              "220300110"
            ]
          },
          "220300110": {
            "id": "220300110",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "可是，却有两股魔物分别占据了那两处食材所在地，而且还都已经把食材取下了。",
            "nextDialogs": [
              "220300111"
            ]
          },
          "220300111": {
            "id": "220300111",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "我所要制作的那道菜，最重要的就是食材新鲜，我本来打算先取一处，再去另外一处…",
            "nextDialogs": [
              "220300112"
            ]
          },
          "220300112": {
            "id": "220300112",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "但现在两边魔物都已经取下了食材，想要烹制那道菜，在下必须快些把那两道食材都拿到手才行。",
            "nextDialogs": [
              "220300113"
            ]
          },
          "220300113": {
            "id": "220300113",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "但在下…分身乏术，就算能对付一处的魔物，另一处的食材想必也早已被魔物糟蹋殆尽。",
            "nextDialogs": [
              "220300114"
            ]
          },
          "220300114": {
            "id": "220300114",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "所以，我想请阁下与我共同出手，一起击倒那些魔物，取得食材。"
          },
          "220300105": {
            "id": "220300105",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "是在下有求于阁下，这种礼节也是应当。"
          }
        }
      }
    },
    {
      "subId": "2203002",
      "subQuestName": "跟随龟井宗久",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220300201"
        ],
        "dialogs": {
          "220300201": {
            "id": "220300201",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "就是这里了。两处魔物分别在左右两边扎了营。",
            "nextDialogs": [
              "220300202"
            ]
          },
          "220300202": {
            "id": "220300202",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "在下悄悄去侦察了一番，左边营地的魔物虽然弱小，但数量众多。",
            "nextDialogs": [
              "220300203"
            ]
          },
          "220300203": {
            "id": "220300203",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "右边营地的魔物虽然数量略少，但却格外强壮。",
            "nextDialogs": [
              "220300204"
            ]
          },
          "220300204": {
            "id": "220300204",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "有劳阁下清剿一处魔物，另一处交给在下即可。"
          }
        }
      }
    },
    {
      "subId": "2203003",
      "subQuestName": "（test)玩家选了左边$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220300401"
        ],
        "dialogs": {
          "220300401": {
            "id": "220300401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我去左边。",
            "nextDialogs": [
              "220300402"
            ]
          },
          "220300402": {
            "id": "220300402",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "那就有劳阁下了，在下这就去另一处营地。",
            "nextDialogs": [
              "220300403"
            ]
          },
          "220300403": {
            "id": "220300403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你一个人能对付它们吗？",
            "nextDialogs": [
              "220300404"
            ]
          },
          "220300404": {
            "id": "220300404",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "只是些许魔物罢了，无需担心，若不是担心食材，我一人就能对付这两处魔物。",
            "nextDialogs": [
              "220300405"
            ]
          },
          "220300405": {
            "id": "220300405",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "好了，阁下清剿完魔物，拿到食材后，再到另外一处营地寻我就是。",
            "nextDialogs": [
              "220300406"
            ]
          },
          "220300406": {
            "id": "220300406",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "我们快些出发吧，要是食材坏了，做出来的菜只怕无法入口了。"
          }
        }
      }
    },
    {
      "subId": "2203004",

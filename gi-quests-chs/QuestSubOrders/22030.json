    {
      "subId": "2203005",
      "subQuestName": "打倒左侧魔物营地内所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220300501"
        ],
        "dialogs": {
          "220300501": {
            "id": "220300501",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "阁下，您已经取到食材了吗？"
          }
        }
      }
    },
    {
      "subId": "2203006",
      "subQuestName": "打倒右侧魔物营地内所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220300601"
        ],
        "dialogs": {
          "220300601": {
            "id": "220300601",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "多谢阁下！这些食材还可以用，但不能再拖下去了…我现在就开始烹饪。",
            "nextDialogs": [
              "220300602"
            ]
          },
          "220300602": {
            "id": "220300602",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "完成了，呼…多亏了阁下，这道菜才能顺利完成。",
            "nextDialogs": [
              "220300604",
              "220300611"
            ]
          },
          "220300604": {
            "id": "220300604",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "那是自然。无论是插花、茶道、烹饪，还是挥剑，如果不想追求极致，那就失去了从事其中的意义。",
            "nextDialogs": [
              "220300605"
            ]
          },
          "220300605": {
            "id": "220300605",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "「极意」之道，乃是我为人之道。但是…旭东阁下却似乎和我不同…",
            "nextDialogs": [
              "220300606"
            ]
          },
          "220300606": {
            "id": "220300606",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "旭东阁下曾和我说，璃月有两字，叫做「中庸」。",
            "nextDialogs": [
              "220300607"
            ]
          },
          "220300607": {
            "id": "220300607",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "意思是，无论是为人还是做事，切不可走极端，需不偏不倚，中庸平和才好。",
            "nextDialogs": [
              "220300608"
            ]
          },
          "220300608": {
            "id": "220300608",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "我是不太理解旭东阁下的这句话。",
            "nextDialogs": [
              "220300609"
            ]
          },
          "220300609": {
            "id": "220300609",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "但我想…也许旭东阁下也是经历了许多事，才能有这样的为人道理吧…",
            "nextDialogs": [
              "220300612"
            ]
          },
          "220300612": {
            "id": "220300612",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "既然已经取得食材，也做好了美食，在下就不耽误阁下时间了。",
            "nextDialogs": [
              "220300613"
            ]
          },
          "220300613": {
            "id": "220300613",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "这份请阁下收好，在下会把其余的带回去给旭东阁下，他应该会愿意尝尝的。"
          },
          "220300611": {
            "id": "220300611",
            "speakerId": 1000,
            "speakerName": "龟井宗久",
            "text": "已经被在下解决掉了，阁下无需担心。"
          }
        }
      }
    },

          "700160202": {
            "id": "700160202",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "Mimi muhe du, du ya Wei zido dala si.",
            "nextDialogs": [
              "700160203"
            ]
          },
          "700160203": {
            "id": "700160203",
            "speakerId": 1000,
            "speakerName": "孤独的丘丘人",
            "text": "Mi mito nye. Mi mito du, du ya mito Wei.",
            "nextDialogs": [
              "700160204"
            ]
          },
          "700160204": {
            "id": "700160204",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "它把我们指到了这个地方。说这里应该有人看过。",
            "nextDialogs": [
              "700160205"
            ]
          },
          "700160205": {
            "id": "700160205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Valo! Tomo!",
            "nextDialogs": [
              "700160206"
            ]
          },
          "700160206": {
            "id": "700160206",
            "speakerId": 1000,
            "speakerName": "孤独的丘丘人",
            "text": "Valo, valo…"
          }
        }

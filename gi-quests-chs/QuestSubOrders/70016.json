    {
      "subId": "7001601",
      "subQuestName": "与丘丘人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700160101"
        ],
        "dialogs": {
          "700160101": {
            "id": "700160101",
            "speakerId": 1000,
            "speakerName": "孤独的丘丘人",
            "text": "…Yaya dala?",
            "nextDialogs": [
              "700160102"
            ]
          },
          "700160102": {
            "id": "700160102",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "Mimi tomo, mimi mosi mita, Muhe mita?",
            "nextDialogs": [
              "700160103"
            ]
          },
          "700160103": {
            "id": "700160103",
            "speakerId": 1000,
            "speakerName": "孤独的丘丘人",
            "text": "Mita…? Gusha… Dada ika odomu Plata mimi, mimi mosi gusha…",
            "nextDialogs": [
              "700160104"
            ]
          },
          "700160104": {
            "id": "700160104",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "Mimi tomo, mimi plata yaya ika! Mimi mani ye!",
            "nextDialogs": [
              "700160105"
            ]
          },
          "700160105": {
            "id": "700160105",
            "speakerId": 1000,
            "speakerName": "孤独的丘丘人",
            "text": "Mani…? Dada! Kundala zido mi, mi dada, mimi tomo!",
            "nextDialogs": [
              "700160106"
            ]
          },
          "700160106": {
            "id": "700160106",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "他们两个聊得很开心的样子呢…",
            "nextDialogs": [
              "700160109"
            ]
          },
          "700160109": {
            "id": "700160109",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "其实它只是不爱说话而已，不过我已经问到需要的信息了。",
            "nextDialogs": [
              "700160110"
            ]
          },
          "700160110": {
            "id": "700160110",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "帮助它打败敌人就好，接下来就交给你们啦！",
            "nextDialogs": [
              "700160111"
            ]
          },
          "700160111": {
            "id": "700160111",
            "speakerId": 1000,
            "speakerName": "孤独的丘丘人",
            "text": "Dada, Valo!"
          }
        }
      }
    },
    {
      "subId": "7001602",

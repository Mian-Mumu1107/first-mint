    {
      "subId": "7105206",
      "subQuestName": "将拍到的奇怪岩石交给海迪夫进行鉴定$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710500601"
        ],
        "dialogs": {
          "710500601": {
            "id": "710500601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于奇怪的岩石…",
            "nextDialogs": [
              "710500602"
            ]
          },
          "710500602": {
            "id": "710500602",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "拍到了奇怪的岩石的照片？",
            "nextDialogs": [
              "710500603"
            ]
          },
          "710500603": {
            "id": "710500603",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "请务必给我看一眼！",
            "nextDialogs": [
              "710500604"
            ]
          },
          "710500604": {
            "id": "710500604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就是这个…",
            "nextDialogs": [
              "710500605"
            ]
          },
          "710500605": {
            "id": "710500605",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "诶呀，这照片！真不愧是枫丹那边做出来的新机型，拍摄得相当清晰。",
            "nextDialogs": [
              "710500606"
            ]
          },
          "710500606": {
            "id": "710500606",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "之前倒是买过一批试验机型，拍得很模糊，而且一台机子还要两个人抬，最后只能放在教令院积灰…",
            "nextDialogs": [
              "710500609"
            ]
          },
          "710500609": {
            "id": "710500609",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "是啊，好歹也是我一顿饭的钱。嗯…看来是时候再买一批新的了。",
            "nextDialogs": [
              "710500610"
            ]
          },
          "710500610": {
            "id": "710500610",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "说远了，我看看，这石头…",
            "nextDialogs": [
              "710500611"
            ]
          },
          "710500611": {
            "id": "710500611",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "嗯，这是化石！",
            "nextDialogs": [
              "710500612"
            ]
          },
          "710500612": {
            "id": "710500612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "化石？",
            "nextDialogs": [
              "710500613"
            ]
          },
          "710500613": {
            "id": "710500613",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "是啊，而且有很多海洋生物…有趣。璃月有一句话叫做…「林园和田野，被茫茫的大海淹没」？说的就是这个。",
            "nextDialogs": [
              "710500614"
            ]
          },
          "710500614": {
            "id": "710500614",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "层岩巨渊这边能够出现化石，就说明原本这些生物曾经被迅速埋藏在地下，骨骼才能保持如此完整的形状。",
            "nextDialogs": [
              "710500615"
            ]
          },
          "710500615": {
            "id": "710500615",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "这么说来，听说这里也时常发生地震…这样就说得通了，活跃的地质活动是形成化石的必要条件之一。",
            "nextDialogs": [
              "710500616"
            ]
          },
          "710500616": {
            "id": "710500616",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "这可对研究这一片区域的古生物类群很有帮助…",
            "nextDialogs": [
              "710500617"
            ]
          },
          "710500617": {
            "id": "710500617",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "可是只有一张的话可不够。",
            "nextDialogs": [
              "710500619"
            ]
          },
          "710500619": {
            "id": "710500619",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "这样你要是还有这样的化石，就拍下来给我吧。",
            "nextDialogs": [
              "710500620"
            ]
          },
          "710500620": {
            "id": "710500620",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那要拍几张才行啊？",
            "nextDialogs": [
              "710500621"
            ]
          },
          "710500621": {
            "id": "710500621",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "我想想，要放进报告里的话，类似的照片4、5张应该足够了…那就5张吧，给我5张类似岩石的照片。",
            "nextDialogs": [
              "710500622"
            ]
          },
          "710500622": {
            "id": "710500622",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "我会给出合适的价钱买下的，这可是大发现啊。"
          }
        }
      }
    },

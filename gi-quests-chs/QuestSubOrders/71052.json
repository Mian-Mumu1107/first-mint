    {
      "subId": "7105209",
      "subQuestName": "将拍摄完成的化石照片交给海迪夫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710500902"
        ],
        "dialogs": {
          "710500902": {
            "id": "710500902",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "不错不错，真是不可多得的好照片啊。",
            "nextDialogs": [
              "710500903"
            ]
          },
          "710500903": {
            "id": "710500903",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "勘探队的那些开销，只要有这几张照片那就值回票价了。",
            "nextDialogs": [
              "710500904"
            ]
          },
          "710500904": {
            "id": "710500904",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "你看，这些都是远古海生生物的骨骼，造型也非常清晰。",
            "nextDialogs": [
              "710500905"
            ]
          },
          "710500905": {
            "id": "710500905",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "证明了层岩巨渊在形成以前，其实是海洋环境。",
            "nextDialogs": [
              "710500906"
            ]
          },
          "710500906": {
            "id": "710500906",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "真可惜，如果是在须弥发现这样的化石，就能够直接搬回教令院进行研究了。",
            "nextDialogs": [
              "710500907"
            ]
          },
          "710500907": {
            "id": "710500907",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "下次再和总务司接洽的时候，跟他们谈谈好了，我们这边出钱请人保护也行，得小心一些啊，不能让矿工把这些化石给敲坏了。",
            "nextDialogs": [
              "710500908"
            ]
          },
          "710500908": {
            "id": "710500908",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "不过…",
            "nextDialogs": [
              "710500911"
            ]
          },
          "710500911": {
            "id": "710500911",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "这些照片…勉强算是足够了。",
            "nextDialogs": [
              "710500912"
            ]
          },
          "710500912": {
            "id": "710500912",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "之前说了吧，这么品相完好，结构完整的化石，它形成也是有条件的。",
            "nextDialogs": [
              "710500913"
            ]
          },
          "710500913": {
            "id": "710500913",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "那就是被迅速埋藏入土中。",
            "nextDialogs": [
              "710500914"
            ]
          },
          "710500914": {
            "id": "710500914",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "层岩巨渊的化石，基本上只出现在某个固定的高度区域。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7470301",
      "subQuestName": "与桑多涅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747030101"
        ],
        "dialogs": {
          "747030101": {
            "id": "747030101",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "等等…这账目…你们确定没算错？",
            "nextDialogs": [
              "747030102"
            ]
          },
          "747030102": {
            "id": "747030102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？有什么问题吗？",
            "nextDialogs": [
              "747030103"
            ]
          },
          "747030103": {
            "id": "747030103",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "…这赚得也太多了吧？",
            "nextDialogs": [
              "747030104"
            ]
          },
          "747030104": {
            "id": "747030104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "后悔只拿三成了？",
            "nextDialogs": [
              "747030105"
            ]
          },
          "747030105": {
            "id": "747030105",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "我在你心中是那么小气的人吗？我单纯在感慨你们居然真能把水族馆运营得那么好。",
            "nextDialogs": [
              "747030106"
            ]
          },
          "747030106": {
            "id": "747030106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我觉得多少也有「千灵映影节」的功劳啦。",
            "nextDialogs": [
              "747030107"
            ]
          },
          "747030107": {
            "id": "747030107",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "这营业额…不止赚回了我租维恩歌莱号的钱，甚至还有很多盈余。",
            "nextDialogs": [
              "747030108"
            ]
          },
          "747030108": {
            "id": "747030108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想转行了？",
            "nextDialogs": [
              "747030109"
            ]
          },
          "747030109": {
            "id": "747030109",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "那倒不至于。我知道自己不适合做生意。我还是对机械结构和术式研究更感兴趣。",
            "nextDialogs": [
              "747030110"
            ]
          },
          "747030110": {
            "id": "747030110",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "不过…也对，看着这地方从一条鱼都没有的房间，变成现在这副模样，的确令人惊讶。",
            "nextDialogs": [
              "747030111"
            ]
          },
          "747030111": {
            "id": "747030111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，这里面也有桑多涅慷慨出借的功劳啦！自己装点的房间被大家喜欢，还是很开心的对吧？",
            "nextDialogs": [
              "747030112"
            ]
          },
          "747030112": {
            "id": "747030112",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "哼，有那么一点点吧。",
            "nextDialogs": [
              "747030113"
            ]
          },
          "747030113": {
            "id": "747030113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "只有一点点吗？",
            "nextDialogs": [
              "747030114"
            ]
          },
          "747030114": {
            "id": "747030114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可能因为她只拿了三成。",
            "nextDialogs": [
              "747030115"
            ]
          },
          "747030115": {
            "id": "747030115",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "说了我不在意这个啦！！"
          }
        }
      }
    }
  ]
}
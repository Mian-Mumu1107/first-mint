    {
      "subId": "7210713",
      "subQuestName": "言灵线索5触发$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721071301"
        ],
        "dialogs": {
          "721071301": {
            "id": "721071301",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "嗯嗯，这样事情就告一段落了。接下来就该把密文记下来，交给神社了。",
            "nextDialogs": [
              "721071302"
            ]
          },
          "721071302": {
            "id": "721071302",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "毕竟不是小生我的「式大将」这样的纸，希望他们能好好保管。要是被虫蛀了、水泡了就麻烦了。",
            "nextDialogs": [
              "721071303"
            ]
          },
          "721071303": {
            "id": "721071303",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "哎呀，真是的。怎么能说这么不吉利的话…"
          }
        }
      }
    },

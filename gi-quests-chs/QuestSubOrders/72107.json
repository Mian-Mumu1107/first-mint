    {
      "subId": "7210734",
      "subQuestName": "书本交互对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721071401"
        ],
        "dialogs": {
          "721071401": {
            "id": "721071401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这样就可以了！好累。",
            "nextDialogs": [
              "721071402"
            ]
          },
          "721071402": {
            "id": "721071402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明明累的是我…",
            "nextDialogs": [
              "721071403"
            ]
          },
          "721071403": {
            "id": "721071403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不要在意这种细节。",
            "nextDialogs": [
              "721071404"
            ]
          },
          "721071404": {
            "id": "721071404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，里面好像有本书…",
            "nextDialogs": [
              "721071405"
            ]
          },
          "721071405": {
            "id": "721071405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，好难读…",
            "nextDialogs": [
              "721071406"
            ]
          },
          "721071406": {
            "id": "721071406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "大概看过一遍了，但又好像完全没有看懂。",
            "nextDialogs": [
              "721071407"
            ]
          },
          "721071407": {
            "id": "721071407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "算了，我们还是去找专业人士问问看吧。",
            "nextDialogs": [
              "721071408"
            ]
          },
          "721071408": {
            "id": "721071408",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "既然是神神鬼鬼的东西…那去鸣神大社吧！"
          }
        }
      }
    },

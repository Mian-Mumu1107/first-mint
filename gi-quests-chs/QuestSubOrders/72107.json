    {
      "subId": "7210704",
      "subQuestName": "在荒废神社中进行调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721070401"
        ],
        "dialogs": {
          "721070401": {
            "id": "721070401",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "言灵的用法，随着「惟神」的血脉消失，理应已经失传了…",
            "nextDialogs": [
              "721070402"
            ]
          },
          "721070402": {
            "id": "721070402",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "…呀，不好意思，没注意到你们。「留念镜」就交给你了。带着它一起，看看世界吧。"
          }
        }
      }
    },
    {
      "subId": "7210703",
      "subQuestName": "在荒废神社中继续调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721070301"
        ],
        "dialogs": {
          "721070301": {
            "id": "721070301",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "你好，远道而来的旅者，欢迎来到「鸣神大社」。",
            "nextDialogs": [
              "721070302"
            ]
          },
          "721070302": {
            "id": "721070302",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "如果有烦恼或者心愿，可以找玄冬小姐求签，雷神会保佑你的。",
            "nextDialogs": [
              "721070303"
            ]
          },
          "721070303": {
            "id": "721070303",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "原来如此，情况我已大致了解了。",
            "nextDialogs": [
              "721070304"
            ]
          },
          "721070304": {
            "id": "721070304",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "「神樱大祓」之事，是很重要的仪式。确实有相关的记载…",
            "nextDialogs": [
              "721070305"
            ]
          },
          "721070305": {
            "id": "721070305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不过？",
            "nextDialogs": [
              "721070306"
            ]
          },
          "721070306": {
            "id": "721070306",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "不过，如今具体的行事方法已经失传了。你手中的《要略》，是很宝贵的史料呢。",
            "nextDialogs": [
              "721070307"
            ]
          },
          "721070307": {
            "id": "721070307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "失传了？",
            "nextDialogs": [
              "721070308"
            ]
          },
          "721070308": {
            "id": "721070308",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难道是愚人众干的？既然稻城小姐说是重要的事情，就很难不觉得他们在背后搞鬼…",
            "nextDialogs": [
              "721070309"
            ]
          },
          "721070309": {
            "id": "721070309",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "啊，不是的。是因为保存不当。受潮、虫蛀等。",
            "nextDialogs": [
              "721070310"
            ]
          },
          "721070310": {
            "id": "721070310",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "721070311"
            ]
          },
          "721070311": {
            "id": "721070311",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "哎呀，真是相当遗憾。有很多史料都丢失了呢。之前八重大人和神里大人也为此很苦恼。",
            "nextDialogs": [
              "721070312"
            ]
          },
          "721070312": {
            "id": "721070312",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "至于「言灵」之事，我也并非一无所知。",
            "nextDialogs": [
              "721070313"
            ]
          },
          "721070313": {
            "id": "721070313",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯嗯，那就请把破解的方法告诉我们吧！",
            "nextDialogs": [
              "721070314"
            ]
          },
          "721070314": {
            "id": "721070314",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "很抱歉，将镇物封印的「言灵咒法」并非特定咒语。",
            "nextDialogs": [
              "721070315"
            ]
          },
          "721070315": {
            "id": "721070315",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "…而是施咒者释术时亲自拟定的单语，也即言灵。",
            "nextDialogs": [
              "721070316"
            ]
          },
          "721070316": {
            "id": "721070316",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊？你的意思是说…",
            "nextDialogs": [
              "721070317"
            ]
          },
          "721070317": {
            "id": "721070317",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咒语…是那个施咒者随随便便拍脑袋想的？",
            "nextDialogs": [
              "721070318"
            ]
          },
          "721070318": {
            "id": "721070318",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "也并非如此。此类言灵一般都有其规律。",
            "nextDialogs": [
              "721070319"
            ]
          },
          "721070319": {
            "id": "721070319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能否详细说说。",
            "nextDialogs": [
              "721070320"
            ]
          },
          "721070320": {
            "id": "721070320",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "嗯…我记得书中是这么记载的。",
            "nextDialogs": [
              "721070321"
            ]
          },
          "721070321": {
            "id": "721070321",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "第一句表示自身在稻妻的威名。是什么什么加上「敕使」二字来着…",
            "nextDialogs": [
              "721070322"
            ]
          },
          "721070322": {
            "id": "721070322",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "第二句则是解释自己自身力量的来源。打个比方，就像「团子」、「拉面」、「轻小说」之类的。",
            "nextDialogs": [
              "721070323"
            ]
          },
          "721070323": {
            "id": "721070323",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯嗯我懂。确实是很了不起的力量来源呢。",
            "nextDialogs": [
              "721070324"
            ]
          },
          "721070324": {
            "id": "721070324",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "只是打个比方啦。记载里，有类似「阴阳博晓」之类的。",
            "nextDialogs": [
              "721070325"
            ]
          },
          "721070325": {
            "id": "721070325",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "至于这第三句…",
            "nextDialogs": [
              "721070328"
            ]
          },
          "721070328": {
            "id": "721070328",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "嗯…如你所料。第三句的内容可以自由发挥。",
            "nextDialogs": [
              "721070329"
            ]
          },
          "721070329": {
            "id": "721070329",
            "speakerId": 1001,
            "speakerName": "稻城萤美",
            "text": "时隔久远，恐怕这世上已经没有了解第三句话的知情人了。",
            "nextDialogs": [
              "721070330"
            ]
          },
          "721070330": {
            "id": "721070330",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那要怎么办！",
            "nextDialogs": [
              "721070331"
            ]
          },
          "721070331": {
            "id": "721070331",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "面具巫女姐姐的托付…还有这片大地…都要完蛋了！"
          }
        }
      }
    },
    {
      "subId": "7210705",
      "subQuestName": "获得【雷樱大祓要略】$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721070501"
        ],
        "dialogs": {
          "721070501": {
            "id": "721070501",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "嗯嗯，很好，看来灵脉姑且还能用。",
            "nextDialogs": [
              "721070502"
            ]
          },
          "721070502": {
            "id": "721070502",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "这里也有她的眷属，是个好地方哪。",
            "nextDialogs": [
              "721070503"
            ]
          },
          "721070503": {
            "id": "721070503",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "那么，小生就用「言灵」把镇物保护起来吧。",
            "nextDialogs": [
              "721070504"
            ]
          },
          "721070504": {
            "id": "721070504",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "那么，第一句就是<color=#00E1FFFF>「鸣神敕使」</color>了。"
          }
        }
      }
    },
    {
      "subId": "7210706",
      "subQuestName": "判定言灵关键环完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721070601"
        ],
        "dialogs": {
          "721070601": {
            "id": "721070601",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "…我还是依据前例，把第二句设成<color=#00E1FFFF>「白辰血脉」</color>好了。毕竟小生也算不上阴阳通晓。嗯嗯。",
            "nextDialogs": [
              "721070602"
            ]
          },
          "721070602": {
            "id": "721070602",
            "speakerId": 1003,
            "speakerName": "神秘的女性",
            "text": "你是…那个表面上很亲切的人。",
            "nextDialogs": [
              "721070603"
            ]
          },
          "721070603": {
            "id": "721070603",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "呀，好久不见。对小生我还是这么无情呢…",
            "nextDialogs": [
              "721070604"
            ]
          },
          "721070604": {
            "id": "721070604",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "…不对。你是谁？",
            "nextDialogs": [
              "721070605"
            ]
          },
          "721070605": {
            "id": "721070605",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "这种气息，「大祓」的时期又到了吗…",
            "nextDialogs": [
              "721070606"
            ]
          },
          "721070606": {
            "id": "721070606",
            "speakerId": 1003,
            "speakerName": "神秘的女性",
            "text": "我是…我叫「花散里」。",
            "nextDialogs": [
              "721070607"
            ]
          },
          "721070607": {
            "id": "721070607",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "…不用说了。我明白了。",
            "nextDialogs": [
              "721070608"
            ]
          },
          "721070608": {
            "id": "721070608",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "小生还以为她回来了。原来这么一回事吗。",
            "nextDialogs": [
              "721070609"
            ]
          },
          "721070609": {
            "id": "721070609",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "嗯嗯。没什么。花散里小姐，初次见面。",
            "nextDialogs": [
              "721070610"
            ]
          },
          "721070610": {
            "id": "721070610",
            "speakerId": 1003,
            "speakerName": "神秘的女性",
            "text": "我…我想起来了。「神樱」的事。你的事情。雷电的事情。",
            "nextDialogs": [
              "721070611"
            ]
          },
          "721070611": {
            "id": "721070611",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "嗯嗯。啊，不对。说不定，你眼前的小生，其实是「五百藏」幻化变成的哟。",
            "nextDialogs": [
              "721070612"
            ]
          },
          "721070612": {
            "id": "721070612",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "毕竟，你没有亲眼见过我对吧，花散里小姐？",
            "nextDialogs": [
              "721070613"
            ]
          },
          "721070613": {
            "id": "721070613",
            "speakerId": 1003,
            "speakerName": "神秘的女性",
            "text": "从我想起来的事情来看，那倒也没多大区别。",
            "nextDialogs": [
              "721070614"
            ]
          },
          "721070614": {
            "id": "721070614",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "欸！好过分——"
          }
        }
      }
    },
    {
      "subId": "7210707",
      "subQuestName": "前往鸣神大社调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7210708",
      "subQuestName": "回到荒废神社，利用「留念镜」调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721070801"
        ],
        "dialogs": {
          "721070801": {
            "id": "721070801",
            "speakerId": 1003,
            "speakerName": "神秘的女性",
            "text": "失去主人与香火的神社，竟然会在这么短时间内荒废成这样…",
            "nextDialogs": [
              "721070802"
            ]
          },
          "721070802": {
            "id": "721070802",
            "speakerId": 1003,
            "speakerName": "神秘的女性",
            "text": "希望洞窟中的「结界」完好。",
            "nextDialogs": [
              "721070803"
            ]
          },
          "721070803": {
            "id": "721070803",
            "speakerId": 1003,
            "speakerName": "神秘的女性",
            "text": "我想起来了。她似乎拜托人，在通往镇守之森路上的水潭边，修了<color=#00E1FFFF>一扇带锁的门</color>。并且将钥匙交给了绀田一族。",
            "nextDialogs": [
              "721070804"
            ]
          },
          "721070804": {
            "id": "721070804",
            "speakerId": 1003,
            "speakerName": "神秘的女性",
            "text": "希望情况还好。"
          }
        }
      }
    },
    {
      "subId": "7210714",
      "subQuestName": "对「天狐雕像」念出「言灵」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7210715",
      "subQuestName": "取得「镇物」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721071501"
        ],
        "dialogs": {
          "721071501": {
            "id": "721071501",
            "speakerId": 1004,
            "speakerName": "记事",
            "text": "「镇物以<color=#00E1FFFF>言灵</color>封印至此。…御灵有四魂，巴有三重。据此我留下了<color=#00E1FFFF>三名式神</color>看守。<color=#00E1FFFF>当它们汇聚在一起时</color>，才能继续。…」"
          }
        }
      }
    },
    {
      "subId": "7210721",
      "subQuestName": "寻找「结界」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7210722",
      "subQuestName": "破除「结界」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7210723",
      "subQuestName": "与花散里交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721000201"
        ],
        "dialogs": {
          "721000201": {
            "id": "721000201",
            "speakerId": 1005,
            "speakerName": "花散里",
            "text": "辛苦二位了。",
            "nextDialogs": [
              "721000202"
            ]
          },
          "721000202": {
            "id": "721000202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "噫！",
            "nextDialogs": [
              "721000203"
            ]
          },
          "721000203": {
            "id": "721000203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么又来了…",
            "nextDialogs": [
              "721000204"
            ]
          },
          "721000204": {
            "id": "721000204",
            "speakerId": 1005,
            "speakerName": "花散里",
            "text": "实在抱歉。有的事情，应该说是「习惯」吧。",
            "nextDialogs": [
              "721000205"
            ]
          },
          "721000205": {
            "id": "721000205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不对！你怎么又在跟踪我们，还不来打个招呼。",
            "nextDialogs": [
              "721000208"
            ]
          },
          "721000208": {
            "id": "721000208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，对不起。我一定是跑来跑去太累了…态度不好，真不好意思。",
            "nextDialogs": [
              "721000209"
            ]
          },
          "721000209": {
            "id": "721000209",
            "speakerId": 1005,
            "speakerName": "花散里",
            "text": "不用在意。此处结界能成功解开，「大祓」的进度又推进了一些，实在多谢二位。",
            "nextDialogs": [
              "721000210"
            ]
          },
          "721000210": {
            "id": "721000210",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "话说回来，「神樱大祓」究竟是怎么一回事呀？和你之前让我们做的「净化」，是一回事吗？"
          }
        }
      }
    },
    {
      "subId": "7210709",
      "subQuestName": "言灵线索1触发$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721070901"
        ],
        "dialogs": {
          "721070901": {
            "id": "721070901",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "……嗯嗯，决定了。这次就不收拾她了。",
            "nextDialogs": [
              "721070902"
            ]
          },
          "721070902": {
            "id": "721070902",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "反正，既不是小生的工作，也不是落武者之类会哇哇乱喊朝我攻过来的妖怪。",
            "nextDialogs": [
              "721070903"
            ]
          },
          "721070903": {
            "id": "721070903",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "今天已经累了。以为见到了再也见不到的朋友，这种感觉，真是相当累人哪…"
          }
        }
      }
    },
    {
      "subId": "7210716",
      "subQuestName": "言灵线索1创生对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7210710",
      "subQuestName": "言灵线索2触发$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721071001"
        ],
        "dialogs": {
          "721071001": {
            "id": "721071001",
            "speakerId": 1003,
            "speakerName": "神秘的女性",
            "text": "那我们就此别过吧。",
            "nextDialogs": [
              "721071002"
            ]
          },
          "721071002": {
            "id": "721071002",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "哎呀，这么冷漠。",
            "nextDialogs": [
              "721071003"
            ]
          },
          "721071003": {
            "id": "721071003",
            "speakerId": 1003,
            "speakerName": "神秘的女性",
            "text": "「朝有红颜夸世路，暮成白骨朽郊原。」",
            "nextDialogs": [
              "721071004"
            ]
          },
          "721071004": {
            "id": "721071004",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "真是扫兴哪，对小生我来说也有「一半」算是感动的重逢。不对，感觉更像是四分之一？",
            "nextDialogs": [
              "721071005"
            ]
          },
          "721071005": {
            "id": "721071005",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "啊，就这么走了吗。真是讨厌的家伙…"
          }
        }
      }
    },
    {
      "subId": "7210717",
      "subQuestName": "言灵线索2创生对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7210711",
      "subQuestName": "言灵线索3触发$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721071101"
        ],
        "dialogs": {
          "721071101": {
            "id": "721071101",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "这么说来，她走了以后，五百藏好像带着族人到处大闹哪。",
            "nextDialogs": [
              "721071102"
            ]
          },
          "721071102": {
            "id": "721071102",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "明明老老实实呆在镇守之森的话，还可以睁一只眼闭一只眼。",
            "nextDialogs": [
              "721071103"
            ]
          },
          "721071103": {
            "id": "721071103",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "嗯嗯。不狠狠收拾一下可不行…"
          }
        }
      }
    },
    {
      "subId": "7210718",
      "subQuestName": "言灵线索3创生对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721070701"
        ],
        "dialogs": {
          "721070701": {
            "id": "721070701",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "那个家伙，真是扫兴呢。",
            "nextDialogs": [
              "721070702"
            ]
          },
          "721070702": {
            "id": "721070702",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "如果有朝一日我要收徒，那一定要找个性格开朗的漂亮大姐姐。嗯嗯。就这么定了。",
            "nextDialogs": [
              "721070703"
            ]
          },
          "721070703": {
            "id": "721070703",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "那么，第三句呢…啊，对了。这个不错——",
            "nextDialogs": [
              "721070704"
            ]
          },
          "721070704": {
            "id": "721070704",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "<color=#00E1FFFF>「油豆腐，速速来」</color>！",
            "nextDialogs": [
              "721070705"
            ]
          },
          "721070705": {
            "id": "721070705",
            "speakerId": 1002,
            "speakerName": "谜样的男性",
            "text": "既然这里是她的领地，那便是白辰一脉的土地。那就用这个吧。"
          }
        }
      }
    },
    {
      "subId": "7210712",
      "subQuestName": "言灵线索4触发$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721071201"
        ],
        "dialogs": {
          "721071201": {
            "id": "721071201",
            "speakerId": 1003,
            "speakerName": "神秘的女性",
            "text": "这里是…是我以前…",
            "nextDialogs": [
              "721071202"
            ]
          },
          "721071202": {
            "id": "721071202",
            "speakerId": 1003,
            "speakerName": "神秘的女性",
            "text": "不对。不是我。是她以前的领地。",
            "nextDialogs": [
              "721071203"
            ]
          },
          "721071203": {
            "id": "721071203",
            "speakerId": 1003,
            "speakerName": "神秘的女性",
            "text": "那边那个人…有种很怀念的感觉…"
          }
        }
      }
    },
    {
      "subId": "7210719",
      "subQuestName": "言灵线索4创生对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

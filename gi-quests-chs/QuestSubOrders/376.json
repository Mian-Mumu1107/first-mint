    {
      "subId": "37603",
      "subQuestName": "(test)失败回滚$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3760301"
        ],
        "dialogs": {
          "3760301": {
            "id": "3760301",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "我觉得冲进酒馆是个好主意",
            "nextDialogs": [
              "3760302"
            ]
          },
          "3760302": {
            "id": "3760302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "何以见得？",
            "nextDialogs": [
              "3760303"
            ]
          },
          "3760303": {
            "id": "3760303",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "可以混进喝酒的人群之中",
            "nextDialogs": [
              "3760304"
            ]
          },
          "3760304": {
            "id": "3760304",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "说不定还能趁乱摸点东西",
            "nextDialogs": [
              "3760305"
            ]
          },
          "3760305": {
            "id": "3760305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这满肚子坏水的诗人…等我们逃过这关，我一定要好好教育你！"
          }
        }
      }
    },
    {
      "subId": "37604",
      "subQuestName": "躲进酒馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3760401"
        ],
        "dialogs": {
          "3760401": {
            "id": "3760401",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "迪卢克老爷，这周的账面就是这样了。",
            "nextDialogs": [
              "3760402"
            ]
          },
          "3760402": {
            "id": "3760402",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "这次风灾，对生意的影响果然很大。",
            "nextDialogs": [
              "3760403"
            ]
          },
          "3760403": {
            "id": "3760403",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "希望这段时间早点过去吧。",
            "nextDialogs": [
              "3760404"
            ]
          },
          "3760404": {
            "id": "3760404",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "老板，我们…想要一个，稍微隐蔽点的地方。",
            "nextDialogs": [
              "3760405"
            ]
          },
          "3760405": {
            "id": "3760405",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "要说隐蔽的话，二楼人少。",
            "nextDialogs": [
              "3760406"
            ]
          },
          "3760406": {
            "id": "3760406",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "但你不是吟游诗人吗？不如选个热闹的位置吧。",
            "nextDialogs": [
              "3760407"
            ]
          },
          "3760407": {
            "id": "3760407",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "啊哈哈，收费演出就等下次吧。我们先上去了，一会见~！",
            "nextDialogs": [
              "3760408"
            ]
          },
          "3760408": {
            "id": "3760408",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "看好他们。那个诗人很可疑，我要去问问情况。",
            "nextDialogs": [
              "3760409"
            ]
          },
          "3760409": {
            "id": "3760409",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "呃…问谁？",
            "nextDialogs": [
              "3760410"
            ]
          },
          "3760410": {
            "id": "3760410",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "蒙德城的「保安」们。"
          }
        }
      }
    },
    {
      "subId": "37605",
      "subQuestName": "回答迪卢克的质问",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "37606",
      "subQuestName": "躲到酒馆的楼上",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3760601"
        ],
        "dialogs": {
          "3760601": {
            "id": "3760601",
            "speakerId": 1004,
            "speakerName": "奥特",
            "text": "啊，迪卢克老爷，你看见那两个小偷了吗？",
            "nextDialogs": [
              "3760602"
            ]
          },
          "3760602": {
            "id": "3760602",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "发生了什么，怎么出动了这么多人？",
            "nextDialogs": [
              "3760603"
            ]
          },
          "3760603": {
            "id": "3760603",
            "speakerId": 1005,
            "speakerName": "麦尔斯",
            "text": "迪卢克老爷没听说吗？有两个小偷，居然打起了天空之琴的主意！",
            "nextDialogs": [
              "3760604"
            ]
          },
          "3760604": {
            "id": "3760604",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "哦？真是奇了。",
            "nextDialogs": [
              "3760605"
            ]
          },
          "3760605": {
            "id": "3760605",
            "speakerId": 1005,
            "speakerName": "麦尔斯",
            "text": "是吧。天空之琴可是风神他老人家亲手弹过的宝物，这样珍贵的文化财产——",
            "nextDialogs": [
              "3760606"
            ]
          },
          "3760606": {
            "id": "3760606",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "居然有人会傻到偷一件卖不出去的东西，还不如偷我家酒窖划算。",
            "nextDialogs": [
              "3760607"
            ]
          },
          "3760607": {
            "id": "3760607",
            "speakerId": 1004,
            "speakerName": "奥特",
            "text": "…",
            "nextDialogs": [
              "3760608"
            ]
          },
          "3760608": {
            "id": "3760608",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "啊，抱歉离题了。那一黄一绿的两个人，好像往那边去了。",
            "nextDialogs": [
              "3760609"
            ]
          },
          "3760609": {
            "id": "3760609",
            "speakerId": 1005,
            "speakerName": "麦尔斯",
            "text": "好的好的。谢谢迪卢克老爷！"
          }
        }
      }
    },
    {
      "subId": "37607",
      "subQuestName": "(test)等待卫兵离去$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

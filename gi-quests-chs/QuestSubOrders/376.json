      }
    },
    {
      "subId": "37608",
      "subQuestName": "与迪卢克对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3760701"
        ],
        "dialogs": {
          "3760701": {
            "id": "3760701",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "今天想喝…",
            "nextDialogs": [
              "3760702"
            ]
          },
          "3760702": {
            "id": "3760702",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "把从柜子后面摸来的酒给我放下。",
            "nextDialogs": [
              "3760703"
            ]
          },
          "3760703": {
            "id": "3760703",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "…想喝冰一点的。",
            "nextDialogs": [
              "3760704"
            ]
          },
          "3760704": {
            "id": "3760704",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "好了，你们该好好回答一下我的问题了。",
            "nextDialogs": [
              "3760705"
            ]
          },
          "3760705": {
            "id": "3760705",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "先让我喝完，我会付账的啦…嗯，用表演抵债。",
            "nextDialogs": [
              "3760706"
            ]
          },
          "3760706": {
            "id": "3760706",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "不是钱的问题，你看起来还没到能买酒的年纪。",
            "nextDialogs": [
              "3760707"
            ]
          },
          "3760707": {
            "id": "3760707",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "这你可以放心，我喝酒的时候你还在——",
            "nextDialogs": [
              "3760709"
            ]
          },
          "3760709": {
            "id": "3760709",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "你想问「这是哪位」，对吗？",
            "nextDialogs": [
              "3760711"
            ]
          },
          "3760711": {
            "id": "3760711",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "想必这位就是<color=#00E1FFFF>迪卢克</color>老爷，酒馆老板背后的…大老板。",
            "nextDialogs": [
              "3760712"
            ]
          },
          "3760712": {
            "id": "3760712",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "是很有名的人呢。顺带一提，我很喜欢他家出品的蒲公英酒。",
            "nextDialogs": [
              "3760713"
            ]
          },
          "3760713": {
            "id": "3760713",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "虽然大部分时间我只买得起散装的…",
            "nextDialogs": [
              "3760714"
            ]
          },
          "3760714": {
            "id": "3760714",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "我刚从卫兵那里听说小偷的事。",
            "nextDialogs": [
              "3760715"
            ]
          },
          "3760715": {
            "id": "3760715",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "先说明一下，你们居然敢去偷天空之琴，我很欣赏。",
            "nextDialogs": [
              "3760716"
            ]
          },
          "3760716": {
            "id": "3760716",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "就算你们是傻子，那也是千年少见的傻子了。",
            "nextDialogs": [
              "3760717"
            ]
          },
          "3760717": {
            "id": "3760717",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不是我们偷的啦！真犯人另有其人——",
            "nextDialogs": [
              "3760718"
            ]
          },
          "3760718": {
            "id": "3760718",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "这位可是骑士团的当红新人，怎么会去偷蒙德的圣物呢？",
            "nextDialogs": [
              "3760719"
            ]
          },
          "3760719": {
            "id": "3760719",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "当红新人…？啊，原来就是你啊。",
            "nextDialogs": [
              "3760720"
            ]
          },
          "3760720": {
            "id": "3760720",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "怎么，你和那个吟游诗人是熟人吗？"
          }
        }
      }
    },
    {
      "subId": "48202",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4820221"
        ],
        "dialogs": {
          "4820221": {
            "id": "4820221",
            "speakerId": 1006,
            "speakerName": "安柏",
            "text": "按照我给你<color=#00E1FFFF>标记好的路线</color>，一路平稳地飞到终点吧。"
          }
        }
      }
    }
  ]
}
{
  "lineCounts": {
    "Player": 2,
    "布伦妮": 17,
    "派蒙": 9
  },
  "subQuests": [
    {
      "subId": "4023201",
      "subQuestName": "与布伦妮对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402281101"
        ],
        "dialogs": {
          "402281101": {
            "id": "402281101",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "通过元素配合获取伤害增益…也就是说，只要作战策略得当，即便是魔女也并非不能战胜…",
            "nextDialogs": [
              "402281102"
            ]
          },
          "402281102": {
            "id": "402281102",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "刚才的冰霜骗骗花，是种典型的拟态植物魔物，不像是魔女派来的魔物。",
            "nextDialogs": [
              "402281103"
            ]
          },
          "402281103": {
            "id": "402281103",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "#面对遁地和冰刺攻击，走位尤其重要，{NICKNAME}的身法就够我学好久了，还有{M#他}{F#她}的招式…总之先抄下来…",
            "nextDialogs": [
              "402281104"
            ]
          },
          "402281104": {
            "id": "402281104",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "「猎魔演练·改·第16稿」…搞定！",
            "nextDialogs": [
              "402281105"
            ]
          },
          "402281105": {
            "id": "402281105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "布伦妮，你在记笔记吗？",
            "nextDialogs": [
              "402281106"
            ]
          },
          "402281106": {
            "id": "402281106",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "呜哇！吓我一跳，你走路怎么没脚步声啊？",
            "nextDialogs": [
              "402281107"
            ]
          },
          "402281107": {
            "id": "402281107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我用飞的呀！",
            "nextDialogs": [
              "402281108"
            ]
          },
          "402281108": {
            "id": "402281108",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "你们刚才都听到了？",
            "nextDialogs": [
              "402281109"
            ]
          },
          "402281109": {
            "id": "402281109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听到了猎魔演练。",
            "nextDialogs": [
              "402281110"
            ]
          },
          "402281110": {
            "id": "402281110",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "既然如此，接下来我要说一个事，希望你们听完不要太惊讶。",
            "nextDialogs": [
              "402281111"
            ]
          },
          "402281111": {
            "id": "402281111",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "艾莉丝给我的书里夹着几张稿纸，有非常神奇的魔法——能将纸上的内容复现在幻想秘境中。",
            "nextDialogs": [
              "402281112"
            ]
          },
          "402281112": {
            "id": "402281112",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "我知道这有点难以想象。这么说吧，就像人能进入童话书里的世界一样。",
            "nextDialogs": [
              "402281113"
            ]
          },
          "402281113": {
            "id": "402281113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，不就是希穆兰卡嘛，我们早就去过了。",
            "nextDialogs": [
              "402281114"
            ]
          },
          "402281114": {
            "id": "402281114",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "（什么卡？没听过！不会真有本能进去的童话书吧…）",
            "nextDialogs": [
              "402281115"
            ]
          },
          "402281115": {
            "id": "402281115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以布伦妮在上面写了什么童话？我们能进去看看吗？",
            "nextDialogs": [
              "402281116"
            ]
          },
          "402281116": {
            "id": "402281116",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "稿纸就这几张，怎么能浪费在那些不切实际的东西上，当然要用来增值自己啊。",
            "nextDialogs": [
              "402281117"
            ]
          },
          "402281117": {
            "id": "402281117",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "自学完这本教材后，我写了一套战斗训练计划，假以时日，一定能亲手打败艾莉丝！",
            "nextDialogs": [
              "402281118"
            ]
          },
          "402281118": {
            "id": "402281118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你们不是朋友吗？为什么要打败她呢？",
            "nextDialogs": [
              "402281119"
            ]
          },
          "402281119": {
            "id": "402281119",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "（完蛋，兴奋过头说漏嘴了…）",
            "nextDialogs": [
              "402281120"
            ]
          },
          "402281120": {
            "id": "402281120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我懂了…",
            "nextDialogs": [
              "402281121"
            ]
          },
          "402281121": {
            "id": "402281121",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "（瞒不住了吗…）",
            "nextDialogs": [
              "402281122"
            ]
          },
          "402281122": {
            "id": "402281122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们肯定是特别要好的朋友吧！",
            "nextDialogs": [
              "402281123"
            ]
          },
          "402281123": {
            "id": "402281123",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "欸？",
            "nextDialogs": [
              "402281124"
            ]
          },
          "402281124": {
            "id": "402281124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}也有这样的朋友哦，那家伙只要一有机会就会邀请{NICKNAME}跟他打架切磋。",
            "nextDialogs": [
              "402281125"
            ]
          },
          "402281125": {
            "id": "402281125",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#毕竟{M#他}{F#她}是鼎鼎大名的旅行者嘛，所以，布伦妮想提升武艺的话，找{M#他}{F#她}也行哦！",
            "nextDialogs": [
              "402281126"
            ]
          },
          "402281126": {
            "id": "402281126",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "啊？又我？",
            "nextDialogs": [
              "402281127"
            ]
          },
          "402281127": {
            "id": "402281127",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "对哦！我干嘛偷偷抄技巧呀，直接请活的高手亲自教我不是更快吗！",
            "nextDialogs": [
              "402281128"
            ]
          },
          "402281128": {
            "id": "402281128",
            "speakerId": 1329,
            "speakerName": "布伦妮",
            "text": "可以请你参与到我的演练中来吗？你的战斗示范一定很有参考价值。"
          }
        }
      }
    }
  ]
}
      }
    },
    {
      "subId": "7055303",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705530301"
        ],
        "dialogs": {
          "705530301": {
            "id": "705530301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "大团长，请收下你的特调！这回肯定能喝个尽兴了！",
            "nextDialogs": [
              "705530302"
            ]
          },
          "705530302": {
            "id": "705530302",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "怎么搞的，这股气势…滚滚涌来的火水气味，好像要把空气点燃…这才对嘛！",
            "nextDialogs": [
              "705530303"
            ]
          },
          "705530303": {
            "id": "705530303",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "……",
            "nextDialogs": [
              "705530304"
            ]
          },
          "705530304": {
            "id": "705530304",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "痛快！我感受到了…你放下拘谨后，拿出了惊艳的实力！",
            "nextDialogs": [
              "705530305"
            ]
          },
          "705530305": {
            "id": "705530305",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "入口瞬间，薄荷发动清凉的佯攻，暂时掩盖火水的行动。",
            "nextDialogs": [
              "705530306"
            ]
          },
          "705530306": {
            "id": "705530306",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "等到那股甜味消散，火水已经滑下喉咙，强劲的酒精味瞬间在口腔中爆发开来，正是我想要的冲击感！",
            "nextDialogs": [
              "705530309"
            ]
          },
          "705530309": {
            "id": "705530309",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "这一点尤为精妙！火水的尾段太过平淡，甚至是纯净无味，一直被人诟病，而酸奶油恰好将口感维持在热烈的峰值！"
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "7055301",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705530101"
        ],
        "dialogs": {
          "705530101": {
            "id": "705530101",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "哟！我们的荣誉骑士也被赫塔「逮捕」，来帮忙干活了？",
            "nextDialogs": [
              "705530102"
            ]
          },
          "705530102": {
            "id": "705530102",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "之前聊到饮料摊位的时候，我看着酒单，就有些按捺不住了，现在正好验收一下成果。",
            "nextDialogs": [
              "705530103"
            ]
          },
          "705530103": {
            "id": "705530103",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "虽然不久前才在广场上喝过两杯，但…酒这种好东西，在不伤身的范围内，多多益善！",
            "nextDialogs": [
              "705530104"
            ]
          },
          "705530104": {
            "id": "705530104",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "既然事情已经告一段落，接下来，就是轻松享受的时候了。",
            "nextDialogs": [
              "705530107"
            ]
          },
          "705530107": {
            "id": "705530107",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "那可不得了，我必须好好尝尝你的手艺！给我来杯适合慢慢闲聊，但又足够有劲的酒…"
          }
        }
      }
    },
    {
      "subId": "7055302",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],

    {
      "subId": "7055306",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705530201"
        ],
        "dialogs": {
          "705530201": {
            "id": "705530201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "大团长，请检验这杯「带刺镜湖」的成色！",
            "nextDialogs": [
              "705530202"
            ]
          },
          "705530202": {
            "id": "705530202",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "嗯，色彩和香气到位了，酒体的火候嘛…入口便知。",
            "nextDialogs": [
              "705530203"
            ]
          },
          "705530203": {
            "id": "705530203",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "不错，每种成分的用量都相当准确，可惜，还是显得太有「礼貌」了…",
            "nextDialogs": [
              "705530206"
            ]
          },
          "705530206": {
            "id": "705530206",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "当然是谦逊的礼貌！你选择了严格按照配方，甚至更保守的比例来调和这杯「带刺镜湖」。",
            "nextDialogs": [
              "705530207"
            ]
          },
          "705530207": {
            "id": "705530207",
            "speakerId": 1000,
            "speakerName": "法尔伽",
            "text": "好像在担心…只要这杯酒的口味有那么一丁点偏差，就会让我失望？"
          }
        }
      }
    },

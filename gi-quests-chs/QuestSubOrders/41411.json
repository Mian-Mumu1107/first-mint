  "subQuests": [
    {
      "subId": "4141115",
      "subQuestName": "前往西风骑士团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414111501"
        ],
        "dialogs": {
          "414111501": {
            "id": "414111501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "温迪应该已经到了，进去看看吧！",
            "nextDialogs": [
              "414111502"
            ]
          },
          "414111502": {
            "id": "414111502",
            "speakerId": 1001,
            "speakerName": "阿托",
            "text": "请留步！几位，有何贵干？",
            "nextDialogs": [
              "414111503"
            ]
          },
          "414111503": {
            "id": "414111503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "凯亚在吗？我们找他有事。",
            "nextDialogs": [
              "414111504"
            ]
          },
          "414111504": {
            "id": "414111504",
            "speakerId": 1001,
            "speakerName": "阿托",
            "text": "找凯亚队长的话，他在琴团长办公室执勤。",
            "nextDialogs": [
              "414111505"
            ]
          },
          "414111505": {
            "id": "414111505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，怎么在琴团长办公室里？",
            "nextDialogs": [
              "414111506"
            ]
          },
          "414111506": {
            "id": "414111506",
            "speakerId": 1001,
            "speakerName": "阿托",
            "text": "风花节庆典一直是由我们西风骑士团主办，庆典期间，琴团长会亲自外出巡逻。",
            "nextDialogs": [
              "414111507"
            ]
          },
          "414111507": {
            "id": "414111507",
            "speakerId": 1001,
            "speakerName": "阿托",
            "text": "积压的书案工作，就交由凯亚队长代理了。",
            "nextDialogs": [
              "414111508"
            ]
          },
          "414111508": {
            "id": "414111508",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来如此。"
          }
        }
      }
    },
    {
      "subId": "4141101",
      "subQuestName": "收取凯亚的作业",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414110101"
        ],
        "dialogs": {
          "414110101": {
            "id": "414110101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哟哈！",
            "nextDialogs": [
              "414110102"
            ]
          },
          "414110102": {
            "id": "414110102",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "旅行者，派蒙，你们来了。",
            "nextDialogs": [
              "414110103"
            ]
          },
          "414110103": {
            "id": "414110103",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "我才想到你们，你们就来了，真巧。",
            "nextDialogs": [
              "414110104"
            ]
          },
          "414110104": {
            "id": "414110104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "凯亚，你的作业写完了吗？",
            "nextDialogs": [
              "414110105"
            ]
          },
          "414110105": {
            "id": "414110105",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "恐怕要让你失望了，我还没开始写。",
            "nextDialogs": [
              "414110106"
            ]
          },
          "414110106": {
            "id": "414110106",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "不交作业的学生可不是好学生。",
            "nextDialogs": [
              "414110107"
            ]
          },
          "414110107": {
            "id": "414110107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "凯亚不做作业是在忙什么呢？",
            "nextDialogs": [
              "414110108"
            ]
          },
          "414110108": {
            "id": "414110108",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "嗯~如你所见，在帮琴团长处理各种事务。",
            "nextDialogs": [
              "414110109"
            ]
          },
          "414110109": {
            "id": "414110109",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "庆典期间蒙德城里热闹得很，随之而来的杂事也多得可怕。我已经忙了好久啦。",
            "nextDialogs": [
              "414110110"
            ]
          },
          "414110110": {
            "id": "414110110",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "旅行者，能请你帮个忙吗？",
            "nextDialogs": [
              "414110111"
            ]
          },
          "414110111": {
            "id": "414110111",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "有位酒友托我办事，但我实在脱不开身…想请你代我跑一趟。",
            "nextDialogs": [
              "414110112"
            ]
          },
          "414110112": {
            "id": "414110112",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "酒友，是在酒馆认识的朋友？",
            "nextDialogs": [
              "414110113"
            ]
          },
          "414110113": {
            "id": "414110113",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "是啊。下班偶尔去酒馆喝一杯，不知不觉结交了许多朋友呢。",
            "nextDialogs": [
              "414110114"
            ]
          },
          "414110114": {
            "id": "414110114",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "他叫宁禄，一般会在酒馆附近出没。这个时间，我猜他应该闲着。",
            "nextDialogs": [
              "414110115"
            ]
          },
          "414110115": {
            "id": "414110115",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "我得留下来写作业，宁禄的事就麻烦你了。"
          }
        }
      }
    },
    {
      "subId": "4141114",
      "subQuestName": "在酒馆外寻找宁禄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414111401"
        ],
        "dialogs": {
          "414111401": {
            "id": "414111401",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "唉，怎么办才好…",
            "nextDialogs": [
              "414111402"
            ]
          },
          "414111402": {
            "id": "414111402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你就是宁禄吗？凯亚说你找他有事，他现在走不开，让我们来帮你。",
            "nextDialogs": [
              "414111403"
            ]
          },
          "414111403": {
            "id": "414111403",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "嗯？旅行者，没想到是你。",
            "nextDialogs": [
              "414111404"
            ]
          },
          "414111404": {
            "id": "414111404",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "是这样的，我在为我太太准备风花节的礼物，想麻烦酒友凯亚出个主意。",
            "nextDialogs": [
              "414111405"
            ]
          },
          "414111405": {
            "id": "414111405",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "呃…我、我这人，酒瘾有些重，三天两头泡在酒馆。我太太反对我喝酒，为此我们总是吵架。",
            "nextDialogs": [
              "414111406"
            ]
          },
          "414111406": {
            "id": "414111406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来你是个酒鬼呀…",
            "nextDialogs": [
              "414111407"
            ]
          },
          "414111407": {
            "id": "414111407",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "我明白，酒是好东西！不过你这样的喝法，嗯…",
            "nextDialogs": [
              "414111408"
            ]
          },
          "414111408": {
            "id": "414111408",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "道理我都懂，所以才觉得，有些对不起她。",
            "nextDialogs": [
              "414111409"
            ]
          },
          "414111409": {
            "id": "414111409",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "旅行者，能麻烦你们帮我搜集材料吗？我想亲手制作一份礼物送给我太太。",
            "nextDialogs": [
              "414111410"
            ]
          },
          "414111410": {
            "id": "414111410",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "按理说我得自己准备，可最近酒喝多了，一不留神睡了过去。醒来时庆典已经开始啦！凭我自己，多半是来不及了…",
            "nextDialogs": [
              "414111411"
            ]
          },
          "414111411": {
            "id": "414111411",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这人也太乱来了吧。",
            "nextDialogs": [
              "414111412"
            ]
          },
          "414111412": {
            "id": "414111412",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "未婚的蒙德人可不敢在庆典期间托人办事，宁禄，还好你已经结婚了。",
            "nextDialogs": [
              "414111413"
            ]
          },
          "414111413": {
            "id": "414111413",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "哎哎，是啊…真抱歉，让你们看笑话了。",
            "nextDialogs": [
              "414111414"
            ]
          },
          "414111414": {
            "id": "414111414",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真没办法。说吧，需要什么？",
            "nextDialogs": [
              "414111415"
            ]
          },
          "414111415": {
            "id": "414111415",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "我会在城里搜索木材，用于填充的植物只能到野外采集，就拜托你们了。我需要2株小灯草。",
            "nextDialogs": [
              "414111416"
            ]
          },
          "414111416": {
            "id": "414111416",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "小灯草和木板，能做出什么？",
            "nextDialogs": [
              "414111417"
            ]
          },
          "414111417": {
            "id": "414111417",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "我想用木板搭一间小房子，配上发光的花朵和手工制作的小家具…送给她。",
            "nextDialogs": [
              "414111418"
            ]
          },
          "414111418": {
            "id": "414111418",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "很温情的礼物呢。",
            "nextDialogs": [
              "414111419"
            ]
          },
          "414111419": {
            "id": "414111419",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "一点心意，哈哈。我刚认识她那会儿，经常给她做手工小礼物，她非常喜欢，还说…",
            "nextDialogs": [
              "414111420"
            ]
          },
          "414111420": {
            "id": "414111420",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "啊！咳咳，抱歉，以前的事就不提了。总之，麻烦各位啦。",
            "nextDialogs": [
              "414111421"
            ]
          },
          "414111421": {
            "id": "414111421",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "算你运气好，遇到我们这么好心的帮手。",
            "nextDialogs": [
              "414111422"
            ]
          },
          "414111422": {
            "id": "414111422",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "走吧！去找他要的东西！"
          }
        }
      }
    },
    {
      "subId": "4141102",
      "subQuestName": "搜集两株小灯草",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414110201"
        ],
        "dialogs": {
          "414110201": {
            "id": "414110201",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "好久没做木工了，但愿一切顺利。"
          }
        }
      }
    },
    {
      "subId": "4141103",
      "subQuestName": "与宁禄对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414110301"
        ],
        "dialogs": {
          "414110301": {
            "id": "414110301",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "谢谢，谢谢你们！有了这个，我马上就能开工。",
            "nextDialogs": [
              "414110302"
            ]
          },
          "414110302": {
            "id": "414110302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不要只是做礼物，以后也要好好对你太太呀！",
            "nextDialogs": [
              "414110303"
            ]
          },
          "414110303": {
            "id": "414110303",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "一定，一定。",
            "nextDialogs": [
              "414110304"
            ]
          },
          "414110304": {
            "id": "414110304",
            "speakerId": 1004,
            "speakerName": "宁禄",
            "text": "唉，要是我做的这些礼物能让她喜欢就好了。",
            "nextDialogs": [
              "414110305"
            ]
          },
          "414110305": {
            "id": "414110305",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "没人不喜欢饱含情意的礼物，放心吧。",
            "nextDialogs": [
              "414110306"
            ]
          },
          "414110306": {
            "id": "414110306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好好做哦，不要浪费了我们辛辛苦苦找来的材料。"
          }
        }
      }
    },
    {
      "subId": "4141105",
      "subQuestName": "回骑士团向凯亚汇报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414110501"
        ],
        "dialogs": {
          "414110501": {
            "id": "414110501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们回来啦！凯亚，你写完了吗？",
            "nextDialogs": [
              "414110502"
            ]
          },
          "414110502": {
            "id": "414110502",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "老师要来收作业啦！",
            "nextDialogs": [
              "414110503"
            ]
          },
          "414110503": {
            "id": "414110503",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "欢迎回来，我这边刚好也差不多了。",
            "nextDialogs": [
              "414110504"
            ]
          },
          "414110504": {
            "id": "414110504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "快快快，交作业交作业~",
            "nextDialogs": [
              "414110505"
            ]
          },
          "414110505": {
            "id": "414110505",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "来了来了，别笑话我就行。",
            "nextDialogs": [
              "414110506"
            ]
          },
          "414110506": {
            "id": "414110506",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "嗯…嗯？唔唔。",
            "nextDialogs": [
              "414110507"
            ]
          },
          "414110507": {
            "id": "414110507",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "卖唱的，点评一下？",
            "nextDialogs": [
              "414110508"
            ]
          },
          "414110508": {
            "id": "414110508",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "凯亚，我可以把这首诗读出来吗？",
            "nextDialogs": [
              "414110509"
            ]
          },
          "414110509": {
            "id": "414110509",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "请吧。",
            "nextDialogs": [
              "414110510"
            ]
          },
          "414110510": {
            "id": "414110510",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "咳咳！",
            "nextDialogs": [
              "414110511"
            ]
          },
          "414110511": {
            "id": "414110511",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "「mi muhe ye\\n在丘丘人的语言里\\n是我爱你。」",
            "nextDialogs": [
              "414110512"
            ]
          },
          "414110512": {
            "id": "414110512",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？嗯？？",
            "nextDialogs": [
              "414110513"
            ]
          },
          "414110513": {
            "id": "414110513",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "读完了。",
            "nextDialogs": [
              "414110514"
            ]
          },
          "414110514": {
            "id": "414110514",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没啦？",
            "nextDialogs": [
              "414110515"
            ]
          },
          "414110515": {
            "id": "414110515",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "主旨清晰，表达到位，我认为这种长度足够了。",
            "nextDialogs": [
              "414110516"
            ]
          },
          "414110516": {
            "id": "414110516",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哎哎哎？！完全就是丘丘语教学啊！",
            "nextDialogs": [
              "414110519"
            ]
          },
          "414110519": {
            "id": "414110519",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "哈哈哈，不觉得是很有我风格的情诗吗？",
            "nextDialogs": [
              "414110520"
            ]
          },
          "414110520": {
            "id": "414110520",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "更像是敷衍的情诗呢。",
            "nextDialogs": [
              "414110521"
            ]
          },
          "414110521": {
            "id": "414110521",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "凯亚居然会丘丘人语？好奇怪啊。",
            "nextDialogs": [
              "414110522"
            ]
          },
          "414110522": {
            "id": "414110522",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "哈哈，别小看西风骑士团骑兵队长的知识储备哦！",
            "nextDialogs": [
              "414110523"
            ]
          },
          "414110523": {
            "id": "414110523",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "好了，是时候去收下一份…",
            "nextDialogs": [
              "414110524"
            ]
          },
          "414110524": {
            "id": "414110524",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "——！！",
            "nextDialogs": [
              "414110525"
            ]
          },
          "414110525": {
            "id": "414110525",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "刚刚似乎有道可疑的人影，我得去看一下。旅行者，还有件小事麻烦你。",
            "nextDialogs": [
              "414110526"
            ]
          },
          "414110526": {
            "id": "414110526",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "教会向我们申请了狩猎许可，得请你把这份许可文书送到大教堂。",
            "nextDialogs": [
              "414110527"
            ]
          },
          "414110527": {
            "id": "414110527",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唉，我们又要跑腿啦。"
          }
        }
      }
    },
    {
      "subId": "4141106",
      "subQuestName": "前往蒙德大教堂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4141107",
      "subQuestName": "与琴和丽莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414110701"
        ],
        "dialogs": {
          "414110701": {
            "id": "414110701",
            "speakerId": 1005,
            "speakerName": "琴",
            "text": "丽莎，我们约法三章，就算是阻止街头闹事的醉汉也不能用法术电他们，好吗？",
            "nextDialogs": [
              "414110702"
            ]
          },
          "414110702": {
            "id": "414110702",
            "speakerId": 1006,
            "speakerName": "丽莎",
            "text": "琴误会了呢。上次你看到那一幕，是醉鬼主动恳求的哦。所以我想，也许有人就喜欢这样…",
            "nextDialogs": [
              "414110703"
            ]
          },
          "414110703": {
            "id": "414110703",
            "speakerId": 1005,
            "speakerName": "琴",
            "text": "丽莎！",
            "nextDialogs": [
              "414110704"
            ]
          },
          "414110704": {
            "id": "414110704",
            "speakerId": 1006,
            "speakerName": "丽莎",
            "text": "好吧，既然琴反对，那就算了。",
            "nextDialogs": [
              "414110705"
            ]
          },
          "414110705": {
            "id": "414110705",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "琴团长，丽莎小姐！",
            "nextDialogs": [
              "414110706"
            ]
          },
          "414110706": {
            "id": "414110706",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "二位，好久不见了。",
            "nextDialogs": [
              "414110707"
            ]
          },
          "414110707": {
            "id": "414110707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在这里做什么呢？",
            "nextDialogs": [
              "414110708"
            ]
          },
          "414110708": {
            "id": "414110708",
            "speakerId": 1005,
            "speakerName": "琴",
            "text": "好久不见了。如各位所见，我和丽莎正在执勤。",
            "nextDialogs": [
              "414110709"
            ]
          },
          "414110709": {
            "id": "414110709",
            "speakerId": 1006,
            "speakerName": "丽莎",
            "text": "#是小可爱和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的朋友们呀。来的路上有看到什么奇怪的人吗？发现怪人怪事可以向骑士团举报哦。",
            "nextDialogs": [
              "414110710"
            ]
          },
          "414110710": {
            "id": "414110710",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "图书管理员也要巡逻的吗？",
            "nextDialogs": [
              "414110711"
            ]
          },
          "414110711": {
            "id": "414110711",
            "speakerId": 1006,
            "speakerName": "丽莎",
            "text": "一般不用，但风花节期间人手紧缺，就连我这样的小人物，也被叫出来执勤了呢。",
            "nextDialogs": [
              "414110712"
            ]
          },
          "414110712": {
            "id": "414110712",
            "speakerId": 1005,
            "speakerName": "琴",
            "text": "丽莎，小人物可不会具有你那样强大的雷元素力。",
            "nextDialogs": [
              "414110713"
            ]
          },
          "414110713": {
            "id": "414110713",
            "speakerId": 1005,
            "speakerName": "琴",
            "text": "不过各位请放心，我会监督好丽莎的。就算她喜欢用电击的方式分开斗殴市民、把惹事醉汉电到求饶…",
            "nextDialogs": [
              "414110714"
            ]
          },
          "414110714": {
            "id": "414110714",
            "speakerId": 1006,
            "speakerName": "丽莎",
            "text": "琴不喜欢的话，我就不这样好了。",
            "nextDialogs": [
              "414110715"
            ]
          },
          "414110715": {
            "id": "414110715",
            "speakerId": 1005,
            "speakerName": "琴",
            "text": "是吗？那太好了，否则我真要考虑吊销图书管理员小姐与我一同巡逻的资格了。",
            "nextDialogs": [
              "414110716"
            ]
          },
          "414110716": {
            "id": "414110716",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来巡逻是这么刺激的活动啊，长、长见识了。"
          }
        }
      }
    },
    {
      "subId": "4141108",
      "subQuestName": "与芭芭拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414110801"
        ],
        "dialogs": {
          "414110801": {
            "id": "414110801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "芭芭拉，我们受凯亚委托来送…",
            "nextDialogs": [
              "414110802"
            ]
          },
          "414110802": {
            "id": "414110802",
            "speakerId": 1007,
            "speakerName": "班尼特",
            "text": "太过分了，这是恐吓！",
            "nextDialogs": [
              "414110803"
            ]
          },
          "414110803": {
            "id": "414110803",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "怎么会这样…",
            "nextDialogs": [
              "414110804"
            ]
          },
          "414110804": {
            "id": "414110804",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜呃？！",
            "nextDialogs": [
              "414110805"
            ]
          },
          "414110805": {
            "id": "414110805",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "出什么事了吗？",
            "nextDialogs": [
              "414110806"
            ]
          },
          "414110806": {
            "id": "414110806",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "我、我收到一封信，上面…上面…",
            "nextDialogs": [
              "414110807"
            ]
          },
          "414110807": {
            "id": "414110807",
            "speakerId": 1007,
            "speakerName": "班尼特",
            "text": "我来说吧。我刚从野外回来，惯例来教堂请修女们帮忙包扎，却看到芭芭拉小姐脸色发白地跑出来，手里举着一封信。",
            "nextDialogs": [
              "414110808"
            ]
          },
          "414110808": {
            "id": "414110808",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "我还是第一次收到这样的信件…",
            "nextDialogs": [
              "414110809"
            ]
          },
          "414110809": {
            "id": "414110809",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "可以给我看一下吗？",
            "nextDialogs": [
              "414110810"
            ]
          },
          "414110810": {
            "id": "414110810",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "「致敬爱的芭芭拉小姐：偷走你最重要的东西埋在土里」…啊呀，难道说，这是一封恐吓信？",
            "nextDialogs": [
              "414110811"
            ]
          },
          "414110811": {
            "id": "414110811",
            "speakerId": 1007,
            "speakerName": "班尼特",
            "text": "可恶，是恶作剧吗？如果是恶作剧就算了，只怕、只怕…",
            "nextDialogs": [
              "414110812"
            ]
          },
          "414110812": {
            "id": "414110812",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "只怕…万一是真的…",
            "nextDialogs": [
              "414110813"
            ]
          },
          "414110813": {
            "id": "414110813",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "背面还画着地图，看起来像是在野外。",
            "nextDialogs": [
              "414110814"
            ]
          },
          "414110814": {
            "id": "414110814",
            "speakerId": 1007,
            "speakerName": "班尼特",
            "text": "偷走你最重要的东西…",
            "nextDialogs": [
              "414110815"
            ]
          },
          "414110815": {
            "id": "414110815",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "埋在土里…",
            "nextDialogs": [
              "414110816"
            ]
          },
          "414110816": {
            "id": "414110816",
            "speakerId": 1007,
            "speakerName": "班尼特",
            "text": "地图上这个地方，我一定去过，好眼熟。",
            "nextDialogs": [
              "414110817"
            ]
          },
          "414110817": {
            "id": "414110817",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "最重要的东西是什么？",
            "nextDialogs": [
              "414110818"
            ]
          },
          "414110818": {
            "id": "414110818",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "我现在脑子很乱，一下想不…啊！",
            "nextDialogs": [
              "414110819"
            ]
          },
          "414110819": {
            "id": "414110819",
            "speakerId": 1007,
            "speakerName": "班尼特",
            "text": "我马上就能想起来…马上就能想起来…",
            "nextDialogs": [
              "414110820"
            ]
          },
          "414110820": {
            "id": "414110820",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "最重要的东西，等等，难道说！",
            "nextDialogs": [
              "414110821"
            ]
          },
          "414110821": {
            "id": "414110821",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "芭芭拉！哎，等等！",
            "nextDialogs": [
              "414110822"
            ]
          },
          "414110822": {
            "id": "414110822",
            "speakerId": 1007,
            "speakerName": "班尼特",
            "text": "啊！我想起来了，是千风神殿！",
            "nextDialogs": [
              "414110823"
            ]
          },
          "414110823": {
            "id": "414110823",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "喂，班尼特！",
            "nextDialogs": [
              "414110824"
            ]
          },
          "414110824": {
            "id": "414110824",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么就跑了呀？我们也快跟上去！"
          }
        }
      }
    },
    {
      "subId": "4141109",
      "subQuestName": "追上芭芭拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4141110",
      "subQuestName": "与芭芭拉和罗莎莉亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414111001"
        ],
        "dialogs": {
          "414111001": {
            "id": "414111001",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "姐姐！",
            "nextDialogs": [
              "414111002"
            ]
          },
          "414111002": {
            "id": "414111002",
            "speakerId": 1009,
            "speakerName": "罗莎莉亚",
            "text": "站住。",
            "nextDialogs": [
              "414111003"
            ]
          },
          "414111003": {
            "id": "414111003",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "罗莎莉亚！我刚才…",
            "nextDialogs": [
              "414111004"
            ]
          },
          "414111004": {
            "id": "414111004",
            "speakerId": 1009,
            "speakerName": "罗莎莉亚",
            "text": "冷静下来！",
            "nextDialogs": [
              "414111005"
            ]
          },
          "414111005": {
            "id": "414111005",
            "speakerId": 1009,
            "speakerName": "罗莎莉亚",
            "text": "刚才我在街上遇到琴团长了，丽莎小姐也在她身边，不会有事的。",
            "nextDialogs": [
              "414111006"
            ]
          },
          "414111006": {
            "id": "414111006",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "啊！是、是这样吗？！",
            "nextDialogs": [
              "414111007"
            ]
          },
          "414111007": {
            "id": "414111007",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "呼！",
            "nextDialogs": [
              "414111008"
            ]
          },
          "414111008": {
            "id": "414111008",
            "speakerId": 1009,
            "speakerName": "罗莎莉亚",
            "text": "……",
            "nextDialogs": [
              "414111009"
            ]
          },
          "414111009": {
            "id": "414111009",
            "speakerId": 1009,
            "speakerName": "罗莎莉亚",
            "text": "那封信，给我看看。",
            "nextDialogs": [
              "414111010"
            ]
          },
          "414111010": {
            "id": "414111010",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "好的~",
            "nextDialogs": [
              "414111011"
            ]
          },
          "414111011": {
            "id": "414111011",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "如果不是琴团长…那这封信上说的究竟是什么呢？",
            "nextDialogs": [
              "414111012"
            ]
          },
          "414111012": {
            "id": "414111012",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你居然认为琴团长会被埋进土里，这个想法才吓人吧！",
            "nextDialogs": [
              "414111013"
            ]
          },
          "414111013": {
            "id": "414111013",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "修女小姐，有什么线索吗？",
            "nextDialogs": [
              "414111014"
            ]
          },
          "414111014": {
            "id": "414111014",
            "speakerId": 1009,
            "speakerName": "罗莎莉亚",
            "text": "看这张地图，犯人画的应该是晨曦酒庄附近。",
            "nextDialogs": [
              "414111015"
            ]
          },
          "414111015": {
            "id": "414111015",
            "speakerId": 1009,
            "speakerName": "罗莎莉亚",
            "text": "那里的地形相对开阔，把东西藏在那里…哼，会是什么呢？",
            "nextDialogs": [
              "414111016"
            ]
          },
          "414111016": {
            "id": "414111016",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好厉害，一眼就能看出来…",
            "nextDialogs": [
              "414111017"
            ]
          },
          "414111017": {
            "id": "414111017",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，晨曦酒庄？似乎和刚才听见的某个地名不太一样呢…",
            "nextDialogs": [
              "414111018"
            ]
          },
          "414111018": {
            "id": "414111018",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "……",
            "nextDialogs": [
              "414111019"
            ]
          },
          "414111019": {
            "id": "414111019",
            "speakerId": 1009,
            "speakerName": "罗莎莉亚",
            "text": "芭芭拉，与其在这里被想象折磨，不如直面问题。",
            "nextDialogs": [
              "414111020"
            ]
          },
          "414111020": {
            "id": "414111020",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "嗯，你说得对，我只是…",
            "nextDialogs": [
              "414111021"
            ]
          },
          "414111021": {
            "id": "414111021",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "哈哈，是在害怕吧？那我们陪你一起去，如何？",
            "nextDialogs": [
              "414111022"
            ]
          },
          "414111022": {
            "id": "414111022",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "哎？各位…",
            "nextDialogs": [
              "414111023"
            ]
          },
          "414111023": {
            "id": "414111023",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "这位修女小姐要同行吗？",
            "nextDialogs": [
              "414111024"
            ]
          },
          "414111024": {
            "id": "414111024",
            "speakerId": 1009,
            "speakerName": "罗莎莉亚",
            "text": "我就不必了。一看就知道，不是什么大事。",
            "nextDialogs": [
              "414111025"
            ]
          },
          "414111025": {
            "id": "414111025",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？她刚才说什么？",
            "nextDialogs": [
              "414111026"
            ]
          },
          "414111026": {
            "id": "414111026",
            "speakerId": 1009,
            "speakerName": "罗莎莉亚",
            "text": "没什么。你们去吧。",
            "nextDialogs": [
              "414111027"
            ]
          },
          "414111027": {
            "id": "414111027",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "芭芭拉小姐，你好点了吗？",
            "nextDialogs": [
              "414111028"
            ]
          },
          "414111028": {
            "id": "414111028",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "嗯！我、我没事的。",
            "nextDialogs": [
              "414111029"
            ]
          },
          "414111029": {
            "id": "414111029",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "罗莎莉亚说得对，与其自己吓自己，不如直接去领教犯人的手段。",
            "nextDialogs": [
              "414111030"
            ]
          },
          "414111030": {
            "id": "414111030",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没错没错，我们几个一起去！",
            "nextDialogs": [
              "414111031"
            ]
          },
          "414111031": {
            "id": "414111031",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "谢谢各位，那我们现在就去地图指向的地方看看吧。",
            "nextDialogs": [
              "414111032"
            ]
          },
          "414111032": {
            "id": "414111032",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好，芭芭拉冲呀——！"
          }
        }
      }

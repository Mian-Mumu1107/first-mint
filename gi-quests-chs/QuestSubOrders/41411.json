    {
      "subId": "4141113",
      "subQuestName": "与芭芭拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "414111302"
        ],
        "dialogs": {
          "414111302": {
            "id": "414111302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这是什么，快打开看看！",
            "nextDialogs": [
              "414111303"
            ]
          },
          "414111303": {
            "id": "414111303",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "我、我…",
            "nextDialogs": [
              "414111304"
            ]
          },
          "414111304": {
            "id": "414111304",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "这么精致的礼盒，却出现在这种荒郊野岭，好有意思。",
            "nextDialogs": [
              "414111305"
            ]
          },
          "414111305": {
            "id": "414111305",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "……咦？！",
            "nextDialogs": [
              "414111306"
            ]
          },
          "414111306": {
            "id": "414111306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，好精致的风车菊花环，还有很多纸星星！",
            "nextDialogs": [
              "414111309"
            ]
          },
          "414111309": {
            "id": "414111309",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "所谓的「犯人」好像是芭芭拉小姐的粉丝呢。",
            "nextDialogs": [
              "414111310"
            ]
          },
          "414111310": {
            "id": "414111310",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "还有张字条，写了什么呢？我看看…唔…",
            "nextDialogs": [
              "414111311"
            ]
          },
          "414111311": {
            "id": "414111311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「很抱歉用这样的方式吸引您，为您的美德与可爱献上饱含诚意的风之花。」",
            "nextDialogs": [
              "414111312"
            ]
          },
          "414111312": {
            "id": "414111312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哈？以恐吓为手段的骗局？",
            "nextDialogs": [
              "414111313"
            ]
          },
          "414111313": {
            "id": "414111313",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "无论是对神明还是对重要、挚爱之人，都要以最饱满的情感献上鲜花。这才是如今风花节的核心仪式。",
            "nextDialogs": [
              "414111314"
            ]
          },
          "414111314": {
            "id": "414111314",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "为了在特殊的节日里向你送出爱与祝福之花，不惜选择引人瞩目的手段。",
            "nextDialogs": [
              "414111315"
            ]
          },
          "414111315": {
            "id": "414111315",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "看似吓人，背后却是精心准备的礼物。",
            "nextDialogs": [
              "414111316"
            ]
          },
          "414111316": {
            "id": "414111316",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜，真离谱…怎么听都是个没分寸的家伙…",
            "nextDialogs": [
              "414111317"
            ]
          },
          "414111317": {
            "id": "414111317",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "哈哈哈，确实。这样的人选，我心中似乎有一个哦？",
            "nextDialogs": [
              "414111318"
            ]
          },
          "414111318": {
            "id": "414111318",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你说的是谁呀？",
            "nextDialogs": [
              "414111319"
            ]
          },
          "414111319": {
            "id": "414111319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（我好像也想到了呢。）",
            "nextDialogs": [
              "414111320"
            ]
          },
          "414111320": {
            "id": "414111320",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "嘘…不要说出来，让小派蒙猜一会儿。",
            "nextDialogs": [
              "414111321"
            ]
          },
          "414111321": {
            "id": "414111321",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊！怎么这样啊——！"
          }
        }
      }
    },

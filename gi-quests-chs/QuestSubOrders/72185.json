  "subQuests": [
    {
      "subId": "7218501",
      "subQuestName": "与木南杏奈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721850101"
        ],
        "dialogs": {
          "721850101": {
            "id": "721850101",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "唉，这可怎么办呢…",
            "nextDialogs": [
              "721850102"
            ]
          },
          "721850102": {
            "id": "721850102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "721850103"
            ]
          },
          "721850103": {
            "id": "721850103",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "旅行者？太好了，你来得正好！",
            "nextDialogs": [
              "721850104"
            ]
          },
          "721850104": {
            "id": "721850104",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "你还记得上次，你和神里小姐来我店里的时候，你写给我的那道食谱吗？",
            "nextDialogs": [
              "721850105"
            ]
          },
          "721850105": {
            "id": "721850105",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "哎呀，那道披萨可受欢迎了，好多客人都专门来店里点那道披萨吃呢。",
            "nextDialogs": [
              "721850106"
            ]
          },
          "721850106": {
            "id": "721850106",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "但是…有些客人也说，总是吃这一种披萨感觉有点腻了，问我有没有其他味道的披萨。",
            "nextDialogs": [
              "721850107"
            ]
          },
          "721850107": {
            "id": "721850107",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "虽然我自己也根据客人们的反馈尝试过几种新做法…",
            "nextDialogs": [
              "721850108"
            ]
          },
          "721850108": {
            "id": "721850108",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "但总觉得…差那么点味道，客人们的反响也不太好。",
            "nextDialogs": [
              "721850109"
            ]
          },
          "721850109": {
            "id": "721850109",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "唉，也许我真的不太会做「披萨」这种菜吧…",
            "nextDialogs": [
              "721850110"
            ]
          },
          "721850110": {
            "id": "721850110",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "旅行者，你应该很懂这种菜吧？你能帮我再拿拿主意吗？",
            "nextDialogs": [
              "721850112",
              "721850114"
            ]
          },
          "721850112": {
            "id": "721850112",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "太好了！对了，我也搜集了客人们的反馈，我找一下，你稍等。",
            "nextDialogs": [
              "721850116"
            ]
          },
          "721850116": {
            "id": "721850116",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "这位松本小姐说，虽然我店里的这道披萨融合了很多稻妻的食材，但她听说，蒙德的披萨不是这么做的。",
            "nextDialogs": [
              "721850117"
            ]
          },
          "721850117": {
            "id": "721850117",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "她说，这种异国的食物，最好还是保持着异国的特色比较好…",
            "nextDialogs": [
              "721850118"
            ]
          },
          "721850118": {
            "id": "721850118",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "唉，但我怎么知道蒙德的披萨做法呢…旅行者，你就先去问问她吧。"
          },
          "721850114": {
            "id": "721850114",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "你想看看客人们的反馈吗？",
            "nextDialogs": [
              "721850115"
            ]
          },
          "721850115": {
            "id": "721850115",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "我找一下，你稍等。"
          }
        }
      }
    },
    {
      "subId": "7218502",
      "subQuestName": "与松本对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721850201"
        ],
        "dialogs": {
          "721850201": {
            "id": "721850201",
            "speakerId": 1001,
            "speakerName": "松本",
            "text": "唉，这个世界上还有能满足我味蕾的新奇菜肴吗？",
            "nextDialogs": [
              "721850202"
            ]
          },
          "721850202": {
            "id": "721850202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「木南料亭」的披萨…",
            "nextDialogs": [
              "721850203"
            ]
          },
          "721850203": {
            "id": "721850203",
            "speakerId": 1001,
            "speakerName": "松本",
            "text": "你说那个披萨啊，味道确实不错，还融合了不少本地的食材。",
            "nextDialogs": [
              "721850204"
            ]
          },
          "721850204": {
            "id": "721850204",
            "speakerId": 1001,
            "speakerName": "松本",
            "text": "不过，我之前也尝过正宗的「烤蘑菇披萨」。",
            "nextDialogs": [
              "721850205"
            ]
          },
          "721850205": {
            "id": "721850205",
            "speakerId": 1001,
            "speakerName": "松本",
            "text": "我记得，那种披萨是由奶酪，卷心菜和蘑菇做成的来着…",
            "nextDialogs": [
              "721850206"
            ]
          },
          "721850206": {
            "id": "721850206",
            "speakerId": 1001,
            "speakerName": "松本",
            "text": "哈哈哈，我个人是觉得，这种异国的食物，最好还是保持着异国的特色比较好啦。"
          }
        }
      }
    },
    {
      "subId": "7218503",
      "subQuestName": "向木南杏奈回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721850301"
        ],
        "dialogs": {
          "721850301": {
            "id": "721850301",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "旅行者，你回来了。",
            "nextDialogs": [
              "721850302"
            ]
          },
          "721850302": {
            "id": "721850302",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "怎么样，你有问到什么吗？",
            "nextDialogs": [
              "721850303"
            ]
          },
          "721850303": {
            "id": "721850303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于客人们的反馈…",
            "nextDialogs": [
              "721850304"
            ]
          },
          "721850304": {
            "id": "721850304",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "原汁原味的「烤蘑菇披萨」啊…嗯，倒是可以试试看。",
            "nextDialogs": [
              "721850305"
            ]
          },
          "721850305": {
            "id": "721850305",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "要准备的材料是奶酪、卷心菜和蘑菇…",
            "nextDialogs": [
              "721850306"
            ]
          },
          "721850306": {
            "id": "721850306",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "其余的材料店里倒是有，可是这个奶酪，店里平时也没储备多少…",
            "nextDialogs": [
              "721850307"
            ]
          },
          "721850307": {
            "id": "721850307",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "旅行者，能请你帮我去拿一份奶酪来吗？",
            "nextDialogs": [
              "721850309",
              "721850311"
            ]
          },
          "721850309": {
            "id": "721850309",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "那就拜托你了，只要一份奶酪就好。"
          },
          "721850311": {
            "id": "721850311",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "也不能说完全不用，只能说用得很少。",
            "nextDialogs": [
              "721850312"
            ]
          },
          "721850312": {
            "id": "721850312",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "毕竟，店里的这些菜，也没几道要用到奶酪的，所以储备得很少…",
            "nextDialogs": [
              "721850313"
            ]
          },
          "721850313": {
            "id": "721850313",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "总之，就拜托你了旅行者，请帮我带一份奶酪回来吧。"
          }
        }
      }
    },
    {
      "subId": "7218504",
      "subQuestName": "将奶酪带回给木南杏奈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721850401"
        ],
        "dialogs": {
          "721850401": {
            "id": "721850401",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "你把食材带回来了吗？"
          }
        }
      }
    },
    {
      "subId": "7218505",
      "subQuestName": "与木南杏奈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721850501"
        ],
        "dialogs": {
          "721850501": {
            "id": "721850501",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "谢谢你，有这些食材就够了。",
            "nextDialogs": [
              "721850502"
            ]
          },
          "721850502": {
            "id": "721850502",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "原汁原味的蒙德「烤蘑菇披萨」，不知道能不能顺利做出来…",
            "nextDialogs": [
              "721850503"
            ]
          },
          "721850503": {
            "id": "721850503",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "完成了！",
            "nextDialogs": [
              "721850504"
            ]
          },
          "721850504": {
            "id": "721850504",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "这披萨…看上去还不错…",
            "nextDialogs": [
              "721850505"
            ]
          },
          "721850505": {
            "id": "721850505",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "谢谢你帮忙，旅行者，这些东西请你收下吧。",
            "nextDialogs": [
              "721850506"
            ]
          },
          "721850506": {
            "id": "721850506",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "我等会就去仔细品尝一下这份披萨的味道…",
            "nextDialogs": [
              "721850507"
            ]
          },
          "721850507": {
            "id": "721850507",
            "speakerId": 1000,
            "speakerName": "木南杏奈",
            "text": "如果还不错的话…应该很快就能作为新品正式推出啦。"
          }
        }
      }
    },
    {
      "subId": "7218506",

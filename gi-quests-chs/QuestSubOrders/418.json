  "subQuests": [
    {
      "subId": "41801",
      "subQuestName": "发现丘丘圣山剑冢$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4180201"
        ],
        "dialogs": {
          "4180201": {
            "id": "4180201",
            "speakerId": 1000,
            "speakerName": "利文斯通博士",
            "text": "该怎么办呢…虽然明白了<color=#00E1FFFF>解除封印结界</color>的原理，但这么多魔物果然还是…",
            "nextDialogs": [
              "4180210"
            ]
          },
          "4180210": {
            "id": "4180210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么回事？",
            "nextDialogs": [
              "4180220"
            ]
          },
          "4180220": {
            "id": "4180220",
            "speakerId": 1000,
            "speakerName": "利文斯通博士",
            "text": "嗯？想得出神了，不好意思。我是利文斯通，是一个职业冒险家。",
            "nextDialogs": [
              "4180221"
            ]
          },
          "4180221": {
            "id": "4180221",
            "speakerId": 1000,
            "speakerName": "利文斯通博士",
            "text": "在这魔物丛生的凶险谷地中，竟然能见到魔物以外的身影，听见魔物的喧嚣以外的声音…",
            "nextDialogs": [
              "4180222"
            ]
          },
          "4180222": {
            "id": "4180222",
            "speakerId": 1000,
            "speakerName": "利文斯通博士",
            "text": "想必你也与我一样，是充满进取与探索精神的同行冒险家！",
            "nextDialogs": [
              "4180223"
            ]
          },
          "4180223": {
            "id": "4180223",
            "speakerId": 1000,
            "speakerName": "利文斯通博士",
            "text": "心里向着未知的星空，步履迈向幽暗的深渊，这就是我等冒险家的灵魂！",
            "nextDialogs": [
              "4180224"
            ]
          },
          "4180224": {
            "id": "4180224",
            "speakerId": 1000,
            "speakerName": "利文斯通博士",
            "text": "这里是古老的战场，幸存者运用元素之力，布设了<color=#00E1FFFF>三重封印结界</color>，让战友的剑冢不被魔物染指。",
            "nextDialogs": [
              "4180225"
            ]
          },
          "4180225": {
            "id": "4180225",
            "speakerId": 1000,
            "speakerName": "利文斯通博士",
            "text": "但是…怎么办呢…",
            "nextDialogs": [
              "4180226"
            ]
          },
          "4180226": {
            "id": "4180226",
            "speakerId": 1000,
            "speakerName": "利文斯通博士",
            "text": "…",
            "nextDialogs": [
              "4180227"
            ]
          },
          "4180227": {
            "id": "4180227",
            "speakerId": 1000,
            "speakerName": "利文斯通博士",
            "text": "唔？想得出神了，不好意思。刚刚说到哪来着？",
            "nextDialogs": [
              "4180240"
            ]
          },
          "4180240": {
            "id": "4180240",
            "speakerId": 1000,
            "speakerName": "利文斯通博士",
            "text": "唔？这些剑和…其中的<color=#00E1FFFF>宝物</color>，应该是当年的战士留下的遗物吧。怎么能让附近的<color=#00E1FFFF>三个丘丘人部落</color>染指呢！",
            "nextDialogs": [
              "4180241"
            ]
          },
          "4180241": {
            "id": "4180241",
            "speakerId": 1000,
            "speakerName": "利文斯通博士",
            "text": "我们不是丘丘人，所以称不上「染指」。我们是运用智慧，征服世界一切秘密的冒险家！",
            "nextDialogs": [
              "4180242"
            ]
          },
          "4180242": {
            "id": "4180242",
            "speakerId": 1000,
            "speakerName": "利文斯通博士",
            "text": "话虽如此，可是<color=#00E1FFFF>封印</color>…",
            "nextDialogs": [
              "4180243"
            ]
          },
          "4180243": {
            "id": "4180243",
            "speakerId": 1000,
            "speakerName": "利文斯通博士",
            "text": "怎么办呢…"
          }
        }
      }
    },

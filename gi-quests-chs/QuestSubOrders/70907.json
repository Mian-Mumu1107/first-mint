        "dialogs": {
          "709070101": {
            "id": "709070101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于不安的气息…",
            "nextDialogs": [
              "709070102"
            ]
          },
          "709070102": {
            "id": "709070102",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "无论是因为什么原因，我们能做的也就只有祈祷了。",
            "nextDialogs": [
              "709070103"
            ]
          },
          "709070103": {
            "id": "709070103",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "我最近托冒险家帮忙采集了一些塞西莉亚花，想要分发给大家…",
            "nextDialogs": [
              "709070104"
            ]
          },
          "709070104": {
            "id": "709070104",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "这种花生长在山崖之上，长期与蒙德的风为伴…",
            "nextDialogs": [
              "709070105"
            ]
          },
          "709070105": {
            "id": "709070105",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "…这散发着巴巴托斯大人气息的花朵，或许能为大家带来些许安心…",
            "nextDialogs": [
              "709070106"
            ]
          },
          "709070106": {
            "id": "709070106",
            "speakerId": 1000,
            "speakerName": "葛瑞丝",
            "text": "你也拿一些吧，愿巴巴托斯大人护佑蒙德。"
          }
        }
      }
    }
  ]

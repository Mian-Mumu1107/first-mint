  "subQuests": [
    {
      "subId": "7002401",
      "subQuestName": "前往冒险家协会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700240101"
        ],
        "dialogs": {
          "700240101": {
            "id": "700240101",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "旅行者，请您过来这边！",
            "nextDialogs": [
              "700240102"
            ]
          },
          "700240102": {
            "id": "700240102",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "抱歉占用您一些时间，请问您有兴趣接受一份新委托吗？",
            "nextDialogs": [
              "700240105"
            ]
          },
          "700240105": {
            "id": "700240105",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "是这样的。根据最近协会收到的报告，野外的丘丘人们又聚集了起来，侵扰商道。",
            "nextDialogs": [
              "700240106"
            ]
          },
          "700240106": {
            "id": "700240106",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "为此我们也派出了不少冒险家…",
            "nextDialogs": [
              "700240107"
            ]
          },
          "700240107": {
            "id": "700240107",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "但根据那些冒险家的说法，在集结起来的丘丘人里，他们总能发现一个奇怪的丘丘人…",
            "nextDialogs": [
              "700240108"
            ]
          },
          "700240108": {
            "id": "700240108",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "我们猜测，那个奇怪的丘丘人，或许会和这次丘丘人骚乱有关…",
            "nextDialogs": [
              "700240114"
            ]
          },
          "700240114": {
            "id": "700240114",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "所以，我们需要有人去捕获，或者至少驱赶那个奇怪的家伙。",
            "nextDialogs": [
              "700240109"
            ]
          },
          "700240109": {
            "id": "700240109",
            "speakerId": 1512,
            "speakerName": "凯瑟琳",
            "text": "旅行者，您有兴趣接受这份委托吗？"
          }
        }
      }
    },
    {
      "subId": "7002402",
      "subQuestName": "前去野外调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700240201"
        ],
        "dialogs": {
          "700240201": {
            "id": "700240201",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "呼…好险，幸好你们来了…",
            "nextDialogs": [
              "700240204"
            ]
          },
          "700240204": {
            "id": "700240204",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "唉…",
            "nextDialogs": [
              "700240205"
            ]
          },
          "700240205": {
            "id": "700240205",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "明明刚刚进展还很顺利的…究竟是哪句话说错了呢…",
            "nextDialogs": [
              "700240206"
            ]
          },
          "700240206": {
            "id": "700240206",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "不管怎样…感谢你们及时搭救…",
            "nextDialogs": [
              "700240207"
            ]
          },
          "700240207": {
            "id": "700240207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她看上去很消沉呢。",
            "nextDialogs": [
              "700240208"
            ]
          },
          "700240208": {
            "id": "700240208",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "毕竟刚刚发生的事你们也看到了。",
            "nextDialogs": [
              "700240223"
            ]
          },
          "700240223": {
            "id": "700240223",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "自己跑出来和丘丘人沟通，果然还是风险太大了…",
            "nextDialogs": [
              "700240209"
            ]
          },
          "700240209": {
            "id": "700240209",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "可是…与丘丘人正常交流的机会，就这样浪费的话还是很不甘心…"
          }
        }
      }
    },

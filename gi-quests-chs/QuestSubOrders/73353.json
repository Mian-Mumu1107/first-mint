  },
  "subQuests": [
    {
      "subId": "7335301",
      "subQuestName": "与陀罗诘利对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733530101"
        ],
        "dialogs": {
          "733530101": {
            "id": "733530101",
            "speakerId": 30651,
            "speakerName": "陀罗诘利",
            "text": "#打扰一下，请问是{NICKNAME}吗？",
            "nextDialogs": [
              "733530104"
            ]
          },
          "733530104": {
            "id": "733530104",
            "speakerId": 30651,
            "speakerName": "陀罗诘利",
            "text": "你好你好，幸好没有认错人。",
            "nextDialogs": [
              "733530105"
            ]
          },
          "733530105": {
            "id": "733530105",
            "speakerId": 30651,
            "speakerName": "陀罗诘利",
            "text": "自我介绍一下，我是生论派的陀裟多，名字是陀罗诘利。",
            "nextDialogs": [
              "733530106"
            ]
          },
          "733530106": {
            "id": "733530106",
            "speakerId": 30651,
            "speakerName": "陀罗诘利",
            "text": "之前虽然听说过您的事情，但我们其实并不了解您本人。",
            "nextDialogs": [
              "733530107"
            ]
          },
          "733530107": {
            "id": "733530107",
            "speakerId": 30651,
            "speakerName": "陀罗诘利",
            "text": "正好我们最近在做与梦境相关的研究，草神大人便告诉我们您在辨别梦与现实方面，比她见过的所有人都要冷静。",
            "nextDialogs": [
              "733530108"
            ]
          },
          "733530108": {
            "id": "733530108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "过奖过奖…",
            "nextDialogs": [
              "733530109"
            ]
          },
          "733530109": {
            "id": "733530109",
            "speakerId": 30651,
            "speakerName": "陀罗诘利",
            "text": "您太谦虚了，我们项目处理的就是梦与现实的问题，数据告诉我，入眠后能主动醒来是件很难的事。",
            "nextDialogs": [
              "733530110"
            ]
          },
          "733530110": {
            "id": "733530110",
            "speakerId": 30651,
            "speakerName": "陀罗诘利",
            "text": "我们的研究是利用梦境对人的心理影响，调节人们的各种心理障碍。",
            "nextDialogs": [
              "733530111"
            ]
          },
          "733530111": {
            "id": "733530111",
            "speakerId": 30651,
            "speakerName": "陀罗诘利",
            "text": "具体来说，我们会根据每个病人的情况，通过针对性的环境暗示与引导，塑造一个合适的梦境。",
            "nextDialogs": [
              "733530112"
            ]
          },
          "733530112": {
            "id": "733530112",
            "speakerId": 30651,
            "speakerName": "陀罗诘利",
            "text": "进入共同梦境的这部分技术还不成熟，中间依靠草神大人做了许多改进，简单来说我们的目标是在梦境中调整病人的认知，以改善心理问题。",
            "nextDialogs": [
              "733530113"
            ]
          },
          "733530113": {
            "id": "733530113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来好复杂。",
            "nextDialogs": [
              "733530114"
            ]
          },
          "733530114": {
            "id": "733530114",
            "speakerId": 30651,
            "speakerName": "陀罗诘利",
            "text": "啊，不好意思，说到自己项目的事就变得话多了起来，是有些复杂。",
            "nextDialogs": [
              "733530115"
            ]
          },
          "733530115": {
            "id": "733530115",
            "speakerId": 30651,
            "speakerName": "陀罗诘利",
            "text": "说白了，我们在做梦境影响心理的医学研究，比较糟的是，现在卡在了实践这一步…"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "1104201",
      "subQuestName": "前往研究场所",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110420101"
        ],
        "dialogs": {
          "110420101": {
            "id": "110420101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说起来，我有一个疑问，那个种子发芽以后会长出什么东西吗？",
            "nextDialogs": [
              "110420102"
            ]
          },
          "110420102": {
            "id": "110420102",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "不知道，但我觉得重点不在结果，而是过程。",
            "nextDialogs": [
              "110420103"
            ]
          },
          "110420103": {
            "id": "110420103",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "能够使用炼金术，在提瓦特唤醒不属于此世的生命的话，我对生命本质的理解，应该就能更进一步。",
            "nextDialogs": [
              "110420104"
            ]
          },
          "110420104": {
            "id": "110420104",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "唤醒之后，就算是创造，也并非不可能的事了。",
            "nextDialogs": [
              "110420105"
            ]
          },
          "110420105": {
            "id": "110420105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔唔…",
            "nextDialogs": [
              "110420106"
            ]
          },
          "110420106": {
            "id": "110420106",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "哈哈，对你来说还是太难懂了吗？",
            "nextDialogs": [
              "110420107"
            ]
          },
          "110420107": {
            "id": "110420107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不不不，我完全听懂了，我只是更关心这个种子发芽之后会长出什么！",
            "nextDialogs": [
              "110420110"
            ]
          },
          "110420110": {
            "id": "110420110",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "如果长出了非常美味的果实，我们就一起分享吧。",
            "nextDialogs": [
              "110420111"
            ]
          },
          "110420111": {
            "id": "110420111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好耶！说话要算话哦！"
          }
        }
      }
    },

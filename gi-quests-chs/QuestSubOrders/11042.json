    {
      "subId": "1104205",
      "subQuestName": "前往阿贝多的营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110420501"
        ],
        "dialogs": {
          "110420501": {
            "id": "110420501",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "这里就是我的营地，刚刚收集到的材料，我已经先一步用在药剂的调制上了。",
            "nextDialogs": [
              "110420502"
            ]
          },
          "110420502": {
            "id": "110420502",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "在等待调制完成的这段时间，先来这边看看吧。",
            "nextDialogs": [
              "110420503"
            ]
          },
          "110420503": {
            "id": "110420503",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "这位是我的助手，蒂玛乌斯，正在协助我的研究。你们应该在蒙德城里见过面。",
            "nextDialogs": [
              "110420504"
            ]
          },
          "110420504": {
            "id": "110420504",
            "speakerId": 1002,
            "speakerName": "蒂玛乌斯",
            "text": "你们好，我刚刚拿到了你们的实验数据，已经整理成报告贴在板子上了。",
            "nextDialogs": [
              "110420505"
            ]
          },
          "110420505": {
            "id": "110420505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，这个，还有这个…只是和史莱姆打了一场，就有这么多结论吗？",
            "nextDialogs": [
              "110420506"
            ]
          },
          "110420506": {
            "id": "110420506",
            "speakerId": 1002,
            "speakerName": "蒂玛乌斯",
            "text": "哈哈，说不上结论，很多都是推演，以及我的大胆猜测。",
            "nextDialogs": [
              "110420507"
            ]
          },
          "110420507": {
            "id": "110420507",
            "speakerId": 1002,
            "speakerName": "蒂玛乌斯",
            "text": "最合理的一种方向，我觉得是论证这位旅行者和史莱姆的亲缘关系。",
            "nextDialogs": [
              "110420510"
            ]
          },
          "110420510": {
            "id": "110420510",
            "speakerId": 1002,
            "speakerName": "蒂玛乌斯",
            "text": "你看，你没有神之眼，却可以使用元素力，史莱姆也没有神之眼，也可以使用元素力。",
            "nextDialogs": [
              "110420511"
            ]
          },
          "110420511": {
            "id": "110420511",
            "speakerId": 1002,
            "speakerName": "蒂玛乌斯",
            "text": "顺着这个思路去寻找线索，肯定能得到更多事实支撑！",
            "nextDialogs": [
              "110420512"
            ]
          },
          "110420512": {
            "id": "110420512",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "这个切入点没有什么问题，但是严格来说史莱姆是属于元素生物，换句话说，元素即实体。",
            "nextDialogs": [
              "110420513"
            ]
          },
          "110420513": {
            "id": "110420513",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "要类比的话，可能急冻树，或者骗骗花更加合适，但要追溯动植物之间的亲缘关系，恐怕要追溯到世界原初了。",
            "nextDialogs": [
              "110420514"
            ]
          },
          "110420514": {
            "id": "110420514",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "从这个角度来看，是不是过于困难了呢？",
            "nextDialogs": [
              "110420515"
            ]
          },
          "110420515": {
            "id": "110420515",
            "speakerId": 1002,
            "speakerName": "蒂玛乌斯",
            "text": "唔，好像是这样，老师说得没错。",
            "nextDialogs": [
              "110420516"
            ]
          },
          "110420516": {
            "id": "110420516",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "而且，其实数据的顶部写了，这位旅行者是来自其他世界的客人。",
            "nextDialogs": [
              "110420517"
            ]
          },
          "110420517": {
            "id": "110420517",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "如果和这个世界有亲缘关系，反而是更加值得研究的内容。",
            "nextDialogs": [
              "110420518"
            ]
          },
          "110420518": {
            "id": "110420518",
            "speakerId": 1002,
            "speakerName": "蒂玛乌斯",
            "text": "啊啊，真的！抱歉，我拿到数据太激动了！下次我一定注意！",
            "nextDialogs": [
              "110420519"
            ]
          },
          "110420519": {
            "id": "110420519",
            "speakerId": 1002,
            "speakerName": "蒂玛乌斯",
            "text": "对了，想要完成研究还需要更多数据，我暂时都会在这里做分析，如果想了解实验结果，都可以来找我。",
            "nextDialogs": [
              "110420520"
            ]
          },
          "110420520": {
            "id": "110420520",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "嗯，这里就交给你了。",
            "nextDialogs": [
              "110420521"
            ]
          },
          "110420521": {
            "id": "110420521",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "看起来药剂已经完成了，我会先尝一尝，如果没什么问题的话，就拜托你们了。"
          }
        }
      }
    },
    {
      "subId": "1104206",
      "subQuestName": "拿取桌上的药水",
      "sceneId": null,
      "locations": [],
      "dialogue": {

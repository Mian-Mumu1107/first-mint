    {
      "subId": "1104203",
      "subQuestName": "与阿贝多交谈，获取结论",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110420301"
        ],
        "dialogs": {
          "110420301": {
            "id": "110420301",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "辛苦了，你应该没有感觉到什么异常吧？",
            "nextDialogs": [
              "110420302"
            ]
          },
          "110420302": {
            "id": "110420302",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "如果受伤了的话，我这里有些应急用的药剂。",
            "nextDialogs": [
              "110420305"
            ]
          },
          "110420305": {
            "id": "110420305",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "那就好，根据我的观察，元素力对外流动顺畅，元素反应合理，没有观察到特别的状况。",
            "nextDialogs": [
              "110420306"
            ]
          },
          "110420306": {
            "id": "110420306",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "确定「对外流动」没问题之后，我们再来测试一下「内部流动」吧。",
            "nextDialogs": [
              "110420307"
            ]
          },
          "110420307": {
            "id": "110420307",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「内部流动」…要怎么做？",
            "nextDialogs": [
              "110420308"
            ]
          },
          "110420308": {
            "id": "110420308",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "很简单，我可以用炼金术制作一种萃取了元素力的药剂。",
            "nextDialogs": [
              "110420309"
            ]
          },
          "110420309": {
            "id": "110420309",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "如果元素力是以生理的方式储存或堆积在你的体内，或许会和这种药剂产生元素反应。"
          }
        }
      }
    },

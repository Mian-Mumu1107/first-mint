    {
      "subId": "1104207",
      "subQuestName": "与阿贝多交谈，获取结论",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110420701"
        ],
        "dialogs": {
          "110420701": {
            "id": "110420701",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#怎么样？{NICKNAME}，看你的表情有点不舒服。",
            "nextDialogs": [
              "110420704"
            ]
          },
          "110420704": {
            "id": "110420704",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你不是说你已经尝过，可以喝吗？为什么会变成这样？",
            "nextDialogs": [
              "110420705"
            ]
          },
          "110420705": {
            "id": "110420705",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "嗯？这个是所有可能性中最正常的一种，是值得高兴的结果。",
            "nextDialogs": [
              "110420706"
            ]
          },
          "110420706": {
            "id": "110420706",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "这种药剂，是将元素力灌入体内，正常状态下会引起一些排斥反应。",
            "nextDialogs": [
              "110420707"
            ]
          },
          "110420707": {
            "id": "110420707",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "但如果内部元素流动畅通的话，只需要忍受短暂的不适，等待元素力流动完毕就好了，不会有其他影响。",
            "nextDialogs": [
              "110420708"
            ]
          },
          "110420708": {
            "id": "110420708",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这么说，你明知道喝了会很难受，你还是把它喝了？",
            "nextDialogs": [
              "110420709"
            ]
          },
          "110420709": {
            "id": "110420709",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "呵呵，毕竟是我配制的药剂，自然应该由我担负起试药的责任。"
          }
        }
      }
    },
    {
      "subId": "1104206",

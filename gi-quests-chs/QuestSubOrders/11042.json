        ],
        "dialogs": {
          "110420801": {
            "id": "110420801",
            "speakerId": 1002,
            "speakerName": "蒂玛乌斯",
            "text": "从异世界到来的元素生物，一旦发现了有力的依据，恐怕会推翻很多现在的炼金术理论！",
            "nextDialogs": [
              "110420802"
            ]
          },
          "110420802": {
            "id": "110420802",
            "speakerId": 1002,
            "speakerName": "蒂玛乌斯",
            "text": "这样的话，老师的研究应该也可以更进一步了！"
          }
        }
      }
    },
    {
      "subId": "1104209",
      "subQuestName": "(test)沿路寻找「星银矿触媒」$HIDDEN",

        ],
        "dialogs": {
          "110420601": {
            "id": "110420601",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "我已经尝过了，很符合我的预期。",
            "nextDialogs": [
              "110420602"
            ]
          },
          "110420602": {
            "id": "110420602",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "记得喝的时候不要着急，如果有不适感，记得要深呼吸。",
            "nextDialogs": [
              "110420603"
            ]
          },
          "110420603": {
            "id": "110420603",
            "speakerId": 1001,
            "speakerName": "阿贝多",
            "text": "我会记录下所有观察到的结果与数据。"
          }
        }
      }

  "subQuests": [
    {
      "subId": "2005201",
      "subQuestName": "与安娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200520101"
        ],
        "dialogs": {
          "200520101": {
            "id": "200520101",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "好…今天也要努力完成委托！",
            "nextDialogs": [
              "200520103",
              "200520107"
            ]
          },
          "200520103": {
            "id": "200520103",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "那是当然了，做冒险家可是很有趣的。",
            "nextDialogs": [
              "200520104"
            ]
          },
          "200520104": {
            "id": "200520104",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "不过…嘿嘿，我执行委托的时候，还是有很多事不熟悉。",
            "nextDialogs": [
              "200520105"
            ]
          },
          "200520105": {
            "id": "200520105",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "旅行者，能请你再陪我去执行一下委托吗？我还有事想要请教你。",
            "nextDialogs": [
              "200520108"
            ]
          },
          "200520108": {
            "id": "200520108",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "那我们就快出发吧，今天的委托是…",
            "nextDialogs": [
              "200520109"
            ]
          },
          "200520109": {
            "id": "200520109",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "嗯…又是护送货运热气球…"
          },
          "200520107": {
            "id": "200520107",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "可以吗？嘿嘿，我正好有很多事想要请教你呢。"
          }
        }
      }
    },
    {
      "subId": "2005202",
      "subQuestName": "与安娜一同完成冒险家协会的委托",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200520201"
        ],
        "dialogs": {
          "200520201": {
            "id": "200520201",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "完成啦！谢谢你旅行者，这次的护送任务很顺利呢。",
            "nextDialogs": [
              "200520202"
            ]
          },
          "200520202": {
            "id": "200520202",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "不过，冒险家平时去执行的委托，都是这种事情吗？",
            "nextDialogs": [
              "200520204",
              "200520206"
            ]
          },
          "200520204": {
            "id": "200520204",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "你的语气也太无奈了…",
            "nextDialogs": [
              "200520207"
            ]
          },
          "200520207": {
            "id": "200520207",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "是这样吗…好嘞！那我要继续努力了！",
            "nextDialogs": [
              "200520208"
            ]
          },
          "200520208": {
            "id": "200520208",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "等我攒够了钱，就带着哥哥和爸爸妈妈一起出去旅行！",
            "nextDialogs": [
              "200520209"
            ]
          },
          "200520209": {
            "id": "200520209",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "哥哥他之前一直想出去旅行的，可是…因为我生病了，他必须留下来照顾我。",
            "nextDialogs": [
              "200520210"
            ]
          },
          "200520210": {
            "id": "200520210",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "现在我的病已经好了，也成为了冒险家。",
            "nextDialogs": [
              "200520211"
            ]
          },
          "200520211": {
            "id": "200520211",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "嘿嘿，是时候帮我哥哥完成一些梦想啦。"
          },
          "200520206": {
            "id": "200520206",
            "speakerId": 1405,
            "speakerName": "安娜",
            "text": "喂，你的表情不要这么疲惫啊…"
          }
        }
      }
    },
    {
      "subId": "2005203",
      "subQuestName": "与安娜一同完成冒险家协会的委托",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200520301"
        ],
        "dialogs": {
          "200520301": {
            "id": "200520301",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "旅行者，还请你多照顾一下安娜，这孩子最近好像兴奋过头了…",
            "nextDialogs": [
              "200520302"
            ]
          },
          "200520302": {
            "id": "200520302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不希望她做冒险家吗？",
            "nextDialogs": [
              "200520303"
            ]
          },
          "200520303": {
            "id": "200520303",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "……",
            "nextDialogs": [
              "200520304"
            ]
          },
          "200520304": {
            "id": "200520304",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "我尊重我妹妹的梦想。",
            "nextDialogs": [
              "200520305"
            ]
          },
          "200520305": {
            "id": "200520305",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "她的病好不容易痊愈了，也得到了追逐自己梦想的机会。",
            "nextDialogs": [
              "200520306"
            ]
          },
          "200520306": {
            "id": "200520306",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "作为她的哥哥，我…会全力支持她。",
            "nextDialogs": [
              "200520307"
            ]
          },
          "200520307": {
            "id": "200520307",
            "speakerId": 1408,
            "speakerName": "安东尼",
            "text": "就这样。"
          }
        }
      }
    },

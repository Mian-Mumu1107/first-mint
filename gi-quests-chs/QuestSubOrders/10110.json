    },
    {
      "subId": "1011007",
      "subQuestName": "(test)同时摧毁所有木桩$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100701"
        ],
        "dialogs": {
          "101100701": {
            "id": "101100701",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯，<color=#00E1FFFF>艾琳</color>如何？她这个年纪，想象力应该不至于完全消失了…"
          }
        }
      }
    },
    {
      "subId": "1011008",
      "subQuestName": "同时摧毁所有木桩",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1011009",
      "subQuestName": "与艾琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100901"
        ],
        "dialogs": {
          "101100901": {
            "id": "101100901",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "呼！谢谢你们，果然我还差得远呢。",
            "nextDialogs": [
              "101100902"
            ]
          },
          "101100902": {
            "id": "101100902",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "别客气嘛，艾琳也已经很厉害了。",
            "nextDialogs": [
              "101100903"
            ]
          },
          "101100903": {
            "id": "101100903",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "我还在为练习感到疲劳，这就是不成熟的证明。但总有一天我会征服蒙德所有的木桩…",
            "nextDialogs": [
              "101100904"
            ]
          },
          "101100904": {
            "id": "101100904",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "加油，你一定可以做到的！",
            "nextDialogs": [
              "101100905"
            ]
          },
          "101100905": {
            "id": "101100905",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "谢谢…啊，糟了，专注练习，忘了本来要做的事！",
            "nextDialogs": [
              "101100906"
            ]
          },
          "101100906": {
            "id": "101100906",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "呜…可我已经累得动不了了…",
            "nextDialogs": [
              "101100907"
            ]
          },
          "101100907": {
            "id": "101100907",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "荣誉骑士，能不能帮我带个口信给杰克？",
            "nextDialogs": [
              "101100909",
              "101100914"
            ]
          },
          "101100909": {
            "id": "101100909",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "杰克是我的朋友，一位新人冒险家。",
            "nextDialogs": [
              "101100910"
            ]
          },
          "101100910": {
            "id": "101100910",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "原本我们约好，今晚一起讨论冒险计划…能麻烦你转告他改天见吗？",
            "nextDialogs": [
              "101100911"
            ]
          },
          "101100911": {
            "id": "101100911",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "我想，他今天应该是在<color=#00E1FFFF>「南风之狮的庙宇」</color>冒险吧，跟斯坦利先生一起。",
            "nextDialogs": [
              "101100912"
            ]
          },
          "101100912": {
            "id": "101100912",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "那是一位名震蒙德、曾经抵达「烬寂海」的传说级大冒险家。",
            "nextDialogs": [
              "101100917"
            ]
          },
          "101100917": {
            "id": "101100917",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很久没去那里了，我也想再去看看。",
            "nextDialogs": [
              "101100918"
            ]
          },
          "101100918": {
            "id": "101100918",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "啊，那真是太谢谢你了！"
          },
          "101100914": {
            "id": "101100914",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "杰克今天跟斯坦利先生一起去<color=#00E1FFFF>「南风之狮的庙宇」</color>冒险了。",
            "nextDialogs": [
              "101100915"
            ]
          },
          "101100915": {
            "id": "101100915",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "那是一位名震蒙德、曾经抵达「烬寂海」的传说级大冒险家。",
            "nextDialogs": [
              "101100916"
            ]
          },
          "101100916": {
            "id": "101100916",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "原本我们约好，今晚一起讨论冒险计划…能麻烦你转告他改天见吗？"
          }
        }
      }
    }
  ]
}
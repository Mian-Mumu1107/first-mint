  "subQuests": [
    {
      "subId": "1011001",
      "subQuestName": "前往神像广场某处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100101"
        ],
        "dialogs": {
          "101100101": {
            "id": "101100101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，看那边看那边！",
            "nextDialogs": [
              "101100102"
            ]
          },
          "101100102": {
            "id": "101100102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "她、她是一个人站着的吧？",
            "nextDialogs": [
              "101100103"
            ]
          },
          "101100103": {
            "id": "101100103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可她明明在跟别人说话啊！你看、你看她还笑了！呜呜呜，好吓人…",
            "nextDialogs": [
              "101100104"
            ]
          },
          "101100104": {
            "id": "101100104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我小时候也会和「幻想朋友」玩。",
            "nextDialogs": [
              "101100105"
            ]
          },
          "101100105": {
            "id": "101100105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#呜哇？{NICKNAME}，你以前也会做这种事吗？！",
            "nextDialogs": [
              "101100106"
            ]
          },
          "101100106": {
            "id": "101100106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难道是出现了幻觉？还是说，真的有那种看不见的朋友在陪你玩？",
            "nextDialogs": [
              "101100108",
              "101100110"
            ]
          },
          "101100108": {
            "id": "101100108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "幻想朋友…",
            "nextDialogs": [
              "101100111"
            ]
          },
          "101100111": {
            "id": "101100111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦，那就是…「想象出来的朋友」啦？",
            "nextDialogs": [
              "101100112"
            ]
          },
          "101100112": {
            "id": "101100112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你的「幻想朋友」长什么样子，给我看看！"
          },
          "101100110": {
            "id": "101100110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "幻觉…"
          }
        }
      }
    },
    {
      "subId": "1011002",
      "subQuestName": "看看芙萝拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100203"
        ],
        "dialogs": {
          "101100203": {
            "id": "101100203",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "你看，那就是她的幻想朋友。嗯，一株轻飘飘的植物…是蓬蓬果。",
            "nextDialogs": [
              "101100204"
            ]
          },
          "101100204": {
            "id": "101100204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "幻想朋友也可以是植物吗！",
            "nextDialogs": [
              "101100205"
            ]
          },
          "101100205": {
            "id": "101100205",
            "speakerId": 1002,
            "speakerName": "芙萝拉",
            "text": "呼呼，旅行者，诗人，你们好。",
            "nextDialogs": [
              "101100208"
            ]
          },
          "101100208": {
            "id": "101100208",
            "speakerId": 1002,
            "speakerName": "芙萝拉",
            "text": "好啊，找芙萝拉有什么事呢？"
          }
        }
      }
    },
    {
      "subId": "1011003",
      "subQuestName": "看看提米",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100304"
        ],
        "dialogs": {
          "101100304": {
            "id": "101100304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "什、什么！",
            "nextDialogs": [
              "101100305"
            ]
          },
          "101100305": {
            "id": "101100305",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哦？真叫人意外。",
            "nextDialogs": [
              "101100306"
            ]
          },
          "101100306": {
            "id": "101100306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这孩子的幻想朋友，竟然是遗迹守卫？！",
            "nextDialogs": [
              "101100309"
            ]
          },
          "101100309": {
            "id": "101100309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜呜…好可怕，会被攻击吗…",
            "nextDialogs": [
              "101100310"
            ]
          },
          "101100310": {
            "id": "101100310",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哈哈，要放弃和提米小朋友的交流吗？"
          }
        }
      }
    },
    {
      "subId": "1011004",
      "subQuestName": "看看酒馆的成年人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100404"
        ],
        "dialogs": {
          "101100404": {
            "id": "101100404",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "酒这东西，果然还是要在酒馆喝才有气氛。",
            "nextDialogs": [
              "101100405"
            ]
          },
          "101100405": {
            "id": "101100405",
            "speakerId": 1004,
            "speakerName": "迪卢克",
            "text": "我看你一个人也可以喝得很开心。",
            "nextDialogs": [
              "101100406"
            ]
          },
          "101100406": {
            "id": "101100406",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "哈哈，别说这么不近人情的话嘛。",
            "nextDialogs": [
              "101100407"
            ]
          },
          "101100407": {
            "id": "101100407",
            "speakerId": 1004,
            "speakerName": "迪卢克",
            "text": "你最好别在这里喝醉。",
            "nextDialogs": [
              "101100408"
            ]
          },
          "101100408": {
            "id": "101100408",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "嗯？难道说，喝醉会被卖给垃圾站？",
            "nextDialogs": [
              "101100409"
            ]
          },
          "101100409": {
            "id": "101100409",
            "speakerId": 1004,
            "speakerName": "迪卢克",
            "text": "卖？",
            "nextDialogs": [
              "101100410"
            ]
          },
          "101100410": {
            "id": "101100410",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "你不是常卖东西吗？父亲的旧宅也是你卖掉的。",
            "nextDialogs": [
              "101100411"
            ]
          },
          "101100411": {
            "id": "101100411",
            "speakerId": 1004,
            "speakerName": "迪卢克",
            "text": "哼…没用的东西，留着干什么？",
            "nextDialogs": [
              "101100412"
            ]
          },
          "101100412": {
            "id": "101100412",
            "speakerId": 1003,
            "speakerName": "凯亚",
            "text": "那么，花瓶也卖了？",
            "nextDialogs": [
              "101100413"
            ]
          },
          "101100413": {
            "id": "101100413",
            "speakerId": 1004,
            "speakerName": "迪卢克",
            "text": "我没印象了。",
            "nextDialogs": [
              "101100414"
            ]
          },
          "101100414": {
            "id": "101100414",
            "speakerId": 1005,
            "speakerName": "冒失的帕拉德",
            "text": "可是迪卢克老爷家里，好像确实摆着一个华丽的花瓶…",
            "nextDialogs": [
              "101100415"
            ]
          },
          "101100415": {
            "id": "101100415",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "和你说的一样，大人们都没有幻想朋友呢…",
            "nextDialogs": [
              "101100416"
            ]
          },
          "101100416": {
            "id": "101100416",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "果然是因为缺乏童心吗？",
            "nextDialogs": [
              "101100417"
            ]
          },
          "101100417": {
            "id": "101100417",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来每个地方的大人都差不多。",
            "nextDialogs": [
              "101100418"
            ]
          },
          "101100418": {
            "id": "101100418",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "长大就会变成没有梦想的人吗…那我不要长大…",
            "nextDialogs": [
              "101100419"
            ]
          },
          "101100419": {
            "id": "101100419",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这么说来，少年少女的幻想朋友，一般能维持到几岁呢？",
            "nextDialogs": [
              "101100420"
            ]
          },
          "101100420": {
            "id": "101100420",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我们…去验证一下吧。"
          }
        }
      }
    },
    {
      "subId": "1011005",
      "subQuestName": "看看艾琳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101100703"
        ],
        "dialogs": {
          "101100703": {
            "id": "101100703",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是琴团长！她怎么会在这儿？",
            "nextDialogs": [
              "101100704"
            ]
          },
          "101100704": {
            "id": "101100704",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难道说，艾琳的幻想朋友是琴团长？",
            "nextDialogs": [
              "101100706",
              "101100708"
            ]
          },
          "101100706": {
            "id": "101100706",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "努力成为骑士…的方向，有些奇怪呢。",
            "nextDialogs": [
              "101100709"
            ]
          },
          "101100709": {
            "id": "101100709",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "嗯？你们好呀，有什么事吗？",
            "nextDialogs": [
              "101100710"
            ]
          },
          "101100710": {
            "id": "101100710",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你一直在这里练剑吗？",
            "nextDialogs": [
              "101100711"
            ]
          },
          "101100711": {
            "id": "101100711",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "是啊，今天听斯坦利先生说了他的冒险经历，太精彩了！听得我心潮澎湃。",
            "nextDialogs": [
              "101100712"
            ]
          },
          "101100712": {
            "id": "101100712",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "我希望自己有朝一日，也能成为斯坦利先生那样优秀的人。",
            "nextDialogs": [
              "101100713"
            ]
          },
          "101100713": {
            "id": "101100713",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "是为了跟琴团长并肩作战吗？",
            "nextDialogs": [
              "101100714"
            ]
          },
          "101100714": {
            "id": "101100714",
            "speakerId": 1006,
            "speakerName": "艾琳",
            "text": "我、我当然是想成为骑士的啦！要是能跟琴团长一起去冒险…就更好了。",
            "nextDialogs": [
              "101100715"
            ]
          },
          "101100715": {
            "id": "101100715",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "艾琳真的很仰慕琴团长呢。"
          },
          "101100708": {
            "id": "101100708",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是啊，好认真的人！我、我都吓到了…"
          }
        }
      }
    },
    {

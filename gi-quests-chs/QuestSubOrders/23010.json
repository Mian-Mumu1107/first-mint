  "subQuests": [
    {
      "subId": "2301001",
      "subQuestName": "与贾法尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230100101"
        ],
        "dialogs": {
          "230100101": {
            "id": "230100101",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "朋友，你看起来很匆忙，有什么在让你忧心？",
            "nextDialogs": [
              "230100103",
              "230100106"
            ]
          },
          "230100103": {
            "id": "230100103",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "喔…我发现你的神情很疲惫，但动作还是匆忙无比。",
            "nextDialogs": [
              "230100104"
            ]
          },
          "230100104": {
            "id": "230100104",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "你准是在为某个问题而忧心忡忡，但这个问题你又不得不尽快找到解决方案。",
            "nextDialogs": [
              "230100109"
            ]
          },
          "230100109": {
            "id": "230100109",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "如果你愿意被我耽误一会的话，我希望你能坐下来，和我一同品尝一道美食。",
            "nextDialogs": [
              "230100110"
            ]
          },
          "230100110": {
            "id": "230100110",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "四处奔波固然是人生常态…但我们常说，奔涌向前的汹涌河水，偶尔也会沉默地淌过寂静的小溪。",
            "nextDialogs": [
              "230100111"
            ]
          },
          "230100111": {
            "id": "230100111",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "再如何奔忙，总要留给自己一点时间来休憩。",
            "nextDialogs": [
              "230100112"
            ]
          },
          "230100112": {
            "id": "230100112",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "让我想想…",
            "nextDialogs": [
              "230100113"
            ]
          },
          "230100113": {
            "id": "230100113",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "不如我们一同来品尝一道「薄荷豆汤」吧。",
            "nextDialogs": [
              "230100114"
            ]
          },
          "230100114": {
            "id": "230100114",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "你无需付给我摩拉，只需要为我找到一株薄荷就好。",
            "nextDialogs": [
              "230100115"
            ]
          },
          "230100115": {
            "id": "230100115",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "喔，对了，找薄荷的时候，记得不要太挑剔。",
            "nextDialogs": [
              "230100116"
            ]
          },
          "230100116": {
            "id": "230100116",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "记住，你只是在寻找一株普通的薄荷，不是在寻找任何问题。"
          },
          "230100106": {
            "id": "230100106",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "喔，那样就最好。",
            "nextDialogs": [
              "230100107"
            ]
          },
          "230100107": {
            "id": "230100107",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "但你的脚步如此匆忙，想必是正在为解决某个问题而奔走。",
            "nextDialogs": [
              "230100108"
            ]
          },
          "230100108": {
            "id": "230100108",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "唔，虽然我不知道你要处理什么问题，但我有一个建议…"
          }
        }
      }
    },
    {
      "subId": "2301002",
      "subQuestName": "将食材交给贾法尔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230100201"
        ],
        "dialogs": {
          "230100201": {
            "id": "230100201",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "请你为我找<color=#00E1FFFF>一株薄荷</color>回来吧。"
          }
        }
      }
    },
    {
      "subId": "2301003",
      "subQuestName": "与贾法尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230100301"
        ],
        "dialogs": {
          "230100301": {
            "id": "230100301",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "非常不错的薄荷。请稍等。",
            "nextDialogs": [
              "230100303"
            ]
          },
          "230100303": {
            "id": "230100303",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "这是用你带来的食材制作出的「薄荷豆汤」，请尝尝吧。",
            "nextDialogs": [
              "230100304"
            ]
          },
          "230100304": {
            "id": "230100304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢。",
            "nextDialogs": [
              "230100305"
            ]
          },
          "230100305": {
            "id": "230100305",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "不用客气。专心享受这道美味吧。",
            "nextDialogs": [
              "230100306"
            ]
          },
          "230100306": {
            "id": "230100306",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "对我来说，在享受美食的时候，我会把那些让人疲倦的课题和研究统统抛在脑后…",
            "nextDialogs": [
              "230100307"
            ]
          },
          "230100307": {
            "id": "230100307",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "就这么任我的思维沉默地流淌过那道寂静的小溪…这就是我的休憩方法。",
            "nextDialogs": [
              "230100308"
            ]
          },
          "230100308": {
            "id": "230100308",
            "speakerId": 4027,
            "speakerName": "贾法尔",
            "text": "好了，还请你细细品尝这道美味。希望你的思维也能从中得到休憩。"
          }
        }
      }
    },

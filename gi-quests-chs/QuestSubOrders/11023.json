      }
    },
    {
      "subId": "1102307",
      "subQuestName": "与钟离和宛烟交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110230701"
        ],
        "dialogs": {
          "110230701": {
            "id": "110230701",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "你的收获，也由我没收了。",
            "nextDialogs": [
              "110230702"
            ]
          },
          "110230702": {
            "id": "110230702",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "你没有继续前进的资格了，就这样离开吧。",
            "nextDialogs": [
              "110230703"
            ]
          },
          "110230703": {
            "id": "110230703",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "可恶…你给我等着！",
            "nextDialogs": [
              "110230704"
            ]
          },
          "110230704": {
            "id": "110230704",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "(test)（愚人众逃离）",
            "nextDialogs": [
              "110230705"
            ]
          },
          "110230705": {
            "id": "110230705",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "说是考古勘探，终于还是装不下去了呢。",
            "nextDialogs": [
              "110230707",
              "110230709"
            ]
          },
          "110230707": {
            "id": "110230707",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "就是，幸好我已经有敏锐的嗅觉了。",
            "nextDialogs": [
              "110230710"
            ]
          },
          "110230710": {
            "id": "110230710",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "克列门特的错误，在于贪欲。但在贪欲之外，也还有许多令人想要违背契约的诱惑。",
            "nextDialogs": [
              "110230711"
            ]
          },
          "110230711": {
            "id": "110230711",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "面对「渴望之物」，究竟有多少人能够克制欲望、遵循契约…",
            "nextDialogs": [
              "110230712"
            ]
          },
          "110230712": {
            "id": "110230712",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "不如，就趁这个机会讲清楚吧。",
            "nextDialogs": [
              "110230713"
            ]
          },
          "110230713": {
            "id": "110230713",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嗯？要讲什么？",
            "nextDialogs": [
              "110230714"
            ]
          },
          "110230714": {
            "id": "110230714",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "这一个临时的考古小队，其实没有人是来「考古」的。",
            "nextDialogs": [
              "110230715"
            ]
          },
          "110230715": {
            "id": "110230715",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "为、为什么这么说？",
            "nextDialogs": [
              "110230716"
            ]
          },
          "110230716": {
            "id": "110230716",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "这位女士，你缺乏最基本的考古常识，文物也不识几件，但在「盐之魔神」上的知识，又特别精通。",
            "nextDialogs": [
              "110230717"
            ]
          },
          "110230717": {
            "id": "110230717",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "比起考古与文物，还是「盐之魔神」本身，才更让你感兴趣吧。",
            "nextDialogs": [
              "110230718"
            ]
          },
          "110230718": {
            "id": "110230718",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "你在珠钿舫提到的那些关于盐之魔神的传说，据我所知，是在「银原厅」流传得最多…",
            "nextDialogs": [
              "110230719"
            ]
          },
          "110230719": {
            "id": "110230719",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "别、别再说了！",
            "nextDialogs": [
              "110230720"
            ]
          },
          "110230720": {
            "id": "110230720",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "…先生你果然博学多才，我鼓起勇气向你提问，看来是正确的选择。",
            "nextDialogs": [
              "110230721"
            ]
          },
          "110230721": {
            "id": "110230721",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "——没错，我不是什么考古学家。我来自璃月「七星八门」中的一门，主管盐业的「银原厅」。",
            "nextDialogs": [
              "110230722"
            ]
          },
          "110230722": {
            "id": "110230722",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "我们的祖辈，就是在魔神战争席卷大陆的苦难时期里，曾受「盐之魔神」庇护的子民。"
          },
          "110230709": {
            "id": "110230709",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "我喜欢摩拉，但我不干坏事！"
          }
        }
      }
    },

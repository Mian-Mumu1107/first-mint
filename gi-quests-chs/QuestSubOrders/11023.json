    {
      "subId": "1102310",
      "subQuestName": "追上宛烟",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110231001"
        ],
        "dialogs": {
          "110231001": {
            "id": "110231001",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这些「雕像」，是在…逃跑？"
          }
        }
      }
    },
    {
      "subId": "1102311",
      "subQuestName": "与宛烟交谈，见证真相",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110231101"
        ],
        "dialogs": {
          "110231101": {
            "id": "110231101",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "这里就是现场，赫乌莉亚形骸溃散，只留下些许盐迹。临终的画面，也定格于此。",
            "nextDialogs": [
              "110231102"
            ]
          },
          "110231102": {
            "id": "110231102",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "……",
            "nextDialogs": [
              "110231103"
            ]
          },
          "110231103": {
            "id": "110231103",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "故事的后续是：她的子民中，有人终于意识到，这位仁善却柔弱的魔神，在战争中保护不了任何人。",
            "nextDialogs": [
              "110231104"
            ]
          },
          "110231104": {
            "id": "110231104",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "魔神战争是很残酷的。与其让她经受战败后的折磨，不如，赐予她相对轻松的解脱。",
            "nextDialogs": [
              "110231105"
            ]
          },
          "110231105": {
            "id": "110231105",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "可是，这些「雕像」…又是怎么回事？",
            "nextDialogs": [
              "110231106"
            ]
          },
          "110231106": {
            "id": "110231106",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "再怎么弱小的魔神，死亡时流失的力量，也非凡人之躯所能承受。",
            "nextDialogs": [
              "110231107"
            ]
          },
          "110231107": {
            "id": "110231107",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "没能逃走的人，全都变成了这副模样。",
            "nextDialogs": [
              "110231108"
            ]
          },
          "110231108": {
            "id": "110231108",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "未经此灾的盐神子民离开了她的领地，前往璃月，请求岩王帝君的庇护。",
            "nextDialogs": [
              "110231109"
            ]
          },
          "110231109": {
            "id": "110231109",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "他们的后代害怕赫乌莉亚留下的魔神残渣，害怕她施予他们永世的诅咒…",
            "nextDialogs": [
              "110231110"
            ]
          },
          "110231110": {
            "id": "110231110",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "于是，他们冒着危险回到这里，将剑折断、供奉，希望能够平息她留下的怒火。",
            "nextDialogs": [
              "110231111"
            ]
          },
          "110231111": {
            "id": "110231111",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "但其实他们是多此一举了。这位直到最后都没有反抗过的魔神，又怎么会对自己的子民…心怀忿怒呢？",
            "nextDialogs": [
              "110231112"
            ]
          },
          "110231112": {
            "id": "110231112",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "我…我…就算是这样，我不接受…",
            "nextDialogs": [
              "110231113"
            ]
          },
          "110231113": {
            "id": "110231113",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "骗局…虚假的历史…一切…都…",
            "nextDialogs": [
              "110231114"
            ]
          },
          "110231114": {
            "id": "110231114",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "别想动摇…我的信仰…",
            "nextDialogs": [
              "110231115"
            ]
          },
          "110231115": {
            "id": "110231115",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "(test)（少女跑开）",
            "nextDialogs": [
              "110231116"
            ]
          },
          "110231116": {
            "id": "110231116",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这一次，钟离也真是不留情呢…",
            "nextDialogs": [
              "110231117"
            ]
          },
          "110231117": {
            "id": "110231117",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "这就是她要付出的代价了，但…这也并不失为一件好事。",
            "nextDialogs": [
              "110231118"
            ]
          },
          "110231118": {
            "id": "110231118",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "看她的模样，恐怕还会继续动摇一阵…不过，即使不能马上解脱，只是认清现实，也还不错。",
            "nextDialogs": [
              "110231120",
              "110231122"
            ]
          },
          "110231120": {
            "id": "110231120",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "嗯，在很久很久以前，赫乌莉亚的故事对我来说，也是一份告诫。",
            "nextDialogs": [
              "110231123"
            ]
          },
          "110231123": {
            "id": "110231123",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "信仰一位已经逝去的神，实在没有什么好处。",
            "nextDialogs": [
              "110231124"
            ]
          },
          "110231124": {
            "id": "110231124",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "…不论是对赫乌莉亚的信仰，还是对摩拉克斯的信仰，都是一样的。",
            "nextDialogs": [
              "110231125"
            ]
          },
          "110231125": {
            "id": "110231125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "璃月人总有一天也会明白的。",
            "nextDialogs": [
              "110231126"
            ]
          },
          "110231126": {
            "id": "110231126",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "好了。接下来，陪我去一趟「孤云阁」如何？",
            "nextDialogs": [
              "110231127"
            ]
          },
          "110231127": {
            "id": "110231127",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "嗯？钟离要做什么？",
            "nextDialogs": [
              "110231128"
            ]
          },
          "110231128": {
            "id": "110231128",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "唉…",
            "nextDialogs": [
              "110231129"
            ]
          },
          "110231129": {
            "id": "110231129",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "重游故地，又讲了这么多故事…",
            "nextDialogs": [
              "110231130"
            ]
          },
          "110231130": {
            "id": "110231130",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "难免对那些故人，心生怀念了。"
          },
          "110231122": {
            "id": "110231122",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "真是敏锐，不过…也只是因为我活得比较长而已。"
          }
        }
      }
    },
    {
      "subId": "1102310",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110231002"
        ],
        "dialogs": {
          "110231002": {
            "id": "110231002",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "前面究竟还有什么…",
            "nextDialogs": [
              "110231003"
            ]
          },
          "110231003": {
            "id": "110231003",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "是盐，还有背叛。"
          }
        }
      }
    }
  ]
}
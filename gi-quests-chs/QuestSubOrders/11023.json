    {
      "subId": "1102309",
      "subQuestName": "观察房间内的断剑",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110230901"
        ],
        "dialogs": {
          "110230901": {
            "id": "110230901",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "这是…剑吗？",
            "nextDialogs": [
              "110230902"
            ]
          },
          "110230902": {
            "id": "110230902",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "啊！是断裂的剑！这就是证据！证明「盐之魔神」曾经是反抗过的！只是没能抵挡摩拉克斯下的毒手！",
            "nextDialogs": [
              "110230903"
            ]
          },
          "110230903": {
            "id": "110230903",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "相比「盐盏」和「盐尺」，这「剑」的力量，一定是远远超越它们的！",
            "nextDialogs": [
              "110230904"
            ]
          },
          "110230904": {
            "id": "110230904",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "如果能修好这把剑，就能向其他人展示「盐之魔神」曾经的权能了…",
            "nextDialogs": [
              "110230905"
            ]
          },
          "110230905": {
            "id": "110230905",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "看起来…确实很像战败之后留下的东西。",
            "nextDialogs": [
              "110230906"
            ]
          },
          "110230906": {
            "id": "110230906",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "两段断剑，以考古角度来看，是两件文物。按照「顺次取物，每次一件」的契约，你只能带走其中之一。",
            "nextDialogs": [
              "110230907"
            ]
          },
          "110230907": {
            "id": "110230907",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "为、为什么？虽说是顺次取物，可是，克列门特已经…",
            "nextDialogs": [
              "110230908"
            ]
          },
          "110230908": {
            "id": "110230908",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "是的，但是「每次一件」仍然有效。想要同时取走两件文物，是不可以的。",
            "nextDialogs": [
              "110230909"
            ]
          },
          "110230909": {
            "id": "110230909",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "这、这…",
            "nextDialogs": [
              "110230910"
            ]
          },
          "110230910": {
            "id": "110230910",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "唔…钟离，她不是恶意，也没有争抢，是不是可以通融一下？",
            "nextDialogs": [
              "110230911"
            ]
          },
          "110230911": {
            "id": "110230911",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "「契约」不可通融，若不遵守，就是破坏。",
            "nextDialogs": [
              "110230912"
            ]
          },
          "110230912": {
            "id": "110230912",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "不行！如果只带走一半，那、那就没办法修好，也没办法重现「盐之魔神」的权能…",
            "nextDialogs": [
              "110230913"
            ]
          },
          "110230913": {
            "id": "110230913",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "无论如何，为了我对她的信仰…",
            "nextDialogs": [
              "110230914"
            ]
          },
          "110230914": {
            "id": "110230914",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "即使是破坏契约，我也在所不惜…",
            "nextDialogs": [
              "110230915"
            ]
          },
          "110230915": {
            "id": "110230915",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "你已经下定决心了吗？那么，这是有代价的。",
            "nextDialogs": [
              "110230916"
            ]
          },
          "110230916": {
            "id": "110230916",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "钟离！",
            "nextDialogs": [
              "110230917"
            ]
          },
          "110230917": {
            "id": "110230917",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "这就意味着，你要承受「食岩之罚」了。",
            "nextDialogs": [
              "110230918"
            ]
          },
          "110230918": {
            "id": "110230918",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "那也…没关系。「盐之魔神」为保护她的信徒，连生命都愿意付出。我的牺牲，微不足道。",
            "nextDialogs": [
              "110230919"
            ]
          },
          "110230919": {
            "id": "110230919",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "你要怎样惩罚都没关系，只要让我带回…我信仰的证明！",
            "nextDialogs": [
              "110230920"
            ]
          },
          "110230920": {
            "id": "110230920",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "不、不可以打女孩子啊！",
            "nextDialogs": [
              "110230921"
            ]
          },
          "110230921": {
            "id": "110230921",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "…如果那样就能获得解脱，说不定是更轻松的方法。但…",
            "nextDialogs": [
              "110230922"
            ]
          },
          "110230922": {
            "id": "110230922",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "作为「惩罚」，我会告诉你「真相」。",
            "nextDialogs": [
              "110230923"
            ]
          },
          "110230923": {
            "id": "110230923",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "什么？",
            "nextDialogs": [
              "110230924"
            ]
          },
          "110230924": {
            "id": "110230924",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "真相？你说真相…是对我的惩罚？",
            "nextDialogs": [
              "110230925"
            ]
          },
          "110230925": {
            "id": "110230925",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "是的。接下来你将听到的事实，就是你破坏了「契约」的代价。",
            "nextDialogs": [
              "110230926"
            ]
          },
          "110230926": {
            "id": "110230926",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "——很遗憾，盐之魔神，赫乌莉亚，并不是一位权能强大的魔神。",
            "nextDialogs": [
              "110230927"
            ]
          },
          "110230927": {
            "id": "110230927",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "相反，她过于弱小——过于迁就、过于柔弱，是绝无可能登上七神之位的…败者。",
            "nextDialogs": [
              "110230928"
            ]
          },
          "110230928": {
            "id": "110230928",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "你说什么…？！",
            "nextDialogs": [
              "110230929"
            ]
          },
          "110230929": {
            "id": "110230929",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "魔神战争时期，尘世间的魔神们为了争夺提瓦特大陆，拼尽了全部的力量与智慧。",
            "nextDialogs": [
              "110230930"
            ]
          },
          "110230930": {
            "id": "110230930",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "但赫乌莉亚选择了逃避。她认为只要在争斗发生之前就放弃，战争就永远不会波及到自己和子民。",
            "nextDialogs": [
              "110230931"
            ]
          },
          "110230931": {
            "id": "110230931",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "可是，在漫长的战争岁月里，「退让」是不会有止境的。",
            "nextDialogs": [
              "110230932"
            ]
          },
          "110230932": {
            "id": "110230932",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "在无底线的退让中，赫乌莉亚失去了所有土地，只剩下最后的容身之所。",
            "nextDialogs": [
              "110230933"
            ]
          },
          "110230933": {
            "id": "110230933",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "不…不…没可能的…",
            "nextDialogs": [
              "110230934"
            ]
          },
          "110230934": {
            "id": "110230934",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "在她最后的时刻，她连一把能举起来保护子民的兵刃，都没有了。",
            "nextDialogs": [
              "110230935"
            ]
          },
          "110230935": {
            "id": "110230935",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "连兵刃都没有？可是，这剑…",
            "nextDialogs": [
              "110230936"
            ]
          },
          "110230936": {
            "id": "110230936",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "是的，这把断剑并非「盐之魔神」的遗物，而是…杀死她的凶器。",
            "nextDialogs": [
              "110230937"
            ]
          },
          "110230937": {
            "id": "110230937",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "凶器…？",
            "nextDialogs": [
              "110230938"
            ]
          },
          "110230938": {
            "id": "110230938",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "不！这是假的，你说的都是假的，你想要迷惑我对神明的信心！",
            "nextDialogs": [
              "110230939"
            ]
          },
          "110230939": {
            "id": "110230939",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "我说过，我只陈述事实。",
            "nextDialogs": [
              "110230940"
            ]
          },
          "110230940": {
            "id": "110230940",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "岂有此理！你…你也是摩拉克斯的信徒，你别想骗我！",
            "nextDialogs": [
              "110230941"
            ]
          },
          "110230941": {
            "id": "110230941",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "(test)（少女向深处跑去）",
            "nextDialogs": [
              "110230942"
            ]
          },
          "110230942": {
            "id": "110230942",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "喂！喂，别跑啊！",
            "nextDialogs": [
              "110230944",
              "110230946"
            ]
          },
          "110230944": {
            "id": "110230944",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "毕竟，这是惩罚。若非如此，我也不想讲出这么残酷的事。",
            "nextDialogs": [
              "110230947"
            ]
          },
          "110230947": {
            "id": "110230947",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "我们也继续往深处走吧。在那里…恐怕会有，令她无论如何都不得不接受「真相」的东西。"
          },
          "110230946": {
            "id": "110230946",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "嗯，不然也不会把「真相」当作惩罚了。我也不想讲出这么残酷的事。"
          }
        }
      }
    },
    {
      "subId": "1102313",

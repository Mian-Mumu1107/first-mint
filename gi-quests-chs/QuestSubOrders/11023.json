    {
      "subId": "1102303",
      "subQuestName": "(test)盐盏处对话（release后隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110230301"
        ],
        "dialogs": {
          "110230301": {
            "id": "110230301",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "这个里面，有装了一半的盐。",
            "nextDialogs": [
              "110230302"
            ]
          },
          "110230302": {
            "id": "110230302",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "不过就是个盐罐子而已，看来「盐之魔神」是个穷酸的魔神啊。",
            "nextDialogs": [
              "110230303"
            ]
          },
          "110230303": {
            "id": "110230303",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "据我了解，它并不普通。虽然只有一半，但永远都有一半——换句话说，就是无尽。",
            "nextDialogs": [
              "110230304"
            ]
          },
          "110230304": {
            "id": "110230304",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "什么？！我就算一直往外面倒，里面的盐也不会减少吗！",
            "nextDialogs": [
              "110230305"
            ]
          },
          "110230305": {
            "id": "110230305",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "正是。",
            "nextDialogs": [
              "110230306"
            ]
          },
          "110230306": {
            "id": "110230306",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "能够产生无穷无尽的盐，果然，「盐之魔神」所拥有的权能是很强大的！",
            "nextDialogs": [
              "110230307"
            ]
          },
          "110230307": {
            "id": "110230307",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "折腾了这么久，终于让我遇到宝贝了！这东西归我了！",
            "nextDialogs": [
              "110230308"
            ]
          },
          "110230308": {
            "id": "110230308",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "我只需要把盐倒出来，搞个几千几万袋，靠卖盐都能发财了！",
            "nextDialogs": [
              "110230309"
            ]
          },
          "110230309": {
            "id": "110230309",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "喂！「盐之魔神」的遗产，怎么可以用来做这么肤浅的事！",
            "nextDialogs": [
              "110230310"
            ]
          },
          "110230310": {
            "id": "110230310",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "如果克列门特先生想要这个盐盏，那么按照契约，下一件物品，就是属于宛烟女士的。",
            "nextDialogs": [
              "110230311"
            ]
          },
          "110230311": {
            "id": "110230311",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "没问题没问题，哼哼，怎么会有比这个还值钱的东西呢？",
            "nextDialogs": [
              "110230312"
            ]
          },
          "110230312": {
            "id": "110230312",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "既然有「契约」，我也没必要和他争抢…",
            "nextDialogs": [
              "110230313"
            ]
          },
          "110230313": {
            "id": "110230313",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "那么，我们继续前进吧。"
          }
        }
      }
    },
    {
      "subId": "1102304",

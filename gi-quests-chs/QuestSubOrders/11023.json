    {
      "subId": "1102305",
      "subQuestName": "(test)盐尺处对话（release后隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110230501"
        ],
        "dialogs": {
          "110230501": {
            "id": "110230501",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "哼，一把尺子而已，看起来就没什么用。",
            "nextDialogs": [
              "110230502"
            ]
          },
          "110230502": {
            "id": "110230502",
            "speakerId": 1000,
            "speakerName": "宛烟",
            "text": "这是…我记得没错的话，这个应该是一种量器？",
            "nextDialogs": [
              "110230503"
            ]
          },
          "110230503": {
            "id": "110230503",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "确实如此。但「盐之魔神」亦有权能在此。",
            "nextDialogs": [
              "110230504"
            ]
          },
          "110230504": {
            "id": "110230504",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "这盐尺一旦插进地面，土壤之上就会像涨水那样，被盐覆盖。",
            "nextDialogs": [
              "110230505"
            ]
          },
          "110230505": {
            "id": "110230505",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "越是深入，盐粒就会越多，换言之，就是盐的「丰收」。",
            "nextDialogs": [
              "110230506"
            ]
          },
          "110230506": {
            "id": "110230506",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "这、这…这不是比盐盏还要厉害？！",
            "nextDialogs": [
              "110230507"
            ]
          },
          "110230507": {
            "id": "110230507",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "那么，按照契约，这盐尺就属于宛烟女士了。",
            "nextDialogs": [
              "110230508"
            ]
          },
          "110230508": {
            "id": "110230508",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "不行！我不同意！钱是我出的，这场探索也是我组织的，凭什么要我吃亏！",
            "nextDialogs": [
              "110230509"
            ]
          },
          "110230509": {
            "id": "110230509",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "而且这小姑娘一点用都没有，为什么要把东西送给她！",
            "nextDialogs": [
              "110230510"
            ]
          },
          "110230510": {
            "id": "110230510",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "他果然还是这么做了…",
            "nextDialogs": [
              "110230513"
            ]
          },
          "110230513": {
            "id": "110230513",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "那也就是，你想破坏「契约」了？",
            "nextDialogs": [
              "110230514"
            ]
          },
          "110230514": {
            "id": "110230514",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "破坏又怎么样？这遗迹里的机关，我也差不多看明白了。所以，你已经没用了。",
            "nextDialogs": [
              "110230515"
            ]
          },
          "110230515": {
            "id": "110230515",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "说到底，我是雇佣你的人。凭什么我要按照你的规矩来做事？",
            "nextDialogs": [
              "110230516"
            ]
          },
          "110230516": {
            "id": "110230516",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "因为你立下了契约。",
            "nextDialogs": [
              "110230517"
            ]
          },
          "110230517": {
            "id": "110230517",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "岩王帝君曾说，「契约既成，食言者当受食岩之罚。」",
            "nextDialogs": [
              "110230518"
            ]
          },
          "110230518": {
            "id": "110230518",
            "speakerId": 1001,
            "speakerName": "克列门特",
            "text": "那是你们璃月的神，我是至冬来的，我…",
            "nextDialogs": [
              "110230519"
            ]
          },
          "110230519": {
            "id": "110230519",
            "speakerId": 1002,
            "speakerName": "钟离",
            "text": "「食岩之罚」，你自己感受一下吧…可不会太轻松的。"
          }
        }
      }
    },
    {
      "subId": "1102306",
      "subQuestName": "惩罚克列门特",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

    {
      "subId": "4006603",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400660301"
        ],
        "dialogs": {
          "400660301": {
            "id": "400660301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，是新的空间！",
            "nextDialogs": [

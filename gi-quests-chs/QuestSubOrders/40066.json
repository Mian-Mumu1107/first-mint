    {
      "subId": "4006606",
      "subQuestName": "沿路前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400660601"
        ],
        "dialogs": {
          "400660601": {
            "id": "400660601",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "…好，这样就可以了。万叶，来得正好，你看我这块石头雕得如何？",
            "nextDialogs": [
              "400660602"
            ]
          },
          "400660602": {
            "id": "400660602",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "灵巧有趣。",
            "nextDialogs": [
              "400660603"
            ]
          },
          "400660603": {
            "id": "400660603",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "呵呵，这是我从书上看来的山景。别国有许多高耸入云的名山，如有机会，真想外出看看。",
            "nextDialogs": [
              "400660604"
            ]
          },
          "400660604": {
            "id": "400660604",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "您若想去，随时都能出发。",
            "nextDialogs": [
              "400660605"
            ]
          },
          "400660605": {
            "id": "400660605",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "话不能这么说。我是如今的家主，虽说枫原家远不比从前，可该做的事，一件都没少啊。",
            "nextDialogs": [
              "400660606"
            ]
          },
          "400660606": {
            "id": "400660606",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "但…像这样坚持父辈的道路，为一度陨落的家族事业倾尽所有，当真值得吗？",
            "nextDialogs": [
              "400660607"
            ]
          },
          "400660607": {
            "id": "400660607",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "父亲，我…不明白。",
            "nextDialogs": [
              "400660608"
            ]
          },
          "400660608": {
            "id": "400660608",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "…万叶，我希望你记得一件事。",
            "nextDialogs": [
              "400660609"
            ]
          },
          "400660609": {
            "id": "400660609",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "家族固然重要，人却也不能拘泥于此。",
            "nextDialogs": [
              "400660610"
            ]
          },
          "400660610": {
            "id": "400660610",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "家因人而存在。要是我们自己过得苦闷，又谈何让家人快乐幸福呢。",
            "nextDialogs": [
              "400660611"
            ]
          },
          "400660611": {
            "id": "400660611",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "从前的事，影响家族甚多。可它不应是让子孙背负的重担。",
            "nextDialogs": [
              "400660612"
            ]
          },
          "400660612": {
            "id": "400660612",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "…如果有一天，你厌倦了无趣的生活，就丢下一切出去走走。切记，不要让生活束缚了你。",
            "nextDialogs": [
              "400660613"
            ]
          },
          "400660613": {
            "id": "400660613",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "是。"
          }
        }
      }
    },

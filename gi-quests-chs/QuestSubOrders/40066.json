      }
    },
    {
      "subId": "4006617",
      "subQuestName": "寻找万叶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400661701"
        ],
        "dialogs": {
          "400661701": {
            "id": "400661701",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "果然又被关在这里了呀。",
            "nextDialogs": [
              "400661702"
            ]
          },
          "400661702": {
            "id": "400661702",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "哈哈，也算是规律使然。",
            "nextDialogs": [
              "400661703"
            ]
          },
          "400661703": {
            "id": "400661703",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们又进了幻境里的迷宫哦，不过这一次，似乎跟上次不太一样呢。",
            "nextDialogs": [
              "400661704"
            ]
          },
          "400661704": {
            "id": "400661704",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "讲述了这一次的见闻…",
            "nextDialogs": [
              "400661705"
            ]
          },
          "400661705": {
            "id": "400661705",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "人气变淡，摆设也不那么华丽了…嗯，本该如此。",
            "nextDialogs": [
              "400661706"
            ]
          },
          "400661706": {
            "id": "400661706",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "你们见到的，应该是正在没落的枫原家。",
            "nextDialogs": [
              "400661707"
            ]
          },
          "400661707": {
            "id": "400661707",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，幻境里的你像个影子一样，而且跟现在不太一样。",
            "nextDialogs": [
              "400661708"
            ]
          },
          "400661708": {
            "id": "400661708",
            "speakerId": 1006,
            "speakerName": "菲谢尔",
            "text": "没错，本皇女也赞同。",
            "nextDialogs": [
              "400661709"
            ]
          },
          "400661709": {
            "id": "400661709",
            "speakerId": 1001,
            "speakerName": "奥兹",
            "text": "与现在的万叶卿相比，那道幻影有更多迷茫，背负着沉重的命运。",
            "nextDialogs": [
              "400661710"
            ]
          },
          "400661710": {
            "id": "400661710",
            "speakerId": 1007,
            "speakerName": "莫娜",
            "text": "确实能算是背负着沉重的命运。",
            "nextDialogs": [
              "400661711"
            ]
          },
          "400661711": {
            "id": "400661711",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "说明如今的我成长了。让各位见到不成熟的我，实在抱歉。",
            "nextDialogs": [
              "400661712"
            ]
          },
          "400661712": {
            "id": "400661712",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "离开稻妻之后很长一段时间里，我的生活颠沛流离。但不是坏事，我因而沉淀了。",
            "nextDialogs": [
              "400661713"
            ]
          },
          "400661713": {
            "id": "400661713",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "如果我也能见到那个从前的我就好了。他见了我，定会明白的。",
            "nextDialogs": [
              "400661714"
            ]
          },
          "400661714": {
            "id": "400661714",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "——人生路远，我仍需远行。"
          }
        }
      }
    },

            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "跟我想的一样，盆景就是幻境的关键。",
            "nextDialogs": [
              "400661802"
            ]
          },
          "400661802": {
            "id": "400661802",
            "speakerId": 1000,
            "speakerName": "派蒙",

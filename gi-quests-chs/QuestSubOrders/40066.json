    {
      "subId": "4006611",
      "subQuestName": "沿路前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400661101"
        ],
        "dialogs": {
          "400661101": {
            "id": "400661101",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "请恕我无法理解！",
            "nextDialogs": [
              "400661102"
            ]
          },
          "400661102": {
            "id": "400661102",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "万叶，你忘了我们之间的约定吗？",
            "nextDialogs": [
              "400661103"
            ]
          },
          "400661103": {
            "id": "400661103",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "您真的要放弃这一切吗？就算…就算我们过得艰苦，可您还有我在身边啊，我难道不能帮助您吗？",
            "nextDialogs": [
              "400661104"
            ]
          },
          "400661104": {
            "id": "400661104",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "您像我这么大的时候，已经在为爷爷分忧了吧。是我太无能，让您失望，还是说…",
            "nextDialogs": [
              "400661105"
            ]
          },
          "400661105": {
            "id": "400661105",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "万叶！",
            "nextDialogs": [
              "400661106"
            ]
          },
          "400661106": {
            "id": "400661106",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "…唉，你会为这些事自责，正是我作为父亲失败的证明啊。",
            "nextDialogs": [
              "400661107"
            ]
          },
          "400661107": {
            "id": "400661107",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "枫原家为过去的错误付出了太多太多。从你曾祖父那一辈开始，直到现在，我们都没能真正走出阴霾。",
            "nextDialogs": [
              "400661108"
            ]
          },
          "400661108": {
            "id": "400661108",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "锻刀是我们一族的事业，可你记住，家族的事业，未必就要是你的全部。",
            "nextDialogs": [
              "400661109"
            ]
          },
          "400661109": {
            "id": "400661109",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "受伤的野兽想要走出陷阱，就要忍痛舍弃被钳制的后腿。你觉得这是损失，可不离开陷阱，后果更为致命。",
            "nextDialogs": [
              "400661110"
            ]
          },
          "400661110": {
            "id": "400661110",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "已经够了，万叶。我身为一家之主，却没能振兴家族让你当上贵族少爷。你不埋怨我，我就挺高兴了。",
            "nextDialogs": [
              "400661111"
            ]
          },
          "400661111": {
            "id": "400661111",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "几代人的痛苦…就到今天为止吧。从今往后，卸下担子生活。",
            "nextDialogs": [
              "400661112"
            ]
          },
          "400661112": {
            "id": "400661112",
            "speakerId": 1003,
            "speakerName": "枫原景春",
            "text": "至于舍弃家族产业的恶名，我来背负就好。",
            "nextDialogs": [
              "400661113"
            ]
          },
          "400661113": {
            "id": "400661113",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "…父亲…请别这样，当不起家的恶名，可不能落在您头上。",
            "nextDialogs": [
              "400661114"
            ]
          },
          "400661114": {
            "id": "400661114",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "要是真有那么一天，我也要为您分担。",
            "nextDialogs": [
              "400661115"
            ]
          },
          "400661115": {
            "id": "400661115",
            "speakerId": 1004,
            "speakerName": "枫原万叶",
            "text": "再等等吧。枫原家迟早会传到我手中，等那时，再由我来处理这些。"
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "7007001",
      "subQuestName": "与丽莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706900301"
        ],
        "dialogs": {
          "706900301": {
            "id": "706900301",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "嗯？居然这么快就把所有书都整理好了，超出我的预期了啊。",
            "nextDialogs": [
              "706900302"
            ]
          },
          "706900302": {
            "id": "706900302",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "小可爱想要什么奖励吗？多亏了你们，才空出来了一整个下午，用来陪你的话也不错呢。",
            "nextDialogs": [
              "706900304"
            ]
          },
          "706900304": {
            "id": "706900304",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "只想要这个？别着急，报酬我不会忘的。",
            "nextDialogs": [
              "706900306"
            ]
          },
          "706900306": {
            "id": "706900306",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "你们也发现了吧，这批书从名字到内容都很奇怪呢。",
            "nextDialogs": [
              "706900307"
            ]
          },
          "706900307": {
            "id": "706900307",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "而且按理来说，这里作为北陆最大的图书馆，不可能会收到这么多连名字都没听过的新书。",
            "nextDialogs": [
              "706900308"
            ]
          },
          "706900308": {
            "id": "706900308",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "除非…",
            "nextDialogs": [
              "706900309"
            ]
          },
          "706900309": {
            "id": "706900309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "其实刚才我们遇到了…",
            "nextDialogs": [
              "706900310"
            ]
          },
          "706900310": {
            "id": "706900310",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "呵呵，看起来是一些我不太想知道的麻烦事呢。",
            "nextDialogs": [
              "706900311"
            ]
          },
          "706900311": {
            "id": "706900311",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "不管怎么说，既然是已经存在于这个世界上的书籍，就有将其收藏在图书馆的必要。",
            "nextDialogs": [
              "706900312"
            ]
          },
          "706900312": {
            "id": "706900312",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "放在这里，总比让它们流传在外面，落入什么奇怪的人手里要好得多。",
            "nextDialogs": [
              "706900313"
            ]
          },
          "706900313": {
            "id": "706900313",
            "speakerId": 1000,
            "speakerName": "丽莎",
            "text": "报酬在这里，这次也辛苦你们啦。"
          }
        }
      }
    }
  ]
}
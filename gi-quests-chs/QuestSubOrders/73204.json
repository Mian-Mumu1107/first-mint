    {
      "subId": "7320404",
      "subQuestName": "与阿凡对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732040401"
        ],
        "dialogs": {
          "732040401": {
            "id": "732040401",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "你们两个回来了？那块苗圃的状态怎么样，你们觉得它有救不？",
            "nextDialogs": [
              "732040402"
            ]
          },
          "732040402": {
            "id": "732040402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经解决了。",
            "nextDialogs": [
              "732040403"
            ]
          },
          "732040403": {
            "id": "732040403",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "将死域的事解释给阿凡听。",
            "nextDialogs": [
              "732040404"
            ]
          },
          "732040404": {
            "id": "732040404",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "原来是这么回事，我就说好端端的地里怎么会突然冒出这么多黑乎乎的怪东西。",
            "nextDialogs": [
              "732040405"
            ]
          },
          "732040405": {
            "id": "732040405",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "好好好，这下我可以安心把种子种上了。",
            "nextDialogs": [
              "732040406"
            ]
          },
          "732040406": {
            "id": "732040406",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "等这三颗种子发芽开花结新种子，再往那块地里种，以后这花就能开得到处都是了。",
            "nextDialogs": [
              "732040407"
            ]
          },
          "732040407": {
            "id": "732040407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，这些…形状奇怪的石头吗？它们能长出花来？",
            "nextDialogs": [
              "732040408"
            ]
          },
          "732040408": {
            "id": "732040408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "阿凡爷爷，你这是在哪里买来的呀，别被人骗了。",
            "nextDialogs": [
              "732040409"
            ]
          },
          "732040409": {
            "id": "732040409",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "这个小娃娃心地还挺好，你们放心，摩拉可买不到这些花种子。",
            "nextDialogs": [
              "732040410"
            ]
          },
          "732040410": {
            "id": "732040410",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "这三颗都是鬼…咳咳…一个朋友留给我的珍贵种子，当然跟普通的果子啊花苗啊不同。",
            "nextDialogs": [
              "732040411"
            ]
          },
          "732040411": {
            "id": "732040411",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "越听越奇怪呢，阿凡爷爷，你种的到底是什么呀？",
            "nextDialogs": [
              "732040412"
            ]
          },
          "732040412": {
            "id": "732040412",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "呵呵，我种的是一个朋友的嘱托，是他的愿望。",
            "nextDialogs": [
              "732040413"
            ]
          },
          "732040413": {
            "id": "732040413",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好奇怪的说法，这种东西是可以种的吗？",
            "nextDialogs": [
              "732040414"
            ]
          },
          "732040414": {
            "id": "732040414",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "小娃娃，跟你说了你也不会明白的，以后有机会再来看看吧。",
            "nextDialogs": [
              "732040415"
            ]
          },
          "732040415": {
            "id": "732040415",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "别看这里现在空荡荡的，将来这片苗圃里的三颗种子都会发芽开花。",
            "nextDialogs": [
              "732040416"
            ]
          },
          "732040416": {
            "id": "732040416",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "以后它们会越长越多的，哈哈，那时候一定很漂亮。",
            "nextDialogs": [
              "732040417"
            ]
          },
          "732040417": {
            "id": "732040417",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "好了好了，说好了委托你们帮忙，报酬我是不会赖着不给的。",
            "nextDialogs": [
              "732040418"
            ]
          },
          "732040418": {
            "id": "732040418",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "你们俩拿着吧，我能给的也不多，都在这里了。",
            "nextDialogs": [
              "732040419"
            ]
          },
          "732040419": {
            "id": "732040419",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呼，委托完成，跑了这半天感觉肚子有点饿。",
            "nextDialogs": [
              "732040420"
            ]
          },
          "732040420": {
            "id": "732040420",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明明都是我在跑。",
            "nextDialogs": [
              "732040421"
            ]
          },
          "732040421": {
            "id": "732040421",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我也有一路陪你说话嘛，说话也是会消耗能量的。",
            "nextDialogs": [
              "732040422"
            ]
          },
          "732040422": {
            "id": "732040422",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#别那么小气啦，{NICKNAME}，我们拿上酬金去买点好吃的犒劳自己一下，怎么样？",
            "nextDialogs": [
              "732040423"
            ]
          },
          "732040423": {
            "id": "732040423",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "快看看报酬有多少，够我们吃几顿。",
            "nextDialogs": [
              "732040424"
            ]
          },
          "732040424": {
            "id": "732040424",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我看看。",
            "nextDialogs": [
              "732040425"
            ]
          },
          "732040425": {
            "id": "732040425",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，比起摩拉，更多的是食物…烤肉卷、米圆塔，还有好多蔬菜。",
            "nextDialogs": [
              "732040426"
            ]
          },
          "732040426": {
            "id": "732040426",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这也太多了。我们…是不是拿了阿凡爷爷一天的口粮啊…",
            "nextDialogs": [
              "732040427"
            ]
          },
          "732040427": {
            "id": "732040427",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个阿凡爷爷一个人住在村子外面，应该也挺不容易的。",
            "nextDialogs": [
              "732040428"
            ]
          },
          "732040428": {
            "id": "732040428",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "摩拉就算了，把口粮都给我们的话，唔…感觉有点沉重。",
            "nextDialogs": [
              "732040429"
            ]
          },
          "732040429": {
            "id": "732040429",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且，他明明种着石头一样的种子，却说自己种的是…愿望？",
            "nextDialogs": [
              "732040430"
            ]
          },
          "732040430": {
            "id": "732040430",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你说，他会不会是一个人住了太久，产生了幻觉？",
            "nextDialogs": [
              "732040431"
            ]
          },
          "732040431": {
            "id": "732040431",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "越想越觉得不放心，我们有空的时候就去看看他吧。"
          }
        }
      }
    },

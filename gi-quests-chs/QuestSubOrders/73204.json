    {
      "subId": "7320401",
      "subQuestName": "(test)与老者对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732040101"
        ],
        "dialogs": {
          "732040101": {
            "id": "732040101",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "两个小娃娃干什么呢，你们也是来看我这个「种石头」老头笑话的？",
            "nextDialogs": [
              "732040102"
            ]
          },
          "732040102": {
            "id": "732040102",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "我好着呢，用不着村里人费心。",
            "nextDialogs": [
              "732040103"
            ]
          },
          "732040103": {
            "id": "732040103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，不用一上来就这么大敌意吧。",
            "nextDialogs": [
              "732040104"
            ]
          },
          "732040104": {
            "id": "732040104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你搞错了，我们不是阿如村的人，也不是来看笑话的。",
            "nextDialogs": [
              "732040106",
              "732040108"
            ]
          },
          "732040106": {
            "id": "732040106",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "路过的人？这个…",
            "nextDialogs": [
              "732040110"
            ]
          },
          "732040110": {
            "id": "732040110",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "平时只有几个老相识会来我这儿，一个劲叫我放弃这里的苗圃，搬回村子。",
            "nextDialogs": [
              "732040111"
            ]
          },
          "732040111": {
            "id": "732040111",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "还有几个坏小子，老是跑到我这里来调皮捣蛋。",
            "nextDialogs": [
              "732040112"
            ]
          },
          "732040112": {
            "id": "732040112",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "我倒是第一次见到打扮成你们这样的，两个小娃娃，你们是做什么的？"
          },
          "732040108": {
            "id": "732040108",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "没错，我种的是花，可不是什么烂石头。",
            "nextDialogs": [
              "732040109"
            ]
          },
          "732040109": {
            "id": "732040109",
            "speakerId": 1000,
            "speakerName": "阿凡",
            "text": "我刚才还以为…哎哟，叫我说什么呢…"
          }
        }
      }
    },

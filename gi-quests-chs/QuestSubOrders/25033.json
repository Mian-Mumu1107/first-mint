  "subQuests": [
    {
      "subId": "2503301",
      "subQuestName": "与特拉忒对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250330101"
        ],
        "dialogs": {
          "250330101": {
            "id": "250330101",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "乖乖喔，今天吃饱了吗？有没有力气训练呀？",
            "nextDialogs": [
              "250330102"
            ]
          },
          "250330102": {
            "id": "250330102",
            "speakerId": 14372,
            "speakerName": "奇卡",
            "text": "呜，呜呜，呜！",
            "nextDialogs": [
              "250330103"
            ]
          },
          "250330103": {
            "id": "250330103",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "呜哇，这么有活力？好！那今天可要加把劲了！",
            "nextDialogs": [
              "250330104"
            ]
          },
          "250330104": {
            "id": "250330104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一起加把劲吧！",
            "nextDialogs": [
              "250330106"
            ]
          },
          "250330106": {
            "id": "250330106",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "#欸？您好呀，{M#大哥哥}{F#大姐姐}！我们正在进行爬山训练呢。",
            "nextDialogs": [
              "250330107"
            ]
          },
          "250330107": {
            "id": "250330107",
            "speakerId": 14372,
            "speakerName": "奇卡",
            "text": "呜呜！呜呜！",
            "nextDialogs": [
              "250330108"
            ]
          },
          "250330108": {
            "id": "250330108",
            "speakerId": 14372,
            "speakerName": "奇卡",
            "text": "呜呜，呜…",
            "nextDialogs": [
              "250330110",
              "250330113"
            ]
          },
          "250330110": {
            "id": "250330110",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "那个…至少能说「有进步」吧。这次奇卡爬的比上次高多了。",
            "nextDialogs": [
              "250330111"
            ]
          },
          "250330111": {
            "id": "250330111",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "就是在爬山的时候，奇卡的攀爬动作有些不熟练…",
            "nextDialogs": [
              "250330116"
            ]
          },
          "250330116": {
            "id": "250330116",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "#{M#大哥哥}{F#大姐姐}，你能再为我们示范一遍吗？"
          },
          "250330113": {
            "id": "250330113",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "当然啦。妈妈都说，我可擅长照料奇卡了。",
            "nextDialogs": [
              "250330114"
            ]
          },
          "250330114": {
            "id": "250330114",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "奇卡的进步可大了，爬的高度也比上次高很多。",
            "nextDialogs": [
              "250330115"
            ]
          },
          "250330115": {
            "id": "250330115",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "就是在爬山的时候，奇卡的动作有些不熟练…"
          }
        }
      }
    },
    {
      "subId": "2503302",
      "subQuestName": "爬上山顶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250330201"
        ],
        "dialogs": {
          "250330201": {
            "id": "250330201",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "#{M#大哥哥}{F#大姐姐}好厉害！爬得和马伊塔一样快！",
            "nextDialogs": [
              "250330204"
            ]
          },
          "250330204": {
            "id": "250330204",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "这种爬山的速度已经很厉害啦。我和奇卡都比不了你。",
            "nextDialogs": [
              "250330205"
            ]
          },
          "250330205": {
            "id": "250330205",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "#唉，想要赶上{M#大哥哥}{F#大姐姐}，应该还要训练很久吧…",
            "nextDialogs": [
              "250330206"
            ]
          },
          "250330206": {
            "id": "250330206",
            "speakerId": 14372,
            "speakerName": "奇卡",
            "text": "呜，呜呜…"
          }
        }
      }
    },
    {
      "subId": "2503303",
      "subQuestName": "(test)隐藏任务用于判断是达成时限要求$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250330301"
        ],
        "dialogs": {
          "250330301": {
            "id": "250330301",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "#{M#大哥哥}{F#大姐姐}好厉害！我，我还是没能看清你爬上去的动作…",
            "nextDialogs": [
              "250330302"
            ]
          },
          "250330302": {
            "id": "250330302",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "#唉，想要赶上{M#大哥哥}{F#大姐姐}，应该还要训练很久吧…",
            "nextDialogs": [
              "250330303"
            ]
          },
          "250330303": {
            "id": "250330303",
            "speakerId": 14372,
            "speakerName": "奇卡",
            "text": "呜，呜呜…",
            "nextDialogs": [
              "250330306"
            ]
          },
          "250330306": {
            "id": "250330306",
            "speakerId": 14372,
            "speakerName": "奇卡",
            "text": "呜？！呜呜，呜…",
            "nextDialogs": [
              "250330307"
            ]
          },
          "250330307": {
            "id": "250330307",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "乖乖喔，奇卡。亚瓦尔叔叔说了，只要我们努力，一定能变得更厉害的！",
            "nextDialogs": [
              "250330308"
            ]
          },
          "250330308": {
            "id": "250330308",
            "speakerId": 14372,
            "speakerName": "奇卡",
            "text": "呜呜…",
            "nextDialogs": [
              "250330309"
            ]
          },
          "250330309": {
            "id": "250330309",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "#{M#大哥哥}{F#大姐姐}，谢谢你帮忙，这些果子给你。",
            "nextDialogs": [
              "250330310"
            ]
          },
          "250330310": {
            "id": "250330310",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "这是奇卡刚刚摘到的，它的动作比之前快了好多呢！",
            "nextDialogs": [
              "250330311"
            ]
          },
          "250330311": {
            "id": "250330311",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "#嘿嘿，都是因为有{M#大哥哥}{F#大姐姐}给奇卡做榜样。奇卡才能变得这么厉害。",
            "nextDialogs": [
              "250330312"
            ]
          },
          "250330312": {
            "id": "250330312",
            "speakerId": 14372,
            "speakerName": "奇卡",
            "text": "呜呜，呜！",
            "nextDialogs": [
              "250330313"
            ]
          },
          "250330313": {
            "id": "250330313",
            "speakerId": 14371,
            "speakerName": "特拉忒",
            "text": "好啦，那我们就先回部族去找马伊塔了。唔…他现在应该在部族里吧…"
          }
        }
      }
    },

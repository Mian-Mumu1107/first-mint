    {
      "subId": "600802",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60080201"
        ],
        "dialogs": {
          "60080201": {
            "id": "60080201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「少女」看样子没精打采的…",
            "nextDialogs": [
              "60080202"
            ]
          },
          "60080202": {
            "id": "60080202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "打扰了，你、你还好吗？",
            "nextDialogs": [
              "60080203"
            ]
          },
          "60080203": {
            "id": "60080203",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "……",
            "nextDialogs": [
              "60080204"
            ]
          },
          "60080204": {
            "id": "60080204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "身体情况又恶化了吗？",
            "nextDialogs": [
              "60080205"
            ]
          },
          "60080205": {
            "id": "60080205",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "…晕晕的。",
            "nextDialogs": [
              "60080206"
            ]
          },
          "60080206": {
            "id": "60080206",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "…好像要回到月亮上去了。",
            "nextDialogs": [
              "60080207"
            ]
          },
          "60080207": {
            "id": "60080207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那倒也不至于吧？！",
            "nextDialogs": [
              "60080208"
            ]
          },
          "60080208": {
            "id": "60080208",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯？那是…我从你身体里…感受到了月亮的力量？",
            "nextDialogs": [
              "60080209"
            ]
          },
          "60080209": {
            "id": "60080209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们从「愚人众」手中夺回了「月髓」，它能帮到你吗？",
            "nextDialogs": [
              "60080210"
            ]
          },
          "60080210": {
            "id": "60080210",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯…这次你们需要什么？",
            "nextDialogs": [
              "60080211"
            ]
          },
          "60080211": {
            "id": "60080211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么还在说这些啦？现在是你的身体要紧吧！",
            "nextDialogs": [
              "60080212"
            ]
          },
          "60080212": {
            "id": "60080212",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "……",
            "nextDialogs": [
              "60080213"
            ]
          },
          "60080213": {
            "id": "60080213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（难道说…这是她的某种习惯吗？因为一直生活在互相利用的环境中…）",
            "nextDialogs": [
              "60080214"
            ]
          },
          "60080214": {
            "id": "60080214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许你之后可以帮我个忙。",
            "nextDialogs": [
              "60080215"
            ]
          },
          "60080215": {
            "id": "60080215",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "…嗯，好啊。",
            "nextDialogs": [
              "60080216"
            ]
          },
          "60080216": {
            "id": "60080216",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "把你的手给我。",
            "nextDialogs": [
              "60080217"
            ]
          },
          "60080217": {
            "id": "60080217",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "呼…谢谢你，我回到地面了。",
            "nextDialogs": [
              "60080218"
            ]
          },
          "60080218": {
            "id": "60080218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你本来就在这里啦…现在怎么样？没问题了吗？",
            "nextDialogs": [
              "60080219"
            ]
          },
          "60080219": {
            "id": "60080219",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "好多了。",
            "nextDialogs": [
              "60080222"
            ]
          },
          "60080222": {
            "id": "60080222",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "月亮在你体内安静得像个水面的倒影…真奇妙…",
            "nextDialogs": [
              "60080223"
            ]
          },
          "60080223": {
            "id": "60080223",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我不过从水中捧走了一束月光而已，足够我暂时回到地面的一束月光。",
            "nextDialogs": [
              "60080224"
            ]
          },
          "60080224": {
            "id": "60080224",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我似乎还感受到了些其他变化…",
            "nextDialogs": [
              "60080225"
            ]
          },
          "60080225": {
            "id": "60080225",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "那是「月神的赐福」。只要同我相触之物，就会带上这种印记。",
            "nextDialogs": [
              "60080226"
            ]
          },
          "60080226": {
            "id": "60080226",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这印记是无害的，过一段时间就会自己消去。",
            "nextDialogs": [
              "60080227"
            ]
          },
          "60080227": {
            "id": "60080227",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说到这个，既然你都恢复了力量，那要不要把「月髓」交给你保管呀？",
            "nextDialogs": [
              "60080228"
            ]
          },
          "60080228": {
            "id": "60080228",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "照理说这也是属于「神明」的东西吧？",
            "nextDialogs": [
              "60080229"
            ]
          },
          "60080229": {
            "id": "60080229",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这是「恒月女神·艾莉亚」的遗骸。",
            "nextDialogs": [
              "60080230"
            ]
          },
          "60080230": {
            "id": "60080230",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "果然是…欸？！！",
            "nextDialogs": [
              "60080231"
            ]
          },
          "60080231": {
            "id": "60080231",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "你们之前不知道吗？",
            "nextDialogs": [
              "60080232"
            ]
          },
          "60080232": {
            "id": "60080232",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "菈乌玛只说它和其他碎片不一样，能从中感受到神明的力量。",
            "nextDialogs": [
              "60080233"
            ]
          },
          "60080233": {
            "id": "60080233",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "她说得没错。刚才我捧走月光的时候，也捧回了一些月髓中的「记忆」。",
            "nextDialogs": [
              "60080234"
            ]
          },
          "60080234": {
            "id": "60080234",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这份「记忆」让我知道了，它属于曾经那位「恒月女神」。",
            "nextDialogs": [
              "60080235"
            ]
          },
          "60080235": {
            "id": "60080235",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "菈乌玛应该也借「月髓」看过以前的历史，她怎么没发现呢…",
            "nextDialogs": [
              "60080236"
            ]
          },
          "60080236": {
            "id": "60080236",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（菈乌玛说自己只能看到过去的片段，而且还很模糊…说不定这是只有「月神」才能感觉到的东西…）",
            "nextDialogs": [
              "60080237"
            ]
          },
          "60080237": {
            "id": "60080237",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "曾经的天空有三月，又有三位女神执掌着属于自己的月亮。",
            "nextDialogs": [
              "60080238"
            ]
          },
          "60080238": {
            "id": "60080238",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "但葬火之战后，三位女神均已逝去。三轮月亮则有两轮在战争中破碎。",
            "nextDialogs": [
              "60080239"
            ]
          },
          "60080239": {
            "id": "60080239",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "恒月的「艾莉亚」死后，其力量凝聚为了这颗月髓…",
            "nextDialogs": [
              "60080240"
            ]
          },
          "60080240": {
            "id": "60080240",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "「虹月」的遗骸从未被找到，「霜月」女神虽亡，但月亮的身形不曾破碎。",
            "nextDialogs": [
              "60080241"
            ]
          },
          "60080241": {
            "id": "60080241",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "正如预言所述，这样的月亮早晚将孕育出新的神明，也就是「霜月之子」口中的「库塔{RUBY#[S]月之少女}尔」。",
            "nextDialogs": [
              "60080242"
            ]
          },
          "60080242": {
            "id": "60080242",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我能感觉到自己的力量属于「霜月」。但它位于虚假之天外，离我太远。",
            "nextDialogs": [
              "60080243"
            ]
          },
          "60080243": {
            "id": "60080243",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "现在的我不说「操控」它，有时就连「感受」它都显得吃力。",
            "nextDialogs": [
              "60080244"
            ]
          },
          "60080244": {
            "id": "60080244",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我，我数数…我们拿到的是「恒月」，「虹月」的找不到…这么说的话，你身子里是有「霜月」的月髓吗？",
            "nextDialogs": [
              "60080245"
            ]
          },
          "60080245": {
            "id": "60080245",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "不，「月髓」是月神死后才会凝结而成的东西。其本质是一种力量核心。",
            "nextDialogs": [
              "60080246"
            ]
          },
          "60080246": {
            "id": "60080246",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "就像你不该问月亮上有没有石头一样。",
            "nextDialogs": [
              "60080247"
            ]
          },
          "60080247": {
            "id": "60080247",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！是说你本身就代表着「霜月」的力量，对吧？",
            "nextDialogs": [
              "60080248"
            ]
          },
          "60080248": {
            "id": "60080248",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯。拥有「神之心」的魔神被称为神明，拥有「月髓」的你…是不是也能当「月神」了？",
            "nextDialogs": [
              "60080249"
            ]
          },
          "60080249": {
            "id": "60080249",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这不太一样吧…",
            "nextDialogs": [
              "60080250"
            ]
          },
          "60080250": {
            "id": "60080250",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "你不想当月神吗？",
            "nextDialogs": [
              "60080251"
            ]
          },
          "60080251": {
            "id": "60080251",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "问题不在这里啦！你好像真的很想把这个称呼让出去欸！",
            "nextDialogs": [
              "60080252"
            ]
          },
          "60080252": {
            "id": "60080252",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总之，抛开谁当月神的问题不谈，我们是不是应该把这颗「月髓」还给你呀？",
            "nextDialogs": [
              "60080253"
            ]
          },
          "60080253": {
            "id": "60080253",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我不要。",
            "nextDialogs": [
              "60080254"
            ]
          },
          "60080254": {
            "id": "60080254",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？",
            "nextDialogs": [
              "60080255"
            ]
          },
          "60080255": {
            "id": "60080255",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "而且它看起来也不想到我这里。",
            "nextDialogs": [
              "60080256"
            ]
          },
          "60080256": {
            "id": "60080256",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么意思…？",
            "nextDialogs": [
              "60080257"
            ]
          },
          "60080257": {
            "id": "60080257",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "刚才接触它力量的时候，我感受到的是一种「排斥」。",
            "nextDialogs": [
              "60080258"
            ]
          },
          "60080258": {
            "id": "60080258",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "或许因为我也是「月神」吧，就像两轮月亮不会同时升起，更无法相互吞噬。",
            "nextDialogs": [
              "60080259"
            ]
          },
          "60080259": {
            "id": "60080259",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那看来还是只能我带着了…",
            "nextDialogs": [
              "60080260"
            ]
          },
          "60080260": {
            "id": "60080260",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？虽然菈乌玛说这力量在你体内藏得很好，但「少女」刚才不也感受到了吗？",
            "nextDialogs": [
              "60080261"
            ]
          },
          "60080261": {
            "id": "60080261",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「狂猎」看起来也不是一般的东西，如果被它察觉到的话…",
            "nextDialogs": [
              "60080262"
            ]
          },
          "60080262": {
            "id": "60080262",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "「狂猎」？你们描述这种现象的语气像在描述一个人。",
            "nextDialogs": [
              "60080263"
            ]
          },
          "60080263": {
            "id": "60080263",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "因为它看起来就是有幕后黑手嘛，甚至像人一样有着明确的目的…之前就追着「月髓」不放。",
            "nextDialogs": [
              "60080264"
            ]
          },
          "60080264": {
            "id": "60080264",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "听起来有些耳熟…",
            "nextDialogs": [
              "60080265"
            ]
          },
          "60080265": {
            "id": "60080265",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？真的吗？",
            "nextDialogs": [
              "60080266"
            ]
          },
          "60080266": {
            "id": "60080266",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我还在「愚人众」的时候，听同僚们提起过一个人。",
            "nextDialogs": [
              "60080267"
            ]
          },
          "60080267": {
            "id": "60080267",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "他来自坎瑞亚，在灾变时期获得了「深渊」的力量，而且对于「月亮」有很强的执念…",
            "nextDialogs": [
              "60080268"
            ]
          },
          "60080268": {
            "id": "60080268",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "坎瑞亚？虽然那个诡影和坎瑞亚有没有关系我们不知道，但其他听起来都对得上欸…那他的名字是什么？",
            "nextDialogs": [
              "60080269"
            ]
          },
          "60080269": {
            "id": "60080269",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我只知道，别人称他为——「猎月人」。",
            "nextDialogs": [
              "60080270"
            ]
          },
          "60080270": {
            "id": "60080270",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "五大罪人？！",
            "nextDialogs": [
              "60080271"
            ]
          },
          "60080271": {
            "id": "60080271",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "哦，是还有这么一个称谓来着。",
            "nextDialogs": [
              "60080272"
            ]
          },
          "60080272": {
            "id": "60080272",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！是…是戴因提到过的那个？我们现在的对手…是传说中的五大罪人…「猎月人」雷利尔？！",
            "nextDialogs": [
              "60080273"
            ]
          },
          "60080273": {
            "id": "60080273",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但如果是五大罪人的话…他不该只有这些实力…",
            "nextDialogs": [
              "60080274"
            ]
          },
          "60080274": {
            "id": "60080274",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "听说「猎月人」在坎瑞亚灾变之后不久就消失了。",
            "nextDialogs": [
              "60080275"
            ]
          },
          "60080275": {
            "id": "60080275",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我问同僚他去了哪儿，他们却反问我说「你真的不知道？」。",
            "nextDialogs": [
              "60080276"
            ]
          },
          "60080276": {
            "id": "60080276",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么…",
            "nextDialogs": [
              "60080277"
            ]
          },
          "60080277": {
            "id": "60080277",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "因为据说猎月人最后的结局，是掉进了那个再也回不来的「月亮倒影」里…",
            "nextDialogs": [
              "60080278"
            ]
          },
          "60080278": {
            "id": "60080278",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等等等…东西太多，我都反应不过来了。",
            "nextDialogs": [
              "60080279"
            ]
          },
          "60080279": {
            "id": "60080279",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我那时也这样。他们总觉得，只要是和「月亮」有关的话题，我就一定知道。",
            "nextDialogs": [
              "60080280"
            ]
          },
          "60080280": {
            "id": "60080280",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "但我告诉过你们了…我的「序章」落在了虚假之天外，我连自己的名字都不知道…",
            "nextDialogs": [
              "60080281"
            ]
          },
          "60080281": {
            "id": "60080281",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…",
            "nextDialogs": [
              "60080282"
            ]
          },
          "60080282": {
            "id": "60080282",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "总之在「猎月人」消失之后，挪德卡莱的「狂猎」现象急剧恶化，成了深渊灾难的代名词。",
            "nextDialogs": [
              "60080283"
            ]
          },
          "60080283": {
            "id": "60080283",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "现在的狂猎，只是传承了那个名字，有相似的现象，但规模和危险程度已经远超往日了。",
            "nextDialogs": [
              "60080284"
            ]
          },
          "60080284": {
            "id": "60080284",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我还是很难相信，我们现在的对手居然是传说中的「五大罪人」之一…",
            "nextDialogs": [
              "60080285"
            ]
          },
          "60080285": {
            "id": "60080285",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这也太危险了吧！星砂滩那时感觉只是侥幸…或者是他没用出全力？",
            "nextDialogs": [
              "60080286"
            ]
          },
          "60080286": {
            "id": "60080286",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "即使这样…就连那个「木偶」也还是被他打败了…"
          }
        }
      }
    }
  ]
}
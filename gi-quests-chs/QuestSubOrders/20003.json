  "subQuests": [
    {
      "subId": "2000301",
      "subQuestName": "与歌德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030101"
        ],
        "dialogs": {
          "200030101": {
            "id": "200030101",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "唉，看来我还是得自己跑一趟…",
            "nextDialogs": [
              "200030102"
            ]
          },
          "200030102": {
            "id": "200030102",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "我这把老骨头，非得散架不可…",
            "nextDialogs": [
              "200030103"
            ]
          },
          "200030103": {
            "id": "200030103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么急事吗？",
            "nextDialogs": [
              "200030104"
            ]
          },
          "200030104": {
            "id": "200030104",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "旅行者？唉…也不能算是急事，但我是真的操办不过来了…",
            "nextDialogs": [
              "200030105"
            ]
          },
          "200030105": {
            "id": "200030105",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "你也知道，那群愚人众把我的酒店给包下来了吧。",
            "nextDialogs": [
              "200030106"
            ]
          },
          "200030106": {
            "id": "200030106",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "他们包下了酒店之后，我作为「歌德大酒店」的老板，自然也得在旁边照应着。",
            "nextDialogs": [
              "200030107"
            ]
          },
          "200030107": {
            "id": "200030107",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "帮着联系食材供应商，物件坏了及时叫人去修，还有一些杂七杂八的事。",
            "nextDialogs": [
              "200030108"
            ]
          },
          "200030108": {
            "id": "200030108",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "最近酒店里有几间屋子的桌椅坏了，我得赶紧去联系人，把合适的木材送去给木匠。",
            "nextDialogs": [
              "200030109"
            ]
          },
          "200030109": {
            "id": "200030109",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "还有城里几间屋子的租金没收…玛文那小子又成天不见影子。",
            "nextDialogs": [
              "200030110"
            ]
          },
          "200030110": {
            "id": "200030110",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "唉，也不知道我这把老骨头能折腾几年，玛文到底什么时候才能懂事点呢…",
            "nextDialogs": [
              "200030113"
            ]
          },
          "200030113": {
            "id": "200030113",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "你，你愿意帮我吗？唉，真的太麻烦你了，玛文那小子要是有你一半懂事，我也不会累成这样…",
            "nextDialogs": [
              "200030114"
            ]
          },
          "200030114": {
            "id": "200030114",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "那就麻烦你，先帮我去拿一份杉木和一份桦木回来吧，我要赶紧把这些木材交给木匠了。"
          }
        }
      }
    },
    {
      "subId": "2000302",
      "subQuestName": "将木材带给歌德",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030201"
        ],
        "dialogs": {
          "200030201": {
            "id": "200030201",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "你拿到木材了吗？只要一份杉木和一份桦木就好了。"
          }
        }
      }
    },
    {
      "subId": "2000303",
      "subQuestName": "与歌德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030301"
        ],
        "dialogs": {
          "200030301": {
            "id": "200030301",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "谢谢你，这些木材就够了，我这就拿去给木匠…对了，还得去收房租才行…",
            "nextDialogs": [
              "200030302"
            ]
          },
          "200030302": {
            "id": "200030302",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "唉，也不知道那个…阿斯…阿斯…什么莫娜…这次在不在家…",
            "nextDialogs": [
              "200030303"
            ]
          },
          "200030303": {
            "id": "200030303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是阿斯托洛吉斯·莫娜·梅姬斯图斯。",
            "nextDialogs": [
              "200030304"
            ]
          },
          "200030304": {
            "id": "200030304",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "对！就是这个名字，哎哟…我是真的记不住。",
            "nextDialogs": [
              "200030305"
            ]
          },
          "200030305": {
            "id": "200030305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？莫娜还没交房租吗？",
            "nextDialogs": [
              "200030306"
            ]
          },
          "200030306": {
            "id": "200030306",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "可不是嘛，其他的租客都把房租交了，就剩她了。",
            "nextDialogs": [
              "200030307"
            ]
          },
          "200030307": {
            "id": "200030307",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "我跑了好几趟了，但她一直都不在家。",
            "nextDialogs": [
              "200030308"
            ]
          },
          "200030308": {
            "id": "200030308",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "旅行者，请你帮我跑一趟，去催催她交房租吧。"
          }
        }
      }
    },
    {
      "subId": "2000304",
      "subQuestName": "与歌德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {

      }
    },
    {
      "subId": "2000306",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030601"
        ],
        "dialogs": {
          "200030601": {
            "id": "200030601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "骑士团里的图书馆。",
            "nextDialogs": [
              "200030602"
            ]
          },
          "200030602": {
            "id": "200030602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "图书馆啊…嗯！骑士团的图书馆特别大，莫娜说不定会去那边查资料呢。",
            "nextDialogs": [
              "200030603"
            ]
          },
          "200030603": {
            "id": "200030603",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我们就过去看看吧！"
          }
        }
      }
    },
    {
      "subId": "2000307",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030701"
        ],
        "dialogs": {
          "200030701": {
            "id": "200030701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能买到沙拉的猎鹿人。",
            "nextDialogs": [
              "200030702"
            ]
          },
          "200030702": {
            "id": "200030702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "猎鹿人…嗯…说不定莫娜会去买沙拉吃呢。我们过去看看吧。",
            "nextDialogs": [
              "200030703"
            ]
          },
          "200030703": {
            "id": "200030703",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "希望莫娜最近手里的钱够买沙拉的…"
          }
        }
      }
    },
    {
      "subId": "2000308",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030801"
        ],
        "dialogs": {
          "200030801": {
            "id": "200030801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "直接去问问凯瑟琳。",
            "nextDialogs": [
              "200030802"
            ]
          },
          "200030802": {
            "id": "200030802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "去问凯瑟琳小姐啊…也对，凯瑟琳小姐什么都知道，问她准没错。",
            "nextDialogs": [
              "200030803"
            ]
          },
          "200030803": {
            "id": "200030803",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我们赶紧去问问她吧。"
          }
        }
      }
    },
    {
      "subId": "2000305",
      "subQuestName": "拜访莫娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2000309",
      "subQuestName": "去图书馆寻找莫娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030901"
        ],
        "dialogs": {
          "200030901": {
            "id": "200030901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "图书馆里好像没见到莫娜呢，丽莎小姐也不在。",
            "nextDialogs": [
              "200030902"
            ]
          },
          "200030902": {
            "id": "200030902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们去问问门口的那位西风骑士，看看他有没有见过莫娜吧。"
          }
        }
      }
    },
    {
      "subId": "2000310",
      "subQuestName": "向威拉格询问莫娜的去向",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200031001"
        ],
        "dialogs": {
          "200031001": {
            "id": "200031001",
            "speakerId": 1002,
            "speakerName": "威拉格",
            "text": "你好，有什么能为你效劳的吗？",
            "nextDialogs": [
              "200031002"
            ]
          },
          "200031002": {
            "id": "200031002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问你见过一个这样的女孩吗…",
            "nextDialogs": [
              "200031003"
            ]
          },
          "200031003": {
            "id": "200031003",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "（旅行者向威拉格描述了莫娜的外貌特点…）",
            "nextDialogs": [
              "200031004"
            ]
          },
          "200031004": {
            "id": "200031004",
            "speakerId": 1002,
            "speakerName": "威拉格",
            "text": "噢！你说她啊，我记得，那个帽子很大的女孩。",
            "nextDialogs": [
              "200031005"
            ]
          },
          "200031005": {
            "id": "200031005",
            "speakerId": 1002,
            "speakerName": "威拉格",
            "text": "她经常过来图书馆查资料，一查就是一天，我印象很深的。",
            "nextDialogs": [
              "200031006"
            ]
          },
          "200031006": {
            "id": "200031006",
            "speakerId": 1002,
            "speakerName": "威拉格",
            "text": "不过，最近她倒是没怎么来图书馆了，你们来这里应该是找不到她了…",
            "nextDialogs": [
              "200031007"
            ]
          },
          "200031007": {
            "id": "200031007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "来晚了啊…",
            "nextDialogs": [
              "200031008"
            ]
          },
          "200031008": {
            "id": "200031008",
            "speakerId": 1002,
            "speakerName": "威拉格",
            "text": "她要是再来的话，我会告诉她你们在找她的。",
            "nextDialogs": [
              "200031009"
            ]
          },
          "200031009": {
            "id": "200031009",
            "speakerId": 1002,
            "speakerName": "威拉格",
            "text": "不过，我也就能帮你这个忙了…",
            "nextDialogs": [
              "200031010"
            ]
          },
          "200031010": {
            "id": "200031010",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢你。",
            "nextDialogs": [
              "200031011"
            ]
          },
          "200031011": {
            "id": "200031011",
            "speakerId": 1002,
            "speakerName": "威拉格",
            "text": "小事，不用客气。",
            "nextDialogs": [
              "200031012"
            ]
          },
          "200031012": {
            "id": "200031012",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来莫娜不在图书馆啊，没办法，只能告诉歌德先生，我们今天没找到莫娜了…"
          }
        }
      }
    },
    {
      "subId": "2000311",
      "subQuestName": "去猎鹿人餐馆寻找莫娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200031101"
        ],
        "dialogs": {
          "200031101": {
            "id": "200031101",
            "speakerId": 1004,
            "speakerName": "莎拉",
            "text": "你好！有什么想吃的吗？",
            "nextDialogs": [
              "200031102"
            ]
          },
          "200031102": {
            "id": "200031102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问你见过一个这样的女孩吗…",
            "nextDialogs": [
              "200031103"
            ]
          },
          "200031103": {
            "id": "200031103",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "（旅行者向莎拉描述了莫娜的外貌特点…）",
            "nextDialogs": [
              "200031104"
            ]
          },
          "200031104": {
            "id": "200031104",
            "speakerId": 1004,
            "speakerName": "莎拉",
            "text": "你说莫娜啊，唔…她前段时间确实每天晚上都会来买沙拉，有时候还会拜托我往沙拉里多加点蛋。",
            "nextDialogs": [
              "200031105"
            ]
          },
          "200031105": {
            "id": "200031105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "莫娜，还是一如既往地没钱啊…",
            "nextDialogs": [
              "200031106"
            ]
          },
          "200031106": {
            "id": "200031106",
            "speakerId": 1004,
            "speakerName": "莎拉",
            "text": "但最近，她已经连续好几天没来了。",
            "nextDialogs": [
              "200031107"
            ]
          },
          "200031107": {
            "id": "200031107",
            "speakerId": 1004,
            "speakerName": "莎拉",
            "text": "如果你们急着找她，那等她下次来买沙拉的时候，我可以帮你们告诉她一声。",
            "nextDialogs": [
              "200031108"
            ]
          },
          "200031108": {
            "id": "200031108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢你。",
            "nextDialogs": [
              "200031109"
            ]
          },
          "200031109": {
            "id": "200031109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来莫娜最近也没有来过猎鹿人呢。唔…只能回去告诉歌德先生，我们今天没找到莫娜了…"
          }
        }
      }
    },
    {
      "subId": "2000312",
      "subQuestName": "向凯瑟琳询问莫娜的去向",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200031201"
        ],
        "dialogs": {
          "200031201": {
            "id": "200031201",
            "speakerId": 1005,
            "speakerName": "凯瑟琳",
            "text": "您好，请问有什么事吗？",
            "nextDialogs": [
              "200031202"
            ]
          },
          "200031202": {
            "id": "200031202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问你最近见过莫娜吗？",
            "nextDialogs": [
              "200031203"
            ]
          },
          "200031203": {
            "id": "200031203",
            "speakerId": 1005,
            "speakerName": "凯瑟琳",
            "text": "莫娜？唔…我最近还真没见过她…",
            "nextDialogs": [
              "200031204"
            ]
          },
          "200031204": {
            "id": "200031204",
            "speakerId": 1005,
            "speakerName": "凯瑟琳",
            "text": "如果你们急着找她的话，就在冒险家协会挂个委托吧。",
            "nextDialogs": [
              "200031205"
            ]
          },
          "200031205": {
            "id": "200031205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢，我们自己再去找找吧。",
            "nextDialogs": [
              "200031206"
            ]
          },
          "200031206": {
            "id": "200031206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来，凯瑟琳小姐不知道莫娜的去向呢。只能告诉歌德先生，我们今天没找到莫娜了…"
          }
        }
      }
    },
    {
      "subId": "2000313",
      "subQuestName": "向歌德回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200031301"
        ],
        "dialogs": {
          "200031301": {
            "id": "200031301",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "怎么样，你们找到那位…呃…你们的那位朋友了吗？",
            "nextDialogs": [
              "200031302"
            ]
          },
          "200031302": {
            "id": "200031302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她好像今天不在家。",
            "nextDialogs": [
              "200031303"
            ]
          },
          "200031303": {
            "id": "200031303",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "好吧…她欠的租金倒也不多，那就再缓几天。",
            "nextDialogs": [
              "200031304"
            ]
          },
          "200031304": {
            "id": "200031304",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "这些报酬请你们收下吧，谢谢你们帮忙了。"
          }
        }
      }
    },
    {
      "subId": "2000304",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030401"
        ],
        "dialogs": {
          "200030401": {
            "id": "200030401",
            "speakerId": 1000,
            "speakerName": "歌德",
            "text": "阿斯…阿斯托洛…什么来着…"
          }
        }
      }
    },
    {
      "subId": "2000305",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200030501"
        ],
        "dialogs": {
          "200030501": {
            "id": "200030501",
            "speakerId": 1001,

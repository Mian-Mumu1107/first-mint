  "subQuests": [
    {
      "subId": "1111001",
      "subQuestName": "前往无妄坡",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111100101"
        ],
        "dialogs": {
          "111100101": {
            "id": "111100101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "为、为什么我们要到这里来？我有一种很不好的预感。",
            "nextDialogs": [
              "111100102"
            ]
          },
          "111100102": {
            "id": "111100102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我没有在害怕，我只是在担心你的安全。",
            "nextDialogs": [
              "111100103"
            ]
          },
          "111100103": {
            "id": "111100103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你看，恐怖故事里面经常有这样的桥段，荒郊野岭，光线微弱，在黑暗之中，突然冒出一个人影——",
            "nextDialogs": [
              "111100104"
            ]
          },
          "111100104": {
            "id": "111100104",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "啊…？",
            "nextDialogs": [
              "111100105"
            ]
          },
          "111100105": {
            "id": "111100105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#呜哇啊啊啊——！{NICKNAME}，你快想想办法！",
            "nextDialogs": [
              "111100108"
            ]
          },
          "111100108": {
            "id": "111100108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我的直觉告诉我，在这里遇见的，都不会是普通人！",
            "nextDialogs": [
              "111100109"
            ]
          },
          "111100109": {
            "id": "111100109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "如果被他搭话，说不定会被吃掉！",
            "nextDialogs": [
              "111100110"
            ]
          },
          "111100110": {
            "id": "111100110",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "你、你们是谁？"
          }
        }
      }
    },
    {
      "subId": "1111002",
      "subQuestName": "追上逃走的老孟",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1111003",
      "subQuestName": "向老孟阐明误会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111100301"
        ],
        "dialogs": {
          "111100301": {
            "id": "111100301",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "堂主，堂主，有鬼追过来了！",
            "nextDialogs": [
              "111100302"
            ]
          },
          "111100302": {
            "id": "111100302",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "哦？",
            "nextDialogs": [
              "111100303"
            ]
          },
          "111100303": {
            "id": "111100303",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "#哦~别大惊小怪，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}们不是鬼，只是普通的客人。",
            "nextDialogs": [
              "111100304"
            ]
          },
          "111100304": {
            "id": "111100304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对啊！说了不是鬼啦，为什么不冷静下来听我们解释。",
            "nextDialogs": [
              "111100305"
            ]
          },
          "111100305": {
            "id": "111100305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但是，好像说客人也不太对…",
            "nextDialogs": [
              "111100306"
            ]
          },
          "111100306": {
            "id": "111100306",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "不好意思，他是我们这里新来的仪倌，名叫老孟，第一次来这边做葬仪，难免会有点疑神疑鬼。",
            "nextDialogs": [
              "111100307"
            ]
          },
          "111100307": {
            "id": "111100307",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "葬仪，葬仪…哦！钟离当客卿的那个「往生堂」，不就是专门做这种工作的吗？",
            "nextDialogs": [
              "111100308"
            ]
          },
          "111100308": {
            "id": "111100308",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "唔？没想到你们还认识钟离呀，那我解释起来也省事多了。",
            "nextDialogs": [
              "111100309"
            ]
          },
          "111100309": {
            "id": "111100309",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "我是胡桃，往生堂的当代堂主，具体掌管的…嗯，就是些生离死别的小事。",
            "nextDialogs": [
              "111100310"
            ]
          },
          "111100310": {
            "id": "111100310",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "不过，我很喜欢这门生意，往生堂也是老字号了，无论有什么需求，都可以说来听听。",
            "nextDialogs": [
              "111100311"
            ]
          },
          "111100311": {
            "id": "111100311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们不是客人。",
            "nextDialogs": [
              "111100312"
            ]
          },
          "111100312": {
            "id": "111100312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "就是，就是。就算我们有事情要找往生堂，也不会跑到这里来嘛。",
            "nextDialogs": [
              "111100313"
            ]
          },
          "111100313": {
            "id": "111100313",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "哎呀，我不是说上门和我谈生意的「客人」，每个人在诞生到这个世界上的时候，就注定了是我的「客人」。",
            "nextDialogs": [
              "111100314"
            ]
          },
          "111100314": {
            "id": "111100314",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "就算现在不是，迟早都会是的。",
            "nextDialogs": [
              "111100315"
            ]
          },
          "111100315": {
            "id": "111100315",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸、欸…？",
            "nextDialogs": [
              "111100316"
            ]
          },
          "111100316": {
            "id": "111100316",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "往生堂非常欢迎预定服务，我们是你后顾无忧的最佳选择。",
            "nextDialogs": [
              "111100317"
            ]
          },
          "111100317": {
            "id": "111100317",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "不过，预定时间还得准一些。否则，得多花好多力气呢！",
            "nextDialogs": [
              "111100318"
            ]
          },
          "111100318": {
            "id": "111100318",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "要是决定不了，至少也先来和我说一声。不然到时候看见你还活蹦乱跳的，我会很失望哦。",
            "nextDialogs": [
              "111100319"
            ]
          },
          "111100319": {
            "id": "111100319",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "等一下等一下，等一下！",
            "nextDialogs": [
              "111100320"
            ]
          },
          "111100320": {
            "id": "111100320",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个，那个，我究竟要从什么地方开始问？",
            "nextDialogs": [
              "111100323"
            ]
          },
          "111100323": {
            "id": "111100323",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "不好意思，堂主是个很特别的人，还是让我来解释吧。",
            "nextDialogs": [
              "111100324"
            ]
          },
          "111100324": {
            "id": "111100324",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "我们听说无妄坡最近有灵异事件发生，为了平息影响，我们刚刚在这里进行了一场葬仪。",
            "nextDialogs": [
              "111100325"
            ]
          },
          "111100325": {
            "id": "111100325",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "葬仪本身很顺利，按照堂主的说法，至少短期之内不会有问题了。",
            "nextDialogs": [
              "111100326"
            ]
          },
          "111100326": {
            "id": "111100326",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "往生堂，无妄坡，葬仪，这三个词放在一起，非常自然嘛，我想不出来有什么解释的必要。",
            "nextDialogs": [
              "111100327"
            ]
          },
          "111100327": {
            "id": "111100327",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "倒是你们，无缘无故到无妄坡来，反倒没有那么正常了。",
            "nextDialogs": [
              "111100328"
            ]
          },
          "111100328": {
            "id": "111100328",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你对「正常」的理解相当不正常。",
            "nextDialogs": [
              "111100329"
            ]
          },
          "111100329": {
            "id": "111100329",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我是来冒险的。",
            "nextDialogs": [
              "111100330"
            ]
          },
          "111100330": {
            "id": "111100330",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "冒险？哦，我猜，你应该是冒险家协会的成员吧。",
            "nextDialogs": [
              "111100331"
            ]
          },
          "111100331": {
            "id": "111100331",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "看来不只是客人，还是罕见的「桃」级贵客。",
            "nextDialogs": [
              "111100332"
            ]
          },
          "111100332": {
            "id": "111100332",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「桃」级？那又是什么？",
            "nextDialogs": [
              "111100333"
            ]
          },
          "111100333": {
            "id": "111100333",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "就是客人的重要度划分，分为「胡」「桃」「竹」「木」四级，往往级别越高，往来就越密切。",
            "nextDialogs": [
              "111100334"
            ]
          },
          "111100334": {
            "id": "111100334",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "这种分级就连我都是第一次听说？！",
            "nextDialogs": [
              "111100335"
            ]
          },
          "111100335": {
            "id": "111100335",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "因为是我今天刚想出来的，没必要这么惊讶吧。",
            "nextDialogs": [
              "111100336"
            ]
          },
          "111100336": {
            "id": "111100336",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "你想想看，冒险家天天翻山越岭，探索秘境，经历各种各样的战斗，难免遇到危险和意外。",
            "nextDialogs": [
              "111100337"
            ]
          },
          "111100337": {
            "id": "111100337",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "对这样的客人重点照顾，时常关照，对他们也好，对我也好。"
          }
        }
      }
    },
    {
      "subId": "1111004",
      "subQuestName": "陪同胡桃前往冒险家协会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111100401"
        ],
        "dialogs": {
          "111100401": {
            "id": "111100401",
            "speakerId": 1004,
            "speakerName": "岚姐",
            "text": "啊，又是你，说了这种合作我们没有兴趣。",
            "nextDialogs": [
              "111100402"
            ]
          },
          "111100402": {
            "id": "111100402",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "别着急嘛，你看，你们冒险家协会里面有深刻同意我的说法的人在！",
            "nextDialogs": [
              "111100405"
            ]
          },
          "111100405": {
            "id": "111100405",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "是这样的，上次跟你们谈完，我做了新的方案，追加了相当划算的内容。",
            "nextDialogs": [
              "111100406"
            ]
          },
          "111100406": {
            "id": "111100406",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "具体来说，往生堂会优先处理冒险家协会的请求，而且第一批会赠送一百个特制的木盒。",
            "nextDialogs": [
              "111100407"
            ]
          },
          "111100407": {
            "id": "111100407",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "还有还有！我们支持现场回收服务！业务范围覆盖璃月绝大部分地区，个别凶险地带要追加收费，啊——你可以放心，很便宜哦！",
            "nextDialogs": [
              "111100408"
            ]
          },
          "111100408": {
            "id": "111100408",
            "speakerId": 1004,
            "speakerName": "岚姐",
            "text": "我觉得…你完全没明白我的意思。",
            "nextDialogs": [
              "111100409"
            ]
          },
          "111100409": {
            "id": "111100409",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "明白明白，我知道你想讨价还价，不过我们往生堂给出的优惠力度已经很大了哦？",
            "nextDialogs": [
              "111100410"
            ]
          },
          "111100410": {
            "id": "111100410",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "你想想看，出门在外，难免遭遇危险，有个词叫「未雨绸缪」，说的就是这种事嘛。",
            "nextDialogs": [
              "111100411"
            ]
          },
          "111100411": {
            "id": "111100411",
            "speakerId": 1004,
            "speakerName": "岚姐",
            "text": "从来没听说过抢先在这种事情上做准备。",
            "nextDialogs": [
              "111100412"
            ]
          },
          "111100412": {
            "id": "111100412",
            "speakerId": 1004,
            "speakerName": "岚姐",
            "text": "就算要准备，也是去准备和冒险安全有关的事。",
            "nextDialogs": [
              "111100413"
            ]
          },
          "111100413": {
            "id": "111100413",
            "speakerId": 1004,
            "speakerName": "岚姐",
            "text": "请回吧，我还有很多事情要忙。",
            "nextDialogs": [
              "111100414"
            ]
          },
          "111100414": {
            "id": "111100414",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "喂喂，等等！那、那再打个折怎么样！如果一次满十个人可以有七折优惠！",
            "nextDialogs": [
              "111100415"
            ]
          },
          "111100415": {
            "id": "111100415",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "堂主！可以了，可以了，再这样下去千岩军又要来了。",
            "nextDialogs": [
              "111100416"
            ]
          },
          "111100416": {
            "id": "111100416",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我没理解错的话，她好像在试图推销往生堂的服务。"
          }
        }
      }
    },
    {
      "subId": "1111005",
      "subQuestName": "与胡桃一起回到往生堂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111100501"
        ],
        "dialogs": {
          "111100501": {
            "id": "111100501",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "唉，这样一来，老办法还是要继续用啊。",
            "nextDialogs": [
              "111100502"
            ]
          },
          "111100502": {
            "id": "111100502",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "老孟，让你写的广告词写完了吗？",
            "nextDialogs": [
              "111100503"
            ]
          },
          "111100503": {
            "id": "111100503",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "啊…不好意思，写了一半。但是这种奇怪的广告词真的有用吗？",
            "nextDialogs": [
              "111100504"
            ]
          },
          "111100504": {
            "id": "111100504",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "相信我，用处很大，这可是往生堂代代相传的业务方式。",
            "nextDialogs": [
              "111100505"
            ]
          },
          "111100505": {
            "id": "111100505",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "有需要的客人会到往生堂门前，取下空白的木牌，写上委托内容之后，从门缝塞到堂内。",
            "nextDialogs": [
              "111100506"
            ]
          },
          "111100506": {
            "id": "111100506",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "根据牌子上的要求，无论是讣告，火化还是葬仪，我都会做到让客人十分满意。",
            "nextDialogs": [
              "111100507"
            ]
          },
          "111100507": {
            "id": "111100507",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "虽说确实有些麻烦…老是跑来跑去的。要是能一次多烧几个…",
            "nextDialogs": [
              "111100508"
            ]
          },
          "111100508": {
            "id": "111100508",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "不是的，堂主，我不是在问木牌，而是「广告词」的事。",
            "nextDialogs": [
              "111100511"
            ]
          },
          "111100511": {
            "id": "111100511",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "哼哼，往生堂的生意应该与时俱进才对！你想啊，往生堂的客人，如果不一直去拓展，是不是就会越来越少？",
            "nextDialogs": [
              "111100512"
            ]
          },
          "111100512": {
            "id": "111100512",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "拓展，是非常重要的工作内容，自从我当上堂主，为了让往生堂更加兴旺，我试过很多办法。",
            "nextDialogs": [
              "111100513"
            ]
          },
          "111100513": {
            "id": "111100513",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "我试过像其他店家一样张贴广告，却被千岩军清了个干干净净。",
            "nextDialogs": [
              "111100514"
            ]
          },
          "111100514": {
            "id": "111100514",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "后来我又举办了「往生一日体验会」，结果也没人参加。",
            "nextDialogs": [
              "111100515"
            ]
          },
          "111100515": {
            "id": "111100515",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那不是理所当然的嘛…",
            "nextDialogs": [
              "111100516"
            ]
          },
          "111100516": {
            "id": "111100516",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "最后的最后，我发现，还是传统方法最实用，这就是历代堂主的智慧吧！",
            "nextDialogs": [
              "111100517"
            ]
          },
          "111100517": {
            "id": "111100517",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "我挨家挨户探访，寻找可能合作的人与组织，就像刚刚找上冒险家协会那样！这种事，我叫它「业务拓展」。",
            "nextDialogs": [
              "111100518"
            ]
          },
          "111100518": {
            "id": "111100518",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "还有个办法，就是在木牌上写广告，「凭此木牌，购一送一」之类的。",
            "nextDialogs": [
              "111100519"
            ]
          },
          "111100519": {
            "id": "111100519",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "购…购什么送什么？",
            "nextDialogs": [
              "111100520"
            ]
          },
          "111100520": {
            "id": "111100520",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "嘿嘿，当然是坚固耐用的「另一个家」啦。",
            "nextDialogs": [
              "111100521"
            ]
          },
          "111100521": {
            "id": "111100521",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "现在用不上没关系，往生堂出品，品质有保证，不用担心它会比你先坏掉。"
          }
        }
      }
    },
    {
      "subId": "1111006",
      "subQuestName": "调查往生堂周围，等待胡桃",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111101301"
        ],
        "dialogs": {
          "111101301": {
            "id": "111101301",
            "speakerId": 1005,
            "speakerName": "观察木板",
            "text": "（往生堂门前用来挂置木牌的牌架，按胡桃的说法，木牌都应该是空白的…）",
            "nextDialogs": [
              "111101302"
            ]
          },
          "111101302": {
            "id": "111101302",
            "speakerId": 1005,
            "speakerName": "观察木板",
            "text": "（那木牌背后的字，就是所谓的「广告词」吧。）"
          }
        }
      }
    },
    {
      "subId": "1111011",
      "subQuestName": "调查往生堂周围，等待胡桃",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111101401"
        ],
        "dialogs": {
          "111101401": {
            "id": "111101401",
            "speakerId": 1006,
            "speakerName": "观察房门",
            "text": "（这里面就是往生堂吧…）",
            "nextDialogs": [
              "111101402"
            ]
          },
          "111101402": {
            "id": "111101402",
            "speakerId": 1006,
            "speakerName": "观察房门",
            "text": "（看起来，好像比堂主给人的感觉要正常不少。）"
          }
        }
      }
    },
    {
      "subId": "1111012",
      "subQuestName": "调查往生堂周围，等待胡桃",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111101501"
        ],
        "dialogs": {
          "111101501": {
            "id": "111101501",
            "speakerId": 1007,
            "speakerName": "摆渡人",
            "text": "你们，是堂主带来的新人吗？",
            "nextDialogs": [
              "111101502"
            ]
          },
          "111101502": {
            "id": "111101502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不是啦，只是对往生堂和胡桃都很好奇。",
            "nextDialogs": [
              "111101503"
            ]
          },
          "111101503": {
            "id": "111101503",
            "speakerId": 1007,
            "speakerName": "摆渡人",
            "text": "既然如此，还是不要太好奇为好，普通人知道得太多，并不是件好事。",
            "nextDialogs": [
              "111101504"
            ]
          },
          "111101504": {
            "id": "111101504",
            "speakerId": 1007,
            "speakerName": "摆渡人",
            "text": "什么可以知道，什么不能知道，堂主自有分寸。",
            "nextDialogs": [
              "111101505"
            ]
          },
          "111101505": {
            "id": "111101505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那个人，真的知道「分寸」吗？"
          }
        }
      }
    },
    {
      "subId": "1111007",
      "subQuestName": "再次与胡桃交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111100701"
        ],
        "dialogs": {
          "111100701": {
            "id": "111100701",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "嗯，就这样吧，交给你了，就按这个写。",
            "nextDialogs": [
              "111100702"
            ]
          },
          "111100702": {
            "id": "111100702",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "「往生堂定时大酬宾，购一送一，购二送三，多购多得！」",
            "nextDialogs": [
              "111100703"
            ]
          },
          "111100703": {
            "id": "111100703",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "嘿嘿，我很满意，比原来冰冰凉凉的宣传词好多了！一定能打动人心！",
            "nextDialogs": [
              "111100704"
            ]
          },
          "111100704": {
            "id": "111100704",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "堂主…做葬仪的组织，一般印象就应该是冰冰凉凉的吧。",
            "nextDialogs": [
              "111100705"
            ]
          },
          "111100705": {
            "id": "111100705",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "那就没有耳目一新的感觉了，不行。",
            "nextDialogs": [
              "111100706"
            ]
          },
          "111100706": {
            "id": "111100706",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "为什么往生堂需要耳目一新…呃，算了，也好吧。",
            "nextDialogs": [
              "111100707"
            ]
          },
          "111100707": {
            "id": "111100707",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看来他已经放弃抵抗了。",
            "nextDialogs": [
              "111100708"
            ]
          },
          "111100708": {
            "id": "111100708",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "好了，我们也该重新出发了，我可不想错过新生意。",
            "nextDialogs": [
              "111100709"
            ]
          },
          "111100709": {
            "id": "111100709",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「我们」…是在说，我们吗？",
            "nextDialogs": [
              "111100710"
            ]
          },
          "111100710": {
            "id": "111100710",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "不然还有谁？你看看周围，难道有什么奇怪的人吗？就算有，你也看不见嘛。",
            "nextDialogs": [
              "111100711"
            ]
          },
          "111100711": {
            "id": "111100711",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "最后一句话可以不用加！很吓人的！",
            "nextDialogs": [
              "111100712"
            ]
          },
          "111100712": {
            "id": "111100712",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "嘿嘿，对不起，我开玩笑的。我保证，你们看不见的东西也没有，至少，现在没有。",
            "nextDialogs": [
              "111100715"
            ]
          },
          "111100715": {
            "id": "111100715",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "别这么严肃嘛，从我的角度来说，我只是觉得大家都把死亡想得太可怕了。",
            "nextDialogs": [
              "111100716"
            ]
          },
          "111100716": {
            "id": "111100716",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "人们都害怕生离死别，怕的是痛苦与遗憾，为了弥补心中的创伤，擅自为死亡想象出了无数种形态，比如幽灵啦，厉鬼啦。",
            "nextDialogs": [
              "111100717"
            ]
          },
          "111100717": {
            "id": "111100717",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "明明都无凭无据，时至今日，却变成了无法触及的禁忌话题。如果我也忌讳这种事，那往生堂都开不下去了嘛。",
            "nextDialogs": [
              "111100718"
            ]
          },
          "111100718": {
            "id": "111100718",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可我见过幽灵。",
            "nextDialogs": [
              "111100719"
            ]
          },
          "111100719": {
            "id": "111100719",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "哦？怎么样，比想象中要友善和通情达理对吧？",
            "nextDialogs": [
              "111100720"
            ]
          },
          "111100720": {
            "id": "111100720",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "和这两个词没什么关系，只能说最后确实没有伤到我们…",
            "nextDialogs": [
              "111100721"
            ]
          },
          "111100721": {
            "id": "111100721",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "那你们遇见的已经是相当凶恶的家伙了，怎么说呢？一般的幽灵是没有能力伤害普通人的。",
            "nextDialogs": [
              "111100722"
            ]
          },
          "111100722": {
            "id": "111100722",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "往生堂的工作，是「维护生死的边界」，其中就包括纠正普通人对死亡和鬼怪的认知，简单来说，就是让看不到「边界」的人，离它越远越好。",
            "nextDialogs": [
              "111100723"
            ]
          },
          "111100723": {
            "id": "111100723",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "所以对普通人来说，最好的状态就是不知道幽灵鬼怪的事，或者认为它们根本不存在。",
            "nextDialogs": [
              "111100724"
            ]
          },
          "111100724": {
            "id": "111100724",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那你就更不应该用诡异的玩笑吓唬别人了。",
            "nextDialogs": [
              "111100725"
            ]
          },
          "111100725": {
            "id": "111100725",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "哈哈哈，哪有你说得这么恶劣，我只是想让他们快点理解「这都只是玩笑」嘛。"
          }
        }
      }
    },
    {
      "subId": "1111008",
      "subQuestName": "与胡桃一起拜访「潜在客户」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111100801"
        ],
        "dialogs": {
          "111100801": {
            "id": "111100801",
            "speakerId": 1008,
            "speakerName": "小五",
            "text": "请问你们是？",
            "nextDialogs": [
              "111100802"
            ]
          },
          "111100802": {
            "id": "111100802",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "你好，我是往生堂的堂主，胡桃。",
            "nextDialogs": [
              "111100803"
            ]
          },
          "111100803": {
            "id": "111100803",
            "speakerId": 1008,
            "speakerName": "小五",
            "text": "往生堂的人，为什么要找我？",
            "nextDialogs": [
              "111100804"
            ]
          },
          "111100804": {
            "id": "111100804",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "嗯…也没有什么特别的理由，想问问你最近身体可好，有没有什么地方不舒服？",
            "nextDialogs": [
              "111100805"
            ]
          },
          "111100805": {
            "id": "111100805",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "身体不舒服可是要紧事，很可能是严重病症的预兆。",
            "nextDialogs": [
              "111100806"
            ]
          },
          "111100806": {
            "id": "111100806",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "人在健康的时候，很难想象生命究竟是有多脆弱，所以对这种预兆，往往会不够重视。",
            "nextDialogs": [
              "111100807"
            ]
          },
          "111100807": {
            "id": "111100807",
            "speakerId": 1008,
            "speakerName": "小五",
            "text": "听不懂你在说什么！我身体健康，生活幸福，一切都很好！",
            "nextDialogs": [
              "111100808"
            ]
          },
          "111100808": {
            "id": "111100808",
            "speakerId": 1008,
            "speakerName": "小五",
            "text": "不用来找我了，再见！"
          }
        }
      }
    },
    {
      "subId": "1111009",
      "subQuestName": "继续拜访「潜在客户」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111100901"
        ],
        "dialogs": {
          "111100901": {
            "id": "111100901",
            "speakerId": 1009,
            "speakerName": "木木",
            "text": "啊，你是谁？长话短说吧，我现在很忙。",
            "nextDialogs": [
              "111100902"
            ]
          },
          "111100902": {
            "id": "111100902",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "你好，有没有兴趣了解一下往生堂的业务呢？",
            "nextDialogs": [
              "111100903"
            ]
          },
          "111100903": {
            "id": "111100903",
            "speakerId": 1009,
            "speakerName": "木木",
            "text": "往生堂？呃…我没有这种需求。",
            "nextDialogs": [
              "111100904"
            ]
          },
          "111100904": {
            "id": "111100904",
            "speakerId": 1009,
            "speakerName": "木木",
            "text": "不过，你是出来拉客的吗？这种方式是不是太粗暴了。",
            "nextDialogs": [
              "111100905"
            ]
          },
          "111100905": {
            "id": "111100905",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "会吗？现在做生意流行的说法，不就是「把服务呈现到每一个客人的面前」吗？",
            "nextDialogs": [
              "111100906"
            ]
          },
          "111100906": {
            "id": "111100906",
            "speakerId": 1009,
            "speakerName": "木木",
            "text": "但…有些服务的性质太特殊，应该不能算在…",
            "nextDialogs": [
              "111100907"
            ]
          },
          "111100907": {
            "id": "111100907",
            "speakerId": 1009,
            "speakerName": "木木",
            "text": "呃…总之，拜托，你去找其他人吧。"
          }
        }
      }
    },
    {
      "subId": "1111010",
      "subQuestName": "继续拜访「潜在客户」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111101001"
        ],
        "dialogs": {
          "111101001": {
            "id": "111101001",
            "speakerId": 1010,
            "speakerName": "聪子",
            "text": "我记得你是…往生堂的堂主对吧？不好意思，我真的不需要…",
            "nextDialogs": [
              "111101002"
            ]
          },
          "111101002": {
            "id": "111101002",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "没关系，了解一下嘛，我们最近推出了新的优惠活动。",
            "nextDialogs": [
              "111101003"
            ]
          },
          "111101003": {
            "id": "111101003",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "俗话说「旧的不去新的不来」，一个圆满的句号标志着一段新的旅途的开始…",
            "nextDialogs": [
              "111101004"
            ]
          },
          "111101004": {
            "id": "111101004",
            "speakerId": 1010,
            "speakerName": "聪子",
            "text": "如果再纠缠不清的话，我就要叫千岩军来了。",
            "nextDialogs": [
              "111101005"
            ]
          },
          "111101005": {
            "id": "111101005",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "别别别，我知道了，你冷静一点。",
            "nextDialogs": [
              "111101006"
            ]
          },
          "111101006": {
            "id": "111101006",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "但是往生堂依然欢迎你的光临哦。",
            "nextDialogs": [
              "111101007"
            ]
          },
          "111101007": {
            "id": "111101007",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你还不准备放弃吗？",
            "nextDialogs": [
              "111101010"
            ]
          },
          "111101010": {
            "id": "111101010",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "欸？你们是在安慰我吗？",
            "nextDialogs": [
              "111101011"
            ]
          },
          "111101011": {
            "id": "111101011",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "谢谢你们，还是你们最理解我的想法！",
            "nextDialogs": [
              "111101012"
            ]
          },
          "111101012": {
            "id": "111101012",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不，只是不想经历更多的尴尬。",
            "nextDialogs": [
              "111101013"
            ]
          },
          "111101013": {
            "id": "111101013",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「业务拓展」结束，该帮我找人了。",
            "nextDialogs": [
              "111101014"
            ]
          },
          "111101014": {
            "id": "111101014",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "「业务拓展」？嗯？「业务拓展」…",
            "nextDialogs": [
              "111101015"
            ]
          },
          "111101015": {
            "id": "111101015",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "啊？难不成你们刚刚以为我是在「业务拓展」？！",
            "nextDialogs": [
              "111101016"
            ]
          },
          "111101016": {
            "id": "111101016",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不然呢？！难道单纯只是去找麻烦的吗？！",
            "nextDialogs": [
              "111101017"
            ]
          },
          "111101017": {
            "id": "111101017",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "没有啦没有啦，「业务拓展」在和冒险家协会谈完之后就结束了。",
            "nextDialogs": [
              "111101018"
            ]
          },
          "111101018": {
            "id": "111101018",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "我是来帮老孟找人的，之前提到的狼哥，还记得吗？"
          }
        }
      }
    },
    {
      "subId": "1111011",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111101101"
        ],
        "dialogs": {
          "111101101": {
            "id": "111101101",
            "speakerId": 1004,
            "speakerName": "岚姐",
            "text": "在冒险家协会里，我偶尔也会被当成怪人。",
            "nextDialogs": [
              "111101102"
            ]
          },
          "111101102": {
            "id": "111101102",
            "speakerId": 1004,
            "speakerName": "岚姐",
            "text": "但，只是因为他们从来没有和胡桃说过话吧。"
          }
        }
      }
    },
    {
      "subId": "1111012",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111101201"
        ],
        "dialogs": {
          "111101201": {
            "id": "111101201",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "我认为现在的说法，缺乏热情与诚意。",
            "nextDialogs": [
              "111101202"
            ]
          },
          "111101202": {
            "id": "111101202",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "如果只是平淡地送出东西，就无法让人产生「赚到了」的想法。",
            "nextDialogs": [
              "111101203"
            ]
          },
          "111101203": {
            "id": "111101203",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "做葬仪的组织，很难给人这种感觉吧…",
            "nextDialogs": [
              "111101204"
            ]
          },
          "111101204": {
            "id": "111101204",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "但问题就在这里！传达不出这种感觉，就没有回头客了。",
            "nextDialogs": [
              "111101205"
            ]
          },
          "111101205": {
            "id": "111101205",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "回、回头客…"
          }
        }
      }
    },
    {
      "subId": "1111016",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111101601"
        ],
        "dialogs": {
          "111101601": {
            "id": "111101601",
            "speakerId": 1007,
            "speakerName": "摆渡人",
            "text": "……",
            "nextDialogs": [
              "111101602"
            ]
          },
          "111101602": {
            "id": "111101602",
            "speakerId": 1007,
            "speakerName": "摆渡人",
            "text": "请直接找堂主吧。"
          }
        }
      }
    },
    {
      "subId": "1111017",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111101701"
        ],
        "dialogs": {
          "111101701": {
            "id": "111101701",
            "speakerId": 1007,
            "speakerName": "摆渡人",
            "text": "请跟上堂主吧，她有分寸。"
          }
        }
      }
    },
    {
      "subId": "1111019",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111101901"
        ],
        "dialogs": {
          "111101901": {
            "id": "111101901",
            "speakerId": 1008,
            "speakerName": "小五",
            "text": "请不要再来找我了！我现在好得很！"
          }
        }
      }
    },
    {
      "subId": "1111020",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111102001"
        ],
        "dialogs": {
          "111102001": {
            "id": "111102001",
            "speakerId": 1009,
            "speakerName": "木木",
            "text": "去找其他人吧，拜托了。"
          }
        }
      }
    },
    {
      "subId": "1111022",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111102201"
        ],
        "dialogs": {
          "111102201": {
            "id": "111102201",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "唉，狼哥…怎么会变成这样。",
            "nextDialogs": [
              "111102202"
            ]
          },
          "111102202": {
            "id": "111102202",
            "speakerId": 1001,
            "speakerName": "老孟",
            "text": "啊，不用在意我，自言自语而已。"
          }
        }
      }
    },
    {
      "subId": "1111099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111109901"
        ],
        "dialogs": {
          "111109901": {
            "id": "111109901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我、我应该没有说错话吧？",
            "nextDialogs": [
              "111109902"
            ]
          },
          "111109902": {
            "id": "111109902",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们快追上去吧，免得他做什么不理智的事。",
            "nextDialogs": [
              "111109903"
            ]
          },
          "111109903": {
            "id": "111109903",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "往生堂，「问不到的人」，难道她说的不是活着的人？",
            "nextDialogs": [
              "111109904"
            ]
          },
          "111109904": {
            "id": "111109904",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔唔…这个人太古怪了。",
            "nextDialogs": [
              "111109905"
            ]
          },
          "111109905": {
            "id": "111109905",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "哼，拒绝此等好事，吃亏的是他们。",
            "nextDialogs": [
              "111109906"
            ]
          },
          "111109906": {
            "id": "111109906",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "有什么不愿意面对的，都是迟早的事啊。",
            "nextDialogs": [
              "111109908"
            ]
          },
          "111109908": {
            "id": "111109908",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们现在要去什么地方？",
            "nextDialogs": [
              "111109909"
            ]
          },
          "111109909": {
            "id": "111109909",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "去拜访重要的「潜在客户」，我来带路。",
            "nextDialogs": [
              "111109910"
            ]
          },
          "111109910": {
            "id": "111109910",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "唉，为什么生气了？我只是在很真诚地讲健康的重要性啊。",
            "nextDialogs": [
              "111109911"
            ]
          },
          "111109911": {
            "id": "111109911",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但「往生堂」堂主讲这个，很奇怪吧。",
            "nextDialogs": [
              "111109912"
            ]
          },
          "111109912": {
            "id": "111109912",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "又失败了，唉，不过，也还好吧。",
            "nextDialogs": [
              "111109913"
            ]
          },
          "111109913": {
            "id": "111109913",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我想问你真的成功过吗？"
          }
        }
      }
    }
  ]
}
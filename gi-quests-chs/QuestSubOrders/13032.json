    {
      "subId": "1303299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130329901"
        ],
        "dialogs": {
          "130329901": {
            "id": "130329901",
            "speakerId": 13261,
            "speakerName": "艾文",
            "text": "（姐姐好厉害…但以前的我是不会输的。）",
            "nextDialogs": [
              "130329902"
            ]
          },
          "130329902": {
            "id": "130329902",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "（居然差点就被追上了，她真是不简单。）",
            "nextDialogs": [
              "130329908"
            ]
          },
          "130329908": {
            "id": "130329908",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "在梦境中迷失，恍惚间回到了原点"
          }
        }

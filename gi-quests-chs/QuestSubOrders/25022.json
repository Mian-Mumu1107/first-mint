  "subQuests": [
    {
      "subId": "2502201",
      "subQuestName": "与卡兹加对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250220101"
        ],
        "dialogs": {
          "250220101": {
            "id": "250220101",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "嗯…看来是得换一个食谱了…",
            "nextDialogs": [
              "250220102"
            ]
          },
          "250220102": {
            "id": "250220102",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "呜呜，呜呜呜！",
            "nextDialogs": [
              "250220106",
              "250220105"
            ]
          },
          "250220106": {
            "id": "250220106",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "呜，呜！",
            "nextDialogs": [
              "250220107"
            ]
          },
          "250220107": {
            "id": "250220107",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "平时霍莱都能吃完一整盆果子，吃完之后能疯玩一整天。",
            "nextDialogs": [
              "250220108"
            ]
          },
          "250220108": {
            "id": "250220108",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "现在它一盆水果只能吃一半多，而且吃完之后，就坐在旁边一动也不动…",
            "nextDialogs": [
              "250220109"
            ]
          },
          "250220109": {
            "id": "250220109",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "我还以为它生病了，吓得连夜去找医生帮忙。",
            "nextDialogs": [
              "250220110"
            ]
          },
          "250220110": {
            "id": "250220110",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "我们俩折腾了一整夜，终于确定霍莱什么病也没有，它就是…挑食了。",
            "nextDialogs": [
              "250220111"
            ]
          },
          "250220111": {
            "id": "250220111",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "医生说，最好的解决方法就是给霍莱换一道新菜谱。",
            "nextDialogs": [
              "250220112"
            ]
          },
          "250220112": {
            "id": "250220112",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "他还说，我也可以试试在霍莱吃饭的时候放点音乐。也许这样可以有助于霍莱提起食欲…"
          },
          "250220105": {
            "id": "250220105",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "呜，呜！"
          }
        }
      }
    },
    {
      "subId": "2502202",
      "subQuestName": "将食材带给霍莱",
      "sceneId": null,
      "locations": [],
      "dialogue": {

            "text": "（test）（把食材递给霍莱尝试下）"
          }
        }
      }
    },
    {
      "subId": "2502203",
      "subQuestName": "与卡兹加对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250221201"
        ],
        "dialogs": {
          "250221201": {
            "id": "250221201",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "对了！这些东西给你，就当做是谢礼吧。",
            "nextDialogs": [
              "250221202"
            ]
          },
          "250221202": {
            "id": "250221202",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "有了你帮忙，我肯定能研究出一份最适合霍莱的食谱。",
            "nextDialogs": [
              "250221203"
            ]
          },
          "250221203": {
            "id": "250221203",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "霍莱，你可要好好吃饱，好好长大喔。",
            "nextDialogs": [
              "250221204"
            ]
          },
          "250221204": {
            "id": "250221204",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "呜呜，呜呜，呜呜呜！"
          }
        }
      }
    },

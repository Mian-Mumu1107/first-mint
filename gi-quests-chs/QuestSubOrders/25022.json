    {
      "subId": "2502203",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250220301"
        ],
        "dialogs": {
          "250220301": {
            "id": "250220301",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "这花可真好看。名字也挺好听的…霍莱，你想试吃一下吗？",
            "nextDialogs": [
              "250220304"
            ]
          },
          "250220304": {
            "id": "250220304",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "呜呜，呜！",
            "nextDialogs": [
              "250220305"
            ]
          },
          "250220305": {
            "id": "250220305",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "（霍莱小心翼翼地嚼了嚼，仔细品尝着花瓣的味道。）",
            "nextDialogs": [
              "250220306"
            ]
          },
          "250220306": {
            "id": "250220306",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "呜，呜…",
            "nextDialogs": [
              "250220307"
            ]
          },
          "250220307": {
            "id": "250220307",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "喔！看霍莱的样子，它还挺喜欢吃这个的。不过吃花可不能吃饱啊…",
            "nextDialogs": [
              "250220308"
            ]
          },
          "250220308": {
            "id": "250220308",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "而且，这种花看上去就不太便宜啊…总之我先记下来好了。",
            "nextDialogs": [
              "250220309"
            ]
          },
          "250220309": {
            "id": "250220309",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "花怎么做成食物呢？唔，要不然，把花包在饼里…？"
          }
        }
      }
    },
    {
      "subId": "2502204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250220401"
        ],
        "dialogs": {
          "250220401": {
            "id": "250220401",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "嗬！这果子还不小，看着就能吃饱。霍莱，你想试试吗？",
            "nextDialogs": [
              "250220404"
            ]
          },
          "250220404": {
            "id": "250220404",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "呜呜，呜！",
            "nextDialogs": [
              "250220405"
            ]
          },
          "250220405": {
            "id": "250220405",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "（霍莱大口地嚼着堇瓜，一会就全吃光了。）",
            "nextDialogs": [
              "250220406"
            ]
          },
          "250220406": {
            "id": "250220406",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "呜呜，呜呜呜！",
            "nextDialogs": [
              "250220407"
            ]
          },
          "250220407": {
            "id": "250220407",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "哈哈哈，一下子就吃光了，你很喜欢这个吗？霍莱？",
            "nextDialogs": [
              "250220408"
            ]
          },
          "250220408": {
            "id": "250220408",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "呜呜，呜！呜呜——",
            "nextDialogs": [
              "250220409"
            ]
          },
          "250220409": {
            "id": "250220409",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "好！那我过会就去找人问问，哪里有稻妻来的商人，得多买点堇瓜才行…"
          }
        }
      }
    },
    {
      "subId": "2502205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250220501"
        ],
        "dialogs": {
          "250220501": {
            "id": "250220501",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "唔，这花闻着倒是不错，有一股清香…",
            "nextDialogs": [
              "250220504"
            ]
          },
          "250220504": {
            "id": "250220504",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "霍莱？你…呜哇！已经吃下去了啊！",
            "nextDialogs": [
              "250220505"
            ]
          },
          "250220505": {
            "id": "250220505",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "（霍莱一口气吞下了清心，对着你们眨了眨眼…）",
            "nextDialogs": [
              "250220506"
            ]
          },
          "250220506": {
            "id": "250220506",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "霍莱突然转过了身子，一口气吃完了旁边的半盆水果…",
            "nextDialogs": [
              "250220507"
            ]
          },
          "250220507": {
            "id": "250220507",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "霍莱的食欲怎么突然这么好了？这种叫清心的东西，效果有这么好吗？",
            "nextDialogs": [
              "250220508"
            ]
          },
          "250220508": {
            "id": "250220508",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "我，我得找医生去商量一下…"
          }
        }
      }
    },
    {
      "subId": "2502206",

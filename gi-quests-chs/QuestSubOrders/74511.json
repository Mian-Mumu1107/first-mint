  "subQuests": [
    {
      "subId": "7451101",
      "subQuestName": "与警备队成员对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745110101"
        ],
        "dialogs": {
          "745110101": {
            "id": "745110101",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "两位朋友，你们好。",
            "nextDialogs": [
              "745110102"
            ]
          },
          "745110102": {
            "id": "745110102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们是…警备队？找我们有什么事吗？",
            "nextDialogs": [
              "745110103"
            ]
          },
          "745110103": {
            "id": "745110103",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "嘿嘿，猜猜看？",
            "nextDialogs": [
              "745110106"
            ]
          },
          "745110106": {
            "id": "745110106",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "你们居然还做过这种事呀！慢点说，我立刻记录在案。",
            "nextDialogs": [
              "745110107"
            ]
          },
          "745110107": {
            "id": "745110107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是在诈我们！",
            "nextDialogs": [
              "745110108"
            ]
          },
          "745110108": {
            "id": "745110108",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "开个玩笑。介绍一下，我叫谢妮，这位是我的前辈，弗雷瑞斯。",
            "nextDialogs": [
              "745110109"
            ]
          },
          "745110109": {
            "id": "745110109",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "前辈最近做了一款新发明，想找人帮忙尝试一下，不知道两位有没有兴趣？",
            "nextDialogs": [
              "745110110"
            ]
          },
          "745110110": {
            "id": "745110110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "发明？什么新发明呀？",
            "nextDialogs": [
              "745110111"
            ]
          },
          "745110111": {
            "id": "745110111",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "一种可以远程控制的炮台。",
            "nextDialogs": [
              "745110112"
            ]
          },
          "745110112": {
            "id": "745110112",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "你们看，以前的炮台需要有人在旁边操控吧？那敌方只要瞄准炮台，就可以把我们一锅端掉啦。但是如果我们可以远程操控的话…",
            "nextDialogs": [
              "745110113"
            ]
          },
          "745110113": {
            "id": "745110113",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "就可以尽量减少伤亡了。",
            "nextDialogs": [
              "745110114"
            ]
          },
          "745110114": {
            "id": "745110114",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "就是这样！不愧是「曾三次拒绝枫丹科学院邀请」的弗雷瑞斯前辈，居然能轻松做出这么神奇的发明！",
            "nextDialogs": [
              "745110115"
            ]
          },
          "745110115": {
            "id": "745110115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "三次拒绝枫丹科学院邀请？",
            "nextDialogs": [
              "745110116"
            ]
          },
          "745110116": {
            "id": "745110116",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "这个…",
            "nextDialogs": [
              "745110117"
            ]
          },
          "745110117": {
            "id": "745110117",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "没错！我跟你们说哦，枫丹科学院曾经看中弗雷瑞斯前辈的才华，三次花重金聘请他去做高端研究。",
            "nextDialogs": [
              "745110118"
            ]
          },
          "745110118": {
            "id": "745110118",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "前辈因为热爱警备队的工作，所以一直留在这里，多么感人！",
            "nextDialogs": [
              "745110119"
            ]
          },
          "745110119": {
            "id": "745110119",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "即便如此，前辈还是不忍自己的才华被浪费，所以时不时会创造出一些新发明，为我们解决各种苦恼！",
            "nextDialogs": [
              "745110120"
            ]
          },
          "745110120": {
            "id": "745110120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来好厉害！",
            "nextDialogs": [
              "745110121"
            ]
          },
          "745110121": {
            "id": "745110121",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "咳。过誉了。谢妮，还记得我对你的教导吗？越是聪明的人，越懂得谦虚的可贵。",
            "nextDialogs": [
              "745110122"
            ]
          },
          "745110122": {
            "id": "745110122",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "是，弗雷瑞斯前辈！",
            "nextDialogs": [
              "745110123"
            ]
          },
          "745110123": {
            "id": "745110123",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "总之，我们想请两位帮忙验证这款远程炮台的可行性。「场地」和「标靶」我们已经准备好了，关于酬劳，我们也绝对不会吝啬。",
            "nextDialogs": [
              "745110124"
            ]
          },
          "745110124": {
            "id": "745110124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，这你可找对人啦。",
            "nextDialogs": [
              "745110125"
            ]
          },
          "745110125": {
            "id": "745110125",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我和{NICKNAME}一路走来，见过各种各样的新鲜东西。就让我们帮你鉴定一下，你的发明到底好不好用！",
            "nextDialogs": [
              "745110126"
            ]
          },
          "745110126": {
            "id": "745110126",
            "speakerId": 30534,
            "speakerName": "谢妮",
            "text": "加油，两位。加油，弗雷瑞斯前辈！",
            "nextDialogs": [
              "745110127"
            ]
          },
          "745110127": {
            "id": "745110127",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "呃…总之，这边请吧。"
          }
        }
      }
    }
  ]
}
      }
    },
    {
      "subId": "800603",
      "subQuestName": "沿道路向前方探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "800612",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80060401"
        ],
        "dialogs": {
          "80060401": {
            "id": "80060401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一处有些简陋的丘丘人营地…",
            "nextDialogs": [
              "80060402"
            ]
          },
          "80060402": {
            "id": "80060402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里也有看起来很可怜的丘丘人呢，有些已经…失去了生命气息…",
            "nextDialogs": [
              "80060403"
            ]
          },
          "80060403": {
            "id": "80060403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈夫丹想带我们看的就是这里吗？",
            "nextDialogs": [
              "80060404"
            ]
          },
          "80060404": {
            "id": "80060404",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "无论是或不是，这里都有仔细探查的价值。四处调查一番，别漏掉任何细节。"
          }
        }
      }
    },
    {
      "subId": "800604",
      "subQuestName": "前往丘丘人营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "800605",
      "subQuestName": "调查丘丘人营地中的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80060501"
        ],
        "dialogs": {
          "80060501": {
            "id": "80060501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么深的地底，怎么会有这样的花？",
            "nextDialogs": [
              "80060502"
            ]
          },
          "80060502": {
            "id": "80060502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是献给这些死去的丘丘人的吗？",
            "nextDialogs": [
              "80060505"
            ]
          },
          "80060505": {
            "id": "80060505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，你这么一说，我也觉得有些眼熟…",
            "nextDialogs": [
              "80060506"
            ]
          },
          "80060506": {
            "id": "80060506",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "是坎瑞亚的国花——「因提瓦特」。曾盛放在坎瑞亚大地的每一个角落。",
            "nextDialogs": [
              "80060507"
            ]
          },
          "80060507": {
            "id": "80060507",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "这种花的花期原本只有两周。可若被人折下、带离坎瑞亚的土地，花瓣便不再生长，而且变得十分坚硬。",
            "nextDialogs": [
              "80060508"
            ]
          },
          "80060508": {
            "id": "80060508",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "直至回到故土之中，花瓣才会重新变得柔软，最终泯于尘土…",
            "nextDialogs": [
              "80060509"
            ]
          },
          "80060509": {
            "id": "80060509",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "所以，因提瓦特也象征「游子」，寓意着「故乡的温柔」。",
            "nextDialogs": [
              "80060510"
            ]
          },
          "80060510": {
            "id": "80060510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_Twins2Male|INFO_FEMALE_PRONOUN_Twins2Female]}",
            "nextDialogs": [
              "80060511"
            ]
          },
          "80060511": {
            "id": "80060511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！那这种花出现在这里，也就是说…",
            "nextDialogs": [
              "80060512"
            ]
          },
          "80060512": {
            "id": "80060512",
            "speakerId": 10916,
            "speakerName": "深渊使徒",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_GIRLD|INFO_FEMALE_PRONOUN_BOYD]}殿下，您终于同意了？",
            "nextDialogs": [
              "80060513"
            ]
          },
          "80060513": {
            "id": "80060513",
            "speakerId": 1003,
            "speakerName": "Sibling",
            "text": "过分专注地投入对抗「天理」之大业，反而淡忘了「复国」的使命。",
            "nextDialogs": [
              "80060514"
            ]
          },
          "80060514": {
            "id": "80060514",
            "speakerId": 1003,
            "speakerName": "Sibling",
            "text": "的确，我不该如此优柔寡断。",
            "nextDialogs": [
              "80060515"
            ]
          },
          "80060515": {
            "id": "80060515",
            "speakerId": 10916,
            "speakerName": "深渊使徒",
            "text": "「装置」即将完备，等待殿下您的吩咐。",
            "nextDialogs": [
              "80060516"
            ]
          },
          "80060516": {
            "id": "80060516",
            "speakerId": 1003,
            "speakerName": "Sibling",
            "text": "有多少把握？",
            "nextDialogs": [
              "80060517"
            ]
          },
          "80060517": {
            "id": "80060517",
            "speakerId": 10916,
            "speakerName": "深渊使徒",
            "text": "理论上的可行性，大概…",
            "nextDialogs": [
              "80060518"
            ]
          },
          "80060518": {
            "id": "80060518",
            "speakerId": 1003,
            "speakerName": "Sibling",
            "text": "算了，哪怕只有百分之一的希望…",
            "nextDialogs": [
              "80060519"
            ]
          },
          "80060519": {
            "id": "80060519",
            "speakerId": 1003,
            "speakerName": "Sibling",
            "text": "我们不也是一样么，早已身处深渊了。",
            "nextDialogs": [
              "80060520"
            ]
          },
          "80060520": {
            "id": "80060520",
            "speakerId": 1003,
            "speakerName": "Sibling",
            "text": "对「他们」而言，与其活得毫无尊严，还不如早日回到「循环」之中。",
            "nextDialogs": [
              "80060521"
            ]
          },
          "80060521": {
            "id": "80060521",
            "speakerId": 1003,
            "speakerName": "Sibling",
            "text": "不要让「他们」继续背负…那些莫须有的罪孽了。",
            "nextDialogs": [
              "80060522"
            ]
          },
          "80060522": {
            "id": "80060522",
            "speakerId": 10916,
            "speakerName": "深渊使徒",
            "text": "您的决断，是教团的幸运。",
            "nextDialogs": [
              "80060523"
            ]
          },
          "80060523": {
            "id": "80060523",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_BROTHER]}…",
            "nextDialogs": [
              "80060524"
            ]
          },
          "80060524": {
            "id": "80060524",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "你似乎看到了什么。能说给我听听么？",
            "nextDialogs": [
              "80060525"
            ]
          },
          "80060525": {
            "id": "80060525",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀，你好像愣神了好久。",
            "nextDialogs": [
              "80060526"
            ]
          },
          "80060526": {
            "id": "80060526",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "将刚刚看到的画面告诉了戴因斯雷布…",
            "nextDialogs": [
              "80060527"
            ]
          },
          "80060527": {
            "id": "80060527",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "这是仅属于「双子」的奇妙连接么…",
            "nextDialogs": [
              "80060528"
            ]
          },
          "80060528": {
            "id": "80060528",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "听起来，他们试图利用某些装置净化诅咒，可能就是之前我们看到过的那件物品。",
            "nextDialogs": [
              "80060529"
            ]
          },
          "80060529": {
            "id": "80060529",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "#而且…{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SHE|INFO_MALE_PRONOUN_HE]}还提到了「复国」，对么？"
          }
        }
      }
    },

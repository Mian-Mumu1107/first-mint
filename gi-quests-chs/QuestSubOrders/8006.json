    {
      "subId": "800606",
      "subQuestName": "离开丘丘人营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80060601"
        ],
        "dialogs": {
          "80060601": {
            "id": "80060601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "从这里也能看到那座倒立的城市呀。",
            "nextDialogs": [
              "80060602"
            ]
          },
          "80060602": {
            "id": "80060602",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "不对…小心！",
            "nextDialogs": [
              "80060603"
            ]
          },
          "80060603": {
            "id": "80060603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊！",
            "nextDialogs": [
              "80060604"
            ]
          },
          "80060604": {
            "id": "80060604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么、怎么回事！是之前那个正中央的房间发出的光吗？眼睛好痛！",
            "nextDialogs": [
              "80060605"
            ]
          },
          "80060605": {
            "id": "80060605",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "异变还在继续，深渊已经动手了么？",
            "nextDialogs": [
              "80060606"
            ]
          },
          "80060606": {
            "id": "80060606",
            "speakerId": 10916,
            "speakerName": "深渊使徒",
            "text": "戴因斯雷布…如此纠缠不休，居然还再一次联合了殿下的血亲…",
            "nextDialogs": [
              "80060607"
            ]
          },
          "80060607": {
            "id": "80060607",
            "speakerId": 10916,
            "speakerName": "深渊使徒",
            "text": "之前没来得及确认传送网络，结果误将你传送到这里…真是致命的失误。",
            "nextDialogs": [
              "80060608"
            ]
          },
          "80060608": {
            "id": "80060608",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "哼！只懂得逃跑的懦夫，是谁给了你直面我的勇气？",
            "nextDialogs": [
              "80060609"
            ]
          },
          "80060609": {
            "id": "80060609",
            "speakerId": 10916,
            "speakerName": "深渊使徒",
            "text": "殿下的意志必须被落实，应当不惜一切代价清除干扰。",
            "nextDialogs": [
              "80060610"
            ]
          },
          "80060610": {
            "id": "80060610",
            "speakerId": 10916,
            "speakerName": "深渊使徒",
            "text": "这次一定要彻底地…将折磨着人民的诅咒清除掉。",
            "nextDialogs": [
              "80060611"
            ]
          },
          "80060611": {
            "id": "80060611",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "折磨它们的只会是你们。",
            "nextDialogs": [
              "80060612"
            ]
          },
          "80060612": {
            "id": "80060612",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "那些丘丘人身上，除了诅咒，本就已经什么都没有留下了。",
            "nextDialogs": [
              "80060613"
            ]
          },
          "80060613": {
            "id": "80060613",
            "speakerId": 10916,
            "speakerName": "深渊使徒",
            "text": "我不会逃了，来吧，戴因斯雷布。",
            "nextDialogs": [
              "80060614"
            ]
          },
          "80060614": {
            "id": "80060614",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "如此可笑的意志，值得你用生命来拖延时间吗？你想坚持，那就如你所愿！"
          }
        }
      }
    },
    {
      "subId": "800607",
      "subQuestName": "击败深渊使徒",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "800608",
      "subQuestName": "与戴因斯雷布对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80060801"
        ],
        "dialogs": {
          "80060801": {
            "id": "80060801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼！你追了这么久的深渊使徒，总算是干掉了！",
            "nextDialogs": [
              "80060802"
            ]
          },
          "80060802": {
            "id": "80060802",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "没空闲聊了。看来深渊教团的装置正在启动，现在赶去摧毁它还来得及。",
            "nextDialogs": [
              "80060803"
            ]
          },
          "80060803": {
            "id": "80060803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！我们赶快过去看看！"
          }
        }
      }
    },
    {
      "subId": "800620",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80062001"
        ],
        "dialogs": {
          "80062001": {
            "id": "80062001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "和普通的丘丘人一样，这边也有篝火呢。",
            "nextDialogs": [
              "80062002"
            ]
          },
          "80062002": {
            "id": "80062002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是戴因明明说，丘丘人在生命的最后阶段会变得畏光…",
            "nextDialogs": [
              "80062003"
            ]
          },
          "80062003": {
            "id": "80062003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莫非是在最后的最后，还是想要感受一下光明和温暖？啊，我只是瞎猜哦…也有可能是别的原因啦！"
          }
        }
      }
    },
    {
      "subId": "800621",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80062101"
        ],
        "dialogs": {
          "80062101": {
            "id": "80062101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些箱子，一般来说是丘丘人们存放食物的地方吧？",
            "nextDialogs": [
              "80062102"
            ]
          },
          "80062102": {
            "id": "80062102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像…基本上是空空如也的。似乎丘丘人的生命到了最后是不需要吃东西的吗？",
            "nextDialogs": [
              "80062103"
            ]
          },
          "80062103": {
            "id": "80062103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果是我的话，至少…肯定还是会想念食物的味道的…"
          }
        }
      }
    },
    {
      "subId": "800622",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80062201"
        ],
        "dialogs": {
          "80062201": {
            "id": "80062201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些丘丘人…完全没有生命的气息了呢，就快要和黑暗融为一体了。",
            "nextDialogs": [
              "80062202"
            ]
          },
          "80062202": {
            "id": "80062202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总是吵吵闹闹的丘丘人原来是以这样的方式老去的，想想还真是不可思议。",
            "nextDialogs": [
              "80062203"
            ]
          },
          "80062203": {
            "id": "80062203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "尽管和丘丘人之间没有太多好的回忆，但，还是希望它们在最后的时刻得到了安宁吧。"
          }
        }
      }
    },
    {
      "subId": "800699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80069901"
        ],
        "dialogs": {
          "80069901": {
            "id": "80069901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这附近也有些丘丘人生活过的痕迹呢。"
          }
        }
      }
    }
  ]
}
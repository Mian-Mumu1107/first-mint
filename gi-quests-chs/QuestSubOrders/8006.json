  "subQuests": [
    {
      "subId": "800601",
      "subQuestName": "跟随哈夫丹指引的方向进行探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80060101"
        ],
        "dialogs": {
          "80060101": {
            "id": "80060101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈夫丹的身影，好像消失在这条路的尽头了…",
            "nextDialogs": [
              "80060102"
            ]
          },
          "80060102": {
            "id": "80060102",
            "speakerId": 1022,
            "speakerName": "戴因斯雷布",
            "text": "前面可能有他想让我们看到的东西。跟上去吧。"
          }
        }
      }
    },
    {
      "subId": "800602",
      "subQuestName": "沿道路向前方探索",
      "sceneId": null,
      "locations": [],

            "id": "207431001",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "这酒庄的生意再这么停摆下去，我可怎么和迪卢克老爷交代…",
            "nextDialogs": [
              "207431002"
            ]
          },
          "207431002": {
            "id": "207431002",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "旅行者，如果你看见迪卢克老爷了，能帮我给他说说吗？",
            "nextDialogs": [
              "207431003"
            ]
          },
          "207431003": {
            "id": "207431003",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "他老这么不管酒庄的生意，也不是个事啊…"
          }
        }
      }

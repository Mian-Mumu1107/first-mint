    {
      "subId": "2074306",
      "subQuestName": "与埃泽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207432001"
        ],
        "dialogs": {
          "207432001": {
            "id": "207432001",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "您已经把商路清理完了吗？",
            "nextDialogs": [
              "207432002"
            ]
          },
          "207432002": {
            "id": "207432002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经清理完了。",
            "nextDialogs": [
              "207432003"
            ]
          },
          "207432003": {
            "id": "207432003",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "太好了，这样酒庄的生意也能慢慢恢复了。",
            "nextDialogs": [
              "207432004"
            ]
          },
          "207432004": {
            "id": "207432004",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "其实这件事，我应该先向迪卢克老爷报告的…",
            "nextDialogs": [
              "207432005"
            ]
          },
          "207432005": {
            "id": "207432005",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "但是迪卢克老爷又不见了，我问遍了酒庄上下，没有一个人知道迪卢克老爷去哪了。",
            "nextDialogs": [
              "207432006"
            ]
          },
          "207432006": {
            "id": "207432006",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "爱德琳还是说什么「迪卢克老爷去办自己的私事去了」，其余的一句也不肯说，一点也没有担心的样子。",
            "nextDialogs": [
              "207432007"
            ]
          },
          "207432007": {
            "id": "207432007",
            "speakerId": 1527,
            "speakerName": "埃泽",
            "text": "唉，算了。等迪卢克老爷回来了，我一定要和他好好谈谈…"
          }
        }
      }
    },
    {

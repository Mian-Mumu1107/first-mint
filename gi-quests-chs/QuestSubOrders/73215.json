  "subQuests": [
    {
      "subId": "7321501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150101"
        ],
        "dialogs": {
          "732150101": {
            "id": "732150101",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "你好呀，朋友那菈！唔…好像要对你说什么，想不起了，可是…",
            "nextDialogs": [
              "732150102"
            ]
          },
          "732150102": {
            "id": "732150102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没关系的，又看见你们就让我们很开心啦！",
            "nextDialogs": [
              "732150103"
            ]
          },
          "732150103": {
            "id": "732150103",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "嗯，谢谢。",
            "nextDialogs": [
              "732150105",
              "732150107"
            ]
          },
          "732150105": {
            "id": "732150105",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "她不再说话了，但是她很好。也正在恢复，森林…谢谢你们。"
          },
          "732150107": {
            "id": "732150107",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "遗忘…？嗯，因为力量耗尽了，「苦舍桓」。所以也会流走，记忆。一点一点，就像露珠一样…"
          }
        }
      }
    },
    {
      "subId": "7321503",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150301"
        ],
        "dialogs": {
          "732150301": {
            "id": "732150301",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "你好，谢谢你们！金色的那菈和白飞飞！",
            "nextDialogs": [
              "732150302"
            ]
          },
          "732150302": {
            "id": "732150302",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "你们来做什么呀！",
            "nextDialogs": [
              "732150303"
            ]
          },
          "732150303": {
            "id": "732150303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你说要记得回来一起玩呀！",
            "nextDialogs": [
              "732150304"
            ]
          },
          "732150304": {
            "id": "732150304",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "唔，我这么说过吗…？",
            "nextDialogs": [
              "732150306",
              "732150308"
            ]
          },
          "732150306": {
            "id": "732150306",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "这样呀…",
            "nextDialogs": [
              "732150309"
            ]
          },
          "732150309": {
            "id": "732150309",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "不管怎样，谢谢你们！"
          },
          "732150308": {
            "id": "732150308",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "唔…没有哦。"
          }
        }
      }
    },
    {
      "subId": "7321504",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150401"
        ],
        "dialogs": {
          "732150401": {
            "id": "732150401",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "你好呀，金色的那菈和白飞飞！",
            "nextDialogs": [
              "732150402"
            ]
          },
          "732150402": {
            "id": "732150402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好！最近怎么样呀！",
            "nextDialogs": [
              "732150403"
            ]
          },
          "732150403": {
            "id": "732150403",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "很好，不过为什么来这里，你们？",
            "nextDialogs": [
              "732150404"
            ]
          },
          "732150404": {
            "id": "732150404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…？",
            "nextDialogs": [
              "732150405"
            ]
          },
          "732150405": {
            "id": "732150405",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "唔…很困扰，我们。虽然一定有理由，但你们为什么来，不知道…",
            "nextDialogs": [
              "732150406"
            ]
          },
          "732150406": {
            "id": "732150406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "毕竟我们对这里很熟悉嘛，和你们一起经历了那么多冒险！",
            "nextDialogs": [
              "732150407"
            ]
          },
          "732150407": {
            "id": "732150407",
            "speakerId": 20578,
            "speakerName": "兰纳迦",
            "text": "…？唔…是吗？",
            "nextDialogs": [
              "732150408"
            ]
          },
          "732150408": {
            "id": "732150408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们之前的经历，他不记得了呢…"
          }
        }
      }
    },
    {
      "subId": "7321505",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150501"
        ],
        "dialogs": {
          "732150501": {
            "id": "732150501",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "你好！金色的那菈！还有你，小小白飞飞！",
            "nextDialogs": [
              "732150502"
            ]
          },
          "732150502": {
            "id": "732150502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，我不小！也不看看你自己啦！",
            "nextDialogs": [
              "732150503"
            ]
          },
          "732150503": {
            "id": "732150503",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "哼哼，我也不小！唔…对了，你们来做什么呢？",
            "nextDialogs": [
              "732150504"
            ]
          },
          "732150504": {
            "id": "732150504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只是回来看看你们。",
            "nextDialogs": [
              "732150505"
            ]
          },
          "732150505": {
            "id": "732150505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀，毕竟我们之前打败了好多坏东西，一起唱歌，一起救了「呜咿呀」…",
            "nextDialogs": [
              "732150506"
            ]
          },
          "732150506": {
            "id": "732150506",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "「无郁夷摩」！",
            "nextDialogs": [
              "732150507"
            ]
          },
          "732150507": {
            "id": "732150507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！",
            "nextDialogs": [
              "732150508"
            ]
          },
          "732150508": {
            "id": "732150508",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "唔…对不起…你们说的应该是真的。但我不记得了…",
            "nextDialogs": [
              "732150509"
            ]
          },
          "732150509": {
            "id": "732150509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…！没事，没事啦！请你不要伤心！",
            "nextDialogs": [
              "732150510"
            ]
          },
          "732150510": {
            "id": "732150510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（他真的不记得了呢…）"
          }
        }
      }
    },
    {
      "subId": "7321502",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150201"
        ],
        "dialogs": {
          "732150201": {
            "id": "732150201",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "你好，你好！",
            "nextDialogs": [
              "732150202"
            ]
          },
          "732150202": {
            "id": "732150202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好呀，小不点！还记得我们吗！",
            "nextDialogs": [
              "732150203"
            ]
          },
          "732150203": {
            "id": "732150203",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "可恶的白飞飞，我不是小不点！你们还记得我教的歌吗！",
            "nextDialogs": [
              "732150204"
            ]
          },
          "732150204": {
            "id": "732150204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "当然。",
            "nextDialogs": [
              "732150205"
            ]
          },
          "732150205": {
            "id": "732150205",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "好哇！",
            "nextDialogs": [
              "732150206"
            ]
          },
          "732150206": {
            "id": "732150206",
            "speakerId": 20576,
            "speakerName": "兰纳真",
            "text": "那你们要答应我，即使我忘记了自己的歌…你们也要记得！"
          }
        }
      }
    },
    {
      "subId": "7321506",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732150601"
        ],
        "dialogs": {
          "732150601": {
            "id": "732150601",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "金色的那菈，白飞飞，你们来啦！",
            "nextDialogs": [
              "732150602"
            ]
          },
          "732150602": {
            "id": "732150602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！我们来啦！",
            "nextDialogs": [
              "732150603"
            ]
          },
          "732150603": {
            "id": "732150603",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "嘿嘿…我可能忘记了很多事情，所以还要你们多提醒啦…",
            "nextDialogs": [
              "732150604"
            ]
          },
          "732150604": {
            "id": "732150604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是因为「苦舍桓」吗？",
            "nextDialogs": [
              "732150605"
            ]
          },
          "732150605": {
            "id": "732150605",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "嗯…兰纳迦应该和你们说过，力量在记忆里，没有记忆，没有力量…",
            "nextDialogs": [
              "732150606"
            ]
          },
          "732150606": {
            "id": "732150606",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "所以…我们之前一定经历过什么，但是我们不记得了…",
            "nextDialogs": [
              "732150607"
            ]
          },
          "732150607": {
            "id": "732150607",
            "speakerId": 20577,
            "speakerName": "兰迦鲁",
            "text": "哈哈，不过对我来说没什么啦！我们还能重新开始新的记忆呀！对吧？",
            "nextDialogs": [
              "732150608"
            ]
          },
          "732150608": {
            "id": "732150608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯！就是这个精神没错！"
          }
        }
      }
    },

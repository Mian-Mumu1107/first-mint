  "subQuests": [
    {
      "subId": "46101",
      "subQuestName": "与凯亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4610101"
        ],
        "dialogs": {
          "4610101": {
            "id": "4610101",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "啊啊糟了…伤脑筋…这可怎么办呢……",
            "nextDialogs": [
              "4610104"
            ]
          },
          "4610104": {
            "id": "4610104",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "#哦，感谢千风。{NICKNAME}，你的出现一定是神对我的恩赐。",
            "nextDialogs": [
              "4610105"
            ]
          },
          "4610105": {
            "id": "4610105",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "风神派来拯救凡人的使者哟，请问你现在有空吗？",
            "nextDialogs": [
              "4610106"
            ]
          },
          "4610106": {
            "id": "4610106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔哇，好肉麻。"
          }
        }
      }
    },
    {
      "subId": "46110",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4611001"
        ],
        "dialogs": {
          "4611001": {
            "id": "4611001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "救。。。救命啊！！"
          }
        }
      }
    },
    {
      "subId": "46102",
      "subQuestName": "在约定地点与凯亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4610201"
        ],
        "dialogs": {
          "4610201": {
            "id": "4610201",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "好了，就在这里吧。",
            "nextDialogs": [
              "4610202"
            ]
          },
          "4610202": {
            "id": "4610202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别吊胃口啦，到底有什么事？",
            "nextDialogs": [
              "4610203"
            ]
          },
          "4610203": {
            "id": "4610203",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "该从何说起呢…对了。先告诉你们一个秘密吧。",
            "nextDialogs": [
              "4610204"
            ]
          },
          "4610204": {
            "id": "4610204",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "那是有关我个人过往的秘密，请千万不要对别人提起。",
            "nextDialogs": [
              "4610205"
            ]
          },
          "4610205": {
            "id": "4610205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "放心，我的口风可是很紧的。",
            "nextDialogs": [
              "4610206"
            ]
          },
          "4610206": {
            "id": "4610206",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "其实啊…我的爷爷…是个海盗！",
            "nextDialogs": [
              "4610207"
            ]
          },
          "4610207": {
            "id": "4610207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦。",
            "nextDialogs": [
              "4610208"
            ]
          },
          "4610208": {
            "id": "4610208",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "…不不。这反应也太冷淡了。难道你不相信我吗？",
            "nextDialogs": [
              "4610209"
            ]
          },
          "4610209": {
            "id": "4610209",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "看！我的眼罩就是海盗爷爷的遗传，这就是血亲的证明！",
            "nextDialogs": [
              "4610211"
            ]
          },
          "4610211": {
            "id": "4610211",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "#啊哈哈，{NICKNAME}，你还真是没有常识呀。",
            "nextDialogs": [
              "4610212"
            ]
          },
          "4610212": {
            "id": "4610212",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "这就像许多孩子头上的辫子也遗传自妈妈，是一样的道理啊。",
            "nextDialogs": [
              "4610214"
            ]
          },
          "4610214": {
            "id": "4610214",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "昨晚我翻阅爷爷留下来的手记，偶然发现了爷爷留下的<color=#00E1FFFF>宝藏</color>信息…",
            "nextDialogs": [
              "4610215"
            ]
          },
          "4610215": {
            "id": "4610215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…宝藏？！",
            "nextDialogs": [
              "4610216"
            ]
          },
          "4610216": {
            "id": "4610216",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "根据手记上的情报，似乎宝藏被埋藏在「失落的阿卡狄亚遗迹」。",
            "nextDialogs": [
              "4610217"
            ]
          },
          "4610217": {
            "id": "4610217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "宝藏…",
            "nextDialogs": [
              "4610218"
            ]
          },
          "4610218": {
            "id": "4610218",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "但这遗迹的位置具体在哪里，目前还没有线索…",
            "nextDialogs": [
              "4610219"
            ]
          },
          "4610219": {
            "id": "4610219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "宝藏！",
            "nextDialogs": [
              "4610220"
            ]
          },
          "4610220": {
            "id": "4610220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "凯亚！那究竟是什么宝藏！黄金吗？还是宝石？",
            "nextDialogs": [
              "4610221"
            ]
          },
          "4610221": {
            "id": "4610221",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哼哼，只有财宝的宝藏，不过都是三流货色而已…",
            "nextDialogs": [
              "4610222"
            ]
          },
          "4610222": {
            "id": "4610222",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "我爷爷的宝藏，是「剑」啊。",
            "nextDialogs": [
              "4610223"
            ]
          },
          "4610223": {
            "id": "4610223",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "据说是一柄只要握住，就可以获得无敌力量的神剑！",
            "nextDialogs": [
              "4610224"
            ]
          },
          "4610224": {
            "id": "4610224",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇——",
            "nextDialogs": [
              "4610225"
            ]
          },
          "4610225": {
            "id": "4610225",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "那剑是天空岛上的神明失手落入海中的，被爷爷他们碰巧打捞起来。",
            "nextDialogs": [
              "4610226"
            ]
          },
          "4610226": {
            "id": "4610226",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "他握住剑柄的瞬间，电闪雷鸣，巨浪翻腾，原本晴空万里的海上忽然卷起风暴…",
            "nextDialogs": [
              "4610227"
            ]
          },
          "4610227": {
            "id": "4610227",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "依靠神剑的力量，爷爷一路击败了八头海蛇、银发女妖、深渊邪龙…",
            "nextDialogs": [
              "4610228"
            ]
          },
          "4610228": {
            "id": "4610228",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "但这力量过于强大，令其他海盗觊觎不已。",
            "nextDialogs": [
              "4610229"
            ]
          },
          "4610229": {
            "id": "4610229",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "为了避免争端，爷爷只能把神剑藏了起来。"
          }
        }
      }
    },
    {
      "subId": "46109",
      "subQuestName": "(test)到达目标地点$HIDDEN",

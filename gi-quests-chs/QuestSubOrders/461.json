    {
      "subId": "46105",
      "subQuestName": "(test)与冒险家对话，打听情报$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4610513"
        ],
        "dialogs": {
          "4610513": {
            "id": "4610513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不，我们是来…",
            "nextDialogs": [
              "4610502"
            ]
          },
          "4610502": {
            "id": "4610502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "抱歉哦，我们只是想问你知不知道「阿卡狄亚遗迹」在哪里。",
            "nextDialogs": [
              "4610503"
            ]
          },
          "4610503": {
            "id": "4610503",
            "speakerId": 1211,
            "speakerName": "斯坦利",
            "text": "…「阿卡狄亚遗迹」？居然还有我斯坦利没去过的地方…",
            "nextDialogs": [
              "4610504"
            ]
          },
          "4610504": {
            "id": "4610504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "斯坦利先生也不知道吗？",
            "nextDialogs": [
              "4610505"
            ]
          },
          "4610505": {
            "id": "4610505",
            "speakerId": 1211,
            "speakerName": "斯坦利",
            "text": "唔…先别管什么阿卡狄亚了，不如听我讲讲我在烬寂海、泉之境发生的事…",
            "nextDialogs": [
              "4610506"
            ]
          },
          "4610506": {
            "id": "4610506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们没时间听故事啦，再帮忙好好想想有没有什么线索嘛。",
            "nextDialogs": [
              "4610507"
            ]
          },
          "4610507": {
            "id": "4610507",
            "speakerId": 1211,
            "speakerName": "斯坦利",
            "text": "当初，我在烬寂海，那可是一片死亡之地…",
            "nextDialogs": [
              "4610508"
            ]
          },
          "4610508": {
            "id": "4610508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜——",
            "nextDialogs": [
              "4610509"
            ]
          },
          "4610509": {
            "id": "4610509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等我们找到<color=#00E1FFFF>宝藏</color>，「阿卡狄亚寻宝记」的故事一定比你的要精彩得多！",
            "nextDialogs": [
              "4610510"
            ]
          },
          "4610510": {
            "id": "4610510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（就这么说出去了…）",
            "nextDialogs": [
              "4610511"
            ]
          },
          "4610511": {
            "id": "4610511",
            "speakerId": 1211,
            "speakerName": "斯坦利",
            "text": "宝藏？还有…寻宝记？",
            "nextDialogs": [
              "4610512"
            ]
          },
          "4610512": {
            "id": "4610512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉，算了。看来他这边问不出什么，我们走吧。"
          }
        }
      }
    },
    {
      "subId": "46106",
      "subQuestName": "(test)与冒险家对话，打听情报$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4610612"
        ],
        "dialogs": {
          "4610612": {
            "id": "4610612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想请教一下…",
            "nextDialogs": [
              "4610602"
            ]
          },
          "4610602": {
            "id": "4610602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好！请问有没有什么关于「阿卡狄亚遗迹」的消息？",
            "nextDialogs": [
              "4610603"
            ]
          },
          "4610603": {
            "id": "4610603",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "阿卡狄亚…好像没听说过。对不起，我还是协会的新人，了解的情报比较少。",
            "nextDialogs": [
              "4610604"
            ]
          },
          "4610604": {
            "id": "4610604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样啊…",
            "nextDialogs": [
              "4610605"
            ]
          },
          "4610605": {
            "id": "4610605",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "不如试着去协会里挂个委托看看？有实力的老手们也是很活跃的。",
            "nextDialogs": [
              "4610606"
            ]
          },
          "4610606": {
            "id": "4610606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不行不行不行，这可不行。",
            "nextDialogs": [
              "4610607"
            ]
          },
          "4610607": {
            "id": "4610607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "万一被那些冒险家们捷足先登，把宝藏拿走就完了。",
            "nextDialogs": [
              "4610608"
            ]
          },
          "4610608": {
            "id": "4610608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（就这么说出去了…）",
            "nextDialogs": [
              "4610609"
            ]
          },
          "4610609": {
            "id": "4610609",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "哦~↑↓",
            "nextDialogs": [
              "4610610"
            ]
          },
          "4610610": {
            "id": "4610610",
            "speakerId": 1212,
            "speakerName": "杰克",
            "text": "那就没办法了。宝藏的事我会替你们留意的，呃，不，是遗迹的事…",
            "nextDialogs": [
              "4610611"
            ]
          },
          "4610611": {
            "id": "4610611",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好呀，非常感谢！"
          }
        }
      }
    },
    {
      "subId": "46107",
      "subQuestName": "向凯亚报告",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4610801"
        ],
        "dialogs": {
          "4610801": {
            "id": "4610801",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "哦，你们回来了。有带来什么好消息吗？",
            "nextDialogs": [
              "4610802"
            ]
          },
          "4610802": {
            "id": "4610802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔嗯…我们在冒险家协会打听了一圈，但还是没找到什么线索。",
            "nextDialogs": [
              "4610803"
            ]
          },
          "4610803": {
            "id": "4610803",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "呼呼，那是当然的。",
            "nextDialogs": [
              "4610804"
            ]
          },
          "4610804": {
            "id": "4610804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？",
            "nextDialogs": [
              "4610805"
            ]
          },
          "4610805": {
            "id": "4610805",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "没什么。我是说，不经历一些挫折，又怎么会有得到宝藏时的喜悦呢？",
            "nextDialogs": [
              "4610806"
            ]
          },
          "4610806": {
            "id": "4610806",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "对了，正巧我这边倒是有一些消息。",
            "nextDialogs": [
              "4610807"
            ]
          },
          "4610807": {
            "id": "4610807",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "我刚托人去了趟地下情报交易所…似乎有人知道「阿卡狄亚遗迹」的相关情报。",
            "nextDialogs": [
              "4610808"
            ]
          },
          "4610808": {
            "id": "4610808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？那人在哪里？",
            "nextDialogs": [
              "4610809"
            ]
          },
          "4610809": {
            "id": "4610809",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "别急，按照交易所的规矩，他们会安排线人来和我们接头，防止情报泄露。",
            "nextDialogs": [
              "4610810"
            ]
          },
          "4610810": {
            "id": "4610810",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "那个线人，我已经约她在低语森林见面了。",
            "nextDialogs": [
              "4610811"
            ]
          },
          "4610811": {
            "id": "4610811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们还在等什么呀，不去找她吗？",
            "nextDialogs": [
              "4610813"
            ]
          },
          "4610813": {
            "id": "4610813",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "没错！真不愧是阁下。",
            "nextDialogs": [
              "4610814"
            ]
          },
          "4610814": {
            "id": "4610814",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "毕竟我是骑士嘛，理论上是完全不了解这些地下活动的。",
            "nextDialogs": [
              "4610816"
            ]
          },
          "4610816": {
            "id": "4610816",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "那就有劳二位替我跑一趟了，不胜感激。",
            "nextDialogs": [
              "4610817"
            ]
          },
          "4610817": {
            "id": "4610817",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "情报费用方面，当然，我也会替你们报销的。",
            "nextDialogs": [
              "4610818"
            ]
          },
          "4610818": {
            "id": "4610818",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿。包在我身上！"
          }
        }
      }
    },

    {
      "subId": "46103",
      "subQuestName": "前往冒险家协会打听情报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4610404"
        ],
        "dialogs": {
          "4610404": {
            "id": "4610404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，我们才不是为了那么无聊的事来的。",
            "nextDialogs": [
              "4610405"
            ]
          },
          "4610405": {
            "id": "4610405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们是在找一柄从天空岛上掉下来的，斩杀过八头女妖，银发海蛇的…",
            "nextDialogs": [
              "4610406"
            ]
          },
          "4610406": {
            "id": "4610406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "超级超级厉害的神剑！",
            "nextDialogs": [
              "4610408",
              "4610411"
            ]
          },
          "4610408": {
            "id": "4610408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，都差不多啦，反正就是…很厉害。",
            "nextDialogs": [
              "4610409"
            ]
          },
          "4610409": {
            "id": "4610409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总而言之，只要不把藏宝地点说出去就好。",
            "nextDialogs": [
              "4610413"
            ]
          },
          "4610413": {
            "id": "4610413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（就这么说出去了…）",
            "nextDialogs": [
              "4610414"
            ]
          },
          "4610414": {
            "id": "4610414",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "「阿卡狄亚遗迹」…没听说过这名字。",
            "nextDialogs": [
              "4610415"
            ]
          },
          "4610415": {
            "id": "4610415",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "不过还是谢谢你们分享的情报。如果找到的话，记得拿来让我见识见识。",
            "nextDialogs": [
              "4610416"
            ]
          },
          "4610416": {
            "id": "4610416",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？分享…情报…？"
          },
          "4610411": {
            "id": "4610411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没关系啦，只要不把藏宝地点说出去就好。",
            "nextDialogs": [
              "4610412"
            ]
          },
          "4610412": {
            "id": "4610412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那么，塞琉斯先生，你知道「失落的阿卡狄亚遗迹」在哪里吗？"
          }
        }
      }
    },
    {
      "subId": "46104",
      "subQuestName": "(test)与冒险家对话，打听情报$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

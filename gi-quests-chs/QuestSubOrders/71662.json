    {
      "subId": "7166206",
      "subQuestName": "拿到「冒险币」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716620601"
        ],
        "dialogs": {
          "716620601": {
            "id": "716620601",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "旅行者，你先来试试拿到那枚「冒险币」吧。"
          }
        }
      }
    },
    {
      "subId": "7166205",
      "subQuestName": "查看「触发器」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7166207",
      "subQuestName": "将「冒险币」交给宏朗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716620401"
        ],
        "dialogs": {
          "716620401": {
            "id": "716620401",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "喔！不愧是你，很快就理解了操纵这座秘境的方法。",
            "nextDialogs": [
              "716620402"
            ]
          },
          "716620402": {
            "id": "716620402",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "那就拜托你了，用尽你全部的想象，让这座秘境变化起来吧。",
            "nextDialogs": [
              "716620403"
            ]
          },
          "716620403": {
            "id": "716620403",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "希望…我们也能尽快找到这座秘境变化的规律。"
          }
        }
      }
    },
    {
      "subId": "7166299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716629901"
        ],
        "dialogs": {

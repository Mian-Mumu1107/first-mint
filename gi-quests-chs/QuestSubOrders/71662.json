  },
  "subQuests": [
    {
      "subId": "7166201",
      "subQuestName": "与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716620101"
        ],
        "dialogs": {
          "716620101": {
            "id": "716620101",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "旅行者，你来得正好，这里有一份委托，我觉得必须要请你来接下。",
            "nextDialogs": [
              "716620104"
            ]
          },
          "716620104": {
            "id": "716620104",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "这份委托涉及到一座未知的秘境。",
            "nextDialogs": [
              "716620105"
            ]
          },
          "716620105": {
            "id": "716620105",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "虽然协会对那座秘境展开了长时间的调查，但一直没收集到什么有价值的资料。",
            "nextDialogs": [
              "716620106"
            ]
          },
          "716620106": {
            "id": "716620106",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "负责这次调查行动的宏朗先生说，他需要找一位善于随机应变的冒险家来协助调查…",
            "nextDialogs": [
              "716620107"
            ]
          },
          "716620107": {
            "id": "716620107",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "我第一时间就想到了你，旅行者。",
            "nextDialogs": [
              "716620108"
            ]
          },
          "716620108": {
            "id": "716620108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "到底是什么秘境…",
            "nextDialogs": [
              "716620109"
            ]
          },
          "716620109": {
            "id": "716620109",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "宏朗先生就在那座秘境的入口旁边，如果你愿意帮忙的话，可以去问问他。",
            "nextDialogs": [
              "716620110"
            ]
          },
          "716620110": {
            "id": "716620110",
            "speakerId": 2078,
            "speakerName": "凯瑟琳",
            "text": "那就拜托你了，旅行者。"
          }
        }
      }
    },
    {
      "subId": "7166202",
      "subQuestName": "与宏朗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716620201"
        ],
        "dialogs": {
          "716620201": {
            "id": "716620201",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "这秘境到底是怎么回事…",
            "nextDialogs": [
              "716620202"
            ]
          },
          "716620202": {
            "id": "716620202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于委托…",
            "nextDialogs": [
              "716620203"
            ]
          },
          "716620203": {
            "id": "716620203",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "咦？你…等一下，你难道就是凯瑟琳小姐说的那位冒险家吗？",
            "nextDialogs": [
              "716620204"
            ]
          },
          "716620204": {
            "id": "716620204",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "我听说，你善于随机应变，精通各种冒险知识，身手也数一数二…",
            "nextDialogs": [
              "716620207"
            ]
          },
          "716620207": {
            "id": "716620207",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "太好了，有你过来帮忙的话，我心里总算有点底了…",
            "nextDialogs": [
              "716620208"
            ]
          },
          "716620208": {
            "id": "716620208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但是，这秘境到底是…",
            "nextDialogs": [
              "716620209"
            ]
          },
          "716620209": {
            "id": "716620209",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "我差点忘了…还得向你介绍一下情况…",
            "nextDialogs": [
              "716620210"
            ]
          },
          "716620210": {
            "id": "716620210",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "事情是这样的。在一段时间之前，协会里的一支冒险家小队在野外发现了一扇奇怪的大门…就是我身边这扇。",
            "nextDialogs": [
              "716620211"
            ]
          },
          "716620211": {
            "id": "716620211",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "通过大门之后，这支小队来到了一座未知的秘境中。",
            "nextDialogs": [
              "716620212"
            ]
          },
          "716620212": {
            "id": "716620212",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "据第一批进入秘境的冒险家说，当他们进入秘境时，这个秘境就像是一座「空荡荡的屋子」。"
          }
        }
      }
    },
    {
      "subId": "7166203",
      "subQuestName": "进入秘境",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716620301"
        ],
        "dialogs": {
          "716620301": {
            "id": "716620301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里…",
            "nextDialogs": [
              "716620302"
            ]
          },
          "716620302": {
            "id": "716620302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是你说的那座和「空荡荡的屋子」一样的秘境？",
            "nextDialogs": [
              "716620305"
            ]
          },
          "716620305": {
            "id": "716620305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊！这不就是我们经常去探索的那种遗迹吗？！",
            "nextDialogs": [
              "716620306"
            ]
          },
          "716620306": {
            "id": "716620306",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "这里确实就是我们正在探索的那座秘境。",
            "nextDialogs": [
              "716620307"
            ]
          },
          "716620307": {
            "id": "716620307",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "这座秘境之所以是现在这个样子，是因为…",
            "nextDialogs": [
              "716620308"
            ]
          },
          "716620308": {
            "id": "716620308",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "在不久前，它变成了这样。",
            "nextDialogs": [
              "716620309"
            ]
          },
          "716620309": {
            "id": "716620309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "716620310"
            ]
          },
          "716620310": {
            "id": "716620310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「变」成了这样？",
            "nextDialogs": [
              "716620311"
            ]
          },
          "716620311": {
            "id": "716620311",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "没错。这座秘境…会随着人的心意而变化。",
            "nextDialogs": [
              "716620312"
            ]
          },
          "716620312": {
            "id": "716620312",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "据当时领导冒险的冒险队队长说，他们在那个灰蒙蒙的环境里折腾了很久，大家都开始有些失去耐心了。",
            "nextDialogs": [
              "716620313"
            ]
          },
          "716620313": {
            "id": "716620313",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "这个时候，其中一位成员开始小声抱怨了起来。",
            "nextDialogs": [
              "716620314"
            ]
          },
          "716620314": {
            "id": "716620314",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "「如果这里是一座普通的遗迹，那我们早就探索完了。」",
            "nextDialogs": [
              "716620315"
            ]
          },
          "716620315": {
            "id": "716620315",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "冒险队的人又饿又困，纷纷对他的看法表示同意。",
            "nextDialogs": [
              "716620316"
            ]
          },
          "716620316": {
            "id": "716620316",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "随着越来越多的人同意这个看法，不知道在哪个刹那，冒险队突然发现自己已经处在一个「普通的遗迹」里了。",
            "nextDialogs": [
              "716620317"
            ]
          },
          "716620317": {
            "id": "716620317",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "这座「普通的遗迹」里有机关，有道路，有宝藏…甚至火把都还在燃烧。",
            "nextDialogs": [
              "716620318"
            ]
          },
          "716620318": {
            "id": "716620318",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "冒险队判断自己无法处理这种情况，就马上回到了协会报告了这件事。",
            "nextDialogs": [
              "716620319"
            ]
          },
          "716620319": {
            "id": "716620319",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "我们迅速加派人手，对这处秘境展开了更深入的研究。",
            "nextDialogs": [
              "716620320"
            ]
          },
          "716620320": {
            "id": "716620320",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "但到了现在，我们也只知道，这座秘境会随人的心意而变化。",
            "nextDialogs": [
              "716620321"
            ]
          },
          "716620321": {
            "id": "716620321",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "如果有多人同时进入秘境，那这个秘境则会根据心愿最强烈的人的想法而变化。",
            "nextDialogs": [
              "716620322"
            ]
          },
          "716620322": {
            "id": "716620322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！那这里不是可以再变出一个璃月港来？",
            "nextDialogs": [
              "716620323"
            ]
          },
          "716620323": {
            "id": "716620323",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "这个我们试过了，可是一直没成功…我想，也许是我们想要再变出个璃月港的心愿不够强烈吧。",
            "nextDialogs": [
              "716620324"
            ]
          },
          "716620324": {
            "id": "716620324",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "总之，我们现在正在招募冒险家进入秘境，拜托他们依照自己的心愿，让这座秘境不断地变化。",
            "nextDialogs": [
              "716620325"
            ]
          },
          "716620325": {
            "id": "716620325",
            "speakerId": 30153,
            "speakerName": "宏朗",
            "text": "在这样的过程中，我们也许能找出这个秘境变化的某些规律，从而找到我们想要的答案。"
          }
        }
      }
    },

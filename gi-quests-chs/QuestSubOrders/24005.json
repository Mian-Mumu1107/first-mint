          },
          "240051102": {
            "id": "240051102",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "之前没有呀，但自从和你爸爸一起读过书之后，哥哥就变成这样了，成天皱着眉，不知道在想什么。",
            "nextDialogs": [
              "240051103"
            ]
          },
          "240051103": {
            "id": "240051103",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "呜哇…和我爸爸一样。我妈妈说，他就像是在和什么东西较劲一样。",
            "nextDialogs": [
              "240051104"
            ]
          },
          "240051104": {
            "id": "240051104",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "那他到底是在和什么东西较劲呀？难道…是和你妈妈吵架了？",
            "nextDialogs": [
              "240051105"
            ]
          },
          "240051105": {
            "id": "240051105",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "才不是呢！爸爸和妈妈从来没有吵过架。",
            "nextDialogs": [
              "240051106"
            ]
          },
          "240051106": {
            "id": "240051106",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "大人真奇怪啊…"
          }
        }
      }
    },

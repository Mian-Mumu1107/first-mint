{
  "lineCounts": {
    "Black Screen": 1,
    "Player": 11,
    "奥雷勒": 25,
    "洛薇": 30,
    "路易": 6,
    "韦吕": 17
  },
  "subQuests": [
    {
      "subId": "2400501",
      "subQuestName": "与韦吕对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240050101"
        ],
        "dialogs": {
          "240050101": {
            "id": "240050101",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "哥哥，快点快点，走这边啦。那边的大房子我们还没看过。",
            "nextDialogs": [
              "240050102"
            ]
          },
          "240050102": {
            "id": "240050102",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "走慢点，别又摔着了。洛薇你也是，你爸爸说你身体不好，可不要着凉了。",
            "nextDialogs": [
              "240050103"
            ]
          },
          "240050103": {
            "id": "240050103",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "呜哇，你哥哥好啰嗦，和我妈妈一样。",
            "nextDialogs": [
              "240050104"
            ]
          },
          "240050104": {
            "id": "240050104",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "我也这么觉得！",
            "nextDialogs": [
              "240050105"
            ]
          },
          "240050105": {
            "id": "240050105",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "你们两个…",
            "nextDialogs": [
              "240050108"
            ]
          },
          "240050108": {
            "id": "240050108",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "#{M#大哥哥}{F#大姐姐}好！又见面啦，这次我们可没有玩捉迷藏了。",
            "nextDialogs": [
              "240050109"
            ]
          },
          "240050109": {
            "id": "240050109",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "准确地来说，是刚刚已经玩过了…还被诺尔小姐给训斥了一顿。",
            "nextDialogs": [
              "240050110"
            ]
          },
          "240050110": {
            "id": "240050110",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "诺尔姐姐在工作的时候一直那么严肃，总是爱教训人，亏我还请她吃过饼干呢！",
            "nextDialogs": [
              "240050111"
            ]
          },
          "240050111": {
            "id": "240050111",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "不过，反正也玩累了，我正想带奥雷勒和韦吕到处逛逛，吃点好吃的呢。",
            "nextDialogs": [
              "240050112"
            ]
          },
          "240050112": {
            "id": "240050112",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "#{M#大哥哥}{F#大姐姐}，你想和我们一起…嗯…那个叫什么来着？",
            "nextDialogs": [
              "240050113"
            ]
          },
          "240050113": {
            "id": "240050113",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "散步。",
            "nextDialogs": [
              "240050114"
            ]
          },
          "240050114": {
            "id": "240050114",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "对，和我们一起散步吧！",
            "nextDialogs": [
              "240050115"
            ]
          },
          "240050115": {
            "id": "240050115",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "我们快去那边的广场看看吧，我还想去看看喷泉！"
          }
        }
      }
    },
    {
      "subId": "2400502",
      "subQuestName": "前往广场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240050201"
        ],
        "dialogs": {
          "240050201": {
            "id": "240050201",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "哇…好想进去踩水，或者用喷泉洗个澡？",
            "nextDialogs": [
              "240050202"
            ]
          },
          "240050202": {
            "id": "240050202",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "这样肯定会挨骂的啦，在外面看看就好了。",
            "nextDialogs": [
              "240050203"
            ]
          },
          "240050203": {
            "id": "240050203",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "但是，既然不让人进去玩，那把喷泉做这么大干嘛呀？",
            "nextDialogs": [
              "240050204"
            ]
          },
          "240050204": {
            "id": "240050204",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "就算它再好看，如果只能看的话，那也就是一池子普通的水而已，一点意思也没有。",
            "nextDialogs": [
              "240050205"
            ]
          },
          "240050205": {
            "id": "240050205",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "这里可不是普通的喷泉啦。不过…爸爸倒是说过其他的普通喷泉，他怎么说来着…",
            "nextDialogs": [
              "240050206"
            ]
          },
          "240050206": {
            "id": "240050206",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "「枫丹廷市政美化工程最大的作用，是灵活地解决报税问题。」",
            "nextDialogs": [
              "240050207"
            ]
          },
          "240050207": {
            "id": "240050207",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "今天德勒吕叔叔刚和我讲解过这方面的问题。",
            "nextDialogs": [
              "240050208"
            ]
          },
          "240050208": {
            "id": "240050208",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "就连说话的语气，和我爸爸一模一样…怪不得爸爸这么喜欢奥雷勒哥哥，每次都要拿一大堆书去和你聊天。",
            "nextDialogs": [
              "240050209"
            ]
          },
          "240050209": {
            "id": "240050209",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "虽然听不懂，但哥哥肯定又在说扫兴的话了。",
            "nextDialogs": [
              "240050210"
            ]
          },
          "240050210": {
            "id": "240050210",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "洛薇，我们快去下个地方玩吧，今天你好不容易不用学习了。",
            "nextDialogs": [
              "240050211"
            ]
          },
          "240050211": {
            "id": "240050211",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "嗯，我们接下来去看看其他地方吧，我想想…报社应该还开着门，我们去那里吧！"
          }
        }
      }
    },
    {
      "subId": "2400503",
      "subQuestName": "前往「蒸汽鸟报」报社",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240050301"
        ],
        "dialogs": {
          "240050301": {
            "id": "240050301",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "这里就是「蒸汽鸟报」报社吗，看起来是不是…完全没什么特别的？",
            "nextDialogs": [
              "240050304"
            ]
          },
          "240050304": {
            "id": "240050304",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "哇！居然真的有机械鸟！好厉害！",
            "nextDialogs": [
              "240050305"
            ]
          },
          "240050305": {
            "id": "240050305",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "厉害吧？爸爸经常带我来这里买报纸。",
            "nextDialogs": [
              "240050306"
            ]
          },
          "240050306": {
            "id": "240050306",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "他可喜欢「蒸汽鸟报」了，每天早上都会拿着报纸看个不停。偶尔还会把报纸上的一部分剪下来，贴在一个本子上保存起来。",
            "nextDialogs": [
              "240050307"
            ]
          },
          "240050307": {
            "id": "240050307",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "爸爸说这是他所发表的「评论」，有时候他甚至会自己读那些评论给我和妈妈听。",
            "nextDialogs": [
              "240050308"
            ]
          },
          "240050308": {
            "id": "240050308",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "我们俩可不喜欢听，一直用「好啊」，「是吗」或者「原来如此」来回答他，但爸爸根本没察觉到，自己读得可开心了。",
            "nextDialogs": [
              "240050309"
            ]
          },
          "240050309": {
            "id": "240050309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「评论」是什么？",
            "nextDialogs": [
              "240050310"
            ]
          },
          "240050310": {
            "id": "240050310",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "如果简单来说，「评论」就是从评论家自己的观点出发，对某件事发表一些意见。",
            "nextDialogs": [
              "240050311"
            ]
          },
          "240050311": {
            "id": "240050311",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "洛薇的父亲，德勒吕叔叔是一位枫丹科学院的科学家。",
            "nextDialogs": [
              "240050320"
            ]
          },
          "240050320": {
            "id": "240050320",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "同时，也是一位经常在「蒸汽鸟报」上发表「评论」的「评论家」。",
            "nextDialogs": [
              "240050312"
            ]
          },
          "240050312": {
            "id": "240050312",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "对呀，爸爸对任何事情都喜欢长篇大论地发表「评论」。",
            "nextDialogs": [
              "240050313"
            ]
          },
          "240050313": {
            "id": "240050313",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "有时候说着说着，他就会和想起什么一样，冲回屋里闷头写稿，连饭都不吃，只是一个劲地喝茶。",
            "nextDialogs": [
              "240050314"
            ]
          },
          "240050314": {
            "id": "240050314",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "欸…还有这种只用发表意见就能赚钱的职业吗？",
            "nextDialogs": [
              "240050315"
            ]
          },
          "240050315": {
            "id": "240050315",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "光是发表意见可称不上是「评论家」。如果想要发表一篇值得被认可的评论，首先要遵循几个要素…",
            "nextDialogs": [
              "240050316"
            ]
          },
          "240050316": {
            "id": "240050316",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "#那个…那个…韦吕！还有{M#大哥哥}{F#大姐姐}，你们肚子饿了吗？",
            "nextDialogs": [
              "240050317"
            ]
          },
          "240050317": {
            "id": "240050317",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "路易哥哥前几天和我说，他最近会卖泡泡桔味的薯条，我们快去买了尝尝吧，我们请你们！",
            "nextDialogs": [
              "240050318"
            ]
          },
          "240050318": {
            "id": "240050318",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "喔…哦！好！哥哥别唠叨了，快走啦！",
            "nextDialogs": [
              "240050319"
            ]
          },
          "240050319": {
            "id": "240050319",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "你们啊…"
          }
        }
      }
    },
    {
      "subId": "2400504",
      "subQuestName": "与路易对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240050401"
        ],
        "dialogs": {
          "240050401": {
            "id": "240050401",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "路易哥哥！我要买几份泡泡桔味的薯条！",
            "nextDialogs": [
              "240050402"
            ]
          },
          "240050402": {
            "id": "240050402",
            "speakerId": 5057,
            "speakerName": "路易",
            "text": "是洛薇啊，真不好意思，今天港口上的人特别多，我准备的泡泡桔全用光了。",
            "nextDialogs": [
              "240050403"
            ]
          },
          "240050403": {
            "id": "240050403",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "我，我都提前好久说过了，我还专门带了朋友过来吃呢…",
            "nextDialogs": [
              "240050404"
            ]
          },
          "240050404": {
            "id": "240050404",
            "speakerId": 5057,
            "speakerName": "路易",
            "text": "唉，客人太多，我一下子给忘记了…这里还剩下一些普通的薯条，就不收你们钱了，拿去吃吧。",
            "nextDialogs": [
              "240050405"
            ]
          },
          "240050405": {
            "id": "240050405",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "好吧，谢谢路易哥哥…",
            "nextDialogs": [
              "240050408"
            ]
          },
          "240050408": {
            "id": "240050408",
            "speakerId": 5057,
            "speakerName": "路易",
            "text": "如果真有泡泡桔的话，我倒是可以马上做一批泡泡桔酱出来，其他的调味料也剩下一些…",
            "nextDialogs": [
              "240050409"
            ]
          },
          "240050409": {
            "id": "240050409",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "#好欸！{M#大哥哥}{F#大姐姐}最厉害了！",
            "nextDialogs": [
              "240050410"
            ]
          },
          "240050410": {
            "id": "240050410",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "#谢谢{M#大哥哥}{F#大姐姐}！",
            "nextDialogs": [
              "240050411"
            ]
          },
          "240050411": {
            "id": "240050411",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "真是不好意思，每次遇见我们的时候，都要麻烦你一阵。"
          }
        }
      }
    },
    {
      "subId": "2400505",
      "subQuestName": "将泡泡桔带给路易",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240050501"
        ],
        "dialogs": {
          "240050501": {
            "id": "240050501",
            "speakerId": 5057,
            "speakerName": "路易",
            "text": "你已经把泡泡桔拿回来了吗？"
          }
        }
      }
    },
    {
      "subId": "2400506",
      "subQuestName": "将泡泡桔带给路易",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240050601"
        ],
        "dialogs": {
          "240050601": {
            "id": "240050601",
            "speakerId": 5057,
            "speakerName": "路易",
            "text": "这些就足够了，稍等一会啊…",
            "nextDialogs": [
              "240050602"
            ]
          },
          "240050602": {
            "id": "240050602",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "路易开始制作泡泡桔酱…",
            "nextDialogs": [
              "240050603"
            ]
          },
          "240050603": {
            "id": "240050603",
            "speakerId": 5057,
            "speakerName": "路易",
            "text": "行了！刚刚出炉的泡泡桔薯条，这几份不收你们钱，直接吃吧，小心烫！",
            "nextDialogs": [
              "240050604"
            ]
          },
          "240050604": {
            "id": "240050604",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "#好欸！{M#大哥哥}{F#大姐姐}，韦吕还有奥雷勒哥哥，快尝尝吧，可好吃了。",
            "nextDialogs": [
              "240050605"
            ]
          },
          "240050605": {
            "id": "240050605",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "对了，奥雷勒哥哥，你可不能告诉我爸爸，不然他又要训我了…",
            "nextDialogs": [
              "240050606"
            ]
          },
          "240050606": {
            "id": "240050606",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "噗…放心吧，我觉得德勒吕叔叔应该对薯条不感兴趣。",
            "nextDialogs": [
              "240050607"
            ]
          },
          "240050607": {
            "id": "240050607",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "哥，那…我呢？",
            "nextDialogs": [
              "240050608"
            ]
          },
          "240050608": {
            "id": "240050608",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "你也快点吃吧，我的那一份你们分掉就好，我不太喜欢吃这东西。",
            "nextDialogs": [
              "240050609"
            ]
          },
          "240050609": {
            "id": "240050609",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "#嘿嘿嘿，那我可要开吃了！{M#大哥哥}{F#大姐姐}，快尝尝吧。",
            "nextDialogs": [
              "240050610"
            ]
          },
          "240050610": {
            "id": "240050610",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "对了，等会我还要去买点咖啡带给德勒吕叔叔…",
            "nextDialogs": [
              "240050611"
            ]
          },
          "240050611": {
            "id": "240050611",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "等下，这可不行！妈妈已经禁止爸爸喝咖啡好久啦。",
            "nextDialogs": [
              "240050612"
            ]
          },
          "240050612": {
            "id": "240050612",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "每次爸爸喝完咖啡之后，都会整夜在屋子里咳嗽个不停，说话的声音也会哑掉。",
            "nextDialogs": [
              "240050613"
            ]
          },
          "240050613": {
            "id": "240050613",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "爸爸说这都是为了工作，但有哪份工作会让人难受成这样呀？",
            "nextDialogs": [
              "240050614"
            ]
          },
          "240050614": {
            "id": "240050614",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "…这就是德勒吕叔叔和我说的，写出优秀「评论」的代价吗？",
            "nextDialogs": [
              "240050615"
            ]
          },
          "240050615": {
            "id": "240050615",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "评论家这种职业，可真是难做啊…"
          }
        }
      }
    },

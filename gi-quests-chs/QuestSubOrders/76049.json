  },
  "subQuests": [
    {
      "subId": "7604901",
      "subQuestName": "同「少女」见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490603"
        ],
        "dialogs": {
          "760490603": {
            "id": "760490603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "平和的乐调…",
            "nextDialogs": [
              "760490604"
            ]
          },
          "760490604": {
            "id": "760490604",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "好听。我平时哼的旋律，原来你都记下来了。",
            "nextDialogs": [
              "760490605"
            ]
          },
          "760490605": {
            "id": "760490605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，因为你唱歌很好听嘛，我们有时会悄悄在旁边听上一会儿。",
            "nextDialogs": [
              "760490606"
            ]
          },
          "760490606": {
            "id": "760490606",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "月灵们也听得入迷了。不知道它们有没有学会。",
            "nextDialogs": [
              "760490607"
            ]
          },
          "760490607": {
            "id": "760490607",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "说不定，以后还得多请你们教几次。",
            "nextDialogs": [
              "760490608"
            ]
          },
          "760490608": {
            "id": "760490608",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "来吧，把手给我。",
            "nextDialogs": [
              "760490609"
            ]
          },
          "760490609": {
            "id": "760490609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？我们这是无偿演出，不用收学费的！",
            "nextDialogs": [
              "760490610"
            ]
          },
          "760490610": {
            "id": "760490610",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯？学费？",
            "nextDialogs": [
              "760490611"
            ]
          },
          "760490611": {
            "id": "760490611",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我只是觉得，好听的旋律，应该有美丽的月光相伴。"
          }
        }
      }
    },
    {
      "subId": "7604901",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490101"
        ],
        "dialogs": {
          "760490101": {
            "id": "760490101",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "…好像调子高了一些，再试试？",
            "nextDialogs": [
              "760490102"
            ]
          },
          "760490102": {
            "id": "760490102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哥伦比娅！你好呀。",
            "nextDialogs": [
              "760490103"
            ]
          },
          "760490103": {
            "id": "760490103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？你今天是在…教月灵弹琴吗？",
            "nextDialogs": [
              "760490104"
            ]
          },
          "760490104": {
            "id": "760490104",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，之前修好琴后，月灵们很开心，每天都缠着我。",
            "nextDialogs": [
              "760490105"
            ]
          },
          "760490105": {
            "id": "760490105",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "但我其实不是很会弹琴，之前都是听别人弹。",
            "nextDialogs": [
              "760490106"
            ]
          },
          "760490106": {
            "id": "760490106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，可以理解，感觉如果组乐队的话，哥伦比娅是专门负责唱歌的角色呢。",
            "nextDialogs": [
              "760490107"
            ]
          },
          "760490107": {
            "id": "760490107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不过，说到乐器，这家伙可是特别擅长呢！从蒙德的「诗琴」到纳塔的「聚聚鼓」，{M#他}{F#她}都十分精通呢！",
            "nextDialogs": [
              "760490110"
            ]
          },
          "760490110": {
            "id": "760490110",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "是吗？那…不如你来教它们弹？"
          }
        }
      }
    },
    {
      "subId": "7604903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490301"
        ],
        "dialogs": {
          "760490301": {
            "id": "760490301",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "今天月灵们很满足了。但以后，或许还会再麻烦你们来教它们。"
          }
        }
      }
    },
    {
      "subId": "7604907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760490709"
        ],
        "dialogs": {
          "760490709": {
            "id": "760490709",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "如今我们穿过云雾，一同见到了月亮上的那个答案…它的美好就如你此刻的琴声。"
          }
        }
      }
    }
  ]
}
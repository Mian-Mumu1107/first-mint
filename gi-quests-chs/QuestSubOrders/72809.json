    {
      "subId": "7280905",
      "subQuestName": "观察哈里森",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728090108"
        ],
        "dialogs": {
          "728090108": {
            "id": "728090108",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "这些东西总算是送到了…",
            "nextDialogs": [
              "728090109"
            ]
          },
          "728090109": {
            "id": "728090109",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "拖了这么长时间，真是…",
            "nextDialogs": [
              "728090110"
            ]
          },
          "728090110": {
            "id": "728090110",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "这箱怎么还破了个角，哎哟！",
            "nextDialogs": [
              "728090111"
            ]
          },
          "728090111": {
            "id": "728090111",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "叫他小心点！不会把里面的东西给碰碎了吧…",
            "nextDialogs": [
              "728090112"
            ]
          },
          "728090112": {
            "id": "728090112",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "还好，没有瓶子碰碎…",
            "nextDialogs": [
              "728090113"
            ]
          },
          "728090113": {
            "id": "728090113",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "咦？这瓶的盖子怎么松了…得先拧下来，再装上去才行…",
            "nextDialogs": [
              "728090114"
            ]
          },
          "728090114": {
            "id": "728090114",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "咳！咳…这调酒材料的味道可真是…太激烈了，还是快点搬走…",
            "nextDialogs": [
              "728090115"
            ]
          },
          "728090115": {
            "id": "728090115",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "欸，什么，怎么这么多史莱姆？！"
          }
        }
      }
    },
    {
      "subId": "7280906",
      "subQuestName": "打倒所有史莱姆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7280907",
      "subQuestName": "与哈里森对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728090204"
        ],
        "dialogs": {
          "728090204": {
            "id": "728090204",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "谢谢，谢谢，太谢谢你了，旅行者…",
            "nextDialogs": [
              "728090205"
            ]
          },
          "728090205": {
            "id": "728090205",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "要是没你帮忙，我今天非折在这里不可。",
            "nextDialogs": [
              "728090207",
              "728090209"
            ]
          },
          "728090207": {
            "id": "728090207",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "呃…算是吧。",
            "nextDialogs": [
              "728090210"
            ]
          },
          "728090210": {
            "id": "728090210",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "你们也知道，在离岛做生意可不容易，这个营地…算是我做生意的一点小诀窍。",
            "nextDialogs": [
              "728090211"
            ]
          },
          "728090211": {
            "id": "728090211",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "前些日子，我托一位…朋友，从蒙德那边给我带一批酿酒材料过来。",
            "nextDialogs": [
              "728090212"
            ]
          },
          "728090212": {
            "id": "728090212",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "他前不久拜托一个朋友从「晨曦酒庄」那里拿到了一批试做的新货，这几天刚运过来。",
            "nextDialogs": [
              "728090213"
            ]
          },
          "728090213": {
            "id": "728090213",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "可是那家伙手脚没轻没重，把箱子碰坏了，里面装着的一瓶酿酒材料的盖子也松了。",
            "nextDialogs": [
              "728090214"
            ]
          },
          "728090214": {
            "id": "728090214",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "我就想去把盖子先拧下来，然后再重新装上去。",
            "nextDialogs": [
              "728090215"
            ]
          },
          "728090215": {
            "id": "728090215",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "没想到，我刚拧开盖子，一堆史莱姆就冲了过来，真是莫名其妙…",
            "nextDialogs": [
              "728090216"
            ]
          },
          "728090216": {
            "id": "728090216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「晨曦酒庄」的酿酒材料吗…",
            "nextDialogs": [
              "728090217"
            ]
          },
          "728090217": {
            "id": "728090217",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "算了，先不管了，酿酒材料的事，等那家伙下次过来的时候，我再和他算账。",
            "nextDialogs": [
              "728090218"
            ]
          },
          "728090218": {
            "id": "728090218",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "你们救了我，我得给你们点谢礼才行…这些东西你们先收下。",
            "nextDialogs": [
              "728090219"
            ]
          },
          "728090219": {
            "id": "728090219",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "除了这些之外，你们看见旁边的那艘小船了吗？那是我的另外一个…小诀窍。",
            "nextDialogs": [
              "728090220"
            ]
          },
          "728090220": {
            "id": "728090220",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "用那艘船，你们就可以从这里悄悄地前往鸣神岛了，嘿嘿，是不是非常方便？",
            "nextDialogs": [
              "728090221"
            ]
          },
          "728090221": {
            "id": "728090221",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我为什么要「悄悄的」…",
            "nextDialogs": [
              "728090222"
            ]
          },
          "728090222": {
            "id": "728090222",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "哎呀，总之…以备不时之需嘛。",
            "nextDialogs": [
              "728090223"
            ]
          },
          "728090223": {
            "id": "728090223",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "好了，我还得回去清点货物，就先不在这里多待了，再次谢谢你了，旅行者。",
            "nextDialogs": [
              "728090224"
            ]
          },
          "728090224": {
            "id": "728090224",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "看来我得再换个接货的地方了…"
          },
          "728090209": {
            "id": "728090209",
            "speakerId": 3083,
            "speakerName": "哈里森",
            "text": "我…在这搬货呢，哈哈哈，搬货呢…"
          }
        }
      }
    }
  ]
}
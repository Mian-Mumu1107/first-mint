    {
      "subId": "1402202",
      "subQuestName": "前往厄舍的工厂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140220201"
        ],
        "dialogs": {
          "140220201": {
            "id": "140220201",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "你们来啦。",
            "nextDialogs": [
              "140220202"
            ]
          },
          "140220202": {
            "id": "140220202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "千织！衣服的制作还顺利吗？你看起来有些累。",
            "nextDialogs": [
              "140220203"
            ]
          },
          "140220203": {
            "id": "140220203",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "还剩最后几道工序，已经交给爱洛芙了。应该能赶上晚上的时装秀。",
            "nextDialogs": [
              "140220204"
            ]
          },
          "140220204": {
            "id": "140220204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这时间掐得好危险…你不去没事吗？",
            "nextDialogs": [
              "140220205"
            ]
          },
          "140220205": {
            "id": "140220205",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "放心，我哪边都没打算输。况且今晚时装秀，厄舍工厂停业，要找证据的话这是我们唯一的机会。",
            "nextDialogs": [
              "140220206"
            ]
          },
          "140220206": {
            "id": "140220206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然是他有错在先，但我们这么闯进去，是不是也算犯罪呀？",
            "nextDialogs": [
              "140220207"
            ]
          },
          "140220207": {
            "id": "140220207",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "他的工厂平时也开放参观。今天说的是停业，没说停止参观。",
            "nextDialogs": [
              "140220208"
            ]
          },
          "140220208": {
            "id": "140220208",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "我们只是好奇的顾客而已，有什么问题吗？",
            "nextDialogs": [
              "140220209"
            ]
          },
          "140220209": {
            "id": "140220209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你要是这么说的话…",
            "nextDialogs": [
              "140220210"
            ]
          },
          "140220210": {
            "id": "140220210",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "好了，厄舍的工厂就是那间。抓紧时间，该行动了。",
            "nextDialogs": [
              "140220211"
            ]
          },
          "140220211": {
            "id": "140220211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…怎么会开在那种地方…",
            "nextDialogs": [
              "140220212"
            ]
          },
          "140220212": {
            "id": "140220212",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "营销策略不同，「千织屋」主打高级定制，他主打便宜多销。可能这里租金便宜吧。",
            "nextDialogs": [
              "140220213"
            ]
          },
          "140220213": {
            "id": "140220213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好吧，只是看起来阴森森的，我绝对不会去那里买衣服。",
            "nextDialogs": [
              "140220214"
            ]
          },
          "140220214": {
            "id": "140220214",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "你说得对，待会儿也多加小心。"
          }
        }
      }
    },
    {
      "subId": "1402210",
      "subQuestName": "进入厄舍的工厂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140221001"
        ],
        "dialogs": {
          "140221001": {
            "id": "140221001",
            "speakerId": 1002,
            "speakerName": "本子上的备忘录",
            "text": "「…宣传支出十万摩拉、雇佣支出二十万摩拉、原料支出…」"
          }
        }
      }
    },
    {
      "subId": "1402215",
      "subQuestName": "调查厄舍的工厂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140221501"
        ],
        "dialogs": {
          "140221501": {
            "id": "140221501",
            "speakerId": 1003,
            "speakerName": "桌上散落的笔记",
            "text": "寄给夏沃蕾的信——",
            "nextDialogs": [
              "140221502"
            ]
          },
          "140221502": {
            "id": "140221502",
            "speakerId": 1003,
            "speakerName": "桌上散落的笔记",
            "text": "执律庭…的职员，于店内提及上司与…的交易，语气确凿…",
            "nextDialogs": [
              "140221503"
            ]
          },
          "140221503": {
            "id": "140221503",
            "speakerId": 1003,
            "speakerName": "桌上散落的笔记",
            "text": "有人于…目击到通缉犯…出没，恐怕是谣言…"
          }
        }
      }
    },
    {
      "subId": "1402203",
      "subQuestName": "在周围调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140220601"
        ],
        "dialogs": {
          "140220601": {
            "id": "140220601",
            "speakerId": 1004,
            "speakerName": "书柜上的纸张",
            "text": "（看起来像是以前的设计手稿，没有什么特别的地方。）"
          }
        }
      }
    },
    {
      "subId": "1402212",
      "subQuestName": "在周围调查",
      "sceneId": null,
      "locations": [],

      }
    },
    {
      "subId": "1402213",
      "subQuestName": "在周围调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140221101"
        ],
        "dialogs": {
          "140221101": {
            "id": "140221101",
            "speakerId": 1005,
            "speakerName": "桌上的笔记",
            "text": "「…快递员…将于…上午进城，途经…」"
          }
        }
      }
    },
    {
      "subId": "1402214",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140221401"
        ],
        "dialogs": {
          "140221401": {
            "id": "140221401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看起来是类似仓库的地方呢，呜…这里也臭烘烘的。",
            "nextDialogs": [
              "140221402"
            ]
          },
          "140221402": {
            "id": "140221402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃！怎么回事？进来的路被堵住了！",
            "nextDialogs": [
              "140221403"
            ]
          },
          "140221403": {
            "id": "140221403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是想把我们困在工厂里…",
            "nextDialogs": [
              "140221404"
            ]
          },
          "140221404": {
            "id": "140221404",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "……",
            "nextDialogs": [
              "140221405"
            ]
          },
          "140221405": {
            "id": "140221405",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "看来他知道我们会来。",
            "nextDialogs": [
              "140221406"
            ]
          },
          "140221406": {
            "id": "140221406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我记得千织你之前好像说，厄舍那家伙很了解你？",
            "nextDialogs": [
              "140221407"
            ]
          },
          "140221407": {
            "id": "140221407",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "嗯，其实…厄舍是我最初的合作伙伴。",
            "nextDialogs": [
              "140221408"
            ]
          },
          "140221408": {
            "id": "140221408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？完全看不出来！你们俩关系明明这么差！",
            "nextDialogs": [
              "140221409"
            ]
          },
          "140221409": {
            "id": "140221409",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "刚到枫丹的时候，我和他都是向往步入「时尚」舞台的设计师。为了共同的目标，我们合作过一段时间。",
            "nextDialogs": [
              "140221410"
            ]
          },
          "140221410": {
            "id": "140221410",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "原本我们都想做出与众不同、突破传统、让所有人都惊叹的服装…",
            "nextDialogs": [
              "140221411"
            ]
          },
          "140221411": {
            "id": "140221411",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "但随着别人的一声声否定、投资人的一次次摇头…厄舍渐渐失去了信心。",
            "nextDialogs": [
              "140221412"
            ]
          },
          "140221412": {
            "id": "140221412",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "终于，在时装周前夕，他断定我们做不出理想中的衣服了，和我分道扬镳。",
            "nextDialogs": [
              "140221413"
            ]
          },
          "140221413": {
            "id": "140221413",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "我本着孤注一掷的心情，倾尽所有…在最后一天做出了满意的服装，怀着忐忑的心情参加了时装秀。",
            "nextDialogs": [
              "140221414"
            ]
          },
          "140221414": {
            "id": "140221414",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "结果就是千织你一举成名，但厄舍却放弃了自己的梦想，转而做起这种亏心的衣服吗？",
            "nextDialogs": [
              "140221415"
            ]
          },
          "140221415": {
            "id": "140221415",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "具体怎样我不知道，但我开了「千织屋」后，他每年都会给我使绊子这事是真的。",
            "nextDialogs": [
              "140221416"
            ]
          },
          "140221416": {
            "id": "140221416",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼！我看他就是嫉妒你的成就，我可一点都不同情他！",
            "nextDialogs": [
              "140221417"
            ]
          },
          "140221417": {
            "id": "140221417",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "不管怎么说，还是先想想怎么逃出去吧。",
            "nextDialogs": [
              "140221418"
            ]
          },
          "140221418": {
            "id": "140221418",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "要是赶不上时装秀，那就真让他得逞了。",
            "nextDialogs": [
              "140221419"
            ]
          },
          "140221419": {
            "id": "140221419",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，那边有几个操作台！去看看有没有什么能动的按钮吧！"
          }
        }
      }
    },
    {
      "subId": "1402216",
      "subQuestName": "调查试衣间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140221601"
        ],
        "dialogs": {
          "140221601": {
            "id": "140221601",
            "speakerId": 1003,
            "speakerName": "桌上散落的笔记",
            "text": "艾梅莉埃寄来的信——",
            "nextDialogs": [
              "140221602"
            ]
          },
          "140221602": {
            "id": "140221602",
            "speakerId": 1003,
            "speakerName": "桌上散落的笔记",
            "text": "…非常感谢千织小姐对于香氛的宝贵意见，信中附上新款样品，是我最近尝试的海露香调…",
            "nextDialogs": [
              "140221603"
            ]
          },
          "140221603": {
            "id": "140221603",
            "speakerId": 1003,
            "speakerName": "桌上散落的笔记",
            "text": "另外，关于下一次试香的安排…"
          }
        }
      }
    },
    {
      "subId": "1402204",
      "subQuestName": "深入工厂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140221201"
        ],
        "dialogs": {
          "140221201": {
            "id": "140221201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里看起来好脏啊，上面的衣服真的是在这里做出来的吗？",
            "nextDialogs": [
              "140221202"
            ]
          },
          "140221202": {
            "id": "140221202",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "…你们看那边。",
            "nextDialogs": [
              "140221203"
            ]
          },
          "140221203": {
            "id": "140221203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜…好脏的水。我在这里都闻见臭味了。",
            "nextDialogs": [
              "140221204"
            ]
          },
          "140221204": {
            "id": "140221204",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "厄舍这家伙，还敢说我的用料有问题。",
            "nextDialogs": [
              "140221205"
            ]
          },
          "140221205": {
            "id": "140221205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "搞半天，是他自己开了个黑心工厂…",
            "nextDialogs": [
              "140221206"
            ]
          },
          "140221206": {
            "id": "140221206",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "我说他做的衣服怎么摸起来怪怪的…",
            "nextDialogs": [
              "140221207"
            ]
          },
          "140221207": {
            "id": "140221207",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "原来是为了削减成本，偷偷在工厂里搞这些小动作…",
            "nextDialogs": [
              "140221208"
            ]
          },
          "140221208": {
            "id": "140221208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这样做出来的衣服能穿吗？",
            "nextDialogs": [
              "140221209"
            ]
          },
          "140221209": {
            "id": "140221209",
            "speakerId": 1000,
            "speakerName": "千织",
            "text": "褪色和缩水都是小事了，这不正规的用料…穿多了皮肤都要出问题。",
            "nextDialogs": [
              "140221210"
            ]
          },
          "140221210": {
            "id": "140221210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好可怕…我们快把这些证据拍下来吧！",
            "nextDialogs": [
              "140221211"
            ]
          },
          "140221211": {
            "id": "140221211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这样他在审判庭上就无话可说了！我们继续前进吧。"
          }
        }
      }
    },
    {

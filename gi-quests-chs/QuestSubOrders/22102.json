  "subQuests": [
    {
      "subId": "2210201",
      "subQuestName": "与淮安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221020101"
        ],
        "dialogs": {
          "221020101": {
            "id": "221020101",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "真是麻烦哪…",
            "nextDialogs": [
              "221020102"
            ]
          },
          "221020102": {
            "id": "221020102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "221020103"
            ]
          },
          "221020103": {
            "id": "221020103",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "您看我这黑眼圈，我已经多少天没睡过好觉了…",
            "nextDialogs": [
              "221020104"
            ]
          },
          "221020104": {
            "id": "221020104",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "您见过客栈里的客人吗？那真是，一个比一个会折腾，我们这客栈这么高，也真有人敢往下跳…",
            "nextDialogs": [
              "221020105"
            ]
          },
          "221020105": {
            "id": "221020105",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "算了，我刚从城里订了批菜，现在估计快要到了。",
            "nextDialogs": [
              "221020106"
            ]
          },
          "221020106": {
            "id": "221020106",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "这路上的怪物啊，肯定也不会乖乖休息，能劳烦您帮我去清一清路吗？",
            "nextDialogs": [
              "221020109",
              "221020110"
            ]
          },
          "221020109": {
            "id": "221020109",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "那就拜托您了。"
          },
          "221020110": {
            "id": "221020110",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "「广收天下客，遍听四海声」…我是这么想来着。",
            "nextDialogs": [
              "221020111"
            ]
          },
          "221020111": {
            "id": "221020111",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "不过，其实也就是间客栈，就是地方偏了点，客人多了点，没什么了不起的。",
            "nextDialogs": [
              "221020112"
            ]
          },
          "221020112": {
            "id": "221020112",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "那么，就万事拜托您了。"
          }
        }
      }
    },
    {
      "subId": "2210202",
      "subQuestName": "清剿附近的魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221020201"
        ],
        "dialogs": {
          "221020201": {
            "id": "221020201",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "怎么样？周围的怪物都清干净了吗？",
            "nextDialogs": [
              "221020202"
            ]
          },
          "221020202": {
            "id": "221020202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有。",
            "nextDialogs": [
              "221020203"
            ]
          },
          "221020203": {
            "id": "221020203",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "请您快些吧，这厨子快没菜下锅了。",
            "nextDialogs": [
              "221020204"
            ]
          },
          "221020204": {
            "id": "221020204",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "实在不行，我得自己出去一趟了…"
          }
        }
      }
    },
    {
      "subId": "2210203",
      "subQuestName": "向淮安回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221020301"
        ],
        "dialogs": {
          "221020301": {
            "id": "221020301",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "怎么样？周围的怪物都清干净了吗？",
            "nextDialogs": [
              "221020302"
            ]
          },
          "221020302": {
            "id": "221020302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经清干净了。",
            "nextDialogs": [
              "221020303"
            ]
          },
          "221020303": {
            "id": "221020303",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "那就好，辛苦您了。",
            "nextDialogs": [
              "221020304"
            ]
          },
          "221020304": {
            "id": "221020304",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "这是报酬您拿好。要是以后路过，您记得过来光顾。"
          }
        }
      }
    }
  ]
}
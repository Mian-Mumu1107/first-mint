    {
      "subId": "7218402",
      "subQuestName": "与梨绘对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721840201"
        ],
        "dialogs": {
          "721840201": {
            "id": "721840201",
            "speakerId": 1000,
            "speakerName": "梨绘",
            "text": "你好呀，有什么事找我吗？",
            "nextDialogs": [
              "721840202"
            ]
          },
          "721840202": {
            "id": "721840202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于「木南料亭」的披萨…",
            "nextDialogs": [
              "721840203"
            ]
          },
          "721840203": {
            "id": "721840203",
            "speakerId": 1000,
            "speakerName": "梨绘",
            "text": "哦，你说那个披萨啊，味道确实很不错。",
            "nextDialogs": [
              "721840204"
            ]
          },
          "721840204": {
            "id": "721840204",
            "speakerId": 1000,
            "speakerName": "梨绘",
            "text": "但是…怎么说呢，总感觉不太吃得惯呢。",
            "nextDialogs": [
              "721840205"
            ]
          },
          "721840205": {
            "id": "721840205",
            "speakerId": 1000,
            "speakerName": "梨绘",
            "text": "我个人是觉得，要是能在那种披萨里融入一些稻妻本地食材的话，比如堇瓜之类的…",
            "nextDialogs": [
              "721840206"
            ]
          },
          "721840206": {
            "id": "721840206",
            "speakerId": 1000,
            "speakerName": "梨绘",
            "text": "说不定，这种披萨会更受大家欢迎呢。"
          }
        }
      }
    },
    {
      "subId": "7218403",
      "subQuestName": "向木南杏奈回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721840301"
        ],
        "dialogs": {
          "721840301": {
            "id": "721840301",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "旅行者，你回来了。",
            "nextDialogs": [
              "721840302"
            ]
          },
          "721840302": {
            "id": "721840302",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "怎么样，你有问到什么吗？",
            "nextDialogs": [
              "721840303"
            ]
          },
          "721840303": {
            "id": "721840303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于客人们的反馈…",
            "nextDialogs": [
              "721840304"
            ]
          },
          "721840304": {
            "id": "721840304",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "用堇瓜做的披萨…倒也不会太复杂…",
            "nextDialogs": [
              "721840305"
            ]
          },
          "721840305": {
            "id": "721840305",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "其余的材料就照常准备好了，唔，既然都说要「融入一些稻妻本地食材」了，那我就再加一点其他的材料好了…",
            "nextDialogs": [
              "721840306"
            ]
          },
          "721840306": {
            "id": "721840306",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "唔，海灵芝？鸣草？嗯…幽灯蕈怎么样…",
            "nextDialogs": [
              "721840307"
            ]
          },
          "721840307": {
            "id": "721840307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那个，要我帮忙吗？",
            "nextDialogs": [
              "721840308"
            ]
          },
          "721840308": {
            "id": "721840308",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "喔！抱歉，我光顾着想放什么食材好了！我看看，店里的堇瓜好像没多少了…",
            "nextDialogs": [
              "721840309"
            ]
          },
          "721840309": {
            "id": "721840309",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "旅行者，请你去帮我拿一个堇瓜来吧，材料的话…应该就只差这个了。",
            "nextDialogs": [
              "721840311",
              "721840313"
            ]
          },
          "721840311": {
            "id": "721840311",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "嗯，那就拜托你了，只要一个堇瓜就好。"
          },
          "721840313": {
            "id": "721840313",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "其他的食材店里还有些存货，你带一个堇瓜回来就好，拜托你啦。"
          }
        }
      }
    },
    {
      "subId": "7218404",
      "subQuestName": "将堇瓜带回给木南杏奈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721840401"
        ],
        "dialogs": {
          "721840401": {
            "id": "721840401",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "你把食材带回来了吗？"
          }
        }
      }
    },
    {
      "subId": "7218405",
      "subQuestName": "与木南杏奈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721840501"
        ],
        "dialogs": {
          "721840501": {
            "id": "721840501",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "谢谢你，有这些食材就够了。",
            "nextDialogs": [
              "721840502"
            ]
          },
          "721840502": {
            "id": "721840502",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "加入了稻妻本地食材的披萨，不知道做出来会是什么味道…",
            "nextDialogs": [
              "721840503"
            ]
          },
          "721840503": {
            "id": "721840503",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "完成了！",
            "nextDialogs": [
              "721840504"
            ]
          },
          "721840504": {
            "id": "721840504",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "这披萨…看上去还不错…",
            "nextDialogs": [
              "721840505"
            ]
          },
          "721840505": {
            "id": "721840505",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "谢谢你帮忙，旅行者，这些东西请你收下吧。",
            "nextDialogs": [
              "721840506"
            ]
          },
          "721840506": {
            "id": "721840506",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "我等会就去仔细品尝一下这份披萨的味道…",
            "nextDialogs": [
              "721840507"
            ]
          },
          "721840507": {
            "id": "721840507",
            "speakerId": 1001,
            "speakerName": "木南杏奈",
            "text": "如果还不错的话…应该很快就能作为新品正式推出啦。"
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "4022001",
      "subQuestName": "等到第二天的早上8点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402200101"
        ],
        "dialogs": {
          "402200101": {
            "id": "402200101",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "别自责了，明妮，这不能怪你。",
            "nextDialogs": [
              "402200102"
            ]
          },
          "402200102": {
            "id": "402200102",
            "speakerId": 1001,
            "speakerName": "汤义刚",
            "text": "你已经做得很好了…咳。",
            "nextDialogs": [
              "402200103"
            ]
          },
          "402200103": {
            "id": "402200103",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "义刚，不用安慰我了。你身体要紧，强撑着过来已经很不容易了。",
            "nextDialogs": [
              "402200106"
            ]
          },
          "402200106": {
            "id": "402200106",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}…",
            "nextDialogs": [
              "402200107"
            ]
          },
          "402200107": {
            "id": "402200107",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "我来吧。抱歉，荣誉骑士，我带着伤员走到终点的时候，其他队伍的选手都已经跑完很久了。",
            "nextDialogs": [
              "402200108"
            ]
          },
          "402200108": {
            "id": "402200108",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "救生员已经把人带走检查了，我们队…没有拿到一个像样的成绩，对不起。",
            "nextDialogs": [
              "402200109"
            ]
          },
          "402200109": {
            "id": "402200109",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "明明你们在前面跑得那么快，却因为我被拖累了。",
            "nextDialogs": [
              "402200110"
            ]
          },
          "402200110": {
            "id": "402200110",
            "speakerId": 1004,
            "speakerName": "希诺宁",
            "text": "明妮…",
            "nextDialogs": [
              "402200111"
            ]
          },
          "402200111": {
            "id": "402200111",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "看到那个人受伤的时候，其实我很犹豫。",
            "nextDialogs": [
              "402200112"
            ]
          },
          "402200112": {
            "id": "402200112",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "大家已经努力了这么多天，如果我没有回去拉他的话，我们的成绩就不是现在这样。",
            "nextDialogs": [
              "402200113"
            ]
          },
          "402200113": {
            "id": "402200113",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "救生员和安柏小姐就在附近，你们也离得不远，如果我不去拉他，他也不会有生命危险。",
            "nextDialogs": [
              "402200114"
            ]
          },
          "402200114": {
            "id": "402200114",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "但我没办法忍住…",
            "nextDialogs": [
              "402200115"
            ]
          },
          "402200115": {
            "id": "402200115",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "没关系的，明妮，我们明白。",
            "nextDialogs": [
              "402200116"
            ]
          },
          "402200116": {
            "id": "402200116",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "面对受伤的人，怎么可能置之不理呢？",
            "nextDialogs": [
              "402200117"
            ]
          },
          "402200117": {
            "id": "402200117",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "「是炽魂斗士的话，一定会握上那双渴求帮助的手。」",
            "nextDialogs": [
              "402200118"
            ]
          },
          "402200118": {
            "id": "402200118",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "欸，这句话的出处是哪里？",
            "nextDialogs": [
              "402200119"
            ]
          },
          "402200119": {
            "id": "402200119",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "是我刚编的，嘿嘿…",
            "nextDialogs": [
              "402200120"
            ]
          },
          "402200120": {
            "id": "402200120",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "…队长，谢谢你。",
            "nextDialogs": [
              "402200121"
            ]
          },
          "402200121": {
            "id": "402200121",
            "speakerId": 1006,
            "speakerName": "雪琳",
            "text": "明妮！",
            "nextDialogs": [
              "402200122"
            ]
          },
          "402200122": {
            "id": "402200122",
            "speakerId": 1006,
            "speakerName": "雪琳",
            "text": "还好没出大事，刚才吓死我了。",
            "nextDialogs": [
              "402200123"
            ]
          },
          "402200123": {
            "id": "402200123",
            "speakerId": 1007,
            "speakerName": "莫里茨",
            "text": "孩子，什么东西都没你的生命重要…",
            "nextDialogs": [
              "402200124"
            ]
          },
          "402200124": {
            "id": "402200124",
            "speakerId": 1006,
            "speakerName": "雪琳",
            "text": "下次别这样吓唬我们了。",
            "nextDialogs": [
              "402200125"
            ]
          },
          "402200125": {
            "id": "402200125",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "爸爸妈妈，对不起…",
            "nextDialogs": [
              "402200126"
            ]
          },
          "402200126": {
            "id": "402200126",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "因为一个小小插曲，你们并没有获得理想的成绩。虽然有些不甘心，但现实就是这样，汗水未必能浇灌出花朵。",
            "nextDialogs": [
              "402200127"
            ]
          },
          "402200127": {
            "id": "402200127",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "不过你们的欢笑与付出都真实地存在过，在未来某一天它或许可以结出别的成果。\\n明妮的表情有些苦涩，但也有些释然。",
            "nextDialogs": [
              "402200128"
            ]
          },
          "402200128": {
            "id": "402200128",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "明妮选手，你的身体怎么样？",
            "nextDialogs": [
              "402200129"
            ]
          },
          "402200129": {
            "id": "402200129",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "啊，裁判先生，我还好，没什么问题。",
            "nextDialogs": [
              "402200130"
            ]
          },
          "402200130": {
            "id": "402200130",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "…您是刚才的…",
            "nextDialogs": [
              "402200131"
            ]
          },
          "402200131": {
            "id": "402200131",
            "speakerId": 1010,
            "speakerName": "谦三",
            "text": "您好，我是「飞雷稻光」队的谦三，受您关照我没受什么大伤，非常感谢。",
            "nextDialogs": [
              "402200132"
            ]
          },
          "402200132": {
            "id": "402200132",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "几位，「飞雷稻光」全队和我们组委会协商了一下。",
            "nextDialogs": [
              "402200133"
            ]
          },
          "402200133": {
            "id": "402200133",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "明妮选手回身救助他人的行为值得赞赏，组委会一致认为如果不是这个意外，你们的成绩会更好。",
            "nextDialogs": [
              "402200134"
            ]
          },
          "402200134": {
            "id": "402200134",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "目前，「炽魂斗士」队的排名不足以拿到奖牌，但我们评估之后认为你们应当获得一项荣誉。",
            "nextDialogs": [
              "402200135"
            ]
          },
          "402200135": {
            "id": "402200135",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "在前几名的奖牌之外，组委会将为你们颁发一块特别奖牌，鼓励你们以生命为先的行动。",
            "nextDialogs": [
              "402200136"
            ]
          },
          "402200136": {
            "id": "402200136",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "谢谢你，杜拉夫叔叔。爸爸，妈妈，我会按照约定的…",
            "nextDialogs": [
              "402200137"
            ]
          },
          "402200137": {
            "id": "402200137",
            "speakerId": 1007,
            "speakerName": "莫里茨",
            "text": "行，那就按照我们之间的约定来吧。",
            "nextDialogs": [
              "402200138"
            ]
          },
          "402200138": {
            "id": "402200138",
            "speakerId": 1007,
            "speakerName": "莫里茨",
            "text": "…在保证安全的情况下，你可以去外面旅行了，明妮。",
            "nextDialogs": [
              "402200139"
            ]
          },
          "402200139": {
            "id": "402200139",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "欸？爸爸，但是我…",
            "nextDialogs": [
              "402200140"
            ]
          },
          "402200140": {
            "id": "402200140",
            "speakerId": 1007,
            "speakerName": "莫里茨",
            "text": "在我看来，你已经拿到一个足够好的「名次」了。",
            "nextDialogs": [
              "402200141"
            ]
          },
          "402200141": {
            "id": "402200141",
            "speakerId": 1006,
            "speakerName": "雪琳",
            "text": "呵呵，是啊。喏，还有奖牌为证呢。",
            "nextDialogs": [
              "402200142"
            ]
          },
          "402200142": {
            "id": "402200142",
            "speakerId": 1007,
            "speakerName": "莫里茨",
            "text": "依我看，不如我们全家一起出去旅游一趟吧，就去你最喜欢的八重堂。",
            "nextDialogs": [
              "402200143"
            ]
          },
          "402200143": {
            "id": "402200143",
            "speakerId": 1007,
            "speakerName": "莫里茨",
            "text": "我倒要看看，能不能找到适合你老爸老妈看的漫画。",
            "nextDialogs": [
              "402200144"
            ]
          },
          "402200144": {
            "id": "402200144",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "太好了，明妮，这是一个好开始。",
            "nextDialogs": [
              "402200145"
            ]
          },
          "402200145": {
            "id": "402200145",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "我…我太开心了。",
            "nextDialogs": [
              "402200146"
            ]
          },
          "402200146": {
            "id": "402200146",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "这么值得纪念的时刻，怎么能忘记留影呢？",
            "nextDialogs": [
              "402200147"
            ]
          },
          "402200147": {
            "id": "402200147",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "有道理啊，大家一起来合影吧！",
            "nextDialogs": [
              "402200148"
            ]
          },
          "402200148": {
            "id": "402200148",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "我建议咱们模仿「炽魂斗士战记」第二册里菲耶蒂娜第一次和玛薇卡并肩作战的场面，一起拍一张！"
          }
        }
      }
    },
    {
      "subId": "4022002",
      "subQuestName": "前往越野赛场地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402200201"
        ],
        "dialogs": {
          "402200201": {
            "id": "402200201",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "马上比赛就要开始了，大家准备得怎么样？我们一路过来看到好多人。",
            "nextDialogs": [
              "402200202"
            ]
          },
          "402200202": {
            "id": "402200202",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "我准备好了毛巾、热汤还有保暖的毛毯，嗯…应该已经不缺什么了吧。",
            "nextDialogs": [
              "402200203"
            ]
          },
          "402200203": {
            "id": "402200203",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "按我们之前商量好的安排，队长她们现在应该正在热身。",
            "nextDialogs": [
              "402200204"
            ]
          },
          "402200204": {
            "id": "402200204",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "等大家正式开跑之后，我就去终点守着，随时准备递上水和毛毯。",
            "nextDialogs": [
              "402200205"
            ]
          },
          "402200205": {
            "id": "402200205",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "我刚从家里过来，比赛很快就要开始了，大家的热身还没结束吗？",
            "nextDialogs": [
              "402200206"
            ]
          },
          "402200206": {
            "id": "402200206",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "的确是有点久了啊…",
            "nextDialogs": [
              "402200207"
            ]
          },
          "402200207": {
            "id": "402200207",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "按理说，瓦雷莎和希诺宁都不是拖拉的人呀…我们过去看看情况好了。",
            "nextDialogs": [
              "402200208"
            ]
          },
          "402200208": {
            "id": "402200208",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "那就拜托你们了。"
          }
        }
      }
    },
    {
      "subId": "4022016",
      "subQuestName": "前往特战队的营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402201601"
        ],
        "dialogs": {
          "402201601": {
            "id": "402201601",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "欸，瓦雷莎她们终于从帐篷里出来了。",
            "nextDialogs": [
              "402201602"
            ]
          },
          "402201602": {
            "id": "402201602",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "大家怎么了，一脸沉重的样子？",
            "nextDialogs": [
              "402201603"
            ]
          },
          "402201603": {
            "id": "402201603",
            "speakerId": 1004,
            "speakerName": "希诺宁",
            "text": "义刚发烧了。",
            "nextDialogs": [
              "402201604"
            ]
          },
          "402201604": {
            "id": "402201604",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "呜…怪我没有留心…之前听到义刚打喷嚏，问了他几次，他总是说自己没事。",
            "nextDialogs": [
              "402201605"
            ]
          },
          "402201605": {
            "id": "402201605",
            "speakerId": 1004,
            "speakerName": "希诺宁",
            "text": "他一定是不想影响比赛才硬撑着，直到今天发现自己发了烧，完全没力气动弹。",
            "nextDialogs": [
              "402201606"
            ]
          },
          "402201606": {
            "id": "402201606",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "我们跟组委会联系过了，药品和保暖方面目前都跟上了，他们还派了专人看护，不用太过担心。",
            "nextDialogs": [
              "402201607"
            ]
          },
          "402201607": {
            "id": "402201607",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "可是…马上就要比赛了吧？这下是不是直接少了一位参赛队员…",
            "nextDialogs": [
              "402201608"
            ]
          },
          "402201608": {
            "id": "402201608",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "是啊，怎么办呢…",
            "nextDialogs": [
              "402201609"
            ]
          },
          "402201609": {
            "id": "402201609",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "这个比赛对大家都很重要，更何况明妮的父母也在终点看着…除非…",
            "nextDialogs": [
              "402201612"
            ]
          },
          "402201612": {
            "id": "402201612",
            "speakerId": 1004,
            "speakerName": "希诺宁",
            "text": "我们想过。毕竟大家一起训练过，你了解赛道，身体素质和户外经验也都足够…",
            "nextDialogs": [
              "402201613"
            ]
          },
          "402201613": {
            "id": "402201613",
            "speakerId": 1004,
            "speakerName": "希诺宁",
            "text": "但在这种时候拉你入伙，就像紧要关头给你派了个不可推脱的工作，让人不太忍心。",
            "nextDialogs": [
              "402201614"
            ]
          },
          "402201614": {
            "id": "402201614",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "#最重要的是，{NICKNAME}你愿意吗？"
          }
        }
      }
    },
    {
      "subId": "4022003",
      "subQuestName": "前往赛道起点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402200301"
        ],
        "dialogs": {
          "402200301": {
            "id": "402200301",
            "speakerId": 1011,
            "speakerName": "昏睡的义刚",
            "text": "（发烧中的病人正在昏睡，比赛迫在眉睫，还是先跟大家一起前往赛场吧。）"
          }
        }
      }
    },

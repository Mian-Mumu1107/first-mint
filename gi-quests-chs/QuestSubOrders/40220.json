    {
      "subId": "4022005",
      "subQuestName": "等待比赛开始",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402200501"
        ],
        "dialogs": {
          "402200501": {
            "id": "402200501",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "各位选手，各位观众，大家好！",
            "nextDialogs": [
              "402200502"
            ]
          },
          "402200502": {
            "id": "402200502",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "我，杜拉夫，受组委会任命，担任本次龙脊雪山国际越野赛的裁判。",
            "nextDialogs": [
              "402200503"
            ]
          },
          "402200503": {
            "id": "402200503",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "希望各支队伍在遵守比赛规则的同时，超越自我，跑出好成绩。",
            "nextDialogs": [
              "402200504"
            ]
          },
          "402200504": {
            "id": "402200504",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "同时也提醒大家，雪山地形崎岖，为了防止意外，大家应当尽量保持在赛道上行走。",
            "nextDialogs": [
              "402200505"
            ]
          },
          "402200505": {
            "id": "402200505",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "组委会已经提前清理过赛道，但雪山环境复杂，赛道之外依然会有危险。",
            "nextDialogs": [
              "402200506"
            ]
          },
          "402200506": {
            "id": "402200506",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "选手们注意：一旦身体不适，无法坚持跑完全程，或者意外受伤，请到赛道一侧休息。组委会工作人员会尽快赶到并救助伤者。",
            "nextDialogs": [
              "402200507"
            ]
          },
          "402200507": {
            "id": "402200507",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "队长，义刚呢，怎么没看到他？这马上就要开跑了呀。",
            "nextDialogs": [
              "402200508"
            ]
          },
          "402200508": {
            "id": "402200508",
            "speakerId": 1004,
            "speakerName": "希诺宁",
            "text": "明妮，义刚发烧了，现在人还昏着，没法来参赛了。",
            "nextDialogs": [
              "402200509"
            ]
          },
          "402200509": {
            "id": "402200509",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "什么？怎么会？",
            "nextDialogs": [
              "402200512"
            ]
          },
          "402200512": {
            "id": "402200512",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "#放轻松，明妮，{M#他}{F#她}很强的，有我们在你们说不定能拿到第一名呢。",
            "nextDialogs": [
              "402200513"
            ]
          },
          "402200513": {
            "id": "402200513",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "我…我放心，谢谢你们帮忙！",
            "nextDialogs": [
              "402200514"
            ]
          },
          "402200514": {
            "id": "402200514",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "…接下来，由我来介绍各支参赛队伍：",
            "nextDialogs": [
              "402200515"
            ]
          },
          "402200515": {
            "id": "402200515",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "来自须弥的「沙之行者」，来自稻妻的「飞雷稻光」。",
            "nextDialogs": [
              "402200516"
            ]
          },
          "402200516": {
            "id": "402200516",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "来自璃月的「夕阳」，以及枫丹的「灰手」。",
            "nextDialogs": [
              "402200517"
            ]
          },
          "402200517": {
            "id": "402200517",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "由冒险家组成的队伍「向山」，还有清泉镇镇民们组成的队伍「神行猎手」。",
            "nextDialogs": [
              "402200518"
            ]
          },
          "402200518": {
            "id": "402200518",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "最后，由各国参赛者组成的混合队伍——「炽魂斗士」。",
            "nextDialogs": [
              "402200519"
            ]
          },
          "402200519": {
            "id": "402200519",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "其他队伍的选手看起来都很厉害啊。",
            "nextDialogs": [
              "402200520"
            ]
          },
          "402200520": {
            "id": "402200520",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "不要慌，不要紧张！现在该想想菲耶蒂娜了，各位，拿出勇气来！",
            "nextDialogs": [
              "402200521"
            ]
          },
          "402200521": {
            "id": "402200521",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "有我们在一起，什么阻碍都能翻越！翻不过去的就用冲撞顶开！",
            "nextDialogs": [
              "402200522"
            ]
          },
          "402200522": {
            "id": "402200522",
            "speakerId": 1004,
            "speakerName": "希诺宁",
            "text": "不是谁都像你…算了，我同意，这种时候可不能说丧气话。",
            "nextDialogs": [
              "402200523"
            ]
          },
          "402200523": {
            "id": "402200523",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看我的吧。",
            "nextDialogs": [
              "402200524"
            ]
          },
          "402200524": {
            "id": "402200524",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "我也会努力，相信大家，相信自己！",
            "nextDialogs": [
              "402200525"
            ]
          },
          "402200525": {
            "id": "402200525",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "接下来，请选手们各就位。",
            "nextDialogs": [
              "402200526"
            ]
          },
          "402200526": {
            "id": "402200526",
            "speakerId": 1009,
            "speakerName": "杜拉夫",
            "text": "准备，开跑！"
          }
        }
      }
    },

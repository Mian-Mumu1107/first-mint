    {
      "subId": "4022011",
      "subQuestName": "与明妮交接棒",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402201101"
        ],
        "dialogs": {
          "402201101": {
            "id": "402201101",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "明妮！接下来就交给你了，我会在后面跟着的！",
            "nextDialogs": [
              "402201102"
            ]
          },
          "402201102": {
            "id": "402201102",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "好，我来最后冲刺。"
          }
        }
      }
    },
    {
      "subId": "4022020",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4022017",
      "subQuestName": "跟随明妮",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402201701"
        ],
        "dialogs": {
          "402201701": {
            "id": "402201701",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "有魔物！幸好不在赛道上，离它们远些就好。",
            "nextDialogs": [
              "402201702"
            ]
          },
          "402201702": {
            "id": "402201702",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "大家提前到赛道边等我了吗？我来了。",
            "nextDialogs": [
              "402201703"
            ]
          },
          "402201703": {
            "id": "402201703",
            "speakerId": 1012,
            "speakerName": "稻妻选手",
            "text": "…不行…没力气了，路要看不清了。是往这里跑吧…",
            "nextDialogs": [
              "402201704"
            ]
          },
          "402201704": {
            "id": "402201704",
            "speakerId": 1012,
            "speakerName": "稻妻选手",
            "text": "不对，这不是赛道！",
            "nextDialogs": [
              "402201705"
            ]
          },
          "402201705": {
            "id": "402201705",
            "speakerId": 1012,
            "speakerName": "稻妻选手",
            "text": "啊，别过来。",
            "nextDialogs": [
              "402201706"
            ]
          },
          "402201706": {
            "id": "402201706",
            "speakerId": 1004,
            "speakerName": "希诺宁",
            "text": "糟了！",
            "nextDialogs": [
              "402201707"
            ]
          },
          "402201707": {
            "id": "402201707",
            "speakerId": 1013,
            "speakerName": "晕头转向的稻妻选手",
            "text": "…救命！",
            "nextDialogs": [
              "402201708"
            ]
          },
          "402201708": {
            "id": "402201708",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "没关系…我可以继续…名次，我一定要拿到。",
            "nextDialogs": [
              "402201709"
            ]
          },
          "402201709": {
            "id": "402201709",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "我不想拖大家的后腿。",
            "nextDialogs": [
              "402201710"
            ]
          },
          "402201710": {
            "id": "402201710",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "我相信你，明妮。",
            "nextDialogs": [
              "402201711"
            ]
          },
          "402201711": {
            "id": "402201711",
            "speakerId": 1004,
            "speakerName": "希诺宁",
            "text": "我也相信你。",
            "nextDialogs": [
              "402201712"
            ]
          },
          "402201712": {
            "id": "402201712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我来帮你了。",
            "nextDialogs": [
              "402201713"
            ]
          },
          "402201713": {
            "id": "402201713",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "我知道我应该继续向前，但是抱歉，我没办法视而不见。",
            "nextDialogs": [
              "402201714"
            ]
          },
          "402201714": {
            "id": "402201714",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "快到我这里来！",
            "nextDialogs": [
              "402201715"
            ]
          },
          "402201715": {
            "id": "402201715",
            "speakerId": 1004,
            "speakerName": "希诺宁",
            "text": "#面对受伤的人，怎么可能放着不管。瓦雷莎！{NICKNAME}！",
            "nextDialogs": [
              "402201716"
            ]
          },
          "402201716": {
            "id": "402201716",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "当然！",
            "nextDialogs": [
              "402201717"
            ]
          },
          "402201717": {
            "id": "402201717",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "明妮先带伤员往终点走，接下来的交给我们。"
          }
        }
      }
    },

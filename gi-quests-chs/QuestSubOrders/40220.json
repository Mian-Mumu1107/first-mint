    {
      "subId": "4022012",
      "subQuestName": "与伙伴们一道返回营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402201201"
        ],
        "dialogs": {
          "402201201": {
            "id": "402201201",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "虽然没拿到名次，但好歹有了奖牌！",
            "nextDialogs": [
              "402201202"
            ]
          },
          "402201202": {
            "id": "402201202",
            "speakerId": 1001,
            "speakerName": "汤义刚",
            "text": "抱歉…咳咳…没想到在这个时候感冒了。",
            "nextDialogs": [
              "402201203"
            ]
          },
          "402201203": {
            "id": "402201203",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "没关系的，义刚，身体也很重要。",
            "nextDialogs": [
              "402201204"
            ]
          },
          "402201204": {
            "id": "402201204",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "虽然没能一起参加比赛，但至少还有这张合照。",
            "nextDialogs": [
              "402201205"
            ]
          },
          "402201205": {
            "id": "402201205",
            "speakerId": 1004,
            "speakerName": "希诺宁",
            "text": "觉得有遗憾的话，下届比赛再来吧，到时候拿个金牌回去。",
            "nextDialogs": [
              "402201206"
            ]
          },
          "402201206": {
            "id": "402201206",
            "speakerId": 1001,
            "speakerName": "汤义刚",
            "text": "咳…下一次我一定要咳…来。",
            "nextDialogs": [
              "402201207"
            ]
          },
          "402201207": {
            "id": "402201207",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "你悠着点吧，下次可别感冒啦。",
            "nextDialogs": [
              "402201208"
            ]
          },
          "402201208": {
            "id": "402201208",
            "speakerId": 1000,
            "speakerName": "爱拉尼",
            "text": "队长，以防万一，下一次我也要跟着一起训练，至少还可以多一个替补队员。",
            "nextDialogs": [
              "402201209"
            ]
          },
          "402201209": {
            "id": "402201209",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "那就约好了，下一次大家还要再聚！",
            "nextDialogs": [
              "402201210"
            ]
          },
          "402201210": {
            "id": "402201210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一定会来的。",
            "nextDialogs": [
              "402201211"
            ]
          },
          "402201211": {
            "id": "402201211",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "嗯，约好了。"
          }
        }
      }
    },
    {
      "subId": "4022099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402209901"
        ],
        "dialogs": {
          "402209901": {
            "id": "402209901",
            "speakerId": 1004,
            "speakerName": "希诺宁",
            "text": "气温降低了…啊，好冷。",
            "nextDialogs": [
              "402209902"
            ]
          },
          "402209902": {
            "id": "402209902",
            "speakerId": 1004,
            "speakerName": "希诺宁",
            "text": "#{NICKNAME}就在前面了，赶快和{M#他}{F#她}接力。",
            "nextDialogs": [
              "402209903"
            ]
          },
          "402209903": {
            "id": "402209903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "记得这一段都是上坡路，注意保持速度。",
            "nextDialogs": [
              "402209905"
            ]
          },
          "402209905": {
            "id": "402209905",
            "speakerId": 1005,
            "speakerName": "瓦雷莎",
            "text": "这里绕路太浪费时间，就从缺口处跳下去吧。",
            "nextDialogs": [
              "402209907"
            ]
          },
          "402209907": {
            "id": "402209907",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "…绕过那颗大树往前跑…我们现在的排名靠前。",
            "nextDialogs": [
              "402209908"
            ]
          },
          "402209908": {
            "id": "402209908",
            "speakerId": 1002,
            "speakerName": "明妮",
            "text": "你可以的，明妮，加油。",
            "nextDialogs": [
              "402209911"
            ]
          },
          "402209911": {
            "id": "402209911",

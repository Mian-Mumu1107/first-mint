  "subQuests": [
    {
      "subId": "7212504",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721250401"
        ],
        "dialogs": {
          "721250401": {
            "id": "721250401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见。",
            "nextDialogs": [
              "721250402"
            ]
          },
          "721250402": {
            "id": "721250402",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "嗯，再见。唉…到底哪里能找到花种呢…"
          }
        }
      }
    },
    {
      "subId": "7212501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721250102"
        ],
        "dialogs": {
          "721250102": {
            "id": "721250102",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "如果还能再种些花就好了…",
            "nextDialogs": [
              "721250103"
            ]
          },
          "721250103": {
            "id": "721250103",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "啊，您好！初次见面…请问，你也是回来居住的人吗？抱歉呀，之前我好像没见过你…",
            "nextDialogs": [
              "721250105",
              "721250110"
            ]
          },
          "721250105": {
            "id": "721250105",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "嗯，之前因为「御影炉心」的事，原来住在踏鞴砂的人都被疏散去了别的地方。",
            "nextDialogs": [
              "721250106"
            ]
          },
          "721250106": {
            "id": "721250106",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "前段时间，我听说「御影炉心」已经没事了，踏鞴砂也安全了，所以就去问了一下能不能回来。",
            "nextDialogs": [
              "721250107"
            ]
          },
          "721250107": {
            "id": "721250107",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "得到许可了之后，我就带着东西，重新回来这里住啦。",
            "nextDialogs": [
              "721250108"
            ]
          },
          "721250108": {
            "id": "721250108",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "但是…和我一样愿意回来住的人，似乎也没多少呢…",
            "nextDialogs": [
              "721250115"
            ]
          },
          "721250115": {
            "id": "721250115",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "不过这也是没办法的事。",
            "nextDialogs": [
              "721250116"
            ]
          },
          "721250116": {
            "id": "721250116",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "毕竟之前「御影炉心」出了那么大的问题，大家都担心这种事还会发生。",
            "nextDialogs": [
              "721250117"
            ]
          },
          "721250117": {
            "id": "721250117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不担心吗？",
            "nextDialogs": [
              "721250118"
            ]
          },
          "721250118": {
            "id": "721250118",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "我当然也担心啦…不过我这个人很恋家啦，而且也放心不下我种的那些花，嘿嘿。所以还是决定回来住了。",
            "nextDialogs": [
              "721250119"
            ]
          },
          "721250119": {
            "id": "721250119",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "但是，我之前种在这周围的花果然都枯了啊。现在我也找不到花种，真可惜…",
            "nextDialogs": [
              "721250120"
            ]
          },
          "721250120": {
            "id": "721250120",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "这里很适合种花的，无论播了什么种，都能很快开出一片的花海来。",
            "nextDialogs": [
              "721250121"
            ]
          },
          "721250121": {
            "id": "721250121",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "我之前还移植过外国的花呢，蒙德的小灯草、风车菊和蒲公英，还有璃月的霓裳花我都移植过。",
            "nextDialogs": [
              "721250122"
            ]
          },
          "721250122": {
            "id": "721250122",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "小灯草在夜里可好看了，就是要种在荫凉的地方，还要浇很多水，修剪掉枯掉的叶尖。",
            "nextDialogs": [
              "721250123"
            ]
          },
          "721250123": {
            "id": "721250123",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "风车菊我听说在有风的地方会长得很好，但我觉得，稻妻的风应该比不上蒙德的风…所以我经常过去给它用扇子扇风，不知道是不是真的有用。",
            "nextDialogs": [
              "721250124"
            ]
          },
          "721250124": {
            "id": "721250124",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "蒲公英是最不用担心的，它能自己照顾自己，不过…它太会照顾自己了，总是会长在各种奇怪的地方。",
            "nextDialogs": [
              "721250125"
            ]
          },
          "721250125": {
            "id": "721250125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呃，那个…",
            "nextDialogs": [
              "721250126"
            ]
          },
          "721250126": {
            "id": "721250126",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "还有璃月的霓裳花，打理霓裳花的叶子可是很麻烦的，那种叫做「鬼兜虫」的虫子总是会赖在霓裳花的花瓣里不走，我只能一个个挑走。",
            "nextDialogs": [
              "721250127"
            ]
          },
          "721250127": {
            "id": "721250127",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "不过，我移植清心倒是失败了，种下去的清心不是长不大，就是枯萎得很快。唉，这世界上有没有那种，无论种什么花都能顺利出花的神奇土地呢…",
            "nextDialogs": [
              "721250128"
            ]
          },
          "721250128": {
            "id": "721250128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我、我知道了…",
            "nextDialogs": [
              "721250129"
            ]
          },
          "721250129": {
            "id": "721250129",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "还有还有，你知道璃月有一种叫琉璃袋的花吗？那种花可难找了，我拜托了很多人…",
            "nextDialogs": [
              "721250130"
            ]
          },
          "721250130": {
            "id": "721250130",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "啊…",
            "nextDialogs": [
              "721250131"
            ]
          },
          "721250131": {
            "id": "721250131",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "啊！对不起，对不起！我一说起花来就会这样，真的非常抱歉！",
            "nextDialogs": [
              "721250132"
            ]
          },
          "721250132": {
            "id": "721250132",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你、你真是喜欢花啊…",
            "nextDialogs": [
              "721250133"
            ]
          },
          "721250133": {
            "id": "721250133",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "只是稍微研究了一下而已，嘿嘿…但是现在我连花种都没有，连花都不能种了…"
          },
          "721250110": {
            "id": "721250110",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "欸？是这样吗？我还以为有人和我一样，愿意回来住了呢…",
            "nextDialogs": [
              "721250111"
            ]
          },
          "721250111": {
            "id": "721250111",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "之前因为「御影炉心」的事，原来住在踏鞴砂的人都被疏散去了别的地方。",
            "nextDialogs": [
              "721250112"
            ]
          },
          "721250112": {
            "id": "721250112",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "前段时间，我听说「御影炉心」已经没事了，踏鞴砂也安全了，所以就去问了一下能不能回来。",
            "nextDialogs": [
              "721250113"
            ]
          },
          "721250113": {
            "id": "721250113",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "得到许可了之后，我就带着东西，重新回来这里住啦。",
            "nextDialogs": [
              "721250114"
            ]
          },
          "721250114": {
            "id": "721250114",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "但是…和我一样愿意回来住的人，似乎也没多少呢…"
          }
        }
      }
    },
    {
      "subId": "7212502",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721250501"
        ],
        "dialogs": {
          "721250501": {
            "id": "721250501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这些花种可以用吗？",
            "nextDialogs": [
              "721250502"
            ]
          },
          "721250502": {
            "id": "721250502",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "这是…可以！当然可以，有了这些种子，我肯定能种出很多花来！",
            "nextDialogs": [
              "721250503"
            ]
          },
          "721250503": {
            "id": "721250503",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "那、那个，抱歉，请稍等…我得给您点报酬才行…",
            "nextDialogs": [
              "721250504"
            ]
          },
          "721250504": {
            "id": "721250504",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "这些给您，谢谢您的花种。您过段时间来，肯定能看见很漂亮的花海！"
          }
        }
      }
    },
    {
      "subId": "7212503",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721250301"
        ],
        "dialogs": {
          "721250301": {
            "id": "721250301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在这里做什么？",
            "nextDialogs": [
              "721250302"
            ]
          },
          "721250302": {
            "id": "721250302",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "我正在想，从哪里才能找到花种，把周围再种上花呢。",
            "nextDialogs": [
              "721250303"
            ]
          },
          "721250303": {
            "id": "721250303",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "之前因为「御影炉心」的事，住在这座岛上的人都被疏散走了。",
            "nextDialogs": [
              "721250304"
            ]
          },
          "721250304": {
            "id": "721250304",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "听说「御影炉心」事被解决了之后，我就自己回来了。",
            "nextDialogs": [
              "721250305"
            ]
          },
          "721250305": {
            "id": "721250305",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "但是，我之前种在这周围的花全都枯萎了，我还找不到花种，真可惜，这周围可是很适合种花的…"
          }
        }
      }
    },
    {
      "subId": "7212502",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721250201"
        ],
        "dialogs": {
          "721250201": {
            "id": "721250201",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "到底怎么才能找到花种呢…"
          }
        }
      }
    },
    {
      "subId": "7212506",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721250601"
        ],
        "dialogs": {
          "721250601": {
            "id": "721250601",
            "speakerId": 1000,
            "speakerName": "叶名山薰",
            "text": "谢谢您帮我找来那些花种，我马上就把它们都播下去。过段时间，这里肯定能开出一片很好看的花。"
          }
        }
      }
    },
    {
      "subId": "7212599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721259901"
        ],
        "dialogs": {
          "721259901": {
            "id": "721259901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，这是…好大一包花种。不知道是什么花的种子…但总之先拿着吧。"
          }
        }
      }
    }
  ]
}
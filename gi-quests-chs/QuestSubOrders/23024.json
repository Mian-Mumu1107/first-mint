  "subQuests": [
    {
      "subId": "2302401",
      "subQuestName": "与瓦尔坦和古尔根对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230240101"
        ],
        "dialogs": {
          "230240101": {
            "id": "230240101",
            "speakerId": 1000,
            "speakerName": "瓦尔坦",
            "text": "二位，你们终于来了。",
            "nextDialogs": [
              "230240102"
            ]
          },
          "230240102": {
            "id": "230240102",
            "speakerId": 1001,
            "speakerName": "古尔根",
            "text": "时间正好，万事齐全了！",
            "nextDialogs": [
              "230240103"
            ]
          },
          "230240103": {
            "id": "230240103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么这么兴奋？",
            "nextDialogs": [
              "230240104"
            ]
          },
          "230240104": {
            "id": "230240104",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "难道说，之前的蔷薇要开花了？",
            "nextDialogs": [
              "230240105"
            ]
          },
          "230240105": {
            "id": "230240105",
            "speakerId": 1000,
            "speakerName": "瓦尔坦",
            "text": "没错，哈哈哈！这都是多亏了你帮忙啊，旅行者。",
            "nextDialogs": [
              "230240106"
            ]
          },
          "230240106": {
            "id": "230240106",
            "speakerId": 1001,
            "speakerName": "古尔根",
            "text": "虽然这株蔷薇还没有盛开，但根据整个植株的形态可以判断，它的生命力极其旺盛！",
            "nextDialogs": [
              "230240107"
            ]
          },
          "230240107": {
            "id": "230240107",
            "speakerId": 1000,
            "speakerName": "瓦尔坦",
            "text": "旅行者，如果你有兴趣的话，就来近距离观察一下吧。",
            "nextDialogs": [
              "230240108"
            ]
          },
          "230240108": {
            "id": "230240108",
            "speakerId": 1000,
            "speakerName": "瓦尔坦",
            "text": "哈哈哈，说不定，它会在你们面前盛开呢。",
            "nextDialogs": [
              "230240109"
            ]
          },
          "230240109": {
            "id": "230240109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那我可要好好看看…",
            "nextDialogs": [
              "230240110"
            ]
          },
          "230240110": {
            "id": "230240110",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "真，真的吗？在这么短的时间里开花？",
            "nextDialogs": [
              "230240111"
            ]
          },
          "230240111": {
            "id": "230240111",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好期待！"
          }
        }
      }
    },
    {
      "subId": "2302402",
      "subQuestName": "与瓦尔坦和古尔根对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230240201"
        ],
        "dialogs": {
          "230240201": {
            "id": "230240201",
            "speakerId": 1001,
            "speakerName": "古尔根",
            "text": "两位，请俯身贴近点看吧，这样就能把所有细节看得一清二楚。",
            "nextDialogs": [
              "230240202"
            ]
          },
          "230240202": {
            "id": "230240202",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "和两位药农一同细致观察了尚未盛开的蔷薇…",
            "nextDialogs": [
              "230240203"
            ]
          },
          "230240203": {
            "id": "230240203",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没有动静啊…",
            "nextDialogs": [
              "230240206"
            ]
          },
          "230240206": {
            "id": "230240206",
            "speakerId": 1001,
            "speakerName": "古尔根",
            "text": "哎呀…也许是这株蔷薇有些不好意思在你们面前盛开吧…",
            "nextDialogs": [
              "230240207"
            ]
          },
          "230240207": {
            "id": "230240207",
            "speakerId": 1000,
            "speakerName": "瓦尔坦",
            "text": "不过，根据蔷薇的生长规律，最迟明天，肯定会开花的。",
            "nextDialogs": [
              "230240208"
            ]
          },
          "230240208": {
            "id": "230240208",
            "speakerId": 1000,
            "speakerName": "瓦尔坦",
            "text": "旅行者，请你明天再过来吧！"
          }
        }
      }
    },

    {
      "subId": "2302404",
      "subQuestName": "与瓦尔坦和古尔根对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230240401"
        ],
        "dialogs": {
          "230240401": {
            "id": "230240401",
            "speakerId": 1000,
            "speakerName": "瓦尔坦",
            "text": "旅行者，你们来得正好，这株蔷薇总算盛开了！",
            "nextDialogs": [
              "230240402"
            ]
          },
          "230240402": {
            "id": "230240402",
            "speakerId": 1001,
            "speakerName": "古尔根",
            "text": "多亏了你的帮忙，这简直是我见过长势最好的蔷薇了。",
            "nextDialogs": [
              "230240403"
            ]
          },
          "230240403": {
            "id": "230240403",
            "speakerId": 1000,
            "speakerName": "瓦尔坦",
            "text": "实在太感谢你们了，还请你收下这点谢礼！",
            "nextDialogs": [
              "230240404"
            ]
          },
          "230240404": {
            "id": "230240404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可喜可贺！",
            "nextDialogs": [
              "230240405"
            ]
          },
          "230240405": {
            "id": "230240405",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "蔷薇开花了，我们也很开心哦！",
            "nextDialogs": [
              "230240406"
            ]
          },
          "230240406": {
            "id": "230240406",
            "speakerId": 1000,
            "speakerName": "瓦尔坦",
            "text": "呼…这下子总算可以按时向「健康之家」那边交货了。",
            "nextDialogs": [
              "230240407"
            ]
          },
          "230240407": {
            "id": "230240407",
            "speakerId": 1000,
            "speakerName": "瓦尔坦",
            "text": "希望这株蔷薇能帮上他们的忙…"
          }
        }
      }
    },

    {
      "subId": "2302407",
      "subQuestName": "与瓦尔坦和古尔根对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230240701"
        ],
        "dialogs": {
          "230240701": {
            "id": "230240701",
            "speakerId": 1000,
            "speakerName": "瓦尔坦",
            "text": "旅行者，你来得正好，蔷薇终于盛开了！",
            "nextDialogs": [
              "230240702"
            ]
          },
          "230240702": {
            "id": "230240702",
            "speakerId": 1000,
            "speakerName": "瓦尔坦",
            "text": "多亏了你的帮忙，这简直是我见过长势最好的蔷薇了。",
            "nextDialogs": [
              "230240703"
            ]
          },
          "230240703": {
            "id": "230240703",
            "speakerId": 1001,
            "speakerName": "古尔根",
            "text": "「健康之家」的医生们应该也会惊叹吧！",
            "nextDialogs": [
              "230240704"
            ]
          },
          "230240704": {
            "id": "230240704",
            "speakerId": 1000,
            "speakerName": "瓦尔坦",
            "text": "事不宜迟，我这就去把这株花给移出来…",
            "nextDialogs": [
              "230240705"
            ]
          },
          "230240705": {
            "id": "230240705",
            "speakerId": 1001,
            "speakerName": "古尔根",
            "text": "等等，这是…什么动静？",
            "nextDialogs": [
              "230240706"
            ]
          },
          "230240706": {
            "id": "230240706",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "花田中爆发出了异样的躁动…",
            "nextDialogs": [
              "230240707"
            ]
          },
          "230240707": {
            "id": "230240707",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇！是骗骗花！怎么会出现在这里？！",
            "nextDialogs": [
              "230240708"
            ]
          },
          "230240708": {
            "id": "230240708",
            "speakerId": 1001,
            "speakerName": "古尔根",
            "text": "糟了！花田！它要把花田毁掉了！",
            "nextDialogs": [
              "230240711"
            ]
          },
          "230240711": {
            "id": "230240711",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸…欸？那只骗骗花…怎么逃跑了？",
            "nextDialogs": [
              "230240712"
            ]
          },
          "230240712": {
            "id": "230240712",
            "speakerId": 1001,
            "speakerName": "古尔根",
            "text": "怎么会…怎么会这样！",
            "nextDialogs": [
              "230240713"
            ]
          },
          "230240713": {
            "id": "230240713",
            "speakerId": 1001,
            "speakerName": "古尔根",
            "text": "我们的蔷薇，最重要的草药…居然变成魔物逃走了！"
          }
        }
      }
    },

        "dialogs": {
          "749350101": {
            "id": "749350101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你的叔叔？",
            "nextDialogs": [
              "749350102"
            ]
          },
          "749350102": {
            "id": "749350102",
            "speakerId": 5343,
            "speakerName": "莫塞",
            "text": "对啊，虽然我还不知道叔叔的名字，他从来没给我们写过信。老爹提到他也都是「那个混蛋」、「那家伙」…",
            "nextDialogs": [
              "749350103"
            ]
          },
          "749350103": {
            "id": "749350103",
            "speakerId": 5343,
            "speakerName": "莫塞",
            "text": "不过敢打破传统，一个人离开镇子去须弥冒险，叔叔一定是个很厉害的人吧？反正肯定比只会把家族啦、责任啦挂在嘴上的老爹有意思多了…",
            "nextDialogs": [
              "749350104"
            ]
          },
          "749350104": {
            "id": "749350104",
            "speakerId": 5343,
            "speakerName": "莫塞",
            "text": "我是不是说得太多了？刚才我们说的话是秘密哦，你可不要告诉老爹啊，拜托。"
          }
        }
      }
    }
  ]

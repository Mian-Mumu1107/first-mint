  "subQuests": [
    {
      "subId": "7565101",
      "subQuestName": "和派蒙一起走走",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "756510101"
        ],
        "dialogs": {
          "756510101": {
            "id": "756510101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}最近做委托很辛苦吧，我都看在眼里了。",
            "nextDialogs": [
              "756510102"
            ]
          },
          "756510102": {
            "id": "756510102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "作为一个贴心称职的向导，我有责任帮你放松一下，当当——快看这是什么地方！",
            "nextDialogs": [
              "756510104",
              "756510106"
            ]
          },
          "756510104": {
            "id": "756510104",
            "speakerId": 5026,
            "speakerName": "布希柯",
            "text": "你们好，欢迎来到达莫维百货。",
            "nextDialogs": [
              "756510107"
            ]
          },
          "756510107": {
            "id": "756510107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这可不是一家普通的商店，这里是辛苦的劳动者通过消费获得精神放松的好地方。",
            "nextDialogs": [
              "756510108"
            ]
          },
          "756510108": {
            "id": "756510108",
            "speakerId": 5026,
            "speakerName": "布希柯",
            "text": "说的没错，我们最近还推出了买一送一促销活动！欢迎所有顾客参加！",
            "nextDialogs": [
              "756510109"
            ]
          },
          "756510109": {
            "id": "756510109",
            "speakerId": 5026,
            "speakerName": "布希柯",
            "text": "买了我吃亏，不买你吃亏！",
            "nextDialogs": [
              "756510110"
            ]
          },
          "756510110": {
            "id": "756510110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "之前路过的时候，看到达莫维百货的活动海报，我就记住了。",
            "nextDialogs": [
              "756510111"
            ]
          },
          "756510111": {
            "id": "756510111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "花一份钱，能买两份货，怎么看怎么划算。",
            "nextDialogs": [
              "756510112"
            ]
          },
          "756510112": {
            "id": "756510112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#总有种不在这里消费，我的人生就有点缺憾的感觉…我今天就要带上{NICKNAME}一起弥补这份缺憾。"
          },
          "756510106": {
            "id": "756510106",
            "speakerId": 5026,
            "speakerName": "布希柯",
            "text": "顾客，这么说就不妥了。达莫维百货主打的一直是价廉物美，你们可以看看价格嘛。"
          }
        }
      }
    }
  ]
}
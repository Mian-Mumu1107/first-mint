    {
      "subId": "7513201",
      "subQuestName": "(test)（test）在部落涂鸦前冥想$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751320101"
        ],
        "dialogs": {
          "751320101": {
            "id": "751320101",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "…啊…自遥远处而来的，异邦的勇士啊…",
            "nextDialogs": [
              "751320102"
            ]
          },
          "751320102": {
            "id": "751320102",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "请您听取我的话语吧，啊，我是引路的夜鸦，亦是真夜主人揣摩诗句的忆绪…或也只不过是月光中千万念头中的一个。",
            "nextDialogs": [
              "751320103"
            ]
          },
          "751320103": {
            "id": "751320103",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "请您听取我的话语吧，因地下流淌的灵河破碎不堪，我也只能借这形象与您述说，以求您提防那些漆黑的敌雠。",
            "nextDialogs": [
              "751320104"
            ]
          },
          "751320104": {
            "id": "751320104",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "在此地，那破碎的镜子曾映照，而如今黑烟逐渐弥漫之处有三，请您记住：",
            "nextDialogs": [
              "751320105"
            ]
          },
          "751320105": {
            "id": "751320105",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "其一是东侧，那过往英雄传说壁画中潜藏的阴影逐渐浮现。",
            "nextDialogs": [
              "751320106"
            ]
          },
          "751320106": {
            "id": "751320106",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "其二是西侧，迷海之上，漆黑的化身如恼人的鹦鹉一般模仿夤夜之主的口舌。",
            "nextDialogs": [
              "751320107"
            ]
          },
          "751320107": {
            "id": "751320107",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "其三是群崖之下，原本应已绝迹的失色之雾，在烬城又开始蠢动后弥漫…",
            "nextDialogs": [
              "751320108"
            ]
          },
          "751320108": {
            "id": "751320108",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "异邦的勇士啊，请务必小心…小心那漆黑之敌漫行之处，小心侵蚀一切的敌雠。"
          }
        }
      }
    },
    {
      "subId": "7513202",
      "subQuestName": "(test)解决部落难题$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

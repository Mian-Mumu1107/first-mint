      }
    },
    {
      "subId": "7513205",
      "subQuestName": "(test)闲置对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751320501"
        ],
        "dialogs": {
          "751320501": {
            "id": "751320501",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "小心那漆黑之敌漫行之处，小心侵蚀一切的敌雠。",
            "nextDialogs": [
              "751320502"
            ]
          },
          "751320502": {
            "id": "751320502",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "异邦的勇士啊…有什么想要得知之事吗…",
            "nextDialogs": [
              "751320504",
              "751320507",
              "751320510",
              "751320513"
            ]
          },
          "751320504": {
            "id": "751320504",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "东侧，诸多流光荧树摇曳的洞窟之中，正如手持织卷的叙事人所说，过往故事之中亦有被潜藏其中的恐怖。",
            "nextDialogs": [
              "751320505"
            ]
          },
          "751320505": {
            "id": "751320505",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "或许其中的阴影正借由过往的故事本身，寻求逃脱之法…"
          },
          "751320507": {
            "id": "751320507",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "西侧被迷雾深藏的岛屿，那里原本是祭祀的圣所，亦是许久之前与暝视的龙众签立契约者的居留之地。",
            "nextDialogs": [
              "751320508"
            ]
          },
          "751320508": {
            "id": "751320508",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "只是淤泥从中涌现，圣所变作了漆黑的孔窍，那里亦被封印与遗忘…啊，可是那狡猾的敌人不会如此轻易放弃…"
          },
          "751320510": {
            "id": "751320510",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "那原本是名为奥奇卡纳塔的古城毁灭之时产生的污秽之雾，原本已遭封绝…可岁月与遗忘亦是大敌…",
            "nextDialogs": [
              "751320511"
            ]
          },
          "751320511": {
            "id": "751320511",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "若是…啊…若是有人能够重新驱散那些失色之雾就好了…"
          },
          "751320513": {
            "id": "751320513",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "啊…还请切记，务必…务必小心…"
          }
        }
      }
    },
    {
      "subId": "7513206",
      "subQuestName": "(test)回到冥想处$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751320601"
        ],
        "dialogs": {
          "751320601": {
            "id": "751320601",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "啊，异邦的勇士啊…我能感受到…你所做出的一切。",
            "nextDialogs": [
              "751320602"
            ]
          },
          "751320602": {
            "id": "751320602",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "真是了不起啊，勇士，被侵蚀的力量也回归了夜神的国度，我能感受到夜魂们的欢悦。",
            "nextDialogs": [
              "751320603"
            ]
          },
          "751320603": {
            "id": "751320603",
            "speakerId": 21756,
            "speakerName": "谜画涂鸦中的意志",
            "text": "那么…就将这些作为报酬吧，勇士，达成伟业者，应当有所奖赏，请收下这些吧。"
          }
        }
      }
    }
  ]
}
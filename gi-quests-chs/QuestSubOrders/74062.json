    "纳库尔": 16
  },
  "subQuests": [
    {
      "subId": "7406201",
      "subQuestName": "与纳库尔对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740620101"
        ],
        "dialogs": {
          "740620101": {
            "id": "740620101",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "两位，两位请留步。听说两位是有求必应的闲人。",
            "nextDialogs": [
              "740620105",
              "740620104"
            ]
          },
          "740620105": {
            "id": "740620105",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "咳，其实是此前，穿紫裙的女童拜托我多多关照两位。",
            "nextDialogs": [
              "740620106"
            ]
          },
          "740620106": {
            "id": "740620106",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "我想两位既然有求必应，想必是本领高强，哪里有需要我来关照的道理。不如说，应该是两位多关照关照我。",
            "nextDialogs": [
              "740620107"
            ]
          },
          "740620107": {
            "id": "740620107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关照可以，打折不行。",
            "nextDialogs": [
              "740620108"
            ]
          },
          "740620108": {
            "id": "740620108",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "规矩我懂，这个好说。无论能不能成事，我都会按市场价支付报酬。此处摩拉无用，就以特许券计费。",
            "nextDialogs": [
              "740620109"
            ]
          },
          "740620109": {
            "id": "740620109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不管结果如何都能拿到报酬？真的吗？",
            "nextDialogs": [
              "740620110"
            ]
          },
          "740620110": {
            "id": "740620110",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "千真万确。事情就是这样难办，也怪尼扎米，拳头厉害，但用错地方。",
            "nextDialogs": [
              "740620111"
            ]
          },
          "740620111": {
            "id": "740620111",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "我还要滞留一阵，想找个合适治学的场所。最好有书架，有桌椅，有可供书写和黏贴资料的板子…",
            "nextDialogs": [
              "740620112"
            ]
          },
          "740620112": {
            "id": "740620112",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "你应该猜到我心中所想的地方了，但这地方借不得，理由多问无益。我想对面的一间理应构造相同，可堪一用。",
            "nextDialogs": [
              "740620113"
            ]
          },
          "740620113": {
            "id": "740620113",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "但那间蹊跷得很，似乎是被某人霸占了，且鲜少开门。我从未见过这个某人，也未见过开门的情景。",
            "nextDialogs": [
              "740620114"
            ]
          },
          "740620114": {
            "id": "740620114",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "于是我委派尼扎米作为代理，他原本是我雇佣的保镖，一向办事牢靠。可他也与这个某人话不投机，交涉失败。",
            "nextDialogs": [
              "740620115"
            ]
          },
          "740620115": {
            "id": "740620115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…感觉交涉和谈判应该不是他的长项呢。",
            "nextDialogs": [
              "740620116"
            ]
          },
          "740620116": {
            "id": "740620116",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "确实。那不是交涉与谈判的场景，他在外面用拳头捶门，从门里传出嚎叫。真叫我大开眼界。"
          },
          "740620104": {
            "id": "740620104",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "这个嘛…风言风语，只是风言风语罢了。"
          }
        }
      }
    },
    {
      "subId": "7406202",
      "subQuestName": "与门后的某人交涉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740620201"
        ],
        "dialogs": {
          "740620201": {
            "id": "740620201",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "要是之前没惹恼卡兰萨就好了，说不定和他交涉反而更轻松呢。唉。"
          }
        }
      }
    },
    {
      "subId": "7406203",
      "subQuestName": "与门后的某人交涉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740620301"
        ],
        "dialogs": {
          "740620301": {
            "id": "740620301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（听纳库尔的说法，不是枫丹本地人的话，好像会受排斥？他会不会也不愿意理我们呀？有没有什么好办法…）",
            "nextDialogs": [
              "740620302"
            ]
          },
          "740620302": {
            "id": "740620302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（敲门。）",
            "nextDialogs": [
              "740620303"
            ]
          },
          "740620303": {
            "id": "740620303",
            "speakerId": 21102,
            "speakerName": "某人",
            "text": "谁啊？",
            "nextDialogs": [
              "740620305",
              "740620307",
              "740620310"
            ]
          },
          "740620305": {
            "id": "740620305",
            "speakerId": 21102,
            "speakerName": "某人",
            "text": "…这儿什么时候变成观景点了？",
            "nextDialogs": [
              "740620312"
            ]
          },
          "740620312": {
            "id": "740620312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，认真一点啦，别忘了我们的目的。"
          },
          "740620307": {
            "id": "740620307",
            "speakerId": 21102,
            "speakerName": "某人",
            "text": "啊？",
            "nextDialogs": [
              "740620308"
            ]
          },
          "740620308": {
            "id": "740620308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（你这是干什么呀，这么说只会让问题更复杂吧？）"
          },
          "740620310": {
            "id": "740620310",
            "speakerId": 21102,
            "speakerName": "某人",
            "text": "#{M#就你这嗓音，你是美露莘？我还是膨膨兽呢，少来。}{F#我没病，我好得很，你不要过来。}",
            "nextDialogs": [
              "740620311"
            ]
          },
          "740620311": {
            "id": "740620311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（自称美露莘也太勉强了吧！）"
          }
        }
      }
    },
    {
      "subId": "7406204",
      "subQuestName": "与纳库尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740620501"
        ],
        "dialogs": {
          "740620501": {
            "id": "740620501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们回来了！事情是这样的…",
            "nextDialogs": [
              "740620502"
            ]
          },
          "740620502": {
            "id": "740620502",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "向纳库尔详细讲述了交涉的经过…",
            "nextDialogs": [
              "740620503"
            ]
          },
          "740620503": {
            "id": "740620503",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "哦…我了解了。不管怎么说，我是言而有信的雇主，所以之前约定的佣金支付给你们。",
            "nextDialogs": [
              "740620504"
            ]
          },
          "740620504": {
            "id": "740620504",
            "speakerId": 5220,
            "speakerName": "纳库尔",
            "text": "唔，接下来该怎么办呢…"
          }
        }
      }
    }
  ]
}
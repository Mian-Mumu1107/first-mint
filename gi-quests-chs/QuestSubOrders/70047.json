  "subQuests": [
    {
      "subId": "7004701",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700470101"
        ],
        "dialogs": {
          "700470101": {
            "id": "700470101",
            "speakerId": 14221,
            "speakerName": "阿乔",
            "text": "喂，基尼奇，快看谁来了。",
            "nextDialogs": [
              "700470102"
            ]
          },
          "700470102": {
            "id": "700470102",
            "speakerId": 14221,
            "speakerName": "阿乔",
            "text": "#{NICKNAME}，伟大圣龙库胡勒阿乔在此，速速前来觐见！",
            "nextDialogs": [
              "700470103"
            ]
          },
          "700470103": {
            "id": "700470103",
            "speakerId": 1088,
            "speakerName": "基尼奇",
            "text": "#又在这儿碰上了，{NICKNAME}。",
            "nextDialogs": [
              "700470104"
            ]
          },
          "700470104": {
            "id": "700470104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们好。",
            "nextDialogs": [
              "700470105"
            ]
          },
          "700470105": {
            "id": "700470105",
            "speakerId": 14221,
            "speakerName": "阿乔",
            "text": "我不好！这个闷葫芦在这儿盯着一堆五颜六色的纸壳子看了半天，也太无聊了。",
            "nextDialogs": [
              "700470106"
            ]
          },
          "700470106": {
            "id": "700470106",
            "speakerId": 1088,
            "speakerName": "基尼奇",
            "text": "这儿的装饰布置得挺有意思，看起来像是纸板做的。",
            "nextDialogs": [
              "700470109"
            ]
          },
          "700470109": {
            "id": "700470109",
            "speakerId": 1088,
            "speakerName": "基尼奇",
            "text": "是有点兴趣，感觉这纸板还挺适合作为阿乔的家。",
            "nextDialogs": [
              "700470110"
            ]
          },
          "700470110": {
            "id": "700470110",
            "speakerId": 14221,
            "speakerName": "阿乔",
            "text": "你什么意思？你说我是纸片龙？",
            "nextDialogs": [
              "700470111"
            ]
          },
          "700470111": {
            "id": "700470111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿乔的确经常住进箱子里。",
            "nextDialogs": [
              "700470112"
            ]
          },
          "700470112": {
            "id": "700470112",
            "speakerId": 14221,
            "speakerName": "阿乔",
            "text": "你…！你们！好啊，等到见识圣龙库胡勒阿乔俊伟真容的那天，你们别后悔！",
            "nextDialogs": [
              "700470113"
            ]
          },
          "700470113": {
            "id": "700470113",
            "speakerId": 1088,
            "speakerName": "基尼奇",
            "text": "那可要先把你纸片龙的姿态记录下来了。",
            "nextDialogs": [
              "700470114"
            ]
          },
          "700470114": {
            "id": "700470114",
            "speakerId": 1088,
            "speakerName": "基尼奇",
            "text": "#{NICKNAME}，我看到你带了留影机，能帮我给这个纸剧场拍一张吗？",
            "nextDialogs": [
              "700470115"
            ]
          },
          "700470115": {
            "id": "700470115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "顺便也给基尼奇拍一张吧。",
            "nextDialogs": [
              "700470116"
            ]
          },
          "700470116": {
            "id": "700470116",
            "speakerId": 1088,
            "speakerName": "基尼奇",
            "text": "也好，就当是来度假的纪念了。",
            "nextDialogs": [
              "700470117"
            ]
          },
          "700470117": {
            "id": "700470117",
            "speakerId": 1088,
            "speakerName": "基尼奇",
            "text": "对了，你对我们的入镜姿势有什么想法吗？"
          }
        }
      }
    }
  ]
}
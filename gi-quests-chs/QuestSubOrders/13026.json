    {
      "subId": "1302607",
      "subQuestName": "继续深入",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130260701"
        ],
        "dialogs": {
          "130260701": {
            "id": "130260701",
            "speakerId": 1006,
            "speakerName": "米沙勒",
            "text": "居然真的有人能从那边闯过来，真是让我意外。",
            "nextDialogs": [
              "130260702"
            ]
          },
          "130260702": {
            "id": "130260702",
            "speakerId": 1006,
            "speakerName": "米沙勒",
            "text": "不过，沙漠子民总是和意外相伴，我们也早就习惯了。",
            "nextDialogs": [
              "130260703"
            ]
          },
          "130260703": {
            "id": "130260703",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "废话少说，你已经没地方可以逃了。",
            "nextDialogs": [
              "130260704"
            ]
          },
          "130260704": {
            "id": "130260704",
            "speakerId": 1006,
            "speakerName": "米沙勒",
            "text": "逃？如果要选这条路的话，我有无数的机会。",
            "nextDialogs": [
              "130260705"
            ]
          },
          "130260705": {
            "id": "130260705",
            "speakerId": 1006,
            "speakerName": "米沙勒",
            "text": "我亲历了「神王之遗」最辉煌的时代，就算能苟且偷生，此后也只剩下无尽的折磨。",
            "nextDialogs": [
              "130260706"
            ]
          },
          "130260706": {
            "id": "130260706",
            "speakerId": 1006,
            "speakerName": "米沙勒",
            "text": "留下来的兄弟都认同一句话——",
            "nextDialogs": [
              "130260707"
            ]
          },
          "130260707": {
            "id": "130260707",
            "speakerId": 1006,
            "speakerName": "米沙勒",
            "text": "「伟大之人，不应有坠落之后的记忆。」",
            "nextDialogs": [
              "130260708"
            ]
          },
          "130260708": {
            "id": "130260708",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "哼，看来你是想要殊死一搏了。",
            "nextDialogs": [
              "130260709"
            ]
          },
          "130260709": {
            "id": "130260709",
            "speakerId": 1006,
            "speakerName": "米沙勒",
            "text": "#上吧，让{M#他}{F#她}们见识一下赤王大人留给我们的恩赐。",
            "nextDialogs": [
              "130260710"
            ]
          },
          "130260710": {
            "id": "130260710",
            "speakerId": 1006,
            "speakerName": "米沙勒",
            "text": "对手再怎么强，也只有两个人而已。"
          }
        }
      }
    },
    {
      "subId": "1302608",
      "subQuestName": "对抗「神王之遗」的残部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1302609",
      "subQuestName": "与迪希雅商量对策",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130260901"
        ],
        "dialogs": {
          "130260901": {
            "id": "130260901",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "发布命令的人总算倒下了。",
            "nextDialogs": [
              "130260902"
            ]
          },
          "130260902": {
            "id": "130260902",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但他们的攻势还没有结束！",
            "nextDialogs": [
              "130260903"
            ]
          },
          "130260903": {
            "id": "130260903",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这地方像斗兽场一样，继续打下去也没用啊。",
            "nextDialogs": [
              "130260904"
            ]
          },
          "130260904": {
            "id": "130260904",
            "speakerId": 1006,
            "speakerName": "米沙勒",
            "text": "来吧，继续上！无须畏惧，无须退缩，这是我们最后的阵地！",
            "nextDialogs": [
              "130260905"
            ]
          },
          "130260905": {
            "id": "130260905",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "下一波敌人冲上来的时候，你吸引他们来攻击你。",
            "nextDialogs": [
              "130260906"
            ]
          },
          "130260906": {
            "id": "130260906",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "我试试看…能不能直接砸掉上面的高台。",
            "nextDialogs": [
              "130260907"
            ]
          },
          "130260907": {
            "id": "130260907",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "给我闪开！",
            "nextDialogs": [
              "130260908"
            ]
          },
          "130260908": {
            "id": "130260908",
            "speakerId": 1005,
            "speakerName": "巴沙尔",
            "text": "米沙勒，滚出来！",
            "nextDialogs": [
              "130260909"
            ]
          },
          "130260909": {
            "id": "130260909",
            "speakerId": 1006,
            "speakerName": "米沙勒",
            "text": "正面也被突破了啊…",
            "nextDialogs": [
              "130260910"
            ]
          },
          "130260910": {
            "id": "130260910",
            "speakerId": 1007,
            "speakerName": "恐慌的佣兵",
            "text": "对不起，米沙勒大人，他们…他们根本不要命啊！怎么都砍不倒——！",
            "nextDialogs": [
              "130260911"
            ]
          },
          "130260911": {
            "id": "130260911",
            "speakerId": 1007,
            "speakerName": "恐慌的佣兵",
            "text": "啊——！",
            "nextDialogs": [
              "130260912"
            ]
          },
          "130260912": {
            "id": "130260912",
            "speakerId": 1006,
            "speakerName": "米沙勒",
            "text": "看来时间已经用尽了。",
            "nextDialogs": [
              "130260913"
            ]
          },
          "130260913": {
            "id": "130260913",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "该算总账了，米沙勒。",
            "nextDialogs": [
              "130260914"
            ]
          },
          "130260914": {
            "id": "130260914",
            "speakerId": 1006,
            "speakerName": "米沙勒",
            "text": "你以为我会给你们这个机会吗？",
            "nextDialogs": [
              "130260915"
            ]
          },
          "130260915": {
            "id": "130260915",
            "speakerId": 1006,
            "speakerName": "米沙勒",
            "text": "就让我和这即将熄灭的光辉，一同埋入黄沙之中吧。",
            "nextDialogs": [
              "130260916"
            ]
          },
          "130260916": {
            "id": "130260916",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "喂，等等！",
            "nextDialogs": [
              "130260917"
            ]
          },
          "130260917": {
            "id": "130260917",
            "speakerId": 1005,
            "speakerName": "巴沙尔",
            "text": "没赶上…",
            "nextDialogs": [
              "130260918"
            ]
          },
          "130260918": {
            "id": "130260918",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "…胜负已分，再打下去也没有意义。",
            "nextDialogs": [
              "130260919"
            ]
          },
          "130260919": {
            "id": "130260919",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "如果觉得还是佣兵的气节比较重要，我不介意也给你们一顿毒打。",
            "nextDialogs": [
              "130260920"
            ]
          },
          "130260920": {
            "id": "130260920",
            "speakerId": 1008,
            "speakerName": "犹豫的佣兵",
            "text": "……",
            "nextDialogs": [
              "130260921"
            ]
          },
          "130260921": {
            "id": "130260921",
            "speakerId": 1003,
            "speakerName": "提克里蒂",
            "text": "喂，迪希雅！我找到机关了，我现在就放你们上来！",
            "nextDialogs": [
              "130260922"
            ]
          },
          "130260922": {
            "id": "130260922",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "我们走吧。"
          }
        }
      }
    },
    {
      "subId": "1302612",
      "subQuestName": "前往上层",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130261201"
        ],
        "dialogs": {
          "130261201": {
            "id": "130261201",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "你们到底是什么人啊，为什么要一直盯着我们咬？",
            "nextDialogs": [
              "130261202"
            ]
          },
          "130261202": {
            "id": "130261202",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "堂堂「神王之遗」，名声这么响，都被人打到老家了，连打进来的人是谁都不知道。",
            "nextDialogs": [
              "130261203"
            ]
          },
          "130261203": {
            "id": "130261203",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "你们就像老鼠一样狡猾，东咬一口西咬一下，抓又抓不住，谁知道你们要干什么啊！",
            "nextDialogs": [
              "130261204"
            ]
          },
          "130261204": {
            "id": "130261204",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "喂，「库塞拉」这个名字，你还记得吗？",
            "nextDialogs": [
              "130261205"
            ]
          },
          "130261205": {
            "id": "130261205",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "不知道！我、我又不是老大！",
            "nextDialogs": [
              "130261206"
            ]
          },
          "130261206": {
            "id": "130261206",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "再给你一次机会。",
            "nextDialogs": [
              "130261207"
            ]
          },
          "130261207": {
            "id": "130261207",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "说、说了不知道！我只是个小跟班，我还能说谎吗？",
            "nextDialogs": [
              "130261208"
            ]
          },
          "130261208": {
            "id": "130261208",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "来找人的，你们去翻翻档案啊，团里进进出出那么多人，谁能每个都认得？",
            "nextDialogs": [
              "130261209"
            ]
          },
          "130261209": {
            "id": "130261209",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "滑稽至极。",
            "nextDialogs": [
              "130261210"
            ]
          },
          "130261210": {
            "id": "130261210",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "他的生命对很多人无比重要，但对某些人来说却一文不值。",
            "nextDialogs": [
              "130261211"
            ]
          },
          "130261211": {
            "id": "130261211",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "我问你，档案室在哪里？",
            "nextDialogs": [
              "130261212"
            ]
          },
          "130261212": {
            "id": "130261212",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "就在那边，所有档案都放在里面，你们去查啊，反正又没什么用处！",
            "nextDialogs": [
              "130261213"
            ]
          },
          "130261213": {
            "id": "130261213",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "我说旧的。",
            "nextDialogs": [
              "130261214"
            ]
          },
          "130261214": {
            "id": "130261214",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "旧、旧的…你说，被烧掉的那个？",
            "nextDialogs": [
              "130261215"
            ]
          },
          "130261215": {
            "id": "130261215",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "库塞拉！我想起来了，是他，那个瘸子！",
            "nextDialogs": [
              "130261216"
            ]
          },
          "130261216": {
            "id": "130261216",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "放尊重点！那是我们的团长！",
            "nextDialogs": [
              "130261217"
            ]
          },
          "130261217": {
            "id": "130261217",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "他、他绝对是装瘸！看他那副磕磕绊绊的样子，卫兵就掉以轻心了。",
            "nextDialogs": [
              "130261218"
            ]
          },
          "130261218": {
            "id": "130261218",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "带他去上厕所的工夫，他就溜掉了，跑去档案室放火…",
            "nextDialogs": [
              "130261219"
            ]
          },
          "130261219": {
            "id": "130261219",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "一个健全人都追不上他，怎么可能啊！",
            "nextDialogs": [
              "130261220"
            ]
          },
          "130261220": {
            "id": "130261220",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "在那之后，「神王之遗」就彻底失控了…",
            "nextDialogs": [
              "130261221"
            ]
          },
          "130261221": {
            "id": "130261221",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "别废话了，他做了什么，我们这里每个人都比你更清楚。",
            "nextDialogs": [
              "130261222"
            ]
          },
          "130261222": {
            "id": "130261222",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "快说，地方在哪儿。",
            "nextDialogs": [
              "130261223"
            ]
          },
          "130261223": {
            "id": "130261223",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "就在那边，你们想去看，去就是了！",
            "nextDialogs": [
              "130261224"
            ]
          },
          "130261224": {
            "id": "130261224",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "但里面除了灰什么都没有，那么大的火，人早就烤化了。",
            "nextDialogs": [
              "130261225"
            ]
          },
          "130261225": {
            "id": "130261225",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "巴沙尔，提克里蒂，我们一起去，剩下的留下来看好这帮人。",
            "nextDialogs": [
              "130261226"
            ]
          },
          "130261226": {
            "id": "130261226",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "要是敢乱动，不要留情。"
          }
        }
      }
    },
    {
      "subId": "1302613",
      "subQuestName": "前往档案室",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130261301"
        ],
        "dialogs": {
          "130261301": {
            "id": "130261301",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "这里就是他最后留下的地方。",
            "nextDialogs": [
              "130261302"
            ]
          },
          "130261302": {
            "id": "130261302",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "他是怎么做到的呢？一瘸一拐地躲开看守，潜入这里放火。",
            "nextDialogs": [
              "130261303"
            ]
          },
          "130261303": {
            "id": "130261303",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "你们说，他既然这么灵活，就算这里着火，也能顺利逃出去吧？",
            "nextDialogs": [
              "130261304"
            ]
          },
          "130261304": {
            "id": "130261304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "迪希雅…",
            "nextDialogs": [
              "130261305"
            ]
          },
          "130261305": {
            "id": "130261305",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "抱歉，如果是那样就好了。我们四处找找，看看有没有剩下什么吧。",
            "nextDialogs": [
              "130261306"
            ]
          },
          "130261306": {
            "id": "130261306",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "众人在房间里四处翻找了一番…",
            "nextDialogs": [
              "130261307"
            ]
          },
          "130261307": {
            "id": "130261307",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个是…拐杖？应该就是那个了吧…",
            "nextDialogs": [
              "130261308"
            ]
          },
          "130261308": {
            "id": "130261308",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "库塞拉团长…",
            "nextDialogs": [
              "130261309"
            ]
          },
          "130261309": {
            "id": "130261309",
            "speakerId": 1005,
            "speakerName": "巴沙尔",
            "text": "谢谢你做的一切。",
            "nextDialogs": [
              "130261310"
            ]
          },
          "130261310": {
            "id": "130261310",
            "speakerId": 1003,
            "speakerName": "提克里蒂",
            "text": "拐杖在大火之后能留下来，也算是不幸中的万幸了。",
            "nextDialogs": [
              "130261311"
            ]
          },
          "130261311": {
            "id": "130261311",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "我们再分头找找看吧，说不定还留下了其他东西…",
            "nextDialogs": [
              "130261312"
            ]
          },
          "130261312": {
            "id": "130261312",
            "speakerId": 1003,
            "speakerName": "提克里蒂",
            "text": "但还有什么东西连火灾都不怕呢？",
            "nextDialogs": [
              "130261313"
            ]
          },
          "130261313": {
            "id": "130261313",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "……"
          }
        }
      }
    },
    {
      "subId": "1302610",
      "subQuestName": "返回须弥城",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1302611",
      "subQuestName": "在酒馆安慰迪希雅",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130261101"
        ],
        "dialogs": {
          "130261101": {
            "id": "130261101",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "怎…怎么了？",
            "nextDialogs": [
              "130261104"
            ]
          },
          "130261104": {
            "id": "130261104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你以前问我，如果我突然变成了富翁我会想干什么。",
            "nextDialogs": [
              "130261105"
            ]
          },
          "130261105": {
            "id": "130261105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我说，会买很多很多好吃的和好喝的，你一副不理解的样子，但还是说我「可爱」。",
            "nextDialogs": [
              "130261106"
            ]
          },
          "130261106": {
            "id": "130261106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "机会难得，嘿嘿，这回让你感受感受派蒙的吃喝生活哲学。"
          }
        }
      }
    },
    {
      "subId": "1302614",
      "subQuestName": "前往大巴扎散心",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130261401"
        ],
        "dialogs": {
          "130261401": {
            "id": "130261401",
            "speakerId": 1011,
            "speakerName": "迪娜泽黛",
            "text": "这家的地毯相当不错，做工精细，材料也用得很好。",
            "nextDialogs": [
              "130261402"
            ]
          },
          "130261402": {
            "id": "130261402",
            "speakerId": 1012,
            "speakerName": "萨塔尔",
            "text": "终于…找到了，你们在这里。",
            "nextDialogs": [
              "130261403"
            ]
          },
          "130261403": {
            "id": "130261403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你、你不是那个咬了舌头的佣兵嘛？！原来你还能说话！",
            "nextDialogs": [
              "130261404"
            ]
          },
          "130261404": {
            "id": "130261404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不对，难不成你是来寻仇的？",
            "nextDialogs": [
              "130261405"
            ]
          },
          "130261405": {
            "id": "130261405",
            "speakerId": 1012,
            "speakerName": "萨塔尔",
            "text": "说什么呢，我哪有那个本事，我是来送东西的，等会儿就去投案。",
            "nextDialogs": [
              "130261406"
            ]
          },
          "130261406": {
            "id": "130261406",
            "speakerId": 1012,
            "speakerName": "萨塔尔",
            "text": "我醒过来之后，就赶忙去了「阿赫玛尔之须」的藏身处，想给他们报信。",
            "nextDialogs": [
              "130261407"
            ]
          },
          "130261407": {
            "id": "130261407",
            "speakerId": 1012,
            "speakerName": "萨塔尔",
            "text": "结果除了腿脚不便还在养伤的团员之外，其他人都不见了。",
            "nextDialogs": [
              "130261408"
            ]
          },
          "130261408": {
            "id": "130261408",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "那应该是在我们走了之后吧…",
            "nextDialogs": [
              "130261409"
            ]
          },
          "130261409": {
            "id": "130261409",
            "speakerId": 1012,
            "speakerName": "萨塔尔",
            "text": "嗯，他们说复仇已经完成，团里的人都去投案了，这个藏身处也很快会被调查。",
            "nextDialogs": [
              "130261410"
            ]
          },
          "130261410": {
            "id": "130261410",
            "speakerId": 1012,
            "speakerName": "萨塔尔",
            "text": "我本来也是为了偿还库塞拉的人情，既然现在大家都去投案了，我逃走也没有意义。",
            "nextDialogs": [
              "130261411"
            ]
          },
          "130261411": {
            "id": "130261411",
            "speakerId": 1012,
            "speakerName": "萨塔尔",
            "text": "受伤的那个人给了我这个箱子，说里面是库塞拉的遗物。",
            "nextDialogs": [
              "130261412"
            ]
          },
          "130261412": {
            "id": "130261412",
            "speakerId": 1012,
            "speakerName": "萨塔尔",
            "text": "营地里的东西肯定都会被收缴，如果不交出去，就没有机会了。",
            "nextDialogs": [
              "130261413"
            ]
          },
          "130261413": {
            "id": "130261413",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "…谢谢你。",
            "nextDialogs": [
              "130261414"
            ]
          },
          "130261414": {
            "id": "130261414",
            "speakerId": 1012,
            "speakerName": "萨塔尔",
            "text": "没事，大家都在为自己的信念而活，不必评价谁对谁错。",
            "nextDialogs": [
              "130261415"
            ]
          },
          "130261415": {
            "id": "130261415",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这一个箱子，就是迪希雅的父亲留下来的东西…比想象中要少呢。",
            "nextDialogs": [
              "130261416"
            ]
          },
          "130261416": {
            "id": "130261416",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "嗯，他只要有钱就会拿去享乐，吃肉，喝酒什么的。",
            "nextDialogs": [
              "130261417"
            ]
          },
          "130261417": {
            "id": "130261417",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "还是打开看看吧…",
            "nextDialogs": [
              "130261418"
            ]
          },
          "130261418": {
            "id": "130261418",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "这…这都是些什么啊？不都是破烂吗？而且，有点臭…",
            "nextDialogs": [
              "130261419"
            ]
          },
          "130261419": {
            "id": "130261419",
            "speakerId": 1011,
            "speakerName": "迪娜泽黛",
            "text": "呃，或许只是放的时间比较久了。",
            "nextDialogs": [
              "130261420"
            ]
          },
          "130261420": {
            "id": "130261420",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "手抄的故事书，纸都泛黄了，感觉翻两下就会散架。",
            "nextDialogs": [
              "130261421"
            ]
          },
          "130261421": {
            "id": "130261421",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "以前私下持有书籍是不符合教令院规定的，既然都违反规定了，好歹抄点有用的东西啊…",
            "nextDialogs": [
              "130261422"
            ]
          },
          "130261422": {
            "id": "130261422",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说明他真的很喜欢吧。",
            "nextDialogs": [
              "130261423"
            ]
          },
          "130261423": {
            "id": "130261423",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "还有几包小孩子喜欢吃的零食，全都碎了…臭味应该就是从这里发出来的吧。",
            "nextDialogs": [
              "130261424"
            ]
          },
          "130261424": {
            "id": "130261424",
            "speakerId": 1011,
            "speakerName": "迪娜泽黛",
            "text": "是买给你的吗？",
            "nextDialogs": [
              "130261425"
            ]
          },
          "130261425": {
            "id": "130261425",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "我不喜欢吃啊，小时候就不喜欢，他说给我买的，结果每次他吃得比我都多。",
            "nextDialogs": [
              "130261426"
            ]
          },
          "130261426": {
            "id": "130261426",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "而且吃的东西不能这么放，这不是常识吗…",
            "nextDialogs": [
              "130261427"
            ]
          },
          "130261427": {
            "id": "130261427",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "算了，我看看还有什么…",
            "nextDialogs": [
              "130261428"
            ]
          },
          "130261428": {
            "id": "130261428",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "剃须刀，纽扣，圆铁片，拼装木头人…",
            "nextDialogs": [
              "130261429"
            ]
          },
          "130261429": {
            "id": "130261429",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "毛线围巾，好像是女款，还有个发簪…怎么会有这些东西啊？",
            "nextDialogs": [
              "130261430"
            ]
          },
          "130261430": {
            "id": "130261430",
            "speakerId": 1011,
            "speakerName": "迪娜泽黛",
            "text": "我、我突然有点怕…",
            "nextDialogs": [
              "130261431"
            ]
          },
          "130261431": {
            "id": "130261431",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "对不起，小姐，他就是这种人。估计他把箱子当成垃圾堆了，什么都往里放。",
            "nextDialogs": [
              "130261432"
            ]
          },
          "130261432": {
            "id": "130261432",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "空着的酒瓶，一个，两个…你们说，正常人会留下这种东西吗？",
            "nextDialogs": [
              "130261435"
            ]
          },
          "130261435": {
            "id": "130261435",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，这个瓶子里，好像有东西哦？",
            "nextDialogs": [
              "130261436"
            ]
          },
          "130261436": {
            "id": "130261436",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "真的啊…",
            "nextDialogs": [
              "130261437"
            ]
          },
          "130261437": {
            "id": "130261437",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "倒出来了，好像是一张写了字的纸。不过下面都受潮了，希望字迹没有变模糊。",
            "nextDialogs": [
              "130261438"
            ]
          },
          "130261438": {
            "id": "130261438",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "「喝完了这瓶酒，突然想写信，但写完就放进瓶子，忘了就算了。」",
            "nextDialogs": [
              "130261439"
            ]
          },
          "130261439": {
            "id": "130261439",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "「写给迪希雅」…居然是写给我的吗？",
            "nextDialogs": [
              "130261440"
            ]
          },
          "130261440": {
            "id": "130261440",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你静静地看吧。",
            "nextDialogs": [
              "130261441"
            ]
          },
          "130261441": {
            "id": "130261441",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "没关系，先念念看。他如果写信，一定是有重要的事想说…至少是，希望记录下来。",
            "nextDialogs": [
              "130261442"
            ]
          },
          "130261442": {
            "id": "130261442",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「最近身体越来越差，别说出去玩，连走路都不得不拄拐，估计我也没几天了。」",
            "nextDialogs": [
              "130261443"
            ]
          },
          "130261443": {
            "id": "130261443",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「如果你能看到这封信，我应该已经不在了。」",
            "nextDialogs": [
              "130261444"
            ]
          },
          "130261444": {
            "id": "130261444",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「小时候的你多可爱啊，每个人都喜欢你，不管你哭还是笑，大家都很开心。」",
            "nextDialogs": [
              "130261445"
            ]
          },
          "130261445": {
            "id": "130261445",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「但稍微懂点事就没那么可爱了，肯定都怪伊德里西他们，成天不教好的…」",
            "nextDialogs": [
              "130261446"
            ]
          },
          "130261446": {
            "id": "130261446",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "说什么呢，罪魁祸首到底是谁啊。",
            "nextDialogs": [
              "130261447"
            ]
          },
          "130261447": {
            "id": "130261447",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「不对，正事，正事。我写这玩意儿的目的，就是告诉你，万一你什么都知道了，也别为我伤心。」",
            "nextDialogs": [
              "130261448"
            ]
          },
          "130261448": {
            "id": "130261448",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「因为呢，其实我啊，压根不是你的父亲。」",
            "nextDialogs": [
              "130261449"
            ]
          },
          "130261449": {
            "id": "130261449",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊？！",
            "nextDialogs": [
              "130261450"
            ]
          },
          "130261450": {
            "id": "130261450",
            "speakerId": 1011,
            "speakerName": "迪娜泽黛",
            "text": "他、他在开玩笑吗？",
            "nextDialogs": [
              "130261451"
            ]
          },
          "130261451": {
            "id": "130261451",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "我…我也不知道…",
            "nextDialogs": [
              "130261452"
            ]
          },
          "130261452": {
            "id": "130261452",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「我年轻的时候可厉害啦，比什么『炽鬃之狮』厉害一百倍，嘿嘿。」",
            "nextDialogs": [
              "130261453"
            ]
          },
          "130261453": {
            "id": "130261453",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「上天入地，无所不能，感觉只要努努力，就能把整个沙漠都收入囊中。」",
            "nextDialogs": [
              "130261454"
            ]
          },
          "130261454": {
            "id": "130261454",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「结果呢，有天我一个人在沙漠里喝酒，看见了还是婴儿的你。」",
            "nextDialogs": [
              "130261455"
            ]
          },
          "130261455": {
            "id": "130261455",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「躺在那里，小小的，小到风沙再吹一会儿，就能把你埋进去。」",
            "nextDialogs": [
              "130261456"
            ]
          },
          "130261456": {
            "id": "130261456",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「可是你的哭声很响，吵得我难受，回想起来，真是活力充沛的生命啊。」",
            "nextDialogs": [
              "130261457"
            ]
          },
          "130261457": {
            "id": "130261457",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看来…似乎不是玩笑。",
            "nextDialogs": [
              "130261458"
            ]
          },
          "130261458": {
            "id": "130261458",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「后来我就和伊德里西他们说，我在外面犯了点错误，他们居然没怀疑我。」",
            "nextDialogs": [
              "130261459"
            ]
          },
          "130261459": {
            "id": "130261459",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「骗了他们一辈子，真是抱歉啊，我也是迫不得已的。」",
            "nextDialogs": [
              "130261460"
            ]
          },
          "130261460": {
            "id": "130261460",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「我是他们的老大啊，总不能对他们说，我只是突然想当『父亲』了吧…」",
            "nextDialogs": [
              "130261461"
            ]
          },
          "130261461": {
            "id": "130261461",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「刚喝下去的酒都快呕出来了，哈哈哈哈。」",
            "nextDialogs": [
              "130261462"
            ]
          },
          "130261462": {
            "id": "130261462",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "……",
            "nextDialogs": [
              "130261463"
            ]
          },
          "130261463": {
            "id": "130261463",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「好了，迪希雅。」",
            "nextDialogs": [
              "130261464"
            ]
          },
          "130261464": {
            "id": "130261464",
            "speakerId": 1013,
            "speakerName": "库塞拉的信件",
            "text": "「你有我们梦寐以求的自由与善良，接下来的人生，自己选吧。」",
            "nextDialogs": [
              "130261465"
            ]
          },
          "130261465": {
            "id": "130261465",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "正文…结束了。",
            "nextDialogs": [
              "130261466"
            ]
          },
          "130261466": {
            "id": "130261466",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "…真是的，到最后也把我当小孩子看。",
            "nextDialogs": [
              "130261467"
            ]
          },
          "130261467": {
            "id": "130261467",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也幸好他把你当孩子看。",
            "nextDialogs": [
              "130261468"
            ]
          },
          "130261468": {
            "id": "130261468",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "嗯，不然可能就像他所说，我在婴儿时代就在风沙里窒息了。",
            "nextDialogs": [
              "130261469"
            ]
          },
          "130261469": {
            "id": "130261469",
            "speakerId": 1011,
            "speakerName": "迪娜泽黛",
            "text": "他是个好父亲，这一点和血缘与身份都无关。",
            "nextDialogs": [
              "130261470"
            ]
          },
          "130261470": {
            "id": "130261470",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "嗯，可惜是以这样的方式了解到全部的真相。",
            "nextDialogs": [
              "130261471"
            ]
          },
          "130261471": {
            "id": "130261471",
            "speakerId": 1011,
            "speakerName": "迪娜泽黛",
            "text": "他希望你做出的选择，你有想法了吗？",
            "nextDialogs": [
              "130261472"
            ]
          },
          "130261472": {
            "id": "130261472",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "嗯，他说他曾经是在风沙中捡到了我，我想试着去找找那个遗弃我的人。",
            "nextDialogs": [
              "130261473"
            ]
          },
          "130261473": {
            "id": "130261473",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "不为其他，只是想告诉他有这样一段故事。",
            "nextDialogs": [
              "130261474"
            ]
          },
          "130261474": {
            "id": "130261474",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "——曾经有个吊儿郎当的，喜欢乱来的，既幼稚，又伟大的人存在过。",
            "nextDialogs": [
              "130261475"
            ]
          },
          "130261475": {
            "id": "130261475",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "我也有机会成长为现在的我。",
            "nextDialogs": [
              "130261476"
            ]
          },
          "130261476": {
            "id": "130261476",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "能把线索分享给我们吗？我们经常去冒险，说不定就能找到什么相关的情报呢。",
            "nextDialogs": [
              "130261477"
            ]
          },
          "130261477": {
            "id": "130261477",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "好啊，谢谢你们，没想到你们这么热心。"
          }
        }
      }
    },
    {
      "subId": "1302650",

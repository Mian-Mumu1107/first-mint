            "id": "130265001",
            "speakerId": 1014,
            "speakerName": "米尔扎",
            "text": "太遗憾了，最后一战居然不能一起去。",
            "nextDialogs": [
              "130265002"
            ]
          },
          "130265002": {
            "id": "130265002",
            "speakerId": 1014,
            "speakerName": "米尔扎",
            "text": "你们一定要加油啊。"
          }
        }
      }
    },
    {
      "subId": "1302651",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],

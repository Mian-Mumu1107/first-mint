            "id": "130265101",
            "speakerId": 1015,
            "speakerName": "阿尤布",
            "text": "算是，结束了吧…"
          }
        }
      }
    },
    {
      "subId": "1302652",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130265201"
        ],
        "dialogs": {
          "130265201": {
            "id": "130265201",
            "speakerId": 1009,
            "speakerName": "沙赫布特",
            "text": "我知道的都说了，能别找我麻烦了吗？"
          }
        }
      }
    },
    {
      "subId": "1302699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130269905"
        ],
        "dialogs": {
          "130269905": {
            "id": "130269905",
            "speakerId": 1016,
            "speakerName": "哈姆宰",
            "text": "#第一波，上前！直接消灭{M#他}{F#她}们！",
            "nextDialogs": [
              "130269907"
            ]
          },
          "130269907": {
            "id": "130269907",
            "speakerId": 1016,
            "speakerName": "哈姆宰",
            "text": "神王大人不会抛弃任何一位信徒！",
            "nextDialogs": [
              "130269911"
            ]
          },
          "130269911": {
            "id": "130269911",
            "speakerId": 1010,
            "speakerName": "Black Screen",
            "text": "在通报之后，「三十人团」以维护治安的名义正式介入。\\n「神王之遗」的成员被绳之以法，「阿赫玛尔之须」也尽数自首。\\n拐杖作为库塞拉团长的遗物，交由迪希雅保管。\\n回须弥城的路上，迪希雅一言不发。"
          }
        }
      }
    }
  ]
}
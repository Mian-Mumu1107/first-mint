    {
      "subId": "1302603",
      "subQuestName": "与同行者交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130260301"
        ],
        "dialogs": {
          "130260301": {
            "id": "130260301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇，没想到里面是这幅样子…",
            "nextDialogs": [
              "130260302"
            ]
          },
          "130260302": {
            "id": "130260302",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "他们应该全都龟缩在这里面，不知道还剩下多少人。",
            "nextDialogs": [
              "130260303"
            ]
          },
          "130260303": {
            "id": "130260303",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "管他们有多少，全部抓起来就行了。",
            "nextDialogs": [
              "130260304"
            ]
          },
          "130260304": {
            "id": "130260304",
            "speakerId": 1003,
            "speakerName": "提克里蒂",
            "text": "还是要小心，就算是强弩之末，掉以轻心也是大忌。",
            "nextDialogs": [
              "130260305"
            ]
          },
          "130260305": {
            "id": "130260305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这种场面我见得多了。",
            "nextDialogs": [
              "130260306"
            ]
          },
          "130260306": {
            "id": "130260306",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "是啊，到底有多少本事，碰一碰就知道了。",
            "nextDialogs": [
              "130260307"
            ]
          },
          "130260307": {
            "id": "130260307",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "不管「神王之遗」这名字曾经有多威风，现在都不足为惧。",
            "nextDialogs": [
              "130260308"
            ]
          },
          "130260308": {
            "id": "130260308",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "嗯，更何况有你帮忙。我来带路吧，我曾经来过这里一次。"
          }
        }
      }
    },
    {
      "subId": "1302604",
      "subQuestName": "深入藏身处",
      "sceneId": null,
      "locations": [],

    {
      "subId": "1302605",
      "subQuestName": "继续深入",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "130260501"
        ],
        "dialogs": {
          "130260501": {
            "id": "130260501",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "就是这边，兄弟们跟我走，冲过去就到了！",
            "nextDialogs": [
              "130260502"
            ]
          },
          "130260502": {
            "id": "130260502",
            "speakerId": 1004,
            "speakerName": "众人",
            "text": "哦！",
            "nextDialogs": [
              "130260504"
            ]
          },
          "130260504": {
            "id": "130260504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "等等，不先观察一下吗？！",
            "nextDialogs": [
              "130260505"
            ]
          },
          "130260505": {
            "id": "130260505",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "喂，喂！你们没事吧？",
            "nextDialogs": [
              "130260506"
            ]
          },
          "130260506": {
            "id": "130260506",
            "speakerId": 1005,
            "speakerName": "巴沙尔",
            "text": "好像只是关起来了而已，没有触发什么别的陷阱…",
            "nextDialogs": [
              "130260507"
            ]
          },
          "130260507": {
            "id": "130260507",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "小心前面，有敌人杀过来了！",
            "nextDialogs": [
              "130260508"
            ]
          },
          "130260508": {
            "id": "130260508",
            "speakerId": 1003,
            "speakerName": "提克里蒂",
            "text": "既然如此，只有强行突破这一种选择了。",
            "nextDialogs": [
              "130260509"
            ]
          },
          "130260509": {
            "id": "130260509",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "不用管我们，这种情况我们也有心理准备了，你们找找看还有没有其他的路！",
            "nextDialogs": [
              "130260510"
            ]
          },
          "130260510": {
            "id": "130260510",
            "speakerId": 1001,
            "speakerName": "伊德里西",
            "text": "冲啊，不能给团长丢人！",
            "nextDialogs": [
              "130260511"
            ]
          },
          "130260511": {
            "id": "130260511",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我、我们快找找还有没有路吧，能早点过去帮忙也好！",
            "nextDialogs": [
              "130260512"
            ]
          },
          "130260512": {
            "id": "130260512",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "我看看…",
            "nextDialogs": [
              "130260513"
            ]
          },
          "130260513": {
            "id": "130260513",
            "speakerId": 1002,
            "speakerName": "迪希雅",
            "text": "那边看起来有条路，不过好像被堵住了。去试试那个机关吧。",
            "nextDialogs": [
              "130260514"
            ]
          },
          "130260514": {
            "id": "130260514",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，走！"
          }
        }
      }
    },
    {
      "subId": "1302606",

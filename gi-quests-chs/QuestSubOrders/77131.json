        "dialogs": {
          "771319901": {
            "id": "771319901",
            "speakerId": 1005,
            "speakerName": "「灰眸」",
            "text": "就在这附近…看起来，是禁止进入的房间。",
            "nextDialogs": [
              "771319902"
            ]
          },
          "771319902": {
            "id": "771319902",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "门前还有人看守呢…先<color=#00E1FFFF>找找看有没有别的路</color>吧。",
            "nextDialogs": [
              "771319903"
            ]
          },
          "771319903": {
            "id": "771319903",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "难道碎片就在里面…没有，里面只有奇怪的画和臻冰雕塑！",
            "nextDialogs": [
              "771319904"
            ]
          },
          "771319904": {
            "id": "771319904",
            "speakerId": 1005,
            "speakerName": "「灰眸」",
            "text": "奇怪，虽然能够感受到碎片大致是在此处，可是…",
            "nextDialogs": [
              "771319905"
            ]
          },
          "771319905": {
            "id": "771319905",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "找不到？那我们就先调查看看吧…"

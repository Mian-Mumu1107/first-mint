    {
      "subId": "2303709",
      "subQuestName": "与马鲁夫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230371101"
        ],
        "dialogs": {
          "230371101": {
            "id": "230371101",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "唔，这药汤看起来不错。",
            "nextDialogs": [
              "230371102"
            ]
          },
          "230371102": {
            "id": "230371102",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "多谢你帮忙了，旅行者，这是给你的报酬。",
            "nextDialogs": [
              "230371103"
            ]
          },
          "230371103": {
            "id": "230371103",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "等它彻底熬好之后，我会先自己试一下药。"
          }
        }
      }
    },
    {
      "subId": "2303702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230370201"
        ],
        "dialogs": {
          "230370201": {
            "id": "230370201",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "唉，这种病可不好治啊，看来还是得请扎卡里亚医生帮帮忙…",
            "nextDialogs": [
              "230370202"
            ]
          },
          "230370202": {
            "id": "230370202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "遇到什么重病患者了吗？",
            "nextDialogs": [
              "230370203"
            ]
          },
          "230370203": {
            "id": "230370203",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "欸？是旅行者啊…倒也不是什么重病患者，就是有个病人肚子痛的有些厉害。",
            "nextDialogs": [
              "230370204"
            ]
          },
          "230370204": {
            "id": "230370204",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "虽然我也给他开过药了，但药效却不怎么明显。",
            "nextDialogs": [
              "230370205"
            ]
          },
          "230370205": {
            "id": "230370205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不能开其他的药吗？",
            "nextDialogs": [
              "230370206"
            ]
          },
          "230370206": {
            "id": "230370206",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "咳…我哪会啊。现在我手头的药方，基本上都是我自己摸索出来的…",
            "nextDialogs": [
              "230370207"
            ]
          },
          "230370207": {
            "id": "230370207",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "这些药方治疗一些小病小痛还可以，一遇见症状稍微重点的病症就很难起效了。",
            "nextDialogs": [
              "230370208"
            ]
          },
          "230370208": {
            "id": "230370208",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "还好城里「健康之家」的扎卡里亚医生答应过我，可以帮我置办药方和药物…",
            "nextDialogs": [
              "230370209"
            ]
          },
          "230370209": {
            "id": "230370209",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "旅行者，你能帮我个忙吗？",
            "nextDialogs": [
              "230370210"
            ]
          },
          "230370210": {
            "id": "230370210",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "我现在还有一些患者要治疗，实在是走不开，你能帮我去城里找一下扎卡里亚医生，请他帮我开一个药方吗？",
            "nextDialogs": [
              "230370212",
              "230370214"
            ]
          },
          "230370212": {
            "id": "230370212",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "那就拜托你了，旅行者。"
          },
          "230370214": {
            "id": "230370214",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "扎卡里亚医生偶尔会托人送点药过来，但他太忙了，实在是没什么空来村里。",
            "nextDialogs": [
              "230370215"
            ]
          },
          "230370215": {
            "id": "230370215",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "总之药方的事就拜托你了，旅行者。"
          }
        }
      }
    },

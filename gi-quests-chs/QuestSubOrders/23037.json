  "subQuests": [
    {
      "subId": "2303701",
      "subQuestName": "与马鲁夫对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230370101"
        ],
        "dialogs": {
          "230370101": {
            "id": "230370101",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "唉，这种病可不好治啊，看来还是得请扎卡里亚医生帮帮忙…",
            "nextDialogs": [
              "230370102"
            ]
          },
          "230370102": {
            "id": "230370102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "遇到什么重病患者了吗？",
            "nextDialogs": [
              "230370103"
            ]
          },
          "230370103": {
            "id": "230370103",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "欸？是旅行者啊…倒也不是什么重病患者，就是有个病人头疼的有些厉害。",
            "nextDialogs": [
              "230370104"
            ]
          },
          "230370104": {
            "id": "230370104",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "虽然我也给他开过药了，但药效却不怎么明显。",
            "nextDialogs": [
              "230370105"
            ]
          },
          "230370105": {
            "id": "230370105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不能开其他的药吗？",
            "nextDialogs": [
              "230370106"
            ]
          },
          "230370106": {
            "id": "230370106",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "咳…我哪会啊。现在我手头的药方，基本上都是我自己摸索出来的…",
            "nextDialogs": [
              "230370107"
            ]
          },
          "230370107": {
            "id": "230370107",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "这些药方治疗一些小病小痛还可以，一遇见症状稍微重点的病症就很难起效了。",
            "nextDialogs": [
              "230370108"
            ]
          },
          "230370108": {
            "id": "230370108",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "还好城里「健康之家」的扎卡里亚医生答应过我，可以帮我置办药方和药物…",
            "nextDialogs": [
              "230370109"
            ]
          },
          "230370109": {
            "id": "230370109",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "旅行者，你能帮我个忙吗？",
            "nextDialogs": [
              "230370110"
            ]
          },
          "230370110": {
            "id": "230370110",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "我现在还有一些患者要治疗，实在是走不开，你能帮我去城里找一下扎卡里亚医生，请他帮我开一个药方吗？",
            "nextDialogs": [
              "230370112",
              "230370114"
            ]
          },
          "230370112": {
            "id": "230370112",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "那就拜托你了，旅行者。"
          },
          "230370114": {
            "id": "230370114",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "扎卡里亚医生偶尔会托人送点药过来，但他太忙了，实在是没什么空来村里。",
            "nextDialogs": [
              "230370115"
            ]
          },
          "230370115": {
            "id": "230370115",
            "speakerId": 1000,
            "speakerName": "马鲁夫",
            "text": "总之药方的事就拜托你了，旅行者。"
          }
        }
      }
    },
    {
      "subId": "2303702",
      "subQuestName": "与扎卡里亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230370501"
        ],
        "dialogs": {
          "230370501": {
            "id": "230370501",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "最近的病人怎么越来越多了…",
            "nextDialogs": [
              "230370502"
            ]
          },
          "230370502": {
            "id": "230370502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于马鲁夫的事…",
            "nextDialogs": [
              "230370503"
            ]
          },
          "230370503": {
            "id": "230370503",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "马鲁夫？他又遇见什么疑难杂症了吗？",
            "nextDialogs": [
              "230370504"
            ]
          },
          "230370504": {
            "id": "230370504",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "叙述了马鲁夫所面对的病症…",
            "nextDialogs": [
              "230370505"
            ]
          },
          "230370505": {
            "id": "230370505",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "唉，我说了多少次了，这种小病以他的水平完全可以独立治疗，没必要来找我啊。",
            "nextDialogs": [
              "230370506"
            ]
          },
          "230370506": {
            "id": "230370506",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "估计又是那些病患觉得自己的病很重，不相信他这位「赤脚医生」…",
            "nextDialogs": [
              "230370507"
            ]
          },
          "230370507": {
            "id": "230370507",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "为了让病患安心，才来请我给他开个药方吧。",
            "nextDialogs": [
              "230370508"
            ]
          },
          "230370508": {
            "id": "230370508",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "这么多年一直待在那里治病，也是辛苦他了…我这就给他写个药方，请你记录一下吧，旅行者。",
            "nextDialogs": [
              "230370509"
            ]
          },
          "230370509": {
            "id": "230370509",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "唔，我记得马鲁夫这次要治的病是…",
            "nextDialogs": [
              "230370510"
            ]
          },
          "230370510": {
            "id": "230370510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是个头疼的病患。",
            "nextDialogs": [
              "230370511"
            ]
          },
          "230370511": {
            "id": "230370511",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "嗯，治疗头疼…就用我之前给他开的那种方子就好。",
            "nextDialogs": [
              "230370512"
            ]
          },
          "230370512": {
            "id": "230370512",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "把那个方子里的药物煮成药汤，然后再加入三株<color=#00E1FFFF>薄荷</color>。",
            "nextDialogs": [
              "230370513"
            ]
          },
          "230370513": {
            "id": "230370513",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "最后把加入了薄荷的药汤用<color=#00E1FFFF>大火</color>继续煮，煮大概…算了…<color=#00E1FFFF>煮到药材都浮起来</color>就好了。",
            "nextDialogs": [
              "230370514"
            ]
          },
          "230370514": {
            "id": "230370514",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "唔…我还是写下来给你吧，免得你忘了…",
            "nextDialogs": [
              "230370520"
            ]
          },
          "230370520": {
            "id": "230370520",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "扎卡里亚将方子写在了纸上…",
            "nextDialogs": [
              "230370515"
            ]
          },
          "230370515": {
            "id": "230370515",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "那就麻烦你把这方子给马鲁夫送回去了。",
            "nextDialogs": [
              "230370516"
            ]
          },
          "230370516": {
            "id": "230370516",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "说实话，这药方名义上说是「药」，其实更接近一种…呃，怎么形容呢…",
            "nextDialogs": [
              "230370517"
            ]
          },
          "230370517": {
            "id": "230370517",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "一种…药效不怎么猛烈，以补充营养为主的补充剂吧。",
            "nextDialogs": [
              "230370518"
            ]
          },
          "230370518": {
            "id": "230370518",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "就算制作时没完全按照药方上来，也不会有什么严重后果，顶多就是喝下去没效果罢了。",
            "nextDialogs": [
              "230370519"
            ]
          },
          "230370519": {
            "id": "230370519",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "唉，所以说，马鲁夫自己调整一下药方就行了，他就不能自信点吗…"
          }
        }
      }
    },

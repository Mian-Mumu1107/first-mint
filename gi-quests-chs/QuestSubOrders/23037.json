            ]
          },
          "230370713": {
            "id": "230370713",
            "speakerId": 1001,
            "speakerName": "扎卡里亚",
            "text": "最后把加入了星蕈的药汤用大火继续煮，最好<color=#00E1FFFF>先用大火</color>短暂地煮一会，<color=#00E1FFFF>再用小火煮</color>久一些，<color=#00E1FFFF>煮到药汤颜色变深</color>就好。",

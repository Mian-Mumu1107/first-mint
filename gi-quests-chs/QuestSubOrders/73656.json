    {
      "subId": "7365601",
      "subQuestName": "将十个香辛果交给侯赛因",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736560101"
        ],
        "dialogs": {
          "736560101": {
            "id": "736560101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于香辛果…",
            "nextDialogs": [
              "736560102"
            ]
          },
          "736560102": {
            "id": "736560102",
            "speakerId": 4007,
            "speakerName": "侯赛因",
            "text": "哦，我知道了，你是看到了我在阿芬迪先生那里挂的委托了。",
            "nextDialogs": [
              "736560103"
            ]
          },
          "736560103": {
            "id": "736560103",
            "speakerId": 4007,
            "speakerName": "侯赛因",
            "text": "阿芬迪先生果然是个可靠的人，在那里挂委托还真的能找到合伙人。",
            "nextDialogs": [
              "736560104"
            ]
          },
          "736560104": {
            "id": "736560104",
            "speakerId": 4007,
            "speakerName": "侯赛因",
            "text": "怎么样，你准备好那十个香辛果了吗？",
            "nextDialogs": [
              "736560106"
            ]
          },
          "736560106": {
            "id": "736560106",
            "speakerId": 4007,
            "speakerName": "侯赛因",
            "text": "我是诚心地想做点小生意，你可别拿我开玩笑啊，十个香辛果对生意人来说可不算多。",
            "nextDialogs": [
              "736560107"
            ]
          },
          "736560107": {
            "id": "736560107",
            "speakerId": 4007,
            "speakerName": "侯赛因",
            "text": "你要是真的愿意供货，至少应该拿得出这十个香辛果吧。"
          }
        }
      }
    },
    {
      "subId": "7365602",
      "subQuestName": "与侯赛因对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736560201"
        ],
        "dialogs": {
          "736560201": {
            "id": "736560201",
            "speakerId": 4007,
            "speakerName": "侯赛因",
            "text": "谢谢，如果香料这门生意真能让我做起来的话，我们就是生意合作伙伴了。"
          }
        }
      }
    }
  ]

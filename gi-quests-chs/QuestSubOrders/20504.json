  "subQuests": [
    {
      "subId": "2050401",
      "subQuestName": "与店主玛乔丽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205040101"
        ],
        "dialogs": {
          "205040101": {
            "id": "205040101",
            "speakerId": 1000,
            "speakerName": "玛乔丽",
            "text": "欢迎光临，这里的宝物保证独一无二。",
            "nextDialogs": [
              "205040102"
            ]
          },
          "205040102": {
            "id": "205040102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好多都是没见过的东西…",
            "nextDialogs": [
              "205040103"
            ]
          },
          "205040103": {
            "id": "205040103",
            "speakerId": 1000,
            "speakerName": "玛乔丽",
            "text": "哈哈，当然了，这些都是冒险家从世界各地找到的稀奇宝贝。",
            "nextDialogs": [
              "205040104"
            ]
          },
          "205040104": {
            "id": "205040104",
            "speakerId": 1000,
            "speakerName": "玛乔丽",
            "text": "怎么样，有一眼就相中的吗？",
            "nextDialogs": [
              "205040107"
            ]
          },
          "205040107": {
            "id": "205040107",
            "speakerId": 1000,
            "speakerName": "玛乔丽",
            "text": "不会不会，忘记和你介绍了，我这里都是以物易物，不收取摩拉。",
            "nextDialogs": [
              "205040108"
            ]
          },
          "205040108": {
            "id": "205040108",
            "speakerId": 1000,
            "speakerName": "玛乔丽",
            "text": "我最近想做一个特殊的工艺品，需要大量的<color=#00E1FFFF>「风之印」</color>来装饰。",
            "nextDialogs": [
              "205040109"
            ]
          },
          "205040109": {
            "id": "205040109",
            "speakerId": 1000,
            "speakerName": "玛乔丽",
            "text": "你们身上有<color=#00E1FFFF>「风之印」</color>吗？"
          }
        }
      }
    },
    {
      "subId": "2050402",

  "subQuests": [
    {
      "subId": "300912",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30091201"
        ],
        "dialogs": {
          "30091201": {
            "id": "30091201",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "你的意思是…头脑疲惫是虚空所导致的？细细感受的话，我也能感觉到精神上异常的疲惫。",
            "nextDialogs": [
              "30091202"
            ]
          },
          "30091202": {
            "id": "30091202",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "我记得沙漠中的子民们求知的时候，贤者也曾经说过「知识从来都不是免费的」…",
            "nextDialogs": [
              "30091203"
            ]
          },
          "30091203": {
            "id": "30091203",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "难道说，统合全民的智慧指的是…虚空还会反过来征用我们的大脑吗？",
            "nextDialogs": [
              "30091204"
            ]
          },
          "30091204": {
            "id": "30091204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可虚空究竟是用什么方式…",
            "nextDialogs": [
              "30091205"
            ]
          },
          "30091205": {
            "id": "30091205",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "谁知道呢，既然它可以投放知识给你，那自然也能对你的大脑动手动脚吧？具体如何还不太好猜就是了。",
            "nextDialogs": [
              "30091206"
            ]
          },
          "30091206": {
            "id": "30091206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那这么做的好处是什么呀？",
            "nextDialogs": [
              "30091207"
            ]
          },
          "30091207": {
            "id": "30091207",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "你想啊，统合起所有须弥民众的智慧的话，不就相当于把须弥城当做一个巨型大脑来用了吗…",
            "nextDialogs": [
              "30091208"
            ]
          },
          "30091208": {
            "id": "30091208",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "…很多最聪明的人的大脑也想不清楚的问题，用上这个巨型大脑或许就会有新的结果。",
            "nextDialogs": [
              "30091209"
            ]
          },
          "30091209": {
            "id": "30091209",
            "speakerId": 1002,
            "speakerName": "纳西妲",
            "text": "了不起的推论，尤其是将须弥城比作巨型大脑的比喻，嗯，我很喜欢。",
            "nextDialogs": [
              "30091210"
            ]
          },
          "30091210": {
            "id": "30091210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "既然如此，我们快点把虚空终端摘掉吧，说不定问题就解决了？",
            "nextDialogs": [
              "30091213"
            ]
          },
          "30091213": {
            "id": "30091213",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "是啊，本来我戴着它就是装装样子的，没想到被贤者他们算计了。这件事结束后，我一定要找到证据，再把这件事公之于众！",
            "nextDialogs": [
              "30091214"
            ]
          },
          "30091214": {
            "id": "30091214",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "所有人都取下了虚空终端…",
            "nextDialogs": [
              "30091215"
            ]
          },
          "30091215": {
            "id": "30091215",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你们感觉怎么样？",
            "nextDialogs": [
              "30091216"
            ]
          },
          "30091216": {
            "id": "30091216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说起来，我还注意到一件事。",
            "nextDialogs": [
              "30091217"
            ]
          },
          "30091217": {
            "id": "30091217",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？你想到什么了？"
          }
        }
      }
    },
    {
      "subId": "300913",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30091001"
        ],
        "dialogs": {
          "30091001": {
            "id": "30091001",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（哈欠）——感觉好累呀，明明睡了还蛮多的。",
            "nextDialogs": [
              "30091002"
            ]
          },
          "30091002": {
            "id": "30091002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不管了，先去跟迪娜泽黛会合吧。"
          }
        }
      }
    },
    {
      "subId": "300901",
      "subQuestName": "到约定地点与迪娜泽黛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30090101"
        ],
        "dialogs": {
          "30090101": {
            "id": "30090101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "早呀，迪娜泽黛，是不是等我们很久了。",
            "nextDialogs": [
              "30090102"
            ]
          },
          "30090102": {
            "id": "30090102",
            "speakerId": 1004,
            "speakerName": "迪娜泽黛",
            "text": "没有，是我来得太早了。",
            "nextDialogs": [
              "30090103"
            ]
          },
          "30090103": {
            "id": "30090103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？感觉你说话很没有精神，是没睡好吗？",
            "nextDialogs": [
              "30090104"
            ]
          },
          "30090104": {
            "id": "30090104",
            "speakerId": 1004,
            "speakerName": "迪娜泽黛",
            "text": "我很好，不用担心。我们走吧？先去那边的摊位上逛逛。",
            "nextDialogs": [
              "30090105"
            ]
          },
          "30090105": {
            "id": "30090105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好主意！走吧，旅行者…喂，旅行者？"
          }
        }
      }
    },
    {
      "subId": "300914",
      "subQuestName": "与迪娜泽黛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30091101"
        ],
        "dialogs": {
          "30091101": {
            "id": "30091101",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "…多亏了迪娜泽黛小姐，不然孩子们可就没有花神诞祭过了，呵呵。",
            "nextDialogs": [
              "30091102"
            ]
          },
          "30091102": {
            "id": "30091102",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "哦对了，你们对雅尔达糖果感兴趣吗，我这有几个糖果盒子，你们随便挑。",
            "nextDialogs": [
              "30091103"
            ]
          },
          "30091103": {
            "id": "30091103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这些盒子看上去不都一样吗，怎么挑呀？",
            "nextDialogs": [
              "30091104"
            ]
          },
          "30091104": {
            "id": "30091104",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "哈哈，这才是乐趣所在啊，每个盒子里都装着随机的一种口味，吃到什么纯看运气。糖果有香辛果味，堇瓜味，日落果味…",
            "nextDialogs": [
              "30091105"
            ]
          },
          "30091105": {
            "id": "30091105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯~嗯~的确很有意思。",
            "nextDialogs": [
              "30091106"
            ]
          },
          "30091106": {
            "id": "30091106",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "…然后还有蜥蜴尾巴味和鬼兜虫味。",
            "nextDialogs": [
              "30091107"
            ]
          },
          "30091107": {
            "id": "30091107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸！你刚才说什么味道！？",
            "nextDialogs": [
              "30091108"
            ]
          },
          "30091108": {
            "id": "30091108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#唔…就让{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}帮我选吧，我想吃日落果味的！",
            "nextDialogs": [
              "30091109"
            ]
          },
          "30091109": {
            "id": "30091109",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "没问题，这五个糖果盒子，从左到右是一号到五号，你选几号呢？",
            "nextDialogs": [
              "30091115"
            ]
          },
          "30091115": {
            "id": "30091115",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "哦？可真是毫不犹豫呢，这么自信满满。好吧，恭喜你，四号就是日落果味的。",
            "nextDialogs": [
              "30091116"
            ]
          },
          "30091116": {
            "id": "30091116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哈哈，可不是我吹牛，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的运气一直都很厉害！"
          }
        }
      }
    },

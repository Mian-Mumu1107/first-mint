    {
      "subId": "300903",
      "subQuestName": "跟踪熟悉的身影",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "300904",
      "subQuestName": "跟踪熟悉的身影",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30090201"
        ],
        "dialogs": {
          "30090201": {
            "id": "30090201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你在找什么呀？为什么到这边来了？",
            "nextDialogs": [
              "30090202"
            ]
          },
          "30090202": {
            "id": "30090202",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "熟悉的身影…强烈的既视感…",
            "nextDialogs": [
              "30090203"
            ]
          },
          "30090203": {
            "id": "30090203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "旅行者？",
            "nextDialogs": [
              "30090204"
            ]
          },
          "30090204": {
            "id": "30090204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在那里。",
            "nextDialogs": [
              "30090205"
            ]
          },
          "30090205": {
            "id": "30090205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那边是…"
          }
        }
      }
    },
    {
      "subId": "300917",
      "subQuestName": "(test)【隐藏】对话中鸟笼切换$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "300905",
      "subQuestName": "与神秘少女对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30090401"
        ],
        "dialogs": {
          "30090401": {
            "id": "30090401",
            "speakerId": 1002,
            "speakerName": "纳西妲",
            "text": "「时间循环」吗…以往你也给出过类似的错误答案呢，很遗憾。",
            "nextDialogs": [
              "30090402"
            ]
          },
          "30090402": {
            "id": "30090402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还是不对么…明明我觉得挺有道理的，感觉就是时间的流动在同一天循环呀。",
            "nextDialogs": [
              "30090403"
            ]
          },
          "30090403": {
            "id": "30090403",
            "speakerId": 1002,
            "speakerName": "纳西妲",
            "text": "简单的时间循环还并不足以解释一些现象，你们手中的线索想必也还欠缺许多，可惜我也无法再提示你们更多了…",
            "nextDialogs": [
              "30090404"
            ]
          },
          "30090404": {
            "id": "30090404",
            "speakerId": 1004,
            "speakerName": "迪娜泽黛",
            "text": "咳咳…",
            "nextDialogs": [
              "30090405"
            ]
          },
          "30090405": {
            "id": "30090405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，迪娜泽黛…",
            "nextDialogs": [
              "30090406"
            ]
          },
          "30090406": {
            "id": "30090406",
            "speakerId": 1002,
            "speakerName": "纳西妲",
            "text": "尽管每天都是花神诞祭，但我们也并没有无数个花神诞祭可以浪费了，在今天的祭典结束之前，抓紧寻找真相吧。",
            "nextDialogs": [
              "30090407"
            ]
          },
          "30090407": {
            "id": "30090407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "先思考一下目前的状况…要想拯救迪娜泽黛的话，就要想办法从「花神诞日的轮回」中脱困…",
            "nextDialogs": [
              "30090408"
            ]
          },
          "30090408": {
            "id": "30090408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "想要脱困至少就要先搞清楚究竟发生了什么，也就是「真相」…",
            "nextDialogs": [
              "30090409"
            ]
          },
          "30090409": {
            "id": "30090409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "既然纳西妲否定了「时间循环」的观点，那肯定是我们疏漏了什么吧？",
            "nextDialogs": [
              "30090410"
            ]
          },
          "30090410": {
            "id": "30090410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然记忆里已经做过很多次了，但还是再多和人们聊聊吧，总比我们凭空在这里琢磨强…就从那几个摆摊的人入手吧？"
          }
        }
      }
    },
    {
      "subId": "300906",
      "subQuestName": "询问关于现状的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30090501"
        ],
        "dialogs": {
          "30090501": {
            "id": "30090501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你好，大叔。",
            "nextDialogs": [
              "30090502"
            ]
          },
          "30090502": {
            "id": "30090502",
            "speakerId": 1006,
            "speakerName": "阿玛尔",
            "text": "哟，你们又回来了，那个懂行的小姐呢？",
            "nextDialogs": [
              "30090503"
            ]
          },
          "30090503": {
            "id": "30090503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "她…她有点身体不舒服。",
            "nextDialogs": [
              "30090504"
            ]
          },
          "30090504": {
            "id": "30090504",
            "speakerId": 1006,
            "speakerName": "阿玛尔",
            "text": "这样啊，你们回来是打算买些货回去吗？我向你们保证，我这些食材都绝对新鲜，昨天刚从森林里摘回来的。",
            "nextDialogs": [
              "30090507"
            ]
          },
          "30090507": {
            "id": "30090507",
            "speakerId": 1006,
            "speakerName": "阿玛尔",
            "text": "哈？为什么这么问，我昨天匆匆忙忙从森林里赶回来，今天卖货，没感觉有什么奇怪的啊？",
            "nextDialogs": [
              "30090508"
            ]
          },
          "30090508": {
            "id": "30090508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…应该说，你仔细回想回想，「昨天」真的是「昨天」吗？昨天的你真的刚从森林里回来吗？",
            "nextDialogs": [
              "30090509"
            ]
          },
          "30090509": {
            "id": "30090509",
            "speakerId": 1006,
            "speakerName": "阿玛尔",
            "text": "这是什么乱七八糟的哲学问题吗？你们在做白日梦吧？",
            "nextDialogs": [
              "30090510"
            ]
          },
          "30090510": {
            "id": "30090510",
            "speakerId": 1006,
            "speakerName": "阿玛尔",
            "text": "你应该知道的吧，我们须弥人可是不会做梦的，你们还是到别处找人陪你们做梦吧，哈哈哈…",
            "nextDialogs": [
              "30090511"
            ]
          },
          "30090511": {
            "id": "30090511",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…其实他说的也是，这会不会是一场梦呀，难道大家都在做梦？"
          }
        }
      }
    },
    {
      "subId": "300907",
      "subQuestName": "询问关于现状的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30090601"
        ],
        "dialogs": {
          "30090601": {
            "id": "30090601",
            "speakerId": 1007,
            "speakerName": "齐米亚",
            "text": "欸，是你们啊，难道是我的占卜太准，特意来夸我的么？",
            "nextDialogs": [
              "30090604"
            ]
          },
          "30090604": {
            "id": "30090604",
            "speakerId": 1007,
            "speakerName": "齐米亚",
            "text": "哦哦哦！果然吗！我就说神明的占卜很灵验的，只是你们还没参透罢了吧，哈哈哈…",
            "nextDialogs": [
              "30090605"
            ]
          },
          "30090605": {
            "id": "30090605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂，你怎么这么兴奋…所以我们来找你，就是让你帮忙参透的。",
            "nextDialogs": [
              "30090606"
            ]
          },
          "30090606": {
            "id": "30090606",
            "speakerId": 1007,
            "speakerName": "齐米亚",
            "text": "呃…让我来参透吗…这、这可不是我擅长的领域…",
            "nextDialogs": [
              "30090607"
            ]
          },
          "30090607": {
            "id": "30090607",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你就承认你是个半吊子吧。",
            "nextDialogs": [
              "30090608"
            ]
          },
          "30090608": {
            "id": "30090608",
            "speakerId": 1007,
            "speakerName": "齐米亚",
            "text": "所以说，你们究竟遇到了什么事呢？"
          }
        }
      }
    },
    {
      "subId": "300909",
      "subQuestName": "与迪希雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30090717"
        ],
        "dialogs": {
          "30090717": {
            "id": "30090717",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就是这个！",
            "nextDialogs": [
              "30090703"
            ]
          },
          "30090703": {
            "id": "30090703",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "……",
            "nextDialogs": [
              "30090704"
            ]
          },
          "30090704": {
            "id": "30090704",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "这件事我应该没有和任何人说过，包括小姐，你应该不可能知道…还有刚才你们也在抢先说我想说的话，这是怎么回事？",
            "nextDialogs": [
              "30090705"
            ]
          },
          "30090705": {
            "id": "30090705",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听我说，事情是这样的…",
            "nextDialogs": [
              "30090706"
            ]
          },
          "30090706": {
            "id": "30090706",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "和迪希雅解释了情况…",
            "nextDialogs": [
              "30090707"
            ]
          },
          "30090707": {
            "id": "30090707",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "让我相信你们说的这种事，实在有点…先说好，我们这些沙漠子民可能大多都不怎么学识渊博，但基本的常识还是有的…",
            "nextDialogs": [
              "30090708"
            ]
          },
          "30090708": {
            "id": "30090708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你没发现迪娜泽黛有些不同么。",
            "nextDialogs": [
              "30090709"
            ]
          },
          "30090709": {
            "id": "30090709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就是很沉默寡言，又对所有事情提不起兴趣，很悲观的样子…",
            "nextDialogs": [
              "30090710"
            ]
          },
          "30090710": {
            "id": "30090710",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "的确，和之前有些不同。但是…",
            "nextDialogs": [
              "30090711"
            ]
          },
          "30090711": {
            "id": "30090711",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "…我听小姐的父母说，在一开始的时候，她曾经就是这个样子的。",
            "nextDialogs": [
              "30090712"
            ]
          },
          "30090712": {
            "id": "30090712",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊？一开始的时候？",
            "nextDialogs": [
              "30090713"
            ]
          },
          "30090713": {
            "id": "30090713",
            "speakerId": 1004,
            "speakerName": "迪娜泽黛",
            "text": "我有些听不懂你们说的，我先去那边的长椅上休息了。",
            "nextDialogs": [
              "30090714"
            ]
          },
          "30090714": {
            "id": "30090714",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "小姐…你该不会生气了吧…",
            "nextDialogs": [
              "30090715"
            ]
          },
          "30090715": {
            "id": "30090715",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "跟我去一个地方吧，我会给你看证据。",
            "nextDialogs": [
              "30090716"
            ]
          },
          "30090716": {
            "id": "30090716",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "…好吧，既然连我的大剑的事都知道，或许你们刚才说的确实是真的。我们速去速回吧，小姐的安全目前还不能完全保证。"
          }
        }
      }
    },

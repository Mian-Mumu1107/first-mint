    {
      "subId": "300908",
      "subQuestName": "(test)【隐藏】第3天隐藏控制出圈$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30090801"
        ],
        "dialogs": {
          "30090801": {
            "id": "30090801",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "…我没事，小姐，只是一点擦伤而已。",
            "nextDialogs": [
              "30090802"
            ]
          },
          "30090802": {
            "id": "30090802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "时间没算错，你们果然在这里。",
            "nextDialogs": [
              "30090803"
            ]
          },
          "30090803": {
            "id": "30090803",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "派蒙和旅行者，你们来得正好。听我说，刚才很危险…",
            "nextDialogs": [
              "30090806"
            ]
          },
          "30090806": {
            "id": "30090806",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "哦？原来你看到了啊，看到就早点出现啊，有人贴身保护小姐，我才更能放开手脚。那现在能帮我个忙吗？",
            "nextDialogs": [
              "30090807"
            ]
          },
          "30090807": {
            "id": "30090807",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你是想探查一下周围还有没有同伙，在这期间请旅行者带迪娜泽黛去休息对吧？",
            "nextDialogs": [
              "30090808"
            ]
          },
          "30090808": {
            "id": "30090808",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "…你怎么知道，我的确是这个意思。",
            "nextDialogs": [
              "30090809"
            ]
          },
          "30090809": {
            "id": "30090809",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这里还差一个一锤定音的发言…"
          }
        }
      }
    },

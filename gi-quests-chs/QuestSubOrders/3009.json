    {
      "subId": "300803",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080301"
        ],
        "dialogs": {
          "30080301": {
            "id": "30080301",
            "speakerId": 1006,
            "speakerName": "阿玛尔",
            "text": "我昨天才去的森林里摘这些货，绝对新鲜，放心吧。"
          }
        }
      }
    },
    {
      "subId": "300810",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30081001"
        ],
        "dialogs": {
          "30081001": {
            "id": "30081001",
            "speakerId": 1007,
            "speakerName": "齐米亚",
            "text": "这就是神明的智慧啊…"
          }
        }
      }
    },
    {
      "subId": "300811",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30081101"
        ],
        "dialogs": {
          "30081101": {
            "id": "30081101",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "哟吼，年轻的兵士，还有什么要求吗？"
          }
        }
      }
    },
    {
      "subId": "300903",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30090301"
        ],
        "dialogs": {
          "30090301": {
            "id": "30090301",
            "speakerId": 1010,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "30090302"
            ]
          },
          "30090302": {
            "id": "30090302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "30090303"
            ]
          },
          "30090303": {
            "id": "30090303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "快看！这不是…这不是迪娜泽黛吗！",
            "nextDialogs": [
              "30090306"
            ]
          },
          "30090306": {
            "id": "30090306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这是怎么回事，有两个迪娜泽黛吗？",
            "nextDialogs": [
              "30090307"
            ]
          },
          "30090307": {
            "id": "30090307",
            "speakerId": 1010,
            "speakerName": "？？？",
            "text": "你已经知道，这不是你第一次参加花神诞祭了吧？"
          }
        }
      }
    },
    {
      "subId": "300909",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30090901"
        ],
        "dialogs": {
          "30090901": {
            "id": "30090901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "纳西妲，我们带了位朋友过来，你在忙吗？",
            "nextDialogs": [
              "30090902"
            ]
          },
          "30090902": {
            "id": "30090902",
            "speakerId": 1002,
            "speakerName": "纳西妲",
            "text": "…我好像和你们说过，带人过来是没有意义的。",
            "nextDialogs": [
              "30090903"
            ]
          },
          "30090903": {
            "id": "30090903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不，我们只是想让她看看真正的迪娜泽黛的情况…",
            "nextDialogs": [
              "30090904"
            ]
          },
          "30090904": {
            "id": "30090904",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "真正的迪娜泽黛？…在哪儿？还有，你在和谁说话？",
            "nextDialogs": [
              "30090905"
            ]
          },
          "30090905": {
            "id": "30090905",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "30090906"
            ]
          },
          "30090906": {
            "id": "30090906",
            "speakerId": 1002,
            "speakerName": "纳西妲",
            "text": "唉…我说过你们是特殊的，其他人是看不到我和这位迪娜泽黛小姐的。",
            "nextDialogs": [
              "30090907"
            ]
          },
          "30090907": {
            "id": "30090907",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "等等…难道是那边…",
            "nextDialogs": [
              "30090908"
            ]
          },
          "30090908": {
            "id": "30090908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你…能看见？",
            "nextDialogs": [
              "30090909"
            ]
          },
          "30090909": {
            "id": "30090909",
            "speakerId": 1002,
            "speakerName": "纳西妲",
            "text": "居然拥有这样强大的感知力…难道长了看不见的触角吗？",
            "nextDialogs": [
              "30090910"
            ]
          },
          "30090910": {
            "id": "30090910",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "迪娜泽黛小姐，好像正躺在这里吧？她的情况怎么样？",
            "nextDialogs": [
              "30090911"
            ]
          },
          "30090911": {
            "id": "30090911",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "她现在病得很重，也已经基本失去意识了。你是怎么知道她在这儿的？",
            "nextDialogs": [
              "30090912"
            ]
          },
          "30090912": {
            "id": "30090912",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "我能感受到…她的气息…还有似乎是遗憾或者不甘心的心情，究竟发生了什么…",
            "nextDialogs": [
              "30090913"
            ]
          },
          "30090913": {
            "id": "30090913",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "现在你相信我们说的了吗？花神诞日的确在不断重演…",
            "nextDialogs": [
              "30090914"
            ]
          },
          "30090914": {
            "id": "30090914",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你和已经清楚状况的迪希雅开始了探讨…",
            "nextDialogs": [
              "30090915"
            ]
          },
          "30090915": {
            "id": "30090915",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…所以你怀疑，是贤者们所为？",
            "nextDialogs": [
              "30090916"
            ]
          },
          "30090916": {
            "id": "30090916",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "是啊，贤者一直和我们作对，谁知道他们会不会故意在这天用虚空来搞什么名堂。",
            "nextDialogs": [
              "30090917"
            ]
          },
          "30090917": {
            "id": "30090917",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这么说也是，这种大规模的奇怪事件，除了神明之外，在须弥也只有教令院的贤者才有这种能力了吧？",
            "nextDialogs": [
              "30090918"
            ]
          },
          "30090918": {
            "id": "30090918",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难道虚空装置里还藏有什么秘密？",
            "nextDialogs": [
              "30090919"
            ]
          },
          "30090919": {
            "id": "30090919",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "纳西妲，有什么关于虚空的情报吗？",
            "nextDialogs": [
              "30090920"
            ]
          },
          "30090920": {
            "id": "30090920",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是呀，你唤醒我们回忆的时候，用的是罐装知识样子的东西，那至少你应该对虚空有些了解吧？",
            "nextDialogs": [
              "30090921"
            ]
          },
          "30090921": {
            "id": "30090921",
            "speakerId": 1002,
            "speakerName": "纳西妲",
            "text": "虚空依靠神之心来运转，是智慧之神力量的具现。它统合全民的智慧，并将知识赐予人民。",
            "nextDialogs": [
              "30090922"
            ]
          },
          "30090922": {
            "id": "30090922",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "神之心！原来须弥的神之心是用来驱动虚空的呀…还有这种用法，也怪不得虚空那么神奇。",
            "nextDialogs": [
              "30090923"
            ]
          },
          "30090923": {
            "id": "30090923",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "那个…你们说的那位纳西妲…她说了什么？",
            "nextDialogs": [
              "30090924"
            ]
          },
          "30090924": {
            "id": "30090924",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "她说，「虚空依靠神之心来运转，是智慧之神力量的具现。它统合全民的智慧，并将知识赐予人民」。",
            "nextDialogs": [
              "30090925"
            ]
          },
          "30090925": {
            "id": "30090925",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "统合全民的智慧，并将知识赐予人民…等等…",
            "nextDialogs": [
              "30090926"
            ]
          },
          "30090926": {
            "id": "30090926",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么想法吗？",
            "nextDialogs": [
              "30090927"
            ]
          },
          "30090927": {
            "id": "30090927",
            "speakerId": 1000,
            "speakerName": "迪希雅",
            "text": "将知识赐予人民很好理解，人们一直在从虚空中获取知识…可是统合全民的智慧要怎么解释？",
            "nextDialogs": [
              "30090928"
            ]
          },
          "30090928": {
            "id": "30090928",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是不是指贤者们也会将知识录入虚空之中？",
            "nextDialogs": [
              "30090931"
            ]
          },
          "30090931": {
            "id": "30090931",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是哦，好像是这样说的。那你有什么想法吗？"
          }
        }
      }
    },
    {
      "subId": "300922",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30092201"
        ],
        "dialogs": {
          "30092201": {
            "id": "30092201",
            "speakerId": 1004,
            "speakerName": "迪娜泽黛",
            "text": "你们好像有什么事的样子，不用管我了，我在这里坐坐就好。"
          }
        }
      }
    },
    {
      "subId": "300923",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30092301"
        ],
        "dialogs": {
          "30092301": {
            "id": "30092301",
            "speakerId": 1002,
            "speakerName": "纳西妲",
            "text": "我们已经没有无数个花神诞祭可以浪费了，抓紧寻找真相吧。"
          }
        }
      }
    },
    {
      "subId": "300999",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30099901"
        ],
        "dialogs": {
          "30099901": {
            "id": "30099901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么了，你刚才看到什么了吗？",
            "nextDialogs": [
              "30099902"
            ]
          },
          "30099902": {
            "id": "30099902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们这样不和迪娜泽黛打个招呼就走了，是不是不太好呀？",
            "nextDialogs": [
              "30099903"
            ]
          },
          "30099903": {
            "id": "30099903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「月亮」、「虚幻」与「谎言」…意味着什么呢？",
            "nextDialogs": [
              "30099904"
            ]
          },
          "30099904": {
            "id": "30099904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "眼前正在发生的事似乎曾经经历过的一种感觉，最近愈发强烈。",
            "nextDialogs": [
              "30099905"
            ]
          },
          "30099905": {
            "id": "30099905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "大贤者说「你们就好好庆祝神明的诞生吧」，这句话有什么深意吗？",
            "nextDialogs": [
              "30099906"
            ]
          },
          "30099906": {
            "id": "30099906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "迪希雅为了帮忙筹钱，卖掉了自己的大剑，并且因为不适应新的大剑而受了伤。",
            "nextDialogs": [
              "30099907"
            ]
          },
          "30099907": {
            "id": "30099907",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有进行过多的思考，却感觉头脑异常的疲惫，到底是怎么回事？",
            "nextDialogs": [
              "30099908"
            ]
          },
          "30099908": {
            "id": "30099908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们已经连续度过了许多个花神诞日，花神诞日似乎在不断轮回。",
            "nextDialogs": [
              "30099909"
            ]
          },
          "30099909": {
            "id": "30099909",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "须弥人是不会做梦的，奇怪的现象。",
            "nextDialogs": [
              "30099910"
            ]
          },
          "30099910": {
            "id": "30099910",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「虚空依靠神之心来运转，是智慧之神力量的具现。它统合全民的智慧，并将知识赐予人民」，纳西妲如是说。",
            "nextDialogs": [
              "30099911"
            ]
          },
          "30099911": {
            "id": "30099911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "佣兵非常依赖身体记忆，这也让迪希雅在轮回中出现了没有受伤的情况。",
            "nextDialogs": [
              "30099912"
            ]
          },
          "30099912": {
            "id": "30099912",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「嘀——」的一声，是虚空进行操作的提示音，即便摘掉虚空终端也会在每天的夜晚听到。",
            "nextDialogs": [
              "30099913"
            ]
          },
          "30099913": {
            "id": "30099913",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "出城后我看到的无数景象奇异的空间，它们的共同点是都没有人的气息。",
            "nextDialogs": [
              "30099914"
            ]
          },
          "30099914": {
            "id": "30099914",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那些空间让我想到了梦境，似乎在道成林时做过这样的梦，只是其中都没有人的气息。",
            "nextDialogs": [
              "30099915"
            ]
          },
          "30099915": {
            "id": "30099915",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "空间在我眼前不断消失，虚空音效响起后，又会有许多空间重新诞生。",
            "nextDialogs": [
              "30099916"
            ]
          },
          "30099916": {
            "id": "30099916",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那些梦境在不断消失，虚空音效响起后，又会诞生许多新的空间。",
            "nextDialogs": [
              "30099917"
            ]
          },
          "30099917": {
            "id": "30099917",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道说那个空间就是现实？可现实空间就这么消失了，应该很不妙吧？",
            "nextDialogs": [
              "30099918"
            ]
          },
          "30099918": {
            "id": "30099918",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "印象里，每一个昨天，都是在虚空音效响起后才结束的…",
            "nextDialogs": [
              "30099919"
            ]
          },
          "30099919": {
            "id": "30099919",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是那种情况吧，时间的流动在同一天不断循环着。",
            "nextDialogs": [
              "30099920"
            ]
          },
          "30099920": {
            "id": "30099920",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "每过完一天，当天的记忆都会被删除的话，也会不自觉地一直过着同一天呢。",
            "nextDialogs": [
              "30099921"
            ]
          },
          "30099921": {
            "id": "30099921",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们都在梦里。须弥人并非不会做梦，只是梦境都被虚空夺走了。",
            "nextDialogs": [
              "30099922"
            ]
          },
          "30099922": {
            "id": "30099922",
            "speakerId": 1002,
            "speakerName": "纳西妲",
            "text": "虚空依靠神之心来运转。",
            "nextDialogs": [
              "30099923"
            ]
          },
          "30099923": {
            "id": "30099923",
            "speakerId": 1002,
            "speakerName": "纳西妲",
            "text": "是智慧之神力量的具现。",
            "nextDialogs": [
              "30099924"
            ]
          },
          "30099924": {
            "id": "30099924",
            "speakerId": 1002,
            "speakerName": "纳西妲",
            "text": "它统合全民的智慧。",
            "nextDialogs": [
              "30099925"
            ]
          },
          "30099925": {
            "id": "30099925",
            "speakerId": 1002,
            "speakerName": "纳西妲",
            "text": "并将知识赐予人民。",
            "nextDialogs": [
              "30099926"
            ]
          },
          "30099926": {
            "id": "30099926",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "炼金占卜据说是神明的启示，纳西妲又曾把自己比作「月亮」，看来…",
            "nextDialogs": [
              "30099927"
            ]
          },
          "30099927": {
            "id": "30099927",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "现在想来，「虚幻」是对我们在梦中这一现状的暗示吧？",
            "nextDialogs": [
              "30099928"
            ]
          },
          "30099928": {
            "id": "30099928",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "现在想来，指的应该是贤者对须弥人民的欺骗吧？",
            "nextDialogs": [
              "30099929"
            ]
          },
          "30099929": {
            "id": "30099929",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好像不对…还是要再好好考虑一下…",
            "nextDialogs": [
              "30099930"
            ]
          },
          "30099930": {
            "id": "30099930",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这之间…好像构不成什么有效的联想。"
          }
        }
      }
    }
  ]
}
      }
    },
    {
      "subId": "7711514",
      "subQuestName": "探索废弃隧道内的临时库房",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771151401"
        ],
        "dialogs": {
          "771151401": {
            "id": "771151401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#呜哇！{NICKNAME}，是个小女孩？！头上还长着树枝！是装饰吧，怎么可能有人头上会长树枝？",
            "nextDialogs": [
              "771151402"
            ]
          },
          "771151402": {
            "id": "771151402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还、还是活着的吗？「活体」说的就是她？",
            "nextDialogs": [
              "771151403"
            ]
          },
          "771151403": {
            "id": "771151403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「铁头老大」之前说的十分稀罕的宝贝…难道就是…",
            "nextDialogs": [
              "771151404"
            ]
          },
          "771151404": {
            "id": "771151404",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "呜呜…我没有宝贝，放过我吧…",
            "nextDialogs": [
              "771151405"
            ]
          },
          "771151405": {
            "id": "771151405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "吓我一跳！",
            "nextDialogs": [
              "771151406"
            ]
          },
          "771151406": {
            "id": "771151406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别紧张，派蒙，只是个小女孩。",
            "nextDialogs": [
              "771151407"
            ]
          },
          "771151407": {
            "id": "771151407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃啊，不好意思…你不要害怕，刚刚就是我们把你放出来的，肯定不会伤害你。",
            "nextDialogs": [
              "771151408"
            ]
          },
          "771151408": {
            "id": "771151408",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "呼…我还以为我又要被抓走了…那群兽怪，如果扎拉在的话，他们每个都要被打成呆瓜、笨蛋、傻子…",
            "nextDialogs": [
              "771151409"
            ]
          },
          "771151409": {
            "id": "771151409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那群兽怪？不会就是「铁头老大」他们吧…放心，刚刚我们已经好好收拾他们一顿了！不过，<color=#00E1FFFF>「扎拉」</color>是…",
            "nextDialogs": [
              "771151410"
            ]
          },
          "771151410": {
            "id": "771151410",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "扎拉是守护在镇子里的家人。啊，我住在奥古洛夫镇里，但我不知道我现在在哪里…",
            "nextDialogs": [
              "771151411"
            ]
          },
          "771151411": {
            "id": "771151411",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "…呜呜，这么久没回家，妈妈一定在「沙沙」、「沙沙」着哭泣。",
            "nextDialogs": [
              "771151412"
            ]
          },
          "771151412": {
            "id": "771151412",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，「眼镜」的身体很可能在那个叽里咕噜镇里面！",
            "nextDialogs": [
              "771151414",
              "771151417"
            ]
          },
          "771151414": {
            "id": "771151414",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸呀，我只是记不清那个镇子的名字嘛！这不是重点！",
            "nextDialogs": [
              "771151415"
            ]
          },
          "771151415": {
            "id": "771151415",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "重点是…反正这个小女孩也要回镇子，不如一起出发，这样还能有个镇子里的人带路呢！",
            "nextDialogs": [
              "771151419"
            ]
          },
          "771151419": {
            "id": "771151419",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#咳咳，这样吧，我叫派蒙，这位是{NICKNAME}，是了不起的冒险家，我们正好想要去镇子…呃，旅游一番！",
            "nextDialogs": [
              "771151420"
            ]
          },
          "771151420": {
            "id": "771151420",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就让我们顺便把你送回镇子吧！",
            "nextDialogs": [
              "771151421"
            ]
          },
          "771151421": {
            "id": "771151421",
            "speakerId": 1003,
            "speakerName": "娜斯佳",
            "text": "哇，两位大冒险家愿意送我回家，真是好人！我叫娜斯佳，现在我们已经是朋友了，很快就能变成家人了。",
            "nextDialogs": [
              "771151422"
            ]
          },
          "771151422": {
            "id": "771151422",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，成为家人也太快了吧。",
            "nextDialogs": [
              "771151423"
            ]
          },
          "771151423": {
            "id": "771151423",
            "speakerId": 1003,
            "speakerName": "娜斯佳",
            "text": "嘿嘿，是我心急了，要成为家人还要做很多事情呢…",
            "nextDialogs": [
              "771151424"
            ]
          },
          "771151424": {
            "id": "771151424",
            "speakerId": 1003,
            "speakerName": "娜斯佳",
            "text": "#{NICKNAME}{M#大哥哥}{F#大姐姐}和小小派蒙，我们还是先回到镇上吧，回到镇上，我就能给你们带路了。",
            "nextDialogs": [
              "771151425"
            ]
          },
          "771151425": {
            "id": "771151425",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "小小派蒙？明明娜斯佳也不大吧！这么叫有点奇奇怪怪的…不过至少不是什么难听的绰号。",
            "nextDialogs": [
              "771151426"
            ]
          },
          "771151426": {
            "id": "771151426",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总之，作为最好的向导，还是让我先看看大致方向…",
            "nextDialogs": [
              "771151427"
            ]
          },
          "771151427": {
            "id": "771151427",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "之前「铁头老大」说这是通向镇里的隧道，那我们还是先顺着轨道走吧！不过怎么这里还堵着…",
            "nextDialogs": [
              "771151428"
            ]
          },
          "771151428": {
            "id": "771151428",
            "speakerId": 1003,
            "speakerName": "娜斯佳",
            "text": "嗯？我有办法，不过要你们帮帮我。"
          },
          "771151417": {
            "id": "771151417",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是呀是呀，真的好巧呢！…啊，不是，谁在说这个啦，乱打岔！",
            "nextDialogs": [
              "771151418"
            ]
          },
          "771151418": {
            "id": "771151418",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我是说，反正这个小女孩也要回镇子，不如一起出发，这样还能有个镇子里的人带路呢！"
          }
        }
      }
    },

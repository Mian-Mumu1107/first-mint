  "subQuests": [
    {
      "subId": "7711503",
      "subQuestName": "前往奥古洛夫镇附近$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771150301"
        ],
        "dialogs": {
          "771150301": {
            "id": "771150301",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "喂！你俩什么来路？不会是来抢货的吧！",
            "nextDialogs": [
              "771150303",
              "771150305"
            ]
          },
          "771150303": {
            "id": "771150303",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "我可不记得我找的是两个小毛孩…你们是不是觉得「铁头老大」我很好骗？那就先尝尝我的厉害！"
          },
          "771150305": {
            "id": "771150305",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "哼，两个小家伙，还敢狡辩…先让「铁头老大」我教训教训你们！"
          }
        }
      }
    },
    {
      "subId": "7711505",
      "subQuestName": "击败帮派兽灵",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771150501"
        ],
        "dialogs": {
          "771150501": {
            "id": "771150501",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "喂！你俩什么来路？不会是来抢货的吧！",
            "nextDialogs": [
              "771150503",
              "771150505"
            ]
          },
          "771150503": {
            "id": "771150503",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "嗐！谁会在这种地方瞎逛？你们是不是觉得「铁头老大」我很好骗？那就先尝尝我的厉害！"
          },
          "771150505": {
            "id": "771150505",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "哼，两个小家伙，还敢狡辩…先让「铁头老大」我教训教训你们！"
          }
        }
      }
    },
    {
      "subId": "7711506",
      "subQuestName": "(test)与「铁头老大对话」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771150601"
        ],
        "dialogs": {
          "771150601": {
            "id": "771150601",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "饶命…饶命啊二位！是我有眼无珠了。",
            "nextDialogs": [
              "771150602"
            ]
          },
          "771150602": {
            "id": "771150602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#喂喂，做了坏事还想要我们饶命？{NICKNAME}，上！",
            "nextDialogs": [
              "771150603"
            ]
          },
          "771150603": {
            "id": "771150603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好嘞。",
            "nextDialogs": [
              "771150604"
            ]
          },
          "771150604": {
            "id": "771150604",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "等等！小的我可以交保命钱！",
            "nextDialogs": [
              "771150605"
            ]
          },
          "771150605": {
            "id": "771150605",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "您看到前面的隧道了吗？之前我们就从那进镇…现在那里是我们建的临时库房，装满了我们从奥古洛夫镇里搜罗出来的宝贝。",
            "nextDialogs": [
              "771150606"
            ]
          },
          "771150606": {
            "id": "771150606",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "当然——现在，这些宝贝全归您了。",
            "nextDialogs": [
              "771150607"
            ]
          },
          "771150607": {
            "id": "771150607",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "只是…",
            "nextDialogs": [
              "771150608"
            ]
          },
          "771150608": {
            "id": "771150608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "只是什么？你不会想要赖账吧！",
            "nextDialogs": [
              "771150609"
            ]
          },
          "771150609": {
            "id": "771150609",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "哎呦，我怎么敢…我是想说，隧道口塌了！现在我进不去，您也进不去。",
            "nextDialogs": [
              "771150610"
            ]
          },
          "771150610": {
            "id": "771150610",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "前段时间好不容易才找到个看起来傻傻的年轻人愿意来这帮忙，还照他给的方案准备好了炸药。",
            "nextDialogs": [
              "771150611"
            ]
          },
          "771150611": {
            "id": "771150611",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "但他拖了一天又一天，我和我的兄弟们都要冻成冰雕了…但等来的却是您。",
            "nextDialogs": [
              "771150612"
            ]
          },
          "771150612": {
            "id": "771150612",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "好在我还能去收我应得的100倍违约金，不然这趟就亏大了！",
            "nextDialogs": [
              "771150613"
            ]
          },
          "771150613": {
            "id": "771150613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "100倍是不是太夸张了。",
            "nextDialogs": [
              "771150614"
            ]
          },
          "771150614": {
            "id": "771150614",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错没错，简直和抢劫没区别！",
            "nextDialogs": [
              "771150615"
            ]
          },
          "771150615": {
            "id": "771150615",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "我们抢劫怎么了？",
            "nextDialogs": [
              "771150616"
            ]
          },
          "771150616": {
            "id": "771150616",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "您看小的我这张破嘴…我们也没办法，去奥古洛夫镇里寻宝一趟，风险可太高了。",
            "nextDialogs": [
              "771150617"
            ]
          },
          "771150617": {
            "id": "771150617",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "虽然没碰到那传说中的大火鸟，但也快把命搭上了，才带出来了…十分稀罕的宝贝。",
            "nextDialogs": [
              "771150618"
            ]
          },
          "771150618": {
            "id": "771150618",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "现在这些宝贝还不归我了，只能想点别的办法保保本了…",
            "nextDialogs": [
              "771150619"
            ]
          },
          "771150619": {
            "id": "771150619",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#但不管怎么样，抢劫也是不对的！要不是我们{NICKNAME}武力高强…",
            "nextDialogs": [
              "771150622"
            ]
          },
          "771150622": {
            "id": "771150622",
            "speakerId": 1000,
            "speakerName": "「铁头老大」",
            "text": "我再也不敢了…我发誓，现在起我就离这儿远远的，不碍着您的眼…"
          }
        }
      }
    },

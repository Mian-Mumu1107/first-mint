  },
  "subQuests": [
    {
      "subId": "7509101",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750910101"
        ],
        "dialogs": {
          "750910101": {
            "id": "750910101",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "一颗，两颗，嗯，三颗…",
            "nextDialogs": [
              "750910102"
            ]
          },
          "750910102": {
            "id": "750910102",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "哼，哼，一颗…两颗…",
            "nextDialogs": [
              "750910103"
            ]
          },
          "750910103": {
            "id": "750910103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，这里有个好奇怪的部族人。",
            "nextDialogs": [
              "750910104"
            ]
          },
          "750910104": {
            "id": "750910104",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "奇怪的应该是你们这些异邦人才对，呵，呵呵，这可不是异邦人应该来的地方啊…",
            "nextDialogs": [
              "750910105"
            ]
          },
          "750910105": {
            "id": "750910105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是什么禁地…或者圣地之类的吗？",
            "nextDialogs": [
              "750910106"
            ]
          },
          "750910106": {
            "id": "750910106",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "并不是，这只是我偶然发现的，宝藏之地。哼，来吧，两位，靠近点，你有没有听见，这块特殊的岩石…「宝藏岩」…",
            "nextDialogs": [
              "750910107"
            ]
          },
          "750910107": {
            "id": "750910107",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "其中传来的，犹如低鸣般起伏，就仿佛，啊，就仿佛有人在呼吸一般的声音。",
            "nextDialogs": [
              "750910109",
              "750910111"
            ]
          },
          "750910109": {
            "id": "750910109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "只是呼吸而已，算什么辛苦啦，不对…",
            "nextDialogs": [
              "750910112"
            ]
          },
          "750910112": {
            "id": "750910112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "石头，石头也会呼吸吗？",
            "nextDialogs": [
              "750910113"
            ]
          },
          "750910113": {
            "id": "750910113",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "不仅有呼吸，如果将耳朵贴上去，还能听到它在律动，听到这粗糙的表皮之下，岩石摩擦的声音…",
            "nextDialogs": [
              "750910114"
            ]
          },
          "750910114": {
            "id": "750910114",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "嘿，嘿，真是美妙的声响啊。",
            "nextDialogs": [
              "750910115"
            ]
          },
          "750910115": {
            "id": "750910115",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "而且，而且哦，只要将一些小的石头喂给它，甚至能够吐出更好，更漂亮的石头来…",
            "nextDialogs": [
              "750910116"
            ]
          },
          "750910116": {
            "id": "750910116",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "啊啊，很不可思议吧，你看，这些宝石，一颗，两颗…",
            "nextDialogs": [
              "750910117"
            ]
          },
          "750910117": {
            "id": "750910117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来刚才我们过来的时候，你在数这些宝石啊。",
            "nextDialogs": [
              "750910118"
            ]
          },
          "750910118": {
            "id": "750910118",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "对，而且，我能感受到，吃下不同石头的这块「宝藏岩」，变得更加强壮了…",
            "nextDialogs": [
              "750910119"
            ]
          },
          "750910119": {
            "id": "750910119",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "这一定是，了不起的奇迹，啊啊，「宝藏岩」…"
          },
          "750910111": {
            "id": "750910111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊，会呼吸有什么了不起…唔，没人在说这个！"
          }
        }
      }
    },
    {
      "subId": "7509102",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750910201"
        ],
        "dialogs": {
          "750910201": {
            "id": "750910201",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "嗯…要耐心一些，等到，等到安静的时候，我会将这些石头喂给「宝藏岩」…",
            "nextDialogs": [
              "750910202"
            ]
          },
          "750910202": {
            "id": "750910202",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "只要再过段时间，嘿，就会长出更好的石头的，嘿嘿，一颗…一颗，两颗…"
          }
        }
      }
    },
    {
      "subId": "7509103",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750910301"
        ],
        "dialogs": {
          "750910301": {
            "id": "750910301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，没想到上面真的长出来了…",
            "nextDialogs": [
              "750910302"
            ]
          },
          "750910302": {
            "id": "750910302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「宝藏岩」，好厉害…不对，不会是基斯庇你放在「宝藏岩」上的吧？",
            "nextDialogs": [
              "750910303"
            ]
          },
          "750910303": {
            "id": "750910303",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "…呵，呵呵，我怎么会做如此愚蠢之事。",
            "nextDialogs": [
              "750910304"
            ]
          },
          "750910304": {
            "id": "750910304",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "多亏了你们给的石头，「宝藏岩」也变得更具活力，啊，你们听不见吗…",
            "nextDialogs": [
              "750910305"
            ]
          },
          "750910305": {
            "id": "750910305",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "那仿佛地中流焰鼓动的声响，就像是…啊，就像是脉搏一般…",
            "nextDialogs": [
              "750910306"
            ]
          },
          "750910306": {
            "id": "750910306",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "果然，让它吃点别的石头…是对的…",
            "nextDialogs": [
              "750910307"
            ]
          },
          "750910307": {
            "id": "750910307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，什么都听不到啦…",
            "nextDialogs": [
              "750910308"
            ]
          },
          "750910308": {
            "id": "750910308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}你能听到吗？",
            "nextDialogs": [
              "750910310",
              "750910312"
            ]
          },
          "750910310": {
            "id": "750910310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦…",
            "nextDialogs": [
              "750910313"
            ]
          },
          "750910313": {
            "id": "750910313",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "哼哼，异邦的…啊，两位了不起的异邦的客人…",
            "nextDialogs": [
              "750910314"
            ]
          },
          "750910314": {
            "id": "750910314",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "如果可以的话，再给我一些石头吧，更好的，更漂亮的石头…相信，「宝藏岩」的力量不会让你们失望的…",
            "nextDialogs": [
              "750910315"
            ]
          },
          "750910315": {
            "id": "750910315",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "我能感受到，我能感受到，这样一定对它也是有好处的…",
            "nextDialogs": [
              "750910316"
            ]
          },
          "750910316": {
            "id": "750910316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总有种逐渐深入陷阱了的感觉…",
            "nextDialogs": [
              "750910317"
            ]
          },
          "750910317": {
            "id": "750910317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你觉得呢…",
            "nextDialogs": [
              "750910318"
            ]
          },
          "750910318": {
            "id": "750910318",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能拿到更好的石头的话…",
            "nextDialogs": [
              "750910319"
            ]
          },
          "750910319": {
            "id": "750910319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实有继续试试的价值呢…",
            "nextDialogs": [
              "750910320"
            ]
          },
          "750910320": {
            "id": "750910320",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "嘿嘿，那就，挑些比以前更好的石头交给我吧…啊，更好的石头，这样，「宝藏岩」的力量，也一定会有所增长…"
          },
          "750910312": {
            "id": "750910312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "才不会呢！你又在吓我！"
          }
        }
      }
    },
    {
      "subId": "7509104",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750910401"
        ],
        "dialogs": {
          "750910401": {
            "id": "750910401",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "嗯…要耐心一些，等到，等到安静的时候，我会将这些石头喂给「宝藏岩」…嘿嘿，谢谢你们带来的石头…",
            "nextDialogs": [
              "750910402"
            ]
          },
          "750910402": {
            "id": "750910402",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "一定要长出更好的石头啊，「宝藏岩」，嘿嘿，一颗…一颗，两颗…"
          }
        }
      }
    },
    {
      "subId": "7509105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750910501"
        ],
        "dialogs": {
          "750910501": {
            "id": "750910501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，确实长出了更好的石头，虽然已经是第二次看到了，但感觉还是很神奇…",
            "nextDialogs": [
              "750910502"
            ]
          },
          "750910502": {
            "id": "750910502",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "呵，呵呵，多疑的外邦人。",
            "nextDialogs": [
              "750910503"
            ]
          },
          "750910503": {
            "id": "750910503",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "这下你们终于能够明白…「宝藏岩」的伟大之处了吧。",
            "nextDialogs": [
              "750910504"
            ]
          },
          "750910504": {
            "id": "750910504",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "啊啊，「宝藏岩」，得益于你们拿来的石头，「宝藏岩」的力量也变得更加深厚了…",
            "nextDialogs": [
              "750910505"
            ]
          },
          "750910505": {
            "id": "750910505",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "真不知道它最后会变成什么样…",
            "nextDialogs": [
              "750910506"
            ]
          },
          "750910506": {
            "id": "750910506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，这么一说，就连我都有些好奇了。",
            "nextDialogs": [
              "750910507"
            ]
          },
          "750910507": {
            "id": "750910507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "到底是为什么，只要吃进去石头，就能吐出一些更好的？不如…我们把它打开来看看？",
            "nextDialogs": [
              "750910508"
            ]
          },
          "750910508": {
            "id": "750910508",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "你、你在说什么，决不允许这样做！",
            "nextDialogs": [
              "750910509"
            ]
          },
          "750910509": {
            "id": "750910509",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "要是…要是你们想要把「宝藏岩」打开的话，首先就要从我的尸体上踏过…",
            "nextDialogs": [
              "750910510"
            ]
          },
          "750910510": {
            "id": "750910510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，我只是随口一说啦。",
            "nextDialogs": [
              "750910511"
            ]
          },
          "750910511": {
            "id": "750910511",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "哼，看在你们之前为「宝藏岩」拿来石头的份上…这次就饶过你的冒犯…",
            "nextDialogs": [
              "750910512"
            ]
          },
          "750910512": {
            "id": "750910512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好、好吧…",
            "nextDialogs": [
              "750910513"
            ]
          },
          "750910513": {
            "id": "750910513",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "我已经，哼哼，我已经感受到了，只要再给「宝藏岩」吃下更高级的石头，它一定能够产生了不起的变化…",
            "nextDialogs": [
              "750910514"
            ]
          },
          "750910514": {
            "id": "750910514",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "异邦的旅人啊，我曾听外来的行商说，在沙漠之中有一种特殊的辉石，蕴藏了不起的力量…",
            "nextDialogs": [
              "750910515"
            ]
          },
          "750910515": {
            "id": "750910515",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "它的名字，是…对，它的名字是「万相石」。如果、如果能够将那种石头带来，喂给「宝藏岩」的话…",
            "nextDialogs": [
              "750910516"
            ]
          },
          "750910516": {
            "id": "750910516",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "一定，一定就可以…",
            "nextDialogs": [
              "750910517"
            ]
          },
          "750910517": {
            "id": "750910517",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔，{NICKNAME}，你觉得呢…",
            "nextDialogs": [
              "750910518"
            ]
          },
          "750910518": {
            "id": "750910518",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就试试吧！",
            "nextDialogs": [
              "750910519"
            ]
          },
          "750910519": {
            "id": "750910519",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实，很好奇会发生什么呢…",
            "nextDialogs": [
              "750910520"
            ]
          },
          "750910520": {
            "id": "750910520",
            "speakerId": 21633,
            "speakerName": "基斯庇",
            "text": "如、如果有「万相石」的话…给我，只需要给我一枚就好…"
          }
        }
      }
    },
    {
      "subId": "7509106",

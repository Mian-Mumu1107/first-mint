  "subQuests": [
    {
      "subId": "7352701",
      "subQuestName": "与工程师对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735270101"
        ],
        "dialogs": {
          "735270101": {
            "id": "735270101",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "没想到啊，被警告后，你们两位不是直接离开，而是顺着广播的声音找过来了吗？",
            "nextDialogs": [
              "735270102"
            ]
          },
          "735270102": {
            "id": "735270102",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "不好意思，这个游乐项目还没正式启动，要麻烦你们再等一会儿了，几分钟就好，我正在做最后的调试…",
            "nextDialogs": [
              "735270105"
            ]
          },
          "735270105": {
            "id": "735270105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们听见了很危险的词——水炮！应该就是那边的大东西…",
            "nextDialogs": [
              "735270106"
            ]
          },
          "735270106": {
            "id": "735270106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！单看外形就很吓人！",
            "nextDialogs": [
              "735270107"
            ]
          },
          "735270107": {
            "id": "735270107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你想在这里搞什么名堂？我们不能坐视不理！",
            "nextDialogs": [
              "735270108"
            ]
          },
          "735270108": {
            "id": "735270108",
            "speakerId": 1002,
            "speakerName": "沙蒂永",
            "text": "不不不，两位误会了！",
            "nextDialogs": [
              "735270109"
            ]
          },
          "735270109": {
            "id": "735270109",
            "speakerId": 1002,
            "speakerName": "沙蒂永",
            "text": "我是游乐项目「飞迸湍流大作战」的负责人沙蒂永，这个项目只是个以海上大战为背景的，轻松愉快的游戏。",
            "nextDialogs": [
              "735270110"
            ]
          },
          "735270110": {
            "id": "735270110",
            "speakerId": 1002,
            "speakerName": "沙蒂永",
            "text": "「飞迸湍流大作战」得到了伊迪娅女士的批准，安全性你们大可放心！",
            "nextDialogs": [
              "735270111"
            ]
          },
          "735270111": {
            "id": "735270111",
            "speakerId": 1002,
            "speakerName": "沙蒂永",
            "text": "要是不信我，可以看看伊迪娅女士签字的文件！",
            "nextDialogs": [
              "735270112"
            ]
          },
          "735270112": {
            "id": "735270112",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "可疑的工程师沙蒂永找来了相关证明，均为用词相当严谨正式的文书，每一份都可见伊迪娅字迹灵动的签名。\\n旁边还附上了几句祝福，单论字迹和语言风格，的确是伊迪娅本人没错…",
            "nextDialogs": [
              "735270113"
            ]
          },
          "735270113": {
            "id": "735270113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来是伊迪娅允许的游乐项目啊…吓我们一大跳…",
            "nextDialogs": [
              "735270114"
            ]
          },
          "735270114": {
            "id": "735270114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那你提到过的水炮，是怎么回事？",
            "nextDialogs": [
              "735270115"
            ]
          },
          "735270115": {
            "id": "735270115",
            "speakerId": 1002,
            "speakerName": "沙蒂永",
            "text": "只是一个简单的比方而已，游乐装置的全名实在太长了，一般人肯定会根据外形，直接叫它们水炮。",
            "nextDialogs": [
              "735270116"
            ]
          },
          "735270116": {
            "id": "735270116",
            "speakerId": 1002,
            "speakerName": "沙蒂永",
            "text": "不过，这种装置发射的水球是无害的，只不过打中靶标后，飞溅的水可能把附近游客全身弄湿。",
            "nextDialogs": [
              "735270117"
            ]
          },
          "735270117": {
            "id": "735270117",
            "speakerId": 1002,
            "speakerName": "沙蒂永",
            "text": "有的人喜欢被水打湿后冰凉凉的感觉，有的人却很讨厌湿漉漉的衣服贴在身上，不能让后者心情不好。",
            "nextDialogs": [
              "735270118"
            ]
          },
          "735270118": {
            "id": "735270118",
            "speakerId": 1002,
            "speakerName": "沙蒂永",
            "text": "如果有余力，我还想在附近布置一些警告牌呢！",
            "nextDialogs": [
              "735270119"
            ]
          },
          "735270119": {
            "id": "735270119",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没想到你还挺贴心的嘛，说得很有道理！"
          }
        }
      }
    },
    {
      "subId": "7352799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735279901"
        ],
        "dialogs": {
          "735279901": {
            "id": "735279901",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "下方游客请注意，下方游客请注意！你们进入了水炮的射界，正处于弹着区内，还请速速离开！",
            "nextDialogs": [
              "735279902"
            ]
          },
          "735279902": {
            "id": "735279902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个广播的声音…是在警告我们吗？他提到了什么…水炮？听起来很不妙！",
            "nextDialogs": [
              "735279903"
            ]
          },
          "735279903": {
            "id": "735279903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "声音是从那边传来的，我们去看看到底是怎么回事吧！"
          }
        }
      }
    }
  ]
}
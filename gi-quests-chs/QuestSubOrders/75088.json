        ],
        "dialogs": {
          "750880301": {
            "id": "750880301",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "嗯，如果有足够多的样本的话，说不定…",
            "nextDialogs": [
              "750880302"
            ]
          },
          "750880302": {
            "id": "750880302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦，这里有个奇怪的家伙在嘀嘀咕咕的…",
            "nextDialogs": [
              "750880303"
            ]
          },
          "750880303": {
            "id": "750880303",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "像我这样的人在纳塔到处都是，奇怪的反而是你们哦…如果没什么事就不要打扰我做研究啦。",
            "nextDialogs": [
              "750880304"
            ]
          },
          "750880304": {
            "id": "750880304",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "我这个月的支出超出了预计的额度，只能靠解决协会里悬赏的研究问题来补贴一番。",
            "nextDialogs": [
              "750880305"
            ]
          },
          "750880305": {
            "id": "750880305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来做研究还有钱拿呀…",
            "nextDialogs": [
              "750880306"
            ]
          },
          "750880306": {
            "id": "750880306",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "是呀，「龙遗物研究协会」就是这样的组织，有奖赏，才能促进大伙研究各种课题嘛。",
            "nextDialogs": [
              "750880307"
            ]
          },
          "750880307": {
            "id": "750880307",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "这次我就要挑战「镌光铭印」的破译…据说这是没有人完成的伟业，能得到的摩拉也有很多…",
            "nextDialogs": [
              "750880308"
            ]
          },
          "750880308": {
            "id": "750880308",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "不过…",
            "nextDialogs": [
              "750880309"
            ]
          },
          "750880309": {
            "id": "750880309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过什么呀？",
            "nextDialogs": [
              "750880310"
            ]
          },
          "750880310": {
            "id": "750880310",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "如果要破译「镌光铭印」，首先就得有足够多的「镌光铭印」碎片才行。",
            "nextDialogs": [
              "750880311"
            ]
          },
          "750880311": {
            "id": "750880311",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "…嗯，这样吧，如果你们能够找来「镌光铭印」的碎片的话，我就给你们报酬，如何？",
            "nextDialogs": [
              "750880312"
            ]
          },
          "750880312": {
            "id": "750880312",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "看上去你们是经验丰富的冒险家嘛，应该经常接到这样的委托吧。",
            "nextDialogs": [
              "750880313"
            ]
          },
          "750880313": {
            "id": "750880313",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "倒也不是不行啦，不过你这个月的支出不是已经超额了嘛…",
            "nextDialogs": [
              "750880314"
            ]
          },
          "750880314": {
            "id": "750880314",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "既然已经超额了，多超少超根本不是问题…只要拿到「镌光铭印」的碎片，破译其中的内容，多少摩拉都能有！",
            "nextDialogs": [
              "750880317"
            ]
          },
          "750880317": {
            "id": "750880317",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "你们只要保证能够拿到「真货」就好，说起来就来气，这个月有贩子卖给我的秘源遗迹物件根本就是伪造的。",
            "nextDialogs": [
              "750880318"
            ]
          },
          "750880318": {
            "id": "750880318",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "坑了我好大一笔摩拉…",
            "nextDialogs": [
              "750880319"
            ]
          },
          "750880319": {
            "id": "750880319",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，原来是因为这样才超支的…",
            "nextDialogs": [
              "750880320"
            ]
          },
          "750880320": {
            "id": "750880320",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "所以，就要用「镌光铭印」的碎片打个翻身仗！",
            "nextDialogs": [
              "750880321"
            ]
          },
          "750880321": {
            "id": "750880321",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "拜托了，寻找碎片就拜托给你们了！如果找到了请一定要带到我这儿来！",
            "nextDialogs": [
              "750880322"
            ]
          },
          "750880322": {
            "id": "750880322",
            "speakerId": 1000,
            "speakerName": "秋纽奥",
            "text": "呃，倒也不用太多，就…三，不，四个吧！多的我就实在付不起酬劳了。"
          }
        }
      }

    {
      "subId": "2300422",
      "subQuestName": "获得彩蛋2道具$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230042201"
        ],
        "dialogs": {
          "230042201": {
            "id": "230042201",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "咦？这些帽子…哈哈哈，是我之前给小蛇们做的帽子啊。我怎么把它们也落下了。",
            "nextDialogs": [
              "230042202"
            ]
          },
          "230042202": {
            "id": "230042202",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "之前为了让一些孩子们来看，我就给它们每条蛇都做了一顶睡帽。",
            "nextDialogs": [
              "230042203"
            ]
          },
          "230042203": {
            "id": "230042203",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "阿耶的是红色的，阿梦的是绿色的，小加的是黄色的，阿德的是蓝色的…",
            "nextDialogs": [
              "230042204"
            ]
          },
          "230042204": {
            "id": "230042204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听上去就很可爱，演出效果一定不错！",
            "nextDialogs": [
              "230042205"
            ]
          },
          "230042205": {
            "id": "230042205",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "最开始是不错，但只要小蛇们张开嘴，孩子们肯定会哇哇大哭…",
            "nextDialogs": [
              "230042206"
            ]
          },
          "230042206": {
            "id": "230042206",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "唉，不说这些了，请收下这些报酬吧，也算是我的一点心意。"
          }
        }
      }
    },

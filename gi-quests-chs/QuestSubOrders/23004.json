    {
      "subId": "2300428",
      "subQuestName": "回报古拉布吉尔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230042401"
        ],
        "dialogs": {
          "230042401": {
            "id": "230042401",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "啊！这不是我之前做的蛇爬架吗？真怀念啊，哈哈哈！",
            "nextDialogs": [
              "230042402"
            ]
          },
          "230042402": {
            "id": "230042402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "蛇爬架是什么啦？",
            "nextDialogs": [
              "230042403"
            ]
          },
          "230042403": {
            "id": "230042403",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "就是给小蛇们爬来爬去解闷的玩具呀，总不能让它们时时刻刻都挂在我身上吧。",
            "nextDialogs": [
              "230042404"
            ]
          },
          "230042404": {
            "id": "230042404",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "谢谢你们帮我把它带回来，这些报酬请收下吧。",
            "nextDialogs": [
              "230042405"
            ]
          },
          "230042405": {
            "id": "230042405",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "我之前是这么设计的吗？真怀念啊…"
          }
        }
      }
    },

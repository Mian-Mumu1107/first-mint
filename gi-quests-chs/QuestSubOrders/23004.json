            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "怎么了？还有什么事吗？",
            "nextDialogs": [
              "230041902"
            ]
          },
          "230041902": {
            "id": "230041902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我还找到了点别的。"
          }
        }
      }
    },
    {
      "subId": "2300420",
      "subQuestName": "回报古拉布吉尔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230042001"
        ],
        "dialogs": {
          "230042001": {
            "id": "230042001",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "咦？这颗珠子…怎么回事…你们是在哪里找到的？",
            "nextDialogs": [
              "230042002"
            ]
          },
          "230042002": {
            "id": "230042002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "在营地的罐子找到的哦，是你落下的吗？",
            "nextDialogs": [
              "230042003"
            ]
          },
          "230042003": {
            "id": "230042003",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "这是我之前用来表演的道具啦，我吹笛子的时候，小家伙们会把这颗珠子顶在头上，然后抬起上半身舞蹈。",
            "nextDialogs": [
              "230042004"
            ]
          },
          "230042004": {
            "id": "230042004",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "不过，这种把戏很早之前就赚不到多少钱，我也很久没有表演过了。根本没注意这珠子不见了…",
            "nextDialogs": [
              "230042005"
            ]
          },
          "230042005": {
            "id": "230042005",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "无论如何，还是谢谢你们帮我把这珠子拿回来，这些报酬是给你们的，请收下吧。"
          }
        }
      }
    },
    {
      "subId": "2300421",
      "subQuestName": "彩蛋2 爬架开车提示$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

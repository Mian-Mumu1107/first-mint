    {
      "subId": "2300411",
      "subQuestName": "前往营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230041101"
        ],
        "dialogs": {
          "230041101": {
            "id": "230041101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "宠物蛇也有专用口粮吗？它们一般不是会吃老鼠之类的…",
            "nextDialogs": [
              "230041102"
            ]
          },
          "230041102": {
            "id": "230041102",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "最开始它们也是会自己觅食的。",
            "nextDialogs": [
              "230041103"
            ]
          },
          "230041103": {
            "id": "230041103",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "但自从它们进食的时候吓到了几个孩子之后，我就不敢让它们自己出去了，都是自己调制口粮给它们吃。",
            "nextDialogs": [
              "230041104"
            ]
          },
          "230041104": {
            "id": "230041104",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "唉…不过，自从我开始给它们调制口粮之后，它们就开始懒得动弹，也基本上不吃其他食物了。",
            "nextDialogs": [
              "230041105"
            ]
          },
          "230041105": {
            "id": "230041105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸…不劳而获的食物啊…",
            "nextDialogs": [
              "230041108"
            ]
          },
          "230041108": {
            "id": "230041108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我还没问味道呢，别这么一脸向往的表情，你不会有这种机会的啦！",
            "nextDialogs": [
              "230041109"
            ]
          },
          "230041109": {
            "id": "230041109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那种机会是派蒙的！",
            "nextDialogs": [
              "230041110"
            ]
          },
          "230041110": {
            "id": "230041110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说得真是理直气壮…",
            "nextDialogs": [
              "230041111"
            ]
          },
          "230041111": {
            "id": "230041111",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "我肯定是之前出去采草药的时候，把口粮落在哪处营地里了。",
            "nextDialogs": [
              "230041112"
            ]
          },
          "230041112": {
            "id": "230041112",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "可是我也不方便自己去找，得留在这里看着这群小家伙，防止它们饿极了溜出去吓到别人…",
            "nextDialogs": [
              "230041113"
            ]
          },
          "230041113": {
            "id": "230041113",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "旅行者，你能帮我跑一趟，从营地里把口粮带回来吗？"
          }
        }
      }
    },

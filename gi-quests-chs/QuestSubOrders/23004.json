    {
      "subId": "2300406",
      "subQuestName": "寻找古拉布吉尔的蛇口粮",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230040601"
        ],
        "dialogs": {
          "230040601": {
            "id": "230040601",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "没错！就是这些！太谢谢你们了。",
            "nextDialogs": [
              "230040602"
            ]
          },
          "230040602": {
            "id": "230040602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这些东西怎么不在营地里，在旁边的大树上啊？",
            "nextDialogs": [
              "230040603"
            ]
          },
          "230040603": {
            "id": "230040603",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "唔…也许是被小鸟叼上去做储备粮了吧…",
            "nextDialogs": [
              "230040604"
            ]
          },
          "230040604": {
            "id": "230040604",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "这种口粮真这么受小动物喜欢吗？我要不要拿出去卖…",
            "nextDialogs": [
              "230040605"
            ]
          },
          "230040605": {
            "id": "230040605",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "咳！先不说这些了，这些报酬还请收下吧，多谢你们帮忙了。"
          }
        }
      }
    },
    {
      "subId": "2300407",
      "subQuestName": "前往营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230040701"
        ],
        "dialogs": {
          "230040701": {
            "id": "230040701",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "没错！就是这些！果然丢在了营地里啊。",
            "nextDialogs": [
              "230040702"
            ]
          },
          "230040702": {
            "id": "230040702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是被石头压住了啦，营地在的位置好像塌方了，东西滚了好远，我们找了好一会呢。",
            "nextDialogs": [
              "230040703"
            ]
          },
          "230040703": {
            "id": "230040703",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "是这样吗？那个地方怎么会突然塌方呢？之前一直挺安全的…",
            "nextDialogs": [
              "230040704"
            ]
          },
          "230040704": {
            "id": "230040704",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "对了！我之前在那边露营的时候，夜里总能听见一些奇怪的叫声，帐篷也总是会被什么东西磨蹭…",
            "nextDialogs": [
              "230040705"
            ]
          },
          "230040705": {
            "id": "230040705",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "小蛇们很警惕，每次都会把我弄醒。但我每次出去查看的时候，却什么也看不见…",
            "nextDialogs": [
              "230040706"
            ]
          },
          "230040706": {
            "id": "230040706",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "算了，不说这些闲话了，总之这次多谢你们了，这些报酬还请收下吧。"
          }
        }
      }
    },
    {
      "subId": "2300408",
      "subQuestName": "寻找古拉布吉尔的蛇口粮",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230040801"
        ],
        "dialogs": {
          "230040801": {
            "id": "230040801",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "没错！就是这些！果然丢在了营地里啊。",
            "nextDialogs": [
              "230040802"
            ]
          },
          "230040802": {
            "id": "230040802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于营地的情况…",
            "nextDialogs": [
              "230040803"
            ]
          },
          "230040803": {
            "id": "230040803",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "是这样吗？难道是有野兽闯进去了吗…",
            "nextDialogs": [
              "230040804"
            ]
          },
          "230040804": {
            "id": "230040804",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "这么一说…之前我做的口粮吸引过蕈兽，吸引过小鸟…现在吸引一些野兽过来倒也正常…",
            "nextDialogs": [
              "230040805"
            ]
          },
          "230040805": {
            "id": "230040805",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "唔…看来我真要考虑一下把这种口粮拿去出售的计划了。",
            "nextDialogs": [
              "230040806"
            ]
          },
          "230040806": {
            "id": "230040806",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "如果这生意真能成的话，应该能比我现在的表演赚钱多了吧…",
            "nextDialogs": [
              "230040807"
            ]
          },
          "230040807": {
            "id": "230040807",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "啊，我扯远了，哈哈，这次多谢你们了，这些报酬还请收下吧。"
          }
        }
      }
    },
    {
      "subId": "2300409",
      "subQuestName": "前往营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230040901"
        ],
        "dialogs": {
          "230040901": {
            "id": "230040901",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "没错！就是这些！果然丢在了营地里啊。",
            "nextDialogs": [
              "230040902"
            ]
          },
          "230040902": {
            "id": "230040902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那个营地为什么会在一堆藤蔓中间啊！你睡觉的时候不怕被刺伤吗？",
            "nextDialogs": [
              "230040903"
            ]
          },
          "230040903": {
            "id": "230040903",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "不会的，我之前野外宿营的功夫还不错。",
            "nextDialogs": [
              "230040904"
            ]
          },
          "230040904": {
            "id": "230040904",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "而且我之前搭建那个营地的时候，周围还没有那么多藤蔓呢。",
            "nextDialogs": [
              "230040905"
            ]
          },
          "230040905": {
            "id": "230040905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你离开林子很久了吗？",
            "nextDialogs": [
              "230040906"
            ]
          },
          "230040906": {
            "id": "230040906",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "算是有段时间了吧，具体有多久…我也记不清了。",
            "nextDialogs": [
              "230040907"
            ]
          },
          "230040907": {
            "id": "230040907",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "哈哈哈，现在我搭营地的手艺都已经很生疏了。",
            "nextDialogs": [
              "230040908"
            ]
          },
          "230040908": {
            "id": "230040908",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "之前我布置好的那些营地，现在大部分也都荒废了。",
            "nextDialogs": [
              "230040909"
            ]
          },
          "230040909": {
            "id": "230040909",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "如果我现在还待在雨林里，又会过着什么样的生活呢…",
            "nextDialogs": [
              "230040910"
            ]
          },
          "230040910": {
            "id": "230040910",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "…抱歉，我说太多了，这些报酬给你，请收下吧。"
          }
        }
      }
    },
    {
      "subId": "2300410",

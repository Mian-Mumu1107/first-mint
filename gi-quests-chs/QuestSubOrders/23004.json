  "subQuests": [
    {
      "subId": "2300401",
      "subQuestName": "与古拉布吉尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230040101"
        ],
        "dialogs": {
          "230040101": {
            "id": "230040101",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "怎么又不见了…哎…旅行者！能不能请你帮个忙？",
            "nextDialogs": [
              "230040102"
            ]
          },
          "230040102": {
            "id": "230040102",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "我的口粮不见了！",
            "nextDialogs": [
              "230040103"
            ]
          },
          "230040103": {
            "id": "230040103",
            "speakerId": 1000,
            "speakerName": "古拉布吉尔",
            "text": "不对，不对！是我的宠物蛇口粮，全部不见了！"
          }
        }
      }
    },
    {
      "subId": "2300402",

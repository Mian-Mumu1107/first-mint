            "speakerName": "Player",
            "text": "满足沙拉。",
            "nextDialogs": [
              "210270402"
            ]
          },
          "210270402": {
            "id": "210270402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这道菜确实很简单呢，味道也很不错。"

    {
      "subId": "1110314",
      "subQuestName": "与守庙人谈话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111030101"
        ],
        "dialogs": {
          "111030101": {
            "id": "111030101",
            "speakerId": 10201,
            "speakerName": "铜雀",
            "text": "青山碧水魂飘飘，浮生得闲把扇摇…",
            "nextDialogs": [
              "111030102"
            ]
          },
          "111030102": {
            "id": "111030102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不好意思，打扰你的雅兴了…",
            "nextDialogs": [
              "111030103"
            ]
          },
          "111030103": {
            "id": "111030103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们想借一下这里的香炉和灯。",
            "nextDialogs": [
              "111030104"
            ]
          },
          "111030104": {
            "id": "111030104",
            "speakerId": 10201,
            "speakerName": "铜雀",
            "text": "…这还真是天底下最稀罕的事了。",
            "nextDialogs": [
              "111030105"
            ]
          },
          "111030105": {
            "id": "111030105",
            "speakerId": 10201,
            "speakerName": "铜雀",
            "text": "来到庙里不求仙，不拜神，反倒要把香炉都搬走，哈哈哈…",
            "nextDialogs": [
              "111030106"
            ]
          },
          "111030106": {
            "id": "111030106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们也知道是很无礼的要求，但真的只借一会儿…",
            "nextDialogs": [
              "111030107"
            ]
          },
          "111030107": {
            "id": "111030107",
            "speakerId": 10201,
            "speakerName": "铜雀",
            "text": "是「梦游诸境法」的仪式所用吧？",
            "nextDialogs": [
              "111030108"
            ]
          },
          "111030108": {
            "id": "111030108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…你怎么会知道！",
            "nextDialogs": [
              "111030109"
            ]
          },
          "111030109": {
            "id": "111030109",
            "speakerId": 10201,
            "speakerName": "铜雀",
            "text": "我在此庙的时间，绝对远比你们想象得长。",
            "nextDialogs": [
              "111030110"
            ]
          },
          "111030110": {
            "id": "111030110",
            "speakerId": 10201,
            "speakerName": "铜雀",
            "text": "可能是心诚所致吧？「仙法」也有幸悟得一二。",
            "nextDialogs": [
              "111030111"
            ]
          },
          "111030111": {
            "id": "111030111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有这种事…",
            "nextDialogs": [
              "111030112"
            ]
          },
          "111030112": {
            "id": "111030112",
            "speakerId": 10201,
            "speakerName": "铜雀",
            "text": "罢了罢了，你们拿去吧。今天能有机会成人之美，也算一件幸事。",
            "nextDialogs": [
              "111030113"
            ]
          },
          "111030113": {
            "id": "111030113",
            "speakerId": 10201,
            "speakerName": "铜雀",
            "text": "…再留在此地，本身也没什么意义了。",
            "nextDialogs": [
              "111030115",
              "111030117"
            ]
          },
          "111030115": {
            "id": "111030115",
            "speakerId": 10201,
            "speakerName": "铜雀",
            "text": "不必在意我，想要什么就快去取吧。"
          },
          "111030117": {
            "id": "111030117",
            "speakerId": 10201,
            "speakerName": "铜雀",
            "text": "没关系，想要什么就快去取吧。"
          }
        }
      }
    },

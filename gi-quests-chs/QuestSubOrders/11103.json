    {
      "subId": "1110309",
      "subQuestName": "(test)战斗后对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111030901"
        ],
        "dialogs": {
          "111030901": {
            "id": "111030901",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "快停下…我、我认输！哎哟…",
            "nextDialogs": [
              "111030903",
              "111030905"
            ]
          },
          "111030903": {
            "id": "111030903",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "相信，相信！都要被你们打得魂飞魄散了…",
            "nextDialogs": [
              "111030906"
            ]
          },
          "111030906": {
            "id": "111030906",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "我这是何等的晦气，居然撞上你们这块铁板。",
            "nextDialogs": [
              "111030907"
            ]
          },
          "111030907": {
            "id": "111030907",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "还请两位大仙饶过我，一定不会有下次了…",
            "nextDialogs": [
              "111030908"
            ]
          },
          "111030908": {
            "id": "111030908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们不是仙人，虽然魂魄是我们招来的，但真正的仙人是这一位。",
            "nextDialogs": [
              "111030909"
            ]
          },
          "111030909": {
            "id": "111030909",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "你终日招摇撞骗，冒顶仙名，驱邪而不除，置众生安危于不顾。",
            "nextDialogs": [
              "111030910"
            ]
          },
          "111030910": {
            "id": "111030910",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "久之必自食恶果，为妖邪所诱而堕万劫不复。",
            "nextDialogs": [
              "111030911"
            ]
          },
          "111030911": {
            "id": "111030911",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "啊…我…您是…",
            "nextDialogs": [
              "111030912"
            ]
          },
          "111030912": {
            "id": "111030912",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他好像被魈的气场吓得不会说话了欸。",
            "nextDialogs": [
              "111030913"
            ]
          },
          "111030913": {
            "id": "111030913",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "敢问…敢问仙名是？"
          },
          "111030905": {
            "id": "111030905",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "不敢了，不敢了，都要被你们打得魂飞魄散了…"
          }
        }
      }
    },
    {
      "subId": "1110310",
      "subQuestName": "前往望舒客栈，向菲尔戈黛特询问「假仙人」的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111031001"
        ],
        "dialogs": {
          "111031001": {
            "id": "111031001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "老板，请问「掇星攫辰天君」是住在这里吧？",
            "nextDialogs": [
              "111031002"
            ]
          },
          "111031002": {
            "id": "111031002",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "「掇星攫辰天君」…你是说那个戴着面具的假仙人吧。",
            "nextDialogs": [
              "111031003"
            ]
          },
          "111031003": {
            "id": "111031003",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "他在我这里登记的名字是「王平安」哦。",
            "nextDialogs": [
              "111031006"
            ]
          },
          "111031006": {
            "id": "111031006",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "他已经把客房退了，说是要去独自游历山川…",
            "nextDialogs": [
              "111031007"
            ]
          },
          "111031007": {
            "id": "111031007",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "#哦对了，那人还说如果有位带着「会说话的小仙灵」的旅行者来找他，就把这封信给{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}。",
            "nextDialogs": [
              "111031008"
            ]
          },
          "111031008": {
            "id": "111031008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "会说话的小仙灵？谁啊？",
            "nextDialogs": [
              "111031009"
            ]
          },
          "111031009": {
            "id": "111031009",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "嗯…他说的旅行者就是你吧。喏，信在这里。",
            "nextDialogs": [
              "111031010"
            ]
          },
          "111031010": {
            "id": "111031010",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然有信留给我们，该不会是什么新的骗术吧？",
            "nextDialogs": [
              "111031011"
            ]
          },
          "111031011": {
            "id": "111031011",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "赶快先拆开看看吧！我很好奇！",
            "nextDialogs": [
              "111031019"
            ]
          },
          "111031019": {
            "id": "111031019",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "111031012"
            ]
          },
          "111031012": {
            "id": "111031012",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，他好像确实随信附送了一些东西给我们…",
            "nextDialogs": [
              "111031013"
            ]
          },
          "111031013": {
            "id": "111031013",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "里面还有「百无禁忌箓」！",
            "nextDialogs": [
              "111031014"
            ]
          },
          "111031014": {
            "id": "111031014",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是好久没见过这么识相的坏蛋了…"
          }
        }
      }
    },
    {
      "subId": "1110311",
      "subQuestName": "与魈对话，交还「百无禁忌箓」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111031101"
        ],
        "dialogs": {
          "111031101": {
            "id": "111031101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "果然在这里！",
            "nextDialogs": [
              "111031102"
            ]
          },
          "111031102": {
            "id": "111031102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们把「百无禁忌箓」回收了，你拿去收好吧？",
            "nextDialogs": [
              "111031103"
            ]
          },
          "111031103": {
            "id": "111031103",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "有劳二位。",
            "nextDialogs": [
              "111031104"
            ]
          },
          "111031104": {
            "id": "111031104",
            "speakerId": 2091,
            "speakerName": "秀华",
            "text": "需要点菜吗，这位先生？",
            "nextDialogs": [
              "111031105"
            ]
          },
          "111031105": {
            "id": "111031105",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "一份「烤螭虎鱼」。",
            "nextDialogs": [
              "111031106"
            ]
          },
          "111031106": {
            "id": "111031106",
            "speakerId": 2091,
            "speakerName": "秀华",
            "text": "好的，马上给您下厨！",
            "nextDialogs": [
              "111031107"
            ]
          },
          "111031107": {
            "id": "111031107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？这次居然不是杏仁豆腐，对魈来说太少见了。",
            "nextDialogs": [
              "111031108"
            ]
          },
          "111031108": {
            "id": "111031108",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "这是「铜雀」生前喜欢吃的…",
            "nextDialogs": [
              "111031109"
            ]
          },
          "111031109": {
            "id": "111031109",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "我只是想，尝尝是什么味道。",
            "nextDialogs": [
              "111031110"
            ]
          },
          "111031110": {
            "id": "111031110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样啊…",
            "nextDialogs": [
              "111031111"
            ]
          },
          "111031111": {
            "id": "111031111",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "「惊涛入海觅螭虎，风雪归山斩妖邪」…",
            "nextDialogs": [
              "111031112"
            ]
          },
          "111031112": {
            "id": "111031112",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "……",
            "nextDialogs": [
              "111031113"
            ]
          },
          "111031113": {
            "id": "111031113",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "两位还有事么？我比较习惯一个人吃饭。",
            "nextDialogs": [
              "111031116"
            ]
          },
          "111031116": {
            "id": "111031116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，派蒙和旅行者，就这样帅气地，静静离开吧…"
          }
        }
      }
    },

    {
      "subId": "1110317",
      "subQuestName": "(test)切香炉$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111030201"
        ],
        "dialogs": {
          "111030201": {
            "id": "111030201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个香炉…应该没问题吧？",
            "nextDialogs": [
              "111030202"
            ]
          },
          "111030202": {
            "id": "111030202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "至少不像这座庙一样破破烂烂。",
            "nextDialogs": [
              "111030203"
            ]
          },
          "111030203": {
            "id": "111030203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "香炉之后…还要收集附近的「七星灯」，赶快行动吧？"
          }
        }
      }
    },

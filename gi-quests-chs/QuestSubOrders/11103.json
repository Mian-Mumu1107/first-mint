    {
      "subId": "1110303",
      "subQuestName": "回去找铜雀先生",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111030301"
        ],
        "dialogs": {
          "111030301": {
            "id": "111030301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？怎么没人了，之前明明就在这里的…",
            "nextDialogs": [
              "111030302"
            ]
          },
          "111030302": {
            "id": "111030302",
            "speakerId": 10221,
            "speakerName": "雕像",
            "text": "想不到你们还会在意我的去向…本以为你们拿了东西便会走了。",
            "nextDialogs": [
              "111030330"
            ]
          },
          "111030330": {
            "id": "111030330",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！…是刚才那位先生的声音！你、你在哪里！？",
            "nextDialogs": [
              "111030303"
            ]
          },
          "111030303": {
            "id": "111030303",
            "speakerId": 10221,
            "speakerName": "雕像",
            "text": "我的形体，千年之前就不在了。你们方才见到的，是「浮世留形法」所造的幻影。",
            "nextDialogs": [
              "111030304"
            ]
          },
          "111030304": {
            "id": "111030304",
            "speakerId": 10221,
            "speakerName": "雕像",
            "text": "如今你们将「浮世留形法」所用的香炉与七星灯拿去，自然就见不到我了。",
            "nextDialogs": [
              "111030308",
              "111030307"
            ]
          },
          "111030308": {
            "id": "111030308",
            "speakerId": 10221,
            "speakerName": "雕像",
            "text": "我本是夜叉中的小仙，岩王帝君赐我仙名「铜雀」，数千年前实力不济，战死沙场。",
            "nextDialogs": [
              "111030309"
            ]
          },
          "111030309": {
            "id": "111030309",
            "speakerId": 10221,
            "speakerName": "雕像",
            "text": "今天是我的忌日，看看今日的璃月是我的遗愿，因而冒昧在此施术。",
            "nextDialogs": [
              "111030310"
            ]
          },
          "111030310": {
            "id": "111030310",
            "speakerId": 10221,
            "speakerName": "雕像",
            "text": "话说…你们是从「降魔大圣」那里来的吧？",
            "nextDialogs": [
              "111030311"
            ]
          },
          "111030311": {
            "id": "111030311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来你们之间认识吗？",
            "nextDialogs": [
              "111030312"
            ]
          },
          "111030312": {
            "id": "111030312",
            "speakerId": 10221,
            "speakerName": "雕像",
            "text": "我能从你们身上感受到他的气息…还有，愈发浓郁的「业障」的气息…",
            "nextDialogs": [
              "111030313"
            ]
          },
          "111030313": {
            "id": "111030313",
            "speakerId": 10221,
            "speakerName": "雕像",
            "text": "唉…数千年来，他还一直在忍受着那样的痛苦吗…",
            "nextDialogs": [
              "111030314"
            ]
          },
          "111030314": {
            "id": "111030314",
            "speakerId": 10221,
            "speakerName": "雕像",
            "text": "…真是令我无地自容。",
            "nextDialogs": [
              "111030315"
            ]
          },
          "111030315": {
            "id": "111030315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别这么说，「铜雀」先生不是为了璃月献出了生命吗？",
            "nextDialogs": [
              "111030316"
            ]
          },
          "111030316": {
            "id": "111030316",
            "speakerId": 10221,
            "speakerName": "雕像",
            "text": "性命虽然珍贵…但比起「降魔大圣」所承受的，死亡不过是一种苟且偷安而已。",
            "nextDialogs": [
              "111030317"
            ]
          },
          "111030317": {
            "id": "111030317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「铜雀」先生…",
            "nextDialogs": [
              "111030318"
            ]
          },
          "111030318": {
            "id": "111030318",
            "speakerId": 10221,
            "speakerName": "雕像",
            "text": "哈哈，真是不好意思。生日要快乐地度过，但忌日就难免感伤吧。",
            "nextDialogs": [
              "111030319"
            ]
          },
          "111030319": {
            "id": "111030319",
            "speakerId": 10221,
            "speakerName": "雕像",
            "text": "「浮世留形法」的效力也快散尽了，请二位珍重，替我问候「降魔大圣」…"
          },
          "111030307": {
            "id": "111030307",
            "speakerId": 10221,
            "speakerName": "雕像",
            "text": "哈哈哈…这么说也没错。「仙」与「鬼」原本就是一线之隔。"
          }
        }
      }
    },

    {
      "subId": "1110307",
      "subQuestName": "(test)进行仪式3$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111030701"
        ],
        "dialogs": {
          "111030701": {
            "id": "111030701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "已经按照魈说的把仪式完成啦。",
            "nextDialogs": [
              "111030702"
            ]
          },
          "111030702": {
            "id": "111030702",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "……马马虎虎吧。",
            "nextDialogs": [
              "111030703"
            ]
          },
          "111030703": {
            "id": "111030703",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "剩下的交给我，你们做好准备「迎接」他。",
            "nextDialogs": [
              "111030704"
            ]
          },
          "111030704": {
            "id": "111030704",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "这里是…嗯？你们似乎有些眼熟。",
            "nextDialogs": [
              "111030705"
            ]
          },
          "111030705": {
            "id": "111030705",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "身体是怎么回事，轻飘飘的感觉不到重量…",
            "nextDialogs": [
              "111030707",
              "111030710"
            ]
          },
          "111030707": {
            "id": "111030707",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "…仙法？哈哈哈哈哈，在本仙面前装成仙人，不知天高地厚。",
            "nextDialogs": [
              "111030708"
            ]
          },
          "111030708": {
            "id": "111030708",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "话说此地是何处，本仙明明刚在望舒客栈安安稳稳地睡下…",
            "nextDialogs": [
              "111030712"
            ]
          },
          "111030712": {
            "id": "111030712",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "对了，嗯，原来如此，不愧是本仙哈哈哈…",
            "nextDialogs": [
              "111030713"
            ]
          },
          "111030713": {
            "id": "111030713",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "本仙一定是在做梦！",
            "nextDialogs": [
              "111030714"
            ]
          },
          "111030714": {
            "id": "111030714",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…对这个无可救药的人，似乎没法达到预期的效果…"
          },
          "111030710": {
            "id": "111030710",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "死、死死死死了！？",
            "nextDialogs": [
              "111030711"
            ]
          },
          "111030711": {
            "id": "111030711",
            "speakerId": 10203,
            "speakerName": "掇星攫辰天君",
            "text": "怎么可能，本仙明明刚在望舒客栈安安稳稳地睡下…"
          }
        }
      }
    },
    {
      "subId": "1110308",
      "subQuestName": "惩罚「假仙人」的魂魄",

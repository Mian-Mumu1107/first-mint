    {
      "subId": "1110305",
      "subQuestName": "与魈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111030501"
        ],
        "dialogs": {
          "111030501": {
            "id": "111030501",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "仪式道具已经备齐了么？",
            "nextDialogs": [
              "111030502"
            ]
          },
          "111030502": {
            "id": "111030502",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "这香炉和七星灯的式样很完美，简直像是为仙法特制的…你们从哪里弄来的？",
            "nextDialogs": [
              "111030503"
            ]
          },
          "111030503": {
            "id": "111030503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "从名叫「铜雀」的夜叉那里…",
            "nextDialogs": [
              "111030504"
            ]
          },
          "111030504": {
            "id": "111030504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且「铜雀」先生托我们向你问好！",
            "nextDialogs": [
              "111030505"
            ]
          },
          "111030505": {
            "id": "111030505",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "「铜雀」…",
            "nextDialogs": [
              "111030506"
            ]
          },
          "111030506": {
            "id": "111030506",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "…原来是他啊，确实有他的风格。",
            "nextDialogs": [
              "111030507"
            ]
          },
          "111030507": {
            "id": "111030507",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "果然「铜雀」也放不下璃月吧…但愿璃月今日的光景可以让他放心安息。",
            "nextDialogs": [
              "111030508"
            ]
          },
          "111030508": {
            "id": "111030508",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "那么现在开始仪式的准备吧。",
            "nextDialogs": [
              "111030509"
            ]
          },
          "111030509": {
            "id": "111030509",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "香炉置正中尊位，七星灯散落周围，极寒之物于其间点缀，安排好之后我们再继续。",
            "nextDialogs": [
              "111030510"
            ]
          },
          "111030510": {
            "id": "111030510",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "嗯，如此便可。接下来是「梦游诸境法」的关键…",
            "nextDialogs": [
              "111030511"
            ]
          },
          "111030511": {
            "id": "111030511",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "施术的过程共有四个环节：献香，冥思，施咒，放矢。",
            "nextDialogs": [
              "111030512"
            ]
          },
          "111030512": {
            "id": "111030512",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊…还要这么麻烦呀？",
            "nextDialogs": [
              "111030513"
            ]
          },
          "111030513": {
            "id": "111030513",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "仙法乃是绝云仙人千年所悟，其中玄奥颇深，切不可轻慢。",
            "nextDialogs": [
              "111030514"
            ]
          },
          "111030514": {
            "id": "111030514",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "否则可能反噬自身，魂魄离体难以复归…",
            "nextDialogs": [
              "111030515"
            ]
          },
          "111030515": {
            "id": "111030515",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对不起，我又说错话了！",
            "nextDialogs": [
              "111030516"
            ]
          },
          "111030516": {
            "id": "111030516",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "「献香」，就是在香炉上香一柱，心怀对岩王帝君的敬畏。",
            "nextDialogs": [
              "111030517"
            ]
          },
          "111030517": {
            "id": "111030517",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "「冥思」，断绝一切杂念，将施术对象的形象在脑中定格。",
            "nextDialogs": [
              "111030518"
            ]
          },
          "111030518": {
            "id": "111030518",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "「施咒」，厉声将咒文念出——「帝婆夜叉，三尸押来」。",
            "nextDialogs": [
              "111030519"
            ]
          },
          "111030519": {
            "id": "111030519",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "「放矢」，对两尊夜叉雕像各射出一箭，作为使役的契约。",
            "nextDialogs": [
              "111030520"
            ]
          },
          "111030520": {
            "id": "111030520",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "没有意外的话，片刻后那人的魂魄便会出现于此。",
            "nextDialogs": [
              "111030523"
            ]
          },
          "111030523": {
            "id": "111030523",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "没有疑问的话，就赶快开始吧。",
            "nextDialogs": [
              "111030524"
            ]
          },
          "111030524": {
            "id": "111030524",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那总之…先上柱香吧？要心怀对岩王帝君的敬意什么的…"
          }
        }
      }
    },

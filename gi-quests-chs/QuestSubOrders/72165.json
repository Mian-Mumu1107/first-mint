    {
      "subId": "7216509",
      "subQuestName": "(test)第五日$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721650501"
        ],
        "dialogs": {
          "721650501": {
            "id": "721650501",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "你们好呀，年轻人。今天有什么事吗？",
            "nextDialogs": [
              "721650502"
            ]
          },
          "721650502": {
            "id": "721650502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请为我占卜一下吧！",
            "nextDialogs": [
              "721650503"
            ]
          },
          "721650503": {
            "id": "721650503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "会不会又有好运呢！",
            "nextDialogs": [
              "721650504"
            ]
          },
          "721650504": {
            "id": "721650504",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "唔…「灵草」的光芒已经很弱了，看起来需要歇息一阵子了呢…",
            "nextDialogs": [
              "721650505"
            ]
          },
          "721650505": {
            "id": "721650505",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "不过没关系，还能再为你们占卜一次。",
            "nextDialogs": [
              "721650506"
            ]
          },
          "721650506": {
            "id": "721650506",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "唔…从「灵草」明灭来看…是好运哦。",
            "nextDialogs": [
              "721650507"
            ]
          },
          "721650507": {
            "id": "721650507",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "东北方的残迹，海上孑立的古城，哀哀伫留的旧日之灵会引导你们。",
            "nextDialogs": [
              "721650508"
            ]
          },
          "721650508": {
            "id": "721650508",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "但是呢…",
            "nextDialogs": [
              "721650509"
            ]
          },
          "721650509": {
            "id": "721650509",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "你要为她打开一道大门，令她返回永久美梦的睡巢…才能获得命定的奖赏。",
            "nextDialogs": [
              "721650510"
            ]
          },
          "721650510": {
            "id": "721650510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…什么古城，什么鸟巢的…好乱呀。",
            "nextDialogs": [
              "721650511"
            ]
          },
          "721650511": {
            "id": "721650511",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "呵呵，没关系，我一直在这里的。脑子转不过来的话可以随时找我。",
            "nextDialogs": [
              "721650512"
            ]
          },
          "721650512": {
            "id": "721650512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇啊，她是在说我笨吗！"
          }
        }
      }
    },

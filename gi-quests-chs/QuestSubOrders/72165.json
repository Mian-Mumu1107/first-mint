  "subQuests": [
    {
      "subId": "7216501",
      "subQuestName": "(test)第一日$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721650101"
        ],
        "dialogs": {
          "721650101": {
            "id": "721650101",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "你们回来了，请问有什么事吗？",
            "nextDialogs": [
              "721650102"
            ]
          },
          "721650102": {
            "id": "721650102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请为我占卜一下吧！",
            "nextDialogs": [
              "721650103"
            ]
          },
          "721650103": {
            "id": "721650103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#我也想知道{NICKNAME}今天会有怎样的好运气！",
            "nextDialogs": [
              "721650104"
            ]
          },
          "721650104": {
            "id": "721650104",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "嗯…从「灵草」叶片的纹理来看…是好运哟。",
            "nextDialogs": [
              "721650105"
            ]
          },
          "721650105": {
            "id": "721650105",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "两位会在海祇岛的最高处，供奉神的旧地，与好运相遇。",
            "nextDialogs": [
              "721650106"
            ]
          },
          "721650106": {
            "id": "721650106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…怎么我看不出来这么多信息呢…",
            "nextDialogs": [
              "721650107"
            ]
          },
          "721650107": {
            "id": "721650107",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "呵呵，这是本地老人的智慧哟。",
            "nextDialogs": [
              "721650108"
            ]
          },
          "721650108": {
            "id": "721650108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这种敷衍的回答…好可疑！"
          }
        }
      }
    },
    {
      "subId": "7216502",
      "subQuestName": "(test)第一日刷group$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721650201"
        ],
        "dialogs": {
          "721650201": {
            "id": "721650201",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "你们好呀，年轻人。今天有什么事吗？",
            "nextDialogs": [
              "721650202"
            ]
          },
          "721650202": {
            "id": "721650202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请为我占卜一下吧！",
            "nextDialogs": [
              "721650203"
            ]
          },
          "721650203": {
            "id": "721650203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼哼，今天又有怎样的运势呢~",
            "nextDialogs": [
              "721650204"
            ]
          },
          "721650204": {
            "id": "721650204",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "嗯…根据「灵草」的预言…会有厄运啊…",
            "nextDialogs": [
              "721650205"
            ]
          },
          "721650205": {
            "id": "721650205",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "两位在海祇岛的南方的洞窟，贼匪的巢穴，会遭遇不期而至的厄运…",
            "nextDialogs": [
              "721650206"
            ]
          },
          "721650206": {
            "id": "721650206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，是厄运！那我们避开那种地方好了…",
            "nextDialogs": [
              "721650207"
            ]
          },
          "721650207": {
            "id": "721650207",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "呵呵，但是呢…",
            "nextDialogs": [
              "721650208"
            ]
          },
          "721650208": {
            "id": "721650208",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "若克服厄运的话，说不定会有意外的收获。",
            "nextDialogs": [
              "721650209"
            ]
          },
          "721650209": {
            "id": "721650209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "收获…？是宝藏吗？是宝藏吗！",
            "nextDialogs": [
              "721650210"
            ]
          },
          "721650210": {
            "id": "721650210",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "我没说是哟…",
            "nextDialogs": [
              "721650211"
            ]
          },
          "721650211": {
            "id": "721650211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦…",
            "nextDialogs": [
              "721650212"
            ]
          },
          "721650212": {
            "id": "721650212",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "但我也没说不是。",
            "nextDialogs": [
              "721650213"
            ]
          },
          "721650213": {
            "id": "721650213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！这个老婆婆怎么这样！"
          }
        }
      }
    },
    {
      "subId": "7216511",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721651101"
        ],
        "dialogs": {
          "721651101": {
            "id": "721651101",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "呵呵，好运是急不来的…况且，「灵草」也需要休息呀。",
            "nextDialogs": [
              "721651102"
            ]
          },
          "721651102": {
            "id": "721651102",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "不过呀，还是很感谢你们来和我一个老人家打招呼，祝你们一路平安。"
          }
        }
      }
    },

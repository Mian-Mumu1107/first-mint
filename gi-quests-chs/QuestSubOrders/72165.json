          "721650407": {
            "id": "721650407",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "但是呢…",
            "nextDialogs": [
              "721650408"
            ]
          },
          "721650408": {
            "id": "721650408",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "只要挺身而出，战胜厄运，便会赢得理所应得的奖励。",
            "nextDialogs": [
              "721650409"
            ]
          },
          "721650409": {
            "id": "721650409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "和上次的说法差不多呢…",
            "nextDialogs": [
              "721650410"
            ]
          },
          "721650410": {
            "id": "721650410",
            "speakerId": 1000,
            "speakerName": "小卷",
            "text": "呵呵，生活就是这样…新鲜的经历，总是藏在似曾相识的日子里。"
          }
        }
      }

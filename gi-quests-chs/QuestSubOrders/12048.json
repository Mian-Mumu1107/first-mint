  "subQuests": [
    {
      "subId": "1204801",
      "subQuestName": "前往秋沙钱汤",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120480101"
        ],
        "dialogs": {
          "120480101": {
            "id": "120480101",
            "speakerId": 1000,
            "speakerName": "百日白白音",
            "text": "那位客人，到这里登记！",
            "nextDialogs": [
              "120480102"
            ]
          },
          "120480102": {
            "id": "120480102",
            "speakerId": 1001,
            "speakerName": "柴葉紫",
            "text": "什么日子啊，能来这么多人？早知道就限号…",
            "nextDialogs": [
              "120480103"
            ]
          },
          "120480103": {
            "id": "120480103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哇，那个江村一玄斋的问题被解决后生意好了很多嘛，阿紫和白音恢复得也很不错！",
            "nextDialogs": [
              "120480104"
            ]
          },
          "120480104": {
            "id": "120480104",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "#早啊，{NICKNAME}，派蒙，来预约？",
            "nextDialogs": [
              "120480105"
            ]
          },
          "120480105": {
            "id": "120480105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对啊，就约今天！",
            "nextDialogs": [
              "120480106"
            ]
          },
          "120480106": {
            "id": "120480106",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "那我需要再给两位准备一份贵宾邀请函，毕竟两位都是本店的贵客。",
            "nextDialogs": [
              "120480107"
            ]
          },
          "120480107": {
            "id": "120480107",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好耶！这次我想先体验美食服务。",
            "nextDialogs": [
              "120480108"
            ]
          },
          "120480108": {
            "id": "120480108",
            "speakerId": 1004,
            "speakerName": "八重神子",
            "text": "哎呀，前天刚给过撤股的建议，差点让你丢掉这么好的生意，你不会埋怨我吧，老朋友？",
            "nextDialogs": [
              "120480109"
            ]
          },
          "120480109": {
            "id": "120480109",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "我根本没有考虑你的建议，何来埋怨呢？",
            "nextDialogs": [
              "120480110"
            ]
          },
          "120480110": {
            "id": "120480110",
            "speakerId": 1004,
            "speakerName": "八重神子",
            "text": "就是这个语气，很亲切。",
            "nextDialogs": [
              "120480111"
            ]
          },
          "120480111": {
            "id": "120480111",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你又搞突然出现这一套…",
            "nextDialogs": [
              "120480112"
            ]
          },
          "120480112": {
            "id": "120480112",
            "speakerId": 1004,
            "speakerName": "八重神子",
            "text": "早啊，两个小家伙，昨晚的夜色还好吗？",
            "nextDialogs": [
              "120480113"
            ]
          },
          "120480113": {
            "id": "120480113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你偷看了？",
            "nextDialogs": [
              "120480114"
            ]
          },
          "120480114": {
            "id": "120480114",
            "speakerId": 1004,
            "speakerName": "八重神子",
            "text": "偷看？那棵树就在鸣神大社下面，难道要我把鸣神大社搬走吗？",
            "nextDialogs": [
              "120480115"
            ]
          },
          "120480115": {
            "id": "120480115",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "宫司大人来这里，所为何事？",
            "nextDialogs": [
              "120480116"
            ]
          },
          "120480116": {
            "id": "120480116",
            "speakerId": 1004,
            "speakerName": "八重神子",
            "text": "嗯…就当是随便逛逛吧，顺便带来一个天领奉行的消息。",
            "nextDialogs": [
              "120480117"
            ]
          },
          "120480117": {
            "id": "120480117",
            "speakerId": 1004,
            "speakerName": "八重神子",
            "text": "你的族人昨晚从水里捞上来的那个家伙已经脱离了生命危险，但心智似乎降低到了小孩子的水平。",
            "nextDialogs": [
              "120480118"
            ]
          },
          "120480118": {
            "id": "120480118",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "这样也好…另外，我先向宫司大人道谢了，昨天的事情能顺利解决，多亏了宫司大人的帮助。",
            "nextDialogs": [
              "120480119"
            ]
          },
          "120480119": {
            "id": "120480119",
            "speakerId": 1004,
            "speakerName": "八重神子",
            "text": "嗯？",
            "nextDialogs": [
              "120480120"
            ]
          },
          "120480120": {
            "id": "120480120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是我…",
            "nextDialogs": [
              "120480121"
            ]
          },
          "120480121": {
            "id": "120480121",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "神子，我们两个之间藏不住心思的向来不是我。",
            "nextDialogs": [
              "120480122"
            ]
          },
          "120480122": {
            "id": "120480122",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "要说面对你时的自卑和要强这两种情绪，我当然会有，或者说就是依靠这两种情绪我才有动力经营这份产业。",
            "nextDialogs": [
              "120480123"
            ]
          },
          "120480123": {
            "id": "120480123",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "自卑让我时刻保持清醒，要强让我能坚持下去。这是已经被妥善处理的心理问题，不需要让你如此顾忌。",
            "nextDialogs": [
              "120480124"
            ]
          },
          "120480124": {
            "id": "120480124",
            "speakerId": 1004,
            "speakerName": "八重神子",
            "text": "唉…还不如早点讲明呢，也不用让这小家伙两头跑了。",
            "nextDialogs": [
              "120480125"
            ]
          },
          "120480125": {
            "id": "120480125",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "#{NICKNAME}的行动还是很有意义的，毕竟要为宫司大人考虑一下。",
            "nextDialogs": [
              "120480126"
            ]
          },
          "120480126": {
            "id": "120480126",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "那个「江村一玄斋」聚集了大批信徒，在他的底细被曝光之前，鸣神大社的宫司贸然介入进行打压的话…",
            "nextDialogs": [
              "120480127"
            ]
          },
          "120480127": {
            "id": "120480127",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "一帮吵吵闹闹的信徒会对鸣神大社的名誉带来多少影响，很难估量，所以宫司大人明面上最好没有过问此事。",
            "nextDialogs": [
              "120480128"
            ]
          },
          "120480128": {
            "id": "120480128",
            "speakerId": 1004,
            "speakerName": "八重神子",
            "text": "这一点我当然知道，但还是老朋友的心情更让我顾忌一些，否则也没必要搞那么多弯弯绕。",
            "nextDialogs": [
              "120480129"
            ]
          },
          "120480129": {
            "id": "120480129",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "神子…",
            "nextDialogs": [
              "120480130"
            ]
          },
          "120480130": {
            "id": "120480130",
            "speakerId": 1004,
            "speakerName": "八重神子",
            "text": "你还是那个有趣但不怎么可爱的家伙…看来担心你会有烦恼果然没什么必要。",
            "nextDialogs": [
              "120480131"
            ]
          },
          "120480131": {
            "id": "120480131",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "…我还是会有烦恼的。不过，每种烦恼都有各自对应的解药。",
            "nextDialogs": [
              "120480132"
            ]
          },
          "120480132": {
            "id": "120480132",
            "speakerId": 1003,
            "speakerName": "梦见月瑞希",
            "text": "这是新的邀请函，请收好。"
          }
        }
      }
    },
    {

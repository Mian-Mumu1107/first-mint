    {
      "subId": "4007699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400769916"
        ],
        "dialogs": {
          "400769916": {
            "id": "400769916",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "我懂得事物运行的规则，窥视天地间的秘密。旁边就够了，没必要改变什么。"
          }
        }
      }

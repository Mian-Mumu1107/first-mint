    {
      "subId": "4007609",
      "subQuestName": "进入水下空间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400760901"
        ],
        "dialogs": {
          "400760901": {
            "id": "400760901",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "哇啊！这、这…",
            "nextDialogs": [
              "400760902"
            ]
          },
          "400760902": {
            "id": "400760902",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "又是蒙德的房屋？",
            "nextDialogs": [
              "400760903"
            ]
          },
          "400760903": {
            "id": "400760903",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "怎么到我家了啊——！",
            "nextDialogs": [
              "400760904"
            ]
          },
          "400760904": {
            "id": "400760904",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "你家？这是你家？",
            "nextDialogs": [
              "400760905"
            ]
          },
          "400760905": {
            "id": "400760905",
            "speakerId": 1004,
            "speakerName": "奥兹",
            "text": "哦呀，这可真没想到…我似乎听说，梅姬斯图斯卿一直过着较为拮据的生活，可这栋住宅…",
            "nextDialogs": [
              "400760906"
            ]
          },
          "400760906": {
            "id": "400760906",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "地上这几本书有标签呢，「孤品，仅售990000摩拉…」欸？！这么贵吗？！",
            "nextDialogs": [
              "400760907"
            ]
          },
          "400760907": {
            "id": "400760907",
            "speakerId": 1005,
            "speakerName": "辛焱",
            "text": "这边也有许多一看就很贵的精装书本…这就是占星术士的房间吗…",
            "nextDialogs": [
              "400760908"
            ]
          },
          "400760908": {
            "id": "400760908",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "房间布设得十分精巧…这里一定不便宜。",
            "nextDialogs": [
              "400760911"
            ]
          },
          "400760911": {
            "id": "400760911",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "我说，我只是偶尔没有现金而已，又不真是穷光蛋。",
            "nextDialogs": [
              "400760912"
            ]
          },
          "400760912": {
            "id": "400760912",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "你不是吗？我还请你吃过饭，甚至带你去我家吃饭！",
            "nextDialogs": [
              "400760913"
            ]
          },
          "400760913": {
            "id": "400760913",
            "speakerId": 1004,
            "speakerName": "奥兹",
            "text": "小姐，措辞，措辞。",
            "nextDialogs": [
              "400760914"
            ]
          },
          "400760914": {
            "id": "400760914",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "啊咳咳！汝蒙受圣恩，随本皇女进入幽夜净土王城中拜谒断罪之皇帝皇后，如此大事，汝竟敢忘却？",
            "nextDialogs": [
              "400760915"
            ]
          },
          "400760915": {
            "id": "400760915",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "啊对，你妈妈做的炖肉和冷盘肉可好吃了！嗯，突然好想再吃一次…",
            "nextDialogs": [
              "400760916"
            ]
          },
          "400760916": {
            "id": "400760916",
            "speakerId": 1004,
            "speakerName": "奥兹",
            "text": "梅姬斯图斯卿，现在不是说这个的时候！",
            "nextDialogs": [
              "400760917"
            ]
          },
          "400760917": {
            "id": "400760917",
            "speakerId": 1005,
            "speakerName": "辛焱",
            "text": "是蒙德菜吗？我也想吃！听说蒙德有很多美食，尤其是肉菜。",
            "nextDialogs": [
              "400760918"
            ]
          },
          "400760918": {
            "id": "400760918",
            "speakerId": 1000,
            "speakerName": "菲谢尔",
            "text": "哼哼，那也赐汝荣光，下回，尔等可随本皇女一同面见父皇母后。",
            "nextDialogs": [
              "400760919"
            ]
          },
          "400760919": {
            "id": "400760919",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#真的？喂{NICKNAME}，我们也去吧！",
            "nextDialogs": [
              "400760920"
            ]
          },
          "400760920": {
            "id": "400760920",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "这么说来，好久没去朋友家串门，我也恭敬不如从命了。",
            "nextDialogs": [
              "400760921"
            ]
          },
          "400760921": {
            "id": "400760921",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "唔，是不是应该提前准备伴手礼？",
            "nextDialogs": [
              "400760922"
            ]
          },
          "400760922": {
            "id": "400760922",
            "speakerId": 1004,
            "speakerName": "奥兹",
            "text": "那二位为人随和亲切，并不计较这些。诸位随意便好。",
            "nextDialogs": [
              "400760923"
            ]
          },
          "400760923": {
            "id": "400760923",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "去的话一定要吃那个冷盘肉，听说是她家的拿手好菜，非常美味！",
            "nextDialogs": [
              "400760924"
            ]
          },
          "400760924": {
            "id": "400760924",
            "speakerId": 1004,
            "speakerName": "奥兹",
            "text": "比起这些，是否应该先解决眼前的谜题呢？其实，从进屋到现在，我都很介意那个摆件…",
            "nextDialogs": [
              "400760925"
            ]
          },
          "400760925": {
            "id": "400760925",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "啊，对哦。"
          }
        }
      }
    },

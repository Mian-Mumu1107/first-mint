{
  "lineCounts": {
    "Player": 4,
    "希诺宁": 16,
    "欧洛伦": 21,
    "派蒙": 13
  },
  "subQuests": [
    {
      "subId": "7550601",
      "subQuestName": "等待至第二天",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "755060101"
        ],
        "dialogs": {
          "755060101": {
            "id": "755060101",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "嗨，你们来了啊，这里就是最后一处深渊蜜虫出没的地方了。",
            "nextDialogs": [
              "755060102"
            ]
          },
          "755060102": {
            "id": "755060102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "把这里的蜜虫捉住就算搞定了吧？",
            "nextDialogs": [
              "755060103"
            ]
          },
          "755060103": {
            "id": "755060103",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "嗯，就算还有一些漏网之鱼，也不是大问题，我会抽空处理的。",
            "nextDialogs": [
              "755060104"
            ]
          },
          "755060104": {
            "id": "755060104",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "族里也有传来消息，病人的情况这几天基本都好转了。",
            "nextDialogs": [
              "755060105"
            ]
          },
          "755060105": {
            "id": "755060105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是不错的消息！",
            "nextDialogs": [
              "755060106"
            ]
          },
          "755060106": {
            "id": "755060106",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "不过还有一件可惜的事，小派蒙警惕的阴谋并没有发生。",
            "nextDialogs": [
              "755060107"
            ]
          },
          "755060107": {
            "id": "755060107",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "那些浆果看来就是自然地长在了蜜虫的聚集地。",
            "nextDialogs": [
              "755060108"
            ]
          },
          "755060108": {
            "id": "755060108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…我可没有预测什么愚人众…盗宝团之类的展开…我这是在展示一个优秀的向导该有的警惕心啦！",
            "nextDialogs": [
              "755060109"
            ]
          },
          "755060109": {
            "id": "755060109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "相信你可以一直保持。",
            "nextDialogs": [
              "755060110"
            ]
          },
          "755060110": {
            "id": "755060110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，那是当然。",
            "nextDialogs": [
              "755060111"
            ]
          },
          "755060111": {
            "id": "755060111",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "好咯，那我们就快速解决最后的任务吧。",
            "nextDialogs": [
              "755060112"
            ]
          },
          "755060112": {
            "id": "755060112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶！捉虫小队，最后出击！"
          }
        }
      }
    },
    {
      "subId": "7550604",
      "subQuestName": "前往最后的深渊蜜虫出没地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7550602",
      "subQuestName": "捕捉深渊蜜虫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "755060201"
        ],
        "dialogs": {
          "755060201": {
            "id": "755060201",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "#希诺宁？还有{NICKNAME}和派蒙？你们好呀。",
            "nextDialogs": [
              "755060202"
            ]
          },
          "755060202": {
            "id": "755060202",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "欧洛伦？你怎么来了？",
            "nextDialogs": [
              "755060203"
            ]
          },
          "755060203": {
            "id": "755060203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你身体恢复好了吗？",
            "nextDialogs": [
              "755060204"
            ]
          },
          "755060204": {
            "id": "755060204",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "多谢关心，奶奶给我灌了很苦的东西，强迫我休息了好几天，现在已经好很多了。",
            "nextDialogs": [
              "755060205"
            ]
          },
          "755060205": {
            "id": "755060205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好呀！欧洛伦，你也是来帮希诺宁捉蜜虫的吗？",
            "nextDialogs": [
              "755060206"
            ]
          },
          "755060206": {
            "id": "755060206",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "捉蜜虫？哦！原来十分甜被你们捉走了…",
            "nextDialogs": [
              "755060207"
            ]
          },
          "755060207": {
            "id": "755060207",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "难怪极限甜、异常甜它们也不见了…原来如此。",
            "nextDialogs": [
              "755060208"
            ]
          },
          "755060208": {
            "id": "755060208",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "呃…这些是蜜虫的名字？",
            "nextDialogs": [
              "755060209"
            ]
          },
          "755060209": {
            "id": "755060209",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "是的。",
            "nextDialogs": [
              "755060210"
            ]
          },
          "755060210": {
            "id": "755060210",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "这是为了方便区分，我不会评价它们的，它们就算不产蜜也都很棒。",
            "nextDialogs": [
              "755060211"
            ]
          },
          "755060211": {
            "id": "755060211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以…这些蜜虫都是你养的？",
            "nextDialogs": [
              "755060212"
            ]
          },
          "755060212": {
            "id": "755060212",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "我其实没怎么干扰它们的作息起居，我们只是在同一片领地生活，是比较融洽的那种关系。",
            "nextDialogs": [
              "755060213"
            ]
          },
          "755060213": {
            "id": "755060213",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "呃…抱歉，我不知道这回事。因为它们被深渊污染，影响到了部族，所以不得不来处理一下。",
            "nextDialogs": [
              "755060214"
            ]
          },
          "755060214": {
            "id": "755060214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对对对…我们也没有伤到它们的性命哦！",
            "nextDialogs": [
              "755060215"
            ]
          },
          "755060215": {
            "id": "755060215",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "那就好…没关系，不用这么在意，我本来也是来处理这个问题的。",
            "nextDialogs": [
              "755060216"
            ]
          },
          "755060216": {
            "id": "755060216",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "只是有件事要纠正一下，蜜虫是一种很聪明的小生命，它们不是被深渊污染了，是它们主动吃下了深渊能量。",
            "nextDialogs": [
              "755060217"
            ]
          },
          "755060217": {
            "id": "755060217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？是主动吃的？",
            "nextDialogs": [
              "755060218"
            ]
          },
          "755060218": {
            "id": "755060218",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "是这样没错，它们一次只吃一点点，虽然一点点就会让自己的身体膨大很多，但是不会致死。",
            "nextDialogs": [
              "755060219"
            ]
          },
          "755060219": {
            "id": "755060219",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "之后它们就会飞到很远的地方，然后产下包裹了污染物的燃素蜜珠。",
            "nextDialogs": [
              "755060220"
            ]
          },
          "755060220": {
            "id": "755060220",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "蜜珠外壳可以隔绝一定的污染，这样做，就能逐渐把深渊能量从家园里剥离出来。",
            "nextDialogs": [
              "755060221"
            ]
          },
          "755060221": {
            "id": "755060221",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "虽然要做很多很多遍，但是它们都很有耐心，就算是蚂蚁搬家也没问题。",
            "nextDialogs": [
              "755060222"
            ]
          },
          "755060222": {
            "id": "755060222",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…原来它们是在保护家园啊…",
            "nextDialogs": [
              "755060223"
            ]
          },
          "755060223": {
            "id": "755060223",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "我还是第一次知道，原来它们也知道这片土地正在被侵害。",
            "nextDialogs": [
              "755060224"
            ]
          },
          "755060224": {
            "id": "755060224",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "嗯，十分甜它们也一直在努力战斗！全是很能干的好蜜虫。",
            "nextDialogs": [
              "755060225"
            ]
          },
          "755060225": {
            "id": "755060225",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "纳塔不愧是战争的国度。",
            "nextDialogs": [
              "755060226"
            ]
          },
          "755060226": {
            "id": "755060226",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "不过欧洛伦，你是怎么找到这里来的？",
            "nextDialogs": [
              "755060227"
            ]
          },
          "755060227": {
            "id": "755060227",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "噢，因为我给蜜虫喂了一种麻痹果的种子，它们不会消化的，过不了多久就会排泄出来。",
            "nextDialogs": [
              "755060228"
            ]
          },
          "755060228": {
            "id": "755060228",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "种子落地后很快就能生长起来，变成小果丛，跟着果丛，我就能找到它们出没的地方啦。",
            "nextDialogs": [
              "755060229"
            ]
          },
          "755060229": {
            "id": "755060229",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "然后我就会它们把产下来的蜜珠收集起来处理，再用麻痹果把它们带回去。",
            "nextDialogs": [
              "755060230"
            ]
          },
          "755060230": {
            "id": "755060230",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "不过看来你们已经替我做了这些事，也没有伤害到它们的性命。真是谢谢你们。",
            "nextDialogs": [
              "755060231"
            ]
          },
          "755060231": {
            "id": "755060231",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来这些麻痹果子是这么回事啊。我还绞尽脑汁地想，会不会有什么阴谋呢…",
            "nextDialogs": [
              "755060232"
            ]
          },
          "755060232": {
            "id": "755060232",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "怎么了？给你添麻烦了吗？",
            "nextDialogs": [
              "755060233"
            ]
          },
          "755060233": {
            "id": "755060233",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那倒没有啦！放心放心！",
            "nextDialogs": [
              "755060234"
            ]
          },
          "755060234": {
            "id": "755060234",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "欧洛伦，我们会把清除了污染的蜜虫给你原原本本送回去的，请你放心吧。",
            "nextDialogs": [
              "755060235"
            ]
          },
          "755060235": {
            "id": "755060235",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "这样就再好不过了，它们都是很重要的生命，一定要好好对待才行。",
            "nextDialogs": [
              "755060236"
            ]
          },
          "755060236": {
            "id": "755060236",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "既然事情已经解决，那就再见啦，各位，欢迎你们下次去我那里做客，我带你们认识其他好朋友。",
            "nextDialogs": [
              "755060237"
            ]
          },
          "755060237": {
            "id": "755060237",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很期待，再见啦。",
            "nextDialogs": [
              "755060238"
            ]
          },
          "755060238": {
            "id": "755060238",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "呼~没想到事情是这样，欧洛伦这家伙，还挺会制造「惊喜」。",
            "nextDialogs": [
              "755060239"
            ]
          },
          "755060239": {
            "id": "755060239",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "#也谢谢你们啦，{NICKNAME}和派蒙，要不然我这一趟肯定很没劲。",
            "nextDialogs": [
              "755060240"
            ]
          },
          "755060240": {
            "id": "755060240",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "这个送给你们，是没被污染的燃素蜜珠，别有压力，不贵重的。",
            "nextDialogs": [
              "755060241"
            ]
          },
          "755060241": {
            "id": "755060241",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "就当留个纪念吧，为这些也在替纳塔战斗的小家伙们。"
          }
        }
      }
    },

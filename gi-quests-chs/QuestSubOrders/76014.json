            "speakerName": "Player",
            "text": "稍等，我先整备一下…",
            "nextDialogs": [
              "760142202"
            ]
          },
          "760142202": {
            "id": "760142202",
            "speakerId": 21903,
            "speakerName": "梅蒂",

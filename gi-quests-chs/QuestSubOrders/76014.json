            "id": "760141303",
            "speakerId": 21903,
            "speakerName": "梅蒂",
            "text": "#怎么样，准备好了吗，{M#大哥}{F#大姐}？"
          }
        }
      }
    },
    {
      "subId": "7601415",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760141524"
        ],
        "dialogs": {

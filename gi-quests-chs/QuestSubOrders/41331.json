    {
      "subId": "4133110",
      "subQuestName": "与若心对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413311001"
        ],
        "dialogs": {
          "413311001": {
            "id": "413311001",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "你回来了，辛苦你了，大过节的还在这忙前忙后的。",
            "nextDialogs": [
              "413311002"
            ]
          },
          "413311002": {
            "id": "413311002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应该做的。",
            "nextDialogs": [
              "413311003"
            ]
          },
          "413311003": {
            "id": "413311003",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "那我也得好好谢谢你才是。刚才我也编了不少的霄灯，想要和这轻策庄里的人一起放出去。",
            "nextDialogs": [
              "413311004"
            ]
          },
          "413311004": {
            "id": "413311004",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "你愿意的话，就晚上来门口找我吧，我们一起放放霄灯，过个好节。",
            "nextDialogs": [
              "413311005"
            ]
          },
          "413311005": {
            "id": "413311005",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "但那群孩子们也不知道跑到哪去了…我也走不动远路，没办法去找他们。",
            "nextDialogs": [
              "413311006"
            ]
          },
          "413311006": {
            "id": "413311006",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "如果可以的话，请你替我去找找那些孩子们，让他们过来吧，他们一向很喜欢放霄灯的。",
            "nextDialogs": [
              "413311007"
            ]
          },
          "413311007": {
            "id": "413311007",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "要是你能再顺便再叫些其他的人来，那就更好了，毕竟人越多越热闹嘛。"
          }
        }
      }
    },
    {
      "subId": "4133111",
      "subQuestName": "（废弃）与阿佑对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413312001"
        ],
        "dialogs": {
          "413312001": {
            "id": "413312001",
            "speakerId": 1620,
            "speakerName": "阿佑",
            "text": "哎呀，又没抓到…",
            "nextDialogs": [
              "413312002"
            ]
          },
          "413312002": {
            "id": "413312002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于放霄灯的事…",
            "nextDialogs": [
              "413312003"
            ]
          },
          "413312003": {
            "id": "413312003",
            "speakerId": 1620,
            "speakerName": "阿佑",
            "text": "晚上可以放霄灯吗？太好了！我要去告诉哥哥。",
            "nextDialogs": [
              "413312004"
            ]
          },
          "413312004": {
            "id": "413312004",
            "speakerId": 1620,
            "speakerName": "阿佑",
            "text": "我听爷爷说，放霄灯的时候，可以许愿望的对吧？",
            "nextDialogs": [
              "413312005"
            ]
          },
          "413312005": {
            "id": "413312005",
            "speakerId": 1620,
            "speakerName": "阿佑",
            "text": "我有个很重要的愿望要许…",
            "nextDialogs": [
              "413312006"
            ]
          },
          "413312006": {
            "id": "413312006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是什么愿望？",
            "nextDialogs": [
              "413312007"
            ]
          },
          "413312007": {
            "id": "413312007",
            "speakerId": 1620,
            "speakerName": "阿佑",
            "text": "是我…哎呀，不行不行，爷爷说愿望说出来就不灵了。",
            "nextDialogs": [
              "413312008"
            ]
          },
          "413312008": {
            "id": "413312008",
            "speakerId": 1620,
            "speakerName": "阿佑",
            "text": "我等会就去告诉哥哥，他一定也有愿望想许的…",
            "nextDialogs": [
              "413312009"
            ]
          },
          "413312009": {
            "id": "413312009",
            "speakerId": 1620,
            "speakerName": "阿佑",
            "text": "嗯…等一下，愿望好像是要写在霄灯上的，我直接许的话，会不会不灵啊…"
          }
        }
      }
    },
    {
      "subId": "4133112",
      "subQuestName": "与罗小妹对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413312101"
        ],
        "dialogs": {
          "413312101": {
            "id": "413312101",
            "speakerId": 2136,
            "speakerName": "罗小妹",
            "text": "仙人哥哥会不会过海灯节呢…",
            "nextDialogs": [
              "413312102"
            ]
          },
          "413312102": {
            "id": "413312102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于放霄灯的事…",
            "nextDialogs": [
              "413312103"
            ]
          },
          "413312103": {
            "id": "413312103",
            "speakerId": 2136,
            "speakerName": "罗小妹",
            "text": "嗯…要放霄灯吗？我知道啦。",
            "nextDialogs": [
              "413312104"
            ]
          },
          "413312104": {
            "id": "413312104",
            "speakerId": 2136,
            "speakerName": "罗小妹",

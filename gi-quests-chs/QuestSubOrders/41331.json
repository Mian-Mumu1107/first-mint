      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4133106",
      "subQuestName": "与凯叔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413310601"
        ],
        "dialogs": {
          "413310601": {
            "id": "413310601",
            "speakerId": 2300,
            "speakerName": "凯叔",
            "text": "嗯？找我有什么事吗？",
            "nextDialogs": [
              "413310602"
            ]
          },
          "413310602": {
            "id": "413310602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于桌椅的事…",
            "nextDialogs": [
              "413310603"
            ]
          },
          "413310603": {
            "id": "413310603",
            "speakerId": 2300,
            "speakerName": "凯叔",
            "text": "桌椅啊，我记得，早就已经准备好了。",
            "nextDialogs": [
              "413310604"
            ]
          },
          "413310604": {
            "id": "413310604",
            "speakerId": 2300,
            "speakerName": "凯叔",
            "text": "嗯…店里面应该还有一些，算了，都一起搬出来吧。",
            "nextDialogs": [
              "413310605"
            ]
          },
          "413310605": {
            "id": "413310605",
            "speakerId": 2300,
            "speakerName": "凯叔",
            "text": "这就行了，差不多够用了。",
            "nextDialogs": [
              "413310606"
            ]
          },
          "413310606": {
            "id": "413310606",
            "speakerId": 2300,
            "speakerName": "凯叔",
            "text": "不过，没想到你还特意过来帮忙…",
            "nextDialogs": [
              "413310607"
            ]
          },
          "413310607": {
            "id": "413310607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应该做的。",
            "nextDialogs": [
              "413310608"
            ]
          },
          "413310608": {
            "id": "413310608",
            "speakerId": 2300,
            "speakerName": "凯叔",
            "text": "嗬，你这年轻人倒是不错…不过这大过节的，你怎么不回家里去？",
            "nextDialogs": [
              "413310611"
            ]
          },
          "413310611": {
            "id": "413310611",
            "speakerId": 2300,
            "speakerName": "凯叔",
            "text": "没事没事，我不多问了，你肯定也有自己的原因吧。",
            "nextDialogs": [
              "413310612"
            ]
          },
          "413310612": {
            "id": "413310612",
            "speakerId": 2300,
            "speakerName": "凯叔",
            "text": "不过你要是愿意，留在这过节也行，反正这里人也挺多的，也算热闹。"
          }
        }
      }
    },
    {
      "subId": "4133107",
      "subQuestName": "（隐藏）刷出桌椅$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413310701"
        ],
        "dialogs": {
          "413310701": {
            "id": "413310701",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "唉…也不知道那些在外奔波的那些孩子们，什么时候能得空休息一下…"
          }
        }
      }
    },
    {
      "subId": "4133115",
      "subQuestName": "小白闲置对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413313701"
        ],
        "dialogs": {
          "413313701": {
            "id": "413313701",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "这么多人在一起，倒是也有几分节日的气氛了。",
            "nextDialogs": [
              "413313702"
            ]
          },
          "413313702": {
            "id": "413313702",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "呵呵，我们就一起放了这盏霄灯吧。",
            "nextDialogs": [
              "413313703"
            ]
          },
          "413313703": {
            "id": "413313703",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "希望新的一年里，大家都能身体健康，万事如意。",
            "nextDialogs": [
              "413313704"
            ]
          },
          "413313704": {
            "id": "413313704",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "还有在外奔波的那些孩子们，也能万事如意啊…",
            "nextDialogs": [
              "413313705"
            ]
          },
          "413313705": {
            "id": "413313705",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "好了若心奶奶，再不去吃，我准备的那些饭菜可都要凉了。",
            "nextDialogs": [
              "413313706"
            ]
          },
          "413313706": {
            "id": "413313706",
            "speakerId": 1616,
            "speakerName": "小六",
            "text": "哇，有好吃的！",
            "nextDialogs": [
              "413313707"
            ]
          },
          "413313707": {
            "id": "413313707",
            "speakerId": 2304,
            "speakerName": "东东",
            "text": "奶奶，那我们去啦！",
            "nextDialogs": [
              "413313708"
            ]
          },
          "413313708": {
            "id": "413313708",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "你们这群孩子啊…好，好，快去吧。",
            "nextDialogs": [
              "413313709"
            ]
          },
          "413313709": {
            "id": "413313709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您不去吗？",
            "nextDialogs": [
              "413313710"
            ]
          },
          "413313710": {
            "id": "413313710",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "我？我不急，我想再看会霄灯。",
            "nextDialogs": [
              "413313711"
            ]
          },
          "413313711": {
            "id": "413313711",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "对了孩子，这些给你，收下吧，谢谢你在这里忙前忙后的帮忙。",
            "nextDialogs": [
              "413313712"
            ]
          },
          "413313712": {
            "id": "413313712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢奶奶。",
            "nextDialogs": [
              "413313713"
            ]
          },
          "413313713": {
            "id": "413313713",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "不用谢，我看你的年纪也不大，这样子在外面跑，一定很辛苦吧，唉…",
            "nextDialogs": [
              "413313714"
            ]
          },
          "413313714": {
            "id": "413313714",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "不然，你就在这再待一会，和大家一起过个节吧。",
            "nextDialogs": [
              "413313715"
            ]
          },
          "413313715": {
            "id": "413313715",
            "speakerId": 1621,
            "speakerName": "若心",
            "text": "奔波了一整年，能歇息一会总是好的…"
          }
        }
      }
    },

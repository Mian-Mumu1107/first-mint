    {
      "subId": "4133102",
      "subQuestName": "与若心对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413310201"
        ],
        "dialogs": {
          "413310201": {
            "id": "413310201",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "又到了海灯节了，唉…",
            "nextDialogs": [
              "413310202"
            ]
          },
          "413310202": {
            "id": "413310202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "您在担心什么？",
            "nextDialogs": [
              "413310203"
            ]
          },
          "413310203": {
            "id": "413310203",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "到海灯节啦，按理说，是该热热闹闹地过。",
            "nextDialogs": [
              "413310204"
            ]
          },
          "413310204": {
            "id": "413310204",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "但是这轻策庄里…老的老，小的小。",
            "nextDialogs": [
              "413310205"
            ]
          },
          "413310205": {
            "id": "413310205",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "去城里工作的那些孩子们，要么是说工作忙请不到假…",
            "nextDialogs": [
              "413310206"
            ]
          },
          "413310206": {
            "id": "413310206",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "要么就是离得远，怎么样都赶不及回来。",
            "nextDialogs": [
              "413310207"
            ]
          },
          "413310207": {
            "id": "413310207",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "明明是个大家伙聚在一起，团团圆圆热热闹闹的节日，结果…",
            "nextDialogs": [
              "413310208"
            ]
          },
          "413310208": {
            "id": "413310208",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "我也理解他们在外的难处，但是大过节的，唉…",
            "nextDialogs": [
              "413310209"
            ]
          },
          "413310209": {
            "id": "413310209",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "哎呀，不说了，不说了。大过节的可不能这样…",
            "nextDialogs": [
              "413310210"
            ]
          },
          "413310210": {
            "id": "413310210",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "对了，如果你愿意的话，能去帮一下小白吗？",
            "nextDialogs": [
              "413310211"
            ]
          },
          "413310211": {
            "id": "413310211",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "那孩子说想要给大家置办桌好菜，正在那忙呢，我担心她一个人会有点忙不过来…",
            "nextDialogs": [
              "413310214"
            ]
          },
          "413310214": {
            "id": "413310214",
            "speakerId": 2306,
            "speakerName": "若心",
            "text": "那就拜托你了，实在是太谢谢了…"
          }
        }
      }
    },
    {
      "subId": "4133103",
      "subQuestName": "与小白对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413310301"
        ],
        "dialogs": {
          "413310301": {
            "id": "413310301",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "还差这么多东西吗…",
            "nextDialogs": [
              "413310302"
            ]
          },
          "413310302": {
            "id": "413310302",
            "speakerId": 1002,
            "speakerName": "<UNKNOWN>",
            "text": "我来帮忙置办吧。",
            "nextDialogs": [
              "413310303"
            ]
          },
          "413310303": {
            "id": "413310303",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "咦？哦…你愿意帮忙那就最好了，我正发愁怎么置办食材呢。",
            "nextDialogs": [
              "413310304"
            ]
          },
          "413310304": {
            "id": "413310304",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "我看看…请你帮我准备三份兽肉和三份禽肉吧。",
            "nextDialogs": [
              "413310305"
            ]
          },
          "413310305": {
            "id": "413310305",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "其余的材料，我会想办法准备的。"
          }
        }
      }
    },
    {
      "subId": "4133105",
      "subQuestName": "（隐藏）是否已交付食材$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413310501"
        ],
        "dialogs": {
          "413310501": {
            "id": "413310501",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "这些就够了…对了，我还要请你帮个忙，请帮我去和凯叔说一声，让他把桌椅板凳什么的都搬出来吧。",
            "nextDialogs": [
              "413310502"
            ]
          },
          "413310502": {
            "id": "413310502",
            "speakerId": 2138,
            "speakerName": "小白",
            "text": "我准备做的菜还挺多的，到时候再把桌椅搬出来的话，说不定有些菜都要凉了。"
          }
        }
      }
    },
    {
      "subId": "4133104",

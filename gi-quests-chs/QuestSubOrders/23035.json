{
  "lineCounts": {
    "Black Screen": 1,
    "Player": 20,
    "福本": 38,
    "赛诺": 18
  },
  "subQuests": [
    {
      "subId": "2303501",
      "subQuestName": "与福本对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230350101"
        ],
        "dialogs": {
          "230350101": {
            "id": "230350101",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "唉，好想回稻妻…我怎么会遇见这种事…",
            "nextDialogs": [
              "230350104"
            ]
          },
          "230350104": {
            "id": "230350104",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "旅行者？唉，别提小说了，我觉得那群做「七圣召唤」的人都要撑不住了。",
            "nextDialogs": [
              "230350105"
            ]
          },
          "230350105": {
            "id": "230350105",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "据那个和我关系还可以的学者说，做「七圣召唤」的时候，他们遇见了各种各样堪称莫名其妙的问题…",
            "nextDialogs": [
              "230350106"
            ]
          },
          "230350106": {
            "id": "230350106",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "比如，一个室罗婆耽学院的学者有一天突然提出了一个问题。",
            "nextDialogs": [
              "230350107"
            ]
          },
          "230350107": {
            "id": "230350107",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "他说，卡面上的卡牌效果描述太长，也许会让不习惯阅读长文本的人不想玩「七圣召唤」。",
            "nextDialogs": [
              "230350108"
            ]
          },
          "230350108": {
            "id": "230350108",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "学者们都习惯阅读长文本，对这个问题不敏感。但也许会有玩家不喜欢读长文本，甚至因此不玩「七圣召唤」。",
            "nextDialogs": [
              "230350109"
            ]
          },
          "230350109": {
            "id": "230350109",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "所以他建议，能不能把部分卡牌上的文本字数缩减一半，以方便玩家阅读。"
          }
        }
      }
    },
    {
      "subId": "2303502",
      "subQuestName": "前往普斯帕咖啡馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2303503",
      "subQuestName": "前往普斯帕咖啡馆与福本会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230350301"
        ],
        "dialogs": {
          "230350301": {
            "id": "230350301",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "嘘…那，那是不是赛诺先生？",
            "nextDialogs": [
              "230350302"
            ]
          },
          "230350302": {
            "id": "230350302",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "看他的装扮，看他的发型，还有那个发色…简直是卡牌游戏小说的最佳主角啊！",
            "nextDialogs": [
              "230350304",
              "230350306"
            ]
          },
          "230350304": {
            "id": "230350304",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "哎呀，你就相信我在小说市场里的直觉吧。但现在不是说这个的时候…",
            "nextDialogs": [
              "230350309"
            ]
          },
          "230350309": {
            "id": "230350309",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "旅行者，请赛诺先生为我做模特的事…就拜托你了！"
          },
          "230350306": {
            "id": "230350306",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "真的吗？那正好啊，我正在筹备《召唤王》的第三部小说，这次我不打算根据「七圣召唤」的玩法写了。",
            "nextDialogs": [
              "230350307"
            ]
          },
          "230350307": {
            "id": "230350307",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "我决定要完全原创一种对战方式，比如…所有卡牌都悬浮在场地里，牌手要一边对战一边不断搜集卡牌，同时还要阻止对手搜集卡牌…",
            "nextDialogs": [
              "230350308"
            ]
          },
          "230350308": {
            "id": "230350308",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "哈哈哈！光是想想就觉得很有意思！但现在不是说这个的时候…"
          }
        }
      }
    },
    {
      "subId": "2303504",
      "subQuestName": "与赛诺对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230350401"
        ],
        "dialogs": {
          "230350401": {
            "id": "230350401",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "…唔，这样的卡牌组合也许不错。",
            "nextDialogs": [
              "230350402"
            ]
          },
          "230350402": {
            "id": "230350402",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "但这些卡牌，应对快速进攻的能力是不是太弱了…",
            "nextDialogs": [
              "230350403"
            ]
          },
          "230350403": {
            "id": "230350403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "赛诺，你在做什么呢？",
            "nextDialogs": [
              "230350404"
            ]
          },
          "230350404": {
            "id": "230350404",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "#{NICKNAME}？没想到会在这里遇见你。",
            "nextDialogs": [
              "230350405"
            ]
          },
          "230350405": {
            "id": "230350405",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "我正在试着构筑一套进攻速度偏慢的「七圣召唤」卡组呢。",
            "nextDialogs": [
              "230350406"
            ]
          },
          "230350406": {
            "id": "230350406",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "在我的设想里，使用这套卡牌的牌手会拥有丰富的资源，和各类强大的卡牌…",
            "nextDialogs": [
              "230350407"
            ]
          },
          "230350407": {
            "id": "230350407",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "但说实话，这样的卡组还挺难构筑的…",
            "nextDialogs": [
              "230350408"
            ]
          },
          "230350408": {
            "id": "230350408",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "现在「七圣召唤」的玩家群体里，一部分玩家喜欢使用进攻速度偏快的卡组。",
            "nextDialogs": [
              "230350409"
            ]
          },
          "230350409": {
            "id": "230350409",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "在游戏刚开始的时候，就一口气打出大量的卡牌发动攻击，用最快的速度击败对手。",
            "nextDialogs": [
              "230350410"
            ]
          },
          "230350410": {
            "id": "230350410",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "不过我却不喜欢这种战术。我喜欢的对决战术，是不断用各种方式积蓄资源…",
            "nextDialogs": [
              "230350411"
            ]
          },
          "230350411": {
            "id": "230350411",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "把握住每一个时机，不断累积优势，稳稳地取得最后的胜利…",
            "nextDialogs": [
              "230350412"
            ]
          },
          "230350412": {
            "id": "230350412",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "没错！就是这样！太好了，太好了！您简直和我小说里的主角一模一样！",
            "nextDialogs": [
              "230350413"
            ]
          },
          "230350413": {
            "id": "230350413",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "抱歉！呃…我是…",
            "nextDialogs": [
              "230350416"
            ]
          },
          "230350416": {
            "id": "230350416",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "您好，大风纪官，那个…我猜您应该没听说过我…",
            "nextDialogs": [
              "230350417"
            ]
          },
          "230350417": {
            "id": "230350417",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "我看过你写的小说，很不错。",
            "nextDialogs": [
              "230350418"
            ]
          },
          "230350418": {
            "id": "230350418",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "那真是荣幸！",
            "nextDialogs": [
              "230350419"
            ]
          },
          "230350419": {
            "id": "230350419",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "这部小说最让我印象深刻的是，小说主角每次陷入劣势的时候，总是会通过各种方式取得并不存在于卡组里的卡，然后再克敌制胜。",
            "nextDialogs": [
              "230350420"
            ]
          },
          "230350420": {
            "id": "230350420",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "我理解这是情节需要，但这种获胜方式无疑有些背离了「七圣召唤」的游戏本质。",
            "nextDialogs": [
              "230350421"
            ]
          },
          "230350421": {
            "id": "230350421",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "哎呀，这个…我虽然经常玩「七圣召唤」，但玩的水平也并不高…而且，如果真的用竞技思维来写小说里的卡牌对决，那写出来也不会太好看啊。",
            "nextDialogs": [
              "230350422"
            ]
          },
          "230350422": {
            "id": "230350422",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "唔，这样吗？那么正好，我刚刚组好了两套卡组，我们可以在这里打几盘「七圣召唤」，你说不定能找到一些灵感。"
          }
        }
      }
    },
    {
      "subId": "2303505",
      "subQuestName": "为赛诺拍摄画片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230350501"
        ],
        "dialogs": {
          "230350501": {
            "id": "230350501",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "飞快地给赛诺拍摄了数张画片…"
          }
        }
      }
    },
    {
      "subId": "2303506",
      "subQuestName": "与福本对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230350601"
        ],
        "dialogs": {
          "230350601": {
            "id": "230350601",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "真是帮大忙了，这下朝雾小姐一定能画出一幅很棒的插画！",
            "nextDialogs": [
              "230350602"
            ]
          },
          "230350602": {
            "id": "230350602",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "太感谢您了，赛诺先生，等这本小说出版了之后，我一定尽快给您送一本来。",
            "nextDialogs": [
              "230350603"
            ]
          },
          "230350603": {
            "id": "230350603",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "呃，赛诺先生，您手里拿着的两副牌是…",
            "nextDialogs": [
              "230350604"
            ]
          },
          "230350604": {
            "id": "230350604",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "之前你不是答应了，要和我打几盘「七圣召唤」吗？",
            "nextDialogs": [
              "230350605"
            ]
          },
          "230350605": {
            "id": "230350605",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "啊？！我，我玩得不是非常好，那个…旅行者！你一定玩得比我好！",
            "nextDialogs": [
              "230350608"
            ]
          },
          "230350608": {
            "id": "230350608",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "那这件事就这么定了，来，这副偏向于快速攻击的卡组给你。",
            "nextDialogs": [
              "230350609"
            ]
          },
          "230350609": {
            "id": "230350609",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "而我就用这套进攻速度偏慢的牌，来看看怎么应对你的攻击。",
            "nextDialogs": [
              "230350610"
            ]
          },
          "230350610": {
            "id": "230350610",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "我一定尽最大的努力，赛诺先生…"
          }
        }
      }
    },
    {
      "subId": "2303507",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230350701"
        ],
        "dialogs": {
          "230350701": {
            "id": "230350701",
            "speakerId": 12717,
            "speakerName": "福本",
            "text": "赛诺先生，您打牌的风格可真是…稳扎稳打啊…",
            "nextDialogs": [
              "230350702"
            ]
          },
          "230350702": {
            "id": "230350702",
            "speakerId": 1058,
            "speakerName": "赛诺",
            "text": "这只是一种临场的对决策略而已。"
          }
        }
      }
    }
  ]
}
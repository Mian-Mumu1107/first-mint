          },
          "200160303": {
            "id": "200160303",
            "speakerId": 1001,
            "speakerName": "害怕的舒特",
            "text": "这是餐费，给你。这味道闻起来真香。",
            "nextDialogs": [
              "200160304"
            ]
          },
          "200160304": {
            "id": "200160304",
            "speakerId": 1001,
            "speakerName": "害怕的舒特",
            "text": "想要去冒险，一定要吃饱才行，我要慢点吃，慢点吃…"
          }
        }
      }
    },

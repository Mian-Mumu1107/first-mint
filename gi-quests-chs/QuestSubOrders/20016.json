    {
      "subId": "2001601",
      "subQuestName": "前往猎鹿人餐馆询问莎拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200160101"
        ],
        "dialogs": {
          "200160101": {
            "id": "200160101",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "餐品外送订单",
            "nextDialogs": [
              "200160102"
            ]
          },
          "200160102": {
            "id": "200160102",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "旅行者！你来的正好…",
            "nextDialogs": [
              "200160103"
            ]
          },
          "200160103": {
            "id": "200160103",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "抱歉，虽然你饿着肚子，但是能不能请你帮我个忙？",
            "nextDialogs": [
              "200160104"
            ]
          },
          "200160104": {
            "id": "200160104",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "最近的送餐订单越来越多，我一般是先把订单按照地区分好，然后再标好是谁订的。",
            "nextDialogs": [
              "200160105"
            ]
          },
          "200160105": {
            "id": "200160105",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "但是这份<color=#00E1FFFF>嘟嘟莲海鲜羹</color>的订餐人标签被我弄丢了，只知道订餐的人在清泉镇。",
            "nextDialogs": [
              "200160106"
            ]
          },
          "200160106": {
            "id": "200160106",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "你能帮我把这份<color=#00E1FFFF>嘟嘟莲海鲜羹</color>送去清泉镇，再找找是谁订的吗？",
            "nextDialogs": [
              "200160108",
              "200160111"
            ]
          },
          "200160108": {
            "id": "200160108",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "等你回来的时候，会有一顿大餐做回报的！",
            "nextDialogs": [
              "200160109"
            ]
          },
          "200160109": {
            "id": "200160109",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "拜托了！"
          },
          "200160111": {
            "id": "200160111",
            "speakerId": 1000,
            "speakerName": "莎拉",
            "text": "等你帮完我的忙之后，我，我就请你吃猎鹿人特制料理，就拜托你了！"
          }
        }
      }
    },

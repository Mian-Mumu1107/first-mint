        "dialogs": {
          "730240101": {
            "id": "730240101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "哎呀，真是帮大忙了！谢谢你们。",
            "nextDialogs": [
              "730240102"
            ]
          },
          "730240102": {
            "id": "730240102",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "如二位所见，我是这边的巡林官。名字嘛，叫拉娜。",
            "nextDialogs": [
              "730240104",
              "730240106"
            ]
          },
          "730240104": {
            "id": "730240104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我的名字叫派蒙！我们是从别的国度来的。",
            "nextDialogs": [
              "730240107"
            ]
          },
          "730240107": {
            "id": "730240107",
            "speakerId": 16701,
            "speakerName": "拉娜",
            "text": "原来如此。嗯…从穿着打扮来看，确实不像是森林的子民…也不像是从黄沙里来的。透气性看起来很好，很适合在须弥行动。",
            "nextDialogs": [
              "730240108"
            ]
          },
          "730240108": {
            "id": "730240108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？这么说来，既然拉娜是巡林官的话…"
          },
          "730240106": {
            "id": "730240106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯！我叫派蒙，{M#他}{F#她}是{NICKNAME}。"
          }
        }
      }
    },

    {
      "subId": "7104413",
      "subQuestName": "test隐藏-搞定三个楔子$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710441301"
        ],
        "dialogs": {
          "710441301": {
            "id": "710441301",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "欸，是你呀！你好！",
            "nextDialogs": [
              "710441302"
            ]
          },
          "710441302": {
            "id": "710441302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是沐宁介绍我来的，这里是他的…",
            "nextDialogs": [
              "710441303"
            ]
          },
          "710441303": {
            "id": "710441303",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "哈哈，别管那纸条啦！我早认出你来了！",
            "nextDialogs": [
              "710441304"
            ]
          },
          "710441304": {
            "id": "710441304",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "他呀，天天就喜欢给人摆架子，开条子，什么小事都要走个流程…显得自己是个什么大人物一样。我可不管那个…",
            "nextDialogs": [
              "710441305"
            ]
          },
          "710441305": {
            "id": "710441305",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "#毕竟{NICKNAME}的大名早就传遍冒险家协会了；更不用提你为璃月做的一切，我们都看在眼里。",
            "nextDialogs": [
              "710441309",
              "710441308"
            ]
          },
          "710441309": {
            "id": "710441309",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "那是当然，协会的许多新人冒险家都听霞姐讲过你在龙脊雪山的探险故事——嘿嘿，也包括我在内啦。",
            "nextDialogs": [
              "710441310"
            ]
          },
          "710441310": {
            "id": "710441310",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "穿越雪暴在寒冬极境之中开辟通路，在冰霜之下发掘被遗忘的古王国，登上险峻峰顶，以肉体凡躯直面宏伟无情的异变…",
            "nextDialogs": [
              "710441311"
            ]
          },
          "710441311": {
            "id": "710441311",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "#真的，{NICKNAME}前辈经历的事件也好，克服的障碍也好，发掘的真相也好，终归一句话…这才叫冒险！"
          },
          "710441308": {
            "id": "710441308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不愧是传说中的{NICKNAME}和派蒙！"
          }
        }
      }
    },
    {
      "subId": "7104414",
      "subQuestName": "借助「笼状物」破坏其余三座「磐键」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710441401"
        ],
        "dialogs": {
          "710441401": {
            "id": "710441401",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "欸，是你呀！你好！",
            "nextDialogs": [
              "710441402"
            ]
          },
          "710441402": {
            "id": "710441402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是沐宁介绍我来的，这里是他的…",
            "nextDialogs": [
              "710441403"
            ]
          },
          "710441403": {
            "id": "710441403",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "哈哈，别管那纸条啦！我早认出你来了！",
            "nextDialogs": [
              "710441404"
            ]
          },
          "710441404": {
            "id": "710441404",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "他呀，天天就喜欢给人摆架子，开条子，什么小事都要走个流程…显得自己是个什么大人物一样。我可不管那个…",
            "nextDialogs": [
              "710441405"
            ]
          },
          "710441405": {
            "id": "710441405",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "#毕竟{NICKNAME}的大名早就传遍冒险家协会了；更不用提你为璃月做的一切，我们都看在眼里。",
            "nextDialogs": [
              "710441409",
              "710441408"
            ]
          },
          "710441409": {
            "id": "710441409",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "哈哈，就比方说两位在群玉阁上大战海魔的事迹…虽然我没有现场目睹，但评书我可一场都没落下过！"
          },
          "710441408": {
            "id": "710441408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不愧是传说中的{NICKNAME}和派蒙！"
          }
        }
      }
    },
    {
      "subId": "7104415",
      "subQuestName": "test隐藏-楔子2的cutscene$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710441501"
        ],
        "dialogs": {
          "710441501": {
            "id": "710441501",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "放心吧，我不会到处乱跑的。把流明石触媒取回来就好。"
          }
        }
      }
    },
    {
      "subId": "7104416",
      "subQuestName": "借助「笼状物」破坏其余三座「磐键」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710441601"
        ],
        "dialogs": {
          "710441601": {
            "id": "710441601",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "唔，虽然我也不是很懂「磐键」的原理…或许可以从那边的笼状岩元素聚合物入手试试看？",
            "nextDialogs": [
              "710441602"
            ]
          },
          "710441602": {
            "id": "710441602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那是什么东西？",
            "nextDialogs": [
              "710441603"
            ]
          },
          "710441603": {
            "id": "710441603",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "这些奇怪的聚合物近来一直在困扰着总务司…它们是近两年从层岩巨渊的基岩中蔓生出来的，性质上与下面的「东西」很相近。",
            "nextDialogs": [
              "710441604"
            ]
          },
          "710441604": {
            "id": "710441604",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "之所以这样说，是因为它们能够受到异变的影响，发生某种形式的崩解。",
            "nextDialogs": [
              "710441605"
            ]
          },
          "710441605": {
            "id": "710441605",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "后来，辉山厅的调查员发现，它们一直在吸收周围的岩元素能量，慢慢地削弱着「磐键」的结构…",
            "nextDialogs": [
              "710441606"
            ]
          },
          "710441606": {
            "id": "710441606",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "很是邪门，就像在有意识地破坏封印阵法一样。",
            "nextDialogs": [
              "710441607"
            ]
          },
          "710441607": {
            "id": "710441607",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "我们每隔半个月就会清理一次…但这些怪东西很快又会再度蔓生出来，而且近来愈发频繁了。",
            "nextDialogs": [
              "710441608"
            ]
          },
          "710441608": {
            "id": "710441608",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "或许下面的那「东西」开始变得不安分了吧…这也是七星之所以派我们下去调查的原因。"
          }
        }
      }
    },
    {
      "subId": "7104417",
      "subQuestName": "test隐藏-楔子3的cutscene$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710441701"
        ],
        "dialogs": {
          "710441701": {
            "id": "710441701",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "请暂时不要和我说话，不然我又会受处分的…",
            "nextDialogs": [
              "710441702"
            ]
          },
          "710441702": {
            "id": "710441702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「又」…？",
            "nextDialogs": [
              "710441703"
            ]
          },
          "710441703": {
            "id": "710441703",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "不要在意那种小事啦…"
          }
        }
      }
    },
    {
      "subId": "7104418",
      "subQuestName": "借助「笼状物」破坏其余三座「磐键」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710441801"
        ],
        "dialogs": {
          "710441801": {
            "id": "710441801",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "好厉害…不愧是前辈！这应该就是最后一座了，封锁层岩巨渊的阵法应该已经失效了。我们随时可以下去探索啦。",
            "nextDialogs": [
              "710441802"
            ]
          },
          "710441802": {
            "id": "710441802",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "唔…不过在那之前，还是要先跟沐宁打声招呼才行…哼，那家伙又要摆臭脸教训我们咯。"
          }
        }
      }
    },
    {
      "subId": "7104419",
      "subQuestName": "test隐藏-楔子4的cutscene$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710441901"
        ],
        "dialogs": {
          "710441901": {
            "id": "710441901",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "瞧我说什么来着！你果然没有老老实实看守仓库！",
            "nextDialogs": [
              "710441902"
            ]
          },
          "710441902": {
            "id": "710441902",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "这下事情闹大了，你想怎么收场呀，志琼？你能负得了擅自解除阵法的责任吗？",
            "nextDialogs": [
              "710441903"
            ]
          },
          "710441903": {
            "id": "710441903",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "啊，你来了。唉…擅自破坏「磐键」的事情，你怎么解释？",
            "nextDialogs": [
              "710441906"
            ]
          },
          "710441906": {
            "id": "710441906",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "你…！哼，先说好责任由你自负，剩下的等七星怪罪下来再说吧。",
            "nextDialogs": [
              "710441907"
            ]
          },
          "710441907": {
            "id": "710441907",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "嘿嘿，没关系的。沐宁这人就是这样，只会对那些不管事的人发脾气…别看他性子急，人还是不坏的。",
            "nextDialogs": [
              "710441908"
            ]
          },
          "710441908": {
            "id": "710441908",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "不用管他的臭脾气。等你准备好，我就叫上大家一同随你下矿。",
            "nextDialogs": [
              "710441918"
            ]
          },
          "710441918": {
            "id": "710441918",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "我们这次的目的，是进入层岩巨渊的最深层，测绘地图，以及…嗯，调查层岩巨渊异变的源头。",
            "nextDialogs": [
              "710441909"
            ]
          },
          "710441909": {
            "id": "710441909",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "啊！抱歉，差点忘了…欢迎加入层岩巨渊勘探队！",
            "nextDialogs": [
              "710441910"
            ]
          },
          "710441910": {
            "id": "710441910",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "请容我浪费一点时间，介绍一下勘探队的成员吧：",
            "nextDialogs": [
              "710441911"
            ]
          },
          "710441911": {
            "id": "710441911",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "首先是海迪夫，从须弥来的特约学者。主要研究方向是矿产和生物学。他是勘探队的主要负责人…嗯，我是说科学和财政方面。",
            "nextDialogs": [
              "710441912"
            ]
          },
          "710441912": {
            "id": "710441912",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "然后，是瑾武姐，她是我们的安全技术员。负责设备修理和维护，我们的安全由她来保障。",
            "nextDialogs": [
              "710441913"
            ]
          },
          "710441913": {
            "id": "710441913",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "还有…呃，塔列辛。是蒙德来的吟游诗人…不知为什么坚持要和我们一同下矿。",
            "nextDialogs": [
              "710441914"
            ]
          },
          "710441914": {
            "id": "710441914",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "或许在下矿以后，我们还会遇见意料之外的新伙伴吧？哈哈，谁知道呢！",
            "nextDialogs": [
              "710441915"
            ]
          },
          "710441915": {
            "id": "710441915",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "最后，我呢，是亲力亲为的勘查员！负责为大家探路以及绘制地图！和前辈共勉！",
            "nextDialogs": [
              "710441916"
            ]
          },
          "710441916": {
            "id": "710441916",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "等前辈准备好了，就去矿坑边的起重机那里吧…以前是运货用的，不过吊几个人上下矿也完全不是问题。",
            "nextDialogs": [
              "710441917"
            ]
          },
          "710441917": {
            "id": "710441917",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "唔，对哦…既然前辈有「风之翼」，即使不用起重机也可以很方便地下去吧？"
          }
        }
      }
    },

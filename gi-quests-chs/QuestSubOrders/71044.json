    {
      "subId": "7104405",
      "subQuestName": "test隐藏-与阿牧了解层岩巨渊的情况$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710440501"
        ],
        "dialogs": {
          "710440501": {
            "id": "710440501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于层岩巨渊…",
            "nextDialogs": [
              "710440502"
            ]
          },
          "710440502": {
            "id": "710440502",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "对了，关于层岩巨渊…如果你们暂时不想离开的话，就请四处转转吧。但请一定遵守璃月的律法。",
            "nextDialogs": [
              "710440503"
            ]
          },
          "710440503": {
            "id": "710440503",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "顺便一提，有的地方，我强烈不建议你们接近。",
            "nextDialogs": [
              "710440504"
            ]
          },
          "710440504": {
            "id": "710440504",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "就比如说，层岩巨渊中央的大矿井被布下了「七星阵法」…呃，顾名思义，就是七星布下的阵法。",
            "nextDialogs": [
              "710440505"
            ]
          },
          "710440505": {
            "id": "710440505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这解释还挺…简单明确的。",
            "nextDialogs": [
              "710440506"
            ]
          },
          "710440506": {
            "id": "710440506",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "阵法的弱点…呃，节点，在于周围的「磐键」。它们由「七星」之手亲自布下，串联并固定了阵法中流动的能量。",
            "nextDialogs": [
              "710440507"
            ]
          },
          "710440507": {
            "id": "710440507",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "近来磐键周围的岩元素聚合物异常增生，就像下面的「东西」在渴望冒出头来一样…",
            "nextDialogs": [
              "710440508"
            ]
          },
          "710440508": {
            "id": "710440508",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "…算了，请不要在意我的自言自语。总之事情就是这样，请一定、一定不要靠近「七星阵法」，也不要想着下去探险什么的。",
            "nextDialogs": [
              "710440509"
            ]
          },
          "710440509": {
            "id": "710440509",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "「磐键」的结构也完全没有发生衰变，周围的岩元素聚合物自然不会产生奇奇怪怪的反应，所以请别想从中下功夫。",
            "nextDialogs": [
              "710440510"
            ]
          },
          "710440510": {
            "id": "710440510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是…",
            "nextDialogs": [
              "710440511"
            ]
          },
          "710440511": {
            "id": "710440511",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "哼，我知道你想问什么。",
            "nextDialogs": [
              "710440512"
            ]
          },
          "710440512": {
            "id": "710440512",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "下面可不会有什么珍奇异宝，也不会有什么史前化石，更不会有什么超级巨大古代遗迹的…请你们不要抱虚假的期待。",
            "nextDialogs": [
              "710440513"
            ]
          },
          "710440513": {
            "id": "710440513",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你这么说就好可疑！",
            "nextDialogs": [
              "710440514"
            ]
          },
          "710440514": {
            "id": "710440514",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "下面连蘑菇都不会长的！不会有实现人愿望的石头，更不会有只靠吃蘑菇就能增肌的水手！请你们不要抱有虚假的期待！",
            "nextDialogs": [
              "710440515"
            ]
          },
          "710440515": {
            "id": "710440515",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，知道啦！不要这么凶嘛！",
            "nextDialogs": [
              "710440520",
              "710440518"
            ]
          },
          "710440520": {
            "id": "710440520",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "我建议你们先去找志琼聊一聊，她是受雇于总务司的冒险家，曾经在这里做过矿工，对层岩巨渊的地形了如指掌…",
            "nextDialogs": [
              "710440521"
            ]
          },
          "710440521": {
            "id": "710440521",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "…稍等，我给你开一个凭条。她看见凭条，自然会明白你是可以信赖的。",
            "nextDialogs": [
              "710440522"
            ]
          },
          "710440522": {
            "id": "710440522",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "当然！我事先警告你们，志琼可不是那种一点也不安分，整天到处乱跑的人，也从来不会想解开阵法一头钻进地下！",
            "nextDialogs": [
              "710440523"
            ]
          },
          "710440523": {
            "id": "710440523",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "更不可能纠集一群无所事事的冒险者，旁若无人地深入险地！所以请不要指望她能帮你进入层岩巨渊矿坑。"
          },
          "710440518": {
            "id": "710440518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！我们走吧！",
            "nextDialogs": [
              "710440519"
            ]
          },
          "710440519": {
            "id": "710440519",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "等等，我还没说完呢！"
          }
        }
      }
    },

    {
      "subId": "7104406",
      "subQuestName": "寻找冒险家「志琼」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710440601"
        ],
        "dialogs": {
          "710440601": {
            "id": "710440601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来还有讲我们的评书呀…",
            "nextDialogs": [
              "710440602"
            ]
          },
          "710440602": {
            "id": "710440602",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "那是当然，在城里可流行呢！我吧，觉得茶博士和田铁嘴他们各有各的特点，只是我更喜欢田…",
            "nextDialogs": [
              "710440605"
            ]
          },
          "710440605": {
            "id": "710440605",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "哈哈，我明白的，我明白的，不是每个人都能接受田铁嘴的风格，我有时候也觉得他说书的用词造句有点太俗俚了…",
            "nextDialogs": [
              "710440606"
            ]
          },
          "710440606": {
            "id": "710440606",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "但是茶博士说书呢，他慢热，你明白吧？有时候一个故事捂上两个时辰才觉出味道来，有人喜欢这个，我是觉得没意思…",
            "nextDialogs": [
              "710440607"
            ]
          },
          "710440607": {
            "id": "710440607",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "你说这幸好是故事，不怕会变质对吧？这要是什么吃的喝的，裹个包袱捂半天不给抖开，那不是早就臭了…"
          }
        }
      }
    },
    {
      "subId": "7104407",
      "subQuestName": "前往矿工仓库",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710440701"
        ],
        "dialogs": {
          "710440701": {
            "id": "710440701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们回来啦，你这个大骗子！",
            "nextDialogs": [
              "710440702"
            ]
          },
          "710440702": {
            "id": "710440702",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "欸？我怎么了？发生什么事了吗？",
            "nextDialogs": [
              "710440704",
              "710440706"
            ]
          },
          "710440704": {
            "id": "710440704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你还说什么「看守完备」！",
            "nextDialogs": [
              "710440707"
            ]
          },
          "710440707": {
            "id": "710440707",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "唔…不应该呀。我看守仓库的时候，盗宝团都不敢靠近的。",
            "nextDialogs": [
              "710440708"
            ]
          },
          "710440708": {
            "id": "710440708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…等等，你说谁看守仓库…？",
            "nextDialogs": [
              "710440709"
            ]
          },
          "710440709": {
            "id": "710440709",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "我呀？",
            "nextDialogs": [
              "710440710"
            ]
          },
          "710440710": {
            "id": "710440710",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你有在看守仓库吗？",
            "nextDialogs": [
              "710440711"
            ]
          },
          "710440711": {
            "id": "710440711",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "哈哈，哪会有冒险家愿意把时间浪费在那种无聊的事情上…",
            "nextDialogs": [
              "710440712"
            ]
          },
          "710440712": {
            "id": "710440712",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "……！",
            "nextDialogs": [
              "710440713"
            ]
          },
          "710440713": {
            "id": "710440713",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "…啊…呃，对哦…",
            "nextDialogs": [
              "710440714"
            ]
          },
          "710440714": {
            "id": "710440714",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "710440715"
            ]
          },
          "710440715": {
            "id": "710440715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "710440716"
            ]
          },
          "710440716": {
            "id": "710440716",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "……"
          },
          "710440706": {
            "id": "710440706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们也奇怪为什么没人看守呢！"
          }
        }
      }
    },
    {
      "subId": "7104408",
      "subQuestName": "击退出现的盗宝团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710440801"
        ],
        "dialogs": {
          "710440801": {
            "id": "710440801",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "原来这样就能轻易破坏…呃，解除掉「磐键」的约束了！信任前辈果然没错！",
            "nextDialogs": [
              "710440804"
            ]
          },
          "710440804": {
            "id": "710440804",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "没关系的，沐宁已经事先报损了。所以这些「磐键」，其实在我们来之前就已经「损坏」啦。",
            "nextDialogs": [
              "710440805"
            ]
          },
          "710440805": {
            "id": "710440805",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "接下来还有四处「磐键」需要处理…啊，我画了一张简图，标出了其中三处的位置，希望能帮到你。",
            "nextDialogs": [
              "710440806"
            ]
          },
          "710440806": {
            "id": "710440806",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "至于另外一处…唔，现在我也很难分辨位置了。矿工撤离后，那座矿洞发生过一次渗漏事故，柱体被淹没在了水下…",
            "nextDialogs": [
              "710440807"
            ]
          },
          "710440807": {
            "id": "710440807",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "等你解除其余三处，再回来找我吧，最后一处我们再一起想想办法…",
            "nextDialogs": [
              "710440808"
            ]
          },
          "710440808": {
            "id": "710440808",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不一起来吗?",
            "nextDialogs": [
              "710440809"
            ]
          },
          "710440809": {
            "id": "710440809",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "这次还是不了…本来被委托了看守仓库的工作，结果一时疏忽，差点让盗宝团趁虚而入…我已经要感谢前辈不上报之恩了…",
            "nextDialogs": [
              "710440810"
            ]
          },
          "710440810": {
            "id": "710440810",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "万一再被沐宁那家伙抓住开小差的话可就不得了啦，至少这段时间我得回去看守仓库才行。",
            "nextDialogs": [
              "710440811"
            ]
          },
          "710440811": {
            "id": "710440811",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "不过我相信，这点问题即使靠两位前辈也是能解决的！"
          }
        }
      }
    },

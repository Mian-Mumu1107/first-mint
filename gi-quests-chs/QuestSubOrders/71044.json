    {
      "subId": "7104420",
      "subQuestName": "test隐藏-回滚隔离$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710442001"
        ],
        "dialogs": {
          "710442001": {
            "id": "710442001",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "要是真明白了我的话，就请不要在这里晃来晃去了。",
            "nextDialogs": [
              "710442002"
            ]
          },
          "710442002": {
            "id": "710442002",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "否则…",
            "nextDialogs": [
              "710442003"
            ]
          },
          "710442003": {
            "id": "710442003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "否则…？",
            "nextDialogs": [
              "710442004"
            ]
          },
          "710442004": {
            "id": "710442004",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "唉，没什么否则的。我能做的，最多就是写写周报罢了。",
            "nextDialogs": [
              "710442005"
            ]
          },
          "710442005": {
            "id": "710442005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "周报？",
            "nextDialogs": [
              "710442006"
            ]
          },
          "710442006": {
            "id": "710442006",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "一些麻烦、没什么意义，但是又不得不写的文书。",
            "nextDialogs": [
              "710442007"
            ]
          },
          "710442007": {
            "id": "710442007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就不写？",
            "nextDialogs": [
              "710442008"
            ]
          },
          "710442008": {
            "id": "710442008",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "那可不行，至少像是你出现在这里的消息，总是要写进去的。",
            "nextDialogs": [
              "710442009"
            ]
          },
          "710442009": {
            "id": "710442009",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "上次提交报告是昨天，也就是说，再过不了几天，总务司的人就会知道你在这里。",
            "nextDialogs": [
              "710442010"
            ]
          },
          "710442010": {
            "id": "710442010",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "到时候，说不定就会有人过来，强行把你带出去。",
            "nextDialogs": [
              "710442011"
            ]
          },
          "710442011": {
            "id": "710442011",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "所以呢，在那之前，你还可以自由行动，明白了吗？",
            "nextDialogs": [
              "710442012"
            ]
          },
          "710442012": {
            "id": "710442012",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "明白了。",
            "nextDialogs": [
              "710442013"
            ]
          },
          "710442013": {
            "id": "710442013",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "明白了就好…哼，如果不是看在你为璃月立过大功的面子上…算了算了。"
          }
        }
      }
    },
    {
      "subId": "7104421",
      "subQuestName": "向志琼回报「磐键」已破坏之事",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710440901"
        ],
        "dialogs": {
          "710440901": {
            "id": "710440901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们回来啦！三处「磐键」全都破坏掉了！",
            "nextDialogs": [
              "710440902"
            ]
          },
          "710440902": {
            "id": "710440902",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "嘘…",
            "nextDialogs": [
              "710440903"
            ]
          },
          "710440903": {
            "id": "710440903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……？突然怎么了…？",
            "nextDialogs": [
              "710440907",
              "710440906"
            ]
          },
          "710440907": {
            "id": "710440907",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "不要大惊小怪的…！没什么…只是大地在震动。或许是因为封印松动，附近的山岩也开始变得不稳定了…你有感觉到吗？",
            "nextDialogs": [
              "710440908"
            ]
          },
          "710440908": {
            "id": "710440908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完全没有欸…"
          },
          "710440906": {
            "id": "710440906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？敌人？！在哪里呀！"
          }
        }
      }
    },

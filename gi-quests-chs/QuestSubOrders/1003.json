    {
      "subId": "100303",
      "subQuestName": "与魈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10030301"
        ],
        "dialogs": {
          "10030301": {
            "id": "10030301",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "…是你们。",
            "nextDialogs": [
              "10030302"
            ]
          },
          "10030302": {
            "id": "10030302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又见面了！你好呀。",
            "nextDialogs": [
              "10030303"
            ]
          },
          "10030303": {
            "id": "10030303",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "为何还要继续接近仙与魔的世界？你们的逾矩太频繁了。",
            "nextDialogs": [
              "10030308"
            ]
          },
          "10030308": {
            "id": "10030308",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "人的灵魂不如仙人强韧，血液中也难以承载如此浓度的仙家气运。",
            "nextDialogs": [
              "10030309"
            ]
          },
          "10030309": {
            "id": "10030309",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "算是为你们好，抓紧离开吧。",
            "nextDialogs": [
              "10030310"
            ]
          },
          "10030310": {
            "id": "10030310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下，我们是来…",
            "nextDialogs": [
              "10030311"
            ]
          },
          "10030311": {
            "id": "10030311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，好生气。这个人怎么自说自话的。",
            "nextDialogs": [
              "10030312"
            ]
          },
          "10030312": {
            "id": "10030312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好想给他起个难听的绰号…但要是得罪了仙人，以后发现宝箱的时候，会不会只能开出卷心菜…？",
            "nextDialogs": [
              "10030313"
            ]
          },
          "10030313": {
            "id": "10030313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唉…我们还是去请教一下客栈的老板娘，问问她怎么和仙人正常交流吧。"
          }
        }
      }
    },
    {
      "subId": "100319",

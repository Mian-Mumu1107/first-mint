    {
      "subId": "100314",
      "subQuestName": "打倒遗迹猎者",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10031401"
        ],
        "dialogs": {
          "10031401": {
            "id": "10031401",

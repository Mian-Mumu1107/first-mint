    {
      "subId": "100306",
      "subQuestName": "与大厨对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10030601"
        ],
        "dialogs": {
          "10030601": {
            "id": "10030601",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "大爷我正在休息，闲人勿扰。",
            "nextDialogs": [
              "10030602"
            ]
          },
          "10030602": {
            "id": "10030602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问，杏仁豆腐…",
            "nextDialogs": [
              "10030603"
            ]
          },
          "10030603": {
            "id": "10030603",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "闲人勿扰。",
            "nextDialogs": [
              "10030604"
            ]
          },
          "10030604": {
            "id": "10030604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜…这位大厨的服务热情，和蒙德的铁匠瓦格纳先生不相上下呢。",
            "nextDialogs": [
              "10030605"
            ]
          },
          "10030605": {
            "id": "10030605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "菜是戈黛特老板点的。",
            "nextDialogs": [
              "10030606"
            ]
          },
          "10030606": {
            "id": "10030606",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "……",
            "nextDialogs": [
              "10030607"
            ]
          },
          "10030607": {
            "id": "10030607",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "原来如此。老板吩咐下来的事，那就没办法了。",
            "nextDialogs": [
              "10030608"
            ]
          },
          "10030608": {
            "id": "10030608",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "但很可惜，我现在有心无力，没法做出杏仁豆腐这种细致甜食。",
            "nextDialogs": [
              "10030609"
            ]
          },
          "10030609": {
            "id": "10030609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是为什么呢？",
            "nextDialogs": [
              "10030610"
            ]
          },
          "10030610": {
            "id": "10030610",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "剑客的手必须稳定，咱当厨子的自然也是如此。",
            "nextDialogs": [
              "10030611"
            ]
          },
          "10030611": {
            "id": "10030611",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "但现在我的手，不好意思…有点不太稳…",
            "nextDialogs": [
              "10030612"
            ]
          },
          "10030612": {
            "id": "10030612",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "原因嘛…是因为有客人传言，这客栈里…闹鬼…",
            "nextDialogs": [
              "10030613"
            ]
          },
          "10030613": {
            "id": "10030613",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "而且就在刚才！刚才…我在厨房…也看见了…不太对劲的东西…",
            "nextDialogs": [
              "10030614"
            ]
          },
          "10030614": {
            "id": "10030614",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（这位大厨看起来这么凶恶，说起灵异话题来，语气就变得很虚弱呢。）",
            "nextDialogs": [
              "10030615"
            ]
          },
          "10030615": {
            "id": "10030615",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "总之…一想到连望舒客栈都不安全了，我磨甜杏仁的手就稳定不下来…",
            "nextDialogs": [
              "10030616"
            ]
          },
          "10030616": {
            "id": "10030616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#好吧，{NICKNAME}。为了最高品质的精美杏仁豆腐，我们就去厨房看一下吧。"
          }
        }
      }
    },
    {
      "subId": "100307",

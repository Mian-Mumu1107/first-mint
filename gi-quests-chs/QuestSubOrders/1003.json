    {
      "subId": "100304",
      "subQuestName": "向客栈老板娘请教",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10030401"
        ],
        "dialogs": {
          "10030401": {
            "id": "10030401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于那位仙人…",
            "nextDialogs": [
              "10030402"
            ]
          },
          "10030402": {
            "id": "10030402",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "哦？你们已经见过魈了？",
            "nextDialogs": [
              "10030403"
            ]
          },
          "10030403": {
            "id": "10030403",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "不错嘛，难得他心情好，居然愿意出来见人…",
            "nextDialogs": [
              "10030404"
            ]
          },
          "10030404": {
            "id": "10030404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来这样的态度就已经是「心情好」了。",
            "nextDialogs": [
              "10030405"
            ]
          },
          "10030405": {
            "id": "10030405",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "是啊，仙缘难得，许多人一心访仙，却终生未见仙人一面呢。",
            "nextDialogs": [
              "10030406"
            ]
          },
          "10030406": {
            "id": "10030406",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "岩神建立璃月时，借助了仙人的力量。",
            "nextDialogs": [
              "10030407"
            ]
          },
          "10030407": {
            "id": "10030407",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "但因为仙人中的大多数，都只懂得以战斗来守护璃月…",
            "nextDialogs": [
              "10030408"
            ]
          },
          "10030408": {
            "id": "10030408",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "所以数千年来，终究还是人类掌握了贸易之都的运作，而仙人隐居在外。",
            "nextDialogs": [
              "10030409"
            ]
          },
          "10030409": {
            "id": "10030409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "老板娘懂得真多啊。",
            "nextDialogs": [
              "10030410"
            ]
          },
          "10030410": {
            "id": "10030410",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "不是「老板娘」，是「老板」——",
            "nextDialogs": [
              "10030411"
            ]
          },
          "10030411": {
            "id": "10030411",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "总之，既然你们这么有仙缘，那事情就好办多了。",
            "nextDialogs": [
              "10030412"
            ]
          },
          "10030412": {
            "id": "10030412",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "要问我的建议嘛…嗯，其实只要试着去哄魈开心就好啦。",
            "nextDialogs": [
              "10030413"
            ]
          },
          "10030413": {
            "id": "10030413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "开心…？那位「护法夜叉」大人，很难想象他开心起来是什么样子的…",
            "nextDialogs": [
              "10030414"
            ]
          },
          "10030414": {
            "id": "10030414",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "哼哼，很期待吧？",
            "nextDialogs": [
              "10030415"
            ]
          },
          "10030415": {
            "id": "10030415",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "（其实我也从没见他笑过…）",
            "nextDialogs": [
              "10030416"
            ]
          },
          "10030416": {
            "id": "10030416",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "这样吧，先去找大厨要一份杏仁豆腐，再加上一道你拿手的菜。",
            "nextDialogs": [
              "10030417"
            ]
          },
          "10030417": {
            "id": "10030417",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "杏仁豆腐是魈难得喜欢的人间食物，拿手的菜就靠你自由发挥了。",
            "nextDialogs": [
              "10030418"
            ]
          },
          "10030418": {
            "id": "10030418",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔，自由发挥…{NICKNAME}，你最擅长做什么菜呢？",
            "nextDialogs": [
              "10030420",
              "10030422"
            ]
          },
          "10030420": {
            "id": "10030420",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是那种很难出错的食物呢。",
            "nextDialogs": [
              "10030423"
            ]
          },
          "10030423": {
            "id": "10030423",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，送给仙人的礼物还是保守一点，就用「满足沙拉」好了…"
          },
          "10030422": {
            "id": "10030422",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，听起来很新奇，想吃吃看！"
          }
        }
      }
    },
    {
      "subId": "100305",
      "subQuestName": "制作一份「美味的满足沙拉」",

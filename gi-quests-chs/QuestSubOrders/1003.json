    {
      "subId": "100308",
      "subQuestName": "在厨房查看$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10030801"
        ],
        "dialogs": {
          "10030801": {
            "id": "10030801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里好像什么都…",
            "nextDialogs": [
              "10030802"
            ]
          },
          "10030802": {
            "id": "10030802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "10030803"
            ]
          },
          "10030803": {
            "id": "10030803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…………",
            "nextDialogs": [
              "10030804"
            ]
          },
          "10030804": {
            "id": "10030804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "##%^%*&……！！"
          }
        }
      }
    },
    {
      "subId": "100309",
      "subQuestName": "将情形告知言笑",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10030901"
        ],
        "dialogs": {
          "10030901": {
            "id": "10030901",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "啊！你们果然也看到了！真的有鬼！",
            "nextDialogs": [
              "10030902"
            ]
          },
          "10030902": {
            "id": "10030902",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "这…这可如何是好…",
            "nextDialogs": [
              "10030903"
            ]
          },
          "10030903": {
            "id": "10030903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他已经不行了…怎么办？",
            "nextDialogs": [
              "10030904"
            ]
          },
          "10030904": {
            "id": "10030904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "算了，我们还是去问问老板娘吧。"
          }
        }
      }
    },
    {
      "subId": "100310",
      "subQuestName": "向戈黛特求助",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10031001"
        ],
        "dialogs": {
          "10031001": {
            "id": "10031001",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "哼哼…被这种小事吓到，亏他曾经还是江洋大盗。",
            "nextDialogs": [
              "10031002"
            ]
          },
          "10031002": {
            "id": "10031002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "戈黛特老板好像不怎么怕鬼的样子？",
            "nextDialogs": [
              "10031003"
            ]
          },
          "10031003": {
            "id": "10031003",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "神神鬼鬼的，我可见得多了…",
            "nextDialogs": [
              "10031004"
            ]
          },
          "10031004": {
            "id": "10031004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，说起来，别人好像也不知道仙人在客栈出没，但戈黛特老板…",
            "nextDialogs": [
              "10031005"
            ]
          },
          "10031005": {
            "id": "10031005",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "嘘…",
            "nextDialogs": [
              "10031006"
            ]
          },
          "10031006": {
            "id": "10031006",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "再细说下去，就是我的「小秘密」的范围了哦。",
            "nextDialogs": [
              "10031007"
            ]
          },
          "10031007": {
            "id": "10031007",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "好了，你们不如去跑一趟吧。让那小鬼别再吓人了。",
            "nextDialogs": [
              "10031008"
            ]
          },
          "10031008": {
            "id": "10031008",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "这可不是差使你们——正如那位仙人所说，人的灵魂不如仙人强韧。",
            "nextDialogs": [
              "10031009"
            ]
          },
          "10031009": {
            "id": "10031009",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "为了接触仙人时不受伤害，就从接触小鬼开始锻炼吧。",
            "nextDialogs": [
              "10031011"
            ]
          },
          "10031011": {
            "id": "10031011",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但要怎么劝说鬼魂呢？",
            "nextDialogs": [
              "10031013"
            ]
          },
          "10031013": {
            "id": "10031013",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "客栈里有一幅字画，描摹了璃月通行千年的「降魔印」，你们可以去看看它的样子。",
            "nextDialogs": [
              "10031014"
            ]
          },
          "10031014": {
            "id": "10031014",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "——然后，就在这间客栈附近，寻找「能够见到完整降魔印的地方」吧。"
          }
        }
      }
    },
    {
      "subId": "100321",
      "subQuestName": "观察挂画",
      "sceneId": null,
      "locations": [],

    {
      "subId": "100315",
      "subQuestName": "与小冥对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10031501"
        ],
        "dialogs": {
          "10031501": {
            "id": "10031501",
            "speakerId": 231101,
            "speakerName": "小冥",
            "text": "大丘丘病了♪，二丘丘瞧♪…",
            "nextDialogs": [
              "10031502"
            ]
          },
          "10031502": {
            "id": "10031502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…呼…终于抓到你了，真是累人。",
            "nextDialogs": [
              "10031503"
            ]
          },
          "10031503": {
            "id": "10031503",
            "speakerId": 231101,
            "speakerName": "小冥",
            "text": "三丘丘采药♪，四丘丘熬♪…",
            "nextDialogs": [
              "10031504"
            ]
          },
          "10031504": {
            "id": "10031504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "闹鬼是不好的！小朋友你明白吗？",
            "nextDialogs": [
              "10031505"
            ]
          },
          "10031505": {
            "id": "10031505",
            "speakerId": 231101,
            "speakerName": "小冥",
            "text": "五丘丘死了♪，六丘丘抬♪…",
            "nextDialogs": [
              "10031506"
            ]
          },
          "10031506": {
            "id": "10031506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有没有在听我说话啊！",
            "nextDialogs": [
              "10031507"
            ]
          },
          "10031507": {
            "id": "10031507",
            "speakerId": 231101,
            "speakerName": "小冥",
            "text": "……",
            "nextDialogs": [
              "10031508"
            ]
          },
          "10031508": {
            "id": "10031508",
            "speakerId": 231101,
            "speakerName": "小冥",
            "text": "好喔。",
            "nextDialogs": [
              "10031509"
            ]
          },
          "10031509": {
            "id": "10031509",
            "speakerId": 231101,
            "speakerName": "小冥",
            "text": "小冥不会再捉弄住店的客人了。",
            "nextDialogs": [
              "10031510"
            ]
          },
          "10031510": {
            "id": "10031510",
            "speakerId": 231101,
            "speakerName": "小冥",
            "text": "#下次，就换{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}再来和小冥一起玩吧。",
            "nextDialogs": [
              "10031511"
            ]
          },
          "10031511": {
            "id": "10031511",
            "speakerId": 231101,
            "speakerName": "小冥",
            "text": "#如果{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}不来的话，小冥会去找你的…"
          }
        }
      }
    },
    {
      "subId": "100316",
      "subQuestName": "将情形告知言笑",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10031601"
        ],
        "dialogs": {
          "10031601": {
            "id": "10031601",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "什…什么，居然从鬼魂口中要到了不再作祟的保证…",
            "nextDialogs": [
              "10031602"
            ]
          },
          "10031602": {
            "id": "10031602",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "您…真是高人。",
            "nextDialogs": [
              "10031603"
            ]
          },
          "10031603": {
            "id": "10031603",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "我言笑服了。",
            "nextDialogs": [
              "10031604"
            ]
          },
          "10031604": {
            "id": "10031604",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "请稍等，我为您认真做一道最细最滑的杏仁豆腐，包您满意。",
            "nextDialogs": [
              "10031605"
            ]
          },
          "10031605": {
            "id": "10031605",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "哈哈，手指重新变得稳定的感觉，好。"
          }
        }
      }
    },
    {
      "subId": "100317",
      "subQuestName": "与魈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10031701"
        ],
        "dialogs": {
          "10031701": {
            "id": "10031701",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "…又是你们。",
            "nextDialogs": [
              "10031702"
            ]
          },
          "10031702": {
            "id": "10031702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等！这次先别急着消失。",
            "nextDialogs": [
              "10031703"
            ]
          },
          "10031703": {
            "id": "10031703",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "这是…？",
            "nextDialogs": [
              "10031704"
            ]
          },
          "10031704": {
            "id": "10031704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是你最喜欢的杏仁豆腐，和这位异国旅行者的拿手好菜，充满异国风情的沙拉喔。",
            "nextDialogs": [
              "10031705"
            ]
          },
          "10031705": {
            "id": "10031705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}！快！趁他吃东西的时候…把事情都跟他说了！",
            "nextDialogs": [
              "10031706"
            ]
          },
          "10031706": {
            "id": "10031706",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "岩王帝君…竟遭此厄。",
            "nextDialogs": [
              "10031707"
            ]
          },
          "10031707": {
            "id": "10031707",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "我…无法想象。不论时代如何变易，我都从未想象过失去帝君的璃月之地。",
            "nextDialogs": [
              "10031708"
            ]
          },
          "10031708": {
            "id": "10031708",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "掌管人间的七星…究竟在这件事里扮演了怎样的角色？",
            "nextDialogs": [
              "10031709"
            ]
          },
          "10031709": {
            "id": "10031709",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "……",
            "nextDialogs": [
              "10031710"
            ]
          },
          "10031710": {
            "id": "10031710",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "我会去找削月、理水、留云三位真君。他们也是时候作出决断了。",
            "nextDialogs": [
              "10031713"
            ]
          },
          "10031713": {
            "id": "10031713",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "仙人不会逃避责任。",
            "nextDialogs": [
              "10031714"
            ]
          },
          "10031714": {
            "id": "10031714",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "虽然…我有不愿沾染凡尘的理由，但职责终归是职责。",
            "nextDialogs": [
              "10031715"
            ]
          },
          "10031715": {
            "id": "10031715",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "因为我们的神，乃是「契约」之神。",
            "nextDialogs": [
              "10031716"
            ]
          },
          "10031716": {
            "id": "10031716",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下！我还有最后一个问题。",
            "nextDialogs": [
              "10031717"
            ]
          },
          "10031717": {
            "id": "10031717",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "嗯？",
            "nextDialogs": [
              "10031718"
            ]
          },
          "10031718": {
            "id": "10031718",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个…小冥…究竟是…",
            "nextDialogs": [
              "10031719"
            ]
          },
          "10031719": {
            "id": "10031719",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "降妖除魔时，偶尔也会遇到从未害过人的恶灵，又暂时难以超度。",
            "nextDialogs": [
              "10031720"
            ]
          },
          "10031720": {
            "id": "10031720",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "所以拜托「老板」与「掌柜」，收留一段时日。",
            "nextDialogs": [
              "10031721"
            ]
          },
          "10031721": {
            "id": "10031721",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是望舒客栈帮忙养着的啊——！这家客栈的业务范围也太广了吧？！"
          }
        }
      }
    },
    {
      "subId": "100303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10030304"
        ],
        "dialogs": {
          "10030304": {
            "id": "10030304",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "「百无禁忌箓」？看来你们有备而来…",
            "nextDialogs": [
              "10030305"
            ]
          },
          "10030305": {
            "id": "10030305",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "但这只是让我不伤害你们的信物，并不代表你们不会受到伤害。",
            "nextDialogs": [
              "10030306"
            ]
          },
          "10030306": {
            "id": "10030306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…我不太明白…",
            "nextDialogs": [
              "10030307"
            ]
          },
          "10030307": {
            "id": "10030307",
            "speakerId": 10204,
            "speakerName": "魈",
            "text": "过分接近仙与魔的世界，即为逾矩。"
          }
        }
      }
    },
    {
      "subId": "100387",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10038701"
        ],
        "dialogs": {
          "10038701": {
            "id": "10038701",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "鬼也不过是在世上存在的另一种形式，「以理服鬼」也一定能够做得到的。"
          }
        }
      }
    },
    {
      "subId": "100388",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10038801"
        ],
        "dialogs": {
          "10038801": {
            "id": "10038801",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "仙缘难结又易逝，抓住机会哦。"
          }
        }
      }
    },
    {
      "subId": "100389",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10038901"
        ],
        "dialogs": {
          "10038901": {
            "id": "10038901",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "久违的舒畅感，刚才这道菜也算是超常发挥了。"
          }
        }
      }
    },
    {
      "subId": "100390",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10039001"
        ],
        "dialogs": {
          "10039001": {
            "id": "10039001",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "岩、岩王保佑…各路神仙保佑！"
          }
        }
      }
    },
    {
      "subId": "100391",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10039101"
        ],
        "dialogs": {
          "10039101": {
            "id": "10039101",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "若不是老板和掌柜对我有恩在先，我怎会情愿受这种罪…"
          }
        }
      }
    },
    {
      "subId": "100392",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10039201"
        ],
        "dialogs": {
          "10039201": {
            "id": "10039201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见。",
            "nextDialogs": [
              "10039202"
            ]
          },
          "10039202": {
            "id": "10039202",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "祝您旅途平安。"
          }
        }
      }
    },
    {
      "subId": "100393",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10039301"
        ],
        "dialogs": {
          "10039301": {
            "id": "10039301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于你丈夫？",
            "nextDialogs": [
              "10039302"
            ]
          },
          "10039302": {
            "id": "10039302",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "他就在那边，是客栈的掌柜。",
            "nextDialogs": [
              "10039303"
            ]
          },
          "10039303": {
            "id": "10039303",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "别看他笑嘻嘻的，其实拳脚功夫很厉害的。",
            "nextDialogs": [
              "10039304"
            ]
          },
          "10039304": {
            "id": "10039304",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "我也是，我们的厨子也是，都是这么招进来的。",
            "nextDialogs": [
              "10039305"
            ]
          },
          "10039305": {
            "id": "10039305",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "不会功夫还怎么招待好客人呢，你说是不是这个道理。"
          }
        }
      }
    },
    {
      "subId": "100394",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10039401"
        ],
        "dialogs": {
          "10039401": {
            "id": "10039401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问你是？",
            "nextDialogs": [
              "10039402"
            ]
          },
          "10039402": {
            "id": "10039402",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "我叫戈黛特，来自蒙德。是望舒客栈的老板。",
            "nextDialogs": [
              "10039403"
            ]
          },
          "10039403": {
            "id": "10039403",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "不是老板娘。",
            "nextDialogs": [
              "10039404"
            ]
          },
          "10039404": {
            "id": "10039404",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "是、老、板。",
            "nextDialogs": [
              "10039406",
              "10039411"
            ]
          },
          "10039406": {
            "id": "10039406",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "哈哈哈，能在这里开店，怎么可能和七星没有关系呢。",
            "nextDialogs": [
              "10039407"
            ]
          },
          "10039407": {
            "id": "10039407",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "我意思是，肯定需要他们同意嘛。",
            "nextDialogs": [
              "10039408"
            ]
          },
          "10039408": {
            "id": "10039408",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "其他一些有的没的，那当然都是谣言啦。",
            "nextDialogs": [
              "10039409"
            ]
          },
          "10039409": {
            "id": "10039409",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "这么说来，您听到过什么有意思的事情吗？"
          },
          "10039411": {
            "id": "10039411",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "唉…这猫是自己跟来的，不过看着挺可爱的就留下了。",
            "nextDialogs": [
              "10039412"
            ]
          },
          "10039412": {
            "id": "10039412",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "名字吗，叫阿伟，随便起的。",
            "nextDialogs": [
              "10039413"
            ]
          },
          "10039413": {
            "id": "10039413",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "它可能会捣蛋一下，猫嘛，是这样的。您可千万别和它一般见识。"
          }
        }
      }
    },
    {
      "subId": "100395",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10039501"
        ],
        "dialogs": {
          "10039501": {
            "id": "10039501",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "您好啊。打扮、面庞…还有奇怪的伙伴小精灵。猜不出来了呢…"
          }
        }
      }
    }
  ]
}
{
  "lineCounts": {
    "凯瑟琳": 1,
    "奈芙尔": 10,
    "萨林": 4,
    "雅珂达": 7
  },
  "subQuests": [
    {
      "subId": "7612901",
      "subQuestName": "与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761290101"
        ],
        "dialogs": {
          "761290101": {
            "id": "761290101",
            "speakerId": 7000,
            "speakerName": "凯瑟琳",
            "text": "再次感谢您对协会的帮助，奈芙尔老板，雅珂达小姐。",
            "nextDialogs": [
              "761290102"
            ]
          },
          "761290102": {
            "id": "761290102",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "合作而已，无需这么客气。",
            "nextDialogs": [
              "761290103"
            ]
          },
          "761290103": {
            "id": "761290103",
            "speakerId": 7016,
            "speakerName": "萨林",
            "text": "话是这么说，但我还是要感谢奈芙尔老板，愿意帮助协会进行一些…复杂的调查工作。",
            "nextDialogs": [
              "761290104"
            ]
          },
          "761290104": {
            "id": "761290104",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "冒险家协会也分出了不少人手来协助我们的工作，算是合作共赢。",
            "nextDialogs": [
              "761290105"
            ]
          },
          "761290105": {
            "id": "761290105",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "希望我们之后，也能合作得这么愉快，萨林先生。",
            "nextDialogs": [
              "761290106"
            ]
          },
          "761290106": {
            "id": "761290106",
            "speakerId": 7016,
            "speakerName": "萨林",
            "text": "请奈芙尔老板放心，我们冒险家协会…",
            "nextDialogs": [
              "761290107"
            ]
          },
          "761290107": {
            "id": "761290107",
            "speakerId": 7016,
            "speakerName": "萨林",
            "text": "噢，我得严谨点。我们挪德卡莱冒险家协会分部，绝对是一个值得信赖的合作对象。",
            "nextDialogs": [
              "761290108"
            ]
          },
          "761290108": {
            "id": "761290108",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "呵呵，看得出来。",
            "nextDialogs": [
              "761290109"
            ]
          },
          "761290109": {
            "id": "761290109",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（好好好，就这么聊，奈姐奈姐，亲爱的奈姐，别看我别看我别看我…）",
            "nextDialogs": [
              "761290110"
            ]
          },
          "761290110": {
            "id": "761290110",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "雅珂达，你怎么不说话？",
            "nextDialogs": [
              "761290111"
            ]
          },
          "761290111": {
            "id": "761290111",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（还是看我了啊！那别看委托板别看委托板别看委托板——）",
            "nextDialogs": [
              "761290112"
            ]
          },
          "761290112": {
            "id": "761290112",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "啊？我、我没什么要说的呀？谢谢…给我委托…？",
            "nextDialogs": [
              "761290113"
            ]
          },
          "761290113": {
            "id": "761290113",
            "speakerId": 7016,
            "speakerName": "萨林",
            "text": "噗，也要感谢雅珂达小姐的协助，要是没了您，协会的事务怕是要堆成山了。",
            "nextDialogs": [
              "761290114"
            ]
          },
          "761290114": {
            "id": "761290114",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "不客气不客气…我都拿钱了，肯定要好好做呀…",
            "nextDialogs": [
              "761290115"
            ]
          },
          "761290115": {
            "id": "761290115",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "（唉，之前教她的话术，只怕又忘光了…）",
            "nextDialogs": [
              "761290116"
            ]
          },
          "761290116": {
            "id": "761290116",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "对了，既然来都来了…",
            "nextDialogs": [
              "761290117"
            ]
          },
          "761290117": {
            "id": "761290117",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（不要啊！气氛这么好，老板你就放过我吧！）",
            "nextDialogs": [
              "761290118"
            ]
          },
          "761290118": {
            "id": "761290118",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "麻烦萨林先生，把最新的一批委托拿过来吧。",
            "nextDialogs": [
              "761290119"
            ]
          },
          "761290119": {
            "id": "761290119",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "雅珂达，你来选一个，你觉得最应该做的委托。",
            "nextDialogs": [
              "761290120"
            ]
          },
          "761290120": {
            "id": "761290120",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "好好想，慢慢选，好吗？",
            "nextDialogs": [
              "761290121"
            ]
          },
          "761290121": {
            "id": "761290121",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "是…是，老板…",
            "nextDialogs": [
              "761290122"
            ]
          },
          "761290122": {
            "id": "761290122",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（呜哇——完！蛋！啦——）"
          }
        }
      }
    }
  ]
}
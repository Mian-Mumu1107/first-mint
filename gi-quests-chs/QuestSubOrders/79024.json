  },
  "subQuests": [
    {
      "subId": "7902401",
      "subQuestName": "与营地中的愚人众对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790240101"
        ],
        "dialogs": {
          "790240101": {
            "id": "790240101",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "雅科夫，雅科夫，刚才的就是你平时最喜欢听的曲子…",
            "nextDialogs": [
              "790240102"
            ]
          },
          "790240102": {
            "id": "790240102",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "怎么样，雅科夫醒过来了吗？",
            "nextDialogs": [
              "790240103"
            ]
          },
          "790240103": {
            "id": "790240103",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "不行，阿加霞，还是什么反应都没有。",
            "nextDialogs": [
              "790240104"
            ]
          },
          "790240104": {
            "id": "790240104",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "每次我唱这首歌的时候，尤其是唱到「仲夏已逝，万花凋谢。你必将远行，而我却习惯等待。」这句的时候…",
            "nextDialogs": [
              "790240105"
            ]
          },
          "790240105": {
            "id": "790240105",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "每次我唱到这里，他总是会眼睛变得湿润地看着我呀…怎么会一点反应都没有呢？",
            "nextDialogs": [
              "790240106"
            ]
          },
          "790240106": {
            "id": "790240106",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "唉…",
            "nextDialogs": [
              "790240107"
            ]
          },
          "790240107": {
            "id": "790240107",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "我给他做了他最喜欢喝的汤，味道香得我自己口水都要流出来了，可是他还是没醒。",
            "nextDialogs": [
              "790240108"
            ]
          },
          "790240108": {
            "id": "790240108",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "阿加霞，我明白了！其实雅科夫最想要的就是他父亲能够回来，要不我就假扮成他的父亲…",
            "nextDialogs": [
              "790240109"
            ]
          },
          "790240109": {
            "id": "790240109",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "闭嘴，我现在不想跟你说话！我当时就不该让雅科夫和你一队的！",
            "nextDialogs": [
              "790240110"
            ]
          },
          "790240110": {
            "id": "790240110",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "阿加霞，这不是因为我，你知道的，都是因为那个实验…",
            "nextDialogs": [
              "790240111"
            ]
          },
          "790240111": {
            "id": "790240111",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "雅科夫，可怜的雅科夫啊…",
            "nextDialogs": [
              "790240112"
            ]
          },
          "790240112": {
            "id": "790240112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么了，雅科夫还是什么反应都没有吗？",
            "nextDialogs": [
              "790240113"
            ]
          },
          "790240113": {
            "id": "790240113",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "是你们啊…唉，正如你们所见，雅科夫还是一点反应都没有。",
            "nextDialogs": [
              "790240114"
            ]
          },
          "790240114": {
            "id": "790240114",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "这该如何是好啊，如果他这样浑浑噩噩的，就算回到了至冬，恐怕也会被愚人众除名…",
            "nextDialogs": [
              "790240117"
            ]
          },
          "790240117": {
            "id": "790240117",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "可是，可是雅科夫现在孤身一人…我们都时常外出执行任务，没人能够照顾他…如果被愚人众除名，他这样还怎么活下去呀…",
            "nextDialogs": [
              "790240118"
            ]
          },
          "790240118": {
            "id": "790240118",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "#对了，{NICKNAME}，你…你肯定解决过很多这样的事了吧！",
            "nextDialogs": [
              "790240119"
            ]
          },
          "790240119": {
            "id": "790240119",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "拜托了，拜托了，找到让雅科夫恢复的办法吧！",
            "nextDialogs": [
              "790240120"
            ]
          },
          "790240120": {
            "id": "790240120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是…",
            "nextDialogs": [
              "790240121"
            ]
          },
          "790240121": {
            "id": "790240121",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "你们不是想要情报吗，我们会拿机密的情报跟你们交换的，比如…",
            "nextDialogs": [
              "790240122"
            ]
          },
          "790240122": {
            "id": "790240122",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "对，比如「愚人众其实在金苹果群岛偷偷捕猎神秘花鳉」！",
            "nextDialogs": [
              "790240123"
            ]
          },
          "790240123": {
            "id": "790240123",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "扎哈尔…",
            "nextDialogs": [
              "790240124"
            ]
          },
          "790240124": {
            "id": "790240124",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "对不起…我只记得这个了…",
            "nextDialogs": [
              "790240125"
            ]
          },
          "790240125": {
            "id": "790240125",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "我们只是些负责跑腿的，哪有什么机密情报…",
            "nextDialogs": [
              "790240126"
            ]
          },
          "790240126": {
            "id": "790240126",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "叶夫卡，你不说话没人把你当哑巴。",
            "nextDialogs": [
              "790240127"
            ]
          },
          "790240127": {
            "id": "790240127",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唉…{NICKNAME}，你怎么看呢，「愚人众其实在金苹果群岛偷偷捕猎神秘花鳉」这条情报。"
          }
        }
      }
    },
    {
      "subId": "7902402",
      "subQuestName": "在营地进行调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790240201"
        ],
        "dialogs": {
          "790240201": {
            "id": "790240201",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "怎么样，有什么发现了吗？",
            "nextDialogs": [
              "790240202"
            ]
          },
          "790240202": {
            "id": "790240202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然也说不上是有线索，不过也是一种可能呢…",
            "nextDialogs": [
              "790240203"
            ]
          },
          "790240203": {
            "id": "790240203",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "向三位愚人众小队成员说明了海螺的作用…",
            "nextDialogs": [
              "790240204"
            ]
          },
          "790240204": {
            "id": "790240204",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "啊，没想到被那个奇怪装置影响到的海螺还会有这样的效果啊…",
            "nextDialogs": [
              "790240205"
            ]
          },
          "790240205": {
            "id": "790240205",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "你说的那个画面，应该是我带着害怕被训斥的雅科夫，找叶夫卡的画面吧…",
            "nextDialogs": [
              "790240206"
            ]
          },
          "790240206": {
            "id": "790240206",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "对，你这么一说，我也有点印象。",
            "nextDialogs": [
              "790240207"
            ]
          },
          "790240207": {
            "id": "790240207",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "不过，那也是很长一段时间之前，更何况，受到了那台巨大装置的影响，呜…在营地里时的记忆也变得很模糊…",
            "nextDialogs": [
              "790240208"
            ]
          },
          "790240208": {
            "id": "790240208",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "但是，这里的海螺本来应该有四个，应该<color=#00E1FFFF>还有其他三个</color>的！",
            "nextDialogs": [
              "790240209"
            ]
          },
          "790240209": {
            "id": "790240209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其他的记忆很模糊，但是海螺有四个却记得很清楚？",
            "nextDialogs": [
              "790240210"
            ]
          },
          "790240210": {
            "id": "790240210",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "在营地休整的时候，我们发现忘带盛汤的容器了，所以就临时用了那个海螺装做好的汤。所以，那个海螺是我们一人一个的…",
            "nextDialogs": [
              "790240211"
            ]
          },
          "790240211": {
            "id": "790240211",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "嗯，不过出发之前，雅科夫就把汤喝完，留在箱子上了…",
            "nextDialogs": [
              "790240212"
            ]
          },
          "790240212": {
            "id": "790240212",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "其他的我们一人一个，全都带走啦！",
            "nextDialogs": [
              "790240215"
            ]
          },
          "790240215": {
            "id": "790240215",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "唔…当时只觉得是一些普通的海螺，所以喝完汤之后就扔掉了…",
            "nextDialogs": [
              "790240216"
            ]
          },
          "790240216": {
            "id": "790240216",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "我想想，那个时候才刚上<color=#00E1FFFF>西北方向的大岛</color>，就把汤喝完，海螺，海螺被我顺手丢在岛上一个全是水的山洞里了。",
            "nextDialogs": [
              "790240217"
            ]
          },
          "790240217": {
            "id": "790240217",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "我，我好像扔在<color=#00E1FFFF>南方的大岛</color>遗迹边的山上了…",
            "nextDialogs": [
              "790240218"
            ]
          },
          "790240218": {
            "id": "790240218",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "嘿嘿，我的扔进了<color=#00E1FFFF>东北方向大岛</color>的井里…",
            "nextDialogs": [
              "790240219"
            ]
          },
          "790240219": {
            "id": "790240219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，根本就丢得到处都是…",
            "nextDialogs": [
              "790240220"
            ]
          },
          "790240220": {
            "id": "790240220",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "西北方向的岛，应该是辛焱的幻境所在的岛，也就是破破岛…",
            "nextDialogs": [
              "790240221"
            ]
          },
          "790240221": {
            "id": "790240221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "南方向的大岛，就应该是危危岛…东北方向的话…",
            "nextDialogs": [
              "790240222"
            ]
          },
          "790240222": {
            "id": "790240222",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就是双双岛吧…",
            "nextDialogs": [
              "790240223"
            ]
          },
          "790240223": {
            "id": "790240223",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "丢在了这三个岛上呀…",
            "nextDialogs": [
              "790240224"
            ]
          },
          "790240224": {
            "id": "790240224",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来得找到这三个海螺…",
            "nextDialogs": [
              "790240225"
            ]
          },
          "790240225": {
            "id": "790240225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，如果找到了这三个海螺，说不定就能找到能让雅科夫醒过来的线索了！"
          }
        }
      }
    },
    {
      "subId": "7902415",
      "subQuestName": "在营地进行调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790240501"
        ],
        "dialogs": {
          "790240501": {
            "id": "790240501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯？{NICKNAME}，你看箱子上放的海螺…",
            "nextDialogs": [
              "790240502"
            ]
          },
          "790240502": {
            "id": "790240502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总觉得在什么地方看到过类似的海螺，我们调查看看吧…"
          }
        }
      }
    },
    {
      "subId": "7902417",
      "subQuestName": "在营地进行调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790241701"
        ],
        "dialogs": {
          "790241701": {
            "id": "790241701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，看上去像是两个人躺在地上呢…是在看天上的星星？",
            "nextDialogs": [
              "790241702"
            ]
          },
          "790241702": {
            "id": "790241702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总觉得是有点奇怪的影像呢…",
            "nextDialogs": [
              "790241703"
            ]
          },
          "790241703": {
            "id": "790241703",
            "speakerId": 1005,
            "speakerName": "扎哈尔的影像",
            "text": "雅科夫，长官说了你些什么，你这么垂头丧气的。",
            "nextDialogs": [
              "790241704"
            ]
          },
          "790241704": {
            "id": "790241704",
            "speakerId": 1006,
            "speakerName": "雅科夫的影像",
            "text": "因为海浪颠簸，搬运仪器的时候摔了一跤，幸好我手快，仪器没事…",
            "nextDialogs": [
              "790241705"
            ]
          },
          "790241705": {
            "id": "790241705",
            "speakerId": 1006,
            "speakerName": "雅科夫的影像",
            "text": "但是长官还是训话说，要让我们小队去各个岛上做装置的信号接收测试，那可是最辛苦的任务…",
            "nextDialogs": [
              "790241706"
            ]
          },
          "790241706": {
            "id": "790241706",
            "speakerId": 1005,
            "speakerName": "扎哈尔的影像",
            "text": "没关系，不必这么伤心，咱们什么累活没干过啊。别伤心啦，先吃点东西吧！",
            "nextDialogs": [
              "790241707"
            ]
          },
          "790241707": {
            "id": "790241707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们指着那么高的地方，是想要吃什么啊…",
            "nextDialogs": [
              "790241708"
            ]
          },
          "790241708": {
            "id": "790241708",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道这个海螺…放歪了？"
          }
        }
      }
    },
    {
      "subId": "7902416",
      "subQuestName": "在营地进行调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790243101"
        ],
        "dialogs": {
          "790243101": {
            "id": "790243101",
            "speakerId": 1007,
            "speakerName": "叶夫卡的影像",
            "text": "呦，瞧瞧，回来啦…哼，幸好装置没被你摔个稀巴烂…",
            "nextDialogs": [
              "790243102"
            ]
          },
          "790243102": {
            "id": "790243102",
            "speakerId": 1006,
            "speakerName": "雅科夫的影像",
            "text": "但是…",
            "nextDialogs": [
              "790243103"
            ]
          },
          "790243103": {
            "id": "790243103",
            "speakerId": 1007,
            "speakerName": "叶夫卡的影像",
            "text": "去做信号接收测试而已，累活又不是没干过…",
            "nextDialogs": [
              "790243104"
            ]
          },
          "790243104": {
            "id": "790243104",
            "speakerId": 1008,
            "speakerName": "阿加菲娅的影像",
            "text": "你看，叶夫卡也觉得不是什么大事吧。",
            "nextDialogs": [
              "790243105"
            ]
          },
          "790243105": {
            "id": "790243105",
            "speakerId": 1006,
            "speakerName": "雅科夫的影像",
            "text": "那…那我先去做准备，待会儿我们就出发！",
            "nextDialogs": [
              "790243106"
            ]
          },
          "790243106": {
            "id": "790243106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是能够记录下影像的海螺啊…",
            "nextDialogs": [
              "790243107"
            ]
          },
          "790243107": {
            "id": "790243107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…总觉得这段对话有些没头没尾的…像是缺了什么东西一样…",
            "nextDialogs": [
              "790243108"
            ]
          },
          "790243108": {
            "id": "790243108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们去问问那些愚人众吧。"
          }
        }
      }
    },
    {
      "subId": "7902403",
      "subQuestName": "与营地中的愚人众对话收集线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7902410",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790240301"
        ],
        "dialogs": {
          "790240301": {
            "id": "790240301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#对了，{NICKNAME}，就在他们说的那些地方…我们不都看到过奇怪的海螺影像嘛…",
            "nextDialogs": [
              "790240302"
            ]
          },
          "790240302": {
            "id": "790240302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个时候我们捡到的那三个有点怪怪的海螺，说不定就是用在这里的，赶紧放箱子上试试吧！"
          }
        }
      }
    },
    {
      "subId": "7902404",
      "subQuestName": "前去寻找丢失的海螺",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7902405",
      "subQuestName": "前去寻找丢失的海螺",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7902406",
      "subQuestName": "前去寻找丢失的海螺",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7902413",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790241501"
        ],
        "dialogs": {
          "790241501": {
            "id": "790241501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，影像居然正好放在舞台的中间…",
            "nextDialogs": [
              "790241502"
            ]
          },
          "790241502": {
            "id": "790241502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这两个人在干嘛呢…看上去就像是一个人在说什么，另一个人坐在地上…",
            "nextDialogs": [
              "790241503"
            ]
          },
          "790241503": {
            "id": "790241503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我知道了，这个一定是在讲故事的画面！他们一定是快要睡觉了，所以影像里她正在为坐在地上的人讲睡前故事…",
            "nextDialogs": [
              "790241504"
            ]
          },
          "790241504": {
            "id": "790241504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "愚人众也要听睡前故事吗…",
            "nextDialogs": [
              "790241505"
            ]
          },
          "790241505": {
            "id": "790241505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说不定愚人众里也有人有这种需要的嘛。",
            "nextDialogs": [
              "790241506"
            ]
          },
          "790241506": {
            "id": "790241506",
            "speakerId": 1006,
            "speakerName": "雅科夫的影像",
            "text": "阿加霞，佩尔西科夫大人让我们去做信号接收测试，是让我们四个一起去…叶夫卡要是听到这件事，又得生气不可…",
            "nextDialogs": [
              "790241507"
            ]
          },
          "790241507": {
            "id": "790241507",
            "speakerId": 1008,
            "speakerName": "阿加菲娅的影像",
            "text": "雅科夫，不会的，这是上面大人的命令，叶夫卡肯定也不会责怪你的…",
            "nextDialogs": [
              "790241508"
            ]
          },
          "790241508": {
            "id": "790241508",
            "speakerId": 1008,
            "speakerName": "阿加菲娅的影像",
            "text": "唉，你要是真这么害怕，我陪你去跟叶夫卡说。",
            "nextDialogs": [
              "790241509"
            ]
          },
          "790241509": {
            "id": "790241509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么嘛，原来不是在讲故事呀…",
            "nextDialogs": [
              "790241510"
            ]
          },
          "790241510": {
            "id": "790241510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过这段对话没头没尾的，根本什么都看不出来嘛…"
          }
        }
      }
    },
    {
      "subId": "7902414",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790241601"
        ],
        "dialogs": {
          "790241601": {
            "id": "790241601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "海螺居然能够从井中浮起来…",
            "nextDialogs": [
              "790241604"
            ]
          },
          "790241604": {
            "id": "790241604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯，真是奇妙…啊，影像显示出来了，{NICKNAME}，你快看，那里有个弯腰的…哇！",
            "nextDialogs": [
              "790241605"
            ]
          },
          "790241605": {
            "id": "790241605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你不要动，你的身后…"
          }
        }
      }
    },
    {
      "subId": "7902407",
      "subQuestName": "将错位的海螺放回原位",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790240701"
        ],
        "dialogs": {
          "790240701": {
            "id": "790240701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯？{NICKNAME}，你看箱子上放的海螺，看上去有点眼熟…",
            "nextDialogs": [
              "790240702"
            ]
          },
          "790240702": {
            "id": "790240702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这不是其他岛上看到过的那种，能够记录影像的海螺嘛！",
            "nextDialogs": [
              "790240703"
            ]
          },
          "790240703": {
            "id": "790240703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说不定有唤醒雅科夫的线索呢！"
          }
        }
      }
    },
    {
      "subId": "7902411",
      "subQuestName": "唤醒雅科夫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790242201"
        ],
        "dialogs": {
          "790242201": {
            "id": "790242201",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "雅科夫，长官说了你些什么，你这么垂头丧气的。",
            "nextDialogs": [
              "790242202"
            ]
          },
          "790242202": {
            "id": "790242202",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "因为海浪颠簸，搬运仪器的时候摔了一跤，幸好我手快，仪器没事…",
            "nextDialogs": [
              "790242203"
            ]
          },
          "790242203": {
            "id": "790242203",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "但是长官还是训话说，要让我们小队去各个岛上做装置的信号接收测试，那可是最辛苦的任务…",
            "nextDialogs": [
              "790242204"
            ]
          },
          "790242204": {
            "id": "790242204",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "没关系，不必这么伤心，咱们什么累活没干过啊。别伤心啦，先吃点东西吧！",
            "nextDialogs": [
              "790242205"
            ]
          },
          "790242205": {
            "id": "790242205",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "阿加霞，佩尔西科夫研究员让我们去做信号接收测试，是让我们四个一起去…叶夫卡要是听到这件事，非得气个爆炸不可…",
            "nextDialogs": [
              "790242206"
            ]
          },
          "790242206": {
            "id": "790242206",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "雅科夫，不会的，这是上面大人的命令，叶夫卡肯定也不会责怪你的…",
            "nextDialogs": [
              "790242207"
            ]
          },
          "790242207": {
            "id": "790242207",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "唉，你要是真这么害怕，我陪你去跟叶夫卡说。",
            "nextDialogs": [
              "790242208"
            ]
          },
          "790242208": {
            "id": "790242208",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "呦，瞧瞧，回来啦…哼，幸好装置没被你摔个稀巴烂…",
            "nextDialogs": [
              "790242209"
            ]
          },
          "790242209": {
            "id": "790242209",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "但是…",
            "nextDialogs": [
              "790242210"
            ]
          },
          "790242210": {
            "id": "790242210",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "去做信号接收测试而已，累活又不是没干过…",
            "nextDialogs": [
              "790242211"
            ]
          },
          "790242211": {
            "id": "790242211",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "你看，叶夫卡也觉得不是什么大事吧。",
            "nextDialogs": [
              "790242212"
            ]
          },
          "790242212": {
            "id": "790242212",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "那…那我先去做准备，待会儿我们就出发！",
            "nextDialogs": [
              "790242213"
            ]
          },
          "790242213": {
            "id": "790242213",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "信号测试器…两组…",
            "nextDialogs": [
              "790242214"
            ]
          },
          "790242214": {
            "id": "790242214",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "唉，我还以为他被单独叫出去是要受什么严重的惩罚，结果只是布置了比较麻烦的任务，真是松了口气。",
            "nextDialogs": [
              "790242215"
            ]
          },
          "790242215": {
            "id": "790242215",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "他可害怕被你骂了，哈哈，看上去就像是害怕被「哥哥」骂的「弟弟」一样…你说，他是不是，其实怕的是我们对他失望…",
            "nextDialogs": [
              "790242216"
            ]
          },
          "790242216": {
            "id": "790242216",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "明明大家只是小队成员而已…但有的时候，感觉就跟「家人」一样啊…",
            "nextDialogs": [
              "790242217"
            ]
          },
          "790242217": {
            "id": "790242217",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "家人吗…",
            "nextDialogs": [
              "790242218"
            ]
          },
          "790242218": {
            "id": "790242218",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "家人…我已经没有家人了…",
            "nextDialogs": [
              "790242219"
            ]
          },
          "790242219": {
            "id": "790242219",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "…父亲让自己留在了危险的地方，让我得以脱身返回至冬。确认父亲无法归还后，他们送来了那枚徽记…",
            "nextDialogs": [
              "790242220"
            ]
          },
          "790242220": {
            "id": "790242220",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "可是我不想要那些奖赏和荣誉…我，我只想要我的家人…啊，父亲啊，为什么你独自把我留在这个世上呢…",
            "nextDialogs": [
              "790242221"
            ]
          },
          "790242221": {
            "id": "790242221",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "雅科夫。",
            "nextDialogs": [
              "790242240"
            ]
          },
          "790242240": {
            "id": "790242240",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "唔...头好痛，怎么了，阿加霞姐姐，你怎么在这...我们不是在不同的组吗...",
            "nextDialogs": [
              "790242222"
            ]
          },
          "790242222": {
            "id": "790242222",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "实验和任务都已经结束啦，雅科夫。",
            "nextDialogs": [
              "790242223"
            ]
          },
          "790242223": {
            "id": "790242223",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "没想到居然是「家人」啊…那我的推论也对了一半嘛！",
            "nextDialogs": [
              "790242224"
            ]
          },
          "790242224": {
            "id": "790242224",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "怎么、怎么都这样看着我，我是说了什么奇怪的话吗…",
            "nextDialogs": [
              "790242225"
            ]
          },
          "790242225": {
            "id": "790242225",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "没有，只是不小心听到了一些你的心里话而已。雅科夫，所谓的家人有的时候并不仅仅指血脉相连的人哦…",
            "nextDialogs": [
              "790242226"
            ]
          },
          "790242226": {
            "id": "790242226",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "嘿嘿，我觉得家人就是能一直在一起吃饭的人。",
            "nextDialogs": [
              "790242227"
            ]
          },
          "790242227": {
            "id": "790242227",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "…我，我知道啦。",
            "nextDialogs": [
              "790242228"
            ]
          },
          "790242228": {
            "id": "790242228",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "如果你愿意的话，你也可以将我视作你的父亲…",
            "nextDialogs": [
              "790242229"
            ]
          },
          "790242229": {
            "id": "790242229",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "不，这就有点恶心了…",
            "nextDialogs": [
              "790242230"
            ]
          },
          "790242230": {
            "id": "790242230",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，雅科夫恢复了！",
            "nextDialogs": [
              "790242231"
            ]
          },
          "790242231": {
            "id": "790242231",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "真是可喜可贺…",
            "nextDialogs": [
              "790242232"
            ]
          },
          "790242232": {
            "id": "790242232",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "咦，这两位，不是在内部文件里看到过的…",
            "nextDialogs": [
              "790242233"
            ]
          },
          "790242233": {
            "id": "790242233",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "其实之前就想问了…",
            "nextDialogs": [
              "790242236"
            ]
          },
          "790242236": {
            "id": "790242236",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "哎呀，没什么，上面都没什么重要的东西…",
            "nextDialogs": [
              "790242237"
            ]
          },
          "790242237": {
            "id": "790242237",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "对了雅科夫，如果没有他们帮忙，你说不定就没法恢复理智了！",
            "nextDialogs": [
              "790242238"
            ]
          },
          "790242238": {
            "id": "790242238",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "唔，虽然不知道发生了什么，但这次就谢谢你们了！",
            "nextDialogs": [
              "790242239"
            ]
          },
          "790242239": {
            "id": "790242239",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…还是有点在意，不过就算了，我们也算成功完成了「情报与委托的交易啦」。"
          }
        }
      }
    },
    {
      "subId": "7902410",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790241001"
        ],
        "dialogs": {
          "790241001": {
            "id": "790241001",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "怎么了，找不到海螺？我记得没错的话，我带着的那个海螺应该在<color=#00E1FFFF>西北方向的大岛</color>一个全是水的山洞里了。"
          }
        }
      }
    },
    {
      "subId": "7902411",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790241101"
        ],
        "dialogs": {
          "790241101": {
            "id": "790241101",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "我的海螺？我的海螺被扔进<color=#00E1FFFF>东北方向大岛</color>的井里啦，那井还蛮深的嘞…"
          }
        }
      }
    },
    {
      "subId": "7902412",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790241201"
        ],
        "dialogs": {
          "790241201": {
            "id": "790241201",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "我的那个海螺被我扔在<color=#00E1FFFF>南方大岛</color>遗迹边的山上了…",
            "nextDialogs": [
              "790241202"
            ]
          },
          "790241202": {
            "id": "790241202",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "真是羞愧啊，要是早知道海螺有那样的作用，就不带出营地了。"
          }
        }
      }
    },
    {
      "subId": "7902413",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790241301"
        ],
        "dialogs": {
          "790241301": {
            "id": "790241301",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "为什么…只留下我一个人…我的父亲啊…为什么…",
            "nextDialogs": [
              "790241302"
            ]
          },
          "790241302": {
            "id": "790241302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（看来还是不太清醒的样子…）"
          }
        }
      }
    },
    {
      "subId": "7902445",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790244501"
        ],
        "dialogs": {
          "790244501": {
            "id": "790244501",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "怎么样，我们知道的都告诉你了，有找到什么让雅科夫清醒过来的办法吗？",
            "nextDialogs": [
              "790244503",
              "790244505",
              "790244507"
            ]
          },
          "790244503": {
            "id": "790244503",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "不是都说了，我也不是很清楚嘛…可能只是一些简单的测试工作吧，只不过需要跑到各个岛上去，还挺累人的。"
          },
          "790244505": {
            "id": "790244505",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "扎哈尔是孤儿，很久以前父母就生病去世啦，据说过了很长一段苦日子，听说愚人众管伙食就加入愚人众了…"
          },
          "790244507": {
            "id": "790244507",
            "speakerId": 20620,
            "speakerName": "阿加菲娅",
            "text": "好吧，合照里的是我的两个哥哥，他们都曾经为至冬国做出过贡献…我一直，以他们为荣。"
          }
        }
      }
    },
    {
      "subId": "7902446",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790244601"
        ],
        "dialogs": {
          "790244601": {
            "id": "790244601",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "#唉，雅科夫，雅科夫该怎么办啊…{NICKNAME}，有什么头绪了吗？",
            "nextDialogs": [
              "790244603",
              "790244606"
            ]
          },
          "790244603": {
            "id": "790244603",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "怎么成为愚人众，你是说我吗…",
            "nextDialogs": [
              "790244604"
            ]
          },
          "790244604": {
            "id": "790244604",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "那当然是为了实现女皇大人的夙愿…以及为了我的家族能获得更多的荣誉，我从小就被教导要为女皇大人而战。"
          },
          "790244606": {
            "id": "790244606",
            "speakerId": 20622,
            "speakerName": "叶夫卡",
            "text": "唉，雅科夫好像没有清醒过来的迹象…"
          }
        }
      }
    },
    {
      "subId": "7902447",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790244701"
        ],
        "dialogs": {
          "790244701": {
            "id": "790244701",
            "speakerId": 20623,
            "speakerName": "雅科夫",
            "text": "为什么…只留下我一个人…我的父亲啊…为什么…",
            "nextDialogs": [
              "790244702"
            ]
          },
          "790244702": {
            "id": "790244702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（看来还是不太清醒的样子…）"
          }
        }
      }
    },
    {
      "subId": "7902448",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790244801"
        ],
        "dialogs": {
          "790244801": {
            "id": "790244801",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "啊，雅科夫…如果雅科夫能快点恢复就好了…",
            "nextDialogs": [
              "790244802"
            ]
          },
          "790244802": {
            "id": "790244802",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "虽然教官教导我们，愚人众都是至冬的士兵，为伟大的事业而献身，不应该产生多余的情感…",
            "nextDialogs": [
              "790244803"
            ]
          },
          "790244803": {
            "id": "790244803",
            "speakerId": 20621,
            "speakerName": "扎哈尔",
            "text": "可是，大家一起朝夕相处那么久…我脑子不好，不清楚，但真的有人对同伴一点感情都没有吗…"
          }
        }
      }
    },
    {
      "subId": "7903301",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790330101"
        ],
        "dialogs": {
          "790330101": {
            "id": "790330101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，影像居然正好放在舞台的中间…",
            "nextDialogs": [
              "790330102"
            ]
          },
          "790330102": {
            "id": "790330102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这两个人在干嘛呢…看上去就像是一个人在说什么，另一个人坐在地上…",
            "nextDialogs": [
              "790330103"
            ]
          },
          "790330103": {
            "id": "790330103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我知道了，这个一定是在讲故事的画面！他们一定是快要睡觉了，所以影像里她正在为坐在地上的人讲睡前故事…",
            "nextDialogs": [
              "790330104"
            ]
          },
          "790330104": {
            "id": "790330104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "愚人众也要听睡前故事吗…",
            "nextDialogs": [
              "790330105"
            ]
          },
          "790330105": {
            "id": "790330105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说不定愚人众里也有人有这种需要的嘛。",
            "nextDialogs": [
              "790330106"
            ]
          },
          "790330106": {
            "id": "790330106",
            "speakerId": 1010,
            "speakerName": "岩使游击兵的影像",
            "text": "阿加霞，佩尔西科夫大人让我们去做信号接收测试，是让我们四个一起去…叶夫卡要是听到这件事，又得生气不可…",
            "nextDialogs": [
              "790330107"
            ]
          },
          "790330107": {
            "id": "790330107",
            "speakerId": 1011,
            "speakerName": "藏镜仕女的影像",
            "text": "雅科夫，不会的，这是上面大人的命令，叶夫卡肯定也不会责怪你的…",
            "nextDialogs": [
              "790330108"
            ]
          },
          "790330108": {
            "id": "790330108",
            "speakerId": 1011,
            "speakerName": "藏镜仕女的影像",
            "text": "唉，你要是真这么害怕，我陪你去跟叶夫卡说。",
            "nextDialogs": [
              "790330109"
            ]
          },
          "790330109": {
            "id": "790330109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么嘛，原来不是在讲故事呀…",
            "nextDialogs": [
              "790330110"
            ]
          },
          "790330110": {
            "id": "790330110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过这段对话没头没尾的，根本什么都看不出来嘛…"
          }
        }
      }
    },
    {
      "subId": "7903302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790330201"
        ],
        "dialogs": {
          "790330201": {
            "id": "790330201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "海螺居然能够从井中浮起来…",
            "nextDialogs": [
              "790330204"
            ]
          },
          "790330204": {
            "id": "790330204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯，真是奇妙…啊，影像显示出来了，{NICKNAME}，你快看，那里有个弯腰的…哇！",
            "nextDialogs": [
              "790330205"
            ]
          },
          "790330205": {
            "id": "790330205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你不要动，你的身后…"
          }
        }
      }
    },
    {
      "subId": "7903303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790330301"
        ],
        "dialogs": {
          "790330301": {
            "id": "790330301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦，看上去像是两个人躺在地上呢…是在看天上的星星？",
            "nextDialogs": [
              "790330302"
            ]
          },
          "790330302": {
            "id": "790330302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总觉得是有点奇怪的影像呢…",
            "nextDialogs": [
              "790330303"
            ]
          },
          "790330303": {
            "id": "790330303",
            "speakerId": 1012,
            "speakerName": "水铳重卫士的影像",
            "text": "雅科夫，长官说了你些什么，你这么垂头丧气的。",
            "nextDialogs": [
              "790330304"
            ]
          },
          "790330304": {
            "id": "790330304",
            "speakerId": 1010,
            "speakerName": "岩使游击兵的影像",
            "text": "因为海浪颠簸，搬运仪器的时候摔了一跤，幸好我手快，仪器没事…",
            "nextDialogs": [
              "790330305"
            ]
          },
          "790330305": {
            "id": "790330305",
            "speakerId": 1010,
            "speakerName": "岩使游击兵的影像",
            "text": "但是长官还是训话说，要让我们小队去各个岛上做装置的信号接收测试，那可是最辛苦的任务…",
            "nextDialogs": [
              "790330306"
            ]
          },
          "790330306": {
            "id": "790330306",
            "speakerId": 1012,
            "speakerName": "水铳重卫士的影像",
            "text": "没关系，不必这么伤心，咱们什么累活没干过啊。别伤心啦，先吃点东西吧！",
            "nextDialogs": [
              "790330307"
            ]
          },
          "790330307": {
            "id": "790330307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们指着那么高的地方，是想要吃什么啊…",
            "nextDialogs": [
              "790330308"
            ]
          },
          "790330308": {
            "id": "790330308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道这个海螺…放歪了？"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7550001",
      "subQuestName": "前往观看「回声之子」的舞蹈活动",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "755000101"
        ],
        "dialogs": {
          "755000101": {
            "id": "755000101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇…",
            "nextDialogs": [
              "755000102"
            ]
          },
          "755000102": {
            "id": "755000102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "仔细看的时候才发现，台上这些「回声之子」跳的舞真厉害哇！人的身体居然能做出这么夸张的动作…",
            "nextDialogs": [
              "755000103"
            ]
          },
          "755000103": {
            "id": "755000103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "配合节奏感超强的音乐，还有刺激的火光，相比其他国家的艺术，有着完全不同的气质！",
            "nextDialogs": [
              "755000104"
            ]
          },
          "755000104": {
            "id": "755000104",
            "speakerId": 1001,
            "speakerName": "「炫彩呆子」",
            "text": "#这位容光焕发的{M#少年}{F#少女}，还有飘浮着的哇音玩偶。",
            "nextDialogs": [
              "755000105"
            ]
          },
          "755000105": {
            "id": "755000105",
            "speakerId": 1001,
            "speakerName": "「炫彩呆子」",
            "text": "我看你们感官敏锐，气质不凡，肯定能成为前卫艺术的先锋，涂鸦画师的超新星！",
            "nextDialogs": [
              "755000106"
            ]
          },
          "755000106": {
            "id": "755000106",
            "speakerId": 1001,
            "speakerName": "「炫彩呆子」",
            "text": "要跟着我「炫彩呆子」一起混，把握最新潮的艺术理念吗？",
            "nextDialogs": [
              "755000107"
            ]
          },
          "755000107": {
            "id": "755000107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇啊，又是奇怪的外号！",
            "nextDialogs": [
              "755000110"
            ]
          },
          "755000110": {
            "id": "755000110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这次我可不会被带偏了——重点不在于哇不哇，或者新外号，而是这个「炫彩呆子」说的话。",
            "nextDialogs": [
              "755000111"
            ]
          },
          "755000111": {
            "id": "755000111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「前卫的理念」，听起来好像是…纳塔艺术与众不同的关键点？",
            "nextDialogs": [
              "755000112"
            ]
          },
          "755000112": {
            "id": "755000112",
            "speakerId": 1001,
            "speakerName": "「炫彩呆子」",
            "text": "好悟性~",
            "nextDialogs": [
              "755000113"
            ]
          },
          "755000113": {
            "id": "755000113",
            "speakerId": 1001,
            "speakerName": "「炫彩呆子」",
            "text": "如你所见，富有张力的舞姿、律动跳脱的音乐、还有色彩鲜明的涂鸦，这些都离不开前卫理念的熏陶。",
            "nextDialogs": [
              "755000114"
            ]
          },
          "755000114": {
            "id": "755000114",
            "speakerId": 1001,
            "speakerName": "「炫彩呆子」",
            "text": "在纳塔人的口中，时尚、潮流、新奇之类的说法，全都是前卫理念的同义词。",
            "nextDialogs": [
              "755000115"
            ]
          },
          "755000115": {
            "id": "755000115",
            "speakerId": 1001,
            "speakerName": "「炫彩呆子」",
            "text": "而我「炫彩呆子」作为「涂鸦联盟」的中流砥柱，正尝试让更多人理解前卫，践行前卫，用前卫把世界碾一遍…",
            "nextDialogs": [
              "755000116"
            ]
          },
          "755000116": {
            "id": "755000116",
            "speakerId": 1001,
            "speakerName": "「炫彩呆子」",
            "text": "从而让更多艺术不断进步，创造出非同凡响的美学产物，画出更狂猛的大尺寸涂鸦稿！"
          }
        }
      }
    }
  ]
}
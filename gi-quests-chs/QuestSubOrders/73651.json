  "subQuests": [
    {
      "subId": "7365101",
      "subQuestName": "与悬崖边的怪人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736510101"
        ],
        "dialogs": {
          "736510101": {
            "id": "736510101",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "嘿嘿嘿，哈哈哈…",
            "nextDialogs": [
              "736510102"
            ]
          },
          "736510102": {
            "id": "736510102",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "大功告成了！接下来就是论证环节了！我要向大家证明，这就是炼金药剂的最强形态！",
            "nextDialogs": [
              "736510103"
            ]
          },
          "736510103": {
            "id": "736510103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…这个人怎么站在悬崖边傻笑？还不停自言自语？",
            "nextDialogs": [
              "736510104"
            ]
          },
          "736510104": {
            "id": "736510104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#我感觉心里毛毛的，{NICKNAME}，我们离这个怪人远一点吧。",
            "nextDialogs": [
              "736510107"
            ]
          },
          "736510107": {
            "id": "736510107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂喂，你也太替别人着想了吧？",
            "nextDialogs": [
              "736510108"
            ]
          },
          "736510108": {
            "id": "736510108",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "嗯？你们什么时候过来的？",
            "nextDialogs": [
              "736510109"
            ]
          },
          "736510109": {
            "id": "736510109",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "居然在背后议论别人，真没礼貌！",
            "nextDialogs": [
              "736510110"
            ]
          },
          "736510110": {
            "id": "736510110",
            "speakerId": 1002,
            "speakerName": "哈贾娜德",
            "text": "我可是悉般多摩学院的明日之星哈贾娜德！等我成为知名的学者，一定要写篇文章来埋汰你们…",
            "nextDialogs": [
              "736510111"
            ]
          },
          "736510111": {
            "id": "736510111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好凶！名字也好拗口！",
            "nextDialogs": [
              "736510112"
            ]
          },
          "736510112": {
            "id": "736510112",
            "speakerId": 1002,
            "speakerName": "哈贾娜德",
            "text": "等等？这个小家伙难道是…那篇奇闻上的「白色高智能浮游助手单元」？",
            "nextDialogs": [
              "736510113"
            ]
          },
          "736510113": {
            "id": "736510113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么胡说八道的奇闻，从没听过这种外号啦！",
            "nextDialogs": [
              "736510114"
            ]
          },
          "736510114": {
            "id": "736510114",
            "speakerId": 1002,
            "speakerName": "哈贾娜德",
            "text": "总之，带着「白色高智能浮游助手单元」的金发异乡人…不会错，我走运了。",
            "nextDialogs": [
              "736510115"
            ]
          },
          "736510115": {
            "id": "736510115",
            "speakerId": 1002,
            "speakerName": "哈贾娜德",
            "text": "呃咳！听我说，我可以让需要战斗的人变得更强。和我做个交易，怎么样？"
          }
        }
      }
    }
  ]
}
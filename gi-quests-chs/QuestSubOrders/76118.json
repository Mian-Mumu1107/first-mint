  },
  "subQuests": [
    {
      "subId": "7611801",
      "subQuestName": "同哥伦比娅见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761180101"
        ],
        "dialogs": {
          "761180101": {
            "id": "761180101",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "……",
            "nextDialogs": [
              "761180102"
            ]
          },
          "761180102": {
            "id": "761180102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你有没有闻到一股好香的味道…",
            "nextDialogs": [
              "761180103"
            ]
          },
          "761180103": {
            "id": "761180103",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "……",
            "nextDialogs": [
              "761180104"
            ]
          },
          "761180104": {
            "id": "761180104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哥伦比娅一个人在胡吃海喝！",
            "nextDialogs": [
              "761180105"
            ]
          },
          "761180105": {
            "id": "761180105",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "#{NICKNAME}，派蒙…",
            "nextDialogs": [
              "761180106"
            ]
          },
          "761180106": {
            "id": "761180106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她吃得好开心…",
            "nextDialogs": [
              "761180107"
            ]
          },
          "761180107": {
            "id": "761180107",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "你们要不要也尝一点？",
            "nextDialogs": [
              "761180108"
            ]
          },
          "761180108": {
            "id": "761180108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你吃你吃。",
            "nextDialogs": [
              "761180109"
            ]
          },
          "761180109": {
            "id": "761180109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难得看到你在这里吃东西的样子，是你特意从外面买回来的吗？",
            "nextDialogs": [
              "761180110"
            ]
          },
          "761180110": {
            "id": "761180110",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "是菈乌玛送来的。",
            "nextDialogs": [
              "761180111"
            ]
          },
          "761180111": {
            "id": "761180111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢！她还是很照顾你的嘛！",
            "nextDialogs": [
              "761180112"
            ]
          },
          "761180112": {
            "id": "761180112",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "前提是我不能离开这里。",
            "nextDialogs": [
              "761180113"
            ]
          },
          "761180113": {
            "id": "761180113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是软禁吧？！你就被这些东西收买了吗？！",
            "nextDialogs": [
              "761180114"
            ]
          },
          "761180114": {
            "id": "761180114",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "她还带了些有趣的书本、精巧的玩具…",
            "nextDialogs": [
              "761180115"
            ]
          },
          "761180115": {
            "id": "761180115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "简直像出差的妈妈和留守家中的孩子…",
            "nextDialogs": [
              "761180116"
            ]
          },
          "761180116": {
            "id": "761180116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "菈乌玛解释原因了吗？",
            "nextDialogs": [
              "761180117"
            ]
          },
          "761180117": {
            "id": "761180117",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "她让我最近都别出门，尤其不要去霜月之子那边。",
            "nextDialogs": [
              "761180118"
            ]
          },
          "761180118": {
            "id": "761180118",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "我问了来送餐的小动物们，但它们也受到了菈乌玛的指示，每一只都保持着沉默。",
            "nextDialogs": [
              "761180119"
            ]
          },
          "761180119": {
            "id": "761180119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这…",
            "nextDialogs": [
              "761180120"
            ]
          },
          "761180120": {
            "id": "761180120",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "我猜她可能是在准备什么吧，和我有关的。",
            "nextDialogs": [
              "761180121"
            ]
          },
          "761180121": {
            "id": "761180121",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "放心吧，我原本也不觉得待在这里有什么无聊的。饭菜好吃，合我胃口，不出门也挺好。",
            "nextDialogs": [
              "761180122"
            ]
          },
          "761180122": {
            "id": "761180122",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "况且，如果是霜月之子的大家在准备什么的话，我更不该出于好奇心而去打乱大家的计划。",
            "nextDialogs": [
              "761180123"
            ]
          },
          "761180123": {
            "id": "761180123",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要不我们去探探口风？",
            "nextDialogs": [
              "761180124"
            ]
          },
          "761180124": {
            "id": "761180124",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是啊，说得我也好奇了。",
            "nextDialogs": [
              "761180125"
            ]
          },
          "761180125": {
            "id": "761180125",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "可以呀，不过你们最好做点心理准备哦。",
            "nextDialogs": [
              "761180126"
            ]
          },
          "761180126": {
            "id": "761180126",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "她恐怕猜得出你们会来见我，可能什么都不会对你们讲。"
          }
        }
      }
    },
    {
      "subId": "7611802",
      "subQuestName": "同菈乌玛见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761180301"
        ],
        "dialogs": {
          "761180301": {
            "id": "761180301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "重修库塔尔神像？！",
            "nextDialogs": [
              "761180302"
            ]
          },
          "761180302": {
            "id": "761180302",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "正是。",
            "nextDialogs": [
              "761180303"
            ]
          },
          "761180303": {
            "id": "761180303",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "她不再是没有翅膀，只能孤独望着天外之月的「库塔{RUBY#[S]月之少女}尔」了。",
            "nextDialogs": [
              "761180304"
            ]
          },
          "761180304": {
            "id": "761180304",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "我们见证了她舒展双翼的模样，知晓了她重获生命的自由。",
            "nextDialogs": [
              "761180305"
            ]
          },
          "761180305": {
            "id": "761180305",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "所以，与之相对，神像也该好好修缮一番了。",
            "nextDialogs": [
              "761180306"
            ]
          },
          "761180306": {
            "id": "761180306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听着倒是不错呀。",
            "nextDialogs": [
              "761180307"
            ]
          },
          "761180307": {
            "id": "761180307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你告诉霜月之子其他人了吗？",
            "nextDialogs": [
              "761180308"
            ]
          },
          "761180308": {
            "id": "761180308",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "嗯。我为大家讲述了月神的牺牲与重临。",
            "nextDialogs": [
              "761180309"
            ]
          },
          "761180309": {
            "id": "761180309",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "以及在那片柔光的引领下，我们是如何对抗那污染世界的力量。",
            "nextDialogs": [
              "761180310"
            ]
          },
          "761180310": {
            "id": "761180310",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "对于月神回归这件事，众人无不喜悦。我便借此机会传达了哥伦比娅的想法。",
            "nextDialogs": [
              "761180311"
            ]
          },
          "761180311": {
            "id": "761180311",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "她想将我们视作家人，也想被我们看作是家人。",
            "nextDialogs": [
              "761180312"
            ]
          },
          "761180312": {
            "id": "761180312",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "大家怎么说？",
            "nextDialogs": [
              "761180313"
            ]
          },
          "761180313": {
            "id": "761180313",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "……",
            "nextDialogs": [
              "761180314"
            ]
          },
          "761180314": {
            "id": "761180314",
            "speakerId": 16098,
            "speakerName": "索妮齐娅",
            "text": "月神大人…",
            "nextDialogs": [
              "761180315"
            ]
          },
          "761180315": {
            "id": "761180315",
            "speakerId": 15476,
            "speakerName": "洛乌佳",
            "text": "把月神大人当家人这件事…真的不会太僭越吗？",
            "nextDialogs": [
              "761180316"
            ]
          },
          "761180316": {
            "id": "761180316",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "我相信，这正是哥伦比娅内心真实的愿望。",
            "nextDialogs": [
              "761180317"
            ]
          },
          "761180317": {
            "id": "761180317",
            "speakerId": 15475,
            "speakerName": "库涅贡妲",
            "text": "（咏月使大人竟然真的直接叫月神大人「哥伦比娅」！）",
            "nextDialogs": [
              "761180318"
            ]
          },
          "761180318": {
            "id": "761180318",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "诸位或许仍能记得，我前些时日说过的那句话。",
            "nextDialogs": [
              "761180319"
            ]
          },
          "761180319": {
            "id": "761180319",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "「路当以真相铺就，当由我们自己铺就。」",
            "nextDialogs": [
              "761180320"
            ]
          },
          "761180320": {
            "id": "761180320",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "我不会要求每个人都与我做出同等选择，但在今日，我也有一句良言想与各位分享。",
            "nextDialogs": [
              "761180321"
            ]
          },
          "761180321": {
            "id": "761180321",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "「如果想要邀请月光驻留，首先便需打开紧闭的门户。」",
            "nextDialogs": [
              "761180322"
            ]
          },
          "761180322": {
            "id": "761180322",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "…就是这样，根据这几天的情况来看，似乎比我预期的还要乐观一些。",
            "nextDialogs": [
              "761180323"
            ]
          },
          "761180323": {
            "id": "761180323",
            "speakerId": 15409,
            "speakerName": "马西捷",
            "text": "菈乌玛大人，新一批石材已经运到仓库了。",
            "nextDialogs": [
              "761180324"
            ]
          },
          "761180324": {
            "id": "761180324",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "知道了，我马上过去。",
            "nextDialogs": [
              "761180325"
            ]
          },
          "761180325": {
            "id": "761180325",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "刚才我说的话，包括你见到的这些景象，能暂时对哥伦比娅保密吗？我想为她准备一个惊喜。",
            "nextDialogs": [
              "761180326"
            ]
          },
          "761180326": {
            "id": "761180326",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我知道是好心啦，但你们月神和信奉月神的人还真是喜欢惊喜…",
            "nextDialogs": [
              "761180327"
            ]
          },
          "761180327": {
            "id": "761180327",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们会守密的。",
            "nextDialogs": [
              "761180328"
            ]
          },
          "761180328": {
            "id": "761180328",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个，菈乌玛，封口费…我是说，今天的飨月餐还有没有多余的…",
            "nextDialogs": [
              "761180329"
            ]
          },
          "761180329": {
            "id": "761180329",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "哈，我来为两位准备。对了，还有一件事…"
          }
        }
      }
    },
    {
      "subId": "7611803",
      "subQuestName": "向哥伦比娅回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761180401"
        ],
        "dialogs": {
          "761180401": {
            "id": "761180401",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "你们回来了。",
            "nextDialogs": [
              "761180402"
            ]
          },
          "761180402": {
            "id": "761180402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哥伦比娅，你猜得一点没错，菈乌玛她什么都没和我们说呢！",
            "nextDialogs": [
              "761180403"
            ]
          },
          "761180403": {
            "id": "761180403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她好像挺忙碌的。",
            "nextDialogs": [
              "761180404"
            ]
          },
          "761180404": {
            "id": "761180404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这几天我们会在这里陪你的！你就好好期待吧！",
            "nextDialogs": [
              "761180405"
            ]
          },
          "761180405": {
            "id": "761180405",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "期待什么？",
            "nextDialogs": [
              "761180406"
            ]
          },
          "761180406": {
            "id": "761180406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…！没，没什么，我们也不知道！",
            "nextDialogs": [
              "761180407"
            ]
          },
          "761180407": {
            "id": "761180407",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "呵呵…好吧，那我就先期待有你们相伴的这几天吧。",
            "nextDialogs": [
              "761180408"
            ]
          },
          "761180408": {
            "id": "761180408",
            "speakerId": 15521,
            "speakerName": "长翎鹮",
            "text": "！！",
            "nextDialogs": [
              "761180409"
            ]
          },
          "761180409": {
            "id": "761180409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢！送菜的来了。欸？菜呢？",
            "nextDialogs": [
              "761180410"
            ]
          },
          "761180410": {
            "id": "761180410",
            "speakerId": 15521,
            "speakerName": "长翎鹮",
            "text": "！！",
            "nextDialogs": [
              "761180411"
            ]
          },
          "761180411": {
            "id": "761180411",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "它说「时间到了」。你们知道是什么意思吗？",
            "nextDialogs": [
              "761180412"
            ]
          },
          "761180412": {
            "id": "761180412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢噢噢我明白了。",
            "nextDialogs": [
              "761180413"
            ]
          },
          "761180413": {
            "id": "761180413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哥伦比娅。",
            "nextDialogs": [
              "761180414"
            ]
          },
          "761180414": {
            "id": "761180414",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "嗯？",
            "nextDialogs": [
              "761180415"
            ]
          },
          "761180415": {
            "id": "761180415",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不是蒙着眼睛么？",
            "nextDialogs": [
              "761180416"
            ]
          },
          "761180416": {
            "id": "761180416",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "嗯，怎么了？",
            "nextDialogs": [
              "761180417"
            ]
          },
          "761180417": {
            "id": "761180417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但你蒙着眼睛也能用月矩力观察外界的模样对吗？",
            "nextDialogs": [
              "761180418"
            ]
          },
          "761180418": {
            "id": "761180418",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "没错，不如说，这样的感知还更清晰一些。",
            "nextDialogs": [
              "761180419"
            ]
          },
          "761180419": {
            "id": "761180419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那…那如果让你先别去感知外面发生了什么变化的话，可以吗？",
            "nextDialogs": [
              "761180420"
            ]
          },
          "761180420": {
            "id": "761180420",

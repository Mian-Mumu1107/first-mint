  "subQuests": [
    {
      "subId": "7468801",
      "subQuestName": "与警备队员们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746880101"
        ],
        "dialogs": {
          "746880101": {
            "id": "746880101",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "真是远超预期的作战结果！",
            "nextDialogs": [
              "746880102"
            ]
          },
          "746880102": {
            "id": "746880102",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "准领队和小助手，你们击败的魔物已经达到了整编连队的级别！目前看来，遗迹里的魔物完全不可能外逃了。",
            "nextDialogs": [
              "746880103"
            ]
          },
          "746880103": {
            "id": "746880103",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "感觉怎么样？辛苦吗？",
            "nextDialogs": [
              "746880105",
              "746880108"
            ]
          },
          "746880105": {
            "id": "746880105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，炮口的闪光，虽然不至于特别亮，但看久了，还是有点头晕…",
            "nextDialogs": [
              "746880106"
            ]
          },
          "746880106": {
            "id": "746880106",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "这个好说！有论文提到过，可以通过炮口装置抑制闪焰，改善长期射击的视觉疲劳。",
            "nextDialogs": [
              "746880110"
            ]
          },
          "746880110": {
            "id": "746880110",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "总之，危机解决了，收集到的资料也足够了，我肯定可以把下一代重炮改进得更完善！",
            "nextDialogs": [
              "746880111"
            ]
          },
          "746880111": {
            "id": "746880111",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "实在感谢你们的支援，准领队和小助手！",
            "nextDialogs": [
              "746880112"
            ]
          },
          "746880112": {
            "id": "746880112",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "还有在准领队到来前，起了决定性作用的玛因小姐，奖金都给准领队，我这边卖出重炮后的收益就分你一半好了！",
            "nextDialogs": [
              "746880113"
            ]
          },
          "746880113": {
            "id": "746880113",
            "speakerId": 30839,
            "speakerName": "玛因",
            "text": "啊，还有我的份吗？",
            "nextDialogs": [
              "746880114"
            ]
          },
          "746880114": {
            "id": "746880114",
            "speakerId": 30839,
            "speakerName": "玛因",
            "text": "摩拉什么的无所谓了，不如给我准备一些酒酿汐藻…要小麦酒基底的，不能用果酒。",
            "nextDialogs": [
              "746880115"
            ]
          },
          "746880115": {
            "id": "746880115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有这种小吃吗？听名字，我都有点想试试看了…"
          },
          "746880108": {
            "id": "746880108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我也一样！耳朵嗡嗡的…好像有一千只渔鸥在嚷嚷！",
            "nextDialogs": [
              "746880109"
            ]
          },
          "746880109": {
            "id": "746880109",
            "speakerId": 30509,
            "speakerName": "弗雷瑞斯",
            "text": "我有办法！有个工程废案提到过，可以通过多腔体的膛口装置减速燃气，降低开火时的噪音，就是材料比较贵…"
          }
        }
      }
    }
  ]
}
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401251101"
        ],
        "dialogs": {
          "401251101": {
            "id": "401251101",
            "speakerId": 1004,
            "speakerName": "凯亚",
            "text": "珊瑚宫小姐不打算把那个贝壳带回去吗？",
            "nextDialogs": [
              "401251102"
            ]
          },
          "401251102": {
            "id": "401251102",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "我反倒觉得，保存在伊迪娅小姐这里会更合适一些。",
            "nextDialogs": [
              "401251103"
            ]
          },
          "401251103": {
            "id": "401251103",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "如今的海祇岛已经有了新的「宝物」，人们的愿望也正慢慢被实现。",
            "nextDialogs": [
              "401251104"
            ]
          },
          "401251104": {
            "id": "401251104",
            "speakerId": 1037,
            "speakerName": "珊瑚宫心海",
            "text": "不如就让它守护着这瓶中的蜃境，陪伴着路过旅人们的梦想吧。"
          }
        }
      }
    },
    {
      "subId": "4012512",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401251201"
        ],
        "dialogs": {
          "401251201": {
            "id": "401251201",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "如果从阿如村走的话…就能够途经喀万驿，禅那园…绕道去须弥城…",
            "nextDialogs": [
              "401251202"
            ]
          },
          "401251202": {
            "id": "401251202",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "原来如此…",
            "nextDialogs": [
              "401251203"
            ]
          },
          "401251203": {
            "id": "401251203",
            "speakerId": 13253,
            "speakerName": "莱斯格",
            "text": "要顺路买什么东西吗？你们只管选礼物，我来负责提！",
            "nextDialogs": [
              "401251204"
            ]
          },
          "401251204": {
            "id": "401251204",
            "speakerId": 13253,
            "speakerName": "莱斯格",
            "text": "只要手里拿得下，多重都没问题！",
            "nextDialogs": [
              "401251205"
            ]
          },
          "401251205": {
            "id": "401251205",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "哪有那么多人要送…",
            "nextDialogs": [
              "401251206"
            ]
          },
          "401251206": {
            "id": "401251206",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "妈妈，阿贝多哥哥，琴团长，雷泽…还有迪奥娜姐姐，莫娜姐姐，菲谢尔姐姐…",
            "nextDialogs": [
              "401251207"
            ]
          },
          "401251207": {
            "id": "401251207",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "看我干嘛？",
            "nextDialogs": [
              "401251208"
            ]
          },
          "401251208": {
            "id": "401251208",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "没什么，没什么。",
            "nextDialogs": [
              "401251209"
            ]
          },
          "401251209": {
            "id": "401251209",
            "speakerId": 1051,
            "speakerName": "柯莱",
            "text": "可莉想给大家选什么样的礼物呢？",
            "nextDialogs": [
              "401251210"
            ]
          },
          "401251210": {
            "id": "401251210",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "要…要日落果味道的糖！还有蕈兽那样的大帽子，还有还有…",
            "nextDialogs": [
              "401251211"
            ]
          },
          "401251211": {
            "id": "401251211",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "可莉要买很多很多故事书送给大家！",
            "nextDialogs": [
              "401251212"
            ]
          },
          "401251212": {
            "id": "401251212",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "但送给妈妈的礼物，可莉还没想好…",
            "nextDialogs": [
              "401251213"
            ]
          },
          "401251213": {
            "id": "401251213",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "没关系，边走边看，姐姐们也会帮忙的。",
            "nextDialogs": [
              "401251214"
            ]
          },
          "401251214": {
            "id": "401251214",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "嗯！谢谢姐姐！"
          }
        }
      }
    }
  ]
}
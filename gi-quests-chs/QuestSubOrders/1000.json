    },
    {
      "subId": "100015",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10001501"
        ],
        "dialogs": {
          "10001501": {
            "id": "10001501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这…这究竟是怎么回事？！",
            "nextDialogs": [
              "10001502"
            ]
          },
          "10001502": {
            "id": "10001502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "她说「帝君遇害」…",
            "nextDialogs": [
              "10001503"
            ]
          },
          "10001503": {
            "id": "10001503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难道岩之神…死…死了？！",
            "nextDialogs": [
              "10001504"
            ]
          },
          "10001504": {
            "id": "10001504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，是「千岩军」！看来他们正在盘问过分靠近现场的可疑人士…",
            "nextDialogs": [
              "10001505"
            ]
          },
          "10001505": {
            "id": "10001505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "太可怕了，凶手就在我们中间…",
            "nextDialogs": [
              "10001506"
            ]
          },
          "10001506": {
            "id": "10001506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起来…我们好像就是过分靠近现场的可疑人士？！",
            "nextDialogs": [
              "10001507"
            ]
          },
          "10001507": {
            "id": "10001507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？你要去哪里？"
          }
        }
      }

    {
      "subId": "100013",
      "subQuestName": "与陌生男子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10001301"
        ],
        "dialogs": {
          "10001301": {
            "id": "10001301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呼…呼…跑得好累…",
            "nextDialogs": [
              "10001304"
            ]
          },
          "10001304": {
            "id": "10001304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "缺乏同情心！我的幻肢明明就跑得很累——啊！对了！",
            "nextDialogs": [
              "10001305"
            ]
          },
          "10001305": {
            "id": "10001305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这位小哥，你是谁啊？",
            "nextDialogs": [
              "10001306"
            ]
          },
          "10001306": {
            "id": "10001306",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "你们可以叫我「公子」喔。",
            "nextDialogs": [
              "10001307"
            ]
          },
          "10001307": {
            "id": "10001307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇…性格好糟糕，救过我们一次就把我们当仆人？",
            "nextDialogs": [
              "10001308"
            ]
          },
          "10001308": {
            "id": "10001308",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "哈哈，我没有那个意思。「名字」这种东西啊，只是代号而已。就好像…",
            "nextDialogs": [
              "10001309"
            ]
          },
          "10001309": {
            "id": "10001309",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "你们，应该在蒙德见过「女士」吧？",
            "nextDialogs": [
              "10001310"
            ]
          },
          "10001310": {
            "id": "10001310",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「女士」…「公子」…",
            "nextDialogs": [
              "10001311"
            ]
          },
          "10001311": {
            "id": "10001311",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你是「愚人众」的执行官？！",
            "nextDialogs": [
              "10001312"
            ]
          },
          "10001312": {
            "id": "10001312",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "啊，不要紧张。我不是来找你们打架的。",
            "nextDialogs": [
              "10001313"
            ]
          },
          "10001313": {
            "id": "10001313",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "「女士」给你们留下了很不好的印象吧？唉，那个女人…我也不喜欢她。",
            "nextDialogs": [
              "10001314"
            ]
          },
          "10001314": {
            "id": "10001314",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "好了，我们大家就先忘记那个女人的所作所为吧！我是来帮助你们的。"
          }
        }
      }
    },
    {
      "subId": "100014",
      "subQuestName": "在北国银行与「公子」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10001401"
        ],
        "dialogs": {
          "10001401": {
            "id": "10001401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "北国银行…",
            "nextDialogs": [
              "10001402"
            ]
          },
          "10001402": {
            "id": "10001402",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "没错，这里就是至冬国在璃月开设的银行。",
            "nextDialogs": [
              "10001403"
            ]
          },
          "10001403": {
            "id": "10001403",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "虽然璃月是提瓦特最重要的商业中心，但我们国家也是很有钱的。",
            "nextDialogs": [
              "10001404"
            ]
          },
          "10001404": {
            "id": "10001404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是哦，穷国也养不起那种对西风骑士团蹬鼻子上脸的外交官呢。",
            "nextDialogs": [
              "10001405"
            ]
          },
          "10001405": {
            "id": "10001405",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "呵呵呵。",
            "nextDialogs": [
              "10001406"
            ]
          },
          "10001406": {
            "id": "10001406",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "来，给你这个。",
            "nextDialogs": [
              "10001407"
            ]
          },
          "10001407": {
            "id": "10001407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这是…",
            "nextDialogs": [
              "10001408"
            ]
          },
          "10001408": {
            "id": "10001408",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "谁知道呢？有时候用钱只能买到「东西」，却买不到「名字」。",
            "nextDialogs": [
              "10001409"
            ]
          },
          "10001409": {
            "id": "10001409",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "简单来说，这东西是一种信物。让「三眼五显仙人」不会伤害你的信物。",
            "nextDialogs": [
              "10001410"
            ]
          },
          "10001410": {
            "id": "10001410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你说…仙人？",
            "nextDialogs": [
              "10001411"
            ]
          },
          "10001411": {
            "id": "10001411",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "出城向北，在归离原之西，有一座石林，它的名字是「绝云间」。",
            "nextDialogs": [
              "10001412"
            ]
          },
          "10001412": {
            "id": "10001412",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "璃月人相信，那是仙人洞府所在。",
            "nextDialogs": [
              "10001415"
            ]
          },
          "10001415": {
            "id": "10001415",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "没错，他们相信传说，所以只在绝云间的外围供奉仙人，不敢继续深入。",
            "nextDialogs": [
              "10001416"
            ]
          },
          "10001416": {
            "id": "10001416",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "但我不需要「相信」——因为我「知道」，绝云间的仙人是真实存在的。",
            "nextDialogs": [
              "10001417"
            ]
          },
          "10001417": {
            "id": "10001417",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来愚人众的情报网很有用呢…但，你要我们去找仙人做什么呢？",
            "nextDialogs": [
              "10001418"
            ]
          },
          "10001418": {
            "id": "10001418",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "嘿，小家伙，你觉得世人求仙，能有多少理由呢？",
            "nextDialogs": [
              "10001419"
            ]
          },
          "10001419": {
            "id": "10001419",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "无非有人求财，有人求医，有人求姻缘…而你们就是为了——求个公道。",
            "nextDialogs": [
              "10001420"
            ]
          },
          "10001420": {
            "id": "10001420",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "公道？",
            "nextDialogs": [
              "10001421"
            ]
          },
          "10001421": {
            "id": "10001421",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "七星派出千岩军，要在观礼人士里寻找刺客。",
            "nextDialogs": [
              "10001422"
            ]
          },
          "10001422": {
            "id": "10001422",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "但凡人能够刺杀那位横扫千军的武神吗？岩王帝君可没有抛弃过自己的神力。",
            "nextDialogs": [
              "10001423"
            ]
          },
          "10001423": {
            "id": "10001423",
            "speakerId": 1008,
            "speakerName": "「公子」",
            "text": "这种粗糙的应对，可不符合他们应有的水准。令人怀疑…"
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "7012101",
      "subQuestName": "(test)(隐藏)获得任意一个信物碎片$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701210101"
        ],
        "dialogs": {
          "701210101": {
            "id": "701210101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？这是什么？是一本…日志？",
            "nextDialogs": [
              "701210102"
            ]
          },
          "701210102": {
            "id": "701210102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看起来，好像是以前在这里考察的人留下的记录…",
            "nextDialogs": [
              "701210103"
            ]
          },
          "701210103": {
            "id": "701210103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，可能有人对这些…嗯，历史记录感兴趣，我们去问问吧。"
          }
        }
      }
    },
    {
      "subId": "7012102",
      "subQuestName": "(test)(隐藏)与派蒙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7012103",
      "subQuestName": "回到大本营，向学者询问和日志有关的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701210201"
        ],
        "dialogs": {
          "701210201": {
            "id": "701210201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我找到了这本日志…",
            "nextDialogs": [
              "701210202"
            ]
          },
          "701210202": {
            "id": "701210202",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "嗯？在雪山上找到的？让我看看…",
            "nextDialogs": [
              "701210203"
            ]
          },
          "701210203": {
            "id": "701210203",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "喔！这可真是了不得的宝藏。",
            "nextDialogs": [
              "701210204"
            ]
          },
          "701210204": {
            "id": "701210204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "宝藏？",
            "nextDialogs": [
              "701210205"
            ]
          },
          "701210205": {
            "id": "701210205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "宝藏！",
            "nextDialogs": [
              "701210206"
            ]
          },
          "701210206": {
            "id": "701210206",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "…学术意义上的宝藏。",
            "nextDialogs": [
              "701210207"
            ]
          },
          "701210207": {
            "id": "701210207",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "我以前游学的时候，曾经读过一些古老的年鉴。",
            "nextDialogs": [
              "701210208"
            ]
          },
          "701210208": {
            "id": "701210208",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "一本年鉴上有记载，在骑士团的时代前，蒙德曾经有一支贵族向雪山派出了考察队。",
            "nextDialogs": [
              "701210209"
            ]
          },
          "701210209": {
            "id": "701210209",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "但是不知道为什么，在那本年鉴里，关于那支考察团的事，并没有过多的细节记载…",
            "nextDialogs": [
              "701210210"
            ]
          },
          "701210210": {
            "id": "701210210",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "如果这些考察日志真是那支考察队留下的，一定能成为重要的历史研究参考。",
            "nextDialogs": [
              "701210211"
            ]
          },
          "701210211": {
            "id": "701210211",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "如果你愿意的话，能帮我再去雪山上搜索一下这些日志吗？",
            "nextDialogs": [
              "701210213",
              "701210215"
            ]
          },
          "701210213": {
            "id": "701210213",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "真的吗？太感谢了！",
            "nextDialogs": [
              "701210217"
            ]
          },
          "701210217": {
            "id": "701210217",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "根据这篇日志…考察队为了考察，总共去了这座雪山里的三个地方…",
            "nextDialogs": [
              "701210218"
            ]
          },
          "701210218": {
            "id": "701210218",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "排除你们拿到日志的那一个，应该还有两个…",
            "nextDialogs": [
              "701210219"
            ]
          },
          "701210219": {
            "id": "701210219",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "我看看…这里…还有这里…嗯，我给你在地图上标记一下。",
            "nextDialogs": [
              "701210220"
            ]
          },
          "701210220": {
            "id": "701210220",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "那就拜托你了。一定要注意安全。"
          },
          "701210215": {
            "id": "701210215",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "哈哈哈，物质意义上的宝藏不一定有。",
            "nextDialogs": [
              "701210216"
            ]
          },
          "701210216": {
            "id": "701210216",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "不过，如果你们肯帮忙。我也会准备好合适的…物质上的报酬，犒劳你对学术研究的伟大贡献。"
          }
        }
      }
    },

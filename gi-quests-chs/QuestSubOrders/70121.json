    {
      "subId": "7012107",
      "subQuestName": "将收集到的日志交给史蒂文斯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701210301"
        ],
        "dialogs": {
          "701210301": {
            "id": "701210301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于日志…",
            "nextDialogs": [
              "701210302"
            ]
          },
          "701210302": {
            "id": "701210302",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "你把剩下的两份日志也找到了？真是太感谢了。让我看看…",
            "nextDialogs": [
              "701210303"
            ]
          },
          "701210303": {
            "id": "701210303",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "嗯…居然是这样…等等，这里的细节…",
            "nextDialogs": [
              "701210304"
            ]
          },
          "701210304": {
            "id": "701210304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你发现什么了？",
            "nextDialogs": [
              "701210305"
            ]
          },
          "701210305": {
            "id": "701210305",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "啊…哦，不好意思，刚刚有些走神了。",
            "nextDialogs": [
              "701210306"
            ]
          },
          "701210306": {
            "id": "701210306",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "谢谢你，这些日志确实是相当宝贵的史料。在已有的资料里，对于那支神秘的贵族探险队一直语焉不详，所有细节都只是一笔带过…",
            "nextDialogs": [
              "701210307"
            ]
          },
          "701210307": {
            "id": "701210307",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "你带来的这些日志，补全了不少缺失的信息。",
            "nextDialogs": [
              "701210308"
            ]
          },
          "701210308": {
            "id": "701210308",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "这么一来，为什么关于这支考察队的消息如此匮乏，在所有史料中只提过考察队出发的事情，一切都说得通了。",
            "nextDialogs": [
              "701210309"
            ]
          },
          "701210309": {
            "id": "701210309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实，大体上能明白。",
            "nextDialogs": [
              "701210310"
            ]
          },
          "701210310": {
            "id": "701210310",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "是的，虽然一些细节还需要再考证一下…但大体的框架已经很清楚了。",
            "nextDialogs": [
              "701210311"
            ]
          },
          "701210311": {
            "id": "701210311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "派蒙不明白！",
            "nextDialogs": [
              "701210312"
            ]
          },
          "701210312": {
            "id": "701210312",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "从结果而言，考察队里似乎没有一个人回到蒙德。但从这些日志上来看，至少有一个叫厄伯哈特的人可能逃了回来…",
            "nextDialogs": [
              "701210313"
            ]
          },
          "701210313": {
            "id": "701210313",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "不过，蒙德城里却没有与之相关的资料记载，这个人到底去了哪呢，真是让人在意…",
            "nextDialogs": [
              "701210314"
            ]
          },
          "701210314": {
            "id": "701210314",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "还有很多细节需要考证…",
            "nextDialogs": [
              "701210315"
            ]
          },
          "701210315": {
            "id": "701210315",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "但无论如何，这都是非常宝贵的史料。",
            "nextDialogs": [
              "701210316"
            ]
          },
          "701210316": {
            "id": "701210316",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "真的很感谢你。请你收下这些，作为报酬。",
            "nextDialogs": [
              "701210317"
            ]
          },
          "701210317": {
            "id": "701210317",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "如果在雪山冒险时，发现了其他的书籍，还请你带到我这来。",
            "nextDialogs": [
              "701210318"
            ]
          },
          "701210318": {
            "id": "701210318",
            "speakerId": 1001,
            "speakerName": "史蒂文斯",
            "text": "那个叫做厄伯哈特的人，到底去了哪呢…"
          }
        }
      }
    }
  ]
}
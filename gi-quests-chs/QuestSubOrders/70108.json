    {
      "subId": "7010804",
      "subQuestName": "向艾斯特尔回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701080301"
        ],
        "dialogs": {
          "701080301": {
            "id": "701080301",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "你把信标放好了吗？",
            "nextDialogs": [
              "701080302"
            ]
          },
          "701080302": {
            "id": "701080302",
            "speakerId": 1001,
            "speakerName": "玩家",
            "text": "已经放好了。",
            "nextDialogs": [
              "701080303"
            ]
          },
          "701080303": {
            "id": "701080303",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "太好了，谢谢你，这样我一定能勘测到雪山的高度。",
            "nextDialogs": [
              "701080304"
            ]
          },
          "701080304": {
            "id": "701080304",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "啊，对了，你的报酬我已经拜托塞琉斯先生准备好了，你去城里找他拿一下吧。",
            "nextDialogs": [
              "701080305"
            ]
          },
          "701080305": {
            "id": "701080305",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "然后，顺便帮我把这封信带给他，他答应我帮忙留意第二支要进山的探险队，结果到现在也没有消息。",
            "nextDialogs": [
              "701080306"
            ]
          },
          "701080306": {
            "id": "701080306",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "那些信标修好了之后，我还得再进山把它们安置一遍。这座雪山上还有很多东西要勘测呢。"
          }
        }
      }
    },
    {
      "subId": "7010805",
      "subQuestName": "将信带给塞琉斯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701080401"
        ],
        "dialogs": {
          "701080401": {
            "id": "701080401",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "你好，有什么事吗？",
            "nextDialogs": [
              "701080402"
            ]
          },
          "701080402": {
            "id": "701080402",
            "speakerId": 1001,
            "speakerName": "玩家",
            "text": "这封信是给你的。",
            "nextDialogs": [
              "701080403"
            ]
          },
          "701080403": {
            "id": "701080403",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "信？哦…是她的啊，我知道了，肯定又是来问我有关探险队的事…",
            "nextDialogs": [
              "701080404"
            ]
          },
          "701080404": {
            "id": "701080404",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "唉，这事我也没办法，现在没几支探险队会去雪山里探险，那地方实在是太危险了…",
            "nextDialogs": [
              "701080405"
            ]
          },
          "701080405": {
            "id": "701080405",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "我等一下会自己写封信给她，把情况和她说明一下，谢谢你专门送信过来。",
            "nextDialogs": [
              "701080406"
            ]
          },
          "701080406": {
            "id": "701080406",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "哦对了，这是她之前写信过来让我给你准备的报酬，你就收下吧。",
            "nextDialogs": [
              "701080407"
            ]
          },
          "701080407": {
            "id": "701080407",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "还有…我多说一句，虽然你看起来身手不错，但在雪山里活动，还是要格外小心才好。",
            "nextDialogs": [
              "701080410"
            ]
          },
          "701080410": {
            "id": "701080410",
            "speakerId": 1409,
            "speakerName": "塞琉斯",
            "text": "唉，雪山…要是有机会的话，我一定要亲自领队进山看看。"
          }
        }
      }
    },
    {
      "subId": "7010805",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701080501"

            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "只要把信标放在山顶上，一定能缩小不少勘测误差…"
          }
        }
      }
    },
    {
      "subId": "7010806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701080601"
        ],
        "dialogs": {
          "701080601": {
            "id": "701080601",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "唉，到底什么时候我才能再进雪山呢…"
          }
        }
      }
    }

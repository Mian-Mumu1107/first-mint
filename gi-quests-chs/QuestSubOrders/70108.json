  "subQuests": [
    {
      "subId": "7010801",
      "subQuestName": "与艾斯特尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701080101"
        ],
        "dialogs": {
          "701080101": {
            "id": "701080101",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "唉，只用这些信标，果然还是不能准确勘测雪山的高度啊，这误差也太大了…",
            "nextDialogs": [
              "701080102"
            ]
          },
          "701080102": {
            "id": "701080102",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "除非…",
            "nextDialogs": [
              "701080103"
            ]
          },
          "701080103": {
            "id": "701080103",
            "speakerId": 1001,
            "speakerName": "玩家",
            "text": "除非…",
            "nextDialogs": [
              "701080104"
            ]
          },
          "701080104": {
            "id": "701080104",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "除非，有一位勇敢的冒险家能帮我把这枚信标直接放到山顶上。",
            "nextDialogs": [
              "701080107"
            ]
          },
          "701080107": {
            "id": "701080107",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "拜托你了！再帮帮我吧，我的信标被怪物弄坏太多，只有这种方法能缩小勘测误差了。",
            "nextDialogs": [
              "701080108"
            ]
          },
          "701080108": {
            "id": "701080108",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "只要把这枚信标放在雪山顶上就可以了，报酬我一定会准备好的，只有你能帮我这个忙了！"
          }
        }
      }
    },
    {
      "subId": "7010802",
      "subQuestName": "将勘测信标放置在雪山山顶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701080201"
        ],
        "dialogs": {
          "701080201": {
            "id": "701080201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜…这，这样应该就可，可以了…",
            "nextDialogs": [
              "701080202"
            ]
          },
          "701080202": {
            "id": "701080202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好冷…我们还是快点下去吧…"
          }
        }
      }
    },
    {
      "subId": "7010803",

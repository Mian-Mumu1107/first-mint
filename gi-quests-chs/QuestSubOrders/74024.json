    {
      "subId": "7402421",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740242101"
        ],
        "dialogs": {
          "740242101": {
            "id": "740242101",
            "speakerId": 1000,
            "speakerName": "希露艾",
            "text": "总之，非常感谢二位的帮助。",
            "nextDialogs": [
              "740242102"
            ]
          },
          "740242102": {
            "id": "740242102",
            "speakerId": 1000,
            "speakerName": "希露艾",
            "text": "#但是，{NICKNAME}大人，我不能随便拿走您的东西。所以，只要知道材料的名字就好了，我之后会自己想办法找来的。",
            "nextDialogs": [
              "740242103"
            ]
          },
          "740242103": {
            "id": "740242103",
            "speakerId": 1000,
            "speakerName": "希露艾",
            "text": "只不过，这样的「金色」会不会有些太浓了呢？",
            "nextDialogs": [
              "740242104"
            ]
          },
          "740242104": {
            "id": "740242104",
            "speakerId": 1000,
            "speakerName": "希露艾",
            "text": "「太阳的色彩」，应该比这个更淡一些…",
            "nextDialogs": [
              "740242105"
            ]
          },
          "740242105": {
            "id": "740242105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "更淡一些，是说偏白吗？",
            "nextDialogs": [
              "740242106"
            ]
          },
          "740242106": {
            "id": "740242106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这么一说，比起「金色」，「太阳」好像确实更接近「白色」…",
            "nextDialogs": [
              "740242107"
            ]
          },
          "740242107": {
            "id": "740242107",
            "speakerId": 1000,
            "speakerName": "希露艾",
            "text": "「白色」…是吗？不过，我不清楚，究竟要用什么样的材料，才能制作出那种更淡的色彩…",
            "nextDialogs": [
              "740242109",
              "740242112"
            ]
          },
          "740242109": {
            "id": "740242109",
            "speakerId": 1000,
            "speakerName": "希露艾",
            "text": "掺水的话…之前也尝试过，但效果并不是太好。用这种方法做出来的颜料，总是灰蒙蒙的，没有太阳那种明亮的感觉…",
            "nextDialogs": [
              "740242110"
            ]
          },
          "740242110": {
            "id": "740242110",
            "speakerId": 1000,
            "speakerName": "希露艾",
            "text": "所以，如果可以的话，还是希望用其他材料作为辅助…",
            "nextDialogs": [
              "740242114"
            ]
          },
          "740242114": {
            "id": "740242114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，明亮的、白色的东西，我们应该也经常能见到…"
          },
          "740242112": {
            "id": "740242112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "头发是没有办法做颜料的啦！",
            "nextDialogs": [
              "740242113"
            ]
          },
          "740242113": {
            "id": "740242113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不对，就算真的能做，也不能随便拔我的头发吧？！"
          }
        }
      }
    },
    {

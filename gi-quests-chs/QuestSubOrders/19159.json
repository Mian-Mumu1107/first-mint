    {
      "subId": "1915901",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191590197"
        ],
        "dialogs": {
          "191590197": {
            "id": "191590197",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你知道「大工机」吗？",
            "nextDialogs": [
              "191590198"
            ]
          },
          "191590198": {
            "id": "191590198",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "讲一讲四轨偏移的情况吧。",
            "nextDialogs": [
              "191590199"
            ]
          },
          "191590199": {
            "id": "191590199",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "简单阐述一下三轨偏移推算法则的适用情况吧。"
          }
        }
      }
    },
    {
      "subId": "1915907",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191590701"
        ],
        "dialogs": {
          "191590701": {
            "id": "191590701",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "我现在就开始写笔记，有什么好奇的问题的话，我可以边写边回答，一心多用我已经习惯了。",
            "nextDialogs": [
              "191590702"
            ]
          },
          "191590702": {
            "id": "191590702",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "哦对了，还要拜托你，虽然等下需要你帮我把笔记交给她，但千万不要透露我的存在。",
            "nextDialogs": [
              "191590703"
            ]
          },
          "191590703": {
            "id": "191590703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是为什么？",
            "nextDialogs": [
              "191590704"
            ]
          },
          "191590704": {
            "id": "191590704",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "唔，简单来说，因为她本来就很妄自菲薄，如果了解到另一个「莱依拉」能把所有事都处理好…",
            "nextDialogs": [
              "191590705"
            ]
          },
          "191590705": {
            "id": "191590705",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "可能她就会觉得一直以来的努力毫无意义，产生自暴自弃的想法。",
            "nextDialogs": [
              "191590706"
            ]
          },
          "191590706": {
            "id": "191590706",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "她是个很坚韧的女孩子，但再怎么坚韧也无法经受自我的折磨。",
            "nextDialogs": [
              "191590707"
            ]
          },
          "191590707": {
            "id": "191590707",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "如果她继续变得脆弱，那可能我也会不复存在，那样就没人能帮她了。",
            "nextDialogs": [
              "191590708"
            ]
          },
          "191590708": {
            "id": "191590708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可她现在的状态也不算好。",
            "nextDialogs": [
              "191590709"
            ]
          },
          "191590709": {
            "id": "191590709",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "正在一点点变好，不是吗？你也看在眼里了吧，她的努力。",
            "nextDialogs": [
              "191590710"
            ]
          },
          "191590710": {
            "id": "191590710",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "我的知识来源于她，我所展现出来的能力，象征着她休息充分，内心健康时的理想状态。",
            "nextDialogs": [
              "191590711"
            ]
          },
          "191590711": {
            "id": "191590711",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "我觉得就算是在教令院这种天才云集的地方，她也是非常优秀的那一个。",
            "nextDialogs": [
              "191590712"
            ]
          },
          "191590712": {
            "id": "191590712",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "只不过成长是循序渐进的过程，不应该操之过急，我始终很相信她，也一定会支持她。",
            "nextDialogs": [
              "191590713"
            ]
          },
          "191590713": {
            "id": "191590713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应该说幸好有你，才让她不至于跌落谷底。",
            "nextDialogs": [
              "191590714"
            ]
          },
          "191590714": {
            "id": "191590714",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "哈哈哈，相信我，就算掉进了谷底，她也会一边开自己的玩笑一边爬上来的。",
            "nextDialogs": [
              "191590715"
            ]
          },
          "191590715": {
            "id": "191590715",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "她就是这样的人啊。",
            "nextDialogs": [
              "191590716"
            ]
          },
          "191590716": {
            "id": "191590716",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "好了，我写下了所有我觉得导师可能会问的问题，接下来我还想写一些表扬和鼓励她的话。",
            "nextDialogs": [
              "191590717"
            ]
          },
          "191590717": {
            "id": "191590717",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "当然，不会署名的，待会儿你不要忘记我们的约定哦。"
          }
        }
      }
    },
    {
      "subId": "1915908",

  },
  "subQuests": [
    {
      "subId": "1403101",
      "subQuestName": "前往枫丹廷·利奥奈区",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140310101"
        ],
        "dialogs": {
          "140310101": {
            "id": "140310101",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "…还是不行吗？",
            "nextDialogs": [
              "140310102"
            ]
          },
          "140310102": {
            "id": "140310102",
            "speakerId": 1001,
            "speakerName": "娜维娅",
            "text": "不行，我整个枫丹廷都跑过一遍了。",
            "nextDialogs": [
              "140310103"
            ]
          },
          "140310103": {
            "id": "140310103",
            "speakerId": 1001,
            "speakerName": "娜维娅",
            "text": "琳妮特听到要连续几天在外面跑，耳朵都耷下来了。菲米尼好像觉得生人太多，直接把头缩进了头盔里。",
            "nextDialogs": [
              "140310104"
            ]
          },
          "140310104": {
            "id": "140310104",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "千织和夏洛蒂呢？感觉她们能够胜任。",
            "nextDialogs": [
              "140310105"
            ]
          },
          "140310105": {
            "id": "140310105",
            "speakerId": 1001,
            "speakerName": "娜维娅",
            "text": "我问过了，但她们最近都挺忙，没有空闲。另外我刚给刺玫会成员放了几天假，不想因为这事打扰大家。",
            "nextDialogs": [
              "140310106"
            ]
          },
          "140310106": {
            "id": "140310106",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "…难办了啊。",
            "nextDialogs": [
              "140310107"
            ]
          },
          "140310107": {
            "id": "140310107",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "娜维娅！克洛琳德！你们好呀。",
            "nextDialogs": [
              "140310108"
            ]
          },
          "140310108": {
            "id": "140310108",
            "speakerId": 1001,
            "speakerName": "娜维娅",
            "text": "天哪！是我的好搭档和派蒙！你们好！",
            "nextDialogs": [
              "140310109"
            ]
          },
          "140310109": {
            "id": "140310109",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "…娜维娅！",
            "nextDialogs": [
              "140310110"
            ]
          },
          "140310110": {
            "id": "140310110",
            "speakerId": 1001,
            "speakerName": "娜维娅",
            "text": "…哦！你的意思是…！",
            "nextDialogs": [
              "140310111"
            ]
          },
          "140310111": {
            "id": "140310111",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "嗯，机会来了…",
            "nextDialogs": [
              "140310114"
            ]
          },
          "140310114": {
            "id": "140310114",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你们这是遇到什么难事了吗？",
            "nextDialogs": [
              "140310115"
            ]
          },
          "140310115": {
            "id": "140310115",
            "speakerId": 1001,
            "speakerName": "娜维娅",
            "text": "没错！我的好搭档，有个天大的难事，眼下只有你们能帮我们解决！",
            "nextDialogs": [
              "140310116"
            ]
          },
          "140310116": {
            "id": "140310116",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这么夸张？",
            "nextDialogs": [
              "140310117"
            ]
          },
          "140310117": {
            "id": "140310117",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "毫不夸张。已经走投无路了。"
          }
        }
      }
    },
    {
      "subId": "1403104",
      "subQuestName": "与克洛琳德和娜维娅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1403102",
      "subQuestName": "前往「千织屋」与其他人会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140310201"
        ],
        "dialogs": {
          "140310201": {
            "id": "140310201",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "久等了。",
            "nextDialogs": [
              "140310202"
            ]
          },
          "140310202": {
            "id": "140310202",
            "speakerId": 1003,
            "speakerName": "芙宁娜",
            "text": "#哦，你们回来了。咦？是{NICKNAME}和派蒙？",
            "nextDialogs": [
              "140310203"
            ]
          },
          "140310203": {
            "id": "140310203",
            "speakerId": 1004,
            "speakerName": "林尼",
            "text": "真惊喜，原来最后找到了你们一起来玩吗？",
            "nextDialogs": [
              "140310204"
            ]
          },
          "140310204": {
            "id": "140310204",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "林尼！还有芙宁娜！另外两位玩家居然是你们呀！你们也是「桌上剧团」俱乐部的会员吗？",
            "nextDialogs": [
              "140310205"
            ]
          },
          "140310205": {
            "id": "140310205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "二位好。",
            "nextDialogs": [
              "140310206"
            ]
          },
          "140310206": {
            "id": "140310206",
            "speakerId": 1004,
            "speakerName": "林尼",
            "text": "我只能算个「挂名成员」吧，没参加过几次活动。在布法蒂公馆，倒是经常由我担任主持人，陪琳妮特和菲米尼玩类似的游戏。",
            "nextDialogs": [
              "140310207"
            ]
          },
          "140310207": {
            "id": "140310207",
            "speakerId": 1004,
            "speakerName": "林尼",
            "text": "不过，自己作为玩家体验剧本还是头一次呢，希望能和大家玩得开心。",
            "nextDialogs": [
              "140310208"
            ]
          },
          "140310208": {
            "id": "140310208",
            "speakerId": 1003,
            "speakerName": "芙宁娜",
            "text": "我不是俱乐部的会员。只是一大早被克洛琳德敲门叫醒，说有个不错的剧本可以体验，这才决定加入的。",
            "nextDialogs": [
              "140310209"
            ]
          },
          "140310209": {
            "id": "140310209",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "如果你感兴趣，我可以当你的介绍人，入会费打六折。",
            "nextDialogs": [
              "140310210"
            ]
          },
          "140310210": {
            "id": "140310210",
            "speakerId": 1003,
            "speakerName": "芙宁娜",
            "text": "我还是先看这次的剧本质量再考虑啦，体验好的话我就加入。",
            "nextDialogs": [
              "140310211"
            ]
          },
          "140310211": {
            "id": "140310211",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "克洛琳德是经常玩「桌上剧团」吗？",
            "nextDialogs": [
              "140310212"
            ]
          },
          "140310212": {
            "id": "140310212",
            "speakerId": 1004,
            "speakerName": "林尼",
            "text": "她可是俱乐部数一数二的「资深主持人」哟。",
            "nextDialogs": [
              "140310213"
            ]
          },
          "140310213": {
            "id": "140310213",
            "speakerId": 1003,
            "speakerName": "芙宁娜",
            "text": "嗯，以前跟我还是上下级关系的时候，我就知道这一点了。",
            "nextDialogs": [
              "140310214"
            ]
          },
          "140310214": {
            "id": "140310214",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "…一点业余爱好而已，不必那么惊讶。",
            "nextDialogs": [
              "140310215"
            ]
          },
          "140310215": {
            "id": "140310215",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "天哪，平时看你都是身为决斗代理人威严的一面，完全想象不到你带人玩桌上剧团的样子呢。",
            "nextDialogs": [
              "140310218"
            ]
          },
          "140310218": {
            "id": "140310218",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "你说笑了。我不会这样为难玩家。",
            "nextDialogs": [
              "140310219"
            ]
          },
          "140310219": {
            "id": "140310219",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "工作是工作，生活是生活。审判庭上的我，代表枫丹的律法与规则，赐予想要维护自身荣誉的人一场公正的决斗。不掺任何私情。",
            "nextDialogs": [
              "140310220"
            ]
          },
          "140310220": {
            "id": "140310220",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "但生活中，我和大家一样，是个普普通通的人，生气难过之类的情绪，也是会有的。",
            "nextDialogs": [
              "140310221"
            ]
          },
          "140310221": {
            "id": "140310221",
            "speakerId": 1003,
            "speakerName": "芙宁娜",
            "text": "骗人的吧，你在我旁边这么久，我从没看你掉过眼泪，生气倒是有过不少…还是说你只是看起来像生气了？",
            "nextDialogs": [
              "140310222"
            ]
          },
          "140310222": {
            "id": "140310222",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "那时的我也是工作状态。",
            "nextDialogs": [
              "140310223"
            ]
          },
          "140310223": {
            "id": "140310223",
            "speakerId": 1003,
            "speakerName": "芙宁娜",
            "text": "是这样吗？但总觉得你在生活中情绪波动也不大。",
            "nextDialogs": [
              "140310224"
            ]
          },
          "140310224": {
            "id": "140310224",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "你想看我哭吗？那可能有些困难。生气或许会更容易些。",
            "nextDialogs": [
              "140310225"
            ]
          },
          "140310225": {
            "id": "140310225",
            "speakerId": 1003,
            "speakerName": "芙宁娜",
            "text": "啊不不不，我不是这个意思…",
            "nextDialogs": [
              "140310226"
            ]
          },
          "140310226": {
            "id": "140310226",
            "speakerId": 1001,
            "speakerName": "娜维娅",
            "text": "我回来啦！向大家介绍一下，这位就是此次剧本的负责人，弗洛莱恩先生！",
            "nextDialogs": [
              "140310227"
            ]
          },
          "140310227": {
            "id": "140310227",
            "speakerId": 1005,
            "speakerName": "弗洛莱恩",
            "text": "各位好。",
            "nextDialogs": [
              "140310228"
            ]
          },
          "140310228": {
            "id": "140310228",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你好你好。咦？难道弗洛莱恩先生也是决斗代理人吗？",
            "nextDialogs": [
              "140310229"
            ]
          },
          "140310229": {
            "id": "140310229",
            "speakerId": 1005,
            "speakerName": "弗洛莱恩",
            "text": "哦，不是的，这是俱乐部提供的演出服。我偶尔还会扮演剧本中的其他角色。",
            "nextDialogs": [
              "140310230"
            ]
          },
          "140310230": {
            "id": "140310230",
            "speakerId": 1004,
            "speakerName": "林尼",
            "text": "还真是辛苦的工作呢。",
            "nextDialogs": [
              "140310231"
            ]
          },
          "140310231": {
            "id": "140310231",
            "speakerId": 1005,
            "speakerName": "弗洛莱恩",
            "text": "这没什么。为了能让扮演者更为沉浸地体验故事，这是我们该做的。",
            "nextDialogs": [
              "140310232"
            ]
          },
          "140310232": {
            "id": "140310232",
            "speakerId": 1005,
            "speakerName": "弗洛莱恩",
            "text": "那么我为各位简单介绍一下——",
            "nextDialogs": [
              "140310233"
            ]
          },
          "140310233": {
            "id": "140310233",
            "speakerId": 1005,
            "speakerName": "弗洛莱恩",
            "text": "此次的剧本，是参考逐影猎人的历史改编而成。诸位将亲自扮演那个时代的逐影猎人，解决在王城发生的一系列事件。",
            "nextDialogs": [
              "140310234"
            ]
          },
          "140310234": {
            "id": "140310234",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呃…我对逐影猎人的历史不是那么熟悉，应该没什么影响吧？",
            "nextDialogs": [
              "140310235"
            ]
          },
          "140310235": {
            "id": "140310235",
            "speakerId": 1005,
            "speakerName": "弗洛莱恩",
            "text": "哦，这完全没问题。简单介绍的话，「逐影猎人」指的是那些继承了特殊的剑技，猎杀魔物、守护城市的人。",
            "nextDialogs": [
              "140310236"
            ]
          },
          "140310236": {
            "id": "140310236",
            "speakerId": 1005,
            "speakerName": "弗洛莱恩",
            "text": "关于他们的故事，最早能追溯到很久以前的雷穆利亚王朝，以及第一位猎人「卡西奥多」…",
            "nextDialogs": [
              "140310237"
            ]
          },
          "140310237": {
            "id": "140310237",
            "speakerId": 1005,
            "speakerName": "弗洛莱恩",
            "text": "但更加详细的，就留给各位之后去寻找和发现吧。",
            "nextDialogs": [
              "140310238"
            ]
          },
          "140310238": {
            "id": "140310238",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "嗯，我也会在此过程中为你们进一步解说。",
            "nextDialogs": [
              "140310239"
            ]
          },
          "140310239": {
            "id": "140310239",
            "speakerId": 1005,
            "speakerName": "弗洛莱恩",
            "text": "那么…咳咳！各位勇敢的猎人啊，你们准备好踏入一场未知的冒险之旅了吗？",
            "nextDialogs": [
              "140310240"
            ]
          },
          "140310240": {
            "id": "140310240",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哦！气氛一下子就上来了呢！",
            "nextDialogs": [
              "140310241"
            ]
          },
          "140310241": {
            "id": "140310241",
            "speakerId": 1005,
            "speakerName": "弗洛莱恩",
            "text": "很好，我已经看到了你们坚毅的眼神。就请前往此处，开启你们的旅途吧！",
            "nextDialogs": [
              "140310242"
            ]
          },
          "140310242": {
            "id": "140310242",
            "speakerId": 1003,
            "speakerName": "芙宁娜",
            "text": "根据故事走向，前往特定情景吗？听起来挺新颖。所以信封里写了什么？",
            "nextDialogs": [
              "140310243"
            ]
          },
          "140310243": {
            "id": "140310243",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "是第一阶段剧本情景的具体位置，还有场地使用许可。准备得挺周全。",
            "nextDialogs": [
              "140310244"
            ]
          },
          "140310244": {
            "id": "140310244",
            "speakerId": 1000,
            "speakerName": "克洛琳德",
            "text": "请各位检查随身物品，防止遗漏。准备好后，就随我前往指定的地点吧。",
            "nextDialogs": [
              "140310245"
            ]
          },
          "140310245": {
            "id": "140310245",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好欸！逐影猎人小队，出发！"
          }
        }
      }
    },
    {
      "subId": "1403199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140319901"
        ],
        "dialogs": {
          "140319901": {
            "id": "140319901",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦？那不是克洛琳德和娜维娅吗？",
            "nextDialogs": [
              "140319902"
            ]
          },
          "140319902": {
            "id": "140319902",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "看她们的样子…是遇到什么困难了吗？我们过去问问吧。"
          }
        }
      }
    }
  ]
}
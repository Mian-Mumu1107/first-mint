    {
      "subId": "38402",
      "subQuestName": "前往摘星崖",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3840201"
        ],
        "dialogs": {
          "3840201": {
            "id": "3840201",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "哦，这下人都到齐了。",
            "nextDialogs": [
              "3840202"
            ]
          },
          "3840202": {
            "id": "3840202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个地方，风景真漂亮啊。",
            "nextDialogs": [
              "3840203"
            ]
          },
          "3840203": {
            "id": "3840203",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "和「命运的再会」这个主题很配吧？",
            "nextDialogs": [
              "3840204"
            ]
          },
          "3840204": {
            "id": "3840204",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "那么，该准备开始了。",
            "nextDialogs": [
              "3840205"
            ]
          },
          "3840205": {
            "id": "3840205",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "嗯，不论结果如何，至少已经看到了转机。",
            "nextDialogs": [
              "3840206"
            ]
          },
          "3840206": {
            "id": "3840206",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "这段时间，整座蒙德城都背负了太多…",
            "nextDialogs": [
              "3840207"
            ]
          },
          "3840207": {
            "id": "3840207",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "只是到头来，解决问题的却是旅行者和一个歌手。",
            "nextDialogs": [
              "3840208"
            ]
          },
          "3840208": {
            "id": "3840208",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "呵。骑士团勉强算是有些苦劳吧。",
            "nextDialogs": [
              "3840209"
            ]
          },
          "3840209": {
            "id": "3840209",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "好啦好啦。大家都站开一些——",
            "nextDialogs": [
              "3840210"
            ]
          },
          "3840210": {
            "id": "3840210",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "尘世间最好的吟游诗人，要开始拨动他的琴弦了。"
          }
        }
      }
    },
    {
      "subId": "38403",
      "subQuestName": "与温迪对话",

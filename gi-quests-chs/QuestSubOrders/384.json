    {
      "subId": "38404",
      "subQuestName": "(test)等待温迪召唤风魔龙$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3840401"
        ],
        "dialogs": {
          "3840401": {
            "id": "3840401",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "巴——温迪阁下，请注意保护好自己。",
            "nextDialogs": [
              "3840402"
            ]
          },
          "3840402": {
            "id": "3840402",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "哈哈…其实你不是现在才猜出那个身份的吧，琴？",
            "nextDialogs": [
              "3840403"
            ]
          },
          "3840403": {
            "id": "3840403",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "不过，谢谢你继续用这个名字叫我。",
            "nextDialogs": [
              "3840404"
            ]
          },
          "3840404": {
            "id": "3840404",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "天空之琴怎么样了？",
            "nextDialogs": [
              "3840405"
            ]
          },
          "3840405": {
            "id": "3840405",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "还能弹奏吗？…或者，还能用龙的泪滴修复吗？",
            "nextDialogs": [
              "3840406"
            ]
          },
          "3840406": {
            "id": "3840406",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "唔…",
            "nextDialogs": [
              "3840407"
            ]
          },
          "3840407": {
            "id": "3840407",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "坏成这副样子的话…可能就没办法了呢。",
            "nextDialogs": [
              "3840409",
              "3840411"
            ]
          },
          "3840409": {
            "id": "3840409",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "没错，如果不能击败腐蚀的源头，就无法减轻特瓦林所受的痛苦。",
            "nextDialogs": [
              "3840413"
            ]
          },
          "3840413": {
            "id": "3840413",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "那么，我召集侦察骑士来追踪…",
            "nextDialogs": [
              "3840414"
            ]
          },
          "3840414": {
            "id": "3840414",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "不必了。",
            "nextDialogs": [
              "3840415"
            ]
          },
          "3840415": {
            "id": "3840415",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "嗯？",
            "nextDialogs": [
              "3840416"
            ]
          },
          "3840416": {
            "id": "3840416",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "不久前我在四风守护的神庙遗迹，亲手斩杀过它的一只同类。",
            "nextDialogs": [
              "3840417"
            ]
          },
          "3840417": {
            "id": "3840417",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？！是什么时候…",
            "nextDialogs": [
              "3840418"
            ]
          },
          "3840418": {
            "id": "3840418",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "想要追踪那些怪物的话，可以借助我的情报网和手段。",
            "nextDialogs": [
              "3840419"
            ]
          },
          "3840419": {
            "id": "3840419",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "迪卢克…",
            "nextDialogs": [
              "3840420"
            ]
          },
          "3840420": {
            "id": "3840420",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然讨厌骑士团，但会用自己的方式来守护蒙德呢。",
            "nextDialogs": [
              "3840421"
            ]
          },
          "3840421": {
            "id": "3840421",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "小派蒙的语气，突然变得溺爱了起来…！",
            "nextDialogs": [
              "3840422"
            ]
          },
          "3840422": {
            "id": "3840422",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "哼。",
            "nextDialogs": [
              "3840423"
            ]
          },
          "3840423": {
            "id": "3840423",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "总之，等我消息吧。",
            "nextDialogs": [
              "3840424"
            ]
          },
          "3840424": {
            "id": "3840424",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "我要让它们明白，不论深渊教团再怎么无法无天…",
            "nextDialogs": [
              "3840425"
            ]
          },
          "3840425": {
            "id": "3840425",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "在蒙德，有些事也是不可以做的。"
          },
          "3840411": {
            "id": "3840411",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "但首先要让罪魁祸首付出代价。",
            "nextDialogs": [
              "3840412"
            ]
          },
          "3840412": {
            "id": "3840412",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "如果不能击败腐蚀的源头，就无法减轻特瓦林所受的痛苦。"
          }
        }
      }
    },
    {
      "subId": "38405",

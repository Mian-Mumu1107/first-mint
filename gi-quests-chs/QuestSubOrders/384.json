    {
      "subId": "38406",
      "subQuestName": "(test)cutscene哥哥/妹妹登场$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3840601"
        ],
        "dialogs": {
          "3840601": {
            "id": "3840601",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "咦？这是什么…",
            "nextDialogs": [
              "3840602"
            ]
          },
          "3840602": {
            "id": "3840602",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "深渊法师被击败以后，散逸出了某种能量…",
            "nextDialogs": [
              "3840603"
            ]
          },
          "3840603": {
            "id": "3840603",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "这种能量原本的用途，似乎是隔绝我和特瓦林之间的联系。",
            "nextDialogs": [
              "3840604"
            ]
          },
          "3840604": {
            "id": "3840604",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "……",
            "nextDialogs": [
              "3840605"
            ]
          },
          "3840605": {
            "id": "3840605",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "#{NICKNAME}，你知道「<color=#00E1FFFF>风龙废墟</color>」吗？",
            "nextDialogs": [
              "3840607",
              "3840609",
              "3840611"
            ]
          },
          "3840607": {
            "id": "3840607",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "嗯，但琴团长和迪卢克老爷想必都是知道的。",
            "nextDialogs": [
              "3840612"
            ]
          },
          "3840612": {
            "id": "3840612",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "没错。",
            "nextDialogs": [
              "3840613"
            ]
          },
          "3840613": {
            "id": "3840613",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "现在的特瓦林，正居住在一片被它当作巢穴的废墟里。",
            "nextDialogs": [
              "3840614"
            ]
          },
          "3840614": {
            "id": "3840614",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "与封锁蒙德四方的暴风一样，巢穴的入口也有很难通过的特殊障壁。",
            "nextDialogs": [
              "3840615"
            ]
          },
          "3840615": {
            "id": "3840615",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "但现在，从深渊法师散逸的能量里，我能读出编织魔力的韵律。",
            "nextDialogs": [
              "3840616"
            ]
          },
          "3840616": {
            "id": "3840616",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "虽然那种韵律比丘丘人的合唱还要难听，但…",
            "nextDialogs": [
              "3840617"
            ]
          },
          "3840617": {
            "id": "3840617",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "也足够让我们破除暴风障壁、抵达特瓦林的「<color=#00E1FFFF>风龙废墟</color>」了。",
            "nextDialogs": [
              "3840618"
            ]
          },
          "3840618": {
            "id": "3840618",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "那么，是要正面挑战特瓦林了么？",
            "nextDialogs": [
              "3840619"
            ]
          },
          "3840619": {
            "id": "3840619",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "我倒是没有意见…话说回来，琴才是那个想要避免开战的人。",
            "nextDialogs": [
              "3840620"
            ]
          },
          "3840620": {
            "id": "3840620",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "不。在没有更好的选择时，就由我承担改变方针的责任。",
            "nextDialogs": [
              "3840621"
            ]
          },
          "3840621": {
            "id": "3840621",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "如果讨伐风龙是唯一的方案，那我就会成为冲锋在前的骑士。",
            "nextDialogs": [
              "3840622"
            ]
          },
          "3840622": {
            "id": "3840622",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "现在还没到那一步喔。",
            "nextDialogs": [
              "3840623"
            ]
          },
          "3840623": {
            "id": "3840623",
            "speakerId": 1000,
            "speakerName": "迪卢克",
            "text": "嗯？",
            "nextDialogs": [
              "3840624"
            ]
          },
          "3840624": {
            "id": "3840624",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "温迪阁下的意思是…",
            "nextDialogs": [
              "3840625"
            ]
          },
          "3840625": {
            "id": "3840625",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "我的意思是，天空之琴不是我们的底牌。",
            "nextDialogs": [
              "3840626"
            ]
          },
          "3840626": {
            "id": "3840626",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "#真正的底牌——是{NICKNAME}呀。",
            "nextDialogs": [
              "3840627"
            ]
          },
          "3840627": {
            "id": "3840627",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}？"
          },
          "3840609": {
            "id": "3840609",
            "speakerId": 1002,
            "speakerName": "温迪",
            "text": "嗯，同样来自蒙德的各位，想必都是知道的。"
          },
          "3840611": {
            "id": "3840611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "之前试着进入时，被暴风的障壁挡住了前进的道路。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "1000407",
      "subQuestName": "与莫娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1000406",
      "subQuestName": "与莫娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "100040601"
        ],
        "dialogs": {
          "100040601": {
            "id": "100040601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呼，总算是解决了。",
            "nextDialogs": [
              "100040602"
            ]
          },
          "100040602": {
            "id": "100040602",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "老太婆倒是提到了，结束之后打开第三封信。",
            "nextDialogs": [
              "100040603"
            ]
          },
          "100040603": {
            "id": "100040603",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "但是我没有成功，要不要打开呢？",
            "nextDialogs": [
              "100040604"
            ]
          },
          "100040604": {
            "id": "100040604",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我感觉我已经理解你们师徒相处的脑回路了。",
            "nextDialogs": [
              "100040605"
            ]
          },
          "100040605": {
            "id": "100040605",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你看，她只说结束，没有说成功结束。所以我觉得可以打开。",
            "nextDialogs": [
              "100040606"
            ]
          },
          "100040606": {
            "id": "100040606",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "确实。我感觉老太婆应该没写什么好话。",
            "nextDialogs": [
              "100040607"
            ]
          },
          "100040607": {
            "id": "100040607",
            "speakerId": 1002,
            "speakerName": "芭比洛斯",
            "text": "「如果你看到这句话，说明你真的尝试了。」",
            "nextDialogs": [
              "100040608"
            ]
          },
          "100040608": {
            "id": "100040608",
            "speakerId": 1002,
            "speakerName": "芭比洛斯",
            "text": "「不是，你真敢尝试打开啊？哈哈哈哈哈哈。」",
            "nextDialogs": [
              "100040609"
            ]
          },
          "100040609": {
            "id": "100040609",
            "speakerId": 1001,
            "speakerName": "莫娜",
            "text": "老——太——婆——！",
            "nextDialogs": [
              "100040610"
            ]
          },
          "100040610": {
            "id": "100040610",
            "speakerId": 1002,
            "speakerName": "芭比洛斯",
            "text": "「坎瑞亚因为存在过许多星海之湖，所以空间上相对不稳定，故非物理穿透天盖障更容易成功。」",
            "nextDialogs": [
              "100040611"
            ]
          },
          "100040611": {
            "id": "100040611",
            "speakerId": 1002,
            "speakerName": "芭比洛斯",
            "text": "「而且那里保密性比较好，加之位于人迹罕至的地底。如果失败了，不良影响传播比较小。」",
            "nextDialogs": [
              "100040612"
            ]
          },
          "100040612": {
            "id": "100040612",
            "speakerId": 1002,
            "speakerName": "芭比洛斯",
            "text": "「作为我的徒弟，我相信你还是能处理在虚假之天外界游弋的深渊生物的。」",
            "nextDialogs": [
              "100040613"
            ]
          },
          "100040613": {
            "id": "100040613",
            "speakerId": 1002,
            "speakerName": "芭比洛斯",
            "text": "「打不过你肯定跑得掉吧。你跑路本事这么不错。」",
            "nextDialogs": [
              "100040614"
            ]
          },
          "100040614": {
            "id": "100040614",
            "speakerId": 1002,
            "speakerName": "芭比洛斯",

  "subQuests": [
    {
      "subId": "7012401",
      "subQuestName": "(test)(隐藏)古代正文对话1-8$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701240101"
        ],
        "dialogs": {
          "701240101": {
            "id": "701240101",
            "speakerId": 1000,
            "speakerName": "古老的铭文",
            "text": "「…以为魂，星银以为骨。但能挥舞它，斩开冰雪的异邦人，伊蒙洛…」"
          }
        }
      }
    },
    {
      "subId": "7012402",
      "subQuestName": "(test)(隐藏)古代正文对话1-8$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701240201"
        ],
        "dialogs": {
          "701240201": {
            "id": "701240201",
            "speakerId": 1000,
            "speakerName": "古老的铭文",
            "text": "「…以此尝试愈疗地脉，但树已枯死。将公主薄葬后…」"
          }
        }
      }
    },
    {
      "subId": "7012403",
      "subQuestName": "(test)(隐藏)古代正文对话1-8$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701240301"
        ],
        "dialogs": {
          "701240301": {
            "id": "701240301",
            "speakerId": 1000,
            "speakerName": "古老的铭文",
            "text": "「…无果，不得回应。法鲁希前往峰顶…」"
          }
        }
      }
    },
    {
      "subId": "7012404",
      "subQuestName": "(test)(隐藏)古代正文对话1-8$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701240401"
        ],
        "dialogs": {
          "701240401": {
            "id": "701240401",
            "speakerId": 1000,
            "speakerName": "古老的铭文",
            "text": "「…风雪遍天。天降之柱崩裂为三…」"
          }
        }
      }
    },
    {
      "subId": "7012405",
      "subQuestName": "(test)(隐藏)古代正文对话1-8$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701240501"
        ],
        "dialogs": {
          "701240501": {
            "id": "701240501",
            "speakerId": 1000,
            "speakerName": "古老的铭文",
            "text": "「…远离冰雪与纷争，抵达此间苍绿的乐土。遂立此碑，并定都于此，名之为沙尔·芬…」"
          }
        }
      }
    },
    {
      "subId": "7012406",
      "subQuestName": "(test)(隐藏)古代正文对话1-8$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701240601"
        ],
        "dialogs": {
          "701240601": {
            "id": "701240601",
            "speakerId": 1000,
            "speakerName": "古老的铭文",
            "text": "「…梦见了蔽日的漆黑之龙。是为凶异之兆。同月，异邦人…」"
          }
        }
      }
    },
    {
      "subId": "7012407",
      "subQuestName": "(test)(隐藏)古代正文对话1-8$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701240701"
        ],
        "dialogs": {
          "701240701": {
            "id": "701240701",
            "speakerId": 1000,
            "speakerName": "古老的铭文",
            "text": "「…的引导下前往山中苍白之树之所在。同月，地下水路…」"
          }
        }
      }
    },
    {
      "subId": "7012408",
      "subQuestName": "(test)(隐藏)古代正文对话1-8$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701240801"
        ],
        "dialogs": {
          "701240801": {
            "id": "701240801",
            "speakerId": 1000,
            "speakerName": "古老的铭文",
            "text": "「…已殁。再没有书记的必要了。最大的憾事，莫过于无法目睹她完成大殿中的壁画吧…」"
          }
        }
      }
    },
    {

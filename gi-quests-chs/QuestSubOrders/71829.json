        "dialogs": {
          "718290301": {
            "id": "718290301",
            "speakerId": 1001,
            "speakerName": "江雪",
            "text": "咦？您可是位稀客。平日里只有我和那厨子相对无言，今天多了您，说不定也会热闹一些。",
            "nextDialogs": [
              "718290302"
            ]
          },
          "718290302": {
            "id": "718290302",
            "speakerId": 1001,
            "speakerName": "江雪",
            "text": "但我今天看那厨子愁眉苦脸的，也不知道是不是遇见什么烦心事了…"
          }
        }
      }
    },

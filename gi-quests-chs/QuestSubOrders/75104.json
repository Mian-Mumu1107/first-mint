  "subQuests": [
    {
      "subId": "7510423",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751041301"
        ],
        "dialogs": {
          "751041301": {
            "id": "751041301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊，好漂亮的贝壳！为什么会放在这边的台子上呢？",
            "nextDialogs": [
              "751041302"
            ]
          },
          "751041302": {
            "id": "751041302",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "#哦哦，这位{M#小哥}{F#小姐}，来得正好！能请你过来一下吗？",
            "nextDialogs": [
              "751041303"
            ]
          },
          "751041303": {
            "id": "751041303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呜哇，原来有人在！{NICKNAME}，我们还是去听听他有什么话要说吧。"
          }
        }
      }
    },
    {
      "subId": "7510401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751040101"
        ],
        "dialogs": {
          "751040101": {
            "id": "751040101",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "#哦哦，这位{M#小哥}{F#小姐}，来得正好！",
            "nextDialogs": [
              "751040102"
            ]
          },
          "751040102": {
            "id": "751040102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？是在和我们说话吗？",
            "nextDialogs": [
              "751040103"
            ]
          },
          "751040103": {
            "id": "751040103",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "没错！你们是远道而来的异邦客人，有件事我想听听你们的意见。",
            "nextDialogs": [
              "751040104"
            ]
          },
          "751040104": {
            "id": "751040104",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "从客人的视角来看，你们有没有觉得，现在的流泉之众实在是太过散漫了？",
            "nextDialogs": [
              "751040105"
            ]
          },
          "751040105": {
            "id": "751040105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，什么意思？",
            "nextDialogs": [
              "751040106"
            ]
          },
          "751040106": {
            "id": "751040106",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "要知道，我们的先祖可是以勇烈善战闻名世间的，无论是「踏虹而过者」乌努库，还是「巨人」图帕克，都是人尽皆知的英杰！",
            "nextDialogs": [
              "751040107"
            ]
          },
          "751040107": {
            "id": "751040107",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "可现在呢？提到流泉之众，大家能想到的好像只剩下温泉啦！",
            "nextDialogs": [
              "751040109",
              "751040111"
            ]
          },
          "751040109": {
            "id": "751040109",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "是不错，但要是每天都像这样怠惰下去，长此以往，人可是会丧失斗志的！",
            "nextDialogs": [
              "751040113"
            ]
          },
          "751040113": {
            "id": "751040113",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "这样下去可不行！所以，我就和阿米娜妹妹说，必须要建一个训练场，来提振我们流泉之众的斗志！",
            "nextDialogs": [
              "751040114"
            ]
          },
          "751040114": {
            "id": "751040114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，那她的回答是？",
            "nextDialogs": [
              "751040115"
            ]
          },
          "751040115": {
            "id": "751040115",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "「虽然完全听不懂你在说什么，但要是有趣的话就按照你的意思来办吧。」",
            "nextDialogs": [
              "751040116"
            ]
          },
          "751040116": {
            "id": "751040116",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "所以，如两位所见，这里就是流泉之众的大训练场了！"
          },
          "751040111": {
            "id": "751040111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有好喝的果汁…",
            "nextDialogs": [
              "751040112"
            ]
          },
          "751040112": {
            "id": "751040112",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "都一样！要是每天都像这样怠惰下去，长此以往，人可是会丧失斗志的！"
          }
        }
      }
    },
    {

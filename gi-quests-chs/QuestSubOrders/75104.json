    {
      "subId": "7510419",
      "subQuestName": "（test）不进入测试对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751040801"
        ],
        "dialogs": {
          "751040801": {
            "id": "751040801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "稍等，还有别的事要做…",
            "nextDialogs": [
              "751040802"
            ]
          },
          "751040802": {
            "id": "751040802",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "#好，那我就先去修一修木架，在这里等{M#小哥}{F#小姐}你回来吧！"
          }
        }
      }
    },
    {
      "subId": "7510422",
      "subQuestName": "与朗戈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751042201"
        ],
        "dialogs": {
          "751042201": {
            "id": "751042201",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "#哈哈，好身手！要是部族里的孩子们都能像{M#小哥}{F#小姐}你这么灵巧，也就用不着训练啦。",
            "nextDialogs": [
              "751042202"
            ]
          },
          "751042202": {
            "id": "751042202",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "这是说好的贝壳，来，请收下吧！",
            "nextDialogs": [
              "751042203"
            ]
          },
          "751042203": {
            "id": "751042203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，能帮上忙就好。",
            "nextDialogs": [
              "751042204"
            ]
          },
          "751042204": {
            "id": "751042204",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "不过，看你们测试完，我意识到一个特别严重的问题…",
            "nextDialogs": [
              "751042205"
            ]
          },
          "751042205": {
            "id": "751042205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？什么问题？",
            "nextDialogs": [
              "751042206"
            ]
          },
          "751042206": {
            "id": "751042206",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "现在这个…不就是普通的冲浪场地吗？",
            "nextDialogs": [
              "751042209"
            ]
          },
          "751042209": {
            "id": "751042209",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "#这个嘛…{M#小哥}{F#小姐}你有没有看到那边的「灵道刻印门」？我之前和阿米娜妹妹商量的时候，这些古老的燃素装置还能正常工作来着。",
            "nextDialogs": [
              "751042210"
            ]
          },
          "751042210": {
            "id": "751042210",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "唉，要是这些装置还能开启「游隙灵道」，就可以像是大英杰乌努库那样，沿着它们的轨道，一路飞到彩虹上去啦！"
          }
        }
      }
    },

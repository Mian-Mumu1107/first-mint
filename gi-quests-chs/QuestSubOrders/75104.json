    {
      "subId": "7510404",
      "subQuestName": "完成冲浪场地测试",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751040401"
        ],
        "dialogs": {
          "751040401": {
            "id": "751040401",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "哦哦！哦哦哦！没想到你们居然真的修好了这些灵道刻印门！好，很有斗志，非常有斗志！",
            "nextDialogs": [
              "751040402"
            ]
          },
          "751040402": {
            "id": "751040402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，怎么说呢？虽然重新启动了装置，但有些地方好像还是需要调整…",
            "nextDialogs": [
              "751040406",
              "751040405"
            ]
          },
          "751040406": {
            "id": "751040406",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "哈哈，没问题！这种细枝末节的部分，就交给我好啦！",
            "nextDialogs": [
              "751040407"
            ]
          },
          "751040407": {
            "id": "751040407",
            "speakerId": 6257,
            "speakerName": "朗戈",
            "text": "#{M#小哥}{F#小姐}，明天再回来看看吧！"
          },
          "751040405": {
            "id": "751040405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "？"
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "1400301",
      "subQuestName": "等待到第二天上午（8:00-12:00）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140030101"
        ],
        "dialogs": {
          "140030101": {
            "id": "140030101",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "不好意思，夏洛蒂小姐。今天我和妹妹有点忙，暂时不接受采访…",
            "nextDialogs": [
              "140030102"
            ]
          },
          "140030102": {
            "id": "140030102",
            "speakerId": 1001,
            "speakerName": "夏洛蒂",
            "text": "放心，我只会占用一点点时间——拜托了，林尼先生！",
            "nextDialogs": [
              "140030103"
            ]
          },
          "140030103": {
            "id": "140030103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦，发生什么事了？",
            "nextDialogs": [
              "140030104"
            ]
          },
          "140030104": {
            "id": "140030104",
            "speakerId": 1001,
            "speakerName": "夏洛蒂",
            "text": "我原本通宵写好了关于怪盗貂的专栏，今天早上就可以登报发表了。",
            "nextDialogs": [
              "140030105"
            ]
          },
          "140030105": {
            "id": "140030105",
            "speakerId": 1001,
            "speakerName": "夏洛蒂",
            "text": "但是——就在凌晨的时候，我突然获知消息，塞萨尔的未婚妻嘉玛主动联系了警备队，承认她才是真正的怪盗貂！",
            "nextDialogs": [
              "140030106"
            ]
          },
          "140030106": {
            "id": "140030106",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这么快！",
            "nextDialogs": [
              "140030107"
            ]
          },
          "140030107": {
            "id": "140030107",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "咳。",
            "nextDialogs": [
              "140030108"
            ]
          },
          "140030108": {
            "id": "140030108",
            "speakerId": 1001,
            "speakerName": "夏洛蒂",
            "text": "嗯？",
            "nextDialogs": [
              "140030109"
            ]
          },
          "140030109": {
            "id": "140030109",
            "speakerId": 1003,
            "speakerName": "琳妮特",
            "text": "已经来不及了，哥哥。",
            "nextDialogs": [
              "140030110"
            ]
          },
          "140030110": {
            "id": "140030110",
            "speakerId": 1001,
            "speakerName": "夏洛蒂",
            "text": "呵呵…你们的第一反应是「这么快」，看来已经提前知道真相了啊。",
            "nextDialogs": [
              "140030111"
            ]
          },
          "140030111": {
            "id": "140030111",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊！",
            "nextDialogs": [
              "140030112"
            ]
          },
          "140030112": {
            "id": "140030112",
            "speakerId": 1001,
            "speakerName": "夏洛蒂",
            "text": "果然我的直觉是对的，你们绝对有什么事瞒着我！嘉玛投案自首的原因…肯定跟昨晚林尼先生的魔术表演有关！",
            "nextDialogs": [
              "140030113"
            ]
          },
          "140030113": {
            "id": "140030113",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "可能是嘉玛小姐看到高空逃生魔术后，回忆起和塞萨尔共度的时光，良心发现了？",
            "nextDialogs": [
              "140030114"
            ]
          },
          "140030114": {
            "id": "140030114",
            "speakerId": 1001,
            "speakerName": "夏洛蒂",
            "text": "原来如此——不对啊，要是这么简单就良心发现，这十年她干什么去了？",
            "nextDialogs": [
              "140030115"
            ]
          },
          "140030115": {
            "id": "140030115",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "这个嘛…",
            "nextDialogs": [
              "140030116"
            ]
          },
          "140030116": {
            "id": "140030116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（感觉夏洛蒂的记者之魂正在熊熊燃烧，得想办法引开她的注意力…）",
            "nextDialogs": [
              "140030117"
            ]
          },
          "140030117": {
            "id": "140030117",
            "speakerId": 1001,
            "speakerName": "夏洛蒂",
            "text": "我记起来了！昨天的魔术表演后，你们和嘉玛都不见了。难道说就是那个时候？",
            "nextDialogs": [
              "140030118"
            ]
          },
          "140030118": {
            "id": "140030118",
            "speakerId": 1001,
            "speakerName": "夏洛蒂",
            "text": "突击采访，请问表演完你们去哪里了？",
            "nextDialogs": [
              "140030119"
            ]
          },
          "140030119": {
            "id": "140030119",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "魔术表演完？我们和林尼在墓园，林尼还给我们单独表演了魔术呢！",
            "nextDialogs": [
              "140030120"
            ]
          },
          "140030120": {
            "id": "140030120",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "说起来，多亏了你的提醒，现在林尼变魔术已经会用「虹彩蔷薇」啦！",
            "nextDialogs": [
              "140030121"
            ]
          },
          "140030121": {
            "id": "140030121",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "咳…",
            "nextDialogs": [
              "140030122"
            ]
          },
          "140030122": {
            "id": "140030122",
            "speakerId": 1003,
            "speakerName": "琳妮特",
            "text": "…嗯？",
            "nextDialogs": [
              "140030123"
            ]
          },
          "140030123": {
            "id": "140030123",
            "speakerId": 1003,
            "speakerName": "琳妮特",
            "text": "#印象里就连我也没有收到过哥哥送的虹彩蔷薇。所以哥哥的意思是，{M#他们}{F#她们}比我更重要吗？",
            "nextDialogs": [
              "140030124"
            ]
          },
          "140030124": {
            "id": "140030124",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "不是啦！这个…",
            "nextDialogs": [
              "140030125"
            ]
          },
          "140030125": {
            "id": "140030125",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怎、怎么连你也是这个反应，我又说错话了吗？",
            "nextDialogs": [
              "140030126"
            ]
          },
          "140030126": {
            "id": "140030126",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#气氛好像变得很奇怪…{NICKNAME}，我们现在该怎么办啊？",
            "nextDialogs": [
              "140030127"
            ]
          },
          "140030127": {
            "id": "140030127",
            "speakerId": 1001,
            "speakerName": "夏洛蒂",
            "text": "唉，看来今天好像不太适合采访。好吧，那我下次再来。",
            "nextDialogs": [
              "140030128"
            ]
          },
          "140030128": {
            "id": "140030128",
            "speakerId": 1001,
            "speakerName": "夏洛蒂",
            "text": "请原谅我的固执，但我不会对这么劲爆的消息坐视不理！嘉玛的事情一经传开就引起了巨大轰动，我要全力挖出这背后的真相！",
            "nextDialogs": [
              "140030129"
            ]
          },
          "140030129": {
            "id": "140030129",
            "speakerId": 1001,
            "speakerName": "夏洛蒂",
            "text": "听说她还对警备队讲了「最后的心愿是希望再见洛伦佐一面」。啧…好复杂的关系，真让人好奇。",
            "nextDialogs": [
              "140030130"
            ]
          },
          "140030130": {
            "id": "140030130",
            "speakerId": 1001,
            "speakerName": "夏洛蒂",
            "text": "总之我先走了。你们慢慢聊！",
            "nextDialogs": [
              "140030131"
            ]
          },
          "140030131": {
            "id": "140030131",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呃，琳妮特，其实…",
            "nextDialogs": [
              "140030132"
            ]
          },
          "140030132": {
            "id": "140030132",
            "speakerId": 1003,
            "speakerName": "琳妮特",
            "text": "没事，我并没有生气，刚刚只是为了转移她的注意。",
            "nextDialogs": [
              "140030133"
            ]
          },
          "140030133": {
            "id": "140030133",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "原来是这样，吓我一跳。",
            "nextDialogs": [
              "140030134"
            ]
          },
          "140030134": {
            "id": "140030134",
            "speakerId": 1000,
            "speakerName": "林尼",
            "text": "呼，连我也差点被骗到了…好在效果不错，对吧？",
            "nextDialogs": [
              "140030135"
            ]
          },
          "140030135": {
            "id": "140030135",
            "speakerId": 1003,
            "speakerName": "琳妮特",
            "text": "…虹彩蔷薇，请好好保管。",
            "nextDialogs": [
              "140030136"
            ]
          },
          "140030136": {
            "id": "140030136",
            "speakerId": 1003,
            "speakerName": "琳妮特",
            "text": "如果弄丢了的话，我也会感到难过的。"
          }
        }
      }
    },

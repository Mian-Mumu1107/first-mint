    {
      "subId": "4006804",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400680401"
        ],
        "dialogs": {
          "400680401": {
            "id": "400680401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咳咳，吃了一嘴灰…",
            "nextDialogs": [
              "400680402"
            ]
          },
          "400680402": {
            "id": "400680402",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "没事吧派蒙？",
            "nextDialogs": [
              "400680403"
            ]
          },
          "400680403": {
            "id": "400680403",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "果然，换地方了。",
            "nextDialogs": [
              "400680404"
            ]
          },
          "400680404": {
            "id": "400680404",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "这里怎么有种荒凉的感觉…辛焱，这是跟你有关的幻境没错吧？",
            "nextDialogs": [
              "400680405"
            ]
          },
          "400680405": {
            "id": "400680405",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "我猜没错，但…奇怪，怎么会这么荒凉？",
            "nextDialogs": [
              "400680406"
            ]
          },
          "400680406": {
            "id": "400680406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你们看，那个地方好亮，像在邀请我们过去。",
            "nextDialogs": [
              "400680407"
            ]
          },
          "400680407": {
            "id": "400680407",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "嗯，过去看看。",
            "nextDialogs": [
              "400680408"
            ]
          },
          "400680408": {
            "id": "400680408",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸不对不对！这么明显，肯定是陷阱吧！",
            "nextDialogs": [
              "400680409"
            ]
          },
          "400680409": {
            "id": "400680409",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "说是这么说，我们也没有其他路可走啊。",
            "nextDialogs": [
              "400680410"
            ]
          },
          "400680410": {
            "id": "400680410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实…",
            "nextDialogs": [
              "400680411"
            ]
          },
          "400680411": {
            "id": "400680411",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "如果这的确是辛焱的幻境，应该不会有陷阱。",
            "nextDialogs": [
              "400680412"
            ]
          },
          "400680412": {
            "id": "400680412",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "这话我爱听！一下就肯定了我的人品。",
            "nextDialogs": [
              "400680413"
            ]
          },
          "400680413": {
            "id": "400680413",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "有道理欸，那我们过去看看吧，不过要小心一点。"
          }
        }
      }
    },
    {
      "subId": "4006805",
      "subQuestName": "前往光线明亮的地方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400680501"
        ],
        "dialogs": {
          "400680501": {
            "id": "400680501",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "门锁住了。",
            "nextDialogs": [
              "400680503",
              "400680505"
            ]
          },
          "400680503": {
            "id": "400680503",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "说什么胡话啊你。",
            "nextDialogs": [
              "400680506"
            ]
          },
          "400680506": {
            "id": "400680506",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "辛焱，你干嘛把门锁起来？",
            "nextDialogs": [
              "400680507"
            ]
          },
          "400680507": {
            "id": "400680507",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "啊哈哈，就算你问我，我也…",
            "nextDialogs": [
              "400680508"
            ]
          },
          "400680508": {
            "id": "400680508",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "唔，不过我是个会把钥匙放在家门口花盆底下的人，所以…附近应该有钥匙。",
            "nextDialogs": [
              "400680509"
            ]
          },
          "400680509": {
            "id": "400680509",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "噢！这附近有花盆吗？",
            "nextDialogs": [
              "400680510"
            ]
          },
          "400680510": {
            "id": "400680510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有花盆，但有…那个。",
            "nextDialogs": [
              "400680511"
            ]
          },
          "400680511": {
            "id": "400680511",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "不无可能。"
          },
          "400680505": {
            "id": "400680505",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "…还是再想想吧。"
          }
        }
      }
    },

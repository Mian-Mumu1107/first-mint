    {
      "subId": "4006815",
      "subQuestName": "汲取「寒山甘泉」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400681501"
        ],
        "dialogs": {
          "400681501": {
            "id": "400681501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这应该就是我们要找的「寒山甘泉」了。",
            "nextDialogs": [
              "400681502"
            ]
          },
          "400681502": {
            "id": "400681502",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "喝了这个，就能唱出美妙动人的歌声吗？",
            "nextDialogs": [
              "400681503"
            ]
          },
          "400681503": {
            "id": "400681503",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "感兴趣的话，可以试试。",
            "nextDialogs": [
              "400681504"
            ]
          },
          "400681504": {
            "id": "400681504",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "不不，我又不会唱歌…万一没用岂不是很尴尬。",
            "nextDialogs": [
              "400681505"
            ]
          },
          "400681505": {
            "id": "400681505",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "哈哈哈，莫娜声音这么好听，很适合唱歌。要是你不嫌弃，等回营地我教你怎么运气发声。",
            "nextDialogs": [
              "400681506"
            ]
          },
          "400681506": {
            "id": "400681506",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "欸？可、可以吗？你先保证，绝对不能笑我。",
            "nextDialogs": [
              "400681507"
            ]
          },
          "400681507": {
            "id": "400681507",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "不笑不笑，谁都是从头开始学的嘛。",
            "nextDialogs": [
              "400681508"
            ]
          },
          "400681508": {
            "id": "400681508",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "嗯…那我可以稍微试一试。",
            "nextDialogs": [
              "400681509"
            ]
          },
          "400681509": {
            "id": "400681509",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "好。在那之前，我们先把山泉送到花那里。",
            "nextDialogs": [
              "400681510"
            ]
          },
          "400681510": {
            "id": "400681510",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "触碰海滩上的鼓就能进入幻境了，再来一次吧。"
          }
        }
      }
    },

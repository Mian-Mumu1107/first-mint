    {
      "subId": "4006802",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400680201"
        ],
        "dialogs": {
          "400680201": {
            "id": "400680201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "起床啦——！太阳晒到屁股上啦！",
            "nextDialogs": [
              "400680202"
            ]
          },
          "400680202": {
            "id": "400680202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "400680203"
            ]
          },
          "400680203": {
            "id": "400680203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，我是仰面朝上睡的。",
            "nextDialogs": [
              "400680204"
            ]
          },
          "400680204": {
            "id": "400680204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好吧，那太阳晒到肚子上啦。",
            "nextDialogs": [
              "400680205"
            ]
          },
          "400680205": {
            "id": "400680205",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "#{NICKNAME}，昨晚睡得好吗？",
            "nextDialogs": [
              "400680208"
            ]
          },
          "400680208": {
            "id": "400680208",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "大家好像都跟你差不多。今天我起得最早，四处逛了逛，摘了水果给大家当早餐。",
            "nextDialogs": [
              "400680209"
            ]
          },
          "400680209": {
            "id": "400680209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "为了等你起床，我可是一直忍着没先吃哦！",
            "nextDialogs": [
              "400680210"
            ]
          },
          "400680210": {
            "id": "400680210",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "在大家的陪伴下享用了水果早餐，期间，众人闲聊起来…",
            "nextDialogs": [
              "400680211"
            ]
          },
          "400680211": {
            "id": "400680211",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？菲谢尔一早就跑了？",
            "nextDialogs": [
              "400680212"
            ]
          },
          "400680212": {
            "id": "400680212",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "嗯，她似乎不太愿意跟我们一起行动，说是另有冒险家的工作。",
            "nextDialogs": [
              "400680213"
            ]
          },
          "400680213": {
            "id": "400680213",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "太假了吧！明明说是来光复幽夜净土的，怎么又给冒险家协会打工去了？",
            "nextDialogs": [
              "400680214"
            ]
          },
          "400680214": {
            "id": "400680214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好了…派蒙…",
            "nextDialogs": [
              "400680215"
            ]
          },
          "400680215": {
            "id": "400680215",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "瞧她的样子，应该是有心事吧。",
            "nextDialogs": [
              "400680216"
            ]
          },
          "400680216": {
            "id": "400680216",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "我们按原计划派出莫娜关怀她，没想到，她居然说莫娜不懂冒险家的工作，不能跟去冒险。",
            "nextDialogs": [
              "400680217"
            ]
          },
          "400680217": {
            "id": "400680217",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "菲谢尔为了独处，连幽夜净土这个借口都不用了呢…",
            "nextDialogs": [
              "400680218"
            ]
          },
          "400680218": {
            "id": "400680218",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "可见她遇到了不小的难题。",
            "nextDialogs": [
              "400680219"
            ]
          },
          "400680219": {
            "id": "400680219",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "唉，我身为朋友，很想帮帮她。不过有一句话她说对了，今天我们会去其他岛屿探索。",
            "nextDialogs": [
              "400680220"
            ]
          },
          "400680220": {
            "id": "400680220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "欸？是这样吗？",
            "nextDialogs": [
              "400680221"
            ]
          },
          "400680221": {
            "id": "400680221",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "大家全票通过的呢！",
            "nextDialogs": [
              "400680222"
            ]
          },
          "400680222": {
            "id": "400680222",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我都没参加，怎么能算全票！",
            "nextDialogs": [
              "400680223"
            ]
          },
          "400680223": {
            "id": "400680223",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "这个啊，刚才派蒙替你投了。她说，你和她是一伙的，你在哪儿她就在哪儿，反过来也一样。",
            "nextDialogs": [
              "400680224"
            ]
          },
          "400680224": {
            "id": "400680224",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，你可是冒险家，肯定会去的啦。",
            "nextDialogs": [
              "400680225"
            ]
          },
          "400680225": {
            "id": "400680225",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（派蒙这家伙，好吧…）",
            "nextDialogs": [
              "400680226"
            ]
          },
          "400680226": {
            "id": "400680226",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "菲谢尔建议我们一起行动，她自己还有其他想调查的事，让我们不用担心，她忙完就来跟我们会合。",
            "nextDialogs": [
              "400680227"
            ]
          },
          "400680227": {
            "id": "400680227",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "别看她平时那样，怎么说都是个经验丰富的冒险家，我想，我们应该相信她。",
            "nextDialogs": [
              "400680228"
            ]
          },
          "400680228": {
            "id": "400680228",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "跟菲谢尔认识不久，我的意见只是冒昧猜测而已。不过我认为…她的矛盾在于自身。",
            "nextDialogs": [
              "400680229"
            ]
          },
          "400680229": {
            "id": "400680229",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好像还挺准的…",
            "nextDialogs": [
              "400680230"
            ]
          },
          "400680230": {
            "id": "400680230",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "与他人的矛盾，不是解决就是放弃，唯独跟自己，永远不能轻易放下。",
            "nextDialogs": [
              "400680231"
            ]
          },
          "400680231": {
            "id": "400680231",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "…我也有过那样的时期，很理解她。虽不知道她在苦恼什么，但现在她需要独处。",
            "nextDialogs": [
              "400680232"
            ]
          },
          "400680232": {
            "id": "400680232",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "我也同意，就是可惜了今天的冒险之旅…大家一起才有意思啊。",
            "nextDialogs": [
              "400680233"
            ]
          },
          "400680233": {
            "id": "400680233",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "辛焱太有进取精神了…",
            "nextDialogs": [
              "400680234"
            ]
          },
          "400680234": {
            "id": "400680234",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "#啊对了，还没告诉你们呢。今天早上，北边那座岛屿出现了幻象，等{NICKNAME}吃完早餐，我们就去调查吧。"
          }
        }
      }
    },
    {
      "subId": "4006803",
      "subQuestName": "前往北边岛屿",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400680301"
        ],
        "dialogs": {
          "400680301": {
            "id": "400680301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看起来是正常的岛屿呢。",
            "nextDialogs": [
              "400680302"
            ]
          },
          "400680302": {
            "id": "400680302",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "…风里似乎有灼烧的气味。",
            "nextDialogs": [
              "400680303"
            ]
          },
          "400680303": {
            "id": "400680303",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "呃…我的水占盘变明亮一点了，可还是看不清楚…",
            "nextDialogs": [
              "400680304"
            ]
          },
          "400680304": {
            "id": "400680304",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "喂！看我发现了什么！",
            "nextDialogs": [
              "400680305"
            ]
          },
          "400680305": {
            "id": "400680305",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "这东西…该说它是一面鼓，还是一株植物？",
            "nextDialogs": [
              "400680306"
            ]
          },
          "400680306": {
            "id": "400680306",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "是植物构成的乐器？那看来…",
            "nextDialogs": [
              "400680307"
            ]
          },
          "400680307": {
            "id": "400680307",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "辛焱，这里该不会是跟你有关的岛屿吧？",
            "nextDialogs": [
              "400680308"
            ]
          },
          "400680308": {
            "id": "400680308",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "唔，难道这是给我准备的乐器？那我先敲一敲…",
            "nextDialogs": [
              "400680309"
            ]
          },
          "400680309": {
            "id": "400680309",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "稍等一下。昨天我碰了盆景中的假山，我们就被转移到某个特殊的空间内，辛焱，你要不要先做个准备？",
            "nextDialogs": [
              "400680310"
            ]
          },
          "400680310": {
            "id": "400680310",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "你说得对，但我不担心这个。我对音乐，可是随时都有所准备的。"
          }
        }
      }
    },
    {
      "subId": "4006818",
      "subQuestName": "敲响造型奇特的植物",
      "sceneId": null,
      "locations": [],

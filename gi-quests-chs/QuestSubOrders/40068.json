    {
      "subId": "4006809",
      "subQuestName": "靠近巨大的花朵",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400680901"
        ],
        "dialogs": {
          "400680901": {
            "id": "400680901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇！好大一朵花！",
            "nextDialogs": [
              "400680902"
            ]
          },
          "400680902": {
            "id": "400680902",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "这里好热…跟那朵花有关系吗？",
            "nextDialogs": [
              "400680903"
            ]
          },
          "400680903": {
            "id": "400680903",
            "speakerId": 1005,
            "speakerName": "火炽之心",
            "text": "没想到，这里会有客人。",
            "nextDialogs": [
              "400680904"
            ]
          },
          "400680904": {
            "id": "400680904",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咿啊啊啊啊它会说话！",
            "nextDialogs": [
              "400680907"
            ]
          },
          "400680907": {
            "id": "400680907",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我知道啦！但、但就是不一样嘛…",
            "nextDialogs": [
              "400680908"
            ]
          },
          "400680908": {
            "id": "400680908",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "您好，我们触摸了外面海滩上那些长得像鼓一样的植物，就被送到这一带来。请问您是这里的主人吗？",
            "nextDialogs": [
              "400680909"
            ]
          },
          "400680909": {
            "id": "400680909",
            "speakerId": 1005,
            "speakerName": "火炽之心",
            "text": "这里是音乐的殿堂，我不过是区区守门者。朋友们，你们也是来追求极致音乐的吗？",
            "nextDialogs": [
              "400680910"
            ]
          },
          "400680910": {
            "id": "400680910",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "没错。",
            "nextDialogs": [
              "400680911"
            ]
          },
          "400680911": {
            "id": "400680911",
            "speakerId": 1005,
            "speakerName": "火炽之心",
            "text": "那么，你对音乐的寄托是…",
            "nextDialogs": [
              "400680912"
            ]
          },
          "400680912": {
            "id": "400680912",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "为反抗高歌！",
            "nextDialogs": [
              "400680913"
            ]
          },
          "400680913": {
            "id": "400680913",
            "speakerId": 1005,
            "speakerName": "火炽之心",
            "text": "你很懂嘛！太好了，能遇到知己，我可真有福气。",
            "nextDialogs": [
              "400680914"
            ]
          },
          "400680914": {
            "id": "400680914",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "跟奇怪的花都这么投缘…",
            "nextDialogs": [
              "400680915"
            ]
          },
          "400680915": {
            "id": "400680915",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "好相处的人，走到哪里都有很多朋友呢。",
            "nextDialogs": [
              "400680916"
            ]
          },
          "400680916": {
            "id": "400680916",
            "speakerId": 1005,
            "speakerName": "火炽之心",
            "text": "你们能走到这里，一定是想进入更深层的殿堂。不过很抱歉，进入殿堂需要我的歌喉，而我现在嗓子有点哑…",
            "nextDialogs": [
              "400680917"
            ]
          },
          "400680917": {
            "id": "400680917",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "你不要紧吧？要不要，呃，喝点驱寒的药？",
            "nextDialogs": [
              "400680918"
            ]
          },
          "400680918": {
            "id": "400680918",
            "speakerId": 1005,
            "speakerName": "火炽之心",
            "text": "不，我只是太久没喝「寒山甘泉」了。只要喝到那个，我就能重振歌喉，为你们打开道路。",
            "nextDialogs": [
              "400680919"
            ]
          },
          "400680919": {
            "id": "400680919",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "「寒山甘泉」？是泉水的名字？",
            "nextDialogs": [
              "400680920"
            ]
          },
          "400680920": {
            "id": "400680920",
            "speakerId": 1005,
            "speakerName": "火炽之心",
            "text": "对。只要喝下那种水，疲惫的大人，困倦的小鸟，无知的孩童…所有人都能唱出最优美的歌声。",
            "nextDialogs": [
              "400680921"
            ]
          },
          "400680921": {
            "id": "400680921",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "……",
            "nextDialogs": [
              "400680922"
            ]
          },
          "400680922": {
            "id": "400680922",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "好，我帮你找。你把泉水的所在地告诉我。",
            "nextDialogs": [
              "400680923"
            ]
          },
          "400680923": {
            "id": "400680923",
            "speakerId": 1005,
            "speakerName": "火炽之心",
            "text": "谢谢你！清澈的水令植物生长，它们变得茁壮，克服困难攀上高山…泉水，就在那些被植被庇护的山上。",
            "nextDialogs": [
              "400680924"
            ]
          },
          "400680924": {
            "id": "400680924",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来是上山啊！我还以为随便打点海水就行。",
            "nextDialogs": [
              "400680925"
            ]
          },
          "400680925": {
            "id": "400680925",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "山泉跟海水完全是两种东西吧。",
            "nextDialogs": [
              "400680926"
            ]
          },
          "400680926": {
            "id": "400680926",
            "speakerId": 1005,
            "speakerName": "火炽之心",
            "text": "只不过，想要看到那样的山泉，或许得靠我的力量。这位朋友，把手给我，这样你就能看到我所看见的事物。",
            "nextDialogs": [
              "400680927"
            ]
          },
          "400680927": {
            "id": "400680927",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "握了我的手，就是结交我这个朋友了哦。"
          }
        }
      }
    },
    {
      "subId": "4006810",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400681001"
        ],
        "dialogs": {
          "400681001": {
            "id": "400681001",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，出来了！",
            "nextDialogs": [
              "400681002"
            ]
          },
          "400681002": {
            "id": "400681002",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "嗯~还是外面明亮，不过我也不讨厌那个热乎乎的山洞。",
            "nextDialogs": [
              "400681003"
            ]
          },
          "400681003": {
            "id": "400681003",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "「寒山甘泉」就在这附近的山上，我们一起找。",
            "nextDialogs": [
              "400681004"
            ]
          },
          "400681004": {
            "id": "400681004",
            "speakerId": 1004,
            "speakerName": "莫娜",
            "text": "等等，这地下怎么有光？这是…水脉？",
            "nextDialogs": [
              "400681005"
            ]
          },
          "400681005": {
            "id": "400681005",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "根据那朵花说的话…水脉和植物有关，植物又跟山上的泉水有关。跟着水脉走，准没错。"
          }
        }
      }
    },
    {
      "subId": "4006811",
      "subQuestName": "疏通贯穿山体的水脉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4006812",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400681201"
        ],
        "dialogs": {
          "400681201": {
            "id": "400681201",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "各位，这里有张纸条。",
            "nextDialogs": [
              "400681202"
            ]
          },
          "400681202": {
            "id": "400681202",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "原来如此，这座岛真是有趣啊。",
            "nextDialogs": [
              "400681203"
            ]
          },
          "400681203": {
            "id": "400681203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这种口吻，还有这个署名，是阿贝多呢！我们在蒙德的朋友。",
            "nextDialogs": [
              "400681204"
            ]
          },
          "400681204": {
            "id": "400681204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "阿贝多是很厉害的炼金术士，他也来过这片海岛哦，这张纸是他留给后来者的笔记。",
            "nextDialogs": [
              "400681205"
            ]
          },
          "400681205": {
            "id": "400681205",
            "speakerId": 1001,
            "speakerName": "枫原万叶",
            "text": "哦？原来是他。",
            "nextDialogs": [
              "400681206"
            ]
          },
          "400681206": {
            "id": "400681206",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "他的意思是，这整座岛都被做成了乐器？天哪，太厉害了。",
            "nextDialogs": [
              "400681207"
            ]
          },
          "400681207": {
            "id": "400681207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "而且还跟地下的水脉有关，唔，可能是要把水脉全部疏通才能奏响这座岛吧…",
            "nextDialogs": [
              "400681208"
            ]
          },
          "400681208": {
            "id": "400681208",
            "speakerId": 1003,
            "speakerName": "辛焱",
            "text": "演奏乐器之前先做清扫工作，很合理。"
          }
        }
      }
    },
    {
      "subId": "4006817",
      "subQuestName": "疏通贯穿山体的水脉",
      "sceneId": null,

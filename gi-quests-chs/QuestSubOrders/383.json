    {
      "subId": "38302",
      "subQuestName": "与琴对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3830201"
        ],
        "dialogs": {
          "3830201": {
            "id": "3830201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔吼——",
            "nextDialogs": [
              "3830202"
            ]
          },
          "3830202": {
            "id": "3830202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「特瓦林保护协会」！再次集结！",
            "nextDialogs": [
              "3830203"
            ]
          },
          "3830203": {
            "id": "3830203",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "那么，快把收集到的结晶拿出来吧。",
            "nextDialogs": [
              "3830204"
            ]
          },
          "3830204": {
            "id": "3830204",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "啊…",
            "nextDialogs": [
              "3830205"
            ]
          },
          "3830205": {
            "id": "3830205",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "结晶的色泽似乎更加浑浊了…",
            "nextDialogs": [
              "3830206"
            ]
          },
          "3830206": {
            "id": "3830206",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "特瓦林…究竟在忍受怎样的折磨…",
            "nextDialogs": [
              "3830207"
            ]
          },
          "3830207": {
            "id": "3830207",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "总之，先把这些结晶净化吧。异邦的旅行者，拜托你了。",
            "nextDialogs": [
              "3830208"
            ]
          },
          "3830208": {
            "id": "3830208",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "若不是亲眼所见，还真是难以置信…",
            "nextDialogs": [
              "3830209"
            ]
          },
          "3830209": {
            "id": "3830209",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "很有意思。就像滤酒一样，令人神清气爽。",
            "nextDialogs": [
              "3830210"
            ]
          },
          "3830210": {
            "id": "3830210",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "有这么多泪滴就够了。那么接下来…"
          }
        }
      }
    },
    {
      "subId": "38303",
      "subQuestName": "将风龙泪滴滴在天空之琴上",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3830301"
        ],
        "dialogs": {
          "3830301": {
            "id": "3830301",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#好了，{NICKNAME}赶紧修复天空之琴吧！"
          }
        }
      }
    },
    {
      "subId": "38304",
      "subQuestName": "(test)继续与琴对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3830401"
        ],
        "dialogs": {
          "3830401": {
            "id": "3830401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "成功啦！",
            "nextDialogs": [
              "3830402"
            ]
          },
          "3830402": {
            "id": "3830402",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "和原先的感觉完全不一样了。",
            "nextDialogs": [
              "3830403"
            ]
          },
          "3830403": {
            "id": "3830403",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "风元素…满溢到了活泼的程度呢。这样的话应该没问题了。",
            "nextDialogs": [
              "3830404"
            ]
          },
          "3830404": {
            "id": "3830404",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "#多亏了你呀，{NICKNAME}。",
            "nextDialogs": [
              "3830405"
            ]
          },
          "3830405": {
            "id": "3830405",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "那么，我们该在哪里呼唤风魔龙？",
            "nextDialogs": [
              "3830406"
            ]
          },
          "3830406": {
            "id": "3830406",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "在蒙德城内肯定不行，如果失败，就会造成难以弥补的损失。",
            "nextDialogs": [
              "3830407"
            ]
          },
          "3830407": {
            "id": "3830407",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "就在这酒庄的话，显然也…",
            "nextDialogs": [
              "3830408"
            ]
          },
          "3830408": {
            "id": "3830408",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "哦。酒庄没了倒也不是什么难以弥补的损失，但最好不要。",
            "nextDialogs": [
              "3830409"
            ]
          },
          "3830409": {
            "id": "3830409",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "……",
            "nextDialogs": [
              "3830410"
            ]
          },
          "3830410": {
            "id": "3830410",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "海风或者高处的风，都可以让诗人的歌声传颂得更远。",
            "nextDialogs": [
              "3830411"
            ]
          },
          "3830411": {
            "id": "3830411",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "如果空气干燥、沉闷又压抑，那不仅诗人，就连龙都会生气吧。",
            "nextDialogs": [
              "3830412"
            ]
          },
          "3830412": {
            "id": "3830412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来如此。海风或者高处的风，是吗？",
            "nextDialogs": [
              "3830413"
            ]
          },
          "3830413": {
            "id": "3830413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以，最适合弹奏的地方应该就是…",
            "nextDialogs": [
              "3830418",
              "3830417"
            ]
          },
          "3830418": {
            "id": "3830418",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "从星落湖向东一段距离，在海滩的南方有一片山地。",
            "nextDialogs": [
              "3830419"
            ]
          },
          "3830419": {
            "id": "3830419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…啊！是在说你上次睡懒觉的那片海滩呢。",
            "nextDialogs": [
              "3830420"
            ]
          },
          "3830420": {
            "id": "3830420",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "沿着山地延伸的方向攀登，可以抵达一个叫做<color=#00E1FFFF>摘星崖</color>的地方。",
            "nextDialogs": [
              "3830421"
            ]
          },
          "3830421": {
            "id": "3830421",
            "speakerId": 1009,
            "speakerName": "迪卢克",
            "text": "歌手，你想要的海风与高处的风，在那里都能找到吧。",
            "nextDialogs": [
              "3830422"
            ]
          },
          "3830422": {
            "id": "3830422",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯，我想想，摘星崖是吧…",
            "nextDialogs": [
              "3830423"
            ]
          },
          "3830423": {
            "id": "3830423",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "…确实是很不错的位置呢，是个很衬我歌声的地方。",
            "nextDialogs": [
              "3830424"
            ]
          },
          "3830424": {
            "id": "3830424",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "很好。那我们就做好准备，在摘星崖集合吧。",
            "nextDialogs": [
              "3830425"
            ]
          },
          "3830425": {
            "id": "3830425",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "还请大家认真对待，不要迟到。",
            "nextDialogs": [
              "3830426"
            ]
          },
          "3830426": {
            "id": "3830426",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "遵命，团长大人！",
            "nextDialogs": [
              "3830427"
            ]
          },
          "3830427": {
            "id": "3830427",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "啊…抱歉，一不小心就…"
          },
          "3830417": {
            "id": "3830417",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "那种事连安柏都做不到吧。"
          }
        }
      }
    }
  ]
}
          "731850104": {
            "id": "731850104",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "我叫阿尔伯，是个商人，本来只是在这里休息一下…",
            "nextDialogs": [
              "731850105"
            ]
          },
          "731850105": {
            "id": "731850105",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "但没想到，却被那些丘丘人突然袭击了…"
          }
        }
      }
    },

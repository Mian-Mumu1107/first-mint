    {
      "subId": "7318510",
      "subQuestName": "与阿尔伯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731850701"
        ],
        "dialogs": {
          "731850701": {
            "id": "731850701",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "太好了！真是太感谢你了旅行者！",
            "nextDialogs": [
              "731850702"
            ]
          },
          "731850702": {
            "id": "731850702",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "这两只驮兽和货物要是全丢了，我今天非得破产不可。",
            "nextDialogs": [
              "731850705"
            ]
          },
          "731850705": {
            "id": "731850705",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "喔！对了，还得给你报酬，稍等一下…",
            "nextDialogs": [
              "731850706"
            ]
          },
          "731850706": {
            "id": "731850706",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "这些东西请你收下吧。看你的样子，肯定常年都在野外冒险。",
            "nextDialogs": [
              "731850707"
            ]
          },
          "731850707": {
            "id": "731850707",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "我做的正好就是和冒险用具相关的生意，这些东西你肯定都用得上。",
            "nextDialogs": [
              "731850708"
            ]
          },
          "731850708": {
            "id": "731850708",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "呼…驮兽找回来了，货物也基本上完好，我得赶紧离开这里了。",
            "nextDialogs": [
              "731850709"
            ]
          },
          "731850709": {
            "id": "731850709",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "再次谢谢你，旅行者。"
          }
        }
      }
    },
    {
      "subId": "7318502",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731850201"
        ],
        "dialogs": {
          "731850201": {
            "id": "731850201",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "唉…真是不能在驮兽吃饭的时候打扰它们啊。"
          }
        }
      }
    },
    {
      "subId": "7318599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731859901"
        ],
        "dialogs": {
          "731859901": {
            "id": "731859901",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "救，救命啊！谁来帮帮我！",
            "nextDialogs": [
              "731859902"
            ]
          },
          "731859902": {
            "id": "731859902",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那边有人遇见危险了！我们快去帮忙！",
            "nextDialogs": [
              "731859903"
            ]
          },
          "731859903": {
            "id": "731859903",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这里就是阿尔伯先生给我们标记的位置之一了…",
            "nextDialogs": [
              "731859904"
            ]
          },
          "731859904": {
            "id": "731859904",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你看那边的水洼，旁边有一圈脚印，那会不会就是驮兽留下的？",
            "nextDialogs": [
              "731859905"
            ]
          },
          "731859905": {
            "id": "731859905",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "如果那只驮兽踩过了这片水洼…蹄子上一定会带着水…",
            "nextDialogs": [
              "731859906"
            ]
          },
          "731859906": {
            "id": "731859906",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嘿嘿，是用「元素视野」的时候了，跟着「水」的痕迹找到那只驮兽吧。",
            "nextDialogs": [
              "731859911"
            ]
          },
          "731859911": {
            "id": "731859911",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这个箱子里面装着好多东西，也许是那只驮兽奔逃的时候掉下来的货物。",
            "nextDialogs": [
              "731859912"
            ]
          },
          "731859912": {
            "id": "731859912",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "它应该就在前面了，继续前进吧。",
            "nextDialogs": [
              "731859913"
            ]
          },
          "731859913": {
            "id": "731859913",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "对了，记得把这些货物带回去给阿尔伯先生喔。"
          }
        }
      }
    }
  ]
}
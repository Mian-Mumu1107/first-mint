    {
      "subId": "7318504",
      "subQuestName": "打倒所有丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731850401"
        ],
        "dialogs": {
          "731850401": {
            "id": "731850401",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇！这只驮兽好大，被它撞一下肯定不好受…",
            "nextDialogs": [
              "731850402"
            ]
          },
          "731850402": {
            "id": "731850402",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "快把阿尔伯先生给我们的食物拿出来给它吧。",
            "nextDialogs": [
              "731850403"
            ]
          },
          "731850403": {
            "id": "731850403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请慢用…",
            "nextDialogs": [
              "731850404"
            ]
          },
          "731850404": {
            "id": "731850404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这些真的能吃饱吗…",
            "nextDialogs": [
              "731850405"
            ]
          },
          "731850405": {
            "id": "731850405",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "看起来，它好像心情不错呢。",
            "nextDialogs": [
              "731850406"
            ]
          },
          "731850406": {
            "id": "731850406",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "快，我们把它带回去吧。",
            "nextDialogs": [
              "731850407"
            ]
          },
          "731850407": {
            "id": "731850407",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "和驮兽一同回到了阿尔伯身边…",
            "nextDialogs": [
              "731850408"
            ]
          },
          "731850408": {
            "id": "731850408",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "驮兽飞快地吞下了食物，似乎心情变好了一些…",
            "nextDialogs": [
              "731850409"
            ]
          },
          "731850409": {
            "id": "731850409",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "太好了…我还以为这只驮兽真跑丢了…",
            "nextDialogs": [
              "731850410"
            ]
          },
          "731850410": {
            "id": "731850410",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "谢谢你旅行者，真是太谢谢你了。",
            "nextDialogs": [
              "731850411"
            ]
          },
          "731850411": {
            "id": "731850411",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "我得赶紧检查一下这只驮兽的状况，希望它没有受什么伤…",
            "nextDialogs": [
              "731850412"
            ]
          },
          "731850412": {
            "id": "731850412",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "请你再帮我找找另外一只驮兽吧，旅行者。",
            "nextDialogs": [
              "731850413"
            ]
          },
          "731850413": {
            "id": "731850413",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "太好了，这下两只驮兽都找回来了！太感谢你了，旅行者。",
            "nextDialogs": [
              "731850414"
            ]
          },
          "731850414": {
            "id": "731850414",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "等我把这些货物归整好之后，就回城里去。",
            "nextDialogs": [
              "731850415"
            ]
          },
          "731850415": {
            "id": "731850415",
            "speakerId": 1000,
            "speakerName": "阿尔伯",
            "text": "唉，下次运货的时候，我必须得请几个护卫了…",
            "nextDialogs": [
              "731850416"
            ]
          },
          "731850416": {
            "id": "731850416",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于捡到的货物…"
          }
        }
      }
    },

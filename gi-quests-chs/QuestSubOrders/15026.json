  },
  "subQuests": [
    {
      "subId": "1502607",
      "subQuestName": "前往烟谜主",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150260701"
        ],
        "dialogs": {
          "150260701": {
            "id": "150260701",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？这里怎么有愚人众的人？",
            "nextDialogs": [
              "150260702"
            ]
          },
          "150260702": {
            "id": "150260702",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "总觉得有点不放心啊…我们过去看看他们在做什么吧。",
            "nextDialogs": [
              "150260703"
            ]
          },
          "150260703": {
            "id": "150260703",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "话说回来，他们这些人是怎么来到这里的？这里可是部族驻地啊。",
            "nextDialogs": [
              "150260706"
            ]
          },
          "150260706": {
            "id": "150260706",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦…现在还留在纳塔的愚人众应该都是「队长」的部下吧？严格来说，他们也算是一位纳塔英雄的追随者呢。",
            "nextDialogs": [
              "150260707"
            ]
          },
          "150260707": {
            "id": "150260707",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，我承认我对他们还是有偏见，在这里看到他们，总觉得很奇怪…可得好好问问！"
          }
        }
      }
    },
    {
      "subId": "1502601",
      "subQuestName": "盘问可疑的愚人众",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150260101"
        ],
        "dialogs": {
          "150260101": {
            "id": "150260101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咳咳…你们在这里做什么？",
            "nextDialogs": [
              "150260102"
            ]
          },
          "150260102": {
            "id": "150260102",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "哈？我们拿钱办事，有事请找雇主。",
            "nextDialogs": [
              "150260103"
            ]
          },
          "150260103": {
            "id": "150260103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "什么态度…话说愚人众接受雇佣的吗？",
            "nextDialogs": [
              "150260104"
            ]
          },
          "150260104": {
            "id": "150260104",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "咳咳！他是格洛德克，受我雇佣，负责在纳塔保护我的安全。看来他不太擅长待人接物，让两位见笑了。",
            "nextDialogs": [
              "150260105"
            ]
          },
          "150260105": {
            "id": "150260105",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "我本来想从纳塔的原住民当中雇佣人手，但一位祭司向我推荐了格洛德克和他的小队。",
            "nextDialogs": [
              "150260106"
            ]
          },
          "150260106": {
            "id": "150260106",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "说是他们最近正好闲着，战斗力也不错，很符合我的要求…听起来愚人众在纳塔的风评似乎还挺好的。",
            "nextDialogs": [
              "150260107"
            ]
          },
          "150260107": {
            "id": "150260107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来是这样啊…另外，你是枫丹人？",
            "nextDialogs": [
              "150260108"
            ]
          },
          "150260108": {
            "id": "150260108",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "#在下蒙吕松，来自枫丹，主要做一些出版生意。两位…两位莫非就是那位旅行者和{M#他}{F#她}的精灵伙伴？",
            "nextDialogs": [
              "150260109"
            ]
          },
          "150260109": {
            "id": "150260109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你知道我们？",
            "nextDialogs": [
              "150260110"
            ]
          },
          "150260110": {
            "id": "150260110",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "金发的旅者，银色的飞行伙伴…不会错的。",
            "nextDialogs": [
              "150260111"
            ]
          },
          "150260111": {
            "id": "150260111",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "两位在枫丹留下的事迹足以支撑起一个畅销书系列，我作为书商怎么会认不出两位？",
            "nextDialogs": [
              "150260112"
            ]
          },
          "150260112": {
            "id": "150260112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#我们果然很有名啊，{NICKNAME}！",
            "nextDialogs": [
              "150260113"
            ]
          },
          "150260113": {
            "id": "150260113",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "我的运气真不错——说起来有些唐突，其实我刚刚还在发愁要去哪里寻找两位呢，我有个不情之请…",
            "nextDialogs": [
              "150260114"
            ]
          },
          "150260114": {
            "id": "150260114",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么有种委托人从枫丹追到纳塔的感觉？又开心不起来了…",
            "nextDialogs": [
              "150260115"
            ]
          },
          "150260115": {
            "id": "150260115",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "事成之后，必有重谢！",
            "nextDialogs": [
              "150260116"
            ]
          },
          "150260116": {
            "id": "150260116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…这位倒是干脆，先听他讲讲？",
            "nextDialogs": [
              "150260119"
            ]
          },
          "150260119": {
            "id": "150260119",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咳咳…请问阁下有什么请求？",
            "nextDialogs": [
              "150260120"
            ]
          },
          "150260120": {
            "id": "150260120",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "两位认识茜特菈莉吧？我想麻烦两位请那位大萨满出山助我一臂之力！",
            "nextDialogs": [
              "150260121"
            ]
          },
          "150260121": {
            "id": "150260121",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃…让茜特菈莉帮陌生人办事，凭我们的交情也很难办到吧？",
            "nextDialogs": [
              "150260122"
            ]
          },
          "150260122": {
            "id": "150260122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那种性格，很难想象…",
            "nextDialogs": [
              "150260123"
            ]
          },
          "150260123": {
            "id": "150260123",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说实话，她不太喜欢和陌生人打交道…",
            "nextDialogs": [
              "150260124"
            ]
          },
          "150260124": {
            "id": "150260124",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "这个我已经从烟谜主的族人那里打听到了，他们还告诉我，如果非要找出一个能够请她出山的人，那就只能是「金发的旅者」。",
            "nextDialogs": [
              "150260125"
            ]
          },
          "150260125": {
            "id": "150260125",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "只要两位能帮忙，报酬可以加倍！",
            "nextDialogs": [
              "150260126"
            ]
          },
          "150260126": {
            "id": "150260126",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "150260127"
            ]
          },
          "150260127": {
            "id": "150260127",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先问清楚是什么事吧。",
            "nextDialogs": [
              "150260128"
            ]
          },
          "150260128": {
            "id": "150260128",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也对…请问你要找茜特菈莉帮忙做什么？我们至少要先了解一下。",
            "nextDialogs": [
              "150260129"
            ]
          },
          "150260129": {
            "id": "150260129",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "这个说来话长，涉及到烟谜主的一些历史…还是让专业人士来向两位说明吧——艾列尔，有劳了。",
            "nextDialogs": [
              "150260130"
            ]
          },
          "150260130": {
            "id": "150260130",
            "speakerId": 1003,
            "speakerName": "艾列尔",
            "text": "当然可以！平时很少有人愿意听我讲这些…初次见面，我是来自枫丹科学院的研究员，叫我艾列尔就好。",
            "nextDialogs": [
              "150260131"
            ]
          },
          "150260131": {
            "id": "150260131",
            "speakerId": 1003,
            "speakerName": "艾列尔",
            "text": "和大部分研究员不同，我对研究古代遗迹也很感兴趣，所以才有幸受邀加入蒙吕松先生的队伍。",
            "nextDialogs": [
              "150260132"
            ]
          },
          "150260132": {
            "id": "150260132",
            "speakerId": 1003,
            "speakerName": "艾列尔",
            "text": "不知道两位是否听说过传奇萨满维奇琳的事迹？"
          }
        }
      }
    },
    {
      "subId": "1502602",
      "subQuestName": "前往茜特菈莉的住处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150260201"
        ],
        "dialogs": {
          "150260201": {
            "id": "150260201",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "这里就是那位大萨满的住处吗？也太偏远了些，帮我们指路的族民应该没骗人吧？",
            "nextDialogs": [
              "150260202"
            ]
          },
          "150260202": {
            "id": "150260202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "如果是茜特菈莉的话，住在这种地方倒也不奇怪吧。",
            "nextDialogs": [
              "150260203"
            ]
          },
          "150260203": {
            "id": "150260203",
            "speakerId": 1003,
            "speakerName": "艾列尔",
            "text": "这墙上的涂鸦是那位大萨满的创作吗？或许和部族文化有关！如果能让我把这些涂鸦临摹下来的话…",
            "nextDialogs": [
              "150260204"
            ]
          },
          "150260204": {
            "id": "150260204",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "艾列尔，办正事要紧。就像之前说好的那样，请两位帮忙接洽，我和其他人就在这里等候好了。",
            "nextDialogs": [
              "150260205"
            ]
          },
          "150260205": {
            "id": "150260205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#嗯，{NICKNAME}，我们去敲门吧！希望她没有宿醉…",
            "nextDialogs": [
              "150260206"
            ]
          },
          "150260206": {
            "id": "150260206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#茜特菈莉，你在家吗？{NICKNAME}和我有些事情要找你帮忙。",
            "nextDialogs": [
              "150260207"
            ]
          },
          "150260207": {
            "id": "150260207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…没反应啊，难道她不在家？",
            "nextDialogs": [
              "150260208"
            ]
          },
          "150260208": {
            "id": "150260208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "试试另一个称呼？",
            "nextDialogs": [
              "150260209"
            ]
          },
          "150260209": {
            "id": "150260209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦，黑曜石奶奶，你在家吗？",
            "nextDialogs": [
              "150260210"
            ]
          },
          "150260210": {
            "id": "150260210",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "房门突然被打开，一股酒气扑面而来。",
            "nextDialogs": [
              "150260211"
            ]
          },
          "150260211": {
            "id": "150260211",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "小鬼，要找我挑战得提前预约…",
            "nextDialogs": [
              "150260212"
            ]
          },
          "150260212": {
            "id": "150260212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（茜特菈莉平时这么宅的吗？）",
            "nextDialogs": [
              "150260213"
            ]
          },
          "150260213": {
            "id": "150260213",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "#…{NICKNAME}！",
            "nextDialogs": [
              "150260214"
            ]
          },
          "150260214": {
            "id": "150260214",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "房门又被猛地关闭。",
            "nextDialogs": [
              "150260215"
            ]
          },
          "150260215": {
            "id": "150260215",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…看来我们来得很不是时候。",
            "nextDialogs": [
              "150260216"
            ]
          },
          "150260216": {
            "id": "150260216",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "咳咳…你们还在吗？可以进来了…进来讲！",
            "nextDialogs": [
              "150260217"
            ]
          },
          "150260217": {
            "id": "150260217",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "还好没有被拒绝…"
          }
        }
      }
    },
    {
      "subId": "1502603",
      "subQuestName": "进入茜特菈莉的住处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1502604",
      "subQuestName": "与茜特菈莉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150260401"
        ],
        "dialogs": {
          "150260401": {
            "id": "150260401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃…这就是茜特菈莉住的地方…",
            "nextDialogs": [
              "150260402"
            ]
          },
          "150260402": {
            "id": "150260402",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "我就知道一时半会儿根本收拾不完…想要吐槽也无所谓啦。奶奶我身为烟谜主的大萨满，从来不关注这些无聊的家务活。",
            "nextDialogs": [
              "150260403"
            ]
          },
          "150260403": {
            "id": "150260403",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "那种总是把房间收拾得干干净净的人，在轻小说里往往都当不上主角。",
            "nextDialogs": [
              "150260404"
            ]
          },
          "150260404": {
            "id": "150260404",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "另外，我那是看透世事的不修边幅，不是宅。",
            "nextDialogs": [
              "150260405"
            ]
          },
          "150260405": {
            "id": "150260405",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "她似乎很在意自己在我们眼里的形象？",
            "nextDialogs": [
              "150260406"
            ]
          },
          "150260406": {
            "id": "150260406",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "对了，之前用法术将部分感官分享给你们的时候出现了一些副作用，你们摆脱那种副作用了吧？",
            "nextDialogs": [
              "150260407"
            ]
          },
          "150260407": {
            "id": "150260407",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "出于身为大萨满的责任，我必须再确认一下。",
            "nextDialogs": [
              "150260408"
            ]
          },
          "150260408": {
            "id": "150260408",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你是指能听到各自心声的事？没有没有，已经过去那么久了，不必再为这种事担心了吧？",
            "nextDialogs": [
              "150260409"
            ]
          },
          "150260409": {
            "id": "150260409",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "#那为什么我突然能听到{NICKNAME}的心声了…",
            "nextDialogs": [
              "150260410"
            ]
          },
          "150260410": {
            "id": "150260410",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "什么？",
            "nextDialogs": [
              "150260411"
            ]
          },
          "150260411": {
            "id": "150260411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（所以是因为听到了我在心里的评价吗？茜特菈莉应该更坦然一些才对吧，毕竟是「看透世事的不修边幅」啊…）",
            "nextDialogs": [
              "150260412"
            ]
          },
          "150260412": {
            "id": "150260412",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "我现在还能听到的！",
            "nextDialogs": [
              "150260413"
            ]
          },
          "150260413": {
            "id": "150260413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "如果有所冒犯，我道歉…",
            "nextDialogs": [
              "150260414"
            ]
          },
          "150260414": {
            "id": "150260414",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "少废话，我会想办法处理的。啧，之前是你能听到我的心声，现在是我能听到你的心声…",
            "nextDialogs": [
              "150260415"
            ]
          },
          "150260415": {
            "id": "150260415",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "只是一种用来分享感官的法术而已，到底是什么样的体质才能搞出这么复杂的副作用？",
            "nextDialogs": [
              "150260416"
            ]
          },
          "150260416": {
            "id": "150260416",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "罢了罢了，先说说你们来找我有什么事吧。",
            "nextDialogs": [
              "150260417"
            ]
          },
          "150260417": {
            "id": "150260417",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦，是这样的。有人委托我们请你出山做顾问，他们想调查一些与纳塔历史有关的事。",
            "nextDialogs": [
              "150260418"
            ]
          },
          "150260418": {
            "id": "150260418",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "专门委托拯救了纳塔的英雄来请我？看来这些人明白奶奶我很讨厌麻烦事。",
            "nextDialogs": [
              "150260419"
            ]
          },
          "150260419": {
            "id": "150260419",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他们给的报酬很不错呢！",
            "nextDialogs": [
              "150260420"
            ]
          },
          "150260420": {
            "id": "150260420",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "我拒绝，我很忙。",
            "nextDialogs": [
              "150260421"
            ]
          },
          "150260421": {
            "id": "150260421",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么看都不像是很忙的样子啊…果然凭我们的交情也没法请她出面帮陌生人办事…",
            "nextDialogs": [
              "150260422"
            ]
          },
          "150260422": {
            "id": "150260422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "如果这也是我的请求呢？",
            "nextDialogs": [
              "150260423"
            ]
          },
          "150260423": {
            "id": "150260423",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "你的请求…",
            "nextDialogs": [
              "150260424"
            ]
          },
          "150260424": {
            "id": "150260424",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，我们不久前被赋予了一项神圣的使命——帮助烟谜主制作记录历史大事件的特殊织物！",
            "nextDialogs": [
              "150260425"
            ]
          },
          "150260425": {
            "id": "150260425",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "欸？这一次被选中的人是你们？",
            "nextDialogs": [
              "150260426"
            ]
          },
          "150260426": {
            "id": "150260426",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#我和{NICKNAME}当初也很惊讶，毕竟我们根本不知道如何制作那种织物…",
            "nextDialogs": [
              "150260427"
            ]
          },
          "150260427": {
            "id": "150260427",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过在首领庇兰的帮助下，还是获得了一些进展。",
            "nextDialogs": [
              "150260428"
            ]
          },
          "150260428": {
            "id": "150260428",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "虽然最后没有成功，但至少我们知道制作这种织物的关键是一种特殊的色彩。",
            "nextDialogs": [
              "150260429"
            ]
          },
          "150260429": {
            "id": "150260429",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那些人想要调查的历史事件就与色彩有关，如果茜特菈莉能出山，或许也能帮到我们。",
            "nextDialogs": [
              "150260430"
            ]
          },
          "150260430": {
            "id": "150260430",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "……",
            "nextDialogs": [
              "150260431"
            ]
          },
          "150260431": {
            "id": "150260431",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "茜特菈莉又摆出那种表情了，是我解释得不清楚吗？",
            "nextDialogs": [
              "150260432"
            ]
          },
          "150260432": {
            "id": "150260432",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "该说是超展开还是伏笔回收呢？",
            "nextDialogs": [
              "150260433"
            ]
          },
          "150260433": {
            "id": "150260433",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃…我不太懂你在想什么，所以还是不方便吗？",
            "nextDialogs": [
              "150260434"
            ]
          },
          "150260434": {
            "id": "150260434",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "我…我必须慎重地考虑一下…",
            "nextDialogs": [
              "150260435"
            ]
          },
          "150260435": {
            "id": "150260435",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好像有戏哎！",
            "nextDialogs": [
              "150260436"
            ]
          },
          "150260436": {
            "id": "150260436",
            "speakerId": 1006,
            "speakerName": "格洛德克",
            "text": "喂！还没谈好吗？来不来倒是给个准信啊！",
            "nextDialogs": [
              "150260437"
            ]
          },
          "150260437": {
            "id": "150260437",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这…说好了让我们来负责沟通的！",
            "nextDialogs": [
              "150260438"
            ]
          },
          "150260438": {
            "id": "150260438",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "啧…",
            "nextDialogs": [
              "150260439"
            ]
          },
          "150260439": {
            "id": "150260439",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "茜特菈莉…"
          }
        }
      }
    },
    {
      "subId": "1502605",
      "subQuestName": "离开茜特菈莉的住处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1502606",
      "subQuestName": "追上茜特菈莉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150260601"
        ],
        "dialogs": {
          "150260601": {
            "id": "150260601",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "格洛德克，付钱的人是我，陪同雇主等待也是你需要提供的服务吧？退下！",
            "nextDialogs": [
              "150260602"
            ]
          },
          "150260602": {
            "id": "150260602",
            "speakerId": 1006,
            "speakerName": "格洛德克",
            "text": "明白。",
            "nextDialogs": [
              "150260603"
            ]
          },
          "150260603": {
            "id": "150260603",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "几百岁的大萨满竟然如此…非常抱歉，惊扰到您了，这临时雇佣的部下果然不好约束。",
            "nextDialogs": [
              "150260604"
            ]
          },
          "150260604": {
            "id": "150260604",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呼…没惹得茜特菈莉动手，真是万幸。",
            "nextDialogs": [
              "150260605"
            ]
          },
          "150260605": {
            "id": "150260605",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "既然您来了，不如我们就谈谈…",
            "nextDialogs": [
              "150260606"
            ]
          },
          "150260606": {
            "id": "150260606",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "打听过黑曜石奶奶是什么人物吗？你觉得我会被你们唱的双簧骗到？",
            "nextDialogs": [
              "150260607"
            ]
          },
          "150260607": {
            "id": "150260607",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "这…",
            "nextDialogs": [
              "150260608"
            ]
          },
          "150260608": {
            "id": "150260608",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "我根本没打算和你谈，刚刚要做一个很重要的决定，但你的人打扰到我了。",
            "nextDialogs": [
              "150260609"
            ]
          },
          "150260609": {
            "id": "150260609",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "我出来就是为了告诉你，如果还有下一次，你们的下场会惨到恐怖小说都写不出来。",
            "nextDialogs": [
              "150260610"
            ]
          },
          "150260610": {
            "id": "150260610",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇…",
            "nextDialogs": [
              "150260611"
            ]
          },
          "150260611": {
            "id": "150260611",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "#{NICKNAME}，我们回去继续谈。",
            "nextDialogs": [
              "150260612"
            ]
          },
          "150260612": {
            "id": "150260612",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "黑曜石奶奶果然名不虚传，是我无礼了。不过，我真的很难想象，就连「七彩之战」也吸引不了您啊…",
            "nextDialogs": [
              "150260613"
            ]
          },
          "150260613": {
            "id": "150260613",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "你想调查的是「七彩之战」？",
            "nextDialogs": [
              "150260614"
            ]
          },
          "150260614": {
            "id": "150260614",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "#原来{NICKNAME}还没有将此事向您讲明吗？",
            "nextDialogs": [
              "150260615"
            ]
          },
          "150260615": {
            "id": "150260615",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "#其实我当初认为能请您出山，除了{NICKNAME}愿意帮我引荐之外，还因为我觉得查清这件事对您本身也很重要。",
            "nextDialogs": [
              "150260616"
            ]
          },
          "150260616": {
            "id": "150260616",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "我听说那位名为维奇琳的大萨满曾是您的故旧，想必您十分了解她。",
            "nextDialogs": [
              "150260617"
            ]
          },
          "150260617": {
            "id": "150260617",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "如果我能厘清与「七彩之战」有关的争议，证明它的真实性，就能把它收录到出版书籍里，让全提瓦特都了解这段传奇。",
            "nextDialogs": [
              "150260618"
            ]
          },
          "150260618": {
            "id": "150260618",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "故友的光辉事迹借您之口重新流传于世，这也算是一段美谈，您意下如何？",
            "nextDialogs": [
              "150260621"
            ]
          },
          "150260621": {
            "id": "150260621",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "其实你想完成使命的话…好吧，我先帮你调查一下。",
            "nextDialogs": [
              "150260622"
            ]
          },
          "150260622": {
            "id": "150260622",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "非常荣幸…",
            "nextDialogs": [
              "150260623"
            ]
          },
          "150260623": {
            "id": "150260623",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "#少来，我可不打算接受你的雇佣。我决定帮的是{NICKNAME}，你们就顺便沾点光。",
            "nextDialogs": [
              "150260624"
            ]
          },
          "150260624": {
            "id": "150260624",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "茜特菈莉总算答应下来了…",
            "nextDialogs": [
              "150260625"
            ]
          },
          "150260625": {
            "id": "150260625",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（看来我和茜特菈莉的交情还是挺管用的，她终究不是那种很绝情的人。）",
            "nextDialogs": [
              "150260626"
            ]
          },
          "150260626": {
            "id": "150260626",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "我什么时候让你觉得是个绝情的人了？",
            "nextDialogs": [
              "150260627"
            ]
          },
          "150260627": {
            "id": "150260627",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "#无妨无妨，我本来就准备和{NICKNAME}合作。",
            "nextDialogs": [
              "150260628"
            ]
          },
          "150260628": {
            "id": "150260628",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "请问您亲身经历过「七彩之战」吗？您知道战场的遗址在哪里吗？现在还能不能找到一些可以证明那场战争发生过的遗物？",
            "nextDialogs": [
              "150260629"
            ]
          },
          "150260629": {
            "id": "150260629",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "好吵…",
            "nextDialogs": [
              "150260630"
            ]
          },
          "150260630": {
            "id": "150260630",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "这…",
            "nextDialogs": [
              "150260631"
            ]
          },
          "150260631": {
            "id": "150260631",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也想问。",
            "nextDialogs": [
              "150260632"
            ]
          },
          "150260632": {
            "id": "150260632",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "没有，不知道，不知道。",
            "nextDialogs": [
              "150260633"
            ]
          },
          "150260633": {
            "id": "150260633",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "呃…",
            "nextDialogs": [
              "150260634"
            ]
          },
          "150260634": {
            "id": "150260634",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "我确实曾经和她生活在同一个时代，但这不代表我经历过与她有关的所有事件。我只是活得久了一些，又不是历史书。",
            "nextDialogs": [
              "150260635"
            ]
          },
          "150260635": {
            "id": "150260635",
            "speakerId": 1005,
            "speakerName": "茜特菈莉",
            "text": "调查方向你们自己定，如果涉及到我比较了解的地方，我可以给你们答疑解惑。",
            "nextDialogs": [
              "150260636"
            ]
          },
          "150260636": {
            "id": "150260636",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "…这样也好，虽然您不是「七彩之战」的亲历者，但您毕竟曾经生活在那个时代，您的意见肯定非常有用！",
            "nextDialogs": [
              "150260637"
            ]
          },
          "150260637": {
            "id": "150260637",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "艾列尔，你之前想好的调查方向是什么？",
            "nextDialogs": [
              "150260638"
            ]
          },
          "150260638": {
            "id": "150260638",
            "speakerId": 1003,
            "speakerName": "艾列尔",
            "text": "我的计划吗？我之前调查到烟谜主内部有专门负责记录历史的人，或许可以先向他们咨询一下。",
            "nextDialogs": [
              "150260639"
            ]
          },
          "150260639": {
            "id": "150260639",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "那就先按这个方向继续调查！",
            "nextDialogs": [
              "150260640"
            ]
          },
          "150260640": {
            "id": "150260640",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "#{NICKNAME}，我们正式合作吧，毕竟我只有通过你才能得到这位大萨满的帮助呢。",
            "nextDialogs": [
              "150260641"
            ]
          },
          "150260641": {
            "id": "150260641",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题。"
          }
        }
      }
    },
    {
      "subId": "1502650",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150265001"
        ],
        "dialogs": {
          "150265001": {
            "id": "150265001",
            "speakerId": 1003,
            "speakerName": "艾列尔",
            "text": "活了几百年的大萨满…如果真的能请她帮忙，或许还可以研究一下「七彩之战」以外的历史…",
            "nextDialogs": [
              "150265002"
            ]
          },
          "150265002": {
            "id": "150265002",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "艾列尔，作为研究经费的拨款人，我还是希望你能专注于当下的任务，这对我很重要！",
            "nextDialogs": [
              "150265003"
            ]
          },
          "150265003": {
            "id": "150265003",
            "speakerId": 1003,
            "speakerName": "艾列尔",
            "text": "抱歉，如果以后有机会的话…",
            "nextDialogs": [
              "150265004"
            ]
          },
          "150265004": {
            "id": "150265004",
            "speakerId": 1002,
            "speakerName": "蒙吕松",
            "text": "以后的事情以后再说。"
          }
        }
      }
    },
    {
      "subId": "1502699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150269999"
        ],
        "dialogs": {
          "150269999": {
            "id": "150269999",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "茜特菈莉推门而出，你和派蒙急忙跟了出去。"
          }
        }
      }
    }
  ]
}
        ],
        "dialogs": {
          "718021101": {
            "id": "718021101",
            "speakerId": 21517,
            "speakerName": "留云借风真君…？",
            "text": "昔日，我研习机关术略有小成时，曾造了一座「云中仙居」浮于空中。",
            "nextDialogs": [
              "718021102"
            ]
          },
          "718021102": {
            "id": "718021102",
            "speakerId": 21517,
            "speakerName": "留云借风真君…？",
            "text": "「云中仙居」善成后，本仙念在仙缘难得，便将图纸留于其上，有缘者自取之。",
            "nextDialogs": [
              "718021103"
            ]
          },
          "718021103": {
            "id": "718021103",
            "speakerId": 21517,
            "speakerName": "留云借风真君…？",
            "text": "你且去取来图纸，再入仙府详述。"
          }
        }
      }
    },
    {
      "subId": "7180212",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718021201"
        ],
        "dialogs": {
          "718021201": {
            "id": "718021201",
            "speakerId": 21517,
            "speakerName": "留云借风真君…？",
            "text": "能取来图纸，确有仙缘。上前来见吧。"
          }
        }
      }
    },
    {
      "subId": "7180213",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718021301"
        ],
        "dialogs": {
          "718021301": {
            "id": "718021301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…这是什么，一张桌子上面…放了一个匣子。周围什么都没有。",
            "nextDialogs": [
              "718021304"
            ]
          },
          "718021304": {
            "id": "718021304",
            "speakerId": 21517,
            "speakerName": "留云借风真君…？",
            "text": "能到达此地，本仙已知你本心…",
            "nextDialogs": [
              "718021305"
            ]
          },
          "718021305": {
            "id": "718021305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又说话了！",
            "nextDialogs": [
              "718021306"
            ]
          },
          "718021306": {
            "id": "718021306",
            "speakerId": 21517,
            "speakerName": "留云借风真君…？",
            "text": "记述所愿，纳入匣内。本仙自会定夺。",
            "nextDialogs": [
              "718021307"
            ]
          },
          "718021307": {
            "id": "718021307",
            "speakerId": 21517,
            "speakerName": "留云借风真君…？",
            "text": "…履难历险，矢志不移，心志坚韧实为难得。这些宝货可自取走。",
            "nextDialogs": [
              "718021308"
            ]
          },
          "718021308": {
            "id": "718021308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好欸！嘿嘿，我就知道仙君不会让我们白跑嘛。",
            "nextDialogs": [
              "718021309"
            ]
          },
          "718021309": {
            "id": "718021309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，这个声音说「记述所愿，纳入匣内」…是要我们把愿望写下来放进匣子里？"
          }
        }
      }
    }
  ]
}
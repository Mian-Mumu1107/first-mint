    {
      "subId": "7180204",
      "subQuestName": "将图纸交给「留云借风真君」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718020501"
        ],
        "dialogs": {
          "718020501": {
            "id": "718020501",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "看来你们拿到图纸了，行了，快点进来把图纸送过来吧。"
          }
        }
      }
    },

    },
    {
      "subId": "7180204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718020401"
        ],
        "dialogs": {
          "718020401": {
            "id": "718020401",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "你们还没拿到图纸吗？就在「云中仙居」上…",
            "nextDialogs": [
              "718020402"
            ]
          },
          "718020402": {
            "id": "718020402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，她怎么知道我们还没拿到图纸的…",
            "nextDialogs": [
              "718020403"
            ]
          },
          "718020403": {
            "id": "718020403",
            "speakerId": 10258,
            "speakerName": "留云借风真君",
            "text": "那图纸是本仙亲著，在不在近前本仙难道不知道吗？快点去拿图纸吧。"
          }
        }
      }
    },
    {
      "subId": "7180210",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718021001"
        ],
        "dialogs": {
          "718021001": {
            "id": "718021001",
            "speakerId": 21517,
            "speakerName": "留云借风真君…？",
            "text": "绝云访仙，绝非易事。汝等来此叩访…",
            "nextDialogs": [
              "718021002"
            ]
          },
          "718021002": {
            "id": "718021002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！她、她不是已经去璃月港了吗？难道是又悄悄回来了？",
            "nextDialogs": [
              "718021003"
            ]
          },
          "718021003": {
            "id": "718021003",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉…声音不太对？",
            "nextDialogs": [
              "718021004"
            ]
          },
          "718021004": {
            "id": "718021004",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个…仙君，我们就是担心有人去你家偷东西，没有打扰你的意思…",
            "nextDialogs": [
              "718021005"
            ]
          },
          "718021005": {
            "id": "718021005",
            "speakerId": 21517,
            "speakerName": "留云借风真君…？",
            "text": "…本仙有善务一件，如能妥善处之，便可入得仙府。",
            "nextDialogs": [
              "718021008"
            ]
          },
          "718021008": {
            "id": "718021008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你是说，现在和我们说话的不是留云真君，而是她留下的机关？",
            "nextDialogs": [
              "718021009"
            ]
          },
          "718021009": {
            "id": "718021009",
            "speakerId": 21517,
            "speakerName": "留云借风真君…？",
            "text": "昔日，我研习机关术略有小成时，曾造了一座「云中仙居」浮于空中。",
            "nextDialogs": [
              "718021010"
            ]
          },
          "718021010": {
            "id": "718021010",
            "speakerId": 21517,
            "speakerName": "留云借风真君…？",
            "text": "「云中仙居」善成后，本仙念在仙缘难得，便将图纸留于其上，有缘者自取之。",
            "nextDialogs": [
              "718021011"
            ]
          },
          "718021011": {
            "id": "718021011",
            "speakerId": 21517,
            "speakerName": "留云借风真君…？",
            "text": "你且去取来图纸，再入仙府详述。",
            "nextDialogs": [
              "718021012"
            ]
          },
          "718021012": {
            "id": "718021012",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "仙君？",
            "nextDialogs": [
              "718021013"
            ]
          },
          "718021013": {
            "id": "718021013",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "留云真君？闲…闲云小姐？",
            "nextDialogs": [
              "718021014"
            ]
          },
          "718021014": {
            "id": "718021014",
            "speakerId": 21517,
            "speakerName": "留云借风真君…？",
            "text": "你且去取来图纸，了此善务，再入仙府详述。",
            "nextDialogs": [
              "718021015"
            ]
          },
          "718021015": {
            "id": "718021015",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完全不搭理我们嘛，还是自顾自地说个没完…"
          }
        }
      }
    },
    {
      "subId": "7180211",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

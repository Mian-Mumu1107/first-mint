      }
    },
    {
      "subId": "7000004",
      "subQuestName": "给芙萝拉留影",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700000401"
        ],
        "dialogs": {
          "700000401": {
            "id": "700000401",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "欢迎光临「花语」，呼呼，有什么需要了解的吗？",
            "nextDialogs": [
              "700000402"
            ]
          },
          "700000402": {
            "id": "700000402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于萨义德的画片…",
            "nextDialogs": [
              "700000403"
            ]
          },
          "700000403": {
            "id": "700000403",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "确实，风花节是蒙德特有的节日呢，须弥人的话，应该不会过风花节吧。",
            "nextDialogs": [
              "700000404"
            ]
          },
          "700000404": {
            "id": "700000404",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "要给我和我的花留影？没问题呀，萨义德先生的想法可真特别，学者就是这样吧，呼呼。"
          }
        }
      }
    },
    {
      "subId": "7000005",
      "subQuestName": "（test）与芙洛拉对话$HIDDEN",
      "sceneId": null,
      "locations": [],

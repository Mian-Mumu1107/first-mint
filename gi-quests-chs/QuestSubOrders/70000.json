        "dialogs": {
          "700000501": {
            "id": "700000501",
            "speakerId": 1001,
            "speakerName": "芙萝拉",
            "text": "欢迎光临「花语」，每年风花节的时候店里生意都很忙呢，呼呼。"
          }
        }
      }
    },
    {
      "subId": "7000099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700009901"
        ],
        "dialogs": {
          "700009901": {
            "id": "700009901",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这样应该就算留下了记录吧，对了，别忘记给芙萝拉小姐留影呀。",
            "nextDialogs": [
              "700009904"
            ]
          },
          "700009904": {
            "id": "700009904",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔…还有哪里要留影的，啊对了，还有教堂前用花朵装扮的神像。",
            "nextDialogs": [
              "700009905"
            ]
          },
          "700009905": {
            "id": "700009905",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这样就记录好了，我们快回去把画片交给萨义德先生吧。"
          }
        }
      }
    }
  ]
}
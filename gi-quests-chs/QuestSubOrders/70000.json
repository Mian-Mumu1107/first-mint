    {
      "subId": "7000001",
      "subQuestName": "与萨义德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700000101"
        ],
        "dialogs": {
          "700000101": {
            "id": "700000101",
            "speakerId": 1000,
            "speakerName": "萨义德",
            "text": "多么浪漫的风俗，这才是真正值得研究的。",
            "nextDialogs": [
              "700000102"
            ]
          },
          "700000102": {
            "id": "700000102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在做什么？",
            "nextDialogs": [
              "700000103"
            ]
          },
          "700000103": {
            "id": "700000103",
            "speakerId": 1000,
            "speakerName": "萨义德",
            "text": "哦，是旅行者啊，你也是对蒙德浪漫的歌谣产生了兴趣，才来到图书馆的吗？",
            "nextDialogs": [
              "700000104"
            ]
          },
          "700000104": {
            "id": "700000104",
            "speakerId": 1000,
            "speakerName": "萨义德",
            "text": "不过，一切文字记录我们随时都能阅读，发生在身边的历史稍不留神就会错过啊。",
            "nextDialogs": [
              "700000105"
            ]
          },
          "700000105": {
            "id": "700000105",
            "speakerId": 1000,
            "speakerName": "萨义德",
            "text": "在风花节这样浪漫惬意的节日里，蒙德人有许多特别的风俗。",
            "nextDialogs": [
              "700000106"
            ]
          },
          "700000106": {
            "id": "700000106",
            "speakerId": 1000,
            "speakerName": "萨义德",
            "text": "这些风俗的形式是怎样的、它们背后的历史如何？诸如此类，都是绝佳的研究方向。",
            "nextDialogs": [
              "700000107"
            ]
          },
          "700000107": {
            "id": "700000107",
            "speakerId": 1000,
            "speakerName": "萨义德",
            "text": "我正在就此撰写研究报告，只有文字描述当然不行，能请你帮忙给风花节的景观留个影吗？",
            "nextDialogs": [
              "700000109",
              "700000111"
            ]
          },
          "700000109": {
            "id": "700000109",
            "speakerId": 1000,
            "speakerName": "萨义德",
            "text": "感谢你协助我的学术研究，旅行者，我会在报告中署上你的名字。",
            "nextDialogs": [
              "700000113"
            ]
          },
          "700000113": {
            "id": "700000113",
            "speakerId": 1000,
            "speakerName": "萨义德",
            "text": "<color=#00E1FFFF>喷泉广场上空的花饰</color>、<color=#00E1FFFF>教堂前用花朵装扮的神像</color>还有<color=#00E1FFFF>忙着售卖花朵的花店店主</color>，这些都值得记录。",
            "nextDialogs": [
              "700000115"
            ]
          },
          "700000115": {
            "id": "700000115",
            "speakerId": 1000,
            "speakerName": "萨义德",
            "text": "那就麻烦你帮我记录这些景观吧，回头把拍好的画片带给我就好。"
          },
          "700000111": {
            "id": "700000111",
            "speakerId": 1000,
            "speakerName": "萨义德",
            "text": "不不不，现在我不能走开。我刚刚拟好报告的大纲，如果现在走开，思绪就乱了。",
            "nextDialogs": [
              "700000112"
            ]
          },
          "700000112": {
            "id": "700000112",
            "speakerId": 1000,
            "speakerName": "萨义德",
            "text": "还是得拜托你，旅行者，虽然不多，但是我会为你准备报酬的。"
          }
        }
      }
    },
    {
      "subId": "7000002",
      "subQuestName": "给喷泉广场上空的花饰留影",
      "sceneId": null,
      "locations": [],
      "dialogue": {

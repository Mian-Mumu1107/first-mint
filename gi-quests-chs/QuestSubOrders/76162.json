  "subQuests": [
    {
      "subId": "7616201",
      "subQuestName": "前往战场南侧的阵地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761620101"
        ],
        "dialogs": {
          "761620101": {
            "id": "761620101",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "别挡道，滚开！",
            "nextDialogs": [
              "761620102"
            ]
          },
          "761620102": {
            "id": "761620102",
            "speakerId": 22343,
            "speakerName": "来自魔物的声音",
            "text": "嘻嘻…你急什么…",
            "nextDialogs": [
              "761620103"
            ]
          },
          "761620103": {
            "id": "761620103",
            "speakerId": 22343,
            "speakerName": "来自魔物的声音",
            "text": "反正你们…迟早都得死…不过是…有人要提早上路了…",
            "nextDialogs": [
              "761620104"
            ]
          },
          "761620104": {
            "id": "761620104",
            "speakerId": 22343,
            "speakerName": "来自魔物的声音",
            "text": "他不是抱怨…三年前自己没死成么…现在…我就成全他…",
            "nextDialogs": [
              "761620105"
            ]
          },
          "761620105": {
            "id": "761620105",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "…比约恩？你把他怎么了？！",
            "nextDialogs": [
              "761620106"
            ]
          },
          "761620106": {
            "id": "761620106",
            "speakerId": 22343,
            "speakerName": "来自魔物的声音",
            "text": "是他太弱了…弱者…废物…虫豸…",
            "nextDialogs": [
              "761620107"
            ]
          },
          "761620107": {
            "id": "761620107",
            "speakerId": 22343,
            "speakerName": "来自魔物的声音",
            "text": "…会死难道不是理所应当么？",
            "nextDialogs": [
              "761620108"
            ]
          },
          "761620108": {
            "id": "761620108",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "不准你侮辱他！他一点也不弱！",
            "nextDialogs": [
              "761620109"
            ]
          },
          "761620109": {
            "id": "761620109",
            "speakerId": 22343,
            "speakerName": "来自魔物的声音",
            "text": "哦…在你看来…他是强者…",
            "nextDialogs": [
              "761620110"
            ]
          },
          "761620110": {
            "id": "761620110",
            "speakerId": 22343,
            "speakerName": "来自魔物的声音",
            "text": "可是…可是强者就不会死么…",
            "nextDialogs": [
              "761620111"
            ]
          },
          "761620111": {
            "id": "761620111",
            "speakerId": 22343,
            "speakerName": "来自魔物的声音",
            "text": "我还以为…你心里清楚得很哪…",
            "nextDialogs": [
              "761620112"
            ]
          },
          "761620112": {
            "id": "761620112",
            "speakerId": 22343,
            "speakerName": "来自魔物的声音",
            "text": "那些比你强的人…不都死掉了么…不管是三年前…还是十年前…",
            "nextDialogs": [
              "761620113"
            ]
          },
          "761620113": {
            "id": "761620113",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "…闭上你的狗嘴！",
            "nextDialogs": [
              "761620114"
            ]
          },
          "761620114": {
            "id": "761620114",
            "speakerId": 22343,
            "speakerName": "来自魔物的声音",
            "text": "是啊…原来弱小的…就只有你而已啊…",
            "nextDialogs": [
              "761620115"
            ]
          },
          "761620115": {
            "id": "761620115",
            "speakerId": 22343,
            "speakerName": "来自魔物的声音",
            "text": "要不然为什么…每次…每次活下来的都只有你？",
            "nextDialogs": [
              "761620116"
            ]
          },
          "761620116": {
            "id": "761620116",
            "speakerId": 22343,
            "speakerName": "来自魔物的声音",
            "text": "…是你从战场逃跑了吧？苟且偷生的胆小鬼…",
            "nextDialogs": [
              "761620117"
            ]
          },
          "761620117": {
            "id": "761620117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "叶洛亚！别听它胡说八道！",
            "nextDialogs": [
              "761620118"
            ]
          },
          "761620118": {
            "id": "761620118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "少废话，纳命来！",
            "nextDialogs": [
              "761620119"
            ]
          },
          "761620119": {
            "id": "761620119",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "#…{NICKNAME}！我们速战速决！"
          }
        }
      }
    },
    {
      "subId": "7616202",
      "subQuestName": "前往战场南侧的阵地查看",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761620201"
        ],
        "dialogs": {
          "761620201": {
            "id": "761620201",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "…比约恩怎么样了？",
            "nextDialogs": [
              "761620202"
            ]
          },
          "761620202": {
            "id": "761620202",
            "speakerId": 7660,
            "speakerName": "伊捷莉",
            "text": "…伤得很重。攻击来得太突然了，他为了保护我们…呜…",
            "nextDialogs": [
              "761620203"
            ]
          },
          "761620203": {
            "id": "761620203",
            "speakerId": 7660,
            "speakerName": "伊捷莉",
            "text": "…战场环境太危险，他也经不起转移的颠簸了，我们只能就地进行紧急处理，但以我们现有的能力，实在是…",
            "nextDialogs": [
              "761620204"
            ]
          },
          "761620204": {
            "id": "761620204",
            "speakerId": 7182,
            "speakerName": "比约恩",
            "text": "…队长…",
            "nextDialogs": [
              "761620205"
            ]
          },
          "761620205": {
            "id": "761620205",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "比约恩！",
            "nextDialogs": [
              "761620206"
            ]
          },
          "761620206": {
            "id": "761620206",
            "speakerId": 7182,
            "speakerName": "比约恩",
            "text": "…对不起…我没能完成任务…",
            "nextDialogs": [
              "761620207"
            ]
          },
          "761620207": {
            "id": "761620207",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "你完成得很好！阵地守住了，大家也都平安无事…",
            "nextDialogs": [
              "761620208"
            ]
          },
          "761620208": {
            "id": "761620208",
            "speakerId": 7182,
            "speakerName": "比约恩",
            "text": "是吗…原来我做到了…太好了…",
            "nextDialogs": [
              "761620209"
            ]
          },
          "761620209": {
            "id": "761620209",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "别说话了，先专心养伤。",
            "nextDialogs": [
              "761620210"
            ]
          },
          "761620210": {
            "id": "761620210",
            "speakerId": 7182,
            "speakerName": "比约恩",
            "text": "现在不说…以后就没机会了…",
            "nextDialogs": [
              "761620211"
            ]
          },
          "761620211": {
            "id": "761620211",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "…这是队长命令！我不许你再说这种话！你会没事的…一定会没事的…",
            "nextDialogs": [
              "761620212"
            ]
          },
          "761620212": {
            "id": "761620212",
            "speakerId": 7182,
            "speakerName": "比约恩",
            "text": "呵…好…遵命…我不会再说了…",
            "nextDialogs": [
              "761620213"
            ]
          },
          "761620213": {
            "id": "761620213",
            "speakerId": 7182,
            "speakerName": "比约恩",
            "text": "不过…等我见到维德…也算能够交代了…",
            "nextDialogs": [
              "761620214"
            ]
          },
          "761620214": {
            "id": "761620214",
            "speakerId": 7182,
            "speakerName": "比约恩",
            "text": "他以前常说…我们执灯人就像冬凌草…",
            "nextDialogs": [
              "761620215"
            ]
          },
          "761620215": {
            "id": "761620215",
            "speakerId": 7182,
            "speakerName": "比约恩",
            "text": "面对狂猎…我们每个人都很脆弱…就像冬凌草的花一样…会轻易凋落…",
            "nextDialogs": [
              "761620216"
            ]
          },
          "761620216": {
            "id": "761620216",
            "speakerId": 7182,
            "speakerName": "比约恩",
            "text": "但是…只要叶片还在…只要根还牢牢扎在泥土里…",
            "nextDialogs": [
              "761620217"
            ]
          },
          "761620217": {
            "id": "761620217",
            "speakerId": 7182,
            "speakerName": "比约恩",
            "text": "到了下一季…再下一季…总会有新的花朵绽放…",
            "nextDialogs": [
              "761620218"
            ]
          },
          "761620218": {
            "id": "761620218",
            "speakerId": 7182,
            "speakerName": "比约恩",
            "text": "我们是不会失败的…对吧…队长…",
            "nextDialogs": [
              "761620219"
            ]
          },
          "761620219": {
            "id": "761620219",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "…嗯！我们绝不会失败！我一定会亲手、彻底将那魔物葬送！",
            "nextDialogs": [
              "761620220"
            ]
          },
          "761620220": {
            "id": "761620220",
            "speakerId": 7182,
            "speakerName": "比约恩",
            "text": "…你是我们之中最强的…我相信你…队长…",
            "nextDialogs": [
              "761620221"
            ]
          },
          "761620221": {
            "id": "761620221",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "…放心吧，比约恩，我一定遵守约定。你该休息了…等你伤养好了，一切都会好的…",
            "nextDialogs": [
              "761620222"
            ]
          },
          "761620222": {
            "id": "761620222",
            "speakerId": 7182,
            "speakerName": "比约恩",
            "text": "……",
            "nextDialogs": [
              "761620223"
            ]
          },
          "761620223": {
            "id": "761620223",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "……",
            "nextDialogs": [
              "761620224"
            ]
          },
          "761620224": {
            "id": "761620224",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "#…{NICKNAME}，派蒙，我们该走了。任务还没结束，我们不能在这里耽搁了。",
            "nextDialogs": [
              "761620225"
            ]
          },
          "761620225": {
            "id": "761620225",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "叶洛亚…",
            "nextDialogs": [
              "761620228"
            ]
          },
          "761620228": {
            "id": "761620228",
            "speakerId": 1324,
            "speakerName": "叶洛亚",
            "text": "…嗯，继续前进吧！"
          }
        }
      }
    },

    {
      "subId": "7715803",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771580301"
        ],
        "dialogs": {
          "771580301": {
            "id": "771580301",
            "speakerId": 22523,
            "speakerName": "操作指南·其二",
            "text": "…将【铁钥匙】与【银钥匙】其一插入凹槽可降低水面…将【铁钥匙】与【银钥匙】同时插入凹槽则可完全排空积水…",
            "nextDialogs": [
              "771580302"
            ]
          },
          "771580302": {
            "id": "771580302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…这里一直在讲怎么降低水面，那下面肯定藏着什么东西。",
            "nextDialogs": [
              "771580303"
            ]
          },
          "771580303": {
            "id": "771580303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那这里也要<color=#00E1FFFF>【铁钥匙】</color>！还得想想办法把里面的那把拿出来…",
            "nextDialogs": [
              "771580304"
            ]
          },
          "771580304": {
            "id": "771580304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃啊…好麻烦，为什么要在下水道设置这么这么复杂的机关呢…"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7715801",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771580101"
        ],
        "dialogs": {
          "771580101": {
            "id": "771580101",
            "speakerId": 22525,
            "speakerName": "泛黄的记录簿",
            "text": "「…没想到妖精（…）的适应性仍然很高，是因为从前亥珀波瑞亚在制造妖精时就留下了什么接口吗…」",
            "nextDialogs": [
              "771580102"
            ]
          },
          "771580102": {
            "id": "771580102",
            "speakerId": 22525,
            "speakerName": "泛黄的记录簿",
            "text": "「树木构成的身躯能够在破坏中重新生长，也能让受试者获得远超原本躯体的力量，只不过语言功能会退化…」",
            "nextDialogs": [
              "771580103"
            ]
          },
          "771580103": {
            "id": "771580103",
            "speakerId": 22525,
            "speakerName": "泛黄的记录簿",
            "text": "「毕竟，已没有那么多痛苦需要述说。」",
            "nextDialogs": [
              "771580104"
            ]
          },
          "771580104": {
            "id": "771580104",
            "speakerId": 22525,
            "speakerName": "泛黄的记录簿",
            "text": "「在下水道进行的实验已经收集到了足够的数据，接下来就是逐渐让镇子上的人接受这一点…」",
            "nextDialogs": [
              "771580105"
            ]
          },
          "771580105": {
            "id": "771580105",
            "speakerId": 22525,
            "speakerName": "泛黄的记录簿",
            "text": "「不过，当他们看到弗瑞奥萨完成的『治疗』，总有被病痛折磨的可怜人想要尝试一下的吧…」",
            "nextDialogs": [
              "771580106"
            ]
          },
          "771580106": {
            "id": "771580106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "患者的名字是…弗瑞奥萨？！这不就是刚刚桥上的那个…",
            "nextDialogs": [
              "771580107"
            ]
          },
          "771580107": {
            "id": "771580107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么看，这家伙就是罪魁祸首！先在下水道试着改造弗瑞奥萨，再把其他人都变成树妖…不对，变成什么「完全树」！",
            "nextDialogs": [
              "771580108"
            ]
          },
          "771580108": {
            "id": "771580108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等见到他了，一定要狠狠揍他一顿！"
          }
        }
      }
    },
    {
      "subId": "7715802",

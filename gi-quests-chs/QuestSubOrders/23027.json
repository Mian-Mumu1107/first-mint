  },
  "subQuests": [
    {
      "subId": "2302701",
      "subQuestName": "与雅丝敏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230270101"
        ],
        "dialogs": {
          "230270101": {
            "id": "230270101",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "果然还是得好好照看一下啊…",
            "nextDialogs": [
              "230270102"
            ]
          },
          "230270102": {
            "id": "230270102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么？",
            "nextDialogs": [
              "230270103"
            ]
          },
          "230270103": {
            "id": "230270103",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "你是…喔，看样子是位旅行者，对吧？",
            "nextDialogs": [
              "230270104"
            ]
          },
          "230270104": {
            "id": "230270104",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "我是阿弥利多学院的学生，雅丝敏，正在这里研究这棵「圣树」。",
            "nextDialogs": [
              "230270105"
            ]
          },
          "230270105": {
            "id": "230270105",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "这棵「圣树」历经的岁月，比奥摩斯港里所有手抓饭的饭粒数量加起来都多。",
            "nextDialogs": [
              "230270106"
            ]
          },
          "230270106": {
            "id": "230270106",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "同时它又托举着教令院…重要性堪比唐杜尔烤鸡底下垫着的蔬菜。",
            "nextDialogs": [
              "230270110",
              "230270109"
            ]
          },
          "230270110": {
            "id": "230270110",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "但如果它出了问题，那须弥城也会面临巨大的灾难。",
            "nextDialogs": [
              "230270111"
            ]
          },
          "230270111": {
            "id": "230270111",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "比如，它遭到了虫害，比屋顶还大的蝗虫从树的内部冲出…",
            "nextDialogs": [
              "230270112"
            ]
          },
          "230270112": {
            "id": "230270112",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "或者是它的枝干生长失去控制，庞大的根系宛如洪水般从地底涌出，摧毁了所有房屋。",
            "nextDialogs": [
              "230270113"
            ]
          },
          "230270113": {
            "id": "230270113",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "又或者，这棵「圣树」飞速枯萎，倒下的树身压垮了半个须弥城…",
            "nextDialogs": [
              "230270114"
            ]
          },
          "230270114": {
            "id": "230270114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应，应该不会这样吧？！",
            "nextDialogs": [
              "230270115"
            ]
          },
          "230270115": {
            "id": "230270115",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "喔，那当然，到目前为止，它的情况一切正常。",
            "nextDialogs": [
              "230270116"
            ]
          },
          "230270116": {
            "id": "230270116",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "但话也说回来，在你去树林摘蘑菇的时候，袭击你的蕈兽也不会提前告知你它们的到来。",
            "nextDialogs": [
              "230270117"
            ]
          },
          "230270117": {
            "id": "230270117",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "我之所以在此研究，也是在观察这棵大树的情况，为各种可能发生的意外做准备。",
            "nextDialogs": [
              "230270118"
            ]
          },
          "230270118": {
            "id": "230270118",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "不过如你所见，就算我的思维如同暝彩鸟一般敏捷，但我的体力也如同星蕈一般孱弱…",
            "nextDialogs": [
              "230270119"
            ]
          },
          "230270119": {
            "id": "230270119",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "所以旅行者，你能帮我去记录几处「圣树」根系的状况吗？",
            "nextDialogs": [
              "230270120"
            ]
          },
          "230270120": {
            "id": "230270120",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "平时我都会雇佣冒险家和我同行，但现在他们似乎都没空…"
          },
          "230270109": {
            "id": "230270109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是一棵很伟大的树啊…"
          }
        }
      }
    },
    {
      "subId": "2302702",
      "subQuestName": "前往圣树根系所在的位置",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230270201"
        ],
        "dialogs": {
          "230270201": {
            "id": "230270201",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "旅行者，真巧，又见到你了。",
            "nextDialogs": [
              "230270202"
            ]
          },
          "230270202": {
            "id": "230270202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还在研究吗？",
            "nextDialogs": [
              "230270203"
            ]
          },
          "230270203": {
            "id": "230270203",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "嗯，拉德普和法尔希说还需要搜集更多数据，我就只能继续我的工作啦。",
            "nextDialogs": [
              "230270204"
            ]
          },
          "230270204": {
            "id": "230270204",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "不过，也不知道那些根系现在是什么情况…",
            "nextDialogs": [
              "230270205"
            ]
          },
          "230270205": {
            "id": "230270205",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "旅行者，如果你有空的话，就请再帮我去记录一下那些根系的情况吧。"
          }
        }
      }
    },
    {
      "subId": "2302703",
      "subQuestName": "打倒所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

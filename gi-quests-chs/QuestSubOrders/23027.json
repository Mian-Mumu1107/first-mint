    {
      "subId": "2302711",
      "subQuestName": "向雅丝敏回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230271101"
        ],
        "dialogs": {
          "230271101": {
            "id": "230271101",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "你们回来了，圣树根系的情况怎么样？",
            "nextDialogs": [
              "230271102"
            ]
          },
          "230271102": {
            "id": "230271102",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向雅丝敏叙述了根系的情况…",
            "nextDialogs": [
              "230271103"
            ]
          },
          "230271103": {
            "id": "230271103",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "…喔，既然有生物聚集在那里，那就说明那块土地还有着很强的活力。",
            "nextDialogs": [
              "230271104"
            ]
          },
          "230271104": {
            "id": "230271104",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "圣树的根系一定也能安稳地生长，暂时不会出太大的问题。",
            "nextDialogs": [
              "230271105"
            ]
          },
          "230271105": {
            "id": "230271105",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "唯一要担心的问题…就是周围的水体会不会过营养化，从而滋生更多的蕈兽…",
            "nextDialogs": [
              "230271106"
            ]
          },
          "230271106": {
            "id": "230271106",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "喔，这是你们的报酬，谢谢你们帮忙。",
            "nextDialogs": [
              "230271107"
            ]
          },
          "230271107": {
            "id": "230271107",
            "speakerId": 4178,
            "speakerName": "雅丝敏",
            "text": "还是要让拉德普和法尔希监控一下周围的元素浓度才行…"
          }
        }
      }
    }

  },
  "subQuests": [
    {
      "subId": "801901",
      "subQuestName": "前往须弥冒险家协会，与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80190101"
        ],
        "dialogs": {
          "80190101": {
            "id": "80190101",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "哦？你们来了，我这里有份非你们不可的委托，正准备交给你们呢。",
            "nextDialogs": [
              "80190102"
            ]
          },
          "80190102": {
            "id": "80190102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还有非我们不可的委托？唔…那怎么说也得是「魔神级」的委托了吧？",
            "nextDialogs": [
              "80190105"
            ]
          },
          "80190105": {
            "id": "80190105",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "呵呵…冒险家协会的委托并没有这种分类，这次的委托也并不是你们想象的那种规模。",
            "nextDialogs": [
              "80190106"
            ]
          },
          "80190106": {
            "id": "80190106",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "其实，只不过是一个「寻人」委托。",
            "nextDialogs": [
              "80190107"
            ]
          },
          "80190107": {
            "id": "80190107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？那为什么说…是非我们不可呢？",
            "nextDialogs": [
              "80190108"
            ]
          },
          "80190108": {
            "id": "80190108",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "前一阵子，我在清点所有积存委托的清单，偶然间注意到了它。",
            "nextDialogs": [
              "80190109"
            ]
          },
          "80190109": {
            "id": "80190109",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "看似普普通通，却有着连续十几次委托失败的记录，其中还不乏一些很有名望的冒险家。",
            "nextDialogs": [
              "80190110"
            ]
          },
          "80190110": {
            "id": "80190110",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "于是从冒险家协会信誉与须弥分会业绩的角度，我希望可以委托给近些年委托完成率最高的冒险家…",
            "nextDialogs": [
              "80190111"
            ]
          },
          "80190111": {
            "id": "80190111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…那当然就是我们啦！"
          }
        }
      }
    },
    {
      "subId": "801902",
      "subQuestName": "前往维摩庄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80190201"
        ],
        "dialogs": {
          "80190201": {
            "id": "80190201",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "只要他别出事就行，拜托你们再尽力找找了。"
          }
        }
      }
    },
    {
      "subId": "801903",
      "subQuestName": "与巴兰对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80190301"
        ],
        "dialogs": {
          "80190301": {
            "id": "80190301",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "哟，你好，是想买点什么东西吗，我在这一带做生意…",
            "nextDialogs": [
              "80190302"
            ]
          },
          "80190302": {
            "id": "80190302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不是不是，我们是专程过来的冒险家，刚刚在凯瑟琳那里接到了维摩庄的委托…",
            "nextDialogs": [
              "80190303"
            ]
          },
          "80190303": {
            "id": "80190303",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "那件事啊，唉…也算是劳烦你们这些冒险家一趟一趟往这里跑了。",
            "nextDialogs": [
              "80190304"
            ]
          },
          "80190304": {
            "id": "80190304",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "老实说，我们大家都不怎么抱希望了，每次都是有人信誓旦旦来帮忙找人，结果很快就铩羽而归。",
            "nextDialogs": [
              "80190305"
            ]
          },
          "80190305": {
            "id": "80190305",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "各种线索我们都被问烦了，维摩庄周边也快被掘地三尺了，就是没有任何新的进展…",
            "nextDialogs": [
              "80190306"
            ]
          },
          "80190306": {
            "id": "80190306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那他到底叫什么？原本住在哪里？他的亲人们呢？",
            "nextDialogs": [
              "80190307"
            ]
          },
          "80190307": {
            "id": "80190307",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "不知道，不知道，不知道。",
            "nextDialogs": [
              "80190308"
            ]
          },
          "80190308": {
            "id": "80190308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…就这么不耐烦吗？",
            "nextDialogs": [
              "80190309"
            ]
          },
          "80190309": {
            "id": "80190309",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "啊…不好意思，我那不是不耐烦，而是依次回答了你的三个问题。",
            "nextDialogs": [
              "80190312"
            ]
          },
          "80190312": {
            "id": "80190312",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "话虽这么说，但其实我们都对他印象很深的，都是在维摩庄过日子的人嘛，记忆里也一起做过很多事。",
            "nextDialogs": [
              "80190313"
            ]
          },
          "80190313": {
            "id": "80190313",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "只是并不了解他的这些具体情况罢了，也可能以前知道，但现在没人记得了…",
            "nextDialogs": [
              "80190314"
            ]
          },
          "80190314": {
            "id": "80190314",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "反正村里大家交换过情报，结论就是如此。",
            "nextDialogs": [
              "80190315"
            ]
          },
          "80190315": {
            "id": "80190315",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好吧，就当是这样吧…那么他是一个怎样的人呢？",
            "nextDialogs": [
              "80190316"
            ]
          },
          "80190316": {
            "id": "80190316",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "他呀，印象里是个二十岁出头的小伙子，非常热心肠，人又和善…",
            "nextDialogs": [
              "80190317"
            ]
          },
          "80190317": {
            "id": "80190317",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "我这边没什么客人的时候，偶尔就和他聊聊天。有时候又看见他冒冒失失地给人家帮忙，哈哈…挺有意思的小伙子。",
            "nextDialogs": [
              "80190318"
            ]
          },
          "80190318": {
            "id": "80190318",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看起来你对他的评价还不错嘛，一聊起他，表情都不像之前那么愁眉苦脸了。",
            "nextDialogs": [
              "80190319"
            ]
          },
          "80190319": {
            "id": "80190319",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "可不是嘛，大家应该都挺喜欢他的，不然也不会一起到冒险家协会发委托找他。",
            "nextDialogs": [
              "80190320"
            ]
          },
          "80190320": {
            "id": "80190320",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "像他这样单纯的年轻人不多见了，怎么就忽然消失了呢，但愿不是出了什么不好的事…",
            "nextDialogs": [
              "80190321"
            ]
          },
          "80190321": {
            "id": "80190321",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "或许…只是偷偷搬走了之类的？",
            "nextDialogs": [
              "80190322"
            ]
          },
          "80190322": {
            "id": "80190322",
            "speakerId": 1002,
            "speakerName": "巴兰",
            "text": "不会的，以他的性格不可能会不辞而别。就算如此，他搬家的事也不可能躲过我们维摩庄所有人的视线…",
            "nextDialogs": [
              "80190323"
            ]
          },
          "80190323": {
            "id": "80190323",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…好吧，谢谢你的情报，我们再到别处问问。"
          }
        }
      }
    },
    {
      "subId": "801904",
      "subQuestName": "与阿玛兹亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80190401"
        ],
        "dialogs": {
          "80190401": {
            "id": "80190401",
            "speakerId": 1003,
            "speakerName": "阿玛兹亚",
            "text": "是客人吗？",
            "nextDialogs": [
              "80190402"
            ]
          },
          "80190402": {
            "id": "80190402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你好，阿玛兹亚爷爷，我们是接到维摩庄的委托才过来的。",
            "nextDialogs": [
              "80190403"
            ]
          },
          "80190403": {
            "id": "80190403",
            "speakerId": 1003,
            "speakerName": "阿玛兹亚",
            "text": "哦，那可真是辛苦你们了，这么大老远过来，那孩子的事儿就拜托你们了。",
            "nextDialogs": [
              "80190404"
            ]
          },
          "80190404": {
            "id": "80190404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "能多给我们讲一些失踪者的事情吗？",
            "nextDialogs": [
              "80190405"
            ]
          },
          "80190405": {
            "id": "80190405",
            "speakerId": 1003,
            "speakerName": "阿玛兹亚",
            "text": "当然可以，只要能对你们有帮助。",
            "nextDialogs": [
              "80190406"
            ]
          },
          "80190406": {
            "id": "80190406",
            "speakerId": 1003,
            "speakerName": "阿玛兹亚",
            "text": "我虽然眼睛不太好，但过去总是能听到他的声音，现在听不到了就感觉心里空落落的。",
            "nextDialogs": [
              "80190407"
            ]
          },
          "80190407": {
            "id": "80190407",
            "speakerId": 1003,
            "speakerName": "阿玛兹亚",
            "text": "他的父母好像都不在维摩庄，但那孩子看起来一点也不孤单，还总是愿意做那个陪伴他人的人。",
            "nextDialogs": [
              "80190408"
            ]
          },
          "80190408": {
            "id": "80190408",
            "speakerId": 1003,
            "speakerName": "阿玛兹亚",
            "text": "他经常去孤寡老人家里做客，也喜欢带着村里的孤儿一起玩。",
            "nextDialogs": [
              "80190409"
            ]
          },
          "80190409": {
            "id": "80190409",
            "speakerId": 1003,
            "speakerName": "阿玛兹亚",
            "text": "不管谁遇到了伤心的事，他都乐意听人家倾诉，又总是很会安慰人。",
            "nextDialogs": [
              "80190410"
            ]
          },
          "80190410": {
            "id": "80190410",
            "speakerId": 1003,
            "speakerName": "阿玛兹亚",
            "text": "身为村长，我真的要好好感谢他。从精神上帮助那些身处困难的人，本应是我职责的一部分。",
            "nextDialogs": [
              "80190411"
            ]
          },
          "80190411": {
            "id": "80190411",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难怪他失踪了以后，你们那么着急，原来是这样一个温柔的好人呀。",
            "nextDialogs": [
              "80190412"
            ]
          },
          "80190412": {
            "id": "80190412",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可是…关于他的名字、住所、家庭情况之类的，村长你也完全没有线索是吗？",
            "nextDialogs": [
              "80190413"
            ]
          },
          "80190413": {
            "id": "80190413",
            "speakerId": 1003,
            "speakerName": "阿玛兹亚",
            "text": "唉…这也是让我十分惭愧的事，无论如何我都应该记得的，或许是我真的年纪大了…这些我怎么也想不起来了。",
            "nextDialogs": [
              "80190414"
            ]
          },
          "80190414": {
            "id": "80190414",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊…没关系的，不用强求，我们会想想办法…",
            "nextDialogs": [
              "80190415"
            ]
          },
          "80190415": {
            "id": "80190415",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你现在怎么看？",
            "nextDialogs": [
              "80190418"
            ]
          },
          "80190418": {
            "id": "80190418",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是呀，我也这么觉得…再怎么说，他的名字都没人记得了也太奇怪了…",
            "nextDialogs": [
              "80190419"
            ]
          },
          "80190419": {
            "id": "80190419",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "住所和家人也都没有相关线索，这个人简直就像从现实里被抹去了一样。"
          }
        }
      }
    },
    {
      "subId": "801905",
      "subQuestName": "前往阿托莎所指引的地方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80190501"
        ],
        "dialogs": {
          "80190501": {
            "id": "80190501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就是这里吗？这棵树下？",
            "nextDialogs": [
              "80190502"
            ]
          },
          "80190502": {
            "id": "80190502",
            "speakerId": 1004,
            "speakerName": "阿托莎",
            "text": "嗯，看似平平无奇，但对我来说又充满回忆的地方…",
            "nextDialogs": [
              "80190503"
            ]
          },
          "80190503": {
            "id": "80190503",
            "speakerId": 1004,
            "speakerName": "阿托莎",
            "text": "我们曾经会坐在这棵树下聊天，看着天空中的云朵，感受风的方向，一坐就是很久很久。",
            "nextDialogs": [
              "80190504"
            ]
          },
          "80190504": {
            "id": "80190504",
            "speakerId": 1004,
            "speakerName": "阿托莎",
            "text": "我是在森林里被巡林员发现，后来被维摩庄收养的孩子。",
            "nextDialogs": [
              "80190505"
            ]
          },
          "80190505": {
            "id": "80190505",
            "speakerId": 1004,
            "speakerName": "阿托莎",
            "text": "尽管大家对我很好，每天也过得很热闹，但曾经的我还是会感觉到孤独…",
            "nextDialogs": [
              "80190506"
            ]
          },
          "80190506": {
            "id": "80190506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "孤独？",
            "nextDialogs": [
              "80190507"
            ]
          },
          "80190507": {
            "id": "80190507",
            "speakerId": 1004,
            "speakerName": "阿托莎",
            "text": "唔…怎么说呢，有些心事不管是开心也好，伤心也罢，总是不知道该向谁倾诉，或者说不知道该不该倾诉…",
            "nextDialogs": [
              "80190508"
            ]
          },
          "80190508": {
            "id": "80190508",
            "speakerId": 1004,
            "speakerName": "阿托莎",
            "text": "大家都有自己的生活，有些时候敞开心扉或许只会给别人带来麻烦。",
            "nextDialogs": [
              "80190511"
            ]
          },
          "80190511": {
            "id": "80190511",
            "speakerId": 1004,
            "speakerName": "阿托莎",
            "text": "欸，你也是这样的吗？"
          }
        }
      }
    },
    {
      "subId": "801906",
      "subQuestName": "击退深渊教团的魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80190601"
        ],
        "dialogs": {
          "80190601": {
            "id": "80190601",
            "speakerId": 1003,
            "speakerName": "阿玛兹亚",
            "text": "你们找的时候，我也会再努力回想一下的…能想到什么的话就联系你们。"
          }
        }
      }
    },
    {
      "subId": "801907",
      "subQuestName": "与阿托莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80190701"
        ],
        "dialogs": {
          "80190701": {
            "id": "80190701",
            "speakerId": 1004,
            "speakerName": "阿托莎",
            "text": "谢谢你们，没想到这里也会有魔物出现，要不是你们在可就麻烦了…",
            "nextDialogs": [
              "80190702"
            ]
          },
          "80190702": {
            "id": "80190702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "举手之劳罢了！",
            "nextDialogs": [
              "80190705"
            ]
          },
          "80190705": {
            "id": "80190705",
            "speakerId": 1004,
            "speakerName": "阿托莎",
            "text": "这么说起来，最近维摩庄附近的丘丘人们确实比之前要活跃很多…",
            "nextDialogs": [
              "80190706"
            ]
          },
          "80190706": {
            "id": "80190706",
            "speakerId": 1004,
            "speakerName": "阿托莎",
            "text": "它们经常表现得躁动不安，有时还会进行无差别的攻击，村长已经不让孩子们在维摩庄周边玩了。",
            "nextDialogs": [
              "80190707"
            ]
          },
          "80190707": {
            "id": "80190707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…难道真的和深渊教团有关？",
            "nextDialogs": [
              "80190708"
            ]
          },
          "80190708": {
            "id": "80190708",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "以防万一，我们还是回维摩庄看看情况吧，但愿村民们不会遇上什么危险。"
          }
        }
      }

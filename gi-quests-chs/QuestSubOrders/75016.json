    {
      "subId": "7501603",
      "subQuestName": "(test)在竞技场遇到大木$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750160301"
        ],
        "dialogs": {
          "750160301": {
            "id": "750160301",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "打扰一下，两位…应该是从异邦而来的旅人吧。",
            "nextDialogs": [
              "750160302"
            ]
          },
          "750160302": {
            "id": "750160302",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "哈…抱歉，你们身边的这只小嵴锋龙，难道是你们的伙伴吗？",
            "nextDialogs": [
              "750160303"
            ]
          },
          "750160303": {
            "id": "750160303",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "尾巴上还绑着条漂亮的丝巾，真是个精神的小家伙。",
            "nextDialogs": [
              "750160304"
            ]
          },
          "750160304": {
            "id": "750160304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#是啊，我们刚进纳塔就遇见了，它是{REALNAME[ID(2)|SHOWHOST(true)]}，最近都和我们一起旅行呢。",
            "nextDialogs": [
              "750160305"
            ]
          },
          "750160305": {
            "id": "750160305",
            "speakerId": 21697,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750160306"
            ]
          },
          "750160306": {
            "id": "750160306",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "在一起旅行吗。不过，恕我僭越，这可是相当危险的行为啊…",
            "nextDialogs": [
              "750160310",
              "750160309"
            ]
          },
          "750160310": {
            "id": "750160310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在纳塔，人和龙一起生活不是很正常的嘛…",
            "nextDialogs": [
              "750160311"
            ]
          },
          "750160311": {
            "id": "750160311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#难道是旅行这件事很危险，{REALNAME[ID(2)|SHOWHOST(true)]}不能进行长途跋涉吗？",
            "nextDialogs": [
              "750160312"
            ]
          },
          "750160312": {
            "id": "750160312",
            "speakerId": 21697,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯？",
            "nextDialogs": [
              "750160313"
            ]
          },
          "750160313": {
            "id": "750160313",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "#这倒不是…多走走对任何龙和人都有好处，恕我直言，只是你们的小嵴锋龙，{REALNAME[ID(2)|SHOWHOST(true)]}不太一样。",
            "nextDialogs": [
              "750160314"
            ]
          },
          "750160314": {
            "id": "750160314",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "抱歉，自顾自地说了那么多还没做自我介绍。我的名字是曼科，是龙遗物研究协会的研究员，负责考察一些部族风俗…",
            "nextDialogs": [
              "750160315"
            ]
          },
          "750160315": {
            "id": "750160315",
            "speakerId": 21553,
            "speakerName": "曼科",
            "text": "说白了，也就是探究部族过去习俗的研究者。",
            "nextDialogs": [
              "750160316"
            ]
          },
          "750160316": {
            "id": "750160316",
            "speakerId": 21553,
            "speakerName": "曼科",
            "text": "小嵴锋龙的名字我倒是已经知道了，两位是？",
            "nextDialogs": [
              "750160317"
            ]
          },
          "750160317": {
            "id": "750160317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我是派蒙！{M#他}{F#她}的名字是{NICKNAME}！",
            "nextDialogs": [
              "750160318"
            ]
          },
          "750160318": {
            "id": "750160318",
            "speakerId": 21697,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750160319"
            ]
          },
          "750160319": {
            "id": "750160319",
            "speakerId": 21553,
            "speakerName": "曼科",
            "text": "#真是有活力，看来派蒙和{NICKNAME}把你照顾得很好呢…",
            "nextDialogs": [
              "750160320"
            ]
          },
          "750160320": {
            "id": "750160320",
            "speakerId": 21697,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯…嗯？",
            "nextDialogs": [
              "750160321"
            ]
          },
          "750160321": {
            "id": "750160321",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#那是当然啦！我们一起吃了好多好吃的呢，对吧，{REALNAME[ID(2)|SHOWHOST(true)]}。",
            "nextDialogs": [
              "750160322"
            ]
          },
          "750160322": {
            "id": "750160322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#啊，{REALNAME[ID(2)|SHOWHOST(true)]}，不许乱跑啦！",
            "nextDialogs": [
              "750160323"
            ]
          },
          "750160323": {
            "id": "750160323",
            "speakerId": 21553,
            "speakerName": "曼科",
            "text": "真是可惜啊，明明是这么有活力的小嵴锋龙…"
          },
          "750160309": {
            "id": "750160309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}才不会吃你呢！"
          }
        }
      }
    },

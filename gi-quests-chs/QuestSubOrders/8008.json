        "dialogs": {
          "80080101": {
            "id": "80080101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "矿工大哥，我们是来汇报委托结果的！",
            "nextDialogs": [
              "80080102"
            ]
          },
          "80080102": {
            "id": "80080102",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "哦！总算又见到你们了！之前我还有些担心，虽然付了钱，可仔细想想，委托别人调查那么诡异的地方，别出什么事才好…",
            "nextDialogs": [
              "80080103"
            ]
          },
          "80080103": {
            "id": "80080103",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "万一有什么，我会一辈子良心不安的啊！",
            "nextDialogs": [
              "80080104"
            ]
          },
          "80080104": {
            "id": "80080104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没事没事，我们是谁呀！你看，我们不是好好的回来了吗？情况也都调查清楚了。",
            "nextDialogs": [
              "80080105"
            ]
          },
          "80080105": {
            "id": "80080105",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "厉害厉害！所以，下面是什么情况？",
            "nextDialogs": [
              "80080106"
            ]
          },
          "80080106": {
            "id": "80080106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…欸…嗯…",
            "nextDialogs": [
              "80080108",
              "80080110"
            ]
          },
          "80080108": {
            "id": "80080108",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "养老？",
            "nextDialogs": [
              "80080111"
            ]
          },
          "80080111": {
            "id": "80080111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总、总之，到下面去的那些丘丘人都没有什么攻击性了，也希望矿工们不要故意打搅它们。"
          },
          "80080110": {
            "id": "80080110",
            "speakerId": 12423,
            "speakerName": "玥辉",
            "text": "理想乡？"
          }
        }
      }
    }
  ]

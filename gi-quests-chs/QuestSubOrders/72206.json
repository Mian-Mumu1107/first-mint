  "subQuests": [
    {
      "subId": "7220601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722060101"
        ],
        "dialogs": {
          "722060101": {
            "id": "722060101",
            "speakerId": 1000,
            "speakerName": "阿部",
            "text": "喂！我还在这呢！！",
            "nextDialogs": [
              "722060102"
            ]
          },
          "722060102": {
            "id": "722060102",
            "speakerId": 1000,
            "speakerName": "阿部",
            "text": "现在的年轻人都是怎么回事，一点公德心都没有吗！！",
            "nextDialogs": [
              "722060104",
              "722060106"
            ]
          },
          "722060104": {
            "id": "722060104",
            "speakerId": 1000,
            "speakerName": "阿部",
            "text": "哼…这还差不多，认错就好，那点蘑菇就当我送你的了…不要乱碰我的蘑菇啦！"
          },
          "722060106": {
            "id": "722060106",
            "speakerId": 1000,
            "speakerName": "阿部",
            "text": "关你什么事！别再乱采摘了，乖乖离开就好！"
          }
        }
      }
    },
    {
      "subId": "7220603",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722060201"
        ],
        "dialogs": {
          "722060201": {
            "id": "722060201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇啊！刚刚那个家伙…你看到了吗？！",
            "nextDialogs": [
              "722060204"
            ]
          },
          "722060204": {
            "id": "722060204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…真邪门。我们再摘几棵蘑菇就快点离开吧！"
          }
        }
      }
    },
    {
      "subId": "7220604",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722060401"
        ],
        "dialogs": {
          "722060401": {
            "id": "722060401",
            "speakerId": 1000,
            "speakerName": "阿部",
            "text": "怎么？准备让我开开眼界了吗？",
            "nextDialogs": [
              "722060402"
            ]
          },
          "722060402": {
            "id": "722060402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这些是你要的蘑菇吗？"
          }
        }
      }
    },
    {
      "subId": "7220605",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722060301"
        ],
        "dialogs": {
          "722060301": {
            "id": "722060301",
            "speakerId": 1000,
            "speakerName": "阿部",
            "text": "喂！我没有警告过你们吗！你们是耳朵不好还是没长眼睛呀？！",
            "nextDialogs": [
              "722060302"
            ]
          },
          "722060302": {
            "id": "722060302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哇，是幽灵。",
            "nextDialogs": [
              "722060303"
            ]
          },
          "722060303": {
            "id": "722060303",
            "speakerId": 1000,
            "speakerName": "阿部",
            "text": "哇啊！什么幽灵？！哪里有幽灵！！",
            "nextDialogs": [
              "722060306"
            ]
          },
          "722060306": {
            "id": "722060306",
            "speakerId": 1000,
            "speakerName": "阿部",
            "text": "呀啊！去，去！恶灵速去！！以我阿部的氏名，命你快快离去！！",
            "nextDialogs": [
              "722060307"
            ]
          },
          "722060307": {
            "id": "722060307",
            "speakerId": 1000,
            "speakerName": "阿部",
            "text": "唉呀，邪门，邪门！我活了这么些年，还没见过如此凶恶的灵！！为何还不速去！！",
            "nextDialogs": [
              "722060308"
            ]
          },
          "722060308": {
            "id": "722060308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我是从岛外来的。",
            "nextDialogs": [
              "722060309"
            ]
          },
          "722060309": {
            "id": "722060309",
            "speakerId": 1000,
            "speakerName": "阿部",
            "text": "雾海外的恶灵吗…哼，我可不怕你！你在这里站着别动，等着让雷鸟大人把你驱走吧！"
          }
        }
      }
    },
    {
      "subId": "7220607",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722060501"
        ],
        "dialogs": {
          "722060501": {
            "id": "722060501",
            "speakerId": 1000,
            "speakerName": "阿部",
            "text": "哦哦！哈哈…真是奇形怪状！它们也有自己的「灵」吗？它们也凝结着人的记忆吗…？",
            "nextDialogs": [
              "722060502"
            ]
          },
          "722060502": {
            "id": "722060502",
            "speakerId": 1000,
            "speakerName": "阿部",
            "text": "还有这个…软软呼呼的，小翅膀一样，它是会飞吗…？",
            "nextDialogs": [
              "722060503"
            ]
          },
          "722060503": {
            "id": "722060503",
            "speakerId": 1000,
            "speakerName": "阿部",
            "text": "唉呀…没完没了的好奇，船夫都要生气了…真是不好意思，最终还是该走了，该上船咯…"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "4010603",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401060301"
        ],
        "dialogs": {
          "401060301": {
            "id": "401060301",
            "speakerId": 1000,
            "speakerName": "多莉",
            "text": "怎么样，在桑歌玛哈巴依老爷的协助下，你们应该也察觉到什么了吧？",
            "nextDialogs": [
              "401060302"
            ]
          },
          "401060302": {
            "id": "401060302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你是说…",
            "nextDialogs": [
              "401060303"
            ]
          },
          "401060303": {
            "id": "401060303",
            "speakerId": 1000,
            "speakerName": "多莉",
            "text": "萨齐因可不是什么好人。还有那所谓的「才识之冠」，绝对有问题！",
            "nextDialogs": [
              "401060306"
            ]
          },
          "401060306": {
            "id": "401060306",
            "speakerId": 1000,
            "speakerName": "多莉",
            "text": "哎呀呀，既然这样，你们是不是也该做些什么呢？",
            "nextDialogs": [
              "401060307"
            ]
          },
          "401060307": {
            "id": "401060307",
            "speakerId": 1000,
            "speakerName": "多莉",
            "text": "比如把这个消息告诉教令院，让他们早点放弃才识之冠——",
            "nextDialogs": [
              "401060308"
            ]
          },
          "401060308": {
            "id": "401060308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们已经把这件事告诉教令院了。但是…",
            "nextDialogs": [
              "401060309"
            ]
          },
          "401060309": {
            "id": "401060309",
            "speakerId": 1000,
            "speakerName": "多莉",
            "text": "但是什么？",
            "nextDialogs": [
              "401060310"
            ]
          },
          "401060310": {
            "id": "401060310",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但是那个冠冕，已经被卡维摔碎了。",
            "nextDialogs": [
              "401060311"
            ]
          },
          "401060311": {
            "id": "401060311",
            "speakerId": 1000,
            "speakerName": "多莉",
            "text": "什么——？？？？",
            "nextDialogs": [
              "401060312"
            ]
          },
          "401060312": {
            "id": "401060312",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "冷静呀，多莉，你那么激动干什么？",
            "nextDialogs": [
              "401060313"
            ]
          },
          "401060313": {
            "id": "401060313",
            "speakerId": 1000,
            "speakerName": "多莉",
            "text": "……",
            "nextDialogs": [
              "401060314"
            ]
          },
          "401060314": {
            "id": "401060314",
            "speakerId": 1000,
            "speakerName": "多莉",
            "text": "冠冕…我的冠冕…",
            "nextDialogs": [
              "401060315"
            ]
          },
          "401060315": {
            "id": "401060315",
            "speakerId": 1000,
            "speakerName": "多莉",
            "text": "本来那是多么完美的一个计划！给你们提供情报，引导你们发现冠冕有问题，接下来只要等教令院出售冠冕时低价收购过来…",
            "nextDialogs": [
              "401060316"
            ]
          },
          "401060316": {
            "id": "401060316",
            "speakerId": 1000,
            "speakerName": "多莉",
            "text": "这下全完了…可恶，卡维！！我要上调他欠款的利息！！",
            "nextDialogs": [
              "401060317"
            ]
          },
          "401060317": {
            "id": "401060317",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来你是为了这个理由才告诉我们情报的。我说你怎么这么好心…",
            "nextDialogs": [
              "401060318"
            ]
          },
          "401060318": {
            "id": "401060318",
            "speakerId": 1000,
            "speakerName": "多莉",
            "text": "我的冠冕！！可恶，我真的生气了！！这个月的欠款他别想以任何理由延期！！"
          }
        }
      }
    },
    {

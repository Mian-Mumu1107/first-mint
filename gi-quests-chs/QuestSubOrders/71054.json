  "subQuests": [
    {
      "subId": "7105401",
      "subQuestName": "test隐藏-预先接取的任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710540101"
        ],
        "dialogs": {
          "710540101": {
            "id": "710540101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "停手，停手！请听我们解释！！",
            "nextDialogs": [
              "710540102"
            ]
          },
          "710540102": {
            "id": "710540102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们不是盗宝团吗？乖乖去自首就好啦，有什么好解释的！",
            "nextDialogs": [
              "710540103"
            ]
          },
          "710540103": {
            "id": "710540103",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "#千岩军，层岩巨渊辖区，中队长彦博。很高兴见到你们，{NICKNAME}。",
            "nextDialogs": [
              "710540104"
            ]
          },
          "710540104": {
            "id": "710540104",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "呃…和…很有名的小飞侠。",
            "nextDialogs": [
              "710540105"
            ]
          },
          "710540105": {
            "id": "710540105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，怎么到我这里就忘了名字啦！我是派蒙！",
            "nextDialogs": [
              "710540106"
            ]
          },
          "710540106": {
            "id": "710540106",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "哈哈…失礼、失礼。实在不好意思…但我们大概产生了一点小误会。",
            "nextDialogs": [
              "710540108",
              "710540110"
            ]
          },
          "710540108": {
            "id": "710540108",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "当然不是，恰恰相反。",
            "nextDialogs": [
              "710540112"
            ]
          },
          "710540112": {
            "id": "710540112",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "咳咳，这么说吧。这处作坊以前确实是盗宝团占据的据点没错。",
            "nextDialogs": [
              "710540113"
            ]
          },
          "710540113": {
            "id": "710540113",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "工人撤走以后，那些见缝就钻的家伙就进来了…一开始还只是盗采矿石和琉璃晶砂搞走私，和我们的巡逻队玩捉迷藏。",
            "nextDialogs": [
              "710540114"
            ]
          },
          "710540114": {
            "id": "710540114",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "后来他们贼胆越来越大，居然敢占据矿工留下的旧仓库，自己打造廉价的破烂首饰拿出去卖了！唉，真是…让人看了心疼呀。",
            "nextDialogs": [
              "710540115"
            ]
          },
          "710540115": {
            "id": "710540115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "让人看了心疼？",
            "nextDialogs": [
              "710540116"
            ]
          },
          "710540116": {
            "id": "710540116",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "这么粗糙的首饰只能骗骗第一次来璃月的游客，或者没见识的读书人吧…要想以低价打入璃月的市场？哼，恐怕是要砸牌子了。",
            "nextDialogs": [
              "710540117"
            ]
          },
          "710540117": {
            "id": "710540117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们本来也没有牌子呀！",
            "nextDialogs": [
              "710540118"
            ]
          },
          "710540118": {
            "id": "710540118",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "哈哈，你说的没错。拿这些东西牟利发财，也太没品位了…",
            "nextDialogs": [
              "710540119"
            ]
          },
          "710540119": {
            "id": "710540119",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "所以我们来了，收拾了原来占据这里的盗宝团，装扮成他们的样子潜伏在了这里…嗯，已经是前段时间的事情了。",
            "nextDialogs": [
              "710540120"
            ]
          },
          "710540120": {
            "id": "710540120",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "现在我们又摸清他们的头目们与「愚人众」的一支部队有联络，疑似在交易什么危险物资。"
          },
          "710540110": {
            "id": "710540110",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "哈哈，抱歉事先没来得及解释…我们还以为你是来搞破坏的。",
            "nextDialogs": [
              "710540111"
            ]
          },
          "710540111": {
            "id": "710540111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…某种意义上也没错吧…"
          }
        }
      }
    },

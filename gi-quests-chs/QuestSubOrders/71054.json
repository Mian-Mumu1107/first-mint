      }
    },
    {
      "subId": "7105407",
      "subQuestName": "清理盗宝团的后勤营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710540701"
        ],
        "dialogs": {
          "710540701": {
            "id": "710540701",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "真是精彩！感谢你的帮助，对了，这里是说好的奖励。",
            "nextDialogs": [
              "710540702"
            ]
          },
          "710540702": {
            "id": "710540702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好耶！好多摩拉！欸…你什么时候把衣服也换了…？",
            "nextDialogs": [
              "710540723"
            ]
          },
          "710540723": {
            "id": "710540723",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "你们打架的时候呀…咳咳，呃，我是说，那不重要…为了防止你们打得兴起，又把我们误伤一遍，把制服换回来还是有必要的啦。",
            "nextDialogs": [
              "710540703"
            ]
          },
          "710540703": {
            "id": "710540703",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "千岩军永远感谢你们的帮助。啊，遵照我们的约定，请四处看看有没有你需要的东西吧。",
            "nextDialogs": [
              "710540704"
            ]
          },
          "710540704": {
            "id": "710540704",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "呃…我是说，除了那些我们正在查封的赃物以外。",
            "nextDialogs": [
              "710540706",
              "710540708"
            ]
          },
          "710540706": {
            "id": "710540706",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "哈哈，当然，幸好有你们帮忙，我们才能这么顺利。",
            "nextDialogs": [
              "710540709"
            ]
          },
          "710540709": {
            "id": "710540709",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "嗯，我的意思是…只要别像这些小贼一样，凡事妄图走捷径，我们就不会找你的麻烦。",
            "nextDialogs": [
              "710540710"
            ]
          },
          "710540710": {
            "id": "710540710",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，我们才不是那样的家伙呢！",
            "nextDialogs": [
              "710540711"
            ]
          },
          "710540711": {
            "id": "710540711",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "哈哈，说得也是呀…",
            "nextDialogs": [
              "710540712"
            ]
          },
          "710540712": {
            "id": "710540712",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "唉，话说回来，像你这样会使用元素力的人，不论行善或是作恶，都是不容小觑的力量…",
            "nextDialogs": [
              "710540713"
            ]
          },
          "710540713": {
            "id": "710540713",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "我们需要几个星期或者几个月才能完成的任务，对你们来说可能是轻而易举的事…而如果把元素力用来作恶的话，也会以很小的代价，造成恐怖的破坏。",
            "nextDialogs": [
              "710540714"
            ]
          },
          "710540714": {
            "id": "710540714",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "所以呀，我也并不觉得没有「神之眼」是一件坏事。",
            "nextDialogs": [
              "710540715"
            ]
          },
          "710540715": {
            "id": "710540715",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "我曾见过有些人，为强求非人的力量而不惜付出自身生命的代价，最终却只是做了别人的工具、傀儡，你说说，这值得吗？",
            "nextDialogs": [
              "710540716"
            ]
          },
          "710540716": {
            "id": "710540716",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "710540717"
            ]
          },
          "710540717": {
            "id": "710540717",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "这世上还是没有神之眼的无力之人占了多数，而真正能够理解他们、保护他们的也多是同样的普通人。",
            "nextDialogs": [
              "710540718"
            ]
          },
          "710540718": {
            "id": "710540718",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "身为这样的普通人，能够为保护大多数人而履行职责，不得不说是我的荣幸。",
            "nextDialogs": [
              "710540719"
            ]
          },
          "710540719": {
            "id": "710540719",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "如果哪天，不再有人获得神之眼，甚至守护璃月港的仙人也逝去了…我想我也不会放弃这份职责。",
            "nextDialogs": [
              "710540720"
            ]
          },
          "710540720": {
            "id": "710540720",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "啊，抱歉…自言自语扯了很多没用的话，留你太久了吧？",
            "nextDialogs": [
              "710540721"
            ]
          },
          "710540721": {
            "id": "710540721",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "好了，我们还需要查验和登记赃物，就不多闲聊了。",
            "nextDialogs": [
              "710540722"
            ]
          },
          "710540722": {
            "id": "710540722",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "我代表同僚再次感谢你的帮助，愿你今后的旅途一路顺利。千岩牢固，重嶂不移。"
          },
          "710540708": {
            "id": "710540708",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "当然，你们是协助千岩军…唔，受千岩军协助破获走私大案的首功英雄，我们怎敢请你进大牢呢？"
          }
        }
      }
    },
    {
      "subId": "7105408",
      "subQuestName": "清理盗宝团的后勤营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710540801"
        ],
        "dialogs": {
          "710540801": {
            "id": "710540801",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "请你放心吧，我们会尽快把这些食物运走的。",
            "nextDialogs": [
              "710540802"
            ]
          },
          "710540802": {
            "id": "710540802",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "现在就看你的了，祝你一切顺利。"
          }
        }
      }
    },
    {
      "subId": "7105409",
      "subQuestName": "清理盗宝团的后勤营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710540901"
        ],
        "dialogs": {
          "710540901": {
            "id": "710540901",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "他们的炼金设备还挺业余的…哼，刚刚抓捕时不小心磕碰了一下，已经几乎不能使用了。",
            "nextDialogs": [
              "710540902"
            ]
          },
          "710540902": {
            "id": "710540902",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "我们这边会尽快查封这些赃物，下面就要多赖英雄帮忙了。"
          }
        }
      }
    },
    {
      "subId": "7105410",
      "subQuestName": "test隐藏-回滚隔离$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710541001"
        ],
        "dialogs": {
          "710541001": {
            "id": "710541001",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "他们的弩箭保养的不错，可惜现在是我们的了。让我看看光是这些武器能判他们多少年吧…",
            "nextDialogs": [
              "710541002"
            ]
          },
          "710541002": {
            "id": "710541002",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "我们这边已经搞定啦，接下来就要拜托你们了。"
          }
        }
      }
    },

    {
      "subId": "7105402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710540201"
        ],
        "dialogs": {
          "710540201": {
            "id": "710540201",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "你来了，我就知道你会帮忙的。",
            "nextDialogs": [
              "710540202"
            ]
          },
          "710540202": {
            "id": "710540202",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "盗宝团的走私犯们应该会在东边的大营地里和愚人众进行交易，而在通往大营的道路上，他们还设立了三个小营地。",
            "nextDialogs": [
              "710540203"
            ]
          },
          "710540203": {
            "id": "710540203",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "根据线人的情报，它们分别是东南边的<color=#00E1FFFF>炊事营地</color>、更东边的<color=#00E1FFFF>兵器营地</color>，与东北边的<color=#00E1FFFF>炼金营地</color>。如果我们事先突袭这三个营地，大概能够截断他们的物资供应。",
            "nextDialogs": [
              "710540204"
            ]
          },
          "710540204": {
            "id": "710540204",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "恰好因为前阵子群玉阁的事情，在这里巡逻的千岩军人力不足，让这帮家伙猖狂了一段时间，他们现在戒备松懈了不少，正适合我们突袭。",
            "nextDialogs": [
              "710540205"
            ]
          },
          "710540205": {
            "id": "710540205",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "只不过…因为之前的误会，我现在能支援的人手应该只够巩固一个分支营地，但如果你有需要的话，我们一定会加以支援的。"
          }
        }
      }
    },
    {
      "subId": "7105403",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710540301"
        ],
        "dialogs": {
          "710540301": {
            "id": "710540301",

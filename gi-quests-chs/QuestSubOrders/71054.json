    {
      "subId": "7105404",
      "subQuestName": "test隐藏-选择了炊事营地$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710540401"
        ],
        "dialogs": {
          "710540401": {
            "id": "710540401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先清剿<color=#00E1FFFF>炼金营地</color>能够削弱他们。",
            "nextDialogs": [
              "710540402"
            ]
          },
          "710540402": {
            "id": "710540402",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "很好，我们这就去查封他们的炼金设备。"
          }
        }
      }
    },
    {
      "subId": "7105405",
      "subQuestName": "test隐藏-选择了炼金营地$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710540501"
        ],
        "dialogs": {
          "710540501": {
            "id": "710540501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先清剿<color=#00E1FFFF>兵器营地</color>会更方便。",
            "nextDialogs": [
              "710540502"
            ]
          },
          "710540502": {
            "id": "710540502",
            "speakerId": 20527,
            "speakerName": "彦博",
            "text": "好的，他们很快就会发现自己没有武器可用了。"
          }
        }
      }
    },
    {
      "subId": "7105406",
      "subQuestName": "test隐藏-选择了武器营地$HIDDEN",
      "sceneId": null,
      "locations": [],

    {
      "subId": "2010103",
      "subQuestName": "盘问守卫以获得线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "201010301"
        ],
        "dialogs": {
          "201010301": {
            "id": "201010301",
            "speakerId": 1000,
            "speakerName": "「愚人众」守卫",
            "text": "哇啊…不要吃我！——呃，你们…是人类？",
            "nextDialogs": [
              "201010302"
            ]
          },
          "201010302": {
            "id": "201010302",
            "speakerId": 1000,
            "speakerName": "「愚人众」守卫",
            "text": "一整层的防御…都被突破了…我还以为是「深渊教团」的怪物攻来了…",
            "nextDialogs": [
              "201010304",
              "201010306"
            ]
          },
          "201010304": {
            "id": "201010304",
            "speakerId": 1000,
            "speakerName": "「愚人众」守卫",
            "text": "你，你们怎么知道「天空之琴」在这里…",
            "nextDialogs": [
              "201010309"
            ]
          },
          "201010309": {
            "id": "201010309",
            "speakerId": 1000,
            "speakerName": "「愚人众」守卫",
            "text": "存放圣物的地方是上锁的，你们要找钥匙的话…往前走吧，不要找我！",
            "nextDialogs": [
              "201010310"
            ]
          },
          "201010310": {
            "id": "201010310",
            "speakerId": 1000,
            "speakerName": "「愚人众」守卫",
            "text": "钥匙不知道是在哪位先遣队员手里…但总之你可以去房间里找他们。",
            "nextDialogs": [
              "201010311"
            ]
          },
          "201010311": {
            "id": "201010311",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是个被吓破胆了的人呢。",
            "nextDialogs": [
              "201010312"
            ]
          },
          "201010312": {
            "id": "201010312",
            "speakerId": 1000,
            "speakerName": "「愚人众」守卫",
            "text": "哼…你，你们好自为之吧！",
            "nextDialogs": [
              "201010313"
            ]
          },
          "201010313": {
            "id": "201010313",
            "speakerId": 1000,
            "speakerName": "「愚人众」守卫",
            "text": "我们「愚人众」在蒙德…可是有「执行官」坐镇的！",
            "nextDialogs": [
              "201010314"
            ]
          },
          "201010314": {
            "id": "201010314",
            "speakerId": 1000,
            "speakerName": "「愚人众」守卫",
            "text": "「女士」大人会找到你们，把你们吊起来折磨——到那时可不要连累我啊！"
          },
          "201010306": {
            "id": "201010306",
            "speakerId": 1000,
            "speakerName": "「愚人众」守卫",
            "text": "咿——",
            "nextDialogs": [
              "201010307"
            ]
          },
          "201010307": {
            "id": "201010307",
            "speakerId": 1000,
            "speakerName": "「愚人众」守卫",
            "text": "不要这样…！我有珍贵的情报要坦白！",
            "nextDialogs": [
              "201010308"
            ]
          },
          "201010308": {
            "id": "201010308",
            "speakerId": 1000,
            "speakerName": "「愚人众」守卫",
            "text": "其实我们把蒙德的至宝，「天空之琴」，藏在这座遗迹深处。"
          }
        }
      }
    },

    {
      "subId": "4114201",
      "subQuestName": "与卯师傅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411420101"
        ],
        "dialogs": {
          "411420101": {
            "id": "411420101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我这就送过去。",
            "nextDialogs": [
              "411420102"
            ]
          },
          "411420102": {
            "id": "411420102",
            "speakerId": 1000,
            "speakerName": "卯师傅",
            "text": "那就麻烦你了，实在帮大忙了。",
            "nextDialogs": [
              "411420103"
            ]
          },
          "411420103": {
            "id": "411420103",
            "speakerId": 1000,
            "speakerName": "卯师傅",
            "text": "拿好了，就是这份珍珠翡翠白玉汤，送的时候记得当心点，<color=#00E1FFFF>别被撞翻了，也千万别用风之翼</color>，不然弄洒了都不知道。",
            "nextDialogs": [
              "411420104"
            ]
          },
          "411420104": {
            "id": "411420104",
            "speakerId": 1000,
            "speakerName": "卯师傅",
            "text": "还有就是，<color=#00E1FFFF>别沾了奇怪的东西</color>。不然可能串了味道…",
            "nextDialogs": [
              "411420105"
            ]
          },
          "411420105": {
            "id": "411420105",
            "speakerId": 1000,
            "speakerName": "卯师傅",
            "text": "好了，快点把这菜送过去吧，凉了就不好了。"
          }
        }
      }
    },
    {

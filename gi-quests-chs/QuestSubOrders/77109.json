    {
      "subId": "7710903",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771090801"
        ],
        "dialogs": {
          "771090801": {
            "id": "771090801",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "帕芙琳娜…这就是你在晚宴上曾应允的，为我展示的…你所作的研究的成果…",
            "nextDialogs": [
              "771090802"
            ]
          },
          "771090802": {
            "id": "771090802",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "但没想到你应用到了自己的族裔身上。",
            "nextDialogs": [
              "771090803"
            ]
          },
          "771090803": {
            "id": "771090803",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "这全然出自他们自己的意志…他们本来已时日无多，能够成为您的助力亦是最后的愿望。",
            "nextDialogs": [
              "771090804"
            ]
          },
          "771090804": {
            "id": "771090804",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "不过正因为有他们的献身，我和卡谢伊才得以明晰了…",
            "nextDialogs": [
              "771090805"
            ]
          },
          "771090805": {
            "id": "771090805",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "您从影域中…亥珀波瑞亚遗迹中取得的「埃特{RUBY#[S]地原胚质}尔」究竟是什么样的东西…",
            "nextDialogs": [
              "771090806"
            ]
          },
          "771090806": {
            "id": "771090806",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "结论是？",
            "nextDialogs": [
              "771090807"
            ]
          },
          "771090807": {
            "id": "771090807",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "那是亥珀波瑞亚时期，触犯了禁忌的实验的残余…拥有难以想象的力量，成分复杂…",
            "nextDialogs": [
              "771090808"
            ]
          },
          "771090808": {
            "id": "771090808",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "其中不仅有特殊的…血肉，有被调整过专行创造之事的光界力，还有…",
            "nextDialogs": [
              "771090809"
            ]
          },
          "771090809": {
            "id": "771090809",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "总之，它拥有难以想象的力量，会接触并改造生命…",
            "nextDialogs": [
              "771090810"
            ]
          },
          "771090810": {
            "id": "771090810",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "然后，这些生命的运作方式就会逐渐向着某个倾向转化，并且最后趋同于一种模式。",
            "nextDialogs": [
              "771090811"
            ]
          },
          "771090811": {
            "id": "771090811",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "……",
            "nextDialogs": [
              "771090812"
            ]
          },
          "771090812": {
            "id": "771090812",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "什么样的模式？",
            "nextDialogs": [
              "771090813"
            ]
          },
          "771090813": {
            "id": "771090813",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "…恕我僭越，被改造的生命体内，力量的流转方式与您…十分相似，当然，他们自然无法达到您这样的高度。",
            "nextDialogs": [
              "771090814"
            ]
          },
          "771090814": {
            "id": "771090814",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "对于人造种族妖精来说，这并不是可以凭借稍微改造过的肉身就能完全容纳的力量。",
            "nextDialogs": [
              "771090815"
            ]
          },
          "771090815": {
            "id": "771090815",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "但是卡谢伊…他无法亲口向您请求，因为他是戴罪之身。但是他认为，如需让实验再进一步…",
            "nextDialogs": [
              "771090816"
            ]
          },
          "771090816": {
            "id": "771090816",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "或许您的躯体的是必要的。",
            "nextDialogs": [
              "771090817"
            ]
          },
          "771090817": {
            "id": "771090817",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "…那便取用吧。",
            "nextDialogs": [
              "771090818"
            ]
          },
          "771090818": {
            "id": "771090818",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "我的血，我的肉，如果为了达成前人未尽的伟业，为了让这个世界更进一步，如果一切最后都值得…",
            "nextDialogs": [
              "771090819"
            ]
          },
          "771090819": {
            "id": "771090819",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "便随你们取用吧！",
            "nextDialogs": [
              "771090820"
            ]
          },
          "771090820": {
            "id": "771090820",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "啊…陛下…",
            "nextDialogs": [
              "771090821"
            ]
          },
          "771090821": {
            "id": "771090821",
            "speakerId": 1003,
            "speakerName": "帕芙琳娜",
            "text": "我为所有将踏入「明日」，为所有…可得拯救者，感谢您的慷慨。"
          }
        }
      }
    },

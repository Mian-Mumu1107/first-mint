        ],
        "dialogs": {
          "5000101": {
            "id": "5000101",
            "speakerId": 1000,
            "speakerName": "石门公告板",
            "text": "此为石门公告板，公告与来往客人留言皆可张贴此处。",
            "nextDialogs": [
              "5000102"
            ]
          },
          "5000102": {
            "id": "5000102",
            "speakerId": 1001,
            "speakerName": "公告",
            "text": "近来石门与荻花洲一带魔物活动较频繁，千岩军已增加巡逻班次，望过路客商注意安全，出入平安。"
          }
        }
      }
    },
    {
      "subId": "50002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000201"
        ],
        "dialogs": {
          "5000201": {
            "id": "5000201",
            "speakerId": 1000,
            "speakerName": "石门公告板",
            "text": "此为石门公告板，公告与来往客人留言皆可张贴此处。",
            "nextDialogs": [
              "5000202"
            ]
          },
          "5000202": {
            "id": "5000202",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「最后一天！关门闭店大甩卖！春香窑名瓷统统折价出售！」",
            "nextDialogs": [
              "5000203"
            ]
          },
          "5000203": {
            "id": "5000203",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「过了这村没这店，过了这家没下家！大！甩！卖！」"
          }
        }
      }
    },
    {
      "subId": "50003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000301"
        ],
        "dialogs": {
          "5000301": {
            "id": "5000301",
            "speakerId": 1000,
            "speakerName": "石门公告板",
            "text": "此为石门公告板，公告与来往客人留言皆可张贴此处。",
            "nextDialogs": [
              "5000302"
            ]
          },
          "5000302": {
            "id": "5000302",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「天下日用，无奇不卖！」",
            "nextDialogs": [
              "5000303"
            ]
          },
          "5000303": {
            "id": "5000303",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「有道是奇货可居，诸位过路客商如有需要，请尽管来荻花洲找我万货通！」"
          }
        }
      }
    },
    {
      "subId": "50004",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000401"
        ],
        "dialogs": {
          "5000401": {
            "id": "5000401",
            "speakerId": 1000,
            "speakerName": "石门公告板",
            "text": "此为石门公告板，公告与来往客人留言皆可张贴此处。",
            "nextDialogs": [
              "5000402"
            ]
          },
          "5000402": {
            "id": "5000402",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「大碗粗茶，便宜解渴！老周叔欢迎各位客人光顾休息！」",
            "nextDialogs": [
              "5000403"
            ]
          },
          "5000403": {
            "id": "5000403",
            "speakerId": 1003,
            "speakerName": "另一张便条",
            "text": "「相识四十年，我能打包票，周老弟的手艺是从来没退步…也没进步。」"
          }
        }
      }
    },
    {
      "subId": "50005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000501"
        ],
        "dialogs": {
          "5000501": {
            "id": "5000501",
            "speakerId": 1000,
            "speakerName": "石门公告板",
            "text": "此为石门公告板，公告与来往客人留言皆可张贴此处。",
            "nextDialogs": [
              "5000502"
            ]
          },
          "5000502": {
            "id": "5000502",
            "speakerId": 1001,
            "speakerName": "公告",
            "text": "石门至荻花洲一带近来多有盗掘犯罪团伙活动，过路行人须多加小心。",
            "nextDialogs": [
              "5000503"
            ]
          },
          "5000503": {
            "id": "5000503",
            "speakerId": 1001,
            "speakerName": "公告",
            "text": "如有发现可疑人物，请首先注意自身安全，然后尽快向附近的千岩军兵士报告情况。"
          }
        }
      }
    },
    {
      "subId": "50006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000601"
        ],
        "dialogs": {
          "5000601": {
            "id": "5000601",
            "speakerId": 1000,
            "speakerName": "石门公告板",
            "text": "此为石门公告板，公告与来往客人留言皆可张贴此处。",
            "nextDialogs": [
              "5000602"
            ]
          },
          "5000602": {
            "id": "5000602",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「愿岩王爷保佑我们能顺利远走高飞，在新的国度展开属于自己的生活…」",
            "nextDialogs": [
              "5000603"
            ]
          },
          "5000603": {
            "id": "5000603",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「…只愿此前的苦心筹划与共同犯下的错误，不是白费力气。」"
          }
        }
      }
    },
    {
      "subId": "50007",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000701"
        ],
        "dialogs": {
          "5000701": {
            "id": "5000701",
            "speakerId": 1000,
            "speakerName": "石门公告板",
            "text": "此为石门公告板，公告与来往客人留言皆可张贴此处。",
            "nextDialogs": [
              "5000702"
            ]
          },
          "5000702": {
            "id": "5000702",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「『刃光竹影留绯雨，惟愿长醉饮悲风。』在下舞刀弄剑之人，不明诗韵，拙作还请过客品评。」",
            "nextDialogs": [
              "5000703"
            ]
          },
          "5000703": {
            "id": "5000703",
            "speakerId": 1003,
            "speakerName": "另一张便条",
            "text": "「以敝人拙见，此二句有若青蛙跳井——不通，不通！」"
          }
        }
      }
    },
    {
      "subId": "50008",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000801"
        ],
        "dialogs": {
          "5000801": {
            "id": "5000801",
            "speakerId": 1000,
            "speakerName": "石门公告板",
            "text": "此为石门公告板，公告与来往客人留言皆可张贴此处。",
            "nextDialogs": [
              "5000802"
            ]
          },
          "5000802": {
            "id": "5000802",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「蒙德的美食修行之旅，随风启程！」",
            "nextDialogs": [
              "5000803"
            ]
          },
          "5000803": {
            "id": "5000803",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「在风与酒的国度里，料理也会有酒香和清风的味道吗？」"
          }
        }
      }
    },
    {
      "subId": "50009",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5000901"
        ],
        "dialogs": {
          "5000901": {
            "id": "5000901",
            "speakerId": 1000,
            "speakerName": "石门公告板",
            "text": "此为石门公告板，公告与来往客人留言皆可张贴此处。",
            "nextDialogs": [
              "5000902"
            ]
          },
          "5000902": {
            "id": "5000902",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「古华…沉秋…剑…仙人于云间…妖孽…」",
            "nextDialogs": [
              "5000903"
            ]
          },
          "5000903": {
            "id": "5000903",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「在下…书…奇哉…此诗…」",
            "nextDialogs": [
              "5000904"
            ]
          },
          "5000904": {
            "id": "5000904",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "（由于字迹太丑，下面的内容完全无法辨认。）"
          }
        }
      }
    },
    {
      "subId": "50010",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5001001"
        ],
        "dialogs": {
          "5001001": {
            "id": "5001001",
            "speakerId": 1000,
            "speakerName": "石门公告板",
            "text": "此为石门公告板，公告与来往客人留言皆可张贴此处。",
            "nextDialogs": [
              "5001002"
            ]
          },
          "5001002": {
            "id": "5001002",
            "speakerId": 1001,
            "speakerName": "公告",
            "text": "欢迎来到石门，此处乃璃月门户，南通港城，北衢酒乡。愿来客归人一路平安，同享璃月繁华盛景。"
          }
        }
      }
    },
    {
      "subId": "50011",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5001101"
        ],
        "dialogs": {
          "5001101": {
            "id": "5001101",
            "speakerId": 1000,
            "speakerName": "石门公告板",
            "text": "此为石门公告板，公告与来往客人留言皆可张贴此处。",
            "nextDialogs": [
              "5001102"
            ]
          },
          "5001102": {
            "id": "5001102",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「前些日子有个十分贵气的紫衣女孩路过这里，说是『稽查土地』、『调查居民生活消费情况』什么的，问这问那，像是从城里来的。」",
            "nextDialogs": [
              "5001103"
            ]
          },
          "5001103": {
            "id": "5001103",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「问起她便答是玉京台的普通书记员，城里人做事果真周密果断…」",
            "nextDialogs": [
              "5001104"
            ]
          },
          "5001104": {
            "id": "5001104",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「年纪轻轻竟如此雷厉风行，在如今的年轻人中间实属罕见。」"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "7550901",
      "subQuestName": "返回派对现场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "755090101"
        ],
        "dialogs": {
          "755090101": {
            "id": "755090101",
            "speakerId": 1000,
            "speakerName": "玛拉妮",
            "text": "哎，瑞希瑞希！刚才我和阿米娜聊过了——",
            "nextDialogs": [
              "755090102"
            ]
          },
          "755090102": {
            "id": "755090102",
            "speakerId": 1000,
            "speakerName": "玛拉妮",
            "text": "最近派对一开办，「流泉之众」的客流量直接增加了四成！明明我们还没全力宣传呢！",
            "nextDialogs": [
              "755090103"
            ]
          },
          "755090103": {
            "id": "755090103",
            "speakerId": 1001,
            "speakerName": "梦见月瑞希",
            "text": "再好不过啦，我这边也有好消息：最近来我店里做心理诊疗的客人只余下平常的十分之一。",
            "nextDialogs": [
              "755090104"
            ]
          },
          "755090104": {
            "id": "755090104",
            "speakerId": 1001,
            "speakerName": "梦见月瑞希",
            "text": "说明我们达成了目标——借助这场派对改善人们的心情，让大家暂时忘却烦恼，彻底放松下来。",
            "nextDialogs": [
              "755090105"
            ]
          },
          "755090105": {
            "id": "755090105",
            "speakerId": 1000,
            "speakerName": "玛拉妮",
            "text": "啊哈哈，下次就把派对办大一点！除了「节拍撞球」，再加入几个新游戏！",
            "nextDialogs": [
              "755090106"
            ]
          },
          "755090106": {
            "id": "755090106",
            "speakerId": 1000,
            "speakerName": "玛拉妮",
            "text": "到时候，想放松的客人就泡温泉，晒日光浴；想嗨起来的客人就来玩派对上的游戏，「流泉之众」的假日就完美啦！",
            "nextDialogs": [
              "755090107"
            ]
          },
          "755090107": {
            "id": "755090107",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗨！玛拉妮，瑞希！",
            "nextDialogs": [
              "755090110"
            ]
          },
          "755090110": {
            "id": "755090110",
            "speakerId": 1000,
            "speakerName": "玛拉妮",
            "text": "嗯！看你们的表情，听你们话语里的活力就知道，你们一定也玩得心满意足！",
            "nextDialogs": [
              "755090111"
            ]
          },
          "755090111": {
            "id": "755090111",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "那可不！不止玩了个痛快，还吃饱喝足！特别是不限量的自助…我吃了整整五大份「温泉时光」呢！",
            "nextDialogs": [
              "755090112"
            ]
          },
          "755090112": {
            "id": "755090112",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#至于{NICKNAME}，玩撞球比我吃饭都有劲！"
          }
        }
      }
    }
  ]
}
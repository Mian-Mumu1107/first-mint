    {
      "subId": "4003908",
      "subQuestName": "与卡门对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400390801"
        ],
        "dialogs": {
          "400390801": {
            "id": "400390801",
            "speakerId": 30086,
            "speakerName": "卡门",
            "text": "停手！都给我停手！",
            "nextDialogs": [
              "400390802"
            ]
          },
          "400390802": {
            "id": "400390802",
            "speakerId": 30086,
            "speakerName": "卡门",
            "text": "你们这帮不长眼的，连北斗大姐都不认识了吗？！",
            "nextDialogs": [
              "400390803"
            ]
          },
          "400390803": {
            "id": "400390803",
            "speakerId": 30086,
            "speakerName": "卡门",
            "text": "嘿嘿…北斗姐，这么长时间没见，您身手还是这么好…",
            "nextDialogs": [
              "400390804"
            ]
          },
          "400390804": {
            "id": "400390804",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "卡门，一段时间不见，你怎么又胖了不少。",
            "nextDialogs": [
              "400390805"
            ]
          },
          "400390805": {
            "id": "400390805",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "再胖下去，你躲在草丛里的时候可就要藏不住自己了。",
            "nextDialogs": [
              "400390806"
            ]
          },
          "400390806": {
            "id": "400390806",
            "speakerId": 30086,
            "speakerName": "卡门",
            "text": "您说笑了，说笑了…哈哈哈…",
            "nextDialogs": [
              "400390807"
            ]
          },
          "400390807": {
            "id": "400390807",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "说正事吧，这些东西我要了。把东西放下，我不为难你们。",
            "nextDialogs": [
              "400390808"
            ]
          },
          "400390808": {
            "id": "400390808",
            "speakerId": 30086,
            "speakerName": "卡门",
            "text": "是是是，都听北斗姐的…把东西都放下！",
            "nextDialogs": [
              "400390809"
            ]
          },
          "400390809": {
            "id": "400390809",
            "speakerId": 30086,
            "speakerName": "卡门",
            "text": "东西都给您放在这了，那…那兄弟们就先告辞了。",
            "nextDialogs": [
              "400390810"
            ]
          },
          "400390810": {
            "id": "400390810",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "卡门带着盗宝团迅速离开了…",
            "nextDialogs": [
              "400390811"
            ]
          },
          "400390811": {
            "id": "400390811",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然答应得这么爽快…",
            "nextDialogs": [
              "400390812"
            ]
          },
          "400390812": {
            "id": "400390812",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "投降得很利落。",
            "nextDialogs": [
              "400390813"
            ]
          },
          "400390813": {
            "id": "400390813",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "跑得也很利落啊…",
            "nextDialogs": [
              "400390814"
            ]
          },
          "400390814": {
            "id": "400390814",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "别在他们身上浪费时间了，我们快点去海上接着打捞吧。",
            "nextDialogs": [
              "400390815"
            ]
          },
          "400390815": {
            "id": "400390815",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "对了，还得把这些东西搬上船才行…旅行者，过来搭把手。"
          }
        }
      }
    },
    {
      "subId": "4003916",

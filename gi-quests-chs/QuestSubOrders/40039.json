    {
      "subId": "4003911",
      "subQuestName": "追踪盗宝团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400391101"
        ],
        "dialogs": {
          "400391101": {
            "id": "400391101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "收拾得再快点，零碎的小玩意就不要了，挑值钱的带走！",
            "nextDialogs": [
              "400391102"
            ]
          },
          "400391102": {
            "id": "400391102",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "再去几个人，把船赶紧装好了！",
            "nextDialogs": [
              "400391103"
            ]
          },
          "400391103": {
            "id": "400391103",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "都给我停下，东西也都放下。",
            "nextDialogs": [
              "400391104"
            ]
          },
          "400391104": {
            "id": "400391104",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "北…北斗姐！您、您怎么来了？",
            "nextDialogs": [
              "400391105"
            ]
          },
          "400391105": {
            "id": "400391105",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "溜溜，你在这里做什么？",
            "nextDialogs": [
              "400391106"
            ]
          },
          "400391106": {
            "id": "400391106",
            "speakerId": 30087,
            "speakerName": "溜溜",
            "text": "哎呀，兄弟们这不是…撞了大运，从海上捞到了点好东西吗？",
            "nextDialogs": [
              "400391107"
            ]
          },
          "400391107": {
            "id": "400391107",
            "speakerId": 30087,
            "speakerName": "溜溜",
            "text": "北斗姐喜欢什么，随便拿！就当是兄弟们孝敬您的，哈哈哈！",
            "nextDialogs": [
              "400391108"
            ]
          },
          "400391108": {
            "id": "400391108",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "是吗？那这些东西就全都留下吧。",
            "nextDialogs": [
              "400391109"
            ]
          },
          "400391109": {
            "id": "400391109",
            "speakerId": 30087,
            "speakerName": "溜溜",
            "text": "这…这…您多少得讲点道上规矩…",
            "nextDialogs": [
              "400391110"
            ]
          },
          "400391110": {
            "id": "400391110",
            "speakerId": 30087,
            "speakerName": "溜溜",
            "text": "兄弟们忙前忙后，好歹得喝一口汤吧？",
            "nextDialogs": [
              "400391111"
            ]
          },
          "400391111": {
            "id": "400391111",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "这东西不是你们能碰的。我再说一遍，把东西放下，然后有多远滚多远。",
            "nextDialogs": [
              "400391112"
            ]
          },
          "400391112": {
            "id": "400391112",
            "speakerId": 30087,
            "speakerName": "溜溜",
            "text": "这…不太好吧…北斗姐，不然我们再…",
            "nextDialogs": [
              "400391113"
            ]
          },
          "400391113": {
            "id": "400391113",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "呼…看来你是在拖时间啊。",
            "nextDialogs": [
              "400391114"
            ]
          },
          "400391114": {
            "id": "400391114",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "那也别废话了，来吧，我们过两招！"
          }
        }
      }
    },
    {
      "subId": "4003913",
      "subQuestName": "打倒所有盗宝团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4003914",
      "subQuestName": "与北斗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400391401"
        ],
        "dialogs": {
          "400391401": {
            "id": "400391401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些家伙，跑得也太快了…",
            "nextDialogs": [
              "400391402"
            ]
          },
          "400391402": {
            "id": "400391402",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "算了，反正他们也没带走多少东西。",
            "nextDialogs": [
              "400391403"
            ]
          },
          "400391403": {
            "id": "400391403",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "但这里有这么多东西，你的那艘船应该也装不下了。",
            "nextDialogs": [
              "400391404"
            ]
          },
          "400391404": {
            "id": "400391404",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "唔，这样吧。把你船上的那些东西也卸下来，都放在这里。",
            "nextDialogs": [
              "400391405"
            ]
          },
          "400391405": {
            "id": "400391405",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "按照打捞计划，海龙他们的船应该会经过这里。到时候，我让他带我们回去。",
            "nextDialogs": [
              "400391406"
            ]
          },
          "400391406": {
            "id": "400391406",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "旅行者，你先回群玉阁帮我给凝光带个话。",
            "nextDialogs": [
              "400391407"
            ]
          },
          "400391407": {
            "id": "400391407",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "就说…东西已经捞得差不多了，让她把报酬都准备好。",
            "nextDialogs": [
              "400391408"
            ]
          },
          "400391408": {
            "id": "400391408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道了。",
            "nextDialogs": [
              "400391409"
            ]
          },
          "400391409": {
            "id": "400391409",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "嗯，那就拜托你了。",
            "nextDialogs": [
              "400391410"
            ]
          },
          "400391410": {
            "id": "400391410",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "卡门和溜溜都来了，难道那位盗宝团的「大姐头」也来了？",
            "nextDialogs": [
              "400391411"
            ]
          },
          "400391411": {
            "id": "400391411",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "必须得让海龙他们提高警惕才行…"
          }
        }
      }
    },
    {
      "subId": "4003912",
      "subQuestName": "向凝光回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400391201"
        ],
        "dialogs": {
          "400391201": {
            "id": "400391201",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "你们回来了，如何，北斗打捞得可还顺利？",
            "nextDialogs": [
              "400391202"
            ]
          },
          "400391202": {
            "id": "400391202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是这样的…",
            "nextDialogs": [
              "400391203"
            ]
          },
          "400391203": {
            "id": "400391203",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "向凝光讲述了事情的经过…",
            "nextDialogs": [
              "400391204"
            ]
          },
          "400391204": {
            "id": "400391204",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "盗宝团也掺和进来了啊，确实有些麻烦。",
            "nextDialogs": [
              "400391205"
            ]
          },
          "400391205": {
            "id": "400391205",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "你们这次能吓退他们，但只是一时，这群家伙不会善罢甘休。",
            "nextDialogs": [
              "400391206"
            ]
          },
          "400391206": {
            "id": "400391206",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "不过，这件事就交给北斗吧，她擅长对付这些人。她的报酬，我也会准备好的。",
            "nextDialogs": [
              "400391207"
            ]
          },
          "400391207": {
            "id": "400391207",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "多谢你们专程回来告知我这些事。我为你们也准备了一些酬劳，还请收下。",
            "nextDialogs": [
              "400391208"
            ]
          },
          "400391208": {
            "id": "400391208",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "那我就先去处理别的事了，祝你们玩得尽兴。"
          }
        }
      }
    },
    {
      "subId": "4003999",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400399901"
        ],
        "dialogs": {
          "400399901": {
            "id": "400399901",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "旅行者，这就是…你的船？",
            "nextDialogs": [
              "400399902"
            ]
          },
          "400399902": {
            "id": "400399902",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "真是…小巧啊，不错，不错…很适合捞海面上浮着的东西。",
            "nextDialogs": [
              "400399903"
            ]
          },
          "400399903": {
            "id": "400399903",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "就是有点挤，我的琴都摆不开了…",
            "nextDialogs": [
              "400399904"
            ]
          },
          "400399904": {
            "id": "400399904",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "辛焱，你的琴离我太近了…",
            "nextDialogs": [
              "400399905"
            ]
          },
          "400399905": {
            "id": "400399905",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "哦…哦！我挪一下位置…",
            "nextDialogs": [
              "400399906"
            ]
          },
          "400399906": {
            "id": "400399906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？你的琴底下怎么还带着刃？",
            "nextDialogs": [
              "400399907"
            ]
          },
          "400399907": {
            "id": "400399907",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "当然是防身用的啦！它还会喷火呢，不过这大过节的，还是不演示了吧…",
            "nextDialogs": [
              "400399908"
            ]
          },
          "400399908": {
            "id": "400399908",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "俗话说得好，不怕一万就怕万一，可不能把你们的船给烧着了…",
            "nextDialogs": [
              "400399929"
            ]
          },
          "400399929": {
            "id": "400399929",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这把琴用处可真多啊…",
            "nextDialogs": [
              "400399909"
            ]
          },
          "400399909": {
            "id": "400399909",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "等等，前面那是…盗宝团？！",
            "nextDialogs": [
              "400399910"
            ]
          },
          "400399910": {
            "id": "400399910",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "这帮人在海上做什么，难道他们也在捞东西？",
            "nextDialogs": [
              "400399911"
            ]
          },
          "400399911": {
            "id": "400399911",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "旅行者，我们靠近点看看吧。",
            "nextDialogs": [
              "400399919"
            ]
          },
          "400399919": {
            "id": "400399919",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "嗯？海面上好像漂着什么东西…",
            "nextDialogs": [
              "400399920"
            ]
          },
          "400399920": {
            "id": "400399920",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "看不太清啊，捞上来再说。",
            "nextDialogs": [
              "400399921"
            ]
          },
          "400399921": {
            "id": "400399921",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "来，换我掌舵。旅行者，辛焱，你们快去把那些东西捞上来吧。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "4003915",
      "subQuestName": "与北斗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400391501"
        ],
        "dialogs": {
          "400391501": {
            "id": "400391501",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "咦？那群盗宝团怎么去岸上了？",
            "nextDialogs": [
              "400391502"
            ]
          },
          "400391502": {
            "id": "400391502",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "他们大概是想去和同伙会合吧。",
            "nextDialogs": [
              "400391503"
            ]
          },
          "400391503": {
            "id": "400391503",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "旅行者，把船再开快些，我们追上去。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "4003901",
      "subQuestName": "前往群玉阁",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400390101"
        ],
        "dialogs": {
          "400390101": {
            "id": "400390101",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "北斗正在孤云阁那边帮我打捞散落的群玉阁藏品。你们若有兴趣，可以去看看。"
          }
        }
      }
    },
    {
      "subId": "4003902",
      "subQuestName": "与凝光对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400390201"
        ],
        "dialogs": {
          "400390201": {
            "id": "400390201",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "还真是少了很多东西啊…",
            "nextDialogs": [
              "400390202"
            ]
          },
          "400390202": {
            "id": "400390202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么东西？",
            "nextDialogs": [
              "400390203"
            ]
          },
          "400390203": {
            "id": "400390203",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "与先前相比，如今这座群玉阁里少了许多东西。",
            "nextDialogs": [
              "400390204"
            ]
          },
          "400390204": {
            "id": "400390204",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "我收藏的许多书籍，家具和小饰品，都随着那座群玉阁坠入海中…",
            "nextDialogs": [
              "400390205"
            ]
          },
          "400390205": {
            "id": "400390205",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "这些物品大都在那场大难中毁坏了，少部分幸存的散落在海面上，极难回收。",
            "nextDialogs": [
              "400390206"
            ]
          },
          "400390206": {
            "id": "400390206",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "只有擅长水上工作的人才能替我办到这件事。只是…不知道北斗能不能把它们都捞回来。",
            "nextDialogs": [
              "400390207"
            ]
          },
          "400390207": {
            "id": "400390207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "捞回来？",
            "nextDialogs": [
              "400390208"
            ]
          },
          "400390208": {
            "id": "400390208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你让北斗去捞那些东西了吗？",
            "nextDialogs": [
              "400390209"
            ]
          },
          "400390209": {
            "id": "400390209",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "「让」这个字，不够精准。我们之间向来是公平交易。",
            "nextDialogs": [
              "400390210"
            ]
          },
          "400390210": {
            "id": "400390210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "北斗拿钱办事？",
            "nextDialogs": [
              "400390211"
            ]
          },
          "400390211": {
            "id": "400390211",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "除了「钱」之外，还有其他的「报酬」…呵呵，这些事复杂着呢。",
            "nextDialogs": [
              "400390212"
            ]
          },
          "400390212": {
            "id": "400390212",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "总之，北斗现在正在孤云阁一带。",
            "nextDialogs": [
              "400390213"
            ]
          },
          "400390213": {
            "id": "400390213",
            "speakerId": 10211,
            "speakerName": "凝光",
            "text": "你们若有兴趣，可以去看看。说不定，你们也能帮到她的忙。"
          }
        }
      }
    },
    {
      "subId": "4003903",
      "subQuestName": "前往「死兆星」号",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4003904",
      "subQuestName": "与北斗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400390401"
        ],
        "dialogs": {
          "400390401": {
            "id": "400390401",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "那个麻烦的女人…",
            "nextDialogs": [
              "400390402"
            ]
          },
          "400390402": {
            "id": "400390402",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "那座群玉阁在海上撞了个粉碎，里面的东西肯定也都被撞坏了，怎么可能捞得上来…",
            "nextDialogs": [
              "400390403"
            ]
          },
          "400390403": {
            "id": "400390403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "打捞还顺利吗？",
            "nextDialogs": [
              "400390404"
            ]
          },
          "400390404": {
            "id": "400390404",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "旅行者？你们怎么来了？",
            "nextDialogs": [
              "400390405"
            ]
          },
          "400390405": {
            "id": "400390405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我是来帮忙的。",
            "nextDialogs": [
              "400390406"
            ]
          },
          "400390406": {
            "id": "400390406",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "哦！你来得正好，现在全船的人都出动了，人手实在是不够用。",
            "nextDialogs": [
              "400390407"
            ]
          },
          "400390407": {
            "id": "400390407",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "你看，我连辛焱都拉来帮忙了。",
            "nextDialogs": [
              "400390408"
            ]
          },
          "400390408": {
            "id": "400390408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "辛焱居然也来了？",
            "nextDialogs": [
              "400390409"
            ]
          },
          "400390409": {
            "id": "400390409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对喔，辛焱怎么会在船上？难道是有演出？",
            "nextDialogs": [
              "400390410"
            ]
          },
          "400390410": {
            "id": "400390410",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "是啊！虽然也算不上正式音乐演出啦，是北斗姐说想办宴会，请我来唱两首歌。",
            "nextDialogs": [
              "400390411"
            ]
          },
          "400390411": {
            "id": "400390411",
            "speakerId": 1042,
            "speakerName": "辛焱",
            "text": "但什么都还没开始，忽然有个自称是凝光秘书的人过来，把北斗姐叫走了。",
            "nextDialogs": [
              "400390412"
            ]
          },
          "400390412": {
            "id": "400390412",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "是叫百闻还是百晓来着？唔…有些记不清了。",
            "nextDialogs": [
              "400390413"
            ]
          },
          "400390413": {
            "id": "400390413",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "反正就是凝光又突发奇想，要我帮她到海上打捞藏品，作为交换她会支付一大笔劳务费。",
            "nextDialogs": [
              "400390414"
            ]
          },
          "400390414": {
            "id": "400390414",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "哼…既然资金到位，这活儿我们接就接了。",
            "nextDialogs": [
              "400390415"
            ]
          },
          "400390415": {
            "id": "400390415",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "打捞啊，必须得用小船。",
            "nextDialogs": [
              "400390416"
            ]
          },
          "400390416": {
            "id": "400390416",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "船队里能动用的小船都出发了，不过眼下还缺一艘…",
            "nextDialogs": [
              "400390417"
            ]
          },
          "400390417": {
            "id": "400390417",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我有一艘小船。",
            "nextDialogs": [
              "400390418"
            ]
          },
          "400390418": {
            "id": "400390418",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "你有船？那正好，我们就坐你的船出海。",
            "nextDialogs": [
              "400390419"
            ]
          },
          "400390419": {
            "id": "400390419",
            "speakerId": 1031,
            "speakerName": "北斗",
            "text": "多一个人多一份力量嘛。早点忙完，我们才好回来办宴会庆祝过节啊！"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2300701",
      "subQuestName": "与阿金对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230070101"
        ],
        "dialogs": {
          "230070101": {
            "id": "230070101",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "有没有更好用的材料呢…",
            "nextDialogs": [
              "230070102"
            ]
          },
          "230070102": {
            "id": "230070102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么材料？",
            "nextDialogs": [
              "230070103"
            ]
          },
          "230070103": {
            "id": "230070103",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "抱歉，我又在自言自语了。最近天气变化莫测，房屋出问题的情况很多，我有点忙不过来。",
            "nextDialogs": [
              "230070104"
            ]
          },
          "230070104": {
            "id": "230070104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不是做陶器的吗？",
            "nextDialogs": [
              "230070105"
            ]
          },
          "230070105": {
            "id": "230070105",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "是这样没错，但我也是泥瓦匠，都是和泥土打交道的事，也没差啦。",
            "nextDialogs": [
              "230070106"
            ]
          },
          "230070106": {
            "id": "230070106",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "你听过那句话吗？「做学问就像盖房子，要想起高楼，就要打好地基。」",
            "nextDialogs": [
              "230070107"
            ]
          },
          "230070107": {
            "id": "230070107",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "「想要扩展学术理论，就要夯实根基，正所谓基础不牢，地动山摇…」",
            "nextDialogs": [
              "230070108"
            ]
          },
          "230070108": {
            "id": "230070108",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "上面的聪明人总把这话挂在嘴边，虽然我不是很懂，但你看，他们把建房子看得和做学问一样重要。",
            "nextDialogs": [
              "230070111"
            ]
          },
          "230070111": {
            "id": "230070111",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "不管怎么说，提到房屋的基础，就会想到建材。",
            "nextDialogs": [
              "230070112"
            ]
          },
          "230070112": {
            "id": "230070112",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "泥土作为粘合与支撑材料，如果能强化它的强度与适应性，房子就会更坚固，我也不用这么忙了。"
          }
        }
      }
    },
    {
      "subId": "2300702",
      "subQuestName": "前往阿金推荐的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230070201"
        ],
        "dialogs": {
          "230070201": {
            "id": "230070201",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "目前我有几个想法，今天的话…我想找一些浸有史莱姆凝液的泥土。",
            "nextDialogs": [
              "230070202"
            ]
          },
          "230070202": {
            "id": "230070202",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "我找人打听到了一处史莱姆的聚集地，旅行者，你能帮我去取些泥土回来吗？",
            "nextDialogs": [
              "230070204",
              "230070207"
            ]
          },
          "230070204": {
            "id": "230070204",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "那就拜托你了，打不打倒那些史莱姆都行，只要取一些它们聚集地附近的泥土回来就好。",
            "nextDialogs": [
              "230070205"
            ]
          },
          "230070205": {
            "id": "230070205",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "我把那片史莱姆聚集地的方位给你标在地图上…"
          },
          "230070207": {
            "id": "230070207",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "我也想自己去，但我还要去解决一些坛坛罐罐的问题。",
            "nextDialogs": [
              "230070208"
            ]
          },
          "230070208": {
            "id": "230070208",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "放心吧，我会为你准备好合适的报酬的，这件事就拜托你了。",
            "nextDialogs": [
              "230070209"
            ]
          },
          "230070209": {
            "id": "230070209",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "请你去这里找一找吧，我帮你标在地图上…",
            "nextDialogs": [
              "230070210"
            ]
          },
          "230070210": {
            "id": "230070210",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "那就拜托你了，打不打倒那些史莱姆都行，只要取一些它们聚集地附近的泥土回来就好。"
          }
        }
      }
    },
    {
      "subId": "2300703",
      "subQuestName": "前往阿金标记的地点，取得泥土",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230070301"
        ],
        "dialogs": {
          "230070301": {
            "id": "230070301",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "目前我有几个想法，今天的话…我想找一些经常与元素生物接触的土壤。",
            "nextDialogs": [
              "230070302"
            ]
          },
          "230070302": {
            "id": "230070302",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "骗骗花就不错，它们生长的地方，泥土很可能有与众不同的特点。",
            "nextDialogs": [
              "230070303"
            ]
          },
          "230070303": {
            "id": "230070303",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "但我只是个泥瓦匠，总不可能拿罐子去砸翻那些骗骗花…",
            "nextDialogs": [
              "230070304"
            ]
          },
          "230070304": {
            "id": "230070304",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "旅行者，能请你帮我这个忙吗？",
            "nextDialogs": [
              "230070306",
              "230070309"
            ]
          },
          "230070306": {
            "id": "230070306",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "那就拜托你了，请你帮我带回来一份骗骗花根系上的泥土吧。",
            "nextDialogs": [
              "230070307"
            ]
          },
          "230070307": {
            "id": "230070307",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "我告诉你一个地方，那里据说有骗骗花出现…"
          },
          "230070309": {
            "id": "230070309",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "我也想自己去，但我还要去解决一些坛坛罐罐的问题。",
            "nextDialogs": [
              "230070310"
            ]
          },
          "230070310": {
            "id": "230070310",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "放心吧，我会为你准备好合适的报酬的，这件事就拜托你了。",
            "nextDialogs": [
              "230070311"
            ]
          },
          "230070311": {
            "id": "230070311",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "请你去这里找一找吧，我帮你标在地图上…",
            "nextDialogs": [
              "230070312"
            ]
          },
          "230070312": {
            "id": "230070312",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "那就拜托你了，请你帮我带回来一份骗骗花根系上的泥土吧。"
          }
        }
      }
    },

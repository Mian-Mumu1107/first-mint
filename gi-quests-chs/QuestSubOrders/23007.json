    {
      "subId": "2300709",
      "subQuestName": "与阿金对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230070901"
        ],
        "dialogs": {
          "230070901": {
            "id": "230070901",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "我想要的就是这个，帮大忙了。",
            "nextDialogs": [
              "230070902"
            ]
          },
          "230070902": {
            "id": "230070902",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "这泥土摸起来就黏黏的，是混合了一些史莱姆凝液吗？不知道能不能和其他泥土凝成一块…",
            "nextDialogs": [
              "230070903"
            ]
          },
          "230070903": {
            "id": "230070903",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "不过，总之还是非常谢谢你帮忙。这是报酬，还请你收下。",
            "nextDialogs": [
              "230070904"
            ]
          },
          "230070904": {
            "id": "230070904",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "哎呀，不如就把这些泥土叫做「凝成泥土」好了…"
          }
        }
      }
    },
    {
      "subId": "2300710",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230071001"
        ],
        "dialogs": {
          "230071001": {
            "id": "230071001",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "我想要的就是这个，帮大忙了。我等会就把这些泥土拿回去试验。",
            "nextDialogs": [
              "230071002"
            ]
          },
          "230071002": {
            "id": "230071002",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "非常谢谢你。这是报酬，还请你收下。",
            "nextDialogs": [
              "230071003"
            ]
          },
          "230071003": {
            "id": "230071003",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "如果能把许多材质不同的泥土混合在一起的话，做出来的泥土会不会更加耐用呢…"
          }
        }
      }
    },
    {
      "subId": "2300711",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230071101"
        ],
        "dialogs": {
          "230071101": {
            "id": "230071101",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "嗯，我想要的就是这个，帮大忙了。",
            "nextDialogs": [
              "230071102"
            ]
          },
          "230071102": {
            "id": "230071102",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "不过…比我想象中要更软啊。粘合力没问题，但支撑力可能不太够…",
            "nextDialogs": [
              "230071103"
            ]
          },
          "230071103": {
            "id": "230071103",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "但没关系，上面的聪明人也经常说，「高楼不是一日建成的。」",
            "nextDialogs": [
              "230071104"
            ]
          },
          "230071104": {
            "id": "230071104",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "我所想要的这种泥土，想必也不是随随便便就能够做好的吧…",
            "nextDialogs": [
              "230071105"
            ]
          },
          "230071105": {
            "id": "230071105",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "非常谢谢你帮忙。这里是你的报酬，还请你收下。",
            "nextDialogs": [
              "230071106"
            ]
          },
          "230071106": {
            "id": "230071106",
            "speakerId": 1000,
            "speakerName": "阿金",
            "text": "之后，再尝试一些其他的选择吧…"
          }
        }
      }
    },

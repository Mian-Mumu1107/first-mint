          },
          "709170102": {
            "id": "709170102",
            "speakerId": 1642,
            "speakerName": "萨义德",
            "text": "我前段时间在研究蒙德的一些历史传说，幸好图书馆有不少史料书籍可以参考。",
            "nextDialogs": [
              "709170103"
            ]
          },
          "709170103": {
            "id": "709170103",
            "speakerId": 1642,
            "speakerName": "萨义德",
            "text": "在蒙德的诸多传说与传记中，我最感兴趣的应该就是这本《温妮莎传奇》了吧。",
            "nextDialogs": [
              "709170104"
            ]
          },
          "709170104": {
            "id": "709170104",
            "speakerId": 1642,
            "speakerName": "萨义德",
            "text": "这种反抗暴政与不公的勇气，或许就是蒙德的自由精神的写照吧，即便是外乡人如我也深受感动…",
            "nextDialogs": [
              "709170105"
            ]
          },
          "709170105": {
            "id": "709170105",
            "speakerId": 1642,
            "speakerName": "萨义德",
            "text": "近期我研究的重心已经放在蒙德的诗歌上了，这本书已经用不到了…看完了以后记得放回图书馆就好。"
          }
        }
      }

    {
      "subId": "7320703",
      "subQuestName": "「唤醒」种子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732070321"
        ],
        "dialogs": {
          "732070321": {
            "id": "732070321",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "静静等待了片刻之后，幼芽慢慢从土里冒了出来…",
            "nextDialogs": [
              "732070301"
            ]
          },
          "732070301": {
            "id": "732070301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "赛芭的方法真的有效！",
            "nextDialogs": [
              "732070302"
            ]
          },
          "732070302": {
            "id": "732070302",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "终于发芽了，终于…",
            "nextDialogs": [
              "732070303"
            ]
          },
          "732070303": {
            "id": "732070303",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "看来，那位沙法卡特先生生前许下的心愿能够被实现了。",
            "nextDialogs": [
              "732070304"
            ]
          },
          "732070304": {
            "id": "732070304",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "阿凡老先生，你之前告诉我，这种蔷薇是由他培育出来的。",
            "nextDialogs": [
              "732070305"
            ]
          },
          "732070305": {
            "id": "732070305",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "能培育出新品种，他和我一样，也是被驱逐到这里的学者对吗？",
            "nextDialogs": [
              "732070306"
            ]
          },
          "732070306": {
            "id": "732070306",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "…是的。他被流放到了这个村子，在我们身后的屋子里度过了一生。",
            "nextDialogs": [
              "732070307"
            ]
          },
          "732070307": {
            "id": "732070307",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "是这样啊，的确，既然成为了流放者，最后的结局都会如此吧。",
            "nextDialogs": [
              "732070308"
            ]
          },
          "732070308": {
            "id": "732070308",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "说起来，培育新品种是只有顶尖学者才办得到的事。",
            "nextDialogs": [
              "732070309"
            ]
          },
          "732070309": {
            "id": "732070309",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "他这样的人，就这么籍籍无名地消失在教令院之外的地方，真是可惜。",
            "nextDialogs": [
              "732070310"
            ]
          },
          "732070310": {
            "id": "732070310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "赛芭是想到了自己的将来吗…",
            "nextDialogs": [
              "732070311"
            ]
          },
          "732070311": {
            "id": "732070311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请振作起来。",
            "nextDialogs": [
              "732070312"
            ]
          },
          "732070312": {
            "id": "732070312",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "是啊，孩子，你还有很长的路要走，还有很多事可以做。",
            "nextDialogs": [
              "732070313"
            ]
          },
          "732070313": {
            "id": "732070313",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "不要被感伤困住，我可不想看到第二个鬼老头出现。",
            "nextDialogs": [
              "732070317"
            ]
          },
          "732070317": {
            "id": "732070317",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "说的也是，我怎么在这种开心的时候伤感起来了，我们说正事吧。",
            "nextDialogs": [
              "732070318"
            ]
          },
          "732070318": {
            "id": "732070318",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "现在这些金蔷薇还只是发了芽，还没有开花。我想一直见证到金蔷薇盛开，你们呢？",
            "nextDialogs": [
              "732070319"
            ]
          },
          "732070319": {
            "id": "732070319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我也是。",
            "nextDialogs": [
              "732070320"
            ]
          },
          "732070320": {
            "id": "732070320",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "那我们多等些时间，让它们汲取一点养分，过一段时间再一起来见证它们盛开吧。"
          }
        }
      }
    },
    {
      "subId": "7320710",
      "subQuestName": "（test）对话中发芽$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7320705",
      "subQuestName": "「唤醒」种子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732070501"
        ],
        "dialogs": {
          "732070501": {
            "id": "732070501",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "「蔷薇啊蔷薇，实现我的愿望。」",
            "nextDialogs": [
              "732070502"
            ]
          },
          "732070502": {
            "id": "732070502",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "「花从石头中绽放，金蔷薇对我歌唱。」",
            "nextDialogs": [
              "732070503"
            ]
          },
          "732070503": {
            "id": "732070503",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "「她唱：」",
            "nextDialogs": [
              "732070504"
            ]
          },
          "732070504": {
            "id": "732070504",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "「没有土地承载我，唯有歌谣承载我。」",
            "nextDialogs": [
              "732070505"
            ]
          },
          "732070505": {
            "id": "732070505",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "「歌谣战胜敌视我的命运，战胜我的结局。」",
            "nextDialogs": [
              "732070506"
            ]
          },
          "732070506": {
            "id": "732070506",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "「战胜我战胜时间，战胜永不消逝的消逝。」",
            "nextDialogs": [
              "732070507"
            ]
          },
          "732070507": {
            "id": "732070507",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "这就是沙法卡特叔叔以前教给我们的歌谣。"
          }
        }
      }
    },
    {
      "subId": "7320704",
      "subQuestName": "「唤醒」种子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732070401"
        ],
        "dialogs": {
          "732070401": {
            "id": "732070401",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "试着<color=#00E1FFFF>钝击</color>打破种子的石质外壳吧，然后再用<color=#00E1FFFF>草元素</color>的力量「唤醒」它们。"
          }
        }
      }
    },
    {
      "subId": "7320306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732030602"
        ],
        "dialogs": {
          "732030602": {
            "id": "732030602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是我采到的须弥蔷薇。",
            "nextDialogs": [
              "732030603"
            ]
          },
          "732030603": {
            "id": "732030603",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "多让人怀念的花，给你的礼物我也准备好了，你拿着吧。",
            "nextDialogs": [
              "732030604"
            ]
          },
          "732030604": {
            "id": "732030604",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "都是无法在这里生长发芽的植物种子，如果你在别处有宅院的话，就能看它们长大了。",
            "nextDialogs": [
              "732030605"
            ]
          },
          "732030605": {
            "id": "732030605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是哪个学派的学者？",
            "nextDialogs": [
              "732030606"
            ]
          },
          "732030606": {
            "id": "732030606",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "想聊聊我的学派？我能说上三天三夜都不停，哈哈。",
            "nextDialogs": [
              "732030607"
            ]
          },
          "732030607": {
            "id": "732030607",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "我以前属于生论派，专攻植物演化，算是一门实证研究学科吧。",
            "nextDialogs": [
              "732030608"
            ]
          },
          "732030608": {
            "id": "732030608",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "这意味着没有新材料就很难发现新结论，你可以简单理解成：要考察过去的植物，历史标本是研究基础。",
            "nextDialogs": [
              "732030609"
            ]
          },
          "732030609": {
            "id": "732030609",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "但是便于搜集的标本就那么多，它们基本上都被搜罗得差不多了，教令院能提供的新标本有限。",
            "nextDialogs": [
              "732030610"
            ]
          },
          "732030610": {
            "id": "732030610",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "客观条件就是这样，但院内还是在不断要求研究指标。",
            "nextDialogs": [
              "732030611"
            ]
          },
          "732030611": {
            "id": "732030611",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "有人就把以前的研究成果拿出来，改一改凑一凑，也算交差了。你肯定也觉得这样很没意思对吧？",
            "nextDialogs": [
              "732030612"
            ]
          },
          "732030612": {
            "id": "732030612",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "其实我们完全可以尝试从历史地理的角度，找一找新材料，这样一定能有新发现。",
            "nextDialogs": [
              "732030613"
            ]
          },
          "732030613": {
            "id": "732030613",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "一些不受生论派重视的文学材料也是可以利用的。不过这样的话，难免要涉及因论派和知论派的领域了。",
            "nextDialogs": [
              "732030614"
            ]
          },
          "732030614": {
            "id": "732030614",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "我并不具备那些领域的知识，申请相关「知识」的手续又太麻烦，和相关领域的学者合作更是难上加难…",
            "nextDialogs": [
              "732030615"
            ]
          },
          "732030615": {
            "id": "732030615",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "但是我相信，如果我们能做到跨学科合作的话，过去的很多问题就可以得到突破性进展。",
            "nextDialogs": [
              "732030616"
            ]
          },
          "732030616": {
            "id": "732030616",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "只是可惜这样的尝试没能进行下去，因论派和知论派的怪人们讨论事情的角度特别…嗯…奇妙。",
            "nextDialogs": [
              "732030617"
            ]
          },
          "732030617": {
            "id": "732030617",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "我交给他们的提案里，所有的措辞都得仔细斟酌，要不然就会出现误会。",
            "nextDialogs": [
              "732030618"
            ]
          },
          "732030618": {
            "id": "732030618",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "被赶出教令院之前，我还在跟一个知论派的家伙吵架。现在好了，想找他们吵架也难了…",
            "nextDialogs": [
              "732030625"
            ]
          },
          "732030625": {
            "id": "732030625",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "你看我，一下说了好多话，好畅快。",
            "nextDialogs": [
              "732030626"
            ]
          },
          "732030626": {
            "id": "732030626",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "你来之前，我在这里没什么朋友，其实有些寂寞。",
            "nextDialogs": [
              "732030629"
            ]
          },
          "732030629": {
            "id": "732030629",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "整个村子里，有闲心种花的人很少。",
            "nextDialogs": [
              "732030630"
            ]
          },
          "732030630": {
            "id": "732030630",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "嗯…这样说不准确，村子北面，也有位老爷爷开垦出了一片苗圃，拿来种花。",
            "nextDialogs": [
              "732030631"
            ]
          },
          "732030631": {
            "id": "732030631",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "我去看望过他，是个有点奇怪的老人。",
            "nextDialogs": [
              "732030632"
            ]
          },
          "732030632": {
            "id": "732030632",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "种下的明明是「石头」，却非说自己在种花，还把我赶走了。",
            "nextDialogs": [
              "732030633"
            ]
          },
          "732030633": {
            "id": "732030633",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "一个人生活也有点寂寞吧，我能理解那种心情。",
            "nextDialogs": [
              "732030634"
            ]
          },
          "732030634": {
            "id": "732030634",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "你能帮我的须弥蔷薇开花，说不定也能帮帮他。",
            "nextDialogs": [
              "732030635"
            ]
          },
          "732030635": {
            "id": "732030635",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "如果有机会的话，你和派蒙也可以去看看他。",
            "nextDialogs": [
              "732030619"
            ]
          },
          "732030619": {
            "id": "732030619",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿如村的生活怎么样？",
            "nextDialogs": [
              "732030620"
            ]
          },
          "732030620": {
            "id": "732030620",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "还算可以。有饭吃，有地方住，基本生活能得到保证就已经很不错了。",
            "nextDialogs": [
              "732030621"
            ]
          },
          "732030621": {
            "id": "732030621",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "毕竟是被驱逐到这里来的人，我当然不能奢求藏书和研究器材。",
            "nextDialogs": [
              "732030622"
            ]
          },
          "732030622": {
            "id": "732030622",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "而且从以前开始，这个村子就是教令院放逐学者的地方，生存条件和研究条件都无法和须弥城相比，自然也不会有什么学术氛围。",
            "nextDialogs": [
              "732030623"
            ]
          },
          "732030623": {
            "id": "732030623",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "我不是第一个流放者，可能也不会是最后一个。",
            "nextDialogs": [
              "732030624"
            ]
          },
          "732030624": {
            "id": "732030624",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "来都来了，习惯就好。只能这么想了。"
          }
        }
      }
    },
    {
      "subId": "7320307",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732030701"
        ],
        "dialogs": {
          "732030701": {
            "id": "732030701",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "来找我聊天了吗？我可攒了一肚子的话。"
          }
        }
      }
    },

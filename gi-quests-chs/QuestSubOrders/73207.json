    {
      "subId": "7320706",
      "subQuestName": "(test)73206与阿凡闲聊$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732060601"
        ],
        "dialogs": {
          "732060601": {
            "id": "732060601",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "沙法卡特叔叔，你最后的一点心愿我没法替你完成了…",
            "nextDialogs": [
              "732060603",
              "732060610"
            ]
          },
          "732060603": {
            "id": "732060603",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "你们之前不是还缠着我问鬼老头的事吗，其实鬼老头原来也不叫鬼老头，毕竟哪有人真名就叫这个的。",
            "nextDialogs": [
              "732060604"
            ]
          },
          "732060604": {
            "id": "732060604",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "听我的长辈说，他原来叫沙法卡特，年轻的时候就从须弥城离开，到了我们村。",
            "nextDialogs": [
              "732060605"
            ]
          },
          "732060605": {
            "id": "732060605",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "他来之后盖了这间小屋一个人住，后来几十年里几乎都没离开。",
            "nextDialogs": [
              "732060606"
            ]
          },
          "732060606": {
            "id": "732060606",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "我是没见过他年轻时候的样子，不过据说他那会儿还不怎么讨厌小孩。",
            "nextDialogs": [
              "732060607"
            ]
          },
          "732060607": {
            "id": "732060607",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "他家的屋前屋后又种了很多花和树，很多孩子都喜欢往他那里跑，跟他要枣椰吃，听他说话。",
            "nextDialogs": [
              "732060608"
            ]
          },
          "732060608": {
            "id": "732060608",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "但我见到他的时候，他已经老了，被人叫作鬼老头，变得讨厌小孩子。",
            "nextDialogs": [
              "732060621"
            ]
          },
          "732060621": {
            "id": "732060621",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一定还有办法。",
            "nextDialogs": [
              "732060622"
            ]
          },
          "732060622": {
            "id": "732060622",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "还能有什么办法呢？",
            "nextDialogs": [
              "732060623"
            ]
          },
          "732060623": {
            "id": "732060623",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "沙法卡特叔叔…也就是鬼老头，早就安安静静地离开了，要不是这样，我还能去问一问这蔷薇有什么栽种的特殊方法。",
            "nextDialogs": [
              "732060624"
            ]
          },
          "732060624": {
            "id": "732060624",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "现在我还能去问谁呢。",
            "nextDialogs": [
              "732060625"
            ]
          },
          "732060625": {
            "id": "732060625",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我认识一位生论派的学者赛芭。",
            "nextDialogs": [
              "732060626"
            ]
          },
          "732060626": {
            "id": "732060626",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "哦，你是说那个外来的姑娘啊。她能帮上忙吗？",
            "nextDialogs": [
              "732060627"
            ]
          },
          "732060627": {
            "id": "732060627",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "再说，她之前路过我这里，被我说了几句给呛跑了。她还会愿意帮忙吗？",
            "nextDialogs": [
              "732060628"
            ]
          },
          "732060628": {
            "id": "732060628",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会试试。",
            "nextDialogs": [
              "732060629"
            ]
          },
          "732060629": {
            "id": "732060629",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "你是个很好的孩子，如果找不到能帮忙的人也没关系，有你这些心意就够了。"
          },
          "732060610": {
            "id": "732060610",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "我们村里，时不时就会有些外来的人迫不得己，在这里定居。",
            "nextDialogs": [
              "732060611"
            ]
          },
          "732060611": {
            "id": "732060611",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "有的人哪怕一直勉强自己，都始终不能习惯这里的生活，最后孤独一辈子。",
            "nextDialogs": [
              "732060612"
            ]
          },
          "732060612": {
            "id": "732060612",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "可能鬼老头…也就是沙法卡特叔叔，算其中之一吧，长期以来，大家都习惯这种事了。",
            "nextDialogs": [
              "732060613"
            ]
          },
          "732060613": {
            "id": "732060613",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "但不管多少年，我还是不愿意习惯这种事。他实在是太可惜了…",
            "nextDialogs": [
              "732060614"
            ]
          },
          "732060614": {
            "id": "732060614",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "他那座小花园你要是看到也会喜欢的，各种颜色的花，还有高高低低的树…",
            "nextDialogs": [
              "732060615"
            ]
          },
          "732060615": {
            "id": "732060615",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "打理出这么一座小花园的人就那么无声无息的不在了，关于他，大家只记得鬼老头会抓走调皮的小孩。",
            "nextDialogs": [
              "732060616"
            ]
          },
          "732060616": {
            "id": "732060616",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "我就是不乐意接受这种事，他留下的手记里写了他想让这些蔷薇到处长，我就是想实现他的心愿。",
            "nextDialogs": [
              "732060617"
            ]
          },
          "732060617": {
            "id": "732060617",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "反正我这一把年纪，别人怎么看我都无所谓，能做好这件事我就算没有白活。",
            "nextDialogs": [
              "732060618"
            ]
          },
          "732060618": {
            "id": "732060618",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "屋子我给他收拾好了，他留下来的一大堆小册子我也分类整理好了。",
            "nextDialogs": [
              "732060619"
            ]
          },
          "732060619": {
            "id": "732060619",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "你感兴趣的话，我可以拿一册出来给你瞧瞧。",
            "nextDialogs": [
              "732060620"
            ]
          },
          "732060620": {
            "id": "732060620",
            "speakerId": 4233,
            "speakerName": "阿凡",
            "text": "我就放在<color=#00E1FFFF>屋前</color>吧，让这手记里的他也见见太阳。"
          }
        }
      }
    },
    {
      "subId": "7320708",
      "subQuestName": "(test)向赛芭寻求帮助$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732060402"
        ],
        "dialogs": {
          "732060402": {
            "id": "732060402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于阿凡…",
            "nextDialogs": [
              "732060403"
            ]
          },
          "732060403": {
            "id": "732060403",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "嗯？什么样的问题呢？",
            "nextDialogs": [
              "732060404"
            ]
          },
          "732060404": {
            "id": "732060404",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "把阿凡遇到的困难告诉了赛芭。",
            "nextDialogs": [
              "732060405"
            ]
          },
          "732060405": {
            "id": "732060405",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "原来如此，所以你来向我求援了啊。",
            "nextDialogs": [
              "732060406"
            ]
          },
          "732060406": {
            "id": "732060406",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "虽然在这种时候你能想起我，对我来说是很荣幸的事。",
            "nextDialogs": [
              "732060407"
            ]
          },
          "732060407": {
            "id": "732060407",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "不过我毕竟不是专攻物种培育的学者，我的经验也很有限，不能保证一定帮上忙。",
            "nextDialogs": [
              "732060408"
            ]
          },
          "732060408": {
            "id": "732060408",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "但我会努力试试的，更何况你说的那位培育出新品种蔷薇的先生也让人很感兴趣。",
            "nextDialogs": [
              "732060409"
            ]
          },
          "732060409": {
            "id": "732060409",
            "speakerId": 4232,
            "speakerName": "赛芭",
            "text": "等我有空的时候就会去阿凡老先生的苗圃，之后去那里找我吧。"
          }
        }
      }
    },

        ],
        "dialogs": {
          "722051601": {
            "id": "722051601",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "河的另一边呀…是金的橡树、金的…什么来着…",
            "nextDialogs": [
              "722051602"
            ]
          },
          "722051602": {
            "id": "722051602",

            "id": "722050501",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "在这里又见面了！",
            "nextDialogs": [
              "722050502"
            ]
          },
          "722050502": {
            "id": "722050502",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "又见面啦！",
            "nextDialogs": [
              "722050505"
            ]
          },
          "722050505": {
            "id": "722050505",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "#嘿嘿，我还在这里呢！说起来，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}知道这些大石头是做什么的吗？",
            "nextDialogs": [
              "722050506"
            ]
          },
          "722050506": {
            "id": "722050506",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "哼哼，木户哥哥什么都知道哦！"
          }
        }
      }
    },
    {
      "subId": "7220506",
      "subQuestName": "跟孙女对话（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722050601"
        ],
        "dialogs": {
          "722050601": {
            "id": "722050601",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "在别的岛上，也有荧光色的大蘑菇吗？",
            "nextDialogs": [

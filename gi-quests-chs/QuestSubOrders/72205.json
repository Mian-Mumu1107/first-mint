  "subQuests": [
    {
      "subId": "7220501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722050101"
        ],
        "dialogs": {
          "722050101": {
            "id": "722050101",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "唔，奇怪呀…明明就在口袋里的…",
            "nextDialogs": [
              "722050104"
            ]
          },
          "722050104": {
            "id": "722050104",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "没有的话可不行呀…是要带给宇奈婆婆的哟…",
            "nextDialogs": [
              "722050105"
            ]
          },
          "722050105": {
            "id": "722050105",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "宇奈婆婆岁数大了，好多事情都记不清了…最近又开始念叨起了年轻时的事情。",
            "nextDialogs": [
              "722050106"
            ]
          },
          "722050106": {
            "id": "722050106",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "她呀，总是在说着「花」呀「花」的…还说，那是雾海外的花，颜色不同的好看的花…",
            "nextDialogs": [
              "722050107"
            ]
          },
          "722050107": {
            "id": "722050107",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "然后有一天，我做了一个梦…我梦见岛上的雾「哇」地一下全都消散了，海的另一边立起了高高大大好漂亮的屋子…不是木头的，也不是金子的…",
            "nextDialogs": [
              "722050108"
            ]
          },
          "722050108": {
            "id": "722050108",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "我也是呢，我也是呢！",
            "nextDialogs": [
              "722050109"
            ]
          },
          "722050109": {
            "id": "722050109",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "在那个梦里面呀，我登上高高的山，爬上大大的树，摘了好多好多好看的花…虽然没有见过，但我知道那就是宇奈婆婆想要的花…",
            "nextDialogs": [
              "722050110"
            ]
          },
          "722050110": {
            "id": "722050110",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "可是花太多太重，我就从树上掉了下来，一直掉呀，一直掉呀…然后，梦就醒了。",
            "nextDialogs": [
              "722050111"
            ]
          },
          "722050111": {
            "id": "722050111",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "哼，还不是因为你太贪心！我都说了好多遍足够啦、足够啦！结果连累我也一同掉了下去…",
            "nextDialogs": [
              "722050112"
            ]
          },
          "722050112": {
            "id": "722050112",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "口袋里空空的…什么都没有了…就这样怎么回去见宇奈婆婆呀…"
          }
        }
      }
    },
    {
      "subId": "7220502",
      "subQuestName": "跟孙女对话（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722050201"
        ],
        "dialogs": {
          "722050201": {
            "id": "722050201",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "怎么办才好…",
            "nextDialogs": [
              "722050202"
            ]
          },
          "722050202": {
            "id": "722050202",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "想想办法呀…"
          }
        }
      }
    },
    {
      "subId": "7220503",
      "subQuestName": "跟孙女对话（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722051301"
        ],
        "dialogs": {
          "722051301": {
            "id": "722051301",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "就是这些花！和我梦里一模一样呢！",
            "nextDialogs": [
              "722051302"
            ]
          },
          "722051302": {
            "id": "722051302",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "#谢谢你，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！",
            "nextDialogs": [
              "722051303"
            ]
          },
          "722051303": {
            "id": "722051303",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "木户哥哥，等看完宇奈奶奶，我们去东边的海滩玩吧！在那边能看见青来神祠呢！",
            "nextDialogs": [
              "722051304"
            ]
          },
          "722051304": {
            "id": "722051304",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "是「千来神祠」啦…"
          }
        }
      }
    },
    {
      "subId": "7220512",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722050301"
        ],
        "dialogs": {
          "722050301": {
            "id": "722050301",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "#你好，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}!",
            "nextDialogs": [
              "722050304"
            ]
          },
          "722050304": {
            "id": "722050304",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "谢谢你上次帮我采来那些花朵！只不过呀…我感觉身边一直怪怪的…",
            "nextDialogs": [
              "722050305"
            ]
          },
          "722050305": {
            "id": "722050305",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "我也是呢，一直都怪怪的…",
            "nextDialogs": [
              "722050306"
            ]
          },
          "722050306": {
            "id": "722050306",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "每次去到不同的地方，都只会遇到不开心的人…大家都听不到别人说话的样子…",
            "nextDialogs": [
              "722050307"
            ]
          },
          "722050307": {
            "id": "722050307",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "而且呀，每次看到漂亮的花朵，摘下放进口袋里之后，就很快不见了…"
          }
        }
      }
    },
    {
      "subId": "7220504",
      "subQuestName": "跟孙女对话（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

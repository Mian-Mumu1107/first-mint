          "722050701"
        ],
        "dialogs": {
          "722050701": {
            "id": "722050701",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，又见面了。",
            "nextDialogs": [
              "722050702"
            ]
          },
          "722050702": {
            "id": "722050702",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "木户哥哥今天不想说话呢…",
            "nextDialogs": [
              "722050705"
            ]
          },
          "722050705": {
            "id": "722050705",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "没事啦…我自己玩就好，不要理我了。",
            "nextDialogs": [
              "722050706"
            ]
          },
          "722050706": {
            "id": "722050706",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}你看，他又这样了…自己一个人生气。"
          }
        }
      }
    },
    {

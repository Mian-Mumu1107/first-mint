        ],
        "dialogs": {
          "722051901": {
            "id": "722051901",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "#谢谢你！辛苦大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}了！",
            "nextDialogs": [
              "722051902"
            ]
          },
          "722051902": {
            "id": "722051902",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "辛苦你啦！",
            "nextDialogs": [
              "722051903"
            ]
          },
          "722051903": {
            "id": "722051903",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "木户哥哥，我知道一个冒险的好地方哦！就在尖命山北边的山窝窝里，很隐秘的！",
            "nextDialogs": [
              "722051904"
            ]
          },
          "722051904": {
            "id": "722051904",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "是「菅名山」啦…"
          }
        }
      }
    },
    {
      "subId": "7220515",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722050901"
        ],
        "dialogs": {
          "722050901": {
            "id": "722050901",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！你好呀！",
            "nextDialogs": [
              "722050902"
            ]
          },
          "722050902": {
            "id": "722050902",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，你好！",
            "nextDialogs": [
              "722050905"
            ]
          },
          "722050905": {
            "id": "722050905",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "谢谢你，但这次我不需要什么啦…我们就要离开这里了，去没有迷雾的地方。",
            "nextDialogs": [
              "722050906"
            ]
          },
          "722050906": {
            "id": "722050906",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "去金闪闪的大屋子！坐船去哦！",
            "nextDialogs": [
              "722050907"
            ]
          },
          "722050907": {
            "id": "722050907",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "不过在走之前，还是要谢谢你…顺便，请把这个交给宇奈婆婆吧。",
            "nextDialogs": [
              "722050908"
            ]
          },
          "722050908": {
            "id": "722050908",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "把这个放在她手里，她就会放心随我们一起来的！",
            "nextDialogs": [
              "722050909"
            ]
          },
          "722050909": {
            "id": "722050909",
            "speakerId": 1000,
            "speakerName": "木户",
            "text": "#最后一次拜托你了，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}。",
            "nextDialogs": [
              "722050910"
            ]
          },
          "722050910": {
            "id": "722050910",
            "speakerId": 1001,
            "speakerName": "木奈",
            "text": "#谢谢你，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}。"
          }
        }
      }
    },

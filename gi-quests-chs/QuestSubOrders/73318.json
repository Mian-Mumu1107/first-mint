    {
      "subId": "7331802",
      "subQuestName": "(test)到达精灵冢附近$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733180201"
        ],
        "dialogs": {
          "733180201": {
            "id": "733180201",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "没想到竟然变成这副模样了…还真是可怜。",
            "nextDialogs": [
              "733180202"
            ]
          },
          "733180202": {
            "id": "733180202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，斯露莎在说什么呢？",
            "nextDialogs": [
              "733180203"
            ]
          },
          "733180203": {
            "id": "733180203",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "没什么，不过是看到了一些同族终末的丑态罢了，不用在意。",
            "nextDialogs": [
              "733180204"
            ]
          },
          "733180204": {
            "id": "733180204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，这种说法反而更让人在意了吧！",
            "nextDialogs": [
              "733180205"
            ]
          },
          "733180205": {
            "id": "733180205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让我看看…哦哦，那边有棵好奇怪的树呢，团成一圈感觉就像是个门一样。",
            "nextDialogs": [
              "733180208"
            ]
          },
          "733180208": {
            "id": "733180208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样一说，有点跃跃欲试起来了！",
            "nextDialogs": [
              "733180209"
            ]
          },
          "733180209": {
            "id": "733180209",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "…这些「灵谷木」可不是什么门扉，若是冒冒失失地穿过去的话，可是会打扰到寄宿在其中的残灵的。",
            "nextDialogs": [
              "733180210"
            ]
          },
          "733180210": {
            "id": "733180210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦，原来是叫「灵谷木」吗？不过你说残灵…明明什么都看不到嘛！",
            "nextDialogs": [
              "733180211"
            ]
          },
          "733180211": {
            "id": "733180211",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "白飘飘当然看不到，毕竟这些残灵还停留在过去的执念当中。",
            "nextDialogs": [
              "733180212"
            ]
          },
          "733180212": {
            "id": "733180212",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "虽说未必是其本心所愿，不过这般执着于世的样子，实在是目不忍视。",
            "nextDialogs": [
              "733180213"
            ]
          },
          "733180213": {
            "id": "733180213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "明明看上去还很茂盛，感觉很亲切呢！",
            "nextDialogs": [
              "733180214"
            ]
          },
          "733180214": {
            "id": "733180214",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "哼，白飘飘知道什么，这些「灵谷木」乃是那些与侵害大地的污秽战斗到最后一刻的花灵，用尽最后的力量所化而成的。",
            "nextDialogs": [
              "733180215"
            ]
          },
          "733180215": {
            "id": "733180215",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "耗尽了力量而无法维持形体，又因为沾染了污秽而被花海所拒绝。",
            "nextDialogs": [
              "733180216"
            ]
          },
          "733180216": {
            "id": "733180216",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "传说在古时矫论团会为她们举行净罪的仪式，使她们得以重回「甘露花海」。",
            "nextDialogs": [
              "733180217"
            ]
          },
          "733180217": {
            "id": "733180217",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "不过如今矫论团早已无人能够主持这样的仪式，至多只能勉力维持这些「灵谷木」不至于枯死罢了。",
            "nextDialogs": [
              "733180218"
            ]
          },
          "733180218": {
            "id": "733180218",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "但这也不过是延长了她们的痛苦，看她们如今的样子，估计除了需要独自忍受的苦痛追忆外，早已什么都不剩了吧。"
          }
        }
      }
    },

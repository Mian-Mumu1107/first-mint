            "id": "230181901",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "你回来了，一切顺利么？",
            "nextDialogs": [
              "230181902"
            ]
          },
          "230181902": {
            "id": "230181902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于肉排…",
            "nextDialogs": [
              "230181903"
            ]
          },
          "230181903": {
            "id": "230181903",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "哦？原来还有这种话术，我还真没想到…",
            "nextDialogs": [
              "230181904"
            ]
          },
          "230181904": {
            "id": "230181904",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "不过，只要阿夫塔能继续正常调理身体就行。",
            "nextDialogs": [
              "230181905"
            ]
          },
          "230181905": {
            "id": "230181905",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "真是太感谢你了，这些报酬还请务必收下。"
          }
        }
      }
    },

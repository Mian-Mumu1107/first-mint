    {
      "subId": "2301812",
      "subQuestName": "与阿兹拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181201"
        ],
        "dialogs": {
          "230181201": {
            "id": "230181201",
            "speakerId": 4064,
            "speakerName": "阿兹拉",
            "text": "咦？这是给我的吗？谢谢你…",
            "nextDialogs": [
              "230181202"
            ]
          },
          "230181202": {
            "id": "230181202",
            "speakerId": 4064,
            "speakerName": "阿兹拉",
            "text": "好！我要再试一次…这一次要一口气把药吃掉！"
          }
        }
      }
    },
    {
      "subId": "2301813",
      "subQuestName": "与扎卡里亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181301"
        ],
        "dialogs": {
          "230181301": {
            "id": "230181301",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "你回来了，一切顺利么？",
            "nextDialogs": [
              "230181302"
            ]
          },
          "230181302": {
            "id": "230181302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我给她送了点糖。",
            "nextDialogs": [
              "230181303"
            ]
          },
          "230181303": {
            "id": "230181303",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "糖？但是那副药和糖一起吃会降低药效啊。",
            "nextDialogs": [
              "230181304"
            ]
          },
          "230181304": {
            "id": "230181304",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "算了，药效低一点就低一点吧，至少她能把药吃完了。",
            "nextDialogs": [
              "230181305"
            ]
          },
          "230181305": {
            "id": "230181305",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "真是太感谢你了，这些报酬还请务必收下。"
          }
        }
      }
    },
    {
      "subId": "2301814",
      "subQuestName": "与扎卡里亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181401"
        ],
        "dialogs": {
          "230181401": {
            "id": "230181401",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "这次的药是要送给农舍的阿夫塔。",
            "nextDialogs": [
              "230181402"
            ]
          },
          "230181402": {
            "id": "230181402",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "这家伙平时吃东西总是大鱼大肉，弄的肠胃很不好。",
            "nextDialogs": [
              "230181403"
            ]
          },
          "230181403": {
            "id": "230181403",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "你就把这副药带给他吧，顺便告诉他…呃…",
            "nextDialogs": [
              "230181404"
            ]
          },
          "230181404": {
            "id": "230181404",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "饮食清淡，少食酒肉，才能更好地承接草神大人的恩泽。",
            "nextDialogs": [
              "230181408",
              "230181407"
            ]
          },
          "230181408": {
            "id": "230181408",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "送完药就回来找我吧，我会准备好报酬的。"
          },
          "230181407": {
            "id": "230181407",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "我听说教令院里确实有学者这么做，我也不知道为什么…"
          }
        }
      }
    },
    {
      "subId": "2301822",
      "subQuestName": "将药带给阿夫塔",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230182201"
        ],
        "dialogs": {
          "230182201": {
            "id": "230182201",
            "speakerId": 4098,
            "speakerName": "阿夫塔",
            "text": "再坚持几天就好…"
          }
        }
      }
    },
    {
      "subId": "2301815",
      "subQuestName": "与阿夫塔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181501"
        ],
        "dialogs": {
          "230181501": {
            "id": "230181501",
            "speakerId": 4098,
            "speakerName": "阿夫塔",
            "text": "嗯？这个药是？",
            "nextDialogs": [
              "230181502"
            ]
          },
          "230181502": {
            "id": "230181502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是你的药。注意保持饮食清淡。",
            "nextDialogs": [
              "230181503"
            ]
          },
          "230181503": {
            "id": "230181503",
            "speakerId": 4098,
            "speakerName": "阿夫塔",
            "text": "唉，好，放心吧。我已经好些天<color=#00E1FFFF>没碰过肉</color>了，这样一定能更好地承接草神大人的恩惠…",
            "nextDialogs": [
              "230181504"
            ]
          },
          "230181504": {
            "id": "230181504",
            "speakerId": 4098,
            "speakerName": "阿夫塔",
            "text": "不过怎么感觉身体还不如以前了呢？唉，一定是时间还不够久…"
          }
        }
      }
    },
    {
      "subId": "2301816",
      "subQuestName": "与扎卡里亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181601"
        ],
        "dialogs": {
          "230181601": {
            "id": "230181601",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "你回来了，一切顺利么？",
            "nextDialogs": [
              "230181602"
            ]
          },
          "230181602": {
            "id": "230181602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他已经有好几天没吃肉了…",
            "nextDialogs": [
              "230181603"
            ]
          },
          "230181603": {
            "id": "230181603",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "什么？我就是叮嘱他吃得相对清淡一点，也没让他完全不吃肉啊！",
            "nextDialogs": [
              "230181604"
            ]
          },
          "230181604": {
            "id": "230181604",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "为了更好地承接草神大人的恩惠？",
            "nextDialogs": [
              "230181605"
            ]
          },
          "230181605": {
            "id": "230181605",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "好吧…我回头得把说法再变一变…",
            "nextDialogs": [
              "230181606"
            ]
          },
          "230181606": {
            "id": "230181606",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "你也辛苦了，这些报酬就请收下吧。"
          }
        }
      }
    },
    {

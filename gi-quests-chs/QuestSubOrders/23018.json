    {
      "subId": "2301818",
      "subQuestName": "与阿夫塔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181801"
        ],
        "dialogs": {
          "230181801": {
            "id": "230181801",
            "speakerId": 4098,
            "speakerName": "阿夫塔",
            "text": "这是？不行…但这气味实在是…",
            "nextDialogs": [
              "230181802"
            ]
          },
          "230181802": {
            "id": "230181802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实是这样的…",
            "nextDialogs": [
              "230181803"
            ]
          },
          "230181803": {
            "id": "230181803",
            "speakerId": 4098,
            "speakerName": "阿夫塔",
            "text": "什么？清淡饮食也可以吃肉？教令院的学者也这么做？",
            "nextDialogs": [
              "230181804"
            ]
          },
          "230181804": {
            "id": "230181804",
            "speakerId": 4098,
            "speakerName": "阿夫塔",
            "text": "原，原来是这样！我还担心我吃肉会惹草神大人不高兴呢。",
            "nextDialogs": [
              "230181805"
            ]
          },
          "230181805": {
            "id": "230181805",
            "speakerId": 4098,
            "speakerName": "阿夫塔",
            "text": "既然学者大人们也这样做…那我就可以放心吃肉了，谢谢你！"
          }
        }
      }
    },
    {
      "subId": "2301819",

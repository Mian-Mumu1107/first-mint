    {
      "subId": "2301806",
      "subQuestName": "与古尔根对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180601"
        ],
        "dialogs": {
          "230180601": {
            "id": "230180601",
            "speakerId": 4080,
            "speakerName": "古尔根",
            "text": "杂草…全都被你清理了？这，这怎么好意思？",
            "nextDialogs": [
              "230180602"
            ]
          },
          "230180602": {
            "id": "230180602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你回去好好休息就行。",
            "nextDialogs": [
              "230180603"
            ]
          },
          "230180603": {
            "id": "230180603",
            "speakerId": 4080,
            "speakerName": "古尔根",
            "text": "我会的，谢谢，愿草神大人护佑你！",
            "nextDialogs": [
              "230180604"
            ]
          },
          "230180604": {
            "id": "230180604",
            "speakerId": 4080,
            "speakerName": "古尔根",
            "text": "我也得快点回去向草神大人默祷了…"
          }
        }
      }
    },
    {
      "subId": "2301807",
      "subQuestName": "与扎卡里亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180701"
        ],
        "dialogs": {
          "230180701": {
            "id": "230180701",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "你回来了，一切顺利么？",
            "nextDialogs": [
              "230180702"
            ]
          },
          "230180702": {
            "id": "230180702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于清理杂草…",
            "nextDialogs": [
              "230180703"
            ]
          },
          "230180703": {
            "id": "230180703",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "啊，那可真不错。这下古尔根他总能好好休息一下了，病情恢复得也会更快一点吧。",
            "nextDialogs": [
              "230180704"
            ]
          },
          "230180704": {
            "id": "230180704",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "真是太感谢你了，这些报酬还请务必收下。"
          }
        }
      }
    },
    {
      "subId": "2301808",
      "subQuestName": "与扎卡里亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180801"
        ],
        "dialogs": {
          "230180801": {
            "id": "230180801",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "这次的药是要送给剧场门口的阿兹拉。",
            "nextDialogs": [
              "230180802"
            ]
          },
          "230180802": {
            "id": "230180802",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "她最近一直在咳嗽，我给她开了药，但她总说太苦不愿意吃。",
            "nextDialogs": [
              "230180803"
            ]
          },
          "230180803": {
            "id": "230180803",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "你帮我把这副药送给她吧，顺便告诉她…呃…",
            "nextDialogs": [
              "230180804"
            ]
          },
          "230180804": {
            "id": "230180804",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "这个…苦涩的药物，是草神对她的…那个…考验，对，考验。",
            "nextDialogs": [
              "230180808",
              "230180807"
            ]
          },
          "230180808": {
            "id": "230180808",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "送完药就回来找我吧，我会准备好报酬的。"
          },
          "230180807": {
            "id": "230180807",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "谈不上学，只能说是耳濡目染吧。"
          }
        }
      }
    },
    {
      "subId": "2301821",
      "subQuestName": "将药带给阿兹拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230182101"
        ],
        "dialogs": {
          "230182101": {
            "id": "230182101",
            "speakerId": 4080,
            "speakerName": "古尔根",
            "text": "唉，身体果然没以前好使唤了…不行，得再坚持一会儿。"
          }
        }
      }
    },
    {
      "subId": "2301809",
      "subQuestName": "与阿兹拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180901"
        ],
        "dialogs": {
          "230180901": {
            "id": "230180901",
            "speakerId": 4064,
            "speakerName": "阿兹拉",
            "text": "呃…好熟悉的气味…",
            "nextDialogs": [
              "230180902"
            ]
          },
          "230180902": {
            "id": "230180902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是你的药，记得要全部吃完…",
            "nextDialogs": [
              "230180903"
            ]
          },
          "230180903": {
            "id": "230180903",
            "speakerId": 4064,
            "speakerName": "阿兹拉",
            "text": "唔，又是这种<color=#00E1FFFF>超苦的药</color>，我不想吃…",
            "nextDialogs": [
              "230180904"
            ]
          },
          "230180904": {
            "id": "230180904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "药的苦涩是草神对你的考验喔。",
            "nextDialogs": [
              "230180905"
            ]
          },
          "230180905": {
            "id": "230180905",
            "speakerId": 4064,
            "speakerName": "阿兹拉",
            "text": "欸？是这样吗？但<color=#00E1FFFF>这药也太苦了</color>，草神大人就不能温柔一些吗…",
            "nextDialogs": [
              "230180906"
            ]
          },
          "230180906": {
            "id": "230180906",
            "speakerId": 4064,
            "speakerName": "阿兹拉",
            "text": "先把药给我吧，我，我等一会再吃…"
          }
        }
      }
    },
    {
      "subId": "2301810",
      "subQuestName": "与扎卡里亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230181001"
        ],
        "dialogs": {
          "230181001": {
            "id": "230181001",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "你回来了，一切顺利么？",
            "nextDialogs": [
              "230181002"
            ]
          },
          "230181002": {
            "id": "230181002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "病人说药的味道太苦了…",
            "nextDialogs": [
              "230181003"
            ]
          },
          "230181003": {
            "id": "230181003",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "这也没什么办法，毕竟草药的成分和性质…咳，有些恩惠就是要吃点苦才能受用的。",
            "nextDialogs": [
              "230181004"
            ]
          },
          "230181004": {
            "id": "230181004",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "希望她真的能把药给全吃掉，上次我就发现她只吃了一点…",
            "nextDialogs": [
              "230181005"
            ]
          },
          "230181005": {
            "id": "230181005",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "你也辛苦了，这些报酬就请收下吧。"
          }
        }
      }
    },
    {

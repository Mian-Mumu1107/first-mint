  "subQuests": [
    {
      "subId": "2301801",
      "subQuestName": "与扎卡里亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180101"
        ],
        "dialogs": {
          "230180101": {
            "id": "230180101",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "唉，真不让人省心…",
            "nextDialogs": [
              "230180119",
              "230180104"
            ]
          },
          "230180119": {
            "id": "230180119",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "最近我们的人手实在是不够，我已经连续几天没休息了。",
            "nextDialogs": [
              "230180120"
            ]
          },
          "230180120": {
            "id": "230180120",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "旅行者，你如果有空的话，可以帮我送药给附近的病人吗？也请一并看看他们的状况。"
          },
          "230180104": {
            "id": "230180104",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "你是旅行者吧，这里是「健康之家」，是一家为普罗大众…嗯…广布草神恩泽的医院。",
            "nextDialogs": [
              "230180105"
            ]
          },
          "230180105": {
            "id": "230180105",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "无论贫富，我们都会为需要的人提供医疗帮助。",
            "nextDialogs": [
              "230180106"
            ]
          },
          "230180106": {
            "id": "230180106",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "不过也拜此所赐…最近来就诊的病人太多，实在有些忙不过来了。",
            "nextDialogs": [
              "230180107"
            ]
          },
          "230180107": {
            "id": "230180107",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "唉，就算草神对我们的仁慈是无限的…但医院的预算和人力却是有限的啊。",
            "nextDialogs": [
              "230180108"
            ]
          },
          "230180108": {
            "id": "230180108",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "有一些病人压根不听医嘱，只是一个劲地问我，他该怎么样才能更好地承接草神恩泽。",
            "nextDialogs": [
              "230180109"
            ]
          },
          "230180109": {
            "id": "230180109",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "哈哈，草神恩泽…看在老天的份上！",
            "nextDialogs": [
              "230180110"
            ]
          },
          "230180110": {
            "id": "230180110",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "要是草神真的能直接降下恩泽，他们压根就不会得病了！",
            "nextDialogs": [
              "230180111"
            ]
          },
          "230180111": {
            "id": "230180111",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "…呼，抱歉，我不该说这样的话，你可别告诉戈尔珊，不然她又要开始唠叨了。"
          }
        }
      }
    },
    {
      "subId": "2301802",
      "subQuestName": "与扎卡里亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180201"
        ],
        "dialogs": {
          "230180201": {
            "id": "230180201",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "这次的药是要送给药田的古尔根。",
            "nextDialogs": [
              "230180202"
            ]
          },
          "230180202": {
            "id": "230180202",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "这位老兄前几天工作得太用力，把自己的胳膊给拉伤了。",
            "nextDialogs": [
              "230180203"
            ]
          },
          "230180203": {
            "id": "230180203",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "你就把这副药送给他，顺便告诉他，今天在家里向草神大人默祷吧，不要下地干活了。",
            "nextDialogs": [
              "230180207",
              "230180206"
            ]
          },
          "230180207": {
            "id": "230180207",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "送完药就回来找我吧，我会准备好报酬的。"
          },
          "230180206": {
            "id": "230180206",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "我不这么说，他怎么可能会听？好了，你就按我说的来做吧。"
          }
        }
      }
    },
    {
      "subId": "2301820",
      "subQuestName": "将药带给古尔根",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230182001"
        ],
        "dialogs": {
          "230182001": {
            "id": "230182001",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "送药的事情就拜托了，切记药和医嘱都要送到。"
          }
        }
      }
    },
    {
      "subId": "2301803",
      "subQuestName": "与古尔根对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180301"
        ],
        "dialogs": {
          "230180301": {
            "id": "230180301",
            "speakerId": 4080,
            "speakerName": "古尔根",
            "text": "咦？这个是…",
            "nextDialogs": [
              "230180302"
            ]
          },
          "230180302": {
            "id": "230180302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是你的药，记得在家里向草神大人默祷。",
            "nextDialogs": [
              "230180303"
            ]
          },
          "230180303": {
            "id": "230180303",
            "speakerId": 4080,
            "speakerName": "古尔根",
            "text": "欸，多谢你了。向草神大人默祷啊…这确实必须要做…",
            "nextDialogs": [
              "230180304"
            ]
          },
          "230180304": {
            "id": "230180304",
            "speakerId": 4080,
            "speakerName": "古尔根",
            "text": "但<color=#00E1FFFF>田里的杂草</color>这么多，再不收拾一下，就要影响收成了。",
            "nextDialogs": [
              "230180305"
            ]
          },
          "230180305": {
            "id": "230180305",
            "speakerId": 4080,
            "speakerName": "古尔根",
            "text": "唔…我就先去<color=#00E1FFFF>把杂草处理</color>了，再回去向草神大人默祷吧。"
          }
        }
      }
    },
    {
      "subId": "2301804",
      "subQuestName": "与扎卡里亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230180401"
        ],
        "dialogs": {
          "230180401": {
            "id": "230180401",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "你回来了，一切顺利么？",
            "nextDialogs": [
              "230180402"
            ]
          },
          "230180402": {
            "id": "230180402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他要先去处理杂草…",
            "nextDialogs": [
              "230180403"
            ]
          },
          "230180403": {
            "id": "230180403",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "唉，这种说法也不行吗…下次还得换个说法…",
            "nextDialogs": [
              "230180404"
            ]
          },
          "230180404": {
            "id": "230180404",
            "speakerId": 4071,
            "speakerName": "扎卡里亚",
            "text": "你也辛苦了，这些报酬就请收下吧。"
          }
        }
      }
    },
    {

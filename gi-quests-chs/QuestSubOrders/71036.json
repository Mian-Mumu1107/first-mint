    {
      "subId": "7103602",
      "subQuestName": "与志琼对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710360201"
        ],
        "dialogs": {
          "710360201": {
            "id": "710360201",
            "speakerId": 1000,
            "speakerName": "志琼",
            "text": "#你好！{NICKNAME}前辈，最近过得怎样！",
            "nextDialogs": [
              "710360203",
              "710360205"
            ]
          },
          "710360203": {
            "id": "710360203",
            "speakerId": 1000,
            "speakerName": "志琼",
            "text": "谢谢关心，我已经没什么问题了。实在抱歉之前让大家费心。",
            "nextDialogs": [
              "710360206"
            ]
          },
          "710360206": {
            "id": "710360206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼，志琼你就不要到处乱跑啦！免得又像上次一样…",
            "nextDialogs": [
              "710360207"
            ]
          },
          "710360207": {
            "id": "710360207",
            "speakerId": 1000,
            "speakerName": "志琼",
            "text": "不会的，不会的。多亏了前辈的努力，层岩巨渊已经安全了许多。地质特征也变得…唔，稳定了许多。",
            "nextDialogs": [
              "710360208"
            ]
          },
          "710360208": {
            "id": "710360208",
            "speakerId": 1000,
            "speakerName": "志琼",
            "text": "不过瑾武姐和海迪夫还需要进一步分析那块神秘晶体的…那个…",
            "nextDialogs": [
              "710360209"
            ]
          },
          "710360209": {
            "id": "710360209",
            "speakerId": 1000,
            "speakerName": "志琼",
            "text": "唔，波长？海迪夫是这么说的，大概又是须弥的奇怪术语吧…总之，首先需要安置信标才能取得数据。",
            "nextDialogs": [
              "710360210"
            ]
          },
          "710360210": {
            "id": "710360210",
            "speakerId": 1000,
            "speakerName": "志琼",
            "text": "瑾武姐最近终于腾出空来把信标组装齐全了，我需要把它们安置在几个特定地点来读取读数。",
            "nextDialogs": [
              "710360211"
            ]
          },
          "710360211": {
            "id": "710360211",
            "speakerId": 1000,
            "speakerName": "志琼",
            "text": "隔一段时间后再前去回收，回收的数据就可以留给海迪夫去运算了。",
            "nextDialogs": [
              "710360212"
            ]
          },
          "710360212": {
            "id": "710360212",
            "speakerId": 1000,
            "speakerName": "志琼",
            "text": "之前由于很多区域都不安全，我们只能局限在营地内进行读数测算…",
            "nextDialogs": [
              "710360213"
            ]
          },
          "710360213": {
            "id": "710360213",
            "speakerId": 1000,
            "speakerName": "志琼",
            "text": "但现在既然通路被前辈打开了，用信标进行实地测量也就能得到更准确的数据了。",
            "nextDialogs": [
              "710360214"
            ]
          },
          "710360214": {
            "id": "710360214",
            "speakerId": 1000,
            "speakerName": "志琼",
            "text": "呼…有点事情做还是比闲着好。对了，前辈如果没有其他事情的话也请跟我一起来吧！"
          },
          "710360205": {
            "id": "710360205",
            "speakerId": 1000,
            "speakerName": "志琼",
            "text": "我还好啦…唔，也不怎么样就是了，冒险的风头都让前辈你出尽了，哈哈。"
          }
        }
      }
    },

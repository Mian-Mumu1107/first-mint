    {
      "subId": "7351301",
      "subQuestName": "与两位学者对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735130101"
        ],
        "dialogs": {
          "735130101": {
            "id": "735130101",
            "speakerId": 1000,
            "speakerName": "施芮娅",
            "text": "…所以说为什么连铆钉也要订制！根本不能提高几点性能吧？",
            "nextDialogs": [
              "735130102"
            ]
          },
          "735130102": {
            "id": "735130102",
            "speakerId": 1001,
            "speakerName": "维纳亚克",
            "text": "——铆接装甲可是妙论派的浪漫啊！",
            "nextDialogs": [
              "735130103"
            ]
          },
          "735130103": {
            "id": "735130103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们…这是从昨天算账到现在？",
            "nextDialogs": [
              "735130104"
            ]
          },
          "735130104": {
            "id": "735130104",
            "speakerId": 1001,
            "speakerName": "维纳亚克",
            "text": "啊，你们已经来了吗？倒也不算，其实经费的问题昨天已经辩论完了。",
            "nextDialogs": [
              "735130105"
            ]
          },
          "735130105": {
            "id": "735130105",
            "speakerId": 1000,
            "speakerName": "施芮娅",
            "text": "呼…刚刚是在争论其它问题，只是不知不觉，就又绕回经费了…",
            "nextDialogs": [
              "735130106"
            ]
          },
          "735130106": {
            "id": "735130106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其他问题？",
            "nextDialogs": [
              "735130107"
            ]
          },
          "735130107": {
            "id": "735130107",
            "speakerId": 1001,
            "speakerName": "维纳亚克",
            "text": "我连零件的接缝都打磨到发亮了，施芮娅这家伙，居然想中止计划！",
            "nextDialogs": [
              "735130108"
            ]
          },
          "735130108": {
            "id": "735130108",
            "speakerId": 1000,
            "speakerName": "施芮娅",
            "text": "不是中止！只是暂缓！",
            "nextDialogs": [
              "735130109"
            ]
          },
          "735130109": {
            "id": "735130109",
            "speakerId": 1000,
            "speakerName": "施芮娅",
            "text": "你没发现环境参数好像有点不对劲吗？就这么继续铺设的话，装置的充能效率会远低于预期。",
            "nextDialogs": [
              "735130110"
            ]
          },
          "735130110": {
            "id": "735130110",
            "speakerId": 1000,
            "speakerName": "施芮娅",
            "text": "我们得先搞清楚这片区域到底发生了什么，排除掉所有影响因素，然后再按计划组装…",
            "nextDialogs": [
              "735130111"
            ]
          },
          "735130111": {
            "id": "735130111",
            "speakerId": 1001,
            "speakerName": "维纳亚克",
            "text": "理想环境和实际环境对不上的情况多了去吧，没必要这么斤斤计较。",
            "nextDialogs": [
              "735130112"
            ]
          },
          "735130112": {
            "id": "735130112",
            "speakerId": 1001,
            "speakerName": "维纳亚克",
            "text": "我在出图纸的时候就考虑过容错范围，这点影响根本不算什么。",
            "nextDialogs": [
              "735130113"
            ]
          },
          "735130113": {
            "id": "735130113",
            "speakerId": 1001,
            "speakerName": "维纳亚克",
            "text": "何况有些时候就得先上手实验过了，才能发现问题出在哪里啊。",
            "nextDialogs": [
              "735130114"
            ]
          },
          "735130114": {
            "id": "735130114",
            "speakerId": 1000,
            "speakerName": "施芮娅",
            "text": "——这就是你当年强行实验二号机然后炸膛的理由？",
            "nextDialogs": [
              "735130115"
            ]
          },
          "735130115": {
            "id": "735130115",
            "speakerId": 1001,
            "speakerName": "维纳亚克",
            "text": "这、这跟那时候不一样吧！那时候我不还没意识到要留容错空间…",
            "nextDialogs": [
              "735130116"
            ]
          },
          "735130116": {
            "id": "735130116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…有没有安全点的实验方法？",
            "nextDialogs": [
              "735130117"
            ]
          },
          "735130117": {
            "id": "735130117",
            "speakerId": 1001,
            "speakerName": "维纳亚克",
            "text": "我想想…或许可以先关闭炮塔的发射功能，就模拟实验一下它的充能进程？",
            "nextDialogs": [
              "735130118"
            ]
          },
          "735130118": {
            "id": "735130118",
            "speakerId": 1000,
            "speakerName": "施芮娅",
            "text": "…不行，我信不过你，还是把炮塔的点火模块卸了吧，我先给你保管着。别的东西随你装。",
            "nextDialogs": [
              "735130119"
            ]
          },
          "735130119": {
            "id": "735130119",
            "speakerId": 1001,
            "speakerName": "维纳亚克",
            "text": "卸掉点火模块？——那这「对沙虫用杀虫炮」不就成空架子了吗！",
            "nextDialogs": [
              "735130120"
            ]
          },
          "735130120": {
            "id": "735130120",
            "speakerId": 1000,
            "speakerName": "施芮娅",
            "text": "你不是说就实验一下充能吗？果然还是在打开炮的主意啊！",
            "nextDialogs": [
              "735130121"
            ]
          },
          "735130121": {
            "id": "735130121",
            "speakerId": 1001,
            "speakerName": "维纳亚克",
            "text": "唔唔…",
            "nextDialogs": [
              "735130124"
            ]
          },
          "735130124": {
            "id": "735130124",
            "speakerId": 1001,
            "speakerName": "维纳亚克",
            "text": "唉，行吧…就当是试组装了。",
            "nextDialogs": [
              "735130125"
            ]
          },
          "735130125": {
            "id": "735130125",
            "speakerId": 1000,
            "speakerName": "施芮娅",
            "text": "早这样不就好了…安装过程中估计会有不少魔物被引来，到时候就麻烦你了，冒险家。"
          }
        }
      }
    }
  ]
}
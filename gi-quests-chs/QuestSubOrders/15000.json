    {
      "subId": "1500004",
      "subQuestName": "寻找走失的龙宝宝",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150000301"
        ],
        "dialogs": {
          "150000301": {
            "id": "150000301",
            "speakerId": 1004,
            "speakerName": "波吉吉",
            "text": "山王…"
          }
        }
      }
    },
    {
      "subId": "1500005",
      "subQuestName": "寻找走失的龙宝宝",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150000401"
        ],
        "dialogs": {
          "150000401": {
            "id": "150000401",
            "speakerId": 1005,
            "speakerName": "波奇奇",
            "text": "嗷呜…",
            "nextDialogs": [
              "150000402"
            ]
          },
          "150000402": {
            "id": "150000402",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "龙宝宝在这里！咦？旁边有一个…阿乔？",
            "nextDialogs": [
              "150000403"
            ]
          },
          "150000403": {
            "id": "150000403",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "这不是吾那仆从的两位劣友吗？是在山下窥见了吾的英姿，特地爬上来供奉的吧？看来日前一见，吾的伟岸已深嵌汝等心灵了。",
            "nextDialogs": [
              "150000404"
            ]
          },
          "150000404": {
            "id": "150000404",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "真是拿下人没办法，来吧，亲吻吾的脚背，伟大圣龙库胡勒阿乔允许汝等献上朝拜。",
            "nextDialogs": [
              "150000405"
            ]
          },
          "150000405": {
            "id": "150000405",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你…你不是基尼奇的那个小跟班吗？在自说自话什么？居然比上次更讨厌了。",
            "nextDialogs": [
              "150000406"
            ]
          },
          "150000406": {
            "id": "150000406",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "胡言乱语！什么小跟班？吾乃无上之龙！烈焰之国的至高领主！",
            "nextDialogs": [
              "150000407"
            ]
          },
          "150000407": {
            "id": "150000407",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "上次要不是基尼奇三拜九叩，吾才不会恩施汝等丝毫言语的仁慈！",
            "nextDialogs": [
              "150000408"
            ]
          },
          "150000408": {
            "id": "150000408",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "什么嘛，明明就是被基尼奇关起来了吧，你还挺会装模做样的…",
            "nextDialogs": [
              "150000410",
              "150000412"
            ]
          },
          "150000410": {
            "id": "150000410",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "哼哼，这还差不多。",
            "nextDialogs": [
              "150000413"
            ]
          },
          "150000413": {
            "id": "150000413",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "近日吾应许了吾那仆从的祈求，为其调查维茨特兰附近的深渊事件。",
            "nextDialogs": [
              "150000414"
            ]
          },
          "150000414": {
            "id": "150000414",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "深渊事件？！",
            "nextDialogs": [
              "150000415"
            ]
          },
          "150000415": {
            "id": "150000415",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "看见这小爬虫了吗？它的母亲——一只中爬虫，被深渊力量侵蚀，错乱地攻击了吾那仆从的族人，甚至还攻击了自己的后裔。",
            "nextDialogs": [
              "150000416"
            ]
          },
          "150000416": {
            "id": "150000416",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "天哪…那它现在怎么样了？",
            "nextDialogs": [
              "150000417"
            ]
          },
          "150000417": {
            "id": "150000417",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "低等的爬虫如何能与深渊久斗？自然是去了夜神之国。",
            "nextDialogs": [
              "150000418"
            ]
          },
          "150000418": {
            "id": "150000418",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "弱小的生灵啊…听说是自我了断，从高崖上一跃而下。",
            "nextDialogs": [
              "150000419"
            ]
          },
          "150000419": {
            "id": "150000419",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "跳崖…？！",
            "nextDialogs": [
              "150000420"
            ]
          },
          "150000420": {
            "id": "150000420",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "白色小飞蚁，别再露出还有一百个问题的愚蠢表情，伟大的圣龙库胡勒阿乔可不是谁人的许愿灵泉啊。",
            "nextDialogs": [
              "150000421"
            ]
          },
          "150000421": {
            "id": "150000421",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "谁是白色小飞蚁？！你…我一定要给你想个难听的绰号！",
            "nextDialogs": [
              "150000422"
            ]
          },
          "150000422": {
            "id": "150000422",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "哼，吾探查到附近有微弱的深渊气息，必有擅于隐藏的邪恶术士存在。要是遇见了可疑的外地人，汝等需细细盘问。",
            "nextDialogs": [
              "150000423"
            ]
          },
          "150000423": {
            "id": "150000423",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "可疑的外地人…你不是在指深渊骂我们吧？",
            "nextDialogs": [
              "150000424"
            ]
          },
          "150000424": {
            "id": "150000424",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "呸！下人之心度领主之腹！汝等若非吾那仆从的劣友，吾早就打打打打打打！",
            "nextDialogs": [
              "150000425"
            ]
          },
          "150000425": {
            "id": "150000425",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "既然不是来朝拜，就速速退去！伟大的圣龙库胡勒阿乔要去办正事了。"
          },
          "150000412": {
            "id": "150000412",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "是领主大人！你想气死伟大圣龙库胡勒阿乔吗？你的罪行将遭回火焚烧千年！"
          }
        }
      }
    },
    {
      "subId": "1500006",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150000601"
        ],
        "dialogs": {
          "150000601": {
            "id": "150000601",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "要注意安全呀！我们就在这里等着。"
          }
        }
      }
    },
    {
      "subId": "1500007",
      "subQuestName": "回去找胡妮与多巴",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150000501"
        ],
        "dialogs": {
          "150000501": {
            "id": "150000501",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "#哇！{M#哥哥姐姐}{F#两位姐姐}好厉害！这么快就回来了！",
            "nextDialogs": [
              "150000502"
            ]
          },
          "150000502": {
            "id": "150000502",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "#龙宝宝没事真是太好了，这下我们可以放心地回家啦。谢谢{M#哥哥姐姐}{F#两位姐姐}！",
            "nextDialogs": [
              "150000503"
            ]
          },
          "150000503": {
            "id": "150000503",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不用客气啦，我们根本没费什么工夫。",
            "nextDialogs": [
              "150000504"
            ]
          },
          "150000504": {
            "id": "150000504",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "#你们爬了好高的山呢，肯定很辛苦，看{M#哥哥姐姐}{F#两位姐姐}的打扮，应该也不是本地人吧？来我家歇歇脚吧！",
            "nextDialogs": [
              "150000505"
            ]
          },
          "150000505": {
            "id": "150000505",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "没错，给个机会吧，让我们展现一下悬木人的热情好客！你们这么好心，跟之前那个眼镜仔完全不一样。",
            "nextDialogs": [
              "150000506"
            ]
          },
          "150000506": {
            "id": "150000506",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "听你们说的，那家伙也是外地人吗？",
            "nextDialogs": [
              "150000507"
            ]
          },
          "150000507": {
            "id": "150000507",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "他的衣服不是纳塔款式…现在想想，真是可疑！",
            "nextDialogs": [
              "150000508"
            ]
          },
          "150000508": {
            "id": "150000508",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "可疑的外地人？该不会是阿乔说的…",
            "nextDialogs": [
              "150000509"
            ]
          },
          "150000509": {
            "id": "150000509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能详细说说那个人的情况吗？",
            "nextDialogs": [
              "150000510"
            ]
          },
          "150000510": {
            "id": "150000510",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "#{M#哥哥姐姐}{F#两位姐姐}对那个叔叔感兴趣吗？那我想想，事情是这样的…",
            "nextDialogs": [
              "150000511"
            ]
          },
          "150000511": {
            "id": "150000511",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "这位叔叔，我已经讲了好几个故事了…什么时候才能帮我去找龙宝宝啊？",
            "nextDialogs": [
              "150000512"
            ]
          },
          "150000512": {
            "id": "150000512",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "再讲一个吧，再讲讲那团火的故事吧？",
            "nextDialogs": [
              "150000513"
            ]
          },
          "150000513": {
            "id": "150000513",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "叔叔听说，有一团巨大的透明的火，燃烧在过去五百年、一千年甚至更多不计其数的时间里。",
            "nextDialogs": [
              "150000514"
            ]
          },
          "150000514": {
            "id": "150000514",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "那个叫回火！古名「马{RUBY#[D]回火}力卜」就是从这个传说里诞生的！",
            "nextDialogs": [
              "150000515"
            ]
          },
          "150000515": {
            "id": "150000515",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "哇哦，是古名的起源吗？这么厉害？",
            "nextDialogs": [
              "150000516"
            ]
          },
          "150000516": {
            "id": "150000516",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "嗯呢，所有的古名都有起源传说。在传说里，回火出现在纳塔大联盟的年代，被暴君奥奇坎拿来统治纳塔，镇压反对他的人。",
            "nextDialogs": [
              "150000517"
            ]
          },
          "150000517": {
            "id": "150000517",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "回火和普通火焰最不同的就是，被它点燃的人虽然会觉得背后灼痛难忍，但不会马上死掉，这时候千万不能回头检查！",
            "nextDialogs": [
              "150000518"
            ]
          },
          "150000518": {
            "id": "150000518",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "不可以回头？",
            "nextDialogs": [
              "150000519"
            ]
          },
          "150000519": {
            "id": "150000519",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "一回头就完蛋了，立刻就会被烧成灰！",
            "nextDialogs": [
              "150000520"
            ]
          },
          "150000520": {
            "id": "150000520",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "哇哦，烧衣服烧行头就算了，烧人可真是残暴。",
            "nextDialogs": [
              "150000521"
            ]
          },
          "150000521": {
            "id": "150000521",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "是吧，怎么可以烧人家后背还不许人家回头看呢？奥奇坎真是个暴君。",
            "nextDialogs": [
              "150000522"
            ]
          },
          "150000522": {
            "id": "150000522",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "按照传说的惯例，接着该有人挺身而出了吧？",
            "nextDialogs": [
              "150000523"
            ]
          },
          "150000523": {
            "id": "150000523",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "眼镜大叔，你还挺懂行的嘛。确实是这样，那个人就是我们悬木人的祖先，尤潘基大人。",
            "nextDialogs": [
              "150000524"
            ]
          },
          "150000524": {
            "id": "150000524",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "嗯，尤潘基大人和暴君奥奇坎还有最初的火神希巴拉克大人都是朋友，他是当时大联盟的军械官。",
            "nextDialogs": [
              "150000525"
            ]
          },
          "150000525": {
            "id": "150000525",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "他不认同奥奇坎的残酷统治，就为人们偷出了回火，并把它抛向了暴君的军队。没有人能抵挡，士兵们全被烧成了灰。",
            "nextDialogs": [
              "150000526"
            ]
          },
          "150000526": {
            "id": "150000526",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "就这样，祖先解放了人们，但就在逃出城的时候，他好像听到奥奇坎的呼唤从背后传来，于是鬼使神差地回了头。",
            "nextDialogs": [
              "150000527"
            ]
          },
          "150000527": {
            "id": "150000527",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "但他却只看到了焦黑的城市、枯萎的士兵、冲天的火焰…",
            "nextDialogs": [
              "150000528"
            ]
          },
          "150000528": {
            "id": "150000528",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "再下一刻，映在眼底的火舌突然从他瞳孔中钻出来，把祖先吞没了。",
            "nextDialogs": [
              "150000529"
            ]
          },
          "150000529": {
            "id": "150000529",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "只回头看了一眼哦！就也被烧成了灰。",
            "nextDialogs": [
              "150000530"
            ]
          },
          "150000530": {
            "id": "150000530",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "这是窃火…还是回头的代价呢？",
            "nextDialogs": [
              "150000531"
            ]
          },
          "150000531": {
            "id": "150000531",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "不知道，但尤潘基大人身上的火比别处的都要凶，烧了整整一百天，最后连地脉都被烧开了个大洞！",
            "nextDialogs": [
              "150000532"
            ]
          },
          "150000532": {
            "id": "150000532",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "然后火光「噼咻」一下就掉进了黑黢黢的夜神之国，一直烧到现在。",
            "nextDialogs": [
              "150000533"
            ]
          },
          "150000533": {
            "id": "150000533",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "大人都说，它照亮了往生之路，但也要亡者接受它的灼烧，这样才能纯净地迎接来世。",
            "nextDialogs": [
              "150000534"
            ]
          },
          "150000534": {
            "id": "150000534",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "就像是对一生的回顾与审问…所以人们就叫它尤潘基的回火。",
            "nextDialogs": [
              "150000535"
            ]
          },
          "150000535": {
            "id": "150000535",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "噢…多么富有诗意的故事！所以在夜神之国真的可以见到这团火吗？",
            "nextDialogs": [
              "150000536"
            ]
          },
          "150000536": {
            "id": "150000536",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "不知道欸…这只是个传说吧？",
            "nextDialogs": [
              "150000537"
            ]
          },
          "150000537": {
            "id": "150000537",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "所以后来你们有人继承了这个古名吧？",
            "nextDialogs": [
              "150000538"
            ]
          },
          "150000538": {
            "id": "150000538",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "当然，比如「回火夜」祭祀的英雄布基纳，不过他是五百年前的人了。",
            "nextDialogs": [
              "150000539"
            ]
          },
          "150000539": {
            "id": "150000539",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "嗯，现在这个古名属于基尼奇哥哥…「马{RUBY#[D]回火}力卜」的基尼奇。",
            "nextDialogs": [
              "150000540"
            ]
          },
          "150000540": {
            "id": "150000540",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "基尼奇…",
            "nextDialogs": [
              "150000541"
            ]
          },
          "150000541": {
            "id": "150000541",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "好了，眼镜大叔，我们已经说了很多故事了，你该去找龙宝宝了！",
            "nextDialogs": [
              "150000542"
            ]
          },
          "150000542": {
            "id": "150000542",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "啊…但回火的传说不是教导我们不要回头看吗？所以，不要再提前面说过的部分了。",
            "nextDialogs": [
              "150000543"
            ]
          },
          "150000543": {
            "id": "150000543",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "请再讲一讲这个基尼奇吧，从现在开始的才算数。",
            "nextDialogs": [
              "150000544"
            ]
          },
          "150000544": {
            "id": "150000544",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "咦？多巴，你怎么露出了那种想要骂人的眼神？不可以哦，那是大人的特权。",
            "nextDialogs": [
              "150000545"
            ]
          },
          "150000545": {
            "id": "150000545",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "叔叔…要是你骗我们…死了之后会被回火烧得很惨的！",
            "nextDialogs": [
              "150000546"
            ]
          },
          "150000546": {
            "id": "150000546",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "本地火怎么会烧外地人呢？叔叔可不是你们的老乡啊。",
            "nextDialogs": [
              "150000547"
            ]
          },
          "150000547": {
            "id": "150000547",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "啊…？",
            "nextDialogs": [
              "150000548"
            ]
          },
          "150000548": {
            "id": "150000548",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "等等…那是…",
            "nextDialogs": [
              "150000549"
            ]
          },
          "150000549": {
            "id": "150000549",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "#好了孩子们，叔叔不会白听故事的，叔叔派了两个朋友过来，嗯…{M#他们}{F#她们}会来付报酬的…",
            "nextDialogs": [
              "150000550"
            ]
          },
          "150000550": {
            "id": "150000550",
            "speakerId": 1007,
            "speakerName": "？？？",
            "text": "#你们一定要狠狠使唤{M#他们}{F#她们}。千万别顾忌叔叔我的面子。",
            "nextDialogs": [
              "150000551"
            ]
          },
          "150000551": {
            "id": "150000551",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "真的吗？那眼镜大叔，你叫什么？",
            "nextDialogs": [
              "150000552"
            ]
          },
          "150000552": {
            "id": "150000552",
            "speakerId": 1008,
            "speakerName": "山下",
            "text": "我们在这山崖下相遇，大叔自然叫「山下」了。",
            "nextDialogs": [
              "150000553"
            ]
          },
          "150000553": {
            "id": "150000553",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "真的假的…",
            "nextDialogs": [
              "150000554"
            ]
          },
          "150000554": {
            "id": "150000554",
            "speakerId": 1008,
            "speakerName": "山下",
            "text": "#不信回头看看，{M#他们}{F#她们}已经来了。",
            "nextDialogs": [
              "150000555"
            ]
          },
          "150000555": {
            "id": "150000555",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "嗯？哪有啊…",
            "nextDialogs": [
              "150000556"
            ]
          },
          "150000556": {
            "id": "150000556",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "叔叔…你人呢？！",
            "nextDialogs": [
              "150000557"
            ]
          },
          "150000557": {
            "id": "150000557",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "听下来这家伙真的有点可疑呢…他好像在打听关于古名的事！",
            "nextDialogs": [
              "150000558"
            ]
          },
          "150000558": {
            "id": "150000558",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "是吧！这个可恶的眼镜仔，他背叛了我们！他会付出代价的！",
            "nextDialogs": [
              "150000559"
            ]
          },
          "150000559": {
            "id": "150000559",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "但也只是听走了一些故事，应该不会怎么样吧？",
            "nextDialogs": [
              "150000560"
            ]
          },
          "150000560": {
            "id": "150000560",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#唔…{NICKNAME}，我们是不是该让基尼奇知道一下？虽然那个臭屁阿乔已经在调查了，但总觉得它不怎么靠谱。",
            "nextDialogs": [
              "150000561"
            ]
          },
          "150000561": {
            "id": "150000561",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "欸？你们也认识基尼奇哥哥吗？",
            "nextDialogs": [
              "150000562"
            ]
          },
          "150000562": {
            "id": "150000562",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "其实也不算很熟，我们只是见过面，还一起吃过饭。",
            "nextDialogs": [
              "150000563"
            ]
          },
          "150000563": {
            "id": "150000563",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "好羡慕！我都没有和基尼奇哥哥说过话。他是族里的猎龙人，还有很厉害的古名，真是太酷了。",
            "nextDialogs": [
              "150000564"
            ]
          },
          "150000564": {
            "id": "150000564",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "我也是！不过我爸爸不太喜欢他，还叫我跟他少接触…肯定是因为他身边那个自大又恶毒的伙伴！",
            "nextDialogs": [
              "150000565"
            ]
          },
          "150000565": {
            "id": "150000565",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊！是那个自称库胡勒阿乔的坏东西！我们也领教过了，真是生怕别人不讨厌它的样子…",
            "nextDialogs": [
              "150000566"
            ]
          },
          "150000566": {
            "id": "150000566",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "就是！真不知道基尼奇哥哥怎么会选中那家伙当伙伴，怎么不选我呢？",
            "nextDialogs": [
              "150000567"
            ]
          },
          "150000567": {
            "id": "150000567",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "哎呀！不好，胡妮，我们出来太久，再不回家要挨骂了！",
            "nextDialogs": [
              "150000568"
            ]
          },
          "150000568": {
            "id": "150000568",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "#对哦，那…{M#哥哥姐姐}{F#两位姐姐}，沿着这条路往前走就能到我们族里，要是你们打算过去，要记得来我家做客哦。",
            "nextDialogs": [
              "150000569"
            ]
          },
          "150000569": {
            "id": "150000569",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "有什么需要的，我都会让爸爸帮你们的，一定要来哦！",
            "nextDialogs": [
              "150000570"
            ]
          },
          "150000570": {
            "id": "150000570",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "#{M#哥哥姐姐}{F#两位姐姐}再见，我们先走啦！"
          }
        }
      }
    },
    {

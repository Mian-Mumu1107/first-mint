    {
      "subId": "1500001",
      "subQuestName": "前往悬木人部族外的山崖下",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150000101"
        ],
        "dialogs": {
          "150000101": {
            "id": "150000101",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "#{M#哥哥姐姐}{F#两位姐姐}好！我是胡妮，你们是来找龙宝宝的吧？",
            "nextDialogs": [
              "150000102"
            ]
          },
          "150000102": {
            "id": "150000102",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "我是多巴，如果我没猜错的话，帮手就是你们！",
            "nextDialogs": [
              "150000103"
            ]
          },
          "150000103": {
            "id": "150000103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦？小朋友，见到你们很高兴，但我们只是路过…",
            "nextDialogs": [
              "150000104"
            ]
          },
          "150000104": {
            "id": "150000104",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "可山下叔叔说，他派了朋友过来帮忙…不是你们吗？",
            "nextDialogs": [
              "150000105"
            ]
          },
          "150000105": {
            "id": "150000105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们是有些朋友，但都不叫山下。",
            "nextDialogs": [
              "150000106"
            ]
          },
          "150000106": {
            "id": "150000106",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "…虽然不知道具体情况，但你们好像搞错了。",
            "nextDialogs": [
              "150000107"
            ]
          },
          "150000107": {
            "id": "150000107",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "搞错了？",
            "nextDialogs": [
              "150000108"
            ]
          },
          "150000108": {
            "id": "150000108",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "完蛋，胡妮，我们一定是被骗了，那个眼镜仔果然是个骗子…",
            "nextDialogs": [
              "150000109"
            ]
          },
          "150000109": {
            "id": "150000109",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "那龙宝宝该怎么办…时间要不够了…",
            "nextDialogs": [
              "150000110"
            ]
          },
          "150000110": {
            "id": "150000110",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "小朋友，你先别急，你说的龙宝宝怎么了？",
            "nextDialogs": [
              "150000111"
            ]
          },
          "150000111": {
            "id": "150000111",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "最近族里不太平，我爸爸的龙伙伴出事了，它叫南娜，有三个宝宝。",
            "nextDialogs": [
              "150000112"
            ]
          },
          "150000112": {
            "id": "150000112",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "南娜出事后，宝宝们很害怕，就躲了起来，我很担心，就想来找找它们。",
            "nextDialogs": [
              "150000113"
            ]
          },
          "150000113": {
            "id": "150000113",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你爸爸的龙伙伴啊…那他自己不管吗？",
            "nextDialogs": [
              "150000114"
            ]
          },
          "150000114": {
            "id": "150000114",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "爸爸是族里的长老，正忙着筹备回火夜，那个很重要，至少比这件事重要。我也是瞒着他偷跑出来的…",
            "nextDialogs": [
              "150000115"
            ]
          },
          "150000115": {
            "id": "150000115",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "本来以为不会花很久，可刚才那个叔叔缠着我们给他讲了很多故事，浪费了好多时间。",
            "nextDialogs": [
              "150000116"
            ]
          },
          "150000116": {
            "id": "150000116",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "真可恶，眼镜仔的心里没有一点爱！",
            "nextDialogs": [
              "150000117"
            ]
          },
          "150000117": {
            "id": "150000117",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#别生气啦，要不我们来帮忙找吧！听起来也不麻烦，我们心里可是很有爱的，对吧？{NICKNAME}。",
            "nextDialogs": [
              "150000118"
            ]
          },
          "150000118": {
            "id": "150000118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "当然。龙宝宝在附近吗？",
            "nextDialogs": [
              "150000119"
            ]
          },
          "150000119": {
            "id": "150000119",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "应该是的，我已经发现了一些痕迹，它们应该就躲在附近的山崖上…",
            "nextDialogs": [
              "150000120"
            ]
          },
          "150000120": {
            "id": "150000120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我和派蒙吧，不会很久。",
            "nextDialogs": [
              "150000121"
            ]
          },
          "150000121": {
            "id": "150000121",
            "speakerId": 1000,
            "speakerName": "胡妮",
            "text": "#真的吗？那…那谢谢{NICKNAME}{M#哥哥}{F#姐姐}，谢谢派蒙姐姐！",
            "nextDialogs": [
              "150000122"
            ]
          },
          "150000122": {
            "id": "150000122",
            "speakerId": 1001,
            "speakerName": "多巴",
            "text": "#哇！{M#哥哥姐姐}{F#两位姐姐}要注意安全哦，山崖很陡，族里的大人也没那么容易爬上去。"
          }
        }
      }
    },
    {
      "subId": "1500002",
      "subQuestName": "寻找走失的龙宝宝$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

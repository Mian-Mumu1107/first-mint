{
  "lineCounts": {
    "Player": 5,
    "克朗谢": 13,
    "派蒙": 1
  },
  "subQuests": [
    {
      "subId": "7907401",
      "subQuestName": "与克朗谢对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790740101"
        ],
        "dialogs": {
          "790740101": {
            "id": "790740101",
            "speakerId": 1000,
            "speakerName": "克朗谢",
            "text": "瞧，又来了两位勇士！您是想要来挑战「北风吹流」的吗？",
            "nextDialogs": [
              "790740102"
            ]
          },
          "790740102": {
            "id": "790740102",
            "speakerId": 1000,
            "speakerName": "克朗谢",
            "text": "来吧，往这边走，我期待着您能飞得比谁都好！",
            "nextDialogs": [
              "790740105"
            ]
          },
          "790740105": {
            "id": "790740105",
            "speakerId": 1000,
            "speakerName": "克朗谢",
            "text": "飞行不需要冷静，这位客人。绝对不需要。",
            "nextDialogs": [
              "790740106"
            ]
          },
          "790740106": {
            "id": "790740106",
            "speakerId": 1000,
            "speakerName": "克朗谢",
            "text": "冷静只会让你对风的感受变迟钝，只有在毫无准备的情况下面对狂风，才能发掘出自己的潜能。",
            "nextDialogs": [
              "790740107"
            ]
          },
          "790740107": {
            "id": "790740107",
            "speakerId": 1000,
            "speakerName": "克朗谢",
            "text": "如今的飞鼠都太胆小了！完全遗忘了那篇《勇敢的北风》里的教诲！",
            "nextDialogs": [
              "790740108"
            ]
          },
          "790740108": {
            "id": "790740108",
            "speakerId": 1000,
            "speakerName": "克朗谢",
            "text": "光是站在安全的地方，赞叹着树叶随风起舞的勇气，自己却怯手怯脚，不敢亲自踏进风里。",
            "nextDialogs": [
              "790740109"
            ]
          },
          "790740109": {
            "id": "790740109",
            "speakerId": 1000,
            "speakerName": "克朗谢",
            "text": "这样下去，我们还怎么和公主殿下一起守护整个王国！真是无理！无理！",
            "nextDialogs": [
              "790740110"
            ]
          },
          "790740110": {
            "id": "790740110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还真是一位有活力的飞鼠呢…",
            "nextDialogs": [
              "790740111"
            ]
          },
          "790740111": {
            "id": "790740111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来他确实很喜欢飞行。",
            "nextDialogs": [
              "790740112"
            ]
          },
          "790740112": {
            "id": "790740112",
            "speakerId": 1000,
            "speakerName": "克朗谢",
            "text": "所以，我就找到了几条吹流格外激烈的风道，并且在里面设置了各类机关。",
            "nextDialogs": [
              "790740113"
            ]
          },
          "790740113": {
            "id": "790740113",
            "speakerId": 1000,
            "speakerName": "克朗谢",
            "text": "只有最勇敢，最擅长飞行的勇士，才能通过这条风道。",
            "nextDialogs": [
              "790740114"
            ]
          },
          "790740114": {
            "id": "790740114",
            "speakerId": 1000,
            "speakerName": "克朗谢",
            "text": "二位客人，你们有这个勇气吗？"
          }
        }
      }
    }
  ]
}
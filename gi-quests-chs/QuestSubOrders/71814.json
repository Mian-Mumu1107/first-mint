        ],
        "dialogs": {
          "718140401": {
            "id": "718140401",
            "speakerId": 2143,
            "speakerName": "百闻",
            "text": "您好，有什么事吗？",
            "nextDialogs": [
              "718140402"
            ]
          },
          "718140402": {
            "id": "718140402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在海上捡到了这个…",
            "nextDialogs": [
              "718140403"
            ]
          },
          "718140403": {
            "id": "718140403",
            "speakerId": 2143,
            "speakerName": "百闻",
            "text": "嗯？请给我看看。",
            "nextDialogs": [
              "718140404"
            ]
          },
          "718140404": {
            "id": "718140404",
            "speakerId": 2143,
            "speakerName": "百闻",
            "text": "没错，这确实是群玉阁上的东西。",
            "nextDialogs": [
              "718140405"
            ]
          },
          "718140405": {
            "id": "718140405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那具体是…",
            "nextDialogs": [
              "718140406"
            ]
          },
          "718140406": {
            "id": "718140406",
            "speakerId": 2143,
            "speakerName": "百闻",
            "text": "是一些文册，还有一些没有审阅过的公文。居然还这么完好，真是出乎意料。",
            "nextDialogs": [
              "718140407"
            ]
          },
          "718140407": {
            "id": "718140407",
            "speakerId": 2143,
            "speakerName": "百闻",
            "text": "不过，能找到这些，确实也能节省一点工作量，毕竟现在这个情况，善后工作真是做不完。",
            "nextDialogs": [
              "718140408"
            ]
          },
          "718140408": {
            "id": "718140408",
            "speakerId": 2143,
            "speakerName": "百闻",
            "text": "哦对了，谢谢您帮忙把这些拿来，这些给您，就当是谢礼吧。"
          }
        }
      }
    },

              "718140303"
            ]
          },
          "718140303": {
            "id": "718140303",
            "speakerId": 2065,
            "speakerName": "大坤",
            "text": "嗯…这些摩拉你就自己收着吧，数量也不太多，就当做你帮忙的报酬吧。",
            "nextDialogs": [
              "718140304"
            ]
          },
          "718140304": {
            "id": "718140304",
            "speakerId": 2065,
            "speakerName": "大坤",
            "text": "这个盒子我就不知道是什么了，不然你把它拿给百闻看看吧。",
            "nextDialogs": [
              "718140305"
            ]
          },
          "718140305": {
            "id": "718140305",
            "speakerId": 2065,
            "speakerName": "大坤",
            "text": "她就在月海亭那边办公，也许她知道这是什么。"
          }
        }
      }
    },

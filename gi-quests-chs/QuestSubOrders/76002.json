    {
      "subId": "7600207",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760020701"
        ],
        "dialogs": {
          "760020701": {
            "id": "760020701",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嘿嘿，这样一来就把他们全部赶跑啦！真是的，这些盗宝团居然还想让我们当打手…",
            "nextDialogs": [
              "760020703",
              "760020705"
            ]
          },
          "760020703": {
            "id": "760020703",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没错没错！唔，说起来，我也很好奇，他们在抢的到底是什么东西呀？",
            "nextDialogs": [
              "760020707"
            ]
          },
          "760020707": {
            "id": "760020707",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦，这不是枫丹的发条机关吗？不过，这么看看的话，枫丹的技术还真厉害啊，运到这里还能动…",
            "nextDialogs": [
              "760020708"
            ]
          },
          "760020708": {
            "id": "760020708",
            "speakerId": 1003,
            "speakerName": "「贝勒维尔小姐」",
            "text": "「警告。启动模式<color=#FF5E41FF>异常</color>。能源模块<color=#FF5E41FF>异x5F02&#5E38常</color>。校验失败。」",
            "nextDialogs": [
              "760020709"
            ]
          },
          "760020709": {
            "id": "760020709",
            "speakerId": 1003,
            "speakerName": "「贝勒维尔小姐」",
            "text": "「校验失败。<color=#FF5E41FF>校验失败</color>。<color=#FF5E41FF>校验失败</color>。<color=#FF5E41FF>歼灭</color>。<color=#FF5E41FF>歼灭</color>。<color=#FF5E41FF>歼灭</color>。<color=#FF5E41FF>歼灭歼灭歼灭歼</color>——」",
            "nextDialogs": [
              "760020710"
            ]
          },
          "760020710": {
            "id": "760020710",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#噫——！{NICKNAME}，小心呀！"
          },
          "760020705": {
            "id": "760020705",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "就是就是，明明可以独吞，为什么还要和他们分赃…不对，不要用这种奇怪的说法啦！我们可是正义的冒险家…应该是吧？",
            "nextDialogs": [
              "760020706"
            ]
          },
          "760020706": {
            "id": "760020706",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔，说起来，我也很好奇，他们在抢的到底是什么东西呀？"
          }
        }
      }
    },
    {
      "subId": "7600208",

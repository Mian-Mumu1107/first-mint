  "subQuests": [
    {
      "subId": "7600201",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760020101"
        ],
        "dialogs": {
          "760020101": {
            "id": "760020101",
            "speakerId": 1000,
            "speakerName": "巴苏",
            "text": "#喂，那边金发的{M#并肩子}{F#斗花子}！来得巧，这空码想吃横的，帮着搭把手，事后挑片儿短不了你的！",
            "nextDialogs": [
              "760020102"
            ]
          },
          "760020102": {
            "id": "760020102",
            "speakerId": 1001,
            "speakerName": "霍伊卡",
            "text": "#什么玩意儿，打不过想拉人？行啊，你能干我也能干，{M#小哥}{F#小姐}听我的，帮我把这家伙做了，等摩拉到手，我分你一半！",
            "nextDialogs": [
              "760020103"
            ]
          },
          "760020103": {
            "id": "760020103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸，欸？！我们只是路过而已…"
          }
        }
      }
    },
    {
      "subId": "7600202",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],

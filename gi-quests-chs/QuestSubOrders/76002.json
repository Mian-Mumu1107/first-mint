    {
      "subId": "7600201",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760020104"
        ],
        "dialogs": {
          "760020104": {
            "id": "760020104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（帮助巴苏）怎么能抢别人的东西！",
            "nextDialogs": [
              "760020105"
            ]
          },
          "760020105": {
            "id": "760020105",
            "speakerId": 1000,
            "speakerName": "巴苏",
            "text": "#哈，{M#并肩子}{F#斗花子}果然门清。拉个对马，给他们办了！",
            "nextDialogs": [
              "760020106"
            ]
          },
          "760020106": {
            "id": "760020106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（帮助霍伊卡）这运的是违禁品吧？",
            "nextDialogs": [
              "760020107"
            ]
          },
          "760020107": {
            "id": "760020107",
            "speakerId": 1001,
            "speakerName": "霍伊卡",
            "text": "#啊？啊…对，对，{M#小哥}{F#小姐}说得对，这家伙运的都是违禁品，不能让他们送到那夏镇！",
            "nextDialogs": [
              "760020108"
            ]
          },
          "760020108": {
            "id": "760020108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不要紧，都是盗宝团，我一起打。",
            "nextDialogs": [
              "760020109"
            ]
          },
          "760020109": {
            "id": "760020109",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没、没错！我们可是正义的冒险家，才不会当什么坏家伙的打手呢！要是做坏事的话，我们可是不允许的！"
          }
        }
      }
    },
    {
      "subId": "7600299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760029901"
        ],
        "dialogs": {
          "760029901": {
            "id": "760029901",
            "speakerId": 1000,
            "speakerName": "巴苏",
            "text": "哈！皮子传正，也学人别梁子？误了当家的送到那夏镇的货，怕是把你连旗的全烫了都赔不起！",
            "nextDialogs": [
              "760029902"
            ]
          },
          "760029902": {
            "id": "760029902",
            "speakerId": 1001,
            "speakerName": "霍伊卡",
            "text": "什么烫不烫的，胡言乱语…等小爷给你们全冻上，再把这批货夺过来也不迟。",
            "nextDialogs": [
              "760029903"
            ]
          },
          "760029903": {
            "id": "760029903",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#呜哇，{NICKNAME}，那边好像要打起来了！",
            "nextDialogs": [
              "760029905"
            ]
          },
          "760029905": {
            "id": "760029905",
            "speakerId": 1000,
            "speakerName": "巴苏",
            "text": "唉，也是点子背。罢了，都是干这行的，多办一个也趁手…",
            "nextDialogs": [
              "760029908"
            ]
          },
          "760029908": {
            "id": "760029908",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜啊，终于解决掉了…",
            "nextDialogs": [
              "760029909"
            ]
          },
          "760029909": {
            "id": "760029909",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "看样子也拿不到什么报酬了…不过，幸亏让它停机了，要是伤到其他人的话就糟糕了！呃，应该已经停机了吧？"
          }
        }
      }
    }
  ]
}
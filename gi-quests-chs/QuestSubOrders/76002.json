    {
      "subId": "7600205",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760020501"
        ],
        "dialogs": {
          "760020501": {
            "id": "760020501",
            "speakerId": 1001,
            "speakerName": "霍伊卡",
            "text": "哈！终于解决了，满口胡言乱语的外国佬，还什么烫不烫的，被冻上就不烫了吧？",
            "nextDialogs": [
              "760020502"
            ]
          },
          "760020502": {
            "id": "760020502",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这…这样一来应该就能阻止违禁品被运到那夏镇了吧？哦对，不要忘记我们的酬劳哦！",
            "nextDialogs": [
              "760020503"
            ]
          },
          "760020503": {
            "id": "760020503",
            "speakerId": 1001,
            "speakerName": "霍伊卡",
            "text": "哼，比起那个，还是先让小爷我验验货…",
            "nextDialogs": [
              "760020504"
            ]
          },
          "760020504": {
            "id": "760020504",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯？验…货？",
            "nextDialogs": [
              "760020505"
            ]
          },
          "760020505": {
            "id": "760020505",
            "speakerId": 1001,
            "speakerName": "霍伊卡",
            "text": "不然呢？要是出了问题，别说你们分不到摩拉，我的这些弟兄们也一分报酬都拿不到。",
            "nextDialogs": [
              "760020506"
            ]
          },
          "760020506": {
            "id": "760020506",
            "speakerId": 1001,
            "speakerName": "霍伊卡",
            "text": "啧…这些刮痕，甚至还有锈迹！灰河现在真是敷衍透顶了…",
            "nextDialogs": [
              "760020507"
            ]
          },
          "760020507": {
            "id": "760020507",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦，这不是枫丹的发条机关吗？不过，这么看看的话，枫丹的技术还真厉害啊，运到这里还能动…",
            "nextDialogs": [
              "760020508"
            ]
          },
          "760020508": {
            "id": "760020508",
            "speakerId": 1001,
            "speakerName": "霍伊卡",
            "text": "动？这玩意儿的能源系统应该早就被拆掉了，怎么可能——",
            "nextDialogs": [
              "760020509"
            ]
          },
          "760020509": {
            "id": "760020509",
            "speakerId": 1003,
            "speakerName": "「贝勒维尔小姐」",
            "text": "「警告。启动模式<color=#FF5E41FF>异常</color>。能源模块<color=#FF5E41FF>异x5F02&#5E38常</color>。校验失败。」",
            "nextDialogs": [
              "760020510"
            ]
          },
          "760020510": {
            "id": "760020510",
            "speakerId": 1003,
            "speakerName": "「贝勒维尔小姐」",
            "text": "「校验失败。<color=#FF5E41FF>校验失败</color>。<color=#FF5E41FF>校验失败</color>。<color=#FF5E41FF>歼灭</color>。<color=#FF5E41FF>歼灭</color>。<color=#FF5E41FF>歼灭</color>。<color=#FF5E41FF>歼灭歼灭歼灭歼</color>——」",
            "nextDialogs": [
              "760020511"
            ]
          },
          "760020511": {
            "id": "760020511",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#噫——！{NICKNAME}，小心呀！"
          }
        }
      }
    },

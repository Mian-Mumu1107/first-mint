        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7600203",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760020301"
        ],
        "dialogs": {
          "760020301": {
            "id": "760020301",
            "speakerId": 1000,
            "speakerName": "巴苏",
            "text": "呼…还是让他们邮了。这群水滚子也是不识相，竟然敢别到我们的梁子上。",
            "nextDialogs": [
              "760020302"
            ]
          },
          "760020302": {
            "id": "760020302",
            "speakerId": 1000,
            "speakerName": "巴苏",
            "text": "多谢相帮。待弟兄们把这位「贝勒维尔小姐」送到那夏镇，片子自然短不了二位。",
            "nextDialogs": [
              "760020303"
            ]
          },
          "760020303": {
            "id": "760020303",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯嗯，记得酬劳就…咦，等等，你们难道是人贩子吗？！",
            "nextDialogs": [
              "760020304"
            ]
          },
          "760020304": {
            "id": "760020304",
            "speakerId": 1000,
            "speakerName": "巴苏",
            "text": "哈哈，别误会，小妹子，绑票的生意我们可不做。",
            "nextDialogs": [
              "760020305"
            ]
          },
          "760020305": {
            "id": "760020305",
            "speakerId": 1000,
            "speakerName": "巴苏",
            "text": "「贝勒维尔小姐」是这个铁皮玩意儿的名字。从灰河一路运过来的，花了不少功夫。要是让人别了，弟兄们可就赔大了。",
            "nextDialogs": [
              "760020306"
            ]
          },
          "760020306": {
            "id": "760020306",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哦哦，原来是枫丹的发条机关…不过，这么看看的话，枫丹的技术还真厉害啊，运到这里还能动…",
            "nextDialogs": [
              "760020307"
            ]
          },
          "760020307": {
            "id": "760020307",
            "speakerId": 1000,
            "speakerName": "巴苏",
            "text": "小妹子又在开玩笑了。这铁皮玩意儿的能源系统早就被拆了，哪有可能——",
            "nextDialogs": [
              "760020308"
            ]
          },
          "760020308": {
            "id": "760020308",
            "speakerId": 1003,
            "speakerName": "「贝勒维尔小姐」",
            "text": "「警告。启动模式<color=#FF5E41FF>异常</color>。能源模块<color=#FF5E41FF>异x5F02&#5E38常</color>。校验失败。」",
            "nextDialogs": [
              "760020309"
            ]
          },
          "760020309": {
            "id": "760020309",
            "speakerId": 1003,
            "speakerName": "「贝勒维尔小姐」",
            "text": "「校验失败。<color=#FF5E41FF>校验失败</color>。<color=#FF5E41FF>校验失败</color>。<color=#FF5E41FF>歼灭</color>。<color=#FF5E41FF>歼灭</color>。<color=#FF5E41FF>歼灭</color>。<color=#FF5E41FF>歼灭歼灭歼灭歼</color>——」",
            "nextDialogs": [
              "760020310"
            ]
          },
          "760020310": {
            "id": "760020310",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#噫——！{NICKNAME}，小心呀！"
          }
        }
      }
    },
    {

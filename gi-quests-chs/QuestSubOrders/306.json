    {
      "subId": "30600",
      "subQuestName": "在庙宇门口跟安柏见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "30601",
      "subQuestName": "与安柏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3061101"
        ],
        "dialogs": {
          "3061101": {
            "id": "3061101",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "就是这里了，被废弃的<color=#00E1FFFF>四风守护庙宇</color>之一。",
            "nextDialogs": [
              "3061102"
            ]
          },
          "3061102": {
            "id": "3061102",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "这些庙宇已经荒废好多年了，蒙德的民众也根本不会来。",
            "nextDialogs": [
              "3061103"
            ]
          },
          "3061103": {
            "id": "3061103",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "搞不好里面会有野兽筑巢，或者丘丘人建立营地呢。",
            "nextDialogs": [
              "3061104"
            ]
          },
          "3061104": {
            "id": "3061104",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "唉…毕竟连风魔龙自己，都放弃了自己的庙宇…",
            "nextDialogs": [
              "3061107"
            ]
          },
          "3061107": {
            "id": "3061107",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "…是的。",
            "nextDialogs": [
              "3061108"
            ]
          },
          "3061108": {
            "id": "3061108",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "虽然我也很不愿意接受，但…风魔龙，曾经也是「四风守护」之一。",
            "nextDialogs": [
              "3061109"
            ]
          },
          "3061109": {
            "id": "3061109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸——",
            "nextDialogs": [
              "3061110"
            ]
          },
          "3061110": {
            "id": "3061110",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "先不提这些了。你感受到了吗？",
            "nextDialogs": [
              "3061111"
            ]
          },
          "3061111": {
            "id": "3061111",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "这里面的「风」，有些不对劲…",
            "nextDialogs": [
              "3061112"
            ]
          },
          "3061112": {
            "id": "3061112",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "#进去看看吧，{NICKNAME}。要小心，龙的力量正在影响这里。"
          }
        }
      }
    },

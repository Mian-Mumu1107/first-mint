    {
      "subId": "30610",
      "subQuestName": "(test)与安柏对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3061001"
        ],
        "dialogs": {
          "3061001": {
            "id": "3061001",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "呼…真累人。",
            "nextDialogs": [
              "3061002"
            ]
          },
          "3061002": {
            "id": "3061002",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "不过，这样就能为琴团长分担一些辛劳了。",
            "nextDialogs": [
              "3061003"
            ]
          },
          "3061003": {
            "id": "3061003",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "以前我们的防御力量，起码还能守住城里的安全。",
            "nextDialogs": [
              "3061004"
            ]
          },
          "3061004": {
            "id": "3061004",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "简单来说主要是因为有琴在。",
            "nextDialogs": [
              "3061005"
            ]
          },
          "3061005": {
            "id": "3061005",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "但现在风魔龙已经直接袭击了蒙德内部…",
            "nextDialogs": [
              "3061006"
            ]
          },
          "3061006": {
            "id": "3061006",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "「风向变了，我们的策略也会作出相应的变化。」",
            "nextDialogs": [
              "3061009"
            ]
          },
          "3061009": {
            "id": "3061009",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "这是丽莎喜欢说的话。",
            "nextDialogs": [
              "3061010"
            ]
          },
          "3061010": {
            "id": "3061010",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "对了，之前我们聊到的「四风守护」话题——",
            "nextDialogs": [
              "3061011"
            ]
          },
          "3061011": {
            "id": "3061011",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "如果想知道过往的历史，也可以去问丽莎。",
            "nextDialogs": [
              "3061012"
            ]
          },
          "3061012": {
            "id": "3061012",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "…先说明，不是因为我历史学得不好！",
            "nextDialogs": [
              "3061013"
            ]
          },
          "3061013": {
            "id": "3061013",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "图书管理员的知识储备，总之…就是会比侦察骑士更完备一点吧？"
          }
        }
      }
    },

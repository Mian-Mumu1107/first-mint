    {
      "subId": "2210720",
      "subQuestName": "(test)回答看狗$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221072001"
        ],
        "dialogs": {
          "221072001": {
            "id": "221072001",
            "speakerId": 2092,
            "speakerName": "阿山婆",
            "text": "今天居然卖出去这么多玩具，希望那些孩子都能开心啊…"
          }
        }
      }
    },
    {
      "subId": "2210709",
      "subQuestName": "向志华回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221070901"
        ],
        "dialogs": {
          "221070901": {
            "id": "221070901",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "怎么样，你们找到什么征兆了吗？"
          }
        }
      }
    },
    {
      "subId": "2210710",
      "subQuestName": "(test)向志华回报$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221071001"
        ],
        "dialogs": {
          "221071001": {
            "id": "221071001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我看见屋上有鸟成双对…",
            "nextDialogs": [
              "221071002"
            ]
          },
          "221071002": {
            "id": "221071002",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "嗯…嗯！好，这个好啊。",
            "nextDialogs": [
              "221071003"
            ]
          },
          "221071003": {
            "id": "221071003",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "两只相爱的鸽子远离族群，眼中只有彼此，只愿和对方比翼天涯。",
            "nextDialogs": [
              "221071004"
            ]
          },
          "221071004": {
            "id": "221071004",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这个征兆是在暗示…我一定会遇见那位只认定我一人的爱人。",
            "nextDialogs": [
              "221071005"
            ]
          },
          "221071005": {
            "id": "221071005",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "然后与她克服艰难险阻，脱离纷扰的人群，一起比翼天涯…",
            "nextDialogs": [
              "221071006"
            ]
          },
          "221071006": {
            "id": "221071006",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "咳！那个，辛苦你们了…我得找个时间，再去问问绮命姐…"
          }
        }
      }
    },
    {
      "subId": "2210711",
      "subQuestName": "(test)向志华回报$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221071101"
        ],
        "dialogs": {
          "221071101": {
            "id": "221071101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我看见有店主今天生意兴隆…",
            "nextDialogs": [
              "221071102"
            ]
          },
          "221071102": {
            "id": "221071102",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "嗯，生意兴隆，财源广进？这个不错，这个不错啊。",
            "nextDialogs": [
              "221071103"
            ]
          },
          "221071103": {
            "id": "221071103",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "只要耐心守候，用心经营，必然会有所收获。",
            "nextDialogs": [
              "221071104"
            ]
          },
          "221071104": {
            "id": "221071104",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这个征兆一定是在告诉我，无论是人生还是爱情，都是如此。",
            "nextDialogs": [
              "221071105"
            ]
          },
          "221071105": {
            "id": "221071105",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "咳！咳咳…那个，太感谢你们了，我得好好想想…",
            "nextDialogs": [
              "221071106"
            ]
          },
          "221071106": {
            "id": "221071106",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "绮命姐！总有一天我会…"
          }
        }
      }
    },
    {
      "subId": "2210712",
      "subQuestName": "(test)向志华回报$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221071201"
        ],
        "dialogs": {
          "221071201": {
            "id": "221071201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于落叶…",
            "nextDialogs": [
              "221071202"
            ]
          },
          "221071202": {
            "id": "221071202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…这个和爱情，应该没什么关系吧？",
            "nextDialogs": [
              "221071203"
            ]
          },
          "221071203": {
            "id": "221071203",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "落叶？当然有关系了。",
            "nextDialogs": [
              "221071204"
            ]
          },
          "221071204": {
            "id": "221071204",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这些落叶，虽然看似凋零无用，但是只要有一点契机…",
            "nextDialogs": [
              "221071205"
            ]
          },
          "221071205": {
            "id": "221071205",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "有一点火星，它们就会热烈燃烧，有一缕微风，它们就会翩然而起。",
            "nextDialogs": [
              "221071206"
            ]
          },
          "221071206": {
            "id": "221071206",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这简直就是在暗示我积蓄已久的爱情，只要一点契机，我和绮命姐就会…",
            "nextDialogs": [
              "221071207"
            ]
          },
          "221071207": {
            "id": "221071207",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "唉，可惜缘分天定，这个契机会在什么时候，以什么形式降临，谁也不知道。",
            "nextDialogs": [
              "221071208"
            ]
          },
          "221071208": {
            "id": "221071208",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "但是也不用担心，百因必有果，只要耐心等待就好。",
            "nextDialogs": [
              "221071209"
            ]
          },
          "221071209": {
            "id": "221071209",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "咳，那什么…辛苦你们了…"
          }
        }
      }
    },
    {
      "subId": "2210713",
      "subQuestName": "(test)向志华回报$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221071301"
        ],
        "dialogs": {
          "221071301": {
            "id": "221071301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有只猫和鱼成了朋友…",
            "nextDialogs": [
              "221071302"
            ]
          },
          "221071302": {
            "id": "221071302",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "居然能找到这种征兆，你真是有心了。",
            "nextDialogs": [
              "221071303"
            ]
          },
          "221071303": {
            "id": "221071303",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "在这种绝世的友谊里，无论是那只猫，还是那只鱼，都太伟大了…",
            "nextDialogs": [
              "221071304"
            ]
          },
          "221071304": {
            "id": "221071304",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "简直就像是爱情！爱情的力量，能够超越一切！",
            "nextDialogs": [
              "221071305"
            ]
          },
          "221071305": {
            "id": "221071305",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "如果可以的话，我真想向它们表达敬意。",
            "nextDialogs": [
              "221071306"
            ]
          },
          "221071306": {
            "id": "221071306",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这征兆一定是在告诉我，在爱情里绝不要惧怕任何困难，只有这样，绮命姐才会…",
            "nextDialogs": [
              "221071307"
            ]
          },
          "221071307": {
            "id": "221071307",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "咳！谢，谢谢你们！"
          }
        }
      }
    },
    {
      "subId": "2210714",
      "subQuestName": "(test)向志华回报$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221071401"
        ],
        "dialogs": {
          "221071401": {
            "id": "221071401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有一群围在一起的小狗…",
            "nextDialogs": [
              "221071402"
            ]
          },
          "221071402": {
            "id": "221071402",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这，这是什么坏征兆，这是在说我的爱情已经到了尽头吗？",
            "nextDialogs": [
              "221071403"
            ]
          },
          "221071403": {
            "id": "221071403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？可是那群小狗的关系看起来很好啊。",
            "nextDialogs": [
              "221071404"
            ]
          },
          "221071404": {
            "id": "221071404",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "那几只小狗我知道，确实关系不错，而且常年都在一起玩。",
            "nextDialogs": [
              "221071405"
            ]
          },
          "221071405": {
            "id": "221071405",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "看起来确实不错，但是事实上…它们谁都没有找到另一半。",
            "nextDialogs": [
              "221071406"
            ]
          },
          "221071406": {
            "id": "221071406",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "等到它们都老了，肯定也就来不及了…",
            "nextDialogs": [
              "221071407"
            ]
          },
          "221071407": {
            "id": "221071407",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这征兆是在暗示我…我只能和兄弟们一起打发时间，却永远找不到另一半吗？",
            "nextDialogs": [
              "221071408"
            ]
          },
          "221071408": {
            "id": "221071408",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "我，我想一个人静一静…"
          }
        }
      }
    },
    {
      "subId": "2210716",
      "subQuestName": "(test)向志华回报$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221071601"
        ],
        "dialogs": {
          "221071601": {
            "id": "221071601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我看见屋上有鸟成双对…",
            "nextDialogs": [
              "221071602"
            ]
          },
          "221071602": {
            "id": "221071602",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "嗯…嗯！好，这个好啊。",
            "nextDialogs": [
              "221071603"
            ]
          },
          "221071603": {
            "id": "221071603",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "两只相爱的鸽子远离族群，眼中只有彼此，只愿和对方比翼天涯。",
            "nextDialogs": [
              "221071604"
            ]
          },
          "221071604": {
            "id": "221071604",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这个征兆是在暗示…我一定会遇见那位只认定我一人的爱人。",
            "nextDialogs": [
              "221071605"
            ]
          },
          "221071605": {
            "id": "221071605",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "然后与她克服艰难险阻，脱离纷扰的人群，一起比翼天涯…",
            "nextDialogs": [
              "221071606"
            ]
          },
          "221071606": {
            "id": "221071606",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "咳！那个，辛苦你们了…",
            "nextDialogs": [
              "221071607"
            ]
          },
          "221071607": {
            "id": "221071607",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "也不知道，它们是因为什么契机相识，相知，相爱…",
            "nextDialogs": [
              "221071608"
            ]
          },
          "221071608": {
            "id": "221071608",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "唉。只是可惜，我不是鸽子，也不能尝到鸽子爱情的滋味，真是遗憾呐！",
            "nextDialogs": [
              "221071609"
            ]
          },
          "221071609": {
            "id": "221071609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "",
            "nextDialogs": [
              "221071610"
            ]
          },
          "221071610": {
            "id": "221071610",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "鸽子的滋味…等，等会。你…我…你不会是…",
            "nextDialogs": [
              "221071611"
            ]
          },
          "221071611": {
            "id": "221071611",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "你做了什么啊！我就是个比喻！比喻！爱情那是真能吃进嘴里尝味道的吗？！",
            "nextDialogs": [
              "221071612"
            ]
          },
          "221071612": {
            "id": "221071612",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "不解风情也不用到这种程度吧！而且这样的话，我的爱情运就…",
            "nextDialogs": [
              "221071613"
            ]
          },
          "221071613": {
            "id": "221071613",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "我…算了算了，我要一个人静一静，你去忙你自己的吧…"
          }
        }
      }
    },
    {
      "subId": "2210717",
      "subQuestName": "(test)向志华回报$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221071701"
        ],
        "dialogs": {
          "221071701": {
            "id": "221071701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于落叶…",
            "nextDialogs": [
              "221071702"
            ]
          },
          "221071702": {
            "id": "221071702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…这个和爱情，应该没什么关系吧？",
            "nextDialogs": [
              "221071703"
            ]
          },
          "221071703": {
            "id": "221071703",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "落叶？当然有关系了。",
            "nextDialogs": [
              "221071704"
            ]
          },
          "221071704": {
            "id": "221071704",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这些落叶，虽然看似凋零无用，但是只要有一点契机…",
            "nextDialogs": [
              "221071705"
            ]
          },
          "221071705": {
            "id": "221071705",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "有一点火星，它们就会热烈燃烧，有一缕微风，它们就会翩然而起。",
            "nextDialogs": [
              "221071706"
            ]
          },
          "221071706": {
            "id": "221071706",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这简直就是在暗示我积蓄已久的爱情，只要一点契机，我和绮命姐就会…",
            "nextDialogs": [
              "221071707"
            ]
          },
          "221071707": {
            "id": "221071707",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "唉，可惜缘分天定，这个契机会在什么时候，以什么形式降临，谁也不知道。",
            "nextDialogs": [
              "221071708"
            ]
          },
          "221071708": {
            "id": "221071708",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "但是也不用担心，百因必有果，只要耐心等待就好。",
            "nextDialogs": [
              "221071709"
            ]
          },
          "221071709": {
            "id": "221071709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那，那落叶的缘分就是我。",
            "nextDialogs": [
              "221071710"
            ]
          },
          "221071710": {
            "id": "221071710",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "什么？落叶的缘分就是你，什么意思？",
            "nextDialogs": [
              "221071711"
            ]
          },
          "221071711": {
            "id": "221071711",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "喂，等会，等会…你不会是把那堆落叶给…",
            "nextDialogs": [
              "221071712"
            ]
          },
          "221071712": {
            "id": "221071712",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "完了，全完了。提前降临的契机，只会把缘分和爱情弄得一团糟！",
            "nextDialogs": [
              "221071713"
            ]
          },
          "221071713": {
            "id": "221071713",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "你，你这哪是给落叶的缘分，你这是给落叶的报应吧！",
            "nextDialogs": [
              "221071714"
            ]
          },
          "221071714": {
            "id": "221071714",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这下子可怎么办…你，你忙你的去吧！我要一个人静静…"
          }
        }
      }
    },
    {
      "subId": "2210718",
      "subQuestName": "(test)向志华回报$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221071801"
        ],
        "dialogs": {
          "221071801": {
            "id": "221071801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有只猫和鱼成了朋友…",
            "nextDialogs": [
              "221071802"
            ]
          },
          "221071802": {
            "id": "221071802",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "居然能找到这种征兆，你真是有心了。",
            "nextDialogs": [
              "221071803"
            ]
          },
          "221071803": {
            "id": "221071803",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "在这种绝世的友谊里，无论是那只猫，还是那只鱼，都太伟大了…",
            "nextDialogs": [
              "221071804"
            ]
          },
          "221071804": {
            "id": "221071804",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "简直就像是爱情！爱情的力量，能够超越一切！",
            "nextDialogs": [
              "221071805"
            ]
          },
          "221071805": {
            "id": "221071805",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "如果可以的话，我真想向它们表达敬意。",
            "nextDialogs": [
              "221071806"
            ]
          },
          "221071806": {
            "id": "221071806",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "特别是那条鱼，明知是对方是只猫，却还是倾力表达。",
            "nextDialogs": [
              "221071807"
            ]
          },
          "221071807": {
            "id": "221071807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你现在可以表达了。",
            "nextDialogs": [
              "221071808"
            ]
          },
          "221071808": {
            "id": "221071808",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "什么意思？你把那条鱼给带来了…",
            "nextDialogs": [
              "221071809"
            ]
          },
          "221071809": {
            "id": "221071809",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "你…你不会是直接下去，把它给抓上来了吧！",
            "nextDialogs": [
              "221071810"
            ]
          },
          "221071810": {
            "id": "221071810",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这种超越物种的友谊！不是应该去用心保护吗？！",
            "nextDialogs": [
              "221071811"
            ]
          },
          "221071811": {
            "id": "221071811",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "而且好不容易找到这么好的征兆，你，你究竟做了什么…",
            "nextDialogs": [
              "221071812"
            ]
          },
          "221071812": {
            "id": "221071812",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "算了，麻烦你让我一个人待一会，我想静一静。"
          }
        }
      }
    },
    {
      "subId": "2210719",
      "subQuestName": "(test)向志华回报$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221071901"
        ],
        "dialogs": {
          "221071901": {
            "id": "221071901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有一群围在一起的小狗…",
            "nextDialogs": [
              "221071902"
            ]
          },
          "221071902": {
            "id": "221071902",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这，这是什么坏征兆，这是在说我的爱情已经到了尽头吗？",
            "nextDialogs": [
              "221071903"
            ]
          },
          "221071903": {
            "id": "221071903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？可是那群小狗的关系看起来很好啊。",
            "nextDialogs": [
              "221071904"
            ]
          },
          "221071904": {
            "id": "221071904",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "那几只小狗我知道，确实关系不错，而且常年都在一起玩。",
            "nextDialogs": [
              "221071905"
            ]
          },
          "221071905": {
            "id": "221071905",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "看起来确实不错，但是事实上…它们谁都没有找到另一半。",
            "nextDialogs": [
              "221071906"
            ]
          },
          "221071906": {
            "id": "221071906",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "而且因为有同伴可以一起玩，它们也根本不在意这件事。",
            "nextDialogs": [
              "221071907"
            ]
          },
          "221071907": {
            "id": "221071907",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它们现在有机会去找另一半了。",
            "nextDialogs": [
              "221071908"
            ]
          },
          "221071908": {
            "id": "221071908",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "什么意思？难道…你去把它们赶开了？",
            "nextDialogs": [
              "221071909"
            ]
          },
          "221071909": {
            "id": "221071909",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这，这样的话，倒也不错…",
            "nextDialogs": [
              "221071910"
            ]
          },
          "221071910": {
            "id": "221071910",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "能借助外力从迷惘中脱身，去追寻自己的真爱…",
            "nextDialogs": [
              "221071911"
            ]
          },
          "221071911": {
            "id": "221071911",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "太谢谢你了！我明白这个征兆是什么意思了。",
            "nextDialogs": [
              "221071912"
            ]
          },
          "221071912": {
            "id": "221071912",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "绮命姐，我一定会…"
          }
        }
      }
    },
    {
      "subId": "2210715",
      "subQuestName": "向志华回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

        ],
        "dialogs": {
          "221071501": {
            "id": "221071501",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "你们还有什么发现吗？",
            "nextDialogs": [
              "221071502"
            ]
          },
          "221071502": {
            "id": "221071502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "暂时就这些了。",
            "nextDialogs": [
              "221071503"
            ]
          },
          "221071503": {
            "id": "221071503",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "好吧，我得再去问问绮命姐…"
          }
        }
      }
    },
    {
      "subId": "2210721",
      "subQuestName": "(test)向志华回报$HIDDEN",
      "sceneId": null,

  "subQuests": [
    {
      "subId": "2210701",
      "subQuestName": "与志华对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221070101"
        ],
        "dialogs": {
          "221070101": {
            "id": "221070101",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "「爱情这种东西，远在天边，近在眼前。不需强求，总有一天会自己送到你眼前…」",
            "nextDialogs": [
              "221070102"
            ]
          },
          "221070102": {
            "id": "221070102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在说什么？",
            "nextDialogs": [
              "221070103"
            ]
          },
          "221070103": {
            "id": "221070103",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "当然是在说我的爱情运势啊。",
            "nextDialogs": [
              "221070104"
            ]
          },
          "221070104": {
            "id": "221070104",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "这句话，可是绮命姐为我指点的爱情运势，远在天边，近在眼前…",
            "nextDialogs": [
              "221070105"
            ]
          },
          "221070105": {
            "id": "221070105",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "她一定是在暗示我什么，但是到底在暗示什么呢？",
            "nextDialogs": [
              "221070106"
            ]
          },
          "221070106": {
            "id": "221070106",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "我听说书的人说，当人的「运势」到来时，身边的各种事物都会显出征兆来。",
            "nextDialogs": [
              "221070107"
            ]
          },
          "221070107": {
            "id": "221070107",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "我觉得我的「爱情运」已经到了！",
            "nextDialogs": [
              "221070108"
            ]
          },
          "221070108": {
            "id": "221070108",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "你能帮我去周围看看，有什么特别的「征兆」吗？",
            "nextDialogs": [
              "221070111",
              "221070112"
            ]
          },
          "221070111": {
            "id": "221070111",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "那就拜托你了！"
          },
          "221070112": {
            "id": "221070112",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "所谓「当局者迷，旁观者清」，要是我自己去看的话…",
            "nextDialogs": [
              "221070113"
            ]
          },
          "221070113": {
            "id": "221070113",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "无论看见什么，我都会觉得是在暗示我的「爱情运」到来啦。",
            "nextDialogs": [
              "221070114"
            ]
          },
          "221070114": {
            "id": "221070114",
            "speakerId": 2001,
            "speakerName": "志华",
            "text": "所以，一切都拜托你了！"
          }
        }
      }
    },

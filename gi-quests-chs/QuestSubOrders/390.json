    {
      "subId": "39004",
      "subQuestName": "与温迪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3900401"
        ],
        "dialogs": {
          "3900401": {
            "id": "3900401",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "看来我们破除机关的方式是正确的。",
            "nextDialogs": [
              "3900402"
            ]
          },
          "3900402": {
            "id": "3900402",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "现在这座塔里，还有三层护封的辉环…",
            "nextDialogs": [
              "3900403"
            ]
          },
          "3900403": {
            "id": "3900403",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "也就是说，还要寻找三座<color=#00E1FFFF>「导光机关」</color>，才能解开所有封印。",
            "nextDialogs": [
              "3900404"
            ]
          },
          "3900404": {
            "id": "3900404",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "看，从这里就能看到一座…",
            "nextDialogs": [
              "3900405"
            ]
          },
          "3900405": {
            "id": "3900405",
            "speakerId": 1001,
            "speakerName": "琴",
            "text": "剩下的也一定都在废墟内部，围绕这座高塔分布。找找看吧。",
            "nextDialogs": [
              "3900406"
            ]
          },
          "3900406": {
            "id": "3900406",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "…住在这种又是机关又是封印的地方，特瓦林平时回家不嫌麻烦吗？",
            "nextDialogs": [
              "3900407"
            ]
          },
          "3900407": {
            "id": "3900407",
            "speakerId": 1000,
            "speakerName": "温迪",
            "text": "它不用从走人的地方走啊，它用飞的。",
            "nextDialogs": [
              "3900408"
            ]
          },
          "3900408": {
            "id": "3900408",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "…你，说得很有道理。"
          }
        }
      }
    },

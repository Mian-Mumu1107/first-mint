    {
      "subId": "7250102",
      "subQuestName": "与朝雾对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "725010201"
        ],
        "dialogs": {
          "725010201": {
            "id": "725010201",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "森子小姐怎么总是分给我这种奇怪的稿件啊…",
            "nextDialogs": [
              "725010204"
            ]
          },
          "725010204": {
            "id": "725010204",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "呀！旅行者，你怎么来了，好久没看到你，我还以为你已经去别的地方旅行了呢。",
            "nextDialogs": [
              "725010205"
            ]
          },
          "725010205": {
            "id": "725010205",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "唉…要是我身体能好点，我也想和你一样出去旅行。",
            "nextDialogs": [
              "725010206"
            ]
          },
          "725010206": {
            "id": "725010206",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "这样的话，就不用每天都被森子小姐当面催稿了…",
            "nextDialogs": [
              "725010207"
            ]
          },
          "725010207": {
            "id": "725010207",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "上次我画的那些稿件似乎很受好评，好多老师都专门要我给他们画插画。",
            "nextDialogs": [
              "725010230"
            ]
          },
          "725010230": {
            "id": "725010230",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "虽然森子小姐已经帮我推掉了很多约稿，但留下来的那一部分也还是太多了…",
            "nextDialogs": [
              "725010209"
            ]
          },
          "725010209": {
            "id": "725010209",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "我最开始以为他们除了稻妻之外，最多就写一写蒙德啦，璃月啦…",
            "nextDialogs": [
              "725010210"
            ]
          },
          "725010210": {
            "id": "725010210",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "但老师们笔下小说的题材…已经立足须弥，放眼枫丹啦。",
            "nextDialogs": [
              "725010216"
            ]
          },
          "725010216": {
            "id": "725010216",
            "speakerId": 1000,
            "speakerName": "朝雾",
            "text": "嗯…说回正事，旅行者啊，你手上的那台「留影机」还好吧…"
          }
        }
      }
    }
  ]
}
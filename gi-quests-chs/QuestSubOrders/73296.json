          },
          "732960602": {
            "id": "732960602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…那准备好之后再出发吧！"
          }
        }
      }
    },
    {
      "subId": "7329614",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732961401"
        ],
        "dialogs": {
          "732961401": {
            "id": "732961401",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "离开城市的好处是不用特意准备狗粮了。反正「胡椒」这么能干，自己的口粮自己想办法吧。",
            "nextDialogs": [
              "732961402"
            ]
          },
          "732961402": {
            "id": "732961402",
            "speakerId": 1000,
            "speakerName": "于连",

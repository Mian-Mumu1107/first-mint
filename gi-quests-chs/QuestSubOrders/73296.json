    {
      "subId": "7329602",
      "subQuestName": "前往水边营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732960201"
        ],
        "dialogs": {
          "732960201": {
            "id": "732960201",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "#派蒙，还有{NICKNAME}，你们果然来了！出门在外还是得靠朋友啊。",
            "nextDialogs": [
              "732960202"
            ]
          },
          "732960202": {
            "id": "732960202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "因为答应了给你带路嘛，而且带路也不是什么难事！举手之劳…这时候该说是举足之劳吗？",
            "nextDialogs": [
              "732960203"
            ]
          },
          "732960203": {
            "id": "732960203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，你真的这么快就回枫丹吗？难得到了须弥，其实须弥可看的风景还是很多的…",
            "nextDialogs": [
              "732960205",
              "732960207"
            ]
          },
          "732960205": {
            "id": "732960205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有很多树，很多河！",
            "nextDialogs": [
              "732960208"
            ]
          },
          "732960208": {
            "id": "732960208",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "听起来确实很诱人，但是我想…我其实还没有做好远游的准备。这次虽然是一次失败的旅行，但是也算是收获了一些教训吧…",
            "nextDialogs": [
              "732960209"
            ]
          },
          "732960209": {
            "id": "732960209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…那…那这附近也有很值得一看的景观呢！要是错过就太可惜啦。",
            "nextDialogs": [
              "732960210"
            ]
          },
          "732960210": {
            "id": "732960210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙推荐的地方准没错。",
            "nextDialogs": [
              "732960211"
            ]
          },
          "732960211": {
            "id": "732960211",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "既然两位坚持，我再推辞就显得对好朋友失礼了。",
            "nextDialogs": [
              "732960212"
            ]
          },
          "732960212": {
            "id": "732960212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，我可是提瓦特的最佳向导，带路就交给我吧！你们可不要掉队啦。"
          },
          "732960207": {
            "id": "732960207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有很多沙，很多遗迹！"
          }
        }
      }
    },
    {
      "subId": "7329603",
      "subQuestName": "前往甘露花海",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732960301"
        ],
        "dialogs": {
          "732960301": {
            "id": "732960301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听说画家在动笔之前都会从不同角度观察…这应该不是什么「刻板印象」吧？",
            "nextDialogs": [
              "732960302"
            ]
          },
          "732960302": {
            "id": "732960302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们一起在附近转转？还可以去视野更好的高处观察一下！",
            "nextDialogs": [
              "732960303"
            ]
          },
          "732960303": {
            "id": "732960303",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "听起来是个不错的主意，我已经准备好出发了。",
            "nextDialogs": [
              "732960304"
            ]
          },
          "732960304": {
            "id": "732960304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#对了，不如我们比比谁先到终点？{NICKNAME}，准备好出发了吗？"
          }
        }
      }
    },
    {
      "subId": "7329604",
      "subQuestName": "与于连对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732960401"
        ],
        "dialogs": {
          "732960401": {
            "id": "732960401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "充满了大自然的气息…是不是很适合写生和寻找灵感？",
            "nextDialogs": [
              "732960402"
            ]
          },
          "732960402": {
            "id": "732960402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是刻板印象啦。",
            "nextDialogs": [
              "732960403"
            ]
          },
          "732960403": {
            "id": "732960403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…可是如果是我就会很想提起画笔呢，这里的景物都有种充满生命力的美，而且色彩也都很绚丽…",
            "nextDialogs": [
              "732960404"
            ]
          },
          "732960404": {
            "id": "732960404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "咳。",
            "nextDialogs": [
              "732960405"
            ]
          },
          "732960405": {
            "id": "732960405",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊…",
            "nextDialogs": [
              "732960406"
            ]
          },
          "732960406": {
            "id": "732960406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对不起…我不是…",
            "nextDialogs": [
              "732960407"
            ]
          },
          "732960407": {
            "id": "732960407",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "哈哈，没关系，我只是看到了不同的景色。但是美是共通的，对吧？",
            "nextDialogs": [
              "732960408"
            ]
          },
          "732960408": {
            "id": "732960408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！我很喜欢这里的景色呢，感觉心灵都被净化了。",
            "nextDialogs": [
              "732960409"
            ]
          },
          "732960409": {
            "id": "732960409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙的心灵应该不需要净化吧。",
            "nextDialogs": [
              "732960410"
            ]
          },
          "732960410": {
            "id": "732960410",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "两位好朋友，给了我这样一个一开始甚至没有说实话的陌生人这么多的善意…",
            "nextDialogs": [
              "732960411"
            ]
          },
          "732960411": {
            "id": "732960411",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "两位都是有着纯洁心灵的好人。",
            "nextDialogs": [
              "732960412"
            ]
          },
          "732960412": {
            "id": "732960412",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿…倒也不用这么夸奖啦。对了，其实还有更特别的景色呢！",
            "nextDialogs": [
              "732960413"
            ]
          },
          "732960413": {
            "id": "732960413",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你一定知道我在说什么，也让于连见识一下吧！"
          }
        }
      }
    },
    {
      "subId": "7329612",
      "subQuestName": "与于连对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {

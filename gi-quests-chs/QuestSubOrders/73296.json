    {
      "subId": "7329605",
      "subQuestName": "前往视野更好的高处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7329613",
      "subQuestName": "与于连对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732961601"
        ],
        "dialogs": {
          "732961601": {
            "id": "732961601",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "呼…想…想不到画画对体力的要求也这么高，早知道我就…",
            "nextDialogs": [
              "732961602"
            ]
          },
          "732961602": {
            "id": "732961602",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来对于连来说还是太勉强了…",
            "nextDialogs": [
              "732961603"
            ]
          },
          "732961603": {
            "id": "732961603",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "毕…毕竟是刚养好伤…呼…",
            "nextDialogs": [
              "732961604"
            ]
          },
          "732961604": {
            "id": "732961604",
            "speakerId": 1000,
            "speakerName": "于连",
            "text": "不过这里的风景的确很独特，真奇怪，为什么之前都没注意到…",
            "nextDialogs": [
              "732961605"
            ]
          },
          "732961605": {
            "id": "732961605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "前边视野应该也不错，我们去那边看看吧，要小心一点哦！"
          }
        }
      }
    },
    {
      "subId": "7329611",
      "subQuestName": "离开高处，继续向前",
      "sceneId": null,

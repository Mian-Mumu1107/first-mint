    {
      "subId": "7902205",
      "subQuestName": "将内有照片的怀表交给藏镜仕女",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790220501"
        ],
        "dialogs": {
          "790220501": {
            "id": "790220501",
            "speakerId": 1002,
            "speakerName": "(test)派蒙",
            "text": "(test)显然不可能她说什么我们就听什么，或许是其他的诡计",
            "nextDialogs": [
              "790220502"
            ]
          },
          "790220502": {

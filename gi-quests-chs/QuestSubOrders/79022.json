  "subQuests": [
    {
      "subId": "7902201",
      "subQuestName": "与奇怪的愚人众对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790220101"
        ],
        "dialogs": {
          "790220101": {
            "id": "790220101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里怎么有愚人众，这名藏镜仕女…",
            "nextDialogs": [
              "790220102"
            ]
          },
          "790220102": {
            "id": "790220102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他们留在这里，不会又在搞什么阴谋诡计吧。",
            "nextDialogs": [
              "790220103"
            ]
          },
          "790220103": {
            "id": "790220103",
            "speakerId": 1001,
            "speakerName": "藏镜仕女",
            "text": "…要赶快回去…要赶快回去，他还在…可是，哥哥们不见了，哥哥们的照片…",
            "nextDialogs": [
              "790220104"
            ]
          },
          "790220104": {
            "id": "790220104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂，你是谁，在这里有什么企图！",
            "nextDialogs": [
              "790220105"
            ]
          },
          "790220105": {
            "id": "790220105",
            "speakerId": 1001,
            "speakerName": "藏镜仕女",
            "text": "哥哥们的照片…丢了照片，就回不去了…",
            "nextDialogs": [
              "790220106"
            ]
          },
          "790220106": {
            "id": "790220106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "愚人众的！",
            "nextDialogs": [
              "790220107"
            ]
          },
          "790220107": {
            "id": "790220107",
            "speakerId": 1001,
            "speakerName": "藏镜仕女",
            "text": "不能，把他丢下…不能让他一个人…",
            "nextDialogs": [
              "790220110"
            ]
          },
          "790220110": {
            "id": "790220110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…不过真有点在意为什么会有一个藏镜仕女在这儿呢…",
            "nextDialogs": [
              "790220111"
            ]
          },
          "790220111": {
            "id": "790220111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，不如我们想办法让她清醒过来，然后好好问问这些散落在外的愚人众在做什么吧！",
            "nextDialogs": [
              "790220112"
            ]
          },
          "790220112": {
            "id": "790220112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实不能放着不管…",
            "nextDialogs": [
              "790220113"
            ]
          },
          "790220113": {
            "id": "790220113",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，虽然只是一个不太正常的愚人众…但是放任不管的话总觉得不是什么好事呢。",
            "nextDialogs": [
              "790220114"
            ]
          },
          "790220114": {
            "id": "790220114",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过，她到底为什么会变成现在这样啊…",
            "nextDialogs": [
              "790220115"
            ]
          },
          "790220115": {
            "id": "790220115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为那个装置吧…",
            "nextDialogs": [
              "790220116"
            ]
          },
          "790220116": {
            "id": "790220116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，是哦，那个装置影响了岛上所有的人…不过那个装置明明已经关闭了…",
            "nextDialogs": [
              "790220117"
            ]
          },
          "790220117": {
            "id": "790220117",
            "speakerId": 1001,
            "speakerName": "藏镜仕女",
            "text": "哥哥们和我的合照…要是那个找不回来了，我就没法回去，可是…可是他还在那里，独自等着我…",
            "nextDialogs": [
              "790220118"
            ]
          },
          "790220118": {
            "id": "790220118",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#我明白了…{NICKNAME}，我们把她心心念念的什么合照找来吧，说不定就能让她清醒过来了！"
          }
        }
      }
    },

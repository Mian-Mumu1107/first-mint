    {
      "subId": "7400004",
      "subQuestName": "(test)总控环-检测3只狗成功$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740000401"
        ],
        "dialogs": {
          "740000401": {
            "id": "740000401",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "好孩子，就靠你们把那三个不听话的坏东西带回家了。"
          }
        }
      }
    },
    {
      "subId": "7400012",
      "subQuestName": "（test）隐藏小女孩$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740001201"
        ],
        "dialogs": {
          "740001201": {
            "id": "740001201",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "原来这就是卡特哥哥说的，我不知道的我的家。",
            "nextDialogs": [
              "740001202"
            ]
          },
          "740001202": {
            "id": "740001202",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "欢迎回家，孩子，不管怎么说，回来就好…"
          }
        }
      }
    },
    {
      "subId": "7400015",
      "subQuestName": "与恩肖对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740000601"
        ],
        "dialogs": {
          "740000601": {
            "id": "740000601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "本以为是更轻松的任务，没想到它们这么任性…",
            "nextDialogs": [
              "740000602"
            ]
          },
          "740000602": {
            "id": "740000602",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "好孩子，现在你应该知道了，越是任性就越得让它们知道规矩。",
            "nextDialogs": [
              "740000604",
              "740000606"
            ]
          },
          "740000604": {
            "id": "740000604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}要是也能飞就好了，脚踏实地可真辛苦呀。",
            "nextDialogs": [
              "740000607"
            ]
          },
          "740000607": {
            "id": "740000607",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "既然累了，就休息一会儿再走。正好做了塔塞斯杂烩，你们也来尝尝吧。",
            "nextDialogs": [
              "740000608"
            ]
          },
          "740000608": {
            "id": "740000608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有好吃的吗！啊…可、可是这样不好吧…要不还是算了。",
            "nextDialogs": [
              "740000609"
            ]
          },
          "740000609": {
            "id": "740000609",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "怎么，难道是信不过我的手艺？不说别的，塔塞斯杂烩可是我的拿手菜。",
            "nextDialogs": [
              "740000610"
            ]
          },
          "740000610": {
            "id": "740000610",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我的意思是，这样会不会也算是不守规矩…",
            "nextDialogs": [
              "740000611"
            ]
          },
          "740000611": {
            "id": "740000611",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "你们付出了劳动，这是你们应得的。吃饱了才有力气继续劳动。对了，你们是冒险家…那更应该多吃点。",
            "nextDialogs": [
              "740000612"
            ]
          },
          "740000612": {
            "id": "740000612",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "还有正式委托的报酬，之后会支付给你们。这是合乎委托的规矩的吧。",
            "nextDialogs": [
              "740000613"
            ]
          },
          "740000613": {
            "id": "740000613",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，既然是这样，那我们就不客气啦！",
            "nextDialogs": [
              "740000614"
            ]
          },
          "740000614": {
            "id": "740000614",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "被老人邀请至屋内，享用了并不精致的塔塞斯杂烩。炖菜的暖意沁入心脾，感觉疲惫也被一扫而空…",
            "nextDialogs": [
              "740000615"
            ]
          },
          "740000615": {
            "id": "740000615",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "劳动之后的料理总是格外美味呢！而且塔塞斯杂烩该怎么说呢，很有家庭的味道？",
            "nextDialogs": [
              "740000616"
            ]
          },
          "740000616": {
            "id": "740000616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "因为食材和料理方法都很普通吧。",
            "nextDialogs": [
              "740000617"
            ]
          },
          "740000617": {
            "id": "740000617",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "普通但是好吃！",
            "nextDialogs": [
              "740000618"
            ]
          },
          "740000618": {
            "id": "740000618",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "那当然了，我们家的倔丫头也对这道菜赞不绝口。就算是闹别扭，只要闻到炖菜的香气，一定乖乖到餐厅坐下。",
            "nextDialogs": [
              "740000619"
            ]
          },
          "740000619": {
            "id": "740000619",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "现在嘛，她走得太远了，闻不到了。多半是连回家的路该怎么走也忘得一干二净了。",
            "nextDialogs": [
              "740000620"
            ]
          },
          "740000620": {
            "id": "740000620",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这…对了，我们也可以帮忙找人的，恩肖爷爷要是愿意给我们讲讲她的特征，说不定我们能帮你找到她呢。",
            "nextDialogs": [
              "740000621"
            ]
          },
          "740000621": {
            "id": "740000621",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "如果在旅途中遇到的话。",
            "nextDialogs": [
              "740000622"
            ]
          },
          "740000622": {
            "id": "740000622",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "好心的孩子，谢谢你们。我要找她倒不是难事，毕竟之前她也托人送了几封信回来。",
            "nextDialogs": [
              "740000623"
            ]
          },
          "740000623": {
            "id": "740000623",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "不过我看她是完全不觉得自己有错，不然怎么会只寄信，而不是自己回家？",
            "nextDialogs": [
              "740000624"
            ]
          },
          "740000624": {
            "id": "740000624",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "所以她的信我是一个字也没看，拆也没拆。动物不懂事便罢了，她可是个大姑娘了，她也不懂吗？",
            "nextDialogs": [
              "740000625"
            ]
          },
          "740000625": {
            "id": "740000625",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "说起来，最近也没再收到她的信…大概是知道自讨没趣了吧。",
            "nextDialogs": [
              "740000626"
            ]
          },
          "740000626": {
            "id": "740000626",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "总之，我可不会专门雇人找到她再带她回家。要么她自己回家认错，要么就再也别回来了。",
            "nextDialogs": [
              "740000627"
            ]
          },
          "740000627": {
            "id": "740000627",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好、好吧…既然你这样说…",
            "nextDialogs": [
              "740000628"
            ]
          },
          "740000628": {
            "id": "740000628",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "不管怎么说，谢谢你们帮忙把勇士它们几个带回来。虽然报酬不多…这里还有些塔塞斯杂烩，给你们带上。",
            "nextDialogs": [
              "740000629"
            ]
          },
          "740000629": {
            "id": "740000629",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "冒险家经常要在野外露宿吧？记得吃饱穿暖，别饿着冻着了。",
            "nextDialogs": [
              "740000630"
            ]
          },
          "740000630": {
            "id": "740000630",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯！恩肖爷爷也要快些把腿伤养好呀。",
            "nextDialogs": [
              "740000631"
            ]
          },
          "740000631": {
            "id": "740000631",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "注意安全，照顾好自己！"
          },
          "740000606": {
            "id": "740000606",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我哪有很任性…不对！我可不是什么不听话的宠物狗啊！"
          }
        }
      }
    },
    {
      "subId": "7400016",
      "subQuestName": "与恩肖对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740000701"
        ],
        "dialogs": {
          "740000701": {
            "id": "740000701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这任务…比想象中麻烦欸。",
            "nextDialogs": [
              "740000702"
            ]
          },
          "740000702": {
            "id": "740000702",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "因为花园里的巨人真的很爱那些紫色的小花，而且总是有很多规矩嘛。",
            "nextDialogs": [
              "740000703"
            ]
          },
          "740000703": {
            "id": "740000703",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "不听话的孩子就该早点学会守规矩，免得长大了更难管教。",
            "nextDialogs": [
              "740000705",
              "740000707"
            ]
          },
          "740000705": {
            "id": "740000705",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？关我什么事呀，我可不是不听话的小孩，哼。",
            "nextDialogs": [
              "740000708"
            ]
          },
          "740000708": {
            "id": "740000708",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "你们都玩累了吧？正好今天也做了塔塞斯杂烩，一起坐下吃点吧。",
            "nextDialogs": [
              "740000709"
            ]
          },
          "740000709": {
            "id": "740000709",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "#是呀是呀！{NICKNAME}{M#哥哥}{F#姐姐}，派蒙姐姐，我们一起吃吧！",
            "nextDialogs": [
              "740000710"
            ]
          },
          "740000710": {
            "id": "740000710",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#好欸！既然莉诺尔都这么说了，{NICKNAME}，我们就不要推辞了吧，嘿嘿。",
            "nextDialogs": [
              "740000711"
            ]
          },
          "740000711": {
            "id": "740000711",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就感谢招待了。",
            "nextDialogs": [
              "740000712"
            ]
          },
          "740000712": {
            "id": "740000712",
            "speakerId": 1002,
            "speakerName": "恩肖",
            "text": "你们是莉诺尔的朋友， 客气什么。",
            "nextDialogs": [
              "740000713"
            ]
          },
          "740000713": {
            "id": "740000713",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "被邀请到室内，享用了并不精致但十分美味的塔塞斯杂烩。\\n席间，分享了一些旅途的见闻，引得老人啧啧称奇，少女咯咯发笑。\\n在谈笑声中度过了一段欢乐的时光…",
            "nextDialogs": [
              "740000714"
            ]
          },
          "740000714": {
            "id": "740000714",
            "speakerId": 1003,
            "speakerName": "莉诺尔",
            "text": "怎么样？外公的手艺是不是胜过韦尔赛叔叔？"
          },
          "740000707": {
            "id": "740000707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，可是我根本不会踩到花，而且不需要女巫帮忙就可以飞过高墙哦！"
          }
        }
      }
    },

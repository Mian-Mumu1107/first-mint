    {
      "subId": "2002801",
      "subQuestName": "前去查看详请",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200280101"
        ],
        "dialogs": {
          "200280101": {
            "id": "200280101",
            "speakerId": 1000,
            "speakerName": "胆小的莫罗",
            "text": "#谢，谢谢你，{NICKNAME}…",
            "nextDialogs": [
              "200280102"
            ]
          },
          "200280102": {
            "id": "200280102",
            "speakerId": 1000,
            "speakerName": "胆小的莫罗",
            "text": "虽然是猎人…但是我也拿这些史莱姆没办法。",
            "nextDialogs": [
              "200280103"
            ]
          },
          "200280103": {
            "id": "200280103",
            "speakerId": 1000,
            "speakerName": "胆小的莫罗",
            "text": "被这群家伙一搅合，这次狩猎我又什么都带不回去了。",
            "nextDialogs": [
              "200280104"
            ]
          },
          "200280104": {
            "id": "200280104",
            "speakerId": 1000,
            "speakerName": "胆小的莫罗",
            "text": "只希望别的猎人不要和我一样倒霉…",
            "nextDialogs": [
              "200280105"
            ]
          },
          "200280105": {
            "id": "200280105",
            "speakerId": 1000,
            "speakerName": "胆小的莫罗",
            "text": "对了，说起这个，能请你去周围看看吗？",
            "nextDialogs": [
              "200280106"
            ]
          },
          "200280106": {
            "id": "200280106",
            "speakerId": 1000,
            "speakerName": "胆小的莫罗",
            "text": "不知道是不是我的错觉，在镇子周围…史莱姆好像越来越多了。",
            "nextDialogs": [
              "200280107"
            ]
          },
          "200280107": {
            "id": "200280107",
            "speakerId": 1000,
            "speakerName": "胆小的莫罗",
            "text": "请你去前头看看吧。如果发现了史莱姆，就直接把它们消灭掉吧。",
            "nextDialogs": [
              "200280110",
              "200280112"
            ]
          },
          "200280110": {
            "id": "200280110",
            "speakerId": 1000,
            "speakerName": "胆小的莫罗",
            "text": "那就拜托你了，我也会回去和杜拉夫先生报告的。",
            "nextDialogs": [
              "200280111"
            ]
          },
          "200280111": {
            "id": "200280111",
            "speakerId": 1000,
            "speakerName": "胆小的莫罗",
            "text": "希望他别喝太多了，能听进去我说的话…"
          },
          "200280112": {
            "id": "200280112",
            "speakerId": 1000,
            "speakerName": "胆小的莫罗",
            "text": "但有能力能解决这件事的人，只有你了。为了清泉镇，就拜托你了。"
          }
        }
      }
    },
    {

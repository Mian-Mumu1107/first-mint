        "startDialogs": [
          "706590301"
        ],
        "dialogs": {
          "706590301": {
            "id": "706590301",
            "speakerId": 30051,
            "speakerName": "吉盖克斯",
            "text": "咳，不说这么多了，不如你直接来试玩一下吧。",
            "nextDialogs": [
              "706590304"
            ]
          },
          "706590304": {
            "id": "706590304",
            "speakerId": 30051,
            "speakerName": "吉盖克斯",
            "text": "好吧，如果有兴趣试玩「风行迷踪」的话，就过来找我吧。"
          }
        }
      }
    }
  ]
}
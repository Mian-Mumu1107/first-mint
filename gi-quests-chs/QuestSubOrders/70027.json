  "subQuests": [
    {
      "subId": "7002701",
      "subQuestName": "与胡塞尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700270101"
        ],
        "dialogs": {
          "700270101": {
            "id": "700270101",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "你来的正好，「普尔希娜光钉」的维修工作一切顺利。",
            "nextDialogs": [
              "700270102"
            ]
          },
          "700270102": {
            "id": "700270102",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "只要有了这些元件，我有把握以最快的速度修好。",
            "nextDialogs": [
              "700270103"
            ]
          },
          "700270103": {
            "id": "700270103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我收集了一些。",
            "nextDialogs": [
              "700270104"
            ]
          },
          "700270104": {
            "id": "700270104",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "太好了，这真是帮了大忙。",
            "nextDialogs": [
              "700270105"
            ]
          },
          "700270105": {
            "id": "700270105",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "只要有了这些元件，我有把握以最快的速度修好",
            "nextDialogs": [
              "700270106"
            ]
          },
          "700270106": {
            "id": "700270106",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "不过还有件小事，我想还是先跟你商量一下比较好。",
            "nextDialogs": [
              "700270107"
            ]
          },
          "700270107": {
            "id": "700270107",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "在你收集元件的这几天里，我仔细研究了一下「普尔希娜光钉」的内部结构。",
            "nextDialogs": [
              "700270108"
            ]
          },
          "700270108": {
            "id": "700270108",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "它的结构非常巧妙，不愧是那位普尔希娜前辈制作出来的精妙仪器。",
            "nextDialogs": [
              "700270109"
            ]
          },
          "700270109": {
            "id": "700270109",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "任何一处调整都有可能影响到整体功能，所以我有些担心调整是否能达到预期效果。",
            "nextDialogs": [
              "700270110"
            ]
          },
          "700270110": {
            "id": "700270110",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "保险起见，我希望能拜托你先试用数次，我会根据你试用期间的数据对它进行再校准。",
            "nextDialogs": [
              "700270111"
            ]
          },
          "700270111": {
            "id": "700270111",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "这样才能保证「普尔希娜光钉」的最终效果，要不然，等到你在与特异体交手的时候，万一它出现了故障，那可就糟了。",
            "nextDialogs": [
              "700270114"
            ]
          },
          "700270114": {
            "id": "700270114",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "这也是我第一次实际操作「普尔希娜光钉」，我们还是谨慎些为好。",
            "nextDialogs": [
              "700270115"
            ]
          },
          "700270115": {
            "id": "700270115",
            "speakerId": 30068,
            "speakerName": "胡塞尼",
            "text": "那么，就拜托你多多试用了。"
          }
        }
      }
    },

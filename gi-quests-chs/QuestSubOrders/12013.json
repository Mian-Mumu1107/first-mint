  "subQuests": [
    {
      "subId": "1201310",
      "subQuestName": "沿路出城寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120131001"
        ],
        "dialogs": {
          "120131001": {
            "id": "120131001",
            "speakerId": 12052,
            "speakerName": "森彦",
            "text": "你们路上要小心啊。",
            "nextDialogs": [
              "120131002"
            ]
          },
          "120131002": {
            "id": "120131002",
            "speakerId": 12052,
            "speakerName": "森彦",
            "text": "对方可是天领奉行众，千万别太莽撞了。"
          }
        }
      }
    },
    {
      "subId": "1201301",
      "subQuestName": "和孩子们交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120130101"
        ],
        "dialogs": {
          "120130101": {
            "id": "120130101",
            "speakerId": 12027,
            "speakerName": "松坂",
            "text": "宵宫姐姐好！对付「大貉妖」的武器，宵宫姐姐做好了吗？",
            "nextDialogs": [
              "120130102"
            ]
          },
          "120130102": {
            "id": "120130102",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "那个我已经拜托给龙之介伯伯了，等会儿你们就去找他拿吧。",
            "nextDialogs": [
              "120130103"
            ]
          },
          "120130103": {
            "id": "120130103",
            "speakerId": 12028,
            "speakerName": "彩香",
            "text": "欸？难道姐姐不陪我们玩了吗？",
            "nextDialogs": [
              "120130104"
            ]
          },
          "120130104": {
            "id": "120130104",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "对不起，姐姐还有些重要的事，会稍微晚一点回来。",
            "nextDialogs": [
              "120130105"
            ]
          },
          "120130105": {
            "id": "120130105",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "下次给你们带糖果吧！就是你们喜欢的，很甜很甜的那种糖。",
            "nextDialogs": [
              "120130106"
            ]
          },
          "120130106": {
            "id": "120130106",
            "speakerId": 12029,
            "speakerName": "岩夫",
            "text": "好！又有糖吃啦！",
            "nextDialogs": [
              "120130107"
            ]
          },
          "120130107": {
            "id": "120130107",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "对了，我有个事想打听，你们刚刚看到了一群看起来很凶的叔叔经过这里吗？",
            "nextDialogs": [
              "120130108"
            ]
          },
          "120130108": {
            "id": "120130108",
            "speakerId": 12028,
            "speakerName": "彩香",
            "text": "有的有的，他们好像在抓什么人！",
            "nextDialogs": [
              "120130109"
            ]
          },
          "120130109": {
            "id": "120130109",
            "speakerId": 12029,
            "speakerName": "岩夫",
            "text": "他们是不是也在抓妖怪啊？",
            "nextDialogs": [
              "120130110"
            ]
          },
          "120130110": {
            "id": "120130110",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "没事，你们不用担心，是叔叔他们误会了。",
            "nextDialogs": [
              "120130111"
            ]
          },
          "120130111": {
            "id": "120130111",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "你们听话，留在城里，等烟花会开始了就和大家一起玩吧。",
            "nextDialogs": [
              "120130112"
            ]
          },
          "120130112": {
            "id": "120130112",
            "speakerId": 12027,
            "speakerName": "松坂",
            "text": "嗯，会好好听话的！宵宫姐姐说什么我们就做什么！"
          }
        }
      }
    },
    {
      "subId": "1201311",
      "subQuestName": "按照孩子们指示的方向前进",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1201302",
      "subQuestName": "接近拦路的天领奉行众",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120130201"
        ],
        "dialogs": {
          "120130201": {
            "id": "120130201",
            "speakerId": 12031,
            "speakerName": "义高",
            "text": "前方正在执行公务，禁止通行。",
            "nextDialogs": [
              "120130202"
            ]
          },
          "120130202": {
            "id": "120130202",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "朔次郎和佳祐就在里面对吧？我们有事情要找他们。",
            "nextDialogs": [
              "120130203"
            ]
          },
          "120130203": {
            "id": "120130203",
            "speakerId": 12031,
            "speakerName": "义高",
            "text": "听不懂话吗？说了禁止通行。",
            "nextDialogs": [
              "120130204"
            ]
          },
          "120130204": {
            "id": "120130204",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "真碍事，那就别怪我们不客气了！"
          }
        }
      }
    },
    {
      "subId": "1201303",
      "subQuestName": "击败天领奉行众",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120130301"
        ],
        "dialogs": {
          "120130301": {
            "id": "120130301",
            "speakerId": 12031,
            "speakerName": "义高",
            "text": "你们胆敢妨碍公务，好大的胆子！",
            "nextDialogs": [
              "120130302"
            ]
          },
          "120130302": {
            "id": "120130302",
            "speakerId": 12031,
            "speakerName": "义高",
            "text": "这种行为，天领奉行定会严惩！",
            "nextDialogs": [
              "120130303"
            ]
          },
          "120130303": {
            "id": "120130303",
            "speakerId": 12031,
            "speakerName": "义高",
            "text": "就算你们逃到天涯海角，也休想逃脱制裁！",
            "nextDialogs": [
              "120130304"
            ]
          },
          "120130304": {
            "id": "120130304",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "说得这么吓人，跑得比谁都快。",
            "nextDialogs": [
              "120130305"
            ]
          },
          "120130305": {
            "id": "120130305",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "没时间耽误在他们的身上了，我们继续往里面走吧，应该就在里面了。"
          }
        }
      }
    },
    {
      "subId": "1201304",
      "subQuestName": "与仓皇的天领奉行众交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1201305",
      "subQuestName": "继续深入，寻找朔次郎",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120130501"
        ],
        "dialogs": {
          "120130501": {
            "id": "120130501",
            "speakerId": 12025,
            "speakerName": "朔次郎",
            "text": "哈啊…哈啊…",
            "nextDialogs": [
              "120130502"
            ]
          },
          "120130502": {
            "id": "120130502",
            "speakerId": 12026,
            "speakerName": "今谷佳祐",
            "text": "你的剑技，很久没有提升了，朔次郎。",
            "nextDialogs": [
              "120130503"
            ]
          },
          "120130503": {
            "id": "120130503",
            "speakerId": 12026,
            "speakerName": "今谷佳祐",
            "text": "你明知道和我决斗，是不可能有胜算的。",
            "nextDialogs": [
              "120130504"
            ]
          },
          "120130504": {
            "id": "120130504",
            "speakerId": 12025,
            "speakerName": "朔次郎",
            "text": "我没想到，最后会落到你的手上。",
            "nextDialogs": [
              "120130505"
            ]
          },
          "120130505": {
            "id": "120130505",
            "speakerId": 12025,
            "speakerName": "朔次郎",
            "text": "……",
            "nextDialogs": [
              "120130506"
            ]
          },
          "120130506": {
            "id": "120130506",
            "speakerId": 12025,
            "speakerName": "朔次郎",
            "text": "我认了，这就是命运吧，我已经没什么想说了。",
            "nextDialogs": [
              "120130507"
            ]
          },
          "120130507": {
            "id": "120130507",
            "speakerId": 12026,
            "speakerName": "今谷佳祐",
            "text": "但至少你回来就说明，你最终还是认同了我的想法。",
            "nextDialogs": [
              "120130508"
            ]
          },
          "120130508": {
            "id": "120130508",
            "speakerId": 12025,
            "speakerName": "朔次郎",
            "text": "随你怎么说吧。",
            "nextDialogs": [
              "120130509"
            ]
          },
          "120130509": {
            "id": "120130509",
            "speakerId": 12026,
            "speakerName": "今谷佳祐",
            "text": "跟我回天领奉行，听候发落。",
            "nextDialogs": [
              "120130510"
            ]
          },
          "120130510": {
            "id": "120130510",
            "speakerId": 12026,
            "speakerName": "今谷佳祐",
            "text": "这艘船的制造者，也逃不过惩处。",
            "nextDialogs": [
              "120130511"
            ]
          },
          "120130511": {
            "id": "120130511",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "等一下！",
            "nextDialogs": [
              "120130512"
            ]
          },
          "120130512": {
            "id": "120130512",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "为什么就这么决定了！你们没有更多的话要说吗！",
            "nextDialogs": [
              "120130513"
            ]
          },
          "120130513": {
            "id": "120130513",
            "speakerId": 12026,
            "speakerName": "今谷佳祐",
            "text": "我知道你，是长野原家造烟花的那个姑娘…早就知道你爱管闲事，但这件事和你无关。",
            "nextDialogs": [
              "120130514"
            ]
          },
          "120130514": {
            "id": "120130514",
            "speakerId": 12025,
            "speakerName": "朔次郎",
            "text": "没事的，宵宫，过去的事已经没有什么好说的了。",
            "nextDialogs": [
              "120130515"
            ]
          },
          "120130515": {
            "id": "120130515",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "那你辛辛苦苦，不惜偷渡也要回到稻妻是为了什么？！犹豫那么久又是为了什么？！",
            "nextDialogs": [
              "120130516"
            ]
          },
          "120130516": {
            "id": "120130516",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "不就是想要现在这样，可以好好说话的机会吗！",
            "nextDialogs": [
              "120130517"
            ]
          },
          "120130517": {
            "id": "120130517",
            "speakerId": 12026,
            "speakerName": "今谷佳祐",
            "text": "我没有话要和他说。",
            "nextDialogs": [
              "120130518"
            ]
          },
          "120130518": {
            "id": "120130518",
            "speakerId": 12026,
            "speakerName": "今谷佳祐",
            "text": "他是犯人，我是天领奉行的执行者，本来就没有交谈的余地。",
            "nextDialogs": [
              "120130519"
            ]
          },
          "120130519": {
            "id": "120130519",
            "speakerId": 12026,
            "speakerName": "今谷佳祐",
            "text": "只是念在旧日的友谊，我给了他与我决斗的机会，但他的剑技还是像以前一样不争气。",
            "nextDialogs": [
              "120130520"
            ]
          },
          "120130520": {
            "id": "120130520",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "为什么要说这种话？别再骗人了！",
            "nextDialogs": [
              "120130521"
            ]
          },
          "120130521": {
            "id": "120130521",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "你把你的手下都留在了那边封路，这里一个跟随的人都没有，不就是觉得，可能还有对话的机会吗？",
            "nextDialogs": [
              "120130522"
            ]
          },
          "120130522": {
            "id": "120130522",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "明明两个人都是一副有话要说的样子，为什么就是什么都不愿意说啊？",
            "nextDialogs": [
              "120130523"
            ]
          },
          "120130523": {
            "id": "120130523",
            "speakerId": 12026,
            "speakerName": "今谷佳祐",
            "text": "……",
            "nextDialogs": [
              "120130524"
            ]
          },
          "120130524": {
            "id": "120130524",
            "speakerId": 12026,
            "speakerName": "今谷佳祐",
            "text": "自作多情，你又懂什么。",
            "nextDialogs": [
              "120130525"
            ]
          },
          "120130525": {
            "id": "120130525",
            "speakerId": 12025,
            "speakerName": "朔次郎",
            "text": "行了，宵宫，我觉得只是我一厢情愿而已。",
            "nextDialogs": [
              "120130526"
            ]
          },
          "120130526": {
            "id": "120130526",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "不行！明明什么都没做，当然不行！",
            "nextDialogs": [
              "120130527"
            ]
          },
          "120130527": {
            "id": "120130527",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "既然这样，佳祐，你习惯用决斗解决问题，那就跟我决斗吧！",
            "nextDialogs": [
              "120130528"
            ]
          },
          "120130528": {
            "id": "120130528",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "只要我赢了你，你就要说出你的真心话，不要再把自己藏起来了！",
            "nextDialogs": [
              "120130529"
            ]
          },
          "120130529": {
            "id": "120130529",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "朔次郎，你也是！我赢了的话，你就把你回来的原因告诉他，无论结果如何，都一定要说出来！",
            "nextDialogs": [
              "120130530"
            ]
          },
          "120130530": {
            "id": "120130530",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "不说的话，可能就再也没有机会了！",
            "nextDialogs": [
              "120130531"
            ]
          },
          "120130531": {
            "id": "120130531",
            "speakerId": 12026,
            "speakerName": "今谷佳祐",
            "text": "那，如果你输了呢？",
            "nextDialogs": [
              "120130532"
            ]
          },
          "120130532": {
            "id": "120130532",
            "speakerId": 1035,
            "speakerName": "宵宫",
            "text": "我输了，那我就承认我是朔次郎的共犯，任凭天领奉行发落！",
            "nextDialogs": [
              "120130533"
            ]
          },
          "120130533": {
            "id": "120130533",
            "speakerId": 12025,
            "speakerName": "朔次郎",
            "text": "宵宫…",
            "nextDialogs": [
              "120130534"
            ]
          },
          "120130534": {
            "id": "120130534",
            "speakerId": 12026,
            "speakerName": "今谷佳祐",
            "text": "那我接受了，一决胜负吧。"
          }
        }
      }
    },
    {
      "subId": "1201306",
      "subQuestName": "战胜今谷佳祐",
      "sceneId": null,
      "locations": [],

  "subQuests": [
    {
      "subId": "2051201",
      "subQuestName": "与安东尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205120101"
        ],
        "dialogs": {
          "205120101": {
            "id": "205120101",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "药方越来越怪了…",
            "nextDialogs": [
              "205120102"
            ]
          },
          "205120102": {
            "id": "205120102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "安娜怎么样了？",
            "nextDialogs": [
              "205120103"
            ]
          },
          "205120103": {
            "id": "205120103",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "是你啊，呃，虽然说出来你可能不信，但是安娜说自己确实感觉好多了。",
            "nextDialogs": [
              "205120104"
            ]
          },
          "205120104": {
            "id": "205120104",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "难道是那位医生的药方真的起作用了？我自己都不信…",
            "nextDialogs": [
              "205120105"
            ]
          },
          "205120105": {
            "id": "205120105",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "不过，不管是不是真的，总之还是先吃药吧。",
            "nextDialogs": [
              "205120106"
            ]
          },
          "205120106": {
            "id": "205120106",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "这次的药方是…我看看，你能帮我找一份「水史莱姆的浓厚凝液」来吗？",
            "nextDialogs": [
              "205120108",
              "205120113",
              "205120118"
            ]
          },
          "205120108": {
            "id": "205120108",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "…呃，正常吗？我觉得这次的反而更不正常了。",
            "nextDialogs": [
              "205120109"
            ]
          },
          "205120109": {
            "id": "205120109",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "不过，这次倒是挺好找的，「浓厚凝液」我也问过别人，只要消灭大型史莱姆应该就能拿到。",
            "nextDialogs": [
              "205120110"
            ]
          },
          "205120110": {
            "id": "205120110",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "我还听杰克说，如果想引出大型史莱姆，就要先不断消灭小型的史莱姆。",
            "nextDialogs": [
              "205120111"
            ]
          },
          "205120111": {
            "id": "205120111",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "我是没这种战斗力的，所以，就拜托你了！"
          },
          "205120113": {
            "id": "205120113",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你怎么知道的，你难道尝试过吗？呃，你怎么突然不说话了…",
            "nextDialogs": [
              "205120114"
            ]
          },
          "205120114": {
            "id": "205120114",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "算了先不说这个，水史莱姆应该很好找。「浓厚凝液」我问过别人，只要消灭大型史莱姆应该就能拿到。",
            "nextDialogs": [
              "205120115"
            ]
          },
          "205120115": {
            "id": "205120115",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "我还听杰克说，如果想引出大型史莱姆，就要先不断消灭小型的史莱姆。",
            "nextDialogs": [
              "205120116"
            ]
          },
          "205120116": {
            "id": "205120116",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "我是没这种战斗力的啦，就拜托你了！"
          },
          "205120118": {
            "id": "205120118",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "嚯…真可靠啊，看来你已经很熟悉怎么对付史莱姆了呢。",
            "nextDialogs": [
              "205120119"
            ]
          },
          "205120119": {
            "id": "205120119",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "那就麻烦你了。「浓厚凝液」，只要消灭大型史莱姆应该就能拿到。",
            "nextDialogs": [
              "205120120"
            ]
          },
          "205120120": {
            "id": "205120120",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "我还听杰克说，如果想引出大型史莱姆，就要先不断消灭小型的史莱姆。",
            "nextDialogs": [
              "205120121"
            ]
          },
          "205120121": {
            "id": "205120121",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "那么，就万事拜托了。"
          }
        }
      }
    },
    {
      "subId": "2051202",
      "subQuestName": "取得「水史莱姆的浓厚凝液」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205120201"
        ],
        "dialogs": {
          "205120201": {
            "id": "205120201",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你找到东西了吗？",
            "nextDialogs": [
              "205120202"
            ]
          },
          "205120202": {
            "id": "205120202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有。",
            "nextDialogs": [
              "205120203"
            ]
          },
          "205120203": {
            "id": "205120203",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "毕竟还是要战斗，请做好准备再去吧。"
          }
        }
      }
    },
    {
      "subId": "2051203",
      "subQuestName": "与安东尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205120301"
        ],
        "dialogs": {
          "205120301": {
            "id": "205120301",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你找到东西了吗？",
            "nextDialogs": [
              "205120302"
            ]
          },
          "205120302": {
            "id": "205120302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "205120303"
            ]
          },
          "205120303": {
            "id": "205120303",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "这…看起来确实…很浓郁啊…",
            "nextDialogs": [
              "205120304"
            ]
          },
          "205120304": {
            "id": "205120304",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "这东西真的能入药吗，做好了药，我得自己先试试。",
            "nextDialogs": [
              "205120305"
            ]
          },
          "205120305": {
            "id": "205120305",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "假如我出了什么事，安娜就拜托你…",
            "nextDialogs": [
              "205120306"
            ]
          },
          "205120306": {
            "id": "205120306",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "…交给葛瑞丝修女照顾了。",
            "nextDialogs": [
              "205120307"
            ]
          },
          "205120307": {
            "id": "205120307",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "然后告诉她，我去很远的地方工作了，拜托你了，这是我最后的愿望。",
            "nextDialogs": [
              "205120308"
            ]
          },
          "205120308": {
            "id": "205120308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没事的，你别自己吓自己…",
            "nextDialogs": [
              "205120309"
            ]
          },
          "205120309": {
            "id": "205120309",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "因为这药看着就很吓人啊！总之，这些你先收下吧。",
            "nextDialogs": [
              "205120310"
            ]
          },
          "205120310": {
            "id": "205120310",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "一定要记得我说的话啊！"
          }
        }
      }
    }
  ]

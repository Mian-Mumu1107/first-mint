    {
      "subId": "7222503",
      "subQuestName": "(test)cs树叶生长$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722250301"
        ],
        "dialogs": {
          "722250301": {
            "id": "722250301",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "栖木焕发生机了！",
            "nextDialogs": [
              "722250302"
            ]
          },
          "722250302": {
            "id": "722250302",
            "speakerId": 20449,
            "speakerName": "阿久",
            "text": "供奉栖木，总算是完成了呢。真不容易。",
            "nextDialogs": [
              "722250303"
            ]
          },
          "722250303": {
            "id": "722250303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，我们可是处理这种问题的专家。",
            "nextDialogs": [
              "722250304"
            ]
          },
          "722250304": {
            "id": "722250304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "和「导光仪式」差不多。",
            "nextDialogs": [
              "722250305"
            ]
          },
          "722250305": {
            "id": "722250305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为了处理一件事，需要解决分散在三个地点的三个问题…",
            "nextDialogs": [
              "722250306"
            ]
          },
          "722250306": {
            "id": "722250306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总感觉，和你一起，总会遇到这种事情。",
            "nextDialogs": [
              "722250307"
            ]
          },
          "722250307": {
            "id": "722250307",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "虽然别的事情我不是很明白，但大人中有这样的说法…",
            "nextDialogs": [
              "722250308"
            ]
          },
          "722250308": {
            "id": "722250308",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "就是「万事皆三」喔。",
            "nextDialogs": [
              "722250309"
            ]
          },
          "722250309": {
            "id": "722250309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "万事皆三…是什么意思？",
            "nextDialogs": [
              "722250310"
            ]
          },
          "722250310": {
            "id": "722250310",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "嗯…大概就是，任何事情都要经历三次以后，才能迎来结果吧？",
            "nextDialogs": [
              "722250311"
            ]
          },
          "722250311": {
            "id": "722250311",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "比如说，吉兆要发生三次，好运才会真正降临。然后，如果凶兆发生了三次，那一定会发生坏事。",
            "nextDialogs": [
              "722250312"
            ]
          },
          "722250312": {
            "id": "722250312",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "做事情的时候，也会遇到三次困难，第四次才会成功。",
            "nextDialogs": [
              "722250313"
            ]
          },
          "722250313": {
            "id": "722250313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是，那样的话，不应该是「万事皆四」吗？",
            "nextDialogs": [
              "722250314"
            ]
          },
          "722250314": {
            "id": "722250314",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "也是呢！派蒙的数学真好！",
            "nextDialogs": [
              "722250315"
            ]
          },
          "722250315": {
            "id": "722250315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，那当然了。",
            "nextDialogs": [
              "722250317"
            ]
          },
          "722250317": {
            "id": "722250317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "话说回来，阿久的伤没问题吗？",
            "nextDialogs": [
              "722250319"
            ]
          },
          "722250319": {
            "id": "722250319",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "不用担心哦。阿久哥总是这样。",
            "nextDialogs": [
              "722250320"
            ]
          },
          "722250320": {
            "id": "722250320",
            "speakerId": 20449,
            "speakerName": "阿久",
            "text": "真是难堪…希望不会影响祭典。",
            "nextDialogs": [
              "722250321"
            ]
          },
          "722250321": {
            "id": "722250321",
            "speakerId": 20449,
            "speakerName": "阿久",
            "text": "不然的话，就太对不起阿瑠了。",
            "nextDialogs": [
              "722250322"
            ]
          },
          "722250322": {
            "id": "722250322",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "怎么会呢。阿久哥一直都对我很好。",
            "nextDialogs": [
              "722250323"
            ]
          },
          "722250323": {
            "id": "722250323",
            "speakerId": 20449,
            "speakerName": "阿久",
            "text": "……",
            "nextDialogs": [
              "722250324"
            ]
          },
          "722250324": {
            "id": "722250324",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}、派蒙，你们先走吧。",
            "nextDialogs": [
              "722250325"

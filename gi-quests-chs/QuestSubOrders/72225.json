        ],
        "dialogs": {
          "722250101": {
            "id": "722250101",
            "speakerId": 20449,
            "speakerName": "阿久",
            "text": "好疼…",
            "nextDialogs": [
              "722250102"
            ]
          },
          "722250102": {
            "id": "722250102",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}、派蒙！你们来得正好…",
            "nextDialogs": [
              "722250103"
            ]
          },
          "722250103": {
            "id": "722250103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么事了？",
            "nextDialogs": [
              "722250104"
            ]
          },
          "722250104": {
            "id": "722250104",
            "speakerId": 20449,
            "speakerName": "阿久",
            "text": "脚崴着了…",
            "nextDialogs": [
              "722250105"
            ]
          },
          "722250105": {
            "id": "722250105",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "阿久哥又受伤了，能请你们供奉栖木吗？",
            "nextDialogs": [
              "722250107"
            ]
          },
          "722250107": {
            "id": "722250107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没问题，那就交给我们吧！",
            "nextDialogs": [
              "722250109"
            ]
          },
          "722250109": {
            "id": "722250109",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "太感谢了！",
            "nextDialogs": [
              "722250110"
            ]
          },
          "722250110": {
            "id": "722250110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了，阿瑠你不是也对「元素」很敏感吗？",
            "nextDialogs": [
              "722250111"
            ]
          },
          "722250111": {
            "id": "722250111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么你不自己去供奉栖木呢？",
            "nextDialogs": [
              "722250112"
            ]
          },
          "722250112": {
            "id": "722250112",
            "speakerId": 20320,
            "speakerName": "阿瑠",
            "text": "唔…以前我也在祭典里做过各种各样的事情，但最后的结果好像不太好。"
          }
        }
      }
    },
    {
      "subId": "7222506",

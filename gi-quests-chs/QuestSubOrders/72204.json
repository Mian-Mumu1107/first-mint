  },
  "subQuests": [
    {
      "subId": "7220401",
      "subQuestName": "跟奶奶讲话（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040101"
        ],
        "dialogs": {
          "722040101": {
            "id": "722040101",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "木户，木奈，你们来啦…？",
            "nextDialogs": [
              "722040102"
            ]
          },
          "722040102": {
            "id": "722040102",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "真是的…又到处乱跑，我的腿脚可跟不上你们啦…要是遇到危险该怎么办呀…",
            "nextDialogs": [
              "722040105"
            ]
          },
          "722040105": {
            "id": "722040105",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "欸哟！你们真是…你们还小，可不要说这种话呀，这样太伤老人家的心了…",
            "nextDialogs": [
              "722040106"
            ]
          },
          "722040106": {
            "id": "722040106",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "既然来了，就先别乱跑乱玩啦…也来陪陪奶奶，好不好？"
          }
        }
      }
    },
    {
      "subId": "7220408",
      "subQuestName": "自然日刷新2$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040801"
        ],
        "dialogs": {
          "722040801": {
            "id": "722040801",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "木户和木奈哟…还在这座岛上吧？",
            "nextDialogs": [
              "722040802"
            ]
          },
          "722040802": {
            "id": "722040802",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "小孩子呀…真是放不下心呀…"
          }
        }
      }
    },
    {
      "subId": "7220402",
      "subQuestName": "跟奶奶讲话（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040301"
        ],
        "dialogs": {
          "722040301": {
            "id": "722040301",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "唉…越来越不清楚了…越来越记不清事情了呀…",
            "nextDialogs": [
              "722040304"
            ]
          },
          "722040304": {
            "id": "722040304",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "唉…记性越来越差了。人老了，越来越多的事情，记不住了呀…",
            "nextDialogs": [
              "722040305"
            ]
          },
          "722040305": {
            "id": "722040305",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "这样怎么可好呀…也不知道木户和木奈有没有饿着，在外面玩安不安全…"
          }
        }
      }
    },
    {
      "subId": "7220409",
      "subQuestName": "自然日刷新3$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040901"
        ],
        "dialogs": {
          "722040901": {
            "id": "722040901",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "你来了呀…呵呵，真是的，木户，木奈！",
            "nextDialogs": [
              "722040902"
            ]
          },
          "722040902": {
            "id": "722040902",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "他们又跑去不知哪里玩了吧，真是的…不好意思呀。",
            "nextDialogs": [
              "722040903"
            ]
          },
          "722040903": {
            "id": "722040903",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "对了…你叫…什么来着？",
            "nextDialogs": [
              "722040906"
            ]
          },
          "722040906": {
            "id": "722040906",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "唉…我…快要离开了，对吧？",
            "nextDialogs": [
              "722040907"
            ]
          },
          "722040907": {
            "id": "722040907",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "离开…？",
            "nextDialogs": [
              "722040908"
            ]
          },
          "722040908": {
            "id": "722040908",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "那个撑船的人，最近一直来催我呢。",
            "nextDialogs": [
              "722040909"
            ]
          },
          "722040909": {
            "id": "722040909",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "每次都会静静地过来，穿着金的毛皮衣服，金的长裤子，头上戴着金丝的冠…",
            "nextDialogs": [
              "722040910"
            ]
          },
          "722040910": {
            "id": "722040910",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "就像妈妈给我讲的，就像我给木户和木奈讲的那样…带我们登上银璨璨的船哟…",
            "nextDialogs": [
              "722040911"
            ]
          },
          "722040911": {
            "id": "722040911",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "在闪亮亮的河上荡呀荡呀…就到了梦中。梦的土地没有迷雾，那里有一座金色的大屋子…有七十个，又七十个的摇篮…摇啊摇，摇啊摇…",
            "nextDialogs": [
              "722040912"
            ]
          },
          "722040912": {
            "id": "722040912",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "我们安眠在那里，就化成了点点的光…然后呀，就化成了大地上小孩子的梦…"
          }
        }
      }
    },
    {
      "subId": "7220403",
      "subQuestName": "跟奶奶讲话（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040501"
        ],
        "dialogs": {
          "722040501": {
            "id": "722040501",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "是阿部呀。家里蘑菇收成如何？呵呵…你可不要再去打扰祭司大人咯，他再劝我也是不会同意的！",
            "nextDialogs": [
              "722040502"
            ]
          },
          "722040502": {
            "id": "722040502",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "呵呵，对不起啦！一个人养家而已，我怎么就忙不过来了？呵呵，对不起啦…",
            "nextDialogs": [
              "722040503"
            ]
          },
          "722040503": {
            "id": "722040503",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "对不起啦…唉…对不起啦…",
            "nextDialogs": [
              "722040506"
            ]
          },
          "722040506": {
            "id": "722040506",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "啊…！是你呀！真是的…羞不羞人！快进来！"
          }
        }
      }
    },
    {
      "subId": "7220410",
      "subQuestName": "自然日刷新4$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722041001"
        ],
        "dialogs": {
          "722041001": {
            "id": "722041001",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "唉…孩子们呀…",
            "nextDialogs": [
              "722041002"
            ]
          },
          "722041002": {
            "id": "722041002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我替木户和木奈将这个转交给您。"
          }
        }
      }
    },
    {
      "subId": "7220404",
      "subQuestName": "跟奶奶讲话（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040701"
        ],
        "dialogs": {
          "722040701": {
            "id": "722040701",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "你好，你好…",
            "nextDialogs": [
              "722040702"
            ]
          },
          "722040702": {
            "id": "722040702",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "唉，对不起呀，年纪大了头脑难免不清楚…请问你是谁呀…？我曾认识你吗？",
            "nextDialogs": [
              "722040705"
            ]
          },
          "722040705": {
            "id": "722040705",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "没听说过的名字呢…是外面来的人？",
            "nextDialogs": [
              "722040706"
            ]
          },
          "722040706": {
            "id": "722040706",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "奇怪，奇怪…没有雷鸟大人的准许，应该没有人能随随便便来到岛上呀…"
          }
        }
      }
    },
    {
      "subId": "7220411",
      "subQuestName": "自然日刷新5$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722041101"
        ],
        "dialogs": {
          "722041101": {
            "id": "722041101",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "不好意思呀…我还不能登船呢…",
            "nextDialogs": [
              "722041102"
            ]
          },
          "722041102": {
            "id": "722041102",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "我还有牵挂的人没有上船呢…"
          }
        }
      }
    },
    {
      "subId": "7220405",

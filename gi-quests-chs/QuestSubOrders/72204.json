    {
      "subId": "7220406",
      "subQuestName": "寻找这个味道的花（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040601"
        ],
        "dialogs": {
          "722040601": {
            "id": "722040601",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "这样吗…你说他的手里握着…这些？",
            "nextDialogs": [
              "722040602"
            ]
          },
          "722040602": {
            "id": "722040602",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "究竟在想什么呀…你究竟在想些什么呢…"
          }
        }
      }
    },
    {
      "subId": "7220407",
      "subQuestName": "跟奶奶讲话（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7220412",
      "subQuestName": "跟奶奶讲话（test）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722041201"
        ],
        "dialogs": {
          "722041201": {
            "id": "722041201",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "这个…这个气味是…木户那孩子的香包…有这两个孩子的气味呢…",
            "nextDialogs": [
              "722041202"
            ]
          },
          "722041202": {
            "id": "722041202",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "所以…他们终于玩累了，要离开了，是吗？",
            "nextDialogs": [
              "722041203"
            ]
          },
          "722041203": {
            "id": "722041203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我不是很懂，但应该是的…",
            "nextDialogs": [
              "722041204"
            ]
          },
          "722041204": {
            "id": "722041204",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "谢谢你了，外来的人…再见。",
            "nextDialogs": [
              "722041205"
            ]
          },
          "722041205": {
            "id": "722041205",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "银璨璨的柏树林，睡梦的河…请你引我去那边吧，撑船的人…"
          }
        }
      }
    },
    {
      "subId": "7220402",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040201"
        ],
        "dialogs": {
          "722040201": {
            "id": "722040201",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "好啦…好啦…也让奶奶睡一会吧…嗯…呼…呼…",
            "nextDialogs": [
              "722040202"
            ]
          },
          "722040202": {
            "id": "722040202",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "你们可小心点…别跑太远了…呼…呼…"
          }
        }
      }
    },
    {
      "subId": "7220404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722040401"
        ],
        "dialogs": {
          "722040401": {
            "id": "722040401",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "去玩吧，去玩吧…奶奶不会离开的。",
            "nextDialogs": [
              "722040402"
            ]
          },
          "722040402": {
            "id": "722040402",
            "speakerId": 20426,
            "speakerName": "宇奈",
            "text": "花瓣呀…花瓣哟…你的故乡，是什么样子呢…？"
          }
        }
      }
    }

{
  "lineCounts": {
    "奈芙尔": 6,
    "德文特？": 8,
    "雅珂达": 26
  },
  "subQuests": [
    {
      "subId": "7611401",
      "subQuestName": "前往「秘闻馆」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761140101"
        ],
        "dialogs": {
          "761140101": {
            "id": "761140101",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "这次要调查的是…「形迹反常的隐士」？",
            "nextDialogs": [
              "761140102"
            ]
          },
          "761140102": {
            "id": "761140102",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "隐者什么的不是本来就是怪人那一类的吗？会住在那种荒山野岭的人不管做什么都不奇怪吧。",
            "nextDialogs": [
              "761140103"
            ]
          },
          "761140103": {
            "id": "761140103",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "但变化必然是有理由的，无论这理由出自内心还是来自外在。",
            "nextDialogs": [
              "761140104"
            ]
          },
          "761140104": {
            "id": "761140104",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "另外，失踪的游商也令人在意。",
            "nextDialogs": [
              "761140105"
            ]
          },
          "761140105": {
            "id": "761140105",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "欸？可是那一片危险得很，这是众所周知的事，被强盗打劫、被魔物袭击…可能性太多啦。",
            "nextDialogs": [
              "761140106"
            ]
          },
          "761140106": {
            "id": "761140106",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "既然是众所周知的事，常在那片行走的游商自然是有对策的。",
            "nextDialogs": [
              "761140107"
            ]
          },
          "761140107": {
            "id": "761140107",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "尽管如此，老练的游商却下落不明，想必其中有未为人知的原因。",
            "nextDialogs": [
              "761140108"
            ]
          },
          "761140108": {
            "id": "761140108",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "雅珂达，这次就由你亲自拜访这位「形迹反常的隐士」吧。",
            "nextDialogs": [
              "761140109"
            ]
          },
          "761140109": {
            "id": "761140109",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "路途遥远，记得不要离开大路。",
            "nextDialogs": [
              "761140110"
            ]
          },
          "761140110": {
            "id": "761140110",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "嗯？知道了，老板！这点小事你就放心交给我好啦。"
          }
        }
      }
    },
    {
      "subId": "7611402",
      "subQuestName": "前往隐者小屋调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761140201"
        ],
        "dialogs": {
          "761140201": {
            "id": "761140201",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "您好——有人在吗——",
            "nextDialogs": [
              "761140202"
            ]
          },
          "761140202": {
            "id": "761140202",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "德文特先生——您在家吗？",
            "nextDialogs": [
              "761140203"
            ]
          },
          "761140203": {
            "id": "761140203",
            "speakerId": 1002,
            "speakerName": "德文特？",
            "text": "…是谁？",
            "nextDialogs": [
              "761140204"
            ]
          },
          "761140204": {
            "id": "761140204",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "是「秘闻馆」的雅珂达，有些事想要问问您，所以特意来拜访。",
            "nextDialogs": [
              "761140205"
            ]
          },
          "761140205": {
            "id": "761140205",
            "speakerId": 1002,
            "speakerName": "德文特？",
            "text": "…你就这么问吧。我病了，起不来。",
            "nextDialogs": [
              "761140206"
            ]
          },
          "761140206": {
            "id": "761140206",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（奇怪，之前听海螺帮的孩子们说，德文特先生教他们认字，说话温声细语…）",
            "nextDialogs": [
              "761140207"
            ]
          },
          "761140207": {
            "id": "761140207",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（现在听着声音沙哑，不过不像是病了，而像是原本就是这副嗓音…）",
            "nextDialogs": [
              "761140208"
            ]
          },
          "761140208": {
            "id": "761140208",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "您没事吧？如果病得厉害，我可以去请医生…",
            "nextDialogs": [
              "761140209"
            ]
          },
          "761140209": {
            "id": "761140209",
            "speakerId": 1002,
            "speakerName": "德文特？",
            "text": "…不用。过阵子就好了。",
            "nextDialogs": [
              "761140210"
            ]
          },
          "761140210": {
            "id": "761140210",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "好吧，那等您恢复了再去那夏镇吧，您的朋友也很牵挂您呢。",
            "nextDialogs": [
              "761140211"
            ]
          },
          "761140211": {
            "id": "761140211",
            "speakerId": 1002,
            "speakerName": "德文特？",
            "text": "……",
            "nextDialogs": [
              "761140212"
            ]
          },
          "761140212": {
            "id": "761140212",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（…他怎么不说话了？能听到屋里有人走动的声音，不过步子很沉…）",
            "nextDialogs": [
              "761140213"
            ]
          },
          "761140213": {
            "id": "761140213",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "您最近好像都没怎么出门吧？",
            "nextDialogs": [
              "761140214"
            ]
          },
          "761140214": {
            "id": "761140214",
            "speakerId": 1002,
            "speakerName": "德文特？",
            "text": "…是为了专心修行。",
            "nextDialogs": [
              "761140215"
            ]
          },
          "761140215": {
            "id": "761140215",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "听说您近来的装扮也和过去不太一样，有人说完全没想到原来您那么健硕，之前穿隐者长袍的时候都没看出来。",
            "nextDialogs": [
              "761140216"
            ]
          },
          "761140216": {
            "id": "761140216",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "呃，还有隔绝月矩力的面罩…是新的流行吗？",
            "nextDialogs": [
              "761140217"
            ]
          },
          "761140217": {
            "id": "761140217",
            "speakerId": 1002,
            "speakerName": "德文特？",
            "text": "…是为了隔绝外界的杂音。",
            "nextDialogs": [
              "761140218"
            ]
          },
          "761140218": {
            "id": "761140218",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "也是为了修行？",
            "nextDialogs": [
              "761140219"
            ]
          },
          "761140219": {
            "id": "761140219",
            "speakerId": 1002,
            "speakerName": "德文特？",
            "text": "……",
            "nextDialogs": [
              "761140220"
            ]
          },
          "761140220": {
            "id": "761140220",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "那前阵子拜访过您的游商，您知道他在那之后去哪儿了吗？",
            "nextDialogs": [
              "761140221"
            ]
          },
          "761140221": {
            "id": "761140221",
            "speakerId": 1002,
            "speakerName": "德文特？",
            "text": "…不知道。",
            "nextDialogs": [
              "761140222"
            ]
          },
          "761140222": {
            "id": "761140222",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "好、好吧…那我就先不打扰了。",
            "nextDialogs": [
              "761140223"
            ]
          },
          "761140223": {
            "id": "761140223",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（不知道为什么，有种继续问下去会很危险的感觉…）",
            "nextDialogs": [
              "761140224"
            ]
          },
          "761140224": {
            "id": "761140224",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（唔，他们说的没错，简直就像是换了个人…）",
            "nextDialogs": [
              "761140225"
            ]
          },
          "761140225": {
            "id": "761140225",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（收获太少了，也不能就这么回去面对奈姐啊，在附近再小心地调查一下吧。）"
          }
        }
      }
    },
    {
      "subId": "7611403",
      "subQuestName": "在小屋周边寻找线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761140301"
        ],
        "dialogs": {
          "761140301": {
            "id": "761140301",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（咦？这是…看起来像是没烧完的…）",
            "nextDialogs": [
              "761140302"
            ]
          },
          "761140302": {
            "id": "761140302",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（以前就听说德文特先生会收留受伤的冒险家之类的…这好像是最近发生的事。）",
            "nextDialogs": [
              "761140303"
            ]
          },
          "761140303": {
            "id": "761140303",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（为什么要把这些烧掉呢…）"
          }
        }
      }
    },
    {
      "subId": "7611404",
      "subQuestName": "与屋内的人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761140401"
        ],
        "dialogs": {
          "761140401": {
            "id": "761140401",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（没有声音，他在休息吗？还是…）"
          }
        }
      }
    },
    {
      "subId": "7611499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761149901"
        ],
        "dialogs": {
          "761149901": {
            "id": "761149901",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "（差不多该走了…）"
          }
        }
      }
    }
  ]
}
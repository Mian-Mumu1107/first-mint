    {
      "subId": "1504708",
      "subQuestName": "与玛拉妮会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150470801"
        ],
        "dialogs": {
          "150470801": {
            "id": "150470801",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "呼…这下就全部完成了。",
            "nextDialogs": [
              "150470802"
            ]
          },
          "150470802": {
            "id": "150470802",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "谢谢你，这都是多亏了你的帮助。",
            "nextDialogs": [
              "150470803"
            ]
          },
          "150470803": {
            "id": "150470803",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "可以再摸你一下吗？好龙龙，好龙龙，你最棒了！",
            "nextDialogs": [
              "150470804"
            ]
          },
          "150470804": {
            "id": "150470804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "！",
            "nextDialogs": [
              "150470805"
            ]
          },
          "150470805": {
            "id": "150470805",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个…玛拉妮，差不多要把它送回去了。",
            "nextDialogs": [
              "150470806"
            ]
          },
          "150470806": {
            "id": "150470806",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "#噢噢，好呀，那我就在这里等吧，免得{NICKNAME}回来的时候和我们走岔了。",
            "nextDialogs": [
              "150470807"
            ]
          },
          "150470807": {
            "id": "150470807",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "真可爱啊，我之后是不是该找奶奶补习补习暝视龙语言了…",
            "nextDialogs": [
              "150470808"
            ]
          },
          "150470808": {
            "id": "150470808",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "#{NICKNAME}，肚子还好吗？",
            "nextDialogs": [
              "150470809"
            ]
          },
          "150470809": {
            "id": "150470809",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我没事。",
            "nextDialogs": [
              "150470810"
            ]
          },
          "150470810": {
            "id": "150470810",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "那就好。哎，刚才太可惜了，你没见到那只好乖好乖的暝视龙，它特别可爱！",
            "nextDialogs": [
              "150470811"
            ]
          },
          "150470811": {
            "id": "150470811",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "我都想去「烟谜主」住上一阵子，多采点微光角菌来和暝视龙培养感情了。"
          }
        }
      }
    },

    },
    {
      "subId": "1504704",
      "subQuestName": "与玛拉妮会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150470401"
        ],
        "dialogs": {
          "150470401": {
            "id": "150470401",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "…噢，原来这里的设施还没有建造完成啊。",
            "nextDialogs": [
              "150470402"
            ]
          },
          "150470402": {
            "id": "150470402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有只暝视龙员工在这里！是不是应该拜托它帮忙？",
            "nextDialogs": [
              "150470403"
            ]
          },
          "150470403": {
            "id": "150470403",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "可以请你把它们建造出来吗？",
            "nextDialogs": [
              "150470404"
            ]
          },
          "150470404": {
            "id": "150470404",
            "speakerId": 21949,
            "speakerName": "幼暝视龙",
            "text": "……",
            "nextDialogs": [
              "150470405"
            ]
          },
          "150470405": {
            "id": "150470405",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "把它…放到这里…造出来！",
            "nextDialogs": [
              "150470406"
            ]
          },
          "150470406": {
            "id": "150470406",
            "speakerId": 21949,
            "speakerName": "幼暝视龙",
            "text": "……",
            "nextDialogs": [
              "150470407"
            ]
          },
          "150470407": {
            "id": "150470407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它好像看不懂你的比划。",
            "nextDialogs": [
              "150470408"
            ]
          },
          "150470408": {
            "id": "150470408",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "是啊…怎么办呢…",
            "nextDialogs": [
              "150470409"
            ]
          },
          "150470409": {
            "id": "150470409",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "慢着慢着慢着，我突然想到新办法了！",
            "nextDialogs": [
              "150470410"
            ]
          },
          "150470410": {
            "id": "150470410",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "「咿——」",
            "nextDialogs": [
              "150470411"
            ]
          },
          "150470411": {
            "id": "150470411",
            "speakerId": 21949,
            "speakerName": "幼暝视龙",
            "text": "……",
            "nextDialogs": [
              "150470412"
            ]
          },
          "150470412": {
            "id": "150470412",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "「咿——」「咿——」「咿——」",
            "nextDialogs": [
              "150470413"
            ]
          },
          "150470413": {
            "id": "150470413",
            "speakerId": 21949,
            "speakerName": "幼暝视龙",
            "text": "……",
            "nextDialogs": [
              "150470414"
            ]
          },
          "150470414": {
            "id": "150470414",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "哈…不行…它根本听不懂鳍游龙的叫声啊！",
            "nextDialogs": [
              "150470415"
            ]
          },
          "150470415": {
            "id": "150470415",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要不然…",
            "nextDialogs": [
              "150470416"
            ]
          },
          "150470416": {
            "id": "150470416",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "…我又想起来了！",
            "nextDialogs": [
              "150470417"
            ]
          },
          "150470417": {
            "id": "150470417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又想起什么？",
            "nextDialogs": [
              "150470418"
            ]
          },
          "150470418": {
            "id": "150470418",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "我听伊法说过，暝视龙最喜欢吃的就是微光角菌，正好我随身带着。",
            "nextDialogs": [
              "150470419"
            ]
          },
          "150470419": {
            "id": "150470419",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "太好了太好了，这下有救了！给它吃完肯定就能互通心意了。",
            "nextDialogs": [
              "150470420"
            ]
          },
          "150470420": {
            "id": "150470420",
            "speakerId": 21949,
            "speakerName": "幼暝视龙",
            "text": "！",
            "nextDialogs": [
              "150470421"
            ]
          },
          "150470421": {
            "id": "150470421",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "出远门的物资就是要多准备些才行…卡齐娜提醒得一点没错。谢谢你呀，卡齐…",
            "nextDialogs": [
              "150470422"
            ]
          },
          "150470422": {
            "id": "150470422",
            "speakerId": 21949,
            "speakerName": "幼暝视龙",
            "text": "……",
            "nextDialogs": [
              "150470423"
            ]
          },
          "150470423": {
            "id": "150470423",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这…并没有互通心意的征兆…",
            "nextDialogs": [
              "150470424"
            ]
          },
          "150470424": {
            "id": "150470424",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "完蛋了…征服浪浪湾所有项目的梦想在出航的第一日真的翻船了。",
            "nextDialogs": [
              "150470425"
            ]
          },
          "150470425": {
            "id": "150470425",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "#{NICKNAME}，大英雄{NICKNAME}，你有什么办法吗？",
            "nextDialogs": [
              "150470428"
            ]
          },
          "150470428": {
            "id": "150470428",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "嗯，好吧…那就辛苦你了！"
          }
        }
      }
    },
    {
      "subId": "1504705",
      "subQuestName": "与玛拉妮会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150470501"
        ],
        "dialogs": {
          "150470501": {
            "id": "150470501",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "魂附暝视龙后返回…",
            "nextDialogs": [
              "150470502"
            ]
          },
          "150470502": {
            "id": "150470502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "玛拉妮，我们回来啦！",
            "nextDialogs": [
              "150470503"
            ]
          },
          "150470503": {
            "id": "150470503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "！",
            "nextDialogs": [
              "150470504"
            ]
          },
          "150470504": {
            "id": "150470504",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "#噢！你好你好，你看起来好乖哦，{NICKNAME}没有跟你一起来吗？",
            "nextDialogs": [
              "150470505"
            ]
          },
          "150470505": {
            "id": "150470505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呃，{M#他}{F#她}，{M#他}{F#她}突然肚子疼上厕所去了。",
            "nextDialogs": [
              "150470506"
            ]
          },
          "150470506": {
            "id": "150470506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（为什么是那么蹩脚的理由…算了，玛拉妮没有看出异样就好…）",
            "nextDialogs": [
              "150470507"
            ]
          },
          "150470507": {
            "id": "150470507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "！",
            "nextDialogs": [
              "150470508"
            ]
          },
          "150470508": {
            "id": "150470508",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "哎呀哎呀你好热情，要吃微光角菌吗？先来一点尝尝？",
            "nextDialogs": [
              "150470509"
            ]
          },
          "150470509": {
            "id": "150470509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（奇妙的味道。菌类肉质厚实而鲜嫩，意外称得上可口。）",
            "nextDialogs": [
              "150470510"
            ]
          },
          "150470510": {
            "id": "150470510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "！",
            "nextDialogs": [
              "150470511"
            ]
          },
          "150470511": {
            "id": "150470511",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "哈哈，很高兴你能这么喜欢呀！这些全都给你啦。",
            "nextDialogs": [
              "150470512"
            ]
          },
          "150470512": {
            "id": "150470512",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "我…我可以摸一下你吗？我们来交个朋友吧…",
            "nextDialogs": [
              "150470513"
            ]
          },
          "150470513": {
            "id": "150470513",
            "speakerId": 21949,
            "speakerName": "幼暝视龙",
            "text": "……",
            "nextDialogs": [
              "150470514"
            ]
          },
          "150470514": {
            "id": "150470514",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "那就麻烦你帮我一点忙喽！"
          }
        }
      }
    },
    {
      "subId": "1504706",
      "subQuestName": "利用暝视龙能力，完成搭建",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150470601"
        ],
        "dialogs": {
          "150470601": {
            "id": "150470601",
            "speakerId": 21949,
            "speakerName": "幼暝视龙",
            "text": "那女孩到底在说些什么？我不明白啊。朋友只让我帮忙看一下场子，没提到要做什么事呀。",
            "nextDialogs": [
              "150470602"
            ]
          },
          "150470602": {
            "id": "150470602",
            "speakerId": 21949,
            "speakerName": "幼暝视龙",
            "text": "但菌菌好好吃噢…要是能再多来点就好了。"
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "1504701",
      "subQuestName": "前往「暝导游船」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150470101"
        ],
        "dialogs": {
          "150470101": {
            "id": "150470101",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "你们来了！这里的工作人员好像临时有事走开了，不过我已经弄明白要怎么玩…我是说，完成测试了！",
            "nextDialogs": [
              "150470102"
            ]
          },
          "150470102": {
            "id": "150470102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好呀，那你教教我们。",
            "nextDialogs": [
              "150470103"
            ]
          },
          "150470103": {
            "id": "150470103",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "简单来说，需要一方登上游船，另一方给龙员工发送信号。通过默契的双人合作，将游船安全送到目的地。",
            "nextDialogs": [
              "150470104"
            ]
          },
          "150470104": {
            "id": "150470104",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "#要说考验默契，我对我和{NICKNAME}的配合可是很有信心的。",
            "nextDialogs": [
              "150470105"
            ]
          },
          "150470105": {
            "id": "150470105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是吗？一般说完大话就离翻船不远了…",
            "nextDialogs": [
              "150470106"
            ]
          },
          "150470106": {
            "id": "150470106",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "喂喂，派蒙，不吉利的话可不要乱说噢！",
            "nextDialogs": [
              "150470107"
            ]
          },
          "150470107": {
            "id": "150470107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，那…那祝你们一帆风顺。",
            "nextDialogs": [
              "150470108"
            ]
          },
          "150470108": {
            "id": "150470108",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "哼哼，一定会的。",
            "nextDialogs": [
              "150470109"
            ]
          },
          "150470109": {
            "id": "150470109",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "其实我挺想坐船的，平时高难度的冲浪挑战惯了，换个口味也很新鲜！",
            "nextDialogs": [
              "150470112"
            ]
          },
          "150470112": {
            "id": "150470112",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "哇！一拍即合？！这就是我们牵绊的证明吧！",
            "nextDialogs": [
              "150470113"
            ]
          },
          "150470113": {
            "id": "150470113",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "我已经等不及想要给豚豚泳装充足气，一个弹跳飞到游船上去了！"
          }
        }
      }
    },
    {
      "subId": "1504703",
      "subQuestName": "体验「暝导游船」",
      "sceneId": null,

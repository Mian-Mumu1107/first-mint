            "speakerName": "派蒙",
            "text": "风——吹得——睁不开眼睛——"
          }
        }
      }
    },
    {
      "subId": "37304",
      "subQuestName": "与温迪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3730401"
        ],
        "dialogs": {
          "3730401": {
            "id": "3730401",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "呼…风向的变化，影响的不止是龙…",
            "nextDialogs": [
              "3730402"
            ]
          },
          "3730402": {
            "id": "3730402",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "对了，刚才你说，有人告诉你龙的过往？"
          }
        }
      }

          "3730101": {
            "id": "3730101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…你觉得他的声音熟悉吗？但我完全没听出来耶…"
          }
        }
      }
    },
    {
      "subId": "37302",
      "subQuestName": "与温迪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3730201"
        ],
        "dialogs": {
          "3730201": {
            "id": "3730201",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "欸？你怎么来了？",
            "nextDialogs": [
              "3730202"
            ]
          },
          "3730202": {
            "id": "3730202",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "虽然我刚才还在想，你是不是会跟来…",
            "nextDialogs": [
              "3730203"
            ]
          },
          "3730203": {
            "id": "3730203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我想知道更多风神的事。",
            "nextDialogs": [
              "3730204"
            ]
          },
          "3730204": {
            "id": "3730204",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "风神巴巴托斯？那家伙已经从蒙德消失了。",
            "nextDialogs": [
              "3730205"
            ]
          },
          "3730205": {
            "id": "3730205",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "邻国璃月的岩神、稻妻的雷神都还在，但蒙德人已经很久没见过他们的神了。",
            "nextDialogs": [
              "3730206"
            ]
          },
          "3730206": {
            "id": "3730206",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "为什么要打听风神的事？是因为特瓦林吗？",
            "nextDialogs": [
              "3730207"
            ]
          },
          "3730207": {
            "id": "3730207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，这个嘛…是因为「神」…",
            "nextDialogs": [
              "3730208"
            ]
          },
          "3730208": {
            "id": "3730208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，有人告诉我龙的过往。",
            "nextDialogs": [
              "3730209"
            ]
          },
          "3730209": {
            "id": "3730209",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哦？大家现在是怎么看待「风魔龙」的？我很感兴趣。",
            "nextDialogs": [
              "3730210"
            ]
          },
          "3730210": {
            "id": "3730210",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "不过，也不用那么急着说给我听——",
            "nextDialogs": [
              "3730211"
            ]
          },
          "3730211": {
            "id": "3730211",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "很久没回这里了，好像有些东西对我的到来很不满呢。"
          }
        }
      }
    },
    {
      "subId": "37303",
      "subQuestName": "击败来袭的敌人",
      "sceneId": null,
      "locations": [],
      "dialogue": {

      }
    },
    {
      "subId": "1200304",
      "subQuestName": "和行秋交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120030401"
        ],
        "dialogs": {
          "120030401": {
            "id": "120030401",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "最后一出好戏，可不能缺了你们两位重要的看客。",
            "nextDialogs": [
              "120030402"
            ]
          },
          "120030402": {
            "id": "120030402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说得轻松，我们在跑这儿跑那儿的时候，你又干了什么啊？",
            "nextDialogs": [
              "120030403"
            ]
          },
          "120030403": {
            "id": "120030403",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "这个嘛…当然是好好读完了《神霄折戟录》，度过了一段美妙的时光。",
            "nextDialogs": [
              "120030404"
            ]
          },
          "120030404": {
            "id": "120030404",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "神戟与邪剑，弥耳与未央…",
            "nextDialogs": [
              "120030405"
            ]
          },
          "120030405": {
            "id": "120030405",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "前五卷故事的展开，还可以说它「奇」，或是「妙」，但这第六卷，已经找不到合适的形容了。",
            "nextDialogs": [
              "120030426"
            ]
          },
          "120030426": {
            "id": "120030426",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "这世上，也就那位奇人，能写出这样的奇作吧。",
            "nextDialogs": [
              "120030427"
            ]
          },
          "120030427": {
            "id": "120030427",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但这和茂才公的事，有什么关系吗？",
            "nextDialogs": [
              "120030406"
            ]
          },
          "120030406": {
            "id": "120030406",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "我只是感叹一下。毕竟，「出乎意料」是特别少见的事。",
            "nextDialogs": [
              "120030408",
              "120030410"
            ]
          },
          "120030408": {
            "id": "120030408",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "也多亏你的帮助，我的预想才会实现。",
            "nextDialogs": [
              "120030411"
            ]
          },
          "120030411": {
            "id": "120030411",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什、什么？这…这种「只有我不明白」的气氛！",
            "nextDialogs": [
              "120030412"
            ]
          },
          "120030412": {
            "id": "120030412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那…那为什么你说要在仓库这里看好戏呢？",
            "nextDialogs": [
              "120030413"
            ]
          },
          "120030413": {
            "id": "120030413",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "试想一下，茂才公跑遍整个璃月港，也买不到半个石珀。",
            "nextDialogs": [
              "120030414"
            ]
          },
          "120030414": {
            "id": "120030414",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "他担惊受怕，没有材料就完成不了契约，完成不了契约，就会得罪「愚人众」。",
            "nextDialogs": [
              "120030415"
            ]
          },
          "120030415": {
            "id": "120030415",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "惶恐之中他听到了「飞云商会」的名字，一下子变得气急败坏。",
            "nextDialogs": [
              "120030416"
            ]
          },
          "120030416": {
            "id": "120030416",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "茂才公有权有势，什么时候被这样针对过？",
            "nextDialogs": [
              "120030417"
            ]
          },
          "120030417": {
            "id": "120030417",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "不管是想出气，还是要解决问题，他都要…",
            "nextDialogs": [
              "120030418"
            ]
          },
          "120030418": {
            "id": "120030418",
            "speakerId": 1626,
            "speakerName": "茂才公",
            "text": "原来是你们，就是你们在帮常九爷出头吧！",
            "nextDialogs": [
              "120030419"
            ]
          },
          "120030419": {
            "id": "120030419",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "你们看，说来就来了。",
            "nextDialogs": [
              "120030420"
            ]
          },
          "120030420": {
            "id": "120030420",
            "speakerId": 1626,
            "speakerName": "茂才公",
            "text": "我跑了一大圈，到哪里都买不到石珀，这才知道是「飞云商会」在大肆收购。",
            "nextDialogs": [
              "120030421"
            ]
          },
          "120030421": {
            "id": "120030421",
            "speakerId": 1626,
            "speakerName": "茂才公",
            "text": "这明明不是什么稀有矿物，却一下子断了货，你们这是存心针对我？",
            "nextDialogs": [
              "120030422"
            ]
          },
          "120030422": {
            "id": "120030422",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "并非针对，只是报恩而已。路见不平拔刀相助，再正常不过了。",
            "nextDialogs": [
              "120030423"
            ]
          },
          "120030423": {
            "id": "120030423",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "我记得是你们的人说的吧，这件事不会就这么完了。",
            "nextDialogs": [
              "120030424"
            ]
          },
          "120030424": {
            "id": "120030424",
            "speakerId": 1626,
            "speakerName": "茂才公",
            "text": "哼，真不知好歹，那我也不废话了。",
            "nextDialogs": [
              "120030425"
            ]
          },
          "120030425": {
            "id": "120030425",
            "speakerId": 1626,
            "speakerName": "茂才公",
            "text": "大人，靠你了，把这里的石珀全部抢走！"
          },
          "120030410": {
            "id": "120030410",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "挺不错的…希望这边的结局也能合乎我的期待。"
          }
        }
      }
    },

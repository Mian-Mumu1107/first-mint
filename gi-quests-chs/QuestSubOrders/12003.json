    {
      "subId": "1200308",
      "subQuestName": "击退债务处理人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120030801"
        ],
        "dialogs": {
          "120030801": {
            "id": "120030801",
            "speakerId": 10048,
            "speakerName": "债务处理人",
            "text": "有两下子，不是泛泛之辈…这样打下去，损失就难以接受了。",
            "nextDialogs": [
              "120030802"
            ]
          },
          "120030802": {
            "id": "120030802",
            "speakerId": 1626,
            "speakerName": "茂才公",
            "text": "他们快坚持不住了，继续上啊！把石珀都抢过来！",
            "nextDialogs": [
              "120030803"
            ]
          },
          "120030803": {
            "id": "120030803",
            "speakerId": 10048,
            "speakerName": "债务处理人",
            "text": "愚人众和你本来就只有生意上的合作关系，我可没有让你带着我的人去寻衅滋事，惹下这种麻烦。",
            "nextDialogs": [
              "120030804"
            ]
          },
          "120030804": {
            "id": "120030804",
            "speakerId": 1626,
            "speakerName": "茂才公",
            "text": "说…说什么呢？大人，我、我这也不是为了完成订单嘛！",
            "nextDialogs": [
              "120030805"
            ]
          },
          "120030805": {
            "id": "120030805",
            "speakerId": 10048,
            "speakerName": "债务处理人",
            "text": "订单的事，自己想办法吧。",
            "nextDialogs": [
              "120030806"
            ]
          },
          "120030806": {
            "id": "120030806",
            "speakerId": 1626,
            "speakerName": "茂才公",
            "text": "别、别走啊！喂！喂！大人！",
            "nextDialogs": [
              "120030807"
            ]
          },
          "120030807": {
            "id": "120030807",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "少爷？！你怎么在这里？没有受伤吧？",
            "nextDialogs": [
              "120030808"
            ]
          },
          "120030808": {
            "id": "120030808",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "#有这位{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_XIABOY|INFO_FEMALE_PRONOUN_XIAGIRL]}相助，所幸无恙。",
            "nextDialogs": [
              "120030809"
            ]
          },
          "120030809": {
            "id": "120030809",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "少爷？！",
            "nextDialogs": [
              "120030812"
            ]
          },
          "120030812": {
            "id": "120030812",
            "speakerId": 1626,
            "speakerName": "茂才公",
            "text": "你、你就是「飞云商会」的少爷？",
            "nextDialogs": [
              "120030813"
            ]
          },
          "120030813": {
            "id": "120030813",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "在下行不更名坐不改姓，古华派弟子，暨「飞云商会」掌柜次子，行秋。",
            "nextDialogs": [
              "120030814"
            ]
          },
          "120030814": {
            "id": "120030814",
            "speakerId": 1626,
            "speakerName": "茂才公",
            "text": "该死，居然被你算计了…",
            "nextDialogs": [
              "120030815"
            ]
          },
          "120030815": {
            "id": "120030815",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "茂才公，强抢这种事对生意人来说太不体面了吧，不如还是用生意的办法解决。",
            "nextDialogs": [
              "120030816"
            ]
          },
          "120030816": {
            "id": "120030816",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "没有这石珀，「愚人众」会把你怎么样，需要我帮你想象一下吗？",
            "nextDialogs": [
              "120030817"
            ]
          },
          "120030817": {
            "id": "120030817",
            "speakerId": 1626,
            "speakerName": "茂才公",
            "text": "可恶…说吧，你要怎么样才肯卖给我！",
            "nextDialogs": [
              "120030818"
            ]
          },
          "120030818": {
            "id": "120030818",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "既然你和常九爷开的是三折，那一报还一报。",
            "nextDialogs": [
              "120030819"
            ]
          },
          "120030819": {
            "id": "120030819",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "市场价的三倍，怎么样？",
            "nextDialogs": [
              "120030820"
            ]
          },
          "120030820": {
            "id": "120030820",
            "speakerId": 1626,
            "speakerName": "茂才公",
            "text": "你趁火打劫！欺人太甚！你…你…！",
            "nextDialogs": [
              "120030821"
            ]
          },
          "120030821": {
            "id": "120030821",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "叫唤得这么厉害，买还是不买啊？",
            "nextDialogs": [
              "120030822"
            ]
          },
          "120030822": {
            "id": "120030822",
            "speakerId": 1626,
            "speakerName": "茂才公",
            "text": "我…唉，好好好，我答应你，我去筹钱，行了吧！",
            "nextDialogs": [
              "120030823"
            ]
          },
          "120030823": {
            "id": "120030823",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "感谢贵客惠顾「飞云商会」，今后的生意也望多多关照了。",
            "nextDialogs": [
              "120030824"
            ]
          },
          "120030824": {
            "id": "120030824",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你你你你你你居然是「飞云商会」的少爷？！",
            "nextDialogs": [
              "120030825"
            ]
          },
          "120030825": {
            "id": "120030825",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们用的那哗啦啦点都点不清楚的摩拉，都是从你的金库——",
            "nextDialogs": [
              "120030826"
            ]
          },
          "120030826": {
            "id": "120030826",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "小事一桩。这是一笔稳赚不赔的生意，还能顺便教训茂才公，一举两得。"
          }
        }
      }
    },
    {
      "subId": "1200309",
      "subQuestName": "将《神霄折戟录》物归原主",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120030901"
        ],
        "dialogs": {
          "120030901": {
            "id": "120030901",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "你们终于来了！今天早上当铺的人主动把我的藏书都还回来了！",
            "nextDialogs": [
              "120030902"
            ]
          },
          "120030902": {
            "id": "120030902",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "这所有的事一定都是你们帮的忙吧，太谢谢了，真的太谢谢了！",
            "nextDialogs": [
              "120030905"
            ]
          },
          "120030905": {
            "id": "120030905",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "哎呀，千万别这么说，这件事对我来说真的关系重大。",
            "nextDialogs": [
              "120030906"
            ]
          },
          "120030906": {
            "id": "120030906",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "常家原本也算璃月的大家族，可惜我做少当家时，生意上多次受挫，败了家里的财产…",
            "nextDialogs": [
              "120030907"
            ]
          },
          "120030907": {
            "id": "120030907",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "我积攒了多年财力，想要重振家族荣光…这批石珀的生意，就是我压上全部身家的希望。",
            "nextDialogs": [
              "120030908"
            ]
          },
          "120030908": {
            "id": "120030908",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "要不是你们，我估计得葬在这荒山野岭里了。",
            "nextDialogs": [
              "120030909"
            ]
          },
          "120030909": {
            "id": "120030909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没想到你也是个「少爷」啊…",
            "nextDialogs": [
              "120030910"
            ]
          },
          "120030910": {
            "id": "120030910",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "嗯？什么意思？",
            "nextDialogs": [
              "120030911"
            ]
          },
          "120030911": {
            "id": "120030911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊没什么没什么！对了，我们是来还书的！",
            "nextDialogs": [
              "120030912"
            ]
          },
          "120030912": {
            "id": "120030912",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "哦哦，《神霄折戟录》！我就说那古华派的小子怎么突然没影了，还以为他是个小毛贼呢！",
            "nextDialogs": [
              "120030913"
            ]
          },
          "120030913": {
            "id": "120030913",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "古华派…有这么不被人待见吗？",
            "nextDialogs": [
              "120030914"
            ]
          },
          "120030914": {
            "id": "120030914",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "这个门派倒是有几百年的历史，也曾经辉煌过，但现在已经衰落到不成样子了。",
            "nextDialogs": [
              "120030915"
            ]
          },
          "120030915": {
            "id": "120030915",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "振兴山门要靠新鲜血液，但若是一直衰落下去，就永远吸引不来人才，这是个恶性循环。",
            "nextDialogs": [
              "120030916"
            ]
          },
          "120030916": {
            "id": "120030916",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "现在古华派的年轻人啊…就比如那小子吧，说要报恩，结果远不如你们有担当。"
          }
        }
      }
    },
    {
      "subId": "1200045",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120004501"
        ],
        "dialogs": {
          "120004501": {
            "id": "120004501",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "真是太感谢你们了，这下子我的矿石生意还有希望…",
            "nextDialogs": [
              "120004502"
            ]
          },
          "120004502": {
            "id": "120004502",
            "speakerId": 1624,
            "speakerName": "常九爷",
            "text": "之前对你们说话有点不客气，太抱歉了，还望多多担待。"
          }
        }
      }
    },
    {
      "subId": "1200306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120030601"
        ],
        "dialogs": {
          "120030601": {
            "id": "120030601",
            "speakerId": 10048,
            "speakerName": "债务处理人",
            "text": "别太得意忘形了。",
            "nextDialogs": [
              "120030602"

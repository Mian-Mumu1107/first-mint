      }
    },
    {
      "subId": "7081508",
      "subQuestName": "与小六对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708150801"
        ],
        "dialogs": {
          "708150801": {
            "id": "708150801",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "你们跟着我到底有什么事？我说了我要去璃月港。",
            "nextDialogs": [
              "708150802"
            ]
          },
          "708150802": {
            "id": "708150802",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "这些魔物我自己会绕着走，它们发现不了我。",
            "nextDialogs": [
              "708150803"
            ]
          },
          "708150803": {
            "id": "708150803",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "别老是把我当小孩子，我已经长大了！",
            "nextDialogs": [
              "708150804"
            ]
          },
          "708150804": {
            "id": "708150804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是你爸爸给你的…",
            "nextDialogs": [
              "708150805"
            ]
          },
          "708150805": {
            "id": "708150805",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "我爸爸给我的？是他要你们送过来的吗…",
            "nextDialogs": [
              "708150806"
            ]
          },
          "708150806": {
            "id": "708150806",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "准又是些小孩子玩的东西…不是风筝就是娃娃。",
            "nextDialogs": [
              "708150807"
            ]
          },
          "708150807": {
            "id": "708150807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不喜欢这些？",
            "nextDialogs": [
              "708150808"
            ]
          },
          "708150808": {
            "id": "708150808",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "…喜欢啊，我爸爸送给我的东西，我怎么可能不喜欢。",
            "nextDialogs": [
              "708150809"
            ]
          },
          "708150809": {
            "id": "708150809",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "但我要是一直只喜欢这些东西的话，不就一直是小孩子了吗？",
            "nextDialogs": [
              "708150810"
            ]
          },
          "708150810": {
            "id": "708150810",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "老是玩这些，我什么时候能成为冒险家，拿到「神之眼」啊。",
            "nextDialogs": [
              "708150811"
            ]
          },
          "708150811": {
            "id": "708150811",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你要「神之眼」做什么？",
            "nextDialogs": [
              "708150812"
            ]
          },
          "708150812": {
            "id": "708150812",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "有了「神之眼」，我就能做到很多事了啊，无论是赚钱还是其他什么…",
            "nextDialogs": [
              "708150813"
            ]
          },
          "708150813": {
            "id": "708150813",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "然后，爸爸就不用天天在璃月港里工作，可以回来陪我了。",
            "nextDialogs": [
              "708150814"
            ]
          },
          "708150814": {
            "id": "708150814",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "你看，现在我没有「神之眼」…连自己去璃月港都做不到。",
            "nextDialogs": [
              "708150815"
            ]
          },
          "708150815": {
            "id": "708150815",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "不过，爸爸都让你们把礼物送过来了，我去找他，说不定还会给他添麻烦。",
            "nextDialogs": [
              "708150816"
            ]
          },
          "708150816": {
            "id": "708150816",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "<color=#00E1FFFF>我本来也给他准备了礼物</color>，想要给他个惊喜的…但现在我自己是送不过去了。",
            "nextDialogs": [
              "708150817"
            ]
          },
          "708150817": {
            "id": "708150817",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "<color=#00E1FFFF>要是有人愿意帮我送过去</color>…算了，我回去了。你们别跟着我了，我自己知道回去的路。"
          }
        }
      }
    },
    {
      "subId": "7081509",
      "subQuestName": "与小六对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708150901"
        ],
        "dialogs": {
          "708150901": {
            "id": "708150901",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "娃娃…风筝…风车…爸爸果然又送了这些。",
            "nextDialogs": [
              "708150902"
            ]
          },
          "708150902": {
            "id": "708150902",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "唉，可惜了我搜集的那些礼物，没法送到爸爸手上了…",
            "nextDialogs": [
              "708150903"
            ]
          },
          "708150903": {
            "id": "708150903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我帮你把礼物送过去吧。",
            "nextDialogs": [
              "708150904"
            ]
          },
          "708150904": {
            "id": "708150904",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "你要帮我送过去？好吧…虽然你没有「神之眼」，但你刚才对付那些魔物的样子，好像还挺轻松的。",
            "nextDialogs": [
              "708150905"
            ]
          },
          "708150905": {
            "id": "708150905",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "也只能这样了，那就拜托你了。",
            "nextDialogs": [
              "708150906"
            ]
          },
          "708150906": {
            "id": "708150906",
            "speakerId": 1002,
            "speakerName": "小六",
            "text": "唉，要是…我也有你这样的身手就好了。"
          }
        }
      }
    },
    {
      "subId": "7081510",
      "subQuestName": "与嘉义对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708151101"
        ],
        "dialogs": {
          "708151101": {
            "id": "708151101",
            "speakerId": 1001,
            "speakerName": "嘉义",
            "text": "你把礼物送给小六了吗？",
            "nextDialogs": [
              "708151103",
              "708151105"
            ]
          },
          "708151103": {
            "id": "708151103",
            "speakerId": 1001,
            "speakerName": "嘉义",
            "text": "那就好，那都是她最喜欢的玩具。谢谢你们，这些拿着吧，算是谢礼了。"
          },
          "708151105": {
            "id": "708151105",
            "speakerId": 1001,
            "speakerName": "嘉义",
            "text": "我也想回去，可是现在璃月港这情况，我怕是一时半会走不了了。",
            "nextDialogs": [
              "708151106"
            ]
          },
          "708151106": {
            "id": "708151106",
            "speakerId": 1001,
            "speakerName": "嘉义",
            "text": "唉，还是谢谢你们，那些都是小六最喜欢的玩具，她的心情应该会好些。",
            "nextDialogs": [
              "708151107"
            ]
          },
          "708151107": {
            "id": "708151107",
            "speakerId": 1001,
            "speakerName": "嘉义",
            "text": "这些给你们，就算是谢礼吧。"
          }
        }
      }
    },
    {
      "subId": "7081511",
      "subQuestName": "与嘉义对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708151201"
        ],
        "dialogs": {
          "708151201": {
            "id": "708151201",
            "speakerId": 1001,
            "speakerName": "嘉义",
            "text": "你把礼物送给小六了吗？",
            "nextDialogs": [
              "708151202"
            ]
          },
          "708151202": {
            "id": "708151202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是小六给你的。",
            "nextDialogs": [
              "708151203"
            ]
          },
          "708151203": {
            "id": "708151203",
            "speakerId": 1001,
            "speakerName": "嘉义",
            "text": "这是…小六给我的东西？这么多，那孩子得花了多大功夫。",
            "nextDialogs": [
              "708151204"
            ]
          },
          "708151204": {
            "id": "708151204",
            "speakerId": 1001,
            "speakerName": "嘉义",
            "text": "我真是恨不得直接回轻策庄去算了，但是总务司这边又…",
            "nextDialogs": [
              "708151205"
            ]
          },
          "708151205": {
            "id": "708151205",
            "speakerId": 1001,
            "speakerName": "嘉义",
            "text": "谢谢你们，这些是谢礼，请收下吧。",
            "nextDialogs": [
              "708151206"
            ]
          },
          "708151206": {
            "id": "708151206",
            "speakerId": 1001,
            "speakerName": "嘉义",
            "text": "唉，也不知道这事情到底什么时候才算完，总务司又到底什么时候能准我的假…"
          }
        }
      }
    },
    {
      "subId": "7081510",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708151001"
        ],
        "dialogs": {
          "708151001": {
            "id": "708151001",
            "speakerId": 1000,
            "speakerName": "若心",
            "text": "你们回来啦，辛苦你们了，小六已经回来了，怀里还抱着个包裹。",
            "nextDialogs": [
              "708151002"
            ]
          },
          "708151002": {
            "id": "708151002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那是嘉义送给她的。",
            "nextDialogs": [
              "708151003"
            ]
          },
          "708151003": {
            "id": "708151003",
            "speakerId": 1000,
            "speakerName": "若心",
            "text": "是吗…唉，但是小六那孩子，还是更想他人回来啊。",
            "nextDialogs": [
              "708151004"
            ]
          },
          "708151004": {
            "id": "708151004",
            "speakerId": 1000,
            "speakerName": "若心",
            "text": "这小孩子啊，就和村子旁边的那些竹子一样，开始不惹眼，但是一眨眼就长大啦。",
            "nextDialogs": [
              "708151005"
            ]
          },
          "708151005": {
            "id": "708151005",
            "speakerId": 1000,
            "speakerName": "若心",
            "text": "孩子的小时候啊，错过了，就错过了，再也补不回来了…"
          }
        }
      }
    },
    {
      "subId": "7081513",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708151301"
        ],
        "dialogs": {
          "708151301": {
            "id": "708151301",
            "speakerId": 1002,

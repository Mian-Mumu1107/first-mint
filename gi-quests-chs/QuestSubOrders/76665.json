{
  "lineCounts": {
    "库齐娅": 3,
    "菈乌玛": 8
  },
  "subQuests": [
    {
      "subId": "7666501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766506501"
        ],
        "dialogs": {
          "766506501": {
            "id": "766506501",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "辛苦你了，库齐娅。",
            "nextDialogs": [
              "766506502"
            ]
          },
          "766506502": {
            "id": "766506502",
            "speakerId": 7108,
            "speakerName": "库齐娅",
            "text": "菈乌玛大人？您怎么过来了，我只是顺手清理了一下周围，谈不上辛苦的。",
            "nextDialogs": [
              "766506503"
            ]
          },
          "766506503": {
            "id": "766506503",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "但是，你平日里也经常过来，给雕像做一些维护的工作，对吗？",
            "nextDialogs": [
              "766506504"
            ]
          },
          "766506504": {
            "id": "766506504",
            "speakerId": 7108,
            "speakerName": "库齐娅",
            "text": "是的，我偶尔会来，是小鸟们告诉您的？还是月神大人？",
            "nextDialogs": [
              "766506505"
            ]
          },
          "766506505": {
            "id": "766506505",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "呵呵，月神大人的确用她的月光给过我一些指引。",
            "nextDialogs": [
              "766506506"
            ]
          },
          "766506506": {
            "id": "766506506",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "顺着那道月光，我注意过你在深夜前去更换雕像前的花，或者是清洗雕像底座。",
            "nextDialogs": [
              "766506507"
            ]
          },
          "766506507": {
            "id": "766506507",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "库齐娅，除却对月神大人的虔诚外，你也要关心自己的身体。",
            "nextDialogs": [
              "766506508"
            ]
          },
          "766506508": {
            "id": "766506508",
            "speakerId": 7108,
            "speakerName": "库齐娅",
            "text": "…我会注意的，谢谢您，菈乌玛大人。",
            "nextDialogs": [
              "766506509"
            ]
          },
          "766506509": {
            "id": "766506509",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "是我要感谢你才对，稍微过来一点，库齐娅。",
            "nextDialogs": [
              "766506510"
            ]
          },
          "766506510": {
            "id": "766506510",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "愿月神，庇佑你的前路。",
            "nextDialogs": [
              "766506511"
            ]
          },
          "766506511": {
            "id": "766506511",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "…也庇佑，我们所有人。"
          }
        }
      }
    }
  ]
}
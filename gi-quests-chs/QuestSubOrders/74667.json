    {
      "subId": "7466701",
      "subQuestName": "与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746670201"
        ],
        "dialogs": {
          "746670201": {
            "id": "746670201",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "向着星辰与深渊！欢迎来到冒险家协会，请问有什么可以帮您的吗？",
            "nextDialogs": [
              "746670202"
            ]
          },
          "746670202": {
            "id": "746670202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "又，又是凯瑟琳。这一位应该也是「人偶」吧…",
            "nextDialogs": [
              "746670205"
            ]
          },
          "746670205": {
            "id": "746670205",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "请问我有什么可以帮您的吗？您是想要接取委托，还是发放委托？",
            "nextDialogs": [
              "746670206"
            ]
          },
          "746670206": {
            "id": "746670206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我只是顺便来看一眼…",
            "nextDialogs": [
              "746670207"
            ]
          },
          "746670207": {
            "id": "746670207",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "这样啊…如果您遇见了任何和协会有关的问题，都可以来问我。",
            "nextDialogs": [
              "746670208"
            ]
          },
          "746670208": {
            "id": "746670208",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "我会竭诚为您提供最完善的服务，解答一切能够解答的问题。",
            "nextDialogs": [
              "746670209"
            ]
          },
          "746670209": {
            "id": "746670209",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "那么，感谢您对协会做出的贡献，冒险家。祝您的冒险旅途一帆风顺！"
          }
        }
      }
    }
  ]
}
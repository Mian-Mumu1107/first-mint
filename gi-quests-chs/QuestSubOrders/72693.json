    "莱内": 10
  },
  "subQuests": [
    {
      "subId": "7269306",
      "subQuestName": "等待至翌日上午（次日早8点-12点），与大伴对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726930601"
        ],
        "dialogs": {
          "726930601": {
            "id": "726930601",
            "speakerId": 30173,
            "speakerName": "莱内",
            "text": "大伴先生的这首诗，突破了稻妻诗歌的格式，却又用了稻妻的古典手法，罗列了人生中各种难忘的回忆。",
            "nextDialogs": [
              "726930602"
            ]
          },
          "726930602": {
            "id": "726930602",
            "speakerId": 30173,
            "speakerName": "莱内",
            "text": "是想告诉我，蒙德和稻妻，虽然看起来大相径庭，但是却也有共通的美感吧。正如我们二人抛开蒙德人与稻妻人的身份，单纯作为诗人的交流一样。",
            "nextDialogs": [
              "726930603"
            ]
          },
          "726930603": {
            "id": "726930603",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "莱内先生这样年轻，却能如此快速地领会诗句的情谊…",
            "nextDialogs": [
              "726930604"
            ]
          },
          "726930604": {
            "id": "726930604",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "老头子我之前以为所谓忘年之交不过是一些妄言，今天才知道确有其事，也算是一大快事。",
            "nextDialogs": [
              "726930605"
            ]
          },
          "726930605": {
            "id": "726930605",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "#还有这位玉成雅事的{M#小哥}{F#姑娘}，我们三人能在这里相会，也算是有缘。",
            "nextDialogs": [
              "726930606"
            ]
          },
          "726930606": {
            "id": "726930606",
            "speakerId": 30173,
            "speakerName": "莱内",
            "text": "是啊，远渡来稻妻这一路上的颠簸都不重要了，而即便回到蒙德，我也会鲜明地记得稻妻的一草一木。",
            "nextDialogs": [
              "726930607"
            ]
          },
          "726930607": {
            "id": "726930607",
            "speakerId": 30173,
            "speakerName": "莱内",
            "text": "这也多亏了这位朋友带来的画片，谢谢你。",
            "nextDialogs": [
              "726930608"
            ]
          },
          "726930608": {
            "id": "726930608",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "希望将来有一天，我们三人还能有机会再会。",
            "nextDialogs": [
              "726930609"
            ]
          },
          "726930609": {
            "id": "726930609",
            "speakerId": 30173,
            "speakerName": "莱内",
            "text": "一定会的！"
          }
        }
      }
    },
    {
      "subId": "7269301",
      "subQuestName": "与大伴对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726930101"
        ],
        "dialogs": {
          "726930101": {
            "id": "726930101",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "#{M#小哥}{F#姑娘}，你来了。",
            "nextDialogs": [
              "726930102"
            ]
          },
          "726930102": {
            "id": "726930102",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "昨天的诗，莱内先生写出了我们的相见恨晚之感，那么自然我也打算作一首诗赠于他。",
            "nextDialogs": [
              "726930103"
            ]
          },
          "726930103": {
            "id": "726930103",
            "speakerId": 30173,
            "speakerName": "莱内",
            "text": "能得到大伴先生的赠诗，我可真是太荣幸了！",
            "nextDialogs": [
              "726930104"
            ]
          },
          "726930104": {
            "id": "726930104",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "虽说我已经是个老头子了，但最近结识了数位蒙德朋友后，我也对蒙德产生了不小的兴趣。",
            "nextDialogs": [
              "726930105"
            ]
          },
          "726930105": {
            "id": "726930105",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "这首诗我仿照了蒙德吟游诗人的写法，诗句中还会提到一些蒙德的景物。",
            "nextDialogs": [
              "726930106"
            ]
          },
          "726930106": {
            "id": "726930106",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "#可惜我不曾去过蒙德，不知道这位{M#小哥}{F#姑娘}，能否帮我拍摄一些<color=#00E1FFFF>蒙德的特产</color>？",
            "nextDialogs": [
              "726930107"
            ]
          },
          "726930107": {
            "id": "726930107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "726930108"
            ]
          },
          "726930108": {
            "id": "726930108",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "#哈哈，{M#小哥}{F#姑娘}，那就劳烦你了。与前几日一样，要四张画片就行。"
          }
        }
      }
    },
    {
      "subId": "7269302",
      "subQuestName": "准备四张以蒙德特产为主题的画片",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726930201"
        ],
        "dialogs": {
          "726930201": {
            "id": "726930201",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "#{M#小哥}{F#姑娘}，画片的事情怎么样了？",
            "nextDialogs": [
              "726930202"
            ]
          },
          "726930202": {
            "id": "726930202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在这里。",
            "nextDialogs": [
              "726930203"
            ]
          },
          "726930203": {
            "id": "726930203",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "谢谢，谢谢，有了这些素材，应该可以写出满意的诗句来。嗯，让我构思一下…",
            "nextDialogs": [
              "726930204"
            ]
          },
          "726930204": {
            "id": "726930204",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "#{M#小哥}{F#姑娘}，根据你的画片，我试写了这些。诗里具体要用哪句，也请你来选一选吧。"
          }
        }
      }
    },
    {
      "subId": "7269304",
      "subQuestName": "回复大伴",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726930401"
        ],
        "dialogs": {
          "726930401": {
            "id": "726930401",
            "speakerId": 30173,
            "speakerName": "莱内",
            "text": "从花到恋人的联想，不管哪个国度都一样啊，这句的意思是像铭记初恋一样去记住稻妻的景致。"
          }
        }
      }
    },
    {
      "subId": "7269305",
      "subQuestName": "与莱内对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7269303",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726930301"
        ],
        "dialogs": {
          "726930301": {
            "id": "726930301",
            "speakerId": 30173,
            "speakerName": "莱内",
            "text": "嗯，用「寻觅风的脚步」来作为踏上旅途的比喻，确实很有蒙德的风味。"
          }
        }
      }
    },
    {
      "subId": "7269305",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726930501"
        ],
        "dialogs": {
          "726930501": {
            "id": "726930501",
            "speakerId": 30173,
            "speakerName": "莱内",
            "text": "这里的野果是虚指一些悲伤的事情吧，不像初次饮酒、初次读诗一样是什么愉快的记忆，但是却和即将到来的离别一样，让人印象深刻。"
          }
        }
      }
    },
    {
      "subId": "7269307",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726930701"
        ],
        "dialogs": {
          "726930701": {
            "id": "726930701",
            "speakerId": 30173,
            "speakerName": "莱内",
            "text": "嗯，这句是想说，即使离开了稻妻，在这里看到的一切也会永远留在心里。"
          }
        }
      }
    },
    {
      "subId": "7269309",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726930901"
        ],
        "dialogs": {
          "726930901": {
            "id": "726930901",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "#{M#小哥}{F#姑娘}，画片的事情怎么样了？",
            "nextDialogs": [
              "726930902"
            ]
          },
          "726930902": {
            "id": "726930902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有拍完…",
            "nextDialogs": [
              "726930903"
            ]
          },
          "726930903": {
            "id": "726930903",
            "speakerId": 30172,
            "speakerName": "大伴",
            "text": "辛苦了。今天要拍的是<color=#00E1FFFF>蒙德特产</color>，数量嘛，还是和之前一样，<color=#00E1FFFF>四张</color>便可。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "2001904",
      "subQuestName": "把钥匙交给怀尔德",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200190401"
        ],
        "dialogs": {
          "200190401": {
            "id": "200190401",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "钥匙找到了吗？",
            "nextDialogs": [
              "200190402"
            ]
          },
          "200190402": {
            "id": "200190402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是你丢的钥匙吗？",
            "nextDialogs": [
              "200190403"
            ]
          },
          "200190403": {
            "id": "200190403",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "没错！就是这把，我以后可不能…嗯，以后要喝少点了。",
            "nextDialogs": [
              "200190404"
            ]
          },
          "200190404": {
            "id": "200190404",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "哦，还有，请收下这些吧，谢谢你们帮忙。"
          }
        }
      }
    },
    {
      "subId": "2001902",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200190201"
        ],
        "dialogs": {
          "200190201": {
            "id": "200190201",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "你找到钥匙了吗？",
            "nextDialogs": [
              "200190202"
            ]
          },
          "200190202": {
            "id": "200190202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "抱歉，还没有。",
            "nextDialogs": [
              "200190203"
            ]
          },
          "200190203": {
            "id": "200190203",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "这地方果然还是太大了啊…拜托你了！"
          }
        }
      }

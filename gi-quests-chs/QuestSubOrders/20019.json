  "subQuests": [
    {
      "subId": "2001901",
      "subQuestName": "前往询问怀尔德",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200190101"
        ],
        "dialogs": {
          "200190101": {
            "id": "200190101",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "旅行者，你，你来的正好。",
            "nextDialogs": [
              "200190102"
            ]
          },
          "200190102": {
            "id": "200190102",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "我本来是要把这车货送去蒙德城。昨天晚上走到这里的时候，看见了几团亮亮的东西。",
            "nextDialogs": [
              "200190103"
            ]
          },
          "200190103": {
            "id": "200190103",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "因为喝的太多，我…我突然很想去看看那是什么，过去了之后，却发现是一大堆史莱姆，我还被狠狠撞了几下。",
            "nextDialogs": [
              "200190104"
            ]
          },
          "200190104": {
            "id": "200190104",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "我很害怕，但是又找不到方向，跑了半天才回到了车旁边。今天早上，我发现我的<color=#00E1FFFF>钥匙</color>不见了…",
            "nextDialogs": [
              "200190105"
            ]
          },
          "200190105": {
            "id": "200190105",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "你能帮我找找吗？肯定就在这周围，我觉得…肯定就在旁边。",
            "nextDialogs": [
              "200190107",
              "200190109"
            ]
          },
          "200190107": {
            "id": "200190107",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "太好了，这么大片地方，我都不知道从何下手了。"
          },
          "200190109": {
            "id": "200190109",
            "speakerId": 1000,
            "speakerName": "怀尔德",
            "text": "这么大片地方，我可从哪下手啊，这件事只有你能办到，拜托了！"
          }
        }
      }
    },
    {
      "subId": "2001903",

        "dialogs": {
          "191855301": {
            "id": "191855301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（不对…这好像解释不了现在的疑点。）",
            "nextDialogs": [
              "191855302"
            ]
          },
          "191855302": {
            "id": "191855302",
            "speakerId": 1072,
            "speakerName": "琳妮特",
            "text": "「推理模式」结束。说不定我们…已经接近真相了。"

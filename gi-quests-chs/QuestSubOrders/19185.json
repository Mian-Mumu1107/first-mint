    },
    {
      "subId": "1918541",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191854101"
        ],
        "dialogs": {
          "191854101": {
            "id": "191854101",
            "speakerId": 1072,
            "speakerName": "琳妮特",
            "text": "……",
            "nextDialogs": [
              "191854102"
            ]
          },
          "191854102": {
            "id": "191854102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你看起来还有什么心事？",
            "nextDialogs": [
              "191854103"
            ]
          },
          "191854103": {
            "id": "191854103",
            "speakerId": 1072,
            "speakerName": "琳妮特",
            "text": "被你发现了吗…嗯，虽然贝努瓦不像在说谎，但一开始感觉到的「违和感」却更重了。",
            "nextDialogs": [
              "191854104"
            ]
          },
          "191854104": {
            "id": "191854104",
            "speakerId": 1072,
            "speakerName": "琳妮特",
            "text": "我们调查得太快，中途可能忽略了不少疑点…现在启动「推理模式」，重新复盘一下吧。",
            "nextDialogs": [
              "191854105"
            ]
          },
          "191854105": {
            "id": "191854105",
            "speakerId": 1072,
            "speakerName": "琳妮特",
            "text": "…还有哪些值得注意的疑点呢？"
          }
        }
      }
    },
    {
      "subId": "1918542",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191854201"
        ],
        "dialogs": {

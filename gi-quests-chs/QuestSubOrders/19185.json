    {
      "subId": "1918512",
      "subQuestName": "调查据点内的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191851201"
        ],
        "dialogs": {
          "191851201": {
            "id": "191851201",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "果然，这里就是「仿制乐斯」的制备地点…",
            "nextDialogs": [
              "191851202"
            ]
          },
          "191851202": {
            "id": "191851202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "[医药]（协助夏沃蕾辨识药物…）",
            "nextDialogs": [
              "191851203"
            ]
          },
          "191851203": {
            "id": "191851203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这些瓶瓶罐罐里的就是「仿制乐斯」吗？",
            "nextDialogs": [
              "191851204"
            ]
          },
          "191851204": {
            "id": "191851204",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "…不仅如此。还有制备所需的原料，大量的洗剂与少量不知名药物。",
            "nextDialogs": [
              "191851205"
            ]
          },
          "191851205": {
            "id": "191851205",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "这些洗剂，应该是用来去除某些「痕迹」的…比如「仿制乐斯」的气味。",
            "nextDialogs": [
              "191851206"
            ]
          },
          "191851206": {
            "id": "191851206",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "特巡队的资料里有提过，常人很难察觉「仿制乐斯」留下的痕迹，这对皮埃尔来说也是一样的。",
            "nextDialogs": [
              "191851207"
            ]
          },
          "191851207": {
            "id": "191851207",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "想要保证彻底洗清，应该需要不少时间和技术吧。",
            "nextDialogs": [
              "191851208"
            ]
          },
          "191851208": {
            "id": "191851208",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "不过剩下的药又是用来干什么的呢…"
          }
        }
      }
    },
    {
      "subId": "1918510",
      "subQuestName": "调查据点内的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191851001"
        ],
        "dialogs": {
          "191851001": {
            "id": "191851001",
            "speakerId": 1072,
            "speakerName": "琳妮特",
            "text": "…逐影庭在皮埃尔的住所里，好像没有见到过这些木桶。",
            "nextDialogs": [
              "191851002"
            ]
          },
          "191851002": {
            "id": "191851002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "直接抱着这些桶过来也太显眼了。",
            "nextDialogs": [
              "191851003"
            ]
          },
          "191851003": {
            "id": "191851003",
            "speakerId": 1072,
            "speakerName": "琳妮特",
            "text": "嗯，不像是皮埃尔的行动模式…那会是怎么运来的呢？",
            "nextDialogs": [
              "191851004"
            ]
          },
          "191851004": {
            "id": "191851004",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（仔细观察木桶…）",
            "nextDialogs": [
              "191851005"
            ]
          },
          "191851005": {
            "id": "191851005",
            "speakerId": 1003,
            "speakerName": "观察木桶",
            "text": "（木桶外壁有浸泡过的痕迹，桶身一周都留下了干涸后的水渍…）",
            "nextDialogs": [
              "191851006"
            ]
          },
          "191851006": {
            "id": "191851006",
            "speakerId": 1003,
            "speakerName": "观察木桶",
            "text": "（这些水渍显得异常「规矩」，木桶的上半部分几乎没有任何水渍。）",
            "nextDialogs": [
              "191851007"
            ]
          },
          "191851007": {
            "id": "191851007",
            "speakerId": 1003,
            "speakerName": "观察木桶",
            "text": "（桶盖似乎不是很严实，边缘处留有不小的缝隙，但内部并没有进水的痕迹。）",
            "nextDialogs": [
              "191851008"
            ]
          },
          "191851008": {
            "id": "191851008",
            "speakerId": 1072,
            "speakerName": "琳妮特",
            "text": "只有下半部分泡过水吗…"
          }
        }
      }
    },
    {
      "subId": "1918511",
      "subQuestName": "调查据点内的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191851101"
        ],
        "dialogs": {
          "191851101": {
            "id": "191851101",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "这些袋子的材质，相当少见啊…",
            "nextDialogs": [
              "191851102"
            ]
          },
          "191851102": {
            "id": "191851102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "[知识]（协助林尼判断材质…）",
            "nextDialogs": [
              "191851103"
            ]
          },
          "191851103": {
            "id": "191851103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是不是跟你的「魔术口袋」很像？",
            "nextDialogs": [
              "191851104"
            ]
          },
          "191851104": {
            "id": "191851104",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "…嗯，都是海露花纤维做的，不过做了更加细致的处理，不仅能防水，还能防酸蚀、防泄漏。",
            "nextDialogs": [
              "191851105"
            ]
          },
          "191851105": {
            "id": "191851105",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "连系绳都是特制的，可以紧紧扎住袋口。",
            "nextDialogs": [
              "191851106"
            ]
          },
          "191851106": {
            "id": "191851106",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "我刚刚还发现了一些材质相同的口袋，不过个头都很小，厚度也很薄，看起来要容易坏得多。",
            "nextDialogs": [
              "191851107"
            ]
          },
          "191851107": {
            "id": "191851107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有点像…密封袋？",
            "nextDialogs": [
              "191851108"
            ]
          },
          "191851108": {
            "id": "191851108",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "…确实有点像。「仿制乐斯」会被卫兵犬闻出来，密封起来说不定能躲过一时。",
            "nextDialogs": [
              "191851109"
            ]
          },
          "191851109": {
            "id": "191851109",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "那这些大口袋又是做什么用的呢？也用来密封「仿制乐斯」的话，会很显眼吧…"
          }
        }
      }
    },
    {
      "subId": "1918502",

          "191853201"
        ],
        "dialogs": {
          "191853201": {
            "id": "191853201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（应该…只是我多虑了吧…）",
            "nextDialogs": [
              "191853202"
            ]
          },
          "191853202": {
            "id": "191853202",
            "speakerId": 1072,
            "speakerName": "琳妮特",
            "text": "…是没想到，还是不愿意这么联想呢？"

    {
      "subId": "1204402",
      "subQuestName": "前往稻妻",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120440201"
        ],
        "dialogs": {
          "120440201": {
            "id": "120440201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…我又想起了之前在这边追狸猫的日子，有些怀念呢。",
            "nextDialogs": [
              "120440202"
            ]
          },
          "120440202": {
            "id": "120440202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？那是什么？",
            "nextDialogs": [
              "120440205"
            ]
          },
          "120440205": {
            "id": "120440205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么看都不像吧？难道稻妻又有新的妖怪了？",
            "nextDialogs": [
              "120440206"
            ]
          },
          "120440206": {
            "id": "120440206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…难道它想让我们跟过去？"
          }
        }
      }
    },
    {
      "subId": "1204403",
      "subQuestName": "跟上小妖怪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120440301"
        ],
        "dialogs": {
          "120440301": {
            "id": "120440301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那里怎么有个小姐姐？",
            "nextDialogs": [
              "120440302"
            ]
          },
          "120440302": {
            "id": "120440302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她好像很难受…我们快过去看看吧！",
            "nextDialogs": [
              "120440801"
            ]
          },
          "120440801": {
            "id": "120440801",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刚刚是怎么了？明明只是和那个小姐姐对视了一眼…",
            "nextDialogs": [
              "120440802"
            ]
          },
          "120440802": {
            "id": "120440802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下，这里什么时候来了这么多人？这些人到这里来干嘛？",
            "nextDialogs": [
              "120440803"
            ]
          },
          "120440803": {
            "id": "120440803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这些人好像在排队？",
            "nextDialogs": [
              "120440804"
            ]
          },
          "120440804": {
            "id": "120440804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦…那个姐姐还在那里！嗯…我觉得她可能知道发生了什么。",
            "nextDialogs": [
              "120440805"
            ]
          },
          "120440805": {
            "id": "120440805",
            "speakerId": 3129,
            "speakerName": "手岛",
            "text": "现在出发的话，我剩下的时间还足够吗？",
            "nextDialogs": [
              "120440806"
            ]
          },
          "120440806": {
            "id": "120440806",
            "speakerId": 3033,
            "speakerName": "阿茂",
            "text": "怎么就聊不明白呢？",
            "nextDialogs": [
              "120440807"
            ]
          },
          "120440807": {
            "id": "120440807",
            "speakerId": 3026,
            "speakerName": "真田",
            "text": "举报了肯定混不下去，可是…",
            "nextDialogs": [
              "120440808"
            ]
          },
          "120440808": {
            "id": "120440808",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "唔…因为缺乏灵感而产生的焦虑…灵感往往不会光顾过于焦虑的大脑，希望这次治疗能让你更放松一些。",
            "nextDialogs": [
              "120440809"
            ]
          },
          "120440809": {
            "id": "120440809",
            "speakerId": 3226,
            "speakerName": "若紫",
            "text": "…谢谢。",
            "nextDialogs": [
              "120440810"
            ]
          },
          "120440810": {
            "id": "120440810",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "…对于过往恶行的悔恨，还有对于困顿现状的哀愁…我可以让你更开朗地面对这一切，但还请你也努力一下。",
            "nextDialogs": [
              "120440811"
            ]
          },
          "120440811": {
            "id": "120440811",
            "speakerId": 3043,
            "speakerName": "西口",
            "text": "…多谢。",
            "nextDialogs": [
              "120440812"
            ]
          },
          "120440812": {
            "id": "120440812",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "下一位…咳咳！",
            "nextDialogs": [
              "120440813"
            ]
          },
          "120440813": {
            "id": "120440813",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是怎么了？",
            "nextDialogs": [
              "120440814"
            ]
          },
          "120440814": {
            "id": "120440814",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你没事吧？",
            "nextDialogs": [
              "120440815"
            ]
          },
          "120440815": {
            "id": "120440815",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "我还行，下一位…",
            "nextDialogs": [
              "120440816"
            ]
          },
          "120440816": {
            "id": "120440816",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是…",
            "nextDialogs": [
              "120440817"
            ]
          },
          "120440817": {
            "id": "120440817",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "…唔！真好吃！",
            "nextDialogs": [
              "120440818"
            ]
          },
          "120440818": {
            "id": "120440818",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，好突然…",
            "nextDialogs": [
              "120440819"
            ]
          },
          "120440819": {
            "id": "120440819",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "欸？这是…嗝！真的很抱歉…",
            "nextDialogs": [
              "120440820"
            ]
          },
          "120440820": {
            "id": "120440820",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "抱歉？说实话，我们两个都不清楚刚刚到底发生了什么事，能麻烦说明一下吗？",
            "nextDialogs": [
              "120440821"
            ]
          },
          "120440821": {
            "id": "120440821",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "两位应该是误入了我的梦境，容我先让两位醒来再进行说明。",
            "nextDialogs": [
              "120440822"
            ]
          },
          "120440822": {
            "id": "120440822",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "梦境？什么时候…",
            "nextDialogs": [
              "120440901"
            ]
          },
          "120440901": {
            "id": "120440901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…",
            "nextDialogs": [
              "120440902"
            ]
          },
          "120440902": {
            "id": "120440902",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "#嗨，是不是有种「如梦方醒」的感觉？真没想到那位{NICKNAME}会出现在我的梦里。",
            "nextDialogs": [
              "120440903"
            ]
          },
          "120440903": {
            "id": "120440903",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你认识我？",
            "nextDialogs": [
              "120440904"
            ]
          },
          "120440904": {
            "id": "120440904",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "有人经常向我提起你，嗯…我根据传闻做的人物侧写还算准确。",
            "nextDialogs": [
              "120440905"
            ]
          },
          "120440905": {
            "id": "120440905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那你是…",
            "nextDialogs": [
              "120440906"
            ]
          },
          "120440906": {
            "id": "120440906",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "#说起来这是我和{NICKNAME}的第一次见面呢，那么正式自我介绍一下。",
            "nextDialogs": [
              "120440907"
            ]
          },
          "120440907": {
            "id": "120440907",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "我是梦见月瑞希，叫我瑞希就好。我来自食梦貘一族，也是稻妻的妖怪之一哦。",
            "nextDialogs": [
              "120440908"
            ]
          },
          "120440908": {
            "id": "120440908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "食梦貘？",
            "nextDialogs": [
              "120440909"
            ]
          },
          "120440909": {
            "id": "120440909",
            "speakerId": 15170,
            "speakerName": "小食梦貘",
            "text": "啾啾！",
            "nextDialogs": [
              "120440910"
            ]
          },
          "120440910": {
            "id": "120440910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是之前的那个小家伙…",
            "nextDialogs": [
              "120440911"
            ]
          },
          "120440911": {
            "id": "120440911",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "这就是我们一族原本的样子，两位刚刚应该就是被它吸引才误入了我的梦境吧？",
            "nextDialogs": [
              "120440912"
            ]
          },
          "120440912": {
            "id": "120440912",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "食梦貘拥有吞食人类噩梦的能力，而噩梦需要我们在自己的梦境里进行消化，你们刚刚看到的就是我消化噩梦的场景。",
            "nextDialogs": [
              "120440913"
            ]
          },
          "120440913": {
            "id": "120440913",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "我一口气吃了太多噩梦，它们堵在一起，让我有些消化不良…幸好它带你们闯了进来。",
            "nextDialogs": [
              "120440914"
            ]
          },
          "120440914": {
            "id": "120440914",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "也算是歪打正着，帮了我一个大忙，现在我可以好好消化这些噩梦了。",
            "nextDialogs": [
              "120440915"
            ]
          },
          "120440915": {
            "id": "120440915",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们就是发现你有些难受才凑过去的，虽然不知道具体发生了什么，但能帮到你就好。",
            "nextDialogs": [
              "120440916"
            ]
          },
          "120440916": {
            "id": "120440916",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我最讨厌噩梦了，能吞食噩梦的妖怪，确实要好好帮助一下呢！",
            "nextDialogs": [
              "120440917"
            ]
          },
          "120440917": {
            "id": "120440917",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "不过，非常抱歉…",
            "nextDialogs": [
              "120440918"
            ]
          },
          "120440918": {
            "id": "120440918",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "120440919"
            ]
          },
          "120440919": {
            "id": "120440919",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "你在梦境里凑过来的时候，我从你身上分离出来的不是噩梦，而是美梦…",
            "nextDialogs": [
              "120440920"
            ]
          },
          "120440920": {
            "id": "120440920",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "之前吃了那么多噩梦，我的动作都变得机械了，没留意就一口咬了下去…",
            "nextDialogs": [
              "120440921"
            ]
          },
          "120440921": {
            "id": "120440921",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来食梦貘也可以吃美梦啊…话说回来，这是很过分的事吗？",
            "nextDialogs": [
              "120440922"
            ]
          },
          "120440922": {
            "id": "120440922",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "当然了，美梦对于人类来说十分珍贵，怎么能像噩梦那样随意吞食呢？",
            "nextDialogs": [
              "120440923"
            ]
          },
          "120440923": {
            "id": "120440923",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "我们食梦貘一族有个不成文的规定，未经允许绝对不能吞食他人的美梦，我真是太不小心了…",
            "nextDialogs": [
              "120440926"
            ]
          },
          "120440926": {
            "id": "120440926",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "难道你没有觉得十分低落，又或者忽然想起很多伤心往事？",
            "nextDialogs": [
              "120440927"
            ]
          },
          "120440927": {
            "id": "120440927",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有啊。",
            "nextDialogs": [
              "120440928"
            ]
          },
          "120440928": {
            "id": "120440928",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "自己的美梦被吞食一部分后还能维持如此稳定的心理状态，真是难得一见的案例…",
            "nextDialogs": [
              "120440929"
            ]
          },
          "120440929": {
            "id": "120440929",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯…肯定是{NICKNAME}的美梦太多了，被吃掉一点也没关系嘛！",
            "nextDialogs": [
              "120440930"
            ]
          },
          "120440930": {
            "id": "120440930",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "但我还是应该向你提供补偿…这样吧，请收下这个。",
            "nextDialogs": [
              "120440931"
            ]
          },
          "120440931": {
            "id": "120440931",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "秋沙钱汤贵宾邀请函…",
            "nextDialogs": [
              "120440932"
            ]
          },
          "120440932": {
            "id": "120440932",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "本店有多位心理诊疗师坐镇，并附带温泉和美食服务。带着烦恼前来，带着快乐离开…",
            "nextDialogs": [
              "120440933"
            ]
          },
          "120440933": {
            "id": "120440933",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "邀请函上标注了地址，我就在那里工作。",
            "nextDialogs": [
              "120440934"
            ]
          },
          "120440934": {
            "id": "120440934",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "使用这张邀请函，你们可以在那里免费享受最高级别的服务…啊，说起来我也得赶快回去，店里的事务不能搁置太久。",
            "nextDialogs": [
              "120440935"
            ]
          },
          "120440935": {
            "id": "120440935",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "那么，期待你们的正式光临哦！",
            "nextDialogs": [
              "120440936"
            ]
          },
          "120440936": {
            "id": "120440936",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说，那位食梦貘姐姐还是一位心理诊疗师？"
          }
        }
      }
    },

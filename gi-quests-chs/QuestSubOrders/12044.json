    {
      "subId": "1204406",
      "subQuestName": "(test)和派蒙对话弄清楚周围发生了什么",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120440601"
        ],
        "dialogs": {
          "120440601": {
            "id": "120440601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "(test)这到底是怎么回事啊，这里感觉好奇怪啊",
            "nextDialogs": [
              "120440602"
            ]
          },
          "120440602": {
            "id": "120440602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "(test)感觉和刚刚的情景都不一样了呢，是不是我们已经不在现实世界了呀",
            "nextDialogs": [
              "120440603"
            ]
          },
          "120440603": {
            "id": "120440603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "(test)前面还有人，我们上去看看"
          }
        }
      }

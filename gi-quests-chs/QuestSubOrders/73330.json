    {
      "subId": "7333007",
      "subQuestName": "与愚人众长官对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733300701"
        ],
        "dialogs": {
          "733300701": {
            "id": "733300701",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "喂，心怀不轨的人类，劝你们尽快离开此地。吾辈花灵的传承与隐秘可不是尔等可以轻易触达的东西。",
            "nextDialogs": [
              "733300702"
            ]
          },
          "733300702": {
            "id": "733300702",
            "speakerId": 20966,
            "speakerName": "马尔科佐夫",
            "text": "花灵？花灵！多么新奇的体验啊！",
            "nextDialogs": [
              "733300703"
            ]
          },
          "733300703": {
            "id": "733300703",
            "speakerId": 20966,
            "speakerName": "马尔科佐夫",
            "text": "#哦！还有{M#精干的少年}{F#小小的女士}和{M#他的}{F#她的}…宠物？",
            "nextDialogs": [
              "733300704"
            ]
          },
          "733300704": {
            "id": "733300704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哇！你这家伙也太失礼了！我可是{M#他}{F#她}最好的伙伴！",
            "nextDialogs": [
              "733300705"
            ]
          },
          "733300705": {
            "id": "733300705",
            "speakerId": 20966,
            "speakerName": "马尔科佐夫",
            "text": "伙伴…当然，当然！最好的伙伴，多么动听的词汇！我从孩提时代起就盼望着能有这样一个「最好的伙伴」…",
            "nextDialogs": [
              "733300706"
            ]
          },
          "733300706": {
            "id": "733300706",
            "speakerId": 20966,
            "speakerName": "马尔科佐夫",
            "text": "#{M#精干的少年}{F#小小的女士}，您应该不需要两个「最好的伙伴」吧？",
            "nextDialogs": [
              "733300710",
              "733300709"
            ]
          },
          "733300710": {
            "id": "733300710",
            "speakerId": 20966,
            "speakerName": "马尔科佐夫",
            "text": "我的意思是…太奢侈了！即便是对您来说。",
            "nextDialogs": [
              "733300711"
            ]
          },
          "733300711": {
            "id": "733300711",
            "speakerId": 20966,
            "speakerName": "马尔科佐夫",
            "text": "我无法原谅这样的不公…所以恳请您，将花灵交给我。关于花灵的待遇，您大可放心，我一定会物尽其用。",
            "nextDialogs": [
              "733300712"
            ]
          },
          "733300712": {
            "id": "733300712",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "无礼的家伙…",
            "nextDialogs": [
              "733300713"
            ]
          },
          "733300713": {
            "id": "733300713",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这也太不讲道理了，根本没办法沟通嘛！",
            "nextDialogs": [
              "733300714"
            ]
          },
          "733300714": {
            "id": "733300714",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "这世上有比语言更通行的道理…吾之「谒颂主」，聪慧如你，应该明白我的意思吧？",
            "nextDialogs": [
              "733300715"
            ]
          },
          "733300715": {
            "id": "733300715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我猜斯露莎是说，给他点颜色瞧瞧！",
            "nextDialogs": [
              "733300716"
            ]
          },
          "733300716": {
            "id": "733300716",
            "speakerId": 13210,
            "speakerName": "斯露莎",
            "text": "哼，不用白飘飘多话！"
          },
          "733300709": {
            "id": "733300709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那怎么行！不行不行，「最好的」伙伴只能是派蒙！"
          }
        }
      }
    },

        ],
        "dialogs": {
          "715360301": {
            "id": "715360301",
            "speakerId": 1000,
            "speakerName": "坎蒂丝",
            "text": "#原来是这样…这份「祝柬」真好看，谢谢你，{NICKNAME}。",
            "nextDialogs": [
              "715360302"
            ]
          },
          "715360302": {
            "id": "715360302",
            "speakerId": 1000,
            "speakerName": "坎蒂丝",
            "text": "我等会照着你教我的做法再做几份，随着礼物一起送给村里人，他们一定会很高兴的。",
            "nextDialogs": [
              "715360303"
            ]
          },
          "715360303": {
            "id": "715360303",
            "speakerId": 1000,
            "speakerName": "坎蒂丝",
            "text": "至于你做的这一封，我会好好珍藏的。"
          }
        }
      }
    },

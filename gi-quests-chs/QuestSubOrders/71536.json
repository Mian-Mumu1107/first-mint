  "subQuests": [
    {
      "subId": "7153601",
      "subQuestName": "等待至次日的8时至18时",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715360101"
        ],
        "dialogs": {
          "715360101": {
            "id": "715360101",
            "speakerId": 1000,
            "speakerName": "坎蒂丝",
            "text": "#{NICKNAME}？海灯节快乐，你帮迪希雅做「祝柬」的事，我已经听说了，很漂亮，谢谢你。",
            "nextDialogs": [
              "715360102"
            ]
          },
          "715360102": {
            "id": "715360102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "村里的事已经安排妥当了？",
            "nextDialogs": [
              "715360103"
            ]
          },
          "715360103": {
            "id": "715360103",
            "speakerId": 1000,
            "speakerName": "坎蒂丝",
            "text": "多亏了迪希雅她们帮忙，村里现在有人守着，我也能安心一些。",
            "nextDialogs": [
              "715360104"
            ]
          },
          "715360104": {
            "id": "715360104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这段时间就好好休息吧。",
            "nextDialogs": [
              "715360105"
            ]
          },
          "715360105": {
            "id": "715360105",
            "speakerId": 1000,
            "speakerName": "坎蒂丝",
            "text": "嗯，我会的。迪希雅还说，过几天想去「翘英庄」看看。",
            "nextDialogs": [
              "715360106"
            ]
          },
          "715360106": {
            "id": "715360106",
            "speakerId": 1000,
            "speakerName": "坎蒂丝",
            "text": "她说那边景色非常不错，还产出好茶，正好买一些带回去给村里的人。",
            "nextDialogs": [
              "715360107"
            ]
          },
          "715360107": {
            "id": "715360107",
            "speakerId": 1000,
            "speakerName": "坎蒂丝",
            "text": "我本来也想按照璃月的传统，做几张「祝柬」，附在礼物里送出去。",
            "nextDialogs": [
              "715360108"
            ]
          },
          "715360108": {
            "id": "715360108",
            "speakerId": 1000,
            "speakerName": "坎蒂丝",
            "text": "可是迪希雅的日程安排太满，我们俩到处跑，根本没什么空写「祝柬」…",
            "nextDialogs": [
              "715360109"
            ]
          },
          "715360109": {
            "id": "715360109",
            "speakerId": 1000,
            "speakerName": "坎蒂丝",
            "text": "我听迪希雅说，你很擅长做「祝柬」，能教我做一封么？",
            "nextDialogs": [
              "715360110"
            ]
          },
          "715360110": {
            "id": "715360110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好呀，交给我吧。"
          }
        }
      }
    },

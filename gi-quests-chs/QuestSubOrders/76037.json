          "760370905": {
            "id": "760370905",
            "speakerId": 22175,
            "speakerName": "悬赏",
            "text": "「由此可见，她卖给老子的项链虽然是真货，却是诅咒老子无法恋爱的真货。凡能找到她下落帮我解咒的，本人将予以重谢。」",
            "nextDialogs": [
              "760370906"
            ]
          },
          "760370906": {
            "id": "760370906",
            "speakerId": 22175,
            "speakerName": "悬赏",
            "text": "「追记：本悬赏改为寻人。冷静想了想，希丁芭小姐当初说得没错，一定是我心不够诚，才会让项链没有发挥出预期的作用。」",
            "nextDialogs": [
              "760370907"
            ]
          },
          "760370907": {
            "id": "760370907",
            "speakerId": 22175,
            "speakerName": "悬赏",
            "text": "「能寻得希丁芭小姐下落，好让她继续教导本人的，本人将予以重谢。」"
          }
        }
      }
    },

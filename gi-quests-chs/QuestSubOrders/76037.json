  "subQuests": [
    {
      "subId": "7603701",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760370101"
        ],
        "dialogs": {
          "760370101": {
            "id": "760370101",
            "speakerId": 7012,
            "speakerName": "勒塞克",
            "text": "四个悬赏目标的信息都在板上，问我也行，但赏金多少没有商量的余地。",
            "nextDialogs": [
              "760370103",
              "760370109"
            ]
          },
          "760370103": {
            "id": "760370103",
            "speakerId": 7012,
            "speakerName": "勒塞克",
            "text": "目前有四个目标，但只有三个有线索。被人指控欺诈而悬赏的须弥占卜师希丁芭，常在<color=#00E1FFFF>南边港口附近</color>出没。",
            "nextDialogs": [
              "760370104"
            ]
          },
          "760370104": {
            "id": "760370104",
            "speakerId": 7012,
            "speakerName": "勒塞克",
            "text": "发狂的稻妻海乱鬼，途经<color=#00E1FFFF>空寂走廊</color>的游商中，已有多人命丧他手。",
            "nextDialogs": [
              "760370105"
            ]
          },
          "760370105": {
            "id": "760370105",
            "speakerId": 7012,
            "speakerName": "勒塞克",
            "text": "走私危险物品的帮派成员，据说盘踞在<color=#00E1FFFF>镇子北面海滩的营地</color>。",
            "nextDialogs": [
              "760370106"
            ]
          },
          "760370106": {
            "id": "760370106",
            "speakerId": 7012,
            "speakerName": "勒塞克",
            "text": "穷凶极恶的海盗，「裂颚」哈尔克，暂时没有线索，或许在什么地方潜伏起来了。"
          },
          "760370109": {
            "id": "760370109",
            "speakerId": 7012,
            "speakerName": "勒塞克",
            "text": "不送。"
          }
        }
      }
    },
    {
      "subId": "7603702",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

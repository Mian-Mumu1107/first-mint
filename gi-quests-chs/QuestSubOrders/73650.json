{
  "lineCounts": {
    "Player": 7,
    "派蒙": 20,
    "贾米": 45
  },
  "subQuests": [
    {
      "subId": "7365001",
      "subQuestName": "与唉声叹气的学者对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736500101"
        ],
        "dialogs": {
          "736500101": {
            "id": "736500101",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "完蛋啦，唉…我的学术生涯还没开始，就已经夭折了…",
            "nextDialogs": [
              "736500102"
            ]
          },
          "736500102": {
            "id": "736500102",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "当什么学者！当什么学者！早知道在教令院偷偷自学画画当个会画彩图的绘图师，也比现在有前途，呵呵…呵呵…",
            "nextDialogs": [
              "736500103"
            ]
          },
          "736500103": {
            "id": "736500103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "之前就听说奥摩斯港有个教令院学者每天唉声叹气的…我还以为是什么奇怪的传说呢…",
            "nextDialogs": [
              "736500104"
            ]
          },
          "736500104": {
            "id": "736500104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来真的有，「唉声叹气教令院学者」！",
            "nextDialogs": [
              "736500105"
            ]
          },
          "736500105": {
            "id": "736500105",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "嗯，什么？什么「唉声叹气教令院学者」…是说我吗？",
            "nextDialogs": [
              "736500106"
            ]
          },
          "736500106": {
            "id": "736500106",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "唉…要是以前我非得就这个外号和你理论一番，现在就算了…",
            "nextDialogs": [
              "736500107"
            ]
          },
          "736500107": {
            "id": "736500107",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "小家伙，哪来的回哪去吧，别打扰一个前途渺茫的失志青年。像我这样的人就应该缩回森林最阴暗的角落当个蘑菇…",
            "nextDialogs": [
              "736500108"
            ]
          },
          "736500108": {
            "id": "736500108",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "这样至少不会浪费教令院的学术资源…啊，说不定还有可能被当作什么特殊的蘑菇样品，被采集回来供真正有才能的学者解剖…",
            "nextDialogs": [
              "736500109"
            ]
          },
          "736500109": {
            "id": "736500109",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "「作为实验样本的蘑菇贾米」，呵呵，说不定还能通过这样的方式留名研究史…",
            "nextDialogs": [
              "736500110"
            ]
          },
          "736500110": {
            "id": "736500110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "贾米…你的名字叫贾米吗。",
            "nextDialogs": [
              "736500111"
            ]
          },
          "736500111": {
            "id": "736500111",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "是啊，怎么了，小家伙。",
            "nextDialogs": [
              "736500112"
            ]
          },
          "736500112": {
            "id": "736500112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我才不是什么小家伙呢，我的名字叫派蒙！",
            "nextDialogs": [
              "736500113"
            ]
          },
          "736500113": {
            "id": "736500113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我的名字是{NICKNAME}。",
            "nextDialogs": [
              "736500114"
            ]
          },
          "736500114": {
            "id": "736500114",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "#{NICKNAME}和派蒙，行吧，我记住了，两位有什么事吗…",
            "nextDialogs": [
              "736500115"
            ]
          },
          "736500115": {
            "id": "736500115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们只是听说了最近奥摩斯港有「唉声叹气教令院学者」的传言，所以想知道发生了什么事而已啦。",
            "nextDialogs": [
              "736500116"
            ]
          },
          "736500116": {
            "id": "736500116",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "唉…你们知道，对于须弥的众学者而言，有一件美妙的事，其名曰：「发表研究」。",
            "nextDialogs": [
              "736500117"
            ]
          },
          "736500117": {
            "id": "736500117",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "只要可以独立「发表研究」，就能被证明是独当一面的学者，从导师那里毕业，正经进入学术界，赢得声望…",
            "nextDialogs": [
              "736500118"
            ]
          },
          "736500118": {
            "id": "736500118",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "这样就可以以外出取材为由到提瓦特各地旅行，还可以用下拨的课题经费吃香喝辣…",
            "nextDialogs": [
              "736500119"
            ]
          },
          "736500119": {
            "id": "736500119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "吃香喝辣，那个，吃香喝辣的部分说得更详细一些嘛…",
            "nextDialogs": [
              "736500122"
            ]
          },
          "736500122": {
            "id": "736500122",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "只、只是口头说一说啦，我内心其实充满了想要在须弥学术界有所作为的宏大理想…",
            "nextDialogs": [
              "736500123"
            ]
          },
          "736500123": {
            "id": "736500123",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "吃香喝辣啦，四处去旅行啦，变得有名啦，诸如此类的，只是我不怎么排斥的附带的部分…咳咳，说远了…",
            "nextDialogs": [
              "736500124"
            ]
          },
          "736500124": {
            "id": "736500124",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "总之就是，我现在就卡在「发表研究」这一环，教令院各种课程本来时间就紧，还要在规定的时间内通过开题报告…",
            "nextDialogs": [
              "736500125"
            ]
          },
          "736500125": {
            "id": "736500125",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "结果光开题报告就被否了两次，第一次我说我想做「蕈猪背部蘑菇的食用价值」，唉，这多好的题目啊…",
            "nextDialogs": [
              "736500126"
            ]
          },
          "736500126": {
            "id": "736500126",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听上去是需要反复进行实验的好课题呢！",
            "nextDialogs": [
              "736500127"
            ]
          },
          "736500127": {
            "id": "736500127",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "对吧，结果我的导师说什么「这有什么好研究的！」就给否了…真是莫名其妙。",
            "nextDialogs": [
              "736500128"
            ]
          },
          "736500128": {
            "id": "736500128",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "第二次我说我想研究「浮游水蕈兽的生态环境与养殖」，结果又被导师否了，说我胸无大志…",
            "nextDialogs": [
              "736500129"
            ]
          },
          "736500129": {
            "id": "736500129",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "眼看开题报告的时间就要过去了，我就赌气写了个大的…当时就觉得「啊，该死的老头子，居然敢说我胸无大志！」…",
            "nextDialogs": [
              "736500130"
            ]
          },
          "736500130": {
            "id": "736500130",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "本来只是赌气，结果课题提上去当天就被导师通过，还在学院内获得一致好评，呵呵…骑虎难下，我的课题正式变成了…",
            "nextDialogs": [
              "736500131"
            ]
          },
          "736500131": {
            "id": "736500131",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "变成了？",
            "nextDialogs": [
              "736500132"
            ]
          },
          "736500132": {
            "id": "736500132",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "呵呵…变成了「生物结构在对敌应激时的防御缺陷研究」…"
          }
        }
      }
    },
    {
      "subId": "7365002",
      "subQuestName": "与贾米对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736500201"
        ],
        "dialogs": {
          "736500201": {
            "id": "736500201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没想到居然走到这么远的地方…",
            "nextDialogs": [
              "736500202"
            ]
          },
          "736500202": {
            "id": "736500202",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "这也没有办法。",
            "nextDialogs": [
              "736500203"
            ]
          },
          "736500203": {
            "id": "736500203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "离奥摩斯港的距离也太远了…",
            "nextDialogs": [
              "736500204"
            ]
          },
          "736500204": {
            "id": "736500204",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "毕竟也跟实验对象有关，虽然我的导师很希望我把全提瓦特所有生物都观察一遍，但是那怎么可能！",
            "nextDialogs": [
              "736500205"
            ]
          },
          "736500205": {
            "id": "736500205",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "所以就从须弥和璃月分布的开始研究起了…",
            "nextDialogs": [
              "736500206"
            ]
          },
          "736500206": {
            "id": "736500206",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "哦，对了，请拿好这个…这是我为了研究弄来的特殊药剂，能够在实验场地里生效。",
            "nextDialogs": [
              "736500207"
            ]
          },
          "736500207": {
            "id": "736500207",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "其名为「溢神剂」！是阿弥利多学院的前辈做出来的药剂，造价高，工序复杂，我好不容易才做了这么一些…",
            "nextDialogs": [
              "736500208"
            ]
          },
          "736500208": {
            "id": "736500208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？这个药剂和你的实验有什么关系呀…",
            "nextDialogs": [
              "736500209"
            ]
          },
          "736500209": {
            "id": "736500209",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "其实是这样，服用了「溢神剂」之后，服用者就会主观地觉得时间变得非常非常…非常非常慢，几乎和停了一样…",
            "nextDialogs": [
              "736500210"
            ]
          },
          "736500210": {
            "id": "736500210",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "这样就能进行更细致的拍摄和观察啦！",
            "nextDialogs": [
              "736500211"
            ]
          },
          "736500211": {
            "id": "736500211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，有了这样的药剂，你自己也可以做这个实验嘛…",
            "nextDialogs": [
              "736500212"
            ]
          },
          "736500212": {
            "id": "736500212",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "唉…我本来也是这么以为的，但是事情哪有那么简单…",
            "nextDialogs": [
              "736500213"
            ]
          },
          "736500213": {
            "id": "736500213",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "我已经说了，是「主观上」变得非常慢…你的身体的反应其实还是跟不过来的，身体如果不够灵敏…",
            "nextDialogs": [
              "736500214"
            ]
          },
          "736500214": {
            "id": "736500214",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "比如你在棘冠鳄飞扑过来的时候喝下「溢神剂」，但是你又没有反应能力躲避它的飞扑…",
            "nextDialogs": [
              "736500215"
            ]
          },
          "736500215": {
            "id": "736500215",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "你就会看到它的爪子离你的脸始终有那么近，像是停在那里…可身体就是没法躲开…",
            "nextDialogs": [
              "736500216"
            ]
          },
          "736500216": {
            "id": "736500216",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "「为什么身子不动呀！」你这么想，但是没有用，爪子还是离那么近，你甚至可以看清爪子上的污水与淤泥…",
            "nextDialogs": [
              "736500217"
            ]
          },
          "736500217": {
            "id": "736500217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噫…",
            "nextDialogs": [
              "736500218"
            ]
          },
          "736500218": {
            "id": "736500218",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "所以，不要因为主观上觉得时间过得慢就轻敌了，这点请注意…",
            "nextDialogs": [
              "736500219"
            ]
          },
          "736500219": {
            "id": "736500219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会小心的！",
            "nextDialogs": [
              "736500220"
            ]
          },
          "736500220": {
            "id": "736500220",
            "speakerId": 30225,
            "speakerName": "贾米",
            "text": "唉…我的研究，就交给两位了…"
          }
        }
      }
    }
  ]
}
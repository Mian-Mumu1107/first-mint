{
  "lineCounts": {
    "Black Screen": 1,
    "Player": 19,
    "帕纽尔": 18,
    "派蒙": 9,
    "肖维涅": 30
  },
  "subQuests": [
    {
      "subId": "7907501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790750101"
        ],
        "dialogs": {
          "790750101": {
            "id": "790750101",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "肖维涅到底在想什么呢？唉，他就是不愿意和我说话。",
            "nextDialogs": [
              "790750102"
            ]
          },
          "790750102": {
            "id": "790750102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于肖维涅…",
            "nextDialogs": [
              "790750103"
            ]
          },
          "790750103": {
            "id": "790750103",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "您好，两位。很抱歉…肖维涅准是还在生我的气，不肯出来和我说话。",
            "nextDialogs": [
              "790750104"
            ]
          },
          "790750104": {
            "id": "790750104",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "唉，可是那底下既吹不到风，也照不到太阳，要是他枯萎了可怎么办呀？",
            "nextDialogs": [
              "790750105"
            ]
          },
          "790750105": {
            "id": "790750105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个…既然是一盆花的话…",
            "nextDialogs": [
              "790750106"
            ]
          },
          "790750106": {
            "id": "790750106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们可以直接把他捧出来。",
            "nextDialogs": [
              "790750107"
            ]
          },
          "790750107": {
            "id": "790750107",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "我试过了。但肖维涅一直在生闷气，我根本没办法靠近他…",
            "nextDialogs": [
              "790750108"
            ]
          },
          "790750108": {
            "id": "790750108",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "他的气太大，我都差点被吹走了！",
            "nextDialogs": [
              "790750109"
            ]
          },
          "790750109": {
            "id": "790750109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下，为什么生气会把人吹跑啊？",
            "nextDialogs": [
              "790750112"
            ]
          },
          "790750112": {
            "id": "790750112",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "也许是我之前拒绝和肖维涅一起远行，让他不高兴了…",
            "nextDialogs": [
              "790750113"
            ]
          },
          "790750113": {
            "id": "790750113",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "两位客人，能请你们去看看肖维涅吗？说不定，你们能劝得动他。",
            "nextDialogs": [
              "790750114"
            ]
          },
          "790750114": {
            "id": "790750114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题，我们去试试。",
            "nextDialogs": [
              "790750115"
            ]
          },
          "790750115": {
            "id": "790750115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们去过好多地方旅行，也见了好多人，一定…说不定真能劝得动他呢。",
            "nextDialogs": [
              "790750116"
            ]
          },
          "790750116": {
            "id": "790750116",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "那就太好了！肖维涅就在这座岛下面的洞窟里，请你们去那边找他吧。",
            "nextDialogs": [
              "790750117"
            ]
          },
          "790750117": {
            "id": "790750117",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "我…我要打扫打扫这里，给肖维涅找一个最适合晒太阳的地方。"
          }
        }
      }
    },
    {
      "subId": "7907502",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790750201"
        ],
        "dialogs": {
          "790750201": {
            "id": "790750201",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "我…我要打扫打扫这里，给肖维涅找一个最适合晒太阳的地方。",
            "nextDialogs": [
              "790750202"
            ]
          },
          "790750202": {
            "id": "790750202",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "说服肖维涅的事就拜托你们了，两位客人。",
            "nextDialogs": [
              "790750203"
            ]
          },
          "790750203": {
            "id": "790750203",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "要是我去见肖维涅，说不定他又会嫌我唠叨，开始生闷气…"
          }
        }
      }
    },
    {
      "subId": "7907503",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790750301"
        ],
        "dialogs": {
          "790750301": {
            "id": "790750301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼…风总算停下来了…",
            "nextDialogs": [
              "790750304"
            ]
          },
          "790750304": {
            "id": "790750304",
            "speakerId": 21585,
            "speakerName": "肖维涅",
            "text": "好吧。我会听你们说的。但在那之前…",
            "nextDialogs": [
              "790750305"
            ]
          },
          "790750305": {
            "id": "790750305",
            "speakerId": 21585,
            "speakerName": "肖维涅",
            "text": "瞧瞧二位震惊的样。想必也是想要问我「为什么一盆花会说话」。",
            "nextDialogs": [
              "790750306"
            ]
          },
          "790750306": {
            "id": "790750306",
            "speakerId": 21585,
            "speakerName": "肖维涅",
            "text": "或者是，「为什么你会变成一盆花。」",
            "nextDialogs": [
              "790750307"
            ]
          },
          "790750307": {
            "id": "790750307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有很多人问过你吗？",
            "nextDialogs": [
              "790750308"
            ]
          },
          "790750308": {
            "id": "790750308",
            "speakerId": 21585,
            "speakerName": "肖维涅",
            "text": "在外面的时候，有很多人这么问。回家了之后…倒是没有人问了。",
            "nextDialogs": [
              "790750309"
            ]
          },
          "790750309": {
            "id": "790750309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你说的「外面」，是指这个世界外吗？",
            "nextDialogs": [
              "790750310"
            ]
          },
          "790750310": {
            "id": "790750310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我听说，你是远游后才变成这样的。",
            "nextDialogs": [
              "790750311"
            ]
          },
          "790750311": {
            "id": "790750311",
            "speakerId": 21585,
            "speakerName": "肖维涅",
            "text": "你倒是消息齐全。应该是帕纽尔告诉你的吧？",
            "nextDialogs": [
              "790750312"
            ]
          },
          "790750312": {
            "id": "790750312",
            "speakerId": 21585,
            "speakerName": "肖维涅",
            "text": "没错。在远游的途中，我变成了这样。呵呵，用罗泽尔那家伙的话说…这就是我自愿做出的「改变」。",
            "nextDialogs": [
              "790750313"
            ]
          },
          "790750313": {
            "id": "790750313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "改变倒是能够理解啦。但你为什么要变成一盆花呢？"
          }
        }
      }
    },
    {
      "subId": "7907504",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790750401"
        ],
        "dialogs": {
          "790750401": {
            "id": "790750401",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "肖维涅！你…你来了。听我说，我从来没有对你生过气，也不想离开你。",
            "nextDialogs": [
              "790750402"
            ]
          },
          "790750402": {
            "id": "790750402",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "我只是担心，你不愿和我继续做朋友…有些冒险客会改变，我担心你也会一样。",
            "nextDialogs": [
              "790750403"
            ]
          },
          "790750403": {
            "id": "790750403",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "我向女神许过愿，但是…但是我没找到好礼物，她准是没有搭理我…",
            "nextDialogs": [
              "790750404"
            ]
          },
          "790750404": {
            "id": "790750404",
            "speakerId": 21585,
            "speakerName": "肖维涅",
            "text": "不！帕纽尔，只有这件事绝不会发生。我永远都会是你的朋友。",
            "nextDialogs": [
              "790750405"
            ]
          },
          "790750405": {
            "id": "790750405",
            "speakerId": 21585,
            "speakerName": "肖维涅",
            "text": "我要向你道歉。是我光想着自己的心思，却忘了听你所说的话。",
            "nextDialogs": [
              "790750406"
            ]
          },
          "790750406": {
            "id": "790750406",
            "speakerId": 21585,
            "speakerName": "肖维涅",
            "text": "我以为…我以为你不想再看见我这副模样。",
            "nextDialogs": [
              "790750407"
            ]
          },
          "790750407": {
            "id": "790750407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那现在误会总算解开了。",
            "nextDialogs": [
              "790750408"
            ]
          },
          "790750408": {
            "id": "790750408",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀。我还以为你们有超大的心结，超级生气，根本不想搭理对方呢。",
            "nextDialogs": [
              "790750411"
            ]
          },
          "790750411": {
            "id": "790750411",
            "speakerId": 21585,
            "speakerName": "肖维涅",
            "text": "谢谢你们，两位客人。要是没有你们，我准还窝着不愿出来呢。",
            "nextDialogs": [
              "790750412"
            ]
          },
          "790750412": {
            "id": "790750412",
            "speakerId": 21585,
            "speakerName": "肖维涅",
            "text": "现在，我总算能把我的心里话告诉帕纽尔了。",
            "nextDialogs": [
              "790750413"
            ]
          },
          "790750413": {
            "id": "790750413",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "我时刻都愿意听你说话，肖维涅。无论是远游，还是花盆…什么都行。",
            "nextDialogs": [
              "790750414"
            ]
          },
          "790750414": {
            "id": "790750414",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "对了，两位客人。这些东西还请你们收下吧，这都是我特意搜集的。",
            "nextDialogs": [
              "790750415"
            ]
          },
          "790750415": {
            "id": "790750415",
            "speakerId": 21449,
            "speakerName": "帕纽尔",
            "text": "愿女神保佑你们，永远不和自己的朋友吵架，永远有人愿意听你们说心里话。"
          }
        }
      }
    }
  ]
}
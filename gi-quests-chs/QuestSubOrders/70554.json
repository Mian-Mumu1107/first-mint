  "subQuests": [
    {
      "subId": "7055401",
      "subQuestName": "与赫塔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705540101"
        ],
        "dialogs": {
          "705540101": {
            "id": "705540101",
            "speakerId": 1000,
            "speakerName": "赫塔",
            "text": "荣誉骑士和白色小帮手，你们好啊！",
            "nextDialogs": [
              "705540102"
            ]
          },
          "705540102": {
            "id": "705540102",
            "speakerId": 1001,
            "speakerName": "格兰菲狄",
            "text": "初次见面，荣誉骑士和派蒙长官，在下格兰菲狄，听候调遣。",
            "nextDialogs": [
              "705540103"
            ]
          },
          "705540103": {
            "id": "705540103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "心情不错嘛，赫塔！还有这位骑士小姐，很高兴认识你！",
            "nextDialogs": [
              "705540104"
            ]
          },
          "705540104": {
            "id": "705540104",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "看样子，你们正准备开张了？",
            "nextDialogs": [
              "705540105"
            ]
          },
          "705540105": {
            "id": "705540105",
            "speakerId": 1000,
            "speakerName": "赫塔",
            "text": "嗯！得益于「天使的馈赠」和「猫尾酒馆」的协助，饮品小站的一切都准备就绪了。",
            "nextDialogs": [
              "705540106"
            ]
          },
          "705540106": {
            "id": "705540106",
            "speakerId": 1000,
            "speakerName": "赫塔",
            "text": "除了经典的纯饮，我们这里也提供调制饮品，以及限时饮品外送服务…",
            "nextDialogs": [
              "705540107"
            ]
          },
          "705540107": {
            "id": "705540107",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "调制饮品？",
            "nextDialogs": [
              "705540108"
            ]
          },
          "705540108": {
            "id": "705540108",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "很久以前，我们在「天使的馈赠」当过调饮师来着？最近你在挪德卡莱的「旗舰」也露过几手…",
            "nextDialogs": [
              "705540111"
            ]
          },
          "705540111": {
            "id": "705540111",
            "speakerId": 1000,
            "speakerName": "赫塔",
            "text": "不过，目前的饮品都比较传统，远征开始前，所有人就习以为常了。为了给大家提供新鲜的选择，我们打算改进酒单。",
            "nextDialogs": [
              "705540112"
            ]
          },
          "705540112": {
            "id": "705540112",
            "speakerId": 1000,
            "speakerName": "赫塔",
            "text": "但我还得回去管理居民请求的事宜，格兰菲狄调制饮品的经验又不足，还有外送的订单要处理…",
            "nextDialogs": [
              "705540113"
            ]
          },
          "705540113": {
            "id": "705540113",
            "speakerId": 1000,
            "speakerName": "赫塔",
            "text": "如果荣誉骑士有空，能麻烦你暂时帮帮忙吗？一段时间后，我的另一组部下就会从望风山地回来顶班。",
            "nextDialogs": [
              "705540114"
            ]
          },
          "705540114": {
            "id": "705540114",
            "speakerId": 1001,
            "speakerName": "格兰菲狄",
            "text": "当然，我们会支付报酬，还有双倍的加班绩效！"
          }
        }
      }
    }
  ]
}
    {
      "subId": "1402406",
      "subQuestName": "寻找克雷薇的身影",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140240601"
        ],
        "dialogs": {
          "140240601": {
            "id": "140240601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "克雷薇！",
            "nextDialogs": [
              "140240602"
            ]
          },
          "140240602": {
            "id": "140240602",
            "speakerId": 13883,
            "speakerName": "克雷薇",
            "text": "嘘…",
            "nextDialogs": [
              "140240603"
            ]
          },
          "140240603": {
            "id": "140240603",
            "speakerId": 13883,
            "speakerName": "克雷薇",
            "text": "趁没有人盯着，我把窗户打开了。",
            "nextDialogs": [
              "140240604"
            ]
          },
          "140240604": {
            "id": "140240604",
            "speakerId": 13883,
            "speakerName": "克雷薇",
            "text": "你们看，外面的景色很漂亮吧。",
            "nextDialogs": [
              "140240607"
            ]
          },
          "140240607": {
            "id": "140240607",
            "speakerId": 13883,
            "speakerName": "克雷薇",
            "text": "只可惜，这就是我能做的极限了。",
            "nextDialogs": [
              "140240608"
            ]
          },
          "140240608": {
            "id": "140240608",
            "speakerId": 13883,
            "speakerName": "克雷薇",
            "text": "在你们眼中，我所做的事情是不是很可笑呢？相较于这种看不到希望的反抗，还是生活在美好的梦里比较轻松。",
            "nextDialogs": [
              "140240609"
            ]
          },
          "140240609": {
            "id": "140240609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "克雷薇，你到底知道什么呀？能和我们具体说说吗？",
            "nextDialogs": [
              "140240610"
            ]
          },
          "140240610": {
            "id": "140240610",
            "speakerId": 13883,
            "speakerName": "克雷薇",
            "text": "可以呀，虽然你们可能会后悔听到这些事情。",
            "nextDialogs": [
              "140240611"
            ]
          },
          "140240611": {
            "id": "140240611",
            "speakerId": 13883,
            "speakerName": "克雷薇",
            "text": "包括我在内，这个家里的所有人都只是「工具」与「消耗品」。",
            "nextDialogs": [
              "140240612"
            ]
          },
          "140240612": {
            "id": "140240612",
            "speakerId": 13883,
            "speakerName": "克雷薇",
            "text": "有利用价值的人暂时留着，没有价值的人，被送给「博士」做实验。我亲眼见过许多人生不如死的模样，我已经受够了。",
            "nextDialogs": [
              "140240613"
            ]
          },
          "140240613": {
            "id": "140240613",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你说的这些都是「仆人」做的？",
            "nextDialogs": [
              "140240614"
            ]
          },
          "140240614": {
            "id": "140240614",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我觉得不像吧。虽说她看起来很可怕，但好像也没坏到这个程度。",
            "nextDialogs": [
              "140240615"
            ]
          },
          "140240615": {
            "id": "140240615",
            "speakerId": 13883,
            "speakerName": "克雷薇",
            "text": "嗯，我知道你们不会相信我的。",
            "nextDialogs": [
              "140240616"
            ]
          },
          "140240616": {
            "id": "140240616",
            "speakerId": 13883,
            "speakerName": "克雷薇",
            "text": "每个人都觉得她是个好人，都觉得她是一位真正的「母亲」…",
            "nextDialogs": [
              "140240617"
            ]
          },
          "140240617": {
            "id": "140240617",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「母亲」？",
            "nextDialogs": [
              "140240618"
            ]
          },
          "140240618": {
            "id": "140240618",
            "speakerId": 13883,
            "speakerName": "克雷薇",
            "text": "可她玷污了这个称呼。如果可以，我永远都不想再见到她。",
            "nextDialogs": [
              "140240619"
            ]
          },
          "140240619": {
            "id": "140240619",
            "speakerId": 13883,
            "speakerName": "克雷薇",
            "text": "假如佩佩在这里就好了，她一定能明白我的想法。",
            "nextDialogs": [
              "140240620"
            ]
          },
          "140240620": {
            "id": "140240620",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "佩佩…又是这个名字。",
            "nextDialogs": [
              "140240621"
            ]
          },
          "140240621": {
            "id": "140240621",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#说起来，{NICKNAME}，你有没有一种奇怪的感觉？",
            "nextDialogs": [
              "140240622"
            ]
          },
          "140240622": {
            "id": "140240622",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她和我们之间就好像隔着什么东西一样。她真的是在和我们说话吗，还是把我们错认成了别人？"
          }
        }
      }
    },
    {
      "subId": "1402321",

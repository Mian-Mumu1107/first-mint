    {
      "subId": "1402322",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140232201"
        ],
        "dialogs": {
          "140232201": {
            "id": "140232201",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "克雷薇，我想带你去个地方。你愿意跟我一起来吗？",
            "nextDialogs": [
              "140232202"
            ]
          },
          "140232202": {
            "id": "140232202",
            "speakerId": 13883,
            "speakerName": "克雷薇",
            "text": "可以呀。我们要去哪呢？"
          }
        }
      }
    },
    {
      "subId": "1402499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140249903"
        ],
        "dialogs": {
          "140249903": {
            "id": "140249903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "在那边！",
            "nextDialogs": [
              "140249904"
            ]
          },
          "140249904": {
            "id": "140249904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她到底要去哪？唔，千万别被人看到呀…",
            "nextDialogs": [
              "140249905"
            ]
          },
          "140249905": {
            "id": "140249905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦…快看，她停下来了！"
          }
        }
      }
    }
  ]
}
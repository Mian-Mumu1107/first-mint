    {
      "subId": "7224704",
      "subQuestName": "从残魂处取得供奉之物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722470201"
        ],
        "dialogs": {
          "722470201": {
            "id": "722470201",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "看来汝等的实力完全足以…护送供奉之物…",
            "nextDialogs": [
              "722470202"
            ]
          },
          "722470202": {
            "id": "722470202",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "这样，吾也能够放心了…一定要将之送到，如此才能…",
            "nextDialogs": [
              "722470203"
            ]
          },
          "722470203": {
            "id": "722470203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "如此才能什么呢？",
            "nextDialogs": [
              "722470204"
            ]
          },
          "722470204": {
            "id": "722470204",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "如此才能…如此才能…",
            "nextDialogs": [
              "722470205"
            ]
          },
          "722470205": {
            "id": "722470205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "完了，完全是一副坏掉了的样子。",
            "nextDialogs": [
              "722470206"
            ]
          },
          "722470206": {
            "id": "722470206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过他说的供奉品，就是这个吧…看上去也有点破破烂烂了。"
          }
        }
      }
    },

    {
      "subId": "7224705",
      "subQuestName": "与残魂对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722470301"
        ],
        "dialogs": {
          "722470301": {
            "id": "722470301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有、有什么东西出来了…",
            "nextDialogs": [
              "722470302"
            ]
          },
          "722470302": {
            "id": "722470302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看上去好像也是一个残影。",
            "nextDialogs": [
              "722470303"
            ]
          },
          "722470303": {
            "id": "722470303",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾乃…",
            "nextDialogs": [
              "722470304"
            ]
          },
          "722470304": {
            "id": "722470304",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
            "nextDialogs": [
              "722470305"
            ]
          },
          "722470305": {
            "id": "722470305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这句话我听懂了。",
            "nextDialogs": [
              "722470306"
            ]
          },
          "722470306": {
            "id": "722470306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这句话的意思就是——",
            "nextDialogs": [
              "722470307"
            ]
          },
          "722470307": {
            "id": "722470307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "他说自己的名字是赫利俄斯。",
            "nextDialogs": [
              "722470310"
            ]
          },
          "722470310": {
            "id": "722470310",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是这样吗……",
            "nextDialogs": [
              "722470311"
            ]
          },
          "722470311": {
            "id": "722470311",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "他的名字叫阿倍良久…真是奇怪的名字。",
            "nextDialogs": [
              "722470312"
            ]
          },
          "722470312": {
            "id": "722470312",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，既然他的名字是阿倍良久，那赫利俄斯又是什么呢？",
            "nextDialogs": [
              "722470313"
            ]
          },
          "722470313": {
            "id": "722470313",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "赫利俄斯！赫利俄斯！！",
            "nextDialogs": [
              "722470314"
            ]
          },
          "722470314": {
            "id": "722470314",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "此乃吾亲手所造…赫利俄斯造成之日，万丈光芒自高天笼罩，如是众人不受龙兽侵扰。",
            "nextDialogs": [
              "722470315"
            ]
          },
          "722470315": {
            "id": "722470315",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "啊啊，正当时，诸民仰视，热泪盈眶，扬臂欢呼，难掩喜悦激动之情…可是现在怎么…",
            "nextDialogs": [
              "722470316"
            ]
          },
          "722470316": {
            "id": "722470316",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "不对，吾，吾为何在此…为何…为何吾魂迷梦土，不得安宁。",
            "nextDialogs": [
              "722470317"
            ]
          },
          "722470317": {
            "id": "722470317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙听懂了吗？",
            "nextDialogs": [
              "722470318"
            ]
          },
          "722470318": {
            "id": "722470318",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我懂了。",
            "nextDialogs": [
              "722470319"
            ]
          },
          "722470319": {
            "id": "722470319",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这一定是个…精神不太正常的残魂。",
            "nextDialogs": [
              "722470320"
            ]
          },
          "722470320": {
            "id": "722470320",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾想起来了…吾魂魄不全，等吾魂归一处，即可重获安宁。",
            "nextDialogs": [
              "722470321"
            ]
          },
          "722470321": {
            "id": "722470321",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "转机就在汝身，吾且与汝言说…",
            "nextDialogs": [
              "722470322"
            ]
          },
          "722470322": {
            "id": "722470322",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃，我闻到了麻烦事的气息…",
            "nextDialogs": [
              "722470323"
            ]
          },
          "722470323": {
            "id": "722470323",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "此处本应供奉吾一部分骨殖，但是早已朽坏…算是吾托命于汝…",
            "nextDialogs": [
              "722470324"
            ]
          },
          "722470324": {
            "id": "722470324",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "将这些寄托吾念的供奉品拿去…不过，周围有困守吾魂的怪物，一旦吾魂魄寄寓之物离开…便会蜂拥而上。",
            "nextDialogs": [
              "722470325"
            ]
          },
          "722470325": {
            "id": "722470325",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "此事凶险，旅者啊，若汝准备好了，再与吾说吧。"
          }
        }
      }
    },

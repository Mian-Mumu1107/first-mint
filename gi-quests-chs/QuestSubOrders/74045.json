    {
      "subId": "7404504",
      "subQuestName": "将奇异的矿石带给枫丹廷的宝石商人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740450401"
        ],
        "dialogs": {
          "740450401": {
            "id": "740450401",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "欢迎光临，这里是全枫丹廷宝石种类最齐全的商铺，还有各类工艺品出售。",
            "nextDialogs": [
              "740450402"
            ]
          },
          "740450402": {
            "id": "740450402",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "有什么你们看得上眼的东西吗？没有的话要是有什么其它想要的也尽管问我！",
            "nextDialogs": [
              "740450403"
            ]
          },
          "740450403": {
            "id": "740450403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们手上有些神奇的矿石…",
            "nextDialogs": [
              "740450404"
            ]
          },
          "740450404": {
            "id": "740450404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯嗯，既然是宝石种类最齐全的商铺，那你一定也会清楚我们手上矿石的价值咯！",
            "nextDialogs": [
              "740450405"
            ]
          },
          "740450405": {
            "id": "740450405",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "哦哦，原来你们是来兜售矿石的吗？",
            "nextDialogs": [
              "740450406"
            ]
          },
          "740450406": {
            "id": "740450406",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "那你们可找对人了，我这里的收购价格，可以说是童叟无欺。",
            "nextDialogs": [
              "740450407"
            ]
          },
          "740450407": {
            "id": "740450407",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "那么，是什么样的矿石呢…",
            "nextDialogs": [
              "740450408"
            ]
          },
          "740450408": {
            "id": "740450408",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "你将之前找到的奇异矿石拿出来交给了切瑟尔查看。",
            "nextDialogs": [
              "740450409"
            ]
          },
          "740450409": {
            "id": "740450409",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "这…没想到竟然是连我也没见过的矿石…",
            "nextDialogs": [
              "740450410"
            ]
          },
          "740450410": {
            "id": "740450410",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "不过这奇异的色泽，这光滑的质地…肯定是非常珍稀的品类没错！",
            "nextDialogs": [
              "740450411"
            ]
          },
          "740450411": {
            "id": "740450411",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "虽然这样说不太好意思，不过恕我见识短浅，敢问这到底是什么矿石呢？",
            "nextDialogs": [
              "740450413",
              "740450415",
              "740450417"
            ]
          },
          "740450413": {
            "id": "740450413",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "所以你们才来找我鉴定的吗？",
            "nextDialogs": [
              "740450419"
            ]
          },
          "740450419": {
            "id": "740450419",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "不过这样的矿石竟然只有一块，实在可惜…",
            "nextDialogs": [
              "740450420"
            ]
          },
          "740450420": {
            "id": "740450420",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "如果能有足够的货源，说不定就可以打磨制作出足以风靡整个枫丹的饰品了。",
            "nextDialogs": [
              "740450421"
            ]
          },
          "740450421": {
            "id": "740450421",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（我记得芙佳说过这样的石头在矿脉附近到处都是，要是问问她的话…）"
          },
          "740450415": {
            "id": "740450415",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "什么啦，不要起奇怪的名字吧！"
          },
          "740450417": {
            "id": "740450417",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，是你刚编出来的名字吗？",
            "nextDialogs": [
              "740450418"
            ]
          },
          "740450418": {
            "id": "740450418",
            "speakerId": 1003,
            "speakerName": "切瑟尔",
            "text": "竟然是叫这样厉害的名字，怪不得看上去会这么特殊！"
          }
        }
      }
    },
    {
      "subId": "7404506",
      "subQuestName": "（test）前往大量矿石区域",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740450601"
        ],
        "dialogs": {
          "740450601": {
            "id": "740450601",
            "speakerId": 1001,
            "speakerName": "芙佳",
            "text": "又见到你们啦！",
            "nextDialogs": [
              "740450602"
            ]
          },
          "740450602": {
            "id": "740450602",
            "speakerId": 1001,
            "speakerName": "芙佳",
            "text": "是想知道什么关于矿石的事情吗？不管是什么都可以问我哦！",
            "nextDialogs": [
              "740450603"
            ]
          },
          "740450603": {
            "id": "740450603",
            "speakerId": 1001,
            "speakerName": "芙佳",
            "text": "虽然芙佳也不一定知道…",
            "nextDialogs": [
              "740450605",
              "740450608",
              "740450610"
            ]
          },
          "740450605": {
            "id": "740450605",
            "speakerId": 1001,
            "speakerName": "芙佳",
            "text": "虽然附近的矿脉有很多亮闪闪的、好看的石头，但是距离真正的宝石还有很大的差距…",
            "nextDialogs": [
              "740450606"
            ]
          },
          "740450606": {
            "id": "740450606",
            "speakerId": 1001,
            "speakerName": "芙佳",
            "text": "如果我也能够找到真正的宝石的话，说不定就能像希露艾姐姐一样拥有自己的宝石工坊了！"
          },
          "740450608": {
            "id": "740450608",
            "speakerId": 1001,
            "speakerName": "芙佳",
            "text": "欸？芙佳从来没有想过这些…我只是觉得好看才会收集各种各样的石头的…"
          },
          "740450610": {
            "id": "740450610",
            "speakerId": 1001,
            "speakerName": "芙佳",
            "text": "嘿嘿，谢谢你们能过来找芙佳玩！"
          }
        }
      }
    },

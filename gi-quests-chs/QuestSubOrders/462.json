  "subQuests": [
    {
      "subId": "46201",
      "subQuestName": "在约定地点与线人见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4620101"
        ],
        "dialogs": {
          "4620101": {
            "id": "4620101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#那边…{NICKNAME}，快看！那个姑娘有危险！",
            "nextDialogs": [
              "4620102"
            ]
          },
          "4620102": {
            "id": "4620102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "先别管接头的事了，快去救救她吧！"
          }
        }
      }
    },
    {
      "subId": "46202",
      "subQuestName": "击退围攻线人的怪物",
      "sceneId": null,
      "locations": [],
      "dialogue": {

    {
      "subId": "46203",
      "subQuestName": "与线人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4620301"
        ],
        "dialogs": {
          "4620301": {
            "id": "4620301",
            "speakerId": 1001,
            "speakerName": "薇尔",
            "text": "唉…怎么会遇到这种事，早知道就不该帮<color=#00E1FFFF>他</color>这个忙了…",
            "nextDialogs": [
              "4620302"
            ]
          },
          "4620302": {
            "id": "4620302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「他」？",
            "nextDialogs": [
              "4620303"
            ]
          },
          "4620303": {
            "id": "4620303",
            "speakerId": 1001,
            "speakerName": "薇尔",
            "text": "真是谢谢你们！差点就要有大麻烦了，你们可比那些西风骑士靠谱多了。",
            "nextDialogs": [
              "4620304"
            ]
          },
          "4620304": {
            "id": "4620304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#小意思小意思，毕竟{NICKNAME}作为旅行者，每天都要面对很多麻烦的。",
            "nextDialogs": [
              "4620305"
            ]
          },
          "4620305": {
            "id": "4620305",
            "speakerId": 1001,
            "speakerName": "薇尔",
            "text": "旅行者？我好像听过你的情报，没想到被<color=#00E1FFFF>接头人</color>救了一命。",
            "nextDialogs": [
              "4620306"
            ]
          },
          "4620306": {
            "id": "4620306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇！原来你就是…",
            "nextDialogs": [
              "4620307"
            ]
          },
          "4620307": {
            "id": "4620307",
            "speakerId": 1001,
            "speakerName": "薇尔",
            "text": "呵呵呵…本来还不知道该如何报答你们。既然这样，就把情报免费送给你们好了。",
            "nextDialogs": [
              "4620308"
            ]
          },
          "4620308": {
            "id": "4620308",
            "speakerId": 1001,
            "speakerName": "薇尔",
            "text": "做情报生意的，都知道多交朋友的重要性呢。",
            "nextDialogs": [
              "4620310"
            ]
          },
          "4620310": {
            "id": "4620310",
            "speakerId": 1001,
            "speakerName": "薇尔",
            "text": "当然，毕竟是救命恩人嘛。",
            "nextDialogs": [
              "4620312"
            ]
          },
          "4620312": {
            "id": "4620312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿，真是好运！",
            "nextDialogs": [
              "4620313"
            ]
          },
          "4620313": {
            "id": "4620313",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可是…怎么感觉便宜了凯亚那家伙，说好情报费由他来出的…",
            "nextDialogs": [
              "4620314"
            ]
          },
          "4620314": {
            "id": "4620314",
            "speakerId": 1001,
            "speakerName": "薇尔",
            "text": "那听好咯，有关「阿卡狄亚遗迹」的情报…",
            "nextDialogs": [
              "4620315"
            ]
          },
          "4620315": {
            "id": "4620315",
            "speakerId": 1001,
            "speakerName": "薇尔",
            "text": "「在那湖中之城里，住着三只六臂巨人。两位守护着神像，一位守护着众神的财宝」",
            "nextDialogs": [
              "4620316"
            ]
          },
          "4620316": {
            "id": "4620316",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…嗯？这就完啦？",
            "nextDialogs": [
              "4620325"
            ]
          },
          "4620325": {
            "id": "4620325",
            "speakerId": 1001,
            "speakerName": "薇尔",
            "text": "记录着情报的纸上还附了这样一张图…",
            "nextDialogs": [
              "4620317"
            ]
          },
          "4620317": {
            "id": "4620317",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…这图上画的难道就是藏宝地？",
            "nextDialogs": [
              "4620318"
            ]
          },
          "4620318": {
            "id": "4620318",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…好不容易拿到了线索，原来还要猜谜呀。",
            "nextDialogs": [
              "4620319"
            ]
          },
          "4620319": {
            "id": "4620319",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#不过以{NICKNAME}的聪明才智应该不是问题吧~！"
          }
        }
      }
    },
    {
      "subId": "46204",
      "subQuestName": "(test)寻找谜题中所指的地点$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4620401"
        ],
        "dialogs": {
          "4620401": {
            "id": "4620401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "快让我看看~！藏起来的是什么东西？",
            "nextDialogs": [
              "4620402"
            ]
          },
          "4620402": {
            "id": "4620402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「她根本不爱他。清泉的热情奔放只是虚浮表象，冰冷寂寞之时，她的心才显露真实」。",
            "nextDialogs": [
              "4620407"
            ]
          },
          "4620407": {
            "id": "4620407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这次同样也附了一张图呢。",
            "nextDialogs": [
              "4620403"
            ]
          },
          "4620403": {
            "id": "4620403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "什么嘛，还要猜谜吗？",
            "nextDialogs": [
              "4620404"
            ]
          },
          "4620404": {
            "id": "4620404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不行了，派蒙觉得好累，头晕晕的，大概是用脑过度了吧。",
            "nextDialogs": [
              "4620405"
            ]
          },
          "4620405": {
            "id": "4620405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你明明就没动过脑…",
            "nextDialogs": [
              "4620406"
            ]
          },
          "4620406": {
            "id": "4620406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "总之这次也靠你了，嘻嘻。没有想法的话，就再去找凯亚帮忙吧~！"
          }
        }
      }
    },
    {
      "subId": "46210",
      "subQuestName": "(test)控制派蒙对话后消失$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "46205",
      "subQuestName": "破解谜题（到骑士团找凯亚可获取提示）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4620501"
        ],
        "dialogs": {
          "4620501": {
            "id": "4620501",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "#{NICKNAME}！你们回来了，看上去线索你们已经拿到了。",
            "nextDialogs": [
              "4620502"
            ]
          },
          "4620502": {
            "id": "4620502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "拿到了是没错，但好像比想象中复杂…",
            "nextDialogs": [
              "4620503"
            ]
          },
          "4620503": {
            "id": "4620503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「在那湖中之城里，住着三只六臂巨人。两位守护着神像，一位守护着众神的财宝」，这是什么意思？",
            "nextDialogs": [
              "4620504"
            ]
          },
          "4620504": {
            "id": "4620504",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "居然是用猜谜的方式…真是传统呢。让我想想…",
            "nextDialogs": [
              "4620505"
            ]
          },
          "4620505": {
            "id": "4620505",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "湖中之城应该指的是蒙德城没错…六臂巨人？六…什么东西与六相关来着…",
            "nextDialogs": [
              "4620506"
            ]
          },
          "4620506": {
            "id": "4620506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道是螃蟹脚？",
            "nextDialogs": [
              "4620507"
            ]
          },
          "4620507": {
            "id": "4620507",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "所以六臂巨人是巨大的螃蟹！",
            "nextDialogs": [
              "4620508"
            ]
          },
          "4620508": {
            "id": "4620508",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "…先不说哪里有巨大螃蟹的问题…",
            "nextDialogs": [
              "4620509"
            ]
          },
          "4620509": {
            "id": "4620509",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "螃蟹是有八只蟹脚的吧。",
            "nextDialogs": [
              "4620516"
            ]
          },
          "4620516": {
            "id": "4620516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…那应该是指风车？",
            "nextDialogs": [
              "4620517"
            ]
          },
          "4620517": {
            "id": "4620517",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "应该是指…风车？",
            "nextDialogs": [
              "4620518"
            ]
          },
          "4620518": {
            "id": "4620518",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "哦~！不愧是你。",
            "nextDialogs": [
              "4620519"
            ]
          },
          "4620519": {
            "id": "4620519",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "风车上的扇叶刚好有六个，称它为「六臂巨人」似乎很形象呢。",
            "nextDialogs": [
              "4620510"
            ]
          },
          "4620510": {
            "id": "4620510",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇！你这么一说！",
            "nextDialogs": [
              "4620511"
            ]
          },
          "4620511": {
            "id": "4620511",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "剩下的问题就简单了，三座风车中，有两座离神像很近，是守护神像的「巨人」。",
            "nextDialogs": [
              "4620512"
            ]
          },
          "4620512": {
            "id": "4620512",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "而除此之外的那一座所守护的东西，应该就是…",
            "nextDialogs": [
              "4620513"
            ]
          },
          "4620513": {
            "id": "4620513",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "宝藏！这里可难不倒我！",
            "nextDialogs": [
              "4620514"
            ]
          },
          "4620514": {
            "id": "4620514",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "呵呵呵…希望真的能那样顺利。",
            "nextDialogs": [
              "4620515"
            ]
          },
          "4620515": {
            "id": "4620515",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#走吧走吧，{NICKNAME}我们快去那座风车下看看吧！"
          }
        }
      }
    },
    {
      "subId": "46208",
      "subQuestName": "寻找谜题中所指的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4620801"
        ],
        "dialogs": {
          "4620801": {
            "id": "4620801",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "地点在低语森林，你没忘记吧。"
          }
        }
      }
    },
    {
      "subId": "46206",
      "subQuestName": "(test)寻找谜题中所指的地点$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4620601"
        ],
        "dialogs": {
          "4620601": {
            "id": "4620601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，对本天才来说真是小意思。你看这是张地图！"
          }
        }
      }
    },
    {
      "subId": "46207",
      "subQuestName": "破解谜题（到骑士团找凯亚可获取提示）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4620701"
        ],
        "dialogs": {
          "4620701": {
            "id": "4620701",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "「她根本不爱他。清泉的热情奔放只是虚浮表象，冰冷寂寞之时，她的心才显露真实」…",
            "nextDialogs": [
              "4620702"
            ]
          },
          "4620702": {
            "id": "4620702",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "想到什么了吗？",
            "nextDialogs": [
              "4620703"
            ]
          },
          "4620703": {
            "id": "4620703",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "这该不会是你们碰巧捡到的恋爱小说的残页吧…",
            "nextDialogs": [
              "4620704"
            ]
          },
          "4620704": {
            "id": "4620704",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来搞错了呀，怪不得我这么聪明都猜不出来！",
            "nextDialogs": [
              "4620705"
            ]
          },
          "4620705": {
            "id": "4620705",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "哈哈哈…我开玩笑的。",
            "nextDialogs": [
              "4620706"
            ]
          },
          "4620706": {
            "id": "4620706",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔嗯…你认真点啦，凯亚！",
            "nextDialogs": [
              "4620707"
            ]
          },
          "4620707": {
            "id": "4620707",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "哈哈，这个谜题确实更难猜一点。清泉…是说清泉镇吗？",
            "nextDialogs": [
              "4620708"
            ]
          },
          "4620708": {
            "id": "4620708",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "「清泉的热情奔放」…什么情况下清泉会显得热情奔放呢？",
            "nextDialogs": [
              "4620709"
            ]
          },
          "4620709": {
            "id": "4620709",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "至于「瀑布的心」，应该就是瀑布左侧的山崖之上吧，我巡逻的时候从瀑布下面眺望过那里。",
            "nextDialogs": [
              "4620710"
            ]
          },
          "4620710": {
            "id": "4620710",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "最后「冰冷寂寞之时」，大概和神之眼所能操控的冰元素脱不了关系。",
            "nextDialogs": [
              "4620711"
            ]
          },
          "4620711": {
            "id": "4620711",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "你最好<color=#00E1FFFF>带上一位能够掌控冰元素的朋友一起去</color>。",
            "nextDialogs": [
              "4620712"
            ]
          },
          "4620712": {
            "id": "4620712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "多亏了凯亚帮忙。",
            "nextDialogs": [
              "4620713"
            ]
          },
          "4620713": {
            "id": "4620713",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "不足挂齿，作为西风骑士如果连猜谜都不擅长的话，还怎么看穿罪犯的阴谋诡计呢？",
            "nextDialogs": [
              "4620714"
            ]
          },
          "4620714": {
            "id": "4620714",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那我们去清泉镇看看了，就不打扰你的阴谋诡计啦~！",
            "nextDialogs": [
              "4620715"
            ]
          },
          "4620715": {
            "id": "4620715",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "…嗯？",
            "nextDialogs": [
              "4620716"
            ]
          },
          "4620716": {
            "id": "4620716",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦不对…是不打扰你看穿罪犯的阴谋诡计！"
          }
        }
      }
    },
    {
      "subId": "46209",
      "subQuestName": "寻找谜题中所指的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4620901"
        ],
        "dialogs": {
          "4620901": {
            "id": "4620901",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "没猜错的话，线索指向的是离神像最远的风车处…我也不是那么确定哦。"
          }
        }
      }
    },
    {
      "subId": "46210",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4621001"
        ],
        "dialogs": {
          "4621001": {
            "id": "4621001",
            "speakerId": 1002,
            "speakerName": "凯亚",
            "text": "去清泉镇的瀑布上找找吧，记得带上一位善用冰元素的朋友。哦？嗯…我自己吗…"
          }

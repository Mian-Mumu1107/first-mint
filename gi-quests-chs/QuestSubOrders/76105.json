    {
      "subId": "7610501",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761050101"
        ],
        "dialogs": {
          "761050101": {
            "id": "761050101",
            "speakerId": 22226,
            "speakerName": "玛尔塔",
            "text": "#{M#大哥哥}{F#大姐姐}，你看到那些岩居蟹了吗？好像在进行什么神秘的仪式。",
            "nextDialogs": [
              "761050102"
            ]
          },
          "761050102": {
            "id": "761050102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是它们的生态吧。",
            "nextDialogs": [
              "761050103"
            ]
          },
          "761050103": {
            "id": "761050103",
            "speakerId": 22226,
            "speakerName": "玛尔塔",
            "text": "是这样吗？哦…我好像懂了。",
            "nextDialogs": [
              "761050104"
            ]
          },
          "761050104": {
            "id": "761050104",
            "speakerId": 22226,
            "speakerName": "玛尔塔",
            "text": "那夏镇也有很多人跟这些岩居蟹一样，有的会勾肩搭背走在一起，有的一见面就拳脚问候然后分开。",
            "nextDialogs": [
              "761050105"
            ]
          },
          "761050105": {
            "id": "761050105",
            "speakerId": 22226,
            "speakerName": "玛尔塔",
            "text": "这就是那夏镇的生态吧。",
            "nextDialogs": [
              "761050108"
            ]
          },
          "761050108": {
            "id": "761050108",
            "speakerId": 22226,
            "speakerName": "玛尔塔",
            "text": "#那{M#大哥哥}{F#大姐姐}，你能让这些岩居蟹都进到小水潭里吗？",
            "nextDialogs": [
              "761050109"
            ]
          },
          "761050109": {
            "id": "761050109",
            "speakerId": 22226,
            "speakerName": "玛尔塔",
            "text": "唔…就像把所有的宝藏猎人都喊去「旗舰」？感觉会很有意思。",
            "nextDialogs": [
              "761051501"
            ]
          },
          "761051501": {
            "id": "761051501",
            "speakerId": 22226,
            "speakerName": "玛尔塔",
            "text": "#好想看看岩居蟹都聚在一起的时候会发生什么…{M#大哥哥}{F#大姐姐}，你现在有空吗？"
          }
        }
      }
    },

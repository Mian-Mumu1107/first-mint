{
  "lineCounts": {
    "Player": 23,
    "曜": 31,
    "派蒙": 3,
    "满": 20,
    "竺子": 30
  },
  "subQuests": [
    {
      "subId": "7280201",
      "subQuestName": "与竺子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728020101"
        ],
        "dialogs": {
          "728020101": {
            "id": "728020101",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "不知道妈妈的身体怎么样了，还有爸爸…",
            "nextDialogs": [
              "728020102"
            ]
          },
          "728020102": {
            "id": "728020102",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "咦？旅行者？你怎么来了，我记得上次你来问我前往稻妻的方法…",
            "nextDialogs": [
              "728020103"
            ]
          },
          "728020103": {
            "id": "728020103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经去过稻妻了。",
            "nextDialogs": [
              "728020104"
            ]
          },
          "728020104": {
            "id": "728020104",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "居、居然真的过去了，而且还能回来…",
            "nextDialogs": [
              "728020105"
            ]
          },
          "728020105": {
            "id": "728020105",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "不愧是名扬四方的勇士，各方面的本领都不是我这种普通人能企及的。",
            "nextDialogs": [
              "728020106"
            ]
          },
          "728020106": {
            "id": "728020106",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "对、对了！如果可以的话，能不能请你帮我一个忙？",
            "nextDialogs": [
              "728020109"
            ]
          },
          "728020109": {
            "id": "728020109",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "说起来，当初我离开稻妻的时候，是不辞而别。",
            "nextDialogs": [
              "728020110"
            ]
          },
          "728020110": {
            "id": "728020110",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "我从小就向往稻妻之外的广阔世界，喜欢到处游历，不喜欢受父母管束。",
            "nextDialogs": [
              "728020111"
            ]
          },
          "728020111": {
            "id": "728020111",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "眼狩令颁布后，稻妻的气氛变得越来越压抑，我这才临时起意，离开了家乡。",
            "nextDialogs": [
              "728020112"
            ]
          },
          "728020112": {
            "id": "728020112",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "虽然来了璃月之后，我勉强找到了维生的办法，但却找不到可靠的人帮着给家里捎信报平安。",
            "nextDialogs": [
              "728020113"
            ]
          },
          "728020113": {
            "id": "728020113",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "如果你愿意的话，我能请你帮忙把家书带给父母吗？"
          }
        }
      }
    },
    {
      "subId": "7280202",
      "subQuestName": "将家书交给满与曜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728020201"
        ],
        "dialogs": {
          "728020201": {
            "id": "728020201",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "明天午饭做几道菜好呢？",
            "nextDialogs": [
              "728020202"
            ]
          },
          "728020202": {
            "id": "728020202",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "咱家孩子是越来越能吃了，多做点总归没错。",
            "nextDialogs": [
              "728020203"
            ]
          },
          "728020203": {
            "id": "728020203",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "咦？请问您是…",
            "nextDialogs": [
              "728020206"
            ]
          },
          "728020206": {
            "id": "728020206",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "是的，请问您有什么事吗？",
            "nextDialogs": [
              "728020207"
            ]
          },
          "728020207": {
            "id": "728020207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是竺子让我带给你们的信。",
            "nextDialogs": [
              "728020208"
            ]
          },
          "728020208": {
            "id": "728020208",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "信，这孩子为什么突然要写信？",
            "nextDialogs": [
              "728020209"
            ]
          },
          "728020209": {
            "id": "728020209",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "还写这么长…明明都已经回家了，有什么话直接对我们说不就好了嘛。"
          }
        }
      }
    },
    {
      "subId": "7280203",
      "subQuestName": "等到第二天晚上（18点~6点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728020301"
        ],
        "dialogs": {
          "728020301": {
            "id": "728020301",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "女儿回家的日期…怎么比这家书上落款的日期还早？",
            "nextDialogs": [
              "728020302"
            ]
          },
          "728020302": {
            "id": "728020302",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "别胡思乱想了，大概只是误会，还是好好帮我想想明天午饭做什么吧。"
          }
        }
      }
    },
    {
      "subId": "7280204",
      "subQuestName": "等到晚上（18点~6点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728020401"
        ],
        "dialogs": {
          "728020401": {
            "id": "728020401",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "我们家竺子现在不在，请你等到晚上再来吧。",
            "nextDialogs": [
              "728020402"
            ]
          },
          "728020402": {
            "id": "728020402",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "等到了晚上，竺子应该就会回来了。"
          }
        }
      }
    },
    {
      "subId": "7280205",
      "subQuestName": "前往竺子家",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728020501"
        ],
        "dialogs": {
          "728020501": {
            "id": "728020501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "竺子一家应该都在屋子里了，我们敲敲门吧。",
            "nextDialogs": [
              "728020502"
            ]
          },
          "728020502": {
            "id": "728020502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们好像在聊些什么。",
            "nextDialogs": [
              "728020503"
            ]
          },
          "728020503": {
            "id": "728020503",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "说起来，不知道我们之前救下的那只狸猫怎么样了。",
            "nextDialogs": [
              "728020504"
            ]
          },
          "728020504": {
            "id": "728020504",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "你呀，太善良了，那只狸猫不过是腿上受了点小伤，其实把它留在草丛里，让它自己修养也能好。",
            "nextDialogs": [
              "728020505"
            ]
          },
          "728020505": {
            "id": "728020505",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "我舍不得嘛，它当时都看着我流眼泪了，可怜巴巴的，我怎么能不把它带回家照顾呢？",
            "nextDialogs": [
              "728020506"
            ]
          },
          "728020506": {
            "id": "728020506",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "算啦，行善总是好事，就是它吃的实在有点多，快赶上我了…",
            "nextDialogs": [
              "728020507"
            ]
          },
          "728020507": {
            "id": "728020507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "敲门",
            "nextDialogs": [
              "728020508"
            ]
          },
          "728020508": {
            "id": "728020508",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "是谁啊？",
            "nextDialogs": [
              "728020509"
            ]
          },
          "728020509": {
            "id": "728020509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是之前来过的旅行者。",
            "nextDialogs": [
              "728020510"
            ]
          },
          "728020510": {
            "id": "728020510",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "哦，是那位旅行者吧，稍等。",
            "nextDialogs": [
              "728020511"
            ]
          },
          "728020511": {
            "id": "728020511",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "你、你好！我是竺子，初次…不…又见面了！",
            "nextDialogs": [
              "728020512"
            ]
          },
          "728020512": {
            "id": "728020512",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "不好意思，因为实在太想家，所以我在把信交给你们之后又变了主意，坐船回了家。",
            "nextDialogs": [
              "728020513"
            ]
          },
          "728020513": {
            "id": "728020513",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "啊哈哈…之前都是误会，抱歉啦，让你跑这么一趟。",
            "nextDialogs": [
              "728020514"
            ]
          },
          "728020514": {
            "id": "728020514",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你有办法回到稻妻？",
            "nextDialogs": [
              "728020515"
            ]
          },
          "728020515": {
            "id": "728020515",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "…啊，我有自己的途径哈哈，这个你就不用管了。",
            "nextDialogs": [
              "728020516"
            ]
          },
          "728020516": {
            "id": "728020516",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "那个，报酬我已经准备好了，请收下吧，多谢你们帮忙。快点…呃，快点忙你们的事去吧。",
            "nextDialogs": [
              "728020517"
            ]
          },
          "728020517": {
            "id": "728020517",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "竺子小姐的话怎么前后不一？要是往返稻妻有这么容易的话，当初干嘛还要拜托我们。",
            "nextDialogs": [
              "728020519",
              "728020521"
            ]
          },
          "728020519": {
            "id": "728020519",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "产业？什么产业，我在璃月还有产业的吗！",
            "nextDialogs": [
              "728020522"
            ]
          },
          "728020522": {
            "id": "728020522",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "…啊，这种东西都是身外之物，和家人相比完全不重要，我早就托付给别人啦，啊…哈哈。",
            "nextDialogs": [
              "728020523"
            ]
          },
          "728020523": {
            "id": "728020523",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂喂，真正的竺子在璃月找工作都成问题，怎么会摇身一变成有钱人？",
            "nextDialogs": [
              "728020524"
            ]
          },
          "728020524": {
            "id": "728020524",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你到底是谁？",
            "nextDialogs": [
              "728020525"
            ]
          },
          "728020525": {
            "id": "728020525",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "我…我当然是竺子了！长得是竺子，声音是竺子，这有什么好怀疑的呢？",
            "nextDialogs": [
              "728020526"
            ]
          },
          "728020526": {
            "id": "728020526",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "我说你啊！真是纠缠不休…算了，我不和你说了，明天我还要工作，先走了。",
            "nextDialogs": [
              "728020527"
            ]
          },
          "728020527": {
            "id": "728020527",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "欸，竺子！这孩子…怎么突然火气这么大…",
            "nextDialogs": [
              "728020528"
            ]
          },
          "728020528": {
            "id": "728020528",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "抱歉啊，旅行者，这孩子肯定是工作太累了。",
            "nextDialogs": [
              "728020529"
            ]
          },
          "728020529": {
            "id": "728020529",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "但你也看到了，这确实是我们的女儿，你带来的那封信…说不定真是这孩子忘记了。",
            "nextDialogs": [
              "728020530"
            ]
          },
          "728020530": {
            "id": "728020530",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "不过无论如何，还是谢谢你帮忙跑这一趟，报酬的话…还请你再稍等一下。"
          },
          "728020521": {
            "id": "728020521",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "豪宅？什么豪宅，我在璃月还有豪宅的吗！"
          }
        }
      }
    },
    {
      "subId": "7280206",
      "subQuestName": "等到第二天",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728020601"
        ],
        "dialogs": {
          "728020601": {
            "id": "728020601",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "女儿又跑哪儿去了…",
            "nextDialogs": [
              "728020604"
            ]
          },
          "728020604": {
            "id": "728020604",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "就算是工作，她走之前也会给我们说一声，但今天这孩子怎么不声不响地就走了。",
            "nextDialogs": [
              "728020605"
            ]
          },
          "728020605": {
            "id": "728020605",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "昨天晚上你离开之后，竺子说觉得很累，直接就回房睡下了。",
            "nextDialogs": [
              "728020606"
            ]
          },
          "728020606": {
            "id": "728020606",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "等到天亮之后，我们夫妻俩起床一看，她就已经不在自己的床上了。",
            "nextDialogs": [
              "728020607"
            ]
          },
          "728020607": {
            "id": "728020607",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "我们到处找也没有找到女儿，我丈夫就直接到更远的地方去找了。",
            "nextDialogs": [
              "728020608"
            ]
          },
          "728020608": {
            "id": "728020608",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "但我在这一带找了半天，完全没找见女儿的踪迹。",
            "nextDialogs": [
              "728020609"
            ]
          },
          "728020609": {
            "id": "728020609",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "啊，这孩子不会又出去旅行了吧？真是叫人怎么办才好…",
            "nextDialogs": [
              "728020610"
            ]
          },
          "728020610": {
            "id": "728020610",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "孩子他妈，别着急，我待会儿再去找找，你先在家把竺子的房间扫一扫吧。",
            "nextDialogs": [
              "728020611"
            ]
          },
          "728020611": {
            "id": "728020611",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "那孩子走的时候也不关好窗户，搞得房间里被吹进了一大堆树叶。",
            "nextDialogs": [
              "728020612"
            ]
          },
          "728020612": {
            "id": "728020612",
            "speakerId": 3050,
            "speakerName": "曜",
            "text": "对了，旅行者，这些是说好的报酬，请你拿好了。",
            "nextDialogs": [
              "728020613"
            ]
          },
          "728020613": {
            "id": "728020613",
            "speakerId": 3049,
            "speakerName": "满",
            "text": "唉，竺子这孩子到底又去做什么了…"
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "7609501",
      "subQuestName": "寻回彩特琳德的失物并解放各区域",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760950101"
        ],
        "dialogs": {
          "760950101": {
            "id": "760950101",
            "speakerId": 22272,
            "speakerName": "彩特琳德",
            "text": "#{NICKNAME}、派蒙谢谢你们。在最后认识你们真幸运。",
            "nextDialogs": [
              "760950102"
            ]
          },
          "760950102": {
            "id": "760950102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，没有啦。感觉你还是因为和我们在一起才卷进这些事情里的。",
            "nextDialogs": [
              "760950103"
            ]
          },
          "760950103": {
            "id": "760950103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，什么叫最后？",
            "nextDialogs": [
              "760950104"
            ]
          },
          "760950104": {
            "id": "760950104",
            "speakerId": 22272,
            "speakerName": "彩特琳德",
            "text": "虽然都是些高危冒险，不过见识到了很多神奇的东西。",
            "nextDialogs": [
              "760950105"
            ]
          },
          "760950105": {
            "id": "760950105",
            "speakerId": 22272,
            "speakerName": "彩特琳德",
            "text": "也不赖。",
            "nextDialogs": [
              "760950106"
            ]
          },
          "760950106": {
            "id": "760950106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "彩特琳德你不要避重就轻啊。",
            "nextDialogs": [
              "760950107"
            ]
          },
          "760950107": {
            "id": "760950107",
            "speakerId": 22272,
            "speakerName": "彩特琳德",
            "text": "有吗？"
          }
        }
      }
    },

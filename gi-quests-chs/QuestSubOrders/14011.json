{
  "lineCounts": {
    "Player": 12,
    "劳维克": 22,
    "埃兰": 1,
    "娜维娅": 12,
    "比罗": 1,
    "波洛": 34,
    "派蒙": 18,
    "芙宁娜": 58,
    "迪尔菲": 25
  },
  "subQuests": [
    {
      "subId": "1401101",
      "subQuestName": "前往白淞镇寻找波洛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140110101"
        ],
        "dialogs": {
          "140110101": {
            "id": "140110101",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "要是没记错的话，他就住在这里。",
            "nextDialogs": [
              "140110102"
            ]
          },
          "140110102": {
            "id": "140110102",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "请问是谁？",
            "nextDialogs": [
              "140110103"
            ]
          },
          "140110103": {
            "id": "140110103",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "是我，你的本子写完了吗？",
            "nextDialogs": [
              "140110104"
            ]
          },
          "140110104": {
            "id": "140110104",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "你怎么都追到这里来了？",
            "nextDialogs": [
              "140110105"
            ]
          },
          "140110105": {
            "id": "140110105",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "哎呀，这个你别管，先出来，有好消息。",
            "nextDialogs": [
              "140110106"
            ]
          },
          "140110106": {
            "id": "140110106",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "啧，谁信你。等我一会儿，已经在收尾了，写完了就出来。",
            "nextDialogs": [
              "140110107"
            ]
          },
          "140110107": {
            "id": "140110107",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "行吧，期待你的大作。",
            "nextDialogs": [
              "140110108"
            ]
          },
          "140110108": {
            "id": "140110108",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "看来不出所料，是拖稿了呢。",
            "nextDialogs": [
              "140110109"
            ]
          },
          "140110109": {
            "id": "140110109",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "毕竟结局是这个剧目里非常重要的一环。",
            "nextDialogs": [
              "140110110"
            ]
          },
          "140110110": {
            "id": "140110110",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "在他写好之后，我们所有演员都要看一遍，只有大家都赞成，它才能成为最后的结局。",
            "nextDialogs": [
              "140110111"
            ]
          },
          "140110111": {
            "id": "140110111",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "刚刚有人告诉我，我还以为他看错了呢。居然是你们，还有芙宁娜。",
            "nextDialogs": [
              "140110112"
            ]
          },
          "140110112": {
            "id": "140110112",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "果然还是会碰到她啊…",
            "nextDialogs": [
              "140110113"
            ]
          },
          "140110113": {
            "id": "140110113",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "看来你们是来找波洛的，如果还需要时间的话，可以在镇上随意逛逛，我都安排好了。",
            "nextDialogs": [
              "140110114"
            ]
          },
          "140110114": {
            "id": "140110114",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "啊，没事，我们等在这里也…",
            "nextDialogs": [
              "140110115"
            ]
          },
          "140110115": {
            "id": "140110115",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "那就恭敬不如从命，我们先去逛逛啦，谢谢你的招待！",
            "nextDialogs": [
              "140110116"
            ]
          },
          "140110116": {
            "id": "140110116",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "给我过来，注意一下气氛行吗！",
            "nextDialogs": [
              "140110117"
            ]
          },
          "140110117": {
            "id": "140110117",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "最近，白淞镇的情况好点了吗？",
            "nextDialogs": [
              "140110118"
            ]
          },
          "140110118": {
            "id": "140110118",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "只能说在慢慢恢复吧，但很多人内心的创伤或许一辈子都无法痊愈。",
            "nextDialogs": [
              "140110119"
            ]
          },
          "140110119": {
            "id": "140110119",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "对不起。我也很想做些什么…",
            "nextDialogs": [
              "140110120"
            ]
          },
          "140110120": {
            "id": "140110120",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "好啦，难道我们每次见面都要聊这些沉重的话题吗？",
            "nextDialogs": [
              "140110121"
            ]
          },
          "140110121": {
            "id": "140110121",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我们都有沉重而痛苦的回忆，但我们不一定要被它们压得喘不过气。",
            "nextDialogs": [
              "140110122"
            ]
          },
          "140110122": {
            "id": "140110122",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "既然你也有打算重新开始，就不要总把过去的事挂在嘴边啊。",
            "nextDialogs": [
              "140110123"
            ]
          },
          "140110123": {
            "id": "140110123",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "谢谢你的安慰，说的很有道理。",
            "nextDialogs": [
              "140110124"
            ]
          },
          "140110124": {
            "id": "140110124",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "不过至少现在，还是让我保持郑重的心情吧…",
            "nextDialogs": [
              "140110125"
            ]
          },
          "140110125": {
            "id": "140110125",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "没关系，我知道真正要实践起来，也没有像我说的那么轻松。",
            "nextDialogs": [
              "140110126"
            ]
          },
          "140110126": {
            "id": "140110126",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "我来也是为了告诉你们一声，至今为止，也不是所有人都原谅了水神在灾难中的毫无作为。",
            "nextDialogs": [
              "140110127"
            ]
          },
          "140110127": {
            "id": "140110127",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "为了避免不必要的麻烦，我和镇上的人说你们都是剧团成员，而你是扮演芙宁娜的演员。",
            "nextDialogs": [
              "140110128"
            ]
          },
          "140110128": {
            "id": "140110128",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "虽然不能说这样就万无一失，但应该就可以自由活动啦。",
            "nextDialogs": [
              "140110129"
            ]
          },
          "140110129": {
            "id": "140110129",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来你还有这么细心的一面。",
            "nextDialogs": [
              "140110130"
            ]
          },
          "140110130": {
            "id": "140110130",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "你这话说的，刺玫会的会长从来都是胆大又心细。",
            "nextDialogs": [
              "140110131"
            ]
          },
          "140110131": {
            "id": "140110131",
            "speakerId": 1075,
            "speakerName": "娜维娅",
            "text": "好啦，那我先走了。你们好好陪陪她哦。",
            "nextDialogs": [
              "140110134"
            ]
          },
          "140110134": {
            "id": "140110134",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "那我们走吧，去上面看看。",
            "nextDialogs": [
              "140110135"
            ]
          },
          "140110135": {
            "id": "140110135",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "我也没有能说心里话的朋友，可能就像她说的，你们就是最适合的对象。"
          }
        }
      }
    },
    {
      "subId": "1401102",
      "subQuestName": "陪芙宁娜散心",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140110201"
        ],
        "dialogs": {
          "140110201": {
            "id": "140110201",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "很感谢娜维娅女士的体谅，说实话我也不知道自己是否做好了准备。",
            "nextDialogs": [
              "140110202"
            ]
          },
          "140110202": {
            "id": "140110202",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "逃避往往是最方便的选择，但它没法解决任何问题，也不能帮助你跨越任何障碍。",
            "nextDialogs": [
              "140110203"
            ]
          },
          "140110203": {
            "id": "140110203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怪不得说到白淞镇的时候，你有点犹豫。",
            "nextDialogs": [
              "140110204"
            ]
          },
          "140110204": {
            "id": "140110204",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "是啊，要说不害怕是不可能的。",
            "nextDialogs": [
              "140110205"
            ]
          },
          "140110205": {
            "id": "140110205",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "但我还是觉得，我应该再来这里一趟。就像之前我说的那样，我想看看那些不曾亲眼所见的东西。",
            "nextDialogs": [
              "140110206"
            ]
          },
          "140110206": {
            "id": "140110206",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "如果这里的人愿意原谅我，那我会很开心，但他们如果暴言相向，我也会全盘接受。",
            "nextDialogs": [
              "140110207"
            ]
          },
          "140110207": {
            "id": "140110207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "估计也有人不相信娜维娅的说辞。",
            "nextDialogs": [
              "140110208"
            ]
          },
          "140110208": {
            "id": "140110208",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "是啊，我能感觉到那些视线。",
            "nextDialogs": [
              "140110209"
            ]
          },
          "140110209": {
            "id": "140110209",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "可能他们觉得，穿着水神戏服到白淞镇来，本就是对这里居民的一种不尊重的行为。",
            "nextDialogs": [
              "140110210"
            ]
          },
          "140110210": {
            "id": "140110210",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "我曾经很害怕被人注视，尤其是被质疑被怨恨的时候。",
            "nextDialogs": [
              "140110211"
            ]
          },
          "140110211": {
            "id": "140110211",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "…哎，看来我还是没有做好准备啊。",
            "nextDialogs": [
              "140110212"
            ]
          },
          "140110212": {
            "id": "140110212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没想到你对自己还挺严格呢。",
            "nextDialogs": [
              "140110214",
              "140110216"
            ]
          },
          "140110214": {
            "id": "140110214",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "我不能只看我想看到的东西啊，那不就和以前一样了吗？",
            "nextDialogs": [
              "140110217"
            ]
          },
          "140110217": {
            "id": "140110217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们看，是不是人逐渐变多了？",
            "nextDialogs": [
              "140110218"
            ]
          },
          "140110218": {
            "id": "140110218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "议论的声音越来越明显了。",
            "nextDialogs": [
              "140110219"
            ]
          },
          "140110219": {
            "id": "140110219",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "我们还是别在这里久留吧。",
            "nextDialogs": [
              "140110220"
            ]
          },
          "140110220": {
            "id": "140110220",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "刺玫会的大船，从那里能看到整个白淞镇吧，我们到那里去看看。"
          },
          "140110216": {
            "id": "140110216",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "什么意思，难道在你眼里我只会东躲西藏，逃避责任吗？"
          }
        }
      }
    },
    {
      "subId": "1401103",
      "subQuestName": "继续陪芙宁娜散心",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140110301"
        ],
        "dialogs": {
          "140110301": {
            "id": "140110301",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "抱歉，或许你们是散步的心情，但我尽是在说一些沉重的话题。",
            "nextDialogs": [
              "140110302"
            ]
          },
          "140110302": {
            "id": "140110302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没关系，这样的你也挺新鲜的。",
            "nextDialogs": [
              "140110303"
            ]
          },
          "140110303": {
            "id": "140110303",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "嗯，再多陪我一会儿吧，谢谢你们了。",
            "nextDialogs": [
              "140110304"
            ]
          },
          "140110304": {
            "id": "140110304",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "或许你们也能感受到，我排斥接纳过去的自己，其实不单单是因为忍受了太久的痛苦与孤独。",
            "nextDialogs": [
              "140110305"
            ]
          },
          "140110305": {
            "id": "140110305",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "站在船边，我的脑中都有当时水逐渐上涨的画面。",
            "nextDialogs": [
              "140110306"
            ]
          },
          "140110306": {
            "id": "140110306",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "一个又一个的生命融化成水，白淞镇镇民无比珍惜的生活与回忆化为泡影。",
            "nextDialogs": [
              "140110307"
            ]
          },
          "140110307": {
            "id": "140110307",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "在神明的庇护之下，人们笃信在灾难降临之前，会有强大的存在挺身而出。",
            "nextDialogs": [
              "140110308"
            ]
          },
          "140110308": {
            "id": "140110308",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "我也曾经为了让他们相信确有其事，而不断地表演…",
            "nextDialogs": [
              "140110309"
            ]
          },
          "140110309": {
            "id": "140110309",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "可是当水真的涨上来的时候，「水神」无动于衷。",
            "nextDialogs": [
              "140110310"
            ]
          },
          "140110310": {
            "id": "140110310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也不能这么说啊，那时的你有你的职责。",
            "nextDialogs": [
              "140110311"
            ]
          },
          "140110311": {
            "id": "140110311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不用这么苛责自己。",
            "nextDialogs": [
              "140110312"
            ]
          },
          "140110312": {
            "id": "140110312",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "为了守护真相，我一直在经历相似的事，越是这样我就越痛苦，越孤独。",
            "nextDialogs": [
              "140110313"
            ]
          },
          "140110313": {
            "id": "140110313",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "逐渐地，我除了真相一无所有，我也害怕我会彻底失败，坐在我的位置上痛哭流涕。",
            "nextDialogs": [
              "140110314"
            ]
          },
          "140110314": {
            "id": "140110314",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "好在有你们，还有诸多英雄的帮助，我们回避了最坏的结局。",
            "nextDialogs": [
              "140110315"
            ]
          },
          "140110315": {
            "id": "140110315",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "所有人都担负起了身上的责任，而我，重归自由…",
            "nextDialogs": [
              "140110316"
            ]
          },
          "140110316": {
            "id": "140110316",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "仔细想想的话，自由不就是不被需要的意思嘛，因为我也没什么用处了。",
            "nextDialogs": [
              "140110317"
            ]
          },
          "140110317": {
            "id": "140110317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没想到你会这么想。",
            "nextDialogs": [
              "140110318"
            ]
          },
          "140110318": {
            "id": "140110318",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "自由是对你的嘉奖。",
            "nextDialogs": [
              "140110319"
            ]
          },
          "140110319": {
            "id": "140110319",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "嘉奖？",
            "nextDialogs": [
              "140110322"
            ]
          },
          "140110322": {
            "id": "140110322",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "…是啊。",
            "nextDialogs": [
              "140110323"
            ]
          },
          "140110323": {
            "id": "140110323",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "有能够倾诉的人，在过去简直是想都不敢想的事。",
            "nextDialogs": [
              "140110324"
            ]
          },
          "140110324": {
            "id": "140110324",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "因为必须坚守重要的秘密，我非常害怕他人注意到真实的我。",
            "nextDialogs": [
              "140110325"
            ]
          },
          "140110325": {
            "id": "140110325",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "「相信舞台上的芙宁娜便好，那就是你们应该信任的形象。」",
            "nextDialogs": [
              "140110326"
            ]
          },
          "140110326": {
            "id": "140110326",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "而在生活中，无论是好奇心，还是源自内心的情绪，都不能让人注意到。",
            "nextDialogs": [
              "140110327"
            ]
          },
          "140110327": {
            "id": "140110327",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "这也是为什么之前我会说，我不是个会好好维持友善关系的人。",
            "nextDialogs": [
              "140110328"
            ]
          },
          "140110328": {
            "id": "140110328",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是这样，我以为只是你私下的性格容易被人讨厌呢。",
            "nextDialogs": [
              "140110329"
            ]
          },
          "140110329": {
            "id": "140110329",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "你今天总是和我唱反调！像你这样说话才会让人讨厌吧！"
          }
        }
      }
    },
    {
      "subId": "1401104",
      "subQuestName": "与芙宁娜交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1401105",
      "subQuestName": "回去找波洛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140110401"
        ],
        "dialogs": {
          "140110401": {
            "id": "140110401",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "都说了，你现在这个样子，就要少吃一些油炸食物，刚刚又吃了那么多薯条和鱼饼！",
            "nextDialogs": [
              "140110402"
            ]
          },
          "140110402": {
            "id": "140110402",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "那位刺玫会的老板如此慷慨，吃什么都可以免费，这么好的机会绝不能浪费啊。",
            "nextDialogs": [
              "140110403"
            ]
          },
          "140110403": {
            "id": "140110403",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "而且我又不像你，我的角色也不用考虑身材好不好。",
            "nextDialogs": [
              "140110404"
            ]
          },
          "140110404": {
            "id": "140110404",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "现在谁跟你讨论角色了，你就不能在乎一下健康问题吗？",
            "nextDialogs": [
              "140110405"
            ]
          },
          "140110405": {
            "id": "140110405",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "我天天被身上的病折磨得要死要活，看你这么不珍惜身体，我就气不打一处来。",
            "nextDialogs": [
              "140110406"
            ]
          },
          "140110406": {
            "id": "140110406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎，这两位又在吵架了。",
            "nextDialogs": [
              "140110407"
            ]
          },
          "140110407": {
            "id": "140110407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们回来啦，你们能不能暂时休战啊。",
            "nextDialogs": [
              "140110408"
            ]
          },
          "140110408": {
            "id": "140110408",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "哦，你们回来了，能受到这么好的招待，还是沾了你们的光。",
            "nextDialogs": [
              "140110409"
            ]
          },
          "140110409": {
            "id": "140110409",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "他还差最后一点点，我们再等等就好了。",
            "nextDialogs": [
              "140110410"
            ]
          },
          "140110410": {
            "id": "140110410",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那随便聊聊吧，对了，刚刚说到角色，我知道她是演纯水精灵变成的人类，那你呢？",
            "nextDialogs": [
              "140110411"
            ]
          },
          "140110411": {
            "id": "140110411",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "我吗？也是纯水精灵。",
            "nextDialogs": [
              "140110412"
            ]
          },
          "140110412": {
            "id": "140110412",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "本来是鹤的模样，后来戏服穿不进去，只能改成猪了。",
            "nextDialogs": [
              "140110413"
            ]
          },
          "140110413": {
            "id": "140110413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噗…对不起，对不起。",
            "nextDialogs": [
              "140110414"
            ]
          },
          "140110414": {
            "id": "140110414",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "猪也挺有意思的，我记得，是抚养小纯水精灵长大的角色吧。",
            "nextDialogs": [
              "140110415"
            ]
          },
          "140110415": {
            "id": "140110415",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "对，它语重心长地对幼小的纯水精灵说——",
            "nextDialogs": [
              "140110416"
            ]
          },
          "140110416": {
            "id": "140110416",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "「成为人类，就意味着隐藏秘密，经历痛苦，与孤独相伴，即便如此你也愿意吗？」",
            "nextDialogs": [
              "140110417"
            ]
          },
          "140110417": {
            "id": "140110417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，听起来怎么有点…",
            "nextDialogs": [
              "140110418"
            ]
          },
          "140110418": {
            "id": "140110418",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "这是剧本里的核心台词，我觉得这就是团长一生的写照。",
            "nextDialogs": [
              "140110419"
            ]
          },
          "140110419": {
            "id": "140110419",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "她从来不把剧团令人烦恼的一面给我们看，只是让我们享受纯粹的表演。",
            "nextDialogs": [
              "140110420"
            ]
          },
          "140110420": {
            "id": "140110420",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "以至于在她离开之后，我们才发现经营剧团究竟有多么不容易。",
            "nextDialogs": [
              "140110421"
            ]
          },
          "140110421": {
            "id": "140110421",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "之前你有说过，「家」…",
            "nextDialogs": [
              "140110422"
            ]
          },
          "140110422": {
            "id": "140110422",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "嗯，因为我生下来就得了那种怪病，家里人发现治不好，就不要我了。",
            "nextDialogs": [
              "140110423"
            ]
          },
          "140110423": {
            "id": "140110423",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "我一个人在外面打工买药，病发了就在巷子里躺几天，像乞丐一样。",
            "nextDialogs": [
              "140110424"
            ]
          },
          "140110424": {
            "id": "140110424",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "后来团长说我的声音很好听，要不要和她学唱歌，我就答应了。",
            "nextDialogs": [
              "140110425"
            ]
          },
          "140110425": {
            "id": "140110425",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "她不仅教我唱歌演戏，还帮我买药，在我病发的时候照顾我…这些对她来说都是沉重的负担。",
            "nextDialogs": [
              "140110426"
            ]
          },
          "140110426": {
            "id": "140110426",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那她真的好厉害。",
            "nextDialogs": [
              "140110427"
            ]
          },
          "140110427": {
            "id": "140110427",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "那是当然，团长把所有的心思都放在剧团和团员身上了，我们所有人都以她为骄傲。",
            "nextDialogs": [
              "140110428"
            ]
          },
          "140110428": {
            "id": "140110428",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "我那时候也是，因为我是杀人犯的孩子，从小就没有父母照顾，被送去了孤儿院。",
            "nextDialogs": [
              "140110429"
            ]
          },
          "140110429": {
            "id": "140110429",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "结果身边的人天天找我打架，说我是杀人犯的孩子所以很能打吧…其实只是看我好欺负而已。",
            "nextDialogs": [
              "140110430"
            ]
          },
          "140110430": {
            "id": "140110430",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "后来被打得实在受不了，就跑了出来，那时候我以为这个世界上都是烂人呢。",
            "nextDialogs": [
              "140110431"
            ]
          },
          "140110431": {
            "id": "140110431",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "呵呵，还好遇到了那位团长。",
            "nextDialogs": [
              "140110432"
            ]
          },
          "140110432": {
            "id": "140110432",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "嗯，那时候我就想，我要一直在这里，直到它解散。",
            "nextDialogs": [
              "140110433"
            ]
          },
          "140110433": {
            "id": "140110433",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "结果这一天还真被你等到了。",
            "nextDialogs": [
              "140110434"
            ]
          },
          "140110434": {
            "id": "140110434",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "欸，你终于搞定了啊。来来来，介绍一下，这位是我们的演出顾问，芙宁娜女士。",
            "nextDialogs": [
              "140110435"
            ]
          },
          "140110435": {
            "id": "140110435",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "我、我没看错吧！我的天，你们什么时候这么厉害了？！",
            "nextDialogs": [
              "140110436"
            ]
          },
          "140110436": {
            "id": "140110436",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "不用这么惊讶，我只是听了剧团和团长的故事之后深受感动，想要帮忙而已。",
            "nextDialogs": [
              "140110437"
            ]
          },
          "140110437": {
            "id": "140110437",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们也是一样！",
            "nextDialogs": [
              "140110438"
            ]
          },
          "140110438": {
            "id": "140110438",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "就算是这样也…抱歉，先让我冷静一下，刚刚我想说什么来着。",
            "nextDialogs": [
              "140110439"
            ]
          },
          "140110439": {
            "id": "140110439",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "哦对，剧本，剧本！我先讲述一下在我的版本里，剧情是如何发展的吧。",
            "nextDialogs": [
              "140110440"
            ]
          },
          "140110440": {
            "id": "140110440",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "前面的剧情各位应该很熟悉了，一个幼小的纯水精灵不顾亲人的劝告，成为了人类。",
            "nextDialogs": [
              "140110441"
            ]
          },
          "140110441": {
            "id": "140110441",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "她在繁荣又热闹的城市中收获了友谊与爱情，但意外也随之到来…",
            "nextDialogs": [
              "140110442"
            ]
          },
          "140110442": {
            "id": "140110442",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "居民们突然发现周围的淡水在逐渐消失，土地干涸，植物枯萎，察觉异状的众人陷入恐慌。",
            "nextDialogs": [
              "140110443"
            ]
          },
          "140110443": {
            "id": "140110443",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "水的女儿「柯莉欧」与她的恋人肩负起责任，携手去调查事件真相。",
            "nextDialogs": [
              "140110444"
            ]
          },
          "140110444": {
            "id": "140110444",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "最后发现，是由于人类长期的浪费与污染，淡水竟然像是有了意识一般，正在逃离此地。",
            "nextDialogs": [
              "140110445"
            ]
          },
          "140110445": {
            "id": "140110445",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "你是说，水拥有意识吗？",
            "nextDialogs": [
              "140110446"
            ]
          },
          "140110446": {
            "id": "140110446",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "水拥有意识…倒是有很多故事都这么写。",
            "nextDialogs": [
              "140110447"
            ]
          },
          "140110447": {
            "id": "140110447",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "因为主角是纯水精灵，所以一下子就读出了水的想法，她也把真实身份与事件真相告诉了恋人。",
            "nextDialogs": [
              "140110448"
            ]
          },
          "140110448": {
            "id": "140110448",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "恋人接纳了她，与她共同寻找让淡水回归的办法，但与此同时，有人也偷听到了这件事。",
            "nextDialogs": [
              "140110449"
            ]
          },
          "140110449": {
            "id": "140110449",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "水的女儿被视为夺走淡水的罪魁祸首，陷入两难境地…",
            "nextDialogs": [
              "140110450"
            ]
          },
          "140110450": {
            "id": "140110450",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "然后呢？",
            "nextDialogs": [
              "140110451"
            ]
          },
          "140110451": {
            "id": "140110451",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "然后就是水的女儿挺身而出，牺牲自己拯救她的恋人与全体人类…",
            "nextDialogs": [
              "140110452"
            ]
          },
          "140110452": {
            "id": "140110452",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？可是这些人不都把柯莉欧当成坏人吗？为什么她还想救他们？",
            "nextDialogs": [
              "140110453"
            ]
          },
          "140110453": {
            "id": "140110453",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "因为她想救的主要是她的恋人，以及帮她说话的人吧。",
            "nextDialogs": [
              "140110454"
            ]
          },
          "140110454": {
            "id": "140110454",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "从对恋人的爱慕，上升到对人类的博爱，这应该也是柯莉欧这位主角的伟大之处。",
            "nextDialogs": [
              "140110455"
            ]
          },
          "140110455": {
            "id": "140110455",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "我在意的是另一个问题…",
            "nextDialogs": [
              "140110456"
            ]
          },
          "140110456": {
            "id": "140110456",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "你知道「水的女儿」的主角就象征团长对吧？她最后没有机会成为英雄。",
            "nextDialogs": [
              "140110457"
            ]
          },
          "140110457": {
            "id": "140110457",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "既然是为了纪念团长，当然要记录真正的结局啊。",
            "nextDialogs": [
              "140110458"
            ]
          },
          "140110458": {
            "id": "140110458",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "——水的女儿因仇恨而死，深爱她的人不再揭晓真相，人类走向灭亡。",
            "nextDialogs": [
              "140110459"
            ]
          },
          "140110459": {
            "id": "140110459",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "…但这种结局还是太残酷，并且对观众也有点不负责任。",
            "nextDialogs": [
              "140110460"
            ]
          },
          "140110460": {
            "id": "140110460",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "和奥蕾丽团长的遇害无比相似，都是毫无价值，莫名其妙的。",
            "nextDialogs": [
              "140110461"
            ]
          },
          "140110461": {
            "id": "140110461",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "出事的那天，团长突然告诉我们，让所有人先离开枫丹廷，去城外等她。",
            "nextDialogs": [
              "140110462"
            ]
          },
          "140110462": {
            "id": "140110462",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "我们在说好的地方等了好久好久，团长都没有来，我们回去的时候，她已经失踪了。",
            "nextDialogs": [
              "140110463"
            ]
          },
          "140110463": {
            "id": "140110463",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "我们找不到她，警卫也找不到，最后种种迹象表明，她应该是被卷入了「少女连环失踪案」。",
            "nextDialogs": [
              "140110464"
            ]
          },
          "140110464": {
            "id": "140110464",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "团长是世界上最好的人，却成为了莫名其妙的实验的牺牲品，跟她压根没有什么关系。",
            "nextDialogs": [
              "140110465"
            ]
          },
          "140110465": {
            "id": "140110465",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "唔，不过既然会提前通知你们去城外躲起来，说明她已经察觉到了什么？",
            "nextDialogs": [
              "140110466"
            ]
          },
          "140110466": {
            "id": "140110466",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "事后我一直在追查，但是几乎没有线索…维尔芒可能知道什么，但他怎么都不愿意跟我说。",
            "nextDialogs": [
              "140110467"
            ]
          },
          "140110467": {
            "id": "140110467",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "维尔芒，就是最后那一位饰演反派的演员吧。",
            "nextDialogs": [
              "140110468"
            ]
          },
          "140110468": {
            "id": "140110468",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "他应该是最难以从悲伤中走出来的那一个。",
            "nextDialogs": [
              "140110469"
            ]
          },
          "140110469": {
            "id": "140110469",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "悲伤？哼，他那是内疚。论悲伤，谁都不可能比我更悲伤。",
            "nextDialogs": [
              "140110470"
            ]
          },
          "140110470": {
            "id": "140110470",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "因为…无论是在戏里，还是戏外，我都深深爱着奥蕾丽。",
            "nextDialogs": [
              "140110471"
            ]
          },
          "140110471": {
            "id": "140110471",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "这…这我还是第一次知道。",
            "nextDialogs": [
              "140110472"
            ]
          },
          "140110472": {
            "id": "140110472",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "也到了该坦白的时候了，如果我们互相之间都还有秘密，那结局就永远不可能达成共识。",
            "nextDialogs": [
              "140110473"
            ]
          },
          "140110473": {
            "id": "140110473",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "我曾经向奥蕾丽表白，但她几乎是立刻就拒绝了我的爱意。",
            "nextDialogs": [
              "140110474"
            ]
          },
          "140110474": {
            "id": "140110474",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "她说，她把剧团里的所有人都当弟弟妹妹看待，从来没有考虑过男女之间的感情。",
            "nextDialogs": [
              "140110475"
            ]
          },
          "140110475": {
            "id": "140110475",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "我知道奥蕾丽一定会这样说，所以我告诉她没关系，我会一直在剧团里等她。",
            "nextDialogs": [
              "140110476"
            ]
          },
          "140110476": {
            "id": "140110476",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "直到有一天，剧团已经不需要奥蕾丽再操心，这里的所有人都找到了属于自己的容身之所…",
            "nextDialogs": [
              "140110477"
            ]
          },
          "140110477": {
            "id": "140110477",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "那时候奥蕾丽，就可以重新考虑关于她自己的事了吧。",
            "nextDialogs": [
              "140110478"
            ]
          },
          "140110478": {
            "id": "140110478",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "我终究是没能等到那一天啊…",
            "nextDialogs": [
              "140110479"
            ]
          },
          "140110479": {
            "id": "140110479",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "波洛…",
            "nextDialogs": [
              "140110480"
            ]
          },
          "140110480": {
            "id": "140110480",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "所以在我的笔下，我要给奥蕾丽最好的结局，谁来反对也没用。",
            "nextDialogs": [
              "140110481"
            ]
          },
          "140110481": {
            "id": "140110481",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "唉，看来你和维尔芒之间的事，必须当面才能解决啊。",
            "nextDialogs": [
              "140110482"
            ]
          },
          "140110482": {
            "id": "140110482",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "其实一直以来，就是他们两个对结局的分歧最大，总要有一个人能说服对方。",
            "nextDialogs": [
              "140110483"
            ]
          },
          "140110483": {
            "id": "140110483",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然都聊到这里了，只能去找他了吧。",
            "nextDialogs": [
              "140110484"
            ]
          },
          "140110484": {
            "id": "140110484",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "你做好面对真相的准备了吗？",
            "nextDialogs": [
              "140110485"
            ]
          },
          "140110485": {
            "id": "140110485",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "老实说，有点害怕，但为了最后的演出，我什么都愿意去做…",
            "nextDialogs": [
              "140110486"
            ]
          },
          "140110486": {
            "id": "140110486",
            "speakerId": 13580,
            "speakerName": "波洛",
            "text": "芙宁娜女士，难道你能理解我的感受吗？",
            "nextDialogs": [
              "140110487"
            ]
          },
          "140110487": {
            "id": "140110487",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "嗯，当然。",
            "nextDialogs": [
              "140110488"
            ]
          },
          "140110488": {
            "id": "140110488",
            "speakerId": 1073,
            "speakerName": "芙宁娜",
            "text": "我们走吧。"
          }
        }
      }
    },
    {
      "subId": "1401151",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140115101"
        ],
        "dialogs": {
          "140115101": {
            "id": "140115101",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "是你们啊，我们正在买鱼。因为需要清仓，这里正在搞特价，比城里划算很多。",
            "nextDialogs": [
              "140115102"
            ]
          },
          "140115102": {
            "id": "140115102",
            "speakerId": 13579,
            "speakerName": "迪尔菲",
            "text": "谁说要买了，难道你打算拎这么大一条鱼去见波洛和维尔芒，再回去吗？",
            "nextDialogs": [
              "140115103"
            ]
          },
          "140115103": {
            "id": "140115103",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "对、对哦，确实有点不方便…"
          }
        }
      }
    },
    {
      "subId": "1401152",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140115201"
        ],
        "dialogs": {
          "140115201": {
            "id": "140115201",
            "speakerId": 13697,
            "speakerName": "比罗",
            "text": "压力一下子就上来了，要好好做准备才行。"
          }
        }
      }
    },
    {
      "subId": "1401153",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "140115301"
        ],
        "dialogs": {
          "140115301": {
            "id": "140115301",
            "speakerId": 13698,
            "speakerName": "埃兰",
            "text": "你们要去白淞镇见波洛吧？一路顺风，剧团这里交给我们吧。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7328201",
      "subQuestName": "(test)隐藏：与马塞拉对话领取任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732820101"
        ],
        "dialogs": {
          "732820101": {
            "id": "732820101",
            "speakerId": 4292,
            "speakerName": "马塞拉",
            "text": "啊，您来了！请您留步，这恐怕是我最后一次拜托您了。",
            "nextDialogs": [
              "732820103",
              "732820105"
            ]
          },
          "732820103": {
            "id": "732820103",
            "speakerId": 4292,
            "speakerName": "马塞拉",
            "text": "是塔德菈，她想要找您谈谈。",
            "nextDialogs": [
              "732820106"
            ]
          },
          "732820106": {
            "id": "732820106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…什么事呀，这么正式的。",
            "nextDialogs": [
              "732820107"
            ]
          },
          "732820107": {
            "id": "732820107",
            "speakerId": 4292,
            "speakerName": "马塞拉",
            "text": "北方的遗迹，你们最初遇见的地方附近…"
          },
          "732820105": {
            "id": "732820105",
            "speakerId": 4292,
            "speakerName": "马塞拉",
            "text": "请您务必听我说…塔德菈想要找您谈谈。"
          }
        }
      }
    },
    {
      "subId": "7328202",
      "subQuestName": "前往塔德菈等候的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732820201"
        ],
        "dialogs": {
          "732820201": {
            "id": "732820201",
            "speakerId": 4292,
            "speakerName": "马塞拉",
            "text": "北方的遗迹，你们最初遇见的地方附近…",
            "nextDialogs": [
              "732820202"
            ]
          },
          "732820202": {
            "id": "732820202",
            "speakerId": 4292,
            "speakerName": "马塞拉",
            "text": "这是她的选择…希望您能够加以尊重。"
          }
        }
      }
    },
    {
      "subId": "7328204",
      "subQuestName": "与塔德菈对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732820401"
        ],
        "dialogs": {
          "732820401": {
            "id": "732820401",
            "speakerId": 20842,
            "speakerName": "塔德菈",
            "text": "你果然会来，我很开心。",
            "nextDialogs": [
              "732820404"
            ]
          },
          "732820404": {
            "id": "732820404",
            "speakerId": 20842,
            "speakerName": "塔德菈",
            "text": "我一直觉得这个时刻的沙漠，很好看。我很喜欢。",
            "nextDialogs": [
              "732820405"
            ]
          },
          "732820405": {
            "id": "732820405",
            "speakerId": 20842,
            "speakerName": "塔德菈",
            "text": "但是可惜…一直没有机会和朋友一起，在这里，就这样看太阳慢慢落下。",
            "nextDialogs": [
              "732820406"
            ]
          },
          "732820406": {
            "id": "732820406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是啊，整个沙漠都被染成红色了…很漂亮，好安静…",
            "nextDialogs": [
              "732820407"
            ]
          },
          "732820407": {
            "id": "732820407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，塔德菈，你专门叫我们来就是为了这个吗？",
            "nextDialogs": [
              "732820408"
            ]
          },
          "732820408": {
            "id": "732820408",
            "speakerId": 20842,
            "speakerName": "塔德菈",
            "text": "……",
            "nextDialogs": [
              "732820409"
            ]
          },
          "732820409": {
            "id": "732820409",
            "speakerId": 20842,
            "speakerName": "塔德菈",
            "text": "对于塔尼特，你是客人，对「猎鹰」来说，也是潜在的「猎物」…但我希望，活下来的是你。",
            "nextDialogs": [
              "732820410"
            ]
          },
          "732820410": {
            "id": "732820410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "732820411"
            ]
          },
          "732820411": {
            "id": "732820411",
            "speakerId": 20842,
            "speakerName": "塔德菈",
            "text": "所以，对不起…"
          }
        }
      }
    },
    {
      "subId": "7328205",
      "subQuestName": "击败塔德菈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7328206",
      "subQuestName": "与马塞拉对质",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732820601"
        ],
        "dialogs": {
          "732820601": {
            "id": "732820601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可恶…马塞拉那家伙不见了！",
            "nextDialogs": [
              "732820602"
            ]
          },
          "732820602": {
            "id": "732820602",
            "speakerId": 17013,
            "speakerName": "利露帕尔",
            "text": "他留下了这张字条…哼，老狐狸。",
            "nextDialogs": [
              "732820603"
            ]
          },
          "732820603": {
            "id": "732820603",
            "speakerId": 1004,
            "speakerName": "整洁的字条",
            "text": "若您看到这张字条，那么我已经深入峡谷之中的避难所了。\\n若您的首级还在两肩中间，请不要为塔德菈的选择悲伤。\\n\\n这场狩猎并非结束，而是风暴的开始。\\n塔尼特长老，猎人马塞拉，特为您发出警告。",
            "nextDialogs": [
              "732820604"
            ]
          },
          "732820604": {
            "id": "732820604",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他说的这些…看不明白是什么意思呢…",
            "nextDialogs": [
              "732820605"
            ]
          },
          "732820605": {
            "id": "732820605",
            "speakerId": 17013,
            "speakerName": "利露帕尔",
            "text": "看来出于某种压力，这家伙离开了部落…并且给您留下了警告。哼，塔尼特…暗潮汹涌呢。"
          }
        }
      }
    },
    {
      "subId": "7328228",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732822801"
        ],
        "dialogs": {
          "732822801": {
            "id": "732822801",
            "speakerId": 20842,
            "speakerName": "塔德菈",
            "text": "（她局促地别开目光。然后紧张地低下了头。）",
            "nextDialogs": [
              "732822803",
              "732822806"
            ]
          },
          "732822803": {
            "id": "732822803",
            "speakerId": 20842,
            "speakerName": "塔德菈",
            "text": "抱歉，狩猎已经结束了。我是父亲的「猎鹰」。",
            "nextDialogs": [
              "732822804"
            ]
          },
          "732822804": {
            "id": "732822804",
            "speakerId": 20842,
            "speakerName": "塔德菈",
            "text": "不过…我很好，请您不要担心。"
          },
          "732822806": {
            "id": "732822806",
            "speakerId": 20842,
            "speakerName": "塔德菈",
            "text": "我说过，他是我的父亲，我是他的「猎鹰」。我跟随他的指令，为他而猎，为他而死…因为他代表了塔尼特的意志。",
            "nextDialogs": [
              "732822807"
            ]
          },
          "732822807": {
            "id": "732822807",
            "speakerId": 20842,
            "speakerName": "塔德菈",
            "text": "假如我什么时候无法贯彻父亲的指令了，那么作为「猎鹰」的生命就这样结束了。"
          }
        }
      }
    },
    {
      "subId": "7328229",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732822901"
        ],
        "dialogs": {
          "732822901": {
            "id": "732822901",
            "speakerId": 4292,
            "speakerName": "马塞拉",
            "text": "啊，您来了，尊贵的「镇灵主人」。请问您有何要事？",
            "nextDialogs": [
              "732822903",
              "732822907"
            ]
          },
          "732822903": {
            "id": "732822903",
            "speakerId": 4292,
            "speakerName": "马塞拉",
            "text": "她很中意你，我看得出来。",
            "nextDialogs": [
              "732822904"
            ]
          },
          "732822904": {
            "id": "732822904",
            "speakerId": 4292,
            "speakerName": "马塞拉",
            "text": "放心，我不会在意的，年轻人嘛…",
            "nextDialogs": [
              "732822905"
            ]
          },
          "732822905": {
            "id": "732822905",
            "speakerId": 4292,
            "speakerName": "马塞拉",
            "text": "我会鼓励她表达心意的，作为长辈，作为父亲，我会的…所以，请您不要太为她担心。"
          },
          "732822907": {
            "id": "732822907",
            "speakerId": 4292,
            "speakerName": "马塞拉",
            "text": "感谢您帮助她完成了成年礼，信任您果然是正确的。",
            "nextDialogs": [
              "732822908"
            ]
          },
          "732822908": {
            "id": "732822908",
            "speakerId": 4292,
            "speakerName": "马塞拉",
            "text": "接下来，她就要作为成熟的「猎鹰」，领取第一个狩猎任务了。",
            "nextDialogs": [
              "732822909"
            ]
          },
          "732822909": {
            "id": "732822909",
            "speakerId": 4292,
            "speakerName": "马塞拉",
            "text": "到时候…呵呵，还要请您亲自见证她的成长呀。"
          }
        }
      }
    },
    {
      "subId": "7328299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732829901"
        ],
        "dialogs": {
          "732829901": {
            "id": "732829901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "塔德菈？塔德菈！欸…她…",
            "nextDialogs": [
              "732829902"
            ]
          },
          "732829902": {
            "id": "732829902",
            "speakerId": 17013,
            "speakerName": "利露帕尔",
            "text": "这是她出于自己的意志所做的选择…不再作为「猎鹰」，而是作为「朋友」而活。"
          }
        }
      }
    }
  ]
}
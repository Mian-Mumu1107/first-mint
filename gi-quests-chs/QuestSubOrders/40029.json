    {
      "subId": "4002903",
      "subQuestName": "返回冒险家营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400290301"
        ],
        "dialogs": {
          "400290301": {
            "id": "400290301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "蒂玛乌斯！",
            "nextDialogs": [
              "400290302"
            ]
          },
          "400290302": {
            "id": "400290302",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "是旅行者和派蒙啊。有什么事吗？",
            "nextDialogs": [
              "400290303"
            ]
          },
          "400290303": {
            "id": "400290303",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "等等…看你这有所图谋的表情，该不会还在想那个奇怪的要求吧！",
            "nextDialogs": [
              "400290304"
            ]
          },
          "400290304": {
            "id": "400290304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "蒂玛乌斯，你会帮我们吗？",
            "nextDialogs": [
              "400290307"
            ]
          },
          "400290307": {
            "id": "400290307",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "旅行者说不用，那就不用了吧…毕竟，这个要求怎么听都很奇怪啊。",
            "nextDialogs": [
              "400290308"
            ]
          },
          "400290308": {
            "id": "400290308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不行不行，没有这个我的日落果就浪费了！",
            "nextDialogs": [
              "400290309"
            ]
          },
          "400290309": {
            "id": "400290309",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "可我研究这种东西的时间都够帮你采十次果子了。",
            "nextDialogs": [
              "400290310"
            ]
          },
          "400290310": {
            "id": "400290310",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "研究哪种东西？",
            "nextDialogs": [
              "400290311"
            ]
          },
          "400290311": {
            "id": "400290311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯？",
            "nextDialogs": [
              "400290312"
            ]
          },
          "400290312": {
            "id": "400290312",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "又见面了。",
            "nextDialogs": [
              "400290313"
            ]
          },
          "400290313": {
            "id": "400290313",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "阿贝多先生！来得正好，是这样的，派蒙想要一个能把果子变成果汁，同时又能为水果保鲜的机器，这也太…",
            "nextDialogs": [
              "400290314"
            ]
          },
          "400290314": {
            "id": "400290314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "很重要！如果能发明这种东西的话，我们就再也不用担心水果腐烂啦！",
            "nextDialogs": [
              "400290315"
            ]
          },
          "400290315": {
            "id": "400290315",
            "speakerId": 1587,
            "speakerName": "蒂玛乌斯",
            "text": "不可能啊！…"
          }
        }
      }
    },

          "400290205": {
            "id": "400290205",
            "speakerId": 1668,
            "speakerName": "乔尔",
            "text": "爸爸！这位就是我和你说的旅行者，之前帮过我好多好多忙，这次还陪我一起堆雪人呢。",
            "nextDialogs": [
              "400290206"
            ]
          },
          "400290206": {
            "id": "400290206",
            "speakerId": 1674,
            "speakerName": "乔瑟夫",
            "text": "乔尔都和我说了，哎呀，真是太感谢你了。"
          }
        }

    "？？？": 1
  },
  "subQuests": [
    {
      "subId": "4002901",
      "subQuestName": "前往阿贝多的营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400290101"
        ],
        "dialogs": {
          "400290101": {
            "id": "400290101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多！",
            "nextDialogs": [
              "400290102"
            ]
          },
          "400290102": {
            "id": "400290102",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "旅行者，派蒙。",
            "nextDialogs": [
              "400290103"
            ]
          },
          "400290103": {
            "id": "400290103",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "看来你们已经想好故事了。",
            "nextDialogs": [
              "400290104"
            ]
          },
          "400290104": {
            "id": "400290104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀对呀，你呢？需要再给你一些时间吗？",
            "nextDialogs": [
              "400290105"
            ]
          },
          "400290105": {
            "id": "400290105",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "不用。我也想好了。",
            "nextDialogs": [
              "400290106"
            ]
          },
          "400290106": {
            "id": "400290106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "先来后到，我要先说！",
            "nextDialogs": [
              "400290107"
            ]
          },
          "400290107": {
            "id": "400290107",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "好啊，请。",
            "nextDialogs": [
              "400290108"
            ]
          },
          "400290108": {
            "id": "400290108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我开始了哦！",
            "nextDialogs": [
              "400290109"
            ]
          },
          "400290109": {
            "id": "400290109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "从前有一个邪恶的学者，抓着山上的骗骗花进行改造，这些骗骗花带着痛苦变成了人的样子，站在山路旁等着过往行人…",
            "nextDialogs": [
              "400290110"
            ]
          },
          "400290110": {
            "id": "400290110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "只要有人理，他们就会问对方一些问题，例如：我是谁？你是谁？",
            "nextDialogs": [
              "400290111"
            ]
          },
          "400290111": {
            "id": "400290111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如果回答错误…就会哇的一声被吃掉！",
            "nextDialogs": [
              "400290112"
            ]
          },
          "400290112": {
            "id": "400290112",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "嗯，真可怕。",
            "nextDialogs": [
              "400290113"
            ]
          },
          "400290113": {
            "id": "400290113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙好可怕。",
            "nextDialogs": [
              "400290114"
            ]
          },
          "400290114": {
            "id": "400290114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么呀，你们完全没被吓到嘛！",
            "nextDialogs": [
              "400290115"
            ]
          },
          "400290115": {
            "id": "400290115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可能是我太坚强了。",
            "nextDialogs": [
              "400290116"
            ]
          },
          "400290116": {
            "id": "400290116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不许挑我的毛病啦！你要是不满意就自己想一个嘛。",
            "nextDialogs": [
              "400290117"
            ]
          },
          "400290117": {
            "id": "400290117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那么，加入恐怖要素…",
            "nextDialogs": [
              "400290120"
            ]
          },
          "400290120": {
            "id": "400290120",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "也就是说，身为凶手的骗骗花完全取代了被害者。",
            "nextDialogs": [
              "400290121"
            ]
          },
          "400290121": {
            "id": "400290121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "而且还要利用这个身份。",
            "nextDialogs": [
              "400290122"
            ]
          },
          "400290122": {
            "id": "400290122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那接下来骗骗花就要进城了吧？！变成普通人的样子回到家里，把他们的家人统统吃掉…呜哇…",
            "nextDialogs": [
              "400290123"
            ]
          },
          "400290123": {
            "id": "400290123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "明明是我开的头，我却觉得好可怕呀…",
            "nextDialogs": [
              "400290124"
            ]
          },
          "400290124": {
            "id": "400290124",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "不错的故事呢。我能记下来吗？下次跟人聊天也许会用到。",
            "nextDialogs": [
              "400290125"
            ]
          },
          "400290125": {
            "id": "400290125",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你是想拿去吓唬人吗？",
            "nextDialogs": [
              "400290126"
            ]
          },
          "400290126": {
            "id": "400290126",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "嗯。",
            "nextDialogs": [
              "400290127"
            ]
          },
          "400290127": {
            "id": "400290127",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这人好坏啊。",
            "nextDialogs": [
              "400290128"
            ]
          },
          "400290128": {
            "id": "400290128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你编了什么故事呢？",
            "nextDialogs": [
              "400290129"
            ]
          },
          "400290129": {
            "id": "400290129",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我的故事比你的故事要长一些。最早，要从一个炼金术士说起。",
            "nextDialogs": [
              "400290130"
            ]
          },
          "400290130": {
            "id": "400290130",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "伟大的炼金术士创造了一号。一号带着她的骄傲，完美地融入了普通人。谁也不会想到，身边这个朋友竟然是人造人。",
            "nextDialogs": [
              "400290131"
            ]
          },
          "400290131": {
            "id": "400290131",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "然而，一号并不知道，在他诞生前，炼金术师还进行过许多次试验。有些失败的残次品遭到遗弃，可他并未死去。",
            "nextDialogs": [
              "400290132"
            ]
          },
          "400290132": {
            "id": "400290132",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "失败品二号被巨龙吞入腹中，跟随龙一起留在了雪山上，直到许多年后，他因为某种神秘的龙之力苏醒过来。",
            "nextDialogs": [
              "400290133"
            ]
          },
          "400290133": {
            "id": "400290133",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "他看见雪山上各式各样的人，以及那个…神奇地融入了他们的一号。",
            "nextDialogs": [
              "400290134"
            ]
          },
          "400290134": {
            "id": "400290134",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "二号从未想过，他们这些试验品居然能完美骗过所有人的眼睛。人们接纳一号为朋友，亲切地称呼他的名字。",
            "nextDialogs": [
              "400290135"
            ]
          },
          "400290135": {
            "id": "400290135",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "而那正是二号想要的。所以，二号想要替代一号，成为那个幸福的人。",
            "nextDialogs": [
              "400290136"
            ]
          },
          "400290136": {
            "id": "400290136",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜…我、我突然觉得好冷，好吓人…",
            "nextDialogs": [
              "400290137"
            ]
          },
          "400290137": {
            "id": "400290137",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "二号展开了他的计划。他偷来一号的书本与笔记，研究一号那些继承自炼金术士的学识。他很聪明，学得很快。",
            "nextDialogs": [
              "400290138"
            ]
          },
          "400290138": {
            "id": "400290138",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "随后，他改变了自己原本那张脸，变成与一号完全一样的面孔。又找到一株能够拟态的雪山植物，使用龙血和炼金术改造它。",
            "nextDialogs": [
              "400290139"
            ]
          },
          "400290139": {
            "id": "400290139",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "400290140"
            ]
          },
          "400290140": {
            "id": "400290140",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "二号将自己变成与一号完全相同的模样，又制造出了第三个个体：三号。",
            "nextDialogs": [
              "400290141"
            ]
          },
          "400290141": {
            "id": "400290141",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哎？！三个？！",
            "nextDialogs": [
              "400290142"
            ]
          },
          "400290142": {
            "id": "400290142",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "但不同的是，二号想要成为真正的完美之人。于是，他抹去了自己和三号脖子上象征瑕疵的印记。",
            "nextDialogs": [
              "400290143"
            ]
          },
          "400290143": {
            "id": "400290143",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "故意…抹去？",
            "nextDialogs": [
              "400290144"
            ]
          },
          "400290144": {
            "id": "400290144",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "要我说的话，抹去印记可能只是下意识所为。",
            "nextDialogs": [
              "400290145"
            ]
          },
          "400290145": {
            "id": "400290145",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "他太过渴望成为完美之人，以至于忘记了，人类本就因不完美而生动。",
            "nextDialogs": [
              "400290146"
            ]
          },
          "400290146": {
            "id": "400290146",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "二号的计划非常周密，三号负责吸引注意力，等一号处理掉三号之后，认为威胁已经消失的一号必然会陷入松懈。",
            "nextDialogs": [
              "400290147"
            ]
          },
          "400290147": {
            "id": "400290147",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "一号落单的时刻，就是二号动手的最佳时机。除掉一号，他就能成为唯一的那个个体。",
            "nextDialogs": [
              "400290148"
            ]
          },
          "400290148": {
            "id": "400290148",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "他会神不知鬼不觉地替换掉所有人记忆中的一号，继承一号的身份、住所、衣物、宝剑、名字和朋友。",
            "nextDialogs": [
              "400290149"
            ]
          },
          "400290149": {
            "id": "400290149",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "而人们并不知道，他们昨天与今天见到的竟然是两个人。",
            "nextDialogs": [
              "400290150"
            ]
          },
          "400290150": {
            "id": "400290150",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吓人，好吓人啊…我再也不要相信别人了…",
            "nextDialogs": [
              "400290151"
            ]
          },
          "400290151": {
            "id": "400290151",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "但就在二号实施计划之前，有个特别的陌生人出现了。二号尝试与他接触，却发现他能隐约感觉出自己和一号有所不同。",
            "nextDialogs": [
              "400290152"
            ]
          },
          "400290152": {
            "id": "400290152",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "400290153"
            ]
          },
          "400290153": {
            "id": "400290153",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "400290154"
            ]
          },
          "400290154": {
            "id": "400290154",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "怎么？被吓到了吗？",
            "nextDialogs": [
              "400290155"
            ]
          },
          "400290155": {
            "id": "400290155",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "后来呢？那个陌生人怎么样了？",
            "nextDialogs": [
              "400290156"
            ]
          },
          "400290156": {
            "id": "400290156",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "当然是被二号列为了计划中的一环。对二号来说，必须除掉的人又多了一个。",
            "nextDialogs": [
              "400290157"
            ]
          },
          "400290157": {
            "id": "400290157",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "就像是院子里的三株玫瑰，外观完全一样。三株中只有一株是不带毒刺的优质品，剩下两株都是长有毒刺的劣等品。",
            "nextDialogs": [
              "400290158"
            ]
          },
          "400290158": {
            "id": "400290158",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "而在这世界上，只有照顾它们的园丁能够分辨出哪一株才是优质品。",
            "nextDialogs": [
              "400290159"
            ]
          },
          "400290159": {
            "id": "400290159",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "人们不喜欢带毒的植物，唯有完美的玫瑰可以卖出高价。劣等品想要掩盖自己不值钱的事实，就要用毒刺除掉园丁。",
            "nextDialogs": [
              "400290160"
            ]
          },
          "400290160": {
            "id": "400290160",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "二号也是这样想的。所以他躲在暗处耐心地等待。也许再过一会儿，他的机会就要来了。他会成为真正的「人」。",
            "nextDialogs": [
              "400290161"
            ]
          },
          "400290161": {
            "id": "400290161",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这不只是故事…）",
            "nextDialogs": [
              "400290162"
            ]
          },
          "400290162": {
            "id": "400290162",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（这是真实存在于过去的事。阿贝多想告诉我的，就是这些残酷又不可思议的真相。）",
            "nextDialogs": [
              "400290163"
            ]
          },
          "400290163": {
            "id": "400290163",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好压抑的故事啊，后来怎么样？二号成功了吗？我都不敢想了…",
            "nextDialogs": [
              "400290164"
            ]
          },
          "400290164": {
            "id": "400290164",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "幸好故事只是故事，不会成真，二号在这个故事里也没能取得成功。但在雪山，你们不能放松警惕。",
            "nextDialogs": [
              "400290165"
            ]
          },
          "400290165": {
            "id": "400290165",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "用杜林的力量和血肉变异而成的怪物，也能算是莱茵多特的造物，跟我没什么不同。你们要小心这类生物。",
            "nextDialogs": [
              "400290166"
            ]
          },
          "400290166": {
            "id": "400290166",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是这样的！你是我的朋友，不是怪物。",
            "nextDialogs": [
              "400290167"
            ]
          },
          "400290167": {
            "id": "400290167",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "很高兴听到你这么说。没关系，我知道自己的来历。你我同为异类，在你面前我无需掩饰真实。",
            "nextDialogs": [
              "400290168"
            ]
          },
          "400290168": {
            "id": "400290168",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "只不过有时想到炼金术是如此伟大的学问，会有些无奈。",
            "nextDialogs": [
              "400290169"
            ]
          },
          "400290169": {
            "id": "400290169",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "作为踏足大地的生命之一，渴望掌握命运，渴求创造的我们究竟有多傲慢？",
            "nextDialogs": [
              "400290170"
            ]
          },
          "400290170": {
            "id": "400290170",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "旅行者，创造是傲慢的行径吗？如果不是，那我们为何称呼掌控我们、创造我们的事物为「神」？",
            "nextDialogs": [
              "400290171"
            ]
          },
          "400290171": {
            "id": "400290171",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "如果是，那我们又有何资格去自居「创造者」这一身份呢。我们的敬畏和尊重，究竟要做到哪一步，要用到何处？",
            "nextDialogs": [
              "400290172"
            ]
          },
          "400290172": {
            "id": "400290172",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "处置冒牌货的时候，你是什么感觉？",
            "nextDialogs": [
              "400290173"
            ]
          },
          "400290173": {
            "id": "400290173",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "没什么特别的感觉。不过…",
            "nextDialogs": [
              "400290174"
            ]
          },
          "400290174": {
            "id": "400290174",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "…偶尔想起这件事，会感到一丝悲哀。",
            "nextDialogs": [
              "400290175"
            ]
          },
          "400290175": {
            "id": "400290175",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多…",
            "nextDialogs": [
              "400290176"
            ]
          },
          "400290176": {
            "id": "400290176",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "喂——！旅行者！你在这里吗？",
            "nextDialogs": [
              "400290177"
            ]
          },
          "400290177": {
            "id": "400290177",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，安柏的声音？",
            "nextDialogs": [
              "400290178"
            ]
          },
          "400290178": {
            "id": "400290178",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "果然在这里啊。",
            "nextDialogs": [
              "400290179"
            ]
          },
          "400290179": {
            "id": "400290179",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "旅行者，我们是来替塞琉斯先生传话的，山脚营地那边有重要的事，你也一起去吧。",
            "nextDialogs": [
              "400290180"
            ]
          },
          "400290180": {
            "id": "400290180",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "冬令营接近尾声，就算是挂名教官也得就位了。",
            "nextDialogs": [
              "400290181"
            ]
          },
          "400290181": {
            "id": "400290181",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们得走了，阿贝多，先再见啦。",
            "nextDialogs": [
              "400290182"
            ]
          },
          "400290182": {
            "id": "400290182",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "去忙吧。我这里还有些事，就不陪各位下山了。",
            "nextDialogs": [
              "400290183"
            ]
          },
          "400290183": {
            "id": "400290183",
            "speakerId": 1002,
            "speakerName": "安柏",
            "text": "没关系没关系，最近上下山都很顺利哦。",
            "nextDialogs": [
              "400290184"
            ]
          },
          "400290184": {
            "id": "400290184",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "准备好就出发吧，别让营地那边久等了。"
          }
        }
      }
    },

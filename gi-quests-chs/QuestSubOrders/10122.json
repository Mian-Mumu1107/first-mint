    {
      "subId": "1012213",
      "subQuestName": "前往深处，夺回城防图",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101221301"
        ],
        "dialogs": {
          "101221301": {
            "id": "101221301",
            "speakerId": 10393,
            "speakerName": "伊万",
            "text": "你们是什么人？",
            "nextDialogs": [
              "101221302"
            ]
          },
          "101221302": {
            "id": "101221302",
            "speakerId": 10393,
            "speakerName": "伊万",
            "text": "如果是被人带进来的，就不要到处乱走。"
          }
        }
      }
    },
    {

  },
  "subQuests": [
    {
      "subId": "1012201",
      "subQuestName": "前往清泉镇附近，寻找舒伯特",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101220101"
        ],
        "dialogs": {
          "101220101": {
            "id": "101220101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（帐篷破破烂烂的，却有一把看起来很不错的椅子…）",
            "nextDialogs": [
              "101220102"
            ]
          },
          "101220102": {
            "id": "101220102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（这也是贵族的礼数之一吗？）",
            "nextDialogs": [
              "101220103"
            ]
          },
          "101220103": {
            "id": "101220103",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "又是你们？唉，能不能不要来烦我？",
            "nextDialogs": [
              "101220105",
              "101220107"
            ]
          },
          "101220105": {
            "id": "101220105",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "「宽宏大量」…有点意思，不错，正是如此。",
            "nextDialogs": [
              "101220108"
            ]
          },
          "101220108": {
            "id": "101220108",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "行吧，我也绝非心胸狭隘之人，此前的小小不悦就既往不咎了。你若想进言，我便姑且一听。",
            "nextDialogs": [
              "101220109"
            ]
          },
          "101220109": {
            "id": "101220109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（哇，这高高在上的姿态！）"
          },
          "101220107": {
            "id": "101220107",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "「斗胆」…有点意思，听到了一个很恰当的词。"
          }
        }
      }
    },
    {
      "subId": "1012204",
      "subQuestName": "陪同舒伯特面见「帮手」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101220401"
        ],
        "dialogs": {
          "101220401": {
            "id": "101220401",
            "speakerId": 10390,
            "speakerName": "达列尔",
            "text": "等等，这个人是谁？",
            "nextDialogs": [
              "101220402"
            ]
          },
          "101220402": {
            "id": "101220402",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "我有必要告诉你吗？",
            "nextDialogs": [
              "101220403"
            ]
          },
          "101220403": {
            "id": "101220403",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "我带来的，自然是客人。若是得罪了我们的客人，你可逃不掉劳伦斯家族的问责。",
            "nextDialogs": [
              "101220404"
            ]
          },
          "101220404": {
            "id": "101220404",
            "speakerId": 10390,
            "speakerName": "达列尔",
            "text": "但这件事是机密中的机密，谨慎一点没有坏处。",
            "nextDialogs": [
              "101220405"
            ]
          },
          "101220405": {
            "id": "101220405",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "贵族行事，岂容你在我面前指指点点？我不想废话，把路让开。",
            "nextDialogs": [
              "101220406"
            ]
          },
          "101220406": {
            "id": "101220406",
            "speakerId": 10390,
            "speakerName": "达列尔",
            "text": "趾高气昂，不知道有什么本事…",
            "nextDialogs": [
              "101220407"
            ]
          },
          "101220407": {
            "id": "101220407",
            "speakerId": 10390,
            "speakerName": "达列尔",
            "text": "行行行，你们请进。"
          }
        }
      }
    },
    {
      "subId": "1012205",
      "subQuestName": "与舒伯特交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101220301"
        ],
        "dialogs": {
          "101220301": {
            "id": "101220301",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "嗯？为什么要突然带上面罩？",
            "nextDialogs": [
              "101220304"
            ]
          },
          "101220304": {
            "id": "101220304",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "对哦，就算他们实力强大，在蒙德这片土地上，我们的地位还是远高于他们。",
            "nextDialogs": [
              "101220305"
            ]
          },
          "101220305": {
            "id": "101220305",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "既然如此，的确不该那么容易让他们瞻仰到你的真容，哈哈哈…",
            "nextDialogs": [
              "101220306"
            ]
          },
          "101220306": {
            "id": "101220306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还好你反应够快，我还以为会露馅呢…",
            "nextDialogs": [
              "101220307"
            ]
          },
          "101220307": {
            "id": "101220307",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "那我们继续前进吧，我会给他们介绍，你是我的客人。"
          }
        }
      }
    },
    {
      "subId": "1012206",
      "subQuestName": "跟随舒伯特",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101220601"
        ],
        "dialogs": {
          "101220601": {
            "id": "101220601",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "别碰我，闪开！我自己会走！",
            "nextDialogs": [
              "101220602"
            ]
          },
          "101220602": {
            "id": "101220602",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "看起来是赶上了，这里确实有很多愚人众。",
            "nextDialogs": [
              "101220603"
            ]
          },
          "101220603": {
            "id": "101220603",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "哦，是你，调查已经有收获了？",
            "nextDialogs": [
              "101220606"
            ]
          },
          "101220606": {
            "id": "101220606",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "难道，这家伙的礼仪，全都是从你那里学的？你不是从来都不把这些东西放在心上吗！",
            "nextDialogs": [
              "101220607"
            ]
          },
          "101220607": {
            "id": "101220607",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "而且，家族有规矩，这些东西是不可以教给外人的！",
            "nextDialogs": [
              "101220608"
            ]
          },
          "101220608": {
            "id": "101220608",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "哦，好像是有这么回事来着。然后呢？好像也没有不能这么做的理由吧。",
            "nextDialogs": [
              "101220609"
            ]
          },
          "101220609": {
            "id": "101220609",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "你…你这是触犯了家里的大忌！害得我准备了好久的计划，都泡汤了！",
            "nextDialogs": [
              "101220610"
            ]
          },
          "101220610": {
            "id": "101220610",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "我知道叔父花了很大的力气，但你也知道这是不该做的事，作为西风骑士，我没有理由视而不见。",
            "nextDialogs": [
              "101220611"
            ]
          },
          "101220611": {
            "id": "101220611",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "还西风骑士，搞清楚！我是你的叔父！你是劳伦斯家族的人，应该帮助家族重获荣光！",
            "nextDialogs": [
              "101220612"
            ]
          },
          "101220612": {
            "id": "101220612",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "你现在还有争取原谅的机会，把这里的西风骑士全都干掉，跟我一起走！",
            "nextDialogs": [
              "101220613"
            ]
          },
          "101220613": {
            "id": "101220613",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "那我就会在家里为你求情，给你一个改过自新的机会！",
            "nextDialogs": [
              "101220614"
            ]
          },
          "101220614": {
            "id": "101220614",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "没听懂，你要西风骑士去干掉西风骑士？",
            "nextDialogs": [
              "101220615"
            ]
          },
          "101220615": {
            "id": "101220615",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "再重复一次，你才不是什么西风骑士，你是我们家族的末裔！",
            "nextDialogs": [
              "101220616"
            ]
          },
          "101220616": {
            "id": "101220616",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "你是流着劳伦斯家族之血的贵族！应该要顺应家族的意志！",
            "nextDialogs": [
              "101220617"
            ]
          },
          "101220617": {
            "id": "101220617",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "…可是，从以前到现在，我什么时候顺应过家族的意志？",
            "nextDialogs": [
              "101220618"
            ]
          },
          "101220618": {
            "id": "101220618",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "你、你…！你这个大逆不道的家伙！",
            "nextDialogs": [
              "101220619"
            ]
          },
          "101220619": {
            "id": "101220619",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "真要发脾气，生气的也应该是我才对。你明知你是劳伦斯家族的一员，还在搞这种威胁蒙德安全的事。",
            "nextDialogs": [
              "101220620"
            ]
          },
          "101220620": {
            "id": "101220620",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "你想过你给多少人添了麻烦吗？你又想过，为了平息这次的事，我要和多少人结仇吗？",
            "nextDialogs": [
              "101220621"
            ]
          },
          "101220621": {
            "id": "101220621",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "你在教训我？你居然敢教训我？",
            "nextDialogs": [
              "101220622"
            ]
          },
          "101220622": {
            "id": "101220622",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "是的，我在教训你。叔父，以你最看重的劳伦斯家族之名。",
            "nextDialogs": [
              "101220623"
            ]
          },
          "101220623": {
            "id": "101220623",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "我没有经历过你所说的「荣光」的时代，也不理解家族对此狂热的追求。",
            "nextDialogs": [
              "101220624"
            ]
          },
          "101220624": {
            "id": "101220624",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "但我有能力判断是非对错，也深知「自由」对蒙德人的意义。",
            "nextDialogs": [
              "101220625"
            ]
          },
          "101220625": {
            "id": "101220625",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "——劳伦斯家族不会，也不应该变成你心中的样子。",
            "nextDialogs": [
              "101220626"
            ]
          },
          "101220626": {
            "id": "101220626",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "唔，唔…！",
            "nextDialogs": [
              "101220627"
            ]
          },
          "101220627": {
            "id": "101220627",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "家门不幸！家门不幸啊！家里怎么出来你这么一个大逆不道的怪物！",
            "nextDialogs": [
              "101220628"
            ]
          },
          "101220628": {
            "id": "101220628",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看上去一幅歇斯底里的样子。总是挂在嘴边的礼貌和优雅，完全不见了呢。",
            "nextDialogs": [
              "101220629"
            ]
          },
          "101220629": {
            "id": "101220629",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "不太明白你在吵什么。麻烦两位把他带走吧，我和荣誉骑士，接下来还有事要做。",
            "nextDialogs": [
              "101220630"
            ]
          },
          "101220630": {
            "id": "101220630",
            "speakerId": 1029,
            "speakerName": "优菈",
            "text": "既然你们动手了，就说明已经掌握决定性的证据了吧？"
          }
        }
      }
    },
    {
      "subId": "1012207",
      "subQuestName": "与守门的愚人众交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1012208",
      "subQuestName": "继续跟随舒伯特",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101220801"
        ],
        "dialogs": {
          "101220801": {
            "id": "101220801",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "我说了这么多，麻烦你不要告诉优菈。",
            "nextDialogs": [
              "101220802"
            ]
          },
          "101220802": {
            "id": "101220802",
            "speakerId": 10002,
            "speakerName": "莎拉",
            "text": "不然，她又要觉得我多管闲事了。"
          }
        }
      }
    },
    {
      "subId": "1012209",
      "subQuestName": "与面前的愚人众交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "101220501"
        ],
        "dialogs": {
          "101220501": {
            "id": "101220501",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "（这个人，我好像在哪里见过…）",
            "nextDialogs": [
              "101220502"
            ]
          },
          "101220502": {
            "id": "101220502",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "请问，这位是？请不要随随便便把信不过的人带进来。",
            "nextDialogs": [
              "101220503"
            ]
          },
          "101220503": {
            "id": "101220503",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "#这是我找来的新的盟友，我以劳伦斯的名字起誓，你可以完全相信{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}。",
            "nextDialogs": [
              "101220506"
            ]
          },
          "101220506": {
            "id": "101220506",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "我们的计划是机密，不应当中途让外人参与。",
            "nextDialogs": [
              "101220507"
            ]
          },
          "101220507": {
            "id": "101220507",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "更何况我听说了有一位加入了骑士团的外来者，最近在蒙德附近十分活跃。",
            "nextDialogs": [
              "101220508"
            ]
          },
          "101220508": {
            "id": "101220508",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "#那不可能，这个人精通旧贵族的礼仪，所以我也要以尊重与信任回敬{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}。",
            "nextDialogs": [
              "101220509"
            ]
          },
          "101220509": {
            "id": "101220509",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "骑士团的人对这种东西从来都是不屑一顾，绝对不可能掌握得这么好。",
            "nextDialogs": [
              "101220510"
            ]
          },
          "101220510": {
            "id": "101220510",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "还有这个家伙…",
            "nextDialogs": [
              "101220511"
            ]
          },
          "101220511": {
            "id": "101220511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我怎么了吗？",
            "nextDialogs": [
              "101220512"
            ]
          },
          "101220512": {
            "id": "101220512",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "行了！连我说的话你都不信任了吗？别忘了是谁在支援你们在蒙德的行动。",
            "nextDialogs": [
              "101220513"
            ]
          },
          "101220513": {
            "id": "101220513",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "要是少了劳伦斯家族的支持，你们早就被骑士团赶走了吧！",
            "nextDialogs": [
              "101220514"
            ]
          },
          "101220514": {
            "id": "101220514",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "你应该立刻向我被冒犯的朋友，呈上最诚挚的歉意！",
            "nextDialogs": [
              "101220515"
            ]
          },
          "101220515": {
            "id": "101220515",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "嘁…",
            "nextDialogs": [
              "101220516"
            ]
          },
          "101220516": {
            "id": "101220516",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "好好好，既然是你说的，我就不再追究什么了。",
            "nextDialogs": [
              "101220517"
            ]
          },
          "101220517": {
            "id": "101220517",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "直接切入正题吧，你许诺的蒙德城防图，已经带来了吗？",
            "nextDialogs": [
              "101220518"
            ]
          },
          "101220518": {
            "id": "101220518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "（一上来就是这么劲爆的交易？！）",
            "nextDialogs": [
              "101220519"
            ]
          },
          "101220519": {
            "id": "101220519",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "啊，当然，就在这里。",
            "nextDialogs": [
              "101220520"
            ]
          },
          "101220520": {
            "id": "101220520",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "我看看…呃，为什么这么丑？线条歪歪扭扭的，这方块和圆圈又是什么？",
            "nextDialogs": [
              "101220521"
            ]
          },
          "101220521": {
            "id": "101220521",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "你说什么？这是我花了好长的时间才一点一点画下来的！",
            "nextDialogs": [
              "101220522"
            ]
          },
          "101220522": {
            "id": "101220522",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "那也不是什么方块和圆圈！是代表西风骑士的标记！",
            "nextDialogs": [
              "101220523"
            ]
          },
          "101220523": {
            "id": "101220523",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "唉，行吧，简陋了点，勉强能看懂。你能保证这些信息全都可靠吧？",
            "nextDialogs": [
              "101220524"
            ]
          },
          "101220524": {
            "id": "101220524",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "那当然，放心好了。你也别忘了我们的约定，要让劳伦斯家族的旗帜飘扬在骑士团总部的楼顶上。",
            "nextDialogs": [
              "101220525"
            ]
          },
          "101220525": {
            "id": "101220525",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "那栋楼的归属权，还有整个城市的直接管理权，都属于劳伦斯家族。",
            "nextDialogs": [
              "101220526"
            ]
          },
          "101220526": {
            "id": "101220526",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "嗯，双赢的交易，没必要讨价还价。",
            "nextDialogs": [
              "101220527"
            ]
          },
          "101220527": {
            "id": "101220527",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "我们会好好利用这份情报。对了，考虑到外交影响，请不要在任何场合暴露我们的身份。",
            "nextDialogs": [
              "101220528"
            ]
          },
          "101220528": {
            "id": "101220528",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "放心放心，这件事天知地知你知我知，还有我这位朋友知，不会再有别人了。",
            "nextDialogs": [
              "101220529"
            ]
          },
          "101220529": {
            "id": "101220529",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "到时候我站在骑士团总部的楼顶，痛骂他们对蒙德的软弱统治。所有的市民，都要再度臣服于劳伦斯的脚下！",
            "nextDialogs": [
              "101220530"
            ]
          },
          "101220530": {
            "id": "101220530",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "哈哈，都回来了，全都回来了！",
            "nextDialogs": [
              "101220531"
            ]
          },
          "101220531": {
            "id": "101220531",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "唉…",
            "nextDialogs": [
              "101220532"
            ]
          },
          "101220532": {
            "id": "101220532",
            "speakerId": 10391,
            "speakerName": "谢尔盖",
            "text": "最后提醒一句，不要贸然行动，那就这样吧。",
            "nextDialogs": [
              "101220533"
            ]
          },
          "101220533": {
            "id": "101220533",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就这样吧。",
            "nextDialogs": [
              "101220534"
            ]
          },
          "101220534": {
            "id": "101220534",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那就这样吧。",
            "nextDialogs": [
              "101220535"
            ]
          },
          "101220535": {
            "id": "101220535",
            "speakerId": 10386,
            "speakerName": "舒伯特",
            "text": "怎么了，突然？"
          }
        }
      }
    },

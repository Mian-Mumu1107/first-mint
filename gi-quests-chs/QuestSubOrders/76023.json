            ]
          },
          "760230403": {
            "id": "760230403",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "方格尔设置好了实验要用的参数。"
          }
        }
      }
    },
    {
      "subId": "7602305",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760230501"
        ],
        "dialogs": {
          "760230501": {
            "id": "760230501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以，不过请稍微等我一下。",
            "nextDialogs": [
              "760230502"
            ]
          },
          "760230502": {
            "id": "760230502",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "好，那我顺便排查一下采集器的硬件状态吧。"
          }
        }
      }

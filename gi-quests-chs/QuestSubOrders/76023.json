  "subQuests": [
    {
      "subId": "7602301",
      "subQuestName": "到达气象站$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760230101"
        ],
        "dialogs": {
          "760230101": {
            "id": "760230101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "虽然不知道两位勇士是怎么平安无事穿越雷暴来到这里的，但！现在不是说这个的时候，请帮帮忙！",
            "nextDialogs": [
              "760230102"
            ]
          },
          "760230102": {
            "id": "760230102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "先不要这么着急，我们肯定不会坐视不管的。要我们做什么呢？",
            "nextDialogs": [
              "760230103"
            ]
          },
          "760230103": {
            "id": "760230103",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "请帮我把<color=#00E1FFFF>空域数据采集器</color>升起来！",
            "nextDialogs": [
              "760230104"
            ]
          },
          "760230104": {
            "id": "760230104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "空域数据采集器？是那个圆圆大机器吗？",
            "nextDialogs": [
              "760230105"
            ]
          },
          "760230105": {
            "id": "760230105",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "没错！只要把<color=#00E1FFFF>组合模块的强月矩力面对准采集器，推到正确的位置</color>就可以了。",
            "nextDialogs": [
              "760230106"
            ]
          },
          "760230106": {
            "id": "760230106",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "之后采集器——啊，就是那个圆圆大机器——就会升起来，那就说明成功了！",
            "nextDialogs": [
              "760230107"
            ]
          },
          "760230107": {
            "id": "760230107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#好吧，看他这么着急…我们就来帮帮他吧，{NICKNAME}。",
            "nextDialogs": [
              "760230108"
            ]
          },
          "760230108": {
            "id": "760230108",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "真是帮了大忙了，太感谢你们了！"
          }
        }
      }
    },
    {
      "subId": "7602302",
      "subQuestName": "奇怪的设施$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760230201"
        ],
        "dialogs": {
          "760230201": {
            "id": "760230201",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "不要劈到我啊…我还有需要完成的工作！"
          }
        }
      }
    },
    {
      "subId": "7602303",
      "subQuestName": "与研究员对话",

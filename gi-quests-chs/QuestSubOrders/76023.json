        "dialogs": {
          "760233601": {
            "id": "760233601",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "这是最后一次实验了。<color=#00E1FFFF>先引雷到那边的引雷针上，再飞到高处采集数据，</color>采集器2.0里的防雷装置一定会保护好你的。",
            "nextDialogs": [
              "760233602"
            ]
          },
          "760233602": {
            "id": "760233602",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "一旦数据足够之后马上就会通知你们的，我会尽我所能保障你们的安全。准备好了吗？"
          }
        }
      }
    },
    {
      "subId": "7602338",

    {
      "subId": "7602319",
      "subQuestName": "携带二代采集器起飞",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760231901"
        ],
        "dialogs": {
          "760231901": {
            "id": "760231901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "稍等我们一下。",
            "nextDialogs": [
              "760231902"
            ]
          },
          "760231902": {
            "id": "760231902",

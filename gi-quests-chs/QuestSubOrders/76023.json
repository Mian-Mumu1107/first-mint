    {
      "subId": "7602309",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760230901"
        ],
        "dialogs": {
          "760230901": {
            "id": "760230901",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "准备好开始后续的实验了吗？"
          }
        }
      }
    },
    {
      "subId": "7602313",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760231301"
        ],
        "dialogs": {
          "760231301": {
            "id": "760231301",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "终、终于成功了！两位勇士，我叫方格尔，是枫丹科学院的研究员。",
            "nextDialogs": [
              "760231302"
            ]
          },
          "760231302": {
            "id": "760231302",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "刚才我已经都看到了，你们实在是太了不起了！能请教你们的尊姓大名吗？",
            "nextDialogs": [
              "760231303"
            ]
          },
          "760231303": {
            "id": "760231303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我是派蒙，这个人是{NICKNAME}，我们两个是冒险家。你被困在这里很久了吗？",
            "nextDialogs": [
              "760231304"
            ]
          },
          "760231304": {
            "id": "760231304",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "要不是你们的话，或许会更久…你们两位，是第一个安全穿越雷暴区来到这里的人！",
            "nextDialogs": [
              "760231306"
            ]
          },
          "760231306": {
            "id": "760231306",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "不不，怎么可能会是我！我…没有你这样的好运气。",
            "nextDialogs": [
              "760231308"
            ]
          },
          "760231308": {
            "id": "760231308",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "说来你可能不信…这里之所以会出现如此反常的天气，一定是因为厄运缠身的我。",
            "nextDialogs": [
              "760231309"
            ]
          },
          "760231309": {
            "id": "760231309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "厄运？等一下，科学家也会相信这种事吗？",
            "nextDialogs": [
              "760231310"
            ]
          },
          "760231310": {
            "id": "760231310",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "没错，我之所以投身科学研究，正是为了解除我身上的厄运。我知道这很不可思议，但如果你经历过我所经历的就会明白——",
            "nextDialogs": [
              "760231311"
            ]
          },
          "760231311": {
            "id": "760231311",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "只要我做饭，拌沙拉都会失火；如果我晾衣服，那一定会被龙卷风卷走…像这样的事每天都会发生，我称之为「方格尔效应」。",
            "nextDialogs": [
              "760231312"
            ]
          },
          "760231312": {
            "id": "760231312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "确实有点倒霉…就没有什么办法消除这种厄运吗？",
            "nextDialogs": [
              "760231313"
            ]
          },
          "760231313": {
            "id": "760231313",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "消除「厄运」的方法，果然还得是「科学」！",
            "nextDialogs": [
              "760231314"
            ]
          },
          "760231314": {
            "id": "760231314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然很有道理，但总觉得哪里怪怪的…"
          }
        }
      }
    },
    {
      "subId": "7602320",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760232001"
        ],
        "dialogs": {
          "760232001": {
            "id": "760232001",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "太好了，有了两位的帮助，就不用再担心方格尔效应扰乱实验了！"
          }
        }
      }
    },
    {
      "subId": "7602326",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760232601"
        ],
        "dialogs": {
          "760232601": {
            "id": "760232601",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "嗯，数据整理是很细致的工作，不能分心…",
            "nextDialogs": [
              "760232603",
              "760232605",
              "760232607",
              "760232609"
            ]
          },
          "760232603": {
            "id": "760232603",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "等我论文写完、顺利发表之后，一定会寄给你们的。那么，我要继续做研究了…"
          },
          "760232605": {
            "id": "760232605",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "我们对月矩力的了解还非常有限，我也在考虑是不是应该花一些时间在挪德卡莱进一步开展实地调查。"
          },
          "760232607": {
            "id": "760232607",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "效果很好吧？毕竟我做科研是很扎实的。"
          },
          "760232609": {
            "id": "760232609",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "嗯，也祝你们的冒险顺利！"
          }
        }
      }
    },

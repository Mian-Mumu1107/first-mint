        ],
        "dialogs": {
          "760230401": {
            "id": "760230401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题，现在就开始吧。",
            "nextDialogs": [
              "760230402"
            ]
          },
          "760230402": {
            "id": "760230402",
            "speakerId": 21945,
            "speakerName": "方格尔",
            "text": "哦，对了！刚才我发现<color=#00E1FFFF>三路中有一路信号反馈有点问题，不过只要通过显像机关重置一下就可以解决。</color>那么我来设置实验参数！",
            "nextDialogs": [

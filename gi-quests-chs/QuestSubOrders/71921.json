          "719210102": {
            "id": "719210102",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "有什么不好？你是说违反稻妻的规矩吗？",
            "nextDialogs": [
              "719210103"
            ]
          },
          "719210103": {
            "id": "719210103",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "我觉得这件事因人而异，对于有些人来说，一辈子生活在农场的栅栏里也可以过得很开心…",
            "nextDialogs": [
              "719210104"
            ]
          },
          "719210104": {
            "id": "719210104",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "而对于我这样的人，能束缚我的栅栏只会在大地之外，大海之外，星辰之外！",
            "nextDialogs": [
              "719210105"
            ]
          },
          "719210105": {
            "id": "719210105",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "如果你不懂「自由」的可贵的话，就让我来告诉你吧！"
          }
        }
      }

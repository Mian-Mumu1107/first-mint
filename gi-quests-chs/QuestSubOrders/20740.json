          },
          "207400502": {
            "id": "207400502",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "你采到蒲公英了吗？",
            "nextDialogs": [
              "207400503"
            ]
          },
          "207400503": {
            "id": "207400503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经采到了。",
            "nextDialogs": [
              "207400504"
            ]
          },
          "207400504": {
            "id": "207400504",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "谢谢你，这一份就足够了，我等会就把它种到花盆里…",
            "nextDialogs": [
              "207400505"
            ]
          },
          "207400505": {
            "id": "207400505",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "还有之前你帮我摘到的那些花，我也都会种到花盆里。",
            "nextDialogs": [
              "207400506"
            ]
          },
          "207400506": {
            "id": "207400506",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "对了，还要谢谢你呢，这些是谢礼，请收下吧。",
            "nextDialogs": [
              "207400507"
            ]
          },
          "207400507": {
            "id": "207400507",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "我得快点把这些花栽进花盆里才行，还有蒲公英籽也得种下去…"
          }
        }
      }
    },
    {
      "subId": "2074012",

            ]
          },
          "207400603": {
            "id": "207400603",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "在这些地方，一定能摘到最新鲜的花。",
            "nextDialogs": [
              "207400604"
            ]
          },
          "207400604": {
            "id": "207400604",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "摘到之后，请快点拿回来给我吧。"

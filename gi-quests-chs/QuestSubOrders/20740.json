    {
      "subId": "2074004",
      "subQuestName": "采摘新鲜的花",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207400401"
        ],
        "dialogs": {
          "207400401": {
            "id": "207400401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于那些花…",
            "nextDialogs": [
              "207400402"
            ]
          },
          "207400402": {
            "id": "207400402",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "你采到那些花了吗？",
            "nextDialogs": [
              "207400403"
            ]
          },
          "207400403": {
            "id": "207400403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都采到了。",
            "nextDialogs": [
              "207400404"
            ]
          },
          "207400404": {
            "id": "207400404",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "都是很新鲜的花…谢谢你，这些花摆在店外，一定能吸引到很多客人。",
            "nextDialogs": [
              "207400405"
            ]
          },
          "207400405": {
            "id": "207400405",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "然后，我还有一个小小的请求…风刮起来的时候，店里的蒲公英也都被吹走了。",
            "nextDialogs": [
              "207400406"
            ]
          },
          "207400406": {
            "id": "207400406",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "虽然蒲公英籽被风带走不是件坏事…",
            "nextDialogs": [
              "207400407"
            ]
          },
          "207400407": {
            "id": "207400407",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "但是蒙德城的花店里没有蒲公英，感觉还是有点说不过去呢。",
            "nextDialogs": [
              "207400408"
            ]
          },
          "207400408": {
            "id": "207400408",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "蒲公英就不能直接摘掉带回来了，要从头种起才行…",
            "nextDialogs": [
              "207400409"
            ]
          },
          "207400409": {
            "id": "207400409",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "所以，能拜托你帮我去找一份蒲公英籽回来吗？",
            "nextDialogs": [
              "207400411",
              "207400413"
            ]
          },
          "207400411": {
            "id": "207400411",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "那就拜托你啦，在蒙德城外，我记得就有很多蒲公英。"
          },
          "207400413": {
            "id": "207400413",
            "speakerId": 1000,
            "speakerName": "芙萝拉",
            "text": "蒙德城外就有很多蒲公英，很容易就能采到啦。"
          }
        }
      }
    },

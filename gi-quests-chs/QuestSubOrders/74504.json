  "subQuests": [
    {
      "subId": "7450401",
      "subQuestName": "与店员阿尔贝交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745040101"
        ],
        "dialogs": {
          "745040101": {
            "id": "745040101",
            "speakerId": 30412,
            "speakerName": "阿尔贝",
            "text": "两位老爷，你们这么迫不及待就要开工啦？",
            "nextDialogs": [
              "745040102"
            ]
          },
          "745040102": {
            "id": "745040102",
            "speakerId": 30412,
            "speakerName": "阿尔贝",
            "text": "偷偷说哦，其实我倒是觉得，我们这次的企划没前途啦。有这个时间，还不如去勒波特钟表店玩玩。",
            "nextDialogs": [
              "745040103"
            ]
          },
          "745040103": {
            "id": "745040103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！这是心声吗？居然就这么说了出来吗？",
            "nextDialogs": [
              "745040104"
            ]
          },
          "745040104": {
            "id": "745040104",
            "speakerId": 30412,
            "speakerName": "阿尔贝",
            "text": "嘘，老爷小点声，别给其他人听见了，不然把我当成是那边派来的间谍就不好了。",
            "nextDialogs": [
              "745040105"
            ]
          },
          "745040105": {
            "id": "745040105",
            "speakerId": 30412,
            "speakerName": "阿尔贝",
            "text": "哎呀，这个话题我们还是点到为止比较好。毕竟我只是个打工的，现在还是来聊工作吧。",
            "nextDialogs": [
              "745040106"
            ]
          },
          "745040106": {
            "id": "745040106",
            "speakerId": 30412,
            "speakerName": "阿尔贝",
            "text": "我先说明，本次企划的数据收集分为两大部分，我和阿尔邦分别负责其中之一。",
            "nextDialogs": [
              "745040107"
            ]
          },
          "745040107": {
            "id": "745040107",
            "speakerId": 30412,
            "speakerName": "阿尔贝",
            "text": "我这部分的数据收集，是为了模拟决斗代理人的战斗力，所以需要老爷完成一些战斗的项目。",
            "nextDialogs": [
              "745040108"
            ]
          },
          "745040108": {
            "id": "745040108",
            "speakerId": 30412,
            "speakerName": "阿尔贝",
            "text": "我们在野外寻找了一些魔物的聚集点，并在附近安置了数据记录装置，只需要两位老爷前去清理掉那些家伙就可以了。",
            "nextDialogs": [
              "745040109"
            ]
          },
          "745040109": {
            "id": "745040109",
            "speakerId": 30412,
            "speakerName": "阿尔贝",
            "text": "具体的位置我已经标注在老爷的地图上了，至于其他注意事项，这里有一份手册，两位老爷稍后可以看看。",
            "nextDialogs": [
              "745040110"
            ]
          },
          "745040110": {
            "id": "745040110",
            "speakerId": 30412,
            "speakerName": "阿尔贝",
            "text": "怎么样，还有什么问题吗？",
            "nextDialogs": [
              "745040111"
            ]
          },
          "745040111": {
            "id": "745040111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题了。",
            "nextDialogs": [
              "745040112"
            ]
          },
          "745040112": {
            "id": "745040112",
            "speakerId": 30412,
            "speakerName": "阿尔贝",
            "text": "那就预祝老爷数据收集顺利。"
          }
        }
      }
    }
  ]
}
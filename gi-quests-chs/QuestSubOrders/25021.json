    {
      "subId": "2502121",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250212101"
        ],
        "dialogs": {
          "250212101": {
            "id": "250212101",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "（霍莱开心地扭了扭腰，慢慢地安静了下来。）"
          }
        }
      }
    },
    {
      "subId": "2502122",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250212201"
        ],
        "dialogs": {
          "250212201": {
            "id": "250212201",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "（霍莱迷茫地眨了眨眼，把身子向外扭开了。难道是哪里让它难受了吗…？）"
          }
        }
      }
    },
    {
      "subId": "2502127",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250212709"
        ],
        "dialogs": {
          "250212709": {
            "id": "250212709",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "（霍莱的身体并没有放松，反而迷茫地看着你。）",
            "nextDialogs": [
              "250212710"
            ]
          },
          "250212710": {
            "id": "250212710",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "（卡兹加及时接手了工作。在又一阵细致的打理后，终于还是为霍莱修剪了指甲…）",
            "nextDialogs": [
              "250212701"
            ]
          },
          "250212701": {
            "id": "250212701",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "没关系，有时候我也会猜错霍莱的心思。但它肯定知道，你是一位对它很好的朋友。",
            "nextDialogs": [
              "250212702"
            ]
          },
          "250212702": {
            "id": "250212702",
            "speakerId": 14268,
            "speakerName": "霍莱",
            "text": "呜呜，呜！",
            "nextDialogs": [
              "250212703"
            ]
          },
          "250212703": {
            "id": "250212703",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "哈哈哈，你看，我说什么来着？",
            "nextDialogs": [
              "250212704"
            ]
          },
          "250212704": {
            "id": "250212704",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "这次还是多谢你了。这些东西给你，就当做是谢礼吧。",
            "nextDialogs": [
              "250212705"
            ]
          },
          "250212705": {
            "id": "250212705",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "小龙的心思就是这么难猜，我也是和霍莱相处很久之后，才能猜出来它大部分的心思。",
            "nextDialogs": [
              "250212706"
            ]
          },
          "250212706": {
            "id": "250212706",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "能做到这件事，我就已经知足了。毕竟，我们俩可要继续相处…",
            "nextDialogs": [
              "250212707"
            ]
          },
          "250212707": {
            "id": "250212707",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "咦？霍莱去哪了？不，不会是又跑了吧！",
            "nextDialogs": [
              "250212708"
            ]
          },
          "250212708": {
            "id": "250212708",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "喂！霍莱——"
          }
        }
      }
    },

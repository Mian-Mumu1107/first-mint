    {
      "subId": "2502104",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250210401"
        ],
        "dialogs": {
          "250210401": {
            "id": "250210401",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "为了让霍莱放松，你首先得用大刷子轻轻清理它的后背…",
            "nextDialogs": [
              "250210403"
            ]
          },
          "250210403": {
            "id": "250210403",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "再用细毛刷清理它的角，这个时候要用点力道，否则就会漏掉一些缝隙中的污渍。",
            "nextDialogs": [
              "250210402"
            ]
          },
          "250210402": {
            "id": "250210402",
            "speakerId": 14267,
            "speakerName": "卡兹加",
            "text": "然后呢，拿毛巾擦洗霍莱的全身…这样，它就会慢慢放松，四足上的爪子也会伸出来，这个时候，就可以为它修剪指甲了。"
          }
        }
      }
    },

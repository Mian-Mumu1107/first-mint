  "subQuests": [
    {
      "subId": "2210401",
      "subQuestName": "与菲尔戈黛特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221040101"
        ],
        "dialogs": {
          "221040101": {
            "id": "221040101",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "真是烦人…",
            "nextDialogs": [
              "221040102"
            ]
          },
          "221040102": {
            "id": "221040102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "221040103"
            ]
          },
          "221040103": {
            "id": "221040103",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "咦，抱歉，您是什么时候来的…",
            "nextDialogs": [
              "221040104"
            ]
          },
          "221040104": {
            "id": "221040104",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "是这样，周围的怪物越来越多了，虽然我丈夫老是说，他们不敢进客栈来…",
            "nextDialogs": [
              "221040105"
            ]
          },
          "221040105": {
            "id": "221040105",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "但是只有他一个人的拳脚…我还是有点担心。",
            "nextDialogs": [
              "221040106"
            ]
          },
          "221040106": {
            "id": "221040106",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "您如果有空的话，能帮我去客栈周围看看吗？",
            "nextDialogs": [
              "221040109",
              "221040110"
            ]
          },
          "221040109": {
            "id": "221040109",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "谢谢您愿意帮忙。",
            "nextDialogs": [
              "221040113"
            ]
          },
          "221040113": {
            "id": "221040113",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "总之，就拜托你了，报酬我也不会少您的。"
          },
          "221040110": {
            "id": "221040110",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "唔…只是一家很普通的客栈啦，只不过开的地方偏了点，收的客人多了点。",
            "nextDialogs": [
              "221040111"
            ]
          },
          "221040111": {
            "id": "221040111",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "不过流落野外的人，有个地方能吃饭睡觉总是好的。",
            "nextDialogs": [
              "221040112"
            ]
          },
          "221040112": {
            "id": "221040112",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "我和我丈夫是这么想的，也就是这么简单。"
          }
        }
      }
    },
    {
      "subId": "2210402",
      "subQuestName": "前往可疑地点查看",
      "sceneId": null,
      "locations": [],
      "dialogue": {

            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "都处理好了吗？",
            "nextDialogs": [
              "221040202"
            ]
          },
          "221040202": {
            "id": "221040202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有…",
            "nextDialogs": [
              "221040203"
            ]
          },
          "221040203": {
            "id": "221040203",
            "speakerId": 2208,
            "speakerName": "菲尔戈黛特",
            "text": "请您小心一些吧，我总感觉，周围怪怪的…"
          }
        }
      }
    },

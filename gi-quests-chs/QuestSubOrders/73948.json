        "dialogs": {
          "739480101": {
            "id": "739480101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要好好照顾素达蓓和优丹哦。",
            "nextDialogs": [
              "739480102"
            ]
          },
          "739480102": {
            "id": "739480102",
            "speakerId": 1000,
            "speakerName": "卡乌斯",
            "text": "嗯，我知道。我要当个好哥哥，不会丢下他们不管的！不然，拉娜姐姐肯定会批评我不好。",
            "nextDialogs": [
              "739480103"
            ]
          },
          "739480103": {
            "id": "739480103",
            "speakerId": 1000,
            "speakerName": "卡乌斯",
            "text": "#不过，总有一天，我一定要成为最自由的船长卡乌斯，所以，最近我在和爸爸一起钓鱼。这些鱼送给{M#大哥哥}{F#大姐姐}！",
            "nextDialogs": [
              "739480104"
            ]
          },
          "739480104": {
            "id": "739480104",
            "speakerId": 1000,
            "speakerName": "卡乌斯",
            "text": "#呃…对了，素达蓓最近好像说，为了快点长大，在自己学做饭。如果她给{M#大哥哥}{F#大姐姐}吃了奇怪的东西，嗯…拜托{M#大哥哥}{F#大姐姐}不要批评她！"
          }
        }
      }
    }

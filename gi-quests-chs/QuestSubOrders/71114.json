    {
      "subId": "7111407",
      "subQuestName": "打倒所有盗宝团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7111408",
      "subQuestName": "与刚脱困的人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711140841"
        ],
        "dialogs": {
          "711140841": {
            "id": "711140841",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "赶走了所有盗宝团后，带着被盗宝团围困的人去到了旁边的亭子里休息…",
            "nextDialogs": [
              "711140801"
            ]
          },
          "711140801": {
            "id": "711140801",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "谢谢，太谢谢你了，您…",
            "nextDialogs": [
              "711140802"
            ]
          },
          "711140802": {
            "id": "711140802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是…邱老板？",
            "nextDialogs": [
              "711140803"
            ]
          },
          "711140803": {
            "id": "711140803",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#您、您是{NICKNAME}！怎么遇见您了，这真是…我又欠了您一笔大人情啊！",
            "nextDialogs": [
              "711140804"
            ]
          },
          "711140804": {
            "id": "711140804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们不是在枫丹学怎么拍映影吗？怎么突然回璃月了呀？",
            "nextDialogs": [
              "711140805"
            ]
          },
          "711140805": {
            "id": "711140805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经学成了？",
            "nextDialogs": [
              "711140806"
            ]
          },
          "711140806": {
            "id": "711140806",
            "speakerId": 13491,
            "speakerName": "弈丰",
            "text": "与其说是学成了…",
            "nextDialogs": [
              "711140807"
            ]
          },
          "711140807": {
            "id": "711140807",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "不如说是不得不「先赚钱」啦。",
            "nextDialogs": [
              "711140808"
            ]
          },
          "711140808": {
            "id": "711140808",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "你们两个人…",
            "nextDialogs": [
              "711140809"
            ]
          },
          "711140809": {
            "id": "711140809",
            "speakerId": 13491,
            "speakerName": "弈丰",
            "text": "热塞尔先生的确非常专业，为我们做出的各种指导也非常有用，但是…",
            "nextDialogs": [
              "711140810"
            ]
          },
          "711140810": {
            "id": "711140810",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "他所指导我们拍的映影，都太过注重表现意义和概念，至于具体的事物和情节嘛…",
            "nextDialogs": [
              "711140811"
            ]
          },
          "711140811": {
            "id": "711140811",
            "speakerId": 13491,
            "speakerName": "弈丰",
            "text": "用热塞尔先生的话来说，就「让他们退居幕后」了。",
            "nextDialogs": [
              "711140812"
            ]
          },
          "711140812": {
            "id": "711140812",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "但我们要拍的可是用来宣传翘英庄茶叶的映影，这么学下去，根本就是南辕北辙嘛，所以…",
            "nextDialogs": [
              "711140813"
            ]
          },
          "711140813": {
            "id": "711140813",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "所以！我就决定，暂停学习，先回来拍一部记录映影，用实际的练习来检验我们的学习成果！",
            "nextDialogs": [
              "711140814"
            ]
          },
          "711140814": {
            "id": "711140814",
            "speakerId": 13491,
            "speakerName": "弈丰",
            "text": "…也有一部分原因是，我们的资金快用差不多了啦。",
            "nextDialogs": [
              "711140815"
            ]
          },
          "711140815": {
            "id": "711140815",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "都、都说了，我已经把事情都计划好了，只要我们拍好这部映影，资金不就回来了吗？",
            "nextDialogs": [
              "711140816"
            ]
          },
          "711140816": {
            "id": "711140816",
            "speakerId": 13491,
            "speakerName": "弈丰",
            "text": "#然后，就被盗宝团两头堵在了吊桥上，还好有{NICKNAME}搭救啊。",
            "nextDialogs": [
              "711140819"
            ]
          },
          "711140819": {
            "id": "711140819",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "唉，我这不是想要取一些壮观的景色，放在映影里壮壮声势吗？",
            "nextDialogs": [
              "711140820"
            ]
          },
          "711140820": {
            "id": "711140820",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "谁知道拍得太入神，被这些盗宝团抓住了空档，我们一路跑到了这里，结果还是被堵住了…",
            "nextDialogs": [
              "711140821"
            ]
          },
          "711140821": {
            "id": "711140821",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，难道斡流小姐之前说的那几位专业的留影师，就是…",
            "nextDialogs": [
              "711140822"
            ]
          },
          "711140822": {
            "id": "711140822",
            "speakerId": 2526,
            "speakerName": "斡流",
            "text": "没错，就是邱老板他们。",
            "nextDialogs": [
              "711140823"
            ]
          },
          "711140823": {
            "id": "711140823",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "斡流小姐，你、你是从哪冒出来的？我刚才都没见到你…",
            "nextDialogs": [
              "711140824"
            ]
          },
          "711140824": {
            "id": "711140824",
            "speakerId": 2526,
            "speakerName": "斡流",
            "text": "因为我藏得比较好。",
            "nextDialogs": [
              "711140825"
            ]
          },
          "711140825": {
            "id": "711140825",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来你们都认识啊…",
            "nextDialogs": [
              "711140826"
            ]
          },
          "711140826": {
            "id": "711140826",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "哎呀，斡流小姐是专业的水文学家，对这附近的地形了如指掌。",
            "nextDialogs": [
              "711140827"
            ]
          },
          "711140827": {
            "id": "711140827",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "关于取景点这个问题，我们也请教了她很多次。",
            "nextDialogs": [
              "711140828"
            ]
          },
          "711140828": {
            "id": "711140828",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "我们还想请斡流小姐加入我们的映影团队呢！可她说要等到自己有空的时候再考虑…",
            "nextDialogs": [
              "711140829"
            ]
          },
          "711140829": {
            "id": "711140829",
            "speakerId": 13491,
            "speakerName": "弈丰",
            "text": "老板，那个…我们刚才跑的时候，好像把装着画片和设备的箱子放在原地了…",
            "nextDialogs": [
              "711140830"
            ]
          },
          "711140830": {
            "id": "711140830",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "里面…好像还有我们拍了一部分的映影画片…",
            "nextDialogs": [
              "711140831"
            ]
          },
          "711140831": {
            "id": "711140831",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "……",
            "nextDialogs": [
              "711140832"
            ]
          },
          "711140832": {
            "id": "711140832",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#斡流小姐！{NICKNAME}，派蒙，多谢你们了啊！有…有空的话，就来翘英庄找我吧！",
            "nextDialogs": [
              "711140833"
            ]
          },
          "711140833": {
            "id": "711140833",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "无论怎么说…这救命之恩，多少得为你准备点报酬。",
            "nextDialogs": [
              "711140834"
            ]
          },
          "711140834": {
            "id": "711140834",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "我们就先告辞了啊！快快快！那个箱子放哪了！快走快走！",
            "nextDialogs": [
              "711140835"
            ]
          },
          "711140835": {
            "id": "711140835",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "邱老板一行人急匆匆地离开了…",
            "nextDialogs": [
              "711140836"
            ]
          },
          "711140836": {
            "id": "711140836",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉…邱老板他们的箱子，真是多灾多难呢…",
            "nextDialogs": [
              "711140837"
            ]
          },
          "711140837": {
            "id": "711140837",
            "speakerId": 2526,
            "speakerName": "斡流",
            "text": "俗话说「好事多磨」，邱老板一定能拍出很不错的映影。",
            "nextDialogs": [
              "711140838"
            ]
          },
          "711140838": {
            "id": "711140838",
            "speakerId": 2526,
            "speakerName": "斡流",
            "text": "好了，我先把报酬结给你们吧。等一下我就去安置最后一台仪器，然后…我也会找个时间，去和邱老板聊聊。",
            "nextDialogs": [
              "711140839"
            ]
          },
          "711140839": {
            "id": "711140839",
            "speakerId": 2526,
            "speakerName": "斡流",
            "text": "不然，他们不知道又要跑去什么地方拍映影了。",
            "nextDialogs": [
              "711140840"
            ]
          },
          "711140840": {
            "id": "711140840",
            "speakerId": 2526,
            "speakerName": "斡流",
            "text": "唔，他们刚才说，可以去翘英庄找他们吧…等一下我先去那边找找好了。"
          }
        }
      }
    },
    {
      "subId": "7111409",
      "subQuestName": "在翘英庄寻找邱老板",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711140901"
        ],
        "dialogs": {
          "711140901": {
            "id": "711140901",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "唉，还是先把翘英庄里的景取了吧…",
            "nextDialogs": [
              "711140904"
            ]
          },
          "711140904": {
            "id": "711140904",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#{NICKNAME}，派蒙，哎哟！托了你们的福，设备和画片一点没丢。",
            "nextDialogs": [
              "711140905"
            ]
          },
          "711140905": {
            "id": "711140905",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "不过，我们下次想要去那边取景，看来必须得去雇几个冒险家同行了…",
            "nextDialogs": [
              "711140906"
            ]
          },
          "711140906": {
            "id": "711140906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "所以，你们那部关于茶的映影，到底拍得怎么样了呀？",
            "nextDialogs": [
              "711140907"
            ]
          },
          "711140907": {
            "id": "711140907",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "呃…这部片子处于…",
            "nextDialogs": [
              "711140908"
            ]
          },
          "711140908": {
            "id": "711140908",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "有一个良好的开头。",
            "nextDialogs": [
              "711140909"
            ]
          },
          "711140909": {
            "id": "711140909",
            "speakerId": 13491,
            "speakerName": "弈丰",
            "text": "和一个良好的趋势。",
            "nextDialogs": [
              "711140910"
            ]
          },
          "711140910": {
            "id": "711140910",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这不就是才刚开始拍吗？！",
            "nextDialogs": [
              "711140911"
            ]
          },
          "711140911": {
            "id": "711140911",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "哎呀，我们现在的资金…有点紧张，热塞尔先生的收费就和他的学问一样高超…",
            "nextDialogs": [
              "711140912"
            ]
          },
          "711140912": {
            "id": "711140912",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "虽然我们也拍了几部小片，赚了几笔小钱，但这种大型记录映影，实在是太花钱了。",
            "nextDialogs": [
              "711140913"
            ]
          },
          "711140913": {
            "id": "711140913",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "特别是老板还拒绝了几家过来赞助的客商。",
            "nextDialogs": [
              "711140914"
            ]
          },
          "711140914": {
            "id": "711140914",
            "speakerId": 13491,
            "speakerName": "弈丰",
            "text": "和谢绝了一堆合作邀请。",
            "nextDialogs": [
              "711140915"
            ]
          },
          "711140915": {
            "id": "711140915",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "你们懂什么！这是为了我们能完全依照我们自己的审美，拍出一部好片。",
            "nextDialogs": [
              "711140916"
            ]
          },
          "711140916": {
            "id": "711140916",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "但是老板，我们最开始拍片的目的，不也是为了赚钱吗…",
            "nextDialogs": [
              "711140917"
            ]
          },
          "711140917": {
            "id": "711140917",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "我…你、你们别管这么多，先去把设备支起来！",
            "nextDialogs": [
              "711140918"
            ]
          },
          "711140918": {
            "id": "711140918",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "#{NICKNAME}，这些报酬给你，多谢你帮我这么多次。",
            "nextDialogs": [
              "711140919"
            ]
          },
          "711140919": {
            "id": "711140919",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "等我拍出了好片，一定请你来看，然后再请你喝一顿好茶。",
            "nextDialogs": [
              "711140920"
            ]
          },
          "711140920": {
            "id": "711140920",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "弈丰，兴晔，找好光源角度！这次要一遍拍好！",
            "nextDialogs": [
              "711140921"
            ]
          },
          "711140921": {
            "id": "711140921",
            "speakerId": 13490,
            "speakerName": "兴晔",
            "text": "老板，这又不是拍人和人的对手戏…",
            "nextDialogs": [
              "711140922"
            ]
          },
          "711140922": {
            "id": "711140922",
            "speakerId": 13491,
            "speakerName": "弈丰",
            "text": "拍景物能不能一遍过，不都是全凭缘分嘛。",
            "nextDialogs": [
              "711140923"
            ]
          },
          "711140923": {
            "id": "711140923",
            "speakerId": 13489,
            "speakerName": "邱老板",
            "text": "总…总之先把设备架起来！先…先在这等着！"
          }
        }
      }
    },
    {
      "subId": "7111411",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711141101"
        ],
        "dialogs": {
          "711141101": {
            "id": "711141101",
            "speakerId": 2526,
            "speakerName": "斡流",
            "text": "希望邱老板能在保证自己人身安全的情况下，拍出她想要的映影。"
          }
        }
      }
    },
    {
      "subId": "7111499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711149904"
        ],
        "dialogs": {
          "711149904": {
            "id": "711149904",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "救命啊！有没有人啊！救命啊！",
            "nextDialogs": [
              "711149920"
            ]
          },
          "711149920": {
            "id": "711149920",
            "speakerId": 2526,
            "speakerName": "斡流",
            "text": "嗯…应该是往这边。这附近的风景很不错，慢点走也没关系。",
            "nextDialogs": [
              "711149921"
            ]
          },
          "711149921": {
            "id": "711149921",
            "speakerId": 2526,
            "speakerName": "斡流",
            "text": "之前举办「沉玉之旅」风光留影赛的时候，就有不少专业的留影师专门来到这里记录景色呢。",
            "nextDialogs": [
              "711149922"
            ]
          },
          "711149922": {
            "id": "711149922",
            "speakerId": 2526,
            "speakerName": "斡流",
            "text": "等去吊桥上，你们可以远眺一下周围的景色。",
            "nextDialogs": [
              "711149930"
            ]
          },
          "711149930": {
            "id": "711149930",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样就行了，我们回去找斡流吧。难得接到这么简洁的委托，嘿嘿，省力啦。",
            "nextDialogs": [
              "711149940"
            ]
          },
          "711149940": {
            "id": "711149940",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "赶走了所有盗宝团后，带着被盗宝团围困的人去到了旁边的亭子里休息…"
          }
        }
      }
    }
  ]
}
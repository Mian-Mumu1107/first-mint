  },
  "subQuests": [
    {
      "subId": "4117001",
      "subQuestName": "与修斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411700101"
        ],
        "dialogs": {
          "411700101": {
            "id": "411700101",
            "speakerId": 20172,
            "speakerName": "修斯",
            "text": "嗯…嗯！这个地方不错…很适合起飞！",
            "nextDialogs": [
              "411700102"
            ]
          },
          "411700102": {
            "id": "411700102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在哪起飞…？",
            "nextDialogs": [
              "411700103"
            ]
          },
          "411700103": {
            "id": "411700103",
            "speakerId": 20172,
            "speakerName": "修斯",
            "text": "当然是要在合适的地方…啊，旅行者，初次见面，我叫修斯，是一位冒险家。",
            "nextDialogs": [
              "411700104"
            ]
          },
          "411700104": {
            "id": "411700104",
            "speakerId": 20172,
            "speakerName": "修斯",
            "text": "不过…虽然说是冒险家，但我一直在外面研究风之翼的飞行方法，没有在协会待多长时间。",
            "nextDialogs": [
              "411700105"
            ]
          },
          "411700105": {
            "id": "411700105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "风之翼的飞行方法…",
            "nextDialogs": [
              "411700106"
            ]
          },
          "411700106": {
            "id": "411700106",
            "speakerId": 20172,
            "speakerName": "修斯",
            "text": "没错，操纵风之翼可是一门大学问。",
            "nextDialogs": [
              "411700107"
            ]
          },
          "411700107": {
            "id": "411700107",
            "speakerId": 20172,
            "speakerName": "修斯",
            "text": "同样的一架风之翼，有的人能操纵着和飞鸟同行，但有的人…飞不了多远就会摔下来。",
            "nextDialogs": [
              "411700108"
            ]
          },
          "411700108": {
            "id": "411700108",
            "speakerId": 20172,
            "speakerName": "修斯",
            "text": "说到底，就是每个人对于风之翼使用技巧的掌握程度不同罢了。",
            "nextDialogs": [
              "411700109"
            ]
          },
          "411700109": {
            "id": "411700109",
            "speakerId": 20172,
            "speakerName": "修斯",
            "text": "而想要磨练风之翼的使用技巧，那么最快捷的方法，就是去实地演练一番。",
            "nextDialogs": [
              "411700110"
            ]
          },
          "411700110": {
            "id": "411700110",
            "speakerId": 20172,
            "speakerName": "修斯",
            "text": "旅行者，你应该也有风之翼吧？我正好找到了一处适合使用风之翼飞行的地点…",
            "nextDialogs": [
              "411700111"
            ]
          },
          "411700111": {
            "id": "411700111",
            "speakerId": 20172,
            "speakerName": "修斯",
            "text": "怎么样，你有没有兴趣去那里「展翼高飞」一下？",
            "nextDialogs": [
              "411700113",
              "411700115"
            ]
          },
          "411700113": {
            "id": "411700113",
            "speakerId": 20172,
            "speakerName": "修斯",
            "text": "没问题，我这就把那里的位置标记在你的地图上…"
          },
          "411700115": {
            "id": "411700115",
            "speakerId": 20172,
            "speakerName": "修斯",
            "text": "好吧，那你先忙你的事去吧。"
          }
        }
      }
    }
  ]
}
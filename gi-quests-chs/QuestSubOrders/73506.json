  "subQuests": [
    {
      "subId": "7350601",
      "subQuestName": "与阿芬迪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735060101"
        ],
        "dialogs": {
          "735060101": {
            "id": "735060101",
            "speakerId": 1000,
            "speakerName": "阿芬迪",
            "text": "你好，欢迎来到聚砂厅，有兴趣接一些委托工作吗？",
            "nextDialogs": [
              "735060102"
            ]
          },
          "735060102": {
            "id": "735060102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有没有那种毫不费力，站着就能拿摩拉拿到手软的工作？我们很有兴趣。",
            "nextDialogs": [
              "735060103"
            ]
          },
          "735060103": {
            "id": "735060103",
            "speakerId": 1000,
            "speakerName": "阿芬迪",
            "text": "这…这样的委托确实还没有，不过我这里有一些比较简单的居民请求，报酬分别在几万摩拉不等。",
            "nextDialogs": [
              "735060104"
            ]
          },
          "735060104": {
            "id": "735060104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…几万摩拉吗？感觉有点不够花呢。",
            "nextDialogs": [
              "735060107"
            ]
          },
          "735060107": {
            "id": "735060107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对啊。阿芬迪先生，有没有报酬更高些的委托？",
            "nextDialogs": [
              "735060108"
            ]
          },
          "735060108": {
            "id": "735060108",
            "speakerId": 1000,
            "speakerName": "阿芬迪",
            "text": "啊这样吗？我想想…最近悉般多摩学院开设了一个地脉调研项目，正在有偿招募志愿者。",
            "nextDialogs": [
              "735060109"
            ]
          },
          "735060109": {
            "id": "735060109",
            "speakerId": 1000,
            "speakerName": "阿芬迪",
            "text": "悉般多摩学院里有不少学者专攻地脉研究，对地脉数据的需求很大，时常需要进入秘境调查地脉异常。",
            "nextDialogs": [
              "735060110"
            ]
          },
          "735060110": {
            "id": "735060110",
            "speakerId": 1000,
            "speakerName": "阿芬迪",
            "text": "这段时间里他们有些人手不足，找了不少本院学生帮忙还不够，不得不大量招募志愿者。",
            "nextDialogs": [
              "735060111"
            ]
          },
          "735060111": {
            "id": "735060111",
            "speakerId": 1000,
            "speakerName": "阿芬迪",
            "text": "他们的报酬开得很高，相应的，对志愿者本身的素质要求也很严格。你们有兴趣吗？",
            "nextDialogs": [
              "735060112"
            ]
          },
          "735060112": {
            "id": "735060112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么要求？",
            "nextDialogs": [
              "735060113"
            ]
          },
          "735060113": {
            "id": "735060113",
            "speakerId": 1000,
            "speakerName": "阿芬迪",
            "text": "好，我来按招募流程确认下吧，首先：「你是否能够熟练使用一种以上的武器？」"
          }
        }
      }
    },
    {
      "subId": "7350602",
      "subQuestName": "进入普斯帕咖啡馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735062301"
        ],
        "dialogs": {
          "735062301": {
            "id": "735062301",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "真是遗憾啊，明明是好不容易遇到的。",
            "nextDialogs": [
              "735062303"
            ]
          },
          "735062303": {
            "id": "735062303",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "哦？小可爱你其实也很想和我一道四处散心吗？那可太好了。",
            "nextDialogs": [
              "735062305"
            ]
          },
          "735062305": {
            "id": "735062305",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "接下来的几天我打算在须弥城内观光，最后再从化城郭那里取道璃月返回蒙德。",
            "nextDialogs": [
              "735062306"
            ]
          },
          "735062306": {
            "id": "735062306",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "说不定你不经意间，就会在须弥城或是化城郭遇到我哟。",
            "nextDialogs": [
              "735062307"
            ]
          },
          "735062307": {
            "id": "735062307",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "嗯，这么想想，不期中的偶然邂逅的确有种浪漫的情调，很符合旅行的氛围。",
            "nextDialogs": [
              "735062308"
            ]
          },
          "735062308": {
            "id": "735062308",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "遇到我的话，记得要打个招呼，不然姐姐我会寂寞的，呵呵。"
          }
        }
      }
    },
    {
      "subId": "7350603",
      "subQuestName": "前往无郁稠林",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735060301"
        ],
        "dialogs": {
          "735060301": {
            "id": "735060301",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "你们来了啊，看样子是已经做好准备了？",
            "nextDialogs": [
              "735060302"
            ]
          },
          "735060302": {
            "id": "735060302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是的。",
            "nextDialogs": [
              "735060303"
            ]
          },
          "735060303": {
            "id": "735060303",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "很好，那么我先来说明一下吧。",
            "nextDialogs": [
              "735060304"
            ]
          },
          "735060304": {
            "id": "735060304",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "我们悉般多摩学院长期与地脉打交道，需要时刻监测地脉涌流情况，这次的调研项目也是出于这个需求设立的。",
            "nextDialogs": [
              "735060305"
            ]
          },
          "735060305": {
            "id": "735060305",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "由于须弥境内的秘境中时常出现地脉的异常涌流，所以我们不得不定期派人深入各处秘境记录地脉情况。",
            "nextDialogs": [
              "735060306"
            ]
          },
          "735060306": {
            "id": "735060306",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "因为秘境内部的情况往往比较危险，所以我们设立的原则是「只派遣具有战斗能力的人员」。",
            "nextDialogs": [
              "735060307"
            ]
          },
          "735060307": {
            "id": "735060307",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "你们需要做的就是进入秘境深处，记录地脉的异常情况。注意，如果遇到危险情况，请优先保护好自己。",
            "nextDialogs": [
              "735060308"
            ]
          },
          "735060308": {
            "id": "735060308",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "好，我的说明就是这些了。准备好的话，你们就可以进入秘境了。"
          }
        }
      }
    },
    {
      "subId": "7350602",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735060201"
        ],
        "dialogs": {
          "735060201": {
            "id": "735060201",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "这里的咖啡，你还熟悉吗？",
            "nextDialogs": [
              "735060202"
            ]
          },
          "735060202": {
            "id": "735060202",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "当然，这是我以前最常喝的饮品，怎么会不熟悉呢。",
            "nextDialogs": [
              "735060203"
            ]
          },
          "735060203": {
            "id": "735060203",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "加福尔师兄，嗯…现在应该是加福尔老师了吧，我们明明是老熟人，何必一个劲地兜圈子呢？",
            "nextDialogs": [
              "735060204"
            ]
          },
          "735060204": {
            "id": "735060204",
            "speakerId": 1004,
            "speakerName": "？？？",
            "text": "又是叙旧，又是咖啡的，你有什么想说的就直说吧。",
            "nextDialogs": [
              "735060205"
            ]
          },
          "735060205": {
            "id": "735060205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那个人就是我们要找的加福尔吧，不过他好像正忙着和别人说话，要不我们先等一等。",
            "nextDialogs": [
              "735060206"
            ]
          },
          "735060206": {
            "id": "735060206",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "其实也没有什么特别的事情，自从你离开教令院之后，我们当初的项目和计划就没了主心骨。",
            "nextDialogs": [
              "735060207"
            ]
          },
          "735060207": {
            "id": "735060207",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "居勒什老师也很失望，他一直很看重你这个得意弟子。",
            "nextDialogs": [
              "735060208"
            ]
          },
          "735060208": {
            "id": "735060208",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "丽莎，你离开教令院，实在是件非常可惜的事情。",
            "nextDialogs": [
              "735060209"
            ]
          },
          "735060209": {
            "id": "735060209",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "以你的聪明才智，如果当初留在教令院的话，现在都能拿下诃般荼的位置了。",
            "nextDialogs": [
              "735060212"
            ]
          },
          "735060212": {
            "id": "735060212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我没听错吧，那不是西风骑士团的图书管理员丽莎小姐吗？",
            "nextDialogs": [
              "735060213"
            ]
          },
          "735060213": {
            "id": "735060213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我听说，丽莎好像曾经在须弥教令院学习过，不过那都是过去的事了，现在丽莎到这里是要做什么呢？",
            "nextDialogs": [
              "735060214"
            ]
          },
          "735060214": {
            "id": "735060214",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "我猜得没错的话，你是想旧话重提，拉我回来？",
            "nextDialogs": [
              "735060215"
            ]
          },
          "735060215": {
            "id": "735060215",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "呵呵，我听说你现在是在蒙德的西风骑士团里担任图书管理员？要我说，真的是屈才了。",
            "nextDialogs": [
              "735060216"
            ]
          },
          "735060216": {
            "id": "735060216",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "何必浪费自己的时间，去为保管图书这种小事劳心费神呢，你的时间明明是最宝贵的东西。",
            "nextDialogs": [
              "735060217"
            ]
          },
          "735060217": {
            "id": "735060217",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "只要你肯回到学院来，立刻就能有大把项目供你主持，现在正是学院需要用人的时候，有些重要项目…",
            "nextDialogs": [
              "735060218"
            ]
          },
          "735060218": {
            "id": "735060218",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "哈…所以说来说去，还是想拉我回去咯，居勒什老师应该不知道你这么做吧。",
            "nextDialogs": [
              "735060219"
            ]
          },
          "735060219": {
            "id": "735060219",
            "speakerId": 1003,
            "speakerName": "加福尔",
            "text": "实际上，恩师他早就有心叫你回来参与院内的工作了。",
            "nextDialogs": [
              "735060220"
            ]
          },
          "735060220": {
            "id": "735060220",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "…哦是吗？加福尔老师，欺骗他人可不是好做法哦。",
            "nextDialogs": [
              "735060221"
            ]
          },
          "735060221": {
            "id": "735060221",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "我为什么只在学院里待了两年就离开了，老师他是最清楚的，所以他绝对不会提出这种要求。",
            "nextDialogs": [
              "735060222"
            ]
          },
          "735060222": {
            "id": "735060222",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "放弃蒙德的生活，以素论派学者的身份重回教令院么…求取智慧所需要的代价我自己已经再也支付不起了。",
            "nextDialogs": [
              "735060223"
            ]
          },
          "735060223": {
            "id": "735060223",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "所以啊，就别再挖空心思拉我回去了。",
            "nextDialogs": [
              "735060224"
            ]
          },
          "735060224": {
            "id": "735060224",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，原来丽莎曾经是素论派的学者吗？从来都没听她本人提过啊。"
          }
        }
      }
    },
    {
      "subId": "7350604",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735060401"
        ],
        "dialogs": {
          "735060401": {
            "id": "735060401",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "我记得，刚才你们和加福尔师兄约定好了，要去无郁稠林和他接洽地脉调研工作。",
            "nextDialogs": [
              "735060402"
            ]
          },
          "735060402": {
            "id": "735060402",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "你们要是这就打算去找他可以先离开哦。至于我，应该还会在普斯帕咖啡馆里坐一会儿吧。"
          }
        }
      }
    },
    {
      "subId": "7350621",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735062101"
        ],
        "dialogs": {
          "735062101": {
            "id": "735062101",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "这样啊…原来他们竟然执着到了这个地步，甚至想要超越神明…",
            "nextDialogs": [
              "735062102"
            ]
          },
          "735062102": {
            "id": "735062102",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "看来，在我不知道的时候，你们又被卷入了不得了的事里。",
            "nextDialogs": [
              "735062103"
            ]
          },
          "735062103": {
            "id": "735062103",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "但就算是这种程度的危机，最后也还是被你们顺利解决了，小可爱，你的能力还真是不可估量。",
            "nextDialogs": [
              "735062104"
            ]
          },
          "735062104": {
            "id": "735062104",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "完成了这样的壮举，现在的你应该有许多后事要处理吧，原本我还想邀你们一起在须弥四处逛逛…"
          }
        }
      }
    },
    {
      "subId": "7350622",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735062201"
        ],
        "dialogs": {
          "735062201": {
            "id": "735062201",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "这样啊…你们原本是打算向智慧之神小吉祥草王打听情报，才会来到须弥的。",
            "nextDialogs": [
              "735062202"
            ]
          },
          "735062202": {
            "id": "735062202",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "比起我这个游客，你们的事似乎紧迫得多呢。",
            "nextDialogs": [
              "735062203"
            ]
          },
          "735062203": {
            "id": "735062203",
            "speakerId": 1002,
            "speakerName": "丽莎",
            "text": "原本我还想一起在须弥四处逛逛，这样看来，好像现在并不是合适的时机。"
          }
        }
      }
    }
  ]
}
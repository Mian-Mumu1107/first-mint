          },
          "731580102": {
            "id": "731580102",
            "speakerId": 1000,
            "speakerName": "吉亚斯·海亚姆的病历表",
            "text": "「…症状：…短期性记忆障碍，随时间而逐渐恶化；情绪不稳定，反复提及青少年与童年的旧事…」",
            "nextDialogs": [
              "731580103"
            ]
          },
          "731580103": {
            "id": "731580103",
            "speakerId": 1000,
            "speakerName": "吉亚斯·海亚姆的病历表",
            "text": "「…未明病因的脑部疾病。根据脑部检查，患者自60岁起，脑细胞持续失活死亡，导致记忆机能逐渐丧失…」",
            "nextDialogs": [
              "731580104"
            ]
          },
          "731580104": {
            "id": "731580104",
            "speakerId": 1000,
            "speakerName": "吉亚斯·海亚姆的病历表",
            "text": "「…向教令院生论派学院申请退休，以期安稳舒适的生活与心理环境能减缓患者病情恶化情况…」",
            "nextDialogs": [
              "731580105"
            ]
          },
          "731580105": {
            "id": "731580105",
            "speakerId": 1000,
            "speakerName": "吉亚斯·海亚姆的病历表",
            "text": "「…生论派学院下达通知，贤者熙蔓·法罗赫扎德将亲自保证该患者的治疗工作展开…」"
          }
        }
      }
    }

    {
      "subId": "4000202",
      "subQuestName": "前往霄市$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400020201"
        ],
        "dialogs": {
          "400020201": {
            "id": "400020201",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "喔，是你们啊，感谢你们来为海灯节捐赠物资。$UNRELEASED",
            "nextDialogs": [
              "400020202"
            ]
          },
          "400020202": {
            "id": "400020202",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "说起来，今天其实有一件「捐赠」以外的事…嗯，具体来说是「收购」，你们感兴趣吗？$UNRELEASED",
            "nextDialogs": [
              "400020203"
            ]
          },
          "400020203": {
            "id": "400020203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？这次不是无偿的吗？那我很感兴趣！$UNRELEASED",
            "nextDialogs": [
              "400020204"
            ]
          },
          "400020204": {
            "id": "400020204",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "哈哈，那就拜托你们了，事情是这样的…$UNRELEASED",
            "nextDialogs": [
              "400020205"
            ]
          },
          "400020205": {
            "id": "400020205",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "我们为了操办节日事宜，需要两种特殊的「浮生石」。$UNRELEASED",
            "nextDialogs": [
              "400020206"
            ]
          },
          "400020206": {
            "id": "400020206",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "一种叫做「岚生石」，在天衡山北部偶尔会有发现记录。$UNRELEASED",
            "nextDialogs": [
              "400020207"
            ]
          },
          "400020207": {
            "id": "400020207",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "根系下埋藏着岚生石的普通灌木，有时会变异成「蓬蓬果」，让种子浮空。$UNRELEASED",
            "nextDialogs": [
              "400020208"
            ]
          },
          "400020208": {
            "id": "400020208",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "另一种叫做「霞生石」，它对一般人来说非常危险…$UNRELEASED",
            "nextDialogs": [
              "400020209"
            ]
          },
          "400020209": {
            "id": "400020209",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "在归离原，失去飞行动力的老旧「遗迹猎者」，会靠「霞生石」维持自己的飞行能力。$UNRELEASED",
            "nextDialogs": [
              "400020210"
            ]
          },
          "400020210": {
            "id": "400020210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "了解！「岚生石」和「霞生石」是吧？$UNRELEASED",
            "nextDialogs": [
              "400020211"
            ]
          },
          "400020211": {
            "id": "400020211",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "（其实就是红色和蓝色的浮生石啦…好听的名字都是宝石商人故意起的…）$UNRELEASED",
            "nextDialogs": [
              "400020212"
            ]
          },
          "400020212": {
            "id": "400020212",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "没错，就拜托你们把它们带回来了。要加油喔。$UNRELEASED"
          }
        }
      }
    },
    {

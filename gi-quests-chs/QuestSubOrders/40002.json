    {
      "subId": "4000215",
      "subQuestName": "与千岩军守卫对话$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400021501"
        ],
        "dialogs": {
          "400021501": {
            "id": "400021501",
            "speakerId": 1003,
            "speakerName": "嘉义",
            "text": "请留步，前方是璃月总务司。$UNRELEASED",
            "nextDialogs": [
              "400021502"
            ]
          },
          "400021502": {
            "id": "400021502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们是来举报可疑人士形迹的。$UNRELEASED",
            "nextDialogs": [
              "400021503"
            ]
          },
          "400021503": {
            "id": "400021503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们在明霄灯的易燃材料堆放现场，看到了鬼鬼祟祟的人！$UNRELEASED",
            "nextDialogs": [
              "400021504"
            ]
          },
          "400021504": {
            "id": "400021504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "绝对不能让做出「中原杂碎」的小摊就这么没了！$UNRELEASED",
            "nextDialogs": [
              "400021505"
            ]
          },
          "400021505": {
            "id": "400021505",
            "speakerId": 1003,
            "speakerName": "嘉义",
            "text": "啊，这可是件大事。$UNRELEASED",
            "nextDialogs": [
              "400021506"
            ]
          },
          "400021506": {
            "id": "400021506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对吧对吧。璃月港的美食可是城市的神髓——$UNRELEASED",
            "nextDialogs": [
              "400021507"
            ]
          },
          "400021507": {
            "id": "400021507",
            "speakerId": 1003,
            "speakerName": "嘉义",
            "text": "呃，我们说的应该不是同一件「大事」。不过小家伙你说得也没错。$UNRELEASED",
            "nextDialogs": [
              "400021508"
            ]
          },
          "400021508": {
            "id": "400021508",
            "speakerId": 1003,
            "speakerName": "嘉义",
            "text": "具体情况我知道了，我会向上峰如实转达的。$UNRELEASED",
            "nextDialogs": [
              "400021509"
            ]
          },
          "400021509": {
            "id": "400021509",
            "speakerId": 1003,
            "speakerName": "嘉义",
            "text": "谢谢你们的消息。$UNRELEASED",
            "nextDialogs": [
              "400021510"
            ]
          },
          "400021510": {
            "id": "400021510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一定一定，要严肃对待哦。$UNRELEASED"
          }
        }
      }
    }

    {
      "subId": "4000207",
      "subQuestName": "(test)与派蒙对话（隐藏）$UNRELEASED$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400020701"
        ],
        "dialogs": {
          "400020701": {
            "id": "400020701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？那边有个家伙，鬼鬼祟祟的…"
          }
        }
      }
    },
    {
      "subId": "4000208",
      "subQuestName": "与可疑人士对话$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400020801"
        ],
        "dialogs": {
          "400020801": {
            "id": "400020801",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "干什么？",
            "nextDialogs": [
              "400020802"
            ]
          },
          "400020802": {
            "id": "400020802",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "有什么好看的？走开，走开！",
            "nextDialogs": [
              "400020803"
            ]
          },
          "400020803": {
            "id": "400020803",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "400020804"
            ]
          },
          "400020804": {
            "id": "400020804",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "算了，你们不走，我走…",
            "nextDialogs": [
              "400020805"
            ]
          },
          "400020805": {
            "id": "400020805",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…这个鬼鬼祟祟的人…说起话来也是鬼鬼祟祟的…",
            "nextDialogs": [
              "400020806"
            ]
          },
          "400020806": {
            "id": "400020806",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "刚才他蹲在地上，好像在做什么事。但一看到我们靠近，就站起来装成没事人一样…",
            "nextDialogs": [
              "400020807"
            ]
          },
          "400020807": {
            "id": "400020807",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我有不好的预感。",
            "nextDialogs": [
              "400020808"
            ]
          },
          "400020808": {
            "id": "400020808",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那个人究竟在做什么？我们在周围调查一下，找找线索吧。"
          }
        }
      }
    },
    {
      "subId": "4000209",
      "subQuestName": "(test)在材料堆放区调查$UNRELEASED$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400020901"
        ],
        "dialogs": {
          "400020901": {
            "id": "400020901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你看这里。",
            "nextDialogs": [
              "400020902"
            ]
          },
          "400020902": {
            "id": "400020902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这附近都是建造「明霄灯」用的纸、油和木材…"
          }
        }
      }
    },
    {
      "subId": "4000210",
      "subQuestName": "(test)在材料区调查$UNRELEASED$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400021001"
        ],
        "dialogs": {
          "400021001": {
            "id": "400021001",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "在海灯节的最后一天，会有很多很多人来看「明霄灯」放飞。$UNRELEASED",
            "nextDialogs": [
              "400021002"
            ]
          },
          "400021002": {
            "id": "400021002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "在这么危险的地方出现可疑人物，我觉得一定没有好事。$UNRELEASED",
            "nextDialogs": [
              "400021003"
            ]
          },
          "400021003": {
            "id": "400021003",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "如果他在堆放的易燃材料里，做了什么手脚…$UNRELEASED",
            "nextDialogs": [
              "400021401"
            ]
          },
          "400021401": {
            "id": "400021401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来必须得依靠官家的力量了！赶紧去璃月的「总务司」，汇报这件事情吧。$UNRELEASED",
            "nextDialogs": [
              "400021406"
            ]
          },
          "400021406": {
            "id": "400021406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么感觉派蒙对这件事这么上心？$UNRELEASED",
            "nextDialogs": [
              "400021407"
            ]
          },
          "400021407": {
            "id": "400021407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那，那是…璃月大家一起努力的成果啊！绝对不允许捣乱行为！$UNRELEASED",
            "nextDialogs": [
              "400021408"
            ]
          },
          "400021408": {
            "id": "400021408",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说实话。$UNRELEASED",
            "nextDialogs": [
              "400021409"
            ]
          },
          "400021409": {
            "id": "400021409",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "码头附近的「中原杂碎」是真的好，吃过一次忘不了。$UNRELEASED",
            "nextDialogs": [
              "400021410"
            ]
          },
          "400021410": {
            "id": "400021410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在复读摊主的吆喝吗…$UNRELEASED",
            "nextDialogs": [
              "400021411"
            ]
          },
          "400021411": {
            "id": "400021411",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸嘿嘿。$UNRELEASED"
          }
        }
      }
    },
    {
      "subId": "4000211",
      "subQuestName": "(test)在材料区调查$UNRELEASED$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

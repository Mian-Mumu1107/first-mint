    {
      "subId": "4000205",
      "subQuestName": "回到霄市，与慧心对话$UNRELEASED",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400020501"
        ],
        "dialogs": {
          "400020501": {
            "id": "400020501",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "啊，这是…「岚生石」和「霞生石」，品质都很不错！$UNRELEASED",
            "nextDialogs": [
              "400020502"
            ]
          },
          "400020502": {
            "id": "400020502",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "谢谢你们！这是报酬。$UNRELEASED",
            "nextDialogs": [
              "400020503"
            ]
          },
          "400020503": {
            "id": "400020503",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "你们的每一次努力所得，都会为海灯节增光添彩。$UNRELEASED",
            "nextDialogs": [
              "400020504"
            ]
          },
          "400020504": {
            "id": "400020504",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "对了，既然在海灯节期间来璃月旅行，不如多关注一下「明霄灯」的变化吧。$UNRELEASED",
            "nextDialogs": [
              "400020505"
            ]
          },
          "400020505": {
            "id": "400020505",
            "speakerId": 1000,
            "speakerName": "慧心",
            "text": "随着进度推进，码头上的建设工地，会有越来越值得一看的风景。$UNRELEASED",
            "nextDialogs": [
              "400020506"
            ]
          },
          "400020506": {
            "id": "400020506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#听起来很有趣，{NICKNAME}，我们现在就过去看看吗？$UNRELEASED"
          }
        }
      }
    },
    {
      "subId": "4000206",
      "subQuestName": "去建设工地看看$UNRELEASED",
      "sceneId": null,

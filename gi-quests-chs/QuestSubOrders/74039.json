      }
    },
    {
      "subId": "7403906",
      "subQuestName": "与薇蕾娜妲对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740390701"
        ],
        "dialogs": {
          "740390701": {
            "id": "740390701",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "#{NICKNAME}！你还好吗？你还好吗！",
            "nextDialogs": [
              "740390702"
            ]
          },
          "740390702": {
            "id": "740390702",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "呜…对不起，对不起…薇蕾娜妲不知道药剂会引来怪东西…",
            "nextDialogs": [
              "740390704",
              "740390711"
            ]
          },
          "740390704": {
            "id": "740390704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…是这个原因吗！",
            "nextDialogs": [
              "740390705"
            ]
          },
          "740390705": {
            "id": "740390705",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "哇…对哦，因为水生动物会把暖洋洋的东西误以为是太阳光，于是受它吸引。所以说…药剂成功了！谢谢你！谢谢你们！",
            "nextDialogs": [
              "740390706"
            ]
          },
          "740390706": {
            "id": "740390706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…虽然我觉得不是这个道理…",
            "nextDialogs": [
              "740390707"
            ]
          },
          "740390707": {
            "id": "740390707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "水生动物…？不是火史莱姆吗？",
            "nextDialogs": [
              "740390708"
            ]
          },
          "740390708": {
            "id": "740390708",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "这样吗…嗯，致幻作用…好的，记下来了！也不是全无作用嘛…但是…",
            "nextDialogs": [
              "740390709"
            ]
          },
          "740390709": {
            "id": "740390709",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是作用很不妙！今天把大螃蟹看成火史莱姆，明天如果是更危险的怪物怎么办啦！",
            "nextDialogs": [
              "740390720"
            ]
          },
          "740390720": {
            "id": "740390720",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "嗯…薇蕾娜妲已经麻烦了你们好多好多，但还有最后一样药需要实验…那个，你们还愿意吗？"
          },
          "740390711": {
            "id": "740390711",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哼哼，不对不对！明明是{NICKNAME}很强！",
            "nextDialogs": [
              "740390712"
            ]
          },
          "740390712": {
            "id": "740390712",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "唔，不过等等…你刚刚说「火史莱姆」…？",
            "nextDialogs": [
              "740390713"
            ]
          },
          "740390713": {
            "id": "740390713",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对哦…明明我们只看见了好多螃蟹呢！"
          }
        }
      }
    },
    {
      "subId": "7403907",
      "subQuestName": "前往薇蕾娜妲的工棚",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7403908",
      "subQuestName": "与薇蕾娜妲对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740390801"
        ],
        "dialogs": {
          "740390801": {
            "id": "740390801",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "这里，这里就是实验工棚啦！",
            "nextDialogs": [
              "740390802"
            ]
          },
          "740390802": {
            "id": "740390802",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "嗯，那么接下来要试验的是「真视药剂」，准备好了吗？",
            "nextDialogs": [
              "740390803"
            ]
          },
          "740390803": {
            "id": "740390803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我准备好了。",
            "nextDialogs": [
              "740390804"
            ]
          },
          "740390804": {
            "id": "740390804",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…一定要小心呀…",
            "nextDialogs": [
              "740390805"
            ]
          },
          "740390805": {
            "id": "740390805",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "你从薇蕾娜妲手中接过药剂，闻起来就像阳光下腐烂许久的已死海草，令人不禁喉头作呕…\\n你犹豫了半刻，将之一饮而尽。药液却并不难喝，准确来说，缺少任何可以分辨的口味…\\n除此之外，你的身体再无其他反应。",
            "nextDialogs": [
              "740390806"
            ]
          },
          "740390806": {
            "id": "740390806",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "然后，在薇蕾娜妲指示下，你休憩了一段时间，并没有发生什么变化。",
            "nextDialogs": [
              "740390807"
            ]
          },
          "740390807": {
            "id": "740390807",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "但是，不久后…",
            "nextDialogs": [
              "740390808"
            ]
          },
          "740390808": {
            "id": "740390808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看样子还是没什么变化呢…呼，幸好不用操心啦…",
            "nextDialogs": [
              "740390809"
            ]
          },
          "740390809": {
            "id": "740390809",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "#嗯，不过…{NICKNAME}刚刚愣了一下？怎么了？看到什么了吗？",
            "nextDialogs": [
              "740390810"
            ]
          },
          "740390810": {
            "id": "740390810",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我看到了…半截半透明的船？",
            "nextDialogs": [
              "740390811"
            ]
          },
          "740390811": {
            "id": "740390811",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "嗯？有意思！但是…唔…还有更详细的描述吗？",
            "nextDialogs": [
              "740390813",
              "740390816"
            ]
          },
          "740390813": {
            "id": "740390813",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "#很有趣，嗯！…但不能作为药效的具体证明…因为{NICKNAME}无法证明是不是把远处的礁石或者船骸看成了「幽灵船」…",
            "nextDialogs": [
              "740390814"
            ]
          },
          "740390814": {
            "id": "740390814",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "所以…唉，这次试验还是没有成果呢。",
            "nextDialogs": [
              "740390818"
            ]
          },
          "740390818": {
            "id": "740390818",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "谢谢你们，这次收集到了不得了的笔记！一定可以用在下一次配药中的！",
            "nextDialogs": [
              "740390819"
            ]
          },
          "740390819": {
            "id": "740390819",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "唔嗯…「虽然听到了很熟悉的说法…」嗯，「但仍旧需要多加考察，调查是否有其他人目睹该种迹象」…",
            "nextDialogs": [
              "740390820"
            ]
          },
          "740390820": {
            "id": "740390820",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…也就是说，你还要找别人试药呀？",
            "nextDialogs": [
              "740390821"
            ]
          },
          "740390821": {
            "id": "740390821",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "嗯，没错。因为…唔…只有找到两个以上可靠的目击者，我们才能确认药剂真的能让人看到「真实的东西」呀？",
            "nextDialogs": [
              "740390822"
            ]
          },
          "740390822": {
            "id": "740390822",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "因为「真实」的东西不会受到目光与思绪的束缚，不会因一个人的心而扭曲变形…而是一直一直存在在那里，就那样存在着。",
            "nextDialogs": [
              "740390823"
            ]
          },
          "740390823": {
            "id": "740390823",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…就像…能活好几千岁的神那样？",
            "nextDialogs": [
              "740390824"
            ]
          },
          "740390824": {
            "id": "740390824",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "……",
            "nextDialogs": [
              "740390825"
            ]
          },
          "740390825": {
            "id": "740390825",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "不，就像白色的细砂，海星的尸骸，摇呀摇的波浪那样…这些才是「真实」的。",
            "nextDialogs": [
              "740390826"
            ]
          },
          "740390826": {
            "id": "740390826",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "但药剂师大人也说过…经由梦和回忆，也能创造出新的「真实」。这个，自相矛盾的说法，薇蕾娜妲不懂…但正在努力弄懂。",
            "nextDialogs": [
              "740390827"
            ]
          },
          "740390827": {
            "id": "740390827",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇…话题突然变得好深奥…",
            "nextDialogs": [
              "740390828"
            ]
          },
          "740390828": {
            "id": "740390828",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "哈哈，那就不聊深奥的话题啦！总之，薇蕾娜妲谢谢你们帮忙！请收下这些！",
            "nextDialogs": [
              "740390829"
            ]
          },
          "740390829": {
            "id": "740390829",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "嗯…还有，下次调配出新药剂时，也请你们一定要来呀！"
          },
          "740390816": {
            "id": "740390816",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "……",
            "nextDialogs": [
              "740390817"
            ]
          },
          "740390817": {
            "id": "740390817",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "啊，对不起！刚刚…有点走神了。但…但薇蕾娜妲把刚刚的信息记下来了，谢谢你！"
          }
        }
      }
    },
    {
      "subId": "7403901",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740390101"
        ],
        "dialogs": {
          "740390101": {
            "id": "740390101",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "唔…风干汐藻糊糊，幽光星星的腌制内脏，再加上…嗯，「少许」…啊啊，「少许」是多少嘛…",
            "nextDialogs": [
              "740390102"
            ]
          },
          "740390102": {
            "id": "740390102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，这是在熬什么汤吗…？唔！气味好奇怪…！",
            "nextDialogs": [
              "740390103"
            ]
          },
          "740390103": {
            "id": "740390103",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "嗯？奇怪？不应该呀…明明是按照卡莉珀丝大人的药方调配的，气味应该很正常才对…",
            "nextDialogs": [
              "740390105",
              "740390107"
            ]
          },
          "740390105": {
            "id": "740390105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，我眼前已经有画面了…",
            "nextDialogs": [
              "740390108"
            ]
          },
          "740390108": {
            "id": "740390108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总、总之，你在做什么啦？呃…需要我们帮忙吗？",
            "nextDialogs": [
              "740390109"
            ]
          },
          "740390109": {
            "id": "740390109",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "药剂哦，薇蕾娜妲在配制药剂…能帮助很多很多人的药剂。",
            "nextDialogs": [
              "740390110"
            ]
          },
          "740390110": {
            "id": "740390110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦…所以…所以你是个药剂师？",
            "nextDialogs": [
              "740390111"
            ]
          },
          "740390111": {
            "id": "740390111",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "薇蕾娜妲还不是药剂师大人哦，药剂师大人的助手才对。药剂师大人是了不起的卡莉珀丝，薇蕾娜妲还有很多要学的呢。",
            "nextDialogs": [
              "740390112"
            ]
          },
          "740390112": {
            "id": "740390112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，给了不起的医师做助手，也是了不起的助手嘛！",
            "nextDialogs": [
              "740390113"
            ]
          },
          "740390113": {
            "id": "740390113",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "嘿嘿…嗯…呃，不是、不是！",
            "nextDialogs": [
              "740390114"
            ]
          },
          "740390114": {
            "id": "740390114",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "没有啦…薇蕾娜妲还有很多不知道的事，只是在努力为药剂师大人配药而已。",
            "nextDialogs": [
              "740390115"
            ]
          },
          "740390115": {
            "id": "740390115",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "那个，那个…薇蕾娜妲告诉了你们名字，但还不知道你们叫什么呢？",
            "nextDialogs": [
              "740390116"
            ]
          },
          "740390116": {
            "id": "740390116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我是派蒙，{M#他}{F#她}叫{NICKNAME}。",
            "nextDialogs": [
              "740390117"
            ]
          },
          "740390117": {
            "id": "740390117",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "「派蒙」，好听的名字，像白色的小水母一样，吵吵闹闹的。",
            "nextDialogs": [
              "740390118"
            ]
          },
          "740390118": {
            "id": "740390118",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "#{NICKNAME}，有点奇怪的名字，金灿灿的，但很友好。很高兴见到你们！",
            "nextDialogs": [
              "740390119"
            ]
          },
          "740390119": {
            "id": "740390119",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "那个…你们问需不需要帮忙，薇蕾娜妲需要帮忙，但不知道你们愿不愿意…",
            "nextDialogs": [
              "740390120"
            ]
          },
          "740390120": {
            "id": "740390120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请尽管说吧。",
            "nextDialogs": [
              "740390121"
            ]
          },
          "740390121": {
            "id": "740390121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，需要我们帮什么忙，直接说出来就好啦！",
            "nextDialogs": [
              "740390122"
            ]
          },
          "740390122": {
            "id": "740390122",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "薇蕾娜妲想要你们试一试…新调配出来的药剂。",
            "nextDialogs": [
              "740390123"
            ]
          },
          "740390123": {
            "id": "740390123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…？",
            "nextDialogs": [
              "740390124"
            ]
          },
          "740390124": {
            "id": "740390124",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "薇蕾娜妲知道药不好闻，不好喝…但能帮助很多很多人，能治好很多很多病，所以很有用。",
            "nextDialogs": [
              "740390125"
            ]
          },
          "740390125": {
            "id": "740390125",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "但我们不会得病，也不喜欢喝怪东西…时间长了，就没人帮薇蕾娜妲试药了，所以很苦恼。",
            "nextDialogs": [
              "740390126"
            ]
          },
          "740390126": {
            "id": "740390126",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…你自己都说是怪东西了，不会很危险吗！",
            "nextDialogs": [
              "740390127"
            ]
          },
          "740390127": {
            "id": "740390127",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "没关系的，我们不会中毒。呃…所以，理论上，你们也不会中毒吧…嗯，理论上啦。",
            "nextDialogs": [
              "740390128"
            ]
          },
          "740390128": {
            "id": "740390128",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "需要测试的药…嗯，一共有三种。一种能让人变得很厉害，很能打！一种能让人很温暖。还有一种…嗯…",
            "nextDialogs": [
              "740390129"
            ]
          },
          "740390129": {
            "id": "740390129",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "薇蕾娜妲也说不太清楚…卡莉珀丝大人说，能让人洞悉「真实」。她是这么说的啦，可是薇蕾娜妲不太懂…",
            "nextDialogs": [
              "740390130"
            ]
          },
          "740390130": {
            "id": "740390130",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来还是很危险…",
            "nextDialogs": [
              "740390131"
            ]
          },
          "740390131": {
            "id": "740390131",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "不危险的，不危险的…那个，你们愿意帮忙吗？如果愿意帮忙的话，薇蕾娜妲这就带你们去那里！"
          },
          "740390107": {
            "id": "740390107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，那也太不对劲啦！"
          }
        }
      }
    },
    {
      "subId": "7403904",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740390401"
        ],
        "dialogs": {
          "740390401": {
            "id": "740390401",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "你们回来啦！要帮忙吗？准备好要试药了吗？"
          }
        }
      }
    },
    {
      "subId": "7403910",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740391001"
        ],
        "dialogs": {
          "740391001": {
            "id": "740391001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我还没准备好。",
            "nextDialogs": [
              "740391002"
            ]
          },
          "740391002": {
            "id": "740391002",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "没关系，薇蕾娜妲会在这里等。"
          }
        }
      }
    },
    {
      "subId": "7403911",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740391101"
        ],
        "dialogs": {
          "740391101": {
            "id": "740391101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，我们去试药吧。",
            "nextDialogs": [
              "740391102"
            ]
          },
          "740391102": {
            "id": "740391102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我也去，会在一边盯着的！"
          }
        }
      }
    },
    {
      "subId": "7403912",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740391201"
        ],
        "dialogs": {
          "740391201": {
            "id": "740391201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我还要再考虑一下。",
            "nextDialogs": [
              "740391202"
            ]
          },
          "740391202": {
            "id": "740391202",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "药快凉了呢…不过没关系，薇蕾娜妲还会耐心等的！"
          }
        }
      }
    },
    {
      "subId": "7403999",

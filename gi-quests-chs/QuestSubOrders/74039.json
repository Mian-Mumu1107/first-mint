      }
    },
    {
      "subId": "7403904",
      "subQuestName": "与薇蕾娜妲对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740390601"
        ],
        "dialogs": {
          "740390601": {
            "id": "740390601",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "#所、所以，刚刚{NICKNAME}咻咻地就打败了怪物，是因为「超厉害药水」的效力吗？",
            "nextDialogs": [
              "740390603",
              "740390606"
            ]
          },
          "740390603": {
            "id": "740390603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么蹩脚的广告词啦…",
            "nextDialogs": [
              "740390604"
            ]
          },
          "740390604": {
            "id": "740390604",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "哇！谢谢！谢谢你们！果然是药效的原因，真不愧是药剂师大人的配方！",
            "nextDialogs": [
              "740390609"
            ]
          },
          "740390609": {
            "id": "740390609",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "嗯，好，「超厉害药水」的试验告一段落！接下来，我们开始试验…这个！「暖洋洋药水」吧！",
            "nextDialogs": [
              "740390610"
            ]
          },
          "740390610": {
            "id": "740390610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，这些名字都是你自己起的吗？",
            "nextDialogs": [
              "740390611"
            ]
          },
          "740390611": {
            "id": "740390611",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "不是啦，薇蕾娜妲不会取名字，所以只能让别人帮忙起笨笨的名字…",
            "nextDialogs": [
              "740390612"
            ]
          },
          "740390612": {
            "id": "740390612",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也不要这么说啦…对于药水来说，一看就知道作用的名字才是好名字呢。你看，是这个道理没错吧？",
            "nextDialogs": [
              "740390613"
            ]
          },
          "740390613": {
            "id": "740390613",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "第一次听到的道理呢…不过没错，药剂师大人就是这样的！",
            "nextDialogs": [
              "740390614"
            ]
          },
          "740390614": {
            "id": "740390614",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "#咳咳，别的不说啦！{NICKNAME}，你准备好试这瓶药了吗？",
            "nextDialogs": [
              "740390615"
            ]
          },
          "740390615": {
            "id": "740390615",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，我们开始吧。",
            "nextDialogs": [
              "740390616"
            ]
          },
          "740390616": {
            "id": "740390616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，这瓶闻起来也好不妙…",
            "nextDialogs": [
              "740390617"
            ]
          },
          "740390617": {
            "id": "740390617",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "这瓶「暖洋洋药水」，理论上可以让你不怕寒冷，变得暖洋洋的！唔…理论上啦。",
            "nextDialogs": [
              "740390618"
            ]
          },
          "740390618": {
            "id": "740390618",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "你从薇蕾娜妲手中接过药剂，闻起来像是积满了灰尘的发霉老皮革…\\n你犹豫了半刻，一饮而尽。药液却并不难喝，带着肉桂的香味与些许姜汁的辛辣…令你回想起雨天书房里劈啪作响的壁炉。\\n除此之外，你的身体再无其他反应。",
            "nextDialogs": [
              "740390619"
            ]
          },
          "740390619": {
            "id": "740390619",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "然后，在薇蕾娜妲指示下，你休憩了一段时间。"
          },
          "740390606": {
            "id": "740390606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？！可是…明明闻起来那么刺鼻…",
            "nextDialogs": [
              "740390607"
            ]
          },
          "740390607": {
            "id": "740390607",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "唔…这样吗？是哪里搞错了呢…",
            "nextDialogs": [
              "740390608"
            ]
          },
          "740390608": {
            "id": "740390608",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你也不用消沉啦…反正，唔，反正不难喝也没有毒，就已经是胜利啦！"
          }
        }
      }
    },
    {
      "subId": "7403905",
      "subQuestName": "击败怪物",
      "sceneId": null,
      "locations": [],
      "dialogue": {

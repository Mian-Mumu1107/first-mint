  "subQuests": [
    {
      "subId": "7403901",
      "subQuestName": "（test）接取环（隐藏）$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740390901"
        ],
        "dialogs": {
          "740390901": {
            "id": "740390901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会帮忙的，我们走吧。",
            "nextDialogs": [
              "740390902"
            ]
          },
          "740390902": {
            "id": "740390902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，你可不要把自己喝出好歹啦！"
          }
        }
      }
    },
    {
      "subId": "7403902",
      "subQuestName": "与薇蕾娜妲对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740390501"
        ],
        "dialogs": {
          "740390501": {
            "id": "740390501",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "薇蕾娜妲感谢你们能来帮忙！现在我们试试第一种药吧！",
            "nextDialogs": [
              "740390502"
            ]
          },
          "740390502": {
            "id": "740390502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，不要喝太多呀！感觉不对就赶快吐出来！",
            "nextDialogs": [
              "740390503"
            ]
          },
          "740390503": {
            "id": "740390503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好啦，我没事的，派蒙。",
            "nextDialogs": [
              "740390504"
            ]
          },
          "740390504": {
            "id": "740390504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼…我就是放不下心嘛…",
            "nextDialogs": [
              "740390505"
            ]
          },
          "740390505": {
            "id": "740390505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我准备好了，把药剂给我吧。",
            "nextDialogs": [
              "740390506"
            ]
          },
          "740390506": {
            "id": "740390506",
            "speakerId": 5305,
            "speakerName": "薇蕾娜妲",
            "text": "这瓶叫做「超厉害药水」，理论上能让你变得超厉害！嗯…理论上啦。",
            "nextDialogs": [
              "740390507"
            ]
          },
          "740390507": {
            "id": "740390507",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "你从薇蕾娜妲手中接过药剂，一饮而尽。\\n尽管气味刺鼻难忍，但令人意外的是，药液口感清甜粘滞，并不难喝。\\n除此之外，你的身体再无其他反应。",
            "nextDialogs": [
              "740390508"
            ]
          },
          "740390508": {
            "id": "740390508",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "然后，在薇蕾娜妲指示下，你们等到隙境原体活跃的时刻。"
          }
        }
      }
    },
    {
      "subId": "7403903",
      "subQuestName": "击败怪物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

  "subQuests": [
    {
      "subId": "7351001",
      "subQuestName": "与哈贾娜德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735100101"
        ],
        "dialogs": {
          "735100101": {
            "id": "735100101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈贾娜德，大功告成啦，来听我们的好消息吧！",
            "nextDialogs": [
              "735100102"
            ]
          },
          "735100102": {
            "id": "735100102",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "稍等，让我感受一下，你们身上「震沸装置」的信号。",
            "nextDialogs": [
              "735100103"
            ]
          },
          "735100103": {
            "id": "735100103",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "啊，这炽热的余温和充满磁性的回响，就像是炼金药剂在火中的合奏，让我兴奋得战栗…",
            "nextDialogs": [
              "735100104"
            ]
          },
          "735100104": {
            "id": "735100104",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "简直无懈可击！利用你们提供的数据，我一定能写出最完美的报告！",
            "nextDialogs": [
              "735100105"
            ]
          },
          "735100105": {
            "id": "735100105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的吗？我怎么什么都没感觉到？",
            "nextDialogs": [
              "735100106"
            ]
          },
          "735100106": {
            "id": "735100106",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "「白色高智能浮游助手单元」，你应该阅读一些…教令院学生深夜语录，拓展你的语言多样性机能！",
            "nextDialogs": [
              "735100107"
            ]
          },
          "735100107": {
            "id": "735100107",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "这样一来，你就能理解各种精妙的比喻了，幽默力和抗压力都能超级加倍。",
            "nextDialogs": [
              "735100108"
            ]
          },
          "735100108": {
            "id": "735100108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#才不要！根本听不懂啦，我哪来的什么压力，{NICKNAME}又不会要求我搞奇怪的研究！",
            "nextDialogs": [
              "735100109"
            ]
          },
          "735100109": {
            "id": "735100109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你不要支开话题哦，我们按照约定，帮你测试了装置。",
            "nextDialogs": [
              "735100110"
            ]
          },
          "735100110": {
            "id": "735100110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在，快乐的发薪时间到了！",
            "nextDialogs": [
              "735100111"
            ]
          },
          "735100111": {
            "id": "735100111",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "给你们给你们！难道你们还信不过我吗？",
            "nextDialogs": [
              "735100112"
            ]
          },
          "735100112": {
            "id": "735100112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？这就是五十人份的薪水吗？总感觉和想象的有点出入呢…",
            "nextDialogs": [
              "735100113"
            ]
          },
          "735100113": {
            "id": "735100113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…倒也不是嫌弃太少…",
            "nextDialogs": [
              "735100116"
            ]
          },
          "735100116": {
            "id": "735100116",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "咦？难道我攒了大半年的这笔钱还不够夸张吗！",
            "nextDialogs": [
              "735100117"
            ]
          },
          "735100117": {
            "id": "735100117",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "是我低估了佣兵们的赚钱能力？我给佣兵们计划的日薪，和导师每天给我的资金一样多呢！",
            "nextDialogs": [
              "735100118"
            ]
          },
          "735100118": {
            "id": "735100118",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "我的新导师出手超阔绰，跟着她以后，我每天都能享受一份烤肉卷大餐，资金还有盈余！",
            "nextDialogs": [
              "735100119"
            ]
          },
          "735100119": {
            "id": "735100119",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "如果在商店买一袋面粉，去野外摘些墩墩桃，打几桶河水一起煮成面糊…一天的资金就够我生活两周。",
            "nextDialogs": [
              "735100120"
            ]
          },
          "735100120": {
            "id": "735100120",
            "speakerId": 30226,
            "speakerName": "哈贾娜德",
            "text": "余下的钱都可以投入到「震沸合剂」的研究里，这次雇佣佣兵的预算就是这么来的！"
          }
        }
      }
    },
    {
      "subId": "7351099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735109901"
        ],
        "dialogs": {
          "735109901": {
            "id": "735109901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！这段时间我们好好测试了「震沸装置」，记录的数据应该差不多了。",
            "nextDialogs": [
              "735109902"
            ]
          },
          "735109902": {
            "id": "735109902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在就去找哈贾娜德，和她说说我们使用的体验吧！"
          }
        }
      }
    }
  ]
}
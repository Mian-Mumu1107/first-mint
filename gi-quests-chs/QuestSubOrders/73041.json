            ]
          },
          "730410503": {
            "id": "730410503",
            "speakerId": 4209,
            "speakerName": "兰难世",
            "text": "金色的那菈虽然厉害，更多还是兰梨娄太弱，兰难世就不会这么快被找到，哼，瞧着。"
          }

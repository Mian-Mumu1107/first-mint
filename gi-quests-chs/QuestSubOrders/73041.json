    {
      "subId": "7304104",
      "subQuestName": "找到兰难世！",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730410601"
        ],
        "dialogs": {
          "730410601": {
            "id": "730410601",
            "speakerId": 4209,
            "speakerName": "兰难世",
            "text": "哇！怎么会？",
            "nextDialogs": [
              "730410602"
            ]
          },
          "730410602": {
            "id": "730410602",
            "speakerId": 4208,
            "speakerName": "兰梨娄",
            "text": "兰难世也这么快被找到，跟兰梨娄一样弱！",
            "nextDialogs": [
              "730410603"
            ]
          },
          "730410603": {
            "id": "730410603",
            "speakerId": 4209,
            "speakerName": "兰难世",
            "text": "呜…都弱，只有金色的那菈强…",
            "nextDialogs": [
              "730410604"
            ]
          },
          "730410604": {
            "id": "730410604",
            "speakerId": 4208,
            "speakerName": "兰梨娄",
            "text": "这样下去可不行，要锻炼兰迦拉梨，有了很强的兰迦拉梨，那菈朋友一定就找不到了！",
            "nextDialogs": [
              "730410606",
              "730410608"
            ]
          },
          "730410606": {
            "id": "730410606",
            "speakerId": 4208,
            "speakerName": "兰梨娄",
            "text": "那菈朋友是不是怕输？玩游戏，不要在乎输赢！",
            "nextDialogs": [
              "730410609"
            ]
          },
          "730410609": {
            "id": "730410609",
            "speakerId": 4208,
            "speakerName": "兰梨娄",
            "text": "虽然输了，但是玩得开心，金色的那菈果然是好那菈。",
            "nextDialogs": [
              "730410610"
            ]
          },
          "730410610": {
            "id": "730410610",
            "speakerId": 4209,
            "speakerName": "兰难世",
            "text": "那菈朋友赢了。好厉害！收下我们的花吧！",
            "nextDialogs": [
              "730410611"
            ]
          },
          "730410611": {
            "id": "730410611",
            "speakerId": 4208,
            "speakerName": "兰梨娄",
            "text": "谢谢好那菈！你是好朋友！"
          },
          "730410608": {
            "id": "730410608",
            "speakerId": 4209,
            "speakerName": "兰难世",
            "text": "嗯！下次一定不会输了！"
          }
        }
      }
    },
    {
      "subId": "7304101",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730410101"
        ],
        "dialogs": {
          "730410101": {
            "id": "730410101",
            "speakerId": 4209,
            "speakerName": "兰难世",
            "text": "呀，是金色的那菈。",
            "nextDialogs": [
              "730410102"
            ]
          },
          "730410102": {
            "id": "730410102",
            "speakerId": 4208,
            "speakerName": "兰梨娄",
            "text": "那菈朋友，来和兰梨娄玩耍吧！兰难世，弱得很，不要和他玩。",
            "nextDialogs": [
              "730410103"
            ]
          },
          "730410103": {
            "id": "730410103",
            "speakerId": 4209,
            "speakerName": "兰难世",
            "text": "噗噗，上次兰梨娄输给兰难世，兰梨娄更弱。",
            "nextDialogs": [
              "730410104"
            ]
          },
          "730410104": {
            "id": "730410104",
            "speakerId": 4208,
            "speakerName": "兰梨娄",
            "text": "好哦，不要再管什么太阳月亮，正好那菈朋友在这里，我们和那菈朋友一起玩，比一比谁强谁弱。",
            "nextDialogs": [
              "730410105"
            ]
          },
          "730410105": {
            "id": "730410105",
            "speakerId": 4209,
            "speakerName": "兰难世",
            "text": "比就比，兰难世才不会怕。",
            "nextDialogs": [
              "730410106"
            ]
          },
          "730410106": {
            "id": "730410106",
            "speakerId": 4208,
            "speakerName": "兰梨娄",
            "text": "兰梨娄先躲，让那菈朋友来找。之后兰难世躲，那菈朋友找。先被找到的就输。",
            "nextDialogs": [
              "730410107"
            ]
          },
          "730410107": {
            "id": "730410107",
            "speakerId": 4208,
            "speakerName": "兰梨娄",
            "text": "那菈朋友，要不要来玩？准备好了的话，马上就开始！"
          }
        }
      }
    },

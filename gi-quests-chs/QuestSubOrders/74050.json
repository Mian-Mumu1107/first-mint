    {
      "subId": "7405021",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740501501"
        ],
        "dialogs": {
          "740501501": {
            "id": "740501501",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "你刚递出食物，「呜呜葡萄」就飞快地游到了你手边，毫不犹豫地将你手中的食物吞了下去。\\n你小心翼翼地摸了摸幼小的膨膨兽——膨膨兽的触感比你想象中要柔软得多，也温暖得多，摸上去几乎就像是软绵绵的毛绒玩具一般。",
            "nextDialogs": [
              "740501502"
            ]
          },
          "740501502": {
            "id": "740501502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，已经完全信任我们了呢！",
            "nextDialogs": [
              "740501503"
            ]
          },
          "740501503": {
            "id": "740501503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看样子，「呜呜葡萄」应该也快要长大了，好期待呀！",
            "nextDialogs": [
              "740501504"
            ]
          },
          "740501504": {
            "id": "740501504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们之后再回来看看它吧？"
          }
        }
      }
    },
    {

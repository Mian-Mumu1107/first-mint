          },
          "740502106": {
            "id": "740502106",
            "speakerId": 1003,
            "speakerName": "「呜呜葡萄」",
            "text": "（「呜呜葡萄」轻轻嗅了嗅你递过去的食物，温顺地低下了头，蹭了蹭你的手，似乎并不饿的样子…）",
            "nextDialogs": [
              "740502107"
            ]
          },
          "740502107": {
            "id": "740502107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#刚刚才喂过啦，现在应该还不饿吧？{NICKNAME}，我们过一段时间再回来吧！"
          }
        }

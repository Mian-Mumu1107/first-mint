  "subQuests": [
    {
      "subId": "51601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5160101"
        ],
        "dialogs": {
          "5160101": {
            "id": "5160101",
            "speakerId": 1000,
            "speakerName": "花见坂告示板",
            "text": "此乃幕府所设花见坂告示板，各种事务，尽皆公示。闲人请勿擅自张贴！"
          }
        }
      }
    },
    {
      "subId": "51602",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5160201"
        ],
        "dialogs": {
          "5160201": {
            "id": "5160201",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "原天领奉行九条孝行，今以渎职、贪污、危害国民等数罪免去职务，听候治罪。",
            "nextDialogs": [
              "5160202"
            ]
          },
          "5160202": {
            "id": "5160202",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "宥其年迈功高，暂行永久闭门思过，不得保释。",
            "nextDialogs": [
              "5160203"
            ]
          },
          "5160203": {
            "id": "5160203",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "若有再犯，则以大辟治之，不得宽赦。",
            "nextDialogs": [
              "5160204"
            ]
          },
          "5160204": {
            "id": "5160204",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "天领奉行府上尚在评议御馆改革事项，议定之前，职务由大御所殿下亲委之人代行。",
            "nextDialogs": [
              "5160205"
            ]
          },
          "5160205": {
            "id": "5160205",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "同心、与力等职位并无调整，官长改由九条裟罗大人统领。"
          }
        }
      }
    },
    {
      "subId": "51603",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5160301"
        ],
        "dialogs": {
          "5160301": {
            "id": "5160301",
            "speakerId": 1002,
            "speakerName": "荒泷堂堂男子汉一斗",
            "text": "「九条天狗！！我看花见坂的路口正好适合相扑对决，你人在哪里呀！！」",
            "nextDialogs": [
              "5160302"
            ]
          },
          "5160302": {
            "id": "5160302",
            "speakerId": 1002,
            "speakerName": "荒泷堂堂男子汉一斗",
            "text": "「军事、政事都丢在一边吧！！快来和我相扑！武士的荣誉落在战场上啦？？」",
            "nextDialogs": [
              "5160303"
            ]
          },
          "5160303": {
            "id": "5160303",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「说起来自从『锁国』以后，就再也没见过街头公开的相扑战表演了呢。」",
            "nextDialogs": [
              "5160304"
            ]
          },
          "5160304": {
            "id": "5160304",
            "speakerId": 1004,
            "speakerName": "另一人的留言",
            "text": "「九条裟罗大人，请应允荒泷先生的挑战吧！我们也想要斗胆瞻仰您的实力！」",
            "nextDialogs": [
              "5160305"
            ]
          },
          "5160305": {
            "id": "5160305",
            "speakerId": 1005,
            "speakerName": "回复",
            "text": "这只是骚扰涂鸦而已，诸位市民请不要与骚扰公务人员的流氓同流合污！",
            "nextDialogs": [
              "5160306"
            ]
          },
          "5160306": {
            "id": "5160306",
            "speakerId": 1005,
            "speakerName": "回复",
            "text": "九条裟罗大人已再三保证，她与此人毫无干系！！"
          }
        }
      }
    },
    {
      "subId": "51604",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5160401"
        ],
        "dialogs": {
          "5160401": {
            "id": "5160401",
            "speakerId": 1006,
            "speakerName": "寻人启事",
            "text": "寻夫稻叶藤三郎久藏。高大无须，额角有剑疤。自停战以来尚未归家。",
            "nextDialogs": [
              "5160402"
            ]
          },
          "5160402": {
            "id": "5160402",
            "speakerId": 1006,
            "speakerName": "寻人启事",
            "text": "望诸位归国武士、故交友人等告知其人下落，或提供线索。必有重谢！",
            "nextDialogs": [
              "5160403"
            ]
          },
          "5160403": {
            "id": "5160403",
            "speakerId": 1006,
            "speakerName": "寻人启事",
            "text": "稻叶静子，敬上。"
          }
        }
      }
    },
    {
      "subId": "51605",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5160501"
        ],
        "dialogs": {
          "5160501": {
            "id": "5160501",
            "speakerId": 1007,
            "speakerName": "幕府通告",
            "text": "请市民稍安勿躁，当下天领之安全，天守之防务已妥善移交九条裟罗大人管理。",
            "nextDialogs": [
              "5160502"
            ]
          },
          "5160502": {
            "id": "5160502",
            "speakerId": 1007,
            "speakerName": "幕府通告",
            "text": "九条孝行穷兵黩武、强征「神之眼」、借机暴敛压榨民众之乱政，正一扫而空！"
          }
        }
      }
    },
    {
      "subId": "51606",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5160601"
        ],
        "dialogs": {
          "5160601": {
            "id": "5160601",
            "speakerId": 1008,
            "speakerName": "天目锻冶屋告示",
            "text": "「近来由于幕府与珊瑚宫的协议，玉钢供应已经停止。」",
            "nextDialogs": [
              "5160602"
            ]
          },
          "5160602": {
            "id": "5160602",
            "speakerId": 1008,
            "speakerName": "天目锻冶屋告示",
            "text": "「来日方长，政策或有调整之时…」",
            "nextDialogs": [
              "5160603"
            ]
          },
          "5160603": {
            "id": "5160603",
            "speakerId": 1008,
            "speakerName": "天目锻冶屋告示",
            "text": "「还烦有修缮或定制玉钢兵器需求的贵客多多等待。」",
            "nextDialogs": [
              "5160604"
            ]
          },
          "5160604": {
            "id": "5160604",
            "speakerId": 1008,
            "speakerName": "天目锻冶屋告示",
            "text": "「老夫天目十五深表遗憾，万望新老客人见谅。」"
          }
        }
      }
    },
    {
      "subId": "51607",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5160701"
        ],
        "dialogs": {
          "5160701": {
            "id": "5160701",
            "speakerId": 1009,
            "speakerName": "「万端珊瑚」广告",
            "text": "「万端珊瑚，代行万端！」",
            "nextDialogs": [
              "5160702"
            ]
          },
          "5160702": {
            "id": "5160702",
            "speakerId": 1009,
            "speakerName": "「万端珊瑚」广告",
            "text": "「寻人、寻找宠物、婚姻调查、犯罪调查、商业委托、运送货品、代购代送…」",
            "nextDialogs": [
              "5160703"
            ]
          },
          "5160703": {
            "id": "5160703",
            "speakerId": 1009,
            "speakerName": "「万端珊瑚」广告",
            "text": "「只要您开价，钱形、百目鬼之流江洋大盗也捉给您看！」",
            "nextDialogs": [
              "5160704"
            ]
          },
          "5160704": {
            "id": "5160704",
            "speakerId": 1009,
            "speakerName": "「万端珊瑚」广告",
            "text": "「顺便，请各位客户不要相信那位自称平藏的『侦探』！此人乃诈骗惯犯！！」",
            "nextDialogs": [
              "5160705"
            ]
          },
          "5160705": {
            "id": "5160705",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「这就是『同行相轻』吗…」",
            "nextDialogs": [
              "5160706"
            ]
          },
          "5160706": {
            "id": "5160706",
            "speakerId": 1010,
            "speakerName": "「万端珊瑚」回复",
            "text": "「谁和那家伙是同行啦！」"
          }
        }
      }
    },
    {
      "subId": "51608",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5160801"
        ],
        "dialogs": {
          "5160801": {
            "id": "5160801",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「绀田村近来大片染料田亟待复耕，当前人手稍紧，企望城里小伙子们帮忙。」",
            "nextDialogs": [
              "5160802"
            ]
          },
          "5160802": {
            "id": "5160802",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「虽然村子当前算不上富裕，但只要吃苦耐劳，本人绀田传助保证报酬丰厚！」",
            "nextDialogs": [
              "5160803"
            ]
          },
          "5160803": {
            "id": "5160803",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「有家属的小伙子也可以把家人带来绀田村，包吃包住，给村里增点人气！」",
            "nextDialogs": [
              "5160804"
            ]
          },
          "5160804": {
            "id": "5160804",
            "speakerId": 1004,
            "speakerName": "另一人的留言",
            "text": "「村长大人，比起这样打广告，不如干脆搞个收费的旅游观光项目算了。」",
            "nextDialogs": [
              "5160805"
            ]
          },
          "5160805": {
            "id": "5160805",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「少插话，就你鬼点子多！哪能收人家的钱！」"
          }
        }
      }
    },
    {
      "subId": "51609",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5160901"
        ],
        "dialogs": {
          "5160901": {
            "id": "5160901",
            "speakerId": 1011,
            "speakerName": "鸣神大社公告",
            "text": "复员归来的武士们可诣社奉行府邸领取补助，登记就业意向。",
            "nextDialogs": [
              "5160902"
            ]
          },
          "5160902": {
            "id": "5160902",
            "speakerId": 1011,
            "speakerName": "鸣神大社公告",
            "text": "此外，鸣神大社将为诸位参战武士及家属开办交谊会，以求慰藉征战之创伤。"
          }
        }
      }
    },
    {
      "subId": "51610",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5161001"
        ],
        "dialogs": {
          "5161001": {
            "id": "5161001",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「清籁岛一带又有海贼活动，社奉行大人提议的重建计划此前因战争一拖再拖…」",
            "nextDialogs": [
              "5161002"
            ]
          },
          "5161002": {
            "id": "5161002",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「幸好现在前线停火，那边的浅濑神社也该重新修缮了。」",
            "nextDialogs": [
              "5161003"
            ]
          },
          "5161003": {
            "id": "5161003",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「只是不清楚，已经过了几百年，清籁岛的子孙们对故乡还有多少印象了…」"
          }
        }
      }
    },
    {
      "subId": "51611",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5161101"
        ],
        "dialogs": {
          "5161101": {
            "id": "5161101",
            "speakerId": 1007,
            "speakerName": "幕府通告",
            "text": "鉴于此前战时在踏鞴砂与八酝岛发生的诸多惨剧，大御所殿下与海祇现人神巫女均深感悲痛。",
            "nextDialogs": [
              "5161102"
            ]
          },
          "5161102": {
            "id": "5161102",
            "speakerId": 1007,
            "speakerName": "幕府通告",
            "text": "自今以后，幕府将与珊瑚宫方面携手共同努力重建诸地，再议合作开发事宜。",
            "nextDialogs": [
              "5161103"
            ]
          },
          "5161103": {
            "id": "5161103",
            "speakerId": 1007,
            "speakerName": "幕府通告",
            "text": "战乱之平息，罪魁之服法，实稻妻国之大幸。",
            "nextDialogs": [
              "5161104"
            ]
          },
          "5161104": {
            "id": "5161104",
            "speakerId": 1007,
            "speakerName": "幕府通告",
            "text": "我等今后更应追随将军殿下之神威明智，谐和并行，终将成就恒常之大业。"
          }
        }
      }
    },
    {
      "subId": "51612",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5161201"
        ],
        "dialogs": {
          "5161201": {
            "id": "5161201",
            "speakerId": 1012,
            "speakerName": "「木南料亭」广告",
            "text": "「木南料亭，只提供最正宗，最鲜美的稻妻料理！」",
            "nextDialogs": [
              "5161202"
            ]
          },
          "5161202": {
            "id": "5161202",
            "speakerId": 1012,
            "speakerName": "「木南料亭」广告",
            "text": "「来店外带者，赠品为杏奈小姐的微笑！」",
            "nextDialogs": [
              "5161203"
            ]
          },
          "5161203": {
            "id": "5161203",
            "speakerId": 1012,
            "speakerName": "「木南料亭」广告",
            "text": "「让甜美的微笑，带给您美好的一天！」",
            "nextDialogs": [
              "5161204"
            ]
          },
          "5161204": {
            "id": "5161204",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「怎么想都只是为了促销而强颜欢笑吧…」"
          }
        }
      }
    },
    {
      "subId": "51613",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5161301"
        ],
        "dialogs": {
          "5161301": {
            "id": "5161301",
            "speakerId": 1013,
            "speakerName": "火消队通知",
            "text": "「诸位市民若发现宵宫小姐在城区内滥放管制烟火，请尽量加以制止！」",
            "nextDialogs": [
              "5161302"
            ]
          },
          "5161302": {
            "id": "5161302",
            "speakerId": 1013,
            "speakerName": "火消队通知",
            "text": "「或至少加以斥责，不要助纣为虐！」",
            "nextDialogs": [
              "5161303"
            ]
          },
          "5161303": {
            "id": "5161303",
            "speakerId": 1013,
            "speakerName": "火消队通知",
            "text": "「或者至少不要接受她分发的烟火也好！」",
            "nextDialogs": [
              "5161304"
            ]
          },
          "5161304": {
            "id": "5161304",
            "speakerId": 1013,
            "speakerName": "火消队通知",
            "text": "「稻妻城火消队在此恭请诸位市民加以注意，深为感谢。」"
          }
        }
      }
    },
    {
      "subId": "51614",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5161401"
        ],
        "dialogs": {
          "5161401": {
            "id": "5161401",
            "speakerId": 1014,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但希望这件事能够周知。」",
            "nextDialogs": [
              "5161402"
            ]
          },
          "5161402": {
            "id": "5161402",
            "speakerId": 1014,
            "speakerName": "八重堂的平冢",
            "text": "「泷泽京传先生那本著名的《鹮巷物语》孤本最近被我不慎搞丢了。」",
            "nextDialogs": [
              "5161403"
            ]
          },
          "5161403": {
            "id": "5161403",
            "speakerId": 1014,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但八重大人非要让我到处刊出寻书启示，真是伤脑筋。」",
            "nextDialogs": [
              "5161404"
            ]
          },
          "5161404": {
            "id": "5161404",
            "speakerId": 1014,
            "speakerName": "八重堂的平冢",
            "text": "「想想那本书也真是可怜，也许飞散得到处都是了吧…想要找到不太可能了。」",
            "nextDialogs": [
              "5161405"
            ]
          },
          "5161405": {
            "id": "5161405",
            "speakerId": 1014,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但假如有人能够帮忙找全该书，八重堂将会十分感谢。」"
          }
        }
      }
    },
    {
      "subId": "51615",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5161501"
        ],
        "dialogs": {
          "5161501": {
            "id": "5161501",
            "speakerId": 1015,
            "speakerName": "「八重堂」广告",
            "text": "璃月大人气作家「枕玉」签名紫木螺钿精装版《沉秋拾剑录》火热发售中！！",
            "nextDialogs": [
              "5161502"
            ]
          },
          "5161502": {
            "id": "5161502",
            "speakerId": 1015,
            "speakerName": "「八重堂」广告",
            "text": "现在购买，则有机会赠送配套设定集与精美人物徽章！！",
            "nextDialogs": [
              "5161503"
            ]
          },
          "5161503": {
            "id": "5161503",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「回家找了一晚上也没有找到…特地来这里问一下：请问作者签名在哪里？」",
            "nextDialogs": [
              "5161504"
            ]
          },
          "5161504": {
            "id": "5161504",
            "speakerId": 1015,
            "speakerName": "「八重堂」广告",
            "text": "*特别注意：签名笔走龙蛇，不仔细观察很容易与盒盖上的纹理看混。",
            "nextDialogs": [
              "5161505"
            ]
          },
          "5161505": {
            "id": "5161505",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「现在的人气作家都不练字的吗…」"
          }
        }
      }
    },
    {
      "subId": "51616",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5161601"
        ],
        "dialogs": {
          "5161601": {
            "id": "5161601",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「年轻的武士朋友们，『志村屋』永远为你们敞开大门！」",
            "nextDialogs": [
              "5161602"
            ]
          },
          "5161602": {
            "id": "5161602",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「失业也不要紧，恋情望而不得也不要紧，有什么烦恼的话，就来喝两杯吧！」",
            "nextDialogs": [
              "5161603"
            ]
          },
          "5161603": {
            "id": "5161603",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「老夫志村勘兵卫，期待着您的到来！」"
          }
        }
      }
    },
    {
      "subId": "51617",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5161701"
        ],
        "dialogs": {
          "5161701": {
            "id": "5161701",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「城内城外的各位小朋友及其家长，如有被一长角赤鬼欺负，以致失去玩具、卡片、鬼兜虫、零食、图画书册等…」",
            "nextDialogs": [
              "5161702"
            ]
          },
          "5161702": {
            "id": "5161702",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「请来花见坂找久岐忍，我将尽量悉数归还…当然，已经被玩坏掉的、吃掉的东西就爱莫能助了。」",
            "nextDialogs": [
              "5161703"
            ]
          },
          "5161703": {
            "id": "5161703",
            "speakerId": 1016,
            "speakerName": "荒泷胜者全拿一斗",
            "text": "「阿忍，你又在对败者施与泛滥的怜悯心了！」",
            "nextDialogs": [
              "5161704"
            ]
          },
          "5161704": {
            "id": "5161704",
            "speakerId": 1016,
            "speakerName": "荒泷胜者全拿一斗",
            "text": "「这是战利品呀，战利品！我辛苦赢来才分给你的，不是让你还给弱者的！！」",
            "nextDialogs": [
              "5161705"
            ]
          },
          "5161705": {
            "id": "5161705",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「这样吗？下次你又被那天狗女人揍哭的话，我可不会再把你拖回去了。」",
            "nextDialogs": [
              "5161706"
            ]
          },
          "5161706": {
            "id": "5161706",
            "speakerId": 1017,
            "speakerName": "荒泷历战无败一斗",
            "text": "「你这家伙怎么这样！」",
            "nextDialogs": [
              "5161707"
            ]
          },
          "5161707": {
            "id": "5161707",
            "speakerId": 1003,
            "speakerName": "留言",
            "text": "「都是因为你，我现在和町奉行所的每个同心都已经熟络到不行了…」",
            "nextDialogs": [
              "5161708"
            ]
          },
          "5161708": {
            "id": "5161708",
            "speakerId": 1018,
            "speakerName": "荒泷永不蹲牢一斗",
            "text": "「我又没求着你接我出来！还有那个精神鉴定保释书，你是在羞辱我吗！！」",
            "nextDialogs": [
              "5161709"
            ]
          },
          "5161709": {
            "id": "5161709",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "依市民举报，在公告板上涂鸦的二人已被拘捕。",
            "nextDialogs": [
              "5161710"
            ]
          },
          "5161710": {
            "id": "5161710",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "虽然都已经是熟人了，但还是请某些人稍微收敛一点。"
          }
        }
      }
    }
  ]
}
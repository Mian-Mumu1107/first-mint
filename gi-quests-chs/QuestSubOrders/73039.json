        ],
        "dialogs": {
          "730390301": {
            "id": "730390301",
            "speakerId": 4195,
            "speakerName": "兰非拉",
            "text": "#「鲜嫩无朋之果」…为了无忧节，兰非拉已经准备好了，不用那菈{NICKNAME}担心！",
            "nextDialogs": [
              "730390302"
            ]
          },
          "730390302": {
            "id": "730390302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰非拉动作好快！我们去看看其他地方吧。"
          }
        }
      }
    },
    {
      "subId": "7303905",
      "subQuestName": "和「哥哥们」交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730390701"
        ],
        "dialogs": {
          "730390701": {
            "id": "730390701",
            "speakerId": 4193,
            "speakerName": "兰萨卡",
            "text": "多加一点「开心的味道」…",
            "nextDialogs": [
              "730390702"
            ]
          },
          "730390702": {
            "id": "730390702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇！可以不用加那么多的！",
            "nextDialogs": [
              "730390703"
            ]
          },
          "730390703": {
            "id": "730390703",
            "speakerId": 4193,
            "speakerName": "兰萨卡",
            "text": "哦…兰帕卡提说了，菜肴要让那菈高兴，派蒙说得对，那就、那就少加一点…",
            "nextDialogs": [
              "730390704"
            ]
          },
          "730390704": {
            "id": "730390704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！这样应该没问题了。"
          }
        }
      }
    },
    {
      "subId": "7303904",
      "subQuestName": "和「哥哥们」交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730390801"
        ],
        "dialogs": {
          "730390801": {
            "id": "730390801",
            "speakerId": 4192,
            "speakerName": "兰茶荼",
            "text": "「一头菇」，早就准备好了！嘿嘿，芬芳的「一头菇」…",
            "nextDialogs": [
              "730390802"
            ]
          },
          "730390802": {
            "id": "730390802",
            "speakerId": 4192,
            "speakerName": "兰茶荼",
            "text": "#不过火候…兰茶荼不擅长，那菈{NICKNAME}，来看看…",
            "nextDialogs": [
              "730390803"
            ]
          },
          "730390803": {
            "id": "730390803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "火对于兰那罗来说还是有点危险呢…我们来帮忙调整火候吧。"
          }
        }
      }
    },
    {
      "subId": "7303911",
      "subQuestName": "帮助兰茶荼调整火候",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730390901"
        ],
        "dialogs": {
          "730390901": {
            "id": "730390901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这样应该可以吧？",
            "nextDialogs": [
              "730390902"
            ]
          },
          "730390902": {
            "id": "730390902",
            "speakerId": 4192,
            "speakerName": "兰茶荼",
            "text": "啊！成了，这样一定能做出完美无缺的「至上珍馐」！"
          }
        }
      }
    },
    {
      "subId": "7303903",
      "subQuestName": "和「哥哥们」交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730390401"
        ],
        "dialogs": {
          "730390401": {
            "id": "730390401",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "#「最好喝的水」！练习的时候用完了…那菈{NICKNAME}，可不可以…可不可以帮兰阿帕斯去桓那兰那南边取水…",
            "nextDialogs": [
              "730390402"
            ]
          },
          "730390402": {
            "id": "730390402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔…{NICKNAME}，那我们就帮帮他吧？"
          }
        }
      }
    },
    {
      "subId": "7303909",
      "subQuestName": "为兰阿帕斯取水",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7303910",
      "subQuestName": "将取到的水交给兰阿帕斯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730390501"
        ],
        "dialogs": {
          "730390501": {
            "id": "730390501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "兰阿帕斯，我们回来啦！这就是「最好喝的水」！",
            "nextDialogs": [
              "730390502"
            ]
          },
          "730390502": {
            "id": "730390502",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "#太好了！有了「最好喝的水」，一定能烧出「最好喝的汤」，那菈{NICKNAME}一定会喜欢！"
          }
        }
      }
    },
    {
      "subId": "7303912",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730391201"
        ],
        "dialogs": {
          "730391201": {
            "id": "730391201",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "依照之前派蒙想到的改善方式，指导兰那罗将菜肴完成了。\\n随后，和兰那罗一起享用…",
            "nextDialogs": [
              "730391202"
            ]
          },
          "730391202": {
            "id": "730391202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么样？正宗的那菈美食！",
            "nextDialogs": [
              "730391203"
            ]
          },
          "730391203": {
            "id": "730391203",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#唔…虽然是兰帕卡提提议，让那菈{NICKNAME}来指导哥哥们…",
            "nextDialogs": [
              "730391204"
            ]
          },
          "730391204": {
            "id": "730391204",
            "speakerId": 4192,
            "speakerName": "兰茶荼",
            "text": "那菈的菜…这、这就是那菈的「快乐的味道」吗？",
            "nextDialogs": [
              "730391205"
            ]
          },
          "730391205": {
            "id": "730391205",
            "speakerId": 4193,
            "speakerName": "兰萨卡",
            "text": "快乐都要逃走了…",
            "nextDialogs": [
              "730391206"
            ]
          },
          "730391206": {
            "id": "730391206",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "桓那兰那的水…明明是「最好喝的水」…怎么会煮出这种东西…",
            "nextDialogs": [
              "730391207"
            ]
          },
          "730391207": {
            "id": "730391207",
            "speakerId": 4195,
            "speakerName": "兰非拉",
            "text": "但是「鲜嫩无朋之果」还是一样好吃…嗯。",
            "nextDialogs": [
              "730391208"
            ]
          },
          "730391208": {
            "id": "730391208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？怎么会这样？兰那罗都觉得难吃吗？我觉得很美味啊…",
            "nextDialogs": [
              "730391209"
            ]
          },
          "730391209": {
            "id": "730391209",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "虽然不知道什么是「难吃」…唔…很有「冲击力」的味道，像跑得太快撞到树干上一样…",
            "nextDialogs": [
              "730391210"
            ]
          },
          "730391210": {
            "id": "730391210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…这…这一定是那菈文化和兰那罗文化的碰撞！",
            "nextDialogs": [
              "730391211"
            ]
          },
          "730391211": {
            "id": "730391211",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#不过，哥哥们，真不好。你们要谢谢那菈{NICKNAME}才对，怎么能说这些话！",
            "nextDialogs": [
              "730391212"
            ]
          },
          "730391212": {
            "id": "730391212",
            "speakerId": 4192,
            "speakerName": "兰茶荼",
            "text": "呜呜…对不起…",
            "nextDialogs": [
              "730391213"
            ]
          },
          "730391213": {
            "id": "730391213",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "不是啦！要说谢谢！",
            "nextDialogs": [
              "730391214"
            ]
          },
          "730391214": {
            "id": "730391214",
            "speakerId": 1007,
            "speakerName": "「哥哥们」",
            "text": "#谢谢那菈{NICKNAME}…",
            "nextDialogs": [
              "730391215"
            ]
          },
          "730391215": {
            "id": "730391215",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#不过…那菈{NICKNAME}和派蒙吃得开心，就好！不管那些笨蛋哥哥。只要那菈朋友开心，我们就很开心。",
            "nextDialogs": [
              "730391216"
            ]
          },
          "730391216": {
            "id": "730391216",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#不过，那菈{NICKNAME}和那菈法留纳，一点也不一样。那菈法留纳，那时候说了好多「{M#哥哥}{F#妹妹}」的事情。",
            "nextDialogs": [
              "730391217"
            ]
          },
          "730391217": {
            "id": "730391217",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#但是，那菈{NICKNAME}说话很少。不舒服？",
            "nextDialogs": [
              "730391218"
            ]
          },
          "730391218": {
            "id": "730391218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔…{NICKNAME}，说点什么吧？",
            "nextDialogs": [
              "730391222",
              "730391221"
            ]
          },
          "730391222": {
            "id": "730391222",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#是这样吗？既然那菈{NICKNAME}没事就好。嗯，谢谢你们。这些小花，是兰帕卡提和哥哥们，送给那菈{NICKNAME}还有派蒙的。",
            "nextDialogs": [
              "730391223"
            ]
          },
          "730391223": {
            "id": "730391223",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#希望那菈{NICKNAME}和派蒙，在桓那兰那得到更多「快乐的味道」！"
          },
          "730391221": {
            "id": "730391221",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#…总之，兰帕卡提不用担心！{NICKNAME}没问题的！"
          }
        }
      }
    },
    {
      "subId": "7303906",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730391001"
        ],
        "dialogs": {
          "730391001": {
            "id": "730391001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了，这么高兴的日子，兰那罗他们都在热心为我们做吃的，「礼尚往来」，我们也做点什么吧！",
            "nextDialogs": [
              "730391002"
            ]
          },
          "730391002": {
            "id": "730391002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…兰那罗可能会喜欢的…那就做萝卜时蔬汤吧！嘿嘿，让兰那罗也品尝一下那菈的手艺！"
          }
        }
      }
    },
    {
      "subId": "7303907",
      "subQuestName": "将一份「美味的萝卜时蔬汤」交给兰帕卡提",
      "sceneId": null,
      "locations": [],

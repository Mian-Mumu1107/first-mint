    {
      "subId": "7303908",
      "subQuestName": "与兰那罗一起享用大餐$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730391224"
        ],
        "dialogs": {
          "730391224": {
            "id": "730391224",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯，还是得{NICKNAME}帮帮忙才行，不然又会做出和之前一样的菜肴呢…"
          }
        }
      }
    },
    {
      "subId": "7303901",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730390101"
        ],
        "dialogs": {
          "730390101": {
            "id": "730390101",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "哥哥们已经好好反省过了，无忧节是快乐的日子，兰帕卡提不应该再生气。",
            "nextDialogs": [
              "730390102"
            ]
          },
          "730390102": {
            "id": "730390102",
            "speakerId": 4193,
            "speakerName": "兰萨卡",
            "text": "对，兰帕卡提不要再生气了，快乐的日子，应该拿出「快乐的味道」来庆祝！",
            "nextDialogs": [
              "730390103"
            ]
          },
          "730390103": {
            "id": "730390103",
            "speakerId": 4192,
            "speakerName": "兰茶荼",
            "text": "是时候展示「烹饪修行」的成果了。",
            "nextDialogs": [
              "730390104"
            ]
          },
          "730390104": {
            "id": "730390104",
            "speakerId": 4195,
            "speakerName": "兰非拉",
            "text": "早就准备好了。",
            "nextDialogs": [
              "730390105"
            ]
          },
          "730390105": {
            "id": "730390105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯！是无忧节大餐！我期待好久了…",
            "nextDialogs": [
              "730390108"
            ]
          },
          "730390108": {
            "id": "730390108",
            "speakerId": 4194,
            "speakerName": "兰阿帕斯",
            "text": "有桓那兰那的水，最好的水，能做出最好的汤，那菈喝了一定满意。",
            "nextDialogs": [
              "730390109"
            ]
          },
          "730390109": {
            "id": "730390109",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#要把「快乐的味道」送给那菈{NICKNAME}和派蒙，应该让那菈{NICKNAME}和派蒙来「指导」哥哥们。",
            "nextDialogs": [
              "730390110"
            ]
          },
          "730390110": {
            "id": "730390110",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "只有这样，才能做出让那菈满意的菜肴，这才是招待「客人」的「礼节」。",
            "nextDialogs": [
              "730390111"
            ]
          },
          "730390111": {
            "id": "730390111",
            "speakerId": 4191,
            "speakerName": "兰帕卡提",
            "text": "#那菈{NICKNAME}，愿意「指导」哥哥们的烹饪吗？"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7414101",
      "subQuestName": "(test)判断前置任务是否完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741410101"
        ],
        "dialogs": {
          "741410101": {
            "id": "741410101",
            "speakerId": 1000,
            "speakerName": "「揭示之书」",
            "text": "（书页上的内容依旧是由无法理解的图形、字母与古语，以及几何图形构成。但集中精神后，似乎能渐渐理解其中的内容了。）",
            "nextDialogs": [
              "741410102"
            ]
          },
          "741410102": {
            "id": "741410102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "夏诺蒂拉好像不在呢，可能又到那个神秘的地方去了！要进行「冥想」吗？",
            "nextDialogs": [
              "741410103"
            ]
          },
          "741410103": {
            "id": "741410103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听了她上次说的话…",
            "nextDialogs": [
              "741410104"
            ]
          },
          "741410104": {
            "id": "741410104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有点在意。我要去看看。",
            "nextDialogs": [
              "741410105"
            ]
          },
          "741410105": {
            "id": "741410105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…虽然有点不安，不过我们一起去吧！夏诺蒂拉真是让人担心呢！",
            "nextDialogs": [
              "741410106"
            ]
          },
          "741410106": {
            "id": "741410106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，你在外面等我就好。",
            "nextDialogs": [
              "741410107"
            ]
          },
          "741410107": {
            "id": "741410107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "741410108"
            ]
          },
          "741410108": {
            "id": "741410108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「揭示之书」的世界…",
            "nextDialogs": [
              "741410111"
            ]
          },
          "741410111": {
            "id": "741410111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以，我不希望你冒险。",
            "nextDialogs": [
              "741410112"
            ]
          },
          "741410112": {
            "id": "741410112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但是…但是，一直以来我们不是一起冒险的吗？我们在一起，就没有克服不了的困难、战胜不了的敌人才对…",
            "nextDialogs": [
              "741410113"
            ]
          },
          "741410113": {
            "id": "741410113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "里面的危险可能不是战斗能解决的。",
            "nextDialogs": [
              "741410114"
            ]
          },
          "741410114": {
            "id": "741410114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "741410115"
            ]
          },
          "741410115": {
            "id": "741410115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好吧！哼，你比我聪明多了，我相信你。那你可别抛下我喔！我会一直等你回来的！"
          }
        }
      }
    },

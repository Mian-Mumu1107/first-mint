    {
      "subId": "7414110",
      "subQuestName": "与人影对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741411001"
        ],
        "dialogs": {
          "741411001": {
            "id": "741411001",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "…是吗，那就好说了。你叫什么？",
            "nextDialogs": [
              "741411002"
            ]
          },
          "741411002": {
            "id": "741411002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "卡特皮拉。",
            "nextDialogs": [
              "741411003"
            ]
          },
          "741411003": {
            "id": "741411003",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "#{NICKNAME}，没想到会在这里遇到你。派蒙没在你身边吗？",
            "nextDialogs": [
              "741411004"
            ]
          },
          "741411004": {
            "id": "741411004",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "等等，你该不会也是什么怪物，变成我认识的人的样子来戏弄我的吧。",
            "nextDialogs": [
              "741411005"
            ]
          },
          "741411005": {
            "id": "741411005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们不久前才见过。",
            "nextDialogs": [
              "741411006"
            ]
          },
          "741411006": {
            "id": "741411006",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "…是这样吗？自从和你告别，感觉已经过了很久了。算了，可能是年纪大了吧，我能记得的事情越来越少。",
            "nextDialogs": [
              "741411007"
            ]
          },
          "741411007": {
            "id": "741411007",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "…你真的不是什么怪物吧？",
            "nextDialogs": [
              "741411008"
            ]
          },
          "741411008": {
            "id": "741411008",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还记得吗？",
            "nextDialogs": [
              "741411011"
            ]
          },
          "741411011": {
            "id": "741411011",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "我记得。我记得。你真的是你。",
            "nextDialogs": [
              "741411012"
            ]
          },
          "741411012": {
            "id": "741411012",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "抱歉，我在这里遇到了太多不可思议的事情，也经过了许多无法取胜的战斗。",
            "nextDialogs": [
              "741411013"
            ]
          },
          "741411013": {
            "id": "741411013",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "但这里终于发生了变化。金色的光芒已经升起，向日葵已经开放。也许就算是古人臆想的宇宙也会发生变化。",
            "nextDialogs": [
              "741411014"
            ]
          },
          "741411014": {
            "id": "741411014",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "也许一切都会变好。也许我也能够理解，然后放下。",
            "nextDialogs": [
              "741411015"
            ]
          },
          "741411015": {
            "id": "741411015",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "卡特皮拉…",
            "nextDialogs": [
              "741411016"
            ]
          },
          "741411016": {
            "id": "741411016",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "跟我一起走吧。",
            "nextDialogs": [
              "741411017"
            ]
          },
          "741411017": {
            "id": "741411017",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "哈哈哈，看来真的是你。我想起来了，我曾经认识的你，就算到现在也没有变。你总是多管闲事，这是因为你正直而善良。",
            "nextDialogs": [
              "741411018"
            ]
          },
          "741411018": {
            "id": "741411018",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "但你不用担心我。我不需要帮助。你也见识过我的身手。",
            "nextDialogs": [
              "741411019"
            ]
          },
          "741411019": {
            "id": "741411019",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "况且，对于这里的事情，或许我比你懂的还多呢。",
            "nextDialogs": [
              "741411020"
            ]
          },
          "741411020": {
            "id": "741411020",
            "speakerId": 1003,
            "speakerName": "「小狗」",
            "text": "#丘丘人，帮我告诉那位{M#少年}{F#少女}，请{M#他}{F#她}赶紧离开。",
            "nextDialogs": [
              "741411021"
            ]
          },
          "741411021": {
            "id": "741411021",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你有话对我说吗？",
            "nextDialogs": [
              "741411022"
            ]
          },
          "741411022": {
            "id": "741411022",
            "speakerId": 1003,
            "speakerName": "「小狗」",
            "text": "…你能听懂我说的话？嗯，那我问你。在你眼里，我是什么？",
            "nextDialogs": [
              "741411023"
            ]
          },
          "741411023": {
            "id": "741411023",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "狗。",
            "nextDialogs": [
              "741411024"
            ]
          },
          "741411024": {
            "id": "741411024",
            "speakerId": 1003,
            "speakerName": "「小狗」",
            "text": "这样啊…那还来得及。",
            "nextDialogs": [
              "741411025"
            ]
          },
          "741411025": {
            "id": "741411025",
            "speakerId": 1003,
            "speakerName": "「小狗」",
            "text": "#这也是为了你好。离开这里吧，{M#少年}{F#少女}。",
            "nextDialogs": [
              "741411026"
            ]
          },
          "741411026": {
            "id": "741411026",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "#我同意。{NICKNAME}，你属于更光明的世界。",
            "nextDialogs": [
              "741411027"
            ]
          },
          "741411027": {
            "id": "741411027",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我还有问题…",
            "nextDialogs": [
              "741411028"
            ]
          },
          "741411028": {
            "id": "741411028",
            "speakerId": 1003,
            "speakerName": "「小狗」",
            "text": "你不应该有。再见。不要再回来了。"
          }
        }
      }
    },
    {
      "subId": "7414111",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741411101"
        ],
        "dialogs": {
          "741411101": {
            "id": "741411101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！你回来了！",
            "nextDialogs": [
              "741411102"
            ]
          },
          "741411102": {
            "id": "741411102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我离开了多久？",
            "nextDialogs": [
              "741411103"
            ]
          },
          "741411103": {
            "id": "741411103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，也就一眨眼的事情…",
            "nextDialogs": [
              "741411104"
            ]
          },
          "741411104": {
            "id": "741411104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "如果对你来说只是一眨眼的话…",

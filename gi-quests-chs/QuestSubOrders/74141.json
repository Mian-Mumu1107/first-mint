    {
      "subId": "7414108",
      "subQuestName": "与人影对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741410801"
        ],
        "dialogs": {
          "741410801": {
            "id": "741410801",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "……",
            "nextDialogs": [
              "741410802"
            ]
          },
          "741410802": {
            "id": "741410802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "卡特皮拉。",
            "nextDialogs": [
              "741410803"
            ]
          },
          "741410803": {
            "id": "741410803",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "谁？",
            "nextDialogs": [
              "741410804"
            ]
          },
          "741410804": {
            "id": "741410804",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "…原来是你啊。我记得你。",
            "nextDialogs": [
              "741410805"
            ]
          },
          "741410805": {
            "id": "741410805",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么会在这里？",
            "nextDialogs": [
              "741410806"
            ]
          },
          "741410806": {
            "id": "741410806",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "被你抢先了。我也想问你这个问题呢。",
            "nextDialogs": [
              "741410807"
            ]
          },
          "741410807": {
            "id": "741410807",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "没什么，我只是觉得…",
            "nextDialogs": [
              "741410808"
            ]
          },
          "741410808": {
            "id": "741410808",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "#你是{NICKNAME}，对吧？你身边那个白色的小东西…叫什么名字来着？她怎么没和你一起？",
            "nextDialogs": [
              "741410810"
            ]
          },
          "741410810": {
            "id": "741410810",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "是叫这个名字吗？算了，没所谓了。你是好人，派蒙也是好人。",
            "nextDialogs": [
              "741410812"
            ]
          },
          "741410812": {
            "id": "741410812",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "我来这里，是要找一个很重要的东西。你知道我要找的是什么吗？",
            "nextDialogs": [
              "741410813"
            ]
          },
          "741410813": {
            "id": "741410813",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "算了，就当我没问吧。你怎么会在这里？快点离开。这里很危险，以前有人来这里接受试炼，结果迷失了，脑子变成了浆糊…",
            "nextDialogs": [
              "741410814"
            ]
          },
          "741410814": {
            "id": "741410814",
            "speakerId": 1002,
            "speakerName": "卡特皮拉",
            "text": "我想起来了，我和你，我们曾经做过很厉害的事情。那是我的一生中唯一值得骄傲的事情…",
            "nextDialogs": [
              "741410815"
            ]
          },
          "741410815": {
            "id": "741410815",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是说…"
          }
        }
      }
    },
    {
      "subId": "7414109",

  "subQuests": [
    {
      "subId": "7005201",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700520101"
        ],
        "dialogs": {
          "700520101": {
            "id": "700520101",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "#{NICKNAME}，你也是被这片花海吸引来的吗？",
            "nextDialogs": [
              "700520103",
              "700520105"
            ]
          },
          "700520103": {
            "id": "700520103",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "好主意，这些花属于我从未见过的陌生物种，有必要为它们留下影像。",
            "nextDialogs": [
              "700520106"
            ]
          },
          "700520106": {
            "id": "700520106",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "我想想，这些花身上出现了一些神奇的性状，你待会儿试着触碰它们就知道了。",
            "nextDialogs": [
              "700520107"
            ]
          },
          "700520107": {
            "id": "700520107",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "我建议咱们一会儿留影的时候，把这种特殊性状也拍进去。",
            "nextDialogs": [
              "700520108"
            ]
          },
          "700520108": {
            "id": "700520108",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "这些花朵很美丽，就像被施予了魔法一样。",
            "nextDialogs": [
              "700520109"
            ]
          },
          "700520109": {
            "id": "700520109",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "从我的嘴里说出这样的话可能有点奇怪，但自然界的生命时常呈现出像魔法一样奇妙的美。",
            "nextDialogs": [
              "700520110"
            ]
          },
          "700520110": {
            "id": "700520110",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "遇到这种瞬间，我也会想要立刻把它们拍下来。",
            "nextDialogs": [
              "700520111"
            ]
          },
          "700520111": {
            "id": "700520111",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "从某种意义上来说，我们算是想到一起去了。",
            "nextDialogs": [
              "700520112"
            ]
          },
          "700520112": {
            "id": "700520112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "顺便给提纳里也拍一张吧。",
            "nextDialogs": [
              "700520113"
            ]
          },
          "700520113": {
            "id": "700520113",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "好啊，这里可是个绝佳的取景地点。",
            "nextDialogs": [
              "700520114"
            ]
          },
          "700520114": {
            "id": "700520114",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "让我想想，用什么姿势入镜比较好…你有什么想法吗？"
          },
          "700520105": {
            "id": "700520105",
            "speakerId": 1050,
            "speakerName": "提纳里",
            "text": "哈哈，我们的确很久没见了。"
          }
        }
      }
    }
  ]
}
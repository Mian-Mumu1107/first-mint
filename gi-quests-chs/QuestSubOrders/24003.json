    {
      "subId": "2400307",
      "subQuestName": "与韦吕对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240030901"
        ],
        "dialogs": {
          "240030901": {
            "id": "240030901",
            "speakerId": 1000,
            "speakerName": "韦吕",
            "text": "#哥！你是不是把我藏的地方告诉{M#大哥哥}{F#大姐姐}了，{M#他}{F#她}怎么找到得这么快呀？",
            "nextDialogs": [
              "240030902"
            ]
          },
          "240030902": {
            "id": "240030902",
            "speakerId": 1001,
            "speakerName": "奥雷勒",
            "text": "我都说过了，是你藏的地方太明显了。",
            "nextDialogs": [
              "240030905"
            ]
          },
          "240030905": {
            "id": "240030905",
            "speakerId": 1000,
            "speakerName": "韦吕",
            "text": "#是吗？那{M#大哥哥}{F#大姐姐}，你以后会不会经常来呀？我们一起玩好不好！",
            "nextDialogs": [
              "240030906"
            ]
          },
          "240030906": {
            "id": "240030906",
            "speakerId": 1000,
            "speakerName": "韦吕",
            "text": "爸妈白天都不在家，哥哥又老是在看书…都没什么时间陪我玩…",
            "nextDialogs": [
              "240030907"
            ]
          },
          "240030907": {
            "id": "240030907",
            "speakerId": 1001,
            "speakerName": "奥雷勒",
            "text": "你也可以和我一样，多看看书柜里的那些书，这可比玩捉迷藏好，也有用多了。",
            "nextDialogs": [
              "240030908"
            ]
          },
          "240030908": {
            "id": "240030908",
            "speakerId": 1000,
            "speakerName": "韦吕",
            "text": "那…那我还不如去找妈妈学缝衣服呢…"
          }
        }
      }
    },
    {

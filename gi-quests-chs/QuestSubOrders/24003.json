            "id": "240030201",
            "speakerId": 1000,
            "speakerName": "韦吕",
            "text": "呜哇！被找到了！是不是哥哥告诉你这个地方的呀…",
            "nextDialogs": [
              "240030202"
            ]
          },
          "240030202": {
            "id": "240030202",
            "speakerId": 1000,
            "speakerName": "韦吕",
            "text": "好吧…算你厉害！我去集合点啦。"
          }
        }
      }
    },

    {
      "subId": "2400303",
      "subQuestName": "寻找奥雷勒和韦吕",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240030701"
        ],
        "dialogs": {
          "240030701": {
            "id": "240030701",
            "speakerId": 1001,
            "speakerName": "奥雷勒",
            "text": "韦吕什么时候能懂点事呢，唉…",
            "nextDialogs": [
              "240030702"
            ]
          },
          "240030702": {
            "id": "240030702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不躲着吗？",
            "nextDialogs": [
              "240030703"
            ]
          },
          "240030703": {
            "id": "240030703",
            "speakerId": 1001,
            "speakerName": "奥雷勒",
            "text": "我本来就不怎么想玩。如果不是韦吕吵着要出来玩捉迷藏，我还想多看一会书呢。",
            "nextDialogs": [
              "240030704"
            ]
          },
          "240030704": {
            "id": "240030704",
            "speakerId": 1001,
            "speakerName": "奥雷勒",
            "text": "爸和妈工作很辛苦了，我要快点长大…这样才能为他们分担点压力。",
            "nextDialogs": [
              "240030705"
            ]
          },
          "240030705": {
            "id": "240030705",
            "speakerId": 1001,
            "speakerName": "奥雷勒",
            "text": "但韦吕一直说很想妈妈…我只能陪他玩会游戏，这样他就不会哭了。",
            "nextDialogs": [
              "240030706"
            ]
          },
          "240030706": {
            "id": "240030706",
            "speakerId": 1001,
            "speakerName": "奥雷勒",
            "text": "#抱歉，我说太多了，{M#大哥哥}{F#大姐姐}。我先去集合点等着了。",
            "nextDialogs": [
              "240030707"
            ]
          },
          "240030707": {
            "id": "240030707",
            "speakerId": 1001,
            "speakerName": "奥雷勒",
            "text": "希望韦吕不要把衣服弄脏了…"
          }
        }
      }
    },

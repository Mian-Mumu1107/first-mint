  "subQuests": [
    {
      "subId": "2400301",
      "subQuestName": "与韦吕对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240030101"
        ],
        "dialogs": {
          "240030101": {
            "id": "240030101",
            "speakerId": 1000,
            "speakerName": "韦吕",
            "text": "我这次藏的地方，你一定找不到！",
            "nextDialogs": [
              "240030102"
            ]
          },
          "240030102": {
            "id": "240030102",
            "speakerId": 1001,
            "speakerName": "奥雷勒",
            "text": "如果你藏在那些地方，去找你的人就不是我，而是爸和妈了。",
            "nextDialogs": [
              "240030103"
            ]
          },
          "240030103": {
            "id": "240030103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在做什么？",
            "nextDialogs": [
              "240030104"
            ]
          },
          "240030104": {
            "id": "240030104",
            "speakerId": 1000,
            "speakerName": "韦吕",
            "text": "我正在和哥哥捉迷藏呢！但是…我藏的每一个地方他都知道…",
            "nextDialogs": [
              "240030105"
            ]
          },
          "240030105": {
            "id": "240030105",
            "speakerId": 1001,
            "speakerName": "奥雷勒",
            "text": "韦吕…我们都在这里玩多久了，每一个能藏的角落都被你藏过了。",
            "nextDialogs": [
              "240030106"
            ]
          },
          "240030106": {
            "id": "240030106",
            "speakerId": 1001,
            "speakerName": "奥雷勒",
            "text": "至于那些不能藏的地方…我已经和你说过很多次不能藏那里的原因了。",
            "nextDialogs": [
              "240030107"
            ]
          },
          "240030107": {
            "id": "240030107",
            "speakerId": 1000,
            "speakerName": "韦吕",
            "text": "那些地方又没什么危险，爸和妈总是说得那么夸张…",
            "nextDialogs": [
              "240030108"
            ]
          },
          "240030108": {
            "id": "240030108",
            "speakerId": 1001,
            "speakerName": "奥雷勒",
            "text": "但你藏到那种地方会把衣服和裤子弄脏或者弄破，爸和妈工作已经很辛苦了，别让他们再费这种心。",
            "nextDialogs": [
              "240030109"
            ]
          },
          "240030109": {
            "id": "240030109",
            "speakerId": 1000,
            "speakerName": "韦吕",
            "text": "唔…好吧…",
            "nextDialogs": [
              "240030112"
            ]
          },
          "240030112": {
            "id": "240030112",
            "speakerId": 1000,
            "speakerName": "韦吕",
            "text": "#真的吗？！{M#大哥哥}{F#大姐姐}，你愿意陪我玩吗？",
            "nextDialogs": [
              "240030113"
            ]
          },
          "240030113": {
            "id": "240030113",
            "speakerId": 1001,
            "speakerName": "奥雷勒",
            "text": "韦吕，别给人家添麻烦！抱歉，我弟弟满脑子都想着玩…"
          }
        }
      }
    },
    {
      "subId": "2400302",
      "subQuestName": "寻找奥雷勒和韦吕",
      "sceneId": null,
      "locations": [],
      "dialogue": {

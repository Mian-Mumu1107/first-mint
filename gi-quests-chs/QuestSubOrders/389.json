    {
      "subId": "38906",
      "subQuestName": "(test)与温迪对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3890601"
        ],
        "dialogs": {
          "3890601": {
            "id": "3890601",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "没法更进一步了呢，在这座遗迹里好像有一些非常古老的<color=#00E1FFFF>封印</color>。",
            "nextDialogs": [
              "3890602"
            ]
          },
          "3890602": {
            "id": "3890602",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这也是特瓦林搞的鬼吗？",
            "nextDialogs": [
              "3890603"
            ]
          },
          "3890603": {
            "id": "3890603",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "不是的。这废墟曾经是远古的城市，特瓦林只是在这里临时居住而已。",
            "nextDialogs": [
              "3890604"
            ]
          },
          "3890604": {
            "id": "3890604",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "废墟本身，其实比「四风守护」的时代更古老。",
            "nextDialogs": [
              "3890605"
            ]
          },
          "3890605": {
            "id": "3890605",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "蒙德是无人称王的城邦，而在蒙德建立之前…",
            "nextDialogs": [
              "3890606"
            ]
          },
          "3890606": {
            "id": "3890606",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "曾有一位暴君统治这里…",
            "nextDialogs": [
              "3890607"
            ]
          },
          "3890607": {
            "id": "3890607",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯…以后如果有机会，再为你们演奏那位君王的故事吧。",
            "nextDialogs": [
              "3890608"
            ]
          },
          "3890608": {
            "id": "3890608",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "这封印的样式…按我所知的考古学知识，应该是<color=#00E1FFFF>「导光机关」</color>吧。",
            "nextDialogs": [
              "3890609"
            ]
          },
          "3890609": {
            "id": "3890609",
            "speakerId": 1002,
            "speakerName": "迪卢克",
            "text": "把散落的所有<color=#00E1FFFF>部件</color>放回<color=#00E1FFFF>本体</color>，就能完成<color=#00E1FFFF>导光的仪式</color>。",
            "nextDialogs": [
              "3890610"
            ]
          },
          "3890610": {
            "id": "3890610",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "从现场的状况看，这座机关的导光仪式似乎离完成不远了…",
            "nextDialogs": [
              "3890611"
            ]
          },
          "3890611": {
            "id": "3890611",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "先把<color=#00E1FFFF>最后的部件</color>放回去，再看看情况吧。"
          }
        }
      }
    }
  ]

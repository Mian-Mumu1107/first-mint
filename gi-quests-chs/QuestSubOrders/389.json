          },
          "3890303": {
            "id": "3890303",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…那边的<color=#00E1FFFF>屋顶</color>，是不是碎了个<color=#00E1FFFF>大洞</color>？",
            "nextDialogs": [

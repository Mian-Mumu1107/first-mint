        "dialogs": {
          "400480301": {
            "id": "400480301",
            "speakerId": 30106,
            "speakerName": "榎本",
            "text": "今泉啊，这是我一生的请求。",
            "nextDialogs": [
              "400480302"
            ]
          },
          "400480302": {
            "id": "400480302",
            "speakerId": 30107,
            "speakerName": "今泉",
            "text": "我不认识别的女孩子。别找我介绍了。",
            "nextDialogs": [
              "400480303"
            ]
          },
          "400480303": {
            "id": "400480303",
            "speakerId": 30106,
            "speakerName": "榎本",
            "text": "不是。这里没有镜子，麻烦你拿武器帮我刮一下胡子。",
            "nextDialogs": [
              "400480304"
            ]
          },
          "400480304": {
            "id": "400480304",
            "speakerId": 30107,
            "speakerName": "今泉",
            "text": "你这胡子比今年胡萝卜的苗都短，没什么必要刮。"

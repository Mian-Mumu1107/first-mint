    {
      "subId": "2401504",
      "subQuestName": "与德皮耶里对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240150401"
        ],
        "dialogs": {
          "240150401": {
            "id": "240150401",
            "speakerId": 1000,
            "speakerName": "德皮耶里",
            "text": "不对，不对…要是剔除了光影，那画面的层次怎么办…",
            "nextDialogs": [
              "240150402"
            ]
          },
          "240150402": {
            "id": "240150402",
            "speakerId": 1000,
            "speakerName": "德皮耶里",
            "text": "颜料的笔触表现力不够…画面的色彩也没有区分…",
            "nextDialogs": [
              "240150403"
            ]
          },
          "240150403": {
            "id": "240150403",
            "speakerId": 1000,
            "speakerName": "德皮耶里",
            "text": "见鬼，只不过剔除了几个要素…整个画面都变得一团糟！",
            "nextDialogs": [
              "240150406"
            ]
          },
          "240150406": {
            "id": "240150406",
            "speakerId": 1000,
            "speakerName": "德皮耶里",
            "text": "是您啊，见到您真好…",
            "nextDialogs": [
              "240150407"
            ]
          },
          "240150407": {
            "id": "240150407",
            "speakerId": 1000,
            "speakerName": "德皮耶里",
            "text": "抱歉让您误会了，我刚刚只是在思考画面的问题，不由自主地到处闲逛…",
            "nextDialogs": [
              "240150408"
            ]
          },
          "240150408": {
            "id": "240150408",
            "speakerId": 1000,
            "speakerName": "德皮耶里",
            "text": "您可能不能理解，但我在思考问题的时候，绝不能坐着不动。",
            "nextDialogs": [
              "240150409"
            ]
          },
          "240150409": {
            "id": "240150409",
            "speakerId": 1000,
            "speakerName": "德皮耶里",
            "text": "如果我一直待在一个地方思考问题，那我会变得越来越烦躁…所以我习惯一边散步一边思考问题。",
            "nextDialogs": [
              "240150410"
            ]
          },
          "240150410": {
            "id": "240150410",
            "speakerId": 1000,
            "speakerName": "德皮耶里",
            "text": "在用头脑思考的同时，让我的双腿自由行动，随它们带我去哪，只要别让我待在原地就行。",
            "nextDialogs": [
              "240150411"
            ]
          },
          "240150411": {
            "id": "240150411",
            "speakerId": 1000,
            "speakerName": "德皮耶里",
            "text": "所以…我经常会这样，让您担心了，非常抱歉。"
          }
        }
      }
    },
    {
      "subId": "2401507",

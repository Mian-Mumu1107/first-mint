    {
      "subId": "19023011",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "1902301191"
        ],
        "dialogs": {
          "1902301191": {
            "id": "1902301191",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「轻策山下，有一株琉璃袋变成了妖怪，体型巨硕无比，还会食人。」",
            "nextDialogs": [
              "1902301192"
            ]
          },
          "1902301192": {
            "id": "1902301192",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「绯云坡在夜里会有鬼影闪过，怀疑是怨念不散的妖邪。」",
            "nextDialogs": [
              "1902301193"
            ]
          },
          "1902301193": {
            "id": "1902301193",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「璃月港藏着一只由冰棍变成的大妖。」"
          }
        }
      }
    },
    {
      "subId": "19023015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "1902301591"
        ],
        "dialogs": {
          "1902301591": {
            "id": "1902301591",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「在云来海深处，有妖邪袭击渔商船只，正在建立豪华的宫殿。」",
            "nextDialogs": [
              "1902301592"
            ]
          },
          "1902301592": {
            "id": "1902301592",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「在绝云间的山上，有一块巨大的琥珀，千年的时间竟然令它拥有了神智，开始游荡作乱。」",
            "nextDialogs": [
              "1902301593"
            ]
          },
          "1902301593": {
            "id": "1902301593",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「听说经常有人，会在万民堂看见一只喜欢吃辣椒的妖魔。」"
          }
        }
      }
    },
    {
      "subId": "19023019",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "1902301905"
        ],
        "dialogs": {
          "1902301905": {
            "id": "1902301905",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「在归离原附近曾经远远看到过一个带着面具手持长枪的怪人，从他的身上能感到不太好的气息。」",
            "nextDialogs": [
              "1902301906"
            ]
          },
          "1902301906": {
            "id": "1902301906",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「我见过一个蓝色头发的方士，其实他是妖邪变化而成的！」",
            "nextDialogs": [
              "1902301907"
            ]
          },
          "1902301907": {
            "id": "1902301907",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「有一种妖邪擅长驱使浓雾，非常警觉，最近在明蕴镇，归离原，瑶光滩都发现了它的踪迹。」"
          }
        }
      }
    },
    {
      "subId": "19023021",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "1902302117"
        ],
        "dialogs": {
          "1902302117": {
            "id": "1902302117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "传闻不一定是假的，我们再找找吧。",
            "nextDialogs": [
              "1902302120"
            ]
          },
          "1902302120": {
            "id": "1902302120",
            "speakerId": 1023,
            "speakerName": "重云",
            "text": "嗯，说得对，我要振作起来。",
            "nextDialogs": [
              "1902302119"
            ]
          },
          "1902302119": {
            "id": "1902302119",
            "speakerId": 1023,
            "speakerName": "重云",
            "text": "啊，也对。说是「已经习惯」，结果却要你来安慰我，真是惭愧。"
          }
        }
      }
    }
  ]

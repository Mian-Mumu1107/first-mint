  },
  "subQuests": [
    {
      "subId": "7523201",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320101"
        ],
        "dialogs": {
          "752320101": {
            "id": "752320101",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "唔…这个苦味，是火烧草放多了吗？",
            "nextDialogs": [
              "752320104"
            ]
          },
          "752320104": {
            "id": "752320104",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "微光角菌…需要发酵后蒸煮…嗯，两轮…效果：微弱…",
            "nextDialogs": [
              "752320105"
            ]
          },
          "752320105": {
            "id": "752320105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…这家伙怎么不理人…"
          }
        }
      }
    },
    {
      "subId": "7523202",
      "subQuestName": "和埃兹莉交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320201"
        ],
        "dialogs": {
          "752320201": {
            "id": "752320201",
            "speakerId": 1002,
            "speakerName": "奇怪的花朵",
            "text": "（散发着微光的花蕾随着手指的抚摸轻轻摇摆，似乎正依照着某种无声的节律脉动…）",
            "nextDialogs": [
              "752320202"
            ]
          },
          "752320202": {
            "id": "752320202",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "请不要乱碰这朵花！",
            "nextDialogs": [
              "752320204",
              "752320206"
            ]
          },
          "752320204": {
            "id": "752320204",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "你还挺有礼貌。难怪它不讨厌你呢。",
            "nextDialogs": [
              "752320207"
            ]
          },
          "752320207": {
            "id": "752320207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？仔细一看，它像是在「跳舞」呢！",
            "nextDialogs": [
              "752320208"
            ]
          },
          "752320208": {
            "id": "752320208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它在…蠕动。",
            "nextDialogs": [
              "752320209"
            ]
          },
          "752320209": {
            "id": "752320209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜啊…不要用那么恶心的词来形容花啦！不如说是在「舞动」呢。",
            "nextDialogs": [
              "752320210"
            ]
          },
          "752320210": {
            "id": "752320210",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "嗯，「厄尔齐丽之舞」。只有当暝视天赋很强的人靠近时，它才会起这样的反应。",
            "nextDialogs": [
              "752320211"
            ]
          },
          "752320211": {
            "id": "752320211",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "这是因为醅幽花会从这片土地上缥缈的灵性中吸收养料，从而产生独特的花蜜，这种花蜜能够增强生物对梦境的敏感性。",
            "nextDialogs": [
              "752320212"
            ]
          },
          "752320212": {
            "id": "752320212",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "有些人…唔，我该怎么说呢，生来便有灵性。因而吸收灵性物质的醅幽花对他们更加亲切，毕竟传说它是跨越两界的植物嘛。",
            "nextDialogs": [
              "752320213"
            ]
          },
          "752320213": {
            "id": "752320213",
            "speakerId": 1003,
            "speakerName": "埃兹莉",
            "text": "顺便，我是「怪眼」埃兹莉！「醅蜜」酒吧的酿酒师。你们叫什么？"
          },
          "752320206": {
            "id": "752320206",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "油嘴滑舌。不过，它确实不讨厌你呢。"
          }
        }
      }
    },
    {
      "subId": "7523218",
      "subQuestName": "和埃兹莉交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320301"
        ],
        "dialogs": {
          "752320301": {
            "id": "752320301",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "你们看，这就是我的「美梦汲取瓶」，可以用它来吸取醅幽花中的高纯度花粉。",
            "nextDialogs": [
              "752320302"
            ]
          },
          "752320302": {
            "id": "752320302",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "只不过你们得先把坏花挑出来，也就是有杂质的花。",
            "nextDialogs": [
              "752320303"
            ]
          },
          "752320303": {
            "id": "752320303",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "它们凝结了太多来自大地之下的杂质，对饮料的预期效果和安全性都很不利。",
            "nextDialogs": [
              "752320304"
            ]
          },
          "752320304": {
            "id": "752320304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可是我们要怎么分辨呢？",
            "nextDialogs": [
              "752320305"
            ]
          },
          "752320305": {
            "id": "752320305",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "它们是会对特殊体质产生反应的花朵。虽然不清楚是怎么样的反应，但如果靠得足够近，异状一定会格外显眼的。",
            "nextDialogs": [
              "752320306"
            ]
          },
          "752320306": {
            "id": "752320306",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "等你们进入花田就知道了。"
          }
        }
      }
    },
    {
      "subId": "7523203",
      "subQuestName": "调查花田的问题",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7523204",
      "subQuestName": "和埃兹莉交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320401"
        ],
        "dialogs": {
          "752320401": {
            "id": "752320401",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "让我看看…嗯！「美梦汲取瓶」里的花粉纯度很高。",
            "nextDialogs": [
              "752320402"
            ]
          },
          "752320402": {
            "id": "752320402",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "太好了，刚才那朵就是带着杂质的家伙。",
            "nextDialogs": [
              "752320403"
            ]
          },
          "752320403": {
            "id": "752320403",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "「怪眼」埃兹莉将提取的花蜜样本小心翼翼地倾倒进随身携带的小瓶中，然后又取出几瓶色彩奇特的药剂，往小瓶中滴了几滴…",
            "nextDialogs": [
              "752320404"
            ]
          },
          "752320404": {
            "id": "752320404",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "几分钟后…",
            "nextDialogs": [
              "752320405"
            ]
          },
          "752320405": {
            "id": "752320405",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "嗯…从样本来看，纯度非常完美，并没有杂质沉淀物。太好啦！",
            "nextDialogs": [
              "752320406"
            ]
          },
          "752320406": {
            "id": "752320406",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "一鼓作气…我们继续搞定另外两片花田吧！"
          }
        }
      }
    },
    {
      "subId": "7523205",
      "subQuestName": "调查花田的问题",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320501"
        ],
        "dialogs": {
          "752320501": {
            "id": "752320501",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "呼噜噜噜噜…",
            "nextDialogs": [
              "752320502"
            ]
          },
          "752320502": {
            "id": "752320502",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "呜喵？",
            "nextDialogs": [
              "752320506",
              "752320505"
            ]
          },
          "752320506": {
            "id": "752320506",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "埃兹莉，你这臭女人！你背着我养人类了吗！",
            "nextDialogs": [
              "752320507"
            ]
          },
          "752320507": {
            "id": "752320507",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "啊…人类…没教养的、肮脏的、臭臭的人类！",
            "nextDialogs": [
              "752320508"
            ]
          },
          "752320508": {
            "id": "752320508",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "你妈妈没有教过你，该怎么样对待一株可怜的、孤独的、自以为自由的脆弱小花…呜呜…",
            "nextDialogs": [
              "752320509"
            ]
          },
          "752320509": {
            "id": "752320509",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "呜呜…顺便，我是「苍白的丹巴拉」，叫我丹巴拉就好。",
            "nextDialogs": [
              "752320510"
            ]
          },
          "752320510": {
            "id": "752320510",
            "speakerId": 1005,
            "speakerName": "丹巴拉",
            "text": "来呀！无法无天的入侵者，有胆就面对我的利爪和尖牙！",
            "nextDialogs": [
              "752320511"
            ]
          },
          "752320511": {
            "id": "752320511",
            "speakerId": 1005,
            "speakerName": "丹巴拉",
            "text": "等等，你怎么还不退下！是我的威慑力还不够吗！呃…"
          },
          "752320505": {
            "id": "752320505",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "喵哇！！",
            "nextDialogs": [
              "752320525"
            ]
          },
          "752320525": {
            "id": "752320525",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "你挥剑砍向小猫的幻象，它应声消散了…"
          }
        }
      }
    },
    {
      "subId": "7523206",
      "subQuestName": "和埃兹莉交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320801"
        ],
        "dialogs": {
          "752320801": {
            "id": "752320801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「怪眼」小姐，我们回来啦！",
            "nextDialogs": [
              "752320802"
            ]
          },
          "752320802": {
            "id": "752320802",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#这片花田里居然有三朵坏花！呃，只不过{NICKNAME}的表现好奇怪哦…不会有问题吧…？",
            "nextDialogs": [
              "752320805"
            ]
          },
          "752320805": {
            "id": "752320805",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "幻觉吗？那应该没事的，醅幽花释放致幻花粉是常见的自保手段。它们应该是对你格外敏感。",
            "nextDialogs": [
              "752320806"
            ]
          },
          "752320806": {
            "id": "752320806",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "我和派蒙看不到你所看见的幻觉，是因为花粉的致幻作用不会对我们生效而已。",
            "nextDialogs": [
              "752320807"
            ]
          },
          "752320807": {
            "id": "752320807",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "#只不过…唔，{NICKNAME}还有什么其他不适感吗？",
            "nextDialogs": [
              "752320808"
            ]
          },
          "752320808": {
            "id": "752320808",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我没有…",
            "nextDialogs": [
              "752320809"
            ]
          },
          "752320809": {
            "id": "752320809",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "那我就暂且相信你…但如果你感觉身体有问题请一定跟我说。",
            "nextDialogs": [
              "752320810"
            ]
          },
          "752320810": {
            "id": "752320810",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我们就一鼓作气完成最后一片花田吧！"
          }
        }
      }
    },
    {
      "subId": "7523207",
      "subQuestName": "调查花田的问题",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320701"
        ],
        "dialogs": {
          "752320701": {
            "id": "752320701",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哼哼…嗯…哼哼…",
            "nextDialogs": [
              "752320703",
              "752320705",
              "752320707"
            ]
          },
          "752320703": {
            "id": "752320703",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哼哼？",
            "nextDialogs": [
              "752320708"
            ]
          },
          "752320708": {
            "id": "752320708",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哼呜，哼呜。"
          },
          "752320705": {
            "id": "752320705",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哼！哼！"
          },
          "752320707": {
            "id": "752320707",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哼哼？！",
            "nextDialogs": [
              "752320722"
            ]
          },
          "752320722": {
            "id": "752320722",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "你挥剑砍向林猪，它惨叫一声倒下了…"
          }
        }
      }
    },
    {
      "subId": "7523215",
      "subQuestName": "和派蒙交谈$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752321001"
        ],
        "dialogs": {
          "752321001": {
            "id": "752321001",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "「再会了，星空之子！如果我不能和你再在这个国度相遇…那么我会，我会在另一个国度等你…」\\n",
            "nextDialogs": [
              "752321002"
            ]
          },
          "752321002": {
            "id": "752321002",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "「可不要迟到，不要迟到哟…」",
            "nextDialogs": [
              "752321003"
            ]
          },
          "752321003": {
            "id": "752321003",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "在浓烈黏腻的花香中，你感到一阵眩晕…\\n等到意识再度恢复时，你看到派蒙正焦急地围着你打转。",
            "nextDialogs": [
              "752321004"
            ]
          },
          "752321004": {
            "id": "752321004",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，醒醒！你还好吗！我们找到那朵花了！",
            "nextDialogs": [
              "752321005"
            ]
          },
          "752321005": {
            "id": "752321005",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇…你刚才就在这里发呆，是又看见了幻觉吗？",
            "nextDialogs": [
              "752321006"
            ]
          },
          "752321006": {
            "id": "752321006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先用美梦汲取瓶吧。",
            "nextDialogs": [
              "752321007"
            ]
          },
          "752321007": {
            "id": "752321007",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，总之你没事就好。"
          }
        }
      }
    },
    {
      "subId": "7523208",
      "subQuestName": "和埃兹莉交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752321101"
        ],
        "dialogs": {
          "752321101": {
            "id": "752321101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「怪眼」小姐！我们发现你说的那朵怪花啦！",
            "nextDialogs": [
              "752321102"
            ]
          },
          "752321102": {
            "id": "752321102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#但是…{NICKNAME}变得好怪…你知道是怎么回事吗！",
            "nextDialogs": [
              "752321103"
            ]
          },
          "752321103": {
            "id": "752321103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我没事，只是头有点晕晕的…",
            "nextDialogs": [
              "752321104"
            ]
          },
          "752321104": {
            "id": "752321104",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "你们在那里发现什么了？是什么危险的幻象吗？",
            "nextDialogs": [
              "752321105"
            ]
          },
          "752321105": {
            "id": "752321105",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "你为埃兹莉具言了所见的幻象…",
            "nextDialogs": [
              "752321106"
            ]
          },
          "752321106": {
            "id": "752321106",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "「巫医爸爸的恶作剧」…",
            "nextDialogs": [
              "752321107"
            ]
          },
          "752321107": {
            "id": "752321107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那是什么？",
            "nextDialogs": [
              "752321108"
            ]
          },
          "752321108": {
            "id": "752321108",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "「巫医爸爸」是在萨满和酿酒师中间流传的一个传说。人们说他会指引那些不幸而未能光荣战死的人的魂灵。",
            "nextDialogs": [
              "752321109"
            ]
          },
          "752321109": {
            "id": "752321109",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "这家伙是个把恐怖当游戏的恶劣家伙，所以他经常制造诡异的噩梦，来玩弄那些被他注意到的生者。",
            "nextDialogs": [
              "752321110"
            ]
          },
          "752321110": {
            "id": "752321110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "752321111"
            ]
          },
          "752321111": {
            "id": "752321111",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "#噗哧…总之，让我检查一下{NICKNAME}的身体，应该不会有什么大碍的。",
            "nextDialogs": [
              "752321113"
            ]
          },
          "752321113": {
            "id": "752321113",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "#不用担心啦。{NICKNAME}只是吸入了太多致幻花粉，可能会头晕一段时间，除此之外没什么大碍。",
            "nextDialogs": [
              "752321114"
            ]
          },
          "752321114": {
            "id": "752321114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦…",
            "nextDialogs": [
              "752321115"
            ]
          },
          "752321115": {
            "id": "752321115",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "不过如果脑袋有点损伤，导致智力下降什么的…那种病我就治不了啦！",
            "nextDialogs": [
              "752321116"
            ]
          },
          "752321116": {
            "id": "752321116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！",
            "nextDialogs": [
              "752321117"
            ]
          },
          "752321117": {
            "id": "752321117",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哈哈，我开玩笑的！现在让我完成最后的工作吧。",
            "nextDialogs": [
              "752321118"
            ]
          },
          "752321118": {
            "id": "752321118",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "「怪眼」埃兹莉将提取的花蜜样本小心翼翼地倾倒进随身携带的小瓶中，然后又取出几瓶色彩奇特的药剂，往小瓶中滴了几滴…",
            "nextDialogs": [
              "752321119"
            ]
          },
          "752321119": {
            "id": "752321119",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "几分钟后…",
            "nextDialogs": [
              "752321120"
            ]
          },
          "752321120": {
            "id": "752321120",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "纯度…嗯，杂质沉淀物…嗯。毒性…好。终于完成了！",
            "nextDialogs": [
              "752321121"
            ]
          },
          "752321121": {
            "id": "752321121",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "现在全部完成了，谢谢你们！这是给你们的报酬！",
            "nextDialogs": [
              "752321122"
            ]
          },
          "752321122": {
            "id": "752321122",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，谢谢！",
            "nextDialogs": [
              "752321123"
            ]
          },
          "752321123": {
            "id": "752321123",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "那个，请留步…！事情还没有结束哦！",
            "nextDialogs": [
              "752321124"
            ]
          },
          "752321124": {
            "id": "752321124",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "我接下来会开始调配我的「美梦特调」了。我希望到时候你能来，再让我借助一下你的暝视潜能。",
            "nextDialogs": [
              "752321125"
            ]
          },
          "752321125": {
            "id": "752321125",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "嗯…以这个进度来看，也许明天就能出结果，明天来找我就好！到时候，说不定新饮料会以你的名字命名呢！",
            "nextDialogs": [
              "752321126"
            ]
          },
          "752321126": {
            "id": "752321126",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "而且我也会解答你之前的疑问，所以请不要忘记过来呀！"
          }
        }
      }
    },
    {
      "subId": "7523211",
      "subQuestName": "等到第二天",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7523210",
      "subQuestName": "与埃兹莉对话，品尝一下美梦饮料",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752321201"
        ],
        "dialogs": {
          "752321201": {
            "id": "752321201",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哈哈，还记得我说过的「美梦特调」吗？我有一个好消息要告诉你们！",
            "nextDialogs": [
              "752321202"
            ]
          },
          "752321202": {
            "id": "752321202",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "经过一整天的努力，我已经调制成功了！",
            "nextDialogs": [
              "752321203"
            ]
          },
          "752321203": {
            "id": "752321203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，恭喜你！",
            "nextDialogs": [
              "752321204"
            ]
          },
          "752321204": {
            "id": "752321204",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "嘿嘿，而你们就是有幸最先体验美梦的幸运顾客！费用记在我老姐账上就好！",
            "nextDialogs": [
              "752321205"
            ]
          },
          "752321205": {
            "id": "752321205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！好耶！",
            "nextDialogs": [
              "752321206"
            ]
          },
          "752321206": {
            "id": "752321206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，不对…这么说，我们不就成了试验品了嘛…",
            "nextDialogs": [
              "752321207"
            ]
          },
          "752321207": {
            "id": "752321207",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "当然，荣幸吧？",
            "nextDialogs": [
              "752321208"
            ]
          },
          "752321208": {
            "id": "752321208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一点也不！",
            "nextDialogs": [
              "752321211"
            ]
          },
          "752321211": {
            "id": "752321211",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "嗯？ 哦，对哦…让我想想怎么说呢…",
            "nextDialogs": [
              "752321212"
            ]
          },
          "752321212": {
            "id": "752321212",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "首先我要警告你，醅幽花的提取物是有剧毒的，但经过反复蒸馏之后，我已经将毒性筛除至正常人可以接受的范围内。",
            "nextDialogs": [
              "752321213"
            ]
          },
          "752321213": {
            "id": "752321213",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "也就是说，一般人喝下它的话，肉体会在几秒钟内「死亡」…嗯，五秒之内。",
            "nextDialogs": [
              "752321214"
            ]
          },
          "752321214": {
            "id": "752321214",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "而「灵魂」…唔，我是说，假设我们可以这样称呼的话，会在这个世界和死者之地交叠的景色中漫步。",
            "nextDialogs": [
              "752321215"
            ]
          },
          "752321215": {
            "id": "752321215",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来还是好危险…！"
          }
        }
      }
    },
    {
      "subId": "7523216",
      "subQuestName": "品味美梦…",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752321301"
        ],
        "dialogs": {
          "752321301": {
            "id": "752321301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "Wah! Mi zido mita dada! Mmm~yaya dada! Movo dada!",
            "nextDialogs": [
              "752321302"
            ]
          },
          "752321302": {
            "id": "752321302",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "Olah! Mosi mita yo! Sada mimi dada! Sada domu dada!",
            "nextDialogs": [
              "752321304",
              "752321306"
            ]
          },
          "752321304": {
            "id": "752321304",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "我是你的朋友！你也是我的朋友，我们都是好朋友！",
            "nextDialogs": [
              "752321307"
            ]
          },
          "752321307": {
            "id": "752321307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "Ahaha! Mi zido mita dada!",
            "nextDialogs": [
              "752321308"
            ]
          },
          "752321308": {
            "id": "752321308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sado! Yo beru mimi beru?!",
            "nextDialogs": [
              "752321309"
            ]
          },
          "752321309": {
            "id": "752321309",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哈哈，你在说什么呢！是你先说了我们的语言！",
            "nextDialogs": [
              "752321310"
            ]
          },
          "752321310": {
            "id": "752321310",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "Sama! Mito! Ya upa dala?",
            "nextDialogs": [
              "752321311"
            ]
          },
          "752321311": {
            "id": "752321311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ya upa dala?",
            "nextDialogs": [
              "752321312"
            ]
          },
          "752321312": {
            "id": "752321312",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "啊哈哈，在那上面是宝藏！我们去挖宝藏！",
            "nextDialogs": [
              "752321313"
            ]
          },
          "752321313": {
            "id": "752321313",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "宝藏就在这里，我们分享！",
            "nextDialogs": [
              "752321314"
            ]
          },
          "752321314": {
            "id": "752321314",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "Mimi Mani! Mimi mosi! Mimi muhe!",
            "nextDialogs": [
              "752321315"
            ]
          },
          "752321315": {
            "id": "752321315",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Mimi muhe!",
            "nextDialogs": [
              "752321316"
            ]
          },
          "752321316": {
            "id": "752321316",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "好耶，是宝藏！",
            "nextDialogs": [
              "752321317"
            ]
          },
          "752321317": {
            "id": "752321317",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "Mosi mita! Mita dada! Hahahahahaha!",
            "nextDialogs": [
              "752321318"
            ]
          },
          "752321318": {
            "id": "752321318",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Unta dada, yoyo upa, nunu beru valo yoyo…"
          },
          "752321306": {
            "id": "752321306",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哦，你在一个快乐的地方，快乐的地方！"
          }
        }
      }
    },
    {
      "subId": "7523217",
      "subQuestName": "和埃兹莉交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752321419"
        ],
        "dialogs": {
          "752321419": {
            "id": "752321419",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "怎么样？我的「美梦特调」好喝吗？",
            "nextDialogs": [
              "752321420"
            ]
          },
          "752321420": {
            "id": "752321420",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#…呜哇，我的头好痛…{NICKNAME}，你呢？",
            "nextDialogs": [
              "752321421"
            ]
          },
          "752321421": {
            "id": "752321421",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们做了一个好怪异的梦…",
            "nextDialogs": [
              "752321422"
            ]
          },
          "752321422": {
            "id": "752321422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们梦见和丘丘人一起…挖宝藏？",
            "nextDialogs": [
              "752321423"
            ]
          },
          "752321423": {
            "id": "752321423",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…好难解释发生了什么…话说回来，我们「死掉」了很长时间吗？",
            "nextDialogs": [
              "752321424"
            ]
          },
          "752321424": {
            "id": "752321424",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "是哇，我也死了很久了。",
            "nextDialogs": [
              "752321425"
            ]
          },
          "752321425": {
            "id": "752321425",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？！",
            "nextDialogs": [
              "752321426"
            ]
          },
          "752321426": {
            "id": "752321426",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哈哈哈哈哈！没有啦！只有几秒钟而已…我还以为没有效果呢。",
            "nextDialogs": [
              "752321427"
            ]
          },
          "752321427": {
            "id": "752321427",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "既然有效果就好，接下来请你们详细描述一下自己做了什么梦吧！我会记录下来的。",
            "nextDialogs": [
              "752321428"
            ]
          },
          "752321428": {
            "id": "752321428",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊？唔…我们尽量吧！",
            "nextDialogs": [
              "752321429"
            ]
          },
          "752321429": {
            "id": "752321429",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "你与派蒙尽可能地拼凑着光怪陆离的梦境，「怪眼」埃兹莉津津有味地记录了下来。",
            "nextDialogs": [
              "752321430"
            ]
          },
          "752321430": {
            "id": "752321430",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哈哈，太好了！虽然乱七八糟的…但总体来说是个很开心的幻梦！",
            "nextDialogs": [
              "752321431"
            ]
          },
          "752321431": {
            "id": "752321431",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "不过为什么会梦到丘丘人？真是奇怪…",
            "nextDialogs": [
              "752321432"
            ]
          },
          "752321432": {
            "id": "752321432",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "不过那些问题留给我和老姐解决就好，这里是你们的报酬！",
            "nextDialogs": [
              "752321433"
            ]
          },
          "752321433": {
            "id": "752321433",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…那个…接下来你真的要把这个奇怪饮料上架吗？",
            "nextDialogs": [
              "752321434"
            ]
          },
          "752321434": {
            "id": "752321434",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "那还差得远呢，至少还要再请一些不同体质的人来试验。",
            "nextDialogs": [
              "752321435"
            ]
          },
          "752321435": {
            "id": "752321435",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "离开了这，你们不会在任何地方见到它，相当一段长时间内。",
            "nextDialogs": [
              "752321436"
            ]
          },
          "752321436": {
            "id": "752321436",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呼…那样说我们稍微有点放心啦…毕竟它的功能感觉相当强大。",
            "nextDialogs": [
              "752321437"
            ]
          },
          "752321437": {
            "id": "752321437",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实很怪异。",
            "nextDialogs": [
              "752321438"
            ]
          },
          "752321438": {
            "id": "752321438",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "噗哧…好啦，我知道了！",
            "nextDialogs": [
              "752321439"
            ]
          },
          "752321439": {
            "id": "752321439",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "既然实验已经结束了，我也该放你们走了！",
            "nextDialogs": [
              "752321440"
            ]
          },
          "752321440": {
            "id": "752321440",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "如果身体不适、有后遗症的话，请一定回来找我！",
            "nextDialogs": [
              "752321441"
            ]
          },
          "752321441": {
            "id": "752321441",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们知道啦！"
          }
        }
      }
    },
    {
      "subId": "7523206",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752320601"
        ],
        "dialogs": {
          "752320601": {
            "id": "752320601",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "呜呜呜…呜汪！汪汪！",
            "nextDialogs": [
              "752320602"
            ]
          },
          "752320602": {
            "id": "752320602",
            "speakerId": 1006,
            "speakerName": "布利安努斯爵士",
            "text": "我是此地的骑士，阿汪·布利安努斯爵士，请问来者姓名是…？",
            "nextDialogs": [
              "752320612",
              "752320604"
            ]
          },
          "752320612": {
            "id": "752320612",
            "speakerId": 1006,
            "speakerName": "布利安努斯爵士",
            "text": "#嗷呜，{NICKNAME}{M#先生}{F#小姐}，幸会。请问，您来到这里有何贵干呢？",
            "nextDialogs": [
              "752320615"
            ]
          },
          "752320615": {
            "id": "752320615",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我是来找您所保护的那朵花的。",
            "nextDialogs": [
              "752320616"
            ]
          },
          "752320616": {

  "subQuests": [
    {
      "subId": "7715101",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771510101"
        ],
        "dialogs": {
          "771510101": {
            "id": "771510101",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "嗯…还有许多地方要重新建设…",
            "nextDialogs": [
              "771510103",
              "771510107",
              "771510112"
            ]
          },
          "771510103": {
            "id": "771510103",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "最近情况还不错，之前因为「伊兹梅洛」逃走的伐木工人也回来了。",
            "nextDialogs": [
              "771510104"
            ]
          },
          "771510104": {
            "id": "771510104",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "而且，听说是「伊兹梅洛」的人造成的破坏，有位叫兹梅伊的先生也在一天夜里找到我…说是愿意帮助我一同恢复伐木场。",
            "nextDialogs": [
              "771510105"
            ]
          },
          "771510105": {
            "id": "771510105",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "虽然离原本的伐木场还有点距离…不过有了这些人的帮助，还有那笔「大盗宝藏」，完全恢复指日可待啊…"
          },
          "771510107": {
            "id": "771510107",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "呃…多尼娅小姐…",
            "nextDialogs": [
              "771510108"
            ]
          },
          "771510108": {
            "id": "771510108",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "她在这里也帮了很多忙，但是没过多久，几位契科塔…也就是运输局总部的警探来了解情况。",
            "nextDialogs": [
              "771510109"
            ]
          },
          "771510109": {
            "id": "771510109",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "其中一位似乎是多尼娅小姐的前辈，听闻多尼娅小姐的行为后气极反笑，一把提溜起多尼娅小姐，回新基捷城那去了…",
            "nextDialogs": [
              "771510110"
            ]
          },
          "771510110": {
            "id": "771510110",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "希望、希望她没事吧…"
          },
          "771510112": {
            "id": "771510112",
            "speakerId": 22601,
            "speakerName": "格里克",
            "text": "哦哦，没事…"
          }
        }
      }
    },

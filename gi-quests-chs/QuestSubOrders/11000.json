    {
      "subId": "1100003",
      "subQuestName": "与香菱交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110000301"
        ],
        "dialogs": {
          "110000301": {
            "id": "110000301",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "小声点，我正在打猎呢。",
            "nextDialogs": [
              "110000302"
            ]
          },
          "110000302": {
            "id": "110000302",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "早就听说蒙德有很多好食材，现在一看果然名不虚传！",
            "nextDialogs": [
              "110000305"
            ]
          },
          "110000305": {
            "id": "110000305",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "不不不，我是个厨师，立志走遍各地，搜寻珍奇食材的厨师！",
            "nextDialogs": [
              "110000306"
            ]
          },
          "110000306": {
            "id": "110000306",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我叫香菱，从璃月港来，你们呢？",
            "nextDialogs": [
              "110000307"
            ]
          },
          "110000307": {
            "id": "110000307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#我叫{NICKNAME}。",
            "nextDialogs": [
              "110000308"
            ]
          },
          "110000308": {
            "id": "110000308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好啊，我是派蒙。",
            "nextDialogs": [
              "110000309"
            ]
          },
          "110000309": {
            "id": "110000309",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "派蒙！",
            "nextDialogs": [
              "110000310"
            ]
          },
          "110000310": {
            "id": "110000310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么了？为什么突然盯着我看？",
            "nextDialogs": [
              "110000311"
            ]
          },
          "110000311": {
            "id": "110000311",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "好奇妙的生物，这个可以吃吗？"
          }
        }
      }
    },
    {
      "subId": "1100004",
      "subQuestName": "帮助香菱收集兽肉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110000401"
        ],
        "dialogs": {
          "110000401": {
            "id": "110000401",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "这里的野猪太肥美了，还很有活力，肉质一定是极棒的。",
            "nextDialogs": [
              "110000402"
            ]
          },
          "110000402": {
            "id": "110000402",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "啊，说着说着肚子就饿了…"
          }
        }
      }
    },
    {
      "subId": "1100005",
      "subQuestName": "将三块兽肉交给香菱",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110000501"
        ],
        "dialogs": {
          "110000501": {
            "id": "110000501",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "哇，有这么多，一部分用来煎，一部分配上蘑菇炒，还有些和史莱姆凝液试试看…",
            "nextDialogs": [
              "110000503",
              "110000505"
            ]
          },
          "110000503": {
            "id": "110000503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们很自然地被忽略了…",
            "nextDialogs": [
              "110000506"
            ]
          },
          "110000506": {
            "id": "110000506",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "啊啊，不好意思不好意思，一不小心就去想菜谱了。",
            "nextDialogs": [
              "110000507"
            ]
          },
          "110000507": {
            "id": "110000507",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "这个是答应送你们的好吃的。现在就尝尝看吧！把感想告诉我！",
            "nextDialogs": [
              "110000508"
            ]
          },
          "110000508": {
            "id": "110000508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们是被当成试菜员了吗？",
            "nextDialogs": [
              "110000509"
            ]
          },
          "110000509": {
            "id": "110000509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦！这、这个…太好吃了！",
            "nextDialogs": [
              "110000510"
            ]
          },
          "110000510": {
            "id": "110000510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可以告诉我们是怎么做的吗！",
            "nextDialogs": [
              "110000511"
            ]
          },
          "110000511": {
            "id": "110000511",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "嘿嘿，当然可以了！只不过我还没有写成菜谱，我想想看…",
            "nextDialogs": [
              "110000512"
            ]
          },
          "110000512": {
            "id": "110000512",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "要不然这样吧！我现在再做一次，你们就照着学！看一遍肯定就明白了吧！",
            "nextDialogs": [
              "110000513"
            ]
          },
          "110000513": {
            "id": "110000513",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么复杂的菜看一次也记不住啦…而且锅和调味料都没有。",
            "nextDialogs": [
              "110000514"
            ]
          },
          "110000514": {
            "id": "110000514",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "哎呀，这还不简单。",
            "nextDialogs": [
              "110000515"
            ]
          },
          "110000515": {
            "id": "110000515",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "锅用岩板，油用刚刚猎到的野猪的油，搬石头堆成灶，木头和茅草生旺火。",
            "nextDialogs": [
              "110000516"
            ]
          },
          "110000516": {
            "id": "110000516",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "糖用甜甜花，至于盐，我之前在一个洞穴里找到了很多崖盐，够用好几天的。"
          },
          "110000505": {
            "id": "110000505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嘿嘿，{NICKNAME}你终于能理解我的喜好了。"
          }
        }
      }
    }
  ]
}
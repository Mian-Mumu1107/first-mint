    {
      "subId": "7614807",
      "subQuestName": "与伊斯托利亚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761480701"
        ],
        "dialogs": {
          "761480701": {
            "id": "761480701",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "又回到这里了…",
            "nextDialogs": [
              "761480702"
            ]
          },
          "761480702": {
            "id": "761480702",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "上次来这里，按照人的寿命来算都是前前前前前前…世时候的事了吧。",
            "nextDialogs": [
              "761480703"
            ]
          },
          "761480703": {
            "id": "761480703",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "看来我们都被重新投入无想之间了。",
            "nextDialogs": [
              "761480704"
            ]
          },
          "761480704": {
            "id": "761480704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以我们应该怎么出去？",
            "nextDialogs": [
              "761480705"
            ]
          },
          "761480705": {
            "id": "761480705",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "常规办法就是学习冥想，控制心和思绪。然后抛弃所有渴望的念头。",
            "nextDialogs": [
              "761480706"
            ]
          },
          "761480706": {
            "id": "761480706",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "保持什么都不想的状态。",
            "nextDialogs": [
              "761480707"
            ]
          },
          "761480707": {
            "id": "761480707",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "说着挺简单的。但是根据人的素质和渴望程度之不同，办到这一点从几年到几百年的都有。",
            "nextDialogs": [
              "761480708"
            ]
          },
          "761480708": {
            "id": "761480708",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "像你这种背负世界命运的人，渴望恐怕无法被自己割舍吧。何况也不应该被舍弃。",
            "nextDialogs": [
              "761480709"
            ]
          },
          "761480709": {
            "id": "761480709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那怎么办？",
            "nextDialogs": [
              "761480710"
            ]
          },
          "761480710": {
            "id": "761480710",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "先找到彩特琳德再想办法吧。",
            "nextDialogs": [
              "761480711"
            ]
          },
          "761480711": {
            "id": "761480711",
            "speakerId": 22438,
            "speakerName": "小右",
            "text": "！",
            "nextDialogs": [
              "761480712"
            ]
          },
          "761480712": {
            "id": "761480712",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你捡来了什么？",
            "nextDialogs": [
              "761480713"
            ]
          },
          "761480713": {
            "id": "761480713",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "等等，小右也一起被拉进来了？",
            "nextDialogs": [
              "761480714"
            ]
          },
          "761480714": {
            "id": "761480714",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "那么这一切或许还有转机。",
            "nextDialogs": [
              "761480715"
            ]
          },
          "761480715": {
            "id": "761480715",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "同为守望者，或许小右可以利用这些碎片里的力量。强行开辟一条出路。",
            "nextDialogs": [
              "761480716"
            ]
          },
          "761480716": {
            "id": "761480716",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "这个碎片总归是需要个名字方便称呼的。",
            "nextDialogs": [
              "761480717"
            ]
          },
          "761480717": {
            "id": "761480717",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "这些过于夸张的棺材我略有耳闻，是神殿主人某个姐妹的布置。好像是叫做「死随念棺」。",
            "nextDialogs": [
              "761480718"
            ]
          },
          "761480718": {
            "id": "761480718",
            "speakerId": 22306,
            "speakerName": "伊斯托利亚",
            "text": "那这些碎片就叫做「念亡碎片」吧。"
          }
        }
      }
    },

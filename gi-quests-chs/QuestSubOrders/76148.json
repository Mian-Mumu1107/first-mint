  "subQuests": [
    {
      "subId": "7614801",
      "subQuestName": "(test)废弃",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761480101"
        ],
        "dialogs": {
          "761480101": {
            "id": "761480101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜啊，你们刚才去哪里了！吓死我了。",
            "nextDialogs": [
              "761480102"
            ]
          },
          "761480102": {
            "id": "761480102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我一直在喊你的名字。",
            "nextDialogs": [
              "761480103"
            ]
          },
          "761480103": {
            "id": "761480103",
            "speakerId": 1844,
            "speakerName": "伊斯托利亚",
            "text": "为什么派蒙这个小家伙没有被拉入无想之间？",
            "nextDialogs": [
              "761480104"
            ]
          },
          "761480104": {
            "id": "761480104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可能她除了吃和睡…",
            "nextDialogs": [
              "761480105"
            ]
          },
          "761480105": {
            "id": "761480105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…本身就什么也不想吧。",
            "nextDialogs": [
              "761480106"
            ]
          },
          "761480106": {
            "id": "761480106",
            "speakerId": 1844,
            "speakerName": "伊斯托利亚",
            "text": "有道理。",
            "nextDialogs": [
              "761480107"
            ]
          },
          "761480107": {
            "id": "761480107",
            "speakerId": 1844,
            "speakerName": "伊斯托利亚",
            "text": "看来梅兰塔真的生气了。",
            "nextDialogs": [
              "761480108"
            ]
          },
          "761480108": {
            "id": "761480108",
            "speakerId": 1844,
            "speakerName": "伊斯托利亚",
            "text": "#送{NICKNAME}上去直面梅兰塔之事已是迫在眉睫了。",
            "nextDialogs": [
              "761480109"
            ]
          },
          "761480109": {
            "id": "761480109",
            "speakerId": 1844,
            "speakerName": "伊斯托利亚",
            "text": "换个地方说话吧。这里也不是很安全。",
            "nextDialogs": [
              "761480110"
            ]
          },
          "761480110": {
            "id": "761480110",
            "speakerId": 22311,
            "speakerName": "阿罗逻",
            "text": "那个，虽然没有人在意。但是大家好，我叫阿罗逻。"
          }
        }
      }
    },

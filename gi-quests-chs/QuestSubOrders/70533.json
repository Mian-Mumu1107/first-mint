  },
  "subQuests": [
    {
      "subId": "7053301",
      "subQuestName": "与菲利斯·尤格对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705330101"
        ],
        "dialogs": {
          "705330101": {
            "id": "705330101",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "没想到，我的发明居然还有这种用处…",
            "nextDialogs": [
              "705330102"
            ]
          },
          "705330102": {
            "id": "705330102",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "喔！你好，旅行者，没想到咱们又见面了…咳…",
            "nextDialogs": [
              "705330104",
              "705330106"
            ]
          },
          "705330104": {
            "id": "705330104",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "我是有这个计划，不过嘛…万事万物总是变化无穷啊…",
            "nextDialogs": [
              "705330108"
            ]
          },
          "705330108": {
            "id": "705330108",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "咳，这些暂时不提了，咱们说正事。",
            "nextDialogs": [
              "705330109"
            ]
          },
          "705330109": {
            "id": "705330109",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "这次，我是接受了蒙德城冒险家协会的邀请，专门以一种卡牌的牌面为原型，用齿轮和机关创作了好几幅可以拆解再拼接的「械画」。",
            "nextDialogs": [
              "705330110"
            ]
          },
          "705330110": {
            "id": "705330110",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "那个卡牌叫什么来着…对！「七圣召唤」，没错，就是这个名字。",
            "nextDialogs": [
              "705330111"
            ]
          },
          "705330111": {
            "id": "705330111",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "据他们说，这几幅「械画」会分别送去这次「召唤王大奖赛」的举办区域，再做个什么小活动，让大奖赛的氛围更热闹一点…",
            "nextDialogs": [
              "705330112"
            ]
          },
          "705330112": {
            "id": "705330112",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "唉，这些事对我来说实在是太复杂了。我还是专注于我的发明吧。",
            "nextDialogs": [
              "705330113"
            ]
          },
          "705330113": {
            "id": "705330113",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "对了，蒙德的「械画」就在我身边，如果您想要试试拼接它的话，就请来体验一下吧。"
          },
          "705330106": {
            "id": "705330106",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "没有！这次没有，呃…不如说一开始就没有。",
            "nextDialogs": [
              "705330107"
            ]
          },
          "705330107": {
            "id": "705330107",
            "speakerId": 1000,
            "speakerName": "菲利斯·尤格",
            "text": "之前我请您帮忙那次，纯粹是因为魔物的问题，和我的发明没有关系嘛。"
          }
        }
      }
    }
  ]
}
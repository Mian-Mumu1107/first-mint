        "dialogs": {
          "709420101": {
            "id": "709420101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于雪山…",
            "nextDialogs": [
              "709420102"
            ]
          },
          "709420102": {
            "id": "709420102",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "哦？你对雪山感兴趣吗？那你说不定有成为地理学家的潜力。",
            "nextDialogs": [
              "709420103"
            ]
          },
          "709420103": {
            "id": "709420103",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "我成为学者的契机就是好奇清泉镇泉水的源头来自哪里，结果调查之后发现居然是这座雪山的融雪。",
            "nextDialogs": [
              "709420104"
            ]
          },
          "709420104": {
            "id": "709420104",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "为了能深入研究雪山的环境，我还专门准备了一些耐寒的药剂，结果没想到这里的寒冷程度甚至连药剂都失去了作用…",
            "nextDialogs": [
              "709420105"
            ]
          },
          "709420105": {
            "id": "709420105",
            "speakerId": 1666,
            "speakerName": "艾斯特尔",
            "text": "留在我这里也没什么用，不如你拿走吧。虽然不足以抵抗雪山的寒冷，但说不定能对你以后的冒险有帮助。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7182206",
      "subQuestName": "与索拉雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718220601"
        ],
        "dialogs": {
          "718220601": {
            "id": "718220601",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "总算到这里了…这路可真难走，还有这么多魔物…",
            "nextDialogs": [
              "718220602"
            ]
          },
          "718220602": {
            "id": "718220602",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "这周围的地形…好像也没什么特别的…",
            "nextDialogs": [
              "718220603"
            ]
          },
          "718220603": {
            "id": "718220603",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "咦？这棵树上是什么，一盏霄灯…",
            "nextDialogs": [
              "718220604"
            ]
          },
          "718220604": {
            "id": "718220604",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "这里怎么会有霄灯？难道有人来这里拜祭那位仙人了吗？",
            "nextDialogs": [
              "718220605"
            ]
          },
          "718220605": {
            "id": "718220605",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "我看看这盏霄灯里写了什么…",
            "nextDialogs": [
              "718220606"
            ]
          },
          "718220606": {
            "id": "718220606",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "「万世安泰，天下太平。」",
            "nextDialogs": [
              "718220609"
            ]
          },
          "718220609": {
            "id": "718220609",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "确实。但这个愿望…怎么说呢，有点太过宏伟了？不像是拜祭，也不像是「愿望」。",
            "nextDialogs": [
              "718220610"
            ]
          },
          "718220610": {
            "id": "718220610",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "反而像是那种…在璃月传说里的仙人们才会许的愿望。",
            "nextDialogs": [
              "718220611"
            ]
          },
          "718220611": {
            "id": "718220611",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "到底是谁会在霄灯上许这种愿望呢？真奇怪…",
            "nextDialogs": [
              "718220612"
            ]
          },
          "718220612": {
            "id": "718220612",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "唔，不管怎么说，至少有人还记得来这里放霄灯，那位仙人应该也会很高兴吧。",
            "nextDialogs": [
              "718220613"
            ]
          },
          "718220613": {
            "id": "718220613",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "谢谢你陪我走了这么远的路，我还想在这里再研究一下…",
            "nextDialogs": [
              "718220614"
            ]
          },
          "718220614": {
            "id": "718220614",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "对了，这些东西请你收下，就当做是报酬吧。",
            "nextDialogs": [
              "718220615"
            ]
          },
          "718220615": {
            "id": "718220615",
            "speakerId": 1000,
            "speakerName": "索拉雅",
            "text": "唉，璃月有这么多传说，但我的研究怎么就一点进展都没有呢…"
          }
        }
      }
    }
  ]
}
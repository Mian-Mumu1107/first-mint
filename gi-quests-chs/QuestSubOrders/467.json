    {
      "subId": "46703",
      "subQuestName": "将「野菇鸡肉串」交给琳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4670301"
        ],
        "dialogs": {
          "4670301": {
            "id": "4670301",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "已经做好了吗？嗯…闻起来好像不错！",
            "nextDialogs": [
              "4670302"
            ]
          },
          "4670302": {
            "id": "4670302",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "那我就不客气啦…",
            "nextDialogs": [
              "4670303"
            ]
          },
          "4670303": {
            "id": "4670303",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "嗯…",
            "nextDialogs": [
              "4670304"
            ]
          },
          "4670304": {
            "id": "4670304",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "（嚼嚼）",
            "nextDialogs": [
              "4670305"
            ]
          },
          "4670305": {
            "id": "4670305",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "唔…",
            "nextDialogs": [
              "4670306"
            ]
          },
          "4670306": {
            "id": "4670306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（咽口水）",
            "nextDialogs": [
              "4670307"
            ]
          },
          "4670307": {
            "id": "4670307",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "唔…一言难尽的味道，勉强及格吧~！",
            "nextDialogs": [
              "4670308"
            ]
          },
          "4670308": {
            "id": "4670308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#咦？{NICKNAME}应该只是没发挥好，不算不算~！",
            "nextDialogs": [
              "4670309"
            ]
          },
          "4670309": {
            "id": "4670309",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "嗯，只要多加练习，你还是很有潜力的！",
            "nextDialogs": [
              "4670310"
            ]
          },
          "4670310": {
            "id": "4670310",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "我的包裹里还有一些生的食材，送给你吧，就当做这一餐的回礼。",
            "nextDialogs": [
              "4670311"
            ]
          },
          "4670311": {
            "id": "4670311",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？这不太好吧，你自己没东西下锅了怎么办？",
            "nextDialogs": [
              "4670312"
            ]
          },
          "4670312": {
            "id": "4670312",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "没关系哦，<color=#00E1FFFF>野外探险</color>时可以搜集到很多食材，你们也可以多多留意。",
            "nextDialogs": [
              "4670313"
            ]
          },
          "4670313": {
            "id": "4670313",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "<color=#00E1FFFF>「猎鹿人」餐馆</color>也会有食材和料理出售，有空就去转转吧。",
            "nextDialogs": [
              "4670314"
            ]
          },
          "4670314": {
            "id": "4670314",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯，谢谢你的情报…喂！「野菇鸡肉串」给我留一点呀！"
          }
        }
      }
    },

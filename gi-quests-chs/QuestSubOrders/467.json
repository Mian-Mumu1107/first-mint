  "subQuests": [
    {
      "subId": "46701",
      "subQuestName": "(test)路过锅子旁$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4670101"
        ],
        "dialogs": {
          "4670101": {
            "id": "4670101",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "下一道菜做什么好呢…",
            "nextDialogs": [
              "4670102"
            ]
          },
          "4670102": {
            "id": "4670102",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "嗯？你们也是附近的冒险家吗？",
            "nextDialogs": [
              "4670103"
            ]
          },
          "4670103": {
            "id": "4670103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是路过的旅行者哦。你是在准备做饭吗？",
            "nextDialogs": [
              "4670104"
            ]
          },
          "4670104": {
            "id": "4670104",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "是旅行者呀，欢迎欢迎。",
            "nextDialogs": [
              "4670105"
            ]
          },
          "4670105": {
            "id": "4670105",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "我是琳，冒险家协会的生存专家，如你所见正在研究烹饪。",
            "nextDialogs": [
              "4670106"
            ]
          },
          "4670106": {
            "id": "4670106",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "毕竟「吃饱了再上路」，是「野外生存守则」的第一条呢。",
            "nextDialogs": [
              "4670107"
            ]
          },
          "4670107": {
            "id": "4670107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "野餐！我也很喜欢。",
            "nextDialogs": [
              "4670108"
            ]
          },
          "4670108": {
            "id": "4670108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我的旅伴也很擅长烹饪哦，对吧对吧？",
            "nextDialogs": [
              "4670802",
              "4670902"
            ]
          },
          "4670802": {
            "id": "4670802",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "没关系，锅子已经架好了，让我看看你的手艺吧！",
            "nextDialogs": [
              "4670803"
            ]
          },
          "4670803": {
            "id": "4670803",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "生存专家亲自指导，机会可不多哦！",
            "nextDialogs": [
              "4671001"
            ]
          },
          "4671001": {
            "id": "4671001",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "我放了些蘑菇和肉在那边的桶里，试着做一份<color=#00E1FFFF>「野菇鸡肉串」</color>给我吧。"
          },
          "4670902": {
            "id": "4670902",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "哦！锅子已经架好了，让我看看你的手艺吧！",
            "nextDialogs": [
              "4670903"
            ]
          },
          "4670903": {
            "id": "4670903",
            "speakerId": 1000,
            "speakerName": "琳",
            "text": "有这样切磋厨艺的机会真是难得。"
          }
        }
      }
    },
    {

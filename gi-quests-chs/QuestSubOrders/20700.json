    {
      "subId": "2070039",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207003901"
        ],
        "dialogs": {
          "207003901": {
            "id": "207003901",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "那些箱子你别乱动啊，要是坏掉了，我这生意就做不了了。",
            "nextDialogs": [
              "207003902"
            ]
          },
          "207003902": {
            "id": "207003902",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "虽然那些货不值多少钱，但再少也是摩拉买来的，不是天上掉下来的。"
          }
        }
      }
    },
    {
      "subId": "2070049",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207004901"
        ],
        "dialogs": {
          "207004901": {
            "id": "207004901",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "真是晦气…路也走不了，货也运不出去，连散步都散不成了。",
            "nextDialogs": [
              "207004902"
            ]
          },
          "207004902": {
            "id": "207004902",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "西风骑士团一天到晚到底在瞎忙些什么东西。",
            "nextDialogs": [
              "207004903"
            ]
          },
          "207004903": {
            "id": "207004903",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "哼，要是在至冬国..."
          }
        }
      }
    }

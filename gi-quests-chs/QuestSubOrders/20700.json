    {
      "subId": "2070010",
      "subQuestName": "桥接任务B$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207003101"
        ],
        "dialogs": {
          "207003101": {
            "id": "207003101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "去山腰。",
            "nextDialogs": [
              "207003102"
            ]
          },
          "207003102": {
            "id": "207003102",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "哦，山腰上有我屯的一批货物，原本是打算运回去卖了赚点的。",
            "nextDialogs": [
              "207003103"
            ]
          },
          "207003103": {
            "id": "207003103",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "但是现在，不仅道路一直不通，连屯货的地方都被丘丘人占据了。",
            "nextDialogs": [
              "207003104"
            ]
          },
          "207003104": {
            "id": "207003104",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "不过还好，那些丘丘人都没什么眼力，没怎么动我的货物。",
            "nextDialogs": [
              "207003105"
            ]
          },
          "207003105": {
            "id": "207003105",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "你，赶紧去把那个地方的丘丘人都给清理了，记得也别乱动我的货物啊，那些箱子很容易就坏了。",
            "nextDialogs": [
              "207003106"
            ]
          },
          "207003106": {
            "id": "207003106",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "唉，这个道路再不通，那些货怕是都要卖不出去了…"
          }
        }
      }
    },
    {
      "subId": "2070011",
      "subQuestName": "桥接任务C$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207004101"
        ],
        "dialogs": {
          "207004101": {
            "id": "207004101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "去山顶。",
            "nextDialogs": [
              "207004102"
            ]
          },
          "207004102": {
            "id": "207004102",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "山顶上的那帮丘丘人最不好对付了，之前我还在那散心，现在连靠近都不敢了，真是晦气。",
            "nextDialogs": [
              "207004103"
            ]
          },
          "207004103": {
            "id": "207004103",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "哼，你看起来身手应该还不错，这下子总算能出出气了。",
            "nextDialogs": [
              "207004104"
            ]
          },
          "207004104": {
            "id": "207004104",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "记住了啊，那个提着斧头的大块头一定要先解决掉，这家伙趾高气昂的，看着就烦。",
            "nextDialogs": [
              "207004105"
            ]
          },
          "207004105": {
            "id": "207004105",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "然后就是那个扛着盾的，提着个大盾晃来晃去，比谁都碍眼。",
            "nextDialogs": [
              "207004106"
            ]
          },
          "207004106": {
            "id": "207004106",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "最后是那个搂着根长棍子的…叫什么？丘丘人萨满？看着就没什么实力…",
            "nextDialogs": [
              "207004107"
            ]
          },
          "207004107": {
            "id": "207004107",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "总之，你赶紧去把这群怪物全给解决掉，别再让它们来碍眼了。"
          }
        }
      }
    },
    {

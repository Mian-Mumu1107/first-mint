    {
      "subId": "2070004",
      "subQuestName": "任务A普通完成奖励发放$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207000304"
        ],
        "dialogs": {
          "207000304": {
            "id": "207000304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经办好了。",
            "nextDialogs": [
              "207000305"
            ]
          },
          "207000305": {
            "id": "207000305",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "磨磨蹭蹭，和西风骑士团一个德行，我说了给你一分钟，你是忘了还是压根没听进去？",
            "nextDialogs": [
              "207000306"
            ]
          },
          "207000306": {
            "id": "207000306",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "哼，这么点简单的细节都不在意…1000摩拉拿好，该干嘛干嘛去吧。",
            "nextDialogs": [
              "207000307"
            ]
          },
          "207000307": {
            "id": "207000307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "1000摩拉？怎么这么少！",
            "nextDialogs": [
              "207000308"
            ]
          },
          "207000308": {
            "id": "207000308",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "事情办成那样，还想要多少钱？这些就是你们应得的酬劳，拿好了！"
          }
        }
      }
    },
    {
      "subId": "2070006",
      "subQuestName": "任务B普通完成奖励发放$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207003301"
        ],
        "dialogs": {
          "207003301": {
            "id": "207003301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经办好了。",
            "nextDialogs": [
              "207003302"
            ]
          },
          "207003302": {
            "id": "207003302",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "你是听不懂我说的话，还是就想随便敷衍了事，啊？！",
            "nextDialogs": [
              "207003303"
            ]
          },
          "207003303": {
            "id": "207003303",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "我让你别弄坏那些箱子，你怎么给我打碎了这么多？我这货还卖不卖，这生意还做不做了？",
            "nextDialogs": [
              "207003304"
            ]
          },
          "207003304": {
            "id": "207003304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没看见什么货物…",
            "nextDialogs": [
              "207003305"
            ]
          },
          "207003305": {
            "id": "207003305",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "那些箱子！就是我的货物！不然你以为我为什么敢把它们摆在野外？",
            "nextDialogs": [
              "207003306"
            ]
          },
          "207003306": {
            "id": "207003306",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "算了算了，和你这种办事心不在焉的人没什么好说的，就1000摩拉，拿好了，赶紧走人！",
            "nextDialogs": [
              "207003307"
            ]
          },
          "207003307": {
            "id": "207003307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这也太少了，怎么才1000摩拉呀！",
            "nextDialogs": [
              "207003308"
            ]
          },
          "207003308": {
            "id": "207003308",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "嫌少？这么点小事都办不好，还指望白拿多少钱？这些就是你们应得的酬劳，拿好了。"
          }
        }
      }
    },

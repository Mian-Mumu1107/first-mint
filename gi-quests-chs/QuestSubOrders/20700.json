  "subQuests": [
    {
      "subId": "2070001",
      "subQuestName": "与查耶维奇对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207002101"
        ],
        "dialogs": {
          "207002101": {
            "id": "207002101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "去山底。",
            "nextDialogs": [
              "207002102"
            ]
          },
          "207002102": {
            "id": "207002102",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "山底是吧，那里倒是没什么，就是一群丘丘人来回游荡，虽然没什么危险，但是看着就碍眼。",
            "nextDialogs": [
              "207002103"
            ]
          },
          "207002103": {
            "id": "207002103",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "你赶紧去把它们全部给清理掉，这么点小事，我觉得…一分钟，差不多了吧。"
          }
        }
      }
    },
    {
      "subId": "2070002",
      "subQuestName": "按查耶维奇的要求打倒丘丘人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207000201"
        ],
        "dialogs": {
          "207000201": {
            "id": "207000201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经办好了。",
            "nextDialogs": [
              "207000202"
            ]
          },
          "207000202": {
            "id": "207000202",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "这么快就回来了，还没到一分钟就全部解决了，身手不凡，身手不凡呐，哈哈哈。",
            "nextDialogs": [
              "207000203"
            ]
          },
          "207000203": {
            "id": "207000203",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "不错不错，5000摩拉，一分不少，拿好了。",
            "nextDialogs": [
              "207000204"
            ]
          },
          "207000204": {
            "id": "207000204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "身手不凡也才5000摩拉…",
            "nextDialogs": [
              "207000205"
            ]
          },
          "207000205": {
            "id": "207000205",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "可别嫌少，这酬劳可是我仔细算过的，和你们的工作刚好相称。",
            "nextDialogs": [
              "207000206"
            ]
          },
          "207000206": {
            "id": "207000206",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "想要赚大钱，就得办点大事，下次有机会的话，你们再努努力吧。"
          }
        }
      }
    },
    {
      "subId": "2070005",
      "subQuestName": "查耶维奇战斗A结果判定$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

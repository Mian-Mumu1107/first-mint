    {
      "subId": "2070013",
      "subQuestName": "隐藏任务B完成发放奖励$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207003201"
        ],
        "dialogs": {
          "207003201": {
            "id": "207003201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是的",
            "nextDialogs": [
              "207003202"
            ]
          },
          "207003202": {
            "id": "207003202",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "不错，不错，你还挺会办事的，那些箱子都完好无缺。",
            "nextDialogs": [
              "207003203"
            ]
          },
          "207003203": {
            "id": "207003203",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "5000摩拉拿好，下次有机会，再来帮我办办事。",
            "nextDialogs": [
              "207003204"
            ]
          },
          "207003204": {
            "id": "207003204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "辛辛苦苦走了那么远，才5000摩拉…",
            "nextDialogs": [
              "207003205"
            ]
          },
          "207003205": {
            "id": "207003205",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "可别嫌少，这酬劳可是我仔细算过的，和你们的工作刚好相称。",
            "nextDialogs": [
              "207003206"
            ]
          },
          "207003206": {
            "id": "207003206",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "想要赚大钱，就得办点大事，下次有机会的话，你们再努努力吧。"
          }
        }
      }
    },
    {
      "subId": "2070014",
      "subQuestName": "隐藏任务C完成发放奖励$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207004201"
        ],
        "dialogs": {
          "207004201": {
            "id": "207004201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经办好了。",
            "nextDialogs": [
              "207004202"
            ]
          },
          "207004202": {
            "id": "207004202",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "你…你办事的效率还不错嘛，那个…",
            "nextDialogs": [
              "207004203"
            ]
          },
          "207004203": {
            "id": "207004203",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "算了，多余的话也不说了，5000摩拉给你，拿好了。我们至冬国的商人，说到做到。",
            "nextDialogs": [
              "207004204"
            ]
          },
          "207004204": {
            "id": "207004204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "至冬国的商人…怎么才给5000摩拉这么点…",
            "nextDialogs": [
              "207004205"
            ]
          },
          "207004205": {
            "id": "207004205",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "可别嫌少，这酬劳可是我仔细算过的，和你们的工作刚好相称。",
            "nextDialogs": [
              "207004206"
            ]
          },
          "207004206": {
            "id": "207004206",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "想要赚大钱，就得办点大事，下次有机会的话，你们再努努力吧。"
          }
        }
      }
    },
    {
      "subId": "2070015",
      "subQuestName": "任务C普通完成奖励$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207004301"
        ],
        "dialogs": {
          "207004301": {
            "id": "207004301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经办好了。",
            "nextDialogs": [
              "207004302"
            ]
          },
          "207004302": {
            "id": "207004302",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "…你办事的过程，我在旁边都看见了。",
            "nextDialogs": [
              "207004303"
            ]
          },
          "207004303": {
            "id": "207004303",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "不过，你是不是习惯了柿子捡软的捏，还是说，我之前和你说的先谁后谁，你就压根没注意？",
            "nextDialogs": [
              "207004304"
            ]
          },
          "207004304": {
            "id": "207004304",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "你知道我们至冬国有个词，叫「说到做到」吗？",
            "nextDialogs": [
              "207004305"
            ]
          },
          "207004305": {
            "id": "207004305",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "我付你钱，雇你帮我做事，我说的话，每一句都是有意义的。",
            "nextDialogs": [
              "207004306"
            ]
          },
          "207004306": {
            "id": "207004306",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "你事情虽然办完了，但是这种结果，我顶多给你1000摩拉，拿好了，赶紧走吧。",
            "nextDialogs": [
              "207004307"
            ]
          },
          "207004307": {
            "id": "207004307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！才1000摩拉，这够做什么的呀！",
            "nextDialogs": [
              "207004308"
            ]
          },
          "207004308": {
            "id": "207004308",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "哼，嫌少？事情都办砸了，有这1000摩拉就知足吧。"
          }
        }
      }
    },

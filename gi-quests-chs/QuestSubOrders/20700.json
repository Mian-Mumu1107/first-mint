    {
      "subId": "2070001",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207000101"
        ],
        "dialogs": {
          "207000101": {
            "id": "207000101",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "真是倒霉透了！西风骑士团真是…",
            "nextDialogs": [
              "207000102"
            ]
          },
          "207000102": {
            "id": "207000102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "207000103"
            ]
          },
          "207000103": {
            "id": "207000103",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "哼，西风骑士团办事真是没效率，说前头有魔物，不让我通过。",
            "nextDialogs": [
              "207000104"
            ]
          },
          "207000104": {
            "id": "207000104",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "但是到现在他们也没传信过来给个准话，真是靠不住…",
            "nextDialogs": [
              "207000105"
            ]
          },
          "207000105": {
            "id": "207000105",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "我还有一堆事要处理，这折合下来，我得损失多少钱啊？",
            "nextDialogs": [
              "207000106"
            ]
          },
          "207000106": {
            "id": "207000106",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "不过…看你的样子倒像是个冒险家，这样吧…我付你钱，你帮我去办点事，你愿意不愿意？",
            "nextDialogs": [
              "207000108",
              "207000110"
            ]
          },
          "207000108": {
            "id": "207000108",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "很好，我就喜欢爽快的人，事情办好之后，我绝不会亏待你。",
            "nextDialogs": [
              "207000111"
            ]
          },
          "207000111": {
            "id": "207000111",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "也不知道是不是我的错觉，这蒙德的丘丘人感觉是越来越多了，哼，西风骑士团，也不知道一天到晚在做什么。",
            "nextDialogs": [
              "207000112"
            ]
          },
          "207000112": {
            "id": "207000112",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "你既然答应了帮我办事，那你正好帮我去清理丘丘人。但你也只有一个人，嗯…",
            "nextDialogs": [
              "207000113"
            ]
          },
          "207000113": {
            "id": "207000113",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "算了，你自己选一个地方去清理吧，山顶、山腰和山底下。",
            "nextDialogs": [
              "207000114"
            ]
          },
          "207000114": {
            "id": "207000114",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "反正都是去清理丘丘人，没什么差别，赶紧选，别浪费我时间。"
          },
          "207000110": {
            "id": "207000110",
            "speakerId": 1654,
            "speakerName": "查耶维奇",
            "text": "哼，那就要看你办事的样子了，只要事情办好，我绝不会亏待你。"
          }
        }
      }
    },
    {
      "subId": "2070006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "207000602"

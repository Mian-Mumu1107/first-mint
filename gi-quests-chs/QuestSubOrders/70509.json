  "subQuests": [
    {
      "subId": "7050901",
      "subQuestName": "与卢卡对话，进入酒馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705090101"
        ],
        "dialogs": {
          "705090101": {
            "id": "705090101",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "#{NICKNAME}，你好。",
            "nextDialogs": [
              "705090102"
            ]
          },
          "705090102": {
            "id": "705090102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你好呀！唉，要不是连续见了那么多朋友，我肯定会很惊讶，连你都来了呢…",
            "nextDialogs": [
              "705090103"
            ]
          },
          "705090103": {
            "id": "705090103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不…不对，这不是申鹤嘛！我果然还是被惊讶到了！",
            "nextDialogs": [
              "705090104"
            ]
          },
          "705090104": {
            "id": "705090104",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "嗯…这里确实不好找。「天使的馈赠」…名字拗口。",
            "nextDialogs": [
              "705090105"
            ]
          },
          "705090105": {
            "id": "705090105",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "多亏热心的钟离先生帮忙指路。",
            "nextDialogs": [
              "705090106"
            ]
          },
          "705090106": {
            "id": "705090106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还让人指路了啊…我猜猜看，你是专程赶来喝东西的？",
            "nextDialogs": [
              "705090107"
            ]
          },
          "705090107": {
            "id": "705090107",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "嗯。",
            "nextDialogs": [
              "705090108"
            ]
          },
          "705090108": {
            "id": "705090108",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "因为是…朋友。",
            "nextDialogs": [
              "705090109"
            ]
          },
          "705090109": {
            "id": "705090109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "想喝点什么？",
            "nextDialogs": [
              "705090110"
            ]
          },
          "705090110": {
            "id": "705090110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "来，这里有菜单！",
            "nextDialogs": [
              "705090111"
            ]
          },
          "705090111": {
            "id": "705090111",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "北风之望…北风，是凉嗖嗖的吗？",
            "nextDialogs": [
              "705090112"
            ]
          },
          "705090112": {
            "id": "705090112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，这个名字里的北风应该是指北风狼吧？冷…的确挺冷的…",
            "nextDialogs": [
              "705090113"
            ]
          },
          "705090113": {
            "id": "705090113",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "焦糖松果…为什么能拿来喝？",
            "nextDialogs": [
              "705090114"
            ]
          },
          "705090114": {
            "id": "705090114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，这个我尝过。是焦糖味的咖啡，松果…松果说的应该是颜色！",
            "nextDialogs": [
              "705090115"
            ]
          },
          "705090115": {
            "id": "705090115",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "……",
            "nextDialogs": [
              "705090116"
            ]
          },
          "705090116": {
            "id": "705090116",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "看名字，完全无法理解。",
            "nextDialogs": [
              "705090117"
            ]
          },
          "705090117": {
            "id": "705090117",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "交给你们吧。类似清心、琉璃袋…那种味道的就好。",
            "nextDialogs": [
              "705090118"
            ]
          },
          "705090118": {
            "id": "705090118",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里的土壤不长这些药材啦，想喝苦的东西，就只有咖啡…",
            "nextDialogs": [
              "705090119"
            ]
          },
          "705090119": {
            "id": "705090119",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要不要试试甜味的？",
            "nextDialogs": [
              "705090120"
            ]
          },
          "705090120": {
            "id": "705090120",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "…好。",
            "nextDialogs": [
              "705090121"
            ]
          },
          "705090121": {
            "id": "705090121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也对，修行久了是该换换口味！",
            "nextDialogs": [
              "705090122"
            ]
          },
          "705090122": {
            "id": "705090122",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们给申鹤来一杯覆雪之吻吧！看名字就跟她很搭。"
          }
        }
      }
    },
    {

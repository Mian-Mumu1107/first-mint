    },
    {
      "subId": "7050902",
      "subQuestName": "为申鹤调制指定饮品",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705090201"
        ],
        "dialogs": {
          "705090201": {
            "id": "705090201",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "很甜，口感顺滑，不苦涩。这是什么？",
            "nextDialogs": [
              "705090202"
            ]
          },
          "705090202": {
            "id": "705090202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "它叫「覆雪之吻」！把牛奶打成细密的奶泡轻轻倒在果汁上，看起来就像是覆盖着积雪一样哦。",
            "nextDialogs": [
              "705090203"
            ]
          },
          "705090203": {
            "id": "705090203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "至于为什么要叫吻什么的…我也不懂…可能是商家的花招吧，为了让它更好卖！",
            "nextDialogs": [
              "705090204"
            ]
          },
          "705090204": {
            "id": "705090204",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "更好卖？",
            "nextDialogs": [
              "705090205"
            ]
          },
          "705090205": {
            "id": "705090205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？不是吗？我、我乱说的…那、那它是一种…浪漫的形容！",
            "nextDialogs": [
              "705090206"
            ]
          },
          "705090206": {
            "id": "705090206",
            "speakerId": 1045,
            "speakerName": "申鹤",
            "text": "浪漫…？",
            "nextDialogs": [
              "705090207"
            ]
          },
          "705090207": {
            "id": "705090207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜…好难解释啊！不要逼我编故事。",
            "nextDialogs": [
              "705090210"
            ]
          },
          "705090210": {
            "id": "705090210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是这样没错…"
          }
        }
      }
    },

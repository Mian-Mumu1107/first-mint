        "dialogs": {
          "706880101": {
            "id": "706880101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "<color=#FFCC33FF>有什么厉害的委托吗？</color>",
            "nextDialogs": [
              "706880102"
            ]
          },
          "706880102": {
            "id": "706880102",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "您来的正巧，有一份协会共享给资深冒险家的手册要交给您。",
            "nextDialogs": [
              "706880104",
              "706880106"
            ]
          },
          "706880104": {
            "id": "706880104",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "很遗憾，并不是。",
            "nextDialogs": [
              "706880107"
            ]
          },
          "706880107": {
            "id": "706880107",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "如您所见，手册记录了值得挑战的强敌的信息。",
            "nextDialogs": [
              "706880108"
            ]
          },
          "706880108": {
            "id": "706880108",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "若能合理利用，想必会为您的冒险旅途增加许多助益。之后如果需要查阅相关信息，也随时欢迎您来。",
            "nextDialogs": [
              "706880109"
            ]
          },
          "706880109": {
            "id": "706880109",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "那么，就祝您旗开得胜。"
          },
          "706880106": {
            "id": "706880106",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "挑战与否，选择权当然在您。"
          }
        }
      }
    }
  ]

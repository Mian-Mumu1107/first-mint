      }
    },
    {
      "subId": "7404903",
      "subQuestName": "前往花圃",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740490301"
        ],
        "dialogs": {
          "740490301": {
            "id": "740490301",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "#{NICKNAME}真厉害，把丑丑的机关，「咚」地一下变成了美丽的零件。",
            "nextDialogs": [
              "740490302"
            ]
          },
          "740490302": {
            "id": "740490302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这样一来花圃应该不会被打扰了。",
            "nextDialogs": [
              "740490303"
            ]
          },
          "740490303": {
            "id": "740490303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽然已经被糟蹋了一些，但剩下的花好像状态还不错。隙境原体也不会再来捣乱了，柯莎的花可以茁壮生长啦。",
            "nextDialogs": [
              "740490304"
            ]
          },
          "740490304": {
            "id": "740490304",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "太好了…不过，柯莎已经吸取了教训，对宝贵的花朵要小心看护，小心照顾。",
            "nextDialogs": [
              "740490305"
            ]
          },
          "740490305": {
            "id": "740490305",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "#{NICKNAME}和派蒙…送来了异国的花，还帮柯莎保护花圃。柯莎要怎么报答…",
            "nextDialogs": [
              "740490306"
            ]
          },
          "740490306": {
            "id": "740490306",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不必那么客气啦。",
            "nextDialogs": [
              "740490307"
            ]
          },
          "740490307": {
            "id": "740490307",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "#对了，还有柯莎亲手采到的花朵，最珍贵的花朵！就把这个送给{NICKNAME}和派蒙！",
            "nextDialogs": [
              "740490308"
            ]
          },
          "740490308": {
            "id": "740490308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哦！既然是这么珍贵的花朵，不如{NICKNAME}也开辟一片花圃把它种下去…",
            "nextDialogs": [
              "740490309"
            ]
          },
          "740490309": {
            "id": "740490309",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "话说这不是汐藻吗？汐藻也算是花吗？",
            "nextDialogs": [
              "740490310"
            ]
          },
          "740490310": {
            "id": "740490310",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "汐藻是植物，汐藻又很美丽，当然属于花朵啦。这是人类的「生物学」，为了成为厉害的花匠，柯莎学了一点，哼哼。",
            "nextDialogs": [
              "740490311"
            ]
          },
          "740490311": {
            "id": "740490311",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总觉得哪里不对，可我也不太懂那些分类理论啦…",
            "nextDialogs": [
              "740490312"
            ]
          },
          "740490312": {
            "id": "740490312",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "柯莎以后要继续努力，成为更厉害的花匠。听人类说，厉害的花匠会培育出新品种的花，拿去参加「园艺会」。",
            "nextDialogs": [
              "740490313"
            ]
          },
          "740490313": {
            "id": "740490313",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "柯莎也要培育出新品种，在「园艺会」上赢得「奖项」。",
            "nextDialogs": [
              "740490314"
            ]
          },
          "740490314": {
            "id": "740490314",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "柯莎的劲头倒是很不错，不过好像还有很多难以解释的误会…",
            "nextDialogs": [
              "740490315"
            ]
          },
          "740490315": {
            "id": "740490315",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "参加园艺会，就是说要把自己培育的新品种拿去给人类鉴赏吧？",
            "nextDialogs": [
              "740490316"
            ]
          },
          "740490316": {
            "id": "740490316",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "柯莎的感官和审美，跟人类差别太大了…她培育的新品种花朵，在人类看来会不会很奇怪啊？",
            "nextDialogs": [
              "740490317"
            ]
          },
          "740490317": {
            "id": "740490317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙真关心柯莎的园艺事业啊。",
            "nextDialogs": [
              "740490318"
            ]
          },
          "740490318": {
            "id": "740490318",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那当然了！我可是柯莎的园艺教师。要是柯莎能参赛获奖，我脸上也有光彩嘛！",
            "nextDialogs": [
              "740490320",
              "740490324"
            ]
          },
          "740490320": {
            "id": "740490320",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…也对哦！柯莎认为自己培育的花美丽就够啦！旁人的评价也没有那么重要吧。",
            "nextDialogs": [
              "740490321"
            ]
          },
          "740490321": {
            "id": "740490321",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "柯莎要照顾好花圃，看着美丽的花，每天都开开心心的哦！",
            "nextDialogs": [
              "740490322"
            ]
          },
          "740490322": {
            "id": "740490322",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "嗯！柯莎会让异国的花茁壮成长的！"
          },
          "740490324": {
            "id": "740490324",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦，柯莎培育出的品种可能会有些不寻常，但有些人就是喜欢独树一帜的东西嘛！",
            "nextDialogs": [
              "740490325"
            ]
          },
          "740490325": {
            "id": "740490325",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#柯莎！培育出了新品种之后，要第一个告诉派蒙和{NICKNAME}哦！",
            "nextDialogs": [
              "740490326"
            ]
          },
          "740490326": {
            "id": "740490326",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "#没问题，派蒙和{NICKNAME}帮了柯莎那么多!"
          }
        }
      }
    },
    {
      "subId": "7404904",
      "subQuestName": "击败隙境原体",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740490401"
        ],
        "dialogs": {
          "740490401": {
            "id": "740490401",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "异国的花，异国的花~你要快快长大~"
          }
        }
      }
    },
    {
      "subId": "7404905",
      "subQuestName": "与柯莎对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740490201"
        ],
        "dialogs": {
          "740490201": {
            "id": "740490201",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "呜呜呜…宝贵的花朵，被弄坏了…",
            "nextDialogs": [
              "740490202"
            ]
          },
          "740490202": {
            "id": "740490202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真是好可惜…原来花儿无法成活，是因为隙境原体在搞破坏吗？",
            "nextDialogs": [
              "740490203"
            ]
          },
          "740490203": {
            "id": "740490203",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "…柯莎，柯莎从此要守在花朵旁边，一步也不离开了！",
            "nextDialogs": [
              "740490204"
            ]
          },
          "740490204": {
            "id": "740490204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "冷静一点啊，柯莎，我们一起来想想办法吧！话说回来，隙境原体为什么会破坏花圃…",
            "nextDialogs": [
              "740490207"
            ]
          },
          "740490207": {
            "id": "740490207",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "从没有过！哼，这些坏家伙，只敢躲着我做坏事！柯莎好生气！",
            "nextDialogs": [
              "740490208"
            ]
          },
          "740490208": {
            "id": "740490208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇啊…没想到柯莎也会有这么气愤的时候。看来是真的非常在意这些花朵。",
            "nextDialogs": [
              "740490209"
            ]
          },
          "740490209": {
            "id": "740490209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "但是，回忆一下的话，刚才柯莎靠近的时候，隙境原体也没有主动躲开啊…",
            "nextDialogs": [
              "740490210"
            ]
          },
          "740490210": {
            "id": "740490210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许吸引隙境原体的不是花。",
            "nextDialogs": [
              "740490211"
            ]
          },
          "740490211": {
            "id": "740490211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对呀，也有这种可能，我们调查一下花圃周围的情况吧！"
          }
        }
      }
    },

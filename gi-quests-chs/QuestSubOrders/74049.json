  },
  "subQuests": [
    {
      "subId": "7404901",
      "subQuestName": "（test）（隐藏）等待一个自然日$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740490101"
        ],
        "dialogs": {
          "740490101": {
            "id": "740490101",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "#是带来异国花朵的{NICKNAME}和派蒙！",
            "nextDialogs": [
              "740490102"
            ]
          },
          "740490102": {
            "id": "740490102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你好啊柯莎。我们带来的花，成长得怎么样了？",
            "nextDialogs": [
              "740490103"
            ]
          },
          "740490103": {
            "id": "740490103",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "这个…柯莎已经一天没去看了…",
            "nextDialogs": [
              "740490104"
            ]
          },
          "740490104": {
            "id": "740490104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，不是很喜欢我们带来的花吗，为什么不去看呢？",
            "nextDialogs": [
              "740490105"
            ]
          },
          "740490105": {
            "id": "740490105",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "异国的花，那么难得，柯莎想要赶紧去照料它。可是一想到它可能会在眼前枯萎，就不敢去看了…",
            "nextDialogs": [
              "740490106"
            ]
          },
          "740490106": {
            "id": "740490106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#不会吧，都在意成这个样子了？…不如我们一起去看看吧！如果遇到什么问题，派蒙和{NICKNAME}会帮助你的！",
            "nextDialogs": [
              "740490107"
            ]
          },
          "740490107": {
            "id": "740490107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "光提心吊胆也不是办法。",
            "nextDialogs": [
              "740490108"
            ]
          },
          "740490108": {
            "id": "740490108",
            "speakerId": 1000,
            "speakerName": "柯莎",
            "text": "#…说得对，我们一起去吧！有派蒙和{NICKNAME}帮助，柯莎就有信心了！"
          }
        }
      }
    },
    {
      "subId": "7404902",
      "subQuestName": "（隐藏）与柯莎对话$HIDDEN",
      "sceneId": null,
      "locations": [],

        "dialogs": {
          "751770101": {
            "id": "751770101",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀！",
            "nextDialogs": [
              "751770102"
            ]
          },
          "751770102": {
            "id": "751770102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#哎呀，{REALNAME[ID(2)|SHOWHOST(true)]}你是从哪里弄来的这个留影机…",
            "nextDialogs": [
              "751770103"
            ]
          },
          "751770103": {
            "id": "751770103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不会是趁着别人不注意…这样可不行哦？",
            "nextDialogs": [
              "751770104"
            ]
          },
          "751770104": {
            "id": "751770104",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呜！",
            "nextDialogs": [
              "751770105"
            ]
          },
          "751770105": {
            "id": "751770105",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯…呀！呀！呱呀……",
            "nextDialogs": [
              "751770107",
              "751770109"
            ]
          },
          "751770107": {
            "id": "751770107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦，这不是「大炖肉火焰」嘛！",
            "nextDialogs": [
              "751770110"
            ]
          },
          "751770110": {
            "id": "751770110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，是在「回声之子」那会儿，有个想要当导演却放反了留影机的部族人…啊！留影机是从他那借来的吗？",
            "nextDialogs": [
              "751770111"
            ]
          },
          "751770111": {
            "id": "751770111",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！嗯…呀！",
            "nextDialogs": [
              "751770112"
            ]
          },
          "751770112": {
            "id": "751770112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你想要跟我们一起拍一张画片，嘿嘿，是这个意思吧！",
            "nextDialogs": [
              "751770113"
            ]
          },
          "751770113": {
            "id": "751770113",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "751770114"
            ]
          },
          "751770114": {
            "id": "751770114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦，一起冒险了那么久，还没有一起拍画片留念呢，小家伙身上的诅咒已经去除，可以健康长大了！",
            "nextDialogs": [
              "751770115"
            ]
          },
          "751770115": {
            "id": "751770115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#不知道长成大嵴锋龙要多久，如果明天一下子就变成大嵴锋龙了，那不是再也见不到{REALNAME[ID(2)|SHOWHOST(true)]}还是小龙的样子了嘛！"
          },
          "751770109": {
            "id": "751770109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦，你这么一说，我就有点印象了…"
          }
        }
      }
    },

          "751779902": {
            "id": "751779902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯？怎么了，{REALNAME[ID(2)|SHOWHOST(true)]}，有什么事想要和我们说吗？",
            "nextDialogs": [
              "751779903"
            ]
          },
          "751779903": {

    {
      "subId": "7515004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751500401"
        ],
        "dialogs": {
          "751500401": {
            "id": "751500401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "如何进入圣山之心？",
            "nextDialogs": [
              "751500402"
            ]
          },
          "751500402": {
            "id": "751500402",
            "speakerId": 21800,
            "speakerName": "秘源龙仆",
            "text": "圣山之心的入口即在，再造「图兰」的城市中心，为了得到稳定的实验环境，修库特尔大人向下开掘…",
            "nextDialogs": [
              "751500403"
            ]
          },
          "751500403": {
            "id": "751500403",
            "speakerId": 21800,
            "speakerName": "秘源龙仆",
            "text": "在那里制造了对深渊的最终武器。",
            "nextDialogs": [
              "751500404"
            ]
          },
          "751500404": {
            "id": "751500404",
            "speakerId": 21800,
            "speakerName": "秘源龙仆",
            "text": "不过，也因「封绝」，遭受到了深渊最深层次的侵蚀，以至于城市亦被占据…",
            "nextDialogs": [
              "751500405"
            ]
          },
          "751500405": {
            "id": "751500405",
            "speakerId": 21800,
            "speakerName": "秘源龙仆",
            "text": "圣山之心的入口，即在圣城的裂隙之下…阴影之大敌，侵蚀至深之处。"
          }
        }
      }
    },

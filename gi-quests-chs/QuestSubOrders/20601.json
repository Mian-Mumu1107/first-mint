            ]
          },
          "206010804": {
            "id": "206010804",
            "speakerId": 1000,
            "speakerName": "塞琉斯",
            "text": "你和他并肩作战了吗？原来他是这么受伤的…",
            "nextDialogs": [
              "206010805"
            ]
          },
          "206010805": {
            "id": "206010805",
            "speakerId": 1000,
            "speakerName": "塞琉斯",
            "text": "唉，英勇是好事…但我宁愿他更加稳重一些，毕竟，活下来的冒险家才是冒险家。",
            "nextDialogs": [
              "206010806"
            ]
          },
          "206010806": {
            "id": "206010806",
            "speakerId": 1000,
            "speakerName": "塞琉斯",
            "text": "旅行者，你和杰克的勇气都值得嘉奖，这些东西你拿着，算是你冒险的奖励吧。"
          },
          "206010808": {
            "id": "206010808",
            "speakerId": 1000,
            "speakerName": "塞琉斯",
            "text": "果然和我想的一样，唉…平时我和他说的话，他都没怎么记得。",
            "nextDialogs": [
              "206010809"
            ]
          },
          "206010809": {
            "id": "206010809",
            "speakerId": 1000,
            "speakerName": "塞琉斯",
            "text": "虽然我也理解他想要证明自己的心思，但是…",
            "nextDialogs": [
              "206010810"
            ]
          },
          "206010810": {
            "id": "206010810",
            "speakerId": 1000,
            "speakerName": "塞琉斯",
            "text": "算了，这件事我已经了解了，杰克那边我会去和他谈谈。",
            "nextDialogs": [
              "206010811"
            ]
          },
          "206010811": {
            "id": "206010811",
            "speakerId": 1000,
            "speakerName": "塞琉斯",
            "text": "这是给你的，算是你冒险的奖励吧。"
          }
        }
      }

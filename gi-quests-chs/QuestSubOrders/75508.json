    {
      "subId": "7550801",
      "subQuestName": "前往「流泉之众」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "755080101"
        ],
        "dialogs": {
          "755080101": {
            "id": "755080101",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "哟！",
            "nextDialogs": [
              "755080102"
            ]
          },
          "755080102": {
            "id": "755080102",
            "speakerId": 1087,
            "speakerName": "玛拉妮",
            "text": "我们最最重要的客人来啦，说明气氛即将达到最热点！",
            "nextDialogs": [
              "755080103"
            ]
          },
          "755080103": {
            "id": "755080103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "玛拉妮，你好呀！希诺宁也在？",
            "nextDialogs": [
              "755080104"
            ]
          },
          "755080104": {
            "id": "755080104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有瑞希？你从稻妻过来啦？",
            "nextDialogs": [
              "755080105"
            ]
          },
          "755080105": {
            "id": "755080105",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "没错哦，纳塔的朋友们待我就像家人，「流泉之众」就像是我异乡的家。",
            "nextDialogs": [
              "755080106"
            ]
          },
          "755080106": {
            "id": "755080106",
            "speakerId": 1097,
            "speakerName": "梦见月瑞希",
            "text": "我也需要用心打理分店，才能为纳塔的大家提供力所能及的帮助嘛。",
            "nextDialogs": [
              "755080107"
            ]
          },
          "755080107": {
            "id": "755080107",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "说得不错，瑞希小姐的工作态度实在无可挑剔。",
            "nextDialogs": [
              "755080108"
            ]
          },
          "755080108": {
            "id": "755080108",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "和她一对比，传说中的乙方模板都会显得怠惰…",
            "nextDialogs": [
              "755080111"
            ]
          },
          "755080111": {
            "id": "755080111",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "最近做了几个奇怪的梦，比如…委托人把原本四周的订单工期缩短到一周。",
            "nextDialogs": [
              "755080112"
            ]
          },
          "755080112": {
            "id": "755080112",
            "speakerId": 1095,
            "speakerName": "希诺宁",
            "text": "或者接到的需求是「外形圆润又带着危险感的挂饰」，同样是四倍加急…"
          }
        }
      }
    },
    {
      "subId": "7550899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "755089901"
        ],
        "dialogs": {
          "755089901": {
            "id": "755089901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们收到了一封玛拉妮的信呢，真是个惊喜！",
            "nextDialogs": [
              "755089902"
            ]
          },
          "755089902": {
            "id": "755089902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "上面说，「流泉之众」正在举办一场…音乐派对？",
            "nextDialogs": [
              "755089903"
            ]
          },
          "755089903": {
            "id": "755089903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听起来有点好玩欸，我们去看看情况吧！"
          }
        }
      }
    }
  ]
}
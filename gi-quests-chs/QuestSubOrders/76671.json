{
  "lineCounts": {
    "Player": 33,
    "伊捷莉": 1,
    "叶洛亚": 90,
    "安莱夫": 1,
    "派蒙": 46,
    "瓦蒂什": 11
  },
  "subQuests": [
    {
      "subId": "7667101",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766710101"
        ],
        "dialogs": {
          "766710101": {
            "id": "766710101",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "居然还没到吗？这下可真是伤脑筋了。",
            "nextDialogs": [
              "766710102"
            ]
          },
          "766710102": {
            "id": "766710102",
            "speakerId": 1001,
            "speakerName": "安莱夫",
            "text": "怎么办，老大！且不说灯塔那边的兄弟们正等着开工，要是燃料也供给不上，整个营垒怕是都要熄火了。",
            "nextDialogs": [
              "766710103"
            ]
          },
          "766710103": {
            "id": "766710103",
            "speakerId": 1002,
            "speakerName": "伊捷莉",
            "text": "是啊，队长，得赶紧想想办法啊。",
            "nextDialogs": [
              "766710104"
            ]
          },
          "766710104": {
            "id": "766710104",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "我知道了，你们不用太担心。",
            "nextDialogs": [
              "766710105"
            ]
          },
          "766710105": {
            "id": "766710105",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "先回去自己的岗位上吧，这件事就交给我来处理…",
            "nextDialogs": [
              "766710106"
            ]
          },
          "766710106": {
            "id": "766710106",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "#{NICKNAME}，派蒙，是你们来了。",
            "nextDialogs": [
              "766710107"
            ]
          },
          "766710107": {
            "id": "766710107",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "你好呀，叶洛亚，大家怎么都聚在门口？",
            "nextDialogs": [
              "766710110"
            ]
          },
          "766710110": {
            "id": "766710110",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "没事，一点小状况而已，不是什么大事，我已经在想办法处理了。",
            "nextDialogs": [
              "766710111"
            ]
          },
          "766710111": {
            "id": "766710111",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "叶洛亚每次遇到事情总想着偷偷一个人解决，也说给我们听听嘛。",
            "nextDialogs": [
              "766710112"
            ]
          },
          "766710112": {
            "id": "766710112",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "该不会是不好意思说吧？",
            "nextDialogs": [
              "766710113"
            ]
          },
          "766710113": {
            "id": "766710113",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "哈哈，怎么会呢。只是这种我自己能解决的事情，就不太想让大家为此操心了。",
            "nextDialogs": [
              "766710114"
            ]
          },
          "766710114": {
            "id": "766710114",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "不过你们现在也算是调查分队「魇夜之莺」的成员，作为队长我是不会见外的。",
            "nextDialogs": [
              "766710115"
            ]
          },
          "766710115": {
            "id": "766710115",
            "speakerId": 1000,
            "speakerName": "叶洛亚",
            "text": "这里说话有些不太方便，我们先进去再慢慢说吧。"
          }
        }
      }
    },
    {
      "subId": "7667102",
      "subQuestName": "与叶洛亚对话",
      "sceneId": null,

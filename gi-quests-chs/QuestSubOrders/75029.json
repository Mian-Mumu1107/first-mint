  "subQuests": [
    {
      "subId": "7502901",
      "subQuestName": "(test)与老大自动对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750290101"
        ],
        "dialogs": {
          "750290101": {
            "id": "750290101",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "……",
            "nextDialogs": [
              "750290104"
            ]
          },
          "750290104": {
            "id": "750290104",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "哈哈哈哈哈哈！！",
            "nextDialogs": [
              "750290105"
            ]
          },
          "750290105": {
            "id": "750290105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇，吓人一跳。",
            "nextDialogs": [
              "750290106"
            ]
          },
          "750290106": {
            "id": "750290106",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "会来到这里，你们也是想要参与特训吧？！",
            "nextDialogs": [
              "750290107"
            ]
          },
          "750290107": {
            "id": "750290107",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "果然，人也好，龙也好，拥有进取心的勇士会互相吸引！！",
            "nextDialogs": [
              "750290108"
            ]
          },
          "750290108": {
            "id": "750290108",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "不要浪费时间了，我们现在就来进行特训吧！！"
          }
        }
      }
    },
    {
      "subId": "7502905",
      "subQuestName": "(test)把玩家扔下去$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750290501"
        ],
        "dialogs": {
          "750290501": {
            "id": "750290501",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "勇士！用这条赛道练习得怎么样？",
            "nextDialogs": [
              "750290503",
              "750290505"
            ]
          },
          "750290503": {
            "id": "750290503",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "懦弱！没有进步就等于退步！",
            "nextDialogs": [
              "750290506"
            ]
          },
          "750290506": {
            "id": "750290506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "该怎么说呢，马塔伽的字典里好像除了「向前」、「拼命」之类的词，没有其他。",
            "nextDialogs": [
              "750290507"
            ]
          },
          "750290507": {
            "id": "750290507",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "不错，我的字典比别人的薄！因为除了奋斗和努力，其他的东西我统统不承认。",
            "nextDialogs": [
              "750290508"
            ]
          },
          "750290508": {
            "id": "750290508",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "你们需要练习，我也需要，仅仅练习与龙的合作，我还不算全能的勇士！",
            "nextDialogs": [
              "750290509"
            ]
          },
          "750290509": {
            "id": "750290509",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "我必须前往更大的舞台磨砺自己！也就是说，我会离开这里一阵子。",
            "nextDialogs": [
              "750290510"
            ]
          },
          "750290510": {
            "id": "750290510",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "你们放心！这里的赛道我会保留，但是这座飞屋我会拆下来带走。"
          },
          "750290505": {
            "id": "750290505",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "懒惰！在无意义的闲逛中浪费人生去了吗？"
          }
        }
      }
    },
    {
      "subId": "7502907",
      "subQuestName": "(test)隐藏检测玩家是否有失败过$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750290701"
        ],
        "dialogs": {
          "750290701": {
            "id": "750290701",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "勇士，你超越了我，可喜可贺！不过想要成为更加伟大的英雄，就不可以懈怠，继续奋斗吧！"
          }
        }
      }
    },
    {
      "subId": "7502903",
      "subQuestName": "开启特训！！",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7502904",
      "subQuestName": "与马塔伽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750290201"
        ],
        "dialogs": {
          "750290201": {
            "id": "750290201",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "很好，非常好！你超过了我，可喜可贺！",
            "nextDialogs": [
              "750290202"
            ]
          },
          "750290202": {
            "id": "750290202",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "我在这里独自特训也是希望有一天能超过这个由我自己创造的成绩，可惜直到今天我也没有做到。",
            "nextDialogs": [
              "750290203"
            ]
          },
          "750290203": {
            "id": "750290203",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "但你做到了，这证明是时候出去看看了，外面还有很多远比我优秀的勇士！",
            "nextDialogs": [
              "750290204"
            ]
          },
          "750290204": {
            "id": "750290204",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "和他们切磋、交流的话，我的水平也会得到提高，有一天，我绝对能得到父亲和姐姐的认可！",
            "nextDialogs": [
              "750290205"
            ]
          },
          "750290205": {
            "id": "750290205",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "阿科米蒂就算了，那家伙一点志气都没有，居然跟我是亲兄弟，真是耻辱。",
            "nextDialogs": [
              "750290206"
            ]
          },
          "750290206": {
            "id": "750290206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿科米蒂…？",
            "nextDialogs": [
              "750290207"
            ]
          },
          "750290207": {
            "id": "750290207",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "不，没什么，闲话到此为止。",
            "nextDialogs": [
              "750290208"
            ]
          },
          "750290208": {
            "id": "750290208",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "勇士，以后也要坚持磨砺自己！",
            "nextDialogs": [
              "750290209"
            ]
          },
          "750290209": {
            "id": "750290209",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "既然想要成为传奇，就要奋力向前冲！冲！冲！这就是我留给你的临别赠言。"
          }
        }
      }
    },
    {
      "subId": "7502906",

      }
    },
    {
      "subId": "7502906",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750290601"
        ],
        "dialogs": {
          "750290601": {
            "id": "750290601",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "你的表现还不错，好好加油你可以的…",
            "nextDialogs": [
              "750290602"
            ]
          },
          "750290602": {
            "id": "750290602",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "你以为我会说这种话吗？不，伟大勇士的字典里没有什么「不错」、「凑活」！",
            "nextDialogs": [
              "750290603"
            ]
          },
          "750290603": {
            "id": "750290603",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "只有「最好」！达不到这个标准的统统是失败！",
            "nextDialogs": [
              "750290604"
            ]
          },
          "750290604": {
            "id": "750290604",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "只要你还有勇气，就再来！练到超过我为止！"
          }
        }
      }
    },
    {
      "subId": "7502913",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750291301"
        ],
        "dialogs": {
          "750291301": {
            "id": "750291301",
            "speakerId": 1003,
            "speakerName": "醒目的标语",
            "text": "上层召龙平台全天开放，有意加入马塔伽特训场的人与龙请至上层召龙起飞。谨记：以认真积极训练为荣，以怠惰消极偷懒为耻！！",
            "nextDialogs": [
              "750291302"
            ]
          },
          "750291302": {
            "id": "750291302",
            "speakerId": 1003,
            "speakerName": "醒目的标语",
            "text": "今天你我不努力，明天只能吃垃圾！！",
            "nextDialogs": [
              "750291303"
            ]
          },
          "750291303": {
            "id": "750291303",
            "speakerId": 1003,
            "speakerName": "醒目的标语",
            "text": "努力奋勇向前，拥抱卓越龙生！！"
          }
        }
      }
    },
    {
      "subId": "7502914",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750291401"
        ],
        "dialogs": {
          "750291401": {
            "id": "750291401",
            "speakerId": 1004,
            "speakerName": "马塔伽！记得！！",
            "text": "口令是<color=#00E1FFFF>先吹左边的号角，然后是右边的，最后是左边的</color>，不要敲错顺序！",
            "nextDialogs": [
              "750291402"
            ]
          },
          "750291402": {
            "id": "750291402",
            "speakerId": 1004,
            "speakerName": "马塔伽！记得！！",
            "text": "（似乎是一个叫马塔伽的人写给自己看的备忘，即使透过文字也能感受到激烈的情绪。）",
            "nextDialogs": [
              "750291403"
            ]
          },
          "750291403": {
            "id": "750291403",
            "speakerId": 1004,
            "speakerName": "马塔伽！记得！！",
            "text": "（不过给备忘的每一条都加上感叹号，不就等于没有加？）"
          }
        }
      }
    }
  ]
}
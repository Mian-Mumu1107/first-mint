    },
    {
      "subId": "7502908",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750290801"
        ],
        "dialogs": {
          "750290801": {
            "id": "750290801",
            "speakerId": 1002,
            "speakerName": "马塔伽",
            "text": "我会成为勇士！不，我会成为英雄，在那之前就瞧好吧。"
          }
        }
      }
    },
    {
      "subId": "7502902",
      "subQuestName": "(test)选择开启挑战",
      "sceneId": null,
      "locations": [],

  },
  "subQuests": [
    {
      "subId": "7602901",
      "subQuestName": "同「少女」见面",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760290101"
        ],
        "dialogs": {
          "760290101": {
            "id": "760290101",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "你们好。",
            "nextDialogs": [
              "760290102"
            ]
          },
          "760290102": {
            "id": "760290102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？哥伦比娅你要出门吗？",
            "nextDialogs": [
              "760290103"
            ]
          },
          "760290103": {
            "id": "760290103",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "嗯，出去修琴。",
            "nextDialogs": [
              "760290104"
            ]
          },
          "760290104": {
            "id": "760290104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…什么？",
            "nextDialogs": [
              "760290105"
            ]
          },
          "760290105": {
            "id": "760290105",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "有只月灵的琴坏了，它很珍惜这琴，我想帮它修好。",
            "nextDialogs": [
              "760290106"
            ]
          },
          "760290106": {
            "id": "760290106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "月灵们还真是多才多艺…",
            "nextDialogs": [
              "760290107"
            ]
          },
          "760290107": {
            "id": "760290107",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "嗯，它经常在这里弹琴，我偶尔也会和着琴声唱歌。",
            "nextDialogs": [
              "760290108"
            ]
          },
          "760290108": {
            "id": "760290108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我之前就这么觉得了，你还真是宠月灵呢。",
            "nextDialogs": [
              "760290109"
            ]
          },
          "760290109": {
            "id": "760290109",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "它们一直陪着我，还经常给我带好玩的东西回来。",
            "nextDialogs": [
              "760290110"
            ]
          },
          "760290110": {
            "id": "760290110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（菈乌玛说过，这是因为月灵想让月神开心的天性使然吧。）",
            "nextDialogs": [
              "760290111"
            ]
          },
          "760290111": {
            "id": "760290111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过我问一句，你打算怎么修好这琴呀？你不是说自己不能被别人看到吗？",
            "nextDialogs": [
              "760290112"
            ]
          },
          "760290112": {
            "id": "760290112",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "唔…以前我会拜托小动物或者月灵，让它们把要修的东西放到工匠家门口。",
            "nextDialogs": [
              "760290113"
            ]
          },
          "760290113": {
            "id": "760290113",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "工匠发现后，一般都会顺手把东西修好。不过有时也会发现不了，要等几天。",
            "nextDialogs": [
              "760290114"
            ]
          },
          "760290114": {
            "id": "760290114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来有些周折呢…",
            "nextDialogs": [
              "760290115"
            ]
          },
          "760290115": {
            "id": "760290115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不如交给我们吧。",
            "nextDialogs": [
              "760290116"
            ]
          },
          "760290116": {
            "id": "760290116",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "……",
            "nextDialogs": [
              "760290117"
            ]
          },
          "760290117": {
            "id": "760290117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "放心吧，我们去的话说不定今天就能修好呢。",
            "nextDialogs": [
              "760290118"
            ]
          },
          "760290118": {
            "id": "760290118",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "…好吧。谢谢。",
            "nextDialogs": [
              "760290119"
            ]
          },
          "760290119": {
            "id": "760290119",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "别客气。顺带一提，你一般放在哪个工匠的家门口呀？",
            "nextDialogs": [
              "760290120"
            ]
          },
          "760290120": {
            "id": "760290120",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "我不知道她名字。她家门口有个大大的机械手，住在一个圆圆的，像海螺一样的家里。",
            "nextDialogs": [
              "760290121"
            ]
          },
          "760290121": {
            "id": "760290121",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（难道说是…）",
            "nextDialogs": [
              "760290122"
            ]
          },
          "760290122": {
            "id": "760290122",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "里面还经常传来蛋卷的香味。",
            "nextDialogs": [
              "760290123"
            ]
          },
          "760290123": {
            "id": "760290123",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我好像知道是谁了…"
          }
        }
      }
    },
    {
      "subId": "7602902",
      "subQuestName": "前往叮铃哐啷蛋卷工坊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760290201"
        ],
        "dialogs": {
          "760290201": {
            "id": "760290201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "爱诺！你在家吗？",
            "nextDialogs": [
              "760290202"
            ]
          },
          "760290202": {
            "id": "760290202",
            "speakerId": 1002,
            "speakerName": "爱诺",
            "text": "哇！是派蒙的声音！",
            "nextDialogs": [
              "760290203"
            ]
          },
          "760290203": {
            "id": "760290203",
            "speakerId": 1002,
            "speakerName": "爱诺",
            "text": "你们好呀！是带着零食来看望爱诺的吗？",
            "nextDialogs": [
              "760290204"
            ]
          },
          "760290204": {
            "id": "760290204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "就知道你会这么说，喏，来的路上就为你准备好了。",
            "nextDialogs": [
              "760290205"
            ]
          },
          "760290205": {
            "id": "760290205",
            "speakerId": 1002,
            "speakerName": "爱诺",
            "text": "快给我快给我，等下伊涅芙就要回来了。",
            "nextDialogs": [
              "760290206"
            ]
          },
          "760290206": {
            "id": "760290206",
            "speakerId": 1002,
            "speakerName": "爱诺",
            "text": "那么今天要和爱诺一起玩什么呢？",
            "nextDialogs": [
              "760290207"
            ]
          },
          "760290207": {
            "id": "760290207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿…实际上，有件事情想拜托爱诺…",
            "nextDialogs": [
              "760290208"
            ]
          },
          "760290208": {
            "id": "760290208",
            "speakerId": 1002,
            "speakerName": "爱诺",
            "text": "呜哇！拿…拿走拿走！快把那怪东西拿走！",
            "nextDialogs": [
              "760290209"
            ]
          },
          "760290209": {
            "id": "760290209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怪东西？是说这琴吗？",
            "nextDialogs": [
              "760290210"
            ]
          },
          "760290210": {
            "id": "760290210",
            "speakerId": 1002,
            "speakerName": "爱诺",
            "text": "说了我讨厌用科学和机械原理解释不通的东西…",
            "nextDialogs": [
              "760290211"
            ]
          },
          "760290211": {
            "id": "760290211",
            "speakerId": 1002,
            "speakerName": "爱诺",
            "text": "那个琴隔三差五就会出现在我家门口，但我每次把它修好后，它又会莫名其妙地不见了！",
            "nextDialogs": [
              "760290212"
            ]
          },
          "760290212": {
            "id": "760290212",
            "speakerId": 1002,
            "speakerName": "爱诺",
            "text": "我…我才不信有这种神神鬼鬼的东西呢！",
            "nextDialogs": [
              "760290213"
            ]
          },
          "760290213": {
            "id": "760290213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊…看来这其中有些误会呢…",
            "nextDialogs": [
              "760290214"
            ]
          },
          "760290214": {
            "id": "760290214",
            "speakerId": 1002,
            "speakerName": "爱诺",
            "text": "误会？",
            "nextDialogs": [
              "760290217"
            ]
          },
          "760290217": {
            "id": "760290217",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，她其实没有恶意啦，每次悄悄拿走，也有些缘由在…",
            "nextDialogs": [
              "760290218"
            ]
          },
          "760290218": {
            "id": "760290218",
            "speakerId": 1002,
            "speakerName": "爱诺",
            "text": "真的吗？你们没在骗我哦。",
            "nextDialogs": [
              "760290219"
            ]
          },
          "760290219": {
            "id": "760290219",
            "speakerId": 1002,
            "speakerName": "爱诺",
            "text": "那…那我就信你们，再修一次…这次就修得彻底一点…",
            "nextDialogs": [
              "760290220"
            ]
          },
          "760290220": {
            "id": "760290220",
            "speakerId": 1002,
            "speakerName": "爱诺",
            "text": "你们在这里等一下哦。",
            "nextDialogs": [
              "760290221"
            ]
          },
          "760290221": {
            "id": "760290221",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "爱诺还是挺可靠的呀，就是被悄悄放东西的行为吓到有些可怜…",
            "nextDialogs": [
              "760290222"
            ]
          },
          "760290222": {
            "id": "760290222",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "的确该回报她一下。",
            "nextDialogs": [
              "760290223"
            ]
          },
          "760290223": {
            "id": "760290223",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯…呃啊！你怎么突然出现在这里啦！这次是吓到我们啦！",
            "nextDialogs": [
              "760290224"
            ]
          },
          "760290224": {
            "id": "760290224",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "给你们点东西就回去。",
            "nextDialogs": [
              "760290225"
            ]
          },
          "760290225": {
            "id": "760290225",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？这是什么？",
            "nextDialogs": [
              "760290226"
            ]
          },
          "760290226": {
            "id": "760290226",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "是月灵收集的一些「宝物」，它想要谢谢这位工匠，觉得她会喜欢。",
            "nextDialogs": [
              "760290227"
            ]
          },
          "760290227": {
            "id": "760290227",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦~好多稀奇古怪的零件呢。好吧，我们收到了，待会儿就转交给爱诺。",
            "nextDialogs": [
              "760290228"
            ]
          },
          "760290228": {
            "id": "760290228",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你回去的路上也要小心哦，别被人看见了。",
            "nextDialogs": [
              "760290229"
            ]
          },
          "760290229": {
            "id": "760290229",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "760290230"
            ]
          },
          "760290230": {
            "id": "760290230",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙…",
            "nextDialogs": [
              "760290231"
            ]
          },
          "760290231": {
            "id": "760290231",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯？怎么了？",
            "nextDialogs": [
              "760290232"
            ]
          },
          "760290232": {
            "id": "760290232",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那边…",
            "nextDialogs": [
              "760290233"
            ]
          },
          "760290233": {
            "id": "760290233",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "……！",
            "nextDialogs": [
              "760290234"
            ]
          },
          "760290234": {
            "id": "760290234",
            "speakerId": 1003,
            "speakerName": "伊涅芙",
            "text": "……",
            "nextDialogs": [
              "760290235"
            ]
          },
          "760290235": {
            "id": "760290235",
            "speakerId": 1000,
            "speakerName": "「少女」",
            "text": "……",
            "nextDialogs": [
              "760290236"
            ]
          },
          "760290236": {
            "id": "760290236",
            "speakerId": 1003,
            "speakerName": "伊涅芙",
            "text": "…相似度比对中…",
            "nextDialogs": [
              "760290237"
            ]
          },
          "760290237": {
            "id": "760290237",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "在和什么比对啦！",
            "nextDialogs": [
              "760290238"
            ]
          },
          "760290238": {
            "id": "760290238",
            "speakerId": 1003,
            "speakerName": "伊涅芙",
            "text": "与挪德卡莱月神像的人物相似度…百分之九十五…"
          }
        }
      }
    },

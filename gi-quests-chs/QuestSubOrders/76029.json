          "760290401": {
            "id": "760290401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(咦？琴声？看来哥伦比娅在给月灵们弹琴。）",
            "nextDialogs": [
              "760290402"
            ]
          },
          "760290402": {
            "id": "760290402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（上次来的时候琴还没修好。那已经是哥伦比娅还不认识大家的时候发生的事了…）",
            "nextDialogs": [
              "760290403"

    {
      "subId": "7406602",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740660201"
        ],
        "dialogs": {
          "740660201": {
            "id": "740660201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "——「交涉的艺术」…？哼，看书名就很无聊！我才没兴趣呢…欸？",
            "nextDialogs": [
              "740660202"
            ]
          },
          "740660202": {
            "id": "740660202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？这里还夹着一张通知？唔…「前往前台登记处参与特许食堂内部满意度调研，有机会获得特许券奖励…」",
            "nextDialogs": [
              "740660203"
            ]
          },
          "740660203": {
            "id": "740660203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「特许券」…哇！你看到了吗？有特许券可以领欸！没想到还有意外收获，我们赶快去吧！"
          }
        }
      }
    },
    {
      "subId": "7406603",
      "subQuestName": "与莫莱妮对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740660901"
        ],
        "dialogs": {
          "740660901": {
            "id": "740660901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（我已经准备好啦！放马过来吧！）",
            "nextDialogs": [
              "740660902"
            ]
          },
          "740660902": {
            "id": "740660902",
            "speakerId": 1001,
            "speakerName": "莫莱妮",
            "text": "第一问，请问您认为保持现今特许食堂内食物的低廉价格是否合理？",
            "nextDialogs": [
              "740660903"
            ]
          },
          "740660903": {
            "id": "740660903",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（唔——这个可怎么回答啊？我找找…找到了！就试试这个万能公式吧。）",
            "nextDialogs": [
              "740660904"
            ]
          },
          "740660904": {
            "id": "740660904",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（书上说这个「我同意你的观点，但…」什么情况都可以用。即使是深渊法师都会跟你好好交流，感觉好像很厉害的样子。）",
            "nextDialogs": [
              "740660906",
              "740660910",
              "740660915"
            ]
          },
          "740660906": {
            "id": "740660906",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…？那么难吃的东西，白送我我都不要啦。",
            "nextDialogs": [
              "740660907"
            ]
          },
          "740660907": {
            "id": "740660907",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可万一没有伙食费了…",
            "nextDialogs": [
              "740660908"
            ]
          },
          "740660908": {
            "id": "740660908",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…你这么一说还真是…不、不对！那我宁愿饿着也不吃这个！",
            "nextDialogs": [
              "740660918"
            ]
          },
          "740660918": {
            "id": "740660918",
            "speakerId": 1001,
            "speakerName": "莫莱妮",
            "text": "咳咳，打断一下。",
            "nextDialogs": [
              "740660919"
            ]
          },
          "740660919": {
            "id": "740660919",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "740660920"
            ]
          },
          "740660920": {
            "id": "740660920",
            "speakerId": 1001,
            "speakerName": "莫莱妮",
            "text": "根据规定，本项调研需要快速作答，我们先继续下一题吧。",
            "nextDialogs": [
              "740660921"
            ]
          },
          "740660921": {
            "id": "740660921",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好，好吧…既然是规定的话…",
            "nextDialogs": [
              "740660922"
            ]
          },
          "740660922": {
            "id": "740660922",
            "speakerId": 1001,
            "speakerName": "莫莱妮",
            "text": "第二问，请问就餐时间内特许食堂的食物供给是否充足。",
            "nextDialogs": [
              "740660923"
            ]
          },
          "740660923": {
            "id": "740660923",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "买倒是能买到…但是真的很难吃啦！"
          },
          "740660910": {
            "id": "740660910",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？！为什么啊?",
            "nextDialogs": [
              "740660911"
            ]
          },
          "740660911": {
            "id": "740660911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不要最好的，就要最贵的！",
            "nextDialogs": [
              "740660912"
            ]
          },
          "740660912": {
            "id": "740660912",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这是什么奇怪的想法啦！",
            "nextDialogs": [
              "740660913"
            ]
          },
          "740660913": {
            "id": "740660913",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你…你还好吗…感觉你不太对劲，不会是吃了什么奇怪的东西吧？"
          },
          "740660915": {
            "id": "740660915",
            "speakerId": 1001,
            "speakerName": "莫莱妮",
            "text": "但？",
            "nextDialogs": [
              "740660916"
            ]
          },
          "740660916": {
            "id": "740660916",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#但还有提升的空间！如果要再好吃一点就好了，你说对不对{NICKNAME}？",
            "nextDialogs": [
              "740660917"
            ]
          },
          "740660917": {
            "id": "740660917",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "或者…要是有甜甜花酿鸡卖就好了。对！那样的话，我愿意天天吃这里卖的东西！"
          }
        }
      }
    },
    {
      "subId": "7406603",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740660301"
        ],
        "dialogs": {
          "740660301": {
            "id": "740660301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "前台登记处…就是这里啦！我们去碰碰运气吧！",
            "nextDialogs": [
              "740660302"
            ]
          },
          "740660302": {
            "id": "740660302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "莫莱妮小姐，你好~",
            "nextDialogs": [
              "740660303"
            ]
          },
          "740660303": {
            "id": "740660303",
            "speakerId": 1001,
            "speakerName": "莫莱妮",
            "text": "……",
            "nextDialogs": [
              "740660304"
            ]
          },
          "740660304": {
            "id": "740660304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（呜哇——感觉好难相处的样子。）",
            "nextDialogs": [
              "740660305"
            ]
          },
          "740660305": {
            "id": "740660305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（要不试试「交涉的艺术」？）",
            "nextDialogs": [
              "740660306"
            ]
          },
          "740660306": {
            "id": "740660306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "（对哦，还有这个呢！没想到这本书还能在这里派上用场。）",
            "nextDialogs": [
              "740660307"
            ]
          },
          "740660307": {
            "id": "740660307",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我看看…找到啦！「如果你先声夺人在气势上压倒了对手…」",
            "nextDialogs": [
              "740660308"
            ]
          },
          "740660308": {
            "id": "740660308",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "就是这个！气势上压倒对手！我明白了！总而言之声音大一点就好了吧？",
            "nextDialogs": [
              "740660309"
            ]
          },
          "740660309": {
            "id": "740660309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂喂——莫莱妮小姐，你好——",
            "nextDialogs": [
              "740660310"
            ]
          },
          "740660310": {
            "id": "740660310",
            "speakerId": 1001,
            "speakerName": "莫莱妮",
            "text": "…听见了，请问您需要帮助吗？",
            "nextDialogs": [
              "740660311"
            ]
          },
          "740660311": {
            "id": "740660311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？居然真的有用！",
            "nextDialogs": [
              "740660312"
            ]
          },
          "740660312": {
            "id": "740660312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#嘿嘿，莫莱妮小姐，我们是来接受满意度调研的！啊，不对，我是陪{M#他}{F#她}来的啦。",
            "nextDialogs": [
              "740660313"
            ]
          },
          "740660313": {
            "id": "740660313",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#（别担心{NICKNAME}，我们有这本书。我会偷偷看书提醒你的！总之…嗯！总之你听我指示就好。）",
            "nextDialogs": [
              "740660314"
            ]
          },
          "740660314": {
            "id": "740660314",
            "speakerId": 1001,
            "speakerName": "莫莱妮",
            "text": "又是看到书里的通知来的啊…",
            "nextDialogs": [
              "740660315"
            ]
          },
          "740660315": {
            "id": "740660315",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯！对呀！",
            "nextDialogs": [
              "740660316"
            ]
          },
          "740660316": {
            "id": "740660316",
            "speakerId": 1001,
            "speakerName": "莫莱妮",
            "text": "到底放了多少张啊…其实…唉，算了，没事…",
            "nextDialogs": [
              "740660317"
            ]
          },
          "740660317": {
            "id": "740660317",
            "speakerId": 1001,
            "speakerName": "莫莱妮",
            "text": "咳咳，请您稍等…我先解释一下规则。本次的问卷一共有5个问题，请根据直觉快速回答。请注意，快速回答。",
            "nextDialogs": [
              "740660318"
            ]
          },
          "740660318": {
            "id": "740660318",
            "speakerId": 1001,
            "speakerName": "莫莱妮",
            "text": "明白了吗？等您准备好了我们就开始。"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7450901",
      "subQuestName": "与摊位旁的两人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745090101"
        ],
        "dialogs": {
          "745090101": {
            "id": "745090101",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "一段时间后，你与派蒙来到了「小小灵蕈大幻戏」的摊位前…",
            "nextDialogs": [
              "745090102"
            ]
          },
          "745090102": {
            "id": "745090102",
            "speakerId": 1001,
            "speakerName": "左右加",
            "text": "呀吼！「智巧勇武双连星」，你们又来玩「小小灵蕈大幻戏」啦！",
            "nextDialogs": [
              "745090103"
            ]
          },
          "745090103": {
            "id": "745090103",
            "speakerId": 1001,
            "speakerName": "左右加",
            "text": "昂吉安妮小姐接到了任务，先回执律庭去了，之后就由我来陪你们玩！",
            "nextDialogs": [
              "745090104"
            ]
          },
          "745090104": {
            "id": "745090104",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "左右加，你回来了！",
            "nextDialogs": [
              "745090105"
            ]
          },
          "745090105": {
            "id": "745090105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "虽然之前见到海妮耶的时候，已经大大吃惊过一次了，但你更夸张，我都觉得你这套衣服都有点精神过头了…",
            "nextDialogs": [
              "745090106"
            ]
          },
          "745090106": {
            "id": "745090106",
            "speakerId": 1001,
            "speakerName": "左右加",
            "text": "有精神是好事，我的活儿还有很多，干劲可不能早早用完。",
            "nextDialogs": [
              "745090107"
            ]
          },
          "745090107": {
            "id": "745090107",
            "speakerId": 1001,
            "speakerName": "左右加",
            "text": "要像挥舞斧子一样，把难题一个一个都劈开，嘿嘿！",
            "nextDialogs": [
              "745090110"
            ]
          },
          "745090110": {
            "id": "745090110",
            "speakerId": 1001,
            "speakerName": "左右加",
            "text": "计划正在稳步推进，这种新奇的活动能吸引不少目光，报社也不会放过大肆宣传的机会！",
            "nextDialogs": [
              "745090111"
            ]
          },
          "745090111": {
            "id": "745090111",
            "speakerId": 1001,
            "speakerName": "左右加",
            "text": "虽然我们没有拿到最重要的版面，但显而易见，最近活动受欢迎的程度一直在上升。",
            "nextDialogs": [
              "745090112"
            ]
          },
          "745090112": {
            "id": "745090112",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "的确，这段时间来摊位试玩「小小灵蕈大幻戏」的普通市民在不断增加。",
            "nextDialogs": [
              "745090113"
            ]
          },
          "745090113": {
            "id": "745090113",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "不少人开始讨论，如何搭配「小小灵蕈」的队伍，才能最快赢下游戏。",
            "nextDialogs": [
              "745090114"
            ]
          },
          "745090114": {
            "id": "745090114",
            "speakerId": 1003,
            "speakerName": "海妮耶",
            "text": "我也有听说，大家都想找到「黄金流星」和「白银伴星」，和你们好好较量一番，见识一下高手的玩法。"
          }
        }
      }
    },

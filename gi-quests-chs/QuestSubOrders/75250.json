    {
      "subId": "7525003",
      "subQuestName": "为愚人众定制合适颜色的玩具$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752500301"
        ],
        "dialogs": {
          "752500301": {
            "id": "752500301",
            "speakerId": 6588,
            "speakerName": "阿罗哈",
            "text": "这位客人，你来啦。今天真是有点忙不过来，我们的商品都脱销了，只剩一些半成品。",
            "nextDialogs": [
              "752500302"
            ]
          },
          "752500302": {
            "id": "752500302",
            "speakerId": 6588,
            "speakerName": "阿罗哈",
            "text": "您要是不介意…方不方便搭把手？给那些半成品上点色吧。"
          }
        }
      }
    },
    {
      "subId": "7525004",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752500201"
        ],
        "dialogs": {
          "752500201": {
            "id": "752500201",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "愚人众满足地离开了。"
          }
        }
      }
    },
    {
      "subId": "7525004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752500401"
        ],
        "dialogs": {
          "752500401": {
            "id": "752500401",
            "speakerId": 6588,
            "speakerName": "阿罗哈",
            "text": "就给他们准备对应色彩的玩具吧？这样一定能让他们满意。"
          }
        }
      }
    }

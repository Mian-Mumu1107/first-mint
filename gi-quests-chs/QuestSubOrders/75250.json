    {
      "subId": "7525001",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752500101"
        ],
        "dialogs": {
          "752500101": {
            "id": "752500101",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "买到玩偶的游客们陆续离开了，这时，有几位不速之客来到了绵驮园——",
            "nextDialogs": [
              "752500102"
            ]
          },
          "752500102": {
            "id": "752500102",
            "speakerId": 1001,
            "speakerName": "口齿不清的愚人众",
            "text": "欸…",
            "nextDialogs": [
              "752500103"
            ]
          },
          "752500103": {
            "id": "752500103",
            "speakerId": 6588,
            "speakerName": "阿罗哈",
            "text": "昨天来抢劫的愚人众？是你们！你们…你们还想干什么？",
            "nextDialogs": [
              "752500104"
            ]
          },
          "752500104": {
            "id": "752500104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有我在，别担心。",
            "nextDialogs": [
              "752500105"
            ]
          },
          "752500105": {
            "id": "752500105",
            "speakerId": 1001,
            "speakerName": "口齿不清的愚人众",
            "text": "不…",
            "nextDialogs": [
              "752500106"
            ]
          },
          "752500106": {
            "id": "752500106",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "为首的愚人众摆了摆手，递出了一张纸条。你摊开纸条，上面是歪歪扭扭的几句话——",
            "nextDialogs": [
              "752500107"
            ]
          },
          "752500107": {
            "id": "752500107",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "「我们是『队长』大人的部下…」",
            "nextDialogs": [
              "752500108"
            ]
          },
          "752500108": {
            "id": "752500108",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "「对不起，没办法开口，因为和『队长』大人一起作战时，喉咙受了伤…」",
            "nextDialogs": [
              "752500109"
            ]
          },
          "752500109": {
            "id": "752500109",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "「快要返回至冬，想带走一些纪念品…」",
            "nextDialogs": [
              "752500110"
            ]
          },
          "752500110": {
            "id": "752500110",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "「绵驮兽很好，很和平，希望所有人都是…」",
            "nextDialogs": [
              "752500111"
            ]
          },
          "752500111": {
            "id": "752500111",
            "speakerId": 1000,
            "speakerName": "Black Screen",
            "text": "「钱已经付过了，在昨天的口袋里。请给我们三个绵驮玩具，谢谢。」"
          }
        }
      }
    },
    {

  },
  "subQuests": [
    {
      "subId": "2201901",
      "subQuestName": "与珊瑚对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220190101"
        ],
        "dialogs": {
          "220190101": {
            "id": "220190101",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "…那么，就拜托两位了。",
            "nextDialogs": [
              "220190102"
            ]
          },
          "220190102": {
            "id": "220190102",
            "speakerId": 1001,
            "speakerName": "安藤",
            "text": "就交给我们了，放心吧，珊瑚小姐。",
            "nextDialogs": [
              "220190103"
            ]
          },
          "220190103": {
            "id": "220190103",
            "speakerId": 1002,
            "speakerName": "天野",
            "text": "居然在我们眼皮底下藏了这么久，真是胆大包天的家伙。",
            "nextDialogs": [
              "220190104"
            ]
          },
          "220190104": {
            "id": "220190104",
            "speakerId": 1002,
            "speakerName": "天野",
            "text": "而且，还用…那种身份。",
            "nextDialogs": [
              "220190105"
            ]
          },
          "220190105": {
            "id": "220190105",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "不管怎么样，他犯案的日子今天就要到头了。龙二，我交代你的事你记住了吧？",
            "nextDialogs": [
              "220190106"
            ]
          },
          "220190106": {
            "id": "220190106",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "是，社长。",
            "nextDialogs": [
              "220190107"
            ]
          },
          "220190107": {
            "id": "220190107",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "那就好…旅行者，你也来了啊，那太好了。",
            "nextDialogs": [
              "220190111",
              "220190110"
            ]
          },
          "220190111": {
            "id": "220190111",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "证据已经搜集充足，犯人的行为我也已经摸清了。",
            "nextDialogs": [
              "220190112"
            ]
          },
          "220190112": {
            "id": "220190112",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "旅行者，你就和龙二，还有安藤先生和天野先生同行，让那个犯人伏法吧。",
            "nextDialogs": [
              "220190113"
            ]
          },
          "220190113": {
            "id": "220190113",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "那家伙应该有不少同伙，有你在的话，行动成功的把握就更大了。"
          },
          "220190110": {
            "id": "220190110",
            "speakerId": 1000,
            "speakerName": "珊瑚",
            "text": "嗯，只要一切顺利，今天就可以结案了。"
          }
        }
      }
    },
    {
      "subId": "2201902",
      "subQuestName": "前往犯人所在地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220190201"
        ],
        "dialogs": {
          "220190201": {
            "id": "220190201",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "发现那家伙了，果然正在埋自己的赃物…",
            "nextDialogs": [
              "220190203",
              "220190205"
            ]
          },
          "220190203": {
            "id": "220190203",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "等一下，旅行者，现在…还不是我们该上的时候。",
            "nextDialogs": [
              "220190206"
            ]
          },
          "220190206": {
            "id": "220190206",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "再等一下…嗯…应该差不多了…",
            "nextDialogs": [
              "220190207"
            ]
          },
          "220190207": {
            "id": "220190207",
            "speakerId": 1001,
            "speakerName": "安藤",
            "text": "你这家伙，在做什么！",
            "nextDialogs": [
              "220190208"
            ]
          },
          "220190208": {
            "id": "220190208",
            "speakerId": 1002,
            "speakerName": "天野",
            "text": "放下手里的东西，别动！",
            "nextDialogs": [
              "220190209"
            ]
          },
          "220190209": {
            "id": "220190209",
            "speakerId": 1004,
            "speakerName": "石川八郎",
            "text": "你、你们是怎么…",
            "nextDialogs": [
              "220190210"
            ]
          },
          "220190210": {
            "id": "220190210",
            "speakerId": 1004,
            "speakerName": "石川八郎",
            "text": "可恶…别看着了！一起上！解决掉这两个家伙，我们就远走高飞！",
            "nextDialogs": [
              "220190211"
            ]
          },
          "220190211": {
            "id": "220190211",
            "speakerId": 1002,
            "speakerName": "天野",
            "text": "几个盗宝团，居然敢这么嚣张…",
            "nextDialogs": [
              "220190212"
            ]
          },
          "220190212": {
            "id": "220190212",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "安藤先生，天野先生，我们来帮你！",
            "nextDialogs": [
              "220190213"
            ]
          },
          "220190213": {
            "id": "220190213",
            "speakerId": 1001,
            "speakerName": "安藤",
            "text": "哦！就拜托你们了！",
            "nextDialogs": [
              "220190214"
            ]
          },
          "220190214": {
            "id": "220190214",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "旅行者，现在我们可以上场了。",
            "nextDialogs": [
              "220190215"
            ]
          },
          "220190215": {
            "id": "220190215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "搞这么麻烦…",
            "nextDialogs": [
              "220190216"
            ]
          },
          "220190216": {
            "id": "220190216",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "这都是社长的嘱咐。",
            "nextDialogs": [
              "220190217"
            ]
          },
          "220190217": {
            "id": "220190217",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "好了，我们上吧。"
          },
          "220190205": {
            "id": "220190205",
            "speakerId": 1003,
            "speakerName": "龙二",
            "text": "稍等一下，现在还不是我们该上的时候。"
          }
        }
      }
    },
    {
      "subId": "2201903",
      "subQuestName": "与龙二对话",
      "sceneId": null,

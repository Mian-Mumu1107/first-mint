  "subQuests": [
    {
      "subId": "7069601",
      "subQuestName": "与八重神子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706960101"
        ],
        "dialogs": {
          "706960101": {
            "id": "706960101",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "好久不见了，小家伙。最近去哪儿旅行了？",
            "nextDialogs": [
              "706960102"
            ]
          },
          "706960102": {
            "id": "706960102",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "将雪山的见闻告知了神子。",
            "nextDialogs": [
              "706960103"
            ]
          },
          "706960103": {
            "id": "706960103",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "嗯，真是群可爱的孩子呀。",
            "nextDialogs": [
              "706960104"
            ]
          },
          "706960104": {
            "id": "706960104",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "为了共同的爱好，不管相隔多远也要相聚……啊呀，青春的气息真是扑面而来。",
            "nextDialogs": [
              "706960105"
            ]
          },
          "706960105": {
            "id": "706960105",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "看来《炽魂斗士战记》的魅力不小呢，是时候把再版计划提上日程了…",
            "nextDialogs": [
              "706960106"
            ]
          },
          "706960106": {
            "id": "706960106",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "读者们这么真诚，我也必须表示一下心意才行呢。",
            "nextDialogs": [
              "706960107"
            ]
          },
          "706960107": {
            "id": "706960107",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "给你们赠送一些漫画如何？嗯…人不少，得多送几本。",
            "nextDialogs": [
              "706960110"
            ]
          },
          "706960110": {
            "id": "706960110",
            "speakerId": 1000,
            "speakerName": "八重神子",
            "text": "都是初版印刷品，外面可买不到，好好珍惜哦。"
          }
        }
      }
    },
    {
      "subId": "7069602",
      "subQuestName": "返回营地放置礼物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706960201"
        ],
        "dialogs": {
          "706960201": {
            "id": "706960201",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "神子送了我们不少漫画，既然决定了要和大家分享，干脆就把它们都摆出来吧。",
            "nextDialogs": [
              "706960202"
            ]
          },
          "706960202": {
            "id": "706960202",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "就放在「特战队」营地书摊附近吧，方便大家拿去看。",
            "nextDialogs": [
              "706960203"
            ]
          },
          "706960203": {
            "id": "706960203",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "借来一个书柜，将神子赠送的漫画都放了进去。",
            "nextDialogs": [
              "706960204"
            ]
          },
          "706960204": {
            "id": "706960204",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不错不错，这样一来，大家空闲的时候就能来挑漫画了。"
          }
        }
      }
    }
  ]
}
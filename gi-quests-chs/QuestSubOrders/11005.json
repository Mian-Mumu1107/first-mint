    {
      "subId": "1100508",
      "subQuestName": "将洗干净的白萝卜交给香菱",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110050801"
        ],
        "dialogs": {
          "110050801": {
            "id": "110050801",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "哇，又大又水灵，太完美了，谢谢你们！",
            "nextDialogs": [
              "110050802"
            ]
          },
          "110050802": {
            "id": "110050802",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "嗯，我想想看，要不然…",
            "nextDialogs": [
              "110050803"
            ]
          },
          "110050803": {
            "id": "110050803",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！你看，香菱，锅都烧起来了！",
            "nextDialogs": [
              "110050804"
            ]
          },
          "110050804": {
            "id": "110050804",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "啊啊啊！不好！这样会烧焦的！",
            "nextDialogs": [
              "110050805"
            ]
          },
          "110050805": {
            "id": "110050805",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "#{NICKNAME}，快帮我把锅的火控制下来！记得别用水去浇啊，不然也白做了！"
          }
        }
      }
    },
    {
      "subId": "1100509",

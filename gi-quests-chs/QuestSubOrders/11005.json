    {
      "subId": "1100510",
      "subQuestName": "继续帮助香菱",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051002"
        ],
        "dialogs": {
          "110051002": {
            "id": "110051002",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "啊啊…全都烧焦了，呜呜呜，只好再做一些了。",
            "nextDialogs": [
              "110051003"
            ]
          },
          "110051003": {
            "id": "110051003",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "对了，我在考虑主菜是不是单薄了一些，想要有一些变化。",
            "nextDialogs": [
              "110051004"
            ]
          },
          "110051004": {
            "id": "110051004",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "帮我做一份野菇鸡肉串吧！外面咔嚓咔嚓，里面滴答滴答的那种！",
            "nextDialogs": [
              "110051007"
            ]
          },
          "110051007": {
            "id": "110051007",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就是要<color=#00E1FFFF>美味的，最美味的那种</color>！"
          }
        }
      }
    },
    {
      "subId": "1100511",
      "subQuestName": "烹饪「美味的野菇鸡肉串」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1100512",
      "subQuestName": "将「美味的野菇鸡肉串」交给香菱",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051201"
        ],
        "dialogs": {
          "110051201": {
            "id": "110051201",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "#好香啊，{NICKNAME}，你真是有做菜的天赋！",
            "nextDialogs": [
              "110051202"
            ]
          },
          "110051202": {
            "id": "110051202",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "现在主菜的制作很顺利，但距离完美…可能还差点特别的感觉。",
            "nextDialogs": [
              "110051203"
            ]
          },
          "110051203": {
            "id": "110051203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "感觉？",
            "nextDialogs": [
              "110051204"
            ]
          },
          "110051204": {
            "id": "110051204",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "就是那种「噼咔」的感觉！",
            "nextDialogs": [
              "110051205"
            ]
          },
          "110051205": {
            "id": "110051205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊啊，原来是「噼咔」的感觉！",
            "nextDialogs": [
              "110051208"
            ]
          },
          "110051208": {
            "id": "110051208",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "如果只是这样端上去，太浪费这么好的材料了。",
            "nextDialogs": [
              "110051209"
            ]
          },
          "110051209": {
            "id": "110051209",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我想想看…啊啊，如果能有什么能增添风味的东西就好了。",
            "nextDialogs": [
              "110051210"
            ]
          },
          "110051210": {
            "id": "110051210",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "风味？",
            "nextDialogs": [
              "110051211"
            ]
          },
          "110051211": {
            "id": "110051211",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "对，最好是就在这附近有的，很少用来入菜的生物。",
            "nextDialogs": [
              "110051212"
            ]
          },
          "110051212": {
            "id": "110051212",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "天上飞的，地上爬的都行，可以是昆虫，或者…蹦蹦跳跳的？",
            "nextDialogs": [
              "110051213"
            ]
          },
          "110051213": {
            "id": "110051213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的要加听起来这么恐怖的东西进去吗？",
            "nextDialogs": [
              "110051214"
            ]
          },
          "110051214": {
            "id": "110051214",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "没事啦，相信我的直觉！",
            "nextDialogs": [
              "110051215"
            ]
          },
          "110051215": {
            "id": "110051215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧…"
          }
        }
      }
    },
    {
      "subId": "1100513",
      "subQuestName": "找到符合描述的食材",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051301"
        ],
        "dialogs": {
          "110051301": {
            "id": "110051301",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "辛苦了辛苦了！快让我看看你找到了什么？",
            "nextDialogs": [
              "110051304"
            ]
          },
          "110051304": {
            "id": "110051304",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "不好意思要麻烦你再跑一趟。",
            "nextDialogs": [
              "110051305"
            ]
          },
          "110051305": {
            "id": "110051305",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我想要的是一种很少入菜的生物。",
            "nextDialogs": [
              "110051306"
            ]
          },
          "110051306": {
            "id": "110051306",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "天上飞的，地上爬的，跳的，都可以！也可以是昆虫！",
            "nextDialogs": [
              "110051399"
            ]
          },
          "110051399": {
            "id": "110051399",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "可能有点难找，但我相信你绝对没问题的！"
          }
        }
      }
    },
    {
      "subId": "1100514",
      "subQuestName": "询问香菱对食材是否满意",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051401"
        ],
        "dialogs": {
          "110051401": {
            "id": "110051401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真的要加这种东西进去吗…",
            "nextDialogs": [
              "110051402"
            ]
          },
          "110051402": {
            "id": "110051402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总感觉会怪怪的。",
            "nextDialogs": [
              "110051403"
            ]
          },
          "110051403": {
            "id": "110051403",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "放心放心，谢谢你们找来这么好的东西，我现在要专心料理了。",
            "nextDialogs": [
              "110051404"
            ]
          },
          "110051404": {
            "id": "110051404",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "如果还有需要帮忙的事，还要再麻烦你们了，嘿嘿！"
          }
        }
      }
    },
    {
      "subId": "1100504",
      "subQuestName": "比赛倒计时、计分判断用$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1100515",
      "subQuestName": "询问香菱是否还需帮忙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051501"
        ],
        "dialogs": {
          "110051501": {
            "id": "110051501",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "对了对了，配菜。还需要一道配菜！",
            "nextDialogs": [
              "110051503",
              "110051505"
            ]
          },
          "110051503": {
            "id": "110051503",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "欸？没问题吗？",
            "nextDialogs": [
              "110051506"
            ]
          },
          "110051506": {
            "id": "110051506",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "那么这个就交给你了，这是我临时写的！",
            "nextDialogs": [
              "110051507"
            ]
          },
          "110051507": {
            "id": "110051507",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "里面提到的材料也全都给你们。",
            "nextDialogs": [
              "110051508"
            ]
          },
          "110051508": {
            "id": "110051508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这就是你之前给我们吃的那个菜的<color=#00E1FFFF>食谱</color>吗？！",
            "nextDialogs": [
              "110051509"
            ]
          },
          "110051509": {
            "id": "110051509",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "是的，我又改良了一下，把多出来的璃月食材用上了。",
            "nextDialogs": [
              "110051510"
            ]
          },
          "110051510": {
            "id": "110051510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么难的料理，真的能做好吗…",
            "nextDialogs": [
              "110051511"
            ]
          },
          "110051511": {
            "id": "110051511",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "料理技术不重要，重要的是热爱！这是爸爸告诉我的。",
            "nextDialogs": [
              "110051512"
            ]
          },
          "110051512": {
            "id": "110051512",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "你们帮了我这么多忙，一定也非常热爱料理吧。",
            "nextDialogs": [
              "110051513"
            ]
          },
          "110051513": {
            "id": "110051513",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我相信你们，绝对能做出最美味的配菜的！"
          },
          "110051505": {
            "id": "110051505",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "谢谢！你很了解我嘛，嘿嘿。"
          }
        }
      }
    },
    {
      "subId": "1100599",
      "subQuestName": "火腿$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110059901"
        ],
        "dialogs": {
          "110059901": {
            "id": "110059901",
            "speakerId": 10035,
            "speakerName": "杜拉夫",
            "text": "蒙德与璃月的料理碰撞，想想就让人觉得兴奋。"
          }
        }
      }
    },
    {
      "subId": "1100516",
      "subQuestName": "烹饪「美味的翡玉什锦袋」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051601"
        ],
        "dialogs": {
          "110051601": {
            "id": "110051601",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "「翡玉什锦袋」做好了吗？",
            "nextDialogs": [
              "110051602"
            ]
          },
          "110051602": {
            "id": "110051602",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "味道最重要，但也别耽误太长的时间。等你做好拿过来，我就出菜！"
          }
        }
      }
    },
    {
      "subId": "1100517",
      "subQuestName": "将「美味的翡玉什锦袋」交给香菱",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051701"
        ],
        "dialogs": {
          "110051701": {
            "id": "110051701",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "哇，香味在很远的地方就已经飘过来了！",
            "nextDialogs": [
              "110051702"
            ]
          },
          "110051702": {
            "id": "110051702",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "一切就绪，准备出菜！我们一定会赢的！"
          }
        }
      }
    },
    {
      "subId": "1100518",
      "subQuestName": "与杜拉夫交谈，等待结果",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051801"
        ],
        "dialogs": {
          "110051801": {
            "id": "110051801",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "真是美味的大餐，居然能吃到这么好吃的东西。",
            "nextDialogs": [
              "110051802"
            ]
          },
          "110051802": {
            "id": "110051802",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "两位大厨的手艺我都尝过了，实在是难分高下。",
            "nextDialogs": [
              "110051803"
            ]
          },
          "110051803": {
            "id": "110051803",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "不过既然是比赛就要有胜负，在这里我宣布——",
            "nextDialogs": [
              "110051804"
            ]
          },
          "110051804": {
            "id": "110051804",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "香菱的料理更胜一筹。",
            "nextDialogs": [
              "110051805"
            ]
          },
          "110051805": {
            "id": "110051805",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "耶！赢啦！太好了！",
            "nextDialogs": [
              "110051806"
            ]
          },
          "110051806": {
            "id": "110051806",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "唉，本来以为我的「野猪王在争夺地盘的决斗后负伤的胜者刚刚长好的那块新鲜嫩肉」是不会输的啊。",
            "nextDialogs": [
              "110051807"
            ]
          },
          "110051807": {
            "id": "110051807",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "果然还是敌不过已经灭绝的野猪肉的味道。",
            "nextDialogs": [
              "110051808"
            ]
          },
          "110051808": {
            "id": "110051808",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "什么？这居然是用已经灭绝的猪肉做的？",
            "nextDialogs": [
              "110051809"
            ]
          },
          "110051809": {
            "id": "110051809",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "对啊，全都做成料理了。",
            "nextDialogs": [
              "110051810"
            ]
          },
          "110051810": {
            "id": "110051810",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "那我岂不是一口吃掉了几十万摩拉！",
            "nextDialogs": [
              "110051811"
            ]
          },
          "110051811": {
            "id": "110051811",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "要是拿去卖的话，能顶得上镇子几年狩猎的收入了吧！",
            "nextDialogs": [
              "110051812"
            ]
          },
          "110051812": {
            "id": "110051812",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "哈哈，好吃就可以了，摩拉什么的不重要啦。",
            "nextDialogs": [
              "110051813"
            ]
          },
          "110051813": {
            "id": "110051813",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "对了，既然评审已经结束了，大家都来尝尝吧！我做了很多的！",
            "nextDialogs": [
              "110051814"
            ]
          },
          "110051814": {
            "id": "110051814",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我也尝尝布洛克的手艺。",
            "nextDialogs": [
              "110051815"
            ]
          },
          "110051815": {
            "id": "110051815",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "这种美味…唉，输得心服口服呢。",
            "nextDialogs": [
              "110051816"
            ]
          },
          "110051816": {
            "id": "110051816",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "输是输了，但能吃到这么好吃的菜，我也满足了！麻烦再来一份！",
            "nextDialogs": [
              "110051817"
            ]
          },
          "110051817": {
            "id": "110051817",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "原来这个也这么美味，这层次分明的口感…",
            "nextDialogs": [
              "110051818"
            ]
          },
          "110051818": {
            "id": "110051818",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "#要是我没有这块美味的肉，还有{NICKNAME}做得这么棒的配菜，胜负真不好说啊。",
            "nextDialogs": [
              "110051819"
            ]
          },
          "110051819": {
            "id": "110051819",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "轮到我来吃了！",
            "nextDialogs": [
              "110051820"
            ]
          },
          "110051820": {
            "id": "110051820",
            "speakerId": 10037,
            "speakerName": "奥拉夫",
            "text": "我也尝一点吧。",
            "nextDialogs": [
              "110051821"
            ]
          },
          "110051821": {
            "id": "110051821",
            "speakerId": 10037,
            "speakerName": "奥拉夫",
            "text": "这…这味道？！",
            "nextDialogs": [
              "110051822"
            ]
          },
          "110051822": {
            "id": "110051822",
            "speakerId": 10037,
            "speakerName": "奥拉夫",
            "text": "是清泉镇…不，应该说是以前的清泉镇的味道。",
            "nextDialogs": [
              "110051823"
            ]
          },
          "110051823": {
            "id": "110051823",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好吃到哭了…",
            "nextDialogs": [
              "110051824"
            ]
          },
          "110051824": {
            "id": "110051824",
            "speakerId": 10037,
            "speakerName": "奥拉夫",
            "text": "呜呜，这是…这是，最后几口那个时代的味道了…",
            "nextDialogs": [
              "110051825"
            ]
          },
          "110051825": {
            "id": "110051825",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "啊啊，别伤心，别伤心，你想要这种味道的话，我还可以做的！",
            "nextDialogs": [
              "110051826"
            ]
          },
          "110051826": {
            "id": "110051826",
            "speakerId": 10037,
            "speakerName": "奥拉夫",
            "text": "真、真的吗？但是那种古代野猪已经灭绝了…",
            "nextDialogs": [
              "110051827"
            ]
          },
          "110051827": {
            "id": "110051827",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "是这样没错，但是味道没有灭绝啊，用其他的材料还可以做出来的。",
            "nextDialogs": [
              "110051828"
            ]
          },
          "110051828": {
            "id": "110051828",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "给食客带来笑容，这就是厨师的使命啊！",
            "nextDialogs": [
              "110051829"
            ]
          },
          "110051829": {
            "id": "110051829",
            "speakerId": 10037,
            "speakerName": "奥拉夫",
            "text": "谢谢你，呜…呜呜呜呜…"
          }
        }
      }
    },
    {
      "subId": "1100519",
      "subQuestName": "接受香菱的感谢",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051901"
        ],
        "dialogs": {
          "110051901": {
            "id": "110051901",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "非常感谢你，没有你的帮忙，还不知道会怎么样呢。",
            "nextDialogs": [
              "110051902"
            ]
          },
          "110051902": {
            "id": "110051902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也多亏你，我尝到了好多好多好吃的东西。",
            "nextDialogs": [
              "110051903"
            ]
          },
          "110051903": {
            "id": "110051903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好饱好饱。",
            "nextDialogs": [
              "110051904"
            ]
          },
          "110051904": {
            "id": "110051904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "接下来打算去哪里？",
            "nextDialogs": [
              "110051905"
            ]
          },
          "110051905": {
            "id": "110051905",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "不知道，打算回一趟璃月港，但可能中途就改变了计划。",
            "nextDialogs": [
              "110051906"
            ]
          },
          "110051906": {
            "id": "110051906",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "因为我不喜欢计划这种东西嘛。",
            "nextDialogs": [
              "110051907"
            ]
          },
          "110051907": {
            "id": "110051907",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "说不定你又会在野外的某个地方遇到我。",
            "nextDialogs": [
              "110051908"
            ]
          },
          "110051908": {
            "id": "110051908",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真是洒脱啊。",
            "nextDialogs": [
              "110051909"
            ]
          },
          "110051909": {
            "id": "110051909",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "#我觉得你很有料理的天赋，{NICKNAME}，翡玉什锦袋完成得很好。",
            "nextDialogs": [
              "110051910"
            ]
          },
          "110051910": {
            "id": "110051910",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "有空来「万民堂」吧！说好了请你们吃好吃的！",
            "nextDialogs": [
              "110051911"
            ]
          },
          "110051911": {
            "id": "110051911",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "如果想学的话，还能教你几道创新菜！",
            "nextDialogs": [
              "110051913",
              "110051915"
            ]
          },
          "110051913": {
            "id": "110051913",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "一言为定！",
            "nextDialogs": [
              "110051916"
            ]
          },
          "110051916": {
            "id": "110051916",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "#嘿嘿，那我们有机会再见啦，{NICKNAME}！"
          },
          "110051915": {
            "id": "110051915",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "啊？为什么你会知道我在想什么？！"
          }
        }
      }
    },
    {
      "subId": "1100595",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

        ],
        "dialogs": {
          "110059501": {
            "id": "110059501",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "咔嚓咔嚓，滴答滴答~咔嚓咔嚓，滴答滴答~"
          }
        }
      }
    },
    {
      "subId": "1100596",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110059601"
        ],
        "dialogs": {
          "110059601": {
            "id": "110059601",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "快把火压下去，要烧焦了！"
          }
        }
      }
    },
    {
      "subId": "1100597",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110059701"
        ],
        "dialogs": {
          "110059701": {
            "id": "110059701",
            "speakerId": 10033,
            "speakerName": "香菱",
            "text": "麻烦找些白萝卜回来，记得要去湖边洗干净哦？"
          }
        }
      }
    },
    {
      "subId": "1100598",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110059801"
        ],
        "dialogs": {
          "110059801": {
            "id": "110059801",
            "speakerId": 10036,
            "speakerName": "布洛克",
            "text": "怎么？来打探敌情？",
            "nextDialogs": [
              "110059802"
            ]
          },
          "110059802": {
            "id": "110059802",
            "speakerId": 10036,
            "speakerName": "布洛克",
            "text": "哼哼，我已经拿到了必胜的材料，你们不可能赢的。",
            "nextDialogs": [
              "110059803"
            ]
          },
          "110059803": {
            "id": "110059803",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "好香啊…偷吃一点点应该没关系吧？",
            "nextDialogs": [
              "110059804"
            ]
          },
          "110059804": {
            "id": "110059804",
            "speakerId": 1631,
            "speakerName": "齐格芙丽雅",
            "text": "不行不行，我是来帮忙的…比赛要紧，比赛要紧！",
            "nextDialogs": [
              "110059805"
            ]
          },
          "110059805": {
            "id": "110059805",
            "speakerId": 10037,
            "speakerName": "奥拉夫",
            "text": "我们原来都是烤一烤就直接吃，现在居然有这么多花样了…"
          }
        }
      }
    }
  ]
}
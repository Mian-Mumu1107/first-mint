  "subQuests": [
    {
      "subId": "1100501",
      "subQuestName": "回到清泉镇，参加料理对决",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110050101"
        ],
        "dialogs": {
          "110050101": {
            "id": "110050101",
            "speakerId": 10037,
            "speakerName": "奥拉夫",
            "text": "这里…真的是清泉镇没错吧？",
            "nextDialogs": [
              "110050102"
            ]
          },
          "110050102": {
            "id": "110050102",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "是的啊，我都回答了很多次了，但是你要找的人我一个都不认识。",
            "nextDialogs": [
              "110050103"
            ]
          },
          "110050103": {
            "id": "110050103",
            "speakerId": 10037,
            "speakerName": "奥拉夫",
            "text": "不可能啊，他们都住在清泉镇，都是我的邻居和朋友。",
            "nextDialogs": [
              "110050104"
            ]
          },
          "110050104": {
            "id": "110050104",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "这就奇怪了，到底是怎么回事啊？",
            "nextDialogs": [
              "110050107"
            ]
          },
          "110050107": {
            "id": "110050107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你想到什么了？"
          }
        }
      }
    },
    {
      "subId": "1100502",
      "subQuestName": "在料理对决现场与香菱交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110050201"
        ],
        "dialogs": {
          "110050201": {
            "id": "110050201",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "我们的食材已经都准备好了，你呢？",
            "nextDialogs": [
              "110050202"
            ]
          },
          "110050202": {
            "id": "110050202",
            "speakerId": 1541,
            "speakerName": "布洛克",
            "text": "当然准备好了。对决的时候，齐格芙丽雅会担任我的副手。",
            "nextDialogs": [
              "110050203"
            ]
          },
          "110050203": {
            "id": "110050203",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "那现在开始比赛，我就来当这个评委了。",
            "nextDialogs": [
              "110050204"
            ]
          },
          "110050204": {
            "id": "110050204",
            "speakerId": 1537,
            "speakerName": "杜拉夫",
            "text": "放心，虽然我认识布洛克时间更长，但我会公正评判的。",
            "nextDialogs": [
              "110050205"
            ]
          },
          "110050205": {
            "id": "110050205",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "#那就拜托你了。{NICKNAME}，派蒙，我们快去做准备吧！",
            "nextDialogs": [
              "110050206"
            ]
          },
          "110050206": {
            "id": "110050206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们还要参加吗？",
            "nextDialogs": [
              "110050207"
            ]
          },
          "110050207": {
            "id": "110050207",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "当然了，布洛克都找了副手，你们就当我的副手吧！关键时候都靠你们了！",
            "nextDialogs": [
              "110050208"
            ]
          },
          "110050208": {
            "id": "110050208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么时候变成副手了…",
            "nextDialogs": [
              "110050211"
            ]
          },
          "110050211": {
            "id": "110050211",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，为了好吃的我也会努力的！"
          }
        }
      }
    },
    {
      "subId": "1100503",
      "subQuestName": "在料理对决中协助香菱",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110050301"
        ],
        "dialogs": {
          "110050301": {
            "id": "110050301",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "首先是食材的问题，肉排需要点缀，但食材里我没找到很合适的。嗯，我想想…",
            "nextDialogs": [
              "110050302"
            ]
          },
          "110050302": {
            "id": "110050302",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "啊，我想到了，用白萝卜吧！白萝卜削成泥，或者切成丝都很爽口。",
            "nextDialogs": [
              "110050303"
            ]
          },
          "110050303": {
            "id": "110050303",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "还能雕成花来装饰！一举两得！",
            "nextDialogs": [
              "110050304"
            ]
          },
          "110050304": {
            "id": "110050304",
            "speakerId": 1012,
            "speakerName": "香菱",
            "text": "麻烦你去找一下白萝卜吧，这附近应该就有。对了对了，要洗干净！因为是直接入菜的！"
          }
        }
      }
    },

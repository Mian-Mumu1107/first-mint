    "特雷斯": 5,
    "米卡": 3
  },
  "subQuests": [
    {
      "subId": "7055901",
      "subQuestName": "与特雷斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705590101"
        ],
        "dialogs": {
          "705590101": {
            "id": "705590101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "大家好呀！看起来，你们的精神都不错呢！",
            "nextDialogs": [
              "705590102"
            ]
          },
          "705590102": {
            "id": "705590102",
            "speakerId": 1001,
            "speakerName": "特雷斯",
            "text": "多谢关心，这几天收获很大，还要多多感谢米卡教官、埃洛雯，还有荣誉骑士和派蒙…",
            "nextDialogs": [
              "705590103"
            ]
          },
          "705590103": {
            "id": "705590103",
            "speakerId": 1002,
            "speakerName": "埃洛雯",
            "text": "唔，好像有点在发表什么获奖感言？不过好像也可以这么说，毕竟特雷斯的成果可算是大获成功！",
            "nextDialogs": [
              "705590104"
            ]
          },
          "705590104": {
            "id": "705590104",
            "speakerId": 1003,
            "speakerName": "米卡",
            "text": "没错…从骑士团任务的角度考虑，特雷斯目前的测绘技巧，已经足以应对九成以上的情景了。",
            "nextDialogs": [
              "705590105"
            ]
          },
          "705590105": {
            "id": "705590105",
            "speakerId": 1003,
            "speakerName": "米卡",
            "text": "当然，要不是荣誉骑士前辈挑战「测绘寻物」的思路带给了我们启发，这次的训练可能还需要三倍的时间…",
            "nextDialogs": [
              "705590106"
            ]
          },
          "705590106": {
            "id": "705590106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#说明我们配合得好，有默契，对不对？{NICKNAME}觉得呢？",
            "nextDialogs": [
              "705590109"
            ]
          },
          "705590109": {
            "id": "705590109",
            "speakerId": 1001,
            "speakerName": "特雷斯",
            "text": "真、真的吗？荣誉骑士前辈这么说了之后，不知道为什么，好像紧张都消散一些了…",
            "nextDialogs": [
              "705590110"
            ]
          },
          "705590110": {
            "id": "705590110",
            "speakerId": 1001,
            "speakerName": "特雷斯",
            "text": "我总是担心如果我做不好，就会出现像米卡教官说那种情况——「结果往往影响的不仅仅是你自己」…",
            "nextDialogs": [
              "705590111"
            ]
          },
          "705590111": {
            "id": "705590111",
            "speakerId": 1002,
            "speakerName": "埃洛雯",
            "text": "可恶！但你已经获得了荣誉骑士的认可…如果我能等到这一句…",
            "nextDialogs": [
              "705590112"
            ]
          },
          "705590112": {
            "id": "705590112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "埃洛雯也很棒！",
            "nextDialogs": [
              "705590113"
            ]
          },
          "705590113": {
            "id": "705590113",
            "speakerId": 1002,
            "speakerName": "埃洛雯",
            "text": "欸…欸？！真的吗？我吗？我、我会好好记住的！",
            "nextDialogs": [
              "705590114"
            ]
          },
          "705590114": {
            "id": "705590114",
            "speakerId": 1002,
            "speakerName": "埃洛雯",
            "text": "…让我好好想想，要用什么方式来庆祝这一天呢…",
            "nextDialogs": [
              "705590115"
            ]
          },
          "705590115": {
            "id": "705590115",
            "speakerId": 1001,
            "speakerName": "特雷斯",
            "text": "说到庆祝。我倒是有个想法…有什么比一顿热气腾腾的美食更适合庆祝呢？听说埃洛雯的手艺…",
            "nextDialogs": [
              "705590116"
            ]
          },
          "705590116": {
            "id": "705590116",
            "speakerId": 1002,
            "speakerName": "埃洛雯",
            "text": "嗯？想尝尝我的手艺吗…之前我只在行军路上做过饭，因为我总是倒霉抽到坏签…当然，如果你们不嫌难吃的话…",
            "nextDialogs": [
              "705590117"
            ]
          },
          "705590117": {
            "id": "705590117",
            "speakerId": 1001,
            "speakerName": "特雷斯",
            "text": "怎么会？埃洛雯的手艺在骑士团里也算是远近闻名了吧。",
            "nextDialogs": [
              "705590118"
            ]
          },
          "705590118": {
            "id": "705590118",
            "speakerId": 1003,
            "speakerName": "米卡",
            "text": "确实…目前还没有听到过一句差评呢…",
            "nextDialogs": [
              "705590119"
            ]
          },
          "705590119": {
            "id": "705590119",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇！那我更好奇了！埃洛雯，让我们尝尝你的手艺嘛！",
            "nextDialogs": [
              "705590120"
            ]
          },
          "705590120": {
            "id": "705590120",
            "speakerId": 1002,
            "speakerName": "埃洛雯",
            "text": "既然大家都这么说了，那就没问题！我想，我只需要一些准备…",
            "nextDialogs": [
              "705590121"
            ]
          },
          "705590121": {
            "id": "705590121",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "众人一起预处理食材、搭建临时灶台后，埃洛雯烹饪了许多看起来平平无奇，但香气却很诱人的美食…",
            "nextDialogs": [
              "705590122"
            ]
          },
          "705590122": {
            "id": "705590122",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "大家像野餐那样，围成一圈坐下，享用了这顿独特的饭菜…"
          }
        }
      }
    }
  ]
}
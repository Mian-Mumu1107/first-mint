    {
      "subId": "7224905",
      "subQuestName": "与残魂对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722490301"
        ],
        "dialogs": {
          "722490301": {
            "id": "722490301",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾乃…",
            "nextDialogs": [
              "722490302"
            ]
          },
          "722490302": {
            "id": "722490302",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
            "nextDialogs": [
              "722490303"
            ]
          },
          "722490303": {
            "id": "722490303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，赫利俄斯？",
            "nextDialogs": [
              "722490304"
            ]
          },
          "722490304": {
            "id": "722490304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "赫利俄斯是什么很了不起的东西吗？",
            "nextDialogs": [
              "722490305"
            ]
          },
          "722490305": {
            "id": "722490305",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "当然！吾当时主持建造赫利俄斯，举全国之力，以此抵御深海龙嗣。",
            "nextDialogs": [
              "722490306"
            ]
          },
          "722490306": {
            "id": "722490306",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "是整个白夜国，除吾之外，再无第二人能完成的伟业！",
            "nextDialogs": [
              "722490307"
            ]
          },
          "722490307": {
            "id": "722490307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊，听上去真是了不起。",
            "nextDialogs": [
              "722490308"
            ]
          },
          "722490308": {
            "id": "722490308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可是这么了不起的大人物，为什么会被封在这里呢？",
            "nextDialogs": [
              "722490309"
            ]
          },
          "722490309": {
            "id": "722490309",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾…吾是被人背叛…",
            "nextDialogs": [
              "722490310"
            ]
          },
          "722490310": {
            "id": "722490310",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "当初天国塌落于无底深渊之下，诸民受龙嗣所害，是吾，吾掌持建造赫利俄斯，以此救众生于倒悬。",
            "nextDialogs": [
              "722490311"
            ]
          },
          "722490311": {
            "id": "722490311",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "可是那群贪鄙小人！一旦性命无虞，就行欺上瞒下之事…最后竟还，推举稚童作国首。可笑！",
            "nextDialogs": [
              "722490312"
            ]
          },
          "722490312": {
            "id": "722490312",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "就连吾也被他们陷害，身死囹圄之中！",
            "nextDialogs": [
              "722490313"
            ]
          },
          "722490313": {
            "id": "722490313",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "可恶！可恶！",
            "nextDialogs": [
              "722490314"
            ]
          },
          "722490314": {
            "id": "722490314",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "对了，汝。",
            "nextDialogs": [
              "722490316",
              "722490318"
            ]
          },
          "722490316": {
            "id": "722490316",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是你。",
            "nextDialogs": [
              "722490320"
            ]
          },
          "722490320": {
            "id": "722490320",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "就是汝！",
            "nextDialogs": [
              "722490321"
            ]
          },
          "722490321": {
            "id": "722490321",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "原本吾之圣服被放置于此，只可惜年月之久，仅余残丝败缕，已难以作为凭依。",
            "nextDialogs": [
              "722490322"
            ]
          },
          "722490322": {
            "id": "722490322",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "只要汝能通过考验，吾就将寄托意念的供奉之物托付于汝。",
            "nextDialogs": [
              "722490323"
            ]
          },
          "722490323": {
            "id": "722490323",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "希望汝能…成功通过…",
            "nextDialogs": [
              "722490324"
            ]
          },
          "722490324": {
            "id": "722490324",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "此事凶险，旅者啊，若汝准备好了，再与吾说吧。"
          },
          "722490318": {
            "id": "722490318",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，他明明就在看着你嘛。",
            "nextDialogs": [
              "722490319"
            ]
          },
          "722490319": {
            "id": "722490319",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（而且眼神还相当热切的样子。）"
          }
        }
      }
    },
    {
      "subId": "7224902",
      "subQuestName": "开启残魂的试炼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722490501"
        ],
        "dialogs": {
          "722490501": {
            "id": "722490501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准备好了。",
            "nextDialogs": [
              "722490502"
            ]
          },
          "722490502": {
            "id": "722490502",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "那就祝汝……武运昌隆。"
          }
        }
      }
    },
    {
      "subId": "7224903",

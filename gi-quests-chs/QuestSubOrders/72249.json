    {
      "subId": "7224904",
      "subQuestName": "从残魂处取得供奉之物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722490201"
        ],
        "dialogs": {
          "722490201": {
            "id": "722490201",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "好、好啊！如果是汝一定能做到…",
            "nextDialogs": [
              "722490202"
            ]
          },
          "722490202": {
            "id": "722490202",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "吾委命于汝，将、将这些供奉之物…这些供奉之物…一定要…",
            "nextDialogs": [
              "722490203"
            ]
          },
          "722490203": {
            "id": "722490203",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "一定要将之取走，拿到…",
            "nextDialogs": [
              "722490204"
            ]
          },
          "722490204": {
            "id": "722490204",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "拿到…",
            "nextDialogs": [
              "722490205"
            ]
          },
          "722490205": {
            "id": "722490205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么回事？",
            "nextDialogs": [
              "722490206"
            ]
          },
          "722490206": {
            "id": "722490206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "残魂先生的声音怎么越来越模糊了。",
            "nextDialogs": [
              "722490207"
            ]
          },
          "722490207": {
            "id": "722490207",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "拿到…供奉之处…众魂归一，如此才能…",
            "nextDialogs": [
              "722490208"
            ]
          },
          "722490208": {
            "id": "722490208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "残魂先生？",
            "nextDialogs": [
              "722490209"
            ]
          },
          "722490209": {
            "id": "722490209",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "如此才能…如此才能…",
            "nextDialogs": [
              "722490210"
            ]
          },
          "722490210": {
            "id": "722490210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "如此才能什么呀？",
            "nextDialogs": [
              "722490211"
            ]
          },
          "722490211": {
            "id": "722490211",
            "speakerId": 1000,
            "speakerName": "阿倍良久",
            "text": "如此才能…",
            "nextDialogs": [
              "722490212"
            ]
          },
          "722490212": {
            "id": "722490212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，不清不楚的，不过刚才听残魂先生的意思，好像是要把这些供奉品拿到什么地方去。",
            "nextDialogs": [
              "722490213"
            ]
          },
          "722490213": {
            "id": "722490213",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这供奉品放在这里这么久，不知道里面有没有吃的…",
            "nextDialogs": [
              "722490214"
            ]
          },
          "722490214": {
            "id": "722490214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你别偷吃哦…",
            "nextDialogs": [
              "722490215"
            ]
          },
          "722490215": {
            "id": "722490215",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我、我也不是什么东西都吃的！",
            "nextDialogs": [
              "722490216"
            ]
          },
          "722490216": {
            "id": "722490216",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#好了，{NICKNAME}，收下供奉之物吧。"
          }
        }
      }
    },
    {
      "subId": "7224906",

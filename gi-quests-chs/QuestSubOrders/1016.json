    },
    {
      "subId": "101603",
      "subQuestName": "(test)在三碗不过港对话II$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10160301"
        ],
        "dialogs": {
          "10160301": {
            "id": "10160301",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "凝光…甘雨…",
            "nextDialogs": [
              "10160302"
            ]
          },
          "10160302": {
            "id": "10160302",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "暗流涌动的这些天里，她们所处的位置，究竟是在第几层呢？"
          }
        }
      }
    },
    {
      "subId": "101610",
      "subQuestName": "(test)结束对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10161001"
        ],
        "dialogs": {
          "10161001": {
            "id": "10161001",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个自称甘雨的使者，丢下这几句话，就消失了呢…",
            "nextDialogs": [
              "10161002"
            ]
          },
          "10161002": {
            "id": "10161002",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，我们居然收到了「璃月七星」的邀请函，真是不可思议。",
            "nextDialogs": [
              "10161003"
            ]
          },
          "10161003": {
            "id": "10161003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}！跟有钱人见面，一定要注意礼仪！",
            "nextDialogs": [
              "10161006"
            ]
          },
          "10161006": {
            "id": "10161006",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "呵呵…有幸受邀前往「群玉阁」作客的人，确实很少。",
            "nextDialogs": [
              "10161007"
            ]
          },
          "10161007": {
            "id": "10161007",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "你们去吧，不过别忘了「送仙典仪」的事。你们从群玉阁回来以后，我们下一步汇合的地点，是荻花洲。",
            "nextDialogs": [
              "10161008"
            ]
          },
          "10161008": {
            "id": "10161008",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，我们不会忘的。约好时间，荻花洲，不见不散！"
          }
        }
      }
    }
  ]
}
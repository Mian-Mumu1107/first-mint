    {
      "subId": "101601",
      "subQuestName": "前往三碗不过港",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "10160101"
        ],
        "dialogs": {
          "10160101": {
            "id": "10160101",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "嗯，你们来了。不必点单，我都已经点好了。",
            "nextDialogs": [
              "10160102"
            ]
          },
          "10160102": {
            "id": "10160102",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "这家「三碗不过港」，可不像蒙德的那些酒馆。在这里，酒肆主人是会拒绝果汁这种「不上道」的东西的。",
            "nextDialogs": [
              "10160103"
            ]
          },
          "10160103": {
            "id": "10160103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以这次，终于能被请一杯酒了？！",
            "nextDialogs": [
              "10160104"
            ]
          },
          "10160104": {
            "id": "10160104",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "所以这次，我给你点了一碗酒酿圆子。",
            "nextDialogs": [
              "10160105"
            ]
          },
          "10160105": {
            "id": "10160105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哈。我也不是猜不到这种结局…",
            "nextDialogs": [
              "10160106"
            ]
          },
          "10160106": {
            "id": "10160106",
            "speakerId": 2148,
            "speakerName": "田铁嘴",
            "text": "…各位客官要是愿意听，我就继续讲讲凝光大人的「群玉阁」。",
            "nextDialogs": [
              "10160107"
            ]
          },
          "10160107": {
            "id": "10160107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，这里还有说书人！氛围真好。",
            "nextDialogs": [
              "10160108"
            ]
          },
          "10160108": {
            "id": "10160108",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "所谓市井盛赞，除了酒好，当然环境也要好。",
            "nextDialogs": [
              "10160109"
            ]
          },
          "10160109": {
            "id": "10160109",
            "speakerId": 10232,
            "speakerName": "钟离",
            "text": "但这里所说的「环境」，与「提瓦特游览指南」里评判大酒楼的「环境」，就是两种意思了。",
            "nextDialogs": [
              "10160110"
            ]
          },
          "10160110": {
            "id": "10160110",
            "speakerId": 2148,
            "speakerName": "田铁嘴",
            "text": "列位都知道，在咱们这港口上边呀，有那云上仙府、烟霞行宫。",
            "nextDialogs": [
              "10160111"
            ]
          },
          "10160111": {
            "id": "10160111",
            "speakerId": 2148,
            "speakerName": "田铁嘴",
            "text": "什么叫手眼通天？您瞧瞧，这就叫手眼通天，这就是凝光大人置办下的通天产业。",
            "nextDialogs": [
              "10160112"
            ]
          },
          "10160112": {
            "id": "10160112",
            "speakerId": 2148,
            "speakerName": "田铁嘴",
            "text": "在那天朗气清之时，您从那宫门外的甲板上往下一望——",
            "nextDialogs": [
              "10160113"
            ]
          },
          "10160113": {
            "id": "10160113",
            "speakerId": 2148,
            "speakerName": "田铁嘴",
            "text": "好厉害！那就是大半个璃月港的天地风光…",
            "nextDialogs": [
              "10160201"
            ]
          },
          "10160201": {
            "id": "10160201",
            "speakerId": 2148,
            "speakerName": "田铁嘴",
            "text": "您且想想，这玩意虽是纸屑，但凝光大人用来决策的「思路」，那得多珍贵呢？",
            "nextDialogs": [
              "10160202"
            ]
          },
          "10160202": {
            "id": "10160202",
            "speakerId": 2148,
            "speakerName": "田铁嘴",
            "text": "您要能多抢一两张，这凝光大人指缝里漏出的好处，就能比同行多得一两分喽…",
            "nextDialogs": [
              "10160203"
            ]
          },
          "10160203": {
            "id": "10160203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「天权」凝光…最近一直听到这个名字。",
            "nextDialogs": [
              "10160204"
            ]
          },
          "10160204": {
            "id": "10160204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "璃月人在谈她，「愚人众」讨厌她，藏「仙祖法蜕」的好像也是她，「请仙典仪」上我们还见过她一面…",
            "nextDialogs": [
              "10160205"
            ]
          },
          "10160205": {
            "id": "10160205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不知道她究竟是个怎样的人呢？",
            "nextDialogs": [
              "10160207"
            ]
          },
          "10160207": {
            "id": "10160207",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "终于找到你了，「绝云间归来之人」。",
            "nextDialogs": [
              "10160208"
            ]
          },
          "10160208": {
            "id": "10160208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谁？！",
            "nextDialogs": [
              "10160209"
            ]
          },
          "10160209": {
            "id": "10160209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙，我们走…！",
            "nextDialogs": [
              "10160210"
            ]
          },
          "10160210": {
            "id": "10160210",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "请等一下。我不是千岩军，也不是前来缉拿你们的捕快。",
            "nextDialogs": [
              "10160211"
            ]
          },
          "10160211": {
            "id": "10160211",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "但我的确是「璃月七星」的使者——我是甘雨，月海亭的秘书，为见你们而来。",
            "nextDialogs": [
              "10160214"
            ]
          },
          "10160214": {
            "id": "10160214",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "确切地说，本职工作是对「七星」全体负责的秘书，而这次的临时身份，是凝光小姐的特别使者。",
            "nextDialogs": [
              "10160215"
            ]
          },
          "10160215": {
            "id": "10160215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，说凝光，凝光…的使者到。",
            "nextDialogs": [
              "10160216"
            ]
          },
          "10160216": {
            "id": "10160216",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "绝云间归来之人…恕我身处坊间，礼数不周。",
            "nextDialogs": [
              "10160217"
            ]
          },
          "10160217": {
            "id": "10160217",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "但我带来的这封信，是凝光小姐以「天权」身份，正式拟定的邀请函。",
            "nextDialogs": [
              "10160218"
            ]
          },
          "10160218": {
            "id": "10160218",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "邀请您前往那座「天上的宫殿」。",
            "nextDialogs": [
              "10160219"
            ]
          },
          "10160219": {
            "id": "10160219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你说…邀请函？",
            "nextDialogs": [
              "10160220"
            ]
          },
          "10160220": {
            "id": "10160220",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "是的。凝光小姐是这样说的：",
            "nextDialogs": [
              "10160221"
            ]
          },
          "10160221": {
            "id": "10160221",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "#「请{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}来。」",
            "nextDialogs": [
              "10160222"
            ]
          },
          "10160222": {
            "id": "10160222",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "#「我要见{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}。」",
            "nextDialogs": [
              "10160223"
            ]
          },
          "10160223": {
            "id": "10160223",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "#「在群玉阁，我会陪{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}一根一根地…剪断繁杂的暗流之线。」"
          }
        }
      }
    },

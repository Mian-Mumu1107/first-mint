        "dialogs": {
          "220359901": {
            "id": "220359901",
            "speakerId": 10422,
            "speakerName": "盗宝团",
            "text": "怎么又是你们！我还什么都没干呢！",
            "nextDialogs": [
              "220359902"
            ]
          },
          "220359902": {
            "id": "220359902",
            "speakerId": 3042,
            "speakerName": "龙二",
            "text": "抱歉了，社长说这也算是…预防犯罪、旅行者，我们上吧。",
            "nextDialogs": [
              "220359903"
            ]
          },
          "220359903": {
            "id": "220359903",
            "speakerId": 10422,
            "speakerName": "盗宝团",
            "text": "搞、搞什么？！等一下，给我好好听人说话啊！"
          }
        }
      }

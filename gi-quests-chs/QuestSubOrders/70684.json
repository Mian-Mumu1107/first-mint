            "speakerName": "莎莎",
            "text": "请收下这本曲谱集吧。",
            "nextDialogs": [
              "706840202"
            ]
          },
          "706840202": {
            "id": "706840202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（收下曲谱集。）",
            "nextDialogs": [
              "706840203"
            ]
          },
          "706840203": {
            "id": "706840203",
            "speakerId": 1000,
            "speakerName": "莎莎",
            "text": "想要试用不同乐器随时来找我。"
          }

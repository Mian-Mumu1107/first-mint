  "subQuests": [
    {
      "subId": "7068401",
      "subQuestName": "与莎莎交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "706840101"
        ],
        "dialogs": {
          "706840101": {
            "id": "706840101",
            "speakerId": 1000,
            "speakerName": "莎莎",
            "text": "大、大家好！我、我…我是正在努力成为吟游诗人的莎莎。非、非常感谢大家来看我的演出，那么现在我要…我要开始演奏了。",
            "nextDialogs": [
              "706840102"
            ]
          },
          "706840102": {
            "id": "706840102",
            "speakerId": 1000,
            "speakerName": "莎莎",
            "text": "「在摘星崖的山顶，一切皆已沉静。在一切树梢之顶…」一切…不，不对。",
            "nextDialogs": [
              "706840103"
            ]
          },
          "706840103": {
            "id": "706840103",
            "speakerId": 1000,
            "speakerName": "莎莎",
            "text": "「在一切树梢之顶，不闻群风。也不见，不见小鸟的身影…」记得接下来应该是…勿…「勿要匆匆前行…」",
            "nextDialogs": [
              "706840104"
            ]
          },
          "706840104": {
            "id": "706840104",
            "speakerId": 1000,
            "speakerName": "莎莎",
            "text": "真是不好意思，这次发挥得不太好…明明第四十二次和第九十次都没有口吃，可以流畅地念出来的，到底是哪里不对呢？",
            "nextDialogs": [
              "706840105"
            ]
          },
          "706840105": {
            "id": "706840105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "第四十二次和第九十次…？",
            "nextDialogs": [
              "706840106"
            ]
          },
          "706840106": {
            "id": "706840106",
            "speakerId": 1000,
            "speakerName": "莎莎",
            "text": "嗯！为了给大家带来最完美的演出，这首曲子我已经练习过一百次了，刚才是第一百零一次，也是第一次正式演出…",
            "nextDialogs": [
              "706840107"
            ]
          },
          "706840107": {
            "id": "706840107",
            "speakerId": 1000,
            "speakerName": "莎莎",
            "text": "唉，本以为这次能成功，结果还是搞砸了，是准备得还不够吧…得对比一下第四十二次和第九十次的情况，加大练习量才行…",
            "nextDialogs": [
              "706840110"
            ]
          },
          "706840110": {
            "id": "706840110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对、对呀！你都练习过那么多次了，按理说不应该是刚才那样的表现…唔，说不定是练习的方法出了问题！",
            "nextDialogs": [
              "706840111"
            ]
          },
          "706840111": {
            "id": "706840111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#说起来{NICKNAME}也懂演奏，不如你先讲讲你的练习方法，说不定{NICKNAME}能给你一些建议呢。"
          }
        }
      }
    },
    {
      "subId": "7068402",

{
  "lineCounts": {
    "七七": 5,
    "派蒙": 4,
    "瑶瑶": 11
  },
  "subQuests": [
    {
      "subId": "4022101",
      "subQuestName": "与瑶瑶和七七对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402280701"
        ],
        "dialogs": {
          "402280701": {
            "id": "402280701",
            "speakerId": 1066,
            "speakerName": "瑶瑶",
            "text": "七七，不能只喝饮料哦，还记得每天要喝多少杯水吗？",
            "nextDialogs": [
              "402280702"
            ]
          },
          "402280702": {
            "id": "402280702",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "…一二七七，二二七七，不记得了…",
            "nextDialogs": [
              "402280703"
            ]
          },
          "402280703": {
            "id": "402280703",
            "speakerId": 1066,
            "speakerName": "瑶瑶",
            "text": "没关系，我来当你的喝水提示小助手吧。现在是喝水时间，记得补水哦。",
            "nextDialogs": [
              "402280704"
            ]
          },
          "402280704": {
            "id": "402280704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘻嘻，瑶瑶真贴心呀。",
            "nextDialogs": [
              "402280705"
            ]
          },
          "402280705": {
            "id": "402280705",
            "speakerId": 1066,
            "speakerName": "瑶瑶",
            "text": "#{NICKNAME}，派蒙，来的正好，你们喜欢什么口味的零食？甜的咸的？我看看…",
            "nextDialogs": [
              "402280706"
            ]
          },
          "402280706": {
            "id": "402280706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我背包里也有不少零食，你们也挑挑！",
            "nextDialogs": [
              "402280707"
            ]
          },
          "402280707": {
            "id": "402280707",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "零食要分享，玩具也要分享。给。",
            "nextDialogs": [
              "402280708"
            ]
          },
          "402280708": {
            "id": "402280708",
            "speakerId": 1066,
            "speakerName": "瑶瑶",
            "text": "噢，这是留云阿姨给我们做的游乐机关，内置了一个有趣的仙术。",
            "nextDialogs": [
              "402280709"
            ]
          },
          "402280709": {
            "id": "402280709",
            "speakerId": 1066,
            "speakerName": "瑶瑶",
            "text": "她从师父口中得知我们要来稻妻后，千叮万嘱，要注意安全。",
            "nextDialogs": [
              "402280710"
            ]
          },
          "402280710": {
            "id": "402280710",
            "speakerId": 1066,
            "speakerName": "瑶瑶",
            "text": "怕我们没记在心上，还特意做了一个游乐机关，她说最有效的教育就是寓教于乐。",
            "nextDialogs": [
              "402280711"
            ]
          },
          "402280711": {
            "id": "402280711",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "天黑前要回家，团团月桂一起走，七七瑶瑶手牵手。",
            "nextDialogs": [
              "402280712"
            ]
          },
          "402280712": {
            "id": "402280712",
            "speakerId": 1066,
            "speakerName": "瑶瑶",
            "text": "就是这样！了不起呀七七，你都记住啦。",
            "nextDialogs": [
              "402280713"
            ]
          },
          "402280713": {
            "id": "402280713",
            "speakerId": 1066,
            "speakerName": "瑶瑶",
            "text": "留云阿姨的仙术真厉害，我们的幻想朋友能在她造的秘境里自由玩耍，我还第一次见到七七的幻想朋友呢！",
            "nextDialogs": [
              "402280714"
            ]
          },
          "402280714": {
            "id": "402280714",
            "speakerId": 1066,
            "speakerName": "瑶瑶",
            "text": "是一只跟七七一样可爱的团雀！叫团团。",
            "nextDialogs": [
              "402280715"
            ]
          },
          "402280715": {
            "id": "402280715",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我好像明白七七为什么这么喜欢团雀了。",
            "nextDialogs": [
              "402280716"
            ]
          },
          "402280716": {
            "id": "402280716",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "月桂，跟机关月桂一样，但又不一样…",
            "nextDialogs": [
              "402280717"
            ]
          },
          "402280717": {
            "id": "402280717",
            "speakerId": 1066,
            "speakerName": "瑶瑶",
            "text": "当年留云阿姨送了我月桂后，久而久之，月桂也成了我的幻想朋友，到现在为止，月桂和我都成长了不少哦！",
            "nextDialogs": [
              "402280718"
            ]
          },
          "402280718": {
            "id": "402280718",
            "speakerId": 10233,
            "speakerName": "七七",
            "text": "团团也变胖了，但能飞更高了。",
            "nextDialogs": [
              "402280719"
            ]
          },
          "402280719": {
            "id": "402280719",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真好呀，不管是幻想的朋友还是现实的朋友，都在彼此的陪伴中成长呢。",
            "nextDialogs": [
              "402280720"
            ]
          },
          "402280720": {
            "id": "402280720",
            "speakerId": 1066,
            "speakerName": "瑶瑶",
            "text": "哎呀，顾着聊天，差点忘了正事，茶点很快就备好。你们可以先玩一玩这个机关解解闷哦。"
          }
        }
      }
    }
  ]
}
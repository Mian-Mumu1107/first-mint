    {
      "subId": "602802",
      "subQuestName": "踏上回月亮的路",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60280201"
        ],
        "dialogs": {
          "60280201": {
            "id": "60280201",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "这里就是…亥珀波瑞亚时期，人们与「月亮」沟通的地方…",
            "nextDialogs": [
              "60280202"
            ]
          },
          "60280202": {
            "id": "60280202",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "恒月、霜月、虹月…当三个月亮的力量汇聚时…",
            "nextDialogs": [
              "60280203"
            ]
          },
          "60280203": {
            "id": "60280203",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "通往月亮的门就会打开。",
            "nextDialogs": [
              "60280204"
            ]
          },
          "60280204": {
            "id": "60280204",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "嗯…",
            "nextDialogs": [
              "60280205"
            ]
          },
          "60280205": {
            "id": "60280205",
            "speakerId": 1080,
            "speakerName": "「仆人」",
            "text": "月髓已经准备就绪，只差最后一步了。",
            "nextDialogs": [
              "60280206"
            ]
          },
          "60280206": {
            "id": "60280206",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "现在的那夏镇，应该是最热闹的时候吧。",
            "nextDialogs": [
              "60280207"
            ]
          },
          "60280207": {
            "id": "60280207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是啊，可惜我们不得不在这种时候送你回去。",
            "nextDialogs": [
              "60280208"
            ]
          },
          "60280208": {
            "id": "60280208",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "没关系的，作为最后一份，也是唯一一份行李，我很满意。",
            "nextDialogs": [
              "60280209"
            ]
          },
          "60280209": {
            "id": "60280209",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "……",
            "nextDialogs": [
              "60280210"
            ]
          },
          "60280210": {
            "id": "60280210",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "我已经感受到了，来自月亮的召唤。",
            "nextDialogs": [
              "60280211"
            ]
          },
          "60280211": {
            "id": "60280211",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "……",
            "nextDialogs": [
              "60280212"
            ]
          },
          "60280212": {
            "id": "60280212",
            "speakerId": 1080,
            "speakerName": "「仆人」",
            "text": "你的家就在这束光的彼岸，哥伦比娅。",
            "nextDialogs": [
              "60280213"
            ]
          },
          "60280213": {
            "id": "60280213",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "以后终于有对真正的月亮祈祷的理由了。",
            "nextDialogs": [
              "60280214"
            ]
          },
          "60280214": {
            "id": "60280214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "哥伦比娅。",
            "nextDialogs": [
              "60280215"
            ]
          },
          "60280215": {
            "id": "60280215",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，我听着呢。",
            "nextDialogs": [
              "60280216"
            ]
          },
          "60280216": {
            "id": "60280216",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "如果有机会，就多回来看看吧！",
            "nextDialogs": [
              "60280217"
            ]
          },
          "60280217": {
            "id": "60280217",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "哈…当然。",
            "nextDialogs": [
              "60280218"
            ]
          },
          "60280218": {
            "id": "60280218",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "如果没有…也请记得，在这个星球上有一群想念着「哥伦比娅」的朋友们。",
            "nextDialogs": [
              "60280219"
            ]
          },
          "60280219": {
            "id": "60280219",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "嗯，一定会的，谢谢你们为我做那么多。",
            "nextDialogs": [
              "60280220"
            ]
          },
          "60280220": {
            "id": "60280220",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "也请你们记得，月光永远联系着我们，不论日夜。",
            "nextDialogs": [
              "60280221"
            ]
          },
          "60280221": {
            "id": "60280221",
            "speakerId": 1318,
            "speakerName": "「少女」",
            "text": "呼…那么…再见了，我的朋友们。"
          }
        }
      }
    },

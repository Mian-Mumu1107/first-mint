        ],
        "dialogs": {
          "60280501": {
            "id": "60280501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（哥伦比娅…）",
            "nextDialogs": [
              "60280502"
            ]
          },
          "60280502": {
            "id": "60280502",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "……"
          }
        }
      }
    },
    {
      "subId": "602411",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60241102"
        ],
        "dialogs": {
          "60241102": {
            "id": "60241102",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "以前从没想过，「哥伦比娅」会成为我的真名。",
            "nextDialogs": [
              "60241104"
            ]
          },
          "60241104": {
            "id": "60241104",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "它从一个愚人众的代号，变成了「朋友们口中的我」。"
          }
        }
      }
    },
    {
      "subId": "602899",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60289902"
        ],
        "dialogs": {
          "60289902": {
            "id": "60289902",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "（月亮上…会有什么呢…）",
            "nextDialogs": [
              "60289903"
            ]
          },
          "60289903": {
            "id": "60289903",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "（真的…能给朋友们留下消息吗…）",
            "nextDialogs": [
              "60289905"
            ]
          },
          "60289905": {
            "id": "60289905",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "（下一个祈月之夜…我会在哪…）"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7713001",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771300101"
        ],
        "dialogs": {
          "771300101": {
            "id": "771300101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…果然就是那个大家伙，之前没看清楚…仔细一看，这不是一只巨大的雪精…",
            "nextDialogs": [
              "771300102"
            ]
          },
          "771300102": {
            "id": "771300102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "雪精居然也能够长得那么大。",
            "nextDialogs": [
              "771300104",
              "771300106"
            ]
          },
          "771300104": {
            "id": "771300104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "失控，呃…也就是说那些锁链是为了不让他失控才捆住他的？可是不管怎么样，被捆住也太可怜了。",
            "nextDialogs": [
              "771300107"
            ]
          },
          "771300107": {
            "id": "771300107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…唔。",
            "nextDialogs": [
              "771300108"
            ]
          },
          "771300108": {
            "id": "771300108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他是想要…想要到海上去吗？",
            "nextDialogs": [
              "771300109"
            ]
          },
          "771300109": {
            "id": "771300109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们要跟上去看看吗？",
            "nextDialogs": [
              "771300110"
            ]
          },
          "771300110": {
            "id": "771300110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有点在意…",
            "nextDialogs": [
              "771300111"
            ]
          },
          "771300111": {
            "id": "771300111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，那个大家伙看上去也没有到处破坏…真奇怪，他到底想要到什么地方去呢…"
          },
          "771300106": {
            "id": "771300106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "长这么大还是算了吧，一天要吃多少东西才能填饱肚子呀！"
          }
        }
      }
    },

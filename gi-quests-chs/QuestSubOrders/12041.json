              "120410702"
            ]
          },
          "120410702": {
            "id": "120410702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "现在怎么办？真的让影和将军在里面一直打下去吗？",
            "nextDialogs": [
              "120410703"
            ]
          },
          "120410703": {
            "id": "120410703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然她说得头头是道，只有这样才能修改将军的运行法则，可是…",
            "nextDialogs": [
              "120410706"
            ]
          },
          "120410706": {
            "id": "120410706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对吧？而且影很顽固，容易走进死胡同…",
            "nextDialogs": [
              "120410707"
            ]
          },
          "120410707": {
            "id": "120410707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "要是太执着于胜负忘记了初衷，说不定…就再也出不来了！"
          }
        }
      }
    },

    {
      "subId": "1204110",
      "subQuestName": "与影交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120410401"
        ],
        "dialogs": {
          "120410401": {
            "id": "120410401",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "终于到了，入口就在这里…",
            "nextDialogs": [
              "120410402"
            ]
          },
          "120410402": {
            "id": "120410402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "居然出现了一个鸟居？",
            "nextDialogs": [
              "120410403"
            ]
          },
          "120410403": {
            "id": "120410403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还好吧？",
            "nextDialogs": [
              "120410404"
            ]
          },
          "120410404": {
            "id": "120410404",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "感觉又恶化了…但没关系，我会尽快结束一切。",
            "nextDialogs": [
              "120410405"
            ]
          },
          "120410405": {
            "id": "120410405",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "这里是曾被我亲手封存起来的…雷电真的意识空间入口。",
            "nextDialogs": [
              "120410406"
            ]
          },
          "120410406": {
            "id": "120410406",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "看来，「她」已经不允许我胡乱使用这个身体了。",
            "nextDialogs": [
              "120410407"
            ]
          },
          "120410407": {
            "id": "120410407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？什么意思，她到底是谁啊？是在说真吗？",
            "nextDialogs": [
              "120410408"
            ]
          },
          "120410408": {
            "id": "120410408",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "跟我来。",
            "nextDialogs": [
              "120410409"
            ]
          },
          "120410409": {
            "id": "120410409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "跟到哪里去…唔，唔哇啊啊——"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "1204101",
      "subQuestName": "继续追踪痕迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120410101"
        ],
        "dialogs": {
          "120410101": {
            "id": "120410101",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "还是像刚刚一样，交给我吧。",
            "nextDialogs": [
              "120410102"
            ]
          },
          "120410102": {
            "id": "120410102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂喂，你、你确定自己没问题吗？别吓唬我们呀！",
            "nextDialogs": [
              "120410103"
            ]
          },
          "120410103": {
            "id": "120410103",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "没关系，战斗本就是我最熟悉的事。"
          }
        }
      }
    },
    {

    {
      "subId": "1204102",
      "subQuestName": "继续追踪痕迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120410201"
        ],
        "dialogs": {
          "120410201": {
            "id": "120410201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "影，要不然还是交给我们吧。",
            "nextDialogs": [
              "120410204"
            ]
          },
          "120410204": {
            "id": "120410204",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "我…",
            "nextDialogs": [
              "120410205"
            ]
          },
          "120410205": {
            "id": "120410205",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "抱歉。",
            "nextDialogs": [
              "120410206"
            ]
          },
          "120410206": {
            "id": "120410206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没关系，你先在后面休息，恢复一下体力吧！",
            "nextDialogs": [
              "120410207"
            ]
          },
          "120410207": {
            "id": "120410207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们来对付魔物！",
            "nextDialogs": [
              "120410208"
            ]
          },
          "120410208": {
            "id": "120410208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸…又是那样的光？"
          }
        }
      }
    },
    {
      "subId": "1204103",
      "subQuestName": "继续追踪痕迹",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120410301"
        ],
        "dialogs": {
          "120410301": {
            "id": "120410301",
            "speakerId": 12376,
            "speakerName": "藤木",
            "text": "它们的进攻，好像终于停止了。",
            "nextDialogs": [
              "120410302"
            ]
          },
          "120410302": {
            "id": "120410302",
            "speakerId": 12411,
            "speakerName": "深见",
            "text": "我还是第一次打这么激烈的仗呢！",
            "nextDialogs": [
              "120410303"
            ]
          },
          "120410303": {
            "id": "120410303",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "谢谢你们…",
            "nextDialogs": [
              "120410304"
            ]
          },
          "120410304": {
            "id": "120410304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？你没事了吗？要不要再休息一会儿？",
            "nextDialogs": [
              "120410305"
            ]
          },
          "120410305": {
            "id": "120410305",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "没关系，已经好些了。",
            "nextDialogs": [
              "120410306"
            ]
          },
          "120410306": {
            "id": "120410306",
            "speakerId": 12376,
            "speakerName": "藤木",
            "text": "你们身手了得，实在令人刮目相看。",
            "nextDialogs": [
              "120410307"
            ]
          },
          "120410307": {
            "id": "120410307",
            "speakerId": 12376,
            "speakerName": "藤木",
            "text": "那些魔物一定还会回来。到时候，恐怕就不只是兽境猎犬这么简单了。",
            "nextDialogs": [
              "120410308"
            ]
          },
          "120410308": {
            "id": "120410308",
            "speakerId": 12376,
            "speakerName": "藤木",
            "text": "你们尽快护送将军大人返回稻妻城，与大将率领的军队汇合。",
            "nextDialogs": [
              "120410309"
            ]
          },
          "120410309": {
            "id": "120410309",
            "speakerId": 12411,
            "speakerName": "深见",
            "text": "见到将军大人顺利归来，所有人一定会士气大振。",
            "nextDialogs": [
              "120410310"
            ]
          },
          "120410310": {
            "id": "120410310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那你们呢？",
            "nextDialogs": [
              "120410311"
            ]
          },
          "120410311": {
            "id": "120410311",
            "speakerId": 12376,
            "speakerName": "藤木",
            "text": "我们留在这里阻挡怪物，不能让它们再前进了。",
            "nextDialogs": [
              "120410312"
            ]
          },
          "120410312": {
            "id": "120410312",
            "speakerId": 12376,
            "speakerName": "藤木",
            "text": "只要兄弟们齐心协力，无论有多少魔物都不在话下。",
            "nextDialogs": [
              "120410313"
            ]
          },
          "120410313": {
            "id": "120410313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "120410316"
            ]
          },
          "120410316": {
            "id": "120410316",
            "speakerId": 12411,
            "speakerName": "深见",
            "text": "交给我们吧！战斗本就是我们最熟悉的事！",
            "nextDialogs": [
              "120410317"
            ]
          },
          "120410317": {
            "id": "120410317",
            "speakerId": 12411,
            "speakerName": "深见",
            "text": "但将军大人是特别的，只有将军大人才能逆转这绝望的现状，带我们走向未来。",
            "nextDialogs": [
              "120410318"
            ]
          },
          "120410318": {
            "id": "120410318",
            "speakerId": 12411,
            "speakerName": "深见",
            "text": "无论稻妻面对什么样的威胁，我们都有理由永远相信将军大人！",
            "nextDialogs": [
              "120410319"
            ]
          },
          "120410319": {
            "id": "120410319",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "……",
            "nextDialogs": [
              "120410320"
            ]
          },
          "120410320": {
            "id": "120410320",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "非常感谢你们，我向你们保证，我会给稻妻一个光明的未来。",
            "nextDialogs": [
              "120410321"
            ]
          },
          "120410321": {
            "id": "120410321",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "这份承诺来得有些迟了，但至少，是从此刻开始。",
            "nextDialogs": [
              "120410322"
            ]
          },
          "120410322": {
            "id": "120410322",
            "speakerId": 12411,
            "speakerName": "深见",
            "text": "将军大人请放心，有您这句话，我们决不言败！",
            "nextDialogs": [
              "120410323"
            ]
          },
          "120410323": {
            "id": "120410323",
            "speakerId": 12411,
            "speakerName": "深见",
            "text": "我们一定能与您一起，把稻妻失去的东西全都夺回来！",
            "nextDialogs": [
              "120410324"
            ]
          },
          "120410324": {
            "id": "120410324",
            "speakerId": 12376,
            "speakerName": "藤木",
            "text": "常道恢弘，鸣神永恒！",
            "nextDialogs": [
              "120410325"
            ]
          },
          "120410325": {
            "id": "120410325",
            "speakerId": 1004,
            "speakerName": "武士们",
            "text": "常道恢弘，鸣神永恒！",
            "nextDialogs": [
              "120410326"
            ]
          },
          "120410326": {
            "id": "120410326",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们…消失了。"
          }
        }
      }
    },
    {
      "subId": "1204104",
      "subQuestName": "与影交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1204105",
      "subQuestName": "击败兽境猎犬",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120410501"
        ],
        "dialogs": {
          "120410501": {
            "id": "120410501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃啊…头好晕，被拉到什么地方来了…",
            "nextDialogs": [
              "120410502"
            ]
          },
          "120410502": {
            "id": "120410502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！这个地方…",
            "nextDialogs": [
              "120410503"
            ]
          },
          "120410503": {
            "id": "120410503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很像「一心净土」。",
            "nextDialogs": [
              "120410504"
            ]
          },
          "120410504": {
            "id": "120410504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你看，你看，那边！",
            "nextDialogs": [
              "120410505"
            ]
          },
          "120410505": {
            "id": "120410505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "有另一个影！",
            "nextDialogs": [
              "120410506"
            ]
          },
          "120410506": {
            "id": "120410506",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "又见面了，旅行者。",
            "nextDialogs": [
              "120410507"
            ]
          },
          "120410507": {
            "id": "120410507",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "此身为内在的协助者，亦是法则的守护者。",
            "nextDialogs": [
              "120410508"
            ]
          },
          "120410508": {
            "id": "120410508",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "如果内在想要背离法则，那此身…便化作修罗。",
            "nextDialogs": [
              "120410509"
            ]
          },
          "120410509": {
            "id": "120410509",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这种感觉…难道是人偶将军？！",
            "nextDialogs": [
              "120410510"
            ]
          },
          "120410510": {
            "id": "120410510",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "你以我的身躯游历世间，看似掌握了永恒的真谛。",
            "nextDialogs": [
              "120410511"
            ]
          },
          "120410511": {
            "id": "120410511",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "你认为如今的自己比过去更坚定，所以现在这个你才是正确的。是吗？",
            "nextDialogs": [
              "120410512"
            ]
          },
          "120410512": {
            "id": "120410512",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "如今的你究竟是有了新的想法，还是受到了无可抵御的「磨损」？",
            "nextDialogs": [
              "120410513"
            ]
          },
          "120410513": {
            "id": "120410513",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "我正是为回答你而来。",
            "nextDialogs": [
              "120410514"
            ]
          },
          "120410514": {
            "id": "120410514",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "我们同为武人，此时此刻的对话方式，只有「战斗」这一种吧。",
            "nextDialogs": [
              "120410515"
            ]
          },
          "120410515": {
            "id": "120410515",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，等等，气氛一下就变了！",
            "nextDialogs": [
              "120410516"
            ]
          },
          "120410516": {
            "id": "120410516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你你你…你已经没事了吗？",
            "nextDialogs": [
              "120410517"
            ]
          },
          "120410517": {
            "id": "120410517",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "先前种种不适，是将军在抗拒我继续使用她的身体。",
            "nextDialogs": [
              "120410518"
            ]
          },
          "120410518": {
            "id": "120410518",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "如她所说，一旦我有了「改变」的念头，她就会视我为敌。",
            "nextDialogs": [
              "120410519"
            ]
          },
          "120410519": {
            "id": "120410519",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "只要进入意识空间，我便可独立于她存在，不再受到干扰。",
            "nextDialogs": [
              "120410520"
            ]
          },
          "120410520": {
            "id": "120410520",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "将军虽是人偶，也有其自我意识。必要时，她会出现在这里与我对质。",
            "nextDialogs": [
              "120410523"
            ]
          },
          "120410523": {
            "id": "120410523",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…虽然影说过再困难也会去做之类的话，但谁想得到是这种自己打自己的情况啊！",
            "nextDialogs": [
              "120410524"
            ]
          },
          "120410524": {
            "id": "120410524",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "影和将军竟然要战斗…",
            "nextDialogs": [
              "120410525"
            ]
          },
          "120410525": {
            "id": "120410525",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "我为将军定下的法则…不，将军便是过去的我的理想，是「永恒」的基石，难以撼动。",
            "nextDialogs": [
              "120410526"
            ]
          },
          "120410526": {
            "id": "120410526",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "若非必要，我不会尝试改变她。",
            "nextDialogs": [
              "120410527"
            ]
          },
          "120410527": {
            "id": "120410527",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "就没有其他办法了吗？不动手也能把话说开…之类的？",
            "nextDialogs": [
              "120410528"
            ]
          },
          "120410528": {
            "id": "120410528",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "影不是给自己留退路的人。",
            "nextDialogs": [
              "120410529"
            ]
          },
          "120410529": {
            "id": "120410529",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是，她们明明都是为了稻妻…",
            "nextDialogs": [
              "120410530"
            ]
          },
          "120410530": {
            "id": "120410530",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "此身，象征无上威严，被授予统领一国之权，凝聚了「雷电将军」的一切。",
            "nextDialogs": [
              "120410531"
            ]
          },
          "120410531": {
            "id": "120410531",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "自然也继承了影前行时不断失去的痛苦，以及，想要抵达永恒的决心。",
            "nextDialogs": [
              "120410532"
            ]
          },
          "120410532": {
            "id": "120410532",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "一切都是为了对抗「磨损」。",
            "nextDialogs": [
              "120410533"
            ]
          },
          "120410533": {
            "id": "120410533",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "决心、勇气、爱慕、仇恨…都会在时间长河中变质扭曲。",
            "nextDialogs": [
              "120410534"
            ]
          },
          "120410534": {
            "id": "120410534",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "唯有「法则」永恒不变。",
            "nextDialogs": [
              "120410535"
            ]
          },
          "120410535": {
            "id": "120410535",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "这的确是我制造你之时的想法。",
            "nextDialogs": [
              "120410536"
            ]
          },
          "120410536": {
            "id": "120410536",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "也变成了我不得不跨越的高墙。",
            "nextDialogs": [
              "120410537"
            ]
          },
          "120410537": {
            "id": "120410537",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "你，要与我为敌吗？",
            "nextDialogs": [
              "120410538"
            ]
          },
          "120410538": {
            "id": "120410538",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "我是你的过去，我是万世不变的法则，我是「永恒」的守护者。",
            "nextDialogs": [
              "120410539"
            ]
          },
          "120410539": {
            "id": "120410539",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "而我是，许以臣民一梦的——「雷电影」。"
          }
        }
      }
    },

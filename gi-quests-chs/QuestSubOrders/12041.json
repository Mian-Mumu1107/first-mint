      }
    },
    {
      "subId": "1204199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120419901"
        ],
        "dialogs": {
          "120419901": {
            "id": "120419901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们走吧，继续追查痕迹。",
            "nextDialogs": [
              "120419902"
            ]
          },
          "120419902": {
            "id": "120419902",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "嗯，据我先前调查，接下来就是最后一群魔物了。",
            "nextDialogs": [
              "120419903"
            ]
          },
          "120419903": {
            "id": "120419903",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "唔…",
            "nextDialogs": [
              "120419904"
            ]
          },
          "120419904": {
            "id": "120419904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你没事吧？",
            "nextDialogs": [
              "120419905"
            ]
          },
          "120419905": {
            "id": "120419905",
            "speakerId": 12076,
            "speakerName": "影",
            "text": "我没事，我…",
            "nextDialogs": [
              "120419906"
            ]
          },
          "120419906": {
            "id": "120419906",
            "speakerId": 12411,
            "speakerName": "深见",
            "text": "保护将军大人！",
            "nextDialogs": [
              "120419907"
            ]
          },
          "120419907": {
            "id": "120419907",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "高傲凛然的鬼之少女，最终被斩断了尖牙与利爪…",
            "nextDialogs": [
              "120419908"
            ]
          },
          "120419908": {
            "id": "120419908",
            "speakerId": 1036,
            "speakerName": "雷电将军",
            "text": "纵然鲜血与污秽已被涤荡，可你的刀永远无法光亮如初。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7523317",
      "subQuestName": "观看皮皮潘偶像大赛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752331101"
        ],
        "dialogs": {
          "752331101": {
            "id": "752331101",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "虽然「希顿」在舞台上表现出色，但遗憾的是，由于与其他选手实力相差悬殊，她最终与冠军失之交臂…",
            "nextDialogs": [
              "752331102"
            ]
          },
          "752331102": {
            "id": "752331102",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "呜——又、又失败了，我连前三名都不是…",
            "nextDialogs": [
              "752331103"
            ]
          },
          "752331103": {
            "id": "752331103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "别、别灰心啦！最起码我们已经闯入了决赛啦！",
            "nextDialogs": [
              "752331104"
            ]
          },
          "752331104": {
            "id": "752331104",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "我早就说过了，偶像之路可是很残酷的，它上面闪耀的不是光芒，是汗水！你的基本功明显还不够！",
            "nextDialogs": [
              "752331105"
            ]
          },
          "752331105": {
            "id": "752331105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这、这个声音是…？",
            "nextDialogs": [
              "752331106"
            ]
          },
          "752331106": {
            "id": "752331106",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "我、我…",
            "nextDialogs": [
              "752331107"
            ]
          },
          "752331107": {
            "id": "752331107",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "不过，能走出第一步就是巨大的进步了。更何况你还坚持了两个回合，比我预想中的多多了。",
            "nextDialogs": [
              "752331108"
            ]
          },
          "752331108": {
            "id": "752331108",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "老爹…",
            "nextDialogs": [
              "752331109"
            ]
          },
          "752331109": {
            "id": "752331109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等一下，原来他就是你的老爹吗？",
            "nextDialogs": [
              "752331110"
            ]
          },
          "752331110": {
            "id": "752331110",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "哼，只不过有一点点进步而已，不代表你可以骄傲自满了！你的基本功太差了，不然也不会输得这么难看。",
            "nextDialogs": [
              "752331111"
            ]
          },
          "752331111": {
            "id": "752331111",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "现在就跟我回家，我要从零开始锻炼你！还有，现在我是你的老师，你该叫我大师才对！",
            "nextDialogs": [
              "752331112"
            ]
          },
          "752331112": {
            "id": "752331112",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "大师！",
            "nextDialogs": [
              "752331113"
            ]
          },
          "752331113": {
            "id": "752331113",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "嗯，做好心理准备，战争可不会给你跪地求饶的机会！",
            "nextDialogs": [
              "752331114"
            ]
          },
          "752331114": {
            "id": "752331114",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "好的，大师！",
            "nextDialogs": [
              "752331115"
            ]
          },
          "752331115": {
            "id": "752331115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以，在你们的眼中，偶像到底是什么东西啊喂！"
          }
        }
      }
    },

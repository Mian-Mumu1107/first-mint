    {
      "subId": "7523312",
      "subQuestName": "接受奥胡帝亚的考验",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752330501"
        ],
        "dialogs": {
          "752330501": {
            "id": "752330501",
            "speakerId": 1007,
            "speakerName": "看起来很魁梧的人",
            "text": "喂！合、合影的出场费结一下！一、一个人十万，一共三十万！",
            "nextDialogs": [
              "752330502"
            ]
          },
          "752330502": {
            "id": "752330502",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "哦？现在为难粉丝的人出场了，作为偶像又该如何应对这场危机呢？让我们拭目以待吧！",
            "nextDialogs": [
              "752330503"
            ]
          },
          "752330503": {
            "id": "752330503",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "欸、欸？这也是偶像的工作的一部分吗？",
            "nextDialogs": [
              "752330504"
            ]
          },
          "752330504": {
            "id": "752330504",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "如此，方才能被称为纳塔偶像啊！",
            "nextDialogs": [
              "752330505"
            ]
          },
          "752330505": {
            "id": "752330505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不要什么事情都用这句话接啊！",
            "nextDialogs": [
              "752330506"
            ]
          },
          "752330506": {
            "id": "752330506",
            "speakerId": 1007,
            "speakerName": "看起来很魁梧的人",
            "text": "少、少啰嗦！你们要不然破财，要不然破相，选一个吧！"
          }
        }
      }
    },
    {
      "subId": "7523304",
      "subQuestName": "接受奥胡帝亚的考验",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7523305",
      "subQuestName": "接受奥胡帝亚的考验",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752330601"
        ],
        "dialogs": {
          "752330601": {
            "id": "752330601",
            "speakerId": 1007,
            "speakerName": "看起来很魁梧的人",
            "text": "啊！疼疼疼！别打了别打了！都说是演戏了，怎么真的下狠手啊！",
            "nextDialogs": [
              "752330602"
            ]
          },
          "752330602": {
            "id": "752330602",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "不、不好意思，你们演得太逼真了…",
            "nextDialogs": [
              "752330603"
            ]
          },
          "752330603": {
            "id": "752330603",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "…咳，做得好！你合格了！真正的偶像就是要全力以赴，只要永远全力以赴，又何愁服务态度不行？",
            "nextDialogs": [
              "752330604"
            ]
          },
          "752330604": {
            "id": "752330604",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "我很感动，皮皮潘偶像就是应该是你这个样子的！",
            "nextDialogs": [
              "752330605"
            ]
          },
          "752330605": {
            "id": "752330605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我已经有点搞不懂皮皮潘偶像到底是什么了…",
            "nextDialogs": [
              "752330606"
            ]
          },
          "752330606": {
            "id": "752330606",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "好！接下来只需要为演员们赔付足够的医药费，就可以获得我的证明！",
            "nextDialogs": [
              "752330607"
            ]
          },
          "752330607": {
            "id": "752330607",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "我也不讹你们，一个人十万，一共三十万！",
            "nextDialogs": [
              "752330608"
            ]
          },
          "752330608": {
            "id": "752330608",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你们果然还是来骗钱的吧！",
            "nextDialogs": [
              "752330609"
            ]
          },
          "752330609": {
            "id": "752330609",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "如此，方才能被称为…",
            "nextDialogs": [
              "752330610"
            ]
          },
          "752330610": {
            "id": "752330610",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "偶像才不是这样的啦！",
            "nextDialogs": [
              "752330611"
            ]
          },
          "752330611": {
            "id": "752330611",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "经过一番漫长的唇枪舌剑，奥胡帝亚终于心甘情愿地自掏腰包，为演员们支付了医药费，并将证明交给了我们。"
          }
        }
      }
    },
    {
      "subId": "7523306",
      "subQuestName": "接受约娜的考验",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7523307",
      "subQuestName": "接受约娜的考验",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752330701"
        ],
        "dialogs": {
          "752330701": {
            "id": "752330701",
            "speakerId": 1009,
            "speakerName": "约娜",
            "text": "欢迎光临！哦，你们是来咨询皮皮潘偶像大赛的吧。",
            "nextDialogs": [
              "752330702"
            ]
          },
          "752330702": {
            "id": "752330702",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯嗯，没错！没想到你一眼就看出来了！好厉害啊！",
            "nextDialogs": [
              "752330703"
            ]
          },
          "752330703": {
            "id": "752330703",
            "speakerId": 1009,
            "speakerName": "约娜",
            "text": "呵呵，谬赞了，作为非全日制批评家，这点眼力我还是有的。那么，我们就直接说结论吧！",
            "nextDialogs": [
              "752330704"
            ]
          },
          "752330704": {
            "id": "752330704",
            "speakerId": 1009,
            "speakerName": "约娜",
            "text": "金色冒险家形象分，九分！白色小精灵形象分，九分！至于皮皮潘——不及格！",
            "nextDialogs": [
              "752330705"
            ]
          },
          "752330705": {
            "id": "752330705",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "——呜…",
            "nextDialogs": [
              "752330706"
            ]
          },
          "752330706": {
            "id": "752330706",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「希顿」！你还好吗？上来就这么说，你也太过分了，就算是批评家也不能这么批评人吧！",
            "nextDialogs": [
              "752330707"
            ]
          },
          "752330707": {
            "id": "752330707",
            "speakerId": 1009,
            "speakerName": "约娜",
            "text": "好的偶像就必须做好形象管理！通过使用配饰增强观众印象，是形象管理重要的组成部分！",
            "nextDialogs": [
              "752330708"
            ]
          },
          "752330708": {
            "id": "752330708",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没、没听懂…",
            "nextDialogs": [
              "752330709"
            ]
          },
          "752330709": {
            "id": "752330709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就比如，温迪的琴…",
            "nextDialogs": [
              "752330711"
            ]
          },
          "752330711": {
            "id": "752330711",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦！我听明白了！原来是这样，约娜小姐不愧是批评家呢！感觉很专业的样子。",
            "nextDialogs": [
              "752330712"
            ]
          },
          "752330712": {
            "id": "752330712",
            "speakerId": 1009,
            "speakerName": "约娜",
            "text": "对对对！果然嘛，我就说应该不是我的问题，我还是很专业的，是这里的人太奇怪了，",
            "nextDialogs": [
              "752330713"
            ]
          },
          "752330713": {
            "id": "752330713",
            "speakerId": 1009,
            "speakerName": "约娜",
            "text": "为什么说起配饰首先考虑的是战斗属性啊！「装饰」就不应该「实用」吧！",
            "nextDialogs": [
              "752330714"
            ]
          },
          "752330714": {
            "id": "752330714",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "可、可是，老爹说，太复杂的配饰会影响动作，无论是跳舞还是战斗都会不方便的，况且外观要有个性才行…",
            "nextDialogs": [
              "752330715"
            ]
          },
          "752330715": {
            "id": "752330715",
            "speakerId": 1009,
            "speakerName": "约娜",
            "text": "啊，我算是明白，为什么你的演出服会这么丑了…果然都是这里的大人们的错！嗯，让我想想…",
            "nextDialogs": [
              "752330716"
            ]
          },
          "752330716": {
            "id": "752330716",
            "speakerId": 1009,
            "speakerName": "约娜",
            "text": "金发的冒险家…看上去你的审美比较正常，不然就用我这里的装饰，向这位皮皮潘展示一下何谓真正的「搭配」吧！"
          }
        }
      }
    },
    {
      "subId": "7523308",
      "subQuestName": "接受约娜的考验",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752330801"
        ],
        "dialogs": {
          "752330801": {
            "id": "752330801",
            "speakerId": 1009,
            "speakerName": "约娜",
            "text": "嗯，很不错！这位正在见习的演员同学，说说你的感想吧？",
            "nextDialogs": [
              "752330802"
            ]
          },
          "752330802": {
            "id": "752330802",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "好、好棒！度假村的那套真的有悠悠度假村的感觉！海洋的那套，也真的很有海洋的感觉！",
            "nextDialogs": [
              "752330803"
            ]
          },
          "752330803": {
            "id": "752330803",
            "speakerId": 1009,
            "speakerName": "约娜",
            "text": "你这感想还真挺直白的…总而言之，就是根据主题联想关键词，比如度假可能联想到休闲，海滩则会联想到炎热，明白了吗？",
            "nextDialogs": [
              "752330804"
            ]
          },
          "752330804": {
            "id": "752330804",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "完全明白了！",
            "nextDialogs": [
              "752330805"
            ]
          },
          "752330805": {
            "id": "752330805",
            "speakerId": 1009,
            "speakerName": "约娜",
            "text": "别急，先实践一下看看结果…这次就尝试一个常见的关键词吧，唔，「简约」如何？",
            "nextDialogs": [
              "752330806"
            ]
          },
          "752330806": {
            "id": "752330806",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "「简约」，嗯就是简单的意思吧？说到简单…",
            "nextDialogs": [
              "752330807"
            ]
          },
          "752330807": {
            "id": "752330807",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦？「希顿」的目光锐利起来了！",
            "nextDialogs": [
              "752330808"
            ]
          },
          "752330808": {
            "id": "752330808",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "我明白了！简约就是简单，简单的极致就是无！就是抛弃一切不必要的要素！",
            "nextDialogs": [
              "752330809"
            ]
          },
          "752330809": {
            "id": "752330809",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#糟糕，{NICKNAME}，我有些不好的预感…",
            "nextDialogs": [
              "752330810"
            ]
          },
          "752330810": {
            "id": "752330810",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "喝哈！",
            "nextDialogs": [
              "752330811"
            ]
          },
          "752330811": {
            "id": "752330811",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我就知道！",
            "nextDialogs": [
              "752330812"
            ]
          },
          "752330812": {
            "id": "752330812",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "怎么样，怎么样？老师，果然，没有任何配饰就是对演出服最好的装饰！",
            "nextDialogs": [
              "752330813"
            ]
          },
          "752330813": {
            "id": "752330813",
            "speakerId": 1009,
            "speakerName": "约娜",
            "text": "我…嗯…你…啊，那个…算了，或许皮皮潘演员都是这样的吧…",
            "nextDialogs": [
              "752330814"
            ]
          },
          "752330814": {
            "id": "752330814",
            "speakerId": 1009,
            "speakerName": "约娜",
            "text": "说不定有问题的真的是我，我放弃了，你、你合格了…",
            "nextDialogs": [
              "752330815"
            ]
          },
          "752330815": {
            "id": "752330815",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我、我好像可以理解你的感受…"
          }
        }
      }
    },
    {
      "subId": "7523313",
      "subQuestName": "观看皮皮潘偶像大赛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752330901"
        ],
        "dialogs": {
          "752330901": {
            "id": "752330901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总、总而言之，我们现在终于拿到决赛的资格了！",
            "nextDialogs": [
              "752330902"
            ]
          },
          "752330902": {
            "id": "752330902",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "决、决赛，我真的可以吗…",
            "nextDialogs": [
              "752330903"
            ]
          },
          "752330903": {
            "id": "752330903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "肯、肯定没问题的！你看，之前的要求我们不是轻轻松松就达成了吗？",
            "nextDialogs": [
              "752330904"
            ]
          },
          "752330904": {
            "id": "752330904",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#而且经历了这么多，你肯定比以前更优秀了，一定能成为合格的皮皮潘偶像的。你说对不对，{NICKNAME}？",
            "nextDialogs": [
              "752330908",
              "752330907"
            ]
          },
          "752330908": {
            "id": "752330908",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "嗯！那、那我们现在就出发吧！"
          },
          "752330907": {
            "id": "752330907",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀，你也对她有信心一些啦！"
          }
        }
      }
    },

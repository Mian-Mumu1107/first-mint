  "subQuests": [
    {
      "subId": "7523301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752330101"
        ],
        "dialogs": {
          "752330101": {
            "id": "752330101",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "「承、承载绽放刺梨的奇迹，用圣火点燃你的笑容！」",
            "nextDialogs": [
              "752330102"
            ]
          },
          "752330102": {
            "id": "752330102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜、呜哇！怪物啊！",
            "nextDialogs": [
              "752330103"
            ]
          },
          "752330103": {
            "id": "752330103",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "「以悠悠度假村之名，为你献上欢迎的舞蹈，闪耀吧！皮皮潘偶像！」",
            "nextDialogs": [
              "752330104"
            ]
          },
          "752330104": {
            "id": "752330104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#要、要打过来了！{NICKNAME}，救、救命啊！",
            "nextDialogs": [
              "752330105"
            ]
          },
          "752330105": {
            "id": "752330105",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "啊——！",
            "nextDialogs": [
              "752330106"
            ]
          },
          "752330106": {
            "id": "752330106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦，它怎么自己摔倒了…喂，怪怪的家伙，你、还好吗…有、有没有摔到哪里啊…",
            "nextDialogs": [
              "752330107"
            ]
          },
          "752330107": {
            "id": "752330107",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "又、又失败了，我果然还是跳不好这个舞，好羞耻…啊——好想原地消失…",
            "nextDialogs": [
              "752330108"
            ]
          },
          "752330108": {
            "id": "752330108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那个…原、原来你刚才是在跳舞吗？要不你再跳一次试试？这次说不定会有好结果呢！",
            "nextDialogs": [
              "752330109"
            ]
          },
          "752330109": {
            "id": "752330109",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "不行不行不行，我不行的，我做不到啊…果然，我还是没有办法成为皮皮潘偶像…",
            "nextDialogs": [
              "752330110"
            ]
          },
          "752330110": {
            "id": "752330110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "完了，我现在完全搞不懂它在说什么了…欸？等一下，这个是什么？",
            "nextDialogs": [
              "752330111"
            ]
          },
          "752330111": {
            "id": "752330111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔——《皮皮潘偶像大赛宣传册》？原来皮皮潘偶像是这个意思啊！",
            "nextDialogs": [
              "752330112"
            ]
          },
          "752330112": {
            "id": "752330112",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "那、那个…",
            "nextDialogs": [
              "752330113"
            ]
          },
          "752330113": {
            "id": "752330113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦！我明白了，你应该是对比赛没有自信，所以想要找我们给一些建议对不对？",
            "nextDialogs": [
              "752330114"
            ]
          },
          "752330114": {
            "id": "752330114",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "…我、我不行的，我就连在你们面前跳舞都做不好，而、而且老爹他也说我不行…",
            "nextDialogs": [
              "752330115"
            ]
          },
          "752330115": {
            "id": "752330115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "老爹？",
            "nextDialogs": [
              "752330116"
            ]
          },
          "752330116": {
            "id": "752330116",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "嗯，我的老爹也是演员，也是我的偶像！",
            "nextDialogs": [
              "752330117"
            ]
          },
          "752330117": {
            "id": "752330117",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "老爹他跳舞可厉害了！还教出了特别多的优秀演员！只不过…他不愿意教我…",
            "nextDialogs": [
              "752330118"
            ]
          },
          "752330118": {
            "id": "752330118",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊？为什么啊？",
            "nextDialogs": [
              "752330119"
            ]
          },
          "752330119": {
            "id": "752330119",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "他、他说——「『希顿』我在你的身上根本没有看到决心！没有决心的人是没办法跳好舞蹈的！」",
            "nextDialogs": [
              "752330120"
            ]
          },
          "752330120": {
            "id": "752330120",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "为了让老爹承认我，我跟他打了赌，如果我成为了皮皮潘偶像，证明了自己，他就会对我倾囊相授…",
            "nextDialogs": [
              "752330121"
            ]
          },
          "752330121": {
            "id": "752330121",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "可、可是，我不仅连欢迎的舞蹈都跳不好，还出了个大丑，呜呜…",
            "nextDialogs": [
              "752330122"
            ]
          },
          "752330122": {
            "id": "752330122",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#别、别哭啦，你看，你不是遇到我们了吗？我和{NICKNAME}可是知名冒险家，走南闯北见得多了。",
            "nextDialogs": [
              "752330123"
            ]
          },
          "752330123": {
            "id": "752330123",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有我们的帮助，你肯定可以成为皮皮潘偶像，在老爹面前证明自己啦！",
            "nextDialogs": [
              "752330124"
            ]
          },
          "752330124": {
            "id": "752330124",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "真、真的吗？",
            "nextDialogs": [
              "752330129",
              "752330127"
            ]
          },
          "752330129": {
            "id": "752330129",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好啦，打起精神来！是时候出发去获取参赛资格啦！放心，有我们在，一定会让你的老爹对你刮目相看的！",
            "nextDialogs": [
              "752330130"
            ]
          },
          "752330130": {
            "id": "752330130",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "谢、谢谢你们！"
          },
          "752330127": {
            "id": "752330127",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "求、求求你，不要再说这句台词了！",
            "nextDialogs": [
              "752330128"
            ]
          },
          "752330128": {
            "id": "752330128",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不要再打击她了啊！"
          }
        }
      }
    },
    {
      "subId": "7523309",
      "subQuestName": "接受「坎帕」的考验",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752330201"
        ],
        "dialogs": {
          "752330201": {
            "id": "752330201",
            "speakerId": 1003,
            "speakerName": "练习中的演员",
            "text": "「承载绽放刺梨的奇迹，用圣火点燃你的笑容！」",
            "nextDialogs": [
              "752330202"
            ]
          },
          "752330202": {
            "id": "752330202",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "说了多少次了，喊口号的时候声音要洪亮！是点燃笑容！要有热情懂么！",
            "nextDialogs": [
              "752330203"
            ]
          },
          "752330203": {
            "id": "752330203",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "保持住这个姿势，收紧你的腰腹，别把腿放下来！",
            "nextDialogs": [
              "752330204"
            ]
          },
          "752330204": {
            "id": "752330204",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "那、那个，老、老…",
            "nextDialogs": [
              "752330205"
            ]
          },
          "752330205": {
            "id": "752330205",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "哦？竟然是你？好！给我站到舞台上面去！现在就去！",
            "nextDialogs": [
              "752330206"
            ]
          },
          "752330206": {
            "id": "752330206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇！好、好凶的人，「希顿」真的没问题吗？",
            "nextDialogs": [
              "752330207"
            ]
          },
          "752330207": {
            "id": "752330207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "先静观其变。",
            "nextDialogs": [
              "752330208"
            ]
          },
          "752330208": {
            "id": "752330208",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "告诉我，偶像最重要的是什么？对！是肌肉！",
            "nextDialogs": [
              "752330209"
            ]
          },
          "752330209": {
            "id": "752330209",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "只有强健的肌肉才能跳好舞蹈，只有强健的肌肉才能打败所有的竞争对手！",
            "nextDialogs": [
              "752330210"
            ]
          },
          "752330210": {
            "id": "752330210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这、这是哪里的偶像啊！",
            "nextDialogs": [
              "752330211"
            ]
          },
          "752330211": {
            "id": "752330211",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "记好了，偶像即战争，只有强者才能生存。偶像之路可是很残酷的…",
            "nextDialogs": [
              "752330212"
            ]
          },
          "752330212": {
            "id": "752330212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，不是也有那种，用温柔的笑容治愈大家的偶像…",
            "nextDialogs": [
              "752330213"
            ]
          },
          "752330213": {
            "id": "752330213",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "大错特错，那只会让喜爱偶像的人变得软弱…真正的偶像之力可是用肌肉铸就的。起舞吧！让我看看你们的偶像之力！",
            "nextDialogs": [
              "752330214"
            ]
          },
          "752330214": {
            "id": "752330214",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "我…我真的能行吗…",
            "nextDialogs": [
              "752330215"
            ]
          },
          "752330215": {
            "id": "752330215",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#没事的，你放心跳就好啦！我和{NICKNAME}，会在一旁支援你的！"
          }
        }
      }
    },
    {
      "subId": "7523310",
      "subQuestName": "接受「坎帕」的考验",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752331001"
        ],
        "dialogs": {
          "752331001": {
            "id": "752331001",
            "speakerId": 1005,
            "speakerName": "主持人",
            "text": "欢迎大家来到皮皮潘偶像大赛的决赛现场，我是本次决赛的主持人。",
            "nextDialogs": [
              "752331002"
            ]
          },
          "752331002": {
            "id": "752331002",
            "speakerId": 1005,
            "speakerName": "主持人",
            "text": "本次的决赛，想必大家都看过宣传册了，是要在舞台之上一决高下，选出最符合偶像之名的人选！",
            "nextDialogs": [
              "752331003"
            ]
          },
          "752331003": {
            "id": "752331003",
            "speakerId": 1005,
            "speakerName": "主持人",
            "text": "那么废话不多说，请各位演员们上台！展现你们的偶像之力，直至决出那位最闪耀的冠军吧！",
            "nextDialogs": [
              "752331004"
            ]
          },
          "752331004": {
            "id": "752331004",
            "speakerId": 1005,
            "speakerName": "主持人",
            "text": "闪耀吧！皮皮潘偶像！我宣布——皮皮潘偶像大赛决赛，正式开赛！",
            "nextDialogs": [
              "752331005"
            ]
          },
          "752331005": {
            "id": "752331005",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "#终、终于…呼——{NICKNAME}，派蒙，我、我要上了！",
            "nextDialogs": [
              "752331006"
            ]
          },
          "752331006": {
            "id": "752331006",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#嗯嗯，我和{NICKNAME}会在台下给你鼓劲的！加油哦！你都这么努力了，一定会有一个好结果的！"
          }
        }
      }
    },
    {
      "subId": "7523311",
      "subQuestName": "接受「坎帕」的考验",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752330301"
        ],
        "dialogs": {
          "752330301": {
            "id": "752330301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呼——还好还好，只是普通的舞蹈而已，没有出什么问题。这下想必是能安全过关了吧？",
            "nextDialogs": [
              "752330302"
            ]
          },
          "752330302": {
            "id": "752330302",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "哼，不要以为完成了规定中的舞蹈就可以了！舞台的高潮现在才刚刚开始呢！来吧！",
            "nextDialogs": [
              "752330303"
            ]
          },
          "752330303": {
            "id": "752330303",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "要、要来了吗？",
            "nextDialogs": [
              "752330304"
            ]
          },
          "752330304": {
            "id": "752330304",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "「承载绽放刺梨的奇迹，用圣火点燃你的笑容！以悠悠度假村之名，为你献上欢迎的舞蹈，闪耀吧！皮皮潘偶像！」",
            "nextDialogs": [
              "752330305"
            ]
          },
          "752330305": {
            "id": "752330305",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "糟了！这、这个动作——",
            "nextDialogs": [
              "752330306"
            ]
          },
          "752330306": {
            "id": "752330306",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "啊——！",
            "nextDialogs": [
              "752330307"
            ]
          },
          "752330307": {
            "id": "752330307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "果然，又在这个动作失败了…",
            "nextDialogs": [
              "752330308"
            ]
          },
          "752330308": {
            "id": "752330308",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "大、大师，请再给我一次机会…",
            "nextDialogs": [
              "752330309"
            ]
          },
          "752330309": {
            "id": "752330309",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "想要机会？声音再洪亮一点！你之前哭的气势去哪了？",
            "nextDialogs": [
              "752330310"
            ]
          },
          "752330310": {
            "id": "752330310",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "大、大师，请再给我一次机会！我想当皮皮潘偶像！",
            "nextDialogs": [
              "752330311"
            ]
          },
          "752330311": {
            "id": "752330311",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "……",
            "nextDialogs": [
              "752330312"
            ]
          },
          "752330312": {
            "id": "752330312",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "…好！很有气势！你合格了！",
            "nextDialogs": [
              "752330313"
            ]
          },
          "752330313": {
            "id": "752330313",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这也算合格吗？！",
            "nextDialogs": [
              "752330314"
            ]
          },
          "752330314": {
            "id": "752330314",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "当然合格！毅力比舞技重要多了！有了毅力，你就可以在一切强敌面前无所畏惧，在一切战场上都傲然屹立！",
            "nextDialogs": [
              "752330315"
            ]
          },
          "752330315": {
            "id": "752330315",
            "speakerId": 1004,
            "speakerName": "「坎帕」",
            "text": "毅力，就是偶像的精神肌肉！你已经具备了基本的偶像之力。你，过关！",
            "nextDialogs": [
              "752330316"
            ]
          },
          "752330316": {
            "id": "752330316",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "虽、虽然我有很多想说的话…但结果好，就是好吧…"
          }
        }
      }
    },
    {
      "subId": "7523302",
      "subQuestName": "接受奥胡帝亚的考验",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752330401"
        ],
        "dialogs": {
          "752330401": {
            "id": "752330401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你好！请问是奥胡帝亚吗，我们是来…",
            "nextDialogs": [
              "752330402"
            ]
          },
          "752330402": {
            "id": "752330402",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "欸呀呀！对对对，就是我。两位贵客，欢迎光临奥胡帝亚旅行社！",
            "nextDialogs": [
              "752330403"
            ]
          },
          "752330403": {
            "id": "752330403",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "您来的太是时候了，现在五天四夜悠悠度假村双人行，全程导游服务，外加全程留影和鳍游龙接送，只需十万摩拉！",
            "nextDialogs": [
              "752330404"
            ]
          },
          "752330404": {
            "id": "752330404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等一下，等一下。我们不是来咨询旅行套餐的，我们是来接受大赛参赛资格考验的。",
            "nextDialogs": [
              "752330405"
            ]
          },
          "752330405": {
            "id": "752330405",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "啧…",
            "nextDialogs": [
              "752330406"
            ]
          },
          "752330406": {
            "id": "752330406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你这态度差距也太明显了吧！",
            "nextDialogs": [
              "752330407"
            ]
          },
          "752330407": {
            "id": "752330407",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "别在意这些细节，我问你，年轻的皮皮潘，你认为作为偶像最重要的是什么？",
            "nextDialogs": [
              "752330408"
            ]
          },
          "752330408": {
            "id": "752330408",
            "speakerId": 1002,
            "speakerName": "「希顿」",
            "text": "是肌肉！",
            "nextDialogs": [
              "752330409"
            ]
          },
          "752330409": {
            "id": "752330409",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "没错！就是服务态度！只有永远对粉丝们保持高品质的服务，哪怕是面对不需要导游套餐的游客，也要拼尽全力保持笑容！",
            "nextDialogs": [
              "752330410"
            ]
          },
          "752330410": {
            "id": "752330410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…你自己最好能先做到这点啦！",
            "nextDialogs": [
              "752330411"
            ]
          },
          "752330411": {
            "id": "752330411",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "哼，这个小家伙…能指出我的问题，就说明你们对服务精神已经有所感悟了！好，那就让我来深入地考验你们吧！",
            "nextDialogs": [
              "752330412"
            ]
          },
          "752330412": {
            "id": "752330412",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好、好生硬…",
            "nextDialogs": [
              "752330413"
            ]
          },
          "752330413": {
            "id": "752330413",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "面对偶像如何服务粉丝这一问题，我们皮皮潘偶像组委会给出的答案是——合影会！",
            "nextDialogs": [
              "752330414"
            ]
          },
          "752330414": {
            "id": "752330414",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "来来来，跟我来，皮皮潘你扮演偶像，剩下的两位来扮演粉丝，就让我看看你的服务态度如何吧！"
          }
        }
      }
    },

          "752331301": {
            "id": "752331301",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "所谓偶像合影会，顾名思义，就是皮皮潘演员与客人一同合影，为客人们留下美好的回忆。",
            "nextDialogs": [
              "752331302"
            ]
          },
          "752331302": {
            "id": "752331302",
            "speakerId": 1006,
            "speakerName": "奥胡帝亚",
            "text": "你们只需要摆好姿势，然后留影就好，怎么样？很简单吧！那我们现在就开始？"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7521501",
      "subQuestName": "(test)完成玩法$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752150101"
        ],
        "dialogs": {
          "752150101": {
            "id": "752150101",
            "speakerId": 1000,
            "speakerName": "科里",
            "text": "怎么了，你也对力量训练营有兴趣吗？",
            "nextDialogs": [
              "752150102"
            ]
          },
          "752150102": {
            "id": "752150102",
            "speakerId": 1000,
            "speakerName": "科里",
            "text": "器械可以随意试用，但看你细胳膊细腿的，可别把自己弄伤了。",
            "nextDialogs": [
              "752150105"
            ]
          },
          "752150105": {
            "id": "752150105",
            "speakerId": 1000,
            "speakerName": "科里",
            "text": "真的吗？在和我吹牛之前，不如先和旁边的大方块较较劲吧。",
            "nextDialogs": [
              "752150106"
            ]
          },
          "752150106": {
            "id": "752150106",
            "speakerId": 1000,
            "speakerName": "科里",
            "text": "<color=#00E1FFFF>攻击</color>或者<color=#00E1FFFF>撞击</color>大方块，根据力量的大小就能得到不同的分数。让我看看你有多大能耐。"
          }
        }
      }
    },
    {
      "subId": "7521502",
      "subQuestName": "(test)与科里对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752150201"
        ],
        "dialogs": {
          "752150201": {
            "id": "752150201",
            "speakerId": 1000,
            "speakerName": "科里",
            "text": "不会吧，你居然把大方块撞碎了一角？",
            "nextDialogs": [
              "752150202"
            ]
          },
          "752150202": {
            "id": "752150202",
            "speakerId": 1000,
            "speakerName": "科里",
            "text": "上一位能有这种力气的人还是瓦雷莎前辈…看来你和她一样，都是天赋型选手啊！",
            "nextDialogs": [
              "752150205"
            ]
          },
          "752150205": {
            "id": "752150205",
            "speakerId": 1000,
            "speakerName": "科里",
            "text": "真是人不可貌相啊，有机会的话真想请你来当教练。",
            "nextDialogs": [
              "752150206"
            ]
          },
          "752150206": {
            "id": "752150206",
            "speakerId": 1000,
            "speakerName": "科里",
            "text": "对了，这瓶沃陆果饮据说能提升运动效果，学员们都爱喝，你也拿去尝尝吧。"
          }
        }
      }
    },
    {
      "subId": "7521503",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752150301"
        ],
        "dialogs": {
          "752150301": {
            "id": "752150301",
            "speakerId": 1000,
            "speakerName": "科里",
            "text": "招揽新人其实不难，问题在于训练一段时间之后，就有不少人找借口请假，或者干脆不来了。",
            "nextDialogs": [
              "752150302"
            ]
          },
          "752150302": {
            "id": "752150302",
            "speakerId": 1000,
            "speakerName": "科里",
            "text": "教练为了提高大家的积极性，想了很多办法，那个方块挑战就是其中一项。",
            "nextDialogs": [
              "752150303"
            ]
          },
          "752150303": {
            "id": "752150303",
            "speakerId": 1000,
            "speakerName": "科里",
            "text": "结果有些人为了提高分数，一个劲地往大方块上面撞，最后搞得鼻青脸肿的，请假的人更多了…"
          }
        }
      }
    },
    {
      "subId": "7521504",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752150401"
        ],
        "dialogs": {
          "752150401": {
            "id": "752150401",
            "speakerId": 1000,
            "speakerName": "科里",
            "text": "攻击或者撞击大方块，根据力量的大小就能得到不同的分数。还是说这就打算放弃了？"
          }
        }
      }
    },
    {
      "subId": "7521506",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752150601"
        ],
        "dialogs": {
          "752150601": {
            "id": "752150601",
            "speakerId": 1000,
            "speakerName": "科里",
            "text": "好长时间没见到这么厉害的新人了，真是令人惊叹！"
          }
        }
      }
    }
  ]

        "dialogs": {
          "711350201": {
            "id": "711350201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇啊！不知不觉间，我们已经收集到这么多仙力啦！",
            "nextDialogs": [
              "711350205",
              "711350204"
            ]
          },
          "711350205": {
            "id": "711350205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "按照浮锦之前的说法，这些仙力都用在「祀珑」上了。这样一来，翘英庄明年应该也会大丰收啦！",
            "nextDialogs": [
              "711350206"
            ]
          },
          "711350206": {
            "id": "711350206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "到了那时候，我要让罗叔给我准备好多好多好吃的！我想想，比如说茶糕，乳鸽，红烧肉圆，蜜汁叉烧，还有还有…",
            "nextDialogs": [
              "711350207"
            ]
          },
          "711350207": {
            "id": "711350207",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "茶露？",
            "nextDialogs": [
              "711350208"
            ]
          },
          "711350208": {
            "id": "711350208",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对对对，还有沉玉茶露！这个一定要记下来…欸？不对，什么人？",
            "nextDialogs": [
              "711350209"
            ]
          },
          "711350209": {
            "id": "711350209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "浮、浮锦？！",
            "nextDialogs": [
              "711350210"
            ]
          },
          "711350210": {
            "id": "711350210",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "呵呵，抱歉，吓到你们了吗？",
            "nextDialogs": [
              "711350211"
            ]
          },
          "711350211": {
            "id": "711350211",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "你已经能变回人形啦！",
            "nextDialogs": [
              "711350212"
            ]
          },
          "711350212": {
            "id": "711350212",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "是呀。咳咳，小仙我不是说过嘛，又不是受了什么严重的伤，只要稍微休养一段时间，就能恢复我最喜欢的模样啦。",
            "nextDialogs": [
              "711350213"
            ]
          },
          "711350213": {
            "id": "711350213",
            "speakerId": 1002,
            "speakerName": "浮锦",
            "text": "#谢谢你们，在我休养的这段时间，为祀珑收集了这么多的仙力。来年的丰收，{NICKNAME}和派蒙是最大的功臣呢。"
          },
          "711350204": {
            "id": "711350204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂！都过去那么久了，就别再用那种奇怪的说话方式啦！"
          }
        }

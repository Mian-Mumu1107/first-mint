  "subQuests": [
    {
      "subId": "7108901",
      "subQuestName": "隐藏获得道具$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710890101"
        ],
        "dialogs": {
          "710890101": {
            "id": "710890101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…好长的一封信，是志琼留下来的呢！",
            "nextDialogs": [
              "710890102"
            ]
          },
          "710890102": {
            "id": "710890102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没错，是志琼的信…",
            "nextDialogs": [
              "710890103"
            ]
          },
          "710890103": {
            "id": "710890103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可恶…还是找不到她人在哪里，我们先回去跟瑾武说一声吧！"
          }
        }
      }
    },
    {
      "subId": "7108902",
      "subQuestName": "隐藏与派蒙对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7108903",
      "subQuestName": "隐藏与瑾武对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710890201"
        ],
        "dialogs": {
          "710890201": {
            "id": "710890201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "瑾武姐，我们找到了这个！",
            "nextDialogs": [
              "710890202"
            ]
          },
          "710890202": {
            "id": "710890202",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "好了，好了，不要着急。你们找到了什么？和志琼的下落有关吗？",
            "nextDialogs": [
              "710890203"
            ]
          },
          "710890203": {
            "id": "710890203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是她留下的信，她去了层岩巨渊的更深处。",
            "nextDialogs": [
              "710890204"
            ]
          },
          "710890204": {
            "id": "710890204",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "…谢谢，请让我看看她写了什么。",
            "nextDialogs": [
              "710890205"
            ]
          },
          "710890205": {
            "id": "710890205",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "瑾武仔细地阅读了志琼的信。",
            "nextDialogs": [
              "710890206"
            ]
          },
          "710890206": {
            "id": "710890206",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "这个孩子…我从没有想过这么宏大的问题，也不好评价她的选择。但或许…",
            "nextDialogs": [
              "710890207"
            ]
          },
          "710890207": {
            "id": "710890207",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "或许我没能来得及重视她的发现，没能给她足够的尊重和理解吧。",
            "nextDialogs": [
              "710890208"
            ]
          },
          "710890208": {
            "id": "710890208",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "明明没有她的地图的话，后续的勘察根本难以完成…但我一直只顾着担心她的身体情况，却无视了她的努力与拼命达成的成就…",
            "nextDialogs": [
              "710890209"
            ]
          },
          "710890209": {
            "id": "710890209",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "毕竟她与我们这些矿工从一开始就是不同的，我怎么就没有想过这点呢…",
            "nextDialogs": [
              "710890210"
            ]
          },
          "710890210": {
            "id": "710890210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "她只是不想被遗忘。",
            "nextDialogs": [
              "710890211"
            ]
          },
          "710890211": {
            "id": "710890211",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "对我们这些从未被神审视的普通人来说，谁又不是呢…",
            "nextDialogs": [
              "710890212"
            ]
          },
          "710890212": {
            "id": "710890212",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "谁又不是呢…但谁像她这样执着呢？",
            "nextDialogs": [
              "710890213"
            ]
          },
          "710890213": {
            "id": "710890213",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "但一旦想到自己曾在某一刻放弃了想让自己变得伟大的执着…一旦意识到自己习惯了日复一日的平凡…",
            "nextDialogs": [
              "710890214"
            ]
          },
          "710890214": {
            "id": "710890214",
            "speakerId": 20580,
            "speakerName": "瑾武",
            "text": "也就更无颜面评判志琼这样的年轻人了…"
          }
        }
      }
    }
  ]
}
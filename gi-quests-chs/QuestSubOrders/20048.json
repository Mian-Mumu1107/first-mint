{
  "lineCounts": {
    "Player": 7,
    "提米": 25
  },
  "subQuests": [
    {
      "subId": "2004801",
      "subQuestName": "与提米对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200480101"
        ],
        "dialogs": {
          "200480101": {
            "id": "200480101",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "哇啊！又是你！鸽子又全都飞走了！",
            "nextDialogs": [
              "200480102"
            ]
          },
          "200480102": {
            "id": "200480102",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "我还在喂它们呢，你做什么啊？！",
            "nextDialogs": [
              "200480103"
            ]
          },
          "200480103": {
            "id": "200480103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "抱歉。",
            "nextDialogs": [
              "200480104"
            ]
          },
          "200480104": {
            "id": "200480104",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "妈妈说，歉意要用实际行动来表示。",
            "nextDialogs": [
              "200480105"
            ]
          },
          "200480105": {
            "id": "200480105",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "桥上的鸽子是我的好朋友，我一直在喂它们。",
            "nextDialogs": [
              "200480106"
            ]
          },
          "200480106": {
            "id": "200480106",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "但最近附近的鸭子们经常来抢食物吃，搞得它们谁也吃不饱…",
            "nextDialogs": [
              "200480107"
            ]
          },
          "200480107": {
            "id": "200480107",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "我想请你帮我找三份小麦来，帮我喂下鸭子们，我也会在桥上把鸽子们也喂饱的。",
            "nextDialogs": [
              "200480108"
            ]
          },
          "200480108": {
            "id": "200480108",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "都吃饱了之后，它们一定会友好相处吧。",
            "nextDialogs": [
              "200480111",
              "200480113"
            ]
          },
          "200480111": {
            "id": "200480111",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "那就拜托你啦。",
            "nextDialogs": [
              "200480112"
            ]
          },
          "200480112": {
            "id": "200480112",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "好好对待动物的话，你也可以和它们做朋友的。"
          },
          "200480113": {
            "id": "200480113",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "无论想不想做朋友…你都要先向它们道歉。",
            "nextDialogs": [
              "200480114"
            ]
          },
          "200480114": {
            "id": "200480114",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "所以——快点去找小麦啦！"
          }
        }
      }
    },
    {
      "subId": "2004802",
      "subQuestName": "寻找并持有三份小麦",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200480201"
        ],
        "dialogs": {
          "200480201": {
            "id": "200480201",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "你找到小麦了吗？",
            "nextDialogs": [
              "200480202"
            ]
          },
          "200480202": {
            "id": "200480202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找好了。",
            "nextDialogs": [
              "200480203"
            ]
          },
          "200480203": {
            "id": "200480203",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "这些应该就够了。",
            "nextDialogs": [
              "200480204"
            ]
          },
          "200480204": {
            "id": "200480204",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "把这些带到湖边，喂给鸭子们吧。"
          }
        }
      }
    },
    {
      "subId": "2004803",
      "subQuestName": "将小麦交给提米",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2004804",
      "subQuestName": "去湖边播撒小麦",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200480401"
        ],
        "dialogs": {
          "200480401": {
            "id": "200480401",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "你找到小麦了吗？",
            "nextDialogs": [
              "200480402"
            ]
          },
          "200480402": {
            "id": "200480402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还正在找。",
            "nextDialogs": [
              "200480403"
            ]
          },
          "200480403": {
            "id": "200480403",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "好吧，一定要在鸭子们回家之前找到啊。",
            "nextDialogs": [
              "200480404"
            ]
          },
          "200480404": {
            "id": "200480404",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "鸽子？鸽子还没来呢，没关系，它们总会来的。"
          }
        }
      }
    },
    {
      "subId": "2004805",
      "subQuestName": "与提米对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200480301"
        ],
        "dialogs": {
          "200480301": {
            "id": "200480301",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "唔，它们吃饱了以后，肯定能和平共处了吧。",
            "nextDialogs": [
              "200480302"
            ]
          },
          "200480302": {
            "id": "200480302",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "下次走过的时候，记得不要再吓到鸽子了，它们好不容易才愿意回来。",
            "nextDialogs": [
              "200480303"
            ]
          },
          "200480303": {
            "id": "200480303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "知道了…",
            "nextDialogs": [
              "200480304"
            ]
          },
          "200480304": {
            "id": "200480304",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "好啦，我原谅你了。这个给你，我最喜欢吃的蒙德土豆饼。",
            "nextDialogs": [
              "200480305"
            ]
          },
          "200480305": {
            "id": "200480305",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "要对世界保持善意啊…这是妈妈教我的。"
          }
        }
      }
    },
    {
      "subId": "2004806",
      "subQuestName": "与生气的提米对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200480601"
        ],
        "dialogs": {
          "200480601": {
            "id": "200480601",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "你都干了什么啊！我都看见了！鸭子们都…都…",
            "nextDialogs": [
              "200480602"
            ]
          },
          "200480602": {
            "id": "200480602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这也是为了鸽子们…",
            "nextDialogs": [
              "200480603"
            ]
          },
          "200480603": {
            "id": "200480603",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "走开啦！我再也不想看见你了！",
            "nextDialogs": [
              "200480604"
            ]
          },
          "200480604": {
            "id": "200480604",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "呜哇——我要回去告诉妈妈！"
          }
        }
      }
    },
    {
      "subId": "2004805",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200480501"
        ],
        "dialogs": {
          "200480501": {
            "id": "200480501",
            "speakerId": 1567,
            "speakerName": "提米",
            "text": "鸽子们怎么还不来呢…"
          }
        }
      }
    }
  ]
}
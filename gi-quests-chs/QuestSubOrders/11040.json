    {
      "subId": "1104002",
      "subQuestName": "与铺中的少女交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110400201"
        ],
        "dialogs": {
          "110400201": {
            "id": "110400201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，蒂玛乌斯先生今天好像不在…",
            "nextDialogs": [
              "110400202"
            ]
          },
          "110400202": {
            "id": "110400202",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "（是、是客人？！）",
            "nextDialogs": [
              "110400203"
            ]
          },
          "110400203": {
            "id": "110400203",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "那个！嗯…请问，你们找他有什么事吗？",
            "nextDialogs": [
              "110400204"
            ]
          },
          "110400204": {
            "id": "110400204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没什么没什么，只是平时他总是站在这里，有点奇怪而已。",
            "nextDialogs": [
              "110400205"
            ]
          },
          "110400205": {
            "id": "110400205",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "哦，这样啊。他刚刚被阿贝多先生叫走了，我是被叫来照看炼金铺的。",
            "nextDialogs": [
              "110400206"
            ]
          },
          "110400206": {
            "id": "110400206",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "我叫砂糖，是阿贝多先生的助手。炼金术方面如果有问题，也可以问我，我…会尽量帮上忙的。",
            "nextDialogs": [
              "110400208",
              "110400210"
            ]
          },
          "110400208": {
            "id": "110400208",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "我…其实我很不擅长做这种事。",
            "nextDialogs": [
              "110400211"
            ]
          },
          "110400211": {
            "id": "110400211",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "不、不好意思，平时我都在实验室里，不怎么出门，也不太经常和别人说话。",
            "nextDialogs": [
              "110400212"
            ]
          },
          "110400212": {
            "id": "110400212",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "需要我帮忙的话，就叫我的名字，如果不需要，我…我就在那边看书，嗯。",
            "nextDialogs": [
              "110400213"
            ]
          },
          "110400213": {
            "id": "110400213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嘿嘿，谢谢你的好意，不过不用担心啦，炼金台的使用已经很熟悉了，对吧，{NICKNAME}？"
          },
          "110400210": {
            "id": "110400210",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "欸？我…我看上去很紧张吗？"
          }
        }
      }
    },
    {
      "subId": "1104003",
      "subQuestName": "前往龙脊雪山的入口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110400301"
        ],
        "dialogs": {
          "110400301": {
            "id": "110400301",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "不好意思，关于阿贝多先生，我只能给出这种程度的描述。",
            "nextDialogs": [
              "110400302"
            ]
          },
          "110400302": {
            "id": "110400302",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "要是能给你们画一幅他的肖像画就好了，但是我的画技也远远不如他…"
          }
        }
      }
    },
    {
      "subId": "1104004",
      "subQuestName": "接近交谈中的两人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110400401"
        ],
        "dialogs": {
          "110400401": {
            "id": "110400401",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "原、原来你在这里，罗莎莉亚小姐，唱诗班的活动马上就…",
            "nextDialogs": [
              "110400402"
            ]
          },
          "110400402": {
            "id": "110400402",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "都说了我不参加这种活动，我还有更重要的事要做。",
            "nextDialogs": [
              "110400403"
            ]
          },
          "110400403": {
            "id": "110400403",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "可是，这次是有纪念性的活动，希望所有的修女都要出席。",
            "nextDialogs": [
              "110400404"
            ]
          },
          "110400404": {
            "id": "110400404",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "希望归希望，我的工作内容里又没有「满足别人希望」这一条。",
            "nextDialogs": [
              "110400405"
            ]
          },
          "110400405": {
            "id": "110400405",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "这、这个，话不能这么说…",
            "nextDialogs": [
              "110400406"
            ]
          },
          "110400406": {
            "id": "110400406",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "倒是你，你是这次活动的组织者吧，你不觉得很奇怪吗？",
            "nextDialogs": [
              "110400407"
            ]
          },
          "110400407": {
            "id": "110400407",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "哪、哪里奇怪了？",
            "nextDialogs": [
              "110400408"
            ]
          },
          "110400408": {
            "id": "110400408",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "按现在的时间算，就算你立刻赶回蒙德城，估计也赶不上活动开始的时间了。",
            "nextDialogs": [
              "110400409"
            ]
          },
          "110400409": {
            "id": "110400409",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "难道不是有人算好了这个，想让你出丑吗？",
            "nextDialogs": [
              "110400410"
            ]
          },
          "110400410": {
            "id": "110400410",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "欸欸？怎、怎么可能！大家不是这样的人！",
            "nextDialogs": [
              "110400411"
            ]
          },
          "110400411": {
            "id": "110400411",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "是不是这样的人，讲的是证据，而不是你的感觉。唉，还是说你太容易相信别人了呢？",
            "nextDialogs": [
              "110400412"
            ]
          },
          "110400412": {
            "id": "110400412",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "放心吧，即便你就这么回去了，也不会有人责怪你。因为估计也没有几个人觉得我真的会去参加。",
            "nextDialogs": [
              "110400413"
            ]
          },
          "110400413": {
            "id": "110400413",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "但再磨蹭下去，你就真的迟到了。",
            "nextDialogs": [
              "110400414"
            ]
          },
          "110400414": {
            "id": "110400414",
            "speakerId": 1008,
            "speakerName": "芭芭拉",
            "text": "对啊！重要的纪念活动，如果迟到了就…那、那我回去了！",
            "nextDialogs": [
              "110400415"
            ]
          },
          "110400415": {
            "id": "110400415",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听上去…这位修女好像完全是在靠诡辩骗人呢。",
            "nextDialogs": [
              "110400416"
            ]
          },
          "110400416": {
            "id": "110400416",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "从刚才起，就注意到你们了——你们是什么人，又为什么要偷听？",
            "nextDialogs": [
              "110400417"
            ]
          },
          "110400417": {
            "id": "110400417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小心点！我觉得她是个危险人物…呃，至少，有点狡猾。",
            "nextDialogs": [
              "110400418"
            ]
          },
          "110400418": {
            "id": "110400418",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "哦？相比起历史悠久的西风教会的成员，你这种来历不明的小漂浮物才更危险吧。",
            "nextDialogs": [
              "110400419"
            ]
          },
          "110400419": {
            "id": "110400419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "被听到了？！我还以为我说得够小声了…",
            "nextDialogs": [
              "110400420"
            ]
          },
          "110400420": {
            "id": "110400420",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "嗯，带着小漂浮物的外乡人…原来如此，你就是…呵呵。",
            "nextDialogs": [
              "110400421"
            ]
          },
          "110400421": {
            "id": "110400421",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "击退了风魔龙的「荣誉骑士」，凭这层身份，就先不急着追究你的偷听了。",
            "nextDialogs": [
              "110400422"
            ]
          },
          "110400422": {
            "id": "110400422",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "否则…视你们的回答而定，最坏的情况可能会是牢狱之灾呢。",
            "nextDialogs": [
              "110400423"
            ]
          },
          "110400423": {
            "id": "110400423",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！蒙德城的修女还能负责抓捕可疑人士的吗？！",
            "nextDialogs": [
              "110400424"
            ]
          },
          "110400424": {
            "id": "110400424",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "至少不能对明显存在的隐患视而不见吧，修女就不可以拥有正义感吗？",
            "nextDialogs": [
              "110400425"
            ]
          },
          "110400425": {
            "id": "110400425",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，听上去怪怪的，但好像没办法反驳…",
            "nextDialogs": [
              "110400426"
            ]
          },
          "110400426": {
            "id": "110400426",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "还是说说你们吧，你们是为什么要到雪山来呢？",
            "nextDialogs": [
              "110400431",
              "110400429"
            ]
          },
          "110400431": {
            "id": "110400431",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "找他的话，我之前特意留意了一下他的足迹。",
            "nextDialogs": [
              "110400432"
            ]
          },
          "110400432": {
            "id": "110400432",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "雪停之后，往来雪山的人很多，希望一路上的痕迹还没有被盖掉。",
            "nextDialogs": [
              "110400433"
            ]
          },
          "110400433": {
            "id": "110400433",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难不成，你也是来找他的？",
            "nextDialogs": [
              "110400434"
            ]
          },
          "110400434": {
            "id": "110400434",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "不是的，这应该算职业习惯吧，因为我察觉到这些足迹上残留了元素力，警惕一点总没错。"
          },
          "110400429": {
            "id": "110400429",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "但你只是个旅行者，并非什么伟大的炼金术士吧。",
            "nextDialogs": [
              "110400430"
            ]
          },
          "110400430": {
            "id": "110400430",
            "speakerId": 1020,
            "speakerName": "罗莎莉亚",
            "text": "无所谓，我大概知道你是想来找谁了。"
          }
        }
      }
    },
    {
      "subId": "1104003",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110400311"
        ],
        "dialogs": {
          "110400311": {
            "id": "110400311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "聊到炼金和研究的话题，砂糖就完全不怯场了，这就是研究者的气质吗？",
            "nextDialogs": [
              "110400312"
            ]
          },
          "110400312": {
            "id": "110400312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总之，去雪山找那位「阿贝多先生」吧。",
            "nextDialogs": [
              "110400313"
            ]
          },
          "110400313": {
            "id": "110400313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然罗莎莉亚说足迹上有元素力，用元素视野应该能很清楚地看到吧。"
          }
        }
      }
    },
    {
      "subId": "1104005",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110400501"
        ],
        "dialogs": {
          "110400501": {
            "id": "110400501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，蒂玛乌斯先生今天好像不在…",
            "nextDialogs": [
              "110400502"
            ]
          },
          "110400502": {
            "id": "110400502",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "（咦，这两位是…）",
            "nextDialogs": [
              "110400503"
            ]
          },
          "110400503": {
            "id": "110400503",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "#那个！嗯…是派蒙和{NICKNAME}啊，请问，你们是找蒂玛乌斯有什么事吗？",
            "nextDialogs": [
              "110400504"
            ]
          },
          "110400504": {
            "id": "110400504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没什么没什么，只是平时他总是站在这里，有点奇怪而已。",
            "nextDialogs": [
              "110400505"
            ]
          },
          "110400505": {
            "id": "110400505",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "哦，这样啊。他刚刚被阿贝多先生叫走了，我是被叫来照看炼金铺的。",
            "nextDialogs": [
              "110400506"
            ]
          },
          "110400506": {
            "id": "110400506",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "需要我帮忙的话，就叫我的名字，如果不需要，我…我就在那边看书，嗯。",
            "nextDialogs": [
              "110400507"
            ]
          },
          "110400507": {
            "id": "110400507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嘿嘿，谢谢你的好意，不过不用担心啦，炼金台的使用已经很熟悉了，对吧，{NICKNAME}？",
            "nextDialogs": [
              "110400508"
            ]
          },
          "110400508": {
            "id": "110400508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，不会打扰到你。",
            "nextDialogs": [
              "110400509"
            ]
          },
          "110400509": {
            "id": "110400509",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "#{NICKNAME}，不愧是击退了那个风魔龙的人呢…",
            "nextDialogs": [
              "110400510"
            ]
          },
          "110400510": {
            "id": "110400510",
            "speakerId": 1019,
            "speakerName": "砂糖",
            "text": "对了，如果是你的话，一定能帮上阿贝多先生的忙吧。",
            "nextDialogs": [
              "110400511"
            ]
          },
          "110400511": {
            "id": "110400511",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，上次就一直从你和蒂玛乌斯口中听到什么「阿贝多先生」，他也是蒙德城的炼金术士吗？"
          }
        }
      }
    }
  ]
}
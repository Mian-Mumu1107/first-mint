      }
    },
    {
      "subId": "7906604",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790660401"
        ],
        "dialogs": {
          "790660401": {
            "id": "790660401",
            "speakerId": 1002,
            "speakerName": "苏法什",
            "text": "萨博兰，我们必须要想个办法！",
            "nextDialogs": [
              "790660402"
            ]
          },
          "790660402": {
            "id": "790660402",
            "speakerId": 1001,
            "speakerName": "萨博兰",
            "text": "唉…你说得对。但咱们哪次拦住过公主殿下？"
          }
        }
      }
    },
    {
      "subId": "7906608",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "790660801"
        ],
        "dialogs": {
          "790660801": {
            "id": "790660801",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "#通过啦！{NICKNAME}，我们是守护者了！这就是用来认可守护者的圣物吗？",
            "nextDialogs": [
              "790660802"
            ]
          },
          "790660802": {
            "id": "790660802",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "咦？这个圣物上面还刻着什么呢，好像是一句话？我看看…",
            "nextDialogs": [
              "790660803"
            ]
          },
          "790660803": {
            "id": "790660803",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "「故事循规蹈矩，往复来回，但每一篇都应当有自己的路途。」",
            "nextDialogs": [
              "790660804"
            ]
          },
          "790660804": {
            "id": "790660804",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "#呃，不明白。{NICKNAME}，你明白吗？",
            "nextDialogs": [
              "790660807"
            ]
          },
          "790660807": {
            "id": "790660807",
            "speakerId": 1003,
            "speakerName": "西梅",
            "text": "这句话一直被刻在圣物上，我也不知道它的来历…",
            "nextDialogs": [
              "790660808"
            ]
          },
          "790660808": {
            "id": "790660808",
            "speakerId": 1003,
            "speakerName": "西梅",
            "text": "我觉得，这句话或许是有关于王国的重要信息…但到现在也没有弄懂。",
            "nextDialogs": [
              "790660809"
            ]
          },
          "790660809": {
            "id": "790660809",
            "speakerId": 1003,
            "speakerName": "西梅",
            "text": "不管如何，您在试炼中的表现，是我遇见的最符合「守护者」之名的应募者。",
            "nextDialogs": [
              "790660810"
            ]
          },
          "790660810": {
            "id": "790660810",
            "speakerId": 1003,
            "speakerName": "西梅",
            "text": "您的能力和判断都无可置疑，能在这种时刻遇见您，是我们王国的幸运。",
            "nextDialogs": [
              "790660811"
            ]
          },
          "790660811": {
            "id": "790660811",
            "speakerId": 1003,
            "speakerName": "西梅",
            "text": "现在圣物已经取来。我们马上开始举行典仪。",
            "nextDialogs": [
              "790660812"
            ]
          },
          "790660812": {
            "id": "790660812",
            "speakerId": 1003,
            "speakerName": "西梅",
            "text": "我相信，圣物也会为您的勇气和能力而折服。"
          }
        }
      }
    }
  ]
}
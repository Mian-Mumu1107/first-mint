{
  "lineCounts": {
    "Player": 7,
    "应公": 22,
    "派蒙": 5
  },
  "subQuests": [
    {
      "subId": "7151601",
      "subQuestName": "和应公聊聊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715160101"
        ],
        "dialogs": {
          "715160101": {
            "id": "715160101",
            "speakerId": 1000,
            "speakerName": "应公",
            "text": "这出戏算是完美落幕了，年轻人，你做得不错。感觉怎么样，演纸映剧难不难？",
            "nextDialogs": [
              "715160103",
              "715160105"
            ]
          },
          "715160103": {
            "id": "715160103",
            "speakerId": 1000,
            "speakerName": "应公",
            "text": "纸映剧和璃月戏不同，一个人也能演，的确是轻松不少。",
            "nextDialogs": [
              "715160106"
            ]
          },
          "715160106": {
            "id": "715160106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#我觉得{NICKNAME}做得够好啦，纸映剧本身也很有意思，我还想看新的故事，应公大叔，你什么时候再演？",
            "nextDialogs": [
              "715160107"
            ]
          },
          "715160107": {
            "id": "715160107",
            "speakerId": 1000,
            "speakerName": "应公",
            "text": "哈哈，有人喜欢就好。至于什么时候再演，我还真说不好。",
            "nextDialogs": [
              "715160108"
            ]
          },
          "715160108": {
            "id": "715160108",
            "speakerId": 1000,
            "speakerName": "应公",
            "text": "本来嘛，演纸映剧给孩子们看算是我的业余爱好。这一出演完了，我就回云翰社去管行头了。",
            "nextDialogs": [
              "715160109"
            ]
          },
          "715160109": {
            "id": "715160109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？大叔你是云翰社的人吗？那你一定也会唱璃月戏吧。",
            "nextDialogs": [
              "715160110"
            ]
          },
          "715160110": {
            "id": "715160110",
            "speakerId": 1000,
            "speakerName": "应公",
            "text": "唱是会唱，常年泡在云翰社里，谁不会哼几句？但要跟我们云老板比还是差远咯。",
            "nextDialogs": [
              "715160111"
            ]
          },
          "715160111": {
            "id": "715160111",
            "speakerId": 1000,
            "speakerName": "应公",
            "text": "我啊，属于幕后忙活的那拨人。戏台上用的枪杆子、大旗、各式各样的戏服、配饰、道具…都归我管。",
            "nextDialogs": [
              "715160112"
            ]
          },
          "715160112": {
            "id": "715160112",
            "speakerId": 1000,
            "speakerName": "应公",
            "text": "云翰社现在用的行头，一部分是以前留下来的，一部分是我去购置的，还有的是我亲手做的。",
            "nextDialogs": [
              "715160113"
            ]
          },
          "715160113": {
            "id": "715160113",
            "speakerId": 1000,
            "speakerName": "应公",
            "text": "要唱一出全本璃月戏，台上台下忙活的人有一大堆，只有几个演员那肯定不行。",
            "nextDialogs": [
              "715160114"
            ]
          },
          "715160114": {
            "id": "715160114",
            "speakerId": 1000,
            "speakerName": "应公",
            "text": "今年海灯节，云老板给我们几个幕后干活的人放了假，我那几个老朋友又都回老家过节去了。",
            "nextDialogs": [
              "715160115"
            ]
          },
          "715160115": {
            "id": "715160115",
            "speakerId": 1000,
            "speakerName": "应公",
            "text": "我一个人没什么事干，就干脆带着家伙物事给大家演纸映剧来了。",
            "nextDialogs": [
              "715160116"
            ]
          },
          "715160116": {
            "id": "715160116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不回家吗？",
            "nextDialogs": [
              "715160117"
            ]
          },
          "715160117": {
            "id": "715160117",
            "speakerId": 1000,
            "speakerName": "应公",
            "text": "哦，我没成家，前年我家老爷子和老娘走了，就剩我一个人。"
          },
          "715160105": {
            "id": "715160105",
            "speakerId": 1000,
            "speakerName": "应公",
            "text": "你不是行内人，第一次尝试当然会犯些错误，这是在所难免的。"
          }
        }
      }
    }
  ]
}
{
  "lineCounts": {
    "Black Screen": 12,
    "Player": 34,
    "加特尼奥": 30,
    "洛耶茨": 21,
    "派蒙": 14,
    "艾尤恩": 70,
    "迪福尔": 36
  },
  "subQuests": [
    {
      "subId": "7403402",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740340101"
        ],
        "dialogs": {
          "740340101": {
            "id": "740340101",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "…我真的没法相信，难道真有人会把留影机带进复律庭里，大张旗鼓地到处留影吗？",
            "nextDialogs": [
              "740340102"
            ]
          },
          "740340102": {
            "id": "740340102",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "太荒谬了，人人都知道这样做会泄密，这是常识啊。",
            "nextDialogs": [
              "740340103"
            ]
          },
          "740340103": {
            "id": "740340103",
            "speakerId": 1001,
            "speakerName": "洛耶茨",
            "text": "如果人人都有常识，那复律庭明天就可以解散了，艾尤恩先生。",
            "nextDialogs": [
              "740340104"
            ]
          },
          "740340104": {
            "id": "740340104",
            "speakerId": 1001,
            "speakerName": "洛耶茨",
            "text": "这件事就交给你了，就像我之前教你的那样办，让他们在文件上面签字，在周末之前交给我。",
            "nextDialogs": [
              "740340105"
            ]
          },
          "740340105": {
            "id": "740340105",
            "speakerId": 1001,
            "speakerName": "洛耶茨",
            "text": "我还得去处理那些报销单据的事，卡尔西那边已经催我很多次了。",
            "nextDialogs": [
              "740340106"
            ]
          },
          "740340106": {
            "id": "740340106",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "但洛耶茨先生，我到底应该去找谁？我们可没有专门负责留影机的办公室啊。",
            "nextDialogs": [
              "740340107"
            ]
          },
          "740340107": {
            "id": "740340107",
            "speakerId": 1001,
            "speakerName": "洛耶茨",
            "text": "呃…我相信你的判断力。赶紧搞定这件事，让我们各自度过一个愉快的周末吧。我得去处理别的事了，抓紧点，小伙子！",
            "nextDialogs": [
              "740340108"
            ]
          },
          "740340108": {
            "id": "740340108",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "好吧，洛耶茨先生…",
            "nextDialogs": [
              "740340133"
            ]
          },
          "740340133": {
            "id": "740340133",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "洛耶茨慢悠悠地离开了…",
            "nextDialogs": [
              "740340109"
            ]
          },
          "740340109": {
            "id": "740340109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么呢？",
            "nextDialogs": [
              "740340110"
            ]
          },
          "740340110": {
            "id": "740340110",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "欸？您好，您好。看样子…您应该不是复律庭的职员吧？",
            "nextDialogs": [
              "740340111"
            ]
          },
          "740340111": {
            "id": "740340111",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "我正准备去办事，如果您是想咨询我什么事的话，请先去柯妮莉娅小姐那边吧。",
            "nextDialogs": [
              "740340112"
            ]
          },
          "740340112": {
            "id": "740340112",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "她会给您一把椅子，还有一杯茶。请您先在那边休息，等我办完事后就来找您。",
            "nextDialogs": [
              "740340113"
            ]
          },
          "740340113": {
            "id": "740340113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你要去办什么事？",
            "nextDialogs": [
              "740340114"
            ]
          },
          "740340114": {
            "id": "740340114",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "唉，应该说…只是一件很简单的小事。但办起来却很复杂…",
            "nextDialogs": [
              "740340115"
            ]
          },
          "740340115": {
            "id": "740340115",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "我所在的办公室刚接到了通知，要我们起草一份发给其他办公室的函。",
            "nextDialogs": [
              "740340116"
            ]
          },
          "740340116": {
            "id": "740340116",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "大概内容就是，除了用留影机工作外，禁止职员随意将留影机带进复律庭里进行留影，以防泄密。",
            "nextDialogs": [
              "740340117"
            ]
          },
          "740340117": {
            "id": "740340117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你告诉我函的内容算泄密吗？",
            "nextDialogs": [
              "740340118"
            ]
          },
          "740340118": {
            "id": "740340118",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "不，绝对不算。如果真有人用留影机拍摄了文件，导致了泄密，那么这件事会被视为保密事件。",
            "nextDialogs": [
              "740340119"
            ]
          },
          "740340119": {
            "id": "740340119",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "但「也许会有人用留影机拍摄文件进行泄密」这件事不是保密的，毕竟大家都知道这件事有可行性。",
            "nextDialogs": [
              "740340120"
            ]
          },
          "740340120": {
            "id": "740340120",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "头，头有点晕…",
            "nextDialogs": [
              "740340121"
            ]
          },
          "740340121": {
            "id": "740340121",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "您就这么理解：如果您正在保守一件秘密，那么这个秘密本身当然是被视为不可泄露的。",
            "nextDialogs": [
              "740340122"
            ]
          },
          "740340122": {
            "id": "740340122",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "但「您正在保守一件秘密」这件事，不一定是个秘密啊。",
            "nextDialogs": [
              "740340123"
            ]
          },
          "740340123": {
            "id": "740340123",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "毕竟，如果连「正在保守一件秘密」这件事都是秘密的话，那么您就要陷入无限的保密死循环了。",
            "nextDialogs": [
              "740340124"
            ]
          },
          "740340124": {
            "id": "740340124",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这句话本身就够死循环的啦！",
            "nextDialogs": [
              "740340127"
            ]
          },
          "740340127": {
            "id": "740340127",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "这就是复杂的地方了，整个复律庭里没有一个办公室专门分管留影机。",
            "nextDialogs": [
              "740340128"
            ]
          },
          "740340128": {
            "id": "740340128",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "瑟米安先生说，理应去找加特尼奥先生。他的工作就和保密相关，这件事涉及保密工作，他应该最先知悉。",
            "nextDialogs": [
              "740340129"
            ]
          },
          "740340129": {
            "id": "740340129",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "但洛耶茨先生却说，我应该先去问问迪福尔，这位先生所在的办公室负责复律庭里各类和人员相关的事宜。",
            "nextDialogs": [
              "740340130"
            ]
          },
          "740340130": {
            "id": "740340130",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "如果想让整个复律庭里的人都别带留影机上班，那一定得让他们知悉。",
            "nextDialogs": [
              "740340131"
            ]
          },
          "740340131": {
            "id": "740340131",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "呜哇，好复杂…怎么有这么多人负责不同的事呀？要是记不住怎么办…",
            "nextDialogs": [
              "740340132"
            ]
          },
          "740340132": {
            "id": "740340132",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "所以，我们每个人都有一本厚厚的备忘录嘛。但就算有备忘录，我现在也不知道去找谁啊…"
          }
        }
      }
    },
    {
      "subId": "7403401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740340401"
        ],
        "dialogs": {
          "740340401": {
            "id": "740340401",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "就让您见识一下这位先生的能力吧。咱们这边走。"
          }
        }
      }
    },
    {
      "subId": "7403414",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740340201"
        ],
        "dialogs": {
          "740340201": {
            "id": "740340201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "事关保密，去找加特尼奥吧。",
            "nextDialogs": [
              "740340202"
            ]
          },
          "740340202": {
            "id": "740340202",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "您的想法倒是和我一样，加特尼奥先生是一位温和的人，也是一位「出色的复律庭职员」。",
            "nextDialogs": [
              "740340203"
            ]
          },
          "740340203": {
            "id": "740340203",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "他的工作虽然件件都事关重大，但每一件事都能被这先生安排妥当。这在复律庭可以称得上出类拔萃了。"
          }
        }
      }
    },
    {
      "subId": "7403415",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740340301"
        ],
        "dialogs": {
          "740340301": {
            "id": "740340301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "事关人员，去找迪福尔吧。",
            "nextDialogs": [
              "740340302"
            ]
          },
          "740340302": {
            "id": "740340302",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "您的想法倒是和我一样，但这位先生脾气很是暴躁，虽然办事牢靠，但嘴上总不饶人。",
            "nextDialogs": [
              "740340303"
            ]
          },
          "740340303": {
            "id": "740340303",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "唉，但这件事也确实必须要在第一时间告知他…"
          }
        }
      }
    },
    {
      "subId": "7403403",
      "subQuestName": "与加特尼奥对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740340501"
        ],
        "dialogs": {
          "740340501": {
            "id": "740340501",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "艾尤恩，真是巧遇。今天下班你总有时间和我喝杯咖啡了吧？",
            "nextDialogs": [
              "740340502"
            ]
          },
          "740340502": {
            "id": "740340502",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "感谢您的好意，但我有一件「秘密事务」来请您处理。",
            "nextDialogs": [
              "740340503"
            ]
          },
          "740340503": {
            "id": "740340503",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "「秘密事务」？是我知道的事吗？",
            "nextDialogs": [
              "740340504"
            ]
          },
          "740340504": {
            "id": "740340504",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "我想您应该不知道。今天早上我才接到这文件呢。",
            "nextDialogs": [
              "740340505"
            ]
          },
          "740340505": {
            "id": "740340505",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "这倒是稀奇，也许是我今天还没来得及看《蒸汽鸟报》的原因，获取消息的速度慢了你一步。",
            "nextDialogs": [
              "740340506"
            ]
          },
          "740340506": {
            "id": "740340506",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "明明是秘密事务，为什么你会在《蒸汽鸟报》上看到呀？",
            "nextDialogs": [
              "740340507"
            ]
          },
          "740340507": {
            "id": "740340507",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "哈哈哈，那些记者传递消息的速度，可比我们复律庭内部传递消息的速度快多了。",
            "nextDialogs": [
              "740340508"
            ]
          },
          "740340508": {
            "id": "740340508",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "但也可以理解，毕竟他们传递消息可是会拿到报酬的嘛。",
            "nextDialogs": [
              "740340509"
            ]
          },
          "740340509": {
            "id": "740340509",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "完，完全无法理解…",
            "nextDialogs": [
              "740340510"
            ]
          },
          "740340510": {
            "id": "740340510",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "先不谈这些。先生，事情是这样的…",
            "nextDialogs": [
              "740340511"
            ]
          },
          "740340511": {
            "id": "740340511",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "艾尤恩详细叙述了相关事宜…",
            "nextDialogs": [
              "740340512"
            ]
          },
          "740340512": {
            "id": "740340512",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "没错，的确有必要下发这样的文件，之前确实出过这样的事。一个白痴为了显摆自己的桌面摆设，拿留影机给自己的桌子留影。",
            "nextDialogs": [
              "740340513"
            ]
          },
          "740340513": {
            "id": "740340513",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "他是「留影机爱好协会」的一员，还把那张画片拿去给会员们看。",
            "nextDialogs": [
              "740340534"
            ]
          },
          "740340534": {
            "id": "740340534",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "但会员中的一名记者很快发现，在画片中有一份疑似复律庭内部通讯稿的文件。",
            "nextDialogs": [
              "740340514"
            ]
          },
          "740340514": {
            "id": "740340514",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "然后，那份抱怨复律庭的内部晚餐除了鱼就是鱼的通讯，第二天就出现在了《蒸汽鸟报》上。",
            "nextDialogs": [
              "740340515"
            ]
          },
          "740340515": {
            "id": "740340515",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "这也算是需要保守的秘密吗…",
            "nextDialogs": [
              "740340516"
            ]
          },
          "740340516": {
            "id": "740340516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来好像不是很严重…",
            "nextDialogs": [
              "740340517"
            ]
          },
          "740340517": {
            "id": "740340517",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "无论如何，这也算得上是内部通讯，于情于理都不该对外泄露。",
            "nextDialogs": [
              "740340518"
            ]
          },
          "740340518": {
            "id": "740340518",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "枫丹廷的人们可不会放过任何一个嘲笑复律庭的机会，我们必须得谨慎行事。",
            "nextDialogs": [
              "740340519"
            ]
          },
          "740340519": {
            "id": "740340519",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "即使他们其实根本不关心我们在做什么。他们只是想…呃，笑两声。",
            "nextDialogs": [
              "740340520"
            ]
          },
          "740340520": {
            "id": "740340520",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "呃，总之…那这份文件就由您的办公室来…",
            "nextDialogs": [
              "740340521"
            ]
          },
          "740340521": {
            "id": "740340521",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "但有关人员事务规章…迪福尔所在的办公室显然更适合签发这份文件。",
            "nextDialogs": [
              "740340522"
            ]
          },
          "740340522": {
            "id": "740340522",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "毕竟，在这份文件里，虽然告知所有人保密原则十分重要，但更重要的是，如何告知所有人保密原则。",
            "nextDialogs": [
              "740340523"
            ]
          },
          "740340523": {
            "id": "740340523",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "要我说，必须得迪福尔来领办，我们办公室可以协办。这样既有效率，又能保密。",
            "nextDialogs": [
              "740340524"
            ]
          },
          "740340524": {
            "id": "740340524",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "加特尼奥飞快地在文件上的协办方位置上签上了名字…",
            "nextDialogs": [
              "740340525"
            ]
          },
          "740340525": {
            "id": "740340525",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "但是，加特尼奥先生！这事…",
            "nextDialogs": [
              "740340526"
            ]
          },
          "740340526": {
            "id": "740340526",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "好啦小伙子，办这种急事可不能拖拖拉拉的。快去找迪福尔吧，不然他的耐心马上就要被日常工作给耗尽了。",
            "nextDialogs": [
              "740340527"
            ]
          },
          "740340527": {
            "id": "740340527",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "我也得去帮你们找找可用的保密原则了，等到文件正式下发，我们办公室一定全力支持！",
            "nextDialogs": [
              "740340535"
            ]
          },
          "740340535": {
            "id": "740340535",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "快去找他吧，小伙子！我还得去…呃，处理别的事务。",
            "nextDialogs": [
              "740340536"
            ]
          },
          "740340536": {
            "id": "740340536",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "加特尼奥大踏步地离开了…",
            "nextDialogs": [
              "740340528"
            ]
          },
          "740340528": {
            "id": "740340528",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "什么？加特尼奥先生，等等！",
            "nextDialogs": [
              "740340531"
            ]
          },
          "740340531": {
            "id": "740340531",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "您见识到加特尼奥先生的能力了吧？他能把所有事都办理妥当的诀窍，就是从来不办有风险的事。",
            "nextDialogs": [
              "740340532"
            ]
          },
          "740340532": {
            "id": "740340532",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "原来是这种推卸责任的能力啊…",
            "nextDialogs": [
              "740340533"
            ]
          },
          "740340533": {
            "id": "740340533",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "没办法…只能去找迪福尔先生了。咱们这边走。"
          }
        }
      }
    },
    {
      "subId": "7403405",
      "subQuestName": "与迪福尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740340601"
        ],
        "dialogs": {
          "740340601": {
            "id": "740340601",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "艾尤恩。你找我有什么事吗？气喘吁吁的…",
            "nextDialogs": [
              "740340602"
            ]
          },
          "740340602": {
            "id": "740340602",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "事情是这样的，迪福尔先生…",
            "nextDialogs": [
              "740340603"
            ]
          },
          "740340603": {
            "id": "740340603",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "艾尤恩详细叙述了相关事宜…",
            "nextDialogs": [
              "740340604"
            ]
          },
          "740340604": {
            "id": "740340604",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "你找错人了，艾尤恩。你难道没意识到这份文件的重点是「保密」吗？",
            "nextDialogs": [
              "740340605"
            ]
          },
          "740340605": {
            "id": "740340605",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "我还以为主语是「这份文件」…",
            "nextDialogs": [
              "740340606"
            ]
          },
          "740340606": {
            "id": "740340606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "语法确实如此。",
            "nextDialogs": [
              "740340607"
            ]
          },
          "740340607": {
            "id": "740340607",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "喂，现在的重点不是这个吧？",
            "nextDialogs": [
              "740340608"
            ]
          },
          "740340608": {
            "id": "740340608",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "我真欣赏你们的严谨。但这份文件我是不会签的，无论怎么考虑，都应该是加特尼奥来领头。",
            "nextDialogs": [
              "740340609"
            ]
          },
          "740340609": {
            "id": "740340609",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "加特尼奥先生说，应该由您来领头…",
            "nextDialogs": [
              "740340610"
            ]
          },
          "740340610": {
            "id": "740340610",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "哈！我来？该怎么做，我要拿着喇叭，朝每一位进来上班的人大喊吗？",
            "nextDialogs": [
              "740340611"
            ]
          },
          "740340611": {
            "id": "740340611",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "「嘿！先生女士们，不要把留影机带进办公室，这样会导致泄密！绝对不要做这样的事！」",
            "nextDialogs": [
              "740340612"
            ]
          },
          "740340612": {
            "id": "740340612",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "还是我要去印几百份文件，放在每一位复律庭职员的桌上，让他们拿着去喝咖啡？",
            "nextDialogs": [
              "740340613"
            ]
          },
          "740340613": {
            "id": "740340613",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "我们可不像加特尼奥，能把泄密的人逮住，然后教训他们。我们唯一能做的就是发通知，没人会搭理这些文件。",
            "nextDialogs": [
              "740340614"
            ]
          },
          "740340614": {
            "id": "740340614",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "但他已经在文件上签了字，您瞧这里…",
            "nextDialogs": [
              "740340615"
            ]
          },
          "740340615": {
            "id": "740340615",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "年轻人，你知道「协办方」是什么意思吗？",
            "nextDialogs": [
              "740340616"
            ]
          },
          "740340616": {
            "id": "740340616",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "呃…听从调遣的一方？",
            "nextDialogs": [
              "740340617"
            ]
          },
          "740340617": {
            "id": "740340617",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "意思是「至少主要责任不在我」。",
            "nextDialogs": [
              "740340618"
            ]
          },
          "740340618": {
            "id": "740340618",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "我绝不会在这份文件上签字。如果非要我们办公室来领办，那就让马内瓦尔亲自来说吧。",
            "nextDialogs": [
              "740340619"
            ]
          },
          "740340619": {
            "id": "740340619",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "迪福尔怒气冲冲地离开了…",
            "nextDialogs": [
              "740340620"
            ]
          },
          "740340620": {
            "id": "740340620",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "他、他说话的声音好大，根本不敢插话…",
            "nextDialogs": [
              "740340621"
            ]
          },
          "740340621": {
            "id": "740340621",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "您看，这位先生的脾气就是这么暴躁。",
            "nextDialogs": [
              "740340622"
            ]
          },
          "740340622": {
            "id": "740340622",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那现在怎么办？",
            "nextDialogs": [
              "740340623"
            ]
          },
          "740340623": {
            "id": "740340623",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "别担心…咱们回去找洛耶茨先生吧。"
          }
        }
      }
    },
    {
      "subId": "7403407",
      "subQuestName": "与迪福尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740340701"
        ],
        "dialogs": {
          "740340701": {
            "id": "740340701",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "艾尤恩，我猜你今天没有带什么好消息给我。",
            "nextDialogs": [
              "740340702"
            ]
          },
          "740340702": {
            "id": "740340702",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "先生，这确实不是个好消息。准确来说，这是一个「秘密」消息。",
            "nextDialogs": [
              "740340703"
            ]
          },
          "740340703": {
            "id": "740340703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确实如此。",
            "nextDialogs": [
              "740340704"
            ]
          },
          "740340704": {
            "id": "740340704",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "非常幽默，艾尤恩。那么这个「秘密」消息到底是什么？",
            "nextDialogs": [
              "740340705"
            ]
          },
          "740340705": {
            "id": "740340705",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "艾尤恩详细叙述了相关事宜…",
            "nextDialogs": [
              "740340706"
            ]
          },
          "740340706": {
            "id": "740340706",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "这种情况的确有可能出现，毕竟复律庭里的职员对一份文件的密级程度并不敏感。",
            "nextDialogs": [
              "740340709"
            ]
          },
          "740340709": {
            "id": "740340709",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "这都是拜加特尼奥那群人所赐。所有复律庭里来往的文件，都会交由他们审定密级，再做上标记。",
            "nextDialogs": [
              "740340710"
            ]
          },
          "740340710": {
            "id": "740340710",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "这制度听起来还算不错。但那群审定密级的人为了省事，无论什么文件，都至少会给一个「秘密」的定级。",
            "nextDialogs": [
              "740340711"
            ]
          },
          "740340711": {
            "id": "740340711",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "上周卡尔西去欧庇克莱歌剧院发表了一次演说，谈了谈新歌剧演出的话题。",
            "nextDialogs": [
              "740340712"
            ]
          },
          "740340712": {
            "id": "740340712",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "我记得这件事，演讲过程不长，但有很多人听，而且演讲稿还登上了报纸呢。",
            "nextDialogs": [
              "740340713"
            ]
          },
          "740340713": {
            "id": "740340713",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "既然已经在大家面前讲过了，那大家也都该知道了呀。大家都知道的事，怎么能算是秘密呢？",
            "nextDialogs": [
              "740340714"
            ]
          },
          "740340714": {
            "id": "740340714",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "没错，但就算这样，加特尼奥也非要给它定一个「秘密」。"
          }
        }
      }
    },
    {
      "subId": "7403409",
      "subQuestName": "与加特尼奥对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740340801"
        ],
        "dialogs": {
          "740340801": {
            "id": "740340801",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "艾尤恩！好小伙子，我竟然会在这遇见你。",
            "nextDialogs": [
              "740340802"
            ]
          },
          "740340802": {
            "id": "740340802",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "加特尼奥先生，我正在找你。有一个消息我得让你知道…",
            "nextDialogs": [
              "740340803"
            ]
          },
          "740340803": {
            "id": "740340803",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "什么消息？我刚看完了今天的《蒸汽鸟报》，上面没有提到复律庭啊。",
            "nextDialogs": [
              "740340804"
            ]
          },
          "740340804": {
            "id": "740340804",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "是的，这个消息事关保密。",
            "nextDialogs": [
              "740340805"
            ]
          },
          "740340805": {
            "id": "740340805",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "喔，那倒真是稀奇。除了记者之外，居然还有人能分辨出一件事是否有关保密。",
            "nextDialogs": [
              "740340806"
            ]
          },
          "740340806": {
            "id": "740340806",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "艾尤恩详细叙述了相关事宜…",
            "nextDialogs": [
              "740340807"
            ]
          },
          "740340807": {
            "id": "740340807",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "哎哟，迪福尔先生简直就是一位勤勉的记者，他就差直接冲来我的办公室，质问我这份文件的保密性了。",
            "nextDialogs": [
              "740340808"
            ]
          },
          "740340808": {
            "id": "740340808",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "我完全同意他的观点。这件事确实得先确定密级，但「留影机泄密」事关重大，可能牵涉整个复律庭。",
            "nextDialogs": [
              "740340809"
            ]
          },
          "740340809": {
            "id": "740340809",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "我一个办公室无法为其定级，必须得送去给其他几位先生审定，让他们全部都知悉才行。比如…卡尔西先生。",
            "nextDialogs": [
              "740340810"
            ]
          },
          "740340810": {
            "id": "740340810",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "欸？但这份文件就是卡尔西先生发下来的…",
            "nextDialogs": [
              "740340811"
            ]
          },
          "740340811": {
            "id": "740340811",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "那就更应该让他知道我们后续的处理方案了。来吧年轻人，我们先去找洛耶茨，然后再去见卡尔西先生。",
            "nextDialogs": [
              "740340812"
            ]
          },
          "740340812": {
            "id": "740340812",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "什么？等等！加特尼奥先生！"
          }
        }
      }
    },
    {
      "subId": "7403411",
      "subQuestName": "与洛耶茨对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740340901"
        ],
        "dialogs": {
          "740340901": {
            "id": "740340901",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "这是保密事件，理应由你们办公室来领头。",
            "nextDialogs": [
              "740340902"
            ]
          },
          "740340902": {
            "id": "740340902",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "那照你这么说，那以后我们经办的事件，即使和人员事宜相关，也不用让你们知悉了？",
            "nextDialogs": [
              "740340903"
            ]
          },
          "740340903": {
            "id": "740340903",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "别偷换概念了，这俩不是一件事！",
            "nextDialogs": [
              "740340904"
            ]
          },
          "740340904": {
            "id": "740340904",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "这俩究竟是不是一件事，轮不到你我说了算。",
            "nextDialogs": [
              "740340905"
            ]
          },
          "740340905": {
            "id": "740340905",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "事情…又被我办砸了…",
            "nextDialogs": [
              "740340908"
            ]
          },
          "740340908": {
            "id": "740340908",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，不然…不然我们先出去吧，大人们吵架好可怕…",
            "nextDialogs": [
              "740340909"
            ]
          },
          "740340909": {
            "id": "740340909",
            "speakerId": 1001,
            "speakerName": "洛耶茨",
            "text": "先生们，先生们！冷静，冷静下来！别为了这么点小事坏和气！",
            "nextDialogs": [
              "740340910"
            ]
          },
          "740340910": {
            "id": "740340910",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "这可不是一件小事，洛耶茨先生，这可是牵扯到整个复律庭的大事啊。这件事我可不敢独断。",
            "nextDialogs": [
              "740340911"
            ]
          },
          "740340911": {
            "id": "740340911",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "的确如此，毕竟保密无小事。我看整个复律庭除了加特尼奥之外，也没有其他办公室适合主导了。",
            "nextDialogs": [
              "740340912"
            ]
          },
          "740340912": {
            "id": "740340912",
            "speakerId": 1001,
            "speakerName": "洛耶茨",
            "text": "放轻松，为什么二位一定要争论谁来主导呢？依我看，这件事压根就不需要人来「主导」啊，就连协办也不用。",
            "nextDialogs": [
              "740340913"
            ]
          },
          "740340913": {
            "id": "740340913",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "什么？",
            "nextDialogs": [
              "740340914"
            ]
          },
          "740340914": {
            "id": "740340914",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "欸？",
            "nextDialogs": [
              "740340915"
            ]
          },
          "740340915": {
            "id": "740340915",
            "speakerId": 1004,
            "speakerName": "加特尼奥",
            "text": "我没明白您的意思，洛耶茨先生。",
            "nextDialogs": [
              "740340916"
            ]
          },
          "740340916": {
            "id": "740340916",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "我没跟上您的思路，洛耶茨先生。",
            "nextDialogs": [
              "740340917"
            ]
          },
          "740340917": {
            "id": "740340917",
            "speakerId": 1001,
            "speakerName": "洛耶茨",
            "text": "二位都是经验丰富的人，对于一件复杂的事务，我们首先要做的当然是把它划分成简单的事。",
            "nextDialogs": [
              "740340918"
            ]
          },
          "740340918": {
            "id": "740340918",
            "speakerId": 1001,
            "speakerName": "洛耶茨",
            "text": "防止有人用留影机泄密这件事，理应由加特尼奥先生负责。",
            "nextDialogs": [
              "740340946"
            ]
          },
          "740340946": {
            "id": "740340946",
            "speakerId": 1001,
            "speakerName": "洛耶茨",
            "text": "但您不需要额外做什么工作，就和往常一样，去逮住那些泄密的人就行。",
            "nextDialogs": [
              "740340919"
            ]
          },
          "740340919": {
            "id": "740340919",
            "speakerId": 1001,
            "speakerName": "洛耶茨",
            "text": "让所有人知道留影机不能带进复律庭是件麻烦事，整个复律庭我想也只有迪福尔先生能厘清。",
            "nextDialogs": [
              "740340920"
            ]
          },
          "740340920": {
            "id": "740340920",
            "speakerId": 1005,
            "speakerName": "迪福尔",
            "text": "我们可没有强制执行的能力，没人听我们的！",
            "nextDialogs": [
              "740340921"
            ]
          },
          "740340921": {
            "id": "740340921",
            "speakerId": 1001,
            "speakerName": "洛耶茨",
            "text": "唉，您不用操心这件事。强制执行就交给加特尼奥先生吧，您要负责的不是「通知」，而是「倡议」。",
            "nextDialogs": [
              "740340922"
            ]
          },
          "740340922": {
            "id": "740340922",
            "speakerId": 1001,
            "speakerName": "洛耶茨",
            "text": "把这份「倡议」印得越大越好，就贴在复律庭的门口，下面再附上用留影机泄密的案例，这样就好了。",
            "nextDialogs": [
              "740340923"
            ]
          },
          "740340923": {
            "id": "740340923",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "听起来，好像和之前说的一模一样呀…"
          }
        }
      }
    }
  ]
}
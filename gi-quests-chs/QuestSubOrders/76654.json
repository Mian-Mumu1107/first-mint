  "subQuests": [
    {
      "subId": "7665401",
      "subQuestName": "前往「大书库」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766540101"
        ],
        "dialogs": {
          "766540101": {
            "id": "766540101",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "这样就算是，把「大书库」建好了吧。接下来是…鸟架、坐垫，还有存钱罐也要放过来…",
            "nextDialogs": [
              "766540102"
            ]
          },
          "766540102": {
            "id": "766540102",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "#啊，你们好，{NICKNAME}和小派蒙。",
            "nextDialogs": [
              "766540103"
            ]
          },
          "766540103": {
            "id": "766540103",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "多亏了你们的帮忙，书库修缮得也差不多了，算是…有模有样了吧。",
            "nextDialogs": [
              "766540104"
            ]
          },
          "766540104": {
            "id": "766540104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你刚才说的东西，是准备也放在书库里吗？",
            "nextDialogs": [
              "766540105"
            ]
          },
          "766540105": {
            "id": "766540105",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "是啊。但数量太多了，我一个人可能忙不过来。我正准备拜托手艺灵巧的族人，也帮我做一些呢。",
            "nextDialogs": [
              "766540108"
            ]
          },
          "766540108": {
            "id": "766540108",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "这间「大书库」对所有人和动物开放。既然有给人坐的家具，自然也要给小动物们准备一些。",
            "nextDialogs": [
              "766540109"
            ]
          },
          "766540109": {
            "id": "766540109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对喔…这么一说倒是挺有道理的…"
          }
        }
      }
    }
  ]

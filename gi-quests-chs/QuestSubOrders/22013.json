{
  "lineCounts": {
    "Player": 8,
    "柚子": 6,
    "梨绘": 8,
    "长谷川": 6,
    "阿茂": 20,
    "顺吉": 15
  },
  "subQuests": [
    {
      "subId": "2201301",
      "subQuestName": "拜访阿茂和顺吉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220130101"
        ],
        "dialogs": {
          "220130101": {
            "id": "220130101",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "你到底看了读者反馈没有，最近的评价可是一路暴跌啊！",
            "nextDialogs": [
              "220130102"
            ]
          },
          "220130102": {
            "id": "220130102",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "慌什么，这只是高潮爆发点前的沉寂。",
            "nextDialogs": [
              "220130103"
            ]
          },
          "220130103": {
            "id": "220130103",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "等我写到关键剧情，风评就会被彻底扭转了！",
            "nextDialogs": [
              "220130104"
            ]
          },
          "220130104": {
            "id": "220130104",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "在那一天之前，你的这本小说就要被腰斩了！",
            "nextDialogs": [
              "220130105"
            ]
          },
          "220130105": {
            "id": "220130105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生了什么事？",
            "nextDialogs": [
              "220130106"
            ]
          },
          "220130106": {
            "id": "220130106",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "旅行者，你可算是来了。",
            "nextDialogs": [
              "220130107"
            ]
          },
          "220130107": {
            "id": "220130107",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "自从上次取材了之后，顺吉又接连给《鬼武道》的主角增加了好几个过分的能力。",
            "nextDialogs": [
              "220130108"
            ]
          },
          "220130108": {
            "id": "220130108",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "「八重堂」收到了大量负面反馈，读者们都说，完全不理解这些能力出现的原因，觉得作者纯粹是想到哪写到哪。",
            "nextDialogs": [
              "220130109"
            ]
          },
          "220130109": {
            "id": "220130109",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "那些都是片面之词，只要我按照目前的节奏写下去，他们就会明白的——",
            "nextDialogs": [
              "220130110"
            ]
          },
          "220130110": {
            "id": "220130110",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "所以说，在读者们明白之前，你的小说就会被腰斩了！",
            "nextDialogs": [
              "220130111"
            ]
          },
          "220130111": {
            "id": "220130111",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "真是够了…我记得，这周围应该就有几个读过《鬼武道》的读者…",
            "nextDialogs": [
              "220130112"
            ]
          },
          "220130112": {
            "id": "220130112",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "如果你真觉得自己的想法会被读者们喜欢，那就直接去问问你的读者们吧。",
            "nextDialogs": [
              "220130113"
            ]
          },
          "220130113": {
            "id": "220130113",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "去就去！他们肯定会理解我的，旅行者，能拜托你和我同行，当个见证吗？",
            "nextDialogs": [
              "220130114"
            ]
          },
          "220130114": {
            "id": "220130114",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "这样也好，有旅行者同行的话，也免得你到时候又不认账了。",
            "nextDialogs": [
              "220130115"
            ]
          },
          "220130115": {
            "id": "220130115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我了。",
            "nextDialogs": [
              "220130116"
            ]
          },
          "220130116": {
            "id": "220130116",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "好，那我们现在就出发吧，我相信，读者们肯定会理解我的！",
            "nextDialogs": [
              "220130117"
            ]
          },
          "220130117": {
            "id": "220130117",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你到底加了多少设定…",
            "nextDialogs": [
              "220130118"
            ]
          },
          "220130118": {
            "id": "220130118",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "就…就一点点，只加了一点点而已。",
            "nextDialogs": [
              "220130119"
            ]
          },
          "220130119": {
            "id": "220130119",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "一点点？你再这么加下去，主角的能力马上就要比露过脸的角色还多了！",
            "nextDialogs": [
              "220130120"
            ]
          },
          "220130120": {
            "id": "220130120",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "咳…咳！我们赶紧出发吧，我相信，读者们肯定会理解我的！"
          }
        }
      }
    },
    {
      "subId": "2201302",
      "subQuestName": "询问柚子的意见",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220130301"
        ],
        "dialogs": {
          "220130301": {
            "id": "220130301",
            "speakerId": 1002,
            "speakerName": "柚子",
            "text": "你们好啊，有什么事吗？",
            "nextDialogs": [
              "220130302"
            ]
          },
          "220130302": {
            "id": "220130302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问您看过《鬼武道》吗？",
            "nextDialogs": [
              "220130303"
            ]
          },
          "220130303": {
            "id": "220130303",
            "speakerId": 1002,
            "speakerName": "柚子",
            "text": "咦？看过倒是看过，之前我还挺喜欢的呢，不过…怎么说呢，最近的剧情好像略略有些奇怪。",
            "nextDialogs": [
              "220130304"
            ]
          },
          "220130304": {
            "id": "220130304",
            "speakerId": 1002,
            "speakerName": "柚子",
            "text": "无论是面对什么敌人，主角都会突然觉醒出刚好可以克制这个敌人的能力，一下子就把敌人击败了。",
            "nextDialogs": [
              "220130305"
            ]
          },
          "220130305": {
            "id": "220130305",
            "speakerId": 1002,
            "speakerName": "柚子",
            "text": "之前我喜欢《鬼武道》的原因，更多的是喜欢主角击败敌人的巧妙方式，但是现在…总感觉有一种偷懒的感觉。",
            "nextDialogs": [
              "220130306"
            ]
          },
          "220130306": {
            "id": "220130306",
            "speakerId": 1002,
            "speakerName": "柚子",
            "text": "而且主角后面觉醒的很多能力，大多数都用了一次，实在是有一种说不出的随便感。",
            "nextDialogs": [
              "220130307"
            ]
          },
          "220130307": {
            "id": "220130307",
            "speakerId": 1002,
            "speakerName": "柚子",
            "text": "不知道写这本小说的作者到底是怎么设计的呢…",
            "nextDialogs": [
              "220130308"
            ]
          },
          "220130308": {
            "id": "220130308",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "咳咳…这…这…我们再去问几个人吧，这应该只是个例而已…"
          }
        }
      }
    },
    {
      "subId": "2201303",
      "subQuestName": "询问长谷川的意见",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220130401"
        ],
        "dialogs": {
          "220130401": {
            "id": "220130401",
            "speakerId": 1003,
            "speakerName": "长谷川",
            "text": "你们好，请问找我有事吗？",
            "nextDialogs": [
              "220130402"
            ]
          },
          "220130402": {
            "id": "220130402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问您看过《鬼武道》吗？",
            "nextDialogs": [
              "220130403"
            ]
          },
          "220130403": {
            "id": "220130403",
            "speakerId": 1003,
            "speakerName": "长谷川",
            "text": "看过的，是一本很有趣的小说啊，无论是角色的描写还是情节的设计，都很精彩。",
            "nextDialogs": [
              "220130404"
            ]
          },
          "220130404": {
            "id": "220130404",
            "speakerId": 1003,
            "speakerName": "长谷川",
            "text": "不过最近…感觉作者有些懈怠了啊。",
            "nextDialogs": [
              "220130405"
            ]
          },
          "220130405": {
            "id": "220130405",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "呃…呃…",
            "nextDialogs": [
              "220130406"
            ]
          },
          "220130406": {
            "id": "220130406",
            "speakerId": 1003,
            "speakerName": "长谷川",
            "text": "有好多次，在前文没有伏笔的情况下突然为角色增加设定。",
            "nextDialogs": [
              "220130407"
            ]
          },
          "220130407": {
            "id": "220130407",
            "speakerId": 1003,
            "speakerName": "长谷川",
            "text": "虽然说是「觉醒」，但这种获得能力的方式实在太过廉价，没有任何价值感。",
            "nextDialogs": [
              "220130408"
            ]
          },
          "220130408": {
            "id": "220130408",
            "speakerId": 1003,
            "speakerName": "长谷川",
            "text": "我觉得，这样子廉价的情节，也会连带着让角色同样变得廉价，真希望那位作家再好好想想啊…",
            "nextDialogs": [
              "220130409"
            ]
          },
          "220130409": {
            "id": "220130409",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "…旅行者，我们…我们去问下一个人吧…"
          }
        }
      }
    },
    {
      "subId": "2201304",
      "subQuestName": "询问梨绘的意见",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220130501"
        ],
        "dialogs": {
          "220130501": {
            "id": "220130501",
            "speakerId": 1004,
            "speakerName": "梨绘",
            "text": "贵安，两位，你们这是要找我聊天吗？",
            "nextDialogs": [
              "220130502"
            ]
          },
          "220130502": {
            "id": "220130502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问您看过《鬼武道》吗？",
            "nextDialogs": [
              "220130503"
            ]
          },
          "220130503": {
            "id": "220130503",
            "speakerId": 1004,
            "speakerName": "梨绘",
            "text": "我看过呀，而且我还很喜欢书里的主角呢。",
            "nextDialogs": [
              "220130504"
            ]
          },
          "220130504": {
            "id": "220130504",
            "speakerId": 1004,
            "speakerName": "梨绘",
            "text": "不过，这本小说最近让我看得很吃力…",
            "nextDialogs": [
              "220130505"
            ]
          },
          "220130505": {
            "id": "220130505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "吃力？",
            "nextDialogs": [
              "220130506"
            ]
          },
          "220130506": {
            "id": "220130506",
            "speakerId": 1004,
            "speakerName": "梨绘",
            "text": "最近的几章里，主角不是觉醒了很多新能力吗？",
            "nextDialogs": [
              "220130507"
            ]
          },
          "220130507": {
            "id": "220130507",
            "speakerId": 1004,
            "speakerName": "梨绘",
            "text": "书里花了很大的篇幅介绍那些能力的觉醒方式，还有可能的使用方法。",
            "nextDialogs": [
              "220130508"
            ]
          },
          "220130508": {
            "id": "220130508",
            "speakerId": 1004,
            "speakerName": "梨绘",
            "text": "而且那些能力的名字也越来越难念，我每次都没法完全记住。",
            "nextDialogs": [
              "220130509"
            ]
          },
          "220130509": {
            "id": "220130509",
            "speakerId": 1004,
            "speakerName": "梨绘",
            "text": "但如果勉强往后看的话，那些看不懂的能力又会让我没法理解剧情。",
            "nextDialogs": [
              "220130510"
            ]
          },
          "220130510": {
            "id": "220130510",
            "speakerId": 1004,
            "speakerName": "梨绘",
            "text": "唉，我都想要暂时先不看这本小说，换一本稍微容易理解点的书了。",
            "nextDialogs": [
              "220130511"
            ]
          },
          "220130511": {
            "id": "220130511",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "呃…我…",
            "nextDialogs": [
              "220130512"
            ]
          },
          "220130512": {
            "id": "220130512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们还是回去吧…",
            "nextDialogs": [
              "220130513"
            ]
          },
          "220130513": {
            "id": "220130513",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "好的…怎么会这样…"
          }
        }
      }
    },
    {
      "subId": "2201305",
      "subQuestName": "向阿茂回报结果",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220130601"
        ],
        "dialogs": {
          "220130601": {
            "id": "220130601",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "结果如何？你们问到读者的…",
            "nextDialogs": [
              "220130602"
            ]
          },
          "220130602": {
            "id": "220130602",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "…这家伙怎么和被雷劈了一样，你们到底听到什么反馈了？",
            "nextDialogs": [
              "220130603"
            ]
          },
          "220130603": {
            "id": "220130603",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "你啊…喂，现在你应该正视那些反馈了吧，顺吉？",
            "nextDialogs": [
              "220130604"
            ]
          },
          "220130604": {
            "id": "220130604",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "真没想到，怎么会这样…",
            "nextDialogs": [
              "220130605"
            ]
          },
          "220130605": {
            "id": "220130605",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "难道我的构思…我的写作方法，真的不够吸引人吗？",
            "nextDialogs": [
              "220130606"
            ]
          },
          "220130606": {
            "id": "220130606",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "我都说了，这种纯靠增加设定推进剧情的方式是很危险的…",
            "nextDialogs": [
              "220130607"
            ]
          },
          "220130607": {
            "id": "220130607",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "就算可以用那些新鲜的能力设定得到一时的追捧，但只要那股新鲜劲一过，读者们就会加倍地厌倦。",
            "nextDialogs": [
              "220130608"
            ]
          },
          "220130608": {
            "id": "220130608",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "这可是我从业的这些年里总结的经验啊。",
            "nextDialogs": [
              "220130609"
            ]
          },
          "220130609": {
            "id": "220130609",
            "speakerId": 1001,
            "speakerName": "顺吉",
            "text": "我、我知道了…",
            "nextDialogs": [
              "220130610"
            ]
          },
          "220130610": {
            "id": "220130610",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "好在现在改还来得及…虽然没法扭转之前几章的评价了，但至少，把后面的章节踏实地写好吧…",
            "nextDialogs": [
              "220130611"
            ]
          },
          "220130611": {
            "id": "220130611",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "谢谢你，旅行者，让这家伙现在受点打击也是好事，要是一直让他这么写下去，他一定会捅出更大的娄子。",
            "nextDialogs": [
              "220130612"
            ]
          },
          "220130612": {
            "id": "220130612",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "谢谢你旅行者，这些报酬给你，请收下吧。"
          }
        }
      }
    },
    {
      "subId": "2201302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220130201"
        ],
        "dialogs": {
          "220130201": {
            "id": "220130201",
            "speakerId": 1000,
            "speakerName": "阿茂",
            "text": "旅行者，全靠你了，请如实记录大家的看法啊！"
          }
        }
      }
    }
  ]
}
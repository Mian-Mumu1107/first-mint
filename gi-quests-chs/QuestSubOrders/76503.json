  "subQuests": [
    {
      "subId": "7650301",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "765030101"
        ],
        "dialogs": {
          "765030101": {
            "id": "765030101",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "#哦？是{NICKNAME}和派蒙两位。没想到会在如此偏僻的地方与你们重逢。",
            "nextDialogs": [
              "765030102"
            ]
          },
          "765030102": {
            "id": "765030102",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "你们是追寻着某种线索而来，还是意外地迷路至此？",
            "nextDialogs": [
              "765030105"
            ]
          },
          "765030105": {
            "id": "765030105",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "原来如此。从这艘废船的甲板望去，月矩力试验设计局那庞大的轮廓，确实有种…异样的壮观，如同蛰伏的巨兽。",
            "nextDialogs": [
              "765030106"
            ]
          },
          "765030106": {
            "id": "765030106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是啊，光是这样远远地看着，都很有压迫力呢。不知道里面到底藏着多少秘密…",
            "nextDialogs": [
              "765030107"
            ]
          },
          "765030107": {
            "id": "765030107",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "嗯，对于寻求独特素材的你们而言，它能提供不少的灵感。",
            "nextDialogs": [
              "765030108"
            ]
          },
          "765030108": {
            "id": "765030108",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "毕竟，光明与黑暗的交界，往往最能诞生引人入胜的故事。",
            "nextDialogs": [
              "765030109"
            ]
          },
          "765030109": {
            "id": "765030109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，菲林斯站在这里，身边总伴着那盏幽蓝的灯，看起来就很有故事性呢！",
            "nextDialogs": [
              "765030110"
            ]
          },
          "765030110": {
            "id": "765030110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，你今天不用驻守在…呃…那个地方吗？是在休假？还是在巡逻？",
            "nextDialogs": [
              "765030111"
            ]
          },
          "765030111": {
            "id": "765030111",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "算是两者兼而有之吧。守望那些可能从阴影中滋生的灾祸，便是我们「执灯士」永恒的职责。无论身处何地，这份警惕都不能松懈。",
            "nextDialogs": [
              "765030112"
            ]
          },
          "765030112": {
            "id": "765030112",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "不过，目前为止，此地的气息还算平稳。你们大可不必过于紧张，安心进行你们的创作吧。"
          }
        }
      }
    },
    {

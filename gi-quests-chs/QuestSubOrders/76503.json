            "id": "765030501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题，我们开始留影吧！"
          }
        }
      }
    },
    {
      "subId": "7650306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "765030601"
        ],
        "dialogs": {
          "765030601": {
            "id": "765030601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请稍等，我再找找灵感。"
          }
        }
      }
    },
    {
      "subId": "7650307",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "765030701"
        ],
        "dialogs": {
          "765030701": {
            "id": "765030701",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "#哦？是{NICKNAME}和派蒙两位。你们是追寻着某种线索而来，还是意外地迷路至此？",
            "nextDialogs": [
              "765030704"
            ]
          },
          "765030704": {
            "id": "765030704",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "原来如此。希望这座沉默的庞然大物，能为你提供些许灵感。",
            "nextDialogs": [
              "765030705"
            ]
          },
          "765030705": {
            "id": "765030705",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "不过，我似乎并未在你身上看到留影机的踪影。是遗落在别处了吗?"
          }
        }
      }
    },
    {
      "subId": "7650308",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "765030801"
        ],
        "dialogs": {
          "765030801": {
            "id": "765030801",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "看你们的神情，似乎还在寻找合适的拍摄素材？时间尚有余裕，真正的佳作往往诞生于不经意间的灵感。",
            "nextDialogs": [
              "765030804"
            ]
          },
          "765030804": {
            "id": "765030804",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "看来你已有所得。不过，我似乎并未在你身上看到留影机的踪影。是遗落在别处了吗?"
          }
        }
      }
    }

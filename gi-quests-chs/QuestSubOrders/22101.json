  "subQuests": [
    {
      "subId": "2210101",
      "subQuestName": "与淮安对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221010101"
        ],
        "dialogs": {
          "221010101": {
            "id": "221010101",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "没完没了…",
            "nextDialogs": [
              "221010102"
            ]
          },
          "221010102": {
            "id": "221010102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "221010103"
            ]
          },
          "221010103": {
            "id": "221010103",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "唉，在这里开个客栈可不容易…",
            "nextDialogs": [
              "221010104"
            ]
          },
          "221010104": {
            "id": "221010104",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "不知道是不是我的错觉…总觉得周围的那些怪物，是越来越多了。",
            "nextDialogs": [
              "221010105"
            ]
          },
          "221010105": {
            "id": "221010105",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "虽然它们也不会靠近客栈，但是客人总要进出，来往道路上的千岩军也不可能时刻把守。",
            "nextDialogs": [
              "221010106"
            ]
          },
          "221010106": {
            "id": "221010106",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "如果有空的话，你能帮我去周围看看，把客栈旁边的怪物给清一清吗？",
            "nextDialogs": [
              "221010109",
              "221010110"
            ]
          },
          "221010109": {
            "id": "221010109",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "哈哈，您说话做事真是爽利。",
            "nextDialogs": [
              "221010113"
            ]
          },
          "221010113": {
            "id": "221010113",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "让您受累，实在是有些不好意思。",
            "nextDialogs": [
              "221010114"
            ]
          },
          "221010114": {
            "id": "221010114",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "事结之后，报酬我绝不会少您一分的，请您放心。",
            "nextDialogs": [
              "221010115"
            ]
          },
          "221010115": {
            "id": "221010115",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "那么，就万事拜托了。"
          },
          "221010110": {
            "id": "221010110",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "在这种地方开客栈，这种问题也免不了。",
            "nextDialogs": [
              "221010111"
            ]
          },
          "221010111": {
            "id": "221010111",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "不过，要是没了我们这家客栈，那野外的行人去哪落脚呢？",
            "nextDialogs": [
              "221010112"
            ]
          },
          "221010112": {
            "id": "221010112",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "虽然累，不过开着也是好事吧。"
          }
        }
      }
    },
    {
      "subId": "2210102",
      "subQuestName": "清剿附近的魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221010201"
        ],
        "dialogs": {
          "221010201": {
            "id": "221010201",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "怎么样？周围的怪物都清干净了吗？",
            "nextDialogs": [
              "221010202"
            ]
          },
          "221010202": {
            "id": "221010202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有。",
            "nextDialogs": [
              "221010203"
            ]
          },
          "221010203": {
            "id": "221010203",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "倒也不用太着急，那些个怪物也顶多敢骚扰骚扰来往进出的人，不敢进客栈来。",
            "nextDialogs": [
              "221010204"
            ]
          },
          "221010204": {
            "id": "221010204",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "就算是有三五只胆子大的进来了，唔…我倒也能赶出去，客人不用担心。",
            "nextDialogs": [
              "221010205"
            ]
          },
          "221010205": {
            "id": "221010205",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "哈哈哈，在这郊外开客栈，会点拳脚防防身，也是很正常的嘛。"
          }
        }
      }
    },
    {
      "subId": "2210103",
      "subQuestName": "向淮安回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221010301"
        ],
        "dialogs": {
          "221010301": {
            "id": "221010301",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "怎么样？周围的怪物都清干净了吗？",
            "nextDialogs": [
              "221010302"
            ]
          },
          "221010302": {
            "id": "221010302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经清干净了。",
            "nextDialogs": [
              "221010303"
            ]
          },
          "221010303": {
            "id": "221010303",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "那就好，辛苦您了。",
            "nextDialogs": [
              "221010304"
            ]
          },
          "221010304": {
            "id": "221010304",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "这是报酬，您收好了。",
            "nextDialogs": [
              "221010305"
            ]
          },
          "221010305": {
            "id": "221010305",
            "speakerId": 2202,
            "speakerName": "淮安",
            "text": "这年头真是…开个客栈，不会功夫都不行。"
          }
        }
      }
    }
  ]
}
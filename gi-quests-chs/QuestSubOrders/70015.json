        "dialogs": {
          "700150101": {
            "id": "700150101",
            "speakerId": 1000,
            "speakerName": "思索的丘丘人",
            "text": "Emmm…Yoyo, ika? Tomo?",
            "nextDialogs": [
              "700150102"
            ]
          },
          "700150102": {
            "id": "700150102",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "Mimi tomo.",
            "nextDialogs": [
              "700150103"
            ]
          },
          "700150103": {
            "id": "700150103",
            "speakerId": 1000,
            "speakerName": "思索的丘丘人",
            "text": "Tomo tomo. Tomo dala si? domu nye, ika nye.",
            "nextDialogs": [
              "700150104"
            ]
          },
          "700150104": {
            "id": "700150104",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "Ye muhe dala? Mimi mani ye.",
            "nextDialogs": [
              "700150105"
            ]
          },
          "700150105": {
            "id": "700150105",
            "speakerId": 1000,
            "speakerName": "思索的丘丘人",
            "text": "Ya tomo mani, mani yaya tome nye… Mi muhe du, du <color=#00E1FFFF>lata boya sada</color> si.",
            "nextDialogs": [
              "700150106"
            ]
          },
          "700150106": {
            "id": "700150106",
            "speakerId": 1001,
            "speakerName": "艾拉·马斯克",
            "text": "它应该是想要什么东西…唔，我的手册上应该有记录，不如查一查吧？"
          }
        }
      }
    },
    {
      "subId": "7001502",

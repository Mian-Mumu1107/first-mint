          "700150302": {
            "id": "700150302",
            "speakerId": 1000,
            "speakerName": "思索的丘丘人",
            "text": "Odomu tomo zido mi! <color=#00E1FFFF>Unta mosi dada</color>！",
            "nextDialogs": [
              "700150303"
            ]
          },
          "700150303": {
            "id": "700150303",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "<color=#00E1FFFF>Unta mosi dada</color>…好像之前听过这句话的样子…不如查查看吧？",
            "nextDialogs": [
              "700150306"
            ]
          },
          "700150306": {
            "id": "700150306",
            "speakerId": 1000,
            "speakerName": "思索的丘丘人",
            "text": "Valo, mi tomo!",
            "nextDialogs": [
              "700150307"
            ]
          },
          "700150307": {
            "id": "700150307",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "Valo!"
          }
        }
      }

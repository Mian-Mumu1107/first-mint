{
  "lineCounts": {
    "Player": 16,
    "沐宁": 17,
    "派蒙": 5,
    "阿旭": 24
  },
  "subQuests": [
    {
      "subId": "7104901",
      "subQuestName": "test隐藏-跟阿旭对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710490101"
        ],
        "dialogs": {
          "710490101": {
            "id": "710490101",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "啊，是少爷的朋友。您好！",
            "nextDialogs": [
              "710490102"
            ]
          },
          "710490102": {
            "id": "710490102",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "实在是不好意思，但我有一事相求，不知您是否方便相助？",
            "nextDialogs": [
              "710490105"
            ]
          },
          "710490105": {
            "id": "710490105",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "是这样的，我有一位朋友名叫沐宁，此前经常照顾我们飞云商会的生意。",
            "nextDialogs": [
              "710490106"
            ]
          },
          "710490106": {
            "id": "710490106",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "只是最近他在岩上茶室欠了点小钱，只好找我们少爷借钱救急…",
            "nextDialogs": [
              "710490107"
            ]
          },
          "710490107": {
            "id": "710490107",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "结果呢，少爷二话不说就把钱借出去了，连利息也不要！唉，这豪爽的脾气呀…可别太用在生意上…",
            "nextDialogs": [
              "710490108"
            ]
          },
          "710490108": {
            "id": "710490108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "行侠仗义嘛，这不是好事吗？",
            "nextDialogs": [
              "710490109"
            ]
          },
          "710490109": {
            "id": "710490109",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "事倒是好事，不过您看…行秋少爷外出行侠了，我这边忙于家务又脱不开身。这用钱之事，大家都能信得过的就只有您了。",
            "nextDialogs": [
              "710490110"
            ]
          },
          "710490110": {
            "id": "710490110",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "他就在层岩巨渊当班，吃住都在那边，你不会认错人的。"
          }
        }
      }
    },
    {
      "subId": "7104902",
      "subQuestName": "找到总务司专员「沐宁」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710440501"
        ],
        "dialogs": {
          "710440501": {
            "id": "710440501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于层岩巨渊…",
            "nextDialogs": [
              "710440502"
            ]
          },
          "710440502": {
            "id": "710440502",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "对了，关于层岩巨渊…如果你们暂时不想离开的话，就请四处转转吧。但请一定遵守璃月的律法。",
            "nextDialogs": [
              "710440503"
            ]
          },
          "710440503": {
            "id": "710440503",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "顺便一提，有的地方，我强烈不建议你们接近。",
            "nextDialogs": [
              "710440504"
            ]
          },
          "710440504": {
            "id": "710440504",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "就比如说，层岩巨渊中央的大矿井被布下了「七星阵法」…呃，顾名思义，就是七星布下的阵法。",
            "nextDialogs": [
              "710440505"
            ]
          },
          "710440505": {
            "id": "710440505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这解释还挺…简单明确的。",
            "nextDialogs": [
              "710440506"
            ]
          },
          "710440506": {
            "id": "710440506",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "阵法的弱点…呃，节点，在于周围的「磐键」。它们由「七星」之手亲自布下，串联并固定了阵法中流动的能量。",
            "nextDialogs": [
              "710440507"
            ]
          },
          "710440507": {
            "id": "710440507",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "近来磐键周围的岩元素聚合物异常增生，就像下面的「东西」在渴望冒出头来一样…",
            "nextDialogs": [
              "710440508"
            ]
          },
          "710440508": {
            "id": "710440508",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "…算了，请不要在意我的自言自语。总之事情就是这样，请一定、一定不要靠近「七星阵法」，也不要想着下去探险什么的。",
            "nextDialogs": [
              "710440509"
            ]
          },
          "710440509": {
            "id": "710440509",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "「磐键」的结构也完全没有发生衰变，周围的岩元素聚合物自然不会产生奇奇怪怪的反应，所以请别想从中下功夫。",
            "nextDialogs": [
              "710440510"
            ]
          },
          "710440510": {
            "id": "710440510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是…",
            "nextDialogs": [
              "710440511"
            ]
          },
          "710440511": {
            "id": "710440511",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "哼，我知道你想问什么。",
            "nextDialogs": [
              "710440512"
            ]
          },
          "710440512": {
            "id": "710440512",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "下面可不会有什么珍奇异宝，也不会有什么史前化石，更不会有什么超级巨大古代遗迹的…请你们不要抱虚假的期待。",
            "nextDialogs": [
              "710440513"
            ]
          },
          "710440513": {
            "id": "710440513",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你这么说就好可疑！",
            "nextDialogs": [
              "710440514"
            ]
          },
          "710440514": {
            "id": "710440514",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "下面连蘑菇都不会长的！不会有实现人愿望的石头，更不会有只靠吃蘑菇就能增肌的水手！请你们不要抱有虚假的期待！",
            "nextDialogs": [
              "710440515"
            ]
          },
          "710440515": {
            "id": "710440515",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，知道啦！不要这么凶嘛！",
            "nextDialogs": [
              "710440520",
              "710440518"
            ]
          },
          "710440520": {
            "id": "710440520",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "我建议你们先去找志琼聊一聊，她是受雇于总务司的冒险家，曾经在这里做过矿工，对层岩巨渊的地形了如指掌…",
            "nextDialogs": [
              "710440521"
            ]
          },
          "710440521": {
            "id": "710440521",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "…稍等，我给你开一个凭条。她看见凭条，自然会明白你是可以信赖的。",
            "nextDialogs": [
              "710440522"
            ]
          },
          "710440522": {
            "id": "710440522",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "当然！我事先警告你们，志琼可不是那种一点也不安分，整天到处乱跑的人，也从来不会想解开阵法一头钻进地下！",
            "nextDialogs": [
              "710440523"
            ]
          },
          "710440523": {
            "id": "710440523",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "更不可能纠集一群无所事事的冒险者，旁若无人地深入险地！所以请不要指望她能帮你进入层岩巨渊矿坑。"
          },
          "710440518": {
            "id": "710440518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯！我们走吧！",
            "nextDialogs": [
              "710440519"
            ]
          },
          "710440519": {
            "id": "710440519",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "等等，我还没说完呢！"
          }
        }
      }
    },
    {
      "subId": "7104902",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710490201"
        ],
        "dialogs": {
          "710490201": {
            "id": "710490201",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "实在抱歉，家事繁忙，有什么事情还请您等一等再说吧！",
            "nextDialogs": [
              "710490203",
              "710490208",
              "710490213"
            ]
          },
          "710490203": {
            "id": "710490203",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "哦哦，您瞧我这脑子…没给您介绍清楚层岩巨渊怎么回事，就把您给使唤了！真是不应该！",
            "nextDialogs": [
              "710490204"
            ]
          },
          "710490204": {
            "id": "710490204",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "其实我也说不太明白，也就是前些年的事吧…说是那边的矿工挖到了什么怪东西…是什么咱也不知道，也不敢打听。",
            "nextDialogs": [
              "710490205"
            ]
          },
          "710490205": {
            "id": "710490205",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "辉山厅上报七星以后，凝光大人的秘书派出了一支调查队，回来就说有什么重大安全隐患，非要关闭矿坑不行…",
            "nextDialogs": [
              "710490206"
            ]
          },
          "710490206": {
            "id": "710490206",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "结果呢，层岩巨渊就成了现在这样了。盛露厅的大人们天天打听什么时候重开，可七星就是不许，也只能干着急…"
          },
          "710490208": {
            "id": "710490208",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "他呀，他家是瓷业大户，在盛露厅排得上号的那种。只不过他对家族生意没什么兴趣，只由着性子爱吃爱玩…",
            "nextDialogs": [
              "710490209"
            ]
          },
          "710490209": {
            "id": "710490209",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "这家伙也不懂经营理财，欠了不少的债…他家怕他坏了产业的名声，就送他去总务司作为代表历练一番…",
            "nextDialogs": [
              "710490210"
            ]
          },
          "710490210": {
            "id": "710490210",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "而总务司也需要盛露厅有一个管事的专业人士来监察层岩巨渊，于是就起用了他做专员。",
            "nextDialogs": [
              "710490211"
            ]
          },
          "710490211": {
            "id": "710490211",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "要我说呀，是好事。按我老爹的说法，层岩巨渊是能历练人的。他年轻时就在那里下过矿…"
          },
          "710490213": {
            "id": "710490213",
            "speakerId": 1627,
            "speakerName": "阿旭",
            "text": "好的，您慢走。"
          }
        }
      }
    }
  ]
}
    {
      "subId": "2502504",
      "subQuestName": "尝试和懒懒的小鳍游龙交流",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250250401"
        ],
        "dialogs": {
          "250250401": {
            "id": "250250401",
            "speakerId": 14270,
            "speakerName": "懒懒的鳍游龙",
            "text": "呜…？呜呜，呜…",
            "nextDialogs": [
              "250250403",
              "250250406",
              "250250409"
            ]
          },
          "250250403": {
            "id": "250250403",
            "speakerId": 14270,
            "speakerName": "懒懒的鳍游龙",
            "text": "呜？呜！呜呜——",
            "nextDialogs": [
              "250250404"
            ]
          },
          "250250404": {
            "id": "250250404",
            "speakerId": 14270,
            "speakerName": "懒懒的鳍游龙",
            "text": "（小鳍游龙似乎很高兴的样子，乖乖待在岸边，这样应该就能把它抱到岸上了…）",
            "nextDialogs": [
              "250250412"
            ]
          },
          "250250412": {
            "id": "250250412",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "小鳍游龙总算安静了下来。你小心翼翼地把它抱上了岸…"
          },
          "250250406": {
            "id": "250250406",
            "speakerId": 14270,
            "speakerName": "懒懒的鳍游龙",
            "text": "呜呜？呜呜——",
            "nextDialogs": [
              "250250407"
            ]
          },
          "250250407": {
            "id": "250250407",
            "speakerId": 14270,
            "speakerName": "懒懒的鳍游龙",
            "text": "（小鳍游龙似乎很高兴的样子，乖乖待在岸边，这样应该就能把它抱到岸上了…）"
          },
          "250250409": {
            "id": "250250409",
            "speakerId": 14270,
            "speakerName": "懒懒的鳍游龙",
            "text": "呜！呜，呜呜！",
            "nextDialogs": [
              "250250410"
            ]
          },
          "250250410": {
            "id": "250250410",
            "speakerId": 14270,
            "speakerName": "懒懒的鳍游龙",
            "text": "（小鳍游龙似乎不太高兴，泼得你满脸是水。）",
            "nextDialogs": [
              "250250411"
            ]
          },
          "250250411": {
            "id": "250250411",
            "speakerId": 14270,
            "speakerName": "懒懒的鳍游龙",
            "text": "（小鳍游龙期待地看着你。最好换一个方法再哄哄它…）"
          }
        }
      }
    },
    {
      "subId": "2502511",
      "subQuestName": "(test)隐藏任务：人形交互$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250251101"
        ],
        "dialogs": {
          "250251101": {
            "id": "250251101",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "你是玩开心了，我可得回去换一身衣服了…",
            "nextDialogs": [
              "250251102"
            ]
          },
          "250251102": {
            "id": "250251102",
            "speakerId": 14270,
            "speakerName": "懒懒的鳍游龙",
            "text": "呜呜！呜——",
            "nextDialogs": [
              "250251103"
            ]
          },
          "250251103": {
            "id": "250251103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么全身都湿透了…",
            "nextDialogs": [
              "250251104"
            ]
          },
          "250251104": {
            "id": "250251104",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "咳，陪着这孩子好好玩了一场，它总算是肯听话上来了。",
            "nextDialogs": [
              "250251105"
            ]
          },
          "250251105": {
            "id": "250251105",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "你已经收拾好那边的温泉了吧？真是多谢你了，这些东西给你，就当做是报酬吧。",
            "nextDialogs": [
              "250251106"
            ]
          },
          "250251106": {
            "id": "250251106",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "等我收拾好其他温泉，可得回去换一身…咦？那孩子去哪了？",
            "nextDialogs": [
              "250251107"
            ]
          },
          "250251107": {
            "id": "250251107",
            "speakerId": 14270,
            "speakerName": "懒懒的鳍游龙",
            "text": "呜！呜——",
            "nextDialogs": [
              "250251108"
            ]
          },
          "250251108": {
            "id": "250251108",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "喂！回来！那边的温泉还没收拾好啊！",
            "nextDialogs": [
              "250251109"
            ]
          },
          "250251109": {
            "id": "250251109",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "小鳍游龙欢快地跳向了另一口温泉，佩蕾·努伊在后面大喊着追了上去…"
          }
        }
      }
    },
    {
      "subId": "2502512",
      "subQuestName": "(test)隐藏任务：龙形交互$HIDDEN",
      "sceneId": null,

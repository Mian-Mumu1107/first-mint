  "subQuests": [
    {
      "subId": "2502501",
      "subQuestName": "与佩蕾·努伊对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250250201"
        ],
        "dialogs": {
          "250250201": {
            "id": "250250201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我来试试把它哄出来吧。",
            "nextDialogs": [
              "250250202"
            ]
          },
          "250250202": {
            "id": "250250202",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "唔…行啊。换个人去哄也是一种方法。那就拜托你了。",
            "nextDialogs": [
              "250250203"
            ]
          },
          "250250203": {
            "id": "250250203",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "这孩子也不知道是怎么了。明明之前我只要摸摸它的<color=#00E1FFFF>头</color>或者<color=#00E1FFFF>肚子</color>，就能乖乖听话…"
          }
        }
      }
    },

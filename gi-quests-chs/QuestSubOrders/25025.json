    {
      "subId": "2502501",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250250101"
        ],
        "dialogs": {
          "250250101": {
            "id": "250250101",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "拜托啦，稍微上岸来一下好不好？我要打扫这边的池子。",
            "nextDialogs": [
              "250250102"
            ]
          },
          "250250102": {
            "id": "250250102",
            "speakerId": 14270,
            "speakerName": "懒懒的鳍游龙",
            "text": "呜…",
            "nextDialogs": [
              "250250103"
            ]
          },
          "250250103": {
            "id": "250250103",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "乖孩子，上来啦。不然我可要把你抱上来了！",
            "nextDialogs": [
              "250250104"
            ]
          },
          "250250104": {
            "id": "250250104",
            "speakerId": 14270,
            "speakerName": "懒懒的鳍游龙",
            "text": "呜！",
            "nextDialogs": [
              "250250105"
            ]
          },
          "250250105": {
            "id": "250250105",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "呜哇…一下子就游走了，这怎么能抱住它呢…",
            "nextDialogs": [
              "250250106"
            ]
          },
          "250250106": {
            "id": "250250106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么呢？",
            "nextDialogs": [
              "250250107"
            ]
          },
          "250250107": {
            "id": "250250107",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "欸？你是来泡温泉的吗？不好意思，我正在清理这边的池子，可能你要稍等一会了。",
            "nextDialogs": [
              "250250108"
            ]
          },
          "250250108": {
            "id": "250250108",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "而且，这孩子说什么也不肯上岸来。唉…我还有很多池子要清理啊。",
            "nextDialogs": [
              "250250109"
            ]
          },
          "250250109": {
            "id": "250250109",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "难道是我前几天强行把它抱出来，让这孩子生气了吗？真是难搞…"
          }
        }
      }
    },

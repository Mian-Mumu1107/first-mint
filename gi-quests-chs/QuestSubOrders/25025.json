    {
      "subId": "2502503",
      "subQuestName": "(test)隐藏任务：选择了打扫温泉$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250250301"
        ],
        "dialogs": {
          "250250301": {
            "id": "250250301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我帮忙去清理其他池子吧。",
            "nextDialogs": [
              "250250302"
            ]
          },
          "250250302": {
            "id": "250250302",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "你愿意帮忙？那真是太好了，我真的忙不过来了。",
            "nextDialogs": [
              "250250303"
            ]
          },
          "250250303": {
            "id": "250250303",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "唔…那就请你先去清理那边的池子吧。",
            "nextDialogs": [
              "250250304"
            ]
          },
          "250250304": {
            "id": "250250304",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "我前几天已经清理过池底了，你只需要把浮在温泉上的那些杂物拣出来就行。",
            "nextDialogs": [
              "250250305"
            ]
          },
          "250250305": {
            "id": "250250305",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "那就拜托你了，我继续哄这孩子。",
            "nextDialogs": [
              "250250306"
            ]
          },
          "250250306": {
            "id": "250250306",
            "speakerId": 6063,
            "speakerName": "佩蕾·努伊",
            "text": "唉…这孩子也不知道是怎么了。明明之前我只要摸摸它的头或者肚子，就能乖乖听话…"
          }
        }
      }

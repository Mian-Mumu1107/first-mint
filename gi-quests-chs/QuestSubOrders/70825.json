    {
      "subId": "7082504",
      "subQuestName": "前往巡查，并清除障碍物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708250401"
        ],
        "dialogs": {
          "708250401": {
            "id": "708250401",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "唉，要是能再多点人就好了…",
            "nextDialogs": [
              "708250403",
              "708250407"
            ]
          },
          "708250403": {
            "id": "708250403",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "保持城防、协助城内各种修缮事务，还有一些杂七杂八的事务。",
            "nextDialogs": [
              "708250404"
            ]
          },
          "708250404": {
            "id": "708250404",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "现在骑士团总部里每个人都忙得脚不沾地。",
            "nextDialogs": [
              "708250405"
            ]
          },
          "708250405": {
            "id": "708250405",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "这么一比，在门口站岗反而算是个轻松的活了。"
          },
          "708250407": {
            "id": "708250407",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "他们早就在帮忙了，最开始在城里不断搜索受灾的人们，之后又负责监视野外的魔物。",
            "nextDialogs": [
              "708250408"
            ]
          },
          "708250408": {
            "id": "708250408",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "魔物向城边聚集时，也是冒险家协会的各位冒险家们不断外出确认魔物动向，再回来报告，我们才能制订出具体的迎击计划。",
            "nextDialogs": [
              "708250409"
            ]
          },
          "708250409": {
            "id": "708250409",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "现在他们也在全力协助城内的各种工作，没了他们，西风骑士团只怕会独木难支吧。",
            "nextDialogs": [
              "708250410"
            ]
          },
          "708250410": {
            "id": "708250410",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "这么一说，我得找个机会好好谢谢塞琉斯了…"
          }
        }
      }
    },
    {
      "subId": "7082505",
      "subQuestName": "消灭所有魔物，并拆除魔物营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708250501"
        ],
        "dialogs": {
          "708250501": {
            "id": "708250501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "果然有很多东西堵在这里。这样子绝对走不了人吧…",
            "nextDialogs": [
              "708250502"
            ]
          },
          "708250502": {
            "id": "708250502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们快点把这些清理掉吧。",
            "nextDialogs": [
              "708250503"
            ]
          },
          "708250503": {
            "id": "708250503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这里还有，在那么短的时间里居然能建这么多，到底是怎么做到的…",
            "nextDialogs": [
              "708250504"
            ]
          },
          "708250504": {
            "id": "708250504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "算了，我们还是快点把这里清理一遍吧。",
            "nextDialogs": [
              "708250505"
            ]
          },
          "708250505": {
            "id": "708250505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么这么多，这群家伙到底筹划了多久啊…",
            "nextDialogs": [
              "708250506"
            ]
          },
          "708250506": {
            "id": "708250506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，不管怎么样，现在它们的计划已经全盘破灭了",
            "nextDialogs": [
              "708250507"
            ]
          },
          "708250507": {
            "id": "708250507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们把这里快速清理一遍吧。",
            "nextDialogs": [
              "708250508"
            ]
          },
          "708250508": {
            "id": "708250508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好了，这样应该就差不多了，我们回去告诉霍夫曼先生吧。"
          }
        }
      }
    },
    {
      "subId": "7082506",
      "subQuestName": "前往巡查，并清除障碍物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708250601"
        ],
        "dialogs": {
          "708250601": {
            "id": "708250601",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "怎么样，已经清理干净了吗？",
            "nextDialogs": [
              "708250602"
            ]
          },
          "708250602": {
            "id": "708250602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经清理干净了。",
            "nextDialogs": [
              "708250603"
            ]
          },
          "708250603": {
            "id": "708250603",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "太好了，实在是帮大忙了，没有你帮忙，那堆乱七八糟的东西不知道还要堆多久…",
            "nextDialogs": [
              "708250604"
            ]
          },
          "708250604": {
            "id": "708250604",
            "speakerId": 1218,
            "speakerName": "霍夫曼",
            "text": "荣誉骑士，请收下这些吧，感谢你的帮助。"
          }
        }
      }
    },

    {
      "subId": "7105101",
      "subQuestName": "将钓起的奇怪物件交给海迪夫鉴定$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710500501"
        ],
        "dialogs": {
          "710500501": {
            "id": "710500501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于奇怪的物件…",
            "nextDialogs": [
              "710500502"
            ]
          },
          "710500502": {
            "id": "710500502",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "嗯？这是你钓鱼钓到的，钓鱼？唔…这东西粗看起来倒像是我们钓鱼用的鱼饵。",
            "nextDialogs": [
              "710500503"
            ]
          },
          "710500503": {
            "id": "710500503",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "钓鱼是能钓出这种东西的活动吗…？阿妮萨学姐在海祇岛也天天钓鱼，没见到她钓出什么成果来啊。",
            "nextDialogs": [
              "710500504"
            ]
          },
          "710500504": {
            "id": "710500504",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "该说不愧是你吗？",
            "nextDialogs": [
              "710500505"
            ]
          },
          "710500505": {
            "id": "710500505",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "我看看，这个东西…能够感受到它有很可怕的水元素含量。",
            "nextDialogs": [
              "710500506"
            ]
          },
          "710500506": {
            "id": "710500506",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "层岩巨渊的地下水中，富含的元素量之多，确实有点不太正常…难道是因为有这些东西在地下水里生长的缘故吗？",
            "nextDialogs": [
              "710500507"
            ]
          },
          "710500507": {
            "id": "710500507",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "不过这个东西从水里拿出来以后，元素就在不断流失，说不定必须得放在水边才会有产生效果。",
            "nextDialogs": [
              "710500508"
            ]
          },
          "710500508": {
            "id": "710500508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "放在水边？",
            "nextDialogs": [
              "710500509"
            ]
          },
          "710500509": {
            "id": "710500509",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "放到水边，用水元素激活，大概就能知道这东西是什么作用了。",
            "nextDialogs": [
              "710500510"
            ]
          },
          "710500510": {
            "id": "710500510",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "这样吧，你去激活它，反正东西也是你钓上来的，发生什么事就告诉我吧。",
            "nextDialogs": [
              "710500511"
            ]
          },
          "710500511": {
            "id": "710500511",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "要是有什么研究价值的话，我会支付你报酬的。"
          }
        }
      }
    },

    {
      "subId": "7105103",
      "subQuestName": "击败出现的水岩龙蜥",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7105104",
      "subQuestName": "告诉海迪夫在水边发生的事",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710500801"
        ],
        "dialogs": {
          "710500801": {
            "id": "710500801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于放在水边的奇怪物件…",
            "nextDialogs": [
              "710500802"
            ]
          },
          "710500802": {
            "id": "710500802",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "嗯？你把那个东西放在水边了…",
            "nextDialogs": [
              "710500803"
            ]
          },
          "710500803": {
            "id": "710500803",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "怎么样，有发生什么特殊反应之类的吗？",
            "nextDialogs": [
              "710500804"
            ]
          },
          "710500804": {
            "id": "710500804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "出现了岩龙蜥…",
            "nextDialogs": [
              "710500805"
            ]
          },
          "710500805": {
            "id": "710500805",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "岩龙蜥？那个东西放到水里变成了岩龙蜥？",
            "nextDialogs": [
              "710500806"
            ]
          },
          "710500806": {
            "id": "710500806",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "哦，不是那个东西变成的，而是岩龙蜥看到那个东西之后就游出来了…",
            "nextDialogs": [
              "710500807"
            ]
          },
          "710500807": {
            "id": "710500807",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "吓了我一跳，要是这个东西入水直接变成岩龙蜥，那我的世界观的立柱都要崩塌了。",
            "nextDialogs": [
              "710500808"
            ]
          },
          "710500808": {
            "id": "710500808",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那个东西到底是…",
            "nextDialogs": [
              "710500809"
            ]
          },
          "710500809": {
            "id": "710500809",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "说来也简单，该怎么说明好呢，这样吧，让我先猜一猜，那只岩龙蜥，有没有什么特别之处…",
            "nextDialogs": [
              "710500810"
            ]
          },
          "710500810": {
            "id": "710500810",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "比如说，元素附着属性是水之类的？",
            "nextDialogs": [
              "710500812",
              "710500814"
            ]
          },
          "710500812": {
            "id": "710500812",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "那就对了。",
            "nextDialogs": [
              "710500816"
            ]
          },
          "710500816": {
            "id": "710500816",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "那只岩龙蜥应该可以调用水元素。",
            "nextDialogs": [
              "710500817"
            ]
          },
          "710500817": {
            "id": "710500817",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "层岩巨渊的地下水，水元素含量很高，特殊的聚集点就会养出类似你钓上来的水草一样的事物。",
            "nextDialogs": [
              "710500818"
            ]
          },
          "710500818": {
            "id": "710500818",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "岩龙蜥，当然了，其他生长在层岩巨渊的亲水生物也一样，靠食用这种富含水元素的水草来提升自己的力量。",
            "nextDialogs": [
              "710500819"
            ]
          },
          "710500819": {
            "id": "710500819",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "所以那个东西其实就是…富含水元素的水草！",
            "nextDialogs": [
              "710500820"
            ]
          },
          "710500820": {
            "id": "710500820",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "只是水草吗…",
            "nextDialogs": [
              "710500821"
            ]
          },
          "710500821": {
            "id": "710500821",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "嗯，就是水草，不过富有如此元素量的水草…",
            "nextDialogs": [
              "710500822"
            ]
          },
          "710500822": {
            "id": "710500822",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "正常环境可长不出来，除非有什么非常纯净又巨大的能量影响了水源…不说这个了，这些水草…",
            "nextDialogs": [
              "710500823"
            ]
          },
          "710500823": {
            "id": "710500823",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "说不定有一天也会生出意识变成元素生物，真是值得好好研究一番啊。"
          },
          "710500814": {
            "id": "710500814",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "#难道是因为解决得太快了所以根本没在意到吗…真是厉害啊，不愧是传说中的{NICKNAME}。",
            "nextDialogs": [
              "710500815"
            ]
          },
          "710500815": {
            "id": "710500815",
            "speakerId": 1000,
            "speakerName": "海迪夫",
            "text": "不过根据我的推测…"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "7503009",
      "subQuestName": "（test）踩圈触发对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750300303"
        ],
        "dialogs": {
          "750300303": {
            "id": "750300303",
            "speakerId": 1000,
            "speakerName": "被称作阿科米蒂的青年",
            "text": "出来就得跟你打架，我干嘛出来。而且我又没收你钱，只不过是随口答应着玩而已。",
            "nextDialogs": [
              "750300304"
            ]
          },
          "750300304": {
            "id": "750300304",
            "speakerId": 1000,
            "speakerName": "被称作阿科米蒂的青年",
            "text": "把幼龙偷来带给你是违规的，我又不傻。",
            "nextDialogs": [
              "750300305"
            ]
          },
          "750300305": {
            "id": "750300305",
            "speakerId": 1001,
            "speakerName": "愤怒的贩龙者",
            "text": "胆子倒是大啊，敢玩我？你就躲吧，我有的是耐心，反正也不会有人救你。",
            "nextDialogs": [
              "750300306"
            ]
          },
          "750300306": {
            "id": "750300306",
            "speakerId": 1000,
            "speakerName": "被称作阿科米蒂的青年",
            "text": "…你怎么知道没人救我？",
            "nextDialogs": [
              "750300307"
            ]
          },
          "750300307": {
            "id": "750300307",
            "speakerId": 1001,
            "speakerName": "愤怒的贩龙者",
            "text": "…哦？",
            "nextDialogs": [
              "750300308"
            ]
          },
          "750300308": {
            "id": "750300308",
            "speakerId": 1001,
            "speakerName": "愤怒的贩龙者",
            "text": "#臭小子，还真找了帮手？老子正在气头上，我连{M#他}{F#她}一起揍。",
            "nextDialogs": [
              "750300309"
            ]
          },
          "750300309": {
            "id": "750300309",
            "speakerId": 1000,
            "speakerName": "被称作阿科米蒂的青年",
            "text": "啊？还真有人来了？",
            "nextDialogs": [
              "750300310"
            ]
          },
          "750300310": {
            "id": "750300310",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#什么？怎么冲我们过来了，真是的，没办法，看你的了{NICKNAME}。"
          }
        }
      }
    },
    {
      "subId": "7503010",
      "subQuestName": "(test)隐藏判断是否有和龙A对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

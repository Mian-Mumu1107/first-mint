    {
      "subId": "7503015",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750301501"
        ],
        "dialogs": {
          "750301501": {
            "id": "750301501",
            "speakerId": 1007,
            "speakerName": "困倦的绒翼龙",
            "text": "有事吗？没事别来烦，忙着睡觉。",
            "nextDialogs": [
              "750301509",
              "750301508"
            ]
          },
          "750301509": {
            "id": "750301509",
            "speakerId": 1007,
            "speakerName": "困倦的绒翼龙",
            "text": "嗯？！来点来点。",
            "nextDialogs": [
              "750301510"
            ]
          },
          "750301510": {
            "id": "750301510",
            "speakerId": 1007,
            "speakerName": "困倦的绒翼龙",
            "text": "#就是这个口感，带劲！谢了，{M#哥儿们}{F#姐儿们}。",
            "nextDialogs": [
              "750301511"
            ]
          },
          "750301511": {
            "id": "750301511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你知道进地窖的路吗？",
            "nextDialogs": [
              "750301512"
            ]
          },
          "750301512": {
            "id": "750301512",
            "speakerId": 1007,
            "speakerName": "困倦的绒翼龙",
            "text": "多大点事，你不早说。走这儿就行，我给你把草垛弄开。"
          },
          "750301508": {
            "id": "750301508",
            "speakerId": 1007,
            "speakerName": "困倦的绒翼龙",
            "text": "睡了，有事找别龙。"
          }
        }
      }
    },
    {
      "subId": "7503017",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750301701"
        ],
        "dialogs": {
          "750301701": {
            "id": "750301701",
            "speakerId": 1007,
            "speakerName": "困倦的绒翼龙",
            "text": "困…困…"
          }
        }
      }
    },
    {
      "subId": "7503018",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750301801"
        ],
        "dialogs": {
          "750301801": {
            "id": "750301801",
            "speakerId": 1004,
            "speakerName": "忧愁的绒翼龙",
            "text": "愁死龙了，该拿阿科米蒂怎么办哟。"
          }
        }
      }
    },
    {
      "subId": "7503019",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750301901"
        ],
        "dialogs": {
          "750301901": {
            "id": "750301901",
            "speakerId": 1007,
            "speakerName": "困倦的绒翼龙",
            "text": "咳…咳…颗粒果卡嗓子了…咳。"
          }
        }
      }
    },
    {
      "subId": "7503020",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750302001"
        ],
        "dialogs": {
          "750302001": {
            "id": "750302001",
            "speakerId": 1004,
            "speakerName": "忧愁的绒翼龙",
            "text": "照顾人类太累龙了，我的天。"
          }
        }
      }
    },
    {
      "subId": "7503021",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750302101"
        ],
        "dialogs": {
          "750302101": {
            "id": "750302101",
            "speakerId": 1005,
            "speakerName": "地窖",
            "text": "别费劲了，就算我告诉你们营地里有两条路直通地窖，<color=#00E1FFFF>但知道这两条路的也只有龙</color>，你们不可能有办法，还是走吧。",
            "nextDialogs": [
              "750302102"
            ]
          },
          "750302102": {
            "id": "750302102",
            "speakerId": 1005,
            "speakerName": "地窖",
            "text": "（窸窸窣窣的声音停止了，下方不再传来响动。）"
          }
        }
      }
    },

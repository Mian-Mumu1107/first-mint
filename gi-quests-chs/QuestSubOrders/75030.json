      }
    },
    {
      "subId": "7503012",
      "subQuestName": "(test)隐藏与地窖对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750300601"
        ],
        "dialogs": {
          "750300601": {
            "id": "750300601",
            "speakerId": 1005,
            "speakerName": "地窖",
            "text": "（下方传来窸窸窣窣的响动，似乎有人躲在这里。）",
            "nextDialogs": [
              "750300602"
            ]
          },
          "750300602": {
            "id": "750300602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "喂，有人吗？",
            "nextDialogs": [
              "750300603"
            ]
          },
          "750300603": {
            "id": "750300603",
            "speakerId": 1005,
            "speakerName": "地窖",
            "text": "……",
            "nextDialogs": [
              "750300604"
            ]
          },
          "750300604": {
            "id": "750300604",
            "speakerId": 1000,
            "speakerName": "被称作阿科米蒂的青年",
            "text": "是谁？",
            "nextDialogs": [
              "750300605"
            ]
          },
          "750300605": {
            "id": "750300605",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我们把龙贩子赶走了，你可以出来了。",
            "nextDialogs": [
              "750300606"
            ]
          },
          "750300606": {
            "id": "750300606",
            "speakerId": 1000,
            "speakerName": "被称作阿科米蒂的青年",
            "text": "…还是不了，就让我自己在地窖里待着吧。",
            "nextDialogs": [
              "750300607"
            ]
          },
          "750300607": {
            "id": "750300607",
            "speakerId": 1000,
            "speakerName": "被称作阿科米蒂的青年",
            "text": "谢谢你们帮忙，我也没什么好礼物可以拿来答谢你们。",
            "nextDialogs": [
              "750300608"
            ]
          },
          "750300608": {
            "id": "750300608",
            "speakerId": 1000,
            "speakerName": "被称作阿科米蒂的青年",
            "text": "不嫌弃的话，我在营地里存了点东西，你们随便拿吧。",
            "nextDialogs": [
              "750300609"
            ]
          },
          "750300609": {
            "id": "750300609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不解释一下吗？",
            "nextDialogs": [
              "750300610"
            ]
          },
          "750300610": {
            "id": "750300610",
            "speakerId": 1000,
            "speakerName": "被称作阿科米蒂的青年",
            "text": "害你们被这种无聊的事卷进来，我很抱歉，不过说了也没什么意思，算了吧。",
            "nextDialogs": [
              "750300611"
            ]
          },
          "750300611": {
            "id": "750300611",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#这是什么解释啊，我和{NICKNAME}在路上走得好好的，突然就有人喊着「我连你一起揍」就冲过来了。",
            "nextDialogs": [
              "750300612"
            ]
          },
          "750300612": {
            "id": "750300612",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#如果{M#他}{F#她}反应慢一点，我们就会受伤，不对，已经受伤了，我们的精神受到了冲击。",
            "nextDialogs": [
              "750300615"
            ]
          },
          "750300615": {
            "id": "750300615",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怎么想都很严重吧？我们好歹也是冒险家协会登记在册的知名冒险家，受协会保护，我们要求一个解释！",
            "nextDialogs": [
              "750300616"
            ]
          },
          "750300616": {
            "id": "750300616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（协会会保护我们吗？）",
            "nextDialogs": [
              "750300617"
            ]
          },
          "750300617": {
            "id": "750300617",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "（其实我也不知道，按之前的经验来看，我怀疑不会。）",
            "nextDialogs": [
              "750300618"
            ]
          },
          "750300618": {
            "id": "750300618",
            "speakerId": 1000,
            "speakerName": "被称作阿科米蒂的青年",
            "text": "这…我也不是故意的，怪我做什么…反正你们也进不来。",
            "nextDialogs": [
              "750300619"
            ]
          },
          "750300619": {
            "id": "750300619",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#可恶，这家伙藏在地窖里，{NICKNAME}我们去找他去！",
            "nextDialogs": [
              "750300620"
            ]
          },
          "750300620": {
            "id": "750300620",
            "speakerId": 1000,
            "speakerName": "被称作阿科米蒂的青年",
            "text": "别费劲了，就算我告诉你们营地里有两条路直通地窖，<color=#00E1FFFF>但知道这两条路的也只有龙</color>，你们不可能有办法，还是走吧。"
          }
        }
      }
    },
    {
      "subId": "7503001",
      "subQuestName": "找到阿科米蒂",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750300101"
        ],
        "dialogs": {
          "750300101": {
            "id": "750300101",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "阿科米蒂，我们找到你了。",
            "nextDialogs": [
              "750300102"
            ]
          },
          "750300102": {
            "id": "750300102",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "你们还真的找到地窖来了？我还以为这个地窖这么隐蔽，你们找不到就该离开了。",
            "nextDialogs": [
              "750300103"
            ]
          },
          "750300103": {
            "id": "750300103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怎么说？跟我们解释解释吧，那些突然冒出来的龙贩子可是把我们吓了一跳。",
            "nextDialogs": [
              "750300104"
            ]
          },
          "750300104": {
            "id": "750300104",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "真是爱追根究底的人，本来我觉得自己这点事不值得向别人大倒苦水，所以才干脆窝在这里不出来。",
            "nextDialogs": [
              "750300105"
            ]
          },
          "750300105": {
            "id": "750300105",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "不过你们碰上这档子事也是受了损失，既然都找到这里来了，应该得到一个解释。",
            "nextDialogs": [
              "750300106"
            ]
          },
          "750300106": {
            "id": "750300106",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "我是花羽会的阿科米蒂，刚刚通过驭龙师考核，算是飞行队正式成员了吧。",
            "nextDialogs": [
              "750300107"
            ]
          },
          "750300107": {
            "id": "750300107",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "不对，我现在…应该已经被视为脱队的失翼者了，不知道队长打算怎么处理我的事，也没必要想这些了。",
            "nextDialogs": [
              "750300108"
            ]
          },
          "750300108": {
            "id": "750300108",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "你们肯定也听到了，我其实没有违反规定，偷绒翼龙幼崽牟利。",
            "nextDialogs": [
              "750300109"
            ]
          },
          "750300109": {
            "id": "750300109",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "至于那些龙贩子，你们放心，他们不敢再找你们寻仇。",
            "nextDialogs": [
              "750300110"
            ]
          },
          "750300110": {
            "id": "750300110",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "花羽会里头脑正常的人不会闲着没事跟飞行队起冲突，刚才那几个想偷龙的家伙也不过是小混混。",
            "nextDialogs": [
              "750300111"
            ]
          },
          "750300111": {
            "id": "750300111",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "他们其实害怕得很，只敢趁我落单过来堵路，这下被你们揍回去之后绝对不敢声张。",
            "nextDialogs": [
              "750300113",
              "750300115"
            ]
          },
          "750300113": {
            "id": "750300113",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "是啊，这些人到底在想什么啊，怎么会找飞行队的麻烦。",
            "nextDialogs": [
              "750300116"
            ]
          },
          "750300116": {
            "id": "750300116",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "不，跟身份无关，是我自己的问题，我可能…不适合进入飞行队吧。",
            "nextDialogs": [
              "750300117"
            ]
          },
          "750300117": {
            "id": "750300117",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "做预备役的时候想要成为正式队员，为追逐前辈们的速度拼命训练。",
            "nextDialogs": [
              "750300118"
            ]
          },
          "750300118": {
            "id": "750300118",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "没日没夜天天训练，一点做不好就战战兢兢，怀疑自己到底行不行。",
            "nextDialogs": [
              "750300119"
            ]
          },
          "750300119": {
            "id": "750300119",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "都没法跟爸妈还有姐姐说上几句话，脾气也变得古怪又急躁，饭不想吃，觉不想睡。",
            "nextDialogs": [
              "750300120"
            ]
          },
          "750300120": {
            "id": "750300120",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "好不容易通过了考核，成为正式队员之后，又得追逐队长的速度。",
            "nextDialogs": [
              "750300121"
            ]
          },
          "750300121": {
            "id": "750300121",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "我永远不够好，永远有人比我有天分还更努力。",
            "nextDialogs": [
              "750300122"
            ]
          },
          "750300122": {
            "id": "750300122",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "萤火虫刚刚飞上天，就发现自己得追上麻雀的速度，就算追上了飞鸟，接下来又不得不追逐流星。",
            "nextDialogs": [
              "750300123"
            ]
          },
          "750300123": {
            "id": "750300123",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "挺累的，说实话，定期要去烟谜主找人付费咨询，唉，钱花了不少，人没见好。",
            "nextDialogs": [
              "750300124"
            ]
          },
          "750300124": {
            "id": "750300124",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "就是想嘴上撒撒气，龙贩子来搭讪的时候才会说「趁早把龙都弄走」，谁知道他当真了。",
            "nextDialogs": [
              "750300125"
            ]
          },
          "750300125": {
            "id": "750300125",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "躲到这儿都跑不掉，结果被人堵在地窖里，我实在是厌倦了。",
            "nextDialogs": [
              "750300126"
            ]
          },
          "750300126": {
            "id": "750300126",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "怎么说呢…大家都有大家的问题吧，其实做冒险家也很辛苦的。",
            "nextDialogs": [
              "750300127"
            ]
          },
          "750300127": {
            "id": "750300127",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "对了，冒险家是不是能接委托？我想委托你们想个办法，给我一个充分的理由脱队。"
          },
          "750300115": {
            "id": "750300115",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔…我以为飞行队的驭龙师会很珍惜绒翼龙来着。"
          }
        }
      }
    },
    {
      "subId": "7503002",
      "subQuestName": "与阿科米蒂对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750300201"
        ],
        "dialogs": {
          "750300201": {
            "id": "750300201",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "听好了，一般飞行考核赛的目标是：在限定时间内，尽全力沿固定赛道驭龙飞行并得到尽可能高的分数。",
            "nextDialogs": [
              "750300202"
            ]
          },
          "750300202": {
            "id": "750300202",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "飞行队的考核是很严格的，我们训练的时候教官会在每一个赛道节点评估考生的表现，进行打分。",
            "nextDialogs": [
              "750300203"
            ]
          },
          "750300203": {
            "id": "750300203",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "最终成绩按照分数高低分四档，拜托你，至少要超过第二高的分档！我的脱队借口就指望你了。",
            "nextDialogs": [
              "750300204"
            ]
          },
          "750300204": {
            "id": "750300204",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "追上曾经咬牙拼命努力过的我的影子吧，我自己是没有力气了，只能厚着脸皮拜托别人。"
          }
        }
      }
    },
    {
      "subId": "7503006",
      "subQuestName": "(test)隐藏检测是否失败过$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7503003",
      "subQuestName": "开启计分飞行！",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750300301"
        ],
        "dialogs": {
          "750300301": {
            "id": "750300301",
            "speakerId": 1001,
            "speakerName": "愤怒的贩龙者",
            "text": "阿科米蒂呢？油嘴滑舌的小崽子，给我出来！",
            "nextDialogs": [
              "750300302"
            ]
          },
          "750300302": {
            "id": "750300302",
            "speakerId": 1001,
            "speakerName": "愤怒的贩龙者",
            "text": "答应卖给我的绒翼龙幼崽连一根毛都没见到，有本事别躲在地窖里，你给我出来解释解释！"
          }
        }
      }
    },
    {
      "subId": "7503004",
      "subQuestName": "与阿科米蒂对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750300401"
        ],
        "dialogs": {
          "750300401": {
            "id": "750300401",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "太好了呜呜，你做到了，你超过了我的最好成绩。",
            "nextDialogs": [
              "750300402"
            ]
          },
          "750300402": {
            "id": "750300402",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "我可以放心地拿着这个成绩，回去让他们放弃我了。",
            "nextDialogs": [
              "750300403"
            ]
          },
          "750300403": {
            "id": "750300403",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "你真的帮了我大忙，谢谢你！",
            "nextDialogs": [
              "750300406"
            ]
          },
          "750300406": {
            "id": "750300406",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "我会永远记住你帮的这个大忙，恩人。让我缓一会儿，之后马上去找队长。",
            "nextDialogs": [
              "750300407"
            ]
          },
          "750300407": {
            "id": "750300407",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "太好了，我马上就要自由了！"
          }
        }
      }
    },
    {
      "subId": "7503005",
      "subQuestName": "与阿科米蒂对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750300501"
        ],
        "dialogs": {
          "750300501": {
            "id": "750300501",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "恩人！我现在就准备动身回队伍了，感谢你。",
            "nextDialogs": [
              "750300504"
            ]
          },
          "750300504": {
            "id": "750300504",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "我都想好了，如果队长叫我再坚持一下、大家都是这么过来的，我就这样：",
            "nextDialogs": [
              "750300505"
            ]
          },
          "750300505": {
            "id": "750300505",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "先沉默一会儿，然后说：「对不起、队长，我…」，重点是要表现出自己的颓丧。",
            "nextDialogs": [
              "750300506"
            ]
          },
          "750300506": {
            "id": "750300506",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "让队长意识到我确实是个没法指望的家伙，而且我也没撒谎，我真是不行了。",
            "nextDialogs": [
              "750300507"
            ]
          },
          "750300507": {
            "id": "750300507",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "如果队长对我感到失望，打算从反面激将我，先说我最近的表现差然后再给我机会，我就这样：",
            "nextDialogs": [
              "750300508"
            ]
          },
          "750300508": {
            "id": "750300508",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "哭，但不能完全哭，眼泪在眼眶里不要流出来，然后简短地说一句「谢谢队长」。",
            "nextDialogs": [
              "750300509"
            ]
          },
          "750300509": {
            "id": "750300509",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "接下来说自己也觉得自己是个废物，重点是要顺着队长的话头，队长也不好否定自己的话。",
            "nextDialogs": [
              "750300510"
            ]
          },
          "750300510": {
            "id": "750300510",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "如果队长说自己要再想想，然后发动前辈们跟我谈话，我就…",
            "nextDialogs": [
              "750300511"
            ]
          },
          "750300511": {
            "id": "750300511",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "这个有点难办，我暂时还想不出来怎么办，主要是我没力气跟每个前辈这么来一轮。",
            "nextDialogs": [
              "750300512"
            ]
          },
          "750300512": {
            "id": "750300512",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "本来以为你是破罐子破摔，已经拒绝思考了，才会拉我们帮忙。",
            "nextDialogs": [
              "750300513"
            ]
          },
          "750300513": {
            "id": "750300513",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "居然在这种地方想得这么清楚了吗？",
            "nextDialogs": [
              "750300514"
            ]
          },
          "750300514": {
            "id": "750300514",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "这是人在遇到痛苦时心理产生的天然防御机制，压制对痛苦根源的感知，把注意力放到好的事情上。",
            "nextDialogs": [
              "750300515"
            ]
          },
          "750300515": {
            "id": "750300515",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "付费咨询的时候，烟谜主的人这么跟我说的。好歹花了钱，总得得到点有用的建议吧。"
          }
        }
      }
    },
    {
      "subId": "7503007",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750300701"
        ],
        "dialogs": {
          "750300701": {
            "id": "750300701",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "太可惜了，只差一点点。",
            "nextDialogs": [
              "750300702"
            ]
          },
          "750300702": {
            "id": "750300702",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "加油啊，千万不要放弃！",
            "nextDialogs": [
              "750300704",
              "750300707"
            ]
          },
          "750300704": {
            "id": "750300704",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "我能不能解脱就靠你了，当然要积极面对。",
            "nextDialogs": [
              "750300705"
            ]
          },
          "750300705": {
            "id": "750300705",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "来，歇一会儿我们再试一次，这次一定行。",
            "nextDialogs": [
              "750300708"
            ]
          },
          "750300708": {
            "id": "750300708",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "你放心，我不会放弃你的。不管尝试多少次都行，不要丧失信心，你一定能做到的。",
            "nextDialogs": [
              "750300709"
            ]
          },
          "750300709": {
            "id": "750300709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "赶快给我放弃！",
            "nextDialogs": [
              "750300710"
            ]
          },
          "750300710": {
            "id": "750300710",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "不，我说什么也不会放弃你的。我是没办法加油了，但是你可以。",
            "nextDialogs": [
              "750300711"
            ]
          },
          "750300711": {
            "id": "750300711",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "要是你也帮不上忙，我就真的没有招了。"
          },
          "750300707": {
            "id": "750300707",
            "speakerId": 1006,
            "speakerName": "阿科米蒂",
            "text": "没关系，你好好休息，待会儿我们再来！"
          }
        }
      }
    },
    {
      "subId": "7503009",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],

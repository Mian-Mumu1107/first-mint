    {
      "subId": "7503011",
      "subQuestName": "(test)隐藏判断是否有和龙B对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750301601"
        ],
        "dialogs": {
          "750301601": {
            "id": "750301601",
            "speakerId": 1004,
            "speakerName": "忧愁的绒翼龙",
            "text": "阿科米蒂躲在地窖里怎么能吃好？下巴都瘦尖了…",
            "nextDialogs": [
              "750301602"
            ]
          },
          "750301602": {
            "id": "750301602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你知道进地窖的路吗？",
            "nextDialogs": [
              "750301603"
            ]
          },
          "750301603": {
            "id": "750301603",
            "speakerId": 1004,
            "speakerName": "忧愁的绒翼龙",
            "text": "阿科米蒂正在地窖里休息，不方便外龙进去。",
            "nextDialogs": [
              "750301606"
            ]
          },
          "750301606": {
            "id": "750301606",
            "speakerId": 1004,
            "speakerName": "忧愁的绒翼龙",
            "text": "啊，你真好，我怎么就想不起来直接给他带点吃喝，逼他吃也是吃。",
            "nextDialogs": [
              "750301607"
            ]
          },
          "750301607": {
            "id": "750301607",
            "speakerId": 1004,
            "speakerName": "忧愁的绒翼龙",
            "text": "唉，当初库约尼把他交给我，但我居然没有照顾好他，丢龙啊。",
            "nextDialogs": [
              "750301608"
            ]
          },
          "750301608": {
            "id": "750301608",
            "speakerId": 1004,
            "speakerName": "忧愁的绒翼龙",
            "text": "还是你来吧，记住：从崖边冒热汽的地方飞下去有个小坡，按照「咚——咚咚咚——咚咚」的顺序敲打崖壁三次。",
            "nextDialogs": [
              "750301609"
            ]
          },
          "750301609": {
            "id": "750301609",
            "speakerId": 1004,
            "speakerName": "忧愁的绒翼龙",
            "text": "别敲错了，不然你可进不去。"
          }
        }
      }
    },
    {
      "subId": "7503008",

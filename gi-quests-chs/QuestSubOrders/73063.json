    {
      "subId": "7306309",
      "subQuestName": "探索山洞",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7306335",
      "subQuestName": "继续探索山洞",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730633501"
        ],
        "dialogs": {
          "730633501": {
            "id": "730633501",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇！噗…咳咳！咳咳咳！！怎么…怎么突然冲出好多水！差点就被淹死啦！！",
            "nextDialogs": [
              "730633506",
              "730633505"
            ]
          },
          "730633506": {
            "id": "730633506",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "因为「呿波境」是「钵参花」的梦，当「钵参花」醒来，梦就会散入空气里啦。",
            "nextDialogs": [
              "730633507"
            ]
          },
          "730633507": {
            "id": "730633507",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "所以承受不住水的重量，水就会冲出来！呜！哗啦啦！！清清凉凉的。",
            "nextDialogs": [
              "730633508"
            ]
          },
          "730633508": {
            "id": "730633508",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哼…要是被冲走就回不来了，看你还会不会说这种风凉话啦！",
            "nextDialogs": [
              "730633509"
            ]
          },
          "730633509": {
            "id": "730633509",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "嘿嘿，兰迦鲁知道那菈和白飞飞在哪里，草木也可以告诉我你们去了哪，不会回不来的！",
            "nextDialogs": [
              "730633510"
            ]
          },
          "730633510": {
            "id": "730633510",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "既然已经有了「钵参花」，接下来还需要找到「须罗蕈」和「耶然草」，才可以拜托兰纳迦配制「兰赫玛」！"
          },
          "730633505": {
            "id": "730633505",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喂！"
          }
        }
      }
    },
    {
      "subId": "7306310",
      "subQuestName": "击败蕈兽",
      "sceneId": null,
      "locations": [],

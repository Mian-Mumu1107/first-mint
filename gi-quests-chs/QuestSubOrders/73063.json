      }
    },
    {
      "subId": "7306311",
      "subQuestName": "调查蕈兽围绕的符文",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730631101"
        ],
        "dialogs": {
          "730631101": {
            "id": "730631101",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "就在这里啦，你看！",
            "nextDialogs": [
              "730631102"
            ]
          },
          "730631102": {
            "id": "730631102",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这是什么呀…看起来像是小孩子画的呢…看不明白…",
            "nextDialogs": [
              "730631103"
            ]
          },
          "730631103": {
            "id": "730631103",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "这是记忆呀！兰那罗的记忆可以存在块茎里，存在种子里，可以在叶脉里流动…但那菈的记忆是刻在石头里的！",
            "nextDialogs": [
              "730631104"
            ]
          },
          "730631104": {
            "id": "730631104",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "嘿嘿，每当月亮爬到天上最高的地方，我们三个兰那罗就会来到这里，然后让自己像那菈一样记得过去的「故事」！",
            "nextDialogs": [
              "730631105"
            ]
          },
          "730631105": {
            "id": "730631105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔…那你说，这上面画的是什么呀？",
            "nextDialogs": [
              "730631106"
            ]
          },
          "730631106": {
            "id": "730631106",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "不是画，是符文啦…是流光的河，上面是盛开着星星的花茎。河与星星为我们送来了那菈中的勇者们。",
            "nextDialogs": [
              "730631107"
            ]
          },
          "730631107": {
            "id": "730631107",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "草木的大主人让勇者那菈心中生出智慧的芽，又让兰那罗引导他们…去往水光闪闪的洞穴。",
            "nextDialogs": [
              "730631108"
            ]
          },
          "730631108": {
            "id": "730631108",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "嗯…就这些啦。附近还有其他的符文，我们边走边看吧。"
          }
        }
      }
    },

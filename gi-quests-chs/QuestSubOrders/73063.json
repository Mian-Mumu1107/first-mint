    {
      "subId": "7306322",
      "subQuestName": "探索「呿波境」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7306323",
      "subQuestName": "和兰迦鲁对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730632301"
        ],
        "dialogs": {
          "730632301": {
            "id": "730632301",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "这里就是「呿波境」啦！草木的美梦躲藏的地方，就是这里！",
            "nextDialogs": [
              "730632302"
            ]
          },
          "730632302": {
            "id": "730632302",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "你看，那边生长的，就是「钵参花」咯！",
            "nextDialogs": [
              "730632303"
            ]
          },
          "730632303": {
            "id": "730632303",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哇……",
            "nextDialogs": [
              "730632305",
              "730632307"
            ]
          },
          "730632305": {
            "id": "730632305",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "是呀，安静到让我好不安…",
            "nextDialogs": [
              "730632308"
            ]
          },
          "730632308": {
            "id": "730632308",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "「呿波境」很脆弱了…蕈类走进来，吃掉了许多养分，但「钵参花」没有受伤害…还没有呢。",
            "nextDialogs": [
              "730632309"
            ]
          },
          "730632309": {
            "id": "730632309",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "我们去解开他的封印，然后再和他说话吧！",
            "nextDialogs": [
              "730632310"
            ]
          },
          "730632310": {
            "id": "730632310",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯，我们解开封印，你去和他说话！"
          },
          "730632307": {
            "id": "730632307",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔…怎么看都很邪门啦…"
          }
        }
      }
    },

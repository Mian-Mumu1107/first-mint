    {
      "subId": "7306329",
      "subQuestName": "和兰迦鲁对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730632901"
        ],
        "dialogs": {
          "730632901": {
            "id": "730632901",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "兰迦鲁，来和「钵参花」说话，就可以了吧？",
            "nextDialogs": [
              "730632902"
            ]
          },
          "730632902": {
            "id": "730632902",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "嘘——！嘘——！小点声啦，不要吵到他。",
            "nextDialogs": [
              "730632903"
            ]
          },
          "730632903": {
            "id": "730632903",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "兰迦鲁同「钵参花」私语了一会…",
            "nextDialogs": [
              "730632904"
            ]
          },
          "730632904": {
            "id": "730632904",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "「钵参花」被我们从梦中吵醒，很生气。",
            "nextDialogs": [
              "730632905"
            ]
          },
          "730632905": {
            "id": "730632905",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸…？",
            "nextDialogs": [
              "730632906"
            ]
          },
          "730632906": {
            "id": "730632906",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "但是，如果是为了「兰赫玛」，就勉强原谅我们啦。",
            "nextDialogs": [
              "730632907"
            ]
          },
          "730632907": {
            "id": "730632907",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "「钵参花」，「钵参花」，为了兰赫玛，为了「无郁夷摩」的复生…请你同我们一道吧？",
            "nextDialogs": [
              "730632908"
            ]
          },
          "730632908": {
            "id": "730632908",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "咦…？哦…欸…？",
            "nextDialogs": [
              "730632910",
              "730632912"
            ]
          },
          "730632910": {
            "id": "730632910",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我在听「钵参花」回应了他什么呀！",
            "nextDialogs": [
              "730632913"
            ]
          },
          "730632913": {
            "id": "730632913",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "太好了，「钵参花」同意与我们一道冒险啦！",
            "nextDialogs": [
              "730632914"
            ]
          },
          "730632914": {
            "id": "730632914",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好耶！「钵参花」取得！",
            "nextDialogs": [
              "730632915"
            ]
          },
          "730632915": {
            "id": "730632915",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "唔，接下来…「钵参花」说，小心保护脑袋哦。",
            "nextDialogs": [
              "730632916"
            ]
          },
          "730632916": {
            "id": "730632916",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "…什么意思呀？",
            "nextDialogs": [
              "730632917"
            ]
          },
          "730632917": {
            "id": "730632917",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "小心保护脑袋和根系，不然等到水来了，会撞坏的…",
            "nextDialogs": [
              "730632918"
            ]
          },
          "730632918": {
            "id": "730632918",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸…？等等…什么声音？",
            "nextDialogs": [
              "730632919"
            ]
          },
          "730632919": {
            "id": "730632919",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "小心！！"
          },
          "730632912": {
            "id": "730632912",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "…听都听不见呢。"
          }
        }
      }
    },
    {
      "subId": "7306334",
      "subQuestName": "和兰迦鲁对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7306336",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730633601"
        ],
        "dialogs": {
          "730633601": {
            "id": "730633601",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜哇！噗…咳咳！咳咳咳！！怎么…怎么突然冲出好多水！差点就被淹死啦！！",
            "nextDialogs": [
              "730633606",
              "730633605"
            ]
          },
          "730633606": {
            "id": "730633606",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "因为「呿波境」是「钵参花」的梦，当「钵参花」醒来，梦就会散入空气里啦。",
            "nextDialogs": [
              "730633607"
            ]
          },
          "730633607": {
            "id": "730633607",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "所以承受不住水的重量，水就会冲出来！呜！哗啦啦！！清清凉凉的。",
            "nextDialogs": [
              "730633608"
            ]
          },
          "730633608": {
            "id": "730633608",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "哼…要是被冲走就回不来了，看你还会不会说这种风凉话啦！",
            "nextDialogs": [
              "730633609"
            ]
          },
          "730633609": {
            "id": "730633609",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "嘿嘿，兰迦鲁知道那菈和白飞飞在哪里，草木也可以告诉我你们去了哪，不会回不来的！",
            "nextDialogs": [
              "730633610"
            ]
          },
          "730633610": {
            "id": "730633610",
            "speakerId": 1001,
            "speakerName": "兰迦鲁",
            "text": "既然已经有了「钵参花」，接下来还需要找到「须罗蕈」和「耶然草」，才可以拜托兰纳迦配制「兰赫玛」！"
          },
          "730633605": {
            "id": "730633605",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "喂！"
          }
        }
      }
    }
  ]
}
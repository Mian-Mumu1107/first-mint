            "id": "771530301",
            "speakerId": 1003,
            "speakerName": "加廖波",
            "text": "别白费力气了，都是徒劳…",
            "nextDialogs": [
              "771530304"
            ]
          },
          "771530304": {
            "id": "771530304",

    {
      "subId": "7715301",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771530101"
        ],
        "dialogs": {
          "771530101": {
            "id": "771530101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看他语气那么强硬，还以为有多厉害呢。什么嘛，也不过如此。",
            "nextDialogs": [
              "771530102"
            ]
          },
          "771530102": {
            "id": "771530102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好了，坏蛋已经被我们赶走啦。",
            "nextDialogs": [
              "771530103"
            ]
          },
          "771530103": {
            "id": "771530103",
            "speakerId": 1001,
            "speakerName": "卡拉什",
            "text": "哈哈！真是天助我也！再见了各位！咱们后会无期！",
            "nextDialogs": [
              "771530104"
            ]
          },
          "771530104": {
            "id": "771530104",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "确认过附近没有兽怪盯梢后，工人一溜烟逃了。",
            "nextDialogs": [
              "771530105"
            ]
          },
          "771530105": {
            "id": "771530105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂——你等一下——",
            "nextDialogs": [
              "771530106"
            ]
          },
          "771530106": {
            "id": "771530106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我的感谢呢？我的报酬呢？",
            "nextDialogs": [
              "771530107"
            ]
          },
          "771530107": {
            "id": "771530107",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真是个不知感恩的家伙！居然连句谢谢也没有。",
            "nextDialogs": [
              "771530108"
            ]
          },
          "771530108": {
            "id": "771530108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "…不对，我们才不是为了感谢和报酬帮助他们的吧！唔，至少不全是啦。",
            "nextDialogs": [
              "771530109"
            ]
          },
          "771530109": {
            "id": "771530109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "算了，不求回报见义勇为的事我们平时也没少干，今天也当一次品德特——别高尚的冒险家好了！",
            "nextDialogs": [
              "771530110"
            ]
          },
          "771530110": {
            "id": "771530110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "话说回来，你不走吗？",
            "nextDialogs": [
              "771530111"
            ]
          },
          "771530111": {
            "id": "771530111",
            "speakerId": 1003,
            "speakerName": "加廖波",
            "text": "走？走有什么用…真傻啊，今天走了，明天还要被他们抓回来的…",
            "nextDialogs": [
              "771530112"
            ]
          },
          "771530112": {
            "id": "771530112",
            "speakerId": 1003,
            "speakerName": "加廖波",
            "text": "你们快走吧，「伊兹梅洛」不是你们两个能应付得来的。",
            "nextDialogs": [
              "771530113"
            ]
          },
          "771530113": {
            "id": "771530113",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那可未必哦，你是不是太小瞧我们了。",
            "nextDialogs": [
              "771530114"
            ]
          },
          "771530114": {
            "id": "771530114",
            "speakerId": 1003,
            "speakerName": "加廖波",
            "text": "…唉，你们不会懂的。"
          }
        }
      }
    },

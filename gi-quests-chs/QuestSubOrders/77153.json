    {
      "subId": "7715304",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771530401"
        ],
        "dialogs": {
          "771530401": {
            "id": "771530401",
            "speakerId": 1004,
            "speakerName": "凶神恶煞的「伊兹梅洛」",
            "text": "尝尝这个！欠下的债没有还清，还敢逃跑？！",
            "nextDialogs": [
              "771530402"
            ]
          },
          "771530402": {
            "id": "771530402",
            "speakerId": 1001,
            "speakerName": "卡拉什",
            "text": "哎呦！您下手悠着点，骨头给敲碎了，我还怎么干活还债呀…",
            "nextDialogs": [
              "771530403"
            ]
          },
          "771530403": {
            "id": "771530403",
            "speakerId": 1004,
            "speakerName": "凶神恶煞的「伊兹梅洛」",
            "text": "油嘴滑舌的东西…别磨蹭，快点走！",
            "nextDialogs": [
              "771530404"
            ]
          },
          "771530404": {
            "id": "771530404",
            "speakerId": 1001,
            "speakerName": "卡拉什",
            "text": "知道啦，知道啦！",
            "nextDialogs": [
              "771530405"
            ]
          },
          "771530405": {
            "id": "771530405",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "工人被兽怪押走了…",
            "nextDialogs": [
              "771530406"
            ]
          },
          "771530406": {
            "id": "771530406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是之前逃跑的人！真的又被抓回去了…"
          }
        }
      }
    },
    {
      "subId": "7715302",
      "subQuestName": "(test)废弃$HIDDEN",
      "sceneId": null,

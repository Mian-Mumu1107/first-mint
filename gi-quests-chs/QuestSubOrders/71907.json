        "dialogs": {
          "719070101": {
            "id": "719070101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么推荐菜吗？",
            "nextDialogs": [
              "719070102"
            ]
          },
          "719070102": {
            "id": "719070102",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "这「水煮黑背鲈」可是我们的招牌菜，虽说别的地方可能也能吃到，不过味道肯定比不上我们就是了。",
            "nextDialogs": [
              "719070103"
            ]
          },
          "719070103": {
            "id": "719070103",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "这鱼肉紧实饱满，用加入了绝云椒椒和琉璃袋的特制辣油烫过之后更是香辣、滑嫩，吃过的没有一个说不好的！",
            "nextDialogs": [
              "719070104"
            ]
          },
          "719070104": {
            "id": "719070104",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "…就是这菜有些辣，也不是谁都能吃得惯的。",
            "nextDialogs": [
              "719070105"
            ]
          },
          "719070105": {
            "id": "719070105",
            "speakerId": 2045,
            "speakerName": "卯师傅",
            "text": "不如你先尝尝吧，如果觉得好吃再来买便是了。"
          }
        }
      }
    }
  ]

  "subQuests": [
    {
      "subId": "7450301",
      "subQuestName": "与店员阿尔邦交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "745030101"
        ],
        "dialogs": {
          "745030101": {
            "id": "745030101",
            "speakerId": 30411,
            "speakerName": "阿尔邦",
            "text": "两位老爷，又见面了。虽然才分开一会会，但我都开始有点想你们了。",
            "nextDialogs": [
              "745030102"
            ]
          },
          "745030102": {
            "id": "745030102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你真是油嘴滑舌啦！",
            "nextDialogs": [
              "745030103"
            ]
          },
          "745030103": {
            "id": "745030103",
            "speakerId": 30411,
            "speakerName": "阿尔邦",
            "text": "真伤心，被讨厌了。我看我还是好好工作吧。",
            "nextDialogs": [
              "745030104"
            ]
          },
          "745030104": {
            "id": "745030104",
            "speakerId": 30411,
            "speakerName": "阿尔邦",
            "text": "我先说明，这次的数据收集分为两大部分，我和阿尔贝分别负责其中之一。",
            "nextDialogs": [
              "745030105"
            ]
          },
          "745030105": {
            "id": "745030105",
            "speakerId": 30411,
            "speakerName": "阿尔邦",
            "text": "我这块的数据收集，是为了模拟决斗代理人的灵敏度，所以需要老爷完成一些水下的模拟冲刺项目。",
            "nextDialogs": [
              "745030106"
            ]
          },
          "745030106": {
            "id": "745030106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来决斗代理人是要在水下训练的啊？",
            "nextDialogs": [
              "745030107"
            ]
          },
          "745030107": {
            "id": "745030107",
            "speakerId": 30411,
            "speakerName": "阿尔邦",
            "text": "谁知道呢？反正我也不认识决斗代理人，老板大概也不认识，但他觉得这样比较酷。",
            "nextDialogs": [
              "745030108"
            ]
          },
          "745030108": {
            "id": "745030108",
            "speakerId": 30411,
            "speakerName": "阿尔邦",
            "text": "他本来还想在玩具的手臂内置十种滋水机关，滋起水来噼咻噼咻的，不过因为成本太高放弃了。",
            "nextDialogs": [
              "745030111"
            ]
          },
          "745030111": {
            "id": "745030111",
            "speakerId": 30411,
            "speakerName": "阿尔邦",
            "text": "枫丹毕竟是水的国度，要想远销异国，体现一些枫丹特色总是好的。",
            "nextDialogs": [
              "745030112"
            ]
          },
          "745030112": {
            "id": "745030112",
            "speakerId": 30411,
            "speakerName": "阿尔邦",
            "text": "总之，具体的注意事项，我们准备了一份手册，两位老爷稍后可以看看。",
            "nextDialogs": [
              "745030113"
            ]
          },
          "745030113": {
            "id": "745030113",
            "speakerId": 30411,
            "speakerName": "阿尔邦",
            "text": "怎么样？是不是已经跃跃欲试了？",
            "nextDialogs": [
              "745030114"
            ]
          },
          "745030114": {
            "id": "745030114",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我准备一下。",
            "nextDialogs": [
              "745030115"
            ]
          },
          "745030115": {
            "id": "745030115",
            "speakerId": 30411,
            "speakerName": "阿尔邦",
            "text": "没问题，场地那边已经布置好了数据收集的仪器，所以这些就不用两位老爷费心了，只要专注地完成挑战就可以。"
          }
        }
      }
    }
  ]
}
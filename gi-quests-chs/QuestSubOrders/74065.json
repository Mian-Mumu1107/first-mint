    },
    {
      "subId": "7406503",
      "subQuestName": "向莫普瓦回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740650301"
        ],
        "dialogs": {
          "740650301": {
            "id": "740650301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你怎么才来呀，那些原海异种都被我们赶走啦。",
            "nextDialogs": [
              "740650302"
            ]
          },
          "740650302": {
            "id": "740650302",
            "speakerId": 21107,
            "speakerName": "莫普瓦",
            "text": "这么说来，终于让我赶上一回。",
            "nextDialogs": [
              "740650303"
            ]
          },
          "740650303": {
            "id": "740650303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "赶上一回？",
            "nextDialogs": [
              "740650304"
            ]
          },
          "740650304": {
            "id": "740650304",
            "speakerId": 21107,
            "speakerName": "莫普瓦",
            "text": "那当然是等我到现场的时候，发现工作已经全都由别人完成了。我呢？我什么也不用做。",
            "nextDialogs": [
              "740650305"
            ]
          },
          "740650305": {
            "id": "740650305",
            "speakerId": 21107,
            "speakerName": "莫普瓦",
            "text": "这是给你们的。真是多谢你们了，今晚我能睡个好觉了！"
          }
        }
      }
    }
  ]
}
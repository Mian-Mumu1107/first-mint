  "subQuests": [
    {
      "subId": "7406501",
      "subQuestName": "与德瑟布尔对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740650101"
        ],
        "dialogs": {
          "740650101": {
            "id": "740650101",
            "speakerId": 21095,
            "speakerName": "德瑟布尔",
            "text": "#哎哟，瞧瞧，这不是{NICKNAME}和派蒙吗？",
            "nextDialogs": [
              "740650104"
            ]
          },
          "740650104": {
            "id": "740650104",
            "speakerId": 21095,
            "speakerName": "德瑟布尔",
            "text": "别这么冷淡嘛，上次那事，我可记在心上了。",
            "nextDialogs": [
              "740650105"
            ]
          },
          "740650105": {
            "id": "740650105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "上次那事…啊！我们还有好多想问的都没问清楚呢！",
            "nextDialogs": [
              "740650106"
            ]
          },
          "740650106": {
            "id": "740650106",
            "speakerId": 21095,
            "speakerName": "德瑟布尔",
            "text": "是、是这样吗？你看我这记性，上次是什么事来着？我全忘了！",
            "nextDialogs": [
              "740650107"
            ]
          },
          "740650107": {
            "id": "740650107",
            "speakerId": 21095,
            "speakerName": "德瑟布尔",
            "text": "聪明人都说，与其回顾过去，不如放眼未来。不如我们聊聊今后的合作吧！",
            "nextDialogs": [
              "740650108"
            ]
          },
          "740650108": {
            "id": "740650108",
            "speakerId": 21095,
            "speakerName": "德瑟布尔",
            "text": "现在我手头上有些报酬不错的活计，就愁没人帮忙。两位如果有空的话，要不要来试试看？",
            "nextDialogs": [
              "740650109"
            ]
          },
          "740650109": {
            "id": "740650109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，别以为我们还会轻易上当…",
            "nextDialogs": [
              "740650110"
            ]
          },
          "740650110": {
            "id": "740650110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "报酬不错怎么说？",
            "nextDialogs": [
              "740650111"
            ]
          },
          "740650111": {
            "id": "740650111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！",
            "nextDialogs": [
              "740650112"
            ]
          },
          "740650112": {
            "id": "740650112",
            "speakerId": 21095,
            "speakerName": "德瑟布尔",
            "text": "#这就是为什么我喜欢和{NICKNAME}{M#先生}{F#小姐}这样的人物谈买卖，那话怎么说的，上道！",
            "nextDialogs": [
              "740650113"
            ]
          },
          "740650113": {
            "id": "740650113",
            "speakerId": 21095,
            "speakerName": "德瑟布尔",
            "text": "这样，我说个数，包你们满意。",
            "nextDialogs": [
              "740650114"
            ]
          },
          "740650114": {
            "id": "740650114",
            "speakerId": 21095,
            "speakerName": "德瑟布尔",
            "text": "一百特许券，怎么样？",
            "nextDialogs": [
              "740650115"
            ]
          },
          "740650115": {
            "id": "740650115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一百？！",
            "nextDialogs": [
              "740650116"
            ]
          },
          "740650116": {
            "id": "740650116",
            "speakerId": 21095,
            "speakerName": "德瑟布尔",
            "text": "嗯，看你的样子，是被我的慷慨给打动了吧。"
          }
        }
      }
    },
    {
      "subId": "7406502",
      "subQuestName": "击退在晶簇矿坑道游荡的原海异种",
      "sceneId": null,
      "locations": [],

      "subId": "49201",
      "subQuestName": "(test)回教堂看看琴的情况$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4901001"
        ],
        "dialogs": {
          "4901001": {
            "id": "4901001",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "啊，是你们。",
            "nextDialogs": [
              "4901004"
            ]
          },
          "4901004": {
            "id": "4901004",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "嗯，我只是…出来透透气。",
            "nextDialogs": [
              "4901005"
            ]
          },
          "4901005": {
            "id": "4901005",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "琴好像有什么心事？",
            "nextDialogs": [
              "4901006"
            ]
          },
          "4901006": {
            "id": "4901006",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "#{NICKNAME}，容我再次感谢…",
            "nextDialogs": [
              "4901007"
            ]
          },
          "4901007": {
            "id": "4901007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实我也一直被蒙在鼓里。",
            "nextDialogs": [
              "4901008"
            ]
          },
          "4901008": {
            "id": "4901008",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "但是，能这样和大家在一起，不知不觉就打起了精神呢。",
            "nextDialogs": [
              "4901011"
            ]
          },
          "4901011": {
            "id": "4901011",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "而且，我也认识到了一件事。",
            "nextDialogs": [
              "4901012"
            ]
          },
          "4901012": {
            "id": "4901012",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么事？",
            "nextDialogs": [
              "4901013"
            ]
          },
          "4901013": {
            "id": "4901013",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "比起「狮牙骑士」，果然还是「蒲公英骑士」更适合我。",
            "nextDialogs": [
              "4901014"
            ]
          },
          "4901014": {
            "id": "4901014",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "「狮牙骑士」，代表温妮莎为蒙德而斗争的过去…",
            "nextDialogs": [
              "4901015"
            ]
          },
          "4901015": {
            "id": "4901015",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "而建立西风骑士团之后的「蒲公英骑士」，代表她所期望的，骑士团的未来…",
            "nextDialogs": [
              "4901016"
            ]
          },
          "4901016": {
            "id": "4901016",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "温妮莎也一定会为现在的琴加油的！",
            "nextDialogs": [
              "4901017"
            ]
          },
          "4901017": {
            "id": "4901017",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "嗯，不论在高天之上，还是身旁的柔风里，温妮莎大人一定都还在注视着我们的。",
            "nextDialogs": [
              "4901018"
            ]
          },
          "4901018": {
            "id": "4901018",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听凭风引。",
            "nextDialogs": [
              "4901019"
            ]
          },
          "4901019": {
            "id": "4901019",
            "speakerId": 1006,
            "speakerName": "琴",
            "text": "#听凭风引。自由之风会指引前进的路，今后也请与我们同行吧，{NICKNAME}。"
          }
        }
      }
    }
  ]
}
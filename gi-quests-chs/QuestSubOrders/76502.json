        ],
        "dialogs": {
          "765020101": {
            "id": "765020101",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "#是{NICKNAME}和派蒙呀？怎么啦怎么啦？难道有什么超级厉害的委托，需要本天才机械师出马？",
            "nextDialogs": [
              "765020102"
            ]
          },
          "765020102": {
            "id": "765020102",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "嘿嘿，熟人好说，可以给你们打个八折！只要你们悄悄给我带点零食就行——嘘，千万别让伊涅芙知道！",
            "nextDialogs": [
              "765020105"
            ]
          },
          "765020105": {
            "id": "765020105",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "那你们算是来对地方了。我爱诺的工坊里，到处都是闪闪发光的好东西，别的地方绝对见不到！",
            "nextDialogs": [
              "765020106"
            ]
          },
          "765020106": {
            "id": "765020106",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "不过，你们走路的时候要小心脚下哦，不要被那些零件绊倒啦。"
          }
        }
      }
    },
    {

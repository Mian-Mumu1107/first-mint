{
  "lineCounts": {
    "Player": 7,
    "凯瑟琳": 27
  },
  "subQuests": [
    {
      "subId": "2211101",
      "subQuestName": "在蒙德城与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221110101"
        ],
        "dialogs": {
          "221110101": {
            "id": "221110101",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "关于新的委托…",
            "nextDialogs": [
              "221110102"
            ]
          },
          "221110102": {
            "id": "221110102",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "你好，冒险家。你的冒险事迹，已经在蒙德广为人知了。",
            "nextDialogs": [
              "221110103"
            ]
          },
          "221110103": {
            "id": "221110103",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "以这样的势头接着努力，你一定会成为一个伟大的冒险家。",
            "nextDialogs": [
              "221110105",
              "221110108"
            ]
          },
          "221110105": {
            "id": "221110105",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "如果想要成为一个伟大的冒险家，那你可不能只在熟悉的地方冒险。",
            "nextDialogs": [
              "221110106"
            ]
          },
          "221110106": {
            "id": "221110106",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "既然你已经有了如此充足的冒险经验，要不要试试去别的地方探索一番？",
            "nextDialogs": [
              "221110110"
            ]
          },
          "221110110": {
            "id": "221110110",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "请拿好这封信，把它带给璃月港的凯瑟琳小姐吧。"
          },
          "221110108": {
            "id": "221110108",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "因为到目前为止，你也只是在蒙德周围展开冒险呢。",
            "nextDialogs": [
              "221110109"
            ]
          },
          "221110109": {
            "id": "221110109",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "不过，你很快就能向更外面的世界迈进了。"
          }
        }
      }
    },
    {
      "subId": "2211102",
      "subQuestName": "在璃月港与凯瑟琳对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "221110201"
        ],
        "dialogs": {
          "221110201": {
            "id": "221110201",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "有一封信给你。",
            "nextDialogs": [
              "221110202"
            ]
          },
          "221110202": {
            "id": "221110202",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "向着星辰与深渊！欢迎来到冒险家协会。",
            "nextDialogs": [
              "221110203"
            ]
          },
          "221110203": {
            "id": "221110203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这封信应该是给你的…",
            "nextDialogs": [
              "221110204"
            ]
          },
          "221110204": {
            "id": "221110204",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "信？让我看看，唔…您是从蒙德来的冒险家啊。",
            "nextDialogs": [
              "221110205"
            ]
          },
          "221110205": {
            "id": "221110205",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "咦？这是…蒲公英？信里为什么会夹这种东西。",
            "nextDialogs": [
              "221110206"
            ]
          },
          "221110206": {
            "id": "221110206",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "",
            "nextDialogs": [
              "221110207"
            ]
          },
          "221110207": {
            "id": "221110207",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "您多虑了，这封信里的信息已经足够证明您的身份和来历了。",
            "nextDialogs": [
              "221110209",
              "221110211"
            ]
          },
          "221110209": {
            "id": "221110209",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "不过，这并不是什么重要的事，不用在意。",
            "nextDialogs": [
              "221110214"
            ]
          },
          "221110214": {
            "id": "221110214",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "从蒙德冒险家协会的信上看，您已经是个经验丰富的冒险家了。",
            "nextDialogs": [
              "221110215"
            ]
          },
          "221110215": {
            "id": "221110215",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "那么想必您也准备好，面对璃月冒险家协会的各类委托了。",
            "nextDialogs": [
              "221110216"
            ]
          },
          "221110216": {
            "id": "221110216",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "向着星辰与深渊，崭新的伟大冒险正在等着您！"
          },
          "221110211": {
            "id": "221110211",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "凯瑟琳？喔，您说的是「蒙德城的凯瑟琳」吧。",
            "nextDialogs": [
              "221110212"
            ]
          },
          "221110212": {
            "id": "221110212",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "她为什么要在里面夹蒲公英呢？真奇怪…蒲公英对冒险可没什么帮助。",
            "nextDialogs": [
              "221110213"
            ]
          },
          "221110213": {
            "id": "221110213",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "不过，这并不是什么重要的事，不用在意。"
          }
        }
      }
    }
  ]
}
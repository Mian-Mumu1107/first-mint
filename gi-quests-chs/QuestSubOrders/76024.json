    {
      "subId": "7602411",
      "subQuestName": "抓住盗宝鼬",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760241001"
        ],
        "dialogs": {
          "760241001": {
            "id": "760241001",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好啦，你们束手…",
            "nextDialogs": [
              "760241003"
            ]
          },
          "760241003": {
            "id": "760241003",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？！怎么全跑了！还是往不同的方向！",
            "nextDialogs": [
              "760241002"
            ]
          },
          "760241002": {
            "id": "760241002",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}、奥妮，我们一人一只，这次一定要逮到它们！"
          }
        }
      }
    },

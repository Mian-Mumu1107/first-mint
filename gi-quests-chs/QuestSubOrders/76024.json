    {
      "subId": "7602413",
      "subQuestName": "深入洞穴",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7602415",
      "subQuestName": "继续深入洞穴",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760241501"
        ],
        "dialogs": {
          "760241501": {
            "id": "760241501",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "哇，是莫雷一家，爷爷、爸爸妈妈、小莫雷还有小小莫雷…还有其他莫雷都在，一个都没少呢。",
            "nextDialogs": [
              "760241502"
            ]
          },
          "760241502": {
            "id": "760241502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来是嗅嗅鼹鼠呀！不过奥妮是怎么分辨它们的？它们看起来全都一个样…",
            "nextDialogs": [
              "760241503"
            ]
          },
          "760241503": {
            "id": "760241503",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "他们每个性格都不一样，相处得久了就知道了。",
            "nextDialogs": [
              "760241504"
            ]
          },
          "760241504": {
            "id": "760241504",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "不过他们都有的坏习惯就是向人乞讨，唉，真是可怜的动物，要是人类灭绝了，他们该怎么办呢。",
            "nextDialogs": [
              "760241505"
            ]
          },
          "760241505": {
            "id": "760241505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…人类灭绝？而且在那之后嗅嗅鼹鼠还在吗？应、应该不会吧？",
            "nextDialogs": [
              "760241506"
            ]
          },
          "760241506": {
            "id": "760241506",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "莉奈娅姐姐说过，动物是会灭绝的，因为各种各样的原因。那人类当然也有可能会灭绝的，派蒙妹妹为什么觉得不会呢？",
            "nextDialogs": [
              "760241508",
              "760241510"
            ]
          },
          "760241508": {
            "id": "760241508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过这样也回答不了奥妮的问题吧。唔，这么一想，人类的处境还真是危险呢，有那么多会威胁到人类生存的东西…",
            "nextDialogs": [
              "760241512"
            ]
          },
          "760241512": {
            "id": "760241512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过话说回来，既然鼹鼠一家都找到了，那这三只盗宝鼬该怎么处理呢？",
            "nextDialogs": [
              "760241513"
            ]
          },
          "760241513": {
            "id": "760241513",
            "speakerId": 1000,
            "speakerName": "奥妮",
            "text": "不知道该怎么办的话，就交给「旗舰」的人好了…",
            "nextDialogs": [
              "760241514"
            ]
          },
          "760241514": {
            "id": "760241514",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "宝箱！呃，还是说这种情况应该说是贿赂？不管了，既然是给我们的，那我们就收下啦。",
            "nextDialogs": [
              "760241515"
            ]
          },
          "760241515": {
            "id": "760241515",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#看它们的样子，应该是知道错了。{NICKNAME}，这次我们就放过它们吧。当、当然不是完全看在宝箱的份上啦！"
          },
          "760241510": {
            "id": "760241510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "人类灭绝之后它们大概还会在的。",
            "nextDialogs": [
              "760241511"
            ]
          },
          "760241511": {
            "id": "760241511",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "居然还要输给昆虫吗…有种好不甘心的感觉！"
          }
        }
      }
    },

    {
      "subId": "1203704",
      "subQuestName": "击退袭击者",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120370401"
        ],
        "dialogs": {
          "120370401": {
            "id": "120370401",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "嗯？原来你没有神之眼。",
            "nextDialogs": [
              "120370402"
            ]
          },
          "120370402": {
            "id": "120370402",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "看来是我认错人了。",
            "nextDialogs": [
              "120370403"
            ]
          },
          "120370403": {
            "id": "120370403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "至少先看清楚了再动手啊！",
            "nextDialogs": [
              "120370404"
            ]
          },
          "120370404": {
            "id": "120370404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不对…不管你要找谁，突然攻击别人就很危险了！",
            "nextDialogs": [
              "120370405"
            ]
          },
          "120370405": {
            "id": "120370405",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "你们见过吗？一个叫枫原万叶的人。",
            "nextDialogs": [
              "120370406"
            ]
          },
          "120370406": {
            "id": "120370406",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "和你一样，都用单手剑。我还听说他有风元素力的神之眼。",
            "nextDialogs": [
              "120370407"
            ]
          },
          "120370407": {
            "id": "120370407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你找他干什么？",
            "nextDialogs": [
              "120370408"
            ]
          },
          "120370408": {
            "id": "120370408",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "和你没关系。",
            "nextDialogs": [
              "120370409"
            ]
          },
          "120370409": {
            "id": "120370409",
            "speakerId": 1001,
            "speakerName": "？？？",
            "text": "算了，看你也不知道，浪费时间。",
            "nextDialogs": [
              "120370410"
            ]
          },
          "120370410": {
            "id": "120370410",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这人到底怎么回事，就知道拿怪怪的刀乱挥，还莫名其妙的，连句道歉都不讲。",
            "nextDialogs": [
              "120370411"
            ]
          },
          "120370411": {
            "id": "120370411",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么可能随便就把万叶的消息告诉这种人啊。",
            "nextDialogs": [
              "120370413",
              "120370415"
            ]
          },
          "120370413": {
            "id": "120370413",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是吧，虽然我觉得如果是堂堂正正的对决，他也不能拿万叶怎么样。",
            "nextDialogs": [
              "120370416"
            ]
          },
          "120370416": {
            "id": "120370416",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "以防万一，我们还是要赶快通知万叶，让他小心提防。",
            "nextDialogs": [
              "120370417"
            ]
          },
          "120370417": {
            "id": "120370417",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实我有点想法。",
            "nextDialogs": [
              "120370418"
            ]
          },
          "120370418": {
            "id": "120370418",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯？什么想法？",
            "nextDialogs": [
              "120370419"
            ]
          },
          "120370419": {
            "id": "120370419",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他可能和万叶有特殊的关系。",
            "nextDialogs": [
              "120370420"
            ]
          },
          "120370420": {
            "id": "120370420",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "特殊的关系？你是想说他认识万叶吗？"
          },
          "120370415": {
            "id": "120370415",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂，这我就不开心了，我一直都很机灵！"
          }
        }
      }
    },
    {
      "subId": "1203705",
      "subQuestName": "前往离岛寻找万叶",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120370501"
        ],
        "dialogs": {
          "120370501": {
            "id": "120370501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿，你好，你知道万叶在哪里吗？",
            "nextDialogs": [
              "120370502"
            ]
          },
          "120370502": {
            "id": "120370502",
            "speakerId": 1002,
            "speakerName": "潮哥",
            "text": "你们也是来找万叶的啊，看来他真的做了很了不起的事。",
            "nextDialogs": [
              "120370503"
            ]
          },
          "120370503": {
            "id": "120370503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「也」？",
            "nextDialogs": [
              "120370504"
            ]
          },
          "120370504": {
            "id": "120370504",
            "speakerId": 1002,
            "speakerName": "潮哥",
            "text": "哈哈哈，这次我们驾着小船来补充物资。结果刚进港，就来了好多好多稻妻人，和我们打听万叶的事。",
            "nextDialogs": [
              "120370505"
            ]
          },
          "120370505": {
            "id": "120370505",
            "speakerId": 1002,
            "speakerName": "潮哥",
            "text": "要说之前名椎滩那场战斗，大姐头也出了很多风头啊，我也没见大姐头有这么高的人气。",
            "nextDialogs": [
              "120370506"
            ]
          },
          "120370506": {
            "id": "120370506",
            "speakerId": 1002,
            "speakerName": "潮哥",
            "text": "在船队里，万叶的存在感不算强。有时候他还不听大姐头的话，但大姐头也不在意，唉…",
            "nextDialogs": [
              "120370507"
            ]
          },
          "120370507": {
            "id": "120370507",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来你还不知道他做了什么啊。",
            "nextDialogs": [
              "120370508"
            ]
          },
          "120370508": {
            "id": "120370508",
            "speakerId": 1002,
            "speakerName": "潮哥",
            "text": "稍微听到了一些，比如挡下了雷电将军「无想的一刀」之类的。",
            "nextDialogs": [
              "120370509"
            ]
          },
          "120370509": {
            "id": "120370509",
            "speakerId": 1002,
            "speakerName": "潮哥",
            "text": "那个很厉害吗？",
            "nextDialogs": [
              "120370510"
            ]
          },
          "120370510": {
            "id": "120370510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "就像北斗斩灭海山的那一下。",
            "nextDialogs": [
              "120370511"
            ]
          },
          "120370511": {
            "id": "120370511",
            "speakerId": 1002,
            "speakerName": "潮哥",
            "text": "哦，这么解释的话我一下子就理解了。哈哈哈，那他这么受人追捧，也是应该的！",
            "nextDialogs": [
              "120370512"
            ]
          },
          "120370512": {
            "id": "120370512",
            "speakerId": 1002,
            "speakerName": "潮哥",
            "text": "他早些时候被天领奉行的人叫走了，说是有重要的事情要和他谈。",
            "nextDialogs": [
              "120370513"
            ]
          },
          "120370513": {
            "id": "120370513",
            "speakerId": 1002,
            "speakerName": "潮哥",
            "text": "一开始我还以为是来抓人的呢。结果对方的态度特别友好，感觉他很受尊敬。",
            "nextDialogs": [
              "120370514"
            ]
          },
          "120370514": {
            "id": "120370514",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "放在不久之前，根本完全无法想象…",
            "nextDialogs": [
              "120370517"
            ]
          },
          "120370517": {
            "id": "120370517",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "谢谢你啦，那我们去天领奉行府看看。",
            "nextDialogs": [
              "120370518"
            ]
          },
          "120370518": {
            "id": "120370518",
            "speakerId": 1002,
            "speakerName": "潮哥",
            "text": "嗯，我就在这边继续应付围观的人了。"
          }
        }
      }
    },
    {
      "subId": "1203706",
      "subQuestName": "前往天领奉行府",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120370601"
        ],
        "dialogs": {
          "120370601": {
            "id": "120370601",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "#哦？是你啊，{NICKNAME}。",
            "nextDialogs": [
              "120370602"
            ]
          },
          "120370602": {
            "id": "120370602",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "你们好。我们刚刚聊到之前废除「眼狩令」的事，既然你们来了，就一起听一听吧。",
            "nextDialogs": [
              "120370603"
            ]
          },
          "120370603": {
            "id": "120370603",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "这次请枫原万叶先生来，主要是想表达幕府这边的友好态度。",
            "nextDialogs": [
              "120370604"
            ]
          },
          "120370604": {
            "id": "120370604",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "正因有你们的努力，才促成了如今光明的局面。我也有机会纠正家族曾犯下的错误，对此我非常感激。",
            "nextDialogs": [
              "120370605"
            ]
          },
          "120370605": {
            "id": "120370605",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "将军大人正在从很多方面入手，消解或柔化过去积攒的矛盾。",
            "nextDialogs": [
              "120370606"
            ]
          },
          "120370606": {
            "id": "120370606",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "三奉行提议，希望借此契机恢复枫原家的名誉。",
            "nextDialogs": [
              "120370607"
            ]
          },
          "120370607": {
            "id": "120370607",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "有关枫原家的事，你应该也略知一二吧？",
            "nextDialogs": [
              "120370610"
            ]
          },
          "120370610": {
            "id": "120370610",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "简而言之，稻妻过去有一批御用刀匠，继承了将军大人的锻刀技术并发扬光大，枫原家便是其中一族。",
            "nextDialogs": [
              "120370611"
            ]
          },
          "120370611": {
            "id": "120370611",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "但某个时期，有部分刀匠叛逃去了至冬国，枫原家与神里家均因管理不力被追责，经历了剧烈的动荡。",
            "nextDialogs": [
              "120370612"
            ]
          },
          "120370612": {
            "id": "120370612",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "不过后来我们得知，此事的幕后主导是愚人众。将过错全都归咎于枫原与神里两家的做法并不妥当，也很不公平。",
            "nextDialogs": [
              "120370613"
            ]
          },
          "120370613": {
            "id": "120370613",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "此番枫原万叶先生又立下重大功劳，将军大人认为不只应给予奖励，还要为曾经的过当处置进行补偿。",
            "nextDialogs": [
              "120370614"
            ]
          },
          "120370614": {
            "id": "120370614",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "但为了避免刀匠家族再度受到愚人众的迫害，我们并没有公开此事的调查结果，还请见谅。",
            "nextDialogs": [
              "120370615"
            ]
          },
          "120370615": {
            "id": "120370615",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "言重了，能有机会接受将军大人和幕府的好意，我很高兴。",
            "nextDialogs": [
              "120370616"
            ]
          },
          "120370616": {
            "id": "120370616",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "只不过，这份好意应该不是免费的吧。",
            "nextDialogs": [
              "120370617"
            ]
          },
          "120370617": {
            "id": "120370617",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "你多虑了，这是「补偿」。",
            "nextDialogs": [
              "120370618"
            ]
          },
          "120370618": {
            "id": "120370618",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "恢复名誉之后，枫原家便可重兴锻刀之业，你也不用继续四处漂泊。",
            "nextDialogs": [
              "120370619"
            ]
          },
          "120370619": {
            "id": "120370619",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "在将军大人的庇护与幕府的支持下，你可以在稻妻城过上安稳富足的生活。",
            "nextDialogs": [
              "120370620"
            ]
          },
          "120370620": {
            "id": "120370620",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "我常年行走于风雨之中，恐怕会不习惯高宅大院中的日子。",
            "nextDialogs": [
              "120370621"
            ]
          },
          "120370621": {
            "id": "120370621",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "不过我的祖先们，一直都为枫原之名和他们传承的锻刀技术而骄傲，我的确有为他们正名的责任。",
            "nextDialogs": [
              "120370622"
            ]
          },
          "120370622": {
            "id": "120370622",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "听起来你还有点犹豫。",
            "nextDialogs": [
              "120370623"
            ]
          },
          "120370623": {
            "id": "120370623",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "若你能答应，我想最近流传在市井之中很多关于你的谣言中伤也会消失。",
            "nextDialogs": [
              "120370624"
            ]
          },
          "120370624": {
            "id": "120370624",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "谣言中伤？一路上只听到好话，都快把他吹到天上去了。",
            "nextDialogs": [
              "120370625"
            ]
          },
          "120370625": {
            "id": "120370625",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "对有些人来说，「无想的一刀」是无法战胜的存在，他们不能接受枫原先生就这么接下了那一刀。",
            "nextDialogs": [
              "120370626"
            ]
          },
          "120370626": {
            "id": "120370626",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "那时有人目击了他除了风还使用了雷元素力，于是「枫原万叶使用了邪眼」的消息不胫而走…",
            "nextDialogs": [
              "120370627"
            ]
          },
          "120370627": {
            "id": "120370627",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊？可是，使用邪眼的人会飞快地衰老，万叶他又没有变成那个样子…",
            "nextDialogs": [
              "120370628"
            ]
          },
          "120370628": {
            "id": "120370628",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "嗯，但对他们来说，还是一个人同时使用两种元素力这件事更难以理解。",
            "nextDialogs": [
              "120370629"
            ]
          },
          "120370629": {
            "id": "120370629",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "与此类似的传闻还有很多，我很不适应处于舆论的中心，被人追逐或是猜忌。",
            "nextDialogs": [
              "120370630"
            ]
          },
          "120370630": {
            "id": "120370630",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "但若幕府愿意支持我，这件事的风浪或许会更快平静下去…",
            "nextDialogs": [
              "120370631"
            ]
          },
          "120370631": {
            "id": "120370631",
            "speakerId": 1004,
            "speakerName": "九条镰治",
            "text": "所以你可以积极地考虑一下，对我们来说应该都是一件好事。",
            "nextDialogs": [

            ]
          },
          "120370632": {
            "id": "120370632",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "嗯，容我考虑一番吧。",
            "nextDialogs": [
              "120370633"
            ]
          },
          "120370633": {
            "id": "120370633",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "此事的讨论先告一段落。你们两位为什么会找到这里来？",
            "nextDialogs": [
              "120370634"
            ]
          },
          "120370634": {
            "id": "120370634",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，差点就把重要的事忘记了！",
            "nextDialogs": [
              "120370635"
            ]
          },
          "120370635": {
            "id": "120370635",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "将野外袭击者的事告诉了枫原万叶。",
            "nextDialogs": [
              "120370636"
            ]
          },
          "120370636": {
            "id": "120370636",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "这样危险的人物在找我…"
          }
        }
      }

    {
      "subId": "7503299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750329901"
        ],
        "dialogs": {
          "750329901": {
            "id": "750329901",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "「给我唱首歌，呼唤离巢的鸟儿与飞龙…」",
            "nextDialogs": [
              "750329905"
            ]
          },
          "750329905": {
            "id": "750329905",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸，有人在很高的地方唱歌呢？哇，还挺好听的，要不要上去打个招呼？"
          }
        }
      }

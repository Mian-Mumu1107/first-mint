    },
    {
      "subId": "7503202",
      "subQuestName": "(test)确认开启挑战",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750320201"
        ],
        "dialogs": {
          "750320201": {
            "id": "750320201",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "怎么样，比不比？",
            "nextDialogs": [
              "750320202"
            ]
          },
          "750320202": {
            "id": "750320202",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "在限定时间内，尽全力沿固定赛道驭龙飞行并得到尽可能高的分数，<color=#00E1FFFF>只要超过第二高的分档就算你赢了我。</color>",
            "nextDialogs": [
              "750320204",
              "750320206"
            ]
          },
          "750320204": {
            "id": "750320204",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "好，爽快！去起点那里吧。"
          },
          "750320206": {
            "id": "750320206",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "没关系，等你有心情再说，本来飞行就应该是一件轻松愉快的事。"
          }
        }
      }
    },
    {
      "subId": "7503209",
      "subQuestName": "(test)隐藏判断是否失败过$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750320901"
        ],
        "dialogs": {
          "750320901": {
            "id": "750320901",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "和你一起飞很痛快，希望还会有下次，在那之前要保重哦年轻的冒险家。"
          }
        }
      }
    },
    {
      "subId": "7503203",
      "subQuestName": "开启计分飞行！",
      "sceneId": null,

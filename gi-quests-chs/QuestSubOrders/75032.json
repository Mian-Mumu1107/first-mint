      }
    },
    {
      "subId": "7503204",
      "subQuestName": "与曼尤雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750320401"
        ],
        "dialogs": {
          "750320401": {
            "id": "750320401",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "哈哈哈哈，很好，果然得承认年轻的总是要打败年老的。",
            "nextDialogs": [
              "750320402"
            ]
          },
          "750320402": {
            "id": "750320402",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "就算是星星也有坠落的时候，更何况是人呢。",
            "nextDialogs": [
              "750320403"
            ]
          },
          "750320403": {
            "id": "750320403",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "现在已经不是我的时代了，开开心心退役才是正确的选择。",
            "nextDialogs": [
              "750320404"
            ]
          },
          "750320404": {
            "id": "750320404",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "……",
            "nextDialogs": [
              "750320405"
            ]
          },
          "750320405": {
            "id": "750320405",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "但还是不甘心啊，我明明不老啊，皱纹都还没有呢，怎么就该隐退了…",
            "nextDialogs": [
              "750320406"
            ]
          },
          "750320406": {
            "id": "750320406",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "太短了，我的生涯怎么会这么短，还没尝出站在顶峰是什么滋味，就开始下坠。",
            "nextDialogs": [
              "750320407"
            ]
          },
          "750320407": {
            "id": "750320407",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "早知道会这么遗憾的话…",
            "nextDialogs": [
              "750320408"
            ]
          },
          "750320408": {
            "id": "750320408",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "算了，也不能这么说，能重来一次的话，我还是会做同样的选择。",
            "nextDialogs": [
              "750320409"
            ]
          },
          "750320409": {
            "id": "750320409",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "会拼尽全力进入飞行队，以我的能力这根本不难，然后，还是会在这个年纪退役。",
            "nextDialogs": [
              "750320410"
            ]
          },
          "750320410": {
            "id": "750320410",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "没办法，我已经尽力了，不甘心也没用啊。",
            "nextDialogs": [
              "750320411"
            ]
          },
          "750320411": {
            "id": "750320411",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "…可能人生就是这样吧，无奈的事太多了，想要成为英雄就得接受闪耀只有一瞬这种事实。",
            "nextDialogs": [
              "750320412"
            ]
          },
          "750320412": {
            "id": "750320412",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "曼尤雅…",
            "nextDialogs": [
              "750320413"
            ]
          },
          "750320413": {
            "id": "750320413",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "#没事，{M#他}{F#她}飞得很棒。你刚才一脸同情，现在怎么又是一副不安的表情？",
            "nextDialogs": [
              "750320414"
            ]
          },
          "750320414": {
            "id": "750320414",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "哈哈，活着就是会遇上各种各样的事，接受也好不接受也好，反正它们都会发生。",
            "nextDialogs": [
              "750320415"
            ]
          },
          "750320415": {
            "id": "750320415",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "就当是前驭龙师教给你的经验之谈吧，我的问题需要我自己解决，不要因为我的失态坏了你的心情。",
            "nextDialogs": [
              "750320416"
            ]
          },
          "750320416": {
            "id": "750320416",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "你做得很好哦，如果我弟弟也和你一样沉着冷静就好了。",
            "nextDialogs": [
              "750320417"
            ]
          },
          "750320417": {
            "id": "750320417",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "曼尤雅还有弟弟呀？",
            "nextDialogs": [
              "750320418"
            ]
          },
          "750320418": {
            "id": "750320418",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "是啊，我那两个怪脾气的弟弟可不像你们这么好说话。",
            "nextDialogs": [
              "750320419"
            ]
          },
          "750320419": {
            "id": "750320419",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "他们也在训练自己的飞行技巧，哦不对，阿科米蒂那家伙一心逃跑，说不定只会躲起来。",
            "nextDialogs": [
              "750320420"
            ]
          },
          "750320420": {
            "id": "750320420",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "不管这些臭小子们了，我看得出，你很有天赋。",
            "nextDialogs": [
              "750320421"
            ]
          },
          "750320421": {
            "id": "750320421",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "有空的话不妨多试着飞一飞，说不定会被主动招入飞行队哦。",
            "nextDialogs": [
              "750320422"
            ]
          },
          "750320422": {
            "id": "750320422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会多尝试的。",
            "nextDialogs": [
              "750320423"
            ]
          },
          "750320423": {
            "id": "750320423",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "那就太好了，希望以后还能看到你飞行的样子，加油吧，年轻的勇士。"
          }
        }
      }
    },
    {
      "subId": "7503206",
      "subQuestName": "与曼尤雅对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750320601"
        ],
        "dialogs": {
          "750320601": {
            "id": "750320601",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "龙也要归巢了，我要不要从天空的舞台上下场呢？",
            "nextDialogs": [
              "750320603",
              "750320605"
            ]
          },
          "750320603": {
            "id": "750320603",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "自言自语被你听到了呢。",
            "nextDialogs": [
              "750320606"
            ]
          },
          "750320606": {
            "id": "750320606",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "我想自己会离开这里回家一趟，退役的事情我还没和家里人说。",
            "nextDialogs": [
              "750320607"
            ]
          },
          "750320607": {
            "id": "750320607",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "往后我就有一大把闲散时间了，该做些什么比较好，这些事情也还没有想好。",
            "nextDialogs": [
              "750320608"
            ]
          },
          "750320608": {
            "id": "750320608",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "调整好自己的心态之后，得面对接下来的人生阶段了。",
            "nextDialogs": [
              "750320609"
            ]
          },
          "750320609": {
            "id": "750320609",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "先听听家人的建议比较好，我的父亲以前也是飞行队成员，退役之后做了训练师。",
            "nextDialogs": [
              "750320610"
            ]
          },
          "750320610": {
            "id": "750320610",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "我走过的路他也走过，他应该会有些特别的看法吧。",
            "nextDialogs": [
              "750320611"
            ]
          },
          "750320611": {
            "id": "750320611",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "所以这里的飞屋我会拆下来带走，但是赛道会留在这里，毕竟像你这样的年轻勇士总会需要练习的地方。",
            "nextDialogs": [
              "750320612"
            ]
          },
          "750320612": {
            "id": "750320612",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "曼尤雅，我们以后还会碰到你吗？",
            "nextDialogs": [
              "750320613"
            ]
          },
          "750320613": {
            "id": "750320613",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "我不知道，不过我猜自己不管怎么选，最后都没法放弃天空。",
            "nextDialogs": [
              "750320614"
            ]
          },
          "750320614": {
            "id": "750320614",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "只要你还会飞行，大概我们就还会遇上。",
            "nextDialogs": [
              "750320615"
            ]
          },
          "750320615": {
            "id": "750320615",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "下次再见。",
            "nextDialogs": [
              "750320616"
            ]
          },
          "750320616": {
            "id": "750320616",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "下次再见，年轻的勇士。"
          },
          "750320605": {
            "id": "750320605",
            "speakerId": 1001,
            "speakerName": "曼尤雅",
            "text": "哦，你过来了啊。"
          }
        }
      }
    },

      }
    },
    {
      "subId": "7468599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746859901"
        ],
        "dialogs": {
          "746859901": {
            "id": "746859901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？听起来像是什么东西炸开了…该不会是发生了战斗吧？",
            "nextDialogs": [
              "746859902"
            ]
          },
          "746859902": {
            "id": "746859902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "声音好像是从那边传来的，我们快去看看！"
          }
        }
      }
    }
  ]
}
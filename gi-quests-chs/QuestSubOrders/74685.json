  "subQuests": [
    {
      "subId": "7468501",
      "subQuestName": "寻找炮击声的来源",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746850101"
        ],
        "dialogs": {
          "746850101": {
            "id": "746850101",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "威力减小到这种程度应该差不多了，水球刚好能打破标靶，兼顾了娱乐效果和安全性…",
            "nextDialogs": [
              "746850102"
            ]
          },
          "746850102": {
            "id": "746850102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "水球？娱乐？原来只是一门水炮玩具啊，那我们就可以放心了…",
            "nextDialogs": [
              "746850103"
            ]
          },
          "746850103": {
            "id": "746850103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，这门水炮好像有点眼熟？我们是不是在哪里见过它？",
            "nextDialogs": [
              "746850105",
              "746850109"
            ]
          },
          "746850105": {
            "id": "746850105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可能是它的造型太特别吧，就像棘冠鳄…我一看就想给它起个「鳄鳄炮炮」之类的外号…",
            "nextDialogs": [
              "746850106"
            ]
          },
          "746850106": {
            "id": "746850106",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "「鳄鳄炮炮」？这个名字很不错！「鳄鳄」听起来就像是…炮弹飞掠而过的声音，简洁易懂还好记，我觉得棒！",
            "nextDialogs": [
              "746850107"
            ]
          },
          "746850107": {
            "id": "746850107",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "看来你们两位对这门水炮很有兴趣嘛！要不要来当我的第一批客人？",
            "nextDialogs": [
              "746850112"
            ]
          },
          "746850112": {
            "id": "746850112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喔！接下来你要说什么，我大概能猜到了——",
            "nextDialogs": [
              "746850113"
            ]
          },
          "746850113": {
            "id": "746850113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你刚刚完成了这门水炮的调试，正打算请人试玩，给你提提改进意见？",
            "nextDialogs": [
              "746850114"
            ]
          },
          "746850114": {
            "id": "746850114",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "完全正确！你们太上道了，看来没少和别人合作，我们沟通起来应该会很畅快！",
            "nextDialogs": [
              "746850115"
            ]
          },
          "746850115": {
            "id": "746850115",
            "speakerId": 1002,
            "speakerName": "布蕾斯特",
            "text": "先自我介绍一下，我叫布蕾斯特，是枫丹科学院前军械研究组的舰炮工程师，现已失业。",
            "nextDialogs": [
              "746850116"
            ]
          },
          "746850116": {
            "id": "746850116",
            "speakerId": 1002,
            "speakerName": "布蕾斯特",
            "text": "为了讨生活，我开始捣鼓这种「改进版鳄型涡流聚引原理鳄式外甲海战用重型舰炮式娱乐水球发射炮」，想开个水上乐园…",
            "nextDialogs": [
              "746850117"
            ]
          },
          "746850117": {
            "id": "746850117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等，舰炮工程师…失业…水上乐园？我脑袋有点转不过弯来了！"
          },
          "746850109": {
            "id": "746850109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦！我想起来了，这是我们在「琉形蜃境」里见过的「鳄鳄炮炮」！但操纵水炮的人…好像并不是沙蒂永先生？",
            "nextDialogs": [
              "746850110"
            ]
          },
          "746850110": {
            "id": "746850110",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "沙蒂永先生？你们居然知道那位传奇火炮设计师…说明也是行家了！",
            "nextDialogs": [
              "746850111"
            ]
          },
          "746850111": {
            "id": "746850111",
            "speakerId": 1000,
            "speakerName": "？？？",
            "text": "看来你们和这门水炮很有缘嘛！要不要来当我的第一批客人？"
          }
        }
      }
    },
    {
      "subId": "7468502",
      "subQuestName": "与工程师对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {

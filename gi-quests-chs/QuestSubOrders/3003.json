  "subQuests": [
    {
      "subId": "300301",
      "subQuestName": "寻找海芭夏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30030101"
        ],
        "dialogs": {
          "30030101": {
            "id": "30030101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "海芭夏——咦，里面怎么没人？",
            "nextDialogs": [
              "30030102"
            ]
          },
          "30030102": {
            "id": "30030102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "难道她出去找东西吃了？我去附近找找！",
            "nextDialogs": [
              "30030103"
            ]
          },
          "30030103": {
            "id": "30030103",
            "speakerId": 1001,
            "speakerName": "细微的声音",
            "text": "哗啦…",
            "nextDialogs": [
              "30030106"
            ]
          },
          "30030106": {
            "id": "30030106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（是海芭夏！她怎么样了？）",
            "nextDialogs": [
              "30030107"
            ]
          },
          "30030107": {
            "id": "30030107",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "？！"
          }
        }
      }
    },
    {
      "subId": "300302",
      "subQuestName": "(test)隐藏任务：进入地城$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30030201"
        ],
        "dialogs": {
          "30030201": {
            "id": "30030201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，原来你在这里。",
            "nextDialogs": [
              "30030202"
            ]
          },
          "30030202": {
            "id": "30030202",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，海芭夏！她现在怎么样了？",
            "nextDialogs": [
              "30030203"
            ]
          },
          "30030203": {
            "id": "30030203",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "唔…唔唔…好饿啊…咳咳…水…",
            "nextDialogs": [
              "30030206"
            ]
          },
          "30030206": {
            "id": "30030206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过她现在这个样子，也没办法直接吃东西，我们先出去给她找点水来吧。",
            "nextDialogs": [
              "30030207"
            ]
          },
          "30030207": {
            "id": "30030207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "等等，外面怎么突然起雾了？我们出去看看。"
          }
        }
      }
    },
    {
      "subId": "300303",
      "subQuestName": "查看海芭夏的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "300304",
      "subQuestName": "穿过迷雾",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30031001"
        ],
        "dialogs": {
          "30031001": {
            "id": "30031001",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，山洞外怎么变成了这样？",
            "nextDialogs": [
              "30031002"
            ]
          },
          "30031002": {
            "id": "30031002",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "究竟发生什么事了，我们现在到底在哪里？",
            "nextDialogs": [
              "30031005"
            ]
          },
          "30031005": {
            "id": "30031005",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯…你说得对。那我们在附近调查一下吧。"
          }
        }
      }
    },
    {
      "subId": "300312",
      "subQuestName": "继续前进，穿过树洞",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30031201"
        ],
        "dialogs": {
          "30031201": {
            "id": "30031201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来你刚才在这里遇到了一个兰那罗，还在他的影响下做了个梦。",
            "nextDialogs": [
              "30031202"
            ]
          },
          "30031202": {
            "id": "30031202",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "「兰那罗」，这就是他们的名字吗？你们不仅能看见他们，好像还对他们很熟悉的样子。",
            "nextDialogs": [
              "30031203"
            ]
          },
          "30031203": {
            "id": "30031203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "之前就遇到过他们。",
            "nextDialogs": [
              "30031204"
            ]
          },
          "30031204": {
            "id": "30031204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "海芭夏，你虽然能看见兰那罗，却不知道他们的名字吗？",
            "nextDialogs": [
              "30031205"
            ]
          },
          "30031205": {
            "id": "30031205",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "嗯，因为他们没和我说过话，我也从没向别人打听过这件事。我只隐约察觉，他们一定和草神有着很深的联系。",
            "nextDialogs": [
              "30031206"
            ]
          },
          "30031206": {
            "id": "30031206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，你是怎么感觉到的？"
          }
        }
      }
    },
    {
      "subId": "300315",
      "subQuestName": "尝试到达特别的洞口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30031501"
        ],
        "dialogs": {
          "30031501": {
            "id": "30031501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "海芭夏，原来你之前也不小心吓到了他。",
            "nextDialogs": [
              "30031502"
            ]
          },
          "30031502": {
            "id": "30031502",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "呵呵，是啊。直到现在我还觉得很对不起他呢。",
            "nextDialogs": [
              "30031503"
            ]
          },
          "30031503": {
            "id": "30031503",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "既然你们很了解兰那罗，一定知道他刚才把你拖进梦里并没有恶意，只是为了争取一些时间，好让自己赶快溜走罢了。",
            "nextDialogs": [
              "30031506"
            ]
          },
          "30031506": {
            "id": "30031506",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "海芭夏，住在这附近的兰那罗不仅经常出现在你旁边，而且这次还来救你，说明他已经把你当做重要的人了。",
            "nextDialogs": [
              "30031507"
            ]
          },
          "30031507": {
            "id": "30031507",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "总有一天他一定会开口和你说话，和你成为朋友的。",
            "nextDialogs": [
              "30031508"
            ]
          },
          "30031508": {
            "id": "30031508",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "谢谢你，希望这一天能早些到来。哦对了，提纳里在信上说，关于「世界树」你有不少问题要问我…"
          }
        }
      }
    },
    {
      "subId": "300316",
      "subQuestName": "调查古朴的房间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30031601"
        ],
        "dialogs": {
          "30031601": {
            "id": "30031601",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "最近我能感觉到，他已经不那么害怕我了，但没想到的是，他刚才竟然来救我了。",
            "nextDialogs": [
              "30031604"
            ]
          },
          "30031604": {
            "id": "30031604",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "嗯，是呀。哦对了，提纳里在信上说，关于「世界树」你有不少问题要问我…"
          }
        }
      }
    },
    {
      "subId": "300317",
      "subQuestName": "继续寻找通往树洞上层的道路",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30031701"
        ],
        "dialogs": {
          "30031701": {
            "id": "30031701",
            "speakerId": 1004,
            "speakerName": "奇妙的声音",
            "text": "「咕噜——」",
            "nextDialogs": [
              "30031702"
            ]
          },
          "30031702": {
            "id": "30031702",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "呃，不好意思。虽然已经喝了不少果汁，但感觉胃里还是空空的。",
            "nextDialogs": [
              "30031703"
            ]
          },
          "30031703": {
            "id": "30031703",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我们去给海芭夏做点吃的吧，之前提纳里准备的便当都掉在地上了。而且我也饿了，等会我们可以吃完饭再慢慢说。",
            "nextDialogs": [
              "30031704"
            ]
          },
          "30031704": {
            "id": "30031704",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们就做甜甜花酿鸡和萝卜时蔬汤吧，这两样也算是我们的拿手菜了。",
            "nextDialogs": [
              "30031705"
            ]
          },
          "30031705": {
            "id": "30031705",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "哇，是没吃过的外国菜，真是太期待了！老实说自从提纳里上次来过之后，我已经好久没吃到像样的饭菜了。"
          }
        }
      }
    },

    {
      "subId": "300313",
      "subQuestName": "前往上层平台",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30031101"
        ],
        "dialogs": {
          "30031101": {
            "id": "30031101",
            "speakerId": 1005,
            "speakerName": "深渊使徒",
            "text": "呵呵呵…旅行者，我们又见面了！",
            "nextDialogs": [
              "30031102"
            ]
          },
          "30031102": {
            "id": "30031102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是深渊使徒！喂，你们在这个奇怪的地方搞什么阴谋？",
            "nextDialogs": [
              "30031103"
            ]
          },
          "30031103": {
            "id": "30031103",
            "speakerId": 1005,
            "speakerName": "深渊使徒",
            "text": "「奇怪的地方」？「阴谋」？呵呵呵…这些事，你还用不着知道！"
          }
        }
      }
    },
    {
      "subId": "300314",
      "subQuestName": "击败深渊使徒",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30031401"
        ],
        "dialogs": {
          "30031401": {
            "id": "30031401",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "因为我第一次看见他，正是我意识成功接触到世界树的那天。",
            "nextDialogs": [
              "30031402"
            ]
          },
          "30031402": {
            "id": "30031402",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "当时，我从冥想中睁开眼，脑子里还因为涌入的知识嗡嗡作响，心脏也狂跳不止。",
            "nextDialogs": [
              "30031403"
            ]
          },
          "30031403": {
            "id": "30031403",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "突然间，我发现洞口边有一个小小的身影。",
            "nextDialogs": [
              "30031404"
            ]
          },
          "30031404": {
            "id": "30031404",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "我好奇地向他走过去，他应该是已经习惯了我在附近活动吧，所以并没有提防我，还在自得其乐地做自己的事。",
            "nextDialogs": [
              "30031405"
            ]
          },
          "30031405": {
            "id": "30031405",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "直到我蹲下来看他，他才猛然意识到我其实是能看见他的。",
            "nextDialogs": [
              "30031406"
            ]
          },
          "30031406": {
            "id": "30031406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "然后呢？",
            "nextDialogs": [
              "30031407"
            ]
          },
          "30031407": {
            "id": "30031407",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "然后…我就做了个梦。等我回过神来的时候，他已经消失不见了。",
            "nextDialogs": [
              "30031408"
            ]
          },
          "30031408": {
            "id": "30031408",
            "speakerId": 1003,
            "speakerName": "海芭夏",
            "text": "我以为他再也不会出现了，但过了几天后，我就又在附近看见了他，而且还有他的其他伙伴。"
          }
        }
      }
    },
    {
      "subId": "300305",
      "subQuestName": "与深渊使徒对峙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30030301"
        ],
        "dialogs": {
          "30030301": {
            "id": "30030301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "完全没办法打败他…你明明之前已经和这些家伙战斗过很多次了，为什么会这样？",
            "nextDialogs": [
              "30030302"
            ]
          },
          "30030302": {
            "id": "30030302",
            "speakerId": 1005,
            "speakerName": "深渊使徒",
            "text": "旅行者，就算你之前曾无数次从危机中生还，好运也总会有用完的一天，是时候认清自己的渺小和无力了！",
            "nextDialogs": [
              "30030305"
            ]
          },
          "30030305": {
            "id": "30030305",
            "speakerId": 1005,
            "speakerName": "深渊使徒",
            "text": "#{M#妹妹}{F#哥哥}？呵呵呵…哈哈哈哈！旅行者啊旅行者，你究竟是没察觉到真相，还是不愿意面对现实呢？",
            "nextDialogs": [
              "30030306"
            ]
          },
          "30030306": {
            "id": "30030306",
            "speakerId": 1005,
            "speakerName": "深渊使徒",
            "text": "#{M#公主}{F#王子}大人早就抛弃了你，你的存在对于{M#公主}{F#王子}大人来说，只不过是颗碍眼的绊脚石罢了！",
            "nextDialogs": [
              "30030307"
            ]
          },
          "30030307": {
            "id": "30030307",
            "speakerId": 1005,
            "speakerName": "深渊使徒",
            "text": "你追寻的亲情早就已经不复存在，你的旅途根本毫无意义！",
            "nextDialogs": [
              "30030308"
            ]
          },
          "30030308": {
            "id": "30030308",
            "speakerId": 1005,
            "speakerName": "深渊使徒",
            "text": "不过你用不着烦恼了，因为今天就是你的葬身之日！"
          }
        }
      }
    },
    {
      "subId": "300306",

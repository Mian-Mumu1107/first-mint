  },
  "subQuests": [
    {
      "subId": "7216438",
      "subQuestName": "test 与寝子对话 隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721640101"
        ],
        "dialogs": {
          "721640101": {
            "id": "721640101",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "唔喵…那个箱子果然很管用…",
            "nextDialogs": [
              "721640102"
            ]
          },
          "721640102": {
            "id": "721640102",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "是汝啊。那个「塞钱箱」，确实很管用呢。",
            "nextDialogs": [
              "721640103"
            ]
          },
          "721640103": {
            "id": "721640103",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "汝等修好之后不久，就有两个绿绿的人类过来神社了，喵喵。",
            "nextDialogs": [
              "721640104"
            ]
          },
          "721640104": {
            "id": "721640104",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "不仅往里面塞了钱，那个高高的，绿绿的人类听见奴家说话之后，还很激动。人类真是大惊小怪。",
            "nextDialogs": [
              "721640105"
            ]
          },
          "721640105": {
            "id": "721640105",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "「塞钱箱」真是好东西哪。如果再修一个，那就有更多人了吧？",
            "nextDialogs": [
              "721640106"
            ]
          },
          "721640106": {
            "id": "721640106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "事情不是这样的…",
            "nextDialogs": [
              "721640107"
            ]
          },
          "721640107": {
            "id": "721640107",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "是吗。人类的事情，还真是麻烦呢。",
            "nextDialogs": [
              "721640108"
            ]
          },
          "721640108": {
            "id": "721640108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个问题，应、应该和神社的环境有关吧…",
            "nextDialogs": [
              "721640109"
            ]
          },
          "721640109": {
            "id": "721640109",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "奴家的神社怎么了？",
            "nextDialogs": [
              "721640112"
            ]
          },
          "721640112": {
            "id": "721640112",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "哎呀，是这样吗？不过，那些小家伙们都很喜欢在落叶堆里玩啊…",
            "nextDialogs": [
              "721640113"
            ]
          },
          "721640113": {
            "id": "721640113",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "啊，不过仔细一想，阿响也经常用那个一头刺刺的长棍子，把树叶弄到一起。既然阿响会这么做，那一定是对的。"
          }
        }
      }
    },
    {
      "subId": "7216439",
      "subQuestName": "打扫神社屋子里的污渍",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7216443",
      "subQuestName": "向寝子回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721640201"
        ],
        "dialogs": {
          "721640201": {
            "id": "721640201",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "「打扫」完了吗？",
            "nextDialogs": [
              "721640202"
            ]
          },
          "721640202": {
            "id": "721640202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经打扫干净了。",
            "nextDialogs": [
              "721640203"
            ]
          },
          "721640203": {
            "id": "721640203",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "喵喵，那就好，奴家也已经把那些小虫子都赶走了。",
            "nextDialogs": [
              "721640204"
            ]
          },
          "721640204": {
            "id": "721640204",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "神社真是越来越像样了，箱子也修好了，屋子也打扫干净了。喵喵…肯定会有很多人过来参拜的。",
            "nextDialogs": [
              "721640205"
            ]
          },
          "721640205": {
            "id": "721640205",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "喵喵…一定要在阿响回来之前，把神社重新变热闹…喵…",
            "nextDialogs": [
              "721640206"
            ]
          },
          "721640206": {
            "id": "721640206",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "今天就先到这里吧，谢谢汝等帮忙…喵喵…",
            "nextDialogs": [
              "721640207"
            ]
          },
          "721640207": {
            "id": "721640207",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "一直说人类的话…很累…",
            "nextDialogs": [
              "721640208"
            ]
          },
          "721640208": {
            "id": "721640208",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "奴家要休息一下了，过段时间，说不定还得请汝等帮忙…",
            "nextDialogs": [
              "721640209"
            ]
          },
          "721640209": {
            "id": "721640209",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "到时候，请汝等务必过来…喵喵…"
          }
        }
      }
    },

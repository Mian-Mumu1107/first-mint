    {
      "subId": "7216403",
      "subQuestName": "*废弃 test",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721640301"
        ],
        "dialogs": {
          "721640301": {
            "id": "721640301",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "喵喵，这项工作可是阿响专门交付给奴家，只有奴家才能完成的重要工作呢。",
            "nextDialogs": [
              "721640303",
              "721640312"
            ]
          },
          "721640303": {
            "id": "721640303",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "奴家叫「寝子」，名字是阿响起的。",
            "nextDialogs": [
              "721640304"
            ]
          },
          "721640304": {
            "id": "721640304",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "平常都是由阿响出面招待来神社的人，不用奴家来照顾神社。",
            "nextDialogs": [
              "721640305"
            ]
          },
          "721640305": {
            "id": "721640305",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "奴家以前没有名字，也不用当「代宫司」，想睡就睡，想找谁玩就找谁玩。",
            "nextDialogs": [
              "721640306"
            ]
          },
          "721640306": {
            "id": "721640306",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "然后阿响说，因为奴家经常睡觉，所以就叫「寝子」吧。",
            "nextDialogs": [
              "721640307"
            ]
          },
          "721640307": {
            "id": "721640307",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "阿响现在不在，但神社不能没有「宫司」，所以奴家就当「代宫司」了。",
            "nextDialogs": [
              "721640308"
            ]
          },
          "721640308": {
            "id": "721640308",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "所以，在阿响回来前，奴家要把神社弄得又好又热闹。",
            "nextDialogs": [
              "721640309"
            ]
          },
          "721640309": {
            "id": "721640309",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "等她回来，奴家就可以在阿响怀里睡觉了，不用等她修「塞钱箱」，也不用等她用长棍子弄落叶了。",
            "nextDialogs": [
              "721640310"
            ]
          },
          "721640310": {
            "id": "721640310",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "总之，这件事就拜托汝等了，奴家去赶走那些偷偷爬进神社的虫子。"
          },
          "721640312": {
            "id": "721640312",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "是阿响。有时候，百目鬼也会帮她。",
            "nextDialogs": [
              "721640313"
            ]
          },
          "721640313": {
            "id": "721640313",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "太阳还没出来的时候，阿响经常拿着那个长棍子在地上摆来摆去。然后，阿响也会对地上用水。唔…",
            "nextDialogs": [
              "721640314"
            ]
          },
          "721640314": {
            "id": "721640314",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "还是先对地上用水？奴家对这些事情不了解。",
            "nextDialogs": [
              "721640315"
            ]
          },
          "721640315": {
            "id": "721640315",
            "speakerId": 1000,
            "speakerName": "「寝子」",
            "text": "百目鬼有时候也会来，用交叉的铁片咔嚓咔嚓。然后树枝和树叶就会掉下来。"
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "200501",
      "subQuestName": "寻找下一位被夺去神之眼的人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20050101"
        ],
        "dialogs": {
          "20050101": {
            "id": "20050101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奇怪，据说「天领奉行」直属于将军管辖，统管稻妻治安方面的事宜，眼狩令就是他们在执行。",
            "nextDialogs": [
              "20050102"
            ]
          },
          "20050102": {
            "id": "20050102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可为什么他们要对自己的同伴下手呢？",
            "nextDialogs": [
              "20050103"
            ]
          },
          "20050103": {
            "id": "20050103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "想不明白…等等，那边似乎发生了争吵，我们先过去看看吧。",
            "nextDialogs": [
              "20050104"
            ]
          },
          "20050104": {
            "id": "20050104",
            "speakerId": 12003,
            "speakerName": "大森",
            "text": "我说，这个月的救济粮，你是打算不给了吗？",
            "nextDialogs": [
              "20050105"
            ]
          },
          "20050105": {
            "id": "20050105",
            "speakerId": 12000,
            "speakerName": "悠也",
            "text": "我们一家人可都等着这些粮食养活呢！今天不给我们一个说法，你就别想走！",
            "nextDialogs": [
              "20050106"
            ]
          },
          "20050106": {
            "id": "20050106",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "说了多少遍，我不知道什么救济粮…",
            "nextDialogs": [
              "20050107"
            ]
          },
          "20050107": {
            "id": "20050107",
            "speakerId": 12003,
            "speakerName": "大森",
            "text": "还在骗人，那可是救命的粮食，不是给你们这些武士中饱私囊用的！",
            "nextDialogs": [
              "20050108"
            ]
          },
          "20050108": {
            "id": "20050108",
            "speakerId": 12000,
            "speakerName": "悠也",
            "text": "武士就能为所欲为了吗！我要去天领奉行所告你！",
            "nextDialogs": [
              "20050109"
            ]
          },
          "20050109": {
            "id": "20050109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「救济粮」指的是…",
            "nextDialogs": [
              "20050110"
            ]
          },
          "20050110": {
            "id": "20050110",
            "speakerId": 12003,
            "speakerName": "大森",
            "text": "你是谁？跟黑泽是一伙的吗？",
            "nextDialogs": [
              "20050111"
            ]
          },
          "20050111": {
            "id": "20050111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不不不，我们只是路过的普通人。",
            "nextDialogs": [
              "20050112"
            ]
          },
          "20050112": {
            "id": "20050112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听到你们在争吵，就想过来看看情况。",
            "nextDialogs": [
              "20050113"
            ]
          },
          "20050113": {
            "id": "20050113",
            "speakerId": 12003,
            "speakerName": "大森",
            "text": "原来是这样。正好，你来帮我们评评理——",
            "nextDialogs": [
              "20050114"
            ]
          },
          "20050114": {
            "id": "20050114",
            "speakerId": 12003,
            "speakerName": "大森",
            "text": "这个叫黑泽的武士，是幕府军的人。幕府军在这附近派发救济粮，他就是负责人。",
            "nextDialogs": [
              "20050115"
            ]
          },
          "20050115": {
            "id": "20050115",
            "speakerId": 12003,
            "speakerName": "大森",
            "text": "以前我们只要找到他就可以领到粮食，但现在他突然不给了。",
            "nextDialogs": [
              "20050116"
            ]
          },
          "20050116": {
            "id": "20050116",
            "speakerId": 12003,
            "speakerName": "大森",
            "text": "一定是他起了贪念，打算自己吞掉这批粮食！可是没有这批粮食，我们就要饿肚子了啊！",
            "nextDialogs": [
              "20050117"
            ]
          },
          "20050117": {
            "id": "20050117",
            "speakerId": 12000,
            "speakerName": "悠也",
            "text": "根本就没人考虑我们的感受…以前还觉得他是个有良心的人，现在看来他和别的武士一样坏。",
            "nextDialogs": [
              "20050118"
            ]
          },
          "20050118": {
            "id": "20050118",
            "speakerId": 12000,
            "speakerName": "悠也",
            "text": "怪不得连「神之眼」都被收回去了，雷电将军治理国家也不想要这样的人协助吧。",
            "nextDialogs": [
              "20050119"
            ]
          },
          "20050119": {
            "id": "20050119",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来这个人就是绫华说的人呀，可绫华为什么要我们帮助这种人呢？",
            "nextDialogs": [
              "20050120"
            ]
          },
          "20050120": {
            "id": "20050120",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们还是问问这位叫黑泽的武士是怎么想的吧。"
          }
        }
      }
    },
    {
      "subId": "200506",
      "subQuestName": "与武士黑泽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20050501"
        ],
        "dialogs": {
          "20050501": {
            "id": "20050501",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "什么救济粮，我听都没听说过这种事！",
            "nextDialogs": [
              "20050502"
            ]
          },
          "20050502": {
            "id": "20050502",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "不知道这些人从哪听说了一些传闻，就想跑过来讹诈我。可笑，我要是有救济粮可以私吞，还会穷成现在这个样子？",
            "nextDialogs": [
              "20050503"
            ]
          },
          "20050503": {
            "id": "20050503",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "我自己家都揭不开锅了…没什么事就让开吧，我还有事要做。",
            "nextDialogs": [
              "20050504"
            ]
          },
          "20050504": {
            "id": "20050504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听说你失去了神之眼…",
            "nextDialogs": [
              "20050505"
            ]
          },
          "20050505": {
            "id": "20050505",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "这倒是真的。幕府军的人说我对眼狩令不满，一直在消极怠工，还说我对不起雷电将军，就把我的神之眼收走了。",
            "nextDialogs": [
              "20050506"
            ]
          },
          "20050506": {
            "id": "20050506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "奇怪，你是眼狩令的执行者呀，为什么会对眼狩令不满呢？",
            "nextDialogs": [
              "20050507"
            ]
          },
          "20050507": {
            "id": "20050507",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "这个…说实话，我也记不清了。",
            "nextDialogs": [
              "20050508"
            ]
          },
          "20050508": {
            "id": "20050508",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "我只记得，那时候我好像每个月都会做些什么事情，不过现在完全不想做了。",
            "nextDialogs": [
              "20050509"
            ]
          },
          "20050509": {
            "id": "20050509",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "不仅不记得了，还隐约觉得心里不太舒服…好像谁欠了我什么东西一样。",
            "nextDialogs": [
              "20050510"
            ]
          },
          "20050510": {
            "id": "20050510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "跟「救济粮」有关吗？",
            "nextDialogs": [
              "20050511"
            ]
          },
          "20050511": {
            "id": "20050511",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "我没有私吞救济粮！还是那句话，如果有救济粮可以拿，谁愿意像我现在这样过苦日子？",
            "nextDialogs": [
              "20050512"
            ]
          },
          "20050512": {
            "id": "20050512",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "而且我家刚刚还被盗宝团洗劫了…对了，我刚刚是追着盗宝团来这里，突然被拦下来的。",
            "nextDialogs": [
              "20050513"
            ]
          },
          "20050513": {
            "id": "20050513",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "你们要是不信的话，去教训一下盗宝团，问问他们，我家到底有没有「救济粮」？",
            "nextDialogs": [
              "20050514"
            ]
          },
          "20050514": {
            "id": "20050514",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…感觉他看上去不像是在说谎呢。",
            "nextDialogs": [
              "20050515"
            ]
          },
          "20050515": {
            "id": "20050515",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但是也不能确定…我们还是抓个盗宝团的人问问看吧。",
            "nextDialogs": [
              "20050516"
            ]
          },
          "20050516": {
            "id": "20050516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "顺着盗宝团留下的痕迹，应该就可以找到他们了。趁盗宝团还没有跑远，我们快追上去吧。"
          }
        }
      }
    },
    {
      "subId": "200507",
      "subQuestName": "前往阻拦洗劫黑泽家的盗宝团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20050801"
        ],
        "dialogs": {
          "20050801": {
            "id": "20050801",
            "speakerId": 12002,
            "speakerName": "阿贤",
            "text": "大哥，今天的收获好像不错啊。",
            "nextDialogs": [
              "20050802"
            ]
          },
          "20050802": {
            "id": "20050802",
            "speakerId": 12002,
            "speakerName": "阿贤",
            "text": "咱们去的那几个武士家，除了其中一个特别穷之外，基本都富得流油，这下可发财了。",
            "nextDialogs": [
              "20050803"
            ]
          },
          "20050803": {
            "id": "20050803",
            "speakerId": 12022,
            "speakerName": "忠夫",
            "text": "这点钱算什么，这只是咱们兄弟发家致富的第一步！",
            "nextDialogs": [
              "20050804"
            ]
          },
          "20050804": {
            "id": "20050804",
            "speakerId": 12022,
            "speakerName": "忠夫",
            "text": "今天开始，我会带着你们在盗宝行业闯出一番名堂，让我们威名远扬！",
            "nextDialogs": [
              "20050805"
            ]
          },
          "20050805": {
            "id": "20050805",
            "speakerId": 12023,
            "speakerName": "阿豪",
            "text": "老大威武！",
            "nextDialogs": [
              "20050806"
            ]
          },
          "20050806": {
            "id": "20050806",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…看来他们就是我们要找的盗宝团了，让我们去教训他们一下吧。"
          }
        }
      }
    },
    {
      "subId": "200502",
      "subQuestName": "击败盗宝团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20050201"
        ],
        "dialogs": {
          "20050201": {
            "id": "20050201",
            "speakerId": 12002,
            "speakerName": "阿贤",
            "text": "可恶，怎么会这样…我的钱，那可是我们辛辛苦苦偷来的啊……",
            "nextDialogs": [
              "20050202"
            ]
          },
          "20050202": {
            "id": "20050202",
            "speakerId": 12002,
            "speakerName": "阿贤",
            "text": "老大，快想想办法啊！",
            "nextDialogs": [
              "20050203"
            ]
          },
          "20050203": {
            "id": "20050203",
            "speakerId": 12022,
            "speakerName": "忠夫",
            "text": "咳咳，这个…我看你身手不错，不知道有没有兴趣加入盗宝团，与我们共谋大事？",
            "nextDialogs": [
              "20050206"
            ]
          },
          "20050206": {
            "id": "20050206",
            "speakerId": 12022,
            "speakerName": "忠夫",
            "text": "黑泽？哦哦…我想起来了。",
            "nextDialogs": [
              "20050207"
            ]
          },
          "20050207": {
            "id": "20050207",
            "speakerId": 12022,
            "speakerName": "忠夫",
            "text": "你们原来是他派来的？晦气，真是晦气，我就不应该顺路去他家…",
            "nextDialogs": [
              "20050208"
            ]
          },
          "20050208": {
            "id": "20050208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "黑泽的家里怎么样？有很多粮食吧？",
            "nextDialogs": [
              "20050209"
            ]
          },
          "20050209": {
            "id": "20050209",
            "speakerId": 12022,
            "speakerName": "忠夫",
            "text": "粮食？没有没有，而且家里乱糟糟的，倒是…有个盒子挺别致的，我猜里面准有宝贝。",
            "nextDialogs": [
              "20050210"
            ]
          },
          "20050210": {
            "id": "20050210",
            "speakerId": 12022,
            "speakerName": "忠夫",
            "text": "本想回去再打开的，担心被什么其他人盯上。",
            "nextDialogs": [
              "20050211"
            ]
          },
          "20050211": {
            "id": "20050211",
            "speakerId": 12022,
            "speakerName": "忠夫",
            "text": "但既然被你们抓了，干脆就拿这盒子来赎我们自己吧，你看成不？",
            "nextDialogs": [
              "20050212"
            ]
          },
          "20050212": {
            "id": "20050212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "算你们有诚意，快打开看看吧！",
            "nextDialogs": [
              "20050213"
            ]
          },
          "20050213": {
            "id": "20050213",
            "speakerId": 12002,
            "speakerName": "阿贤",
            "text": "啊！",
            "nextDialogs": [
              "20050214"
            ]
          },
          "20050214": {
            "id": "20050214",
            "speakerId": 12022,
            "speakerName": "忠夫",
            "text": "这是！",
            "nextDialogs": [
              "20050215"
            ]
          },
          "20050215": {
            "id": "20050215",
            "speakerId": 12023,
            "speakerName": "阿豪",
            "text": "欠、欠条？",
            "nextDialogs": [
              "20050216"
            ]
          },
          "20050216": {
            "id": "20050216",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还有好多的样子…",
            "nextDialogs": [
              "20050217"
            ]
          },
          "20050217": {
            "id": "20050217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像是写给杂货店葵小姐的欠条，哇…欠了好多钱呢。",
            "nextDialogs": [
              "20050218"
            ]
          },
          "20050218": {
            "id": "20050218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "究竟是怎么回事呢…我们去杂货店问问吧。",
            "nextDialogs": [
              "20050219"
            ]
          },
          "20050219": {
            "id": "20050219",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，你们走吧！当心下次不要再被我们逮到！",
            "nextDialogs": [
              "20050220"
            ]
          },
          "20050220": {
            "id": "20050220",
            "speakerId": 12002,
            "speakerName": "阿贤",
            "text": "好！好！谢谢小老爷。",
            "nextDialogs": [
              "20050221"
            ]
          },
          "20050221": {
            "id": "20050221",
            "speakerId": 12023,
            "speakerName": "阿豪",
            "text": "拿欠条赎了我们的身…是不是算我们赚钱了呢？",
            "nextDialogs": [
              "20050222"
            ]
          },
          "20050222": {
            "id": "20050222",
            "speakerId": 12022,
            "speakerName": "忠夫",
            "text": "快走吧你！"
          }
        }
      }
    },
    {
      "subId": "200503",
      "subQuestName": "与盗宝团对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "200504",
      "subQuestName": "与杂货店的葵小姐对话，了解情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20050301"
        ],
        "dialogs": {
          "20050301": {
            "id": "20050301",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "「九十九物」，无所不有。客人想要买点什么？",
            "nextDialogs": [
              "20050302"
            ]
          },
          "20050302": {
            "id": "20050302",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "还是说…想要打听些什么？",
            "nextDialogs": [
              "20050303"
            ]
          },
          "20050303": {
            "id": "20050303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这欠条…",
            "nextDialogs": [
              "20050304"
            ]
          },
          "20050304": {
            "id": "20050304",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "呵呵，原来是黑泽先生的朋友，客人是来替黑泽先生偿还债务的吗？",
            "nextDialogs": [
              "20050305"
            ]
          },
          "20050305": {
            "id": "20050305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不不不，我们只是想打听一下「欠条」的来历…",
            "nextDialogs": [
              "20050306"
            ]
          },
          "20050306": {
            "id": "20050306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "黑泽为什么会欠这么多钱，他在这里买了什么贵重的东西吗？",
            "nextDialogs": [
              "20050307"
            ]
          },
          "20050307": {
            "id": "20050307",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "让我想想…",
            "nextDialogs": [
              "20050308"
            ]
          },
          "20050308": {
            "id": "20050308",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "黑泽先生会定期在我们这里购买大量粮食，不过用的是他自己的薪水。",
            "nextDialogs": [
              "20050309"
            ]
          },
          "20050309": {
            "id": "20050309",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "但是最近粮价上涨，黑泽先生自己的薪水已经不够了。他就开始向我们打欠条，通过赊账来换取等量的粮食。",
            "nextDialogs": [
              "20050310"
            ]
          },
          "20050310": {
            "id": "20050310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来「救济粮」是这么来的。",
            "nextDialogs": [
              "20050311"
            ]
          },
          "20050311": {
            "id": "20050311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是黑泽为什么一定要买「等量」的粮食呢？粮价上涨的话，少买一些不就可以了吗？",
            "nextDialogs": [
              "20050312"
            ]
          },
          "20050312": {
            "id": "20050312",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "客人不妨想一下。领取「救济粮」的民众，在拿到这些粮食之前，一定会反复思考这些粮食能支撑多久。",
            "nextDialogs": [
              "20050313"
            ]
          },
          "20050313": {
            "id": "20050313",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "他们精打细算，日夜核对，拿到手的时候却发现数量比预想中要少…黑泽先生认为，这会让他们感到很失望。",
            "nextDialogs": [
              "20050314"
            ]
          },
          "20050314": {
            "id": "20050314",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "为了照顾他们的感受，黑泽先生宁愿通过赊账来换取等量的粮食。",
            "nextDialogs": [
              "20050315"
            ]
          },
          "20050315": {
            "id": "20050315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些粮食，实际上是黑泽自己买下来的…",
            "nextDialogs": [
              "20050316"
            ]
          },
          "20050316": {
            "id": "20050316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "他们没有感谢黑泽，反而还在不停地责怪他…",
            "nextDialogs": [
              "20050317"
            ]
          },
          "20050317": {
            "id": "20050317",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "人的态度往往取决于他们的处境，在生存问题面前，大多数人是不会顾虑那么多的。",
            "nextDialogs": [
              "20050318"
            ]
          },
          "20050318": {
            "id": "20050318",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "在我看来，如果黑泽从一开始就公布「救济粮」的来源，现在面临的麻烦应该会少一点…",
            "nextDialogs": [
              "20050319"
            ]
          },
          "20050319": {
            "id": "20050319",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "当然，也只是少一点而已。他所做的，本来就是一件出力不讨好的事情。",
            "nextDialogs": [
              "20050320"
            ]
          },
          "20050320": {
            "id": "20050320",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "至于他为什么要花钱购买粮食救灾，又为什么不愿留下姓名供人感激…这些我就不清楚了。",
            "nextDialogs": [
              "20050321"
            ]
          },
          "20050321": {
            "id": "20050321",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "如果你们好奇的话，直接去问问黑泽先生如何？",
            "nextDialogs": [
              "20050322"
            ]
          },
          "20050322": {
            "id": "20050322",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他也不记得了。",
            "nextDialogs": [
              "20050323"
            ]
          },
          "20050323": {
            "id": "20050323",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "哦…说起来，他好像刚刚被收缴了「神之眼」…",
            "nextDialogs": [
              "20050324"
            ]
          },
          "20050324": {
            "id": "20050324",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "这就有点麻烦了…如果黑泽先生还不清欠款的话，他大概就只能卖掉那把他很珍视的刀了。",
            "nextDialogs": [
              "20050325"
            ]
          },
          "20050325": {
            "id": "20050325",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "刀？那是什么？",
            "nextDialogs": [
              "20050326"
            ]
          },
          "20050326": {
            "id": "20050326",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "黑泽先生没有跟你们说吗？他有一把很宝贝的刀，常年带在身上。",
            "nextDialogs": [
              "20050327"
            ]
          },
          "20050327": {
            "id": "20050327",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "我也曾向他询问过刀的来历，黑泽先生说是他的父亲送的，再高的价格都不会卖掉。",
            "nextDialogs": [
              "20050328"
            ]
          },
          "20050328": {
            "id": "20050328",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "当时我还感到有些遗憾，毕竟在我看来，世间万物都有价格，只要能开出相应的价码，应该什么都买得到。",
            "nextDialogs": [
              "20050329"
            ]
          },
          "20050329": {
            "id": "20050329",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "你们也可以问问黑泽先生关于刀的事情。说不定你们要找的答案，就在那把刀上。",
            "nextDialogs": [
              "20050330"
            ]
          },
          "20050330": {
            "id": "20050330",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "当然，在那之前，也请客人先结清一下这次的账单…",
            "nextDialogs": [
              "20050331"
            ]
          },
          "20050331": {
            "id": "20050331",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "但我们明明什么也没有买呀？",
            "nextDialogs": [
              "20050332"
            ]
          },
          "20050332": {
            "id": "20050332",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "呵呵，「情报」也是货物的一种，不是吗？",
            "nextDialogs": [
              "20050333"
            ]
          },
          "20050333": {
            "id": "20050333",
            "speakerId": 3002,
            "speakerName": "葵",
            "text": "不过，关于黑泽先生的情报倒是并不贵，毕竟黑泽先生也没有特别叮嘱我们要保守秘密。让我想想…两千摩拉就好。",
            "nextDialogs": [
              "20050334"
            ]
          },
          "20050334": {
            "id": "20050334",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好吧。",
            "nextDialogs": [
              "20050335"
            ]
          },
          "20050335": {
            "id": "20050335",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "至少我们知道了「救济粮」的来历，还有黑泽一直带着的那把刀…",
            "nextDialogs": [
              "20050336"
            ]
          },
          "20050336": {
            "id": "20050336",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "再去找黑泽问问吧，看看他能不能想起来什么…"
          }
        }
      }
    },
    {
      "subId": "200505",
      "subQuestName": "与武士黑泽对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20050401"
        ],
        "dialogs": {
          "20050401": {
            "id": "20050401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么只有你一个人在这里呀，刚刚缠住你的那两个人呢？",
            "nextDialogs": [
              "20050402"
            ]
          },
          "20050402": {
            "id": "20050402",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "我对他们说，再不走的话，我就拔刀了。他们就走了。",
            "nextDialogs": [
              "20050403"
            ]
          },
          "20050403": {
            "id": "20050403",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "果然，这比用言语说服他们方便多了。或许，今后我也应该…",
            "nextDialogs": [
              "20050404"
            ]
          },
          "20050404": {
            "id": "20050404",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "盗宝团的事情查清楚了？我没有骗你们吧。",
            "nextDialogs": [
              "20050405"
            ]
          },
          "20050405": {
            "id": "20050405",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实…",
            "nextDialogs": [
              "20050406"
            ]
          },
          "20050406": {
            "id": "20050406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "大概就是这样。其实你真的有发「救济粮」，只不过这些粮食是你自己掏钱买的。",
            "nextDialogs": [
              "20050407"
            ]
          },
          "20050407": {
            "id": "20050407",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "怎么会…以前的我是这样的人吗…",
            "nextDialogs": [
              "20050408"
            ]
          },
          "20050408": {
            "id": "20050408",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "我完全没有印象了。就算你告诉我了这些事情，我也想不起来了。",
            "nextDialogs": [
              "20050409"
            ]
          },
          "20050409": {
            "id": "20050409",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "以前的我为什么要做这种事？这不是自讨苦吃吗？真是难以理解…",
            "nextDialogs": [
              "20050410"
            ]
          },
          "20050410": {
            "id": "20050410",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "不过确实，刚刚握住这把刀，对他们两个施加威胁的时候，我也感受到了身体在本能地抗拒。",
            "nextDialogs": [
              "20050413"
            ]
          },
          "20050413": {
            "id": "20050413",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "这把刀，曾经是我老爹的佩刀。",
            "nextDialogs": [
              "20050414"
            ]
          },
          "20050414": {
            "id": "20050414",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "我记得小时候有一次，我从老爹那里偷出来了这把刀，想要在邻居家的孩子面前炫耀一番，结果被老爹狠狠地教训了一顿。",
            "nextDialogs": [
              "20050415"
            ]
          },
          "20050415": {
            "id": "20050415",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "他跟我说…说什么来着…奇怪，我又记不清了。",
            "nextDialogs": [
              "20050416"
            ]
          },
          "20050416": {
            "id": "20050416",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "「神之眼」被夺走之后，我好像忘记了很多重要的事情。记忆里是大段大段的空白，不管怎么想都想不起来。",
            "nextDialogs": [
              "20050417"
            ]
          },
          "20050417": {
            "id": "20050417",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "只记得老爹好像说过，这把刀上面，有他一生的信条。而他在离开这个世界之前，亲手把刀交到了我的手里…",
            "nextDialogs": [
              "20050418"
            ]
          },
          "20050418": {
            "id": "20050418",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "还对我说，拿着这把刀，就应该…",
            "nextDialogs": [
              "20050419"
            ]
          },
          "20050419": {
            "id": "20050419",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯…仔细看看的话，这个刀柄上是不是刻着字？",
            "nextDialogs": [
              "20050420"
            ]
          },
          "20050420": {
            "id": "20050420",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "旅行者，你能看出来上面刻着什么吗？",
            "nextDialogs": [
              "20050421"
            ]
          },
          "20050421": {
            "id": "20050421",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是「仁义」。",
            "nextDialogs": [
              "20050422"
            ]
          },
          "20050422": {
            "id": "20050422",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "「仁义」？",
            "nextDialogs": [
              "20050423"
            ]
          },
          "20050423": {
            "id": "20050423",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "这么说的话，好像就能解释得通了…",
            "nextDialogs": [
              "20050424"
            ]
          },
          "20050424": {
            "id": "20050424",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "不惜负债累累，也要让他人获得幸福，这就是我曾经最大的愿望吧。",
            "nextDialogs": [
              "20050425"
            ]
          },
          "20050425": {
            "id": "20050425",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "但「仁义」，有什么用？我践行此道，用自己的钱买粮食救济他们，可结果呢？",
            "nextDialogs": [
              "20050426"
            ]
          },
          "20050426": {
            "id": "20050426",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "天领奉行夺走了我的神之眼，而那些被我救济的人也不愿意理解我！",
            "nextDialogs": [
              "20050427"
            ]
          },
          "20050427": {
            "id": "20050427",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "最讽刺的是，我朝他们拔刀的时候，还会感受到心痛。",
            "nextDialogs": [
              "20050428"
            ]
          },
          "20050428": {
            "id": "20050428",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "我做不了好人，连坏人都当不了！我到底…到底该怎么办啊…",
            "nextDialogs": [
              "20050429"
            ]
          },
          "20050429": {
            "id": "20050429",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "又是一个好可怜的人…",
            "nextDialogs": [
              "20050430"
            ]
          },
          "20050430": {
            "id": "20050430",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "关于他欠钱的事，有空我们和托马他们说一下吧，社奉行应该会支援他一下的吧？",
            "nextDialogs": [
              "20050431"
            ]
          },
          "20050431": {
            "id": "20050431",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总不能真的让他把自己珍视的刀也卖掉…"
          }
        }
      }
    },
    {
      "subId": "200509",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20050901"
        ],
        "dialogs": {
          "20050901": {
            "id": "20050901",
            "speakerId": 12000,
            "speakerName": "悠也",
            "text": "救济粮，我的救济粮…"
          }
        }
      }
    },
    {
      "subId": "200510",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20051001"
        ],
        "dialogs": {
          "20051001": {
            "id": "20051001",
            "speakerId": 12003,
            "speakerName": "大森",
            "text": "做人做事，可得讲良心啊！"
          }
        }
      }
    },
    {
      "subId": "200511",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20051101"
        ],
        "dialogs": {
          "20051101": {
            "id": "20051101",
            "speakerId": 12003,
            "speakerName": "大森",
            "text": "别骗人了，快点把粮食交出来！"
          }
        }
      }
    },
    {
      "subId": "200512",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20051201"
        ],
        "dialogs": {
          "20051201": {
            "id": "20051201",
            "speakerId": 12000,
            "speakerName": "悠也",
            "text": "呜呜，没有救济粮我可怎么活啊…"
          }
        }
      }
    },
    {
      "subId": "200513",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20051301"
        ],
        "dialogs": {
          "20051301": {
            "id": "20051301",
            "speakerId": 3048,
            "speakerName": "黑泽京之介",
            "text": "想不到有一天，需要靠盗宝团来证明我的清白…"
          }
        }
      }
    }
  ]
}
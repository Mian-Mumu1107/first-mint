{
  "lineCounts": {
    "Black Screen": 1,
    "Player": 6,
    "「炫彩呆子」": 15,
    "派蒙": 10
  },
  "subQuests": [
    {
      "subId": "7550401",
      "subQuestName": "向「炫彩呆子」回报近况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "755040101"
        ],
        "dialogs": {
          "755040101": {
            "id": "755040101",
            "speakerId": 1000,
            "speakerName": "「炫彩呆子」",
            "text": "嗨呀！你们回来了！",
            "nextDialogs": [
              "755040102"
            ]
          },
          "755040102": {
            "id": "755040102",
            "speakerId": 1000,
            "speakerName": "「炫彩呆子」",
            "text": "看你们的眼神，想必饱览了各地的风光和物产，找到了灵感？",
            "nextDialogs": [
              "755040103"
            ]
          },
          "755040103": {
            "id": "755040103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "马马虎虎吧…这一路上玩得倒是挺开心的！",
            "nextDialogs": [
              "755040104"
            ]
          },
          "755040104": {
            "id": "755040104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有了特定的目标以后，还真能注意到不少以前忽略的细节…",
            "nextDialogs": [
              "755040105"
            ]
          },
          "755040105": {
            "id": "755040105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们也算是大开眼界，收集了许多素材？",
            "nextDialogs": [
              "755040108"
            ]
          },
          "755040108": {
            "id": "755040108",
            "speakerId": 1000,
            "speakerName": "「炫彩呆子」",
            "text": "不要紧，慢慢来！我也不至于急切到要你们在纳塔游览一番，就顿悟前卫为何物嘛。",
            "nextDialogs": [
              "755040109"
            ]
          },
          "755040109": {
            "id": "755040109",
            "speakerId": 1000,
            "speakerName": "「炫彩呆子」",
            "text": "那么，向我细说你们的见闻吧？",
            "nextDialogs": [
              "755040110"
            ]
          },
          "755040110": {
            "id": "755040110",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向「炫彩呆子」展示了你们在涂鸦指南上的记录，以及拍摄到的各种画片…",
            "nextDialogs": [
              "755040111"
            ]
          },
          "755040111": {
            "id": "755040111",
            "speakerId": 1000,
            "speakerName": "「炫彩呆子」",
            "text": "等等…你们拍摄画片时的意识…不是很妙吗？",
            "nextDialogs": [
              "755040112"
            ]
          },
          "755040112": {
            "id": "755040112",
            "speakerId": 1000,
            "speakerName": "「炫彩呆子」",
            "text": "没想到你们使用留影机的经验相当丰富，下意识为这些画片选取了绝佳的构图。",
            "nextDialogs": [
              "755040113"
            ]
          },
          "755040113": {
            "id": "755040113",
            "speakerId": 1000,
            "speakerName": "「炫彩呆子」",
            "text": "既然如此，我说太多反而是揠苗助长，只需稍微给你们一点引导，应该就能打通你们的思维。",
            "nextDialogs": [
              "755040114"
            ]
          },
          "755040114": {
            "id": "755040114",
            "speakerId": 1000,
            "speakerName": "「炫彩呆子」",
            "text": "那就请你们收下我的手记，之后的旅途中，没事对着眼前的风景读一读，也许眼前就能浮现出富有张力的构图！",
            "nextDialogs": [
              "755040115"
            ]
          },
          "755040115": {
            "id": "755040115",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？我还以为你会给我们分析每张画片，然后上一堂…前卫理念入门课呢！",
            "nextDialogs": [
              "755040116"
            ]
          },
          "755040116": {
            "id": "755040116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且我也有点想试试涂鸦了…",
            "nextDialogs": [
              "755040117"
            ]
          },
          "755040117": {
            "id": "755040117",
            "speakerId": 1000,
            "speakerName": "「炫彩呆子」",
            "text": "这不是显得你们天赋异禀，有望无师自通吗！",
            "nextDialogs": [
              "755040118"
            ]
          },
          "755040118": {
            "id": "755040118",
            "speakerId": 1000,
            "speakerName": "「炫彩呆子」",
            "text": "对于无师自通的天才，让他们按部就班，循规蹈矩地学习涂鸦技巧，或许会扼杀他们发展的潜力。",
            "nextDialogs": [
              "755040119"
            ]
          },
          "755040119": {
            "id": "755040119",
            "speakerId": 1000,
            "speakerName": "「炫彩呆子」",
            "text": "所以，我就要从全责任的导师和引路人，转变成给你们提供帮助的前辈。",
            "nextDialogs": [
              "755040120"
            ]
          },
          "755040120": {
            "id": "755040120",
            "speakerId": 1000,
            "speakerName": "「炫彩呆子」",
            "text": "等到灵感喷涌，时机成熟了，你们拿起涂鸦的颜料罐，就能大展身手！",
            "nextDialogs": [
              "755040121"
            ]
          },
          "755040121": {
            "id": "755040121",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们居然还有这种天赋？",
            "nextDialogs": [
              "755040122"
            ]
          },
          "755040122": {
            "id": "755040122",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿…看来之前接了那么多画家、映影导演的委托，全都没有白费！"
          }
        }
      }
    }
  ]
}
    {
      "subId": "2001102",
      "subQuestName": "(test)击败附近怪物$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200110201"
        ],
        "dialogs": {
          "200110201": {
            "id": "200110201",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "谢谢你，旅行者…",
            "nextDialogs": [
              "200110202"
            ]
          },
          "200110202": {
            "id": "200110202",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "可是还有个路障在这，我还是过不去，",
            "nextDialogs": [
              "200110203"
            ]
          },
          "200110203": {
            "id": "200110203",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "哈哈哈，本来我可以自己搞定…可我吃了丘丘人好几下，全身都在痛。",
            "nextDialogs": [
              "200110204"
            ]
          },
          "200110204": {
            "id": "200110204",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "不过还好，我给安娜摘的这些草药都没坏…",
            "nextDialogs": [
              "200110205"
            ]
          },
          "200110205": {
            "id": "200110205",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "抱歉，虽然已经很麻烦你了，但是你能再帮我把这路障给解决掉吗？",
            "nextDialogs": [
              "200110208",
              "200110209"
            ]
          },
          "200110208": {
            "id": "200110208",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "谢谢，我要休息一下…"
          },
          "200110209": {
            "id": "200110209",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "可安娜还在家等着我…请你再帮帮我吧。"
          }
        }
      }
    },
    {
      "subId": "2001103",
      "subQuestName": "消灭所有魔物并摧毁路障",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200110301"
        ],
        "dialogs": {
          "200110301": {
            "id": "200110301",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "这样子可以走过去了…谢谢，旅行者。",
            "nextDialogs": [
              "200110302"
            ]
          },
          "200110302": {
            "id": "200110302",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "因为没多少钱，安娜的病又始终不见好，所以我经常来这采草药。",
            "nextDialogs": [
              "200110303"
            ]
          },
          "200110303": {
            "id": "200110303",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "虽然草药采到了，但没想到今天会被这群家伙袭击，还好你赶过来了。",
            "nextDialogs": [
              "200110304"
            ]
          },
          "200110304": {
            "id": "200110304",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "这个给你，我经常用这个给安娜泡茶喝，这样她的咳嗽才会好些。",
            "nextDialogs": [
              "200110305"
            ]
          },
          "200110305": {
            "id": "200110305",
            "speakerId": 1000,
            "speakerName": "安东尼",
            "text": "你也经常在野外跑吧，自己要照顾好自己啊。"
          }
        }
      }
    },

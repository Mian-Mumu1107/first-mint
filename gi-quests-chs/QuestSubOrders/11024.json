{
  "lineCounts": {
    "Player": 3,
    "派蒙": 3,
    "钟离": 15
  },
  "subQuests": [
    {
      "subId": "1102401",
      "subQuestName": "抵达孤云阁，与钟离交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110240101"
        ],
        "dialogs": {
          "110240101": {
            "id": "110240101",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "之前对你提过，孤云阁之下，镇压了很多旧日的魔神。",
            "nextDialogs": [
              "110240102"
            ]
          },
          "110240102": {
            "id": "110240102",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "如今仙众已将璃月交给凡人，而赫乌莉亚的时代，是更久远的过去。她留下的「盐盏」与「盐尺」，不应该回到璃月港。",
            "nextDialogs": [
              "110240103"
            ]
          },
          "110240103": {
            "id": "110240103",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "让它们留在这里，既是沉眠，也是返乡…",
            "nextDialogs": [
              "110240104"
            ]
          },
          "110240104": {
            "id": "110240104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "所以钟离要我做什么呢？",
            "nextDialogs": [
              "110240105"
            ]
          },
          "110240105": {
            "id": "110240105",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "我亲手终结了一个时代。我一直在想，如何记录那些…被我终结的历史。",
            "nextDialogs": [
              "110240106"
            ]
          },
          "110240106": {
            "id": "110240106",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "历史可以记录，但历史并不可靠，这次的事也证明了这点。时间拥有强大的力量，历史会在岁月中扭曲…",
            "nextDialogs": [
              "110240107"
            ]
          },
          "110240107": {
            "id": "110240107",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "我需要找到更好的「记录」，才能铭刻真实的历史。",
            "nextDialogs": [
              "110240108"
            ]
          },
          "110240108": {
            "id": "110240108",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "刻石曾是一种久远的「记录」。但看似不变的磐石、看似不变的世界与我…或许也都会在某一天消失。",
            "nextDialogs": [
              "110240109"
            ]
          },
          "110240109": {
            "id": "110240109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "钟离…",
            "nextDialogs": [
              "110240110"
            ]
          },
          "110240110": {
            "id": "110240110",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "所以，旅行者，我想到了你。",
            "nextDialogs": [
              "110240111"
            ]
          },
          "110240111": {
            "id": "110240111",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "你是远渡重天、跨越星海之人。把历史刻在你的记忆里，就可以在未来某日，随你一同前往别的世界。",
            "nextDialogs": [
              "110240112"
            ]
          },
          "110240112": {
            "id": "110240112",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "身为旅行者的你，只要能够「记录」，那么，提瓦特的时代与历史，就获得了一种「存在的备份」…",
            "nextDialogs": [
              "110240114",
              "110240116"
            ]
          },
          "110240114": {
            "id": "110240114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "任重而道远啊。",
            "nextDialogs": [
              "110240118"
            ]
          },
          "110240118": {
            "id": "110240118",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "那么，接下来，就是将「盐盏」与「盐尺」投入海中的时刻了。",
            "nextDialogs": [
              "110240119"
            ]
          },
          "110240119": {
            "id": "110240119",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊？为什么要扔进海里？",
            "nextDialogs": [
              "110240120"
            ]
          },
          "110240120": {
            "id": "110240120",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "刚才我说过吧？这里镇压了很多旧日的魔神。",
            "nextDialogs": [
              "110240121"
            ]
          },
          "110240121": {
            "id": "110240121",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "也包括被「群玉阁」重锁深海的「漩涡之魔神」，奥赛尔…"
          },
          "110240116": {
            "id": "110240116",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "哈哈哈…祝你离开提瓦特以后，在星海之间也能捡到宝箱。",
            "nextDialogs": [
              "110240117"
            ]
          },
          "110240117": {
            "id": "110240117",
            "speakerId": 1000,
            "speakerName": "钟离",
            "text": "我有「财富之神」的别号，所以这句话是有效力的。"
          }
        }
      }
    },
    {
      "subId": "1102402",
      "subQuestName": "将遗物投入海中",
      "sceneId": null,
      "locations": [],

    {
      "subId": "1918719",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191871901"
        ],
        "dialogs": {
          "191871901": {
            "id": "191871901",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "在警备队赶来之前，这里就由我们看管吧。放心，他们不会再有机会溜走了。",
            "nextDialogs": [
              "191871904"
            ]
          },
          "191871904": {
            "id": "191871904",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "嗯…涉案原料还有很多正规用途，不只是能用来制备「仿制乐斯」，所以不会直接违禁。",
            "nextDialogs": [
              "191871905"
            ]
          },
          "191871905": {
            "id": "191871905",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "港口一般会暂时扣留，等通过各种申报再允许过关，否则就退回原船。艾洛迪应该就是在退回之前，偷换了原料。",
            "nextDialogs": [
              "191871906"
            ]
          },
          "191871906": {
            "id": "191871906",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "载着原料来的海外船只，多半也是她事先联系好的，所以收到了调换过的货品后，依旧心照不宣。",
            "nextDialogs": [
              "191871907"
            ]
          },
          "191871907": {
            "id": "191871907",
            "speakerId": 1081,
            "speakerName": "夏沃蕾",
            "text": "这些罪行我们还会继续追查。既然抓住了艾洛迪，剩下的也只是时间问题了。"
          }
        }
      }
    },
    {
      "subId": "1918720",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "191872001"
        ],
        "dialogs": {
          "191872001": {
            "id": "191872001",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "今天「认真模式」的运行时长算是破纪录了吧…还真少见，是因为谁呢？",
            "nextDialogs": [
              "191872004"
            ]
          },
          "191872004": {
            "id": "191872004",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "唔…按之前查到的线索，「仿制乐斯」先是在枫丹小规模流通，后来才从小买卖变成大走私。",
            "nextDialogs": [
              "191872005"
            ]
          },
          "191872005": {
            "id": "191872005",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "一开始流通的，应该是皮埃尔早期制备的存货。但他粗劣的犯罪，很快就被身为巡警的艾洛迪发现。",
            "nextDialogs": [
              "191872006"
            ]
          },
          "191872006": {
            "id": "191872006",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "艾洛迪从中看到了能大量牟利，甚至改头换面、重新生活的机会，所以一边暗中掩饰他的早期罪行…",
            "nextDialogs": [
              "191872007"
            ]
          },
          "191872007": {
            "id": "191872007",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "一边以贝努瓦的名义写信，用搜集的罪证和巨额的利润，威逼利诱皮埃尔配合她的后续计划吧。",
            "nextDialogs": [
              "191872008"
            ]
          },
          "191872008": {
            "id": "191872008",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "可惜，遇到了琳妮特。别看她平时不喜欢想太多，「认真模式」下的她可比谁都敏锐。",
            "nextDialogs": [
              "191872009"
            ]
          },
          "191872009": {
            "id": "191872009",
            "speakerId": 1071,
            "speakerName": "林尼",
            "text": "…不过这个模式的「耗能」也很快。我们一会儿还要做笔录，陪她「充能」的事，可就交给你啦。"
          }
        }
      }
    }
  ]

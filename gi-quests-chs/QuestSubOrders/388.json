      "subId": "38801",
      "subQuestName": "(test)与温迪对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3880101"
        ],
        "dialogs": {
          "3880101": {
            "id": "3880101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是暴风的<color=#00E1FFFF>障壁</color>！",
            "nextDialogs": [
              "3880102"
            ]
          },
          "3880102": {
            "id": "3880102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇…真是看起来非常危险的景观。",
            "nextDialogs": [
              "3880103"
            ]
          },
          "3880103": {
            "id": "3880103",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "交给我吧。",
            "nextDialogs": [
              "3880104"
            ]
          },
          "3880104": {
            "id": "3880104",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "虽然手里只有一把普通的木琴…",
            "nextDialogs": [
              "3880105"
            ]
          },
          "3880105": {
            "id": "3880105",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "但要打破这种风障，也用不上「天空」——咦？那是什么？",
            "nextDialogs": [
              "3880106"
            ]
          },
          "3880106": {
            "id": "3880106",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "敌袭！各位，准备迎战。"
          }
        }
      }
    },

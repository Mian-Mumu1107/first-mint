          "3840801"
        ],
        "dialogs": {
          "3840801": {
            "id": "3840801",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我会用这双眼见证到最后。",
            "nextDialogs": [
              "3840802"
            ]
          },
          "3840802": {
            "id": "3840802",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "为了蒙德，骑士团会竭尽所能。",
            "nextDialogs": [
              "3840803"
            ]
          },
          "3840803": {
            "id": "3840803",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "还不动身吗。"
          }
        }
      }

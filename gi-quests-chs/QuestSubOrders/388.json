    {
      "subId": "38803",
      "subQuestName": "开启风障",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3880301"
        ],
        "dialogs": {
          "3880301": {
            "id": "3880301",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "呼…",
            "nextDialogs": [
              "3880302"
            ]
          },
          "3880302": {
            "id": "3880302",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "丘丘人…通常，它们不太会在元素浓度过高的区域活动。",
            "nextDialogs": [
              "3880303"
            ]
          },
          "3880303": {
            "id": "3880303",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "在这里，它们的身体要承受更大的负担…",
            "nextDialogs": [
              "3880304"
            ]
          },
          "3880304": {
            "id": "3880304",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "想必就是深渊教团在背后操控吧，但它们应该不能确定我们会来这里。",
            "nextDialogs": [
              "3880305"
            ]
          },
          "3880305": {
            "id": "3880305",
            "speakerId": 1003,
            "speakerName": "迪卢克",
            "text": "为了阻止我们的行动，教团恐怕正在向四处投放兵力。",
            "nextDialogs": [
              "3880306"
            ]
          },
          "3880306": {
            "id": "3880306",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "那么，事不宜迟——",
            "nextDialogs": [
              "3880307"
            ]
          },
          "3880307": {
            "id": "3880307",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这次的听众只是「风」而已，拨弦的速度加快一点也无所谓吧。"
          }
        }
      }
    },
    {
      "subId": "38804",
      "subQuestName": "与温迪对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3880401"
        ],
        "dialogs": {
          "3880401": {
            "id": "3880401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，真的能打开耶。你偶尔也会有点用嘛，卖唱的。",
            "nextDialogs": [
              "3880402"
            ]
          },
          "3880402": {
            "id": "3880402",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "从这里开始，就算是正式进入<color=#00E1FFFF>「风龙废墟」</color>了。",
            "nextDialogs": [
              "3880403"
            ]
          },
          "3880403": {
            "id": "3880403",
            "speakerId": 1002,
            "speakerName": "琴",
            "text": "请各位务必小心。我们走吧。"
          }
        }
      }
    },
    {
      "subId": "38408",
      "subQuestName": "Additional",
      "sceneId": null,

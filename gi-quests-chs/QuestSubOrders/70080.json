        "dialogs": {
          "700800101": {
            "id": "700800101",
            "speakerId": 22294,
            "speakerName": "维尼皮",
            "text": "生死线上走了一遭，我最想念的居然是啤酒的滋味。其次才是老师和赤王大人。",
            "nextDialogs": [
              "700800102"
            ]
          },
          "700800102": {
            "id": "700800102",
            "speakerId": 22296,
            "speakerName": "柯莎玛",
            "text": "啊，我都不知道你还喜欢喝酒。",
            "nextDialogs": [
              "700800103"
            ]
          },
          "700800103": {
            "id": "700800103",
            "speakerId": 22294,
            "speakerName": "维尼皮",
            "text": "以前给赤王陵运砖的时候，每天都有两大杯免费啤酒呢。",
            "nextDialogs": [
              "700800104"
            ]
          },
          "700800104": {
            "id": "700800104",
            "speakerId": 22294,
            "speakerName": "维尼皮",
            "text": "说来，复原的人里有莫基吗？",
            "nextDialogs": [
              "700800105"
            ]
          },
          "700800105": {
            "id": "700800105",
            "speakerId": 22295,
            "speakerName": "维特鲁威",
            "text": "没有。我感觉上面是准备违规处理他了。",
            "nextDialogs": [
              "700800106"
            ]
          },
          "700800106": {
            "id": "700800106",
            "speakerId": 22295,
            "speakerName": "维特鲁威",
            "text": "不知道我让他偷偷带上的纸条有没有派上用场。"
          }
        }
      }
    }
  ]

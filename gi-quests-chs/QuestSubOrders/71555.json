    {
      "subId": "7155517",
      "subQuestName": "痕迹对话3$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715551701"
        ],
        "dialogs": {
          "715551701": {
            "id": "715551701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？这里刻着字。",
            "nextDialogs": [
              "715551702"
            ]
          },
          "715551702": {
            "id": "715551702",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「他们要带我去山上，救救我。」",
            "nextDialogs": [
              "715551703"
            ]
          },
          "715551703": {
            "id": "715551703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一定是那位学者，我们快去山上吧！"
          }
        }
      }

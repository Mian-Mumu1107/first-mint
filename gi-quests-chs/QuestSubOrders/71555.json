    {
      "subId": "7155510",
      "subQuestName": "与爱拉尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715551001"
        ],
        "dialogs": {
          "715551001": {
            "id": "715551001",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "谢谢你们，我还以为我彻底完了…这帮盗宝团应该是一直在跟踪我。",
            "nextDialogs": [
              "715551002"
            ]
          },
          "715551002": {
            "id": "715551002",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "我对这片遗迹的研究刚刚有了进展，想着要是能挖出埋藏在这里的宝藏带回去就再好不过了…",
            "nextDialogs": [
              "715551003"
            ]
          },
          "715551003": {
            "id": "715551003",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "但是还没等我做好准备，盗宝团就闯进营地，把我给绑起来带到了这里。",
            "nextDialogs": [
              "715551004"
            ]
          },
          "715551004": {
            "id": "715551004",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "他们还一直逼问我宝藏的下落，还威胁我说，如果我不把宝藏地点说出来，他们就要了我的命。",
            "nextDialogs": [
              "715551005"
            ]
          },
          "715551005": {
            "id": "715551005",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "不过我知道，要是我直接把宝藏的线索告诉了他们，那我才是真不要命了…",
            "nextDialogs": [
              "715551006"
            ]
          },
          "715551006": {
            "id": "715551006",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "唉，我果然该听索拉雅小姐的话，考古学家最好别太在意宝藏，只要有学术上的收获就好。",
            "nextDialogs": [
              "715551007"
            ]
          },
          "715551007": {
            "id": "715551007",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "但是我的经费就这么一点，光是几篇论文，连我自己掏的来往路费都填不平…",
            "nextDialogs": [
              "715551008"
            ]
          },
          "715551008": {
            "id": "715551008",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "也不知道索拉雅小姐是怎么做到一个人在璃月研究这么久的，光是看她被拒的那么多论文，我都替她觉得累。",
            "nextDialogs": [
              "715551009"
            ]
          },
          "715551009": {
            "id": "715551009",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你接下来打算怎么办？",
            "nextDialogs": [
              "715551010"
            ]
          },
          "715551010": {
            "id": "715551010",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "还能怎么办，学术上的资料我已经搜集齐了，宝藏什么的…就算了，就让给你们吧。",
            "nextDialogs": [
              "715551011"
            ]
          },
          "715551011": {
            "id": "715551011",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "杂七杂八的推导过程我就不说啦，总之，宝藏就埋在灵矩关最中间的那棵<color=#00E1FFFF>金色大树下</color>。",
            "nextDialogs": [
              "715551012"
            ]
          },
          "715551012": {
            "id": "715551012",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "你们要的话就去拿吧，我把地址写下来给你们，免得你们忘了。",
            "nextDialogs": [
              "715551013"
            ]
          },
          "715551013": {
            "id": "715551013",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "我休息一会就回营地收拾东西，我要尽快离开这，免得又有盗宝团过来…",
            "nextDialogs": [
              "715551014"
            ]
          },
          "715551014": {
            "id": "715551014",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "不知道从这里走去望舒客栈要花多长时间，别等我到了望舒客栈，索拉雅小姐已经走了。",
            "nextDialogs": [
              "715551015"
            ]
          },
          "715551015": {
            "id": "715551015",
            "speakerId": 20088,
            "speakerName": "爱拉尼",
            "text": "唉，要是索拉雅小姐能做我的导师就好了…"
          }
        }
      }
    },
    {
      "subId": "7155511",
      "subQuestName": "获得宝藏",
      "sceneId": null,
      "locations": [],
      "dialogue": {

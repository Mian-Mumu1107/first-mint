  "subQuests": [
    {
      "subId": "50601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5060101"
        ],
        "dialogs": {
          "5060101": {
            "id": "5060101",
            "speakerId": 1000,
            "speakerName": "商店街告示板",
            "text": "此乃幕府所设商店街告示板，各种事务，尽皆公示。闲人请勿擅自张贴！"
          }
        }
      }
    },
    {
      "subId": "50602",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5060201"
        ],
        "dialogs": {
          "5060201": {
            "id": "5060201",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "近日有行踪可疑之外国人士进入稻妻城区，游荡不定，可见动机险恶。",
            "nextDialogs": [
              "5060202"
            ]
          },
          "5060202": {
            "id": "5060202",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "幕府特此通告：举报可疑人员可得重赏，包庇者必加严惩！",
            "nextDialogs": [
              "5060203"
            ]
          },
          "5060203": {
            "id": "5060203",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "常道恢弘，鸣神永恒。"
          }
        }
      }
    },
    {
      "subId": "50603",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5060301"
        ],
        "dialogs": {
          "5060301": {
            "id": "5060301",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "「眼狩令」行动已近尾声，但仍有少数私藏「神之眼」者藏匿。",
            "nextDialogs": [
              "5060302"
            ]
          },
          "5060302": {
            "id": "5060302",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "谨遵九条天领奉行孝行大人命令，服从九条裟罗大人指挥，追捕行动将尽可能不使用暴力，不侵扰民众。",
            "nextDialogs": [
              "5060303"
            ]
          },
          "5060303": {
            "id": "5060303",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "请大家放下心来，天领奉行决不以执行公务为借口，侵扰各位正常生活。",
            "nextDialogs": [
              "5060304"
            ]
          },
          "5060304": {
            "id": "5060304",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "以个人与九条家之名誉，九条天领奉行孝行特此向市民保证。"
          }
        }
      }
    },
    {
      "subId": "50604",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5060401"
        ],
        "dialogs": {
          "5060401": {
            "id": "5060401",
            "speakerId": 1002,
            "speakerName": "荒泷本大爷最强一斗",
            "text": "「九条天狗！本大爷来商店街了，你在哪里躲着呢！！」",
            "nextDialogs": [
              "5060402"
            ]
          },
          "5060402": {
            "id": "5060402",
            "speakerId": 1002,
            "speakerName": "荒泷本大爷最强一斗",
            "text": "「本大爷劝你快点钻出来！堂堂正正地来一场决斗！」",
            "nextDialogs": [
              "5060403"
            ]
          },
          "5060403": {
            "id": "5060403",
            "speakerId": 1002,
            "speakerName": "荒泷本大爷最强一斗",
            "text": "「那可是夺眼之仇啊，夺眼之仇！！」",
            "nextDialogs": [
              "5060404"
            ]
          },
          "5060404": {
            "id": "5060404",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "诸位市民不必惊惶，涂鸦者只是普通流氓。",
            "nextDialogs": [
              "5060405"
            ]
          },
          "5060405": {
            "id": "5060405",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "九条裟罗大人保证她与此人毫无关联，将尽快处理掉此条留言。"
          }
        }
      }
    },
    {
      "subId": "50605",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5060501"
        ],
        "dialogs": {
          "5060501": {
            "id": "5060501",
            "speakerId": 1004,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但希望这件事能够周知。」",
            "nextDialogs": [
              "5060502"
            ]
          },
          "5060502": {
            "id": "5060502",
            "speakerId": 1004,
            "speakerName": "八重堂的平冢",
            "text": "「泷泽京传先生那本著名的《鹮巷物语》孤本最近被我不慎搞丢了。」",
            "nextDialogs": [
              "5060503"
            ]
          },
          "5060503": {
            "id": "5060503",
            "speakerId": 1004,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但八重大人非要让我到处刊出寻书启示，真是伤脑筋。」",
            "nextDialogs": [
              "5060504"
            ]
          },
          "5060504": {
            "id": "5060504",
            "speakerId": 1004,
            "speakerName": "八重堂的平冢",
            "text": "「想想那本书也真是可怜，也许飞散得到处都是了吧…想要找到不太可能了。」",
            "nextDialogs": [
              "5060505"
            ]
          },
          "5060505": {
            "id": "5060505",
            "speakerId": 1004,
            "speakerName": "八重堂的平冢",
            "text": "「虽然不是什么大事，但假如有人能够帮忙找全该书，八重堂将会十分感谢。」"
          }
        }
      }
    },
    {
      "subId": "50606",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5060601"
        ],
        "dialogs": {
          "5060601": {
            "id": "5060601",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「就要告别父母与妹妹了。尽管出身武家，一想到战争，心里就会不安。」",
            "nextDialogs": [
              "5060602"
            ]
          },
          "5060602": {
            "id": "5060602",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「战争是必要的吗？大御所殿下真的对这场战争、对我们每个人负责吗？」",
            "nextDialogs": [
              "5060603"
            ]
          },
          "5060603": {
            "id": "5060603",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「或许作为武士，现在并非质疑的时刻。」",
            "nextDialogs": [
              "5060604"
            ]
          },
          "5060604": {
            "id": "5060604",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "身为武士，尤其不应临阵怯战，质疑大御所将军殿下的决定。",
            "nextDialogs": [
              "5060605"
            ]
          },
          "5060605": {
            "id": "5060605",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "建议您为公开发布不当言论及时自首，将会从宽拘留教育处罚。",
            "nextDialogs": [
              "5060606"
            ]
          },
          "5060606": {
            "id": "5060606",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "该留言禁止污损、撤下，以儆效尤。"
          }
        }
      }
    },
    {
      "subId": "50607",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5060701"
        ],
        "dialogs": {
          "5060701": {
            "id": "5060701",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "诸位市民走夜路时敬请注意，近日稻妻城内外频有狸猫形状妖怪出没。",
            "nextDialogs": [
              "5060702"
            ]
          },
          "5060702": {
            "id": "5060702",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "此妖怪体态略似幼儿，行动速度极快，十分凶猛！",
            "nextDialogs": [
              "5060703"
            ]
          },
          "5060703": {
            "id": "5060703",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "如有发现，请速速告知附近同心，或报告町奉行所！",
            "nextDialogs": [
              "5060704"
            ]
          },
          "5060704": {
            "id": "5060704",
            "speakerId": 1006,
            "speakerName": "笔迹幼稚的留言",
            "text": "「都说了不是狸猫，不是狸猫，不是狸猫啦！！」",
            "nextDialogs": [
              "5060705"
            ]
          },
          "5060705": {
            "id": "5060705",
            "speakerId": 1006,
            "speakerName": "笔迹幼稚的留言",
            "text": "「是貉才对，是貉！！」"
          }
        }
      }
    },
    {
      "subId": "50608",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5060801"
        ],
        "dialogs": {
          "5060801": {
            "id": "5060801",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「由于近来形势原因，『小仓屋』经营遭遇了困难。我们不能坐视不管。」",
            "nextDialogs": [
              "5060802"
            ]
          },
          "5060802": {
            "id": "5060802",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「小仓小姐的父亲曾与我们同为九条家寄亲，我们这些老人若不互助，岂不令武士之名蒙羞？」",
            "nextDialogs": [
              "5060803"
            ]
          },
          "5060803": {
            "id": "5060803",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「小仓小姐请不必担心，我们还会召集更多老友同僚，尽力帮助您渡过难关。」",
            "nextDialogs": [
              "5060804"
            ]
          },
          "5060804": {
            "id": "5060804",
            "speakerId": 1007,
            "speakerName": "回复留言",
            "text": "「深蒙各位大人对已故家父的厚爱，但请容我斗胆拒绝…」",
            "nextDialogs": [
              "5060805"
            ]
          },
          "5060805": {
            "id": "5060805",
            "speakerId": 1007,
            "speakerName": "回复留言",
            "text": "「小小困难不值得大家花费心力，我相信仅靠我与兄长，一定能够克服。」",
            "nextDialogs": [
              "5060806"
            ]
          },
          "5060806": {
            "id": "5060806",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「小仓小姐颇有乃父之风。」"
          }
        }
      }
    },
    {
      "subId": "50609",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5060901"
        ],
        "dialogs": {
          "5060901": {
            "id": "5060901",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "请勿随处张贴传单！",
            "nextDialogs": [
              "5060902"
            ]
          },
          "5060902": {
            "id": "5060902",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "如有发现擅自张贴传单者，必严惩无赦！！"
          }
        }
      }
    },
    {
      "subId": "50610",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5061001"
        ],
        "dialogs": {
          "5061001": {
            "id": "5061001",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「木漏茶室的梢小姐很可爱。」",
            "nextDialogs": [
              "5061002"
            ]
          },
          "5061002": {
            "id": "5061002",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「虽然舌头很毒，脾气也很差，用刀背敲人超痛…」",
            "nextDialogs": [
              "5061003"
            ]
          },
          "5061003": {
            "id": "5061003",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「但是她真的好可爱。」",
            "nextDialogs": [
              "5061004"
            ]
          },
          "5061004": {
            "id": "5061004",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "町奉行所已受理梢小姐的报案，诸位市民如有线索请主动上报。",
            "nextDialogs": [
              "5061005"
            ]
          },
          "5061005": {
            "id": "5061005",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "此条留言留作笔迹识别所用，禁止故意污损、撤下。"
          }
        }
      }
    },
    {
      "subId": "50611",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5061101"
        ],
        "dialogs": {
          "5061101": {
            "id": "5061101",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「大将五郎到此一游。」",
            "nextDialogs": [
              "5061102"
            ]
          },
          "5061102": {
            "id": "5061102",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "请不要开如此恶劣的玩笑！"
          }
        }
      }
    },
    {
      "subId": "50612",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5061201"
        ],
        "dialogs": {
          "5061201": {
            "id": "5061201",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「此前拜见了神里笔头奉行绫人大人，没想到其人竟如此年轻。」",
            "nextDialogs": [
              "5061202"
            ]
          },
          "5061202": {
            "id": "5061202",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「相比其妹绫华公主更加坚毅稳重，神里家有此家主，前程不可限量…」",
            "nextDialogs": [
              "5061203"
            ]
          },
          "5061203": {
            "id": "5061203",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "「感谢谬赞家兄。」"
          }
        }
      }
    },
    {
      "subId": "50613",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5061301"
        ],
        "dialogs": {
          "5061301": {
            "id": "5061301",
            "speakerId": 1008,
            "speakerName": "通缉令",
            "text": "悬赏：吉野小平次、吉野小平太。",
            "nextDialogs": [
              "5061302"
            ]
          },
          "5061302": {
            "id": "5061302",
            "speakerId": 1008,
            "speakerName": "通缉令",
            "text": "罪名：逐电；劫盗；夜讨；谋害长官；向无辜村民散发财物，企图谋反。",
            "nextDialogs": [
              "5061303"
            ]
          },
          "5061303": {
            "id": "5061303",
            "speakerId": 1008,
            "speakerName": "通缉令",
            "text": "此二人活捉或正法，皆有重赏！"
          }
        }
      }
    },
    {
      "subId": "50614",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5061401"
        ],
        "dialogs": {
          "5061401": {
            "id": "5061401",
            "speakerId": 1008,
            "speakerName": "通缉令",
            "text": "悬赏：绿川四郎",
            "nextDialogs": [
              "5061402"
            ]
          },
          "5061402": {
            "id": "5061402",
            "speakerId": 1008,
            "speakerName": "通缉令",
            "text": "罪名：逐电；啸聚；海贼；抢劫官员；伏狩武士；诱拐老母为质，妄图对抗官府。",
            "nextDialogs": [
              "5061403"
            ]
          },
          "5061403": {
            "id": "5061403",
            "speakerId": 1008,
            "speakerName": "通缉令",
            "text": "此人及其党羽，活捉或正法，皆有重赏！"
          }
        }
      }
    },
    {
      "subId": "50615",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5061501"
        ],
        "dialogs": {
          "5061501": {
            "id": "5061501",
            "speakerId": 1009,
            "speakerName": "中介广告",
            "text": "「多亏九条天领奉行孝行大人深谋远虑，『眼狩令』之施行迅疾如电，妄图大逆者皆弃家而逃。」",
            "nextDialogs": [
              "5061502"
            ]
          },
          "5061502": {
            "id": "5061502",
            "speakerId": 1009,
            "speakerName": "中介广告",
            "text": "「今特将逃亡者遗弃之房屋低价出租、出售，天领奉行担保责任，房源绝对安全！」"
          }
        }
      }
    },
    {
      "subId": "50616",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5061601"
        ],
        "dialogs": {
          "5061601": {
            "id": "5061601",
            "speakerId": 1010,
            "speakerName": "鸣神大社公告",
            "text": "经宫司八重神子大人许可，鸣神大社将向受战争影响之贫困商户、困难家庭发放无息扶助贷款、慰问粮等补助福利。",
            "nextDialogs": [
              "5061602"
            ]
          },
          "5061602": {
            "id": "5061602",
            "speakerId": 1010,
            "speakerName": "鸣神大社公告",
            "text": "请有需要者携带齐全证件诣神里家府上办理相关手续。",
            "nextDialogs": [
              "5061603"
            ]
          },
          "5061603": {
            "id": "5061603",
            "speakerId": 1010,
            "speakerName": "鸣神大社公告",
            "text": "由于战事绵延，公帑稍紧，近日慰问粮补助限额降低至二分之一，敬请见谅。",
            "nextDialogs": [
              "5061604"
            ]
          },
          "5061604": {
            "id": "5061604",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「感谢八重大人与社奉行大人为我们着想，只是每天来领取粮食的人太多了…」",
            "nextDialogs": [
              "5061605"
            ]
          },
          "5061605": {
            "id": "5061605",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「每天都有人领不到足量的粮食…这可怎么办是好。」",
            "nextDialogs": [
              "5061606"
            ]
          },
          "5061606": {
            "id": "5061606",
            "speakerId": 1010,
            "speakerName": "鸣神大社公告",
            "text": "十分遗憾，我们也没有更好的办法，八重大人与笔头奉行大人亦在努力奔走处理此种问题。"
          }
        }
      }
    },
    {
      "subId": "50617",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5061701"
        ],
        "dialogs": {
          "5061701": {
            "id": "5061701",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "同叛军的战争如今一路高歌猛进，只差最后一击便可平定乱党！",
            "nextDialogs": [
              "5061702"
            ]
          },
          "5061702": {
            "id": "5061702",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "还请诸位年轻武士勠力同心，共投讨伐大业！",
            "nextDialogs": [
              "5061703"
            ]
          },
          "5061703": {
            "id": "5061703",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "来参军吧！以免到安宁之时，为没能给国家出力而悔恨莫及！",
            "nextDialogs": [
              "5061704"
            ]
          },
          "5061704": {
            "id": "5061704",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "参军相关事宜请至町奉行所咨询。",
            "nextDialogs": [
              "5061705"
            ]
          },
          "5061705": {
            "id": "5061705",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "注意！已收到兵役证书的家庭，必须送出至少一位成年适龄人员！",
            "nextDialogs": [
              "5061706"
            ]
          },
          "5061706": {
            "id": "5061706",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「战争真是吞噬人的怪物…」",
            "nextDialogs": [
              "5061707"
            ]
          },
          "5061707": {
            "id": "5061707",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "未曾参军者，有何资格评判大义之战！正是叛贼被讨灭了，你们才能在这里指指点点！",
            "nextDialogs": [
              "5061708"
            ]
          },
          "5061708": {
            "id": "5061708",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「是这样吗？我的丈夫在八酝岛砍伤了我的弟弟，他可能以后再也没法下地走路了。」",
            "nextDialogs": [
              "5061709"
            ]
          },
          "5061709": {
            "id": "5061709",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「然后，我的丈夫也音讯全无…或许死在哪个叛贼手里，而那叛贼以前或许也是一位体面武士？」",
            "nextDialogs": [
              "5061710"
            ]
          },
          "5061710": {
            "id": "5061710",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「恕我看不出这战争义在何处。我不会再送人参军了。」",
            "nextDialogs": [
              "5061711"
            ]
          },
          "5061711": {
            "id": "5061711",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "不要以为匿名就能无责任诽谤，此等厌战言论皆是珊瑚宫叛贼之宣传战！",
            "nextDialogs": [
              "5061712"
            ]
          },
          "5061712": {
            "id": "5061712",
            "speakerId": 1001,
            "speakerName": "天领公告",
            "text": "征兵公告不容涂鸦！此等厌战人士一旦发现，必得重罚！"
          }
        }
      }
    },
    {
      "subId": "50618",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5061801"
        ],
        "dialogs": {
          "5061801": {
            "id": "5061801",
            "speakerId": 1010,
            "speakerName": "鸣神大社公告",
            "text": "「八重堂」读者交流会照常举行，来自幕府与叛军控制国土的读者皆受本社欢迎！",
            "nextDialogs": [
              "5061802"
            ]
          },
          "5061802": {
            "id": "5061802",
            "speakerId": 1010,
            "speakerName": "鸣神大社公告",
            "text": "虽然还在苦哈哈地打着仗，但在共同爱好面前，八重神子大人会一视同仁的！",
            "nextDialogs": [
              "5061803"
            ]
          },
          "5061803": {
            "id": "5061803",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "作为大社，大张旗鼓欢迎叛贼参加轻浮活动，是否有逾礼制？",
            "nextDialogs": [
              "5061804"
            ]
          },
          "5061804": {
            "id": "5061804",
            "speakerId": 1010,
            "speakerName": "鸣神大社公告",
            "text": "大御所将军殿下未曾禁止，即是可行。天领奉行方横加议论，是否有逾职责？",
            "nextDialogs": [
              "5061805"
            ]
          },
          "5061805": {
            "id": "5061805",
            "speakerId": 1010,
            "speakerName": "鸣神大社公告",
            "text": "况且，恰好生活在叛军治下的人民，何以被称为「叛贼」？"
          }
        }
      }
    },
    {
      "subId": "50619",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5061901"
        ],
        "dialogs": {
          "5061901": {
            "id": "5061901",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「从八酝岛前线短暂休假归来，父母似乎老了许多，妻子也更加憔悴了。」",
            "nextDialogs": [
              "5061902"
            ]
          },
          "5061902": {
            "id": "5061902",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「因为战争的缘故，没能多陪陪家人，真是对不起…」",
            "nextDialogs": [
              "5061903"
            ]
          },
          "5061903": {
            "id": "5061903",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「似乎稻妻城里也冷清了许多，以往无言不欢的朋友，如今也变得三缄其口。」",
            "nextDialogs": [
              "5061904"
            ]
          },
          "5061904": {
            "id": "5061904",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「奇怪，我还以为我寄回家里的战争故事他们都很喜欢呢…」"
          }
        }
      }
    },
    {
      "subId": "50620",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5062001"
        ],
        "dialogs": {
          "5062001": {
            "id": "5062001",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「老夫龙之助宣布，兵法道场自今日起永久关闭。」",
            "nextDialogs": [
              "5062002"
            ]
          },
          "5062002": {
            "id": "5062002",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「所谓『剑之道』，乃守护之术。不应作为弑兄戮弟的凶器而存在。」",
            "nextDialogs": [
              "5062003"
            ]
          },
          "5062003": {
            "id": "5062003",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「近年来，老夫见多了弟子相残的悲剧。虽不敢称慈父之心，为师的良知也深为受伤。」",
            "nextDialogs": [
              "5062004"
            ]
          },
          "5062004": {
            "id": "5062004",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「诸多罪孽，当是止时。」",
            "nextDialogs": [
              "5062005"
            ]
          },
          "5062005": {
            "id": "5062005",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「因此，永久关闭兵法道场，不再复出。亦严令弟子不许出仕九条家。」"
          }
        }
      }
    },
    {
      "subId": "50621",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5062101"
        ],
        "dialogs": {
          "5062101": {
            "id": "5062101",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「虽然承平日久，大家都不怎么愿意为了大人们的原因打仗…」",
            "nextDialogs": [
              "5062102"
            ]
          },
          "5062102": {
            "id": "5062102",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「但既然九条大人自己的长子也正在前线奋战，我们又有什么怨言呢？」",
            "nextDialogs": [
              "5062103"
            ]
          },
          "5062103": {
            "id": "5062103",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「而且听说公子政仁大人为人仁厚，体恤士卒，真希望能分配到他的麾下。」",
            "nextDialogs": [
              "5062104"
            ]
          },
          "5062104": {
            "id": "5062104",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「裟罗大人也好…虽然她治军严苛得出名，但绝对能做到赏罚公正，没有私心。」",
            "nextDialogs": [
              "5062105"
            ]
          },
          "5062105": {
            "id": "5062105",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「在天领奉行众中，像他们这样的领导实在不多…」",
            "nextDialogs": [
              "5062106"
            ]
          },
          "5062106": {
            "id": "5062106",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「不多评价长官了。请父母长辈宽心，我很快就能胜仗凯旋，为家门争光!」"
          }
        }
      }
    },
    {
      "subId": "50622",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "5062201"
        ],
        "dialogs": {
          "5062201": {
            "id": "5062201",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「要我说，就应该把离岛那些外国来的家伙们全都驱逐走！」",
            "nextDialogs": [
              "5062202"
            ]
          },
          "5062202": {
            "id": "5062202",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「战争久打不顺，『眼狩令』也没有结束，我就不信没有外国人从中干涉！」",
            "nextDialogs": [
              "5062203"
            ]
          },
          "5062203": {
            "id": "5062203",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「肯定是外国人有什么渠道，一直在往我们国内输送神之眼和反贼…」",
            "nextDialogs": [
              "5062204"
            ]
          },
          "5062204": {
            "id": "5062204",
            "speakerId": 1005,
            "speakerName": "留言",
            "text": "「只要『锁国令』再彻底一点，这些问题早就迎刃而解了！」",
            "nextDialogs": [
              "5062205"
            ]
          },
          "5062205": {
            "id": "5062205",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "请不要传播流言，污蔑外人！",
            "nextDialogs": [
              "5062206"
            ]
          },
          "5062206": {
            "id": "5062206",
            "speakerId": 1003,
            "speakerName": "回复",
            "text": "「眼狩令」与弹压叛军的战事皆顺利无虞，毫无阻碍！"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7404408",
      "subQuestName": "（test）第二次提交完成对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740441001"
        ],
        "dialogs": {
          "740441001": {
            "id": "740441001",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "#哇啊，这就是「培根」吗！非常感谢，{NICKNAME}，还有派蒙小姐！",
            "nextDialogs": [
              "740441002"
            ]
          },
          "740441002": {
            "id": "740441002",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "不过，和薇蕾想象中的似乎不太一样呢。要怎么烹饪才好呢…",
            "nextDialogs": [
              "740441003"
            ]
          },
          "740441003": {
            "id": "740441003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "培根的话，不管怎么烹饪都会很美味喔！",
            "nextDialogs": [
              "740441004"
            ]
          },
          "740441004": {
            "id": "740441004",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "真的吗？薇蕾娜妲不太懂，但是会加油的！"
          }
        }
      }
    },
    {
      "subId": "7404421",

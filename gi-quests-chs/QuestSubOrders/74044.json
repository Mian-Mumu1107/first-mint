  },
  "subQuests": [
    {
      "subId": "7404402",
      "subQuestName": "（test）瑟琳第一次赠送零件对话控制$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740440501"
        ],
        "dialogs": {
          "740440501": {
            "id": "740440501",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "终于注意到这边啦！你们好呀，个子高高的陌生人，还有…",
            "nextDialogs": [
              "740440502"
            ]
          },
          "740440502": {
            "id": "740440502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#我是派蒙，然后{M#他}{F#她}是{NICKNAME}。",
            "nextDialogs": [
              "740440503"
            ]
          },
          "740440503": {
            "id": "740440503",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "#嗯嗯，记住了！{NICKNAME}{M#哥哥}{F#妹妹}，还有派蒙妹妹，欢迎来到海沫村！",
            "nextDialogs": [
              "740440504"
            ]
          },
          "740440504": {
            "id": "740440504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "妹妹…？",
            "nextDialogs": [
              "740440505"
            ]
          },
          "740440505": {
            "id": "740440505",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "#{M#啊…抱歉抱歉，平时照顾村子里的大家习惯了，派蒙小姐看上去也需要照顾，所以一不留神就…}{F#啊…抱歉抱歉，平时照顾村子里的大家习惯了，看到你们，一不留神就…}",
            "nextDialogs": [
              "740440506"
            ]
          },
          "740440506": {
            "id": "740440506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#{M#派蒙好像也确实需要照顾…}{F#没必要道歉。}",
            "nextDialogs": [
              "740440507"
            ]
          },
          "740440507": {
            "id": "740440507",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{M#喂！我也经常照顾你吧！}{F#是呀是呀，没必要那么拘束的！叫什么都可以啦！}",
            "nextDialogs": [
              "740440508"
            ]
          },
          "740440508": {
            "id": "740440508",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，你是…",
            "nextDialogs": [
              "740440509"
            ]
          },
          "740440509": {
            "id": "740440509",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "我是瑟琳，叫我瑟琳就好啦。",
            "nextDialogs": [
              "740440510"
            ]
          },
          "740440510": {
            "id": "740440510",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "刚才，我听到你们说要收集零件…是发生了什么事吗？",
            "nextDialogs": [
              "740440511"
            ]
          },
          "740440511": {
            "id": "740440511",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "将之前发生的事情告诉了瑟琳…",
            "nextDialogs": [
              "740440512"
            ]
          },
          "740440512": {
            "id": "740440512",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "没想到会发生这样的事情…看来，必须要立刻上报给那维莱特大人才行呢。",
            "nextDialogs": [
              "740440513"
            ]
          },
          "740440513": {
            "id": "740440513",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "#谢谢你们，{NICKNAME}{M#哥哥}{F#妹妹}，派蒙妹妹。要是没有你们在的话，一定会发生更糟糕的事情吧。",
            "nextDialogs": [
              "740440514"
            ]
          },
          "740440514": {
            "id": "740440514",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过，西摩尔还是被打坏了…",
            "nextDialogs": [
              "740440515"
            ]
          },
          "740440515": {
            "id": "740440515",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "嗯嗯…所以才需要收集零件吗？",
            "nextDialogs": [
              "740440516"
            ]
          },
          "740440516": {
            "id": "740440516",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是呀，虽然现在还不清楚要怎么修啦…不过，先收集一些零件，之后应该也可以去枫丹科学院之类的地方找人修理…",
            "nextDialogs": [
              "740440517"
            ]
          },
          "740440517": {
            "id": "740440517",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "既然是这样的话，那就请先收下这些吧。",
            "nextDialogs": [
              "740440518"
            ]
          },
          "740440518": {
            "id": "740440518",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？这个是…零件？要直接给我们吗？",
            "nextDialogs": [
              "740440524",
              "740440521"
            ]
          },
          "740440524": {
            "id": "740440524",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "应该是我要说谢谢才对呀。谢谢你们，愿意帮忙照顾玛梅赫。",
            "nextDialogs": [
              "740440525"
            ]
          },
          "740440525": {
            "id": "740440525",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "那孩子，平时也总是独自待着，有什么事情也不肯和我说…",
            "nextDialogs": [
              "740440526"
            ]
          },
          "740440526": {
            "id": "740440526",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "所以，能看到她和其他人开开心心地聊天，而且还是和外面的人类朋友…嗯，真的很欣慰呢。",
            "nextDialogs": [
              "740440527"
            ]
          },
          "740440527": {
            "id": "740440527",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "不过，要是我有更多零件的话，说不定就可以直接解决问题了吧？果然，还是要更努力才行，这样才能更好地帮到大家…",
            "nextDialogs": [
              "740440528"
            ]
          },
          "740440528": {
            "id": "740440528",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "已经帮到我们啦。总之，这些零件我们就先收下啦，谢谢你，瑟琳！",
            "nextDialogs": [
              "740440529"
            ]
          },
          "740440529": {
            "id": "740440529",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对了，从哪里可以找到更多零件呢？",
            "nextDialogs": [
              "740440530"
            ]
          },
          "740440530": {
            "id": "740440530",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "嗯…我想想，在村子附近转一转，如果运气好的话，说不定会捡到散落的零件。",
            "nextDialogs": [
              "740440531"
            ]
          },
          "740440531": {
            "id": "740440531",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "不过，只靠这种方式，效率可能还是太低了…",
            "nextDialogs": [
              "740440532"
            ]
          },
          "740440532": {
            "id": "740440532",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "所以，要不然去问一下村子里的大家，看看她们有没有什么需要帮助的事情吧？这样的话，大家应该也会把零件送给你们喔。"
          },
          "740440521": {
            "id": "740440521",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "#欸？啊，不是的，不是为了让{NICKNAME}{M#哥哥}{F#妹妹}帮忙做什么事啦！",
            "nextDialogs": [
              "740440522"
            ]
          },
          "740440522": {
            "id": "740440522",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "#只是，{NICKNAME}也好，玛梅赫那孩子也好，现在需要零件吧？所以，只要收下就好啦！",
            "nextDialogs": [
              "740440523"
            ]
          },
          "740440523": {
            "id": "740440523",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢。"
          }
        }
      }
    },
    {
      "subId": "7404404",
      "subQuestName": "（test）瑟琳完成第一次赠送零件任务后隔离$HIDDEN",
      "sceneId": null,
      "locations": [],

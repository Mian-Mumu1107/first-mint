        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7404422",
      "subQuestName": "（test）瑟琳第二次赠送零件对话控制$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740442402"
        ],
        "dialogs": {
          "740442402": {
            "id": "740442402",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？怎么了，瑟琳？主动叫住我们，有什么事吗？",
            "nextDialogs": [
              "740442403"
            ]
          },
          "740442403": {
            "id": "740442403",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "嗯嗯，是这样的！两位之前说，要去收集零件，对吧？",
            "nextDialogs": [
              "740442404"
            ]
          },
          "740442404": {
            "id": "740442404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "收集零件…啊，是说之前修理西摩尔的事情吧！",
            "nextDialogs": [
              "740442405"
            ]
          },
          "740442405": {
            "id": "740442405",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "#是呀，那个时候，我手边只剩下很少一些零件了，所以没能帮上{NICKNAME}和派蒙的忙…",
            "nextDialogs": [
              "740442406"
            ]
          },
          "740442406": {
            "id": "740442406",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "所以，在那之后，我又去收集了一些零件！",
            "nextDialogs": [
              "740442407"
            ]
          },
          "740442407": {
            "id": "740442407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！好多！",
            "nextDialogs": [
              "740442408"
            ]
          },
          "740442408": {
            "id": "740442408",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "请收下吧。这样一来，应该也能更快修好吧？",
            "nextDialogs": [
              "740442409"
            ]
          },
          "740442409": {
            "id": "740442409",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，虽然很谢谢你啦，不过西摩尔已经修好了…",
            "nextDialogs": [
              "740442410"
            ]
          },
          "740442410": {
            "id": "740442410",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "#欸？已经修好了吗？不愧是{NICKNAME}和派蒙！",
            "nextDialogs": [
              "740442411"
            ]
          },
          "740442411": {
            "id": "740442411",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "这样的话，就更应该把这些送给你们了呢！",
            "nextDialogs": [
              "740442412"
            ]
          },
          "740442412": {
            "id": "740442412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？",
            "nextDialogs": [
              "740442413"
            ]
          },
          "740442413": {
            "id": "740442413",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "#{NICKNAME}和派蒙一直在努力帮助大家，对吧？",
            "nextDialogs": [
              "740442414"
            ]
          },
          "740442414": {
            "id": "740442414",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "#既然如此，那就请{NICKNAME}和派蒙收下这些，作为来自我的谢礼吧。谢谢你们，愿意帮助村子里的大家！",
            "nextDialogs": [
              "740442415"
            ]
          },
          "740442415": {
            "id": "740442415",
            "speakerId": 5313,
            "speakerName": "瑟琳",
            "text": "正好，<color=#00E1FFFF>泽娜</color>现在也在村子里，如果有什么想要的东西，也可以用这些零件找她交换喔！"
          }
        }
      }
    },
    {
      "subId": "7404423",
      "subQuestName": "（test）瑟琳完成第二次赠送零件任务后隔离$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740442301"
        ],
        "dialogs": {
          "740442301": {
            "id": "740442301",
            "speakerId": 21236,
            "speakerName": "夏诺蒂拉",
            "text": "#啊，{NICKNAME}{M#哥哥}{F#姐姐}…",
            "nextDialogs": [
              "740442302"
            ]
          },
          "740442302": {
            "id": "740442302",
            "speakerId": 21236,
            "speakerName": "夏诺蒂拉",
            "text": "所以…呃，新的书页…",
            "nextDialogs": [
              "740442303"
            ]
          },
          "740442303": {
            "id": "740442303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不要再提书页啦！是你们刚才说的「那件事」啦，准备食材的事情！",
            "nextDialogs": [
              "740442304"
            ]
          },
          "740442304": {
            "id": "740442304",
            "speakerId": 21236,
            "speakerName": "夏诺蒂拉",
            "text": "#唔嗯…既然已经被听到了，那就没办法了。好，那就只能拉你们也一起入伙了，{NICKNAME}{M#哥哥}{F#姐姐}和派蒙！",
            "nextDialogs": [
              "740442305"
            ]
          },
          "740442305": {
            "id": "740442305",
            "speakerId": 21236,
            "speakerName": "夏诺蒂拉",
            "text": "#提问！{NICKNAME}{M#哥哥}{F#姐姐}，在你眼中，什么样的食材象征着「诞生」呢？",
            "nextDialogs": [
              "740442306"
            ]
          },
          "740442306": {
            "id": "740442306",
            "speakerId": 21236,
            "speakerName": "夏诺蒂拉",
            "text": "#「赐予生命」的食材，象征「新生」的食材，{NICKNAME}{M#哥哥}{F#姐姐}想必也已经明白了，我需要的是什么样的食材——",
            "nextDialogs": [
              "740442308",
              "740442311"
            ]
          },
          "740442308": {
            "id": "740442308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "？",
            "nextDialogs": [
              "740442309"
            ]
          },
          "740442309": {
            "id": "740442309",
            "speakerId": 21236,
            "speakerName": "夏诺蒂拉",
            "text": "…是鸟蛋啦，鸟蛋。",
            "nextDialogs": [
              "740442312"
            ]
          },
          "740442312": {
            "id": "740442312",
            "speakerId": 21236,
            "speakerName": "夏诺蒂拉",
            "text": "#{NICKNAME}{M#哥哥}{F#姐姐}应该也看得出来吧？我们美露莘的手很短，也没有办法爬树。所以，没办法采集鸟蛋。很困扰呢。"
          },
          "740442311": {
            "id": "740442311",
            "speakerId": 21236,
            "speakerName": "夏诺蒂拉",
            "text": "#哼哼，没错！就是鸟蛋！不愧是{NICKNAME}{M#哥哥}{F#姐姐}！"
          }
        }
      }
    },
    {
      "subId": "7404403",
      "subQuestName": "（test）开启瑟琳后续隐藏任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740440601"
        ],
        "dialogs": {
          "740440601": {
            "id": "740440601",
            "speakerId": 16473,
            "speakerName": "芙佳",
            "text": "呜，可是可是，虽然这么说，到底要送瑟琳姐姐什么好呢？",
            "nextDialogs": [
              "740440602"
            ]
          },
          "740440602": {
            "id": "740440602",
            "speakerId": 21236,
            "speakerName": "夏诺蒂拉",
            "text": "只要将「心意」传达到的话，不管送什么应该都没问题吧？",
            "nextDialogs": [
              "740440603"
            ]
          },
          "740440603": {
            "id": "740440603",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "嗯，卡莉珀丝大人也说过一样的话！",
            "nextDialogs": [
              "740440604"
            ]
          },
          "740440604": {
            "id": "740440604",
            "speakerId": 16473,
            "speakerName": "芙佳",
            "text": "「心意」…我想想，切瑟尔先生几天前刚送了一批新的钟表给我，但是过生日的话，送钟表会不会不太合适呀？",
            "nextDialogs": [
              "740440605"
            ]
          },
          "740440605": {
            "id": "740440605",
            "speakerId": 16473,
            "speakerName": "芙佳",
            "text": "毕竟，瑟琳姐姐一直在关心照顾大家，趁着这样的机会，芙佳还是想要送出能让她开心的礼物…",
            "nextDialogs": [
              "740440606"
            ]
          },
          "740440606": {
            "id": "740440606",
            "speakerId": 21236,
            "speakerName": "夏诺蒂拉",
            "text": "大家的想法都一样啦！不过，这么想想的话，送其他的东西，瑟琳也确实不会接受吧？「我不能收下这样贵重的东西」之类的。",
            "nextDialogs": [
              "740440607"
            ]
          },
          "740440607": {
            "id": "740440607",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "确实呢…",
            "nextDialogs": [
              "740440608"
            ]
          },
          "740440608": {
            "id": "740440608",
            "speakerId": 21236,
            "speakerName": "夏诺蒂拉",
            "text": "既然如此，不如就给她做一份好吃的东西吧！大家一起吃饭的话，「心意」自然就能传达到啦！",
            "nextDialogs": [
              "740440609"
            ]
          },
          "740440609": {
            "id": "740440609",
            "speakerId": 16473,
            "speakerName": "芙佳",
            "text": "哦哦，不愧是夏诺蒂拉姐姐！我们就一起做「那个」吧！",
            "nextDialogs": [
              "740440610"
            ]
          },
          "740440610": {
            "id": "740440610",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "欸？要做「那个」吗？可是，「那个」的食材，准备起来有些…",
            "nextDialogs": [
              "740440611"
            ]
          },
          "740440611": {
            "id": "740440611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "需要帮忙吗？",
            "nextDialogs": [
              "740440612"
            ]
          },
          "740440612": {
            "id": "740440612",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "欸？！呃，这个…",
            "nextDialogs": [
              "740440613"
            ]
          },
          "740440613": {
            "id": "740440613",
            "speakerId": 16473,
            "speakerName": "芙佳",
            "text": "#啊，是…是{NICKNAME}{M#哥哥}{F#姐姐}和派蒙…！",
            "nextDialogs": [
              "740440614"
            ]
          },
          "740440614": {
            "id": "740440614",
            "speakerId": 21236,
            "speakerName": "夏诺蒂拉",
            "text": "#啊哈哈…今天的天气也不错呢，{NICKNAME}{M#哥哥}{F#姐姐}！有没有找到新的书页呢？",
            "nextDialogs": [
              "740440615"
            ]
          },
          "740440615": {
            "id": "740440615",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？啊，如果是说「揭示之书」的话…",
            "nextDialogs": [
              "740440616"
            ]
          },
          "740440616": {
            "id": "740440616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对不对，不要转移话题啦！你们刚才说，是要为瑟琳准备——",
            "nextDialogs": [
              "740440617"
            ]
          },
          "740440617": {
            "id": "740440617",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "啊——啊！薇蕾娜妲突然想起来，还有笔记需要整理，我得赶快回去才行！",
            "nextDialogs": [
              "740440618"
            ]
          },
          "740440618": {
            "id": "740440618",
            "speakerId": 16473,
            "speakerName": "芙佳",
            "text": "#芙、芙佳也想起来了，今天是要和切瑟尔先生见面的日子呢！我也先走啦！再见，{NICKNAME}{M#哥哥}{F#姐姐}和派蒙！",
            "nextDialogs": [
              "740440619"
            ]
          },
          "740440619": {
            "id": "740440619",
            "speakerId": 21236,
            "speakerName": "夏诺蒂拉",
            "text": "唔…金色的蝴蝶…",
            "nextDialogs": [
              "740440620"
            ]
          },
          "740440620": {
            "id": "740440620",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等一下！欸，为什么都跑了啊！",
            "nextDialogs": [
              "740440623"
            ]
          },
          "740440623": {
            "id": "740440623",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，所以，她们几个是打算给瑟琳准备生日大餐吗？",
            "nextDialogs": [
              "740440624"
            ]
          },
          "740440624": {
            "id": "740440624",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么说来，我们好像还没有见识过美露莘们的料理呢！既然是生日宴会的话，料理应该也会相当豪华吧？",
            "nextDialogs": [
              "740440625"
            ]
          },
          "740440625": {
            "id": "740440625",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#呜啊，稍微有点期待起来了…{NICKNAME}，要不然我们也去找她们几个，一起帮忙准备吧！"
          }
        }
      }
    },
    {
      "subId": "7404418",
      "subQuestName": "（test）完成所有人的提交材料$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

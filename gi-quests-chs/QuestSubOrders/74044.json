    {
      "subId": "7404406",
      "subQuestName": "（test）第一次提交完成对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740440801"
        ],
        "dialogs": {
          "740440801": {
            "id": "740440801",
            "speakerId": 16473,
            "speakerName": "芙佳",
            "text": "#啊，谢谢你们，{NICKNAME}{M#哥哥}{F#姐姐}，还有派蒙！这样一来，就可以做出好吃的面饼来啦！",
            "nextDialogs": [
              "740440802"
            ]
          },
          "740440802": {
            "id": "740440802",

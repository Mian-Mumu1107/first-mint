          }
        }
      }
    },
    {
      "subId": "7404420",
      "subQuestName": "（test）与薇蕾娜妲对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740442201"
        ],
        "dialogs": {
          "740442201": {
            "id": "740442201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊，薇蕾娜妲，你在这里呀！",
            "nextDialogs": [
              "740442202"
            ]
          },
          "740442202": {
            "id": "740442202",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "#呃，那个…{NICKNAME}，还有派蒙小姐，找薇蕾有什么事吗？",
            "nextDialogs": [
              "740442203"
            ]
          },
          "740442203": {
            "id": "740442203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，关于你们刚才说的，给瑟琳准备料理的事情——",
            "nextDialogs": [
              "740442204"
            ]
          },
          "740442204": {
            "id": "740442204",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "请、请不要再说下去了…！",
            "nextDialogs": [
              "740442205"
            ]
          },
          "740442205": {
            "id": "740442205",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "那个…我们想要给瑟琳小姐一个惊喜，所以不打算把这件事告诉其他人，就连卡莉珀丝大人，也不知道这件事…",
            "nextDialogs": [
              "740442206"
            ]
          },
          "740442206": {
            "id": "740442206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不用担心啦，我们是绝对不会告诉其他人的！只是想要帮忙一起准备而已，这样也会更方便吧？",
            "nextDialogs": [
              "740442207"
            ]
          },
          "740442207": {
            "id": "740442207",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "#嗯…{NICKNAME}和派蒙小姐，确实一直都很可靠呢。既然这样，薇蕾娜妲想要拜托两位一件事…",
            "nextDialogs": [
              "740442208"
            ]
          },
          "740442208": {
            "id": "740442208",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "我们想要准备的料理，一般来说只会用到鱼肉。",
            "nextDialogs": [
              "740442209"
            ]
          },
          "740442209": {
            "id": "740442209",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "不过，卢蒂妮姐姐之前跟我提到过，在外面的世界里，有一种叫作「培根」的食物，非常美味，那维莱特大人也曾经吃过。",
            "nextDialogs": [
              "740442210"
            ]
          },
          "740442210": {
            "id": "740442210",
            "speakerId": 21069,
            "speakerName": "薇蕾娜妲",
            "text": "所以，薇蕾想，要是能拿到「培根」的话，说不定就可以制作出超厉害的料理…就像卡莉珀丝大人说的那样，「知识就是力量」！",
            "nextDialogs": [
              "740442212",
              "740442214"
            ]
          },
          "740442212": {
            "id": "740442212",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "关于食材的知识也算是知识吧…大概？",
            "nextDialogs": [
              "740442215"
            ]
          },
          "740442215": {
            "id": "740442215",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "总之，培根的事情，就交给我们好啦！"
          },
          "740442214": {
            "id": "740442214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "？"
          }
        }
      }
    },
    {
      "subId": "7404407",

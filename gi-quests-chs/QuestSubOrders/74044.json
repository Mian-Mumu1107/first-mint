    {
      "subId": "7404419",
      "subQuestName": "（test）与芙佳对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740442101"
        ],
        "dialogs": {
          "740442101": {
            "id": "740442101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "芙佳！关于你刚才说的事情…",
            "nextDialogs": [
              "740442102"
            ]
          },
          "740442102": {
            "id": "740442102",
            "speakerId": 16473,
            "speakerName": "芙佳",
            "text": "…呜！那个…那个应该是秘密来着，不可以告诉其他人的！就连希露艾姐姐也不可以告诉！",
            "nextDialogs": [
              "740442103"
            ]
          },
          "740442103": {
            "id": "740442103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别担心别担心，我们绝对不会告诉其他人啦！只是想要帮忙准备而已，多两个人的话，准备起来也会更方便吧？",
            "nextDialogs": [
              "740442104"
            ]
          },
          "740442104": {
            "id": "740442104",
            "speakerId": 16473,
            "speakerName": "芙佳",
            "text": "#欸？嗯…对喔！如果是{NICKNAME}{M#哥哥}{F#姐姐}和派蒙的话，一定能帮到忙的！",
            "nextDialogs": [
              "740442105"
            ]
          },
          "740442105": {
            "id": "740442105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对吧对吧！所以，有什么需要帮忙的呢？",
            "nextDialogs": [
              "740442106"
            ]
          },
          "740442106": {
            "id": "740442106",
            "speakerId": 16473,
            "speakerName": "芙佳",
            "text": "嗯…其他的食材收集起来都比较方便，但还是需要一些白白的、甜甜的…",
            "nextDialogs": [
              "740442107"
            ]
          },
          "740442107": {
            "id": "740442107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，是说糖吗？",
            "nextDialogs": [
              "740442108"
            ]
          },
          "740442108": {
            "id": "740442108",
            "speakerId": 16473,
            "speakerName": "芙佳",
            "text": "不，不是的！糖是相当危险的东西！呜，只要吃过一次的话，就会情不自禁地想要一直吃下去，最后…最后就会变得圆圆的…",
            "nextDialogs": [
              "740442112",
              "740442111"
            ]
          },
          "740442112": {
            "id": "740442112",
            "speakerId": 16473,
            "speakerName": "芙佳",
            "text": "总之，绝对不可以放糖！之前，芙佳差一点就坠入了那样的陷阱…不能让瑟琳姐姐也变成那样！",
            "nextDialogs": [
              "740442113"
            ]
          },
          "740442113": {
            "id": "740442113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可是，除了糖以外，还有什么白白的、甜甜的食材呢？"
          },
          "740442111": {
            "id": "740442111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！我一点也不圆啦！"
          }
        }
      }
    },
    {

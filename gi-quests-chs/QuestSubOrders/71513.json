  },
  "subQuests": [
    {
      "subId": "7151301",
      "subQuestName": "与绘星对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715130301"
        ],
        "dialogs": {
          "715130301": {
            "id": "715130301",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "还不错吧！所有装饰都是大姐头挑选的，她想让值岗的兄弟姐妹们有种待在家里过节的感觉！",
            "nextDialogs": [
              "715130302"
            ]
          },
          "715130302": {
            "id": "715130302",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "不仅如此，这次海灯节前，大姐头还给每个船员发了一笔奖金，组织了好几次盛大的聚餐。",
            "nextDialogs": [
              "715130303"
            ]
          },
          "715130303": {
            "id": "715130303",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "每次聚餐的饭菜都从有口皆碑的好店订购，除了我们常去的万民堂，还有新月轩和琉璃亭这样的大饭店。",
            "nextDialogs": [
              "715130304"
            ]
          },
          "715130304": {
            "id": "715130304",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "大家都吃饱喝足，心满意足！",
            "nextDialogs": [
              "715130305"
            ]
          },
          "715130305": {
            "id": "715130305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我也想看看！",
            "nextDialogs": [
              "715130306"
            ]
          },
          "715130306": {
            "id": "715130306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇，过节的奖金，还有大餐？真好啊…没想到，北斗也有这么细致的一面！",
            "nextDialogs": [
              "715130307"
            ]
          },
          "715130307": {
            "id": "715130307",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "其实大姐头一直都把船队的事务打理得天衣无缝哦。",
            "nextDialogs": [
              "715130308"
            ]
          },
          "715130308": {
            "id": "715130308",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "不止给我们这些船员发放了超优厚的薪水，以前过节的时候，还会给我们的家人准备礼物。",
            "nextDialogs": [
              "715130309"
            ]
          },
          "715130309": {
            "id": "715130309",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "之前，大姐头还从天权大人那里得到了一些商业情报，改进了「南十字」船队的经营策略。",
            "nextDialogs": [
              "715130310"
            ]
          },
          "715130310": {
            "id": "715130310",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "船队的收入大涨了一截，大姐头也提高了我们的待遇。如此一来，船员们就能以最佳状态迎接各种挑战了。",
            "nextDialogs": [
              "715130311"
            ]
          },
          "715130311": {
            "id": "715130311",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "即将到来的新人听说「南十字」船队的工作环境这么舒服，也会更有干劲。",
            "nextDialogs": [
              "715130314"
            ]
          },
          "715130314": {
            "id": "715130314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？海灯节期间，大家不都应该在放假吗？难道你们还要…加班？",
            "nextDialogs": [
              "715130315"
            ]
          },
          "715130315": {
            "id": "715130315",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "没那种事啦，你们放心！",
            "nextDialogs": [
              "715130316"
            ]
          },
          "715130316": {
            "id": "715130316",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "大姐头事先调查了所有人的意向，安排一部分船员提前放假，另一批船员则稍晚几天休息。",
            "nextDialogs": [
              "715130317"
            ]
          },
          "715130317": {
            "id": "715130317",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "这样一来，所有人得到了充足的假期，也不至于把「死兆星」号孤零零地晾在这里。",
            "nextDialogs": [
              "715130318"
            ]
          },
          "715130318": {
            "id": "715130318",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "我就属于前者，精神饱满地回到了岗位，好好规划我的训练考核「烟海梭巡」。",
            "nextDialogs": [
              "715130319"
            ]
          },
          "715130319": {
            "id": "715130319",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "盐海…什么巡？"
          }
        }
      }
    },
    {
      "subId": "7151301",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715130101"
        ],
        "dialogs": {
          "715130101": {
            "id": "715130101",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "#你们好啊，{NICKNAME}和派蒙，海灯节快乐！",
            "nextDialogs": [
              "715130102"
            ]
          },
          "715130102": {
            "id": "715130102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谢谢你哦，你也要开开心心！",
            "nextDialogs": [
              "715130103"
            ]
          },
          "715130103": {
            "id": "715130103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "海灯节快乐！",
            "nextDialogs": [
              "715130104"
            ]
          },
          "715130104": {
            "id": "715130104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "等等，你认识我们吗？请问你是…",
            "nextDialogs": [
              "715130105"
            ]
          },
          "715130105": {
            "id": "715130105",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "我叫绘星，是「南十字」船队的航海士。这次海灯节期间，也负责筹备一些船队相关的活动。",
            "nextDialogs": [
              "715130106"
            ]
          },
          "715130106": {
            "id": "715130106",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "我从北斗大姐头那里听说过你们的事迹，你们也是胆识过人的豪杰，令人钦佩！",
            "nextDialogs": [
              "715130107"
            ]
          },
          "715130107": {
            "id": "715130107",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "如果有什么关于「死兆星」号的问题，只要是我知道的，一定为你们作出最详细的解答！",
            "nextDialogs": [
              "715130108"
            ]
          },
          "715130108": {
            "id": "715130108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好客气！",
            "nextDialogs": [
              "715130109"
            ]
          },
          "715130109": {
            "id": "715130109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们确实想要仔细了解「死兆星」号啦，如果有什么好奇的事，肯定会来问你的。",
            "nextDialogs": [
              "715130110"
            ]
          },
          "715130110": {
            "id": "715130110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，这次「死兆星」号上就多了不少海货和装饰，和城里一样热闹呢！"
          }
        }
      }
    },
    {
      "subId": "7151302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715130201"
        ],
        "dialogs": {
          "715130201": {
            "id": "715130201",
            "speakerId": 2434,
            "speakerName": "绘星",
            "text": "#好久不见了，{NICKNAME}和派蒙，海灯节快乐呀！",
            "nextDialogs": [
              "715130202"
            ]
          },
          "715130202": {
            "id": "715130202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谢谢你哦，绘星小姐，你也要开开心心！",
            "nextDialogs": [
              "715130203"
            ]
          },
          "715130203": {
            "id": "715130203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "海灯节快乐！",
            "nextDialogs": [
              "715130204"
            ]
          },
          "715130204": {
            "id": "715130204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们发现「死兆星」号上多了不少海货和装饰，和城里一样热闹呢！"
          }
        }
      }
    }
  ]
}
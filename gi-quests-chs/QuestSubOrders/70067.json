      }
    },
    {
      "subId": "7006703",
      "subQuestName": "寻找说话声的来源",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700670301"
        ],
        "dialogs": {
          "700670301": {
            "id": "700670301",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "别过来！",
            "nextDialogs": [
              "700670302"
            ]
          },
          "700670302": {
            "id": "700670302",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "在这里想自己墓志铭要写什么实在太奢侈了。可不怕你们笑话，我已经想好了。",
            "nextDialogs": [
              "700670303"
            ]
          },
          "700670303": {
            "id": "700670303",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "「请把我的爱转交给帕特拉卫城的——」",
            "nextDialogs": [
              "700670304"
            ]
          },
          "700670304": {
            "id": "700670304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "维特鲁威！",
            "nextDialogs": [
              "700670305"
            ]
          },
          "700670305": {
            "id": "700670305",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "没说完就沙化了。",
            "nextDialogs": [
              "700670306"
            ]
          },
          "700670306": {
            "id": "700670306",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "完了。我在这个悲伤的时刻很想笑。真不知道沙化解除之后他会不会害羞得想死。",
            "nextDialogs": [
              "700670307"
            ]
          },
          "700670307": {
            "id": "700670307",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "您真乐观。",
            "nextDialogs": [
              "700670308"
            ]
          },
          "700670308": {
            "id": "700670308",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "现在是先处理那个守卫，还是争分夺秒搜索幸存者。我们要做出选择了。"
          }
        }
      }
    },
    {
      "subId": "7006704",
      "subQuestName": "与求救者对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700670401"
        ],
        "dialogs": {
          "700670401": {
            "id": "700670401",
            "speakerId": 1008,
            "speakerName": "？？？",
            "text": "你们…没见过啊。这个时候还会有新人上来吗？",
            "nextDialogs": [
              "700670402"
            ]
          },
          "700670402": {
            "id": "700670402",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "不过小右和你们在一起，应该是救兵吧。我叫维尼皮，来自赤王的神躯仍在的时代。",
            "nextDialogs": [
              "700670403"
            ]
          },
          "700670403": {
            "id": "700670403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#我叫派蒙，这位是{NICKNAME}。还有一位是彩特琳德。",
            "nextDialogs": [
              "700670404"
            ]
          },
          "700670404": {
            "id": "700670404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们，大概算是最近时代的人。",
            "nextDialogs": [
              "700670405"
            ]
          },
          "700670405": {
            "id": "700670405",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "彩特琳德…你是不是有个姐姐？",
            "nextDialogs": [
              "700670406"
            ]
          },
          "700670406": {
            "id": "700670406",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "你也认识我姐姐吗？",
            "nextDialogs": [
              "700670407"
            ]
          },
          "700670407": {
            "id": "700670407",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "那是自然，来到了这里，所有人和所有人都是朋友。不论之前的贤愚贵贱。",
            "nextDialogs": [
              "700670408"
            ]
          },
          "700670408": {
            "id": "700670408",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "我之前只是修筑赤王陵的建筑工，不过是个无足轻重小人物。",
            "nextDialogs": [
              "700670409"
            ]
          },
          "700670409": {
            "id": "700670409",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "那天我在沙漠里行路，突然就被提选了上来，丢进无想之间里待了…可能不到一百年？",
            "nextDialogs": [
              "700670410"
            ]
          },
          "700670410": {
            "id": "700670410",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "出来之后发现这里都是些古代人物，有的比赤王还要古老。但是我们一样可以交流。",
            "nextDialogs": [
              "700670411"
            ]
          },
          "700670411": {
            "id": "700670411",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "后来此处神明的姐妹和我说，没有提选沙漠的建筑，让我凭借记忆复原。",
            "nextDialogs": [
              "700670412"
            ]
          },
          "700670412": {
            "id": "700670412",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "还是靠大家帮忙才把这一片区域修出来的。可如今，你看看这断壁残垣。",
            "nextDialogs": [
              "700670413"
            ]
          },
          "700670413": {
            "id": "700670413",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说到这个，我想问了。外面那些人形沙雕，是你们赤王时代的…呃…艺术吗？",
            "nextDialogs": [
              "700670414"
            ]
          },
          "700670414": {
            "id": "700670414",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "比如用沙做成人，来警醒人物质身躯与生命之无常？",
            "nextDialogs": [
              "700670415"
            ]
          },
          "700670415": {
            "id": "700670415",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "…你和你姐姐真是完全不像。你一定和其他人一样很喜欢看书吧。",
            "nextDialogs": [
              "700670416"
            ]
          },
          "700670416": {
            "id": "700670416",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "那些是人。被惩罚而化成沙的人。",
            "nextDialogs": [
              "700670417"
            ]
          },
          "700670417": {
            "id": "700670417",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜啊！",
            "nextDialogs": [
              "700670418"
            ]
          },
          "700670418": {
            "id": "700670418",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "你放心，大家都还活着。这里不存在「死亡」。只要解决了这里的问题，他们都会复原的。",
            "nextDialogs": [
              "700670419"
            ]
          },
          "700670419": {
            "id": "700670419",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦对了，之前听到你说谁救了你，你就把赤王亲赏的钱币给他。",
            "nextDialogs": [
              "700670420"
            ]
          },
          "700670420": {
            "id": "700670420",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "一定是值不少钱的文物吧！",
            "nextDialogs": [
              "700670421"
            ]
          },
          "700670421": {
            "id": "700670421",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "哈哈，不给！那是我的幸运护符！还是我在地上生活的唯一纪念。",
            "nextDialogs": [
              "700670422"
            ]
          },
          "700670422": {
            "id": "700670422",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼，既然这么重要，我们就大发慈悲不收你这个报酬了。",
            "nextDialogs": [
              "700670423"
            ]
          },
          "700670423": {
            "id": "700670423",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "不对，好像它找上门来了！我们闲聊太久了！",
            "nextDialogs": [
              "700670424"
            ]
          },
          "700670424": {
            "id": "700670424",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "所以现在也不是说闲话的时候了。你有没有雷穆利亚入门级百夫长实力？",
            "nextDialogs": [
              "700670425"
            ]
          },
          "700670425": {
            "id": "700670425",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "又听到这个说法了，所以究竟是什么标准啊！"
          }
        }
      }
    },
    {
      "subId": "7006706",
      "subQuestName": "击败守护者",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7006707",
      "subQuestName": "与维尼皮对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700670701"
        ],
        "dialogs": {
          "700670701": {
            "id": "700670701",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "呼，真厉害啊。至少顶级百夫长级实力起步了！",
            "nextDialogs": [
              "700670702"
            ]
          },
          "700670702": {
            "id": "700670702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们赤王时代没有自己的体系吗？",
            "nextDialogs": [
              "700670703"
            ]
          },
          "700670703": {
            "id": "700670703",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "主要是因为大方广书阁的那些文化人看过的书多，排出来的战斗力更有理有据。",
            "nextDialogs": [
              "700670704"
            ]
          },
          "700670704": {
            "id": "700670704",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "有文化就是好啊。",
            "nextDialogs": [
              "700670705"
            ]
          },
          "700670705": {
            "id": "700670705",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "你知道吗？",
            "nextDialogs": [
              "700670706"
            ]
          },
          "700670706": {
            "id": "700670706",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "伊黎耶手下的骑士们平均能打三个标准雷穆利亚百夫长，但是都比伊黎耶低半级。",
            "nextDialogs": [
              "700670707"
            ]
          },
          "700670707": {
            "id": "700670707",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "鳄之王手下的梅德佳都不算精锐部队，但是擅长处理魔兽。实力大概在…",
            "nextDialogs": [
              "700670708"
            ]
          },
          "700670708": {
            "id": "700670708",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好了好了，我们还是先去救你的朋友们吧！",
            "nextDialogs": [
              "700670709"
            ]
          },
          "700670709": {
            "id": "700670709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可是我还想听。",
            "nextDialogs": [
              "700670710"
            ]
          },
          "700670710": {
            "id": "700670710",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "之后再说啦！"
          }
        }
      }
    },
    {

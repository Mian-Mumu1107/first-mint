    {
      "subId": "7006731",
      "subQuestName": "击败守护者",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7006732",
      "subQuestName": "寻找维特鲁威",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700671001"
        ],
        "dialogs": {
          "700671001": {
            "id": "700671001",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "维尼皮！你还活着，太好了！",
            "nextDialogs": [
              "700671002"
            ]
          },
          "700671002": {
            "id": "700671002",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "当然我知道这里死不掉。我意思是你没有变成沙子，这实在太好了。",
            "nextDialogs": [
              "700671003"
            ]
          },
          "700671003": {
            "id": "700671003",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "总之，你懂我意思就好。",
            "nextDialogs": [
              "700671004"
            ]
          },
          "700671004": {
            "id": "700671004",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "我懂。",
            "nextDialogs": [
              "700671005"
            ]
          },
          "700671005": {
            "id": "700671005",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "还有你们几位和小右，十分感谢。",
            "nextDialogs": [
              "700671006"
            ]
          },
          "700671006": {
            "id": "700671006",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "我什么都没做。",
            "nextDialogs": [
              "700671007"
            ]
          },
          "700671007": {
            "id": "700671007",
            "speakerId": 1009,
            "speakerName": "Black Screen",
            "text": "维尼皮和维特鲁威介绍了一下你们，并且说了刚才发生的事情…",
            "nextDialogs": [
              "700671008"
            ]
          },
          "700671008": {
            "id": "700671008",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "竟然是标准首席百夫长以上的实力！",
            "nextDialogs": [
              "700671009"
            ]
          },
          "700671009": {
            "id": "700671009",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "连我也开始对你战斗力的定级最终会是什么结果感兴趣了。",
            "nextDialogs": [
              "700671010"
            ]
          },
          "700671010": {
            "id": "700671010",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是吧是吧。",
            "nextDialogs": [
              "700671011"
            ]
          },
          "700671011": {
            "id": "700671011",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "那既然这样，我来带你们去找其他人吧。",
            "nextDialogs": [
              "700671012"
            ]
          },
          "700671012": {
            "id": "700671012",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "毕竟维尼皮只提供了赤王时代的建筑的纹样与装饰风格。这附近的大结构和路线是我负责的。",
            "nextDialogs": [
              "700671013"
            ]
          },
          "700671013": {
            "id": "700671013",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "没错，虽然看起来像是镀金时代的建筑，其实它集结了所有人的知识。"
          }
        }
      }
    },

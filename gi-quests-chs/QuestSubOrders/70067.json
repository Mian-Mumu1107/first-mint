    {
      "subId": "7006736",
      "subQuestName": "与幸存者对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700671501"
        ],
        "dialogs": {
          "700671501": {
            "id": "700671501",
            "speakerId": 1002,
            "speakerName": "柯莎玛",
            "text": "维尼皮！小右！还有劳姆希尔妲和陌生的朋友！谢谢你们！",
            "nextDialogs": [
              "700671502"
            ]
          },
          "700671502": {
            "id": "700671502",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "…我是她的妹妹，彩特琳德。",
            "nextDialogs": [
              "700671503"
            ]
          },
          "700671503": {
            "id": "700671503",
            "speakerId": 1002,
            "speakerName": "柯莎玛",
            "text": "这样啊，你们长得真像，都是小美人啊。我叫柯莎玛。我来自树…啊，我想说什么来着。",
            "nextDialogs": [
              "700671504"
            ]
          },
          "700671504": {
            "id": "700671504",
            "speakerId": 1002,
            "speakerName": "柯莎玛",
            "text": "这样啊，你们长得真像，都是小美人啊。我叫柯莎玛。我来自大慈树王的时代。",
            "nextDialogs": [
              "700671505"
            ]
          },
          "700671505": {
            "id": "700671505",
            "speakerId": 1002,
            "speakerName": "柯莎玛",
            "text": "草神大人还没变小的时代。",
            "nextDialogs": [
              "700671506"
            ]
          },
          "700671506": {
            "id": "700671506",
            "speakerId": 1009,
            "speakerName": "Black Screen",
            "text": "维尼皮和柯莎玛介绍了你们一行人，并且还说了维特鲁威的悲惨遭遇…",
            "nextDialogs": [
              "700671507"
            ]
          },
          "700671507": {
            "id": "700671507",
            "speakerId": 1009,
            "speakerName": "Black Screen",
            "text": "以及他想了数千年或许上万年的墓志铭。",
            "nextDialogs": [
              "700671508"
            ]
          },
          "700671508": {
            "id": "700671508",
            "speakerId": 1002,
            "speakerName": "柯莎玛",
            "text": "笑死我了。",
            "nextDialogs": [
              "700671509"
            ]
          },
          "700671509": {
            "id": "700671509",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "我没和你说过，你什么都不知道啊。",
            "nextDialogs": [
              "700671510"
            ]
          },
          "700671510": {
            "id": "700671510",
            "speakerId": 1002,
            "speakerName": "柯莎玛",
            "text": "可能很难瞒住，以后的日子里我看到维特鲁威就会想笑。",
            "nextDialogs": [
              "700671511"
            ]
          },
          "700671511": {
            "id": "700671511",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "好了，闲话不多说了。我们一路走来，好像也没漏什么地方了。",
            "nextDialogs": [
              "700671512"
            ]
          },
          "700671512": {
            "id": "700671512",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "还有其他人吗？",
            "nextDialogs": [
              "700671513"
            ]
          },
          "700671513": {
            "id": "700671513",
            "speakerId": 1002,
            "speakerName": "柯莎玛",
            "text": "恐怕已经没有了。",
            "nextDialogs": [
              "700671514"
            ]
          },
          "700671514": {
            "id": "700671514",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "那解除这个区域沙化的方法呢，你有什么头绪吗？",
            "nextDialogs": [
              "700671515"
            ]
          },
          "700671515": {
            "id": "700671515",
            "speakerId": 1002,
            "speakerName": "柯莎玛",
            "text": "我们之前的探索并没有什么收获。毕竟「沙上楼阁」的各位也不精通密仪与科学。",
            "nextDialogs": [
              "700671516"
            ]
          },
          "700671516": {
            "id": "700671516",
            "speakerId": 1002,
            "speakerName": "柯莎玛",
            "text": "所以还是只有众所周知的第一种方法，也就是打败「蛾摩拉的处罚者」。",
            "nextDialogs": [
              "700671517"
            ]
          },
          "700671517": {
            "id": "700671517",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "#不必担心，我们有雷穆利亚副军团长级别战斗力的{NICKNAME}在。",
            "nextDialogs": [
              "700671518"
            ]
          },
          "700671518": {
            "id": "700671518",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "啊，又升级了。",
            "nextDialogs": [
              "700671519"
            ]
          },
          "700671519": {
            "id": "700671519",
            "speakerId": 1002,
            "speakerName": "柯莎玛",
            "text": "但是「蛾摩拉的处罚者」隐藏了身形，我们找不到它。",
            "nextDialogs": [
              "700671520"
            ]
          },
          "700671520": {
            "id": "700671520",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "这倒是个问题。",
            "nextDialogs": [
              "700671521"
            ]
          },
          "700671521": {
            "id": "700671521",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "既然好不容易把你们救出来了，要不先逃离这里，回到主殿里吧？",
            "nextDialogs": [
              "700671522"
            ]
          },
          "700671522": {
            "id": "700671522",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那里还有伊斯托利亚和乔瑟夫斯。他们看起来懂很多的样子，说不定有办法呢？",
            "nextDialogs": [
              "700671523"
            ]
          },
          "700671523": {
            "id": "700671523",
            "speakerId": 1002,
            "speakerName": "柯莎玛",
            "text": "哦，伊斯托利亚没事啊。那太好了。他可是资历最老的人了，而且很好学。",
            "nextDialogs": [
              "700671524"
            ]
          },
          "700671524": {
            "id": "700671524",
            "speakerId": 1002,
            "speakerName": "柯莎玛",
            "text": "他在见闻、历史、文化方面，大概能算是全世界最博学的人了。",
            "nextDialogs": [
              "700671525"
            ]
          },
          "700671525": {
            "id": "700671525",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "那赶紧走吧。早点回去问清楚，早点把维特鲁威和大家救出来！"
          }
        }
      }
    },

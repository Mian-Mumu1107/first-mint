  },
  "subQuests": [
    {
      "subId": "7006701",
      "subQuestName": "前往「沙上楼阁」$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700670101"
        ],
        "dialogs": {
          "700670101": {
            "id": "700670101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里是哪里啊？这应该算是结束了吧？",
            "nextDialogs": [
              "700670102"
            ]
          },
          "700670102": {
            "id": "700670102",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "没错，结束了。大家都恢复了。",
            "nextDialogs": [
              "700670103"
            ]
          },
          "700670103": {
            "id": "700670103",
            "speakerId": 1002,
            "speakerName": "柯莎玛",
            "text": "……",
            "nextDialogs": [
              "700670104"
            ]
          },
          "700670104": {
            "id": "700670104",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "……",
            "nextDialogs": [
              "700670105"
            ]
          },
          "700670105": {
            "id": "700670105",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "怎么了，咬着嘴巴的。看到我太感动了忍不住要哭了吗？",
            "nextDialogs": [
              "700670106"
            ]
          },
          "700670106": {
            "id": "700670106",
            "speakerId": 1004,
            "speakerName": "柯莎玛&维尼皮",
            "text": "呵呵哈哈哈哈哈哈！",
            "nextDialogs": [
              "700670107"
            ]
          },
          "700670107": {
            "id": "700670107",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "哈哈哈哈…柯…莎玛，你不能，不能笑啊。这不、这不露馅了吗？",
            "nextDialogs": [
              "700670108"
            ]
          },
          "700670108": {
            "id": "700670108",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "你们笑得再大声，我也只是有一点尴尬而已。",
            "nextDialogs": [
              "700670109"
            ]
          },
          "700670109": {
            "id": "700670109",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "爱是命运，死也亦然。爱与死没什么好笑的！",
            "nextDialogs": [
              "700670110"
            ]
          },
          "700670110": {
            "id": "700670110",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "不笑了不笑了。",
            "nextDialogs": [
              "700670111"
            ]
          },
          "700670111": {
            "id": "700670111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对了，彩特琳德呢？",
            "nextDialogs": [
              "700670112"
            ]
          },
          "700670112": {
            "id": "700670112",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "我也不知道。我就在门外，被复原的大家也是。他们刚才还在拥抱呢。",
            "nextDialogs": [
              "700670113"
            ]
          },
          "700670113": {
            "id": "700670113",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "我让小斯卡帕别抱了，赶紧带着人回主殿区域去。然后我就一个人过来找你们了。",
            "nextDialogs": [
              "700670114"
            ]
          },
          "700670114": {
            "id": "700670114",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "按理说，大家应该都在这附近吧。那她应该不会很远才对啊。",
            "nextDialogs": [
              "700670115"
            ]
          },
          "700670115": {
            "id": "700670115",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "这是…",
            "nextDialogs": [
              "700670116"
            ]
          },
          "700670116": {
            "id": "700670116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是一个紫水晶胸针。",
            "nextDialogs": [
              "700670117"
            ]
          },
          "700670117": {
            "id": "700670117",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "是我手提箱里丢失的物件之一，是姐姐的东西。",
            "nextDialogs": [
              "700670118"
            ]
          },
          "700670118": {
            "id": "700670118",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来是这样啊。太好了，这样就找到一件了。",
            "nextDialogs": [
              "700670119"
            ]
          },
          "700670119": {
            "id": "700670119",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "应该是被当作现在这个时代的展品文物被放到这里来了吧。",
            "nextDialogs": [
              "700670120"
            ]
          },
          "700670120": {
            "id": "700670120",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "其实，我思考墓志铭写什么，也是因为你姐姐问了一句。那个墓志铭我可没想几千年。",
            "nextDialogs": [
              "700670121"
            ]
          },
          "700670121": {
            "id": "700670121",
            "speakerId": 1006,
            "speakerName": "劳姆希尔妲",
            "text": "在这里不会死吗？那岂不是没办法写那种精妙绝伦的墓志铭了？",
            "nextDialogs": [
              "700670122"
            ]
          },
          "700670122": {
            "id": "700670122",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "按我的以前的地位，大概是可以埋进祭司们的公墓，与银白枝条同眠的。",
            "nextDialogs": [
              "700670123"
            ]
          },
          "700670123": {
            "id": "700670123",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "这是很高的荣誉，但确实没地方写墓志铭。",
            "nextDialogs": [
              "700670124"
            ]
          },
          "700670124": {
            "id": "700670124",
            "speakerId": 1006,
            "speakerName": "劳姆希尔妲",
            "text": "那我绝对不要这种荣誉。因为我已经写好墓志铭了。",
            "nextDialogs": [
              "700670125"
            ]
          },
          "700670125": {
            "id": "700670125",
            "speakerId": 1006,
            "speakerName": "劳姆希尔妲",
            "text": "那就是——",
            "nextDialogs": [
              "700670126"
            ]
          },
          "700670126": {
            "id": "700670126",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "实在太谢谢你们了。",
            "nextDialogs": [
              "700670127"
            ]
          },
          "700670127": {
            "id": "700670127",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那你的赤王硬币？",
            "nextDialogs": [
              "700670128"
            ]
          },
          "700670128": {
            "id": "700670128",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "你就这么惦记啊。等我念诵完一万次对赤王大人的忏罪经文就给你吧。",
            "nextDialogs": [
              "700670129"
            ]
          },
          "700670129": {
            "id": "700670129",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "这人听柯莎玛说赤王陨落的事情之后，又怒又哭。「你骗我！」",
            "nextDialogs": [
              "700670137"
            ]
          },
          "700670137": {
            "id": "700670137",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "「你骗我！骗子！不可能！」",
            "nextDialogs": [
              "700670138"
            ]
          },
          "700670138": {
            "id": "700670138",
            "speakerId": 1001,
            "speakerName": "维特鲁威",
            "text": "讲道理，我觉得比我墓志铭好笑。",
            "nextDialogs": [
              "700670130"
            ]
          },
          "700670130": {
            "id": "700670130",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "算了算了。这么不情不愿的。",
            "nextDialogs": [
              "700670131"
            ]
          },
          "700670131": {
            "id": "700670131",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼，这个时候我们就要说，我们只是来帮彩特琳德找丢失的东西的。",
            "nextDialogs": [
              "700670132"
            ]
          },
          "700670132": {
            "id": "700670132",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "帮你们只是顺手哦！",
            "nextDialogs": [
              "700670133"
            ]
          },
          "700670133": {
            "id": "700670133",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "#…谢谢你们，派蒙、{NICKNAME}。",
            "nextDialogs": [
              "700670134"
            ]
          },
          "700670134": {
            "id": "700670134",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唉，没有没有。毕竟也是因为我们你才被卷进这些怪事里的。我们只是在弥补过失。",
            "nextDialogs": [
              "700670135"
            ]
          },
          "700670135": {
            "id": "700670135",
            "speakerId": 1003,
            "speakerName": "维尼皮",
            "text": "毫不掩饰的差别对待啊。",
            "nextDialogs": [
              "700670136"
            ]
          },
          "700670136": {
            "id": "700670136",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "我的感谢是真心的。"
          }
        }
      }
    },
    {
      "subId": "7006702",
      "subQuestName": "探索「沙上楼阁」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700670201"
        ],
        "dialogs": {
          "700670201": {
            "id": "700670201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "伊斯托利亚，你来啦！",
            "nextDialogs": [
              "700670202"
            ]
          },
          "700670202": {
            "id": "700670202",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "嗯，「沙上楼阁」的诸位回到主殿了。所以我就一路小跑来这里了。",
            "nextDialogs": [
              "700670203"
            ]
          },
          "700670203": {
            "id": "700670203",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "彩特琳德，你找回你丢失的东西了吗？",
            "nextDialogs": [
              "700670204"
            ]
          },
          "700670204": {
            "id": "700670204",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "劳您挂心，我已经找回来了。",
            "nextDialogs": [
              "700670205"
            ]
          },
          "700670205": {
            "id": "700670205",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "那太好了。",
            "nextDialogs": [
              "700670206"
            ]
          },
          "700670206": {
            "id": "700670206",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "说来，你们知道梅兰塔和尼西里塔名字的意思吗？",
            "nextDialogs": [
              "700670207"
            ]
          },
          "700670207": {
            "id": "700670207",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我先来，不知道！",
            "nextDialogs": [
              "700670208"
            ]
          },
          "700670208": {
            "id": "700670208",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "是，「忧郁」和「虚无」吧。",
            "nextDialogs": [
              "700670209"
            ]
          },
          "700670209": {
            "id": "700670209",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "你看的书很多啊。我能和你成为比和你姐姐更要好的朋友，因为兴趣一样。",
            "nextDialogs": [
              "700670210"
            ]
          },
          "700670210": {
            "id": "700670210",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "是的，姐姐是外向的户外派。不过我不认字的时候，她给我读过很多故事。",
            "nextDialogs": [
              "700670211"
            ]
          },
          "700670211": {
            "id": "700670211",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "这样的人是怎么被忧郁缠上的呢？",
            "nextDialogs": [
              "700670212"
            ]
          },
          "700670212": {
            "id": "700670212",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "当然，我说的是病理上的忧郁，不是上面那位俯瞰着我们苦难的守望。",
            "nextDialogs": [
              "700670213"
            ]
          },
          "700670213": {
            "id": "700670213",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "…她这些都和你说了吗？",
            "nextDialogs": [
              "700670214"
            ]
          },
          "700670214": {
            "id": "700670214",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "她和我说了之后我惊得下巴都掉了。如今的人们居然敢在空之神殿离地升天的遗址上修疗养院。",
            "nextDialogs": [
              "700670215"
            ]
          },
          "700670215": {
            "id": "700670215",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "你知道吗，最早，人们认为忧郁是生理上的病变。忧郁的词源是黑之胆。",
            "nextDialogs": [
              "700670216"
            ]
          },
          "700670216": {
            "id": "700670216",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "但随后，忧郁被认为是心因的心理疾病。",
            "nextDialogs": [
              "700670217"
            ]
          },
          "700670217": {
            "id": "700670217",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "正确的认识总是需要发展的嘛。",
            "nextDialogs": [
              "700670218"
            ]
          },
          "700670218": {
            "id": "700670218",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "但现在，人们再度发现了忧郁的真实。它其实也是病变哦。药物和陪伴都是不可或缺的。",
            "nextDialogs": [
              "700670219"
            ]
          },
          "700670219": {
            "id": "700670219",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "而我那个时代，早就知道了这一切。都是天使们直接告诉我们的。",
            "nextDialogs": [
              "700670220"
            ]
          },
          "700670220": {
            "id": "700670220",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "天使与后世风神的诗歌可以治疗忧郁，不代表一般人不痛不痒的安慰也可以。",
            "nextDialogs": [
              "700670221"
            ]
          },
          "700670221": {
            "id": "700670221",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "您想说什么？",
            "nextDialogs": [
              "700670222"
            ]
          },
          "700670222": {
            "id": "700670222",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "这个事情是秘密哦。我得小声点说。",
            "nextDialogs": [
              "700670223"
            ]
          },
          "700670223": {
            "id": "700670223",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "为什么执掌着天空与空间力量的伟大神明，会用虚无与忧郁作为造物的名字呢？",
            "nextDialogs": [
              "700670224"
            ]
          },
          "700670224": {
            "id": "700670224",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "据说是因为她缺乏共情能力。她无所不能，却对真正的无意徒劳以及人心之病束手无策。",
            "nextDialogs": [
              "700670225"
            ]
          },
          "700670225": {
            "id": "700670225",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "所以她用这两个她最不擅长对付的事物作为造物的名字。",
            "nextDialogs": [
              "700670226"
            ]
          },
          "700670226": {
            "id": "700670226",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好像可以理解她。不可战胜的宿敌名字听起来会很帅很强大。",
            "nextDialogs": [
              "700670227"
            ]
          },
          "700670227": {
            "id": "700670227",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#派蒙的宿敌叫做「没摩拉」和「肚子饿」和「没有{NICKNAME}」。",
            "nextDialogs": [
              "700670228"
            ]
          },
          "700670228": {
            "id": "700670228",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听起来很弱。",
            "nextDialogs": [
              "700670229"
            ]
          },
          "700670229": {
            "id": "700670229",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "我跟不上您上千年的智慧。",
            "nextDialogs": [
              "700670230"
            ]
          },
          "700670230": {
            "id": "700670230",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "哈哈哈，哪有什么智慧。",
            "nextDialogs": [
              "700670231"
            ]
          },
          "700670231": {
            "id": "700670231",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "我祈祷我有勇气可以放弃这一切，去换再活一次的机会。你明白吗？",
            "nextDialogs": [
              "700670232"
            ]
          },
          "700670232": {
            "id": "700670232",
            "speakerId": 1007,
            "speakerName": "伊斯托利亚",
            "text": "如果你需要帮助，请来找我吧。哪怕是，聊聊你姐姐的故事？",
            "nextDialogs": [
              "700670233"
            ]
          },
          "700670233": {
            "id": "700670233",
            "speakerId": 1005,
            "speakerName": "彩特琳德",
            "text": "我…我会的。"
          }
        }
      }
    },
    {
      "subId": "7006724",
      "subQuestName": "探索「沙上楼阁」",
      "sceneId": null,
      "locations": [],

{
  "lineCounts": {
    "Player": 8,
    "派蒙": 10,
    "科斯唐坦": 24
  },
  "subQuests": [
    {
      "subId": "7467701",
      "subQuestName": "与古怪的「剑客」对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "746770101"
        ],
        "dialogs": {
          "746770101": {
            "id": "746770101",
            "speakerId": 1000,
            "speakerName": "科斯唐坦",
            "text": "哈哈！两位仪表不凡的冒险家与我科斯唐坦在此相遇，实属缘分…",
            "nextDialogs": [
              "746770102"
            ]
          },
          "746770102": {
            "id": "746770102",
            "speakerId": 1000,
            "speakerName": "科斯唐坦",
            "text": "那么二位，请大声回答我——你们想战斗吗？",
            "nextDialogs": [
              "746770103"
            ]
          },
          "746770103": {
            "id": "746770103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好突然！这是什么展开话题的新把戏吗？",
            "nextDialogs": [
              "746770106"
            ]
          },
          "746770106": {
            "id": "746770106",
            "speakerId": 1000,
            "speakerName": "科斯唐坦",
            "text": "不，我并不是在挑战二位。",
            "nextDialogs": [
              "746770107"
            ]
          },
          "746770107": {
            "id": "746770107",
            "speakerId": 1000,
            "speakerName": "科斯唐坦",
            "text": "我所说的战斗，并非闲来无事发泄怒气的愚行，并非拦路贼匪的恶意阻截。",
            "nextDialogs": [
              "746770108"
            ]
          },
          "746770108": {
            "id": "746770108",
            "speakerId": 1000,
            "speakerName": "科斯唐坦",
            "text": "而是一种释放热情的颂歌，是赞美生命本能的艺术！",
            "nextDialogs": [
              "746770109"
            ]
          },
          "746770109": {
            "id": "746770109",
            "speakerId": 1000,
            "speakerName": "科斯唐坦",
            "text": "生命的演进赋予了我们持剑的手，我们也就有义务好好使用这双手，紧握漂亮的剑，优雅地战斗！",
            "nextDialogs": [
              "746770110"
            ]
          },
          "746770110": {
            "id": "746770110",
            "speakerId": 1000,
            "speakerName": "科斯唐坦",
            "text": "作为强大冒险家的二位，绝对是这个艺术领域的大师！",
            "nextDialogs": [
              "746770111"
            ]
          },
          "746770111": {
            "id": "746770111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你好像对战斗有什么误解，说得也太美好太夸张了。",
            "nextDialogs": [
              "746770112"
            ]
          },
          "746770112": {
            "id": "746770112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#就算我平常没有直接撸起袖子打过架，光看{NICKNAME}对付敌人也知道，战斗可是很辛苦的。",
            "nextDialogs": [
              "746770113"
            ]
          },
          "746770113": {
            "id": "746770113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且我们也没自报过身份，你怎么就肯定我们很能打呢？",
            "nextDialogs": [
              "746770114"
            ]
          },
          "746770114": {
            "id": "746770114",
            "speakerId": 1000,
            "speakerName": "科斯唐坦",
            "text": "这儿距离枫丹廷可不近，沿途的魔物可不少。二位不是一路拼杀过来的，难不成还是从天上掉下来的？"
          }
        }
      }
    }
  ]
}
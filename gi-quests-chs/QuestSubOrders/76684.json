  },
  "subQuests": [
    {
      "subId": "7668401",
      "subQuestName": "与恰斯卡对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "766840101"
        ],
        "dialogs": {
          "766840101": {
            "id": "766840101",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "那…成交？",
            "nextDialogs": [
              "766840102"
            ]
          },
          "766840102": {
            "id": "766840102",
            "speakerId": 1001,
            "speakerName": "夏沃蕾",
            "text": "成交。",
            "nextDialogs": [
              "766840103"
            ]
          },
          "766840103": {
            "id": "766840103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "成交什么？我是不是错过了什么重要的事？",
            "nextDialogs": [
              "766840104"
            ]
          },
          "766840104": {
            "id": "766840104",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "正式的说法，应该是确定签署一份备忘录——",
            "nextDialogs": [
              "766840105"
            ]
          },
          "766840105": {
            "id": "766840105",
            "speakerId": 1001,
            "speakerName": "夏沃蕾",
            "text": "《关于提升射手效能的联合训练备忘录》。",
            "nextDialogs": [
              "766840106"
            ]
          },
          "766840106": {
            "id": "766840106",
            "speakerId": 1001,
            "speakerName": "夏沃蕾",
            "text": "想来，招募恰斯卡小姐至特巡队，会对她的故乡纳塔造成不可估量的人才损失，不是明智之举。",
            "nextDialogs": [
              "766840107"
            ]
          },
          "766840107": {
            "id": "766840107",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "特巡队那宛如钟表的稳定运转，也离不开夏沃蕾队长每天的指挥调度，少了夏沃蕾队长，枫丹也会遇上不少麻烦。",
            "nextDialogs": [
              "766840108"
            ]
          },
          "766840108": {
            "id": "766840108",
            "speakerId": 1001,
            "speakerName": "夏沃蕾",
            "text": "要想达成我们的目标…",
            "nextDialogs": [
              "766840109"
            ]
          },
          "766840109": {
            "id": "766840109",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "就需要前所未有的合作方式。",
            "nextDialogs": [
              "766840110"
            ]
          },
          "766840110": {
            "id": "766840110",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这种惊人的默契是怎么回事…",
            "nextDialogs": [
              "766840113"
            ]
          },
          "766840113": {
            "id": "766840113",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "总之，经过和夏沃蕾队长的商讨，我们决定在三个月内，争取开始「交换代表长期进修」。",
            "nextDialogs": [
              "766840114"
            ]
          },
          "766840114": {
            "id": "766840114",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "这个方案能在最大程度减少负担的前提下，加强特巡队、「花羽会」与西风骑士团的合作。",
            "nextDialogs": [
              "766840115"
            ]
          },
          "766840115": {
            "id": "766840115",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "…是我理解的，字面意思上那么做吗？",
            "nextDialogs": [
              "766840116"
            ]
          },
          "766840116": {
            "id": "766840116",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你们两边互相派人，「花羽会」的勇士在枫丹住一段时间，特巡队的战士就去纳塔？",
            "nextDialogs": [
              "766840117"
            ]
          },
          "766840117": {
            "id": "766840117",
            "speakerId": 1001,
            "speakerName": "夏沃蕾",
            "text": "没错，只不过实践起来，就不止是「让两边的人各自去对方的国家旅居」那么简单了。",
            "nextDialogs": [
              "766840118"
            ]
          },
          "766840118": {
            "id": "766840118",
            "speakerId": 1000,
            "speakerName": "恰斯卡",
            "text": "进修代表的人选，驻地，每天的课程，模拟训练与实际演练的计划，经费的安排…种种细节都需要系统性的规划。",
            "nextDialogs": [
              "766840119"
            ]
          },
          "766840119": {
            "id": "766840119",
            "speakerId": 1001,
            "speakerName": "夏沃蕾",
            "text": "而且要盯住弱项，对症下药，比如，纳塔勇士不太关注编制学，枫丹射手几乎没有实践经验的动对动射击…",
            "nextDialogs": [
              "766840120"
            ]
          },
          "766840120": {
            "id": "766840120",
            "speakerId": 1001,
            "speakerName": "夏沃蕾",
            "text": "那就让纳塔勇士试着以班组为单位，严格分工行动；让绒翼龙抓着特巡队射手的双肩，低空飞行，截射靶标。",
            "nextDialogs": [
              "766840121"
            ]
          },
          "766840121": {
            "id": "766840121",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "听起来也太严格了！"
          }
        }
      }
    }
  ]
}
        "dialogs": {
          "140109901": {
            "id": "140109901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没办法，也要尊重芙宁娜的想法。",
            "nextDialogs": [
              "140109902"
            ]
          },
          "140109902": {
            "id": "140109902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对她来说，表演本身就会令她想起很多难受的往事吧。"
          }
        }
      }
    }
  ]
}
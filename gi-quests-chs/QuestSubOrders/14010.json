        ],
        "dialogs": {
          "140105101": {
            "id": "140105101",
            "speakerId": 13578,
            "speakerName": "劳维克",
            "text": "居然是芙宁娜大人，是不是有点过头了啊…",
            "nextDialogs": [
              "140105102"
            ]
          },
          "140105102": {
            "id": "140105102",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "不用这么紧张，我先为您倒杯水如何？"
          }
        }
      }
    },
    {
      "subId": "1401099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

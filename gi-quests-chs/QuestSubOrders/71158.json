    {
      "subId": "7115801",
      "subQuestName": "霄灯-蓝砚$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711580301"
        ],
        "dialogs": {
          "711580301": {
            "id": "711580301",
            "speakerId": 1093,
            "speakerName": "蓝砚",
            "text": "又编好了一盏，嗯，颜料也晾干了…",
            "nextDialogs": [
              "711580302"
            ]
          },
          "711580302": {
            "id": "711580302",
            "speakerId": 1093,
            "speakerName": "蓝砚",
            "text": "#{NICKNAME}，节日好呀。你也是来找我编霄灯的么？",
            "nextDialogs": [
              "711580305"
            ]
          },
          "711580305": {
            "id": "711580305",
            "speakerId": 1093,
            "speakerName": "蓝砚",
            "text": "你也放飞霄灯了？原来你自己准备了啊，我还说编一盏送给你呢。",
            "nextDialogs": [
              "711580306"
            ]
          },
          "711580306": {
            "id": "711580306",
            "speakerId": 1093,
            "speakerName": "蓝砚",
            "text": "但无论如何，希望我们写在霄灯上的心愿能全部实现。",
            "nextDialogs": [
              "711580304"
            ]
          },
          "711580304": {
            "id": "711580304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有很多人找你编霄灯么？",
            "nextDialogs": [
              "711580307"
            ]
          },
          "711580307": {
            "id": "711580307",
            "speakerId": 1093,
            "speakerName": "蓝砚",
            "text": "对呀，萍溪姐姐不是造出了一种可以随意改装的霄灯骨架么？",
            "nextDialogs": [
              "711580308"
            ]
          },
          "711580308": {
            "id": "711580308",
            "speakerId": 1093,
            "speakerName": "蓝砚",
            "text": "有好多人都去买了一架回家，琢磨着怎么改装呢。喔，嘉明也买了，我说我来帮他编，他还不让呢。",
            "nextDialogs": [
              "711580309"
            ]
          },
          "711580309": {
            "id": "711580309",
            "speakerId": 1093,
            "speakerName": "蓝砚",
            "text": "有些邻居虽然心里有想法，但却不知道怎么下手，所以就找我帮忙。",
            "nextDialogs": [
              "711580310"
            ]
          },
          "711580310": {
            "id": "711580310",
            "speakerId": 1093,
            "speakerName": "蓝砚",
            "text": "把大家的霄灯编好了之后，我也给自己编了一盏呢。",
            "nextDialogs": [
              "711580311"
            ]
          },
          "711580311": {
            "id": "711580311",
            "speakerId": 1093,
            "speakerName": "蓝砚",
            "text": "接下来就是放飞霄灯了，嗯…该写什么心愿呢…",
            "nextDialogs": [
              "711580312"
            ]
          },
          "711580312": {
            "id": "711580312",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "与蓝砚一同放飞了霄灯…"
          }
        }
      }
    },

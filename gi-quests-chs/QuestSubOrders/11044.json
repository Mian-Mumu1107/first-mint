        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1104415",
      "subQuestName": "(test)交付美味之后对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110440500"
        ],
        "dialogs": {
          "110440500": {
            "id": "110440500",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "唔，实验上看非常普通，但滋味实在美妙。你很有烹饪的天赋。",
            "nextDialogs": [
              "110440502"
            ]
          },
          "110440502": {
            "id": "110440502",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "我最期待的增殖现象并没有出现，看来就算是你的世界也无法摆脱食物的困扰。",
            "nextDialogs": [
              "110440503"
            ]
          },
          "110440503": {
            "id": "110440503",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "不对，可能是这个世界的法则限制了你的特殊能力？",
            "nextDialogs": [
              "110440504"
            ]
          },
          "110440504": {
            "id": "110440504",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "首先是不知道要怎么样把元素力，像调味品一样放进料理吧。",
            "nextDialogs": [
              "110440505"
            ]
          },
          "110440505": {
            "id": "110440505",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "没关系，至少没有浪费可口的食物，你们也不必感到沮丧。",
            "nextDialogs": [
              "110440506"
            ]
          },
          "110440506": {
            "id": "110440506",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "这里是答应要分享给你的那一份，慢慢享用吧，带走也没问题。",
            "nextDialogs": [
              "110440507"
            ]
          },
          "110440507": {
            "id": "110440507",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "谢谢你，居然好好地记得这件事！",
            "nextDialogs": [
              "110440510"
            ]
          },
          "110440510": {
            "id": "110440510",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "因为我能看出她是你很好的朋友，实验过程中她一直在提醒你，也在担心你的安危。",
            "nextDialogs": [
              "110440511"
            ]
          },
          "110440511": {
            "id": "110440511",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "虽然这些提醒和担心有没有起到作用，是需要另外讨论的…",
            "nextDialogs": [
              "110440512"
            ]
          },
          "110440512": {
            "id": "110440512",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "喂，不要突然说我坏话啊。",
            "nextDialogs": [
              "110440513"
            ]
          },
          "110440513": {
            "id": "110440513",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "不过你请我吃了好吃的，我愿意原谅你。",
            "nextDialogs": [
              "110440514"
            ]
          },
          "110440514": {
            "id": "110440514",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "也不用羡慕我们关系这么好啦。你不是也有朋友，还有学生吗？",
            "nextDialogs": [
              "110440515"
            ]
          },
          "110440515": {
            "id": "110440515",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "…嗯，是啊，我也算幸运的吧。不说这些了，我们进行下一项实验吧。",
            "nextDialogs": [
              "110440516"
            ]
          },
          "110440516": {
            "id": "110440516",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "炼金术用品种类繁杂，如何收纳存放是个令人头疼的问题。前不久因为意外，我的收藏品散落了一地。",
            "nextDialogs": [
              "110440517"
            ]
          },
          "110440517": {
            "id": "110440517",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "虽然大部分都找了回来，但有一瓶风晶蝶的元素萃取物，还有一瓶无相之雷的粉末，怎么都找不到了。",
            "nextDialogs": [
              "110440518"
            ]
          },
          "110440518": {
            "id": "110440518",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "做饭之后，接下来又是找东西？",
            "nextDialogs": [
              "110440519"
            ]
          },
          "110440519": {
            "id": "110440519",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "没关系，本来就打算重新制备了，只是如果能找到，就可以省去很多麻烦。",
            "nextDialogs": [
              "110440520"
            ]
          },
          "110440520": {
            "id": "110440520",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "假如你拥有「夜视」，或者「震动感知」之类的超能力，要找到遗失的小物件就是轻而易举了。",
            "nextDialogs": [
              "110440521"
            ]
          },
          "110440521": {
            "id": "110440521",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "东西应该就掉在之前你们参观过的地方的某个角落里。",
            "nextDialogs": [
              "110440522"
            ]
          },
          "110440522": {
            "id": "110440522",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "那…就只能试试看了？",
            "nextDialogs": [
              "110440523"
            ]
          },
          "110440523": {
            "id": "110440523",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "丢的东西好像都有元素力。",
            "nextDialogs": [
              "110440524"
            ]
          },
          "110440524": {
            "id": "110440524",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "对哦！可以用元素视野！"
          }
        }
      }
    },
    {
      "subId": "1104416",
      "subQuestName": "(test)交付普通之后对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {

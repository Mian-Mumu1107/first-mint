    {
      "subId": "1104401",
      "subQuestName": "与返回的阿贝多交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110440141"
        ],
        "dialogs": {
          "110440141": {
            "id": "110440141",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "我回来了，你们看到什么有意思的东西了吗？",
            "nextDialogs": [
              "110440143",
              "110440145"
            ]
          },
          "110440143": {
            "id": "110440143",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "没关系，只是一些炼金术的常用物件而已，生活中不太会用到。",
            "nextDialogs": [
              "110440146"
            ]
          },
          "110440146": {
            "id": "110440146",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "总之，抓紧时间进行下一项研究吧。",
            "nextDialogs": [
              "110440101"
            ]
          },
          "110440101": {
            "id": "110440101",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "不同的世界之间，可能存在非常大的差异。",
            "nextDialogs": [
              "110440102"
            ]
          },
          "110440102": {
            "id": "110440102",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "打个比方来说，在提瓦特，拥有神之眼的人就可以使用元素力。",
            "nextDialogs": [
              "110440103"
            ]
          },
          "110440103": {
            "id": "110440103",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "但也可能存在「只有一人可以使用元素力的世界」，又或者「每个人都能使用元素力的世界」。",
            "nextDialogs": [
              "110440104"
            ]
          },
          "110440104": {
            "id": "110440104",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "#所以，{NICKNAME}，除了元素之外…你是否还掌握一些，这个世界没有的特殊力量呢？",
            "nextDialogs": [
              "110440105"
            ]
          },
          "110440105": {
            "id": "110440105",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "还是只能用之前的办法，用实验来测定了。"
          },
          "110440145": {
            "id": "110440145",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "嗯，同感，我也正想找个时间收拾一下，不过实验一个接一个…"
          }
        }
      }
    },
    {
      "subId": "1104404",

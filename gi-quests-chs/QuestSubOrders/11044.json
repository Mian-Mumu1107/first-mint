    {
      "subId": "1104412",
      "subQuestName": "使用「元素视野」寻找失物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1104413",
      "subQuestName": "(test)回滚隔离$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110441301"
        ],
        "dialogs": {
          "110441301": {
            "id": "110441301",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "听到了一个很有意思的词，嗯，真是有趣。",
            "nextDialogs": [
              "110441302"
            ]
          },
          "110441302": {
            "id": "110441302",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "去找找看吧，我在这里等你。"
          }
        }
      }
    },
    {
      "subId": "1104403",
      "subQuestName": "与阿贝多交谈，获取结论",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110440320"
        ],
        "dialogs": {
          "110440320": {
            "id": "110440320",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "没想到你们真的全都找到了，非常感谢。",
            "nextDialogs": [
              "110440321"
            ]
          },
          "110440321": {
            "id": "110440321",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "寻找物品，还有之前来雪山找我的时候，用到的都是「元素视野」，对吧？",
            "nextDialogs": [
              "110440322"
            ]
          },
          "110440322": {
            "id": "110440322",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "是的，这个应该算是超能力吧？",
            "nextDialogs": [
              "110440323"
            ]
          },
          "110440323": {
            "id": "110440323",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "有点遗憾，虽然「元素视野」比较罕见，但是总归是提瓦特大陆存在的能力。",
            "nextDialogs": [
              "110440324"
            ]
          },
          "110440324": {
            "id": "110440324",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "只有完全没有听说过的异世界超能力，才能为我的研究提供帮助。",
            "nextDialogs": [
              "110440325"
            ]
          },
          "110440325": {
            "id": "110440325",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "也就是说，又白忙一场…",
            "nextDialogs": [
              "110440326"
            ]
          },
          "110440326": {
            "id": "110440326",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "不用太沮丧，这也在预料之中，而且能回收失物，这次实验已经非常有价值了。",
            "nextDialogs": [
              "110440301"
            ]
          },
          "110440301": {
            "id": "110440301",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "你们能够想到失物都具有元素力这一点，也值得称赞。",
            "nextDialogs": [
              "110440302"
            ]
          },
          "110440302": {
            "id": "110440302",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "好了，之前都是在研究异世界可能存在的与众不同之处，但是对于你人类的身份的研究，现在才要开始。",
            "nextDialogs": [
              "110440305"
            ]
          },
          "110440305": {
            "id": "110440305",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "人类的个体差异，集中体现在智能和身体机能的水平上，我们就从身体机能方面开始吧。",
            "nextDialogs": [
              "110440306"
            ]
          },
          "110440306": {
            "id": "110440306",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "从这里望出去，你可以看见砂糖她现在在做什么吗？",
            "nextDialogs": [
              "110440307"
            ]
          },
          "110440307": {
            "id": "110440307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不能。",
            "nextDialogs": [
              "110440308"
            ]
          },
          "110440308": {
            "id": "110440308",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "那如果你平地起跳，跳到那边的山崖上，能看到吗？",
            "nextDialogs": [
              "110440309"
            ]
          },
          "110440309": {
            "id": "110440309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不能。",
            "nextDialogs": [
              "110440310"
            ]
          },
          "110440310": {
            "id": "110440310",
            "speakerId": 1003,
            "speakerName": "阿贝多",
            "text": "那如果你一拳打碎面前的山体，能看到吗？"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "1203501",
      "subQuestName": "等到两天之后",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120350101"
        ],
        "dialogs": {
          "120350101": {
            "id": "120350101",
            "speakerId": 1000,
            "speakerName": "笹野",
            "text": "天领奉行的人，在离岛待了好几天了。",
            "nextDialogs": [
              "120350102"
            ]
          },
          "120350102": {
            "id": "120350102",
            "speakerId": 1001,
            "speakerName": "枫",
            "text": "他们是来接柊千里小姐的吧，这不该是件麻烦事才对…",
            "nextDialogs": [
              "120350103"
            ]
          },
          "120350103": {
            "id": "120350103",
            "speakerId": 1000,
            "speakerName": "笹野",
            "text": "我听说啊，勘定奉行的人好像突然不希望柊小姐离开了。",
            "nextDialogs": [
              "120350104"
            ]
          },
          "120350104": {
            "id": "120350104",
            "speakerId": 1000,
            "speakerName": "笹野",
            "text": "如果是我，我也会有点犯嘀咕，这么大一帮人来了离岛，谁知道他们想干什么呢？",
            "nextDialogs": [
              "120350105"
            ]
          },
          "120350105": {
            "id": "120350105",
            "speakerId": 1001,
            "speakerName": "枫",
            "text": "喂，你小声一点，被听到怎么办。",
            "nextDialogs": [
              "120350106"
            ]
          },
          "120350106": {
            "id": "120350106",
            "speakerId": 1000,
            "speakerName": "笹野",
            "text": "哦哦，不好意思。唉，怎么搞成这样嘛…"
          }
        }
      }
    },
    {
      "subId": "1203502",
      "subQuestName": "前往离岛确认情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120350201"
        ],
        "dialogs": {
          "120350201": {
            "id": "120350201",
            "speakerId": 1001,
            "speakerName": "枫",
            "text": "希望这件事快点结束吧。",
            "nextDialogs": [
              "120350202"
            ]
          },
          "120350202": {
            "id": "120350202",
            "speakerId": 1000,
            "speakerName": "笹野",
            "text": "是啊，勘定奉行在搞什么呢…"
          }
        }
      }
    },
    {
      "subId": "1203503",
      "subQuestName": "与离岛的人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1203504",
      "subQuestName": "与离岛的人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120350301"
        ],
        "dialogs": {
          "120350301": {
            "id": "120350301",
            "speakerId": 1002,
            "speakerName": "康明",
            "text": "老爷他们打算扛到什么时候啊…",
            "nextDialogs": [
              "120350302"
            ]
          },
          "120350302": {
            "id": "120350302",
            "speakerId": 1003,
            "speakerName": "秀夫",
            "text": "我也不知道，这进也不是，退也不是。",
            "nextDialogs": [
              "120350303"
            ]
          },
          "120350303": {
            "id": "120350303",
            "speakerId": 1003,
            "speakerName": "秀夫",
            "text": "这几天老爷的脾气特别怪，一点小事就会发很大的火，还疑神疑鬼的，我总是被骂…",
            "nextDialogs": [
              "120350304"
            ]
          },
          "120350304": {
            "id": "120350304",
            "speakerId": 1003,
            "speakerName": "秀夫",
            "text": "我理解他现在很焦虑，但…但怎么办嘛，我曾进言，千万别和社奉行大人作对。",
            "nextDialogs": [
              "120350305"
            ]
          },
          "120350305": {
            "id": "120350305",
            "speakerId": 1002,
            "speakerName": "康明",
            "text": "那个人，是啊…他从来不会做没有准备的事。",
            "nextDialogs": [
              "120350306"
            ]
          },
          "120350306": {
            "id": "120350306",
            "speakerId": 1002,
            "speakerName": "康明",
            "text": "接下来，要是柊小姐真的被接走，天领奉行会做什么，社奉行又会做什么…",
            "nextDialogs": [
              "120350307"
            ]
          },
          "120350307": {
            "id": "120350307",
            "speakerId": 1003,
            "speakerName": "秀夫",
            "text": "要不然，让老爷去和柊小姐商量一下吧。"
          }
        }
      }
    },
    {
      "subId": "1203505",
      "subQuestName": "与离岛的人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120350501"
        ],
        "dialogs": {
          "120350501": {
            "id": "120350501",
            "speakerId": 1004,
            "speakerName": "畑中",
            "text": "你好，你们有什么事吗？",
            "nextDialogs": [
              "120350504"
            ]
          },
          "120350504": {
            "id": "120350504",
            "speakerId": 1004,
            "speakerName": "畑中",
            "text": "我们前两天就过来了，想要将柊小姐接去稻妻城。",
            "nextDialogs": [
              "120350505"
            ]
          },
          "120350505": {
            "id": "120350505",
            "speakerId": 1004,
            "speakerName": "畑中",
            "text": "九条镰治大人的命令非常强硬，我们也坚决执行。可每每上门，柊家总是会找新的借口拖延这件事。",
            "nextDialogs": [
              "120350506"
            ]
          },
          "120350506": {
            "id": "120350506",
            "speakerId": 1004,
            "speakerName": "畑中",
            "text": "命令还没达成…我们索性留在离岛，直到柊小姐愿意跟我们走为止。"
          }
        }
      }
    },
    {
      "subId": "1203506",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120350601"
        ],
        "dialogs": {
          "120350601": {
            "id": "120350601",
            "speakerId": 1004,
            "speakerName": "畑中",
            "text": "总之，还请安心，我们会有分寸。"
          }
        }
      }
    },
    {
      "subId": "1203507",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120350701"
        ],
        "dialogs": {
          "120350701": {
            "id": "120350701",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "啊，是旅行者！",
            "nextDialogs": [
              "120350702"
            ]
          },
          "120350702": {
            "id": "120350702",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "外面发生的事你们都听说了吧，到底是怎么回事？",
            "nextDialogs": [
              "120350703"
            ]
          },
          "120350703": {
            "id": "120350703",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "别急别急，我们给你说明，事情是这样…",
            "nextDialogs": [
              "120350706"
            ]
          },
          "120350706": {
            "id": "120350706",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "在确保没人偷听的情况下，将整件事告诉了柊千里。",
            "nextDialogs": [
              "120350707"
            ]
          },
          "120350707": {
            "id": "120350707",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "天领奉行的人来了之后，他们突然变得很害怕，总是在秘密商量什么，又不许我跟天领奉行众直接接触。",
            "nextDialogs": [
              "120350708"
            ]
          },
          "120350708": {
            "id": "120350708",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "没想到是这样…原来都是神里大人的计划。这样就能解释他们的奇怪态度了。"
          }
        }
      }
    },
    {
      "subId": "1203508",
      "subQuestName": "与柊千里见面交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1203509",
      "subQuestName": "前往神里屋敷见神里绫人",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120350901"
        ],
        "dialogs": {
          "120350901": {
            "id": "120350901",
            "speakerId": 1008,
            "speakerName": "冈林",
            "text": "不用担心，和勘定奉行方面的交涉应该马上就会有结果了。"
          }
        }
      }
    },
    {
      "subId": "1203513",
      "subQuestName": "与神里绫人交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120350801"
        ],
        "dialogs": {
          "120350801": {
            "id": "120350801",
            "speakerId": 1009,
            "speakerName": "松浦",
            "text": "社奉行大人，相信您已经知道了…眼下离岛全是天领奉行的人，他们迫不及待地想要接走柊小姐。",
            "nextDialogs": [
              "120350802"
            ]
          },
          "120350802": {
            "id": "120350802",
            "speakerId": 1009,
            "speakerName": "松浦",
            "text": "之前种种，实在是多有冒犯，虽然这么说无比可笑，但…还请您大人有大量…",
            "nextDialogs": [
              "120350803"
            ]
          },
          "120350803": {
            "id": "120350803",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "抱歉啊松浦大人，我公务繁忙，稍后另有安排，恐怕没时间陪您寒暄了。",
            "nextDialogs": [
              "120350804"
            ]
          },
          "120350804": {
            "id": "120350804",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "有事的话，请您直白一点。",
            "nextDialogs": [
              "120350805"
            ]
          },
          "120350805": {
            "id": "120350805",
            "speakerId": 1009,
            "speakerName": "松浦",
            "text": "呃…",
            "nextDialogs": [
              "120350806"
            ]
          },
          "120350806": {
            "id": "120350806",
            "speakerId": 1009,
            "speakerName": "松浦",
            "text": "我知道我们的歉意不值一提，但眼下除了道歉，我们别无他法。实在对不起…凡是勘定奉行的人，从上到下都已明白事态的严重性。",
            "nextDialogs": [
              "120350807"
            ]
          },
          "120350807": {
            "id": "120350807",
            "speakerId": 1009,
            "speakerName": "松浦",
            "text": "柊小姐对我们来说不可或缺，我们保证会一如既往地支持她。",
            "nextDialogs": [
              "120350808"
            ]
          },
          "120350808": {
            "id": "120350808",
            "speakerId": 1009,
            "speakerName": "松浦",
            "text": "所以，能否请社奉行大人出面，再和九条大人商议一下呢？",
            "nextDialogs": [
              "120350809"
            ]
          },
          "120350809": {
            "id": "120350809",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "您说得可真容易呢。现在撤回告示，就是出尔反尔，只会让稻妻百姓看三奉行的笑话。关于这件事，您打算怎么办？",
            "nextDialogs": [
              "120350810"
            ]
          },
          "120350810": {
            "id": "120350810",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "扫三奉行的面子，无异于令将军大人蒙羞。雷霆万钧的怒意，您和您的同党担得起吗？",
            "nextDialogs": [
              "120350811"
            ]
          },
          "120350811": {
            "id": "120350811",
            "speakerId": 1009,
            "speakerName": "松浦",
            "text": "这个…我们会承担全部责任，发布新的公告，召开说明会，让百姓都知道这些都是源于一场误会。",
            "nextDialogs": [
              "120350812"
            ]
          },
          "120350812": {
            "id": "120350812",
            "speakerId": 1009,
            "speakerName": "松浦",
            "text": "尽量把影响降到最小，尽量…",
            "nextDialogs": [
              "120350813"
            ]
          },
          "120350813": {
            "id": "120350813",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "…松浦大人啊，早知如此，何必当初呢？",
            "nextDialogs": [
              "120350814"
            ]
          },
          "120350814": {
            "id": "120350814",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "不过确实如您所说，眼下无论我与九条大人的心情如何，三奉行都要以稻妻大局为重。",
            "nextDialogs": [
              "120350815"
            ]
          },
          "120350815": {
            "id": "120350815",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "放任事态扩大，离岛的形势或许会变得无法控制。柊小姐和岛上的百姓是无辜的。",
            "nextDialogs": [
              "120350816"
            ]
          },
          "120350816": {
            "id": "120350816",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "这件事影响颇大，若不及时遏止，也会引发流言蜚语，继而损害三奉行的声誉。",
            "nextDialogs": [
              "120350817"
            ]
          },
          "120350817": {
            "id": "120350817",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "您养只鸟试试便知道了。舌头伶俐的鸟雀，可能婉转啼鸣令人愉快，也可能叽叽喳喳扰人心神。",
            "nextDialogs": [
              "120350818"
            ]
          },
          "120350818": {
            "id": "120350818",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "更何况那些舌头过长，连宠物都当不成的东西…剪它们的舌头，一瞬间就够了。",
            "nextDialogs": [
              "120350819"
            ]
          },
          "120350819": {
            "id": "120350819",
            "speakerId": 1009,
            "speakerName": "松浦",
            "text": "…是…是的！",
            "nextDialogs": [
              "120350820"
            ]
          },
          "120350820": {
            "id": "120350820",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "您的来意我都明白。我会找九条大人谈谈，但不能担保他会回心转意。",
            "nextDialogs": [
              "120350821"
            ]
          },
          "120350821": {
            "id": "120350821",
            "speakerId": 1009,
            "speakerName": "松浦",
            "text": "我明白，社奉行大人肯帮忙就行！",
            "nextDialogs": [
              "120350822"
            ]
          },
          "120350822": {
            "id": "120350822",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "嗯。那么您也请回吧，勘定奉行手上一定还有许多烂摊子等着收拾，对吧？",
            "nextDialogs": [
              "120350896"
            ]
          },
          "120350896": {
            "id": "120350896",
            "speakerId": 1009,
            "speakerName": "松浦",
            "text": "好，那我就此告退…再次感谢社奉行大人！",
            "nextDialogs": [
              "120350823"
            ]
          },
          "120350823": {
            "id": "120350823",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "对了，柊小姐，我还有些话想和您说。请借一步吧。",
            "nextDialogs": [
              "120350824"
            ]
          },
          "120350824": {
            "id": "120350824",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "欸，好、好的…",
            "nextDialogs": [
              "120350825"
            ]
          },
          "120350825": {
            "id": "120350825",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "刚刚的神里大人就好像变了个人，我都不敢呼吸了。",
            "nextDialogs": [
              "120350826"
            ]
          },
          "120350826": {
            "id": "120350826",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "这样嚣张的家臣，确实需要一些严厉的训诫。我身为奉行，背负着将军大人的信任，自当如此。",
            "nextDialogs": [
              "120350827"
            ]
          },
          "120350827": {
            "id": "120350827",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "但抛去这层身份，站在我个人的立场，我特别想为您分享一段故事。",
            "nextDialogs": [
              "120350828"
            ]
          },
          "120350828": {
            "id": "120350828",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "嗯，神里大人请讲。",
            "nextDialogs": [
              "120350829"
            ]
          },
          "120350829": {
            "id": "120350829",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "您应该听说过，神里家曾有过一段特别艰难的时期。",
            "nextDialogs": [
              "120350830"
            ]
          },
          "120350830": {
            "id": "120350830",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "为弥补神里家很久之前犯下的错误，重振家族名望，我的父亲艰苦工作，过分辛劳以至于早衰。",
            "nextDialogs": [
              "120350831"
            ]
          },
          "120350831": {
            "id": "120350831",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "而深爱父亲的母亲，也在不久后离逝。",
            "nextDialogs": [
              "120350832"
            ]
          },
          "120350832": {
            "id": "120350832",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "突如其来的变故，令社奉行遭到巨大冲击，内部暗流涌动。",
            "nextDialogs": [
              "120350833"
            ]
          },
          "120350833": {
            "id": "120350833",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "每个人都觉得神里家失了势，我和我的妹妹，不过都是碍事的累赘。",
            "nextDialogs": [
              "120350834"
            ]
          },
          "120350834": {
            "id": "120350834",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "如今听来或许有些荒唐，但这确实是当年社奉行遭遇的真实情况。",
            "nextDialogs": [
              "120350835"
            ]
          },
          "120350835": {
            "id": "120350835",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "和现在的勘定奉行，有点像呢…",
            "nextDialogs": [
              "120350836"
            ]
          },
          "120350836": {
            "id": "120350836",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "那时的我只能接受现状，一边寻找强大的依靠，一边忍受诸多污蔑与盘剥。",
            "nextDialogs": [
              "120350837"
            ]
          },
          "120350837": {
            "id": "120350837",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "我别无选择。我背负着父母临终的嘱托，还要保护好年幼的妹妹。",
            "nextDialogs": [
              "120350838"
            ]
          },
          "120350838": {
            "id": "120350838",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "我自己变成什么样都无所谓，但唯有「家族」…我所珍视的「家族」，不可遭人践踏。",
            "nextDialogs": [
              "120350839"
            ]
          },
          "120350839": {
            "id": "120350839",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "所幸，我尽我所能坚持了下来，没让神里家就此没落。",
            "nextDialogs": [
              "120350840"
            ]
          },
          "120350840": {
            "id": "120350840",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "…我好像，有点明白了。我的迷茫与彷徨，源于何处…",
            "nextDialogs": [
              "120350841"
            ]
          },
          "120350841": {
            "id": "120350841",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "新之丞曾对我说，他比谁都清楚我的闪耀之处，所以才无法容忍我逆来顺受，成为他人的附庸…",
            "nextDialogs": [
              "120350842"
            ]
          },
          "120350842": {
            "id": "120350842",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "我内心深处的不安，我原以为是对婚姻的迷茫，实际上是我还太弱小，担心自己无法掌控现在的局面。",
            "nextDialogs": [
              "120350843"
            ]
          },
          "120350843": {
            "id": "120350843",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "九条大人之所以能坦率地面对这场婚姻，是因为他已经准备好了。",
            "nextDialogs": [
              "120350844"
            ]
          },
          "120350844": {
            "id": "120350844",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "…是啊，我现在的处境和那时的他，其实是一样的。",
            "nextDialogs": [
              "120350845"
            ]
          },
          "120350845": {
            "id": "120350845",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "他勇敢地朝将军大人举起了武器，而我现在…",
            "nextDialogs": [
              "120350846"
            ]
          },
          "120350846": {
            "id": "120350846",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "也应该像那时的他一样，成为完整的自己。",
            "nextDialogs": [
              "120350847"
            ]
          },
          "120350847": {
            "id": "120350847",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "如果您真正成长起来，相信您的父亲也会放手，让您决定您自己的人生。",
            "nextDialogs": [
              "120350848"
            ]
          },
          "120350848": {
            "id": "120350848",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "说来残酷，但这些，都是您追求幸福的「前提」。",
            "nextDialogs": [
              "120350849"
            ]
          },
          "120350849": {
            "id": "120350849",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "…嗯，我一定要做到。",
            "nextDialogs": [
              "120350850"
            ]
          },
          "120350850": {
            "id": "120350850",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "我会以这次的事为契机，接过柊家一直以来的责任。等一切稳定下来，再考虑成婚之事。",
            "nextDialogs": [
              "120350851"
            ]
          },
          "120350851": {
            "id": "120350851",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "那样，镰治承受的压力会更小，我也会拥有保护自己、支撑自己的力量，不必担心我和我的家族成为任何人的附庸或累赘。",
            "nextDialogs": [
              "120350852"
            ]
          },
          "120350852": {
            "id": "120350852",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "我对二位的祝福之情从来都是发自真心。待到你们成婚那时，我会再一次送上最真诚的祝词。",
            "nextDialogs": [
              "120350853"
            ]
          },
          "120350853": {
            "id": "120350853",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "感谢神里大人，没想到您愿意对我说这么多。",
            "nextDialogs": [
              "120350854"
            ]
          },
          "120350854": {
            "id": "120350854",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "那我告辞了，接下来家里还有很多事需要处理。",
            "nextDialogs": [
              "120350855"
            ]
          },
          "120350855": {
            "id": "120350855",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "柊小姐慢走。相信现在的您回到家中，无论说什么，他们都会尊重您的。",
            "nextDialogs": [
              "120350856"
            ]
          },
          "120350856": {
            "id": "120350856",
            "speakerId": 1005,
            "speakerName": "柊千里",
            "text": "嗯，这点我已经体会到了，再次感谢您。",
            "nextDialogs": [
              "120350857"
            ]
          },
          "120350857": {
            "id": "120350857",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "我感觉，她也有那种气场。",
            "nextDialogs": [
              "120350860"
            ]
          },
          "120350860": {
            "id": "120350860",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "你也很厉害，大家都觉得没办法了，你还能想到这么巧妙的处理方式。",
            "nextDialogs": [
              "120350861"
            ]
          },
          "120350861": {
            "id": "120350861",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "棋局之中，反将一手是很常见的破局战术了。",
            "nextDialogs": [
              "120350862"
            ]
          },
          "120350862": {
            "id": "120350862",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "这次的对手并不难缠，有想法，却没有远见，做事也不够周全。如此结果，正在我意料之中。",
            "nextDialogs": [
              "120350863"
            ]
          },
          "120350863": {
            "id": "120350863",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "就算这样…是我的话，可能一辈子都想不到这种办法吧…",
            "nextDialogs": [
              "120350864"
            ]
          },
          "120350864": {
            "id": "120350864",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "不过，看到柊千里打算重振柊家，总算有种彻底安心的感觉。",
            "nextDialogs": [
              "120350865"
            ]
          },
          "120350865": {
            "id": "120350865",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "是啊，稻妻稳定，对我也是益事。为自己减少麻烦，何乐而不为呢。"
          }
        }
      }
    },
    {
      "subId": "1203510",
      "subQuestName": "离开社奉行本部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120351001"
        ],
        "dialogs": {
          "120351001": {
            "id": "120351001",
            "speakerId": 1011,
            "speakerName": "井手",
            "text": "实在抱歉，惊扰了各位的生活。我们也在等候接下来的命令。"
          }
        }
      }
    },
    {
      "subId": "1203410",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120341001"
        ],
        "dialogs": {
          "120341001": {
            "id": "120341001",
            "speakerId": 1008,
            "speakerName": "冈林",
            "text": "我们正在执行任务，确保这条路的通行安全。",
            "nextDialogs": [
              "120341002"
            ]
          },
          "120341002": {
            "id": "120341002",
            "speakerId": 1008,
            "speakerName": "冈林",
            "text": "前方还有很多天领奉行的成员在进行相同的工作，请各位不必感到奇怪。"
          }
        }
      }
    },
    {
      "subId": "1203412",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120341201"
        ],
        "dialogs": {
          "120341201": {
            "id": "120341201",
            "speakerId": 1004,
            "speakerName": "畑中",
            "text": "一切安全，没有异常。",
            "nextDialogs": [
              "120341202"
            ]
          },
          "120341202": {
            "id": "120341202",
            "speakerId": 1004,
            "speakerName": "畑中",
            "text": "请放心通行吧，我们的行动和各位无关。"
          }
        }
      }
    },
    {
      "subId": "1203413",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120341301"
        ],
        "dialogs": {
          "120341301": {
            "id": "120341301",
            "speakerId": 1011,
            "speakerName": "井手",
            "text": "有什么事需要这么急吗…",
            "nextDialogs": [
              "120341302"
            ]
          },
          "120341302": {
            "id": "120341302",
            "speakerId": 1011,
            "speakerName": "井手",
            "text": "啊，不要在意，自言自语而已。"
          }
        }
      }
    },
    {
      "subId": "1203415",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120341501"
        ],
        "dialogs": {
          "120341501": {
            "id": "120341501",
            "speakerId": 1012,
            "speakerName": "智树",
            "text": "唔，怎么一直都有人进进出出，还气势汹汹的？",
            "nextDialogs": [
              "120341502"
            ]
          },
          "120341502": {
            "id": "120341502",
            "speakerId": 1012,
            "speakerName": "智树",
            "text": "我是不是早点收摊回去比较好…"
          }
        }
      }
    },
    {
      "subId": "1203417",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120341701"
        ],
        "dialogs": {
          "120341701": {
            "id": "120341701",
            "speakerId": 1013,
            "speakerName": "幕府通告",
            "text": "恒常乐土，雷光昭昭。此番吉庆之际：",
            "nextDialogs": [
              "120341702"
            ]
          },
          "120341702": {
            "id": "120341702",
            "speakerId": 1013,
            "speakerName": "幕府通告",
            "text": "天领奉行家主名代，九条镰治大人。",
            "nextDialogs": [
              "120341703"
            ]
          },
          "120341703": {
            "id": "120341703",
            "speakerId": 1013,
            "speakerName": "幕府通告",
            "text": "勘定奉行家主名代，柊千里大人。",
            "nextDialogs": [
              "120341704"
            ]
          },
          "120341704": {
            "id": "120341704",
            "speakerId": 1013,
            "speakerName": "幕府通告",
            "text": "已决定于近日成婚并举办婚礼。特此通告。"
          }
        }
      }
    },
    {
      "subId": "1203504",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120350401"
        ],
        "dialogs": {
          "120350401": {
            "id": "120350401",
            "speakerId": 1002,
            "speakerName": "康明",
            "text": "你家老爷是什么态度呢？",
            "nextDialogs": [
              "120350402"
            ]
          },
          "120350402": {
            "id": "120350402",
            "speakerId": 1003,
            "speakerName": "秀夫",
            "text": "唉，他的脾气，说不准…"
          }
        }
      }
    },
    {
      "subId": "1203512",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120351201"
        ],
        "dialogs": {
          "120351201": {
            "id": "120351201",
            "speakerId": 1014,
            "speakerName": "横山",
            "text": "请回吧，现在是紧急情况。若非特殊邀请，府内暂不会客。"
          }
        }
      }
    },
    {
      "subId": "1203599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120359901"
        ],
        "dialogs": {
          "120359901": {
            "id": "120359901",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "离岛的各种声音，都指向了柊千里。",
            "nextDialogs": [
              "120359902"
            ]
          },
          "120359902": {
            "id": "120359902",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "现在勘定奉行里的人应该都知道她很重要了…但她本人是怎么想的呢？",
            "nextDialogs": [
              "120359903"
            ]
          },
          "120359903": {
            "id": "120359903",
            "speakerId": 1006,
            "speakerName": "派蒙",
            "text": "我们去看看吧。",
            "nextDialogs": [
              "120359904"
            ]
          },
          "120359904": {
            "id": "120359904",
            "speakerId": 1009,
            "speakerName": "松浦",
            "text": "对了，您和社奉行大人是好友对吧…",
            "nextDialogs": [
              "120359905"
            ]
          },
          "120359905": {
            "id": "120359905",
            "speakerId": 1009,
            "speakerName": "松浦",
            "text": "待会儿，还请务必帮着美言几句。"
          }
        }
      }
    },
    {
      "subId": "1203601",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120360101"
        ],
        "dialogs": {
          "120360101": {
            "id": "120360101",
            "speakerId": 1015,
            "speakerName": "托马",
            "text": "其实我想说，这盘棋不用继续了吧…我已经没什么翻盘的希望了。",
            "nextDialogs": [
              "120360102"
            ]
          },
          "120360102": {
            "id": "120360102",
            "speakerId": 1010,
            "speakerName": "神里绫人",
            "text": "呵呵，几天时间过去，我也难免忘记一些细节。你不想趁机赢一次吗？",
            "nextDialogs": [
              "120360103"
            ]
          },
          "120360103": {
            "id": "120360103",
            "speakerId": 1015,
            "speakerName": "托马",
            "text": "既然您这么说，嗯，我再试试看！"
          }
        }
      }
    }
  ]
}
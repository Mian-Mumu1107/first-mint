            ]
          },
          "769060105": {
            "id": "769060105",
            "speakerId": 1000,
            "speakerName": "莱赫妲尔",
            "text": "总…总之，我家卡夏绝对不能接触这些！比起那个，孩子们应该把精力用在提升自己的品德上，要像月光一样无垢才行！"

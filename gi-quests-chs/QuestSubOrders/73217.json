  "subQuests": [
    {
      "subId": "7321701",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170101"
        ],
        "dialogs": {
          "732170101": {
            "id": "732170101",
            "speakerId": 1000,
            "speakerName": "奥摩斯港公告板",
            "text": "此乃奥摩斯港港务主管所设公告板，奥摩斯港内外重要事务皆在此公示，如有问题也可在此留言。"
          }
        }
      }
    },
    {
      "subId": "7321702",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170201"
        ],
        "dialogs": {
          "732170201": {
            "id": "732170201",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「还在为论文格式困扰吗？还在到处寻找论文灵感吗？该试试新方法了！」",
            "nextDialogs": [
              "732170202"
            ]
          },
          "732170202": {
            "id": "732170202",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「本人知论派出身，兼通素论派、妙论派，承接论文写作辅导答疑业务。」",
            "nextDialogs": [
              "732170203"
            ]
          },
          "732170203": {
            "id": "732170203",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「是时候脱离痛苦了，去旅店联系阿曼迪普先生吧，可以讲价。」",
            "nextDialogs": [
              "732170204"
            ]
          },
          "732170204": {
            "id": "732170204",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「可以代写吗？」",
            "nextDialogs": [
              "732170205"
            ]
          },
          "732170205": {
            "id": "732170205",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「不行，监察官大人不会允许这种事情的发生。」",
            "nextDialogs": [
              "732170206"
            ]
          },
          "732170206": {
            "id": "732170206",
            "speakerId": 1003,
            "speakerName": "监察官留言",
            "text": "「确实，请潜心求学，不要心怀不轨。」"
          }
        }
      }
    },
    {
      "subId": "7321703",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170301"
        ],
        "dialogs": {
          "732170301": {
            "id": "732170301",
            "speakerId": 1004,
            "speakerName": "飞天艺术团广告",
            "text": "你听说过浮空术吗？你见过空中飞人吗？你想知道飞天驮兽背后隐藏的奥秘吗？那就不要错过枫丹飞天艺术团首次须弥展演！",
            "nextDialogs": [
              "732170302"
            ]
          },
          "732170302": {
            "id": "732170302",
            "speakerId": 1004,
            "speakerName": "飞天艺术团广告",
            "text": "欢迎光临，莫失良机，随到随看，仅需五摩拉即可观赏这一独特的艺术展演。",
            "nextDialogs": [
              "732170303"
            ]
          },
          "732170303": {
            "id": "732170303",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「实在太精彩了，我在枫丹也没看过这么精彩的表演！」"
          }
        }
      }
    },
    {
      "subId": "7321704",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170401"
        ],
        "dialogs": {
          "732170401": {
            "id": "732170401",
            "speakerId": 1005,
            "speakerName": "镀金旅团公告",
            "text": "特别提醒，整个须弥的佣兵行业都由「镀金旅团」承接，绝无二家。",
            "nextDialogs": [
              "732170402"
            ]
          },
          "732170402": {
            "id": "732170402",
            "speakerId": 1005,
            "speakerName": "镀金旅团公告",
            "text": "请勿轻信他人，以防被来头不明的人骗取佣金。",
            "nextDialogs": [
              "732170403"
            ]
          },
          "732170403": {
            "id": "732170403",
            "speakerId": 1005,
            "speakerName": "镀金旅团公告",
            "text": "如需雇佣保镖、守卫，亦或其他委托，请联系「三十人团」驻奥摩斯港队长费罗兹。"
          }
        }
      }
    },
    {
      "subId": "7321705",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170501"
        ],
        "dialogs": {
          "732170501": {
            "id": "732170501",
            "speakerId": 1006,
            "speakerName": "总务官公告",
            "text": "本港所有入港船只皆需在港务主管处登记所有人信息、入港事由等信息。",
            "nextDialogs": [
              "732170502"
            ]
          },
          "732170502": {
            "id": "732170502",
            "speakerId": 1006,
            "speakerName": "总务官公告",
            "text": "若为商船还需提供载运商品的详细信息。",
            "nextDialogs": [
              "732170503"
            ]
          },
          "732170503": {
            "id": "732170503",
            "speakerId": 1006,
            "speakerName": "总务官公告",
            "text": "商船未经登记不得在此卸货或开展贸易活动，一经发现，必将严惩。"
          }
        }
      }
    },
    {
      "subId": "7321706",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170601"
        ],
        "dialogs": {
          "732170601": {
            "id": "732170601",
            "speakerId": 1006,
            "speakerName": "总务官公告",
            "text": "本港现严查走私活动，凡经本港出入的货物皆需登记并接受检查。",
            "nextDialogs": [
              "732170602"
            ]
          },
          "732170602": {
            "id": "732170602",
            "speakerId": 1006,
            "speakerName": "总务官公告",
            "text": "如发现未经登记的货品或明令禁止进出口的违禁物品，将全部处以没收。",
            "nextDialogs": [
              "732170603"
            ]
          },
          "732170603": {
            "id": "732170603",
            "speakerId": 1006,
            "speakerName": "总务官公告",
            "text": "由此造成的一切后果皆由所有人自行承担。"
          }
        }
      }
    },
    {
      "subId": "7321707",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170701"
        ],
        "dialogs": {
          "732170701": {
            "id": "732170701",
            "speakerId": 1007,
            "speakerName": "守塔人公告",
            "text": "海兽出没！",
            "nextDialogs": [
              "732170702"
            ]
          },
          "732170702": {
            "id": "732170702",
            "speakerId": 1007,
            "speakerName": "守塔人公告",
            "text": "近期海兽活动频繁，出港船只请注意法逻斯塔发布的预警信息，或通过虚空提前获取海域信息。",
            "nextDialogs": [
              "732170703"
            ]
          },
          "732170703": {
            "id": "732170703",
            "speakerId": 1007,
            "speakerName": "守塔人公告",
            "text": "如有疑问，请咨询守塔人。"
          }
        }
      }
    },
    {
      "subId": "7321708",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170801"
        ],
        "dialogs": {
          "732170801": {
            "id": "732170801",
            "speakerId": 1008,
            "speakerName": "沙普尔旅舍广告",
            "text": "奥摩斯港最大的旅舍，为往来商旅提供最贴心的服务。",
            "nextDialogs": [
              "732170802"
            ]
          },
          "732170802": {
            "id": "732170802",
            "speakerId": 1008,
            "speakerName": "沙普尔旅舍广告",
            "text": "入住旅客如有教令院学籍，还有特殊折扣哦。",
            "nextDialogs": [
              "732170803"
            ]
          },
          "732170803": {
            "id": "732170803",
            "speakerId": 1008,
            "speakerName": "沙普尔旅舍广告",
            "text": "若有商品货物需要仓储，请联系维卡拉商栈。"
          }
        }
      }
    },
    {
      "subId": "7321709",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732170901"
        ],
        "dialogs": {
          "732170901": {
            "id": "732170901",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「沙普尔旅舍的服务虽然不错，但是房间隔音实在太差了。」",
            "nextDialogs": [
              "732170902"
            ]
          },
          "732170902": {
            "id": "732170902",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「当初看奥摩斯港物价便宜才决定留在这里备考，看来我还是得搬去须弥城里才行。」",
            "nextDialogs": [
              "732170903"
            ]
          },
          "732170903": {
            "id": "732170903",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「今年要是再考不上，就只能回老家种田了。不知道到时候能不能带点『丰沃之惠』走…」"
          }
        }
      }
    },
    {
      "subId": "7321710",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171001"
        ],
        "dialogs": {
          "732171001": {
            "id": "732171001",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「最近派下来的教令官真是越来越没用了，什么事情都是一问三不知。」",
            "nextDialogs": [
              "732171002"
            ]
          },
          "732171002": {
            "id": "732171002",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「况且现在开放了虚空权限，这些外行的教令官水平还不如我呢。」",
            "nextDialogs": [
              "732171003"
            ]
          },
          "732171003": {
            "id": "732171003",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「也就只有那位不是经常能看见的书记官大人，上次还帮我们理清了船只调度的时间表。看来教令院还不至于全是傻蘑菇。」"
          }
        }
      }
    },
    {
      "subId": "7321711",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171101"
        ],
        "dialogs": {
          "732171101": {
            "id": "732171101",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「自从赛诺前辈当上大风纪官后，虽然要干的活变多了，但因为不用再牵扯进那些无聊的学派斗争，感觉反而轻松了不少。」",
            "nextDialogs": [
              "732171102"
            ]
          },
          "732171102": {
            "id": "732171102",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「不然我也不能趁着出差调查的功夫来这里偷懒。」",
            "nextDialogs": [
              "732171103"
            ]
          },
          "732171103": {
            "id": "732171103",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「最近赛诺前辈也不知道去了哪里，写在这里的话，应该不会被他看到吧。」",
            "nextDialogs": [
              "732171104"
            ]
          },
          "732171104": {
            "id": "732171104",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「我已经看到了。请限于明日中午之前自动报到，领受处分。」",
            "nextDialogs": [
              "732171105"
            ]
          },
          "732171105": {
            "id": "732171105",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「不要浪费我的时间。」"
          }
        }
      }
    },
    {
      "subId": "7321712",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171201"
        ],
        "dialogs": {
          "732171201": {
            "id": "732171201",
            "speakerId": 1009,
            "speakerName": "「飞云商会」广告",
            "text": "本会经营璃月生产的宝石制品和名贵矿石，与多家船队皆有长期合作，货源充足，渠道稳定。",
            "nextDialogs": [
              "732171202"
            ]
          },
          "732171202": {
            "id": "732171202",
            "speakerId": 1009,
            "speakerName": "「飞云商会」广告",
            "text": "另有少量时新丝绸及时装出售，欲购从速。",
            "nextDialogs": [
              "732171203"
            ]
          },
          "732171203": {
            "id": "732171203",
            "speakerId": 1009,
            "speakerName": "「飞云商会」广告",
            "text": "须弥本地毛毯、草药、宝石首饰、织锦制品等优质商品如有好渠道，亦请友商尽管前来洽谈，以交良缘。"
          }
        }
      }
    },
    {
      "subId": "7321713",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171301"
        ],
        "dialogs": {
          "732171301": {
            "id": "732171301",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「有人相信吗？我上个月出海到了一个国家，他们的国王连马都没见过。」",
            "nextDialogs": [
              "732171302"
            ]
          },
          "732171302": {
            "id": "732171302",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「所以我决定贩一批驮兽去，然后告诉他们这就是马，哈哈。要是这单做成了，我说不定也能混成个国王什么的当当呢！」",
            "nextDialogs": [
              "732171303"
            ]
          },
          "732171303": {
            "id": "732171303",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「国王是什么？」",
            "nextDialogs": [
              "732171304"
            ]
          },
          "732171304": {
            "id": "732171304",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「就是一种和港务官或者维齐尔差不多，但是比他们官威更大的大官，就像传说中的二十九代伊那样…哎呀太难跟你形容了。」",
            "nextDialogs": [
              "732171305"
            ]
          },
          "732171305": {
            "id": "732171305",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「一看就是你编的吧。」"
          }
        }
      }
    },
    {
      "subId": "7321714",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171401"
        ],
        "dialogs": {
          "732171401": {
            "id": "732171401",
            "speakerId": 1010,
            "speakerName": "未署名的诗句",
            "text": "「贤者的说教何其枯燥，不如斟满花酿的美酒，踏上征服七海的航程。」"
          }
        }
      }
    },
    {
      "subId": "7321715",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171501"
        ],
        "dialogs": {
          "732171501": {
            "id": "732171501",
            "speakerId": 1011,
            "speakerName": "治安官公告",
            "text": "水手船客、往来商旅、内外市民，本港规章均已于此公告。",
            "nextDialogs": [
              "732171502"
            ]
          },
          "732171502": {
            "id": "732171502",
            "speakerId": 1011,
            "speakerName": "治安官公告",
            "text": "如遇纠纷，可联系治安官夏姆寻求帮助。"
          }
        }
      }
    },
    {
      "subId": "7321716",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171601"
        ],
        "dialogs": {
          "732171601": {
            "id": "732171601",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「与其去须弥城里游览什么大巴扎，还不如看看我们奥摩斯港的旧市街。」",
            "nextDialogs": [
              "732171602"
            ]
          },
          "732171602": {
            "id": "732171602",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「比起被教令官指手画脚搞得面目全非的大巴扎，我们这里保留的须弥特色可要多得多了。」",
            "nextDialogs": [
              "732171603"
            ]
          },
          "732171603": {
            "id": "732171603",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「当然，要是想欣赏舞蹈的话，还是得去祖拜尔剧场的。」",
            "nextDialogs": [
              "732171604"
            ]
          },
          "732171604": {
            "id": "732171604",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「乡下人就是乡下人，须弥城的规划是由学者们精心设计的，分区无不遵循科学道理。」",
            "nextDialogs": [
              "732171605"
            ]
          },
          "732171605": {
            "id": "732171605",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「倒是有的人什么也不懂就在这里大放厥词，拿奥摩斯港这乱七八糟的街道当个宝了！」",
            "nextDialogs": [
              "732171606"
            ]
          },
          "732171606": {
            "id": "732171606",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「不听不听，树洞人念经！」"
          }
        }
      }
    },
    {
      "subId": "7321717",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171701"
        ],
        "dialogs": {
          "732171701": {
            "id": "732171701",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「说起来实在难为情。我们原本是常年负责维护商船的工人，一直靠祖上传下来的手艺吃饭。」",
            "nextDialogs": [
              "732171702"
            ]
          },
          "732171702": {
            "id": "732171702",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「但是从前段时间开始，虚空录入了新的技术，以前的经验完全派不上用场了。年轻人还能通过虚空申请学习，我们这些年纪大了的，可就只能改行了。」",
            "nextDialogs": [
              "732171703"
            ]
          },
          "732171703": {
            "id": "732171703",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「虽然书记官大人说我们可以出海碰碰运气，不过因为实在没钱还得再准备一段时间。大家有什么活计的话，也请来找我们吧。」",
            "nextDialogs": [
              "732171704"
            ]
          },
          "732171704": {
            "id": "732171704",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「别听那个书记官的，正巧我知道有位大主顾需要工匠，我这就把你们推荐给她。这些钱你们也先拿去吧，别考虑什么出海了。」",
            "nextDialogs": [
              "732171705"
            ]
          },
          "732171705": {
            "id": "732171705",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "「真希望你少做点无谓之事。有人成功，有人落魄，本身就是世间运行的定则，何必为了自己充好人而干涉世界的运行起落？」",
            "nextDialogs": [
              "732171706"
            ]
          },
          "732171706": {
            "id": "732171706",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「我们的书记官大人又开始讲他的神秘主义课程了。为什么？我开心！」",
            "nextDialogs": [
              "732171707"
            ]
          },
          "732171707": {
            "id": "732171707",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「你可不要忽视了，追求互助与公平的本性与义怒也是人驱动世界运转的道理，而不是什么『优胜劣汰』的谬论！」",
            "nextDialogs": [
              "732171708"
            ]
          },
          "732171708": {
            "id": "732171708",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "「你也不要搞错了，我同样从来没有否认过你所说的这些，但你完全不懂我在和你说什么，我也不想再和你解释了。」",
            "nextDialogs": [
              "732171709"
            ]
          },
          "732171709": {
            "id": "732171709",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "「和血气上脑的人辩论真是头痛…话说回来，你自己的预算哪去了？别告诉我你把教令院的补贴都花在这种无聊的事情上了。」",
            "nextDialogs": [
              "732171710"
            ]
          },
          "732171710": {
            "id": "732171710",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「『穷人穷苦于富人的富裕，所以富人应广散善财。』佐尔菲卡尔贤者说的。」",
            "nextDialogs": [
              "732171711"
            ]
          },
          "732171711": {
            "id": "732171711",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "「他没说过。」",
            "nextDialogs": [
              "732171712"
            ]
          },
          "732171712": {
            "id": "732171712",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「他说过。」",
            "nextDialogs": [
              "732171713"
            ]
          },
          "732171713": {
            "id": "732171713",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "「他没说过，这个月酒钱你自己负责。」",
            "nextDialogs": [
              "732171714"
            ]
          },
          "732171714": {
            "id": "732171714",
            "speakerId": 1002,
            "speakerName": "另一人的留言",
            "text": "「我不跟你争论这个了，但给我一个月时间，他一定说过。」"
          }
        }
      }
    },
    {
      "subId": "7321718",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171801"
        ],
        "dialogs": {
          "732171801": {
            "id": "732171801",
            "speakerId": 1013,
            "speakerName": "商行的广告",
            "text": "「我行现已开通前往荆夫港的航线，诚邀各位友商加盟我们的水果贸易。」",
            "nextDialogs": [
              "732171802"
            ]
          },
          "732171802": {
            "id": "732171802",
            "speakerId": 13173,
            "speakerName": "留言",
            "text": "「等一下，从这到蒙德的航程，怎么说进口水果也太离谱了吧。你要是说酒水贸易我可能还有点兴趣。」",
            "nextDialogs": [
              "732171803"
            ]
          },
          "732171803": {
            "id": "732171803",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "「要说进口蒙德美酒那岂不是谁都能想到，但是进口水果可只有我这一家，这就是商机懂不懂啊！」",
            "nextDialogs": [
              "732171804"
            ]
          },
          "732171804": {
            "id": "732171804",
            "speakerId": 1012,
            "speakerName": "回复",
            "text": "「况且又不一定真要从蒙德进货…」"
          }
        }
      }
    },
    {
      "subId": "7321719",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732171901"
        ],
        "dialogs": {
          "732171901": {
            "id": "732171901",
            "speakerId": 1014,
            "speakerName": "「万国商会」广告",
            "text": "「通往离岛的进出口航线现已重新开放，本会诚邀各位友商加盟。」",
            "nextDialogs": [
              "732171902"
            ]
          },
          "732171902": {
            "id": "732171902",
            "speakerId": 1014,
            "speakerName": "「万国商会」广告",
            "text": "「本会经营的须弥与稻妻间的野生蘑菇贸易已经港务主管核准，欢迎经营菌类的商人来我会洽谈合作事宜。」",
            "nextDialogs": [
              "732171903"
            ]
          },
          "732171903": {
            "id": "732171903",
            "speakerId": 1014,
            "speakerName": "「万国商会」广告",
            "text": "「如在前往稻妻的旅途中遭遇任何问题或困难，也可联系本会。」"
          }
        }
      }
    },
    {
      "subId": "7321720",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732172001"
        ],
        "dialogs": {
          "732172001": {
            "id": "732172001",
            "speakerId": 1007,
            "speakerName": "守塔人公告",
            "text": "海兽出没！",
            "nextDialogs": [
              "732172002"
            ]
          },
          "732172002": {
            "id": "732172002",
            "speakerId": 1007,
            "speakerName": "守塔人公告",
            "text": "近期海兽活动频繁，出港船只请注意法逻斯塔发布的预警信息，或通过教令官公告提前获取海域信息。",
            "nextDialogs": [
              "732172003"
            ]
          },
          "732172003": {
            "id": "732172003",
            "speakerId": 1007,
            "speakerName": "守塔人公告",
            "text": "如有疑问，请咨询守塔人。"
          }
        }
      }
    }
  ]
}
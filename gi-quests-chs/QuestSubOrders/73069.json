    {
      "subId": "7306912",
      "subQuestName": "与兰罗摩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730691201"
        ],
        "dialogs": {
          "730691201": {
            "id": "730691201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这就是…莎兰树？看起来，好像没有想象中那么有生机…",
            "nextDialogs": [
              "730691202"
            ]
          },
          "730691202": {
            "id": "730691202",
            "speakerId": 1001,
            "speakerName": "兰罗摩",
            "text": "嗯。无留陀的侵蚀越来越严重了。不但在地上，就算是在沙恒里，也有无留陀。",
            "nextDialogs": [
              "730691203"
            ]
          },
          "730691203": {
            "id": "730691203",
            "speakerId": 1001,
            "speakerName": "兰罗摩",
            "text": "无留陀会对它侵蚀的树木、花朵，述说死的恐怖。原本不知死的生命，就会因此开始凋亡。",
            "nextDialogs": [
              "730691204"
            ]
          },
          "730691204": {
            "id": "730691204",
            "speakerId": 1001,
            "speakerName": "兰罗摩",
            "text": "我们一直在与无留陀对抗。兰拉吉也在很努力地和无留陀对抗。",
            "nextDialogs": [
              "730691205"
            ]
          },
          "730691205": {
            "id": "730691205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "兰拉吉？难道不是之前说的那个，以前的兰那罗吗…",
            "nextDialogs": [
              "730691206"
            ]
          },
          "730691206": {
            "id": "730691206",
            "speakerId": 1001,
            "speakerName": "兰罗摩",
            "text": "#嗯。辛苦了，兰拉吉。虽然我们没有见过面，但你的歌很好听。接下来，就交给我、那菈{NICKNAME}和派蒙吧。",
            "nextDialogs": [
              "730691207"
            ]
          },
          "730691207": {
            "id": "730691207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要怎么取得恒素果？",
            "nextDialogs": [
              "730691208"
            ]
          },
          "730691208": {
            "id": "730691208",
            "speakerId": 1001,
            "speakerName": "兰罗摩",
            "text": "嗯。我们要先进入他的梦中，消除无留陀的影响。",
            "nextDialogs": [
              "730691209"
            ]
          },
          "730691209": {
            "id": "730691209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「他」是指…莎兰树吗？",
            "nextDialogs": [
              "730691210"
            ]
          },
          "730691210": {
            "id": "730691210",
            "speakerId": 1001,
            "speakerName": "兰罗摩",
            "text": "没错。如果准备好了，就伸出手，进入他的梦吧…"
          }
        }
      }
    },

    {
      "subId": "7306905",
      "subQuestName": "依照蔷薇的图形，弹奏乐曲",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730690501"
        ],
        "dialogs": {
          "730690501": {
            "id": "730690501",
            "speakerId": 1001,
            "speakerName": "兰罗摩",
            "text": "哦哦…这就是兰拉吉的歌…",
            "nextDialogs": [
              "730690502"
            ]
          },
          "730690502": {
            "id": "730690502",
            "speakerId": 1002,
            "speakerName": "兰耶娑",
            "text": "啊啊…能够再一次听到你的歌，我与你的约定终于能够履行。兰拉吉，我会带着你的歌，一直唱下去的。",
            "nextDialogs": [
              "730690503"
            ]
          },
          "730690503": {
            "id": "730690503",
            "speakerId": 1002,
            "speakerName": "兰耶娑",
            "text": "谢谢，好那菈。兰耶娑不会忘记的。",
            "nextDialogs": [
              "730690504"
            ]
          },
          "730690504": {
            "id": "730690504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "兰耶娑说话的风格变得正常了…？",
            "nextDialogs": [
              "730690505"
            ]
          },
          "730690505": {
            "id": "730690505",
            "speakerId": 1001,
            "speakerName": "兰罗摩",
            "text": "#谢谢你们，那菈{NICKNAME}、派蒙！他和兰拉吉是好朋友，所以一直在寻找这一首歌。",
            "nextDialogs": [
              "730690506"
            ]
          },
          "730690506": {
            "id": "730690506",
            "speakerId": 1002,
            "speakerName": "兰耶娑",
            "text": "兰拉吉是个…胆小的朋友，喜欢躲在安静的地方，悄悄地唱歌。所以，他的歌能开启未知的通路。既然明白了这首歌…",
            "nextDialogs": [
              "730690507"
            ]
          },
          "730690507": {
            "id": "730690507",
            "speakerId": 1002,
            "speakerName": "兰耶娑",
            "text": "你们就能开启前往这边的觉树之堂的道路了。",
            "nextDialogs": [
              "730690508"
            ]
          },
          "730690508": {
            "id": "730690508",
            "speakerId": 1001,
            "speakerName": "兰罗摩",
            "text": "嗯！接下来就交给我们吧！",
            "nextDialogs": [
              "730690509"
            ]
          },
          "730690509": {
            "id": "730690509",
            "speakerId": 1002,
            "speakerName": "兰耶娑",
            "text": "#好。在无忧节相会吧，{M#英俊}{F#美丽}的那菈{M#先生}{F#小姐}。"
          }
        }
      }
    },

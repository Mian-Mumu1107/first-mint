  },
  "subQuests": [
    {
      "subId": "7306001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730600101"
        ],
        "dialogs": {
          "730600101": {
            "id": "730600101",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "#兰那库拉在谒颂幽境，兰百梨迦去了荼诃之座，兰贡迪在梦景林莽，那菈{NICKNAME}和派蒙也要小心。"
          }
        }
      }
    },
    {
      "subId": "7306002",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730600201"
        ],
        "dialogs": {
          "730600201": {
            "id": "730600201",
            "speakerId": 1001,
            "speakerName": "兰那库拉",
            "text": "金色的那菈，好像什么也不怕。",
            "nextDialogs": [
              "730600202"
            ]
          },
          "730600202": {
            "id": "730600202",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "金色的那菈是勇敢的那菈，就像那菈法留纳一样。",
            "nextDialogs": [
              "730600203"
            ]
          },
          "730600203": {
            "id": "730600203",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "虽然担心在荼诃之座的兰百梨迦和在梦景林莽的兰贡迪，但是有金色的那菈帮助，一定不会有问题。",
            "nextDialogs": [
              "730600204"
            ]
          },
          "730600204": {
            "id": "730600204",
            "speakerId": 1001,
            "speakerName": "兰那库拉",
            "text": "#治好了法留纳神机，就不会有坏家伙到苗圃捣乱了，苗圃的花，想要送给{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}。"
          }
        }
      }
    },
    {
      "subId": "7306003",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730600301"
        ],
        "dialogs": {
          "730600301": {
            "id": "730600301",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "兰百梨迦果然顺利，但是担心在谒颂幽境的兰那库拉和在梦景林莽的兰贡迪。",
            "nextDialogs": [
              "730600302"
            ]
          },
          "730600302": {
            "id": "730600302",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "兰那库拉…坏蘑菇太多，万一兰那库拉又被坏蘑菇抓到…",
            "nextDialogs": [
              "730600303"
            ]
          },
          "730600303": {
            "id": "730600303",
            "speakerId": 1002,
            "speakerName": "兰百梨迦",
            "text": "太多担心，没用。金色的那菈很强，打倒大大铁块，就像大风刮倒朽木。",
            "nextDialogs": [
              "730600304"
            ]
          },
          "730600304": {
            "id": "730600304",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "只要治好法留纳神机…"
          }
        }
      }
    },
    {
      "subId": "7306004",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730600401"
        ],
        "dialogs": {
          "730600401": {
            "id": "730600401",
            "speakerId": 1003,
            "speakerName": "兰贡迪",
            "text": "梦景林莽…安静的曲子，水的声音，鸟扑棱翅膀的声音，踩在枝桠上的声音…",
            "nextDialogs": [
              "730600402"
            ]
          },
          "730600402": {
            "id": "730600402",
            "speakerId": 1003,
            "speakerName": "兰贡迪",
            "text": "和那菈还有派蒙说话…派蒙好玩。但是可惜，派蒙不想变成种子。",
            "nextDialogs": [
              "730600403"
            ]
          },
          "730600403": {
            "id": "730600403",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "因为派蒙不是兰那罗。",
            "nextDialogs": [
              "730600404"
            ]
          },
          "730600404": {
            "id": "730600404",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "梦景林莽已经没问题了，兰百梨迦在荼诃之座，但是不担心，谒颂幽境的「蕈兽」很多，兰那库拉，担心…"
          }
        }
      }
    },
    {
      "subId": "7306005",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730600501"
        ],
        "dialogs": {
          "730600501": {
            "id": "730600501",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "兰百梨迦应该很快从荼诃之座回来，有兰百梨迦的兰迦拉梨，铁块和「蕈兽」都不可怕。",
            "nextDialogs": [
              "730600502"
            ]
          },
          "730600502": {
            "id": "730600502",
            "speakerId": 1001,
            "speakerName": "兰那库拉",
            "text": "如果兰那库拉能有兰百梨迦一半那么厉害，就可以保护苗圃了。",
            "nextDialogs": [
              "730600503"
            ]
          },
          "730600503": {
            "id": "730600503",
            "speakerId": 1003,
            "speakerName": "兰贡迪",
            "text": "兰那库拉，连兰百梨迦一半的一半也没有。",
            "nextDialogs": [
              "730600504"
            ]
          },
          "730600504": {
            "id": "730600504",
            "speakerId": 1001,
            "speakerName": "兰那库拉",
            "text": "呜呜…",
            "nextDialogs": [
              "730600505"
            ]
          },
          "730600505": {
            "id": "730600505",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "兰那库拉可以更勇敢，就像金色的那菈那样，只是需要时间…"
          }
        }
      }
    },
    {
      "subId": "7306006",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730600601"
        ],
        "dialogs": {
          "730600601": {
            "id": "730600601",
            "speakerId": 1002,
            "speakerName": "兰百梨迦",
            "text": "谒颂幽境坏家伙很多，但是兰那库拉回来了，嗯，好。",
            "nextDialogs": [
              "730600602"
            ]
          },
          "730600602": {
            "id": "730600602",
            "speakerId": 1001,
            "speakerName": "兰那库拉",
            "text": "是金色的那菈，和兰那库拉一起躲开了坏家伙，还把石头的记忆也清理干净…",
            "nextDialogs": [
              "730600603"
            ]
          },
          "730600603": {
            "id": "730600603",
            "speakerId": 1001,
            "speakerName": "兰那库拉",
            "text": "法留纳神机治好以后，就可以把苗圃的花带去，兰那罗不会忘记。",
            "nextDialogs": [
              "730600604"
            ]
          },
          "730600604": {
            "id": "730600604",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "现在只剩兰贡迪在梦景林莽，等兰贡迪回来，我们就可以去清除啃噬法留纳神机的根的坏虫…"
          }
        }
      }
    },
    {
      "subId": "7306007",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730600701"
        ],
        "dialogs": {
          "730600701": {
            "id": "730600701",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "兰那库拉在谒颂幽境，那里有太多蘑菇，担心…兰百梨迦…",
            "nextDialogs": [
              "730600702"
            ]
          },
          "730600702": {
            "id": "730600702",
            "speakerId": 1002,
            "speakerName": "兰百梨迦",
            "text": "兰百梨迦不去。",
            "nextDialogs": [
              "730600703"
            ]
          },
          "730600703": {
            "id": "730600703",
            "speakerId": 1003,
            "speakerName": "兰贡迪",
            "text": "兰那库拉，很懂得躲藏，蘑菇一定找不到他。兰般度为什么担心？"
          }
        }
      }
    }
  ]
}
    {
      "subId": "4012316",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401231601"
        ],
        "dialogs": {
          "401231601": {
            "id": "401231601",
            "speakerId": 1000,
            "speakerName": "乔姨",
            "text": "连石门都热闹起来啦？哈哈，这还真是不多见啊。",
            "nextDialogs": [
              "401231602"
            ]
          },
          "401231602": {
            "id": "401231602",
            "speakerId": 1000,
            "speakerName": "乔姨",
            "text": "年轻人，想歇就歇会儿吧，可别累着。"
          }
        }
      }
    },
    {
      "subId": "4012317",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401231701"
        ],
        "dialogs": {
          "401231701": {
            "id": "401231701",
            "speakerId": 1001,
            "speakerName": "老周叔",
            "text": "哈哈…这年轻人的花样可越来越多了。",
            "nextDialogs": [
              "401231702"
            ]
          },
          "401231702": {
            "id": "401231702",
            "speakerId": 1001,
            "speakerName": "老周叔",
            "text": "诗歌大会…嗯，遥想我年轻的时候，也有好多能写的故事…",
            "nextDialogs": [
              "401231703"
            ]
          },
          "401231703": {
            "id": "401231703",
            "speakerId": 1001,
            "speakerName": "老周叔",
            "text": "哎…山月常在，红颜易消啊…"
          }
        }
      }
    },
    {
      "subId": "4012621",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262101"
        ],
        "dialogs": {
          "401262101": {
            "id": "401262101",
            "speakerId": 1002,
            "speakerName": "纪芳",
            "text": "…你不是要出书吗？",
            "nextDialogs": [
              "401262102"
            ]
          },
          "401262102": {
            "id": "401262102",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "对呀。",
            "nextDialogs": [
              "401262103"
            ]
          },
          "401262103": {
            "id": "401262103",
            "speakerId": 1002,
            "speakerName": "纪芳",
            "text": "…书呢？",
            "nextDialogs": [
              "401262104"
            ]
          },
          "401262104": {
            "id": "401262104",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "等诗来就有了。",
            "nextDialogs": [
              "401262105"
            ]
          },
          "401262105": {
            "id": "401262105",
            "speakerId": 1002,
            "speakerName": "纪芳",
            "text": "…诗呢？",
            "nextDialogs": [
              "401262106"
            ]
          },
          "401262106": {
            "id": "401262106",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "诗在路上了。",
            "nextDialogs": [
              "401262107"
            ]
          },
          "401262107": {
            "id": "401262107",
            "speakerId": 1002,
            "speakerName": "纪芳",
            "text": "…不是，胡堂主，你这诗还没来，我怎么跟你聊生意？",
            "nextDialogs": [
              "401262108"
            ]
          },
          "401262108": {
            "id": "401262108",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "我这不是先来和老板你谈谈妥嘛。",
            "nextDialogs": [
              "401262109"
            ]
          },
          "401262109": {
            "id": "401262109",
            "speakerId": 1002,
            "speakerName": "纪芳",
            "text": "我总要看看内容再决定卖不卖，怎么卖吧？",
            "nextDialogs": [
              "401262110"
            ]
          },
          "401262110": {
            "id": "401262110",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "哎呀呀，光是堂主我刚才给你看的几句，就足以撑起这本书的销量了吧！",
            "nextDialogs": [
              "401262111"
            ]
          },
          "401262111": {
            "id": "401262111",
            "speakerId": 1002,
            "speakerName": "纪芳",
            "text": "…就凭「林猪二十斤」？",
            "nextDialogs": [
              "401262112"
            ]
          },
          "401262112": {
            "id": "401262112",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "还有「地下开饭」那个呀！见多识广的钟离客卿可都说是好诗对！这不做个什么宣传宣传？",
            "nextDialogs": [
              "401262113"
            ]
          },
          "401262113": {
            "id": "401262113",
            "speakerId": 1002,
            "speakerName": "纪芳",
            "text": "…堂主，我们这都是小本生意。要是成本进去了但没人买，亏的是我的钱。",
            "nextDialogs": [
              "401262114"
            ]
          },
          "401262114": {
            "id": "401262114",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "放心放心，我和你担保，这诗集印出来，绝对惊天地泣鬼神！",
            "nextDialogs": [
              "401262115"
            ]
          },
          "401262115": {
            "id": "401262115",
            "speakerId": 1003,
            "speakerName": "胡桃",
            "text": "这不，我来的路上就听见了些鬼魂的哭声呢！你不信的话，我叫来给你听听？",
            "nextDialogs": [
              "401262116"
            ]
          },
          "401262116": {
            "id": "401262116",
            "speakerId": 1002,
            "speakerName": "纪芳",
            "text": "…这就免了。"
          }
        }
      }
    },
    {
      "subId": "4012622",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262201"
        ],
        "dialogs": {
          "401262201": {
            "id": "401262201",
            "speakerId": 1004,
            "speakerName": "魈",
            "text": "…是你。",
            "nextDialogs": [
              "401262202"
            ]
          },
          "401262202": {
            "id": "401262202",
            "speakerId": 1004,
            "speakerName": "魈",
            "text": "……",
            "nextDialogs": [
              "401262203"
            ]
          },
          "401262203": {
            "id": "401262203",
            "speakerId": 1004,
            "speakerName": "魈",
            "text": "依你所言，试着作了首诗…",
            "nextDialogs": [
              "401262204"
            ]
          },
          "401262204": {
            "id": "401262204",
            "speakerId": 1004,
            "speakerName": "魈",
            "text": "把心绪落于纸上，胸中倒是平静不少…",
            "nextDialogs": [
              "401262205"
            ]
          },
          "401262205": {
            "id": "401262205",
            "speakerId": 1004,
            "speakerName": "魈",
            "text": "他们…真的能听见吗…"
          }
        }
      }
    },
    {
      "subId": "4012623",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262302"
        ],
        "dialogs": {
          "401262302": {
            "id": "401262302",
            "speakerId": 1005,
            "speakerName": "（聆听…）",
            "text": "（愉快的歌声…）"
          }
        }
      }
    },
    {
      "subId": "4012624",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262401"
        ],
        "dialogs": {
          "401262401": {
            "id": "401262401",
            "speakerId": 1006,
            "speakerName": "浣溪",
            "text": "有这么一个和蒙德朋友一起写诗的机会还真不错。",
            "nextDialogs": [
              "401262402"
            ]
          },
          "401262402": {
            "id": "401262402",
            "speakerId": 1006,
            "speakerName": "浣溪",
            "text": "不过光在会场站着也挺无聊的，我就把老家的果蔬拿来买买赚外快了。",
            "nextDialogs": [
              "401262403"
            ]
          },
          "401262403": {
            "id": "401262403",
            "speakerId": 1006,
            "speakerName": "浣溪",
            "text": "哦，当然，想要交流诗歌的话，我也奉陪哟。"
          }
        }
      }
    },
    {
      "subId": "4012625",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262501"
        ],
        "dialogs": {
          "401262501": {
            "id": "401262501",
            "speakerId": 1007,
            "speakerName": "雷温",
            "text": "听说这次负责调酒的是猫尾酒馆的特派员。",
            "nextDialogs": [
              "401262502"
            ]
          },
          "401262502": {
            "id": "401262502",
            "speakerId": 1007,
            "speakerName": "雷温",
            "text": "平时都因为太热闹了，没怎么进去过，这次一定得尝尝到底是什么味道。"
          }
        }
      }
    },
    {
      "subId": "4012626",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262601"
        ],
        "dialogs": {
          "401262601": {
            "id": "401262601",
            "speakerId": 1008,
            "speakerName": "约亨",
            "text": "这里的位子您随便坐，看看风景写写诗，再来一杯上好的饮品。",
            "nextDialogs": [
              "401262602"
            ]
          },
          "401262602": {
            "id": "401262602",
            "speakerId": 1008,
            "speakerName": "约亨",
            "text": "…这么看来，璃月和蒙德娱乐消遣的方式还挺相似？"
          }
        }
      }
    },
    {
      "subId": "4012628",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262801"
        ],
        "dialogs": {
          "401262801": {
            "id": "401262801",
            "speakerId": 1009,
            "speakerName": "留言",
            "text": "我猜，台上左边的那个诗谜，谜底是「琉璃百合」。",
            "nextDialogs": [
              "401262802"
            ]
          },
          "401262802": {
            "id": "401262802",
            "speakerId": 1010,
            "speakerName": "回复",
            "text": "谜题里说这种花以前开得很多，「琉璃百合」真有那么多吗？",
            "nextDialogs": [
              "401262803"
            ]
          },
          "401262803": {
            "id": "401262803",
            "speakerId": 1010,
            "speakerName": "回复",
            "text": "会不会是「薄荷」？诗里不是说这种植物挺香吗？",
            "nextDialogs": [
              "401262804"
            ]
          },
          "401262804": {
            "id": "401262804",
            "speakerId": 1010,
            "speakerName": "回复",
            "text": "我觉得还是「琉璃百合」更符合意象。",
            "nextDialogs": [
              "401262805"
            ]
          },
          "401262805": {
            "id": "401262805",
            "speakerId": 1010,
            "speakerName": "回复",
            "text": "那右边那个诗谜呢？我怎么都猜不出，难道是什么我没见过的东西？",
            "nextDialogs": [
              "401262806"
            ]
          },
          "401262806": {
            "id": "401262806",
            "speakerId": 1010,
            "speakerName": "回复",
            "text": "我知道是什么，但我不方便说…",
            "nextDialogs": [
              "401262807"
            ]
          },
          "401262807": {
            "id": "401262807",
            "speakerId": 1010,
            "speakerName": "回复",
            "text": "这还有不方便说的东西？"
          }
        }
      }
    },
    {
      "subId": "4012629",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401262901"
        ],
        "dialogs": {
          "401262901": {
            "id": "401262901",
            "speakerId": 1011,
            "speakerName": "谜底揭晓",
            "text": "琉璃百合、攫金鸦印。"
          }
        }
      }
    },
    {
      "subId": "4012630",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401263001"
        ],
        "dialogs": {
          "401263001": {
            "id": "401263001",
            "speakerId": 1009,
            "speakerName": "留言",
            "text": "我记得璃月的「对子」好像挺难的…",
            "nextDialogs": [
              "401263002"
            ]
          },
          "401263002": {
            "id": "401263002",
            "speakerId": 1010,
            "speakerName": "回复",
            "text": "若是依照严格的规则来对，的确挺难。",
            "nextDialogs": [
              "401263003"
            ]
          },
          "401263003": {
            "id": "401263003",
            "speakerId": 1010,
            "speakerName": "回复",
            "text": "除了字数相同，还要讲究平仄相合、仄起平收、词性虚实相对什么的…",
            "nextDialogs": [
              "401263004"
            ]
          },
          "401263004": {
            "id": "401263004",
            "speakerId": 1010,
            "speakerName": "回复",
            "text": "不过难得有蒙德的朋友来玩，大家还是尽兴为好！"
          }
        }
      }
    },
    {
      "subId": "4012631",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401263101"
        ],
        "dialogs": {
          "401263101": {
            "id": "401263101",
            "speakerId": 1012,
            "speakerName": "某人留下的诗",
            "text": "「我想变成一只蘑菇，不用蓝得像湖，也不用映出高天的星图。」",
            "nextDialogs": [
              "401263102"
            ]
          },
          "401263102": {
            "id": "401263102",
            "speakerId": 1012,
            "speakerName": "某人留下的诗",
            "text": "「我想变成一只普普通通的，谁都不会采摘的蘑菇。」",
            "nextDialogs": [
              "401263103"
            ]
          },
          "401263103": {
            "id": "401263103",
            "speakerId": 1012,
            "speakerName": "某人留下的诗",
            "text": "「我想永远躲在树脚，除非凑巧遇上一只林猪，戴起我，如同戴上一脑袋的花束。」",
            "nextDialogs": [
              "401263104"
            ]
          },
          "401263104": {
            "id": "401263104",
            "speakerId": 1012,
            "speakerName": "某人留下的诗",
            "text": "「原来我并不想变成蘑菇，我只是害怕孤独。」"
          }
        }
      }
    },
    {
      "subId": "4012632",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401263201"
        ],
        "dialogs": {
          "401263201": {
            "id": "401263201",
            "speakerId": 1012,
            "speakerName": "某人留下的诗",
            "text": "「把诗琴的弦涂成彩虹的颜色，叮咚叮咚。」",
            "nextDialogs": [
              "401263202"
            ]
          },
          "401263202": {
            "id": "401263202",
            "speakerId": 1012,
            "speakerName": "某人留下的诗",
            "text": "「下起雨来，叶子也是甜的。」"
          }
        }
      }
    },
    {
      "subId": "7152102",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715210201"
        ],
        "dialogs": {
          "715210201": {
            "id": "715210201",
            "speakerId": 1013,
            "speakerName": "巴特洛",
            "text": "这幅画作需要修复的地方在这里…",
            "nextDialogs": [
              "715210202"
            ]
          },
          "715210202": {
            "id": "715210202",
            "speakerId": 1013,
            "speakerName": "巴特洛",
            "text": "#{NICKNAME}！真高兴见到您，再次感谢您愿意帮我去野外取景。",
            "nextDialogs": [
              "715210203"
            ]
          },
          "715210203": {
            "id": "715210203",
            "speakerId": 1013,
            "speakerName": "巴特洛",
            "text": "有了您的帮助，我一定能更高效地修复好这些画作。"
          }
        }
      }
    },
    {
      "subId": "7152202",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715220201"
        ],
        "dialogs": {
          "715220201": {
            "id": "715220201",
            "speakerId": 1014,
            "speakerName": "比勒",
            "text": "怎么？您想要再寻找寻找灵感吗？",
            "nextDialogs": [
              "715220203",
              "715220205"
            ]
          },
          "715220203": {
            "id": "715220203",
            "speakerId": 1014,
            "speakerName": "比勒",
            "text": "没问题，请来这边。好好感受灵感吧！"
          },
          "715220205": {
            "id": "715220205",
            "speakerId": 1014,
            "speakerName": "比勒",
            "text": "好吧，等您想玩了，直接过来这边就好。"
          }
        }
      }
    },
    {
      "subId": "7152302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "715230201"
        ],
        "dialogs": {
          "715230201": {
            "id": "715230201",
            "speakerId": 1015,
            "speakerName": "廷稚",
            "text": "您想来试玩一下「百步礼掷」吗？",
            "nextDialogs": [
              "715230203",
              "715230205"
            ]
          },
          "715230203": {
            "id": "715230203",
            "speakerId": 1015,
            "speakerName": "廷稚",
            "text": "没问题，这些「掷箭」您拿好，「容壶」就在那边。"
          },
          "715230205": {
            "id": "715230205",
            "speakerId": 1015,
            "speakerName": "廷稚",
            "text": "没关系，东西我都准备好了。您想玩的时候，直接过来就行。"
          }
        }
      }
    }
  ]
}
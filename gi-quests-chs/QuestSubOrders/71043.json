  "subQuests": [
    {
      "subId": "7104301",
      "subQuestName": "进入通往深处的通道",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710430101"
        ],
        "dialogs": {
          "710430101": {
            "id": "710430101",
            "speakerId": 1000,
            "speakerName": "愚人众的日志本",
            "text": "「…安东上士在东南方发现了一口大钟…岩壁上写着『它们』的文字…」",
            "nextDialogs": [
              "710430102"
            ]
          },
          "710430102": {
            "id": "710430102",
            "speakerId": 1000,
            "speakerName": "愚人众的日志本",
            "text": "「…和大尉之前在西北方的遗迹里看到的大钟相近，或许…」",
            "nextDialogs": [
              "710430103"
            ]
          },
          "710430103": {
            "id": "710430103",
            "speakerId": 1000,
            "speakerName": "愚人众的日志本",
            "text": "「…派遣雪奈茨芙娜与法迭卡两人，分别敲响两侧遗迹中的大钟…」",
            "nextDialogs": [
              "710430104"
            ]
          },
          "710430104": {
            "id": "710430104",
            "speakerId": 1000,
            "speakerName": "愚人众的日志本",
            "text": "「…可怖的呼啸声回荡在岩壁间，黑雾消散了。难以解释的奇特现象…似乎在昭告着谁的登场…」",
            "nextDialogs": [
              "710430105"
            ]
          },
          "710430105": {
            "id": "710430105",
            "speakerId": 1000,
            "speakerName": "愚人众的日志本",
            "text": "「…十人牺牲，两支先锋小队皆蒙受严重损失，大尉下令立即撤离…」",
            "nextDialogs": [
              "710430106"
            ]
          },
          "710430106": {
            "id": "710430106",
            "speakerId": 1000,
            "speakerName": "愚人众的日志本",
            "text": "（一张简易的地图从日志本中滑落，地图上标出了西北方与东南方的两处大钟，并画了两个醒目的骷髅头。）"
          }
        }
      }
    },

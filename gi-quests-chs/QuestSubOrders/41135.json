  },
  "subQuests": [
    {
      "subId": "4113501",
      "subQuestName": "(test)【隐藏】活动界面接任务$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411350101"
        ],
        "dialogs": {
          "411350101": {
            "id": "411350101",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "不知道葛罗丽怎么样了…",
            "nextDialogs": [
              "411350102"
            ]
          },
          "411350102": {
            "id": "411350102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "411350103"
            ]
          },
          "411350103": {
            "id": "411350103",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "你…是旅行者啊，现在野外很危险。",
            "nextDialogs": [
              "411350104"
            ]
          },
          "411350104": {
            "id": "411350104",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "如果你想找个安全的地方避难，就快点回蒙德城吧。",
            "nextDialogs": [
              "411350105"
            ]
          },
          "411350105": {
            "id": "411350105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你不进城吗？",
            "nextDialogs": [
              "411350106"
            ]
          },
          "411350106": {
            "id": "411350106",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "我…我暂时，就不回去了，毕竟我也是一名西风骑士…这个时候可不能退缩。",
            "nextDialogs": [
              "411350107"
            ]
          },
          "411350107": {
            "id": "411350107",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "虽然因为一些原因，我不能回蒙德城里帮忙，但是我也能在野外做些事情。",
            "nextDialogs": [
              "411350108"
            ]
          },
          "411350108": {
            "id": "411350108",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "陨石落下了之后，很多魔物被陨石影响，变得格外凶暴。",
            "nextDialogs": [
              "411350109"
            ]
          },
          "411350109": {
            "id": "411350109",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "如果放着不管的话，一定会酿成大祸，我正准备去把它们给清理掉。",
            "nextDialogs": [
              "411350110"
            ]
          },
          "411350110": {
            "id": "411350110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你一个人可以吗？",
            "nextDialogs": [
              "411350111"
            ]
          },
          "411350111": {
            "id": "411350111",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "呃，虽然那些怪物的数量有些多…但只要小心应对，我应该没问题。",
            "nextDialogs": [
              "411350112"
            ]
          },
          "411350112": {
            "id": "411350112",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "但我一个人去清理，不知道要清理到什么时候。",
            "nextDialogs": [
              "411350113"
            ]
          },
          "411350113": {
            "id": "411350113",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "旅行者，如果你愿意的话，能帮我去清理一些怪物的营地吗？",
            "nextDialogs": [
              "411350115",
              "411350117"
            ]
          },
          "411350115": {
            "id": "411350115",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "那就拜托你了，实在是帮大忙了。"
          },
          "411350117": {
            "id": "411350117",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "找骑士团求助…呃，这个嘛，真的不行…我有我自己的苦衷，你就别追问了。",
            "nextDialogs": [
              "411350118"
            ]
          },
          "411350118": {
            "id": "411350118",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "请你帮帮我吧，清理掉那些怪物营地，也算是给骑士团帮忙了。"
          }
        }
      }
    },
    {
      "subId": "4113502",
      "subQuestName": "与古德温对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4113503",
      "subQuestName": "清理丘丘人营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411350301"
        ],
        "dialogs": {
          "411350301": {
            "id": "411350301",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "你们把那些魔物都清理掉了吗？",
            "nextDialogs": [
              "411350302"
            ]
          },
          "411350302": {
            "id": "411350302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经清理掉了。",
            "nextDialogs": [
              "411350303"
            ]
          },
          "411350303": {
            "id": "411350303",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "感谢你，旅行者。这下那些魔物应该暂时形不成威胁了。",
            "nextDialogs": [
              "411350304"
            ]
          },
          "411350304": {
            "id": "411350304",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "你也快点回城里去吧，这种情况还让你在野外跑，真是不好意思。",
            "nextDialogs": [
              "411350305"
            ]
          },
          "411350305": {
            "id": "411350305",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "呃，然后…你回去城里的时候，能不能帮我留意一件事？",
            "nextDialogs": [
              "411350306"
            ]
          },
          "411350306": {
            "id": "411350306",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "很简单的！就，就帮我留意一下就好。",
            "nextDialogs": [
              "411350307"
            ]
          },
          "411350307": {
            "id": "411350307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "到底是什么事？",
            "nextDialogs": [
              "411350308"
            ]
          },
          "411350308": {
            "id": "411350308",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "那个，你回去城里之后，能不能帮我去看看葛罗丽的情况？",
            "nextDialogs": [
              "411350309"
            ]
          },
          "411350309": {
            "id": "411350309",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "她应该一直待在城里，不会有什么危险，但我就是放心不下。",
            "nextDialogs": [
              "411350310"
            ]
          },
          "411350310": {
            "id": "411350310",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "拜托你，帮我去看看她的情况吧。",
            "nextDialogs": [
              "411350311"
            ]
          },
          "411350311": {
            "id": "411350311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我知道了。",
            "nextDialogs": [
              "411350312"
            ]
          },
          "411350312": {
            "id": "411350312",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "谢谢你，旅行者。对了，请你…别告诉葛罗丽我在这，就…就说我还在很远的地方执行任务。",
            "nextDialogs": [
              "411350313"
            ]
          },
          "411350313": {
            "id": "411350313",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "抱歉，拜托你了，请一定要对她这么说，我有我的苦衷，拜托你了…"
          }
        }
      }
    },
    {
      "subId": "4113504",
      "subQuestName": "清理丘丘人营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411350401"
        ],
        "dialogs": {
          "411350401": {
            "id": "411350401",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "希望古德温平安无事…",
            "nextDialogs": [
              "411350402"
            ]
          },
          "411350402": {
            "id": "411350402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "古德温拜托我来看看你。",
            "nextDialogs": [
              "411350403"
            ]
          },
          "411350403": {
            "id": "411350403",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "古德温？您，您知道他在哪吗？我很久都没他的消息了，一直在担心他。",
            "nextDialogs": [
              "411350404"
            ]
          },
          "411350404": {
            "id": "411350404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他还在很远的地方执行任务。",
            "nextDialogs": [
              "411350405"
            ]
          },
          "411350405": {
            "id": "411350405",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "是…这样吗？那好吧。",
            "nextDialogs": [
              "411350406"
            ]
          },
          "411350406": {
            "id": "411350406",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "如果没有这些陨石，我都想要去骑士团问问他的下落了…",
            "nextDialogs": [
              "411350407"
            ]
          },
          "411350407": {
            "id": "411350407",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "我一直待在城里，所以很安全。但他应该会去野外执行任务吧，如果全世界的各种地方都有陨石坠落的话，那…",
            "nextDialogs": [
              "411350408"
            ]
          },
          "411350408": {
            "id": "411350408",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "唉，希望他平安无事。",
            "nextDialogs": [
              "411350409"
            ]
          },
          "411350409": {
            "id": "411350409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他一定会平安无事的。",
            "nextDialogs": [
              "411350410"
            ]
          },
          "411350410": {
            "id": "411350410",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "谢谢您，这样的话就最好了。对了，如果您愿意的话，能帮我个忙吗？",
            "nextDialogs": [
              "411350411"
            ]
          },
          "411350411": {
            "id": "411350411",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "我找芙萝拉小姐买了一份蒲公英籽，本来想找人帮我去高处播撒…让风把它们带给古德温。",
            "nextDialogs": [
              "411350412"
            ]
          },
          "411350412": {
            "id": "411350412",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "但现在城里的情况您也看到了，一时间我也找不到人帮忙…",
            "nextDialogs": [
              "411350413"
            ]
          },
          "411350413": {
            "id": "411350413",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "现在正好您来了，您愿意帮我把这些蒲公英籽带给古德温吗？",
            "nextDialogs": [
              "411350414"
            ]
          },
          "411350414": {
            "id": "411350414",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题。",
            "nextDialogs": [
              "411350415"
            ]
          },
          "411350415": {
            "id": "411350415",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "谢谢您，他现在一定在很远的地方吧，毕竟他是跟着那位大团长去执行任务了呢。",
            "nextDialogs": [
              "411350416"
            ]
          },
          "411350416": {
            "id": "411350416",
            "speakerId": 1521,
            "speakerName": "葛罗丽",
            "text": "请您把这份蒲公英籽带给他，告诉他我很好，然后…让他也注意安全。"
          }
        }
      }
    },
    {

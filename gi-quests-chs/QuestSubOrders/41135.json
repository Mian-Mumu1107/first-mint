    {
      "subId": "4113507",
      "subQuestName": "将蒲公英籽带给古德温",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411350501"
        ],
        "dialogs": {
          "411350501": {
            "id": "411350501",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "旅行者，你见到葛罗丽了吗？",
            "nextDialogs": [
              "411350502"
            ]
          },
          "411350502": {
            "id": "411350502",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "葛罗丽的情况怎么样？她还好吗？没受伤吧？哦对…她应该一直待在城里，不过…",
            "nextDialogs": [
              "411350503"
            ]
          },
          "411350503": {
            "id": "411350503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是她给你的蒲公英籽。",
            "nextDialogs": [
              "411350504"
            ]
          },
          "411350504": {
            "id": "411350504",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "呃？蒲公英籽…确实是她的作风，唉，葛罗丽…希望她别生我的气…",
            "nextDialogs": [
              "411350505"
            ]
          },
          "411350505": {
            "id": "411350505",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "谢谢你帮我去跑这么一趟，我得给你点报酬才行，这些东西请收下吧。",
            "nextDialogs": [
              "411350506"
            ]
          },
          "411350506": {
            "id": "411350506",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "唉，要是大团长能回来的话，那就什么问题都没有了…"
          }
        }
      }
    },
    {
      "subId": "4113502",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411350201"
        ],
        "dialogs": {
          "411350201": {
            "id": "411350201",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "大团长到底在哪啊…出了这么大的事，也不知道他收没收到消息…",
            "nextDialogs": [
              "411350202"
            ]
          },
          "411350202": {
            "id": "411350202",
            "speakerId": 1553,
            "speakerName": "古德温",
            "text": "不过，就算他收到了消息，应该一时半会也赶不回来，唉…"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "1103304",
      "subQuestName": "(test)首环开车$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110330401"
        ],
        "dialogs": {
          "110330401": {
            "id": "110330401",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "果然如本仙所想，万民堂堂主确是一位通情达理之人。",
            "nextDialogs": [
              "110330402"
            ]
          },
          "110330402": {
            "id": "110330402",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "不过在这里工作，难免要和各种各样的人打交道。申鹤，你能应付过来吗？",
            "nextDialogs": [
              "110330403"
            ]
          },
          "110330403": {
            "id": "110330403",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "我想可以。有时会遇到奇怪的人，但我已经可以妥善处理了。",
            "nextDialogs": [
              "110330404"
            ]
          },
          "110330404": {
            "id": "110330404",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "看来申鹤也成长了呀。顺带一问，「妥善处理」是指什么呢？",
            "nextDialogs": [
              "110330405"
            ]
          },
          "110330405": {
            "id": "110330405",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "先跟他们讲道理。如果他们不听，就亮出拳头，这样他们就会主动跟我讲道理了。",
            "nextDialogs": [
              "110330406"
            ]
          },
          "110330406": {
            "id": "110330406",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呃…怎么说呢…",
            "nextDialogs": [
              "110330407"
            ]
          },
          "110330407": {
            "id": "110330407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好像也没什么问题？",
            "nextDialogs": [
              "110330408"
            ]
          },
          "110330408": {
            "id": "110330408",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "如此甚好，看来你已经很好地融入了人类社会，本仙可以放心了。",
            "nextDialogs": [
              "110330409"
            ]
          },
          "110330409": {
            "id": "110330409",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "师父呢？一切可好？",
            "nextDialogs": [
              "110330410"
            ]
          },
          "110330410": {
            "id": "110330410",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "本仙好得很！就算你们都不回奥藏山，本仙一个人也能过得潇洒自在。",
            "nextDialogs": [
              "110330411"
            ]
          },
          "110330411": {
            "id": "110330411",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "原来如此，真不愧是师父。",
            "nextDialogs": [
              "110330412"
            ]
          },
          "110330412": {
            "id": "110330412",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "哼…哼！",
            "nextDialogs": [
              "110330413"
            ]
          },
          "110330413": {
            "id": "110330413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实留云真君还是很想念你们的。",
            "nextDialogs": [
              "110330414"
            ]
          },
          "110330414": {
            "id": "110330414",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "我也很想念师父。虽然最近工作很忙，但我已经和卯先生商量过，过些时日就回奥藏山探望师父。",
            "nextDialogs": [
              "110330415"
            ]
          },
          "110330415": {
            "id": "110330415",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "竟有此事？咳，下次记得在信中一并说明，不要藏着掖着。",
            "nextDialogs": [
              "110330416"
            ]
          },
          "110330416": {
            "id": "110330416",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "仙人的心情变得真快…",
            "nextDialogs": [
              "110330417"
            ]
          },
          "110330417": {
            "id": "110330417",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "对了，师父此次来璃月港，可曾见过甘雨师姐？",
            "nextDialogs": [
              "110330418"
            ]
          },
          "110330418": {
            "id": "110330418",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "见过，她和你一样忙于工作，本仙寒暄几句就走了。",
            "nextDialogs": [
              "110330419"
            ]
          },
          "110330419": {
            "id": "110330419",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "甘雨给我们讲了「留云借风」这个名字的来历，我才知道原来仙君以前是这么厉害的仙人！",
            "nextDialogs": [
              "110330420"
            ]
          },
          "110330420": {
            "id": "110330420",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "这样啊。既然如此，我也给你们讲一个师父以前的故事吧。",
            "nextDialogs": [
              "110330421"
            ]
          },
          "110330421": {
            "id": "110330421",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "嗯？",
            "nextDialogs": [
              "110330422"
            ]
          },
          "110330422": {
            "id": "110330422",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "有什么问题吗，师父？我感觉这是一个不错的话题。",
            "nextDialogs": [
              "110330423"
            ]
          },
          "110330423": {
            "id": "110330423",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "不…只是有些措手不及。但讲无妨，就让本仙看看，你将本仙的聊天技巧学去了几成。",
            "nextDialogs": [
              "110330424"
            ]
          },
          "110330424": {
            "id": "110330424",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "我记得师父曾经与削月筑阳真君比试速度。削月真君落败后，认为师父擅长飞行，在比试中天然占优。",
            "nextDialogs": [
              "110330425"
            ]
          },
          "110330425": {
            "id": "110330425",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "师父便说自己可以放弃飞行，只用法宝和他相比。削月真君欣然答应，到比试当天，师父拿出了一个无人见过的法宝。",
            "nextDialogs": [
              "110330426"
            ]
          },
          "110330426": {
            "id": "110330426",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呃，什么样的法宝？",
            "nextDialogs": [
              "110330427"
            ]
          },
          "110330427": {
            "id": "110330427",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "一种铁制的机械车，记得好像是叫「电驱双轮飞车」…？",
            "nextDialogs": [
              "110330428"
            ]
          },
          "110330428": {
            "id": "110330428",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "是「电光双轮飞驰机」。这可是本仙耗费七七四十九天才制成的得意之作，只需注入仙力，即可日行万里。",
            "nextDialogs": [
              "110330429"
            ]
          },
          "110330429": {
            "id": "110330429",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "削月筑阳那家伙哪里是本仙的对手？四条腿放开了跑，也只能勉强跟在本仙身后罢了。",
            "nextDialogs": [
              "110330430"
            ]
          },
          "110330430": {
            "id": "110330430",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "只可惜电光双轮飞驰机并不擅长应对山地，在终点前翻了出去。距离获胜只差一点，实在令人惋惜…你继续讲。",
            "nextDialogs": [
              "110330431"
            ]
          },
          "110330431": {
            "id": "110330431",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "师父，你刚刚已经讲完了。",
            "nextDialogs": [
              "110330432"
            ]
          },
          "110330432": {
            "id": "110330432",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "是吗？唉，总之你下山的这段时间里，奥藏山少了观众，本仙也没有兴致再和那些老家伙们比试了。",
            "nextDialogs": [
              "110330433"
            ]
          },
          "110330433": {
            "id": "110330433",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "师父是感到寂寞了吗？",
            "nextDialogs": [
              "110330434"
            ]
          },
          "110330434": {
            "id": "110330434",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "寂寞？呵，以本仙这个年纪，不知道见证了多少人的一生。光是与自己聊天，就可以讲上几天几夜不停歇。",
            "nextDialogs": [
              "110330435"
            ]
          },
          "110330435": {
            "id": "110330435",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "本仙怎么会感到寂寞，真是一派胡言！",
            "nextDialogs": [
              "110330436"
            ]
          },
          "110330436": {
            "id": "110330436",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "110330437"
            ]
          },
          "110330437": {
            "id": "110330437",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "做什么？为何是这副表情？",
            "nextDialogs": [
              "110330438"
            ]
          },
          "110330438": {
            "id": "110330438",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没有啦，刚刚听甘雨讲你可以呼风唤雨的时候，不自觉地就开始尊敬你了。结果你一开口说话，感觉又变成熟悉的那只仙鸟了。",
            "nextDialogs": [
              "110330439"
            ]
          },
          "110330439": {
            "id": "110330439",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我都有些搞不懂啦，到底哪个才是真正的留云借风真君呢？",
            "nextDialogs": [
              "110330440"
            ]
          },
          "110330440": {
            "id": "110330440",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "对我而言，两个都是师父。一个是受人爱戴的师父，一个是我喜欢的师父。",
            "nextDialogs": [
              "110330441"
            ]
          },
          "110330441": {
            "id": "110330441",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "哈，一个两个都这样，净挑些好听的话来糊弄本仙。嘴上将本仙夸得天花乱坠，却又都不愿留在奥藏山长住。",
            "nextDialogs": [
              "110330442"
            ]
          },
          "110330442": {
            "id": "110330442",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "不过你方才所言，倒也没什么问题。本仙本就如此：无为无法，逍遥自在，想做便做，想说就说，无需他人评判。",
            "nextDialogs": [
              "110330443"
            ]
          },
          "110330443": {
            "id": "110330443",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "留云这家伙，被徒弟夸了几句，感觉鼻子都要翘到天上去啦。",
            "nextDialogs": [
              "110330444"
            ]
          },
          "110330444": {
            "id": "110330444",
            "speakerId": 1003,
            "speakerName": "宝泰",
            "text": "店里还有空位吗？",
            "nextDialogs": [
              "110330445"
            ]
          },
          "110330445": {
            "id": "110330445",
            "speakerId": 1004,
            "speakerName": "砥心",
            "text": "你好，我这桌再加一份水煮鱼！",
            "nextDialogs": [
              "110330446"
            ]
          },
          "110330446": {
            "id": "110330446",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "…客人多起来了。我先去帮忙了。",
            "nextDialogs": [
              "110330447"
            ]
          },
          "110330447": {
            "id": "110330447",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好呀，加油申鹤！",
            "nextDialogs": [
              "110330448"
            ]
          },
          "110330448": {
            "id": "110330448",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "嗯。我会努力工作的。"
          }
        }
      }
    },
    {
      "subId": "1103301",
      "subQuestName": "前往奥藏山",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110330101"
        ],
        "dialogs": {
          "110330101": {
            "id": "110330101",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "到了到了，就是这里！",
            "nextDialogs": [
              "110330102"
            ]
          },
          "110330102": {
            "id": "110330102",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "记得第一次来的时候，我们还特地给她准备了贡品呢。",
            "nextDialogs": [
              "110330103"
            ]
          },
          "110330103": {
            "id": "110330103",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "当时告诉她帝君遇刺的消息，她凶巴巴地说要「镇压璃月港」。我还以为她会是个很难相处的仙人，后来发现完全不是这么回事嘛。",
            "nextDialogs": [
              "110330104"
            ]
          },
          "110330104": {
            "id": "110330104",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "凭我们现在的关系，不用贡品也能见面了吧？我的零食袋还剩一点好吃的，如果她问起来的话，就把这个给她吧！",
            "nextDialogs": [
              "110330105"
            ]
          },
          "110330105": {
            "id": "110330105",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#嗯？{NICKNAME}，你怎么突然开始发呆了？",
            "nextDialogs": [
              "110330108"
            ]
          },
          "110330108": {
            "id": "110330108",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我看看——欸，好漂亮的人！她也是来找留云借风真君的吗？",
            "nextDialogs": [
              "110330109"
            ]
          },
          "110330109": {
            "id": "110330109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉像是一位很厉害的仙人。",
            "nextDialogs": [
              "110330110"
            ]
          },
          "110330110": {
            "id": "110330110",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "是呀，看她的气场，明显不是一般人。不愧是那个女人，人脉真广，认识好多我们不了解的仙人！",
            "nextDialogs": [
              "110330111"
            ]
          },
          "110330111": {
            "id": "110330111",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我想想…既然我们和她都是留云借风的朋友，那我们应该也算朋友吧？要不要上去打个招呼？"
          }
        }
      }
    },
    {
      "subId": "1103302",
      "subQuestName": "前往月海亭见甘雨",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110330201"
        ],
        "dialogs": {
          "110330201": {
            "id": "110330201",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "马上就到月海亭了，你说甘雨见到普通人模样的真君，会不会大吃一惊呢？",
            "nextDialogs": [
              "110330202"
            ]
          },
          "110330202": {
            "id": "110330202",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "也不知道甘雨和申鹤有没有见过人形仙鸟…咦，她跑到哪里去了？",
            "nextDialogs": [
              "110330205"
            ]
          },
          "110330205": {
            "id": "110330205",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你怎么不走了？",
            "nextDialogs": [
              "110330206"
            ]
          },
          "110330206": {
            "id": "110330206",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "悄声。本仙就待在这里，你们单独去见她吧。",
            "nextDialogs": [
              "110330207"
            ]
          },
          "110330207": {
            "id": "110330207",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嗯？为什么呀，一起去不好吗？",
            "nextDialogs": [
              "110330208"
            ]
          },
          "110330208": {
            "id": "110330208",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "哼，本仙若是大张旗鼓地登门，那孩子肯定会放下手中工作，装作百般清闲的模样招待本仙，过后再加班加点追赶进度。",
            "nextDialogs": [
              "110330209"
            ]
          },
          "110330209": {
            "id": "110330209",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "本仙不愿她为难，止步此处遥望一番即可。你们替本仙问问她近来是否安好，切记！不要说本仙来了璃月港！",
            "nextDialogs": [
              "110330210"
            ]
          },
          "110330210": {
            "id": "110330210",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好像确实有道理。好吧，我们就替你向她问好——",
            "nextDialogs": [
              "110330211"
            ]
          },
          "110330211": {
            "id": "110330211",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "留云真君？",
            "nextDialogs": [
              "110330212"
            ]
          },
          "110330212": {
            "id": "110330212",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "！！",
            "nextDialogs": [
              "110330213"
            ]
          },
          "110330213": {
            "id": "110330213",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "被发现了！",
            "nextDialogs": [
              "110330214"
            ]
          },
          "110330214": {
            "id": "110330214",
            "speakerId": 1007,
            "speakerName": "慧心",
            "text": "是甘雨前辈认识的人吗？",
            "nextDialogs": [
              "110330215"
            ]
          },
          "110330215": {
            "id": "110330215",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "嗯。抱歉，接下来的会议可以推迟一段时间吗？我记得今天的日程比较满，不过有些工作可以挪到夜间完成…",
            "nextDialogs": [
              "110330216"
            ]
          },
          "110330216": {
            "id": "110330216",
            "speakerId": 1007,
            "speakerName": "慧心",
            "text": "好的，我来安排，请前辈放心。",
            "nextDialogs": [
              "110330217"
            ]
          },
          "110330217": {
            "id": "110330217",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "那就拜托你了。",
            "nextDialogs": [
              "110330218"
            ]
          },
          "110330218": {
            "id": "110330218",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "又见面啦，甘雨。",
            "nextDialogs": [
              "110330219"
            ]
          },
          "110330219": {
            "id": "110330219",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "是啊，你们怎么来了？还有真君…好久没有见到您以人形现世了。",
            "nextDialogs": [
              "110330220"
            ]
          },
          "110330220": {
            "id": "110330220",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "你认错了，本仙并非留云借风真君，只是个路过的普通人罢了！",
            "nextDialogs": [
              "110330221"
            ]
          },
          "110330221": {
            "id": "110330221",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "…？",
            "nextDialogs": [
              "110330222"
            ]
          },
          "110330222": {
            "id": "110330222",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好像不管用！",
            "nextDialogs": [
              "110330223"
            ]
          },
          "110330223": {
            "id": "110330223",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "完全没藏住！",
            "nextDialogs": [
              "110330224"
            ]
          },
          "110330224": {
            "id": "110330224",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "咳，方才是个小小的考验。没想到过去这么久，你仍旧能一眼认出本仙。",
            "nextDialogs": [
              "110330225"
            ]
          },
          "110330225": {
            "id": "110330225",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（甘雨的表情困惑极了，像在问「为什么认不出呢？曾经日日见面的人与日日盖着的被褥一样好认…」）",
            "nextDialogs": [
              "110330226"
            ]
          },
          "110330226": {
            "id": "110330226",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "认得真君，呃…本，本是应当。",
            "nextDialogs": [
              "110330227"
            ]
          },
          "110330227": {
            "id": "110330227",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "哈，也是。",
            "nextDialogs": [
              "110330228"
            ]
          },
          "110330228": {
            "id": "110330228",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "本仙另有要事在身，只是途经此地，免不得要来见你一面。",
            "nextDialogs": [
              "110330229"
            ]
          },
          "110330229": {
            "id": "110330229",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "我们有什么要事…啊！",
            "nextDialogs": [
              "110330230"
            ]
          },
          "110330230": {
            "id": "110330230",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没错，我们有「很重要的事」要做，所以不能在这里停留太久啦。",
            "nextDialogs": [
              "110330231"
            ]
          },
          "110330231": {
            "id": "110330231",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "这样吗…可是难得和你们见面…",
            "nextDialogs": [
              "110330232"
            ]
          },
          "110330232": {
            "id": "110330232",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "本仙只想探望，无意叨扰。今日先如此闲聊片刻，待你休息再小聚一番便好。",
            "nextDialogs": [
              "110330233"
            ]
          },
          "110330233": {
            "id": "110330233",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "我明白了。这样也好…",
            "nextDialogs": [
              "110330234"
            ]
          },
          "110330234": {
            "id": "110330234",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "本仙知你工作繁忙，但仍要注意休息。虽是半仙之躯，过度劳累也会伤本损基。",
            "nextDialogs": [
              "110330235"
            ]
          },
          "110330235": {
            "id": "110330235",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "唉，见到你如今独当一面的样子，不免感慨。你呀，小时候就连做噩梦都要本仙抱着你睡——",
            "nextDialogs": [
              "110330236"
            ]
          },
          "110330236": {
            "id": "110330236",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "等、等一下…留云真君！",
            "nextDialogs": [
              "110330237"
            ]
          },
          "110330237": {
            "id": "110330237",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "也罢，时间有限，就不一一细讲了。你们叙旧吧，本仙在旁边听着便是。",
            "nextDialogs": [
              "110330238"
            ]
          },
          "110330238": {
            "id": "110330238",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "跟甘雨聊了聊最近的见闻…",
            "nextDialogs": [
              "110330239"
            ]
          },
          "110330239": {
            "id": "110330239",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "没想到上次分别之后，你们又去了这么多地方。如果有需要帮忙的事情，可以来月海亭找我…",
            "nextDialogs": [
              "110330240"
            ]
          },
          "110330240": {
            "id": "110330240",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "另外…我想冒昧问下，真君既然化作人形，要不要起一个属于「人」的名字呢？",
            "nextDialogs": [
              "110330241"
            ]
          },
          "110330241": {
            "id": "110330241",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "人的名字？也是，本仙声名在外，即便自称「留云」，也很容易被认出来。",
            "nextDialogs": [
              "110330242"
            ]
          },
          "110330242": {
            "id": "110330242",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "虽然知道你很有名啦，但是真的有这么夸张吗？",
            "nextDialogs": [
              "110330243"
            ]
          },
          "110330243": {
            "id": "110330243",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "哼，本仙赫赫威名，岂是你们所能尽知的？甘雨说得在理，人前就称呼本仙「闲云」吧。",
            "nextDialogs": [
              "110330244"
            ]
          },
          "110330244": {
            "id": "110330244",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "闲云？",
            "nextDialogs": [
              "110330245"
            ]
          },
          "110330245": {
            "id": "110330245",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "啊，是取自《清斋广录》里的描述吧。",
            "nextDialogs": [
              "110330246"
            ]
          },
          "110330246": {
            "id": "110330246",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "「时有仙人，谐云霓而起，随日月而居，慧智明理，漫无羁束，故曰之『闲』。」",
            "nextDialogs": [
              "110330247"
            ]
          },
          "110330247": {
            "id": "110330247",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "听起来好厉害！谐云霓、随日月——那应该是很厉害的仙人才能做到的事情吧！",
            "nextDialogs": [
              "110330248"
            ]
          },
          "110330248": {
            "id": "110330248",
            "speakerId": 1006,
            "speakerName": "甘雨",
            "text": "其实，这几句就是描写留云真君的。",
            "nextDialogs": [
              "110330249"
            ]
          },
          "110330249": {
            "id": "110330249",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸？！等下，原来你是这么厉害的仙人吗？",
            "nextDialogs": [
              "110330250"
            ]
          },
          "110330250": {
            "id": "110330250",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "不然呢？难道在你眼中，本仙只是个大一点的鸟？",
            "nextDialogs": [
              "110330251"
            ]
          },
          "110330251": {
            "id": "110330251",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "没、没有啦…"
          }
        }
      }
    },
    {
      "subId": "1103303",
      "subQuestName": "前往万民堂见申鹤",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110330301"
        ],
        "dialogs": {
          "110330301": {
            "id": "110330301",
            "speakerId": 1009,
            "speakerName": "问柳",
            "text": "你知道我想说什么吧？",
            "nextDialogs": [
              "110330302"
            ]
          },
          "110330302": {
            "id": "110330302",
            "speakerId": 1010,
            "speakerName": "庆继",
            "text": "嗯，我很清楚。佳人在前，就连佳肴也食之无味。",
            "nextDialogs": [
              "110330303"
            ]
          },
          "110330303": {
            "id": "110330303",
            "speakerId": 1009,
            "speakerName": "问柳",
            "text": "比起菜单，更想要她的联系方式啊。要不，你去问问？",
            "nextDialogs": [
              "110330304"
            ]
          },
          "110330304": {
            "id": "110330304",
            "speakerId": 1010,
            "speakerName": "庆继",
            "text": "你来吧。",
            "nextDialogs": [
              "110330305"
            ]
          },
          "110330305": {
            "id": "110330305",
            "speakerId": 1009,
            "speakerName": "问柳",
            "text": "不不，还是你来…等等，她过来了！",
            "nextDialogs": [
              "110330306"
            ]
          },
          "110330306": {
            "id": "110330306",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "请问两位吃点什么？",
            "nextDialogs": [
              "110330307"
            ]
          },
          "110330307": {
            "id": "110330307",
            "speakerId": 1010,
            "speakerName": "庆继",
            "text": "小姐你好，不知可否——",
            "nextDialogs": [
              "110330308"
            ]
          },
          "110330308": {
            "id": "110330308",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "吃点什么？",
            "nextDialogs": [
              "110330309"
            ]
          },
          "110330309": {
            "id": "110330309",
            "speakerId": 1010,
            "speakerName": "庆继",
            "text": "噫！",
            "nextDialogs": [
              "110330310"
            ]
          },
          "110330310": {
            "id": "110330310",
            "speakerId": 1009,
            "speakerName": "问柳",
            "text": "两份摩拉肉，打包带走。我们先告辞了！",
            "nextDialogs": [
              "110330311"
            ]
          },
          "110330311": {
            "id": "110330311",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "申鹤——",
            "nextDialogs": [
              "110330312"
            ]
          },
          "110330312": {
            "id": "110330312",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "欢迎光临。好久不见。吃点什么？",
            "nextDialogs": [
              "110330313"
            ]
          },
          "110330313": {
            "id": "110330313",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "不要把「欢迎顾客的台词」和「打招呼的话」一起说啦！",
            "nextDialogs": [
              "110330314"
            ]
          },
          "110330314": {
            "id": "110330314",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好久不见，申鹤。",
            "nextDialogs": [
              "110330315"
            ]
          },
          "110330315": {
            "id": "110330315",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "嗯。",
            "nextDialogs": [
              "110330316"
            ]
          },
          "110330316": {
            "id": "110330316",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "这位是…",
            "nextDialogs": [
              "110330317"
            ]
          },
          "110330317": {
            "id": "110330317",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "嘿嘿，这位是「闲云小姐」！",
            "nextDialogs": [
              "110330318"
            ]
          },
          "110330318": {
            "id": "110330318",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "…师父？",
            "nextDialogs": [
              "110330319"
            ]
          },
          "110330319": {
            "id": "110330319",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "欸？！",
            "nextDialogs": [
              "110330320"
            ]
          },
          "110330320": {
            "id": "110330320",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "呵，印象里你从未见过本仙这副样子，为何能一语道破本仙身份？",
            "nextDialogs": [
              "110330321"
            ]
          },
          "110330321": {
            "id": "110330321",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "朝夕相处十余载，无论师父变成什么样子，我都能认得。",
            "nextDialogs": [
              "110330322"
            ]
          },
          "110330322": {
            "id": "110330322",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "你…",
            "nextDialogs": [
              "110330323"
            ]
          },
          "110330323": {
            "id": "110330323",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "怎么了，师父？",
            "nextDialogs": [
              "110330324"
            ]
          },
          "110330324": {
            "id": "110330324",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "没事。看到你的信，知道你在璃月港打工，过来看看。",
            "nextDialogs": [
              "110330325"
            ]
          },
          "110330325": {
            "id": "110330325",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "顺便来吃好吃的！",
            "nextDialogs": [
              "110330326"
            ]
          },
          "110330326": {
            "id": "110330326",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "的确，快到午饭时间了…抱歉，我正在工作，恐怕不能久聊。",
            "nextDialogs": [
              "110330327"
            ]
          },
          "110330327": {
            "id": "110330327",
            "speakerId": 1011,
            "speakerName": "卯师傅",
            "text": "#这不是{NICKNAME}和派蒙嘛。你们是来找申鹤的？",
            "nextDialogs": [
              "110330328"
            ]
          },
          "110330328": {
            "id": "110330328",
            "speakerId": 1011,
            "speakerName": "卯师傅",
            "text": "申鹤，现在还没到饭点，顾客不多，我能招呼过来。",
            "nextDialogs": [
              "110330329"
            ]
          },
          "110330329": {
            "id": "110330329",
            "speakerId": 1011,
            "speakerName": "卯师傅",
            "text": "你先坐下和朋友们聊会儿天吧，等人多了再来帮忙也行。",
            "nextDialogs": [
              "110330330"
            ]
          },
          "110330330": {
            "id": "110330330",
            "speakerId": 1001,
            "speakerName": "申鹤",
            "text": "非常感谢。",
            "nextDialogs": [
              "110330331"
            ]
          },
          "110330331": {
            "id": "110330331",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好耶！"
          }
        }
      }
    },
    {
      "subId": "1103305",
      "subQuestName": "落座聊天",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1103306",
      "subQuestName": "准备吃饭",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110330501"
        ],
        "dialogs": {
          "110330501": {
            "id": "110330501",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "店里的人逐渐增加，派蒙也一口气点了很多好吃的。",
            "nextDialogs": [
              "110330502"
            ]
          },
          "110330502": {
            "id": "110330502",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "这么多好吃的！这次我一定要大吃一顿！",
            "nextDialogs": [
              "110330505"
            ]
          },
          "110330505": {
            "id": "110330505",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "本仙喜爱各种美食，并不囿于口味之别。",
            "nextDialogs": [
              "110330506"
            ]
          },
          "110330506": {
            "id": "110330506",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "这家店的菜品火候精妙、风味独特，本仙十分满意，尝罢便已隐约有了下代烹饪神机的灵感。",
            "nextDialogs": [
              "110330507"
            ]
          },
          "110330507": {
            "id": "110330507",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "真好吃…就是有点辣…",
            "nextDialogs": [
              "110330508"
            ]
          },
          "110330508": {
            "id": "110330508",
            "speakerId": 1011,
            "speakerName": "卯师傅",
            "text": "不好意思啊小姑娘，店里已经满座了。",
            "nextDialogs": [
              "110330509"
            ]
          },
          "110330509": {
            "id": "110330509",
            "speakerId": 1012,
            "speakerName": "？？？",
            "text": "奶奶，要不我们换一家店？",
            "nextDialogs": [
              "110330510"
            ]
          },
          "110330510": {
            "id": "110330510",
            "speakerId": 1012,
            "speakerName": "？？？",
            "text": "好香的味道。不能在这里吃吗？我已经走不动路了。",
            "nextDialogs": [
              "110330511"
            ]
          },
          "110330511": {
            "id": "110330511",
            "speakerId": 1011,
            "speakerName": "卯师傅",
            "text": "或者你们问问，有没有哪桌客人愿意拼桌？",
            "nextDialogs": [
              "110330512"
            ]
          },
          "110330512": {
            "id": "110330512",
            "speakerId": 1012,
            "speakerName": "？？？",
            "text": "也好。我们问问看吧。",
            "nextDialogs": [
              "110330513"
            ]
          },
          "110330513": {
            "id": "110330513",
            "speakerId": 1012,
            "speakerName": "？？？",
            "text": "你们好，不知道方便拼桌吗？店里没有别的地方坐了。",
            "nextDialogs": [
              "110330514"
            ]
          },
          "110330514": {
            "id": "110330514",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊，我倒是不介意啦。你们觉得呢？"
          }
        }
      }
    },
    {
      "subId": "1103306",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110330601"
        ],
        "dialogs": {
          "110330601": {
            "id": "110330601",
            "speakerId": 1013,
            "speakerName": "<UNKNOWN>",
            "text": "(test)台词文本"
          }
        }
      }
    },
    {
      "subId": "1103308",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110330801"
        ],
        "dialogs": {
          "110330801": {
            "id": "110330801",
            "speakerId": 1014,
            "speakerName": "桌上的机关",
            "text": "（造型别致的神秘机关，不知为何让人很难移开视线。）",
            "nextDialogs": [
              "110330802"
            ]
          },
          "110330802": {
            "id": "110330802",
            "speakerId": 1014,
            "speakerName": "桌上的机关",
            "text": "（貌似是留云借风真君的新发明，不知道有什么用…）"
          }
        }
      }
    },
    {
      "subId": "1103310",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110331001"
        ],
        "dialogs": {
          "110331001": {
            "id": "110331001",
            "speakerId": 1011,
            "speakerName": "卯师傅",
            "text": "香菱这孩子跑哪去了…",
            "nextDialogs": [
              "110331002"
            ]
          },
          "110331002": {
            "id": "110331002",
            "speakerId": 1011,
            "speakerName": "卯师傅",
            "text": "你们要是见到她，帮我跟她说一声：店里进了些新的香料，让她抽空回来看看。"
          }
        }
      }
    },
    {
      "subId": "1103399",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110339901"
        ],
        "dialogs": {
          "110339901": {
            "id": "110339901",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "最近去了好多地方呀！今天就先不考虑冒险的事情了，休息一下怎么样？",
            "nextDialogs": [
              "110339902"
            ]
          },
          "110339902": {
            "id": "110339902",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "让我想想，去哪玩比较好呢…对了！去奥藏山转转怎么样？",
            "nextDialogs": [
              "110339903"
            ]
          },
          "110339903": {
            "id": "110339903",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "好久没见到那只仙鸟啦，以前她总是突然出现，吓我们一跳。嘿嘿，这次我们也给她来一个突然袭击！",
            "nextDialogs": [
              "110339904"
            ]
          },
          "110339904": {
            "id": "110339904",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "唉，说到甘雨，那孩子一天到晚忙于工作，每年回奥藏山的次数屈指可数。",
            "nextDialogs": [
              "110339905"
            ]
          },
          "110339905": {
            "id": "110339905",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "最近申鹤好像也找到新工作了，写信给本仙，说什么「近期先不回来住了」。",
            "nextDialogs": [
              "110339906"
            ]
          },
          "110339906": {
            "id": "110339906",
            "speakerId": 1005,
            "speakerName": "留云借风真君",
            "text": "哼，本仙是这么好打发的吗？这次一定要去亲眼看看，她们到底是不是在糊弄本仙！",
            "nextDialogs": [
              "110339907"
            ]
          },
          "110339907": {
            "id": "110339907",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呼…怎么样，刚刚我配合得还不错吧？",
            "nextDialogs": [
              "110339908"
            ]
          },
          "110339908": {
            "id": "110339908",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "你一说「有要事在身」，我立刻明白你是不想耽误甘雨工作，所以借口有事提前离开，对吧？",
            "nextDialogs": [
              "110339909"
            ]
          },
          "110339909": {
            "id": "110339909",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "倒也不算借口。本仙此番来璃月港，的确有要做的事。",
            "nextDialogs": [
              "110339910"
            ]
          },
          "110339910": {
            "id": "110339910",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "啊？真的假的？",
            "nextDialogs": [
              "110339911"
            ]
          },
          "110339911": {
            "id": "110339911",
            "speakerId": 1000,
            "speakerName": "闲云",
            "text": "眼下时机未到，稍后你自会知晓。",
            "nextDialogs": [
              "110339912"
            ]
          },
          "110339912": {
            "id": "110339912",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "唔…因为刚听完故事的原因吗，我居然真的感觉她言谈举止多了一种神秘的仙人做派…",
            "nextDialogs": [
              "110339913"
            ]
          },
          "110339913": {
            "id": "110339913",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "店里的人逐渐增加，派蒙也一口气点了很多好吃的。",
            "nextDialogs": [
              "110339914"
            ]
          },
          "110339914": {
            "id": "110339914",
            "speakerId": 1003,
            "speakerName": "宝泰",
            "text": "一直都想来尝尝…",
            "nextDialogs": [
              "110339915"
            ]
          },
          "110339915": {
            "id": "110339915",
            "speakerId": 1004,
            "speakerName": "砥心",
            "text": "真是物美价廉的好地方！",
            "nextDialogs": [
              "110339916"
            ]
          },
          "110339916": {
            "id": "110339916",
            "speakerId": 1009,
            "speakerName": "问柳",
            "text": "大家放开肚皮吃！我请客！"
          }
        }
      }
    }
  ]
}
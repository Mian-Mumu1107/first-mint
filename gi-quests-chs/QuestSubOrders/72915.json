        "dialogs": {
          "729150101": {
            "id": "729150101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "和璃月的刀剑不尽相同呢。",
            "nextDialogs": [
              "729150102"
            ]
          },
          "729150102": {
            "id": "729150102",
            "speakerId": 3027,
            "speakerName": "天目十五",
            "text": "嗯，毕竟锻造手法、材料并不完全相同，锻出的武器也就风格各异了。",
            "nextDialogs": [
              "729150103"
            ]
          },
          "729150103": {
            "id": "729150103",
            "speakerId": 3027,
            "speakerName": "天目十五",
            "text": "听说璃月的神明，岩王帝君本人就是锻造武器的高手，我也曾十分好奇璃月的刀剑究竟是什么样子。",
            "nextDialogs": [
              "729150104"
            ]
          },
          "729150104": {
            "id": "729150104",
            "speakerId": 3027,
            "speakerName": "天目十五",
            "text": "所以我曾经委托南十字船队的人带来了一把璃月的武器，研究一番后受益匪浅。",
            "nextDialogs": [
              "729150105"
            ]
          },
          "729150105": {
            "id": "729150105",
            "speakerId": 3027,
            "speakerName": "天目十五",
            "text": "不过我现在已经对其中的工艺了如指掌了。看你和璃月也有些渊源，那这把武器不如就赠与你吧。"
          }
        }
      }
    }
  ]

  },
  "subQuests": [
    {
      "subId": "4020401",
      "subQuestName": "靠近争执的学者",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402040101"
        ],
        "dialogs": {
          "402040101": {
            "id": "402040101",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "阿塔希耶，我忍你很久了…你提交的这些东西，根本就没有能够用得上的！",
            "nextDialogs": [
              "402040102"
            ]
          },
          "402040102": {
            "id": "402040102",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "你看看你写的报告上都是什么东西…「可能」、「大概」、「差不多」，你就这样让我做数学模型？",
            "nextDialogs": [
              "402040103"
            ]
          },
          "402040103": {
            "id": "402040103",
            "speakerId": 30859,
            "speakerName": "阿塔希耶",
            "text": "这个、这个，成立课题的时间有限，更何况我是妙论派的，谁知道对生物产生的影响应该怎么测量…比如、比如蕈兽！",
            "nextDialogs": [
              "402040104"
            ]
          },
          "402040104": {
            "id": "402040104",
            "speakerId": 30859,
            "speakerName": "阿塔希耶",
            "text": "总、总不能我把手伸到蕈兽嘴巴前面让它们咬一口，然后记录下来说「咬合力确确实实很惊人」吧！",
            "nextDialogs": [
              "402040105"
            ]
          },
          "402040105": {
            "id": "402040105",
            "speakerId": 30859,
            "speakerName": "阿塔希耶",
            "text": "达尔维什，你才是那个生论派的，你来评评理！",
            "nextDialogs": [
              "402040106"
            ]
          },
          "402040106": {
            "id": "402040106",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "哈哈，如果要让我来评理，那我得说，阿塔希耶你的基础课程学得不太行，毕竟大家都知道大部分的蕈兽都没有嘴巴。",
            "nextDialogs": [
              "402040107"
            ]
          },
          "402040107": {
            "id": "402040107",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "哈！",
            "nextDialogs": [
              "402040108"
            ]
          },
          "402040108": {
            "id": "402040108",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "不过，法德瓦，我们这次也不需要这么严谨的数学模型，我们这次的课题面向的也不是院里的那些老学究…",
            "nextDialogs": [
              "402040109"
            ]
          },
          "402040109": {
            "id": "402040109",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "我们要做的是面向那些孩子的课题…嗯，得有趣才行啊，或许适当的想象也是必要的。",
            "nextDialogs": [
              "402040110"
            ]
          },
          "402040110": {
            "id": "402040110",
            "speakerId": 30858,
            "speakerName": "法德瓦",
            "text": "唔…唔，既然前辈你这么说了…",
            "nextDialogs": [
              "402040111"
            ]
          },
          "402040111": {
            "id": "402040111",
            "speakerId": 30859,
            "speakerName": "阿塔希耶",
            "text": "喂，法德瓦，你对待达尔维什的态度是不是和对我的态度差得有点太大了…",
            "nextDialogs": [
              "402040112"
            ]
          },
          "402040112": {
            "id": "402040112",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "好了好了，我这边的东西都负责的差不多了，阿塔希耶的结论我也经一遍手好了。",
            "nextDialogs": [
              "402040113"
            ]
          },
          "402040113": {
            "id": "402040113",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "而且，数据也可以在测试以后调整，这就是测试的意义嘛。",
            "nextDialogs": [
              "402040114"
            ]
          },
          "402040114": {
            "id": "402040114",
            "speakerId": 30858,
            "speakerName": "法德瓦",
            "text": "啊，不愧是达尔维什前辈…条理清晰，比某个人好太多了。",
            "nextDialogs": [
              "402040115"
            ]
          },
          "402040115": {
            "id": "402040115",
            "speakerId": 30859,
            "speakerName": "阿塔希耶",
            "text": "是是，我就不问你嘴里的「某个人」是谁了。",
            "nextDialogs": [
              "402040116"
            ]
          },
          "402040116": {
            "id": "402040116",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "好啦好啦，快去做最后的准备吧！",
            "nextDialogs": [
              "402040117"
            ]
          },
          "402040117": {
            "id": "402040117",
            "speakerId": 30858,
            "speakerName": "法德瓦",
            "text": "好、好的！前辈！",
            "nextDialogs": [
              "402040118"
            ]
          },
          "402040118": {
            "id": "402040118",
            "speakerId": 30859,
            "speakerName": "阿塔希耶",
            "text": "我也去看看画上的漆彩干了没…",
            "nextDialogs": [
              "402040119"
            ]
          },
          "402040119": {
            "id": "402040119",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "不过说到测试…测试的人员啊，那边的那两位，有没有兴趣。",
            "nextDialogs": [
              "402040120"
            ]
          },
          "402040120": {
            "id": "402040120",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "刚才站在那边看了半天了吧。",
            "nextDialogs": [
              "402040121"
            ]
          },
          "402040121": {
            "id": "402040121",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦，我们吗？",
            "nextDialogs": [
              "402040122"
            ]
          },
          "402040122": {
            "id": "402040122",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "对对，参与测试，还有大量新鲜水果吃哦，怎么样？",
            "nextDialogs": [
              "402040124",
              "402040126"
            ]
          },
          "402040124": {
            "id": "402040124",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "不是，嗯…让我想想应该从什么地方说起…",
            "nextDialogs": [
              "402040130"
            ]
          },
          "402040130": {
            "id": "402040130",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "不如这样，我不如先问两位一个问题吧…嗯，比如…「会滑铲的伸缩火蕈兽和长鬓虎打架谁厉害」？"
          },
          "402040126": {
            "id": "402040126",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别这么说嘛，听上去好像是什么路过的怪人一样！",
            "nextDialogs": [
              "402040127"
            ]
          },
          "402040127": {
            "id": "402040127",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不如我们先听听他想做的测试是什么样再决定嘛。我对新鲜水果…我对他们的研究课题有点好奇…",
            "nextDialogs": [
              "402040128"
            ]
          },
          "402040128": {
            "id": "402040128",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "哎呀，这位白色的小小女士有这样的好奇心，旅途中的运气肯定不会太差的。",
            "nextDialogs": [
              "402040129"
            ]
          },
          "402040129": {
            "id": "402040129",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "那就让我为两位解释一下这个课题…应该从什么地方说起呢…"
          }
        }
      }
    },
    {
      "subId": "4020402",
      "subQuestName": "与达尔维什对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "402040201"
        ],
        "dialogs": {
          "402040201": {
            "id": "402040201",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "哦，怎么样，要学习一下「伙伴冒险大战记」的规则吗？",
            "nextDialogs": [
              "402040202"
            ]
          },
          "402040202": {
            "id": "402040202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嗯，现在开始吧！",
            "nextDialogs": [
              "402040203"
            ]
          },
          "402040203": {
            "id": "402040203",
            "speakerId": 30857,
            "speakerName": "达尔维什",
            "text": "好，那么…就让我打开一下教学用的地图和棋盘…"
          }
        }
      }
    }
  ]
}
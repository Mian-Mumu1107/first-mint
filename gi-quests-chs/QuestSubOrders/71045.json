  },
  "subQuests": [
    {
      "subId": "7104501",
      "subQuestName": "与来到此地的志琼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710450101"
        ],
        "dialogs": {
          "710450101": {
            "id": "710450101",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "看见你没事真是太好了，那两个…怪物…是什么？我从没见过那样的人…或者生物…咳咳…",
            "nextDialogs": [
              "710450102"
            ]
          },
          "710450102": {
            "id": "710450102",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "好啦，好啦…别这么严肃，我不会招惹它们犯险的，我知道的。",
            "nextDialogs": [
              "710450103"
            ]
          },
          "710450103": {
            "id": "710450103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们是怎么走到我们前面去的？",
            "nextDialogs": [
              "710450104"
            ]
          },
          "710450104": {
            "id": "710450104",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "我们走了西边一条隐秘的矿道，正好可以绕过被污黑物质污染的区域和下面奇形怪状的怪物…咳咳…呜呃…",
            "nextDialogs": [
              "710450105"
            ]
          },
          "710450105": {
            "id": "710450105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…你还好吗？",
            "nextDialogs": [
              "710450106"
            ]
          },
          "710450106": {
            "id": "710450106",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "没事，没事的…那条路还挺难找的，可能是盗宝团挖掘的盗矿通道…但很难想象他们会出现在地下这么深的地方…",
            "nextDialogs": [
              "710450107"
            ]
          },
          "710450107": {
            "id": "710450107",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "好啦，营地就在不远处，我们边走边说吧？"
          }
        }
      }
    },
    {
      "subId": "7104502",
      "subQuestName": "与志琼一起前往营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710450201"
        ],
        "dialogs": {
          "710450201": {
            "id": "710450201",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "咳咳…你好，前辈。有什么事情吗？",
            "nextDialogs": [
              "710450202"
            ]
          },
          "710450202": {
            "id": "710450202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你在咳嗽呢！身体很不舒服吗？",
            "nextDialogs": [
              "710450203"
            ]
          },
          "710450203": {
            "id": "710450203",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "没事啦，没事…只是地下的空气比较稀薄，有点水土不服而已。",
            "nextDialogs": [
              "710450204"
            ]
          },
          "710450204": {
            "id": "710450204",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "对了，这是我之前绘制的地图…咳咳！咳…呼…好多了。",
            "nextDialogs": [
              "710450205"
            ]
          },
          "710450205": {
            "id": "710450205",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…你还是好好休息比较好，不要总勉强自己到处跑啦！",
            "nextDialogs": [
              "710450206"
            ]
          },
          "710450206": {
            "id": "710450206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说起地图，我们也有一张给你…",
            "nextDialogs": [
              "710450207"
            ]
          },
          "710450207": {
            "id": "710450207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是「怪怪两口钟」的地图…好像是愚人众的坏东西留下的呢！",
            "nextDialogs": [
              "710450208"
            ]
          },
          "710450208": {
            "id": "710450208",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "谢谢前辈！我这就把这片新区域临摹在我的地图里！",
            "nextDialogs": [
              "710450209"
            ]
          },
          "710450209": {
            "id": "710450209",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "唔，等等，你们之前说…愚人众？他们也深入这里了吗？",
            "nextDialogs": [
              "710450210"
            ]
          },
          "710450210": {
            "id": "710450210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "很有可能。",
            "nextDialogs": [
              "710450211"
            ]
          },
          "710450211": {
            "id": "710450211",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "看来大家在层岩巨渊的探索要更小心些了…",
            "nextDialogs": [
              "710450212"
            ]
          },
          "710450212": {
            "id": "710450212",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "说起来，我们捡到了这个…",
            "nextDialogs": [
              "710450213"
            ]
          },
          "710450213": {
            "id": "710450213",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "志琼你到处跑的地方比较多，应该能认出这东西是做什么用的吧？",
            "nextDialogs": [
              "710450214"
            ]
          },
          "710450214": {
            "id": "710450214",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "这个吗？我之前好像在更深处的地方见到过纹理相似的大门。",
            "nextDialogs": [
              "710450215"
            ]
          },
          "710450215": {
            "id": "710450215",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "咳咳…！咳…抱歉，那道门之后似乎有风声回响…里面一定有很大空间，等待着我们探索。",
            "nextDialogs": [
              "710450216"
            ]
          },
          "710450216": {
            "id": "710450216",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "这个东西或许与那道门有关？唔…说不定是类似钥匙之类的东西？咳咳…",
            "nextDialogs": [
              "710450217"
            ]
          },
          "710450217": {
            "id": "710450217",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "志琼说的对，这个是用来解除门锁的机关没错。",
            "nextDialogs": [
              "710450218"
            ]
          },
          "710450218": {
            "id": "710450218",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呜哇！吓我一跳！你从哪里冒出来的啦！",
            "nextDialogs": [
              "710450219"
            ]
          },
          "710450219": {
            "id": "710450219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "加入别人对话前请先打招呼！",
            "nextDialogs": [
              "710450220"
            ]
          },
          "710450220": {
            "id": "710450220",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "唔，抱歉…我只是想提醒你们，这枚奇特的机关造物的确是用来开启门锁机构的。",
            "nextDialogs": [
              "710450221"
            ]
          },
          "710450221": {
            "id": "710450221",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "我曾经也研究过类似的构装物，碰巧的是，你手中的这枚与我实验室中的那枚别无二致。",
            "nextDialogs": [
              "710450222"
            ]
          },
          "710450222": {
            "id": "710450222",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "唉…可惜的是，炼金学与基础机械学都很难解释其中蕴含的能量，以及解除闭锁机构所依赖的原理…",
            "nextDialogs": [
              "710450225"
            ]
          },
          "710450225": {
            "id": "710450225",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "阿弥利多学院的生论学者可不欢迎闭门造车的人，在很多项目上，我们还是不得不和悉般多摩的那些榆木脑袋合作…",
            "nextDialogs": [
              "710450226"
            ]
          },
          "710450226": {
            "id": "710450226",
            "speakerId": 2618,
            "speakerName": "海迪夫",
            "text": "唉…对你们这样的外人我只能说这么多啦，教令院的事情没什么好讲的。"
          }
        }
      }
    },
    {
      "subId": "7104503",
      "subQuestName": "与志琼交谈",
      "sceneId": null,
      "locations": [],

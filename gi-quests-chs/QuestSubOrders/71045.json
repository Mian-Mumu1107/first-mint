      }
    },
    {
      "subId": "7104504",
      "subQuestName": "前往志琼提到的大门处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710450401"
        ],
        "dialogs": {
          "710450401": {
            "id": "710450401",
            "speakerId": 20528,
            "speakerName": "怪异的石碑",
            "text": "（一座石碑，看材质比遗迹本身稍新一些，似乎是近年才立起来的。）",
            "nextDialogs": [
              "710450402"
            ]
          },
          "710450402": {
            "id": "710450402",
            "speakerId": 20528,
            "speakerName": "怪异的石碑",
            "text": "（尽管上面的铭文无法释读，但稍加观察，便不难判断出其上雕刻的是周边地域的地图。）",
            "nextDialogs": [
              "710450403"
            ]
          },
          "710450403": {
            "id": "710450403",
            "speakerId": 20528,
            "speakerName": "怪异的石碑",
            "text": "（石碑上还雕刻了些复杂的图案，似乎与你们前方悬浮的巨大晶石有关…）"
          }
        }
      }
    },
    {
      "subId": "7104521",
      "subQuestName": "与志琼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710450701"
        ],
        "dialogs": {
          "710450701": {
            "id": "710450701",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "#咳咳…咳…！{NICKNAME}前辈，你来了！咳咳…",
            "nextDialogs": [
              "710450704"
            ]
          },
          "710450704": {
            "id": "710450704",
            "speakerId": 20523,
            "speakerName": "志琼",
            "text": "咳咳…怎么了？好像前辈的脸色不太好？是我惹你生气了吗？",
            "nextDialogs": [
              "710450705"
            ]
          },
          "710450705": {
            "id": "710450705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…也不知道这里谁的脸色才不行呢。"
          }
        }
      }
    },
    {
      "subId": "7104522",
      "subQuestName": "打开大门",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7104528",
      "subQuestName": "前往大门内进行调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7104505",
      "subQuestName": "前往大门内进行调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710450501"
        ],
        "dialogs": {
          "710450501": {
            "id": "710450501",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "你们回来了，太好了！",
            "nextDialogs": [
              "710450502"
            ]
          },
          "710450502": {
            "id": "710450502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们回来啦！",
            "nextDialogs": [
              "710450503"
            ]
          },
          "710450503": {
            "id": "710450503",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "自从你们进入那道大门之后，发生了好几次地震…我们也不知道地下发生了什么，不过看到你们还活着真是太好了。",
            "nextDialogs": [
              "710450504"
            ]
          },
          "710450504": {
            "id": "710450504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你也精神了许多嘛！看起来休息果然还是有用的！",
            "nextDialogs": [
              "710450505"
            ]
          },
          "710450505": {
            "id": "710450505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你这边情况如何？",
            "nextDialogs": [
              "710450506"
            ]
          },
          "710450506": {
            "id": "710450506",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "我听了前辈你的话，一直在这里休养。现在已经好多了…是因为大门后的「东西」吗？",
            "nextDialogs": [
              "710450507"
            ]
          },
          "710450507": {
            "id": "710450507",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "虽然并没有进入那扇大门，但我能感觉到门内奇异的搏动…那里一定存在着不得了的东西…",
            "nextDialogs": [
              "710450508"
            ]
          },
          "710450508": {
            "id": "710450508",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "咳咳…我从小听着夜叉的故事长大，长辈们说，「仙众夜叉」之一就被封在了层岩巨渊之底，沉睡至今…",
            "nextDialogs": [
              "710450510",
              "710450512"
            ]
          },
          "710450510": {
            "id": "710450510",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "这样啊…谢谢你，前辈。那么那些污黑的物质…咳咳…抱歉…"
          },
          "710450512": {
            "id": "710450512",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "这么说…上层的那块晶石果然是向着它飞去了——一块渴求重聚的碎片。",
            "nextDialogs": [
              "710450513"
            ]
          },
          "710450513": {
            "id": "710450513",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "那块晶石应该就是解开层岩巨渊之谜的关键…我之后或许还会亲身去考察看看的。",
            "nextDialogs": [
              "710450514"
            ]
          },
          "710450514": {
            "id": "710450514",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "咳咳…谢谢你，前辈。那么那些污黑的物质…咳咳…抱歉…"
          }
        }
      }
    },
    {
      "subId": "7104507",
      "subQuestName": "前往大门内进行调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710450325"
        ],
        "dialogs": {
          "710450325": {
            "id": "710450325",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个空间…看起来不像是天然的岩洞，反而像是被什么大东西开凿过…哼，比起「开凿」，不如说「横冲直撞」更贴切呢…",
            "nextDialogs": [
              "710450301"
            ]
          },
          "710450301": {
            "id": "710450301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#那个…{NICKNAME}，你有没有觉得那个空中飘着的大东西好眼熟…？和我们在龙脊雪山上面见到过的那个大家伙…很像呢。",
            "nextDialogs": [
              "710450302"
            ]
          },
          "710450302": {
            "id": "710450302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且它们的…「气味」…或者说「气氛」…？很相似呢…",
            "nextDialogs": [
              "710450303"
            ]
          },
          "710450303": {
            "id": "710450303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这个大家伙，真是邪门…",
            "nextDialogs": [
              "710450304"
            ]
          },
          "710450304": {
            "id": "710450304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "派蒙察觉到什么了吗？",
            "nextDialogs": [
              "710450305"
            ]
          },
          "710450305": {
            "id": "710450305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…总之非常邪门呢…",
            "nextDialogs": [
              "710450306"
            ]
          },
          "710450306": {
            "id": "710450306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那边那座石碑看起来稍微新了一点…和周边的遗迹感觉不太一样呢！",
            "nextDialogs": [
              "710450307"
            ]
          },
          "710450307": {
            "id": "710450307",
            "speakerId": 20528,
            "speakerName": "怪异的石碑",
            "text": "（尽管上面的铭文无法释读，但稍加观察，便不难判断出其上雕刻的是周边地域的地图，而其他图案似乎与悬浮晶石有关…）",
            "nextDialogs": [
              "710450308"
            ]
          },
          "710450308": {
            "id": "710450308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "大晶石周围有五个奇怪的机关…还有几条线和大晶石连起来…唔…看不懂啦，怎么画得这么潦草的！",
            "nextDialogs": [
              "710450309"
            ]
          },
          "710450309": {
            "id": "710450309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看起来,我们要先触动五个机关…",
            "nextDialogs": [
              "710450310"
            ]
          },
          "710450310": {
            "id": "710450310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "然后…唔，人会上去冲撞大晶石…？上面黑色的斑点就不见了…",
            "nextDialogs": [
              "710450313"
            ]
          },
          "710450313": {
            "id": "710450313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "然后…看不明白…为什么还画着一条大虫子呢？好像…石碑在让我们小心那条特别巨大的虫子呢！"
          }
        }
      }
    },
    {
      "subId": "7104519",
      "subQuestName": "阅读石碑",

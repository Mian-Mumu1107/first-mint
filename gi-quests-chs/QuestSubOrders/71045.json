    {
      "subId": "7104520",
      "subQuestName": "向沐宁回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710450801"
        ],
        "dialogs": {
          "710450801": {
            "id": "710450801",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "#你回来了，{NICKNAME}！怎么样，下面有什么好消息吗？",
            "nextDialogs": [
              "710450802"
            ]
          },
          "710450802": {
            "id": "710450802",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "你们向沐宁具言了所见所闻…",
            "nextDialogs": [
              "710450803"
            ]
          },
          "710450803": {
            "id": "710450803",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "哈哈，瞧瞧我之前说什么来着！我就说勘探队全都是靠谱的好兄弟，探索一定会大获成功的！",
            "nextDialogs": [
              "710450804"
            ]
          },
          "710450804": {
            "id": "710450804",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "海迪夫和瑾武姐收集的矿石样本和测算数据我们都已经收到了，不明物质增生呈减缓趋势，地质构造也大多停止了变化…",
            "nextDialogs": [
              "710450805"
            ]
          },
          "710450805": {
            "id": "710450805",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "…这是个好兆头。多亏了你们的功劳，千岩军方面也对进一步的勘探和修复计划并无异议。现在他们已经准备好深入矿井了。",
            "nextDialogs": [
              "710450808"
            ]
          },
          "710450808": {
            "id": "710450808",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，对呀…之前是谁千方百计阻止我们下矿的呀？",
            "nextDialogs": [
              "710450809"
            ]
          },
          "710450809": {
            "id": "710450809",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "唔…嘿嘿…不要这么不给面子嘛。",
            "nextDialogs": [
              "710450810"
            ]
          },
          "710450810": {
            "id": "710450810",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "首先，应得的报酬我会给你们批下来的。然后呢，层岩巨渊勘探队从此以后就是辉山厅的正式编制队伍啦！",
            "nextDialogs": [
              "710450811"
            ]
          },
          "710450811": {
            "id": "710450811",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "转移话题的技巧真是差劲…",
            "nextDialogs": [
              "710450812"
            ]
          },
          "710450812": {
            "id": "710450812",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼…但既然有报酬可拿，就姑且原谅你啦！",
            "nextDialogs": [
              "710450813"
            ]
          },
          "710450813": {
            "id": "710450813",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "哈哈，感谢两位给我面子…之前因为没打招呼就私自放你们下去，我还被上面一顿好训…",
            "nextDialogs": [
              "710450814"
            ]
          },
          "710450814": {
            "id": "710450814",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "上面…？谁？",
            "nextDialogs": [
              "710450815"
            ]
          },
          "710450815": {
            "id": "710450815",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对呀！谁会亲自到这里来专门训你呀？",
            "nextDialogs": [
              "710450816"
            ]
          },
          "710450816": {
            "id": "710450816",
            "speakerId": 2061,
            "speakerName": "沐宁",
            "text": "说来你可能不信…是「玉衡」大人，她很在乎你们的安全。",
            "nextDialogs": [
              "710450817"
            ]
          },
          "710450817": {
            "id": "710450817",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "什么嘛…刻晴她原来一直盯着我们吗？",
            "nextDialogs": [
              "710450818"
            ]
          },
          "710450818": {
            "id": "710450818",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…不对，我们在下面偶然见到的那个人影，明显不像是她呀！"
          }
        }
      }
    },

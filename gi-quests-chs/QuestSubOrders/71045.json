    {
      "subId": "7104511",
      "subQuestName": "净化大晶石$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710451101"
        ],
        "dialogs": {
          "710451101": {
            "id": "710451101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#嗯…接下来，就是「用外力冲击晶石」的环节了。{NICKNAME}，你准备好了吗？",
            "nextDialogs": [
              "710451104"
            ]
          },
          "710451104": {
            "id": "710451104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "既然都已经做到这里啦，我们就像往常一样试一试吧？"
          }
        }
      }

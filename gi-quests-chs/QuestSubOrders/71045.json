    {
      "subId": "7104525",
      "subQuestName": "击打净化后的大晶石",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710452501"
        ],
        "dialogs": {
          "710452501": {
            "id": "710452501",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "你们回来了，太好了！",
            "nextDialogs": [
              "710452502"
            ]
          },
          "710452502": {
            "id": "710452502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们回来啦！",
            "nextDialogs": [
              "710452503"
            ]
          },
          "710452503": {
            "id": "710452503",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "自从你们进入那道大门之后，发生了好几次地震…我们也不知道地下发生了什么，不过看到你们还活着真是太好了。",
            "nextDialogs": [
              "710452504"
            ]
          },
          "710452504": {
            "id": "710452504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你也精神了许多嘛！看起来休息果然还是有用的！",
            "nextDialogs": [
              "710452505"
            ]
          },
          "710452505": {
            "id": "710452505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你这边情况如何？",
            "nextDialogs": [
              "710452506"
            ]
          },
          "710452506": {
            "id": "710452506",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "我听了前辈你的话，一直在这里休养。现在已经好多了…是因为大门后的「东西」吗？",
            "nextDialogs": [
              "710452507"
            ]
          },
          "710452507": {
            "id": "710452507",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "虽然并没有进入那扇大门，但我能感觉到门内奇异的搏动…那里一定存在着不得了的东西…",
            "nextDialogs": [
              "710452508"
            ]
          },
          "710452508": {
            "id": "710452508",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "咳咳…我从小听着夜叉的故事长大，长辈们说，「仙众夜叉」之一就被封在了层岩巨渊之底，沉睡至今…",
            "nextDialogs": [
              "710452510",
              "710452513"
            ]
          },
          "710452510": {
            "id": "710452510",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "这样啊…谢谢你，前辈。那么那些污黑的物质…咳咳…抱歉…"
          },
          "710452513": {
            "id": "710452513",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "那块晶石应该就是解开层岩巨渊之谜的关键…我之后或许还会亲身去考察看看的。",
            "nextDialogs": [
              "710452514"
            ]
          },
          "710452514": {
            "id": "710452514",
            "speakerId": 20006,
            "speakerName": "志琼",
            "text": "咳咳…谢谢你，前辈。那么那些污黑的物质…咳咳…抱歉…"
          }
        }
      }
    },

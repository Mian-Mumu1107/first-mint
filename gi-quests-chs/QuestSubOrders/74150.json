  },
  "subQuests": [
    {
      "subId": "7415004",
      "subQuestName": "(test)时间经过一天$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741500401"
        ],
        "dialogs": {
          "741500401": {
            "id": "741500401",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "娜娜，娜娜，吃不吃鱼肉呀？"
          }
        }
      }
    },
    {
      "subId": "7415001",
      "subQuestName": "与伯努瓦对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741500101"
        ],
        "dialogs": {
          "741500101": {
            "id": "741500101",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "谢谢你，茉莉。你漂亮的紫眼睛正因为你的善心闪光。",
            "nextDialogs": [
              "741500102"
            ]
          },
          "741500102": {
            "id": "741500102",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "嘿嘿，真的吗？勒鲁瓦先生真的喜欢我上次带给你的娃娃？",
            "nextDialogs": [
              "741500103"
            ]
          },
          "741500103": {
            "id": "741500103",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "哦，非常喜欢，它很可爱。我还特意为它在餐桌上腾出了一个位置。",
            "nextDialogs": [
              "741500104"
            ]
          },
          "741500104": {
            "id": "741500104",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "那它肯定会开心的！那今天呢？需要我扶您散步吗，或者是取报纸？",
            "nextDialogs": [
              "741500105"
            ]
          },
          "741500105": {
            "id": "741500105",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "我还可以为您读报，如果您看不大清的话。",
            "nextDialogs": [
              "741500106"
            ]
          },
          "741500106": {
            "id": "741500106",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "妈妈说我每天都应该做一件好事，家庭教师小姐要求我这周交上一篇关于好人好事的作文。",
            "nextDialogs": [
              "741500107"
            ]
          },
          "741500107": {
            "id": "741500107",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "啊，我不是说我想帮助您是因为作文，但可以的话，我希望能帮上您的忙。",
            "nextDialogs": [
              "741500108"
            ]
          },
          "741500108": {
            "id": "741500108",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "哈哈，不需要。你对我最大的帮助就是告诉你的父母，你经常到我这里来玩。",
            "nextDialogs": [
              "741500109"
            ]
          },
          "741500109": {
            "id": "741500109",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "嗯，勒鲁瓦先生，我跟爸爸妈妈说过的，虽然他们好像不太开心…",
            "nextDialogs": [
              "741500110"
            ]
          },
          "741500110": {
            "id": "741500110",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "那你还会来吗？",
            "nextDialogs": [
              "741500111"
            ]
          },
          "741500111": {
            "id": "741500111",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "会的，就算爸爸妈妈不让我来，我也还是会来的。我们都约好了嘛。",
            "nextDialogs": [
              "741500112"
            ]
          },
          "741500112": {
            "id": "741500112",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "你是遵守约定的好孩子，茉莉，勒鲁瓦爷爷很喜欢你。",
            "nextDialogs": [
              "741500113"
            ]
          },
          "741500113": {
            "id": "741500113",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "两位热心的小客人，欢迎你们来。",
            "nextDialogs": [
              "741500114"
            ]
          },
          "741500114": {
            "id": "741500114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "…咳咳，我们刚才是不想打扰你们说话啦。",
            "nextDialogs": [
              "741500115"
            ]
          },
          "741500115": {
            "id": "741500115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "打扰到你们了吗？",
            "nextDialogs": [
              "741500116"
            ]
          },
          "741500116": {
            "id": "741500116",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "没关系，没关系，你们没有打扰到任何事情。",
            "nextDialogs": [
              "741500117"
            ]
          },
          "741500117": {
            "id": "741500117",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "我的年轻朋友茉莉正在为她的家庭作业四处奔波，正好晃悠到了我家门口。",
            "nextDialogs": [
              "741500118"
            ]
          },
          "741500118": {
            "id": "741500118",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "她希望我能帮她一点忙，让她做一点好事，这样她好写作文。",
            "nextDialogs": [
              "741500119"
            ]
          },
          "741500119": {
            "id": "741500119",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "我不是为了家庭作业才要做好人好事的，至少不只是为了家庭作业…",
            "nextDialogs": [
              "741500120"
            ]
          },
          "741500120": {
            "id": "741500120",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "没错，我相信你是个好孩子，你当然不是为了家庭作业才发善心的。",
            "nextDialogs": [
              "741500121"
            ]
          },
          "741500121": {
            "id": "741500121",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "就像这两位年轻的客人，他们也不是因为需要工作才来我这里拜访的。",
            "nextDialogs": [
              "741500122"
            ]
          },
          "741500122": {
            "id": "741500122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "741500123"
            ]
          },
          "741500123": {
            "id": "741500123",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那个…我们…",
            "nextDialogs": [
              "741500124"
            ]
          },
          "741500124": {
            "id": "741500124",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "别在意，一点小调侃，你们不会跟我这个老头子生气吧？",
            "nextDialogs": [
              "741500125"
            ]
          },
          "741500125": {
            "id": "741500125",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "年轻人们总是有很多时间可以挥霍，既然你们愿意到我这里来挥霍时间，我又喜欢有年轻人陪着，何乐而不为呢？",
            "nextDialogs": [
              "741500126"
            ]
          },
          "741500126": {
            "id": "741500126",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "我给你们点事做好了，这附近人来人往，家门口的灰尘堆积得很快，屋后也有几天没扫了，再麻烦你们帮我清理一下吧。",
            "nextDialogs": [
              "741500127"
            ]
          },
          "741500127": {
            "id": "741500127",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…好。",
            "nextDialogs": [
              "741500128"
            ]
          },
          "741500128": {
            "id": "741500128",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "茉莉，你愿意和我的猫玩一会儿吗？顺便再喂它一块鱼肉，就当是陪陪它，对了，它叫娜娜。",
            "nextDialogs": [
              "741500129"
            ]
          },
          "741500129": {
            "id": "741500129",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "它继承了我养过的一条狗的名字，可惜，我以前的女儿远嫁时带走了那条狗。",
            "nextDialogs": [
              "741500130"
            ]
          },
          "741500130": {
            "id": "741500130",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "好的，勒鲁瓦先生。",
            "nextDialogs": [
              "741500131"
            ]
          },
          "741500131": {
            "id": "741500131",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "去忙你们的吧，孩子们。"
          }
        }
      }
    },
    {
      "subId": "7415006",
      "subQuestName": "清理门口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741500601"
        ],
        "dialogs": {
          "741500601": {
            "id": "741500601",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "孩子们不在家，清扫门口和屋后的污迹这种事就变麻烦了，只能拜托你了。"
          }
        }
      }
    },
    {
      "subId": "7415007",
      "subQuestName": "清理门口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741500701"
        ],
        "dialogs": {
          "741500701": {
            "id": "741500701",
            "speakerId": 21255,
            "speakerName": "奇怪的箱子",
            "text": "（蒙上了厚厚灰尘的沉重箱子，又旧又破，被突兀地堆放在这里几乎破坏了明亮干净的枫丹廷街景。）",
            "nextDialogs": [
              "741500702"
            ]
          },
          "741500702": {
            "id": "741500702",
            "speakerId": 21255,
            "speakerName": "奇怪的箱子",
            "text": "（箱子底部有明显的陈年水渍，似乎曾经被堆放在极度潮湿的地方。）",
            "nextDialogs": [
              "741500703"
            ]
          },
          "741500703": {
            "id": "741500703",
            "speakerId": 21255,
            "speakerName": "奇怪的箱子",
            "text": "（比起门口的污迹，这个脏兮兮的箱子似乎更应该被清理掉。)"
          }
        }
      }
    },
    {
      "subId": "7415002",
      "subQuestName": "清理门口",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7415008",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741500801"
        ],
        "dialogs": {
          "741500801": {
            "id": "741500801",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "哦，你现在敲门是不会有回应的，莫蒂西娅和阿托斯不在家。",
            "nextDialogs": [
              "741500802"
            ]
          },
          "741500802": {
            "id": "741500802",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "本来说好今天回来的，可能有什么事情耽搁了吧。",
            "nextDialogs": [
              "741500803"
            ]
          },
          "741500803": {
            "id": "741500803",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "大孩子就是这点不讨喜，他们总有自己的事情，你需要他们的时候经常找不见人。"
          }
        }
      }
    },
    {
      "subId": "7415003",
      "subQuestName": "向伯努瓦回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741500301"
        ],
        "dialogs": {
          "741500301": {
            "id": "741500301",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "你们忙完了？",
            "nextDialogs": [
              "741500302"
            ]
          },
          "741500302": {
            "id": "741500302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是的。",
            "nextDialogs": [
              "741500303"
            ]
          },
          "741500303": {
            "id": "741500303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们都清理干净啦，小茉莉也喂过了猫。",
            "nextDialogs": [
              "741500304"
            ]
          },
          "741500304": {
            "id": "741500304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "伯努瓦，屋子旁边有一堆很脏的旧箱子，那些也要一起清理掉吗？",
            "nextDialogs": [
              "741500305"
            ]
          },
          "741500305": {
            "id": "741500305",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "箱子？哦，那些不用，那是我用来放旧物件的杂物箱。",
            "nextDialogs": [
              "741500306"
            ]
          },
          "741500306": {
            "id": "741500306",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "有些我搬到这里来之前的家具和小物件，我舍不得丢，放在屋子里又和室内装饰风格不搭，就堆在这里了。",
            "nextDialogs": [
              "741500307"
            ]
          },
          "741500307": {
            "id": "741500307",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "我几乎不会动它们，住在这里的也都是体面人，没人会偷拿的，就让它们呆在这里吧。",
            "nextDialogs": [
              "741500308"
            ]
          },
          "741500308": {
            "id": "741500308",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "勒鲁瓦先生，勒鲁瓦先生，我帮上忙了吗？",
            "nextDialogs": [
              "741500309"
            ]
          },
          "741500309": {
            "id": "741500309",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "你当然帮上我的大忙了，茉莉。别忘了回去代我向你父母问好，我会更感谢你的。",
            "nextDialogs": [
              "741500310"
            ]
          },
          "741500310": {
            "id": "741500310",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "点心和零花钱我都准备好了，孩子们，过来分吧。",
            "nextDialogs": [
              "741500311"
            ]
          },
          "741500311": {
            "id": "741500311",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "不用不用，我不需要零花钱，我只想再摸娜娜一会儿，可以吗？",
            "nextDialogs": [
              "741500312"
            ]
          },
          "741500312": {
            "id": "741500312",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "可以，去吧。小心它的爪子，记得玩够了就过来吃点心。",
            "nextDialogs": [
              "741500313"
            ]
          },
          "741500313": {
            "id": "741500313",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "爸爸，您怎么出门了？",
            "nextDialogs": [
              "741500314"
            ]
          },
          "741500314": {
            "id": "741500314",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "我的孩子们不在家里陪伴我，孤老头子寂寞了，出门呼吸一下新鲜空气。",
            "nextDialogs": [
              "741500315"
            ]
          },
          "741500315": {
            "id": "741500315",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "莫蒂西娅，你看，我们才走了几天，爸爸就不高兴了。",
            "nextDialogs": [
              "741500316"
            ]
          },
          "741500316": {
            "id": "741500316",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "但要是爸爸知道，我们这次给他带了什么礼物回来，他一定会原谅我们的，对吧？",
            "nextDialogs": [
              "741500317"
            ]
          },
          "741500317": {
            "id": "741500317",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "……",
            "nextDialogs": [
              "741500318"
            ]
          },
          "741500318": {
            "id": "741500318",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "礼物？你们带了什么回来？",
            "nextDialogs": [
              "741500319"
            ]
          },
          "741500319": {
            "id": "741500319",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "绝对是好东西，爸爸，你看了就知道了。莫蒂西娅知道你喜欢又贵又漂亮的，她特意给你挑的。",
            "nextDialogs": [
              "741500320"
            ]
          },
          "741500320": {
            "id": "741500320",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "谢谢你，我的女儿。",
            "nextDialogs": [
              "741500321"
            ]
          },
          "741500321": {
            "id": "741500321",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "这是我应该做的。",
            "nextDialogs": [
              "741500322"
            ]
          },
          "741500322": {
            "id": "741500322",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "啊对了，这两位小客人是你们出远门的时候，到我这里玩的孩子。",
            "nextDialogs": [
              "741500323"
            ]
          },
          "741500323": {
            "id": "741500323",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "你们好。我父亲是个和善的人，非常喜欢孩子，你们愿意来陪伴他真是太好了。",
            "nextDialogs": [
              "741500324"
            ]
          },
          "741500324": {
            "id": "741500324",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "不过现在我和太太已经回来了，该由我们两个接替你们的工作陪伴他了。",
            "nextDialogs": [
              "741500325"
            ]
          },
          "741500325": {
            "id": "741500325",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "你们回来了就好，快让我看看礼物。",
            "nextDialogs": [
              "741500326"
            ]
          },
          "741500326": {
            "id": "741500326",
            "speakerId": 21251,
            "speakerName": "莫蒂西娅",
            "text": "爸爸，我们回家吧。",
            "nextDialogs": [
              "741500327"
            ]
          },
          "741500327": {
            "id": "741500327",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "好，阿托斯，你记得给这两个年轻人一些点心和报酬，他们帮我扫了地，还喂了娜娜。",
            "nextDialogs": [
              "741500328"
            ]
          },
          "741500328": {
            "id": "741500328",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "哦，还有旁边那个小姑娘，也给她一些点心吧。我先进门了。",
            "nextDialogs": [
              "741500329"
            ]
          },
          "741500329": {
            "id": "741500329",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "勒鲁瓦先生，娜娜给我摸肚皮啦…欸，他不在？",
            "nextDialogs": [
              "741500330"
            ]
          },
          "741500330": {
            "id": "741500330",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "你在找我的父亲吗，小姑娘？我是他的女婿，你理解成他的儿子就好，我叫阿托斯。",
            "nextDialogs": [
              "741500331"
            ]
          },
          "741500331": {
            "id": "741500331",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "我知道女婿是什么意思，意思就是你是他女儿的丈夫。",
            "nextDialogs": [
              "741500332"
            ]
          },
          "741500332": {
            "id": "741500332",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "哈哈，你懂的真多。我父亲先回家了，谢谢你陪他。",
            "nextDialogs": [
              "741500333"
            ]
          },
          "741500333": {
            "id": "741500333",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "这些点心给你，接下来有我和我太太来陪他，你不来也没有关系的。",
            "nextDialogs": [
              "741500334"
            ]
          },
          "741500334": {
            "id": "741500334",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "早点回家吧，在外面玩这么久，你的家人该担心了。",
            "nextDialogs": [
              "741500335"
            ]
          },
          "741500335": {
            "id": "741500335",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "不不，叔叔，我一点都不觉得麻烦，而且我和勒鲁瓦先生约好了的。",
            "nextDialogs": [
              "741500336"
            ]
          },
          "741500336": {
            "id": "741500336",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "我想他还会需要我的帮助，喂猫啊浇树啊之类的，能帮上忙我很开心！以后我还会来的。",
            "nextDialogs": [
              "741500337"
            ]
          },
          "741500337": {
            "id": "741500337",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "……",
            "nextDialogs": [
              "741500338"
            ]
          },
          "741500338": {
            "id": "741500338",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "啧，就是这样才麻烦。",
            "nextDialogs": [
              "741500339"
            ]
          },
          "741500339": {
            "id": "741500339",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "嗯，叔叔怎么了吗？",
            "nextDialogs": [
              "741500340"
            ]
          },
          "741500340": {
            "id": "741500340",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "没什么，小姑娘，叔叔有件事要和你商量。不，不是商量，有件事要请你做到。",
            "nextDialogs": [
              "741500341"
            ]
          },
          "741500341": {
            "id": "741500341",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "好啊，叔叔有什么事？",
            "nextDialogs": [
              "741500342"
            ]
          },
          "741500342": {
            "id": "741500342",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "叔叔把点心和零花钱给你，你以后不要再过来了好不好。",
            "nextDialogs": [
              "741500343"
            ]
          },
          "741500343": {
            "id": "741500343",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "为什么呢？我做错什么了吗？",
            "nextDialogs": [
              "741500344"
            ]
          },
          "741500344": {
            "id": "741500344",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "不，你什么都没有做错。只是我父亲他身体一直都不是很好，最近的失眠问题也很严重。",
            "nextDialogs": [
              "741500345"
            ]
          },
          "741500345": {
            "id": "741500345",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "为了他的身体健康考虑，我和我太太希望他能拥有一个安静的休养环境。你会理解的，对吧？",
            "nextDialogs": [
              "741500346"
            ]
          },
          "741500346": {
            "id": "741500346",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "勒鲁瓦先生身体不好啊…我明白了，以后我多带些泡泡桔过来给他吧。",
            "nextDialogs": [
              "741500347"
            ]
          },
          "741500347": {
            "id": "741500347",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "每次我吃太多蛋糕，吃坏了肚子，爸爸都会教育我，让我少吃甜食，多吃水果。",
            "nextDialogs": [
              "741500348"
            ]
          },
          "741500348": {
            "id": "741500348",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "只要勒鲁瓦先生多吃水果，他一定就会好的。",
            "nextDialogs": [
              "741500349"
            ]
          },
          "741500349": {
            "id": "741500349",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "…唉，算了，只能这样了。",
            "nextDialogs": [
              "741500350"
            ]
          },
          "741500350": {
            "id": "741500350",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "两位年轻的朋友，你们点心和报酬我来给。",
            "nextDialogs": [
              "741500351"
            ]
          },
          "741500351": {
            "id": "741500351",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "接下来，我把话说清楚点吧。",
            "nextDialogs": [
              "741500352"
            ]
          },
          "741500352": {
            "id": "741500352",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "我的态度代表了勒鲁瓦家的态度，我希望你们以后不要再过来打扰我们的生活。",
            "nextDialogs": [
              "741500353"
            ]
          },
          "741500353": {
            "id": "741500353",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "我相信你们虽然年轻，但是听得懂话，所以请你们不要特意再来。",
            "nextDialogs": [
              "741500354"
            ]
          },
          "741500354": {
            "id": "741500354",
            "speakerId": 21250,
            "speakerName": "阿托斯",
            "text": "就这样，我先告辞了。",
            "nextDialogs": [
              "741500355"
            ]
          },
          "741500355": {
            "id": "741500355",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "为什么不能再来啊？好奇怪，勒鲁瓦先生明明脾气很好，这个叔叔怎么偏不让我们来。",
            "nextDialogs": [
              "741500356"
            ]
          },
          "741500356": {
            "id": "741500356",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是哦，这个家伙说话挺礼貌，但做的事情真是够冷漠的。",
            "nextDialogs": [
              "741500357"
            ]
          },
          "741500357": {
            "id": "741500357",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "不管这个叔叔说什么，我过一天还是要来看勒鲁瓦先生的，你们来吗？",
            "nextDialogs": [
              "741500358"
            ]
          },
          "741500358": {
            "id": "741500358",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "来吧来吧，娜娜很可爱，我还想多摸摸它，而且勒鲁瓦先生会给点心呢。",
            "nextDialogs": [
              "741500360",
              "741500362"
            ]
          },
          "741500360": {
            "id": "741500360",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "说好了哦，要一起过来摸猫猫，找勒鲁瓦先生玩。"
          },
          "741500362": {
            "id": "741500362",
            "speakerId": 21252,
            "speakerName": "茉莉",
            "text": "好吧，那下次再见哦。"
          }
        }
      }
    },
    {
      "subId": "7414906",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741490601"
        ],
        "dialogs": {
          "741490601": {
            "id": "741490601",
            "speakerId": 21249,
            "speakerName": "伯努瓦·勒鲁瓦",
            "text": "送报纸的吗？放门口吧，我晚点取。",
            "nextDialogs": [
              "741490602"
            ]
          },
          "741490602": {
            "id": "741490602",
            "speakerId": 1006,
            "speakerName": "门",
            "text": "（今天已经帮过伯努瓦的忙了，屡次打扰别人休息似乎不太礼貌。既然已经和他约定了明天再见，就等到约定的时间再来吧。）"
          }
        }
      }
    }
  ]
}
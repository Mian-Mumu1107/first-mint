    {
      "subId": "7280407",
      "subQuestName": "与朝仓对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728040406"
        ],
        "dialogs": {
          "728040406": {
            "id": "728040406",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "阁下，看你气息平稳，那些海乱鬼对你而言，果然不算什么。",
            "nextDialogs": [
              "728040407"
            ]
          },
          "728040407": {
            "id": "728040407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看起来你也赢了。",
            "nextDialogs": [
              "728040408"
            ]
          },
          "728040408": {
            "id": "728040408",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "没错，但是很惭愧…最后那家伙居然虚晃一招，拼着被我刺了一枪后逃跑了。",
            "nextDialogs": [
              "728040409"
            ]
          },
          "728040409": {
            "id": "728040409",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "但是他伤得很重，我想，几年内他应该不可能再出来作乱了。",
            "nextDialogs": [
              "728040410"
            ]
          },
          "728040410": {
            "id": "728040410",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "最主要的是，我亲手击败了他，也夺回了武器，彻底洗刷了耻辱。",
            "nextDialogs": [
              "728040411"
            ]
          },
          "728040411": {
            "id": "728040411",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "恭喜你，朝仓。",
            "nextDialogs": [
              "728040412"
            ]
          },
          "728040412": {
            "id": "728040412",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "实在感谢，但我还不能松懈！",
            "nextDialogs": [
              "728040413"
            ]
          },
          "728040413": {
            "id": "728040413",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "这一切的起因，都是我的武艺还不够精湛，以后我会继续加倍刻苦修炼，精进武艺的。",
            "nextDialogs": [
              "728040414"
            ]
          },
          "728040414": {
            "id": "728040414",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "所以…还请阁下多多关照，常来和我对练了！",
            "nextDialogs": [
              "728040415"
            ]
          },
          "728040415": {
            "id": "728040415",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "哦，对了，这些东西还请阁下收下。虽然不算太多…但也是我的一份心意。",
            "nextDialogs": [
              "728040416"
            ]
          },
          "728040416": {
            "id": "728040416",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "再次谢谢您，阁下！"
          }
        }
      }
    },
    {
      "subId": "7280499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728049903"
        ],
        "dialogs": {
          "728049903": {
            "id": "728049903",
            "speakerId": 20331,
            "speakerName": "「海乱鬼」",
            "text": "又是你？上次捡回一条命，居然还敢找过来？",
            "nextDialogs": [
              "728049904"
            ]
          },
          "728049904": {
            "id": "728049904",
            "speakerId": 20331,
            "speakerName": "「海乱鬼」",
            "text": "还带了个帮手…哼，既然你不知好歹，那就别怪兄弟们下手黑了！",
            "nextDialogs": [
              "728049905"
            ]
          },
          "728049905": {
            "id": "728049905",
            "speakerId": 20331,
            "speakerName": "「海乱鬼」",
            "text": "一起上！放倒他们！",
            "nextDialogs": [
              "728049906"
            ]
          },
          "728049906": {
            "id": "728049906",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "朝仓去和那家伙一对一了，我们赶快打倒这些家伙！",
            "nextDialogs": [
              "728049907"
            ]
          },
          "728049907": {
            "id": "728049907",
            "speakerId": 20332,
            "speakerName": "「海乱鬼」头领",
            "text": "都说同心的武器就是他们的尊严，你早就输给了我，还有什么脸面来和我对决！",
            "nextDialogs": [
              "728049908"
            ]
          },
          "728049908": {
            "id": "728049908",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "正是因为上次输给了你…我这次才特意过来，亲手洗刷耻辱！",
            "nextDialogs": [
              "728049909"
            ]
          },
          "728049909": {
            "id": "728049909",
            "speakerId": 20332,
            "speakerName": "「海乱鬼」头领",
            "text": "真是不知天高地厚…这次你可没人来帮忙了！",
            "nextDialogs": [
              "728049910"
            ]
          },
          "728049910": {
            "id": "728049910",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "我也不需要人帮，我自己，就能斩了你！",
            "nextDialogs": [
              "728049911"
            ]
          },
          "728049911": {
            "id": "728049911",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看！朝仓在那里！",
            "nextDialogs": [
              "728049912"
            ]
          },

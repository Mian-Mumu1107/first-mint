  },
  "subQuests": [
    {
      "subId": "7280401",
      "subQuestName": "与朝仓对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728040101"
        ],
        "dialogs": {
          "728040101": {
            "id": "728040101",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "阁下，正巧您来了，今天是至关重要的一天！",
            "nextDialogs": [
              "728040102"
            ]
          },
          "728040102": {
            "id": "728040102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "难道和你的武器有关…",
            "nextDialogs": [
              "728040103"
            ]
          },
          "728040103": {
            "id": "728040103",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "正是！这段时间我四处搜集线索，总算确定了那一队海乱鬼的位置！",
            "nextDialogs": [
              "728040104"
            ]
          },
          "728040104": {
            "id": "728040104",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "今天我就要洗刷耻辱，夺回我的武器！",
            "nextDialogs": [
              "728040105"
            ]
          },
          "728040105": {
            "id": "728040105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦！朝仓很有干劲呢！",
            "nextDialogs": [
              "728040106"
            ]
          },
          "728040106": {
            "id": "728040106",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "不过我必须吸取之前的教训，海乱鬼的人数众多，还都是些不择手段的人。",
            "nextDialogs": [
              "728040107"
            ]
          },
          "728040107": {
            "id": "728040107",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "要是他们一哄而上，消耗我的体力，我肯定会陷入被动，就和上次一样…",
            "nextDialogs": [
              "728040108"
            ]
          },
          "728040108": {
            "id": "728040108",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "所以，这次我想请阁下与我同行。",
            "nextDialogs": [
              "728040109"
            ]
          },
          "728040109": {
            "id": "728040109",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "上次我之所以落败，是因为那群海乱鬼仗着自己人多势众，不断地用车轮战消耗我的实力。",
            "nextDialogs": [
              "728040110"
            ]
          },
          "728040110": {
            "id": "728040110",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "等我体力不支后，他们的首领再前来和我对战。",
            "nextDialogs": [
              "728040111"
            ]
          },
          "728040111": {
            "id": "728040111",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "这次，我想请您帮我挡住周围的那些海乱鬼，而我会直接去挑战他们的首领。",
            "nextDialogs": [
              "728040112"
            ]
          },
          "728040112": {
            "id": "728040112",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "等我斩了那个恶徒，再回来助您。",
            "nextDialogs": [
              "728040114",
              "728040116"
            ]
          },
          "728040114": {
            "id": "728040114",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "阁下愿意协助我，实在感激不尽！",
            "nextDialogs": [
              "728040119"
            ]
          },
          "728040119": {
            "id": "728040119",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "总之，就拜托阁下了。",
            "nextDialogs": [
              "728040120"
            ]
          },
          "728040120": {
            "id": "728040120",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "事不宜迟，我们这就出发吧。"
          },
          "728040116": {
            "id": "728040116",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "那群海乱鬼，说白了也就是一群除了人数之外一无是处的乌合之众。",
            "nextDialogs": [
              "728040117"
            ]
          },
          "728040117": {
            "id": "728040117",
            "speakerId": 12144,
            "speakerName": "朝仓",
            "text": "我相信凭阁下的身手，他们就算是一起上，在阁下手底下也走不过三招。",
            "nextDialogs": [
              "728040118"
            ]
          },
          "728040118": {
            "id": "728040118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "咳，谬赞谬赞…"
          }
        }
      }
    },
    {
      "subId": "7280403",
      "subQuestName": "击败海乱鬼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728040301"
        ],
        "dialogs": {
          "728040301": {
            "id": "728040301",
            "speakerId": 20332,
            "speakerName": "「海乱鬼」头领",
            "text": "你？哈哈哈，不是上次的那个毛头小子吗？怎么，又来给我送藏品了？",
            "nextDialogs": [
              "728040302"
            ]
          },
          "728040302": {
            "id": "728040302",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "我是来取回我的武器的！",
            "nextDialogs": [
              "728040303"
            ]
          },
          "728040303": {
            "id": "728040303",
            "speakerId": 20332,
            "speakerName": "「海乱鬼」头领",
            "text": "嗯…不错，倒是有点胆色。但只找了一个帮手就敢闯到这里来，你未免也太看不起我了。",
            "nextDialogs": [
              "728040304"
            ]
          },
          "728040304": {
            "id": "728040304",
            "speakerId": 20332,
            "speakerName": "「海乱鬼」头领",
            "text": "不过，看在你到这里的这份胆色上，我就给你这个机会，上前来！我们去旁边玩玩。",
            "nextDialogs": [
              "728040305"
            ]
          },
          "728040305": {
            "id": "728040305",
            "speakerId": 20332,
            "speakerName": "「海乱鬼」头领",
            "text": "#但是嘛…我的这些手下，当然也不能闲着，你不是带了个帮手来吗？就让{M#他}{F#她}来陪他们玩玩吧。",
            "nextDialogs": [
              "728040308"
            ]
          },
          "728040308": {
            "id": "728040308",
            "speakerId": 20332,
            "speakerName": "「海乱鬼」头领",
            "text": "哈哈哈，口气倒是挺大。小的们，给我好好…折腾一下这愣头青！",
            "nextDialogs": [
              "728040309"
            ]
          },
          "728040309": {
            "id": "728040309",
            "speakerId": 20332,
            "speakerName": "「海乱鬼」头领",
            "text": "至于你，我们去旁边吧。",
            "nextDialogs": [
              "728040310"
            ]
          },
          "728040310": {
            "id": "728040310",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "那就交给你了，阁下…",
            "nextDialogs": [
              "728040311"
            ]
          },
          "728040311": {
            "id": "728040311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "交给我吧。",
            "nextDialogs": [
              "728040312"
            ]
          },
          "728040312": {
            "id": "728040312",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "不胜感激。我会马上把他斩掉，然后回来帮您的。",
            "nextDialogs": [
              "728040313"
            ]
          },
          "728040313": {
            "id": "728040313",
            "speakerId": 20332,
            "speakerName": "「海乱鬼」头领",
            "text": "你的口气也不小啊，想要斩我的话，就自己来试试吧！"
          }
        }
      }
    },
    {
      "subId": "7280404",
      "subQuestName": "审问海乱鬼",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "728040206"
        ],
        "dialogs": {
          "728040206": {
            "id": "728040206",
            "speakerId": 20331,
            "speakerName": "「海乱鬼」",
            "text": "哎哟！好汉，好汉留手！你这是从哪里找来的帮手…",
            "nextDialogs": [
              "728040207"
            ]
          },
          "728040207": {
            "id": "728040207",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "恶徒！现在就把武器还给我！",
            "nextDialogs": [
              "728040208"
            ]
          },
          "728040208": {
            "id": "728040208",
            "speakerId": 20331,
            "speakerName": "「海乱鬼」",
            "text": "你、你居然还惦记着那把武器…",
            "nextDialogs": [
              "728040209"
            ]
          },
          "728040209": {
            "id": "728040209",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "我只为取回我的武器，你告诉我那把武器在哪，我留你一条生路。",
            "nextDialogs": [
              "728040210"
            ]
          },
          "728040210": {
            "id": "728040210",
            "speakerId": 20331,
            "speakerName": "「海乱鬼」",
            "text": "这…",
            "nextDialogs": [
              "728040213"
            ]
          },
          "728040213": {
            "id": "728040213",
            "speakerId": 20331,
            "speakerName": "「海乱鬼」",
            "text": "啊哟！好汉留手！怎得如此暴躁，我也没说我不说啊！",
            "nextDialogs": [
              "728040214"
            ]
          },
          "728040214": {
            "id": "728040214",
            "speakerId": 20331,
            "speakerName": "「海乱鬼」",
            "text": "那…那把武器，被我们老大留着当藏品了，你们要是想拿，去那边的营地里找他就可以了！",
            "nextDialogs": [
              "728040215"
            ]
          },
          "728040215": {
            "id": "728040215",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "哼，算你识相。",
            "nextDialogs": [
              "728040216"
            ]
          },
          "728040216": {
            "id": "728040216",
            "speakerId": 20331,
            "speakerName": "「海乱鬼」",
            "text": "那二位好汉，在下…",
            "nextDialogs": [
              "728040217"
            ]
          },
          "728040217": {
            "id": "728040217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "滚！",
            "nextDialogs": [
              "728040218"
            ]
          },
          "728040218": {
            "id": "728040218",
            "speakerId": 20331,
            "speakerName": "「海乱鬼」",
            "text": "是！",
            "nextDialogs": [
              "728040219"
            ]
          },
          "728040219": {
            "id": "728040219",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "武艺不怎么样，逃跑倒是挺在行！",
            "nextDialogs": [
              "728040220"
            ]
          },
          "728040220": {
            "id": "728040220",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "卖同伴卖得这么果断…",
            "nextDialogs": [
              "728040221"
            ]
          },
          "728040221": {
            "id": "728040221",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "海乱鬼终归只是一群为利而聚的乌合之众，谈不上什么忠诚，也谈不上什么信念。",
            "nextDialogs": [
              "728040222"
            ]
          },
          "728040222": {
            "id": "728040222",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "遇见了麻烦事，第一反应是拍屁股走人，这实在是太正常不过了。",
            "nextDialogs": [
              "728040223"
            ]
          },
          "728040223": {
            "id": "728040223",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "不过，还是多亏了阁下在一旁以声势压人，不然他可不会这么容易就服软。",
            "nextDialogs": [
              "728040224"
            ]
          },
          "728040224": {
            "id": "728040224",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "但接下来，我们就必须直奔海乱鬼的大本营了。",
            "nextDialogs": [
              "728040225"
            ]
          },
          "728040225": {
            "id": "728040225",
            "speakerId": 3060,
            "speakerName": "朝仓",
            "text": "还是依照之前的计划，阁下，我会直接去斩了那个头领，剩下的杂鱼就交给阁下了。"
          }
        }
      }
    },

    {
      "subId": "7419301",
      "subQuestName": "(test)找到美露辛$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741930101"
        ],
        "dialogs": {
          "741930101": {
            "id": "741930101",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "#派蒙！{NICKNAME}！",
            "nextDialogs": [
              "741930102"
            ]
          },
          "741930102": {
            "id": "741930102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！居然是珀西芙！又见到你了，真高兴！你在这里做什么呀？",
            "nextDialogs": [
              "741930103"
            ]
          },
          "741930103": {
            "id": "741930103",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "珀西芙…干活！珀西芙…累累！珀西芙…躺！",
            "nextDialogs": [
              "741930104"
            ]
          },
          "741930104": {
            "id": "741930104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呃…？你在干活？",
            "nextDialogs": [
              "741930105"
            ]
          },
          "741930105": {
            "id": "741930105",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "幽林枝…幽林枝…十分很丢！",
            "nextDialogs": [
              "741930106"
            ]
          },
          "741930106": {
            "id": "741930106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "幽林枝？那是什么？",
            "nextDialogs": [
              "741930107"
            ]
          },
          "741930107": {
            "id": "741930107",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "幽林枝…信息！",
            "nextDialogs": [
              "741930108"
            ]
          },
          "741930108": {
            "id": "741930108",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "垂柳，收集。雾道，处理。泉眼，发送。",
            "nextDialogs": [
              "741930109"
            ]
          },
          "741930109": {
            "id": "741930109",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "幽林枝，雾道信息！",
            "nextDialogs": [
              "741930110"
            ]
          },
          "741930110": {
            "id": "741930110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那是幽林雾道的信息？",
            "nextDialogs": [
              "741930111"
            ]
          },
          "741930111": {
            "id": "741930111",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "珀西芙！",
            "nextDialogs": [
              "741930112"
            ]
          },
          "741930112": {
            "id": "741930112",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "幽林枝…十分很丢！十分很多地方！",
            "nextDialogs": [
              "741930113"
            ]
          },
          "741930113": {
            "id": "741930113",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "珀西芙…找！珀西芙…累累！珀西芙…吃！珀西芙…躺！",
            "nextDialogs": [
              "741930114"
            ]
          },
          "741930114": {
            "id": "741930114",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "幽林枝…十分很不多！但是箱子，十分很多！",
            "nextDialogs": [
              "741930115"
            ]
          },
          "741930115": {
            "id": "741930115",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "#啊…谢谢派蒙，谢谢{NICKNAME}，给！",
            "nextDialogs": [
              "741930116"
            ]
          },
          "741930116": {
            "id": "741930116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你又给我们找到了宝箱吗？",
            "nextDialogs": [
              "741930117"
            ]
          },
          "741930117": {
            "id": "741930117",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "珀西芙！箱子，宝贝，花花，闪闪，甜甜，十分很多！",
            "nextDialogs": [
              "741930118"
            ]
          },
          "741930118": {
            "id": "741930118",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，还有别的东西吗？珀西芙，你真好，但如果白拿你的东西就太不好意思了，不如我们来交换吧！",
            "nextDialogs": [
              "741930119"
            ]
          },
          "741930119": {
            "id": "741930119",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "交…换？",
            "nextDialogs": [
              "741930120"
            ]
          },
          "741930120": {
            "id": "741930120",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "因为我们是朋友，朋友就是用真心交换真心的那种！",
            "nextDialogs": [
              "741930121"
            ]
          },
          "741930121": {
            "id": "741930121",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以我们去帮你找那个幽林枝，然后来换你的东西，你觉得好不好呀？",
            "nextDialogs": [
              "741930122"
            ]
          },
          "741930122": {
            "id": "741930122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还可以给你找点吃的。",
            "nextDialogs": [
              "741930123"
            ]
          },
          "741930123": {
            "id": "741930123",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦，珀西芙一个人在外面应该很辛苦，我们可以帮她找吃的。",
            "nextDialogs": [
              "741930124"
            ]
          },
          "741930124": {
            "id": "741930124",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "吃的！汐藻！珀西芙！",
            "nextDialogs": [
              "741930125"
            ]
          },
          "741930125": {
            "id": "741930125",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你喜欢吃汐藻？",
            "nextDialogs": [
              "741930126"
            ]
          },
          "741930126": {
            "id": "741930126",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "汐藻！汐藻！汐藻汐藻汐藻！",
            "nextDialogs": [
              "741930127"
            ]
          },
          "741930127": {
            "id": "741930127",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "一天吃五顿？还是一顿吃五个？呜哇…感觉比我还能吃！",
            "nextDialogs": [
              "741930128"
            ]
          },
          "741930128": {
            "id": "741930128",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那幽林枝呢？珀西芙，是不是去幽林雾道就可以找到啦？",
            "nextDialogs": [
              "741930129"
            ]
          },
          "741930129": {
            "id": "741930129",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "美露莘…",
            "nextDialogs": [
              "741930130"
            ]
          },
          "741930130": {
            "id": "741930130",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "幽林枝…十分很丢！十分很多地方！十分伊黎耶！",
            "nextDialogs": [
              "741930131"
            ]
          },
          "741930131": {
            "id": "741930131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "幽林枝在整个伊黎耶？",
            "nextDialogs": [
              "741930132"
            ]
          },
          "741930132": {
            "id": "741930132",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "#聪明{NICKNAME}！珀西芙！",
            "nextDialogs": [
              "741930133"
            ]
          },
          "741930133": {
            "id": "741930133",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "雾道，有花花，幽林枝，也花花！",
            "nextDialogs": [
              "741930134"
            ]
          },
          "741930134": {
            "id": "741930134",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "幽林枝…幽林枝…幽林枝…幽林枝…幽林枝…幽林枝…数量！",
            "nextDialogs": [
              "741930135"
            ]
          },
          "741930135": {
            "id": "741930135",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊…这次我一下就听懂了！幽林枝在的地方，长着和幽林雾道一样的花，一共有六个地方，是这样吧？",
            "nextDialogs": [
              "741930136"
            ]
          },
          "741930136": {
            "id": "741930136",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "聪明派蒙！珀西芙！",
            "nextDialogs": [
              "741930137"
            ]
          },
          "741930137": {
            "id": "741930137",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，这下我们就都清楚了。珀西芙，那你就先好好休息，这件事包在我们身上！",
            "nextDialogs": [
              "741930138"
            ]
          },
          "741930138": {
            "id": "741930138",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "#派蒙，{NICKNAME}，好东西！所以，慢慢…慢慢！珀西芙！"
          }
        }
      }

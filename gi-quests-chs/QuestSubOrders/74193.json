    {
      "subId": "7419305",
      "subQuestName": "(test)告别对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741930501"
        ],
        "dialogs": {
          "741930501": {
            "id": "741930501",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "…箱子…宝贝…美露莘…",
            "nextDialogs": [
              "741930502"
            ]
          },
          "741930502": {
            "id": "741930502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哎呀！珀西芙，我们是不是把你的东西换完了？",
            "nextDialogs": [
              "741930503"
            ]
          },
          "741930503": {
            "id": "741930503",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "珀西芙…出门！珀西芙…找！",
            "nextDialogs": [
              "741930504"
            ]
          },
          "741930504": {
            "id": "741930504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没有了也没关系的。",
            "nextDialogs": [
              "741930505"
            ]
          },
          "741930505": {
            "id": "741930505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错，我们可以直接把汐藻给你啦！",
            "nextDialogs": [
              "741930506"
            ]
          },
          "741930506": {
            "id": "741930506",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "美露莘！",
            "nextDialogs": [
              "741930507"
            ]
          },
          "741930507": {
            "id": "741930507",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "#派蒙，朋友…真心！{NICKNAME}，朋友…真心！所以…交换！",
            "nextDialogs": [
              "741930508"
            ]
          },
          "741930508": {
            "id": "741930508",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那…好吧，珀西芙，你要出门多久呢？我们还会再见吗？",
            "nextDialogs": [
              "741930509"
            ]
          },
          "741930509": {
            "id": "741930509",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "再…见？",
            "nextDialogs": [
              "741930510"
            ]
          },
          "741930510": {
            "id": "741930510",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "再见就是希望再次见面的意思哦。",
            "nextDialogs": [
              "741930511"
            ]
          },
          "741930511": {
            "id": "741930511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见是用来道别的话。",
            "nextDialogs": [
              "741930512"
            ]
          },
          "741930512": {
            "id": "741930512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错没错！上次就说过了，我们要好好教你道别。所以珀西芙，你也来试试说一句吧？",
            "nextDialogs": [
              "741930513"
            ]
          },
          "741930513": {
            "id": "741930513",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "道…别？",
            "nextDialogs": [
              "741930514"
            ]
          },
          "741930514": {
            "id": "741930514",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…你是不是不懂什么是道别？",
            "nextDialogs": [
              "741930515"
            ]
          },
          "741930515": {
            "id": "741930515",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "让我想想…那差不多也算是一种交换吧，用明天交换明天…",
            "nextDialogs": [
              "741930516"
            ]
          },
          "741930516": {
            "id": "741930516",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "把你的明天给一点给我们，我们的也给一点给你，这样我们就能再见啦！怎么样？这样说你理解吗？",
            "nextDialogs": [
              "741930517"
            ]
          },
          "741930517": {
            "id": "741930517",
            "speakerId": 1000,
            "speakerName": "珀西芙",
            "text": "明天…交换…明天…！珀西芙！",
            "nextDialogs": [
              "741930518"
            ]
          },
          "741930518": {
            "id": "741930518",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，看来你听懂了！那我们来道别吧，好好说再见就一定会再见！",
            "nextDialogs": [
              "741930519"
            ]
          },
          "741930519": {
            "id": "741930519",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "再见啦！珀西芙！",
            "nextDialogs": [
              "741930520"
            ]
          },
          "741930520": {
            "id": "741930520",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "再见！",
            "nextDialogs": [
              "741930521"
            ]
          },
          "741930521": {
            "id": "741930521",

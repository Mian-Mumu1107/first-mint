    {
      "subId": "7410025",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741002501"
        ],
        "dialogs": {
          "741002501": {
            "id": "741002501",
            "speakerId": 20997,
            "speakerName": "阿尔",
            "text": "如果能够重新取回莉利丝公主的宝物，正义阵营的势力也将随着那份「时间」变得壮大，击败「纳西索斯」的胜利日就在眼前！",
            "nextDialogs": [
              "741002502"
            ]
          },
          "741002502": {
            "id": "741002502",
            "speakerId": 20997,
            "speakerName": "阿尔",
            "text": "…为此我们也绝不能遗忘奈伊的牺牲，如果没有他藏起宝物，「纳西索斯」必然早已攻破了公主所在的高塔。",
            "nextDialogs": [
              "741002503"
            ]
          },
          "741002503": {
            "id": "741002503",
            "speakerId": 20996,
            "speakerName": "小卷心菜",
            "text": "嗯，奈伊哥哥很了不起。",
            "nextDialogs": [
              "741002504"
            ]
          },
          "741002504": {
            "id": "741002504",
            "speakerId": 20997,
            "speakerName": "阿尔",
            "text": "#我们不能辜负奈伊的努力，也不能辜负{NICKNAME}的努力，这次，有大家的帮忙，我们一定能救出莉利丝公主。",
            "nextDialogs": [
              "741002505"
            ]
          },
          "741002505": {
            "id": "741002505",
            "speakerId": 20996,
            "speakerName": "小卷心菜",
            "text": "对，救出莉利丝公主，然后，然后…",
            "nextDialogs": [
              "741002506"
            ]
          },
          "741002506": {
            "id": "741002506",
            "speakerId": 20997,
            "speakerName": "阿尔",
            "text": "然后水仙十字王国就能恢复以前那样粼光闪耀的样子，公主又能将你抱在怀中，为你整理羽毛，轻轻抚摸你小小的额头。",
            "nextDialogs": [
              "741002507"
            ]
          },
          "741002507": {
            "id": "741002507",
            "speakerId": 20997,
            "speakerName": "阿尔",
            "text": "那些遗失在水畔的回忆将重新归来，所有的朋友们都欢笑着围绕在公主身边，一切总会变成幸福美满的样子，再无纷争与烦恼。",
            "nextDialogs": [
              "741002508"
            ]
          },
          "741002508": {
            "id": "741002508",
            "speakerId": 20996,
            "speakerName": "小卷心菜",
            "text": "就跟以前一样！",
            "nextDialogs": [
              "741002509"
            ]
          },
          "741002509": {
            "id": "741002509",
            "speakerId": 20997,
            "speakerName": "阿尔",
            "text": "…对，就跟以前一样。"
          }
        }
      }
    },
    {
      "subId": "7410026",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741002601"
        ],
        "dialogs": {
          "741002601": {
            "id": "741002601",
            "speakerId": 20998,
            "speakerName": "雅克",
            "text": "#是你啊，{NICKNAME}。取回莉利丝小姐的宝物以后，我们就掌握了胜利的关键。",
            "nextDialogs": [
              "741002602"
            ]
          },
          "741002602": {
            "id": "741002602",
            "speakerId": 20998,
            "speakerName": "雅克",
            "text": "终于，有机会打倒入侵的外来者，拯救出莉利丝小姐。如此一来，「雅克管弦乐团」也将奏响…",
            "nextDialogs": [
              "741002603"
            ]
          },
          "741002603": {
            "id": "741002603",
            "speakerId": 20998,
            "speakerName": "雅克",
            "text": "序曲的最后一个章节。",
            "nextDialogs": [
              "741002606"
            ]
          },
          "741002606": {
            "id": "741002606",
            "speakerId": 20998,
            "speakerName": "雅克",
            "text": "嗯？你不会以为救出莉利丝小姐，重新拯救了王国，一切就到此结束了吧？哈！现实世界可不是童话故事。",
            "nextDialogs": [
              "741002607"
            ]
          },
          "741002607": {
            "id": "741002607",
            "speakerId": 20998,
            "speakerName": "雅克",
            "text": "就是因为有你这样想法的天真家伙很多，历史才会不断地重蹈覆辙。下一步，要颠覆根深蒂固的阶级体制和分配方式。",
            "nextDialogs": [
              "741002608"
            ]
          },
          "741002608": {
            "id": "741002608",
            "speakerId": 20998,
            "speakerName": "雅克",
            "text": "在一个合理平等世界里——不必多说，平等自然是合理状态，也一定是莉利丝小姐向往的状态。之所以将其并列是考虑到现状…",
            "nextDialogs": [
              "741002609"
            ]
          },
          "741002609": {
            "id": "741002609",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我先走了…",
            "nextDialogs": [
              "741002610"
            ]
          },
          "741002610": {
            "id": "741002610",
            "speakerId": 20998,
            "speakerName": "雅克",
            "text": "我们首先应当根据…设立…推翻…"
          }
        }
      }
    },
    {
      "subId": "7410031",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741003101"
        ],
        "dialogs": {
          "741003101": {
            "id": "741003101",
            "speakerId": 20999,
            "speakerName": "莫里",
            "text": "（嗅嗅）",
            "nextDialogs": [
              "741003102"
            ]
          },
          "741003102": {
            "id": "741003102",
            "speakerId": 20999,
            "speakerName": "莫里",
            "text": "汪汪，是好人。摸摸？",
            "nextDialogs": [
              "741003104",
              "741003107"
            ]
          },
          "741003104": {
            "id": "741003104",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "摸了摸莫里。\\n因为是水构成的（狗），所以湿漉漉的。\\n但是莫里看上去很高兴。",
            "nextDialogs": [
              "741003105"
            ]
          },
          "741003105": {
            "id": "741003105",
            "speakerId": 20999,
            "speakerName": "莫里",
            "text": "汪汪，谢谢好人！"
          },
          "741003107": {
            "id": "741003107",
            "speakerId": 20999,
            "speakerName": "莫里",
            "text": "呜，莫里坏坏，所以不摸？",
            "nextDialogs": [
              "741003108"
            ]
          },
          "741003108": {
            "id": "741003108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这跟好坏有什么关系？",
            "nextDialogs": [
              "741003109"
            ]
          },
          "741003109": {
            "id": "741003109",
            "speakerId": 20999,
            "speakerName": "莫里",
            "text": "汪汪，好狗狗摸摸，坏狗狗…修。",
            "nextDialogs": [
              "741003110"
            ]
          },
          "741003110": {
            "id": "741003110",
            "speakerId": 20999,
            "speakerName": "莫里",
            "text": "呜呜…",
            "nextDialogs": [
              "741003111"
            ]
          },
          "741003111": {
            "id": "741003111",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "看到莫里很伤心，你伸出手摸了摸莫里。\\n因为是水构成的（狗），所以湿漉漉的。\\n莫里蓝色的眼睛里重新出现了光彩。",
            "nextDialogs": [
              "741003112"
            ]
          },
          "741003112": {
            "id": "741003112",
            "speakerId": 20999,
            "speakerName": "莫里",
            "text": "汪汪，谢谢摸摸！"
          }
        }
      }
    }
  ]
}
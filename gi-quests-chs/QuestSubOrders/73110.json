  "subQuests": [
    {
      "subId": "7311001",
      "subQuestName": "(test)与索赫尔对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731100101"
        ],
        "dialogs": {
          "731100101": {
            "id": "731100101",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "呼…这里要凉快多了，拜托二位，把石板暂时借我一观。",
            "nextDialogs": [
              "731100102"
            ]
          },
          "731100102": {
            "id": "731100102",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "索赫尔拿着石板看了又看，时而眉头紧锁，时而啧啧称奇。",
            "nextDialogs": [
              "731100103"
            ]
          },
          "731100103": {
            "id": "731100103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂…你看得也太久了吧！难道说是想把上面的内容记下来，不给我们报酬？",
            "nextDialogs": [
              "731100104"
            ]
          },
          "731100104": {
            "id": "731100104",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "抱歉抱歉，只是实在是看入迷了，毕竟我是第一次见到这样的一次文献…",
            "nextDialogs": [
              "731100105"
            ]
          },
          "731100105": {
            "id": "731100105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么发现吗？",
            "nextDialogs": [
              "731100106"
            ]
          },
          "731100106": {
            "id": "731100106",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "唔…有一些吧，看起来像是什么工程记录…里面提到了「阿如」，不知道和阿如村是什么关系。可惜没有更多记载了…",
            "nextDialogs": [
              "731100107"
            ]
          },
          "731100107": {
            "id": "731100107",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "不过，也是值得写上几笔的发现了，谢谢你们，这是说好的报酬！",
            "nextDialogs": [
              "731100112",
              "731100110"
            ]
          },
          "731100112": {
            "id": "731100112",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "那么下一步，就是找到更多的一次文献，可是不进沙漠的话又很难弄到手…",
            "nextDialogs": [
              "731100113"
            ]
          },
          "731100113": {
            "id": "731100113",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "啊…我想到了！二位接下来要是有空的话，能不能听我一个不情之请…",
            "nextDialogs": [
              "731100114"
            ]
          },
          "731100114": {
            "id": "731100114",
            "speakerId": 20821,
            "speakerName": "哈尔瓦尼",
            "text": "索赫尔先生，莫非你是想…",
            "nextDialogs": [
              "731100115"
            ]
          },
          "731100115": {
            "id": "731100115",
            "speakerId": 20821,
            "speakerName": "哈尔瓦尼",
            "text": "贤者大人吩咐过，任何学者都不得进入沙漠…",
            "nextDialogs": [
              "731100116"
            ]
          },
          "731100116": {
            "id": "731100116",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "哎，别误会，我可不敢不听从贤者大人的命令。不过贤者大人应该没有吩咐过，不允许随便赠送礼物吧？",
            "nextDialogs": [
              "731100117"
            ]
          },
          "731100117": {
            "id": "731100117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "赠送礼物？你要送我们什么好东西？",
            "nextDialogs": [
              "731100118"
            ]
          },
          "731100118": {
            "id": "731100118",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "是非常珍贵的事物——我的考古笔记。",
            "nextDialogs": [
              "731100119"
            ]
          },
          "731100119": {
            "id": "731100119",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "实不相瞒，我在十几年前，也曾经试图进入沙漠，不过没有什么特别的发现。只记录下了几处很可疑的遗迹的位置。",
            "nextDialogs": [
              "731100120"
            ]
          },
          "731100120": {
            "id": "731100120",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "我想，在时隔多年我又回到这里的时候，和你们因为遗迹相识，这一定是某种宿命。所以我想把这本笔记送给你们！",
            "nextDialogs": [
              "731100121"
            ]
          },
          "731100121": {
            "id": "731100121",
            "speakerId": 20821,
            "speakerName": "哈尔瓦尼",
            "text": "你是打算…？我明白了，确实没有违反贤者大人的吩咐，可是，这样的举动终究…",
            "nextDialogs": [
              "731100122"
            ]
          },
          "731100122": {
            "id": "731100122",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "#举动？什么举动？赠送礼物单纯只是为了纪念我结识了大英雄{NICKNAME}和小英雄派蒙，难道不是非常合理？",
            "nextDialogs": [
              "731100123"
            ]
          },
          "731100123": {
            "id": "731100123",
            "speakerId": 20821,
            "speakerName": "哈尔瓦尼",
            "text": "合理…吧…"
          },
          "731100110": {
            "id": "731100110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没错，如果不是为了证明提尔扎德没有撒谎，我们也不会找到这块石板！",
            "nextDialogs": [
              "731100111"
            ]
          },
          "731100111": {
            "id": "731100111",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "你说得对，谢谢提尔扎德，谢谢他。"
          }
        }
      }
    },

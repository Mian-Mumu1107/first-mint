            ]
          },
          "731100603": {
            "id": "731100603",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "当然有！并且，一定会让你大吃一惊！",
            "nextDialogs": [
              "731100604"
            ]
          },
          "731100604": {
            "id": "731100604",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "向索赫尔讲述了探查透明遗迹的经历，并把三块石板交给了他。",
            "nextDialogs": [
              "731100605"
            ]
          },
          "731100605": {
            "id": "731100605",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "喔…！果然，那股神秘的力量后面有着赤王不可告人的秘密，且待我一探究竟。",
            "nextDialogs": [
              "731100606"
            ]
          },
          "731100606": {
            "id": "731100606",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "……",
            "nextDialogs": [
              "731100607"
            ]
          },
          "731100607": {
            "id": "731100607",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "这是…",
            "nextDialogs": [
              "731100608"
            ]
          },
          "731100608": {
            "id": "731100608",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "怎么会这样…？",
            "nextDialogs": [
              "731100609"
            ]
          },
          "731100609": {
            "id": "731100609",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，你的脸色变得好难看，是发现了什么可怕的事情吗？",
            "nextDialogs": [
              "731100610"
            ]
          },
          "731100610": {
            "id": "731100610",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "啊…抱歉，倒也不是说可怕，而是…石板上的内容，看起来很复杂，不过本质上都是…请假记录…",
            "nextDialogs": [
              "731100611"
            ]
          },
          "731100611": {
            "id": "731100611",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "并且，就连请假理由和现在的年轻学者们都没什么区别…",
            "nextDialogs": [
              "731100612"
            ]
          },
          "731100612": {
            "id": "731100612",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "呼，还好当年没能找到进入透明遗迹的方法，否则可能会被气疯的。",
            "nextDialogs": [
              "731100613"
            ]
          },
          "731100613": {
            "id": "731100613",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "不过，还是谢谢你们带回了这几块石板，我再去打听一下蒙德人的请假理由，应该也能够写上一篇论文——",
            "nextDialogs": [
              "731100614"
            ]
          },
          "731100614": {
            "id": "731100614",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "《忙里偷闲——浅论不同社会形态中休假观念的流变》。"
          }
        }
      }
    },
    {
      "subId": "7311004",
      "subQuestName": "根据索赫尔的考古笔记，深入沙漠探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731100701"
        ],
        "dialogs": {
          "731100701": {
            "id": "731100701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "探索了「吞羊岩」。",
            "nextDialogs": [
              "731100702"
            ]
          },
          "731100702": {
            "id": "731100702",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "啊，二位没有遇到什么危险吧。不过我相信，凭借二位的身手，就算是遇见图特摩斯，也不会有什么事的。",
            "nextDialogs": [
              "731100703"
            ]
          },
          "731100703": {
            "id": "731100703",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "向索赫尔讲述了探查吞羊岩的经历，并把石板交给了他。",
            "nextDialogs": [
              "731100704"
            ]
          },
          "731100704": {
            "id": "731100704",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "果然有秘密基地…难怪我当时那么警惕，却还是被图特摩斯洗劫了。",
            "nextDialogs": [
              "731100705"
            ]
          },
          "731100705": {
            "id": "731100705",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "一帮有眼无珠的家伙，嘴上说着信仰赤王，却把重要的留存随便乱放…简直…不可原谅…",
            "nextDialogs": [
              "731100706"
            ]
          },
          "731100706": {
            "id": "731100706",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "我要代表教令院感谢你们，从他们手中夺回这么有价值的…唔…",
            "nextDialogs": [
              "731100707"
            ]
          },
          "731100707": {
            "id": "731100707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你为什么突然皱起了眉头呀？难道是什么非常难以解读的内容吗？",
            "nextDialogs": [
              "731100708"
            ]
          },
          "731100708": {
            "id": "731100708",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "呃，恰恰相反，这是一首…情诗…",
            "nextDialogs": [
              "731100709"
            ]
          },
          "731100709": {
            "id": "731100709",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "也许这块石板对于知论派的那些家伙来说，更有价值些。我都能想象他们会写出什么样的标题——",
            "nextDialogs": [
              "731100710"
            ]
          },
          "731100710": {
            "id": "731100710",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "《浅论修辞发达程度与文明发展程度的关系》。"
          }
        }
      }
    },
    {
      "subId": "7311005",
      "subQuestName": "根据索赫尔的考古笔记，深入沙漠探索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

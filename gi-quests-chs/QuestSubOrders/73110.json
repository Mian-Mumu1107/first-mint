    {
      "subId": "7311007",
      "subQuestName": "与索赫尔对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731100501"
        ],
        "dialogs": {
          "731100501": {
            "id": "731100501",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "这样一来，三处遗迹都已经探索完成，我的心事也算是了结了。",
            "nextDialogs": [
              "731100502"
            ]
          },
          "731100502": {
            "id": "731100502",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "那么，为了庆祝我们友谊进一步加深，我会再准备一些礼物，表达对大英雄和小英雄的谢意。",
            "nextDialogs": [
              "731100504",
              "731100506"
            ]
          },
          "731100504": {
            "id": "731100504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这些都不算什么啦，并且我们也靠着你的笔记找到了不少宝藏呢！对了，你的论文怎么样了？",
            "nextDialogs": [
              "731100507"
            ]
          },
          "731100507": {
            "id": "731100507",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "论文啊…有点头疼…虽然能写出新的论文没错，但是我已经过了那个靠论文数量的年纪了。",
            "nextDialogs": [
              "731100508"
            ]
          },
          "731100508": {
            "id": "731100508",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "还是得要突破性成果…还是要进到赤王陵里…",
            "nextDialogs": [
              "731100509"
            ]
          },
          "731100509": {
            "id": "731100509",
            "speakerId": 20821,
            "speakerName": "哈尔瓦尼",
            "text": "贤者大人…",
            "nextDialogs": [
              "731100510"
            ]
          },
          "731100510": {
            "id": "731100510",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "唉，知道知道，左一句贤者大人，右一句贤者大人，我也就是抱怨一下…",
            "nextDialogs": [
              "731100511"
            ]
          },
          "731100511": {
            "id": "731100511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "为什么这么想要成果？",
            "nextDialogs": [
              "731100512"
            ]
          },
          "731100512": {
            "id": "731100512",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "那当然是为了成为下一任贤者大人的候补。",
            "nextDialogs": [
              "731100513"
            ]
          },
          "731100513": {
            "id": "731100513",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "在外人看来，贤者大人和学者的区别，可能也就是小一点的日落果和大一点的日落果的区别。",
            "nextDialogs": [
              "731100514"
            ]
          },
          "731100514": {
            "id": "731100514",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "但实际上，贤者大人和我们普通学者的区别，比丘丘人和史莱姆的区别还大。"
          },
          "731100506": {
            "id": "731100506",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没错！我们获得了宝藏，而你也能写出论文来。"
          }
        }
      }
    },
    {
      "subId": "7311003",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731100301"
        ],
        "dialogs": {
          "731100301": {
            "id": "731100301",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "二位回来了，在沙漠中有什么收获？",
            "nextDialogs": [
              "731100302"
            ]
          },
          "731100302": {
            "id": "731100302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有。",
            "nextDialogs": [
              "731100303"
            ]
          },
          "731100303": {
            "id": "731100303",
            "speakerId": 4245,
            "speakerName": "索赫尔",
            "text": "好吧…如果有什么收获的话，不妨来和我分享一下，满足我对知识的渴求。"
          }
        }
      }
    },
    {
      "subId": "7311004",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "731100401"
        ],
        "dialogs": {
          "731100401": {
            "id": "731100401",
            "speakerId": 20821,
            "speakerName": "哈尔瓦尼",
            "text": "既然贤者大人没有吩咐阻拦旅行者进入沙漠…那么…请自便。"
          }
        }
      }
    }
  ]
}
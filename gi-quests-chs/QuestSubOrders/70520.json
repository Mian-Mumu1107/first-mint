          },
          "705200202": {
            "id": "705200202",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "结识了两位加盟的店主…",
            "nextDialogs": [
              "705200203"
            ]
          },
          "705200203": {

    {
      "subId": "7052001",
      "subQuestName": "返回店铺，了解义卖的进展",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705200101"
        ],
        "dialogs": {
          "705200101": {
            "id": "705200101",
            "speakerId": 30234,
            "speakerName": "伯恩哈德",
            "text": "荣誉骑士，派蒙！有个好消息要告诉你们！我们有新的帮手了！",
            "nextDialogs": [
              "705200102"
            ]
          },
          "705200102": {
            "id": "705200102",
            "speakerId": 30234,
            "speakerName": "伯恩哈德",
            "text": "这两位店主听说了义卖的事后，想要加入我们，将收益捐献出来。",
            "nextDialogs": [
              "705200103"
            ]
          },
          "705200103": {
            "id": "705200103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？捐献？真的没关系吗？",
            "nextDialogs": [
              "705200104"
            ]
          },
          "705200104": {
            "id": "705200104",
            "speakerId": 30243,
            "speakerName": "马茨",
            "text": "没事没事！",
            "nextDialogs": [
              "705200105"
            ]
          },
          "705200105": {
            "id": "705200105",
            "speakerId": 30243,
            "speakerName": "马茨",
            "text": "多一份资金，就多一位受益人，我和保琳小姐都觉得比我们埋头赚钱更重要。",
            "nextDialogs": [
              "705200106"
            ]
          },
          "705200106": {
            "id": "705200106",
            "speakerId": 30244,
            "speakerName": "保琳",
            "text": "这次佳酿节的客人比往年更多，我们提前完成了经营计划，早就心满意足了。",
            "nextDialogs": [
              "705200107"
            ]
          },
          "705200107": {
            "id": "705200107",
            "speakerId": 30244,
            "speakerName": "保琳",
            "text": "不能只让你们为老人和孩子们忙前忙后，我们也想尽可能帮上忙，请不要有心理负担。",
            "nextDialogs": [
              "705200108"
            ]
          },
          "705200108": {
            "id": "705200108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "由衷感谢你们。",
            "nextDialogs": [
              "705200109"
            ]
          },
          "705200109": {
            "id": "705200109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，感觉心里暖暖的…",
            "nextDialogs": [
              "705200110"
            ]
          },
          "705200110": {
            "id": "705200110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过这下就得换个名字了吧！那就改叫…「西风哗哗义卖联盟」了。",
            "nextDialogs": [
              "705200113"
            ]
          },
          "705200113": {
            "id": "705200113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让我们一起拿出全力，办好这次义卖活动吧！",
            "nextDialogs": [
              "705200114"
            ]
          },
          "705200114": {
            "id": "705200114",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "两位店主加入了队伍，义卖活动的规模扩大了…",
            "nextDialogs": [
              "705200115"
            ]
          },
          "705200115": {
            "id": "705200115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "来这边瞧瞧吧，「西风哗哗义卖联盟」的特色小吃、日用百货和鲜花哦…",
            "nextDialogs": [
              "705200116"
            ]
          },
          "705200116": {
            "id": "705200116",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？快看快看，阿贝多来了！",
            "nextDialogs": [
              "705200117"
            ]
          },
          "705200117": {
            "id": "705200117",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "#{NICKNAME}和派蒙，你们好啊。"
          }
        }
      }
    },
    {

    {
      "subId": "4007508",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400750801"
        ],
        "dialogs": {
          "400750801": {
            "id": "400750801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，又出来了！",
            "nextDialogs": [
              "400750802"
            ]
          },
          "400750802": {
            "id": "400750802",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "莫娜，那个冒险家…真的死了吗？",
            "nextDialogs": [
              "400750803"
            ]
          },
          "400750803": {
            "id": "400750803",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "……",
            "nextDialogs": [
              "400750804"
            ]
          },
          "400750804": {
            "id": "400750804",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "我只见过他一次。至今有三年多，所以…他应该已经不在人世了。",
            "nextDialogs": [
              "400750805"
            ]
          },
          "400750805": {
            "id": "400750805",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "可是，就没有一点他还活着，只是你算错的可能吗？",
            "nextDialogs": [
              "400750806"
            ]
          },
          "400750806": {
            "id": "400750806",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可那样不公平吧。",
            "nextDialogs": [
              "400750807"
            ]
          },
          "400750807": {
            "id": "400750807",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "遇到坏事就全然拒绝，遇到好事就深信不疑。这样的事，不能被称为占卜，只能算是自我安慰。",
            "nextDialogs": [
              "400750808"
            ]
          },
          "400750808": {
            "id": "400750808",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "作为日常娱乐当然没关系啦，但我学的是一门没有谎言的学问。",
            "nextDialogs": [
              "400750809"
            ]
          },
          "400750809": {
            "id": "400750809",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "否定我自己的结论，是在亵渎占星术。",
            "nextDialogs": [
              "400750810"
            ]
          },
          "400750810": {
            "id": "400750810",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "残酷，但也真实。命运确实是这样的东西。",
            "nextDialogs": [
              "400750811"
            ]
          },
          "400750811": {
            "id": "400750811",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "平时我可不说这种话，但既然提到了，还是希望大家别把占星术跟街边小摊小贩的那些抽签活动混为一谈。",
            "nextDialogs": [
              "400750812"
            ]
          },
          "400750812": {
            "id": "400750812",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "我们研究星象，绝不是为了让谁听了奉承高兴一整天。占星术士，是为了验证真实，见证世界之理而存在的。",
            "nextDialogs": [
              "400750813"
            ]
          },
          "400750813": {
            "id": "400750813",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "……",
            "nextDialogs": [
              "400750814"
            ]
          },
          "400750814": {
            "id": "400750814",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "啊——！所以我说，占星术士就是个招人讨厌的职业啊！很伟大跟惹人厌完全不冲突嘛！",
            "nextDialogs": [
              "400750815"
            ]
          },
          "400750815": {
            "id": "400750815",
            "speakerId": 1004,
            "speakerName": "菲谢尔",
            "text": "为何突然这般吵闹？汝也不是那么不值得结交的人啊。",
            "nextDialogs": [
              "400750816"
            ]
          },
          "400750816": {
            "id": "400750816",
            "speakerId": 1005,
            "speakerName": "奥兹",
            "text": "小姐的意思是，很高兴和您成为朋友。",
            "nextDialogs": [
              "400750817"
            ]
          },
          "400750817": {
            "id": "400750817",
            "speakerId": 1004,
            "speakerName": "菲谢尔",
            "text": "不是啦！我没那么说吧！",
            "nextDialogs": [
              "400750818"
            ]
          },
          "400750818": {
            "id": "400750818",
            "speakerId": 1004,
            "speakerName": "菲谢尔",
            "text": "奥兹，你怎么回事？越来越喜欢假传我的旨意了！",
            "nextDialogs": [
              "400750819"
            ]
          },
          "400750819": {
            "id": "400750819",
            "speakerId": 1005,
            "speakerName": "奥兹",
            "text": "哎呀哎呀，为什么呢，难道是我太担心小姐得罪好朋友，特意时时刻刻挽回吗？",
            "nextDialogs": [
              "400750820"
            ]
          },
          "400750820": {
            "id": "400750820",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "我见识没那么广，只认识你一个占星术士，不过你给我的感觉很好哦，完全不讨人厌。",
            "nextDialogs": [
              "400750821"
            ]
          },
          "400750821": {
            "id": "400750821",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "随便向别人打听秘密，又把不喜欢的结果随手丢弃，那些人自己才要反思一下，命运可不是那么便宜的东西啊。",
            "nextDialogs": [
              "400750822"
            ]
          },
          "400750822": {
            "id": "400750822",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "如果命运是三言两语便能回避的东西，人间就不会有别离之苦了。莫娜，别往心里去。",
            "nextDialogs": [
              "400750823"
            ]
          },
          "400750823": {
            "id": "400750823",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "追逐本心，永不忘记正确之事，这样足矣。",
            "nextDialogs": [
              "400750824"
            ]
          },
          "400750824": {
            "id": "400750824",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "咳咳，也…也没必要这样关怀我哦，我很强韧的。",
            "nextDialogs": [
              "400750825"
            ]
          },
          "400750825": {
            "id": "400750825",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那你耳朵为什么红红的？",
            "nextDialogs": [
              "400750826"
            ]
          },
          "400750826": {
            "id": "400750826",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "呃、呃…",
            "nextDialogs": [
              "400750827"
            ]
          },
          "400750827": {
            "id": "400750827",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "…好吧，那…那…",
            "nextDialogs": [
              "400750828"
            ]
          },
          "400750828": {
            "id": "400750828",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "谢谢大家…了。",
            "nextDialogs": [
              "400750829"
            ]
          },
          "400750829": {
            "id": "400750829",
            "speakerId": 1004,
            "speakerName": "菲谢尔",
            "text": "听不清楚，请大声向本皇女献上你的崇敬与祝福。",
            "nextDialogs": [
              "400750830"
            ]
          },
          "400750830": {
            "id": "400750830",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "好了好了殿下，比起斗嘴，您还是先去水池倒映出的新地点回收其他碎片吧。没有那个，我们可进不去幻境啊。",
            "nextDialogs": [
              "400750831"
            ]
          },
          "400750831": {
            "id": "400750831",
            "speakerId": 1005,
            "speakerName": "奥兹",
            "text": "唯有小姐您锐利的目光才能锁定秘密。",
            "nextDialogs": [
              "400750832"
            ]
          },
          "400750832": {
            "id": "400750832",
            "speakerId": 1004,
            "speakerName": "菲谢尔",
            "text": "既然如此，好吧好吧，本皇女就移驾海滩…",
            "nextDialogs": [
              "400750833"
            ]
          },
          "400750833": {
            "id": "400750833",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "走了，莫娜。",
            "nextDialogs": [
              "400750834"
            ]
          },
          "400750834": {
            "id": "400750834",
            "speakerId": 1002,
            "speakerName": "莫娜",
            "text": "哦、哦哦！来了！",
            "nextDialogs": [
              "400750835"
            ]
          },
          "400750835": {
            "id": "400750835",
            "speakerId": 1003,
            "speakerName": "枫原万叶",
            "text": "…哈哈。"
          }
        }
      }
    },

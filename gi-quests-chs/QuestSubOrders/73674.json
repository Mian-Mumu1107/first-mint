    {
      "subId": "7367401",
      "subQuestName": "与乌尔曼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736740101"
        ],
        "dialogs": {
          "736740101": {
            "id": "736740101",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "小家伙，不是你带我来的吗？来点作用，再动一动啊。",
            "nextDialogs": [
              "736740102"
            ]
          },
          "736740102": {
            "id": "736740102",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "唉，行吧，你就待着别动吧…",
            "nextDialogs": [
              "736740106",
              "736740105"
            ]
          },
          "736740106": {
            "id": "736740106",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "唉，我这次算是又被这小家伙给坑了…我从头和你简单说说。",
            "nextDialogs": [
              "736740107"
            ]
          },
          "736740107": {
            "id": "736740107",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "说出来你可能不太相信，但是我这人不知道为什么，总是特别容易吸引仙灵。",
            "nextDialogs": [
              "736740108"
            ]
          },
          "736740108": {
            "id": "736740108",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "在那些过来跟着我不走的仙灵里，我发现了一种特别热衷于寻宝的仙灵。",
            "nextDialogs": [
              "736740109"
            ]
          },
          "736740109": {
            "id": "736740109",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "我也不会取名，就直接叫它们「寻宝仙灵」了。",
            "nextDialogs": [
              "736740110"
            ]
          },
          "736740110": {
            "id": "736740110",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "它们很擅长寻宝，在它们的帮助下，我也挖到了不少宝贝，小小地赚了一笔钱。",
            "nextDialogs": [
              "736740111"
            ]
          },
          "736740111": {
            "id": "736740111",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "但它们有时候会突然不搭理我，也不知道是寻宝累了，还是觉得我这个人没什么意思…",
            "nextDialogs": [
              "736740112"
            ]
          },
          "736740112": {
            "id": "736740112",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "这个时候，我一般就会找个能让仙灵看顺眼的帮手合作。",
            "nextDialogs": [
              "736740113"
            ]
          },
          "736740113": {
            "id": "736740113",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "他负责带着「寻宝仙灵」寻宝，而我嘛…就负责把这些宝贝变现。",
            "nextDialogs": [
              "736740114"
            ]
          },
          "736740114": {
            "id": "736740114",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "我之前听人说，须弥这里遍地遗迹，满地古玩，所以就想要过来捞一笔。",
            "nextDialogs": [
              "736740115"
            ]
          },
          "736740115": {
            "id": "736740115",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "来了之后，我果然又吸引来了一堆仙灵，其中的几个「寻宝仙灵」把我带到了这里。",
            "nextDialogs": [
              "736740116"
            ]
          },
          "736740116": {
            "id": "736740116",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "但我没挖几铲子，这些小家伙又不搭理我了…",
            "nextDialogs": [
              "736740117"
            ]
          },
          "736740117": {
            "id": "736740117",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "咦？它怎么突然动弹起来了？难道…",
            "nextDialogs": [
              "736740118"
            ]
          },
          "736740118": {
            "id": "736740118",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "旅行者，你对和仙灵一起寻宝这件事，有兴趣吗？"
          },
          "736740105": {
            "id": "736740105",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "你说这小家伙？呃…就算它是吧…"
          }
        }
      }
    },
    {
      "subId": "7367403",
      "subQuestName": "(test)【隐藏】对话中做仙灵移动表现1$HIDDEN",

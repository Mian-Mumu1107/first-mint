        "dialogs": {
          "736740301": {
            "id": "736740301",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "小家伙，不是你带我来的吗？来点作用，再动一动啊。",
            "nextDialogs": [
              "736740302"
            ]
          },
          "736740302": {
            "id": "736740302",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "唉，行吧，你就待着别动吧…",
            "nextDialogs": [
              "736740305"
            ]
          },
          "736740305": {
            "id": "736740305",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "旅行者？嘿哟，真是好久不见了。",
            "nextDialogs": [
              "736740306"
            ]
          },
          "736740306": {
            "id": "736740306",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "怎么？你还在满世界转悠吗？我可是听说了你的不少惊天事迹，你可真是身手不凡啊。",
            "nextDialogs": [
              "736740307"
            ]
          },
          "736740307": {
            "id": "736740307",
            "speakerId": 1000,
            "speakerName": "乌尔曼",
            "text": "嘿嘿，这次你来须弥，又是打算来解决什么问题？"
          }
        }
      }
    },

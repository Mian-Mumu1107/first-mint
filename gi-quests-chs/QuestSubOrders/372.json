    {
      "subId": "37201",
      "subQuestName": "找到绿色的家伙",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3720101"
        ],
        "dialogs": {
          "3720101": {
            "id": "3720101",
            "speakerId": 1160,
            "speakerName": "绿色的家伙",
            "text": "啊，你们是…",
            "nextDialogs": [
              "3720102"
            ]
          },
          "3720102": {
            "id": "3720102",
            "speakerId": 1160,
            "speakerName": "绿色的家伙",
            "text": "喔…呀！是那个时候，把特瓦林吓跑的人吧。",
            "nextDialogs": [
              "3720103"
            ]
          },
          "3720103": {
            "id": "3720103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "特瓦林？谁啊？",
            "nextDialogs": [
              "3720106"
            ]
          },
          "3720106": {
            "id": "3720106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…哦！我想起来了。可是一般人不都叫它「风魔龙」吗。",
            "nextDialogs": [
              "3720107"
            ]
          },
          "3720107": {
            "id": "3720107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为什么你要这样称呼它…难道你们很熟吗？",
            "nextDialogs": [
              "3720108"
            ]
          },
          "3720108": {
            "id": "3720108",
            "speakerId": 1160,
            "speakerName": "绿色的家伙",
            "text": "你猜~",
            "nextDialogs": [
              "3720109"
            ]
          },
          "3720109": {
            "id": "3720109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#喂，{NICKNAME}，我感觉这个人怪怪的…"
          }
        }
      }
    },
    {
      "subId": "37202",
      "subQuestName": "聆听吟游诗人的弹奏",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3720201"
        ],
        "dialogs": {
          "3720201": {
            "id": "3720201",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "它也曾经是一个温柔的孩子，现在却变得这样悲伤，充满愤怒…",
            "nextDialogs": [
              "3720202"
            ]
          },
          "3720202": {
            "id": "3720202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "3720203"
            ]
          },
          "3720203": {
            "id": "3720203",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我这里也有一枚泪滴结晶。",
            "nextDialogs": [
              "3720204"
            ]
          },
          "3720204": {
            "id": "3720204",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "你能净化它吗？",
            "nextDialogs": [
              "3720205"
            ]
          },
          "3720205": {
            "id": "3720205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……（点头）"
          }
        }
      }
    },
    {

    {
      "subId": "37205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "3720501"
        ],
        "dialogs": {
          "3720501": {
            "id": "3720501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸——",
            "nextDialogs": [
              "3720502"
            ]
          },
          "3720502": {
            "id": "3720502",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "你，真的拥有不可思议的力量…",
            "nextDialogs": [
              "3720503"
            ]
          },
          "3720503": {
            "id": "3720503",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "像你这样的人，注定要登上吟游诗人们传唱的诗篇。",
            "nextDialogs": [
              "3720504"
            ]
          },
          "3720504": {
            "id": "3720504",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "站在向阳处必能成就英雄，站在背阴处亦可引导灾祸…",
            "nextDialogs": [
              "3720505"
            ]
          },
          "3720505": {
            "id": "3720505",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "啊…但我现在没有时间为你谱写新曲。",
            "nextDialogs": [
              "3720506"
            ]
          },
          "3720506": {
            "id": "3720506",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "特瓦林就算不被讨伐，生命力也会飞速流逝…",
            "nextDialogs": [
              "3720507"
            ]
          },
          "3720507": {
            "id": "3720507",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "他会在愤怒中把自己燃尽…",
            "nextDialogs": [
              "3720509",
              "3720512",
              "3720515"
            ]
          },
          "3720509": {
            "id": "3720509",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "谢谢你的心意，也谢谢你帮我净化泪滴结晶。",
            "nextDialogs": [
              "3720510"
            ]
          },
          "3720510": {
            "id": "3720510",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "接下来就是我行动的时间了。",
            "nextDialogs": [
              "3720517"
            ]
          },
          "3720517": {
            "id": "3720517",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯？你的计划是？",
            "nextDialogs": [
              "3720518"
            ]
          },
          "3720518": {
            "id": "3720518",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "看到龙的泪滴，我想起了一位故人…",
            "nextDialogs": [
              "3720519"
            ]
          },
          "3720519": {
            "id": "3720519",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "故人？",
            "nextDialogs": [
              "3720520"
            ]
          },
          "3720520": {
            "id": "3720520",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嘿嘿，那我就先失陪了。",
            "nextDialogs": [
              "3720521"
            ]
          },
          "3720521": {
            "id": "3720521",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，你要去哪里呀？",
            "nextDialogs": [
              "3720522"
            ]
          },
          "3720522": {
            "id": "3720522",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "——去「蒙德英雄的象征」。再见啦。",
            "nextDialogs": [
              "3720523"
            ]
          },
          "3720523": {
            "id": "3720523",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#唔…{NICKNAME}，你怎么看？",
            "nextDialogs": [
              "3720524"
            ]
          },
          "3720524": {
            "id": "3720524",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是个奇怪的人，需要观察一下。",
            "nextDialogs": [
              "3720525"
            ]
          },
          "3720525": {
            "id": "3720525",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对他来说，你也是奇怪的人呢。",
            "nextDialogs": [
              "3720526"
            ]
          },
          "3720526": {
            "id": "3720526",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "而且…",
            "nextDialogs": [
              "3720527"
            ]
          },
          "3720527": {
            "id": "3720527",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且？",
            "nextDialogs": [
              "3720528"
            ]
          },
          "3720528": {
            "id": "3720528",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "声音，有些熟悉…"
          },
          "3720512": {
            "id": "3720512",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "净化泪滴结晶已经是帮忙了，我很感激。",
            "nextDialogs": [
              "3720513"
            ]
          },
          "3720513": {
            "id": "3720513",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "但现在，我已经有了一个自己的计划。"
          },
          "3720515": {
            "id": "3720515",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哇，不要这么绝情嘛。",
            "nextDialogs": [
              "3720516"
            ]
          },
          "3720516": {
            "id": "3720516",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "自首就先不必了…我有另外的计划。"
          }
        }
      }
    }
  ]

  "subQuests": [
    {
      "subId": "7211104",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721110101"
        ],
        "dialogs": {
          "721110101": {
            "id": "721110101",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "有什么事吗？这位年轻人。",
            "nextDialogs": [
              "721110102"
            ]
          },
          "721110102": {
            "id": "721110102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们找到证据了。",
            "nextDialogs": [
              "721110103"
            ]
          },
          "721110103": {
            "id": "721110103",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "「证据」？什么证据，属实不知所谓。",
            "nextDialogs": [
              "721110104"
            ]
          },
          "721110104": {
            "id": "721110104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "关于村里的怪事，爷爷不要狡辩了。",
            "nextDialogs": [
              "721110105"
            ]
          },
          "721110105": {
            "id": "721110105",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "笑话，我们村哪能有什么怪事。好啊，有什么证据就拿出来吧。",
            "nextDialogs": [
              "721110106"
            ]
          },
          "721110106": {
            "id": "721110106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#（喂，{NICKNAME}，就从井边找到的东西开始吧。交给你啦！）",
            "nextDialogs": [
              "721110107"
            ]
          },
          "721110107": {
            "id": "721110107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是从后院枯井捡到的。"
          }
        }
      }
    },
    {
      "subId": "7211105",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721110201"
        ],
        "dialogs": {
          "721110201": {
            "id": "721110201",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "装摩拉的袋子？",
            "nextDialogs": [
              "721110202"
            ]
          },
          "721110202": {
            "id": "721110202",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "这…",
            "nextDialogs": [
              "721110203"
            ]
          },
          "721110203": {
            "id": "721110203",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "…这就是我们家的东西。没有什么可疑的。没错，很正常。",
            "nextDialogs": [
              "721110204"
            ]
          },
          "721110204": {
            "id": "721110204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好可疑！绝对有问题！",
            "nextDialogs": [
              "721110210",
              "721110207"
            ]
          },
          "721110210": {
            "id": "721110210",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "……",
            "nextDialogs": [
              "721110211"
            ]
          },
          "721110211": {
            "id": "721110211",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "好吧。这的确不是我的钱袋。",
            "nextDialogs": [
              "721110212"
            ]
          },
          "721110212": {
            "id": "721110212",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "我家后院人来人往的，有谁落下了什么东西也很正常。",
            "nextDialogs": [
              "721110213"
            ]
          },
          "721110213": {
            "id": "721110213",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "这是…",
            "nextDialogs": [
              "721110214"
            ]
          },
          "721110214": {
            "id": "721110214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是怎么回事？",
            "nextDialogs": [
              "721110215"
            ]
          },
          "721110215": {
            "id": "721110215",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "唉！还是你们机灵，本来我鬼迷心窍，想私吞你们手里的钱袋！",
            "nextDialogs": [
              "721110216"
            ]
          },
          "721110216": {
            "id": "721110216",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "一把年纪了，传助啊传助，怎么能动这种歪脑筋呢！"
          },
          "721110207": {
            "id": "721110207",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "哈哈哈，你这叫什么问题。",
            "nextDialogs": [
              "721110208"
            ]
          },
          "721110208": {
            "id": "721110208",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "不打开行囊确认，你也不知道现在自己的包里有多少摩拉吧？",
            "nextDialogs": [
              "721110209"
            ]
          },
          "721110209": {
            "id": "721110209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请你画出上面的标记。"
          }
        }
      }
    },
    {
      "subId": "7211106",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721110301"
        ],
        "dialogs": {
          "721110301": {
            "id": "721110301",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "这个是…咳，你又是从哪里捡到的？",
            "nextDialogs": [
              "721110303",
              "721110305"
            ]
          },
          "721110303": {
            "id": "721110303",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "……",
            "nextDialogs": [
              "721110306"
            ]
          },
          "721110306": {
            "id": "721110306",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "总之，你也没有证据证明 ，这两件东西之间有什么关联。",
            "nextDialogs": [
              "721110307"
            ]
          },
          "721110307": {
            "id": "721110307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "关联是有的。",
            "nextDialogs": [
              "721110308"
            ]
          },
          "721110308": {
            "id": "721110308",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "莫名其妙，这能有什么关联？",
            "nextDialogs": [
              "721110309"
            ]
          },
          "721110309": {
            "id": "721110309",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "摩拉上，难不成还能有什么暗号？",
            "nextDialogs": [
              "721110310"
            ]
          },
          "721110310": {
            "id": "721110310",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "摩拉上确实没有，但别的地方有。",
            "nextDialogs": [
              "721110311"
            ]
          },
          "721110311": {
            "id": "721110311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那就是我们在货车残骸附近找到的…"
          },
          "721110305": {
            "id": "721110305",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "这怎么可能…你这样试探我是没用的。"
          }
        }
      }
    },
    {
      "subId": "7211108",

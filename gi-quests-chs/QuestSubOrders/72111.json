            "speakerName": "Player",
            "text": "这是从后院枯井捡到的。"
          }
        }
      }
    },
    {
      "subId": "7211107",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721110701"
        ],
        "dialogs": {
          "721110701": {
            "id": "721110701",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "这是…这是…",
            "nextDialogs": [
              "721110702"
            ]
          },
          "721110702": {
            "id": "721110702",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "居然疏忽了，破坏货车的时候…",
            "nextDialogs": [
              "721110703"
            ]
          },
          "721110703": {
            "id": "721110703",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，承认了！",
            "nextDialogs": [
              "721110704"
            ]
          },
          "721110704": {
            "id": "721110704",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "没办法了，你都调查到这个份上了，我再瞒也瞒不下去。",
            "nextDialogs": [
              "721110705"
            ]
          },
          "721110705": {
            "id": "721110705",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "事情你差不多也清楚了吧。",
            "nextDialogs": [
              "721110706"
            ]
          },
          "721110706": {
            "id": "721110706",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "非常清楚了！传助爷爷，你竟然…",
            "nextDialogs": [
              "721110707"
            ]
          },
          "721110707": {
            "id": "721110707",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "抢劫了官府的镖车。在争抢中，你一拳把货车打碎，结果货物袋飞走了，掉进了水渠里。",
            "nextDialogs": [
              "721110708"
            ]
          },
          "721110708": {
            "id": "721110708",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "幕府的人为了保住性命，把钱袋往水井里丢，吸引你的注意力！为了防止钱被人捡走，你把井口锁起来了！",
            "nextDialogs": [
              "721110709"
            ]
          },
          "721110709": {
            "id": "721110709",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是这样对吧？",
            "nextDialogs": [
              "721110710"
            ]
          },
          "721110710": {
            "id": "721110710",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "啊？不对，不是这样的！",
            "nextDialogs": [
              "721110711"
            ]
          },
          "721110711": {
            "id": "721110711",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "居然不是吗！我还想跟你拿来钥匙，去把井底的摩拉…",
            "nextDialogs": [
              "721110712"
            ]
          },
          "721110712": {
            "id": "721110712",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…交还给幕府的大人们！没错！当然是还给官府！",
            "nextDialogs": [
              "721110713"
            ]
          },
          "721110713": {
            "id": "721110713",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "唉，事情是这样的…",
            "nextDialogs": [
              "721110714"
            ]
          },
          "721110714": {
            "id": "721110714",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "村里本来有一群年轻人，酒后胆子大，竟然劫了幕府的运车。这货物和袋子，都是幕府的东西。",
            "nextDialogs": [
              "721110715"
            ]
          },
          "721110715": {
            "id": "721110715",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "我想着村丑不可外扬，才出力帮他们隐瞒下来。",
            "nextDialogs": [
              "721110716"
            ]
          },
          "721110716": {
            "id": "721110716",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那承认自己私吞钱袋的事情…",
            "nextDialogs": [
              "721110717"
            ]
          },
          "721110717": {
            "id": "721110717",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是为了隐瞒事情的真相吧。",
            "nextDialogs": [
              "721110718"
            ]
          },
          "721110718": {
            "id": "721110718",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "没错。本来我寻思，只要我这么做，你们就会不追究下去…",
            "nextDialogs": [
              "721110719"
            ]
          },
          "721110719": {
            "id": "721110719",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "如果只有我一个人的话…只要不波及别人…",
            "nextDialogs": [
              "721110720"
            ]
          },
          "721110720": {
            "id": "721110720",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "拜托了，请你不要向幕府告发。这不是我面子的问题。我是怕我们整个村子，都会因此受到牵连。",
            "nextDialogs": [
              "721110722",
              "721110725"
            ]
          },
          "721110722": {
            "id": "721110722",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是呀，我们不是为了这件事来的。",
            "nextDialogs": [
              "721110723"
            ]
          },
          "721110723": {
            "id": "721110723",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "那就好，那就好。",
            "nextDialogs": [
              "721110727"
            ]
          },
          "721110727": {
            "id": "721110727",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "因为做这样的事情，让我良心实在不安，所以我把事情记下来了。",
            "nextDialogs": [
              "721110728"
            ]
          },
          "721110728": {
            "id": "721110728",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "笔记我扔房顶上了。如果你真想读，就自己去找吧，年轻人。不过，可别把我最近才新修的房顶踩坏喽。",
            "nextDialogs": [
              "721110729"
            ]
          },
          "721110729": {
            "id": "721110729",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于井口的锁…",
            "nextDialogs": [
              "721110730"
            ]
          },
          "721110730": {
            "id": "721110730",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "是的，是我把井口锁上了。藏钥匙的地方，我也记在笔记里了，自己去看吧。",
            "nextDialogs": [
              "721110731"
            ]
          },
          "721110731": {
            "id": "721110731",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "关于绀田村的「结界」，传助爷爷知道什么吗？",
            "nextDialogs": [
              "721110732"
            ]
          },
          "721110732": {
            "id": "721110732",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "「结界」？哎呀，这么久远的传说，现在还有人知道吗…",
            "nextDialogs": [
              "721110733"
            ]
          },
          "721110733": {
            "id": "721110733",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "据说在古时，我们脚下的地底有雷樱的根，是守护鸣神岛平安的五段树根之一。",
            "nextDialogs": [
              "721110734"
            ]
          },
          "721110734": {
            "id": "721110734",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "而守护它与它的结界，就是「狐斋宫大人」交给我们绀田一族的职责。",
            "nextDialogs": [
              "721110735"
            ]
          },
          "721110735": {
            "id": "721110735",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "但这事已经太久远了，详情我已经不清楚啦。"
          },
          "721110725": {
            "id": "721110725",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是呀，我们不是为了这件事来的。",
            "nextDialogs": [
              "721110726"
            ]
          },
          "721110726": {
            "id": "721110726",
            "speakerId": 1000,
            "speakerName": "绀田传助",
            "text": "调查真相？呵呵…现在的年轻人，倒也挺有趣的。"
          }
        }
      }
    },
    {

  "subQuests": [
    {
      "subId": "7335401",
      "subQuestName": "与为难的两人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "733540101"
        ],
        "dialogs": {
          "733540101": {
            "id": "733540101",
            "speakerId": 30657,
            "speakerName": "毗伽尔",
            "text": "灯光的色调和强度恰到好处，特效也相当华丽，综合表现的效果堪称完美。",
            "nextDialogs": [
              "733540102"
            ]
          },
          "733540102": {
            "id": "733540102",
            "speakerId": 30657,
            "speakerName": "毗伽尔",
            "text": "太棒了，萨费伊，多亏了你，我们才能将花之骑士传说中的英姿重现。",
            "nextDialogs": [
              "733540103"
            ]
          },
          "733540103": {
            "id": "733540103",
            "speakerId": 30658,
            "speakerName": "萨费伊",
            "text": "哎呀呀，又不是我一个人的功劳，你跑前跑后，比我这个只管书面工作的文职累多了。",
            "nextDialogs": [
              "733540104"
            ]
          },
          "733540104": {
            "id": "733540104",
            "speakerId": 30658,
            "speakerName": "萨费伊",
            "text": "现在最重要的问题是花之骑士的人选…需要演员拥有非凡身手，气质又与传说中的法里斯相似，条件似乎有些苛刻？",
            "nextDialogs": [
              "733540107"
            ]
          },
          "733540107": {
            "id": "733540107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "灯光？特效？你们在为演出的事发愁吗？",
            "nextDialogs": [
              "733540108"
            ]
          },
          "733540108": {
            "id": "733540108",
            "speakerId": 30658,
            "speakerName": "萨费伊",
            "text": "出现了！绝无仅有的大英雄，花之骑士扮演者的无上人选…",
            "nextDialogs": [
              "733540109"
            ]
          },
          "733540109": {
            "id": "733540109",
            "speakerId": 30658,
            "speakerName": "萨费伊",
            "text": "不，应该说您就是当之无愧的花之骑士本尊！",
            "nextDialogs": [
              "733540110"
            ]
          },
          "733540110": {
            "id": "733540110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#噫，这个学者好激动！一看到{NICKNAME}，都眼里放光了…"
          }
        }
      }
    }
  ]
}
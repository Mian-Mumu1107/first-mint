    {
      "subId": "7620503",
      "subQuestName": "与尼可对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762050301"
        ],
        "dialogs": {
          "762050301": {
            "id": "762050301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "拿到啦！太好了！",
            "nextDialogs": [
              "762050302"
            ]
          },
          "762050302": {
            "id": "762050302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "虽然…虽然现在脑袋还在嗡嗡响，为了搭梯子，她说话的时候好像格外用力…",
            "nextDialogs": [
              "762050303"
            ]
          },
          "762050303": {
            "id": "762050303",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "嗯？揭短？你不担心我这位强大的魔女动动手指，把宝箱里的东西全变成胡萝卜吗？",
            "nextDialogs": [
              "762050306"
            ]
          },
          "762050306": {
            "id": "762050306",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "哼哼，当然咯，我怎么会是把日常琐事事无巨细记在脑袋里的沉默天使呢？",
            "nextDialogs": [
              "762050307"
            ]
          },
          "762050307": {
            "id": "762050307",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "#——于是到了那天，{NICKNAME}和派蒙踏上七重阶梯，等待在{M#他们}{F#她们}面前的却是一个熟悉的背影。",
            "nextDialogs": [
              "762050308"
            ]
          },
          "762050308": {
            "id": "762050308",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "光焰汇成了她后背的羽翼，她的身姿依旧如初见时高贵和美丽，但那双眼睛却流露出残酷的光芒。",
            "nextDialogs": [
              "762050309"
            ]
          },
          "762050309": {
            "id": "762050309",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "#「为什么？」{NICKNAME}和派蒙同时发问。",
            "nextDialogs": [
              "762050310"
            ]
          },
          "762050310": {
            "id": "762050310",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "「具体就要从派蒙那天抱怨我说话用力时说起了。」",
            "nextDialogs": [
              "762050311"
            ]
          },
          "762050311": {
            "id": "762050311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "语言是有魔法的，不要说那么可怕的话啊！"
          }
        }
      }
    },
    {

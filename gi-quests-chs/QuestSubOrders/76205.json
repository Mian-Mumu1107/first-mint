    {
      "subId": "7620501",
      "subQuestName": "与尼可对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762050101"
        ],
        "dialogs": {
          "762050101": {
            "id": "762050101",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "#怎么办…这要怎么办…算算时间{M#他们}{F#她们}就快来了…",
            "nextDialogs": [
              "762050102"
            ]
          },
          "762050102": {
            "id": "762050102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们来啦！哎哎尼可，别把我们推出去呀！",
            "nextDialogs": [
              "762050103"
            ]
          },
          "762050103": {
            "id": "762050103",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "咳咳…不好意思…",
            "nextDialogs": [
              "762050104"
            ]
          },
          "762050104": {
            "id": "762050104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是还没准备好吗？",
            "nextDialogs": [
              "762050105"
            ]
          },
          "762050105": {
            "id": "762050105",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "该怎么解释呢…不行，说不清楚，只好从头说明了。",
            "nextDialogs": [
              "762050106"
            ]
          },
          "762050106": {
            "id": "762050106",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "——具体就要从魔女们第一次挑战风神时说起了。",
            "nextDialogs": [
              "762050107"
            ]
          },
          "762050107": {
            "id": "762050107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这也太早了吧！",
            "nextDialogs": [
              "762050108"
            ]
          },
          "762050108": {
            "id": "762050108",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "唔，太过分了，要我亲口说出来真的好丢人…算了，没办法了，事实就是事实…只要艾莉丝不知道的话应该不会被取笑…",
            "nextDialogs": [
              "762050109"
            ]
          },
          "762050109": {
            "id": "762050109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "她心里面想的话好像又漏出来了，而且，她也没办法亲「口」…",
            "nextDialogs": [
              "762050110"
            ]
          },
          "762050110": {
            "id": "762050110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "嘘。",
            "nextDialogs": [
              "762050111"
            ]
          },
          "762050111": {
            "id": "762050111",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "我临时把羽毛藏去了书房最高的地方，想着增加难度的话，完成挑战的成就感也会变强…",
            "nextDialogs": [
              "762050112"
            ]
          },
          "762050112": {
            "id": "762050112",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "但我实在不擅长控制那些随性的风，好像到了一定高度之后，无论如何都飞不上去了。",
            "nextDialogs": [
              "762050113"
            ]
          },
          "762050113": {
            "id": "762050113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不能用魔法把羽毛重新挪下来吗？",
            "nextDialogs": [
              "762050114"
            ]
          },
          "762050114": {
            "id": "762050114",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "那就没有游玩的意义了啊！",
            "nextDialogs": [
              "762050115"
            ]
          },
          "762050115": {
            "id": "762050115",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好吧，也对…那还真是个死局…",
            "nextDialogs": [
              "762050116"
            ]
          },
          "762050116": {
            "id": "762050116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "尼可，能再说一句话吗？",
            "nextDialogs": [
              "762050117"
            ]
          },
          "762050117": {
            "id": "762050117",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "什么话？",
            "nextDialogs": [
              "762050120"
            ]
          },
          "762050120": {
            "id": "762050120",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "啊！我明白了——！让我们试试吧！",
            "nextDialogs": [
              "762050121"
            ]
          },
          "762050121": {
            "id": "762050121",
            "speakerId": 1002,
            "speakerName": "<UNKNOWN>",
            "text": "唔，太过分了，要我亲口说出来真的好丢人…",
            "nextDialogs": [
              "762050122"
            ]
          },
          "762050122": {
            "id": "762050122",
            "speakerId": 1002,
            "speakerName": "<UNKNOWN>",
            "text": "算了，没办法了，事实就是事实…",
            "nextDialogs": [
              "762050123"
            ]
          },
          "762050123": {
            "id": "762050123",
            "speakerId": 1002,
            "speakerName": "<UNKNOWN>",
            "text": "只要艾莉丝不知道的话应该不会被取笑…"
          }
        }
      }
    },
    {
      "subId": "7620505",
      "subQuestName": "继续前进",
      "sceneId": null,

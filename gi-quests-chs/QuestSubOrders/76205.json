        "dialogs": {
          "762050201": {
            "id": "762050201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好长一段间隔！",
            "nextDialogs": [
              "762050202"
            ]
          },
          "762050202": {
            "id": "762050202",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "万象为引，圣名注经。词章交织，诸使齐行。在此圣殿，以言语铸汝前路之阶。",
            "nextDialogs": [
              "762050203"
            ]
          },
          "762050203": {
            "id": "762050203",
            "speakerId": 1003,
            "speakerName": "语言的阶梯",
            "text": "叮——",
            "nextDialogs": [
              "762050204"
            ]
          },
          "762050204": {
            "id": "762050204",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "看，搞定了。",
            "nextDialogs": [
              "762050205"
            ]
          },
          "762050205": {
            "id": "762050205",
            "speakerId": 1002,
            "speakerName": "<UNKNOWN>",
            "text": "万象为引，圣名注经。",
            "nextDialogs": [

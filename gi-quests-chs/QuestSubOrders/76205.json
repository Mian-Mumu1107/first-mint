            "speakerName": "派蒙",
            "text": "尼可！前面没路啦。",
            "nextDialogs": [
              "762050502"
            ]
          },
          "762050502": {
            "id": "762050502",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "交给我。",
            "nextDialogs": [
              "762050503"
            ]
          },
          "762050503": {
            "id": "762050503",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "噢噢噢真的可以！多说几句！",
            "nextDialogs": [
              "762050504"
            ]
          },
          "762050504": {
            "id": "762050504",
            "speakerId": 1322,
            "speakerName": "尼可",
            "text": "交给我交给我交给我！",
            "nextDialogs": [
              "762050505"
            ]
          },
          "762050505": {
            "id": "762050505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈，只是重复啊…"
          }
        }

    "行秋": 4,
    "阿贝多": 15
  },
  "subQuests": [
    {
      "subId": "4005801",
      "subQuestName": "等到第二天中午（12~14时）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400580101"
        ],
        "dialogs": {
          "400580101": {
            "id": "400580101",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "你们来了，这样人就都到齐了。",
            "nextDialogs": [
              "400580102"
            ]
          },
          "400580102": {
            "id": "400580102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "万叶，你调查得怎么样？",
            "nextDialogs": [
              "400580103"
            ]
          },
          "400580103": {
            "id": "400580103",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "昨天晚上，我拜访了曾在我家工作的一位老仆人，从他那里知道了当年整个事情的始末。",
            "nextDialogs": [
              "400580104"
            ]
          },
          "400580104": {
            "id": "400580104",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "「一心传」在我曾祖父那一代，曾经奉命依照一份古老的锻造图谱，制作一把重要的御神刀。",
            "nextDialogs": [
              "400580105"
            ]
          },
          "400580105": {
            "id": "400580105",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "虽然参与锻刀的都是很有经验的匠人，可过程却一直很不顺利，做出的刀全都是残次品。",
            "nextDialogs": [
              "400580106"
            ]
          },
          "400580106": {
            "id": "400580106",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "眼看到了最后期限，刀却依旧无法锻好，负责的刀匠们因此畏罪潜逃了。",
            "nextDialogs": [
              "400580107"
            ]
          },
          "400580107": {
            "id": "400580107",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "枫原家与社奉行展开了调查，曾祖父与神里家家主总算在海边追上了那些匠人。",
            "nextDialogs": [
              "400580108"
            ]
          },
          "400580108": {
            "id": "400580108",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "然而他们却遭到了对方的激烈抵抗，最终，没能阻止叛逃者们乘船离开。",
            "nextDialogs": [
              "400580109"
            ]
          },
          "400580109": {
            "id": "400580109",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "枫原家由于门下刀匠叛逃而受到重罚，从此便一蹶不振了。",
            "nextDialogs": [
              "400580110"
            ]
          },
          "400580110": {
            "id": "400580110",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "不仅如此，我听说神里家家主也被叛逃者所伤，再加上年事已高，不久后就过世了。",
            "nextDialogs": [
              "400580111"
            ]
          },
          "400580111": {
            "id": "400580111",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "是的…因为家主过世得突然，神里家一时群龙无首，又有奸人趁机作梗，在社奉行的地位也变得岌岌可危。",
            "nextDialogs": [
              "400580112"
            ]
          },
          "400580112": {
            "id": "400580112",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "此事影响深远，直至家主之位传到我父亲手上，神里家也依旧没能恢复当初的名望。",
            "nextDialogs": [
              "400580113"
            ]
          },
          "400580113": {
            "id": "400580113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来是这样…",
            "nextDialogs": [
              "400580114"
            ]
          },
          "400580114": {
            "id": "400580114",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "不过幸亏有兄长在，现在一切总算是好了起来。",
            "nextDialogs": [
              "400580115"
            ]
          },
          "400580115": {
            "id": "400580115",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "当年的锻刀失败，最终被归因为「技艺不精」，枫原家和社奉行也一直是这么认为的。",
            "nextDialogs": [
              "400580116"
            ]
          },
          "400580116": {
            "id": "400580116",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "但五歌仙的故事却似乎在暗示，失败并非因为技艺，而是因为那份图谱被人篡改过。",
            "nextDialogs": [
              "400580117"
            ]
          },
          "400580117": {
            "id": "400580117",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "神里小姐，我昨天听说，当年锻刀失败后，那份图谱就一直保存在社奉行。",
            "nextDialogs": [
              "400580118"
            ]
          },
          "400580118": {
            "id": "400580118",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "不知道你是否愿意帮这个忙？",
            "nextDialogs": [
              "400580119"
            ]
          },
          "400580119": {
            "id": "400580119",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "我明白了，既然这样我先回去寻找图谱，大家稍后到神里屋敷与我汇合即可。"
          }
        }
      }
    },
    {
      "subId": "4005802",
      "subQuestName": "前往五歌仙广场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400580201"
        ],
        "dialogs": {
          "400580201": {
            "id": "400580201",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "各位，当年那份图谱我已经找到了。",
            "nextDialogs": [
              "400580202"
            ]
          },
          "400580202": {
            "id": "400580202",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯，虽然图谱保存得不错，不过看样子至少有三四百年历史了。",
            "nextDialogs": [
              "400580203"
            ]
          },
          "400580203": {
            "id": "400580203",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这么古老的图谱，还能够找出被篡改过的证据吗？",
            "nextDialogs": [
              "400580204"
            ]
          },
          "400580204": {
            "id": "400580204",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "事到如今，我们也只能碰碰运气了。",
            "nextDialogs": [
              "400580205"
            ]
          },
          "400580205": {
            "id": "400580205",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "把锻造图谱浸入了水盆中，几分钟后…",
            "nextDialogs": [
              "400580206"
            ]
          },
          "400580206": {
            "id": "400580206",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "虽然效果不太明显，但能看出有一些字变得模糊了。",
            "nextDialogs": [
              "400580207"
            ]
          },
          "400580207": {
            "id": "400580207",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "万叶，这份图谱的确被篡改过，当年有人陷害了枫原家。",
            "nextDialogs": [
              "400580208"
            ]
          },
          "400580208": {
            "id": "400580208",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "呼…不知道现在发现这个秘密，会不会已经太晚了。",
            "nextDialogs": [
              "400580209"
            ]
          },
          "400580209": {
            "id": "400580209",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "其实，我爷爷年轻时多次对曾祖父提出要重振「一心传」，结果却被曾祖父大骂不自量力。",
            "nextDialogs": [
              "400580210"
            ]
          },
          "400580210": {
            "id": "400580210",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "昨天那位老仆人说，曾祖父甚至还到社奉行，请神里家主把这份图谱拿给爷爷看，让他带手下锻成这把刀再说。",
            "nextDialogs": [
              "400580211"
            ]
          },
          "400580211": {
            "id": "400580211",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "毫无疑问爷爷也失败了，于是曾祖父便说：「你找不出其中的秘密，一心传在世上消失也是活该。」",
            "nextDialogs": [
              "400580212"
            ]
          },
          "400580212": {
            "id": "400580212",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "听了这些话，爷爷一气之下便离开了稻妻，结果就连曾祖父的最后一面都没有见到。",
            "nextDialogs": [
              "400580213"
            ]
          },
          "400580213": {
            "id": "400580213",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "现在看来，他们父子二人的争执，其实根本就没有意义。",
            "nextDialogs": [
              "400580214"
            ]
          },
          "400580214": {
            "id": "400580214",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "万叶…",
            "nextDialogs": [
              "400580215"
            ]
          },
          "400580215": {
            "id": "400580215",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "我听说你曾祖父枫原义庆年轻时十分勤勉，可后来却不再过问锻造技艺。看来，当年的失败对他打击很大。",
            "nextDialogs": [
              "400580216"
            ]
          },
          "400580216": {
            "id": "400580216",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "万叶，你曾祖父当年所说的话，真的是「你找不出其中的秘密」？",
            "nextDialogs": [
              "400580217"
            ]
          },
          "400580217": {
            "id": "400580217",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "对，那位老仆人说，那些话都是他亲耳听见，记得很清楚。",
            "nextDialogs": [
              "400580218"
            ]
          },
          "400580218": {
            "id": "400580218",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "当时我爷爷还一气之下，把曾祖父珍爱的盆栽摔坏了…",
            "nextDialogs": [
              "400580219"
            ]
          },
          "400580219": {
            "id": "400580219",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿贝多，你难道是想说…",
            "nextDialogs": [
              "400580220"
            ]
          },
          "400580220": {
            "id": "400580220",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "#{NICKNAME}，看来你已经明白了我的意思。",
            "nextDialogs": [
              "400580221"
            ]
          },
          "400580221": {
            "id": "400580221",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "万叶，如果你的曾祖父认为是一心传技艺不精，看到儿子失败，应该会说「你能力不够」这样的话吧？",
            "nextDialogs": [
              "400580222"
            ]
          },
          "400580222": {
            "id": "400580222",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "但他说的却是「你找不出其中的秘密」，这不是很奇怪吗？",
            "nextDialogs": [
              "400580223"
            ]
          },
          "400580223": {
            "id": "400580223",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "…啊！",
            "nextDialogs": [
              "400580224"
            ]
          },
          "400580224": {
            "id": "400580224",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "所以，你的意思是…我曾祖父或许早就知道，失败是因为有人从中作梗？",
            "nextDialogs": [
              "400580225"
            ]
          },
          "400580225": {
            "id": "400580225",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "现有的证据显示，这种可能性很大。",
            "nextDialogs": [
              "400580226"
            ]
          },
          "400580226": {
            "id": "400580226",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "不知道各位能否跟我去一趟天领奉行？",
            "nextDialogs": [
              "400580227"
            ]
          },
          "400580227": {
            "id": "400580227",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "我之前被通缉后，家里最后剩下的那间古屋被天领奉行查抄了，那里面存放的都是我家的旧物。",
            "nextDialogs": [
              "400580228"
            ]
          },
          "400580228": {
            "id": "400580228",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "我想去询问一下那些东西的去向，如果能找到的话，说不定能发现什么线索。",
            "nextDialogs": [
              "400580229"
            ]
          },
          "400580229": {
            "id": "400580229",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们马上出发吧。"
          }
        }
      }
    },
    {
      "subId": "4005803",
      "subQuestName": "与万叶对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {

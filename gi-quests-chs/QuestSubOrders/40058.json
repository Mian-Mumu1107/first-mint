      }
    },
    {
      "subId": "4005804",
      "subQuestName": "前往神里屋敷",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400580401"
        ],
        "dialogs": {
          "400580401": {
            "id": "400580401",
            "speakerId": 30141,
            "speakerName": "浅川",
            "text": "几位是来调查枫原家物品的吧，九条大人已经吩咐过了，请随我来。"
          }
        }
      }
    },
    {
      "subId": "4005805",
      "subQuestName": "与绫华对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4005806",
      "subQuestName": "前往天领奉行府",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400580601"
        ],
        "dialogs": {
          "400580601": {
            "id": "400580601",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "这个花盆在我家已经有很长时间了，听说是曾祖父留下的。",
            "nextDialogs": [
              "400580602"
            ]
          },
          "400580602": {
            "id": "400580602",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "里面的植物看起来已经枯死很长时间了。",
            "nextDialogs": [
              "400580603"
            ]
          },
          "400580603": {
            "id": "400580603",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "嗯，曾祖父不再钻研锻刀技艺后，就有了养盆栽的爱好，不过他的珍藏，大多都在重病时送给了别人。",
            "nextDialogs": [
              "400580604"
            ]
          },
          "400580604": {
            "id": "400580604",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "但当时，他却唯独留下了这盆已死的植物，还留下遗言，不允许爷爷丢弃。",
            "nextDialogs": [
              "400580605"
            ]
          },
          "400580605": {
            "id": "400580605",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "爷爷因为懊悔他们父子未能和解，所以也一直原封不动地保留着它。",
            "nextDialogs": [
              "400580606"
            ]
          },
          "400580606": {
            "id": "400580606",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "不过现在想想，曾祖父专门留下它，或许另有用意。",
            "nextDialogs": [
              "400580607"
            ]
          },
          "400580607": {
            "id": "400580607",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听你这么一说，这个花盆果然有些可疑。",
            "nextDialogs": [
              "400580608"
            ]
          },
          "400580608": {
            "id": "400580608",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "嗯，我们来仔细调查一下吧。",
            "nextDialogs": [
              "400580609"
            ]
          },
          "400580609": {
            "id": "400580609",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "在花盆底部发现了一个夹层…",
            "nextDialogs": [
              "400580610"
            ]
          },
          "400580610": {
            "id": "400580610",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "找到啦！不过怎么只有几张白纸呢？",
            "nextDialogs": [
              "400580611"
            ]
          },
          "400580611": {
            "id": "400580611",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "该不会是有人已经发现了这里面的东西，把它们替换掉了吧？",
            "nextDialogs": [
              "400580612"
            ]
          },
          "400580612": {
            "id": "400580612",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我觉得并不是这样，你看，这些纸都已经发黄，肯定有些年头了。",
            "nextDialogs": [
              "400580613"
            ]
          },
          "400580613": {
            "id": "400580613",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许又要用到水了。",
            "nextDialogs": [
              "400580614"
            ]
          },
          "400580614": {
            "id": "400580614",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "你是说这些纸和神里小姐之前拿到的那张一样，上面的文字是用特殊的墨水写成的？",
            "nextDialogs": [
              "400580615"
            ]
          },
          "400580615": {
            "id": "400580615",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "#我和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的看法一致。",
            "nextDialogs": [
              "400580616"
            ]
          },
          "400580616": {
            "id": "400580616",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们赶快试试吧！",
            "nextDialogs": [
              "400580617"
            ]
          },
          "400580617": {
            "id": "400580617",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "奉行所外面就有水池，我去那里把这些纸沾湿。"
          }
        }
      }
    },
    {
      "subId": "4005807",
      "subQuestName": "与九条裟罗对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400580301"
        ],
        "dialogs": {
          "400580301": {
            "id": "400580301",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "你们怎么来了，难道是离岛那边发生什么事了？",
            "nextDialogs": [
              "400580304"
            ]
          },
          "400580304": {
            "id": "400580304",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "九条裟罗，不知道你是否还记得我。",
            "nextDialogs": [
              "400580305"
            ]
          },
          "400580305": {
            "id": "400580305",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "我记得，你是枫原万叶。在眼狩令期间你曾经作为要犯被通缉，不过现在那份通缉令已经撤销了。",
            "nextDialogs": [
              "400580306"
            ]
          },
          "400580306": {
            "id": "400580306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "裟罗，我们想问问你，万叶家当时被天领奉行查抄后，里面的东西现在还能找到吗？",
            "nextDialogs": [
              "400580307"
            ]
          },
          "400580307": {
            "id": "400580307",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "当时查抄所得的物品现在被收在奉行所旁边的仓库里，既然枫原现在已经回到稻妻，那些东西也理应物归原主。",
            "nextDialogs": [
              "400580308"
            ]
          },
          "400580308": {
            "id": "400580308",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "不，你误会了，我这次来并不是为了讨要物品，只是因为一些私事，想要调查一下那些东西。",
            "nextDialogs": [
              "400580309"
            ]
          },
          "400580309": {
            "id": "400580309",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "我明白了，我会告知奉行所，让他们领你们进入仓库。",
            "nextDialogs": [
              "400580310"
            ]
          },
          "400580310": {
            "id": "400580310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谢谢你，裟罗！",
            "nextDialogs": [
              "400580311"
            ]
          },
          "400580311": {
            "id": "400580311",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "枫原，关于眼狩令那时…",
            "nextDialogs": [
              "400580312"
            ]
          },
          "400580312": {
            "id": "400580312",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "九条裟罗，那些事情已经过去，就不必再提了，我知道你也有自己的信念与苦衷。",
            "nextDialogs": [
              "400580313"
            ]
          },
          "400580313": {
            "id": "400580313",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "……",
            "nextDialogs": [
              "400580314"
            ]
          },
          "400580314": {
            "id": "400580314",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "不知道现在能否拜托你一件事？",
            "nextDialogs": [
              "400580315"
            ]
          },
          "400580315": {
            "id": "400580315",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "请讲。",
            "nextDialogs": [
              "400580316"
            ]
          },
          "400580316": {
            "id": "400580316",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "现在的我，并没有继续回稻妻生活的打算，家里那些东西对于我也没什么用处。",
            "nextDialogs": [
              "400580317"
            ]
          },
          "400580317": {
            "id": "400580317",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "九条，我相信你的正直，等我们调查过后，我想请你代我处理那些物品。就把它们变卖了，用所得的钱救济穷苦的百姓吧。",
            "nextDialogs": [
              "400580318"
            ]
          },
          "400580318": {
            "id": "400580318",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "好的，我会妥善处置，请你放心。"
          }
        }
      }
    },
    {
      "subId": "4005808",
      "subQuestName": "前往奉行所仓库",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4005809",
      "subQuestName": "进入奉行所仓库",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400580901"
        ],
        "dialogs": {
          "400580901": {
            "id": "400580901",
            "speakerId": 30144,
            "speakerName": "枫原义庆",
            "text": "…是夜，我等循着线索来到岸边时，未见任何刀匠踪影，却仅有一名倾奇者现身。",
            "nextDialogs": [
              "400580902"
            ]
          },
          "400580902": {
            "id": "400580902",
            "speakerId": 30144,
            "speakerName": "枫原义庆",
            "text": "倾奇者自居幕后主使，声称已等候我等多时，扬言绝灭雷电五传。",
            "nextDialogs": [
              "400580903"
            ]
          },
          "400580903": {
            "id": "400580903",
            "speakerId": 30144,
            "speakerName": "枫原义庆",
            "text": "此人身手远非常人能敌，仅须臾之间，我等随行武士便被尽数击倒。",
            "nextDialogs": [
              "400580904"
            ]
          },
          "400580904": {
            "id": "400580904",
            "speakerId": 30144,
            "speakerName": "枫原义庆",
            "text": "神里大人身受重伤，吾则因为被劈中了头顶斗笠，才侥幸逃过一死。",
            "nextDialogs": [
              "400580905"
            ]
          },
          "400580905": {
            "id": "400580905",
            "speakerId": 30144,
            "speakerName": "枫原义庆",
            "text": "倾奇者再有一击便可取吾性命，但见吾长相，却不再攻击，而是厉声逼问吾与「丹羽」有何瓜葛。",
            "nextDialogs": [
              "400580906"
            ]
          },
          "400580906": {
            "id": "400580906",
            "speakerId": 30144,
            "speakerName": "枫原义庆",
            "text": "吾只得作答此为家父旧姓，家父失踪后，吾便被枫原主家收养。",
            "nextDialogs": [
              "400580907"
            ]
          },
          "400580907": {
            "id": "400580907",
            "speakerId": 30144,
            "speakerName": "枫原义庆",
            "text": "倾奇者听后不再言语。沉默许久，忽道：「告知她，吾名『国崩』。」随即转身离去…"
          }
        }
      }
    },
    {
      "subId": "4005810",
      "subQuestName": "调查枫原家的旧物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400580501"
        ],
        "dialogs": {
          "400580501": {
            "id": "400580501",
            "speakerId": 30141,
            "speakerName": "浅川",
            "text": "枫原家的物品都被放在这间仓库中，只是为了节省空间，东西摆放得有些分散，实在不好意思。",
            "nextDialogs": [
              "400580502"
            ]
          },
          "400580502": {
            "id": "400580502",
            "speakerId": 30141,
            "speakerName": "浅川",
            "text": "不过相应的物品上我都做好了标记，应该不会太难找。",
            "nextDialogs": [
              "400580503"
            ]
          },
          "400580503": {
            "id": "400580503",
            "speakerId": 30141,
            "speakerName": "浅川",
            "text": "我就在门口等待各位，如果需要帮助请来找我。",
            "nextDialogs": [
              "400580504"
            ]
          },
          "400580504": {
            "id": "400580504",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "万叶，既然东西放得很分散，我们分头寻找线索如何？",
            "nextDialogs": [
              "400580505"
            ]
          },
          "400580505": {
            "id": "400580505",
            "speakerId": 1032,
            "speakerName": "枫原万叶",
            "text": "也好，那就拜托各位了。"
          }
        }
      }
    },
    {
      "subId": "4005811",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400585701"
        ],
        "dialogs": {
          "400585701": {
            "id": "400585701",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯，有没有呢…",
            "nextDialogs": [
              "400585702"
            ]
          },
          "400585702": {
            "id": "400585702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "温迪，你在找什么？",
            "nextDialogs": [
              "400585703"
            ]
          },
          "400585703": {
            "id": "400585703",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "你看，这里有这么多罐子，肯定会有一两个装酒的吧？",
            "nextDialogs": [
              "400585704"
            ]
          },
          "400585704": {
            "id": "400585704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！其他人都在帮忙，你竟然还在找酒喝？",
            "nextDialogs": [
              "400585705"
            ]
          },
          "400585705": {
            "id": "400585705",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哈哈哈，开个玩笑。我们已经快要找到真相了，为什么你们看起来却顾虑重重的？",
            "nextDialogs": [
              "400585706"
            ]
          },
          "400585706": {
            "id": "400585706",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "因为我不是很明白，万叶为什么今天就跟裟罗说要把这些东西处理掉？",
            "nextDialogs": [
              "400585707"
            ]
          },
          "400585707": {
            "id": "400585707",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "万一我们今天什么都没有找到…我是说万一！万叶今后不就再也没有机会寻找当年的真相了吗？",
            "nextDialogs": [
              "400585708"
            ]
          },
          "400585708": {
            "id": "400585708",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "我知道你们很担心万叶，但我觉得，他比你们想象中要坚强。",
            "nextDialogs": [
              "400585709"
            ]
          },
          "400585709": {
            "id": "400585709",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "万叶既然这样做了，就说明他已经做好了准备——无论我们今天能否找到答案，无论答案是什么，他都会坦然接受。",
            "nextDialogs": [
              "400585710"
            ]
          },
          "400585710": {
            "id": "400585710",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是你身为神的直觉吗？",
            "nextDialogs": [
              "400585711"
            ]
          },
          "400585711": {
            "id": "400585711",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "与其说是直觉，不如说是因为活得比较久，所以总结出了一些识人的经验。",
            "nextDialogs": [
              "400585712"
            ]
          },
          "400585712": {
            "id": "400585712",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "这边就交给我，你们去其他地方搜查吧。"
          }
        }
      }
    },
    {
      "subId": "4005812",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400585201"
        ],
        "dialogs": {
          "400585201": {
            "id": "400585201",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "嗯…",
            "nextDialogs": [
              "400585202"
            ]
          },
          "400585202": {
            "id": "400585202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "绫华，情况怎么样？",
            "nextDialogs": [
              "400585203"
            ]
          },
          "400585203": {
            "id": "400585203",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "#{NICKNAME}，是你啊，我正在调查这具刀座。",
            "nextDialogs": [
              "400585204"
            ]
          },
          "400585204": {
            "id": "400585204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "枫原家既然是锻刀名家，这把刀应该会很值钱吧？比如说是「一心传」的杰作什么的？",
            "nextDialogs": [
              "400585205"
            ]
          },
          "400585205": {
            "id": "400585205",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "不，刀座虽然是上好的木料，但摆在上面的却是一把很普通的刀。按照枫原家最后的经济状况，值钱的收藏肯定已经拿去变卖了。",
            "nextDialogs": [
              "400585206"
            ]
          },
          "400585206": {
            "id": "400585206",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "这把刀没有开刃，但刀柄上倒有不少使用痕迹，说不定是枫原小时候学习剑术的时候用的。",
            "nextDialogs": [
              "400585207"
            ]
          },
          "400585207": {
            "id": "400585207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "让我看看…啊，刀鞘上好像刻有一些歪歪扭扭的字！「万」…「叶」，哈，真的是万叶小时候用过的刀。",
            "nextDialogs": [
              "400585208"
            ]
          },
          "400585208": {
            "id": "400585208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像都能想象出万叶小时候的样子了呢。",
            "nextDialogs": [
              "400585209"
            ]
          },
          "400585209": {
            "id": "400585209",
            "speakerId": 1013,
            "speakerName": "神里绫华",
            "text": "我再在附近调查一下其他东西，如果有发现的话就喊你们。"
          }
        }
      }
    },
    {
      "subId": "4005813",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400585301"
        ],
        "dialogs": {
          "400585301": {
            "id": "400585301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "行秋，你找到什么了？",
            "nextDialogs": [
              "400585302"
            ]
          },
          "400585302": {
            "id": "400585302",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "我找到了不少旧书。",
            "nextDialogs": [
              "400585303"
            ]
          },
          "400585303": {
            "id": "400585303",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "这一堆都是和钢铁冶炼有关的，这一堆是讲刀具锻造流程的，这一堆都是植物花艺类的。",
            "nextDialogs": [
              "400585304"
            ]
          },
          "400585304": {
            "id": "400585304",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "植物花艺类的书，肯定是万叶曾祖父的吧。",
            "nextDialogs": [
              "400585305"
            ]
          },
          "400585305": {
            "id": "400585305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "上面会不会有线索？",
            "nextDialogs": [
              "400585306"
            ]
          },
          "400585306": {
            "id": "400585306",
            "speakerId": 10045,
            "speakerName": "行秋",
            "text": "刚才我大致翻了一遍，没找到值得注意的东西。不过我会再仔细看看，如果有线索就马上告诉你们。"
          }
        }
      }
    },
    {
      "subId": "4005814",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4005815",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400585501"
        ],
        "dialogs": {
          "400585501": {
            "id": "400585501",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "哦，是你们啊。我这里目前没发现什么有价值的东西。",
            "nextDialogs": [
              "400585502"
            ]
          },
          "400585502": {
            "id": "400585502",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是吗，不过这扇屏风看起来好像挺有年头了。",
            "nextDialogs": [
              "400585503"
            ]
          },
          "400585503": {
            "id": "400585503",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "嗯，如果保养状态好一点的话，说不定还能卖出价钱，现在这样是肯定不行了。",
            "nextDialogs": [
              "400585504"
            ]
          },
          "400585504": {
            "id": "400585504",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我刚才检查了一下，背面有一大块没清理干净的泥土卡在布料纤维里。",
            "nextDialogs": [
              "400585505"
            ]
          },
          "400585505": {
            "id": "400585505",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "泥土能和布料结合得这么紧，粘上去的时候力量很大，很有可能就是万叶的爷爷扔出去的花盆砸在了这上面。",
            "nextDialogs": [
              "400585508"
            ]
          },
          "400585508": {
            "id": "400585508",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "因为它并不是我们现在要找的东西。",
            "nextDialogs": [
              "400585509"
            ]
          },
          "400585509": {
            "id": "400585509",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "让我想想，如果是我想要留下信息的话，一定会留在一个更特殊的东西上…",
            "nextDialogs": [
              "400585510"
            ]
          },
          "400585510": {
            "id": "400585510",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多陷入思考了，我们还是不要打扰他了。"
          }
        }
      }
    },

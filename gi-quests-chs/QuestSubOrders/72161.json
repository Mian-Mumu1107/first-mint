            "text": "我累了，恕不待客。"
          }
        }
      }
    },
    {
      "subId": "7216107",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721610701"
        ],
        "dialogs": {
          "721610701": {
            "id": "721610701",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "…附近的鼠辈又开始蠢蠢欲动了。",
            "nextDialogs": [
              "721610702"
            ]
          },
          "721610702": {
            "id": "721610702",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "喂，外国人。在附近游荡的话，请小心海贼。",
            "nextDialogs": [
              "721610703"
            ]
          },
          "721610703": {
            "id": "721610703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "谢谢。",
            "nextDialogs": [
              "721610704"
            ]
          },
          "721610704": {
            "id": "721610704",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "应该的。",
            "nextDialogs": [
              "721610705"
            ]
          },
          "721610705": {
            "id": "721610705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他们不是我的对手。",
            "nextDialogs": [
              "721610706"
            ]
          },
          "721610706": {
            "id": "721610706",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "哈哈，净说大话…",
            "nextDialogs": [
              "721610707"
            ]
          },
          "721610707": {
            "id": "721610707",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "等你把他们都驱逐干净，再跟我说这种话吧！",
            "nextDialogs": [
              "721610708"
            ]
          },
          "721610708": {
            "id": "721610708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "一言为定。",
            "nextDialogs": [
              "721610709"
            ]
          },
          "721610709": {
            "id": "721610709",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "嗯，一言为定。"
          }
        }
      }
    },
    {
      "subId": "7216113",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721611301"
        ],
        "dialogs": {
          "721611301": {
            "id": "721611301",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "是外国人？有趣…",
            "nextDialogs": [
              "721611302"
            ]
          },
          "721611302": {
            "id": "721611302",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "如果是游客的话，那你可来错地方了。",
            "nextDialogs": [
              "721611303"
            ]
          },
          "721611303": {
            "id": "721611303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你在做什么？",
            "nextDialogs": [
              "721611304"
            ]
          },
          "721611304": {
            "id": "721611304",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "怎么，你是幕府的人？",
            "nextDialogs": [
              "721611305"
            ]
          },
          "721611305": {
            "id": "721611305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不是。",
            "nextDialogs": [
              "721611306"
            ]
          },
          "721611306": {
            "id": "721611306",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "那就管好自己的事。",
            "nextDialogs": [
              "721611307"
            ]
          },
          "721611307": {
            "id": "721611307",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个家伙，怎么这么讨人厌！",
            "nextDialogs": [
              "721611308"
            ]
          },
          "721611308": {
            "id": "721611308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我是幕府派来的。",
            "nextDialogs": [
              "721611309"
            ]
          },
          "721611309": {
            "id": "721611309",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "嗯，你们这些外国人…",
            "nextDialogs": [
              "721611310"
            ]
          },
          "721611310": {
            "id": "721611310",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "在奉行大人面前摇尾乞怜，讨得点残渣剩饭，又在稻妻武士面前趾高气扬…",
            "nextDialogs": [
              "721611311"
            ]
          },
          "721611311": {
            "id": "721611311",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "打探来打探去、到处搅混水不说…现在还专程跑来这条破船上，也不知有何贵干。",
            "nextDialogs": [
              "721611312"
            ]
          },
          "721611312": {
            "id": "721611312",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "可惜呀，我不过一介伤兵，没什么能招待你的。",
            "nextDialogs": [
              "721611313"
            ]
          },
          "721611313": {
            "id": "721611313",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "所以还要烦请大人自己用腿走出去。",
            "nextDialogs": [
              "721611314"
            ]
          },
          "721611314": {
            "id": "721611314",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这家伙完全不会好好说话吗！",
            "nextDialogs": [
              "721611315"
            ]
          },
          "721611315": {
            "id": "721611315",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "好了，你们太吵了。",
            "nextDialogs": [
              "721611316"
            ]
          },
          "721611316": {
            "id": "721611316",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "临走前给你们一句忠告吧：别在八酝岛待太久，这座岛已经被诅咒了。",
            "nextDialogs": [
              "721611317"
            ]
          },
          "721611317": {
            "id": "721611317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "诅咒…？",
            "nextDialogs": [
              "721611318"
            ]
          },
          "721611318": {
            "id": "721611318",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "听不懂吗？这座岛被诅咒了。",
            "nextDialogs": [
              "721611319"
            ]
          },
          "721611319": {
            "id": "721611319",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "停滞的战争、大人们的欲望、小人物的绝望、无辜受难者的憎恨，老人临终时弥漫满屋的药剂气味…",
            "nextDialogs": [
              "721611320"
            ]
          },
          "721611320": {
            "id": "721611320",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "总而言之，就是诅咒。",
            "nextDialogs": [
              "721611321"
            ]
          },
          "721611321": {
            "id": "721611321",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "趁你还没被压垮，赶紧离开吧。",
            "nextDialogs": [
              "721611322"
            ]
          },
          "721611322": {
            "id": "721611322",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…完全听不懂，真是个怪人。"
          }
        }
      }
    },
    {
      "subId": "7216114",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721611401"
        ],
        "dialogs": {
          "721611401": {
            "id": "721611401",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "怎么又是你？",
            "nextDialogs": [
              "721611402"
            ]
          },
          "721611402": {
            "id": "721611402",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "我不是跟你说过——唉，算了。随你高兴吧。",
            "nextDialogs": [
              "721611403"
            ]
          },
          "721611403": {
            "id": "721611403",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "别弄乱了我的东西，船上补给还够分你一点。满意了就快点离开。",
            "nextDialogs": [
              "721611404"
            ]
          },
          "721611404": {
            "id": "721611404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "需要帮忙吗？",
            "nextDialogs": [
              "721611405"
            ]
          },
          "721611405": {
            "id": "721611405",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "不需要。你没看到我过得很好吗？",
            "nextDialogs": [

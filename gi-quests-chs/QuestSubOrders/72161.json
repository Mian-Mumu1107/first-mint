    {
      "subId": "7216103",
      "subQuestName": "清理海贼营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721610301"
        ],
        "dialogs": {
          "721610301": {
            "id": "721610301",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "你回来了。",
            "nextDialogs": [
              "721610304"
            ]
          },
          "721610304": {
            "id": "721610304",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇…突然气氛好奇怪…",
            "nextDialogs": [
              "721610305"
            ]
          },
          "721610305": {
            "id": "721610305",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "拜托你这个局外人做这种脏活，实在抱歉。"
          }
        }
      }
    },
    {
      "subId": "7216114",

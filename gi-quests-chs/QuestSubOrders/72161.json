            ]
          },
          "721611406": {
            "id": "721611406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但你的伤口…",
            "nextDialogs": [
              "721611407"
            ]
          },
          "721611407": {
            "id": "721611407",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "那是我的伤口，不是你的。",
            "nextDialogs": [

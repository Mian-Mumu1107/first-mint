          },
          "721611409": {
            "id": "721611409",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "那我也出于好心回答你们：别烦我了。",
            "nextDialogs": [
              "721611410"
            ]
          },
          "721611410": {
            "id": "721611410",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我可以帮你。",
            "nextDialogs": [

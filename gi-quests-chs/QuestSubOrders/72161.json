    {
      "subId": "7216104",
      "subQuestName": "采摘12支鸣草",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721610401"
        ],
        "dialogs": {
          "721610401": {
            "id": "721610401",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "你回来了，在岛上注意安全。",
            "nextDialogs": [
              "721610402"
            ]
          },
          "721610402": {
            "id": "721610402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你看这些够吗？"
          }
        }
      }
    },
    {
      "subId": "7216105",
      "subQuestName": "与稻叶久藏对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721610505"
        ],
        "dialogs": {
          "721610505": {
            "id": "721610505",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "把草药捣成药糊还要很长时间，你可以走了。",
            "nextDialogs": [
              "721610506"
            ]
          },
          "721610506": {
            "id": "721610506",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "…不，我不是在赶你走…",
            "nextDialogs": [
              "721610507"
            ]
          },
          "721610507": {
            "id": "721610507",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "过一段时间再回来吧，能有个人聊聊天…也不错。",
            "nextDialogs": [
              "721610510"
            ]
          },
          "721610510": {
            "id": "721610510",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "保重，外国人。"
          }
        }
      }
    },
    {
      "subId": "7216106",
      "subQuestName": "等待到翌日上午（次日10点—12点），与稻叶久藏对话。",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721610601"
        ],
        "dialogs": {
          "721610601": {
            "id": "721610601",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "外国人，最近如何？",
            "nextDialogs": [
              "721610602"
            ]
          },
          "721610602": {
            "id": "721610602",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "抱歉，这里不是待客的好地方。",
            "nextDialogs": [
              "721610603"
            ]
          },
          "721610603": {
            "id": "721610603",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "不过…我很高兴你能来。",
            "nextDialogs": [
              "721610604"
            ]
          },
          "721610604": {
            "id": "721610604",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你看起来好多了。",
            "nextDialogs": [
              "721610605"
            ]
          },
          "721610605": {
            "id": "721610605",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "嗯，又欠你一个人情。",
            "nextDialogs": [
              "721610606"
            ]
          },
          "721610606": {
            "id": "721610606",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "哈哈，真可惜我又撑下来了。",
            "nextDialogs": [
              "721610607"
            ]
          },
          "721610607": {
            "id": "721610607",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这不是好事吗。有什么可惜的啦！",
            "nextDialogs": [
              "721610610"
            ]
          },
          "721610610": {
            "id": "721610610",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "我还没想好接下来怎么做，不过我想我不会回去。",
            "nextDialogs": [
              "721610611"
            ]
          },
          "721610611": {
            "id": "721610611",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "虽然九条政仁公子人还不错，但是他家的老头子正叫唤着抓逃兵立威呢。",
            "nextDialogs": [
              "721610612"
            ]
          },
          "721610612": {
            "id": "721610612",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "我可不能撞到他的刀口上…",
            "nextDialogs": [
              "721610613"
            ]
          },
          "721610613": {
            "id": "721610613",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "或许我会脱下这身甲胄吧，就这样一个人过日子也不错…",
            "nextDialogs": [
              "721610614"
            ]
          },
          "721610614": {
            "id": "721610614",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "直到平静的日子没办法让我自欺欺人，记忆告诉我自己依然是那个染血的伤兵…",
            "nextDialogs": [
              "721610615"
            ]
          },
          "721610615": {
            "id": "721610615",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "唉…总之，以后的事，谁知道呢？"
          }
        }
      }
    },

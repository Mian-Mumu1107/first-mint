            ]
          },
          "721611411": {
            "id": "721611411",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "怎么帮我，把我交给幕府军吗？",
            "nextDialogs": [
              "721611412"
            ]
          },
          "721611412": {
            "id": "721611412",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "哈哈，我劝你别犯傻了…我会被当成逃兵的。九条大人对逃兵从不留情面。",
            "nextDialogs": [

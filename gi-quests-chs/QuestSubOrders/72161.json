    {
      "subId": "7216101",
      "subQuestName": "解救被围困的武士",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721610101"
        ],
        "dialogs": {
          "721610101": {
            "id": "721610101",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "哼，真是丢人…",
            "nextDialogs": [
              "721610102"
            ]
          },
          "721610102": {
            "id": "721610102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "明明救了你一命，你还骂我们丢人！",
            "nextDialogs": [
              "721610105"
            ]
          },
          "721610105": {
            "id": "721610105",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "想不到我会落到被外国人搭救，又任之评头论足的境地…",
            "nextDialogs": [
              "721610106"
            ]
          },
          "721610106": {
            "id": "721610106",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…话说回来，武士先生，你还好吗？",
            "nextDialogs": [
              "721610107"
            ]
          },
          "721610107": {
            "id": "721610107",
            "speakerId": 1000,
            "speakerName": "稻叶久藏",
            "text": "……"
          }
        }
      }
    },
    {

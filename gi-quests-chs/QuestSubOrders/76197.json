  "subQuests": [
    {
      "subId": "7619701",
      "subQuestName": "（隐藏）点击手册按钮完成$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761970101"
        ],
        "dialogs": {
          "761970101": {
            "id": "761970101",
            "speakerId": 1000,
            "speakerName": "维贾米",
            "text": "当年在海上漂泊时，我曾听到过不知从何处传来的召唤，其他人无动于衷，但我却很快被迷住了。",
            "nextDialogs": [
              "761970102"
            ]
          },
          "761970102": {
            "id": "761970102",
            "speakerId": 1001,
            "speakerName": "奥妮",
            "text": "一定是来自异界的声音吧，我也听到过。",
            "nextDialogs": [
              "761970103"
            ]
          },
          "761970103": {
            "id": "761970103",
            "speakerId": 1000,
            "speakerName": "维贾米",
            "text": "后来我才意识到，那召唤中包含了一切未能抵达彼岸的梦想，可以说是怨念的集合。",
            "nextDialogs": [
              "761970104"
            ]
          },
          "761970104": {
            "id": "761970104",
            "speakerId": 1001,
            "speakerName": "奥妮",
            "text": "你应该带上寒涌石，透过中间的孔，就可以看到是谁在召唤你了。",
            "nextDialogs": [
              "761970105"
            ]
          },
          "761970105": {
            "id": "761970105",
            "speakerId": 1000,
            "speakerName": "维贾米",
            "text": "但当时我还是个年轻气盛的毛头小子，哪怕看到危险也只会觉得是机遇，于是就这么一头撞了进去。",
            "nextDialogs": [
              "761970106"
            ]
          },
          "761970106": {
            "id": "761970106",
            "speakerId": 1001,
            "speakerName": "奥妮",
            "text": "听说寒涌石中间的孔就是通向异界的门扉…不过，该怎么穿过去呢？",
            "nextDialogs": [
              "761970107"
            ]
          },
          "761970107": {
            "id": "761970107",
            "speakerId": 1000,
            "speakerName": "维贾米",
            "text": "而在那之后…大海的风浪啊，带走了我的财富、荣誉还有家人。",
            "nextDialogs": [
              "761970108"
            ]
          },
          "761970108": {
            "id": "761970108",
            "speakerId": 1000,
            "speakerName": "维贾米",
            "text": "在野心和欲望的驱使下的冒险，从来不会有好的结果。",
            "nextDialogs": [
              "761970109"
            ]
          },
          "761970109": {
            "id": "761970109",
            "speakerId": 1001,
            "speakerName": "奥妮",
            "text": "啊，卡住了。",
            "nextDialogs": [
              "761970110"
            ]
          },
          "761970110": {
            "id": "761970110",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "我来帮你取下来吧。下次可再别这么做了哦。",
            "nextDialogs": [
              "761970111"
            ]
          },
          "761970111": {
            "id": "761970111",
            "speakerId": 1001,
            "speakerName": "奥妮",
            "text": "莉奈娅姐姐，你怎么有空回来了？",
            "nextDialogs": [
              "761970112"
            ]
          },
          "761970112": {
            "id": "761970112",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "我来附近收集寒涌石，看到你们在聊天，就来打个招呼。",
            "nextDialogs": [
              "761970113"
            ]
          },
          "761970113": {
            "id": "761970113",
            "speakerId": 1001,
            "speakerName": "奥妮",
            "text": "对哦，如果是莉奈娅姐姐，说不定真的可以用寒涌石打开通往异界的门扉…",
            "nextDialogs": [
              "761970114"
            ]
          },
          "761970114": {
            "id": "761970114",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "就算是我也不行，之前不是和你说过吗？那只是穿凿附会的民间传说而已，没什么可靠的依据…",
            "nextDialogs": [
              "761970115"
            ]
          },
          "761970115": {
            "id": "761970115",
            "speakerId": 1000,
            "speakerName": "维贾米",
            "text": "原来行不通啊？",
            "nextDialogs": [
              "761970116"
            ]
          },
          "761970116": {
            "id": "761970116",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "原来你在听啊。",
            "nextDialogs": [
              "761970117"
            ]
          },
          "761970117": {
            "id": "761970117",
            "speakerId": 1000,
            "speakerName": "维贾米",
            "text": "咳…不，我已经不再是过去的我了，现在的我知足常乐，别无所求。",
            "nextDialogs": [
              "761970118"
            ]
          },
          "761970118": {
            "id": "761970118",
            "speakerId": 1001,
            "speakerName": "奥妮",
            "text": "这样，真可惜。那我也来帮莉奈娅姐姐收集寒涌石吧。",
            "nextDialogs": [
              "761970119"
            ]
          },
          "761970119": {
            "id": "761970119",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "好呀，那就麻烦你啦。",
            "nextDialogs": [
              "761970124"
            ]
          },
          "761970124": {
            "id": "761970124",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "在奥妮的帮助下，很快收集完毕…",
            "nextDialogs": [
              "761970122"
            ]
          },
          "761970122": {
            "id": "761970122",
            "speakerId": 1002,
            "speakerName": "莉奈娅",
            "text": "谢谢你，不过我已经收集好啦。",
            "nextDialogs": [
              "761970123"
            ]
          },
          "761970123": {
            "id": "761970123",
            "speakerId": 1001,
            "speakerName": "奥妮",
            "text": "好吧，那我就去莫雷谷找莫雷爷爷他们了。再见啦。"
          }
        }
      }
    },

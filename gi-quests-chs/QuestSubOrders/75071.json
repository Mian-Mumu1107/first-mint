  "subQuests": [
    {
      "subId": "7507110",
      "subQuestName": "(test)钻地龙听导演讲戏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750711001"
        ],
        "dialogs": {
          "750711001": {
            "id": "750711001",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "#哈哈，亲爱的{NICKNAME}和派蒙，我的缪斯和…呃，小缪斯！",
            "nextDialogs": [
              "750711002"
            ]
          },
          "750711002": {
            "id": "750711002",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "#啊，还有{REALNAME[ID(2)|SHOWHOST(true)]}！",
            "nextDialogs": [
              "750711003"
            ]
          },
          "750711003": {
            "id": "750711003",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哪个才是小的啦！",
            "nextDialogs": [
              "750711004"
            ]
          },
          "750711004": {
            "id": "750711004",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750711005"
            ]
          },
          "750711005": {
            "id": "750711005",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哈哈，请别在意！",
            "nextDialogs": [
              "750711006"
            ]
          },
          "750711006": {
            "id": "750711006",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，我很在意！",
            "nextDialogs": [
              "750711008",
              "750711012"
            ]
          },
          "750711008": {
            "id": "750711008",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "当然，不过…呃，嘿嘿，新的灵感就意味着…我又要找你们求助了。",
            "nextDialogs": [
              "750711009"
            ]
          },
          "750711009": {
            "id": "750711009",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没问题啦！反正你每次都会给钱！",
            "nextDialogs": [
              "750711010"
            ]
          },
          "750711010": {
            "id": "750711010",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哈哈，好呀，我的小小雇佣兵！",
            "nextDialogs": [
              "750711017"
            ]
          },
          "750711017": {
            "id": "750711017",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "你看，我这次打算拍摄的是嵴锋龙…嘘，我们小心点。不要吵到它了。",
            "nextDialogs": [
              "750711018"
            ]
          },
          "750711018": {
            "id": "750711018",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我还是第一次接触这种龙类，但我已经观察了它们一段时间了…真是迷人的动物…在坚硬的甲壳下面，它们也有自己的个性呢。",
            "nextDialogs": [
              "750711019"
            ]
          },
          "750711019": {
            "id": "750711019",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嘿嘿，喂过它几次之后，它现在已经能听懂基本的指令了。",
            "nextDialogs": [
              "750711020"
            ]
          },
          "750711020": {
            "id": "750711020",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "不过我需要驯龙大师做的事呢，就是和那头离群的嵴锋龙互动，让我拍一张它与其他同类在一起的照片。",
            "nextDialogs": [
              "750711021"
            ]
          },
          "750711021": {
            "id": "750711021",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嘿嘿，很简单，不是吗？",
            "nextDialogs": [
              "750711022"
            ]
          },
          "750711022": {
            "id": "750711022",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯，太简单啦！"
          },
          "750711012": {
            "id": "750711012",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "慕斯…我也想吃了…",
            "nextDialogs": [
              "750711013"
            ]
          },
          "750711013": {
            "id": "750711013",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "咕噜…咕噜…",
            "nextDialogs": [
              "750711014"
            ]
          },
          "750711014": {
            "id": "750711014",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "呃…是「缪斯」…不是吃的！",
            "nextDialogs": [
              "750711015"
            ]
          },
          "750711015": {
            "id": "750711015",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，只要你给钱，我们就能换成吃的！",
            "nextDialogs": [
              "750711016"
            ]
          },
          "750711016": {
            "id": "750711016",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "随便你怎么说啦…不过我确实有钱，两位不用担心白忙活！"
          }
        }
      }
    },
    {
      "subId": "7507116",
      "subQuestName": "魂附嵴锋龙，与马尼菲科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750711901"
        ],
        "dialogs": {
          "750711901": {
            "id": "750711901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嵴锋龙来啦！我们可以拍摄了吧！",
            "nextDialogs": [
              "750711902"
            ]
          },
          "750711902": {
            "id": "750711902",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "很好，开始啦！"
          }
        }
      }
    },
    {
      "subId": "7507114",
      "subQuestName": "配合马尼菲科的拍摄",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7507111",
      "subQuestName": "与马尼菲科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750711101"
        ],
        "dialogs": {
          "750711101": {
            "id": "750711101",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "你发现了吗？小家伙好像注意到了什么东西…是它的家人吗？",
            "nextDialogs": [
              "750711102"
            ]
          },
          "750711102": {
            "id": "750711102",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "它自己往那边去了！我们也跟上吧，可别让它走丢了！"
          }
        }
      }
    },
    {
      "subId": "7507115",

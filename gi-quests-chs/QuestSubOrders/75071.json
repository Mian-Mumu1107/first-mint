    {
      "subId": "7507113",
      "subQuestName": "与马尼菲科对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750711321"
        ],
        "dialogs": {
          "750711321": {
            "id": "750711321",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "你们击败了敌人，破开了囚禁小驮兽的笼门。驮兽从笼子里雀跃地奔出来，对你们发出欢快的叫声。",
            "nextDialogs": [
              "750711301"
            ]
          },
          "750711301": {
            "id": "750711301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇啊…呼，终于告一段落了！好惊险！",
            "nextDialogs": [
              "750711302"
            ]
          },
          "750711302": {
            "id": "750711302",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嘘——！看……",
            "nextDialogs": [
              "750711303"
            ]
          },
          "750711303": {
            "id": "750711303",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "「咔嚓！」",
            "nextDialogs": [
              "750711304"
            ]
          },
          "750711304": {
            "id": "750711304",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "完美。",
            "nextDialogs": [
              "750711305"
            ]
          },
          "750711305": {
            "id": "750711305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇…它们关系很好呢…我还以为驮兽会被吃掉…之类的。",
            "nextDialogs": [
              "750711306"
            ]
          },
          "750711306": {
            "id": "750711306",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嘿嘿，别看嵴锋龙一副很凶恶的样子，其实它们的个性很温和的。",
            "nextDialogs": [
              "750711307"
            ]
          },
          "750711307": {
            "id": "750711307",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "终于拍好了，副本给你。还有报酬…这里。",
            "nextDialogs": [
              "750711308"
            ]
          },
          "750711308": {
            "id": "750711308",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "唉…本以为能拍到幼年嵴锋龙和成年体亲密互动的场面，没想到让一头小驮兽占了便宜！",
            "nextDialogs": [
              "750711309"
            ]
          },
          "750711309": {
            "id": "750711309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，不过驮兽也不讨厌呀。你肯定也这样觉得吧！",
            "nextDialogs": [
              "750711310"
            ]
          },
          "750711310": {
            "id": "750711310",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "我怎样觉得不重要！重要的是摄影委员会的评委怎么觉得！",
            "nextDialogs": [
              "750711311"
            ]
          },
          "750711311": {
            "id": "750711311",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "不过…这小东西在纳塔的陌生环境里晃荡还是太危险了，我正好也缺少一个帮忙背东西的搭档…",
            "nextDialogs": [
              "750711312"
            ]
          },
          "750711312": {
            "id": "750711312",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嘿嘿，我也就只好勉为其难收养它咯。",
            "nextDialogs": [
              "750711313"
            ]
          },
          "750711313": {
            "id": "750711313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那它原来的主人怎么办呀…？",
            "nextDialogs": [
              "750711314"
            ]
          },
          "750711314": {
            "id": "750711314",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "哼，把这小东西丢在那么危险的地方不管，是他自己的过错！",
            "nextDialogs": [
              "750711317"
            ]
          },
          "750711317": {
            "id": "750711317",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "好啦，不管那些啦！枫丹摄影画廊，我来咯！哈哈，到时候你们也要来哇！",
            "nextDialogs": [
              "750711318"
            ]
          },
          "750711318": {
            "id": "750711318",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "#不好意思，这次我真的要离开这个国家了！再见了！{NICKNAME}和派蒙！再见，小家伙！",
            "nextDialogs": [
              "750711319"
            ]
          },
          "750711319": {
            "id": "750711319",
            "speakerId": 14662,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750711320"
            ]
          },
          "750711320": {
            "id": "750711320",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嘿，接住！留个纪念！别忘了我呀，小家伙们！"
          }
        }
      }
    },
    {
      "subId": "7507116",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750711601"
        ],
        "dialogs": {
          "750711601": {
            "id": "750711601",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "「…幽暗的森林中飘荡着芬芳的花香…」",
            "nextDialogs": [
              "750711602"
            ]
          },
          "750711602": {
            "id": "750711602",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "「…珍重离别之前，请给我一个美好的拥抱~」",
            "nextDialogs": [
              "750711603"
            ]
          },
          "750711603": {
            "id": "750711603",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "嗯…？哈，抱歉，我又在哼歌了。"
          }
        }
      }
    },
    {
      "subId": "7507120",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750712001"
        ],
        "dialogs": {
          "750712001": {
            "id": "750712001",
            "speakerId": 21586,
            "speakerName": "马尼菲科",
            "text": "来吧，帮我找头嵴锋龙，我们就可以开始啦！"
          }
        }
      }
    }
  ]

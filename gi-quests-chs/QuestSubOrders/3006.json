    {
      "subId": "300615",
      "subQuestName": "与艾尔海森对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30060901"
        ],
        "dialogs": {
          "30060901": {
            "id": "30060901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（脑海中浮现出了灵光一现的感受…）",
            "nextDialogs": [
              "30060902"
            ]
          },
          "30060902": {
            "id": "30060902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（仿佛在一瞬间看到了许多使用单手剑的人战斗的身影，而在下一瞬间，那些片段已经成为了自身遥远的记忆。）",
            "nextDialogs": [
              "30060903"
            ]
          },
          "30060903": {
            "id": "30060903",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂，你感觉怎么样？",
            "nextDialogs": [
              "30060906"
            ]
          },
          "30060906": {
            "id": "30060906",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也就是说是管用的对吗？",
            "nextDialogs": [
              "30060907"
            ]
          },
          "30060907": {
            "id": "30060907",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "好，接下来再去战斗一次吧，像刚才那样用平常心就好。"
          }
        }
      }
    },
    {
      "subId": "300605",
      "subQuestName": "进行第二场战斗测试",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30060501"
        ],
        "dialogs": {
          "30060501": {
            "id": "30060501",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "喔，这里这里！二位客人，你们这么快就又来了呀。这次有什么需要呢？",
            "nextDialogs": [
              "30060502"
            ]
          },
          "30060502": {
            "id": "30060502",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "无论是罐装知识还是其他东西，只要你们开口，哗啦哗啦的摩拉送到，我保证都能给你们弄到手喔。",
            "nextDialogs": [
              "30060503"
            ]
          },
          "30060503": {
            "id": "30060503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "多莉，无论我们有什么想要的东西都行吗？",
            "nextDialogs": [
              "30060504"
            ]
          },
          "30060504": {
            "id": "30060504",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "哎呀哎呀，两位客人既然这么说，那看来罐装知识这种货已经满足不了两位了吧？请说说看吧。",
            "nextDialogs": [
              "30060505"
            ]
          },
          "30060505": {
            "id": "30060505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我想买「神明罐装知识」的下落。",
            "nextDialogs": [
              "30060506"
            ]
          },
          "30060506": {
            "id": "30060506",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "喔…呵呵呵呵。我就说嘛，出手这么大方的客人，目标肯定不会是几枚普通的罐装知识。",
            "nextDialogs": [
              "30060507"
            ]
          },
          "30060507": {
            "id": "30060507",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "不过这个情报，价钱可不便宜喔？",
            "nextDialogs": [
              "30060508"
            ]
          },
          "30060508": {
            "id": "30060508",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "毕竟我可是好不容易才躲进了交易现场，而且，一旦被人知道消息是我走漏的，我还可能会被人找麻烦喔。",
            "nextDialogs": [
              "30060509"
            ]
          },
          "30060509": {
            "id": "30060509",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "可是我们怎么知道你的情报是真的呢？或者说，你怎么会「刚好」有这样的情报在手上呢？",
            "nextDialogs": [
              "30060510"
            ]
          },
          "30060510": {
            "id": "30060510",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "呵呵呵…因为对我来说，市面上在流通的一切值钱的东西，都是我的「货源」喔，时刻关注那些宝贝的动向，才有更多生意可做。",
            "nextDialogs": [
              "30060511"
            ]
          },
          "30060511": {
            "id": "30060511",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "而关于情报的真假，就更不用担心了，我用留影机拍下了交易瞬间的画片，无论谁看了都赖不了账。",
            "nextDialogs": [
              "30060514"
            ]
          },
          "30060514": {
            "id": "30060514",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "不愧是客人，交易愉快。",
            "nextDialogs": [
              "30060515"
            ]
          },
          "30060515": {
            "id": "30060515",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "既然客人们已经付清钱款，那么消息就请听好：神明罐装知识，昨天已经被阿赫玛尔之眼的首领密兹里先生拿下了。",
            "nextDialogs": [
              "30060516"
            ]
          },
          "30060516": {
            "id": "30060516",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "阿赫玛尔之眼？就是那个信奉赤王的镀金旅团？",
            "nextDialogs": [
              "30060517"
            ]
          },
          "30060517": {
            "id": "30060517",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "喔，看来客人们也很熟悉他们嘛。",
            "nextDialogs": [
              "30060518"
            ]
          },
          "30060518": {
            "id": "30060518",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "阿赫玛尔之眼为了这枚神明罐装知识可是拼了全力呢，毕竟他们相信，它里面寄宿的是赤王的力量。",
            "nextDialogs": [
              "30060519"
            ]
          },
          "30060519": {
            "id": "30060519",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "不愧是神明罐装知识，和之前见到的都不一样，它可是散发着耀眼的红色光芒喔。",
            "nextDialogs": [
              "30060520"
            ]
          },
          "30060520": {
            "id": "30060520",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "在我拍摄的画片上，也能清楚地看到这枚神明罐装知识喔。",
            "nextDialogs": [
              "30060521"
            ]
          },
          "30060521": {
            "id": "30060521",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "谢谢你的情报，多莉。",
            "nextDialogs": [
              "30060522"
            ]
          },
          "30060522": {
            "id": "30060522",
            "speakerId": 1003,
            "speakerName": "多莉",
            "text": "不客气不客气，有你们这样识货的客人，我昨天的劳动也没有白费呀。今后有什么需要尽管找我。"
          }
        }
      }
    },
    {
      "subId": "300606",
      "subQuestName": "向艾尔海森询问测试情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30060401"
        ],
        "dialogs": {
          "30060401": {
            "id": "30060401",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "现在，我再来记录一次数据。",
            "nextDialogs": [
              "30060402"
            ]
          },
          "30060402": {
            "id": "30060402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "艾尔海森，情况怎么样？",
            "nextDialogs": [
              "30060403"
            ]
          },
          "30060403": {
            "id": "30060403",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "#嗯，你们买到的罐装知识对于{M#他}{F#她}的战斗能力的确有帮助。第二次战斗时，整体的战斗机能数据比前一次提升了0.073%。",
            "nextDialogs": [
              "30060404"
            ]
          },
          "30060404": {
            "id": "30060404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等一下，多少？",
            "nextDialogs": [
              "30060407"
            ]
          },
          "30060407": {
            "id": "30060407",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊啊啊可恶！多莉那个奸商果然骗了我们！这东西别说一百万，感觉就连十万都不值啊！",
            "nextDialogs": [
              "30060408"
            ]
          },
          "30060408": {
            "id": "30060408",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "#当然出现这种结果，也有可能是因为{M#他}{F#她}的实力很强，罐装知识的内容已经无法产生有效提升了。",
            "nextDialogs": [
              "30060409"
            ]
          },
          "30060409": {
            "id": "30060409",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "至少通过这次测试，我也多了解了一些你们的情况。我现在开始觉得，和你们的交易可能还有点划算。",
            "nextDialogs": [
              "30060410"
            ]
          },
          "30060410": {
            "id": "30060410",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "我先回商栈去了，两天后等你的消息。这是向多莉打听情报的经费，到时候她要多少就给多少吧。"
          }
        }
      }
    },

    {
      "subId": "300608",
      "subQuestName": "将情报告知艾尔海森",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30060601"
        ],
        "dialogs": {
          "30060601": {
            "id": "30060601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "艾尔海森，我们把消息弄到手了！",
            "nextDialogs": [
              "30060602"
            ]
          },
          "30060602": {
            "id": "30060602",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "是吗，怎么样？",
            "nextDialogs": [
              "30060605"
            ]
          },
          "30060605": {
            "id": "30060605",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "多莉还给了我们交易的证据，你看！",
            "nextDialogs": [
              "30060606"
            ]
          },
          "30060606": {
            "id": "30060606",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "呵，拍得真清楚。不仅敢潜伏进镀金旅团的交易现场，还敢藏得这么近，胆子也是真够大的。",
            "nextDialogs": [
              "30060607"
            ]
          },
          "30060607": {
            "id": "30060607",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "没错，上面的人就是阿赫玛尔之眼的团长密兹里，他手里这枚与众不同的红色罐装知识，看来就是「神明罐装知识」。",
            "nextDialogs": [
              "30060608"
            ]
          },
          "30060608": {
            "id": "30060608",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "这样一来下周和他们的「武力对话」，也就有机会逼迫它「亮相」了。",
            "nextDialogs": [
              "30060609"
            ]
          },
          "30060609": {
            "id": "30060609",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "当初还无法理解艾尔海森为什么要挑衅阿赫玛尔之眼的家伙们，现在看起来，完全是让你得逞了呀。",
            "nextDialogs": [
              "30060610"
            ]
          },
          "30060610": {
            "id": "30060610",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等我们打败他们，就能跟他们老大好好聊一聊，让他把神明罐装知识借给我们看看了！",
            "nextDialogs": [
              "30060611"
            ]
          },
          "30060611": {
            "id": "30060611",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "辛苦你们了。这几天你们就休息一下吧，我也去做些准备。跟他们见面那天下午三点，我们先在这里会合。",
            "nextDialogs": [
              "30060612"
            ]
          },
          "30060612": {
            "id": "30060612",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好，一言为定。",
            "nextDialogs": [
              "30060613"
            ]
          },
          "30060613": {
            "id": "30060613",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "我先走一步。",
            "nextDialogs": [
              "30060614"
            ]
          },
          "30060614": {
            "id": "30060614",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "几天后，与阿赫玛尔之眼约定见面当天…",
            "nextDialogs": [
              "30060615"
            ]
          },
          "30060615": {
            "id": "30060615",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "艾尔海森好慢啊，还没有来吗…啊，他来了！",
            "nextDialogs": [
              "30060616"
            ]
          },
          "30060616": {
            "id": "30060616",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "久等了，我们到法逻斯灯塔前面的栈桥去吧。",
            "nextDialogs": [
              "30060617"
            ]
          },
          "30060617": {
            "id": "30060617",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯，我们走！"
          }
        }
      }
    },
    {
      "subId": "300609",
      "subQuestName": "前往约定地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30060701"
        ],
        "dialogs": {
          "30060701": {
            "id": "30060701",
            "speakerId": 1004,
            "speakerName": "塔里克",
            "text": "艾尔海森…没想到你这疯子还真敢来啊。",
            "nextDialogs": [
              "30060702"
            ]
          },
          "30060702": {
            "id": "30060702",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "对话是我要求的，我还担心你们不会守约，但看来你们还是很讲信用的。",
            "nextDialogs": [
              "30060703"
            ]
          },
          "30060703": {
            "id": "30060703",
            "speakerId": 1000,
            "speakerName": "艾尔海森",
            "text": "场面挺隆重的，我也带了帮手，没关系吧？",
            "nextDialogs": [
              "30060704"
            ]
          },
          "30060704": {
            "id": "30060704",
            "speakerId": 1004,
            "speakerName": "塔里克",
            "text": "#帮手？这不是饭馆里那{M#小子}{F#丫头}吗，因为这疯子帮了你的忙，所以来报答他？哼，胆子倒是不小。",
            "nextDialogs": [
              "30060705"
            ]
          },
          "30060705": {
            "id": "30060705",
            "speakerId": 1004,
            "speakerName": "塔里克",
            "text": "我也不说什么客气的话了，你们就等着到水里去喂鱼吧。兄弟们，上！",
            "nextDialogs": [
              "30060706"
            ]
          },
          "30060706": {
            "id": "30060706",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "他们冲过来了，你们两个小心一点！"
          }
        }
      }
    },

            ]
          },
          "30060818": {
            "id": "30060818",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看看时间，也快到花神诞日了，要不我们也回须弥城去吧。这些天一直都在奔波，说不定稍微休息一下也能打起精神来。",
            "nextDialogs": [
              "30060821"
            ]
          },
          "30060821": {
            "id": "30060821",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "艾尔海森，那我们就在这里告别吧。再见！",
            "nextDialogs": [

    {
      "subId": "7180502",
      "subQuestName": "帮纪芳送书",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718050401"
        ],
        "dialogs": {
          "718050401": {
            "id": "718050401",
            "speakerId": 2009,
            "speakerName": "德安公",
            "text": "年轻人，你有什么事吗？",
            "nextDialogs": [
              "718050402"
            ]
          },
          "718050402": {
            "id": "718050402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是纪芳给你的书。",
            "nextDialogs": [
              "718050403"
            ]
          },
          "718050403": {
            "id": "718050403",
            "speakerId": 2009,
            "speakerName": "德安公",
            "text": "这是《帝君尘游记·四》？我记得我早就订了这本书，怎么拖了这么久？",
            "nextDialogs": [
              "718050404"
            ]
          },
          "718050404": {
            "id": "718050404",
            "speakerId": 2009,
            "speakerName": "德安公",
            "text": "让我看看…咦？居然是初版，难怪现在才送来…",
            "nextDialogs": [
              "718050405"
            ]
          },
          "718050405": {
            "id": "718050405",
            "speakerId": 2009,
            "speakerName": "德安公",
            "text": "我还以为是因为客人太多，纪芳把这本书的事给忘了呢。",
            "nextDialogs": [
              "718050406"
            ]
          },
          "718050406": {
            "id": "718050406",
            "speakerId": 2009,
            "speakerName": "德安公",
            "text": "这本书我就收下了，谢谢你，年轻人。"
          }
        }
      }
    },
    {
      "subId": "7180503",
      "subQuestName": "帮纪芳送书",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718050501"
        ],
        "dialogs": {
          "718050501": {
            "id": "718050501",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "年轻人，你有什么事吗？",
            "nextDialogs": [
              "718050502"
            ]
          },
          "718050502": {
            "id": "718050502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是纪芳给你的书。",
            "nextDialogs": [
              "718050503"
            ]
          },
          "718050503": {
            "id": "718050503",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "我想起来了，之前我跟「万文集舍」订了一本《玑衡经》。",
            "nextDialogs": [
              "718050504"
            ]
          },
          "718050504": {
            "id": "718050504",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "没错没错，这就是我要的书，总算送来了。呵呵，我还以为客人太多，纪芳把这本书的事给忘了呢。",
            "nextDialogs": [
              "718050505"
            ]
          },
          "718050505": {
            "id": "718050505",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "送来就好，送来就好…哦唷，这装帧还不错，纪芳有心了。",
            "nextDialogs": [
              "718050506"
            ]
          },
          "718050506": {
            "id": "718050506",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "谢谢你年轻人，这本书我就收下了。"
          }
        }
      }
    },

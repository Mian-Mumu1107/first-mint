            "id": "718050801",
            "speakerId": 2009,
            "speakerName": "德安公",
            "text": "帝君…唉…"
          }
        }
      }
    },
    {
      "subId": "7180509",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718050901"
        ],
        "dialogs": {
          "718050901": {
            "id": "718050901",
            "speakerId": 2003,
            "speakerName": "天叔",
            "text": "「读史可以知兴衰」…但现在又有多少人，是真的为了知兴衰而读史的呢？"
          }
        }
      }

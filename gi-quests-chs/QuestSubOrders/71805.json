    {
      "subId": "7180506",
      "subQuestName": "向纪芳回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718050601"
        ],
        "dialogs": {
          "718050601": {
            "id": "718050601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于那两本书…",
            "nextDialogs": [
              "718050602"
            ]
          },
          "718050602": {
            "id": "718050602",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "书都送到了吗？",
            "nextDialogs": [
              "718050603"
            ]
          },
          "718050603": {
            "id": "718050603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都送到了。",
            "nextDialogs": [
              "718050604"
            ]
          },
          "718050604": {
            "id": "718050604",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "谢谢你。「万文集舍」能开到现在，都是多亏了这些老客人的支持。",
            "nextDialogs": [
              "718050605"
            ]
          },
          "718050605": {
            "id": "718050605",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "而且，这些老客人也都是真正爱书的人。能拿到好书，他们应该也会很开心的。",
            "nextDialogs": [
              "718050606"
            ]
          },
          "718050606": {
            "id": "718050606",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "旅行者，谢谢你帮我这个忙，这些报酬请你收下吧。",
            "nextDialogs": [
              "718050607"
            ]
          },
          "718050607": {
            "id": "718050607",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "如果你以后想买书的话，尽管来找我。"
          }
        }
      }
    },
    {
      "subId": "7180507",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718050701"
        ],
        "dialogs": {
          "718050701": {
            "id": "718050701",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "关于那两本书…",
            "nextDialogs": [
              "718050702"
            ]
          },
          "718050702": {
            "id": "718050702",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "这两位是老客人了，他们订的书我一般都会早点准备。",
            "nextDialogs": [
              "718050703"
            ]
          },
          "718050703": {
            "id": "718050703",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "但突然来了那么多客人，我一下子应付不过来，把这两本书拖了这么久。",
            "nextDialogs": [
              "718050704"
            ]
          },
          "718050704": {
            "id": "718050704",
            "speakerId": 1625,
            "speakerName": "纪芳",
            "text": "他们一定都等得不耐烦了…"
          }
        }
      }
    },
    {
      "subId": "7180508",

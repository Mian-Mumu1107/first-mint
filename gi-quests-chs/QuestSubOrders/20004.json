{
  "lineCounts": {
    "Black Screen": 1,
    "Player": 9,
    "歌德": 24,
    "派蒙": 3,
    "莫娜": 16
  },
  "subQuests": [
    {
      "subId": "2000401",
      "subQuestName": "与歌德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200040101"
        ],
        "dialogs": {
          "200040101": {
            "id": "200040101",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "唉，看来我还是得自己跑一趟…",
            "nextDialogs": [
              "200040102"
            ]
          },
          "200040102": {
            "id": "200040102",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "我这把老骨头，非得散架不可…",
            "nextDialogs": [
              "200040103"
            ]
          },
          "200040103": {
            "id": "200040103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有什么急事吗？",
            "nextDialogs": [
              "200040104"
            ]
          },
          "200040104": {
            "id": "200040104",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "旅行者？唉…也不能算是急事，但我是真的操办不过来了…",
            "nextDialogs": [
              "200040105"
            ]
          },
          "200040105": {
            "id": "200040105",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "你也知道，那群愚人众把我的酒店给包下来了吧。",
            "nextDialogs": [
              "200040106"
            ]
          },
          "200040106": {
            "id": "200040106",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "他们包下了酒店之后，我作为「歌德大酒店」的老板，自然也得在旁边照应着。",
            "nextDialogs": [
              "200040107"
            ]
          },
          "200040107": {
            "id": "200040107",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "帮着联系食材供应商，物件坏了及时叫人去修，还有一些杂七杂八的事。",
            "nextDialogs": [
              "200040108"
            ]
          },
          "200040108": {
            "id": "200040108",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "最近酒店里有几间屋子的桌椅坏了，我得赶紧去联系人，把合适的木材送去给木匠。",
            "nextDialogs": [
              "200040109"
            ]
          },
          "200040109": {
            "id": "200040109",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "还有城里几间屋子的租金没收…玛文那小子又成天不见影子。",
            "nextDialogs": [
              "200040110"
            ]
          },
          "200040110": {
            "id": "200040110",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "唉，也不知道我这把老骨头能折腾几年，玛文到底什么时候才能懂事点呢…",
            "nextDialogs": [
              "200040113"
            ]
          },
          "200040113": {
            "id": "200040113",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "你，你愿意帮我吗？唉，真的太麻烦你了，玛文那小子要是有你一半懂事，我也不会累成这样…",
            "nextDialogs": [
              "200040114"
            ]
          },
          "200040114": {
            "id": "200040114",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "那就麻烦你，先帮我去拿一份杉木和一份桦木回来吧，我要赶紧把这些木材交给木匠了。"
          }
        }
      }
    },
    {
      "subId": "2000406",
      "subQuestName": "将木材带给歌德",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200040601"
        ],
        "dialogs": {
          "200040601": {
            "id": "200040601",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "你拿到木材了吗？只要一份杉木和一份桦木就好了。"
          }
        }
      }
    },
    {
      "subId": "2000407",
      "subQuestName": "与歌德对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200040701"
        ],
        "dialogs": {
          "200040701": {
            "id": "200040701",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "谢谢你，这些木材就够了，我这就拿去给木匠…对了，还得去收房租才行…",
            "nextDialogs": [
              "200040702"
            ]
          },
          "200040702": {
            "id": "200040702",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "唉，也不知道那个…阿斯…阿斯…什么莫娜…这次在不在家…",
            "nextDialogs": [
              "200040703"
            ]
          },
          "200040703": {
            "id": "200040703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是阿斯托洛吉斯·莫娜·梅姬斯图斯。",
            "nextDialogs": [
              "200040704"
            ]
          },
          "200040704": {
            "id": "200040704",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "对！就是这个名字，哎哟…我是真的记不住。",
            "nextDialogs": [
              "200040705"
            ]
          },
          "200040705": {
            "id": "200040705",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？莫娜还没交房租吗？",
            "nextDialogs": [
              "200040706"
            ]
          },
          "200040706": {
            "id": "200040706",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "可不是嘛，其他的租客都把房租交了，就剩她了。",
            "nextDialogs": [
              "200040707"
            ]
          },
          "200040707": {
            "id": "200040707",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "我跑了好几趟了，但她一直都不在家。",
            "nextDialogs": [
              "200040708"
            ]
          },
          "200040708": {
            "id": "200040708",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "旅行者，请你帮我跑一趟，去催催她交房租吧。"
          }
        }
      }
    },
    {
      "subId": "2000402",
      "subQuestName": "拜访莫娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2000403",
      "subQuestName": "与莫娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200040301"
        ],
        "dialogs": {
          "200040301": {
            "id": "200040301",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "是你啊，好久不见。",
            "nextDialogs": [
              "200040302"
            ]
          },
          "200040302": {
            "id": "200040302",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "怎么一副急匆匆的样子，你找我有什么事吗？",
            "nextDialogs": [
              "200040303"
            ]
          },
          "200040303": {
            "id": "200040303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "莫娜，你这几天去哪里了呀？",
            "nextDialogs": [
              "200040304"
            ]
          },
          "200040304": {
            "id": "200040304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找你好几天了。",
            "nextDialogs": [
              "200040305"
            ]
          },
          "200040305": {
            "id": "200040305",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "那可真不巧…前几天《蒸汽鸟报》刚向我约了一份新稿件。",
            "nextDialogs": [
              "200040306"
            ]
          },
          "200040306": {
            "id": "200040306",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "主题是「星相的运转变化和个人命运变迁的关系」。",
            "nextDialogs": [
              "200040307"
            ]
          },
          "200040307": {
            "id": "200040307",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "为了写这篇稿件，我这几天基本上都在野外观测星象，很晚才回家。",
            "nextDialogs": [
              "200040308"
            ]
          },
          "200040308": {
            "id": "200040308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "为了赚钱，莫娜也真是努力呢…",
            "nextDialogs": [
              "200040309"
            ]
          },
          "200040309": {
            "id": "200040309",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "毕竟枫丹廷那边的星象仪又推出了新版嘛，我都已经付了订货押金了。",
            "nextDialogs": [
              "200040310"
            ]
          },
          "200040310": {
            "id": "200040310",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "等这篇稿件的稿酬到了，我就能结清尾款，正式拿到那台星象仪了。",
            "nextDialogs": [
              "200040311"
            ]
          },
          "200040311": {
            "id": "200040311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还有钱付歌德先生的房租吗…",
            "nextDialogs": [
              "200040312"
            ]
          },
          "200040312": {
            "id": "200040312",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "房租？",
            "nextDialogs": [
              "200040313"
            ]
          },
          "200040313": {
            "id": "200040313",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "喔…！我、我应该留了钱的…",
            "nextDialogs": [
              "200040314"
            ]
          },
          "200040314": {
            "id": "200040314",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "你们等一会，我找找…",
            "nextDialogs": [
              "200040315"
            ]
          },
          "200040315": {
            "id": "200040315",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "（莫娜开始翻起了自己的钱包…）",
            "nextDialogs": [
              "200040316"
            ]
          },
          "200040316": {
            "id": "200040316",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "这些…加上这些！应该够付房租了…",
            "nextDialogs": [
              "200040317"
            ]
          },
          "200040317": {
            "id": "200040317",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（莫娜是把身上的钱都掏光了吗…）",
            "nextDialogs": [
              "200040318"
            ]
          },
          "200040318": {
            "id": "200040318",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "你们帮我把这些钱带给歌德先生吧。"
          }
        }
      }
    },
    {
      "subId": "2000404",
      "subQuestName": "将租金交给歌德",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200040401"
        ],
        "dialogs": {
          "200040401": {
            "id": "200040401",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "怎么样，你们找到那位…呃…你们的那位朋友了吗？",
            "nextDialogs": [
              "200040402"
            ]
          },
          "200040402": {
            "id": "200040402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是租金。",
            "nextDialogs": [
              "200040403"
            ]
          },
          "200040403": {
            "id": "200040403",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "好，好，这些钱够了，谢谢你们啊。",
            "nextDialogs": [
              "200040404"
            ]
          },
          "200040404": {
            "id": "200040404",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "不过，你们的那位朋友究竟是做什么的？",
            "nextDialogs": [
              "200040405"
            ]
          },
          "200040405": {
            "id": "200040405",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "明明看着那么有本事，却总是这么穷…"
          }
        }
      }
    },
    {
      "subId": "2000405",
      "subQuestName": "回复莫娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200040501"
        ],
        "dialogs": {
          "200040501": {
            "id": "200040501",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "你们回来了，租金交给歌德了吗？",
            "nextDialogs": [
              "200040502"
            ]
          },
          "200040502": {
            "id": "200040502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经都交给他了。",
            "nextDialogs": [
              "200040503"
            ]
          },
          "200040503": {
            "id": "200040503",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "那就好。幸好这间屋子的租金也不算太贵…勉强能把钱凑齐了。",
            "nextDialogs": [
              "200040504"
            ]
          },
          "200040504": {
            "id": "200040504",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "不过，看来我又得多吃几天沙拉了…"
          }
        }
      }
    },
    {
      "subId": "2000409",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200040901"
        ],
        "dialogs": {
          "200040901": {
            "id": "200040901",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "呜…没剩下多少钱吃饭了，还好昨天做了几份沙拉…"
          }
        }
      }
    },
    {
      "subId": "2000410",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200041001"
        ],
        "dialogs": {
          "200041001": {
            "id": "200041001",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "阿斯…阿斯托洛…什么来着…"
          }
        }
      }
    },
    {
      "subId": "2000411",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200041101"
        ],
        "dialogs": {
          "200041101": {
            "id": "200041101",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "租金也齐了，总算能休息一会了…"
          }
        }
      }
    }
  ]
}
  },
  "subQuests": [
    {
      "subId": "7500501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750050101"
        ],
        "dialogs": {
          "750050101": {
            "id": "750050101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，你看，这里有一道被封印的大门！",
            "nextDialogs": [
              "750050102"
            ]
          },
          "750050102": {
            "id": "750050102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼哼，我有种直觉，刚才我们在附近拿到的几个奇怪东西，一定和开启大门有关。",
            "nextDialogs": [
              "750050103"
            ]
          },
          "750050103": {
            "id": "750050103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真奇怪，这道门的背后会是什么地方呢？",
            "nextDialogs": [
              "750050104"
            ]
          },
          "750050104": {
            "id": "750050104",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750050106",
              "750050111"
            ]
          },
          "750050106": {
            "id": "750050106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇…有怪物的地方，一定会有宝藏的吧？",
            "nextDialogs": [
              "750050107"
            ]
          },
          "750050107": {
            "id": "750050107",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750050108"
            ]
          },
          "750050108": {
            "id": "750050108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那可不一定哦。",
            "nextDialogs": [
              "750050109"
            ]
          },
          "750050109": {
            "id": "750050109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼，少说丧气话啦，我们进去看看不就知道了！",
            "nextDialogs": [
              "750050115"
            ]
          },
          "750050115": {
            "id": "750050115",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "喂，两位异邦人！唔…还有一只系着丝巾的小嵴锋龙。",
            "nextDialogs": [
              "750050116"
            ]
          },
          "750050116": {
            "id": "750050116",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔？",
            "nextDialogs": [
              "750050117"
            ]
          },
          "750050117": {
            "id": "750050117",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "哎呀，精神的小家伙，你没告诉他们：封印之所以是封印，就因为这里是「禁地」吗？",
            "nextDialogs": [
              "750050118"
            ]
          },
          "750050118": {
            "id": "750050118",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "哦，除了深远的诅咒，你们在里面找不到任何东西的。",
            "nextDialogs": [
              "750050119"
            ]
          },
          "750050119": {
            "id": "750050119",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…",
            "nextDialogs": [
              "750050120"
            ]
          },
          "750050120": {
            "id": "750050120",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也就是说…没有宝藏？",
            "nextDialogs": [
              "750050121"
            ]
          },
          "750050121": {
            "id": "750050121",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "宝藏嘛…大概也是有的。",
            "nextDialogs": [
              "750050122"
            ]
          },
          "750050122": {
            "id": "750050122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "大概？",
            "nextDialogs": [
              "750050123"
            ]
          },
          "750050123": {
            "id": "750050123",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "不过那就不是异邦人该染指的东西了，那扇被封印的门后既是「禁地」也是「圣地」。",
            "nextDialogs": [
              "750050124"
            ]
          },
          "750050124": {
            "id": "750050124",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "平时只有来经受考验的讯使在完成试炼，拿到资格之后才得以进入，据说里面存放着远古的先民与夜晚的世界沟通的媒介…",
            "nextDialogs": [
              "750050125"
            ]
          },
          "750050125": {
            "id": "750050125",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "这么说来，我只是稍微有事离开了一小会儿，你们就取得了证明试炼完成的三枚钥石？这还真是不得了啊…",
            "nextDialogs": [
              "750050126"
            ]
          },
          "750050126": {
            "id": "750050126",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，爬高下低，找东西啊，这种活我们可擅长了！",
            "nextDialogs": [
              "750050127"
            ]
          },
          "750050127": {
            "id": "750050127",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750050128"
            ]
          },
          "750050128": {
            "id": "750050128",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "即使是部族的讯使看来也没有你们这般矫健的身手。这样，虽然部族的禁地肯定是没法让你们进去，不过，我的营地就在附近。",
            "nextDialogs": [
              "750050129"
            ]
          },
          "750050129": {
            "id": "750050129",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "就让我招待你们垫补下肚子，再休息一会儿，怎么样？",
            "nextDialogs": [
              "750050130"
            ]
          },
          "750050130": {
            "id": "750050130",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…"
          },
          "750050111": {
            "id": "750050111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇！我的直觉也是这样，里面一定是藏宝的洞窟没错啦！",
            "nextDialogs": [
              "750050112"
            ]
          },
          "750050112": {
            "id": "750050112",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750050113"
            ]
          },
          "750050113": {
            "id": "750050113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不要太兴奋啦。",
            "nextDialogs": [
              "750050114"
            ]
          },
          "750050114": {
            "id": "750050114",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "里面有什么，进去看看就知道了！我们先把这道大门打开吧！嘿嘿，宝藏，宝藏，我们来咯！"
          }
        }
      }
    },
    {
      "subId": "7500502",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750050201"
        ],
        "dialogs": {
          "750050201": {
            "id": "750050201",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "不必客气，你们随意吧。要不要尝尝我的手艺？",
            "nextDialogs": [
              "750050202"
            ]
          },
          "750050202": {
            "id": "750050202",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "如果想自己做的话，那边的箱子里有食谱。还有些我用不上的东西，你可以翻一翻。",
            "nextDialogs": [
              "750050203"
            ]
          },
          "750050203": {
            "id": "750050203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？你还随身准备着食谱吗？",
            "nextDialogs": [
              "750050204"
            ]
          },
          "750050204": {
            "id": "750050204",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "我自己画的，画了好几份。说不定谁能用得上。如果遇到需要解救的人，也能拿来救命呢。你说是吧？",
            "nextDialogs": [
              "750050205"
            ]
          },
          "750050205": {
            "id": "750050205",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，你想得还真周到…",
            "nextDialogs": [
              "750050206"
            ]
          },
          "750050206": {
            "id": "750050206",
            "speakerId": 1002,
            "speakerName": "？？？",
            "text": "毕竟在部族外面，你只能自己靠自己了。",
            "nextDialogs": [
              "750050207"
            ]
          },
          "750050207": {
            "id": "750050207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "对了，我们还没问过你的名字？",
            "nextDialogs": [
              "750050208"
            ]
          },
          "750050208": {
            "id": "750050208",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "我的名字？哈！雷格巴吧，叫我雷格巴就好。那么你们呢，朋友？",
            "nextDialogs": [
              "750050209"
            ]
          },
          "750050209": {
            "id": "750050209",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "向雷格巴作了自我介绍。",
            "nextDialogs": [
              "750050210"
            ]
          },
          "750050210": {
            "id": "750050210",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "#派蒙，{NICKNAME}，还有小嵴锋龙{REALNAME[ID(2)|SHOWHOST(true)]}…你们在纳塔相遇，真是奇妙的缘分。",
            "nextDialogs": [
              "750050211"
            ]
          },
          "750050211": {
            "id": "750050211",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "#话说回来，{NICKNAME}。你们在部族的禁地附近做什么？嗯？寻宝？打探秘密？",
            "nextDialogs": [
              "750050213",
              "750050216"
            ]
          },
          "750050213": {
            "id": "750050213",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750050214"
            ]
          },
          "750050214": {
            "id": "750050214",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯嗯！这种被保护得很好的地方，总有可能藏着宝贝吧！",
            "nextDialogs": [
              "750050220"
            ]
          },
          "750050220": {
            "id": "750050220",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "总之，不要对那里动歪心思了，外来人。我是不会让你们进去的。",
            "nextDialogs": [
              "750050221"
            ]
          },
          "750050221": {
            "id": "750050221",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "那里是古老的先人与夜晚重新建立起联系的地方，自那以后，越来越多的部族人才能步入「夜神之国」的门扉。",
            "nextDialogs": [
              "750050222"
            ]
          },
          "750050222": {
            "id": "750050222",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "嗯?",
            "nextDialogs": [
              "750050223"
            ]
          },
          "750050223": {
            "id": "750050223",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「夜神之国」到底是个什么样的地方啊？",
            "nextDialogs": [
              "750050224"
            ]
          },
          "750050224": {
            "id": "750050224",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "哈哈，据说那是所有纳塔人在离开这个世界才会前往的地方…只有少数人有从那里返回的经历。",
            "nextDialogs": [
              "750050225"
            ]
          },
          "750050225": {
            "id": "750050225",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "据说那是个流水犹如荧光，伫立着巨大黑曜石碑之处。比起部族的禁地，「夜神之国」才是你们最好不要好奇的地方…",
            "nextDialogs": [
              "750050226"
            ]
          },
          "750050226": {
            "id": "750050226",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "所以，你之前说的，下面的那个…和夜晚世界沟通的…",
            "nextDialogs": [
              "750050227"
            ]
          },
          "750050227": {
            "id": "750050227",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "媒介，对，就是以前的人和「大灵」…也是来自「夜神之国」的使者接触的古老道具…",
            "nextDialogs": [
              "750050228"
            ]
          },
          "750050228": {
            "id": "750050228",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，古老的道具…",
            "nextDialogs": [
              "750050229"
            ]
          },
          "750050229": {
            "id": "750050229",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750050230"
            ]
          },
          "750050230": {
            "id": "750050230",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "…或许我说的有点多了。总之，在部族人与「夜神之国」建立稳定联系的现在，早已不用媒介，而且在我看来手段实在简陋。",
            "nextDialogs": [
              "750050231"
            ]
          },
          "750050231": {
            "id": "750050231",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "但那好歹也是人类部族的圣物。",
            "nextDialogs": [
              "750050232"
            ]
          },
          "750050232": {
            "id": "750050232",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…嗯！",
            "nextDialogs": [
              "750050233"
            ]
          },
          "750050233": {
            "id": "750050233",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好吧、好吧…我知道了！",
            "nextDialogs": [
              "750050234"
            ]
          },
          "750050234": {
            "id": "750050234",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "对，不要去禁地，那样才是真正正确的做法。",
            "nextDialogs": [
              "750050235"
            ]
          },
          "750050235": {
            "id": "750050235",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "哈！哈！你们的伙伴很聪明，是个非常聪明的孩子。",
            "nextDialogs": [
              "750050236"
            ]
          },
          "750050236": {
            "id": "750050236",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "我曾经也有许多伙伴…许多很聪明的孩子。但现在，我孑然一身，离群索居已久了…",
            "nextDialogs": [
              "750050237"
            ]
          },
          "750050237": {
            "id": "750050237",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "咳咳…啊，没想到天色已经如此之深了。",
            "nextDialogs": [
              "750050238"
            ]
          },
          "750050238": {
            "id": "750050238",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哈啊…听了好多半懂不懂的东西，我也发困了呢…",
            "nextDialogs": [
              "750050239"
            ]
          },
          "750050239": {
            "id": "750050239",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "哎，都怪我，偶尔遇见能说话的人，就变得喋喋不休了…这样，如果你们不嫌弃的话，就在这里休息一晚吧。",
            "nextDialogs": [
              "750050240"
            ]
          },
          "750050240": {
            "id": "750050240",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "我来为你们准备床铺。反正夜里我也得在附近巡逻，不必担心安全的问题。",
            "nextDialogs": [
              "750050241"
            ]
          },
          "750050241": {
            "id": "750050241",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，好贴心！那就谢谢你啦！",
            "nextDialogs": [
              "750050242"
            ]
          },
          "750050242": {
            "id": "750050242",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…",
            "nextDialogs": [
              "750050243"
            ]
          },
          "750050243": {
            "id": "750050243",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "在温暖的草榻上躺下，伴着闪烁的营火，你很快便陷入了梦乡…\\n不过你总觉得耳边有细碎而嘈杂的声响，令你无法沉入深眠。",
            "nextDialogs": [
              "750050244"
            ]
          },
          "750050244": {
            "id": "750050244",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "直到——\\n直到脸颊旁冰凉湿润的触感突然袭来，将你带离了粘稠黑暗的夜梦…",
            "nextDialogs": [
              "750050245"
            ]
          },
          "750050245": {
            "id": "750050245",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "#你睁开双眼，{REALNAME[ID(2)|SHOWHOST(true)]}熟悉而友好的面孔占据了你的视野。\\n或许刚才是它在舔舐你，试图将你唤醒。\\n又过了片刻，你才注意到，它似乎正试图给你展示什么东西——一座奇特的黑曜石像…",
            "nextDialogs": [
              "750050246"
            ]
          },
          "750050246": {
            "id": "750050246",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！"
          },
          "750050216": {
            "id": "750050216",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对呀，看到一扇被封印着的大门，有谁不会好奇呢？",
            "nextDialogs": [
              "750050217"
            ]
          },
          "750050217": {
            "id": "750050217",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750050218"
            ]
          },
          "750050218": {
            "id": "750050218",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "正派人吧。",
            "nextDialogs": [
              "750050219"
            ]
          },
          "750050219": {
            "id": "750050219",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂！"
          }
        }
      }
    },
    {
      "subId": "7500503",
      "subQuestName": "与奇怪的家伙对话",
      "sceneId": null,
      "locations": [],

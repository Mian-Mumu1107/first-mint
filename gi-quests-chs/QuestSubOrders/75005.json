      }
    },
    {
      "subId": "7500504",
      "subQuestName": "前往营地",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750050401"
        ],
        "dialogs": {
          "750050401": {
            "id": "750050401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，刚才我们不是还在那个峡谷的遗迹里…这里是…？",
            "nextDialogs": [
              "750050402"
            ]
          },
          "750050402": {
            "id": "750050402",
            "speakerId": 1005,
            "speakerName": "「黑曜石碑的影像」",
            "text": "过来，来这里。",
            "nextDialogs": [
              "750050403"
            ]
          },
          "750050403": {
            "id": "750050403",
            "speakerId": 1005,
            "speakerName": "「黑曜石碑的影像」",
            "text": "「偶像」…「媒介」…归还…",
            "nextDialogs": [
              "750050404"
            ]
          },
          "750050404": {
            "id": "750050404",
            "speakerId": 1005,
            "speakerName": "「黑曜石碑的影像」",
            "text": "（轻柔而缥缈的声音仿佛来自极远之处，又仿佛随风间歇递至耳边的噫语…）",
            "nextDialogs": [
              "750050405"
            ]
          },
          "750050405": {
            "id": "750050405",
            "speakerId": 1005,
            "speakerName": "「黑曜石碑的影像」",
            "text": "（冰凉的意识似乎在不断地召唤你，通过…你手中的黑曜石像…）",
            "nextDialogs": [
              "750050406"
            ]
          },
          "750050406": {
            "id": "750050406",
            "speakerId": 1005,
            "speakerName": "「黑曜石碑的影像」",
            "text": "归还…归还…",
            "nextDialogs": [
              "750050407"
            ]
          },
          "750050407": {
            "id": "750050407",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}？",
            "nextDialogs": [
              "750050408"
            ]
          },
          "750050408": {
            "id": "750050408",
            "speakerId": 1005,
            "speakerName": "「黑曜石碑的影像」",
            "text": "……",
            "nextDialogs": [
              "750050409"
            ]
          },
          "750050409": {
            "id": "750050409",
            "speakerId": 1005,
            "speakerName": "「黑曜石碑的影像」",
            "text": "许久未有远方的来者，这里…太大了，太空了。",
            "nextDialogs": [
              "750050410"
            ]
          },
          "750050410": {
            "id": "750050410",
            "speakerId": 1005,
            "speakerName": "「黑曜石碑的影像」",
            "text": "污秽的黑暗是不速之客…污染了哪怕最晦暗的梦境…",
            "nextDialogs": [
              "750050411"
            ]
          },
          "750050411": {
            "id": "750050411",
            "speakerId": 1005,
            "speakerName": "「黑曜石碑的影像」",
            "text": "我们的国度再次遭到入侵…亡者若被不安的黑潮吞噬，生者的烈火，旦夕之际，亦将熄灭…",
            "nextDialogs": [
              "750050412"
            ]
          },
          "750050412": {
            "id": "750050412",
            "speakerId": 1005,
            "speakerName": "「黑曜石碑的影像」",
            "text": "莫轻信所谓「圣山」的愿景，要拒绝…他的承诺…"
          }
        }
      }
    },

    {
      "subId": "7500515",
      "subQuestName": "与雷格巴对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750050501"
        ],
        "dialogs": {
          "750050501": {
            "id": "750050501",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "你们终于回来了！呼…刚刚你们靠近祭坛就「呼」地一下消失了！我还以为你们被「大灵」拘走了呢…可吓到我了。",
            "nextDialogs": [
              "750050502"
            ]
          },
          "750050502": {
            "id": "750050502",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…",
            "nextDialogs": [
              "750050503"
            ]
          },
          "750050503": {
            "id": "750050503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们去了一个好可怕的地方！有一个大石碑在和我们说话呢！",
            "nextDialogs": [
              "750050504"
            ]
          },
          "750050504": {
            "id": "750050504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}怎么了，是在担心我们吗？",
            "nextDialogs": [
              "750050505"
            ]
          },
          "750050505": {
            "id": "750050505",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…唔嗯…",
            "nextDialogs": [
              "750050506"
            ]
          },
          "750050506": {
            "id": "750050506",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "你看，我说你的朋友们会平安归来的。",
            "nextDialogs": [
              "750050507"
            ]
          },
          "750050507": {
            "id": "750050507",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "不过，大石碑？",
            "nextDialogs": [
              "750050508"
            ]
          },
          "750050508": {
            "id": "750050508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（向雷格巴述说所看到的…）",
            "nextDialogs": [
              "750050509"
            ]
          },
          "750050509": {
            "id": "750050509",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "唉，能够战胜「大灵」意志的显化，听你的描述，又很像是进入了「夜神之国」…",
            "nextDialogs": [
              "750050510"
            ]
          },
          "750050510": {
            "id": "750050510",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "看来你们也不是什么普通的异邦人啊，居然能够看见从夜神之国返还的人，我这辈子也算是值了，哈哈。",
            "nextDialogs": [
              "750050511"
            ]
          },
          "750050511": {
            "id": "750050511",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "好啦，终于解决了这个「小风波」，我们快些上去吧，我还得想办法让封印恢复原状…",
            "nextDialogs": [
              "750050512"
            ]
          },
          "750050512": {
            "id": "750050512",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇…还说什么「小风波」！明明部族的「大灵」意志的显化都被我们…",
            "nextDialogs": [
              "750050513"
            ]
          },
          "750050513": {
            "id": "750050513",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "没关系，它们会随时间从地脉重聚力量的。不用管它。",
            "nextDialogs": [
              "750050514"
            ]
          },
          "750050514": {
            "id": "750050514",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇…明明是部族人，对待自己的崇拜对象这么随意的吗…",
            "nextDialogs": [
              "750050515"
            ]
          },
          "750050515": {
            "id": "750050515",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "那是你们的幸运，若是遇到个严格一点的部族人，你们可就要吃处罚咯！",
            "nextDialogs": [
              "750050516"
            ]
          },
          "750050516": {
            "id": "750050516",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇啊，我才不要！",
            "nextDialogs": [
              "750050517"
            ]
          },
          "750050517": {
            "id": "750050517",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "还有你，小家伙，下次可不许再把这里的东西挖出来了！",
            "nextDialogs": [
              "750050518"
            ]
          },
          "750050518": {
            "id": "750050518",
            "speakerId": 1001,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔…",
            "nextDialogs": [
              "750050519"
            ]
          },
          "750050519": {
            "id": "750050519",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "嘿嘿，我们还是快点离开这里吧，趁还没有别的什么祖先被我们激怒！"
          }
        }
      }
    },
    {
      "subId": "7500503",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750050301"
        ],
        "dialogs": {
          "750050301": {
            "id": "750050301",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "嗯…按照从前部族里流传的说法，要进入祭坛的话，就得…<color=#00E1FFFF>「让此处的灯相平齐」</color>…",
            "nextDialogs": [
              "750050302"
            ]
          },
          "750050302": {
            "id": "750050302",
            "speakerId": 1003,
            "speakerName": "雷格巴",
            "text": "虽然不是特别清楚，但是，大概是要让机关控制的灯，高度变得一致？"
          }
        }
      }
    }
  ]
}
    {
      "subId": "7081902",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708190201"
        ],
        "dialogs": {
          "708190201": {
            "id": "708190201",
            "speakerId": 1788,
            "speakerName": "汉娜洛蕾",
            "text": "谢谢你的慷慨。只不过，我是西风教会的修女，不能收下来自他人的财物。",
            "nextDialogs": [
              "708190202"
            ]
          },
          "708190202": {
            "id": "708190202",
            "speakerId": 1788,
            "speakerName": "汉娜洛蕾",
            "text": "对我而言，能借着海风嗅到这般美妙的芬芳，便已经足够了。将美好的事物留给风，而非独自占有，才是虔信者应行之事。",
            "nextDialogs": [
              "708190203"
            ]
          },
          "708190203": {
            "id": "708190203",
            "speakerId": 1788,
            "speakerName": "汉娜洛蕾",
            "text": "不过，你这份如南风般和煦的善意，我确切地收到了。作为回礼，请你收下这本书吧。",
            "nextDialogs": [
              "708190204"
            ]
          },
          "708190204": {
            "id": "708190204",
            "speakerId": 1788,
            "speakerName": "汉娜洛蕾",
            "text": "愿风神护佑你。愿你未来的道路，也能如这香氛一般，盈满美德、自由与仁爱。"
          }
        }
      }
    },
    {

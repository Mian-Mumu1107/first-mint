  "subQuests": [
    {
      "subId": "7166901",
      "subQuestName": "和振尘对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716690101"
        ],
        "dialogs": {
          "716690101": {
            "id": "716690101",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "#{NICKNAME}，听工作人员们说，所有安装了发讯装置的小动物都被你找到了。",
            "nextDialogs": [
              "716690102"
            ]
          },
          "716690102": {
            "id": "716690102",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "有点意外啊，有些动物天性敏感，在陌生生物靠近时会立刻逃走。",
            "nextDialogs": [
              "716690103"
            ]
          },
          "716690103": {
            "id": "716690103",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "但它们并不排斥你的接近，真是奇事。",
            "nextDialogs": [
              "716690106"
            ]
          },
          "716690106": {
            "id": "716690106",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "哈哈，你这能力很让人嫉妒啊。",
            "nextDialogs": [
              "716690107"
            ]
          },
          "716690107": {
            "id": "716690107",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "之前好几次，工作人员陪着我一起去给动物喂食的时候，我不是被吼就是挨咬。",
            "nextDialogs": [
              "716690112"
            ]
          },
          "716690112": {
            "id": "716690112",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "胳膊上留了好几道疤，还挺疼的。",
            "nextDialogs": [
              "716690113"
            ]
          },
          "716690113": {
            "id": "716690113",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "不过呢，虽然它们对我一点都不亲近，但能看到这些可爱的生灵好好地活着，我就觉得很满足了。",
            "nextDialogs": [
              "716690114"
            ]
          },
          "716690114": {
            "id": "716690114",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "对所有认养人来说也是这样，大家都希望在不惊扰到动物们的前提下，保护好它们的生存环境。",
            "nextDialogs": [
              "716690115"
            ]
          },
          "716690115": {
            "id": "716690115",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "我知道对许多冒险家来说，野生动物是重要的食物来源，我们也并不会要求「伴爪同行」的成员完全不杀生。",
            "nextDialogs": [
              "716690116"
            ]
          },
          "716690116": {
            "id": "716690116",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "我们提倡的原则是不滥杀滥捕，如果每个人都能做到这一点，我们身边的环境一定会变得更丰富更美好。",
            "nextDialogs": [
              "716690117"
            ]
          },
          "716690117": {
            "id": "716690117",
            "speakerId": 30673,
            "speakerName": "振尘",
            "text": "#作为我们的成员，如果{NICKNAME}你也能认同并接受这个原则就太好了。"
          }
        }
      }
    },
    {
      "subId": "7166902",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716690201"
        ],
        "dialogs": {
          "716690201": {
            "id": "716690201",
            "speakerId": 13356,
            "speakerName": "拉米雅",
            "text": "「铭随流镜」还有可以改进的地方…下次加点功能试试看。"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2400701",
      "subQuestName": "与洛薇对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240070101"
        ],
        "dialogs": {
          "240070101": {
            "id": "240070101",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "洛薇？你找到什么好东西了吗？",
            "nextDialogs": [
              "240070102"
            ]
          },
          "240070102": {
            "id": "240070102",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "没有呀，这里什么也没有！",
            "nextDialogs": [
              "240070103"
            ]
          },
          "240070103": {
            "id": "240070103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在做什么呢？",
            "nextDialogs": [
              "240070104"
            ]
          },
          "240070104": {
            "id": "240070104",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "#{M#大哥哥}{F#大姐姐}，我们正在「寻宝」呢，嘿嘿…你要不要和我们一起呀？",
            "nextDialogs": [
              "240070106",
              "240070109"
            ]
          },
          "240070106": {
            "id": "240070106",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "别听韦吕吹牛啦，其实我们就是想在这里捞一些零件上来。",
            "nextDialogs": [
              "240070107"
            ]
          },
          "240070107": {
            "id": "240070107",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "这些零件就是宝物…咦？这里应该有啊…",
            "nextDialogs": [
              "240070114"
            ]
          },
          "240070114": {
            "id": "240070114",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "唔…看来这里是找不到了，我换个地方吧？",
            "nextDialogs": [
              "240070115"
            ]
          },
          "240070115": {
            "id": "240070115",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "行！我们再往前面走走。"
          },
          "240070109": {
            "id": "240070109",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "哥哥去城里找德勒吕叔叔啦，他说有些问题想要请教。",
            "nextDialogs": [
              "240070110"
            ]
          },
          "240070110": {
            "id": "240070110",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "我们呢，就只能乖乖听话不乱跑…一直在这里「寻宝」啦。",
            "nextDialogs": [
              "240070111"
            ]
          },
          "240070111": {
            "id": "240070111",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "#嘿嘿…{M#大哥哥}{F#大姐姐}要不要和我们一起呀？",
            "nextDialogs": [
              "240070112"
            ]
          },
          "240070112": {
            "id": "240070112",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "别听韦吕吹牛啦，其实我们就是想在这里捞一些零件上来。",
            "nextDialogs": [
              "240070113"
            ]
          },
          "240070113": {
            "id": "240070113",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "这些零件就是宝物…咦？这里应该有啊…"
          }
        }
      }
    },
    {
      "subId": "2400702",
      "subQuestName": "寻找「宝物」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240070201"
        ],
        "dialogs": {
          "240070201": {
            "id": "240070201",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "只有一些烂纸板啊…没有零件。",
            "nextDialogs": [
              "240070202"
            ]
          },
          "240070202": {
            "id": "240070202",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "奇怪，我昨天才在这里捞出来了好几枚齿轮的。"
          }
        }
      }
    },
    {
      "subId": "2400703",
      "subQuestName": "寻找「宝物」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240070301"
        ],
        "dialogs": {
          "240070301": {
            "id": "240070301",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "找到啦！这枚齿轮很完整，你看，还有一整根轴承呢。",
            "nextDialogs": [
              "240070302"
            ]
          },
          "240070302": {
            "id": "240070302",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "太好了，这些都能用上！"
          }
        }
      }
    },
    {
      "subId": "2400704",
      "subQuestName": "寻找「宝物」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240070401"
        ],
        "dialogs": {
          "240070401": {
            "id": "240070401",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "这是…破衣服？都泡掉色了…",
            "nextDialogs": [
              "240070402"
            ]
          },
          "240070402": {
            "id": "240070402",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "这里难道被人捞过了吗？怎么什么零件都没有…"
          }
        }
      }
    },
    {
      "subId": "2400705",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240070501"
        ],
        "dialogs": {
          "240070501": {
            "id": "240070501",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "我看看…这枚齿轮可以用，这个轴承如果锯开的话…",
            "nextDialogs": [
              "240070502"
            ]
          },
          "240070502": {
            "id": "240070502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你找这个做什么？",
            "nextDialogs": [
              "240070503"
            ]
          },
          "240070503": {
            "id": "240070503",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "我想要自己做一个发条人偶。其实…我之前一直在悄悄地学习相关的知识啦。",
            "nextDialogs": [
              "240070504"
            ]
          },
          "240070504": {
            "id": "240070504",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "等我学好了，就要做一个大大的发条机关，给爸爸一个惊喜！",
            "nextDialogs": [
              "240070505"
            ]
          },
          "240070505": {
            "id": "240070505",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "我去爸爸房里看了好多书，也按照书上的方法做过一些简单的部件了。",
            "nextDialogs": [
              "240070506"
            ]
          },
          "240070506": {
            "id": "240070506",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "只要再加把劲，我一定能完成我想做的那个发条机关！",
            "nextDialogs": [
              "240070507"
            ]
          },
          "240070507": {
            "id": "240070507",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "但我可不能在城里研究发条和机械，否则马上就会被我爸爸发现，那样就给不了他惊喜了。",
            "nextDialogs": [
              "240070508"
            ]
          },
          "240070508": {
            "id": "240070508",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "所以，这里就成了洛薇研究发条机械的秘密基地啦，而我嘛…就是她的助手。",
            "nextDialogs": [
              "240070509"
            ]
          },
          "240070509": {
            "id": "240070509",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "多说无益，助手！开始研究吧！今天我们必须做出一个能动的机关胳膊！",
            "nextDialogs": [
              "240070510"
            ]
          },
          "240070510": {
            "id": "240070510",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "是！开始研究吧！"
          }
        }
      }
    },

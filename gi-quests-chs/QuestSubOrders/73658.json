        ],
        "dialogs": {
          "736580201": {
            "id": "736580201",
            "speakerId": 4061,
            "speakerName": "库洛什",
            "text": "谢谢你，它们真完美。要是我下次的演出也能像它们一样无可挑剔，那就太好了。"
          }
        }
      }
    }

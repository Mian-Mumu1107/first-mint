        "dialogs": {
          "736580101": {
            "id": "736580101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于须弥蔷薇…",
            "nextDialogs": [
              "736580102"
            ]
          },
          "736580102": {
            "id": "736580102",
            "speakerId": 4061,
            "speakerName": "库洛什",
            "text": "你是来送须弥蔷薇的吧，我正想看看新鲜美丽的花换换心情。",
            "nextDialogs": [
              "736580103"
            ]
          },
          "736580103": {
            "id": "736580103",
            "speakerId": 4061,
            "speakerName": "库洛什",
            "text": "那，十朵须弥蔷薇你都准备好了吗？准备好了的话，一起给我就好。",
            "nextDialogs": [
              "736580105"
            ]
          },
          "736580105": {
            "id": "736580105",
            "speakerId": 4061,
            "speakerName": "库洛什",
            "text": "唉，无情的生活，连鲜花都抛弃了我。"
          }
        }
      }
    },
    {
      "subId": "7365802",
      "subQuestName": "与库洛什对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {

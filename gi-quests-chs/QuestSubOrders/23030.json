    {
      "subId": "2303004",
      "subQuestName": "与拉德普对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230300401"
        ],
        "dialogs": {
          "230300401": {
            "id": "230300401",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "还好箱子里的药水罐没被打破，不然我们非得大吐特吐不可…",
            "nextDialogs": [
              "230300402"
            ]
          },
          "230300402": {
            "id": "230300402",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "你居然不习惯这种味道？这可都是你亲自做的。",
            "nextDialogs": [
              "230300403"
            ]
          },
          "230300403": {
            "id": "230300403",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "我和你解释了多少次了，我加入的是生理催吐剂！",
            "nextDialogs": [
              "230300404"
            ]
          },
          "230300404": {
            "id": "230300404",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "和习不习惯没关系，只要人一闻到，身体就会自行做出呕吐反应。",
            "nextDialogs": [
              "230300405"
            ]
          },
          "230300405": {
            "id": "230300405",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "我为什么要再重复一遍，你绝对听不懂…",
            "nextDialogs": [
              "230300406"
            ]
          },
          "230300406": {
            "id": "230300406",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "不过，雅丝敏到底跑哪里去了？药水也没播撒…",
            "nextDialogs": [
              "230300407"
            ]
          },
          "230300407": {
            "id": "230300407",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "她一定又是发现了什么珍稀植物，忙着去采标本了。你还不知道她们阿弥利多的德行吗？",
            "nextDialogs": [
              "230300408"
            ]
          },
          "230300408": {
            "id": "230300408",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "好吧，这罐药物就由我们先看着，谢谢你帮忙，旅行者，这些东西请你收下吧。",
            "nextDialogs": [
              "230300409"
            ]
          },
          "230300409": {
            "id": "230300409",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "这群阿弥利多…真的是…"
          }
        }
      }
    },
    {
      "subId": "2303005",
      "subQuestName": "与拉德普对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230300501"
        ],
        "dialogs": {
          "230300501": {
            "id": "230300501",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "咳咳咳，咳咳…在这里应该可以了…",
            "nextDialogs": [
              "230300502"
            ]
          },
          "230300502": {
            "id": "230300502",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "呜…呕…你…这都是你的手笔！你居然也会呕吐？",
            "nextDialogs": [
              "230300503"
            ]
          },
          "230300503": {
            "id": "230300503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "呃…咳…咳咳…",
            "nextDialogs": [
              "230300504"
            ]
          },
          "230300504": {
            "id": "230300504",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "我和你…和你…解释了多少次了，我加入的是生理催吐剂！",
            "nextDialogs": [
              "230300505"
            ]
          },
          "230300505": {
            "id": "230300505",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "和习不习惯没关系，只要人一闻到，身体就会自行做出呕吐反应。",
            "nextDialogs": [
              "230300506"
            ]
          },
          "230300506": {
            "id": "230300506",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "我为什么要再重复一遍，你绝对听不懂…唔…呃…",
            "nextDialogs": [
              "230300507"
            ]
          },
          "230300507": {
            "id": "230300507",
            "speakerId": 1003,
            "speakerName": "雅丝敏",
            "text": "咦？拉德普和法尔希，还有旅行者？你们怎么来了？",
            "nextDialogs": [
              "230300508"
            ]
          },
          "230300508": {
            "id": "230300508",
            "speakerId": 1003,
            "speakerName": "雅丝敏",
            "text": "药水罐也破了…你们被魔物袭击了吗？",
            "nextDialogs": [
              "230300509"
            ]
          },
          "230300509": {
            "id": "230300509",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "从表面上来看…确实是这样，你来的时候没看见魔物吗？",
            "nextDialogs": [
              "230300510"
            ]
          },
          "230300510": {
            "id": "230300510",
            "speakerId": 1003,
            "speakerName": "雅丝敏",
            "text": "没有啊，我还抽空去旁边采了几株植物做标本呢。",
            "nextDialogs": [
              "230300511"
            ]
          },
          "230300511": {
            "id": "230300511",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "这可真是奇怪…非常奇怪。",
            "nextDialogs": [
              "230300512"
            ]
          },
          "230300512": {
            "id": "230300512",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "别奇怪了！那些魔物就是被你制作的药水吸引过来的！",
            "nextDialogs": [
              "230300513"
            ]
          },
          "230300513": {
            "id": "230300513",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "啥？！但之前的田野试验都没出现过这种情况…",
            "nextDialogs": [
              "230300514"
            ]
          },
          "230300514": {
            "id": "230300514",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "那你现在见到了，你能不能务实一点！",
            "nextDialogs": [
              "230300515"
            ]
          },
          "230300515": {
            "id": "230300515",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "我们等会来讨论这个问题…旅行者，谢谢你帮忙，这些报酬请你收下。",
            "nextDialogs": [
              "230300516"
            ]
          },
          "230300516": {
            "id": "230300516",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "到底是哪里出了问题…"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2303001",
      "subQuestName": "与拉德普对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230300101"
        ],
        "dialogs": {
          "230300101": {
            "id": "230300101",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "我们需要，更多的数据！",
            "nextDialogs": [
              "230300102"
            ]
          },
          "230300102": {
            "id": "230300102",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "你的这些装置没有数据支撑，怎么可能正常运行？",
            "nextDialogs": [
              "230300103"
            ]
          },
          "230300103": {
            "id": "230300103",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "你想把所有数据都搜集地尽善尽美了再动手？",
            "nextDialogs": [
              "230300104"
            ]
          },
          "230300104": {
            "id": "230300104",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "你捉鱼的时候需要看准每一道波浪吗？你只需要看准下面有鱼的那一条就行了 ！",
            "nextDialogs": [
              "230300105"
            ]
          },
          "230300105": {
            "id": "230300105",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "这就是你永远也抓不上鱼的原因。",
            "nextDialogs": [
              "230300106"
            ]
          },
          "230300106": {
            "id": "230300106",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "你又没在室罗婆耽进修过！别掐字眼了，咱们必须得先干起来。",
            "nextDialogs": [
              "230300107"
            ]
          },
          "230300107": {
            "id": "230300107",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "再拖下去，咱们和雅丝敏的论文说不定就要失去时效性了！",
            "nextDialogs": [
              "230300108"
            ]
          },
          "230300108": {
            "id": "230300108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在吵什么呢？",
            "nextDialogs": [
              "230300109"
            ]
          },
          "230300109": {
            "id": "230300109",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "你是…",
            "nextDialogs": [
              "230300110"
            ]
          },
          "230300110": {
            "id": "230300110",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "这位一定是雅丝敏提到过的旅行者，您帮了我们不少忙。",
            "nextDialogs": [
              "230300111"
            ]
          },
          "230300111": {
            "id": "230300111",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "幸会！旅行者，真是幸会！",
            "nextDialogs": [
              "230300112"
            ]
          },
          "230300112": {
            "id": "230300112",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "我叫法尔希，现在正在刹诃伐罗学院求学。",
            "nextDialogs": [
              "230300113"
            ]
          },
          "230300113": {
            "id": "230300113",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "我是拉德普，是悉般多摩学院的学生。",
            "nextDialogs": [
              "230300114"
            ]
          },
          "230300114": {
            "id": "230300114",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "旅行者，我们也想请你来帮一个忙。",
            "nextDialogs": [
              "230300115"
            ]
          },
          "230300115": {
            "id": "230300115",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "你知道雅丝敏最近正在这种「圣树」的根系周围播撒药水吧？",
            "nextDialogs": [
              "230300116"
            ]
          },
          "230300116": {
            "id": "230300116",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "不过…呃…最近雅丝敏撒的药水好像出了点问题…",
            "nextDialogs": [
              "230300117"
            ]
          },
          "230300117": {
            "id": "230300117",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "在她投药的区域周围，总是会出现各种各样的魔物。",
            "nextDialogs": [
              "230300118"
            ]
          },
          "230300118": {
            "id": "230300118",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "我发誓，我绝对没有修改任何配方或者投药比例。一定是…呃，出现了什么预期外的情况。",
            "nextDialogs": [
              "230300119"
            ]
          },
          "230300119": {
            "id": "230300119",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "随你怎么说…总之，旅行者，请你和我们一同去雅丝敏播撒药物的地方看一看吧。",
            "nextDialogs": [
              "230300120"
            ]
          },
          "230300120": {
            "id": "230300120",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "那边说不定又出现了不少魔物，我们可不敢自己过去…必须得找个武力高强的人同行。",
            "nextDialogs": [
              "230300121"
            ]
          },
          "230300121": {
            "id": "230300121",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "更重要的是，就算那些蕈兽没什么太大危险性，但要是导师知道我们的药水出了这种问题…",
            "nextDialogs": [
              "230300122"
            ]
          },
          "230300122": {
            "id": "230300122",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "我们这篇论文的开题报告一定会被打回来…",
            "nextDialogs": [
              "230300123"
            ]
          },
          "230300123": {
            "id": "230300123",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "特别是我们悉般多摩学院，如果提交上去的数据有错误，导师会骂死我们的。",
            "nextDialogs": [
              "230300126"
            ]
          },
          "230300126": {
            "id": "230300126",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "我们一般会雇佣冒险家，或者是去找我们的导师，请他出面，找几个信得过的镀金旅团成员帮忙。",
            "nextDialogs": [
              "230300127"
            ]
          },
          "230300127": {
            "id": "230300127",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "但我们导师的耐心也是有限的，现在这种情况，我们也不敢再去找他了…",
            "nextDialogs": [
              "230300128"
            ]
          },
          "230300128": {
            "id": "230300128",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "所以，只能拜托你了！旅行者！"
          }
        }
      }
    },

    {
      "subId": "2303002",
      "subQuestName": "与拉德普同行",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230300201"
        ],
        "dialogs": {
          "230300201": {
            "id": "230300201",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "喔！看那个箱子，里面应该装着那些药水吧，看来雅丝敏应该已经来过这里了。",
            "nextDialogs": [
              "230300202"
            ]
          },
          "230300202": {
            "id": "230300202",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "咦？箱子上这些药水的盖子还没打开…",
            "nextDialogs": [
              "230300203"
            ]
          },
          "230300203": {
            "id": "230300203",
            "speakerId": 1001,
            "speakerName": "法尔希",
            "text": "别把盖子打开！",
            "nextDialogs": [
              "230300204"
            ]
          },
          "230300204": {
            "id": "230300204",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "呜啊！看后面，有蕈兽钻出来了！",
            "nextDialogs": [
              "230300205"
            ]
          },
          "230300205": {
            "id": "230300205",
            "speakerId": 1000,
            "speakerName": "拉德普",
            "text": "啥？！之前还没有呢？这到底是怎么回事！",
            "nextDialogs": [
              "230300206"
            ]
          },
          "230300206": {
            "id": "230300206",
            "speakerId": 1002,
            "speakerName": "派蒙",
            "text": "#别听他们唠叨了，{NICKNAME}，我们快点上吧！"
          }
        }
      }
    },
    {
      "subId": "2303003",

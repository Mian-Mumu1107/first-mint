    {
      "subId": "4005512",
      "subQuestName": "(test)播放翠光CG$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4005513",
      "subQuestName": "前往五歌仙广场与阿贝多对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400551101"
        ],
        "dialogs": {
          "400551101": {
            "id": "400551101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不愧是阿贝多，果然赶在容彩祭开幕前就画好了第一幅。",
            "nextDialogs": [
              "400551102"
            ]
          },
          "400551102": {
            "id": "400551102",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "真不错，不仅很有稻妻风格，也很符合现代人的审美。尤其是画布上的我，即使在熟睡，也看起来非常风度翩翩。",
            "nextDialogs": [
              "400551103"
            ]
          },
          "400551103": {
            "id": "400551103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，卖唱的，你不要太得意了，你只是当模特而已，画上这个人可并不是你。",
            "nextDialogs": [
              "400551104"
            ]
          },
          "400551104": {
            "id": "400551104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "阿贝多，接下来你要画什么？",
            "nextDialogs": [
              "400551105"
            ]
          },
          "400551105": {
            "id": "400551105",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "下一张，就是五歌仙之中的「葵之翁」了。",
            "nextDialogs": [
              "400551106"
            ]
          },
          "400551106": {
            "id": "400551106",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "阿贝多，这幅画稍等一阵再画怎么样？你们之后说不定还会见到「类似的东西」呢。",
            "nextDialogs": [
              "400551107"
            ]
          },
          "400551107": {
            "id": "400551107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "类似的东西？",
            "nextDialogs": [
              "400551108"
            ]
          },
          "400551108": {
            "id": "400551108",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "应该是指其他写着五歌仙故事的纸片。因为资料上说，流传的五歌仙故事一共有四篇，但现在出现的却只有一篇。",
            "nextDialogs": [
              "400551109"
            ]
          },
          "400551109": {
            "id": "400551109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们觉得，那个留下纸张的神秘人还会再出现？",
            "nextDialogs": [
              "400551110"
            ]
          },
          "400551110": {
            "id": "400551110",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "的确有这种可能性。而且，五歌仙故事本身也有一些令我在意的东西。",
            "nextDialogs": [
              "400551111"
            ]
          },
          "400551111": {
            "id": "400551111",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "比如资料里说，虽然有五位歌仙，但曾经流传的故事却都是四篇一个系列。",
            "nextDialogs": [
              "400551112"
            ]
          },
          "400551112": {
            "id": "400551112",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "似乎所有的故事里，都没有「黑主」的独立篇章。",
            "nextDialogs": [
              "400551113"
            ]
          },
          "400551113": {
            "id": "400551113",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "你在意的这些内容，其实我也有些好奇。不过蒙德有句古话：「风带来故事的种子，时间使其发芽」。",
            "nextDialogs": [
              "400551114"
            ]
          },
          "400551114": {
            "id": "400551114",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "现在，就让我们一起慢慢等待吧。"
          }
        }
      }
    },
    {
      "subId": "4005504",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400550401"
        ],
        "dialogs": {
          "400550401": {
            "id": "400550401",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "……",
            "nextDialogs": [
              "400550402"
            ]
          },
          "400550402": {
            "id": "400550402",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "……",
            "nextDialogs": [
              "400550403"
            ]
          },
          "400550403": {
            "id": "400550403",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，你你你…你怎么会在这里？！",
            "nextDialogs": [
              "400550404"
            ]
          },
          "400550404": {
            "id": "400550404",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "天领奉行执行公务，我当然会在这里。",
            "nextDialogs": [
              "400550405"
            ]
          },
          "400550405": {
            "id": "400550405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不，裟罗，我不是说你啦——",
            "nextDialogs": [
              "400550406"
            ]
          },
          "400550406": {
            "id": "400550406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "卖唱的，仓库里那个可疑的外国人，该不会就是你吧！",
            "nextDialogs": [
              "400550407"
            ]
          },
          "400550407": {
            "id": "400550407",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "欸嘿，不好意思，从结果来看确实是我了。",
            "nextDialogs": [
              "400550408"
            ]
          },
          "400550408": {
            "id": "400550408",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "嫌疑人，我应该告诉过你，在你的盗窃与偷渡嫌疑查清前，请不要随意开口。",
            "nextDialogs": [
              "400550409"
            ]
          },
          "400550409": {
            "id": "400550409",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "旅行者，派蒙，你们认识这个自称吟游诗人的蒙德人？",
            "nextDialogs": [
              "400550412"
            ]
          },
          "400550412": {
            "id": "400550412",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "裟罗，凭我们对他的了解，盗窃这件事应该跟他没关系。不过…「偷渡」又是怎么回事啦？！",
            "nextDialogs": [
              "400550413"
            ]
          },
          "400550413": {
            "id": "400550413",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "他虽然自称是容彩祭的嘉宾，但是却拿不出邀请函，我们因此怀疑他是偷渡入境的。",
            "nextDialogs": [
              "400550414"
            ]
          },
          "400550414": {
            "id": "400550414",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "毕竟刚才，是在远航之风装蒲公英酒的货箱里发现他的。",
            "nextDialogs": [
              "400550415"
            ]
          },
          "400550415": {
            "id": "400550415",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们可以问他几句话吗？",
            "nextDialogs": [
              "400550416"
            ]
          },
          "400550416": {
            "id": "400550416",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "如果有利于查清事件的话，请吧。",
            "nextDialogs": [
              "400550417"
            ]
          },
          "400550417": {
            "id": "400550417",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "温迪，你该不会…真是偷渡来的吧？",
            "nextDialogs": [
              "400550418"
            ]
          },
          "400550418": {
            "id": "400550418",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哇，我们都这么久没见了，结果刚一重逢，就被你们用这种怀疑的目光打量。",
            "nextDialogs": [
              "400550419"
            ]
          },
          "400550419": {
            "id": "400550419",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "唉，之前听说你们也是用差不多的办法抵达稻妻的，还以为我们可以彼此理解呢…",
            "nextDialogs": [
              "400550420"
            ]
          },
          "400550420": {
            "id": "400550420",
            "speakerId": 1038,
            "speakerName": "九条裟罗",
            "text": "「差不多的办法」？"
          },
          "400550461": {
            "id": "400550461",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在鞋子里？",
            "nextDialogs": [
              "400550462"
            ]
          },
          "400550462": {
            "id": "400550462",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂，怎么可能，邀请函不是挺大的嘛。再说了，如果放在鞋子里，走起路来怎么可能会感觉不到！",
            "nextDialogs": [
              "400550463"
            ]
          },
          "400550463": {
            "id": "400550463",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "哈哈，喝得太多偶尔会舌头有点麻，但还不至于影响到脚。",
            "nextDialogs": [
              "400550464"
            ]
          },
          "400550464": {
            "id": "400550464",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在披风里？",
            "nextDialogs": [
              "400550465"
            ]
          },
          "400550465": {
            "id": "400550465",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么可能嘛，披风根本就没有收纳物品的空间。不过这听起来倒是个不错的主意，温迪，下次你可以改造一下披风试试。",
            "nextDialogs": [
              "400550466"
            ]
          },
          "400550466": {
            "id": "400550466",
            "speakerId": 1001,
            "speakerName": "温迪",
            "text": "嗯，经常有人说披风这种东西除了好看之外一点用处都没有，这么一来对它的诟病就能减少了吧？"
          }
        }
      }
    },
    {
      "subId": "4005551",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400555101"
        ],
        "dialogs": {
          "400555101": {
            "id": "400555101",
            "speakerId": 3190,
            "speakerName": "村田",
            "text": "荒谷和黑田回稻妻城安排《沉秋拾剑录》的加印了，我会暂时在这里待命。",
            "nextDialogs": [
              "400555102"
            ]
          },
          "400555102": {
            "id": "400555102",
            "speakerId": 3190,
            "speakerName": "村田",
            "text": "当然，还是希望那些书能赶快找到，可不要真变成最差的情况啊。"
          }
        }
      }
    },
    {
      "subId": "4005562",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400556201"
        ],
        "dialogs": {
          "400556201": {
            "id": "400556201",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「枕玉」…听起来是个璃月人的名字，阿贝多，这本书的作者是什么样的人啊？",
            "nextDialogs": [
              "400556202"
            ]
          },
          "400556202": {
            "id": "400556202",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "我并没有见过他的面，不过听编辑说他的真实身份，其实是璃月飞云商会的二公子。",
            "nextDialogs": [
              "400556205"
            ]
          },
          "400556205": {
            "id": "400556205",
            "speakerId": 1018,
            "speakerName": "阿贝多",
            "text": "哦？难道你们认识他？",
            "nextDialogs": [
              "400556206"
            ]
          },
          "400556206": {
            "id": "400556206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "之前和他有些交情。",
            "nextDialogs": [
              "400556207"
            ]
          },
          "400556207": {
            "id": "400556207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没想到阿贝多竟然会和行秋一起出版了轻小说！",
            "nextDialogs": [
              "400556208"
            ]
          },
          "400556208": {
            "id": "400556208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过现在不是惊讶这个的时候，行秋如果知道自己的书不见了，一定会很难过吧。",
            "nextDialogs": [
              "400556209"
            ]
          },
          "400556209": {
            "id": "400556209",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我们也跟阿贝多一起去吧。"
          }
        }
      }
    },
    {
      "subId": "4005599",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400559901"
        ],
        "dialogs": {
          "400559901": {
            "id": "400559901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "按照「到港时刻表」上的信息，今天会有一艘船从蒙德来。",
            "nextDialogs": [
              "400559902"
            ]
          },
          "400559902": {
            "id": "400559902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "负责画五歌仙的画家，也应该在这艘船上。",
            "nextDialogs": [
              "400559903"
            ]
          },
          "400559903": {
            "id": "400559903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "时间差不多了，我们这就去港口吧。"
          }
        }
      }
    }
  ]
}
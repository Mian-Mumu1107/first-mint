      }
    },
    {
      "subId": "7000303",
      "subQuestName": "扫除房顶上的枯花堆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700030301"
        ],
        "dialogs": {
          "700030301": {
            "id": "700030301",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇…真的堆积了不少呢，快把这些花瓣堆清理干净吧。"
          }
        }
      }
    },
    {
      "subId": "7000304",
      "subQuestName": "扫除房顶上的枯花堆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700030401"
        ],
        "dialogs": {
          "700030401": {
            "id": "700030401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？是什么声音？好像是猫叫…",
            "nextDialogs": [
              "700030402"
            ]
          },
          "700030402": {
            "id": "700030402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不知道在哪…我们一边清理，一边留意一下吧。"
          }
        }
      }
    },
    {
      "subId": "7000305",
      "subQuestName": "扫除城墙上的枯花堆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700030501"
        ],
        "dialogs": {
          "700030501": {
            "id": "700030501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真的有只小猫呢，为什么会跑到这里来呢…",
            "nextDialogs": [
              "700030502"
            ]
          },
          "700030502": {
            "id": "700030502",
            "speakerId": 1002,
            "speakerName": "迷路的小猫",
            "text": "喵…喵…",
            "nextDialogs": [
              "700030505"
            ]
          },
          "700030505": {
            "id": "700030505",
            "speakerId": 1002,
            "speakerName": "迷路的小猫",
            "text": "喵，喵！",
            "nextDialogs": [
              "700030506"
            ]
          },
          "700030506": {
            "id": "700030506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯…我觉得它听不懂你在说什么…",
            "nextDialogs": [
              "700030507"
            ]
          },
          "700030507": {
            "id": "700030507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还是先把它抱下去吧，说不定阿拉米先生会知道它的主人是谁呢。"
          }
        }
      }
    },
    {
      "subId": "7000306",
      "subQuestName": "寻找小猫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700030601"
        ],
        "dialogs": {
          "700030601": {
            "id": "700030601",
            "speakerId": 1000,
            "speakerName": "阿拉米",
            "text": "实在抱歉，我好像没见到，如果真的看见的话，我应该有印象才对…",
            "nextDialogs": [
              "700030602"
            ]
          },
          "700030602": {
            "id": "700030602",
            "speakerId": 1003,
            "speakerName": "玛格丽特",
            "text": "是吗，那孩子一直很喜欢花瓣，我还以为它会追着花瓣跑到这来…",
            "nextDialogs": [
              "700030603"
            ]
          },
          "700030603": {
            "id": "700030603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们是在找猫吗？",
            "nextDialogs": [
              "700030604"
            ]
          },
          "700030604": {
            "id": "700030604",
            "speakerId": 1002,
            "speakerName": "迷路的小猫",
            "text": "喵…喵！",
            "nextDialogs": [
              "700030605"
            ]
          },
          "700030605": {
            "id": "700030605",
            "speakerId": 1003,
            "speakerName": "玛格丽特",
            "text": "这声音是…小蝴蝶？真是的，你跑到哪儿去了？",
            "nextDialogs": [
              "700030606"
            ]
          },
          "700030606": {
            "id": "700030606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "它跑到屋顶上去了。",
            "nextDialogs": [
              "700030607"
            ]
          },
          "700030607": {
            "id": "700030607",
            "speakerId": 1003,
            "speakerName": "玛格丽特",
            "text": "果然和我想的一样…多谢你了。小蝴蝶总喜欢追着花瓣到处跑，在这个满城都飘着花瓣的风花节，也格外让人头疼，幸好有你帮忙。",
            "nextDialogs": [
              "700030608"
            ]
          },
          "700030608": {
            "id": "700030608",
            "speakerId": 1003,
            "speakerName": "玛格丽特",
            "text": "下次你来「猫尾酒馆」的话，我可以请你喝一杯哦，啊，当然是不含酒的。",
            "nextDialogs": [
              "700030611"
            ]
          },
          "700030611": {
            "id": "700030611",
            "speakerId": 1003,
            "speakerName": "玛格丽特",
            "text": "呵呵，总之谢谢你了，那就回头再见啦。祝你风花节快乐。",
            "nextDialogs": [
              "700030612"
            ]
          },
          "700030612": {
            "id": "700030612",
            "speakerId": 1000,
            "speakerName": "阿拉米",
            "text": "没想到连猫也会被花瓣吸引，风花节还真是热闹…不过，还好是让你给找到了。",
            "nextDialogs": [
              "700030613"
            ]
          },
          "700030613": {
            "id": "700030613",
            "speakerId": 1000,
            "speakerName": "阿拉米",
            "text": "要是让我爬上城墙去找猫，我这膝盖可真的就吃不消了…",
            "nextDialogs": [
              "700030614"
            ]
          },
          "700030614": {
            "id": "700030614",
            "speakerId": 1000,
            "speakerName": "阿拉米",
            "text": "真是麻烦你了，这些谢礼请你收下吧。"
          }
        }
      }
    },

    {
      "subId": "7503508",
      "subQuestName": "向珠宝大师回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750350801"
        ],
        "dialogs": {
          "750350801": {
            "id": "750350801",
            "speakerId": 1001,
            "speakerName": "库拉霍",
            "text": "哎呀呀，我的工具回来了，真是太好了！",
            "nextDialogs": [
              "750350802"
            ]
          },
          "750350802": {
            "id": "750350802",
            "speakerId": 1001,
            "speakerName": "库拉霍",
            "text": "刚才没看清楚，真是一颗漂亮的宝石啊，像鸟爪一样透着肉色的黄…呸！不应该用那群坏东西来比喻。",
            "nextDialogs": [
              "750350803"
            ]
          },
          "750350803": {
            "id": "750350803",
            "speakerId": 1001,
            "speakerName": "库拉霍",
            "text": "像天刚蒙蒙亮，太阳初升，那种早晨一样的天色…嗯，这个形容还是不错的…",
            "nextDialogs": [
              "750350805",
              "750350807"
            ]
          },
          "750350805": {
            "id": "750350805",
            "speakerId": 1001,
            "speakerName": "库拉霍",
            "text": "我又不是叙事人，哎呀，只要能记住自然中美丽的颜色就好了…如何美丽地说出口可不是我的专业。",
            "nextDialogs": [
              "750350808"
            ]
          },
          "750350808": {
            "id": "750350808",
            "speakerId": 1001,
            "speakerName": "库拉霍",
            "text": "宝石就交给我吧，按照刚才说的，我会免费给你们加工，当作找回工具的谢礼，时间嘛…等到两天后来宝石铺里取吧！"
          },
          "750350807": {
            "id": "750350807",
            "speakerId": 1001,
            "speakerName": "库拉霍",
            "text": "哦？你也听说过采风啊？"
          }
        }
      }

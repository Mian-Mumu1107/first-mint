  },
  "subQuests": [
    {
      "subId": "7503501",
      "subQuestName": "(test)第二次进入营地$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750350101"
        ],
        "dialogs": {
          "750350101": {
            "id": "750350101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "请问…唔，你是库拉霍大师吗？",
            "nextDialogs": [
              "750350102"
            ]
          },
          "750350102": {
            "id": "750350102",
            "speakerId": 1001,
            "speakerName": "库拉霍",
            "text": "这倒确实是我的名字…",
            "nextDialogs": [
              "750350103"
            ]
          },
          "750350103": {
            "id": "750350103",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，原来你就是在采风的珠宝大师，我们是伊蜜推荐过来的！刚才看到你在盯着树看，难道这也是采风吗？",
            "nextDialogs": [
              "750350104"
            ]
          },
          "750350104": {
            "id": "750350104",
            "speakerId": 1001,
            "speakerName": "库拉霍",
            "text": "呃，其实…算了，现在已经不重要了，唉，你们是有什么事吗？",
            "nextDialogs": [
              "750350105"
            ]
          },
          "750350105": {
            "id": "750350105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#我们带来了一颗漂亮的宝石，想请你为我们的{REALNAME[ID(2)|SHOWHOST(true)]}加工一下！",
            "nextDialogs": [
              "750350106"
            ]
          },
          "750350106": {
            "id": "750350106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#嘿嘿，{REALNAME[ID(2)|SHOWHOST(true)]}，快把宝石拿出来吧！",
            "nextDialogs": [
              "750350107"
            ]
          },
          "750350107": {
            "id": "750350107",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！呀——",
            "nextDialogs": [
              "750350108"
            ]
          },
          "750350108": {
            "id": "750350108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸——",
            "nextDialogs": [
              "750350109"
            ]
          },
          "750350109": {
            "id": "750350109",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "#耳边传来鸟类的羽翅扑腾的声音…\\n等反应过来时一看，{REALNAME[ID(2)|SHOWHOST(true)]}的爪子里，已经失去了宝石的踪影。",
            "nextDialogs": [
              "750350110"
            ]
          },
          "750350110": {
            "id": "750350110",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔、唔嗯！",
            "nextDialogs": [
              "750350111"
            ]
          },
          "750350111": {
            "id": "750350111",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，等等，宝石呢？那么大的一颗宝石去哪了？",
            "nextDialogs": [
              "750350112"
            ]
          },
          "750350112": {
            "id": "750350112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好像被鸟衔走了…",
            "nextDialogs": [
              "750350113"
            ]
          },
          "750350113": {
            "id": "750350113",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么会这样，这里的鸟还抢东西的？太没有礼貌了！",
            "nextDialogs": [
              "750350114"
            ]
          },
          "750350114": {
            "id": "750350114",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "唔呀！唔呀！",
            "nextDialogs": [
              "750350115"
            ]
          },
          "750350115": {
            "id": "750350115",
            "speakerId": 1001,
            "speakerName": "库拉霍",
            "text": "其实，我刚才要说的就是这件事，就算宝石没被抢走，我也没办法帮你们雕刻了…",
            "nextDialogs": [
              "750350116"
            ]
          },
          "750350116": {
            "id": "750350116",
            "speakerId": 1001,
            "speakerName": "库拉霍",
            "text": "因为我的工具，也被这群该死的鸟抢走了啊！我刚才正是在仔仔细细挨个看，工具到底在哪只鸟的爪子里。",
            "nextDialogs": [
              "750350117"
            ]
          },
          "750350117": {
            "id": "750350117",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#还…还有这种事？好坏的坏鸟，{NICKNAME}，我们赶快去把宝石追回来吧！",
            "nextDialogs": [
              "750350118"
            ]
          },
          "750350118": {
            "id": "750350118",
            "speakerId": 1002,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "呀！",
            "nextDialogs": [
              "750350119"
            ]
          },
          "750350119": {
            "id": "750350119",
            "speakerId": 1001,
            "speakerName": "库拉霍",
            "text": "别忘了还有我的工具——"
          }
        }
      }
    },
    {
      "subId": "7503502",
      "subQuestName": "test收到命令切sceneTag$HIDDEN",
      "sceneId": null,
      "locations": [],

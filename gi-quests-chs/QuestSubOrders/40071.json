    {
      "subId": "4007114",
      "subQuestName": "聆听房间里的声音",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400711401"
        ],
        "dialogs": {
          "400711401": {
            "id": "400711401",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "欸？怎么换地方了，但又没回到海滩上？",
            "nextDialogs": [
              "400711402"
            ]
          },
          "400711402": {
            "id": "400711402",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这里似乎是蒙德的住宅呢。",
            "nextDialogs": [
              "400711403"
            ]
          },
          "400711403": {
            "id": "400711403",
            "speakerId": 1008,
            "speakerName": "菲谢尔",
            "text": "贵安，尊贵的「断罪之皇后」。",
            "nextDialogs": [
              "400711404"
            ]
          },
          "400711404": {
            "id": "400711404",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "小艾咪亲爱的，妈妈做了煎肉排和渔人吐司，快来趁热吃。",
            "nextDialogs": [
              "400711405"
            ]
          },
          "400711405": {
            "id": "400711405",
            "speakerId": 1008,
            "speakerName": "菲谢尔",
            "text": "咳咳！母后…",
            "nextDialogs": [
              "400711406"
            ]
          },
          "400711406": {
            "id": "400711406",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "噢噢，瞧我，都给忘了。咳！断罪之皇女，汝可知此刻正是午餐时分？",
            "nextDialogs": [
              "400711407"
            ]
          },
          "400711407": {
            "id": "400711407",
            "speakerId": 1008,
            "speakerName": "菲谢尔",
            "text": "当然了母后。",
            "nextDialogs": [
              "400711408"
            ]
          },
          "400711408": {
            "id": "400711408",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "噢——！窗外景色如此迷人，皇女，皇后，二位可否赏光与我这「断罪之皇帝」一同外出野餐？看看风景，享受上天恩赐的美味。",
            "nextDialogs": [
              "400711409"
            ]
          },
          "400711409": {
            "id": "400711409",
            "speakerId": 1008,
            "speakerName": "菲谢尔",
            "text": "是的，非常愿意！",
            "nextDialogs": [
              "400711410"
            ]
          },
          "400711410": {
            "id": "400711410",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "……",
            "nextDialogs": [
              "400711411"
            ]
          },
          "400711411": {
            "id": "400711411",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "……",
            "nextDialogs": [
              "400711412"
            ]
          },
          "400711412": {
            "id": "400711412",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "呃…那个，大家是不是都有话想说…",
            "nextDialogs": [
              "400711413"
            ]
          },
          "400711413": {
            "id": "400711413",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "400711414"
            ]
          },
          "400711414": {
            "id": "400711414",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "我直接问了，小艾咪…是菲谢尔的真名？",
            "nextDialogs": [
              "400711415"
            ]
          },
          "400711415": {
            "id": "400711415",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "应该是吧。刚才那两个声音，好像是她的爸爸妈妈。",
            "nextDialogs": [
              "400711416"
            ]
          },
          "400711416": {
            "id": "400711416",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "…看我干什么？！",
            "nextDialogs": [
              "400711417"
            ]
          },
          "400711417": {
            "id": "400711417",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "可能有点冒昧，但…你真的姓梅姬斯图斯吗？",
            "nextDialogs": [
              "400711418"
            ]
          },
          "400711418": {
            "id": "400711418",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "哼，你在小看我？本占星术士的全名是：阿斯托洛吉斯·莫娜·梅姬斯图斯。",
            "nextDialogs": [
              "400711419"
            ]
          },
          "400711419": {
            "id": "400711419",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "…对不起。",
            "nextDialogs": [
              "400711420"
            ]
          },
          "400711420": {
            "id": "400711420",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "好长！",
            "nextDialogs": [
              "400711421"
            ]
          },
          "400711421": {
            "id": "400711421",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "只有天才能拥有这个名字哦。",
            "nextDialogs": [
              "400711422"
            ]
          },
          "400711422": {
            "id": "400711422",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "总觉得没有道理…",
            "nextDialogs": [
              "400711423"
            ]
          },
          "400711423": {
            "id": "400711423",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "刚才那些，你们感觉如何？",
            "nextDialogs": [
              "400711424"
            ]
          },
          "400711424": {
            "id": "400711424",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "我确定了一件事，「合上书本」也是一种引起幻境变化的手段。",
            "nextDialogs": [
              "400711425"
            ]
          },
          "400711425": {
            "id": "400711425",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "菲谢尔的家人居然肯配合她，厉害啊。",
            "nextDialogs": [
              "400711426"
            ]
          },
          "400711426": {
            "id": "400711426",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "但也不会一直如此。听声音，这是她小时候的回忆吧？长大可就不是这样了。",
            "nextDialogs": [
              "400711427"
            ]
          },
          "400711427": {
            "id": "400711427",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "莫娜知道很多嘛！",
            "nextDialogs": [
              "400711428"
            ]
          },
          "400711428": {
            "id": "400711428",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "身为朋友知道这些很正常吧。",
            "nextDialogs": [
              "400711429"
            ]
          },
          "400711429": {
            "id": "400711429",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "…菲谢尔现在，会在哪里呢。",
            "nextDialogs": [
              "400711430"
            ]
          },
          "400711430": {
            "id": "400711430",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "刚才那个声音说她要出门，我们不如也出去看看，应该会有线索。"
          }
        }
      }
    },
    {
      "subId": "4007107",
      "subQuestName": "离开房间",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4007115",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400711501"
        ],
        "dialogs": {
          "400711501": {
            "id": "400711501",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，回来了。",
            "nextDialogs": [
              "400711502"
            ]
          },
          "400711502": {
            "id": "400711502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不对不对，怎么回来了呀！故事还没听完呢！",
            "nextDialogs": [
              "400711503"
            ]
          },
          "400711503": {
            "id": "400711503",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "这种感觉，糟透了，就像买到假冒伪劣占星教程，或是晚餐吃到一半发现忘带钱包…",
            "nextDialogs": [
              "400711504"
            ]
          },
          "400711504": {
            "id": "400711504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊——！",
            "nextDialogs": [
              "400711505"
            ]
          },
          "400711505": {
            "id": "400711505",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "啊——！好难受啊！",
            "nextDialogs": [
              "400711506"
            ]
          },
          "400711506": {
            "id": "400711506",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "她俩很受打击的样子。",
            "nextDialogs": [
              "400711507"
            ]
          },
          "400711507": {
            "id": "400711507",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "实不相瞒，我也不喜欢看被腰斩的书。",
            "nextDialogs": [
              "400711508"
            ]
          },
          "400711508": {
            "id": "400711508",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "哈哈，谁会喜欢啊。各位，我们再进一次幻境吧。",
            "nextDialogs": [
              "400711509"
            ]
          },
          "400711509": {
            "id": "400711509",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好主意！那我们现在就出发！",
            "nextDialogs": [
              "400711510"
            ]
          },
          "400711510": {
            "id": "400711510",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "…嗯？",
            "nextDialogs": [
              "400711511"
            ]
          },
          "400711511": {
            "id": "400711511",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "没反应，位置也没变。",
            "nextDialogs": [
              "400711512"
            ]
          },
          "400711512": {
            "id": "400711512",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "奇怪，刚才还能进的，现在就把我们拒之门外了。",
            "nextDialogs": [
              "400711513"
            ]
          },
          "400711513": {
            "id": "400711513",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "为什么！存心不让人看完这本书吗！太坏了吧！",
            "nextDialogs": [
              "400711514"
            ]
          },
          "400711514": {
            "id": "400711514",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "唔…是因为，这本书已经「读到最后」了吧。",
            "nextDialogs": [
              "400711515"
            ]
          },
          "400711515": {
            "id": "400711515",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "离开幻境前，我们见到的这本书被翻到了最后一页，我觉得，《圣国的咏唱》可能不止一本。",
            "nextDialogs": [
              "400711516"
            ]
          },
          "400711516": {
            "id": "400711516",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好像什么俗套轻小说的销售套路一样…欲知后事如何，请购买下卷，什么的。",
            "nextDialogs": [
              "400711517"
            ]
          },
          "400711517": {
            "id": "400711517",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "可恶，我一定要看到结局。",
            "nextDialogs": [
              "400711518"
            ]
          },
          "400711518": {
            "id": "400711518",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "噢，噢是的结局，大家都爱看书的结局呢。",
            "nextDialogs": [
              "400711519"
            ]
          },
          "400711519": {
            "id": "400711519",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "嗯？谁在那边？",
            "nextDialogs": [
              "400711520"
            ]
          },
          "400711520": {
            "id": "400711520",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "噢，噢天哪，她看见我了，立正立正。",
            "nextDialogs": [
              "400711521"
            ]
          },
          "400711521": {
            "id": "400711521",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "你是…",
            "nextDialogs": [
              "400711522"
            ]
          },
          "400711522": {
            "id": "400711522",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "我是「渴望被问路的阿诺德」。",
            "nextDialogs": [
              "400711523"
            ]
          },
          "400711523": {
            "id": "400711523",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "名字目的性太强了吧！",
            "nextDialogs": [
              "400711524"
            ]
          },
          "400711524": {
            "id": "400711524",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "阿诺德，我问你…",
            "nextDialogs": [
              "400711525"
            ]
          },
          "400711525": {
            "id": "400711525",
            "speakerId": 1009,
            "speakerName": "阿诺德",
            "text": "是「渴望被问路的阿诺德」，不是阿诺德！",
            "nextDialogs": [
              "400711526"
            ]
          },
          "400711526": {
            "id": "400711526",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "渴望被问路的阿诺德，我问你！",
            "nextDialogs": [
              "400711527"
            ]
          },
          "400711527": {
            "id": "400711527",
            "speakerId": 1009,
            "speakerName": "阿诺德",
            "text": "是的女士！",
            "nextDialogs": [
              "400711528"
            ]
          },
          "400711528": {
            "id": "400711528",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "《圣国的咏唱》有后续吗？在哪里？",
            "nextDialogs": [
              "400711529"
            ]
          },
          "400711529": {
            "id": "400711529",
            "speakerId": 1009,
            "speakerName": "阿诺德",
            "text": "噢，噢您可真是问对人了。《圣国的咏唱》是幽夜净土的圣典，共有三卷，其余两卷分别藏在王城的两处高地。",
            "nextDialogs": [
              "400711530"
            ]
          },
          "400711530": {
            "id": "400711530",
            "speakerId": 1009,
            "speakerName": "阿诺德",
            "text": "如果你们想找第二卷，得去高塔顶楼。",
            "nextDialogs": [
              "400711531"
            ]
          },
          "400711531": {
            "id": "400711531",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "高塔，是那边那座吗？",
            "nextDialogs": [
              "400711532"
            ]
          },
          "400711532": {
            "id": "400711532",
            "speakerId": 1009,
            "speakerName": "阿诺德",
            "text": "没错，那就是存放着圣典的塔楼。有条密道能让各位迅速抵达那里，只要你们在那边的山洞里仔细找找。",
            "nextDialogs": [
              "400711533"
            ]
          },
          "400711533": {
            "id": "400711533",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "好，谢谢你阿诺德。",
            "nextDialogs": [
              "400711534"
            ]
          },
          "400711534": {
            "id": "400711534",
            "speakerId": 1009,
            "speakerName": "阿诺德",
            "text": "是「渴望被问路的阿诺德」，不是阿诺德！",
            "nextDialogs": [
              "400711535"
            ]
          },
          "400711535": {
            "id": "400711535",
            "speakerId": 1009,
            "speakerName": "阿诺德",
            "text": "美丽的女士，您没有其他话要问我了吗？有没有女朋友、每月收入情况什么的…",
            "nextDialogs": [
              "400711536"
            ]
          },
          "400711536": {
            "id": "400711536",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "没有，再见！",
            "nextDialogs": [
              "400711537"
            ]
          },
          "400711537": {
            "id": "400711537",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "别理那只夜鸦了。前面山洞里有密道，能直达塔顶，我们走吧。",
            "nextDialogs": [
              "400711538"
            ]
          },
          "400711538": {
            "id": "400711538",
            "speakerId": 1009,
            "speakerName": "阿诺德",
            "text": "噢，噢女士！您当真对我不感兴趣？我可是看您如此美丽才愿意告诉您幽夜净土的秘密！女士！…"
          }
        }
      }
    },
    {
      "subId": "4007199",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400719902"
        ],
        "dialogs": {
          "400719902": {
            "id": "400719902",
            "speakerId": 1005,
            "speakerName": "旁白",
            "text": "「臣民欢呼朝拜皇女殿下的威能，遵循她呼唤，纷纷迁至该片后被称作『幽夜净土』的神圣国度之中。」",
            "nextDialogs": [
              "400719903"
            ]
          },
          "400719903": {
            "id": "400719903",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "还真是幽夜净土啊！",
            "nextDialogs": [
              "400719904"
            ]
          },
          "400719904": {
            "id": "400719904",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "看起来有模有样的，不错呢。",
            "nextDialogs": [
              "400719905"
            ]
          },
          "400719905": {
            "id": "400719905",
            "speakerId": 1005,
            "speakerName": "旁白",
            "text": "「我等建立圣国，奉皇女殿下为至高之人，又将诗歌、戏剧与冒险带入国度，使之成为幽夜净土之纲要。」"
          }
        }
      }
    }
  ]
}
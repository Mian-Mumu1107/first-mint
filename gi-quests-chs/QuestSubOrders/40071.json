    {
      "subId": "4007116",
      "subQuestName": "修复通往高塔的道路",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4007113",
      "subQuestName": "前往高塔顶部",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400711301"
        ],
        "dialogs": {
          "400711301": {
            "id": "400711301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "前面好像没有路了，只有一本书。",
            "nextDialogs": [
              "400711302"
            ]
          },
          "400711302": {
            "id": "400711302",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "我们刚才听到的，应该就是书里的故事吧？",
            "nextDialogs": [
              "400711303"
            ]
          },
          "400711303": {
            "id": "400711303",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "所以，书名中的圣国，指的就是幽夜净土。这本书是在用国民的口吻歌颂皇女殿下。",
            "nextDialogs": [
              "400711304"
            ]
          },
          "400711304": {
            "id": "400711304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也算是自传的一种吧…",
            "nextDialogs": [
              "400711305"
            ]
          },
          "400711305": {
            "id": "400711305",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "书已经翻到最后一页了，但它们的故事听起来还没结束。",
            "nextDialogs": [
              "400711306"
            ]
          },
          "400711306": {
            "id": "400711306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "后续呢？我想听后续！",
            "nextDialogs": [
              "400711307"
            ]
          },
          "400711307": {
            "id": "400711307",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "那就得继续探索了吧。比起这个，看完的书…还是先合上比较好。"
          }
        }
      }
    },
    {

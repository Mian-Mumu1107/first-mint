    {
      "subId": "4007102",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400710201"
        ],
        "dialogs": {
          "400710201": {
            "id": "400710201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "醒了吗？",
            "nextDialogs": [
              "400710202"
            ]
          },
          "400710202": {
            "id": "400710202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "唔…又是早上了…",
            "nextDialogs": [
              "400710203"
            ]
          },
          "400710203": {
            "id": "400710203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么样？出现什么了吗？",
            "nextDialogs": [
              "400710204"
            ]
          },
          "400710204": {
            "id": "400710204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说出来你可能不信，什么事都没发生。",
            "nextDialogs": [
              "400710205"
            ]
          },
          "400710205": {
            "id": "400710205",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "你醒啦？那我们直接说结论，四周都找过了，没有可疑的东西。",
            "nextDialogs": [
              "400710206"
            ]
          },
          "400710206": {
            "id": "400710206",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "按照之前两处幻境的规律，应该会有一件承担着「入口」职责的物品才对。",
            "nextDialogs": [
              "400710207"
            ]
          },
          "400710207": {
            "id": "400710207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就怪了。",
            "nextDialogs": [
              "400710208"
            ]
          },
          "400710208": {
            "id": "400710208",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "会不会是没到时候？",
            "nextDialogs": [
              "400710209"
            ]
          },
          "400710209": {
            "id": "400710209",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "你的意思是，再等等？",
            "nextDialogs": [
              "400710210"
            ]
          },
          "400710210": {
            "id": "400710210",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "嗯。而且，菲谢尔不在这里。我想，她很可能比我们更急着找到入口。",
            "nextDialogs": [
              "400710211"
            ]
          },
          "400710211": {
            "id": "400710211",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "我们等等吧。给幻境…不，给菲谢尔一点时间。",
            "nextDialogs": [
              "400710212"
            ]
          },
          "400710212": {
            "id": "400710212",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "大家赞同莫娜的说法，聚在一起喝茶休息。之后，又分为两队四处搜索。",
            "nextDialogs": [
              "400710213"
            ]
          },
          "400710213": {
            "id": "400710213",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "终于，在白白走了好几个来回后，海滩上突然多出了一些东西。",
            "nextDialogs": [
              "400710214"
            ]
          },
          "400710214": {
            "id": "400710214",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "有什么东西掉在沙滩上了！",
            "nextDialogs": [
              "400710215"
            ]
          },
          "400710215": {
            "id": "400710215",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "是一本书？旁边还有只…呃…乌鸦的雕像？",
            "nextDialogs": [
              "400710216"
            ]
          },
          "400710216": {
            "id": "400710216",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这尊雕像长得好像奥兹哦…",
            "nextDialogs": [
              "400710217"
            ]
          },
          "400710217": {
            "id": "400710217",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "一起出现是什么意思？这本书，是它送来的吗？",
            "nextDialogs": [
              "400710218"
            ]
          },
          "400710218": {
            "id": "400710218",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "这是什么？日记？",
            "nextDialogs": [
              "400710219"
            ]
          },
          "400710219": {
            "id": "400710219",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "我看看…《圣国的咏唱》？我都没见过叫这个名字的书。",
            "nextDialogs": [
              "400710220"
            ]
          },
          "400710220": {
            "id": "400710220",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "看封面，难道是…菲谢尔自己写的？",
            "nextDialogs": [
              "400710221"
            ]
          },
          "400710221": {
            "id": "400710221",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "这么一说确实像她的风格。《圣国的咏唱》，书名不错，我喜欢。",
            "nextDialogs": [
              "400710222"
            ]
          },
          "400710222": {
            "id": "400710222",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "这本书的名字，有种神圣感。",
            "nextDialogs": [
              "400710223"
            ]
          },
          "400710223": {
            "id": "400710223",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么样？要碰碰它吗？",
            "nextDialogs": [
              "400710224"
            ]
          },
          "400710224": {
            "id": "400710224",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "…还没回来。",
            "nextDialogs": [
              "400710225"
            ]
          },
          "400710225": {
            "id": "400710225",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "算了，我们先去看看吧。如果菲谢尔见到这本书，应该会来找我们。",
            "nextDialogs": [
              "400710226"
            ]
          },
          "400710226": {
            "id": "400710226",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我同意哦！就像被人偷看了日记一样，肯定要进来阻止我们的嘛。"
          }
        }
      }
    },
    {
      "subId": "4007117",
      "subQuestName": "(test)(hide)隐藏刷新雕像和书$HIDDEN",

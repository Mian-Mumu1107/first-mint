    {
      "subId": "4007103",
      "subQuestName": "与众人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400710301"
        ],
        "dialogs": {
          "400710301": {
            "id": "400710301",
            "speakerId": 1005,
            "speakerName": "旁白",
            "text": "「如今的国民无从忆起，但学者知道，远在早于圣徒时代约六百年的混沌期间，皇女殿下便已君临世间。」",
            "nextDialogs": [
              "400710302"
            ]
          },
          "400710302": {
            "id": "400710302",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "不会吧？旁白？",
            "nextDialogs": [
              "400710303"
            ]
          },
          "400710303": {
            "id": "400710303",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "不愧是书里的世界，竟然还有旁白给我们讲故事。",
            "nextDialogs": [
              "400710304"
            ]
          },
          "400710304": {
            "id": "400710304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "路断了，走不过去。",
            "nextDialogs": [
              "400710305"
            ]
          },
          "400710305": {
            "id": "400710305",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "那边有个装置，像是等着我们靠近一样。",
            "nextDialogs": [
              "400710306"
            ]
          },
          "400710306": {
            "id": "400710306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我总觉得…这里的一切是不是太过刻意了？",
            "nextDialogs": [
              "400710307"
            ]
          },
          "400710307": {
            "id": "400710307",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "是圣国嘛。体谅一下。",
            "nextDialogs": [
              "400710308"
            ]
          },
          "400710308": {
            "id": "400710308",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也是，这么明显，完全就是希望被人发现嘛。",
            "nextDialogs": [
              "400710309"
            ]
          },
          "400710309": {
            "id": "400710309",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "不愧是菲谢尔，在这种地方坦率得可怕。"
          }
        }
      }
    },

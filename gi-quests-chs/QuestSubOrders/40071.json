    {
      "subId": "4007110",
      "subQuestName": "寻找声音的来源",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400711001"
        ],
        "dialogs": {
          "400711001": {
            "id": "400711001",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "天哪，请救救我！",
            "nextDialogs": [
              "400711002"
            ]
          },
          "400711002": {
            "id": "400711002",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂，这不是个雕像吗？",
            "nextDialogs": [
              "400711003"
            ]
          },
          "400711003": {
            "id": "400711003",
            "speakerId": 1006,
            "speakerName": "？？？",
            "text": "请别这么说！我是幽夜净土的骑士，莱昂。",
            "nextDialogs": [
              "400711004"
            ]
          },
          "400711004": {
            "id": "400711004",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "骑士？完全看不出来。",
            "nextDialogs": [
              "400711005"
            ]
          },
          "400711005": {
            "id": "400711005",
            "speakerId": 1007,
            "speakerName": "莱昂",
            "text": "看不出吗？好吧。就算如此，也请各位不要怪罪为夜鸦骑士们设计配发盔甲的奥兹华尔多大人。",
            "nextDialogs": [
              "400711006"
            ]
          },
          "400711006": {
            "id": "400711006",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "奥兹华尔多大人。",
            "nextDialogs": [
              "400711007"
            ]
          },
          "400711007": {
            "id": "400711007",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "#{NICKNAME}应该听说过吧？奥兹的全名是奥兹华尔多·赫芙那梵茵斯。",
            "nextDialogs": [
              "400711010"
            ]
          },
          "400711010": {
            "id": "400711010",
            "speakerId": 1001,
            "speakerName": "辛焱",
            "text": "那还是梅姬斯图斯好念一点。",
            "nextDialogs": [
              "400711011"
            ]
          },
          "400711011": {
            "id": "400711011",
            "speakerId": 1002,
            "speakerName": "枫原万叶",
            "text": "嗯，我也这么想。",
            "nextDialogs": [
              "400711012"
            ]
          },
          "400711012": {
            "id": "400711012",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "啊哈哈，大家都这么说呢…",
            "nextDialogs": [
              "400711013"
            ]
          },
          "400711013": {
            "id": "400711013",
            "speakerId": 1007,
            "speakerName": "莱昂",
            "text": "各位朋友，打扰你们愉快的聊天时间实在非我所愿，只是，你们应该还不知道前面的大门上了锁。",
            "nextDialogs": [
              "400711014"
            ]
          },
          "400711014": {
            "id": "400711014",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "确实不知道呢。",
            "nextDialogs": [
              "400711015"
            ]
          },
          "400711015": {
            "id": "400711015",
            "speakerId": 1007,
            "speakerName": "莱昂",
            "text": "但愿好心的你们能动动手指将我救上去，作为报答，我非常愿意将打开大门的方法教给各位。",
            "nextDialogs": [
              "400711016"
            ]
          },
          "400711016": {
            "id": "400711016",
            "speakerId": 1003,
            "speakerName": "莫娜",
            "text": "你都这么说了…好吧。"
          }
        }
      }
    },
    {
      "subId": "4007111",
      "subQuestName": "帮助莱昂离开深井",
      "sceneId": null,

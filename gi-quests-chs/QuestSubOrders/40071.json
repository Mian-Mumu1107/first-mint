    {
      "subId": "4007112",
      "subQuestName": "与莱昂对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400711201"
        ],
        "dialogs": {
          "400711201": {
            "id": "400711201",
            "speakerId": 1007,
            "speakerName": "莱昂",
            "text": "英雄们，再多话语也无法诉说我此刻的激动。感谢你们。",
            "nextDialogs": [
              "400711202"
            ]
          },
          "400711202": {
            "id": "400711202",
            "speakerId": 1007,
            "speakerName": "莱昂",
            "text": "请记住，这是打开大门的口令：「令我的子民自由，不囿于古老法则。」"
          }
        }
      }
    },

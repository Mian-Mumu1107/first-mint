        "dialogs": {
          "726680101": {
            "id": "726680101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "真好啊，曾经追寻「海中月」的大家，也都算是完成了自己的心愿呢。",
            "nextDialogs": [
              "726680102"
            ]
          },
          "726680102": {
            "id": "726680102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都完成了吗？",
            "nextDialogs": [
              "726680103"
            ]
          },
          "726680103": {
            "id": "726680103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你看你看，嘉玮是不是找到了一个十分富有的妻子？",
            "nextDialogs": [
              "726680104"
            ]
          },
          "726680104": {
            "id": "726680104",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "楠塔克也因为那本揭秘「海中月」的书成了小有名气的作家了呢，虽然内容是错的。",
            "nextDialogs": [
              "726680105"
            ]
          },
          "726680105": {
            "id": "726680105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "鲸井椛更是稻妻最厉害的渔王了，而且今天还捕捉到了父亲都没有成功的「海中月」！",
            "nextDialogs": [
              "726680106"
            ]
          },
          "726680106": {
            "id": "726680106",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#所以我觉得啊，{NICKNAME}的愿望，也一定会实现！嘿嘿嘿！",
            "nextDialogs": [
              "726680107"
            ]
          },
          "726680107": {
            "id": "726680107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "小派蒙刚刚许下的愿望是什么呢？",
            "nextDialogs": [
              "726680108"
            ]
          },
          "726680108": {
            "id": "726680108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不能说不能说，说出来就不灵了！",
            "nextDialogs": [
              "726680109"
            ]
          },
          "726680109": {
            "id": "726680109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「海中月」不会这么小气的。",
            "nextDialogs": [
              "726680110"
            ]
          },
          "726680110": {
            "id": "726680110",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯——那好吧，听清楚哦，我就说一遍！",
            "nextDialogs": [
              "726680111"
            ]
          },
          "726680111": {
            "id": "726680111",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我的愿望就是实现你的愿望哦。",
            "nextDialogs": [
              "726680112"
            ]
          },
          "726680112": {
            "id": "726680112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "声音太小了，你说什么？",
            "nextDialogs": [
              "726680113"
            ]
          },
          "726680113": {
            "id": "726680113",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼哼，就说一遍，没听清就算了！我要买糖果去啰~啦啦啦~"
          }
        }
      }

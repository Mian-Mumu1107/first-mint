  "subQuests": [
    {
      "subId": "7605501",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760550101"
        ],
        "dialogs": {
          "760550101": {
            "id": "760550101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（<color=#FFCC33FF>菈乌玛</color>似乎听到了什么…）",
            "nextDialogs": [
              "760550102"
            ]
          },
          "760550102": {
            "id": "760550102",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "…奇怪。刚才听见了什么响动。",
            "nextDialogs": [
              "760550103"
            ]
          },
          "760550103": {
            "id": "760550103",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "（又有客人！转动轮盘，停下转盘，就有好吃的！）",
            "nextDialogs": [
              "760550104"
            ]
          },
          "760550104": {
            "id": "760550104",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "（咦？客人怎么不转呀，快点快点，想吃好吃的！）",
            "nextDialogs": [
              "760550105"
            ]
          },
          "760550105": {
            "id": "760550105",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "听起来，像是一只小狗…？转动轮盘，有好吃的…这又是什么意思…",
            "nextDialogs": [
              "760550106"
            ]
          },
          "760550106": {
            "id": "760550106",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "（客人！能和我说话，客人，快点转动轮盘吧，不然我就吃不到好吃的啦。）",
            "nextDialogs": [
              "760550107"
            ]
          },
          "760550107": {
            "id": "760550107",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "你饿了么？来，我带着一些饼干，先吃一点吧。",
            "nextDialogs": [
              "760550108"
            ]
          },
          "760550108": {
            "id": "760550108",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "（呜？客人不转轮盘，客人要给我吃的…嗯，先吃，先吃。）",
            "nextDialogs": [
              "760550109"
            ]
          },
          "760550109": {
            "id": "760550109",
            "speakerId": 7145,
            "speakerName": "巴甫洛夫",
            "text": "（谢谢客人，我是巴甫洛夫，谢谢客人的饼干，好吃好吃。但你没有转动轮盘呢。）",
            "nextDialogs": [
              "760550110"
            ]
          },
          "760550110": {
            "id": "760550110",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "不用客气，但…你刚才说的转盘，是什么意思呢？",
            "nextDialogs": [
              "760550111"
            ]
          },
          "760550111": {
            "id": "760550111",
            "speakerId": 7145,
            "speakerName": "巴甫洛夫",
            "text": "（转盘动了，让它停下，好吃的会掉下来，每次都是这样。）",
            "nextDialogs": [
              "760550112"
            ]
          },
          "760550112": {
            "id": "760550112",
            "speakerId": 7145,
            "speakerName": "巴甫洛夫",
            "text": "（客人，你真的不转转盘吗？每个人转完之后，都很高兴。）",
            "nextDialogs": [
              "760550113"
            ]
          },
          "760550113": {
            "id": "760550113",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "我就不用了，看样子…你在这里过得还不错？",
            "nextDialogs": [
              "760550114"
            ]
          },
          "760550114": {
            "id": "760550114",
            "speakerId": 7145,
            "speakerName": "巴甫洛夫",
            "text": "（好呀，好呀，有人陪着我玩，转盘陪着我玩，还有好吃的。）",
            "nextDialogs": [
              "760550115"
            ]
          },
          "760550115": {
            "id": "760550115",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "这样就好。那么，替我向你的主人问好，我先告辞了。",
            "nextDialogs": [
              "760550116"
            ]
          },
          "760550116": {
            "id": "760550116",
            "speakerId": 7145,
            "speakerName": "巴甫洛夫",
            "text": "（呜…客人再见，客人下次再见。）"
          }
        }
      }
    },
    {
      "subId": "7605502",
      "subQuestName": "Additional",
      "sceneId": null,

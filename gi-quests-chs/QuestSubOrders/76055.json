        ],
        "dialogs": {
          "760550201": {
            "id": "760550201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（咦？好像有<color=#FFCC33FF>小动物</color>的声音…？）",
            "nextDialogs": [
              "760550202"
            ]
          },
          "760550202": {
            "id": "760550202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（如果有能听懂动物说话的人在，也许能更清晰地分辨出来这声音的来源…）"
          }
        }
      }
    },
    {

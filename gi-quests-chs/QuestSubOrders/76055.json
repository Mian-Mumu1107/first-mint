            "nextDialogs": [
              "760550303"
            ]
          },
          "760550303": {
            "id": "760550303",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "（又有客人！转动轮盘，停下转盘，就有好吃的！）",
            "nextDialogs": [
              "760550304"
            ]
          },
          "760550304": {
            "id": "760550304",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "（咦？客人怎么不转呀，快点快点，想吃好吃的！）",
            "nextDialogs": [
              "760550305"
            ]
          },
          "760550305": {
            "id": "760550305",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "一只小狗…？你想让我帮你转动轮盘么？",
            "nextDialogs": [
              "760550306"
            ]
          },
          "760550306": {
            "id": "760550306",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "（客人！能和我说话，是的，客人，快点转动轮盘吧，不然我就吃不到好吃的啦。）",
            "nextDialogs": [
              "760550307"
            ]
          },
          "760550307": {
            "id": "760550307",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "你饿了么？我刚买了点心，分你一点，吃吧。",
            "nextDialogs": [
              "760550308"
            ]
          },
          "760550308": {
            "id": "760550308",
            "speakerId": 10205,
            "speakerName": "？？？",
            "text": "（呜？客人不转轮盘，客人要给我吃的…嗯，先吃，先吃。）",
            "nextDialogs": [
              "760550309"
            ]
          },
          "760550309": {
            "id": "760550309",
            "speakerId": 7145,
            "speakerName": "巴甫洛夫",
            "text": "（谢谢客人，我是巴甫洛夫，谢谢客人，好吃好吃。但你没有转动轮盘呢。）",
            "nextDialogs": [
              "760550310"
            ]
          },
          "760550310": {
            "id": "760550310",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "这种点心确实很好吃。但你刚才说的轮盘，是什么意思呢？",
            "nextDialogs": [
              "760550311"
            ]
          },
          "760550311": {
            "id": "760550311",
            "speakerId": 7145,
            "speakerName": "巴甫洛夫",
            "text": "（转盘动了，让它停下，好吃的会掉下来，每次都是这样。）",
            "nextDialogs": [
              "760550312"
            ]
          },
          "760550312": {
            "id": "760550312",
            "speakerId": 7145,
            "speakerName": "巴甫洛夫",
            "text": "（客人，你真的不转转盘吗？每个人转完之后，都很高兴。）",
            "nextDialogs": [
              "760550313"
            ]
          },
          "760550313": {
            "id": "760550313",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "那么，转轮盘之后，你会高兴吗？",
            "nextDialogs": [
              "760550314"
            ]
          },
          "760550314": {
            "id": "760550314",
            "speakerId": 7145,
            "speakerName": "巴甫洛夫",
            "text": "（高兴呀，很高兴呀，有人陪着我玩，转盘陪着我玩，还有好吃的…最重要的是好吃的！）",
            "nextDialogs": [
              "760550315"
            ]
          },
          "760550315": {
            "id": "760550315",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "嗯…那，这些点心也给你。好吃的确实很重要。",
            "nextDialogs": [
              "760550316"
            ]
          },
          "760550316": {
            "id": "760550316",
            "speakerId": 16252,
            "speakerName": "哥伦比娅",
            "text": "我还要去买其他的好吃的，再见啦，巴甫洛夫。",
            "nextDialogs": [
              "760550317"
            ]
          },
          "760550317": {
            "id": "760550317",
            "speakerId": 7145,
            "speakerName": "巴甫洛夫",
            "text": "（呜…好吃好吃，客人再见，客人下次再见。）"
          }
        }
      }

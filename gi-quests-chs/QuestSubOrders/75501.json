  "subQuests": [
    {
      "subId": "7550101",
      "subQuestName": "(test)钻地龙彩蛋对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "755010101"
        ],
        "dialogs": {
          "755010101": {
            "id": "755010101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，这不是卡齐娜吗？",
            "nextDialogs": [
              "755010102"
            ]
          },
          "755010102": {
            "id": "755010102",
            "speakerId": 1001,
            "speakerName": "卡齐娜",
            "text": "#{NICKNAME}和派蒙？没想到你们会出现在这一带…",
            "nextDialogs": [
              "755010103"
            ]
          },
          "755010103": {
            "id": "755010103",
            "speakerId": 1001,
            "speakerName": "卡齐娜",
            "text": "难道说，你们接了什么厉害的委托…是冲着那边的「游隙灵道」来的吗？",
            "nextDialogs": [
              "755010106"
            ]
          },
          "755010106": {
            "id": "755010106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "说起来，给我们委托的人也属于「回声之子」，说不定你们还认识？",
            "nextDialogs": [
              "755010107"
            ]
          },
          "755010107": {
            "id": "755010107",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "向卡齐娜描述了结识「炫彩呆子」的过程，她对涂鸦的看法，以及邀请你们学习前卫艺术理念一事…",
            "nextDialogs": [
              "755010108"
            ]
          },
          "755010108": {
            "id": "755010108",
            "speakerId": 1001,
            "speakerName": "卡齐娜",
            "text": "原来是「炫彩呆子」吗？我知道~",
            "nextDialogs": [
              "755010109"
            ]
          },
          "755010109": {
            "id": "755010109",
            "speakerId": 1001,
            "speakerName": "卡齐娜",
            "text": "她看着和我一样不起眼，但一聊起色彩就能滔滔不绝说上半天…或许你们可以多跟着她玩玩，应该能见识到…不一样的纳塔？",
            "nextDialogs": [
              "755010110"
            ]
          },
          "755010110": {
            "id": "755010110",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "卡齐娜也是被「炫彩呆子」邀请涂鸦，才和她成为朋友的吗？",
            "nextDialogs": [
              "755010111"
            ]
          },
          "755010111": {
            "id": "755010111",
            "speakerId": 1001,
            "speakerName": "卡齐娜",
            "text": "也不算吧？应该说是偶然间认识的…",
            "nextDialogs": [
              "755010112"
            ]
          },
          "755010112": {
            "id": "755010112",
            "speakerId": 1001,
            "speakerName": "卡齐娜",
            "text": "很久之前，我和爸爸妈妈一起去圣火竞技场买水果，看见她一个人坐在颜料店门口，认真地看着爱雅姐姐调色。",
            "nextDialogs": [
              "755010113"
            ]
          },
          "755010113": {
            "id": "755010113",
            "speakerId": 1001,
            "speakerName": "卡齐娜",
            "text": "她一坐就是大半天，纹丝不动，好像能从不同的颜色里看到特别厉害的东西。",
            "nextDialogs": [
              "755010114"
            ]
          },
          "755010114": {
            "id": "755010114",
            "speakerId": 1001,
            "speakerName": "卡齐娜",
            "text": "当时，她特别专注，好像除了颜料其他什么都不在乎。我还以为她不会注意到我的~",
            "nextDialogs": [
              "755010115"
            ]
          },
          "755010115": {
            "id": "755010115",
            "speakerId": 1001,
            "speakerName": "卡齐娜",
            "text": "没想到路过她身边的时候，她被我衣服的配色吸引，和我热情地聊起了喜欢的颜色，完全变了个人…",
            "nextDialogs": [
              "755010116"
            ]
          },
          "755010116": {
            "id": "755010116",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "卡齐娜的衣服确实很独特，「炫彩呆子」还挺有眼光的嘛！"
          }
        }
      }
    }
  ]
}
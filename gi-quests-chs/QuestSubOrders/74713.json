{
  "lineCounts": {
    "Player": 3,
    "派蒙": 7,
    "菲米尼": 10
  },
  "subQuests": [
    {
      "subId": "7471301",
      "subQuestName": "与菲米尼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "747130101"
        ],
        "dialogs": {
          "747130101": {
            "id": "747130101",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "#好久不见，{NICKNAME}和派蒙…",
            "nextDialogs": [
              "747130102"
            ]
          },
          "747130102": {
            "id": "747130102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "菲米尼？你怎么还戴着潜水头盔呀？",
            "nextDialogs": [
              "747130103"
            ]
          },
          "747130103": {
            "id": "747130103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是刚从水里上来没多久？",
            "nextDialogs": [
              "747130104"
            ]
          },
          "747130104": {
            "id": "747130104",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "嗯…最近水域里的情况，有些糟糕。",
            "nextDialogs": [
              "747130105"
            ]
          },
          "747130105": {
            "id": "747130105",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "比以前多出好几倍的潜水员，在到处打捞沉底的货物。我也只能尽量搭把手…",
            "nextDialogs": [
              "747130106"
            ]
          },
          "747130106": {
            "id": "747130106",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "早点捞完的话，潜水员们也会离开，水下就会恢复到以前的安静状态。",
            "nextDialogs": [
              "747130107"
            ]
          },
          "747130107": {
            "id": "747130107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这样啊…这种闹哄哄的场面，对你来说一定很不适应吧。",
            "nextDialogs": [
              "747130108"
            ]
          },
          "747130108": {
            "id": "747130108",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "谢谢派蒙关心。好在，也不全是坏事。有一些额外的收获，比如无主的古董和装饰品…",
            "nextDialogs": [
              "747130109"
            ]
          },
          "747130109": {
            "id": "747130109",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "「父亲」说，打捞到了漂亮和值钱的东西，可以送到这条船上来，你们肯定能让这些东西发挥价值。",
            "nextDialogs": [
              "747130110"
            ]
          },
          "747130110": {
            "id": "747130110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "阿蕾奇诺想得也挺周到的嘛。如果是本来就没人要的好看饰品，说不定可以用来装点水族馆？",
            "nextDialogs": [
              "747130111"
            ]
          },
          "747130111": {
            "id": "747130111",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "要不然，我们也和菲米尼一起打捞吧？",
            "nextDialogs": [
              "747130112"
            ]
          },
          "747130112": {
            "id": "747130112",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "可以吗？也许会占用你们的时间…",
            "nextDialogs": [
              "747130113"
            ]
          },
          "747130113": {
            "id": "747130113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "当然没问题啦！你都说了，捞到了无主的好东西，要给我们呢。",
            "nextDialogs": [
              "747130114"
            ]
          },
          "747130114": {
            "id": "747130114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那我们怎么能光让你一个人干活呢？这样白拿好处，我们也会过意不去的啦！",
            "nextDialogs": [
              "747130117"
            ]
          },
          "747130117": {
            "id": "747130117",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "那…我就把潜水员们的情报分享给你们，能帮你们节省一些心力…",
            "nextDialogs": [
              "747130118"
            ]
          },
          "747130118": {
            "id": "747130118",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "如果找到了好东西，请你们随意安排它的用途。不过有些是船主也在寻找的物品，那种情况还是要归还给原主的。",
            "nextDialogs": [
              "747130119"
            ]
          },
          "747130119": {
            "id": "747130119",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好，我们明白啦！",
            "nextDialogs": [
              "747130120"
            ]
          },
          "747130120": {
            "id": "747130120",
            "speakerId": 1000,
            "speakerName": "菲米尼",
            "text": "请注意安全，不要去陌生的水域。遇见危险的话，也请尽快上浮。"
          }
        }
      }
    }
  ]
}
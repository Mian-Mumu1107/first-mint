  "subQuests": [
    {
      "subId": "2400401",
      "subQuestName": "询问地面上的两兄弟",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240040101"
        ],
        "dialogs": {
          "240040101": {
            "id": "240040101",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "哥哥！我们藏到那边去，肯定比她选的位置好！",
            "nextDialogs": [
              "240040102"
            ]
          },
          "240040102": {
            "id": "240040102",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "别乱跑，韦吕！要是你跑丢了，我可没办法马上把你找回来！",
            "nextDialogs": [
              "240040105"
            ]
          },
          "240040105": {
            "id": "240040105",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "#哇！{M#大哥哥}{F#大姐姐}！你有空吗？快和我们一起藏起来，洛薇估计早就藏好啦！",
            "nextDialogs": [
              "240040106"
            ]
          },
          "240040106": {
            "id": "240040106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于洛薇…",
            "nextDialogs": [
              "240040107"
            ]
          },
          "240040107": {
            "id": "240040107",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "来不及说了，快点快点，她可熟悉这里了…我们得找个更好的地方藏起来！",
            "nextDialogs": [
              "240040108"
            ]
          },
          "240040108": {
            "id": "240040108",
            "speakerId": 1002,
            "speakerName": "Black Screen",
            "text": "韦吕飞快地离开了…",
            "nextDialogs": [
              "240040109"
            ]
          },
          "240040109": {
            "id": "240040109",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "唉，韦吕这家伙…什么时候能听点话…",
            "nextDialogs": [
              "240040110"
            ]
          },
          "240040110": {
            "id": "240040110",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "抱歉，只能麻烦您再陪我们玩一场了，韦吕不知道为什么，突然这么兴奋…"
          }
        }
      }
    },
    {
      "subId": "2400402",
      "subQuestName": "找到所有躲起来的孩子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240040201"
        ],
        "dialogs": {
          "240040201": {
            "id": "240040201",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "…这一页我应该已经看过了。",
            "nextDialogs": [
              "240040204"
            ]
          },
          "240040204": {
            "id": "240040204",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "#没想到{M#大哥哥}{F#大姐姐}这么快就来了，我才刚翻开这本书呢。",
            "nextDialogs": [
              "240040205"
            ]
          },
          "240040205": {
            "id": "240040205",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "这本书是洛薇的爸爸特意让她带给我的，还说我有什么不懂的地方可以去问他。",
            "nextDialogs": [
              "240040206"
            ]
          },
          "240040206": {
            "id": "240040206",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "但是…呵呵，说实话这本书我几乎没有看得懂的地方啊…",
            "nextDialogs": [
              "240040207"
            ]
          },
          "240040207": {
            "id": "240040207",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "先不说这些，我先回去集合点了，毕竟我已经被你找到了，玩游戏就得遵守规则。"
          }
        }
      }
    },
    {
      "subId": "2400403",
      "subQuestName": "找到所有躲起来的孩子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240040301"
        ],
        "dialogs": {
          "240040301": {
            "id": "240040301",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "#呜哇！{M#大哥哥}{F#大姐姐}找得好快！我刚准备换个地方藏呢…",
            "nextDialogs": [
              "240040302"
            ]
          },
          "240040302": {
            "id": "240040302",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "唉，这下我只能回集合点去了…"
          }
        }
      }
    },
    {
      "subId": "2400404",
      "subQuestName": "找到所有躲起来的孩子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240040401"
        ],
        "dialogs": {
          "240040401": {
            "id": "240040401",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "#好吧…还是被你找…咦？{M#大哥哥}{F#大姐姐}，你是谁呀？",
            "nextDialogs": [
              "240040402"
            ]
          },
          "240040402": {
            "id": "240040402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是奥雷勒和韦吕的朋友啦。",
            "nextDialogs": [
              "240040403"
            ]
          },
          "240040403": {
            "id": "240040403",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "喔！我听他们提起过你，韦吕说你可擅长玩捉迷藏了。",
            "nextDialogs": [
              "240040404"
            ]
          },
          "240040404": {
            "id": "240040404",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "#今天我可算是见识到啦，{M#大哥哥}{F#大姐姐}果然很厉害啊。",
            "nextDialogs": [
              "240040405"
            ]
          },
          "240040405": {
            "id": "240040405",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "认输认输，我去集合点等着啦。"
          }
        }
      }
    },
    {
      "subId": "2400405",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240040501"
        ],
        "dialogs": {
          "240040501": {
            "id": "240040501",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "你们两个…为什么这样看着我？",
            "nextDialogs": [
              "240040502"
            ]
          },
          "240040502": {
            "id": "240040502",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "哥…你不会又是躲在哪里偷偷看书了吧？没有认真陪我们玩！",
            "nextDialogs": [
              "240040503"
            ]
          },
          "240040503": {
            "id": "240040503",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "对啊，好不容易玩次游戏，认真点啦！",
            "nextDialogs": [
              "240040504"
            ]
          },
          "240040504": {
            "id": "240040504",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "好位置都被你们占着了，我又不擅长捉迷藏…可不就只能看看书打发时间了吗…",
            "nextDialogs": [
              "240040505"
            ]
          },
          "240040505": {
            "id": "240040505",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "嘁！哥哥骗人！",
            "nextDialogs": [
              "240040506"
            ]
          },
          "240040506": {
            "id": "240040506",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "哼！就爱看书！",
            "nextDialogs": [
              "240040507"
            ]
          },
          "240040507": {
            "id": "240040507",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "你们就饶了我吧…",
            "nextDialogs": [
              "240040510"
            ]
          },
          "240040510": {
            "id": "240040510",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "嘿嘿，洛薇可擅长玩捉迷藏了，还知道很多有趣的地方可以藏。",
            "nextDialogs": [
              "240040517"
            ]
          },
          "240040517": {
            "id": "240040517",
            "speakerId": 5062,
            "speakerName": "韦吕",
            "text": "嘿嘿嘿，有洛薇陪着玩，这里也挺有意思的嘛！",
            "nextDialogs": [
              "240040511"
            ]
          },
          "240040511": {
            "id": "240040511",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "韦吕的爬起墙来可快了，力气还很大，有好多地方都是他拉我上去的。",
            "nextDialogs": [
              "240040512"
            ]
          },
          "240040512": {
            "id": "240040512",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "#只要我们俩一起走，除了{M#大哥哥}{F#大姐姐}之外的一般人可找不到我们！",
            "nextDialogs": [
              "240040513"
            ]
          },
          "240040513": {
            "id": "240040513",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "好啦，你们玩得也差不多了。洛薇，我们先送你回家吧。",
            "nextDialogs": [
              "240040514"
            ]
          },
          "240040514": {
            "id": "240040514",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "然后…你还要再顺便去和我爸讨论问题，对吧？",
            "nextDialogs": [
              "240040515"
            ]
          },
          "240040515": {
            "id": "240040515",
            "speakerId": 5063,
            "speakerName": "奥雷勒",
            "text": "我，我确实有几个地方弄不明白，得向叔叔请教…",
            "nextDialogs": [
              "240040516"
            ]
          },
          "240040516": {
            "id": "240040516",
            "speakerId": 5021,
            "speakerName": "洛薇",
            "text": "好啦，我爸现在肯定在家，我们快回去吧。我妈妈上次还说要留你们吃晚饭呢…"
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "2200001",
      "subQuestName": "与璐璐、阿飞、小蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220000101"
        ],
        "dialogs": {
          "220000101": {
            "id": "220000101",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "今天我们怎么玩？",
            "nextDialogs": [
              "220000102"
            ]
          },
          "220000102": {
            "id": "220000102",
            "speakerId": 1001,
            "speakerName": "阿飞",
            "text": "哼，要是没人来扮海盗，今天也玩不了。",
            "nextDialogs": [
              "220000103"
            ]
          },
          "220000103": {
            "id": "220000103",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "可是，谁也不愿意扮海盗，怎么办呢…",
            "nextDialogs": [
              "220000104"
            ]
          },
          "220000104": {
            "id": "220000104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在做什么？",
            "nextDialogs": [
              "220000105"
            ]
          },
          "220000105": {
            "id": "220000105",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "我们在玩游戏呢，可总是缺一个人来扮海盗。",
            "nextDialogs": [
              "220000106"
            ]
          },
          "220000106": {
            "id": "220000106",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "因为没人扮海盗来抢劫，我们一直没法开始玩…",
            "nextDialogs": [
              "220000107"
            ]
          },
          "220000107": {
            "id": "220000107",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#对了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}！你能来扮海盗吗？",
            "nextDialogs": [
              "220000109",
              "220000111"
            ]
          },
          "220000109": {
            "id": "220000109",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "好哎！那我们就去准备啦！",
            "nextDialogs": [
              "220000115"
            ]
          },
          "220000115": {
            "id": "220000115",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}准备好了的话，就过来吧。"
          },
          "220000111": {
            "id": "220000111",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "没关系啦，海盗…唔，应该是那种蛮不讲理，随便抢走人家东西的坏人。",
            "nextDialogs": [
              "220000112"
            ]
          },
          "220000112": {
            "id": "220000112",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "虽然我也没有见过，只是听北斗姐姐讲过。",
            "nextDialogs": [
              "220000113"
            ]
          },
          "220000113": {
            "id": "220000113",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "但我觉得…这种人，应该挺好演的吧。",
            "nextDialogs": [
              "220000114"
            ]
          },
          "220000114": {
            "id": "220000114",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#嘿嘿，总之就拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}啦。"
          }
        }
      }
    },
    {
      "subId": "2200002",
      "subQuestName": "与「船长」小蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220000201"
        ],
        "dialogs": {
          "220000201": {
            "id": "220000201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准备好了。",
            "nextDialogs": [
              "220000202"
            ]
          },
          "220000202": {
            "id": "220000202",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "那我们直接开始吧。",
            "nextDialogs": [
              "220000203"
            ]
          },
          "220000203": {
            "id": "220000203",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "从哪开始呢…",
            "nextDialogs": [
              "220000204"
            ]
          },
          "220000204": {
            "id": "220000204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那个，抢劫…",
            "nextDialogs": [
              "220000205"
            ]
          },
          "220000205": {
            "id": "220000205",
            "speakerId": 1002,
            "speakerName": "璐璐",
            "text": "呜哇！是海盗！",
            "nextDialogs": [
              "220000206"
            ]
          },
          "220000206": {
            "id": "220000206",
            "speakerId": 1001,
            "speakerName": "阿飞",
            "text": "璐璐快过来，我来保护你！",
            "nextDialogs": [
              "220000207"
            ]
          },
          "220000207": {
            "id": "220000207",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "你是海盗吧，为什么要来抢劫？",
            "nextDialogs": [
              "220000210"
            ]
          },
          "220000210": {
            "id": "220000210",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "海盗也分好坏，不一定都要抢劫呀。",
            "nextDialogs": [
              "220000211"
            ]
          },
          "220000211": {
            "id": "220000211",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "北斗姐姐也说自己是海盗，可是她是很好的人，会给我好吃的，大家都很喜欢她。",
            "nextDialogs": [
              "220000212"
            ]
          },
          "220000212": {
            "id": "220000212",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#为什么{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}要做坏海盗，不做好海盗呢？",
            "nextDialogs": [
              "220000213"
            ]
          },
          "220000213": {
            "id": "220000213",
            "speakerId": 1003,
            "speakerName": "派蒙",
            "text": "明明是你说，海盗是那种「蛮不讲理」的人吧…"
          }
        }
      }
    },
    {
      "subId": "2200003",
      "subQuestName": "用「风」或「水」来清洗甲板",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220000301"
        ],
        "dialogs": {
          "220000301": {
            "id": "220000301",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "清洗好了吗？",
            "nextDialogs": [
              "220000302"
            ]
          },
          "220000302": {
            "id": "220000302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "清洗好了。",
            "nextDialogs": [
              "220000303"
            ]
          },
          "220000303": {
            "id": "220000303",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "嗯！辛苦你啦，这些给你，谢谢你陪我们玩。",
            "nextDialogs": [
              "220000304"
            ]
          },
          "220000304": {
            "id": "220000304",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}以后也要做好人啊。",
            "nextDialogs": [
              "220000305"
            ]
          },
          "220000305": {
            "id": "220000305",
            "speakerId": 1001,
            "speakerName": "阿飞",
            "text": "喂，什么时候能轮到我做船长啊？",
            "nextDialogs": [
              "220000306"
            ]
          },
          "220000306": {
            "id": "220000306",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "下次吧，下次就归你了。",
            "nextDialogs": [
              "220000307"
            ]
          },
          "220000307": {
            "id": "220000307",
            "speakerId": 1001,
            "speakerName": "阿飞",
            "text": "哼，上次你就这么说的…"
          }
        }
      }
    },
    {
      "subId": "2200005",
      "subQuestName": "(test)防止进度被重置$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220000501"
        ],
        "dialogs": {
          "220000501": {
            "id": "220000501",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "清理好了吗？",
            "nextDialogs": [
              "220000502"
            ]
          },
          "220000502": {
            "id": "220000502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还没有。",
            "nextDialogs": [
              "220000503"
            ]
          },
          "220000503": {
            "id": "220000503",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#快去清理吧，这可是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}改邪归正的好机会喔。",
            "nextDialogs": [
              "220000504"
            ]
          },
          "220000504": {
            "id": "220000504",
            "speakerId": 1001,
            "speakerName": "阿飞",
            "text": "喂，我说啊，做一下清洁工作就能成好人了吗？",
            "nextDialogs": [
              "220000505"
            ]
          },
          "220000505": {
            "id": "220000505",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "只要愿意去做好事，那就是好人。",
            "nextDialogs": [
              "220000506"
            ]
          },
          "220000506": {
            "id": "220000506",
            "speakerId": 1001,
            "speakerName": "阿飞",
            "text": "这也太简单了…",
            "nextDialogs": [
              "220000507"
            ]
          },
          "220000507": {
            "id": "220000507",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "做了好事，就是好人，做了坏事，就是坏人，就这么简单。",
            "nextDialogs": [
              "220000508"
            ]
          },
          "220000508": {
            "id": "220000508",
            "speakerId": 1001,
            "speakerName": "阿飞",
            "text": "哼，你说是简单，但如果这么简单，那天下哪里还有坏人呢？",
            "nextDialogs": [
              "220000509"
            ]
          },
          "220000509": {
            "id": "220000509",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "因为天下的所有事都是说起来容易，做起来难。",
            "nextDialogs": [
              "220000510"
            ]
          },
          "220000510": {
            "id": "220000510",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "而坏事做起来，总是比好事容易的。",
            "nextDialogs": [
              "220000511"
            ]
          },
          "220000511": {
            "id": "220000511",
            "speakerId": 1001,
            "speakerName": "阿飞",
            "text": "这也是北斗姐姐教你的？",
            "nextDialogs": [
              "220000512"
            ]
          },
          "220000512": {
            "id": "220000512",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "是我从书里看的。"
          }
        }
      }
    },

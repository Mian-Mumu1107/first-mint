            "text": "运货的偶尔会偷两瓶货品酒来饱私囊，当然，我知道你不像这样的人。"
          }
        }
      }
    },
    {
      "subId": "48803",
      "subQuestName": "完成查尔斯的委托",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4880301"
        ],
        "dialogs": {
          "4880301": {
            "id": "4880301",
            "speakerId": 1003,
            "speakerName": "恩内斯特",
            "text": "谢谢你了朋友，我还以为这次麻烦大了，好在有你。",
            "nextDialogs": [
              "4880302"
            ]
          },
          "4880302": {
            "id": "4880302",
            "speakerId": 1003,
            "speakerName": "恩内斯特",
            "text": "我会记得跟酒庄的老爷们美言你几句的，拜拜。"
          }
        }
      }
    }

  "subQuests": [
    {
      "subId": "48800",
      "subQuestName": "找查尔斯听取委托内容",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4880001"
        ],
        "dialogs": {
          "4880001": {
            "id": "4880001",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "丽莎小姐，难道是来送税收报表的吗？",
            "nextDialogs": [
              "4880002"
            ]
          },
          "4880002": {
            "id": "4880002",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "哦呀，小可爱。你说的没错。我听说了琴病倒的事，文书类的工作我就先代劳了。",
            "nextDialogs": [
              "4880003"
            ]
          },
          "4880003": {
            "id": "4880003",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这样呀，那看来这边已经没我们什么事了，那我们就先走啦。",
            "nextDialogs": [
              "4880004"
            ]
          },
          "4880004": {
            "id": "4880004",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "啊，稍等一下，其实查尔斯先生这边…",
            "nextDialogs": [
              "4880005"
            ]
          },
          "4880005": {
            "id": "4880005",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "让我来说吧，丽莎小姐。",
            "nextDialogs": [
              "4880006"
            ]
          },
          "4880006": {
            "id": "4880006",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "就在刚才，我接到了一批订单。可店里的库存不够了，酒庄的进货又迟迟未到。",
            "nextDialogs": [
              "4880007"
            ]
          },
          "4880007": {
            "id": "4880007",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "方便的话，想麻烦你们<color=#00E1FFFF>去查看一下货物情况</color>。",
            "nextDialogs": [
              "4880008"
            ]
          },
          "4880008": {
            "id": "4880008",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸，是这么紧急的订单吗。",
            "nextDialogs": [
              "4880009"
            ]
          },
          "4880009": {
            "id": "4880009",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "没办法，毕竟是临时接到的，强人所难的订单——就，在，刚，才。",
            "nextDialogs": [
              "4880010"
            ]
          },
          "4880010": {
            "id": "4880010",
            "speakerId": 1001,
            "speakerName": "丽莎",
            "text": "嗯~嗯~就是这样，如查尔斯先生所说。",
            "nextDialogs": [
              "4880011"
            ]
          },
          "4880011": {
            "id": "4880011",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好吧，我去看看。",
            "nextDialogs": [
              "4880012"
            ]
          },
          "4880012": {
            "id": "4880012",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以，但下次要记得请客。",
            "nextDialogs": [
              "4880013"
            ]
          },
          "4880013": {
            "id": "4880013",
            "speakerId": 1002,
            "speakerName": "查尔斯",
            "text": "呵呵，下次等迪卢克老板在的时候，他肯定会请你喝的。",
            "nextDialogs": [
              "4880014"
            ]
          },
          "4880014": {
            "id": "4880014",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，这还差不多！"
          }
        }
      }
    },
    {
      "subId": "48801",
      "subQuestName": "与恩内斯特对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4880101"
        ],
        "dialogs": {
          "4880101": {
            "id": "4880101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来货物在这里。",
            "nextDialogs": [
              "4880102"
            ]
          },
          "4880102": {
            "id": "4880102",
            "speakerId": 1003,
            "speakerName": "恩内斯特",
            "text": "是来帮忙的吗？可算等到你们了。",
            "nextDialogs": [
              "4880103"
            ]
          },
          "4880103": {
            "id": "4880103",
            "speakerId": 1003,
            "speakerName": "恩内斯特",
            "text": "我在这酒庄干了这么久，头一次被丘丘人打劫…哎哟。",
            "nextDialogs": [
              "4880104"
            ]
          },
          "4880104": {
            "id": "4880104",
            "speakerId": 1003,
            "speakerName": "恩内斯特",
            "text": "你们再来晚些，我可真不知道怎么办了。",
            "nextDialogs": [
              "4880105"
            ]
          },
          "4880105": {
            "id": "4880105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#放心吧，丘丘人而已，{NICKNAME}很能打的！",
            "nextDialogs": [
              "4880106"
            ]
          },
          "4880106": {
            "id": "4880106",
            "speakerId": 1003,
            "speakerName": "恩内斯特",
            "text": "能打就好，那这个<color=#00E1FFFF>货运热气球</color>就交给你们了。",
            "nextDialogs": [
              "4880107"
            ]
          },
          "4880107": {
            "id": "4880107",
            "speakerId": 1003,
            "speakerName": "恩内斯特",
            "text": "可别光顾着收拾那些丘丘人，一定记得<color=#00E1FFFF>优先确保货物安全</color>，不然你我可都赔不起。",
            "nextDialogs": [
              "4880108"
            ]
          },
          "4880108": {
            "id": "4880108",
            "speakerId": 1003,
            "speakerName": "恩内斯特",
            "text": "那就先这样了，我到前面等你。"
          }
        }
      }
    },

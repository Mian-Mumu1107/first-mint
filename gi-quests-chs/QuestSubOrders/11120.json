  "subQuests": [
    {
      "subId": "1112001",
      "subQuestName": "前往璃月冒险家协会找凯瑟琳",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111200101"
        ],
        "dialogs": {
          "111200101": {
            "id": "111200101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "凯瑟琳，我们来啦，有新委托吗？",
            "nextDialogs": [
              "111200102"
            ]
          },
          "111200102": {
            "id": "111200102",
            "speakerId": 1001,
            "speakerName": "凯瑟琳",
            "text": "是的，有份新工作，我认为你们可以胜任。",
            "nextDialogs": [
              "111200103"
            ]
          },
          "111200103": {
            "id": "111200103",
            "speakerId": 1001,
            "speakerName": "凯瑟琳",
            "text": "老戴是璃月港辉山厅的工头之一，他希望冒险家协会能派几个人手给他。",
            "nextDialogs": [
              "111200104"
            ]
          },
          "111200104": {
            "id": "111200104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "具体是要做什么呢？",
            "nextDialogs": [
              "111200105"
            ]
          },
          "111200105": {
            "id": "111200105",
            "speakerId": 1001,
            "speakerName": "凯瑟琳",
            "text": "听说是要找几个工人。",
            "nextDialogs": [
              "111200106"
            ]
          },
          "111200106": {
            "id": "111200106",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "找人？太好了，是我们擅长的工作！",
            "nextDialogs": [
              "111200107"
            ]
          },
          "111200107": {
            "id": "111200107",
            "speakerId": 1001,
            "speakerName": "凯瑟琳",
            "text": "是啊，旅行者的能力毋庸置疑。",
            "nextDialogs": [
              "111200108"
            ]
          },
          "111200108": {
            "id": "111200108",
            "speakerId": 1001,
            "speakerName": "凯瑟琳",
            "text": "具体委托内容可以见面详谈。如果你们愿意接下这份工作，就到码头附近找老戴聊聊吧。"
          }
        }
      }
    },
    {
      "subId": "1112005",
      "subQuestName": "到码头附近找工头老戴",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1112002",
      "subQuestName": "到码头附近找工头老戴",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111200201"
        ],
        "dialogs": {
          "111200201": {
            "id": "111200201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂——你是老戴吗？",
            "nextDialogs": [
              "111200202"
            ]
          },
          "111200202": {
            "id": "111200202",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "噢，找我？",
            "nextDialogs": [
              "111200203"
            ]
          },
          "111200203": {
            "id": "111200203",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "嗯？等等，你们就是协会派来的冒险家？",
            "nextDialogs": [
              "111200204"
            ]
          },
          "111200204": {
            "id": "111200204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，看得出来吗？！",
            "nextDialogs": [
              "111200205"
            ]
          },
          "111200205": {
            "id": "111200205",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "看你们这副打扮和神情，应该是老手了。",
            "nextDialogs": [
              "111200206"
            ]
          },
          "111200206": {
            "id": "111200206",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没错没错，你眼光真好！",
            "nextDialogs": [
              "111200207"
            ]
          },
          "111200207": {
            "id": "111200207",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "哈哈哈，干咱们这行，少不了鉴定的活儿。看石头也是看，看人也是看。一般人什么底细，老戴我一眼就瞧出来喽。",
            "nextDialogs": [
              "111200208"
            ]
          },
          "111200208": {
            "id": "111200208",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "二位稍等，我找的帮手还在路上，一会儿就到。",
            "nextDialogs": [
              "111200209"
            ]
          },
          "111200209": {
            "id": "111200209",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "等一下等一下，你不是已经找了我们吗？不会还有其他人要来瓜分工钱吧？",
            "nextDialogs": [
              "111200210"
            ]
          },
          "111200210": {
            "id": "111200210",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "唉！实不相瞒，这次的事有些棘手。光是冒险家恐怕不够，所以…",
            "nextDialogs": [
              "111200211"
            ]
          },
          "111200211": {
            "id": "111200211",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "果然还有其他人，哼！",
            "nextDialogs": [
              "111200212"
            ]
          },
          "111200212": {
            "id": "111200212",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "大叔，你是不是小看我们？",
            "nextDialogs": [
              "111200215"
            ]
          },
          "111200215": {
            "id": "111200215",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "你们有所不知，这次的事发生在矿区，而且有些离奇。矿区向来多事故，以防万一，我才找了懂行的高手。",
            "nextDialogs": [
              "111200216"
            ]
          },
          "111200216": {
            "id": "111200216",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "冒险家的主业总不会是矿石鉴定、地质分析之类的吧？身边带个行家，凡事也好照应。",
            "nextDialogs": [
              "111200217"
            ]
          },
          "111200217": {
            "id": "111200217",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "再说，我找的这位可是顶尖高手，无论什么石头，他只要看上一眼，就能说个八九不离十！",
            "nextDialogs": [
              "111200218"
            ]
          },
          "111200218": {
            "id": "111200218",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "要我说啊，世上最懂石头的人，就得是他！遇见这等行家，还不赶紧请来？",
            "nextDialogs": [
              "111200219"
            ]
          },
          "111200219": {
            "id": "111200219",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不对不对，世上最懂石头的人怎么会被你找到？",
            "nextDialogs": [
              "111200220"
            ]
          },
          "111200220": {
            "id": "111200220",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "怎么不会啊？",
            "nextDialogs": [
              "111200221"
            ]
          },
          "111200221": {
            "id": "111200221",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "当然不会了，因为世上最懂石头的人，是我们的朋友才对！",
            "nextDialogs": [
              "111200222"
            ]
          },
          "111200222": {
            "id": "111200222",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "该不会，你说的是…",
            "nextDialogs": [
              "111200223"
            ]
          },
          "111200223": {
            "id": "111200223",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（刚好，我也有些事想问他。）",
            "nextDialogs": [
              "111200224"
            ]
          },
          "111200224": {
            "id": "111200224",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼哼，天外有天，人外有人！你在这里等着，我们马上就带他过来！"
          }
        }
      }
    },
    {
      "subId": "1112003",
      "subQuestName": "寻找钟离",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111200301"
        ],
        "dialogs": {
          "111200301": {
            "id": "111200301",
            "speakerId": 1003,
            "speakerName": "田铁嘴",
            "text": "上一回说到啊，岩王帝君…",
            "nextDialogs": [
              "111200302"
            ]
          },
          "111200302": {
            "id": "111200302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "找到你啦，钟离！",
            "nextDialogs": [
              "111200303"
            ]
          },
          "111200303": {
            "id": "111200303",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "嗯？",
            "nextDialogs": [
              "111200304"
            ]
          },
          "111200304": {
            "id": "111200304",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "你们兴致不错，也来这里听人说书。",
            "nextDialogs": [
              "111200305"
            ]
          },
          "111200305": {
            "id": "111200305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不不，我们是来找你的，你现在有空吗？",
            "nextDialogs": [
              "111200306"
            ]
          },
          "111200306": {
            "id": "111200306",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "时间倒是有。",
            "nextDialogs": [
              "111200309"
            ]
          },
          "111200309": {
            "id": "111200309",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这份工作需要了解地质与矿石的人哦。",
            "nextDialogs": [
              "111200310"
            ]
          },
          "111200310": {
            "id": "111200310",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "地质与矿石…",
            "nextDialogs": [
              "111200311"
            ]
          },
          "111200311": {
            "id": "111200311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "放眼整片大陆，难道会有比你更懂这些的人吗？",
            "nextDialogs": [
              "111200312"
            ]
          },
          "111200312": {
            "id": "111200312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那个委托人自称找到了天下最懂石头的行家。我想向他证明，你才是提瓦特大陆上最了解这些的人！",
            "nextDialogs": [
              "111200313"
            ]
          },
          "111200313": {
            "id": "111200313",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "这无缘无故的攀比之心，是从何而来啊？",
            "nextDialogs": [
              "111200314"
            ]
          },
          "111200314": {
            "id": "111200314",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不是攀比啦，是老戴不懂行！",
            "nextDialogs": [
              "111200315"
            ]
          },
          "111200315": {
            "id": "111200315",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我就是…想让他见识见识嘛…",
            "nextDialogs": [
              "111200316"
            ]
          },
          "111200316": {
            "id": "111200316",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "哈哈，既然如此，我便随你们走一趟吧。",
            "nextDialogs": [
              "111200317"
            ]
          },
          "111200317": {
            "id": "111200317",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真的？！",
            "nextDialogs": [
              "111200318"
            ]
          },
          "111200318": {
            "id": "111200318",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "话说在前头，我虽有些见识，倒也未必是天下最精于此道的人。",
            "nextDialogs": [
              "111200319"
            ]
          },
          "111200319": {
            "id": "111200319",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "学海无涯，长些见识总是好事。一来，我在你们也可以放心，二来，若真有专家，也好让我切磋学习一番。",
            "nextDialogs": [
              "111200320"
            ]
          },
          "111200320": {
            "id": "111200320",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…我觉得钟离可以不用这么谦虚的。",
            "nextDialogs": [
              "111200321"
            ]
          },
          "111200321": {
            "id": "111200321",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "既然钟离答应了，那我们走吧，回去找老戴！"
          }
        }
      }
    },
    {
      "subId": "1112004",
      "subQuestName": "回码头找老戴聊聊",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111200401"
        ],
        "dialogs": {
          "111200401": {
            "id": "111200401",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "老戴，我们回来了！",
            "nextDialogs": [
              "111200402"
            ]
          },
          "111200402": {
            "id": "111200402",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "噢！这位就是你们的朋友吗？",
            "nextDialogs": [
              "111200403"
            ]
          },
          "111200403": {
            "id": "111200403",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "正是！我认为，这位先生才是天下最懂矿石与地质的人。",
            "nextDialogs": [
              "111200404"
            ]
          },
          "111200404": {
            "id": "111200404",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "过奖。略有心得罢了。",
            "nextDialogs": [
              "111200405"
            ]
          },
          "111200405": {
            "id": "111200405",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "嗨，你要这么说，我找的那位也绝对不输他人。",
            "nextDialogs": [
              "111200406"
            ]
          },
          "111200406": {
            "id": "111200406",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "我说不清，一会儿等他来了，你们自己感受吧！",
            "nextDialogs": [
              "111200407"
            ]
          },
          "111200407": {
            "id": "111200407",
            "speakerId": 1005,
            "speakerName": "？？？",
            "text": "呃…是这儿吗？",
            "nextDialogs": [
              "111200408"
            ]
          },
          "111200408": {
            "id": "111200408",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "哎呀来得正好！给各位介绍一下，这是我找的帮手，昆钧。",
            "nextDialogs": [
              "111200409"
            ]
          },
          "111200409": {
            "id": "111200409",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "小昆啊，这两位都是我找的冒险家，呃，至于这位先生…",
            "nextDialogs": [
              "111200410"
            ]
          },
          "111200410": {
            "id": "111200410",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "嗯…？",
            "nextDialogs": [
              "111200411"
            ]
          },
          "111200411": {
            "id": "111200411",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "……",
            "nextDialogs": [
              "111200412"
            ]
          },
          "111200412": {
            "id": "111200412",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他叫钟离，是往生堂的客卿。",
            "nextDialogs": [
              "111200413"
            ]
          },
          "111200413": {
            "id": "111200413",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "往生堂客卿钟离先生…我也有所耳闻，听说你学富五车，才高八斗。没想到，今天能见到本人。",
            "nextDialogs": [
              "111200414"
            ]
          },
          "111200414": {
            "id": "111200414",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "嗯？有些眼熟…唔，难道是在往生堂见过吗？但我也没去过往生堂啊…",
            "nextDialogs": [
              "111200415"
            ]
          },
          "111200415": {
            "id": "111200415",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "老戴，你不试试吗？看他们谁才是真正的行家！",
            "nextDialogs": [
              "111200416"
            ]
          },
          "111200416": {
            "id": "111200416",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "原来要当场比试啊。",
            "nextDialogs": [
              "111200417"
            ]
          },
          "111200417": {
            "id": "111200417",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "啊？这…我、我也不知从何比起啊…",
            "nextDialogs": [
              "111200418"
            ]
          },
          "111200418": {
            "id": "111200418",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那你们自己想办法比试一下，要是钟离赢了，就请他帮忙，要是钟离…不对，他怎么会输呢！",
            "nextDialogs": [
              "111200419"
            ]
          },
          "111200419": {
            "id": "111200419",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "比试？好啊好啊，我愿意奉陪！",
            "nextDialogs": [
              "111200420"
            ]
          },
          "111200420": {
            "id": "111200420",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "这位先生很有兴致嘛。",
            "nextDialogs": [
              "111200421"
            ]
          },
          "111200421": {
            "id": "111200421",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "啊哈哈，我一见你的脸就觉得你肯定懂行。不过跟我比起来孰高孰低，还不好说呢。",
            "nextDialogs": [
              "111200422"
            ]
          },
          "111200422": {
            "id": "111200422",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个人口气好大啊！",
            "nextDialogs": [
              "111200423"
            ]
          },
          "111200423": {
            "id": "111200423",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "实话实说而已，哈哈哈…再说，我也只会这些。",
            "nextDialogs": [
              "111200424"
            ]
          },
          "111200424": {
            "id": "111200424",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "昆兄可是鉴定师？",
            "nextDialogs": [
              "111200425"
            ]
          },
          "111200425": {
            "id": "111200425",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "不，其实…其实我也忘了我来璃月港干嘛…有天站在路边，突然被老戴叫住。",
            "nextDialogs": [
              "111200426"
            ]
          },
          "111200426": {
            "id": "111200426",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "老戴见我拿着石头，问了我几句，跟着便激动万分地约我来此地碰面。",
            "nextDialogs": [
              "111200427"
            ]
          },
          "111200427": {
            "id": "111200427",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哈？这也能忘记？",
            "nextDialogs": [
              "111200428"
            ]
          },
          "111200428": {
            "id": "111200428",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "我来璃月港路上，遇见这人站在路边捯饬石头，嘴里还念念有词，好像对那些石头熟得不得了。",
            "nextDialogs": [
              "111200429"
            ]
          },
          "111200429": {
            "id": "111200429",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "出于好奇我就问了几句，谁知，他比我这个矿工头子还懂！反正他也无所事事，不如来帮我的忙。",
            "nextDialogs": [
              "111200430"
            ]
          },
          "111200430": {
            "id": "111200430",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这家伙，记性不好吧。",
            "nextDialogs": [
              "111200431"
            ]
          },
          "111200431": {
            "id": "111200431",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "也不能说是记性不好…不过，只是石头的话，我一定能帮上忙。",
            "nextDialogs": [
              "111200432"
            ]
          },
          "111200432": {
            "id": "111200432",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "钟离先生，你觉得这块石头如何？",
            "nextDialogs": [
              "111200433"
            ]
          },
          "111200433": {
            "id": "111200433",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "唔…",
            "nextDialogs": [
              "111200434"
            ]
          },
          "111200434": {
            "id": "111200434",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "这块石头表壳光滑，表面的裂痕是由火山喷发所致。如果我没猜错，这是出自别国的石胚。",
            "nextDialogs": [
              "111200435"
            ]
          },
          "111200435": {
            "id": "111200435",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "哦~哦！眼光真不错！",
            "nextDialogs": [
              "111200436"
            ]
          },
          "111200436": {
            "id": "111200436",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "它不是普通的石胚。壳薄，线黑…我猜，其中包着上好的水晶矿。",
            "nextDialogs": [
              "111200437"
            ]
          },
          "111200437": {
            "id": "111200437",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "一点不错，这块石头出自火山周边，我一边闲逛，一边在集市买了这个。卖家当它是边角料，却不知其中奥妙。",
            "nextDialogs": [
              "111200440"
            ]
          },
          "111200440": {
            "id": "111200440",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "光是成色纯净质地高级，还不足以称为珍宝。更高一等的罕见水晶，有些包着水胆，有些则藏着金沙。",
            "nextDialogs": [
              "111200441"
            ]
          },
          "111200441": {
            "id": "111200441",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "这层石壳下藏着的水晶，在其形成瞬间包裹住了一团水。水藏于底，犹如山中满月，映天而动，可谓是相当稀有。",
            "nextDialogs": [
              "111200442"
            ]
          },
          "111200442": {
            "id": "111200442",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这么详细，简直像是他亲眼看到的一样…",
            "nextDialogs": [
              "111200443"
            ]
          },
          "111200443": {
            "id": "111200443",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不会是糊弄我们的吧？毕竟，你这块石头还没开呢。",
            "nextDialogs": [
              "111200444"
            ]
          },
          "111200444": {
            "id": "111200444",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "不，他说的都是实话。",
            "nextDialogs": [
              "111200445"
            ]
          },
          "111200445": {
            "id": "111200445",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "水晶大多诞生于高温环境，高温与流水不兼容，水胆水晶因而珍贵。这块晶体内藏着的却是高山湖泊水，更为罕见。",
            "nextDialogs": [
              "111200446"
            ]
          },
          "111200446": {
            "id": "111200446",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "连钟离都这么说…那应该是真的吧…",
            "nextDialogs": [
              "111200447"
            ]
          },
          "111200447": {
            "id": "111200447",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "钟离先生这种眼力，我还是第一次见！石壳下的模样，你是怎么知道的？",
            "nextDialogs": [
              "111200448"
            ]
          },
          "111200448": {
            "id": "111200448",
            "speakerId": 1004,
            "speakerName": "钟离",
            "text": "见得多了，自然有心得。小小卖弄，还请昆兄不要介意。",
            "nextDialogs": [
              "111200449"
            ]
          },
          "111200449": {
            "id": "111200449",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "不不，怎么会呢！我觉得我俩很是投缘，我是真心想要结交你这个朋友。",
            "nextDialogs": [
              "111200450"
            ]
          },
          "111200450": {
            "id": "111200450",
            "speakerId": 1006,
            "speakerName": "昆钧",
            "text": "老戴，带上钟离先生一起吧！信我没错，他绝对是个眼力过人的行家。这样的人，你一辈子也遇不到几个。",
            "nextDialogs": [
              "111200451"
            ]
          },
          "111200451": {
            "id": "111200451",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "也好，多一个人，多一份力量。各位，请跟我到层岩巨渊矿区走走，这次走丢的兄弟，还要靠你们找回。"
          }
        }
      }
    },
    {
      "subId": "1112022",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111202201"
        ],
        "dialogs": {
          "111202201": {
            "id": "111202201",
            "speakerId": 1002,
            "speakerName": "老戴",
            "text": "最懂石头的人，得是什么样啊…？"
          }
        }
      }
    },
    {
      "subId": "1112099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "111209901"
        ],
        "dialogs": {
          "111209901": {
            "id": "111209901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我猜钟离一定在听说书，到说书人附近找他，准没错！"
          }
        }
      }
    }
  ]
}
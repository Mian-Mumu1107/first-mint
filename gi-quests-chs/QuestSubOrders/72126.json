  },
  "subQuests": [
    {
      "subId": "7212601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721260101"
        ],
        "dialogs": {
          "721260101": {
            "id": "721260101",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "糟糕了…这下怎么办…",
            "nextDialogs": [
              "721260102"
            ]
          },
          "721260102": {
            "id": "721260102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么了？",
            "nextDialogs": [
              "721260103"
            ]
          },
          "721260103": {
            "id": "721260103",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "您…太好了，您来了…是这样，您给了我花种之后，我就开始种花了。",
            "nextDialogs": [
              "721260104"
            ]
          },
          "721260104": {
            "id": "721260104",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "但我还没种多少，就突然出现了一群魔物，一直在我准备种花的地方待着，我已经不敢过去种花了。",
            "nextDialogs": [
              "721260105"
            ]
          },
          "721260105": {
            "id": "721260105",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "再放任它们这样折腾下去，说不定原本种了花的地方也会被它们糟蹋…",
            "nextDialogs": [
              "721260106"
            ]
          },
          "721260106": {
            "id": "721260106",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "如果您愿意的话，能帮我赶走那群魔物吗？我、我只是想要种花而已…",
            "nextDialogs": [
              "721260108",
              "721260110"
            ]
          },
          "721260108": {
            "id": "721260108",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "您答应了？太谢谢您了！那就拜托您了！"
          },
          "721260110": {
            "id": "721260110",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "我是想，大家之所以不愿意回踏鞴砂，应该也是担心经历了「御影炉心」这种事之后，这里已经不太适合居住…",
            "nextDialogs": [
              "721260111"
            ]
          },
          "721260111": {
            "id": "721260111",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "我没办法一个一个地说服所有人，但是，如果我能在这里重新种出很多好看的花…",
            "nextDialogs": [
              "721260112"
            ]
          },
          "721260112": {
            "id": "721260112",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "也许就能说服大家，让大家相信踏鞴砂已经安全了。",
            "nextDialogs": [
              "721260113"
            ]
          },
          "721260113": {
            "id": "721260113",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "而且…嘿嘿，除了种花之外，我也没有什么能说服大家的手段了…",
            "nextDialogs": [
              "721260114"
            ]
          },
          "721260114": {
            "id": "721260114",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "所以，拜托了，请您帮我去赶走那群魔物吧！"
          }
        }
      }
    },
    {
      "subId": "7212602",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721260201"
        ],
        "dialogs": {
          "721260201": {
            "id": "721260201",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "您赶走那些魔物了吗？"
          }
        }
      }
    },
    {
      "subId": "7212603",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721260301"
        ],
        "dialogs": {
          "721260301": {
            "id": "721260301",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "您赶走那些魔物了吗？",
            "nextDialogs": [
              "721260302"
            ]
          },
          "721260302": {
            "id": "721260302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经全部赶走了。",
            "nextDialogs": [
              "721260303"
            ]
          },
          "721260303": {
            "id": "721260303",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "谢谢您，这样我就能继续种花了…",
            "nextDialogs": [
              "721260304"
            ]
          },
          "721260304": {
            "id": "721260304",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "啊，对了，这些东西请您收下，我也没什么好东西给您…总之，谢谢您愿意帮我的忙！"
          }
        }
      }
    },
    {
      "subId": "7212604",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721260401"
        ],
        "dialogs": {
          "721260401": {
            "id": "721260401",
            "speakerId": 3165,
            "speakerName": "叶名山薰",
            "text": "还有很多种子没有种下…我得再加油了…"
          }
        }
      }
    }
  ]
}
        ],
        "dialogs": {
          "708120601": {
            "id": "708120601",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "连告示牌都被吹到那么高的地方去了啊…"
          }
        }
      }
    },
    {
      "subId": "7081207",
      "subQuestName": "(test)进度回滚隔离$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708120701"
        ],
        "dialogs": {
          "708120701": {
            "id": "708120701",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这是冒险家协会的海报吧，我们拿上吧。"
          }
        }
      }
    },
    {
      "subId": "7081208",
      "subQuestName": "与阿拉米对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708120501"
        ],
        "dialogs": {
          "708120501": {
            "id": "708120501",
            "speakerId": 1445,
            "speakerName": "阿拉米",
            "text": "您都收拾好了吗？",
            "nextDialogs": [
              "708120502"
            ]
          },
          "708120502": {
            "id": "708120502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都收拾好了。",
            "nextDialogs": [
              "708120503"
            ]
          },
          "708120503": {
            "id": "708120503",
            "speakerId": 1445,
            "speakerName": "阿拉米",
            "text": "好的，太谢谢您了，这些海报我就收下了，稍后就还给对应的商家。",
            "nextDialogs": [
              "708120504"
            ]
          },
          "708120504": {
            "id": "708120504",
            "speakerId": 1445,
            "speakerName": "阿拉米",
            "text": "那个告示牌…是天使的馈赠酒馆的吧，我已经通知了查尔斯，他会让人来拿回去的。",
            "nextDialogs": [
              "708120505"
            ]
          },
          "708120505": {
            "id": "708120505",
            "speakerId": 1445,
            "speakerName": "阿拉米",
            "text": "谢谢您帮忙，这是一些酬劳，请您收下吧，我要继续处理其他事情了。",
            "nextDialogs": [
              "708120506"
            ]
          },
          "708120506": {
            "id": "708120506",
            "speakerId": 1445,
            "speakerName": "阿拉米",
            "text": "风暴虽然停止了，但它对蒙德城造成的影响，一时半会可处理不完啊…"
          }
        }
      }
    },
    {
      "subId": "7081204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708120401"
        ],
        "dialogs": {
          "708120401": {
            "id": "708120401",
            "speakerId": 1445,
            "speakerName": "阿拉米",
            "text": "大概有三张海报…和一个告示牌被风暴吹到了屋顶和城墙上。",
            "nextDialogs": [
              "708120402"
            ]
          },
          "708120402": {
            "id": "708120402",
            "speakerId": 1445,
            "speakerName": "阿拉米",
            "text": "请您去把那三张海报赶紧拿下来给我吧。告示牌放在地上就行，我会让其他同僚把它还给商家的。"
          }
        }
      }
    }
  ]

        "dialogs": {
          "722070101": {
            "id": "722070101",
            "speakerId": 20429,
            "speakerName": "岻伽",
            "text": "还不够呢…还不够哟…",
            "nextDialogs": [
              "722070102"
            ]
          },
          "722070102": {
            "id": "722070102",
            "speakerId": 20429,
            "speakerName": "岻伽",
            "text": "哥哥留给我的宝藏，都在海螺里哟…",
            "nextDialogs": [
              "722070103"
            ]
          },
          "722070103": {
            "id": "722070103",
            "speakerId": 20429,
            "speakerName": "岻伽",
            "text": "海螺呀海螺，散落得到处都是呢…到处都是呢…",
            "nextDialogs": [
              "722070104"
            ]
          },
          "722070104": {
            "id": "722070104",
            "speakerId": 20429,
            "speakerName": "岻伽",
            "text": "是哥哥的宝藏哟…我还不能离开呢…",
            "nextDialogs": [
              "722070107"
            ]
          },
          "722070107": {
            "id": "722070107",
            "speakerId": 20429,
            "speakerName": "岻伽",
            "text": "哥哥去了雾海以外的地方，祭司大人很生气…他说哥哥的灵再也回不来了…",
            "nextDialogs": [
              "722070108"
            ]
          },
          "722070108": {
            "id": "722070108",
            "speakerId": 20429,
            "speakerName": "岻伽",
            "text": "但哥哥说：「那里有好看的花，有珍珠的海…爸爸也在那里划着船，带着小妹妹招手呢…」",
            "nextDialogs": [
              "722070109"
            ]
          },
          "722070109": {
            "id": "722070109",
            "speakerId": 20429,
            "speakerName": "岻伽",
            "text": "哥哥留下了他的宝藏，就没有再回来…"
          }
        }
      }
    },

  },
  "subQuests": [
    {
      "subId": "7165901",
      "subQuestName": "拜访蒂玛乌斯",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716590101"
        ],
        "dialogs": {
          "716590101": {
            "id": "716590101",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "似乎只差一点了…争取在九个小时内制作出第一份「烟霰丹剂」！",
            "nextDialogs": [
              "716590102"
            ]
          },
          "716590102": {
            "id": "716590102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "蒂玛乌斯？你在干嘛呀，表情这么严肃？",
            "nextDialogs": [
              "716590103"
            ]
          },
          "716590103": {
            "id": "716590103",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "是你们！好久不见了！",
            "nextDialogs": [
              "716590104"
            ]
          },
          "716590104": {
            "id": "716590104",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "实在不好意思，我正在试制「烟霰丹剂」，可能需要占用合成台一段时间。",
            "nextDialogs": [
              "716590105"
            ]
          },
          "716590105": {
            "id": "716590105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「烟霰丹剂」？完全没听说过这种东西呢…",
            "nextDialogs": [
              "716590106"
            ]
          },
          "716590106": {
            "id": "716590106",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "这是近年来出现的神秘药剂，我也是在一本冷门的学术书籍上读到相关资料的。",
            "nextDialogs": [
              "716590107"
            ]
          },
          "716590107": {
            "id": "716590107",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "据作者所说，「烟霰丹剂」起源于璃月，能让使用者的力量成倍增长，效果无与伦比，想必是强大炼金术的造物。",
            "nextDialogs": [
              "716590108"
            ]
          },
          "716590108": {
            "id": "716590108",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "「烟霰丹剂」在璃月得到了高度认可，有着诸如「丹香悠邈焕仪质」的描述…",
            "nextDialogs": [
              "716590109"
            ]
          },
          "716590109": {
            "id": "716590109",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "我仔细进行了评估——如果成功试制「烟霰丹剂」，我对炼金术的理解至少能进步十年！",
            "nextDialogs": [
              "716590110"
            ]
          },
          "716590110": {
            "id": "716590110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "进步十年？这也太厉害了！",
            "nextDialogs": [
              "716590113"
            ]
          },
          "716590113": {
            "id": "716590113",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "放心吧！这本书的作者是个万事通，写过不少令人拍案叫绝的论文！",
            "nextDialogs": [
              "716590114"
            ]
          },
          "716590114": {
            "id": "716590114",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "炼金术是一门奇妙的学问，在发掘古代的技术的同时，参考当世之人的研究成果，不断演化和进步。",
            "nextDialogs": [
              "716590115"
            ]
          },
          "716590115": {
            "id": "716590115",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "所以我才会寻找各种资料，从中发掘能为炼金术提供帮助的知识，推进我的主要课题。",
            "nextDialogs": [
              "716590116"
            ]
          },
          "716590116": {
            "id": "716590116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "蒂玛乌斯的心态还真是积极进取呢！",
            "nextDialogs": [
              "716590117"
            ]
          },
          "716590117": {
            "id": "716590117",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "如果两位能协助我，我肯定能顺利完成这次研究，获得阿贝多老师的认可！",
            "nextDialogs": [
              "716590118"
            ]
          },
          "716590118": {
            "id": "716590118",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "也许我能借此机会成为阿贝多老师的助手，常驻在他的营地里，研究更高深的课题。",
            "nextDialogs": [
              "716590119"
            ]
          },
          "716590119": {
            "id": "716590119",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#怎么办，{NICKNAME}？我们要答应他吗？"
          }
        }
      }
    },
    {
      "subId": "7165902",
      "subQuestName": "寻找「丹剂宗匠」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716590201"
        ],
        "dialogs": {
          "716590201": {
            "id": "716590201",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "我看看地图啊…璃月港的南部是叫「吃虎岩」没错吧？那传说中的「丹剂宗匠」应该就住在这一带。",
            "nextDialogs": [
              "716590202"
            ]
          },
          "716590202": {
            "id": "716590202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们到了，这里就是「吃虎岩」！赶快在附近找找看吧！"
          }
        }
      }
    },
    {
      "subId": "7165906",
      "subQuestName": "询问小千",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716590601"
        ],
        "dialogs": {
          "716590601": {
            "id": "716590601",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你好！请问你认识住在这附近的「丹剂宗匠」吗？",
            "nextDialogs": [
              "716590602"
            ]
          },
          "716590602": {
            "id": "716590602",
            "speakerId": 1002,
            "speakerName": "小千",
            "text": "「丹剂宗匠」？没听说过这号人啊…",
            "nextDialogs": [
              "716590603"
            ]
          },
          "716590603": {
            "id": "716590603",
            "speakerId": 1002,
            "speakerName": "小千",
            "text": "只有地位显赫的人才配得上「宗匠」这种称号吧？我这种小人物当然不认识了。",
            "nextDialogs": [
              "716590604"
            ]
          },
          "716590604": {
            "id": "716590604",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔，那我们去问问其他人吧。"
          }
        }
      }
    },
    {
      "subId": "7165907",
      "subQuestName": "询问弘毅",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716590701"
        ],
        "dialogs": {
          "716590701": {
            "id": "716590701",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你好！我们在找吃虎岩的「丹剂宗匠」，请问你知道他住在哪吗？",
            "nextDialogs": [
              "716590702"
            ]
          },
          "716590702": {
            "id": "716590702",
            "speakerId": 1003,
            "speakerName": "弘毅",
            "text": "不好意思，我不了解街坊邻居们的绰号，只记得他们登记在册的正式姓名。",
            "nextDialogs": [
              "716590703"
            ]
          },
          "716590703": {
            "id": "716590703",
            "speakerId": 1003,
            "speakerName": "弘毅",
            "text": "或许你们可以请教「春香窑」的莺儿。",
            "nextDialogs": [
              "716590704"
            ]
          },
          "716590704": {
            "id": "716590704",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "有道理哦！莺儿小姐应该很熟悉这方面的事吧，我们去问问她好了！"
          }
        }
      }
    },
    {
      "subId": "7165903",
      "subQuestName": "询问莺儿",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716590301"
        ],
        "dialogs": {
          "716590301": {
            "id": "716590301",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "你们终于想起我啦？还带来了一位朋友…是特意来陪我的吗？",
            "nextDialogs": [
              "716590302"
            ]
          },
          "716590302": {
            "id": "716590302",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜，我有点不好意思了…",
            "nextDialogs": [
              "716590303"
            ]
          },
          "716590303": {
            "id": "716590303",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "其实…莺儿小姐，我们是来拜访「丹剂宗匠」的，请问你认识这位大师吗？",
            "nextDialogs": [
              "716590304"
            ]
          },
          "716590304": {
            "id": "716590304",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "啊呀，原来还是另有所图吗？我有一点失望哦…",
            "nextDialogs": [
              "716590305"
            ]
          },
          "716590305": {
            "id": "716590305",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "不过，你们居然在打听我的秘密，还挺让我惊喜的。",
            "nextDialogs": [
              "716590308"
            ]
          },
          "716590308": {
            "id": "716590308",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "等等！难道说，莺儿小姐就是「丹剂宗匠」？",
            "nextDialogs": [
              "716590309"
            ]
          },
          "716590309": {
            "id": "716590309",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "越来越聪明啦，真招人喜欢。",
            "nextDialogs": [
              "716590310"
            ]
          },
          "716590310": {
            "id": "716590310",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "完全没想到会是这样！",
            "nextDialogs": [
              "716590311"
            ]
          },
          "716590311": {
            "id": "716590311",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "「丹剂宗匠」竟然如此年轻…",
            "nextDialogs": [
              "716590312"
            ]
          },
          "716590312": {
            "id": "716590312",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "和阿贝多老师给人的感觉截然不同，但也有一股深不可测的气息！",
            "nextDialogs": [
              "716590313"
            ]
          },
          "716590313": {
            "id": "716590313",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "看你们急切的神情，似乎遇上了难题呢，不妨和我直说吧？",
            "nextDialogs": [
              "716590314"
            ]
          },
          "716590314": {
            "id": "716590314",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不知为什么，总觉得事情要朝着无法预料的方向发展了…",
            "nextDialogs": [
              "716590315"
            ]
          },
          "716590315": {
            "id": "716590315",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "和蒂玛乌斯一起向莺儿解释了「烟霰丹剂」的研究课题。",
            "nextDialogs": [
              "716590316"
            ]
          },
          "716590316": {
            "id": "716590316",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "原来如此，这位炼金术士正在研究奇妙的「烟霰丹剂」…",
            "nextDialogs": [
              "716590317"
            ]
          },
          "716590317": {
            "id": "716590317",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "可惜啊，要让你们失望了。",
            "nextDialogs": [
              "716590318"
            ]
          },
          "716590318": {
            "id": "716590318",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "你们正在调查的「烟霰丹剂」只不过是我特制的一种古法香膏而已，和炼金术完全无关。",
            "nextDialogs": [
              "716590319"
            ]
          },
          "716590319": {
            "id": "716590319",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "香膏？那不是一种固体香料吗？",
            "nextDialogs": [
              "716590320"
            ]
          },
          "716590320": {
            "id": "716590320",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「烟霰丹剂」这个名字听起来明明很厉害啊！书里也写着它能让人们变强…",
            "nextDialogs": [
              "716590321"
            ]
          },
          "716590321": {
            "id": "716590321",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "呵呵，大概是我的古法香膏太受欢迎的缘故吧。",
            "nextDialogs": [
              "716590322"
            ]
          },
          "716590322": {
            "id": "716590322",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "古代的文人曾强调「熏陶」一词。长期沉浸在香膏的芬芳中，人们的气质和心性也会受到影响哦。",
            "nextDialogs": [
              "716590323"
            ]
          },
          "716590323": {
            "id": "716590323",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "使用了我的古法香膏之后，人们的气质大变，魅力大增，待人接物的信心大涨，人际关系也不断改善。事业步步高升，生活顺心顺意…",
            "nextDialogs": [
              "716590324"
            ]
          },
          "716590324": {
            "id": "716590324",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "就像是使用了仙人的丹药一样，运势明显好转。",
            "nextDialogs": [
              "716590325"
            ]
          },
          "716590325": {
            "id": "716590325",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "因此，人们给我的古法香膏起了个富有诗意的称号，还写下了简单易懂的诗词，夸赞它们的功效。",
            "nextDialogs": [
              "716590326"
            ]
          },
          "716590326": {
            "id": "716590326",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "原来是这样！",
            "nextDialogs": [
              "716590327"
            ]
          },
          "716590327": {
            "id": "716590327",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "不可能啊…难不成，我在那本书里读到的论文并不准确？或者说，我对诗词的理解出现了偏差？",
            "nextDialogs": [
              "716590328"
            ]
          },
          "716590328": {
            "id": "716590328",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "比如「丹香悠邈焕仪质」。这一段的含义应该是：「烟霰丹剂」能激发出人的威仪和潜质…没错吧，莺儿小姐？",
            "nextDialogs": [
              "716590329"
            ]
          },
          "716590329": {
            "id": "716590329",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "啊呀，「仪质」其实是一个完整的词，意为人的风度和气质。这句诗词其实是在说，古法香膏令人拥有了焕然一新的容姿。",
            "nextDialogs": [
              "716590330"
            ]
          },
          "716590330": {
            "id": "716590330",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "也不能怪你，诗词也是一门深奥的学问，可不能像分析数据那样，拆开成零散的文字来解读，而是要注意整体的意境哦。",
            "nextDialogs": [
              "716590331"
            ]
          },
          "716590331": {
            "id": "716590331",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "逐字逐句拆解的分析方法居然不管用？",
            "nextDialogs": [
              "716590332"
            ]
          },
          "716590332": {
            "id": "716590332",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "可是那本书还提到了不少「烟霰丹剂」发挥神奇功效的例子，让我看得目瞪口呆…",
            "nextDialogs": [
              "716590333"
            ]
          },
          "716590333": {
            "id": "716590333",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "刺激而神秘的事物总是令人神往的嘛，就像透过窗纸的婀娜身影。记录坊间传闻的书籍，也需要适当的艺术加工。",
            "nextDialogs": [
              "716590334"
            ]
          },
          "716590334": {
            "id": "716590334",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "多谢那位作者的夸赞啦~",
            "nextDialogs": [
              "716590335"
            ]
          },
          "716590335": {
            "id": "716590335",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "怎么会这样…",
            "nextDialogs": [
              "716590336"
            ]
          },
          "716590336": {
            "id": "716590336",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "也就是说，蒂玛乌斯的参考资料夸大了香膏的效果，他也错误地理解了诗词。导致他误以为「烟霰丹剂」是强大的炼金术药剂？"
          }
        }
      }
    },
    {
      "subId": "7165904",
      "subQuestName": "协助蒂玛乌斯和莺儿",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "716590401"
        ],
        "dialogs": {
          "716590401": {
            "id": "716590401",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "制作古法香膏的流程啊，可是相当讲究的。",
            "nextDialogs": [
              "716590402"
            ]
          },
          "716590402": {
            "id": "716590402",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "要像摩挲恋人的肌肤一样，以极为温柔的力道剥开花苞，取下花瓣，将它们细致地叠放。",
            "nextDialogs": [
              "716590403"
            ]
          },
          "716590403": {
            "id": "716590403",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "纤薄的花瓣在上，厚实的花瓣在下，留下适当的空隙，再将它们捣碎…",
            "nextDialogs": [
              "716590404"
            ]
          },
          "716590404": {
            "id": "716590404",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "臼杵不必握得太紧，手腕要放松，节奏要起伏有致。",
            "nextDialogs": [
              "716590405"
            ]
          },
          "716590405": {
            "id": "716590405",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "等到花瓣的汁液弥漫，臼杵的底部完全湿润，再适当加快速度。",
            "nextDialogs": [
              "716590406"
            ]
          },
          "716590406": {
            "id": "716590406",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "这…咳咳！",
            "nextDialogs": [
              "716590407"
            ]
          },
          "716590407": {
            "id": "716590407",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "莺儿小姐的用词还真是…特别！我大概理解你的意思了。",
            "nextDialogs": [
              "716590408"
            ]
          },
          "716590408": {
            "id": "716590408",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "谨慎处理原料，注意置入容器的次序，把握浸入基液的时间，以便精确控制火候…",
            "nextDialogs": [
              "716590409"
            ]
          },
          "716590409": {
            "id": "716590409",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "制作一些高等炼金药剂时，也需要以这么严格的要求把控细节。",
            "nextDialogs": [
              "716590410"
            ]
          },
          "716590410": {
            "id": "716590410",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "你的悟性很不错嘛，但制作香膏的要点远不止这些哦。",
            "nextDialogs": [
              "716590411"
            ]
          },
          "716590411": {
            "id": "716590411",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "有些香膏的「升华效应」极为重要，需要加入合适的辅料，比如薄荷和星螺磨制的粉末。",
            "nextDialogs": [
              "716590412"
            ]
          },
          "716590412": {
            "id": "716590412",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "这样一来，香膏的气味就能快速弥漫开来，让周围的人心旷神怡。",
            "nextDialogs": [
              "716590413"
            ]
          },
          "716590413": {
            "id": "716590413",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "但「升华效应」也不能太强，否则，香膏很快就会消耗殆尽。",
            "nextDialogs": [
              "716590414"
            ]
          },
          "716590414": {
            "id": "716590414",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "升华…升华？",
            "nextDialogs": [
              "716590415"
            ]
          },
          "716590415": {
            "id": "716590415",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "我懂了，古法香膏的这种特性，正是我所追求的关键之处！",
            "nextDialogs": [
              "716590416"
            ]
          },
          "716590416": {
            "id": "716590416",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "弥漫在空气里的药剂能同时作用于使用者和环境，相比普通的精油，效果应该更明显！",
            "nextDialogs": [
              "716590417"
            ]
          },
          "716590417": {
            "id": "716590417",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "而且，适当控制升华的速度以后，持续时间应该也会比普通的精油更长！",
            "nextDialogs": [
              "716590418"
            ]
          },
          "716590418": {
            "id": "716590418",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "向这个方向努力，绝对不会有错！",
            "nextDialogs": [
              "716590419"
            ]
          },
          "716590419": {
            "id": "716590419",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "进入学术讨论后，就完全插不上嘴了…",
            "nextDialogs": [
              "716590420"
            ]
          },
          "716590420": {
            "id": "716590420",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还是不要打扰他们两位了吧。",
            "nextDialogs": [
              "716590421"
            ]
          },
          "716590421": {
            "id": "716590421",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "在莺儿的指点下，蒂玛乌斯尝试制作了改进的炼金药剂。",
            "nextDialogs": [
              "716590422"
            ]
          },
          "716590422": {
            "id": "716590422",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好香啊！只是闻到这种气味，就让人感觉十分清爽，又充满力量呢！",
            "nextDialogs": [
              "716590425"
            ]
          },
          "716590425": {
            "id": "716590425",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "成功了！我总算成功了！结合了香膏古法的炼金药剂完成了！",
            "nextDialogs": [
              "716590426"
            ]
          },
          "716590426": {
            "id": "716590426",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "多亏了莺儿小姐的指导，我才能在这么短的时间内找到窍门，顺利制备这些药剂！",
            "nextDialogs": [
              "716590427"
            ]
          },
          "716590427": {
            "id": "716590427",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "太谦虚的话，就会显得虚假和客套啦。你的学识和悟性才是成功的关键哦。",
            "nextDialogs": [
              "716590428"
            ]
          },
          "716590428": {
            "id": "716590428",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "现在…不如先为你的心血之作起个名字？",
            "nextDialogs": [
              "716590429"
            ]
          },
          "716590429": {
            "id": "716590429",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "就叫它们「烟霰魔药」吧！它们结合了莺儿小姐的香膏和炼金药剂的特性，意义非凡，一定会被记载在学术史上！",
            "nextDialogs": [
              "716590430"
            ]
          },
          "716590430": {
            "id": "716590430",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "啊呀，真让我受宠若惊呢~",
            "nextDialogs": [
              "716590431"
            ]
          },
          "716590431": {
            "id": "716590431",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过这个名字和之前的「烟霰丹剂」…没什么区别吧？",
            "nextDialogs": [
              "716590432"
            ]
          },
          "716590432": {
            "id": "716590432",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "咳咳，言归正传！",
            "nextDialogs": [
              "716590433"
            ]
          },
          "716590433": {
            "id": "716590433",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "旅行者，你会是「烟霰魔药」的首位使用者。",
            "nextDialogs": [
              "716590434"
            ]
          },
          "716590434": {
            "id": "716590434",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "目前的「烟霰魔药」还需要完善，能麻烦你试验一下这些药剂的效果吗？",
            "nextDialogs": [
              "716590435"
            ]
          },
          "716590435": {
            "id": "716590435",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "在空气流动相对缓慢的区域，「烟霰魔药」的效果会更明显。",
            "nextDialogs": [
              "716590436"
            ]
          },
          "716590436": {
            "id": "716590436",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "听说璃月有一些无人造访的秘境，它们是相当理想的试验场地！"
          }
        }
      }
    },
    {
      "subId": "7165905",
      "subQuestName": "前往秘境，试验「烟霰魔药」",
      "sceneId": null,

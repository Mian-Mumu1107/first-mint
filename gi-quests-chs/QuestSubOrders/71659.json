        ],
        "dialogs": {
          "716595101": {
            "id": "716595101",
            "speakerId": 1004,
            "speakerName": "莺儿",
            "text": "香膏和精油还有许许多多学问，想听听看吗？",
            "nextDialogs": [
              "716595102"
            ]
          },
          "716595102": {
            "id": "716595102",
            "speakerId": 1000,
            "speakerName": "蒂玛乌斯",
            "text": "当然！如果莺儿小姐不介意，聊上几天几夜都没问题！"
          }
        }
      }
    }
  ]
}
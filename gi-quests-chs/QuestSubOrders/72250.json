{
  "lineCounts": {
    "Player": 1,
    "派蒙": 6,
    "贺摩": 11
  },
  "subQuests": [
    {
      "subId": "7225001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722500101"
        ],
        "dialogs": {
          "722500101": {
            "id": "722500101",
            "speakerId": 1000,
            "speakerName": "贺摩",
            "text": "啊！救、救命…",
            "nextDialogs": [
              "722500102"
            ]
          },
          "722500102": {
            "id": "722500102",
            "speakerId": 1000,
            "speakerName": "贺摩",
            "text": "小人听说最近大人们疲于应付须婆达之彦领导的反叛，大日御舆防卫空虚，才动了不该动的歪念头…",
            "nextDialogs": [
              "722500103"
            ]
          },
          "722500103": {
            "id": "722500103",
            "speakerId": 1000,
            "speakerName": "贺摩",
            "text": "看在小人上有重疾老母需要赡养，下有十二个出于爱心拉扯大的孤儿的份上！还请守备大人高抬一手，把小人当个屁，就放了吧！",
            "nextDialogs": [
              "722500104"
            ]
          },
          "722500104": {
            "id": "722500104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "咳咳…",
            "nextDialogs": [
              "722500105"
            ]
          },
          "722500105": {
            "id": "722500105",
            "speakerId": 1000,
            "speakerName": "贺摩",
            "text": "咦，嗐，什么呀，原来不是大日御舆的守卫啊。",
            "nextDialogs": [
              "722500106"
            ]
          },
          "722500106": {
            "id": "722500106",
            "speakerId": 1000,
            "speakerName": "贺摩",
            "text": "看你这奇装异服的…不会是从什么奇怪地方来的同行吧。",
            "nextDialogs": [
              "722500107"
            ]
          },
          "722500107": {
            "id": "722500107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "什么同行不同行的！",
            "nextDialogs": [
              "722500108"
            ]
          },
          "722500108": {
            "id": "722500108",
            "speakerId": 1000,
            "speakerName": "贺摩",
            "text": "都到这儿了还装什么呀，唉，真是出师不利，好不容易进入大日御舆，大肆搜刮了一把，却被机关困住。",
            "nextDialogs": [
              "722500109"
            ]
          },
          "722500109": {
            "id": "722500109",
            "speakerId": 1000,
            "speakerName": "贺摩",
            "text": "看来今日不宜…不宜行劫富济贫的义举之事。",
            "nextDialogs": [
              "722500110"
            ]
          },
          "722500110": {
            "id": "722500110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哼，小偷就小偷，还说成是劫富济贫。",
            "nextDialogs": [
              "722500111"
            ]
          },
          "722500111": {
            "id": "722500111",
            "speakerId": 1000,
            "speakerName": "贺摩",
            "text": "你懂什么，大人们每日听着靡靡之音，饮酒作乐，我们这些底层人就得累死累活，给他们倒尿盆子，热草鞋，哪有这种道理！",
            "nextDialogs": [
              "722500112"
            ]
          },
          "722500112": {
            "id": "722500112",
            "speakerId": 1000,
            "speakerName": "贺摩",
            "text": "哎对了，我跟你说个秘密，就当你们救我的回报。我之前收买了维修大日御舆的工匠，像这样藏有财宝的房间，还有两个！",
            "nextDialogs": [
              "722500113"
            ]
          },
          "722500113": {
            "id": "722500113",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "还有两个！",
            "nextDialogs": [
              "722500114"
            ]
          },
          "722500114": {
            "id": "722500114",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，我觉得我们也有必要，行、行一些劫富济贫的义举之事。",
            "nextDialogs": [
              "722500115"
            ]
          },
          "722500115": {
            "id": "722500115",
            "speakerId": 1000,
            "speakerName": "贺摩",
            "text": "不过这两个房间的位置我也不是很清楚了，毕竟那工匠也不敢再说其他。",
            "nextDialogs": [
              "722500116"
            ]
          },
          "722500116": {
            "id": "722500116",
            "speakerId": 1000,
            "speakerName": "贺摩",
            "text": "这情报就当是贺礼吧！",
            "nextDialogs": [
              "722500117"
            ]
          },
          "722500117": {
            "id": "722500117",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "反正现在的渊下宫也没有人在，说不定那里有很多以前的古董呢！",
            "nextDialogs": [
              "722500118"
            ]
          },
          "722500118": {
            "id": "722500118",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，待会儿我们就悄悄在周围找找吧！"
          }
        }
      }
    }
  ]
}
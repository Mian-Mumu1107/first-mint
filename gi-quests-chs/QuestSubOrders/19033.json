  "subQuests": [
    {
      "subId": "1903301",
      "subQuestName": "独自寻找妖邪的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "1903201201"
        ],
        "dialogs": {
          "1903201201": {
            "id": "1903201201",
            "speakerId": 1000,
            "speakerName": "周良",
            "text": "唉，好累，终于可以休息了。",
            "nextDialogs": [
              "1903201202"
            ]
          },
          "1903201202": {
            "id": "1903201202",
            "speakerId": 1000,
            "speakerName": "周良",
            "text": "是不是有点过火了呢，好像有几个人被吓破胆了。",
            "nextDialogs": [
              "1903201203"
            ]
          },
          "1903201203": {
            "id": "1903201203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问你是？",
            "nextDialogs": [
              "1903201204"
            ]
          },
          "1903201204": {
            "id": "1903201204",
            "speakerId": 1000,
            "speakerName": "周良",
            "text": "啊啊，这里不应该靠近！",
            "nextDialogs": [
              "1903201205"
            ]
          },
          "1903201205": {
            "id": "1903201205",
            "speakerId": 1000,
            "speakerName": "周良",
            "text": "唉，算了，被你听到了吧？",
            "nextDialogs": [
              "1903201206"
            ]
          },
          "1903201206": {
            "id": "1903201206",
            "speakerId": 1000,
            "speakerName": "周良",
            "text": "我就是在这里扮演鬼怪的工作人员，现在轮到我休息，所以又热又不透气的衣服被我脱掉了。",
            "nextDialogs": [
              "1903201209"
            ]
          },
          "1903201209": {
            "id": "1903201209",
            "speakerId": 1000,
            "speakerName": "周良",
            "text": "是啊，怎么可能会有真正的鬼？",
            "nextDialogs": [
              "1903201210"
            ]
          },
          "1903201210": {
            "id": "1903201210",
            "speakerId": 1000,
            "speakerName": "周良",
            "text": "无论是我们，还是来参加试胆大会的人，都不希望看到真正的鬼吧。",
            "nextDialogs": [
              "1903201211"
            ]
          },
          "1903201211": {
            "id": "1903201211",
            "speakerId": 1000,
            "speakerName": "周良",
            "text": "他们想要的，只是一种氛围，或者说，契机。最重要的是刺激的感觉。",
            "nextDialogs": [
              "1903201212"
            ]
          },
          "1903201212": {
            "id": "1903201212",
            "speakerId": 1000,
            "speakerName": "周良",
            "text": "在提心吊胆中，遭遇一些意外，顺势说出平时不敢说的话，这就是试胆大会的作用。"
          }
        }
      }
    }
  ]
}
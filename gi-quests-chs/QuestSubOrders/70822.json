      }
    },
    {
      "subId": "7082205",
      "subQuestName": "安抚伊凡诺维奇",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708220401"
        ],
        "dialogs": {
          "708220401": {
            "id": "708220401",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "不然，还是想点别的办法吧…",
            "nextDialogs": [
              "708220402"
            ]
          },
          "708220402": {
            "id": "708220402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你还好吗？",
            "nextDialogs": [
              "708220403"
            ]
          },
          "708220403": {
            "id": "708220403",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "我？哦…你是说最近璃月港里的那些事吧，我倒是没什么感觉。",
            "nextDialogs": [
              "708220404"
            ]
          },
          "708220404": {
            "id": "708220404",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "不过，原本在至冬国内负责给我供货，也偶尔收购石珀的人反倒是很不安。",
            "nextDialogs": [
              "708220405"
            ]
          },
          "708220405": {
            "id": "708220405",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "虽然我说璃月港不会有什么问题，但他们还是坚持过几个月再来，这段时间先看看情况。",
            "nextDialogs": [
              "708220406"
            ]
          },
          "708220406": {
            "id": "708220406",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "好在我之前新进了几批货物，能够支持一段时间，我正好趁着这时候再收一波石珀。",
            "nextDialogs": [
              "708220407"
            ]
          },
          "708220407": {
            "id": "708220407",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "我在这里理理货，你能帮我去找博来先生问问，他那里还有没有要出手的石珀吗？",
            "nextDialogs": [
              "708220409",
              "708220411"
            ]
          },
          "708220409": {
            "id": "708220409",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "那就拜托你了。"
          },
          "708220411": {
            "id": "708220411",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "在我看来，这确实不算什么大事。而且现在璃月港里的正常秩序也没有乱，也没什么好慌的。",
            "nextDialogs": [
              "708220412"
            ]
          },
          "708220412": {
            "id": "708220412",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "再说了…人家都慌了，我不慌，那我不就比人家抢先一步了吗？"
          }
        }
      }
    },
    {
      "subId": "7082206",
      "subQuestName": "与博来谈谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708220501"
        ],
        "dialogs": {
          "708220501": {
            "id": "708220501",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "您这…都这时候了，还有空来关照我生意？",
            "nextDialogs": [
              "708220502"
            ]
          },
          "708220502": {
            "id": "708220502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于伊凡诺维奇…",
            "nextDialogs": [
              "708220503"
            ]
          },
          "708220503": {
            "id": "708220503",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "哦，那位在港口那边做生意的外国人啊，他还要收我的石珀？",
            "nextDialogs": [
              "708220504"
            ]
          },
          "708220504": {
            "id": "708220504",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "行啊，送上门的生意，我可不能放过了。",
            "nextDialogs": [
              "708220505"
            ]
          },
          "708220505": {
            "id": "708220505",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "我这里正好还有一批石珀，本来是给另外一个客人预备的，但是那位说最近璃月港不安全，先不要了。",
            "nextDialogs": [
              "708220506"
            ]
          },
          "708220506": {
            "id": "708220506",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "如果那位先生愿意收，那我也乐得出手，您先回去告诉他吧，我在这先把货给点好。"
          }
        }
      }
    },
    {
      "subId": "7082207",
      "subQuestName": "向伊凡诺维奇回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708220601"
        ],
        "dialogs": {
          "708220601": {
            "id": "708220601",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "怎么样，博来先生怎么说的？",
            "nextDialogs": [
              "708220602"
            ]
          },
          "708220602": {
            "id": "708220602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "他说会把货备好。",
            "nextDialogs": [
              "708220603"
            ]
          },
          "708220603": {
            "id": "708220603",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "那就太好了，这位先生我是信得过的。",
            "nextDialogs": [
              "708220604"
            ]
          },
          "708220604": {
            "id": "708220604",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "等我那些胆小的商业伙伴们再来璃月港的时候，我又可以大赚一笔了。"
          }
        }
      }
    },
    {
      "subId": "7082208",
      "subQuestName": "安抚竺子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708220701"
        ],
        "dialogs": {
          "708220701": {
            "id": "708220701",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "哎呀，这可怎么办…",
            "nextDialogs": [
              "708220702"
            ]
          },
          "708220702": {
            "id": "708220702",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "幸会！啊不对，应该是…你好，对吧。",
            "nextDialogs": [
              "708220703"
            ]
          },
          "708220703": {
            "id": "708220703",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "我还不太熟悉本地人打招呼的方式，璃月和稻妻真的完全不一样呢…",
            "nextDialogs": [
              "708220705"
            ]
          },
          "708220705": {
            "id": "708220705",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "嗯嗯，为了来璃月，我可费了不少周折。",
            "nextDialogs": [
              "708220707"
            ]
          },
          "708220707": {
            "id": "708220707",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "哎呀，因为我一直想要环游世界，但是我家乡那边的氛围…怎么说呢，紧张？危险？",
            "nextDialogs": [
              "708220708"
            ]
          },
          "708220708": {
            "id": "708220708",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "别说是环游世界了，就算是想要出海也是困难重重，一般人连「勘定奉行」的多重审批都通不过。",
            "nextDialogs": [
              "708220709"
            ]
          },
          "708220709": {
            "id": "708220709",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "所以，我就自己扎了条木筏，偷偷跑到璃月来啦。",
            "nextDialogs": [
              "708220710"
            ]
          },
          "708220710": {
            "id": "708220710",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "我本来是想在码头上找一份水手的工作，但是…连怎么找工作都不知道。",
            "nextDialogs": [
              "708220711"
            ]
          },
          "708220711": {
            "id": "708220711",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "而且璃月又不知道发生了什么，街上一下子紧张了起来。",
            "nextDialogs": [
              "708220712"
            ]
          },
          "708220712": {
            "id": "708220712",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "我这个外国人，想必也没有什么地方肯给一份工作吧…"
          }
        }
      }
    },
    {
      "subId": "7082212",
      "subQuestName": "与阿宽、小昭和小安谈谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708221401"
        ],
        "dialogs": {
          "708221401": {
            "id": "708221401",
            "speakerId": 2099,
            "speakerName": "阿宽",
            "text": "唉，怎么还没有个准信…",
            "nextDialogs": [
              "708221402"
            ]
          },
          "708221402": {
            "id": "708221402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于工作…",
            "nextDialogs": [
              "708221403"
            ]
          },
          "708221403": {
            "id": "708221403",
            "speakerId": 2099,
            "speakerName": "阿宽",
            "text": "找工作？那你找错人了，总务司把层岩巨渊都封了，黑岩厂也停了工。",
            "nextDialogs": [
              "708221404"
            ]
          },
          "708221404": {
            "id": "708221404",
            "speakerId": 2099,
            "speakerName": "阿宽",
            "text": "厂里一堆人闲着，每天只能做点小活计糊口，暂时不招新人来工作了。",
            "nextDialogs": [
              "708221405"
            ]
          },
          "708221405": {
            "id": "708221405",
            "speakerId": 2099,
            "speakerName": "阿宽",
            "text": "哼，再这么停下去，我看这几百号人真去街上找工作，总务司怎么办…"
          }
        }
      }
    },
    {
      "subId": "7082213",
      "subQuestName": "与阿宽、小昭和小安谈谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708221501"
        ],
        "dialogs": {
          "708221501": {
            "id": "708221501",
            "speakerId": 2012,
            "speakerName": "小安",
            "text": "你回来了，事情怎么样了？",
            "nextDialogs": [
              "708221502"
            ]
          },
          "708221502": {
            "id": "708221502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于竺子…",
            "nextDialogs": [
              "708221503"
            ]
          },
          "708221503": {
            "id": "708221503",
            "speakerId": 2012,
            "speakerName": "小安",
            "text": "哦，你说那位稻妻的女士啊，她一直在码头上打听工作的事，我对她有印象。",
            "nextDialogs": [
              "708221504"
            ]
          },
          "708221504": {
            "id": "708221504",
            "speakerId": 2012,
            "speakerName": "小安",
            "text": "不过，我这边还真没有合适她做的工作，你也看到了，我这边的表单和数据都必须要熟手来做。",
            "nextDialogs": [
              "708221505"
            ]
          },
          "708221505": {
            "id": "708221505",
            "speakerId": 2012,
            "speakerName": "小安",
            "text": "就算是从总务司借调文员过来，也要培训一段时间才能上手，不然只能帮倒忙。",
            "nextDialogs": [
              "708221506"
            ]
          },
          "708221506": {
            "id": "708221506",
            "speakerId": 2012,
            "speakerName": "小安",
            "text": "特别是在这个时候，我更不敢招个生手了，所以很抱歉，我这里暂时没有适合那位女士的工作。"
          }
        }
      }
    },
    {
      "subId": "7082209",
      "subQuestName": "与阿宽、小昭和小安谈谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708220801"
        ],
        "dialogs": {
          "708220801": {
            "id": "708220801",
            "speakerId": 2085,
            "speakerName": "小昭",
            "text": "这个结不掉…这个结不掉…这个又要延期…",
            "nextDialogs": [
              "708220802"
            ]
          },
          "708220802": {
            "id": "708220802",
            "speakerId": 2085,
            "speakerName": "小昭",
            "text": "这些单子是要我亲自去催他们才做吗？！",
            "nextDialogs": [
              "708220803"
            ]
          },
          "708220803": {
            "id": "708220803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你怎么了…",
            "nextDialogs": [
              "708220804"
            ]
          },
          "708220804": {
            "id": "708220804",
            "speakerId": 2085,
            "speakerName": "小昭",
            "text": "没什么，就是一堆单子没人做，我不去把单子拍到他们面前去催，他们就一直延期。",
            "nextDialogs": [
              "708220805"
            ]
          },
          "708220805": {
            "id": "708220805",
            "speakerId": 2085,
            "speakerName": "小昭",
            "text": "现在璃月港里出了那么大的事，我还有一堆事要处理，怎么可能腾出手来去一个个催他们！",
            "nextDialogs": [
              "708220806"
            ]
          },
          "708220806": {
            "id": "708220806",
            "speakerId": 2085,
            "speakerName": "小昭",
            "text": "总务司又抽不出人手来，这些单子我真是看着就烦！",
            "nextDialogs": [
              "708220807"
            ]
          },
          "708220807": {
            "id": "708220807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "催单…需要什么技术吗？",
            "nextDialogs": [
              "708220808"
            ]
          },
          "708220808": {
            "id": "708220808",
            "speakerId": 2085,
            "speakerName": "小昭",
            "text": "技术？不需要，具体的需求和截止时间我都已经写在表上了，只需要送到对应的人面前就行。",
            "nextDialogs": [
              "708220809"
            ]
          },
          "708220809": {
            "id": "708220809",
            "speakerId": 2085,
            "speakerName": "小昭",
            "text": "如果单子送到了，那些人还是没按规定结掉手上的活，或者是再延期，导致工作不能按期完成…",
            "nextDialogs": [
              "708220810"
            ]
          },
          "708220810": {
            "id": "708220810",
            "speakerId": 2085,
            "speakerName": "小昭",
            "text": "哼，那就自己来总务司解释原因吧。",
            "nextDialogs": [
              "708220811"
            ]
          },
          "708220811": {
            "id": "708220811",
            "speakerId": 2085,
            "speakerName": "小昭",
            "text": "怎么，你是想要帮忙，还是有愿意来帮忙的人，我都欢迎。",
            "nextDialogs": [
              "708220813",
              "708220815"
            ]
          },
          "708220813": {
            "id": "708220813",
            "speakerId": 2085,
            "speakerName": "小昭",
            "text": "那太好了，快点让你的那位朋友来报道，这些单子越快结掉越好。"
          },
          "708220815": {
            "id": "708220815",
            "speakerId": 2085,
            "speakerName": "小昭",
            "text": "都可以，只要够认真，够负责就好。",
            "nextDialogs": [
              "708220816"
            ]
          },
          "708220816": {
            "id": "708220816",
            "speakerId": 2085,
            "speakerName": "小昭",
            "text": "你是有朋友愿意来帮忙吗？那太好了，让你的朋友直接过来报道吧，这些单子越快结掉越好。"
          }
        }
      }
    },
    {
      "subId": "7082210",
      "subQuestName": "向竺子回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708220901"
        ],
        "dialogs": {
          "708220901": {
            "id": "708220901",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "怎么样，他们有回复吗？",
            "nextDialogs": [
              "708220902"
            ]
          },
          "708220902": {
            "id": "708220902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "小昭说可以让你去工作…",
            "nextDialogs": [
              "708220903"
            ]
          },
          "708220903": {
            "id": "708220903",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "太好了！具体是做什么？催单…在稻妻没听说过这种工作…",
            "nextDialogs": [
              "708220904"
            ]
          },
          "708220904": {
            "id": "708220904",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "璃月果然和稻妻完全不一样啊。",
            "nextDialogs": [
              "708220905"
            ]
          },
          "708220905": {
            "id": "708220905",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "不过，无论是什么工作，我都会全力以赴的！",
            "nextDialogs": [
              "708220906"
            ]
          },
          "708220906": {
            "id": "708220906",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "谢谢你，我准备准备就过去报道啦。",
            "nextDialogs": [
              "708220907"
            ]
          },
          "708220907": {
            "id": "708220907",
            "speakerId": 2077,
            "speakerName": "竺子",
            "text": "这下子，总算可以迈出新生活的第一步啦。"
          }
        }
      }
    },
    {
      "subId": "7082211",
      "subQuestName": "向小安回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708221001"
        ],
        "dialogs": {
          "708221001": {
            "id": "708221001",
            "speakerId": 2012,
            "speakerName": "小安",
            "text": "怎么样，事情办好了吗？",
            "nextDialogs": [
              "708221002"
            ]
          },
          "708221002": {
            "id": "708221002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "已经办好了。",
            "nextDialogs": [
              "708221003"
            ]
          },
          "708221003": {
            "id": "708221003",
            "speakerId": 2012,
            "speakerName": "小安",
            "text": "谢谢你，剩下的事就由我来办吧，除了这些外国客人，总务司对璃月港市民们的安抚工作也已经在快速推进了。",
            "nextDialogs": [
              "708221004"
            ]
          },
          "708221004": {
            "id": "708221004",
            "speakerId": 2012,
            "speakerName": "小安",
            "text": "虽然不知道这样效果如何，但总之，在这种风波里，能尽一份力就尽一份力吧。",
            "nextDialogs": [
              "708221005"
            ]
          },
          "708221005": {
            "id": "708221005",
            "speakerId": 2012,
            "speakerName": "小安",
            "text": "这些给你，就算是谢礼吧，你也算是外来的客人，但来的时间实在是不巧…",
            "nextDialogs": [
              "708221006"
            ]
          },
          "708221006": {
            "id": "708221006",
            "speakerId": 2012,
            "speakerName": "小安",
            "text": "希望这一切都快点过去…"
          }
        }
      }
    },
    {
      "subId": "7082213",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708221301"
        ],
        "dialogs": {
          "708221301": {
            "id": "708221301",
            "speakerId": 2082,
            "speakerName": "弗莱琪",
            "text": "杰里看来确实不太能接受中原杂碎这种菜色呢。",
            "nextDialogs": [
              "708221302"
            ]
          },
          "708221302": {
            "id": "708221302",
            "speakerId": 2082,
            "speakerName": "弗莱琪",
            "text": "哈哈哈，这道菜对他来说，似乎比「请仙典仪」发生意外还可怕呢。",
            "nextDialogs": [
              "708221303"
            ]
          },
          "708221303": {
            "id": "708221303",
            "speakerId": 2082,
            "speakerName": "弗莱琪",
            "text": "希望翡玉什锦袋能让他对璃月的美食重新恢复信心。"
          }
        }
      }
    },
    {
      "subId": "7082216",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708221601"
        ],
        "dialogs": {
          "708221601": {
            "id": "708221601",
            "speakerId": 2046,
            "speakerName": "杰里",
            "text": "唉，我还是想回蒙德城，就算是吃份满足沙拉也好啊…"
          }
        }
      }
    },
    {
      "subId": "7082217",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708221701"
        ],
        "dialogs": {
          "708221701": {
            "id": "708221701",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "哼，怎么说呢，做生意这件事吧…撑死大胆的，饿死胆小的。"
          }
        }
      }
    },
    {
      "subId": "7082218",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708221801"
        ],
        "dialogs": {
          "708221801": {
            "id": "708221801",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "哼，做生意的人，可不能太胆小了。"
          }
        }
      }
    },
    {
      "subId": "7082219",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708221901"
        ],
        "dialogs": {
          "708221901": {
            "id": "708221901",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "璃月港可真是一座繁忙的城市啊，虽然稻妻也很繁忙…",
            "nextDialogs": [
              "708221902"
            ]
          },
          "708221902": {
            "id": "708221902",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "但是…两座城市的「繁忙」，给人的感觉完全不一样呢。",
            "nextDialogs": [
              "708221903"
            ]
          },
          "708221903": {
            "id": "708221903",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "我这么说你也没法体会啦，如果你有机会去稻妻的话，就自己感受一下吧。",
            "nextDialogs": [
              "708221904"
            ]
          },
          "708221904": {
            "id": "708221904",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "哎呀，算了…要我说，你最好还是别去稻妻了。并不是我想说我家乡的坏话，现在的稻妻可不太适合去旅行。"
          }
        }
      }
    },
    {
      "subId": "7082220",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708222001"
        ],
        "dialogs": {
          "708222001": {
            "id": "708222001",
            "speakerId": 2046,
            "speakerName": "杰里",
            "text": "…这道菜的味道可真不错，璃月港这地方也太神奇了。居然会同时存在中原杂碎这种可怕的菜，和这种美味…",
            "nextDialogs": [
              "708222002"
            ]
          },
          "708222002": {
            "id": "708222002",
            "speakerId": 2082,
            "speakerName": "弗莱琪",
            "text": "这哪里叫神奇，我说过了，璃月港里有很多名菜，我们还远远没有尝试完呢。"
          }
        }
      }
    },
    {
      "subId": "7082223",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708222301"
        ],
        "dialogs": {
          "708222301": {
            "id": "708222301",
            "speakerId": 2072,
            "speakerName": "伊凡诺维奇",
            "text": "不知道这些货能撑多久，真是受不了那群胆小的家伙，白白放跑了商机…"
          }
        }
      }
    },
    {
      "subId": "7082224",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708222401"
        ],
        "dialogs": {
          "708222401": {
            "id": "708222401",
            "speakerId": 2012,
            "speakerName": "小安",
            "text": "事情都堆在一起了，真是一团糟…"
          }
        }
      }
    },
    {
      "subId": "7082225",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708222501"
        ],
        "dialogs": {
          "708222501": {
            "id": "708222501",
            "speakerId": 2012,
            "speakerName": "小安",
            "text": "唉，什么时候才能恢复正常啊…"
          }
        }
      }
    },
    {
      "subId": "7082226",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708222601"
        ],
        "dialogs": {
          "708222601": {
            "id": "708222601",
            "speakerId": 2085,
            "speakerName": "小昭",
            "text": "必须快点把这些事情都处理好…"
          }
        }
      }
    },
    {
      "subId": "7082227",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708222701"
        ],
        "dialogs": {
          "708222701": {
            "id": "708222701",
            "speakerId": 2099,
            "speakerName": "阿宽",
            "text": "唉，到底什么时候才能完全复工啊…"
          }
        }
      }
    },
    {
      "subId": "7082228",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "708222801"
        ],
        "dialogs": {
          "708222801": {
            "id": "708222801",
            "speakerId": 20307,
            "speakerName": "竺子",
            "text": "希望有人愿意给我一份工作…"
          }
        }
      }
    }
  ]
}
    {
      "subId": "2230705",
      "subQuestName": "与博来对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223070601"
        ],
        "dialogs": {
          "223070601": {
            "id": "223070601",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "您回来了，宝藏找着了吗？",
            "nextDialogs": [
              "223070602"
            ]
          },
          "223070602": {
            "id": "223070602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "223070603"
            ]
          },
          "223070603": {
            "id": "223070603",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "不愧是实打实的冒险家，手脚这个麻利。",
            "nextDialogs": [
              "223070604"
            ]
          },
          "223070604": {
            "id": "223070604",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "那行，我看看啊，这个盒子…哼，没啥用的东西…",
            "nextDialogs": [
              "223070605"
            ]
          },
          "223070605": {
            "id": "223070605",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "不过还是辛苦你了，这份是您的，张顺的那份我留着，等他过来拿。",
            "nextDialogs": [
              "223070606"
            ]
          },
          "223070606": {
            "id": "223070606",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "唉，还是没找着，那群家伙别是把我给蒙了吧…"
          }
        }
      }
    },
    {
      "subId": "2230705",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223070501"
        ],
        "dialogs": {
          "223070501": {
            "id": "223070501",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "要是没受伤…肯定能和大姐头一起，找到更多宝藏吧…",
            "nextDialogs": [
              "223070502"
            ]
          },
          "223070502": {
            "id": "223070502",
            "speakerId": 2033,
            "speakerName": "张顺",
            "text": "唉，真想再去船上看看…"
          }
        }
      }
    },
    {
      "subId": "2230707",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223070701"
        ],
        "dialogs": {
          "223070701": {
            "id": "223070701",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "您真不需要？就是一点小小的消息…"
          }
        }
      }
    },
    {
      "subId": "2230709",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "223070901"
        ],
        "dialogs": {
          "223070901": {
            "id": "223070901",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "您回来了，宝藏找着了吗？",
            "nextDialogs": [
              "223070902"
            ]
          },
          "223070902": {
            "id": "223070902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "找到了。",
            "nextDialogs": [
              "223070903"
            ]
          },
          "223070903": {
            "id": "223070903",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "不愧是实打实的冒险家，手脚这个麻利。",
            "nextDialogs": [
              "223070904"
            ]
          },
          "223070904": {
            "id": "223070904",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "那行，我看看啊，这个盒子…这是什么，地图的残片？",
            "nextDialogs": [
              "223070905"
            ]
          },
          "223070905": {
            "id": "223070905",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "那群家伙说的居然是真的，在那些破烂藏宝图里面，藏着真宝藏的线索…",
            "nextDialogs": [
              "223070906"
            ]
          },
          "223070906": {
            "id": "223070906",
            "speakerId": 2013,
            "speakerName": "博来",
            "text": "咦？您怎么还在这，这份是您的，您…您赶紧忙您的去吧，张顺那一份我留着等他来拿。"
          }
        }
      }
    }
  ]
}
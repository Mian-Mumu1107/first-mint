{
  "lineCounts": {
    "Black Screen": 1,
    "Player": 4,
    "「大桔骑士」": 5,
    "派蒙": 14,
    "瓦乐瑞娜": 12,
    "罗莎莉亚": 10,
    "阿贝多": 21
  },
  "subQuests": [
    {
      "subId": "7054101",
      "subQuestName": "前往「猫茸茸城堡」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "705410101"
        ],
        "dialogs": {
          "705410101": {
            "id": "705410101",
            "speakerId": 1000,
            "speakerName": "「大桔骑士」",
            "text": "喵嗷~",
            "nextDialogs": [
              "705410102"
            ]
          },
          "705410102": {
            "id": "705410102",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，「大桔骑士」也变得乖巧听话啦！",
            "nextDialogs": [
              "705410103"
            ]
          },
          "705410103": {
            "id": "705410103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "以后，你千万要做一个温柔的好孩子，快快乐乐地和大家一起生活哦！",
            "nextDialogs": [
              "705410104"
            ]
          },
          "705410104": {
            "id": "705410104",
            "speakerId": 1002,
            "speakerName": "瓦乐瑞娜",
            "text": "我，我也想挠挠它的头，捏捏它的耳朵！",
            "nextDialogs": [
              "705410105"
            ]
          },
          "705410105": {
            "id": "705410105",
            "speakerId": 1003,
            "speakerName": "罗莎莉亚",
            "text": "不闹腾的时候，明明是个非常讨人喜欢的家伙…那它眼睛上的伤是怎么回事？",
            "nextDialogs": [
              "705410106"
            ]
          },
          "705410106": {
            "id": "705410106",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "根据复原制剂的残留痕迹，「大桔骑士」应该就在这里。",
            "nextDialogs": [
              "705410107"
            ]
          },
          "705410107": {
            "id": "705410107",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "#唔，{NICKNAME}和派蒙…教会的罗莎莉亚修女，还有一位冒险家？",
            "nextDialogs": [
              "705410108"
            ]
          },
          "705410108": {
            "id": "705410108",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "看样子，「大桔骑士」已经和你们交上朋友了。",
            "nextDialogs": [
              "705410109"
            ]
          },
          "705410109": {
            "id": "705410109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "阿阿阿阿阿贝多？好久不见了！见到你很开心，不过…你确定没走错吧？",
            "nextDialogs": [
              "705410110"
            ]
          },
          "705410110": {
            "id": "705410110",
            "speakerId": 1003,
            "speakerName": "罗莎莉亚",
            "text": "调查小队的队长突然造访一间流浪动物收养所，是有什么重要的事吗？",
            "nextDialogs": [
              "705410111"
            ]
          },
          "705410111": {
            "id": "705410111",
            "speakerId": 1002,
            "speakerName": "瓦乐瑞娜",
            "text": "你说队长？他是骑士团的队长？重要的长官没有任何预兆地来了…我都没有准备招待客人的茶和点心！",
            "nextDialogs": [
              "705410112"
            ]
          },
          "705410112": {
            "id": "705410112",
            "speakerId": 1002,
            "speakerName": "瓦乐瑞娜",
            "text": "不对，请听我解释，我们「猫茸茸城堡」是拿到了经营许可的正式营业场所！",
            "nextDialogs": [
              "705410113"
            ]
          },
          "705410113": {
            "id": "705410113",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "瓦乐瑞娜误以为自己的收养所会被查处，慌慌张张地找来骑士团开具的文件，向阿贝多解释了一番「猫茸茸城堡」的用途…\\n其实她只是被调查小队的前缀给震慑了，调查小队并不负责城市管理方面的事务…",
            "nextDialogs": [
              "705410114"
            ]
          },
          "705410114": {
            "id": "705410114",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "请别紧张，我只是顺路帮部下解决麻烦而已，那只猫就是我此行的目的——",
            "nextDialogs": [
              "705410115"
            ]
          },
          "705410115": {
            "id": "705410115",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "不久前，「临时队猫·三号治疗病例·大桔骑士」打晕了照顾它的武器官，逃窜至城门附近，失去了影踪。",
            "nextDialogs": [
              "705410116"
            ]
          },
          "705410116": {
            "id": "705410116",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "「属于调查小队，戴着骑士团徽记的大猫在城里作乱」，多少会造成不妙的影响，还是尽早制止为妙。",
            "nextDialogs": [
              "705410117"
            ]
          },
          "705410117": {
            "id": "705410117",
            "speakerId": 1000,
            "speakerName": "「大桔骑士」",
            "text": "呜…",
            "nextDialogs": [
              "705410120"
            ]
          },
          "705410120": {
            "id": "705410120",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「大桔骑士」居然能打晕调查小队的骑士？名字前面还有好长的一串称号…好像还有什么隐情？",
            "nextDialogs": [
              "705410121"
            ]
          },
          "705410121": {
            "id": "705410121",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "说来确实很巧。两个月前，它在野外迷路，误食了骗骗花蜜，结果由于某些暂不明确的反应，体型膨胀成了原本的三倍大。",
            "nextDialogs": [
              "705410122"
            ]
          },
          "705410122": {
            "id": "705410122",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "三倍！一般的猫猫凶起来就很难安抚了…三倍大的话，岂不是连丘丘人都不怕了！",
            "nextDialogs": [
              "705410123"
            ]
          },
          "705410123": {
            "id": "705410123",
            "speakerId": 1003,
            "speakerName": "罗莎莉亚",
            "text": "这样啊，难怪它那么紧张。",
            "nextDialogs": [
              "705410124"
            ]
          },
          "705410124": {
            "id": "705410124",
            "speakerId": 1003,
            "speakerName": "罗莎莉亚",
            "text": "对于猫…以至于生活在野外的所有生物而言，体型太大并不会带来多少益处，反而会让自己更醒目，动作变得更迟缓…",
            "nextDialogs": [
              "705410125"
            ]
          },
          "705410125": {
            "id": "705410125",
            "speakerId": 1003,
            "speakerName": "罗莎莉亚",
            "text": "最后只会让它们生活在极易暴露的危险处境中，频繁遭到其他掠食者的攻击，受到过度惊吓…",
            "nextDialogs": [
              "705410126"
            ]
          },
          "705410126": {
            "id": "705410126",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "是的，它出现在调查小队的驻地附近时，显然吃了不少苦，全身伤痕累累，异常惊恐。",
            "nextDialogs": [
              "705410127"
            ]
          },
          "705410127": {
            "id": "705410127",
            "speakerId": 1002,
            "speakerName": "瓦乐瑞娜",
            "text": "好，好可怜…这样一想，被它打了，我也不觉得难过了…换成我，我也会害怕陌生的人和动物…",
            "nextDialogs": [
              "705410128"
            ]
          },
          "705410128": {
            "id": "705410128",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "不用担心，问题已经解决了。之前我开发了一种消除炼金药剂影响的复原制剂，就用这种制剂让它的体型恢复正常。",
            "nextDialogs": [
              "705410129"
            ]
          },
          "705410129": {
            "id": "705410129",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "虽然体型依然大于普通的猫，但至少不会影响它的生活了，骑士们也能轮流照顾它。",
            "nextDialogs": [
              "705410130"
            ]
          },
          "705410130": {
            "id": "705410130",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "可莉根据它的颜色，给它起了「大桔骑士」这个名字，大家都觉得很合适，还给它定制了这条围巾。",
            "nextDialogs": [
              "705410131"
            ]
          },
          "705410131": {
            "id": "705410131",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，明明没有和可莉商量过，却起了完全一样的名字，看来我俩的想法超级合拍！",
            "nextDialogs": [
              "705410132"
            ]
          },
          "705410132": {
            "id": "705410132",
            "speakerId": 1000,
            "speakerName": "「大桔骑士」",
            "text": "喵呜~",
            "nextDialogs": [
              "705410133"
            ]
          },
          "705410133": {
            "id": "705410133",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "或许是因为后遗症，它面对每个人都紧张兮兮，过度戒备，小队的武器官和信号官总是被它欺负，可莉又不会经常到驻地来玩。",
            "nextDialogs": [
              "705410134"
            ]
          },
          "705410134": {
            "id": "705410134",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "#现在看来，「大桔骑士」似乎很喜欢{NICKNAME}和派蒙。队里的大家应该也想不到，「大桔骑士」会这么亲近人。",
            "nextDialogs": [
              "705410135"
            ]
          },
          "705410135": {
            "id": "705410135",
            "speakerId": 1002,
            "speakerName": "瓦乐瑞娜",
            "text": "毕竟是伟大的猫猫救星，荣誉骑士和白猫魔法师！",
            "nextDialogs": [
              "705410136"
            ]
          },
          "705410136": {
            "id": "705410136",
            "speakerId": 1002,
            "speakerName": "瓦乐瑞娜",
            "text": "#不管是多凶多吓人的猫，和{M#他们}{F#她们}一起玩了以后，都会变得乖巧可爱！",
            "nextDialogs": [
              "705410137"
            ]
          },
          "705410137": {
            "id": "705410137",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "#既然如此，{NICKNAME}和派蒙愿意收养「大桔骑士」吗？",
            "nextDialogs": [
              "705410138"
            ]
          },
          "705410138": {
            "id": "705410138",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？这样没关系吗？「大桔骑士」不是你们的队猫吗？",
            "nextDialogs": [
              "705410139"
            ]
          },
          "705410139": {
            "id": "705410139",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "临时队猫的头衔也是出于无奈，我们本来打算在「大桔骑士」的状况稳定后，寻找一位好心人，正式收养它。",
            "nextDialogs": [
              "705410140"
            ]
          },
          "705410140": {
            "id": "705410140",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "调查小队毕竟是骑士团的作战单位，一直待在我们身边，生活条件并不理想。",
            "nextDialogs": [
              "705410141"
            ]
          },
          "705410141": {
            "id": "705410141",
            "speakerId": 1004,
            "speakerName": "阿贝多",
            "text": "熟悉它的骑士们终归是要出勤的，把「大桔骑士」留在营地里，就会让它不知所措，带着它行动的话，又会让它再次受到惊吓。",
            "nextDialogs": [
              "705410142"
            ]
          },
          "705410142": {
            "id": "705410142",
            "speakerId": 1003,
            "speakerName": "罗莎莉亚",
            "text": "明智的做法。",
            "nextDialogs": [
              "705410143"
            ]
          },
          "705410143": {
            "id": "705410143",
            "speakerId": 1003,
            "speakerName": "罗莎莉亚",
            "text": "对于受到过惊吓的动物，尽量让它远离一切刺激，才能使它慢慢走出阴影，彻底变得平和…",
            "nextDialogs": [
              "705410144"
            ]
          },
          "705410144": {
            "id": "705410144",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这么说来，我们确实可以在尘歌壶里搭一个暖暖的猫窝，让「大桔骑士」安安心心快快乐乐地生活，再也不用担心被魔物欺负。",
            "nextDialogs": [
              "705410145"
            ]
          },
          "705410145": {
            "id": "705410145",
            "speakerId": 1000,
            "speakerName": "「大桔骑士」",
            "text": "喵嗷！"
          }
        }
      }
    }
  ]
}
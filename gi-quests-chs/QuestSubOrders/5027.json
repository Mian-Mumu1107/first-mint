  "subQuests": [
    {
      "subId": "502701",
      "subQuestName": "(test)子任务描述Test$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50270101"
        ],
        "dialogs": {
          "50270101": {
            "id": "50270101",
            "speakerId": 1000,
            "speakerName": "玛拉妮",
            "text": "火神大人真厉害！而且很有勇气，敢和希巴拉克大人过招。",
            "nextDialogs": [
              "50270102"
            ]
          },
          "50270102": {
            "id": "50270102",
            "speakerId": 1001,
            "speakerName": "基尼奇",
            "text": "别谦虚了，换做是你你也敢。",
            "nextDialogs": [
              "50270103"
            ]
          },
          "50270103": {
            "id": "50270103",
            "speakerId": 1002,
            "speakerName": "阿乔",
            "text": "哈，谁不敢？我敢！你呢？",
            "nextDialogs": [
              "50270104"
            ]
          },
          "50270104": {
            "id": "50270104",
            "speakerId": 1003,
            "speakerName": "卡齐娜",
            "text": "我…我不敢！",
            "nextDialogs": [
              "50270105"
            ]
          },
          "50270105": {
            "id": "50270105",
            "speakerId": 1001,
            "speakerName": "基尼奇",
            "text": "战斗是战士的天性，有什么敢不敢的。真到了那个时刻，自然会想要一决高下。",
            "nextDialogs": [
              "50270106"
            ]
          },
          "50270106": {
            "id": "50270106",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "唉，真有精力呀你们…那可是希巴拉克大人哦？超级祖先哦？这么喜欢跟老一辈过招吗？",
            "nextDialogs": [
              "50270107"
            ]
          },
          "50270107": {
            "id": "50270107",
            "speakerId": 1000,
            "speakerName": "玛拉妮",
            "text": "茜特菈莉奶奶！有机会我们也再比试比试吧！",
            "nextDialogs": [
              "50270108"
            ]
          },
          "50270108": {
            "id": "50270108",
            "speakerId": 1004,
            "speakerName": "茜特菈莉",
            "text": "不要不要，绝对不要。"
          }
        }
      }
    },
    {
      "subId": "502702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "50270201"
        ],
        "dialogs": {
          "50270201": {
            "id": "50270201",
            "speakerId": 1005,
            "speakerName": "马索",
            "text": "你说，我会变成什么蔬菜呢？红色的，还是绿色的？",
            "nextDialogs": [
              "50270202"
            ]
          },
          "50270202": {
            "id": "50270202",
            "speakerId": 1006,
            "speakerName": "欧洛伦",
            "text": "你的话，可能会变成洋葱吧。",
            "nextDialogs": [
              "50270203"
            ]
          },
          "50270203": {
            "id": "50270203",
            "speakerId": 1005,
            "speakerName": "马索",
            "text": "洋葱？",
            "nextDialogs": [
              "50270204"
            ]
          },
          "50270204": {
            "id": "50270204",
            "speakerId": 1006,
            "speakerName": "欧洛伦",
            "text": "其貌不扬，却能让试图对你动手的人痛哭流涕。",
            "nextDialogs": [
              "50270205"
            ]
          },
          "50270205": {
            "id": "50270205",
            "speakerId": 1005,
            "speakerName": "马索",
            "text": "真的？听起来好强大…",
            "nextDialogs": [
              "50270206"
            ]
          },
          "50270206": {
            "id": "50270206",
            "speakerId": 1007,
            "speakerName": "伊安珊",
            "text": "这两个人在说什么啊…",
            "nextDialogs": [
              "50270207"
            ]
          },
          "50270207": {
            "id": "50270207",
            "speakerId": 1006,
            "speakerName": "欧洛伦",
            "text": "洋葱很厉害。上次去朋友家碰巧他在削洋葱，削得不停流眼泪，他也流，龙也流，最后屋里的生物几乎都哭了。",
            "nextDialogs": [
              "50270208"
            ]
          },
          "50270208": {
            "id": "50270208",
            "speakerId": 1007,
            "speakerName": "伊安珊",
            "text": "你呢？你在哪？",
            "nextDialogs": [
              "50270209"
            ]
          },
          "50270209": {
            "id": "50270209",
            "speakerId": 1006,
            "speakerName": "欧洛伦",
            "text": "我也在屋子里，不过及时用披风遮住了眼睛。咔库库和伊法他们看不见我，就以为我也哭了。",
            "nextDialogs": [
              "50270210"
            ]
          },
          "50270210": {
            "id": "50270210",
            "speakerId": 1005,
            "speakerName": "马索",
            "text": "我想成为洋葱一样让人哭泣的男人！",
            "nextDialogs": [
              "50270211"
            ]
          },
          "50270211": {
            "id": "50270211",
            "speakerId": 1006,
            "speakerName": "欧洛伦",
            "text": "嗯，没问题的。",
            "nextDialogs": [
              "50270212"
            ]
          },
          "50270212": {
            "id": "50270212",
            "speakerId": 1007,
            "speakerName": "伊安珊",
            "text": "好想打断你们，又不知道说什么才能阻止这种对话发展下去。",
            "nextDialogs": [
              "50270213"
            ]
          },
          "50270213": {
            "id": "50270213",
            "speakerId": 1006,
            "speakerName": "欧洛伦",
            "text": "伊安珊是，小小的…蘑菇。嗯。",
            "nextDialogs": [
              "50270214"
            ]
          },
          "50270214": {
            "id": "50270214",
            "speakerId": 1007,
            "speakerName": "伊安珊",
            "text": "没人问啊！",
            "nextDialogs": [
              "50270215"
            ]
          },
          "50270215": {
            "id": "50270215",
            "speakerId": 1007,
            "speakerName": "伊安珊",
            "text": "不过蘑菇吗？还不错呢，很有生命力，我喜欢。",
            "nextDialogs": [
              "50270216"
            ]
          },
          "50270216": {
            "id": "50270216",
            "speakerId": 1005,
            "speakerName": "马索",
            "text": "那伊安珊姐姐是很有生命力的女人！",
            "nextDialogs": [
              "50270217"
            ]
          },
          "50270217": {
            "id": "50270217",
            "speakerId": 1006,
            "speakerName": "欧洛伦",
            "text": "嗯。",
            "nextDialogs": [
              "50270218"
            ]
          },
          "50270218": {
            "id": "50270218",
            "speakerId": 1007,
            "speakerName": "伊安珊",
            "text": "嗯嗯。"
          }
        }
      }
    }
  ]
}
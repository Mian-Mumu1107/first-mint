{
  "lineCounts": {
    "Player": 10,
    "派蒙": 10,
    "稻城萤美": 33
  },
  "subQuests": [
    {
      "subId": "7218201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721070301"
        ],
        "dialogs": {
          "721070301": {
            "id": "721070301",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "你好，远道而来的旅者，欢迎来到「鸣神大社」。",
            "nextDialogs": [
              "721070302"
            ]
          },
          "721070302": {
            "id": "721070302",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "如果有烦恼或者心愿，可以找玄冬小姐求签，雷神会保佑你的。",
            "nextDialogs": [
              "721070303"
            ]
          },
          "721070303": {
            "id": "721070303",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "原来如此，情况我已大致了解了。",
            "nextDialogs": [
              "721070304"
            ]
          },
          "721070304": {
            "id": "721070304",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "「神樱大祓」之事，是很重要的仪式。确实有相关的记载…",
            "nextDialogs": [
              "721070305"
            ]
          },
          "721070305": {
            "id": "721070305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不过？",
            "nextDialogs": [
              "721070306"
            ]
          },
          "721070306": {
            "id": "721070306",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "不过，如今具体的行事方法已经失传了。你手中的《要略》，是很宝贵的史料呢。",
            "nextDialogs": [
              "721070307"
            ]
          },
          "721070307": {
            "id": "721070307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "失传了？",
            "nextDialogs": [
              "721070308"
            ]
          },
          "721070308": {
            "id": "721070308",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道是愚人众干的？既然稻城小姐说是重要的事情，就很难不觉得他们在背后搞鬼…",
            "nextDialogs": [
              "721070309"
            ]
          },
          "721070309": {
            "id": "721070309",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "啊，不是的。是因为保存不当。受潮、虫蛀等。",
            "nextDialogs": [
              "721070310"
            ]
          },
          "721070310": {
            "id": "721070310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "……",
            "nextDialogs": [
              "721070311"
            ]
          },
          "721070311": {
            "id": "721070311",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "哎呀，真是相当遗憾。有很多史料都丢失了呢。之前八重大人和神里大人也为此很苦恼。",
            "nextDialogs": [
              "721070312"
            ]
          },
          "721070312": {
            "id": "721070312",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "至于「言灵」之事，我也并非一无所知。",
            "nextDialogs": [
              "721070313"
            ]
          },
          "721070313": {
            "id": "721070313",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯，那就请把破解的方法告诉我们吧！",
            "nextDialogs": [
              "721070314"
            ]
          },
          "721070314": {
            "id": "721070314",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "很抱歉，将镇物封印的「言灵咒法」并非特定咒语。",
            "nextDialogs": [
              "721070315"
            ]
          },
          "721070315": {
            "id": "721070315",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "…而是施咒者释术时亲自拟定的单语，也即言灵。",
            "nextDialogs": [
              "721070316"
            ]
          },
          "721070316": {
            "id": "721070316",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊？你的意思是说…",
            "nextDialogs": [
              "721070317"
            ]
          },
          "721070317": {
            "id": "721070317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咒语…是那个施咒者随随便便拍脑袋想的？",
            "nextDialogs": [
              "721070318"
            ]
          },
          "721070318": {
            "id": "721070318",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "也并非如此。此类言灵一般都有其规律。",
            "nextDialogs": [
              "721070319"
            ]
          },
          "721070319": {
            "id": "721070319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "能否详细说说。",
            "nextDialogs": [
              "721070320"
            ]
          },
          "721070320": {
            "id": "721070320",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "嗯…我记得书中是这么记载的。",
            "nextDialogs": [
              "721070321"
            ]
          },
          "721070321": {
            "id": "721070321",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "第一句表示自身在稻妻的威名。是什么什么加上「敕使」二字来着…",
            "nextDialogs": [
              "721070322"
            ]
          },
          "721070322": {
            "id": "721070322",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "第二句则是解释自己自身力量的来源。打个比方，就像「团子」、「拉面」、「轻小说」之类的。",
            "nextDialogs": [
              "721070323"
            ]
          },
          "721070323": {
            "id": "721070323",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嗯嗯我懂。确实是很了不起的力量来源呢。",
            "nextDialogs": [
              "721070324"
            ]
          },
          "721070324": {
            "id": "721070324",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "只是打个比方啦。记载里，有类似「阴阳博晓」之类的。",
            "nextDialogs": [
              "721070325"
            ]
          },
          "721070325": {
            "id": "721070325",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "至于这第三句…",
            "nextDialogs": [
              "721070328"
            ]
          },
          "721070328": {
            "id": "721070328",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "嗯…如你所料。第三句的内容可以自由发挥。",
            "nextDialogs": [
              "721070329"
            ]
          },
          "721070329": {
            "id": "721070329",
            "speakerId": 12007,
            "speakerName": "稻城萤美",
            "text": "时隔久远，恐怕这世上已经没有了解第三句话的知情人了。",
            "nextDialogs": [
              "721070330"
            ]
          },
          "721070330": {
            "id": "721070330",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那要怎么办！",
            "nextDialogs": [
              "721070331"
            ]
          },
          "721070331": {
            "id": "721070331",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "面具巫女姐姐的托付…还有这片大地…都要完蛋了！"
          }
        }
      }
    }
  ]
}
    {
      "subId": "1050203",
      "subQuestName": "追上可莉，取回箱子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105020301"
        ],
        "dialogs": {
          "105020301": {
            "id": "105020301",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "我找到了，就是这个箱子。",
            "nextDialogs": [
              "105020302"
            ]
          },
          "105020302": {
            "id": "105020302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没有被炸坏真是太好了。",
            "nextDialogs": [
              "105020303"
            ]
          },
          "105020303": {
            "id": "105020303",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "回收完毕，我们带回去给那个姐姐吧！"
          }
        }
      }
    },
    {
      "subId": "1050204",
      "subQuestName": "与可莉交谈，回收箱子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105020201"
        ],
        "dialogs": {
          "105020201": {
            "id": "105020201",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "到了到了，就是这里，我们来把宝物挖出来吧。",
            "nextDialogs": [
              "105020204"
            ]
          },
          "105020204": {
            "id": "105020204",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "不会的，我专门做了记号，是不会有错的——",
            "nextDialogs": [
              "105020205"
            ]
          },
          "105020205": {
            "id": "105020205",
            "speakerId": 10090,
            "speakerName": "可莉",
            "text": "呜啊，是草史莱姆！",
            "nextDialogs": [
              "105020206"
            ]
          },
          "105020206": {
            "id": "105020206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是草史莱姆。",
            "nextDialogs": [
              "105020207"
            ]
          },
          "105020207": {
            "id": "105020207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃…先解决掉它们再说吧！"
          }
        }
      }
    },
    {
      "subId": "1050205",
      "subQuestName": "击败来袭的草史莱姆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105020501"
        ],
        "dialogs": {
          "105020501": {
            "id": "105020501",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "关于莫娜的来历与困境…",
            "nextDialogs": [
              "105020502"
            ]
          },
          "105020502": {
            "id": "105020502",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "原来是这样，我知道了。",
            "nextDialogs": [
              "105020503"
            ]
          },
          "105020503": {
            "id": "105020503",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "蒙德城里，有一间空着的<color=#00E1FFFF>魔法实验室</color>，但被不知道什么人施加了一个封印。",
            "nextDialogs": [
              "105020504"
            ]
          },
          "105020504": {
            "id": "105020504",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "虽然有几位专家可以解开封印，但他们都有自己的实验室了，对这件事不感兴趣。",
            "nextDialogs": [
              "105020505"
            ]
          },
          "105020505": {
            "id": "105020505",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "我觉得，如果你提到的占星术士能解开那个封印，房子的主人应该就会同意她住下吧。",
            "nextDialogs": [
              "105020508"
            ]
          },
          "105020508": {
            "id": "105020508",
            "speakerId": 12913,
            "speakerName": "凯瑟琳",
            "text": "好的，那我这就告诉你房子的位置。"
          }
        }
      }
    },
    {
      "subId": "1050206",

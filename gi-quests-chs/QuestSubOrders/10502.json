  "subQuests": [
    {
      "subId": "1050201",
      "subQuestName": "抵达蒙德城",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105020101"
        ],
        "dialogs": {
          "105020101": {
            "id": "105020101",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "马上就要见到那位继承者了，你准备好了吗？可别让你的师父丢脸。",
            "nextDialogs": [
              "105020104"
            ]
          },
          "105020104": {
            "id": "105020104",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "也对…不对！就算是假的弟子，也不能一问三不知吧。",
            "nextDialogs": [
              "105020105"
            ]
          },
          "105020105": {
            "id": "105020105",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "虽然师门有规定，不得传授外人，不过…如果是你，也未尝不可。",
            "nextDialogs": [
              "105020106"
            ]
          },
          "105020106": {
            "id": "105020106",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我的占星术是「水占术」，顾名思义，是通过水中的倒影观看真正的星空。",
            "nextDialogs": [
              "105020107"
            ]
          },
          "105020107": {
            "id": "105020107",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "让我先给你示范一下，看仔细了。",
            "nextDialogs": [
              "105020108"
            ]
          },
          "105020108": {
            "id": "105020108",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "就目前的星象和走势来看，嗯，那位继承者是西风骑士，年轻有为…女性…",
            "nextDialogs": [
              "105020109"
            ]
          },
          "105020109": {
            "id": "105020109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "听这个描述…唔…难道是丽莎？",
            "nextDialogs": [
              "105020110"
            ]
          },
          "105020110": {
            "id": "105020110",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我们马上就会在这里遇见她。",
            "nextDialogs": [
              "105020111"
            ]
          },
          "105020111": {
            "id": "105020111",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "好了，有这么多信息应该就足够了。"
          }
        }
      }
    },

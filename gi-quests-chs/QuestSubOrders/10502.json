    {
      "subId": "1050211",
      "subQuestName": "与莫娜交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "105020601"
        ],
        "dialogs": {
          "105020601": {
            "id": "105020601",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "留下这个封印的人…不简单，要暴力破解几乎是不可能的。",
            "nextDialogs": [
              "105020602"
            ]
          },
          "105020602": {
            "id": "105020602",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "有意思，值得我用占星术计算一下了。",
            "nextDialogs": [
              "105020603"
            ]
          },
          "105020603": {
            "id": "105020603",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我看看，嗯…原来如此，只需要这样，然后这样…",
            "nextDialogs": [
              "105020604"
            ]
          },
          "105020604": {
            "id": "105020604",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "好了，打开了。",
            "nextDialogs": [
              "105020605"
            ]
          },
          "105020605": {
            "id": "105020605",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，真厉害！",
            "nextDialogs": [
              "105020606"
            ]
          },
          "105020606": {
            "id": "105020606",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "只要回去和凯瑟琳报告一下，应该就可以住进去了吧。",
            "nextDialogs": [
              "105020607"
            ]
          },
          "105020607": {
            "id": "105020607",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "不必了不必了，太谢谢你们了。",
            "nextDialogs": [
              "105020608"
            ]
          },
          "105020608": {
            "id": "105020608",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "这位是…？",
            "nextDialogs": [
              "105020609"
            ]
          },
          "105020609": {
            "id": "105020609",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "哦，我是这栋房子的主人，歌德。刚刚路过冒险家协会的时候，凯瑟琳告诉了我这件事。",
            "nextDialogs": [
              "105020610"
            ]
          },
          "105020610": {
            "id": "105020610",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "没想到这么快，这个烦人的封印就被解开了！",
            "nextDialogs": [
              "105020611"
            ]
          },
          "105020611": {
            "id": "105020611",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "那就是说，我可以住在这里了？",
            "nextDialogs": [
              "105020612"
            ]
          },
          "105020612": {
            "id": "105020612",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "当然当然，反正里面的设备放着也是放着，能有人发挥它们的价值，我也很开心。",
            "nextDialogs": [
              "105020613"
            ]
          },
          "105020613": {
            "id": "105020613",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "为了表示感谢，我可以用最低最低的价格，把房子租给你！",
            "nextDialogs": [
              "105020614"
            ]
          },
          "105020614": {
            "id": "105020614",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "租、租？！",
            "nextDialogs": [
              "105020615"
            ]
          },
          "105020615": {
            "id": "105020615",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "来之前没听说租的事，而且我还帮了忙…",
            "nextDialogs": [
              "105020616"
            ]
          },
          "105020616": {
            "id": "105020616",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "帮忙？嗯，对，我明白啊。我非常感谢你，所以租金肯定会给你最优惠的价格！",
            "nextDialogs": [
              "105020617"
            ]
          },
          "105020617": {
            "id": "105020617",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "我、我的意思是…",
            "nextDialogs": [
              "105020618"
            ]
          },
          "105020618": {
            "id": "105020618",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来莫娜有些误解，但是…",
            "nextDialogs": [
              "105020621"
            ]
          },
          "105020621": {
            "id": "105020621",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "唉…也没有别的办法了，就租这里吧。",
            "nextDialogs": [
              "105020622"
            ]
          },
          "105020622": {
            "id": "105020622",
            "speakerId": 1606,
            "speakerName": "歌德",
            "text": "好！那就这么说定了，我去准备一下手续，稍等片刻吧。",
            "nextDialogs": [
              "105020623"
            ]
          },
          "105020623": {
            "id": "105020623",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "这次的事，谢谢了。还有就是…很对不起，答应你的事，暂时还做不到。",
            "nextDialogs": [
              "105020624"
            ]
          },
          "105020624": {
            "id": "105020624",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "没有占星需要的设备，也没有新的知识，想要看清你的「命运」，还需要一些时间…",
            "nextDialogs": [
              "105020625"
            ]
          },
          "105020625": {
            "id": "105020625",
            "speakerId": 10095,
            "speakerName": "莫娜",
            "text": "但我答应你，等我准备好了，我一定会第一个为你占卜的！"
          }
        }
      }

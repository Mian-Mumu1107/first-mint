    {
      "subId": "48603",
      "subQuestName": "与查尔斯对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4860301"
        ],
        "dialogs": {
          "4860301": {
            "id": "4860301",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "把我这里当成果汁店了么？小朋友们。",
            "nextDialogs": [
              "4860302"
            ]
          },
          "4860302": {
            "id": "4860302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼，真是失礼，我们明明是来帮忙的。",
            "nextDialogs": [
              "4860303"
            ]
          },
          "4860303": {
            "id": "4860303",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "帮忙？哦对了，你们是代理团长面前的红人吧。",
            "nextDialogs": [
              "4860304"
            ]
          },
          "4860304": {
            "id": "4860304",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…好奇怪的说法。",
            "nextDialogs": [
              "4860305"
            ]
          },
          "4860305": {
            "id": "4860305",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "那麻烦你们帮我向琴要来这个季度的税收报表。",
            "nextDialogs": [
              "4860306"
            ]
          },
          "4860306": {
            "id": "4860306",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "毕竟又到了找埃泽先生汇总账目的时候了…不得不说，蒙德酒水的税费还真是高。",
            "nextDialogs": [
              "4860307"
            ]
          },
          "4860307": {
            "id": "4860307",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这种事也要直接找琴吗？",
            "nextDialogs": [
              "4860308"
            ]
          },
          "4860308": {
            "id": "4860308",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可晨曦酒庄依然那么有钱。",
            "nextDialogs": [
              "4860309"
            ]
          },
          "4860309": {
            "id": "4860309",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "那主要还是归功于迪卢克老爷经营有方。",
            "nextDialogs": [
              "4860310"
            ]
          },
          "4860310": {
            "id": "4860310",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "为什么报表在琴那里，记账也是琴的工作吗？",
            "nextDialogs": [
              "4860311"
            ]
          },
          "4860311": {
            "id": "4860311",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "嗯，每一条账目都是代理团长亲自过目的。",
            "nextDialogs": [
              "4860312"
            ]
          },
          "4860312": {
            "id": "4860312",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "毕竟酒业是蒙德的主要收入来源，琴从来不会在这件事上含糊。",
            "nextDialogs": [
              "4860313"
            ]
          },
          "4860313": {
            "id": "4860313",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这样啊…琴的工作好像比预想的还要辛苦呢。",
            "nextDialogs": [
              "4860314"
            ]
          },
          "4860314": {
            "id": "4860314",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "可这位代理团长的努力，确实让我们轻松了很多。",
            "nextDialogs": [
              "4860315"
            ]
          },
          "4860315": {
            "id": "4860315",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "不过，怎么说呢，如今的大家都对这份幸运习以为常了吧。",
            "nextDialogs": [
              "4860316"
            ]
          },
          "4860316": {
            "id": "4860316",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呜哇，你们就这样心安理得地依靠琴了吗？",
            "nextDialogs": [
              "4860317"
            ]
          },
          "4860317": {
            "id": "4860317",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "这样说的话，确实有点惭愧…不如下次她来的时候，请她喝一杯。",
            "nextDialogs": [
              "4860318"
            ]
          },
          "4860318": {
            "id": "4860318",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "虽然我觉得…代理团长可能没有那样的空闲时间吧。",
            "nextDialogs": [
              "4860319"
            ]
          },
          "4860319": {
            "id": "4860319",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我怎么感觉你在找借口…",
            "nextDialogs": [
              "4860320"
            ]
          },
          "4860320": {
            "id": "4860320",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#那{NICKNAME}，我们<color=#00E1FFFF>快点去见琴吧</color>。"
          }
        }
      }
    },
    {
      "subId": "48604",
      "subQuestName": "向琴传达居民的委托",

    {
      "subId": "48605",
      "subQuestName": "(test)完成对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4860501"
        ],
        "dialogs": {
          "4860501": {
            "id": "4860501",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "等一下，两位。",
            "nextDialogs": [
              "4860502"
            ]
          },
          "4860502": {
            "id": "4860502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "玛格丽特小姐，你怎么在这里？",
            "nextDialogs": [
              "4860503"
            ]
          },
          "4860503": {
            "id": "4860503",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "我的猫又走丢了呢，你们有见到它吗？",
            "nextDialogs": [
              "4860504"
            ]
          },
          "4860504": {
            "id": "4860504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没见到过。",
            "nextDialogs": [
              "4860505"
            ]
          },
          "4860505": {
            "id": "4860505",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你是说…迪奥娜？",
            "nextDialogs": [
              "4860506"
            ]
          },
          "4860506": {
            "id": "4860506",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "不是那一只哦，迪奥娜还在酒馆里吧。",
            "nextDialogs": [
              "4860507"
            ]
          },
          "4860507": {
            "id": "4860507",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "我说的是「小王子」，刚刚还在家里的那只。",
            "nextDialogs": [
              "4860508"
            ]
          },
          "4860508": {
            "id": "4860508",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真的把迪奥娜和家猫划上等号了吗！",
            "nextDialogs": [
              "4860509"
            ]
          },
          "4860509": {
            "id": "4860509",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "这就有些苦恼了，万一它找不到回家的路…",
            "nextDialogs": [
              "4860510"
            ]
          },
          "4860510": {
            "id": "4860510",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "虽然很想帮忙…",
            "nextDialogs": [
              "4860511"
            ]
          },
          "4860511": {
            "id": "4860511",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但我们还有很急的事要去通知琴呢，真是不好意思。",
            "nextDialogs": [
              "4860512"
            ]
          },
          "4860512": {
            "id": "4860512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们试着找找看？",
            "nextDialogs": [
              "4860513"
            ]
          },
          "4860513": {
            "id": "4860513",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#唔，{NICKNAME}还是一如既往地热心呐，可我们现在还有别的事要做吧？",
            "nextDialogs": [
              "4860514"
            ]
          },
          "4860514": {
            "id": "4860514",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "莎拉小姐和查尔斯先生也很着急，还是先去琴那里吧。",
            "nextDialogs": [
              "4860515"
            ]
          },
          "4860515": {
            "id": "4860515",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "欸，原来你们也要去找琴呀，这么巧。",
            "nextDialogs": [
              "4860516"
            ]
          },
          "4860516": {
            "id": "4860516",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "玛格丽特小姐不是来找猫的吗？",
            "nextDialogs": [
              "4860517"
            ]
          },
          "4860517": {
            "id": "4860517",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "是啊，我是来拜托琴帮忙找猫的呀。",
            "nextDialogs": [
              "4860518"
            ]
          },
          "4860518": {
            "id": "4860518",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "什么？！找猫这样的小事都要拜托她吗？！",
            "nextDialogs": [
              "4860519"
            ]
          },
          "4860519": {
            "id": "4860519",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "咦？这样做原来很不合适吗。",
            "nextDialogs": [
              "4860520"
            ]
          },
          "4860520": {
            "id": "4860520",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "可是，琴很亲切呀。",
            "nextDialogs": [
              "4860521"
            ]
          },
          "4860521": {
            "id": "4860521",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这样的理由…",
            "nextDialogs": [
              "4860522"
            ]
          },
          "4860522": {
            "id": "4860522",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么有种「人善被人欺」的感觉？",
            "nextDialogs": [
              "4860523"
            ]
          },
          "4860523": {
            "id": "4860523",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "那就拜托跟琴说一声咯，回头我请你在「猫尾」喝一杯。",
            "nextDialogs": [
              "4860524"
            ]
          },
          "4860524": {
            "id": "4860524",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，喂…",
            "nextDialogs": [
              "4860525"
            ]
          },
          "4860525": {
            "id": "4860525",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "真没办法，那叫做「小王子」的猫猫的事，一会儿也一起告诉琴吧。"
          }
        }
      }
    },
    {
      "subId": "48606",

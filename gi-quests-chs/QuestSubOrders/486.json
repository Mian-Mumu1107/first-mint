    {
      "subId": "48607",
      "subQuestName": "(test)与琴对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4860701"
        ],
        "dialogs": {
          "4860701": {
            "id": "4860701",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "咳咳…",
            "nextDialogs": [
              "4860702"
            ]
          },
          "4860702": {
            "id": "4860702",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "代理团长——",
            "nextDialogs": [
              "4860703"
            ]
          },
          "4860703": {
            "id": "4860703",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "……",
            "nextDialogs": [
              "4860704"
            ]
          },
          "4860704": {
            "id": "4860704",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "呃，团长大人？",
            "nextDialogs": [
              "4860705"
            ]
          },
          "4860705": {
            "id": "4860705",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "……",
            "nextDialogs": [
              "4860706"
            ]
          },
          "4860706": {
            "id": "4860706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "团长？",
            "nextDialogs": [
              "4860707"
            ]
          },
          "4860707": {
            "id": "4860707",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "琴小姐？",
            "nextDialogs": [
              "4860708"
            ]
          },
          "4860708": {
            "id": "4860708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「蒲公英骑士」小姐？",
            "nextDialogs": [
              "4860709"
            ]
          },
          "4860709": {
            "id": "4860709",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "啊！…哦，是「荣誉骑士」啊。不好意思，我刚才有些恍神。",
            "nextDialogs": [
              "4860710"
            ]
          },
          "4860710": {
            "id": "4860710",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "二位有遇上什么麻烦吗？",
            "nextDialogs": [
              "4860711"
            ]
          },
          "4860711": {
            "id": "4860711",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "确实有一些麻烦事，不过我们是来替别人向你转达的…",
            "nextDialogs": [
              "4860712"
            ]
          },
          "4860712": {
            "id": "4860712",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "原来如此，辛苦你们为蒙德民众做出的贡献，咳咳…",
            "nextDialogs": [
              "4860713"
            ]
          },
          "4860713": {
            "id": "4860713",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "委托我已经记录在案了，马上…就去安排…",
            "nextDialogs": [
              "4860714"
            ]
          },
          "4860714": {
            "id": "4860714",
            "speakerId": 1003,
            "speakerName": "琴",
            "text": "……处理。",
            "nextDialogs": [
              "4860715"
            ]
          },
          "4860715": {
            "id": "4860715",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯嗯！",
            "nextDialogs": [
              "4860716"
            ]
          },
          "4860716": {
            "id": "4860716",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我们好像没漏掉谁的委托吧…？",
            "nextDialogs": [
              "4860717"
            ]
          },
          "4860717": {
            "id": "4860717",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "莎拉小姐…查尔斯…玛格丽特…嗯，应该没错。",
            "nextDialogs": [
              "4860718"
            ]
          },
          "4860718": {
            "id": "4860718",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "那我们就先走啦，琴…琴小姐？",
            "nextDialogs": [
              "4860719"
            ]
          },
          "4860719": {
            "id": "4860719",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "喂…琴小姐你怎么了…"
          }
        }
      }
    },
    {
      "subId": "48608",
      "subQuestName": "向芭芭拉询问琴的情况",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4860801"
        ],
        "dialogs": {
          "4860801": {
            "id": "4860801",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "琴怎么样了？没有大碍吧？",
            "nextDialogs": [
              "4860802"
            ]
          },
          "4860802": {
            "id": "4860802",
            "speakerId": 1004,
            "speakerName": "芭芭拉",
            "text": "呼…只是工作辛苦造成的身体虚弱，多休息下应该就没事了。",
            "nextDialogs": [
              "4860803"
            ]
          },
          "4860803": {
            "id": "4860803",
            "speakerId": 1004,
            "speakerName": "芭芭拉",
            "text": "谢谢你们带她过来，不然她可能还会继续硬撑呢…",
            "nextDialogs": [
              "4860804"
            ]
          },
          "4860804": {
            "id": "4860804",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "也难怪，琴每天都有那么多事情要处理…",
            "nextDialogs": [
              "4860805"
            ]
          },
          "4860805": {
            "id": "4860805",
            "speakerId": 1004,
            "speakerName": "芭芭拉",
            "text": "真是的…琴从很久以前就那么喜欢勉强自己，而自己的事又总是很不在意。",
            "nextDialogs": [
              "4860806"
            ]
          },
          "4860806": {
            "id": "4860806",
            "speakerId": 1004,
            "speakerName": "芭芭拉",
            "text": "这种情况也不是第一次了…",
            "nextDialogs": [
              "4860807"
            ]
          },
          "4860807": {
            "id": "4860807",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "琴真是辛苦。",
            "nextDialogs": [
              "4860808"
            ]
          },
          "4860808": {
            "id": "4860808",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "芭芭拉好像很关心琴的样子。",
            "nextDialogs": [
              "4860809"
            ]
          },
          "4860809": {
            "id": "4860809",
            "speakerId": 1004,
            "speakerName": "芭芭拉",
            "text": "啊…啊，有吗？毕、毕竟是代理团长嘛，随便就倒下的话会造成很大麻烦吧！",
            "nextDialogs": [
              "4860810"
            ]
          },
          "4860810": {
            "id": "4860810",
            "speakerId": 1004,
            "speakerName": "芭芭拉",
            "text": "所以、所以不是我个人的感情哦！是为了大家着想！嗯，没错！",
            "nextDialogs": [
              "4860811"
            ]
          },
          "4860811": {
            "id": "4860811",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "芭芭拉小姐的反应，有点奇怪…嗯…",
            "nextDialogs": [
              "4860812"
            ]
          },
          "4860812": {
            "id": "4860812",
            "speakerId": 1004,
            "speakerName": "芭芭拉",
            "text": "#对了，{NICKNAME}，你是「荣誉骑士」吧？",
            "nextDialogs": [
              "4860813"
            ]
          },
          "4860813": {
            "id": "4860813",
            "speakerId": 1004,
            "speakerName": "芭芭拉",
            "text": "团长倒下了，在情理上也应该为她分忧…是这样吗？",
            "nextDialogs": [
              "4860814"
            ]
          },
          "4860814": {
            "id": "4860814",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这么说也没错，但不是还有正牌的「西风骑士」吗…",
            "nextDialogs": [
              "4860815"
            ]
          },
          "4860815": {
            "id": "4860815",
            "speakerId": 1004,
            "speakerName": "芭芭拉",
            "text": "琴的工作那么多，多一份人手总归是好事啦。",
            "nextDialogs": [
              "4860816"
            ]
          },
          "4860816": {
            "id": "4860816",
            "speakerId": 1004,
            "speakerName": "芭芭拉",
            "text": "拜托你们<color=#00E1FFFF>回骑士团看看吧</color>，琴这边有我在就好，我自己一个人就可以啦。",
            "nextDialogs": [
              "4860817"
            ]
          },
          "4860817": {
            "id": "4860817",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "怎么有点着急赶人走的样子…",
            "nextDialogs": [
              "4860818"
            ]
          },
          "4860818": {
            "id": "4860818",
            "speakerId": 1004,
            "speakerName": "芭芭拉",
            "text": "嗯？",
            "nextDialogs": [
              "4860819"
            ]
          },
          "4860819": {
            "id": "4860819",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#没事啦，那就不打扰你们了。走吧，{NICKNAME}。"
          }
        }
      }
    },
    {
      "subId": "48609",
      "subQuestName": "回到骑士团",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "48610",
      "subQuestName": "(test)与凯亚对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4861001"
        ],
        "dialogs": {
          "4861001": {
            "id": "4861001",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦，是凯亚。",
            "nextDialogs": [
              "4861002"
            ]
          },
          "4861002": {
            "id": "4861002",
            "speakerId": 1005,
            "speakerName": "凯亚",
            "text": "哦，我正在等你们。",
            "nextDialogs": [
              "4861003"
            ]
          },
          "4861003": {
            "id": "4861003",
            "speakerId": 1005,
            "speakerName": "凯亚",
            "text": "琴病倒的事我已经听说了，我应该代表骑士团的大家向你们表示感谢。",
            "nextDialogs": [
              "4861004"
            ]
          },
          "4861004": {
            "id": "4861004",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "凯亚突然这么认真地道谢，感觉好不习惯呢。",
            "nextDialogs": [
              "4861005"
            ]
          },
          "4861005": {
            "id": "4861005",
            "speakerId": 1005,
            "speakerName": "凯亚",
            "text": "哈哈，毕竟事关我们所重视的代理团长大人嘛。",
            "nextDialogs": [
              "4861006"
            ]
          },
          "4861006": {
            "id": "4861006",
            "speakerId": 1005,
            "speakerName": "凯亚",
            "text": "对了，除了道谢以外，还有…",
            "nextDialogs": [
              "4861007"
            ]
          },
          "4861007": {
            "id": "4861007",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "要安排工作给我们？",
            "nextDialogs": [
              "4861008"
            ]
          },
          "4861008": {
            "id": "4861008",
            "speakerId": 1005,
            "speakerName": "凯亚",
            "text": "没错~！我们之间还真是有默契。",
            "nextDialogs": [
              "4861009"
            ]
          },
          "4861009": {
            "id": "4861009",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "是给奖励的环节了？",
            "nextDialogs": [
              "4861010"
            ]
          },
          "4861010": {
            "id": "4861010",
            "speakerId": 1005,
            "speakerName": "凯亚",
            "text": "哈哈哈，我喜欢你的说话风格。",
            "nextDialogs": [
              "4861011"
            ]
          },
          "4861011": {
            "id": "4861011",
            "speakerId": 1005,
            "speakerName": "凯亚",
            "text": "不过在谈这些之前，希望还能再帮骑士团一些忙。",
            "nextDialogs": [
              "4861012"
            ]
          },
          "4861012": {
            "id": "4861012",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是要分担琴的工作吧？",
            "nextDialogs": [
              "4861013"
            ]
          },
          "4861013": {
            "id": "4861013",
            "speakerId": 1005,
            "speakerName": "凯亚",
            "text": "是的，虽然你之前汇报给琴的委托已经安排过人去办了…",
            "nextDialogs": [
              "4861014"
            ]
          },
          "4861014": {
            "id": "4861014",
            "speakerId": 1005,
            "speakerName": "凯亚",
            "text": "…可毕竟不是琴亲自出马，我担心还是会有些纰漏。",
            "nextDialogs": [
              "4861015"
            ]
          },
          "4861015": {
            "id": "4861015",
            "speakerId": 1005,
            "speakerName": "凯亚",
            "text": "希望你可以去看看还有没有可以搭把手的地方。",
            "nextDialogs": [
              "4861016"
            ]
          },
          "4861016": {
            "id": "4861016",
            "speakerId": 1005,
            "speakerName": "凯亚",
            "text": "如果能有享誉蒙德的「荣誉骑士」出手的话，我也就可以放心了。",
            "nextDialogs": [
              "4861017"
            ]
          },
          "4861017": {
            "id": "4861017",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#即使你再怎么夸{NICKNAME}，我也要说——你为什么不自己去帮忙呀！",
            "nextDialogs": [
              "4861018"
            ]
          },
          "4861018": {
            "id": "4861018",
            "speakerId": 1005,
            "speakerName": "凯亚",
            "text": "哈哈，我的身上还有更重要的任务…有很多东西要…嗯，「准备」。",
            "nextDialogs": [
              "4861019"
            ]
          },
          "4861019": {
            "id": "4861019",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哼，那好吧。我记得是…<color=#00E1FFFF>莎拉小姐、查尔斯先生还有玛格丽特小姐</color>那边，对吧？",
            "nextDialogs": [
              "4861020"
            ]
          },
          "4861020": {
            "id": "4861020",
            "speakerId": 1005,
            "speakerName": "凯亚",
            "text": "没错，那么就辛苦二位了，回头见。"
          }
        }
      }
    },
    {
      "subId": "48611",
      "subQuestName": "找玛格丽特听取委托内容",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4870101"
        ],
        "dialogs": {
          "4870101": {
            "id": "4870101",
            "speakerId": 1006,
            "speakerName": "温迪",
            "text": "…原来那只猫是你家走丢的呀。",
            "nextDialogs": [
              "4870102"
            ]
          },
          "4870102": {
            "id": "4870102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "温迪！你也是来帮忙的吗？",
            "nextDialogs": [
              "4870103"
            ]
          },
          "4870103": {
            "id": "4870103",
            "speakerId": 1006,
            "speakerName": "温迪",
            "text": "帮忙？我倒觉得，需要帮忙的其实是我…",
            "nextDialogs": [
              "4870104"
            ]
          },
          "4870104": {
            "id": "4870104",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？我看你刚才好像也在问玛格丽特小姐的「小王子」的事…",
            "nextDialogs": [
              "4870105"
            ]
          },
          "4870105": {
            "id": "4870105",
            "speakerId": 1006,
            "speakerName": "温迪",
            "text": "哦，所以偷走我备用的<color=#00E1FFFF>星铁弦</color>的那只猫，名字叫「小王子」吗。",
            "nextDialogs": [
              "4870106"
            ]
          },
          "4870106": {
            "id": "4870106",
            "speakerId": 1006,
            "speakerName": "温迪",
            "text": "虽说看到蒙德的生灵如此自由自在，是件好事…但未免也太为所欲为了吧。",
            "nextDialogs": [
              "4870107"
            ]
          },
          "4870107": {
            "id": "4870107",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "啊哈哈，「小王子」就是这样调皮机灵的宝贝呢。",
            "nextDialogs": [
              "4870108"
            ]
          },
          "4870108": {
            "id": "4870108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这就是喜欢放纵孩子的家长吧。",
            "nextDialogs": [
              "4870109"
            ]
          },
          "4870109": {
            "id": "4870109",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好像巴巴托斯一样呢。",
            "nextDialogs": [
              "4870110"
            ]
          },
          "4870110": {
            "id": "4870110",
            "speakerId": 1006,
            "speakerName": "温迪",
            "text": "哈哈哈…真是巧妙的比喻，咳咳。还是先找到「小王子」再说吧。",
            "nextDialogs": [
              "4870111"
            ]
          },
          "4870111": {
            "id": "4870111",
            "speakerId": 1006,
            "speakerName": "温迪",
            "text": "今晚我还有演出，拿不回备用弦的话，可就要让听众失望了。",
            "nextDialogs": [
              "4870112"
            ]
          },
          "4870112": {
            "id": "4870112",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "话说猫咪为什么会去偷温迪的备用琴弦呢？",
            "nextDialogs": [
              "4870113"
            ]
          },
          "4870113": {
            "id": "4870113",
            "speakerId": 1002,
            "speakerName": "玛格丽特",
            "text": "猫咪都喜欢玩毛线团的呀！",
            "nextDialogs": [
              "4870114"
            ]
          },
          "4870114": {
            "id": "4870114",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸欸！？",
            "nextDialogs": [
              "4870115"
            ]
          },
          "4870115": {
            "id": "4870115",
            "speakerId": 1006,
            "speakerName": "温迪",
            "text": "星铁做的琴弦蕴含着风的元素力，有超乎意料的韧性，所以平时我都卷成毛线团的样子带在身上啦。",
            "nextDialogs": [
              "4870116"
            ]
          },
          "4870116": {
            "id": "4870116",
            "speakerId": 1006,
            "speakerName": "温迪",
            "text": "这可是吟游诗人的小秘密，哼哼。",
            "nextDialogs": [
              "4870117"
            ]
          },
          "4870117": {
            "id": "4870117",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦？你说那弦上有风的元素力？",
            "nextDialogs": [
              "4870118"
            ]
          },
          "4870118": {
            "id": "4870118",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#那好，我们有线索啦！{NICKNAME}，快用<color=#00E1FFFF>「元素视野」</color>查看一下吧？"
          }
        }
      }
    },
    {
      "subId": "48612",
      "subQuestName": "找查尔斯听取委托内容",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4880001"
        ],
        "dialogs": {
          "4880001": {
            "id": "4880001",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "丽莎小姐，难道是来送税收报表的吗？",
            "nextDialogs": [
              "4880002"
            ]
          },
          "4880002": {
            "id": "4880002",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "哦呀，小可爱。你说的没错。我听说了琴病倒的事，文书类的工作我就先代劳了。",
            "nextDialogs": [
              "4880003"
            ]
          },
          "4880003": {
            "id": "4880003",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这样呀，那看来这边已经没我们什么事了，那我们就先走啦。",
            "nextDialogs": [
              "4880004"
            ]
          },
          "4880004": {
            "id": "4880004",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "啊，稍等一下，其实查尔斯先生这边…",
            "nextDialogs": [
              "4880005"
            ]
          },
          "4880005": {
            "id": "4880005",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "让我来说吧，丽莎小姐。",
            "nextDialogs": [
              "4880006"
            ]
          },
          "4880006": {
            "id": "4880006",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "就在刚才，我接到了一批订单。可店里的库存不够了，酒庄的进货又迟迟未到。",
            "nextDialogs": [
              "4880007"
            ]
          },
          "4880007": {
            "id": "4880007",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "方便的话，想麻烦你们<color=#00E1FFFF>去查看一下货物情况</color>。",
            "nextDialogs": [
              "4880008"
            ]
          },
          "4880008": {
            "id": "4880008",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸，是这么紧急的订单吗。",
            "nextDialogs": [
              "4880009"
            ]
          },
          "4880009": {
            "id": "4880009",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "没办法，毕竟是临时接到的，强人所难的订单——就，在，刚，才。",
            "nextDialogs": [
              "4880010"
            ]
          },
          "4880010": {
            "id": "4880010",
            "speakerId": 1007,
            "speakerName": "丽莎",
            "text": "嗯~嗯~就是这样，如查尔斯先生所说。",
            "nextDialogs": [
              "4880011"
            ]
          },
          "4880011": {
            "id": "4880011",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好吧，我去看看。",
            "nextDialogs": [
              "4880012"
            ]
          },
          "4880012": {
            "id": "4880012",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以，但下次要记得请客。",
            "nextDialogs": [
              "4880013"
            ]
          },
          "4880013": {
            "id": "4880013",
            "speakerId": 1001,
            "speakerName": "查尔斯",
            "text": "呵呵，下次等迪卢克老板在的时候，他肯定会请你喝的。",
            "nextDialogs": [
              "4880014"
            ]
          },
          "4880014": {
            "id": "4880014",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，这还差不多！"
          }
        }
      }
    },
    {
      "subId": "48613",
      "subQuestName": "找莎拉听取委托内容",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4890101"
        ],
        "dialogs": {
          "4890101": {
            "id": "4890101",
            "speakerId": 1008,
            "speakerName": "安柏",
            "text": "我知道啦，我马上就出发！",
            "nextDialogs": [
              "4890102"
            ]
          },
          "4890102": {
            "id": "4890102",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是安柏！你是来处理委托的吗？",
            "nextDialogs": [
              "4890103"
            ]
          },
          "4890103": {
            "id": "4890103",
            "speakerId": 1008,
            "speakerName": "安柏",
            "text": "哇，是你们。我正准备去呢，清理商路上的丘丘人什么的，交给侦察骑士再合适不过了！",
            "nextDialogs": [
              "4890104"
            ]
          },
          "4890104": {
            "id": "4890104",
            "speakerId": 1009,
            "speakerName": "莎拉",
            "text": "唉…",
            "nextDialogs": [
              "4890105"
            ]
          },
          "4890105": {
            "id": "4890105",
            "speakerId": 1008,
            "speakerName": "安柏",
            "text": "莎拉小姐…为什么还是很苦恼的样子？放心啦，侦察骑士的实力不会让你失望的！",
            "nextDialogs": [
              "4890106"
            ]
          },
          "4890106": {
            "id": "4890106",
            "speakerId": 1009,
            "speakerName": "莎拉",
            "text": "哦、哦不是这样的，我没有怀疑你的实力，只是眼下的订单实在太多了。",
            "nextDialogs": [
              "4890107"
            ]
          },
          "4890107": {
            "id": "4890107",
            "speakerId": 1009,
            "speakerName": "莎拉",
            "text": "就在刚才，又新来了一份奇怪的订单，看起来好像是要准备一整场宴会的量…",
            "nextDialogs": [
              "4890108"
            ]
          },
          "4890108": {
            "id": "4890108",
            "speakerId": 1008,
            "speakerName": "安柏",
            "text": "咳咳。",
            "nextDialogs": [
              "4890109"
            ]
          },
          "4890109": {
            "id": "4890109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有什么可以帮忙的吗？",
            "nextDialogs": [
              "4890110"
            ]
          },
          "4890110": {
            "id": "4890110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "其实我也可以帮忙做饭！",
            "nextDialogs": [
              "4890111"
            ]
          },
          "4890111": {
            "id": "4890111",
            "speakerId": 1009,
            "speakerName": "莎拉",
            "text": "真的吗！你愿意帮忙吗？",
            "nextDialogs": [
              "4890112"
            ]
          },
          "4890112": {
            "id": "4890112",
            "speakerId": 1009,
            "speakerName": "莎拉",
            "text": "太好了，你简直就是「猎鹿人」的恩人！",
            "nextDialogs": [
              "4890113"
            ]
          },
          "4890113": {
            "id": "4890113",
            "speakerId": 1008,
            "speakerName": "安柏",
            "text": "唔…我怎么觉得我的风头被抢了？",
            "nextDialogs": [
              "4890114"
            ]
          },
          "4890114": {
            "id": "4890114",
            "speakerId": 1009,
            "speakerName": "莎拉",
            "text": "那这份新的订单就交给你了，先从收集食材开始吧！",
            "nextDialogs": [
              "4890115"
            ]
          },
          "4890115": {
            "id": "4890115",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#可是…{NICKNAME}真的可以吗，料理的口味什么的…",
            "nextDialogs": [
              "4890116"
            ]
          },
          "4890116": {
            "id": "4890116",
            "speakerId": 1009,
            "speakerName": "莎拉",
            "text": "顾不上那么多啦，这可是事关「猎鹿人」声誉的战斗，挑三拣四什么的是不行的！",
            "nextDialogs": [
              "4890117"
            ]
          },
          "4890117": {
            "id": "4890117",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "战、战斗？",
            "nextDialogs": [
              "4890118"
            ]
          },
          "4890118": {
            "id": "4890118",
            "speakerId": 1009,
            "speakerName": "莎拉",
            "text": "料理需要<color=#00E1FFFF>三份甜甜花和三份禽肉</color>。",
            "nextDialogs": [
              "4890119"
            ]
          },
          "4890119": {
            "id": "4890119",
            "speakerId": 1009,
            "speakerName": "莎拉",
            "text": "好了快去准备吧，还有安柏小姐那边也是，我在这里等你们哦！",
            "nextDialogs": [
              "4890120"
            ]
          },
          "4890120": {
            "id": "4890120",
            "speakerId": 1008,
            "speakerName": "安柏",
            "text": "哦…哦、哦！"
          }
        }
      }

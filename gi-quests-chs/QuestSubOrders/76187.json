    {
      "subId": "7618703",
      "subQuestName": "享受茶会时光",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761870301"
        ],
        "dialogs": {
          "761870301": {
            "id": "761870301",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "请允许我代表玛梅赫小姐对您的邀请表示感谢，桑多涅小姐。",
            "nextDialogs": [
              "761870302"
            ]
          },
          "761870302": {
            "id": "761870302",
            "speakerId": 16923,
            "speakerName": "玛梅赫",
            "text": "嗯，点心很好吃。谢谢你，桑多涅。你的厨艺很厉害。",
            "nextDialogs": [
              "761870303"
            ]
          },
          "761870303": {
            "id": "761870303",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "你喜欢就好。",
            "nextDialogs": [
              "761870304"
            ]
          },
          "761870304": {
            "id": "761870304",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "不过，原型机4ACV07，这应该是我们第一次见面吧。你是怎么认出我的？",
            "nextDialogs": [
              "761870305"
            ]
          },
          "761870305": {
            "id": "761870305",
            "speakerId": 16923,
            "speakerName": "玛梅赫",
            "text": "哇，我还是第一次听到有人这么叫西摩尔…",
            "nextDialogs": [
              "761870306"
            ]
          },
          "761870306": {
            "id": "761870306",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "肯定。尽管您也同样温柔可爱、光彩照人，但我此前从未见过您，桑多涅小姐。",
            "nextDialogs": [
              "761870307"
            ]
          },
          "761870307": {
            "id": "761870307",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "我能正确识别出您，是因为我的记忆单元中不可覆写地录入了我的主人——也就是玛丽安·吉约丹小姐的容貌。",
            "nextDialogs": [
              "761870308"
            ]
          },
          "761870308": {
            "id": "761870308",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "玛丽安小姐向我讲过您的事。既然您的容貌与我的主人存在拟合，我便能根据合情推理，识别出您的身份，桑多涅小姐。",
            "nextDialogs": [
              "761870309"
            ]
          },
          "761870309": {
            "id": "761870309",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "唔，不愧是阿兰最初的作品。但在那基础上似乎又有些进阶性的成长…我现在也应该称呼你为西摩尔。",
            "nextDialogs": [
              "761870310"
            ]
          },
          "761870310": {
            "id": "761870310",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "你见到我时有过什么疑惑吗？",
            "nextDialogs": [
              "761870311"
            ]
          },
          "761870311": {
            "id": "761870311",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "否定。我的首要指令是代替阿兰·吉约丹陪伴在小姐身边，保护小姐。",
            "nextDialogs": [
              "761870312"
            ]
          },
          "761870312": {
            "id": "761870312",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "因此，我对玛丽安小姐的了解是完备的。基于逻辑有限维向量空间判断，您与玛丽安小姐完全不同，桑多涅小姐。",
            "nextDialogs": [
              "761870313"
            ]
          },
          "761870313": {
            "id": "761870313",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "两位尊贵的小姐之间的区别，正如沉玉谷的茶叶与苍晶区的泡泡桔。",
            "nextDialogs": [
              "761870314"
            ]
          },
          "761870314": {
            "id": "761870314",
            "speakerId": 16923,
            "speakerName": "玛梅赫",
            "text": "那，桑多涅是茶叶还是泡泡桔？",
            "nextDialogs": [
              "761870315"
            ]
          },
          "761870315": {
            "id": "761870315",
            "speakerId": 16924,
            "speakerName": "西摩尔",
            "text": "检索中…数据不足，无法作答。",
            "nextDialogs": [
              "761870316"
            ]
          },
          "761870316": {
            "id": "761870316",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "（呃…我很庆幸自己的语言模块是阿兰后期迭代过的。）"
          }
        }
      }
    },
    {
      "subId": "7618704",
      "subQuestName": "享受茶会时光",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761870401"
        ],
        "dialogs": {
          "761870401": {
            "id": "761870401",
            "speakerId": 16923,
            "speakerName": "玛梅赫",
            "text": "点心，真好吃！",
            "nextDialogs": [
              "761870402"
            ]
          },
          "761870402": {
            "id": "761870402",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "（再这么坐一会儿吧。）",
            "nextDialogs": [
              "761870404"
            ]
          },
          "761870404": {
            "id": "761870404",
            "speakerId": 16923,
            "speakerName": "玛梅赫",
            "text": "欸？！这么快吗？好吧，谢谢桑多涅小姐！我们下次见！"
          }
        }
      }
    }
  ]
}
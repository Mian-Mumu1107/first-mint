    {
      "subId": "7001901",
      "subQuestName": "与另一个愿意交流的丘丘人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "700190101"
        ],
        "dialogs": {
          "700190101": {
            "id": "700190101",
            "speakerId": 1000,
            "speakerName": "失眠的丘丘人",
            "text": "Yoyo dala si?",
            "nextDialogs": [
              "700190102"
            ]
          },
          "700190102": {
            "id": "700190102",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "Mimi tomo. Mimi mani ye.",
            "nextDialogs": [
              "700190103"
            ]
          },
          "700190103": {
            "id": "700190103",
            "speakerId": 1000,
            "speakerName": "失眠的丘丘人",
            "text": "Yoyo mani mi? Mi muhe Upa Celi nini. Mi muhe mi nunu si, mi muhe mi nye.",
            "nextDialogs": [
              "700190104"
            ]
          },
          "700190104": {
            "id": "700190104",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "他说他希望天上的太阳不见，想要一睡不醒，想要死。是什么让它这么痛苦啊。",
            "nextDialogs": [
              "700190105"
            ]
          },
          "700190105": {
            "id": "700190105",
            "speakerId": 1000,
            "speakerName": "失眠的丘丘人",
            "text": "Biat. Mi muhe <color=#00E1FFFF>celi lata</color>. Mi nunu nye.",
            "nextDialogs": [
              "700190106"
            ]
          },
          "700190106": {
            "id": "700190106",
            "speakerId": 1565,
            "speakerName": "艾拉·马斯克",
            "text": "唔，不如我们就把它想要的东西交给它，权作安慰吧？"
          }
        }
      }
    },
    {
      "subId": "7001902",
      "subQuestName": "向丘丘人交付物品",
      "sceneId": null,

            ]
          },
          "700190302": {
            "id": "700190302",
            "speakerId": 1000,
            "speakerName": "失眠的丘丘人",
            "text": "Wei? Du odomu tomo zido mi si, du zido <color=#00E1FFFF>unta nunu</color>！",
            "nextDialogs": [
              "700190303"
            ]
          },
          "700190303": {
            "id": "700190303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "<color=#00E1FFFF>Unta nunu</color>…它在提示我们时间吧？",
            "nextDialogs": [
              "700190306"
            ]
          },
          "700190306": {
            "id": "700190306",
            "speakerId": 1000,
            "speakerName": "失眠的丘丘人",
            "text": "Valo, mi tomo!",
            "nextDialogs": [
              "700190307"
            ]
          },
          "700190307": {
            "id": "700190307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "Valo!"
          }
        }
      }
    },

    {
      "subId": "2001707",
      "subQuestName": "收集绳索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2001708",
      "subQuestName": "将绳索交给法拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170601"
        ],
        "dialogs": {
          "200170601": {
            "id": "200170601",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "这样就可以了，总之先把车弄回城里去。",
            "nextDialogs": [
              "200170602"
            ]
          },
          "200170602": {
            "id": "200170602",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "谢谢你，旅行者，我们下次再见。",
            "nextDialogs": [
              "200170603"
            ]
          },
          "200170603": {
            "id": "200170603",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "唉，这车子上的味道，可怎么洗掉啊…"
          }
        }
      }
    },
    {
      "subId": "2001702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170201"
        ],
        "dialogs": {
          "200170201": {
            "id": "200170201",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "树林里头肯定有不少<color=#00E1FFFF>结实的木板</color>，拜托了！再等下去，所有的水果都要报销了！"
          }
        }
      }
    },
    {
      "subId": "2001704",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170401"
        ],
        "dialogs": {
          "200170401": {
            "id": "200170401",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "太谢谢了，旅行者。",
            "nextDialogs": [
              "200170402"
            ]
          },
          "200170402": {
            "id": "200170402",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "不过，看来那群家伙压根不想走，我要快点离开这才行。",
            "nextDialogs": [
              "200170403"
            ]
          },
          "200170403": {
            "id": "200170403",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "刚才车又挨了几下，看来想要完全修好是不可能了。算了，我就拿绳子先应急…呃，绳子跑哪去了？",
            "nextDialogs": [
              "200170404"
            ]
          },
          "200170404": {
            "id": "200170404",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "可恶，肯定是被那群怪物丢到不知道哪去了。旅行者，帮我去周围找找<color=#00E1FFFF>绳索</color>吧。"
          }
        }
      }
    },
    {
      "subId": "2001708",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170801"
        ],
        "dialogs": {
          "200170801": {
            "id": "200170801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的急事。",
            "nextDialogs": [
              "200170802"
            ]
          },
          "200170802": {
            "id": "200170802",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "等会！你闻闻这味道，再不把这些水果送走，非全部烂在车里不可，拜托你了，就帮帮我吧。"
          }
        }
      }
    },
    {
      "subId": "2001710",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200171001"
        ],
        "dialogs": {
          "200171001": {
            "id": "200171001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有别的事。",
            "nextDialogs": [
              "200171002"
            ]
          },
          "200171002": {
            "id": "200171002",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "等等，等等，要，要是那群家伙又过来，我只能用水果砸他们了——",
            "nextDialogs": [
              "200171003"
            ]
          },
          "200171003": {
            "id": "200171003",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "拜托了，这个忙只有你能帮我了！"
          }
        }
      }
    }
  ]

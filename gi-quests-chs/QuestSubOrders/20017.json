  "subQuests": [
    {
      "subId": "2001709",
      "subQuestName": "前去查看详情",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170901"
        ],
        "dialogs": {
          "200170901": {
            "id": "200170901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没问题。",
            "nextDialogs": [
              "200170902"
            ]
          },
          "200170902": {
            "id": "200170902",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "那么就拜托你了，这群怪物怎么什么都要…"
          }
        }
      }
    },
    {
      "subId": "2001701",
      "subQuestName": "消灭所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170101"
        ],
        "dialogs": {
          "200170101": {
            "id": "200170101",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "别，别打我！别…咦？旅行者，那些家伙呢？已经被你赶跑了吗？",
            "nextDialogs": [
              "200170102"
            ]
          },
          "200170102": {
            "id": "200170102",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "太好了！太谢谢你了…他们真的都走了？",
            "nextDialogs": [
              "200170103"
            ]
          },
          "200170103": {
            "id": "200170103",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "呼…多亏了你，不过这么一耽搁，我肯定赶不上这趟商队了。",
            "nextDialogs": [
              "200170104"
            ]
          },
          "200170104": {
            "id": "200170104",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "而且，车也被这群家伙给打坏了，得赶紧修好运回城里去，不然水果非烂在车里不可。",
            "nextDialogs": [
              "200170105"
            ]
          },
          "200170105": {
            "id": "200170105",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "你绝对不想知道，这么多水果在车里烂掉之后，车上那股子洗不掉的味道…",
            "nextDialogs": [
              "200170106"
            ]
          },
          "200170106": {
            "id": "200170106",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "我要在这把这些水果都检查一遍，我已经能闻到有不少水果坏掉了。",
            "nextDialogs": [
              "200170107"
            ]
          },
          "200170107": {
            "id": "200170107",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "拜托你去周围帮我找找修车的材料吧，我觉得…一块<color=#00E1FFFF>结实的木板</color>就够用了。"
          }
        }
      }
    },
    {
      "subId": "2001702",
      "subQuestName": "和法拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170701"
        ],
        "dialogs": {
          "200170701": {
            "id": "200170701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我明白了。",
            "nextDialogs": [
              "200170702"
            ]
          },
          "200170702": {
            "id": "200170702",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "太好了，那我就在这等你。呃，到底是哪些水果坏掉了啊——"
          }
        }
      }
    },
    {
      "subId": "2001703",
      "subQuestName": "收集木材",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170301"
        ],
        "dialogs": {
          "200170301": {
            "id": "200170301",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "这些就够用了，我要先去洗洗手，再把车给修好…",
            "nextDialogs": [
              "200170302"
            ]
          },
          "200170302": {
            "id": "200170302",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "咦？又…又来了，旅行者！那群家伙又来了！"
          }
        }
      }
    },
    {
      "subId": "2001704",
      "subQuestName": "将结实的木板交给法拉",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "2001705",
      "subQuestName": "消灭所有魔物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200170501"
        ],
        "dialogs": {
          "200170501": {
            "id": "200170501",
            "speakerId": 1000,
            "speakerName": "法拉",
            "text": "绳索应该就在附近，拜托你帮我找找吧。"
          }
        }
      }
    },
    {
      "subId": "2001706",

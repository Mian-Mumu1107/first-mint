    {
      "subId": "1201602",
      "subQuestName": "与影交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120160204"
        ],
        "dialogs": {
          "120160204": {
            "id": "120160204",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "这里是现在的市集？和记忆中的模样相距甚远啊。",
            "nextDialogs": [
              "120160205"
            ]
          },
          "120160205": {
            "id": "120160205",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "街道上的店面，以及经商的人，嗯，当然也不是当初的样子了。",
            "nextDialogs": [
              "120160206"
            ]
          },
          "120160206": {
            "id": "120160206",
            "speakerId": 1001,
            "speakerName": "小仓澪",
            "text": "将、将军大人？！",
            "nextDialogs": [
              "120160207"
            ]
          },
          "120160207": {
            "id": "120160207",
            "speakerId": 1002,
            "speakerName": "梨绘",
            "text": "为什么将军大人会来这里？",
            "nextDialogs": [
              "120160208"
            ]
          },
          "120160208": {
            "id": "120160208",
            "speakerId": 1003,
            "speakerName": "御舆源一郎",
            "text": "将军大人不是病了吗？怎么突然…",
            "nextDialogs": [
              "120160209"
            ]
          },
          "120160209": {
            "id": "120160209",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "看来，好像把这里的人吓到了。",
            "nextDialogs": [
              "120160210"
            ]
          },
          "120160210": {
            "id": "120160210",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "毕竟是将军大人突然出现，大家肯定会慌张啦。",
            "nextDialogs": [
              "120160213"
            ]
          },
          "120160213": {
            "id": "120160213",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "巡视街道是天领奉行的工作，将军需要处理的信息和下达的指令很多，不会有时间亲力亲为。",
            "nextDialogs": [
              "120160214"
            ]
          },
          "120160214": {
            "id": "120160214",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "将军也是不用休息的，自然也没必要打发时间或者放松精神。",
            "nextDialogs": [
              "120160215"
            ]
          },
          "120160215": {
            "id": "120160215",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "那我们现在怎么办？要不要先离开，等会儿再回来，低调一点？",
            "nextDialogs": [
              "120160216"
            ]
          },
          "120160216": {
            "id": "120160216",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "为什么？我又不是来找麻烦的，自在一点就好。",
            "nextDialogs": [
              "120160217"
            ]
          },
          "120160217": {
            "id": "120160217",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "担心的是这里的普通人…",
            "nextDialogs": [
              "120160218"
            ]
          },
          "120160218": {
            "id": "120160218",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "算了，没关系，很像是你的想法。"
          }
        }
      }
    },

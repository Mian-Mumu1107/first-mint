    {
      "subId": "1201699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120169904"
        ],
        "dialogs": {
          "120169904": {
            "id": "120169904",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "现在市民们的交易，应该仍然在使用摩拉吧？",
            "nextDialogs": [
              "120169905"
            ]
          },
          "120169905": {
            "id": "120169905",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "嗯，这个和以前一样。还是很闪亮，很让人着迷！",
            "nextDialogs": [
              "120169906"
            ]
          },
          "120169906": {
            "id": "120169906",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "等等，影你不会也没有摩拉吧？",
            "nextDialogs": [
              "120169907"
            ]
          },
          "120169907": {
            "id": "120169907",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "当然没有了，在「一心净土」中没有交易的需求。就算是需要某种物品，让奉行众送过来便是。",
            "nextDialogs": [
              "120169908"
            ]
          },
          "120169908": {
            "id": "120169908",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "…你为什么要说「也」？",
            "nextDialogs": [
              "120169916"
            ]
          },
          "120169916": {
            "id": "120169916",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "总算是都看完了，想办法讲给影听好了。"
          }
        }
      }
    }

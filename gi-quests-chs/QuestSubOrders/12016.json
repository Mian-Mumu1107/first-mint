        ],
        "dialogs": {
          "120165901": {
            "id": "120165901",
            "speakerId": 1006,
            "speakerName": "黑田",
            "text": "将军大人看轻小说…",
            "nextDialogs": [
              "120165902"
            ]
          },
          "120165902": {
            "id": "120165902",
            "speakerId": 1006,
            "speakerName": "黑田",
            "text": "哎哟…这才像是发生在轻小说里的情节吧。"
          }
        }
      }
    },
    {
      "subId": "1201660",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

    {
      "subId": "1201608",
      "subQuestName": "与黑田交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120160803"
        ],
        "dialogs": {
          "120160803": {
            "id": "120160803",
            "speakerId": 1006,
            "speakerName": "黑田",
            "text": "将、将军大人？！",
            "nextDialogs": [
              "120160804"
            ]
          },
          "120160804": {
            "id": "120160804",
            "speakerId": 1006,
            "speakerName": "黑田",
            "text": "将军大人亲临八重堂，请问是有什么指示吗？",
            "nextDialogs": [
              "120160805"
            ]
          },
          "120160805": {
            "id": "120160805",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "没什么，不用紧张，只是来看看而已。",
            "nextDialogs": [
              "120160806"
            ]
          },
          "120160806": {
            "id": "120160806",
            "speakerId": 1006,
            "speakerName": "黑田",
            "text": "抱歉，没太能理解，请问是管理方面，还是出版规范，还是说…消防问题呢？",
            "nextDialogs": [
              "120160807"
            ]
          },
          "120160807": {
            "id": "120160807",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "将军就只是想看看书啦。",
            "nextDialogs": [
              "120160808"
            ]
          },
          "120160808": {
            "id": "120160808",
            "speakerId": 1006,
            "speakerName": "黑田",
            "text": "将军大人想要看…轻小说？",
            "nextDialogs": [
              "120160809"
            ]
          },
          "120160809": {
            "id": "120160809",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "对啊，有什么推荐的好书吗？",
            "nextDialogs": [
              "120160810"
            ]
          },
          "120160810": {
            "id": "120160810",
            "speakerId": 1006,
            "speakerName": "黑田",
            "text": "「八重堂」的小说主要面向普通人，内容千奇百怪，可能很多都不符将军大人的口味…",
            "nextDialogs": [
              "120160811"
            ]
          },
          "120160811": {
            "id": "120160811",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "尝鲜而已，千篇一律那才是没趣味。放心吧，只要是用文字所写的故事，有什么不能理解的呢？",
            "nextDialogs": [
              "120160812"
            ]
          },
          "120160812": {
            "id": "120160812",
            "speakerId": 1006,
            "speakerName": "黑田",
            "text": "虽然道理是这样…",
            "nextDialogs": [
              "120160813"
            ]
          },
          "120160813": {
            "id": "120160813",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "没关系，就算有不理解的东西，我们也会给将军解释的！",
            "nextDialogs": [
              "120160816"
            ]
          },
          "120160816": {
            "id": "120160816",
            "speakerId": 1006,
            "speakerName": "黑田",
            "text": "好吧，那请各位移步那边的书架，上面都是最近的热销书。",
            "nextDialogs": [
              "120160817"
            ]
          },
          "120160817": {
            "id": "120160817",
            "speakerId": 1006,
            "speakerName": "黑田",
            "text": "其中也有「这本小说真厉害！」的获奖作品，是刚刚才整理成册开始贩卖的。",
            "nextDialogs": [
              "120160818"
            ]
          },
          "120160818": {
            "id": "120160818",
            "speakerId": 1006,
            "speakerName": "黑田",
            "text": "不用太认真，就当看个乐子吧。",
            "nextDialogs": [
              "120160819"
            ]
          },
          "120160819": {
            "id": "120160819",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "好的，那我们走吧。"
          }
        }
      }
    },
    {
      "subId": "1201609",
      "subQuestName": "前往书架试看轻小说",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1201610",
      "subQuestName": "与影交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120161001"
        ],
        "dialogs": {
          "120161001": {
            "id": "120161001",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "唔…怎么会这样？是我轻敌了吗？",
            "nextDialogs": [
              "120161002"
            ]
          },
          "120161002": {
            "id": "120161002",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "明明这些书的名字都认识，为什么连在一起就变得读不懂了？",
            "nextDialogs": [
              "120161003"
            ]
          },
          "120161003": {
            "id": "120161003",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "比如，《转生成为丘丘人，只要吃日落果就可以一直变强》…",
            "nextDialogs": [
              "120161004"
            ]
          },
          "120161004": {
            "id": "120161004",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "好长啊…",
            "nextDialogs": [
              "120161005"
            ]
          },
          "120161005": {
            "id": "120161005",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "丘丘人真的可以靠吃日落果就变强吗？至少也该是吃肉吧。",
            "nextDialogs": [
              "120161006"
            ]
          },
          "120161006": {
            "id": "120161006",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "这个是这本书的设定啦。",
            "nextDialogs": [
              "120161007"
            ]
          },
          "120161007": {
            "id": "120161007",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "「设定」？",
            "nextDialogs": [
              "120161010"
            ]
          },
          "120161010": {
            "id": "120161010",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "「设定」要用来做什么？缺少了真实感，写出来的故事还会可信吗？",
            "nextDialogs": [
              "120161011"
            ]
          },
          "120161011": {
            "id": "120161011",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "另外，丘丘人应该没有写故事的能力吧，是作者在记录丘丘人的生活吗？",
            "nextDialogs": [
              "120161012"
            ]
          },
          "120161012": {
            "id": "120161012",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "我明白为什么黑田说将军会费解了…"
          }
        }
      }
    },
    {
      "subId": "1201611",
      "subQuestName": "挑选一本合适的轻小说",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120161102"
        ],
        "dialogs": {
          "120161102": {
            "id": "120161102",
            "speakerId": 1007,
            "speakerName": "阅读璃月武侠故事…",
            "text": "（书名《人在江湖，却只想好好写小说》）",
            "nextDialogs": [
              "120161103"
            ]
          },
          "120161103": {
            "id": "120161103",
            "speakerId": 1007,
            "speakerName": "阅读璃月武侠故事…",
            "text": "（这本书讲的是发生在璃月的武侠故事，聚焦于各帮派之间的明争暗斗。）",
            "nextDialogs": [
              "120161104"
            ]
          },
          "120161104": {
            "id": "120161104",
            "speakerId": 1007,
            "speakerName": "阅读璃月武侠故事…",
            "text": "（主角的理想是成为与世无争的普通轻小说家，却因为拥有独一无二的习武体质，被卷入了江湖争斗中。）",
            "nextDialogs": [
              "120161105"
            ]
          },
          "120161105": {
            "id": "120161105",
            "speakerId": 1007,
            "speakerName": "阅读璃月武侠故事…",
            "text": "（故事的卖点在于主角始终没有加入任何一派，却总是被误认为是某一门派的隐世高手。）",
            "nextDialogs": [
              "120161106"
            ]
          },
          "120161106": {
            "id": "120161106",
            "speakerId": 1007,
            "speakerName": "阅读璃月武侠故事…",
            "text": "（把主角视为假想敌的各路高手总是闹得啼笑皆非，而主角置身其中，却从未忘记成为小说家的初心…）",
            "nextDialogs": [
              "120161107"
            ]
          },
          "120161107": {
            "id": "120161107",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "好奇怪的人啊，为什么非要当轻小说家不可呢？",
            "nextDialogs": [
              "120161108"
            ]
          },
          "120161108": {
            "id": "120161108",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "这么厉害的话，应该轻轻松松就能成为武林第一吧。",
            "nextDialogs": [
              "120161111"
            ]
          },
          "120161111": {
            "id": "120161111",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "也有道理，将愿望贯彻到底的人，应该能引起影的共鸣吧？"
          }
        }
      }
    },
    {
      "subId": "1201612",
      "subQuestName": "挑选一本合适的轻小说",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120161201"
        ],
        "dialogs": {
          "120161201": {
            "id": "120161201",
            "speakerId": 1008,
            "speakerName": "阅读日常恋爱故事…",
            "text": "（书名《关于我的混乱系青春恋爱物语一事》）",
            "nextDialogs": [
              "120161202"
            ]
          },
          "120161202": {
            "id": "120161202",
            "speakerId": 1008,
            "speakerName": "阅读日常恋爱故事…",
            "text": "（这本书讲的是平平无奇的男主角，和七位美少女之间的爱情故事。）",
            "nextDialogs": [
              "120161203"
            ]
          },
          "120161203": {
            "id": "120161203",
            "speakerId": 1008,
            "speakerName": "阅读日常恋爱故事…",
            "text": "（作品以时间推进为顺序，记述了这位主角的日常生活，其中有相当多让人会心一笑的小桥段。）",
            "nextDialogs": [
              "120161204"
            ]
          },
          "120161204": {
            "id": "120161204",
            "speakerId": 1008,
            "speakerName": "阅读日常恋爱故事…",
            "text": "（作者的笔力扎实，语句流畅，每位角色的魅力都呈现得淋漓尽致。）",
            "nextDialogs": [
              "120161205"
            ]
          },
          "120161205": {
            "id": "120161205",
            "speakerId": 1008,
            "speakerName": "阅读日常恋爱故事…",
            "text": "（不过，故事断在了男主角的青梅竹马正准备表白爱意的关键时刻…）",
            "nextDialogs": [
              "120161206"
            ]
          },
          "120161206": {
            "id": "120161206",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "好着急啊！",
            "nextDialogs": [
              "120161207"
            ]
          },
          "120161207": {
            "id": "120161207",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "虽然只是草草地看了一下，但这个女孩子从小就很喜欢男主角，把一切都奉献出来了！",
            "nextDialogs": [
              "120161209",
              "120161211"
            ]
          },
          "120161209": {
            "id": "120161209",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "没错！可不能让她的感情被辜负了！",
            "nextDialogs": [
              "120161212"
            ]
          },
          "120161212": {
            "id": "120161212",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "情节是挺吸引人的，但影能够理解这种…凡人之间的恋爱吗？"
          },
          "120161211": {
            "id": "120161211",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "对哦，毕竟还是小说。希望作者是个好人，希望作者是个好人，希望作者是个好人…"
          }
        }
      }
    },
    {
      "subId": "1201613",
      "subQuestName": "挑选一本合适的轻小说",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120161301"
        ],
        "dialogs": {
          "120161301": {
            "id": "120161301",
            "speakerId": 1009,
            "speakerName": "阅读转生冒险故事…",
            "text": "（书名《转生成为雷电将军，然后天下无敌》）",
            "nextDialogs": [
              "120161302"
            ]
          },
          "120161302": {
            "id": "120161302",
            "speakerId": 1009,
            "speakerName": "阅读转生冒险故事…",
            "text": "（这本书讲的是主角在雷樱树下被闪电击中，睁开眼的时候居然变成了雷电将军的故事。）",
            "nextDialogs": [
              "120161303"
            ]
          },
          "120161303": {
            "id": "120161303",
            "speakerId": 1009,
            "speakerName": "阅读转生冒险故事…",
            "text": "（原本的主角总是被欺负，什么事都做不好，但成为雷电将军之后，他就拥有了无穷的武力与权力。）",
            "nextDialogs": [
              "120161304"
            ]
          },
          "120161304": {
            "id": "120161304",
            "speakerId": 1009,
            "speakerName": "阅读转生冒险故事…",
            "text": "（故事的看点，大概就是这种扬眉吐气的感觉，以及自卑的内在逐渐成长与蜕变的过程。）",
            "nextDialogs": [
              "120161305"
            ]
          },
          "120161305": {
            "id": "120161305",
            "speakerId": 1009,
            "speakerName": "阅读转生冒险故事…",
            "text": "（但都已经成为了雷电将军，接下来的故事要怎么展开呢…）",
            "nextDialogs": [
              "120161306"
            ]
          },
          "120161306": {
            "id": "120161306",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "怪不得黑田会害怕，原来还有这种题材啊。",
            "nextDialogs": [
              "120161307"
            ]
          },
          "120161307": {
            "id": "120161307",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "我觉得还是不要把这个故事讲给影听，不然作者可能会被追究责任的。",
            "nextDialogs": [
              "120161310"
            ]
          },
          "120161310": {
            "id": "120161310",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "如果有人变成了派蒙，还做了很多派蒙根本就不会做的事，我会觉得很不自在！"
          }
        }
      }
    },
    {
      "subId": "1201614",
      "subQuestName": "为影推荐并讲解书中内容",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120161402"
        ],
        "dialogs": {
          "120161402": {
            "id": "120161402",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "看你们的表情，应该读到了不错的故事吧。",
            "nextDialogs": [
              "120161404",
              "120161412",
              "120161420"
            ]
          },
          "120161404": {
            "id": "120161404",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "如今璃月的人心，原来这么复杂吗？",
            "nextDialogs": [
              "120161405"
            ]
          },
          "120161405": {
            "id": "120161405",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "相较之下，主角虽然一直不愿正视自身的天赋，却是位不可多得的正义之士。",
            "nextDialogs": [
              "120161406"
            ]
          },
          "120161406": {
            "id": "120161406",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "他现在在哪里？有来稻妻的打算吗？我想让奉行众把他请来，和我打一场。",
            "nextDialogs": [
              "120161407"
            ]
          },
          "120161407": {
            "id": "120161407",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "那是虚构的角色，现实中不存在啦…",
            "nextDialogs": [
              "120161408"
            ]
          },
          "120161408": {
            "id": "120161408",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "更该关注的是反派吧，你对那些反派的作为没什么感想吗？",
            "nextDialogs": [
              "120161409"
            ]
          },
          "120161409": {
            "id": "120161409",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "反派？那些愚蠢的人对吧。都是坏人，结果也就是罪有应得而已。",
            "nextDialogs": [
              "120161410"
            ]
          },
          "120161410": {
            "id": "120161410",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "看来影完全不关心配角啊。",
            "nextDialogs": [
              "120161426"
            ]
          },
          "120161426": {
            "id": "120161426",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "所以，影对「八重堂」的轻小说有什么看法呢？",
            "nextDialogs": [
              "120161427"
            ]
          },
          "120161427": {
            "id": "120161427",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "我们挑选的故事合你的口味吗？",
            "nextDialogs": [
              "120161428"
            ]
          },
          "120161428": {
            "id": "120161428",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "相比具体的内容，我从故事里感受到的是，时间在稻妻留下的痕迹。",
            "nextDialogs": [
              "120161429"
            ]
          },
          "120161429": {
            "id": "120161429",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "在我决定深居「一心净土」的时候，那时还没有什么「八重堂」，更没有像这样的故事存在。",
            "nextDialogs": [
              "120161430"
            ]
          },
          "120161430": {
            "id": "120161430",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "将军依我之意，尽全力打造永恒的国度，这个国度本应没有任何变化。",
            "nextDialogs": [
              "120161431"
            ]
          },
          "120161431": {
            "id": "120161431",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "可现在，无论是食物还是故事，都已经很不相同了…"
          },
          "120161412": {
            "id": "120161412",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "为什么有七个人都执着于和男主角缔结关系，这也是「设定」吗？",
            "nextDialogs": [
              "120161413"
            ]
          },
          "120161413": {
            "id": "120161413",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "不是啦，就是很普通的恋爱，主角最后只能选择一个人嘛。",
            "nextDialogs": [
              "120161414"
            ]
          },
          "120161414": {
            "id": "120161414",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "我明白了，因为他想要缔结重要的关系，所以必须好好选择，这也就是痛苦与矛盾的根源。",
            "nextDialogs": [
              "120161415"
            ]
          },
          "120161415": {
            "id": "120161415",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "那只要作者加一个「设定」，让主角可以同时接受所有人的感情，不就解决问题了吗！",
            "nextDialogs": [
              "120161416"
            ]
          },
          "120161416": {
            "id": "120161416",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "那爱情故事的看点就没有了啊！",
            "nextDialogs": [
              "120161417"
            ]
          },
          "120161417": {
            "id": "120161417",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "「爱情」…",
            "nextDialogs": [
              "120161418"
            ]
          },
          "120161418": {
            "id": "120161418",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "嗯，「设定」还真是深奥啊。"
          },
          "120161420": {
            "id": "120161420",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "喂，不是说好不讲这个的吗？",
            "nextDialogs": [
              "120161421"
            ]
          },
          "120161421": {
            "id": "120161421",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "没事，还挺有意思的，没想到在普通民众的眼中，将军是这样的形象。",
            "nextDialogs": [
              "120161422"
            ]
          },
          "120161422": {
            "id": "120161422",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "「无想的一刀」不会像书中那样随意使用，也不会用来宣泄情绪。出刀的理由，决定了武艺的格局与极限。",
            "nextDialogs": [
              "120161423"
            ]
          },
          "120161423": {
            "id": "120161423",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "由于差别过大了，我并不会感觉到被冒犯，反倒觉得这种想象力很是可贵。",
            "nextDialogs": [
              "120161424"
            ]
          },
          "120161424": {
            "id": "120161424",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "不过我听说，八重堂的小说，都会经过那个家伙的审稿吧。",
            "nextDialogs": [
              "120161425"
            ]
          },
          "120161425": {
            "id": "120161425",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "也就是说，这本书的内容，也是得到了神子的默许…不，也可能就是她出的主意呢。"
          }
        }
      }
    },
    {
      "subId": "1201651",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120165101"
        ],
        "dialogs": {
          "120165101": {
            "id": "120165101",
            "speakerId": 1010,
            "speakerName": "毅",
            "text": "那是…将军大人？难道休养已经结束了？",
            "nextDialogs": [
              "120165102"
            ]
          },
          "120165102": {
            "id": "120165102",
            "speakerId": 1010,
            "speakerName": "毅",
            "text": "不过没事就好。"
          }
        }
      }
    },
    {
      "subId": "1201652",

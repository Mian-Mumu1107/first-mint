            "id": "120166001",
            "speakerId": 1000,
            "speakerName": "影",
            "text": "不用着急，好好挑选吧，我就在这里等着。"
          }
        }
      }
    },
    {
      "subId": "1201661",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120166101"
        ],
        "dialogs": {
          "120166101": {
            "id": "120166101",
            "speakerId": 1005,
            "speakerName": "智树",
            "text": "将军大人…肯定了我的「团子牛奶」。",
            "nextDialogs": [
              "120166102"
            ]
          },
          "120166102": {
            "id": "120166102",
            "speakerId": 1005,
            "speakerName": "智树",
            "text": "太好了，本来我还说以后就不做这个了，太好了…"
          }
        }
      }

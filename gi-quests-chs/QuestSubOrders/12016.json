        ],
        "dialogs": {
          "120165801": {
            "id": "120165801",
            "speakerId": 1005,
            "speakerName": "智树",
            "text": "居然是将军大人…",
            "nextDialogs": [
              "120165802"
            ]
          },
          "120165802": {
            "id": "120165802",
            "speakerId": 1005,
            "speakerName": "智树",
            "text": "怎么办，好紧张…"
          }
        }
      }
    },
    {
      "subId": "1201659",
      "subQuestName": "Additional",
      "sceneId": null,

    {
      "subId": "7620003",
      "subQuestName": "与宝藏猎人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762000201"
        ],
        "dialogs": {
          "762000201": {
            "id": "762000201",
            "speakerId": 1001,
            "speakerName": "朱卡",
            "text": "小妹妹，耽误你一点时间，想问问你在附近看到过一只虎纹猫吗？",
            "nextDialogs": [
              "762000202"
            ]
          },
          "762000202": {
            "id": "762000202",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "虎纹猫？好像没有。露米有看到吗？",
            "nextDialogs": [
              "762000203"
            ]
          },
          "762000203": {
            "id": "762000203",
            "speakerId": 1002,
            "speakerName": "露米",
            "text": "呀吼？",
            "nextDialogs": [
              "762000204"
            ]
          },
          "762000204": {
            "id": "762000204",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "看来露米也没有印象…你们的猫丢了吗？我可以帮忙找找看！这一带的环境我还挺熟悉的…",
            "nextDialogs": [
              "762000205"
            ]
          },
          "762000205": {
            "id": "762000205",
            "speakerId": 1003,
            "speakerName": "玛尔佳",
            "text": "喂，朱卡！我们哪有什么闲钱雇佣冒险家啊，再说了，不就是只笨猫，大不了不要它了。",
            "nextDialogs": [
              "762000206"
            ]
          },
          "762000206": {
            "id": "762000206",
            "speakerId": 1001,
            "speakerName": "朱卡",
            "text": "玛尔佳，别说这种话，它要是听到了会伤心的。",
            "nextDialogs": [
              "762000207"
            ]
          },
          "762000207": {
            "id": "762000207",
            "speakerId": 1003,
            "speakerName": "玛尔佳",
            "text": "它根本听不到吧！要是听得到，也不会我们喊了半天也没回音。",
            "nextDialogs": [
              "762000208"
            ]
          },
          "762000208": {
            "id": "762000208",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "这点小事就不用委托费啦，而且我正好要在附近调查，就当是顺便好了。走吧，露米！",
            "nextDialogs": [
              "762000209"
            ]
          },
          "762000209": {
            "id": "762000209",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "（前阵子还什么都没有，现在居然长出这么多双叶笼草…）",
            "nextDialogs": [
              "762000210"
            ]
          },
          "762000210": {
            "id": "762000210",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "（说不定是什么动物带来了双叶笼草的种子，不过放任它们这样下去可不行呀…）"
          }
        }
      }
    },
    {
      "subId": "7620004",
      "subQuestName": "寻找虎纹猫",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762000501"
        ],
        "dialogs": {
          "762000501": {
            "id": "762000501",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "露米，你也觉得它就在这儿？",
            "nextDialogs": [
              "762000502"
            ]
          },
          "762000502": {
            "id": "762000502",
            "speakerId": 1002,
            "speakerName": "露米",
            "text": "呀吼吼！",
            "nextDialogs": [
              "762000503"
            ]
          },
          "762000503": {
            "id": "762000503",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "解救了被困的虎纹猫…",
            "nextDialogs": [
              "762000504"
            ]
          },
          "762000504": {
            "id": "762000504",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "他们要找的就是你吧，看起来没什么皮外伤，不过要是再晚点就不好说了。",
            "nextDialogs": [
              "762000505"
            ]
          },
          "762000505": {
            "id": "762000505",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "总之，先去找你的伙伴吧！"
          }
        }
      }
    },
    {
      "subId": "7620005",
      "subQuestName": "与宝藏猎人对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "762000801"
        ],
        "dialogs": {
          "762000801": {
            "id": "762000801",
            "speakerId": 1003,
            "speakerName": "玛尔佳",
            "text": "笨猫——到底在哪里…欸？你找到它了！",
            "nextDialogs": [
              "762000802"
            ]
          },
          "762000802": {
            "id": "762000802",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "它被那边的双叶笼草困住了，虽然是植物，但却是食肉的掠食者呢，消化月萤虫也只需要几天…",
            "nextDialogs": [
              "762000803"
            ]
          },
          "762000803": {
            "id": "762000803",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "幸好发现得早，它现在只是有点虚弱，要是再晚些就不好说了。",
            "nextDialogs": [
              "762000804"
            ]
          },
          "762000804": {
            "id": "762000804",
            "speakerId": 1001,
            "speakerName": "朱卡",
            "text": "居、居然这么危险…",
            "nextDialogs": [
              "762000805"
            ]
          },
          "762000805": {
            "id": "762000805",
            "speakerId": 1003,
            "speakerName": "玛尔佳",
            "text": "还不都怪它自己要往这儿钻，真是只笨猫。",
            "nextDialogs": [
              "762000806"
            ]
          },
          "762000806": {
            "id": "762000806",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "公平地说，这可不能怪它，是因为双叶笼草会散发一种特殊的气味，对人没什么影响，但昆虫之类的却会被吸引。",
            "nextDialogs": [
              "762000807"
            ]
          },
          "762000807": {
            "id": "762000807",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "双叶笼草就是用这种方式捕食的。这一带的双叶笼草多得有点异常了，所以就连小动物也被影响了。",
            "nextDialogs": [
              "762000808"
            ]
          },
          "762000808": {
            "id": "762000808",
            "speakerId": 1003,
            "speakerName": "玛尔佳",
            "text": "哦…哦，总之这草莫名其妙长这么多，肯定不是好事对吧。",
            "nextDialogs": [
              "762000809"
            ]
          },
          "762000809": {
            "id": "762000809",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "嗯，如果放任不管的话，可能会造成危害…",
            "nextDialogs": [
              "762000810"
            ]
          },
          "762000810": {
            "id": "762000810",
            "speakerId": 1003,
            "speakerName": "玛尔佳",
            "text": "好，那除草就交给我们了。朱卡，你也来帮忙！",
            "nextDialogs": [
              "762000811"
            ]
          },
          "762000811": {
            "id": "762000811",
            "speakerId": 1003,
            "speakerName": "玛尔佳",
            "text": "让那笨猫吃了这么久苦头的家伙，我们也得好好回敬一下。",
            "nextDialogs": [
              "762000812"
            ]
          },
          "762000812": {
            "id": "762000812",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "和两个宝藏猎人一起清除掉了在这一带异常生长的双叶笼草…",
            "nextDialogs": [
              "762000813"
            ]
          },
          "762000813": {
            "id": "762000813",
            "speakerId": 1003,
            "speakerName": "玛尔佳",
            "text": "呼——总算结束了。我们也该回那夏镇了…小姑娘，多谢了，帮我们找到这只笨猫，要是没有你帮忙，它还不知道要被困多久。",
            "nextDialogs": [
              "762000814"
            ]
          },
          "762000814": {
            "id": "762000814",
            "speakerId": 1001,
            "speakerName": "朱卡",
            "text": "不过说起来，要不是刚才玛尔佳喊得那么大声，说不定我们早就找到它了…",
            "nextDialogs": [
              "762000815"
            ]
          },
          "762000815": {
            "id": "762000815",
            "speakerId": 1003,
            "speakerName": "玛尔佳",
            "text": "要、要你多嘴！总之，它现在安全回来了不就行了吗。",
            "nextDialogs": [
              "762000816"
            ]
          },
          "762000816": {
            "id": "762000816",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "（虽然她嘴上笨猫、笨猫地叫，其实还是很关心同伴的嘛。）",
            "nextDialogs": [
              "762000817"
            ]
          },
          "762000817": {
            "id": "762000817",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "是呀，它现在平安无事才是最重要的。野外还是很危险的，你们也要多留意。",
            "nextDialogs": [
              "762000818"
            ]
          },
          "762000818": {
            "id": "762000818",
            "speakerId": 1001,
            "speakerName": "朱卡",
            "text": "谢谢你，我们会的。",
            "nextDialogs": [
              "762000819"
            ]
          },
          "762000819": {
            "id": "762000819",
            "speakerId": 1003,
            "speakerName": "玛尔佳",
            "text": "也祝你调查顺利。那就再见咯。"
          }
        }
      }
    },

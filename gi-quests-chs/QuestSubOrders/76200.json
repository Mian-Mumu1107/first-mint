            ]
          },
          "762009902": {
            "id": "762009902",
            "speakerId": 1000,
            "speakerName": "莉奈娅",
            "text": "（嗯？那边好像有什么动静…）",
            "nextDialogs": [
              "762009903"
            ]
          },
          "762009903": {
            "id": "762009903",
            "speakerId": 1003,
            "speakerName": "玛尔佳",
            "text": "笨猫——",
            "nextDialogs": [

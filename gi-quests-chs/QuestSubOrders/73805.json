        "dialogs": {
          "738050101": {
            "id": "738050101",
            "speakerId": 1000,
            "speakerName": "玛亚姆",
            "text": "旅行者，稍等一下，这里有一封信给你。",
            "nextDialogs": [
              "738050102"
            ]
          },
          "738050102": {
            "id": "738050102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "给我的信？",
            "nextDialogs": [
              "738050103"
            ]
          },
          "738050103": {
            "id": "738050103",
            "speakerId": 1000,
            "speakerName": "玛亚姆",
            "text": "是那个叫「旭东」的璃月人留给你的。",
            "nextDialogs": [
              "738050106"
            ]
          },
          "738050106": {
            "id": "738050106",
            "speakerId": 1000,
            "speakerName": "玛亚姆",
            "text": "那我可就不知道了。前段时间，他匆匆忙忙地过来，交给我了这封信。",
            "nextDialogs": [
              "738050107"
            ]
          },
          "738050107": {
            "id": "738050107",
            "speakerId": 1000,
            "speakerName": "玛亚姆",
            "text": "说什么…请务必转交给你，还给了我一笔钱呢。",
            "nextDialogs": [
              "738050108"
            ]
          },
          "738050108": {
            "id": "738050108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "旭东…匆匆忙忙的？有什么事会让他这么着急呀？",
            "nextDialogs": [
              "738050109"
            ]
          },
          "738050109": {
            "id": "738050109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "难道…是那个坏蛋又捣乱了？"
          }
        }
      }
    }
  ]

  "subQuests": [
    {
      "subId": "4005201",
      "subQuestName": "与露子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721430101"
        ],
        "dialogs": {
          "721430101": {
            "id": "721430101",
            "speakerId": 1000,
            "speakerName": "露子",
            "text": "您好，自外而来的客人。我叫露子，是珊瑚宫的巫女。请问客人是来帮忙的吗？",
            "nextDialogs": [
              "721430102"
            ]
          },
          "721430102": {
            "id": "721430102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "帮忙…？",
            "nextDialogs": [
              "721430103"
            ]
          },
          "721430103": {
            "id": "721430103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个人怎么一见面就要人帮忙！",
            "nextDialogs": [
              "721430104"
            ]
          },
          "721430104": {
            "id": "721430104",
            "speakerId": 1000,
            "speakerName": "露子",
            "text": "哈哈，抱歉失礼了…",
            "nextDialogs": [
              "721430105"
            ]
          },
          "721430105": {
            "id": "721430105",
            "speakerId": 1000,
            "speakerName": "露子",
            "text": "只是此前我求过愿。根据签文，我所苦恼之事、困扰之事，必定有人相助而得以圆满。",
            "nextDialogs": [
              "721430106"
            ]
          },
          "721430106": {
            "id": "721430106",
            "speakerId": 1000,
            "speakerName": "露子",
            "text": "现在命中的贵人果然来帮助我了，对吧？",
            "nextDialogs": [
              "721430108",
              "721430110"
            ]
          },
          "721430108": {
            "id": "721430108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真是没办法呢，姑且先听听露子姐姐怎么说吧。",
            "nextDialogs": [
              "721430111"
            ]
          },
          "721430111": {
            "id": "721430111",
            "speakerId": 1000,
            "speakerName": "露子",
            "text": "非常感谢。那么，就请允许我为您稍事介绍吧。",
            "nextDialogs": [
              "721430112"
            ]
          },
          "721430112": {
            "id": "721430112",
            "speakerId": 1000,
            "speakerName": "露子",
            "text": "珊瑚宫正对的深潭便是「渊下宫」的入口，传说也是海祇人的起源。",
            "nextDialogs": [
              "721430113"
            ]
          },
          "721430113": {
            "id": "721430113",
            "speakerId": 1000,
            "speakerName": "露子",
            "text": "在古代，曾经有「海祇美人」的说法，并且说海祇人肤质细嫩，可以令七种难隐的污痕都不再显眼呢。",
            "nextDialogs": [
              "721430114"
            ]
          },
          "721430114": {
            "id": "721430114",
            "speakerId": 1000,
            "speakerName": "露子",
            "text": "这种说法的来由呢，是因为我们的祖先在渊下宫得不到日照…"
          },
          "721430110": {
            "id": "721430110",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这都是什么求人帮忙的理由…"
          }
        }
      }
    }
  ]
}
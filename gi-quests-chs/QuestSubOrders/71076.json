  },
  "subQuests": [
    {
      "subId": "7106212",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710621201"
        ],
        "dialogs": {
          "710621201": {
            "id": "710621201",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "我们很快就会撤离，如果阻碍了你的冒险，那么实属抱歉。",
            "nextDialogs": [
              "710621203",
              "710621211",
              "710621214",
              "710621222"
            ]
          },
          "710621203": {
            "id": "710621203",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "很久以前的事情了，这里刚刚封闭，我们就找上了璃月的七星。",
            "nextDialogs": [
              "710621204"
            ]
          },
          "710621204": {
            "id": "710621204",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "开始大家谈得还可以…「女士」大人还顺势谈成了几笔有利于双方的贸易协定。",
            "nextDialogs": [
              "710621205"
            ]
          },
          "710621205": {
            "id": "710621205",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "而愚人众先遣部队进驻层岩巨渊，原本是附加条件之一…我们来到这里为的是调查和消灭异变源头。",
            "nextDialogs": [
              "710621206"
            ]
          },
          "710621206": {
            "id": "710621206",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "我们调查所得的一切情报，则是由至冬国和璃月公平共享。",
            "nextDialogs": [
              "710621207"
            ]
          },
          "710621207": {
            "id": "710621207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们没有别的目的了吗？",
            "nextDialogs": [
              "710621208"
            ]
          },
          "710621208": {
            "id": "710621208",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "至少就我们所知，没有。我们出发时还受到了市民们的祝福，大家都认为…我们是牺牲自己保护别人的英雄部队。",
            "nextDialogs": [
              "710621209"
            ]
          },
          "710621209": {
            "id": "710621209",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "唉…谁知道，现在事情变成了这样。"
          },
          "710621211": {
            "id": "710621211",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "或者「漆黑灾祸」，或者随便怎么称呼…五百年前的那场大灾难。",
            "nextDialogs": [
              "710621212"
            ]
          },
          "710621212": {
            "id": "710621212",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "总之…是我们至冬人永恒的敌人，我们相信的是…五百年来，灾祸一直在潜伏着，而我们会永远保持警惕。"
          },
          "710621214": {
            "id": "710621214",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "我们自己？有什么好说的…我们在努力战斗了，但失败了，就这么简单。",
            "nextDialogs": [
              "710621215"
            ]
          },
          "710621215": {
            "id": "710621215",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "下来的时候我们是第九连队，六十四人。可到现在呢？包括连长在内…牺牲或失踪的可能超过一半以上，也可能不到…",
            "nextDialogs": [
              "710621216"
            ]
          },
          "710621216": {
            "id": "710621216",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "但大体差不多…我们都被打散了，彼此失去了联系…我们已经输了，早就该撤离了…",
            "nextDialogs": [
              "710621217"
            ]
          },
          "710621217": {
            "id": "710621217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你们在地面的同僚攻击了璃月港。",
            "nextDialogs": [
              "710621218"
            ]
          },
          "710621218": {
            "id": "710621218",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "…很惊讶，但完全理解。",
            "nextDialogs": [
              "710621219"
            ]
          },
          "710621219": {
            "id": "710621219",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "为了协助更有意义的冒险，「公鸡」大人自然会抛弃相对低价值的资产，这是他的理性。",
            "nextDialogs": [
              "710621220"
            ]
          },
          "710621220": {
            "id": "710621220",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "我们作为他的直属部下，对此完全可以接受…"
          },
          "710621222": {
            "id": "710621222",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "你遇见她了？她还活着…？我希望她能原谅我们。",
            "nextDialogs": [
              "710621223"
            ]
          },
          "710621223": {
            "id": "710621223",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "她和她的弟弟，尼古拉下士，都是在「壁炉之家」长大的…是女皇陛下的孩子们。",
            "nextDialogs": [
              "710621224"
            ]
          },
          "710621224": {
            "id": "710621224",
            "speakerId": 20536,
            "speakerName": "安东",
            "text": "她和我说一定要找到弟弟才行，我以为是下面的环境搞坏了她的脑子才让她那样子出丑…她的弟弟不可能活下来了。"
          }
        }
      }
    },

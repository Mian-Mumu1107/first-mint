    {
      "subId": "7106228",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710622801"
        ],
        "dialogs": {
          "710622801": {
            "id": "710622801",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "谢谢你的食物，有什么话请跟安东连长说吧，我没什么可以告诉你的。",
            "nextDialogs": [
              "710622802"
            ]
          },
          "710622802": {
            "id": "710622802",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "呃…请不要误会，我是说，关于部队机密，你明白的…",
            "nextDialogs": [
              "710622803"
            ]
          },
          "710622803": {
            "id": "710622803",
            "speakerId": 20550,
            "speakerName": "拉多米尔",
            "text": "咳咳，总之…希望我们下次能作为朋友再见。"
          }
        }
      }
    },
    {
      "subId": "7106229",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710622901"
        ],
        "dialogs": {
          "710622901": {
            "id": "710622901",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "感谢你的帮助，实在抱歉没有什么能给你的。",
            "nextDialogs": [
              "710622902"
            ]
          },
          "710622902": {
            "id": "710622902",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "安托哈他还是第一次当连长，哈…恐怕也是最后一次咯。但只要能把我们都活着弄出去，他这个连长也是合格了。",
            "nextDialogs": [
              "710622903"
            ]
          },
          "710622903": {
            "id": "710622903",
            "speakerId": 20549,
            "speakerName": "达尼拉",
            "text": "无论如何，希望你接下来的旅途一路平安。"
          }
        }
      }
    },
    {
      "subId": "7106230",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710623001"
        ],
        "dialogs": {
          "710623001": {
            "id": "710623001",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "哈，我们的大恩人来了。下次在野外如果再见到了我，还请你不要急着动手呀！",
            "nextDialogs": [
              "710623002"
            ]
          },
          "710623002": {
            "id": "710623002",
            "speakerId": 20551,
            "speakerName": "提莫尔",
            "text": "嘿嘿…开玩笑的，希望下次再见面，我们不会是敌人。"
          }
        }
      }
    }
  ]

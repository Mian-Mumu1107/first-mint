    {
      "subId": "1503308",
      "subQuestName": "(test)伊安珊常驻对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150330801"
        ],
        "dialogs": {
          "150330801": {
            "id": "150330801",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "欸，是伊安珊老师！你正好要训练吗？",
            "nextDialogs": [
              "150330802"
            ]
          },
          "150330802": {
            "id": "150330802",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "哦不是，今天总算有时间，我想保养一下院子里的这些设备。",
            "nextDialogs": [
              "150330803"
            ]
          },
          "150330803": {
            "id": "150330803",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "欸，是你们！欢迎你们到「沃陆之邦」来！",
            "nextDialogs": [
              "150330804"
            ]
          },
          "150330804": {
            "id": "150330804",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "快看，我前几天在竞技场买了这个。",
            "nextDialogs": [
              "150330805"
            ]
          },
          "150330805": {
            "id": "150330805",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦，这上面是我们之前见过的涂鸦！",
            "nextDialogs": [
              "150330806"
            ]
          },
          "150330806": {
            "id": "150330806",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "现在可难买了，我排了好久的队才买到，哈哈哈。",
            "nextDialogs": [
              "150330807"
            ]
          },
          "150330807": {
            "id": "150330807",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "我也有件画上这个涂鸦的衣服，我挂在床头了，嘿嘿。",
            "nextDialogs": [
              "150330809",
              "150330811"
            ]
          },
          "150330809": {
            "id": "150330809",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "下次麻烦你给我的衣服签名吧，我会珍藏起来！",
            "nextDialogs": [
              "150330812"
            ]
          },
          "150330812": {
            "id": "150330812",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "对了，你们来这里，有什么安排吗？"
          },
          "150330811": {
            "id": "150330811",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "哈哈哈，受欢迎是件好事啊，这是你应有的待遇。"
          }
        }
      }
    },
    {
      "subId": "1503303",
      "subQuestName": "前往果园，与瓦雷莎交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150331401"
        ],
        "dialogs": {
          "150331401": {
            "id": "150331401",
            "speakerId": 1003,
            "speakerName": "瓦娜娜",
            "text": "呜呜——",
            "nextDialogs": [
              "150331402"
            ]
          },
          "150331402": {
            "id": "150331402",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "辛苦你看家啦，瓦娜娜。我看看，我看看，你是不是又变壮了。",
            "nextDialogs": [
              "150331403"
            ]
          },
          "150331403": {
            "id": "150331403",
            "speakerId": 1003,
            "speakerName": "瓦娜娜",
            "text": "呜呜！",
            "nextDialogs": [
              "150331404"
            ]
          },
          "150331404": {
            "id": "150331404",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "哈哈，我只是要看看，没有要角力的意思。下次吧，下次吧。",
            "nextDialogs": [
              "150331405"
            ]
          },
          "150331405": {
            "id": "150331405",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "它是瓦娜娜，平时果园没人的时候，它就会守在这里，是个很靠谱，也很黏人的小家伙。",
            "nextDialogs": [
              "150331406"
            ]
          },
          "150331406": {
            "id": "150331406",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "小、小家伙吗？已经足够强壮了…",
            "nextDialogs": [
              "150331407"
            ]
          },
          "150331407": {
            "id": "150331407",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "来吧，进来，这里就是我家的果园。",
            "nextDialogs": [
              "150331408"
            ]
          },
          "150331408": {
            "id": "150331408",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，里面比想象中还要大！",
            "nextDialogs": [
              "150331409"
            ]
          },
          "150331409": {
            "id": "150331409",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "到处都是果子，看起来每个都很好吃！",
            "nextDialogs": [
              "150331410"
            ]
          },
          "150331410": {
            "id": "150331410",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "嘿嘿，我们这里叫「沃陆之邦」，有个原因就是临近火山，所以土地很肥沃，种什么都好吃。",
            "nextDialogs": [
              "150331411"
            ]
          },
          "150331411": {
            "id": "150331411",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "果子很受欢迎，我们不仅一直在往外卖，也留好多自己吃，还送亲朋好友。",
            "nextDialogs": [
              "150331412"
            ]
          },
          "150331412": {
            "id": "150331412",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "原来如此，我之前还在想怎么会有部族住在火山下面，居然还有这种好处。",
            "nextDialogs": [
              "150331413"
            ]
          },
          "150331413": {
            "id": "150331413",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "是啊。对了，既然都到这里了，我们摘点果子吃吧。",
            "nextDialogs": [
              "150331414"
            ]
          },
          "150331414": {
            "id": "150331414",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸，你不是刚吃过饭吗？",
            "nextDialogs": [
              "150331415"
            ]
          },
          "150331415": {
            "id": "150331415",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "水果是餐后甜点，不会和正餐抢位置。只是吃三五十个的话，不会有事的。",
            "nextDialogs": [
              "150331418"
            ]
          },
          "150331418": {
            "id": "150331418",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "哈哈，小的时候，我爸爸在门口的水果铺卖水果，我扯他的衣服，他就会塞给我一个果子。",
            "nextDialogs": [
              "150331419"
            ]
          },
          "150331419": {
            "id": "150331419",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "我吃得飞快，吃完又找他要一个，结果越来越多人围上来，都是来看我吃水果的。",
            "nextDialogs": [
              "150331420"
            ]
          },
          "150331420": {
            "id": "150331420",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "爸爸说，因为我吃得很香，买水果的人都变多了。我能帮上爸爸的忙，特别开心，于是吃得更多了。",
            "nextDialogs": [
              "150331421"
            ]
          },
          "150331421": {
            "id": "150331421",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "客人买完果子都会摸摸我的头，还夸我，说「这么能吃的小孩子以后一定能长得很好」。",
            "nextDialogs": [
              "150331422"
            ]
          },
          "150331422": {
            "id": "150331422",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "我就傻傻地看着他们笑，过一会儿我爸爸也开始笑，来帮忙的妈妈也笑…",
            "nextDialogs": [
              "150331423"
            ]
          },
          "150331423": {
            "id": "150331423",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好温馨的画面啊，真是羡慕。",
            "nextDialogs": [
              "150331424"
            ]
          },
          "150331424": {
            "id": "150331424",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "但总归还是因为家里种的水果很好吃，大家才愿意来照顾生意。我可不是自吹自擂哦，你们马上就会理解了。",
            "nextDialogs": [
              "150331425"
            ]
          },
          "150331425": {
            "id": "150331425",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "正好过几天会有「豪宴热斗」，我们家也会赞助很多水果当甜点的原料。",
            "nextDialogs": [
              "150331426"
            ]
          },
          "150331426": {
            "id": "150331426",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "「豪宴热斗」？",
            "nextDialogs": [
              "150331427"
            ]
          },
          "150331427": {
            "id": "150331427",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "嗯，简单来说，就是像大胃王比赛一样的活动，需要准备很多很多的食材。",
            "nextDialogs": [
              "150331428"
            ]
          },
          "150331428": {
            "id": "150331428",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "所以，放心地摘，我也会一起摘的，不用担心浪费！",
            "nextDialogs": [
              "150331429"
            ]
          },
          "150331429": {
            "id": "150331429",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "好！让我看看，从哪里开始…",
            "nextDialogs": [
              "150331430"
            ]
          },
          "150331430": {
            "id": "150331430",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸，怎么那边有…蘑菇？",
            "nextDialogs": [
              "150331431"
            ]
          },
          "150331431": {
            "id": "150331431",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "哦，这个蘑菇啊，是建果园的时候不知从哪里长出来的。",
            "nextDialogs": [
              "150331432"
            ]
          },
          "150331432": {
            "id": "150331432",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "它不用浇水也不用施肥，长得可快了，肉质肥美，味道特别好。",
            "nextDialogs": [
              "150331433"
            ]
          },
          "150331433": {
            "id": "150331433",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "不仅适合拿来炒和油煎，就连生吃都很好吃，一股水果味！",
            "nextDialogs": [
              "150331434"
            ]
          },
          "150331434": {
            "id": "150331434",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "水果味的蘑菇？没听说过啊。",
            "nextDialogs": [
              "150331435"
            ]
          },
          "150331435": {
            "id": "150331435",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "或许是吸收了周围果树的养分。",
            "nextDialogs": [
              "150331436"
            ]
          },
          "150331436": {
            "id": "150331436",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "应该是，如果吃起来像水果，那它就可以算水果，不用太在意来历啦。",
            "nextDialogs": [
              "150331437"
            ]
          },
          "150331437": {
            "id": "150331437",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "来吧，想摘多少摘多少，再摘一些蘑菇吧，等会儿一起做给你们吃！"
          }
        }
      }
    },
    {
      "subId": "1503304",
      "subQuestName": "采摘果实，准备接下来的烹饪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1503305",
      "subQuestName": "与瓦雷莎交谈",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150331501"
        ],
        "dialogs": {
          "150331501": {
            "id": "150331501",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "原来摘了这么多，真了不起！",
            "nextDialogs": [
              "150331502"
            ]
          },
          "150331502": {
            "id": "150331502",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "因为你说「豪宴热斗」需要很多原料嘛，我们可不能白吃不帮忙。",
            "nextDialogs": [
              "150331503"
            ]
          },
          "150331503": {
            "id": "150331503",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我刚刚尝过了，确实很好吃，汁水丰富，甜味充足，一定是市场里最先卖断货的果子！",
            "nextDialogs": [
              "150331504"
            ]
          },
          "150331504": {
            "id": "150331504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "蘑菇我也吃了，蘑菇原本的香味背后居然有股淡淡的果香，真不可思议。",
            "nextDialogs": [
              "150331505"
            ]
          },
          "150331505": {
            "id": "150331505",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "我就叫它「果果菇」吧！",
            "nextDialogs": [
              "150331507",
              "150331509"
            ]
          },
          "150331507": {
            "id": "150331507",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是吧，毕竟已经走过那么多地方，尝了各种各样的美食，我舌头的记性和脑袋一样好！",
            "nextDialogs": [
              "150331510"
            ]
          },
          "150331510": {
            "id": "150331510",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "谢谢你们，既然这样我也提前收工吧，说好了要给你做蘑菇吃，稍等一下。",
            "nextDialogs": [
              "150331511"
            ]
          },
          "150331511": {
            "id": "150331511",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "瓦雷莎快速烹饪了几下，热气腾腾的蘑菇菜肴便端到了你们面前。",
            "nextDialogs": [
              "150331512"
            ]
          },
          "150331512": {
            "id": "150331512",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "我手艺不太精湛，请不要在意，但只要原料足够好，简单做一做就会特别好吃。",
            "nextDialogs": [
              "150331513"
            ]
          },
          "150331513": {
            "id": "150331513",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "没有没有，闻上去超级香，蘑菇的香味浓郁了很多，感觉肯定很美味。",
            "nextDialogs": [
              "150331514"
            ]
          },
          "150331514": {
            "id": "150331514",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔，这个味道，和生吃又完全不同了！"
          },
          "150331509": {
            "id": "150331509",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "这个「有时」总感觉怪怪的…"
          }
        }
      }
    },
    {
      "subId": "1503301",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150330101"
        ],
        "dialogs": {
          "150330101": {
            "id": "150330101",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "祝你们在「沃陆之邦」过得开心，我要准备训练了。呼——"
          }
        }
      }
    },
    {
      "subId": "1503302",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150330201"
        ],
        "dialogs": {
          "150330201": {
            "id": "150330201",
            "speakerId": 1003,
            "speakerName": "瓦娜娜",
            "text": "这里是，瓦雷莎的果园。要努力保护好，不可以让很坏的人和很坏的龙进去。",
            "nextDialogs": [
              "150330202"
            ]
          },
          "150330202": {
            "id": "150330202",
            "speakerId": 1003,
            "speakerName": "瓦娜娜",
            "text": "可是，你的气息，不一样。是很好很好的朋友。所以，可以随便吃果子。吃得饱饱的，才会开心。瓦雷莎也这么说。"
          }
        }
      }
    },
    {
      "subId": "1503305",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "150330501"
        ],
        "dialogs": {
          "150330501": {
            "id": "150330501",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "欸，是伊安珊老师！听说你要参加归火圣夜巡礼，怎么回来了啊。",
            "nextDialogs": [
              "150330502"
            ]
          },
          "150330502": {
            "id": "150330502",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "哦，我临时想起有一些战斗用的消耗品快用完了，保险起见，还是回来取一趟。",
            "nextDialogs": [
              "150330503"
            ]
          },
          "150330503": {
            "id": "150330503",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "你们好，我在竞技场见过你们，就是你们在帮卡齐娜吧。",
            "nextDialogs": [
              "150330504"
            ]
          },
          "150330504": {
            "id": "150330504",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#嗯，我是派蒙，{M#他}{F#她}是{NICKNAME}！",
            "nextDialogs": [
              "150330505"
            ]
          },
          "150330505": {
            "id": "150330505",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "你们真厉害，卡齐娜一下子长进了很多，自信心也充足了不少。",
            "nextDialogs": [
              "150330506"
            ]
          },
          "150330506": {
            "id": "150330506",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "这次能夺得归火圣夜巡礼的优胜，也是她长年努力的结果，非常值得骄傲。",
            "nextDialogs": [
              "150330507"
            ]
          },
          "150330507": {
            "id": "150330507",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "麻烦你和她见面再夸夸她。",
            "nextDialogs": [
              "150330508"
            ]
          },
          "150330508": {
            "id": "150330508",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "嗯，放心吧，我知道，这对她来说很重要。",
            "nextDialogs": [
              "150330509"
            ]
          },
          "150330509": {
            "id": "150330509",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "你们来「沃陆之邦」有什么事吗？"
          }
        }
      }
    },
    {
      "subId": "1503307",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

        "dialogs": {
          "150330701": {
            "id": "150330701",
            "speakerId": 1001,
            "speakerName": "瓦雷莎",
            "text": "欸，是伊安珊老师！你正好要训练吗？",
            "nextDialogs": [
              "150330702"
            ]
          },
          "150330702": {
            "id": "150330702",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "哦不是，今天正好有时间，我想保养一下院子里的这些设备。",
            "nextDialogs": [
              "150330703"
            ]
          },
          "150330703": {
            "id": "150330703",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "你们好，又见面了啊，欢迎到我家来。",
            "nextDialogs": [
              "150330704"
            ]
          },
          "150330704": {
            "id": "150330704",
            "speakerId": 1002,
            "speakerName": "伊安珊",
            "text": "你们来「沃陆之邦」有什么事吗？"
          }
        }
      }

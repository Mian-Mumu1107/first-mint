    {
      "subId": "7612403",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761240301"
        ],
        "dialogs": {
          "761240301": {
            "id": "761240301",
            "speakerId": 1838,
            "speakerName": "妌癸",
            "text": "好嘞，结束！",
            "nextDialogs": [
              "761240302"
            ]
          },
          "761240302": {
            "id": "761240302",
            "speakerId": 1838,
            "speakerName": "妌癸",
            "text": "#多谢两位，让我开心得很。尤其是这位金发的{M#小哥}{F#小妹}，身手着实不凡，怕是比我知道的古华小子强多了。",
            "nextDialogs": [
              "761240306",
              "761240305"
            ]
          },
          "761240306": {
            "id": "761240306",
            "speakerId": 1838,
            "speakerName": "妌癸",
            "text": "拜两位所赐，我也久违地有了些感悟。鱼酱果然还是得加点剁碎的新鲜兽肉提味，否则放久了以后，腥气还是遮不住。",
            "nextDialogs": [
              "761240307"
            ]
          },
          "761240307": {
            "id": "761240307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦，原来如此原来如…咦？好像完全不挨着啊？",
            "nextDialogs": [
              "761240308"
            ]
          },
          "761240308": {
            "id": "761240308",
            "speakerId": 1838,
            "speakerName": "妌癸",
            "text": "哈哈，这种小事就别放在心上啦！等我下回让卡斯蒂廖内给我多画些鱼，我再请你们吃鱼酱吧。"
          },
          "761240305": {
            "id": "761240305",
            "speakerId": 1838,
            "speakerName": "妌癸",
            "text": "哈，不必谦虚。你的剑技很强，这我还是看得出来的。"
          }
        }
      }
    },
    {
      "subId": "7612402",

  "subQuests": [
    {
      "subId": "4019601",
      "subQuestName": "等待到两天后的上午（8点-10点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401960101"
        ],
        "dialogs": {
          "401960101": {
            "id": "401960101",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "几位好！我们没来晚吧？",
            "nextDialogs": [
              "401960102"
            ]
          },
          "401960102": {
            "id": "401960102",
            "speakerId": 1001,
            "speakerName": "那维莱特",
            "text": "不，刚刚好。休息得如何？",
            "nextDialogs": [
              "401960103"
            ]
          },
          "401960103": {
            "id": "401960103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "忙碌使人精神焕发。",
            "nextDialogs": [
              "401960104"
            ]
          },
          "401960104": {
            "id": "401960104",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "的确是保持活力的好方法。",
            "nextDialogs": [
              "401960105"
            ]
          },
          "401960105": {
            "id": "401960105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "各位已经在着手准备了吗？",
            "nextDialogs": [
              "401960106"
            ]
          },
          "401960106": {
            "id": "401960106",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "昨天从阿让托先生处得到消息，确定了交易的时间与地点。",
            "nextDialogs": [
              "401960107"
            ]
          },
          "401960107": {
            "id": "401960107",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "说起来，是大家都知道的地方呢。「今日下午，映影欢乐城餐厅见。」",
            "nextDialogs": [
              "401960108"
            ]
          },
          "401960108": {
            "id": "401960108",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "欸？他还真是对那个地方情有独钟呢！",
            "nextDialogs": [
              "401960109"
            ]
          },
          "401960109": {
            "id": "401960109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这…",
            "nextDialogs": [
              "401960110"
            ]
          },
          "401960110": {
            "id": "401960110",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "#看来{NICKNAME}和我们产生了同样的担忧。",
            "nextDialogs": [
              "401960111"
            ]
          },
          "401960111": {
            "id": "401960111",
            "speakerId": 1001,
            "speakerName": "那维莱特",
            "text": "是的，比起空旷的地段，人流量高的活动场地会给抓捕行动造成额外的困难。",
            "nextDialogs": [
              "401960112"
            ]
          },
          "401960112": {
            "id": "401960112",
            "speakerId": 1001,
            "speakerName": "那维莱特",
            "text": "犯人可能会混入人群，甚至利用人质逃脱。",
            "nextDialogs": [
              "401960113"
            ]
          },
          "401960113": {
            "id": "401960113",
            "speakerId": 1001,
            "speakerName": "那维莱特",
            "text": "为此我们需要做更多的提前准备，所以从昨天接到消息起，这边就已经开始安排逐影庭与特巡队的工作了。",
            "nextDialogs": [
              "401960114"
            ]
          },
          "401960114": {
            "id": "401960114",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "嗯，现场会安插很多便衣人员。如果事情进展不顺，我们会优先保障市民的人身安全。",
            "nextDialogs": [
              "401960115"
            ]
          },
          "401960115": {
            "id": "401960115",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "当然，还是祝我们一切顺利比较好。",
            "nextDialogs": [
              "401960116"
            ]
          },
          "401960116": {
            "id": "401960116",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "参与人员中有不少我在上起案件中见过的熟悉面孔，比如特巡队队长夏沃蕾小姐。所以，我持乐观态度哦。",
            "nextDialogs": [
              "401960117"
            ]
          },
          "401960117": {
            "id": "401960117",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "那就借纳塔的大英雄吉言了。",
            "nextDialogs": [
              "401960118"
            ]
          },
          "401960118": {
            "id": "401960118",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "哦，乐平波琳小姐和娜维娅小姐那边，我们也都进行了沟通与安排。",
            "nextDialogs": [
              "401960119"
            ]
          },
          "401960119": {
            "id": "401960119",
            "speakerId": 1001,
            "speakerName": "那维莱特",
            "text": "刺玫会会在可控范围内进行支援，不必担心。",
            "nextDialogs": [
              "401960120"
            ]
          },
          "401960120": {
            "id": "401960120",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "唯一的问题…可能就是爱可菲小姐那边吧。",
            "nextDialogs": [
              "401960122",
              "401960124"
            ]
          },
          "401960122": {
            "id": "401960122",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "哈哈，要是这样反而简单了。",
            "nextDialogs": [
              "401960125"
            ]
          },
          "401960125": {
            "id": "401960125",
            "speakerId": 1001,
            "speakerName": "那维莱特",
            "text": "咳…",
            "nextDialogs": [
              "401960126"
            ]
          },
          "401960126": {
            "id": "401960126",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "不开玩笑了。爱可菲小姐提出，希望自己的餐厅不要因为本次行动蒙受任何损失。",
            "nextDialogs": [
              "401960127"
            ]
          },
          "401960127": {
            "id": "401960127",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "哈哈…我有种预感，肯定不会如愿的。",
            "nextDialogs": [
              "401960128"
            ]
          },
          "401960128": {
            "id": "401960128",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "需要我做些什么吗？",
            "nextDialogs": [
              "401960129"
            ]
          },
          "401960129": {
            "id": "401960129",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "说实话，这件事本就与你无关，发展到这一步已经给你添了很多麻烦。剩下的应该全权交由枫丹官方处理即可。",
            "nextDialogs": [
              "401960130"
            ]
          },
          "401960130": {
            "id": "401960130",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "不过我猜，你应该也想知道事件的结局吧。",
            "nextDialogs": [
              "401960131"
            ]
          },
          "401960131": {
            "id": "401960131",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请务必。",
            "nextDialogs": [
              "401960132"
            ]
          },
          "401960132": {
            "id": "401960132",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "嗯，那就请你在现场见机行事吧。不一定需要你出手，只是以防万一。",
            "nextDialogs": [
              "401960133"
            ]
          },
          "401960133": {
            "id": "401960133",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "我会尽量不让事情发展到那一步的。",
            "nextDialogs": [
              "401960134"
            ]
          },
          "401960134": {
            "id": "401960134",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "基尼奇也要加入？",
            "nextDialogs": [
              "401960135"
            ]
          },
          "401960135": {
            "id": "401960135",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "当然。",
            "nextDialogs": [
              "401960136"
            ]
          },
          "401960136": {
            "id": "401960136",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "虽然我心中还有很多疑问，但从已有信息来看，犯人来自纳塔。",
            "nextDialogs": [
              "401960137"
            ]
          },
          "401960137": {
            "id": "401960137",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "再说，我也算是证人之一，不能放任不管。",
            "nextDialogs": [
              "401960138"
            ]
          },
          "401960138": {
            "id": "401960138",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "很有基尼奇的风范呢！",
            "nextDialogs": [
              "401960139"
            ]
          },
          "401960139": {
            "id": "401960139",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "众人又就行动细节和注意事项进行了一些讨论。",
            "nextDialogs": [
              "401960140"
            ]
          },
          "401960140": {
            "id": "401960140",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "对话难得进行得非常高效…可能是因为阿乔和咔库库都没有出现。",
            "nextDialogs": [
              "401960141"
            ]
          },
          "401960141": {
            "id": "401960141",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "转念一想，如果阿乔突然现身对那维莱特口出狂言，场面一定会很尴尬吧…"
          },
          "401960124": {
            "id": "401960124",
            "speakerId": 1003,
            "speakerName": "莱欧斯利",
            "text": "哦，你别说，是个不错的思路…"
          }
        }
      }
    },
    {
      "subId": "4019602",
      "subQuestName": "前往沫芒宫附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4019603",
      "subQuestName": "前往行动地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401960201"
        ],
        "dialogs": {
          "401960201": {
            "id": "401960201",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "几天过去，这片沙滩好像变热闹了呢！",
            "nextDialogs": [
              "401960202"
            ]
          },
          "401960202": {
            "id": "401960202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（嗯，也可能是因为其中有不少便衣警卫吧。）",
            "nextDialogs": [
              "401960203"
            ]
          },
          "401960203": {
            "id": "401960203",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，那个…",
            "nextDialogs": [
              "401960204"
            ]
          },
          "401960204": {
            "id": "401960204",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咳咳！派蒙有些饿了，我们去餐厅看看菜单吧！",
            "nextDialogs": [
              "401960205"
            ]
          },
          "401960205": {
            "id": "401960205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（拿着这个箱子的人，应该就是前来交易的家伙了吧。）",
            "nextDialogs": [
              "401960206"
            ]
          },
          "401960206": {
            "id": "401960206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（那么，接下来就是正题了。）",
            "nextDialogs": [
              "401960207"
            ]
          },
          "401960207": {
            "id": "401960207",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "可恶，就这么把人拖过来…这是轻视生命的举动！我要去审判庭告你！",
            "nextDialogs": [
              "401960208"
            ]
          },
          "401960208": {
            "id": "401960208",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "是吗。",
            "nextDialogs": [
              "401960209"
            ]
          },
          "401960209": {
            "id": "401960209",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "我倒是觉得，我好心将你从「观众」面前带走，是在维护你的面子。",
            "nextDialogs": [
              "401960210"
            ]
          },
          "401960210": {
            "id": "401960210",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "至于你在途中是头朝上还是头朝下，不是你自己的选择吗？",
            "nextDialogs": [
              "401960211"
            ]
          },
          "401960211": {
            "id": "401960211",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "你…！",
            "nextDialogs": [
              "401960212"
            ]
          },
          "401960212": {
            "id": "401960212",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "……",
            "nextDialogs": [
              "401960213"
            ]
          },
          "401960213": {
            "id": "401960213",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "好吧，好吧，我承认，是我不对。",
            "nextDialogs": [
              "401960214"
            ]
          },
          "401960214": {
            "id": "401960214",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "唉…我当然知道什么是对什么是错，但实在没办法，因为我真的很需要这笔钱。",
            "nextDialogs": [
              "401960215"
            ]
          },
          "401960215": {
            "id": "401960215",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "我本来是研究古遗迹的专家，家庭美满，工作顺利。",
            "nextDialogs": [
              "401960216"
            ]
          },
          "401960216": {
            "id": "401960216",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "但谁能想到，自己的儿子竟然被人蛊惑，陷入了赌博的泥沼…家里本来有些积蓄，但架不住钱就像瀑布一样流走…",
            "nextDialogs": [
              "401960217"
            ]
          },
          "401960217": {
            "id": "401960217",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "欠债以后，他时常遭到债主威胁恐吓，我作为亲生父亲，又怎么能眼睁睁看着他遭遇这种事呢。",
            "nextDialogs": [
              "401960218"
            ]
          },
          "401960218": {
            "id": "401960218",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "唉，我儿子就像你这般年纪，如果他也能像你一样健康成长就好了…所以我才需要钱！",
            "nextDialogs": [
              "401960219"
            ]
          },
          "401960219": {
            "id": "401960219",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "……",
            "nextDialogs": [
              "401960220"
            ]
          },
          "401960220": {
            "id": "401960220",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "你…",
            "nextDialogs": [
              "401960221"
            ]
          },
          "401960221": {
            "id": "401960221",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "求求你了，小伙子，帮帮忙吧！",
            "nextDialogs": [
              "401960222"
            ]
          },
          "401960222": {
            "id": "401960222",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "看在我们都是纳塔同胞的份上，饶我一命！",
            "nextDialogs": [
              "401960223"
            ]
          },
          "401960223": {
            "id": "401960223",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "如果我回去，还有机会管教好我那不争气的儿子。但如果我被抓，他可能只有死路一条了！",
            "nextDialogs": [
              "401960224"
            ]
          },
          "401960224": {
            "id": "401960224",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "作为家人，理应为了更好的未来一起战斗的，对吧？",
            "nextDialogs": [
              "401960225"
            ]
          },
          "401960225": {
            "id": "401960225",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "我们全家的机会都在你的手上了，求求你，高抬贵手吧！",
            "nextDialogs": [
              "401960226"
            ]
          },
          "401960226": {
            "id": "401960226",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "……",
            "nextDialogs": [
              "401960227"
            ]
          },
          "401960227": {
            "id": "401960227",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "哈哈，基尼奇，基尼奇，怎么不说话？难道心软了？",
            "nextDialogs": [
              "401960228"
            ]
          },
          "401960228": {
            "id": "401960228",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "哼。",
            "nextDialogs": [
              "401960229"
            ]
          },
          "401960229": {
            "id": "401960229",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "我不会相信你说的任何一句话。",
            "nextDialogs": [
              "401960230"
            ]
          },
          "401960230": {
            "id": "401960230",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "莱欧斯利还真是猜对了八成，你就是一个彻头彻尾的赌徒。",
            "nextDialogs": [
              "401960231"
            ]
          },
          "401960231": {
            "id": "401960231",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "呃，赌徒？我？怎么可能，都说了是我儿子…",
            "nextDialogs": [
              "401960232"
            ]
          },
          "401960232": {
            "id": "401960232",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "首先，你真的是纳塔人吗？",
            "nextDialogs": [
              "401960233"
            ]
          },
          "401960233": {
            "id": "401960233",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "如果你一直关注着那把枪的动向，应该不会连一个熟悉的面孔都认不出。",
            "nextDialogs": [
              "401960234"
            ]
          },
          "401960234": {
            "id": "401960234",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "而比起这个，说「审判庭」的时候倒是顺口得很。",
            "nextDialogs": [
              "401960235"
            ]
          },
          "401960235": {
            "id": "401960235",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "什么啊，就凭这个…",
            "nextDialogs": [
              "401960236"
            ]
          },
          "401960236": {
            "id": "401960236",
            "speakerId": 1005,
            "speakerName": "安格尔望",
            "text": "我，我可以解释的！我…我其实是从小生活在…",
            "nextDialogs": [
              "401960237"
            ]
          },
          "401960237": {
            "id": "401960237",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "啧，真是一句话都不想再听了。",
            "nextDialogs": [
              "401960238"
            ]
          },
          "401960238": {
            "id": "401960238",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "阿乔，给你一个堵别人嘴的机会，怎么样？",
            "nextDialogs": [
              "401960239"
            ]
          },
          "401960239": {
            "id": "401960239",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "哈哈哈，等你这句话好久了！",
            "nextDialogs": [
              "401960240"
            ]
          },
          "401960240": {
            "id": "401960240",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "没脸皮的老东西，吃我一拳！",
            "nextDialogs": [
              "401960241"
            ]
          },
          "401960241": {
            "id": "401960241",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "赌徒的特征之一就是谎话连篇。",
            "nextDialogs": [
              "401960242"
            ]
          },
          "401960242": {
            "id": "401960242",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "我猜你只是假扮成纳塔人的枫丹人罢了，身边也没有什么家人朋友。即便有，他们也早就因为你的不知廉耻离去了。",
            "nextDialogs": [
              "401960243"
            ]
          },
          "401960243": {
            "id": "401960243",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "当然，我也有猜错的可能。",
            "nextDialogs": [
              "401960244"
            ]
          },
          "401960244": {
            "id": "401960244",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "——但那又如何？",
            "nextDialogs": [
              "401960245"
            ]
          },
          "401960245": {
            "id": "401960245",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "我只负责抓人，既不是你的代理人，也不是你的贴心听众。",
            "nextDialogs": [
              "401960246"
            ]
          },
          "401960246": {
            "id": "401960246",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "而从你口中挖出真相，是你最喜欢的审判庭的职责。对吧？",
            "nextDialogs": [
              "401960247"
            ]
          },
          "401960247": {
            "id": "401960247",
            "speakerId": 1007,
            "speakerName": "夏沃蕾",
            "text": "没错。",
            "nextDialogs": [
              "401960248"
            ]
          },
          "401960248": {
            "id": "401960248",
            "speakerId": 1007,
            "speakerName": "夏沃蕾",
            "text": "基尼奇先生，好久不见。这名犯人就由特巡队接管了。",
            "nextDialogs": [
              "401960249"
            ]
          },
          "401960249": {
            "id": "401960249",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "啊，辛苦你们了。",
            "nextDialogs": [
              "401960250"
            ]
          },
          "401960250": {
            "id": "401960250",
            "speakerId": 1007,
            "speakerName": "夏沃蕾",
            "text": "哪里，还是要再次感谢你的鼎力协助。",
            "nextDialogs": [
              "401960251"
            ]
          },
          "401960251": {
            "id": "401960251",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "我的呢？我的呢？无礼！难道不应该向伟大圣龙表达诚挚感谢吗！",
            "nextDialogs": [
              "401960252"
            ]
          },
          "401960252": {
            "id": "401960252",
            "speakerId": 1007,
            "speakerName": "夏沃蕾",
            "text": "那好吧，谢谢你和咔库库先生的精彩演出。",
            "nextDialogs": [
              "401960253"
            ]
          },
          "401960253": {
            "id": "401960253",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "啊——什么意思啊你，站住——",
            "nextDialogs": [
              "401960254"
            ]
          },
          "401960254": {
            "id": "401960254",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "基尼奇，你还好吗？",
            "nextDialogs": [
              "401960255"
            ]
          },
          "401960255": {
            "id": "401960255",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "被一路拖行的人又不是我，放心吧。",
            "nextDialogs": [
              "401960256"
            ]
          },
          "401960256": {
            "id": "401960256",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "感觉你刚刚心情不好。",
            "nextDialogs": [
              "401960257"
            ]
          },
          "401960257": {
            "id": "401960257",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "噗噗，小小基尼奇，是想起小小小小基尼奇的事情了吧？",
            "nextDialogs": [
              "401960258"
            ]
          },
          "401960258": {
            "id": "401960258",
            "speakerId": 1006,
            "speakerName": "阿乔",
            "text": "可别哭鼻子哦！伟大圣龙要是有这么懦弱的下仆，也是会没面子的！",
            "nextDialogs": [
              "401960259"
            ]
          },
          "401960259": {
            "id": "401960259",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "什么跟什么…",
            "nextDialogs": [
              "401960260"
            ]
          },
          "401960260": {
            "id": "401960260",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "阿乔，坏。",
            "nextDialogs": [
              "401960261"
            ]
          },
          "401960261": {
            "id": "401960261",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "也没有瞒你的必要，简单来讲，我确实很讨厌赌徒。",
            "nextDialogs": [
              "401960262"
            ]
          },
          "401960262": {
            "id": "401960262",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "他们是世界上最没有责任心，最不尊重付出与回报的人。",
            "nextDialogs": [
              "401960263"
            ]
          },
          "401960263": {
            "id": "401960263",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "为了一枚硬币，他们可以编出千万个谎言，再妄图通过这枚硬币，赌出千万的财富。",
            "nextDialogs": [
              "401960264"
            ]
          },
          "401960264": {
            "id": "401960264",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "但我们都清楚，凭空得到的东西，背后总暗藏着无法想象的代价。",
            "nextDialogs": [
              "401960265"
            ]
          },
          "401960265": {
            "id": "401960265",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "我从前的生活已经是我父亲赌输代价的一部分了。如果可以，我不希望有其他人陷入类似的境遇。",
            "nextDialogs": [
              "401960266"
            ]
          },
          "401960266": {
            "id": "401960266",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "基尼奇…",
            "nextDialogs": [
              "401960267"
            ]
          },
          "401960267": {
            "id": "401960267",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "不用为我难过，我自己也并不觉得难过。",
            "nextDialogs": [
              "401960268"
            ]
          },
          "401960268": {
            "id": "401960268",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "都说人是由过去组成。而既然我能走到现在这一步，那说明我一定做对了很多很多事情。",
            "nextDialogs": [
              "401960269"
            ]
          },
          "401960269": {
            "id": "401960269",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "不要因他人的过失惩戒自己。",
            "nextDialogs": [
              "401960270"
            ]
          },
          "401960270": {
            "id": "401960270",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "我的话，会选择记得那些让我成长的瞬间。",
            "nextDialogs": [
              "401960271"
            ]
          },
          "401960271": {
            "id": "401960271",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "就像我第一次学会使用钩索——",
            "nextDialogs": [
              "401960272"
            ]
          },
          "401960272": {
            "id": "401960272",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "第一次渴求知识的时候。",
            "nextDialogs": [
              "401960273"
            ]
          },
          "401960273": {
            "id": "401960273",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我明白了。",
            "nextDialogs": [
              "401960274"
            ]
          },
          "401960274": {
            "id": "401960274",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "嗯，我相信你。",
            "nextDialogs": [
              "401960275"
            ]
          },
          "401960275": {
            "id": "401960275",
            "speakerId": 1002,
            "speakerName": "基尼奇",
            "text": "走吧。再不回去，会有更多人产生不必要的担心。"
          }
        }
      }
    },
    {
      "subId": "4019604",
      "subQuestName": "与基尼奇一同返回",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401960301"
        ],
        "dialogs": {
          "401960301": {
            "id": "401960301",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#喔，{NICKNAME}，基尼奇，你们回来啦！",
            "nextDialogs": [
              "401960302"
            ]
          },
          "401960302": {
            "id": "401960302",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "刚刚看夏沃蕾带着犯人离开了，好像心情不错的样子呢。",
            "nextDialogs": [
              "401960305"
            ]
          },
          "401960305": {
            "id": "401960305",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，让我们绕了好大的圈子，结果也只是一个没什么战斗力，只会逃跑的家伙嘛！",
            "nextDialogs": [
              "401960306"
            ]
          },
          "401960306": {
            "id": "401960306",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哦对了，莱欧斯利让我告诉你们，他已经去沫芒宫汇报结果了。",
            "nextDialogs": [
              "401960307"
            ]
          },
          "401960307": {
            "id": "401960307",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "他说接下来，逐影庭将深入调查灰色赌博产业，有得忙了。",
            "nextDialogs": [
              "401960308"
            ]
          },
          "401960308": {
            "id": "401960308",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "但无论如何，那些都是沫芒宫的工作，和我们关系不大啦。",
            "nextDialogs": [
              "401960309"
            ]
          },
          "401960309": {
            "id": "401960309",
            "speakerId": 1008,
            "speakerName": "夏洛蒂",
            "text": "我看这位公爵大人跑得这么快，是为了躲避记者的镜头吧！",
            "nextDialogs": [
              "401960310"
            ]
          },
          "401960310": {
            "id": "401960310",
            "speakerId": 1008,
            "speakerName": "夏洛蒂",
            "text": "哎，不过也习惯了。",
            "nextDialogs": [
              "401960311"
            ]
          },
          "401960311": {
            "id": "401960311",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "竟然这么轻易地放弃了！",
            "nextDialogs": [
              "401960312"
            ]
          },
          "401960312": {
            "id": "401960312",
            "speakerId": 1008,
            "speakerName": "夏洛蒂",
            "text": "哼哼，反正刚刚已经拍到了超多精彩瞬间，足够我出一篇头条新闻了！",
            "nextDialogs": [
              "401960313"
            ]
          },
          "401960313": {
            "id": "401960313",
            "speakerId": 1008,
            "speakerName": "夏洛蒂",
            "text": "所以说，由于公务缠身，忙碌的记者先行告退，回去冲洗画片啦！",
            "nextDialogs": [
              "401960314"
            ]
          },
          "401960314": {
            "id": "401960314",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "要给派蒙选最帅的角度哦！",
            "nextDialogs": [
              "401960315"
            ]
          },
          "401960315": {
            "id": "401960315",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "啊，跑得好快，希望她听到了…",
            "nextDialogs": [
              "401960316"
            ]
          },
          "401960316": {
            "id": "401960316",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "相信专业摄影师的审美吧。",
            "nextDialogs": [
              "401960317"
            ]
          },
          "401960317": {
            "id": "401960317",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嘿嘿，也是哦！",
            "nextDialogs": [
              "401960318"
            ]
          },
          "401960318": {
            "id": "401960318",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "不过刚刚你们怎么花了这么久才过来，是遇到什么问题了吗？"
          }
        }
      }
    },
    {
      "subId": "4019699",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "401969901"
        ],
        "dialogs": {
          "401969901": {
            "id": "401969901",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，那维莱特一早派人来联系我们了呢！",
            "nextDialogs": [
              "401969902"
            ]
          },
          "401969902": {
            "id": "401969902",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "一定是事情有了进展，事不宜迟，我们出发吧！"
          }
        }
      }
    }
  ]
}
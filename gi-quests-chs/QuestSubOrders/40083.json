    {
      "subId": "4008318",
      "subQuestName": "拍摄摊位，留取证据",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400831801"
        ],
        "dialogs": {
          "400831801": {
            "id": "400831801",
            "speakerId": 12860,
            "speakerName": "雪怪伯",
            "text": "怎么可能…我竟如此不堪一击…",
            "nextDialogs": [
              "400831802"
            ]
          },
          "400831802": {
            "id": "400831802",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼，赢得也不算轻松呢…辛苦你和伙伴们啦，「咚咚小圆帽」！"
          }
        }
      }
    },
    {
      "subId": "4008319",
      "subQuestName": "与海妮耶对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400831901"
        ],
        "dialogs": {
          "400831901": {
            "id": "400831901",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "找出「花花琼脂」的配方笔记，并对笔记和实物拍照取证后，收好了线索…",
            "nextDialogs": [
              "400831902"
            ]
          },
          "400831902": {
            "id": "400831902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完成了！接下来我们应该找个专业人士来分析这些东西…不过时间好像有点紧，还是先去帮莱依拉买东西吧？",
            "nextDialogs": [
              "400831903"
            ]
          },
          "400831903": {
            "id": "400831903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "海海海，海妮耶？",
            "nextDialogs": [
              "400831904"
            ]
          },
          "400831904": {
            "id": "400831904",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "你们对自己的要求倒也挺严苛的，这么早就来培养蕈兽。难怪能一路顺利晋级。",
            "nextDialogs": [
              "400831905"
            ]
          },
          "400831905": {
            "id": "400831905",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "海妮耶，上次我们还没说完呢！你的想法太激进了…",
            "nextDialogs": [
              "400831906"
            ]
          },
          "400831906": {
            "id": "400831906",
            "speakerId": 12855,
            "speakerName": "海妮耶",
            "text": "无需多言，如果你们认为我错了，就先击败我，再向我展示你们所谓正确的观点。",
            "nextDialogs": [
              "400831907"
            ]
          },
          "400831907": {
            "id": "400831907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完全听不进我们的话…明明刚见面时的关系还不错的，怎么就变成了这个样子！",
            "nextDialogs": [
              "400831910"
            ]
          },
          "400831910": {
            "id": "400831910",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，好吧…「咚咚小圆帽」，我们也没工夫难过了。"
          }
        }
      }
    },
    {
      "subId": "4008309",
      "subQuestName": "寻找「全能商人」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400830901"
        ],
        "dialogs": {
          "400830901": {
            "id": "400830901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "根据莱依拉的纸条，应该要在这里和「全能商人」碰头…",
            "nextDialogs": [
              "400830902"
            ]
          },
          "400830902": {
            "id": "400830902",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "看你们东张西望的神态，大概是在找「全能商人」吧？那就欢迎光临啦！",
            "nextDialogs": [
              "400830903"
            ]
          },
          "400830903": {
            "id": "400830903",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对啊对啊，你很懂嘛…",
            "nextDialogs": [
              "400830904"
            ]
          },
          "400830904": {
            "id": "400830904",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不对，怎么是多莉？莱依拉说的「全能商人」原来就是你！",
            "nextDialogs": [
              "400830905"
            ]
          },
          "400830905": {
            "id": "400830905",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "有什么好奇怪的？「桑歌玛哈巴依老爷的商品种类最多最神奇」，这是全大巴扎的老板和客人都知道的事哦。",
            "nextDialogs": [
              "400830906"
            ]
          },
          "400830906": {
            "id": "400830906",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "「万能」「全能」「大能」和不管什么能…都是我多莉的专属招牌。别的商人想用都免谈，除非先付几百万授权费！",
            "nextDialogs": [
              "400830907"
            ]
          },
          "400830907": {
            "id": "400830907",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呃，我们早该想到的…",
            "nextDialogs": [
              "400830908"
            ]
          },
          "400830908": {
            "id": "400830908",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "话说回来，莱依拉居然找你们跑腿了？看来她真的沉迷在驯兽师大赛里了啊。",
            "nextDialogs": [
              "400830909"
            ]
          },
          "400830909": {
            "id": "400830909",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来你和莱依拉的关系还挺好的，对她的情况很了解嘛。",
            "nextDialogs": [
              "400830910"
            ]
          },
          "400830910": {
            "id": "400830910",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "嘿！这和关系好坏无关。莱依拉在我这里买过一些东西，虽然不算特别贵重，但对于一个学员来说，也算是出手阔绰了。",
            "nextDialogs": [
              "400830911"
            ]
          },
          "400830911": {
            "id": "400830911",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "我当然会留意她的动向，知道她参加了可疑的比赛！",
            "nextDialogs": [
              "400830914"
            ]
          },
          "400830914": {
            "id": "400830914",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "嗯哼，我只是隐隐觉得不对劲罢了。正好我这里有些卖不出去的烫手货，屯着也是生锈，不如交给你们。",
            "nextDialogs": [
              "400830915"
            ]
          },
          "400830915": {
            "id": "400830915",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔…看起来只是一些零件和残缺的笔记？",
            "nextDialogs": [
              "400830916"
            ]
          },
          "400830916": {
            "id": "400830916",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "听说是大赛主办方试图销毁的仪器和文件。",
            "nextDialogs": [
              "400830917"
            ]
          },
          "400830917": {
            "id": "400830917",
            "speakerId": 1055,
            "speakerName": "多莉",
            "text": "他们太大意了，有些人拾荒发财的意愿可是很强的！这些东西都被打捞上来转手给了我。",
            "nextDialogs": [
              "400830918"
            ]
          },
          "400830918": {
            "id": "400830918",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "仔细看，这些文件上有些词汇跟「花花琼脂」的配方很像呢。仪器残骸也和「意智宝珠」的一些地方有相似之处。",
            "nextDialogs": [
              "400830919"
            ]
          },
          "400830919": {
            "id": "400830919",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说不定是用来实验的产品。先收起来吧，到时候让神子看看，也许她能找到不对劲的地方？"
          }
        }
      }
    },

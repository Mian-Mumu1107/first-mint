    {
      "subId": "4008313",
      "subQuestName": "与莱依拉对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400831301"
        ],
        "dialogs": {
          "400831301": {
            "id": "400831301",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "#{NICKNAME}，派蒙。我在赛程上看见你们顺利晋级了，恭喜你们！",
            "nextDialogs": [
              "400831302"
            ]
          },
          "400831302": {
            "id": "400831302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哦哦！莱依拉，今天你很有精神嘛，「转转悠悠兽」也开开心心，看来也打了个大胜仗！",
            "nextDialogs": [
              "400831303"
            ]
          },
          "400831303": {
            "id": "400831303",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "这次我赢得很惊险，只是勉强赢过对手一线，还好之前有和八重小姐一起去闭关训练。",
            "nextDialogs": [
              "400831304"
            ]
          },
          "400831304": {
            "id": "400831304",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "刚刚「全能商人」托人把我要的东西送过来了，由衷感谢你们！待会儿我就带着「转转悠悠兽」去调整状态…",
            "nextDialogs": [
              "400831305"
            ]
          },
          "400831305": {
            "id": "400831305",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "呃咳咳…力气不够了…我们还是压低音量吧。",
            "nextDialogs": [
              "400831306"
            ]
          },
          "400831306": {
            "id": "400831306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说起来，怎么没有看见神子？",
            "nextDialogs": [
              "400831307"
            ]
          },
          "400831307": {
            "id": "400831307",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "八重小姐好像有什么急事，和左右加小姐他们先走了。好像还有一位「三十人团」的佣兵在给他们领路…",
            "nextDialogs": [
              "400831308"
            ]
          },
          "400831308": {
            "id": "400831308",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "我回到赛场的时候，他们已经走远了，追上去问话好像有点唐突…",
            "nextDialogs": [
              "400831311"
            ]
          },
          "400831311": {
            "id": "400831311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "也对哦，这段时间神子一直在比赛，偶尔去处理一下主编大人的工作也很正常吧。",
            "nextDialogs": [
              "400831312"
            ]
          },
          "400831312": {
            "id": "400831312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "而且神子说过，她想一边度假一边取材，说不定那个佣兵就是他们的导游呢，我们也不用担心啦！",
            "nextDialogs": [
              "400831313"
            ]
          },
          "400831313": {
            "id": "400831313",
            "speakerId": 1063,
            "speakerName": "莱依拉",
            "text": "嗯，接下来就是八强赛了，最关键的一场比赛…虽然有点害怕，但我们还是一起努力吧！",
            "nextDialogs": [
              "400831314"
            ]
          },
          "400831314": {
            "id": "400831314",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好！这样看下来，我们晋级还蛮顺利的嘛，莱依拉一定要加油！"
          }
        }
      }

    {
      "subId": "4008302",
      "subQuestName": "击败对手",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400831501"
        ],
        "dialogs": {
          "400831501": {
            "id": "400831501",
            "speakerId": 12859,
            "speakerName": "左右加",
            "text": "两位，没想到这么早就要和你们对决了。",
            "nextDialogs": [
              "400831502"
            ]
          },
          "400831502": {
            "id": "400831502",
            "speakerId": 12859,
            "speakerName": "左右加",
            "text": "对不起，为了我的小说生涯和八重大人的认可，我要打败你们！",
            "nextDialogs": [
              "400831503"
            ]
          },
          "400831503": {
            "id": "400831503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "拿出全力来吧！",
            "nextDialogs": [
              "400831504"
            ]
          },
          "400831504": {
            "id": "400831504",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "别太自信哦，左右加小姐，我们也不会手下留情的！"
          }
        }
      }
    },
    {
      "subId": "4008304",
      "subQuestName": "击败对手",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "4008316",
      "subQuestName": "与对手对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400831701"
        ],
        "dialogs": {
          "400831701": {
            "id": "400831701",
            "speakerId": 12859,
            "speakerName": "左右加",
            "text": "为什么，完全赢不了啊，呜…",
            "nextDialogs": [
              "400831702"
            ]
          },
          "400831702": {
            "id": "400831702",
            "speakerId": 12859,
            "speakerName": "左右加",
            "text": "果然，「天守阁的座上宾」所具备的天赋和实力，不是我这种凡人可以企及的。",
            "nextDialogs": [
              "400831703"
            ]
          },
          "400831703": {
            "id": "400831703",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么办，左右加小姐受到的打击不是一般的大呢…神子说得倒是轻松，看见她这个样子，还是会生气的吧。",
            "nextDialogs": [
              "400831704"
            ]
          },
          "400831704": {
            "id": "400831704",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我心里慌慌的，感觉很不安！我们还是先去向神子道歉吧。「咚咚小圆帽」也要拿出诚意来哦。"
          }
        }
      }
    },
    {
      "subId": "4008314",
      "subQuestName": "离开赛场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400831401"
        ],
        "dialogs": {
          "400831401": {
            "id": "400831401",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看起来都是很普通的「花花琼脂」而已，毕竟是能展示给所有人看的东西，就连配方都摆在桌上了。",
            "nextDialogs": [
              "400831404"
            ]
          },
          "400831404": {
            "id": "400831404",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "那我们也没法把它们拿去调查啊，这算是偷盗了吧，会让我们丢掉比赛资格的，搞不好还要被「三十人团」抓起来。",
            "nextDialogs": [
              "400831405"
            ]
          },
          "400831405": {
            "id": "400831405",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "对了，我们有留影机！不如给这些「花花琼脂」的实物和配方拍照，这样就能记录很多重要的信息了。"
          }
        }
      }
    },
    {
      "subId": "4008305",
      "subQuestName": "与八重神子对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "400830501"
        ],
        "dialogs": {
          "400830501": {
            "id": "400830501",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "神子！对不起！我们没想到「咚咚小圆帽」噼里啪啦一顿打，就把左右加小姐给淘汰了…",
            "nextDialogs": [
              "400830504"
            ]
          },
          "400830504": {
            "id": "400830504",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "哦？左右加是不是非常气馁，念叨着「凡人没法企及」之类的夸张说辞？蹲在地上哀嚎？",
            "nextDialogs": [
              "400830505"
            ]
          },
          "400830505": {
            "id": "400830505",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "完全一致呢，你还真是了解她…",
            "nextDialogs": [
              "400830506"
            ]
          },
          "400830506": {
            "id": "400830506",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "这样反而更好，左右加会把这次打击当成宝贵的素材，生动地描写出主角成长过程中所受的挫折，牵动读者们的心。",
            "nextDialogs": [
              "400830507"
            ]
          },
          "400830507": {
            "id": "400830507",
            "speakerId": 1034,
            "speakerName": "八重神子",
            "text": "至于展现反派的压迫力，和精彩的夺冠过程，就要从你们身上取材啦。可别在我这个半吊子选手之前被淘汰哦。"
          }
        }
      }
    },

        "dialogs": {
          "411470301": {
            "id": "411470301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "听说有特别订单…",
            "nextDialogs": [
              "411470302"
            ]
          },
          "411470302": {
            "id": "411470302",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "嗯，确实一份。廷方那个…客人，在我这里订了一份水煮黑背鲈。",
            "nextDialogs": [
              "411470303"
            ]
          },
          "411470303": {
            "id": "411470303",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "然后他说，晚点时候再把餐送到地中之盐的一个地方…",
            "nextDialogs": [
              "411470304"
            ]
          },
          "411470304": {
            "id": "411470304",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "你要是愿意，就帮我跑个腿吧，报酬少不了你的。"
          }
        }
      }
    },

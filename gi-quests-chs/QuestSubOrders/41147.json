            "id": "411470201",
            "speakerId": 30028,
            "speakerName": "寡言的廷方",
            "text": "那厨子怎么还没把餐送来…"
          }
        }
      }
    },
    {
      "subId": "4114703",
      "subQuestName": "与寡言的廷方对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {

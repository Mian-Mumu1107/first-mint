    {
      "subId": "4114701",
      "subQuestName": "与言笑对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411470101"
        ],
        "dialogs": {
          "411470101": {
            "id": "411470101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我这就送过去。",
            "nextDialogs": [
              "411470102"
            ]
          },
          "411470102": {
            "id": "411470102",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "哦唷，这么爽快，那你赶紧送过去吧。",
            "nextDialogs": [
              "411470103"
            ]
          },
          "411470103": {
            "id": "411470103",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "对了，你送的时候<color=#00E1FFFF>别乱跑，见到危险情况也绕着走别被撞了</color>。要是汤弄洒了的话，客人肯定是不会收的。",
            "nextDialogs": [
              "411470104"
            ]
          },
          "411470104": {
            "id": "411470104",
            "speakerId": 2204,
            "speakerName": "言笑",
            "text": "那个人口味又刁钻的很，也不知道是谁养的…"
          }
        }
      }
    },
    {
      "subId": "4114702",
      "subQuestName": "将餐品送给寡言的廷方",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411470201"
        ],
        "dialogs": {

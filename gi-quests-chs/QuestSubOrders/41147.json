        ],
        "dialogs": {
          "411470601": {
            "id": "411470601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是您订的餐。",
            "nextDialogs": [
              "411470602"
            ]
          },
          "411470602": {
            "id": "411470602",
            "speakerId": 30028,
            "speakerName": "寡言的廷方",
            "text": "多谢。",
            "nextDialogs": [
              "411470603"
            ]
          },
          "411470603": {
            "id": "411470603",
            "speakerId": 30028,
            "speakerName": "寡言的廷方",
            "text": "……",
            "nextDialogs": [
              "411470604"
            ]
          },
          "411470604": {
            "id": "411470604",
            "speakerId": 30028,
            "speakerName": "寡言的廷方",
            "text": "那厨子的手艺，不错。"
          }
        }

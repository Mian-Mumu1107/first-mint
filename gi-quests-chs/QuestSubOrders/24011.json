  "subQuests": [
    {
      "subId": "2401101",
      "subQuestName": "与艾尤恩对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240111401"
        ],
        "dialogs": {
          "240111401": {
            "id": "240111401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我会把它们全部赶走的。",
            "nextDialogs": [
              "240111402"
            ]
          },
          "240111402": {
            "id": "240111402",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "行，但你能…尽量只是把紫金渔鸥们赶走吗？它们就是想吃点薯条，没什么其他的恶意。",
            "nextDialogs": [
              "240111403"
            ]
          },
          "240111403": {
            "id": "240111403",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "好吧，这对我来说还挺有恶意的，但也并不是什么大事，所以…拜托你了，只把它们赶走就行。"
          }
        }
      }
    },

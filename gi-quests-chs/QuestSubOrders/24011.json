    {
      "subId": "2401104",
      "subQuestName": "向艾尤恩回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "240111101"
        ],
        "dialogs": {
          "240111101": {
            "id": "240111101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你养一只狗试试？",
            "nextDialogs": [
              "240111102"
            ]
          },
          "240111102": {
            "id": "240111102",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "你的意思是…让我用狗来驱散那群紫金渔鸥？",
            "nextDialogs": [
              "240111103"
            ]
          },
          "240111103": {
            "id": "240111103",
            "speakerId": 1000,
            "speakerName": "艾尤恩",
            "text": "这想法倒是不错，我也许能找人借一只…"
          }
        }
      }
    },

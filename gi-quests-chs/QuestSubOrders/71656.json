          "716560101": {
            "id": "716560101",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "向着星辰与深渊！感谢你的到来，冒险家。",
            "nextDialogs": [
              "716560103",
              "716560105"
            ]
          },
          "716560103": {
            "id": "716560103",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "是的，我们准备展开新一轮的生态调查。",
            "nextDialogs": [
              "716560106"
            ]
          },
          "716560106": {
            "id": "716560106",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "总之，还是由我先解释一下情况吧。",
            "nextDialogs": [
              "716560107"
            ]
          },
          "716560107": {
            "id": "716560107",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "近些日子，有关「飘浮灵」的目击报告激增，状况很不寻常。",
            "nextDialogs": [
              "716560108"
            ]
          },
          "716560108": {
            "id": "716560108",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "这本来是一种很少见的元素生物，它们突然大量出现，背后多半有什么原因。",
            "nextDialogs": [
              "716560109"
            ]
          },
          "716560109": {
            "id": "716560109",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "由于对这种生物了解甚少，冒险家协会正在组织全方位的调查行动。"
          },
          "716560105": {
            "id": "716560105",
            "speakerId": 1000,
            "speakerName": "凯瑟琳",
            "text": "欸？以前你处理过这样的委托吗？那太好了。"
          }
        }
      }
    }
  ]

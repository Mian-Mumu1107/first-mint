    {
      "subId": "7352702",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735270201"
        ],
        "dialogs": {
          "735270201": {
            "id": "735270201",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "两位顾客，现在就玩玩「飞迸湍流大作战」吗？",
            "nextDialogs": [
              "735270203",
              "735270205",
              "735270229",
              "735270233",
              "735270266"
            ]
          },
          "735270203": {
            "id": "735270203",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "没问题！请尽情享受这个新奇的游乐项目吧！"
          },
          "735270205": {
            "id": "735270205",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "没错！我们可以把自己想象成…战舰上的炮手！用大炮去轰击各种海上的目标…",
            "nextDialogs": [
              "735270206"
            ]
          },
          "735270206": {
            "id": "735270206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "不过，这么说来，战舰上的炮手难道也要在很短的时间内瞄准…上上下下好多目标吗？那还真是辛苦呢！",
            "nextDialogs": [
              "735270207"
            ]
          },
          "735270207": {
            "id": "735270207",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "正是如此，你们理解了这台装置最初的设计目的！",
            "nextDialogs": [
              "735270208"
            ]
          },
          "735270208": {
            "id": "735270208",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "炮弹飞出去的轨迹不是一条直线，打击远处的目标时，炮手们也需要抬高炮口…",
            "nextDialogs": [
              "735270209"
            ]
          },
          "735270209": {
            "id": "735270209",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "而且船舶在海上航行的时候，会随着波浪不停摇晃，炮手也要适应船舶摇晃的节奏，上下调整大炮的角度。",
            "nextDialogs": [
              "735270210"
            ]
          },
          "735270210": {
            "id": "735270210",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "综合以上原因，炮手需要好好锻炼垂直空间上的瞄准能力，才能应对各种作战需求。",
            "nextDialogs": [
              "735270211"
            ]
          },
          "735270211": {
            "id": "735270211",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "当然，打击高速目标时所需要的提前量，也是必修科目。炮弹飞行的速度越慢，对炮手的预估能力要求越高。",
            "nextDialogs": [
              "735270212"
            ]
          },
          "735270212": {
            "id": "735270212",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "所以我才开发出了「鳄型涡流聚引原理鳄式外甲海战用重型舰炮式训练水球发射炮」，它的射弹速度和每发弹药的成本都很低。",
            "nextDialogs": [
              "735270213"
            ]
          },
          "735270213": {
            "id": "735270213",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "将这种水炮布置在不停摇晃的浮动平台上，配合气球靶标，就能更好地训练炮手的能力，强化整支舰队的作战能力。"
          },
          "735270229": {
            "id": "735270229",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "太好了，看来你们已经被这个游乐项目吸引了！",
            "nextDialogs": [
              "735270230"
            ]
          },
          "735270230": {
            "id": "735270230",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "因为设计这个项目的原则是开心就好，所以目前没有特别困难的关卡…",
            "nextDialogs": [
              "735270231"
            ]
          },
          "735270231": {
            "id": "735270231",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "假如你们玩得非常熟练，慢慢感觉这个项目的挑战性不够了，也请别心急，我会争取尽早做出新的关卡！"
          },
          "735270233": {
            "id": "735270233",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦，我开始好奇沙蒂永先生以前的经历了…为什么会想到用水炮来做娱乐项目呢？",
            "nextDialogs": [
              "735270234"
            ]
          },
          "735270234": {
            "id": "735270234",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "哦！原因很简单啊，因为我以前的工作和大炮有关！",
            "nextDialogs": [
              "735270235"
            ]
          },
          "735270235": {
            "id": "735270235",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "很久以前，我曾在枫丹的舰队担任武器工程师，我的妻子和女儿都是出色的炮手，在舰队的主力战舰上服役…",
            "nextDialogs": [
              "735270236"
            ]
          },
          "735270236": {
            "id": "735270236",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "可以说，我们一家子都对大炮很熟悉！",
            "nextDialogs": [
              "735270237"
            ]
          },
          "735270237": {
            "id": "735270237",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "我的妻子和女儿经常向我反馈一线水手的意见，托她们的福，我成为了比较出色的工程师，参与了一些厉害的项目。",
            "nextDialogs": [
              "735270238"
            ]
          },
          "735270238": {
            "id": "735270238",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "为了试验新的武器装备，我经常出差。正好，沙漠里有很多空旷的地方，很适合测试大炮和炸弹，所以我成了沙漠的常客。",
            "nextDialogs": [
              "735270239"
            ]
          },
          "735270239": {
            "id": "735270239",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "只不过，在一次实验中，我们没有把炮弹和引信分离存放，导致了严重的殉爆事故…",
            "nextDialogs": [
              "735270240"
            ]
          },
          "735270240": {
            "id": "735270240",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "我们的团队伤亡惨重，我走了大运才没有当场死掉，但也被炸飞到了很远以外，在一个陌生的地方昏迷了好几天！",
            "nextDialogs": [
              "735270241"
            ]
          },
          "735270241": {
            "id": "735270241",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这！这也太恐怖了！"
          },
          "735270266": {
            "id": "735270266",
            "speakerId": 1003,
            "speakerName": "沙蒂永",
            "text": "嗯，看来你们很忙，可以理解！我随时在这里等着你们！"
          }
        }
      }
    },

    {
      "subId": "7352602",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735260201"
        ],
        "dialogs": {
          "735260201": {
            "id": "735260201",
            "speakerId": 1002,
            "speakerName": "玛蒂哈",
            "text": "我最重要的合作方，你们回来了！我等不及要问你们了——「吼吼小狐」的操作手感如何？飞行包线有够宽广吗？",
            "nextDialogs": [
              "735260203",
              "735260233",
              "735260243",
              "735260266"
            ]
          },
          "735260203": {
            "id": "735260203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「吼吼小狐」操作起来不算很难，我们玩得挺开心的，但你说的那些…专业术语，我们不知道该怎么回答啦！",
            "nextDialogs": [
              "735260204"
            ]
          },
          "735260204": {
            "id": "735260204",
            "speakerId": 1002,
            "speakerName": "玛蒂哈",
            "text": "嗯，你们两位的回答属于「用户无法以准确描述反馈」的范畴，很常见！但问题也不大！",
            "nextDialogs": [
              "735260205"
            ]
          },
          "735260205": {
            "id": "735260205",
            "speakerId": 1002,
            "speakerName": "玛蒂哈",
            "text": "不管经过几次尝试，只要你们在不私自改造「吼吼小狐」的情况下完成了测试挑战，就说明它的飞行性能达到了预期！",
            "nextDialogs": [
              "735260206"
            ]
          },
          "735260206": {
            "id": "735260206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "私自改造？",
            "nextDialogs": [
              "735260207"
            ]
          },
          "735260207": {
            "id": "735260207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#这个词听起来好复杂！{NICKNAME}也不懂这种事吧！"
          },
          "735260233": {
            "id": "735260233",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "咦？真的吗？我倒是没什么感觉…",
            "nextDialogs": [
              "735260234"
            ]
          },
          "735260234": {
            "id": "735260234",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#看来{NICKNAME}帮太多人测试过新发明，评价这些东西的标准慢慢变得严格了！",
            "nextDialogs": [
              "735260235"
            ]
          },
          "735260235": {
            "id": "735260235",
            "speakerId": 1002,
            "speakerName": "玛蒂哈",
            "text": "居然是负面反馈！能请你说说具体是哪里不太行吗？"
          },
          "735260243": {
            "id": "735260243",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦，既然你都自称「幻之玩具王」了，那应该有很厉害的…呃…设计经验？是这么说的吗？",
            "nextDialogs": [
              "735260244"
            ]
          },
          "735260244": {
            "id": "735260244",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且你好像很懂…投资？总之是大笔大笔摩拉的事！以前一定赚到过很多钱吧！",
            "nextDialogs": [
              "735260245"
            ]
          },
          "735260245": {
            "id": "735260245",
            "speakerId": 1002,
            "speakerName": "玛蒂哈",
            "text": "唔！呃！啊！",
            "nextDialogs": [
              "735260246"
            ]
          },
          "735260246": {
            "id": "735260246",
            "speakerId": 1002,
            "speakerName": "玛蒂哈",
            "text": "精…精神攻击！",
            "nextDialogs": [
              "735260247"
            ]
          },
          "735260247": {
            "id": "735260247",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么回事！你怎么突然一副痛苦的样子，好像快要死掉了！",
            "nextDialogs": [
              "735260248"
            ]
          },
          "735260248": {
            "id": "735260248",
            "speakerId": 1002,
            "speakerName": "玛蒂哈",
            "text": "不，我是不会心痛至死的！我的死法起码得是…成为超级大富豪后，在奢靡的生活中放纵过度而死！",
            "nextDialogs": [
              "735260249"
            ]
          },
          "735260249": {
            "id": "735260249",
            "speakerId": 1002,
            "speakerName": "玛蒂哈",
            "text": "除了错过商机的后悔感，我已经刀枪不入了！我可是…在沙漠里徒步行走三个月都安然无恙哦！",
            "nextDialogs": [
              "735260250"
            ]
          },
          "735260250": {
            "id": "735260250",
            "speakerId": 1002,
            "speakerName": "玛蒂哈",
            "text": "那些因为我暂时无法兑现回报，追着我要钱，逼着我逃进沙漠的家伙，是不会明白的！我的奇思妙想总有一天会变现成摩拉！"
          },
          "735260266": {
            "id": "735260266",
            "speakerId": 1002,
            "speakerName": "玛蒂哈",
            "text": "咦！难道你们还没玩够吗？那说明操作「吼吼小狐」飞行这件事很有乐趣…太好了，我的设计目的实现了！"
          }
        }
      }
    },

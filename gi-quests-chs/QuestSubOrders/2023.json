    {
      "subId": "7352902",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "735290201"
        ],
        "dialogs": {
          "735290201": {
            "id": "735290201",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "两位，你们身上的气息发生了些许变化，似乎能从中寻觅出…昭示战绩的自信，说明你们的剑舞演出极为顺利。",
            "nextDialogs": [
              "735290203",
              "735290205",
              "735290220",
              "735290233"
            ]
          },
          "735290203": {
            "id": "735290203",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "真是豪气万丈！那就请你们继续在战斗中起舞吧！"
          },
          "735290205": {
            "id": "735290205",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "那也无妨！",
            "nextDialogs": [
              "735290206"
            ]
          },
          "735290206": {
            "id": "735290206",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "在开始剑舞之前，你们的气势就在不断攀升，那战胜敌人后，会有多强的威压，我完全无法想象！",
            "nextDialogs": [
              "735290207"
            ]
          },
          "735290207": {
            "id": "735290207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "威压这个词未免有些夸张了啦…我们不会用武力恐吓别人…除非是…警告一些坏家伙别再做错事！",
            "nextDialogs": [
              "735290208"
            ]
          },
          "735290208": {
            "id": "735290208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#不管变得多强，{NICKNAME}一定都会和以前一样——和和气气，高高兴兴，超级耐心，还很有童趣！",
            "nextDialogs": [
              "735290209"
            ]
          },
          "735290209": {
            "id": "735290209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "除了你以外，几乎没什么人说过，从我们身上感觉到了…气势、威势之类的东西！",
            "nextDialogs": [
              "735290210"
            ]
          },
          "735290210": {
            "id": "735290210",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "竟是如此！我太肤浅了！我记得，我曾在璃月和稻妻的小说…呃咳！是战术资料中看到过类似的描述——",
            "nextDialogs": [
              "735290211"
            ]
          },
          "735290211": {
            "id": "735290211",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "你们的境界早就远远超过了「以杀气震慑潜在敌人，避免战斗」，而是达到了顶尖强者的位阶！",
            "nextDialogs": [
              "735290212"
            ]
          },
          "735290212": {
            "id": "735290212",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "正因为完全没有可以匹敌的对手，所以在平时的生活中，才表现得像是一点都没有威胁的普通人…甚至战斗力不如野猪。",
            "nextDialogs": [
              "735290213"
            ]
          },
          "735290213": {
            "id": "735290213",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "但只要遇上了心怀不轨之人，你们就会第一时间确认他们的威胁，以无比随意的姿态，坦然旁观对方徒劳的行动…",
            "nextDialogs": [
              "735290214"
            ]
          },
          "735290214": {
            "id": "735290214",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "「无所谓，只要你敢亮出武器，那就击败你。」"
          },
          "735290220": {
            "id": "735290220",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对哦…看你的打扮，你应该是…蒙德人？",
            "nextDialogs": [
              "735290221"
            ]
          },
          "735290221": {
            "id": "735290221",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "你们会有这等疑问，说明我的伪装成效显著，是对我的肯定。",
            "nextDialogs": [
              "735290222"
            ]
          },
          "735290222": {
            "id": "735290222",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "其实我来自枫丹，主要的职业是小说…嗯，应该说，我在从事「轻剑舞者」的工作之余，也写英雄小说挣钱，补贴主业。",
            "nextDialogs": [
              "735290223"
            ]
          },
          "735290223": {
            "id": "735290223",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "居然是枫丹人吗？完全看不出来呢…",
            "nextDialogs": [
              "735290224"
            ]
          },
          "735290224": {
            "id": "735290224",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "穿上蒙德平民的服装，只是因为我先前在蒙德游历过一段时间，发现这样的服装很轻便，还有利于隐藏身份…",
            "nextDialogs": [
              "735290225"
            ]
          },
          "735290225": {
            "id": "735290225",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "在无需以「剑舞」挫败强敌时，尽量收敛锐气，藏匿自己的兵器，才是明智的选择。",
            "nextDialogs": [
              "735290226"
            ]
          },
          "735290226": {
            "id": "735290226",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "否则特巡队，甚至是逐影庭…",
            "nextDialogs": [
              "735290227"
            ]
          },
          "735290227": {
            "id": "735290227",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "咳！否则就会有奇妙的执法者找上门来，收缴你的武装，确认你没有危害城市的打算。",
            "nextDialogs": [
              "735290228"
            ]
          },
          "735290228": {
            "id": "735290228",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "她们的身形小巧如猫，身姿迅捷如风，所过之处还会留下海洋与藻类的独特气息…",
            "nextDialogs": [
              "735290229"
            ]
          },
          "735290229": {
            "id": "735290229",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你在说什么…童话里的生物吗？听起来好像在为自己以前的失败找借口！",
            "nextDialogs": [
              "735290230"
            ]
          },
          "735290230": {
            "id": "735290230",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "总之，建议你们也不要在枫丹轻易招惹执法者，她们真的非常难对付…",
            "nextDialogs": [
              "735290231"
            ]
          },
          "735290231": {
            "id": "735290231",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "当然，如果有着不得不去贯彻的新信念…那就做好准备。在问心无愧时，离开枫丹，避免被她们追捕吧！"
          },
          "735290233": {
            "id": "735290233",
            "speakerId": 1005,
            "speakerName": "勒非尼",
            "text": "你们两位…我明白了！你们已经进入了规划战斗之舞的最佳状态，我不该打扰你们…期待你们尽早回来，展示华丽的舞姿！"
          }
        }
      }
    },

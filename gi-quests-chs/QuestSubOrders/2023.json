    {
      "subId": "202304",
      "subQuestName": "(test)暂停封锁的停留环$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "20230401"
        ],
        "dialogs": {
          "20230401": {
            "id": "20230401",
            "speakerId": 1000,
            "speakerName": "勘定奉行足轻",
            "text": "没有通行凭证，不许擅自出入离岛！",
            "nextDialogs": [
              "20230402"
            ]
          },
          "20230402": {
            "id": "20230402",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "看来拿不到通行凭证的话，就没法自由出入离岛了呢。",
            "nextDialogs": [

    {
      "subId": "7524703",
      "subQuestName": "与众人会合",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752470301"
        ],
        "dialogs": {
          "752470301": {
            "id": "752470301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "呼啊…结束了结束了，还真是挺辛苦的呢。",
            "nextDialogs": [
              "752470302"
            ]
          },
          "752470302": {
            "id": "752470302",
            "speakerId": 21979,
            "speakerName": "「咔阿夏」",
            "text": "♪",
            "nextDialogs": [
              "752470303"
            ]
          },
          "752470303": {
            "id": "752470303",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "是咔阿夏对吧？你和咔库库真的很厉害哦，这是来自对手的肯定！",
            "nextDialogs": [
              "752470304"
            ]
          },
          "752470304": {
            "id": "752470304",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "厉害啊，哥们！",
            "nextDialogs": [
              "752470305"
            ]
          },
          "752470305": {
            "id": "752470305",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "你看，我没说错吧，它俩联起手来真的很难对付。",
            "nextDialogs": [
              "752470306"
            ]
          },
          "752470306": {
            "id": "752470306",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "咔库库，现在给你颁发「隐身术」毕业证书，以后你就是一位成熟的欺诈师了。",
            "nextDialogs": [
              "752470307"
            ]
          },
          "752470307": {
            "id": "752470307",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "天哪哥们！还是你最好，哥们！",
            "nextDialogs": [
              "752470308"
            ]
          },
          "752470308": {
            "id": "752470308",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "那我呢，我呢？我可是陪你玩了最多次数的人。",
            "nextDialogs": [
              "752470309"
            ]
          },
          "752470309": {
            "id": "752470309",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "你也好，哥们！",
            "nextDialogs": [
              "752470310"
            ]
          },
          "752470310": {
            "id": "752470310",
            "speakerId": 21979,
            "speakerName": "「咔阿夏」",
            "text": "♪~",
            "nextDialogs": [
              "752470311"
            ]
          },
          "752470311": {
            "id": "752470311",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "唔…好像是有什么东西要给我们…",
            "nextDialogs": [
              "752470312"
            ]
          },
          "752470312": {
            "id": "752470312",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "在众人和龙的瞩目中，「咔阿夏」翻出了一颗「闪闪礼蛋」…",
            "nextDialogs": [
              "752470313"
            ]
          },
          "752470313": {
            "id": "752470313",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "喔！又是「闪闪礼蛋」和新的画片。这个标志，好像在悠悠集市见过…",
            "nextDialogs": [
              "752470314"
            ]
          },
          "752470314": {
            "id": "752470314",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "嗯…我开始觉得这是什么接力挑战了。",
            "nextDialogs": [
              "752470315"
            ]
          },
          "752470315": {
            "id": "752470315",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "是度假村的隐藏玩法吗？我必须加入。",
            "nextDialogs": [
              "752470316"
            ]
          },
          "752470316": {
            "id": "752470316",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "哥们加入！",
            "nextDialogs": [
              "752470317"
            ]
          },
          "752470317": {
            "id": "752470317",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看起来咔库库玩得超开心呢。",
            "nextDialogs": [
              "752470318"
            ]
          },
          "752470318": {
            "id": "752470318",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#好嘛，既然如此，肯定也不能少了我和{NICKNAME}！怎么样，我们也去看看？",
            "nextDialogs": [
              "752470319"
            ]
          },
          "752470319": {
            "id": "752470319",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "必须加入！",
            "nextDialogs": [
              "752470320"
            ]
          },
          "752470320": {
            "id": "752470320",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "好，那就这么办。"
          }
        }
      }
    },
    {
      "subId": "7524704",
      "subQuestName": "前往悠悠集市",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752470401"
        ],
        "dialogs": {
          "752470401": {
            "id": "752470401",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "找到了，真的在悠悠集市！",
            "nextDialogs": [
              "752470402"
            ]
          },
          "752470402": {
            "id": "752470402",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "悠悠集市！！",
            "nextDialogs": [
              "752470403"
            ]
          },
          "752470403": {
            "id": "752470403",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "冷静，哥们，虽然能看出你是真的很开心，但我们还是得先搞清楚状况…",
            "nextDialogs": [
              "752470404"
            ]
          },
          "752470404": {
            "id": "752470404",
            "speakerId": 6536,
            "speakerName": "察尔瓦",
            "text": "咳咳…尊贵的客人请留步，「闪闪礼蛋」，好运相伴！",
            "nextDialogs": [
              "752470405"
            ]
          },
          "752470405": {
            "id": "752470405",
            "speakerId": 6536,
            "speakerName": "察尔瓦",
            "text": "诸位可以免费体验，要不要试试手运？",
            "nextDialogs": [
              "752470406"
            ]
          },
          "752470406": {
            "id": "752470406",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "原来是给我们指引到了「闪闪礼蛋」的发源地呀。",
            "nextDialogs": [
              "752470407"
            ]
          },
          "752470407": {
            "id": "752470407",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "嘿嘿，不知道好运的祝福还能不能持续到现在，我们试试看吧！",
            "nextDialogs": [
              "752470408"
            ]
          },
          "752470408": {
            "id": "752470408",
            "speakerId": 6536,
            "speakerName": "察尔瓦",
            "text": "请、请务必！礼蛋都已经准备好了。",
            "nextDialogs": [
              "752470409"
            ]
          },
          "752470409": {
            "id": "752470409",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "唔？",
            "nextDialogs": [
              "752470410"
            ]
          },
          "752470410": {
            "id": "752470410",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "你先来。",
            "nextDialogs": [
              "752470411"
            ]
          },
          "752470411": {
            "id": "752470411",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "哥们，你不会真以为第一个吃螃蟹的人会吃亏吧。我来就我来。",
            "nextDialogs": [
              "752470412"
            ]
          },
          "752470412": {
            "id": "752470412",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "阿夏保佑，好运连连！",
            "nextDialogs": [
              "752470413"
            ]
          },
          "752470413": {
            "id": "752470413",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哇，是美味的龙龙饼干！",
            "nextDialogs": [
              "752470414"
            ]
          },
          "752470414": {
            "id": "752470414",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "呃…",
            "nextDialogs": [
              "752470415"
            ]
          },
          "752470415": {
            "id": "752470415",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "噗…！",
            "nextDialogs": [
              "752470416"
            ]
          },
          "752470416": {
            "id": "752470416",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸，伊法不喜欢龙龙饼干吗？",
            "nextDialogs": [
              "752470417"
            ]
          },
          "752470417": {
            "id": "752470417",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "龙龙饼干非常好，伊法和我都很喜欢。但在「闪闪礼蛋」里，只能算是比较普通的奖品。",
            "nextDialogs": [
              "752470418"
            ]
          },
          "752470418": {
            "id": "752470418",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "算啦算啦，只要好吃就是合格的饼干，大家一起分一分。",
            "nextDialogs": [
              "752470419"
            ]
          },
          "752470419": {
            "id": "752470419",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "你也别光顾着看我的笑话，等下小心自己开到奇怪的乌乌黑蛋。我可不会救你！",
            "nextDialogs": [
              "752470420"
            ]
          },
          "752470420": {
            "id": "752470420",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "不可能，你忍不住的。",
            "nextDialogs": [
              "752470421"
            ]
          },
          "752470421": {
            "id": "752470421",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "嗯…开「闪闪礼蛋」前，需要什么特殊的仪式吗？",
            "nextDialogs": [
              "752470422"
            ]
          },
          "752470422": {
            "id": "752470422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "用你觉得会带来好运的方式。",
            "nextDialogs": [
              "752470423"
            ]
          },
          "752470423": {
            "id": "752470423",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "明白了。「花羽会巡逻队，开门！」",
            "nextDialogs": [
              "752470424"
            ]
          },
          "752470424": {
            "id": "752470424",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "？",
            "nextDialogs": [
              "752470425"
            ]
          },
          "752470425": {
            "id": "752470425",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "天哪，是花羽会特产「纵声欢唱」…他的祈祷仪式竟然奏效了…",
            "nextDialogs": [
              "752470426"
            ]
          },
          "752470426": {
            "id": "752470426",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "真走运。其实只要不是奇瑰之汤对我来说都算赢，那个实在喝腻了…",
            "nextDialogs": [
              "752470427"
            ]
          },
          "752470427": {
            "id": "752470427",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "好大一罐糖啊，大家也分一分吧。",
            "nextDialogs": [
              "752470428"
            ]
          },
          "752470428": {
            "id": "752470428",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "还是你最好，哥们！",
            "nextDialogs": [
              "752470429"
            ]
          },
          "752470429": {
            "id": "752470429",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "吃完饼干又吃糖，咔库库嚼得嘎嘣响。",
            "nextDialogs": [
              "752470430"
            ]
          },
          "752470430": {
            "id": "752470430",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "甜度确实有些超标，大家都有点精神亢奋…"
          }
        }
      }
    },
    {
      "subId": "7524750",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752475001"
        ],
        "dialogs": {
          "752475001": {
            "id": "752475001",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "怎么样，玩得开心吗？",
            "nextDialogs": [
              "752475002"
            ]
          },
          "752475002": {
            "id": "752475002",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "哦天哪，哥们！",
            "nextDialogs": [
              "752475003"
            ]
          },
          "752475003": {
            "id": "752475003",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "看来是开心的。生日快乐，哥们。",
            "nextDialogs": [
              "752475004"
            ]
          },
          "752475004": {
            "id": "752475004",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "说到这个，你为什么不提前告诉我这个计划呢？不拿我当哥们吗？",
            "nextDialogs": [
              "752475005"
            ]
          },
          "752475005": {
            "id": "752475005",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "呵呵…实不相瞒，是想看看你是否还记得这个日子。",
            "nextDialogs": [
              "752475006"
            ]
          },
          "752475006": {
            "id": "752475006",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "…伊法，你变了，变得很阴险，我以后需要警惕你了。",
            "nextDialogs": [
              "752475007"
            ]
          },
          "752475007": {
            "id": "752475007",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "还好我记得，给咔库库留了新鲜的蜜，不然接下来要被它啄一整年的头。",
            "nextDialogs": [
              "752475008"
            ]
          },
          "752475008": {
            "id": "752475008",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "不会的哥们，还是你最好！"
          }
        }
      }
    },
    {
      "subId": "7524751",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752475101"
        ],
        "dialogs": {
          "752475101": {
            "id": "752475101",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "又见面了，哥们。",
            "nextDialogs": [
              "752475102"
            ]
          },
          "752475102": {
            "id": "752475102",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "其实我刚刚是想说，我第一次认识伊法可不是在那天。",
            "nextDialogs": [
              "752475103"
            ]
          },
          "752475103": {
            "id": "752475103",
            "speakerId": 14977,
            "speakerName": "咔库库",
            "text": "不过最后还是忍住了。毕竟我很成熟，说话会看场合的嘛。"
          }
        }
      }
    },
    {
      "subId": "7524799",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752479901"
        ],
        "dialogs": {
          "752479901": {
            "id": "752479901",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咔库库、「咔阿夏」——「欧阿夏」，「伊阿夏」——",
            "nextDialogs": [
              "752479902"
            ]
          },
          "752479902": {
            "id": "752479902",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "快快藏好，我们开始抓咯——"
          }
        }
      }
    }
  ]
}
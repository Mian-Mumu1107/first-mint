    {
      "subId": "7524701",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752470101"
        ],
        "dialogs": {
          "752470101": {
            "id": "752470101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看来画片上的地方就是这里了，他俩都在呢！",
            "nextDialogs": [
              "752470102"
            ]
          },
          "752470102": {
            "id": "752470102",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "你们好——！",
            "nextDialogs": [
              "752470103"
            ]
          },
          "752470103": {
            "id": "752470103",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "听声调是「高兴」的派蒙，太好了，不用警惕。",
            "nextDialogs": [
              "752470104"
            ]
          },
          "752470104": {
            "id": "752470104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「生气」的派蒙也不用警惕。",
            "nextDialogs": [
              "752470105"
            ]
          },
          "752470105": {
            "id": "752470105",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可恶！瞧不起谁呢！",
            "nextDialogs": [
              "752470106"
            ]
          },
          "752470106": {
            "id": "752470106",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "喂她点好吃的就行了。",
            "nextDialogs": [
              "752470107"
            ]
          },
          "752470107": {
            "id": "752470107",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哼，这还差不多嘛…不对，怎么说得我跟咔库库似的！",
            "nextDialogs": [
              "752470108"
            ]
          },
          "752470108": {
            "id": "752470108",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "算了，派蒙今天是「高兴」的派蒙，不跟你们计较啦。",
            "nextDialogs": [
              "752470109"
            ]
          },
          "752470109": {
            "id": "752470109",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "说到这个，咔库库呢？不会被豚兽大王吃掉了吧？",
            "nextDialogs": [
              "752470110"
            ]
          },
          "752470110": {
            "id": "752470110",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "怎么可能。哥们，听听你说的…",
            "nextDialogs": [
              "752470111"
            ]
          },
          "752470111": {
            "id": "752470111",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "咔库库正在和敌方联手欺负我们。",
            "nextDialogs": [
              "752470112"
            ]
          },
          "752470112": {
            "id": "752470112",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "哈哈哈，说是咔库库在「欺负」他们呢，欧洛伦又在说笑…",
            "nextDialogs": [
              "752470113"
            ]
          },
          "752470113": {
            "id": "752470113",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "我不是在开玩笑。",
            "nextDialogs": [
              "752470114"
            ]
          },
          "752470114": {
            "id": "752470114",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸？",
            "nextDialogs": [
              "752470115"
            ]
          },
          "752470115": {
            "id": "752470115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那么敌方是…？",
            "nextDialogs": [
              "752470116"
            ]
          },
          "752470116": {
            "id": "752470116",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "它说它叫「咔阿夏」。",
            "nextDialogs": [
              "752470117"
            ]
          },
          "752470117": {
            "id": "752470117",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "谁？真的吗？阿夏会说话？",
            "nextDialogs": [
              "752470118"
            ]
          },
          "752470118": {
            "id": "752470118",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "停停，你们别听他胡编，还是我来说吧。",
            "nextDialogs": [
              "752470119"
            ]
          },
          "752470119": {
            "id": "752470119",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "咔库库呢…呃，正在和这里遇到的阿夏一起玩捉迷藏。",
            "nextDialogs": [
              "752470120"
            ]
          },
          "752470120": {
            "id": "752470120",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "准确来说，是和「咔阿夏」结盟一起对付我俩。",
            "nextDialogs": [
              "752470121"
            ]
          },
          "752470121": {
            "id": "752470121",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "咔库库行动很快，「咔阿夏」又很会伪装，是棘手的敌人。",
            "nextDialogs": [
              "752470122"
            ]
          },
          "752470122": {
            "id": "752470122",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "你俩出现前，我们都陪这两个小东西玩过好多好多轮了。",
            "nextDialogs": [
              "752470123"
            ]
          },
          "752470123": {
            "id": "752470123",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "咔库库的确很厉害，但我的心情已经从一开始的骄傲，变得不那么精神了…",
            "nextDialogs": [
              "752470124"
            ]
          },
          "752470124": {
            "id": "752470124",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "只能怪你自己不去上伊安珊的健身课。",
            "nextDialogs": [
              "752470125"
            ]
          },
          "752470125": {
            "id": "752470125",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "哎呦，一直得上上下下地寻找，我腰很痛欸！",
            "nextDialogs": [
              "752470126"
            ]
          },
          "752470126": {
            "id": "752470126",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "对啊，这就是要怪你自己不去上伊安珊的健身课。",
            "nextDialogs": [
              "752470127"
            ]
          },
          "752470127": {
            "id": "752470127",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "…好好，结束这里的工作我就去，好吧！",
            "nextDialogs": [
              "752470128"
            ]
          },
          "752470128": {
            "id": "752470128",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "停停，你俩谁也别说谁了！说到底，现在是谁在负责抓咔库库和「咔阿夏」呢？",
            "nextDialogs": [
              "752470129"
            ]
          },
          "752470129": {
            "id": "752470129",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "哦！这就要说到我们眼前这个完美的台阶…",
            "nextDialogs": [
              "752470130"
            ]
          },
          "752470130": {
            "id": "752470130",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "又我是吧？",
            "nextDialogs": [
              "752470131"
            ]
          },
          "752470131": {
            "id": "752470131",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "嗯嗯。",
            "nextDialogs": [
              "752470132"
            ]
          },
          "752470132": {
            "id": "752470132",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "行，我行我上。",
            "nextDialogs": [
              "752470133"
            ]
          },
          "752470133": {
            "id": "752470133",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "#{M#爷爷}{F#奶奶}一定能行！派蒙奶奶也行！",
            "nextDialogs": [
              "752470134"
            ]
          },
          "752470134": {
            "id": "752470134",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "不用勉强哦，要帮忙的话叫我们。",
            "nextDialogs": [
              "752470135"
            ]
          },
          "752470135": {
            "id": "752470135",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "欸，我以为我俩要做阿夏的？",
            "nextDialogs": [
              "752470136"
            ]
          },
          "752470136": {
            "id": "752470136",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "做阿夏…意思是你们也要躲起来等我们去找吗？",
            "nextDialogs": [
              "752470137"
            ]
          },
          "752470137": {
            "id": "752470137",
            "speakerId": 1094,
            "speakerName": "欧洛伦",
            "text": "嗯！从现在开始我是欧阿夏，他是伊阿夏。走咯，加油！",
            "nextDialogs": [
              "752470138"
            ]
          },
          "752470138": {
            "id": "752470138",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "欸你这…！",
            "nextDialogs": [
              "752470139"
            ]
          },
          "752470139": {
            "id": "752470139",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "抱歉啦，就配合他们一下吧。",
            "nextDialogs": [
              "752470142"
            ]
          },
          "752470142": {
            "id": "752470142",
            "speakerId": 1307,
            "speakerName": "伊法",
            "text": "那就拜托二位了，不胜感激。"
          }
        }
      }
    },

    {
      "subId": "7180305",
      "subQuestName": "将灰灰带给岚姐",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718030401"
        ],
        "dialogs": {
          "718030401": {
            "id": "718030401",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "你把丘丘岩盔王打倒了吗？",
            "nextDialogs": [
              "718030403",
              "718030405"
            ]
          },
          "718030403": {
            "id": "718030403",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "辛苦你了，完成了这项委托，应该就能证明协会的实力…"
          },
          "718030405": {
            "id": "718030405",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "辛苦你…什么？"
          }
        }
      }
    },
    {
      "subId": "7180306",
      "subQuestName": "与岚姐对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718030501"
        ],
        "dialogs": {
          "718030501": {
            "id": "718030501",
            "speakerId": 20180,
            "speakerName": "灰灰",
            "text": "喵喵…喵？",
            "nextDialogs": [
              "718030502"
            ]
          },
          "718030502": {
            "id": "718030502",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "这只猫是…",
            "nextDialogs": [
              "718030503"
            ]
          },
          "718030503": {
            "id": "718030503",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "也许是灰灰。",
            "nextDialogs": [
              "718030504"
            ]
          },
          "718030504": {
            "id": "718030504",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "稍等，我把那份委托拿出来，对比一下特征。",
            "nextDialogs": [
              "718030505"
            ]
          },
          "718030505": {
            "id": "718030505",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "我看看…",
            "nextDialogs": [
              "718030506"
            ]
          },
          "718030506": {
            "id": "718030506",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "大部分都符合…看来它确实是那份委托要找的猫。",
            "nextDialogs": [
              "718030508"
            ]
          },
          "718030508": {
            "id": "718030508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "委托人会很高兴的。",
            "nextDialogs": [
              "718030509"
            ]
          },
          "718030509": {
            "id": "718030509",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "呼…兜兜转转一大圈，居然又转回了找猫这种委托。",
            "nextDialogs": [
              "718030510"
            ]
          },
          "718030510": {
            "id": "718030510",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "真是让人不知道说什么好…",
            "nextDialogs": [
              "718030511"
            ]
          },
          "718030511": {
            "id": "718030511",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "我会把这两份委托分别向委托人报告，辛苦你了，这是报酬，请收下。",
            "nextDialogs": [
              "718030512"
            ]
          },
          "718030512": {
            "id": "718030512",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "但那份找猫的委托…委托人似乎已经搬家了，联系到他们也许还需要一点时间。",
            "nextDialogs": [
              "718030513"
            ]
          },
          "718030513": {
            "id": "718030513",
            "speakerId": 2016,
            "speakerName": "岚姐",
            "text": "在委托人过来之前，这个小家伙，就由我先照顾着吧。",
            "nextDialogs": [
              "718030514"
            ]
          },
          "718030514": {
            "id": "718030514",
            "speakerId": 20180,
            "speakerName": "灰灰",
            "text": "喵喵，喵！"
          }
        }
      }
    }
  ]
}
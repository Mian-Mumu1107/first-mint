    {
      "subId": "7180303",
      "subQuestName": "打倒丘丘岩盔王$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718030301"
        ],
        "dialogs": {
          "718030301": {
            "id": "718030301",
            "speakerId": 1001,
            "speakerName": "奇怪的小猫",
            "text": "喵…",
            "nextDialogs": [
              "718030302"
            ]
          },
          "718030302": {
            "id": "718030302",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "咦？怎么有只小猫在这里，难道刚才的叫声是它发出来的？",
            "nextDialogs": [
              "718030303"
            ]
          },
          "718030303": {
            "id": "718030303",
            "speakerId": 1001,
            "speakerName": "奇怪的小猫",
            "text": "喵…喵…",
            "nextDialogs": [
              "718030305",
              "718030309"
            ]
          },
          "718030305": {
            "id": "718030305",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "灰色的小猫…走失在野外…",
            "nextDialogs": [
              "718030306"
            ]
          },
          "718030306": {
            "id": "718030306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！岚姐之前提到了一个找猫的委托…难道它就是那只猫？好像是叫灰灰还是什么的…",
            "nextDialogs": [
              "718030307"
            ]
          },
          "718030307": {
            "id": "718030307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "没想到会在这里找到它…它难道一直躲在这附近吗？",
            "nextDialogs": [
              "718030311"
            ]
          },
          "718030311": {
            "id": "718030311",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "因为丘丘岩盔王在这里的原因，也没有人敢过来找它…它也不敢出去，只能一直躲在这里。",
            "nextDialogs": [
              "718030312"
            ]
          },
          "718030312": {
            "id": "718030312",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "还好我们过来了，不然它不知道还要在这里待到什么时候。",
            "nextDialogs": [
              "718030313"
            ]
          },
          "718030313": {
            "id": "718030313",
            "speakerId": 20180,
            "speakerName": "灰灰",
            "text": "喵…喵喵！"
          },
          "718030309": {
            "id": "718030309",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "灰色的小猫…走失在野外…",
            "nextDialogs": [
              "718030310"
            ]
          },
          "718030310": {
            "id": "718030310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "啊！是岚姐之前提到的那个委托，居然会在这里发现它…难道它一直躲在这附近？"
          }
        }
      }
    },

    {
      "subId": "2100007",
      "subQuestName": "与小蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210000301"
        ],
        "dialogs": {
          "210000301": {
            "id": "210000301",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "居然…居然有这种东西…吓死我了…",
            "nextDialogs": [
              "210000302"
            ]
          },
          "210000302": {
            "id": "210000302",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#谢谢你，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我们继续…",
            "nextDialogs": [
              "210000303"
            ]
          },
          "210000303": {
            "id": "210000303",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "欸？我…我的漂流瓶呢？刚刚还在我身上的，不见了！",
            "nextDialogs": [
              "210000304"
            ]
          },
          "210000304": {
            "id": "210000304",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "难道是刚才被那个…那个骗骗花袭击的时候，掉在哪里了？",
            "nextDialogs": [
              "210000305"
            ]
          },
          "210000305": {
            "id": "210000305",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，拜托你帮我找找吧。"
          }
        }
      }
    },

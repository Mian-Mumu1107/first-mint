  "subQuests": [
    {
      "subId": "2100001",
      "subQuestName": "与小蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210000101"
        ],
        "dialogs": {
          "210000101": {
            "id": "210000101",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "唉，我真的能做到吗…",
            "nextDialogs": [
              "210000102"
            ]
          },
          "210000102": {
            "id": "210000102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "小蒙，你怎么了？",
            "nextDialogs": [
              "210000103"
            ]
          },
          "210000103": {
            "id": "210000103",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，是你啊…你好。",
            "nextDialogs": [
              "210000104"
            ]
          },
          "210000104": {
            "id": "210000104",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "小蒙，你怎么看着有些不开心呀？",
            "nextDialogs": [
              "210000105"
            ]
          },
          "210000105": {
            "id": "210000105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么了？是他们不和你玩那个…海盗游戏了吗？",
            "nextDialogs": [
              "210000106"
            ]
          },
          "210000106": {
            "id": "210000106",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "欸？不是，璐璐和阿飞他们是回家去了。",
            "nextDialogs": [
              "210000107"
            ]
          },
          "210000107": {
            "id": "210000107",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "我…是想要自己出去逛逛，所以才暂时没回家。",
            "nextDialogs": [
              "210000108"
            ]
          },
          "210000108": {
            "id": "210000108",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这样你父母不会担心吗？",
            "nextDialogs": [
              "210000109"
            ]
          },
          "210000109": {
            "id": "210000109",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "现在这个时间，我爸妈应该还在工作没回家呢。",
            "nextDialogs": [
              "210000110"
            ]
          },
          "210000110": {
            "id": "210000110",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#不说这个，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我能问你个问题吗？",
            "nextDialogs": [
              "210000114",
              "210000113"
            ]
          },
          "210000114": {
            "id": "210000114",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我听很多人说起过你的事情。",
            "nextDialogs": [
              "210000115"
            ]
          },
          "210000115": {
            "id": "210000115",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "我觉得，你去过很多地方，也经历过很多事…说不定能告诉我这个问题的答案…",
            "nextDialogs": [
              "210000116"
            ]
          },
          "210000116": {
            "id": "210000116",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "呜哇…小蒙突然这么严肃了，到底是什么问题呀？",
            "nextDialogs": [
              "210000117"
            ]
          },
          "210000117": {
            "id": "210000117",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我想问你…",
            "nextDialogs": [
              "210000118"
            ]
          },
          "210000118": {
            "id": "210000118",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "一个人到底怎么样，才能变得「成熟」呢？"
          },
          "210000113": {
            "id": "210000113",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "哈哈哈，那个游戏我也是陪着璐璐和阿飞玩啦，他们不在，我也不会特意去玩的。"
          }
        }
      }
    },
    {
      "subId": "2100002",
      "subQuestName": "前往碧水河附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210000201"
        ],
        "dialogs": {
          "210000201": {
            "id": "210000201",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "已经快到碧水河了吗？唔…我们挑个好地方把漂流瓶放出去吧。",
            "nextDialogs": [
              "210000202"
            ]
          },
          "210000202": {
            "id": "210000202",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "如果想让漂流瓶漂远一些的话，应该要挑一个上游的位置…"
          }
        }
      }
    },
    {
      "subId": "2100003",
      "subQuestName": "与小蒙对话",
      "sceneId": null,
      "locations": [],

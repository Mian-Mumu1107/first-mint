            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你找到漂流瓶了吗？"

    {
      "subId": "2100015",
      "subQuestName": "与小蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210000701"
        ],
        "dialogs": {
          "210000701": {
            "id": "210000701",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#好了，今天谢谢你了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。",
            "nextDialogs": [
              "210000702"
            ]
          },
          "210000702": {
            "id": "210000702",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "这些东西是给你的，请你收下吧。",
            "nextDialogs": [
              "210000703"
            ]
          },
          "210000703": {
            "id": "210000703",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "对了，今天的事情还请你向璐璐和阿飞保密。",
            "nextDialogs": [
              "210000704"
            ]
          },
          "210000704": {
            "id": "210000704",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "这是我一个人的烦恼，可别让他们也跟着不开心了。",
            "nextDialogs": [
              "210000705"
            ]
          },
          "210000705": {
            "id": "210000705",
            "speakerId": 1000,
            "speakerName": "小蒙",
            "text": "#好了，我要回家去了，再见了，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。"
          }
        }
      }

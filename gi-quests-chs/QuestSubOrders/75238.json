{
  "lineCounts": {
    "「木偶」": 10,
    "茜特菈莉": 14
  },
  "subQuests": [
    {
      "subId": "7523801",
      "subQuestName": "前往茜特菈莉的住所附近开启茶会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752380101"
        ],
        "dialogs": {
          "752380101": {
            "id": "752380101",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "茶的口味还满意吗？还是说我该准备些酒类饮料？",
            "nextDialogs": [
              "752380102"
            ]
          },
          "752380102": {
            "id": "752380102",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "不了，茶挺好。白天喝酒有些太罪恶了，那种事还是少干两次吧。",
            "nextDialogs": [
              "752380103"
            ]
          },
          "752380103": {
            "id": "752380103",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "倒是吉约丹小姐，怎么跑这么远到纳塔来？",
            "nextDialogs": [
              "752380104"
            ]
          },
          "752380104": {
            "id": "752380104",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "四处走走，看看过去的同伴而已。我也想感谢你在千灵节期间愿意接下那份工作。",
            "nextDialogs": [
              "752380105"
            ]
          },
          "752380105": {
            "id": "752380105",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "你也太客气了，就为了这跑一趟吗？",
            "nextDialogs": [
              "752380106"
            ]
          },
          "752380106": {
            "id": "752380106",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "另外，虽然你上次没提，但我知道曾经给你们增添过一些不愉快。",
            "nextDialogs": [
              "752380107"
            ]
          },
          "752380107": {
            "id": "752380107",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "啊…你部下的那事是吧。和那个名叫伊涅芙的机器人有关的那次。",
            "nextDialogs": [
              "752380108"
            ]
          },
          "752380108": {
            "id": "752380108",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "呵…这不正是生活奇妙的地方吗？曾经敌人的老板或许也会变为你的同伴，或是你的老板…",
            "nextDialogs": [
              "752380109"
            ]
          },
          "752380109": {
            "id": "752380109",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "希望你能收下这些。聊表心意。",
            "nextDialogs": [
              "752380110"
            ]
          },
          "752380110": {
            "id": "752380110",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "这…这是…限定版，不对，珍藏版轻小说？！而且还是我喜欢的题材？你…你怎么会知道…",
            "nextDialogs": [
              "752380111"
            ]
          },
          "752380111": {
            "id": "752380111",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "#我向{NICKNAME}询问你可能会喜欢的东西，并听取了{M#他}{F#她}的意见。",
            "nextDialogs": [
              "752380112"
            ]
          },
          "752380112": {
            "id": "752380112",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "#{NICKNAME}…？！",
            "nextDialogs": [
              "752380113"
            ]
          },
          "752380113": {
            "id": "752380113",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "（可恶…！这种又高兴又有些别扭的感觉是怎么回事？！）",
            "nextDialogs": [
              "752380114"
            ]
          },
          "752380114": {
            "id": "752380114",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "#（虽然{M#他}{F#她}了解我喜欢什么自然是高兴啦，但能不能不要随便告诉别人，倒是来亲自送给我呀！）",
            "nextDialogs": [
              "752380115"
            ]
          },
          "752380115": {
            "id": "752380115",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "还算中意吗？",
            "nextDialogs": [
              "752380116"
            ]
          },
          "752380116": {
            "id": "752380116",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "啊…谢谢谢谢。吉约丹小姐真的太客气了。",
            "nextDialogs": [
              "752380117"
            ]
          },
          "752380117": {
            "id": "752380117",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "#喜欢的话，我下次也再给你带些。当然，到时候恐怕又得麻烦{NICKNAME}一起去选一选了。",
            "nextDialogs": [
              "752380118"
            ]
          },
          "752380118": {
            "id": "752380118",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "一起？！你们是一起逛…逛书店选的吗？！",
            "nextDialogs": [
              "752380119"
            ]
          },
          "752380119": {
            "id": "752380119",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "#嗯，{M#他}{F#她}很认真地为你挑选了这本。下次或许…",
            "nextDialogs": [
              "752380120"
            ]
          },
          "752380120": {
            "id": "752380120",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "不要再有下次了！！",
            "nextDialogs": [
              "752380121"
            ]
          },
          "752380121": {
            "id": "752380121",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "啊…啊？"
          }
        }
      }
    },
    {
      "subId": "7523802",
      "subQuestName": "前往茜特菈莉的住所附近开启茶会",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "752380201"
        ],
        "dialogs": {
          "752380201": {
            "id": "752380201",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "#哼…看我下次怎么收拾{M#他}{F#她}。",
            "nextDialogs": [
              "752380202"
            ]
          },
          "752380202": {
            "id": "752380202",
            "speakerId": 1000,
            "speakerName": "「木偶」",
            "text": "（再这么坐一会儿吧。）",
            "nextDialogs": [
              "752380204"
            ]
          },
          "752380204": {
            "id": "752380204",
            "speakerId": 1001,
            "speakerName": "茜特菈莉",
            "text": "已经这么晚了？好吧，吉约丹小姐回去路上小心。"
          }
        }
      }
    },

    {
      "subId": "4112303",
      "subQuestName": "向霍夫曼回报结果",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411230301"
        ],
        "dialogs": {
          "411230301": {
            "id": "411230301",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "你把那些盗宝团都赶走了吗？",
            "nextDialogs": [
              "411230302"
            ]
          },
          "411230302": {
            "id": "411230302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "都赶走了。",
            "nextDialogs": [
              "411230303"
            ]
          },
          "411230303": {
            "id": "411230303",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "太好了，实在是帮大忙了。",
            "nextDialogs": [
              "411230304"
            ]
          },
          "411230304": {
            "id": "411230304",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "那群盗宝团吃了这个教训，应该不敢来趁火打劫了。",
            "nextDialogs": [
              "411230305"
            ]
          },
          "411230305": {
            "id": "411230305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "没事的话…",
            "nextDialogs": [
              "411230306"
            ]
          },
          "411230306": {
            "id": "411230306",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "呃，请留步…还有一件事，想要再请你帮帮忙。",
            "nextDialogs": [
              "411230307"
            ]
          },
          "411230307": {
            "id": "411230307",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "其实在陨石落下之后，骑士团就收到很多有关魔物异常的报告。",
            "nextDialogs": [
              "411230308"
            ]
          },
          "411230308": {
            "id": "411230308",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "这些报告里面提到，魔物似乎也受到了陨石的影响，变得格外暴躁。",
            "nextDialogs": [
              "411230309"
            ]
          },
          "411230309": {
            "id": "411230309",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "蒙德城的防卫还算全面，不需要担心，但是有一颗陨石正好落在了清泉镇旁边…",
            "nextDialogs": [
              "411230310"
            ]
          },
          "411230310": {
            "id": "411230310",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "清泉镇里虽然有不少猎人，我们也派了骑士过去协助，但那里的地形实在难以做到完全防守好。",
            "nextDialogs": [
              "411230311"
            ]
          },
          "411230311": {
            "id": "411230311",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "假如漏了魔物进镇子，那就糟糕了…",
            "nextDialogs": [
              "411230312"
            ]
          },
          "411230312": {
            "id": "411230312",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "能请你去清泉镇周围调查一下魔物的情况吗？",
            "nextDialogs": [
              "411230314",
              "411230316"
            ]
          },
          "411230314": {
            "id": "411230314",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "那就拜托你了，我也会尽量快点再安排些骑士过去支援。"
          },
          "411230316": {
            "id": "411230316",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "老实说…不太乐观，除了要处理陨石相关的诸多事宜外，还要提防魔物和盗宝团…",
            "nextDialogs": [
              "411230317"
            ]
          },
          "411230317": {
            "id": "411230317",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "同时要应付这么多东西，实在是太吃力了…",
            "nextDialogs": [
              "411230318"
            ]
          },
          "411230318": {
            "id": "411230318",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "那这件事就拜托你了，我也会尽量快点再安排些骑士过去支援。"
          }
        }
      }
    },
    {
      "subId": "4112304",
      "subQuestName": "前往清泉镇附近调查",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411230401"
        ],
        "dialogs": {
          "411230401": {
            "id": "411230401",
            "speakerId": 1001,
            "speakerName": "胆小的莫罗",
            "text": "呜哇！别，别过…",
            "nextDialogs": [
              "411230402"
            ]
          },
          "411230402": {
            "id": "411230402",
            "speakerId": 1001,
            "speakerName": "胆小的莫罗",
            "text": "咦？不是魔物…你，你是谁？",
            "nextDialogs": [
              "411230403"
            ]
          },
          "411230403": {
            "id": "411230403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于魔物的情况…",
            "nextDialogs": [
              "411230404"
            ]
          },
          "411230404": {
            "id": "411230404",
            "speakerId": 1001,
            "speakerName": "胆小的莫罗",
            "text": "魔物的情况…那还用问吗？我就是刚从魔物堆旁边跑过来的！",
            "nextDialogs": [
              "411230405"
            ]
          },
          "411230405": {
            "id": "411230405",
            "speakerId": 1001,
            "speakerName": "胆小的莫罗",
            "text": "就在旁边，一群魔物已经在那扎堆了，一副要进攻镇子的样子。",
            "nextDialogs": [
              "411230406"
            ]
          },
          "411230406": {
            "id": "411230406",
            "speakerId": 1001,
            "speakerName": "胆小的莫罗",
            "text": "要不是我跑得快，说不定你就看不到我了…",
            "nextDialogs": [
              "411230407"
            ]
          },
          "411230407": {
            "id": "411230407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "那群魔物在哪？",
            "nextDialogs": [
              "411230408"
            ]
          },
          "411230408": {
            "id": "411230408",
            "speakerId": 1001,
            "speakerName": "胆小的莫罗",
            "text": "就在镇子旁边，很近，走几步就能看见了。",
            "nextDialogs": [
              "411230409"
            ]
          },
          "411230409": {
            "id": "411230409",
            "speakerId": 1001,
            "speakerName": "胆小的莫罗",
            "text": "你也快点去避难吧，我在这再歇一会…再歇一会就回去把情况告诉镇子里的人。"
          }
        }
      }
    },

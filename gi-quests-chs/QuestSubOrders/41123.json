    {
      "subId": "4112301",
      "subQuestName": "与霍夫曼对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411230101"
        ],
        "dialogs": {
          "411230101": {
            "id": "411230101",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "您好，旅行者。这段时间请尽量待在城里，不要外出。",
            "nextDialogs": [
              "411230102"
            ]
          },
          "411230102": {
            "id": "411230102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了？",
            "nextDialogs": [
              "411230103"
            ]
          },
          "411230103": {
            "id": "411230103",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "外面那些砸落的陨石，您应该也看见了。",
            "nextDialogs": [
              "411230104"
            ]
          },
          "411230104": {
            "id": "411230104",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "不知道为什么，这段时间陨石降落的势头似乎更猛了，野外也更加危险了。",
            "nextDialogs": [
              "411230105"
            ]
          },
          "411230105": {
            "id": "411230105",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "城内的事务越来越多，骑士团也要忙不过来了。偏偏最近城边还发现了不少盗宝团的踪迹…",
            "nextDialogs": [
              "411230106"
            ]
          },
          "411230106": {
            "id": "411230106",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "这群为了钱什么都肯干的家伙，只怕是想要趁火打劫一番…",
            "nextDialogs": [
              "411230107"
            ]
          },
          "411230107": {
            "id": "411230107",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "如果你愿意的话，能帮忙去城边赶走那些盗宝团吗？",
            "nextDialogs": [
              "411230108"
            ]
          },
          "411230108": {
            "id": "411230108",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "本来这应该是骑士团的职责，但我们实在抽不出人手来处理这件事，只能拜托你了。",
            "nextDialogs": [
              "411230110",
              "411230112"
            ]
          },
          "411230110": {
            "id": "411230110",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "那就拜托你了，在这种情况下还让你帮忙，实在是不好意思。"
          },
          "411230112": {
            "id": "411230112",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "哼，为了钱，那群家伙应该什么都不怕吧。",
            "nextDialogs": [
              "411230113"
            ]
          },
          "411230113": {
            "id": "411230113",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "那就拜托你了，在这种情况下还让你帮忙，实在是不好意思。"
          }
        }
      }
    },

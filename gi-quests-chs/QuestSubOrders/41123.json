    {
      "subId": "4112308",
      "subQuestName": "向胆小的莫罗回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411230801"
        ],
        "dialogs": {
          "411230801": {
            "id": "411230801",
            "speakerId": 1001,
            "speakerName": "胆小的莫罗",
            "text": "咦？怎么又是你，你去做什么了？",
            "nextDialogs": [
              "411230802"
            ]
          },
          "411230802": {
            "id": "411230802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我把魔物都打倒了。",
            "nextDialogs": [
              "411230803"
            ]
          },
          "411230803": {
            "id": "411230803",
            "speakerId": 1001,
            "speakerName": "胆小的莫罗",
            "text": "打倒了…真的假的，就你一个人？",
            "nextDialogs": [
              "411230804"
            ]
          },
          "411230804": {
            "id": "411230804",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你可以自己去看看。",
            "nextDialogs": [
              "411230805"
            ]
          },
          "411230805": {
            "id": "411230805",
            "speakerId": 1001,
            "speakerName": "胆小的莫罗",
            "text": "呃…我可不敢自己去看，要是被魔物发现了可就完蛋了…",
            "nextDialogs": [
              "411230806"
            ]
          },
          "411230806": {
            "id": "411230806",
            "speakerId": 1001,
            "speakerName": "胆小的莫罗",
            "text": "算了，不管你说的是真是假，我都得回去报告一声。",
            "nextDialogs": [
              "411230807"
            ]
          },
          "411230807": {
            "id": "411230807",
            "speakerId": 1001,
            "speakerName": "胆小的莫罗",
            "text": "要是你真把那些魔物都打倒了，镇子里的那些西风骑士总会有办法验证的。"
          }
        }
      }
    },
    {
      "subId": "4112309",
      "subQuestName": "向霍夫曼回报",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

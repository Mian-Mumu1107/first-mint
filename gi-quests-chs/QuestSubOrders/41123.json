              "411230902"
            ]
          },
          "411230902": {
            "id": "411230902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "清泉镇已经安全了。",
            "nextDialogs": [
              "411230903"
            ]
          },
          "411230903": {
            "id": "411230903",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "那就太好了…我还在发愁抽调不出人手来呢。",
            "nextDialogs": [
              "411230904"
            ]
          },
          "411230904": {
            "id": "411230904",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "十分感谢你，实在帮大忙了，这些谢礼请收下吧。",
            "nextDialogs": [
              "411230905"
            ]
          },
          "411230905": {
            "id": "411230905",
            "speakerId": 1000,
            "speakerName": "霍夫曼",
            "text": "唉，又是陨石，又是魔物…千万别再出什么乱子了。"
          }
        }
      }
    },

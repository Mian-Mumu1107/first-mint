            "id": "722480601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不，还需要准备一下。",
            "nextDialogs": [
              "722480602"
            ]
          },
          "722480602": {
            "id": "722480602",
            "speakerId": 20342,
            "speakerName": "阿倍良久",
            "text": "那就静候汝之佳音了。"
          }
        }
      }
    }
  ]
}
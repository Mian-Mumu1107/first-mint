        "dialogs": {
          "722480501": {
            "id": "722480501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "准备好了。",
            "nextDialogs": [
              "722480502"
            ]
          },
          "722480502": {
            "id": "722480502",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "那就祝汝……武运昌隆。"
          }
        }
      }
    },
    {
      "subId": "7224803",
      "subQuestName": "(test)挑战开始,失败回滚$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

      }
    },
    {
      "subId": "7224804",
      "subQuestName": "从残魂处取得供奉之物",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722480201"
        ],
        "dialogs": {
          "722480201": {
            "id": "722480201",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "啊…若是当时白夜国有如汝这般的勇士，也不会…",
            "nextDialogs": [
              "722480202"
            ]
          },
          "722480202": {
            "id": "722480202",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "唉，此事若成，那吾也可了却心愿。",
            "nextDialogs": [
              "722480203"
            ]
          },
          "722480203": {
            "id": "722480203",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "一定要、一定要将这些寄托吾念的贡品拿去供奉，供奉在我幽禁之所。如此才能…",
            "nextDialogs": [
              "722480204"
            ]
          },
          "722480204": {
            "id": "722480204",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "如此才能什么？",
            "nextDialogs": [
              "722480205"
            ]
          },
          "722480205": {
            "id": "722480205",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "如此才能…如此才能…",
            "nextDialogs": [
              "722480206"
            ]
          },
          "722480206": {
            "id": "722480206",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "唔，这位残魂先生看上去失魂落魄，说什么都没反应了…",
            "nextDialogs": [
              "722480207"
            ]
          },
          "722480207": {
            "id": "722480207",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，那就先带上贡品吧。",
            "nextDialogs": [
              "722480208"
            ]
          },
          "722480208": {
            "id": "722480208",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "不过残魂先生被幽禁在的高处，到底是什么地方呢？"
          }
        }
      }
    },
    {
      "subId": "7224806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

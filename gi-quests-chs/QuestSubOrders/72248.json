    {
      "subId": "7224805",
      "subQuestName": "与残魂对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722480301"
        ],
        "dialogs": {
          "722480301": {
            "id": "722480301",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "好像出现了一个残魂……",
            "nextDialogs": [
              "722480302"
            ]
          },
          "722480302": {
            "id": "722480302",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "吾乃…",
            "nextDialogs": [
              "722480303"
            ]
          },
          "722480303": {
            "id": "722480303",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
            "nextDialogs": [
              "722480304"
            ]
          },
          "722480304": {
            "id": "722480304",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "吾怎么可能被你们这些妄语谗言所击倒，吾怎么会被你们操纵的稚童幽禁！",
            "nextDialogs": [
              "722480305"
            ]
          },
          "722480305": {
            "id": "722480305",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "吾…不对，吾…吾在幽禁之所度过了无尽岁月，此时已是…生后之身？",
            "nextDialogs": [
              "722480306"
            ]
          },
          "722480306": {
            "id": "722480306",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "生后之身？是说自己已经死去的意思吗？",
            "nextDialogs": [
              "722480307"
            ]
          },
          "722480307": {
            "id": "722480307",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "能够意识到这点的残魂很少见啊。",
            "nextDialogs": [
              "722480308"
            ]
          },
          "722480308": {
            "id": "722480308",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "说来惭愧，但为何而死，吾已回想不出…",
            "nextDialogs": [
              "722480309"
            ]
          },
          "722480309": {
            "id": "722480309",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "只是记忆之中，吾被一个孩子下令关押至死。",
            "nextDialogs": [
              "722480310"
            ]
          },
          "722480310": {
            "id": "722480310",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一个孩子？",
            "nextDialogs": [
              "722480311"
            ]
          },
          "722480311": {
            "id": "722480311",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "正是，不过，时至今日，提起那个孩子吾也不觉得怨恨，只是觉得可怜。",
            "nextDialogs": [
              "722480312"
            ]
          },
          "722480312": {
            "id": "722480312",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "有错的，并不是他，有错的是将他视为掌中傀儡的…算了，不提也罢。",
            "nextDialogs": [
              "722480313"
            ]
          },
          "722480313": {
            "id": "722480313",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "那之后，吾就被幽禁…",
            "nextDialogs": [
              "722480314"
            ]
          },
          "722480314": {
            "id": "722480314",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "幽禁于一处…",
            "nextDialogs": [
              "722480315"
            ]
          },
          "722480315": {
            "id": "722480315",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "一处？",
            "nextDialogs": [
              "722480316"
            ]
          },
          "722480316": {
            "id": "722480316",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "一处很高的地方…",
            "nextDialogs": [
              "722480317"
            ]
          },
          "722480317": {
            "id": "722480317",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "虽然很高，但该处却黯淡无光，冷若冰窟。",
            "nextDialogs": [
              "722480318"
            ]
          },
          "722480318": {
            "id": "722480318",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "…咦，奇怪，为何呢？",
            "nextDialogs": [
              "722480319"
            ]
          },
          "722480319": {
            "id": "722480319",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "为何吾会觉得，高处本应是让人温暖舒畅的呢？",
            "nextDialogs": [
              "722480320"
            ]
          },
          "722480320": {
            "id": "722480320",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "为何…为何吾什么都想不起来？",
            "nextDialogs": [
              "722480321"
            ]
          },
          "722480321": {
            "id": "722480321",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "难道是因为肚子饿了？",
            "nextDialogs": [
              "722480322"
            ]
          },
          "722480322": {
            "id": "722480322",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我肚子饿的时候，别说动脑想什么了，连话都说不顺。",
            "nextDialogs": [
              "722480324",
              "722480326"
            ]
          },
          "722480324": {
            "id": "722480324",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "肯定就是嘛！你看他也话都说不清了。",
            "nextDialogs": [
              "722480327"
            ]
          },
          "722480327": {
            "id": "722480327",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "#啊，{NICKNAME}，你可以找找看，万一贡品里面有能吃的东西呢？",
            "nextDialogs": [
              "722480328"
            ]
          },
          "722480328": {
            "id": "722480328",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "是了！贡品！",
            "nextDialogs": [
              "722480329"
            ]
          },
          "722480329": {
            "id": "722480329",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "怎么样，是想吃贡品了吗？",
            "nextDialogs": [
              "722480330"
            ]
          },
          "722480330": {
            "id": "722480330",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "不，吾只是想起了…",
            "nextDialogs": [
              "722480331"
            ]
          },
          "722480331": {
            "id": "722480331",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "吾在幽禁至死后，因铸造赫利俄斯之功，残躯与衣冠在各处享有供奉。",
            "nextDialogs": [
              "722480332"
            ]
          },
          "722480332": {
            "id": "722480332",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "也是因此而魂魄分离，致使灵魂难安。",
            "nextDialogs": [
              "722480333"
            ]
          },
          "722480333": {
            "id": "722480333",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "此处本应供奉吾之圣冠，但是早已朽坏…恐怕这也是为何吾念头滞涩的原因。",
            "nextDialogs": [
              "722480334"
            ]
          },
          "722480334": {
            "id": "722480334",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "长此以往，恐怕连保持现在的状态都相当困难…",
            "nextDialogs": [
              "722480335"
            ]
          },
          "722480335": {
            "id": "722480335",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "但好在这些供奉品——这些贡品能代替残躯与衣冠，承载吾一丝念想。",
            "nextDialogs": [
              "722480336"
            ]
          },
          "722480336": {
            "id": "722480336",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "劳烦汝将之取走。",
            "nextDialogs": [
              "722480337"
            ]
          },
          "722480337": {
            "id": "722480337",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "不过供奉之路上有多重险阻，虽有冒犯之嫌，但也希望汝能接受一次考验…",
            "nextDialogs": [
              "722480338"
            ]
          },
          "722480338": {
            "id": "722480338",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "考验？什么考验？",
            "nextDialogs": [
              "722480339"
            ]
          },
          "722480339": {
            "id": "722480339",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "就请汝击败周围这些困守吾残魂的怪物吧…",
            "nextDialogs": [
              "722480340"
            ]
          },
          "722480340": {
            "id": "722480340",
            "speakerId": 20356,
            "speakerName": "阿倍良久",
            "text": "此事凶险，旅者啊，若汝准备好了，再与吾说吧。"
          },
          "722480326": {
            "id": "722480326",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "喂！"
          }
        }
      }
    },
    {
      "subId": "7224802",
      "subQuestName": "开启残魂的试炼",
      "sceneId": null,
      "locations": [],
      "dialogue": {

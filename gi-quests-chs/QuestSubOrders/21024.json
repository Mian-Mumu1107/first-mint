    {
      "subId": "2102408",
      "subQuestName": "与宝儿对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210240801"
        ],
        "dialogs": {
          "210240801": {
            "id": "210240801",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "你把「夜泊石」拿来了吗？"
          }
        }
      }
    },
    {
      "subId": "2102409",
      "subQuestName": "与兰达对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210240901"
        ],
        "dialogs": {
          "210240901": {
            "id": "210240901",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "您找到了货单了吗？",
            "nextDialogs": [
              "210240902"
            ]
          },
          "210240902": {
            "id": "210240902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "全部找到了。",
            "nextDialogs": [
              "210240903"
            ]
          },
          "210240903": {
            "id": "210240903",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "谢谢您，太感谢您了，太好了，总算没出大问题。",
            "nextDialogs": [
              "210240904"
            ]
          },
          "210240904": {
            "id": "210240904",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "要是这些货单丢了，老板不知道会发多大火。",
            "nextDialogs": [
              "210240905"
            ]
          },
          "210240905": {
            "id": "210240905",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "呃，您是想问「这些货单到底是什么生意」吧？",
            "nextDialogs": [
              "210240906"
            ]
          },
          "210240906": {
            "id": "210240906",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "抱歉，我真的不能告诉您，这些都是机密。",
            "nextDialogs": [
              "210240907"
            ]
          },
          "210240907": {
            "id": "210240907",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "这是您的报酬，请收…等会，这个盒子怎么被打开过？",
            "nextDialogs": [
              "210240908"
            ]
          },
          "210240908": {
            "id": "210240908",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "…在野外遇见了一个人，她捡到盒子之后打开看了？！",
            "nextDialogs": [
              "210240909"
            ]
          },
          "210240909": {
            "id": "210240909",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "完了，完了，全完了！不行…得快点去告诉老板…",
            "nextDialogs": [
              "210240910"
            ]
          },
          "210240910": {
            "id": "210240910",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "哦，您放心，我不会怀疑您的，毕竟您的事迹我已经…",
            "nextDialogs": [
              "210240911"
            ]
          },
          "210240911": {
            "id": "210240911",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "咳！我，我得想办法和老板联系了，请您去忙自己的事吧。"
          }
        }
      }
    },
    {
      "subId": "2102410",
      "subQuestName": "与宝儿对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210240802"
        ],
        "dialogs": {
          "210240802": {
            "id": "210240802",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "不错，这些「夜泊石」我就收下了。这是货单，你拿好了。",
            "nextDialogs": [
              "210240803"
            ]
          },
          "210240803": {
            "id": "210240803",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "好了，拿到了就快点走吧。那个托你办事的人，想必已经等得心急如焚了。"
          }
        }
      }
    },
    {
      "subId": "2102408",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210240820"
        ],
        "dialogs": {
          "210240820": {
            "id": "210240820",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "…只是看了一眼，应该不会惹上麻烦吧。"
          }
        }
      }
    }

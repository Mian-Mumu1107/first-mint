    {
      "subId": "2102406",
      "subQuestName": "与宝儿对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210240601"
        ],
        "dialogs": {
          "210240601": {
            "id": "210240601",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "看起来没什么用…",
            "nextDialogs": [
              "210240602"
            ]
          },
          "210240602": {
            "id": "210240602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请问你见过一个盒子吗…",
            "nextDialogs": [
              "210240603"
            ]
          },
          "210240603": {
            "id": "210240603",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "盒子？哦，我确实捡到了一个盒子。",
            "nextDialogs": [
              "210240604"
            ]
          },
          "210240604": {
            "id": "210240604",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "我已经打开看过了，是一批货单呢，看起来还是一笔很大的生意。",
            "nextDialogs": [
              "210240605"
            ]
          },
          "210240605": {
            "id": "210240605",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "哎呀，不知道这个盒子的主人，愿意付多少钱把盒子拿回去呢…",
            "nextDialogs": [
              "210240606"
            ]
          },
          "210240606": {
            "id": "210240606",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…什么意思？",
            "nextDialogs": [
              "210240607"
            ]
          },
          "210240607": {
            "id": "210240607",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "别这么一副紧张的样子，我就是和你开个玩笑。",
            "nextDialogs": [
              "210240608"
            ]
          },
          "210240608": {
            "id": "210240608",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "这货单上记的货物价值可不低，也不知道是璃月港里哪位大老板的大手笔。",
            "nextDialogs": [
              "210240609"
            ]
          },
          "210240609": {
            "id": "210240609",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "我可不是不识时务的人，既然知道大概是块铁板，那就没有还硬往上踢的理由。",
            "nextDialogs": [
              "210240610"
            ]
          },
          "210240610": {
            "id": "210240610",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "不过，我费心费力保管着这货单，你一句话就想要走，是不是…有点说不过去？",
            "nextDialogs": [
              "210240611"
            ]
          },
          "210240611": {
            "id": "210240611",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "这样好了，我们就用最传统的「以物易物」来解决这个问题。",
            "nextDialogs": [
              "210240612"
            ]
          },
          "210240612": {
            "id": "210240612",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "你去给我找三颗「夜泊石」来，我就把这货单给你，怎么样？",
            "nextDialogs": [
              "210240613"
            ]
          },
          "210240613": {
            "id": "210240613",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "毕竟，和这些货单上记着的大买卖相比…这三颗「夜泊石」可真算不上什么。",
            "nextDialogs": [
              "210240615",
              "210240618"
            ]
          },
          "210240615": {
            "id": "210240615",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "那你就快去找吧，找到了之后，我们再一手交石，一手交货。"
          },
          "210240618": {
            "id": "210240618",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "你不知道吗？你只是来帮别人办事…哼，这样也好。",
            "nextDialogs": [
              "210240619"
            ]
          },
          "210240619": {
            "id": "210240619",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "听我一句劝，这种规模的买卖，你还是不要多打听比较好。",
            "nextDialogs": [
              "210240620"
            ]
          },
          "210240620": {
            "id": "210240620",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "好了，你去把「夜泊石」拿来给我，我把货单给你，你再把货单给那个托你办事的人。",
            "nextDialogs": [
              "210240621"
            ]
          },
          "210240621": {
            "id": "210240621",
            "speakerId": 1001,
            "speakerName": "宝儿",
            "text": "事情办完，干净利落，一点麻烦也不惹。"
          }
        }
      }
    },
    {
      "subId": "2102407",

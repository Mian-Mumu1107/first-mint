  "subQuests": [
    {
      "subId": "2102401",
      "subQuestName": "与兰达对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "210240101"
        ],
        "dialogs": {
          "210240101": {
            "id": "210240101",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "这下可糟糕了…",
            "nextDialogs": [
              "210240102"
            ]
          },
          "210240102": {
            "id": "210240102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "发生什么了？",
            "nextDialogs": [
              "210240103"
            ]
          },
          "210240103": {
            "id": "210240103",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "啊？是旅行者啊…是这样，我是个商人，一直在蒙德城和璃月港之间跑生意。",
            "nextDialogs": [
              "210240104"
            ]
          },
          "210240104": {
            "id": "210240104",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "我刚在蒙德城做了笔大生意，正准备把货单带回去给老板…",
            "nextDialogs": [
              "210240105"
            ]
          },
          "210240105": {
            "id": "210240105",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "但是没想到，刚走到这附近，就被一群怪物袭击了。",
            "nextDialogs": [
              "210240106"
            ]
          },
          "210240106": {
            "id": "210240106",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "我又打不过这群怪物，只能掉头就跑，跌跌撞撞一直跑到了这客栈里面。",
            "nextDialogs": [
              "210240107"
            ]
          },
          "210240107": {
            "id": "210240107",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "但是我人跑掉了，货单却全部弄丢了…您能帮我找回来吗？",
            "nextDialogs": [
              "210240109",
              "210240112",
              "210240117"
            ]
          },
          "210240109": {
            "id": "210240109",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "太好了，我大概能记得我跑过的地方，这就给您标上…",
            "nextDialogs": [
              "210240110"
            ]
          },
          "210240110": {
            "id": "210240110",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "那些货单我都放在盒子里了，应该也不难找，就拜托您了。"
          },
          "210240112": {
            "id": "210240112",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "当然是酒啊，从蒙德还能跑什么生意。",
            "nextDialogs": [
              "210240113"
            ]
          },
          "210240113": {
            "id": "210240113",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "这可是笔大生意，要是出了问题，老板准要怪罪我。",
            "nextDialogs": [
              "210240114"
            ]
          },
          "210240114": {
            "id": "210240114",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "您就帮帮我吧。我把记得的大概位置都给标好了。",
            "nextDialogs": [
              "210240115"
            ]
          },
          "210240115": {
            "id": "210240115",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "那些货单我都放在盒子里了，应该也不难找，就拜托您了。"
          },
          "210240117": {
            "id": "210240117",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "我老板？啊…那个，是璃月港里一个很有钱的商人，很有钱。",
            "nextDialogs": [
              "210240118"
            ]
          },
          "210240118": {
            "id": "210240118",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "哎呀，你就别多问了，我就是个跑腿的，老板的事我也不清楚。",
            "nextDialogs": [
              "210240119"
            ]
          },
          "210240119": {
            "id": "210240119",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "但我要是把这笔生意给弄黄了，估计连跑腿的工作都没了。",
            "nextDialogs": [
              "210240120"
            ]
          },
          "210240120": {
            "id": "210240120",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "您就帮帮我吧。我把记得的大概位置都给标好了。",
            "nextDialogs": [
              "210240121"
            ]
          },
          "210240121": {
            "id": "210240121",
            "speakerId": 1000,
            "speakerName": "兰达",
            "text": "那些货单我都放在盒子里了，应该也不难找，就拜托您了。"
          }
        }
      }
    },

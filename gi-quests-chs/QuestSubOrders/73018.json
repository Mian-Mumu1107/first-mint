    {
      "subId": "7301805",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730180501"
        ],
        "dialogs": {
          "730180501": {
            "id": "730180501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "超近距离看感觉更震撼了…",
            "nextDialogs": [
              "730180502"
            ]
          },
          "730180502": {
            "id": "730180502",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "法留纳神机，来自草木之王的创造，带来生命的水，把巴螺迦变成桓那，过去的黄色用绿色替代，让不毛的土地从此充满生机。",
            "nextDialogs": [
              "730180503"
            ]
          },
          "730180503": {
            "id": "730180503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来好神奇哦，「带来生命的水」…唔…",
            "nextDialogs": [
              "730180504"
            ]
          },
          "730180504": {
            "id": "730180504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起来，之前喝了兰阿帕斯的汤，他的汤应该就是用这里的水烧的吧？",
            "nextDialogs": [
              "730180505"
            ]
          },
          "730180505": {
            "id": "730180505",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "…他的汤该不会有什么特别的效果吧…",
            "nextDialogs": [
              "730180507",
              "730180516"
            ]
          },
          "730180507": {
            "id": "730180507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#欸？那会是{NICKNAME}还是我呢？"
          },
          "730180516": {
            "id": "730180516",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，那岂不是可以吃遍提瓦特！",
            "nextDialogs": [
              "730180517"
            ]
          },
          "730180517": {
            "id": "730180517",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但一起享用美食的伙伴会逐渐凋零…",
            "nextDialogs": [
              "730180518"
            ]
          },
          "730180518": {
            "id": "730180518",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…活得太久，也不见得全是好事呢…"
          }
        }
      }
    }
  ]
}
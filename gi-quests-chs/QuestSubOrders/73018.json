    {
      "subId": "7301821",
      "subQuestName": "与兰般度对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730182101"
        ],
        "dialogs": {
          "730182101": {
            "id": "730182101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "现在应该…暂时安全了吧？",
            "nextDialogs": [
              "730182102"
            ]
          },
          "730182102": {
            "id": "730182102",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "#那菈{NICKNAME}，感谢你的勇敢，啃噬法留纳神机的根的坏虫被解决了。",
            "nextDialogs": [
              "730182103"
            ]
          },
          "730182103": {
            "id": "730182103",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "分散在桓那各处的枝叶也把力量源源传递，现在兰那罗可以治好法留纳神机了。",
            "nextDialogs": [
              "730182104"
            ]
          },
          "730182104": {
            "id": "730182104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "小事一桩。",
            "nextDialogs": [
              "730182105"
            ]
          },
          "730182105": {
            "id": "730182105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我就说，蕈兽根本就没什么可怕的嘛！再来十个也不怕！哼哼。",
            "nextDialogs": [
              "730182107",
              "730182109"
            ]
          },
          "730182107": {
            "id": "730182107",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#我就知道，{NICKNAME}才不会怕蕈兽呢，哼哼。",
            "nextDialogs": [
              "730182110"
            ]
          },
          "730182110": {
            "id": "730182110",
            "speakerId": 1004,
            "speakerName": "兰那库拉",
            "text": "刚才大家都在努力对付坏家伙，只有派蒙…",
            "nextDialogs": [
              "730182111"
            ]
          },
          "730182111": {
            "id": "730182111",
            "speakerId": 1003,
            "speakerName": "兰贡迪",
            "text": "一点力气也没出呢！",
            "nextDialogs": [
              "730182112"
            ]
          },
          "730182112": {
            "id": "730182112",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哪有！我…我可是使出全力给{NICKNAME}加油了，{NICKNAME}一定也感受到我的心意了吧！"
          },
          "730182109": {
            "id": "730182109",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸？那怎么行！"
          }
        }
      }
    },
    {
      "subId": "7301822",
      "subQuestName": "与兰般度对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730182201"
        ],
        "dialogs": {
          "730182201": {
            "id": "730182201",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇！感觉空气都清新了好多！",
            "nextDialogs": [
              "730182202"
            ]
          },
          "730182202": {
            "id": "730182202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "可以畅快呼吸了。",
            "nextDialogs": [
              "730182203"
            ]
          },
          "730182203": {
            "id": "730182203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嘿嘿，善见地这下也太平啦！不过不知道森林里的那些蕈兽…",
            "nextDialogs": [
              "730182204"
            ]
          },
          "730182204": {
            "id": "730182204",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "之后，坏家伙也许会离开，也许不会。但是法留纳神机已经治好，不会再有那么多「孢子」，兰那罗不会让坏家伙破坏桓那。",
            "nextDialogs": [
              "730182205"
            ]
          },
          "730182205": {
            "id": "730182205",
            "speakerId": 1004,
            "speakerName": "兰那库拉",
            "text": "苗圃也会恢复生机了吧…",
            "nextDialogs": [
              "730182206"
            ]
          },
          "730182206": {
            "id": "730182206",
            "speakerId": 1002,
            "speakerName": "兰百梨迦",
            "text": "但无留陀还在，兰那罗还有很多事要做。",
            "nextDialogs": [
              "730182207"
            ]
          },
          "730182207": {
            "id": "730182207",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…兰百梨迦真的好严格啊，现在至少完成了一件事嘛，就让兰那库拉高兴一下吧！",
            "nextDialogs": [
              "730182208"
            ]
          },
          "730182208": {
            "id": "730182208",
            "speakerId": 1002,
            "speakerName": "兰百梨迦",
            "text": "哼。",
            "nextDialogs": [
              "730182209"
            ]
          },
          "730182209": {
            "id": "730182209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还是老样子呢。",
            "nextDialogs": [
              "730182210"
            ]
          },
          "730182210": {
            "id": "730182210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…真不知道该怎么让他满意…",
            "nextDialogs": [
              "730182211"
            ]
          },
          "730182211": {
            "id": "730182211",
            "speakerId": 1002,
            "speakerName": "兰百梨迦",
            "text": "派蒙，没有紧张感。大意，会吃大亏。",
            "nextDialogs": [
              "730182212"
            ]
          },
          "730182212": {
            "id": "730182212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦，这话之前听过啦。派蒙哪有大意，派蒙总是很小心的！",
            "nextDialogs": [
              "730182213"
            ]
          },
          "730182213": {
            "id": "730182213",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "看来派蒙完全没记住教训。",
            "nextDialogs": [
              "730182214"
            ]
          },
          "730182214": {
            "id": "730182214",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#对了，我们还有件事想问问兰般度呢，对吧，{NICKNAME}？",
            "nextDialogs": [
              "730182215"
            ]
          },
          "730182215": {
            "id": "730182215",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "关于维摩庄的孩子…",
            "nextDialogs": [
              "730182216"
            ]
          },
          "730182216": {
            "id": "730182216",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是东边的维摩庄发生的怪事，在那里生活的孩子有时会失踪一段时间，但是之后又会平安回来…",
            "nextDialogs": [
              "730182217"
            ]
          },
          "730182217": {
            "id": "730182217",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "森林的事，兰那罗一定比我们更清楚吧，如果兰般度知道什么的话那就太好啦。",
            "nextDialogs": [
              "730182218"
            ]
          },
          "730182218": {
            "id": "730182218",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "维摩庄的怪事…现在还不知道，但是记下了，其他的兰那罗或许知道。",
            "nextDialogs": [
              "730182219"
            ]
          },
          "730182219": {
            "id": "730182219",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "之后会回桓那兰那，也许那时会有答案。",
            "nextDialogs": [
              "730182220"
            ]
          },
          "730182220": {
            "id": "730182220",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "#关于法留纳神机…那菈{NICKNAME}现在知道了，兰那罗的音乐可以控制法留纳神机。",
            "nextDialogs": [
              "730182221"
            ]
          },
          "730182221": {
            "id": "730182221",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#欸？{NICKNAME}之前也学过兰那罗的音乐对吧？那我们也可以控制法留纳神机了吗？",
            "nextDialogs": [
              "730182222"
            ]
          },
          "730182222": {
            "id": "730182222",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "#那菈{NICKNAME}已经证明了自己，就像那菈法留纳一样，配得上兰那罗的友谊。",
            "nextDialogs": [
              "730182223"
            ]
          },
          "730182223": {
            "id": "730182223",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "兰般度愿意将控制法留纳神机的乐谱教给你们。",
            "nextDialogs": [
              "730182224"
            ]
          },
          "730182224": {
            "id": "730182224",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好耶！不过，难道每次演奏都要下到这么深的地底吗…",
            "nextDialogs": [
              "730182225"
            ]
          },
          "730182225": {
            "id": "730182225",
            "speakerId": 1003,
            "speakerName": "兰贡迪",
            "text": "派蒙太不聪明，既然法留纳神机能从桓那各处获得力量…",
            "nextDialogs": [
              "730182226"
            ]
          },
          "730182226": {
            "id": "730182226",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "在桓那的别处也能控制法留纳神机。",
            "nextDialogs": [
              "730182227"
            ]
          },
          "730182227": {
            "id": "730182227",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这种兰那罗小知识正常来说都想不到的啦！",
            "nextDialogs": [
              "730182228"
            ]
          },
          "730182228": {
            "id": "730182228",
            "speakerId": 1005,
            "speakerName": "Black Screen",
            "text": "掌握了源水的曲调。",
            "nextDialogs": [
              "730182229"
            ]
          },
          "730182229": {
            "id": "730182229",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "#那菈{NICKNAME}，还有派蒙，感谢你们的帮助，桓那不会忘记，兰那罗也不会忘记…",
            "nextDialogs": [
              "730182230"
            ]
          },
          "730182230": {
            "id": "730182230",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "希望下次是在无忧节相见。",
            "nextDialogs": [
              "730182231"
            ]
          },
          "730182231": {
            "id": "730182231",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "我们会再次相见的，在桓那兰那，祝愿金色的那菈度过一段无忧的时光，兰穆护昆达看顾你们。"
          }
        }
      }
    },

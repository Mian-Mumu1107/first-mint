    {
      "subId": "7301808",
      "subQuestName": "与兰般度对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730180801"
        ],
        "dialogs": {
          "730180801": {
            "id": "730180801",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇——通往地下的入口…真的打开了！",
            "nextDialogs": [
              "730180802"
            ]
          },
          "730180802": {
            "id": "730180802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "有种失落的感觉。",
            "nextDialogs": [
              "730180803"
            ]
          },
          "730180803": {
            "id": "730180803",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "确实！开了个大洞…不过幸好不是心上开了个大洞？",
            "nextDialogs": [
              "730180804"
            ]
          },
          "730180804": {
            "id": "730180804",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "#那菈{NICKNAME}和派蒙，我们一起下去。",
            "nextDialogs": [
              "730180805"
            ]
          },
          "730180805": {
            "id": "730180805",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "但是之后的路，要非常小心。地下是阳光很少的暗处，过去是种子安眠的地方，现在可能是「蕈兽」的巢穴。",
            "nextDialogs": [
              "730180806"
            ]
          },
          "730180806": {
            "id": "730180806",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "#那菈{NICKNAME}和派蒙是兰那罗的伙伴，虽然兰那罗的力量不大，如果遇到危险，兰那罗会努力保护你们。",
            "nextDialogs": [
              "730180807"
            ]
          },
          "730180807": {
            "id": "730180807",
            "speakerId": 1002,
            "speakerName": "兰百梨迦",
            "text": "有兰百梨迦在，没什么可怕的。",
            "nextDialogs": [
              "730180808"
            ]
          },
          "730180808": {
            "id": "730180808",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#哦！我和{NICKNAME}可都是经历过大风大浪的！不会因为这点小事就害怕啦。",
            "nextDialogs": [
              "730180809"
            ]
          },
          "730180809": {
            "id": "730180809",
            "speakerId": 1003,
            "speakerName": "兰贡迪",
            "text": "下面应该没有大风，水，可能会有，但是没有大浪。",
            "nextDialogs": [
              "730180810"
            ]
          },
          "730180810": {
            "id": "730180810",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…兰贡迪还是这样只从字面理解别人的话呢…",
            "nextDialogs": [
              "730180811"
            ]
          },
          "730180811": {
            "id": "730180811",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「大风大浪」是说经历过很多事。",
            "nextDialogs": [
              "730180812"
            ]
          },
          "730180812": {
            "id": "730180812",
            "speakerId": 1003,
            "speakerName": "兰贡迪",
            "text": "现在懂了。派蒙讲话好难懂哦。",
            "nextDialogs": [
              "730180813"
            ]
          },
          "730180813": {
            "id": "730180813",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我们彼此彼此啦！",
            "nextDialogs": [
              "730180814"
            ]
          },
          "730180814": {
            "id": "730180814",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "总之，蕈兽什么的一点也不可怕嘛！如果真的是蕈兽的巢穴…今天晚饭就吃蘑菇全餐！",
            "nextDialogs": [
              "730180815"
            ]
          },
          "730180815": {
            "id": "730180815",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，准备好了的话，我们就快下去吧！"
          }
        }
      }
    },
    {
      "subId": "7301823",
      "subQuestName": "前往地下",
      "sceneId": null,
      "locations": [],

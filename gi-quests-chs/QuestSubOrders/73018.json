    {
      "subId": "7301802",
      "subQuestName": "与兰般度对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730180201"
        ],
        "dialogs": {
          "730180201": {
            "id": "730180201",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "#那菈{NICKNAME}，还有派蒙，感谢你们帮助了兰那罗。可以感受到，各处堵塞溪流的小枝已经被移除了。",
            "nextDialogs": [
              "730180202"
            ]
          },
          "730180202": {
            "id": "730180202",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哦！现在我们可以去治好法留纳神机了吧！",
            "nextDialogs": [
              "730180203"
            ]
          },
          "730180203": {
            "id": "730180203",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "很快，但是还没有。根系在很深很深的地下，通向地下的入口在法留纳法宝的中心。",
            "nextDialogs": [
              "730180204"
            ]
          },
          "730180204": {
            "id": "730180204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「法留纳法宝」，好像兰般度提过…",
            "nextDialogs": [
              "730180205"
            ]
          },
          "730180205": {
            "id": "730180205",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "#是法留纳神机的力量的显现，它发挥力量的时候，比桓那最高的树更高，那菈{NICKNAME}和派蒙早就见过。",
            "nextDialogs": [
              "730180206"
            ]
          },
          "730180206": {
            "id": "730180206",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是说那个时不时喷射水柱的地方？…难道我们要从那玩意儿的中心进去？！",
            "nextDialogs": [
              "730180208",
              "730180210"
            ]
          },
          "730180208": {
            "id": "730180208",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "对呀对呀！",
            "nextDialogs": [
              "730180211"
            ]
          },
          "730180211": {
            "id": "730180211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "万一我们准备进去的时候它正好启动了…",
            "nextDialogs": [
              "730180212"
            ]
          },
          "730180212": {
            "id": "730180212",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那么高的水柱，而且水势看起来也很强的样子…完全想不出来该怎么进到它的中心…"
          },
          "730180210": {
            "id": "730180210",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "喂！"
          }
        }
      }
    },
    {
      "subId": "7301806",
      "subQuestName": "前往「法留纳法宝」附近",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7301807",
      "subQuestName": "与兰般度对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730180401"
        ],
        "dialogs": {
          "730180401": {
            "id": "730180401",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "超近距离看感觉更震撼了…",
            "nextDialogs": [
              "730180402"
            ]
          },
          "730180402": {
            "id": "730180402",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "法留纳神机，来自草木之王的创造，带来生命的水，把巴螺迦变成桓那，过去的黄色用绿色替代，让不毛的土地从此充满生机。",
            "nextDialogs": [
              "730180403"
            ]
          },
          "730180403": {
            "id": "730180403",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "听起来好神奇哦，「带来生命的水」…唔…",
            "nextDialogs": [
              "730180404"
            ]
          },
          "730180404": {
            "id": "730180404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那这水能喝吗？会不会有什么特别的效果？",
            "nextDialogs": [
              "730180406",
              "730180415"
            ]
          },
          "730180406": {
            "id": "730180406",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#欸？那会是{NICKNAME}还是我呢？"
          },
          "730180415": {
            "id": "730180415",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哇，那岂不是可以吃遍提瓦特！",
            "nextDialogs": [
              "730180416"
            ]
          },
          "730180416": {
            "id": "730180416",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "但一起享用美食的伙伴会逐渐凋零…",
            "nextDialogs": [
              "730180417"
            ]
          },
          "730180417": {
            "id": "730180417",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…活得太久，也不见得全是好事呢…"
          }
        }
      }
    },
    {
      "subId": "7301828",
      "subQuestName": "与兰般度对话$HIDDEN",
      "sceneId": null,
      "locations": [],

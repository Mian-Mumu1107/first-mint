        ],
        "dialogs": {
          "730181401": {
            "id": "730181401",
            "speakerId": 1004,
            "speakerName": "兰那库拉",
            "text": "#那菈{NICKNAME}要和兰那库拉一起去照料苗圃吗？虽然现在还什么也没有…",
            "nextDialogs": [
              "730181402"
            ]
          },
          "730181402": {
            "id": "730181402",
            "speakerId": 1004,
            "speakerName": "兰那库拉",
            "text": "不过只要种下种子，很快，很快就会长出好看的花…"

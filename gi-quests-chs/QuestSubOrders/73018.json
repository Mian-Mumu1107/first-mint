    {
      "subId": "7301809",
      "subQuestName": "前往深处",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730180901"
        ],
        "dialogs": {
          "730180901": {
            "id": "730180901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这、这里可比荼诃之座深多了…没想到居然在地下这么深的地方。",
            "nextDialogs": [
              "730180902"
            ]
          },
          "730180902": {
            "id": "730180902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "而且，好多孢子！光是看到已经觉得难受了…",
            "nextDialogs": [
              "730180903"
            ]
          },
          "730180903": {
            "id": "730180903",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "法留纳神机…被「孢子」给覆盖了…",
            "nextDialogs": [
              "730180904"
            ]
          },
          "730180904": {
            "id": "730180904",
            "speakerId": 1004,
            "speakerName": "兰那库拉",
            "text": "一定是坏家伙留下的…呜呜…坏家伙，可能就在附近…",
            "nextDialogs": [
              "730180905"
            ]
          },
          "730180905": {
            "id": "730180905",
            "speakerId": 1002,
            "speakerName": "兰百梨迦",
            "text": "兰那库拉，不要退缩。已经到了这里，就要把问题解决，无论是「孢子」还是「蕈兽」。这都是为了桓那。",
            "nextDialogs": [
              "730180906"
            ]
          },
          "730180906": {
            "id": "730180906",
            "speakerId": 1003,
            "speakerName": "兰贡迪",
            "text": "被「孢子」裹住，法留纳神机一定也很难过。",
            "nextDialogs": [
              "730180907"
            ]
          },
          "730180907": {
            "id": "730180907",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "是哦…被孢子裹住…想想都觉得可怕…",
            "nextDialogs": [
              "730180908"
            ]
          },
          "730180908": {
            "id": "730180908",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "赶快把孢子清理掉吧。",
            "nextDialogs": [
              "730180909"
            ]
          },
          "730180909": {
            "id": "730180909",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "嗯！就像之前清理谒颂幽境的纪念碑那样，「啪啦」一下清理干净就可以了吧。"
          }
        }
      }
    },
    {
      "subId": "7301810",
      "subQuestName": "清除孢子",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730181001"
        ],
        "dialogs": {
          "730181001": {
            "id": "730181001",
            "speakerId": 1000,
            "speakerName": "兰般度",
            "text": "#兰那罗来得不算太晚，但是…坏种子比好种子长得更快，唔…拜托那菈{NICKNAME}，把坏种子清除…"
          }
        }
      }
    },

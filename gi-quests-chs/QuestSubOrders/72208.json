        "dialogs": {
          "722080101": {
            "id": "722080101",
            "speakerId": 20430,
            "speakerName": "伊部",
            "text": "呵呵，虽然钓技不错，但还有提高空间哦。",
            "nextDialogs": [
              "722080104"
            ]
          },
          "722080104": {
            "id": "722080104",
            "speakerId": 20430,
            "speakerName": "伊部",
            "text": "哎呀，对不起，对不起…总是忘了打招呼，忘记自己会吓到别人…呵呵。",
            "nextDialogs": [
              "722080105"
            ]
          },
          "722080105": {
            "id": "722080105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "居然还一副乐在其中的样子…",
            "nextDialogs": [
              "722080106"
            ]
          },
          "722080106": {
            "id": "722080106",
            "speakerId": 20430,
            "speakerName": "伊部",
            "text": "没办法嘛，偶尔吓唬一下小孩子还是挺好玩的…",
            "nextDialogs": [
              "722080107"
            ]
          },
          "722080107": {
            "id": "722080107",
            "speakerId": 20430,
            "speakerName": "伊部",
            "text": "咳咳，我们说回钓鱼的事情吧？"
          }
        }
      }
    },
    {

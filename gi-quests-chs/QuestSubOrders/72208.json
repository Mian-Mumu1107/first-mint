            ]
          },
          "722080404": {
            "id": "722080404",
            "speakerId": 20430,
            "speakerName": "伊部",
            "text": "在逢岳之野西边，面对着三重瀑布的小岛…我要的东西就在那小岛更西边的海里呢…"
          }

        "dialogs": {
          "736889901": {
            "id": "736889901",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "时间差不多啦，我们快去神里屋敷接绫华吧！等了这么久，总算能看到绫华穿上表演服的样子了！",
            "nextDialogs": [
              "736889902"
            ]
          },
          "736889902": {
            "id": "736889902",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "这种压迫感…不愧是将军大人指定的特使。",
            "nextDialogs": [

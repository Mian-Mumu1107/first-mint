    {
      "subId": "7368805",
      "subQuestName": "战胜魔偶剑豪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880501"
        ],
        "dialogs": {
          "736880501": {
            "id": "736880501",
            "speakerId": 1007,
            "speakerName": "由宇",
            "text": "往届的「代神使」穿的都是传统服饰，今天还真是不一样。"
          }
        }
      }
    },
    {
      "subId": "7368809",
      "subQuestName": "战胜魔偶剑豪",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880901"
        ],
        "dialogs": {
          "736880901": {
            "id": "736880901",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "旅行者，你准备好了吗？",
            "nextDialogs": [
              "736880903",
              "736880905"
            ]
          },
          "736880903": {
            "id": "736880903",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "好，接下来的战斗，就请你多关照了。"
          },
          "736880905": {
            "id": "736880905",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "别着急，现在还有些时间，等你一切处理妥当，我们再一起进入赛场。"
          }
        }
      }
    },
    {
      "subId": "7368806",
      "subQuestName": "与神里绫华对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7368803",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880301"
        ],
        "dialogs": {
          "736880301": {
            "id": "736880301",
            "speakerId": 1007,
            "speakerName": "由宇",
            "text": "你们看，是神里小姐和旅行者来了！",
            "nextDialogs": [
              "736880302"
            ]
          },
          "736880302": {
            "id": "736880302",
            "speakerId": 1008,
            "speakerName": "纱江",
            "text": "虽然之前在小说的插图里见过这套服装，但穿在神里小姐身上，却有种很独特的风采。",
            "nextDialogs": [
              "736880303"
            ]
          },
          "736880303": {
            "id": "736880303",
            "speakerId": 1009,
            "speakerName": "松前",
            "text": "不枉我一大早就来排队，抢到了表演赛第一排的位置，今天的比赛一定会很精彩！",
            "nextDialogs": [
              "736880304"
            ]
          },
          "736880304": {
            "id": "736880304",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "哇，果然绫华一出现，就成为大家的注目焦点了。",
            "nextDialogs": [
              "736880305"
            ]
          },
          "736880305": {
            "id": "736880305",
            "speakerId": 1001,
            "speakerName": "玲菜",
            "text": "各位观众，请大家安静，「演武传心」表演赛马上就要开始了，请各位有序进入赛场入座。",
            "nextDialogs": [
              "736880306"
            ]
          },
          "736880306": {
            "id": "736880306",
            "speakerId": 1001,
            "speakerName": "玲菜",
            "text": "神里小姐，旅行者，你们二位也请跟我一起进去吧。",
            "nextDialogs": [
              "736880307"
            ]
          },
          "736880307": {
            "id": "736880307",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "旅行者，你准备好了吗？",
            "nextDialogs": [
              "736880309",
              "736880311"
            ]
          },
          "736880309": {
            "id": "736880309",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "好，接下来的战斗，就请你多关照了。"
          },
          "736880311": {
            "id": "736880311",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "别着急，现在还有些时间，等你一切处理妥当，我们再一起进入赛场。"
          }
        }
      }
    },

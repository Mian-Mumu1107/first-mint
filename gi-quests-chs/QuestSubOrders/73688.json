            "speakerId": 1005,
            "speakerName": "宏达",
            "text": "小姐这身衣服很好看，能看出她自己也十分喜欢。",
            "nextDialogs": [
              "736881002"
            ]
          },
          "736881002": {
            "id": "736881002",
            "speakerId": 1005,
            "speakerName": "宏达",
            "text": "比赛在即，看到你和小姐两人都神色自若，我就放心了。"

  "subQuests": [
    {
      "subId": "7368801",
      "subQuestName": "听取比赛的最终结果",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880101"
        ],
        "dialogs": {
          "736880101": {
            "id": "736880101",
            "speakerId": 1000,
            "speakerName": "晓月左卫门十藏",
            "text": "阁下武艺精湛，这场较量在下输得心服口服。",
            "nextDialogs": [
              "736880102"
            ]
          },
          "736880102": {
            "id": "736880102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "承让了。",
            "nextDialogs": [
              "736880103"
            ]
          },
          "736880103": {
            "id": "736880103",
            "speakerId": 1001,
            "speakerName": "玲菜",
            "text": "#各位观众，经过刚才令人热血沸腾的一战，本届「演武传心剑道大赛」的冠军已经产生，那就是——{NICKNAME}！",
            "nextDialogs": [
              "736880104"
            ]
          },
          "736880104": {
            "id": "736880104",
            "speakerId": 1001,
            "speakerName": "玲菜",
            "text": "#明天，我们将迎来最后的表演赛环节：由{NICKNAME}与神里小姐一起，迎战将军大人的特使，人形机关剑士「魔偶剑豪」。",
            "nextDialogs": [
              "736880105"
            ]
          },
          "736880105": {
            "id": "736880105",
            "speakerId": 1001,
            "speakerName": "玲菜",
            "text": "各位，我们届时不见不散！",
            "nextDialogs": [
              "736880106"
            ]
          },
          "736880106": {
            "id": "736880106",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "旅行者，真是一场精彩的比赛。",
            "nextDialogs": [
              "736880107"
            ]
          },
          "736880107": {
            "id": "736880107",
            "speakerId": 1003,
            "speakerName": "柊千里",
            "text": "恭喜你旅行者，这个冠军颁给你的确是实至名归。",
            "nextDialogs": [
              "736880108"
            ]
          },
          "736880108": {
            "id": "736880108",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "只是没想到明天的对手竟然是「魔偶剑豪」，这个名字听起来和我们在八酝岛野外遇到的那个家伙很像，总感觉不太好对付呢。",
            "nextDialogs": [
              "736880109"
            ]
          },
          "736880109": {
            "id": "736880109",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "派蒙不用担心，虽然特使的实力强劲，但明天的比赛并不限制使用神之眼，我们还是拿回了一些主动权。",
            "nextDialogs": [
              "736880110"
            ]
          },
          "736880110": {
            "id": "736880110",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "而且，只要我们见招拆招，总能找到还击的机会。",
            "nextDialogs": [
              "736880111"
            ]
          },
          "736880111": {
            "id": "736880111",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "绫华这么说我就放心多了！",
            "nextDialogs": [
              "736880112"
            ]
          },
          "736880112": {
            "id": "736880112",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "最终能不能取胜，我其实也并无把握。但只有尽全力战斗，才能为观众们呈现出最精彩的表演。",
            "nextDialogs": [
              "736880115"
            ]
          },
          "736880115": {
            "id": "736880115",
            "speakerId": 1003,
            "speakerName": "柊千里",
            "text": "你们两个可真有干劲呢，那今天晚上可要好好休息，养精蓄锐。",
            "nextDialogs": [
              "736880116"
            ]
          },
          "736880116": {
            "id": "736880116",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "嗯，明天一觉醒来就能看到绫华的新衣服了。穿着枫丹服饰的绫华…哎呀，好期待。",
            "nextDialogs": [
              "736880117"
            ]
          },
          "736880117": {
            "id": "736880117",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "唔，这个…"
          }
        }
      }
    },
    {
      "subId": "7368802",
      "subQuestName": "等待至第二天上午（5点~12点）",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880201"
        ],
        "dialogs": {
          "736880201": {
            "id": "736880201",
            "speakerId": 1005,
            "speakerName": "宏达",
            "text": "二位，你们来了。",
            "nextDialogs": [
              "736880202"
            ]
          },
          "736880202": {
            "id": "736880202",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "呃啊，竟然是宏达！",
            "nextDialogs": [
              "736880203"
            ]
          },
          "736880203": {
            "id": "736880203",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "#前几天的比赛{NICKNAME}已经赢了你，而且还拿了冠军，你现在还有什么话说！",
            "nextDialogs": [
              "736880204"
            ]
          },
          "736880204": {
            "id": "736880204",
            "speakerId": 1005,
            "speakerName": "宏达",
            "text": "请放心，我并非是来挑剔二位的，而是来道歉的。旅行者，几天前与你的一战，我输得心服口服。",
            "nextDialogs": [
              "736880205"
            ]
          },
          "736880205": {
            "id": "736880205",
            "speakerId": 1005,
            "speakerName": "宏达",
            "text": "阁下剑术精湛，出招犀利却不咄咄逼人，足见品性。之前我错判了阁下的为人，言行对你多有冒犯，还请你见谅。",
            "nextDialogs": [
              "736880208"
            ]
          },
          "736880208": {
            "id": "736880208",
            "speakerId": 1005,
            "speakerName": "宏达",
            "text": "二位今天是来接神里小姐的吧？小姐现在正在室内整理着装，应该很快就会出来。",
            "nextDialogs": [
              "736880209"
            ]
          },
          "736880209": {
            "id": "736880209",
            "speakerId": 1005,
            "speakerName": "宏达",
            "text": "旅行者，趁小姐来之前，我有个不情之请，希望您能答应。",
            "nextDialogs": [
              "736880210"
            ]
          },
          "736880210": {
            "id": "736880210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "好的，请讲。",
            "nextDialogs": [
              "736880211"
            ]
          },
          "736880211": {
            "id": "736880211",
            "speakerId": 1005,
            "speakerName": "宏达",
            "text": "小姐她虽然从没有对我们这些家臣提过今天的表演赛，但最近小姐每天无论多忙，晚上一定会抽出几个时辰练习剑术。",
            "nextDialogs": [
              "736880212"
            ]
          },
          "736880212": {
            "id": "736880212",
            "speakerId": 1005,
            "speakerName": "宏达",
            "text": "小姐向来勤勉认真，虽说今天是表演赛，不取胜也无妨，但按照小姐的心性，一定会全力以赴，忘我奋战。",
            "nextDialogs": [
              "736880213"
            ]
          },
          "736880213": {
            "id": "736880213",
            "speakerId": 1005,
            "speakerName": "宏达",
            "text": "身为家臣，我当然相信小姐的实力，只不过…还是希望你能在赛场上支援小姐，保护小姐的安全。",
            "nextDialogs": [
              "736880214"
            ]
          },
          "736880214": {
            "id": "736880214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "请放心吧，我一定会的。",
            "nextDialogs": [
              "736880215"
            ]
          },
          "736880215": {
            "id": "736880215",
            "speakerId": 1005,
            "speakerName": "宏达",
            "text": "旅行者，那小姐就拜托你了。",
            "nextDialogs": [
              "736880217"
            ]
          },
          "736880217": {
            "id": "736880217",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "喔，应该是绫华出来了吧！",
            "nextDialogs": [
              "736880218"
            ]
          },
          "736880218": {
            "id": "736880218",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "哇…",
            "nextDialogs": [
              "736880219"
            ]
          },
          "736880219": {
            "id": "736880219",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "咦，怎么了，你们两个都这样一言不发…是这身装扮有哪里不妥吗？",
            "nextDialogs": [
              "736880220"
            ]
          },
          "736880220": {
            "id": "736880220",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "不是的！绫华，你这样真好看…有种眼前一亮的感觉！"
          }
        }
      }
    },
    {
      "subId": "7368803",
      "subQuestName": "前往神里屋敷",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7368804",
      "subQuestName": "前往赛场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880401"
        ],
        "dialogs": {
          "736880401": {
            "id": "736880401",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "#{NICKNAME}，绫华，我们在这里呢！",
            "nextDialogs": [
              "736880402"
            ]
          },
          "736880402": {
            "id": "736880402",
            "speakerId": 1003,
            "speakerName": "柊千里",
            "text": "真是一场精彩的比赛，即使我不怎么懂剑术，也完全被赛场上紧张的气氛感染了，都过了这么久，心脏还在扑通扑通直跳呢。",
            "nextDialogs": [
              "736880403"
            ]
          },
          "736880403": {
            "id": "736880403",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "是呀，好几次敌人的出招都吓了我一大跳，但你们两个却像是早有防备似的，一下子就轻松化解了。",
            "nextDialogs": [
              "736880404"
            ]
          },
          "736880404": {
            "id": "736880404",
            "speakerId": 1006,
            "speakerName": "九条裟罗",
            "text": "旅行者，神里小姐，祝贺你们获得了表演赛的胜利。",
            "nextDialogs": [
              "736880405"
            ]
          },
          "736880405": {
            "id": "736880405",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "哇，是裟罗，原来你也来看比赛了。",
            "nextDialogs": [
              "736880406"
            ]
          },
          "736880406": {
            "id": "736880406",
            "speakerId": 1006,
            "speakerName": "九条裟罗",
            "text": "我奉将军大人之命，前来见证这场赛事。二位剑术精湛，配合默契，不仅向观众们展现了剑道之美，也让我受教良多。",
            "nextDialogs": [
              "736880407"
            ]
          },
          "736880407": {
            "id": "736880407",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "您过奖了。",
            "nextDialogs": [
              "736880408"
            ]
          },
          "736880408": {
            "id": "736880408",
            "speakerId": 1006,
            "speakerName": "九条裟罗",
            "text": "几位从赛事筹备之初就在不停奔忙，今天又为演武传心划上了完美的句号，这些付出将军大人都看在眼里。",
            "nextDialogs": [
              "736880409"
            ]
          },
          "736880409": {
            "id": "736880409",
            "speakerId": 1006,
            "speakerName": "九条裟罗",
            "text": "接下来，我会回天守阁，向将军大人如实禀报这次表演赛的情况。诸位，我就先告辞了。",
            "nextDialogs": [
              "736880411"
            ]
          },
          "736880411": {
            "id": "736880411",
            "speakerId": 1003,
            "speakerName": "柊千里",
            "text": "对了，大家接下来有什么打算，不如到乌有亭去开庆功宴怎么样？",
            "nextDialogs": [
              "736880412"
            ]
          },
          "736880412": {
            "id": "736880412",
            "speakerId": 1004,
            "speakerName": "派蒙",
            "text": "太好啦！这些天每天都在想比赛的事，好久没有好好吃顿饭了！我们快走吧。",
            "nextDialogs": [
              "736880413"
            ]
          },
          "736880413": {
            "id": "736880413",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "呼…",
            "nextDialogs": [
              "736880414"
            ]
          },
          "736880414": {
            "id": "736880414",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "怎么了，绫华？",
            "nextDialogs": [
              "736880415"
            ]
          },
          "736880415": {
            "id": "736880415",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "没什么，只是现在我才渐渐有了一些赢得比赛的实感。九条裟罗小姐刚才说，这场比赛让她受教良多，其实我也是一样。",
            "nextDialogs": [
              "736880416"
            ]
          },
          "736880416": {
            "id": "736880416",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "虽然旁人在台下可能没有察觉，但我知道，刚才很多次我能够化险为夷，都是因为有你在旁边，适时引开了对手的攻击。",
            "nextDialogs": [
              "736880417"
            ]
          },
          "736880417": {
            "id": "736880417",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "如果没有你在身边，仅凭我一个人，肯定是无法取得胜利的。果然在剑术的造诣上，我还远远比不上你。",
            "nextDialogs": [
              "736880420"
            ]
          },
          "736880420": {
            "id": "736880420",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "真的吗？听你这么说，现在突然很想和你比一场了呢。",
            "nextDialogs": [
              "736880421"
            ]
          },
          "736880421": {
            "id": "736880421",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "不瞒你说，自从我认识你以来，就一直希望能有机会和你好好切磋武艺。今天在表演赛上，这个愿望大概算是实现了一半。",
            "nextDialogs": [
              "736880422"
            ]
          },
          "736880422": {
            "id": "736880422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "下次找个时间，让我们一决胜负。",
            "nextDialogs": [
              "736880423"
            ]
          },
          "736880423": {
            "id": "736880423",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "好。但…在此之前，你要好好保管好自己的佩剑哦？如果哪天被我偷走了，你的性命，也就交到我的手上啦。",
            "nextDialogs": [
              "736880424"
            ]
          },
          "736880424": {
            "id": "736880424",
            "speakerId": 1002,
            "speakerName": "神里绫华",
            "text": "嘿嘿…我一直很想说说看这种句子，应该不会很奇怪吧？"
          }
        }
      }
    },
    {
      "subId": "7368808",
      "subQuestName": "进入赛场",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736880801"
        ],
        "dialogs": {
          "736880801": {
            "id": "736880801",
            "speakerId": 1001,
            "speakerName": "玲菜",
            "text": "大家都很期待这场表演赛，加油啊，旅行者！"
          }
        }
      }
    },
    {
      "subId": "7368807",
      "subQuestName": "准备开始表演赛",

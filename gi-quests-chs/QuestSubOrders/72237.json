    {
      "subId": "7223708",
      "subQuestName": "与安贞的残影对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722370501"
        ],
        "dialogs": {
          "722370501": {
            "id": "722370501",
            "speakerId": 1004,
            "speakerName": "安贞",
            "text": "你们拿到书了吗？",
            "nextDialogs": [
              "722370502"
            ]
          },
          "722370502": {
            "id": "722370502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "拿到了。安贞你确实是无辜的。",
            "nextDialogs": [
              "722370503"
            ]
          },
          "722370503": {
            "id": "722370503",
            "speakerId": 1004,
            "speakerName": "安贞",
            "text": "从刚才的话来看，你们并不是地走官，有点可惜。不然就能现场正式承认我的无罪了。",
            "nextDialogs": [
              "722370504"
            ]
          },
          "722370504": {
            "id": "722370504",
            "speakerId": 1004,
            "speakerName": "安贞",
            "text": "不然就能立刻证明我的清白了。",
            "nextDialogs": [
              "722370505"
            ]
          },
          "722370505": {
            "id": "722370505",
            "speakerId": 1004,
            "speakerName": "安贞",
            "text": "我现在感觉非常精神，但是之前那种流血过多的疲倦感也很真实。我是不是真的快要死了所以回光返照啊？",
            "nextDialogs": [
              "722370506"
            ]
          },
          "722370506": {
            "id": "722370506",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…",
            "nextDialogs": [
              "722370507"
            ]
          },
          "722370507": {
            "id": "722370507",
            "speakerId": 1004,
            "speakerName": "安贞",
            "text": "唉，我问你啊，陌生人。被白夜国所判的冤罪，是罪孽吗？",
            "nextDialogs": [
              "722370508"
            ]
          },
          "722370508": {
            "id": "722370508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "…",
            "nextDialogs": [
              "722370509"
            ]
          },
          "722370509": {
            "id": "722370509",
            "speakerId": 1004,
            "speakerName": "安贞",
            "text": "如果此刻的我，因为这种难以平复的心境，被常世大神留为罪影。这是罪孽吗？",
            "nextDialogs": [
              "722370510"
            ]
          },
          "722370510": {
            "id": "722370510",
            "speakerId": 1004,
            "speakerName": "安贞",
            "text": "我，有罪吗？",
            "nextDialogs": [
              "722370511"
            ]
          },
          "722370511": {
            "id": "722370511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你没有罪。",
            "nextDialogs": [
              "722370512"
            ]
          },
          "722370512": {
            "id": "722370512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "#喂，{NICKNAME}，你要小心点说话。让他意识到了…意识到那件事的话，他会消失的。",
            "nextDialogs": [
              "722370513"
            ]
          },
          "722370513": {
            "id": "722370513",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你只是安贞留下的残影。",
            "nextDialogs": [
              "722370514"
            ]
          },

    {
      "subId": "1103205",
      "subQuestName": "与「群玉阁」的秘书们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1103204",
      "subQuestName": "与「群玉阁」的秘书们对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110320301"
        ],
        "dialogs": {
          "110320301": {
            "id": "110320301",
            "speakerId": 2142,
            "speakerName": "百识",
            "text": "啊…",
            "nextDialogs": [
              "110320302"
            ]
          },
          "110320302": {
            "id": "110320302",
            "speakerId": 2143,
            "speakerName": "百闻",
            "text": "阿识，你还好吗…难道说站着睡着了…",
            "nextDialogs": [
              "110320303"
            ]
          },
          "110320303": {
            "id": "110320303",
            "speakerId": 2140,
            "speakerName": "百晓",
            "text": "你们看…你们看看是谁来了！",
            "nextDialogs": [
              "110320304"
            ]
          },
          "110320304": {
            "id": "110320304",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "居然还有闲情雅致在这里偷懒，看来你们确实有接替我的能力。",
            "nextDialogs": [
              "110320305"
            ]
          },
          "110320305": {
            "id": "110320305",
            "speakerId": 2143,
            "speakerName": "百闻",
            "text": "没有没有！我们只是…真的连续工作了太久，如果不出来稍微歇歇…",
            "nextDialogs": [
              "110320306"
            ]
          },
          "110320306": {
            "id": "110320306",
            "speakerId": 2140,
            "speakerName": "百晓",
            "text": "恐怕就熬不到见到甘雨小姐的这天了…",
            "nextDialogs": [
              "110320307"
            ]
          },
          "110320307": {
            "id": "110320307",
            "speakerId": 2142,
            "speakerName": "百识",
            "text": "甘雨小姐，我们好想你…",
            "nextDialogs": [
              "110320308"
            ]
          },
          "110320308": {
            "id": "110320308",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "唔，我好像和各位只有过一面之缘而已，竟然说得这么亲昵…",
            "nextDialogs": [
              "110320309"
            ]
          },
          "110320309": {
            "id": "110320309",
            "speakerId": 2143,
            "speakerName": "百闻",
            "text": "因为我们最近日日夜夜都在盼着您回来，把工作重新接手…",
            "nextDialogs": [
              "110320310"
            ]
          },
          "110320310": {
            "id": "110320310",
            "speakerId": 2142,
            "speakerName": "百识",
            "text": "您的出现对我们来说，就像仙人下凡拯救苍生一样…",
            "nextDialogs": [
              "110320311"
            ]
          },
          "110320311": {
            "id": "110320311",
            "speakerId": 2140,
            "speakerName": "百晓",
            "text": "以往那些不服输的心情都已经不重要了，只想快点从这繁重的工作解脱…",
            "nextDialogs": [
              "110320312"
            ]
          },
          "110320312": {
            "id": "110320312",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "好了好了，我知道了。",
            "nextDialogs": [
              "110320313"
            ]
          },
          "110320313": {
            "id": "110320313",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "请把手上的工作按照政务、商务、民事来分开归类，标记好哪些未开始，哪些已经在进行中…",
            "nextDialogs": [
              "110320314"
            ]
          },
          "110320314": {
            "id": "110320314",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "剩下的交给我就好。",
            "nextDialogs": [
              "110320315"
            ]
          },
          "110320315": {
            "id": "110320315",
            "speakerId": 2143,
            "speakerName": "百闻",
            "text": "好的！我们现在就去办！",
            "nextDialogs": [
              "110320316"
            ]
          },
          "110320316": {
            "id": "110320316",
            "speakerId": 2142,
            "speakerName": "百识",
            "text": "终于…得救了…",
            "nextDialogs": [
              "110320317"
            ]
          },
          "110320317": {
            "id": "110320317",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "啊，对了，还有一件事…",
            "nextDialogs": [
              "110320318"
            ]
          },
          "110320318": {
            "id": "110320318",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "旅行者，我要郑重向你道谢，多亏了你这段时间的陪伴…不然我可能还陷在内心的困境里。",
            "nextDialogs": [
              "110320321"
            ]
          },
          "110320321": {
            "id": "110320321",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "呵呵，在工作之外，能拥有一位人类朋友的感觉，真是超乎预想的开心呢。",
            "nextDialogs": [
              "110320322"
            ]
          },
          "110320322": {
            "id": "110320322",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "等我忙完手上的工作，作为回报，请让我也陪你一起…参与你的一小段旅行吧？",
            "nextDialogs": [
              "110320323"
            ]
          },
          "110320323": {
            "id": "110320323",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "可、可是…甘雨小姐的工作，真的忙得完吗？",
            "nextDialogs": [
              "110320324"
            ]
          },
          "110320324": {
            "id": "110320324",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "…欸。",
            "nextDialogs": [
              "110320325"
            ]
          },
          "110320325": {
            "id": "110320325",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "嗯…嗯。未来的事，那就留待未来分说吧…"
          }
        }
      }
    }
  ]
}
    {
      "subId": "1103202",
      "subQuestName": "与慧心对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110320201"
        ],
        "dialogs": {
          "110320201": {
            "id": "110320201",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "甘雨前辈，感谢您的赏光。还有这二位，也感谢你们能来捧场。",
            "nextDialogs": [
              "110320202"
            ]
          },
          "110320202": {
            "id": "110320202",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "小事小事！",
            "nextDialogs": [
              "110320203"
            ]
          },
          "110320203": {
            "id": "110320203",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "辛苦慧心安排了，明明不用如此费周折的。",
            "nextDialogs": [
              "110320204"
            ]
          },
          "110320204": {
            "id": "110320204",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "呵呵，其实…甘雨前辈，除了感谢您之前的帮助，还有些事情想要跟您讲…",
            "nextDialogs": [
              "110320205"
            ]
          },
          "110320205": {
            "id": "110320205",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "哦？有什么需要帮忙的，你都可以跟我直说，不需要避讳什么的。",
            "nextDialogs": [
              "110320206"
            ]
          },
          "110320206": {
            "id": "110320206",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "啊…不不，其实也不算是需要帮忙…嗯…您可以慢慢听我说吗？",
            "nextDialogs": [
              "110320207"
            ]
          },
          "110320207": {
            "id": "110320207",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "我非常愿意。",
            "nextDialogs": [
              "110320208"
            ]
          },
          "110320208": {
            "id": "110320208",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "呵呵…我从很小很小的时候，就曾听父亲讲过很多有关甘雨前辈的故事。",
            "nextDialogs": [
              "110320209"
            ]
          },
          "110320209": {
            "id": "110320209",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "虽然我对父亲也一直非常敬佩，但每次都还是会被甘雨前辈的温柔可靠所吸引…",
            "nextDialogs": [
              "110320210"
            ]
          },
          "110320210": {
            "id": "110320210",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "我那时是如此向往着您的身影，也正是因此才决定来到月海亭工作。",
            "nextDialogs": [
              "110320211"
            ]
          },
          "110320211": {
            "id": "110320211",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "原来在你眼里的我，是这样…",
            "nextDialogs": [
              "110320212"
            ]
          },
          "110320212": {
            "id": "110320212",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "不过事实上，作为月海亭秘书的工作还是非常辛苦的。",
            "nextDialogs": [
              "110320213"
            ]
          },
          "110320213": {
            "id": "110320213",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "我没有您那样优秀的工作能力，因而时不时总是会怀疑自己…",
            "nextDialogs": [
              "110320214"
            ]
          },
          "110320214": {
            "id": "110320214",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "没有的事，慧心已经做得很好了。",
            "nextDialogs": [
              "110320215"
            ]
          },
          "110320215": {
            "id": "110320215",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "呵呵，谢谢前辈。",
            "nextDialogs": [
              "110320216"
            ]
          },
          "110320216": {
            "id": "110320216",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "这些年，我也有了自己的女儿…",
            "nextDialogs": [
              "110320217"
            ]
          },
          "110320217": {
            "id": "110320217",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸！原来天叔已经当爷爷了！",
            "nextDialogs": [
              "110320218"
            ]
          },
          "110320218": {
            "id": "110320218",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "我的女儿在我的熏陶下，如今也继承了我当年的理想——成为月海亭的秘书。",
            "nextDialogs": [
              "110320219"
            ]
          },
          "110320219": {
            "id": "110320219",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "起初我会有些担心，毕竟这份工作并不容易，目前也还看不出她是否有这样的资质。",
            "nextDialogs": [
              "110320220"
            ]
          },
          "110320220": {
            "id": "110320220",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "但经过这次的事之后…我现在很坚定，会选择支持她。",
            "nextDialogs": [
              "110320221"
            ]
          },
          "110320221": {
            "id": "110320221",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "欸，是什么会让你觉得…",
            "nextDialogs": [
              "110320222"
            ]
          },
          "110320222": {
            "id": "110320222",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "因为她以后也会遇上一位叫做甘雨的前辈。",
            "nextDialogs": [
              "110320223"
            ]
          },
          "110320223": {
            "id": "110320223",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "甘雨前辈会温柔地帮助她，并且跟她说，你妈妈当年是这样做的…",
            "nextDialogs": [
              "110320224"
            ]
          },
          "110320224": {
            "id": "110320224",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "想到那副画面，可真是美好。",
            "nextDialogs": [
              "110320225"
            ]
          },
          "110320225": {
            "id": "110320225",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "所以——二十年后的事也拜托前辈您了。",
            "nextDialogs": [
              "110320226"
            ]
          },
          "110320226": {
            "id": "110320226",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "慧心…",
            "nextDialogs": [
              "110320227"
            ]
          },
          "110320227": {
            "id": "110320227",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "…我、我从没想过，我的存在对你来说还有这样的意义…",
            "nextDialogs": [
              "110320228"
            ]
          },
          "110320228": {
            "id": "110320228",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "呵呵，就像前辈您之前向我展示我父亲的做法一样，有您在「见证」，就会让人感觉很安心。",
            "nextDialogs": [
              "110320229"
            ]
          },
          "110320229": {
            "id": "110320229",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "「见证」…",
            "nextDialogs": [
              "110320230"
            ]
          },
          "110320230": {
            "id": "110320230",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "…我确实，在见证着璃月港这几千年的时光。不论发展变迁，还是人情世故…",
            "nextDialogs": [
              "110320231"
            ]
          },
          "110320231": {
            "id": "110320231",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "但我曾以为，这除了带给我孤独之外，并没有什么其他的意义。",
            "nextDialogs": [
              "110320232"
            ]
          },
          "110320232": {
            "id": "110320232",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "慧心，你刚才的话对我来说，非常重要…",
            "nextDialogs": [
              "110320233"
            ]
          },
          "110320233": {
            "id": "110320233",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "让我真正感觉到，除了岩王帝君与我订下的「契约」外，我与璃月港的这片人海之间的联系。",
            "nextDialogs": [
              "110320234"
            ]
          },
          "110320234": {
            "id": "110320234",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "体会到被依赖，被认可，被渴望见证的感觉。",
            "nextDialogs": [
              "110320235"
            ]
          },
          "110320235": {
            "id": "110320235",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "当然了，您可是我们独一无二的甘雨前辈呀！",
            "nextDialogs": [
              "110320236"
            ]
          },
          "110320236": {
            "id": "110320236",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "呵呵…是啊，所以要好好回应大家才行。",
            "nextDialogs": [
              "110320237"
            ]
          },
          "110320237": {
            "id": "110320237",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "这才对嘛！甘雨小姐终于振作起来了！",
            "nextDialogs": [
              "110320238"
            ]
          },
          "110320238": {
            "id": "110320238",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "哪怕我真的被排挤了，我也希望还能争取一下…",
            "nextDialogs": [
              "110320239"
            ]
          },
          "110320239": {
            "id": "110320239",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "为了不辜负你对我的托付，我也还想继续履行「契约」，继续作为「七星」的秘书。",
            "nextDialogs": [
              "110320242"
            ]
          },
          "110320242": {
            "id": "110320242",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "总之，我现在要回去看看。",
            "nextDialogs": [
              "110320243"
            ]
          },
          "110320243": {
            "id": "110320243",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "没有我在的话，那些事务的处理恐怕正乱作一团吧。",
            "nextDialogs": [
              "110320244"
            ]
          },
          "110320244": {
            "id": "110320244",
            "speakerId": 1015,
            "speakerName": "甘雨",
            "text": "工作，工作，没时间可以这样浪费了！",
            "nextDialogs": [
              "110320245"
            ]
          },
          "110320245": {
            "id": "110320245",
            "speakerId": 2029,
            "speakerName": "慧心",
            "text": "请加油！甘雨前辈！",
            "nextDialogs": [
              "110320246"
            ]
          },
          "110320246": {
            "id": "110320246",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "欸欸！就这样要走了吗，我还没吃饱呢！"
          }
        }
      }
    },
    {
      "subId": "1103203",
      "subQuestName": "与慧心对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {

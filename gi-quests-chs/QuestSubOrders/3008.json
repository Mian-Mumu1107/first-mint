      }
    },
    {
      "subId": "300802",
      "subQuestName": "与迪娜泽黛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080201"
        ],
        "dialogs": {
          "30080201": {
            "id": "30080201",
            "speakerId": 1002,
            "speakerName": "迪娜泽黛",
            "text": "这里是卖「七鲜桌」菜品的摊位。",
            "nextDialogs": [
              "30080202"
            ]
          },
          "30080202": {
            "id": "30080202",
            "speakerId": 1003,
            "speakerName": "阿玛尔",
            "text": "您可真有见识，小姐，我还以为现在没什么人知道了。",
            "nextDialogs": [
              "30080203"
            ]
          },
          "30080203": {
            "id": "30080203",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎么好像都是些素的食物呀，唔，有点失望…",
            "nextDialogs": [
              "30080204"
            ]
          },
          "30080204": {
            "id": "30080204",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "说起来，你刚才说的「七鲜桌」是什么呀？",
            "nextDialogs": [
              "30080205"
            ]
          },
          "30080205": {
            "id": "30080205",
            "speakerId": 1002,
            "speakerName": "迪娜泽黛",
            "text": "是花神诞祭的一种习俗，人们在餐桌上摆满这些菜品，用来象征须弥神明的七种美德。",
            "nextDialogs": [
              "30080208"
            ]
          },
          "30080208": {
            "id": "30080208",
            "speakerId": 1000,
            "speakerName": "齐米亚",
            "text": "…从灰尘上看，应该是「月亮」。",
            "nextDialogs": [
              "30080209"
            ]
          },
          "30080209": {
            "id": "30080209",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "真的吗，我怎么觉得像是某种吃的。",
            "nextDialogs": [
              "30080210"
            ]
          },
          "30080210": {
            "id": "30080210",
            "speakerId": 1000,
            "speakerName": "齐米亚",
            "text": "嗯…「月亮」象征着…嗯…我有点忘了，稍等下…",
            "nextDialogs": [
              "30080211"
            ]
          },
          "30080211": {
            "id": "30080211",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "他在偷偷翻书吧？",
            "nextDialogs": [
              "30080212"
            ]
          },
          "30080212": {
            "id": "30080212",
            "speakerId": 1000,
            "speakerName": "齐米亚",
            "text": "哦，对了对了，意味着「虚幻」与「谎言」。",
            "nextDialogs": [
              "30080213"
            ]
          },
          "30080213": {
            "id": "30080213",
            "speakerId": 1000,
            "speakerName": "齐米亚",
            "text": "但只要相信自己的直觉，克服心中的恐惧，太阳就一定会升起来。"
          }
        }
      }
    },
    {
      "subId": "300803",
      "subQuestName": "跟随迪娜泽黛",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080301"
        ],
        "dialogs": {
          "30080301": {
            "id": "30080301",
            "speakerId": 1003,
            "speakerName": "阿玛尔",
            "text": "我昨天才去的森林里摘这些货，绝对新鲜，放心吧。"
          }
        }
      }
    },
    {
      "subId": "300804",
      "subQuestName": "与迪娜泽黛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080401"
        ],
        "dialogs": {
          "30080401": {
            "id": "30080401",
            "speakerId": 1004,
            "speakerName": "孩子们",
            "text": "法里斯！法里斯！",
            "nextDialogs": [
              "30080402"
            ]
          },
          "30080402": {
            "id": "30080402",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "好了，兵士们，拿了雅尔达糖的奖赏，就要对小吉祥草王心怀忠诚，解散吧！",
            "nextDialogs": [
              "30080403"
            ]
          },
          "30080403": {
            "id": "30080403",
            "speakerId": 1004,
            "speakerName": "孩子们",
            "text": "是！法里斯骑士！",
            "nextDialogs": [
              "30080404"
            ]
          },
          "30080404": {
            "id": "30080404",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这是什么情况，在演戏吗？",
            "nextDialogs": [
              "30080405"
            ]
          },
          "30080405": {
            "id": "30080405",
            "speakerId": 1002,
            "speakerName": "迪娜泽黛",
            "text": "花之骑士法里斯也是花神诞祭的一种象征，很受孩子们欢迎。",
            "nextDialogs": [
              "30080406"
            ]
          },
          "30080406": {
            "id": "30080406",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "要不是迪娜泽黛小姐的赞助，孩子们也没机会见到我这个花之骑士啊，哈哈。",
            "nextDialogs": [
              "30080407"
            ]
          },
          "30080407": {
            "id": "30080407",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "哦对了，你们要不要也来点雅尔达糖果，都在这些盒子里，你们挑挑看吧。",
            "nextDialogs": [
              "30080408"
            ]
          },
          "30080408": {
            "id": "30080408",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "挑？这些看上去不都一样吗？",
            "nextDialogs": [
              "30080409"
            ]
          },
          "30080409": {
            "id": "30080409",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "哈哈，可没那么简单，每个盒子里都装着随机的一种口味，要看运气。糖果有堇瓜味，日落果味，香辛果味…",
            "nextDialogs": [
              "30080410"
            ]
          },
          "30080410": {
            "id": "30080410",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸，确实很有意思。",
            "nextDialogs": [
              "30080411"
            ]
          },
          "30080411": {
            "id": "30080411",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "…然后还有蜥蜴尾巴味和鬼兜虫味。",
            "nextDialogs": [
              "30080412"
            ]
          },
          "30080412": {
            "id": "30080412",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "欸！怎么会有这种味道的糖啊！",
            "nextDialogs": [
              "30080413"
            ]
          },
          "30080413": {
            "id": "30080413",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "唔…还是你来帮忙选吧，我要吃日落果味的！",
            "nextDialogs": [
              "30080414"
            ]
          },
          "30080414": {
            "id": "30080414",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "好，这五个糖果盒，从左到右是一号到五号，你选几号呢？",
            "nextDialogs": [
              "30080437",
              "30080438",
              "30080439",
              "30080440",
              "30080441"
            ]
          },
          "30080437": {
            "id": "30080437",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确定选一号了。",
            "nextDialogs": [
              "30080425"
            ]
          },
          "30080425": {
            "id": "30080425",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "唔~！了不起啊，四号是吧，真的选到了日落果口味。",
            "nextDialogs": [
              "30080426"
            ]
          },
          "30080426": {
            "id": "30080426",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哈哈，我就说你运气超级好，果然如此！"
          },
          "30080438": {
            "id": "30080438",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确定选二号了。"
          },
          "30080439": {
            "id": "30080439",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确定选三号了。"
          },
          "30080440": {
            "id": "30080440",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确定选四号了。",
            "nextDialogs": [
              "30080420"
            ]
          },
          "30080420": {
            "id": "30080420",
            "speakerId": 1005,
            "speakerName": "毗伽尔",
            "text": "唔~！了不起啊，四号是吧，真的选到了日落果口味。",
            "nextDialogs": [
              "30080421"
            ]
          },
          "30080421": {
            "id": "30080421",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "哈哈，我就说你运气超级好，果然如此！",
            "nextDialogs": [
              "30080422"
            ]
          },
          "30080422": {
            "id": "30080422",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "刚才…好像不是运气。",
            "nextDialogs": [
              "30080423"
            ]
          },
          "30080423": {
            "id": "30080423",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不知为何，我知道一定是四号。",
            "nextDialogs": [
              "30080424"
            ]
          },
          "30080424": {
            "id": "30080424",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊？怎么会呢，明明是随机的呀…"
          },
          "30080441": {
            "id": "30080441",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "确定选五号了。"
          }
        }
      }
    },

    {
      "subId": "300811",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080901"
        ],
        "dialogs": {
          "30080901": {
            "id": "30080901",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "（哈欠）——都怪你赖床，我们要迟到了。",
            "nextDialogs": [
              "30080902"
            ]
          },
          "30080902": {
            "id": "30080902",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "快去跟迪娜泽黛会合吧。"
          }
        }
      }
    },
    {
      "subId": "300801",
      "subQuestName": "到约定地点与迪娜泽黛对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080101"
        ],
        "dialogs": {
          "30080101": {
            "id": "30080101",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "早上好，迪娜泽黛，不好意思我们迟到了，嘿嘿。",
            "nextDialogs": [
              "30080102"
            ]
          },
          "30080102": {
            "id": "30080102",
            "speakerId": 1002,
            "speakerName": "迪娜泽黛",
            "text": "没有，是我来得太早了。",
            "nextDialogs": [
              "30080103"
            ]
          },
          "30080103": {
            "id": "30080103",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你好像有点没精神…是没睡好吗？",
            "nextDialogs": [
              "30080104"
            ]
          },
          "30080104": {
            "id": "30080104",
            "speakerId": 1002,
            "speakerName": "迪娜泽黛",
            "text": "我很好，不用担心。我们走吧？先去那边的摊位上逛逛。",
            "nextDialogs": [
              "30080105"
            ]
          },
          "30080105": {
            "id": "30080105",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "好啊…欸？旅行者，你在发什么呆呢，我们快走吧？"
          }
        }
      }
    },
    {
      "subId": "300812",
      "subQuestName": "跟随迪娜泽黛",
      "sceneId": null,
      "locations": [],

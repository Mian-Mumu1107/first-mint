    {
      "subId": "300805",
      "subQuestName": "前往兰巴德酒馆",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30080501"
        ],
        "dialogs": {
          "30080501": {
            "id": "30080501",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "你说…「既视感」？",
            "nextDialogs": [
              "30080502"
            ]
          },
          "30080502": {
            "id": "30080502",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "我好像也知道这种说法，就是对眼前正在发生的事有种以前好像经历过的错觉…",
            "nextDialogs": [
              "30080503"
            ]
          },
          "30080503": {
            "id": "30080503",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这么说来，我今天好像也隐约会感觉到一些…不过那终究是错觉吧？",
            "nextDialogs": [
              "30080504"
            ]
          },
          "30080504": {
            "id": "30080504",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "所以你忽然跑来这边是为什么呀？",
            "nextDialogs": [
              "30080507"
            ]
          },
          "30080507": {
            "id": "30080507",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这样啊，也就是故意不按常理出牌，来看看还会不会有那种「曾经做过」的感觉吗…",
            "nextDialogs": [
              "30080508"
            ]
          },
          "30080508": {
            "id": "30080508",
            "speakerId": 1006,
            "speakerName": "兰巴德",
            "text": "欢迎二位，这个时间是来吃饭的吗？今天想来点儿什么？",
            "nextDialogs": [
              "30080509"
            ]
          },
          "30080509": {
            "id": "30080509",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "「椰炭饼」一份。",
            "nextDialogs": [
              "30080510"
            ]
          },
          "30080510": {
            "id": "30080510",
            "speakerId": 1006,
            "speakerName": "兰巴德",
            "text": "好嘞，客人虽然像是外地人，但还是挺有品味的嘛，我这就通知下厨。",
            "nextDialogs": [
              "30080511"
            ]
          },
          "30080511": {
            "id": "30080511",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "「椰炭饼」！那不是那个…那个黑黑的，感觉肯定不怎么好吃的东西吗？",
            "nextDialogs": [
              "30080512"
            ]
          },
          "30080512": {
            "id": "30080512",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "啊…我、我好像明白你要干什么了，的确一般来说，你是不可能点这道菜来吃的。",
            "nextDialogs": [
              "30080513"
            ]
          },
          "30080513": {
            "id": "30080513",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "等了一段时间后，「椰炭饼」被端了上来…",
            "nextDialogs": [
              "30080514"
            ]
          },
          "30080514": {
            "id": "30080514",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "这个…你真的打算吃吗？",
            "nextDialogs": [
              "30080515"
            ]
          },
          "30080515": {
            "id": "30080515",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "会不会…牺牲太大了点…",
            "nextDialogs": [
              "30080516"
            ]
          },
          "30080516": {
            "id": "30080516",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我开动了。",
            "nextDialogs": [
              "30080517"
            ]
          },
          "30080517": {
            "id": "30080517",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "怎、怎么样！看你的表情，好像的确很难吃…",
            "nextDialogs": [
              "30080518"
            ]
          },
          "30080518": {
            "id": "30080518",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "不…味道其实很好。",
            "nextDialogs": [
              "30080519"
            ]
          },
          "30080519": {
            "id": "30080519",
            "speakerId": 1001,
            "speakerName": "派蒙",
            "text": "那…难道说…"
          }
        }
      }
    },

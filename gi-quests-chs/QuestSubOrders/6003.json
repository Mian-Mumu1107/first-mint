    {
      "subId": "600309",
      "subQuestName": "寻找「博士」",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60030901"
        ],
        "dialogs": {
          "60030901": {
            "id": "60030901",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "欢迎欢迎，我已恭候多时了。希望各位能喜欢我这间小研究所。",
            "nextDialogs": [
              "60030902"
            ]
          },
          "60030902": {
            "id": "60030902",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "喜欢？一路上都是怪物。",
            "nextDialogs": [
              "60030903"
            ]
          },
          "60030903": {
            "id": "60030903",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "你竟敢以如此悠闲的姿态等候在此！",
            "nextDialogs": [
              "60030904"
            ]
          },
          "60030904": {
            "id": "60030904",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "当然。我有什么可着急的？一切都那么顺利，你们也如期到来。",
            "nextDialogs": [
              "60030905"
            ]
          },
          "60030905": {
            "id": "60030905",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "先是桑多涅和阿蕾奇诺，然后是你们。今天客人还真多。",
            "nextDialogs": [
              "60030906"
            ]
          },
          "60030906": {
            "id": "60030906",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "……",
            "nextDialogs": [
              "60030907"
            ]
          },
          "60030907": {
            "id": "60030907",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "假如是在找那两位女士，那我得告诉你，阿蕾奇诺进入研究所后立刻消失了。",
            "nextDialogs": [
              "60030908"
            ]
          },
          "60030908": {
            "id": "60030908",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "而桑多涅刚刚就站在这里，大声质问我。",
            "nextDialogs": [
              "60030909"
            ]
          },
          "60030909": {
            "id": "60030909",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "她总是这样，没什么礼貌。不过至少有一点令我意外，我实在没想到，连桑多涅都在意起他人了。",
            "nextDialogs": [
              "60030910"
            ]
          },
          "60030910": {
            "id": "60030910",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "和你们走得近的人难道都会变成这样吗？可那对研究人员来说不是好事。不够客观。",
            "nextDialogs": [
              "60030911"
            ]
          },
          "60030911": {
            "id": "60030911",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "桑多涅在哪里？",
            "nextDialogs": [
              "60030912"
            ]
          },
          "60030912": {
            "id": "60030912",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "关于这一点…",
            "nextDialogs": [
              "60030913"
            ]
          },
          "60030913": {
            "id": "60030913",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "你的梦做得还真远，多托雷。难道你认为有了月髓就能在这世界称神？",
            "nextDialogs": [
              "60030914"
            ]
          },
          "60030914": {
            "id": "60030914",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "称神这个说法我不喜欢。",
            "nextDialogs": [
              "60030915"
            ]
          },
          "60030915": {
            "id": "60030915",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "不是自称，而是事实如此。身为研究员的你，不会不能理解二者之间的差距吧。",
            "nextDialogs": [
              "60030916"
            ]
          },
          "60030916": {
            "id": "60030916",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "哈？就凭你吗？",
            "nextDialogs": [
              "60030917"
            ]
          },
          "60030917": {
            "id": "60030917",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "噢，淑女偶尔也有出言不逊的时刻，请别介意。毕竟同事一场，你什么做派我们都清楚。",
            "nextDialogs": [
              "60030918"
            ]
          },
          "60030918": {
            "id": "60030918",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "同事一场，我也猜到你会这么说。",
            "nextDialogs": [
              "60030919"
            ]
          },
          "60030919": {
            "id": "60030919",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "你我都明白，事实胜于雄辩，所以，我派人给你送了点小礼物，帮助你直观理解我如今的位格。",
            "nextDialogs": [
              "60030920"
            ]
          },
          "60030920": {
            "id": "60030920",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "礼物？",
            "nextDialogs": [
              "60030921"
            ]
          },
          "60030921": {
            "id": "60030921",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "……",
            "nextDialogs": [
              "60030922"
            ]
          },
          "60030922": {
            "id": "60030922",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "你手下那些人，都去哪儿了？",
            "nextDialogs": [
              "60030923"
            ]
          },
          "60030923": {
            "id": "60030923",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "谁知道呢。也许他们已追随着未知之神的脚步去往新世界。",
            "nextDialogs": [
              "60030924"
            ]
          },
          "60030924": {
            "id": "60030924",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "虽然你缺乏教养又眼高于顶，但亲爱的桑多涅，我并不会因此迁怒你的下属。他们也享有同等权利。",
            "nextDialogs": [
              "60030925"
            ]
          },
          "60030925": {
            "id": "60030925",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "你胆敢派人去月矩力试验设计局？那可是女皇陛下的试验场所！",
            "nextDialogs": [
              "60030926"
            ]
          },
          "60030926": {
            "id": "60030926",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "是啊，陛下的吩咐我们自当谨记在心。但你也知道，那跟我现在的目标并不冲突。",
            "nextDialogs": [
              "60030927"
            ]
          },
          "60030927": {
            "id": "60030927",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "既然如此，我只是做些想做的实验，有问题吗？",
            "nextDialogs": [
              "60030928"
            ]
          },
          "60030928": {
            "id": "60030928",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "你可以赌一把，是我在撒谎，其实只想调虎离山，还是我的话句句属实，你的下属正身处危险之中？",
            "nextDialogs": [
              "60030929"
            ]
          },
          "60030929": {
            "id": "60030929",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "连愚人众自己的士兵都要下手，你丧心病狂！",
            "nextDialogs": [
              "60030930"
            ]
          },
          "60030930": {
            "id": "60030930",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "如今我为自己定了一条新的规矩，要给每个人一次机会。我自然也会这样对你。",
            "nextDialogs": [
              "60030931"
            ]
          },
          "60030931": {
            "id": "60030931",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "你若想离开，我不会阻拦。毕竟，我们大家都是好同事嘛。",
            "nextDialogs": [
              "60030932"
            ]
          },
          "60030932": {
            "id": "60030932",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "该死的东西！",
            "nextDialogs": [
              "60030933"
            ]
          },
          "60030933": {
            "id": "60030933",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "不过我确实没想到，连桑多涅都关心起这世界的人来了。真可惜啊，还以为自我中心是她身上仅存的优点呢。",
            "nextDialogs": [
              "60030934"
            ]
          },
          "60030934": {
            "id": "60030934",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "连一个试验设计局都要保护，这种心性又能干成什么大事？",
            "nextDialogs": [
              "60030935"
            ]
          },
          "60030935": {
            "id": "60030935",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "挟持人质可不是什么上得了台面的做法。还是说对如今的您而言，脸面已经不再重要？",
            "nextDialogs": [
              "60030936"
            ]
          },
          "60030936": {
            "id": "60030936",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "脸面？",
            "nextDialogs": [
              "60030937"
            ]
          },
          "60030937": {
            "id": "60030937",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "我手里有两枚月髓，缺失的那一枚也即将制造完成。对即将成为新世界神明的我谈论脸面？未免风趣过头了。",
            "nextDialogs": [
              "60030938"
            ]
          },
          "60030938": {
            "id": "60030938",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "你根本就不配握有那等圣物！",
            "nextDialogs": [
              "60030939"
            ]
          },
          "60030939": {
            "id": "60030939",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "而依我看，世上还有许多人不配活着呢，我不也仁慈地允许他们存在了吗？",
            "nextDialogs": [
              "60030940"
            ]
          },
          "60030940": {
            "id": "60030940",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "你会为你的所作所为后悔的。",
            "nextDialogs": [
              "60030941"
            ]
          },
          "60030941": {
            "id": "60030941",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "那就得看你们有没有让人后悔的本事了。"
          }
        }
      }
    },
    {
      "subId": "600307",
      "subQuestName": "(test)隐藏$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60030701"
        ],
        "dialogs": {
          "60030701": {
            "id": "60030701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "还有一些事…",
            "nextDialogs": [
              "60030702"
            ]
          },
          "60030702": {
            "id": "60030702",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "那等你准备完毕，我们再一起出发。"
          }
        }
      }
    },
    {
      "subId": "600310",
      "subQuestName": "与「博士」战斗",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "600311",
      "subQuestName": "撤离「博士」的研究所",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60031101"
        ],
        "dialogs": {
          "60031101": {
            "id": "60031101",
            "speakerId": 1080,
            "speakerName": "「仆人」",
            "text": "在未完成的人工月髓加持下，多托雷的力量已经达到我们无法匹敌的地步…不要恋战。",
            "nextDialogs": [
              "60031102"
            ]
          },
          "60031102": {
            "id": "60031102",
            "speakerId": 1080,
            "speakerName": "「仆人」",
            "text": "抓紧时机！",
            "nextDialogs": [
              "60031103"
            ]
          },
          "60031103": {
            "id": "60031103",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "走！",
            "nextDialogs": [
              "60031104"
            ]
          },
          "60031104": {
            "id": "60031104",
            "speakerId": 12695,
            "speakerName": "「博士」",
            "text": "逃跑比投降明智，我向来这样认为。",
            "nextDialogs": [
              "60031105"
            ]
          },
          "60031105": {
            "id": "60031105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "这是…",
            "nextDialogs": [
              "60031106"
            ]
          },
          "60031106": {
            "id": "60031106",
            "speakerId": 1080,
            "speakerName": "「仆人」",
            "text": "小心！",
            "nextDialogs": [
              "60031107"
            ]
          },
          "60031107": {
            "id": "60031107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "别管我，你们——",
            "nextDialogs": [
              "60031108"
            ]
          },
          "60031108": {
            "id": "60031108",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "#{NICKNAME}人呢？！",
            "nextDialogs": [
              "60031109"
            ]
          },
          "60031109": {
            "id": "60031109",
            "speakerId": 1080,
            "speakerName": "「仆人」",
            "text": "啧…",
            "nextDialogs": [
              "60031110"
            ]
          },
          "60031110": {
            "id": "60031110",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "突破不了的话，只能先撤退。"
          }
        }
      }
    },

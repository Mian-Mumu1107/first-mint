    {
      "subId": "600313",
      "subQuestName": "撤离「博士」的研究所",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "600301",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "60030101"
        ],
        "dialogs": {
          "60030101": {
            "id": "60030101",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "看起来人都到齐了呢！",
            "nextDialogs": [
              "60030102"
            ]
          },
          "60030102": {
            "id": "60030102",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "#是的，我们都已经准备好了。{NICKNAME}，派蒙，你们呢？状态如何？",
            "nextDialogs": [
              "60030103"
            ]
          },
          "60030103": {
            "id": "60030103",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "我准备好了！",
            "nextDialogs": [
              "60030105",
              "60030107"
            ]
          },
          "60030105": {
            "id": "60030105",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "那太好了，马上进入正题吧。",
            "nextDialogs": [
              "60030113"
            ]
          },
          "60030113": {
            "id": "60030113",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "那么，首先…",
            "nextDialogs": [
              "60030114"
            ]
          },
          "60030114": {
            "id": "60030114",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "等等！",
            "nextDialogs": [
              "60030115"
            ]
          },
          "60030115": {
            "id": "60030115",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "有声音。",
            "nextDialogs": [
              "60030116"
            ]
          },
          "60030116": {
            "id": "60030116",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "我们听见你的脚步声了，不过嘛…",
            "nextDialogs": [
              "60030117"
            ]
          },
          "60030117": {
            "id": "60030117",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "#您来这里有一会儿了，也许是跟着{NICKNAME}过来的？但您的气息，似乎不带有恶意。",
            "nextDialogs": [
              "60030118"
            ]
          },
          "60030118": {
            "id": "60030118",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "进来吧。",
            "nextDialogs": [
              "60030119"
            ]
          },
          "60030119": {
            "id": "60030119",
            "speakerId": 16156,
            "speakerName": "格迪米纳什",
            "text": "各位果然如我所想，反应快得很。",
            "nextDialogs": [
              "60030120"
            ]
          },
          "60030120": {
            "id": "60030120",
            "speakerId": 16156,
            "speakerName": "格迪米纳什",
            "text": "我奉「仆人」大人命令，前来传达她的口信。",
            "nextDialogs": [
              "60030121"
            ]
          },
          "60030121": {
            "id": "60030121",
            "speakerId": 1080,
            "speakerName": "「仆人」",
            "text": "多托雷佯装返回至冬，那显然是借口。但他并没回到月矩力试验设计局，也并未出现在那夏镇。",
            "nextDialogs": [
              "60030122"
            ]
          },
          "60030122": {
            "id": "60030122",
            "speakerId": 1319,
            "speakerName": "「木偶」",
            "text": "所以他只可能在最北面的那个实验室。哈，我说为什么他要申请自己的场地…原来是早有计划！",
            "nextDialogs": [
              "60030123"
            ]
          },
          "60030123": {
            "id": "60030123",
            "speakerId": 1080,
            "speakerName": "「仆人」",
            "text": "告诉他们，我和桑多涅先行一步。假如他们也关心此事的后续，那我们就在挪德卡莱最北方的研究所见。",
            "nextDialogs": [
              "60030124"
            ]
          },
          "60030124": {
            "id": "60030124",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "那两位都是哥伦比娅小姐的至交，但她们行动前仍不忘与我们分享信息…诚挚感谢愚人众的帮助。",
            "nextDialogs": [
              "60030125"
            ]
          },
          "60030125": {
            "id": "60030125",
            "speakerId": 16156,
            "speakerName": "格迪米纳什",
            "text": "虽说「少女」大人已经脱离组织…但大人们对她的关心绝非虚假。何况，目前看来「博士」大人的行为充满谜团，我们必须关注。",
            "nextDialogs": [
              "60030126"
            ]
          },
          "60030126": {
            "id": "60030126",
            "speakerId": 16156,
            "speakerName": "格迪米纳什",
            "text": "我们常与人为敌，可那仅仅基于立场。人情与道义，我们向来都明白的。",
            "nextDialogs": [
              "60030127"
            ]
          },
          "60030127": {
            "id": "60030127",
            "speakerId": 16156,
            "speakerName": "格迪米纳什",
            "text": "各位是「少女」大人的朋友，有权知情。",
            "nextDialogs": [
              "60030128"
            ]
          },
          "60030128": {
            "id": "60030128",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "到底是最懂得审时度势的阿蕾奇诺，替我们省去了许多功夫。",
            "nextDialogs": [
              "60030129"
            ]
          },
          "60030129": {
            "id": "60030129",
            "speakerId": 16156,
            "speakerName": "格迪米纳什",
            "text": "地图我放在这里了。如果你们决定前往最北部的研究所，请务必注意安全。",
            "nextDialogs": [
              "60030130"
            ]
          },
          "60030130": {
            "id": "60030130",
            "speakerId": 16156,
            "speakerName": "格迪米纳什",
            "text": "务必记得，至少在挪德卡莱，「仆人」大人的下属可以是你们的同伴。",
            "nextDialogs": [
              "60030131"
            ]
          },
          "60030131": {
            "id": "60030131",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "感谢您的周到。",
            "nextDialogs": [
              "60030132"
            ]
          },
          "60030132": {
            "id": "60030132",
            "speakerId": 16156,
            "speakerName": "格迪米纳什",
            "text": "分内之事罢了。那我就先告辞了，如有需要，可以到月矩力试验设计局找我们。",
            "nextDialogs": [
              "60030133"
            ]
          },
          "60030133": {
            "id": "60030133",
            "speakerId": 1005,
            "speakerName": "派蒙",
            "text": "「博士」离开了月矩力试验设计局，去了最北方的研究所…",
            "nextDialogs": [
              "60030134"
            ]
          },
          "60030134": {
            "id": "60030134",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "「木偶」说「博士」早有准备，难道他在来挪德卡莱之前就有这个计划了吗？",
            "nextDialogs": [
              "60030135"
            ]
          },
          "60030135": {
            "id": "60030135",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "为女皇办事多半只是他的谎言。又或者，更简单一些——阳奉阴违。",
            "nextDialogs": [
              "60030136"
            ]
          },
          "60030136": {
            "id": "60030136",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "「博士」行事果断，作风狠辣歹毒，很不好对付。我们得做好准备。",
            "nextDialogs": [
              "60030137"
            ]
          },
          "60030137": {
            "id": "60030137",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "现阶段，「博士」的行动难以预测。我建议兵分两路，留一些人守住那夏镇。",
            "nextDialogs": [
              "60030138"
            ]
          },
          "60030138": {
            "id": "60030138",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "唔…虽然很想帮忙啦，但我确实不是潜入研究所的最佳人选…",
            "nextDialogs": [
              "60030152"
            ]
          },
          "60030152": {
            "id": "60030152",
            "speakerId": 1313,
            "speakerName": "爱诺",
            "text": "但至少把「冷静一下鸭」带上吧！它应该能在战斗中帮到你们。",
            "nextDialogs": [
              "60030139"
            ]
          },
          "60030139": {
            "id": "60030139",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "伊涅芙小姐是否和往常一样，决定留下保护爱诺小姐呢？",
            "nextDialogs": [
              "60030140"
            ]
          },
          "60030140": {
            "id": "60030140",
            "speakerId": 1312,
            "speakerName": "伊涅芙",
            "text": "检测到行动逻辑：保护爱诺，优先级：高。",
            "nextDialogs": [
              "60030141"
            ]
          },
          "60030141": {
            "id": "60030141",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "以防万一，法尔伽先生也留下比较好，研究所那边交给我们。",
            "nextDialogs": [
              "60030142"
            ]
          },
          "60030142": {
            "id": "60030142",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "身为北风骑士，我不应在这种时候留守，但…好吧。",
            "nextDialogs": [
              "60030143"
            ]
          },
          "60030143": {
            "id": "60030143",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "那夏镇交给我。几位也请务必注意安全，如果情况不可控，一定要及时撤退。",
            "nextDialogs": [
              "60030144"
            ]
          },
          "60030144": {
            "id": "60030144",
            "speakerId": 1316,
            "speakerName": "奈芙尔",
            "text": "雅珂达也会帮各位的。我不在的时候，情报工作就交给她了。",
            "nextDialogs": [
              "60030145"
            ]
          },
          "60030145": {
            "id": "60030145",
            "speakerId": 1317,
            "speakerName": "雅珂达",
            "text": "明白了老板。你们要安全回来哦！",
            "nextDialogs": [
              "60030146"
            ]
          },
          "60030146": {
            "id": "60030146",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "我们会的。",
            "nextDialogs": [
              "60030147"
            ]
          },
          "60030147": {
            "id": "60030147",
            "speakerId": 1314,
            "speakerName": "菲林斯",
            "text": "夜长梦多，早点出发比较好。"
          },
          "60030107": {
            "id": "60030107",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "哈哈，是不是有点紧张？那也不怪你，我们大家都是第一次碰到这种事。",
            "nextDialogs": [
              "60030108"
            ]
          },
          "60030108": {
            "id": "60030108",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "哥伦比娅小姐不久前刚遭到「博士」袭击…而在那短暂的瞬间，你看到她消失在了那个「月亮倒影」内。",
            "nextDialogs": [
              "60030109"
            ]
          },
          "60030109": {
            "id": "60030109",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "嗯。事件发生时，我们所有人都只看到「博士」出现并使用了某种力量。随后哥伦比娅就消失了，你也从空中坠入大海。",
            "nextDialogs": [
              "60030110"
            ]
          },
          "60030110": {
            "id": "60030110",
            "speakerId": 1310,
            "speakerName": "法尔伽",
            "text": "必须救回哥伦比娅小姐，此外，愚人众执行官「博士」夺取三月的权柄一定有其目的。我们必须阻止他。",
            "nextDialogs": [
              "60030111"
            ]
          },
          "60030111": {
            "id": "60030111",
            "speakerId": 1315,
            "speakerName": "菈乌玛",
            "text": "寻回「月神」原本是我们霜月之子的职责，没想到大家都愿意帮忙…我谨代表霜月之子，向诸位送上谢意。",
            "nextDialogs": [
              "60030112"
            ]
          },
          "60030112": {
            "id": "60030112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "（删除）"
          }
        }
      }

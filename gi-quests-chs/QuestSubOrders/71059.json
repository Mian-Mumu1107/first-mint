  },
  "subQuests": [
    {
      "subId": "7105906",
      "subQuestName": "隐藏任务计时$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710590601"
        ],
        "dialogs": {
          "710590601": {
            "id": "710590601",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "唔…连个人影都没有，这下我们要怎么回去交差呀…",
            "nextDialogs": [
              "710590602"
            ]
          },
          "710590602": {
            "id": "710590602",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "嗯，也没有别的办法啦，我们回去吧？"
          }
        }
      }
    },
    {
      "subId": "7105901",
      "subQuestName": "与卡塔琳娜对话$HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710590101"
        ],
        "dialogs": {
          "710590101": {
            "id": "710590101",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "你们来了！请随便坐坐吧。",
            "nextDialogs": [
              "710590102"
            ]
          },
          "710590102": {
            "id": "710590102",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "抱歉，之前急匆匆把你们赶走，也没有说清楚要请你们帮什么忙。",
            "nextDialogs": [
              "710590107",
              "710590105"
            ]
          },
          "710590107": {
            "id": "710590107",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "放心吧，我不会让你们做坏事的。"
          },
          "710590105": {
            "id": "710590105",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "对呀，你们是愚人众嘛！要是指使我们做坏事的话，我们可不干！",
            "nextDialogs": [
              "710590106"
            ]
          },
          "710590106": {
            "id": "710590106",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "噗…你说的很有道理。"
          }
        }
      }
    },
    {
      "subId": "7105902",
      "subQuestName": "寻找尼古拉留下的线索",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710590201"
        ],
        "dialogs": {
          "710590201": {
            "id": "710590201",
            "speakerId": 1002,
            "speakerName": "尼古拉下士的日志残片",
            "text": "「…倒霉，卡佳老姐的巴拉莱卡琴坏掉了。行动事出紧急，不知道是怎么弄坏的，一定要抢在挨骂前修好…」",
            "nextDialogs": [
              "710590202"
            ]
          },
          "710590202": {
            "id": "710590202",
            "speakerId": 1002,
            "speakerName": "尼古拉下士的日志残片",
            "text": "「…五百年前的祖先们就是这样对抗灾变的吗？大尉说，我们经历的苦战相比祖先而言，不过只是零头而已…」",
            "nextDialogs": [
              "710590203"
            ]
          },
          "710590203": {
            "id": "710590203",
            "speakerId": 1002,
            "speakerName": "尼古拉下士的日志残片",
            "text": "（中间许多页被黑色的物质浸染，清除掉黑色物质后，墨水写下的字迹也被完全毁掉了。）",
            "nextDialogs": [
              "710590204"
            ]
          },
          "710590204": {
            "id": "710590204",
            "speakerId": 1002,
            "speakerName": "尼古拉下士的日志残片",
            "text": "「…这里不能待下去了，那些家伙可以透过黑色的泥状物窥视我的行踪…」",
            "nextDialogs": [
              "710590205"
            ]
          },
          "710590205": {
            "id": "710590205",
            "speakerId": 1002,
            "speakerName": "尼古拉下士的日志残片",
            "text": "「…接下来要继续往反方向前进，把它们再度引向远离小队主力的地方…」",
            "nextDialogs": [
              "710590206"
            ]
          },
          "710590206": {
            "id": "710590206",
            "speakerId": 1002,
            "speakerName": "尼古拉下士的日志残片",
            "text": "「…东南方的堡垒遗迹旁边有一处洞口，或许可以走那条路…」",
            "nextDialogs": [
              "710590207"
            ]
          },
          "710590207": {
            "id": "710590207",
            "speakerId": 1002,
            "speakerName": "尼古拉下士的日志残片",
            "text": "「…祝我好运吧，舍我其谁！」"
          }
        }
      }
    },
    {
      "subId": "7105903",
      "subQuestName": "前往尼古拉日志中提及的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710590301"
        ],
        "dialogs": {
          "710590301": {
            "id": "710590301",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "你们回来了，我还有些火水可以分。",
            "nextDialogs": [
              "710590302"
            ]
          },
          "710590302": {
            "id": "710590302",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "哈哈…没有要你们陪我喝酒啦，如果你们受伤的话，火水也可以用来清洁伤口的。",
            "nextDialogs": [
              "710590303"
            ]
          },
          "710590303": {
            "id": "710590303",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "怎么样？有何收获？",
            "nextDialogs": [
              "710590304"
            ]
          },
          "710590304": {
            "id": "710590304",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "我们找到了这些。"
          }
        }
      }
    },
    {
      "subId": "7105904",
      "subQuestName": "探索日志提及的地点",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710590401"
        ],
        "dialogs": {
          "710590401": {
            "id": "710590401",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "你回来了。请问有什么发现吗？",
            "nextDialogs": [
              "710590402"
            ]
          },
          "710590402": {
            "id": "710590402",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "没有的话也没关系的，请随便休息一下吧。",
            "nextDialogs": [
              "710590403"
            ]
          },
          "710590403": {
            "id": "710590403",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "不用在乎我是否着急啦…反正我也有留在这里养老的计划，说不定还要拜托你替我申领退休金呢！",
            "nextDialogs": [
              "710590404"
            ]
          },
          "710590404": {
            "id": "710590404",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "哇，你这家伙倒是悠闲！",
            "nextDialogs": [
              "710590405"
            ]
          },
          "710590405": {
            "id": "710590405",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "哼，你们再没什么新发现的话，我可要在这里悠闲到老咯。"
          }
        }
      }
    },
    {
      "subId": "7105908",
      "subQuestName": "阅读尼古拉留下的信息",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710591401"
        ],
        "dialogs": {
          "710591401": {
            "id": "710591401",
            "speakerId": 1003,
            "speakerName": "尼古拉下士的笔记",
            "text": "「…成功进入了这处暗室，巨大的机关怪物还在外面游荡，似乎在耐心地等待我逃出去，就像掠食者，居心叵测，险恶异常…」",
            "nextDialogs": [
              "710591402"
            ]
          },
          "710591402": {
            "id": "710591402",
            "speakerId": 1003,
            "speakerName": "尼古拉下士的笔记",
            "text": "「…左腿受了重伤，草草包扎了一下，很痛，肿起来了。可能有感染…」",
            "nextDialogs": [
              "710591403"
            ]
          },
          "710591403": {
            "id": "710591403",
            "speakerId": 1003,
            "speakerName": "尼古拉下士的笔记",
            "text": "「…岩穴里还有另一个出口，不敢确定通往何处。出口的结构很脆弱，如果没有支撑的话，遇到强大的外力很容易垮塌…」",
            "nextDialogs": [
              "710591404"
            ]
          },
          "710591404": {
            "id": "710591404",
            "speakerId": 1003,
            "speakerName": "尼古拉下士的笔记",
            "text": "「…我被发现了，有人来了。来客是一个…浑身漆黑的…剑士…？」",
            "nextDialogs": [
              "710591405"
            ]
          },
          "710591405": {
            "id": "710591405",
            "speakerId": 1003,
            "speakerName": "尼古拉下士的笔记",
            "text": "「…他，不，它…？似乎坚固的金属栅栏也拦不住它，看到它的模样我就知道了…」",
            "nextDialogs": [
              "710591406"
            ]
          },
          "710591406": {
            "id": "710591406",
            "speakerId": 1003,
            "speakerName": "尼古拉下士的笔记",
            "text": "「…对不起，卡佳。」"
          }
        }
      }
    },
    {
      "subId": "7105907",
      "subQuestName": "与派蒙对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710590603"
        ],
        "dialogs": {
          "710590603": {
            "id": "710590603",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "咦…这个徽记…就是那个愚人众家伙留下的吗？"
          }
        }
      }
    },
    {
      "subId": "7105905",
      "subQuestName": "将找到的线索告诉卡塔琳娜",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7105909",
      "subQuestName": "与卡塔琳娜对话",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710591305"
        ],
        "dialogs": {
          "710591305": {
            "id": "710591305",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "这些是…士官徽章，行动日志和…笔记？",
            "nextDialogs": [
              "710591306"
            ]
          },
          "710591306": {
            "id": "710591306",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "请告诉我，科利亚他人在哪里？他还活着吗…？",
            "nextDialogs": [
              "710591309"
            ]
          },
          "710591309": {
            "id": "710591309",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "科利亚不可能丢下我去做逃兵的。你们…你们可以放心，我明白的，他是不会临阵脱逃的。",
            "nextDialogs": [
              "710591310"
            ]
          },
          "710591310": {
            "id": "710591310",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "这些东西，你们是在哪里发现的？",
            "nextDialogs": [
              "710591311"
            ]
          },
          "710591311": {
            "id": "710591311",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "东南方一处山洞，我为你标出来。",
            "nextDialogs": [
              "710591312"
            ]
          },
          "710591312": {
            "id": "710591312",
            "speakerId": 1000,
            "speakerName": "派蒙",
            "text": "是一个很邪门的地方，有很多奇怪的怪物…",
            "nextDialogs": [
              "710591313"
            ]
          },
          "710591313": {
            "id": "710591313",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "谢谢…谢谢你，我…抱歉……",
            "nextDialogs": [
              "710591314"
            ]
          },
          "710591314": {
            "id": "710591314",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "我…我希望科利亚牺牲了，我宁愿这样相信。",
            "nextDialogs": [
              "710591315"
            ]
          },
          "710591315": {
            "id": "710591315",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "科利亚，请不要让女皇陛下蒙羞，不要让我蒙羞……",
            "nextDialogs": [
              "710591316"
            ]
          },
          "710591316": {
            "id": "710591316",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "……",
            "nextDialogs": [
              "710591317"
            ]
          },
          "710591317": {
            "id": "710591317",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "咳，咳…我没事的…抱歉，抱歉！把气氛搞得这么僵…才想起来，还没来得及好好感谢你们呢！",
            "nextDialogs": [
              "710591318"
            ]
          },
          "710591318": {
            "id": "710591318",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "对了，火水…啊，唉…你们不喝酒的，是吗？",
            "nextDialogs": [
              "710591319"
            ]
          },
          "710591319": {
            "id": "710591319",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "我还有些摩拉…还有就是…之前收集的一些物资，反正已经没有什么用了，请你收下吧。"
          }
        }
      }
    },
    {
      "subId": "7105806",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710580601"
        ],
        "dialogs": {
          "710580601": {
            "id": "710580601",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "我要休息了，旧伤还在痛…抱歉。",
            "nextDialogs": [
              "710580602"
            ]
          },
          "710580602": {
            "id": "710580602",
            "speakerId": 1001,
            "speakerName": "卡塔琳娜",
            "text": "有事的话，请改天再来找我吧…我正好也有事要拜托你。"
          }
        }
      }
    }
  ]
}
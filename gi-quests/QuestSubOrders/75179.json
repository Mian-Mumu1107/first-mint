  "subQuests": [
    {
      "subId": "7517915",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790401"
        ],
        "dialogs": {
          "751790401": {
            "id": "751790401",
            "speakerId": 1000,
            "speakerName": "Tizlo",
            "text": "Hey! You, yeah, I'm talking to you! It's dangerous out there, get inside, quick!",
            "nextDialogs": [
              "751790402"
            ]
          },
          "751790402": {
            "id": "751790402",
            "speakerId": 1000,
            "speakerName": "Tizlo",
            "text": "Haven't you seen the mess along the way? There's been a volcanic eruption, and there are monsters blocking the road. You shouldn't go any further.",
            "nextDialogs": [
              "751790403"
            ]
          },
          "751790403": {
            "id": "751790403",
            "speakerId": 1000,
            "speakerName": "Tizlo",
            "text": "Listen to me. Stay here for a bit and wait. In a while, you can head out with the rest of our caravan. That way, we can watch each other's backs. Otherwise, it's way too dangerous to go alone.",
            "nextDialogs": [
              "751790405",
              "751790409"
            ]
          },
          "751790405": {
            "id": "751790405",
            "speakerId": 1000,
            "speakerName": "Tizlo",
            "text": "Yeah, a whole pack of purple Tepetlisaurs! They've clearly been corrupted by the Abyss! Insanely destructive. Honestly, I've never seen any of their kind this terrifying before!",
            "nextDialogs": [
              "751790406"
            ]
          },
          "751790406": {
            "id": "751790406",
            "speakerId": 1000,
            "speakerName": "Tizlo",
            "text": "Let me tell you, those things casually swung their tails and completely wrecked our carts. They're even stronger than Tatankasaurs — definitely not the kind of opponents just anyone can handle.",
            "nextDialogs": [
              "751790407"
            ]
          },
          "751790407": {
            "id": "751790407",
            "speakerId": 1000,
            "speakerName": "Tizlo",
            "text": "I'm serious — don't get all hot-headed and try to fight them. If you see them, just steer clear, alright?"
          },
          "751790409": {
            "id": "751790409",
            "speakerId": 1000,
            "speakerName": "Tizlo",
            "text": "You... *sigh*... alright, just be careful out there..."
          }
        }
      }
    },
    {
      "subId": "7517916",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751791001"
        ],
        "dialogs": {
          "751791001": {
            "id": "751791001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Share Phlogiston.",
            "nextDialogs": [
              "751791002"
            ]
          },
          "751791002": {
            "id": "751791002",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(It blinks, as if to thank you.)"
          }
        }
      }
    },
    {
      "subId": "7517903",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790201"
        ],
        "dialogs": {
          "751790201": {
            "id": "751790201",
            "speakerId": 1001,
            "speakerName": "Zashari",
            "text": "*panting*",
            "nextDialogs": [
              "751790203",
              "751790205"
            ]
          },
          "751790203": {
            "id": "751790203",
            "speakerId": 1001,
            "speakerName": "Zashari",
            "text": "I—I'm okay, just got a bit flustered from running earlier. Need a moment to catch my breath..."
          },
          "751790205": {
            "id": "751790205",
            "speakerId": 1001,
            "speakerName": "Zashari",
            "text": "Um, th—thanks for your concern..."
          }
        }
      }
    },
    {
      "subId": "7517901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790101"
        ],
        "dialogs": {
          "751790101": {
            "id": "751790101",
            "speakerId": 1002,
            "speakerName": "Masose",
            "text": "Hey, you over there! St—Stop! This stuff is ours! Hands off! I'm warning you...! I—I could totally qualify for the Night Warden Wars!",
            "nextDialogs": [
              "751790102"
            ]
          },
          "751790102": {
            "id": "751790102",
            "speakerId": 1002,
            "speakerName": "Masose",
            "text": "You try taking our things, and I'll... I'll show you what for!",
            "nextDialogs": [
              "751790103"
            ]
          },
          "751790103": {
            "id": "751790103",
            "speakerId": 1003,
            "speakerName": "Itsaho",
            "text": "*sigh*... What's going on today? First a volcanic eruption, then a purple Tepetlisaurus... and now a bunch of bandits? What rotten luck...",
            "nextDialogs": [
              "751790104"
            ]
          },
          "751790104": {
            "id": "751790104",
            "speakerId": 1003,
            "speakerName": "Itsaho",
            "text": "#Masose, {M#he}{F#she} looks pretty tough. I don't think we can take {M#him}{F#her}. Besides, we're just here to watch the competition, not get involved...",
            "nextDialogs": [
              "751790105"
            ]
          },
          "751790105": {
            "id": "751790105",
            "speakerId": 1002,
            "speakerName": "Masose",
            "text": "H—How can you say that, Itsaho? This is OUR stuff! And anyway, it's two against one here. We might actually stand a chance!",
            "nextDialogs": [
              "751790106"
            ]
          },
          "751790106": {
            "id": "751790106",
            "speakerId": 1003,
            "speakerName": "Itsaho",
            "text": "Where are you getting that \"two\" from? If anyone's getting beaten up, it's just you. Don't drag me into this...",
            "nextDialogs": [
              "751790107"
            ]
          },
          "751790107": {
            "id": "751790107",
            "speakerId": 1003,
            "speakerName": "Itsaho",
            "text": "#Uh, hey, {M#sir}{F#ma'am}, we don't want the stuff anymore. If you want it, just take it. Just don't hurt us, okay?",
            "nextDialogs": [
              "751790111",
              "751790110"
            ]
          },
          "751790111": {
            "id": "751790111",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "You've got it all wrong! We're actually helpful adventurers, not some random villains!",
            "nextDialogs": [
              "751790112"
            ]
          },
          "751790112": {
            "id": "751790112",
            "speakerId": 1002,
            "speakerName": "Masose",
            "text": "And why should I believe yo— Ow! The heck did you hit me for, Itsaho!?",
            "nextDialogs": [
              "751790113"
            ]
          },
          "751790113": {
            "id": "751790113",
            "speakerId": 1003,
            "speakerName": "Itsaho",
            "text": "If they were up to no good, they'd have already beaten you up. Why would they even waste time talking to us?",
            "nextDialogs": [
              "751790114"
            ]
          },
          "751790114": {
            "id": "751790114",
            "speakerId": 1003,
            "speakerName": "Itsaho",
            "text": "To be honest with you both, our caravan got scattered not long ago. If it's not too much trouble, could you help us pass a message to our boss? Just let her know we're waiting for her here — we'd really appreciate it.",
            "nextDialogs": [
              "751790115"
            ]
          },
          "751790115": {
            "id": "751790115",
            "speakerId": 1003,
            "speakerName": "Itsaho",
            "text": "You can take the things in the box — consider them our token of thanks.",
            "nextDialogs": [
              "751790116"
            ]
          },
          "751790116": {
            "id": "751790116",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Oh, that's easy enough. Leave it to us!"
          },
          "751790110": {
            "id": "751790110",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "Hey! Don't make it sound like we're the bad guys here!"
          }
        }
      }
    },
    {
      "subId": "7517908",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751791101"
        ],
        "dialogs": {
          "751791101": {
            "id": "751791101",
            "speakerId": 1005,
            "speakerName": "Cuchihua",
            "text": "What am I gonna do... What am I gonna do? The boss is definitely gonna beat me up when I get back...",
            "nextDialogs": [
              "751791103",
              "751791107"
            ]
          },
          "751791103": {
            "id": "751791103",
            "speakerId": 1005,
            "speakerName": "Cuchihua",
            "text": "*sigh* It's a long story... Our caravan was moving along just fine when the volcano erupted out of nowhere. Then, these massive purple Tepetlisaurs burst out of the ground...",
            "nextDialogs": [
              "751791104"
            ]
          },
          "751791104": {
            "id": "751791104",
            "speakerId": 1005,
            "speakerName": "Cuchihua",
            "text": "I wasn't paying attention, and my saurian partner got spooked and carried me far from the group. By the time I got us turned back around, the path was completely blocked, and now I can't get back to the others...",
            "nextDialogs": [
              "751791105"
            ]
          },
          "751791105": {
            "id": "751791105",
            "speakerId": 1005,
            "speakerName": "Cuchihua",
            "text": "I don't even know how everyone else is doing... and I ditched the group without permission... The boss is gonna kill me. I'm done. This is it. I'm dead."
          },
          "751791107": {
            "id": "751791107",
            "speakerId": 1005,
            "speakerName": "Cuchihua",
            "text": "Run? No, no, no, that's impossible. The boss is like the Night Kingdom — everywhere, all the time. She'll hunt me down and drag me back no matter where I go...",
            "nextDialogs": [
              "751791108"
            ]
          },
          "751791108": {
            "id": "751791108",
            "speakerId": 1005,
            "speakerName": "Cuchihua",
            "text": "I've gotta go back and apologize. But how? The road's blocked... Ugh, I'm so dead this time..."
          }
        }
      }
    },
    {
      "subId": "7517909",
      "subQuestName": "Clear the Pulverite blocking the path",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790901"
        ],
        "dialogs": {
          "751790901": {
            "id": "751790901",
            "speakerId": 1002,
            "speakerName": "Masose",
            "text": "Oh no, Itsaho, there's still so much missing from the list... H—Help me look for them, would you?",
            "nextDialogs": [
              "751790902"
            ]
          },
          "751790902": {
            "id": "751790902",
            "speakerId": 1003,
            "speakerName": "Itsaho",
            "text": "*sigh*... Don't waste your time. I already checked. Most of them were fragile goods. Do you really think any of them are still in one piece after the eruption and the crash?",
            "nextDialogs": [
              "751790903"
            ]
          },
          "751790903": {
            "id": "751790903",
            "speakerId": 1003,
            "speakerName": "Itsaho",
            "text": "Save your energy and take a break. We've got a long road ahead of us once the boss and the others get back.",
            "nextDialogs": [
              "751790904"
            ]
          },
          "751790904": {
            "id": "751790904",
            "speakerId": 1002,
            "speakerName": "Masose",
            "text": "N—No way! F—Fine, if you're not going, I'll just go myself..."
          }
        }
      }
    },
    {
      "subId": "7517911",
      "subQuestName": "Continue forward along the path",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7517905",
      "subQuestName": "Defeat the monsters that appeared",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790501"
        ],
        "dialogs": {
          "751790501": {
            "id": "751790501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Leave."
          }
        }
      }
    },
    {
      "subId": "7517906",
      "subQuestName": "Talk to Itzayah",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790601"
        ],
        "dialogs": {
          "751790601": {
            "id": "751790601",
            "speakerId": 1006,
            "speakerName": "Itzayah",
            "text": "Phew... what a mess to deal with. To think that I almost got knocked flat by some Tepetlisaurs... That just boils my blood!",
            "nextDialogs": [
              "751790602"
            ]
          },
          "751790602": {
            "id": "751790602",
            "speakerId": 1004,
            "speakerName": "Paimon",
            "text": "You've got it all wrong — those are Abyssal monsters! They're way more dangerous than Tepetlisaurs. So you thought they were just ordinary ones... No wonder you struggled!",
            "nextDialogs": [
              "751790603"
            ]
          },
          "751790603": {
            "id": "751790603",
            "speakerId": 1006,
            "speakerName": "Itzayah",
            "text": "Hah, is that it? Makes sense now. I really owe you this time. If it weren't for you guys, I'd have been done for.",
            "nextDialogs": [
              "751790604"
            ]
          },
          "751790604": {
            "id": "751790604",
            "speakerId": 1006,
            "speakerName": "Itzayah",
            "text": "Hold on a sec, I need to go round up those useless idiots first. I'll thank you properly once I make sure they're all safe.",
            "nextDialogs": [
              "751790605"
            ]
          },
          "751790605": {
            "id": "751790605",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "With your help, the people from the caravan gradually gather around."
          }
        }
      }
    },
    {
      "subId": "7517907",
      "subQuestName": "Talk to Itzayah",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790701"
        ],
        "dialogs": {
          "751790701": {
            "id": "751790701",
            "speakerId": 1000,
            "speakerName": "Tizlo",
            "text": "So, it's all thanks to these three that you made it out safe, boss?",
            "nextDialogs": [
              "751790702"
            ]
          },
          "751790702": {
            "id": "751790702",
            "speakerId": 1006,
            "speakerName": "Itzayah",
            "text": "Haha, that's right! You should've seen them in action — took down those monsters in just a couple of moves!",
            "nextDialogs": [
              "751790703"
            ]
          },
          "751790703": {
            "id": "751790703",
            "speakerId": 1000,
            "speakerName": "Tizlo",
            "text": "You saved the caravan leader. That's a debt I haven't much to offer in repayment for. But please, take this small gift as a token of my gratitude.",
            "nextDialogs": [
              "751790704"
            ]
          },
          "751790704": {
            "id": "751790704",
            "speakerId": 1006,
            "speakerName": "Itzayah",
            "text": "Seriously, Tizlo? Have you always been this stingy? That's all you're giving to the people who saved your life!?"
          }
        }
      }
    },
    {
      "subId": "7517913",
      "subQuestName": "Talk to Itzayah",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751791301"
        ],
        "dialogs": {
          "751791301": {
            "id": "751791301",
            "speakerId": 1006,
            "speakerName": "Itzayah",
            "text": "Hey, chubby! Ensuring the caravan's safety is your job, isn't it? So what's this about someone else having to clean up your mess? What do you have to say for yourself?",
            "nextDialogs": [
              "751791302"
            ]
          },
          "751791302": {
            "id": "751791302",
            "speakerId": 1005,
            "speakerName": "Cuchihua",
            "text": "I—",
            "nextDialogs": [
              "751791303"
            ]
          },
          "751791303": {
            "id": "751791303",
            "speakerId": 1006,
            "speakerName": "Itzayah",
            "text": "Quit stuttering! If you hadn't panicked and dropped your guard, a few measly monsters wouldn't have been a problem for me! This time, you're giving up part of your pay to thank our savior. Got it?",
            "nextDialogs": [
              "751791304"
            ]
          },
          "751791304": {
            "id": "751791304",
            "speakerId": 1005,
            "speakerName": "Cuchihua",
            "text": "I—I... I'll do whatever you say, boss..."
          }
        }
      }
    },
    {
      "subId": "7517910",
      "subQuestName": "Talk to Itzayah",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "751790301"
        ],
        "dialogs": {
          "751790301": {
            "id": "751790301",
            "speakerId": 1006,
            "speakerName": "Itzayah",
            "text": "Of course, such a small token as a life-saving gift does seem a bit stingy, doesn't it?",
            "nextDialogs": [
              "751790304",
              "751790305"
            ]
          },
          "751790304": {
            "id": "751790304",
            "speakerId": 1006,
            "speakerName": "Itzayah",
            "text": "Haha, well said! I like people like you — you say it how it is!",
            "nextDialogs": [
              "751790306"
            ]
          },
          "751790306": {
            "id": "751790306",
            "speakerId": 1006,
            "speakerName": "Itzayah",
            "text": "Ahem, anyway, this is a personal gift from me to you. Just accept it! Consider it a little something extra for your little Tepetlisaurus to get some more snacks. No need for any thanks or formalities!",
            "nextDialogs": [
              "751790307"
            ]
          },
          "751790307": {
            "id": "751790307",
            "speakerId": 1008,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "751790308"
            ]
          },
          "751790308": {
            "id": "751790308",
            "speakerId": 1006,
            "speakerName": "Itzayah",
            "text": "Alright, we still need to go pick up all the stuff we lost along the way. We'll be heading off now! May we meet again!"
          },
          "751790305": {
            "id": "751790305",
            "speakerId": 1006,
            "speakerName": "Itzayah",
            "text": "Tsk, you're really not very forthright, are you? That's no fun. Just take it already! Otherwise, if word gets out, people will label me a cheapskate."
          }
        }
      }
    },

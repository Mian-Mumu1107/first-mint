    "Player": 36
  },
  "subQuests": [
    {
      "subId": "7267401",
      "subQuestName": "Head to Chinju Forest to visit Ioroi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726740101"
        ],
        "dialogs": {
          "726740101": {
            "id": "726740101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey there, Ioroi!",
            "nextDialogs": [
              "726740102"
            ]
          },
          "726740102": {
            "id": "726740102",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Eeek! You saw through me? How did... Wait, no, this scent...",
            "nextDialogs": [
              "726740103"
            ]
          },
          "726740103": {
            "id": "726740103",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Ah, so it's you. It has been so long, I could not recognize your scent!",
            "nextDialogs": [
              "726740104"
            ]
          },
          "726740104": {
            "id": "726740104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And you haven't changed at all, Ioroi — still scared of humans and stuck in a stone!",
            "nextDialogs": [
              "726740105"
            ]
          },
          "726740105": {
            "id": "726740105",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Mmm!? What do you mean by that?",
            "nextDialogs": [
              "726740108"
            ]
          },
          "726740108": {
            "id": "726740108",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Bah, it is but a human seal! If I were but to try harder...",
            "nextDialogs": [
              "726740109"
            ]
          },
          "726740109": {
            "id": "726740109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "*cough*",
            "nextDialogs": [
              "726740110"
            ]
          },
          "726740110": {
            "id": "726740110",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "...",
            "nextDialogs": [
              "726740111"
            ]
          },
          "726740111": {
            "id": "726740111",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "#Well. Regardless, I see you have taken good care of the little ones. My little tanuki often say that they enjoy playing with their nice-smelling yellow-furred {F#Aunt}{M#Uncle}."
          }
        }
      }
    },
    {
      "subId": "7267402",
      "subQuestName": "Talk to Kichiboushi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726740201"
        ],
        "dialogs": {
          "726740201": {
            "id": "726740201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey there, Kichiboushi! Long time no see!",
            "nextDialogs": [
              "726740202"
            ]
          },
          "726740202": {
            "id": "726740202",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm! White Fur, Yellow Fur.",
            "nextDialogs": [
              "726740203"
            ]
          },
          "726740203": {
            "id": "726740203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I guess \"Yellow Fur\" must be me?",
            "nextDialogs": [
              "726740204"
            ]
          },
          "726740204": {
            "id": "726740204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Who're you calling White Fur?",
            "nextDialogs": [
              "726740205"
            ]
          },
          "726740205": {
            "id": "726740205",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm, very strong. Can understand.",
            "nextDialogs": [
              "726740206"
            ]
          },
          "726740206": {
            "id": "726740206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#I'm {NICKNAME}, and this is Paimon.",
            "nextDialogs": [
              "726740207"
            ]
          },
          "726740207": {
            "id": "726740207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And you'd better remember that!",
            "nextDialogs": [
              "726740208"
            ]
          },
          "726740208": {
            "id": "726740208",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Squelch squelch Lavender Melon.",
            "nextDialogs": [
              "726740209"
            ]
          },
          "726740209": {
            "id": "726740209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What? Lavender Melon? And what's \"squelch squelch\" supposed to mean?",
            "nextDialogs": [
              "726740210"
            ]
          },
          "726740210": {
            "id": "726740210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, at least we can kinda-sorta communicate...",
            "nextDialogs": [
              "726740211"
            ]
          },
          "726740211": {
            "id": "726740211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"Kinda-sorta\" is kinda-sorta right.",
            "nextDialogs": [
              "726740212"
            ]
          },
          "726740212": {
            "id": "726740212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Whatever the case, {NICKNAME}, let's go back and see Ioroi again. We are taking Kichiboushi out on a long journey, after all.",
            "nextDialogs": [
              "726740213"
            ]
          },
          "726740213": {
            "id": "726740213",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Ioroi! Yey!",
            "nextDialogs": [
              "726740214"
            ]
          },
          "726740214": {
            "id": "726740214",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yey!"
          }
        }
      }
    },
    {
      "subId": "7267403",
      "subQuestName": "Talk to Ioroi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726740301"
        ],
        "dialogs": {
          "726740301": {
            "id": "726740301",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Mm! How goes it?",
            "nextDialogs": [
              "726740302"
            ]
          },
          "726740302": {
            "id": "726740302",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm! See White Fur, Yellow Fur, very happy. Lavender Melon Kapow!",
            "nextDialogs": [
              "726740303"
            ]
          },
          "726740303": {
            "id": "726740303",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Lavender Melon Kapow...",
            "nextDialogs": [
              "726740304"
            ]
          },
          "726740304": {
            "id": "726740304",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Hmm, quite the bright spark, aren't you?",
            "nextDialogs": [
              "726740305"
            ]
          },
          "726740305": {
            "id": "726740305",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Kapow!",
            "nextDialogs": [
              "726740306"
            ]
          },
          "726740306": {
            "id": "726740306",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, what does Lavender Melon Kapow mean again...?",
            "nextDialogs": [
              "726740307"
            ]
          },
          "726740307": {
            "id": "726740307",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Kapow is Kapow. Lavender Melon is Lavender Melon.",
            "nextDialogs": [
              "726740308"
            ]
          },
          "726740308": {
            "id": "726740308",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Well, it seems that communications have been established without any problems. Ah, mine \"culinary\" skills are as fine as ever!",
            "nextDialogs": [
              "726740310"
            ]
          },
          "726740310": {
            "id": "726740310",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Nope, not at all! We can't understand a thing Kichiboushi's saying!",
            "nextDialogs": [
              "726740312"
            ]
          },
          "726740312": {
            "id": "726740312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, Ioroi, here's the thing...",
            "nextDialogs": [
              "726740313"
            ]
          },
          "726740313": {
            "id": "726740313",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "You tell Ioroi how the attempted interactions are going...",
            "nextDialogs": [
              "726740314"
            ]
          },
          "726740314": {
            "id": "726740314",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Mmm, so that's how it is. Not to worry. It is because you are not yet used to Kichiboushi's aura.",
            "nextDialogs": [
              "726740315"
            ]
          },
          "726740315": {
            "id": "726740315",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Take it slow! The more used to his aura you are, the better you shall understand him!",
            "nextDialogs": [
              "726740316"
            ]
          },
          "726740316": {
            "id": "726740316",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How slow are we talking about here?",
            "nextDialogs": [
              "726740317"
            ]
          },
          "726740317": {
            "id": "726740317",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Ah, hmm. Let me think about that...",
            "nextDialogs": [
              "726740318"
            ]
          },
          "726740318": {
            "id": "726740318",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Eh! Whatever the case, do not be in a rush!",
            "nextDialogs": [
              "726740319"
            ]
          },
          "726740319": {
            "id": "726740319",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Rush no good.",
            "nextDialogs": [
              "726740320"
            ]
          },
          "726740320": {
            "id": "726740320",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You don't know either, do you?",
            "nextDialogs": [
              "726740321"
            ]
          },
          "726740321": {
            "id": "726740321",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Hmph! I will have you know that I am Ioroi, the long-lived king of bake-danuki! I simply do not put such premiums on time as you humans do.",
            "nextDialogs": [
              "726740322"
            ]
          },
          "726740322": {
            "id": "726740322",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "(Even though he's spent most of his time sealed in that stone statue...)",
            "nextDialogs": [
              "726740323"
            ]
          },
          "726740323": {
            "id": "726740323",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Then why can you speak to humans just fine, Ioroi?",
            "nextDialogs": [
              "726740324"
            ]
          },
          "726740324": {
            "id": "726740324",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Mmph! Such impertinence! Rather, you should ask why you humans may speak to us.",
            "nextDialogs": [
              "726740325"
            ]
          },
          "726740325": {
            "id": "726740325",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Having lived as long and become as powerful as I have, I have had at least some interactions with humanity.",
            "nextDialogs": [
              "726740326"
            ]
          },
          "726740326": {
            "id": "726740326",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "A long, long time ago, I often spoke with tengu, kitsune, oni, youkai, and humans alike. And while human stories often concern themselves, at least half of them involve bake-danuki who transformed into humans.",
            "nextDialogs": [
              "726740327"
            ]
          },
          "726740327": {
            "id": "726740327",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Half of the remaining half are indeed about humans themselves, and the other half are about all the other youkai.",
            "nextDialogs": [
              "726740328"
            ]
          },
          "726740328": {
            "id": "726740328",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "But even in this half, a good half concern we tanuki, who clad ourselves in the guise of the other youkai. Then half again of the tanuki tales are those concerning me.",
            "nextDialogs": [
              "726740329"
            ]
          },
          "726740329": {
            "id": "726740329",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Mmph, as such, you may see that I am the greatest of them all. Naturally, speaking to you young ones is no tall order at all.",
            "nextDialogs": [
              "726740330"
            ]
          },
          "726740330": {
            "id": "726740330",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I get it. Five over sixteen to Ioroi, yes?",
            "nextDialogs": [
              "726740331"
            ]
          },
          "726740331": {
            "id": "726740331",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Mm? What's \"Five Over Sixteen\"? Is it something that one may eat?",
            "nextDialogs": [
              "726740332"
            ]
          },
          "726740332": {
            "id": "726740332",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Sounds delicious. Want to eat.",
            "nextDialogs": [
              "726740333"
            ]
          },
          "726740333": {
            "id": "726740333",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}'s referring to the percentage of stories that you're involved in, Ioroi.",
            "nextDialogs": [
              "726740334"
            ]
          },
          "726740334": {
            "id": "726740334",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Ioroi. Powerful!",
            "nextDialogs": [
              "726740335"
            ]
          },
          "726740335": {
            "id": "726740335",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Hah, why of course! You have much to learn from my powers, you do.",
            "nextDialogs": [
              "726740336"
            ]
          },
          "726740336": {
            "id": "726740336",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Come to think of it, we're starting to get what Kichiboushi is saying, aren't we?",
            "nextDialogs": [
              "726740337"
            ]
          },
          "726740337": {
            "id": "726740337",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "White Fur smart.",
            "nextDialogs": [
              "726740338"
            ]
          },
          "726740338": {
            "id": "726740338",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That might have been praise, but Paimon sure doesn't feel good about it.",
            "nextDialogs": [
              "726740339"
            ]
          },
          "726740339": {
            "id": "726740339",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Good, good. Then I leave this child in your hands. Take him to go see the world and train!",
            "nextDialogs": [
              "726740340"
            ]
          },
          "726740340": {
            "id": "726740340",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Why, when I was but a young tanuki, I too went on a pilgrimage to eighteen sites in Inazuma along the trail of the great bake-danuki Tsukumo, never once straying from the tanuki paths — only thus did I reach my present stature.",
            "nextDialogs": [
              "726740341"
            ]
          },
          "726740341": {
            "id": "726740341",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? Is that why you were sealed in stone?",
            "nextDialogs": [
              "726740342"
            ]
          },
          "726740342": {
            "id": "726740342",
            "speakerId": 3160,
            "speakerName": "\"Kichiboushi\"",
            "text": "Mm-haha! Stone!",
            "nextDialogs": [
              "726740343"
            ]
          },
          "726740343": {
            "id": "726740343",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Eh!? You too, Kichiboushi...?",
            "nextDialogs": [
              "726740344"
            ]
          },
          "726740344": {
            "id": "726740344",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ahem! So, uh, back on topic! Where should we go first?"
          }
        }
      }
    },
    {
      "subId": "7267404",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726740401"
        ],
        "dialogs": {
          "726740401": {
            "id": "726740401",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Through the power of the bake-danuki meal made by mine own hands, you, too, may speak to the little tanuki. Go, try having a chat with Kichiboushi.",
            "nextDialogs": [
              "726740402"
            ]
          },
          "726740402": {
            "id": "726740402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll do that.",
            "nextDialogs": [
              "726740403"
            ]
          },
          "726740403": {
            "id": "726740403",
            "speakerId": 3159,
            "speakerName": "Ioroi",
            "text": "Go, then, go. I have all the time in the world to go nowhere, but it is not so with my little tanuki."
          }
        }
      }
    }
  ]
}
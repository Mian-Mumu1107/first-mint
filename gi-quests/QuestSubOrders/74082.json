    {
      "subId": "7408207",
      "subQuestName": "Talk to the Melusine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740820701"
        ],
        "dialogs": {
          "740820701": {
            "id": "740820701",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "A glittering pearl of water appears on the altar.",
            "nextDialogs": [
              "740820702"
            ]
          },
          "740820702": {
            "id": "740820702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um, that drop of water... That can't be the treasure, can it?",
            "nextDialogs": [
              "740820703"
            ]
          },
          "740820703": {
            "id": "740820703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It doesn't look like treasure.",
            "nextDialogs": [
              "740820704"
            ]
          },
          "740820704": {
            "id": "740820704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's what Paimon thought. It can't be that easy. But what is it, then?",
            "nextDialogs": [
              "740820706",
              "740820711"
            ]
          },
          "740820706": {
            "id": "740820706",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What? But that means catastrophe! Quick, put it back. Paimon hopes we're not too late!",
            "nextDialogs": [
              "740820707"
            ]
          },
          "740820707": {
            "id": "740820707",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Ah...",
            "nextDialogs": [
              "740820708"
            ]
          },
          "740820708": {
            "id": "740820708",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no! It's the Demon King!",
            "nextDialogs": [
              "740820709"
            ]
          },
          "740820709": {
            "id": "740820709",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "The Demon King? Melusine.",
            "nextDialogs": [
              "740820715"
            ]
          },
          "740820715": {
            "id": "740820715",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Gah, you gave Paimon a fright there... A Melusine, huh? What are you doing here?",
            "nextDialogs": [
              "740820716"
            ]
          },
          "740820716": {
            "id": "740820716",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Key.",
            "nextDialogs": [
              "740820717"
            ]
          },
          "740820717": {
            "id": "740820717",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Key? What key? Is this drop of water a key?",
            "nextDialogs": [
              "740820718"
            ]
          },
          "740820718": {
            "id": "740820718",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Pahsiv.",
            "nextDialogs": [
              "740820719"
            ]
          },
          "740820719": {
            "id": "740820719",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Err... The drop of water is Pahsiv?",
            "nextDialogs": [
              "740820720"
            ]
          },
          "740820720": {
            "id": "740820720",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Melusine.",
            "nextDialogs": [
              "740820721"
            ]
          },
          "740820721": {
            "id": "740820721",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh! What do you mean? Is the drop of water a Melusine? Paimon's getting dizzy. What on earth is this? Aren't you the Melusine here?",
            "nextDialogs": [
              "740820722"
            ]
          },
          "740820722": {
            "id": "740820722",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Pahsiv...",
            "nextDialogs": [
              "740820723"
            ]
          },
          "740820723": {
            "id": "740820723",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Err... You're a Pahsiv? Or is your name Pahsiv? Wait... No, don't answer. You'll just make Paimon dizzier...",
            "nextDialogs": [
              "740820724"
            ]
          },
          "740820724": {
            "id": "740820724",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, Paimon's decided to call you Pahsiv. Is that okay?",
            "nextDialogs": [
              "740820725"
            ]
          },
          "740820725": {
            "id": "740820725",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "Melusine...",
            "nextDialogs": [
              "740820726"
            ]
          },
          "740820726": {
            "id": "740820726",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}... What should we do? Paimon can't understand a thing she's saying. What is she trying to say?",
            "nextDialogs": [
              "740820727"
            ]
          },
          "740820727": {
            "id": "740820727",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You can understand what we're saying, can't you?",
            "nextDialogs": [
              "740820728"
            ]
          },
          "740820728": {
            "id": "740820728",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv...",
            "nextDialogs": [
              "740820729"
            ]
          },
          "740820729": {
            "id": "740820729",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This drop of water is a key, right?",
            "nextDialogs": [
              "740820730"
            ]
          },
          "740820730": {
            "id": "740820730",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv.",
            "nextDialogs": [
              "740820731"
            ]
          },
          "740820731": {
            "id": "740820731",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're not a human, are you?",
            "nextDialogs": [
              "740820732"
            ]
          },
          "740820732": {
            "id": "740820732",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740820733"
            ]
          },
          "740820733": {
            "id": "740820733",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Er... Let's not be rude all of a sudden, shall we?",
            "nextDialogs": [
              "740820734"
            ]
          },
          "740820734": {
            "id": "740820734",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm not a human, am I?",
            "nextDialogs": [
              "740820735"
            ]
          },
          "740820735": {
            "id": "740820735",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "M—Melusine?",
            "nextDialogs": [
              "740820736"
            ]
          },
          "740820736": {
            "id": "740820736",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh! Wait! Paimon thinks she's starting to understand. \"Pahsiv\" is yes and \"Melusine\" is no. Could that be it?",
            "nextDialogs": [
              "740820737"
            ]
          },
          "740820737": {
            "id": "740820737",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv! Pahsiv!",
            "nextDialogs": [
              "740820738"
            ]
          },
          "740820738": {
            "id": "740820738",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So you're not called Pahsiv. Sorry, Paimon got your name wrong earlier.",
            "nextDialogs": [
              "740820739"
            ]
          },
          "740820739": {
            "id": "740820739",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv... likes...",
            "nextDialogs": [
              "740820740"
            ]
          },
          "740820740": {
            "id": "740820740",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You like the name?",
            "nextDialogs": [
              "740820741"
            ]
          },
          "740820741": {
            "id": "740820741",
            "speakerId": 1005,
            "speakerName": "Pahsiv?",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740820742"
            ]
          },
          "740820742": {
            "id": "740820742",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Wonderful! Then that's what Paimon's gonna call you, hehe. This is {NICKNAME}. We're glad to meet you, Pahsiv. Paimon's never met a Melusine like you.",
            "nextDialogs": [
              "740820743"
            ]
          },
          "740820743": {
            "id": "740820743",
            "speakerId": 5325,
            "speakerName": "Pahsiv",
            "text": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
            "nextDialogs": [
              "740820744"
            ]
          },
          "740820744": {
            "id": "740820744",
            "speakerId": 5325,
            "speakerName": "Pahsiv",
            "text": "Erinnyes... Melusine...",
            "nextDialogs": [
              "740820745"
            ]
          },
          "740820745": {
            "id": "740820745",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...So you mean Erinn-no? Or... Err...",
            "nextDialogs": [
              "740820746"
            ]
          },
          "740820746": {
            "id": "740820746",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Something wrong with Erinnyes?",
            "nextDialogs": [
              "740820747"
            ]
          },
          "740820747": {
            "id": "740820747",
            "speakerId": 5325,
            "speakerName": "Pahsiv",
            "text": "Erinnyes, Melusine, now...",
            "nextDialogs": [
              "740820748"
            ]
          },
          "740820748": {
            "id": "740820748",
            "speakerId": 5325,
            "speakerName": "Pahsiv",
            "text": "Pahsiv, Erinnyes, protect...",
            "nextDialogs": [
              "740820749"
            ]
          },
          "740820749": {
            "id": "740820749",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, something bad is happening to Erinnyes, and you want to protect it?",
            "nextDialogs": [
              "740820750"
            ]
          },
          "740820750": {
            "id": "740820750",
            "speakerId": 5325,
            "speakerName": "Pahsiv",
            "text": "#Paimon, {NICKNAME}, Erinnyes, ka-pow, ka-pow...",
            "nextDialogs": [
              "740820751"
            ]
          },
          "740820751": {
            "id": "740820751",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Err... So that's five words now. So... you want Paimon and {NICKNAME} to punch Erinnyes? Like KA-POW?",
            "nextDialogs": [
              "740820752"
            ]
          },
          "740820752": {
            "id": "740820752",
            "speakerId": 5325,
            "speakerName": "Pahsiv",
            "text": "Melusine!",
            "nextDialogs": [
              "740820753"
            ]
          },
          "740820753": {
            "id": "740820753",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You want us to help?",
            "nextDialogs": [
              "740820754"
            ]
          },
          "740820754": {
            "id": "740820754",
            "speakerId": 5325,
            "speakerName": "Pahsiv",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740820755"
            ]
          },
          "740820755": {
            "id": "740820755",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay, so she wants help from us. That's good. Paimon didn't know how we could punch Erinnyes, with it being a whole island and all...",
            "nextDialogs": [
              "740820756"
            ]
          },
          "740820756": {
            "id": "740820756",
            "speakerId": 5325,
            "speakerName": "Pahsiv",
            "text": "Ka-pow, ka-pow."
          },
          "740820711": {
            "id": "740820711",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What? Oh no, that makes us thieves. Ohh, Paimon's sorry... Let's put it back, quick.",
            "nextDialogs": [
              "740820712"
            ]
          },
          "740820712": {
            "id": "740820712",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "Ah...",
            "nextDialogs": [
              "740820713"
            ]
          },
          "740820713": {
            "id": "740820713",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no! The boss is back!",
            "nextDialogs": [
              "740820714"
            ]
          },
          "740820714": {
            "id": "740820714",
            "speakerId": 10205,
            "speakerName": "???",
            "text": "The boss? Melusine."
          }
        }
      }
    },
    {
      "subId": "7408210",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740821001"
        ],
        "dialogs": {
          "740821001": {
            "id": "740821001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And that's another key for us. Now all we need to do is find the final one.",
            "nextDialogs": [
              "740821002"
            ]
          },
          "740821002": {
            "id": "740821002",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Key, key, Pahsiv!",
            "nextDialogs": [
              "740821003"
            ]
          },
          "740821003": {
            "id": "740821003",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, Pahsiv! Where did you come from?",
            "nextDialogs": [
              "740821004"
            ]
          },
          "740821004": {
            "id": "740821004",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Disappeared, Pahsiv.",
            "nextDialogs": [
              "740821005"
            ]
          },
          "740821005": {
            "id": "740821005",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Okay then... Paimon's never met a Melusine so unique... And Paimon thought Melusine all lived in the Court of Fontaine or Merusea Village. How come you're out here?",
            "nextDialogs": [
              "740821006"
            ]
          },
          "740821006": {
            "id": "740821006",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Court of Fontaine? Merusea Village?",
            "nextDialogs": [
              "740821007"
            ]
          },
          "740821007": {
            "id": "740821007",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You seem confused. Haven't you heard of those places?",
            "nextDialogs": [
              "740821008"
            ]
          },
          "740821008": {
            "id": "740821008",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Court of Fontaine, Melusine... Merusea Village, Melusine...",
            "nextDialogs": [
              "740821009"
            ]
          },
          "740821009": {
            "id": "740821009",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Ah... Erinnyes, Pahsiv, home.",
            "nextDialogs": [
              "740821010"
            ]
          },
          "740821010": {
            "id": "740821010",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Erinnyes, Pahsiv, protect!",
            "nextDialogs": [
              "740821011"
            ]
          },
          "740821011": {
            "id": "740821011",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, you're saying that this is your home? And that you're protecting it?",
            "nextDialogs": [
              "740821012"
            ]
          },
          "740821012": {
            "id": "740821012",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740821013"
            ]
          },
          "740821013": {
            "id": "740821013",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But don't the Melusine live in Merusea Village?",
            "nextDialogs": [
              "740821014"
            ]
          },
          "740821014": {
            "id": "740821014",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yes, that's kinda strange. Are some Melusine born elsewhere? Paimon can't see any others here though.",
            "nextDialogs": [
              "740821015"
            ]
          },
          "740821015": {
            "id": "740821015",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Pahsiv, do you live here alone?",
            "nextDialogs": [
              "740821016"
            ]
          },
          "740821016": {
            "id": "740821016",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Alone? Melusine. New Valet! Pahsiv!",
            "nextDialogs": [
              "740821017"
            ]
          },
          "740821017": {
            "id": "740821017",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "New... Valet? There's a valet? Who?",
            "nextDialogs": [
              "740821018"
            ]
          },
          "740821018": {
            "id": "740821018",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#New... Valet! Paimon, Paimon, {NICKNAME}, {NICKNAME}. New Valet, New Valet!",
            "nextDialogs": [
              "740821019"
            ]
          },
          "740821019": {
            "id": "740821019",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So who is New Valet, exactly?",
            "nextDialogs": [
              "740821020"
            ]
          },
          "740821020": {
            "id": "740821020",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Pahsiv... are you trying to say New Valet is called New Valet, like Paimon is called Paimon?",
            "nextDialogs": [
              "740821021"
            ]
          },
          "740821021": {
            "id": "740821021",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740821022"
            ]
          },
          "740821022": {
            "id": "740821022",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah-ha! I was right. Paimon's always said that she's clever, hasn't she?",
            "nextDialogs": [
              "740821025"
            ]
          },
          "740821025": {
            "id": "740821025",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "New Valet, Pahsiv, knowledge, ka-pow.",
            "nextDialogs": [
              "740821026"
            ]
          },
          "740821026": {
            "id": "740821026",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Err... you mean that New Valet is helping you learn things?",
            "nextDialogs": [
              "740821027"
            ]
          },
          "740821027": {
            "id": "740821027",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv! Lots of. Language, wisdom... lots of.",
            "nextDialogs": [
              "740821028"
            ]
          },
          "740821028": {
            "id": "740821028",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Er, Paimon's not sure about the \"lots of\" bit...",
            "nextDialogs": [
              "740821029"
            ]
          },
          "740821029": {
            "id": "740821029",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv, New Valet, protect, ka-pow.",
            "nextDialogs": [
              "740821030"
            ]
          },
          "740821030": {
            "id": "740821030",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And he helps you protect this place?",
            "nextDialogs": [
              "740821031"
            ]
          },
          "740821031": {
            "id": "740821031",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Melusine...",
            "nextDialogs": [
              "740821032"
            ]
          },
          "740821032": {
            "id": "740821032",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You help him protect this place?",
            "nextDialogs": [
              "740821033"
            ]
          },
          "740821033": {
            "id": "740821033",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740821034"
            ]
          },
          "740821034": {
            "id": "740821034",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So that's it... But who is this New Valet? And why does he need you to help protect this place, anyway?",
            "nextDialogs": [
              "740821035"
            ]
          },
          "740821035": {
            "id": "740821035",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Some bad things have happened here, too. We saw the stone tablet, and how someone had scratched out the inscription. And we saw lots of filth... Are there enemies around?",
            "nextDialogs": [
              "740821036"
            ]
          },
          "740821036": {
            "id": "740821036",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Curious Paimon, Pahsiv! But time very not lots of.",
            "nextDialogs": [
              "740821037"
            ]
          },
          "740821037": {
            "id": "740821037",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Key, key, key, square, west, ka-pow, ka-pow.",
            "nextDialogs": [
              "740821038"
            ]
          },
          "740821038": {
            "id": "740821038",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll be as quick as we can!",
            "nextDialogs": [
              "740821039"
            ]
          },
          "740821039": {
            "id": "740821039",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
            "nextDialogs": [
              "740821040"
            ]
          },
          "740821040": {
            "id": "740821040",
            "speakerId": 1003,
            "speakerName": "Black Screen",
            "text": "Pahsiv gives two happy jumps and then leaves in a bit of a hurry.",
            "nextDialogs": [
              "740821041"
            ]
          },
          "740821041": {
            "id": "740821041",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It looks like we really are pressed for time. But we've already got two keys, so let's press on and get the third!"
          }
        }
      }
    },
    {

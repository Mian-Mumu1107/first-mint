        ],
        "dialogs": {
          "740829901": {
            "id": "740829901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Woah! What is that weirdly-shaped tree? It looks so... lonesome. And there's an altar under it, too.",
            "nextDialogs": [
              "740829905"
            ]
          },
          "740829905": {
            "id": "740829905",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "In Paimon's experience, that just screams \"Hey, over here! Treasure!\"",
            "nextDialogs": [
              "740829904"
            ]
          },
          "740829904": {
            "id": "740829904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look! It's super foggy over there. Is that the Foggy Forest Path? Let's go investigate!"
          }
        }
      }
    },

            "speakerName": "Black Screen",
            "text": "A glittering pearl of water appears on the altar.",
            "nextDialogs": [
              "740820902"
            ]
          },
          "740820902": {
            "id": "740820902",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Awesome! Now, we have the third key.",
            "nextDialogs": [
              "740820903"
            ]
          },
          "740820903": {
            "id": "740820903",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "Key, key, key!",
            "nextDialogs": [
              "740820904"
            ]
          },
          "740820904": {
            "id": "740820904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Disappeared, Pahsiv!",
            "nextDialogs": [
              "740820905"
            ]
          },
          "740820905": {
            "id": "740820905",
            "speakerId": 16210,
            "speakerName": "Pahsiv",
            "text": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv! Key, key, key!",
            "nextDialogs": [
              "740820906"
            ]
          },
          "740820906": {
            "id": "740820906",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Square, west!",
            "nextDialogs": [
              "740820907"
            ]
          },
          "740820907": {
            "id": "740820907",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe. Is this what you're trying to say? Don't worry, we're going there now."
          }
        }
      }
    },
    {
      "subId": "7408299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {

  "subQuests": [
    {
      "subId": "7408201",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740820101"
        ],
        "dialogs": {
          "740820101": {
            "id": "740820101",
            "speakerId": 1000,
            "speakerName": "Inscribed Stone Tablet",
            "text": "(Most of the inscription has been scratched out, but you can make out \"...clear dew... sings on the Foggy Forest Path...\")",
            "nextDialogs": [
              "740820102"
            ]
          },
          "740820102": {
            "id": "740820102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa! So many words have been scratched out! These look like introductions to attractions, don't they? Bah, some tourists are just so inconsiderate.",
            "nextDialogs": [
              "740820103"
            ]
          },
          "740820103": {
            "id": "740820103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Tourists usually only write stuff, don't they?",
            "nextDialogs": [
              "740820104"
            ]
          },
          "740820104": {
            "id": "740820104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hmm... That's true, like writing \"{NICKNAME} and Paimon were here\" and stuff... No! Wait! We're good people, we wouldn't do that...",
            "nextDialogs": [
              "740820105"
            ]
          },
          "740820105": {
            "id": "740820105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Then it's strange, isn't it? Why would they scratch out the words? And just leave that bit in...",
            "nextDialogs": [
              "740820106"
            ]
          },
          "740820106": {
            "id": "740820106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There are so many scratches on this sentence too! Paimon bets they didn't manage to scratch it out completely! Lucky Foggy Forest Path, you slipped through the cracks...",
            "nextDialogs": [
              "740820107"
            ]
          },
          "740820107": {
            "id": "740820107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, what is this Foggy Forest Path?",
            "nextDialogs": [
              "740820108"
            ]
          },
          "740820108": {
            "id": "740820108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Do they mean that the forest paths are super foggy?",
            "nextDialogs": [
              "740820109"
            ]
          },
          "740820109": {
            "id": "740820109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon feels like checking it out! Y'know, it sounds like the sort of thing that might lead to secret treasure, doesn't it? That's how it is in the books, anyway. Hehe.",
            "nextDialogs": [
              "740820112"
            ]
          },
          "740820112": {
            "id": "740820112",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Paimon doesn't just eat all day! Paimon has a strong feeling that there's treasure hidden in this Foggy Forest Path, and that's why it was covered up!",
            "nextDialogs": [
              "740820113"
            ]
          },
          "740820113": {
            "id": "740820113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Never mind that, {NICKNAME}! It's treasure-hunting time with your best friend, Paimon, and her super treasure-detecting senses!"
          }
        }
      }
    },
    {
      "subId": "7408209",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740820401"
        ],
        "dialogs": {
          "740820401": {
            "id": "740820401",
            "speakerId": 21112,
            "speakerName": "Mysterious Altar",
            "text": "(Most of the inscription has been scratched out, but you can make out \"...clear dew... three...\")",
            "nextDialogs": [
              "740820402"
            ]
          },
          "740820402": {
            "id": "740820402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ugh! The words here have been scratched out too! Someone must be hiding something!",
            "nextDialogs": [
              "740820404",
              "740820407"
            ]
          },
          "740820404": {
            "id": "740820404",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What does clear dew represent? Crystal clear dew? But there's water all over the place!",
            "nextDialogs": [
              "740820405"
            ]
          },
          "740820405": {
            "id": "740820405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "As for the word three, does that represent three drops of water? Ugh, this is such a headache...",
            "nextDialogs": [
              "740820409"
            ]
          },
          "740820409": {
            "id": "740820409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Come on, Paimon, let's ask your super keen treasure-detecting senses!",
            "nextDialogs": [
              "740820410"
            ]
          },
          "740820410": {
            "id": "740820410",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's done that! A—Anyway...",
            "nextDialogs": [
              "740820411"
            ]
          },
          "740820411": {
            "id": "740820411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, it says the answer is linked to three and water, so let's look around!"
          },
          "740820407": {
            "id": "740820407",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Does it represent three things?",
            "nextDialogs": [
              "740820408"
            ]
          },
          "740820408": {
            "id": "740820408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And as for clear dew, does it represent crystal clear dew? But there's water all over the place! Ugh, this is such a headache..."
          }
        }
      }
    },

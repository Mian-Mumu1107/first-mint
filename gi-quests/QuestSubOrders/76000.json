    },
    {
      "subId": "7600021",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760000801"
        ],
        "dialogs": {
          "760000801": {
            "id": "760000801",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It looks like they really were doing experiments here, but this isn't the only place. There are three more sites up on the surface.",
            "nextDialogs": [
              "760000802"
            ]
          },
          "760000802": {
            "id": "760000802",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#They're collecting data from those sites and then sending it down here for analysis. Hey, {NICKNAME}, what if we made off with all their data?",
            "nextDialogs": [
              "760000803"
            ]
          },
          "760000803": {
            "id": "760000803",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, actually, Paimon's kinda curious about what they found out. How about... how about we collect the data from all three sites, check the results, and then take everything with us!?",
            "nextDialogs": [
              "760000805",
              "760000807"
            ]
          },
          "760000805": {
            "id": "760000805",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Duh! So the Fatui don't get their hands on them!",
            "nextDialogs": [
              "760000808"
            ]
          },
          "760000808": {
            "id": "760000808",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Besides, aren't you the least bit curious about the results, {NICKNAME}? Come on, let's give it a try!"
          },
          "760000807": {
            "id": "760000807",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Th—That'd cause way too much of a scene, wouldn't it? Let's not go overboard here and create a bunch of needless noise..."
          }
        }
      }
    },
    {

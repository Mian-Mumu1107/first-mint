    {
      "subId": "7600009",
      "subQuestName": "Go to the marked location to retrieve data",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760000901"
        ],
        "dialogs": {
          "760000901": {
            "id": "760000901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It looks like they really were doing experiments here, but this isn't the only place. There are three more sites up on the surface.",
            "nextDialogs": [
              "760000902"
            ]
          },
          "760000902": {
            "id": "760000902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? Wait a minute, was that stuff we picked up earlier the data the Fatui were trying to retrieve?",
            "nextDialogs": [
              "760000903"
            ]
          },
          "760000903": {
            "id": "760000903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "How about... how about we input all the data, check the results, and then take everything with us?",
            "nextDialogs": [
              "760000905",
              "760000907"
            ]
          },
          "760000905": {
            "id": "760000905",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Duh! So the Fatui don't get their hands on them!",
            "nextDialogs": [
              "760000908"
            ]
          },
          "760000908": {
            "id": "760000908",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Besides, aren't you the least bit curious about the results, {NICKNAME}? Come on, let's give it a try!"
          },
          "760000907": {
            "id": "760000907",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Th—That'd cause way too much of a scene, wouldn't it? Let's not go overboard here and create a bunch of needless noise..."
          }
        }
      }
    },

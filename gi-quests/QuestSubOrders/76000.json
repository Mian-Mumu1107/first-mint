    {
      "subId": "7600002",
      "subQuestName": "Investigate the entrance",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760000201"
        ],
        "dialogs": {
          "760000201": {
            "id": "760000201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... looks like this door won't open. Paimon's really curious about what's on the other side...",
            "nextDialogs": [
              "760000203",
              "760000205"
            ]
          },
          "760000203": {
            "id": "760000203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Considering where it is, this doesn't seem like the kind of place where anything important would be...",
            "nextDialogs": [
              "760000206"
            ]
          },
          "760000206": {
            "id": "760000206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Now we've really gotta take a look inside! Otherwise, it'll sit in Paimon's head like having a belly full of Nod-Krai Hot Dogs that just won't go down!",
            "nextDialogs": [
              "760000207"
            ]
          },
          "760000207": {
            "id": "760000207",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "The door might be locked, but maybe there's another way in."
          },
          "760000205": {
            "id": "760000205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "E—Evil experiment... If that's the case, the security here is way too lax!"
          }
        }
      }
    },

    {
      "subId": "7600014",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760001401"
        ],
        "dialogs": {
          "760001401": {
            "id": "760001401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We're locked in! This has to be another trap. How are we supposed to get out...?",
            "nextDialogs": [
              "760001402"
            ]
          },
          "760001402": {
            "id": "760001402",
            "speakerId": 1005,
            "speakerName": "Kholodov",
            "text": "The device has been activated? Does that mean...",
            "nextDialogs": [
              "760001403"
            ]
          },
          "760001403": {
            "id": "760001403",
            "speakerId": 1005,
            "speakerName": "Kholodov",
            "text": "Let's see which filthy rat has snuck in this time... You!? You're the criminals who ruined the experiment site! And now you dare come here!?",
            "nextDialogs": [
              "760001404"
            ]
          },
          "760001404": {
            "id": "760001404",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, Paimon doesn't feel like a beating right now! Quick, do something about that barrier!"
          }
        }
      }
    },
    {
      "subId": "7600015",
      "subQuestName": "Find a way to escape",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7600016",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760001601"
        ],
        "dialogs": {
          "760001601": {
            "id": "760001601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We finally got rid of them — huh? Why isn't the machine showing anything? Don't tell me it got broken during the fight... Or did the Fatui shut it down?",
            "nextDialogs": [
              "760001602"
            ]
          },
          "760001602": {
            "id": "760001602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ugh, all that and we still didn't get to see the results...",
            "nextDialogs": [
              "760001603"
            ]
          },
          "760001603": {
            "id": "760001603",
            "speakerId": 1006,
            "speakerName": "???",
            "text": "...",
            "nextDialogs": [
              "760001604"
            ]
          },
          "760001604": {
            "id": "760001604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#...{NICKNAME}, did you hear that strange sound just now? P—Paimon thinks it came from that way..."
          }
        }
      }
    },
    {
      "subId": "7600017",
      "subQuestName": "Investigate the source of the unusual sound",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760001701"
        ],
        "dialogs": {
          "760001701": {
            "id": "760001701",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Wow! Is that a white Weasel Thief? Paimon's never seen one that white before!",
            "nextDialogs": [
              "760001702"
            ]
          },
          "760001702": {
            "id": "760001702",
            "speakerId": 1007,
            "speakerName": "White Weasel Thief",
            "text": "...",
            "nextDialogs": [
              "760001703"
            ]
          },
          "760001703": {
            "id": "760001703",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "P—Paimon's Mora! Stop right there, you thief!",
            "nextDialogs": [
              "760001704"
            ]
          },
          "760001704": {
            "id": "760001704",
            "speakerId": 1008,
            "speakerName": "Black Screen",
            "text": "Unable to catch up, you watch helplessly as the white Weasel Thief runs away...",
            "nextDialogs": [
              "760001705"
            ]
          },
          "760001705": {
            "id": "760001705",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ugh, it zipped away just like that...",
            "nextDialogs": [
              "760001706"
            ]
          },
          "760001706": {
            "id": "760001706",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Good thing I didn't lose anything.",
            "nextDialogs": [
              "760001707"
            ]
          },
          "760001707": {
            "id": "760001707",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But Paimon did! Paimon's secret stash. Waaah... If Paimon ever runs into that Weasel Thief again, Paimon's gonna make it pay back double!"
          }
        }
      }
    },
    {
      "subId": "7600099",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760009901"
        ],
        "dialogs": {
          "760009901": {
            "id": "760009901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? We can get in through here? Paimon thought a place full of secrets would be more heavily guarded than this!",
            "nextDialogs": [
              "760009902"
            ]
          },
          "760009902": {
            "id": "760009902",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whoa! This is way down under the ground!",
            "nextDialogs": [
              "760009903"
            ]
          },
          "760009903": {
            "id": "760009903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Tch... Paimon knew it'd be sealed shut!",
            "nextDialogs": [
              "760009904"
            ]
          },
          "760009904": {
            "id": "760009904",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Now Paimon's even more curious... What kind of facility is this? If only we could get inside and take a look...",
            "nextDialogs": [
              "760009905"
            ]
          },
          "760009905": {
            "id": "760009905",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Traps!? But how come there's no alarm going off?",
            "nextDialogs": [
              "760009906"
            ]
          },
          "760009906": {
            "id": "760009906",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Don't tell Paimon the staff have to figure their way through all this, too? That's downright cruel...",
            "nextDialogs": [
              "760009907"
            ]
          },
          "760009907": {
            "id": "760009907",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We have to go even deeper? How does anyone put up with working in a place with no sunlight?",
            "nextDialogs": [
              "760009908"
            ]
          },
          "760009908": {
            "id": "760009908",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm, maybe that's the point. If they never see the sun, they won't know when it's time to clock out! How horrible!",
            "nextDialogs": [
              "760009909"
            ]
          },
          "760009909": {
            "id": "760009909",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Alright, that's all three sets of data! Let's head back to the underground lab!",
            "nextDialogs": [
              "760009910"
            ]
          },
          "760009910": {
            "id": "760009910",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, let's input the data!",
            "nextDialogs": [
              "760009911"
            ]
          },
          "760009911": {
            "id": "760009911",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What's this? It looks like something to record data with..."
          }
        }
      }
    }
  ]
}
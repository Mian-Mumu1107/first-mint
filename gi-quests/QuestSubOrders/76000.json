    {
      "subId": "7600006",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760000601"
        ],
        "dialogs": {
          "760000601": {
            "id": "760000601",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So many jars! And inside them... could it be kuuvahki?",
            "nextDialogs": [
              "760000602"
            ]
          },
          "760000602": {
            "id": "760000602",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What are the Fatui doing, placing these things so deep underground?",
            "nextDialogs": [
              "760000604",
              "760000606"
            ]
          },
          "760000604": {
            "id": "760000604",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Obviously, Paimon knows that! But what are they using them for? Presumably, it's not for bathing...",
            "nextDialogs": [
              "760000607"
            ]
          },
          "760000607": {
            "id": "760000607",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, let's investigate around here first. Maybe we'll uncover some clues."
          },
          "760000606": {
            "id": "760000606",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Well, we all know the Fatui are pretty evil! But Paimon wants to know the details!"
          }
        }
      }
    },
    {
      "subId": "7600007",
      "subQuestName": "Look for clues in the area",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760000701"
        ],
        "dialogs": {

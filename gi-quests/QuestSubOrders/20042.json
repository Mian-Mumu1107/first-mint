            "speakerId": -1,
            "speakerName": "Player",
            "text": "Okay.",
            "nextDialogs": [
              "200420202"
            ]
          },
          "200420202": {
            "id": "200420202",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "May the Anemo Archon protect you."
          }
        }
      }
    },
    {
      "subId": "2004202",
      "subQuestName": "Find Albert near the Cathedral",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200421101"
        ],
        "dialogs": {
          "200421101": {
            "id": "200421101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright then...",
            "nextDialogs": [
              "200421102"
            ]
          },
          "200421102": {
            "id": "200421102",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Thanks so much! Off you go then."
          }
        }
      }
    },
    {
      "subId": "2004203",
      "subQuestName": "Sweep up the pile of leaves",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420301"
        ],
        "dialogs": {
          "200420301": {
            "id": "200420301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Shall I contact the Knights of Favonius?",
            "nextDialogs": [
              "200420302"
            ]
          },
          "200420302": {
            "id": "200420302",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "I thought about doing that...",
            "nextDialogs": [
              "200420303"
            ]
          },
          "200420303": {
            "id": "200420303",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "But I have no concrete evidence on him. There's nothing they would be able to do.",
            "nextDialogs": [
              "200420304"
            ]
          },
          "200420304": {
            "id": "200420304",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "For the greater glory of the Anemo Archon... Please, just get rid of this guy."
          }
        }
      }
    },
    {
      "subId": "2004204",
      "subQuestName": "Talk to Albert",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420601"
        ],
        "dialogs": {
          "200420601": {
            "id": "200420601",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Have you finished sweeping yet?",
            "nextDialogs": [
              "200420602"
            ]
          },
          "200420602": {
            "id": "200420602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yep. All gone.",
            "nextDialogs": [
              "200420603"
            ]
          },
          "200420603": {
            "id": "200420603",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Thank you. The Cathedral looks much better now! I'm sure Barbara will feel better for it...",
            "nextDialogs": [
              "200420604"
            ]
          },
          "200420604": {
            "id": "200420604",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "But, please don't tell Barbara about this.",
            "nextDialogs": [
              "200420605"
            ]
          },
          "200420605": {
            "id": "200420605",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "The point here is to reduce her burden; telling her about it would only add to it.",
            "nextDialogs": [
              "200420606"
            ]
          },
          "200420606": {
            "id": "200420606",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "As we agreed, I'll be on my way now. See? Nothing to worry about.",
            "nextDialogs": [
              "200420607"
            ]
          },
          "200420607": {
            "id": "200420607",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "See you again soon... Maybe? Who knows."
          }
        }
      }
    },
    {
      "subId": "2004205",
      "subQuestName": "Report to Victoria in the Cathedral",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420701"
        ],
        "dialogs": {
          "200420701": {
            "id": "200420701",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "I have an update about Albert.",
            "nextDialogs": [
              "200420702"
            ]
          },
          "200420702": {
            "id": "200420702",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "Has he left?",
            "nextDialogs": [
              "200420703"
            ]
          },
          "200420703": {
            "id": "200420703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, he's gone.",
            "nextDialogs": [
              "200420704"
            ]
          },
          "200420704": {
            "id": "200420704",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "Well, that's that sorted... But, what on earth were you doing sweeping leaves just now?",
            "nextDialogs": [
              "200420705"
            ]
          },
          "200420705": {
            "id": "200420705",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "Never mind, I suppose no more leaves means one less excuse Albert can use to get near the Cathedral in future.",
            "nextDialogs": [
              "200420706"
            ]
          },
          "200420706": {
            "id": "200420706",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "These gifts are my way of saying thank-you. Take them, and may the Anemo Archon protect you.",
            "nextDialogs": [
              "200420707"
            ]
          },
          "200420707": {
            "id": "200420707",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "If there's nothing else, I should get back to work. You should get back to yours, too."
          }
        }
      }
    },
    {
      "subId": "2004201",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420101"
        ],
        "dialogs": {
          "200420101": {
            "id": "200420101",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "Where are you hiding, you pesky little...",
            "nextDialogs": [
              "200420102"
            ]
          },
          "200420102": {
            "id": "200420102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you looking for?",
            "nextDialogs": [
              "200420103"
            ]
          },
          "200420103": {
            "id": "200420103",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "Me? Oh— I'm looking for a very dodgy person.",
            "nextDialogs": [
              "200420104"
            ]
          },
          "200420104": {
            "id": "200420104",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "His name is Albert and he always lurks around the Cathedral during the day.",
            "nextDialogs": [
              "200420105"
            ]
          },
          "200420105": {
            "id": "200420105",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "He looks like he's up to no good. I'm worried he's plotting something bad...",
            "nextDialogs": [
              "200420106"
            ]
          },
          "200420106": {
            "id": "200420106",
            "speakerId": 1000,
            "speakerName": "Victoria",
            "text": "Can you chase him off for me?"
          }
        }
      }
    },
    {
      "subId": "2004204",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420401"
        ],
        "dialogs": {
          "200420401": {
            "id": "200420401",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Go, Barbara, go!",
            "nextDialogs": [
              "200420402"
            ]
          },
          "200420402": {
            "id": "200420402",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Hi, what's the matter?"
          }
        }
      }
    },
    {
      "subId": "2004205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420501"
        ],
        "dialogs": {
          "200420501": {
            "id": "200420501",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Keeping the Cathedral free of dead leaves is a service to Mondstadt and to Barbara!"
          }
        }
      }
    },
    {
      "subId": "2004208",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420801"
        ],
        "dialogs": {
          "200420801": {
            "id": "200420801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sister requests that you leave this place immediately.",
            "nextDialogs": [
              "200420802"
            ]
          },
          "200420802": {
            "id": "200420802",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Leave? What did I do wrong?"
          }
        }
      }
    },
    {
      "subId": "2004209",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200420901"
        ],
        "dialogs": {
          "200420901": {
            "id": "200420901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Oh, I've already told the Knights of Favonius all about you and your antics!",
            "nextDialogs": [
              "200420902"
            ]
          },
          "200420902": {
            "id": "200420902",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "What!? What am I supposed to have done? Tell me!"
          }
        }
      }
    },
    {
      "subId": "2004210",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200421001"
        ],
        "dialogs": {
          "200421001": {
            "id": "200421001",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Me? Me, sneaking around, acting suspiciously, and plotting evil deeds? You guys have got this all wrong!",
            "nextDialogs": [
              "200421002"
            ]
          },
          "200421002": {
            "id": "200421002",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "*sigh* ...Do you know Barbara? She's Mondstadt's angel.",
            "nextDialogs": [
              "200421003"
            ]
          },
          "200421003": {
            "id": "200421003",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Many people in Mondstadt admire her, including me.",
            "nextDialogs": [
              "200421004"
            ]
          },
          "200421004": {
            "id": "200421004",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "In fact, I am head of the Barbara fan club.",
            "nextDialogs": [
              "200421005"
            ]
          },
          "200421005": {
            "id": "200421005",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Knights of Favonius will be here shortly.",
            "nextDialogs": [
              "200421006"
            ]
          },
          "200421006": {
            "id": "200421006",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "L—Let me finish! I really look up to Barbara. I want to be like her — I want to do something for Mondstadt.",
            "nextDialogs": [
              "200421007"
            ]
          },
          "200421007": {
            "id": "200421007",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "But I'm just an ordinary person with ordinary abilities. The best I can do is to do some sweeping around the Cathedral.",
            "nextDialogs": [
              "200421008"
            ]
          },
          "200421008": {
            "id": "200421008",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "But Miss Victoria never listens to me, she just says she wants me gone.",
            "nextDialogs": [
              "200421009"
            ]
          },
          "200421009": {
            "id": "200421009",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Recently I noticed that no one has swept away the leaves around the Cathedral for a while. But if I tried to explain to Miss Victoria, she wouldn't understand...",
            "nextDialogs": [
              "200421010"
            ]
          },
          "200421010": {
            "id": "200421010",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Can you help me sweep away the leaves? For Mondstadt... And for Barbara?"
          }
        }
      }
    },
    {
      "subId": "2004212",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200421201"
        ],
        "dialogs": {
          "200421201": {
            "id": "200421201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Fine, if it gets you out of here...",
            "nextDialogs": [
              "200421202"
            ]
          },
          "200421202": {
            "id": "200421202",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Hey! I thought I just explained how I'm not a bad guy!",
            "nextDialogs": [
              "200421203"
            ]
          },
          "200421203": {
            "id": "200421203",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Well, okay. Sweep away the leaves for me, and I'll be gone."
          }
        }
      }
    },
    {
      "subId": "2004213",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200421301"
        ],
        "dialogs": {
          "200421301": {
            "id": "200421301",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The Knights of Favonius will be the only ones doing any sweeping up around here...",
            "nextDialogs": [
              "200421302"
            ]
          },
          "200421302": {
            "id": "200421302",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "I'm trying to do a good deed here! You don't need to report every little thing to the Knights of Favonius!",
            "nextDialogs": [
              "200421303"
            ]
          },
          "200421303": {
            "id": "200421303",
            "speakerId": 1001,
            "speakerName": "Albert",
            "text": "Alright, alright, you win. I'll be out of here as soon as the leaves are gone."
          }
        }
      }
    }
  ]
}
            ]
          },
          "771860502": {
            "id": "771860502",
            "speakerId": 7548,
            "speakerName": "Pelageya",
            "text": "...You can come play however many times you like. I don't have many customers since I don't really tout or do the street cry thing anyway, so I'm pretty free most of the time..."
          }
        }
      }
    },

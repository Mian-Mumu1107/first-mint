          "771861401": {
            "id": "771861401",
            "speakerId": 7548,
            "speakerName": "Pelageya",
            "text": "Unbelievable! You got it right three times! Here's your super special prize — and a little something extra: a set of custom nesting dolls I had made. Hope you like them!",
            "nextDialogs": [
              "771861402"
            ]
          },
          "771861402": {
            "id": "771861402",
            "speakerId": 7548,
            "speakerName": "Pelageya",
            "text": "But... There won't be any prizes after a while after this... I'm sorry.",
            "nextDialogs": [
              "771861403"
            ]
          },
          "771861403": {
            "id": "771861403",
            "speakerId": 7548,
            "speakerName": "Pelageya",
            "text": "But I've already given away so many prizes! They've cost me... hundreds of thousands of Mora so far, I reckon...",
            "nextDialogs": [
              "771861404"
            ]
          },

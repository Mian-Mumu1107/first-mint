        ],
        "dialogs": {
          "771860101": {
            "id": "771860101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I want to give it a try.",
            "nextDialogs": [
              "771860102"
            ]
          },
          "771860102": {
            "id": "771860102",
            "speakerId": 7548,
            "speakerName": "Pelageya",
            "text": "Oh, okay. This set of nesting dolls is made up of either <color=#00E1FFFF>8, 9, or 10</color> dolls. You get a prize if you guess the number right.",
            "nextDialogs": [
              "771860103"
            ]
          },
          "771860103": {
            "id": "771860103",
            "speakerId": 7548,
            "speakerName": "Pelageya",
            "text": "And if you guess right three times, you'll also get my super special prize!"
          }
        }
      }
    },

        "dialogs": {
          "719210101": {
            "id": "719210101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's not great, surely...",
            "nextDialogs": [
              "719210102"
            ]
          },
          "719210102": {
            "id": "719210102",
            "speakerId": 20307,
            "speakerName": "Atsuko",
            "text": "What's wrong with it? You mean, breaking Inazuman regulations?",
            "nextDialogs": [
              "719210103"
            ]
          },
          "719210103": {
            "id": "719210103",
            "speakerId": 20307,
            "speakerName": "Atsuko",
            "text": "I think it depends on the person. Some people are quite content to spend their whole lives within the fences of their farm...",
            "nextDialogs": [
              "719210104"
            ]
          },
          "719210104": {
            "id": "719210104",
            "speakerId": 20307,
            "speakerName": "Atsuko",
            "text": "But not me! If there's anything that can fence me in, it's somewhere beyond these lands, beyond the seas, beyond the stars!",
            "nextDialogs": [
              "719210105"
            ]
          },
          "719210105": {
            "id": "719210105",
            "speakerId": 20307,
            "speakerName": "Atsuko",
            "text": "If you can't understand the value of freedom, let me be the one to explain it to you!"
          }
        }
      }
    }
  ]

  "subQuests": [
    {
      "subId": "2050601",
      "subQuestName": "Talk to Timaeus about alchemy",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205060101"
        ],
        "dialogs": {
          "205060101": {
            "id": "205060101",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "Greetings! I am Timaeus, researcher of alchemy. Welcome to Mondstadt!",
            "nextDialogs": [
              "205060102"
            ]
          },
          "205060102": {
            "id": "205060102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alchemy?",
            "nextDialogs": [
              "205060103"
            ]
          },
          "205060103": {
            "id": "205060103",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "Alchemy is a craft that has been passed down since ancient times, but it is barely understood in the present.",
            "nextDialogs": [
              "205060104"
            ]
          },
          "205060104": {
            "id": "205060104",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "Its mechanisms are magical and mysterious, completely unlike the principles that shape our understanding of the physical world.",
            "nextDialogs": [
              "205060105"
            ]
          },
          "205060105": {
            "id": "205060105",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "If we can get the hang of this, we should be able to create some pretty awesome stuff!",
            "nextDialogs": [
              "205060106"
            ]
          },
          "205060106": {
            "id": "205060106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This must be your alchemist's work bench?",
            "nextDialogs": [
              "205060107"
            ]
          },
          "205060107": {
            "id": "205060107",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "That's right. Why not give it a go yourself?",
            "nextDialogs": [
              "205060110"
            ]
          },
          "205060110": {
            "id": "205060110",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "You'll be fine, the procedure is actually very simple. If you're interested, I can show you the basics?",
            "nextDialogs": [
              "205060111"
            ]
          },
          "205060111": {
            "id": "205060111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Craft"
          }
        }
      }
    },
    {
      "subId": "2050602",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "205060201"
        ],
        "dialogs": {
          "205060201": {
            "id": "205060201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Coooool!",
            "nextDialogs": [
              "205060202"
            ]
          },
          "205060202": {
            "id": "205060202",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "All we are really doing is following the methods of the ancients as best we can.",
            "nextDialogs": [
              "205060203"
            ]
          },
          "205060203": {
            "id": "205060203",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "Much as one who uses a wind glider needs not understand how it was built in order to glide.",
            "nextDialogs": [
              "205060204"
            ]
          },
          "205060204": {
            "id": "205060204",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "The difference with alchemy is that every time I think I finally understand how it's supposed to work, something totally unexpected happens...",
            "nextDialogs": [
              "205060206",
              "205060208"
            ]
          },
          "205060206": {
            "id": "205060206",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "To be honest with you, I just don't know.",
            "nextDialogs": [
              "205060210"
            ]
          },
          "205060210": {
            "id": "205060210",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "There's a lot of other mysterious recipes I have to research first.",
            "nextDialogs": [
              "205060211"
            ]
          },
          "205060211": {
            "id": "205060211",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "Over the course of your adventures, you should come across some alchemists' notes from ancient civilizations.",
            "nextDialogs": [
              "205060212"
            ]
          },
          "205060212": {
            "id": "205060212",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "And as your Adventure Rank increases, more recipes will become available to you."
          },
          "205060208": {
            "id": "205060208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! You shall have no other Paimon before this Paimon!",
            "nextDialogs": [
              "205060209"
            ]
          },
          "205060209": {
            "id": "205060209",
            "speakerId": 1000,
            "speakerName": "Timaeus",
            "text": "Hahaha! Unfortunately my skills are not that advanced."
          }
        }
      }
    }
  ]
}
        "dialogs": {
          "721450101": {
            "id": "721450101",
            "speakerId": 20311,
            "speakerName": "Ancient Stone Tablet",
            "text": "\"...They say that Omikami's envoy had three eyes: one for the 'soul,' one a 'mirror,' and the last the 'truth'...\"",
            "nextDialogs": [
              "721450102"
            ]
          },
          "721450102": {
            "id": "721450102",
            "speakerId": 20311,
            "speakerName": "Ancient Stone Tablet",
            "text": "\"...From the depths it arose, from the <color=#00E1FFFF>south</color>, o'er the <color=#00E1FFFF>north</color>, and all about the <color=#00E1FFFF>western</color> mound...\"",
            "nextDialogs": [
              "721450103"
            ]
          },
          "721450103": {
            "id": "721450103",
            "speakerId": 20311,
            "speakerName": "Ancient Stone Tablet",
            "text": "\"...The three eyes shone mercilessly to ward off the dragon's heir...\"",
            "nextDialogs": [
              "721450104"
            ]
          },
          "721450104": {
            "id": "721450104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon... knows all these words... but none of them mean anything when strung together.",
            "nextDialogs": [
              "721450105"
            ]
          },
          "721450105": {
            "id": "721450105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It doesn't look like there are any clues around here either, so why don't we try using <color=#00E1FFFF>Elemental Sight</color>?"
          }
        }
      }
    },

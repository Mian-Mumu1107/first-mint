        ],
        "dialogs": {
          "760690101": {
            "id": "760690101",
            "speakerId": 1000,
            "speakerName": "Roland",
            "text": "...Do not disturb... their peaceful slumber...",
            "nextDialogs": [
              "760690102"
            ]
          },
          "760690102": {
            "id": "760690102",
            "speakerId": 1001,
            "speakerName": "Varka",
            "text": "Is this the power of the Wolf of the North? Strange, though — I'm also getting more than just a hint of the Falcon of the West...",
            "nextDialogs": [
              "760690103"
            ]
          },
          "760690103": {
            "id": "760690103",
            "speakerId": 1001,
            "speakerName": "Varka",
            "text": "Hmm... Whatever it is, I'll get to the bottom of this!"
          }
        }
      }

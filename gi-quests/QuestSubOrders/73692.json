  "subQuests": [
    {
      "subId": "7369201",
      "subQuestName": "Talk to Paz",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736920101"
        ],
        "dialogs": {
          "736920101": {
            "id": "736920101",
            "speakerId": 30350,
            "speakerName": "Paz",
            "text": "Ah, hello there, Traveler. It would seem that you're here to take part in the Wisdom Gala.",
            "nextDialogs": [
              "736920102"
            ]
          },
          "736920102": {
            "id": "736920102",
            "speakerId": 30350,
            "speakerName": "Paz",
            "text": "If it would interest you, would you like to try out the game that we at Amurta have set up?",
            "nextDialogs": [
              "736920103"
            ]
          },
          "736920103": {
            "id": "736920103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And what sort of game would that be?",
            "nextDialogs": [
              "736920104"
            ]
          },
          "736920104": {
            "id": "736920104",
            "speakerId": 30350,
            "speakerName": "Paz",
            "text": "Our Darshan has set up a little game called \"Mimetic Replication.\"",
            "nextDialogs": [
              "736920105"
            ]
          },
          "736920105": {
            "id": "736920105",
            "speakerId": 30350,
            "speakerName": "Paz",
            "text": "In this game, I will introduce you to the behavioral patterns of certain animals.",
            "nextDialogs": [
              "736920106"
            ]
          },
          "736920106": {
            "id": "736920106",
            "speakerId": 30350,
            "speakerName": "Paz",
            "text": "Of course, these patterns have been simplified and generalized to make them easier to understand.",
            "nextDialogs": [
              "736920107"
            ]
          },
          "736920107": {
            "id": "736920107",
            "speakerId": 30350,
            "speakerName": "Paz",
            "text": "What you'll need to do is to use the models we have prepared to imitate the actions of the corresponding animals.",
            "nextDialogs": [
              "736920110"
            ]
          },
          "736920110": {
            "id": "736920110",
            "speakerId": 30350,
            "speakerName": "Paz",
            "text": "Precisely. \"Animals have regular behavioral patterns\" is a statement that is both simple to understand and accept.",
            "nextDialogs": [
              "736920111"
            ]
          },
          "736920111": {
            "id": "736920111",
            "speakerId": 30350,
            "speakerName": "Paz",
            "text": "But behind something so simple lie mysteries that are most deep indeed.",
            "nextDialogs": [
              "736920112"
            ]
          },
          "736920112": {
            "id": "736920112",
            "speakerId": 30350,
            "speakerName": "Paz",
            "text": "However, let us put academic observation aside for the moment and simply enjoy the habitual behaviors of animals in a relaxed manner."
          }
        }
      }
    },
    {
      "subId": "7369299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "736929901"
        ],
        "dialogs": {
          "736929901": {
            "id": "736929901",
            "speakerId": 30350,
            "speakerName": "Paz",
            "text": "(If we had more funding, we'd be able to do a better job...)"
          }
        }
      }
    }
  ]
}
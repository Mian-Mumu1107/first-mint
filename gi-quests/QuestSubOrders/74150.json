    {
      "subId": "7415001",
      "subQuestName": "Talk to Benoit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741500101"
        ],
        "dialogs": {
          "741500101": {
            "id": "741500101",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Thank you, Molli. Your kindness sparkles in your lovely lavender eyes.",
            "nextDialogs": [
              "741500102"
            ]
          },
          "741500102": {
            "id": "741500102",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Hehe, does it really? Did you really like that doll that I brought you last time?",
            "nextDialogs": [
              "741500103"
            ]
          },
          "741500103": {
            "id": "741500103",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Oh yes, yes indeed. It was very lovely. You know, I even set aside a place for it at the dining table.",
            "nextDialogs": [
              "741500104"
            ]
          },
          "741500104": {
            "id": "741500104",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Really? Oh, that would make it so happy! What about today? Do you need to lean on me during your walk? Or should I fetch your newspaper?",
            "nextDialogs": [
              "741500105"
            ]
          },
          "741500105": {
            "id": "741500105",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "I could read it to you, too, if you can't make out the words.",
            "nextDialogs": [
              "741500106"
            ]
          },
          "741500106": {
            "id": "741500106",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Mama says that I should do one good deed every day, and my tutor wants me to submit an essay this week about good people and good things.",
            "nextDialogs": [
              "741500107"
            ]
          },
          "741500107": {
            "id": "741500107",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Oh, um... I don't mean I'm doing this because I need to write an essay, but if you don't mind, I do want to help you out.",
            "nextDialogs": [
              "741500108"
            ]
          },
          "741500108": {
            "id": "741500108",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Haha. Oh, I'm already fine, really. The best thing you could do to help me is to tell your parents that you often come by my place to play.",
            "nextDialogs": [
              "741500109"
            ]
          },
          "741500109": {
            "id": "741500109",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "I know, Mr. Leroy, and I've told them, but they don't seem too happy about it...",
            "nextDialogs": [
              "741500110"
            ]
          },
          "741500110": {
            "id": "741500110",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Will you still come again, even so?",
            "nextDialogs": [
              "741500111"
            ]
          },
          "741500111": {
            "id": "741500111",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "I sure will — even if they won't let me. I mean, we made an agreement, didn't we?",
            "nextDialogs": [
              "741500112"
            ]
          },
          "741500112": {
            "id": "741500112",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Haha, you are indeed a child of your word. Good, good. I do like you very much.",
            "nextDialogs": [
              "741500113"
            ]
          },
          "741500113": {
            "id": "741500113",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Ah, it's you two. Welcome, kind souls, welcome.",
            "nextDialogs": [
              "741500114"
            ]
          },
          "741500114": {
            "id": "741500114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*cough* Uh, we didn't mean to intrude or anything...",
            "nextDialogs": [
              "741500115"
            ]
          },
          "741500115": {
            "id": "741500115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Did we interrupt?",
            "nextDialogs": [
              "741500116"
            ]
          },
          "741500116": {
            "id": "741500116",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "No, no, the two of you aren't interrupting anything.",
            "nextDialogs": [
              "741500117"
            ]
          },
          "741500117": {
            "id": "741500117",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "My young friend Molli here is currently out and about, trying to complete her homework. She just happened to stop by my home.",
            "nextDialogs": [
              "741500118"
            ]
          },
          "741500118": {
            "id": "741500118",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "She'd like to do something nice for me, so that she might have some material for her essay.",
            "nextDialogs": [
              "741500119"
            ]
          },
          "741500119": {
            "id": "741500119",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Hey, I'm not helping because I want to finish my homework! Well, not just because of that, anyway...",
            "nextDialogs": [
              "741500120"
            ]
          },
          "741500120": {
            "id": "741500120",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Of course, of course. You're not being a good child just because of your homework, after all.",
            "nextDialogs": [
              "741500121"
            ]
          },
          "741500121": {
            "id": "741500121",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Much like these two young guests! They're not here to help me just because they need a job, either!",
            "nextDialogs": [
              "741500122"
            ]
          },
          "741500122": {
            "id": "741500122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "741500123"
            ]
          },
          "741500123": {
            "id": "741500123",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, well... We...",
            "nextDialogs": [
              "741500124"
            ]
          },
          "741500124": {
            "id": "741500124",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Well now, it was just a little jest. Surely you won't begrudge an old man that much?",
            "nextDialogs": [
              "741500125"
            ]
          },
          "741500125": {
            "id": "741500125",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Youngsters have much time that they may spend freely, and you're willing to while that time away with me, and I do enjoy the company of young people... Nothing wrong with any of that, now is there?",
            "nextDialogs": [
              "741500126"
            ]
          },
          "741500126": {
            "id": "741500126",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Then perhaps I should just give you something to do. People are wont to come and go around the entrance, it tends to get dirty there very quickly, and nobody's swept behind the place for days. So, if I may ask, please help me clean it up again.",
            "nextDialogs": [
              "741500127"
            ]
          },
          "741500127": {
            "id": "741500127",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well... okay, then.",
            "nextDialogs": [
              "741500128"
            ]
          },
          "741500128": {
            "id": "741500128",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Molli, would you keep my cat company? Ah, and bring a fish steak if you would — her name's Nana, by the way.",
            "nextDialogs": [
              "741500129"
            ]
          },
          "741500129": {
            "id": "741500129",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "She inherited that name from a dog I had previously... It's a shame, but my daughter took her along when she went off to get married.",
            "nextDialogs": [
              "741500130"
            ]
          },
          "741500130": {
            "id": "741500130",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Alright then, Mr. Leroy.",
            "nextDialogs": [
              "741500131"
            ]
          },
          "741500131": {
            "id": "741500131",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Very well, children, off you go."
          }
        }
      }
    },
    {
      "subId": "7415006",
      "subQuestName": "Clean around the house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741500601"
        ],
        "dialogs": {
          "741500601": {
            "id": "741500601",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "My children aren't home, which makes cleaning the filth that gathers by the door and the back of the house quite tricky. I'm counting on you."
          }
        }
      }
    },
    {
      "subId": "7415007",
      "subQuestName": "Clean around the house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741500701"
        ],
        "dialogs": {
          "741500701": {
            "id": "741500701",
            "speakerId": 21255,
            "speakerName": "Strange Boxes",
            "text": "(Old, decrepit heavy boxes covered in layers of dust. Their presence here in the usually bright and clear Court of Fontaine is quite jarring.)",
            "nextDialogs": [
              "741500702"
            ]
          },
          "741500702": {
            "id": "741500702",
            "speakerId": 21255,
            "speakerName": "Strange Boxes",
            "text": "(The bases of these boxes have collected a lot of clear water stains over the years. They must have once been piled in an exceedingly damp location.)",
            "nextDialogs": [
              "741500703"
            ]
          },
          "741500703": {
            "id": "741500703",
            "speakerId": 21255,
            "speakerName": "Strange Boxes",
            "text": "(Never mind the stains on the door — these boxes look to be in far more urgent need of a cleanup.)"
          }
        }
      }
    },
    {
      "subId": "7415002",
      "subQuestName": "Clean around the house",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7415008",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741500801"
        ],
        "dialogs": {
          "741500801": {
            "id": "741500801",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Oh, there's no point knocking at this hour. Morticia and Athos aren't in.",
            "nextDialogs": [
              "741500802"
            ]
          },
          "741500802": {
            "id": "741500802",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "They said they'd be back today, but it seems that they've been delayed for some reason.",
            "nextDialogs": [
              "741500803"
            ]
          },
          "741500803": {
            "id": "741500803",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Ah, that's the trouble with adult children. They always have their own things to attend to, and they're often not around when you need them."
          }
        }
      }
    },
    {
      "subId": "7415003",
      "subQuestName": "Report back to Benoit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741500301"
        ],
        "dialogs": {
          "741500301": {
            "id": "741500301",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Are you all done?",
            "nextDialogs": [
              "741500302"
            ]
          },
          "741500302": {
            "id": "741500302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That's right.",
            "nextDialogs": [
              "741500303"
            ]
          },
          "741500303": {
            "id": "741500303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yup, the cleanup's done, and Molli's fed the cat, too.",
            "nextDialogs": [
              "741500304"
            ]
          },
          "741500304": {
            "id": "741500304",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Also, Benoit, there's a pile of super dirty old boxes next to your place. Do you want us to clean those up, too?",
            "nextDialogs": [
              "741500305"
            ]
          },
          "741500305": {
            "id": "741500305",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Oh, those boxes? I just store some old stuff in them... Otherwise, they don't see much use.",
            "nextDialogs": [
              "741500306"
            ]
          },
          "741500306": {
            "id": "741500306",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Some of them contain furniture and other small items from my old place, which I haven't had the heart to throw away... But at the same time, they don't fit with my current home, and so, they've ended up just stacked out there.",
            "nextDialogs": [
              "741500307"
            ]
          },
          "741500307": {
            "id": "741500307",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "I don't touch them for the most part, but since everyone around here's a decent sort, no one's stolen anything — so they can stay right where they are.",
            "nextDialogs": [
              "741500308"
            ]
          },
          "741500308": {
            "id": "741500308",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Mr. Leroy, Mr. Leroy, was I helpful?",
            "nextDialogs": [
              "741500309"
            ]
          },
          "741500309": {
            "id": "741500309",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Why, of course you were, Molli. Don't forget to say hello to your parents for me. I'd be even more grateful if you could do that.",
            "nextDialogs": [
              "741500310"
            ]
          },
          "741500310": {
            "id": "741500310",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "And I've got the snacks and pocket money right here, children, so come and get it.",
            "nextDialogs": [
              "741500311"
            ]
          },
          "741500311": {
            "id": "741500311",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Oh, no, no, I don't need any pocket money. I'd just like to pet Nana some more. Can I?",
            "nextDialogs": [
              "741500312"
            ]
          },
          "741500312": {
            "id": "741500312",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Oh, of course, please do, but watch out for her claws, and remember to come back for snacks once you're done playing.",
            "nextDialogs": [
              "741500313"
            ]
          },
          "741500313": {
            "id": "741500313",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "Why did you go out, Dad?",
            "nextDialogs": [
              "741500314"
            ]
          },
          "741500314": {
            "id": "741500314",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Well, this old fellow got lonely, what with his children not being around to keep him company and all — so he decided to go get some fresh air.",
            "nextDialogs": [
              "741500315"
            ]
          },
          "741500315": {
            "id": "741500315",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "Ah, Morticia, would you look at that — gone but a few days, and he's mad at us already.",
            "nextDialogs": [
              "741500316"
            ]
          },
          "741500316": {
            "id": "741500316",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "But I'm sure he'd forgive us if he only knew what gift we'd brought back this time, don't you think?",
            "nextDialogs": [
              "741500317"
            ]
          },
          "741500317": {
            "id": "741500317",
            "speakerId": 21251,
            "speakerName": "Morticia",
            "text": "...",
            "nextDialogs": [
              "741500318"
            ]
          },
          "741500318": {
            "id": "741500318",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Gift? What did you bring back?",
            "nextDialogs": [
              "741500319"
            ]
          },
          "741500319": {
            "id": "741500319",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "Something wonderful, of course. You'll know when you see it. Morticia knows how you like lovely, expensive things. She picked it out especially for you.",
            "nextDialogs": [
              "741500320"
            ]
          },
          "741500320": {
            "id": "741500320",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Thank you, my daughter.",
            "nextDialogs": [
              "741500321"
            ]
          },
          "741500321": {
            "id": "741500321",
            "speakerId": 21251,
            "speakerName": "Morticia",
            "text": "I did only what I should have.",
            "nextDialogs": [
              "741500322"
            ]
          },
          "741500322": {
            "id": "741500322",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Ah, yes. These two lovely guests are also children who came by to play while the two of you were out.",
            "nextDialogs": [
              "741500323"
            ]
          },
          "741500323": {
            "id": "741500323",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "Hello there. My father's a friendly man and really loves kids, so thank you for keeping him company, truly.",
            "nextDialogs": [
              "741500324"
            ]
          },
          "741500324": {
            "id": "741500324",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "Still, since my wife and I are back, we'll take it from here.",
            "nextDialogs": [
              "741500325"
            ]
          },
          "741500325": {
            "id": "741500325",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Ah, it really is good that you're back. Come now, let me have a look at that present.",
            "nextDialogs": [
              "741500326"
            ]
          },
          "741500326": {
            "id": "741500326",
            "speakerId": 21251,
            "speakerName": "Morticia",
            "text": "Alright, Dad. Let's go inside, shall we?",
            "nextDialogs": [
              "741500327"
            ]
          },
          "741500327": {
            "id": "741500327",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Indeed, indeed. Athos, do remember to give them their pay and some snacks. They helped me sweep the place, and fed Nana, too.",
            "nextDialogs": [
              "741500328"
            ]
          },
          "741500328": {
            "id": "741500328",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Ah, and give that young lady some of those treats, too, would you? I'm going back inside now.",
            "nextDialogs": [
              "741500329"
            ]
          },
          "741500329": {
            "id": "741500329",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Mr. Leroy, Nana let me give her a belly rub... Eh? Where's he gone?",
            "nextDialogs": [
              "741500330"
            ]
          },
          "741500330": {
            "id": "741500330",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "Are you looking for my father, little lady? I'm his son-in-law... Well, you might as well just consider me his son to keep things simple. Call me Athos.",
            "nextDialogs": [
              "741500331"
            ]
          },
          "741500331": {
            "id": "741500331",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Oh, I know what a son-in-law is. That means you're his daughter's husband.",
            "nextDialogs": [
              "741500332"
            ]
          },
          "741500332": {
            "id": "741500332",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "Haha, you sure are knowledgeable, aren't you? Thanks for keeping my father company — he's gone indoors.",
            "nextDialogs": [
              "741500333"
            ]
          },
          "741500333": {
            "id": "741500333",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "These snacks are for you. You can leave the rest to my wife and I — it's alright if you don't drop by anymore.",
            "nextDialogs": [
              "741500334"
            ]
          },
          "741500334": {
            "id": "741500334",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "Anyway, you should head home soon. Your family will be worried about you if you're out too long.",
            "nextDialogs": [
              "741500335"
            ]
          },
          "741500335": {
            "id": "741500335",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Oh, don't worry, Mister. It was no trouble at all, and anyway, Mr. Leroy and I have an agreement.",
            "nextDialogs": [
              "741500336"
            ]
          },
          "741500336": {
            "id": "741500336",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "I think he might need my help going forward, too — you know, with feeding the cat, watering plants, and other stuff. Helping people makes me happy, too, so I'll definitely come back!",
            "nextDialogs": [
              "741500337"
            ]
          },
          "741500337": {
            "id": "741500337",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "...",
            "nextDialogs": [
              "741500338"
            ]
          },
          "741500338": {
            "id": "741500338",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "Tch. And that's what makes things tricky.",
            "nextDialogs": [
              "741500339"
            ]
          },
          "741500339": {
            "id": "741500339",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Um, is something wrong, Mister?",
            "nextDialogs": [
              "741500340"
            ]
          },
          "741500340": {
            "id": "741500340",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "No, little lady, not at all. I have something important to discuss with you... Hmm, no. Discussion isn't the right word. There's something I need you to do.",
            "nextDialogs": [
              "741500341"
            ]
          },
          "741500341": {
            "id": "741500341",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Sure. What is it?",
            "nextDialogs": [
              "741500342"
            ]
          },
          "741500342": {
            "id": "741500342",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "I'm going to give you the snacks and pocket money, and then after that, don't come back again, alright?",
            "nextDialogs": [
              "741500343"
            ]
          },
          "741500343": {
            "id": "741500343",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Huh? Why? Did I do something wrong?",
            "nextDialogs": [
              "741500344"
            ]
          },
          "741500344": {
            "id": "741500344",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "No, of course you haven't! It's just that my father's health has always been poor, and his insomnia has gotten quite bad lately.",
            "nextDialogs": [
              "741500345"
            ]
          },
          "741500345": {
            "id": "741500345",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "Out of consideration for his health, my wife and I would like him to have an environment conducive to rest. You understand, don't you?",
            "nextDialogs": [
              "741500346"
            ]
          },
          "741500346": {
            "id": "741500346",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Oh, so Mr. Leroy's unwell... I get it. Next time, I'll bring extra Bulle Fruit.",
            "nextDialogs": [
              "741500347"
            ]
          },
          "741500347": {
            "id": "741500347",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Every time I eat too much cake and get a tummy ache, Papa tells me I should eat less sweets and have more fruit.",
            "nextDialogs": [
              "741500348"
            ]
          },
          "741500348": {
            "id": "741500348",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "As long as Mr. Leroy eats some fruit every day, he'll be fine.",
            "nextDialogs": [
              "741500349"
            ]
          },
          "741500349": {
            "id": "741500349",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "...*sigh* Nevermind. Nothing else for it.",
            "nextDialogs": [
              "741500350"
            ]
          },
          "741500350": {
            "id": "741500350",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "As for you two, here are your snacks and rewards.",
            "nextDialogs": [
              "741500351"
            ]
          },
          "741500351": {
            "id": "741500351",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "And now, let me speak plainly.",
            "nextDialogs": [
              "741500352"
            ]
          },
          "741500352": {
            "id": "741500352",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "I am speaking for the entire Leroy family on this matter: I hope that you will not come and disturb us again in the future.",
            "nextDialogs": [
              "741500353"
            ]
          },
          "741500353": {
            "id": "741500353",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "I believe that despite your youth, you will be able to understand my meaning. So please, do not go out of your way to return here.",
            "nextDialogs": [
              "741500354"
            ]
          },
          "741500354": {
            "id": "741500354",
            "speakerId": 1457,
            "speakerName": "Athos",
            "text": "That's all. I'll take my leave now.",
            "nextDialogs": [
              "741500355"
            ]
          },
          "741500355": {
            "id": "741500355",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Huh. Why can't we come back? It's so weird! Mr. Leroy was so nice, but this man just really doesn't want us to.",
            "nextDialogs": [
              "741500356"
            ]
          },
          "741500356": {
            "id": "741500356",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! This guy speaks politely enough, alright, but he's as cold as they come.",
            "nextDialogs": [
              "741500357"
            ]
          },
          "741500357": {
            "id": "741500357",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Well, I don't care what he says. I'm going to come see Mr. Leroy tomorrow. What about you two?",
            "nextDialogs": [
              "741500358"
            ]
          },
          "741500358": {
            "id": "741500358",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Come on, just come along. Nana's so cute, and I just wanna pet her a bit more... and also, Mr. Leroy's going to give us more snacks.",
            "nextDialogs": [
              "741500360",
              "741500362"
            ]
          },
          "741500360": {
            "id": "741500360",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Alright, no takesies-backsies, 'kay? We've gotta come pet the cat and play with Mr. Leroy."
          },
          "741500362": {
            "id": "741500362",
            "speakerId": 21252,
            "speakerName": "Molli",
            "text": "Alright. See you next time, then."
          }
        }
      }
    },
    {
      "subId": "7414906",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "741490601"
        ],
        "dialogs": {
          "741490601": {
            "id": "741490601",
            "speakerId": 21249,
            "speakerName": "Benoit Leroy",
            "text": "Newspaper delivery? Just leave it by the door, thanks. I'll come get it later.",
            "nextDialogs": [
              "741490602"
            ]
          },
          "741490602": {
            "id": "741490602",
            "speakerId": 10373,
            "speakerName": "Door",
            "text": "(You've already helped Benoit out today. It would be rude to disturb his rest. You agreed to meet him tomorrow, so it'd be best to just do that.)"
          }
        }
      }
    }
  ]
}
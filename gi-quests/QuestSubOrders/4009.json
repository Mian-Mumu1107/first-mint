  },
  "subQuests": [
    {
      "subId": "400901",
      "subQuestName": "Go to the Duke's Office",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090101"
        ],
        "dialogs": {
          "40090101": {
            "id": "40090101",
            "speakerId": 1074,
            "speakerName": "Freminet",
            "text": "I—I'm so sorry, Lyney...",
            "nextDialogs": [
              "40090102"
            ]
          },
          "40090102": {
            "id": "40090102",
            "speakerId": 1072,
            "speakerName": "Lynette",
            "text": "I'm also really sorry, Lyney. I should have been more careful.",
            "nextDialogs": [
              "40090103"
            ]
          },
          "40090103": {
            "id": "40090103",
            "speakerId": 1071,
            "speakerName": "Lyney",
            "text": "Don't say that. It was all my fault... I was the one who should have been more careful. You two were nearly...",
            "nextDialogs": [
              "40090104"
            ]
          },
          "40090104": {
            "id": "40090104",
            "speakerId": 1074,
            "speakerName": "Freminet",
            "text": "If I was stronger... Maybe I would have already found Master Childe...",
            "nextDialogs": [
              "40090105"
            ]
          },
          "40090105": {
            "id": "40090105",
            "speakerId": 1071,
            "speakerName": "Lyney",
            "text": "No, how can you say that?",
            "nextDialogs": [
              "40090106"
            ]
          },
          "40090106": {
            "id": "40090106",
            "speakerId": 1074,
            "speakerName": "Freminet",
            "text": "Hmm?",
            "nextDialogs": [
              "40090107"
            ]
          },
          "40090107": {
            "id": "40090107",
            "speakerId": 1071,
            "speakerName": "Lyney",
            "text": "...I'm sorry...",
            "nextDialogs": [
              "40090108"
            ]
          },
          "40090108": {
            "id": "40090108",
            "speakerId": 1072,
            "speakerName": "Lynette",
            "text": "What I'm hearing is, we all dropped the ball at some point during the mission, so the responsibility falls on all of us. Isn't that right?",
            "nextDialogs": [
              "40090109"
            ]
          },
          "40090109": {
            "id": "40090109",
            "speakerId": 1074,
            "speakerName": "Freminet",
            "text": "Yeah, that's right. It's on all of us.",
            "nextDialogs": [
              "40090110"
            ]
          },
          "40090110": {
            "id": "40090110",
            "speakerId": 1071,
            "speakerName": "Lyney",
            "text": "...",
            "nextDialogs": [
              "40090111"
            ]
          },
          "40090111": {
            "id": "40090111",
            "speakerId": 1072,
            "speakerName": "Lynette",
            "text": "Lyney, we understand that you're worried about us, but we're worried about you as well. Please don't blame yourself... We want you to keep your spirits up.",
            "nextDialogs": [
              "40090112"
            ]
          },
          "40090112": {
            "id": "40090112",
            "speakerId": 1071,
            "speakerName": "Lyney",
            "text": "...Yeah."
          }
        }
      }
    },
    {
      "subId": "400902",
      "subQuestName": "Talk to Wriothesley",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090201"
        ],
        "dialogs": {
          "40090201": {
            "id": "40090201",
            "speakerId": 1079,
            "speakerName": "Sigewinne",
            "text": "Excuse me~",
            "nextDialogs": [
              "40090202"
            ]
          },
          "40090202": {
            "id": "40090202",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "I take it Mr. Freminet's condition has stabilized?",
            "nextDialogs": [
              "40090203"
            ]
          },
          "40090203": {
            "id": "40090203",
            "speakerId": 1079,
            "speakerName": "Sigewinne",
            "text": "Of course. I would not have left the infirmary otherwise.",
            "nextDialogs": [
              "40090204"
            ]
          },
          "40090204": {
            "id": "40090204",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "I've been expecting those two, but might I enquire as to the purpose of your visit, Miss Sigewinne?",
            "nextDialogs": [
              "40090205"
            ]
          },
          "40090205": {
            "id": "40090205",
            "speakerId": 1079,
            "speakerName": "Sigewinne",
            "text": "I wanted to check up on Miss Clorinde. How are you feeling?",
            "nextDialogs": [
              "40090206"
            ]
          },
          "40090206": {
            "id": "40090206",
            "speakerId": 1077,
            "speakerName": "Clorinde",
            "text": "Mostly fine, I think.",
            "nextDialogs": [
              "40090207"
            ]
          },
          "40090207": {
            "id": "40090207",
            "speakerId": 1079,
            "speakerName": "Sigewinne",
            "text": "If you don't mind, I'd like to perform another quick physical exam. It'll just take a few minutes.",
            "nextDialogs": [
              "40090208"
            ]
          },
          "40090208": {
            "id": "40090208",
            "speakerId": 1077,
            "speakerName": "Clorinde",
            "text": "Alright, thank you for looking out for me. I'll take my leave for now, then.",
            "nextDialogs": [
              "40090209"
            ]
          },
          "40090209": {
            "id": "40090209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, want to explain yourself, Wriothesley?",
            "nextDialogs": [
              "40090210"
            ]
          },
          "40090210": {
            "id": "40090210",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Haha, of course, but I'm not partial to the word choice of \"explain.\" How about \"enlighten\"?",
            "nextDialogs": [
              "40090211"
            ]
          },
          "40090211": {
            "id": "40090211",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Please enlighten us as much as you'd like.",
            "nextDialogs": [
              "40090212"
            ]
          },
          "40090212": {
            "id": "40090212",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "But where should I begin? How about you start by asking me any questions you have? You can start with whichever one you'd like to get answered the most.",
            "nextDialogs": [
              "40090213"
            ]
          },
          "40090213": {
            "id": "40090213",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Then Paimon will begin. Did you know about Lyney's goals from the very beginning?",
            "nextDialogs": [
              "40090214"
            ]
          },
          "40090214": {
            "id": "40090214",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "No, I just knew they were Fatui operatives sent to the Fortress by The Knave. As for their specific goals... I only figured those out as you made progress on your investigation.",
            "nextDialogs": [
              "40090215"
            ]
          },
          "40090215": {
            "id": "40090215",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You managed to monitor and stay ahead of them even though you didn't know what they were trying to do?",
            "nextDialogs": [
              "40090216"
            ]
          },
          "40090216": {
            "id": "40090216",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "They came here with ulterior motives. I'm quite adept at discerning what that kind of behavior signals.",
            "nextDialogs": [
              "40090217"
            ]
          },
          "40090217": {
            "id": "40090217",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why didn't you stop them?",
            "nextDialogs": [
              "40090218"
            ]
          },
          "40090218": {
            "id": "40090218",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Initially, I thought their goal was just to investigate Childe's disappearance.",
            "nextDialogs": [
              "40090219"
            ]
          },
          "40090219": {
            "id": "40090219",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Lyney suggested that I had deliberately let him escape, but in truth, I didn't really do anything special to help or hinder him while he was here. Everything he did, from finding helpers to leaving this place, he did on his own.",
            "nextDialogs": [
              "40090220"
            ]
          },
          "40090220": {
            "id": "40090220",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Of course, it's inevitable that The Knave would make a big deal out of her fellow Harbinger's unexplained disappearance.",
            "nextDialogs": [
              "40090221"
            ]
          },
          "40090221": {
            "id": "40090221",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "I'm also quite curious about where that Harbinger went, so I figured I might as well let the Fatui do their own investigative work. All I care about is the answer.",
            "nextDialogs": [
              "40090222"
            ]
          },
          "40090222": {
            "id": "40090222",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So you were hoping Lyney's group would just do your work for you...",
            "nextDialogs": [
              "40090223"
            ]
          },
          "40090223": {
            "id": "40090223",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "You make it sound like that's a bad thing... Unfortunately, things didn't go as planned. I assume that Freminet has told you already — the ratio of Primordial Seawater around the Fortress of Meropide is on the rise.",
            "nextDialogs": [
              "40090224"
            ]
          },
          "40090224": {
            "id": "40090224",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "The forbidden zone has always been Lyney's target, and you got roped into that investigation after running into him. I began to intervene out of concern for your safety, and also to prevent the Fortress from becoming entangled in more irksome matters.",
            "nextDialogs": [
              "40090225"
            ]
          },
          "40090225": {
            "id": "40090225",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Are the rumors true? That you're also a former criminal?",
            "nextDialogs": [
              "40090226"
            ]
          },
          "40090226": {
            "id": "40090226",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Why would you put it like that? Isn't staying here all day and serving as the manager of the Fortress a kind of sentence unto itself, another form of prison? I just happen to have some support from the rest of the inmates, that's all.",
            "nextDialogs": [
              "40090227"
            ]
          },
          "40090227": {
            "id": "40090227",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh right, Paimon wanted to ask — who invited Clorinde down here?",
            "nextDialogs": [
              "40090228"
            ]
          },
          "40090228": {
            "id": "40090228",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Me, of course. I paid her good Mora to come down to the Fortress for some field work.",
            "nextDialogs": [
              "40090229"
            ]
          },
          "40090229": {
            "id": "40090229",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "As a Champion Duelist, Miss Clorinde can be considered to be an independent party. I needed to find an exceptionally capable person to help me get through the impending crisis.",
            "nextDialogs": [
              "40090230"
            ]
          },
          "40090230": {
            "id": "40090230",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And saving Freminet was part of that crisis?",
            "nextDialogs": [
              "40090231"
            ]
          },
          "40090231": {
            "id": "40090231",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "You can think of it like that, yes. Credit where credit is due, that boy is quite adept at diving. Had conditions not been as hostile as they were, he probably would have found the missing Harbinger already.",
            "nextDialogs": [
              "40090234"
            ]
          },
          "40090234": {
            "id": "40090234",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "That's not something you should be asking after. Neuvillette only asked you to investigate Childe's whereabouts.",
            "nextDialogs": [
              "40090235"
            ]
          },
          "40090235": {
            "id": "40090235",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "All I need to prove to you is that the forbidden zone had nothing to do with the Harbinger's disappearance. That should be clear now that you've spoken to Freminet.",
            "nextDialogs": [
              "40090236"
            ]
          },
          "40090236": {
            "id": "40090236",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But... we've already uncovered that there's something wrong with the infirmary, and we've answered a bunch of questions that you threw at us... Isn't it about time that you answer our last question in return?",
            "nextDialogs": [
              "40090237"
            ]
          },
          "40090237": {
            "id": "40090237",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "You make a compelling case... Do you really want to know the answer that badly?",
            "nextDialogs": [
              "40090238"
            ]
          },
          "40090238": {
            "id": "40090238",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah! Paimon really wants to know!",
            "nextDialogs": [
              "40090239"
            ]
          },
          "40090239": {
            "id": "40090239",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Even if the truth may not be pleasant?",
            "nextDialogs": [
              "40090240"
            ]
          },
          "40090240": {
            "id": "40090240",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Yes.",
            "nextDialogs": [
              "40090241"
            ]
          },
          "40090241": {
            "id": "40090241",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Follow me."
          }
        }
      }
    },
    {
      "subId": "400903",
      "subQuestName": "Follow Wriothesley",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090301"
        ],
        "dialogs": {
          "40090301": {
            "id": "40090301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's a hidden door here!? And a whole basement behind it? You're pretty good at hiding stuff, Wriothesley.",
            "nextDialogs": [
              "40090302"
            ]
          },
          "40090302": {
            "id": "40090302",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "It seems you've forgotten just what kind of place the Fortress of Meropide is."
          }
        }
      }
    },
    {
      "subId": "400904",
      "subQuestName": "Follow Wriothesley",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090401"
        ],
        "dialogs": {
          "40090401": {
            "id": "40090401",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Stand on the central plate.",
            "nextDialogs": [
              "40090402"
            ]
          },
          "40090402": {
            "id": "40090402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, is there a secret mechanism or — whoa!!",
            "nextDialogs": [
              "40090403"
            ]
          },
          "40090403": {
            "id": "40090403",
            "speakerId": 1007,
            "speakerName": "Black Screen",
            "text": "Once everyone has taken their positions on the circular plate, it begins to slowly move downwards..."
          }
        }
      }
    },
    {
      "subId": "400906",
      "subQuestName": "Talk to Wriothesley",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090601"
        ],
        "dialogs": {
          "40090601": {
            "id": "40090601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So this is the \"forbidden zone\"? Honestly, for a place so well-hidden, Paimon sure doesn't see anything special...",
            "nextDialogs": [
              "40090602"
            ]
          },
          "40090602": {
            "id": "40090602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "And that is...",
            "nextDialogs": [
              "40090603"
            ]
          },
          "40090603": {
            "id": "40090603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What a huge door!",
            "nextDialogs": [
              "40090604"
            ]
          },
          "40090604": {
            "id": "40090604",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "There are three such isolation gates in total. Generally speaking, I'm the only one who's allowed to go inside. Hence the name, \"forbidden zone.\"",
            "nextDialogs": [
              "40090605"
            ]
          },
          "40090605": {
            "id": "40090605",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Am I correct to assume you're going to run on back and tell your little Fatui friends everything?",
            "nextDialogs": [
              "40090606"
            ]
          },
          "40090606": {
            "id": "40090606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, er, Paimon wasn't thinking of keeping anything from them...",
            "nextDialogs": [
              "40090607"
            ]
          },
          "40090607": {
            "id": "40090607",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Hah. Well, I'd advise you wait until you've seen the whole truth of this place for yourself before deciding whether or not to tell them."
          }
        }
      }
    },
    {
      "subId": "400907",
      "subQuestName": "Keep exploring",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090701"
        ],
        "dialogs": {
          "40090701": {
            "id": "40090701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh, so there's a switch on the side...",
            "nextDialogs": [
              "40090702"
            ]
          },
          "40090702": {
            "id": "40090702",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Stand back.",
            "nextDialogs": [
              "40090703"
            ]
          },
          "40090703": {
            "id": "40090703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa... They all just went up one by one...",
            "nextDialogs": [
              "40090704"
            ]
          },
          "40090704": {
            "id": "40090704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's that in the middle of the room?",
            "nextDialogs": [
              "40090705"
            ]
          },
          "40090705": {
            "id": "40090705",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Go on, have a look."
          }
        }
      }
    },
    {
      "subId": "400908",
      "subQuestName": "Follow Wriothesley and explore ahead",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090801"
        ],
        "dialogs": {
          "40090801": {
            "id": "40090801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(This room is really empty with nothing in here, which is quite strange on its own. There's also a device smack dab in the middle of the room, which looks like some kind of massive sluice gate.)",
            "nextDialogs": [
              "40090802"
            ]
          },
          "40090802": {
            "id": "40090802",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "I've been interested in what lies beyond that gate ever since I assumed leadership of the Fortress of Meropide. Of course, it would be unwise to recklessly open it, but it'd also be risky and negligent to simply ignore any potential danger that could be behind it.",
            "nextDialogs": [
              "40090803"
            ]
          },
          "40090803": {
            "id": "40090803",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "The readings on that dashboard haven't budged since the day when I first laid eyes on this place. But over the past year, the needle has crept upwards from its original position, likely because some parameter it's been tracking has changed, if only infinitesimally.",
            "nextDialogs": [
              "40090804"
            ]
          },
          "40090804": {
            "id": "40090804",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Normally, I would have ignored it, but I happened to have some free time when I noticed it, so I investigated. Any guesses what the reading could be tracking?",
            "nextDialogs": [
              "40090807"
            ]
          },
          "40090807": {
            "id": "40090807",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Very reasonable guesses. I've considered both of those as well. Unfortunately, our dashboard is tracking something less ordinary.",
            "nextDialogs": [
              "40090808"
            ]
          },
          "40090808": {
            "id": "40090808",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "The temperature should vary with weather and climate changes, so for something that rarely shifts, the water pressure is more likely. We ran a few tests to increase the pressure from the outside, but the readings didn't change at all.",
            "nextDialogs": [
              "40090809"
            ]
          },
          "40090809": {
            "id": "40090809",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Later on, a few more possibilities occurred to me, such as a potential connection with the Primordial Sea. I began to make a few preparations based on that hypothesis.",
            "nextDialogs": [
              "40090810"
            ]
          },
          "40090810": {
            "id": "40090810",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Over the past few days, the needle has moved again. With that and the symptoms that Freminet displayed after leaving the Fortress, I can now confidently conclude that the readings represent the concentration of Primordial Seawater in the seawater nearby.",
            "nextDialogs": [
              "40090811"
            ]
          },
          "40090811": {
            "id": "40090811",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "The concentration of... Primordial Seawater!? But we're already under the sea...",
            "nextDialogs": [
              "40090812"
            ]
          },
          "40090812": {
            "id": "40090812",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "And that is precisely the problem. We're at the bottom of the sea, and now we're surrounded by toxic seawater. Somehow, Primordial Seawater got mixed in, and the concentration is steadily rising...",
            "nextDialogs": [
              "40090813"
            ]
          },
          "40090813": {
            "id": "40090813",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...Primordial Seawater is continually leaking into the sea?",
            "nextDialogs": [
              "40090814"
            ]
          },
          "40090814": {
            "id": "40090814",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Yes, that's very likely.",
            "nextDialogs": [
              "40090815"
            ]
          },
          "40090815": {
            "id": "40090815",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But forget about the two of us, not even Neuvillette knows where the Primordial Sea could be, much less where we could find and plug a leak...",
            "nextDialogs": [
              "40090816"
            ]
          },
          "40090816": {
            "id": "40090816",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Oh... OH!",
            "nextDialogs": [
              "40090817"
            ]
          },
          "40090817": {
            "id": "40090817",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Seems like you've figured it out.",
            "nextDialogs": [
              "40090818"
            ]
          },
          "40090818": {
            "id": "40090818",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "I believe the Primordial Sea lies directly beneath this sluice gate. For some reason, the Primordial Seawater levels have risen significantly, and it's now very close to us.",
            "nextDialogs": [
              "40090819"
            ]
          },
          "40090819": {
            "id": "40090819",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "The indicators are now red. Although the gate still stands, some Primordial Seawater has already leaked out and mixed into the sea around us.",
            "nextDialogs": [
              "40090820"
            ]
          },
          "40090820": {
            "id": "40090820",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "...If this continues, soon it will no longer be able to hold back the Primordial Sea at all."
          }
        }
      }
    },
    {
      "subId": "400909",
      "subQuestName": "Return to the office",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40090901"
        ],
        "dialogs": {
          "40090901": {
            "id": "40090901",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "This is it.",
            "nextDialogs": [
              "40090902"
            ]
          },
          "40090902": {
            "id": "40090902",
            "speakerId": 13533,
            "speakerName": "Jurieu",
            "text": "Your Grace! Perfect timing. The results from our latest round of experiments have—",
            "nextDialogs": [
              "40090903"
            ]
          },
          "40090903": {
            "id": "40090903",
            "speakerId": 13532,
            "speakerName": "Lourvine",
            "text": "Wait, Jurieu, he's not alone!",
            "nextDialogs": [
              "40090904"
            ]
          },
          "40090904": {
            "id": "40090904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Lourvine and Jurieu?",
            "nextDialogs": [
              "40090905"
            ]
          },
          "40090905": {
            "id": "40090905",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "No need to panic, you two. I've already told them about our plan.",
            "nextDialogs": [
              "40090906"
            ]
          },
          "40090906": {
            "id": "40090906",
            "speakerId": 13532,
            "speakerName": "Lourvine",
            "text": "What? After you warned us not to tell a single soul about any of this!?",
            "nextDialogs": [
              "40090907"
            ]
          },
          "40090907": {
            "id": "40090907",
            "speakerId": 13533,
            "speakerName": "Jurieu",
            "text": "I'm skeptical as well. Are you sure they are trustworthy?",
            "nextDialogs": [
              "40090908"
            ]
          },
          "40090908": {
            "id": "40090908",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "The results speak for themselves, don't they? These two may already know more than you could ever imagine.",
            "nextDialogs": [
              "40090909"
            ]
          },
          "40090909": {
            "id": "40090909",
            "speakerId": 13533,
            "speakerName": "Jurieu",
            "text": "...Alright then, if Your Grace insists.",
            "nextDialogs": [
              "40090910"
            ]
          },
          "40090910": {
            "id": "40090910",
            "speakerId": 13532,
            "speakerName": "Lourvine",
            "text": "They seem harmless enough... So I'll trust them for now.",
            "nextDialogs": [
              "40090911"
            ]
          },
          "40090911": {
            "id": "40090911",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "How about some reintroductions... This is Jurieu, one of the highest-ranked researchers from the Fontaine Research Institute. He used to work under Edwin. I trust that you've heard of Edwin?",
            "nextDialogs": [
              "40090913",
              "40090915"
            ]
          },
          "40090913": {
            "id": "40090913",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Good. Saves me a bit of time explaining.",
            "nextDialogs": [
              "40090916"
            ]
          },
          "40090916": {
            "id": "40090916",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Edwin's main areas of research were Arkhium and gravimeters. As his assistant, Jurieu is quite familiar with them as well. I hired him to be my technical consultant.",
            "nextDialogs": [
              "40090917"
            ]
          },
          "40090917": {
            "id": "40090917",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You... you want to blow up the Fortress of Meropide?",
            "nextDialogs": [
              "40090918"
            ]
          },
          "40090918": {
            "id": "40090918",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Ah, what a lovely idea. I'm already imagining it in my head.",
            "nextDialogs": [
              "40090919"
            ]
          },
          "40090919": {
            "id": "40090919",
            "speakerId": 13533,
            "speakerName": "Jurieu",
            "text": "Gotta admit, I'm tempted as well...",
            "nextDialogs": [
              "40090920"
            ]
          },
          "40090920": {
            "id": "40090920",
            "speakerId": 13532,
            "speakerName": "Lourvine",
            "text": "Guys, focus! Focus!",
            "nextDialogs": [
              "40090921"
            ]
          },
          "40090921": {
            "id": "40090921",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "That taskmaster over here is Miss Lourvine and is also one of my technical consultants. While Jurieu used to be Edwin's assistant, she used to be Jurieu's assistant.",
            "nextDialogs": [
              "40090922"
            ]
          },
          "40090922": {
            "id": "40090922",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, are they together?",
            "nextDialogs": [
              "40090923"
            ]
          },
          "40090923": {
            "id": "40090923",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Was that really necessary?",
            "nextDialogs": [
              "40090924"
            ]
          },
          "40090924": {
            "id": "40090924",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "See, everyone keeps asking this question. Are you two sure you're not a couple, and just using your work as a convenient cover?",
            "nextDialogs": [
              "40090925"
            ]
          },
          "40090925": {
            "id": "40090925",
            "speakerId": 13532,
            "speakerName": "Lourvine",
            "text": "I... Your Grace, I am NOT in a relationship with this man!",
            "nextDialogs": [
              "40090926"
            ]
          },
          "40090926": {
            "id": "40090926",
            "speakerId": 13533,
            "speakerName": "Jurieu",
            "text": "If I dated her, I'd officially be madder than Edwin!",
            "nextDialogs": [
              "40090927"
            ]
          },
          "40090927": {
            "id": "40090927",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Jeez, forget I said anything, then.",
            "nextDialogs": [
              "40090928"
            ]
          },
          "40090928": {
            "id": "40090928",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Follow me.",
            "nextDialogs": [
              "40090929"
            ]
          },
          "40090929": {
            "id": "40090929",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, there's another door that goes right up!",
            "nextDialogs": [
              "40090930"
            ]
          },
          "40090930": {
            "id": "40090930",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Your constant amazement makes it seem like the Fortress can do anything.",
            "nextDialogs": [
              "40090931"
            ]
          },
          "40090931": {
            "id": "40090931",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "But Paimon really thinks everything's super cool!",
            "nextDialogs": [
              "40090932"
            ]
          },
          "40090932": {
            "id": "40090932",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is this just a normal room?",
            "nextDialogs": [
              "40090933"
            ]
          },
          "40090933": {
            "id": "40090933",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Let's spice it up a bit.",
            "nextDialogs": [
              "40090934"
            ]
          },
          "40090934": {
            "id": "40090934",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "And here you go.",
            "nextDialogs": [
              "40090935"
            ]
          },
          "40090935": {
            "id": "40090935",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This is...!?",
            "nextDialogs": [
              "40090936"
            ]
          },
          "40090936": {
            "id": "40090936",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What a huge... ship?",
            "nextDialogs": [
              "40090937"
            ]
          },
          "40090937": {
            "id": "40090937",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "This is also a production zone that Paimon's never seen before... What's going on?",
            "nextDialogs": [
              "40090938"
            ]
          },
          "40090938": {
            "id": "40090938",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "How much do you know about Fontainian history?",
            "nextDialogs": [
              "40090939"
            ]
          },
          "40090939": {
            "id": "40090939",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Er... Not much at all...",
            "nextDialogs": [
              "40090940"
            ]
          },
          "40090940": {
            "id": "40090940",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Then maybe you haven't heard of the story of ancient Remuria. To give you a quick rundown, Fontaine used to be ruled by the Remurian Dynasty.",
            "nextDialogs": [
              "40090941"
            ]
          },
          "40090941": {
            "id": "40090941",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "According to legend, the Remurian King, Remus, came to this land after being inspired by divine revelation, and found the seer Sybilla, who had taken on the form of a Golden Bee. Taking the Golden Bee with him and riding on a huge ship, the Fortuna, he created his nation above the surging waves.",
            "nextDialogs": [
              "40090942"
            ]
          },
          "40090942": {
            "id": "40090942",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "He called his nation \"Remuria,\" and used the Fortuna to incessantly search for new tribes and islands, calling on them to join his empire.",
            "nextDialogs": [
              "40090943"
            ]
          },
          "40090943": {
            "id": "40090943",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's a ship in this story, too...?",
            "nextDialogs": [
              "40090944"
            ]
          },
          "40090944": {
            "id": "40090944",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Where there's water, there will be ships. People believe that hope can always be found at the end of a voyage.",
            "nextDialogs": [
              "40090945"
            ]
          },
          "40090945": {
            "id": "40090945",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Do you believe that, too?",
            "nextDialogs": [
              "40090946"
            ]
          },
          "40090946": {
            "id": "40090946",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "To a point, I think. As you've already seen, I have a whole factory's worth of labor, materials, and technology at my disposal. Certainly can't hurt to give it a try.",
            "nextDialogs": [
              "40090947"
            ]
          },
          "40090947": {
            "id": "40090947",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "So, the moment I began to speculate that the Primordial Sea might lie underneath the gate, I also began this project.",
            "nextDialogs": [
              "40090948"
            ]
          },
          "40090948": {
            "id": "40090948",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Were you inspired by the legendary Fortuna?",
            "nextDialogs": [
              "40090949"
            ]
          },
          "40090949": {
            "id": "40090949",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Maybe. Fontainians need something to hold on to to cope with the impending disaster."
          },
          "40090915": {
            "id": "40090915",
            "speakerId": 13533,
            "speakerName": "Jurieu",
            "text": "He's the one who blew the whole Institute sky high. Everyone knew he was a bit crooked in the head, but you're not a local, so I guess it's possible for you not to have heard of him."
          }
        }
      }
    },
    {
      "subId": "400912",
      "subQuestName": "Talk to Wriothesley",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "40091201"
        ],
        "dialogs": {
          "40091201": {
            "id": "40091201",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "I'll leave you here for now.",
            "nextDialogs": [
              "40091202"
            ]
          },
          "40091202": {
            "id": "40091202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh! Uh... Thank you so much.",
            "nextDialogs": [
              "40091203"
            ]
          },
          "40091203": {
            "id": "40091203",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "No worries. But don't forget, it's up to you whether or not you want to share what you just saw. What you do from here on out will likely affect those three as well.",
            "nextDialogs": [
              "40091204"
            ]
          },
          "40091204": {
            "id": "40091204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(He means that my actions now will decide the next steps Lyney's group takes.)",
            "nextDialogs": [
              "40091205"
            ]
          },
          "40091205": {
            "id": "40091205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(...In other words, if I want to tell Lyney the truth, I must make him understand that we cannot afford excessive conflict right now.)",
            "nextDialogs": [
              "40091206"
            ]
          },
          "40091206": {
            "id": "40091206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, we'll put a lot of thought into it for sure!",
            "nextDialogs": [
              "40091207"
            ]
          },
          "40091207": {
            "id": "40091207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yeah, we will.",
            "nextDialogs": [
              "40091208"
            ]
          },
          "40091208": {
            "id": "40091208",
            "speakerId": 1078,
            "speakerName": "Wriothesley",
            "text": "Great. I look forward to what happens next."
          }
        }
      }
    },

        ],
        "dialogs": {
          "771030301": {
            "id": "771030301",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Heh heh! Paimon to the rescue~",
            "nextDialogs": [
              "771030302"
            ]
          },
          "771030302": {
            "id": "771030302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're counting on you here, Paimon!",
            "nextDialogs": [
              "771030303"
            ]
          },
          "771030303": {
            "id": "771030303",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But how did the people who built this even get around here? Did they have wings too or something???"
          }
        }
      }

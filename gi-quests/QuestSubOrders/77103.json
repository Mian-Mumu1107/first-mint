  "subQuests": [
    {
      "subId": "7710301",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771030101"
        ],
        "dialogs": {
          "771030101": {
            "id": "771030101",
            "speakerId": 1000,
            "speakerName": "Eye of Graeae",
            "text": "...I detect an energy reaction in the vicinity...",
            "nextDialogs": [
              "771030102"
            ]
          },
          "771030102": {
            "id": "771030102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Um... W—Where are we??? {NICKNAME}, are you alright?",
            "nextDialogs": [
              "771030103"
            ]
          },
          "771030103": {
            "id": "771030103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm okay. Don't worry.",
            "nextDialogs": [
              "771030104"
            ]
          },
          "771030104": {
            "id": "771030104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon can't believe that scary giant bird attacked us just like that, with zero warning! Do you think that scary giant thing is that \"Zala\" Nastya was talking about...?",
            "nextDialogs": [
              "771030105"
            ]
          },
          "771030105": {
            "id": "771030105",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So Nastya lied to us!? Aw, come on! Paimon was really looking forward to this!",
            "nextDialogs": [
              "771030107",
              "771030109"
            ]
          },
          "771030107": {
            "id": "771030107",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh! Wait, wait... Are you saying Zala's only like this to us? Then maybe it's because... y'know... we don't have branches sticking out of our heads like Nastya?",
            "nextDialogs": [
              "771030110"
            ]
          },
          "771030110": {
            "id": "771030110",
            "speakerId": 1000,
            "speakerName": "Eye of Graeae",
            "text": "But to that monster whose sole objective is to preserve the status quo here, our approaching is a form of danger.",
            "nextDialogs": [
              "771030111"
            ]
          },
          "771030111": {
            "id": "771030111",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Huh? But why, though...? We're only here to get Goggles' body part back, that's all...",
            "nextDialogs": [
              "771030112"
            ]
          },
          "771030112": {
            "id": "771030112",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh! Oh! Paimon gets it now! It's all because of Goggles' power! That's what's making this town feel so warm and weird!",
            "nextDialogs": [
              "771030113"
            ]
          },
          "771030113": {
            "id": "771030113",
            "speakerId": 1000,
            "speakerName": "Eye of Graeae",
            "text": "Yes, that is correct.",
            "nextDialogs": [
              "771030114"
            ]
          },
          "771030114": {
            "id": "771030114",
            "speakerId": 1000,
            "speakerName": "Eye of Graeae",
            "text": "That half-man, half-bird creature named Zala... and the way the local residents have transformed in both body and mind... All of these feel extremely familiar to me.",
            "nextDialogs": [
              "771030115"
            ]
          },
          "771030115": {
            "id": "771030115",
            "speakerId": 1000,
            "speakerName": "Eye of Graeae",
            "text": "I can remember now... one of the four who created my body back then at some secret location... He was a leading figure of Snezhnaya's now-vanished school of bio-alchemy...",
            "nextDialogs": [
              "771030116"
            ]
          },
          "771030116": {
            "id": "771030116",
            "speakerId": 1000,
            "speakerName": "Eye of Graeae",
            "text": "...Koshchei the Deathless.",
            "nextDialogs": [
              "771030117"
            ]
          },
          "771030117": {
            "id": "771030117",
            "speakerId": 1000,
            "speakerName": "Eye of Graeae",
            "text": "All these we are seeing are very much aligned with his approach to \"life.\"",
            "nextDialogs": [
              "771030118"
            ]
          },
          "771030118": {
            "id": "771030118",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... So the thing we're looking for is with this Koshchei person?",
            "nextDialogs": [
              "771030119"
            ]
          },
          "771030119": {
            "id": "771030119",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Sheesh... This town feels even weirder now...",
            "nextDialogs": [
              "771030120"
            ]
          },
          "771030120": {
            "id": "771030120",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So anyway... first we take Nastya home, then we look for Koshchei or whatever his name is, right?",
            "nextDialogs": [
              "771030121"
            ]
          },
          "771030121": {
            "id": "771030121",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's... gonna keep us busy for a while.",
            "nextDialogs": [
              "771030122"
            ]
          },
          "771030122": {
            "id": "771030122",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We should find a way to get back to the ground first.",
            "nextDialogs": [
              "771030123"
            ]
          },
          "771030123": {
            "id": "771030123",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Yeah, there's no way we'll find anything just hanging around here... Come on! Let's get out of this dump, fast!",
            "nextDialogs": [
              "771030124"
            ]
          },
          "771030124": {
            "id": "771030124",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Then we'll ask Nastya when we find her!"
          },
          "771030109": {
            "id": "771030109",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But we didn't do anything wrong! If anything, we're the good guys here! We're helping Nastya get home, for crying out loud!"
          }
        }
      }
    },

    {
      "subId": "7710307",
      "subQuestName": "Investigate the control room in the sewer",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "771580401"
        ],
        "dialogs": {
          "771580401": {
            "id": "771580401",
            "speakerId": 1003,
            "speakerName": "Control Guide (I)",
            "text": "...must undergo three rounds of authentications... <color=#00E1FFFF>Keys made of gold, silver, and iron</color>... placed in three different locations... inserted into the respective recesses...",
            "nextDialogs": [
              "771580402"
            ]
          },
          "771580402": {
            "id": "771580402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ooh! Found it! Looks like there's a name written on the cover of this tattered little book... \"Doctor Moreau\"? Uh, so these are the notes written by that kind doctor?",
            "nextDialogs": [
              "771580403"
            ]
          },
          "771580403": {
            "id": "771580403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Whatever. So all we have to do is go to these three spots and find the <color=#00E1FFFF>gold, silver, and iron keys</color>...",
            "nextDialogs": [
              "771580404"
            ]
          },
          "771580404": {
            "id": "771580404",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "...Then we insert them into the three places, and... and we should be able to get out, right?"
          }
        }
      }
    },

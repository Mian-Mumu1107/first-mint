        ],
        "dialogs": {
          "705560101": {
            "id": "705560101",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "#Hey there, {NICKNAME}, Paimon!",
            "nextDialogs": [
              "705560102"
            ]
          },
          "705560102": {
            "id": "705560102",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Let me introduce our new colleague — this is Eija, Signals Officer for the 7th Company. And this is her able assistant, Vesper.",
            "nextDialogs": [
              "705560103"
            ]
          },
          "705560103": {
            "id": "705560103",
            "speakerId": 1001,
            "speakerName": "Eija",
            "text": "Pleased to make your acquaintance, Honorary Knight and the Helper in White. It's an honor to meet you.",
            "nextDialogs": [
              "705560104"
            ]
          },
          "705560104": {
            "id": "705560104",
            "speakerId": 1001,
            "speakerName": "Eija",
            "text": "Say hello, Vesper.",
            "nextDialogs": [
              "705560105"
            ]
          },
          "705560105": {
            "id": "705560105",
            "speakerId": 1002,
            "speakerName": "Vesper",
            "text": "Shrawrr!",
            "nextDialogs": [
              "705560108"
            ]
          },
          "705560108": {
            "id": "705560108",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Whoa, this falcon is so well-behaved! It looks like it's wearing armor, and it's even carrying a tiny bag!",
            "nextDialogs": [
              "705560109"
            ]
          },
          "705560109": {
            "id": "705560109",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Hold on a second, Paimon's confused... What did Amber mean when she said \"performance\"?",
            "nextDialogs": [
              "705560110"
            ]
          },
          "705560110": {
            "id": "705560110",
            "speakerId": 1003,
            "speakerName": "Paimon",
            "text": "Does this have something to do with Miss Eija and Vesper?",
            "nextDialogs": [
              "705560111"
            ]
          },
          "705560111": {
            "id": "705560111",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Haha, let me explain.",
            "nextDialogs": [
              "705560112"
            ]
          },
          "705560112": {
            "id": "705560112",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "Master Jean probably told you we're holding a wind glider speed shooting event, am I right? That's a very simple way of explaining it...",
            "nextDialogs": [
              "705560113"
            ]
          },
          "705560113": {
            "id": "705560113",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "In reality, it might be a little different from your expectations. This event is more like a \"flying performance and instruction challenge.\"",
            "nextDialogs": [
              "705560114"
            ]
          },
          "705560114": {
            "id": "705560114",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "The crux of this event isn't gliding with a wind glider, it's about sending signals from the ground to airborne units — like Vesper — so we can instruct them to perform complex maneuvers and defeat monsters — represented by targets, naturally...",
            "nextDialogs": [
              "705560115"
            ]
          },
          "705560115": {
            "id": "705560115",
            "speakerId": 1000,
            "speakerName": "Amber",
            "text": "It should be a novel experience — a pleasant little surprise.",
            "nextDialogs": [
              "705560116"
            ]
          },
          "705560116": {
            "id": "705560116",
            "speakerId": 1002,
            "speakerName": "Vesper",
            "text": "Shrawrr!"
          }
        }
      }
    }
  ]

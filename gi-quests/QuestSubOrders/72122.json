    {
      "subId": "7212203",
      "subQuestName": "Get close to the Mikage Furnace",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721220301"
        ],
        "dialogs": {
          "721220301": {
            "id": "721220301",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Ah, curses, curses...",
            "nextDialogs": [
              "721220305",
              "721220304"
            ]
          },
          "721220305": {
            "id": "721220305",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "It seems like we're now missing about... one, two, three components.",
            "nextDialogs": [
              "721220306"
            ]
          },
          "721220306": {
            "id": "721220306",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "They're not key parts, so the device is still working.",
            "nextDialogs": [
              "721220307"
            ]
          },
          "721220307": {
            "id": "721220307",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "But if we wish to proceed, we have to find a way to get them back.",
            "nextDialogs": [
              "721220308"
            ]
          },
          "721220308": {
            "id": "721220308",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "These components should still be on the path we took to get here. Please help me look for them. I'll be here waiting."
          },
          "721220304": {
            "id": "721220304",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Well... I wouldn't say so, precisely."
          }
        }
      }
    },
    {
      "subId": "7212204",
      "subQuestName": "Talk to Xavier",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721220201"
        ],
        "dialogs": {
          "721220201": {
            "id": "721220201",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Oh, good heavens... this is my first time entering this sort of place without any protective measures...",
            "nextDialogs": [
              "721220202"
            ]
          },
          "721220202": {
            "id": "721220202",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Still, we've actually made it here, so that is good. In fact, it's great! Almost beyond my estimations.",
            "nextDialogs": [
              "721220204"
            ]
          },
          "721220204": {
            "id": "721220204",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "This was as high as my estimations could go for this eleventh-hour solution.",
            "nextDialogs": [
              "721220206"
            ]
          },
          "721220206": {
            "id": "721220206",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "In my estimation, this cobbled-together fellow here would have failed on us halfway through.",
            "nextDialogs": [
              "721220207"
            ]
          },
          "721220207": {
            "id": "721220207",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Afterward, I would have been rendered unconscious by the Tatarigami energy... well, either that or because I'd have scared myself silly...",
            "nextDialogs": [
              "721220208"
            ]
          },
          "721220208": {
            "id": "721220208",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Either way, I kept a small piece of paper in my right trouser pocket. As long as you followed those steps, you'd be able to take me to safety outside.",
            "nextDialogs": [
              "721220209"
            ]
          },
          "721220209": {
            "id": "721220209",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "Wait... did I tell you about that piece of paper?"
          }
        }
      }
    },

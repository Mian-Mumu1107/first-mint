              "721221209"
            ]
          },
          "721221209": {
            "id": "721221209",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "What's more, I suspect that our previous actions only went over so smoothly due to the aid of this Mr. Hanbei.",
            "nextDialogs": [
              "721221210"
            ]
          },
          "721221210": {
            "id": "721221210",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "And of course, it's not as if this soldier was of no help to us at all. After all, those few doors...",
            "nextDialogs": [
              "721221211"
            ]
          },
          "721221211": {
            "id": "721221211",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "Thank you for your help, Mr. Xavier.",
            "nextDialogs": [
              "721221212"
            ]
          },
          "721221212": {
            "id": "721221212",
            "speakerId": 1000,
            "speakerName": "Xavier",
            "text": "*cough* Well, it was mainly the work of this Traveler. If not for them, I doubt that I would have achieved anything at all.",
            "nextDialogs": [
              "721221213"
            ]
          },
          "721221213": {
            "id": "721221213",
            "speakerId": 1001,
            "speakerName": "Toranosuke",
            "text": "Is that so...",
            "nextDialogs": [
              "721221214"
            ]
          },

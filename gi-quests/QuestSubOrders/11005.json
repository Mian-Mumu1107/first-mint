  "subQuests": [
    {
      "subId": "1100501",
      "subQuestName": "Return to Springvale for the cooking showdown",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110050101"
        ],
        "dialogs": {
          "110050101": {
            "id": "110050101",
            "speakerId": 1000,
            "speakerName": "Olaf",
            "text": "Uh... Are you sure this is Springvale?",
            "nextDialogs": [
              "110050102"
            ]
          },
          "110050102": {
            "id": "110050102",
            "speakerId": 1001,
            "speakerName": "Draff",
            "text": "Yes. For the millionth time, yes! But I don't know any of the people you're looking for.",
            "nextDialogs": [
              "110050103"
            ]
          },
          "110050103": {
            "id": "110050103",
            "speakerId": 1000,
            "speakerName": "Olaf",
            "text": "That is not possible, they all live in Springvale. They are my neighbors and friends.",
            "nextDialogs": [
              "110050104"
            ]
          },
          "110050104": {
            "id": "110050104",
            "speakerId": 1001,
            "speakerName": "Draff",
            "text": "This is strange, what is going on?",
            "nextDialogs": [
              "110050107"
            ]
          },
          "110050107": {
            "id": "110050107",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "What is it?"
          }
        }
      }
    },
    {
      "subId": "1100502",
      "subQuestName": "Talk to Xiangling at the Cooking Showdown",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110050201"
        ],
        "dialogs": {
          "110050201": {
            "id": "110050201",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "We're ready to cook. Are you?",
            "nextDialogs": [
              "110050202"
            ]
          },
          "110050202": {
            "id": "110050202",
            "speakerId": 1004,
            "speakerName": "Brook",
            "text": "I was born ready. Oh, and Siegfria will be my assistant for the competition.",
            "nextDialogs": [
              "110050203"
            ]
          },
          "110050203": {
            "id": "110050203",
            "speakerId": 1001,
            "speakerName": "Draff",
            "text": "Then let the cooking commence! I will be your judge today.",
            "nextDialogs": [
              "110050204"
            ]
          },
          "110050204": {
            "id": "110050204",
            "speakerId": 1001,
            "speakerName": "Draff",
            "text": "And don't worry, I may have known Brook for longer, but I will remain entirely impartial.",
            "nextDialogs": [
              "110050205"
            ]
          },
          "110050205": {
            "id": "110050205",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "#Much appreciated. Well then, {NICKNAME}, Paimon — prepare!",
            "nextDialogs": [
              "110050206"
            ]
          },
          "110050206": {
            "id": "110050206",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Wait, we're taking part in this too?",
            "nextDialogs": [
              "110050207"
            ]
          },
          "110050207": {
            "id": "110050207",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Of course! If Brook has an assistant, you guys will have to be mine. I'll need you by my side when the going gets tough!",
            "nextDialogs": [
              "110050208"
            ]
          },
          "110050208": {
            "id": "110050208",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "*sigh* Paimon doesn't remember applying for that job...",
            "nextDialogs": [
              "110050211"
            ]
          },
          "110050211": {
            "id": "110050211",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Okay. Paimon'll do it for the sake of the food."
          }
        }
      }
    },
    {
      "subId": "1100503",
      "subQuestName": "Help Xiangling during the cooking showdown",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110050301"
        ],
        "dialogs": {
          "110050301": {
            "id": "110050301",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Our first problem is ingredients. We need something special to dress up the steak, but I don't have anything suitable here. Hmm...",
            "nextDialogs": [
              "110050302"
            ]
          },
          "110050302": {
            "id": "110050302",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "I've got it! Radish is what we need. Mashed or grated, it'll add a touch of freshness.",
            "nextDialogs": [
              "110050303"
            ]
          },
          "110050303": {
            "id": "110050303",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "And we can carve little flowers out of it as a garnish. Two birds, one stone!",
            "nextDialogs": [
              "110050304"
            ]
          },
          "110050304": {
            "id": "110050304",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Go find me a radish — there should be some in the area. Oh, and make sure you wash it because it's going straight into the dish!"
          }
        }
      }
    },
    {

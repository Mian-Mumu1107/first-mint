    {
      "subId": "1100598",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110059801"
        ],
        "dialogs": {
          "110059801": {
            "id": "110059801",
            "speakerId": 1004,
            "speakerName": "Brook",
            "text": "What's this? Culinary espionage?",
            "nextDialogs": [
              "110059802"
            ]
          },
          "110059802": {
            "id": "110059802",
            "speakerId": 1004,
            "speakerName": "Brook",
            "text": "Haha, well you don't stand a chance, anyway. I have the winning ingredients right here.",
            "nextDialogs": [
              "110059803"
            ]
          },
          "110059803": {
            "id": "110059803",
            "speakerId": 1005,
            "speakerName": "Siegfria",
            "text": "Smells divine! ...One little bite can't hurt, surely?",
            "nextDialogs": [
              "110059804"
            ]
          },
          "110059804": {
            "id": "110059804",
            "speakerId": 1005,
            "speakerName": "Siegfria",
            "text": "No, I mustn't... I'm here to help... eyes on the prize, eyes on the prize...",
            "nextDialogs": [
              "110059805"
            ]
          },
          "110059805": {
            "id": "110059805",
            "speakerId": 1000,
            "speakerName": "Olaf",
            "text": "I never knew cooking could be so complicated... The roast boar I am used to is quite basic by comparison!"
          }
        }
      }
    }

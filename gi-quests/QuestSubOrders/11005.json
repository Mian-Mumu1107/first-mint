      }
    },
    {
      "subId": "1100512",
      "subQuestName": "Give the Delicious Chicken-Mushroom Skewer to Xiangling",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051201"
        ],
        "dialogs": {
          "110051201": {
            "id": "110051201",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "#Mmm! {NICKNAME}, you're a natural!",
            "nextDialogs": [
              "110051202"
            ]
          },
          "110051202": {
            "id": "110051202",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "The meat is on track, but we're aiming for perfection here and I just think it lacks a certain...",
            "nextDialogs": [
              "110051203"
            ]
          },
          "110051203": {
            "id": "110051203",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "A certain what?",
            "nextDialogs": [
              "110051204"
            ]
          },
          "110051204": {
            "id": "110051204",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "A certain... boom shaka-laka!",
            "nextDialogs": [
              "110051205"
            ]
          },
          "110051205": {
            "id": "110051205",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Yes! Definitely needs some boom shaka-laka — or perhaps a little shaka-laka boom-pow!",
            "nextDialogs": [
              "110051208"
            ]
          },
          "110051208": {
            "id": "110051208",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "I just mean it would be a waste of such amazing ingredients to just serve this as-is.",
            "nextDialogs": [
              "110051209"
            ]
          },
          "110051209": {
            "id": "110051209",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Let me see... Hmm, what would be ideal is some kind of regional specialty.",
            "nextDialogs": [
              "110051210"
            ]
          },
          "110051210": {
            "id": "110051210",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Regional specialty?",
            "nextDialogs": [
              "110051211"
            ]
          },
          "110051211": {
            "id": "110051211",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Yes, something that's native to this area but isn't often used in cooking.",
            "nextDialogs": [
              "110051212"
            ]
          },
          "110051212": {
            "id": "110051212",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "I don't care if it flies, crawls, or bounces. Even insects I can work with...",
            "nextDialogs": [
              "110051213"
            ]
          },
          "110051213": {
            "id": "110051213",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Uh, interesting choice...",
            "nextDialogs": [
              "110051214"
            ]
          },
          "110051214": {
            "id": "110051214",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Hmm, I'm sure I can make something of it!",
            "nextDialogs": [
              "110051215"
            ]
          },
          "110051215": {
            "id": "110051215",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Alright then..."
          }
        }
      }
    },
    {
      "subId": "1100513",
      "subQuestName": "Find suitable ingredients",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051301"
        ],
        "dialogs": {
          "110051301": {
            "id": "110051301",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Thanks, you guys! Now show me what you got!",
            "nextDialogs": [
              "110051304"
            ]
          },
          "110051304": {
            "id": "110051304",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Sorry to keep you running back and forth.",
            "nextDialogs": [
              "110051305"
            ]
          },
          "110051305": {
            "id": "110051305",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "What I need is a living being, one you wouldn't normally cook with.",
            "nextDialogs": [
              "110051306"
            ]
          },
          "110051306": {
            "id": "110051306",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "It can fly, it can crawl, or it can bounce. Even insects are fair game!",
            "nextDialogs": [
              "110051399"
            ]
          },
          "110051399": {
            "id": "110051399",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "It might be a challenge to find... I'm sure you're up to it!"
          }
        }
      }
    },
    {
      "subId": "1100514",
      "subQuestName": "Ask Xiangling if she is satisfied with the ingredients",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051401"
        ],
        "dialogs": {
          "110051401": {
            "id": "110051401",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Do you really want to add that?",
            "nextDialogs": [
              "110051402"
            ]
          },
          "110051402": {
            "id": "110051402",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "It's a little... odd...",
            "nextDialogs": [
              "110051403"
            ]
          },
          "110051403": {
            "id": "110051403",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "It'll be fine. This was an excellent find, guys! Now, if you'll excuse me, Chef Xiangling needs to concentrate.",
            "nextDialogs": [
              "110051404"
            ]
          },
          "110051404": {
            "id": "110051404",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "But I'll be sure to annoy you again if I need anything else, hee-hee!"
          }
        }
      }
    },
    {
      "subId": "1100504",
      "subQuestName": "Competition countdown timer. For calculating score.",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1100515",
      "subQuestName": "Ask Xiangling if she needs any more help",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051501"
        ],
        "dialogs": {
          "110051501": {
            "id": "110051501",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "I almost forgot — side dish! We need a side dish!",
            "nextDialogs": [
              "110051503",
              "110051505"
            ]
          },
          "110051503": {
            "id": "110051503",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Are you sure it's no trouble?",
            "nextDialogs": [
              "110051506"
            ]
          },
          "110051506": {
            "id": "110051506",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Here, take this. I just scrawled it down at the last minute.",
            "nextDialogs": [
              "110051507"
            ]
          },
          "110051507": {
            "id": "110051507",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "And here are all the ingredients you need.",
            "nextDialogs": [
              "110051508"
            ]
          },
          "110051508": {
            "id": "110051508",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Is this the <color=#00E1FFFF>recipe</color> for that snack you gave us earlier!?",
            "nextDialogs": [
              "110051509"
            ]
          },
          "110051509": {
            "id": "110051509",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Yes, with some minor improvements so it uses up the leftover ingredients from Liyue.",
            "nextDialogs": [
              "110051510"
            ]
          },
          "110051510": {
            "id": "110051510",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "This is so complicated... How are we supposed to cook this with no experience?",
            "nextDialogs": [
              "110051511"
            ]
          },
          "110051511": {
            "id": "110051511",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "The technique doesn't matter — what matters is that you do it with passion! That's what my father taught me.",
            "nextDialogs": [
              "110051512"
            ]
          },
          "110051512": {
            "id": "110051512",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "And you must be passionate about cooking if you've helped me this much already.",
            "nextDialogs": [
              "110051513"
            ]
          },
          "110051513": {
            "id": "110051513",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "I trust you guys. I know you'll nail this side dish!"
          },
          "110051505": {
            "id": "110051505",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Thanks! Hee-hee, you know me too well."
          }
        }
      }
    },
    {
      "subId": "1100599",
      "subQuestName": "Ham",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110059901"
        ],
        "dialogs": {
          "110059901": {
            "id": "110059901",
            "speakerId": 1001,
            "speakerName": "Draff",
            "text": "Fusion cuisine that blends elements of Mondstadt and Liyue cooking... I am excited."
          }
        }
      }
    },
    {
      "subId": "1100516",
      "subQuestName": "Make Delicious Jade Parcels",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051601"
        ],
        "dialogs": {
          "110051601": {
            "id": "110051601",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Are the Jade Parcels ready yet?",
            "nextDialogs": [
              "110051602"
            ]
          },
          "110051602": {
            "id": "110051602",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Flavor is key, but you also don't want to take too long over it. Once they're ready, bring them here and I'll serve the dish!"
          }
        }
      }
    },
    {
      "subId": "1100517",
      "subQuestName": "Give the Delicious Jade Parcels to Xiangling",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051701"
        ],
        "dialogs": {
          "110051701": {
            "id": "110051701",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Mmm! They're so fragrant I could smell them coming a mile away.",
            "nextDialogs": [
              "110051702"
            ]
          },
          "110051702": {
            "id": "110051702",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "We're all set! And now to serve the meal — this competition is ours!"
          }
        }
      }
    },
    {
      "subId": "1100518",
      "subQuestName": "Talk to Draff and await the results",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051801"
        ],
        "dialogs": {
          "110051801": {
            "id": "110051801",
            "speakerId": 1001,
            "speakerName": "Draff",
            "text": "This was a fine feast. I have dined today like I have never dined before.",
            "nextDialogs": [
              "110051802"
            ]
          },
          "110051802": {
            "id": "110051802",
            "speakerId": 1001,
            "speakerName": "Draff",
            "text": "Both chefs' dishes today were nothing short of exceptional. They were true masterpieces. And that is what makes this an extremely difficult decision.",
            "nextDialogs": [
              "110051803"
            ]
          },
          "110051803": {
            "id": "110051803",
            "speakerId": 1001,
            "speakerName": "Draff",
            "text": "But, this is a competition and there can only be one winner — and that winner is...",
            "nextDialogs": [
              "110051804"
            ]
          },
          "110051804": {
            "id": "110051804",
            "speakerId": 1001,
            "speakerName": "Draff",
            "text": "Xiangling!",
            "nextDialogs": [
              "110051805"
            ]
          },
          "110051805": {
            "id": "110051805",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Whoopee! I win!",
            "nextDialogs": [
              "110051806"
            ]
          },
          "110051806": {
            "id": "110051806",
            "speakerId": 1004,
            "speakerName": "Brook",
            "text": "*sigh* I thought I was sure to win with pork chops so fresh they were practically still grunting.",
            "nextDialogs": [
              "110051807"
            ]
          },
          "110051807": {
            "id": "110051807",
            "speakerId": 1004,
            "speakerName": "Brook",
            "text": "But it turns out that's still no match for the taste of extinct boar.",
            "nextDialogs": [
              "110051808"
            ]
          },
          "110051808": {
            "id": "110051808",
            "speakerId": 1001,
            "speakerName": "Draff",
            "text": "Excuse me? Did you say this was cooked from extinct boar!?",
            "nextDialogs": [
              "110051809"
            ]
          },
          "110051809": {
            "id": "110051809",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Yep, every last bit!",
            "nextDialogs": [
              "110051810"
            ]
          },
          "110051810": {
            "id": "110051810",
            "speakerId": 1001,
            "speakerName": "Draff",
            "text": "My goodness... A single mouthful must be worth a hundred thousand Mora!",
            "nextDialogs": [
              "110051811"
            ]
          },
          "110051811": {
            "id": "110051811",
            "speakerId": 1001,
            "speakerName": "Draff",
            "text": "The amount you'd make if you sold this could support every hunter in town for years to come!",
            "nextDialogs": [
              "110051812"
            ]
          },
          "110051812": {
            "id": "110051812",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Hee-hee, the main thing is that you enjoyed eating it. I don't care about the Mora.",
            "nextDialogs": [
              "110051813"
            ]
          },
          "110051813": {
            "id": "110051813",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Anyway, now that our judge has given his verdict, it's time for everyone else to eat too. I made plenty!",
            "nextDialogs": [
              "110051814"
            ]
          },
          "110051814": {
            "id": "110051814",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Meanwhile, I want to try Brook's dish.",
            "nextDialogs": [
              "110051815"
            ]
          },
          "110051815": {
            "id": "110051815",
            "speakerId": 1004,
            "speakerName": "Brook",
            "text": "This is absolutely delicious... I'll admit it, I was beaten by the best.",
            "nextDialogs": [
              "110051816"
            ]
          },
          "110051816": {
            "id": "110051816",
            "speakerId": 1005,
            "speakerName": "Siegfria",
            "text": "Losing is no fun, but it was worth it for the chance to eat such superb cooking! Please Xiangling, I want some more!",
            "nextDialogs": [
              "110051817"
            ]
          },
          "110051817": {
            "id": "110051817",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "This is gorgeous too! Such a perfectly layered texture.",
            "nextDialogs": [
              "110051818"
            ]
          },
          "110051818": {
            "id": "110051818",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Were it not for that exquisite boar and excellent side dish, it's hard to say if I still would have won.",
            "nextDialogs": [
              "110051819"
            ]
          },
          "110051819": {
            "id": "110051819",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Paimon's turn to eat!",
            "nextDialogs": [
              "110051820"
            ]
          },
          "110051820": {
            "id": "110051820",
            "speakerId": 1000,
            "speakerName": "Olaf",
            "text": "I will have a taste too.",
            "nextDialogs": [
              "110051821"
            ]
          },
          "110051821": {
            "id": "110051821",
            "speakerId": 1000,
            "speakerName": "Olaf",
            "text": "Oh... My oh my... This is...",
            "nextDialogs": [
              "110051822"
            ]
          },
          "110051822": {
            "id": "110051822",
            "speakerId": 1000,
            "speakerName": "Olaf",
            "text": "This is the taste of Springvale! ...Or rather... it used to be.",
            "nextDialogs": [
              "110051823"
            ]
          },
          "110051823": {
            "id": "110051823",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It tastes so good I want to weep tears of joy.",
            "nextDialogs": [
              "110051824"
            ]
          },
          "110051824": {
            "id": "110051824",
            "speakerId": 1000,
            "speakerName": "Olaf",
            "text": "*sob* This is the last time I will be able to taste the food of my era...",
            "nextDialogs": [
              "110051825"
            ]
          },
          "110051825": {
            "id": "110051825",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Hey now... Cheer up, if you like the taste I can always make you some more!",
            "nextDialogs": [
              "110051826"
            ]
          },
          "110051826": {
            "id": "110051826",
            "speakerId": 1000,
            "speakerName": "Olaf",
            "text": "...Really? But the boar... it's extinct...",
            "nextDialogs": [
              "110051827"
            ]
          },
          "110051827": {
            "id": "110051827",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "The boar may be, but the taste isn't! I can simply recreate it using different ingredients.",
            "nextDialogs": [
              "110051828"
            ]
          },
          "110051828": {
            "id": "110051828",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Putting a smile on customers' faces is what we chefs are called to do!",
            "nextDialogs": [
              "110051829"
            ]
          },
          "110051829": {
            "id": "110051829",
            "speakerId": 1000,
            "speakerName": "Olaf",
            "text": "Th—Thank you... *sob*"
          }
        }
      }
    },
    {
      "subId": "1100519",
      "subQuestName": "Accept Xiangling's thanks",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051901"
        ],
        "dialogs": {
          "110051901": {
            "id": "110051901",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Thanks, you guys. Without your help, I don't know how it would have gone today.",
            "nextDialogs": [
              "110051902"
            ]
          },
          "110051902": {
            "id": "110051902",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "And without you, Paimon wouldn't have gotten to try so many new tasty snacks!",
            "nextDialogs": [
              "110051903"
            ]
          },
          "110051903": {
            "id": "110051903",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Also wouldn't have gotten so full...",
            "nextDialogs": [
              "110051904"
            ]
          },
          "110051904": {
            "id": "110051904",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Where will you go now?",
            "nextDialogs": [
              "110051905"
            ]
          },
          "110051905": {
            "id": "110051905",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Not sure. I'll probably start heading back to Liyue, but I might change my plan on the way.",
            "nextDialogs": [
              "110051906"
            ]
          },
          "110051906": {
            "id": "110051906",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "I don't like to plan things too thoroughly.",
            "nextDialogs": [
              "110051907"
            ]
          },
          "110051907": {
            "id": "110051907",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Who knows, maybe you'll bump into me out in the wild again!",
            "nextDialogs": [
              "110051908"
            ]
          },
          "110051908": {
            "id": "110051908",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Must be nice to be so carefree.",
            "nextDialogs": [
              "110051909"
            ]
          },
          "110051909": {
            "id": "110051909",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "#You are a gifted chef, {NICKNAME}. You made an amazing batch of Jade Parcels.",
            "nextDialogs": [
              "110051910"
            ]
          },
          "110051910": {
            "id": "110051910",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Come and visit me at the Wanmin Restaurant some time. I did promise I'd cook for you!",
            "nextDialogs": [
              "110051911"
            ]
          },
          "110051911": {
            "id": "110051911",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "And if you want, I'll teach you how to cook some of my latest inventions too.",
            "nextDialogs": [
              "110051913",
              "110051915"
            ]
          },
          "110051913": {
            "id": "110051913",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "You have a deal!",
            "nextDialogs": [
              "110051916"
            ]
          },
          "110051916": {
            "id": "110051916",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "#Hee-hee, see you again soon, {NICKNAME}!"
          },
          "110051915": {
            "id": "110051915",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "How did you know what dish I was thinking of!?"
          }
        }
      }
    },

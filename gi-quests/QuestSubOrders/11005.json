    {
      "subId": "1100510",
      "subQuestName": "Continue to help Xiangling",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110051002"
        ],
        "dialogs": {
          "110051002": {
            "id": "110051002",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Ugh, this is practically charcoal now... Wah, I'm gonna have to start from scratch.",
            "nextDialogs": [
              "110051003"
            ]
          },
          "110051003": {
            "id": "110051003",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Also, I'm thinking our main is a little weak... We need to mix it up a bit.",
            "nextDialogs": [
              "110051004"
            ]
          },
          "110051004": {
            "id": "110051004",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Make me a Chicken-Mushroom Skewer. And make sure it's got that ooh la-la on the outside, then hits you with a cha-ching in the middle!",
            "nextDialogs": [
              "110051007"
            ]
          },
          "110051007": {
            "id": "110051007",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Just make it taste <color=#00E1FFFF>friggin' awesome</color>!"
          }
        }
      }
    },
    {
      "subId": "1100511",
      "subQuestName": "Cook a Delicious Chicken-Mushroom Skewer",
      "sceneId": null,
      "locations": [],

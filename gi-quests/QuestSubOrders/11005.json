    {
      "subId": "1100508",
      "subQuestName": "Give the washed Radish to Xiangling",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "110050801"
        ],
        "dialogs": {
          "110050801": {
            "id": "110050801",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Wowee! Big and luscious. It's perfect. Thanks, you guys!",
            "nextDialogs": [
              "110050802"
            ]
          },
          "110050802": {
            "id": "110050802",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Now, how about...",
            "nextDialogs": [
              "110050803"
            ]
          },
          "110050803": {
            "id": "110050803",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "...Xiangling! Look out, the pan's on fire!",
            "nextDialogs": [
              "110050804"
            ]
          },
          "110050804": {
            "id": "110050804",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "Oh, no! It's gonna burn, it's gonna burn, it's gonna burn!!!",
            "nextDialogs": [
              "110050805"
            ]
          },
          "110050805": {
            "id": "110050805",
            "speakerId": 1003,
            "speakerName": "Xiangling",
            "text": "#{NICKNAME}, get the fire under control! Without using water though, or this dish is a goner!"
          }
        }
      }
    },
    {
      "subId": "1100509",
      "subQuestName": "Extinguish the pan fires",
      "sceneId": null,

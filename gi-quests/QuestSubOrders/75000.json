    {
      "subId": "7500010",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750001001"
        ],
        "dialogs": {
          "750001001": {
            "id": "750001001",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Rawr...",
            "nextDialogs": [
              "750001002"
            ]
          },
          "750001002": {
            "id": "750001002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hmm, this name feels like it's piling the pressure on... Let's go with something else, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7500008",
      "subQuestName": "Leave the strange space",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750000801"
        ],

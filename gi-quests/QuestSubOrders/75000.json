          "750000301": {
            "id": "750000301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Then let's call this little fella {TMPVALUE(TMP_VALUE_KEY_TYPE_LITTLE_DRILL_TMP_NAME)}, shall we?"
          }
        }
      }
    },
    {
      "subId": "7500005",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750000501"
        ],
        "dialogs": {
          "750000501": {
            "id": "750000501",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let me think about this some more...",
            "nextDialogs": [
              "750000502"
            ]
          },
          "750000502": {
            "id": "750000502",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright. Names are important, after all, so give it all the thought you need!"
          }
        }
      }
    },
    {
      "subId": "7500006",
      "subQuestName": "Speak to the young creature",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750000601"
        ],
        "dialogs": {
          "750000601": {
            "id": "750000601",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ah... Are you alright there, little guy?",
            "nextDialogs": [
              "750000602"
            ]
          },
          "750000602": {
            "id": "750000602",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Rawr...",
            "nextDialogs": [
              "750000603"
            ]
          },
          "750000603": {
            "id": "750000603",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wh—What's wrong? You don't look so good. Is it your tail? Did you injure it when you fell from that barrier?",
            "nextDialogs": [
              "750000604"
            ]
          },
          "750000604": {
            "id": "750000604",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Rawr...",
            "nextDialogs": [
              "750000605"
            ]
          },
          "750000605": {
            "id": "750000605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "If only we could bandage it...",
            "nextDialogs": [
              "750000606"
            ]
          },
          "750000606": {
            "id": "750000606",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, it's Paimon's time to shine! Your backpack's so full that even when it's an emergency, it still takes all day to find anything.",
            "nextDialogs": [
              "750000607"
            ]
          },
          "750000607": {
            "id": "750000607",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's use this scarf from Paimon's Emergency Backpack instead!",
            "nextDialogs": [
              "750000608"
            ]
          },
          "750000608": {
            "id": "750000608",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I have no clue where that backpack of yours is even supposed to be...",
            "nextDialogs": [
              "750000609"
            ]
          },
          "750000609": {
            "id": "750000609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph! Somewhere secret, somewhere safe, of course...",
            "nextDialogs": [
              "750000610"
            ]
          },
          "750000610": {
            "id": "750000610",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, do you wanna use the scarf or not?",
            "nextDialogs": [
              "750000611"
            ]
          },
          "750000611": {
            "id": "750000611",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We'll use it. Thank you kindly, Paimon.",
            "nextDialogs": [
              "750000612"
            ]
          },
          "750000612": {
            "id": "750000612",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Errr?",
            "nextDialogs": [
              "750000613"
            ]
          },
          "750000613": {
            "id": "750000613",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright, little guy, don't move...",
            "nextDialogs": [
              "750000614"
            ]
          },
          "750000614": {
            "id": "750000614",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hehe. Our little guy sure is well behaved, eh, {NICKNAME}?",
            "nextDialogs": [
              "750000615"
            ]
          },
          "750000615": {
            "id": "750000615",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Rawr!",
            "nextDialogs": [
              "750000616"
            ]
          },
          "750000616": {
            "id": "750000616",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That should do the trick.",
            "nextDialogs": [
              "750000617"
            ]
          },
          "750000617": {
            "id": "750000617",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright. Feel better now?",
            "nextDialogs": [
              "750000618"
            ]
          },
          "750000618": {
            "id": "750000618",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Roar...",
            "nextDialogs": [
              "750000619"
            ]
          },
          "750000619": {
            "id": "750000619",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, looks way better now. That's a relief... Still, how did you end up in that barrier? And those Rifthounds...",
            "nextDialogs": [
              "750000620"
            ]
          },
          "750000620": {
            "id": "750000620",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Errr?",
            "nextDialogs": [
              "750000621"
            ]
          },
          "750000621": {
            "id": "750000621",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So you don't know either, huh. Now, we don't really get what you're saying... But now that we've rescued you, you can go home.",
            "nextDialogs": [
              "750000622"
            ]
          },
          "750000622": {
            "id": "750000622",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Ehrrr?",
            "nextDialogs": [
              "750000623"
            ]
          },
          "750000623": {
            "id": "750000623",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wait, do you not know where your home is?",
            "nextDialogs": [
              "750000624"
            ]
          },
          "750000624": {
            "id": "750000624",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What about relatives, then? ...Oh, wait... That big guy from earlier...",
            "nextDialogs": [
              "750000625"
            ]
          },
          "750000625": {
            "id": "750000625",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#What do we do, {NICKNAME}? We can't just leave it here all by itself, right?",
            "nextDialogs": [
              "750000626"
            ]
          },
          "750000626": {
            "id": "750000626",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Wrroh...",
            "nextDialogs": [
              "750000627"
            ]
          },
          "750000627": {
            "id": "750000627",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It might be better if you stay with us for a while...",
            "nextDialogs": [
              "750000628"
            ]
          },
          "750000628": {
            "id": "750000628",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yeah, that makes sense. Maybe we'll find this little guy's family when we reach Natlan... But we've never seen anything like it...",
            "nextDialogs": [
              "750000629"
            ]
          },
          "750000629": {
            "id": "750000629",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ah. \"Chosen of... Dragons...\" Could that mean...?",
            "nextDialogs": [
              "750000630"
            ]
          },
          "750000630": {
            "id": "750000630",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh. You mean you heard something like that?",
            "nextDialogs": [
              "750000631"
            ]
          },
          "750000631": {
            "id": "750000631",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Now that Paimon thinks about it, Natlan is the \"nation of dragons\"... So, does that mean that... wait, they call little guys like this 'Saurians' around here, right?",
            "nextDialogs": [
              "750000632"
            ]
          },
          "750000632": {
            "id": "750000632",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Rawoo...",
            "nextDialogs": [
              "750000633"
            ]
          },
          "750000633": {
            "id": "750000633",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Come to think of it, Paimon does see some resemblance to vishaps. Y'know... Two legs, one tail, and all.",
            "nextDialogs": [
              "750000634"
            ]
          },
          "750000634": {
            "id": "750000634",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Rraaa?",
            "nextDialogs": [
              "750000635"
            ]
          },
          "750000635": {
            "id": "750000635",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We're happy to have it travel with us...",
            "nextDialogs": [
              "750000636"
            ]
          },
          "750000636": {
            "id": "750000636",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But we should ask our friend here if that's what it wants to do first.",
            "nextDialogs": [
              "750000637"
            ]
          },
          "750000637": {
            "id": "750000637",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "True, true. Hey there, little guy. Would you like to travel with us?",
            "nextDialogs": [
              "750000638"
            ]
          },
          "750000638": {
            "id": "750000638",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "...",
            "nextDialogs": [
              "750000639"
            ]
          },
          "750000639": {
            "id": "750000639",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Rrawr!",
            "nextDialogs": [
              "750000640"
            ]
          },
          "750000640": {
            "id": "750000640",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hehe! Looks like we're all agreed then. Anyway, Paimon's Paimon, and {M#he's}{F#she's} {NICKNAME}!",
            "nextDialogs": [
              "750000641"
            ]
          },
          "750000641": {
            "id": "750000641",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Wrraa? Rawr...",
            "nextDialogs": [
              "750000642"
            ]
          },
          "750000642": {
            "id": "750000642",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, yeah, you need a name too... Let Paimon think. Right! Since you're yellow and brown all over, let's call you \"Hash Brown\"!",
            "nextDialogs": [
              "750000643"
            ]
          },
          "750000643": {
            "id": "750000643",
            "speakerId": 1004,
            "speakerName": "Hash Brown?",
            "text": "Rroooo... Rraaaa...",
            "nextDialogs": [
              "750000645"
            ]
          },
          "750000645": {
            "id": "750000645",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You mean people wouldn't like it anywhere else?",
            "nextDialogs": [
              "750000647"
            ]
          },
          "750000647": {
            "id": "750000647",
            "speakerId": 21619,
            "speakerName": "Little Guy?",
            "text": "Rroo...",
            "nextDialogs": [
              "750000648"
            ]
          },
          "750000648": {
            "id": "750000648",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Would you like {NICKNAME} to give you a name, then? Well... not that Paimon can vouch for {M#his}{F#her} naming sense, though."
          }
        }
      }
    },
    {
      "subId": "7500007",
      "subQuestName": "Give the little one an awesome new name!",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

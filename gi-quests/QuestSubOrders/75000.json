    {
      "subId": "7500001",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750000101"
        ],
        "dialogs": {
          "750000101": {
            "id": "750000101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey, hey, big guy... You okay? Can you stand?",
            "nextDialogs": [
              "750000102"
            ]
          },
          "750000102": {
            "id": "750000102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh no, it looks really weak. Ugh, seriously! Those floaty ghostly dogs are always up to no good... In fact, make that all things floaty!",
            "nextDialogs": [
              "750000103"
            ]
          },
          "750000103": {
            "id": "750000103",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You're fairly floaty, as floaty things go...",
            "nextDialogs": [
              "750000104"
            ]
          },
          "750000104": {
            "id": "750000104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's nothing like those guys!",
            "nextDialogs": [
              "750000105"
            ]
          },
          "750000105": {
            "id": "750000105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Anyway, forget that for now. Let's see if we can get this guy something to eat, and then... We'll let it rest for a while.",
            "nextDialogs": [
              "750000106"
            ]
          },
          "750000106": {
            "id": "750000106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It'll be feeling better soon, Paimon's sure of it!",
            "nextDialogs": [
              "750000109"
            ]
          },
          "750000109": {
            "id": "750000109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "No...",
            "nextDialogs": [
              "750000110"
            ]
          },
          "750000110": {
            "id": "750000110",
            "speakerId": 21523,
            "speakerName": "Big Guy?",
            "text": "...*heavy breathing*",
            "nextDialogs": [
              "750000111"
            ]
          },
          "750000111": {
            "id": "750000111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Oh no. It must be in so much pain, {NICKNAME}..."
          }
        }
      }
    },

    {
      "subId": "7500009",
      "subQuestName": "Talk to your Saurian companion",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "750000901"
        ],
        "dialogs": {
          "750000901": {
            "id": "750000901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}. That'll be your name from now on, little guy!",
            "nextDialogs": [
              "750000902"
            ]
          },
          "750000902": {
            "id": "750000902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}...",
            "nextDialogs": [
              "750000903"
            ]
          },
          "750000903": {
            "id": "750000903",
            "speakerId": 21460,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "...Rawr!",
            "nextDialogs": [
              "750000904"
            ]
          },
          "750000904": {
            "id": "750000904",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Looks like our little friend loves this name! Well, with any luck, we'll solve the mystery that surrounds you while we're in Natlan... Ah, and maybe we'll get some clues as to why {NICKNAME} was able to suddenly enter that Saurian's body...",
            "nextDialogs": [
              "750000905"
            ]
          },
          "750000905": {
            "id": "750000905",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Oh yeah, are you okay, by the way, {NICKNAME}? You suddenly turned into a Saurian back there... Are you feeling uncomfortable in any way?",
            "nextDialogs": [
              "750000907",
              "750000909"
            ]
          },
          "750000907": {
            "id": "750000907",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's that even supposed to mean!? This isn't the time for jokes!",
            "nextDialogs": [
              "750000910"
            ]
          },
          "750000910": {
            "id": "750000910",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Still, {NICKNAME}, Paimon's never heard of anyone in Natlan who can turn into a Saurian... This is kinda weird.",
            "nextDialogs": [
              "750000911"
            ]
          },
          "750000911": {
            "id": "750000911",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Seriously, we only just got here, and it feels like so much has already happened... Anyway, how do we get outta here?",
            "nextDialogs": [
              "750000912"
            ]
          },
          "750000912": {
            "id": "750000912",
            "speakerId": 21460,
            "speakerName": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
            "text": "Rawr!",
            "nextDialogs": [
              "750000913"
            ]
          },
          "750000913": {
            "id": "750000913",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm? You know where the exit is?"
          },
          "750000909": {
            "id": "750000909",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, it'd best stay that way! Things could go south real fast if some day you were to turn into a Saurian and be unable to transform back..."
          }
        }
      }
    },
    {
      "subId": "7500011",
      "subQuestName": "Follow your Saurian companion",
      "sceneId": null,

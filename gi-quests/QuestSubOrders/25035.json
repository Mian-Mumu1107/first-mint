    {
      "subId": "2503507",
      "subQuestName": "Report back to Michica",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250350701"
        ],
        "dialogs": {
          "250350701": {
            "id": "250350701",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "So, how did it go? Did you manage to find the packages?"
          }
        }
      }
    },
    {
      "subId": "2503508",
      "subQuestName": "Talk to Michica",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250350801"
        ],
        "dialogs": {
          "250350801": {
            "id": "250350801",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "Two... Three... That's all of them! Excellent job, you retrieved them all.",
            "nextDialogs": [
              "250350802"
            ]
          },
          "250350802": {
            "id": "250350802",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "...Wait a sec, wasn't this one meant to be delivered by Tundama?",
            "nextDialogs": [
              "250350803"
            ]
          },
          "250350803": {
            "id": "250350803",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "Here's your payment. Thanks for the help!",
            "nextDialogs": [
              "250350804"
            ]
          },
          "250350804": {
            "id": "250350804",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "Agh, I'm gonna have to have a serious one-to-one with Tundama about this..."
          }
        }
      }
    },
    {
      "subId": "2503511",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250351101"
        ],
        "dialogs": {
          "250351101": {
            "id": "250351101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "See you.",
            "nextDialogs": [
              "250351102"
            ]
          },
          "250351102": {
            "id": "250351102",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "I'm counting on you to find the packages. I still have to sort through all the ones in the shop. *sigh* When will those kids start behaving like professionals..."
          }
        }
      }
    }

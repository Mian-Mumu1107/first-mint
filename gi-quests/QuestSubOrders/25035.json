  "subQuests": [
    {
      "subId": "2503501",
      "subQuestName": "Talk to Michica",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250350101"
        ],
        "dialogs": {
          "250350101": {
            "id": "250350101",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "Those bumbling fools... How've they lost another load of packages? I told them not to mess about when they're out delivering things...",
            "nextDialogs": [
              "250350102"
            ]
          },
          "250350102": {
            "id": "250350102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happened?",
            "nextDialogs": [
              "250350103"
            ]
          },
          "250350103": {
            "id": "250350103",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "A few of our Couriers ignored instructions yet again, and guess what? They've gone and lost a bunch of packages.",
            "nextDialogs": [
              "250350104"
            ]
          },
          "250350104": {
            "id": "250350104",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "*sigh* Don't they realize that such carelessness damages the reputation of the Scions of the Canopy?",
            "nextDialogs": [
              "250350105"
            ]
          },
          "250350105": {
            "id": "250350105",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "When you're out on the job, focus on delivering things! If you're going down a slope, just keep going as you normally would. Why would you suddenly drop into a slide like you're on vacation!?",
            "nextDialogs": [
              "250350106"
            ]
          },
          "250350106": {
            "id": "250350106",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "I've told them so many times, but those youngsters just won't listen. All they care about is chasing cheap thrills...",
            "nextDialogs": [
              "250350107"
            ]
          },
          "250350107": {
            "id": "250350107",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "*sigh* Now I'll have to get someone to retrieve those packages. Let me think, who's free right now...",
            "nextDialogs": [
              "250350109",
              "250350112"
            ]
          },
          "250350109": {
            "id": "250350109",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "Y—You'd really help me out? That's great!",
            "nextDialogs": [
              "250350110"
            ]
          },
          "250350110": {
            "id": "250350110",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "It would take me quite a while to find someone who could help, and if I went looking myself, there'd be no one here to watch over the Courier's Longhouse.",
            "nextDialogs": [
              "250350117"
            ]
          },
          "250350117": {
            "id": "250350117",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "And don't worry, I wouldn't just leave you to find a needle in a haystack. I know the routes those kids usually take, so I can probably guess where those packages went missing.",
            "nextDialogs": [
              "250350118"
            ]
          },
          "250350118": {
            "id": "250350118",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "I'll mark out those probable locations. Thanks in advance. I'm counting on you!"
          },
          "250350112": {
            "id": "250350112",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "No, they're not. But that's what makes them a real hassle to find. *sigh* Those careless little...",
            "nextDialogs": [
              "250350113"
            ]
          },
          "250350113": {
            "id": "250350113",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "...So, if you have the time, would you be willing to help me track them down?",
            "nextDialogs": [
              "250350114"
            ]
          },
          "250350114": {
            "id": "250350114",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "The Courier's Longhouse is a bit short on manpower right now, so if I went to find them myself, there'd be no one here to man the store.",
            "nextDialogs": [
              "250350115"
            ]
          },
          "250350115": {
            "id": "250350115",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "No problem, leave it to me.",
            "nextDialogs": [
              "250350116"
            ]
          },
          "250350116": {
            "id": "250350116",
            "speakerId": 1000,
            "speakerName": "Michica",
            "text": "That's amazing! Thank you so much!"
          }
        }
      }
    },
    {
      "subId": "2503502",
      "subQuestName": "Track down the missing packages",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [

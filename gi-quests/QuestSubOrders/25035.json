        ],
        "dialogs": {
          "250350201": {
            "id": "250350201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Based on the marks Michica made for us, those packages should be somewhere nearby.",
            "nextDialogs": [
              "250350202"
            ]
          },
          "250350202": {
            "id": "250350202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's have a closer look around. Hmm, where could they be..."
          }
        }
      }
    },
    {

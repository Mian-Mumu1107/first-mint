            ]
          },
          "740310304": {
            "id": "740310304",
            "speakerId": 5251,
            "speakerName": "Nizami",
            "text": "It seems I need to work harder.",
            "nextDialogs": [
              "740310307"
            ]
          },
          "740310307": {
            "id": "740310307",
            "speakerId": 5251,
            "speakerName": "Nizami",
            "text": "Anyway, I'm a straight-shooter, just like you. Here are your Coupons. Let's do this again sometime!"
          },
          "740310306": {
            "id": "740310306",
            "speakerId": 5251,
            "speakerName": "Nizami",
            "text": "#You don't mince your words, {M#lad}{F#lass}. I like that!"
          }
        }
      }

            ]
          },
          "740310302": {
            "id": "740310302",
            "speakerId": 5251,
            "speakerName": "Nizami",
            "text": "#I knew it, {M#lad}{F#lass}! You're a worthy opponent!",
            "nextDialogs": [
              "740310304",

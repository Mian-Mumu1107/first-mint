      "dialogue": {
        "startDialogs": [
          "740310101"
        ],
        "dialogs": {
          "740310101": {
            "id": "740310101",
            "speakerId": 5251,
            "speakerName": "Nizami",
            "text": "Young warrior, will you spar with me?",
            "nextDialogs": [
              "740310102"
            ]
          },
          "740310102": {
            "id": "740310102",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uh, this is super sudden...",
            "nextDialogs": [
              "740310103"
            ]
          },
          "740310103": {
            "id": "740310103",
            "speakerId": 5251,
            "speakerName": "Nizami",
            "text": "#Whatever you say, {M#lad}{F#lass} with golden hair. I can tell that you're a veteran with just one look.",
            "nextDialogs": [
              "740310104"
            ]
          },
          "740310104": {
            "id": "740310104",
            "speakerId": 5251,
            "speakerName": "Nizami",
            "text": "I'm really bored, because no one has been sparring with me. If you will, I'll give you Coupons! I won a lot of those from Roussimoff, and I haven't figured out how to spend them yet.",
            "nextDialogs": [
              "740310105"
            ]
          },
          "740310105": {
            "id": "740310105",
            "speakerId": 5251,
            "speakerName": "Nizami",
            "text": "How about it?"
          }
        }
      }
    },
    {
      "subId": "7403181",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740318101"
        ],
        "dialogs": {
          "740318101": {
            "id": "740318101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'm a pacifist, and I don't like to fight.",
            "nextDialogs": [
              "740318102"
            ]
          },
          "740318102": {
            "id": "740318102",
            "speakerId": 5251,
            "speakerName": "Nizami",
            "text": "A pacifist that fights violence with violence? To each their own, I guess.",
            "nextDialogs": [
              "740318103"
            ]
          },
          "740318103": {
            "id": "740318103",
            "speakerId": 5251,
            "speakerName": "Nizami",
            "text": "But this is not a fight, we're just sparring. We spar to better protect the peace. So if you're that sort of pacifist, we should definitely spar!",
            "nextDialogs": [
              "740318104"
            ]
          },
          "740318104": {
            "id": "740318104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "You have a point. Let's go!",
            "nextDialogs": [
              "740318105"
            ]
          },
          "740318105": {
            "id": "740318105",
            "speakerId": 5251,
            "speakerName": "Nizami",
            "text": "Ha! Very good!",
            "nextDialogs": [
              "740318106"
            ]
          },
          "740318106": {
            "id": "740318106",
            "speakerId": 5251,
            "speakerName": "Nizami",
            "text": "Let's go somewhere spacious!"
          }
        }
      }

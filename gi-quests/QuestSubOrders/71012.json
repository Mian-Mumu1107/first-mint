      "dialogue": {
        "startDialogs": [
          "710120101"
        ],
        "dialogs": {
          "710120101": {
            "id": "710120101",
            "speakerId": 1000,
            "speakerName": "Ravaged Carving",
            "text": "\"Stories brought on the wind will bloom into legends in due time.\"",
            "nextDialogs": [
              "710120102"
            ]
          },
          "710120102": {
            "id": "710120102",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What does this even mean? ...Paimon has no idea.",
            "nextDialogs": [
              "710120103"
            ]
          },
          "710120103": {
            "id": "710120103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Still, this place looks like it hides some secret...",
            "nextDialogs": [
              "710120104"
            ]
          },
          "710120104": {
            "id": "710120104",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Let's check this area out. We might find some clues!"
          }
        }
      }
    },
    {
      "subId": "7101202",
      "subQuestName": "Disperse the cluster of wind",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710120201"
        ],
        "dialogs": {
          "710120201": {
            "id": "710120201",
            "speakerId": 1000,
            "speakerName": "Ravaged Carving",
            "text": "\"Stories brought on the wind will bloom into legends in due time.\"",
            "nextDialogs": [
              "710120202"
            ]
          },
          "710120202": {
            "id": "710120202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "This must be the sundial mentioned in the notebook!",
            "nextDialogs": [
              "710120203"
            ]
          },
          "710120203": {
            "id": "710120203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon doesn't get what's special about it, though...",
            "nextDialogs": [
              "710120204"
            ]
          },
          "710120204": {
            "id": "710120204",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Maybe we should read that notebook a bit more carefully."
          }
        }
      }
    },

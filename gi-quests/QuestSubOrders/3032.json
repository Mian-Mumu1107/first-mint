    {
      "subId": "303208",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30320801"
        ],
        "dialogs": {
          "30320801": {
            "id": "30320801",
            "speakerId": 1002,
            "speakerName": "Wanderer",
            "text": "You can't be serious.",
            "nextDialogs": [
              "30321201"
            ]
          },
          "30321201": {
            "id": "30321201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Hmm, let me give it some more thought.",
            "nextDialogs": [
              "30321202"
            ]
          },
          "30321202": {
            "id": "30321202",
            "speakerId": 1002,
            "speakerName": "Wanderer",
            "text": "Okay."
          }
        }
      }
    },
    {
      "subId": "303209",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30320901"
        ],
        "dialogs": {
          "30320901": {
            "id": "30320901",
            "speakerId": 1002,
            "speakerName": "Wanderer",
            "text": "Is this supposed to be your attempt at a joke?"
          }
        }
      }
    },
    {
      "subId": "303210",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30321001"
        ],
        "dialogs": {
          "30321001": {
            "id": "30321001",
            "speakerId": 1002,
            "speakerName": "Wanderer",
            "text": "...Hmph. I have no need for these names anymore."
          }
        }
      }
    },
    {
      "subId": "303211",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30321101"
        ],
        "dialogs": {
          "30321101": {
            "id": "30321101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes. I think this will do.",
            "nextDialogs": [
              "30321102"
            ]
          },
          "30321102": {
            "id": "30321102",
            "speakerId": 1002,
            "speakerName": "Wanderer",
            "text": "...Ah, alright, if you say so."
          }
        }
      }
    },
    {
      "subId": "303213",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30321301"
        ],
        "dialogs": {
          "30321301": {
            "id": "30321301",
            "speakerId": 1002,
            "speakerName": "Wanderer",
            "text": "That won't work."
          }
        }
      }
    },
    {
      "subId": "303214",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30321401"
        ],
        "dialogs": {
          "30321401": {
            "id": "30321401",
            "speakerId": 1002,
            "speakerName": "Wanderer",
            "text": "...This is a bad idea."
          }
        }
      }
    },
    {
      "subId": "303215",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30321501"
        ],
        "dialogs": {
          "30321501": {
            "id": "30321501",
            "speakerId": 1002,
            "speakerName": "Wanderer",
            "text": "You want to share your name with me? Huh, not a bad choice."
          }
        }
      }
    },
    {
      "subId": "303216",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30321601"
        ],
        "dialogs": {
          "30321601": {
            "id": "30321601",
            "speakerId": 1002,
            "speakerName": "Wanderer",
            "text": "Are you sure?"
          }
        }
      }
    },
    {
      "subId": "303220",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30322001"
        ],
        "dialogs": {
          "30322001": {
            "id": "30322001",
            "speakerId": 1003,
            "speakerName": "Sawada",
            "text": "Aqaba, thanks for inviting me to research together!",
            "nextDialogs": [
              "30322002"
            ]
          },
          "30322002": {
            "id": "30322002",
            "speakerId": 1004,
            "speakerName": "Aqaba",
            "text": "Of course, Sawada. Your creativity has been indispensable to me. Without you, I'd have scratched my head bald by now."
          }
        }
      }
    },
    {
      "subId": "303221",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30322101"
        ],
        "dialogs": {
          "30322101": {
            "id": "30322101",
            "speakerId": 1000,
            "speakerName": "Nahida",
            "text": "Thank you so much. Please get some good rest, you must be exhausted. You know, take a shower, take a dook-dook... you'll feel as good as new."
          }
        }
      }
    },
    {
      "subId": "303298",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "30329801"
        ],
        "dialogs": {
          "30329801": {
            "id": "30329801",
            "speakerId": 1003,
            "speakerName": "Sawada",
            "text": "(I guess the sword that entered Mikoshi Nagamasa's memory in his final moments was called Daitatara Nagamasa instead of Katsuragikiri Nagamasa because he still had fond memories of it.)",
            "nextDialogs": [
              "30329802"
            ]
          },
          "30329802": {
            "id": "30329802",
            "speakerId": 1004,
            "speakerName": "Aqaba",
            "text": "(I feel like you've enlightened me. I can finally finish my essay! Hahaha!)",
            "nextDialogs": [
              "30329803"
            ]
          },
          "30329803": {
            "id": "30329803",
            "speakerId": 1002,
            "speakerName": "Wanderer",
            "text": "(It feels like... I've lived two lives.)",
            "nextDialogs": [
              "30329804"
            ]
          },
          "30329804": {
            "id": "30329804",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": ""
          }
        }
      }
    }
  ]

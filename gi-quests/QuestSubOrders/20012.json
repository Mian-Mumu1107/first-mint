          "200120201"
        ],
        "dialogs": {
          "200120201": {
            "id": "200120201",
            "speakerId": 157001,
            "speakerName": "Panicked Myrana",
            "text": "Th—Thank you, Traveler...",
            "nextDialogs": [
              "200120202"
            ]
          },
          "200120202": {
            "id": "200120202",
            "speakerId": 157001,
            "speakerName": "Panicked Myrana",
            "text": "*sigh* First monsters, now this roadblock... It's hectic enough already back home, there was me thinking this would be a chance to get away from it all for a while!",
            "nextDialogs": [
              "200120203"
            ]
          },
          "200120203": {
            "id": "200120203",
            "speakerId": 157001,
            "speakerName": "Panicked Myrana",
            "text": "I'm sorry, but is there any chance you could sort out this roadblock situation for me?",
            "nextDialogs": [
              "200120206",
              "200120207"
            ]
          },
          "200120206": {
            "id": "200120206",
            "speakerId": 157001,
            "speakerName": "Panicked Myrana",
            "text": "Thank you! I hope my two young ones grow up to be kind like you."
          },
          "200120207": {
            "id": "200120207",
            "speakerId": 157001,
            "speakerName": "Panicked Myrana",
            "text": "Come on, please... I promise it won't take you too long."
          }
        }
      }
    },
    {
      "subId": "2001203",
      "subQuestName": "Defeat all opponents and destroy the roadblocks",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200120301"
        ],
        "dialogs": {
          "200120301": {
            "id": "200120301",
            "speakerId": 1570,
            "speakerName": "Panicked Myrana",
            "text": "Th—Thanks so much, Traveler.",
            "nextDialogs": [
              "200120302"
            ]
          },
          "200120302": {
            "id": "200120302",
            "speakerId": 1570,
            "speakerName": "Panicked Myrana",
            "text": "But please, don't tell anybody I got myself into trouble. My husband will give me an earful if he finds out...",
            "nextDialogs": [
              "200120303"
            ]
          },
          "200120303": {
            "id": "200120303",
            "speakerId": 1570,
            "speakerName": "Panicked Myrana",
            "text": "Don't look at me like that... Wait till you're married, you'll see. A solitary stroll is a huge luxury when you're living with someone, you've got to make the most of it.",
            "nextDialogs": [
              "200120304"
            ]
          },
          "200120304": {
            "id": "200120304",
            "speakerId": 1570,
            "speakerName": "Panicked Myrana",
            "text": "Here, take this. I picked some while I was out. Much cheaper to cook for yourself than eat at Good Hunter! You have to scrimp and save if you want to get by."
          }
        }
      }
    },

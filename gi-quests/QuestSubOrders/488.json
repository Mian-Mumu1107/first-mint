  "subQuests": [
    {
      "subId": "48800",
      "subQuestName": "Find Charles and ask about his commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4880001"
        ],
        "dialogs": {
          "4880001": {
            "id": "4880001",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Lisa? Are you here about the tax return?",
            "nextDialogs": [
              "4880002"
            ]
          },
          "4880002": {
            "id": "4880002",
            "speakerId": 1001,
            "speakerName": "Lisa",
            "text": "Oh, hello darling. You're quite right. After I heard about poor Jean, I thought I might lend a hand with some of her more literary duties.",
            "nextDialogs": [
              "4880003"
            ]
          },
          "4880003": {
            "id": "4880003",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Cool, well if we're no longer needed here, we'll be on our way.",
            "nextDialogs": [
              "4880004"
            ]
          },
          "4880004": {
            "id": "4880004",
            "speakerId": 1001,
            "speakerName": "Lisa",
            "text": "Oh wait a moment... Actually, Charles here was wondering—",
            "nextDialogs": [
              "4880005"
            ]
          },
          "4880005": {
            "id": "4880005",
            "speakerId": 1002,
            "speakerName": "Charles",
            "text": "Please, allow me, ma'am.",
            "nextDialogs": [
              "4880006"
            ]
          },
          "4880006": {
            "id": "4880006",
            "speakerId": 1002,
            "speakerName": "Charles",
            "text": "I just took a rather important order, but unfortunately we've run completely dry and the delivery from the winery is behind schedule.",
            "nextDialogs": [
              "4880007"
            ]
          },
          "4880007": {
            "id": "4880007",
            "speakerId": 1002,
            "speakerName": "Charles",
            "text": "If it's not too much trouble, could you go and <color=#00E1FFFF>do something about this logistical nuisance</color>?",
            "nextDialogs": [
              "4880008"
            ]
          },
          "4880008": {
            "id": "4880008",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "What's so urgent about this order?",
            "nextDialogs": [
              "4880009"
            ]
          },
          "4880009": {
            "id": "4880009",
            "speakerId": 1002,
            "speakerName": "Charles",
            "text": "*sigh* It came in at the last minute. Literally, just a few seconds ago.",
            "nextDialogs": [
              "4880010"
            ]
          },
          "4880010": {
            "id": "4880010",
            "speakerId": 1001,
            "speakerName": "Lisa",
            "text": "Exactly, hence the urgency.",
            "nextDialogs": [
              "4880011"
            ]
          },
          "4880011": {
            "id": "4880011",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Okay, I'll see what I can do.",
            "nextDialogs": [
              "4880012"
            ]
          },
          "4880012": {
            "id": "4880012",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Okay, but my next drink here had better be on the house!",
            "nextDialogs": [
              "4880013"
            ]
          },
          "4880013": {
            "id": "4880013",
            "speakerId": 1002,
            "speakerName": "Charles",
            "text": "Heh... I'm positive that next time my boss Master Diluc is here, he'll pick up the tab for you.",
            "nextDialogs": [
              "4880014"
            ]
          },
          "4880014": {
            "id": "4880014",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Sounds about right!"
          }
        }
      }
    },
    {
      "subId": "48801",
      "subQuestName": "Talk to Ernest",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4880101"
        ],
        "dialogs": {
          "4880101": {
            "id": "4880101",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "So this is where Charles' delivery got to.",
            "nextDialogs": [
              "4880102"
            ]
          },
          "4880102": {
            "id": "4880102",
            "speakerId": 1003,
            "speakerName": "Ernest",
            "text": "Have you come to rescue me? I've been waiting long enough.",
            "nextDialogs": [
              "4880103"
            ]
          },
          "4880103": {
            "id": "4880103",
            "speakerId": 1003,
            "speakerName": "Ernest",
            "text": "In all the time I've been working at the winery, this is the first time I've been robbed by hilichurls. *sigh*",
            "nextDialogs": [
              "4880104"
            ]
          },
          "4880104": {
            "id": "4880104",
            "speakerId": 1003,
            "speakerName": "Ernest",
            "text": "If you'd taken any longer, I don't know what I would have done.",
            "nextDialogs": [
              "4880105"
            ]
          },
          "4880105": {
            "id": "4880105",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#Fear not. {NICKNAME} here is a hilichurl exterminator extraordinaire!",
            "nextDialogs": [
              "4880106"
            ]
          },
          "4880106": {
            "id": "4880106",
            "speakerId": 1003,
            "speakerName": "Ernest",
            "text": "Just as well. Then... please escort this <color=#00E1FFFF>transporter</color> to the end of the road.",
            "nextDialogs": [
              "4880107"
            ]
          },
          "4880107": {
            "id": "4880107",
            "speakerId": 1003,
            "speakerName": "Ernest",
            "text": "And be careful with it. Just beating up the hilichurls is the not the aim here. You'd better <color=#00E1FFFF>make sure the goods stay intact</color> because I certainly don't have the Mora to replace them.",
            "nextDialogs": [
              "4880108"
            ]
          },
          "4880108": {
            "id": "4880108",
            "speakerId": 1003,
            "speakerName": "Ernest",
            "text": "I'll be waiting up ahead."
          }
        }
      }
    },
    {
      "subId": "48802",
      "subQuestName": "Escort the transport balloon.",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "48804",
      "subQuestName": "Escort the transport balloon.",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4880401"
        ],
        "dialogs": {
          "4880401": {
            "id": "4880401",
            "speakerId": 1002,
            "speakerName": "Charles",
            "text": "It's not uncommon for delivery workers to take a couple of bottles for themselves and make a bit of extra cash on the side. But obviously you don't seem like the type."
          }
        }
      }
    },
    {
      "subId": "48803",
      "subQuestName": "Complete Charles' commission",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "4880301"
        ],
        "dialogs": {
          "4880301": {
            "id": "4880301",
            "speakerId": 1003,
            "speakerName": "Ernest",
            "text": "Thank you, my friend. I thought I was in deep trouble this time. It's a good thing you showed up.",
            "nextDialogs": [
              "4880302"
            ]
          },
          "4880302": {
            "id": "4880302",
            "speakerId": 1003,
            "speakerName": "Ernest",
            "text": "I'll put in a good word for you with the gentlemen at the winery."
          }
        }
      }
    }
  ]
}
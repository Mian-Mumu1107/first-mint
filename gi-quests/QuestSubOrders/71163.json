    {
      "subId": "7116302",
      "subQuestName": "Go to Baiju Guesthouse",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711630201"
        ],
        "dialogs": {
          "711630201": {
            "id": "711630201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It doesn't look like Zibai's here... And after she invited us to come, too! Where could she have run off to?",
            "nextDialogs": [
              "711630202"
            ]
          },
          "711630202": {
            "id": "711630202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh! This parasol looks familiar... Have we seen it somewhere before?",
            "nextDialogs": [
              "711630203"
            ]
          },
          "711630203": {
            "id": "711630203",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Maybe it belongs to her.",
            "nextDialogs": [
              "711630204"
            ]
          },
          "711630204": {
            "id": "711630204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're probably right... But why would she leave her parasol here by the door?",
            "nextDialogs": [
              "711630205"
            ]
          },
          "711630205": {
            "id": "711630205",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She does have a pretty poor memory...",
            "nextDialogs": [
              "711630206"
            ]
          },
          "711630206": {
            "id": "711630206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What are we going to do? The way things are going, Paimon's worried she'll get halfway through eating and forget how to pick up her chopsticks...",
            "nextDialogs": [
              "711630207"
            ]
          },
          "711630207": {
            "id": "711630207",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "*sigh* We should go find her.",
            "nextDialogs": [
              "711630208"
            ]
          },
          "711630208": {
            "id": "711630208",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Wait a moment... I'm not sure this is really a parasol.",
            "nextDialogs": [
              "711630209"
            ]
          },
          "711630209": {
            "id": "711630209",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? What is it, then? Hmm... Let Paimon take a closer look...",
            "nextDialogs": [
              "711630210"
            ]
          },
          "711630210": {
            "id": "711630210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa!"
          }
        }
      }
    },
    {
      "subId": "7116303",
      "subQuestName": "Talk to Zibai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "711630301"
        ],
        "dialogs": {
          "711630301": {
            "id": "711630301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What's going on? How did we end up here?",
            "nextDialogs": [
              "711630302"
            ]
          },
          "711630302": {
            "id": "711630302",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "So, how do you like the little trinket I made for you?",
            "nextDialogs": [
              "711630303"
            ]
          },
          "711630303": {
            "id": "711630303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So this is where you are, Zibai! What's this parasol? It suddenly went \"whoosh\" and transported us here!",
            "nextDialogs": [
              "711630304"
            ]
          },
          "711630304": {
            "id": "711630304",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "It seems I'm not the only one who struggles to remember things. Have you already forgotten riding on it with me before?",
            "nextDialogs": [
              "711630305"
            ]
          },
          "711630305": {
            "id": "711630305",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "Does that jog your memory?",
            "nextDialogs": [
              "711630306"
            ]
          },
          "711630306": {
            "id": "711630306",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh! It's... It's the lunar chariot! No wonder it looked so familiar...",
            "nextDialogs": [
              "711630307"
            ]
          },
          "711630307": {
            "id": "711630307",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "Haha, it's just a replica created from my memories.",
            "nextDialogs": [
              "711630308"
            ]
          },
          "711630308": {
            "id": "711630308",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "And it's all thanks to the broken jade token you returned to me.",
            "nextDialogs": [
              "711630309"
            ]
          },
          "711630309": {
            "id": "711630309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh! So this is the little trinket you were planning to make!",
            "nextDialogs": [
              "711630310"
            ]
          },
          "711630310": {
            "id": "711630310",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "Precisely. This jade-token chariot can quickly transport you wherever you wish to go, which should help your travels unfold more smoothly.",
            "nextDialogs": [
              "711630311"
            ]
          },
          "711630311": {
            "id": "711630311",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "Please take it, my dutiful guides.",
            "nextDialogs": [
              "711630312"
            ]
          },
          "711630312": {
            "id": "711630312",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, this is amazing... Paimon thought you were saying all that \"making a trinket\" stuff to be nice — she never expected you'd actually do it!",
            "nextDialogs": [
              "711630313"
            ]
          },
          "711630313": {
            "id": "711630313",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "I had expected it to take some time, considering how badly the token was damaged — its spiritual energy was completely gone.",
            "nextDialogs": [
              "711630314"
            ]
          },
          "711630314": {
            "id": "711630314",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "But fortunately for us, this is Chenyu Vale.",
            "nextDialogs": [
              "711630315"
            ]
          },
          "711630315": {
            "id": "711630315",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? What's so special about it?",
            "nextDialogs": [
              "711630316"
            ]
          },
          "711630316": {
            "id": "711630316",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "Do you know exactly where about we are in the vale?",
            "nextDialogs": [
              "711630317"
            ]
          },
          "711630317": {
            "id": "711630317",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Uhm... Yilong Wharf?",
            "nextDialogs": [
              "711630318"
            ]
          },
          "711630318": {
            "id": "711630318",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "Hehe, you have much to learn about this place.",
            "nextDialogs": [
              "711630319"
            ]
          },
          "711630319": {
            "id": "711630319",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "The ground beneath our feet is actually one of the key intersections in Liyue's Ley Lines. There are eight such nodes in total...",
            "nextDialogs": [
              "711630320"
            ]
          },
          "711630320": {
            "id": "711630320",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Life, Death, Repose, Concealment, Initiation, Terrain, Fright, and Injury.",
            "nextDialogs": [
              "711630321"
            ]
          },
          "711630321": {
            "id": "711630321",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "You're more familiar with this place than I expected...",
            "nextDialogs": [
              "711630322"
            ]
          },
          "711630322": {
            "id": "711630322",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh! Paimon remembers now. You're talking about the eight gates!",
            "nextDialogs": [
              "711630323"
            ]
          },
          "711630323": {
            "id": "711630323",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "Correct. Where we stand right now is the center of the most auspicious of those gates — the Gate of Life.",
            "nextDialogs": [
              "711630324"
            ]
          },
          "711630324": {
            "id": "711630324",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "The Gate of Life symbolizes growth, prosperity, and revitalization. Thus, I was able to replenish the jade token's spiritual energy so quickly and craft this chariot.",
            "nextDialogs": [
              "711630325"
            ]
          },
          "711630325": {
            "id": "711630325",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, talk about a power-packed position! Guess Chenyu Vale really is a land of wonders...",
            "nextDialogs": [
              "711630326"
            ]
          },
          "711630326": {
            "id": "711630326",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "Indeed... You would do well to settle here in peace and prosperity...",
            "nextDialogs": [
              "711630327"
            ]
          },
          "711630327": {
            "id": "711630327",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Whaddya mean \"you\"...?",
            "nextDialogs": [
              "711630328"
            ]
          },
          "711630328": {
            "id": "711630328",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "It's nothing...",
            "nextDialogs": [
              "711630329"
            ]
          },
          "711630329": {
            "id": "711630329",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "Alright, I have done all I wished to do. You may go about your business.",
            "nextDialogs": [
              "711630330"
            ]
          },
          "711630330": {
            "id": "711630330",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "I plan to take a stroll atop the mountain. This is where we part ways.",
            "nextDialogs": [
              "711630331"
            ]
          },
          "711630331": {
            "id": "711630331",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thank you, Zibai.",
            "nextDialogs": [
              "711630332"
            ]
          },
          "711630332": {
            "id": "711630332",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "No need to thank me. You woke me from my slumber — it is I who am in your debt.",
            "nextDialogs": [
              "711630333"
            ]
          },
          "711630333": {
            "id": "711630333",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It was all Zhongli's doing, really.",
            "nextDialogs": [
              "711630334"
            ]
          },
          "711630334": {
            "id": "711630334",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "And I have told him much the same as I've said to you.",
            "nextDialogs": [
              "711630335"
            ]
          },
          "711630335": {
            "id": "711630335",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "He mentioned that you're on a long journey...",
            "nextDialogs": [
              "711630336"
            ]
          },
          "711630336": {
            "id": "711630336",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "Does your next stop happen to be a distant land of snow?",
            "nextDialogs": [
              "711630337"
            ]
          },
          "711630337": {
            "id": "711630337",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Yes, we're heading to Snezhnaya.",
            "nextDialogs": [
              "711630338"
            ]
          },
          "711630338": {
            "id": "711630338",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "Snezhnaya... Hmm, although I know nothing about the place, no journey through ice and snow is without its dangers.",
            "nextDialogs": [
              "711630339"
            ]
          },
          "711630339": {
            "id": "711630339",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "If you find yourselves in need of help, you know where to find me.",
            "nextDialogs": [
              "711630340"
            ]
          },
          "711630340": {
            "id": "711630340",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I know.",
            "nextDialogs": [
              "711630341"
            ]
          },
          "711630341": {
            "id": "711630341",
            "speakerId": 1323,
            "speakerName": "Zibai",
            "text": "Take care."
          }
        }
      }
    }
  ]
}
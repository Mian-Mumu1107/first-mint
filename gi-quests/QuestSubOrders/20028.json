  "subQuests": [
    {
      "subId": "2002801",
      "subQuestName": "Go check the details",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "200280101"
        ],
        "dialogs": {
          "200280101": {
            "id": "200280101",
            "speakerId": 157501,
            "speakerName": "Timid Morrow",
            "text": "#Th—Thank you kindly, {M#sir}{F#ma'am}...",
            "nextDialogs": [
              "200280102"
            ]
          },
          "200280102": {
            "id": "200280102",
            "speakerId": 157501,
            "speakerName": "Timid Morrow",
            "text": "I may be a hunter by trade, but I've sure met my match with these darned slimes.",
            "nextDialogs": [
              "200280103"
            ]
          },
          "200280103": {
            "id": "200280103",
            "speakerId": 157501,
            "speakerName": "Timid Morrow",
            "text": "Thanks to them, once again I got nothing to show for this hunt. Ain't caught squat.",
            "nextDialogs": [
              "200280104"
            ]
          },
          "200280104": {
            "id": "200280104",
            "speakerId": 157501,
            "speakerName": "Timid Morrow",
            "text": "I sure hope them other hunters ain't as unfortunate as me.",
            "nextDialogs": [
              "200280105"
            ]
          },
          "200280105": {
            "id": "200280105",
            "speakerId": 157501,
            "speakerName": "Timid Morrow",
            "text": "Speaking of slimes and such... Could you take a look-see around here for me?",
            "nextDialogs": [
              "200280106"
            ]
          },
          "200280106": {
            "id": "200280106",
            "speakerId": 157501,
            "speakerName": "Timid Morrow",
            "text": "It could just be my imagination, but... they seem to be showing up more and more 'round this town.",
            "nextDialogs": [
              "200280107"
            ]
          },
          "200280107": {
            "id": "200280107",
            "speakerId": 157501,
            "speakerName": "Timid Morrow",
            "text": "Can you check the road ahead for slimes? If you see any... you know what to do.",
            "nextDialogs": [
              "200280110",
              "200280112"
            ]
          },
          "200280110": {
            "id": "200280110",
            "speakerId": 157501,
            "speakerName": "Timid Morrow",
            "text": "You're doing me a great service. Well, I'd better get back and report all this to Draff.",
            "nextDialogs": [
              "200280111"
            ]
          },
          "200280111": {
            "id": "200280111",
            "speakerId": 157501,
            "speakerName": "Timid Morrow",
            "text": "Here's hoping he isn't so drunk that it goes in one ear and out the other!"
          },
          "200280112": {
            "id": "200280112",
            "speakerId": 157501,
            "speakerName": "Timid Morrow",
            "text": "#Please {M#sir}{F#ma'am}, if not for me, then for the sake of everyone in Springvale."
          }
        }
      }
    },
    {

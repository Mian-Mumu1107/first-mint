    {
      "subId": "7408519",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740851901"
        ],
        "dialogs": {
          "740851901": {
            "id": "740851901",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh no! We didn't get a chance to look for her!",
            "nextDialogs": [
              "740851902"
            ]
          },
          "740851902": {
            "id": "740851902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't worry. I'm sure she can swim.",
            "nextDialogs": [
              "740851903"
            ]
          },
          "740851903": {
            "id": "740851903",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That's true, but... Whoa! Look at the great tree!",
            "nextDialogs": [
              "740851904"
            ]
          },
          "740851904": {
            "id": "740851904",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's recovered, and it's so pretty! Is that what it looked like before? Pahsiv will be happy if she sees it, won't she?",
            "nextDialogs": [
              "740851905"
            ]
          },
          "740851905": {
            "id": "740851905",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "#Paimon! Pahsiv! {NICKNAME}! Pahsiv!",
            "nextDialogs": [
              "740851906"
            ]
          },
          "740851906": {
            "id": "740851906",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Pahsiv? Great! Where did you go? We were so worried!",
            "nextDialogs": [
              "740851907"
            ]
          },
          "740851907": {
            "id": "740851907",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Disappeared, Pahsiv.",
            "nextDialogs": [
              "740851908"
            ]
          },
          "740851908": {
            "id": "740851908",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Ah... Box. Pahsiv!",
            "nextDialogs": [
              "740851909"
            ]
          },
          "740851909": {
            "id": "740851909",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What? Is that a treasure chest? You went looking for treasure chests?",
            "nextDialogs": [
              "740851910"
            ]
          },
          "740851910": {
            "id": "740851910",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Pahsiv! But, shiny, round, Melusine...",
            "nextDialogs": [
              "740851911"
            ]
          },
          "740851911": {
            "id": "740851911",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You didn't find any Mora? That's fine. The chest is more than enough!",
            "nextDialogs": [
              "740851912"
            ]
          },
          "740851912": {
            "id": "740851912",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You remembered what Paimon told you! Oh, you're gonna make Paimon cry! Thank you, Pahsiv!",
            "nextDialogs": [
              "740851913"
            ]
          },
          "740851913": {
            "id": "740851913",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Thank... you...?",
            "nextDialogs": [
              "740851916"
            ]
          },
          "740851916": {
            "id": "740851916",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It means Pahsiv!",
            "nextDialogs": [
              "740851917"
            ]
          },
          "740851917": {
            "id": "740851917",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "#Paimon, thank you! {NICKNAME}, thank you!",
            "nextDialogs": [
              "740851918"
            ]
          },
          "740851918": {
            "id": "740851918",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "#Paimon, good thing! {NICKNAME}, good thing!",
            "nextDialogs": [
              "740851919"
            ]
          },
          "740851919": {
            "id": "740851919",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pahsiv, good thing!",
            "nextDialogs": [
              "740851920"
            ]
          },
          "740851920": {
            "id": "740851920",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Pahsiv, good thing!",
            "nextDialogs": [
              "740851921"
            ]
          },
          "740851921": {
            "id": "740851921",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, we should come to see Pahsiv often when we have time, and teach her more words, like New Valet did.",
            "nextDialogs": [
              "740851922"
            ]
          },
          "740851922": {
            "id": "740851922",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740851923"
            ]
          },
          "740851923": {
            "id": "740851923",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "What do you think, Pahsiv? Can we come back to play with you?",
            "nextDialogs": [
              "740851924"
            ]
          },
          "740851924": {
            "id": "740851924",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Where did she go this time?",
            "nextDialogs": [
              "740851925"
            ]
          },
          "740851925": {
            "id": "740851925",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Pahsiv, disappeared!",
            "nextDialogs": [
              "740851926"
            ]
          },
          "740851926": {
            "id": "740851926",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wow! Paimon has never seen a Melusine like her. Or rather... She doesn't behave like a Melusine, but more like a wild fairy.",
            "nextDialogs": [
              "740851927"
            ]
          },
          "740851927": {
            "id": "740851927",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Maybe that's why she can spy on the purple thing quietly.",
            "nextDialogs": [
              "740851928"
            ]
          },
          "740851928": {
            "id": "740851928",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey, Pahsiv! Goodbye! If we meet again, we'll teach you how to say goodbye properly!"
          }
        }
      }

    {
      "subId": "7408502",
      "subQuestName": "Talk to the Melusine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740850201"
        ],
        "dialogs": {
          "740850201": {
            "id": "740850201",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Key, statue, key, statue, key, statue.",
            "nextDialogs": [
              "740850202"
            ]
          },
          "740850202": {
            "id": "740850202",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Do you mean... that we need to put the keys in the statues? Well, that sounds about right. Three keys, three statues...",
            "nextDialogs": [
              "740850203"
            ]
          },
          "740850203": {
            "id": "740850203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Shall we give it a try?",
            "nextDialogs": [
              "740850204"
            ]
          },
          "740850204": {
            "id": "740850204",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What happens after we place the keys?",
            "nextDialogs": [
              "740850205"
            ]
          },
          "740850205": {
            "id": "740850205",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Door opens, open door...",
            "nextDialogs": [
              "740850206"
            ]
          },
          "740850206": {
            "id": "740850206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Door? Where? And what's behind the door?",
            "nextDialogs": [
              "740850207"
            ]
          },
          "740850207": {
            "id": "740850207",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Root, Erinnyes, very deep...",
            "nextDialogs": [
              "740850208"
            ]
          },
          "740850208": {
            "id": "740850208",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A door to the root of Erinnyes? You know so much, Pahsiv!",
            "nextDialogs": [
              "740850209"
            ]
          },
          "740850209": {
            "id": "740850209",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Pahsiv, protect!",
            "nextDialogs": [
              "740850210"
            ]
          },
          "740850210": {
            "id": "740850210",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What else do we have to know?",
            "nextDialogs": [
              "740850211"
            ]
          },
          "740850211": {
            "id": "740850211",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "...Huh?",
            "nextDialogs": [
              "740850212"
            ]
          },
          "740850212": {
            "id": "740850212",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "You know, like information! The more the merrier! The more we know, the more confident we will be!",
            "nextDialogs": [
              "740850213"
            ]
          },
          "740850213": {
            "id": "740850213",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "In...formation? In...formation... Pahsiv! Information, a lot!",
            "nextDialogs": [
              "740850214"
            ]
          },
          "740850214": {
            "id": "740850214",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Great!",
            "nextDialogs": [
              "740850215"
            ]
          },
          "740850215": {
            "id": "740850215",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Erinnyes, information, lots of.",
            "nextDialogs": [
              "740850216"
            ]
          },
          "740850216": {
            "id": "740850216",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Lots of information, uh huh.",
            "nextDialogs": [
              "740850217"
            ]
          },
          "740850217": {
            "id": "740850217",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Information, water vein, lots of.",
            "nextDialogs": [
              "740850218"
            ]
          },
          "740850218": {
            "id": "740850218",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Lots of water veins, right.",
            "nextDialogs": [
              "740850219"
            ]
          },
          "740850219": {
            "id": "740850219",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Water vein, New Valet, lots of.",
            "nextDialogs": [
              "740850220"
            ]
          },
          "740850220": {
            "id": "740850220",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... Hmm? New Valet? Lots of? Wait, Paimon doesn't get it. Where do all these valets come from? Or are you telling Paimon that this New Valet knows how to create mirror images of themselves?",
            "nextDialogs": [
              "740850221"
            ]
          },
          "740850221": {
            "id": "740850221",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Melusine!",
            "nextDialogs": [
              "740850222"
            ]
          },
          "740850222": {
            "id": "740850222",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Water vein, New Valet, taste.",
            "nextDialogs": [
              "740850223"
            ]
          },
          "740850223": {
            "id": "740850223",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Evil, New Valet, sense.",
            "nextDialogs": [
              "740850224"
            ]
          },
          "740850224": {
            "id": "740850224",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Tasting the evil in the water vein? Err, what kind of flavor is that?",
            "nextDialogs": [
              "740850225"
            ]
          },
          "740850225": {
            "id": "740850225",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "New Valet can sense information through the water veins?",
            "nextDialogs": [
              "740850226"
            ]
          },
          "740850226": {
            "id": "740850226",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740850227"
            ]
          },
          "740850227": {
            "id": "740850227",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Willow, collect. Fog, handle. Spring, send.",
            "nextDialogs": [
              "740850228"
            ]
          },
          "740850228": {
            "id": "740850228",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Root, water vein, center.",
            "nextDialogs": [
              "740850229"
            ]
          },
          "740850229": {
            "id": "740850229",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "So, Erinnyes is the center of information?",
            "nextDialogs": [
              "740850230"
            ]
          },
          "740850230": {
            "id": "740850230",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Are you saying that all of Erinnyes is New Valet's information system? And New Valet can sense something bad?",
            "nextDialogs": [
              "740850231"
            ]
          },
          "740850231": {
            "id": "740850231",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "#Smart Paimon! Smart {NICKNAME}! Pahsiv!",
            "nextDialogs": [
              "740850232"
            ]
          },
          "740850232": {
            "id": "740850232",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Gosh, who is this New Valet?",
            "nextDialogs": [
              "740850233"
            ]
          },
          "740850233": {
            "id": "740850233",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Fontaine, New Valet, protect.",
            "nextDialogs": [
              "740850234"
            ]
          },
          "740850234": {
            "id": "740850234",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "But, New Valet, very busy.",
            "nextDialogs": [
              "740850235"
            ]
          },
          "740850235": {
            "id": "740850235",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Purple thing, sneaking toward the root. Purple thing, secretly destroying the root.",
            "nextDialogs": [
              "740850236"
            ]
          },
          "740850236": {
            "id": "740850236",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Pahsiv, peek. Pahsiv, secretly scratch the stone tablet.",
            "nextDialogs": [
              "740850237"
            ]
          },
          "740850237": {
            "id": "740850237",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "So you're the one that removed the writing from the stone tablet! Was it to stop the purple thing?",
            "nextDialogs": [
              "740850238"
            ]
          },
          "740850238": {
            "id": "740850238",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Pahsiv! But...",
            "nextDialogs": [
              "740850239"
            ]
          },
          "740850239": {
            "id": "740850239",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Purple thing, kept going toward the root. Purple thing, very powerful.",
            "nextDialogs": [
              "740850240"
            ]
          },
          "740850240": {
            "id": "740850240",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "The purple thing found another way?",
            "nextDialogs": [
              "740850241"
            ]
          },
          "740850241": {
            "id": "740850241",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Pahsiv!",
            "nextDialogs": [
              "740850242"
            ]
          },
          "740850242": {
            "id": "740850242",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Looks like this purple thing's a tough customer. If the root is destroyed, then the information system will fail to function, and New Valet's senses will be affected.",
            "nextDialogs": [
              "740850243"
            ]
          },
          "740850243": {
            "id": "740850243",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Pahsiv, duty! Pahsiv, protect!",
            "nextDialogs": [
              "740850244"
            ]
          },
          "740850244": {
            "id": "740850244",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "#{NICKNAME}, ka-pow. Paimon, ka-pow.",
            "nextDialogs": [
              "740850245"
            ]
          },
          "740850245": {
            "id": "740850245",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, we can't wait anymore. We need to ka-pow now!",
            "nextDialogs": [
              "740850246"
            ]
          },
          "740850246": {
            "id": "740850246",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alright then, Pahsiv! Open the door!",
            "nextDialogs": [
              "740850247"
            ]
          },
          "740850247": {
            "id": "740850247",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Excellent. Let's go!"
          }
        }
      }
    },

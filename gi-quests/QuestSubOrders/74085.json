    {
      "subId": "7408510",
      "subQuestName": "Talk to the Melusine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740851001"
        ],
        "dialogs": {
          "740851001": {
            "id": "740851001",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Root... Root...",
            "nextDialogs": [
              "740851002"
            ]
          },
          "740851002": {
            "id": "740851002",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "We're finally here! Whoa, that's a whole load of funky stuff. Paimon doesn't see anyone around, but she's getting a familiar feeling... Evil's gotta be lurking nearby...",
            "nextDialogs": [
              "740851003"
            ]
          },
          "740851003": {
            "id": "740851003",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Willow... Root...",
            "nextDialogs": [
              "740851004"
            ]
          },
          "740851004": {
            "id": "740851004",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Are these the roots of that great tree from earlier?",
            "nextDialogs": [
              "740851005"
            ]
          },
          "740851005": {
            "id": "740851005",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon gets it now! That's why the great tree looked so sickly. The roots have been corrupted!",
            "nextDialogs": [
              "740851006"
            ]
          },
          "740851006": {
            "id": "740851006",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Root... Melusine...",
            "nextDialogs": [
              "740851007"
            ]
          },
          "740851007": {
            "id": "740851007",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#{NICKNAME}, let's clean up all this filth. Paimon reckons they're corrupting the roots."
          }
        }
      }
    },
    {
      "subId": "7408511",
      "subQuestName": "Cleanse the filth near the \"root\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7408512",
      "subQuestName": "Talk to the Melusine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740851201"
        ],
        "dialogs": {
          "740851201": {
            "id": "740851201",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Ugh, this is tough. This pollution's impossible to clear up!",
            "nextDialogs": [
              "740851202"
            ]
          },
          "740851202": {
            "id": "740851202",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Pahsiv, ka-pow!",
            "nextDialogs": [
              "740851203"
            ]
          },
          "740851203": {
            "id": "740851203",
            "speakerId": 1004,
            "speakerName": "Black Screen",
            "text": "Pahsiv touches your stomach with her hand, and you feel a warmth coming from her palm.\\nYou feel like something in you has been enhanced.",
            "nextDialogs": [
              "740851204"
            ]
          },
          "740851204": {
            "id": "740851204",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Pahsiv, tired...",
            "nextDialogs": [
              "740851205"
            ]
          },
          "740851205": {
            "id": "740851205",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#What did Pahsiv do? You look revitalized, {NICKNAME}!"
          }
        }
      }
    },
    {
      "subId": "7408513",
      "subQuestName": "Cleanse the filth near the \"root\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7408514",
      "subQuestName": "Talk to the Melusine",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740851401"
        ],
        "dialogs": {
          "740851401": {
            "id": "740851401",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Finally, it's all gone. Paimon didn't know that you had such a marvelous ability, Pahsiv...",
            "nextDialogs": [
              "740851402"
            ]
          },
          "740851402": {
            "id": "740851402",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Now... Wait... Something's lit up on the ground... It's some kinda arcane formation!",
            "nextDialogs": [
              "740851403"
            ]
          },
          "740851403": {
            "id": "740851403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Agh! Rifthounds are charging out!",
            "nextDialogs": [
              "740851404"
            ]
          },
          "740851404": {
            "id": "740851404",
            "speakerId": 1000,
            "speakerName": "Pahsiv",
            "text": "Purple thing...",
            "nextDialogs": [
              "740851405"
            ]
          },
          "740851405": {
            "id": "740851405",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Don't worry, Pahsiv. We'll protect you!",
            "nextDialogs": [
              "740851406"
            ]
          },
          "740851406": {
            "id": "740851406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Wait! Where are you going, Pahsiv? Stop! This place is dangerous!"
          }
        }
      }
    },
    {
      "subId": "7408515",
      "subQuestName": "Repel the Rifthounds",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7408516",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740851701"
        ],
        "dialogs": {
          "740851701": {
            "id": "740851701",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Phew! Finally, that's that under control. We sure kicked the Rifthound nest, huh? {NICKNAME}, how are you doing?",
            "nextDialogs": [
              "740851704"
            ]
          },
          "740851704": {
            "id": "740851704",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe, Paimon's sure that wasn't just you boasting. It looks like the roots are recovering — guess that means the problem here has been cleared up, right?",
            "nextDialogs": [
              "740851705"
            ]
          },
          "740851705": {
            "id": "740851705",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "But what happened just then? A vishap turned up to help, and Pahsiv disappeared...",
            "nextDialogs": [
              "740851706"
            ]
          },
          "740851706": {
            "id": "740851706",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! Pahsiv! Are you there? Can you hear Paimon?",
            "nextDialogs": [
              "740851707"
            ]
          },
          "740851707": {
            "id": "740851707",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Okay, looks like she's really disappeared.",
            "nextDialogs": [
              "740851708"
            ]
          },
          "740851708": {
            "id": "740851708",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "She's got plenty of secrets, for sure.",
            "nextDialogs": [
              "740851709"
            ]
          },
          "740851709": {
            "id": "740851709",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... She's such a mysterious Melusine. Paimon knows she didn't want any reward, but it still seems odd to just leave like that...",
            "nextDialogs": [
              "740851710"
            ]
          },
          "740851710": {
            "id": "740851710",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Why?",
            "nextDialogs": [
              "740851711"
            ]
          },
          "740851711": {
            "id": "740851711",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It's as if... It's as if you had a favorite food, and then one day, the food looks at you and says \"guess we're through.\""
          }
        }
      }

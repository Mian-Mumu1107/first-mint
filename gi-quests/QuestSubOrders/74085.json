    {
      "subId": "7408520",
      "subQuestName": "Insert the Waterdrop Keys into the statue",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "740852001"
        ],
        "dialogs": {
          "740852001": {
            "id": "740852001",
            "speakerId": 1002,
            "speakerName": "Keratry",
            "text": "Brother! Look! There seems to be a hole in the fountain. Was that your magic?",
            "nextDialogs": [
              "740852002"
            ]
          },
          "740852002": {
            "id": "740852002",
            "speakerId": 1003,
            "speakerName": "Remaudiere",
            "text": "...Uh... Yes, that's right! That was your brother's magic, indeed. Awesome, right?",
            "nextDialogs": [
              "740852003"
            ]
          },
          "740852003": {
            "id": "740852003",
            "speakerId": 1002,
            "speakerName": "Keratry",
            "text": "Yup! I didn't think you'd have a trick that's as good as the Great Magician Lyney's!",
            "nextDialogs": [
              "740852004"
            ]
          },
          "740852004": {
            "id": "740852004",
            "speakerId": 1003,
            "speakerName": "Remaudiere",
            "text": "Ahem..."
          }
        }
      }
    },

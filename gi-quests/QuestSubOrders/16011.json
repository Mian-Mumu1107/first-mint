    {
      "subId": "1601102",
      "subQuestName": "Look around",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "160110201"
        ],
        "dialogs": {
          "160110201": {
            "id": "160110201",
            "speakerId": 1000,
            "speakerName": "Varka",
            "text": "Ugh...",
            "nextDialogs": [
              "160110202"
            ]
          },
          "160110202": {
            "id": "160110202",
            "speakerId": 1000,
            "speakerName": "Varka",
            "text": "...The sword is unbroken? But I can't sense the Wolf Spirit...",
            "nextDialogs": [
              "160110203"
            ]
          },
          "160110203": {
            "id": "160110203",
            "speakerId": 1000,
            "speakerName": "Varka",
            "text": "(...Looks like I'm no longer in reality. This must be a space built from the entangled consciousnesses of Boreas and Roland.)",
            "nextDialogs": [
              "160110204"
            ]
          },
          "160110204": {
            "id": "160110204",
            "speakerId": 1000,
            "speakerName": "Varka",
            "text": "There's no way back, and all that lies ahead is the wolf's maw... Hmm...",
            "nextDialogs": [
              "160110205"
            ]
          },
          "160110205": {
            "id": "160110205",
            "speakerId": 1000,
            "speakerName": "Varka",
            "text": "Hah, guess the only way is through."
          }
        }
      }
    },

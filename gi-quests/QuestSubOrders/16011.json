        ],
        "dialogs": {
          "160110701": {
            "id": "160110701",
            "speakerId": 1000,
            "speakerName": "Varka",
            "text": "Is this... the heart of the wolf?",
            "nextDialogs": [
              "160110702"
            ]
          },
          "160110702": {
            "id": "160110702",
            "speakerId": 1000,
            "speakerName": "Varka",
            "text": "...! Roland!"
          }
        }
      }

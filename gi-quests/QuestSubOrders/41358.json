    {
      "subId": "4135801",
      "subQuestName": "Talk to Brother Qian",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "413580101"
        ],
        "dialogs": {
          "413580101": {
            "id": "413580101",
            "speakerId": 2039,
            "speakerName": "Brother Qian",
            "text": "Try the Illumiscreen...",
            "nextDialogs": [
              "413580102"
            ]
          },
          "413580102": {
            "id": "413580102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Huh? These lanterns...",
            "nextDialogs": [
              "413580103"
            ]
          },
          "413580103": {
            "id": "413580103",
            "speakerId": 2039,
            "speakerName": "Brother Qian",
            "text": "Ah, it's you. You've come at a good time. I've changed to a new set of lanterns since the last time you were here.",
            "nextDialogs": [
              "413580104"
            ]
          },
          "413580104": {
            "id": "413580104",
            "speakerId": 2039,
            "speakerName": "Brother Qian",
            "text": "Fancy giving it a try, seeing if you can solve this one? It won't be as easy as last time.",
            "nextDialogs": [
              "413580106",
              "413580109"
            ]
          },
          "413580106": {
            "id": "413580106",
            "speakerId": 2039,
            "speakerName": "Brother Qian",
            "text": "No, no. The image is easy to spot, and there are still only three parts to combine.",
            "nextDialogs": [
              "413580107"
            ]
          },
          "413580107": {
            "id": "413580107",
            "speakerId": 2039,
            "speakerName": "Brother Qian",
            "text": "The difficulty this time has to do with the lantern rotation part.",
            "nextDialogs": [
              "413580112"
            ]
          },
          "413580112": {
            "id": "413580112",
            "speakerId": 2039,
            "speakerName": "Brother Qian",
            "text": "Okay, so, the image to make today is <color=#00E1FFFF>Mora</color>. Remember, you have to get the right image first before you can go looking for the treasure."
          },
          "413580109": {
            "id": "413580109",
            "speakerId": 2039,
            "speakerName": "Brother Qian",
            "text": "Hehehe, this time the three lanterns are <color=#00E1FFFF>linked together</color>.",
            "nextDialogs": [
              "413580110"
            ]
          },
          "413580110": {
            "id": "413580110",
            "speakerId": 2039,
            "speakerName": "Brother Qian",
            "text": "To put it simply, when you rotate a lantern, there's a possibility that one of the other ones will rotate, too.",
            "nextDialogs": [
              "413580111"
            ]
          },
          "413580111": {
            "id": "413580111",
            "speakerId": 2039,
            "speakerName": "Brother Qian",
            "text": "Give it a go, you'll see what I mean."
          }
        }
      }
    },
    {

            "id": "413580201",
            "speakerId": 2039,
            "speakerName": "Brother Qian",
            "text": "How is the treasure hunt going?",
            "nextDialogs": [
              "413580202"
            ]
          },
          "413580202": {
            "id": "413580202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I've found every last chest.",
            "nextDialogs": [
              "413580203"
            ]
          },
          "413580203": {
            "id": "413580203",
            "speakerId": 2039,
            "speakerName": "Brother Qian",
            "text": "All of it? You're quite the expert treasure hunter, then... Plenty of people give up and walk off after the first try...",
            "nextDialogs": [
              "413580204"
            ]
          },
          "413580204": {
            "id": "413580204",
            "speakerId": 2039,
            "speakerName": "Brother Qian",
            "text": "Since you found all the treasure... Please take these as your prize. Happy Lantern Rite!"
          }
        }
      }
    },

    {
      "subId": "2503404",
      "subQuestName": "Talk to Tlatem",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250340501"
        ],
        "dialogs": {
          "250340501": {
            "id": "250340501",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "#Thanks for saving us, {M#Big Bro}{F#Big Sis}.",
            "nextDialogs": [
              "250340502"
            ]
          },
          "250340502": {
            "id": "250340502",
            "speakerId": 1002,
            "speakerName": "Qica",
            "text": "Hrroo, roooh...",
            "nextDialogs": [
              "250340503"
            ]
          },
          "250340503": {
            "id": "250340503",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "This place was too far from the tribe — if you hadn't shown up, there's no way I'd have been able to alert Illapa before Qica got caught.",
            "nextDialogs": [
              "250340504"
            ]
          },
          "250340504": {
            "id": "250340504",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you two doing over here, anyway?",
            "nextDialogs": [
              "250340505"
            ]
          },
          "250340505": {
            "id": "250340505",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Climbing practice, as always — but we got hungry halfway through.",
            "nextDialogs": [
              "250340506"
            ]
          },
          "250340506": {
            "id": "250340506",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "So the two of us went foraging... But before we knew it, we'd wandered off pretty far...",
            "nextDialogs": [
              "250340507"
            ]
          },
          "250340507": {
            "id": "250340507",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "By the time we'd had our fill, we were a long, long way out. Mom's going to give it to me for sure when we get back...",
            "nextDialogs": [
              "250340508"
            ]
          },
          "250340508": {
            "id": "250340508",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Thanks again for saving us. Take these Cacahuatls — I only just plucked 'em!",
            "nextDialogs": [
              "250340509"
            ]
          },
          "250340509": {
            "id": "250340509",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "We'll head back as quick as we can. Come on, Qica!",
            "nextDialogs": [
              "250340510"
            ]
          },
          "250340510": {
            "id": "250340510",
            "speakerId": 1002,
            "speakerName": "Qica",
            "text": "Rawr! Rawrrr! Rawr!"
          }
        }
      }
    }
  ]
}
  "subQuests": [
    {
      "subId": "2503401",
      "subQuestName": "Talk to Tlatem",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "250340101"
        ],
        "dialogs": {
          "250340101": {
            "id": "250340101",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "He doesn't like you, so scram!",
            "nextDialogs": [
              "250340102"
            ]
          },
          "250340102": {
            "id": "250340102",
            "speakerId": 1001,
            "speakerName": "Impatient Thief",
            "text": "Little runt... What's with you and the Saurian? You know him or something?",
            "nextDialogs": [
              "250340103"
            ]
          },
          "250340103": {
            "id": "250340103",
            "speakerId": 1002,
            "speakerName": "Qica",
            "text": "Roar... Rawrrrr!",
            "nextDialogs": [
              "250340104"
            ]
          },
          "250340104": {
            "id": "250340104",
            "speakerId": 1001,
            "speakerName": "Impatient Thief",
            "text": "Oh, look, he's getting impatient. Alright then, whelp, stand aside. We don't hit kids.",
            "nextDialogs": [
              "250340105"
            ]
          },
          "250340105": {
            "id": "250340105",
            "speakerId": 1001,
            "speakerName": "Impatient Thief",
            "text": "Bring the bag, boys. Bet you this Saurian'll sell for a good price.",
            "nextDialogs": [
              "250340106"
            ]
          },
          "250340106": {
            "id": "250340106",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "Don't come any closer! And don't blame me if you get hurt!",
            "nextDialogs": [
              "250340107"
            ]
          },
          "250340107": {
            "id": "250340107",
            "speakerId": 1001,
            "speakerName": "Impatient Thief",
            "text": "W—Wait, you mean you're going to hit us? Hahahaha! You hear that, boys? He's gonna take us on!",
            "nextDialogs": [
              "250340108"
            ]
          },
          "250340108": {
            "id": "250340108",
            "speakerId": 1001,
            "speakerName": "Impatient Thief",
            "text": "Ooh, kiddo, I'm sho scared, I'm twembling in my bwoots. But if you say so... don't blame me if you get hurt.",
            "nextDialogs": [
              "250340109"
            ]
          },
          "250340109": {
            "id": "250340109",
            "speakerId": 1002,
            "speakerName": "Qica",
            "text": "Rawr! Rawrrr! Rawr!",
            "nextDialogs": [
              "250340110"
            ]
          },
          "250340110": {
            "id": "250340110",
            "speakerId": 1001,
            "speakerName": "Impatient Thief",
            "text": "Tch... Isn't this Saurian a noisy one. Alright, kid, just go have a nap over—",
            "nextDialogs": [
              "250340113"
            ]
          },
          "250340113": {
            "id": "250340113",
            "speakerId": 1000,
            "speakerName": "Tlatem",
            "text": "#{M#Big Bro}{F#Big Sis}! They're trying to take Qica!",
            "nextDialogs": [
              "250340114"
            ]
          },
          "250340114": {
            "id": "250340114",
            "speakerId": 1002,
            "speakerName": "Qica",
            "text": "Rroo! Wrroo!",
            "nextDialogs": [
              "250340115"
            ]
          },
          "250340115": {
            "id": "250340115",
            "speakerId": 1001,
            "speakerName": "Impatient Thief",
            "text": "...Hey, you. How about you step aside? We won't hurt you. Heck, we'll give you a share. How's that sound?"
          }
        }
      }
    },
    {
      "subId": "2503403",
      "subQuestName": "Defeat all opponents",
      "sceneId": null,
      "locations": [],

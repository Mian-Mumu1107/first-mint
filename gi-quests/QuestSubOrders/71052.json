    {
      "subId": "7105208",
      "subQuestName": "Take pictures of more fossils",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7105209",
      "subQuestName": "Give the fossil pictures to Khedive",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710500902"
        ],
        "dialogs": {
          "710500902": {
            "id": "710500902",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Great, these are some nice pictures!",
            "nextDialogs": [
              "710500903"
            ]
          },
          "710500903": {
            "id": "710500903",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Certainly worth the resources of the exploration team.",
            "nextDialogs": [
              "710500904"
            ]
          },
          "710500904": {
            "id": "710500904",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Look, these are all bones of ancient marine creatures. You can see their structure very clearly.",
            "nextDialogs": [
              "710500905"
            ]
          },
          "710500905": {
            "id": "710500905",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "This means that this place used to be beneath the ocean's surface before it became The Chasm.",
            "nextDialogs": [
              "710500906"
            ]
          },
          "710500906": {
            "id": "710500906",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "What a pity we aren't in Sumeru. Otherwise, I would have them brought back to the Akademiya to begin research right away.",
            "nextDialogs": [
              "710500907"
            ]
          },
          "710500907": {
            "id": "710500907",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "We can't afford to have miners accidentally tampering with these fossils. We need to hire people to take some precautions. Yes, I'll bring this up next time I meet up with the people of the Ministry.",
            "nextDialogs": [
              "710500908"
            ]
          },
          "710500908": {
            "id": "710500908",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "But...",
            "nextDialogs": [
              "710500911"
            ]
          },
          "710500911": {
            "id": "710500911",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "I'll... settle for these ones.",
            "nextDialogs": [
              "710500912"
            ]
          },
          "710500912": {
            "id": "710500912",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "But as I said, these fossils are perfectly preserved, their structure intact. And this means one thing.",
            "nextDialogs": [
              "710500913"
            ]
          },
          "710500913": {
            "id": "710500913",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "That they were buried underground in an instant.",
            "nextDialogs": [
              "710500914"
            ]
          },
          "710500914": {
            "id": "710500914",
            "speakerId": 2618,
            "speakerName": "Khedive",
            "text": "Nearly all fossils you found at The Chasm are located at a fixed altitude."
          }
        }
      }
    },
    {
      "subId": "7105009",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],

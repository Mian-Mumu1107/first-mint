    {
      "subId": "7226901",
      "subQuestName": "Talk to the afterimage in front of the seal",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722690101"
        ],
        "dialogs": {
          "722690101": {
            "id": "722690101",
            "speakerId": 20494,
            "speakerName": "Eki",
            "text": "I am Eki of the Jibashiri. Hero of Sangonomiya, I acknowledge that you are worthy to take on this challenge.",
            "nextDialogs": [
              "722690102"
            ]
          },
          "722690102": {
            "id": "722690102",
            "speakerId": 20494,
            "speakerName": "Eki",
            "text": "I am in charge of the trial of \"insight.\" Go forth and solve all the puzzles to return the Flames of the High Gate to their respective places.",
            "nextDialogs": [
              "722690103"
            ]
          },
          "722690103": {
            "id": "722690103",
            "speakerId": 20494,
            "speakerName": "Eki",
            "text": "The battlefield is ever-changing. Only by keeping your eyes and ears wide open at all times may you grasp the situation and master all these variables."
          }
        }
      }
    },
    {
      "subId": "7226902",
      "subQuestName": "Release all the Flames of the High Gate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722690201"
        ],
        "dialogs": {
          "722690201": {
            "id": "722690201",
            "speakerId": 20494,
            "speakerName": "Eki",
            "text": "Have you completed the challenge, hero of Sangonomiya?",
            "nextDialogs": [
              "722690202"
            ]
          },
          "722690202": {
            "id": "722690202",
            "speakerId": 20494,
            "speakerName": "Eki",
            "text": "Use your insight and find all the Flames of the High Gate!"
          }
        }
      }
    },
    {
      "subId": "7226903",
      "subQuestName": "Release all the Flames of the High Gate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "722690301"
        ],
        "dialogs": {
          "722690301": {
            "id": "722690301",
            "speakerId": 20494,
            "speakerName": "Eki",
            "text": "Impressive. You cleared that trial with ease. I, Eki of the Jibashiri, acknowledge your great valor.",
            "nextDialogs": [
              "722690302"
            ]
          },
          "722690302": {
            "id": "722690302",
            "speakerId": 20494,
            "speakerName": "Eki",
            "text": "Your insight can be said to be sufficient to seek out an eel in the winter.",
            "nextDialogs": [
              "722690303"
            ]
          },
          "722690303": {
            "id": "722690303",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "And what's that supposed to mean, huh?",
            "nextDialogs": [
              "722690304"
            ]
          },
          "722690304": {
            "id": "722690304",
            "speakerId": 20494,
            "speakerName": "Eki",
            "text": "Breeding season unagi fry are very, very small. You must exert the greatest visual acuity to see them."
          }
        }
      }
    },

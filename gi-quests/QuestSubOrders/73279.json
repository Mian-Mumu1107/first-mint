  "subQuests": [
    {
      "subId": "7327901",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732790101"
        ],
        "dialogs": {
          "732790101": {
            "id": "732790101",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "#Ah, {NICKNAME}, esteemed Master of the Jinni. To what do I owe the pleasure?",
            "nextDialogs": [
              "732790102"
            ]
          },
          "732790102": {
            "id": "732790102",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "Splendid. Another desert-spawn. My master, I— *sigh* Never mind. I trust your judgment.",
            "nextDialogs": [
              "732790103"
            ]
          },
          "732790103": {
            "id": "732790103",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Could you spare a minute for me? I've been looking forward to seeing you as I've been to seeing the moon and rain.",
            "nextDialogs": [
              "732790104"
            ]
          },
          "732790104": {
            "id": "732790104",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "Don't let us doubt your intent. Just cut to the chase.",
            "nextDialogs": [
              "732790105"
            ]
          },
          "732790105": {
            "id": "732790105",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Very well, Master of the Jinni, I do have a request...",
            "nextDialogs": [
              "732790106"
            ]
          },
          "732790106": {
            "id": "732790106",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Haha, nothing serious. It's just my Falcon, Tadhla. I think she's in danger.",
            "nextDialogs": [
              "732790107"
            ]
          },
          "732790107": {
            "id": "732790107",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "*sigh* If it weren't for my weak legs, I wouldn't be troubling you for this...",
            "nextDialogs": [
              "732790108"
            ]
          },
          "732790108": {
            "id": "732790108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Correct Paimon if she's wrong. You want us to rescue her before thanking us profusely, paying us a large sum of Mora, and treating us to a big meal for our triumph, right?",
            "nextDialogs": [
              "732790109"
            ]
          },
          "732790109": {
            "id": "732790109",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Uh... Yes, yes.",
            "nextDialogs": [
              "732790110"
            ]
          },
          "732790110": {
            "id": "732790110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Well, if that's the case, we'll do it!",
            "nextDialogs": [
              "732790111"
            ]
          },
          "732790111": {
            "id": "732790111",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Paimon always gets extra logical when it comes to such situations...",
            "nextDialogs": [
              "732790112"
            ]
          },
          "732790112": {
            "id": "732790112",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "*sigh* Alright, let's do it for Paimon's big meal.",
            "nextDialogs": [
              "732790113"
            ]
          },
          "732790113": {
            "id": "732790113",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Thank you so much. I'm counting on you.",
            "nextDialogs": [
              "732790114"
            ]
          },
          "732790114": {
            "id": "732790114",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Let me mark out her last known location.",
            "nextDialogs": [
              "732790115"
            ]
          },
          "732790115": {
            "id": "732790115",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "The person you need to look for, Tadhla, is tall, tanned, with light-colored long hair, and uses a long bow. Yes, this should be enough information about her.",
            "nextDialogs": [
              "732790116"
            ]
          },
          "732790116": {
            "id": "732790116",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Did you get it all?",
            "nextDialogs": [
              "732790117"
            ]
          },
          "732790117": {
            "id": "732790117",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... A tall, tanned girl with light-colored long hair and holds a long bow! Hehe, Paimon has an excellent memory!",
            "nextDialogs": [
              "732790118"
            ]
          },
          "732790118": {
            "id": "732790118",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "May the wind guide you through sandstorms and away from danger.",
            "nextDialogs": [
              "732790119"
            ]
          },
          "732790119": {
            "id": "732790119",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Thank you. We'll see you soon!"
          }
        }
      }
    },
    {
      "subId": "7327902",
      "subQuestName": "Go to Tadhla's last known location",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732790201"
        ],
        "dialogs": {
          "732790201": {
            "id": "732790201",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Did you find her?",
            "nextDialogs": [
              "732790202"
            ]
          },
          "732790202": {
            "id": "732790202",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "I see, you still need some time.",
            "nextDialogs": [
              "732790203"
            ]
          },
          "732790203": {
            "id": "732790203",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Please find her as soon as possible. Time is not on our side."
          }
        }
      }
    },
    {
      "subId": "7327903",
      "subQuestName": "Proceed deeper",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7327904",
      "subQuestName": "Talk to Paimon",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732790401"
        ],
        "dialogs": {
          "732790401": {
            "id": "732790401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Shh... See? There's someone over there!",
            "nextDialogs": [
              "732790402"
            ]
          },
          "732790402": {
            "id": "732790402",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "Hmm... My master, be those the people whom you mentioned? The \"Fooltui\"?",
            "nextDialogs": [
              "732790403"
            ]
          },
          "732790403": {
            "id": "732790403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It's the \"Fatui.\"",
            "nextDialogs": [
              "732790404"
            ]
          },
          "732790404": {
            "id": "732790404",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "That name makes them sound no wiser.",
            "nextDialogs": [
              "732790405"
            ]
          },
          "732790405": {
            "id": "732790405",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Shh! Keep it down! If they see us...",
            "nextDialogs": [
              "732790406"
            ]
          },
          "732790406": {
            "id": "732790406",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "Be placid. They hear nothing of my words. Here, bear witness...",
            "nextDialogs": [
              "732790407"
            ]
          },
          "732790407": {
            "id": "732790407",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "Ahoy! You! Corpulent one! Over here! Time to eat!",
            "nextDialogs": [
              "732790408"
            ]
          },
          "732790408": {
            "id": "732790408",
            "speakerId": 20937,
            "speakerName": "Fatui Skirmisher No. 1",
            "text": "Hmm? Did you hear anything?",
            "nextDialogs": [
              "732790409"
            ]
          },
          "732790409": {
            "id": "732790409",
            "speakerId": 20938,
            "speakerName": "Fatui Skirmisher No. 2",
            "text": "No, why?",
            "nextDialogs": [
              "732790410"
            ]
          },
          "732790410": {
            "id": "732790410",
            "speakerId": 20937,
            "speakerName": "Fatui Skirmisher No. 1",
            "text": "Hmm... I thought I heard someone saying time to eat.",
            "nextDialogs": [
              "732790411"
            ]
          },
          "732790411": {
            "id": "732790411",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "Hehe, see?",
            "nextDialogs": [
              "732790412"
            ]
          },
          "732790412": {
            "id": "732790412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon didn't know Liloupar has a childlike side! Hehe, it's adorable.",
            "nextDialogs": [
              "732790413"
            ]
          },
          "732790413": {
            "id": "732790413",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Look! Over there! Is that Tadhla they got locked up?",
            "nextDialogs": [
              "732790414"
            ]
          },
          "732790414": {
            "id": "732790414",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Tall, tanned, light-colored long hair... That should be her.",
            "nextDialogs": [
              "732790415"
            ]
          },
          "732790415": {
            "id": "732790415",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "Well done, little one. The task is upon us, my master.",
            "nextDialogs": [
              "732790416"
            ]
          },
          "732790416": {
            "id": "732790416",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Yeah, {NICKNAME}, let's do this!"
          }
        }
      }
    },
    {
      "subId": "7327905",
      "subQuestName": "Defeat the Fatui",
      "sceneId": null,
      "locations": [],

    {
      "subId": "7327906",
      "subQuestName": "Talk to Tadhla",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732790601"
        ],
        "dialogs": {
          "732790601": {
            "id": "732790601",
            "speakerId": 20842,
            "speakerName": "Tadhla",
            "text": "...",
            "nextDialogs": [
              "732790602"
            ]
          },
          "732790602": {
            "id": "732790602",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Um... Are you Tadhla? We are here to get you out!",
            "nextDialogs": [
              "732790603"
            ]
          },
          "732790603": {
            "id": "732790603",
            "speakerId": 20842,
            "speakerName": "Tadhla",
            "text": "Yes...? Oh, yes.",
            "nextDialogs": [
              "732790604"
            ]
          },
          "732790604": {
            "id": "732790604",
            "speakerId": 20842,
            "speakerName": "Tadhla",
            "text": "You let them go.",
            "nextDialogs": [
              "732790607"
            ]
          },
          "732790607": {
            "id": "732790607",
            "speakerId": 20842,
            "speakerName": "Tadhla",
            "text": "...They will flee and send warning to their comrades. Soon, they will all know that we are here.",
            "nextDialogs": [
              "732790608"
            ]
          },
          "732790608": {
            "id": "732790608",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "The wise are joined of thought. I like this girl.",
            "nextDialogs": [
              "732790609"
            ]
          },
          "732790609": {
            "id": "732790609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It doesn't matter. If they come back for us, we'll just kick their butts again! Although... you're injured. Do you need help?",
            "nextDialogs": [
              "732790610"
            ]
          },
          "732790610": {
            "id": "732790610",
            "speakerId": 20842,
            "speakerName": "Tadhla",
            "text": "I'm okay. I can still walk and find myself a decent place to die in peace.",
            "nextDialogs": [
              "732790611"
            ]
          },
          "732790611": {
            "id": "732790611",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh, that's a relief, she can still walk and find herself a decent place to— Hey! That's not what Paimon expected to hear!",
            "nextDialogs": [
              "732790612"
            ]
          },
          "732790612": {
            "id": "732790612",
            "speakerId": 20842,
            "speakerName": "Tadhla",
            "text": "Just kidding.",
            "nextDialogs": [
              "732790613"
            ]
          },
          "732790613": {
            "id": "732790613",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "Hahaha.",
            "nextDialogs": [
              "732790614"
            ]
          },
          "732790614": {
            "id": "732790614",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "I like this girl's humor... Her vagaries are most amusing.",
            "nextDialogs": [
              "732790615"
            ]
          },
          "732790615": {
            "id": "732790615",
            "speakerId": 20842,
            "speakerName": "Tadhla",
            "text": "Thank you. Let's return to the tribe."
          }
        }
      }
    },
    {
      "subId": "7327907",
      "subQuestName": "Talk to Masseira",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "732790701"
        ],
        "dialogs": {
          "732790701": {
            "id": "732790701",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Ah, here's my little Falcon! Thank you so much!",
            "nextDialogs": [
              "732790702"
            ]
          },
          "732790702": {
            "id": "732790702",
            "speakerId": 20842,
            "speakerName": "Tadhla",
            "text": "Sorry, I was ambushed. It was all thanks to them that I can return and see you again.",
            "nextDialogs": [
              "732790703"
            ]
          },
          "732790703": {
            "id": "732790703",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "\"Them\"? Your \"them\" is our esteemed Master of the Jinni!",
            "nextDialogs": [
              "732790704"
            ]
          },
          "732790704": {
            "id": "732790704",
            "speakerId": 20842,
            "speakerName": "Tadhla",
            "text": "I'm sorry...",
            "nextDialogs": [
              "732790705"
            ]
          },
          "732790705": {
            "id": "732790705",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh come on, it's okay! Tadhla is injured, be nice to her!",
            "nextDialogs": [
              "732790706"
            ]
          },
          "732790706": {
            "id": "732790706",
            "speakerId": 20842,
            "speakerName": "Tadhla",
            "text": "...",
            "nextDialogs": [
              "732790707"
            ]
          },
          "732790707": {
            "id": "732790707",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "You're injured?",
            "nextDialogs": [
              "732790708"
            ]
          },
          "732790708": {
            "id": "732790708",
            "speakerId": 20842,
            "speakerName": "Tadhla",
            "text": "I'm sorry.",
            "nextDialogs": [
              "732790709"
            ]
          },
          "732790709": {
            "id": "732790709",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "By what? Animal, or human?",
            "nextDialogs": [
              "732790710"
            ]
          },
          "732790710": {
            "id": "732790710",
            "speakerId": 20842,
            "speakerName": "Tadhla",
            "text": "It was the northerners. They ambushed me after realizing they were being followed.",
            "nextDialogs": [
              "732790711"
            ]
          },
          "732790711": {
            "id": "732790711",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "You should've been the ambusher.",
            "nextDialogs": [
              "732790712"
            ]
          },
          "732790712": {
            "id": "732790712",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Being attacked by the prey. What a shame for a Falcon.",
            "nextDialogs": [
              "732790713"
            ]
          },
          "732790713": {
            "id": "732790713",
            "speakerId": 20842,
            "speakerName": "Tadhla",
            "text": "...",
            "nextDialogs": [
              "732790714"
            ]
          },
          "732790714": {
            "id": "732790714",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Go rest. I'll tend to your wound later.",
            "nextDialogs": [
              "732790715"
            ]
          },
          "732790715": {
            "id": "732790715",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "Tadhla silently nods and slowly treads away in pain.",
            "nextDialogs": [
              "732790716"
            ]
          },
          "732790716": {
            "id": "732790716",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Masseira sure is a bit too strict with Tadhla...",
            "nextDialogs": [
              "732790718",
              "732790721"
            ]
          },
          "732790718": {
            "id": "732790718",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Hmm? No, that would be nonsense. She's my favorite Falcon. I love her, but I don't spoil her. How do you feed a Falcon if the Falcon comes back empty-handed?",
            "nextDialogs": [
              "732790719"
            ]
          },
          "732790719": {
            "id": "732790719",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "Ah, so such is the case... An ugly end awaits this girl.",
            "nextDialogs": [
              "732790723"
            ]
          },
          "732790723": {
            "id": "732790723",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Please accept this. You have my gratitude, esteemed Master of the Jinni.",
            "nextDialogs": [
              "732790724"
            ]
          },
          "732790724": {
            "id": "732790724",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "Ahem. Aren't you forgetting something? There are still two of us besides your Master of the Jinni.",
            "nextDialogs": [
              "732790725"
            ]
          },
          "732790725": {
            "id": "732790725",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hehe, Paimon doubts both of us are qualified to accept the reward...",
            "nextDialogs": [
              "732790726"
            ]
          },
          "732790726": {
            "id": "732790726",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "Ah... Yes, of course. The fact that this floating fairy is technically not a person has eluded me till thus, but perhaps the rest of us people may receive due thanks?",
            "nextDialogs": [
              "732790727"
            ]
          },
          "732790727": {
            "id": "732790727",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey!",
            "nextDialogs": [
              "732790728"
            ]
          },
          "732790728": {
            "id": "732790728",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Haha, my apologies. Please take this as an extra payment.",
            "nextDialogs": [
              "732790729"
            ]
          },
          "732790729": {
            "id": "732790729",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Ooh, extra payment!",
            "nextDialogs": [
              "732790730"
            ]
          },
          "732790730": {
            "id": "732790730",
            "speakerId": 17013,
            "speakerName": "Liloupar",
            "text": "...Still more paltry than my expectations... But I suppose I will accept this if you should not object, my master.",
            "nextDialogs": [
              "732790731"
            ]
          },
          "732790731": {
            "id": "732790731",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Very well. If you are available in the future, please come back one more time. I think my Falcon will need your help by then."
          },
          "732790721": {
            "id": "732790721",
            "speakerId": 4292,
            "speakerName": "Masseira",
            "text": "Harsh? No, instead I've been too kind to her. That's why she has become so... sloppy. All I'm doing is educating her. She's an outstanding Falcon. How could I ever hurt her?",
            "nextDialogs": [
              "732790722"
            ]
          },
          "732790722": {
            "id": "732790722",
            "speakerId": 17013,

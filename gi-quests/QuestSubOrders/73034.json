  "subQuests": [
    {
      "subId": "7303402",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730340201"
        ],
        "dialogs": {
          "730340201": {
            "id": "730340201",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Huh? What are you looking at?",
            "nextDialogs": [
              "730340202"
            ]
          },
          "730340202": {
            "id": "730340202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There are notes about taking care of flowers in this notebook.",
            "nextDialogs": [
              "730340203"
            ]
          },
          "730340203": {
            "id": "730340203",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Really? Paimon wants to see...",
            "nextDialogs": [
              "730340204"
            ]
          },
          "730340204": {
            "id": "730340204",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "\"... Should be placed in open space, and receive plenty of sunshine...\"",
            "nextDialogs": [
              "730340205"
            ]
          },
          "730340205": {
            "id": "730340205",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Guess Collei didn't have the time to move it outside.",
            "nextDialogs": [
              "730340206"
            ]
          },
          "730340206": {
            "id": "730340206",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hee-hee, let's take care of it for Collei then.",
            "nextDialogs": [
              "730340207"
            ]
          },
          "730340207": {
            "id": "730340207",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... Anyway, we should move the flower first. Let's put it beside the house.",
            "nextDialogs": [
              "730340208"
            ]
          },
          "730340208": {
            "id": "730340208",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Don't put it too far away, or Collei will be worried if she can't find it when she's back."
          }
        }
      }
    },
    {
      "subId": "7303406",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730340601"
        ],
        "dialogs": {
          "730340601": {
            "id": "730340601",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm, this letter seems to be written by Collei. Let's check it out.",
            "nextDialogs": [
              "730340602"
            ]
          },
          "730340602": {
            "id": "730340602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But why isn't she here...",
            "nextDialogs": [
              "730340603"
            ]
          },
          "730340603": {
            "id": "730340603",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Might be out working with Tighnari again. They have always been really busy.",
            "nextDialogs": [
              "730340604"
            ]
          },
          "730340604": {
            "id": "730340604",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Come on, read the letter. Just looking at this writing, Paimon bets Collei pressed down her pen really hard on the letter...",
            "nextDialogs": [
              "730340605"
            ]
          },
          "730340605": {
            "id": "730340605",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "#\"{NICKNAME} and Paimon, thanks for caring for my flower.\"",
            "nextDialogs": [
              "730340606"
            ]
          },
          "730340606": {
            "id": "730340606",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "\"We have so many things to deal with in the forest, and it's easy to forget about things when we get busy...\"",
            "nextDialogs": [
              "730340607"
            ]
          },
          "730340607": {
            "id": "730340607",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "\"Thanks again for your help. Let's eat some Potato Boats at Mr. Jahangir's place when I have some free time!\"",
            "nextDialogs": [
              "730340608"
            ]
          },
          "730340608": {
            "id": "730340608",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Whoa! Collei is gonna give us a treat! Paimon will write this down and remember it by heart.",
            "nextDialogs": [
              "730340609"
            ]
          },
          "730340609": {
            "id": "730340609",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... Paimon still has no idea what Collei is working on. She seems to have her hands full.",
            "nextDialogs": [
              "730340610"
            ]
          },
          "730340610": {
            "id": "730340610",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Paimon hopes she's still getting enough sleep..."
          }
        }
      }
    },
    {
      "subId": "7303499",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730349904"
        ],
        "dialogs": {
          "730349904": {
            "id": "730349904",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Okay, Paimon will leave this flower here to grow.",
            "nextDialogs": [
              "730349905"
            ]
          },
          "730349905": {
            "id": "730349905",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Hmm... Let's leave Collei a letter and tell her that we moved the flower out.",
            "nextDialogs": [
              "730349906"
            ]
          },
          "730349906": {
            "id": "730349906",
            "speakerId": 1000,
            "speakerName": "Paimon",
            "text": "Otherwise, she might think someone broke into her house."
          }
        }
      }
    }
  ]
}
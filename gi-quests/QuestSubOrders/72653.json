  "subQuests": [
    {
      "subId": "7265301",
      "subQuestName": "Talk to Muzhen",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "726530101"
        ],
        "dialogs": {
          "726530101": {
            "id": "726530101",
            "speakerId": 30055,
            "speakerName": "Muzhen",
            "text": "Traveler, you've returned!",
            "nextDialogs": [
              "726530102"
            ]
          },
          "726530102": {
            "id": "726530102",
            "speakerId": 30055,
            "speakerName": "Muzhen",
            "text": "I had a look at the crystals you brought back earlier. They seem rather... \"young.\"",
            "nextDialogs": [
              "726530103"
            ]
          },
          "726530103": {
            "id": "726530103",
            "speakerId": 30055,
            "speakerName": "Muzhen",
            "text": "By that, I mean that they come from rather recent elemental crystallizations... To strike a comparison, this is but a slightly deeper footprint recently left in the snow.",
            "nextDialogs": [
              "726530104"
            ]
          },
          "726530104": {
            "id": "726530104",
            "speakerId": 30055,
            "speakerName": "Muzhen",
            "text": "So this time, I'd like you to look for footprints that are more \"shallow\"... and follow them to their source!",
            "nextDialogs": [
              "726530105"
            ]
          },
          "726530105": {
            "id": "726530105",
            "speakerId": 30055,
            "speakerName": "Muzhen",
            "text": "When I say \"shallow footprints,\" I mean deposits of Electro elements that have condensed to a certain extent near the ground.",
            "nextDialogs": [
              "726530106"
            ]
          },
          "726530106": {
            "id": "726530106",
            "speakerId": 30055,
            "speakerName": "Muzhen",
            "text": "If we are able to obtain sufficient samples of that for comparison, we should be able to draw a general route map.",
            "nextDialogs": [
              "726530107"
            ]
          },
          "726530107": {
            "id": "726530107",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Shallow and deep footprints... route maps... Paimon's got no idea what you're on about.",
            "nextDialogs": [
              "726530108"
            ]
          },
          "726530108": {
            "id": "726530108",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "It is rather complicated...",
            "nextDialogs": [
              "726530109"
            ]
          },
          "726530109": {
            "id": "726530109",
            "speakerId": 30055,
            "speakerName": "Muzhen",
            "text": "Well, maybe my analogy wasn't the best, but I think you'll figure it out just fine once you're there!",
            "nextDialogs": [
              "726530110"
            ]
          },
          "726530110": {
            "id": "726530110",
            "speakerId": 30055,
            "speakerName": "Muzhen",
            "text": "Well, guess that's all for the chit-chat. Time to get moving!"
          }
        }
      }
    },
    {

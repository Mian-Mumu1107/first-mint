    {
      "subId": "7010207",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701020701"
        ],
        "dialogs": {
          "701020701": {
            "id": "701020701",
            "speakerId": 1004,
            "speakerName": "Core",
            "text": "(A strange glow emanates from this peculiar object...)",
            "nextDialogs": [
              "701020702"
            ]

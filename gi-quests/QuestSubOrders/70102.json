  "subQuests": [
    {
      "subId": "7010202",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701020201"
        ],
        "dialogs": {
          "701020201": {
            "id": "701020201",
            "speakerId": 1000,
            "speakerName": "Traveler",
            "text": "What do you make of this tooth?",
            "nextDialogs": [
              "701020202"
            ]
          },
          "701020202": {
            "id": "701020202",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "A tooth? Ugh, don't tell me you've been foraging around on the mountain for junk...",
            "nextDialogs": [
              "701020203"
            ]
          },
          "701020203": {
            "id": "701020203",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "...Huh, although, as teeth go...",
            "nextDialogs": [
              "701020204"
            ]
          },
          "701020204": {
            "id": "701020204",
            "speakerId": 1000,
            "speakerName": "Traveler",
            "text": "What? What is it?",
            "nextDialogs": [
              "701020205"
            ]
          },
          "701020205": {
            "id": "701020205",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "This is a rather fine specimen. Tough as nails, too...",
            "nextDialogs": [
              "701020206"
            ]
          },
          "701020206": {
            "id": "701020206",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "And these contours... Looks an awful lot like Dragontooth to me.",
            "nextDialogs": [
              "701020207"
            ]
          },
          "701020207": {
            "id": "701020207",
            "speakerId": 1000,
            "speakerName": "Traveler",
            "text": "What do you mean, \"Dragontooth\"?",
            "nextDialogs": [
              "701020208"
            ]
          },
          "701020208": {
            "id": "701020208",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "As in, the tooth of a dragon. Weapons made from Dragontooth are supposed to be extraordinarily strong and sharp... and even possess some sort of strange power.",
            "nextDialogs": [
              "701020209"
            ]
          },
          "701020209": {
            "id": "701020209",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "It's hardly the sort of thing you come across every day, though... In all the stories you hear, it's only ever the most famous heroes who manage to acquire Dragontooth and craft weapons from it.",
            "nextDialogs": [
              "701020210"
            ]
          },
          "701020210": {
            "id": "701020210",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "As they say, if you plan on slaying the dragon to pinch his teeth... you'd better be sure to have a dragon-slayer of a weapon handy, or he might just bite back!",
            "nextDialogs": [
              "701020211"
            ]
          },
          "701020211": {
            "id": "701020211",
            "speakerId": 1000,
            "speakerName": "Traveler",
            "text": "Then... is this really a dragon's tooth, or not?",
            "nextDialogs": [
              "701020212"
            ]
          },
          "701020212": {
            "id": "701020212",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Honestly, I've never dealt with Dragontooth firsthand, so I can't give a definite answer.",
            "nextDialogs": [
              "701020213"
            ]
          },
          "701020213": {
            "id": "701020213",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "I do think it has to be the tooth of some enormous beast or other...",
            "nextDialogs": [
              "701020214"
            ]
          },
          "701020214": {
            "id": "701020214",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Anyway, since you've gone to all this effort... let's just treat it as if it really is a genuine, precious piece of Dragontooth, shall we?",
            "nextDialogs": [
              "701020215"
            ]
          },
          "701020215": {
            "id": "701020215",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Hmm, but that said — it's not enough to make a weapon from.",
            "nextDialogs": [
              "701020216"
            ]
          },
          "701020216": {
            "id": "701020216",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "How about you go find, say, three more pieces of Dragontooth, and in the meantime, I'll do some reading and find out how to work with this stuff.",
            "nextDialogs": [
              "701020217"
            ]
          },
          "701020217": {
            "id": "701020217",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Oh — and <color=#00E1FFFF>Dragontooth</color> aside, we'll want to supplement it with some good ore...",
            "nextDialogs": [
              "701020218"
            ]
          },
          "701020218": {
            "id": "701020218",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "In which case, while you're up on the mountain, grab 50 pieces of <color=#00E1FFFF>Starsilver</color>.",
            "nextDialogs": [
              "701020220"
            ]
          },
          "701020220": {
            "id": "701020220",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Ah yes, and as well as all that... I'm also going to need a <color=#00E1FFFF>Northlander Polearm Billet</color>...",
            "nextDialogs": [
              "701020219"
            ]
          },
          "701020219": {
            "id": "701020219",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Once you've got all of that, come and see me again."
          }
        }
      }
    },
    {
      "subId": "7010203",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701020301"
        ],
        "dialogs": {
          "701020301": {
            "id": "701020301",
            "speakerId": 1000,
            "speakerName": "Traveler",
            "text": "I found some more Dragontooth...",
            "nextDialogs": [
              "701020302"
            ]
          },
          "701020302": {
            "id": "701020302",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Ah, I was hoping you'd swing by. Listen, before you go gathering all that Dragontooth... Oh. I see you've already finished.",
            "nextDialogs": [
              "701020303"
            ]
          },
          "701020303": {
            "id": "701020303",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "My profuse apologies... but I've hit a slight snag. No matter what I hit this thing with, I simply cannot take so much as a sliver off of it.",
            "nextDialogs": [
              "701020304"
            ]
          },
          "701020304": {
            "id": "701020304",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "It's almost as if it really were Dragontooth... If so, then based on what I read, there are several rather specific methods to work with this material.",
            "nextDialogs": [
              "701020305"
            ]
          },
          "701020305": {
            "id": "701020305",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "One of them is to have the dragon's tooth absorb some sort of... dragon-related \"vitality.\"",
            "nextDialogs": [
              "701020306"
            ]
          },
          "701020306": {
            "id": "701020306",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Then, use the dragon's tooth infused with dragon vitality to work the other pieces of Dragontooth into shape.",
            "nextDialogs": [
              "701020307"
            ]
          },
          "701020307": {
            "id": "701020307",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "But how to go about infusing something with dragon vitality... I haven't the foggiest idea.",
            "nextDialogs": [
              "701020308"
            ]
          },
          "701020308": {
            "id": "701020308",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Any thoughts, Traveler?",
            "nextDialogs": [
              "701020309"
            ]
          },
          "701020309": {
            "id": "701020309",
            "speakerId": 1000,
            "speakerName": "Traveler",
            "text": "I'll, um... see what I can do.",
            "nextDialogs": [
              "701020310"
            ]
          },
          "701020310": {
            "id": "701020310",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Great! Here — you take this Dragontooth, then, and I'll leave that whole side of things to you.",
            "nextDialogs": [
              "701020311"
            ]
          },
          "701020311": {
            "id": "701020311",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Huh, if just the teeth cause this much hassle, whole dragons must be seriously complicated creatures..."
          }
        }
      }
    },
    {
      "subId": "7010204",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701020401"
        ],
        "dialogs": {
          "701020401": {
            "id": "701020401",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, it's... What is it?",
            "nextDialogs": [
              "701020402"
            ]
          },
          "701020402": {
            "id": "701020402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It looks just like a heart, doesn't it?",
            "nextDialogs": [
              "701020403"
            ]
          },
          "701020403": {
            "id": "701020403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "...Can we go now? It really is super creepy here."
          }
        }
      }
    },
    {
      "subId": "7010205",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701020501"
        ],
        "dialogs": {
          "701020501": {
            "id": "701020501",
            "speakerId": 1000,
            "speakerName": "Traveler",
            "text": "I'm here about the Dragontooth again...",
            "nextDialogs": [
              "701020502"
            ]
          },
          "701020502": {
            "id": "701020502",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "My goodness, the luster... and the texture...",
            "nextDialogs": [
              "701020503"
            ]
          },
          "701020503": {
            "id": "701020503",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "You actually managed it? You infused the tooth with dragon vitality? Wow... You are one extraordinary individual, my friend.",
            "nextDialogs": [
              "701020504"
            ]
          },
          "701020504": {
            "id": "701020504",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "This is great... I've already got someone to handle the Starsilver. Give me a moment or two, I will get this weapon made right away..."
          }
        }
      }
    },
    {
      "subId": "7010206",
      "subQuestName": "Ask the adventurers at the camp for news",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701020102"
        ],
        "dialogs": {
          "701020102": {
            "id": "701020102",
            "speakerId": 1000,
            "speakerName": "Traveler",
            "text": "Any ideas about this tooth?",
            "nextDialogs": [
              "701020103"
            ]
          },
          "701020103": {
            "id": "701020103",
            "speakerId": 1665,
            "speakerName": "Iris",
            "text": "A tooth? Let me see.",
            "nextDialogs": [
              "701020104"
            ]
          },
          "701020104": {
            "id": "701020104",
            "speakerId": 1665,
            "speakerName": "Iris",
            "text": "Hmm... Yes, it is a little unusual, both in shape and in size.",
            "nextDialogs": [
              "701020105"
            ]
          },
          "701020105": {
            "id": "701020105",
            "speakerId": 1665,
            "speakerName": "Iris",
            "text": "I'm no expert on obscure materials... Orban may know something though, he comes across all sorts of materials in the process of forging weaponry.",
            "nextDialogs": [
              "701020106"
            ]
          },
          "701020106": {
            "id": "701020106",
            "speakerId": 1665,
            "speakerName": "Iris",
            "text": "Why not go and ask him? He's right over there, you can't miss him."
          }
        }
      }
    },
    {
      "subId": "7010207",
      "subQuestName": "Talk to Orban",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],

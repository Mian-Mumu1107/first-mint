      }
    },
    {
      "subId": "7010208",
      "subQuestName": "Look for another three Strange Teeth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7010209",
      "subQuestName": "Look for another three Strange Teeth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701020901"
        ],
        "dialogs": {
          "701020901": {
            "id": "701020901",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "There! It's done! Haha! Here, hold that. How does it feel?",
            "nextDialogs": [
              "701020902"
            ]
          },
          "701020902": {
            "id": "701020902",
            "speakerId": 1000,
            "speakerName": "Traveler",
            "text": "How much do I owe you?",
            "nextDialogs": [
              "701020903"
            ]
          },
          "701020903": {
            "id": "701020903",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Oh, don't worry about paying for it. The chance to work with these materials was a rare pleasure, no need to bring Mora into it.",
            "nextDialogs": [
              "701020904"
            ]
          },
          "701020904": {
            "id": "701020904",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Alright. I'd say this weapon is ready for an adventure, wouldn't you? I hope you'll take good care of it."
          }
        }
      }
    },
    {
      "subId": "7010210",
      "subQuestName": "Look for another three Strange Teeth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701021001"
        ],
        "dialogs": {
          "701021001": {
            "id": "701021001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Interesting... Something looks a little different about this Dragontooth now. And it seems more ominous, too...",
            "nextDialogs": [
              "701021002"
            ]
          },
          "701021002": {
            "id": "701021002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Let's get back and give it to Orban."
          }
        }
      }
    },
    {
      "subId": "7010211",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701021101"
        ],
        "dialogs": {
          "701021101": {
            "id": "701021101",
            "speakerId": 1004,
            "speakerName": "Core",
            "text": "(This strange object seems to be reacting...)"
          }
        }
      }
    },
    {
      "subId": "7010212",
      "subQuestName": "Look for another three Strange Teeth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701021201"
        ],
        "dialogs": {
          "701021201": {
            "id": "701021201",
            "speakerId": 1665,
            "speakerName": "Iris",
            "text": "Have you been exploring up in the mountains? Alone!? Goodness. I'm impressed..."
          }
        }
      }
    },
    {
      "subId": "7010213",
      "subQuestName": "Look for another three Strange Teeth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701021301"
        ],
        "dialogs": {
          "701021301": {
            "id": "701021301",
            "speakerId": 1000,
            "speakerName": "Traveler",
            "text": "Take a look at these dragon teeth...",
            "nextDialogs": [
              "701021302"
            ]
          },
          "701021302": {
            "id": "701021302",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Wow, these are incredible... Are these genuine Dragontooth?",
            "nextDialogs": [
              "701021303"
            ]
          },
          "701021303": {
            "id": "701021303",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "If so... That would be truly amazing."
          }
        }
      }
    },
    {
      "subId": "7010214",
      "subQuestName": "Look for another three Strange Teeth",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "701021401"
        ],
        "dialogs": {
          "701021401": {
            "id": "701021401",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "Thoughts on this Dragontooth?",
            "nextDialogs": [
              "701021402"
            ]
          },
          "701021402": {
            "id": "701021402",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "I can't say whether it really is Dragontooth or not, but the quality is superb. A few more like this, supplemented with some Starsilver, and you could definitely make a good weapon from it.",
            "nextDialogs": [
              "701021404"
            ]
          },
          "701021404": {
            "id": "701021404",
            "speakerId": 1667,
            "speakerName": "Orban",
            "text": "As soon as you've gathered all that, bring the goods straight back here."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7615901",
      "subQuestName": "Talk to Nicole",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761590101"
        ],
        "dialogs": {
          "761590101": {
            "id": "761590101",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Leaving already? Hey, Barbie! Aren't you forgetting something? Like a whole bunch of stuff you were supposed to give...",
            "nextDialogs": [
              "761590102"
            ]
          },
          "761590102": {
            "id": "761590102",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "...me.",
            "nextDialogs": [
              "761590105"
            ]
          },
          "761590105": {
            "id": "761590105",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Nonsense, your arrival is more or less in line with Barbie's prophecy... Though to be honest, I did think you'd be here a little later.",
            "nextDialogs": [
              "761590106"
            ]
          },
          "761590106": {
            "id": "761590106",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Anyway... Before we get down to business, it might be best if you two... have something to eat?"
          }
        }
      }
    },
    {
      "subId": "7615902",
      "subQuestName": "Talk to Nicole",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761590201"
        ],
        "dialogs": {
          "761590201": {
            "id": "761590201",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "In the blink of an eye, you find yourselves standing at the edge of a cliff...",
            "nextDialogs": [
              "761590202"
            ]
          },
          "761590202": {
            "id": "761590202",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Alright, we're here. This Seelie Court has some really great views, don't you think? See that spot over there? That's the starting point.",
            "nextDialogs": [
              "761590205"
            ]
          },
          "761590205": {
            "id": "761590205",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Did I use it to get us here faster? You bet I did! These Seelie Courts are connected to the Ley Lines, and nobody really uses them. They're very handy when it comes to traveling about.",
            "nextDialogs": [
              "761590206"
            ]
          },
          "761590206": {
            "id": "761590206",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Besides, the Seelie and I used to be angels, so we're old colleagues. I'm sure they won't mind me borrowing their homes every once in a while.",
            "nextDialogs": [
              "761590207"
            ]
          },
          "761590207": {
            "id": "761590207",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There doesn't seem to be anyone else around...",
            "nextDialogs": [
              "761590208"
            ]
          },
          "761590208": {
            "id": "761590208",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "We're early. In but a short while, a bard will come to sing odes of old and call back the thousand winds that wander the ages...",
            "nextDialogs": [
              "761590209"
            ]
          },
          "761590209": {
            "id": "761590209",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I don't suppose this homework is for...",
            "nextDialogs": [
              "761590210"
            ]
          },
          "761590210": {
            "id": "761590210",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Shh... Patience. All will be revealed in time. Before long, you will become a single lilting melody ensconced in an ode, and the thousand winds will swirl around you.",
            "nextDialogs": [
              "761590211"
            ]
          },
          "761590211": {
            "id": "761590211",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "But before that happens, we should allow it to slumber in peace... Come, let's head to our next location."
          }
        }
      }
    },
    {
      "subId": "7615908",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761590801"

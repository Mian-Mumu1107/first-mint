    },
    {
      "subId": "7615903",
      "subQuestName": "Talk to Nicole",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761590301"
        ],
        "dialogs": {
          "761590301": {
            "id": "761590301",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Is this Wolvendom? Doesn't seem like the best place for doing \"homework\"...",
            "nextDialogs": [
              "761590302"
            ]
          },
          "761590302": {
            "id": "761590302",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "This is the nearest Seelie Court to where we're going. Don't worry, we're not far from the starting point.",
            "nextDialogs": [
              "761590303"
            ]
          },
          "761590303": {
            "id": "761590303",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Whoa! Where did all those wolves jump out from!? Hey... We're not here to hurt you! We're friends with Razor...",
            "nextDialogs": [
              "761590304"
            ]
          },
          "761590304": {
            "id": "761590304",
            "speakerId": 1003,
            "speakerName": "Wolf Pack",
            "text": "...",
            "nextDialogs": [
              "761590307"
            ]
          },
          "761590307": {
            "id": "761590307",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "Shh. Has that child not arrived yet? Perhaps we've come too early again. Not to worry, as long as he stands beside his \"lupical\", he can overcome any foe.",
            "nextDialogs": [
              "761590308"
            ]
          },
          "761590308": {
            "id": "761590308",
            "speakerId": 1003,
            "speakerName": "Wolf Pack",
            "text": "...",
            "nextDialogs": [
              "761590309"
            ]
          },
          "761590309": {
            "id": "761590309",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Why've they come back? Did they hear us talking? If only Razor were here, he'd be able to tell us what they want to say...",
            "nextDialogs": [
              "761590310"
            ]
          },
          "761590310": {
            "id": "761590310",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "You're not wrong, Paimon, but there's a lot more he'd need to understand than just the chatter of wolves..."
          }
        }
      }
    },
    {
      "subId": "7615905",
      "subQuestName": "Enter the room",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761590501"
        ],
        "dialogs": {
          "761590501": {
            "id": "761590501",
            "speakerId": 1004,
            "speakerName": "Read Alice's note...",
            "text": "\"Thanks for your help with the homework! Now hurry home and have a hot cup of tea!\"",
            "nextDialogs": [
              "761590502"
            ]
          },
          "761590502": {
            "id": "761590502",
            "speakerId": 1004,
            "speakerName": "Read Alice's note...",
            "text": "\"P.S. There is a surprise waiting behind this door!\""
          }
        }
      }
    },
    {
      "subId": "7615906",
      "subQuestName": "Talk to Nicole",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761590601"
        ],
        "dialogs": {
          "761590601": {
            "id": "761590601",
            "speakerId": 1002,
            "speakerName": "Paimon",
            "text": "Somewhere new? Hey, isn't this...",
            "nextDialogs": [
              "761590604"
            ]
          },
          "761590604": {
            "id": "761590604",
            "speakerId": 1000,
            "speakerName": "Nicole",
            "text": "No wonder Alice wanted to borrow the lodge key... She said she wanted to set up a tea room, even though I told her I already had one..."
          }
        }
      }
    },

  "subQuests": [
    {
      "subId": "7721401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "772140101"
        ],
        "dialogs": {
          "772140101": {
            "id": "772140101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm, that's odd... What is this? Some kind of ... invite?",
            "nextDialogs": [
              "772140102"
            ]
          },
          "772140102": {
            "id": "772140102",
            "speakerId": 22280,
            "speakerName": "Eye of Graeae",
            "text": "It's an invitation...",
            "nextDialogs": [
              "772140103"
            ]
          },
          "772140103": {
            "id": "772140103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "An invitation? Let Paimon take a look... Hmm. It says Pavlina, Grand Duchess of the Snegurochka, is inviting... whoever's holding this invitation to attend a wedding...?",
            "nextDialogs": [
              "772140104"
            ]
          },
          "772140104": {
            "id": "772140104",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Those who wish to attend the ceremony may present this invitation as proof that they have been invited...\"",
            "nextDialogs": [
              "772140105"
            ]
          },
          "772140105": {
            "id": "772140105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... So the wedding is being held at... House of Hesp-something, up on the snowy mountain...",
            "nextDialogs": [
              "772140106"
            ]
          },
          "772140106": {
            "id": "772140106",
            "speakerId": 22280,
            "speakerName": "Eye of Graeae",
            "text": "House of Hesperides. Yes. It was once home to the sovereign who ruled over the Snegovik. As for Pavlina...",
            "nextDialogs": [
              "772140107"
            ]
          },
          "772140107": {
            "id": "772140107",
            "speakerId": 22280,
            "speakerName": "Eye of Graeae",
            "text": "That name does sound faintly familiar...",
            "nextDialogs": [
              "772140108"
            ]
          },
          "772140108": {
            "id": "772140108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So, Pavlina, the princess of the Snegurochka, might be tied to Goggles' past too?",
            "nextDialogs": [
              "772140109"
            ]
          },
          "772140109": {
            "id": "772140109",
            "speakerId": 22280,
            "speakerName": "Eye of Graeae",
            "text": "Most likely.",
            "nextDialogs": [
              "772140110"
            ]
          },
          "772140110": {
            "id": "772140110",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Oh... Let's go check out this princess's wedding, then!"
          }
        }
      }
    },

      "dialogue": {
        "startDialogs": [
          "10293301"
        ],
        "dialogs": {
          "10293301": {
            "id": "10293301",
            "speakerId": 1002,
            "speakerName": "Arataki Itto",
            "text": "Hey, Ushi, looks like our little Lavender Melon has fallen asleep, huh? Do ya think she's dreaming?",
            "nextDialogs": [
              "10293302"
            ]
          },
          "10293302": {
            "id": "10293302",
            "speakerId": 1003,
            "speakerName": "Ushi",
            "text": "Moo? Moo.",
            "nextDialogs": [
              "10293303"
            ]
          },
          "10293303": {
            "id": "10293303",
            "speakerId": 1002,
            "speakerName": "Arataki Itto",
            "text": "Man, she looks wiped out. It's kinda hard to see her like this, I mean, most of the time she never shuts up... Ah, poor thing.",
            "nextDialogs": [
              "10293304"
            ]
          },
          "10293304": {
            "id": "10293304",
            "speakerId": 1002,
            "speakerName": "Arataki Itto",
            "text": "And that little dude looks done in, too. Ah, I'm kinda worried about 'em.",
            "nextDialogs": [
              "10293305"
            ]
          },
          "10293305": {
            "id": "10293305",
            "speakerId": 1003,
            "speakerName": "Ushi",
            "text": "Moo, moo, moo.",
            "nextDialogs": [
              "10293306"
            ]
          },
          "10293306": {
            "id": "10293306",
            "speakerId": 1002,
            "speakerName": "Arataki Itto",
            "text": "I sleep like this when I'm in jail? Hah! Good one. I do slumber like a king.",
            "nextDialogs": [
              "10293307"
            ]
          },
          "10293307": {
            "id": "10293307",
            "speakerId": 1002,
            "speakerName": "Arataki Itto",
            "text": "#{NICKNAME}!? When did you get here?"
          }
        }
      }
    },

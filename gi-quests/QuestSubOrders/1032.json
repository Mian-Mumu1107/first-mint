          "10320102": {
            "id": "10320102",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Are you alright? You've suddenly gone quiet. It's not like you at all.",
            "nextDialogs": [
              "10320103"
            ]
          },
          "10320103": {
            "id": "10320103",
            "speakerId": 1000,
            "speakerName": "Yanfei",
            "text": "Shh, we'll talk later. I'm just processing all the existing clues we have.",
            "nextDialogs": [
              "10320104"
            ]
          },
          "10320104": {
            "id": "10320104",
            "speakerId": 1000,
            "speakerName": "Yanfei",
            "text": "Maybe the key to our escape is hidden in some detail I've overlooked... I have to go over everything again...",
            "nextDialogs": [
              "10320105"
            ]
          },
          "10320105": {
            "id": "10320105",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "Alright, well...",
            "nextDialogs": [
              "10320106"
            ]
          },
          "10320106": {
            "id": "10320106",
            "speakerId": 1000,
            "speakerName": "Yanfei",
            "text": "Oh, don't worry. I won't write down anything that you told us about.",
            "nextDialogs": [
              "10320107"
            ]
          },
          "10320107": {
            "id": "10320107",
            "speakerId": 1001,
            "speakerName": "Yelan",
            "text": "No, I meant, if you're going to analyze the facts, count me in."
          }
        }
      }

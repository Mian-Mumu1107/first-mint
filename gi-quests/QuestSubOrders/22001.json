    {
      "subId": "2200104",
      "subQuestName": "Find Lotus Head",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220010401"
        ],
        "dialogs": {
          "220010401": {
            "id": "220010401",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Did you find some Lotus Heads yet?",
            "nextDialogs": [
              "220010402"
            ]
          },
          "220010402": {
            "id": "220010402",
            "speakerId": 1004,
            "speakerName": "<UNKNOWN>",
            "text": "Yup.",
            "nextDialogs": [
              "220010403"
            ]
          },
          "220010403": {
            "id": "220010403",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "You're the meanie!",
            "nextDialogs": [
              "220010404"
            ]
          },
          "220010404": {
            "id": "220010404",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "No, you're the meanie!",
            "nextDialogs": [
              "220010405"
            ]
          },
          "220010405": {
            "id": "220010405",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Stop fighting. You're only going to wear yourselves out.",
            "nextDialogs": [
              "220010406"
            ]
          },
          "220010406": {
            "id": "220010406",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "It's just a game, there's no need to get so mad. We're all friends, right?",
            "nextDialogs": [
              "220010407"
            ]
          },
          "220010407": {
            "id": "220010407",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "And look what I've got... Freshly picked Lotus Heads! Go on, help yourselves.",
            "nextDialogs": [
              "220010408"
            ]
          },
          "220010408": {
            "id": "220010408",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Once you've eaten, we're gonna straighten all this out.",
            "nextDialogs": [
              "220010409"
            ]
          },
          "220010409": {
            "id": "220010409",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "We'll decide who gets to be the captain and the first mate, and in what order. Sound good?",
            "nextDialogs": [
              "220010410"
            ]
          },
          "220010410": {
            "id": "220010410",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Fine...",
            "nextDialogs": [
              "220010411"
            ]
          },
          "220010411": {
            "id": "220010411",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Okay...",
            "nextDialogs": [
              "220010412"
            ]
          },
          "220010412": {
            "id": "220010412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, it actually worked! Peace and quiet at last.",
            "nextDialogs": [
              "220010413"
            ]
          },
          "220010413": {
            "id": "220010413",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Told you so!",
            "nextDialogs": [
              "220010415",
              "220010417"
            ]
          },
          "220010415": {
            "id": "220010415",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "We've been playing together a long time. I know these things."
          },
          "220010417": {
            "id": "220010417",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Heeh-hee, thanks. But Beidou is the real miracle worker.",
            "nextDialogs": [
              "220010418"
            ]
          },
          "220010418": {
            "id": "220010418",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "I hope I can be like her when I grow up..."
          }
        }
      }
    },

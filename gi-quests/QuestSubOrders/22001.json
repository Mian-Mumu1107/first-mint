    {
      "subId": "2200107",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220010701"
        ],
        "dialogs": {
          "220010701": {
            "id": "220010701",
            "speakerId": 12621,
            "speakerName": "Little Meng",
            "text": "You traitor! This is mutiny!",
            "nextDialogs": [
              "220010702"
            ]
          },
          "220010702": {
            "id": "220010702",
            "speakerId": 12620,
            "speakerName": "Little Fei",
            "text": "What, you can't cope with things not going your way for a change?",
            "nextDialogs": [
              "220010703"
            ]
          },
          "220010703": {
            "id": "220010703",
            "speakerId": 12621,
            "speakerName": "Little Meng",
            "text": "I'm never sharing my Lotus Heads with you EVER again!",
            "nextDialogs": [
              "220010704"
            ]
          },
          "220010704": {
            "id": "220010704",
            "speakerId": 12620,
            "speakerName": "Little Fei",
            "text": "FINE! It's only you who cares so much about stupid Lotus Heads anyway!",
            "nextDialogs": [
              "220010705"
            ]
          },
          "220010705": {
            "id": "220010705",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Haha... This looks like it could take a while..."
          }
        }
      }
    },
    {
      "subId": "2200108",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220010801"
        ],
        "dialogs": {
          "220010801": {
            "id": "220010801",
            "speakerId": 12622,
            "speakerName": "Little Lulu",
            "text": "Did you find some Lotus Heads yet?",
            "nextDialogs": [
              "220010802"
            ]
          },
          "220010802": {
            "id": "220010802",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Not yet...",
            "nextDialogs": [
              "220010803"
            ]
          },
          "220010803": {
            "id": "220010803",
            "speakerId": 12622,
            "speakerName": "Little Lulu",
            "text": "You'd better hurry up, the longer they're like this the worse it'll get."
          }
        }
      }

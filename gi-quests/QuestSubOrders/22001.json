  "subQuests": [
    {
      "subId": "2200101",
      "subQuestName": "Talk to Little Lulu, Little Fei, and Little Meng",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220010101"
        ],
        "dialogs": {
          "220010101": {
            "id": "220010101",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Meng, today I get to be the captain — right?",
            "nextDialogs": [
              "220010102"
            ]
          },
          "220010102": {
            "id": "220010102",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Lulu, I've been the captain loads of times in a row now, we should let Fei have a turn.",
            "nextDialogs": [
              "220010103"
            ]
          },
          "220010103": {
            "id": "220010103",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "But Meng, you're the bestest captain ever! I want you to keep being it...",
            "nextDialogs": [
              "220010104"
            ]
          },
          "220010104": {
            "id": "220010104",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "220010105"
            ]
          },
          "220010105": {
            "id": "220010105",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "We're trying to play a game. They promised me I could be the captain this time...",
            "nextDialogs": [
              "220010106"
            ]
          },
          "220010106": {
            "id": "220010106",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "But Lulu keeps saying it's way more fun when Meng is the captain.",
            "nextDialogs": [
              "220010107"
            ]
          },
          "220010107": {
            "id": "220010107",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "*sigh* Lulu always does this... But, if it's what she wants... I guess it's fine by me.",
            "nextDialogs": [
              "220010108"
            ]
          },
          "220010108": {
            "id": "220010108",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Hey, do you have time to join in? You can be the pirate!",
            "nextDialogs": [
              "220010110",
              "220010112"
            ]
          },
          "220010110": {
            "id": "220010110",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "*sigh* Once again, as always, I'm just the first mate...",
            "nextDialogs": [
              "220010113"
            ]
          },
          "220010113": {
            "id": "220010113",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Just like last time, come and join us when you're ready."
          },
          "220010112": {
            "id": "220010112",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "*sigh* Ah, I really wanna be the captain..."
          }
        }
      }
    },
    {
      "subId": "2200102",
      "subQuestName": "Talk to \"First Mate\" Little Fei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220010601"
        ],
        "dialogs": {
          "220010601": {
            "id": "220010601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ready.",
            "nextDialogs": [
              "220010602"
            ]
          },
          "220010602": {
            "id": "220010602",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Alright then. I guess we can start.",
            "nextDialogs": [
              "220010603"
            ]
          },
          "220010603": {
            "id": "220010603",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "I hate being the first mate...",
            "nextDialogs": [
              "220010604"
            ]
          },
          "220010604": {
            "id": "220010604",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Lulu and Meng only care about themselves...",
            "nextDialogs": [
              "220010605"
            ]
          },
          "220010605": {
            "id": "220010605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Ar! Do I spy me some pieces of eight? Hand 'em over!",
            "nextDialogs": [
              "220010606"
            ]
          },
          "220010606": {
            "id": "220010606",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Oh, hi pirate. Sorry, I'm just a poor first mate with nothing for you to steal.",
            "nextDialogs": [
              "220010607"
            ]
          },
          "220010607": {
            "id": "220010607",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "If you're here to rob the boat, you need to find someone with enough money... Hmm...",
            "nextDialogs": [
              "220010608"
            ]
          },
          "220010608": {
            "id": "220010608",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "I know! The captain is really rich — you should go and steal from him!",
            "nextDialogs": [
              "220010609"
            ]
          },
          "220010609": {
            "id": "220010609",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wh—What!? Don't you work on this boat?",
            "nextDialogs": [
              "220010610"
            ]
          },
          "220010610": {
            "id": "220010610",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Yeah! That means I know how to find the captain.",
            "nextDialogs": [
              "220010611"
            ]
          },
          "220010611": {
            "id": "220010611",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "He's just a captain anyway... What's so special about that...",
            "nextDialogs": [
              "220010612"
            ]
          },
          "220010612": {
            "id": "220010612",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Come with me! I'll take you to the captain..."
          }
        }
      }
    },
    {
      "subId": "2200103",
      "subQuestName": "Find Captain with Little Fei",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "220010301"
        ],
        "dialogs": {
          "220010301": {
            "id": "220010301",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Here we are! Here's the captain!",
            "nextDialogs": [
              "220010302"
            ]
          },
          "220010302": {
            "id": "220010302",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "What are you doing, bringing the pirates here!? You should've led them on a wild goose chase so that me and Lulu would have time to escape!",
            "nextDialogs": [
              "220010303"
            ]
          },
          "220010303": {
            "id": "220010303",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Why do you and Lulu get to escape while I have to stay here and hold the pirates up!?",
            "nextDialogs": [
              "220010304"
            ]
          },
          "220010304": {
            "id": "220010304",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "I got a better idea: I give you over to the pirates while I escape with Lulu!",
            "nextDialogs": [
              "220010305"
            ]
          },
          "220010305": {
            "id": "220010305",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "But... Beidou says you should never abandon your friends!",
            "nextDialogs": [
              "220010306"
            ]
          },
          "220010306": {
            "id": "220010306",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "Oh? And does Beidou also say that the captain should run away with their favorite person at the first sign of trouble!?",
            "nextDialogs": [
              "220010307"
            ]
          },
          "220010307": {
            "id": "220010307",
            "speakerId": 2031,
            "speakerName": "Little Meng",
            "text": "Why you little... I'm never sharing my Lotus Heads with you EVER again!",
            "nextDialogs": [
              "220010308"
            ]
          },
          "220010308": {
            "id": "220010308",
            "speakerId": 2030,
            "speakerName": "Little Fei",
            "text": "FINE! It's only you who cares so much about stupid Lotus Heads anyway!",
            "nextDialogs": [
              "220010309"
            ]
          },
          "220010309": {
            "id": "220010309",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "They are blowing this way out of proportion...",
            "nextDialogs": [
              "220010310"
            ]
          },
          "220010310": {
            "id": "220010310",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Don't worry, I know a way we can sort this out.",
            "nextDialogs": [
              "220010311"
            ]
          },
          "220010311": {
            "id": "220010311",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Lotus Heads are their favorite thing in the world... Giving them their favorite treat will definitely calm them down.",
            "nextDialogs": [
              "220010312"
            ]
          },
          "220010312": {
            "id": "220010312",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Can you find some Lotus Heads for me?",
            "nextDialogs": [
              "220010314",
              "220010316"
            ]
          },
          "220010314": {
            "id": "220010314",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Thank you! You need to be quick though."
          },
          "220010316": {
            "id": "220010316",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "Oh... Really? Well what is it?",
            "nextDialogs": [
              "220010317"
            ]
          },
          "220010317": {
            "id": "220010317",
            "speakerId": 2074,
            "speakerName": "Little Lulu",
            "text": "...Anyway, just get some Lotus Heads. We can't have them arguing like this all day."
          }
        }
      }
    },
    {
      "subId": "2200106",

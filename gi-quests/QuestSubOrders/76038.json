  "subQuests": [
    {
      "subId": "7603801",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380101"
        ],
        "dialogs": {
          "760380101": {
            "id": "760380101",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Might <color=#FFCC33FF>Nefer</color> be interested in some sugar sculptures...?)",
            "nextDialogs": [
              "760380102"
            ]
          },
          "760380102": {
            "id": "760380102",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "I'll have one sugar sculpture, Hunajatta.",
            "nextDialogs": [
              "760380103"
            ]
          },
          "760380103": {
            "id": "760380103",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Lady Nefer, what an unexpected surprise. What brings you here today?",
            "nextDialogs": [
              "760380104"
            ]
          },
          "760380104": {
            "id": "760380104",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "I find getting out and taking a walk every now and then is good for both body and mind.",
            "nextDialogs": [
              "760380105"
            ]
          },
          "760380105": {
            "id": "760380105",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "Besides, having something sweet helps my thought process.",
            "nextDialogs": [
              "760380106"
            ]
          },
          "760380106": {
            "id": "760380106",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Wonderful! Give me a minute, I'll rustle you one up right away!",
            "nextDialogs": [
              "760380107"
            ]
          },
          "760380107": {
            "id": "760380107",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "Many thanks. And while I'm here, take this money. The next time Jahoda comes by...",
            "nextDialogs": [
              "760380108"
            ]
          },
          "760380108": {
            "id": "760380108",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Make her an extra-large one? Make it even sweeter?",
            "nextDialogs": [
              "760380109"
            ]
          },
          "760380109": {
            "id": "760380109",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "...Give the money to her.",
            "nextDialogs": [
              "760380110"
            ]
          },
          "760380110": {
            "id": "760380110",
            "speakerId": 1000,
            "speakerName": "Nefer",
            "text": "And tell her, \"Nefer's paying double, so once you're done lazing around, head back. And grab a sugar sculpture for the boss while you're at it.\""
          }
        }
      }
    },
    {
      "subId": "7603815",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760381109"
        ],
        "dialogs": {
          "760381109": {
            "id": "760381109",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Might <color=#FFCC33FF>Linnea</color> be interested in some sugar sculptures...?)",
            "nextDialogs": [
              "760381101"
            ]
          },
          "760381101": {
            "id": "760381101",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Oh, hello, Miss Linnea! Here to buy more sugar sculptures for Lumi?",
            "nextDialogs": [
              "760381102"
            ]
          },
          "760381102": {
            "id": "760381102",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "I sure am! Lumi loves your sugar sculptures so much, she can't even bring herself to eat them — she just licks them once and then gives them to me for safekeeping.",
            "nextDialogs": [
              "760381103"
            ]
          },
          "760381103": {
            "id": "760381103",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "But, since they're made of sugar... they end up melting anyway.",
            "nextDialogs": [
              "760381104"
            ]
          },
          "760381104": {
            "id": "760381104",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "So, if I could trouble you, Miss Hunajatta, can you make me another one?",
            "nextDialogs": [
              "760381105"
            ]
          },
          "760381105": {
            "id": "760381105",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Of course! Just give me a moment...",
            "nextDialogs": [
              "760381106"
            ]
          },
          "760381106": {
            "id": "760381106",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "(Lumi's so adorable — I just want to pet her! But that feels like it would be a bit rude. Oh well...)",
            "nextDialogs": [
              "760381107"
            ]
          },
          "760381107": {
            "id": "760381107",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Here you go, Miss Linnea. One sugar sculpture.",
            "nextDialogs": [
              "760381108"
            ]
          },
          "760381108": {
            "id": "760381108",
            "speakerId": 1002,
            "speakerName": "Linnea",
            "text": "Thank you! Lumi, it's ready, do you want it n— Oh, she's fallen asleep. I'll give it to her later."
          }
        }
      }
    },
    {
      "subId": "7603805",
      "subQuestName": "Distribute sugar sculpture box - General dialogue $HIDDEN",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380201"
        ],
        "dialogs": {
          "760380201": {
            "id": "760380201",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "One sugar sculpture, please.",
            "nextDialogs": [
              "760380202"
            ]
          },
          "760380202": {
            "id": "760380202",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Here you go. Eat it quick once you open it, alright?"
          }
        }
      }
    },
    {
      "subId": "7603806",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380310"
        ],
        "dialogs": {
          "760380310": {
            "id": "760380310",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Perhaps <color=#FFCC33FF>Lauma</color>'s interested in sugar sculptures...?)",
            "nextDialogs": [
              "760380301"
            ]
          },
          "760380301": {
            "id": "760380301",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "Could you make me a few, please, Miss Hunajatta?",
            "nextDialogs": [
              "760380302"
            ]
          },
          "760380302": {
            "id": "760380302",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "No problem, Miss Lauma. Did the kids like the batch you brought back last time?",
            "nextDialogs": [
              "760380303"
            ]
          },
          "760380303": {
            "id": "760380303",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "Hehe, that they did. In fact, some of them could only be convinced to ruin their beautiful treats once they had almost melted away.",
            "nextDialogs": [
              "760380304"
            ]
          },
          "760380304": {
            "id": "760380304",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "I see... You know what? I'll bring my tools and go to you all next time. You know, set up a live station for the kids.",
            "nextDialogs": [
              "760380305"
            ]
          },
          "760380305": {
            "id": "760380305",
            "speakerId": 1003,
            "speakerName": "Lauma",
            "text": "Ah, that would be lovely. The children will be so happy.",
            "nextDialogs": [
              "760380306"
            ]
          },
          "760380306": {
            "id": "760380306",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Oh, and uh, guess we're getting off topic, huh? I'll go make your sugar sculptures. Once they're done, I'll have someone deliver it to the Scions.",
            "nextDialogs": [
              "760380307"
            ]
          },
          "760380307": {
            "id": "760380307",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "But before that... Hehe, I have a good idea~",
            "nextDialogs": [
              "760380308"
            ]
          },
          "760380308": {
            "id": "760380308",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "One moment, Miss Lauma. I'll whip something special up for you."
          }
        }
      }
    },
    {
      "subId": "7603807",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380409"
        ],
        "dialogs": {
          "760380409": {
            "id": "760380409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Might <color=#FFCC33FF>Flins</color> have an interest in sugar sculptures...?)",
            "nextDialogs": [
              "760380401"
            ]
          },
          "760380401": {
            "id": "760380401",
            "speakerId": 1004,
            "speakerName": "Flins",
            "text": "Miss Hunajatta. If I might impose, would you make me a sugar sculpture?",
            "nextDialogs": [
              "760380402"
            ]
          },
          "760380402": {
            "id": "760380402",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Oh, sure. You're... Flins, the Ratnik, am I right? I think I've seen you in our store before.",
            "nextDialogs": [
              "760380403"
            ]
          },
          "760380403": {
            "id": "760380403",
            "speakerId": 1004,
            "speakerName": "Flins",
            "text": "Indeed you have. I do sometimes swing by to purchase supplies. It is an honor and a privilege to be remembered so.",
            "nextDialogs": [
              "760380404"
            ]
          },
          "760380404": {
            "id": "760380404",
            "speakerId": 1004,
            "speakerName": "Flins",
            "text": "As for today, I just happened to be passing through when I witnessed your sugar-shaping mastery.",
            "nextDialogs": [
              "760380405"
            ]
          },
          "760380405": {
            "id": "760380405",
            "speakerId": 1004,
            "speakerName": "Flins",
            "text": "And after much consideration, I decided that I must have you sculpt me a serving.",
            "nextDialogs": [
              "760380406"
            ]
          },
          "760380406": {
            "id": "760380406",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Oh, please, no need to be so polite. You're embarrassing me here~",
            "nextDialogs": [
              "760380407"
            ]
          },
          "760380407": {
            "id": "760380407",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Just hold on a moment, one serving coming right up.",
            "nextDialogs": [
              "760380408"
            ]
          },
          "760380408": {
            "id": "760380408",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Hmm. Perhaps we should do something special for our good Ratnik..."
          }
        }
      }
    },
    {
      "subId": "7603808",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380508"
        ],
        "dialogs": {
          "760380508": {
            "id": "760380508",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Would <color=#FFCC33FF>Aino</color> be interested in some sugar sculptures...?)",
            "nextDialogs": [
              "760380501"
            ]
          },
          "760380501": {
            "id": "760380501",
            "speakerId": 1005,
            "speakerName": "Aino",
            "text": "Hiya Boss! One sugar sculpture, please!",
            "nextDialogs": [
              "760380502"
            ]
          },
          "760380502": {
            "id": "760380502",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Oh, Miss Aino! It's been a while~",
            "nextDialogs": [
              "760380503"
            ]
          },
          "760380503": {
            "id": "760380503",
            "speakerId": 1005,
            "speakerName": "Aino",
            "text": "Hehe. Rolled into town to help fix some stuff. Thought I'd pop by and snag some candy!",
            "nextDialogs": [
              "760380504"
            ]
          },
          "760380504": {
            "id": "760380504",
            "speakerId": 1005,
            "speakerName": "Aino",
            "text": "Also, Ineffa isn't around, so... make me a few extras, would ya? And make 'em extra sweet!",
            "nextDialogs": [
              "760380505"
            ]
          },
          "760380505": {
            "id": "760380505",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Well, sure... but you gotta brush your teeth once you're done eating, alright?",
            "nextDialogs": [
              "760380506"
            ]
          },
          "760380506": {
            "id": "760380506",
            "speakerId": 1005,
            "speakerName": "Aino",
            "text": "Yeah, yeah, I know, I know. I always brush my teeth after eating candy! My teeth are super dee duper great!",
            "nextDialogs": [
              "760380507"
            ]
          },
          "760380507": {
            "id": "760380507",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Haha... Hold on a moment, then..."
          }
        }
      }
    },
    {
      "subId": "7603809",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380601"
        ],
        "dialogs": {
          "760380601": {
            "id": "760380601",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Might <color=#FFCC33FF>Ineffa</color> be interested in some sugar sculptures...?)",
            "nextDialogs": [
              "760380602"
            ]
          },
          "760380602": {
            "id": "760380602",
            "speakerId": 1006,
            "speakerName": "Ineffa",
            "text": "Excuse me. Could I trouble you to make me one sugar sculpture?",
            "nextDialogs": [
              "760380603"
            ]
          },
          "760380603": {
            "id": "760380603",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Sure. For Miss Aino, I presume?",
            "nextDialogs": [
              "760380604"
            ]
          },
          "760380604": {
            "id": "760380604",
            "speakerId": 1006,
            "speakerName": "Ineffa",
            "text": "Negative. Aino requested that I come and buy myself a beautiful sugar sculpture.",
            "nextDialogs": [
              "760380605"
            ]
          },
          "760380605": {
            "id": "760380605",
            "speakerId": 1006,
            "speakerName": "Ineffa",
            "text": "According to her, this is part of my \"social activity\" training, which will make shopping more convenient in future.",
            "nextDialogs": [
              "760380606"
            ]
          },
          "760380606": {
            "id": "760380606",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "I see~",
            "nextDialogs": [
              "760380607"
            ]
          },
          "760380607": {
            "id": "760380607",
            "speakerId": 1006,
            "speakerName": "Ineffa",
            "text": "Though I do not understand. I do not require this much sugar intake.",
            "nextDialogs": [
              "760380608"
            ]
          },
          "760380608": {
            "id": "760380608",
            "speakerId": 1006,
            "speakerName": "Ineffa",
            "text": "I suspect that Aino may wind up eating this sculpture in secret.",
            "nextDialogs": [
              "760380609"
            ]
          },
          "760380609": {
            "id": "760380609",
            "speakerId": 1006,
            "speakerName": "Ineffa",
            "text": "...",
            "nextDialogs": [
              "760380610"
            ]
          },
          "760380610": {
            "id": "760380610",
            "speakerId": 1006,
            "speakerName": "Ineffa",
            "text": "Miss Hunajatta, could you construct a sugar sculpture with smaller dimensions?",
            "nextDialogs": [
              "760380611"
            ]
          },
          "760380611": {
            "id": "760380611",
            "speakerId": 1006,
            "speakerName": "Ineffa",
            "text": "Aino loves candy, but I believe she should eat somewhat less.",
            "nextDialogs": [
              "760380612"
            ]
          },
          "760380612": {
            "id": "760380612",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Don't worry, I've got this... Now, let me see..."
          }
        }
      }
    },
    {
      "subId": "7603811",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380701"
        ],
        "dialogs": {
          "760380701": {
            "id": "760380701",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Would <color=#FFCC33FF>Jahoda</color> be interested in some sugar sculptures...?)",
            "nextDialogs": [
              "760380702"
            ]
          },
          "760380702": {
            "id": "760380702",
            "speakerId": 1007,
            "speakerName": "Jahoda",
            "text": "An extra-large one, please, boss.",
            "nextDialogs": [
              "760380703"
            ]
          },
          "760380703": {
            "id": "760380703",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "It's not your first time here, Jahoda. You know the size of our sugar sculptures is fixed.",
            "nextDialogs": [
              "760380704"
            ]
          },
          "760380704": {
            "id": "760380704",
            "speakerId": 1007,
            "speakerName": "Jahoda",
            "text": "Come on, everything's turning up roses today! Hurry it up, just a little bigger than usual.",
            "nextDialogs": [
              "760380705"
            ]
          },
          "760380705": {
            "id": "760380705",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Turning up roses? Your commission went well then, I suppose?",
            "nextDialogs": [
              "760380706"
            ]
          },
          "760380706": {
            "id": "760380706",
            "speakerId": 1007,
            "speakerName": "Jahoda",
            "text": "Hehehe, of course. Just a simple escort mission. Easy peasy, done and dusted.",
            "nextDialogs": [
              "760380707"
            ]
          },
          "760380707": {
            "id": "760380707",
            "speakerId": 1007,
            "speakerName": "Jahoda",
            "text": "Not a single hair harmed on the client's head, not a single scratch found on the cargo.",
            "nextDialogs": [
              "760380708"
            ]
          },
          "760380708": {
            "id": "760380708",
            "speakerId": 1007,
            "speakerName": "Jahoda",
            "text": "Okay, I'm done talking. Speed it along, let's get that sugar sculpture on the go, I'll take it to go.",
            "nextDialogs": [
              "760380709"
            ]
          },
          "760380709": {
            "id": "760380709",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "No problem. Give me a moment..."
          }
        }
      }
    },
    {
      "subId": "7603812",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380801"
        ],
        "dialogs": {
          "760380801": {
            "id": "760380801",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Claim a Moon-Prayer Night Sugar Sculpture)",
            "nextDialogs": [
              "760380802"
            ]
          },
          "760380802": {
            "id": "760380802",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Here's your Sugar Sculpture. Happy Moon-Prayer Night!"
          }
        }
      }
    },
    {
      "subId": "7603813",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760380901"
        ],
        "dialogs": {
          "760380901": {
            "id": "760380901",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Would <color=#FFCC33FF>Columbina</color> be interested in some sugar sculptures...?)",
            "nextDialogs": [
              "760380902"
            ]
          },
          "760380902": {
            "id": "760380902",
            "speakerId": 1008,
            "speakerName": "Columbina",
            "text": "Sugar sculpture... I think I've tried it before. Could you make one for me?",
            "nextDialogs": [
              "760380903"
            ]
          },
          "760380903": {
            "id": "760380903",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "No problem! Just wait a moment.",
            "nextDialogs": [
              "760380904"
            ]
          },
          "760380904": {
            "id": "760380904",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "(Hmm... Have I seen this girl somewhere in town before...?)",
            "nextDialogs": [
              "760380905"
            ]
          },
          "760380905": {
            "id": "760380905",
            "speakerId": 1008,
            "speakerName": "Columbina",
            "text": "...",
            "nextDialogs": [
              "760380906"
            ]
          },
          "760380906": {
            "id": "760380906",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "(Wow! She looks so full of anticipation... Ah, think, think! What style would suit her best?)",
            "nextDialogs": [
              "760380907"
            ]
          },
          "760380907": {
            "id": "760380907",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "(Go with your instinct... follow your gut... okay, okay! I've got this!)",
            "nextDialogs": [
              "760380908"
            ]
          },
          "760380908": {
            "id": "760380908",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Umm... I'm done. Take a look — do you like it?",
            "nextDialogs": [
              "760380909"
            ]
          },
          "760380909": {
            "id": "760380909",
            "speakerId": 1008,
            "speakerName": "Columbina",
            "text": "It looks great. Thank you.",
            "nextDialogs": [
              "760380910"
            ]
          },
          "760380910": {
            "id": "760380910",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Hehe, I'm glad you like it.",
            "nextDialogs": [
              "760380911"
            ]
          },
          "760380911": {
            "id": "760380911",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "(Yes, my instinct was right — this light, airy style suits such a light, airy kid!)",
            "nextDialogs": [
              "760380912"
            ]
          },
          "760380912": {
            "id": "760380912",
            "speakerId": 1008,
            "speakerName": "Columbina",
            "text": "Mmm, it's really tasty too...",
            "nextDialogs": [
              "760380913"
            ]
          },
          "760380913": {
            "id": "760380913",
            "speakerId": 1008,
            "speakerName": "Columbina",
            "text": "Could you make two more? I want to take them back for the kuuhenki to try as well.",
            "nextDialogs": [
              "760380914"
            ]
          },
          "760380914": {
            "id": "760380914",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "For... the kuuhenki too? Well, I could, but I don't have enough ingredients...",
            "nextDialogs": [
              "760380915"
            ]
          },
          "760380915": {
            "id": "760380915",
            "speakerId": 1008,
            "speakerName": "Columbina",
            "text": "Then I'll come back tomorrow and bring them with me.",
            "nextDialogs": [
              "760380916"
            ]
          },
          "760380916": {
            "id": "760380916",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "No problem... See you then..."
          }
        }
      }
    },
    {
      "subId": "7603814",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "760381001"
        ],
        "dialogs": {
          "760381001": {
            "id": "760381001",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(Would <color=#FFCC33FF>Illuga</color> be interested in some sugar sculptures...?)",
            "nextDialogs": [
              "760381002"
            ]
          },
          "760381002": {
            "id": "760381002",
            "speakerId": 1009,
            "speakerName": "Illuga",
            "text": "Well, since I'm already here... Hello, one sugar sculpture, please!",
            "nextDialogs": [
              "760381003"
            ]
          },
          "760381003": {
            "id": "760381003",
            "speakerId": 1009,
            "speakerName": "Illuga",
            "text": "Oh! Could you make it a bit smaller? I'm worried something might come up and I won't be able to finish it in one go...",
            "nextDialogs": [
              "760381004"
            ]
          },
          "760381004": {
            "id": "760381004",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "No problem at all! Don't worry — even the small ones taste just as good.",
            "nextDialogs": [
              "760381005"
            ]
          },
          "760381005": {
            "id": "760381005",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Still, you Lightkeepers really do have your hands full... even a sugar sculpture might go unfinished.",
            "nextDialogs": [
              "760381006"
            ]
          },
          "760381006": {
            "id": "760381006",
            "speakerId": 1009,
            "speakerName": "Illuga",
            "text": "Um... Ahaha... Well, it's not just the duties. Sometimes it's because I run into someone who needs help.",
            "nextDialogs": [
              "760381007"
            ]
          },
          "760381007": {
            "id": "760381007",
            "speakerId": 1009,
            "speakerName": "Illuga",
            "text": "You know how it is — half-eaten sugar sculptures are hard to keep. All I can really do is wrap it up in cloth and tuck it into my pocket...",
            "nextDialogs": [
              "760381008"
            ]
          },
          "760381008": {
            "id": "760381008",
            "speakerId": 1009,
            "speakerName": "Illuga",
            "text": "But by the time I'm done helping and take it back out, the whole thing's melted away...",
            "nextDialogs": [
              "760381009"
            ]
          },
          "760381009": {
            "id": "760381009",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "I see... Let me think. A small sugar sculpture... hmm...",
            "nextDialogs": [
              "760381010"
            ]
          },
          "760381010": {
            "id": "760381010",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Got it! I can make a small sculpture with multiple flavors!",
            "nextDialogs": [
              "760381011"
            ]
          },
          "760381011": {
            "id": "760381011",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Layer this flavor on the bottom... then this one on top...",
            "nextDialogs": [
              "760381012"
            ]
          },
          "760381012": {
            "id": "760381012",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "All right! Here you go, a mini, multi-flavor sugar sculpture! Does this suit your needs, dear customer?",
            "nextDialogs": [
              "760381013"
            ]
          },
          "760381013": {
            "id": "760381013",
            "speakerId": 1009,
            "speakerName": "Illuga",
            "text": "Ah, it's perfect! Thank you, Ms. Hunajatta!",
            "nextDialogs": [
              "760381014"
            ]
          },
          "760381014": {
            "id": "760381014",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Oh, don't mention it. I may not be able to help you Ratniki with your work... but if you ever want sugar sculptures, I can make as many as you like!",
            "nextDialogs": [
              "760381015"
            ]
          },
          "760381015": {
            "id": "760381015",
            "speakerId": 1009,
            "speakerName": "Illuga",
            "text": "That's our job. You're too kind, Ms. Hunajatta... I'll take my leave now, there's still work waiting.",
            "nextDialogs": [
              "760381016"
            ]
          },
          "760381016": {
            "id": "760381016",
            "speakerId": 1001,
            "speakerName": "Hunajatta",
            "text": "Okay, take care! And next time you want a sugar sculpture, just come straight over!"
          }
        }
      }
    }
  ]
}
{
  "lineCounts": {
    "Muning": 86,
    "Paimon": 32,
    "Player": 21
  },
  "subQuests": [
    {
      "subId": "7107401",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710740101"
        ],
        "dialogs": {
          "710740101": {
            "id": "710740101",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Archaic Stone... *sigh* In all the years I've worked in The Chasm, I've barely seen even one. What are the big shots at Huishan Hall thinking...",
            "nextDialogs": [
              "710740102"
            ]
          },
          "710740102": {
            "id": "710740102",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Let them do the job and they'll know how impossible the task is.",
            "nextDialogs": [
              "710740103"
            ]
          },
          "710740103": {
            "id": "710740103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Muning—!",
            "nextDialogs": [
              "710740104"
            ]
          },
          "710740104": {
            "id": "710740104",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Oh, it's you. Why are you still wandering on the upper levels of The Chasm?",
            "nextDialogs": [
              "710740105"
            ]
          },
          "710740105": {
            "id": "710740105",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Um... Don't get me wrong. It's not that I don't welcome you here. I just wonder... Uh, don't you have other important matters to attend to?",
            "nextDialogs": [
              "710740106"
            ]
          },
          "710740106": {
            "id": "710740106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph, we were just kindly dropping by to check up on you, since you looked so troubled...",
            "nextDialogs": [
              "710740109"
            ]
          },
          "710740109": {
            "id": "710740109",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "*sigh*... Do you know about Archaic Stone?",
            "nextDialogs": [
              "710740110"
            ]
          },
          "710740110": {
            "id": "710740110",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "It's a rare ore — so rare that you won't even necessarily find one in the mines. I've only seen two or three such stones for all my years here at The Chasm. It's such a gorgeous gemstone with beauty beyond imagination.",
            "nextDialogs": [
              "710740111"
            ]
          },
          "710740111": {
            "id": "710740111",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "They say that if you look inside the finest Archaic Stones, you'll see shimmering light rays as thin as hair, and that the stones' color reminds you of the sea horizon in the twilight...",
            "nextDialogs": [
              "710740112"
            ]
          },
          "710740112": {
            "id": "710740112",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do you mean a stone like this?",
            "nextDialogs": [
              "710740113"
            ]
          },
          "710740113": {
            "id": "710740113",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Ah, you... you actually have one! And it's of the highest quality that I've ever seen, too!",
            "nextDialogs": [
              "710740114"
            ]
          },
          "710740114": {
            "id": "710740114",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "#{NICKNAME}, how about you sell this stone to me?"
          }
        }
      }
    },
    {
      "subId": "7107402",
      "subQuestName": "Obtain 3 Archaic Stones for Muning",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710740201"
        ],
        "dialogs": {
          "710740201": {
            "id": "710740201",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Archaic Stone... *sigh* In all the years I've worked in The Chasm, I've barely seen even one. What are the big shots at Huishan Hall thinking...",
            "nextDialogs": [
              "710740202"
            ]
          },
          "710740202": {
            "id": "710740202",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Let them do the job and they'll know how impossible the task is.",
            "nextDialogs": [
              "710740203"
            ]
          },
          "710740203": {
            "id": "710740203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Muning—!",
            "nextDialogs": [
              "710740204"
            ]
          },
          "710740204": {
            "id": "710740204",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Oh, it's you. Why are you still wandering on the upper levels of The Chasm?",
            "nextDialogs": [
              "710740205"
            ]
          },
          "710740205": {
            "id": "710740205",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Um... Don't get me wrong. It's not that I don't welcome you here. I just wonder... Uh, don't you have other important matters to attend to?",
            "nextDialogs": [
              "710740206"
            ]
          },
          "710740206": {
            "id": "710740206",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmph, we were just kindly dropping by to check up on you, since you looked so troubled...",
            "nextDialogs": [
              "710740209"
            ]
          },
          "710740209": {
            "id": "710740209",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "*sigh*... Do you know about Archaic Stone?",
            "nextDialogs": [
              "710740210"
            ]
          },
          "710740210": {
            "id": "710740210",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "It's a rare ore — so rare that you won't even necessarily find one in the mines. I've only seen two or three such stones for all my years here at The Chasm. It's such a gorgeous gemstone with beauty beyond imagination.",
            "nextDialogs": [
              "710740211"
            ]
          },
          "710740211": {
            "id": "710740211",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "They say that if you look inside the finest Archaic Stones, you'll see shimmering light rays as thin as hair, and that the stones' color reminds you of the profound beauty of the sea horizon in the twilight...",
            "nextDialogs": [
              "710740212"
            ]
          },
          "710740212": {
            "id": "710740212",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "So what you're trying to say is that you are looking for some stones of beautiful colors?",
            "nextDialogs": [
              "710740213"
            ]
          },
          "710740213": {
            "id": "710740213",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Not all stones of beautiful colors will do. It has to be THE stone.",
            "nextDialogs": [
              "710740214"
            ]
          },
          "710740214": {
            "id": "710740214",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "#Speaking of which... How about this, {NICKNAME}? You help me look out for stones that fit my description.",
            "nextDialogs": [
              "710740215"
            ]
          },
          "710740215": {
            "id": "710740215",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Bring them to me, and I will purchase them.",
            "nextDialogs": [
              "710740216"
            ]
          },
          "710740216": {
            "id": "710740216",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh? Paimon seriously doubts if your pocket is thick enough to afford this stone.",
            "nextDialogs": [
              "710740217"
            ]
          },
          "710740217": {
            "id": "710740217",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Well... I've got a buyer behind me, so finances aren't exactly the problem.",
            "nextDialogs": [
              "710740218"
            ]
          },
          "710740218": {
            "id": "710740218",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "A buyer?",
            "nextDialogs": [
              "710740219"
            ]
          },
          "710740219": {
            "id": "710740219",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Yes. Somehow, the big shots at Huishan Hall got interested in the stone and wanted to analyze it, so they sent me to The Chasm to look for a few samples.",
            "nextDialogs": [
              "710740220"
            ]
          },
          "710740220": {
            "id": "710740220",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "But I'm busy getting my job over with... ahem... I mean, doing my job.",
            "nextDialogs": [
              "710740221"
            ]
          },
          "710740221": {
            "id": "710740221",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "#How about we make a deal, {NICKNAME}? If you find any Archaic Stones, bring them to me. In exchange, the reward promised by Huishan Hall will be yours.",
            "nextDialogs": [
              "710740222"
            ]
          },
          "710740222": {
            "id": "710740222",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Rewards from Huishan Hall!",
            "nextDialogs": [
              "710740223"
            ]
          },
          "710740223": {
            "id": "710740223",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Normally, I would handle the job myself, but my hands have been tied by various affairs here in The Chasm lately, so please help me with this.",
            "nextDialogs": [
              "710740224"
            ]
          },
          "710740224": {
            "id": "710740224",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "*sigh* ...That said, I'm not sure how many they want. How about you bring me three for starters?",
            "nextDialogs": [
              "710740225"
            ]
          },
          "710740225": {
            "id": "710740225",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Alright, alright, we got it."
          }
        }
      }
    },
    {
      "subId": "7107403",
      "subQuestName": "Talk to Muning",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "710740401"
        ],
        "dialogs": {
          "710740401": {
            "id": "710740401",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "These are indeed Archaic Stones. You have my thanks.",
            "nextDialogs": [
              "710740402"
            ]
          },
          "710740402": {
            "id": "710740402",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "I was right to come to you. I bet it would've taken much longer if it'd been the Adventurers' Guild.",
            "nextDialogs": [
              "710740403"
            ]
          },
          "710740403": {
            "id": "710740403",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... who knows. Perhaps, the Adventurers' Guild might even...",
            "nextDialogs": [
              "710740404"
            ]
          },
          "710740404": {
            "id": "710740404",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Send us the commission.",
            "nextDialogs": [
              "710740405"
            ]
          },
          "710740405": {
            "id": "710740405",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "That's quite likely.",
            "nextDialogs": [
              "710740406"
            ]
          },
          "710740406": {
            "id": "710740406",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Adventurers... Hmm... I used to be envious of them. The way they ventured into high mountains and deep dungeons... There seemed to be nowhere they dared not go.",
            "nextDialogs": [
              "710740407"
            ]
          },
          "710740407": {
            "id": "710740407",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "I'm quite the opposite though — I've been working here for years but haven't once visited Cinnabar Cliff on the very top of The Chasm.",
            "nextDialogs": [
              "710740408"
            ]
          },
          "710740408": {
            "id": "710740408",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What? You haven't been there even once?",
            "nextDialogs": [
              "710740409"
            ]
          },
          "710740409": {
            "id": "710740409",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Well, Cinnabar Cliff is one of those famous tourist spots that locals seldom go to.",
            "nextDialogs": [
              "710740410"
            ]
          },
          "710740410": {
            "id": "710740410",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Maybe it's so close that I always think that I can visit it later when I've got time — but well, I've never \"got time.\"",
            "nextDialogs": [
              "710740411"
            ]
          },
          "710740411": {
            "id": "710740411",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Then, why don't we go now?",
            "nextDialogs": [
              "710740412"
            ]
          },
          "710740412": {
            "id": "710740412",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's important to act spontaneously.",
            "nextDialogs": [
              "710740413"
            ]
          },
          "710740413": {
            "id": "710740413",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "I think I'll pass. I'm still in the middle of something.",
            "nextDialogs": [
              "710740414"
            ]
          },
          "710740414": {
            "id": "710740414",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "What's more, such errand-running is best left to adventurers.",
            "nextDialogs": [
              "710740415"
            ]
          },
          "710740415": {
            "id": "710740415",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Dangerous places are their bread and butter, after all. I'd probably get injured if I did the same, and that's something I'd like to avoid.",
            "nextDialogs": [
              "710740416"
            ]
          },
          "710740416": {
            "id": "710740416",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Makes sense. Getting injured could be a big deal.",
            "nextDialogs": [
              "710740417"
            ]
          },
          "710740417": {
            "id": "710740417",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "If I'm injured, no one's gonna supervise the exploration team down there and ensure the safety of the miners.",
            "nextDialogs": [
              "710740418"
            ]
          },
          "710740418": {
            "id": "710740418",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Should anything happen, it will escalate into a grievous matter.",
            "nextDialogs": [
              "710740419"
            ]
          },
          "710740419": {
            "id": "710740419",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's what you're worried about... Paimon thought you were just scared of getting injured!",
            "nextDialogs": [
              "710740420"
            ]
          },
          "710740420": {
            "id": "710740420",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "The formidably high cliffs near The Chasm, the bottomless caves... and the ancient battlefield left behind by Rex Lapis are all full of danger...",
            "nextDialogs": [
              "710740421"
            ]
          },
          "710740421": {
            "id": "710740421",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "I don't have the slightest interest in venturing into those places.",
            "nextDialogs": [
              "710740422"
            ]
          },
          "710740422": {
            "id": "710740422",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Here, the rewards for the three Archaic Stones. Huishan Hall wants quite a lot of them, so bring me more if you can find any.",
            "nextDialogs": [
              "710740423"
            ]
          },
          "710740423": {
            "id": "710740423",
            "speakerId": 2061,
            "speakerName": "Muning",
            "text": "Of course, there will be rewards for those, too. Just remember to come to me once you find more Archaic Stones.",
            "nextDialogs": [
              "710740424"
            ]
          },
          "710740424": {
            "id": "710740424",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You can count on us!"
          }
        }
      }
    },
    {
      "subId": "7107404",
      "subQuestName": "Obtain 3 Archaic Stones for Muning",
      "sceneId": null,
      "locations": [],

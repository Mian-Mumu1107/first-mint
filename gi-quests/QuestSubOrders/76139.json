  "subQuests": [
    {
      "subId": "7613901",
      "subQuestName": "Talk to Dhabit",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761390101"
        ],
        "dialogs": {
          "761390101": {
            "id": "761390101",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "The publishing trade hardly makes a living these days. Maybe I should just focus on investments...",
            "nextDialogs": [
              "761390102"
            ]
          },
          "761390102": {
            "id": "761390102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Let me see the investment coupons.",
            "nextDialogs": [
              "761390103"
            ]
          },
          "761390103": {
            "id": "761390103",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Here you go. 2,000 Mora per coupon, with each investment tenure maturing weekly. Now then, into the pouch it goes...",
            "nextDialogs": [
              "761390104"
            ]
          },
          "761390104": {
            "id": "761390104",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "...Ugh!",
            "nextDialogs": [
              "761390105"
            ]
          },
          "761390105": {
            "id": "761390105",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "761390106"
            ]
          },
          "761390106": {
            "id": "761390106",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "N—No, nothing at all. I just didn't expect you to stop by, Lady Nefer. Are you... perhaps interested in buying an investment coupon too?",
            "nextDialogs": [
              "761390107"
            ]
          },
          "761390107": {
            "id": "761390107",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Oh, no, I'll pass. I'm just here with my friend to have a look around.",
            "nextDialogs": [
              "761390108"
            ]
          },
          "761390108": {
            "id": "761390108",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "I've heard your investments have been thriving, Mr. Dhabit. Seeing it with my own eyes, I can see the rumor holds true.",
            "nextDialogs": [
              "761390109"
            ]
          },
          "761390109": {
            "id": "761390109",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Oh, it's nothing, nothing, haha... just a small venture to make ends meet.",
            "nextDialogs": [
              "761390110"
            ]
          },
          "761390110": {
            "id": "761390110",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Can this really make money?",
            "nextDialogs": [
              "761390111"
            ]
          },
          "761390111": {
            "id": "761390111",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Of course. Mr. Dhabit is an excellent businessman — follow his lead, and you won't lose. Right, Mr. Dhabit?",
            "nextDialogs": [
              "761390112"
            ]
          },
          "761390112": {
            "id": "761390112",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Yes, yes... haha...",
            "nextDialogs": [
              "761390113"
            ]
          },
          "761390113": {
            "id": "761390113",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well then, let's see how my luck holds today.",
            "nextDialogs": [
              "761390114"
            ]
          },
          "761390114": {
            "id": "761390114",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "T—Today, you say... W—Well, funny that you should say that! What you've bought this fine day is our brand-new... short-term investment coupon! And here's the thing — profits and losses on this one are to be settled immediately!",
            "nextDialogs": [
              "761390115"
            ]
          },
          "761390115": {
            "id": "761390115",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kinda feels like you just made all that up...",
            "nextDialogs": [
              "761390116"
            ]
          },
          "761390116": {
            "id": "761390116",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Uh... Don't worry about it. A—Anyway, thanks for buying our short-term investment coupon!",
            "nextDialogs": [
              "761390117"
            ]
          },
          "761390117": {
            "id": "761390117",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Here's your investment return. Have a wonderful day!",
            "nextDialogs": [
              "761390120"
            ]
          },
          "761390120": {
            "id": "761390120",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really? Heehee, then Paimon wants one shaped like a little bird! That's Paimon's favorite!",
            "nextDialogs": [
              "761390121"
            ]
          },
          "761390121": {
            "id": "761390121",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Then I'll take my leave as well. Like I said, Mr. Dhabit, you've truly lived up to your reputation — an honest merchant through and through. May your business prosper.",
            "nextDialogs": [
              "761390122"
            ]
          },
          "761390122": {
            "id": "761390122",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Thank you for the kind words, Lady Nefer...",
            "nextDialogs": [
              "761390123"
            ]
          },
          "761390123": {
            "id": "761390123",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "And, about that matter I asked your help with last time...",
            "nextDialogs": [
              "761390124"
            ]
          },
          "761390124": {
            "id": "761390124",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "We've found what you're looking for, but...",
            "nextDialogs": [
              "761390125"
            ]
          },
          "761390125": {
            "id": "761390125",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Do have patience, Mr. Dhabit. One step at a time — that's how proper business is done.",
            "nextDialogs": [
              "761390126"
            ]
          },
          "761390126": {
            "id": "761390126",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "O—Oh yes, you're right, of course... I'll leave it in your capable hands..."
          }
        }
      }
    },
    {
      "subId": "7613902",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "761390201"
        ],
        "dialogs": {
          "761390201": {
            "id": "761390201",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Well, well, if it isn't our regulars! Here to invest again, are we?",
            "nextDialogs": [
              "761390202"
            ]
          },
          "761390202": {
            "id": "761390202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "I'd like an investment coupon, please.",
            "nextDialogs": [
              "761390203"
            ]
          },
          "761390203": {
            "id": "761390203",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Here you go. 2,000 Mora per coupon, with each investment tenure maturing weekly. Trust me, this is... a surefire investment...",
            "nextDialogs": [
              "761390204"
            ]
          },
          "761390204": {
            "id": "761390204",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "L—Lady Nefer! I never imagined you'd grace my humble stall... H—Have you come to buy an investment coupon too?",
            "nextDialogs": [
              "761390205"
            ]
          },
          "761390205": {
            "id": "761390205",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Oh, no, I'll pass. I'm just here with my friend to have a look around.",
            "nextDialogs": [
              "761390206"
            ]
          },
          "761390206": {
            "id": "761390206",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "I've heard your investments have been thriving, Mr. Dhabit. Seeing it with my own eyes, I can see the rumor holds true.",
            "nextDialogs": [
              "761390207"
            ]
          },
          "761390207": {
            "id": "761390207",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Oh, it's nothing, nothing, haha... just a small venture to make ends meet.",
            "nextDialogs": [
              "761390210"
            ]
          },
          "761390210": {
            "id": "761390210",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Well, that's just the nature of investing — some you win, some you lose.",
            "nextDialogs": [
              "761390211"
            ]
          },
          "761390211": {
            "id": "761390211",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "But... at least you won't need to worry about being swindled.",
            "nextDialogs": [
              "761390212"
            ]
          },
          "761390212": {
            "id": "761390212",
            "speakerId": 1316,
            "speakerName": "Nefer",
            "text": "Mr. Dhabit is an excellent businessman, after all. Follow his lead, and you won't lose. Right, Mr. Dhabit?",
            "nextDialogs": [
              "761390213"
            ]
          },
          "761390213": {
            "id": "761390213",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Ahem! Y—Yes, yes... you're right! An honest merchant, I am! N—Naturally!",
            "nextDialogs": [
              "761390214"
            ]
          },
          "761390214": {
            "id": "761390214",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well then, let's see how my luck holds today.",
            "nextDialogs": [
              "761390215"
            ]
          },
          "761390215": {
            "id": "761390215",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Oh, right, I was just about to congratulate you! Remember the investment coupon you bought last time? You made quite a tidy profit on that one!",
            "nextDialogs": [
              "761390216"
            ]
          },
          "761390216": {
            "id": "761390216",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's a shifty expression you've got there... You didn't just make all that up, did you?",
            "nextDialogs": [
              "761390217"
            ]
          },
          "761390217": {
            "id": "761390217",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "#Ugh... Hey! I swear it's true. You've got sharp business senses, {NICKNAME}!",
            "nextDialogs": [
              "761390218"
            ]
          },
          "761390218": {
            "id": "761390218",
            "speakerId": 7008,
            "speakerName": "Dhabit",
            "text": "Here's your investment return. Have a wonderful day!"
          }
        }
      }
    }
  ]
}
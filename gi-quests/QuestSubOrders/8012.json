    {
      "subId": "801205",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80120504"
        ],
        "dialogs": {
          "80120504": {
            "id": "80120504",
            "speakerId": 1003,
            "speakerName": "Forest Ranger",
            "text": "Don't go thinking this is over! Our superiors are gonna hear of this when we get back to Gandharva Ville!",
            "nextDialogs": [
              "80120512"
            ]
          },
          "80120512": {
            "id": "80120512",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "That could well have been Caribert!"
          }
        }
      }
    },
    {
      "subId": "801299",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80129901"
        ],
        "dialogs": {
          "80129901": {
            "id": "80129901",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Caribert...! Caribert...! Where are you?",
            "nextDialogs": [
              "80129902"
            ]
          },
          "80129902": {
            "id": "80129902",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Eide's out of control. I have to end this fight..."
          }
        }
      }
    }
  ]

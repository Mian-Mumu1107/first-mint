    {
      "subId": "801207",
      "subQuestName": "Talk to the Forest Rangers",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80120401"
        ],
        "dialogs": {
          "80120401": {
            "id": "80120401",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Curses... Forest Rangers.",
            "nextDialogs": [
              "80120402"
            ]
          },
          "80120402": {
            "id": "80120402",
            "speakerId": 1003,
            "speakerName": "Forest Ranger",
            "text": "Hey! Who are you? We haven't seen you around here before. What's your business here?",
            "nextDialogs": [
              "80120403"
            ]
          },
          "80120403": {
            "id": "80120403",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Have you seen a hilichurl? A hilichurl should have come past this way... have you seen it?",
            "nextDialogs": [
              "80120404"
            ]
          },
          "80120404": {
            "id": "80120404",
            "speakerId": 1003,
            "speakerName": "Forest Ranger",
            "text": "I asked you first... Don't make this more difficult than it needs to be!",
            "nextDialogs": [
              "80120405"
            ]
          },
          "80120405": {
            "id": "80120405",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "I said... have you seen... a HILICHURL!!!",
            "nextDialogs": [
              "80120406"
            ]
          },
          "80120406": {
            "id": "80120406",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Eide...",
            "nextDialogs": [
              "80120407"
            ]
          },
          "80120407": {
            "id": "80120407",
            "speakerId": 1003,
            "speakerName": "Forest Ranger",
            "text": "Hey, whoa... Look, Sir, there's no need to get so worked up...",
            "nextDialogs": [
              "80120408"
            ]
          },
          "80120408": {
            "id": "80120408",
            "speakerId": 1003,
            "speakerName": "Forest Ranger",
            "text": "There are hilichurls everywhere, what's the big deal? We see plenty of them out here...",
            "nextDialogs": [
              "80120409"
            ]
          },
          "80120409": {
            "id": "80120409",
            "speakerId": 1004,
            "speakerName": "Ranger Guard",
            "text": "Exactly. Matter of fact, we just took out a few of them back there. Those dumb boneheads...",
            "nextDialogs": [
              "80120410"
            ]
          },
          "80120410": {
            "id": "80120410",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "You... you...!",
            "nextDialogs": [
              "80120411"
            ]
          },
          "80120411": {
            "id": "80120411",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Forest Ranger scum! You spawn of The Seven are all the same! I'll have your heads if you so much as laid a finger on Caribert!",
            "nextDialogs": [
              "80120412"
            ]
          },
          "80120412": {
            "id": "80120412",
            "speakerId": 1003,
            "speakerName": "Forest Ranger",
            "text": "You...! You're raving mad! You've got some gall, coming here to our nation, insulting the Forest Rangers!",
            "nextDialogs": [
              "80120501"
            ]
          },
          "80120501": {
            "id": "80120501",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Curse you all, Forest Rangers...",
            "nextDialogs": [
              "80120515"
            ]
          },
          "80120515": {
            "id": "80120515",
            "speakerId": 1001,
            "speakerName": "Black Screen",
            "text": "Both sides calm down for now, thanks to your urging...",
            "nextDialogs": [
              "80120505"
            ]
          },
          "80120505": {
            "id": "80120505",
            "speakerId": 1004,
            "speakerName": "Ranger Guard",
            "text": "I don't get it. Why make such a huge fuss over a few hilichurls...? It makes no sense...",
            "nextDialogs": [
              "80120506"
            ]
          },
          "80120506": {
            "id": "80120506",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "You...",
            "nextDialogs": [
              "80120507"
            ]
          },
          "80120507": {
            "id": "80120507",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "He'd only just regained his mind. How could you do this to him...",
            "nextDialogs": [
              "80120508"
            ]
          },
          "80120508": {
            "id": "80120508",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "So tell me, Forest Rangers... Did you really spare none of them? Did you really take out every last hilichurl you saw?",
            "nextDialogs": [
              "80120509"
            ]
          },
          "80120509": {
            "id": "80120509",
            "speakerId": 1004,
            "speakerName": "Ranger Guard",
            "text": "Geez, you're really not gonna let this go... Fine, you weirdo. If you must know, I happened to cross paths with a solitary hilichurl when I left the team to, uh... use the toilet.",
            "nextDialogs": [
              "80120510"
            ]
          },
          "80120510": {
            "id": "80120510",
            "speakerId": 1004,
            "speakerName": "Ranger Guard",
            "text": "I was frightened at first, but it didn't seem to have any interest in me at all. It was just bumbling along, in... that direction. So I left it alone.",
            "nextDialogs": [
              "80120511"
            ]
          },
          "80120511": {
            "id": "80120511",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "There's still hope!",
            "nextDialogs": [
              "80120513"
            ]
          },
          "80120513": {
            "id": "80120513",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Yes! Wonderful... Wonderful. Let's go! We have to find him!",
            "nextDialogs": [
              "80120514"
            ]
          },
          "80120514": {
            "id": "80120514",
            "speakerId": 1003,
            "speakerName": "Forest Ranger",
            "text": "Wait, you're leaving? Not even a \"Thanks for the info, goodbye\"?"
          }
        }
      }
    },

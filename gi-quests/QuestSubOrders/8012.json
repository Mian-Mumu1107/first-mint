    {
      "subId": "801206",
      "subQuestName": "Continue to search for Caribert",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80120601"
        ],
        "dialogs": {
          "80120601": {
            "id": "80120601",
            "speakerId": 1002,
            "speakerName": "Caribert",
            "text": "...",
            "nextDialogs": [
              "80120602"
            ]
          },
          "80120602": {
            "id": "80120602",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Caribert!",
            "nextDialogs": [
              "80120603"
            ]
          },
          "80120603": {
            "id": "80120603",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "We found him!",
            "nextDialogs": [
              "80120604"
            ]
          },
          "80120604": {
            "id": "80120604",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Caribert, stop! It's me! It's Papa!",
            "nextDialogs": [
              "80120605"
            ]
          },
          "80120605": {
            "id": "80120605",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Whatever you saw, it was... it was all a trick! An illusion!",
            "nextDialogs": [
              "80120606"
            ]
          },
          "80120606": {
            "id": "80120606",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "I told you, we're in a fairytale world now, nothing here is real... Please, Caribert, come back... it's time to go back!",
            "nextDialogs": [
              "80120607"
            ]
          },
          "80120607": {
            "id": "80120607",
            "speakerId": 1002,
            "speakerName": "Caribert",
            "text": "...",
            "nextDialogs": [
              "80120608"
            ]
          },
          "80120608": {
            "id": "80120608",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Caribert?",
            "nextDialogs": [
              "80120611"
            ]
          },
          "80120611": {
            "id": "80120611",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "How could this happen? He regained his mind... He must be able to hear me, surely?",
            "nextDialogs": [
              "80120612"
            ]
          },
          "80120612": {
            "id": "80120612",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Come, Caribert, we have to go home now... Papa's here to take you home, alright?"
          }
        }
      }
    },

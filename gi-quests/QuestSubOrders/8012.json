        ],
        "dialogs": {
          "80120202": {
            "id": "80120202",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Caribert? Where has he gone!?",
            "nextDialogs": [
              "80120205"
            ]
          },
          "80120205": {
            "id": "80120205",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Oh no, no, no... Maybe someone else came by and found him?",
            "nextDialogs": [
              "80120206"
            ]
          },
          "80120206": {
            "id": "80120206",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "No, no, it can't have been that. There's no sign of a break-in, and no sign of anyone having been here..."
          }
        }
      }

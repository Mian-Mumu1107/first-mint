    {
      "subId": "801211",
      "subQuestName": "Talk to Eide",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80120701"
        ],
        "dialogs": {
          "80120701": {
            "id": "80120701",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "...Haha, I see, I understand now...",
            "nextDialogs": [
              "80120702"
            ]
          },
          "80120702": {
            "id": "80120702",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Finally, it all makes sense...",
            "nextDialogs": [
              "80120703"
            ]
          },
          "80120703": {
            "id": "80120703",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "(What happened... did I faint? I remember Caribert taking his mask off, but then...)",
            "nextDialogs": [
              "80120704"
            ]
          },
          "80120704": {
            "id": "80120704",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Aha, Traveler, you're awake... Finally, we can rejoice together!",
            "nextDialogs": [
              "80120705"
            ]
          },
          "80120705": {
            "id": "80120705",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Wait, no... Why am I still calling you \"Traveler\"? I have known your true identity for some time now.",
            "nextDialogs": [
              "80120708"
            ]
          },
          "80120708": {
            "id": "80120708",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Hehehe... I suspected it was you from the beginning! I had to talk to you to be sure.",
            "nextDialogs": [
              "80120709"
            ]
          },
          "80120709": {
            "id": "80120709",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "But I've never met you...",
            "nextDialogs": [
              "80120710"
            ]
          },
          "80120710": {
            "id": "80120710",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "Oh, of course you haven't. With your status? You can hardly be expected to know all of us.",
            "nextDialogs": [
              "80120711"
            ]
          },
          "80120711": {
            "id": "80120711",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "In any case... I've been using a fake name this entire time. \"Eide\" is the name of a servant I once had...",
            "nextDialogs": [
              "80120712"
            ]
          },
          "80120712": {
            "id": "80120712",
            "speakerId": 1000,
            "speakerName": "Eide",
            "text": "My real name is Chlothar...",
            "nextDialogs": [
              "80120713"
            ]
          },
          "80120713": {
            "id": "80120713",
            "speakerId": 1005,
            "speakerName": "Chlothar",
            "text": "...Chlothar Alberich."
          }
        }
      }
    },
    {
      "subId": "801213",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "80120801"
        ],
        "dialogs": {
          "80120801": {
            "id": "80120801",
            "speakerId": 1006,
            "speakerName": "Paimon",
            "text": "...You're awake! Oh, thank goodness, you're awake!",
            "nextDialogs": [
              "80120802"
            ]
          },
          "80120802": {
            "id": "80120802",
            "speakerId": 1006,
            "speakerName": "Paimon",
            "text": "#Paimon was worried sick! ...Uh, {NICKNAME}? {NICKNAME}?",
            "nextDialogs": [
              "80120803"
            ]
          },
          "80120803": {
            "id": "80120803",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "...",
            "nextDialogs": [
              "80120804"
            ]
          },
          "80120804": {
            "id": "80120804",
            "speakerId": 1007,
            "speakerName": "Dainsleif",
            "text": "What happened while you were unconscious?",
            "nextDialogs": [
              "80120805"
            ]
          },
          "80120805": {
            "id": "80120805",
            "speakerId": 1007,
            "speakerName": "Dainsleif",
            "text": "I checked the Ley Lines nearby. It appears that the Abyss tampered with them, and they've been in turmoil ever since...",
            "nextDialogs": [
              "80120806"
            ]
          },
          "80120806": {
            "id": "80120806",
            "speakerId": 1007,
            "speakerName": "Dainsleif",
            "text": "Information and memories flow within the Ley Lines... What did you witness?",
            "nextDialogs": [
              "80120809"
            ]
          },
          "80120809": {
            "id": "80120809",
            "speakerId": 1007,
            "speakerName": "Dainsleif",
            "text": "You mean Chlothar Alberich?",
            "nextDialogs": [
              "80120810"
            ]
          },
          "80120810": {
            "id": "80120810",
            "speakerId": 1007,
            "speakerName": "Dainsleif",
            "text": "After founding the Abyss Order, his faith in the Abyss led him to do a great many things.",
            "nextDialogs": [
              "80120811"
            ]
          },
          "80120811": {
            "id": "80120811",
            "speakerId": 1007,
            "speakerName": "Dainsleif",
            "text": "But the curse of immortality continued to torment his body and mind, and in the end, neither his faith nor the Abyss he worshiped could save him.",
            "nextDialogs": [
              "80120812"
            ]
          },
          "80120812": {
            "id": "80120812",
            "speakerId": 1007,
            "speakerName": "Dainsleif",
            "text": "After a hundred years, he lost his mind completely, and was never seen again.",
            "nextDialogs": [
              "80120813"
            ]
          },
          "80120813": {
            "id": "80120813",
            "speakerId": 1007,
            "speakerName": "Dainsleif",
            "text": "Yet his dark legacy lived on... The Defiled Statue that we encountered previously was just one perverse product of his use of Abyssal power during his life."
          }
        }
      }
    },
    {
      "subId": "801212",

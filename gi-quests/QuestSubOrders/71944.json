            ]
          },
          "719440104": {
            "id": "719440104",
            "speakerId": 2116,
            "speakerName": "Yikuo",
            "text": "Life is long, why the rush and the chase?",
            "nextDialogs": [
              "719440105"
            ]
          },
          "719440105": {
            "id": "719440105",
            "speakerId": 2116,
            "speakerName": "Yikuo",
            "text": "So, you should relax, too. Sit here, take a break, have some tea, try some these Fried Radish Balls... enjoy life rather than suffer it."

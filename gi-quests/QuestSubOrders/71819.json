  "subQuests": [
    {
      "subId": "7181910",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718191001"
        ],
        "dialogs": {
          "718191001": {
            "id": "718191001",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "Luckily, that Xiao Lantern got stuck on a tree. If it'd flown any higher, we wouldn't be able to reach it..."
          }
        }
      }
    },
    {
      "subId": "7181901",
      "subQuestName": "Talk to Wang'ya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718190101"
        ],
        "dialogs": {
          "718190101": {
            "id": "718190101",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "I don't know whether I'm coming or going anymore...",
            "nextDialogs": [
              "718190102"
            ]
          },
          "718190102": {
            "id": "718190102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the matter?",
            "nextDialogs": [
              "718190103"
            ]
          },
          "718190103": {
            "id": "718190103",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "No worries, I'm just trying to sort out everything that needs to be taken care of for the Lantern Rite.",
            "nextDialogs": [
              "718190104"
            ]
          },
          "718190104": {
            "id": "718190104",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "It's just that... The more I think about it, the more issues come up...",
            "nextDialogs": [
              "718190105"
            ]
          },
          "718190105": {
            "id": "718190105",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Even though my colleagues took parts of the workload upon themselves, it's my turn this year to coordinate the Xiao Lantern delivery. If I don't buck up and prepare everything, I won't make it in time...",
            "nextDialogs": [
              "718190108"
            ]
          },
          "718190108": {
            "id": "718190108",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Right... When I said \"Xiao Lantern delivery,\" I meant more than just sending out the lanterns themselves.",
            "nextDialogs": [
              "718190109"
            ]
          },
          "718190109": {
            "id": "718190109",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Simply put... It's more about playing the role of the Lantern Rite ambassador, passing on well-wishes, and creating the festive atmosphere...",
            "nextDialogs": [
              "718190110"
            ]
          },
          "718190110": {
            "id": "718190110",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Even with most people being off work for the festival, including some store owners and their staff...",
            "nextDialogs": [
              "718190111"
            ]
          },
          "718190111": {
            "id": "718190111",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "There are still essential workers who can't just take a break — for example, those in charge of keeping order during the celebration, like the Millelith.",
            "nextDialogs": [
              "718190112"
            ]
          },
          "718190112": {
            "id": "718190112",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "The Ministry of Civil Affairs usually sends them gifts to acknowledge their hard work around the Lantern Rite season...",
            "nextDialogs": [
              "718190113"
            ]
          },
          "718190113": {
            "id": "718190113",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "I was about to visit the Millelith responsible for keeping our city safe to gift them Xiao Lanterns as a token of gratitude.",
            "nextDialogs": [
              "718190114"
            ]
          },
          "718190114": {
            "id": "718190114",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "However... We're a little bit short-staffed and haven't managed to send out the gifts to all the soldiers on our list yet...",
            "nextDialogs": [
              "718190115"
            ]
          },
          "718190115": {
            "id": "718190115",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Could you do me a favor and deliver these gifts?",
            "nextDialogs": [
              "718190116"
            ]
          },
          "718190116": {
            "id": "718190116",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "How could I not?",
            "nextDialogs": [
              "718190117"
            ]
          },
          "718190117": {
            "id": "718190117",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Really? That's amazing! Thank you so much.",
            "nextDialogs": [
              "718190118"
            ]
          },
          "718190118": {
            "id": "718190118",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Who are the lucky recipients?",
            "nextDialogs": [
              "718190119"
            ]
          },
          "718190119": {
            "id": "718190119",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Let me see... Which of the Millelith haven't been checked off...",
            "nextDialogs": [
              "718190120"
            ]
          },
          "718190120": {
            "id": "718190120",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Xiangming... Hongyi... and Cai Le.",
            "nextDialogs": [
              "718190121"
            ]
          },
          "718190121": {
            "id": "718190121",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "I'll mark their stations for you. I can't thank you enough."
          }
        }
      }
    },
    {
      "subId": "7181902",
      "subQuestName": "Give the present to Xiangming",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718190201"
        ],
        "dialogs": {
          "718190201": {
            "id": "718190201",
            "speakerId": 2042,
            "speakerName": "Xiangming",
            "text": "Hmm? Do you need anything? I'm on duty...",
            "nextDialogs": [
              "718190202"
            ]
          },
          "718190202": {
            "id": "718190202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Lantern Rite gift delivery!",
            "nextDialogs": [
              "718190203"
            ]
          },
          "718190203": {
            "id": "718190203",
            "speakerId": 2042,
            "speakerName": "Xiangming",
            "text": "Quiet down a bit, I'm working over here! What do you mean, gift delivery?",
            "nextDialogs": [
              "718190204"
            ]
          },
          "718190204": {
            "id": "718190204",
            "speakerId": 2042,
            "speakerName": "Xiangming",
            "text": "Oh, it's from the Ministry of Civil Affairs? I see...",
            "nextDialogs": [
              "718190205"
            ]
          },
          "718190205": {
            "id": "718190205",
            "speakerId": 2042,
            "speakerName": "Xiangming",
            "text": "Another year, another Lantern Rite. And I'd wanted to head home earlier this year, too...",
            "nextDialogs": [
              "718190206"
            ]
          },
          "718190206": {
            "id": "718190206",
            "speakerId": 2042,
            "speakerName": "Xiangming",
            "text": "But given the current situation, I can't relax just yet... I guess I'll be heading home a few hours late again...",
            "nextDialogs": [
              "718190207"
            ]
          },
          "718190207": {
            "id": "718190207",
            "speakerId": 2042,
            "speakerName": "Xiangming",
            "text": "Thanks for coming all this way. I'll take this. Thanks!",
            "nextDialogs": [
              "718190208"
            ]
          },
          "718190208": {
            "id": "718190208",
            "speakerId": 2042,
            "speakerName": "Xiangming",
            "text": "*sigh* When's that fellow going to leave..."
          }
        }
      }
    },
    {
      "subId": "7181903",
      "subQuestName": "Give the present to Hongyi",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718190301"
        ],
        "dialogs": {
          "718190301": {
            "id": "718190301",
            "speakerId": 2058,
            "speakerName": "Hongyi",
            "text": "What's wrong with the well...",
            "nextDialogs": [
              "718190302"
            ]
          },
          "718190302": {
            "id": "718190302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Lantern Rite gift delivery!",
            "nextDialogs": [
              "718190303"
            ]
          },
          "718190303": {
            "id": "718190303",
            "speakerId": 2058,
            "speakerName": "Hongyi",
            "text": "Huh, this must be from the Ministry of Civil Affairs. Thank you, I'll take it.",
            "nextDialogs": [
              "718190304"
            ]
          },
          "718190304": {
            "id": "718190304",
            "speakerId": 2058,
            "speakerName": "Hongyi",
            "text": "Still, I need to remain on duty for a while more to ensure that no residents come to draw water from the well.",
            "nextDialogs": [
              "718190305"
            ]
          },
          "718190305": {
            "id": "718190305",
            "speakerId": 2058,
            "speakerName": "Hongyi",
            "text": "*sigh* Who knows what's wrong with it... But either way, it can't be drunk from now..."
          }
        }
      }
    },
    {
      "subId": "7181904",
      "subQuestName": "Give the present to Cai Le",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718190401"
        ],
        "dialogs": {
          "718190401": {
            "id": "718190401",
            "speakerId": 2018,
            "speakerName": "Yi Xian",
            "text": "*sobs* I—I haven't finished writing my wish...",
            "nextDialogs": [
              "718190402"
            ]
          },
          "718190402": {
            "id": "718190402",
            "speakerId": 2007,
            "speakerName": "Yi Zhu",
            "text": "Be a good girl, Little Xian. That nice uncle from the Millelith went to fetch it for you.",
            "nextDialogs": [
              "718190403"
            ]
          },
          "718190403": {
            "id": "718190403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Have you seen Cai Le?",
            "nextDialogs": [
              "718190404"
            ]
          },
          "718190404": {
            "id": "718190404",
            "speakerId": 2007,
            "speakerName": "Yi Zhu",
            "text": "Are you looking for that nice Millelith?",
            "nextDialogs": [
              "718190405"
            ]
          },
          "718190405": {
            "id": "718190405",
            "speakerId": 2007,
            "speakerName": "Yi Zhu",
            "text": "Little Xian was writing her wish on a Xiao Lantern when she suddenly lost her grip on it, and the Lantern flew away that way...",
            "nextDialogs": [
              "718190406"
            ]
          },
          "718190406": {
            "id": "718190406",
            "speakerId": 2007,
            "speakerName": "Yi Zhu",
            "text": "That Millelith told us he'd seen it hanging on a tree and went to get it for us.",
            "nextDialogs": [
              "718190409"
            ]
          },
          "718190409": {
            "id": "718190409",
            "speakerId": 2007,
            "speakerName": "Yi Zhu",
            "text": "I told her we could make another one, but she...",
            "nextDialogs": [
              "718190410"
            ]
          },
          "718190410": {
            "id": "718190410",
            "speakerId": 2018,
            "speakerName": "Yi Xian",
            "text": "Uh... No... We can't. My brother worked so hard to make that lantern...",
            "nextDialogs": [
              "718190411"
            ]
          },
          "718190411": {
            "id": "718190411",
            "speakerId": 2007,
            "speakerName": "Yi Zhu",
            "text": "Little Xian, that nice uncle will bring it back to us in no time...",
            "nextDialogs": [
              "718190412"
            ]
          },
          "718190412": {
            "id": "718190412",
            "speakerId": 2007,
            "speakerName": "Yi Zhu",
            "text": "My apologies. If you really need to talk to that Millelith, you can find him over there."
          }
        }
      }
    },
    {
      "subId": "7181905",
      "subQuestName": "Ask Yi Xian and Yi Zhu about Cai Le's whereabouts",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7181906",
      "subQuestName": "Look for Cai Le",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718190501"
        ],
        "dialogs": {
          "718190501": {
            "id": "718190501",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "For Archon's sake... How do I get there? Perhaps I should try something different...",
            "nextDialogs": [
              "718190502"
            ]
          },
          "718190502": {
            "id": "718190502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What are you doing?",
            "nextDialogs": [
              "718190503"
            ]
          },
          "718190503": {
            "id": "718190503",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "Traveler? Haha, it's nothing. I'm just wondering how to climb up that tree and retrieve that Xiao Lantern.",
            "nextDialogs": [
              "718190504"
            ]
          },
          "718190504": {
            "id": "718190504",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "It's so hard to fight gravity in full armor... I just slip back down each time...",
            "nextDialogs": [
              "718190505"
            ]
          },
          "718190505": {
            "id": "718190505",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "Eh... Would you mind lending me a helping hand? Recovering that Xiao Lantern shouldn't be too difficult for you.",
            "nextDialogs": [
              "718190506"
            ]
          },
          "718190506": {
            "id": "718190506",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure thing.",
            "nextDialogs": [
              "718190507"
            ]
          },
          "718190507": {
            "id": "718190507",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "Great, many thanks. Let's get it done as quickly as we can so the little girl can finally cheer up."
          }
        }
      }
    },
    {
      "subId": "7181907",
      "subQuestName": "Climb the tree and take down the Xiao Lantern",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718190701"
        ],
        "dialogs": {
          "718190701": {
            "id": "718190701",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "You're back! How did the gift delivery go?",
            "nextDialogs": [
              "718190702"
            ]
          },
          "718190702": {
            "id": "718190702",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Everyone's got their present.",
            "nextDialogs": [
              "718190703"
            ]
          },
          "718190703": {
            "id": "718190703",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "You're a real life-saver... I wouldn't have made it without you.",
            "nextDialogs": [
              "718190704"
            ]
          },
          "718190704": {
            "id": "718190704",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Do they have to stay on duty throughout the whole festival?",
            "nextDialogs": [
              "718190705"
            ]
          },
          "718190705": {
            "id": "718190705",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Well... The Ministry of Civil Affairs will schedule alternating shifts for them...",
            "nextDialogs": [
              "718190706"
            ]
          },
          "718190706": {
            "id": "718190706",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "But Liyue is too large. There are too many stations and places that need patrolling.",
            "nextDialogs": [
              "718190707"
            ]
          },
          "718190707": {
            "id": "718190707",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "We simply don't have enough recruits. Even though they take turns, some of them will get the shorter end of the stick and work during the Lantern Rite.",
            "nextDialogs": [
              "718190708"
            ]
          },
          "718190708": {
            "id": "718190708",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Besides, considering how grand the Lantern Rite celebrations are each year, some parts of the city require additional resources. No matter how we distribute our people, there's never enough manpower.",
            "nextDialogs": [
              "718190711"
            ]
          },
          "718190711": {
            "id": "718190711",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Well, that's our job... We'll do what we can to ensure that everyone has a nice Lantern Rite.",
            "nextDialogs": [
              "718190712"
            ]
          },
          "718190712": {
            "id": "718190712",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Which reminds me of other people who might need help around the festival time. It'd be nice if you could lend them a hand.",
            "nextDialogs": [
              "718190713"
            ]
          },
          "718190713": {
            "id": "718190713",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "The more people we encourage to participate in the Lantern Rite, the more festive its atmosphere will get.",
            "nextDialogs": [
              "718190714"
            ]
          },
          "718190714": {
            "id": "718190714",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "We send Xiao Lanterns because we'd like for everyone to be able to release one and make their own wishes.",
            "nextDialogs": [
              "718190715"
            ]
          },
          "718190715": {
            "id": "718190715",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "On a broader scale... we'd like the Lantern Rite to spread far and wide. It'd be great if everyone could experience its atmosphere.",
            "nextDialogs": [
              "718190716"
            ]
          },
          "718190716": {
            "id": "718190716",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Lantern Rite is meant for everyone, after all.",
            "nextDialogs": [
              "718190717"
            ]
          },
          "718190717": {
            "id": "718190717",
            "speakerId": 30039,
            "speakerName": "Wang'ya",
            "text": "Alright, duty calls. I hope you have a great time during the Lantern Rite!"
          }
        }
      }
    },
    {
      "subId": "7181908",
      "subQuestName": "Talk to Cai Le",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718190601"
        ],
        "dialogs": {
          "718190601": {
            "id": "718190601",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "Did you get the Xiao Lantern?",
            "nextDialogs": [
              "718190602"
            ]
          },
          "718190602": {
            "id": "718190602",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure did.",
            "nextDialogs": [
              "718190603"
            ]
          },
          "718190603": {
            "id": "718190603",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "Let me take a look... Yeah, that's the one. You just made those kids' day. I'll give it back to them.",
            "nextDialogs": [
              "718190604"
            ]
          },
          "718190604": {
            "id": "718190604",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "I hope they are still waiting where I left them...",
            "nextDialogs": [
              "718190605"
            ]
          },
          "718190605": {
            "id": "718190605",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "About the gift...",
            "nextDialogs": [
              "718190606"
            ]
          },
          "718190606": {
            "id": "718190606",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "This must be from the Ministry of Civil Affairs. Alright, gratefully received. Thanks for the trouble.",
            "nextDialogs": [
              "718190607"
            ]
          },
          "718190607": {
            "id": "718190607",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Was it also your duty as a member of the Millelith?",
            "nextDialogs": [
              "718190608"
            ]
          },
          "718190608": {
            "id": "718190608",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "Do you mean retrieving lost Xiao Lanterns? Hahahah, of course.",
            "nextDialogs": [
              "718190609"
            ]
          },
          "718190609": {
            "id": "718190609",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "Doesn't matter if it's finding Xiao Lanterns, chasing after evil-doers, or defeating monsters...",
            "nextDialogs": [
              "718190610"
            ]
          },
          "718190610": {
            "id": "718190610",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "The Millelith's duty is to help those in need.",
            "nextDialogs": [
              "718190611"
            ]
          },
          "718190611": {
            "id": "718190611",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "Thank you once again. I need to hurry up and give it back to those kids.",
            "nextDialogs": [
              "718190612"
            ]
          },
          "718190612": {
            "id": "718190612",
            "speakerId": 2100,
            "speakerName": "Cai Le",
            "text": "And then I still have other tasks to complete..."
          }
        }
      }
    },

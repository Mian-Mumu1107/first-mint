      }
    },
    {
      "subId": "7182206",
      "subQuestName": "Talk to Soraya",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "718220601"
        ],
        "dialogs": {
          "718220601": {
            "id": "718220601",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "We're finally here... That journey would have been tough enough even without those monsters...",
            "nextDialogs": [
              "718220602"
            ]
          },
          "718220602": {
            "id": "718220602",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "Hmm... There doesn't seem to be anything special about the terrain here...",
            "nextDialogs": [
              "718220603"
            ]
          },
          "718220603": {
            "id": "718220603",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "Huh? What's this in the tree... Oh, it's a Xiao Lantern...",
            "nextDialogs": [
              "718220604"
            ]
          },
          "718220604": {
            "id": "718220604",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "Why would there be a Xiao Lantern here? Did someone come here to pay their respects to the deceased adeptus?",
            "nextDialogs": [
              "718220605"
            ]
          },
          "718220605": {
            "id": "718220605",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "There's something written here...",
            "nextDialogs": [
              "718220606"
            ]
          },
          "718220606": {
            "id": "718220606",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "\"May all the world be at peace.\"",
            "nextDialogs": [
              "718220609"
            ]
          },
          "718220609": {
            "id": "718220609",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "Indeed. But this wish... How should I put it... It seems a little too magnificent. This seems neither like a wish, nor a way of paying respects.",
            "nextDialogs": [
              "718220610"
            ]
          },
          "718220610": {
            "id": "718220610",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "It seems more like a wish that one of those adepti of legend might make.",
            "nextDialogs": [
              "718220611"
            ]
          },
          "718220611": {
            "id": "718220611",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "I wonder, who would write such a wish onto a Xiao Lantern? How strange...",
            "nextDialogs": [
              "718220612"
            ]
          },
          "718220612": {
            "id": "718220612",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "Regardless, it seems that at least someone remembered to put a Xiao Lantern up here. That adeptus should be quite pleased.",
            "nextDialogs": [
              "718220613"
            ]
          },
          "718220613": {
            "id": "718220613",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "Thank you for accompanying me all this way. I'd like to stay here and do a bit more research...",
            "nextDialogs": [
              "718220614"
            ]
          },
          "718220614": {
            "id": "718220614",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "Ah, yes. This is for you. Consider it thanks for your help.",
            "nextDialogs": [
              "718220615"
            ]
          },
          "718220615": {
            "id": "718220615",
            "speakerId": 2211,
            "speakerName": "Soraya",
            "text": "*sigh* Liyue has so many legends, and yet my research has seen no progress made at all..."
          }
        }
      }
    }
  ]
}
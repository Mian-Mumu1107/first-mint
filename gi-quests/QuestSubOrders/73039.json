    {
      "subId": "7303908",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730391224"
        ],
        "dialogs": {
          "730391224": {
            "id": "730391224",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#You still have to ask {NICKNAME} to help, or you will end up cooking the same dishes as before."
          }
        }
      }
    },
    {
      "subId": "7303901",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730390101"
        ],
        "dialogs": {
          "730390101": {
            "id": "730390101",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "My brothers have all done some self-reflection. Festival Utsava is a happy occasion, so Arapacati shouldn't get mad.",
            "nextDialogs": [
              "730390102"
            ]
          },
          "730390102": {
            "id": "730390102",
            "speakerId": 4193,
            "speakerName": "Arasaka",
            "text": "That's right, Arapacati. Don't get mad. Happy occasions should be celebrated with the \"taste of happiness\"!",
            "nextDialogs": [
              "730390103"
            ]
          },
          "730390103": {
            "id": "730390103",
            "speakerId": 4192,
            "speakerName": "Arachatora",
            "text": "It's time to show off the results of our cooking training!",
            "nextDialogs": [
              "730390104"
            ]
          },
          "730390104": {
            "id": "730390104",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "I have been ready for a long while.",
            "nextDialogs": [
              "730390105"
            ]
          },
          "730390105": {
            "id": "730390105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Yay, it's the Festival Utsava Feast! Paimon's been waiting for this!",
            "nextDialogs": [
              "730390108"
            ]
          },
          "730390108": {
            "id": "730390108",
            "speakerId": 4194,
            "speakerName": "Arapas",
            "text": "Water from Vanarana is the best water and makes the best soup. Nara will love it for sure.",
            "nextDialogs": [
              "730390109"
            ]
          },
          "730390109": {
            "id": "730390109",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#I shall deliver the \"taste of happiness\" to Nara {NICKNAME} and Paimon, and let them \"teach\" my brothers.",
            "nextDialogs": [
              "730390110"
            ]
          },
          "730390110": {
            "id": "730390110",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "It's the only way to make food Nara will like. That's how guests should be treated.",
            "nextDialogs": [
              "730390111"
            ]
          },
          "730390111": {
            "id": "730390111",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#Would you mind teaching them to cook, Nara {NICKNAME}?"
          }
        }
      }
    },

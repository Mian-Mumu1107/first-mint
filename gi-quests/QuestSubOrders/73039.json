    {
      "subId": "7303902",
      "subQuestName": "Talk to the \"brothers\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730390301"
        ],
        "dialogs": {
          "730390301": {
            "id": "730390301",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "#Don't you worry, Nara {NICKNAME}, Araphala has prepared the Unrivaled Fresh Fruit for the festival!",
            "nextDialogs": [
              "730390302"
            ]
          },
          "730390302": {
            "id": "730390302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Araphala sure moves fast, huh? Let's go check elsewhere."
          }
        }
      }
    },
    {
      "subId": "7303905",
      "subQuestName": "Talk to the \"brothers\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730390701"
        ],
        "dialogs": {
          "730390701": {
            "id": "730390701",
            "speakerId": 4193,
            "speakerName": "Arasaka",
            "text": "Needs more of that \"taste of happiness\"...",
            "nextDialogs": [
              "730390702"
            ]
          },
          "730390702": {
            "id": "730390702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, that's enough!",
            "nextDialogs": [
              "730390703"
            ]
          },
          "730390703": {
            "id": "730390703",
            "speakerId": 4193,
            "speakerName": "Arasaka",
            "text": "Huh? Hmm, Arapacati mentioned that we must make Nara happy with food, so Paimon is right. I'll add less of it...",
            "nextDialogs": [
              "730390704"
            ]
          },
          "730390704": {
            "id": "730390704",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There you go. That should do."
          }
        }
      }
    },
    {
      "subId": "7303904",
      "subQuestName": "Talk to the \"brothers\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730390801"
        ],
        "dialogs": {
          "730390801": {
            "id": "730390801",
            "speakerId": 4192,
            "speakerName": "Arachatora",
            "text": "The Head Mushroom has been ready for a while now! My super fragrant Head Mushroom...",
            "nextDialogs": [
              "730390802"
            ]
          },
          "730390802": {
            "id": "730390802",
            "speakerId": 4192,
            "speakerName": "Arachatora",
            "text": "#But I'm not very good at gauging the heat, so please come take a look, Nara {NICKNAME}...",
            "nextDialogs": [
              "730390803"
            ]
          },
          "730390803": {
            "id": "730390803",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Fire is kinda dangerous to Aranara, so let's go help to control it."
          }
        }
      }
    },
    {
      "subId": "7303911",
      "subQuestName": "Help Arachatora adjust the flame",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730390901"
        ],
        "dialogs": {
          "730390901": {
            "id": "730390901",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Will this do?",
            "nextDialogs": [
              "730390902"
            ]
          },
          "730390902": {
            "id": "730390902",
            "speakerId": 4192,
            "speakerName": "Arachatora",
            "text": "Yes! We'll have a supreme delicacy, you can bet on that!"
          }
        }
      }
    },
    {
      "subId": "7303903",
      "subQuestName": "Talk to the \"brothers\"",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730390401"
        ],
        "dialogs": {
          "730390401": {
            "id": "730390401",
            "speakerId": 4194,
            "speakerName": "Arapas",
            "text": "#The Best Water... But there's nothing's left of it after my practice runs. Would Nara {NICKNAME} mind getting some water from the north of Vanarana for Arapas?",
            "nextDialogs": [
              "730390402"
            ]
          },
          "730390402": {
            "id": "730390402",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Well, guess we ought to help out, {NICKNAME}."
          }
        }
      }
    },
    {
      "subId": "7303909",
      "subQuestName": "Get some water for Arapas",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7303910",
      "subQuestName": "Give the water to Arapas",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730390501"
        ],
        "dialogs": {
          "730390501": {
            "id": "730390501",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're back, Arapas! This is the Best Water!",
            "nextDialogs": [
              "730390502"
            ]
          },
          "730390502": {
            "id": "730390502",
            "speakerId": 4194,
            "speakerName": "Arapas",
            "text": "#Terrific! I can make the Best Soup so long as I have the Best Water. Nara {NICKNAME} will love it for sure!"
          }
        }
      }
    },
    {
      "subId": "7303912",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730391201"
        ],
        "dialogs": {
          "730391201": {
            "id": "730391201",
            "speakerId": 1006,
            "speakerName": "Black Screen",
            "text": "According to the improvement method from Paimon, Aranara finishes the dish under your guidance.\\nAfter that, you enjoy the dish with Aranara...",
            "nextDialogs": [
              "730391202"
            ]
          },
          "730391202": {
            "id": "730391202",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How's the taste of true-blue gourmet Nara food, eh?",
            "nextDialogs": [
              "730391203"
            ]
          },
          "730391203": {
            "id": "730391203",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#Hmm... While it was Arapacati's suggestion for Nara {NICKNAME} to teach my brothers...",
            "nextDialogs": [
              "730391204"
            ]
          },
          "730391204": {
            "id": "730391204",
            "speakerId": 4192,
            "speakerName": "Arachatora",
            "text": "Nara dishes... Is this what Nara call \"the taste of happiness\"?",
            "nextDialogs": [
              "730391205"
            ]
          },
          "730391205": {
            "id": "730391205",
            "speakerId": 4193,
            "speakerName": "Arasaka",
            "text": "Happiness is fleeing from me...",
            "nextDialogs": [
              "730391206"
            ]
          },
          "730391206": {
            "id": "730391206",
            "speakerId": 4194,
            "speakerName": "Arapas",
            "text": "Vanarana's water is obviously the Best Water, so how did something like this get made from it?",
            "nextDialogs": [
              "730391207"
            ]
          },
          "730391207": {
            "id": "730391207",
            "speakerId": 4195,
            "speakerName": "Araphala",
            "text": "The Unrivaled Fresh Fruit is still delicious, though. Yum.",
            "nextDialogs": [
              "730391208"
            ]
          },
          "730391208": {
            "id": "730391208",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eh? You Aranara think it's awful? Paimon thought it was pretty yummy, though...",
            "nextDialogs": [
              "730391209"
            ]
          },
          "730391209": {
            "id": "730391209",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "I have no idea how \"awful\" is supposed to taste, but the flavor of this dish... has \"impact.\" You know, like the kind you get from running full-speed into a tree...",
            "nextDialogs": [
              "730391210"
            ]
          },
          "730391210": {
            "id": "730391210",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow... This has gotta be a massive case of culture clash.",
            "nextDialogs": [
              "730391211"
            ]
          },
          "730391211": {
            "id": "730391211",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#Still, it's rude to say that, my brothers. You should be thanking Nara {NICKNAME} instead!",
            "nextDialogs": [
              "730391212"
            ]
          },
          "730391212": {
            "id": "730391212",
            "speakerId": 4192,
            "speakerName": "Arachatora",
            "text": "*whimper* I'm sorry...",
            "nextDialogs": [
              "730391213"
            ]
          },
          "730391213": {
            "id": "730391213",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "Don't say \"sorry\"! Say \"Thank you!\"",
            "nextDialogs": [
              "730391214"
            ]
          },
          "730391214": {
            "id": "730391214",
            "speakerId": 1007,
            "speakerName": "\"Brothers\"",
            "text": "#Thank you, Nara {NICKNAME}...",
            "nextDialogs": [
              "730391215"
            ]
          },
          "730391215": {
            "id": "730391215",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#But it's okay as long as Nara {NICKNAME} and Paimon enjoy the food! Don't mind them. If our Nara friends are happy, we're happy.",
            "nextDialogs": [
              "730391216"
            ]
          },
          "730391216": {
            "id": "730391216",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#That said, Nara {NICKNAME} is totally different from Nara Varuna, who told us a lot of things about \"{M#brothers}{F#sisters}.\"",
            "nextDialogs": [
              "730391217"
            ]
          },
          "730391217": {
            "id": "730391217",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#But Nara {NICKNAME} is very quiet. Are you feeling unwell?",
            "nextDialogs": [
              "730391218"
            ]
          },
          "730391218": {
            "id": "730391218",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Uh, say something, {NICKNAME}.",
            "nextDialogs": [
              "730391222",
              "730391221"
            ]
          },
          "730391222": {
            "id": "730391222",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "#Is that so? I'm glad. Once again, thank you. These petals are from Arapacati and her brothers. They're for you, Nara {NICKNAME} and Paimon.",
            "nextDialogs": [
              "730391223"
            ]
          },
          "730391223": {
            "id": "730391223",
            "speakerId": 4191,
            "speakerName": "Arapacati",
            "text": "We hope the two of you will enjoy more of the \"taste of happiness\" here in Vanarana!"
          },
          "730391221": {
            "id": "730391221",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Anyway, no need to worry, Arapacati! {NICKNAME}'s fine!"
          }
        }
      }
    },
    {
      "subId": "7303906",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "730391001"
        ],
        "dialogs": {
          "730391001": {
            "id": "730391001",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Y'know, since the Aranara are making food for us so eagerly during this happy occasion, we should return the favor. What do you say?",
            "nextDialogs": [
              "730391002"
            ]
          },
          "730391002": {
            "id": "730391002",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Maybe they'll like some Radish Veggie Soup! Let's show them what Nara cooking's all about!"
          }
        }
      }
    },
    {
      "subId": "7303907",
      "subQuestName": "Give a bowl of Delicious Radish Veggie Soup to Arapacati",
      "sceneId": null,
      "locations": [],

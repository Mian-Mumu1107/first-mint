          "721650402": {
            "id": "721650402",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Please help me tell my fortune!",
            "nextDialogs": [
              "721650403"
            ]
          },
          "721650403": {
            "id": "721650403",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Paimon wants to know what today will be like too!",
            "nextDialogs": [
              "721650404"
            ]
          },
          "721650404": {
            "id": "721650404",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Hmm. The Spiritherbs say that this will be an ill-fated day.",
            "nextDialogs": [
              "721650405"
            ]
          },
          "721650405": {
            "id": "721650405",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "The ruined shrine in the east is shrouded in an ominous aura...",
            "nextDialogs": [
              "721650406"
            ]
          },
          "721650406": {
            "id": "721650406",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Uhh, that sounds kinda scary...",
            "nextDialogs": [
              "721650407"
            ]
          },
          "721650407": {
            "id": "721650407",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "However...",
            "nextDialogs": [
              "721650408"
            ]
          },
          "721650408": {
            "id": "721650408",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Those who boldly go forth and conquer such omens will receive their just reward.",
            "nextDialogs": [
              "721650409"
            ]
          },
          "721650409": {
            "id": "721650409",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "This seems quite similar to what you said before...",
            "nextDialogs": [
              "721650410"
            ]
          },
          "721650410": {
            "id": "721650410",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Ah, isn't life like that? New experiences always cloak themselves in familiar-seeming days."
          }
        }
      }
    },

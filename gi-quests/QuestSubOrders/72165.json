    {
      "subId": "7216509",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721650501"
        ],
        "dialogs": {
          "721650501": {
            "id": "721650501",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Oh, youngsters, how do you do?",
            "nextDialogs": [
              "721650502"
            ]
          },
          "721650502": {
            "id": "721650502",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Please help me tell my fortune!",
            "nextDialogs": [
              "721650503"
            ]
          },
          "721650503": {
            "id": "721650503",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm, is it gonna be good luck this time, Paimon wonders?",
            "nextDialogs": [
              "721650504"
            ]
          },
          "721650504": {
            "id": "721650504",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Oh dear, the Spiritherbs' light is rather weak at the moment. It seems they shall need some rest...",
            "nextDialogs": [
              "721650505"
            ]
          },
          "721650505": {
            "id": "721650505",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "All the same, I can help you perform another divination.",
            "nextDialogs": [
              "721650506"
            ]
          },
          "721650506": {
            "id": "721650506",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Hmm. The twinkling of the Spiritherbs say that you shall have good fortune.",
            "nextDialogs": [
              "721650507"
            ]
          },
          "721650507": {
            "id": "721650507",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "In the ruins to the northeast, in the ancient city that stands alone amidst the sea, a lingering spirit of mourning will light the way.",
            "nextDialogs": [
              "721650508"
            ]
          },
          "721650508": {
            "id": "721650508",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "However...",
            "nextDialogs": [
              "721650509"
            ]
          },
          "721650509": {
            "id": "721650509",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "You must open for her a great gate and return her to her nest of sweet slumber before the fated reward can be yours.",
            "nextDialogs": [
              "721650510"
            ]
          },
          "721650510": {
            "id": "721650510",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "That was so confusing... Something something ancient city, something nest?",
            "nextDialogs": [
              "721650511"
            ]
          },
          "721650511": {
            "id": "721650511",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Haha, it's alright. I will remain here. If you cannot figure it out, you can feel free to ask me anytime.",
            "nextDialogs": [
              "721650512"
            ]
          },
          "721650512": {
            "id": "721650512",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hey! Is she calling Paimon stupid?"
          }
        }
      }

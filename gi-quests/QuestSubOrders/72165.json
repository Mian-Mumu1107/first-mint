  "subQuests": [
    {
      "subId": "7216501",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721650101"
        ],
        "dialogs": {
          "721650101": {
            "id": "721650101",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "You're back. Is there something I can do for you?",
            "nextDialogs": [
              "721650102"
            ]
          },
          "721650102": {
            "id": "721650102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Please help me tell my fortune!",
            "nextDialogs": [
              "721650103"
            ]
          },
          "721650103": {
            "id": "721650103",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "#Paimon also wants to know what sort of luck {NICKNAME}'ll have today!",
            "nextDialogs": [
              "721650104"
            ]
          },
          "721650104": {
            "id": "721650104",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Hmm... From the pattern of the Spiritherbs' leaves... You will have good fortune.",
            "nextDialogs": [
              "721650105"
            ]
          },
          "721650105": {
            "id": "721650105",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "You will find that fortune at the highest point in Watatsumi Island, in an ancient place dedicated to the gods.",
            "nextDialogs": [
              "721650106"
            ]
          },
          "721650106": {
            "id": "721650106",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hmm... How come Paimon can't see any of that?",
            "nextDialogs": [
              "721650107"
            ]
          },
          "721650107": {
            "id": "721650107",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Hehe, this is what they call the wisdom of the local old folks.",
            "nextDialogs": [
              "721650108"
            ]
          },
          "721650108": {
            "id": "721650108",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "It sounds like you're just trying to bluff Paimon..."
          }
        }
      }
    },
    {
      "subId": "7216502",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721650201"
        ],
        "dialogs": {
          "721650201": {
            "id": "721650201",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Oh, youngsters, how do you do?",
            "nextDialogs": [
              "721650202"
            ]
          },
          "721650202": {
            "id": "721650202",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Please help me tell my fortune!",
            "nextDialogs": [
              "721650203"
            ]
          },
          "721650203": {
            "id": "721650203",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Hehe, what's our luck gonna be like today, hmm~?",
            "nextDialogs": [
              "721650204"
            ]
          },
          "721650204": {
            "id": "721650204",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "The Spiritherbs say that... you will have ill fortune.",
            "nextDialogs": [
              "721650205"
            ]
          },
          "721650205": {
            "id": "721650205",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "You will have an ill-fated and unexpected encounter in a cave in the south of Watatsumi Island — a hive of scum and villainy.",
            "nextDialogs": [
              "721650206"
            ]
          },
          "721650206": {
            "id": "721650206",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Eh, it's bad luck! Uh, we should probably avoid that sort of place, huh?",
            "nextDialogs": [
              "721650207"
            ]
          },
          "721650207": {
            "id": "721650207",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Hehe. However...",
            "nextDialogs": [
              "721650208"
            ]
          },
          "721650208": {
            "id": "721650208",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Overcoming ill fate may yet bring you an unexpected boon.",
            "nextDialogs": [
              "721650209"
            ]
          },
          "721650209": {
            "id": "721650209",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "A boon...? You mean treasure? Is it gonna be treasure?",
            "nextDialogs": [
              "721650210"
            ]
          },
          "721650210": {
            "id": "721650210",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "I did not say that...",
            "nextDialogs": [
              "721650211"
            ]
          },
          "721650211": {
            "id": "721650211",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh...",
            "nextDialogs": [
              "721650212"
            ]
          },
          "721650212": {
            "id": "721650212",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "But I did not say it wouldn't be that, either.",
            "nextDialogs": [
              "721650213"
            ]
          },
          "721650213": {
            "id": "721650213",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Oh, come on, Granny, why do you have to be like that?"
          }
        }
      }
    },
    {
      "subId": "7216511",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721651101"
        ],
        "dialogs": {
          "721651101": {
            "id": "721651101",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Hehe. Good luck cannot be rushed, and what's more, even Spiritherbs need rest.",
            "nextDialogs": [
              "721651102"
            ]
          },
          "721651102": {
            "id": "721651102",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Still, I'd like to thank you for coming by to say hello to an old lady. May you have safe travels."
          }
        }
      }
    },
    {
      "subId": "7216504",

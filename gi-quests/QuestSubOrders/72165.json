            ]
          },
          "721650307": {
            "id": "721650307",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "It should be true. These divinations have always been very accurate.",
            "nextDialogs": [
              "721650308"
            ]
          },
          "721650308": {
            "id": "721650308",
            "speakerId": 1001,
            "speakerName": "Paimon",
            "text": "Mmm, the more you say that, the more Paimon's getting suspicious...",
            "nextDialogs": [
              "721650309"
            ]
          },
          "721650309": {
            "id": "721650309",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Don't mind Paimon, Granny.",
            "nextDialogs": [
              "721650310"
            ]
          },
          "721650310": {
            "id": "721650310",
            "speakerId": 1000,
            "speakerName": "Komaki",
            "text": "Hehe, it's alright, it's alright. You're still young...",
            "nextDialogs": [

  "subQuests": [
    {
      "subId": "1203001",
      "subQuestName": "Go to the summoning ritual site",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120300101"
        ],
        "dialogs": {
          "120300101": {
            "id": "120300101",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Miko, what is this place?",
            "nextDialogs": [
              "120300102"
            ]
          },
          "120300102": {
            "id": "120300102",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "The ideal spot for a little meet-and-greet with a certain elusive author. This is the place where we are most likely to succeed in summoning the spirit.",
            "nextDialogs": [
              "120300103"
            ]
          },
          "120300103": {
            "id": "120300103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Really? But it feels so eerie here...",
            "nextDialogs": [
              "120300104"
            ]
          },
          "120300104": {
            "id": "120300104",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Hehe, that seems rather fitting, considering that we are dealing with the spirits of the deceased here.",
            "nextDialogs": [
              "120300105"
            ]
          },
          "120300105": {
            "id": "120300105",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "What are you so afraid of, honestly? We're finally about to meet the true author of \"A Firsthand Guide to Summoning Spirits.\" Aren't you excited?",
            "nextDialogs": [
              "120300106"
            ]
          },
          "120300106": {
            "id": "120300106",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Paimon's heart is pounding, but Paimon's pretty sure it's not because of excitement!",
            "nextDialogs": [
              "120300107"
            ]
          },
          "120300107": {
            "id": "120300107",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Hahaha. Come on, in we go.",
            "nextDialogs": [
              "120300108"
            ]
          },
          "120300108": {
            "id": "120300108",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hey! Wait up!",
            "nextDialogs": [
              "120300109"
            ]
          },
          "120300109": {
            "id": "120300109",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#*whimpering* Paimon's scared... {NICKNAME}, stay close by, okay? Don't leave Paimon all alone..."
          }
        }
      }
    },
    {
      "subId": "1203002",
      "subQuestName": "Enter the summoning site",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120300201"
        ],
        "dialogs": {
          "120300201": {
            "id": "120300201",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "What a weird painting... Miko, do you know what it's supposed to show?",
            "nextDialogs": [
              "120300202"
            ]
          },
          "120300202": {
            "id": "120300202",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Hmm... Probably a scene from ancient Inazuma.",
            "nextDialogs": [
              "120300203"
            ]
          },
          "120300203": {
            "id": "120300203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's a good piece of artwork and all, but it's also kinda eerie... so it's a bit scary.",
            "nextDialogs": [
              "120300204"
            ]
          },
          "120300204": {
            "id": "120300204",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Hmm... Looks like the artist signed their name... Umm... \"Rakusai\"? Hmm, it's not very clear.",
            "nextDialogs": [
              "120300205"
            ]
          },
          "120300205": {
            "id": "120300205",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Let's go inside and take a look."
          }
        }
      }
    },
    {
      "subId": "1203003",
      "subQuestName": "Collect clues concerning the summoning ritual",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "1203004",
      "subQuestName": "Complete preparations for the summoning ritual",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120300401"
        ],
        "dialogs": {
          "120300401": {
            "id": "120300401",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "\"3, 2, 1\"...",
            "nextDialogs": [
              "120300403"
            ]
          },
          "120300403": {
            "id": "120300403",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Oh, you beat me to it. Looks like your brain is intact.",
            "nextDialogs": [
              "120300404"
            ]
          },
          "120300404": {
            "id": "120300404",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "So, your first possession, hmm? What was it like?",
            "nextDialogs": [
              "120300407"
            ]
          },
          "120300407": {
            "id": "120300407",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Hehe, good. Saves me from having to explain everything again.",
            "nextDialogs": [
              "120300408"
            ]
          },
          "120300408": {
            "id": "120300408",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Hearing Urakusai admit defeat has put me in the most wonderful mood. In return, it's only fair that we make sure to deliver on what they're all hoping for."
          }
        }
      }
    },
    {
      "subId": "1203007",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120300701"
        ],
        "dialogs": {
          "120300701": {
            "id": "120300701",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Wow, this place is huge! Hey, is that... a mirror?",
            "nextDialogs": [
              "120300702"
            ]
          },
          "120300702": {
            "id": "120300702",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "There's a really weird-looking stool as well. Wonder what it's for?",
            "nextDialogs": [
              "120300703"
            ]
          },
          "120300703": {
            "id": "120300703",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Ah, I see. Heh, this setup is quite handy. Saves me a lot of work.",
            "nextDialogs": [
              "120300704"
            ]
          },
          "120300704": {
            "id": "120300704",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Alright, go and take a look around. There should be a mechanism somewhere that makes the whole room move."
          }
        }
      }
    },
    {
      "subId": "1203005",
      "subQuestName": "Begin the summoning ritual",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "120300301"
        ],
        "dialogs": {
          "120300301": {
            "id": "120300301",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Whoa, it's that painting we just saw! It's turning this way, along with the whole wall!",
            "nextDialogs": [
              "120300302"
            ]
          },
          "120300302": {
            "id": "120300302",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's getting eerier and scarier! Wh—What is this place!?",
            "nextDialogs": [
              "120300303"
            ]
          },
          "120300303": {
            "id": "120300303",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Okay. Next, I will show you a secret kitsune spell. This painting is a \"swift summoning medium,\" which means I'll be able to skip many of the more tedious steps.",
            "nextDialogs": [
              "120300304"
            ]
          },
          "120300304": {
            "id": "120300304",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "The murky mirror reflects the view of Inazuma in a bygone age. Spirits stirred by the sight of the past will be easily drawn to it.",
            "nextDialogs": [
              "120300305"
            ]
          },
          "120300305": {
            "id": "120300305",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "You're up next, little one. Come on, sit yourself down here.",
            "nextDialogs": [
              "120300308"
            ]
          },
          "120300308": {
            "id": "120300308",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Yes, the whole point of a summoning ritual is for a dead person's spirit to possess a living person's body.",
            "nextDialogs": [
              "120300309"
            ]
          },
          "120300309": {
            "id": "120300309",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "You saw what happened to that oni samurai's spirit. After leaving the host's body, he was only able to maintain his form for a very short time before disappearing.",
            "nextDialogs": [
              "120300310"
            ]
          },
          "120300310": {
            "id": "120300310",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Are we positive that summoning a spirit to possess {NICKNAME} isn't gonna have any lasting negative consequences?",
            "nextDialogs": [
              "120300311"
            ]
          },
          "120300311": {
            "id": "120300311",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Aw, you really care about the little one quite a lot, don't you? Hm, I'm a little jealous. I wish my friends were caring like that.",
            "nextDialogs": [
              "120300312"
            ]
          },
          "120300312": {
            "id": "120300312",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Anyway, are you scared, little friend? Don't you worry, now, it'll be over soon. Just think of it like having a dream.",
            "nextDialogs": [
              "120300313"
            ]
          },
          "120300313": {
            "id": "120300313",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What do I need to do?",
            "nextDialogs": [
              "120300314"
            ]
          },
          "120300314": {
            "id": "120300314",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Sit on the chair, stare at the painting, and relax your body and mind. But try and be natural, there's really no need to be nervous.",
            "nextDialogs": [
              "120300315"
            ]
          },
          "120300315": {
            "id": "120300315",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#It's like {NICKNAME}'s sitting inside the painting.",
            "nextDialogs": [
              "120300316"
            ]
          },
          "120300316": {
            "id": "120300316",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Huh!? Is Paimon seeing things? Did the painting just move!?",
            "nextDialogs": [
              "120300317"
            ]
          },
          "120300317": {
            "id": "120300317",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Recite the incantation in your heart, little one. Also, you'll need to have some intense thoughts going through your head — a wish, for example.",
            "nextDialogs": [
              "120300318"
            ]
          },
          "120300318": {
            "id": "120300318",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Now, what kind of wish do we think it would take to summon forth the author of \"A Firsthand Guide to Summoning Spirits\"? Anyone?",
            "nextDialogs": [
              "120300319"
            ]
          },
          "120300319": {
            "id": "120300319",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Umm... probably something to do with writing?",
            "nextDialogs": [
              "120300320"
            ]
          },
          "120300320": {
            "id": "120300320",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "Very good! The wish needs to be heartfelt, though, so let me help add a little realism to the equation:",
            "nextDialogs": [
              "120300321"
            ]
          },
          "120300321": {
            "id": "120300321",
            "speakerId": 1034,
            "speakerName": "Yae Miko",
            "text": "\"The book is selling exceptionally well, Traveler, but we're going to need an outline for chapter four as soon as humanly possible. When is the earliest that you can turn it in by?\""
          }
        }
      }
    },

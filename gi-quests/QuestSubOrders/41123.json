    "Timid Morrow": 15
  },
  "subQuests": [
    {
      "subId": "4112301",
      "subQuestName": "Talk to Huffman",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411230101"
        ],
        "dialogs": {
          "411230101": {
            "id": "411230101",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "Hello, Traveler. Please refrain from leaving the city during this time, if you will.",
            "nextDialogs": [
              "411230102"
            ]
          },
          "411230102": {
            "id": "411230102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's wrong?",
            "nextDialogs": [
              "411230103"
            ]
          },
          "411230103": {
            "id": "411230103",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "Now, I believe that you've seen those fallen meteorites as well.",
            "nextDialogs": [
              "411230104"
            ]
          },
          "411230104": {
            "id": "411230104",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "For some reason, they've started falling at a greater rate than before, and it's become more dangerous out there in the wild.",
            "nextDialogs": [
              "411230105"
            ]
          },
          "411230105": {
            "id": "411230105",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "All sorts of matters are cropping up within the city, almost more than the Knights can handle. All this, at a time when we'd just discovered Treasure Hoarder activity near the city...",
            "nextDialogs": [
              "411230106"
            ]
          },
          "411230106": {
            "id": "411230106",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "Those fellows would do anything for a little Mora. I fear that they'll try to take advantage of this situation...",
            "nextDialogs": [
              "411230107"
            ]
          },
          "411230107": {
            "id": "411230107",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "If you're willing, Traveler, could you help us chase those thieves off?",
            "nextDialogs": [
              "411230108"
            ]
          },
          "411230108": {
            "id": "411230108",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "This should be a task for the Knights, but I fear that we can't spare the people to settle this matter. Can you help us?",
            "nextDialogs": [
              "411230110",
              "411230112"
            ]
          },
          "411230110": {
            "id": "411230110",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "You have my thanks. I'm sorry, I know it's not the best look for us to be asking you to help us in these circumstances."
          },
          "411230112": {
            "id": "411230112",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "Hmph. I'd wager that those crooks fear nothing, as long as they can get their hands on some Mora.",
            "nextDialogs": [
              "411230113"
            ]
          },
          "411230113": {
            "id": "411230113",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "You have my thanks. I'm sorry, I know it's not the best look for us to be asking you to help us in these circumstances."
          }
        }
      }
    },
    {
      "subId": "4112302",
      "subQuestName": "Defeat the Treasure Hoarders",
      "sceneId": null,
      "locations": [],
      "dialogue": {

      }
    },
    {
      "subId": "4112303",
      "subQuestName": "Report the results to Huffman",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411230301"
        ],
        "dialogs": {
          "411230301": {
            "id": "411230301",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "Have you succeeded in beating back those Treasure Hoarders?",
            "nextDialogs": [
              "411230302"
            ]
          },
          "411230302": {
            "id": "411230302",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Sure did.",
            "nextDialogs": [
              "411230303"
            ]
          },
          "411230303": {
            "id": "411230303",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "Wonderful. You've been a great help.",
            "nextDialogs": [
              "411230304"
            ]
          },
          "411230304": {
            "id": "411230304",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "Hopefully, those Treasure Hoarders will take a hint from this lesson and stop eyeing Mondstadt up.",
            "nextDialogs": [
              "411230305"
            ]
          },
          "411230305": {
            "id": "411230305",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Well then, if there's nothing else...",
            "nextDialogs": [
              "411230306"
            ]
          },
          "411230306": {
            "id": "411230306",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "Um, so, please hold on a moment... There is something else I need your help with.",
            "nextDialogs": [
              "411230307"
            ]
          },
          "411230307": {
            "id": "411230307",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "In truth, we've received a plenitude of reports about abnormal monsters during this period.",
            "nextDialogs": [
              "411230308"
            ]
          },
          "411230308": {
            "id": "411230308",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "These reports mention that the meteorites have caused the monsters to become especially aggressive.",
            "nextDialogs": [
              "411230309"
            ]
          },
          "411230309": {
            "id": "411230309",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "The city's defenses are sufficiently stalwart, so there's no reason to worry there. But one such meteorite has landed right beside Springvale...",
            "nextDialogs": [
              "411230310"
            ]
          },
          "411230310": {
            "id": "411230310",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "Springvale is home to many hunters, and we've sent knights to reinforce them, but the terrain is truly difficult to police.",
            "nextDialogs": [
              "411230311"
            ]
          },
          "411230311": {
            "id": "411230311",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "If any monsters were to enter the town, things could get disastrous...",
            "nextDialogs": [
              "411230312"
            ]
          },
          "411230312": {
            "id": "411230312",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "Could you head over to Springvale and help us investigate the status of the monsters there?",
            "nextDialogs": [
              "411230314",
              "411230316"
            ]
          },
          "411230314": {
            "id": "411230314",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "I'll leave it in your capable hands, then. I will do what I can to send some knights over to assist you."
          },
          "411230316": {
            "id": "411230316",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "To be frank, things don't look good. We already have our hands full dealing with the meteorites' aftermath. But we also need to guard against monsters and the Treasure Hoarders...",
            "nextDialogs": [
              "411230317"
            ]
          },
          "411230317": {
            "id": "411230317",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "It's almost impossible to handle so many things at once...",
            "nextDialogs": [
              "411230318"
            ]
          },
          "411230318": {
            "id": "411230318",
            "speakerId": 1433,
            "speakerName": "Huffman",
            "text": "I'm sorry, but I'm leaving this in your hands. In the meantime, I will try to send knights over to aid you."
          }
        }
      }
    },
    {
      "subId": "4112304",
      "subQuestName": "Head close to Springvale to investigate",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "411230401"
        ],
        "dialogs": {
          "411230401": {
            "id": "411230401",
            "speakerId": 1575,
            "speakerName": "Timid Morrow",
            "text": "Aaaah! D—Don't come any...",
            "nextDialogs": [
              "411230402"
            ]
          },
          "411230402": {
            "id": "411230402",
            "speakerId": 1575,
            "speakerName": "Timid Morrow",
            "text": "Eh? Y—You're not a monster. Wh—Who are you?",
            "nextDialogs": [
              "411230403"
            ]
          },
          "411230403": {
            "id": "411230403",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "What's the status on those monsters?",
            "nextDialogs": [
              "411230404"
            ]
          },
          "411230404": {
            "id": "411230404",
            "speakerId": 1575,
            "speakerName": "Timid Morrow",
            "text": "The monsters? What is there to ask? I was just running from them, that's what!",
            "nextDialogs": [
              "411230405"
            ]
          },
          "411230405": {
            "id": "411230405",
            "speakerId": 1575,
            "speakerName": "Timid Morrow",
            "text": "They were right there, a whole bunch of them, looking like they might attack the town.",
            "nextDialogs": [
              "411230406"
            ]
          },
          "411230406": {
            "id": "411230406",
            "speakerId": 1575,
            "speakerName": "Timid Morrow",
            "text": "If I hadn't run so fast, I'd have been a goner...",
            "nextDialogs": [
              "411230407"
            ]
          },
          "411230407": {
            "id": "411230407",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Where are those beasts?",
            "nextDialogs": [
              "411230408"
            ]
          },
          "411230408": {
            "id": "411230408",
            "speakerId": 1575,
            "speakerName": "Timid Morrow",
            "text": "Right next to the town. A few steps around the corner and you'll see them.",
            "nextDialogs": [
              "411230409"
            ]
          },
          "411230409": {
            "id": "411230409",
            "speakerId": 1575,
            "speakerName": "Timid Morrow",
            "text": "You should get to shelter as well. I'll rest here for a while, and then I'll go warn everyone in town."
          }
        }
      }
    },

        "dialogs": {
          "220150901": {
            "id": "220150901",
            "speakerId": 3041,
            "speakerName": "Sango",
            "text": "So I'll wait for your news and of course, you will get paid. Plus... it's a chance for you to experience the life of a detective.",
            "nextDialogs": [
              "220150903",
              "220150906"
            ]
          },
          "220150903": {
            "id": "220150903",
            "speakerId": 3041,
            "speakerName": "Sango",
            "text": "He's very skilled and tough. No need to worry about him.",
            "nextDialogs": [
              "220150904"
            ]
          },
          "220150904": {
            "id": "220150904",
            "speakerId": 3041,
            "speakerName": "Sango",
            "text": "After all, he used to be a Doushin."
          },
          "220150906": {
            "id": "220150906",
            "speakerId": 3041,
            "speakerName": "Sango",
            "text": "Well, how should I put it... we both have our roles to play.",

{
  "lineCounts": {
    "Kid Kujirai": 24,
    "Paimon": 15,
    "Player": 11
  },
  "subQuests": [
    {
      "subId": "7217601",
      "subQuestName": "",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721760101"
        ],
        "dialogs": {
          "721760101": {
            "id": "721760101",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "#Hi, {F#big sis}{M#big bro}! I have some good stuff here...",
            "nextDialogs": [
              "721760102"
            ]
          },
          "721760102": {
            "id": "721760102",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Thanks, but I'll pass.",
            "nextDialogs": [
              "721760103"
            ]
          },
          "721760103": {
            "id": "721760103",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "How pitiful, being forced to do shady business at such a young age.",
            "nextDialogs": [
              "721760104"
            ]
          },
          "721760104": {
            "id": "721760104",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "It's not what you're thinking! I wanted to ask if you wanted to play a game of Temari with me.",
            "nextDialogs": [
              "721760105"
            ]
          },
          "721760105": {
            "id": "721760105",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Temari?",
            "nextDialogs": [
              "721760106"
            ]
          },
          "721760106": {
            "id": "721760106",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "#It's simple, I will hide the Temari somewhere nearby. If {F#big sis}{M#big bro} can find it within the time of a Temari song, you win.",
            "nextDialogs": [
              "721760107"
            ]
          },
          "721760107": {
            "id": "721760107",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Is that how Temari is played?",
            "nextDialogs": [
              "721760108"
            ]
          },
          "721760108": {
            "id": "721760108",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "Huh? An awesome Big Sister adventurer taught me. And she said...",
            "nextDialogs": [
              "721760109"
            ]
          },
          "721760109": {
            "id": "721760109",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "\"Kujirai, remember. You must say, 'If you win, you'll get the good stuff.'\"",
            "nextDialogs": [
              "721760110"
            ]
          },
          "721760110": {
            "id": "721760110",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "#So, {F#big sis}{M#big bro}, if you win, you'll get the good stuff.",
            "nextDialogs": [
              "721760111"
            ]
          },
          "721760111": {
            "id": "721760111",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Good stuff! {NICKNAME}, Paimon thinks it's only right to play with children!",
            "nextDialogs": [
              "721760113"
            ]
          },
          "721760113": {
            "id": "721760113",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It may be a gameplay that only local people know, let's not care about such details.",
            "nextDialogs": [
              "721760114"
            ]
          },
          "721760114": {
            "id": "721760114",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're Kid Kujirai, right? We'll play with you!",
            "nextDialogs": [
              "721760116"
            ]
          },
          "721760116": {
            "id": "721760116",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "Yay!"
          }
        }
      }
    },
    {
      "subId": "7217604",
      "subQuestName": "Find the Temari",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [],
        "dialogs": {}
      }
    },
    {
      "subId": "7217602",
      "subQuestName": "Talk to Kid Kujirai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721760202"
        ],
        "dialogs": {
          "721760202": {
            "id": "721760202",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "Eh, is it too hard for you...",
            "nextDialogs": [
              "721760203"
            ]
          },
          "721760203": {
            "id": "721760203",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "That's because Paimon was just warming up!",
            "nextDialogs": [
              "721760204"
            ]
          },
          "721760204": {
            "id": "721760204",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "#{F#Big sis}{M#Big bro}, do you want to try again?",
            "nextDialogs": [
              "721760205"
            ]
          },
          "721760205": {
            "id": "721760205",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Of course! {NICKNAME}, we need to show Kid Kujirai how good we are!",
            "nextDialogs": [
              "721760206"
            ]
          },
          "721760206": {
            "id": "721760206",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "One more try!",
            "nextDialogs": [
              "721760207"
            ]
          },
          "721760207": {
            "id": "721760207",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "Woohoo! The goal is to find the Temari within the time limit!"
          }
        }
      }
    },
    {
      "subId": "7217605",
      "subQuestName": "Talk to Kid Kujirai",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "721760702"
        ],
        "dialogs": {
          "721760702": {
            "id": "721760702",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "#{F#Big sis}{M#Big bro} is amazing, you found it right away!",
            "nextDialogs": [
              "721760703"
            ]
          },
          "721760703": {
            "id": "721760703",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "#Hoho, {NICKNAME} is a seasoned traveler who has been to many nations.",
            "nextDialogs": [
              "721760704"
            ]
          },
          "721760704": {
            "id": "721760704",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "Wow! Have you also been to Mondstadt?",
            "nextDialogs": [
              "721760705"
            ]
          },
          "721760705": {
            "id": "721760705",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Certainly have.",
            "nextDialogs": [
              "721760706"
            ]
          },
          "721760706": {
            "id": "721760706",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "That's so cool! I heard from that Big Sister that there are many beautiful places in Mondstadt, like Stormterror's Ruins with super-duper tall towers...",
            "nextDialogs": [
              "721760709"
            ]
          },
          "721760709": {
            "id": "721760709",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "Yup! I wonder if that tower is taller, or if the Almighty Shogun's Tenshukaku is taller...",
            "nextDialogs": [
              "721760710"
            ]
          },
          "721760710": {
            "id": "721760710",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Kid Kujirai, why are you out alone in the wild?",
            "nextDialogs": [
              "721760711"
            ]
          },
          "721760711": {
            "id": "721760711",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "Because when my sister was fishing, she thought I would scare the fish away, so she let me go out to play.",
            "nextDialogs": [
              "721760712"
            ]
          },
          "721760712": {
            "id": "721760712",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "Once, I met that Big Sister who was an adventurer. She saw that I was bored, so she gave me a lot of Temari, and told me to \"find greedy travelers to play with.\"",
            "nextDialogs": [
              "721760713"
            ]
          },
          "721760713": {
            "id": "721760713",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Greedy travelers...",
            "nextDialogs": [
              "721760714"
            ]
          },
          "721760714": {
            "id": "721760714",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "We're not greedy! We're worried! Paimon's worried that you might be bored playing by yourself!",
            "nextDialogs": [
              "721760715"
            ]
          },
          "721760715": {
            "id": "721760715",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "#That's right, I think {F#big sis}{M#big bro} is really nice, I'm so happy.",
            "nextDialogs": [
              "721760716"
            ]
          },
          "721760716": {
            "id": "721760716",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Alone in the wilderness...",
            "nextDialogs": [
              "721760717"
            ]
          },
          "721760717": {
            "id": "721760717",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're a kid alone in the wild, aren't you afraid of running into danger? And you even have \"good stuff\" on you.",
            "nextDialogs": [
              "721760718"
            ]
          },
          "721760718": {
            "id": "721760718",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "#You're really kind, {F#big sis}{M#big bro}. Don't worry, that Big Sister adventurer taught me. As long as I do something to it, the Temari can turn into a bomb.",
            "nextDialogs": [
              "721760719"
            ]
          },
          "721760719": {
            "id": "721760719",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "Eek, that's so dangerous!",
            "nextDialogs": [
              "721760720"
            ]
          },
          "721760720": {
            "id": "721760720",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "It's not! I've blasted away a lot of bad guys, like hilichurls and slimes!",
            "nextDialogs": [
              "721760721"
            ]
          },
          "721760721": {
            "id": "721760721",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "You're the dangerous one!",
            "nextDialogs": [
              "721760722"
            ]
          },
          "721760722": {
            "id": "721760722",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "#Oh yes, {F#big sis}{M#big bro}, if you want to play a game of Temari with other friends...",
            "nextDialogs": [
              "721760723"
            ]
          },
          "721760723": {
            "id": "721760723",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "I'll leave a Temari here! Here are the rules...",
            "nextDialogs": [
              "721760724"
            ]
          },
          "721760724": {
            "id": "721760724",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "When you hide a Temari, you have to hide it within the time of a Temari song. The person who is looking for it will also find it within a song's time. That will make things fair!",
            "nextDialogs": [
              "721760725"
            ]
          },
          "721760725": {
            "id": "721760725",
            "speakerId": -1,
            "speakerName": "Player",
            "text": "Got it.",
            "nextDialogs": [
              "721760726"
            ]
          },
          "721760726": {
            "id": "721760726",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "It's so scary to think that we're actually playing with bombs...",
            "nextDialogs": [
              "721760727"
            ]
          },
          "721760727": {
            "id": "721760727",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "#Don't be scared, {F#big sis}{M#big bro}. Big Sister adventurer told me \"Only the bad guys will be bombed. Probably.\"",
            "nextDialogs": [
              "721760728"
            ]
          },
          "721760728": {
            "id": "721760728",
            "speakerId": 1005,
            "speakerName": "Paimon",
            "text": "\"Probably!?\"",
            "nextDialogs": [
              "721760729"
            ]
          },
          "721760729": {
            "id": "721760729",
            "speakerId": 20338,
            "speakerName": "Kid Kujirai",
            "text": "#I'm off to play somewhere else! Bye-bye, {F#big sis}{M#big bro}!"
          }
        }
      }
    }
  ]
}
    {
      "subId": "2304115",
      "subQuestName": "Bring the drink Nermin made to Raef",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230411001"
        ],
        "dialogs": {
          "230411001": {
            "id": "230411001",
            "speakerId": 4404,
            "speakerName": "Raef",
            "text": "Minty Bean Soup... Did Nermin make this herself?",
            "nextDialogs": [
              "230411002"
            ]
          },
          "230411002": {
            "id": "230411002",
            "speakerId": 4404,
            "speakerName": "Raef",
            "text": "So that's why she's been acting all mysterious lately. I heard that she bought a few flower pots, too... I wondered what she planted in them.",
            "nextDialogs": [
              "230411003"
            ]
          },
          "230411003": {
            "id": "230411003",
            "speakerId": 4404,
            "speakerName": "Raef",
            "text": "Not that it's a bad thing. At least she won't be spending all her time worrying about her health.",
            "nextDialogs": [
              "230411004"
            ]
          },
          "230411004": {
            "id": "230411004",
            "speakerId": 4404,
            "speakerName": "Raef",
            "text": "There's still another batch of goods I need to take care of. Once I bring them back into the village, I'll try her soup.",
            "nextDialogs": [
              "230411005"
            ]
          },
          "230411005": {
            "id": "230411005",
            "speakerId": 4404,
            "speakerName": "Raef",
            "text": "Oh, and here's a little something for you. Thank you for coming all the way here."
          }
        }
      }
    },
    {
      "subId": "2304108",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230410801"
        ],
        "dialogs": {
          "230410801": {
            "id": "230410801",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Traveler, have you found the Zaytun Peaches?"
          }
        }
      }
    },
    {
      "subId": "2304111",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230411101"
        ],
        "dialogs": {
          "230411101": {
            "id": "230411101",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Ugh... Why are there so many bugs on the leaves?"
          }
        }
      }
    },
    {
      "subId": "2304112",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230411201"
        ],
        "dialogs": {
          "230411201": {
            "id": "230411201",
            "speakerId": 4405,
            "speakerName": "Nermin",
            "text": "Why does the kitten like nibbling on leaves...? I wonder what they taste like..."
          }
        }
      }
    },
    {
      "subId": "2304115",
      "subQuestName": "Additional",
      "sceneId": null,
      "locations": [],
      "dialogue": {
        "startDialogs": [
          "230411501"
        ],
        "dialogs": {
          "230411501": {
